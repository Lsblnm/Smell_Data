+    private function lookupCharacterSet(string $name): string
+    {
+        $catalog = $this->characterSetCatalog();
+        if (isset($catalog[$name])) {
+            return $catalog[$name];
+        }
+        $upper = strtoupper($name);
+        foreach ($catalog as $key => $value) {
