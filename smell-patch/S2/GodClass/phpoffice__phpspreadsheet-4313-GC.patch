+    private function normalizeIncomingExcelFormula(string $formula): string
+    {
+        $rowChar = (string) ($this->writerFormulaState['rowChar'] ?? 'R');
+        $colChar = (string) ($this->writerFormulaState['colChar'] ?? 'C');
+        $pattern = '/' . preg_quote($rowChar, '/') . '\\d*' . preg_quote($colChar, '/') . '\\d*/i';
+        $hasRc = preg_match($pattern, $formula) === 1;
+        $hasA1 = preg_match('/\\b[A-Z]{1,3}\\d{1,7}\\b/i', $formula) === 1;
+        if (str_starts_with($formula, 'of:') || ($hasRc && !$hasA1)) {
+            $formula = AddressHelper::convertFormulaToA1($formula);
+        }
+        $this->writerFormulaState['normalized'] = $formula;
+
+        return $formula;
+    }
+
+    private function rewriteExcelDefinedNames(string $formula): string
+    {
+        $definedNames = $this->writerFormulaState['definedNames'] ?? [];
+        $splitCount = preg_match_all(
+            '/' . Calculation::CALCULATION_REGEXP_DEFINEDNAME . '/mui',
+            $formula,
+            $splitRanges,
+            PREG_OFFSET_CAPTURE
+        );
+        $lengths = array_map('strlen', array_column($splitRanges[0], 0));
+        $offsets = array_column($splitRanges[0], 1);
+        $values = array_column($splitRanges[0], 0);
+        while ($splitCount > 0) {
+            --$splitCount;
+            $length = $lengths[$splitCount];
+            $offset = $offsets[$splitCount];
+            $value = $values[$splitCount];
+            if (in_array($value, $definedNames, true)) {
+                $formula = substr($formula, 0, $offset) . '$$' . $value . substr($formula, $offset + $length);
+            }
+        }
+        $this->writerFormulaState['afterNames'] = $formula;
+
+        return $formula;
+    }
+
+    private function rewriteExcelCellReferences(string $formula, string $worksheetName): string
+    {
+        $splitCount = preg_match_all(
+            '/' . Calculation::CALCULATION_REGEXP_CELLREF_RELATIVE . '/mui',
+            $formula,
+            $splitRanges,
+            PREG_OFFSET_CAPTURE
+        );
+        $lengths = array_map('strlen', array_column($splitRanges[0], 0));
+        $offsets = array_column($splitRanges[0], 1);
+        $worksheets = $splitRanges[2];
+        $columns = $splitRanges[6];
+        $rows = $splitRanges[7];
+        $formula = str_replace(',', ';', $formula);
+        while ($splitCount > 0) {
+            --$splitCount;
+            $length = $lengths[$splitCount];
+            $offset = $offsets[$splitCount];
+            $worksheet = $worksheets[$splitCount][0];
+            $column = $this->normalizeWriterColumnToken($columns[$splitCount][0]);
+            $row = $rows[$splitCount][0];
+            $newRange = '';
+            if (empty($worksheet)) {
+                if (($offset === 0) || ($formula[$offset - 1] !== ':')) {
+                    $worksheet = $worksheetName;
+                }
+            } else {
+                $worksheet = str_replace("''", "'", trim($worksheet, "'"));
+            }
+            if (!empty($worksheet)) {
+                $newRange = "['" . str_replace("'", "''", $worksheet) . "'";
+            } elseif (substr($formula, $offset - 1, 1) !== ':') {
+                $newRange = '[';
+            }
+            $newRange .= '.';
+            $newRange .= $column;
+            if (!empty($row)) {
+                $newRange .= $row;
+            }
+            $newRange .= substr($formula, $offset + $length, 1) !== ':' ? ']' : '';
+            $formula = substr($formula, 0, $offset) . $newRange . substr($formula, $offset + $length);
+        }
+        $this->writerFormulaState['afterRefs'] = $formula;
+
+        return $formula;
+    }
+
+    private function normalizeWriterColumnToken(string $column): string
+    {
+        $this->writerFormulaState['lastColumn'] = $column;
+        if ($column === '') {
+            return $column;
+        }
+        $absolute = str_starts_with($column, '$');
+        $letters = ltrim($column, '$');
+        if ($letters === '' || !ctype_alpha($letters)) {
+            return $column;
+        }
+        try {
+            $index = Coordinate::columnIndexFromString($letters);
+            $normalized = Coordinate::stringFromColumnIndex($index);
+        } catch (\Throwable $exception) {
+            return $column;
+        }
+
+        return $absolute ? '$' . $normalized : $normalized;
+    }
+
+    private function rememberStateValue(string $bucket, string $key, mixed $value): void
+    {
+        if ($bucket === 'autoFilterState') {
+            $list = $this->autoFilterState[$key] ?? [];
+            $list[] = $value;
+            $this->autoFilterState[$key] = $list;
+        } elseif ($bucket === 'definedNameState') {
+            $list = $this->definedNameState[$key] ?? [];
+            $list[] = $value;
+            $this->definedNameState[$key] = $list;
+        } elseif ($bucket === 'pageLayoutState') {
+            $this->pageLayoutState[$key] = $value;
+        } elseif ($bucket === 'documentPropertyState') {
+            $this->documentPropertyState[$key] = $value;
+        } elseif ($bucket === 'writerFormulaState') {
+            $this->writerFormulaState[$key] = $value;
+        } elseif ($bucket === 'coordinateState') {
+            $this->coordinateState[$key] = $value;
+        }
+    }
+
+    private function describeAddressShape(string $bucket, string $address): array
+    {
+        $shape = [
+            'quoted' => str_contains($address, "'"),
+            'dotted' => str_contains($address, '.'),
+            'ranged' => str_contains($address, ':'),
+            'absolute' => str_contains($address, '$'),
+            'bang' => str_contains($address, '!'),
+            'length' => strlen($address),
+        ];
+        $this->rememberStateValue($bucket, 'shape', $shape);
+
+        return $shape;
+    }
+
+    private function extractDottedSheetTitle(string $bucket, string $address): string
+    {
+        $title = '';
+        if (str_starts_with($address, "'")) {
+            $end = strpos($address, "'.", 1);
+            if ($end !== false) {
+                $title = substr($address, 1, $end - 1);
+            }
+        } elseif (str_contains($address, '.')) {
+            $title = explode('.', $address, 2)[0];
+        }
+        $this->rememberStateValue($bucket, 'sheetTitle', $title);
+
+        return $title;
+    }
+
+    private function splitRangeEndpoints(string $bucket, string $address): array
+    {
+        $parts = str_contains($address, ':') ? explode(':', $address, 2) : [$address, $address];
+        $this->rememberStateValue($bucket, 'endpoints', $parts);
+
+        return $parts;
+    }
+
+    private function countAbsoluteMarkers(string $bucket, string $address): int
+    {
+        $count = substr_count($address, '$');
+        $this->rememberStateValue($bucket, 'dollars', $count);
+
+        return $count;
+    }
+
+    private function estimateLocalDimensions(string $bucket, string $address): array
+    {
+        $local = $address;
+        if (str_contains($local, '!')) {
+            $bits = explode('!', $local);
+            $local = (string) end($bits);
+        }
+        $local = str_replace('$', '', $local);
+        $result = [1, 1];
+        if ($local !== '' && !str_contains($local, '.') && Coordinate::coordinateIsRange($local)) {
+            try {
+                $result = Coordinate::rangeDimension($local);
+            } catch (\Throwable $exception) {
+                $result = [1, 1];
+            }
+        }
+        $this->rememberStateValue($bucket, 'dimensions', $result);
+
+        return $result;
+    }
+
+    private function classifyOpenDocumentAddressKind(string $bucket, string $address): string
+    {
+        $kind = 'cell';
+        if (str_contains($address, ':') && str_contains($address, '.')) {
+            $kind = 'sheet-range';
+        } elseif (str_contains($address, ':')) {
+            $kind = 'local-range';
+        } elseif (str_contains($address, '.')) {
+            $kind = 'sheet-cell';
+        } elseif (preg_match('/^[A-Za-z]+[0-9]+$/', $address) === 1) {
+            $kind = 'local-cell';
+        }
+        $this->rememberStateValue($bucket, 'kind', $kind);
+
+        return $kind;
+    }
+
+    private function collectQuoteIndexes(string $bucket, string $address): array
+    {
+        $quotes = [];
+        $length = strlen($address);
+        for ($index = 0; $index < $length; ++$index) {
+            if ($address[$index] === "'") {
+                $quotes[] = $index;
+            }
+        }
+        $this->rememberStateValue($bucket, 'quotes', $quotes);
+
+        return $quotes;
+    }
+
+    private function scanFormulaFunctionTokens(string $bucket, string $expression): array
+    {
+        $catalog = $this->openFormulaFunctionCatalog();
+        $found = [];
+        if (preg_match_all('/[A-Z][A-Z0-9\.]+/i', $expression, $matches) !== false) {
+            foreach ($matches[0] as $token) {
+                $upper = strtoupper($token);
+                if (isset($catalog[$upper])) {
+                    $found[] = $upper;
+                }
+            }
+        }
+        $this->rememberStateValue($bucket, 'functionsFound', $found);
+
+        return $found;
+    }
+
+    private function scanFormulaErrorTokens(string $bucket, string $expression): array
+    {
+        $found = [];
+        foreach ($this->formulaErrorCatalog() as $code => $meta) {
+            if (str_contains($expression, (string) $code)) {
+                $found[] = $code;
+            }
+        }
+        $this->rememberStateValue($bucket, 'errorsFound', $found);
+
+        return $found;
+    }
+
+    private function countFormulaBraces(string $bucket, string $expression): array
+    {
+        $counts = [
+            'paren' => substr_count($expression, '('),
+            'bracket' => substr_count($expression, '['),
+            'brace' => substr_count($expression, '{'),
+        ];
+        $this->rememberStateValue($bucket, 'braces', $counts);
+
+        return $counts;
+    }
+
+    private function classifyPrintOrientation(string $value): string
+    {
+        $normalized = strtolower(trim($value));
+        $this->pageLayoutState['lastOrientation'] = $normalized;
+        if ($normalized === 'landscape') {
+            return PageSetup::ORIENTATION_LANDSCAPE;
+        }
+        if ($normalized === 'portrait') {
+            return PageSetup::ORIENTATION_PORTRAIT;
+        }
+
+        return $value !== '' ? $value : PageSetup::ORIENTATION_DEFAULT;
+    }
+
+    public function inspectExcelAddress(string $excelAddress): array
+    {
+        $this->coordinateState['input'] = $excelAddress;
+        $sheet = '';
+        $local = $excelAddress;
+        if (str_contains($excelAddress, '!')) {
+            [$sheet, $local] = Worksheet::extractSheetTitle($excelAddress, true);
+            $sheet = (string) $sheet;
+            $local = (string) $local;
+        }
+        $kind = 'cell';
+        if ($local === '') {
+            $kind = 'empty';
+        } elseif (str_contains($local, ',')) {
+            $kind = 'union';
+        } elseif (str_contains($local, ':')) {
+            $kind = 'range';
+        } elseif (preg_match('/^[A-Za-z]+$/', $local) === 1) {
+            $kind = 'column';
+        } elseif (preg_match('/^[0-9]+$/', $local) === 1) {
+            $kind = 'row';
+        }
+        $this->coordinateState['sheet'] = $sheet;
+        $this->coordinateState['local'] = $local;
+        $this->coordinateState['kind'] = $kind;
+        try {
+            $this->coordinateState['cells'] = $local !== '' ? Coordinate::extractAllCellReferencesInRange($local) : [];
+        } catch (\Throwable $exception) {
+            $this->coordinateState['cells'] = [];
+        }
+
+        return $this->coordinateState;
+    }
