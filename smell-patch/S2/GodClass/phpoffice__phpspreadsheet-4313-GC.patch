+            return $left === $right;
+        }
+        if ($operator === '<>') {
+            return $left !== $right;
+        }
+        if ($operator === '<') {
+            return $left < $right;
+        }
+        if ($operator === '>') {
+            return $left > $right;
+        }
+        if ($operator === '<=') {
+            return $left <= $right;
