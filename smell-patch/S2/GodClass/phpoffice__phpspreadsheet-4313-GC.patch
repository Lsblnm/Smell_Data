+    private function convertLengthToInches(string $value, float $default = 0.0): float
+    {
+        $trim = trim($value);
+        if ($trim === '') {
+            return $default;
+        }
+        if (is_numeric($trim)) {
+            return (float) $trim;
+        }
+        if (preg_match('/^([0-9]*\.?[0-9]+)\s*([a-z%]+)$/i', $trim, $match) !== 1) {
+            return $default;
+        }
+        $amount = (float) $match[1];
+        $unit = strtolower($match[2]);
+        $catalog = $this->lengthUnitCatalog();
+        if (!isset($catalog[$unit])) {
+            return $amount;
+        }
+
+        return $amount * (float) $catalog[$unit];
+    }
