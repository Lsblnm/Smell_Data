+
+    private function applyCoreDocumentProperties(DocumentProperties $docProps, SimpleXMLElement $officePropertyDC): void
+    {
+        foreach ($officePropertyDC as $propertyName => $propertyValue) {
+            $propertyValue = (string) $propertyValue;
+            switch ((string) $propertyName) {
+                case 'title':
+                    $docProps->setTitle($propertyValue);
+                    break;
+                case 'subject':
+                    $docProps->setSubject($propertyValue);
+                    break;
+                case 'creator':
+                    $docProps->setCreator($propertyValue);
+                    $docProps->setLastModifiedBy($propertyValue);
+                    break;
+                case 'date':
+                    $docProps->setModified($propertyValue);
+                    break;
+                case 'description':
+                    $docProps->setDescription($propertyValue);
+                    break;
+            }
+            $bag = $this->documentPropertyState['core'] ?? [];
+            $bag[(string) $propertyName] = $propertyValue;
+            $this->documentPropertyState['core'] = $bag;
+        }
+    }
+
+    private function applyMetaDocumentProperties(array $namespacesMeta, SimpleXMLElement $propertyValue, string $propertyName, DocumentProperties $docProps): void
+    {
+        $propertyValueAttributes = $propertyValue->attributes($namespacesMeta['meta']);
+        $textValue = (string) $propertyValue;
+        switch ($propertyName) {
+            case 'initial-creator':
+                $docProps->setCreator($textValue);
+                break;
+            case 'keyword':
+                $docProps->setKeywords($textValue);
+                break;
+            case 'creation-date':
+                $docProps->setCreated($textValue);
+                break;
+            case 'user-defined':
+                $name2 = (string) ($propertyValueAttributes['name'] ?? '');
+                if ($name2 === 'Company') {
+                    $docProps->setCompany($textValue);
+                } elseif ($name2 === 'category') {
+                    $docProps->setCategory($textValue);
+                } else {
+                    $this->applyUserDefinedProperty($propertyValueAttributes, $textValue, $docProps);
+                }
+                break;
+        }
+        $bag = $this->documentPropertyState['meta'] ?? [];
+        $bag[$propertyName] = $textValue;
+        $this->documentPropertyState['meta'] = $bag;
+    }
