+    private function mapMergeAnchor(string $start, string $end): array
+    {
+        if ($start === '' || $end === '') {
+            return ['start' => $start, 'end' => $end, 'span' => [1, 1]];
+        }
+        try {
+            $startCoord = Coordinate::coordinateFromString($start);
+            $endCoord = Coordinate::coordinateFromString($end);
+            $columns = Coordinate::columnIndexFromString($endCoord[0]) - Coordinate::columnIndexFromString($startCoord[0]) + 1;
+            $rows = (int) $endCoord[1] - (int) $startCoord[1] + 1;
+
+            return ['start' => $start, 'end' => $end, 'span' => [$columns, $rows]];
+        } catch (\Throwable $exception) {
+            return ['start' => $start, 'end' => $end, 'span' => [1, 1]];
