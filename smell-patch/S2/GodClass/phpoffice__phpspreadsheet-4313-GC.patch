+    private function mapOfficeTimeToSeconds(string $timeValue): int
+    {
+        if (preg_match('/PT(?:(\d+)H)?(?:(\d+)M)?(?:(\d+)(?:\.\d+)?S)?/', $timeValue, $match) !== 1) {
+            return 0;
+        }
+        $hours = (int) ($match[1] ?? 0);
+        $minutes = (int) ($match[2] ?? 0);
+        $seconds = (int) ($match[3] ?? 0);
+        if ($hours < 0) {
