+
+  resolveSwizzleWrapAction(componentName: string): 'safe' | 'unsafe' | 'forbidden' {
+    const entry = this.swizzleCatalog().find((item) => item.name === componentName);
+    if (!entry) {
+      return 'forbidden';
+    }
+    if (entry.wrap === 'safe' || entry.wrap === 'unsafe' || entry.wrap === 'forbidden') {
+      return entry.wrap;
