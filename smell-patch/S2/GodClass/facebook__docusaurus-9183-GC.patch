+  resolveSwizzleEjectAction(componentName: string): 'safe' | 'unsafe' | 'forbidden' {
+    const entry = this.swizzleCatalog().find((item) => item.name === componentName);
+    if (!entry) {
+      return 'unsafe';
+    }
+    if (entry.eject === 'safe' || entry.eject === 'unsafe' || entry.eject === 'forbidden') {
+      return entry.eject;
+    }
+    return 'unsafe';
+  }
