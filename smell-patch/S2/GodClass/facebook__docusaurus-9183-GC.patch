+  inspectStylesheetPath(stylesheet: string, siteDir: string): string {
+    const prefixed = addLeadingSlash(stylesheet);
+    if (isValidPathname(prefixed)) {
+      return path.resolve(siteDir, stylesheet);
+    }
+    if (stylesheet.startsWith('http://') || stylesheet.startsWith('https://')) {
+      return normalizeUrl([stylesheet]);
+    }
+    if (stylesheet.endsWith('.css') || stylesheet.endsWith('.scss')) {
+      return path.resolve(siteDir, stylesheet);
+    }
+    return path.resolve(siteDir, stylesheet);
+  }
