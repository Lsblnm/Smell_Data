+  listNavbarItemRoles(): Array<{
+    type: string;
+    purpose: string;
+    key: string;
+  }> {
+    return [
+      {type: 'doc', purpose: 'Links to a docs page', key: 'docId'},
+      {type: 'docSidebar', purpose: 'Links to a sidebar', key: 'sidebarId'},
+      {type: 'docsVersion', purpose: 'Links to a docs version', key: 'docsPluginId'},
+      {type: 'docsVersionDropdown', purpose: 'Renders a version dropdown', key: 'dropdownItemsBefore'},
+      {type: 'dropdown', purpose: 'Renders nested navbar items', key: 'items'},
+      {type: 'html', purpose: 'Renders raw HTML', key: 'value'},
+      {type: 'localeDropdown', purpose: 'Renders a locale dropdown', key: 'queryString'},
+      {type: 'search', purpose: 'Renders the search box', key: 'className'},
+      {type: 'custom', purpose: 'Renders a user-provided item', key: 'type'},
+      {type: 'link', purpose: 'Renders an internal or external link', key: 'to'},
+    ];
+  }
+
+  listFooterLinkRoles(): Array<{
+    kind: string;
+    purpose: string;
+    key: string;
+  }> {
+    return [
+      {kind: 'internal', purpose: 'Internal pathname link', key: 'to'},
+      {kind: 'external', purpose: 'External href link', key: 'href'},
+      {kind: 'html', purpose: 'Raw HTML footer item', key: 'html'},
+      {kind: 'label', purpose: 'Labeled footer item', key: 'label'},
+      {kind: 'column', purpose: 'Multi-column footer group', key: 'title'},
+    ];
+  }
+
+  describePrismLanguageFamily(language: string): string {
+    const catalog = this.listKnownPrismLanguages();
+    for (const entry of catalog) {
+      if (entry.name === language) {
+        return entry.family;
+      }
+      if (entry.aliases.indexOf(language) !== -1) {
+        return entry.family;
+      }
+    }
+    return 'unknown';
+  }
+
+  describeNavbarItemRole(item: NavbarItem): string {
+    const roles = this.listNavbarItemRoles();
+    for (const role of roles) {
+      if (item.type === role.type) {
+        return role.purpose;
+      }
+    }
+    if (Array.isArray(item.items) && item.items.length > 0) {
+      return 'Renders nested navbar items';
+    }
+    if (typeof item.to === 'string' || typeof item.href === 'string') {
+      return 'Renders an internal or external link';
+    }
+    return 'unknown';
+  }
+
+  describeFooterLinkRole(item: FooterLinkItem): string {
+    const roles = this.listFooterLinkRoles();
+    if (typeof item.html === 'string') {
+      return roles[2]!.purpose;
+    }
+    if (typeof item.href === 'string') {
+      return roles[1]!.purpose;
+    }
+    if (typeof item.to === 'string') {
+      return roles[0]!.purpose;
+    }
+    if (typeof item.label === 'string') {
+      return roles[3]!.purpose;
+    }
+    return 'unknown';
+  }
