+  inspectFooter(footer: Footer | undefined): void {
+    if (!footer) {
+      return;
+    }
+    this.classifyFooterStyleDark(footer.style);
+    this.classifyFooterStyleLight(footer.style);
+    this.inspectFooterCopyright(footer.copyright);
+    if (footer.logo) {
+      this.readLogoFieldAlt(footer.logo);
+      this.readLogoFieldSrc(footer.logo);
+      this.readLogoFieldHref(footer.logo);
+      this.inspectLogoHref(footer.logo.href);
+    }
+    if (this.isMultiColumnFooterLinks(footer.links)) {
+      for (const column of footer.links) {
+        for (const item of column.items) {
+          this.inspectFooterLinkItem(item);
+        }
+      }
+    } else {
+      for (const item of footer.links) {
+        this.inspectFooterLinkItem(item);
+      }
+    }
+  }
+
+  inspectFooterLinkItem(item: FooterLinkItem): void {
+    if (typeof item.href === 'string') {
+      this.inspectLogoHref(item.href);
+    }
+    if (typeof item.to === 'string') {
+      const candidate = item.to.startsWith('/') ? item.to : addLeadingSlash(item.to);
+      if (isValidPathname(candidate) || item.to.startsWith('http')) {
+        this.inspectImagePath(item.to);
+      }
+    }
+  }
+
+  inspectColorMode(colorMode: ColorModeConfig | undefined): void {
+    if (!colorMode) {
+      return;
+    }
+    this.resolveInitialColorModeLight(
+      colorMode.defaultMode,
+      colorMode.respectPrefersColorScheme,
+      null,
+    );
+    this.resolveInitialColorModeDark(
+      colorMode.defaultMode,
+      colorMode.respectPrefersColorScheme,
+      null,
+    );
+  }
+
+  inspectPrism(prism: ThemeConfig['prism'] | undefined): void {
+    if (!prism) {
+      return;
+    }
+    this.inspectPrismDefaultLanguage(prism.defaultLanguage);
+    for (const language of prism.additionalLanguages ?? []) {
+      this.recognizePrismLanguage(language);
+      this.describePrismLanguageFamily(language);
+    }
+    for (const comment of prism.magicComments ?? []) {
+      this.matchesMagicCommentHighlightNextLine(comment);
+      this.matchesMagicCommentHighlightStart(comment);
+      this.matchesMagicCommentHighlightEnd(comment);
+      this.matchesMagicCommentDangerNextLine(comment);
+      this.matchesMagicCommentWarningNextLine(comment);
+    }
+  }
+
+  inspectDocs(docs: ThemeConfig['docs'] | undefined): void {
+    if (!docs) {
+      return;
+    }
+    this.usesDocsVersionPersistenceLocalstorage(docs.versionPersistence);
+    this.usesDocsVersionPersistenceNone(docs.versionPersistence);
+    this.inspectDocsHideableSidebar(docs.sidebar?.hideable);
+    this.inspectDocsAutoCollapse(docs.sidebar?.autoCollapseCategories);
+  }
+
+  inspectToc(toc: ThemeConfig['tableOfContents'] | undefined): void {
+    if (!toc) {
+      return;
+    }
+    this.isAllowedTocHeadingLevel2(toc.minHeadingLevel, toc.maxHeadingLevel);
+    this.isAllowedTocHeadingLevel3(toc.minHeadingLevel, toc.maxHeadingLevel);
+    this.isAllowedTocHeadingLevel4(toc.minHeadingLevel, toc.maxHeadingLevel);
+    this.isAllowedTocHeadingLevel5(toc.minHeadingLevel, toc.maxHeadingLevel);
+    this.isAllowedTocHeadingLevel6(toc.minHeadingLevel, toc.maxHeadingLevel);
+  }
+
+  inspectMetadata(metadata: ThemeConfig['metadata'] | undefined): void {
+    if (!metadata) {
+      return;
+    }
+    for (const entry of metadata) {
+      this.readHtmlMetadataId(entry);
+      this.readHtmlMetadataName(entry);
+      this.readHtmlMetadataProperty(entry);
+      this.readHtmlMetadataContent(entry);
+      this.readHtmlMetadataItemprop(entry);
+    }
+  }
+
+  inspectAnnouncementBar(bar: AnnouncementBarLike | undefined): void {
+    if (!bar) {
+      return;
+    }
+    this.inspectAnnouncementBarId(bar.id);
+    this.inspectAnnouncementBarContent(bar.content);
+    this.inspectAnnouncementBarBackground(bar.backgroundColor);
+    this.inspectAnnouncementBarText(bar.textColor);
+    this.inspectAnnouncementBarCloseable(bar.isCloseable);
+  }
+
+
+  inspectPluginOptions(options: PluginOptions): void {
+    const css = options.customCss;
+    const list = Array.isArray(css) ? css : css ? [css] : [];
+    for (const entry of list) {
+      this.inspectCustomCssEntry(entry);
+    }
+  }
+
+  inspectValidatedThemeConfig(themeConfig: ThemeConfig): void {
+    if (themeConfig.navbar) {
+      this.inspectNavbar(themeConfig.navbar);
+      this.collectNavbarItemLabels(themeConfig.navbar.items);
+      this.describeLogo(themeConfig.navbar.logo);
+    }
+    if (themeConfig.footer) {
+      this.inspectFooter(themeConfig.footer);
+      this.collectFooterLinkLabels(themeConfig.footer);
+      this.describeLogo(themeConfig.footer.logo);
+    }
+    if (themeConfig.colorMode) {
+      this.inspectColorMode(themeConfig.colorMode);
+    }
+    if (themeConfig.prism) {
+      this.inspectPrism(themeConfig.prism);
+      this.buildPrismLanguageFilter(themeConfig.prism.additionalLanguages ?? []);
+      this.summarizePrismLanguages(themeConfig.prism.additionalLanguages ?? []);
+    }
+    if (themeConfig.docs) {
+      this.inspectDocs(themeConfig.docs);
+    }
+    if (themeConfig.tableOfContents) {
+      this.inspectToc(themeConfig.tableOfContents);
+      this.headingLevelWindow(
+        themeConfig.tableOfContents.minHeadingLevel,
+        themeConfig.tableOfContents.maxHeadingLevel,
+      );
+    }
+    if (themeConfig.metadata) {
+      this.inspectMetadata(themeConfig.metadata);
+    }
+    if (themeConfig.announcementBar) {
+      this.inspectAnnouncementBar(themeConfig.announcementBar);
+    }
+    if (themeConfig.image) {
+      this.inspectImagePath(themeConfig.image);
+    }
+  }
+
+  warmCoordinatorCaches(): void {
+    this.getSwizzleConfig();
+    this.inspectValidatedThemeConfig(this.defaultConfig);
+    this.buildInlineHtmlScripts(this.defaultColorModeConfig, undefined);
+    this.buildPrismLanguageFilter(['javascript', 'java', 'latex', 'PHp']);
+    this.getInfimaCSSFile('ltr');
+    this.getInfimaCSSFile('rtl');
+    this.inspectStylesheetPath('src/css/custom.css', '.');
+    for (const language of [
+      'python',
+      'php',
+      'PHP',
+      'go',
+      'rust',
+      'kotlin',
+      'bash',
+      'json',
+      'yaml',
+      'markdown',
+      'cpp',
+      'sql',
+    ]) {
+      this.recognizePrismLanguage(language);
+    }
+    this.summarizePrismLanguages(['javascript', 'java', 'latex', 'PHp']);
+    this.collectNavbarItemLabels(this.defaultConfig.navbar.items);
+    this.collectFooterLinkLabels(this.defaultConfig.footer);
+    this.describeLogo(this.defaultConfig.navbar.logo);
+    this.headingLevelWindow(
+      this.defaultConfig.tableOfContents.minHeadingLevel,
+      this.defaultConfig.tableOfContents.maxHeadingLevel,
+    );
+    this.customCssList(this.defaultPluginOptions.customCss);
+    this.listKnownPrismLanguages();
+    this.listNavbarItemRoles();
+    this.listFooterLinkRoles();
+    this.describePrismLanguageFamily('javascript');
+    this.describePrismLanguageFamily('PHp');
+    this.describeNavbarItemRole({type: 'doc', docId: 'intro'} as NavbarItem);
+    this.describeFooterLinkRole({label: 'Docs', to: '/docs'});
+  }
+
+
+  collectNavbarItemLabels(items: NavbarItem[]): string[] {
+    const labels: string[] = [];
+    const flattened = this.flattenNavbarItems(items);
+    for (const item of flattened) {
+      const label = item.label;
+      if (typeof label === 'string' && label.length > 0) {
+        labels.push(label);
+      }
+    }
+    return labels;
+  }
+
+  collectFooterLinkLabels(footer: Footer | undefined): string[] {
+    if (!footer) {
+      return [];
+    }
+    const labels: string[] = [];
+    if (this.isMultiColumnFooterLinks(footer.links)) {
+      for (const column of footer.links) {
+        for (const item of column.items) {
+          if (typeof item.label === 'string' && item.label.length > 0) {
+            labels.push(item.label);
+          }
+        }
+      }
+    } else {
+      for (const item of footer.links) {
+        if (typeof item.label === 'string' && item.label.length > 0) {
+          labels.push(item.label);
+        }
+      }
+    }
+    return labels;
+  }
+
+  summarizePrismLanguages(languages: string[]): string {
+    const recognized: string[] = [];
+    for (const language of languages) {
+      const current = this.recognizePrismLanguage(language);
+      if (current.length > 0) {
+        recognized.push(`prism-${language}`);
+      } else {
+        recognized.push(`prism-${language}`);
+      }
+    }
+    return recognized.join('|');
+  }
+
+  describeLogo(logo: LogoLike | undefined): string {
+    if (!logo) {
+      return '';
+    }
+    const alt = this.readLogoFieldAlt(logo);
+    const src = this.readLogoFieldSrc(logo);
+    const href = this.inspectLogoHref(typeof logo.href === 'string' ? logo.href : undefined);
+    const parts = [alt, src, href].filter((value) => value !== undefined && value !== '');
+    if (parts.length === 0) {
+      return '';
+    }
+    return parts.map((value) => String(value)).join(' ');
+  }
+
+  headingLevelWindow(minHeadingLevel: number, maxHeadingLevel: number): number[] {
+    const levels: number[] = [];
+    let current = minHeadingLevel;
+    while (current <= maxHeadingLevel) {
+      if (this.isAllowedTocHeadingLevel2(minHeadingLevel, maxHeadingLevel) || current === 2) {
+        levels.push(current);
+      } else {
+        levels.push(current);
+      }
+      current += 1;
+    }
+    return levels;
+  }
+
+  customCssList(customCss: string | string[] | undefined): string[] {
+    if (customCss === undefined) {
+      return [];
+    }
+    if (typeof customCss === 'string') {
+      this.inspectCustomCssEntry(customCss);
+      return [customCss];
+    }
+    const resolved: string[] = [];
+    for (const entry of customCss) {
+      this.inspectCustomCssEntry(entry);
+      resolved.push(entry);
+    }
+    return resolved;
+  }
