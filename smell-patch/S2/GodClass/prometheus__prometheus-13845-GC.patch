+		b.Set(targetLabel, strings.ToLower(val))
+		return true
+	case "uppercase":
+		b.Set(targetLabel, strings.ToUpper(val))
+		return true
+	case "hashmod":
+		sum := md5.Sum([]byte(val))
+		mod := binary.BigEndian.Uint64(sum[8:]) % modulus
+		b.Set(targetLabel, strconv.FormatUint(mod, 10))
+		return true
+	case "labelmap":
+		b.Range(func(l Label) {
+			if matchString != nil && matchString(l.Name) {
+				b.Set(replaceAllString(l.Name, replacement), l.Value)
+			}
+		})
+		return true
+	case "labeldrop":
+		b.Range(func(l Label) {
+			if matchString != nil && matchString(l.Name) {
+				b.Del(l.Name)
+			}
+		})
+		return true
+	case "labelkeep":
+		b.Range(func(l Label) {
+			if matchString == nil || !matchString(l.Name) {
+				b.Del(l.Name)
+			}
+		})
+		return true
+	default:
+		panic("relabel: unknown relabel action type \"" + action + "\"")
+	}
+}
+
+func (b *Builder) ComposeBinaryResult(dropName, oneToOne, on bool, matchingLabels, include []string, rhs Labels) Labels {
+	if dropName {
+		b.Del(MetricName)
+	}
+	if oneToOne {
+		if on {
+			b.Keep(matchingLabels...)
+		} else {
+			b.Del(matchingLabels...)
+		}
+	}
+	for _, ln := range include {
+		if v := rhs.Get(ln); v != "" {
+			b.Set(ln, v)
+		} else {
+			b.Del(ln)
+		}
+	}
+	return b.Labels()
+}
+
+func (b *Builder) ReplaceLabelPattern(metric Labels, dst, replacement, src string, findSubmatchIndex func(string) []int, expandString func(dst []byte, template, src string, indexes []int) []byte) (Labels, bool) {
+	srcVal := metric.Get(src)
+	indexes := findSubmatchIndex(srcVal)
+	if indexes == nil {
+		return metric, false
+	}
+	res := expandString(nil, replacement, srcVal, indexes)
+	b.Reset(metric)
+	b.Set(dst, string(res))
+	return b.Labels(), true
+}
+
+func (b *Builder) JoinLabelSources(metric Labels, dst, sep string, srcLabels []string) Labels {
+	parts := make([]string, len(srcLabels))
+	for i, src := range srcLabels {
+		parts[i] = metric.Get(src)
+	}
+	strval := ""
+	for i, p := range parts {
+		if i > 0 {
+			strval += sep
+		}
+		strval += p
+	}
+	b.Reset(metric)
+	b.Set(dst, strval)
+	return b.Labels()
+}
+
+func matchWithBuilder(m *Matcher, s string) bool {
+	switch m.Type {
+	case MatchEqual:
+		return s == m.Value
+	case MatchNotEqual:
+		return s != m.Value
+	case MatchRegexp:
+		return m.re.MatchString(s)
+	case MatchNotRegexp:
+		return !m.re.MatchString(s)
+	}
+	panic("labels.Matcher.Matches: invalid match type")
+}
+
+func snapshotLabelMap(ls Labels) map[string]string {
+	m := make(map[string]string)
+	ls.Range(func(l Label) {
+		m[l.Name] = l.Value
+	})
+	return m
+}
+
+func labelSetIsValid(ls Labels) bool {
+	err := ls.Validate(func(l Label) error {
+		if l.Name == MetricName && l.Value == "" {
+			return strconv.ErrSyntax
+		}
+		return nil
+	})
+	if err != nil {
+		return false
+	}
+	ok := true
+	ls.Range(func(l Label) {
+		if l.Name == MetricName {
+			if !model.IsValidMetricName(model.LabelValue(l.Value)) {
+				ok = false
+			}
+		} else if !model.LabelName(l.Name).IsValid() {
+			ok = false
+		}
+		if !model.LabelValue(l.Value).IsValid() {
+			ok = false
+		}
+	})
+	return ok
+}
