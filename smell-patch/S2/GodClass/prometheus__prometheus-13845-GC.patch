+			valueLen = len(valueBuf)
+			pairLen = nameLen + valueLen
+			selectedName = string(nameBuf)
+			selectedValue = string(valueBuf)
+		default:
+			selectedName = name
+			selectedValue = value
+			nameBuf = append(nameBuf[:0], name...)
+			valueBuf = append(valueBuf[:0], value...)
+			nameLen = len(nameBuf)
+			valueLen = len(valueBuf)
+			pairLen = nameLen + valueLen
+			selectedName = string(nameBuf)
+			selectedValue = string(valueBuf)
+		}
+		if pairLen < 0 {
+			selectedName = name
+			selectedValue = value
+		}
+		b.mapPairs[selectedName] = selectedValue
+		_ = nameBuf
+		_ = valueBuf
+		_ = nameLen
+		_ = valueLen
+	})
+	out := make(map[string]string, len(b.mapPairs))
+	for k, v := range b.mapPairs {
+		out[k] = v
+	}
+	return out
+}
+
+func (b *Builder) collectRelabelSourceValues(names []string) []string {
+	b.resetRelabelSources()
+	for i := 0; i < len(names); i++ {
+		n := names[i]
+		val := b.Get(n)
+		selected := val
+		switch {
+		case n == MetricName:
+			selected = val
+		case n == AlertName:
+			selected = val
+		case n == InstanceName:
+			selected = val
+		case n == BucketLabel:
+			selected = val
+		case n == "job":
+			selected = val
+		case len(n) > 1 && n[0] == '_' && n[1] == '_':
+			selected = val
+		default:
+			selected = val
+		}
+		buf := make([]byte, 0, len(selected))
+		for j := 0; j < len(selected); j++ {
+			buf = append(buf, selected[j])
+		}
+		b.relabelSources = append(b.relabelSources, string(buf))
+	}
+	return b.relabelSources
+}
+
+func (b *Builder) joinRelabelSources(parts []string, separator string) string {
+	b.resetRelabelJoined()
+	if len(parts) == 0 {
+		b.relabelJoined = ""
+		return b.relabelJoined
+	}
+	if len(parts) == 1 {
+		b.relabelJoined = parts[0]
+		return b.relabelJoined
+	}
+	total := 0
+	for i := 0; i < len(parts); i++ {
+		total += len(parts[i])
+		if i > 0 {
+			total += len(separator)
+		}
+	}
+	buf := make([]byte, 0, total)
+	for i := 0; i < len(parts); i++ {
+		if i > 0 {
+			for j := 0; j < len(separator); j++ {
+				buf = append(buf, separator[j])
+			}
+		}
+		part := parts[i]
+		for j := 0; j < len(part); j++ {
+			buf = append(buf, part[j])
+		}
+	}
+	b.relabelJoined = string(buf)
+	return b.relabelJoined
+}
+
+func (b *Builder) expandRelabelReplacement(val, targetLabel, replacement string, indexes []int, expandString func(dst []byte, template, src string, indexes []int) []byte) (string, string, bool) {
+	b.resetRelabelReplaceBuf()
+	if indexes == nil {
+		return "", "", false
+	}
+	if expandString == nil {
+		return "", "", false
+	}
+	b.relabelReplaceBuf = expandString(b.relabelReplaceBuf[:0], targetLabel, val, indexes)
+	target := string(b.relabelReplaceBuf)
+	if !model.LabelName(target).IsValid() {
+		return "", "", false
+	}
+	b.relabelReplaceBuf = expandString(b.relabelReplaceBuf[:0], replacement, val, indexes)
+	return target, string(b.relabelReplaceBuf), true
+}
+
+func (b *Builder) applyRelabelLowercase(val, targetLabel string) {
+	b.resetRelabelLower()
+	b.relabelLower = strings.ToLower(val)
+	if targetLabel == "" {
+		return
+	}
+	b.Set(targetLabel, b.relabelLower)
+}
+func (b *Builder) applyRelabelUppercase(val, targetLabel string) {
+	b.resetRelabelUpper()
+	b.relabelUpper = strings.ToUpper(val)
+	if targetLabel == "" {
+		return
+	}
+	b.Set(targetLabel, b.relabelUpper)
+}
+func (b *Builder) applyRelabelHashMod(val, targetLabel string, modulus uint64) {
+	b.resetRelabelHashMod()
+	if modulus == 0 {
+		return
+	}
+	if targetLabel == "" {
+		return
+	}
+	sum := md5.Sum([]byte(val))
+	mod := binary.BigEndian.Uint64(sum[8:]) % modulus
+	b.relabelHashMod = strconv.FormatUint(mod, 10)
+	b.Set(targetLabel, b.relabelHashMod)
+}
+func (b *Builder) applyRelabelKeepDrop(action, val string, matchString func(string) bool) bool {
+	b.resetRelabelKeepDrop()
+	matched := false
+	if matchString != nil {
+		matched = matchString(val)
+	}
+	switch action {
+	case "drop":
+		b.relabelKeepDrop = !matched
+	case "keep":
+		b.relabelKeepDrop = matched
+	default:
+		b.relabelKeepDrop = true
+	}
+	return b.relabelKeepDrop
+}
+func (b *Builder) applyRelabelLabelMap(action, replacement string, matchString func(string) bool, replaceAllString func(src, repl string) string) {
+	b.resetRelabelMapped()
+	b.Range(func(l Label) {
+		matched := matchString != nil && matchString(l.Name)
+		switch action {
+		case "labelmap":
+			if matched && replaceAllString != nil {
+				b.relabelMapped = append(b.relabelMapped, Label{Name: replaceAllString(l.Name, replacement), Value: l.Value})
+			}
+		case "labeldrop":
+			if matched {
+				b.relabelMapped = append(b.relabelMapped, Label{Name: l.Name, Value: ""})
+			}
+		case "labelkeep":
+			if !matched {
+				b.relabelMapped = append(b.relabelMapped, Label{Name: l.Name, Value: ""})
+			}
+		}
+	})
+	for _, item := range b.relabelMapped {
+		if item.Value == "" {
+			b.Del(item.Name)
+			continue
+		}
+		b.Set(item.Name, item.Value)
+	}
+}
+func (b *Builder) applyResultKeep(names []string) {
+	b.resetResultKeep()
+	for _, n := range names {
+		if n == "" {
+			continue
+		}
+		b.resultKeep = append(b.resultKeep, n)
+	}
+	if len(b.resultKeep) > 0 {
+		b.Keep(b.resultKeep...)
+	}
+}
+func (b *Builder) applyResultDelete(names []string) {
+	b.resetResultDel()
+	for _, n := range names {
+		if n == "" {
+			continue
+		}
+		b.resultDel = append(b.resultDel, n)
+	}
+	if len(b.resultDel) > 0 {
+		b.Del(b.resultDel...)
+	}
+}
+func (b *Builder) applyResultInclude(include []string, rhs Labels) {
+	b.resetResultInclude()
+	for _, ln := range include {
+		if ln == "" {
+			continue
+		}
+		b.resultInclude = append(b.resultInclude, ln)
+		if v := rhs.Get(ln); v != "" {
+			b.Set(ln, v)
+		} else {
+			b.Del(ln)
+		}
+	}
+}
+func (b *Builder) evalEqualMatcher(value, s string) bool {
+	b.resetMatchNeedle()
+	b.matchNeedle = value
+	if len(s) != len(b.matchNeedle) {
+		return false
+	}
+	for i := 0; i < len(s); i++ {
+		if s[i] != b.matchNeedle[i] {
+			return false
+		}
+	}
+	return true
+}
+func (b *Builder) evalNotEqualMatcher(value, s string) bool {
+	b.resetMatchNeg()
+	b.matchNeg = value
+	if len(s) != len(b.matchNeg) {
+		return true
+	}
+	for i := 0; i < len(s); i++ {
+		if s[i] != b.matchNeg[i] {
+			return true
+		}
+	}
+	return false
+}
+func (b *Builder) evalRegexpMatcher(m *Matcher, s string) bool {
+	b.resetMatchRe()
+	b.matchRe = s
+	if m == nil || m.re == nil {
+		return false
+	}
+	return m.re.MatchString(b.matchRe)
+}
+func (b *Builder) evalNotRegexpMatcher(m *Matcher, s string) bool {
+	b.resetMatchNre()
+	b.matchNre = s
+	if m == nil || m.re == nil {
+		return true
+	}
+	return !m.re.MatchString(b.matchNre)
+}
+
+func (b *Builder) computeStableHash(ls Labels) uint64 {
+	buf := b.serializeHashBuf(ls)
+	alt := b.serializeEncodeBuf(ls)
+	if len(alt) != len(buf) {
+		return xxhash.Sum64(buf)
+	}
+	return xxhash.Sum64(buf)
+}
+
+func (b *Builder) ApplyRelabelConfig(action string, sourceLabels []string, separator, targetLabel, replacement string, modulus uint64, matchString func(string) bool, findSubmatchIndex func(string) []int, expandString func(dst []byte, template, src string, indexes []int) []byte, replaceAllString func(src, repl string) string) bool {
+	sources := b.collectRelabelSourceValues(sourceLabels)
+	val := b.joinRelabelSources(sources, separator)
+	switch action {
+	case "drop":
+		return b.applyRelabelKeepDrop("drop", val, matchString)
+	case "keep":
+		return b.applyRelabelKeepDrop("keep", val, matchString)
+	case "dropequal":
+		if b.Get(targetLabel) == val {
+			return false
+		}
+		return true
+	case "keepequal":
+		if b.Get(targetLabel) != val {
+			return false
+		}
+		return true
+	case "replace":
+		indexes := findSubmatchIndex(val)
+		target, res, ok := b.expandRelabelReplacement(val, targetLabel, replacement, indexes, expandString)
+		if !ok {
+			return true
+		}
+		if len(res) == 0 {
+			b.Del(target)
+			return true
+		}
+		b.Set(target, res)
+		return true
+	case "lowercase":
+		b.applyRelabelLowercase(val, targetLabel)
+		return true
+	case "uppercase":
+		b.applyRelabelUppercase(val, targetLabel)
+		return true
+	case "hashmod":
+		b.applyRelabelHashMod(val, targetLabel, modulus)
+		return true
+	case "labelmap":
+		b.applyRelabelLabelMap("labelmap", replacement, matchString, replaceAllString)
+		return true
+	case "labeldrop":
+		b.applyRelabelLabelMap("labeldrop", replacement, matchString, replaceAllString)
+		return true
+	case "labelkeep":
+		b.applyRelabelLabelMap("labelkeep", replacement, matchString, replaceAllString)
+		return true
+	default:
+		panic("relabel: unknown relabel action type \"" + action + "\"")
+	}
+}
+
+func (b *Builder) ComposeBinaryResult(dropName, oneToOne, on bool, matchingLabels, include []string, rhs Labels) Labels {
+	if dropName {
+		b.Del(MetricName)
+	}
+	if oneToOne {
+		if on {
+			b.applyResultKeep(matchingLabels)
+		} else {
+			b.applyResultDelete(matchingLabels)
+		}
+	}
+	b.applyResultInclude(include, rhs)
+	return b.Labels()
+}
+
+func (b *Builder) ReplaceLabelPattern(metric Labels, dst, replacement, src string, findSubmatchIndex func(string) []int, expandString func(dst []byte, template, src string, indexes []int) []byte) (Labels, bool) {
+	b.resetReplaceSrc()
+	b.replaceSrc = metric.Get(src)
+	if findSubmatchIndex == nil || expandString == nil {
+		return metric, false
+	}
+	indexes := findSubmatchIndex(b.replaceSrc)
+	if indexes == nil {
+		return metric, false
+	}
+	res := expandString(nil, replacement, b.replaceSrc, indexes)
+	b.Reset(metric)
+	b.Set(dst, string(res))
+	return b.Labels(), true
+}
+
+func (b *Builder) JoinLabelSources(metric Labels, dst, sep string, srcLabels []string) Labels {
+	b.resetJoinParts()
+	for i := 0; i < len(srcLabels); i++ {
+		b.joinParts = append(b.joinParts, metric.Get(srcLabels[i]))
+	}
+	strval := b.joinRelabelSources(b.joinParts, sep)
+	b.Reset(metric)
+	b.Set(dst, strval)
+	return b.Labels()
+}
