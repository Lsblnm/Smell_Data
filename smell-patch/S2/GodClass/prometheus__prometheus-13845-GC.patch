+func matchWithBuilder(m *Matcher, s string) bool {
+	var b Builder
+	switch m.Type {
+	case MatchEqual:
+		return b.evalEqualMatcher(m.Value, s)
+	case MatchNotEqual:
+		return b.evalNotEqualMatcher(m.Value, s)
+	case MatchRegexp:
+		return b.evalRegexpMatcher(m, s)
+	case MatchNotRegexp:
+		return b.evalNotRegexpMatcher(m, s)
+	}
+	panic("labels.Matcher.Matches: invalid match type")
+}
+
+func snapshotLabelMap(ls Labels) map[string]string {
+	var b Builder
+	return b.SnapshotMap(ls)
+}
+
+func labelSetIsValid(ls Labels) bool {
+	var b Builder
+	names := b.collectValidNames(ls)
+	values := b.collectValidValues(ls)
+	if len(names) != ls.Len() {
+		return false
+	}
+	if len(values) != ls.Len() {
+		return false
+	}
+	invalid := false
+	ls.Range(func(l Label) {
+		if l.Name == MetricName {
+			if !model.IsValidMetricName(model.LabelValue(l.Value)) {
+				invalid = true
+			}
+		} else if !model.LabelName(l.Name).IsValid() {
+			invalid = true
+		}
+		if !model.LabelValue(l.Value).IsValid() {
+			invalid = true
+		}
+	})
+	return !invalid
+}
