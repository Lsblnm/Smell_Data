+func (p *pagePathBuilder) normalizeExpandedPermalink(opath string) string {
+	if opath == "" {
+		return opath
+	}
+	decoded, err := url.QueryUnescape(opath)
+	if err != nil {
+		decoded = opath
+	}
+	decoded = p.permalinkRestoreLeadingSlash(decoded)
+	decoded = p.permalinkRestoreTrailingSlash(decoded)
+	if strings.HasSuffix(decoded, "//") {
+		decoded = strings.TrimSuffix(decoded, "/")
+	}
+	p.permalinkExpanded = decoded
+	return decoded
+}
