+func (p *pagePathBuilder) hydrateDescriptor(d TargetPathDescriptor) TargetPathDescriptor {
+	d.ExpandedPermalink = p.normalizeExpandedPermalink(d.ExpandedPermalink)
+	p.captureKindContext(d.Kind)
+	p.captureFormatContext(d.Type.Name)
+	p.captureMediaContext(d.Type.MediaType.FirstSuffix.FullSuffix)
+	p.captureSlugContext(d.BaseName)
+	sectionBase := ""
+	if d.Section != nil {
+		sectionBase = d.Section.Base()
+	}
+	p.captureSectionContext(sectionBase)
+	p.captureLangFileContext(d.PrefixFilePath)
+	p.captureLangLinkContext(d.PrefixLink)
+	p.captureFrontURLContext(d.URL)
+	p.capturePermalinkContext(d.ExpandedPermalink)
+	p.capturePagerContext(d.Addends)
+	p.captureBundleContext(d.Type.Path)
+	p.captureFilePathContext(d.PrefixFilePath)
+	p.rememberKindAlias(d.Kind)
+	p.rememberFormatAlias(d.Type.Name)
+	return d
+}
