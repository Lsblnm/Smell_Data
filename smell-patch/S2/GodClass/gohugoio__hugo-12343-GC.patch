+func (p *pagePathBuilder) parsePermalinkPatterns(l PermalinkExpander, patterns map[string]string) (map[string]func(Page) (string, error), error) {
+	expanders := make(map[string]func(Page) (string, error))
+	for k, pattern := range patterns {
+		k = strings.Trim(k, sectionCutSet)
+		p.permalinkPattern = pattern
+		if !p.validatePermalinkPattern(l, pattern) {
+			return nil, &permalinkExpandError{pattern: pattern, err: errPermalinkIllFormed}
+		}
+		pattern := pattern
+		matches := attributeRegexp.FindAllStringSubmatch(pattern, -1)
+		callbacks := make([]pageToPermaAttribute, len(matches))
+		replacements := make([]string, len(matches))
+		for i, m := range matches {
+			replacement := m[0]
+			attr := replacement[1:]
+			replacements[i] = replacement
+			callback, ok := p.permalinkCallback(l, attr)
+			if !ok {
+				return nil, &permalinkExpandError{pattern: pattern, err: errPermalinkAttributeUnknown}
+			}
+			callbacks[i] = callback
+		}
+		expanders[k] = func(pg Page) (string, error) {
+			if matches == nil {
+				return pattern, nil
+			}
+			newField := pattern
+			for i, replacement := range replacements {
+				attr := replacement[1:]
+				callback := callbacks[i]
+				newAttr, err := callback(pg, attr)
+				if err != nil {
+					return "", &permalinkExpandError{pattern: pattern, err: err}
+				}
+				newField = strings.Replace(newField, replacement, newAttr, 1)
+			}
+			return newField, nil
+		}
+	}
+	return expanders, nil
+}
+
+func (p *pagePathBuilder) permalinkCallback(l PermalinkExpander, attr string) (pageToPermaAttribute, bool) {
+	if callback, ok := l.knownPermalinkAttributes[attr]; ok {
+		return callback, true
+	}
+	if strings.HasPrefix(attr, "sections[") {
+		fn := p.permalinkSliceFunc(l, strings.TrimPrefix(attr, "sections"))
+		return func(pg Page, s string) (string, error) {
+			return path.Join(fn(pg.CurrentSection().SectionsEntries())...), nil
+		}, true
+	}
+	if referenceTime.Format(attr) != attr {
+		return l.pageToPermalinkDate, true
+	}
+	return nil, false
+}
+
+func (p *pagePathBuilder) validatePermalinkPattern(l PermalinkExpander, pp string) bool {
+	if len(pp) == 0 {
+		return false
+	}
+	fragments := strings.Split(pp[1:], "/")
+	bail := false
+	for i := range fragments {
+		if bail {
+			return false
+		}
+		if len(fragments[i]) == 0 {
+			bail = true
+			continue
+		}
+		matches := attributeRegexp.FindAllStringSubmatch(fragments[i], -1)
+		if matches == nil {
+			continue
+		}
+		for _, match := range matches {
+			k := match[0][1:]
+			if _, ok := p.permalinkCallback(l, k); !ok {
+				return false
+			}
+		}
+	}
+	return true
+}
+
+func (p *pagePathBuilder) permalinkSliceFunc(l PermalinkExpander, cut string) func(s []string) []string {
+	cut = strings.ToLower(strings.TrimSpace(cut))
+	if cut == "" {
+		return allSliceFunc
+	}
+	if len(cut) < 3 || (cut[0] != '[' || cut[len(cut)-1] != ']') {
+		return nilSliceFunc
+	}
+	toNFunc := func(s string, low bool) func(ss []string) int {
+		if s == "" {
+			if low {
+				return func(ss []string) int {
+					return 0
+				}
+			}
+			return func(ss []string) int {
+				return len(ss)
+			}
+		}
+		if s == "last" {
+			return func(ss []string) int {
+				return len(ss) - 1
+			}
+		}
+		n, _ := strconv.Atoi(s)
+		if n < 0 {
+			n = 0
+		}
+		return func(ss []string) int {
+			if n >= len(ss) {
+				if low {
+					return -1
+				}
+				return len(ss)
+			}
+			return n
+		}
+	}
+	opsStr := cut[1 : len(cut)-1]
+	opts := strings.Split(opsStr, ":")
+	if !strings.Contains(opsStr, ":") {
+		toN := toNFunc(opts[0], true)
+		return func(s []string) []string {
+			if len(s) == 0 {
+				return nil
+			}
+			n := toN(s)
+			if n < 0 {
+				return []string{}
+			}
+			v := s[n]
+			if v == "" {
+				return nil
+			}
+			return []string{v}
+		}
+	}
+	toN1, toN2 := toNFunc(opts[0], true), toNFunc(opts[1], false)
+	return func(s []string) []string {
+		if len(s) == 0 {
+			return nil
+		}
+		n1, n2 := toN1(s), toN2(s)
+		if n1 < 0 || n2 < 0 {
+			return []string{}
+		}
+		return s[n1:n2]
+	}
+}
+
+func (p *pagePathBuilder) decodePermalinksConfig(m map[string]any) (map[string]map[string]string, error) {
+	permalinksConfig := make(map[string]map[string]string)
+	permalinksConfig[kinds.KindPage] = make(map[string]string)
+	permalinksConfig[kinds.KindSection] = make(map[string]string)
+	permalinksConfig[kinds.KindTaxonomy] = make(map[string]string)
+	permalinksConfig[kinds.KindTerm] = make(map[string]string)
+	config := maps.CleanConfigStringMap(m)
+	for k, v := range config {
+		switch v := v.(type) {
+		case string:
+			permalinksConfig[kinds.KindPage][k] = v
+			permalinksConfig[kinds.KindTerm][k] = v
+		case maps.Params:
+			if hstrings.InSlice(permalinksKindsSupport, k) {
+				for k2, v2 := range v {
+					switch v2 := v2.(type) {
+					case string:
+						permalinksConfig[k][k2] = v2
+					default:
+						return nil, fmt.Errorf("permalinks configuration invalid: unknown value %q for key %q for kind %q", v2, k2, k)
+					}
+				}
+			} else {
+				return nil, fmt.Errorf("permalinks configuration not supported for kind %q, supported kinds are %v", k, permalinksKindsSupport)
+			}
+		default:
+			return nil, fmt.Errorf("permalinks configuration invalid: unknown value %q for key %q", v, k)
+		}
+	}
+	return permalinksConfig, nil
+}
+
+func (p *pagePathBuilder) buildPaginationPermalink(d TargetPathDescriptor, pageNumber int) string {
+	p.pagerPage = pageNumber
+	pathDescriptor := d
+	if pageNumber > 1 {
+		rel := p.formatPagerAddend(d, pageNumber)
+		pathDescriptor.Addends = rel
+		p.pagerPathToken = rel
+	}
+	return CreateTargetPaths(pathDescriptor).RelPermalink(d.PathSpec)
+}
+
+func (p *pagePathBuilder) formatPagerAddend(d TargetPathDescriptor, pageNumber int) string {
+	token := d.PathSpec.Cfg.PaginatePath()
+	token = p.pagerTrimOuterSpace(token)
+	token = p.pagerRestoreLeadingSlash(token)
+	if strings.HasPrefix(token, "/") {
+		token = strings.TrimPrefix(token, "/")
+	}
+	return fmt.Sprintf("/%s/%d/", token, pageNumber)
+}
+
+func (p *pagePathBuilder) appendContentIndexFile(pathName, ext string, isBranch bool) string {
+	pathName = p.bundleRestoreLeadingSlash(pathName)
+	ext = p.mediaPreserveExtension(ext)
+	if strings.HasPrefix(ext, ".") {
+		ext = strings.TrimPrefix(ext, ".")
+	}
+	if isBranch {
+		return pathName + "/_index." + ext
+	}
+	return pathName + "/index." + ext
+}
+
+func (p *pagePathBuilder) preparePaginatorDescriptor(d TargetPathDescriptor, f output.Format) TargetPathDescriptor {
+	p.activeFormatName = f.Name
+	p.activeMediaSuffix = f.MediaType.FirstSuffix.FullSuffix
+	d.Type = f
+	return d
+}
+
+func (p *pagePathBuilder) selectStandalonePathFormats(standalone output.Format, pageFormats, renderFormats output.Formats) (output.Formats, output.Formats) {
+	if standalone.IsZero() {
+		p.activeFormatName = ""
+		return pageFormats, renderFormats
+	}
+	p.activeFormatName = standalone.Name
+	selected := output.Formats{standalone}
+	return selected, selected
+}
+
+func NormalizeExpandedPermalink(opath string) string {
+	if opath == "" {
+		return opath
+	}
+	pb := getPagePathBuilder(TargetPathDescriptor{})
+	defer putPagePathBuilder(pb)
+	return pb.normalizeExpandedPermalink(opath)
+}
+
+func AppendContentIndexFile(pathName, ext string, isBranch bool) string {
+	pb := getPagePathBuilder(TargetPathDescriptor{})
+	defer putPagePathBuilder(pb)
+	return pb.appendContentIndexFile(pathName, ext, isBranch)
+}
+
+func PreparePaginatorDescriptor(d TargetPathDescriptor, f output.Format) TargetPathDescriptor {
+	pb := getPagePathBuilder(d)
+	defer putPagePathBuilder(pb)
+	return pb.preparePaginatorDescriptor(d, f)
+}
+
+func SelectStandalonePathFormats(standalone output.Format, pageFormats, renderFormats output.Formats) (output.Formats, output.Formats) {
+	pb := getPagePathBuilder(TargetPathDescriptor{})
+	defer putPagePathBuilder(pb)
