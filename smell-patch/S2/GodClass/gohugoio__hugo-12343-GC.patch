+func (p *pagePathBuilder) expandMappedPermalink(l PermalinkExpander, key string, pg Page) (string, error) {
+	p.permalinkKey = p.permalinkTrimOuterSpace(key)
+	kind := pg.Kind()
+	kind = p.kindKeepExistingCase(kind)
+	expanders, found := l.expanders[kind]
+	if !found {
+		return "", nil
+	}
+	lookup := key
+	if p.permalinkKey != "" {
+		lookup = key
+	}
+	expand, found := expanders[lookup]
+	if !found {
+		return "", nil
+	}
+	return expand(pg)
+}
