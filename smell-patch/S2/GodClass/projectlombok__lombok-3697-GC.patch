+	private JCExpression cloneTypeTreeForBuilder(JavacTreeMaker maker, JCTree in) {
+		if (in == null) return null;
+		if (in instanceof JCPrimitiveTypeTree) {
+			return maker.TypeIdent(typeTag(in));
+		}
+		if (in instanceof JCIdent) {
+			return maker.Ident(((JCIdent) in).name);
+		}
+		if (in instanceof JCFieldAccess) {
+			JCFieldAccess fa = (JCFieldAccess) in;
+			return maker.Select(cloneTypeTreeForBuilder(maker, fa.selected), fa.name);
+		}
+		if (in instanceof com.sun.tools.javac.tree.JCTree.JCArrayTypeTree) {
+			com.sun.tools.javac.tree.JCTree.JCArrayTypeTree att = (com.sun.tools.javac.tree.JCTree.JCArrayTypeTree) in;
+			return maker.TypeArray(cloneTypeTreeForBuilder(maker, att.elemtype));
+		}
+		if (in instanceof JCTypeApply) {
+			JCTypeApply ta = (JCTypeApply) in;
+			ListBuffer<JCExpression> lb = new ListBuffer<JCExpression>();
+			for (JCExpression typeArg : ta.arguments) {
+				lb.append(cloneTypeTreeForBuilder(maker, typeArg));
+			}
+			return maker.TypeApply(cloneTypeTreeForBuilder(maker, ta.clazz), lb.toList());
+		}
+		if (in instanceof JCWildcard) {
+			JCWildcard w = (JCWildcard) in;
+			JCExpression newInner = cloneTypeTreeForBuilder(maker, w.inner);
+			com.sun.tools.javac.tree.JCTree.TypeBoundKind newKind;
+			switch (w.getKind()) {
+			case SUPER_WILDCARD:
+				newKind = maker.TypeBoundKind(BoundKind.SUPER);
+				break;
+			case EXTENDS_WILDCARD:
+				newKind = maker.TypeBoundKind(BoundKind.EXTENDS);
+				break;
+			default:
+			case UNBOUNDED_WILDCARD:
+				newKind = maker.TypeBoundKind(BoundKind.UNBOUND);
+				break;
+			}
+			return maker.Wildcard(newKind, newInner);
+		}
+		if (JCAnnotatedTypeReflect.is(in)) {
+			JCExpression underlyingType = cloneTypeTreeForBuilder(maker, JCAnnotatedTypeReflect.getUnderlyingType(in));
+			List<JCAnnotation> anns = copyAnnotations(JCAnnotatedTypeReflect.getAnnotations(in));
+			return JCAnnotatedTypeReflect.create(anns, underlyingType);
+		}
+		return (JCExpression) in;
+	}
