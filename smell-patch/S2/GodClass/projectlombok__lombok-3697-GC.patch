+	private void ensureAnnotationCatalogs() {
+		if (this.copyableAnnotationNames == null) this.copyableAnnotationNames = buildCopyableAnnotationNames();
+		if (this.nonnullAnnotationNames == null) this.nonnullAnnotationNames = buildNonnullAnnotationNames();
+		if (this.jacksonCopyableNames == null) this.jacksonCopyableNames = buildJacksonCopyableAnnotationNames();
+		if (this.setterCopyableNames == null) this.setterCopyableNames = buildSetterCopyableAnnotationNames();
+		if (this.singularSetterCopyableNames == null) this.singularSetterCopyableNames = buildSingularSetterCopyableAnnotationNames();
+	}
+
+	public List<JCAnnotation> findCopyableAnnotationsOn(JavacNode node) {
+		ensureAnnotationCatalogs();
+		java.util.List<TypeName> configuredCopyable = node.getAst().readConfiguration(ConfigurationKeys.COPYABLE_ANNOTATIONS);
+		ListBuffer<JCAnnotation> result = new ListBuffer<JCAnnotation>();
+		for (JavacNode child : node.down()) {
+			if (child.getKind() == Kind.ANNOTATION) {
+				JCAnnotation annotation = (JCAnnotation) child.get();
+				boolean match = false;
+				if (configuredCopyable != null) {
+					for (TypeName cn : configuredCopyable) {
+						if (cn != null && typeMatches(cn.toString(), node, annotation.annotationType)) {
+							result.append(annotation);
+							match = true;
+							break;
+						}
+					}
+				}
+				if (!match) {
+					for (String bn : this.copyableAnnotationNames) {
+						if (typeMatches(bn, node, annotation.annotationType)) {
+							result.append(annotation);
+							break;
+						}
+					}
+				}
+			}
+		}
+		return copyAnnotations(result.toList());
+	}
+
+	public List<JCAnnotation> findCopyableToSetterAnnotationsOn(JavacNode node) {
+		ensureAnnotationCatalogs();
+		return findAnnotationsInCatalog(node, this.setterCopyableNames);
+	}
+
+	public List<JCAnnotation> findCopyableToBuilderSingularSetterAnnotationsOn(JavacNode node) {
+		ensureAnnotationCatalogs();
+		return findAnnotationsInCatalog(node, this.singularSetterCopyableNames);
+	}
