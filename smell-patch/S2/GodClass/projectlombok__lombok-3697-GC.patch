+	private JCMethodDecl stdGenerateBuildMethod(BuilderJob job, Name staticName, JCExpression returnType, List<JCExpression> thrownExceptions, boolean addCleaning) {
+		JavacTreeMaker maker = job.getTreeMaker();
+
+		JCExpression call;
+		ListBuffer<JCStatement> statements = new ListBuffer<JCStatement>();
+
