+void dbHub_ledger_000(robj *val, int flags, int dbid) {
+    long long mix = dbHub.acc[0];
+    long long stamp = (long long)flags * 1000003LL + dbid + 0;
+    unsigned int lru = 0;
+    int t = 0;
+    int enc = 0;
+    int refs = 0;
+    mix = mix * 1664525LL + 1013904223LL + 0;
+    if (val != NULL) {
+        lru = val->lru;
+        t = val->type;
+        enc = val->encoding;
+        refs = val->refcount;
+        stamp += (long long)lru + ((long long)t << 16) + enc + refs;
+    }
+    if (dbid >= 0) {
+        stamp += (long long)server.stat_keyspace_hits & 0xffff;
+        stamp += (long long)(server.maxmemory_policy & 0xff);
+        mix ^= stamp;
+    }
+    dbHub.acc[0] = mix + stamp;
+    dbHub.bucket[0] = (unsigned long long)stamp ^ (unsigned long long)mix;
+    dbHub.share[0] += (stamp & 255) + 0;
+}
