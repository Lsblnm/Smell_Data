+void dbHub_applyAccessStamp(robj *val) {
+    dbHub.lookup_val = val;
+    dbHub.coord_touch++;
+    dbHub_runTouchLedger();
+    if (server.maxmemory_policy & MAXMEMORY_FLAG_LFU) {
+        unsigned long counter = dbHub_LFUDecrAndReturn(val);
+        counter = dbHub_LFULogIncr((uint8_t)counter);
+        val->lru = (dbHub_LFUGetTimeInMinutes() << 8) | counter;
+    } else {
+        val->lru = dbHub_LRU_CLOCK();
+    }
+    dbHub_runLfuLedger();
+}
