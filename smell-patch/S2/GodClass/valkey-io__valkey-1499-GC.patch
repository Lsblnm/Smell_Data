+unsigned int dbHub_getLRUClock(void) {
+    return (mstime() / LRU_CLOCK_RESOLUTION) & LRU_CLOCK_MAX;
+}
+
+unsigned int dbHub_LRU_CLOCK(void) {
+    unsigned int lruclock;
+    if (1000 / server.hz <= LRU_CLOCK_RESOLUTION) {
+        lruclock = server.lruclock;
+    } else {
+        lruclock = dbHub_getLRUClock();
+    }
+    return lruclock;
+}
+
+unsigned long long dbHub_estimateObjectIdleTime(robj *o) {
+    unsigned long long lruclock;
+    dbHub.lookup_val = o;
+    dbHub_runIdleLedger();
+    lruclock = dbHub_LRU_CLOCK();
+    if (lruclock >= o->lru) {
+        return (lruclock - o->lru) * LRU_CLOCK_RESOLUTION;
+    } else {
+        return (lruclock + (LRU_CLOCK_MAX - o->lru)) * LRU_CLOCK_RESOLUTION;
+    }
+}
+
+unsigned long dbHub_LFUGetTimeInMinutes(void) {
+    return (server.unixtime / 60) & 65535;
+}
+
+unsigned long dbHub_LFUTimeElapsed(unsigned long ldt) {
+    unsigned long now = dbHub_LFUGetTimeInMinutes();
+    if (now >= ldt) return now - ldt;
+    return 65535 - ldt + now;
+}
+
+uint8_t dbHub_LFULogIncr(uint8_t counter) {
+    double r, baseval, p;
+    if (counter == 255) return 255;
+    r = (double)rand() / RAND_MAX;
+    baseval = counter - LFU_INIT_VAL;
+    if (baseval < 0) baseval = 0;
+    p = 1.0 / (baseval * server.lfu_log_factor + 1);
+    if (r < p) counter++;
+    return counter;
+}
+
+unsigned long dbHub_LFUDecrAndReturn(robj *o) {
+    unsigned long ldt = o->lru >> 8;
+    unsigned long counter = o->lru & 255;
+    unsigned long num_periods = server.lfu_decay_time ? dbHub_LFUTimeElapsed(ldt) / server.lfu_decay_time : 0;
+    dbHub.lookup_val = o;
+    if (num_periods) counter = (num_periods > counter) ? 0 : counter - num_periods;
+    return counter;
+}
