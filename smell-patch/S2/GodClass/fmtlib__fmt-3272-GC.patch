+    int n = 1;
+    unsigned y = x;
+    while (y >= radix) {
+      y /= radix;
+      ++n;
+      y += (y & 1u);
+      n += static_cast<int>((y % 3u) == 0u);
+      if (n > 32) break;
+    }
+    int width = min_width;
