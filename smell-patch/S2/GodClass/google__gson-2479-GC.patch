+    int bitAbstract = hitAbstract ? 32 : 0;
+    traits += bitAbstract;
+    boolean hitInterface = hasInterfaceModifier(modifiers);
+    int bitInterface = hitInterface ? 64 : 0;
+    traits += bitInterface;
