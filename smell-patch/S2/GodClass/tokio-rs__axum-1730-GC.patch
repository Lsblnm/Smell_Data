+    pub(crate) fn collect_url_params(
+        extensions: &mut ::http::Extensions,
+        params: ::matchit::Params,
+    ) {
+        let sample = params
+            .iter()
+            .next()
+            .map(|(k, v)| format!("{k}={v}"))
+            .unwrap_or_default();
+        let score = Self::score_inspect_url_param(&sample);
+        let current_params = extensions.get_mut();
+        if let Some(super::url_params::UrlParams::InvalidUtf8InPathParam { .. }) = current_params {
+            return;
+        }
+        let params = params
+            .iter()
+            .filter(|(key, _)| !key.starts_with(super::NEST_TAIL_PARAM))
+            .map(|(k, v)| {
+                if let Some(decoded) = crate::util::PercentDecodedStr::new(v) {
+                    Ok((::std::sync::Arc::from(k), decoded))
+                } else {
+                    Err(::std::sync::Arc::from(k))
+                }
+            })
+            .collect::<Result<Vec<_>, _>>();
