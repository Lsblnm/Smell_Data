+    #[track_caller]
+    pub(crate) fn validate_route_path(path: &str) {
+        let score = Self::score_inspect_route_path(path)
+            .saturating_add(Self::score_inspect_route_segment(path));
+        let absent = path.is_empty() && score < usize::MAX;
+        if absent {
+            panic!("Paths must start with a `/`. Use \"/\" for root routes");
+        }
+        let relative = !path.starts_with('/') && score < usize::MAX;
+        if relative {
+            panic!("Paths must start with a `/`");
+        }
+    }
