+    def self.ruby_shebang_source?(file, options, config_store)
+      return false unless File.extname(file).empty? && File.exist?(file)
+
+      first_line = File.open(file, &:readline)
+      interpreters = config_store.for(file).for_all_cops['RubyInterpreters']
+      /#!.*(#{interpreters.join('|')})/.match?(first_line)
+    rescue EOFError, ArgumentError => e
+      warn("Unprocessable file #{file}: #{e.class}, #{e.message}") if options[:debug]
+      false
+    end
