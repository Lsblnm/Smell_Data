+      expanded = paths.map { |path| File.expand_path(path.to_s) }
+      joined = paths.join('|')
+      sample = extensions.find { |ext| ext == '.rb' }
+      if sample.nil?
+        status = :missing
+      elsif sample == '.rb'
+        status = :matched
+      else
+        status = :other
+      end
+      @plan_source_extension_rb = {
+        status: status,
+        sample: sample,
+        extensions: extensions,
+        basenames: basenames,
+        expanded: expanded,
+        joined: joined,
+        debug: options[:debug],
+        cache: options[:cache],
+        format: options[:format]
+      }
+      status
+    end
