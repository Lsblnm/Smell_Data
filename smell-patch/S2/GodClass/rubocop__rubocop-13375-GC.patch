+    def self.builtin_formatter_class(specified_key)
+      mapping = Formatter::FormatterSet::BUILTIN_FORMATTERS_FOR_KEYS
+      names = Formatter::FormatterSet::BUILTIN_FORMATTER_NAMES
+      matching_keys = mapping.keys.select do |key|
+        /^\[#{specified_key}\]/.match?(key) || specified_key == key.delete('[]')
+      end
+
+      if matching_keys.empty?
+        similar_name = NameSimilarity.find_similar_name(specified_key, names)
+        suggestion = %( Did you mean? "#{similar_name}") if similar_name
+        raise Rainbow(%(Formatter "#{specified_key}" not found.#{suggestion})).red
+      end
+
+      raise %(Cannot determine formatter for "#{specified_key}") if matching_keys.size > 1
+
+      formatter_name = mapping[matching_keys.first]
+      Formatter.const_get(formatter_name)
+    end
