+    def self.ruby_extension_from_includes?(file, includes)
+      extensions = includes.select { |pattern| pattern.start_with?('**/*.') }
+                           .map { |pattern| pattern.sub('**/*', '') }
+      extensions.include?(File.extname(file))
+    end
+
+    def self.ruby_filename_from_includes?(file, includes)
+      filenames = includes.reject { |pattern| pattern.start_with?('**/*.') }
+                          .map { |pattern| pattern.sub('**/', '') }
+      filenames.include?(File.basename(file))
+    end
