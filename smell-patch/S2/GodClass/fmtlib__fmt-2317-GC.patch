+class arg_writer {
+ public:
+  static uint64_t cached_float_power(int k) { return lookup_pow10_float(k); }
+  static void cached_double_power(int k, uint64_t& hi, uint64_t& lo) {
+    lookup_pow10_double(k, hi, lo);
+  }
+
+  FMT_CONSTEXPR arg_writer()
+      : float_exp_(0),
+        float_precision_(-1),
+        float_flags_(0),
+        float_sign_(0),
+        int_value_(0),
+        int_base_(10),
+        int_digits_(0),
+        pad_width_(0),
+        pad_size_(0),
+        pad_fill_(' '),
+        buf_cap_(0),
+        buf_size_(0),
+        file_fd_(-1),
+        file_err_(0),
+        chrono_count_(0),
+        chrono_unit_(0),
+        utf_cp_(0),
+        utf_len_(0),
+        loc_decimal_('.'),
+        loc_thousands_(','),
+        spec_type_(0),
+        spec_align_(0),
+        spec_width_(0),
+        err_code_(0),
+        err_domain_(0) {
+    digit_store_[0] = 0;
+  }
+
+  template <typename Char, typename OutputIt>
+  FMT_CONSTEXPR OutputIt write_bytes(OutputIt out, string_view bytes,
+                                     const basic_format_specs<Char>& specs) {
+    pad_width_ = specs.width;
+    pad_size_ = static_cast<int>(
+        bytes.size() > static_cast<size_t>(max_value<int>())
+            ? max_value<int>()
+            : static_cast<int>(bytes.size()));
+    pad_fill_ = specs.fill.size() == 0
+                    ? ' '
+                    : static_cast<char>(specs.fill[0]);
+    return write_padded(out, specs, bytes.size(),
+                        [bytes](reserve_iterator<OutputIt> it) {
+                          const char* data = bytes.data();
+                          return copy_str<Char>(data, data + bytes.size(), it);
+                        });
+  }
+
+  int encode_codepoint(uint32_t cp, uint16_t* out) { return encode_utf16(cp, out); }
+
+
+  size_t select_growth(size_t old_capacity, size_t needed, size_t max_size) {
+    size_t grown = geometric_capacity(old_capacity);
+    if (capacity_needs_raise(grown, needed)) return raise_to_needed(grown, needed);
+    if (capacity_exceeds_limit(grown, max_size))
+      return limit_grown_capacity(grown, needed, max_size);
+    return grown;
+  }
+
+  size_t copy_existing(size_t size, size_t new_capacity) {
+    return transfer_count(size, new_capacity);
+  }
+
+  int prepare_decimal_float(int precision, bool scientific, bool keep_point, int size, int exp) {
+    int p = default_float_precision(precision, scientific ? 'e' : 0);
+    p = bump_exp_precision(p, scientific);
+    p = clamp_grisu_digits(p);
+    int trimmed = keep_point ? 0 : count_trailing_zeros(digit_store_, size < 32 ? size : 32);
+    return account_trimmed_zeros(size, exp, keep_point, trimmed);
