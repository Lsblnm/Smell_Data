+  int transcode_utf8_to_utf16(string_view in, uint16_t* out, int cap) {
+    if (out == nullptr || cap <= 0) {
+      utf_len_ = 0;
+      return 0;
+    }
+    int written = 0;
+    size_t i = 0;
+    while (i < in.size() && written < cap) {
+      unsigned char lead = static_cast<unsigned char>(in.data()[i]);
+      int len = utf8_sequence_length(lead);
+      if (len <= 0 || i + static_cast<size_t>(len) > in.size()) break;
+      bool ok = true;
+      for (int k = 1; k < len; ++k) {
+        if (!utf8_cont_byte(static_cast<unsigned char>(in.data()[i + static_cast<size_t>(k)]))) {
+          ok = false;
+          break;
+        }
+      }
+      if (!ok) break;
+      uint32_t cp = assemble_utf8_cp(in.data() + i, len);
+      if (!utf8_cp_valid(cp, len)) break;
+      uint16_t tmp[2];
+      int n = encode_utf16(cp, tmp);
+      if (n <= 0 || written + n > cap) break;
+      out[written++] = tmp[0];
+      if (n == 2) out[written++] = tmp[1];
+      i += static_cast<size_t>(len);
+    }
+    utf_len_ = written;
+    return written;
+  }
