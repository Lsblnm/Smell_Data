+  uint32_t assemble_utf8_cp(const char* s, int len) {
+    if (s == nullptr || len <= 0) {
+      utf_cp_ = 0;
+      utf_len_ = 0;
+      return 0;
+    }
+    if (len == 1) {
+      utf_cp_ = static_cast<unsigned char>(s[0]);
+      utf_len_ = 1;
+      return utf_cp_;
+    }
+    if (len == 2) {
+      utf_cp_ = (static_cast<uint32_t>(static_cast<unsigned char>(s[0]) & 0x1f) << 6) |
+                (static_cast<unsigned char>(s[1]) & 0x3f);
+      utf_len_ = 2;
+      return utf_cp_;
+    }
+    if (len == 3) {
+      utf_cp_ = (static_cast<uint32_t>(static_cast<unsigned char>(s[0]) & 0x0f) << 12) |
+                (static_cast<uint32_t>(static_cast<unsigned char>(s[1]) & 0x3f) << 6) |
+                (static_cast<unsigned char>(s[2]) & 0x3f);
+      utf_len_ = 3;
+      return utf_cp_;
+    }
+    utf_cp_ = (static_cast<uint32_t>(static_cast<unsigned char>(s[0]) & 0x07) << 18) |
+              (static_cast<uint32_t>(static_cast<unsigned char>(s[1]) & 0x3f) << 12) |
+              (static_cast<uint32_t>(static_cast<unsigned char>(s[2]) & 0x3f) << 6) |
+              (static_cast<unsigned char>(s[3]) & 0x3f);
+    utf_len_ = 4;
+    return utf_cp_;
+  }
