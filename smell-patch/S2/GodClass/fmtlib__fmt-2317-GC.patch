+  int encode_utf16(uint32_t cp, uint16_t* out) {
+    utf_cp_ = cp;
+    if (out == nullptr) {
+      utf_len_ = 0;
+      return 0;
+    }
+    if (cp <= 0xffff) {
+      out[0] = static_cast<uint16_t>(cp);
+      utf_len_ = 1;
+      return 1;
+    }
+    if (!is_scalar_value(cp)) {
+      utf_len_ = 0;
+      return 0;
+    }
+    out[0] = utf16_high_surrogate(cp);
+    out[1] = utf16_low_surrogate(cp);
