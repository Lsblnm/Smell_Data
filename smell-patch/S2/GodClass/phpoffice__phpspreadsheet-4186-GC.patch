+    /**
+     *    Internal functions used for special control purposes.
+     */
+    private static array $controlFunctions = [
+        'MKMATRIX' => [
+            'argumentCount' => '*',
+            'functionCall' => [Internal\MakeMatrix::class, 'make'],
+        ],
+        'NAME.ERROR' => [
+            'argumentCount' => '*',
+            'functionCall' => [ExcelError::class, 'NAME'],
+        ],
+        'WILDCARDMATCH' => [
+            'argumentCount' => '2',
+            'functionCall' => [Internal\WildcardMatch::class, 'compare'],
+        ],
+    ];
+
+    public static function getFunctions(): array
+    {
+        return self::$phpSpreadsheetFunctions;
+    }
+
+    public static function isImplemented(string $function): bool
+    {
+        $function = strtoupper($function);
+        $notImplemented = !isset(self::$phpSpreadsheetFunctions[$function]) || (is_array(self::$phpSpreadsheetFunctions[$function]['functionCall']) && self::$phpSpreadsheetFunctions[$function]['functionCall'][1] === 'DUMMY');
+
+        return !$notImplemented;
+    }
+
+    public static function getImplementedFunctionNames(): array
+    {
+        $returnValue = [];
+        foreach (self::$phpSpreadsheetFunctions as $functionName => $function) {
+            if (self::isImplemented($functionName)) {
+                $returnValue[] = $functionName;
+            }
+        }
+
+        return $returnValue;
+    }
+
+    public static function lookupExcelFunction(string $functionName): ?array
+    {
+        return self::$phpSpreadsheetFunctions[$functionName] ?? null;
+    }
+
+    public static function lookupControlFunction(string $functionName): ?array
+    {
+        return self::$controlFunctions[$functionName] ?? null;
+    }
+
+    public static function hasExcelOrControlFunction(string $functionName): bool
+    {
+        return isset(self::$phpSpreadsheetFunctions[$functionName]) || isset(self::$controlFunctions[$functionName]);
+    }
+
+/**
+     * Write worksheet to XML format.
+     *
+     * @param string[] $stringTable
+     * @param bool $includeCharts Flag indicating if we should write charts
+     *
+     * @return string XML Output
+     */
+    public static function Worksheet_writeWorksheet(Worksheet $part, PhpspreadsheetWorksheet $worksheet, array $stringTable = [], bool $includeCharts = false) : string
+{
+        $part->useDynamicArrays = $part->getParentWriter()->useDynamicArrays();
+        $part->explicitStyle0 = $part->getParentWriter()->getExplicitStyle0();
+        $worksheet->calculateArrays($part->getParentWriter()->getPreCalculateFormulas());
+        $part->numberStoredAsText = '';
+        $part->formula = '';
+        $part->twoDigitTextYear = '';
+        $part->evalError = '';
+        // Create XML writer
+        $objWriter = null;
+        if ($part->getParentWriter()->getUseDiskCaching()) {
+            $objWriter = new XMLWriter(XMLWriter::STORAGE_DISK, $part->getParentWriter()->getDiskCachingDirectory());
+        } else {
+            $objWriter = new XMLWriter(XMLWriter::STORAGE_MEMORY);
+        }
+
+        // XML header
+        $objWriter->startDocument('1.0', 'UTF-8', 'yes');
+
+        // Worksheet
+        $objWriter->startElement('worksheet');
+        $objWriter->writeAttribute('xml:space', 'preserve');
+        $objWriter->writeAttribute('xmlns', Namespaces::MAIN);
+        $objWriter->writeAttribute('xmlns:r', Namespaces::SCHEMA_OFFICE_DOCUMENT);
+
+        $objWriter->writeAttribute('xmlns:xdr', Namespaces::SPREADSHEET_DRAWING);
+        $objWriter->writeAttribute('xmlns:x14', Namespaces::DATA_VALIDATIONS1);
+        $objWriter->writeAttribute('xmlns:xm', Namespaces::DATA_VALIDATIONS2);
+        $objWriter->writeAttribute('xmlns:mc', Namespaces::COMPATIBILITY);
+        $objWriter->writeAttribute('mc:Ignorable', 'x14ac');
+        $objWriter->writeAttribute('xmlns:x14ac', Namespaces::SPREADSHEETML_AC);
+
+        // sheetPr
+        self::Worksheet_writeSheetPr($part, $objWriter, $worksheet);
+
+        // Dimension
+        self::Worksheet_writeDimension($part, $objWriter, $worksheet);
+
+        // sheetViews
+        self::Worksheet_writeSheetViews($part, $objWriter, $worksheet);
+
+        // sheetFormatPr
+        self::Worksheet_writeSheetFormatPr($part, $objWriter, $worksheet);
+
+        // cols
+        self::Worksheet_writeCols($part, $objWriter, $worksheet);
+
+        // sheetData
+        self::Worksheet_writeSheetData($part, $objWriter, $worksheet, $stringTable);
+
+        // sheetProtection
+        self::Worksheet_writeSheetProtection($part, $objWriter, $worksheet);
+
+        // protectedRanges
+        self::Worksheet_writeProtectedRanges($part, $objWriter, $worksheet);
+
+        // autoFilter
+        self::Worksheet_writeAutoFilter($part, $objWriter, $worksheet);
+
+        // mergeCells
+        self::Worksheet_writeMergeCells($part, $objWriter, $worksheet);
+
+        // conditionalFormatting
+        self::Worksheet_writeConditionalFormatting($part, $objWriter, $worksheet);
+
+        // dataValidations
+        self::Worksheet_writeDataValidations($part, $objWriter, $worksheet);
+
+        // hyperlinks
+        self::Worksheet_writeHyperlinks($part, $objWriter, $worksheet);
+
+        // Print options
+        self::Worksheet_writePrintOptions($part, $objWriter, $worksheet);
+
+        // Page margins
+        self::Worksheet_writePageMargins($part, $objWriter, $worksheet);
+
+        // Page setup
+        self::Worksheet_writePageSetup($part, $objWriter, $worksheet);
+
+        // Header / footer
+        self::Worksheet_writeHeaderFooter($part, $objWriter, $worksheet);
+
+        // Breaks
+        self::Worksheet_writeBreaks($part, $objWriter, $worksheet);
+
+        // Drawings and/or Charts
+        self::Worksheet_writeDrawings($part, $objWriter, $worksheet, $includeCharts);
+
+        // LegacyDrawing
+        self::Worksheet_writeLegacyDrawing($part, $objWriter, $worksheet);
+
+        // LegacyDrawingHF
+        self::Worksheet_writeLegacyDrawingHF($part, $objWriter, $worksheet);
+
+        // AlternateContent
+        self::Worksheet_writeAlternateContent($part, $objWriter, $worksheet);
+
+        // IgnoredErrors
+        self::Worksheet_writeIgnoredErrors($part, $objWriter);
+
+        // BackgroundImage must come after ignored, before table
+        self::Worksheet_writeBackgroundImage($part, $objWriter, $worksheet);
+
+        // Table
+        self::Worksheet_writeTable($part, $objWriter, $worksheet);
+
+        // ConditionalFormattingRuleExtensionList
+        // (Must be inserted last. Not insert last, an Excel parse error will occur)
+        self::Worksheet_writeExtLst($part, $objWriter, $worksheet);
+
+        $objWriter->endElement();
+
+        // Return
+        return $objWriter->getData();
+    }
