+/**
+     * Write styles to XML format.
+     *
+     * @return string XML Output
+     */
+    public static function Style_writeStyles(Style $part, Spreadsheet $spreadsheet) : string
+{
+        // Create XML writer
+        $objWriter = null;
+        if ($part->getParentWriter()->getUseDiskCaching()) {
+            $objWriter = new XMLWriter(XMLWriter::STORAGE_DISK, $part->getParentWriter()->getDiskCachingDirectory());
+        } else {
+            $objWriter = new XMLWriter(XMLWriter::STORAGE_MEMORY);
+        }
+
+        // XML header
+        $objWriter->startDocument('1.0', 'UTF-8', 'yes');
+
+        // styleSheet
+        $objWriter->startElement('styleSheet');
+        $objWriter->writeAttribute('xml:space', 'preserve');
+        $objWriter->writeAttribute('xmlns', Namespaces::MAIN);
+
+        // numFmts
+        $objWriter->startElement('numFmts');
+        $objWriter->writeAttribute('count', (string) $part->getParentWriter()->getNumFmtHashTable()->count());
+
+        // numFmt
+        for ($i = 0; $i < $part->getParentWriter()->getNumFmtHashTable()->count(); ++$i) {
+            self::Style_writeNumFmt($part, $objWriter, $part->getParentWriter()->getNumFmtHashTable()->getByIndex($i), $i);
+        }
+
+        $objWriter->endElement();
+
+        // fonts
+        $objWriter->startElement('fonts');
+        $objWriter->writeAttribute('count', (string) $part->getParentWriter()->getFontHashTable()->count());
+
+        // font
+        for ($i = 0; $i < $part->getParentWriter()->getFontHashTable()->count(); ++$i) {
+            $thisfont = $part->getParentWriter()->getFontHashTable()->getByIndex($i);
+            if ($thisfont !== null) {
+                self::Style_writeFont($part, $objWriter, $thisfont);
+            }
+        }
+
+        $objWriter->endElement();
+
+        // fills
+        $objWriter->startElement('fills');
+        $objWriter->writeAttribute('count', (string) $part->getParentWriter()->getFillHashTable()->count());
+
+        // fill
+        for ($i = 0; $i < $part->getParentWriter()->getFillHashTable()->count(); ++$i) {
+            $thisfill = $part->getParentWriter()->getFillHashTable()->getByIndex($i);
+            if ($thisfill !== null) {
+                self::Style_writeFill($part, $objWriter, $thisfill);
+            }
+        }
+
+        $objWriter->endElement();
+
+        // borders
+        $objWriter->startElement('borders');
+        $objWriter->writeAttribute('count', (string) $part->getParentWriter()->getBordersHashTable()->count());
+
+        // border
+        for ($i = 0; $i < $part->getParentWriter()->getBordersHashTable()->count(); ++$i) {
+            $thisborder = $part->getParentWriter()->getBordersHashTable()->getByIndex($i);
+            if ($thisborder !== null) {
+                self::Style_writeBorder($part, $objWriter, $thisborder);
+            }
+        }
+
+        $objWriter->endElement();
+
+        // cellStyleXfs
+        $objWriter->startElement('cellStyleXfs');
+        $objWriter->writeAttribute('count', '1');
+
+        // xf
+        $objWriter->startElement('xf');
+        $objWriter->writeAttribute('numFmtId', '0');
+        $objWriter->writeAttribute('fontId', '0');
+        $objWriter->writeAttribute('fillId', '0');
+        $objWriter->writeAttribute('borderId', '0');
+        $objWriter->endElement();
+
+        $objWriter->endElement();
+
+        // cellXfs
+        $objWriter->startElement('cellXfs');
+        $objWriter->writeAttribute('count', (string) count($spreadsheet->getCellXfCollection()));
+
+        // xf
+        $alignment = new Alignment();
+        $defaultAlignHash = $alignment->getHashCode();
+        if ($defaultAlignHash !== $spreadsheet->getDefaultStyle()->getAlignment()->getHashCode()) {
+            $defaultAlignHash = '';
+        }
+        foreach ($spreadsheet->getCellXfCollection() as $cellXf) {
+            self::Style_writeCellStyleXf($part, $objWriter, $cellXf, $spreadsheet, $defaultAlignHash);
+        }
+
+        $objWriter->endElement();
+
+        // cellStyles
+        $objWriter->startElement('cellStyles');
+        $objWriter->writeAttribute('count', '1');
+
+        // cellStyle
+        $objWriter->startElement('cellStyle');
+        $objWriter->writeAttribute('name', 'Normal');
+        $objWriter->writeAttribute('xfId', '0');
+        $objWriter->writeAttribute('builtinId', '0');
+        $objWriter->endElement();
+
+        $objWriter->endElement();
+
+        // dxfs
+        $objWriter->startElement('dxfs');
+        $objWriter->writeAttribute('count', (string) $part->getParentWriter()->getStylesConditionalHashTable()->count());
+
+        // dxf
+        for ($i = 0; $i < $part->getParentWriter()->getStylesConditionalHashTable()->count(); ++$i) {
+            $thisstyle = $part->getParentWriter()->getStylesConditionalHashTable()->getByIndex($i);
+            if ($thisstyle !== null) {
+                self::Style_writeCellStyleDxf($part, $objWriter, $thisstyle->getStyle());
+            }
+        }
+
+        $objWriter->endElement();
+
+        // tableStyles
+        $objWriter->startElement('tableStyles');
+        $objWriter->writeAttribute('defaultTableStyle', 'TableStyleMedium9');
+        $objWriter->writeAttribute('defaultPivotStyle', 'PivotTableStyle1');
+        $objWriter->endElement();
+
+        $objWriter->endElement();
+
+        // Return
+        return $objWriter->getData();
+    }
