-        if ($zoomScale !== 100 && $zoomScale !== null) {
-            $objWriter->writeAttribute('zoomScale', (string) $zoomScale);
-        }
-        $zoomScale = $worksheet->getSheetView()->getZoomScaleNormal();
-        if ($zoomScale !== 100 && $zoomScale !== null) {
-            $objWriter->writeAttribute('zoomScaleNormal', (string) $zoomScale);
