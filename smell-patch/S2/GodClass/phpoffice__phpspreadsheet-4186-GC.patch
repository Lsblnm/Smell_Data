+    public static function Chart_writeView3D(Chart $part, XMLWriter $objWriter, ?int $value, string $tag, bool $surface2D, int $default = 0) : void
+{
+        if ($value === null && $surface2D) {
+            $value = $default;
+        }
+        if ($value !== null) {
+            $objWriter->startElement($tag);
+            $objWriter->writeAttribute('val', "$value");
+            $objWriter->endElement();
+        }
+    }
