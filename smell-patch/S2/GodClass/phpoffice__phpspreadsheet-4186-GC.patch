+/**
+     * Write Cell Style Dxf.
+     */
+    public static function Style_writeCellStyleDxf(Style $part, XMLWriter $objWriter, \PhpOffice\PhpSpreadsheet\Style\Style $style) : void
+{
+        // dxf
+        $objWriter->startElement('dxf');
+
+        // font
+        self::Style_writeFont($part, $objWriter, $style->getFont());
+
+        // numFmt
+        self::Style_writeNumFmt($part, $objWriter, $style->getNumberFormat());
+
+        // fill
+        self::Style_writeFill($part, $objWriter, $style->getFill());
+
+        // border
