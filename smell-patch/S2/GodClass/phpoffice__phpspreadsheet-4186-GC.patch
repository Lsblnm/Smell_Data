+        self::Worksheet_writeIgnoredError($part, $objWriter, $started, 'formula', $part->formula);
+        self::Worksheet_writeIgnoredError($part, $objWriter, $started, 'twoDigitTextYear', $part->twoDigitTextYear);
+        self::Worksheet_writeIgnoredError($part, $objWriter, $started, 'evalError', $part->evalError);
