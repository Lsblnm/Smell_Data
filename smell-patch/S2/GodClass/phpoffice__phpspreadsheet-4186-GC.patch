+    public static function Chart_writeValueAxis(Chart $part, XMLWriter $objWriter, ?Title $yAxisLabel, ?string $groupType, string $id1, string $id2, bool $isMultiLevelSeries, Axis $xAxis) : void
+{
+        $objWriter->startElement('c:' . Axis::AXIS_TYPE_VALUE);
