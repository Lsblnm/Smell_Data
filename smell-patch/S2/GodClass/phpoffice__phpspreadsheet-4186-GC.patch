-    private function writeCellBoolean(XMLWriter $objWriter, string $mappedType, bool $cellValue): void
-    {
-        $objWriter->writeAttribute('t', $mappedType);
-        $objWriter->writeElement('v', $cellValue ? '1' : '0');
