+            return;
+        }
+        // sheetProtection
+        $objWriter->startElement('sheetProtection');
+
+        if ($protection->getAlgorithm()) {
+            $objWriter->writeAttribute('algorithmName', $protection->getAlgorithm());
+            $objWriter->writeAttribute('hashValue', $protection->getPassword());
+            $objWriter->writeAttribute('saltValue', $protection->getSalt());
+            $objWriter->writeAttribute('spinCount', (string) $protection->getSpinCount());
+        } elseif ($protection->getPassword() !== '') {
+            $objWriter->writeAttribute('password', $protection->getPassword());
+        }
+
+        self::Worksheet_writeProtectionAttribute($objWriter, 'sheet', $protection->getSheet());
+        self::Worksheet_writeProtectionAttribute($objWriter, 'objects', $protection->getObjects());
+        self::Worksheet_writeProtectionAttribute($objWriter, 'scenarios', $protection->getScenarios());
+        self::Worksheet_writeProtectionAttribute($objWriter, 'formatCells', $protection->getFormatCells());
+        self::Worksheet_writeProtectionAttribute($objWriter, 'formatColumns', $protection->getFormatColumns());
+        self::Worksheet_writeProtectionAttribute($objWriter, 'formatRows', $protection->getFormatRows());
+        self::Worksheet_writeProtectionAttribute($objWriter, 'insertColumns', $protection->getInsertColumns());
+        self::Worksheet_writeProtectionAttribute($objWriter, 'insertRows', $protection->getInsertRows());
+        self::Worksheet_writeProtectionAttribute($objWriter, 'insertHyperlinks', $protection->getInsertHyperlinks());
+        self::Worksheet_writeProtectionAttribute($objWriter, 'deleteColumns', $protection->getDeleteColumns());
+        self::Worksheet_writeProtectionAttribute($objWriter, 'deleteRows', $protection->getDeleteRows());
+        self::Worksheet_writeProtectionAttribute($objWriter, 'sort', $protection->getSort());
+        self::Worksheet_writeProtectionAttribute($objWriter, 'autoFilter', $protection->getAutoFilter());
+        self::Worksheet_writeProtectionAttribute($objWriter, 'pivotTables', $protection->getPivotTables());
+        self::Worksheet_writeProtectionAttribute($objWriter, 'selectLockedCells', $protection->getSelectLockedCells());
+        self::Worksheet_writeProtectionAttribute($objWriter, 'selectUnlockedCells', $protection->getSelectUnlockedCells());
+        $objWriter->endElement();
+    }
