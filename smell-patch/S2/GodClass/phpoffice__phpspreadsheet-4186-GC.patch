+/**
+     * Write Fill.
+     */
+    public static function Style_writeFill(Style $part, XMLWriter $objWriter, Fill $fill) : void
+{
+        // Check if this is a pattern type or gradient type
+        if (
+            $fill->getFillType() === Fill::FILL_GRADIENT_LINEAR
+            || $fill->getFillType() === Fill::FILL_GRADIENT_PATH
+        ) {
+            // Gradient fill
+            self::Style_writeGradientFill($part, $objWriter, $fill);
+        } elseif ($fill->getFillType() !== null) {
+            // Pattern fill
+            self::Style_writePatternFill($part, $objWriter, $fill);
+        }
+    }
