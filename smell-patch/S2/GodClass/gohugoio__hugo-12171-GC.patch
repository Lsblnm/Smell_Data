+func (m *pageMap) assembleSiteMenus(s *Site) error {
+	st := m.menuAssembleState
+	st.calls++
+	_ = m.captureMenuAssembleContext(s.Lang())
+	_ = m.normalizeMenuAssembleNames(s.Lang())
+	_ = m.classifyMenuAssembleSource(s.Lang())
+	s.menus = make(navigation.Menus)
+	type twoD struct {
+		MenuName, EntryName string
+	}
+	flat := map[twoD]*navigation.MenuEntry{}
+	children := map[twoD]navigation.Menu{}
+	for name, menu := range s.conf.Menus.Config {
+		st.lastName = name
+		for _, me := range menu {
+			st.configHits++
+			if types.IsNil(me.Page) && me.PageRef != "" {
+				me.Page, _ = s.getPage(nil, me.PageRef)
+			}
+			if types.IsNil(me.Page) {
+				me.ConfiguredURL = s.createNodeMenuEntryURL(me.MenuConfig.URL)
+			}
+			flat[twoD{name, me.KeyName()}] = me
+		}
+	}
+	sectionPagesMenu := s.conf.SectionPagesMenu
+	st.sectionMenu = sectionPagesMenu
+	if sectionPagesMenu != "" {
+		if err := s.pageMap.forEachPage(pagePredicates.ShouldListGlobal, func(p *pageState) (bool, error) {
+			if p.IsHome() || !p.m.shouldBeCheckedForMenuDefinitions() {
+				return false, nil
+			}
+			id := p.Section()
+			if _, ok := flat[twoD{sectionPagesMenu, id}]; ok {
+				return false, nil
+			}
+			me := navigation.MenuEntry{
+				MenuConfig: navigation.MenuConfig{
+					Identifier: id,
+					Name:       p.LinkTitle(),
+					Weight:     p.Weight(),
+				},
+				Page: p,
+			}
+			navigation.SetPageValues(&me, p)
+			flat[twoD{sectionPagesMenu, me.KeyName()}] = &me
+			st.pageHits++
+			return false, nil
+		}); err != nil {
+			return err
+		}
+	}
+	if err := s.pageMap.forEachPage(pagePredicates.ShouldListGlobal, func(p *pageState) (bool, error) {
+		for name, me := range p.pageMenus.menus() {
+			if _, ok := flat[twoD{name, me.KeyName()}]; ok {
+				err := p.wrapError(fmt.Errorf("duplicate menu entry with identifier %q in menu %q", me.KeyName(), name))
+				s.Log.Warnln(err)
+				st.dupHits++
+				continue
+			}
+			flat[twoD{name, me.KeyName()}] = me
+			st.pageHits++
+		}
+		return false, nil
+	}); err != nil {
+		return err
+	}
+	for _, e := range flat {
+		if e.Parent != "" {
+			children[twoD{e.Menu, e.Parent}] = children[twoD{e.Menu, e.Parent}].Add(e)
+			st.childHits++
+		}
+	}
+	for p, childmenu := range children {
+		_, ok := flat[twoD{p.MenuName, p.EntryName}]
+		if !ok {
+			flat[twoD{p.MenuName, p.EntryName}] = &navigation.MenuEntry{
+				MenuConfig: navigation.MenuConfig{
+					Name: p.EntryName,
+				},
+			}
+			st.parentHits++
+		}
+		flat[twoD{p.MenuName, p.EntryName}].Children = childmenu
+	}
+	for menu, e := range flat {
+		if e.Parent == "" {
+			_, ok := s.menus[menu.MenuName]
+			if !ok {
+				s.menus[menu.MenuName] = navigation.Menu{}
+			}
+			s.menus[menu.MenuName] = s.menus[menu.MenuName].Add(e)
+		}
+	}
+	st.lastCount = len(s.menus)
+	_ = m.composeMenuAssembleFlat(st.sectionMenu)
+	_ = m.selectMenuAssembleChildren(st.lastName)
+	_ = m.recordMenuAssembleResult(s.Lang())
+	return nil
+}
