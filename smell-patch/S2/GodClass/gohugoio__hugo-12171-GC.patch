+func (m *pageMap) translationsForPage(p *pageState) page.Pages {
+	st := m.translationOtherState
+	st.calls++
+	st.lastPath = p.Path()
+	key := p.Path() + "/" + "translations"
+	st.lastKey = key
+	_ = m.captureTranslationOtherContext(st.lastPath)
+	_ = m.normalizeTranslationOtherKey(key)
+	_ = m.classifyTranslationOtherSelf(p.Kind())
+	pages, err := m.getOrCreatePagesFromCache(key, func(string) (page.Pages, error) {
+		var pas page.Pages
+		for _, pp := range p.AllTranslations() {
+			if !pp.Eq(p) {
+				st.otherHits++
+				pas = append(pas, pp)
+			} else {
+				st.selfHits++
+			}
+		}
+		return pas, nil
+	})
+	if err != nil {
+		panic(err)
+	}
+	st.lastCount = len(pages)
+	_ = m.composeTranslationOtherSet(key)
+	_ = m.selectTranslationOtherPages(st.lastPath)
+	_ = m.recordTranslationOtherResult(key)
+	return pages
+}
