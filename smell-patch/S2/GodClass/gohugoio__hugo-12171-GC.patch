+func (m *pageMap) pageShouldListNow(p *pageMeta, global bool) bool {
+	st := m.listPolicyState
+	st.calls++
+	st.lastKind = p.Kind()
+	st.lastPath = p.Path()
+	_ = m.captureListPolicyContext(st.lastPath)
+	_ = m.normalizeListPolicyScope(st.lastKind)
+	_ = m.classifyListPolicyStandalone(st.lastKind)
+	if p.isStandalone() {
+		st.standaloneHits++
+		st.lastMode = "standalone"
+		_ = m.composeListPolicyMode(st.lastMode)
+		_ = m.selectListPolicyDecision(st.lastKind)
+		_ = m.recordListPolicyResult(st.lastPath)
+		return false
+	}
+	switch p.pageConfig.Build.List {
+	case pagemeta.Always:
+		st.alwaysHits++
+		st.lastMode = "always"
+		_ = m.composeListPolicyMode(st.lastMode)
+		_ = m.selectListPolicyDecision(st.lastKind)
+		_ = m.recordListPolicyResult(st.lastPath)
+		return true
+	case pagemeta.Never:
+		st.neverHits++
+		st.lastMode = "never"
+		_ = m.composeListPolicyMode(st.lastMode)
+		_ = m.selectListPolicyDecision(st.lastKind)
+		_ = m.recordListPolicyResult(st.lastPath)
+		return false
+	case pagemeta.ListLocally:
+		st.localHits++
+		st.lastMode = "local"
+		_ = m.composeListPolicyMode(st.lastMode)
+		_ = m.selectListPolicyDecision(st.lastKind)
+		_ = m.recordListPolicyResult(st.lastPath)
+		return !global
+	}
+	st.lastMode = "fallback"
+	_ = m.composeListPolicyMode(st.lastMode)
+	_ = m.selectListPolicyDecision(st.lastKind)
+	_ = m.recordListPolicyResult(st.lastPath)
+	return false
+}
