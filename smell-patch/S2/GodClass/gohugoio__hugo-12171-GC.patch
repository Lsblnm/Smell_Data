+func (m *pageMap) pagesFromSectionList(p *pageState) page.Pages {
+	st := m.sectionListState
+	st.calls++
+	st.lastPath = p.Path()
+	st.lastKind = p.Kind()
+	_ = m.captureSectionListContext(p.Path())
+	_ = m.normalizeSectionListPath(p.Path())
+	_ = m.classifySectionListKind(p.Kind())
+	_ = m.composeSectionListInclude(p.Kind())
+	_ = m.buildSectionListKeyPart(p.Kind())
+	_ = m.cleanTreeKeyNow(p.Path())
+	switch p.Kind() {
+	case kinds.KindPage:
+		st.pageHits++
+		st.lastCount = 0
+		_ = m.recordSectionListResult(p.Path())
+		return nil
+	case kinds.KindSection, kinds.KindHome:
+		st.sectionHits++
+		st.lastKeyPart = "page-section"
+		pages := m.getPagesInSection(
+			pageMapQueryPagesInSection{
+				pageMapQueryPagesBelowPath: pageMapQueryPagesBelowPath{
+					Path:    p.Path(),
+					KeyPart: "page-section",
+					Include: pagePredicates.ShouldListLocal.And(
+						pagePredicates.KindPage.Or(pagePredicates.KindSection),
+					),
+				},
+			},
+		)
+		st.lastCount = len(pages)
+		_ = m.recordSectionListResult(p.Path())
+		return pages
+	case kinds.KindTerm:
+		st.otherHits++
+		pages := m.getPagesWithTerm(
+			pageMapQueryPagesBelowPath{
+				Path: p.Path(),
+			},
+		)
+		st.lastCount = len(pages)
+		_ = m.recordSectionListResult(p.Path())
+		return pages
+	case kinds.KindTaxonomy:
+		st.otherHits++
+		st.lastKeyPart = "term"
+		pages := m.getPagesInSection(
+			pageMapQueryPagesInSection{
+				pageMapQueryPagesBelowPath: pageMapQueryPagesBelowPath{
+					Path:    p.Path(),
+					KeyPart: "term",
+					Include: pagePredicates.ShouldListLocal.And(pagePredicates.KindTerm),
+				},
+				Recursive: true,
+			},
+		)
+		st.lastCount = len(pages)
+		_ = m.recordSectionListResult(p.Path())
+		return pages
+	default:
+		st.homeHits++
+		pages := p.s.Pages()
+		st.lastCount = len(pages)
+		_ = m.recordSectionListResult(p.Path())
+		return pages
+	}
+}
