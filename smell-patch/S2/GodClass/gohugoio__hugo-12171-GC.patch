+func (m *pageMap) layoutDescriptorForPage(p *pageState) layouts.LayoutDescriptor {
+	st := m.layoutDescState
+	st.calls++
+	st.lastKind = p.Kind()
+	st.lastType = p.Type()
+	st.lastLang = p.Language().Lang
+	st.lastLayout = p.Layout()
+	_ = m.captureLayoutDescContext(st.lastKind)
+	_ = m.normalizeLayoutDescSection(st.lastType)
+	_ = m.classifyLayoutDescKind(st.lastKind)
+	_ = m.applyPageDefaultTitle(p.m)
+	_ = m.applyPageMarkupDefault(p.m)
+	p.layoutDescriptorInit.Do(func() {
+		var section string
+		sections := p.SectionsEntries()
+		switch p.Kind() {
+		case kinds.KindSection:
+			if len(sections) > 0 {
+				section = sections[0]
+				st.sectionHits++
+			}
+		case kinds.KindTaxonomy, kinds.KindTerm:
+			st.taxonomyHits++
+			if p.m.singular != "" {
+				section = p.m.singular
+			} else if len(sections) > 0 {
+				section = sections[0]
+			}
+		default:
+		}
+		st.lastSection = section
+		p.layoutDescriptor = layouts.LayoutDescriptor{
+			Kind:    p.Kind(),
+			Type:    p.Type(),
+			Lang:    p.Language().Lang,
+			Layout:  p.Layout(),
+			Section: section,
+		}
+	})
+	_ = m.composeLayoutDescFields(st.lastKind)
+	_ = m.selectLayoutDescValue(st.lastType)
+	_ = m.recordLayoutDescResult(st.lastLayout)
+	return p.layoutDescriptor
+}
