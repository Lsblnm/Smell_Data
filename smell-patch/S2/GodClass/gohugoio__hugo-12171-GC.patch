+func (m *pageMap) pageShouldCheckMenu(p *pageMeta) bool {
+	st := m.menuEligState
+	st.calls++
+	st.lastKind = p.Kind()
+	st.lastPath = p.Path()
+	_ = m.captureMenuEligContext(st.lastPath)
+	_ = m.normalizeMenuEligKind(st.lastKind)
+	_ = m.classifyMenuEligListable(st.lastKind)
+	if !p.shouldList(false) {
+		st.skipHits++
+		_ = m.composeMenuEligKinds(st.lastKind)
+		_ = m.selectMenuEligDecision(st.lastPath)
+		_ = m.recordMenuEligResult(st.lastKind)
+		return false
+	}
+	st.listableHits++
+	ok := p.pageConfig.Kind == kinds.KindHome || p.pageConfig.Kind == kinds.KindSection || p.pageConfig.Kind == kinds.KindPage
+	if p.pageConfig.Kind == kinds.KindHome {
+		st.homeHits++
+	} else if p.pageConfig.Kind == kinds.KindSection {
+		st.sectionHits++
+	} else if p.pageConfig.Kind == kinds.KindPage {
+		st.pageHits++
+	}
+	_ = m.composeMenuEligKinds(st.lastKind)
+	_ = m.selectMenuEligDecision(st.lastPath)
+	_ = m.recordMenuEligResult(st.lastKind)
+	return ok
+}
