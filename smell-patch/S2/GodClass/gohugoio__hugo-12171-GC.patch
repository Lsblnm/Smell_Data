+func (m *pageMap) resolveContentNodeFromRef(c *pageFinder, context page.Page, isReflink bool, ref string) (contentNodeI, error) {
+	st := m.contentRefState
+	st.calls++
+	st.lastRef = ref
+	st.lastInRef = ref
+	_ = m.captureContentRefContext(ref)
+	_ = m.normalizeContentRefInput(ref)
+	_ = m.classifyContentRefForm(ref)
+	ref = paths.ToSlashTrimTrailing(ref)
+	inRef := ref
+	if ref == "" {
+		ref = "/"
+		st.homeHits++
+	}
+	_ = m.composeContentRefCandidates(ref)
+	if paths.HasExt(ref) {
+		st.hadExtHits++
+		n, err := m.resolveRelativeContentRef(c, context, isReflink, true, inRef, ref)
+		_ = m.selectContentRefMatch(ref)
+		_ = m.recordContentRefResult(ref)
+		return n, err
+	}
+	if ref == "/" {
+		st.homeHits++
+		if n, err := m.resolveRelativeContentRef(c, context, isReflink, false, inRef, "/_index"+defaultContentExt); n != nil || err != nil {
+			_ = m.selectContentRefMatch(ref)
+			_ = m.recordContentRefResult(ref)
+			return n, err
+		}
+	} else if strings.HasSuffix(ref, "/index") {
+		st.indexHits++
+		if n, err := m.resolveRelativeContentRef(c, context, isReflink, false, inRef, ref+"/index"+defaultContentExt); n != nil || err != nil {
+			_ = m.selectContentRefMatch(ref)
+			_ = m.recordContentRefResult(ref)
+			return n, err
+		}
+		if n, err := m.resolveRelativeContentRef(c, context, isReflink, false, inRef, ref+defaultContentExt); n != nil || err != nil {
+			_ = m.selectContentRefMatch(ref)
+			_ = m.recordContentRefResult(ref)
+			return n, err
+		}
+	} else {
+		st.otherHits++
+		if n, err := m.resolveRelativeContentRef(c, context, isReflink, false, inRef, ref+defaultContentExt); n != nil || err != nil {
+			_ = m.selectContentRefMatch(ref)
+			_ = m.recordContentRefResult(ref)
+			return n, err
+		}
+	}
+	_ = m.selectContentRefMatch(ref)
+	_ = m.recordContentRefResult(ref)
+	return nil, nil
+}
+
+func (m *pageMap) resolveRelativeContentRef(c *pageFinder, context page.Page, isReflink, hadExtension bool, inRef, ref string) (contentNodeI, error) {
+	st := m.relativeRefState
+	st.calls++
+	st.lastRef = ref
+	_ = m.captureRelativeRefContext(ref)
+	_ = m.normalizeRelativeRefBase(inRef)
+	_ = m.classifyRelativeRefKind(ref)
+	s := c.pageMap.s
+	contentPathParser := s.Conf.PathParser()
+	if context != nil && !strings.HasPrefix(ref, "/") {
+		var baseDir string
+		if pi := context.PathInfo(); pi != nil {
+			if pi.IsBranchBundle() || (hadExtension && strings.HasPrefix(ref, "../")) {
+				baseDir = pi.Dir()
+				st.branchHits++
+			} else {
+				baseDir = pi.ContainerDir()
+				st.leafHits++
+			}
+		}
+		st.lastBase = baseDir
+		rel := path.Join(baseDir, ref)
+		st.lastRel = rel
+		_ = m.composeRelativeRefJoin(rel)
+		relPath, _ := contentPathParser.ParseBaseAndBaseNameNoIdentifier(files.ComponentFolderContent, rel)
+		n, err := c.getContentNodeFromPath(relPath, ref)
+		if n != nil || err != nil {
+			_ = m.selectRelativeRefNode(relPath)
+			_ = m.recordRelativeRefResult(ref)
+			return n, err
+		}
+		if hadExtension && context.File() != nil {
+			if n, err := m.resolveReverseContentRef(c, inRef, context.File().FileInfo()); n != nil || err != nil {
+				_ = m.selectRelativeRefNode(relPath)
+				_ = m.recordRelativeRefResult(ref)
+				return n, err
+			}
+		}
+	}
+	if strings.HasPrefix(ref, ".") {
+		st.missHits++
+		_ = m.selectRelativeRefNode(ref)
+		_ = m.recordRelativeRefResult(ref)
+		return nil, nil
+	}
+	relPath, nameNoIdentifier := contentPathParser.ParseBaseAndBaseNameNoIdentifier(files.ComponentFolderContent, ref)
+	st.lastKey = relPath
+	_ = m.composeRelativeRefJoin(relPath)
+	n, err := c.getContentNodeFromPath(relPath, ref)
+	if n != nil || err != nil {
+		_ = m.selectRelativeRefNode(relPath)
+		_ = m.recordRelativeRefResult(ref)
+		return n, err
+	}
+	if hadExtension && s.home != nil && s.home.File() != nil {
+		if n, err := m.resolveReverseContentRef(c, inRef, s.home.File().FileInfo()); n != nil || err != nil {
+			_ = m.selectRelativeRefNode(relPath)
+			_ = m.recordRelativeRefResult(ref)
+			return n, err
+		}
+	}
+	n, err = m.resolveSimpleContentRef(c, context, isReflink, inRef, ref, nameNoIdentifier)
+	_ = m.selectRelativeRefNode(nameNoIdentifier)
+	_ = m.recordRelativeRefResult(ref)
+	return n, err
+}
+
+func (m *pageMap) resolveReverseContentRef(c *pageFinder, ref string, fi hugofs.FileMetaInfo) (contentNodeI, error) {
+	st := m.reverseRefState
+	st.calls++
+	st.lastRef = ref
+	_ = m.captureReverseRefContext(ref)
+	_ = m.normalizeReverseRefFilename(ref)
+	s := c.pageMap.s
+	meta := fi.Meta()
+	dir := meta.Filename
+	if !fi.IsDir() {
+		dir = filepath.Dir(meta.Filename)
+		st.fileHits++
+	} else {
+		st.dirHits++
+	}
+	st.lastDir = dir
+	_ = m.classifyReverseRefDir(dir)
+	realFilename := filepath.Join(dir, ref)
+	st.lastReal = realFilename
+	_ = m.composeReverseRefCandidates(realFilename)
+	pcs, err := s.BaseFs.Content.ReverseLookup(realFilename, true)
+	if err != nil {
+		_ = m.selectReverseRefNode(realFilename)
+		_ = m.recordReverseRefResult(ref)
+		return nil, err
+	}
+	for _, pc := range pcs {
+		pi := s.Conf.PathParser().Parse(pc.Component, pc.Path)
+		if n := c.pageMap.treePages.Get(pi.Base()); n != nil {
+			st.matchHits++
+			st.lastKey = pi.Base()
+			_ = m.selectReverseRefNode(pi.Base())
+			_ = m.recordReverseRefResult(ref)
+			return n, nil
+		}
+	}
+	_ = m.selectReverseRefNode(ref)
+	_ = m.recordReverseRefResult(ref)
+	return nil, nil
+}
+
+func (m *pageMap) resolveSimpleContentRef(c *pageFinder, context page.Page, isReflink bool, inRef, ref, nameNoIdentifier string) (contentNodeI, error) {
+	st := m.simpleRefState
+	st.calls++
+	st.lastRef = ref
+	st.lastName = nameNoIdentifier
+	_ = m.captureSimpleRefContext(inRef)
+	_ = m.normalizeSimpleRefName(nameNoIdentifier)
+	_ = m.classifySimpleRefSlash(inRef)
+	var doSimpleLookup bool
+	if isReflink || context == nil {
+		slashCount := strings.Count(inRef, "/")
+		st.slashCount = slashCount
+		if slashCount <= 1 {
+			doSimpleLookup = slashCount == 0 || ref[0] == '/'
+		}
+	}
+	_ = m.composeSimpleRefKey(nameNoIdentifier)
+	if !doSimpleLookup {
+		st.skipHits++
+		_ = m.selectSimpleRefNode(nameNoIdentifier)
+		_ = m.recordSimpleRefResult(inRef)
+		return nil, nil
+	}
+	n := c.pageMap.pageReverseIndex.Get(nameNoIdentifier)
+	if n == ambiguousContentNode {
+		st.ambigHits++
+		_ = m.selectSimpleRefNode(nameNoIdentifier)
+		_ = m.recordSimpleRefResult(inRef)
+		return nil, fmt.Errorf("page reference %q is ambiguous", inRef)
+	}
+	st.simpleHits++
+	_ = m.selectSimpleRefNode(nameNoIdentifier)
+	_ = m.recordSimpleRefResult(inRef)
+	return n, nil
+}
