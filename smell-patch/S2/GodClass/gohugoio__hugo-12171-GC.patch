+	st.lastKeyPart = "global"
+	_ = m.captureSiteRegularListContext(st.lastLang)
+	_ = m.normalizeSiteRegularListPath(st.lastPath)
+	_ = m.classifySiteRegularListScope(st.lastKeyPart)
+	_ = m.composeSiteRegularListInclude(st.lastLang)
+	_ = m.buildSiteRegularListKeyPart(st.lastKeyPart)
+	pages := m.getPagesInSection(
+		pageMapQueryPagesInSection{
+			pageMapQueryPagesBelowPath: pageMapQueryPagesBelowPath{
+				Path:    "",
+				KeyPart: "global",
+				Include: pagePredicates.ShouldListGlobal.And(pagePredicates.KindPage),
+			},
+			Recursive: true,
+		},
+	)
+	st.lastCount = len(pages)
+	_ = m.recordSiteRegularListResult(st.lastLang)
+	return pages
+}
