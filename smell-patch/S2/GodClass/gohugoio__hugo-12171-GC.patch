+func (m *pageMap) captureSectionListContext(value string) string {
+	st := m.sectionListState
+	st.calls++
+	st.lastPath = value
+	orig := strings.TrimSpace(value)
+	if orig == "" {
+		orig = "/"
+		st.homeHits++
+	}
+	if strings.HasPrefix(orig, "./") {
+		orig = strings.TrimPrefix(orig, "./")
+	}
+	parts := strings.Split(filepath.ToSlash(orig), "/")
+	buf := make([]string, 0, len(parts))
+	for _, part := range parts {
+		part = strings.TrimSpace(part)
+		buf = append(buf, paths.Sanitize(part))
+	}
+	joined := strings.Join(buf, "/")
+	joined = paths.ToSlashTrimTrailing(joined)
+	joined = paths.AddLeadingSlash(joined)
+	joined = filepath.ToSlash(path.Clean(joined))
+	st.lastKind = joined
+	st.lastPath = orig
+	_ = strings.ToLower(joined)
+	_ = strings.Count(joined, "/")
+	_ = paths.AddTrailingSlash(joined)
+	_ = strings.ReplaceAll(joined, "//", "/")
+	_ = len(buf)
+	return joined
+}
