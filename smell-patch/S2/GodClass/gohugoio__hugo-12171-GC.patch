+func (m *pageMap) menuEntryURLForSite(s *Site, in string) string {
+	st := m.menuURLState
+	st.calls++
+	st.lastIn = in
+	_ = m.captureMenuURLContext(in)
+	_ = m.normalizeMenuURLPath(in)
+	_ = m.classifyMenuURLForm(in)
+	if !strings.HasPrefix(in, "/") {
+		st.relHits++
+		st.lastOut = in
+		_ = m.composeMenuURLCanon(in)
+		_ = m.selectMenuURLValue(in)
+		_ = m.recordMenuURLResult(in)
+		return in
+	}
+	st.absHits++
+	menuEntryURL := in
+	menuEntryURL = s.s.PathSpec.URLize(menuEntryURL)
+	if !s.conf.CanonifyURLs {
+		menuEntryURL = paths.AddContextRoot(s.s.PathSpec.Cfg.BaseURL().String(), menuEntryURL)
+		st.canonHits++
+	}
+	st.lastOut = menuEntryURL
+	_ = m.composeMenuURLCanon(menuEntryURL)
+	_ = m.selectMenuURLValue(menuEntryURL)
+	_ = m.recordMenuURLResult(in)
+	return menuEntryURL
+}
