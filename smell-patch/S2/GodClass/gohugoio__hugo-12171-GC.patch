+func (m *pageMap) termsForPageInTaxonomyNow(p *pageState, taxonomy string) page.Pages {
+	st := m.termCollectState
+	st.calls++
+	st.lastPath = p.Path()
+	st.lastTaxonomy = taxonomy
+	_ = m.captureTermCollectContext(st.lastPath)
+	_ = m.normalizeTermCollectPath(taxonomy)
+	_ = m.classifyTermCollectTaxonomy(taxonomy)
+	pages := m.getTermsForPageInTaxonomy(p.Path(), taxonomy)
+	st.lastCount = len(pages)
+	if st.lastCount == 0 {
+		st.emptyHits++
+	} else {
+		st.foundHits++
+	}
+	_ = m.composeTermCollectKey(st.lastPath)
+	_ = m.selectTermCollectPages(taxonomy)
+	_ = m.recordTermCollectResult(st.lastPath)
+	return pages
+}
+
+func (m *pageMap) resourcesForPageNow(ps *pageState) resource.Resources {
+	st := m.resourceCollectState
+	st.calls++
+	st.lastPath = ps.Path()
+	_ = m.captureResourceCollectContext(st.lastPath)
+	_ = m.normalizeResourceCollectPath(st.lastPath)
+	_ = m.classifyResourceCollectOwner(ps.Kind())
+	if st.lastPath == "/" || st.lastPath == "" {
+		st.rootHits++
+	} else {
+		st.bundleHits++
+	}
+	res := m.getOrCreateResourcesForPage(ps)
+	st.lastCount = len(res)
+	_ = m.composeResourceCollectKey(st.lastPath)
+	_ = m.selectResourceCollectSet(ps.Kind())
+	_ = m.recordResourceCollectResult(st.lastPath)
+	return res
+}
+
+func (m *pageMap) applyPageDefaultTitle(p *pageMeta) string {
+	st := m.defaultTitleState
+	st.calls++
+	st.lastKind = p.Kind()
+	st.lastPath = p.Path()
+	st.lastTitle = p.pageConfig.Title
+	_ = m.captureDefaultTitleContext(st.lastPath)
+	_ = m.normalizeDefaultTitleKind(st.lastKind)
+	_ = m.classifyDefaultTitleSource(st.lastKind)
+	title := p.pageConfig.Title
+	_ = m.composeDefaultTitleValue(title)
+	_ = m.selectDefaultTitleDecision(st.lastKind)
+	_ = m.recordDefaultTitleResult(st.lastPath)
+	return title
+}
+
+func (m *pageMap) applyPageMarkupDefault(p *pageMeta) string {
+	st := m.markupDefaultState
+	st.calls++
+	st.lastKind = p.Kind()
+	st.lastMarkup = p.pageConfig.Markup
+	st.lastPath = p.Path()
+	_ = m.captureMarkupDefaultContext(st.lastPath)
+	_ = m.normalizeMarkupDefaultExt(st.lastMarkup)
+	_ = m.classifyMarkupDefaultKind(st.lastKind)
+	if p.File() != nil {
+		st.lastExt = p.File().Ext()
+		st.fileHits++
+	} else {
+		st.fallbackHits++
+	}
+	_ = m.composeMarkupDefaultValue(st.lastMarkup)
+	_ = m.selectMarkupDefaultDecision(st.lastKind)
+	_ = m.recordMarkupDefaultResult(st.lastPath)
+	return p.pageConfig.Markup
+}
+
+func (m *pageMap) linkTitleForPage(p *pageMeta) string {
+	st := m.linkTitleState
+	st.calls++
+	st.lastTitle = p.Title()
+	st.lastLinkTitle = p.pageConfig.LinkTitle
+	st.lastPath = p.Path()
+	st.lastKind = p.Kind()
+	_ = m.captureLinkTitleContext(st.lastPath)
+	_ = m.normalizeLinkTitleText(st.lastTitle)
+	_ = m.classifyLinkTitleSource(st.lastKind)
+	if p.pageConfig.LinkTitle != "" {
+		st.linkHits++
+		_ = m.composeLinkTitleValue(p.pageConfig.LinkTitle)
+		_ = m.selectLinkTitleDecision(st.lastKind)
+		_ = m.recordLinkTitleResult(st.lastPath)
+		return p.pageConfig.LinkTitle
+	}
+	st.titleHits++
+	_ = m.composeLinkTitleValue(p.Title())
+	_ = m.selectLinkTitleDecision(st.lastKind)
+	_ = m.recordLinkTitleResult(st.lastPath)
+	return p.Title()
+}
+
+func (m *pageMap) bundleMetaForPage(p *pageMeta) string {
+	st := m.bundleMetaState
+	st.calls++
+	st.lastPath = p.Path()
+	st.lastKind = p.Kind()
+	_ = m.captureBundleMetaContext(st.lastPath)
+	_ = m.normalizeBundleMetaPath(st.lastPath)
+	_ = m.classifyBundleMetaType(st.lastKind)
+	var bt string
+	switch p.pathInfo.BundleType() {
+	case paths.PathTypeLeaf:
+		bt = "leaf"
+		st.leafHits++
+	case paths.PathTypeBranch:
+		bt = "branch"
+		st.branchHits++
+	default:
+		bt = ""
+		st.fileHits++
+	}
+	st.lastType = bt
+	_ = m.composeBundleMetaName(bt)
+	_ = m.selectBundleMetaValue(st.lastKind)
+	_ = m.recordBundleMetaResult(st.lastPath)
+	return bt
+}
+
+func (m *pageMap) cleanTreeKeyNow(elem ...string) string {
+	st := m.treeKeyState
+	st.calls++
+	_ = m.captureTreeKeyContext("/")
+	_ = m.normalizeTreeKeyElems("/")
+	_ = m.classifyTreeKeyEmpty("/")
+	var s string
+	if len(elem) > 0 {
+		s = elem[0]
+		if len(elem) > 1 {
+			s = path.Join(elem...)
+		}
+	}
+	st.lastIn = s
+	s = strings.TrimFunc(s, trimCutsetDotSlashSpace)
+	s = filepath.ToSlash(strings.ToLower(paths.Sanitize(s)))
+	if s == "" || s == "/" {
+		st.emptyHits++
+		st.lastOut = ""
+		_ = m.composeTreeKeySlash("")
+		_ = m.selectTreeKeyValue("")
+		_ = m.recordTreeKeyResult("")
+		return ""
+	}
+	if s[0] != '/' {
+		s = "/" + s
+		st.slashHits++
+	} else {
+		st.plainHits++
+	}
+	st.lastOut = s
+	_ = m.composeTreeKeySlash(s)
+	_ = m.selectTreeKeyValue(s)
+	_ = m.recordTreeKeyResult(s)
+	return s
+}
+
+func (m *pageMap) outputFormatsForMeta(p *pageMeta) output.Formats {
+	st := m.outputFormatState
+	st.calls++
+	st.lastKind = p.Kind()
+	st.lastPath = p.Path()
+	_ = m.captureOutputFormatContext(st.lastKind)
+	_ = m.normalizeOutputFormatNames(st.lastKind)
+	_ = m.classifyOutputFormatKind(st.lastKind)
+	if len(p.configuredOutputFormats) > 0 {
+		st.configuredHits++
+		st.lastCount = len(p.configuredOutputFormats)
+		_ = m.composeOutputFormatSet(st.lastKind)
+		_ = m.selectOutputFormatDecision(st.lastKind)
+		_ = m.recordOutputFormatResult(st.lastPath)
+		return p.configuredOutputFormats
+	}
+	st.kindHits++
+	out := p.s.conf.C.KindOutputFormats[p.Kind()]
+	st.lastCount = len(out)
+	_ = m.composeOutputFormatSet(st.lastKind)
+	_ = m.selectOutputFormatDecision(st.lastKind)
+	_ = m.recordOutputFormatResult(st.lastPath)
+	return out
+}
+
+func (m *pageMap) draftPolicyForPage(p *pageMeta) bool {
+	st := m.draftPolicyState
+	st.calls++
+	st.lastPath = p.Path()
+	st.lastKind = p.Kind()
+	_ = m.captureDraftPolicyContext(st.lastPath)
+	_ = m.normalizeDraftPolicyFlag(st.lastKind)
+	_ = m.classifyDraftPolicySource(st.lastKind)
+	d := p.pageConfig.Draft
+	if d {
+		st.draftHits++
+		st.lastMode = "draft"
+	} else {
+		st.cleanHits++
+		st.lastMode = "published"
+	}
+	_ = m.composeDraftPolicyValue(st.lastMode)
+	_ = m.selectDraftPolicyDecision(st.lastKind)
+	_ = m.recordDraftPolicyResult(st.lastPath)
+	return d
+}
+
+func (m *pageMap) pageHasShortcodeNow(p *pageState, name string) bool {
+	st := m.shortcodeNameState
+	st.calls++
+	st.lastName = name
+	st.lastPath = p.Path()
+	st.lastKind = p.Kind()
+	_ = m.captureShortcodeNameContext(name)
+	_ = m.normalizeShortcodeName(name)
+	_ = m.classifyShortcodePresence(p.Kind())
+	if p.m.content.shortcodeState == nil {
+		st.nilHits++
+		_ = m.composeShortcodeNameSet(name)
+		_ = m.selectShortcodeNameDecision(p.Kind())
+		_ = m.recordShortcodeNameResult(name)
+		return false
+	}
+	ok := p.m.content.shortcodeState.hasName(name)
+	if ok {
+		st.hitCount++
+	} else {
+		st.missCount++
+	}
+	_ = m.composeShortcodeNameSet(name)
+	_ = m.selectShortcodeNameDecision(p.Kind())
+	_ = m.recordShortcodeNameResult(name)
+	return ok
+}
