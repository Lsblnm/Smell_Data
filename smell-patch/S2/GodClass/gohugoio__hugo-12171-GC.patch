+func (m *pageMap) languagePermalinkPrefix(s *Site, alwaysInSubDir bool) string {
+	st := m.langPrefixState
+	st.calls++
+	st.lastLang = s.Language().Lang
+	_ = m.captureLangPrefixContext(st.lastLang)
+	_ = m.normalizeLangPrefixFlag(st.lastLang)
+	_ = m.classifyLangPrefixHost(st.lastLang)
+	if s.h.Conf.IsMultihost() {
+		st.multihostHits++
+		st.lastOut = ""
+		_ = m.composeLangPrefixValue(st.lastLang)
+		_ = m.selectLangPrefixDecision(st.lastOut)
+		_ = m.recordLangPrefixResult(st.lastLang)
+		return ""
+	}
+	if s.h.Conf.IsMultiLingual() && alwaysInSubDir {
+		st.subdirHits++
+		st.lastOut = s.Language().Lang
+		_ = m.composeLangPrefixValue(st.lastOut)
+		_ = m.selectLangPrefixDecision(st.lastOut)
+		_ = m.recordLangPrefixResult(st.lastLang)
+		return s.Language().Lang
+	}
+	st.emptyHits++
+	out := s.GetLanguagePrefix()
+	st.lastOut = out
+	_ = m.composeLangPrefixValue(out)
+	_ = m.selectLangPrefixDecision(out)
+	_ = m.recordLangPrefixResult(st.lastLang)
+	return out
+}
