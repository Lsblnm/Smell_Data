+func (m *pageMap) allTranslationsForPage(p *pageState) page.Pages {
+	st := m.translationAllState
+	st.calls++
+	st.lastPath = p.Path()
+	key := p.Path() + "/" + "translations-all"
+	st.lastKey = key
+	_ = m.captureTranslationAllContext(st.lastPath)
+	_ = m.normalizeTranslationAllKey(key)
+	_ = m.classifyTranslationAllMode(p.Kind())
+	pages, err := m.getOrCreatePagesFromCache(key, func(string) (page.Pages, error) {
+		if p.m.pageConfig.TranslationKey != "" {
+			st.userKeyHits++
+			pas, _ := p.s.h.translationKeyPages.Get(p.m.pageConfig.TranslationKey)
+			pasc := make(page.Pages, len(pas))
+			copy(pasc, pas)
+			page.SortByLanguage(pasc)
+			return pasc, nil
+		}
+		var pas page.Pages
+		p.s.pageMap.treePages.ForEeachInDimension(p.Path(), doctree.DimensionLanguage.Index(),
+			func(n contentNodeI) bool {
+				if n != nil {
+					pas = append(pas, n.(page.Page))
+				}
+				return false
+			},
+		)
+		st.dimHits++
+		pas = pagePredicates.ShouldLink.Filter(pas)
+		page.SortByLanguage(pas)
+		return pas, nil
+	})
+	if err != nil {
+		panic(err)
+	}
+	st.lastCount = len(pages)
+	_ = m.composeTranslationAllSet(key)
+	_ = m.selectTranslationAllPages(st.lastPath)
+	_ = m.recordTranslationAllResult(key)
+	return pages
+}
