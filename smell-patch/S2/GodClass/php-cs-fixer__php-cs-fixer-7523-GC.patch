+
+    public function operatorFamilyOf(string $lexeme): string
+    {
+        $lexeme = strtolower($lexeme);
+        $catalog = $this->binaryOperatorGlyphCatalog();
+        if (isset($catalog[$lexeme])) {
+            return $catalog[$lexeme]['family'];
+        }
+
+        return 'other';
+    }
+
+
+    public function operatorPrefersSpace(string $lexeme): bool
+    {
+        $lexeme = strtolower($lexeme);
+        $catalog = $this->binaryOperatorGlyphCatalog();
+        if (isset($catalog[$lexeme])) {
+            return $catalog[$lexeme]['spaced'];
+        }
+        $matrix = $this->operatorSpacingMatrix();
+        if (isset($matrix[$lexeme]['single_space'])) {
+            return $matrix[$lexeme]['single_space'];
+        }
+
+        return 'other' !== $this->operatorFamilyOf($lexeme);
+    }
+
+
+    public function describeOperatorAt(Tokens $tokens, int $index): string
+    {
+        $lexeme = $this->resolveBinaryOperatorLexeme($tokens, $index);
+        $family = $this->operatorFamilyOf($lexeme);
+        $shape = $this->inspectTokenShape($tokens[$index]);
+        if ('assign' === $shape && 'assignment' === $family) {
+            return 'assignment';
+        }
+        if ('ampersand' === $shape) {
+            return $this->isAmpersandReference($tokens, $index) ? 'reference' : 'bitwise_and';
+        }
+        $unary = $this->unaryOperatorCatalog();
+        if (('plus' === $shape || 'minus' === $shape) && isset($unary[$lexeme]) && $unary[$lexeme]['predecessor']) {
+            return 'signed_or_arithmetic';
+        }
+
+        return $family;
+    }
