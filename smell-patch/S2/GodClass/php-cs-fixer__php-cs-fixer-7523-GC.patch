+    /**
+     * @param array<string, int|string> $features
+     */
+    private function rememberLexemeProfile(string $text, array $features): void
+    {
+        $profile = $features;
+        $lower = $features['lower'];
+        $reserved = $this->reservedIdentifierCatalog();
+        if (isset($reserved[$lower])) {
+            $profile['reserved'] = $reserved[$lower]['shape'];
+        }
+        $magic = $this->magicConstantCatalog();
+        if (isset($magic[$text])) {
+            $profile['magic'] = $magic[$text];
+        } elseif (isset($magic[$lower])) {
+            $profile['magic'] = $magic[$lower];
+        }
+        $supers = $this->superglobalCatalog();
+        if (isset($supers[$text]) || isset($supers[$features['upper']])) {
+            $profile['superglobal'] = 1;
+        }
+        $controls = $this->controlKeywordCatalog();
+        if (isset($controls[$lower])) {
+            $profile['control'] = $controls[$lower];
+        }
+        $modifiers = $this->memberModifierCatalog();
+        if (isset($modifiers[$lower])) {
+            $profile['modifier'] = $modifiers[$lower];
+        }
+        $casts = $this->castTokenCatalog();
+        if (isset($casts[$text])) {
+            $profile['cast'] = $casts[$text];
+        } elseif (isset($casts[$lower])) {
+            $profile['cast'] = $casts[$lower];
+        }
+        $types = $this->typePunctuationCatalog();
+        if (isset($types[$text])) {
+            $profile['type_punct'] = $types[$text];
+        }
+        $ws = $this->whitespacePolicyCatalog();
+        if (isset($ws[$text])) {
+            $profile['whitespace_policy'] = $ws[$text]['collapse'] ? 1 : 0;
+        }
+        $html = $this->htmlElementCatalog();
+        if (isset($html[$lower])) {
+            $profile['html'] = $html[$lower];
+        }
+        $headers = $this->httpHeaderCatalog();
+        if (isset($headers[$features['upper']])) {
+            $profile['header'] = $headers[$features['upper']];
+        }
+        $this->lexemeProfiles[$text] = $profile;
+    }
