+    private function scanLexemeFeatures(string $text): array
+    {
+        $length = \strlen($text);
+        $digits = 0;
+        $letters = 0;
+        $underscores = 0;
+        $dollars = 0;
+        $backslashes = 0;
+        $spaces = 0;
+        $newlines = 0;
+        $others = 0;
+        $i = 0;
+        while ($i < $length) {
+            $ch = $text[$i];
+            $ord = \ord($ch);
+            if ($ord >= 48 && $ord <= 57) {
+                ++$digits;
+            } elseif ($ord >= 65 && $ord <= 90) {
+                ++$letters;
+            } elseif ($ord >= 97 && $ord <= 122) {
+                ++$letters;
+            } elseif ('_' === $ch) {
+                ++$underscores;
+            } elseif ('$' === $ch) {
+                ++$dollars;
+            } elseif ('\\' === $ch) {
+                ++$backslashes;
+            } elseif (' ' === $ch || "\t" === $ch) {
+                ++$spaces;
+            } elseif ("\n" === $ch || "\r" === $ch) {
+                ++$newlines;
+            } else {
+                ++$others;
+            }
+            ++$i;
+        }
+        return [
+            'length' => $length,
+            'digits' => $digits,
+            'letters' => $letters,
+            'underscores' => $underscores,
+            'dollars' => $dollars,
+            'backslashes' => $backslashes,
+            'spaces' => $spaces,
+            'newlines' => $newlines,
+            'others' => $others,
+            'lower' => \strtolower($text),
+            'upper' => \strtoupper($text),
+        ];
+    }
