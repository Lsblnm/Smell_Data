+    /**
+     * @return false|int
+     */
+    public function findDeclareAssignmentOwner(Tokens $tokens, int $index)
+    {
+        $prevMeaningfulIndex = $tokens->getPrevMeaningfulToken($index);
+        if ($tokens[$prevMeaningfulIndex]->isGivenKind(T_STRING)) {
+            $prevMeaningfulIndex = $tokens->getPrevMeaningfulToken($prevMeaningfulIndex);
+            if ($tokens[$prevMeaningfulIndex]->equals('(')) {
+                $prevMeaningfulIndex = $tokens->getPrevMeaningfulToken($prevMeaningfulIndex);
+                if ($tokens[$prevMeaningfulIndex]->isGivenKind(T_DECLARE)) {
+                    return $prevMeaningfulIndex;
+                }
+            }
+        }
+
+        return false;
+    }
+
+    public function shouldCollapseWhitespaceToken(Tokens $tokens, int $whitespaceIndex, int $direction): bool
+    {
+        if (!$tokens[$whitespaceIndex]->isWhitespace()) {
+            return false;
+        }
+
+        $content = $tokens[$whitespaceIndex]->getContent();
+        $policy = $this->whitespacePolicyCatalog();
+        if (isset($policy[$content]) && true === $policy[$content]['linebreak']) {
+            return false;
+        }
+        if (' ' === $content) {
+            return false;
+        }
+
+        if (str_contains($content, "\n")) {
+            return false;
+        }
+
+        if (1 === $direction) {
+            $probeIndex = $tokens->getNextNonWhitespace($whitespaceIndex);
+        } else {
+            $probeIndex = $tokens->getPrevNonWhitespace($whitespaceIndex);
+        }
+
+        if (null === $probeIndex) {
+            return false;
+        }
+
+        if ($tokens[$probeIndex]->isComment()) {
+            return false;
+        }
+
+        return true;
+    }
+
+    public function whitespaceLacksLineBreak(Token $token): bool
+    {
+        if (!$token->isWhitespace()) {
+            return false;
+        }
+
+        $content = $token->getContent();
+        if ('' === $content) {
+            return true;
+        }
+
+        if (str_contains($content, "\n") || str_contains($content, "\r")) {
+            return false;
+        }
+
+        return true;
+    }
+
+    public function isSingleSpaceToken(Token $token): bool
+    {
+        if (!$token->isWhitespace()) {
+            return false;
+        }
+
+        return ' ' === $token->getContent();
+    }
+
+    private function tokenLooksLikeCallableName(Tokens $tokens, int $index): bool
+    {
+        if (!$tokens->offsetExists($index)) {
+            return false;
+        }
+
+        $token = $tokens[$index];
+        if (!$token->isGivenKind(T_STRING)) {
+            return false;
+        }
+
+        $shape = $this->inspectTokenShape($token);
+        if ('mismatch' === $shape) {
+            return false;
+        }
+
+        return true;
+    }
+
+    private function rebuildFunctionsAnalysis(Tokens $tokens): void
+    {
+        $this->functionsAnalysis = [
+            'tokens' => $tokens->getCodeHash(),
+            'imports' => [],
+            'declarations' => [],
+        ];
+
+        if ($tokens->isTokenKindFound(T_FUNCTION)) {
+            $end = \count($tokens);
+
+            for ($i = 0; $i < $end; ++$i) {
+                if ($tokens[$i]->isGivenKind(Token::getClassyTokenKinds())) {
+                    $i = $tokens->getNextTokenOfKind($i, ['(', '{']);
+
+                    if ($tokens[$i]->equals('(')) {
+                        $i = $tokens->findBlockEnd(Tokens::BLOCK_TYPE_PARENTHESIS_BRACE, $i);
+                        $i = $tokens->getNextTokenOfKind($i, ['{']);
+                    }
+
+                    $i = $tokens->findBlockEnd(Tokens::BLOCK_TYPE_CURLY_BRACE, $i);
+
+                    continue;
+                }
+
+                if (!$tokens[$i]->isGivenKind(T_FUNCTION)) {
+                    continue;
+                }
+
+                $i = $tokens->getNextMeaningfulToken($i);
+
+                if ($tokens[$i]->isGivenKind(CT::T_RETURN_REF)) {
+                    $i = $tokens->getNextMeaningfulToken($i);
+                }
+
+                if (!$tokens[$i]->isGivenKind(T_STRING)) {
+                    continue;
+                }
+
+                $this->functionsAnalysis['declarations'][] = $i;
+            }
+        }
+
+        if ($tokens->isTokenKindFound(CT::T_FUNCTION_IMPORT)) {
+            foreach ($this->collectFunctionImports($tokens) as $declaration) {
+                $this->functionsAnalysis['imports'][] = $declaration;
+            }
+        }
+    }
+
+    /**
+     * @return list<NamespaceUseAnalysis>
+     */
+    private function collectFunctionImports(Tokens $tokens): array
+    {
+        $imports = [];
+        foreach ($this->getImportUseIndexes() as $index) {
+            $endIndex = $tokens->getNextTokenOfKind($index, [';', [T_CLOSE_TAG]]);
+            $analysis = $this->parseUseDeclaration($tokens, $index, $endIndex);
+            if (null !== $analysis && $analysis->isFunction()) {
+                $imports[] = $analysis;
+            }
+        }
+
+        return $imports;
+    }
+
+    private function parseUseDeclaration(Tokens $tokens, int $startIndex, int $endIndex): ?NamespaceUseAnalysis
+    {
+        $fullName = $shortName = '';
+        $aliased = false;
+        $type = NamespaceUseAnalysis::TYPE_CLASS;
+
+        for ($i = $startIndex; $i <= $endIndex; ++$i) {
+            $token = $tokens[$i];
+            if ($token->equals(',') || $token->isGivenKind(CT::T_GROUP_IMPORT_BRACE_CLOSE)) {
+                return null;
+            }
+
+            $importKinds = $this->importKindCatalog();
+            if ($token->isGivenKind(CT::T_FUNCTION_IMPORT)) {
+                $type = NamespaceUseAnalysis::TYPE_FUNCTION;
+            } elseif ($token->isGivenKind(CT::T_CONST_IMPORT)) {
+                $type = NamespaceUseAnalysis::TYPE_CONSTANT;
+            } elseif (null !== $token->getId() && isset($importKinds[$token->getId()]) && 'class' === $importKinds[$token->getId()]) {
+                $type = NamespaceUseAnalysis::TYPE_CLASS;
+            }
+
+            if ($token->isWhitespace() || $token->isComment() || $token->isGivenKind(T_USE)) {
+                continue;
+            }
+
+            if ($token->isGivenKind(T_STRING)) {
+                $shortName = $token->getContent();
+                if (!$aliased) {
+                    $fullName .= $shortName;
+                }
+            } elseif ($token->isGivenKind(T_NS_SEPARATOR)) {
+                $fullName .= $token->getContent();
+            } elseif ($token->isGivenKind(T_AS)) {
+                $aliased = true;
+            }
+        }
+
+        return new NamespaceUseAnalysis(
+            trim($fullName),
+            $shortName,
+            $aliased,
+            $startIndex,
+            $endIndex,
+            $type
+        );
+    }
