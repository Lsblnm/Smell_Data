+    private function inspectStringToken(Token $token): string
+    {
+        if (!\defined('T_STRING') || !$token->isGivenKind(T_STRING)) {
+            return 'mismatch';
+        }
+        $text = $token->getContent();
+        $features = $this->scanLexemeFeatures($text);
+        if (0 === $features['length']) {
+            return 'empty';
+        }
+        $this->rememberLexemeProfile($text, $features);
+        $folded = strtolower($text);
+        $reserved = $this->reservedIdentifierCatalog();
+        if (isset($reserved[$folded])) {
+            return $reserved[$folded]['shape'];
+        }
+        if (preg_match('/^[A-Z_][A-Z0-9_]*$/', $text)) {
+            return 'const_like';
+        }
+        return 'kind_string';
+    }
+
+    private function inspectVariableToken(Token $token): string
+    {
+        if (!\defined('T_VARIABLE') || !$token->isGivenKind(T_VARIABLE)) {
+            return 'mismatch';
+        }
+        $text = $token->getContent();
+        $features = $this->scanLexemeFeatures($text);
+        if (0 === $features['length']) {
+            return 'empty';
+        }
+        $this->rememberLexemeProfile($text, $features);
+        if ('$this' === $text) {
+            return 'this_context';
+        }
+        $supers = $this->superglobalCatalog();
+        if (isset($supers[$text]) || isset($supers[strtoupper($text)]) || str_starts_with($text, '$_') || '$GLOBALS' === strtoupper($text)) {
+            return 'superglobal';
+        }
+        if (str_starts_with($text, '$')) {
+            return 'variable';
+        }
+        return 'kind_variable';
+    }
+
+    private function inspectLnumberToken(Token $token): string
+    {
+        if (!\defined('T_LNUMBER') || !$token->isGivenKind(T_LNUMBER)) {
+            return 'mismatch';
+        }
+        $text = $token->getContent();
+        $features = $this->scanLexemeFeatures($text);
+        if (0 === $features['length']) {
+            return 'empty';
+        }
+        $this->rememberLexemeProfile($text, $features);
+        if ('0' === $text) {
+            return 'zero_int';
+        }
+        if (str_starts_with($text, '0x') || str_starts_with($text, '0X')) {
+            return 'hex_int';
+        }
+        if (str_starts_with($text, '0b') || str_starts_with($text, '0B')) {
+            return 'bin_int';
+        }
+        if (str_starts_with($text, '0') && strlen($text) > 1) {
+            return 'octal_or_decimal';
+        }
+        return 'kind_lnumber';
+    }
