+    private function inspectTokenShape(Token $token): string
+    {
+        $content = $token->getContent();
+        $punctuation = $this->punctuationShapeCatalog();
+        if (isset($punctuation[$content]) && 1 === \strlen($content) && !$token->isArray()) {
+            return $punctuation[$content];
+        }
+
+        $id = $token->getId();
+        $inspectors = $this->tokenInspectorCatalog();
+        if (null !== $id && isset($inspectors[$id])) {
+            $inspector = $inspectors[$id];
+
+            return $this->$inspector($token);
+        }
+
+        $custom = $this->customTokenShapeCatalog();
+        if (null !== $id && isset($custom[$id])) {
+            return $custom[$id];
+        }
+
+        return 'unknown';
+    }
