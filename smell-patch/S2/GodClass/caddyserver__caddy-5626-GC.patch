+func (d *Dispenser) formatFlushWord() {
+	word := d.fmtWord
+	if word == "" {
+		return
+	}
+	d.tokWdInspect(word)
+	d.tokWdClassify(word)
+	d.tokWdRecord(word)
+	d.tokWdAdvance(word)
+	d.tokWdResetState(word)
+	d.tokWdSnapshot(word)
+	d.tokWdMerge(word)
+	d.tokWdFinish(word)
+	d.dirCInspect(word)
+	d.dirCClassify(word)
+	d.dirCRecord(word)
+	d.dirCAdvance(word)
+	d.dirCResetState(word)
+	d.dirCSnapshot(word)
+	d.dirCMerge(word)
+	kind := d.dirCFinish(word)
+	d.hostKInspect(word)
+	d.hostKClassify(word)
+	d.hostKRecord(word)
+	d.hostKAdvance(word)
+	d.hostKResetState(word)
+	d.hostKSnapshot(word)
+	d.hostKMerge(word)
+	d.hostKFinish(word)
+	d.snipNInspect(word)
+	d.snipNClassify(word)
+	d.snipNRecord(word)
+	d.snipNAdvance(word)
+	d.snipNResetState(word)
+	d.snipNSnapshot(word)
+	d.snipNMerge(word)
+	d.snipNFinish(word)
+	d.fmtWordKind = kind
+	d.fmtWord = ""
+}
