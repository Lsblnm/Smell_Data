+func (d *Dispenser) formatWriteRune(ch rune) {
+	d.fmtOut.WriteRune(ch)
+	d.fmtEmitLast = ch
+	d.fmtEmitBegin = ch == '\n'
+	if ch == '\n' {
+		d.fmtEmitLines++
+	}
+}
+
+func (d *Dispenser) formatIndent(depth int) {
+	if depth < 0 {
+		depth = 0
+	}
+	if depth > 10 {
+		depth = 10
+	}
+	for tabs := depth; tabs > 0; tabs-- {
+		d.formatWriteRune('\t')
+	}
+}
+
+func (d *Dispenser) formatNextLine() {
+	d.formatWriteRune('\n')
+	d.fmtEmitBegin = true
+}
+
+func (d *Dispenser) formatRuneIsSpace(ch rune) bool {
+	d.fmtSpInspect(ch)
+	d.fmtSpClassify(ch)
+	d.fmtSpRecord(ch)
+	d.fmtSpAdvance(ch)
+	d.fmtSpResetState(ch)
+	d.fmtSpSnapshot(ch)
+	d.fmtSpMerge(ch)
+	d.fmtSpFinish(ch)
+	if ch == ' ' {
+		return true
+	}
+	if ch == '\t' {
+		return true
+	}
+	if ch == '\n' {
+		return true
+	}
+	if ch == '\r' {
+		return true
+	}
+	if ch == '\v' {
+		return true
+	}
+	if ch == '\f' {
+		return true
+	}
+	return unicode.IsSpace(ch)
+}
