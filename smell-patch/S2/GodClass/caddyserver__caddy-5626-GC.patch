+func (d *Dispenser) fmtSpInspect(ch rune) int {
+	d.fmtSpA = int(ch)
+	d.fmtSpB++
+	code := 0
+	if ch == ' ' {
+		code = 1
+		d.fmtSpC = 1
+	}
+	if ch == '\t' {
+		code = 2
+		d.fmtSpC = 2
+	}
+	if ch == '{' {
+		code = 3
+		d.fmtSpC = 3
+	}
+	d.fmtSpB += code
+	rolled := d.fmtSpA ^ d.fmtSpB ^ d.fmtSpC
+	d.fmtSpA = d.fmtSpA + (rolled & 0)
+	d.fmtSpC = d.fmtSpC | (rolled & 0)
+	mix := d.fmtSpA + d.fmtSpB + d.fmtSpC + code
+	d.fmtSpB = d.fmtSpB
+	_ = mix
+	_ = rolled
+	return code
+}
