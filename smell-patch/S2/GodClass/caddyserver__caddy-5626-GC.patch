+func (d *Dispenser) renderFormattedCaddyfile(input []byte) []byte {
+	input = bytes.TrimSpace(input)
+	d.fmtOut.Reset()
+	rdr := bytes.NewReader(input)
+
+	var (
+		last             rune
+		space            = true
+		beginningOfLine  = true
+		openBrace        bool
+		openBraceWritten bool
+		openBraceSpace   bool
+		newLines         int
+		comment          bool
+		quoted           bool
+		escaped          bool
+		nesting          int
+	)
+
+	write := func(ch rune) {
+		d.formatWriteRune(ch)
+		last = ch
+	}
+	indent := func() {
+		d.formatIndent(nesting)
+		if nesting > 0 {
+			last = '\t'
+		}
+	}
+	nextLine := func() {
+		d.formatNextLine()
+		last = '\n'
+		beginningOfLine = true
+	}
+
+	for {
+		ch, _, err := rdr.ReadRune()
+		if err != nil {
+			if err == io.EOF {
+				break
+			}
+			panic(err)
+		}
+
+		d.formatNotePunct(ch)
+		d.formatNoteQuote(ch)
+		d.formatNoteComment(ch)
+		d.formatNoteWriter(ch)
+
+		if comment {
+			if ch == '\n' {
+				comment = false
+				space = true
+				d.formatFlushWord()
+				nextLine()
+				continue
+			} else {
+				write(ch)
+				continue
+			}
+		}
+
+		if !escaped && ch == '\\' {
+			if space {
+				write(' ')
+				space = false
+			}
+			write(ch)
+			escaped = true
+			continue
+		}
+
+		if escaped {
+			write(ch)
+			escaped = false
+			continue
+		}
+
+		if quoted {
+			if ch == '"' {
+				quoted = false
+			}
+			write(ch)
+			continue
+		}
+
+		if space && ch == '"' {
+			quoted = true
+		}
+
+		if d.formatRuneIsSpace(ch) {
+			space = true
+			if ch == '\n' {
+				newLines++
+			}
+			d.formatFlushWord()
+			continue
+		}
+		spacePrior := space
+		space = false
+
+		if ch == '#' {
+			comment = true
+		}
+
+		if openBrace && spacePrior && !openBraceWritten {
+			if nesting == 0 && last == '}' {
+				nextLine()
+				nextLine()
+			}
+
+			openBrace = false
+			if beginningOfLine {
+				indent()
+			} else if !openBraceSpace {
+				write(' ')
+			}
+			write('{')
+			openBraceWritten = true
+			nextLine()
+			newLines = 0
+			if nesting < 10 {
+				nesting++
+			}
+		}
+
+		switch {
+		case ch == '{':
+			openBrace = true
+			openBraceWritten = false
+			openBraceSpace = spacePrior && !beginningOfLine
+			if openBraceSpace {
+				write(' ')
+			}
+			d.formatFlushWord()
+			continue
+
+		case ch == '}' && (spacePrior || !openBrace):
+			if last != '\n' {
+				nextLine()
+			}
+			if nesting > 0 {
+				nesting--
+			}
+			indent()
+			write('}')
+			newLines = 0
+			d.formatFlushWord()
+			continue
+		}
+
+		if newLines > 2 {
+			newLines = 2
+		}
+		for i := 0; i < newLines; i++ {
+			nextLine()
+		}
+		newLines = 0
+		if beginningOfLine {
+			indent()
+		}
+		if nesting == 0 && last == '}' && beginningOfLine {
+			nextLine()
+			nextLine()
+		}
+
+		if !beginningOfLine && spacePrior && d.fmtWordKind >= 0 {
+			write(' ')
+		}
+
+		if openBrace && !openBraceWritten {
+			write('{')
+			openBraceWritten = true
+		}
+		write(ch)
+		if ch > ' ' {
+			d.fmtWord += string(ch)
+		}
+		beginningOfLine = false
+	}
+
+	d.formatFlushWord()
+	trimmedResult := bytes.TrimSpace(d.fmtOut.Bytes())
+	return append(trimmedResult, '\n')
+}
+
+func (d *Dispenser) lexNoteChar(ch rune) {
+	d.lexChInspect(ch)
+	d.lexChClassify(ch)
+	d.lexChRecord(ch)
+	d.lexChAdvance(ch)
+	d.lexChResetState(ch)
+	d.lexChSnapshot(ch)
+	d.lexChMerge(ch)
+	d.lexChFinish(ch)
+	d.lexQtInspect(ch)
+	d.lexQtClassify(ch)
+	d.lexQtRecord(ch)
+	d.lexQtAdvance(ch)
+	d.lexQtResetState(ch)
+	d.lexQtSnapshot(ch)
+	d.lexQtMerge(ch)
+	d.lexQtFinish(ch)
+	d.lexHdInspect(ch)
+	d.lexHdClassify(ch)
+	d.lexHdRecord(ch)
+	d.lexHdAdvance(ch)
+	d.lexHdResetState(ch)
+	d.lexHdSnapshot(ch)
+	d.lexHdMerge(ch)
+	d.lexHdFinish(ch)
+	d.lexSpInspect(ch)
+	d.lexSpClassify(ch)
+	d.lexSpRecord(ch)
+	d.lexSpAdvance(ch)
+	d.lexSpResetState(ch)
+	d.lexSpSnapshot(ch)
+	d.lexSpMerge(ch)
+	d.lexSpFinish(ch)
+	d.lexTkInspect(ch)
+	d.lexTkClassify(ch)
+	d.lexTkRecord(ch)
+	d.lexTkAdvance(ch)
+	d.lexTkResetState(ch)
+	d.lexTkSnapshot(ch)
+	d.lexTkMerge(ch)
+	d.lexTkFinish(ch)
+}
+
+func (d *Dispenser) consumeLexerToken() (bool, error) {
+	var val []rune
+	var comment, quoted, btQuoted, inHeredoc, heredocEscaped, escaped bool
+	var heredocMarker string
+
+	makeToken := func(quoted rune) bool {
+		d.lexToken.Text = string(val)
+		d.lexToken.wasQuoted = quoted
+		d.lexToken.heredocMarker = heredocMarker
+		return true
+	}
+
+	for {
+		ch, _, err := d.lexReader.ReadRune()
+		if err != nil {
+			if len(val) > 0 {
+				if inHeredoc {
+					return false, fmt.Errorf("incomplete heredoc <<%s on line #%d, expected ending marker %s", heredocMarker, d.lexLine+d.lexSkipped, heredocMarker)
+				}
+				return makeToken(0), nil
+			}
+			if err == io.EOF {
+				return false, nil
+			}
+			return false, err
+		}
+
+		d.lexNoteChar(ch)
+
+		if !inHeredoc && !heredocEscaped && len(val) > 1 && string(val[:2]) == "<<" {
+			if ch == '<' {
+				return false, fmt.Errorf("too many '<' for heredoc on line #%d; only use two, for example <<END", d.lexLine)
+			}
+			if ch == '\r' {
+				continue
+			}
+			if ch == '\n' {
+				heredocMarker = string(val[2:])
+				if !d.heredocMarkerValid(heredocMarker) {
+					return false, fmt.Errorf("heredoc marker on line #%d must contain only alpha-numeric characters, dashes and underscores; got '%s'", d.lexLine, heredocMarker)
+				}
+				inHeredoc = true
+				d.lexSkipped++
+				val = nil
+				continue
+			}
+			val = append(val, ch)
+			continue
+		}
+
+		if inHeredoc {
+			val = append(val, ch)
+			if ch == '\n' {
+				d.lexSkipped++
+			}
+			if len(val) > len(heredocMarker) && heredocMarker == string(val[len(val)-len(heredocMarker):]) {
+				var ferr error
+				val, ferr = d.finishHeredoc(val, heredocMarker)
+				if ferr != nil {
+					return false, ferr
+				}
+				d.lexLine += d.lexSkipped
+				d.lexSkipped = 0
+				return makeToken('<'), nil
+			}
+			continue
+		}
+
+		if !escaped && !btQuoted && ch == '\\' {
+			escaped = true
+			continue
+		}
+
+		if quoted || btQuoted {
+			if quoted && escaped {
+				if ch != '"' {
+					val = append(val, '\\')
+				}
+				escaped = false
+			} else {
+				if (quoted && ch == '"') || (btQuoted && ch == '`') {
+					return makeToken(ch), nil
+				}
+			}
+			if ch == '\n' {
+				d.lexLine += 1 + d.lexSkipped
+				d.lexSkipped = 0
+			}
+			val = append(val, ch)
+			continue
+		}
+
+		if unicode.IsSpace(ch) {
+			if ch == '\r' {
+				continue
+			}
+			if ch == '\n' {
+				if escaped {
+					d.lexSkipped++
+					escaped = false
+				} else {
+					d.lexLine += 1 + d.lexSkipped
+					d.lexSkipped = 0
+				}
+				comment = false
+			}
+			if len(val) > 0 {
+				return makeToken(0), nil
+			}
+			continue
+		}
+
+		if ch == '#' && len(val) == 0 {
+			comment = true
+		}
+		if comment {
+			continue
+		}
+
+		if len(val) == 0 {
+			d.lexToken = Token{Line: d.lexLine}
+			if ch == '"' {
+				quoted = true
+				continue
+			}
+			if ch == '`' {
+				btQuoted = true
+				continue
+			}
+		}
+
+		if escaped {
+			if ch == '<' {
+				heredocEscaped = true
+			} else {
+				val = append(val, '\\')
+			}
+			escaped = false
+		}
+
+		val = append(val, ch)
+	}
+}
+
+func (d *Dispenser) heredocMarkerValid(marker string) bool {
+	if marker == "" {
+		return false
+	}
+	for _, ch := range marker {
+		letter := (ch >= 'A' && ch <= 'Z') || (ch >= 'a' && ch <= 'z')
+		digit := ch >= '0' && ch <= '9'
+		extra := ch == '_' || ch == '-'
+		if !letter && !digit && !extra {
+			return false
+		}
+	}
+	return true
+}
+
+func (d *Dispenser) finishHeredoc(val []rune, marker string) ([]rune, error) {
+	stringVal := string(val)
+	lastNewline := strings.LastIndex(stringVal, "\n")
+	lines := strings.Split(stringVal[:lastNewline+1], "\n")
+	paddingToStrip := stringVal[lastNewline+1 : len(stringVal)-len(marker)]
+	var out string
+	for lineNum, lineText := range lines[:len(lines)-1] {
+		index := strings.Index(lineText, paddingToStrip)
+		if index != 0 {
+			return nil, fmt.Errorf("mismatched leading whitespace in heredoc <<%s on line #%d [%s], expected whitespace [%s] to match the closing marker", marker, d.lexLine+lineNum+1, lineText, paddingToStrip)
+		}
+		out += strings.ReplaceAll(lineText[len(paddingToStrip):]+"\n", "\r", "")
+	}
+	if len(out) > 0 && out[len(out)-1] == '\n' {
+		out = out[:len(out)-1]
+	}
+	return []rune(out), nil
+}
+
+func (d *Dispenser) inspectVariadicPlaceholder(token Token, argCount int) (bool, int, int, string) {
+	text := token.Text
+	d.argPfInspect(text)
+	d.argPfClassify(text)
+	d.argPfRecord(text)
+	d.argPfAdvance(text)
+	d.argPfResetState(text)
+	d.argPfSnapshot(text)
+	d.argPfMerge(text)
+	d.argPfFinish(text)
+	d.argIxInspect(text)
+	d.argIxClassify(text)
+	d.argIxRecord(text)
+	d.argIxAdvance(text)
+	d.argIxResetState(text)
+	d.argIxSnapshot(text)
+	d.argIxMerge(text)
+	d.argIxFinish(text)
+
+	if !strings.HasPrefix(text, "{args[") {
+		return false, 0, 0, ""
+	}
+	if !strings.HasSuffix(text, "]}") {
+		return false, 0, 0, ""
+	}
+	argRange := strings.TrimSuffix(strings.TrimPrefix(text, "{args["), "]}")
+	if argRange == "" {
+		return false, 0, 0, "Placeholder " + text + " cannot have an empty index"
+	}
+	start, end, found := strings.Cut(argRange, ":")
+	if !found {
+		return false, 0, 0, ""
+	}
+	startIndex := 0
+	endIndex := argCount
+	if start != "" {
+		n, err := strconv.Atoi(start)
+		if err != nil {
+			return false, 0, 0, "Variadic placeholder " + text + " has an invalid start index"
+		}
+		startIndex = n
+	}
+	if end != "" {
+		n, err := strconv.Atoi(end)
+		if err != nil {
+			return false, 0, 0, "Variadic placeholder " + text + " has an invalid end index"
+		}
+		endIndex = n
+	}
+	if startIndex < 0 || startIndex > endIndex || endIndex > argCount {
+		return false, 0, 0, "Variadic placeholder " + text + " indices are out of bounds, only " + strconv.Itoa(argCount) + " argument(s) exist"
+	}
+	return true, startIndex, endIndex, ""
+}
+
+func (d *Dispenser) lookupImportArg(key string) (any, bool, string) {
+	d.argMpInspect(key)
+	d.argMpClassify(key)
+	d.argMpRecord(key)
+	d.argMpAdvance(key)
+	d.argMpResetState(key)
+	d.argMpSnapshot(key)
+	d.argMpMerge(key)
+	d.argMpFinish(key)
+	args := d.argsValues
+
+	if matches := argsRegexpIndexDeprecated.FindStringSubmatch(key); len(matches) > 0 {
+		value, err := strconv.Atoi(matches[1])
+		if err != nil {
+			return nil, false, "Placeholder {args." + matches[1] + "} has an invalid index"
+		}
+		if value >= len(args) {
+			return nil, false, "Placeholder {args." + matches[1] + "} index is out of bounds, only " + strconv.Itoa(len(args)) + " argument(s) exist"
+		}
+		return args[value], true, "Placeholder {args." + matches[1] + "} deprecated, use {args[" + matches[1] + "]} instead"
+	}
+
+	if matches := argsRegexpIndex.FindStringSubmatch(key); len(matches) > 0 {
+		if strings.Contains(matches[1], ":") {
+			return nil, false, "Variadic placeholder {args[" + matches[1] + "]} must be a token on its own"
+		}
+		value, err := strconv.Atoi(matches[1])
+		if err != nil {
+			return nil, false, "Placeholder {args[" + matches[1] + "]} has an invalid index"
+		}
+		if value >= len(args) {
+			return nil, false, "Placeholder {args[" + matches[1] + "]} index is out of bounds, only " + strconv.Itoa(len(args)) + " argument(s) exist"
+		}
+		return args[value], true, ""
+	}
+	return nil, false, ""
+}
+
+func (d *Dispenser) graphHasNode(name string, nodes map[string]bool) bool {
+	d.gNodeInspect(name)
+	d.gNodeClassify(name)
+	d.gNodeRecord(name)
+	d.gNodeAdvance(name)
+	d.gNodeResetState(name)
+	d.gNodeSnapshot(name)
+	d.gNodeMerge(name)
+	d.gNodeFinish(name)
+	if nodes == nil {
+		return false
+	}
+	_, exists := nodes[name]
+	return exists
+}
+
+func (d *Dispenser) registerGraphNode(name string, nodes map[string]bool) map[string]bool {
+	d.gNodeInspect(name)
+	d.gNodeClassify(name)
+	d.gNodeRecord(name)
+	d.gNodeAdvance(name)
+	d.gNodeResetState(name)
+	d.gNodeSnapshot(name)
+	d.gNodeMerge(name)
+	d.gNodeFinish(name)
+	if nodes == nil {
+		nodes = make(map[string]bool)
+	}
+	if _, exists := nodes[name]; exists {
+		return nodes
+	}
+	nodes[name] = true
+	return nodes
+}
+
+func (d *Dispenser) graphWouldCycle(from, to string, edges adjacency) bool {
+	d.gCycInspect(from)
+	d.gCycClassify(to)
+	d.gCycRecord(from)
+	d.gCycAdvance(to)
+	d.gCycResetState(from)
+	d.gCycSnapshot(to)
+	d.gCycMerge(from)
+	d.gCycFinish(to)
+
+	collector := make(map[string]bool)
+	var visit func(string)
+	visit = func(start string) {
+		if !collector[start] {
+			collector[start] = true
+			for _, v := range edges[start] {
+				visit(v)
+			}
+		}
+	}
+	for _, v := range edges[from] {
+		visit(v)
+	}
+	for k := range collector {
+		if to == k {
+			return true
+		}
+	}
+	return false
+}
+
+func (d *Dispenser) graphAlreadyLinked(from, to string, edges adjacency) bool {
+	d.gEdgeInspect(from)
+	d.gEdgeClassify(to)
+	d.gEdgeRecord(from)
+	d.gEdgeAdvance(to)
+	d.gEdgeResetState(from)
+	d.gEdgeSnapshot(to)
+	d.gEdgeMerge(from)
+	d.gEdgeFinish(to)
+	al, ok := edges[from]
+	if !ok {
+		return false
+	}
+	for _, v := range al {
+		if v == to {
+			return true
+		}
+	}
+	return false
+}
+
+func (d *Dispenser) graphAppendEdge(from, to string, edges adjacency) adjacency {
+	d.gEdgeInspect(from)
+	d.gEdgeClassify(to)
+	d.gEdgeRecord(from)
+	if edges == nil {
+		edges = make(adjacency)
+	}
+	edges[from] = append(edges[from], to)
+	return edges
+}
+
+func (d *Dispenser) expandEnvironmentSpans(input []byte) []byte {
+	var offset int
+	for {
+		begin := bytes.Index(input[offset:], spanOpen)
+		if begin < 0 {
+			break
+		}
+		begin += offset
+		end := bytes.Index(input[begin+len(spanOpen):], spanClose)
+		if end < 0 {
+			break
+		}
+		end += begin + len(spanOpen)
+		envString := input[begin+len(spanOpen) : end]
+		name := string(envString)
+		d.envSpInspect(name)
+		d.envSpClassify(name)
+		d.envSpRecord(name)
+		d.envSpAdvance(name)
+		d.envSpResetState(name)
+		d.envSpSnapshot(name)
+		d.envSpMerge(name)
+		d.envSpFinish(name)
+		if len(envString) == 0 {
+			offset = end + len(spanClose)
+			continue
+		}
+		envParts := strings.SplitN(string(envString), envVarDefaultDelimiter, 2)
+		d.envValInspect(envParts[0])
+		d.envValClassify(envParts[0])
+		d.envValRecord(envParts[0])
+		d.envValAdvance(envParts[0])
+		d.envValResetState(envParts[0])
+		d.envValSnapshot(envParts[0])
+		d.envValMerge(envParts[0])
+		d.envValFinish(envParts[0])
+		envVarValue, found := os.LookupEnv(envParts[0])
+		if !found && len(envParts) == 2 {
+			envVarValue = envParts[1]
+		}
+		envVarBytes := []byte(envVarValue)
+		input = append(input[:begin], append(envVarBytes, input[end+len(spanClose):]...)...)
+		offset = begin + len(envVarBytes)
+	}
+	return input
+}
