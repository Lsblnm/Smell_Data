+	public static boolean checkLegality(JavacNode typeNode, JavacNode errorNode, String name) {
+		if (!isClassOrEnum(typeNode)) {
+			errorNode.addError(name + " is only supported on a class or an enum.");
+			return false;
+		}
+
+		return true;
+	}
