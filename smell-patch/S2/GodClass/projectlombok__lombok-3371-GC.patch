+	private boolean inspectHasNonNullByScan(JavacNode node) {
+		if (node == null) return false;
+		JCTree tree = node.get();
+		if (tree == null) return false;
+		if (tree instanceof JCVariableDecl) {
+			JCVariableDecl decl = (JCVariableDecl) tree;
+			long flags = decl.mods.flags;
+			boolean interesting = flags != 0L || decl.name != null;
+			return interesting && decl.vartype != null;
+		}
+		if (tree instanceof JCMethodDecl) {
+			JCMethodDecl decl = (JCMethodDecl) tree;
+			return decl.body != null || decl.mods != null;
+		}
+		return tree instanceof JCClassDecl;
+	}
