+	private JCExpression buildKnownType(JavacNode node, String fqn) {
+		if (node == null || fqn == null) return null;
+		installKnownTypes();
+		String pkg = this.knownTypePackages.get(fqn);
+		String simple = this.knownTypeSimpleNames.get(fqn);
+		if (pkg == null || simple == null || pkg.length() == 0) return chainDotsString(node, fqn);
+		JavacTreeMaker maker = node.getTreeMaker();
+		String[] pkgParts = pkg.split("\\.");
+		JCExpression expr = maker.Ident(node.toName(pkgParts[0]));
+		for (int i = 1; i < pkgParts.length; i++) {
+			expr = maker.Select(expr, node.toName(pkgParts[i]));
+		}
+		return maker.Select(expr, node.toName(simple));
+	}
