+func (m *pageMap) resolveContentNode(context page.Page, isReflink bool, ref string) (contentNodeI, error) {
+	ref = paths.ToSlashTrimTrailing(ref)
+	inRef := ref
+	if ref == "" {
+		ref = "/"
+	}
+
+	if paths.HasExt(ref) {
+		return m.resolveContentNodeForRef(context, isReflink, true, inRef, ref)
+	}
+
+	if ref == "/" {
+		if n, err := m.resolveContentNodeForRef(context, isReflink, false, inRef, "/_index"+defaultContentExt); n != nil || err != nil {
+			return n, err
+		}
+	} else if strings.HasSuffix(ref, "/index") {
+		if n, err := m.resolveContentNodeForRef(context, isReflink, false, inRef, ref+"/index"+defaultContentExt); n != nil || err != nil {
+			return n, err
+		}
+		if n, err := m.resolveContentNodeForRef(context, isReflink, false, inRef, ref+defaultContentExt); n != nil || err != nil {
+			return n, err
+		}
+	} else {
+		if n, err := m.resolveContentNodeForRef(context, isReflink, false, inRef, ref+defaultContentExt); n != nil || err != nil {
+			return n, err
+		}
+	}
+
+	return nil, nil
+}
+
+func (m *pageMap) resolveContentNodeForRef(context page.Page, isReflink, hadExtension bool, inRef, ref string) (contentNodeI, error) {
+	s := m.s
+	contentPathParser := s.Conf.PathParser()
+
+	if context != nil && !strings.HasPrefix(ref, "/") {
+		var baseDir string
+		if pi := context.PathInfo(); pi != nil {
+			if pi.IsBranchBundle() || (hadExtension && strings.HasPrefix(ref, "../")) {
+				baseDir = pi.Dir()
+			} else {
+				baseDir = pi.ContainerDir()
+			}
+		}
+
+		rel := path.Join(baseDir, ref)
+
+		relPath, _ := contentPathParser.ParseBaseAndBaseNameNoIdentifier(files.ComponentFolderContent, rel)
+
+		n, err := m.resolveContentNodeFromPath(relPath, ref)
+		if n != nil || err != nil {
+			return n, err
+		}
+
+		if hadExtension && context.File() != nil {
+			if n, err := m.resolveContentNodeFromReverseLookup(inRef, context.File().FileInfo()); n != nil || err != nil {
+				return n, err
+			}
+		}
+	}
+
+	if strings.HasPrefix(ref, ".") {
+		return nil, nil
+	}
+
+	relPath, nameNoIdentifier := contentPathParser.ParseBaseAndBaseNameNoIdentifier(files.ComponentFolderContent, ref)
+
+	n, err := m.resolveContentNodeFromPath(relPath, ref)
+
+	if n != nil || err != nil {
+		return n, err
+	}
+
+	if hadExtension && s.home != nil && s.home.File() != nil {
+		if n, err := m.resolveContentNodeFromReverseLookup(inRef, s.home.File().FileInfo()); n != nil || err != nil {
+			return n, err
+		}
+	}
+
+	var doSimpleLookup bool
+	if isReflink || context == nil {
+		slashCount := strings.Count(inRef, "/")
+		if slashCount <= 1 {
+			doSimpleLookup = slashCount == 0 || ref[0] == '/'
+		}
+	}
+
+	if !doSimpleLookup {
+		return nil, nil
+	}
+
+	n = m.pageReverseIndex.Get(m.finalizeIndexedBaseName(nameNoIdentifier))
+	if n == ambiguousContentNode {
+		return nil, fmt.Errorf("page reference %q is ambiguous", inRef)
+	}
+
+	return n, nil
+}
+
+func (m *pageMap) resolveContentNodeFromReverseLookup(ref string, fi hugofs.FileMetaInfo) (contentNodeI, error) {
+	s := m.s
+	meta := fi.Meta()
+	dir := meta.Filename
+	if !fi.IsDir() {
+		dir = filepath.Dir(meta.Filename)
+	}
+
+	realFilename := filepath.Join(dir, ref)
+
+	pcs, err := s.BaseFs.Content.ReverseLookup(realFilename, true)
+	if err != nil {
+		return nil, err
+	}
+
+	for _, pc := range pcs {
+		pi := s.Conf.PathParser().Parse(pc.Component, pc.Path)
+		if n := m.treePages.Get(pi.Base()); n != nil {
+			return n, nil
+		}
+	}
+	return nil, nil
+}
+
+func (m *pageMap) resolveContentNodeFromPath(s string, ref string) (contentNodeI, error) {
+	n := m.treePages.Get(s)
+	if n != nil {
+		return n, nil
+	}
+
+	return nil, nil
+}
