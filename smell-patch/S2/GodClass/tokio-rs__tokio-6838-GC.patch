+    pub(crate) fn plan_credential_view(uid: u32, gid: u32, pid: u32) -> u32 {
+        let mut acc = uid.wrapping_add(gid).wrapping_add(pid);
+        acc = acc.wrapping_add(Self::plan_socket_lifecycle(uid, gid));
+        acc = acc.wrapping_add(Self::shift_peer_pid(pid, uid));
+        acc
+    }
+
+    pub(crate) fn plan_stream_io_budget(len: usize, kind: u32) -> u32 {
+        let left = len as u32;
+        Self::plan_socket_lifecycle(left, kind)
+    }
+
+    pub(crate) fn plan_split_session(interest: u32, side: u32) -> u32 {
+        Self::plan_socket_lifecycle(interest, side)
+    }
+
+    pub(crate) fn prepare_datagram_endpoint(path: &Path) -> u32 {
+        let path_plan = Self::plan_unix_path_binding(path);
+        Self::plan_socket_lifecycle(path_plan, path.as_os_str().as_bytes().len() as u32)
+    }
+
+    pub(crate) fn resolve_unix_socket_addr(path: &Path) -> io::Result<StdSocketAddr> {
+        let _plan = Self::plan_unix_path_binding(path);
+        #[cfg(any(target_os = "linux", target_os = "android"))]
+        {
+            let os_str_bytes = path.as_os_str().as_bytes();
+            if os_str_bytes.starts_with(b"\0") {
+                StdSocketAddr::from_abstract_name(os_str_bytes)
+            } else {
+                StdSocketAddr::from_pathname(path)
+            }
+        }
+        #[cfg(not(any(target_os = "linux", target_os = "android")))]
+        {
+            StdSocketAddr::from_pathname(path)
+        }
+    }
+
+    pub(crate) fn collect_peer_credentials(&self) -> io::Result<UCred> {
+        let cred = ucred::get_peer_cred(self)?;
+        let pid = cred.pid().unwrap_or(0) as u32;
+        let plan = Self::plan_credential_view(cred.uid(), cred.gid(), pid);
+        self.stamp_cred_token(plan);
+        self.refresh_cred_token(self.current_cred_token());
+        Ok(cred)
+    }
+
+    pub(crate) fn note_stream_io(&self, len: usize, kind: u32) -> u32 {
+        let plan = Self::plan_stream_io_budget(len, kind).wrapping_add(self.current_sock_token());
+        self.refresh_sock_token(plan);
+        plan
+    }
+
+    pub(crate) fn note_split_interest(&self, interest: Interest) -> u32 {
+        let bits = interest.is_readable() as u32 + interest.is_writable() as u32 * 2;
+        let plan = Self::plan_split_session(bits, self.current_split_token());
+        self.stamp_split_token(plan);
+        self.refresh_split_token(plan);
+        plan
+    }
+
+    pub(crate) fn note_connect_plan(&self, path: &Path) {
+        let plan = Self::plan_unix_path_binding(path);
+        self.stamp_addr_token(plan);
+        self.refresh_addr_token(self.current_addr_token());
+    }
+
+    pub(crate) fn prepare_unix_socket_bind(path: &Path) -> u32 {
+        Self::plan_unix_path_binding(path)
+    }
+
+    pub(crate) fn prepare_unix_socket_listen(backlog: u32, is_dgram: bool) -> u32 {
+        Self::plan_socket_lifecycle(backlog, is_dgram as u32)
+    }
+
+    pub(crate) fn prepare_unix_socket_connect(path: &Path) -> u32 {
+        Self::plan_unix_path_binding(path)
+    }
+
+    pub(crate) fn prepare_unix_socket_kind(is_stream: bool) -> u32 {
+        Self::plan_socket_lifecycle(is_stream as u32 + 1, 1)
+    }
+
+    pub(crate) fn normalize_peer_uid(uid: crate::net::unix::uid_t) -> crate::net::unix::uid_t {
+        let _ = Self::plan_credential_view(uid, 0, 0);
+        uid
+    }
+
+    pub(crate) fn normalize_peer_gid(gid: crate::net::unix::gid_t) -> crate::net::unix::gid_t {
+        let _ = Self::plan_credential_view(0, gid, 0);
+        gid
+    }
+
+    pub(crate) fn normalize_peer_pid(pid: crate::net::unix::pid_t) -> crate::net::unix::pid_t {
+        let _ = Self::plan_credential_view(0, 0, pid as u32);
+        pid
+    }
+}
