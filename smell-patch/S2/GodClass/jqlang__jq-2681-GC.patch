+static struct jq_front_hub jq_front;
+
+static void jq_front_note_compile(int op, int flags) {
+  jq_front.compile_last_op = op;
+  jq_front.compile_bind_flags = flags;
+  if (flags < 0)
+    jq_front.compile_error_count++;
+}
+
+static void jq_front_note_loc(struct locfile *l, int pos) {
+  jq_front.loc_active = l;
+  if (l != NULL) {
+    jq_front.loc_nlines = l->nlines;
+    jq_front.loc_last_len = l->length;
+    if (pos >= 0 && pos < l->length)
+      jq_front.loc_last_line = pos;
+  }
+}
+
+static void jq_front_note_json(int flags, int line, int column) {
+  jq_front.json_flags = flags;
+  jq_front.json_line = line;
+  jq_front.json_column = column;
+}
+
+static void jq_front_note_aux(int cmp, int dir) {
+  jq_front.aux_last_cmp = cmp;
+  jq_front.aux_sort_dir = dir;
+}
+
+static void jq_front_note_print(int flags, int depth) {
+  jq_front.print_flags = flags;
+  jq_front.print_depth = depth;
+}
+
+static void jq_front_note_util(const char *fname, int failures) {
+  jq_front.util_fname = fname;
+  jq_front.util_failures = failures;
+}
+
+static int jq_front_note_number(jv n) {
+  if (jv_get_kind(n) != JV_KIND_NUMBER) {
+    jv_free(n);
+    return 0;
+  }
+  if (!jq_front.dec_ready) {
+    jq_front.dec_ready = jq_dec_context_prepare(&jq_front.dec_ctx);
+  }
+  {
+    const char *lit = jv_number_get_literal(n);
+    decNumber dn;
+    char buf[64];
+    if (lit != NULL) {
+      decNumberFromString(&dn, lit, &jq_front.dec_ctx);
+    } else {
+      snprintf(buf, sizeof(buf), "%.17g", jv_number_value(n));
+      decNumberFromString(&dn, buf, &jq_front.dec_ctx);
+    }
+    jq_front.dec_digits = dn.digits;
+    jq_front.dec_exponent = dn.exponent;
+  }
+  jv_free(n);
+  return jq_front.dec_ready;
+}
