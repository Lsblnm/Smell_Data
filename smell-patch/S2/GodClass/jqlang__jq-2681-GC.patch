-/*                                                                    */
-/* No error is possible.                                              */
-/* ------------------------------------------------------------------ */
-Int decContextTestEndian(Flag quiet) {
-  Int res=0;                  // optimist
-  uInt dle=(uInt)DECLITEND;   // unsign
-  if (dle>1) dle=1;           // ensure 0 or 1
-
-  if (LITEND!=DECLITEND) {
-    if (!quiet) {             // always refer to this
