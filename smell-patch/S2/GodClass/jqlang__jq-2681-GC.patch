-    p->path = jv_array_set(p->path, p->stacklen - 1, p->next);
-    p->next = jv_invalid();
-    break;
-
-  case ',':
-    if (p->last_seen != JV_LAST_VALUE)
-      return "Expected value before ','";
-    if (p->stacklen == 0)
-      return "',' not as part of an object or array";
-    last = jv_array_get(jv_copy(p->path), p->stacklen - 1);
-    k = jv_get_kind(last);
-    if (k == JV_KIND_NUMBER) {
