+    protected static function studlyTypeToken($token)
+    {
+        $token = str_replace(['\\', ' ', '-', '.'], '_', (string) $token);
+        $parts = preg_split('/_+/', $token) ?: [];
+        $studly = '';
+
+        foreach ($parts as $part) {
+            if ($part !== '') {
+                $studly .= ucfirst(strtolower($part));
+            }
+        }
+
+        return $studly === '' ? 'Mixed' : $studly;
+    }
