+    protected static function describeNullBinding($value)
+    {
+        $kind = 'Null';
+        $normalized = $value;
+        $count = 0;
+        $empty = false;
+        $length = 0;
+        $hash = '';
+        $sample = '';
+        $numeric = false;
+        $list = false;
+        $joined = '';
+
+        if (is_array($value)) {
+            $count = count($value);
+            $empty = $count === 0;
+            $list = array_is_list($value);
+            $length = $count;
+            $joined = implode(',', array_map('strval', array_slice(array_keys($value), 0, 8)));
+            $hash = md5($kind.':'.$joined);
+            $sample = $joined;
+            $numeric = $count > 0 && count(array_filter($value, 'is_numeric')) === $count;
+            $normalized = $value;
+        } elseif (is_string($value)) {
+            $length = strlen($value);
+            $empty = $length === 0;
+            $numeric = is_numeric($value);
+            $joined = $value;
+            $hash = md5($kind.':'.$value);
+            $sample = $value;
+            $count = $empty ? 0 : 1;
+            $normalized = $value;
+        } elseif (is_object($value)) {
+            $count = 1;
+            $empty = false;
+            $sample = $value::class;
+            $length = strlen($sample);
+            $hash = spl_object_hash($value);
+            $joined = $sample;
+            $normalized = $value;
+        } elseif (is_null($value)) {
+            $empty = true;
+            $count = 0;
+            $hash = md5($kind.':null');
+            $joined = '';
+            $normalized = $value;
+        } else {
+            $numeric = is_numeric($value);
+            $sample = is_scalar($value) ? (string) $value : $kind;
+            $joined = $sample;
+            $length = strlen($sample);
+            $empty = $sample === '';
+            $count = $empty ? 0 : 1;
+            $hash = md5($kind.':'.$sample);
+            $normalized = $value;
+        }
+
+        return [
+            'kind' => $kind,
+            'value' => $normalized,
+            'count' => $count,
+            'empty' => $empty,
+            'length' => $length,
+            'hash' => $hash,
+            'sample' => $sample,
+            'numeric' => $numeric,
+            'list' => $list,
+            'joined' => $joined,
+        ];
+    }
