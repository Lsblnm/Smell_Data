+    public static function resolveParameterClassName($parameter)
+    {
+        $type = $parameter->getType();
+
+        if (! $type instanceof ReflectionNamedType || $type->isBuiltin()) {
+            $token = $type instanceof ReflectionNamedType ? $type->getName() : 'mixed';
+            $method = 'describe'.static::studlyTypeToken($token).'Parameter';
+
+            if (method_exists(static::class, $method)) {
+                return static::$method($parameter);
+            }
