+    public static function describeBindingValue($value)
+    {
+        $kind = static::classifyBindingValue($value);
+        $method = 'describe'.$kind.'Binding';
+
+        if (method_exists(static::class, $method)) {
+            return static::$method($value);
+        }
+
+        return [
+            'kind' => $kind,
+            'value' => $value,
+            'count' => 0,
+            'empty' => empty($value),
+            'length' => is_string($value) ? strlen($value) : 0,
+            'hash' => is_object($value) ? spl_object_hash($value) : md5(gettype($value)),
+            'sample' => is_scalar($value) ? (string) $value : $kind,
+            'numeric' => is_numeric($value),
+            'list' => false,
+            'joined' => '',
+            'encoded' => '',
+            'types' => [gettype($value)],
+            'byte_length' => 0,
+            'unique_count' => 0,
+        ];
+    }
+
+    protected static function classifyBindingValue($value)
+    {
+        if (is_null($value)) {
+            return 'Null';
+        }
+
+        if ($value === true) {
+            return 'BooleanTrue';
+        }
+
+        if ($value === false) {
+            return 'BooleanFalse';
+        }
+
+        if (is_int($value)) {
+            return 'Integer';
+        }
+
+        if (is_float($value)) {
+            return 'Float';
+        }
+
+        if (is_string($value)) {
+            return 'String';
+        }
+
+        if (is_array($value)) {
+            return 'Array';
+        }
+
+        if ($value instanceof Closure) {
+            return 'Closure';
+        }
+
+        if (is_object($value)) {
+            $shortName = (new ReflectionClass($value))->getShortName();
+            $candidate = 'describe'.$shortName.'Binding';
+
+            if (method_exists(static::class, $candidate)) {
+                return $shortName;
+            }
+
+            return 'Object';
+        }
+
+        if (is_resource($value)) {
+            return 'Resource';
+        }
+
+        return 'Mixed';
+    }
