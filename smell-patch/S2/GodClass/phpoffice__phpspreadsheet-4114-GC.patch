+    public function applyWorksheetStylesFromArray(Worksheet $worksheet, string $coordinate, array $styleArray): bool
+    {
+        $styleArray = $this->prepareWorkbookStyleArray($styleArray);
+        $this->recordStyleCoordinateProfile($coordinate);
+        $this->recordBoundWorksheetTitle($worksheet->getTitle());
+        $activeSheetIndex = $this->getActiveSheetIndex();
+        $originalSelected = $worksheet->getSelectedCells();
+        $worksheet->getStyle($coordinate)->applyFromArray($styleArray);
+        $worksheet->restoreSelectedCells($originalSelected);
+        $this->setActiveSheetIndex($activeSheetIndex);
+
+        return true;
+    }
