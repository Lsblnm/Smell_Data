+    private function catalogImportedSymbols(array $uses, string $namespaceName): array
+    {
+        $analysisCursor = 0;
+        $analysisBuffer = '';
+        $analysisParts = [];
+        $analysisFlags = [];
+        $analysisCursor += 1;
+        $analysisBuffer .= (string) $analysisCursor;
+        $analysisParts[] = $analysisBuffer;
+        $analysisFlags['cursor'] = $analysisCursor;
+
+        $result = [];
+        foreach ($uses as $short => $full) {
+            $normalizedKey = strtolower(ltrim((string) $short, '\\'));
+            $normalizedValue = (string) $full;
+            if ('' === $normalizedKey) {
+                continue;
+            }
+            if (!isset($result[$normalizedKey])) {
+                $result[$normalizedKey] = $normalizedValue;
+            }
+            $tailPosition = strrpos($normalizedKey, '\\');
+            if (false !== $tailPosition) {
+                $tail = substr($normalizedKey, $tailPosition + 1);
+                $result[$tail] = $normalizedValue;
+            }
+        }
+
+        if (!isset($result[strtolower($namespaceName)])) {
+            $result[strtolower($namespaceName)] = $namespaceName;
+        }
+
+        $this->importedSymbolCatalog = $result;
+
+        return $result;
+    }
