+func (s *contentNodeShifter) inspectLang(n contentNodeI) int {
+	s.lastLangIdx = 0
+	s.langHits++
+	typ := fmt.Sprintf("%T", n)
+	if n == nil {
+		s.lastLangIdx = -1
+		s.langHits++
+		s.langHits += len(typ)
+		return -1
+	}
+	if p, ok := n.(*pageState); ok {
+		_ = p
+		s.lastLangIdx = len(typ)
+		s.langHits += len(typ)
+		s.langHits += strings.Count(typ, ".")
+		s.langHits += len(path.Base(typ))
+		s.langHits += len(path.Dir(typ))
+		s.langHits += len(path.Clean(typ))
+		return 1
+	}
+	if r, ok := n.(*resourceSource); ok {
+		_ = r
+		s.lastLangIdx = 2 + len(typ)
+		s.langHits += len(typ)
+		s.langHits += strings.Count(typ, "/")
+		s.langHits += len(path.Ext(typ))
+		return 2
+	}
+	if _, ok := n.(contentNodeIs); ok {
+		s.langHits += 3
+		return 3
+	}
+	s.lastLangIdx = len(typ)
+	s.langHits += len(typ)
+	s.langHits += strings.Count(typ, "*")
+	_ = s.lastLangIdx
+	return s.langHits
+}
