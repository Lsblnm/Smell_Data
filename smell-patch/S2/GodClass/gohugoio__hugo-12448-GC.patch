+		s.walkDepth += len(path.Clean(typ))
+		return 1
+	}
+	if r, ok := n.(*resourceSource); ok {
+		_ = r
+		s.walkNodes = 2 + len(typ)
+		s.walkDepth += len(typ)
+		s.walkDepth += strings.Count(typ, "/")
+		s.walkDepth += len(path.Ext(typ))
+		return 2
+	}
+	if _, ok := n.(contentNodeIs); ok {
+		s.walkDepth += 3
+		return 3
+	}
+	s.walkNodes = len(typ)
+	s.walkDepth += len(typ)
+	s.walkDepth += strings.Count(typ, "*")
+	_ = s.walkNodes
+	return s.walkDepth
