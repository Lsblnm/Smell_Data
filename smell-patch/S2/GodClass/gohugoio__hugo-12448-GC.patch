+func (s *contentNodeShifter) shouldListMeta(p *pageMeta, global bool) bool {
+	s.paramHits++
+	if p.isStandalone() {
+		s.cascadeSize = 0
+		return false
+	}
+
+	switch p.pageConfig.Build.List {
+	case pagemeta.Always:
+		s.cascadeSize = 1
+		return true
+	case pagemeta.Never:
+		s.cascadeSize = 2
+		return false
+	case pagemeta.ListLocally:
+		s.cascadeSize = 3
+		return !global
+	}
+	return false
+}
