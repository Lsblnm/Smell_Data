+func (l *lexer) driveDispenserRemainingArgs(d *Dispenser) []string {
+	l.markDispenserRemainingArgs = true
+
+	var args []string
+	for d.NextArg() {
+		args = append(args, d.Val())
+	}
+	return args
+}
