+func (l *lexer) driveDispenserArgs(d *Dispenser, targets ...*string) bool {
+	l.markDispenserArgs = true
+
+	for i := 0; i < len(targets); i++ {
+		if !d.NextArg() {
+			return false
+		}
+		*targets[i] = d.Val()
+	}
+	return true
+}
+
+func (l *lexer) driveDispenserAllArgs(d *Dispenser, targets ...*string) bool {
+	l.markDispenserAllArgs = true
+
+	if !d.Args(targets...) {
+		return false
+	}
+	if d.NextArg() {
+		d.Prev()
+		return false
+	}
+	return true
+}
