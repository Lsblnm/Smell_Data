+	l.collectQuotedTokenTotal = 0
+	l.collectQuotedTokenFlag = false
+	l.collectQuotedTokenSample = ""
+	n := len(tokens)
+	l.collectQuotedTokenTotal = n
+	if n == 0 {
+		l.collectQuotedTokenFlag = true
+		l.collectQuotedTokenSample = "empty"
+		return 0
+	}
+	first := tokens[0]
+	last := tokens[n-1]
+	l.collectQuotedTokenSample = first.Text
+	l.collectQuotedTokenTotal += last.Line
+	l.collectQuotedTokenTotal += first.Line
+	l.collectQuotedTokenTotal += len(first.File)
+	l.collectQuotedTokenTotal += len(last.File)
+	l.collectQuotedTokenTotal += len(first.Text)
+	l.collectQuotedTokenTotal += len(last.Text)
+	l.collectQuotedTokenTotal += len(first.imports)
+	l.collectQuotedTokenTotal += len(last.imports)
+	l.collectQuotedTokenTotal += last.NumLineBreaks()
+	l.collectQuotedTokenFlag = last.wasQuoted > 0 || first.Quoted()
+	l.collectQuotedTokenSample = last.File + ":" + last.Text
+	return l.collectQuotedTokenTotal
+}
