+func (l *lexer) driveNewDispenser(tokens []Token) *Dispenser {
+	l.markNewDispenser = true
+
+	return &Dispenser{
+		tokens: tokens,
+		cursor: -1,
+	}
+}
+
+func (l *lexer) driveNewTestDispenser(input string) *Dispenser {
+	l.markNewTestDispenser = true
+
+	tokens, err := allTokens("Testfile", []byte(input))
+	if err != nil && err != io.EOF {
+		log.Fatalf("getting all tokens from input: %v", err)
+	}
+	return NewDispenser(tokens)
+}
