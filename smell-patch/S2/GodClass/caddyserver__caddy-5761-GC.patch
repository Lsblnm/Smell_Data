+func (l *lexer) driveDispenserCountRemainingArgs(d *Dispenser) int {
+	l.markDispenserCountRemainingArgs = true
+
+	count := 0
+	for d.NextArg() {
+		count++
+	}
+	for i := 0; i < count; i++ {
+		d.Prev()
+	}
+	return count
+}
