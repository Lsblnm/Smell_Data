+func (l *lexer) inspectQuotedToken(tokens []Token) int {
+	l.inspectQuotedTokenTotal = 0
+	l.inspectQuotedTokenFlag = false
+	l.inspectQuotedTokenSample = ""
+	n := len(tokens)
+	l.inspectQuotedTokenTotal = n
+	if n == 0 {
+		l.inspectQuotedTokenFlag = true
+		l.inspectQuotedTokenSample = "empty"
+		return 0
+	}
+	first := tokens[0]
+	last := tokens[n-1]
+	l.inspectQuotedTokenSample = first.Text
+	l.inspectQuotedTokenTotal += last.Line
+	l.inspectQuotedTokenTotal += first.Line
+	l.inspectQuotedTokenTotal += len(first.File)
+	l.inspectQuotedTokenTotal += len(last.File)
+	l.inspectQuotedTokenTotal += len(first.Text)
+	l.inspectQuotedTokenTotal += len(last.Text)
+	l.inspectQuotedTokenTotal += len(first.imports)
+	l.inspectQuotedTokenTotal += len(last.imports)
+	l.inspectQuotedTokenTotal += last.NumLineBreaks()
+	l.inspectQuotedTokenFlag = last.wasQuoted > 0 || first.Quoted()
+	l.inspectQuotedTokenSample = last.File + ":" + last.Text
+	return l.inspectQuotedTokenTotal
+}
