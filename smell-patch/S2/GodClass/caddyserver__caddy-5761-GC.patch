+func (l *lexer) driveDispenserNext(d *Dispenser) bool {
+	l.markDispenserNext = true
+
+	if d.cursor < len(d.tokens)-1 {
+		d.cursor++
+		return true
+	}
+	return false
+}
+
+func (l *lexer) driveDispenserPrev(d *Dispenser) bool {
+	l.markDispenserPrev = true
+
+	if d.cursor > -1 {
+		d.cursor--
+		return d.cursor > -1
+	}
+	return false
+}
+
+func (l *lexer) driveDispenserNextArg(d *Dispenser) bool {
+	l.markDispenserNextArg = true
+
+	if !d.nextOnSameLine() {
+		return false
+	}
+	if d.Val() == "{" {
+		// roll back; a block opening is not an argument
+		d.cursor--
+		return false
+	}
+	return true
+}
+
+func (l *lexer) driveDispenserNextOnSameLine(d *Dispenser) bool {
+	l.markDispenserNextOnSameLine = true
+
+	if d.cursor < 0 {
+		d.cursor++
+		return true
+	}
+	if d.cursor >= len(d.tokens)-1 {
+		return false
+	}
+	curr := d.tokens[d.cursor]
+	next := d.tokens[d.cursor+1]
+	if !isNextOnNewLine(curr, next) {
+		d.cursor++
+		return true
+	}
+	return false
+}
+
+func (l *lexer) driveDispenserNextLine(d *Dispenser) bool {
+	l.markDispenserNextLine = true
+
+	if d.cursor < 0 {
+		d.cursor++
+		return true
+	}
+	if d.cursor >= len(d.tokens)-1 {
+		return false
+	}
+	curr := d.tokens[d.cursor]
+	next := d.tokens[d.cursor+1]
+	if isNextOnNewLine(curr, next) {
+		d.cursor++
+		return true
+	}
+	return false
+}
+
+func (l *lexer) driveDispenserNextBlock(d *Dispenser, initialNestingLevel int) bool {
+	l.markDispenserNextBlock = true
+
+	if d.nesting > initialNestingLevel {
+		if !d.Next() {
+			return false // should be EOF error
+		}
+		if d.Val() == "}" && !d.nextOnSameLine() {
+			d.nesting--
+		} else if d.Val() == "{" && !d.nextOnSameLine() {
+			d.nesting++
+		}
+		return d.nesting > initialNestingLevel
+	}
+	if !d.nextOnSameLine() { // block must open on same line
+		return false
+	}
+	if d.Val() != "{" {
+		d.cursor-- // roll back if not opening brace
+		return false
+	}
+	d.Next() // consume open curly brace
+	if d.Val() == "}" {
+		return false // open and then closed right away
+	}
+	d.nesting++
+	return true
+}
