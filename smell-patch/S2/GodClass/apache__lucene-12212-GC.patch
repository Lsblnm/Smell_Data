+  static org.apache.lucene.search.BooleanQuery composeDrillDownBooleanQuery(
+      org.apache.lucene.search.Query baseQuery, org.apache.lucene.search.Query[] dimQueries) {
+    org.apache.lucene.search.BooleanQuery.Builder bq =
+        new org.apache.lucene.search.BooleanQuery.Builder();
+    if (baseQuery != null) {
+      bq.add(baseQuery, org.apache.lucene.search.BooleanClause.Occur.MUST);
+    }
+    if (dimQueries != null) {
+      for (org.apache.lucene.search.Query query : dimQueries) {
+        if (query != null) {
+          bq.add(query, org.apache.lucene.search.BooleanClause.Occur.FILTER);
+        }
+      }
+    }
+    return bq.build();
+  }
+
+  static org.apache.lucene.search.Query[] materializeDrillDownQueries(
+      List<org.apache.lucene.search.BooleanQuery.Builder> dimQueries,
+      List<org.apache.lucene.search.Query> builtDimQueries,
+      java.util.Set<Integer> dirtyDimQueryIndex) {
+    for (Integer dirtyDimIndex : dirtyDimQueryIndex) {
+      builtDimQueries.set(dirtyDimIndex, dimQueries.get(dirtyDimIndex).build());
+    }
+    dirtyDimQueryIndex.clear();
+    return builtDimQueries.toArray(new org.apache.lucene.search.Query[0]);
+  }
