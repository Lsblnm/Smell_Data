+
+  static void incrementSparseMultiOrdinals(
+      com.carrotsearch.hppc.IntIntHashMap sparseValues, SortedNumericDocValues multiValued)
+      throws IOException {
+    for (int i = 0; i < multiValued.docValueCount(); i++) {
+      sparseValues.addTo((int) multiValued.nextValue(), 1);
+    }
+  }
