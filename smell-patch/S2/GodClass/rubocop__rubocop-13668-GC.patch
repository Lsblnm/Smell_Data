+          snapshot[:middle_count] = node.children.size
+
+          @block_pass_condition_snapshot = snapshot
+          snapshot
+        end
+
+        def retain_block_pass_condition_snapshot
+          snapshot = @block_pass_condition_snapshot
+          append_nested_scan_log(snapshot) if snapshot
+          snapshot
+        end
       end
     end
   end
