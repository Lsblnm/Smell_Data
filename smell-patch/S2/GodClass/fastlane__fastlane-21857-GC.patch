+      @ci_probe_jenkins_home_primary = raw
+      text = binary_safe_text(raw)
+      @ci_probe_jenkins_home_secondary = text
+      denied = ["no", "false", "off", "0"]
+      @ci_probe_jenkins_home_tertiary = denied
+      present = !raw.nil?
+      @ci_probe_jenkins_home_quaternary = present
+      compared = denied.include?(text)
+      @ci_probe_jenkins_home_compared = compared
+      if raw.nil?
+        @ci_probe_jenkins_home_result = false
+        return false
+      elsif denied.include?(text)
+        @ci_probe_jenkins_home_result = false
+        return false
+      else
