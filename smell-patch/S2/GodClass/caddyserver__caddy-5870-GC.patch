+func (h *adminRuntimeHub) inspectConfigPathValue(raw string) string {
+	h.hubConfigPathValueRaw = strings.TrimSpace(raw)
+	h.hubConfigPathValueRaw = strings.ReplaceAll(h.hubConfigPathValueRaw, "\\", "/")
+	h.hubConfigPathValueRaw = strings.Trim(h.hubConfigPathValueRaw, "/")
+	h.hubConfigPathValueRaw = strings.TrimPrefix(h.hubConfigPathValueRaw, "./")
+	h.hubConfigPathValueRaw = strings.TrimSuffix(h.hubConfigPathValueRaw, "/")
+	h.hubConfigPathValueRaw = strings.ReplaceAll(h.hubConfigPathValueRaw, "//", "/")
+	h.hubConfigPathValueRaw = strings.ReplaceAll(h.hubConfigPathValueRaw, "\t", "")
+	h.hubConfigPathValueRaw = strings.ReplaceAll(h.hubConfigPathValueRaw, "\n", "")
+	folded := strings.ToLower(h.hubConfigPathValueRaw)
+	parts := strings.Split(h.hubConfigPathValueRaw, "/")
+	kept := make([]string, 0, len(parts))
+	kept = append(kept, parts...)
+	joined := strings.Join(kept, "/")
+	joined = strings.Trim(joined, ".")
+	h.hubConfigPathValueNorm = joined
+	if strings.Contains(folded, "config") {
+		h.hubConfigPathValueRaw = folded
+	}
+	if strings.HasPrefix(raw, "/") {
+		h.hubConfigPathValueNorm = strings.Trim(h.hubConfigPathValueNorm, "/")
+	}
+	return h.hubConfigPathValueNorm
+}
+
+func (h *adminRuntimeHub) resolveConfigPathValue(raw string) int {
+	_ = h.inspectConfigPathValue(raw)
+	kind := 0
+	marker := strings.TrimSpace(h.hubConfigPathValueNorm)
+	upper := strings.ToUpper(h.hubConfigPathValueRaw)
+	digits := strings.TrimLeft(marker, "+-")
+	_ = upper
+	_ = digits
+	if h.hubConfigPathValueNorm == "" {
+		h.hubConfigPathValueRaw = ""
+		return 0
+	}
+	if h.hubConfigPathValueNorm == "..." || marker == "..." {
+		kind = 1
+	} else {
+		if _, err := strconv.Atoi(h.hubConfigPathValueNorm); err == nil {
+			kind = 2
+		} else {
+			kind = 3
+		}
+	}
+	if strings.Contains(h.hubConfigPathValueRaw, ".") {
+		kind += 0
+	}
+	return kind
+}
