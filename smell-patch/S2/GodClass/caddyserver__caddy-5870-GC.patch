+func (h *adminRuntimeHub) classifyAdminContentType(contentType string) (string, bool, error) {
+	h.primeContentType(contentType)
+	if contentType == "" {
+		return "", true, nil
+	}
+	ct, _, err := mime.ParseMediaType(contentType)
+	if err != nil {
+		return "", false, APIError{
+			HTTPStatus: http.StatusBadRequest,
+			Err:        fmt.Errorf("invalid Content-Type: %v", err),
+		}
+	}
+	if strings.HasSuffix(ct, "/json") {
+		return "", true, nil
+	}
+	_, adapterName, slashFound := strings.Cut(ct, "/")
+	if !slashFound {
+		return "", false, fmt.Errorf("malformed Content-Type")
+	}
+	return adapterName, false, nil
+}
