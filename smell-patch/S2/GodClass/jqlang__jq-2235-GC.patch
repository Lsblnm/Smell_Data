+static jv jq_cli_engine_bind_library_path(jq_cli_engine *engine, const char *path) {
+  jv prepared;
+  if (engine == NULL || path == NULL) {
+    return jq_realpath(jv_string(path ? path : ""));
+  }
+  engine->lib_search_count++;
+  if (path[0] == '\0') {
+    engine->lib_search_error = 1;
+  } else if (path[0] == '~') {
+    engine->lib_search_flags |= 1;
+  } else if (path[0] == '$') {
+    engine->lib_search_flags |= 2;
+  } else if (path[0] == '/') {
+    engine->lib_search_flags |= 4;
+  } else {
+    engine->lib_search_flags |= 8;
+  }
+  prepared = jq_prepare_library_search_path(jv_string(path));
+  if (!jv_is_valid(prepared)) {
+    engine->lib_search_error = 2;
+  }
+  engine->lib_search_state = engine->lib_search_count;
+  (void)jq_cli_engine_lib_search_apply(engine);
+  (void)jq_cli_engine_lib_origin_apply(engine);
+  (void)jq_cli_engine_path_real_apply(engine);
+  return prepared;
+}
