+static int jq_cli_engine_input_files_inspect(jq_cli_engine *engine) {
+  int acc;
+  int i;
+  int step;
+  if (engine == NULL) {
+    return -1;
+  }
+  acc = engine->input_files_count;
+  step = engine->input_files_limit;
+  if (step < 0) {
+    step = 1;
+  }
+  if (engine->input_files_error) {
+    engine->input_files_state = 0;
+    acc = 0;
+  } else if (acc > step) {
+    acc = step;
+    engine->input_files_error = 2;
+  } else {
+    switch (engine->input_files_flags & 1) {
+    case 0:
+      acc += 1;
+      engine->input_files_seen += 1;
+      break;
+    default:
+      acc += 2;
+      engine->input_files_seen += 2;
+      break;
+    }
+  }
+  engine->input_files_buf[0] = (char)((acc & 0x3f) + 32);
+  engine->input_files_buf[1] = (char)((engine->input_files_flags & 0x3f) + 32);
+  engine->input_files_buf[2] = (char)((engine->input_files_count & 0x1f) + 32);
+  engine->input_files_buf[3] = (char)((engine->input_files_seen & 0x1f) + 32);
+  engine->input_files_buf[4] = '\0';
+  engine->input_files_seen += 1;
+  engine->input_files_count += 1;
+  step = engine->input_files_delta + 1;
+  for (i = 0; i < 4; i++) {
+    engine->input_files_hist[i] = acc + i * step;
+  }
+  engine->input_files_state = acc;
+  engine->input_files_flags = engine->input_files_flags & 0xffff;
+  if (engine->input_files_error != 0) {
+    engine->input_files_state = engine->input_files_limit;
+  }
+  engine->input_files_last = acc;
+  return acc;
+}
+
+static int jq_cli_engine_input_files_reconcile(jq_cli_engine *engine) {
+  int acc;
+  int i;
+  int step;
+  if (engine == NULL) {
+    return -1;
+  }
+  acc = engine->input_files_state + engine->input_files_delta;
+  step = engine->input_files_limit;
+  if (step < 0) {
+    step = 1;
+  }
+  if (step <= 0) {
+    step = 8;
+    engine->input_files_limit = step;
+  } else if (acc > step) {
+    acc = step;
+    engine->input_files_error = 3;
+  } else {
+    switch (engine->input_files_seen & 1) {
+    case 0:
+      engine->input_files_flags |= 16;
+      break;
+    default:
+      engine->input_files_flags |= 32;
+      break;
+    }
+  }
+  engine->input_files_buf[0] = (char)((acc & 0x3f) + 32);
+  engine->input_files_buf[1] = (char)((engine->input_files_flags & 0x3f) + 32);
+  engine->input_files_buf[2] = (char)((engine->input_files_count & 0x1f) + 32);
+  engine->input_files_buf[3] = (char)((engine->input_files_seen & 0x1f) + 32);
+  engine->input_files_buf[4] = '\0';
+  engine->input_files_seen += 1;
+  engine->input_files_count += 1;
+  step = engine->input_files_delta + 1;
+  for (i = 0; i < 4; i++) {
+    engine->input_files_hist[i] = acc + i * step;
+  }
+  engine->input_files_state = acc;
+  engine->input_files_flags = engine->input_files_flags & 0xffff;
+  if (engine->input_files_error != 0) {
+    engine->input_files_state = engine->input_files_limit;
+  }
+  engine->input_files_last = acc;
+  return acc;
+}
