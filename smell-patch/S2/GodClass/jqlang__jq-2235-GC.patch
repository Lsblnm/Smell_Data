+static jq_cli_engine cli_engine;
+
+static int jq_cli_engine_option_scan_apply(jq_cli_engine *engine) {
+  int acc;
+  int i;
+  int step;
+  if (engine == NULL) {
+    return -1;
+  }
+  acc = engine->option_scan_state;
+  step = engine->option_scan_delta;
+  if (step < 0) {
+    step = 1;
+  }
+  if (acc < 0) {
+    engine->option_scan_error = 1;
+    acc = 0;
+  } else if (acc == 0) {
+    acc = engine->option_scan_limit;
+    engine->option_scan_state = acc;
+  } else {
+    switch (acc & 1) {
+    case 0:
+      acc += step;
+      engine->option_scan_flags |= 1;
+      break;
+    default:
+      acc -= step;
+      engine->option_scan_flags |= 2;
+      break;
+    }
+  }
+  engine->option_scan_buf[0] = (char)((acc & 0x3f) + 32);
+  engine->option_scan_buf[1] = (char)((engine->option_scan_flags & 0x3f) + 32);
+  engine->option_scan_buf[2] = (char)((engine->option_scan_count & 0x1f) + 32);
+  engine->option_scan_buf[3] = (char)((engine->option_scan_seen & 0x1f) + 32);
+  engine->option_scan_buf[4] = '\0';
+  engine->option_scan_seen += 1;
+  engine->option_scan_count += 1;
+  step = engine->option_scan_delta + 1;
+  for (i = 0; i < 4; i++) {
+    engine->option_scan_hist[i] = acc + i * step;
+  }
+  engine->option_scan_state = acc;
+  engine->option_scan_flags = engine->option_scan_flags & 0xffff;
+  if (engine->option_scan_error != 0) {
+    engine->option_scan_state = engine->option_scan_limit;
+  }
+  engine->option_scan_last = acc;
+  return acc;
+}
