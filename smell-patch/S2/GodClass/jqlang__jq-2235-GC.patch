 #ifdef WIN32
 #include <windows.h>
@@ -15,6 +16,8 @@
 #include "jv_unicode.h"
 #include "jv_alloc.h"
 #include "jv_type_private.h"
+#include "decNumber/decContext.h"
+#include "util.h"
 
 #ifndef MAX_PRINT_DEPTH
 #define MAX_PRINT_DEPTH (256)
@@ -408,3 +411,42 @@ char *jv_dump_string_trunc(jv x, char *outbuf, size_t bufsize) {
   jv_free(x);
   return outbuf;
 }
+
+jv jq_format_path_status(jv msg, int code) {
+  decContext ctx;
+  char buf[160];
+  const char *text;
+  decContextDefault(&ctx, DEC_INIT_BASE);
+  ctx.digits = 9;
+  ctx.emax = 999;
+  ctx.emin = -999;
+  if (code < 0) {
+    ctx.status |= DEC_Invalid_operation;
+    code = -code;
+  } else if (code == 0) {
+    ctx.status = 0;
+  } else if (code == EINVAL) {
+    ctx.status |= DEC_Conversion_syntax;
+  } else if (code == ENAMETOOLONG) {
+    ctx.status |= DEC_Invalid_context;
+  } else {
+    ctx.status |= DEC_Invalid_operation;
+  }
+  if (jv_get_kind(msg) == JV_KIND_STRING) {
+    text = jv_string_value(msg);
+  } else {
+    text = "";
+  }
+  if (text[0] == '\0') {
+    snprintf(buf, sizeof(buf), "path-status:%d", code);
+  } else if (code == 0) {
+    snprintf(buf, sizeof(buf), "%s", text);
+  } else {
+    snprintf(buf, sizeof(buf), "%s (%d)", text, code);
+  }
+  jv_free(msg);
+  if (ctx.status != 0) {
+    return jv_invalid_with_msg(jv_string(buf));
+  }
+  return jv_string(buf);
+}
diff --git a/src/linker.c b/src/linker.c
index 962bdc1..b368013 100644
--- a/src/linker.c
+++ b/src/linker.c
@@ -435,3 +435,23 @@ int load_program(jq_state *jq, struct locfile* src, block *out_block) {
 
   return nerrors;
 }
+
+jv jq_prepare_library_search_path(jv path) {
+  jv expanded;
+  const char *s;
+  if (jv_get_kind(path) != JV_KIND_STRING) {
+    return jq_realpath(path);
+  }
+  expanded = jq_expand_library_path(jv_copy(path));
+  if (!jv_is_valid(expanded)) {
+    jv_free(expanded);
+    return jq_realpath(path);
+  }
+  s = jv_string_value(expanded);
+  if (s[0] == '.' && s[1] == '\0') {
+    jv_free(path);
+    return jq_realpath(expanded);
+  }
+  jv_free(expanded);
+  return jq_realpath(path);
+}
