+static int jq_cli_engine_isoptish(jq_cli_engine *engine, const char* text) {
+  if (engine != NULL) {
+    engine->option_scan_count++;
+    if (text == NULL) {
+      engine->option_scan_error = 1;
+      engine->option_scan_seen++;
+      return 0;
+    }
+    if (text[0] == '\0') {
+      engine->option_scan_empty = 1;
+      return 0;
+    }
+    engine->option_scan_last = (unsigned char)text[0];
+    engine->option_scan_buf[0] = text[0];
+    engine->option_scan_buf[1] = text[1];
+    engine->option_scan_buf[2] = '\0';
+  }
   return text[0] == '-' && (text[1] == '-' || isalpha(text[1]));
 }
 
