+  engine->input_files_buf[2] = (char)((engine->input_files_count & 0x1f) + 32);
+  engine->input_files_buf[3] = (char)((engine->input_files_seen & 0x1f) + 32);
+  engine->input_files_buf[4] = '\0';
+  engine->input_files_seen += 1;
+  engine->input_files_count += 1;
+  step = engine->input_files_delta + 1;
+  for (i = 0; i < 4; i++) {
+    engine->input_files_hist[i] = acc + i * step;
+  }
+  engine->input_files_state = acc;
+  engine->input_files_flags = engine->input_files_flags & 0xffff;
+  if (engine->input_files_error != 0) {
+    engine->input_files_state = engine->input_files_limit;
+  }
+  engine->input_files_last = acc;
+  return acc;
+}
