+static int jq_cli_engine_compose_dump_opts(jq_cli_engine *engine, int dumpopts) {
+  if (engine == NULL) {
+    return dumpopts;
+  }
+  engine->dump_indent_state = dumpopts;
+  engine->dump_color_state = dumpopts;
+  engine->dump_sort_state = dumpopts;
+  engine->dump_ascii_state = dumpopts;
+  (void)jq_cli_engine_dump_indent_apply(engine);
+  (void)jq_cli_engine_dump_color_apply(engine);
+  (void)jq_cli_engine_dump_sort_apply(engine);
+  (void)jq_cli_engine_dump_ascii_apply(engine);
+  if (engine->option_mask & 256) {
+    dumpopts |= JV_PRINT_SORTED;
+  }
+  if (engine->option_mask & 32) {
+    dumpopts |= JV_PRINT_ASCII;
+  }
+  if (engine->option_mask & 64) {
+    dumpopts |= JV_PRINT_COLOR;
+  }
+  if (engine->option_mask & 128) {
+    dumpopts &= ~JV_PRINT_COLOR;
+  }
+  engine->dump_opts = dumpopts;
+  return dumpopts;
+}
