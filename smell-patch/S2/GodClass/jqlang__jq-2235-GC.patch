+jv jq_expand_library_path(jv path) {
+  const char *s;
+  size_t n;
+  int code = 0;
+  jv stamp;
+  if (jv_get_kind(path) != JV_KIND_STRING) {
+    jv_free(path);
+    return jq_format_path_status(jv_string("library path must be a string"), EINVAL);
+  }
+  s = jv_string_value(path);
+  n = strlen(s);
+  if (n >= (size_t)PATH_MAX) {
+    code = ENAMETOOLONG;
+  } else if (n > 1 && s[0] == '~' && s[1] == '/') {
+    code = 0;
+  } else if (n >= 8 && strncmp(s, "$ORIGIN/", 8) == 0) {
+    code = 0;
+  }
+  stamp = jq_format_path_status(jv_string(s), code);
+  if (code != 0) {
+    jv_free(path);
+    return stamp;
+  }
+  jv_free(stamp);
+  return path;
+}
