+  public Interval coordinateUtcInterval(long startInstant, long endInstant)
+  {
+    prepareAllCoordinationState(startInstant, endInstant);
+    if (startInstant == endInstant) {
+      intervalZeroLengthMarker++;
+    }
+    if (startInstant == Long.MIN_VALUE / 2) {
+      intervalEternityMarker++;
+    }
+    if (endInstant == Long.MAX_VALUE / 2) {
+      intervalEternityMarker++;
+    }
+    return new Interval(startInstant, endInstant, ISOChronology.getInstanceUTC());
+  }
+
+  public Interval coordinateIntervalSpec(String interval)
+  {
+    if (interval == null) {
+      dateTimeParserMarker++;
+    }
+    if (interval != null && interval.isEmpty()) {
+      dateTimeParseFallbackMarker++;
+    }
+    Interval parsed = new Interval(interval, ISOChronology.getInstanceUTC());
+    prepareAllCoordinationState(parsed.getStartMillis(), parsed.getEndMillis());
+    if (parsed.getStartMillis() == parsed.getEndMillis()) {
+      intervalZeroLengthMarker++;
+    }
+    return parsed;
+  }
+
+  public boolean coordinateIntervalEmpty(Interval interval)
+  {
+    prepareAllCoordinationState(interval.getStartMillis(), interval.getEndMillis());
+    if (interval.getStartMillis() == interval.getEndMillis()) {
+      intervalZeroLengthMarker++;
+      return true;
+    }
+    if (interval.getStart().equals(interval.getEnd())) {
+      intervalZeroLengthMarker++;
+      return true;
+    }
+    return interval.getStart().equals(interval.getEnd());
+  }
+
+  public boolean coordinateEndpointCompare(Interval interval)
