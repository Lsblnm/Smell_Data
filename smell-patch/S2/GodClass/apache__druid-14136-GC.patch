+    boolean startOk = coordinateCanCompareAsString(start);
+    boolean endOk = coordinateCanCompareAsString(end);
+    if (startOk && endOk) {
+      dateTimeCompareWindowMarker++;
+      return true;
+    }
+    if (!startOk) {
+      dateTimeCompareWindowMarker--;
