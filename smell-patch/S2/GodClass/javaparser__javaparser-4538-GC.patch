+    public static Optional<BaseNodeMetaModel> lookupNodeMetaModel(Class<?> c) {
+        for (BaseNodeMetaModel candidate : JavaParserMetaModel.getNodeMetaModels()) {
+            if (candidate.getTypeName().equals(c.getSimpleName())) {
+                return Optional.of(candidate);
+            }
+        }
+        return Optional.empty();
+    }
