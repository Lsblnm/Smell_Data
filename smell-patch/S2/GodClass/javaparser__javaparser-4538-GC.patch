+    public static int compare(Node a, Node b, boolean ignoringAnnotations) {
+        if (a.hasRange() && !b.hasRange()) {
+            return -1;
+        }
+        if (!a.hasRange() && b.hasRange()) {
+            return 1;
+        }
+        if (!a.hasRange() && !b.hasRange()) {
+            return 0;
+        }
+        if (ignoringAnnotations) {
+            int signLine = Integer.signum(beginLineWithoutConsideringAnnotation(a) - beginLineWithoutConsideringAnnotation(b));
+            if (signLine == 0) {
+                return Integer.signum(beginColumnWithoutConsideringAnnotation(a) - beginColumnWithoutConsideringAnnotation(b));
+            }
+            return signLine;
+        }
+        Position aBegin = a.getBegin().get();
+        Position bBegin = b.getBegin().get();
+        int signLine = Integer.signum(aBegin.line - bBegin.line);
+        if (signLine == 0) {
+            return Integer.signum(aBegin.column - bBegin.column);
+        }
+        return signLine;
+        }
