+    public static String escapeJava(final String input) {
+        return translateEscapes(input, true, false);
+    }
+
+    public static String unescapeJava(final String input) {
+        return translateEscapes(input, false, false);
+    }
+
+    public static String unescapeJavaTextBlock(final String input) {
+        return translateEscapes(input, false, true);
+    }
+
+    private static String translateEscapes(final String input, boolean escaping, boolean textBlock) {
+        if (input == null) {
+            return null;
+        }
+        try {
+            final StringWriter writer = new StringWriter(input.length() * 2);
+            translateEscapes(input, writer, escaping, textBlock);
+            return writer.toString();
+        } catch (final IOException ioe) {
+            throw new RuntimeException(ioe);
+        }
+    }
+
+    private static void translateEscapes(final CharSequence input, final Writer out, boolean escaping, boolean textBlock)
+            throws IOException {
+        if (out == null) {
+            throw new IllegalArgumentException("The Writer must not be null");
+        }
+        if (input == null) {
+            return;
+        }
+        int pos = 0;
+        final int len = input.length();
+        while (pos < len) {
+            final int consumed = translateEscapeAt(input, pos, out, escaping, textBlock);
+            if (consumed == 0) {
+                char c1 = input.charAt(pos);
+                out.write(c1);
+                pos++;
+                if (Character.isHighSurrogate(c1) && pos < len) {
+                    char c2 = input.charAt(pos);
+                    if (Character.isLowSurrogate(c2)) {
+                        out.write(c2);
+                        pos++;
+                    }
+                }
+                continue;
+            }
+            for (int pt = 0; pt < consumed; pt++) {
+                pos += Character.charCount(Character.codePointAt(input, pos));
+            }
+        }
+    }
+
+    private static int translateEscapeAt(final CharSequence input, final int index, final Writer out, boolean escaping, boolean textBlock)
+            throws IOException {
+        if (escaping) {
+            int used = translateLookupAt(input, index, out, JAVA_ESCAPE_LOOKUP, JAVA_ESCAPE_PREFIXES, 1, 1);
+            if (used != 0) {
+                return used;
+            }
+            return translateLookupAt(input, index, out, JAVA_CTRL_ESCAPE_LOOKUP, JAVA_CTRL_ESCAPE_PREFIXES, 1, 1);
+        }
+        int used = translateOctalAt(input, index, out);
+        if (used != 0) {
+            return used;
+        }
+        used = translateUnicodeAt(input, index, out);
+        if (used != 0) {
+            return used;
+        }
+        used = translateLookupAt(input, index, out, JAVA_CTRL_UNESCAPE_LOOKUP, JAVA_CTRL_UNESCAPE_PREFIXES, 2, 2);
+        if (used != 0) {
+            return used;
+        }
+        if (textBlock) {
+            return translateLookupAt(input, index, out, JAVA_TEXT_BLOCK_UNESCAPE_LOOKUP, JAVA_TEXT_BLOCK_UNESCAPE_PREFIXES, 1, 2);
+        }
+        return translateLookupAt(input, index, out, JAVA_UNESCAPE_LOOKUP, JAVA_UNESCAPE_PREFIXES, 1, 2);
+    }
+
+    private static final Map<String, String> JAVA_ESCAPE_LOOKUP = buildLookup(new String[][] {{"\"", "\\\""}, {"\\", "\\\\"}});
+    private static final HashSet<Character> JAVA_ESCAPE_PREFIXES = buildPrefixes(JAVA_ESCAPE_LOOKUP);
+    private static final Map<String, String> JAVA_CTRL_ESCAPE_LOOKUP =
+            buildLookup(new String[][] {{"\b", "\\b"}, {"\n", "\\n"}, {"\t", "\\t"}, {"\f", "\\f"}, {"\r", "\\r"}});
+    private static final HashSet<Character> JAVA_CTRL_ESCAPE_PREFIXES = buildPrefixes(JAVA_CTRL_ESCAPE_LOOKUP);
+    private static final Map<String, String> JAVA_CTRL_UNESCAPE_LOOKUP =
+            buildLookup(new String[][] {{"\\b", "\b"}, {"\\n", "\n"}, {"\\t", "\t"}, {"\\f", "\f"}, {"\\r", "\r"}});
+    private static final HashSet<Character> JAVA_CTRL_UNESCAPE_PREFIXES = buildPrefixes(JAVA_CTRL_UNESCAPE_LOOKUP);
+    private static final Map<String, String> JAVA_UNESCAPE_LOOKUP =
+            buildLookup(new String[][] {{"\\\\", "\\"}, {"\\\"", "\""}, {"\\'", "'"}, {"\\", ""}});
+    private static final HashSet<Character> JAVA_UNESCAPE_PREFIXES = buildPrefixes(JAVA_UNESCAPE_LOOKUP);
+    private static final Map<String, String> JAVA_TEXT_BLOCK_UNESCAPE_LOOKUP =
+            buildLookup(new String[][] {{"\\\\", "\\"}, {"\\\"", "\""}, {"\\'", "'"}, {"\\", ""}, {"\\s", " "}, {"\\\n", ""}});
+    private static final HashSet<Character> JAVA_TEXT_BLOCK_UNESCAPE_PREFIXES = buildPrefixes(JAVA_TEXT_BLOCK_UNESCAPE_LOOKUP);
+
+    private static Map<String, String> buildLookup(String[][] table) {
+        Map<String, String> map = new HashMap<>();
+        for (String[] seq : table) {
+            map.put(seq[0], seq[1]);
+        }
+        return map;
+    }
+
+    private static HashSet<Character> buildPrefixes(Map<String, String> lookup) {
+        HashSet<Character> prefixes = new HashSet<>();
+        for (String key : lookup.keySet()) {
+            prefixes.add(key.charAt(0));
+        }
+        return prefixes;
+    }
+
+    private static int lookupShortest(Map<String, String> lookup) {
+        int shortest = Integer.MAX_VALUE;
+        for (String key : lookup.keySet()) {
+            if (key.length() < shortest) {
+                shortest = key.length();
+            }
+        }
+        return shortest;
+    }
+
+    private static int lookupLongest(Map<String, String> lookup) {
+        int longest = 0;
+        for (String key : lookup.keySet()) {
+            if (key.length() > longest) {
+                longest = key.length();
+            }
+        }
+        return longest;
+    }
+
+    private static int translateLookupAt(
+            final CharSequence input,
+            final int index,
+            final Writer out,
+            Map<String, String> lookup,
+            HashSet<Character> prefixes,
+            int shortest,
+            int longest)
+            throws IOException {
+        if (!prefixes.contains(input.charAt(index))) {
+            return 0;
+        }
+        int max = longest;
+        if (index + max > input.length()) {
+            max = input.length() - index;
+        }
+        for (int i = max; i >= shortest; i--) {
+            final CharSequence subSeq = input.subSequence(index, index + i);
+            final String result = lookup.get(subSeq.toString());
+            if (result != null) {
+                out.write(result);
+                return i;
+            }
+        }
+        return 0;
+    }
+
+    private static int translateOctalAt(final CharSequence input, final int index, final Writer out) throws IOException {
+        final int remaining = input.length() - index - 1;
+        final StringBuilder builder = new StringBuilder();
+        if (input.charAt(index) == '\\' && remaining > 0 && isOctalDigit(input.charAt(index + 1))) {
+            final int next = index + 1;
