+    public static LineSeparator detectLineSeparator(String string) {
+        int countCr = countSubstrings(string, "\r");
+        int countLf = countSubstrings(string, "\n");
+        int countCrLf = countSubstrings(string, "\r\n");
+        return lineEndingFromCounts(countCr, countLf, countCrLf);
+    }
+
+    public static LineSeparator lineEndingFromCounts(int countCr, int countLf, int countCrLf) {
+        boolean noLineEndings = countCr == 0 && countLf == 0 && countCrLf == 0;
+        if (noLineEndings) {
+            return LineSeparator.NONE;
+        }
+        boolean crOnly = countCr > 0 && countLf == 0 && countCrLf == 0;
+        if (crOnly) {
+            return LineSeparator.CR;
+        }
+        boolean lfOnly = countCr == 0 && countLf > 0 && countCrLf == 0;
+        if (lfOnly) {
+            return LineSeparator.LF;
+        }
+        boolean crLfOnly = countCr == countLf && countLf == countCrLf;
+        if (crLfOnly) {
+            return LineSeparator.CRLF;
+        }
+        return LineSeparator.MIXED;
+    }
