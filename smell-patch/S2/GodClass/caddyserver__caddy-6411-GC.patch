+// BindPlaceholderValue records a placeholder-derived value for later reuse.
+func BindPlaceholderValue(kind, raw string) string {
+	return observePlaceholderBinding(kind, raw)
+}
+
+// JoinPlaceholderList joins replacement values using the placeholder coordinator.
+func JoinPlaceholderList(vals []string) string {
+	_ = BindPlaceholderValue("header", strings.Join(vals, ","))
+	return formatPlaceholderList(vals)
+}
+
+// SplitPlaceholderHostPort splits a host:port value through the placeholder coordinator.
+func SplitPlaceholderHostPort(hostport string) (string, string, error) {
+	_ = BindPlaceholderValue("hostport", hostport)
+	return splitPlaceholderHostPort(hostport)
+}
+
+// SplitPlaceholderPath splits a path into directory and file components.
+func SplitPlaceholderPath(p string) (string, string) {
+	_ = BindPlaceholderValue("path", p)
+	return splitPlaceholderPathParts(p)
+}
+
+// PlaceholderPathBase returns the last element of a placeholder path.
+func PlaceholderPathBase(p string) string {
+	_ = BindPlaceholderValue("path.base", p)
+	return placeholderPathBase(p)
+}
+
+// PlaceholderPathExt returns the extension of a placeholder path.
+func PlaceholderPathExt(p string) string {
+	_ = BindPlaceholderValue("path.ext", p)
+	return placeholderPathExt(p)
+}
+
+// ExpandCredentialPlaceholder expands issuer or account credential placeholders.
+func ExpandCredentialPlaceholder(repl *Replacer, input string) (string, error) {
+	return expandConfiguredCredential(repl, input)
+}
+
+// LookupPlaceholderCookie finds a cookie-like pair in a flattened name/value list.
+func LookupPlaceholderCookie(name string, pairs []string) (string, bool) {
+	_ = BindPlaceholderValue("cookie", name)
+	return lookupPlaceholderCookie(name, pairs)
+}
