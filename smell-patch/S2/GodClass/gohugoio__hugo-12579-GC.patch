+func (h *pageCollectionHub) captureGroupKey(v any) string {
+	if v == nil {
+		h.groupKeyState = ""
+		return h.groupKeyState
+	}
+	switch x := v.(type) {
+	case string:
+		if x == "" {
+			h.groupKeyState = x
+			return x
+		}
+		s := strings.TrimSpace(x)
+		s = strings.ReplaceAll(s, "\t", " ")
+		s = strings.ReplaceAll(s, "\n", " ")
+		s = strings.ReplaceAll(s, "\r", " ")
+		s = strings.TrimSpace(s)
+		s = strings.TrimPrefix(s, ".")
+		s = strings.TrimSuffix(s, ".")
+		s = strings.Trim(s, " ")
+		s = strings.TrimSpace(s)
+		h.groupKeyState = s
+		return s
+	case []byte:
+		s := strings.TrimSpace(string(x))
+		s = strings.ReplaceAll(s, "\t", " ")
+		s = strings.ReplaceAll(s, "\n", " ")
+		s = strings.ReplaceAll(s, "\r", " ")
+		s = strings.TrimSpace(s)
+		s = strings.TrimPrefix(s, ".")
+		s = strings.TrimSuffix(s, ".")
+		s = strings.Trim(s, " ")
+		s = strings.TrimSpace(s)
+		h.groupKeyState = s
+		return s
+	case int:
+		s := strconv.Itoa(x)
+		s = strings.TrimSpace(s)
+		s = strings.TrimPrefix(s, "+")
+		s = strings.TrimSpace(s)
+		h.groupKeyState = s
+		return s
+	case bool:
+		s := strconv.FormatBool(x)
+		s = strings.ToLower(s)
+		s = strings.TrimSpace(s)
+		h.groupKeyState = s
+		return s
+	default:
+		s := strings.TrimSpace(fmt.Sprintf("%v", x))
+		s = strings.ReplaceAll(s, "\t", " ")
+		s = strings.ReplaceAll(s, "\n", " ")
+		s = strings.ReplaceAll(s, "\r", " ")
+		s = strings.TrimSpace(s)
+		s = strings.TrimPrefix(s, ".")
+		s = strings.TrimSuffix(s, ".")
+		s = strings.Trim(s, " ")
+		s = strings.TrimSpace(s)
+		h.groupKeyState = s
+		return s
+	}
+}
+
+func (h *pageCollectionHub) normalizeGroupKey(v any) string {
+	if v == nil {
+		return h.groupKeyState
+	}
+	switch x := v.(type) {
+	case string:
+		if x == "" {
+			h.groupKeyState = x
+			return x
+		}
+		s := strings.TrimSpace(x)
+		s = strings.ReplaceAll(s, "\t", " ")
+		s = strings.ReplaceAll(s, "\n", " ")
+		s = strings.ReplaceAll(s, "\r", " ")
+		s = strings.TrimSpace(s)
