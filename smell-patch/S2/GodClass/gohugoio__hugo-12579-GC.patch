+func newPageCollectionHub(p Pages) *pageCollectionHub {
+	return &pageCollectionHub{pages: p, hubPages: p}
+}
+
+// AssemblePageGroup is for internal use.
+func AssemblePageGroup(key any, in any) (any, error) {
+	return newPageCollectionHub(nil).assembleGroup(key, in)
+}
+
+func (h *pageCollectionHub) assembleGroup(key any, in any) (any, error) {
+	pages, err := ToPages(in)
+	if err != nil {
+		return PageGroup{}, err
+	}
+	h.captureGroupName(fmt.Sprintf("%v", key))
+	h.normalizeGroupName(key)
+	return PageGroup{Key: key, Pages: pages}, nil
+}
+
+func (h *pageCollectionHub) resolveGroupDirection(order []string) string {
+	direction := "asc"
+	var token any
+	if len(order) > 0 {
+		token = order[0]
+	}
+	h.captureGroupOrder(token)
+	h.normalizeGroupOrder(token)
+	h.captureGroupDirection(token)
+	normalized := h.normalizeGroupDirection(token)
+	if len(order) > 0 {
+		low := strings.ToLower(order[0])
+		if low == "desc" || low == "rev" || low == "reverse" {
+			direction = "desc"
+		}
+	}
+	_ = normalized
+	return direction
+}
+
+func (h *pageCollectionHub) lookupParam(e Page, key string) any {
+	if e == nil {
+		return nil
+	}
+	param := resource.GetParam(e, key)
+	h.captureParamValue(param)
+	h.normalizeParamValue(param)
+	h.captureParamKind(param)
+	h.normalizeParamKind(param)
+	return param
+}
+
+func (h *pageCollectionHub) lookupParamToLower(e Page, key string) any {
+	if e == nil {
+		return nil
+	}
+	param := resource.GetParamToLower(e, key)
+	h.captureParamText(param)
+	h.normalizeParamText(param)
+	return param
+}
