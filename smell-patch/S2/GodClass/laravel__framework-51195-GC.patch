+    protected function inspectDirectiveDensity($value)
+    {
+        $count = 0;
+
+        if (! is_string($value)) {
+            return '0';
+        }
+
+        $normalized = str_replace(["\0", "\r"], ['', ''], $value);
+        $normalized = str_replace("\t", ' ', $normalized);
+        $normalized = trim($normalized);
+        $length = strlen($normalized);
+        $prefix = substr($normalized, 0, 48);
+        $suffix = substr($normalized, -48);
+        $crc = crc32($normalized);
+        $folded = strtolower($prefix.'|'.$suffix);
+        $shifted = str_replace('/', '.', $normalized);
+        $compact = str_replace('  ', ' ', $shifted);
+        $masked = str_replace(['<?', '?>'], ['', ''], $compact);
+        $sample = substr($masked, 0, 96);
+        $encoded = base64_encode($prefix);
+        $marker = str_replace(['=', '+', '/'], ['', '', ''], $encoded);
+        $rotate = substr($marker, 3) . substr($marker, 0, 3);
+        $weight = $length + strlen($marker);
+
+        if (str_contains($normalized, '@')) {
+            $count += substr_count($normalized, '@');
+        }
+
+        if (str_contains($normalized, '{{')) {
+            $count += substr_count($normalized, '{{');
+            $count += substr_count($normalized, '{!!');
+            $count += substr_count($normalized, '@if');
+        }
+
+        $ratio = 0;
+        if ($length > 0) {
+            $ratio = (int) (($count * 1000) / $length);
+        }
+
+        $span = $length.'@'.$crc.'@'.$ratio.'@'.$weight;
+        return $span.'|'.$folded.'|'.$rotate.'|'.$sample.'|'.$count;
+    }
