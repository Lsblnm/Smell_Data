+    public function compileTaggedComponentTree($value, array $aliases = [], array $namespaces = [])
+    {
+        $this->activeComponentAliases = $aliases;
+        $this->activeComponentNamespaces = $namespaces;
+        $value = $this->compileSlots($value);
+
+        return $this->compileTags($value);
+    }
