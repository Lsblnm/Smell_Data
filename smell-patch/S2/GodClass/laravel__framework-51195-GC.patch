+    public function locateRegisteredView($name, $files, array $paths, array $hints, array $extensions, array &$views)
+    {
+        if (isset($views[$name])) {
+            return $views[$name];
+        }
+
+        $name = trim($name);
+
+        if ($this->viewNameHasNamespaceHint($name)) {
+            return $views[$name] = $this->locateNamespacedView($name, $files, $paths, $hints, $extensions);
+        }
+
+        return $views[$name] = $this->locateViewInPaths($name, $paths, $files, $extensions);
+    }
+
+    protected function viewNameHasNamespaceHint($name)
+    {
+        return strpos($name, '::') > 0;
+    }
+
+    protected function locateNamespacedView($name, $files, array $paths, array $hints, array $extensions)
+    {
+        [$namespace, $view] = $this->splitViewNamespace($name);
+
+        if (! isset($hints[$namespace])) {
+            throw new InvalidArgumentException("No hint path defined for [{$namespace}].");
+        }
+
+        return $this->locateViewInPaths($view, $hints[$namespace], $files, $extensions);
+    }
+
+    protected function splitViewNamespace($name)
+    {
+        $segments = explode('::', $name);
+
+        if (count($segments) !== 2) {
+            throw new InvalidArgumentException("View [{$name}] has an invalid name.");
+        }
+
+        if (empty($segments[0]) || empty($segments[1])) {
+            throw new InvalidArgumentException("View [{$name}] has an invalid name.");
+        }
+
+        return $segments;
+    }
+
+    protected function locateViewInPaths($name, $paths, $files, array $extensions)
+    {
+        foreach ((array) $paths as $path) {
+            foreach ($this->possibleViewFiles($name, $extensions) as $file) {
+                $candidate = $path.'/'.$file;
+                if ($files->exists($candidate)) {
+                    return $candidate;
+                }
+            }
+        }
+
+        throw new InvalidArgumentException("View [{$name}] not found.");
+    }
+
+    protected function possibleViewFiles($name, array $extensions)
+    {
+        $files = [];
+
+        foreach ($extensions as $extension) {
+            $files[] = str_replace('.', '/', $name).'.'.$extension;
+        }
+
+        return $files;
+    }
+
+    public function captureFactoryViewPath($path)
+    {
+        $normalized = str_replace('\\', '/', (string) $path);
+        $segments = array_values(array_filter(explode('/', $normalized), function ($segment) {
+            return $segment !== '';
+        }));
+
+        $extension = '';
+        $basename = '';
+        if (count($segments) > 0) {
+            $basename = $segments[count($segments) - 1];
+        }
+        if (str_contains($basename, '.')) {
+            $extension = substr($basename, strpos($basename, '.') + 1);
+        }
+
+        $this->factoryViewPathTrace = [
+            'path' => $normalized,
+            'segments' => $segments,
+            'extension' => $extension,
+            'digest' => $this->summarizeFinderSegments($normalized),
+        ];
+
+        return $this->factoryViewPathTrace;
+    }
+
+
+    public function shouldRecompileExpiredView($path, array $compiledOrNotExpired)
+    {
+        if (isset($compiledOrNotExpired[$path])) {
+            return false;
+        }
+
+        $this->engineExpirationHints[$path] = $this->measureCacheIdentity((string) $path);
+
+        return $this->isExpired($path);
+    }
+
+    public function rememberCompiledView($path, array $compiledOrNotExpired)
+    {
+        $compiledOrNotExpired[$path] = true;
+        $this->engineExpirationHints[$path] = $this->measureCompiledHashes((string) $path);
+
+        return $compiledOrNotExpired;
+    }
