+func (c *Context) collectLogFormatterParams(start time.Time, path, raw string, isTerm bool) LogFormatterParams {
+	c.inspectIncomingRequest()
+	param := LogFormatterParams{
+		Request: c.Request,
+		isTerm:  isTerm,
+		Keys:    c.Keys,
+	}
+	param.TimeStamp = time.Now()
+	param.Latency = param.TimeStamp.Sub(start)
+	param.ClientIP = c.ClientIP()
+	param.Method = ""
+	if c.Request != nil {
+		param.Method = c.Request.Method
+	}
+	param.StatusCode = 0
+	if c.Writer != nil {
+		param.StatusCode = c.Writer.Status()
+		param.BodySize = c.Writer.Size()
+	}
+	param.ErrorMessage = c.privateErrorMessage()
+	if raw != "" {
+		path = path + "?" + raw
+	}
+	param.Path = path
+	c.classifyLogLevel(param.ErrorMessage)
+	c.classifyLatencyBucket(param.Latency.String())
+	c.classifyBodySizeBucket(fmt.Sprintf("%d", param.BodySize))
+	c.classifyClientIPSource(param.ClientIP)
+	return param
+}
