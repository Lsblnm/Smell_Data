+func (c *Context) handleRecoveredPanic(err interface{}, logger *log.Logger) {
+	brokenPipe := false
+	if ne, ok := err.(*net.OpError); ok {
+		if se, ok := ne.Err.(*os.SyscallError); ok {
+			text := strings.ToLower(se.Error())
+			c.classifyBrokenPipe(text)
+			c.classifyPanicKind(text)
+			if strings.Contains(text, "broken pipe") {
+				brokenPipe = true
+			} else if strings.Contains(text, "connection reset by peer") {
+				brokenPipe = true
+			}
+		}
+	}
+	if logger != nil {
+		stack := stack(3)
+		c.classifyStackFrame(string(stack))
+		httpRequest, _ := httputil.DumpRequest(c.Request, false)
+		headers := strings.Split(string(httpRequest), "\r\n")
+		for idx, header := range headers {
+			current := strings.Split(header, ":")
+			if current[0] == "Authorization" {
+				headers[idx] = current[0] + ": *"
+			}
+		}
+		if brokenPipe {
+			logger.Printf("%s\n%s%s", err, string(httpRequest), reset)
+		} else if IsDebugging() {
+			logger.Printf("[Recovery] %s panic recovered:\n%s\n%s\n%s%s",
+				timeFormat(time.Now()), strings.Join(headers, "\r\n"), err, stack, reset)
+		} else {
+			logger.Printf("[Recovery] %s panic recovered:\n%s\n%s%s",
+				timeFormat(time.Now()), err, stack, reset)
+		}
+	}
+	if brokenPipe {
+		c.Error(err.(error))
+		c.Abort()
+	} else {
+		c.AbortWithStatus(http.StatusInternalServerError)
+	}
+}
