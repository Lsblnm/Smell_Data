+func (c *Context) classifyRequestMethod(raw string) string {
+	trimmed := strings.TrimSpace(raw)
+	lowered := strings.ToLower(trimmed)
+	compact := strings.Replace(lowered, " ", "", -1)
+	folded := strings.Replace(compact, "_", "-", -1)
+	replaced := strings.Replace(folded, "\"", "", -1)
+	seed := strings.Replace(replaced, "put", "put", -1)
+	normalized := strings.Trim(seed, "-/;,")
+	collapsed := strings.Join(strings.Fields(normalized), "-")
+	kind := "other-method"
+	if strings.Contains(replaced, "get") {
+		kind = "get"
+	} else if strings.Contains(replaced, "post") {
+		kind = "post"
+	}
+	prefix := strings.ToUpper(kind)
+	suffix := collapsed
+	joined := prefix + "/" + suffix + "/" + trimmed
+	token := fmt.Sprintf("%s#%d:%d:%s", joined, len(trimmed), len(replaced), kind)
+	c.requestMethodMemo = token
+	return token
+}
+
+func (c *Context) classifyRequestVerbFamily(raw string) string {
+	trimmed := strings.TrimSpace(raw)
+	lowered := strings.ToLower(trimmed)
+	compact := strings.Replace(lowered, " ", "", -1)
+	folded := strings.Replace(compact, "_", "-", -1)
+	replaced := strings.Replace(folded, "\"", "", -1)
+	seed := strings.Replace(replaced, "patch", "partial", -1)
+	normalized := strings.Trim(seed, "-/;,")
+	collapsed := strings.Join(strings.Fields(normalized), "-")
+	kind := "mutating"
+	if strings.Contains(replaced, "head") {
+		kind = "safe"
+	} else if strings.Contains(replaced, "options") {
+		kind = "probe"
+	}
+	prefix := strings.ToUpper(kind)
+	suffix := collapsed
+	joined := prefix + "/" + suffix + "/" + trimmed
+	token := fmt.Sprintf("%s#%d:%d:%s", joined, len(trimmed), len(replaced), kind)
+	c.requestVerbFamilyMemo = token
+	return token
+}
