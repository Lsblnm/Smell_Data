+static void jq_cli_session_capture_life(struct jq_cli_session *s, int a, int b, int c, const char *text) {
+  s->life_boot = a;
+  s->life_halt = b;
+  s->life_epoch = c;
+  s->life_rc = a ^ b;
+  if (text != NULL) {
+    s->life_len = (int)strlen(text);
+  } else {
+    s->life_len = 0;
+  }
