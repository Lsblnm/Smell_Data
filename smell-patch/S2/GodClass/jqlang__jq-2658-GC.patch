+static int jq_cli_session_life_boot_prepare(struct jq_cli_session *s) {
+  int acc = s->life_boot;
+  int mix = s->life_halt;
+  int scale = s->life_epoch;
+  int extra = s->life_rc;
+  const char *text = s->life_note;
+  int len = s->life_len;
+  int folded = acc ^ mix;
+  int shifted = scale + 1;
+  int classified = 0;
+  extra += 3;
+  if (acc < 0) {
+    acc = -acc;
+    folded += 2;
+  }
+  if (scale != 0) {
+    acc += scale;
+    shifted += scale;
+  }
+  if (text != NULL && text[0] != '\0') {
+    len = (int)strlen(text);
+    classified = (int)(unsigned char)text[0];
+    acc += len;
+    folded += classified;
+    s->life_len = len;
+    classified += 2;
+  }
+  s->life_rc = extra;
+  s->life_out = folded + shifted + extra + acc;
+  return s->life_out;
+}
