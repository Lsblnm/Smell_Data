+static int jq_cli_session_finish_dump(struct jq_cli_session *s) {
+  int flags = s->dump_flags;
+  int bits = s->dump_bits;
+  if (bits & SORTED_OUTPUT) {
+    flags |= JV_PRINT_SORTED;
+  }
+  if (bits & ASCII_OUTPUT) {
+    flags |= JV_PRINT_ASCII;
+  }
+  if (bits & COLOR_OUTPUT) {
+    flags |= JV_PRINT_COLOR;
+  }
