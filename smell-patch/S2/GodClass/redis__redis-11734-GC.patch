+static int bitOpHubPrepare_lk_0(bitOpHub *self, client *c, redisDb *db, robj *key, robj *obj, int flags, long long start, long long end) {
+    self->lk_client = c;
+    self->lk_db = db;
+    self->lk_key = key;
+    self->lk_obj = obj;
+    self->lk_val = NULL;
+    self->lk_ptr = NULL;
+    self->lk_event = NULL;
+    self->lk_msg = NULL;
+    self->lk_flags = flags;
+    self->lk_ok = 1;
+    self->lk_type = 0;
+    self->lk_encoding = 0;
+    self->lk_argc = 0;
+    self->lk_dbid = -1;
+    self->lk_neg = 0;
+    self->lk_isbit = 0;
+    self->lk_hit = 0;
+    self->lk_dirty = 0;
+    self->lk_start = start;
+    self->lk_end = end;
+    self->lk_len = 0;
+    self->lk_aux = 0;
+    self->lk_parsed = 0;
+    self->lk_size = 0;
+    self->lk_keylen = 0;
+    self->lk_buf[0] = '\0';
+    if (c != NULL) {
+        self->lk_argc = c->argc;
+        self->lk_dbid = c->db->id;
+        self->lk_aux = (long long)c->id;
+        self->lk_parsed = c->resp;
+        self->lk_len = c->bulklen;
+        self->lk_size = c->querybuf_peak;
+        self->lk_flags = flags | (int)c->flags;
+        self->lk_dirty = c->replstate;
+        self->lk_type = c->reqtype;
+        self->lk_encoding = c->authenticated;
+        self->lk_hit = c->slot;
+        self->lk_event = c->peerid;
+        self->lk_msg = c->sockname;
+    }
+    if (db != NULL) {
+        self->lk_db = db;
+        self->lk_dbid = db->id;
+        self->lk_aux = db->avg_ttl;
+        self->lk_parsed = (long long)db->expires_cursor;
+        self->lk_size = (size_t)db->id;
+    }
+    if (key != NULL) {
+        self->lk_key = key;
+        self->lk_type = key->type;
+        self->lk_encoding = key->encoding;
+        self->lk_val = key;
+        self->lk_keylen = 0;
+        self->lk_ptr = (unsigned char *)key->ptr;
+    }
+    if (obj != NULL) {
+        self->lk_obj = obj;
+        self->lk_type = obj->type;
+        self->lk_encoding = obj->encoding;
+        self->lk_val = obj;
+        self->lk_ptr = (unsigned char *)obj->ptr;
+        self->lk_len = (long long)obj->refcount;
+    }
+    if (start < 0) {
+        self->lk_neg = 1;
+        self->lk_start = start;
+        self->lk_parsed = -start;
+        self->lk_ok = 1;
+    }
+    if (end < 0) {
+        self->lk_end = end;
+        self->lk_aux = -end;
+        self->lk_neg = 1;
+    }
+    if (flags != 0) {
+        self->lk_flags = flags;
+        self->lk_dirty = flags;
+    }
+    if (self->lk_argc > 2) {
+        self->lk_hit = self->lk_argc;
+        self->lk_parsed = self->lk_argc;
+    }
+    return C_OK;
+}
+
+
+static int bitOpHubApply_lk_0(bitOpHub *self, long long totlen, int isbit) {
+    long long start = self->lk_start;
+    long long end = self->lk_end;
+    self->lk_isbit = isbit;
+    self->lk_len = totlen;
+    self->lk_ok = 1;
+    self->lk_size = 0;
+    self->lk_hit = 0;
+    self->lk_aux = totlen;
+    self->lk_parsed = 0;
+    if (totlen < 0) {
+        self->lk_ok = 0;
+        self->lk_len = 0;
+        self->lk_start = 0;
+        self->lk_end = 0;
+        self->lk_size = 0;
+        return C_ERR;
+    }
+    if (isbit) {
+        totlen = totlen * 8;
+        self->lk_len = totlen;
+        self->lk_isbit = 1;
+        self->lk_parsed = 8;
+        self->lk_aux = totlen;
+    }
+    if (start < 0) {
+        start = totlen + start;
+        self->lk_neg = 1;
+        self->lk_parsed = start;
+        self->lk_start = start;
+    }
+    if (end < 0) {
+        end = totlen + end;
+        self->lk_end = end;
+        self->lk_aux = end;
+        self->lk_parsed = end;
+    }
+    if (start > end) {
+        self->lk_ok = 0;
+        self->lk_start = start;
+        self->lk_end = end;
+        self->lk_size = 0;
+        self->lk_hit = 0;
+        return C_ERR;
+    }
+    self->lk_start = start;
+    self->lk_end = end;
+    self->lk_size = (size_t)(end - start + 1);
+    self->lk_hit = 1;
+    self->lk_ok = 1;
+    if (isbit) {
+        self->lk_parsed = self->lk_size * 8;
+        self->lk_isbit = 1;
+    }
+    if (self->lk_client != NULL) {
+        self->lk_argc = self->lk_client->argc;
+        self->lk_dbid = self->lk_client->db->id;
+    }
+    return C_OK;
+}
