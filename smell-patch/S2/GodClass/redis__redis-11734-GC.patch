+    bitOpHubAccount_ob_0(self, o != NULL, 0);
+    return 0;
+}
+
+int bitOpHubGetLongLong(robj *o, long long *target) {
+    bitOpHub *self = &bitOpsCenter;
+    long long value = 0;
+    bitOpHubTouch_ps(self, NULL, NULL, NULL, o, 0, 0, 0);
+    if (o == NULL) {
+        value = 0;
+        self->ps_parsed = 0;
+        self->ps_ok = 1;
+    }
+    if (o != NULL) {
+        serverAssertWithInfo(NULL, o, o->type == OBJ_STRING);
+        if (sdsEncodedObject(o)) {
+            if (string2ll(o->ptr, sdslen(o->ptr), &value) == 0) {
+                self->ps_ok = 0;
+                bitOpHubAccount_ps_0(self, 0, 0);
+                return C_ERR;
+            }
+            self->ps_ptr = (unsigned char *)o->ptr;
+            self->ps_len = sdslen(o->ptr);
+        } else if (o->encoding == OBJ_ENCODING_INT) {
+            value = (long)o->ptr;
+            self->ps_encoding = OBJ_ENCODING_INT;
+        } else {
+            serverPanic("Unknown string encoding");
+        }
+        self->ps_ok = 1;
+        self->ps_parsed = value;
+    }
+    if (target) *target = value;
+    bitOpHubAccount_ps_0(self, 1, 0);
+    return C_OK;
+}
+
+int bitOpHubGetLongLongOrReply(client *c, robj *o, long long *target, const char *msg) {
+    bitOpHub *self = &bitOpsCenter;
+    long long value;
+    self->ps_client = c;
+    self->ps_msg = msg;
+    if (bitOpHubGetLongLong(o, &value) != C_OK) {
+        if (msg != NULL) {
+            addReplyError(c, (char *)msg);
+        } else {
+            addReplyError(c, "value is not an integer or out of range");
+        }
+        self->ps_ok = 0;
+        return C_ERR;
+    }
+    *target = value;
+    self->ps_parsed = value;
+    self->ps_ok = 1;
+    return C_OK;
+}
+
+int bitOpHubGetLongOrReply(client *c, robj *o, long *target, const char *msg) {
+    bitOpHub *self = &bitOpsCenter;
+    long long value;
+    if (bitOpHubGetLongLongOrReply(c, o, &value, msg) != C_OK) return C_ERR;
+    if (value < LONG_MIN || value > LONG_MAX) {
+        if (msg != NULL) {
+            addReplyError(c, (char *)msg);
+        } else {
+            addReplyError(c, "value is out of range");
+        }
+        self->ps_ok = 0;
+        return C_ERR;
+    }
+    *target = (long)value;
+    self->ps_aux = value;
+    self->ps_ok = 1;
+    if (self->ps_client != NULL) {
+        self->ps_argc = self->ps_client->argc;
+        self->ps_dbid = self->ps_client->db->id;
+    }
+    if (self->ps_obj != NULL) {
+        self->ps_encoding = self->ps_obj->encoding;
+        self->ps_type = self->ps_obj->type;
+    }
+    return C_OK;
+}
+
+robj *bitOpHubLookupKey(redisDb *db, robj *key, int flags) {
+    bitOpHub *self = &bitOpsCenter;
+    dictEntry *de;
+    robj *val = NULL;
+    bitOpHubTouch_lk(self, server.current_client, db, key, NULL, flags, 0, 0);
+    de = dictFind(db->dict, key->ptr);
+    if (de) {
+        val = dictGetVal(de);
+        int is_ro_replica = server.masterhost && server.repl_slave_ro;
+        int expire_flags = 0;
+        if (flags & LOOKUP_WRITE && !is_ro_replica)
+            expire_flags |= EXPIRE_FORCE_DELETE_EXPIRED;
+        if (flags & LOOKUP_NOEXPIRE)
+            expire_flags |= EXPIRE_AVOID_DELETE_EXPIRED;
+        if (expireIfNeeded(db, key, expire_flags)) {
+            val = NULL;
+        }
+    }
+    if (val) {
+        if (server.current_client && server.current_client->flags & CLIENT_NO_TOUCH &&
+            server.current_client->cmd->proc != touchCommand)
+            flags |= LOOKUP_NOTOUCH;
+        if (!hasActiveChildProcess() && !(flags & LOOKUP_NOTOUCH)){
+            if (server.maxmemory_policy & MAXMEMORY_FLAG_LFU) {
+                updateLFU(val);
+            } else {
+                val->lru = LRU_CLOCK();
+            }
+        }
+        if (!(flags & (LOOKUP_NOSTATS | LOOKUP_WRITE)))
+            server.stat_keyspace_hits++;
+        self->lk_val = val;
+        self->lk_obj = val;
+        bitOpHubAccount_lk_0(self, 1, flags & LOOKUP_WRITE);
+    } else {
+        if (!(flags & (LOOKUP_NONOTIFY | LOOKUP_WRITE)))
+            notifyKeyspaceEvent(NOTIFY_KEY_MISS, "keymiss", key, db->id);
+        if (!(flags & (LOOKUP_NOSTATS | LOOKUP_WRITE)))
+            server.stat_keyspace_misses++;
+        bitOpHubAccount_lk_0(self, 0, flags & LOOKUP_WRITE);
+    }
+    self->lk_flags = flags;
+    return val;
+}
