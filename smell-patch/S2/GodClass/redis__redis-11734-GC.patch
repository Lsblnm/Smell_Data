+
+static void bitOpHubAccount_lk_0(bitOpHub *self, int hit, int dirty) {
+    self->lk_hit = hit;
+    self->lk_dirty = dirty;
+    self->lk_ok = 1;
+    self->lk_aux = self->lk_aux + 1;
+    self->lk_parsed = self->lk_start;
+    if (hit) {
+        self->lk_ok = 1;
+        self->lk_hit = 1;
+        self->lk_flags = self->lk_flags | LOOKUP_NOTOUCH;
+        self->lk_len = self->lk_len;
+        self->lk_size = self->lk_size;
+    }
+    if (dirty) {
+        self->lk_dirty = 1;
