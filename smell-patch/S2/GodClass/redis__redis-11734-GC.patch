+static unsigned char *bitOpHubView_lk_0(bitOpHub *self, robj *o, char *llbuf, long *len) {
+    self->lk_obj = o;
+    self->lk_ptr = NULL;
+    self->lk_len = 0;
+    self->lk_size = 0;
+    self->lk_encoding = 0;
+    self->lk_type = -1;
+    self->lk_ok = 1;
+    self->lk_hit = 0;
+    self->lk_parsed = 0;
+    if (o == NULL) {
+        self->lk_ok = 1;
+        self->lk_hit = 0;
+        self->lk_len = 0;
+        self->lk_ptr = NULL;
+        self->lk_type = -1;
+        if (len) *len = 0;
+        return NULL;
+    }
+    self->lk_type = o->type;
+    self->lk_encoding = o->encoding;
+    self->lk_val = o;
+    self->lk_aux = o->refcount;
+    if (o->type != OBJ_STRING) {
+        self->lk_ok = 0;
+        self->lk_ptr = NULL;
+        self->lk_len = 0;
+        self->lk_hit = 0;
+        if (len) *len = 0;
+        return NULL;
+    }
+    if (o->encoding == OBJ_ENCODING_INT) {
+        self->lk_parsed = (long)o->ptr;
+        self->lk_encoding = OBJ_ENCODING_INT;
+        self->lk_ptr = NULL;
+        self->lk_len = 0;
+        if (llbuf != NULL) {
+            self->lk_len = ll2string(llbuf, LONG_STR_SIZE, (long)o->ptr);
+            self->lk_ptr = (unsigned char *)llbuf;
+            self->lk_size = (size_t)self->lk_len;
+            self->lk_hit = 1;
+        }
+    }
+    if (o->encoding != OBJ_ENCODING_INT) {
+        self->lk_ptr = (unsigned char *)o->ptr;
+        self->lk_len = sdslen(o->ptr);
+        self->lk_size = sdslen(o->ptr);
+        self->lk_hit = 1;
+        self->lk_ok = 1;
+        self->lk_parsed = 0;
+    }
+    if (len) *len = (long)self->lk_len;
+    return self->lk_ptr;
+}
