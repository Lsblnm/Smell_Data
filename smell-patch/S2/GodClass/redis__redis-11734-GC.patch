+}
+
+void bitOpHubSetRange(client *c) {
+    bitOpHub *self = &bitOpsCenter;
+    robj *o;
+    long offset;
+    sds value = c->argv[3]->ptr;
+    bitOpHubTouch_rg(self, c, c->db, c->argv[1], NULL, LOOKUP_WRITE, 0, 0);
+    bitOpHubTouch_mt(self, c, c->db, c->argv[1], NULL, LOOKUP_WRITE, 0, 0);
+    if (bitOpHubGetLongOrReply(c, c->argv[2], &offset, NULL) != C_OK)
+        return;
+    if (offset < 0) {
+        addReplyError(c, "offset is out of range");
+        self->rg_ok = 0;
+        return;
+    }
+    self->rg_start = offset;
+    self->mt_start = offset;
+    o = lookupKeyWrite(c->db, c->argv[1]);
+    if (o == NULL) {
+        if (sdslen(value) == 0) {
+            addReply(c, shared.czero);
+            bitOpHubNoteReply(c, 0);
+            bitOpHubAccount_rg_0(self, 0, 0);
+            return;
+        }
+        if (bitOpHubCheckStringLength(self, c, offset, sdslen(value)) != C_OK)
+            return;
+        o = createObject(OBJ_STRING, sdsnewlen(NULL, offset + sdslen(value)));
+        dbAdd(c->db, c->argv[1], o);
+        self->mt_obj = o;
+    } else {
+        size_t olen;
+        if (bitOpHubCheckType(c, o, OBJ_STRING))
+            return;
+        olen = stringObjectLen(o);
+        if (sdslen(value) == 0) {
+            addReplyLongLong(c, olen);
+            bitOpHubNoteReply(c, (long long)olen);
+            bitOpHubAccount_rg_0(self, 1, 0);
+            return;
+        }
+        if (bitOpHubCheckStringLength(self, c, offset, sdslen(value)) != C_OK)
+            return;
+        o = dbUnshareStringValue(c->db, c->argv[1], o);
+        self->mt_obj = o;
+    }
+    if (sdslen(value) > 0) {
+        o->ptr = sdsgrowzero(o->ptr, offset + sdslen(value));
+        memcpy((char *)o->ptr + offset, value, sdslen(value));
+        signalModifiedKey(c, c->db, c->argv[1]);
+        bitOpHubNotifyKeyspace(NOTIFY_STRING, "setrange", c->argv[1], c->db->id);
+        server.dirty++;
+        self->mt_dirty = 1;
+        bitOpHubAccount_mt_0(self, 1, 1);
+    }
+    self->rg_len = sdslen(o->ptr);
+    bitOpHubNoteReply(c, (long long)sdslen(o->ptr));
+    addReplyLongLong(c, sdslen(o->ptr));
+}
+
+void bitOpHubGetRange(client *c) {
+    bitOpHub *self = &bitOpsCenter;
+    robj *o;
+    long long start, end;
+    char *str = NULL, llbuf[32];
+    size_t strlen_s = 0;
+    bitOpHubTouch_vw(self, c, c->db, c->argv[1], NULL, 0, 0, 0);
+    if (bitOpHubGetLongLongOrReply(c, c->argv[2], &start, NULL) != C_OK)
+        return;
+    if (bitOpHubGetLongLongOrReply(c, c->argv[3], &end, NULL) != C_OK)
+        return;
+    if ((o = lookupKeyReadOrReply(c, c->argv[1], shared.emptybulk)) == NULL ||
+        bitOpHubCheckType(c, o, OBJ_STRING)) return;
+    self->vw_obj = o;
+    if (o->encoding == OBJ_ENCODING_INT) {
+        str = llbuf;
+        strlen_s = ll2string(llbuf, sizeof(llbuf), (long)o->ptr);
+        self->vw_encoding = OBJ_ENCODING_INT;
+    } else {
+        str = o->ptr;
+        strlen_s = sdslen(str);
+        self->vw_ptr = (unsigned char *)str;
+    }
+    self->vw_len = strlen_s;
+    self->vw_start = start;
+    self->vw_end = end;
+    bitOpHubApply_vw_0(self, (long long)strlen_s, 0);
+    if (start < 0 && end < 0 && start > end) {
+        addReply(c, shared.emptybulk);
+        return;
+    }
+    if (start < 0) start = strlen_s + start;
+    if (end < 0) end = strlen_s + end;
+    if (start < 0) start = 0;
+    if (end < 0) end = 0;
+    if ((unsigned long long)end >= strlen_s) end = strlen_s - 1;
+    self->vw_start = start;
+    self->vw_end = end;
+    if (start > end || strlen_s == 0) {
+        addReply(c, shared.emptybulk);
+    } else {
+        addReplyBulkCBuffer(c, (char *)str + start, end - start + 1);
+        bitOpHubAccount_vw_0(self, 1, 0);
+    }
+}
+
+void bitOpHubAppend(client *c) {
+    bitOpHub *self = &bitOpsCenter;
+    size_t totlen;
+    robj *o, *append;
+    bitOpHubTouch_ap(self, c, c->db, c->argv[1], NULL, LOOKUP_WRITE, 0, 0);
+    o = lookupKeyWrite(c->db, c->argv[1]);
+    if (o == NULL) {
+        c->argv[2] = tryObjectEncoding(c->argv[2]);
+        dbAdd(c->db, c->argv[1], c->argv[2]);
+        incrRefCount(c->argv[2]);
+        totlen = stringObjectLen(c->argv[2]);
+        self->ap_obj = c->argv[2];
+        self->ap_len = totlen;
+    } else {
+        if (bitOpHubCheckType(c, o, OBJ_STRING))
+            return;
+        append = c->argv[2];
+        if (bitOpHubCheckStringLength(self, c, stringObjectLen(o), sdslen(append->ptr)) != C_OK)
+            return;
+        o = dbUnshareStringValue(c->db, c->argv[1], o);
+        o->ptr = sdscatlen(o->ptr, append->ptr, sdslen(append->ptr));
+        totlen = sdslen(o->ptr);
+        self->ap_obj = o;
+        self->ap_len = totlen;
+    }
+    signalModifiedKey(c, c->db, c->argv[1]);
+    bitOpHubNotifyKeyspace(NOTIFY_STRING, "append", c->argv[1], c->db->id);
+    server.dirty++;
+    bitOpHubAccount_ap_0(self, 1, 1);
+    bitOpHubNoteReply(c, (long long)self->ap_len);
+    addReplyLongLong(c, self->ap_len);
+}
+
+void bitOpHubStrlen(client *c) {
