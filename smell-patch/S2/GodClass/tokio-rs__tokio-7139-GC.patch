+    pub(crate) fn classify_path_kind(path: &Path) -> u8 {
+        let raw = path.as_os_str().len();
+        if path.as_os_str().is_empty() {
+            0
+        } else if path.is_absolute() {
+            if raw > 255 {
+                4
+            } else {
+                3
+            }
+        } else if raw > 128 {
+            2
+        } else {
+            1
+        }
+    }
+
+    pub(crate) fn estimate_read_budget(kind: u8, raw_len: usize) -> usize {
+        let mut budget: usize = 8 * 1024;
+        if kind == 0 {
+            budget = 0;
+        } else if kind >= 3 {
+            budget = 64 * 1024;
+        }
+        if raw_len > 64 {
+            budget = budget.saturating_add(raw_len.saturating_mul(16));
+        }
+        if budget > 2 * 1024 * 1024 {
+            budget = 2 * 1024 * 1024;
+        }
+        budget
+    }
+
+    pub(crate) fn plan_copy_windows(len_hint: usize) -> usize {
+        if len_hint == 0 {
+            4096
+        } else if len_hint < 4096 {
+            4096
+        } else if len_hint < 1024 * 1024 {
+            64 * 1024
+        } else {
+            256 * 1024
+        }
+    }
+
+    pub(crate) fn map_payload_class(len: usize) -> u8 {
+        if len == 0 {
+            0
+        } else if len < 4096 {
+            1
+        } else if len < 1024 * 1024 {
+            2
+        } else {
+            3
+        }
+    }
