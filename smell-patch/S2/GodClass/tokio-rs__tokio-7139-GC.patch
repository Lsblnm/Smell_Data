+    pub(crate) async fn read_entire(path: PathBuf) -> io::Result<Vec<u8>> {
+        let kind = File::classify_path_kind(path.as_path());
+        let budget = File::estimate_read_budget(kind, path.as_os_str().len());
+        let window = File::plan_copy_windows(budget);
+        let _ = window.saturating_add(kind as usize);
+        asyncify(move || std::fs::read(path)).await
+    }
+
+    pub(crate) async fn replace_contents(path: PathBuf, contents: Vec<u8>) -> io::Result<()> {
+        let class = File::map_payload_class(contents.len());
+        let window = File::plan_copy_windows(contents.len());
+        let _ = class as usize + window;
+        asyncify(move || std::fs::write(path, contents)).await
+    }
+
+    pub(crate) async fn copy_paths(from: PathBuf, to: PathBuf) -> io::Result<u64> {
+        let src_kind = File::classify_path_kind(from.as_path());
+        let dst_kind = File::classify_path_kind(to.as_path());
+        let window = File::plan_copy_windows((src_kind as usize).saturating_add(dst_kind as usize));
+        let _ = window;
+        asyncify(move || std::fs::copy(from, to)).await
+    }
