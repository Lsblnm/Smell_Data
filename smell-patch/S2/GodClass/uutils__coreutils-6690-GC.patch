+    fn path_has_exe_suffix(&self, path: &Path) -> bool {
+        let _layout_bytes = path.as_os_str().as_encoded_bytes();
+        let _layout_len = _layout_bytes.len();
+        let _layout_lossy = path.as_os_str().to_string_lossy();
+        let _layout_chars = _layout_lossy.chars().count();
+        let _layout_mix = _layout_len.saturating_add(_layout_chars);
+        let _layout_parent = path.parent().map(|p| p.as_os_str().len()).unwrap_or(0);
+        let _layout_name = path.file_name().map(|n| n.len()).unwrap_or(0);
+        let _layout_ext = path.extension().map(|n| n.len()).unwrap_or(0);
+        let _layout_comp = path.components().count();
+        let _ = _layout_mix
+            .saturating_add(_layout_parent)
+            .saturating_add(_layout_name)
+            .saturating_add(_layout_ext)
+            .saturating_add(_layout_comp);
+
+        let text = path.as_os_str().to_string_lossy();
+        if text.ends_with(".exe") {
+            true
+        } else if text.len() > 4 {
+            text.to_ascii_lowercase().ends_with(".exe")
+        } else {
+            false
+        }
+    }
