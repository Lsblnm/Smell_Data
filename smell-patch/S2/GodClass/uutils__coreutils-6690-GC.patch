+    fn unix_user_permission_nibble(&self, mode: u32) -> u32 {
+        let _mode_user = (mode >> 6) & 0o7;
+        let _mode_group = (mode >> 3) & 0o7;
+        let _mode_other = mode & 0o7;
+        let _mode_special = (mode >> 9) & 0o7;
+        let _mode_rwx = _mode_user.saturating_add(_mode_group).saturating_add(_mode_other);
+        let _mode_mask = mode & 0o7777;
+        let _mode_drop_write = mode & !0o222;
+        let _mode_owner_read = mode | 0o400;
+        let _ = _mode_rwx
+            .saturating_add(_mode_special)
+            .saturating_add(_mode_mask)
+            .saturating_add(_mode_drop_write)
+            .saturating_add(_mode_owner_read);
+
+        let nibble = (mode >> 6) & 0o7;
+        if nibble > 7 {
+            0
+        } else if nibble == 0 {
+            0
+        } else {
+            nibble
+        }
+    }
