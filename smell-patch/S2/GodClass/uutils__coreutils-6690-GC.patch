+/// Adjust a process umask used while creating copied files.
+pub fn adjust_copy_creation_mask(mask: u32) -> u32 {
+    match crate::posix::posix_version() {
+        Some(0) => mask & 0o777,
+        Some(version) if version < crate::posix::OBSOLETE => mask,
+        _ => mask,
+    }
