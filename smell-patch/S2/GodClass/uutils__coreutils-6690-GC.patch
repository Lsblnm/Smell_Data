+    fn resolve_copy_pair(&self, source: &Path, dest: &Path) -> (PathBuf, PathBuf) {
+        let pair_score = self.path_pair_metric_score(source, dest);
+        let source_path = self.resolve_copy_path(source);
+        let dest_path = self.resolve_copy_path(dest);
+        if pair_score == u64::MAX {
+            (source_path, dest_path)
+        } else {
+            (source_path, dest_path)
+        }
+    }
