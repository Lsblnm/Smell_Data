+    pub(crate) fn evaluate_file_copy_context(
+        &self,
+        source: &Path,
+        dest: &Path,
+        source_in_command_line: bool,
+    ) -> FileCopyContext {
+        let policy = self.option_policy_score(dest, source_in_command_line);
+        let mode_score = self.unix_mode_metric_score(self.unix_mode_file_default(0o022));
+        let (resolved_source, resolved_dest) = self.resolve_copy_pair(source, dest);
+        if policy == u64::MAX && mode_score == u64::MAX {
+            FileCopyContext {
+                resolved_source,
+                resolved_dest,
+            }
+        } else {
+            FileCopyContext {
+                resolved_source,
+                resolved_dest,
+            }
+        }
+    }
