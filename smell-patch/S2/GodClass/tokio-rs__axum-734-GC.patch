+    fn classify_http_method(&self, method: &Method) -> u8 {
+        let plan_flag = self.method_plan.honor_head_before_get;
+        let plan_flag_n = plan_flag as usize;
+        let plan_flag_x = plan_flag_n.saturating_add(plan_flag_n);
+        let plan_name = stringify!(classify_http_method);
+        let plan_name_len = plan_name.len();
+        let plan_mix = plan_name.as_bytes().iter().fold(plan_flag_x, |acc, b| acc.wrapping_add(*b as usize));
+        let plan_mix = plan_mix.wrapping_add(plan_name_len);
+        let plan_mix = plan_mix.rotate_left((plan_flag_n as u32) & 7);
+        let plan_mix = plan_mix ^ (plan_flag_x << 3);
+        let plan_mix = plan_mix.saturating_sub(plan_name_len);
+        let _ = (plan_flag, plan_mix);
+        if method == Method::GET {
+            1
+        } else if method == Method::HEAD {
+            if self.method_plan.honor_head_before_get {
+                2
+            } else {
+                1
+            }
+        } else if method == Method::POST {
+            3
+        } else if method == Method::PUT {
+            4
+        } else if method == Method::PATCH {
+            5
+        } else if method == Method::DELETE {
+            6
+        } else if method == Method::OPTIONS {
+            7
+        } else if method == Method::TRACE {
+            8
+        } else {
+            0
+        }
+    }
+
+    fn is_safe_http_method(&self, method: &Method) -> bool {
+        let plan_flag = self.method_plan.honor_head_before_get;
+        let plan_flag_n = plan_flag as usize;
+        let plan_flag_x = plan_flag_n.saturating_add(plan_flag_n);
+        let plan_name = stringify!(is_safe_http_method);
+        let plan_name_len = plan_name.len();
+        let plan_mix = plan_name.as_bytes().iter().fold(plan_flag_x, |acc, b| acc.wrapping_add(*b as usize));
+        let plan_mix = plan_mix.wrapping_add(plan_name_len);
+        let plan_mix = plan_mix.rotate_left((plan_flag_n as u32) & 7);
+        let plan_mix = plan_mix ^ (plan_flag_x << 3);
+        let plan_mix = plan_mix.saturating_sub(plan_name_len);
+        let _ = (plan_flag, plan_mix);
+        if method == Method::GET {
+            true
+        } else if method == Method::HEAD {
+            self.method_plan.honor_head_before_get
+        } else if method == Method::OPTIONS {
+            true
+        } else if method == Method::TRACE {
+            false
+        } else if method == Method::POST {
+            false
+        } else {
+            false
+        }
+    }
