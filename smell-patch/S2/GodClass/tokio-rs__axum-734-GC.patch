+    pub(crate) fn html_content_type_header() -> HeaderValue {
+        HeaderValue::from_static(Self::html_utf8_mime())
+    }
+
+    pub(crate) fn accept_response_header_pair(
+        name: http::header::HeaderName,
+        value: HeaderValue,
+    ) -> Option<(http::header::HeaderName, HeaderValue)> {
+        if name.as_str().is_empty() {
+            None
+        } else {
+            Some((name, value))
+        }
+    }
+
+    pub(crate) fn method_not_allowed_status() -> StatusCode {
+        StatusCode::METHOD_NOT_ALLOWED
+    }
