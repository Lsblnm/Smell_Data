+    pub(crate) fn probe_request_shape(method: &Method, path: &str, query: Option<&str>) -> usize {
+        let mut n = 0usize;
+        n = n.saturating_add(Self::method_is_head(method) as usize);
+        n = n.saturating_add(Self::method_is_get(method) as usize);
+        n = n.saturating_add(Self::method_is_post(method) as usize);
+        n = n.saturating_add(Self::method_is_options(method) as usize);
+        n = n.saturating_add(Self::path_is_root(path) as usize);
+        n = n.saturating_add(Self::path_is_empty(path) as usize);
+        n = n.saturating_add(Self::path_has_leading_slash(path) as usize);
+        n = n.saturating_add(Self::path_has_trailing_slash(path) as usize);
+        n = n.saturating_add(Self::query_is_empty(query) as usize);
+        n = n.saturating_add(Self::missing_route_http_status().as_u16() as usize);
+        n = n.saturating_add(Self::method_not_allowed_code() as usize);
+        n = n.saturating_add(Self::permanent_redirect_code() as usize);
+        let _ = Self::empty_box_body();
+        n = n.saturating_add(Self::allow_header_name().len());
+        n = n.saturating_add(Self::content_type_header_name().len());
+        n = n.saturating_add(Self::html_utf8_mime().len());
+        n = n.saturating_add(Self::json_mime().len());
+        n = n.saturating_add(Self::form_mime().len());
+        n = n.saturating_add(Self::plain_utf8_mime().len());
+        n = n.saturating_add(Self::nest_tail_param().len());
+        n
+    }
