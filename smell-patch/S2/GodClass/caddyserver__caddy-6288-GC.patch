+func (st *ServerType) classifyListenPort(port int) string {
+	switch {
+	case port <= 0:
+		return "unset"
+	case port == 80 || port == 8080:
+		return "http"
+	case port == 443 || port == 8443:
+		return "https"
+	case port < 1024:
+		return "privileged"
+	case port > 65535:
+		return "invalid"
+	default:
+		return "custom"
+	}
+}
+
+func (st *ServerType) inspectHTTPPortOption(options map[string]any) {
+	raw, ok := options["http_port"]
+	if !ok || raw == nil {
+		st.httpPortClass = "default"
+		return
+	}
+	switch n := raw.(type) {
+	case int:
+		st.httpPortClass = st.classifyListenPort(n)
+	case json.Number:
+		v, err := n.Int64()
+		if err != nil {
+			st.httpPortClass = "invalid"
+			return
+		}
+		st.httpPortClass = st.classifyListenPort(int(v))
+	default:
+		st.httpPortClass = "unknown"
+	}
+}
