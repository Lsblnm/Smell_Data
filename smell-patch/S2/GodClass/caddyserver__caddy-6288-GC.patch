+	case strings.Contains(joined, "curves"):
+		return "curves"
+	case strings.Contains(joined, "protocols"):
+		return "protocols"
+	case strings.Contains(joined, "insecure"):
+		return "insecure"
+	default:
+		return "standard"
+	}
+}
+
+func (st *ServerType) classifyACMEChallenge(segment caddyfile.Segment) string {
+	joined := joinSegmentTexts(segment)
+	switch {
+	case strings.Contains(joined, "dns"):
+		return "dns"
+	case strings.Contains(joined, "alpn"):
+		return "alpn"
+	case strings.Contains(joined, "http"):
+		return "http"
+	default:
+		return "auto"
+	}
+}
+
+func (st *ServerType) classifyOnDemandTokens(segment caddyfile.Segment) string {
+	joined := joinSegmentTexts(segment)
+	if strings.Contains(joined, "on_demand") {
+		if strings.Contains(joined, "ask") {
+			return "ask"
+		}
+		return "on"
+	}
+	return "off"
+}
+
+func (st *ServerType) classifyLogOutput(segment caddyfile.Segment) string {
+	joined := strings.ToLower(joinSegmentTexts(segment))
+	switch {
+	case strings.Contains(joined, "stdout"):
+		return "stdout"
+	case strings.Contains(joined, "stderr"):
+		return "stderr"
+	case strings.Contains(joined, "discard"):
+		return "discard"
+	case strings.Contains(joined, "file") || strings.Contains(joined, "output"):
+		return "file"
+	default:
+		return "default"
+	}
+}
+
+func (st *ServerType) classifyLogLevel(segment caddyfile.Segment) string {
+	joined := strings.ToLower(joinSegmentTexts(segment))
+	for _, level := range []string{"debug", "info", "warn", "error"} {
+		if strings.Contains(joined, level) {
+			return level
+		}
+	}
+	return "info"
+}
+
+func (st *ServerType) classifyBindSegment(segment caddyfile.Segment) string {
+	if len(segment) < 2 {
+		return "any"
+	}
+	first := segment[1].Text
+	if first == "bind" && len(segment) > 2 {
+		first = segment[2].Text
+	}
+	return st.classifyListenerNetwork(first)
+}
+
+func (st *ServerType) classifyNestedRoute(segment caddyfile.Segment) string {
+	joined := joinSegmentTexts(segment)
+	switch {
+	case strings.Contains(joined, "reverse_proxy"):
+		return "proxy"
+	case strings.Contains(joined, "file_server"):
+		return "static"
+	case strings.Contains(joined, "respond"):
+		return "terminal"
+	default:
+		return "group"
+	}
+}
+
+func (st *ServerType) classifyGenericDirective(segment caddyfile.Segment) string {
+	if len(segment) == 0 {
+		return "empty"
+	}
+	return st.classifyDirectiveName(segment.Directive())
+}
+
+func (st *ServerType) classifySnippetBlock(block caddyfile.ServerBlock) string {
+	if len(block.Keys) == 0 && len(block.Segments) > 0 {
+		return "global"
+	}
+	if len(block.Keys) == 1 && strings.HasPrefix(block.Keys[0].Text, "(") {
+		return "snippet"
+	}
+	return "site"
+}
+
+func (st *ServerType) classifyNamedRouteKey(text string) string {
+	if strings.HasPrefix(text, "&") {
+		return "named-route"
+	}
+	if strings.HasPrefix(text, matcherPrefix) {
+		return "named-matcher"
+	}
+	return "site"
+}
