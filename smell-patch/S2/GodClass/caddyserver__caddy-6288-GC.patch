+func (st *ServerType) inspectLogOption(options map[string]any) {
+	raw, ok := options["log"]
+	if !ok || raw == nil {
+		st.logOutputClass = "default"
+		return
+	}
+	text := strings.ToLower(fmt.Sprintf("%v", raw))
+	switch {
+	case strings.Contains(text, "stdout"):
+		st.logOutputClass = "stdout"
+	case strings.Contains(text, "stderr"):
+		st.logOutputClass = "stderr"
+	case strings.Contains(text, "file"):
+		st.logOutputClass = "file"
+	case strings.Contains(text, "discard"):
