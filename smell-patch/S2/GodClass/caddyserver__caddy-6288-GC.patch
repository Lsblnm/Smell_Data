+func (st *ServerType) inspectServerProtocolOption(options map[string]any) {
+	raw, ok := options["servers"]
+	if !ok || raw == nil {
+		st.protocolSetClass = "default"
+		return
+	}
+	text := strings.ToLower(fmt.Sprintf("%v", raw))
+	hasH1 := strings.Contains(text, "h1") || strings.Contains(text, "http/1")
+	hasH2 := strings.Contains(text, "h2")
+	hasH3 := strings.Contains(text, "h3")
+	switch {
+	case hasH1 && hasH2 && hasH3:
+		st.protocolSetClass = "h1-h2-h3"
+	case hasH2 && hasH3:
+		st.protocolSetClass = "h2-h3"
+	case hasH1 && hasH2:
+		st.protocolSetClass = "h1-h2"
+	case hasH3:
+		st.protocolSetClass = "h3"
+	default:
+		st.protocolSetClass = "configured"
+	}
+}
