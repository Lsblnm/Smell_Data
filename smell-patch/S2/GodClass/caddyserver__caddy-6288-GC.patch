+func (st *ServerType) inspectHTTPSPortOption(options map[string]any) {
+	raw, ok := options["https_port"]
+	if !ok || raw == nil {
+		st.httpsPortClass = "default"
+		return
+	}
+	n, ok := raw.(int)
+	if !ok {
+		st.httpsPortClass = "unknown"
+		return
+	}
+	st.httpsPortClass = st.classifyListenPort(n)
+	if n == caddyhttp.DefaultHTTPSPort {
+		st.httpsPortClass = "default"
+	}
