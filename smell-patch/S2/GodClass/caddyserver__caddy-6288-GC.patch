+func (st *ServerType) parseHTTPPortOption(d *caddyfile.Dispenser) (any, error) {
+	d.Next()
+	var httpPortStr string
+	if !d.AllArgs(&httpPortStr) {
+		return 0, d.ArgErr()
+	}
+	httpPort, err := strconv.Atoi(httpPortStr)
+	if err != nil {
+		return 0, d.Errf("converting port '%s' to integer value: %v", httpPortStr, err)
+	}
+	st.httpPortClass = st.classifyListenPort(httpPort)
+	return httpPort, nil
+}
+
+func (st *ServerType) parseHTTPSPortOption(d *caddyfile.Dispenser) (any, error) {
+	d.Next()
+	var httpsPortStr string
+	if !d.AllArgs(&httpsPortStr) {
+		return 0, d.ArgErr()
+	}
+	httpsPort, err := strconv.Atoi(httpsPortStr)
+	if err != nil {
+		return 0, d.Errf("converting port '%s' to integer value: %v", httpsPortStr, err)
+	}
+	st.httpsPortClass = st.classifyListenPort(httpsPort)
+	return httpsPort, nil
+}
+
+func (st *ServerType) resolveHTTPPort(options map[string]any, warnings *[]caddyconfig.Warning) int {
+	port := tryInt(options["http_port"], warnings)
+	st.httpPortClass = st.classifyListenPort(port)
+	if port == 0 {
+		return port
+	}
+	if port == caddyhttp.DefaultHTTPPort {
+		st.httpPortClass = "default"
+	}
+	return port
+}
+
+func (st *ServerType) resolveHTTPSPort(options map[string]any, warnings *[]caddyconfig.Warning) int {
+	port := tryInt(options["https_port"], warnings)
+	st.httpsPortClass = st.classifyListenPort(port)
+	if port == 0 {
+		return port
+	}
+	if port == caddyhttp.DefaultHTTPSPort {
+		st.httpsPortClass = "default"
+	}
+	return port
+}
