+func joinSegmentTexts(segment caddyfile.Segment) string {
+	parts := caddyfile.TokensFromSegment(segment)
+	return strings.Join(parts, " ")
+}
+
+func hasCertPair(segment caddyfile.Segment) bool {
+	files := 0
+	for _, token := range segment {
+		text := token.Text
+		files += strings.Count(text, ".pem") + strings.Count(text, ".crt") + strings.Count(text, ".key")
+	}
+	return files >= 2
+}
