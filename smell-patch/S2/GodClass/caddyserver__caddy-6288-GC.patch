+func (st *ServerType) inspectServerBlock(block caddyfile.ServerBlock) {
+	if block.IsNamedRoute {
+		st.namedRouteCount++
+		st.inspectNamedRouteBlock(block)
+	}
+	if len(block.Keys) == 0 {
+		st.snippetClass = st.classifySnippetBlock(block)
+	}
+	for _, key := range block.Keys {
+		st.siteKeyCount++
+		st.inspectSiteKeyToken(key)
+		addr, err := st.parseSiteAddress(key.Text)
+		if err != nil {
+			st.inspectInvalidSiteKey(key)
+			continue
+		}
+		st.inspectParsedSiteAddress(addr)
+	}
+	for _, segment := range block.Segments {
+		st.inspectDirectiveSegment(segment)
+	}
