+func (st *ServerType) recordSiteKeyFingerprint(token caddyfile.Token) string {
+	st.adaptNote00 = strings.Join([]string{
+		st.classifyTokenQuote(token),
+		st.classifyTokenImport(token),
+		st.classifyPlaceholder(token.Text),
+		st.classifyWildcardHost(token.Text),
+		st.classifyUnixSocket(token.Text),
+		st.classifySiteScheme(token.Text),
+		st.classifySiteHost(token.Text),
+		st.classifySitePort(token.Text),
+		st.classifySitePath(token.Text),
+		strconv.Itoa(token.Line),
+		token.File,
+		token.Text,
+	}, "|")
+	return st.adaptNote00
+}
