+func (st *ServerType) classifyTokenQuote(token caddyfile.Token) string {
+	if !token.Quoted() {
+		if strings.Contains(token.Text, "\n") {
+			return "multiline"
+		}
+		return "bare"
+	}
+	switch {
+	case strings.HasPrefix(token.Text, "`") || strings.Contains(token.Text, "\n"):
+		return "heredoc-or-backtick"
+	case strings.Contains(token.Text, " "):
+		return "quoted-space"
+	default:
+		return "quoted"
+	}
+}
+
+func (st *ServerType) classifyTokenImport(token caddyfile.Token) string {
+	if token.File == "" {
+		return "inline"
+	}
+	if strings.Contains(token.File, "snippet") {
+		return "snippet-file"
+	}
+	if strings.HasSuffix(token.File, ".caddyfile") || strings.HasSuffix(token.File, ".Caddyfile") {
+		return "caddyfile"
+	}
+	return "imported"
+}
+
+func (st *ServerType) classifyPlaceholder(text string) string {
+	if text == "" {
+		return "none"
+	}
+	if strings.Contains(text, "{http.") || strings.Contains(text, "{http_") {
+		return "http"
+	}
+	if strings.Contains(text, "{$") {
+		return "env"
+	}
+	if strings.Contains(text, "{") && strings.Contains(text, "}") {
+		return "placeholder"
+	}
+	return "literal"
+}
+
+func (st *ServerType) classifyWildcardHost(text string) string {
+	host := text
+	if i := strings.Index(text, "://"); i >= 0 {
+		host = text[i+3:]
+	}
+	if slash := strings.Index(host, "/"); slash >= 0 {
+		host = host[:slash]
+	}
+	switch {
+	case host == "", host == "*":
+		return "catch-all"
+	case strings.HasPrefix(host, "*."):
+		return "star-label"
+	case strings.Contains(host, "*"):
+		return "glob"
+	default:
+		return "concrete"
+	}
+}
+
+func (st *ServerType) classifyUnixSocket(text string) string {
+	lower := strings.ToLower(text)
+	switch {
+	case strings.HasPrefix(lower, "unix/"), strings.HasPrefix(lower, "unix://"):
+		return "unix"
+	case strings.HasPrefix(lower, "unixgram"):
+		return "unixgram"
+	case strings.HasPrefix(lower, "fd/"), strings.HasPrefix(lower, "fdgram/"):
+		return "fd"
+	case strings.HasPrefix(text, "/"):
+		if strings.HasSuffix(text, ".sock") {
+			return "sock-path"
+		}
+		return "none"
+	default:
+		return "none"
+	}
+}
+
+func (st *ServerType) classifySiteScheme(text string) string {
+	scheme, rest, ok := strings.Cut(text, "://")
+	if !ok {
+		if strings.Contains(text, ":443") {
+			return "https-implied"
+		}
+		if strings.Contains(text, ":80") {
+			return "http-implied"
+		}
+		return "unspecified"
+	}
+	_ = rest
+	switch strings.ToLower(scheme) {
+	case "http", "https", "h2c":
+		return strings.ToLower(scheme)
+	case "unix", "unixgram":
+		return "unix"
+	default:
+		return "other"
+	}
+}
+
+func (st *ServerType) classifySiteHost(text string) string {
+	host := text
+	if i := strings.Index(text, "://"); i >= 0 {
+		host = text[i+3:]
+	}
+	if slash := strings.Index(host, "/"); slash >= 0 {
+		host = host[:slash]
+	}
+	if host == "" {
+		return "empty"
+	}
+	if ip := net.ParseIP(strings.Trim(host, "[]")); ip != nil {
+		if ip.To4() != nil {
+			return "ipv4"
+		}
+		return "ipv6"
+	}
+	if strings.Contains(host, "*") {
+		return "wildcard"
+	}
+	return "name"
+}
+
+func (st *ServerType) classifySitePort(text string) string {
+	hostport := text
+	if i := strings.Index(text, "://"); i >= 0 {
+		hostport = text[i+3:]
+	}
+	if slash := strings.Index(hostport, "/"); slash >= 0 {
+		hostport = hostport[:slash]
+	}
+	_, port, err := net.SplitHostPort(hostport)
+	if err != nil {
+		return "implicit"
+	}
+	return st.classifyParsedPort(port)
+}
+
+func (st *ServerType) classifySitePath(text string) string {
+	path := ""
+	if i := strings.Index(text, "://"); i >= 0 {
+		text = text[i+3:]
+	}
+	if slash := strings.Index(text, "/"); slash >= 0 {
+		path = text[slash:]
+	}
+	return st.classifyParsedPath(path)
+}
+
+func (st *ServerType) classifyParsedScheme(scheme string) string {
+	switch strings.ToLower(scheme) {
+	case "":
+		return "unspecified"
+	case "http":
+		return "http"
+	case "https":
+		return "https"
+	case "h2c":
+		return "h2c"
+	default:
+		return "other"
+	}
+}
+
+func (st *ServerType) classifyParsedHost(host string) string {
+	if host == "" {
+		return "empty"
+	}
+	if host == "localhost" || strings.HasSuffix(host, ".localhost") {
+		return "local"
+	}
+	if strings.HasSuffix(host, ".internal") || strings.HasSuffix(host, ".local") {
+		return "internal"
+	}
+	if ip := net.ParseIP(strings.Trim(host, "[]")); ip != nil {
+		if ip.IsLoopback() {
+			return "loopback"
+		}
+		if ip.IsPrivate() {
+			return "private"
+		}
+		return "public-ip"
+	}
+	return "dns"
+}
+
+func (st *ServerType) classifyParsedPort(port string) string {
+	if port == "" {
+		return "implicit"
+	}
+	n, err := strconv.Atoi(port)
+	if err != nil {
+		return "invalid"
+	}
+	return st.classifyListenPort(n)
+}
+
+func (st *ServerType) classifyParsedPath(path string) string {
+	switch {
+	case path == "":
+		return "none"
+	case path == "/":
+		return "root"
+	case strings.HasSuffix(path, "*"):
+		return "prefix"
+	case strings.Contains(path, "*"):
+		return "glob"
+	default:
+		return "exact"
+	}
+}
+
+func (st *ServerType) classifyListenerNetwork(raw string) string {
+	if raw == "" {
+		return "tcp"
+	}
+	network, host, ok := strings.Cut(raw, "/")
+	if !ok {
+		if strings.HasPrefix(raw, "unix") {
+			return "unix"
+		}
+		return "tcp"
+	}
+	_ = host
+	switch strings.ToLower(network) {
+	case "udp", "udp4", "udp6":
+		return "udp"
+	case "unix", "unixgram", "unixpacket":
+		return "unix"
+	case "tcp", "tcp4", "tcp6":
+		return "tcp"
+	default:
+		return network
+	}
+}
+
+func (st *ServerType) classifyMatcherToken(text string) string {
+	switch {
+	case text == "*":
+		return "wildcard"
+	case strings.HasPrefix(text, "/"):
+		return "path"
+	case strings.HasPrefix(text, matcherPrefix):
+		return "named"
+	case text == "expression" || strings.Contains(text, "{http."):
+		return "expression"
+	default:
+		return "other"
+	}
+}
+
+func (st *ServerType) classifyNamedMatcher(text string) string {
+	if !strings.HasPrefix(text, matcherPrefix) {
+		if text == "expression" {
+			return "expression-keyword"
+		}
+		return "not-named"
+	}
+	name := strings.TrimPrefix(text, matcherPrefix)
+	if name == "" {
+		return "empty"
+	}
+	if strings.ContainsAny(name, " 	") {
+		return "invalid"
+	}
+	return "named"
+}
+
+func (st *ServerType) classifyPathMatcher(text string) string {
+	if !strings.HasPrefix(text, "/") {
+		return "not-path"
+	}
+	switch {
+	case text == "/":
+		return "root"
+	case strings.HasSuffix(text, "*"):
+		return "prefix"
+	case strings.Contains(text, "*"):
+		return "glob"
+	default:
+		return "exact"
+	}
+}
+
+func (st *ServerType) classifyHostMatcher(text string) string {
+	if text == "host" {
+		return "keyword"
+	}
+	if strings.Contains(text, "*") {
+		return "wildcard"
+	}
+	if net.ParseIP(strings.Trim(text, "[]")) != nil {
+		return "ip"
+	}
+	if strings.Contains(text, ".") {
+		return "domain"
+	}
+	return "other"
+}
+
+func (st *ServerType) classifyHeaderMatcher(text string) string {
+	switch {
+	case text == "header":
+		return "header"
+	case text == "header_regexp":
+		return "header_regexp"
+	case strings.Contains(text, ":"):
+		return "header-pair"
+	default:
+		return "other"
+	}
+}
+
+func (st *ServerType) classifyQueryMatcher(text string) string {
+	switch {
+	case text == "query":
+		return "query"
+	case strings.Contains(text, "="):
+		return "pair"
+	case strings.Contains(text, "*"):
+		return "wildcard"
+	default:
+		return "other"
+	}
+}
+
+func (st *ServerType) classifyMethodMatcher(text string) string {
+	upper := strings.ToUpper(text)
+	switch upper {
+	case "GET", "HEAD", "POST", "PUT", "PATCH", "DELETE", "OPTIONS":
+		return "standard"
+	case "METHOD":
+		return "keyword"
+	case "CONNECT", "TRACE":
+		return "uncommon"
+	default:
+		return "other"
+	}
+}
+
+func (st *ServerType) classifyProtocolMatcher(text string) string {
+	lower := strings.ToLower(text)
+	switch lower {
+	case "http", "https":
+		return lower
+	case "grpc":
+		return "grpc"
+	case "protocol":
+		return "keyword"
+	default:
+		return "other"
+	}
+}
+
+func (st *ServerType) classifyExpressionMatcher(token caddyfile.Token) string {
+	text := token.Text
+	if text == "expression" {
+		return "keyword"
+	}
+	if token.Quoted() && (strings.Contains(text, "{http.") || strings.Contains(text, "==") || strings.Contains(text, "!=")) {
+		return "quoted-expr"
+	}
+	if strings.Contains(text, "{http.") {
+		return "placeholder-expr"
+	}
+	return "other"
+}
+
+func (st *ServerType) classifyRemoteIPMatcher(text string) string {
+	switch {
+	case text == "remote_ip" || text == "client_ip":
+		return "keyword"
+	case strings.Contains(text, "/"):
+		return "cidr"
+	case net.ParseIP(text) != nil:
+		return "ip"
+	case text == "private_ranges":
+		return "private"
+	default:
+		return "other"
+	}
+}
+
+func (st *ServerType) classifyExpressionSegment(segment caddyfile.Segment) string {
+	if len(segment) < 2 {
+		return "empty"
+	}
+	joined := strings.Join([]string{segment[0].Text, segment[1].Text}, " ")
+	if strings.Contains(joined, "expression") {
+		return "explicit"
+	}
+	if segment[1].Quoted() {
+		return "quoted"
+	}
+	return "implicit"
+}
+
+func (st *ServerType) classifyDirectiveName(dir string) string {
+	switch dir {
+	case "bind", "root", "tls", "log":
+		return "site-setup"
+	case "route", "handle", "handle_path", "handle_errors":
+		return "routing"
+	case "reverse_proxy", "php_fastcgi", "file_server", "respond", "redir", "rewrite":
+		return "handler"
+	case "header", "encode", "templates", "request_body":
+		return "transform"
+	default:
+		if strings.HasPrefix(dir, matcherPrefix) {
+			return "matcher"
+		}
+		return "other"
+	}
+}
+
+func (st *ServerType) classifyRouteHandler(dir string) string {
+	switch dir {
+	case "reverse_proxy":
+		return "proxy"
+	case "file_server":
+		return "static"
+	case "respond", "abort", "error":
+		return "terminal"
+	case "redir", "rewrite", "uri":
+		return "rewrite"
+	case "handle", "handle_path", "route":
+		return "group"
+	default:
+		return "other"
+	}
+}
+
+func (st *ServerType) classifyTLSIssuer(segment caddyfile.Segment) string {
+	joined := joinSegmentTexts(segment)
+	switch {
+	case strings.Contains(joined, "internal"):
+		return "internal"
+	case strings.Contains(joined, "acme"):
+		return "acme"
+	case strings.Contains(joined, "zerossl"):
+		return "zerossl"
+	case hasCertPair(segment):
+		return "file"
+	default:
+		return "implicit"
+	}
+}
+
+func (st *ServerType) classifyTLSCertLoader(segment caddyfile.Segment) string {
+	joined := joinSegmentTexts(segment)
+	switch {
+	case strings.Contains(joined, "load"):
+		return "folder"
+	case hasCertPair(segment):
+		return "file"
+	case strings.Contains(joined, "pem"):
+		return "pem"
+	default:
+		return "none"
+	}
+}
+
+func (st *ServerType) classifyTLSClientAuth(segment caddyfile.Segment) string {
+	joined := joinSegmentTexts(segment)
+	switch {
+	case strings.Contains(joined, "require_and_verify"):
+		return "require-verify"
+	case strings.Contains(joined, "require"):
+		return "require"
+	case strings.Contains(joined, "verify_if_given"):
+		return "verify-if-given"
+	case strings.Contains(joined, "client_auth"):
+		return "configured"
+	default:
+		return "off"
+	}
+}
+
+func (st *ServerType) classifyTLSALPN(segment caddyfile.Segment) string {
+	joined := strings.ToLower(joinSegmentTexts(segment))
+	switch {
+	case strings.Contains(joined, "h2") && strings.Contains(joined, "http/1.1"):
+		return "h2-h1"
+	case strings.Contains(joined, "h2"):
+		return "h2"
+	case strings.Contains(joined, "acme-tls"):
+		return "acme-tls"
+	case strings.Contains(joined, "alpn"):
+		return "custom"
+	default:
+		return "default"
+	}
+}
