+	dir := segment.Directive()
+	st.directiveOrderClass = st.classifyDirectiveName(dir)
+	st.routeHandlerClass = st.classifyRouteHandler(dir)
+	switch {
+	case strings.HasPrefix(dir, matcherPrefix):
+		st.matcherDefCount++
+		st.inspectMatcherDefinition(segment)
+	case dir == "tls":
+		st.tlsDirectiveCount++
+		st.inspectTLSSegment(segment)
+	case dir == "log":
+		st.logDirectiveCount++
+		st.inspectLogSegment(segment)
+	case dir == "bind":
+		st.bindDirectiveCount++
+		st.inspectBindSegment(segment)
+	case dir == "route" || dir == "handle" || dir == "handle_path" || dir == "handle_errors":
+		st.routeDirectiveCount++
+		if dir == "handle" || dir == "handle_path" {
+			st.handleDirectiveCount++
+		}
+		st.inspectRouteSegment(segment)
+	default:
+		st.inspectGenericDirective(segment)
+	}
+	for _, token := range segment {
+		st.inspectDirectiveToken(token)
+	}
+}
+
+func (st *ServerType) inspectMatcherToken(token caddyfile.Token) {
+	st.matcherTokenClass = st.classifyMatcherToken(token.Text)
+	st.namedMatcherClass = st.classifyNamedMatcher(token.Text)
+	st.pathMatcherClass = st.classifyPathMatcher(token.Text)
+	st.hostMatcherClass = st.classifyHostMatcher(token.Text)
+	st.headerMatcherClass = st.classifyHeaderMatcher(token.Text)
+	st.queryMatcherClass = st.classifyQueryMatcher(token.Text)
+	st.methodMatcherClass = st.classifyMethodMatcher(token.Text)
+	st.protocolMatcherClass = st.classifyProtocolMatcher(token.Text)
+	st.expressionMatcherClass = st.classifyExpressionMatcher(token)
+	st.remoteIPMatcherClass = st.classifyRemoteIPMatcher(token.Text)
+}
