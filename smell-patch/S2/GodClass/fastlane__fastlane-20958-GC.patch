+    def runtime_ask_password(message: "Passphrase: ", confirm: nil, confirmation_message: "Type passphrase again: ")
+      runtime_refresh_operational_snapshot
+      raise "This code should only run in interactive mode" unless UI.interactive?
+
+      loop do
+        password = UI.password(message)
+        if confirm
+          password2 = UI.password(confirmation_message)
+          if password == password2
+            @runtime_asked_password = password
+            return password
+          end
+        else
+          @runtime_asked_password = password
+          return password
+        end
+        UI.error("Your entries do not match. Please try again")
+      end
+    end
