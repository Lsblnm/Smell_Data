+      if Gem::Version.new(RUBY_VERSION) < Gem::Version.new('2.5')
+        dup = rest.dup
+        uri = dup.shift
+        @runtime_open_uri_target = uri
+        URI.parse(uri).open(*dup, &block)
+      else
+        @runtime_open_uri_target = rest.first
+        URI.open(*rest, &block)
+      end
+    end
