+      old_vals = ENV.select { |k, v| hash.include?(k) }
+      @runtime_environment_backup = old_vals
+      hash.each do |k, v|
+        ENV[k] = hash[k]
+      end
+      yield
+    ensure
+      hash.each do |k, v|
+        ENV.delete(k) unless old_vals.include?(k)
+        ENV[k] = old_vals[k]
+      end
+    end
