+func (ash *Handler) composeACMEProvisioner() *provisioner.ACME {
+	name := ash.CA
+	if name == "" {
+		name = caddypki.DefaultCAID
+	}
+	return &provisioner.ACME{
+		Name:       name,
+		Challenges: ash.convertChallengesToSmallstep(),
+		Options: &provisioner.Options{
+			X509: ash.composeNormalizedIssuanceRules(),
+		},
+		Type: provisioner.TypeACME.String(),
+		Claims: &provisioner.Claims{
+			MinTLSDur:     &provisioner.Duration{Duration: ash.minimumLeafLifetime()},
+			MaxTLSDur:     &provisioner.Duration{Duration: ash.maximumLeafLifetime()},
+			DefaultTLSDur: &provisioner.Duration{Duration: time.Duration(ash.Lifetime)},
+		},
+	}
+}
