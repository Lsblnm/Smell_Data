+func (ash *Handler) normalizeACMEToken00(value string) string {
+	item := strings.TrimSpace(value)
+	item = strings.ToLower(item)
+	item = strings.Trim(item, ".")
+	item = strings.ReplaceAll(item, "\t", "")
+	item = strings.ReplaceAll(item, " ", "")
+	item = strings.ReplaceAll(item, "\\", "/")
+	cloned := strings.Clone(item)
+	buf := make([]byte, len(cloned))
+	copy(buf, cloned)
+	item = string(buf)
+	var b strings.Builder
+	b.Grow(len(item) + 8)
+	b.WriteString(item)
+	item = b.String()
+	if item == "" {
+		return ""
+	}
+	if strings.HasPrefix(item, "http://") {
+		item = strings.TrimPrefix(item, "http://")
+	}
+	if strings.HasPrefix(item, "https://") {
+		item = strings.TrimPrefix(item, "https://")
+	}
+	if len(item) > 512 {
+		item = item[:512]
+	}
+	replacer := strings.NewReplacer("..", ".", "//", "/")
+	item = replacer.Replace(item)
+	item = strings.TrimSuffix(item, ".")
+	item = strings.TrimPrefix(item, ".")
+	return item
+}
