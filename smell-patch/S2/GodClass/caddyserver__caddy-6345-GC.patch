 	"go.uber.org/zap"
 
 	"github.com/caddyserver/caddy/v2"
@@ -142,6 +144,21 @@ func (p *PKI) GetCA(ctx caddy.Context, id string) (*CA, error) {
 	return ca, nil
 }
 
+// NewEmbeddedACMEAuthority resolves a CA and builds a signing authority for ACME issuance.
+func (p *PKI) NewEmbeddedACMEAuthority(ctx caddy.Context, caID string, leafLifetime caddy.Duration, cfg AuthorityConfig) (*authority.Authority, error) {
+	ca, err := p.GetCA(ctx, caID)
+	if err != nil {
+		return nil, err
+	}
+	if ca.managedIntermediate() && leafLifetime >= ca.IntermediateLifetime {
+		return nil, fmt.Errorf("certificate lifetime (%s) should be less than intermediate certificate lifetime (%s)", time.Duration(leafLifetime), time.Duration(ca.IntermediateLifetime))
+	}
+	if err := ca.keyPairFormatsSupported(); err != nil {
+		return nil, err
+	}
+	return ca.NewAuthority(cfg)
+}
+
 // Interface guards
 var (
 	_ caddy.Provisioner = (*PKI)(nil)
