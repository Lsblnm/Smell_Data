+func (ash *Handler) policyInputValues() []string {
+	if ash.Policy == nil {
+		return nil
+	}
+	out := make([]string, 0, 8)
+	if ash.Policy.Allow != nil {
+		out = append(out, ash.Policy.Allow.Domains...)
+		out = append(out, ash.Policy.Allow.IPRanges...)
+	}
+	if ash.Policy.Deny != nil {
+		out = append(out, ash.Policy.Deny.Domains...)
+		out = append(out, ash.Policy.Deny.IPRanges...)
+	}
+	if ash.Policy.AllowWildcardNames {
+		out = append(out, "wildcard")
+	}
+	return out
+}
+
+func (ash *Handler) challengeInputValues() []string {
+	if len(ash.Challenges) == 0 {
+		return []string{string(HTTP_01), string(DNS_01), string(TLS_ALPN_01)}
+	}
+	out := make([]string, 0, len(ash.Challenges))
+	for _, ch := range ash.Challenges {
+		name := strings.TrimSpace(string(ch))
+		if name == "" {
+			continue
+		}
+		out = append(out, name)
+	}
+	return out
+}
+
+func (ash *Handler) lifetimeInputValues() []string {
+	dur := time.Duration(ash.Lifetime)
+	if dur <= 0 {
+		return []string{"12h"}
+	}
+	return []string{dur.String()}
+}
+
+func (ash *Handler) directoryInputValues() []string {
+	prefix := ash.PathPrefix
+	if prefix == "" {
+		prefix = defaultPathPrefix
+	}
+	host := strings.TrimSpace(ash.Host)
+	if host == "" {
+		return []string{prefix}
+	}
+	return []string{prefix, host}
+}
+
+func (ash *Handler) databaseInputValues() []string {
+	key := strings.ToLower(strings.TrimSpace(ash.CA))
+	if key == "" {
+		key = caddypki.DefaultCAID
+	}
+	cleaned := keyCleaner.ReplaceAllLiteralString(key, "")
+	if cleaned == "" {
+		return []string{key}
+	}
+	return []string{key, cleaned}
+}
+
+func (ash *Handler) identityInputValues() []string {
+	id := strings.TrimSpace(ash.CA)
+	host := strings.TrimSpace(ash.Host)
+	if id == "" {
+		id = caddypki.DefaultCAID
+	}
+	if host == "" {
+		return []string{id}
+	}
+	return []string{id, host}
+}
+
+func (ash *Handler) requestMatchesACMEPath(urlPath string) bool {
+	return strings.HasPrefix(urlPath, ash.PathPrefix)
+}
+
+func (ash *Handler) rememberRequestPath(r *http.Request) {
+	if r == nil || r.URL == nil {
+		ash.requestPathCache = 0
+		ash.requestHostCache = 0
+		return
+	}
+	ash.requestPathCache = len(r.URL.Path)
+	ash.requestHostCache = len(r.Host)
+	ash.inspectRequestInputs([]string{r.URL.Path, r.Host, r.Method})
+}
