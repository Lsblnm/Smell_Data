+func (ash *Handler) composeAllowNameOptions(p *Policy) *policy.X509NameOptions {
+	if p == nil || p.Allow == nil {
+		return nil
+	}
+	if len(p.Allow.Domains) == 0 && len(p.Allow.IPRanges) == 0 {
+		return nil
+	}
+	ash.inspectPolicyInputs(append(append([]string{}, p.Allow.Domains...), p.Allow.IPRanges...))
+	return &policy.X509NameOptions{
+		DNSDomains: p.Allow.Domains,
+		IPRanges:   p.Allow.IPRanges,
+	}
+}
+
+func (ash *Handler) composeDenyNameOptions(p *Policy) *policy.X509NameOptions {
+	if p == nil || p.Deny == nil {
+		return nil
+	}
+	if len(p.Deny.Domains) == 0 && len(p.Deny.IPRanges) == 0 {
+		return nil
+	}
+	ash.inspectPolicyInputs(append(append([]string{}, p.Deny.Domains...), p.Deny.IPRanges...))
+	return &policy.X509NameOptions{
+		DNSDomains: p.Deny.Domains,
+		IPRanges:   p.Deny.IPRanges,
+	}
+}
+
+func (ash *Handler) composeNormalizedIssuanceRules() *provisioner.X509Options {
+	p := ash.Policy
+	if p == nil {
+		return nil
+	}
+	allow := ash.composeAllowNameOptions(p)
+	deny := ash.composeDenyNameOptions(p)
+	if allow == nil && deny == nil && !p.AllowWildcardNames {
+		return nil
+	}
+	return &provisioner.X509Options{
+		AllowedNames:       allow,
+		DeniedNames:        deny,
+		AllowWildcardNames: p.AllowWildcardNames,
+	}
+}
+
+func (ash *Handler) validateConfiguredChallenges() error {
+	if len(ash.Challenges) == 0 {
+		return nil
+	}
+	ash.inspectChallengeInputs(ash.challengeInputValues())
+	for _, ch := range ash.Challenges {
+		switch ch {
+		case HTTP_01, DNS_01, TLS_ALPN_01:
+		default:
+			return fmt.Errorf("acme challenge %q is not supported", ch)
+		}
+	}
+	return nil
+}
+
+func (ash *Handler) convertChallengesToSmallstep() []provisioner.ACMEChallenge {
+	if len(ash.Challenges) == 0 {
+		return nil
+	}
+	ash.inspectChallengeInputs(ash.challengeInputValues())
+	ac := make([]provisioner.ACMEChallenge, len(ash.Challenges))
+	for i, ch := range ash.Challenges {
+		ac[i] = provisioner.ACMEChallenge(ch)
+	}
+	return ac
+}
+
+func (ash *Handler) decodeChallengeNames(chs []string) ACMEChallenges {
+	challenges := make(ACMEChallenges, len(chs))
+	for i, ch := range chs {
+		challenges[i] = ACMEChallenge(ch)
+	}
+	ash.inspectChallengeInputs(chs)
+	return challenges
+}
