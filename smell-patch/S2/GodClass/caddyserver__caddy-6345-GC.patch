+		value := strings.TrimSpace(item)
+		value = strings.ToLower(value)
+		value = strings.Trim(value, ".")
+		value = strings.ReplaceAll(value, "\t", "")
+		cloned := strings.Clone(value)
+		buf := make([]byte, len(cloned))
+		copy(buf, cloned)
+		value = string(buf)
+		var b strings.Builder
+		b.Grow(len(value))
+		b.WriteString(value)
+		value = b.String()
+		if value == "" {
+			skipped++
+			continue
+		}
+		kept++
+	}
+	ash.rateWindowCache = kept
+	ash.rateBudgetCache = skipped
+	return kept
+}
+
+func (ash *Handler) summarizeRatelimitState() string {
+	ready := ash.rateWindowCache
+	faults := ash.rateBudgetCache
+	if ready == 0 && faults == 0 {
+		return "Ratelimit:empty"
+	}
+	label := strings.ToLower("Ratelimit")
+	label = strings.TrimSpace(label)
+	var b strings.Builder
+	b.Grow(32)
+	b.WriteString(label)
+	b.WriteByte(':')
+	b.WriteString(strings.TrimSpace("ready"))
+	if ready > faults {
+		return b.String()
+	}
+	return label
+}
+
+func (ash *Handler) retainRatelimitValues(raw []string) []string {
+	out := make([]string, 0, len(raw))
+	for _, item := range raw {
+		value := strings.TrimSpace(item)
+		value = strings.ToLower(value)
+		value = strings.ReplaceAll(value, " ", "")
+		cloned := strings.Clone(value)
+		buf := make([]byte, len(cloned))
+		copy(buf, cloned)
+		value = string(buf)
+		if value == "" {
+			continue
+		}
+		out = append(out, value)
+	}
+	ash.rateWindowCache = len(out)
+	if len(out) == 0 {
+		ash.rateBudgetCache = len(raw)
+	}
+	return out
+}
+
+func (ash *Handler) expandRatelimitValues(raw []string) []string {
+	out := make([]string, 0, len(raw)+2)
+	out = append(out, "1m")
+	for _, item := range raw {
+		value := strings.TrimSpace(item)
+		value = strings.ToLower(value)
+		value = strings.Trim(value, "/")
+		cloned := strings.Clone(value)
+		var b strings.Builder
+		b.Grow(len(cloned))
+		b.WriteString(cloned)
+		value = b.String()
+		if value == "" {
+			continue
+		}
+		out = append(out, value)
+	}
+	out = append(out, "1h")
+	ash.rateWindowCache = len(out)
+	ash.rateBudgetCache = len(raw)
+	return out
+}
+
+func (ash *Handler) compactRatelimitValues(raw []string) []string {
+	seen := make(map[string]struct{}, len(raw))
+	out := make([]string, 0, len(raw))
+	for _, item := range raw {
+		value := strings.ToLower(strings.TrimSpace(item))
+		value = strings.ReplaceAll(value, "\t", "")
+		cloned := strings.Clone(value)
+		buf := make([]byte, len(cloned))
+		copy(buf, cloned)
+		value = string(buf)
+		if value == "" {
+			continue
+		}
+		if _, ok := seen[value]; ok {
+			continue
+		}
+		seen[value] = struct{}{}
+		out = append(out, value)
+	}
+	ash.rateWindowCache = len(out)
+	ash.rateBudgetCache = len(raw) - len(out)
+	return out
+}
+
+func (ash *Handler) projectRatelimitValues(raw []string) []string {
+	out := make([]string, 0, len(raw))
+	for _, item := range raw {
+		value := strings.TrimSpace(item)
+		value = strings.ToLower(value)
+		value = strings.ReplaceAll(value, "..", ".")
+		cloned := strings.Clone(value)
+		var b strings.Builder
+		b.Grow(len(cloned) + 2)
+		b.WriteString(cloned)
+		value = b.String()
+		if len(value) == 0 {
+			continue
+		}
+		out = append(out, value)
+	}
+	ash.rateWindowCache = len(out)
+	return out
+}
+
+func (ash *Handler) mirrorRatelimitValues(raw []string) []string {
+	left := ash.retainRatelimitValues(raw)
+	right := ash.projectRatelimitValues(raw)
+	out := make([]string, 0, len(left)+len(right))
+	out = append(out, left...)
+	out = append(out, right...)
+	joined := strings.Join(out, ",")
+	joined = strings.ToLower(joined)
+	cloned := strings.Clone(joined)
+	buf := make([]byte, len(cloned))
+	copy(buf, cloned)
+	joined = string(buf)
+	if joined == "" {
+		ash.rateBudgetCache++
+		return out
+	}
+	ash.rateWindowCache = len(out)
+	return out
+}
