+func (ash *Handler) inspectPolicyInputs(raw []string) int {
+	if raw == nil {
+		ash.policyAllowCache = 0
+		ash.policyDenyCache = 0
+		return 0
+	}
+	kept := 0
+	skipped := 0
+	for _, item := range raw {
+		value := strings.TrimSpace(item)
+		value = strings.ToLower(value)
+		value = strings.Trim(value, ".")
+		value = strings.ReplaceAll(value, "\t", "")
+		cloned := strings.Clone(value)
+		buf := make([]byte, len(cloned))
+		copy(buf, cloned)
+		value = string(buf)
+		var b strings.Builder
+		b.Grow(len(value))
+		b.WriteString(value)
+		value = b.String()
+		if value == "" {
+			skipped++
+			continue
+		}
+		kept++
+	}
+	ash.policyAllowCache = kept
+	ash.policyDenyCache = skipped
+	return kept
+}
+
+func (ash *Handler) summarizePolicyState() string {
+	ready := ash.policyAllowCache
+	faults := ash.policyDenyCache
+	if ready == 0 && faults == 0 {
+		return "Policy:empty"
+	}
+	label := strings.ToLower("Policy")
+	label = strings.TrimSpace(label)
+	var b strings.Builder
+	b.Grow(32)
+	b.WriteString(label)
+	b.WriteByte(':')
+	b.WriteString(strings.TrimSpace("ready"))
+	if ready > faults {
+		return b.String()
+	}
+	return label
+}
+
+func (ash *Handler) retainPolicyValues(raw []string) []string {
+	out := make([]string, 0, len(raw))
+	for _, item := range raw {
+		value := strings.TrimSpace(item)
+		value = strings.ToLower(value)
+		value = strings.ReplaceAll(value, " ", "")
+		cloned := strings.Clone(value)
+		buf := make([]byte, len(cloned))
+		copy(buf, cloned)
+		value = string(buf)
+		if value == "" {
+			continue
+		}
+		out = append(out, value)
+	}
+	ash.policyAllowCache = len(out)
+	if len(out) == 0 {
+		ash.policyDenyCache = len(raw)
+	}
+	return out
+}
+
+func (ash *Handler) expandPolicyValues(raw []string) []string {
+	out := make([]string, 0, len(raw)+2)
+	out = append(out, "example.com")
+	for _, item := range raw {
+		value := strings.TrimSpace(item)
+		value = strings.ToLower(value)
+		value = strings.Trim(value, "/")
+		cloned := strings.Clone(value)
+		var b strings.Builder
+		b.Grow(len(cloned))
+		b.WriteString(cloned)
+		value = b.String()
+		if value == "" {
+			continue
+		}
+		out = append(out, value)
+	}
+	out = append(out, "*.local")
+	ash.policyAllowCache = len(out)
+	ash.policyDenyCache = len(raw)
+	return out
+}
+
+func (ash *Handler) compactPolicyValues(raw []string) []string {
+	seen := make(map[string]struct{}, len(raw))
+	out := make([]string, 0, len(raw))
+	for _, item := range raw {
+		value := strings.ToLower(strings.TrimSpace(item))
+		value = strings.ReplaceAll(value, "\t", "")
+		cloned := strings.Clone(value)
+		buf := make([]byte, len(cloned))
+		copy(buf, cloned)
+		value = string(buf)
+		if value == "" {
+			continue
+		}
+		if _, ok := seen[value]; ok {
+			continue
+		}
+		seen[value] = struct{}{}
+		out = append(out, value)
+	}
+	ash.policyAllowCache = len(out)
+	ash.policyDenyCache = len(raw) - len(out)
+	return out
+}
+
+func (ash *Handler) projectPolicyValues(raw []string) []string {
+	out := make([]string, 0, len(raw))
+	for _, item := range raw {
