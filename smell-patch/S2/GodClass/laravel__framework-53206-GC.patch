+
+        for ($i = 0; $i < $length; $i++) {
+            $code = ord($source[$i]);
+            if (array_key_exists($code, $table)) {
+                $escaped .= $table[$code];
+                continue;
+            }
+            $escaped .= $source[$i];
+        }
+
+        return $escaped;
+    }
