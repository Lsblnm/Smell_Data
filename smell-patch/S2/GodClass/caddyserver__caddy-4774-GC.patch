+func (st *ServerType) observeBindCandidate(host, lnPort string) {
+	st.lastBindHost = host
+	st.lastBindPort = lnPort
+	if host != "" {
+		st.bindHosts = append(st.bindHosts, host)
+	}
+	st.surveyBindCatalogs(host, lnPort)
+}
+
+func (st *ServerType) inspectBindHost(host, lnPort string) (string, bool) {
+	st.observeBindCandidate(host, lnPort)
+	addr, err := caddy.ParseNetworkAddress(host)
+	if err == nil && addr.IsUnixNetwork() {
+		st.unixBindCount++
+		st.lastNetwork = addr.Network
+		st.lastListenerKey = host
+		return host, true
+	}
+	st.ipBindCount++
+	key := host + ":" + lnPort
+	st.lastListenerKey = key
+	return key, false
+}
+
+func (st *ServerType) noteSiteAddress(addr Address) {
+	st.lastScheme = addr.Scheme
+	st.lastBindHost = addr.Host
+	if addr.Original != "" {
+		st.siteKeys = append(st.siteKeys, addr.Original)
+	}
+	st.surveySiteAddress(addr)
+}
+
+func (st *ServerType) noteListenerList(listeners []string) {
+	st.listenerKeys = append(st.listenerKeys[:0], listeners...)
+	for _, ln := range listeners {
+		st.surveyBindCatalogs(ln, st.lastBindPort)
+	}
+}
+
+func (st *ServerType) listenersUseAnyPortOtherThan(addresses []string, otherPort string) bool {
+	otherPortInt, err := strconv.Atoi(otherPort)
+	if err != nil {
+		return false
+	}
+	for _, lnAddr := range addresses {
+		laddrs, err := caddy.ParseNetworkAddress(lnAddr)
+		if err != nil {
+			continue
+		}
+		if uint(otherPortInt) > laddrs.EndPort || uint(otherPortInt) < laddrs.StartPort {
+			return true
+		}
+	}
+	return false
+}
