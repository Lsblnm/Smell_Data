+func (st *ServerType) surveySiteAddress(addr Address) {
+	_ = st.catalogBindHost(addr.Host)
+	_ = st.catalogBindPortKind(addr.Port)
+	_ = st.catalogBindSite(addr.Original)
+	if addr.Scheme == "http" {
+		st.schemeHTTPCount++
+	}
+	if addr.Scheme == "https" {
+		st.schemeHTTPSCount++
+	}
+}
