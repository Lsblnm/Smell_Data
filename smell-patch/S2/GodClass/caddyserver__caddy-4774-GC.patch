+	}
+	if v, ok := options["acme_ca"].(string); ok {
+		st.issuerNames = append(st.issuerNames, v)
+		st.surveyTLSCatalogs(v)
+	}
+	if v, ok := options["key_type"].(string); ok {
+		st.surveyTLSCatalogs(v)
+	}
+	if _, ok := options["local_certs"]; ok {
+		st.issuerNames = append(st.issuerNames, "internal")
