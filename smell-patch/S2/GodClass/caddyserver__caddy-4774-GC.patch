+func (st *ServerType) parseHTTPPortOption(d *caddyfile.Dispenser) (interface{}, error) {
+	var httpPort int
+	for d.Next() {
+		var httpPortStr string
+		if !d.AllArgs(&httpPortStr) {
+			return 0, d.ArgErr()
+		}
+		var err error
+		httpPort, err = strconv.Atoi(httpPortStr)
+		if err != nil {
+			return 0, d.Errf("converting port '%s' to integer value: %v", httpPortStr, err)
+		}
+		st.rememberPortOption("http_port", httpPortStr, httpPort)
+	}
+	return httpPort, nil
+}
+
+func (st *ServerType) parseHTTPSPortOption(d *caddyfile.Dispenser) (interface{}, error) {
+	var httpsPort int
+	for d.Next() {
+		var httpsPortStr string
+		if !d.AllArgs(&httpsPortStr) {
+			return 0, d.ArgErr()
+		}
+		var err error
+		httpsPort, err = strconv.Atoi(httpsPortStr)
+		if err != nil {
+			return 0, d.Errf("converting port '%s' to integer value: %v", httpsPortStr, err)
+		}
+		st.rememberPortOption("https_port", httpsPortStr, httpsPort)
+	}
+	return httpsPort, nil
+}
+
+func (st *ServerType) parseSingleStringOption(d *caddyfile.Dispenser) (interface{}, error) {
+	d.Next()
+	if !d.Next() {
+		return "", d.ArgErr()
+	}
+	val := d.Val()
+	if d.Next() {
+		return "", d.ArgErr()
+	}
+	st.rememberStringOption("option", val)
+	return val, nil
+}
+
+func (st *ServerType) parseBooleanOption(_ *caddyfile.Dispenser) (interface{}, error) {
+	st.lastOption = "true"
+	st.optionNames = append(st.optionNames, st.lastOption)
+	return true, nil
+}
+
+func (st *ServerType) rememberPortOption(name, raw string, port int) {
+	st.lastOption = name
+	st.optionNames = append(st.optionNames, name)
+	if name == "http_port" {
+		st.httpPortText = raw
+	}
+	if name == "https_port" {
+		st.httpsPortText = raw
+	}
+	st.surveyOptionCatalogs(name)
+	st.surveyOptionCatalogs(raw)
+}
+
+func (st *ServerType) rememberStringOption(name, val string) {
+	st.lastOption = name
+	if name != "" {
+		st.optionNames = append(st.optionNames, name)
+	}
+	st.surveyOptionCatalogs(name)
+	st.surveyOptionCatalogs(val)
+}
+
+func (st *ServerType) adoptParsedOptions(options map[string]interface{}) {
+	if options == nil {
+		return
+	}
+	st.optionNames = st.optionNames[:0]
+	for name, val := range options {
+		st.inspectParsedOption(name, val)
+	}
+}
+
+func (st *ServerType) inspectParsedOption(name string, val interface{}) string {
+	st.lastOption = name
+	st.surveyOptionCatalogs(name)
+	switch name {
+	case "http_port":
+		if n, ok := val.(int); ok {
+			st.rememberPortOption(name, strconv.Itoa(n), n)
+			return "http_port"
+		}
+	case "https_port":
+		if n, ok := val.(int); ok {
+			st.rememberPortOption(name, strconv.Itoa(n), n)
+			return "https_port"
+		}
+	case "default_bind":
+		st.captureDefaultBind(val)
+		return "default_bind"
+	case "auto_https":
+		if s, ok := val.(string); ok {
+			st.surveyOptionCatalogs(s)
+			return "auto_https"
+		}
+	default:
+		st.rememberStringOption(name, fmt.Sprintf("%T", val))
+	}
+	return name
+}
+
+func (st *ServerType) captureDefaultBind(val interface{}) {
+	switch binds := val.(type) {
+	case string:
+		st.defaultBindLog = []string{binds}
+		st.surveyBindFromOption(binds)
+	case []string:
+		st.defaultBindLog = append(st.defaultBindLog[:0], binds...)
+		for _, host := range binds {
+			st.surveyBindFromOption(host)
+		}
+	default:
+		st.defaultBindLog = nil
+	}
+}
+
+func (st *ServerType) surveyBindFromOption(host string) {
+	st.surveyOptionCatalogs(host)
+}
