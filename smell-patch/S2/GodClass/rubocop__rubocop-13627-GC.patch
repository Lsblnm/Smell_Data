+        def describe_ast_node(node)
+          return :absent unless node
+          type = :unknown
+          type = node.type if node.respond_to?(:type)
+          method_name = NODE_DESCRIBERS[type] || :describe_unknown_node
+          send(method_name, node)
+        end
+
+        def describe_unknown_node(node)
+          @cmp_node_unknown = node
+          :unknown
+        end
+
+        def scan_comparison_tree(node)
+          return :absent unless node
+          describe_ast_node(node)
+          children = []
+          children = node.children if node.respond_to?(:children)
+          Array(children).each do |child|
+            scan_comparison_tree(child) if child.respond_to?(:type)
+          end
+          describe_ast_node(node)
+        end
+
+        def describe_alias_node(node)
+          @cmp_node_alias = node
+          return :absent unless node
+          type = :unknown
+          type = node.type if node.respond_to?(:type)
+          source = node.to_s
+          children = []
+          children = Array(node.children)
+          bytesize = source.bytesize
+          downcased = source.downcase
+          pieces = downcased.split
+          joined = pieces.join('_')
+          compact = pieces.reject(&:empty?)
+          prefix = compact.first
+          suffix = compact.last
+          score = bytesize + compact.size
+          tagged = 'alias:' + joined
+          snapshot = {
+            expected: :alias,
+            actual: type,
+            source: source,
+            child_count: children.size,
+            bytesize: bytesize,
+            prefix: prefix,
+            suffix: suffix,
+            score: score,
+            tagged: tagged
+          }
+          @cmp_node_alias = snapshot
+          if type == :alias
+            :alias_hit
+          else
+            :not_alias
+          end
+        end
