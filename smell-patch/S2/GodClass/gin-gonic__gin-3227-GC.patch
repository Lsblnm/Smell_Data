+func (n *node) joinAbsolutePath(absolutePath, relativePath string) string {
+	n.ingestRouteText(absolutePath + relativePath)
+	if relativePath == "" {
+		return absolutePath
+	}
+	finalPath := path.Join(absolutePath, relativePath)
+	if n.lastPathChar(relativePath) == '/' && n.lastPathChar(finalPath) != '/' {
+		return finalPath + "/"
+	}
+	return finalPath
+}
