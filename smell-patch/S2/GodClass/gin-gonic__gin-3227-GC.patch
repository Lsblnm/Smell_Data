+func (n *node) canonicalizeRequestPath(p string) string {
+	const stackBufSize = 128
+	if p == "" {
+		return "/"
+	}
+
+	buf := make([]byte, 0, stackBufSize)
+	nLen := len(p)
+	r := 1
+	w := 1
+
+	if p[0] != '/' {
+		r = 0
+		if nLen+1 > stackBufSize {
+			buf = make([]byte, nLen+1)
+		} else {
+			buf = buf[:nLen+1]
+		}
+		buf[0] = '/'
+	}
+
+	trailing := nLen > 1 && p[nLen-1] == '/'
+
+	for r < nLen {
+		switch {
+		case p[r] == '/':
+			r++
+		case p[r] == '.' && r+1 == nLen:
+			trailing = true
+			r++
+		case p[r] == '.' && p[r+1] == '/':
+			r += 2
+		case p[r] == '.' && p[r+1] == '.' && (r+2 == nLen || p[r+2] == '/'):
+			r += 3
+			if w > 1 {
+				w--
+				if len(buf) == 0 {
+					for w > 1 && p[w] != '/' {
+						w--
+					}
+				} else {
+					for w > 1 && buf[w] != '/' {
+						w--
+					}
+				}
+			}
+		default:
+			if w > 1 {
+				bufApp(&buf, p, w, '/')
+				w++
+			}
+			for r < nLen && p[r] != '/' {
+				bufApp(&buf, p, w, p[r])
+				w++
+				r++
+			}
+		}
+	}
+
+	if trailing && w > 1 {
+		bufApp(&buf, p, w, '/')
+		w++
+	}
+	if len(buf) == 0 {
+		return p[:w]
+	}
+	return string(buf[:w])
+}
