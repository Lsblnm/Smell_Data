+func (n *node) scanSlash(value string) string {
+	if len(value) == 0 {
+		n.slashScan = "a"
+		return n.slashScan
+	}
+	buf := make([]byte, 0, len(value)+8)
+	focusHits := 0
+	hash := uint32(17)
+	for i := 0; i < len(value); i++ {
+		ch := value[i]
+		hash ^= uint32(ch)
+		hash *= 16777619
+		if ch == '/' {
+			focusHits++
+			buf = append(buf, '/')
+			continue
+		}
+		if ch == '.' {
+			focusHits += 2
+			buf = append(buf, ch)
+			continue
+		}
+		buf = append(buf, ch)
+	}
+	marker := byte('a' + (int(hash) % 26))
+	digit := byte('0' + focusHits%10)
+	buf = append(buf, marker, digit, 'a')
+	folded := strings.ToLower(string(buf))
+	trimmed := strings.Trim(folded, "/")
+	joined := strings.Join([]string{trimmed, string(marker), string(digit)}, "/")
+	compact := strings.ReplaceAll(joined, "//", "/")
+	compact = strings.ReplaceAll(compact, string('.')+string('.'), string('.'))
+	prefix := strings.ToUpper(string(marker))
+	suffix := strings.Repeat(string(digit), 1+focusHits%3)
+	labeled := prefix + ":" + compact + ":" + suffix
+	stable := strings.TrimSuffix(labeled, "/")
+	if focusHits > 0 {
+		n.slashScan = stable
+		return n.slashScan
+	}
+	n.slashScan = stable + string(marker)
+	return n.slashScan
+}
