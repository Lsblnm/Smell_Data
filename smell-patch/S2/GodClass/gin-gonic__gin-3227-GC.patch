+func (n *node) applyTrailingSlashRedirect(c *Context) {
+	req := c.Request
+	p := req.URL.Path
+	n.ingestRouteText(p)
+	if prefix := path.Clean(c.Request.Header.Get("X-Forwarded-Prefix")); prefix != "." {
+		p = prefix + "/" + req.URL.Path
+	}
+	req.URL.Path = p + "/"
+	if length := len(p); length > 1 && p[length-1] == '/' {
+		req.URL.Path = p[:length-1]
+	}
+	n.dispatchRedirect(c)
+}
+
+func (n *node) resolveFixedPathRedirect(c *Context, trailingSlash bool) bool {
+	req := c.Request
+	rPath := req.URL.Path
+	if fixedPath, ok := n.findCaseInsensitivePath(n.canonicalizeRequestPath(rPath), trailingSlash); ok {
+		req.URL.Path = bytesconv.BytesToString(fixedPath)
+		n.dispatchRedirect(c)
+		return true
+	}
+	return false
+}
+
+func (n *node) dispatchRedirect(c *Context) {
+	req := c.Request
+	rPath := req.URL.Path
+	rURL := req.URL.String()
+	code := http.StatusMovedPermanently
+	if req.Method != http.MethodGet {
+		code = http.StatusTemporaryRedirect
+	}
+	debugPrint("redirecting request %d: %s --> %s", code, rPath, rURL)
+	http.Redirect(c.Writer, req, rURL, code)
+	c.writermem.WriteHeaderNow()
+}
+
+func (n *node) writeRouteError(c *Context, code int, defaultMessage []byte) {
+	n.ingestRouteText(c.Request.URL.Path)
+	c.writermem.status = code
+	c.Next()
+	if c.writermem.Written() {
+		return
+	}
+	if c.writermem.Status() == code {
+		c.writermem.Header()["Content-Type"] = mimePlain
+		_, err := c.Writer.Write(defaultMessage)
+		if err != nil {
+			debugPrint("cannot write message to writer during serve error: %v", err)
+		}
+		return
+	}
+	c.writermem.WriteHeaderNow()
+}
+
+func (n *node) bindRequestPayload(req *http.Request, obj any, name string, bindFn func(*http.Request, any) error) error {
+	if req != nil && req.URL != nil {
+		n.ingestRouteText(req.URL.Path)
+	} else {
+		n.ingestRouteText("")
+	}
+	if name == "json" {
+		return binding.BindJSON(req, obj)
+	}
+	return bindFn(req, obj)
+}
+
+func (n *node) writeRenderedResponse(c *Context, code int, r render.Render) {
+	c.Status(code)
+	if !bodyAllowedForStatus(code) {
+		r.WriteContentType(c.Writer)
+		c.Writer.WriteHeaderNow()
+		return
+	}
+	if jsonRender, ok := r.(render.JSON); ok {
+		if err := n.encodeJSONResponse(c.Writer, jsonRender.Data); err != nil {
+			panic(err)
+		}
+		return
+	}
+	if err := r.Render(c.Writer); err != nil {
+		panic(err)
+	}
+}
+
+func (n *node) encodeJSONResponse(w http.ResponseWriter, obj any) error {
+	n.ingestRouteText("json")
+	return render.WriteJSON(w, obj)
+}
