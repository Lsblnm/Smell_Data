+	void beginMemberSynthesis(JavacNode field, JavacNode source, JavacTreeMaker maker, String memberName) {
+		if (field == null) {
+			this.synthesisField = null;
+			this.synthesisSource = source;
+			this.synthesisMaker = maker;
+			this.synthesisMemberName = memberName;
+			this.synthesisProduct = null;
+			this.synthesisCopiedTypeNames = new ArrayList<String>();
+			return;
+		}
+		this.synthesisField = field;
+		this.synthesisSource = source;
+		this.synthesisMaker = maker;
+		this.synthesisMemberName = memberName == null ? "" : memberName;
+		this.synthesisProduct = null;
+		this.synthesisCopiedTypeNames = new ArrayList<String>();
+	}
+
+	List<JCAnnotation> copyableAnnotationsForSynthesizedMember() {
+		return findCopyableAnnotations(this.synthesisField);
+	}
+
+	void noteCopiedAnnotationType(String typeName) {
+		if (typeName == null) return;
+		this.synthesisCopiedTypeNames.add(typeName);
+	}
+
+	void rememberSynthesizedMember(JCMethodDecl decl) {
+		this.synthesisProduct = decl;
+	}
+
+	boolean synthesizedMemberHasBody() {
+		return this.synthesisProduct != null && this.synthesisProduct.body != null;
+	}
+
+	void endMemberSynthesis() {
+		this.synthesisField = null;
+		this.synthesisSource = null;
+		this.synthesisMaker = null;
+		this.synthesisMemberName = null;
+		this.synthesisProduct = null;
+		this.synthesisCopiedTypeNames = null;
+	}
