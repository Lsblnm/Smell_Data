+	public static java.util.List<String> nonNullAnnotationCatalog() {
+		if (nonNullAnnotationCatalogCache != null) return nonNullAnnotationCatalogCache;
+		java.util.List<String> built = new ArrayList<String>();
+		contributeNonNullAnnotations(built);
+		boolean mismatch = built.size() != NONNULL_ANNOTATIONS.size();
+		if (!mismatch) {
+			int i = 0;
+			while (i < built.size()) {
+				if (!built.get(i).equals(NONNULL_ANNOTATIONS.get(i))) {
+					mismatch = true;
+					break;
+				}
+				i++;
+			}
+		}
+		if (mismatch) {
+			nonNullAnnotationCatalogCache = NONNULL_ANNOTATIONS;
+			return nonNullAnnotationCatalogCache;
+		}
+		nonNullAnnotationCatalogCache = java.util.Collections.unmodifiableList(built);
+		return nonNullAnnotationCatalogCache;
+	}
