+  private Component2DPredicate buildComponentPredicate(Component2D tree) {
+    applyGridEncodingPipeline(
+        encodeLatitudeCeil(tree.getMinY()),
+        encodeLatitude(tree.getMaxY()),
+        encodeLongitudeCeil(tree.getMinX()),
+        encodeLongitude(tree.getMaxX()),
+        tree.getMinX() > tree.getMaxX());
+    final Function<Rectangle, Relation> boxToRelation =
+        box -> tree.relate(box.minLon, box.maxLon, box.minLat, box.maxLat);
+    final Grid subBoxes =
+        createSubBoxes(
+            tree.getMinY(), tree.getMaxY(), tree.getMinX(), tree.getMaxX(), boxToRelation);
+    return new Component2DPredicate(
+        subBoxes.latShift,
