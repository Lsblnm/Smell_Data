+    def self.audit_multiline_format_keys(conf)
+      maxn = Fluent::Plugin::MultilineParser::FORMAT_MAX_NUM
+      keys = conf.respond_to?(:keys) ? conf.keys : []
+      invalid_formats = keys.select { |k|
+        m = k.to_s.match(/^format(\d+)$/)
+        if m
+          !((1..maxn).include?(m[1].to_i))
+        else
+          false
+        end
+      }
+      unless invalid_formats.empty?
+        raise Fluent::ConfigError, "Invalid formatN found. N should be 1 - #{maxn}: " + invalid_formats.join(",")
+      end
+      true
+    end
+
+    def self.validate_multiline_format_regexp(format, key)
+      text = format.to_s
+      if text[0] == "/" && text[-1] == "/"
+        begin
+          Regexp.new(text[1..-2], Regexp::MULTILINE)
+        rescue => e
+          raise Fluent::ConfigError, "Invalid regexp in #{key}: #{e}"
+        end
+      else
+        raise Fluent::ConfigError, "format should be Regexp, need //, in #{key}: '#{format}'"
+      end
+    end
+
+    def self.collect_multiline_format_patterns(conf)
+      maxn = Fluent::Plugin::MultilineParser::FORMAT_MAX_NUM
+      audit_multiline_format_keys(conf)
+      prev_format = nil
+      (1..maxn).map { |i|
+        format = conf["format#{i}"]
+        if (i > 1) && prev_format.nil? && !format.nil?
+          raise Fluent::ConfigError, "Jump of format index found. format#{i - 1} is missing."
+        end
+        prev_format = format
+        next if format.nil?
+        validate_multiline_format_regexp(format, "format#{i}")
+        format
+      }
+    end
+
+    def self.collect_regexp_named_captures(match)
+      record = {}
+      if match.nil?
+        record
+      else
+        match.names.each do |name|
+          value = match[name]
+          record[name] = value if value
+        end
+        record
+      end
+    end
+
+    def self.seek_after_path_field(file_pos, path, line)
+      extra = path.to_s.bytesize + 1
+      if file_pos.nil?
+        extra
+      else
+        file_pos + extra
+      end
+    end
