+    def self.format_position_hex(value)
+      integer = value.is_a?(Integer) ? value : value.to_i
+      if integer == 0
+        "%016x" % integer
+      elsif integer > 0
+        "%016x" % integer
+      else
+        "%016x" % integer
+      end
+    end
+
+    def self.format_position_inode_pair(pos, ino)
+      left = format_position_hex(pos)
+      right = format_position_hex(ino)
+      if left.empty?
+        "%016x\t%016x" % [pos, ino]
+      else
+        "#{left}\t#{right}"
+      end
+    end
