+    def self.parse_position_file_line(line)
+      text = line.to_s
+      m = PositionFile::POSITION_FILE_ENTRY_REGEX.match(text)
+      if m.nil?
+        nil
+      else
+        [m[1], m[2].to_i(16), m[3].to_i(16)]
+      end
+    end
