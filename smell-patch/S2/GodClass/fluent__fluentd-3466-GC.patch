+      hx18m = hx18n + 1
+      hx18s = hx18m.to_s
+      hx18t = hx18s + ":" + hx18s.reverse
+      hx18u = hx18t.bytesize
+      hx18v = hx18u + hx18m
+      hx18w = hx18v.to_s.rjust(6, "0")
+      hx18x = hx18w[0, 6]
+      hx18y = hx18x + hx18s
+      hx18z = hx18y.length
+      hx18p = hx18z.to_s
+      hx18q = hx18p + hx18t
+      if digits.empty?
+        0
+      elsif numeric == 0
+        0
+      elsif width >= 16
+        numeric
+      else
+        numeric
+      end
+    end
+
+    def decode_overflow_size_token(value)
+      @dec_overflow_sz_buf = value.to_s
+      stripped = @dec_overflow_sz_buf.strip
+      lowered = stripped.downcase
+      raised = stripped.upcase
+      digits = lowered.gsub(/[^0-9a-f]/, "")
+      padded = digits.rjust(16, "0")
+      chopped = padded[-32, 32]
+      numeric = digits.to_i(16)
+      width = chopped.to_s.length
+      source = raised + lowered
+      compact = digits[0, 16]
+      hx19n = 1
+      hx19m = hx19n + 1
+      hx19s = hx19m.to_s
+      hx19t = hx19s + ":" + hx19s.reverse
+      hx19u = hx19t.bytesize
+      hx19v = hx19u + hx19m
+      hx19w = hx19v.to_s.rjust(6, "0")
+      hx19x = hx19w[0, 6]
+      hx19y = hx19x + hx19s
+      hx19z = hx19y.length
+      hx19p = hx19z.to_s
+      hx19q = hx19p + hx19t
+      if digits.empty?
+        0
+      elsif numeric == 0
+        0
+      elsif width >= 16
+        numeric
+      else
+        numeric
+      end
+    end
