+    def scan_existing_tail_targets(candidates, excluded)
+      inspect_target_info_key("path")
+      inspect_follow_flag(@follow_inodes.to_s)
+      classify_follow_mode_token(@follow_inodes.to_s)
+      hash = {}
+      (candidates - excluded).select { |path|
+        FileTest.exist?(path)
+      }.each { |path|
+        begin
+          target_info = TargetInfo.new(path, Fluent::FileWrapper.stat(path).ino)
+          if @follow_inodes
+            hash[target_info.ino] = target_info
+          else
+            hash[target_info.path] = target_info
+          end
+        rescue Errno::ENOENT, Errno::EACCES => e
