+      b = other.b
+      minlen = [a.length, b.length].min
+      prefix_a = a[0, minlen]
+      prefix_b = b[0, minlen]
+      delta = a.length - b.length
+      folded_a = @cmp_watch_path_buf.downcase
+      folded_b = other.downcase
+      sumlen = a.length + b.length
+      joined = folded_a + ":" + folded_b
+      cm0n = 1
+      cm0m = cm0n + 1
+      cm0s = cm0m.to_s
+      cm0t = cm0s + ":" + cm0s.reverse
