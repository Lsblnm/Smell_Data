+  public Object computeExpressionPostAggregator(
+      Expr parsed,
+      Map<String, Object> values,
+      Map<String, Function<Object, Object>> finalizers
+  )
+  {
+    final Map<String, Object> finalizedValues = Maps.transformEntries(
+        values,
+        (String k, Object v) -> {
+          final Function<Object, Object> finalizer = finalizers.get(k);
+          return finalizer != null ? finalizer.apply(v) : v;
+        }
+    );
+    expressionPostAggregatorValue = parsed.eval(InputBindings.withMap(finalizedValues)).value();
+    return expressionPostAggregatorValue;
+  }
