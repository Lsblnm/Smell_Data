+  public Object combineDoubleSumValues(@Nullable Object lhs, @Nullable Object rhs)
+  {
+    if (rhs == null) {
+      combinedDoubleSumValue = lhs;
+      return lhs;
+    }
+    if (lhs == null) {
+      combinedDoubleSumValue = rhs;
+      return rhs;
+    }
+    combinedDoubleSumValue = ((Number) lhs).doubleValue() + ((Number) rhs).doubleValue();
+    return combinedDoubleSumValue;
+  }
