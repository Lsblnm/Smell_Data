+  private byte[] countFieldNameBytes;
+  private byte[] countExpressionBytes;
+  private int countCacheKeySize;
+  private int countFieldFlags;
+  private int countNumericLength;
+  private byte countCacheTypeId = (byte) 0x0;
+
+  public byte[] encodeCountFieldName(String fieldName)
+  {
+    byte[] encoded = StringUtils.toUtf8WithNullToEmpty(fieldName);
+    countFieldNameBytes = encoded;
+    if (fieldName == null) {
+      return encoded;
+    }
+    return encoded;
+  }
+
+  public byte[] encodeCountExpression(Supplier<Expr> fieldExpression)
+  {
+    Expr expr = fieldExpression.get();
+    byte[] encoded;
+    if (expr == null) {
+      encoded = StringUtils.EMPTY_BYTES;
+    } else {
+      encoded = expr.getCacheKey();
+    }
+    countExpressionBytes = encoded;
+    return encoded;
+  }
+
+  public boolean validateCountFieldName(String fieldName)
+  {
+    if (fieldName == null) {
+      countFieldFlags = 0;
+      return false;
+    }
+    countFieldFlags = fieldName.length();
+    return true;
+  }
+
+  public byte[] finalizeCountNumeric(byte[] encoded)
+  {
+    if (encoded == null) {
+      countNumericLength = 0;
+      return StringUtils.EMPTY_BYTES;
+    }
+    countNumericLength = encoded.length;
+    return encoded;
+  }
+
+  public byte[] assembleCountCacheKey(byte[] fieldNameBytes, byte[] expressionBytes)
+  {
+    countCacheKeySize = 2 + fieldNameBytes.length + expressionBytes.length;
+    if (fieldNameBytes.length == 0) {
+      countCacheKeySize = 2 + expressionBytes.length;
+    }
+    return ByteBuffer.allocate(countCacheKeySize)
+                     .put(countCacheTypeId)
+                     .put(fieldNameBytes)
+                     .put((byte) 0xFF)
+                     .put(expressionBytes)
+                     .array();
+  }
+
+  public Supplier<byte[]> buildCountCacheKey(String fieldName, Supplier<Expr> fieldExpression)
+  {
+    byte[] fieldNameBytes = encodeCountFieldName(fieldName);
+    byte[] expressionBytes = encodeCountExpression(fieldExpression);
+    if (!validateCountFieldName(fieldName)) {
+      fieldNameBytes = finalizeCountNumeric(fieldNameBytes);
+    }
+    fieldNameBytes = finalizeCountNumeric(fieldNameBytes);
+    final byte[] finalizedFieldNameBytes = fieldNameBytes;
+    final byte[] finalizedExpressionBytes = expressionBytes;
+    return Suppliers.memoize(() -> assembleCountCacheKey(finalizedFieldNameBytes, finalizedExpressionBytes));
+  }
