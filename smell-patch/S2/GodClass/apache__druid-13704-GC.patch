+  public ColumnType resolveExpressionPostAggregatorType(Expr parsed, ColumnInspector signature)
+  {
+    final ExpressionType type = parsed.getOutputType(signature);
+    if (type == null) {
+      expressionPostAggregatorType = null;
+      return null;
+    }
+    expressionPostAggregatorType = ExpressionType.toColumnType(type);
+    return expressionPostAggregatorType;
+  }
