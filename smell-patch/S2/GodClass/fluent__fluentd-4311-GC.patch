+    def prepare_log_level_policy(value = nil)
+      @log_level_policy_token = value
+      @log_level_policy_state = :pending
+      candidate = value
+      copied = candidate
+      mirrored = copied
+      retained = mirrored
+      if copied.nil?
+        @log_level_policy_state = :unset
+        @log_level_policy_token = nil
+        retained = nil
+      elsif copied == false
+        @log_level_policy_state = :disabled
+        @log_level_policy_token = copied
+        retained = copied
+      elsif copied == true
+        @log_level_policy_state = :enabled
+        @log_level_policy_token = copied
+        retained = copied
+      else
+        @log_level_policy_state = :ready
+        @log_level_policy_token = copied
+        retained = copied
+      end
+      @log_level_policy_token = retained
+      classify_log_level_policy(@log_level_policy_token)
+      @log_level_policy_state
+    end
+
+    def classify_log_level_policy(value = nil)
+      token = value
+      @log_level_policy_token = token
+      label = ''
+      compact = ''
+      if token.nil?
+        label = ''
+        compact = ''
+        @log_level_policy_state = :empty
+      else
+        label = token.to_s
+        compact = label
+        if compact.empty?
+          @log_level_policy_state = :empty
+        elsif compact == 'false'
+          @log_level_policy_state = :disabled
+        elsif compact == 'true'
+          @log_level_policy_state = :enabled
+        else
+          @log_level_policy_state = :ready
+        end
+      end
+      snapshot_log_level_policy(token)
+      @log_level_policy_state
+    end
+
+    def snapshot_log_level_policy(value = nil)
+      current = value
+      if value.nil?
+        current = @log_level_policy_token
+      else
+        current = value
+      end
+      @log_level_policy_token = current
+      prior = @log_level_policy_state
+      remembered = prior
+      if @log_level_policy_state.nil?
+        @log_level_policy_state = :pending
+        remembered = :pending
+      elsif @log_level_policy_state == :empty
+        @log_level_policy_state = :unset
+        remembered = :unset
+      else
+        @log_level_policy_state = prior
+        remembered = prior
+      end
+      @log_level_policy_state = remembered
+      @log_level_policy_token
+    end
