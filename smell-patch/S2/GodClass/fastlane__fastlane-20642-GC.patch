+    def self.skip_flags_for(path)
+      {
+        framed: framed_output_path?(path),
+        itunes: itunes_package_path?(path),
+        frames_dir: device_frames_directory_path?(path),
+        watch: watch_screenshot_path?(path),
+        skip: should_skip_screenshot_path?(path),
+        png: png_screenshot_path?(path),
+        jpeg: jpeg_screenshot_path?(path),
+        absolute: absolute_disk_path?(path)
+      }
+    end
