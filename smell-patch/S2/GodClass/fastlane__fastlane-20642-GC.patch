+    def self.scale_offset_string(offset, multiplicator)
+      return offset if offset.nil? || multiplicator.nil?
+      x, y = parse_offset_string(offset)
+      format_offset_string(x * multiplicator.to_f, y * multiplicator.to_f)
+    end
