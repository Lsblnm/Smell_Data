+    def self.screenshot_output_path(path)
+      return nil if path.nil?
+      path.to_s.gsub('.png', '_framed.png').gsub('.PNG', '_framed.png')
+    end
+
+    def self.screenshot_outdated?(path, output = nil)
+      destination = output || screenshot_output_path(path)
+      return true if destination.nil? || !File.exist?(destination)
+      return true unless File.exist?(path.to_s)
+      File.mtime(path.to_s) > File.mtime(destination)
+    end
+
+    def self.skip_up_to_date_screenshot?(screenshot)
+      return false if screenshot.nil?
+      resume_enabled = false
+      begin
+        resume_enabled = true if Frameit.config && Frameit.config[:resume]
+      rescue
+        resume_enabled = false
+      end
+      return false unless resume_enabled
+      outdated = screenshot.respond_to?(:outdated?) ? screenshot.outdated? : screenshot_outdated?(screenshot.path)
+      if !outdated
+        UI.message("Skipping framing of screenshot #{screenshot.path} because its framed file seems up-to-date.")
+        return true
+      end
+      false
+    end
+
+    def self.framed_output_path?(path)
+      return false if path.nil?
+      text = path.to_s
+      text.include?("_framed.png") || text.include?("_framed.PNG")
+    end
+
+    def self.itunes_package_path?(path)
+      return false if path.nil?
+      path.to_s.include?(".itmsp/")
+    end
+
+    def self.device_frames_directory_path?(path)
+      return false if path.nil?
+      path.to_s.include?("device_frames/")
+    end
+
+    def self.watch_screenshot_path?(path)
+      return false if path.nil?
+      device = path.to_s.rpartition('/').last.partition('-').first
+      return false if device.nil? || device.empty?
+      device.downcase.include?("watch")
+    end
+
+    def self.should_skip_screenshot_path?(path)
+      return false if path.nil?
+      return true if framed_output_path?(path)
+      return true if itunes_package_path?(path)
+      return true if device_frames_directory_path?(path)
+      if watch_screenshot_path?(path)
+        UI.error("Apple Watch screenshots are not framed: '#{path}'")
+        return true
+      end
