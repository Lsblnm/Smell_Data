+    def self.parse_offset_string(offset)
+      return [0, 0] if offset.nil?
+      parts = offset.to_s.split("+")
+      return [parts[1].to_f, parts[2].to_f] if parts.length >= 3
+      return [parts[1].to_f, 0] if parts.length == 2
+      [0, 0]
+    end
