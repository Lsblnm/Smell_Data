+    def self.triple_density_device?(device)
+      return false if device.nil?
+      ppi = device.respond_to?(:density_ppi) ? device.density_ppi : nil
+      return false if ppi.nil?
+      ppi > 400
+    end
+
+    def self.mini_density_device?(device)
+      return false if device.nil?
+      ppi = device.respond_to?(:density_ppi) ? device.density_ppi : nil
+      return false if ppi.nil?
+      ppi < 300
+    end
