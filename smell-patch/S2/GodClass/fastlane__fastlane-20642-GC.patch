+    def self.lookup_catalog_value(catalog, filename)
+      return nil if catalog.nil? || filename.nil?
+      direct = catalog[filename]
+      return direct unless direct.nil?
+      lowered = filename.to_s.downcase
+      catalog.each do |needle, value|
+        token = needle.to_s
+        return value if filename.include?(token)
+        return value if lowered.include?(token.downcase)
+      end
+      nil
+    end
+
+    def self.enrich_profile_with_catalogs(profile, filename)
+      return profile if profile.nil?
+      profile[:portrait_width] = lookup_catalog_value(portrait_width_catalog, filename)
+      profile[:portrait_height] = lookup_catalog_value(portrait_height_catalog, filename)
+      profile[:landscape_width] = lookup_catalog_value(landscape_width_catalog, filename)
+      profile[:landscape_height] = lookup_catalog_value(landscape_height_catalog, filename)
+      profile[:catalog_ppi] = lookup_catalog_value(ppi_catalog, filename)
+      profile[:catalog_color] = lookup_catalog_value(default_color_catalog, filename)
+      profile[:catalog_platform] = lookup_catalog_value(platform_catalog, filename)
+      profile[:catalog_deliver] = lookup_catalog_value(deliver_size_catalog, filename)
+      profile[:catalog_id] = lookup_catalog_value(id_catalog, filename)
+      profile[:pixel_count] = lookup_catalog_value(pixel_count_catalog, filename)
+      profile[:short_side] = lookup_catalog_value(short_side_catalog, filename)
+      profile[:long_side] = lookup_catalog_value(long_side_catalog, filename)
+      profile[:aspect_value] = lookup_catalog_value(aspect_catalog, filename)
+      profile[:offset_key] = lookup_catalog_value(offset_key_catalog, filename)
+      profile[:family_group] = lookup_catalog_value(family_group_catalog, filename)
+      profile[:density_band] = lookup_catalog_value(density_band_catalog, filename)
+      profile[:notch] = lookup_catalog_value(notch_catalog, filename)
+      profile[:home_button] = lookup_catalog_value(home_button_catalog, filename)
+      profile[:pro_variant] = lookup_catalog_value(pro_variant_catalog, filename)
+      profile[:max_variant] = lookup_catalog_value(max_variant_catalog, filename)
+      profile[:mini_variant] = lookup_catalog_value(mini_variant_catalog, filename)
+      profile
+    end
+
   end
