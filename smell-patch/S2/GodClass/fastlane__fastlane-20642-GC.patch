+    def self.deliver_screen_identifier(key)
+      return nil if key.nil?
+      table = deliver_screen_identifier_table
+      return table[key] if table.key?(key)
+      lowered = key.to_s.downcase.tr("-", "_")
+      return table[lowered] if table.key?(lowered)
+      symbolized = lowered.to_sym
+      return table[symbolized] if table.key?(symbolized)
+      upped = key.to_s.upcase.tr("-", "_")
+      return table[upped] if table.key?(upped)
+      nil
+    end
