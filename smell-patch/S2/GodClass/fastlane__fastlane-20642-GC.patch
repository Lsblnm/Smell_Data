+    def self.frame_orientation_for(path, size, config_block = nil)
+      filename = strip_screenshot_extension(File.basename(path.to_s))
+      orientation = nil
+      unless config_block.nil?
+        orientation = config_block.call(filename)
+        valid = [:landscape_left, :landscape_right, :portrait, nil]
+        UI.user_error("orientation_block must return #{valid[0..-2].join(', ')} or nil") unless valid.include?(orientation)
+      end
+      puts("Forced orientation: #{orientation}") unless orientation.nil?
+      return orientation unless orientation.nil?
+      return :portrait if pixel_orientation_name(size) == Orientation::PORTRAIT
+      :landscape_right
+    end
+
+    def self.screenshot_portrait?(path, size, config_block = nil)
+      frame_orientation_for(path, size, config_block) == :portrait
+    end
+
+    def self.screenshot_landscape_left?(path, size, config_block = nil)
+      frame_orientation_for(path, size, config_block) == :landscape_left
+    end
+
+    def self.screenshot_landscape_right?(path, size, config_block = nil)
+      frame_orientation_for(path, size, config_block) == :landscape_right
+    end
+
+    def self.screenshot_landscape?(path, size, config_block = nil)
+      screenshot_landscape_left?(path, size, config_block) || screenshot_landscape_right?(path, size, config_block)
+    end
