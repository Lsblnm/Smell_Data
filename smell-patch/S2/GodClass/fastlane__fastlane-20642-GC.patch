+    def self.legacy_iphone_35_frame?(screenshot)
+      return false if screenshot.nil?
+      screen_id = screenshot.respond_to?(:deliver_screen_id) ? screenshot.deliver_screen_id : nil
+      screen_id = screenshot.device.deliver_screen_id if screen_id.nil? && screenshot.respond_to?(:device) && screenshot.device
+      screen_id == Deliver::AppScreenshot::ScreenSize::IOS_35
+    end
