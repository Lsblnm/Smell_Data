+    def self.rotation_for_screenshot(screenshot)
+      return 0 if screenshot.nil?
+      return 90 if screenshot.respond_to?(:landscape_right?) && screenshot.landscape_right?
+      return -90 if screenshot.respond_to?(:landscape_left?) && screenshot.landscape_left?
+      0
