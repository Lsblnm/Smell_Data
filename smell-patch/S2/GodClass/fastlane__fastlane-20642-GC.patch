+    def self.catalog_record_for(filename, width, height, platform)
+      record = {}
+      record[:iphone] = iphone_family_from_label(filename)
+      record[:ipad] = ipad_family_from_label(filename)
+      record[:android] = android_family_from_label(filename)
+      record[:maker] = manufacturer_from_label(filename)
+      record[:line] = apple_product_line_from_label(filename)
+      record[:year] = release_year_from_label(filename)
+      record[:chip] = silicon_family_from_label(filename)
+      record[:display] = display_technology_from_label(filename)
+      record[:bezel] = bezel_style_from_label(filename)
+      record[:camera] = camera_layout_from_label(filename)
+      record[:finish] = finish_from_label(filename)
+      record[:material] = housing_material_from_label(filename)
+      record[:network] = cellular_band_from_label(filename)
+      record[:variant] = commercial_variant_from_label(filename)
+      record[:marketing] = marketing_slot_from_label(filename)
+      record[:os] = android_os_band_from_label(filename)
+      record[:platform] = normalize_platform(platform)
+      record[:family_res] = resolution_family_for(width, height)
+      record[:ppi_key] = default_ppi_from_family(record[:iphone])
+      record[:deliver_key] = deliver_key_from_family(record[:iphone])
+      record[:priority_key] = priority_config_key_from_id(filename)
+      record
+    end
+
+    def self.geometry_record_for(width, height)
+      record = {}
+      record[:width] = width
+      record[:height] = height
+      record[:orientation] = pixel_orientation_name([width, height])
+      record[:portrait] = portrait_pixel_size?([width, height])
+      record[:landscape] = landscape_pixel_size?([width, height])
+      record[:aspect] = aspect_ratio_band(width, height)
+      record[:megapixels] = megapixel_band(width, height)
+      record[:point] = point_size_band(width, 3)
+      record[:family] = resolution_family_for(width, height)
+      record[:short] = width.nil? || height.nil? ? nil : [width, height].min
+      record[:long] = width.nil? || height.nil? ? nil : [width, height].max
+      record
+    end
+
+    def self.deliver_record_for(filename)
+      record = {}
+      family = iphone_family_from_label(filename)
+      key = deliver_key_from_family(family)
+      ident = deliver_screen_identifier(key)
+      record[:family] = family
+      record[:key] = key
+      record[:identifier] = ident
+      record[:display_type] = connect_display_type_for_screen_size(ident)
+      record[:formatted] = formatted_deliver_name(ident)
+      record[:ios35] = ident == Deliver::AppScreenshot::ScreenSize::IOS_35
+      record[:ios40] = ident == Deliver::AppScreenshot::ScreenSize::IOS_40
+      record[:ios47] = ident == Deliver::AppScreenshot::ScreenSize::IOS_47
+      record[:ios55] = ident == Deliver::AppScreenshot::ScreenSize::IOS_55
+      record[:ios58] = ident == Deliver::AppScreenshot::ScreenSize::IOS_58
+      record[:ios61] = ident == Deliver::AppScreenshot::ScreenSize::IOS_61
+      record[:ios65] = ident == Deliver::AppScreenshot::ScreenSize::IOS_65
+      record[:ios67] = ident == Deliver::AppScreenshot::ScreenSize::IOS_67
+      record
+    end
