+    def self.color_fallback_chain(screenshot)
+      return [] if screenshot.nil?
+      chain = []
+      chain << screenshot.color unless screenshot.color.nil?
+      chain << screenshot.default_color unless screenshot.default_color.nil?
+      if screenshot.respond_to?(:device) && screenshot.device
+        chain << screenshot.device.default_color unless screenshot.device.default_color.nil?
+      end
+      chain.compact.uniq
+    end
