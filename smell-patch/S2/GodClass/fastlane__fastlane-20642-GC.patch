+    def self.frame_plan_for(filename, width, height, platform)
+      plan = {}
+      plan[:filename] = filename
+      plan[:tokens] = tokenize_screenshot_filename(filename)
+      plan[:color] = color_name_from_label(filename)
+      plan[:template_name] = frame_file_name(filename, plan[:color])
+      plan[:offset_key] = sanitize_frame_device_name(filename)
+      plan[:platform] = normalize_platform(platform)
+      plan[:rotation] = rotation_degrees_for_orientation(orientation_hint_from_label(filename))
+      plan[:family] = resolution_family_for(width, height)
+      plan[:cli_color] = resolve_cli_frame_color(nil, Frameit.config) if defined?(Frameit) && Frameit.config
+      plan[:padding_h] = horizontal_padding_from(nil)
+      plan[:padding_v] = vertical_padding_from(nil)
+      plan
+    end
+
+    def self.png_screenshot_path?(path)
+      return false if path.nil?
+      lowered = path.to_s.downcase
+      lowered.end_with?(".png")
+    end
+
+    def self.jpeg_screenshot_path?(path)
+      return false if path.nil?
+      lowered = path.to_s.downcase
+      lowered.end_with?(".jpg") || lowered.end_with?(".jpeg")
+    end
+
+    def self.absolute_disk_path?(path)
+      return false if path.nil?
+      text = path.to_s
+      text.start_with?("/") || text =~ /\A[A-Za-z]:[\\\/]/
+    end
