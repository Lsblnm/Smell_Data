+    def self.build_detection_profile(path, size, platform)
+      filename = Pathname.new(path).basename.to_s
+      width = size && size[0]
+      height = size && size[1]
+      profile = {}
+      profile[:tokens] = tokenize_screenshot_filename(filename)
+      profile[:normalized] = normalize_lookup_text(filename)
+      profile[:orientation] = pixel_orientation_name(size)
+      profile[:orientation_hint] = orientation_hint_from_label(filename)
+      profile[:resolution_family] = resolution_family_for(width, height)
+      profile[:resolution_hint] = filename_resolution_hint(filename)
+      profile[:iphone_family] = iphone_family_from_label(filename)
+      profile[:ipad_family] = ipad_family_from_label(filename)
+      profile[:android_family] = android_family_from_label(filename)
+      profile[:manufacturer] = manufacturer_from_label(filename)
+      profile[:color] = color_name_from_label(filename)
+      profile[:platform] = normalize_platform(platform)
+      profile[:platform_hint] = platform_from_label(filename)
+      profile[:language] = screenshot_language_from_path(path)
+      profile[:locale] = locale_hint_from_label(filename)
+      profile[:skip] = should_skip_screenshot_path?(path)
+      profile[:file_kind] = file_kind_from_label(filename)
+      profile[:imessage] = imessage_variant_from_path(path)
+      profile[:bezel] = bezel_style_from_label(filename)
+      profile[:camera] = camera_layout_from_label(filename)
+      profile[:finish] = finish_from_label(filename)
+      profile[:sim_region] = sim_region_from_label(filename)
+      profile[:release_year] = release_year_from_label(filename)
+      profile[:apple_line] = apple_product_line_from_label(filename)
+      profile[:android_os] = android_os_band_from_label(filename)
+      profile[:density_name] = density_name_from_label(filename)
+      profile[:marketing] = marketing_slot_from_label(filename)
+      profile[:variant] = commercial_variant_from_label(filename)
+      profile[:material] = housing_material_from_label(filename)
+      profile[:network] = cellular_band_from_label(filename)
+      profile[:chip] = silicon_family_from_label(filename)
+      profile[:display] = display_technology_from_label(filename)
+      profile[:aspect] = aspect_ratio_band(width, height)
+      profile[:megapixels] = megapixel_band(width, height)
+      profile[:ppi_band] = ppi_band_for(nil)
+      profile[:priority_band] = priority_band_for(0)
+      profile[:point_band] = point_size_band(width, 3)
+      profile[:padding_band] = padding_scale_band(40)
+      profile[:catalog] = catalog_record_for(filename, width, height, platform)
+      profile[:geometry] = geometry_record_for(width, height)
+      profile[:deliver] = deliver_record_for(filename)
+      profile[:skip_flags] = skip_flags_for(path)
+      profile[:frame_plan] = frame_plan_for(filename, width, height, platform)
+      enrich_profile_with_catalogs(profile, filename)
+      @last_detection_profile = profile
+      profile
+    end
