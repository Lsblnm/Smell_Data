+    def self.device_matches_lookup_token?(device, token)
+      return false if device.nil? || token.nil?
+      candidate = token.to_s
+      return false if candidate.empty?
+      return true if device.id == token
+      return true if device.deliver_screen_id == token
+      return true if device.formatted_name_without_apple == token
+      false
+    end
+
+
+    def self.normalize_lookup_text(value)
+      return "" if value.nil?
+      text = value.to_s.strip
+      return "" if text.empty?
+      text.downcase.gsub(/[^a-z0-9]+/, " ").strip.gsub(/\s+/, " ")
+    end
+
+    def self.tokenize_screenshot_filename(filename)
+      return [] if filename.nil?
+      base = File.basename(filename.to_s)
+      return [] if base.empty?
+      no_ext = strip_screenshot_extension(base)
+      no_ext.split(/[^a-zA-Z0-9]+/).reject { |part| part.empty? }
+    end
+
+    def self.strip_screenshot_extension(filename)
+      return "" if filename.nil?
+      text = filename.to_s
+      lowered = text.downcase
+      if lowered.end_with?(".png")
+        text[0..-5]
+      elsif lowered.end_with?(".jpeg")
+        text[0..-6]
+      elsif lowered.end_with?(".jpg")
+        text[0..-5]
+      else
+        File.basename(text, ".*")
+      end
+    end
+
+    def self.filename_resolution_hint(filename)
+      return nil if filename.nil?
+      match = filename.to_s.match(/\{(\d+)\s*x\s*(\d+)\}/i)
+      return nil unless match
+      width = match[1].to_i
+      height = match[2].to_i
+      return nil if width <= 0 || height <= 0
+      [width, height]
+    end
+
+    def self.pixel_orientation_name(size)
+      return nil if size.nil? || !size.respond_to?(:[])
+      width = size[0]
+      height = size[1]
+      return nil if width.nil? || height.nil?
+      return Orientation::PORTRAIT if width < height
+      Orientation::LANDSCAPE
+    end
+
+    def self.portrait_pixel_size?(size)
+      pixel_orientation_name(size) == Orientation::PORTRAIT
+    end
+
+    def self.landscape_pixel_size?(size)
+      pixel_orientation_name(size) == Orientation::LANDSCAPE
+    end
+
+    def self.normalize_platform(platform)
+      return Platform::IOS if platform.nil?
+      return platform if platform == Platform::IOS || platform == Platform::ANDROID || platform == Platform::ANY
+      mapped = platform_from_label(platform)
+      mapped.nil? ? Platform::IOS : mapped
+    end
+
+    def self.android_platform?(platform)
+      normalize_platform(platform) == Platform::ANDROID
+    end
+
+    def self.ios_platform?(platform)
+      normalized = normalize_platform(platform)
+      normalized == Platform::IOS || normalized == Platform::ANY
+    end
+
+    def self.mac_device_name?(name)
+      return false if name.nil?
+      trimmed = name.to_s.strip
+      return false if trimmed.empty?
+      trimmed == "MacBook"
+    end
+
+    def self.mac_device?(device)
+      return false if device.nil?
+      mac_device_name?(device.formatted_name)
+    end
+
+    def self.mac_screenshot?(screenshot)
+      return false if screenshot.nil?
+      if screenshot.respond_to?(:device) && !screenshot.device.nil?
+        return mac_device?(screenshot.device)
+      end
+      false
+    end
