+public JCTree.JCMethodDecl javacEquals_createEquals(JavacNode typeNode, java.util.List<Included<JavacNode, EqualsAndHashCode.Include>> members, boolean callSuper, FieldAccess fieldAccess, boolean needsCanEqual, JavacNode source, List<JCAnnotation> onParam) {
+		JavacTreeMaker maker = typeNode.getTreeMaker();
+
+		Name oName = typeNode.toName("o");
+		Name otherName = typeNode.toName("other");
+		Name thisName = typeNode.toName("this");
+
+		List<JCAnnotation> annsOnParamOnMethod = List.nil();
+
+		JCAnnotation overrideAnnotation = maker.Annotation(genJavaLangTypeRef(typeNode, "Override"), List.<JCExpression>nil());
+		List<JCAnnotation> annsOnMethod = List.of(overrideAnnotation);
