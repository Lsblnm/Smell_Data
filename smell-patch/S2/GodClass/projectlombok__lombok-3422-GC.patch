+public void javacWith_createWithForFields(AccessLevel level, Collection<JavacNode> fieldNodes, JavacNode errorNode, boolean whineIfExists, List<JCAnnotation> onMethod, List<JCAnnotation> onParam) {
+		for (JavacNode fieldNode : fieldNodes) {
+			javacWith_createWithForField(level, fieldNode, errorNode, whineIfExists, onMethod, onParam);
+		}
+	}
