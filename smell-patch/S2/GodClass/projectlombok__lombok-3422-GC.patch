+public final boolean javacBuilder_toBoolean(Object expr, boolean defaultValue) {
+		if (expr == null) return defaultValue;
+		if (expr instanceof JCLiteral) return ((Integer) ((JCLiteral) expr).value) != 0;
+		return ((Boolean) expr).booleanValue();
+	}
+public void javacBuilder_handle(AnnotationValues<Builder> annotation, JCAnnotation ast, JavacNode annotationNode) {
