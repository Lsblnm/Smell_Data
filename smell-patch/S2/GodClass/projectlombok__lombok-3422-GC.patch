+		AccessLevel access = annotation.getInstance().access();
+		if (access == null) access = AccessLevel.PUBLIC;
+		if (access == AccessLevel.NONE) {
+			annotationNode.addError("AccessLevel.NONE is not valid here");
+			access = AccessLevel.PUBLIC;
+		}
+
+		javacStandardException_generateNoArgsConstructor(typeNode, access, annotationNode);
+		javacStandardException_generateMsgOnlyConstructor(typeNode, access, annotationNode);
+		javacStandardException_generateCauseOnlyConstructor(typeNode, access, annotationNode);
+		javacStandardException_generateFullConstructor(typeNode, access, annotationNode);
