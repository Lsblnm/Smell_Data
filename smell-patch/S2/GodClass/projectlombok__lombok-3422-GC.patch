+public void javacWith_generateWithForField(JavacNode fieldNode, DiagnosticPosition pos, AccessLevel level) {
+		if (hasAnnotation(With.class, fieldNode)) {
+			//The annotation will make it happen, so we can skip it.
+			return;
+		}
+
+		javacWith_createWithForField(level, fieldNode, fieldNode, false, List.<JCAnnotation>nil(), List.<JCAnnotation>nil());
+	}
