+public boolean javacStandardException_isLocalType(JavacNode type) {
+		Kind kind = type.up().getKind();
+		if (kind == Kind.COMPILATION_UNIT) return false;
+		if (kind == Kind.TYPE) return javacStandardException_isLocalType(type.up());
+		return true;
+	}
