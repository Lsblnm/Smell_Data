+public void javacStandardException_generateNoArgsConstructor(JavacNode typeNode, AccessLevel level, JavacNode source) {
+		if (javacStandardException_hasConstructor(typeNode) != MemberExistsResult.NOT_EXISTS) return;
+		JavacTreeMaker maker = typeNode.getTreeMaker();
+
+		List<JCExpression> args = List.<JCExpression>of(maker.Literal(CTC_BOT, null), maker.Literal(CTC_BOT, null));
+		JCStatement thisCall = maker.Exec(maker.Apply(List.<JCExpression>nil(), maker.Ident(typeNode.toName("this")), args));
+		JCTree.JCMethodDecl constr = javacStandardException_createConstructor(level, typeNode, false, false, source, List.of(thisCall));
+		injectMethod(typeNode, constr);
+	}
+
+public void javacStandardException_generateMsgOnlyConstructor(JavacNode typeNode, AccessLevel level, JavacNode source) {
+		if (javacStandardException_hasConstructor(typeNode, String.class) != MemberExistsResult.NOT_EXISTS) return;
+		JavacTreeMaker maker = typeNode.getTreeMaker();
+
+		List<JCExpression> args = List.<JCExpression>of(maker.Ident(typeNode.toName("message")), maker.Literal(CTC_BOT, null));
+		JCStatement thisCall = maker.Exec(maker.Apply(List.<JCExpression>nil(), maker.Ident(typeNode.toName("this")), args));
+		JCTree.JCMethodDecl constr = javacStandardException_createConstructor(level, typeNode, true, false, source, List.of(thisCall));
+		injectMethod(typeNode, constr);
+	}
