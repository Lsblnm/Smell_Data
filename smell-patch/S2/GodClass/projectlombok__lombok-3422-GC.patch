+public void javacCleanup_doAssignmentCheck(JavacNode node, List<JCStatement> statements, Name name) {
+		for (JCStatement statement : statements) javacCleanup_doAssignmentCheck0(node, statement, name);
+	}
+
+public void javacCleanup_doAssignmentCheck0(JavacNode node, JCTree statement, Name name) {
+		if (statement instanceof JCAssign) javacCleanup_doAssignmentCheck0(node, ((JCAssign)statement).rhs, name);
+		if (statement instanceof JCExpressionStatement) javacCleanup_doAssignmentCheck0(node,
+				((JCExpressionStatement)statement).expr, name);
+		if (statement instanceof JCVariableDecl) javacCleanup_doAssignmentCheck0(node, ((JCVariableDecl)statement).init, name);
+		if (statement instanceof JCTypeCast) javacCleanup_doAssignmentCheck0(node, ((JCTypeCast)statement).expr, name);
+		if (statement instanceof JCIdent) {
+			if (((JCIdent)statement).name.contentEquals(name)) {
+				JavacNode problemNode = node.getNodeFor(statement);
+				if (problemNode != null) problemNode.addWarning(
+				"You're assigning an auto-cleanup variable to something else. This is a bad idea.");
+			}
+		}
+	}
