+public void javacWithBy_generateWithByForField(JavacNode fieldNode, DiagnosticPosition pos, AccessLevel level) {
+		if (hasAnnotation(WithBy.class, fieldNode)) {
+			//The annotation will make it happen, so we can skip it.
+			return;
+		}
+
+		javacWithBy_createWithByForField(level, fieldNode, fieldNode, false, List.<JCAnnotation>nil());
+	}
