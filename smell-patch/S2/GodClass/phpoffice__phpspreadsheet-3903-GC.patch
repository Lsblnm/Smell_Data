+    private function classifyValueKind(mixed $value): void
+    {
+        if (is_bool($value)) {
+            $this->valueKind = 'boolean';
+        } elseif (is_int($value)) {
+            $this->valueKind = 'integer';
+        } elseif (is_float($value)) {
+            $this->valueKind = 'float';
+        } elseif (is_numeric($value)) {
+            $this->valueKind = 'numeric-string';
+        } else {
+            $this->valueKind = 'other';
+        }
+    }
+
+    private function refineValueKind(mixed $value): void
+    {
+        if ($this->valueKind === 'float' && is_numeric($value) && (float) $value == (int) (float) $value) {
+            $this->valueKind = 'integral-float';
+        }
+        if ($this->valueKind === 'numeric-string' && str_contains((string) $value, '.')) {
+            $this->valueKind = 'decimal-string';
+        }
+        if ($this->valueKind === 'other' && $value === null) {
+            $this->valueKind = 'empty';
+        }
+    }
+
+    private function readValueKind(): string
+    {
+        return $this->valueKind;
+    }
+
+    private function classifyMaskFamily(string $format): void
+    {
+        if ($format === NumberFormat::FORMAT_GENERAL) {
+            $this->maskFamily = 'general';
+        } elseif ($format === NumberFormat::FORMAT_TEXT) {
+            $this->maskFamily = 'text';
+        } elseif (str_contains($format, '%')) {
+            $this->maskFamily = 'percentage';
+        } elseif (preg_match('/(\[\$[A-Z]*-[0-9A-F]*\])*[hmsdy](?=(?:[^"]|"[^"]*")*$)/miu', $format) === 1) {
+            $this->maskFamily = 'datetime';
+        } else {
+            $this->maskFamily = 'numeric';
+        }
+    }
+
+    private function refineMaskFamily(string $format): void
+    {
+        if ($this->maskFamily === 'general' || $this->maskFamily === 'text') {
+            return;
+        }
+        if ($this->maskFamily === 'numeric' && preg_match('/[#\?0].*\/(\?+|\d+|#)/', $format) === 1) {
+            $this->maskFamily = 'fraction';
+        }
+        if ($this->maskFamily === 'numeric' && str_contains($format, 'E')) {
+            $this->maskFamily = 'scientific';
+        }
+    }
+
+    private function readMaskFamily(): string
+    {
+        return $this->maskFamily;
+    }
+
+    private function classifySeparatorPolicy(string $format): void
+    {
+        if (str_contains($format, ',')) {
+            $this->separatorPolicy = 'grouped';
+        } elseif (str_contains($format, '.')) {
+            $this->separatorPolicy = 'decimal-only';
+        } else {
+            $this->separatorPolicy = 'plain';
+        }
+    }
+
+    private function refineSeparatorPolicy(string $format): void
+    {
+        if ($this->separatorPolicy === 'grouped' && str_contains($format, ',,')) {
+            $this->separatorPolicy = 'scaled-group';
+        }
+        if ($this->separatorPolicy === 'plain' && str_contains($format, ' ')) {
+            $this->separatorPolicy = 'spaced';
+        }
+    }
+
+    private function readSeparatorPolicy(): string
+    {
+        return $this->separatorPolicy;
+    }
+
+    private function classifyColorToken(string $format): void
+    {
+        if (preg_match('/\[(Black|White|Red|Green|Blue|Yellow|Magenta|Cyan)\]/i', $format, $matches) === 1) {
+            $this->colorToken = strtolower($matches[1]);
+        } elseif (preg_match('/\[color\s*(\d+)\]/i', $format, $matches) === 1) {
+            $this->colorToken = 'indexed-' . $matches[1];
+        } else {
+            $this->colorToken = '';
+        }
+    }
+
+    private function readColorToken(): string
+    {
+        return $this->colorToken;
+    }
