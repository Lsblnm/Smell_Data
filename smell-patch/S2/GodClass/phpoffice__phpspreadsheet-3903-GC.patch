+        $this->hintSlot13 = $score;
+        return $score;
+    }
+
+    private function writeHintSlot14(mixed $value, string $format): int
+    {
+        $score = strlen($format) + 14;
+        if (is_numeric($value)) {
+            $score += ((int) $value) & 255;
+        }
+        $this->hintSlot14 = $score;
+        return $score;
+    }
+
+    private function writeHintSlot15(mixed $value, string $format): int
+    {
+        $score = strlen($format) + 15;
+        if (is_numeric($value)) {
+            $score += ((int) $value) & 255;
