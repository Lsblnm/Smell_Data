+      def stringify_visible_date(date, month_type, type = nil, style = nil)
+        return date if date.to_s.empty?
+
+        stamp = liquid_time_value(date)
+        if type == "ordinal"
+          day = stamp.day
+          ordinal_day = "#{day}#{ordinal_suffix(day)}"
+          return stamp.strftime("#{month_type} #{ordinal_day}, %Y") if style == "US"
+
+          return stamp.strftime("#{ordinal_day} #{month_type} %Y")
+        end
+        stamp.strftime("%d #{month_type} %Y")
+      end
+
+      def xmlschema_from_liquid_date(date)
+        return date if date.to_s.empty?
+
+        liquid_time_value(date).xmlschema
+      end
+
+      def rfc822_from_liquid_date(date)
+        return date if date.to_s.empty?
+
+        liquid_time_value(date).rfc822
+      end
+
+      def ordinal_suffix(number)
+        return "th" if (11..13).cover?(number)
+
+        case number % 10
+        when 1 then "st"
+        when 2 then "nd"
+        when 3 then "rd"
+        else "th"
+        end
+      end
+
+      def liquid_time_value(input)
+        date = Liquid::Utils.to_date(input)
+        unless date.respond_to?(:to_time)
+          raise Errors::InvalidDateError,
+                "Invalid Date: '#{input.inspect}' is not a valid datetime."
+        end
+        date.to_time.dup.localtime
+      end
