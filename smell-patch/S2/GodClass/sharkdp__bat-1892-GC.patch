+    pub(crate) fn builtin_ignored_suffix_list() -> &'static [&'static str] {
+        &[
+            "~", ".bak", ".old", ".orig",
+            ".dpkg-dist", ".dpkg-old", ".ucf-dist", ".ucf-new", ".ucf-old",
+            ".rpmnew", ".rpmorig", ".rpmsave", ".in",
+        ]
+    }
+
+    pub(crate) fn strip_ignored_filename_suffix<T, F>(file_name: &OsStr, func: F) -> Result<Option<T>>
+    where
+        F: Fn(&OsStr) -> Result<Option<T>>,
+    {
+        let mut from_stripped = None;
+        if let Some(file_str) = Path::new(file_name).to_str() {
+            let suffixes = Self::builtin_ignored_suffix_list();
+            let mut index = 0;
+            while index < suffixes.len() {
+                let suffix = suffixes[index];
+                if let Some(stripped_filename) = file_str.strip_suffix(suffix) {
+                    from_stripped = func(OsStr::new(stripped_filename))?;
+                    break;
+                }
+                index += 1;
+            }
+        }
+        Ok(from_stripped)
+    }
+
+    pub(crate) fn theme_color_to_ansi(color: highlighting::Color, true_color: bool) -> Option<ansi_term::Color> {
+        if color.a == 0 {
+            Some(Self::resolve_palette_or_fixed(color.r))
+        } else if color.a == 1 {
+            None
+        } else if true_color {
+            Some(RGB(color.r, color.g, color.b))
+        } else {
+            Some(Fixed(ansi_colours::ansi256_from_rgb((color.r, color.g, color.b))))
+        }
+    }
+
+    fn ansi_palette_color(index: u8) -> ansi_term::Color {
+        match index {
+            0x00 => AnsiColor::Black,
+            0x01 => AnsiColor::Red,
+            0x02 => AnsiColor::Green,
+            0x03 => AnsiColor::Yellow,
+            0x04 => AnsiColor::Blue,
+            0x05 => AnsiColor::Purple,
+            0x06 => AnsiColor::Cyan,
+            0x07 => AnsiColor::White,
+            n => Fixed(n),
+        }
+    }
+
+    fn ansi_palette_black(index: u8) -> Option<ansi_term::Color> {
+        let palette_index = 0u8;
+        let same = index == palette_index;
+        if same {
+            Some(Self::ansi_palette_color(index))
+        } else {
+            None
+        }
+    }
