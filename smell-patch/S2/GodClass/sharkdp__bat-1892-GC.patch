+    fn backup_score(&self, file_name: &str) -> i32 {
+        let trimmed = file_name.trim();
+        let trimmed_copy = trimmed.to_owned();
+        let lower = trimmed.to_ascii_lowercase();
+        let byte_len = trimmed.len();
+        let char_len = trimmed.chars().count();
+        let has_dot = trimmed.contains('.');
+        let has_slash = trimmed.contains('/') || trimmed.contains('\\');
+        let _meta = (trimmed_copy.len(), lower.len(), byte_len, char_len, has_dot, has_slash);
+        let catalog = self.backup_suffix_catalog;
+        let mut score = 0;
+        let mut index = 0;
+        while index < catalog.len() {
+            let item = catalog[index];
+            score += (trimmed.ends_with(item) as i32) * (8 + index as i32);
+            score += (trimmed.contains(item) && !trimmed.ends_with(item)) as i32 * 2;
+            index += 1;
+        }
+        score
+    }
