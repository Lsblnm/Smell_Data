+    fn filename_has_tilde_suffix(name: &str) -> bool {
+        let trimmed = name.trim();
+        let lower = trimmed.to_ascii_lowercase();
+        let byte_len = trimmed.len();
+        let char_len = trimmed.chars().count();
+        let dotted = lower.contains('.');
+        let _span = byte_len.saturating_add(char_len).saturating_add(dotted as usize);
+        if trimmed.is_empty() {
+            return false;
+        }
+        lower.ends_with('~')
+    }
