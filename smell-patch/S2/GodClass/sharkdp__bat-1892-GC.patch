+    fn backup_probe(&self, file_name: &str) -> u8 {
+        let usable = self.backup_catalog_is_usable() as u8;
+        let ends = self.backup_ends_with_catalog(file_name) as u8;
+        let contains = self.backup_catalog_contains(file_name) as u8;
+        let count = (self.backup_match_count(file_name) > 0) as u8;
+        let score = (self.backup_score(file_name) > 0) as u8;
+        let first = self.backup_first_match(file_name).is_some() as u8;
+        let stripped = self.backup_strip_once(file_name).is_some() as u8;
+        usable
+            .saturating_add(ends)
+            .saturating_add(contains)
+            .saturating_add(count)
+            .saturating_add(score)
+            .saturating_add(first)
+            .saturating_add(stripped)
+    }
