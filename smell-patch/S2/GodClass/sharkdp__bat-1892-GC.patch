+    fn glob_matches_candidates(glob: &GlobMatcher, candidate: &Candidate, filename_candidate: Option<&Candidate>) -> bool {
+        glob.is_match_candidate(candidate)
+            || filename_candidate.map(|filename| glob.is_match_candidate(filename)).unwrap_or(false)
+    }
+
+    fn match_path_mapping<'a>(&self, path: &Path, mapping: &SyntaxMapping<'a>) -> Option<MappingTarget<'a>> {
+        if mapping.has_mappings() {
+            self.match_path_mapping_entries(path, mapping)
+        } else {
+            None
+        }
+    }
+
+    fn match_path_mapping_entries<'a>(&self, path: &Path, mapping: &SyntaxMapping<'a>) -> Option<MappingTarget<'a>> {
+        let candidate = Candidate::new(path);
+        let candidate_filename = path.file_name().map(Candidate::new);
+        let entries = mapping.mappings();
+        let mut matched = None;
+        let mut index = entries.len();
+        while index > 0 {
+            index -= 1;
+            let (ref glob, ref syntax) = entries[index];
+            if Self::glob_matches_candidates(glob, &candidate, candidate_filename.as_ref()) {
+                matched = Some(*syntax);
+                break;
+            }
+        }
+        matched
+    }
+
+    fn syntax_detection_path(&self, input: &OpenedInput) -> Option<PathBuf> {
+        let kind = input.syntax_path_kind();
+        match input.path() {
+            Some(path) => {
+                let abs = PathAbs::new(path).map_or_else(|_| path.to_owned(), |p| p.as_path().to_path_buf());
+                let _kind_len = kind.len();
+                Some(abs)
+            }
+            None => None,
+        }
+    }
