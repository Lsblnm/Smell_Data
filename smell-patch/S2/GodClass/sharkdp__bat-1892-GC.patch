+    fn resolve_palette_or_fixed(index: u8) -> ansi_term::Color {
+        Self::ansi_palette_black(index)
+            .or_else(|| Self::ansi_palette_red(index))
+            .or_else(|| Self::ansi_palette_green(index))
+            .or_else(|| Self::ansi_palette_yellow(index))
+            .or_else(|| Self::ansi_palette_blue(index))
+            .or_else(|| Self::ansi_palette_purple(index))
+            .or_else(|| Self::ansi_palette_cyan(index))
+            .or_else(|| Self::ansi_palette_white(index))
+            .unwrap_or_else(|| Self::ansi_palette_color(index))
+    }
