+    pub(crate) fn style_as_terminal_escaped(
+        style: highlighting::Style,
+        text: &str,
+        true_color: bool,
+        colored: bool,
+        italics: bool,
+        background_color: Option<highlighting::Color>,
+    ) -> String {
+        if text.is_empty() {
+            return text.to_string();
+        }
+        let mut painted = if !colored {
+            AnsiStyle::default()
+        } else {
+            let mut color = AnsiStyle {
+                foreground: Self::theme_color_to_ansi(style.foreground, true_color),
+                ..AnsiStyle::default()
+            };
+            if style.font_style.contains(FontStyle::BOLD) {
+                color = color.bold();
+            }
+            if style.font_style.contains(FontStyle::UNDERLINE) {
+                color = color.underline();
+            }
+            if italics && style.font_style.contains(FontStyle::ITALIC) {
+                color = color.italic();
+            }
+            color
+        };
+        painted.background = background_color.and_then(|c| Self::theme_color_to_ansi(c, true_color));
+        painted.paint(text).to_string()
+    }
