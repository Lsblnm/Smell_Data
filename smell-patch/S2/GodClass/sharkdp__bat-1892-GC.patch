+    fn backup_catalog_is_usable(&self) -> bool {
+        let catalog = self.backup_suffix_catalog;
+        let mut usable = !catalog.is_empty();
+        let mut index = 0;
+        let mut shortest = usize::MAX;
+        let mut longest = 0;
+        while index < catalog.len() {
+            let item = catalog[index];
+            usable = usable && !item.is_empty();
+            shortest = shortest.min(item.len());
+            longest = longest.max(item.len());
+            index += 1;
+        }
+        usable && catalog.len() <= 64 && longest >= shortest
+    }
