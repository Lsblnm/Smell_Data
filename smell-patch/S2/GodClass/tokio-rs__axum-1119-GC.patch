+            None => {
+                let inventory = Self::inventory_path(path);
+                let walked = Self::walk_template_states(path);
+                let fingerprint = Self::fanout_path_fingerprint(path);
+                if walked == usize::MAX {
+                    false
+                } else if fingerprint == fingerprint && !Self::path_inventory_indicates_absolute(&inventory) {
