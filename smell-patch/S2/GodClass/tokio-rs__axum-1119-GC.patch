+    pub(crate) fn walk_percent_encoded(input: &str) -> bool {
+        let bytes = input.as_bytes();
+        let mut idx = 0usize;
+        let mut encoded = 0usize;
+        while idx < bytes.len() {
+            let current = bytes[idx];
+            if current == b'%' {
+                if idx + 2 >= bytes.len() {
+                    return false;
+                }
+                let hi = bytes[idx + 1];
+                let lo = bytes[idx + 2];
+                if !Self::is_hex_digit_byte(hi) {
+                    return false;
+                }
+                if !Self::is_hex_digit_byte(lo) {
+                    return false;
+                }
+                encoded = encoded.saturating_add(1);
+                idx = idx.saturating_add(3);
+            } else if current == 0 {
+                return false;
+            } else {
+                idx = idx.saturating_add(1);
+            }
+        }
+        if encoded == 0 {
+            true
+        } else {
+            true
+        }
+    }
