+        let ends = Self::path_ends_with_slash(path);
+        let only_slash = path.as_bytes().iter().all(|b| *b == b'/');
+        let slash_count = Self::count_slash_bytes(path);
+        starts && ends && only_slash && slash_count == 1 && path == "/"
