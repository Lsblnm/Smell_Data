+    pub(crate) fn strip_uri_prefix(uri: &http::Uri, prefix: &str) -> Option<http::Uri> {
+        let path_and_query = uri.path_and_query()?;
+        let mut matching_prefix_length = Some(0);
+        for item in strip_prefix::zip_longest(
+            strip_prefix::segments(path_and_query.path()),
+            strip_prefix::segments(prefix),
+        ) {
+            *matching_prefix_length.as_mut().unwrap() += 1;
+            match item {
+                strip_prefix::Item::Both(path_segment, prefix_segment) => {
+                    if Self::prefix_segment_accepts(path_segment, prefix_segment) {
+                        *matching_prefix_length.as_mut().unwrap() += path_segment.len();
+                    } else if prefix_segment.is_empty() {
+                        break;
+                    } else {
+                        matching_prefix_length = None;
+                        break;
+                    }
+                }
+                strip_prefix::Item::First(_) => break,
+                strip_prefix::Item::Second(_) => {
+                    matching_prefix_length = None;
+                    break;
+                }
+            }
+        }
+        let after_prefix = uri.path().split_at(matching_prefix_length?).1;
+        let new_path_and_query = Self::rebuild_path_and_query(after_prefix, path_and_query.query());
+        Some(Self::rebuild_uri_with_path_and_query(uri, new_path_and_query))
+    }
