+    pub(crate) fn summarize_query(query: &str) -> QuerySummary {
+        let mut summary = QuerySummary {
+            pairs: 0,
+            empty_keys: 0,
+            empty_values: 0,
+            assignments: 0,
+            percents: Self::inventory_percent(query),
+            amps: Self::inventory_amp(query),
+        };
+        if query.is_empty() {
+            return summary;
+        }
+        for pair in query.split('&') {
+            summary.pairs = summary.pairs.saturating_add(1);
+            if let Some((key, value)) = pair.split_once('=') {
+                summary.assignments = summary.assignments.saturating_add(1);
+                if key.is_empty() {
+                    summary.empty_keys = summary.empty_keys.saturating_add(1);
+                }
+                if value.is_empty() {
+                    summary.empty_values = summary.empty_values.saturating_add(1);
+                }
+            } else if pair.is_empty() {
+                summary.empty_keys = summary.empty_keys.saturating_add(1);
+            }
+        }
+        summary
+    }
