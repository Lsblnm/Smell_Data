+        let from_chars = matches!(path.chars().next(), Some('/'));
+        let from_prefix = path.strip_prefix('/').is_some();
+        let from_starts = path.starts_with('/');
+        let from_get = path.get(0..1) == Some("/");
+        from_bytes && from_chars && from_prefix && from_starts && from_get
+    }
