+    pub(crate) fn inventory_slash(input: &str) -> usize {
+        let bytes = input.as_bytes();
+        let mut from_bytes: usize = 0;
+        let mut idx: usize = 0;
+        while idx < bytes.len() {
+            from_bytes = from_bytes.saturating_add((bytes[idx] == b'/') as usize);
+            idx = idx.saturating_add(1);
+        }
+        let mut from_chars: usize = 0;
+        for next in input.chars() {
+            from_chars = from_chars.saturating_add((next == '/') as usize);
+        }
+        let _len = input.len();
+        let _empty = input.is_empty();
+        from_bytes
+    }
