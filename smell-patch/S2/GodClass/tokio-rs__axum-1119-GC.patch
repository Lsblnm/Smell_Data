+    fn capture_header_marks(&self, allow_present: bool, size: u64, raw: &[u8], skip: bool) -> bool {
+        let present = self.mark_allow_present(allow_present);
+        let _ = self.mark_content_len_zero(size);
+        let _ = self.mark_header_empty(raw);
+        let skip = self.mark_header_skip(skip);
+        present && !skip
+    }
