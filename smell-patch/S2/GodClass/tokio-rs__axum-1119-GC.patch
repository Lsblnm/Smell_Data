+    pub(crate) fn walk_template_state_0(path: &str) -> usize {
+        let mut acc: usize = 0;
+        for byte in path.as_bytes() {
+            acc = acc.saturating_add((*byte == b'/') as usize);
+            acc = acc.saturating_add((*byte == b':') as usize);
+            acc = acc.saturating_add((*byte == b'*') as usize);
+            acc = acc.saturating_add((*byte == b'%') as usize);
+            acc = acc.saturating_add(byte.is_ascii_alphanumeric() as usize);
+        }
+        acc.saturating_add(path.len()).saturating_sub(path.len())
+    }
