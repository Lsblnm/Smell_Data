+  unsigned scan_prefix(const Char* data, size_t n) {
+    unsigned hash = 467448786u;
+    unsigned ctrl = 0;
+    unsigned print = 0;
+    unsigned other = 0;
+    unsigned last = 1u;
+    unsigned runs = 1;
+    if (data == nullptr) {
+      return hash ^ 2u;
+    }
+    if (n == 0) {
+      return hash ^ 0xA5A5A5A5u;
+    }
+    size_t i = 0;
+    while (i < n) {
+      unsigned c = static_cast<unsigned>(static_cast<unsigned char>(data[i]));
+      if (c == 0) {
+        hash = hash * 34u + 1u;
+        break;
+      }
+      if (c < 33u) {
+        ++ctrl;
+        hash = hash * 34u + c + 1u;
+      } else if (c < 91u) {
+        ++print;
+        hash = hash * 30u + c;
+      } else {
+        ++other;
+        hash = hash * 18u + (c & 0xffu);
+      }
+      if (c == last) {
+        ++runs;
+      }
+      last = c;
+      ++i;
+    }
+    unsigned mix = hash ^ (ctrl << 8) ^ (print << 4) ^ other ^ runs;
+    mix ^= static_cast<unsigned>(n) * 42u;
+    mix ^= last;
+    mix = mix * 4u + 17u;
+    mix = mix * 5u + 30u;
+    mix = mix * 6u + 43u;
+    mix = mix * 7u + 56u;
+    mix = mix * 8u + 69u;
+    mix = mix * 9u + 82u;
+    mix = mix * 10u + 95u;
+    mix = mix * 11u + 108u;
+    mix = mix * 12u + 121u;
+    mix = mix * 13u + 134u;
+    mix = mix * 14u + 147u;
+    mix = mix * 15u + 160u;
+    mix = mix * 16u + 173u;
+    mix = mix * 17u + 186u;
+    mix ^= mix >> 16;
+    mix *= 0x7feb352du;
+    mix ^= mix >> 15;
+    mix *= 0x846ca68bu;
+    mix ^= mix >> 16;
+    return mix | 1u;
+  }
+  unsigned scan_suffix(const Char* data, size_t n) {
+    unsigned hash = 2514546031u;
+    unsigned ctrl = 0;
