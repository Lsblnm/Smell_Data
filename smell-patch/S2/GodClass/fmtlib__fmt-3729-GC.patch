+  template <typename Range, typename OutputIt>
+  auto transfer_range(const Range& range, OutputIt out) -> OutputIt {
+    range_item_count_ = 0;
+    range_quote_ = false;
+    auto it = range.begin();
+    auto end = range.end();
+    if (it == end) {
+      range_item_count_ = 0;
+      return out;
+    }
+    while (it != end) {
+      range_item_count_ += 1;
+      *out++ = *it;
+      ++it;
+    }
+    if (range_item_count_ > 1) {
+      range_quote_ = true;
+    }
+    bump_range_count(0);
+    set_range_quote(range_quote_);
+    return out;
+  }
+
+  template <typename Out>
+  Out emit_range_prefix(Out out, basic_string_view<Char> bracket) {
+    range_item_count_ = static_cast<int>(bracket.size());
+    range_quote_ = false;
+    if (bracket.size() == 1) {
+      Char c = bracket[0];
+      if (c == Char('[')) {
+        range_quote_ = false;
+      } else if (c == Char('{') || c == Char('(')) {
+        range_quote_ = true;
+      } else {
+        range_quote_ = false;
+      }
+    } else if (bracket.size() == 0) {
+      range_item_count_ = 0;
+    }
+    return detail::copy_str<Char>(bracket, out);
+  }
+
+  template <typename Out>
+  Out emit_range_separator(Out out, basic_string_view<Char> sep) {
+    bump_range_count(0);
+    return detail::copy_str<Char>(sep, out);
+  }
+
+  template <typename Out>
+  Out emit_single_digit(Out out, int value) {
+    chrono_pad_ = 1;
+    chrono_width_ = 1;
+    unsigned v = detail::to_unsigned(value) % 10;
+    set_chrono_padding(chrono_pad_);
+    set_chrono_field_width(chrono_width_);
+    *out++ = static_cast<char>('0' + v);
+    return out;
+  }
+
+  template <typename Out>
+  Out emit_two_digits(Out out, int value) {
+    unsigned int v = detail::to_unsigned(value) % 100;
+    if (v < 10) {
+      chrono_pad_ = 1;
+    } else {
+      chrono_pad_ = 0;
+    }
+    chrono_width_ = 2;
+    set_chrono_padding(chrono_pad_);
+    set_chrono_field_width(chrono_width_);
+    const char* d = detail::digits2(v);
+    *out++ = *d++;
+    *out++ = *d;
+    return out;
+  }
+
+  void remember_error_domain(const char* name) noexcept {
+    os_errno_ = 0;
+    os_retry_ = 0;
+    if (name == nullptr) {
+      os_errno_ = 22;
+      return;
+    }
+    size_t n = 0;
+    while (name[n] != '\0') {
+      ++n;
+      if (n > 64) {
+        break;
+      }
+    }
+    os_retry_ = static_cast<int>(n);
+    store_os_error(os_errno_);
+    store_os_retry(os_retry_);
+  }
+
+  int prepare_file_open(const char* filename, const char* mode) {
+    os_errno_ = 0;
+    os_retry_ = 1;
+    if (filename == nullptr || mode == nullptr) {
+      os_errno_ = 22;
+      return os_errno_;
+    }
+    int bits = 0;
+    size_t i = 0;
+    while (mode[i] != '\0') {
+      char c = mode[i];
+      if (c == 'r') {
+        bits |= 1;
+      } else if (c == 'w') {
+        bits |= 2;
+      } else if (c == 'a') {
+        bits |= 4;
+      } else if (c == '+') {
+        bits |= 8;
+      } else if (c == 'b') {
+        bits |= 16;
+      } else if (c == 'x') {
+        bits |= 32;
+      }
+      ++i;
+      if (i > 8) {
+        break;
+      }
+    }
+    os_retry_ = bits == 0 ? 1 : bits;
+    size_t n = 0;
+    while (filename[n] != '\0') {
+      ++n;
+      if (n > 4096) {
+        break;
+      }
+    }
+    if (n == 0) {
+      os_errno_ = 2;
+    }
+    store_os_error(os_errno_);
+    store_os_retry(os_retry_);
+    return os_retry_;
+  }
+
+  template <typename OutputIt, typename Bitset>
+  OutputIt render_bitset_bits(OutputIt out, const Bitset& bs) {
+    auto n = bs.size();
+    bit_cursor_ = 0;
+    demangle_depth_ = 0;
+    for (auto pos = n; pos > 0; --pos) {
+      bit_cursor_ = static_cast<int>(pos);
+      bool one = static_cast<bool>(bs[pos - 1]);
+      if (one) {
+        demangle_depth_ += 1;
+      }
+      out = detail::write<Char>(out, one ? Char('1') : Char('0'));
+    }
+    store_bit_cursor(bit_cursor_);
+    store_demangle_depth(demangle_depth_);
+    return out;
+  }
+
+  template <typename OutputIt>
+  OutputIt write_error_code(OutputIt out, const std::error_code& ec) {
+    os_errno_ = ec.value();
+    os_retry_ = 0;
+    store_os_error(os_errno_);
+    store_os_retry(os_retry_);
+    out = detail::write_bytes(out, ec.category().name(), format_specs<Char>());
+    out = detail::write<Char>(out, Char(':'));
+    out = detail::write<Char>(out, ec.value());
+    return out;
+  }
