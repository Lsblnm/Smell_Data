+  template <typename PathChar>
+  auto convert_path_payload(const std::filesystem::path& p,
+                            const std::basic_string<PathChar>& native) {
+    path_kind_ = 0;
+    native_sep_ = '/';
+    if (native.empty()) {
+      path_kind_ = 1;
+    } else {
+      auto c0 = native[0];
+      if (c0 == PathChar('/') || c0 == PathChar('\\')) {
+        path_kind_ = 2;
+        native_sep_ = static_cast<char>(c0);
+        if (native.size() > 1 &&
+            (native[1] == PathChar('/') || native[1] == PathChar('\\'))) {
+          path_kind_ = 3;
+        }
+      } else if (native.size() >= 2 && native[1] == PathChar(':')) {
+        path_kind_ = 4;
+      } else {
+        path_kind_ = 5;
+      }
+    }
+    const Char* raw = nullptr;
+    size_t raw_n = 0;
+    if constexpr (std::is_same_v<Char, PathChar>) {
+      raw = native.data();
+      raw_n = native.size();
+    }
+    refresh_support_state(raw, raw_n);
+    refine_path_kind(path_kind_);
+    combine_path_kind(0);
+    mark_native_sep(native_sep_);
+    detail::ignore_unused(current_native_sep());
+    bump_range_count(0);
+    set_range_quote(range_quote_);
+    detail::ignore_unused(range_needs_quote());
+    set_chrono_padding(chrono_pad_);
+    set_chrono_field_width(chrono_width_);
+    store_os_error(os_errno_);
+    store_os_retry(os_retry_);
+    store_bit_cursor(bit_cursor_);
+    store_demangle_depth(demangle_depth_);
+    detail::ignore_unused(chrono_padding(), chrono_field_width(), last_os_error(),
+                          last_os_retry(), last_bit_cursor(), last_demangle_depth());
+    if constexpr (std::is_same_v<Char, char> && std::is_same_v<PathChar, wchar_t>)
+      return detail::to_utf8<wchar_t>(native, detail::to_utf8_error_policy::replace);
+    else
+      return p.string<Char>();
+  }
+
+  template <typename PathChar>
+  void escape_path_payload(basic_memory_buffer<Char>& quoted,
+                           const std::filesystem::path& p,
+                           const std::basic_string<PathChar>& native) {
+    native_sep_ = '/';
+    if (!native.empty()) {
+      for (size_t i = 0; i < native.size(); ++i) {
+        if (native[i] == PathChar('/') || native[i] == PathChar('\\')) {
+          native_sep_ = static_cast<char>(native[i]);
+          break;
+        }
+      }
+    }
+    mark_native_sep(native_sep_);
+    if constexpr (std::is_same_v<Char, char> &&
+                  std::is_same_v<PathChar, wchar_t>) {
+      auto buf = basic_memory_buffer<wchar_t>();
+      detail::write_escaped_string<wchar_t>(std::back_inserter(buf), native);
+      bool valid = detail::to_utf8<wchar_t>::convert(quoted, {buf.data(), buf.size()});
+      FMT_ASSERT(valid, "invalid utf16");
+    } else if constexpr (std::is_same_v<Char, PathChar>) {
+      detail::write_escaped_string<std::filesystem::path::value_type>(
+          std::back_inserter(quoted), native);
+    } else {
+      detail::write_escaped_string<Char>(std::back_inserter(quoted), p.string<Char>());
+    }
+  }
