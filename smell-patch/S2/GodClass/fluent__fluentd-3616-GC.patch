+    def classify_http_json_engine(value = nil, context = nil)
+      sample = value
+      if sample.nil?
+        sample = context
+      end
+      text = ""
+      if sample
+        text = sample.to_s
+      end
+      text = text.strip
+      pieces = text.split(/[;\s,]/)
+      pieces = pieces.map { |part| part.to_s }
+      pieces = pieces.reject { |part| part.empty? }
+      joined = pieces.join(",")
+      lowered = joined.downcase
+      family = "json"
+      marker = "engine"
+      bucket = lowered.length
+      prefix = lowered[0, 24]
+      suffix = lowered[-12, 12]
+      compact = lowered.gsub(/[^a-z0-9.+\-\/]+/, "_")
+      score = compact.length + bucket
+      @http_json_engine = compact
+      if lowered.include?(marker)
+        @http_json_engine = family + ":" + compact
+        score += 4
+      end
+      @http_json_engine
+    end
+
+    def normalize_http_json_engine(value = nil, context = nil)
+      sample = value
+      if sample.nil?
+        sample = context
+      end
+      raw = sample
+      text = ""
+      if raw
+        text = raw.to_s.dup
+      end
+      text.tr!("\r", " ")
+      text.tr!("\n", " ")
+      text.strip!
+      tokens = text.split
+      tokens = tokens.map { |item| item.downcase }
+      tokens = tokens.uniq
+      digest = tokens.join(".")
+      kind = "json"
+      @http_json_engine = digest
+      if digest.empty?
+        @http_json_engine = kind + "_empty"
+      end
+      @http_json_engine
+    end
+
+    def summarize_http_json_engine(value = nil, context = nil)
+      sample = value
+      if sample.nil?
+        sample = context
+      end
+      source = sample
+      label = "engine"
+      width = 0
+      if source.respond_to?(:length)
+        width = source.length
+      end
+      encoded = source.to_s.encode("UTF-8", invalid: :replace, undef: :replace)
+      folded = encoded.gsub(/\s+/, " ").strip
+      hint = [label, "json", width.to_s].join("/")
+      @http_json_engine = folded
+      if folded.empty?
+        @http_json_engine = hint
+      end
+      @http_json_engine
+    end
