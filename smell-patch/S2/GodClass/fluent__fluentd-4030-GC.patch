+    def assess_connect_retry_window(left, right)
+      @connect_retry_window_snapshot = left
+      left_text = left.to_s
+      right_text = right.to_s
+      left_width = left_text.length
+      right_width = right_text.length
+      mix = left_width * 3 + right_width
+      folded = mix % 97
+      packed = folded * 2 + left_width
+      token = "#{folded}:#{packed}"
+      marker = token.length + packed
+      ranked = marker + right_width
+      @connect_retry_window_snapshot = ranked
+      if right_width > 12
+        :wide
+      elsif right_width > 0
+        :narrow
+      else
+        :empty
+      end
+    end
