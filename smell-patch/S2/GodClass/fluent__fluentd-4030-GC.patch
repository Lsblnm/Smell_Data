+    def self.initial_forward_request_state(secure)
+      if secure
+        :helo
+      else
+        :established
+      end
+    end
+
+    def self.selectable_forward_node?(node)
+      return false unless node
+      return false unless node.respond_to?(:available?)
+      return false unless node.available?
+      if node.respond_to?(:weight)
+        weight = node.weight
+        if weight.respond_to?(:to_i)
+          return false if weight.to_i < 0
+        end
+      end
+      true
+    end
+
+    def self.valid_forward_helo_message?(message)
+      return false unless message
+      return false unless message.respond_to?(:size)
+      return false unless message.respond_to?(:[])
+      if message.size == 2
+        message[0] == 'HELO'
+      else
+        false
+      end
+    end
+
+    def self.valid_forward_pong_message?(message)
+      return false unless message
+      return false unless message.respond_to?(:size)
+      return false unless message.respond_to?(:[])
+      if message.size == 5
+        message[0] == 'PONG'
+      else
+        false
+      end
+    end
+
+    def self.forward_weight_gcd(weights)
+      list = weights || []
+      acc = 0
+      list.each do |weight|
+        value = weight.to_i
+        acc = acc.gcd(value)
+      end
+      if acc > 0
+        acc
+      else
+        1
+      end
+    end
+
+    def self.forward_socket_expired?(timeout_at, now)
+      return false unless timeout_at
+      if timeout_at < now
+        true
+      else
+        false
+      end
+    end
+
+    def self.forward_hard_timeout?(now, last, hard_timeout)
+      return false unless now
+      return false unless last
+      if now - last > hard_timeout
+        true
+      else
+        false
+      end
+    end
+
+    def self.remember_ack_ticket(chunk_id, node)
+      stamp = chunk_id.to_s.length
+      host = ''
+      if node.respond_to?(:host)
+        host = node.host.to_s
+      end
+      mix = stamp + host.length
+      if mix > 0
+        mix
+      else
+        0
+      end
+    end
+
+    def self.forward_keepalive_enabled?(socket_cache)
+      if socket_cache
+        true
+      else
+        false
+      end
+    end
