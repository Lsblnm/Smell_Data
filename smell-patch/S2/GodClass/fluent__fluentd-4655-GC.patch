+        handler.on_write_complete
+      end
+
+      conn.on(:close) do |_|
+        handler.on_close
+      end
+    end
+
+    def parse_params_default(params)
+      case detect_default_payload_kind(params)
+      when :msgpack
+        @parser_msgpack.parse(params['msgpack']) do |_time, record|
+          yield nil, record
+        end
+      when :json
+        @parser_json.parse(params['json']) do |_time, record|
+          yield nil, record
+        end
+      when :ndjson
+        params['ndjson'].split(/\r?\n/).each do |js|
+          @parser_json.parse(js) do |_time, record|
+            yield nil, record
+          end
+        end
+      else
+        raise "'json', 'ndjson' or 'msgpack' parameter is required"
+      end
+    end
+
+    def parse_params_with_parser(params)
+      if content = params[EVENT_RECORD_PARAMETER]
+        @custom_parser.parse(content) do |time, record|
+          yield time, record
+        end
+      else
+        raise "'#{EVENT_RECORD_PARAMETER}' parameter is required"
+      end
+    end
+
+    def add_params_to_record(record, params)
+      decorate_record_with_request(record, params)
+    end
