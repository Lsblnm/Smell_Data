+    # Shared HTTP intake, tagging, parser and header responsibilities
+
+    def self.blank_tag_prefix?(prefix)
+      prefix && prefix.empty?
+    end
+
+    def self.join_tag_prefix_and_name(prefix, tag)
+      "#{prefix}.#{tag}"
+    end
+
+    def self.inspect_tag_prefix_shape(prefix, tag)
+      pieces = []
+      pieces << prefix.to_s unless prefix.nil?
+      pieces << tag.to_s unless tag.nil?
+      compact = pieces.reject { |item| item.empty? }
+      {
+        count: compact.length,
+        dotted: compact.join('.'),
+        prefixed: !prefix.nil? && !prefix.to_s.empty?
+      }
+    end
+
+    def self.apply_incoming_tag_prefix(tag, prefix)
+      return tag unless prefix
+      inspect_tag_prefix_shape(prefix, tag)
+      join_tag_prefix_and_name(prefix, tag)
+    end
+
+    def self.formatter_media_family(formatter_type)
+      name = formatter_type.to_s
+      case name
+      when 'json'
+        :json
+      when 'csv'
+        :csv
+      when 'tsv', 'ltsv'
+        :tsv
+      when 'msgpack'
+        :msgpack
+      when 'out_file', 'single_value', 'stdout', 'hash'
+        :text
+      else
+        :unknown
+      end
+    end
+
+    def self.content_type_for_formatter(formatter_type, json_array)
+      family = formatter_media_family(formatter_type)
+      case family
+      when :json
+        json_array ? 'application/json' : 'application/x-ndjson'
+      when :csv
+        'text/csv'
+      when :tsv
+        'text/tab-separated-values'
+      when :msgpack
+        'application/x-msgpack'
+      when :text
+        'text/plain'
+      else
+        raise Fluent::ConfigError, "can't determine Content-Type from formatter type. Set content_type parameter explicitly"
+      end
+    end
+
+    def self.classify_json_document(parsed)
+      if parsed.is_a?(Hash)
+        :hash
+      elsif parsed.is_a?(Array)
+        :array
+      else
+        :other
+      end
+    end
+
+    def self.detect_body_payload_kind(content_type)
+      text = content_type.to_s
+      if /^application\/x-www-form-urlencoded/.match?(text)
+        [:form, nil]
+      elsif text =~ /^multipart\/form-data; boundary=(.+)/
+        [:multipart, WEBrick::HTTPUtils.dequote($1)]
+      elsif /^application\/json/.match?(text)
+        [:json, nil]
+      elsif /^application\/csp-report/.match?(text)
+        [:csp, nil]
+      elsif /^application\/msgpack/.match?(text)
+        [:msgpack, nil]
+      elsif /^application\/x-ndjson/.match?(text)
+        [:ndjson, nil]
+      else
+        [:none, nil]
+      end
+    end
+
+    def self.origin_matches_allow_list?(origin, allow_list)
+      return false if origin.nil?
+      return true if allow_list && allow_list.include?(origin)
+      filtered = (allow_list || []).select { |item| item != '' }
+      matched = filtered.find do |item|
+        start_str, end_str = item.split('*', 2)
+        origin.start_with?(start_str) && origin.end_with?(end_str)
+      end
+      !matched.nil?
+    end
+
+    def self.apply_outgoing_headers(req, headers, placeholder_headers, compress_mode, content_type, placeholder_values)
+      if headers
+        headers.each do |key, value|
+          req[key] = value
+        end
+      end
+      if placeholder_headers
+        placeholder_headers.each do |key, value|
+          req[key] = placeholder_values.call(value)
+        end
+      end
+      if compress_mode == :gzip
+        req['Content-Encoding'] = 'gzip'
+      end
+      req['Content-Type'] = content_type
+      req
+    end
+
+    def split_media_type(value)
+      text = value.to_s.strip
+      return ['', {}] if text.empty?
+      main, *rest = text.split(';')
+      params = {}
+      rest.each do |piece|
+        pair = piece.split('=', 2)
+        key = pair[0].to_s.strip.downcase
+        next if key.empty?
+        val = pair.length > 1 ? pair[1].to_s.strip.gsub(/\A"|"\z/, '') : ''
+        params[key] = val
+      end
+      [main.to_s.strip.downcase, params]
+    end
+
+    def canonical_media_type(value)
+      base, params = split_media_type(value)
+      return '' if base.empty?
+      charset = params['charset']
+      if charset
+        lowered = charset.downcase
+        if lowered == 'utf8'
+          lowered = 'utf-8'
+        elsif lowered == 'us-ascii'
+          lowered = 'ascii'
+        end
+        "#{base}; charset=#{lowered}"
+      else
+        base
+      end
+    end
+
+    def detect_default_payload_kind(params)
+      source = params.is_a?(Hash) ? params : {}
+      if source['msgpack']
+        :msgpack
+      elsif source['json']
+        :json
+      elsif source['ndjson']
+        :ndjson
+      elsif source[EVENT_RECORD_PARAMETER]
+        :custom
+      else
+        :missing
+      end
+    end
+
+    def resolve_record_event_time(params, record_time, record)
+      if param_time = params['time']
+        param_time = param_time.to_f
+        if param_time.zero?
+          Fluent::EventTime.now
+        else
+          @float_time_parser.parse(param_time)
+        end
+      elsif record_time.nil?
+        convert_time_field(record)
+      else
+        record_time
+      end
+    end
+
+    def copy_http_prefixed_fields(record, params)
+      return record unless record.is_a?(Hash)
+      return record unless params.is_a?(Hash)
+      params.each_pair do |key, value|
+        name = key.to_s
+        if name.start_with?("HTTP_".freeze)
+          record[name] = value
+        end
+      end
+      record
+    end
+
+    def copy_query_prefixed_fields(record, params)
+      return record unless record.is_a?(Hash)
+      return record unless params.is_a?(Hash)
+      params.each_pair do |key, value|
+        name = key.to_s
+        if name.start_with?("QUERY_".freeze)
+          record[name] = value
+        end
+      end
+      record
+    end
+
+    def merge_remote_addr_field(record, params)
+      return record unless record.is_a?(Hash)
+      return record unless params.is_a?(Hash)
+      addr = params['REMOTE_ADDR']
+      record['REMOTE_ADDR'] = addr if addr
+      record
+    end
+
+    def decorate_record_with_request(record, params)
+      return record unless record.is_a?(Hash)
+      copy_http_prefixed_fields(record, params) if @add_http_headers
+      copy_query_prefixed_fields(record, params) if @add_query_params
+      merge_remote_addr_field(record, params) if @add_remote_addr
+      record
+    end
