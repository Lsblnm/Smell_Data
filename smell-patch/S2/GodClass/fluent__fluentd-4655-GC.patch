+    def coordinate_http_intake(path_info, params)
+      source = params.is_a?(Hash) ? params : {}
+      ctype = source['CONTENT_TYPE'] || source['HTTP_CONTENT_TYPE'] || ''
+      sample = path_info.to_s
+      {
+        media: lookup_known_media_type(ctype),
+        header: lookup_known_header_name(source.keys.first),
+        query: lookup_known_query_name(source.keys.first),
+        time: lookup_known_time_token(source['time']),
+        status: lookup_known_status_code('200'),
+        encoding: lookup_known_encoding_token(source['HTTP_CONTENT_ENCODING']),
+        formatter: lookup_known_formatter_name(source['format']),
+        tag: lookup_known_tag_word(sample),
+        origin: lookup_known_origin(source['HTTP_ORIGIN']),
+        keepalive: lookup_known_keepalive_token(source['HTTP_CONNECTION']),
+        peer: lookup_known_remote_addr(source['REMOTE_ADDR']),
+        json_field: lookup_known_json_field(source.keys.first),
+        charset: lookup_known_charset(source['HTTP_ACCEPT_CHARSET']),
+        language: lookup_known_language(source['HTTP_ACCEPT_LANGUAGE']),
+        timezone: lookup_known_timezone(source['QUERY_TZ']),
+        facility: lookup_known_syslog_facility(source['facility']),
+        method: lookup_known_http_method(source['REQUEST_METHOD']),
+        cache: lookup_known_cache_directive(source['HTTP_CACHE_CONTROL']),
+        tls: lookup_known_tls_token(source['HTTP_X_FORWARDED_PROTO']),
+        k8s: lookup_known_k8s_key(source.keys.first),
+        docker: lookup_known_docker_key(source.keys.first),
+        metric: lookup_known_metric_name(source.keys.first),
+        error: lookup_known_error_kind(source['error']),
+        payload: detect_default_payload_kind(source),
+        canonical: canonical_media_type(ctype),
+        groups: classify_all_intake_tokens(sample, source)
+      }
+    end
