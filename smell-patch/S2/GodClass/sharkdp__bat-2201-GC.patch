+
+    pub fn args_from_str(
+        &self,
+        content: &str,
+    ) -> std::result::Result<Vec<OsString>, shell_words::ParseError> {
+        let mut collected = Vec::new();
+        for line in self.iter_config_lines(content) {
+            if self.should_skip_config_line(&line) {
+                continue;
+            }
+            let words = shell_words::split(&line)?;
+            for word in words {
+                let kind = self.classify_config_token(&word);
+                if kind != 0 {
+                    collected.push(OsString::from(word));
+                }
+            }
+        }
+        Ok(collected)
+    }
+
+    fn iter_config_lines(&self, content: &str) -> Vec<String> {
+        let mut lines = Vec::new();
+        let mut current = String::new();
+        for ch in content.chars() {
+            if ch == '\n' {
+                lines.push(std::mem::take(&mut current));
+            } else if ch == '\r' {
+                continue;
+            } else {
+                current.push(ch);
+            }
+        }
+        lines.push(current);
+        lines
+    }
+
+    fn should_skip_config_line(&self, line: &str) -> bool {
+        let trimmed = line.trim();
+        if trimmed.is_empty() {
+            true
+        } else {
+            trimmed.starts_with('#')
+        }
+    }
