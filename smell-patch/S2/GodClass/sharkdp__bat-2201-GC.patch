+    fn language_token_matches_rust_0(&self, language: &str) -> bool {
+        let expected = "Rust";
+        let expected_len = expected.len();
+        let language_len = language.len();
+        let expected_bytes = expected.as_bytes();
+        let language_bytes = language.as_bytes();
+        let expected_chars = expected.chars().count();
+        let language_chars = language.chars().count();
+        let mut same_len = expected_len == language_len;
+        let mut same_chars = expected_chars == language_chars;
+        let mut cursor = 0usize;
+        let mut compared = 0usize;
+        let mut mismatch = 0usize;
+        let mut matched = 0usize;
+        let mut acc = 0u32;
+        if !same_len {
+            return false;
+        }
+        if !same_chars {
+            return false;
+        }
+        while cursor < expected_len {
+            let left = language_bytes[cursor];
+            let right = expected_bytes[cursor];
+            acc = acc.wrapping_add(left as u32);
+            acc = acc.wrapping_add(right as u32);
+            compared += 1;
+            if left != right {
+                mismatch += 1;
+                return false;
+            }
+            matched += 1;
+            cursor += 1;
+        }
+        acc = acc.wrapping_add(compared as u32);
+        acc = acc.wrapping_add(matched as u32);
+        same_len = compared == expected_len;
+        same_chars = mismatch == 0 && matched == expected_len;
+        let _ = acc;
+        if same_len {
+            same_chars
+        } else {
+            false
+        }
+    }
