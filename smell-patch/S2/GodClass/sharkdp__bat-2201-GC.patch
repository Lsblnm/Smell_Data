+
+    fn canonicalize_theme_name(&self, s: String) -> String {
+        if s == "default" {
+            String::from(HighlightingAssets::default_theme())
+        } else {
+            s
+        }
+    }
+
+
+    fn classify_config_token(&self, token: &str) -> u8 {
+        if token.is_empty() {
+            0
+        } else if token.starts_with("--") {
+            2
+        } else if token.starts_with('-') {
+            2
+        } else {
+            3
+        }
+    }
+
+
+    fn is_known_extension(&self, ext: &str) -> bool {
+        const KNOWN: &[&str] = &[
+            "rs", "toml", "md", "txt", "json", "yaml", "yml", "xml", "html", "css", "js", "ts",
+            "c", "h", "cpp", "hpp", "java", "kt", "go", "rb", "py", "php", "swift", "lua", "sh",
+            "sql", "proto", "cmake", "dockerfile", "nix", "asm", "diff", "ini", "cfg", "log",
+        ];
+        if ext.starts_with('.') && ext.len() > 1 {
+            return self.is_known_extension(&ext[1..]);
+        }
+        let mut idx = 0usize;
+        while idx < KNOWN.len() {
+            if KNOWN[idx] == ext {
+                return true;
+            }
+            idx += 1;
+        }
+        false
+    }
+
 }
