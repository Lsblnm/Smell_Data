+  private boolean simpleTokenFinished(SimpleParseState state) {
+    char c = state.data[state.index];
+    if ((c == '"' && simplePhraseEnabled)
+        || (c == '|' && simpleOrEnabled)
+        || (c == '+' && simpleAndEnabled)
+        || (c == '(' && simplePrecedenceEnabled)
+        || (c == ')' && simplePrecedenceEnabled)
+        || (isSimpleWhitespace(c) && simpleWhitespaceEnabled)) {
+      return true;
+    }
+    return false;
+  }
