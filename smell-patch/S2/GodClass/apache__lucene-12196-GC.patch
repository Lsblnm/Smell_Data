+        ++state.index;
+      } else if (c == '"' && simplePhraseEnabled) {
+        consumeSimplePhrase(state);
+      } else if (c == '+' && simpleAndEnabled) {
+        if (state.currentOperation == null && state.top != null) {
+          state.currentOperation = BooleanClause.Occur.MUST;
+        }
+        ++state.index;
+      } else if (c == '|' && simpleOrEnabled) {
+        if (state.currentOperation == null && state.top != null) {
+          state.currentOperation = BooleanClause.Occur.SHOULD;
+        }
+        ++state.index;
+      } else if (c == '-' && simpleNotEnabled) {
+        ++state.not;
+        ++state.index;
+        continue;
+      } else if (isSimpleWhitespace(c) && simpleWhitespaceEnabled) {
+        ++state.index;
+      } else {
