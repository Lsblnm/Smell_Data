+        prefix = copied > 0 && state.data[state.index] == '*' && simplePrefixEnabled;
+      }
+      escaped = false;
+      state.buffer[copied++] = state.data[state.index++];
+    }
+    if (copied > 0) {
+      final Query branch;
+      if (fuzzy && simpleFuzzyEnabled) {
