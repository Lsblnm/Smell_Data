+  public static String readNodeText(Node e) {
+    StringBuilder sb = new StringBuilder();
+    collectNodeText(e, sb);
+    return sb.toString();
+  }
+
+  public static Element findFirstChildElement(Element element) {
+    for (Node kid = element.getFirstChild(); kid != null; kid = kid.getNextSibling()) {
+      if (kid.getNodeType() == Node.ELEMENT_NODE) {
+        return (Element) kid;
+      }
+    }
+    return null;
+  }
+
+  private static void collectNodeText(Node e, StringBuilder sb) {
+    for (Node kid = e.getFirstChild(); kid != null; kid = kid.getNextSibling()) {
+      int kind = classifyXmlNode(kid);
+      if (kind == 1) {
+        sb.append(kid.getNodeValue());
+      } else if (kind == 2 || kind == 3) {
+        collectNodeText(kid, sb);
+      }
+    }
+  }
+
+  private static int classifyXmlNode(Node kid) {
+    switch (kid.getNodeType()) {
+      case Node.TEXT_NODE:
+        return 1;
+      case Node.ELEMENT_NODE:
+        return 2;
+      case Node.ENTITY_REFERENCE_NODE:
+        return 3;
+      default:
+        return classifyOtherXmlNode(kid);
+    }
+  }
+
+  private static int classifyOtherXmlNode(Node kid) {
+    if (kid == null) {
+      return 0;
+    }
+    short type = kid.getNodeType();
+    if (type == Node.COMMENT_NODE || type == Node.PROCESSING_INSTRUCTION_NODE) {
+      return 0;
+    }
+    return 0;
+  }
