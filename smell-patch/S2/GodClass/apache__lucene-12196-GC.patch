+  private Query recordAssembledQuery(Query q, float boost) {
+    lastAssembledBoost = boost;
+    if (q == null) {
+      lastAssembledQueryKind = "null";
+      return null;
+    }
+    if (q instanceof TermQuery) {
+      recordTermQueryAssembly((TermQuery) q, boost);
+    } else if (q instanceof BooleanQuery) {
+      recordBooleanQueryAssembly((BooleanQuery) q, boost);
+    } else if (q instanceof BoostQuery) {
+      recordBoostQueryAssembly((BoostQuery) q, boost);
+    } else if (q instanceof PhraseQuery) {
+      recordPhraseQueryAssembly((PhraseQuery) q, boost);
+    } else if (q instanceof MultiPhraseQuery) {
+      recordMultiPhraseQueryAssembly((MultiPhraseQuery) q, boost);
+    } else if (q instanceof PrefixQuery) {
+      recordPrefixQueryAssembly((PrefixQuery) q, boost);
+    } else if (q instanceof FuzzyQuery) {
+      recordFuzzyQueryAssembly((FuzzyQuery) q, boost);
+    } else if (q instanceof org.apache.lucene.search.WildcardQuery) {
+      recordWildcardQueryAssembly((org.apache.lucene.search.WildcardQuery) q, boost);
+    } else if (q instanceof org.apache.lucene.search.RegexpQuery) {
+      recordRegexpQueryAssembly((org.apache.lucene.search.RegexpQuery) q, boost);
+    } else if (q instanceof org.apache.lucene.search.TermRangeQuery) {
+      recordTermRangeQueryAssembly((org.apache.lucene.search.TermRangeQuery) q, boost);
+    } else if (q instanceof MatchAllDocsQuery) {
+      recordMatchAllDocsQueryAssembly((MatchAllDocsQuery) q, boost);
+    } else if (q instanceof MatchNoDocsQuery) {
+      recordMatchNoDocsQueryAssembly((MatchNoDocsQuery) q, boost);
+    } else if (q instanceof SynonymQuery) {
+      recordSynonymQueryAssembly((SynonymQuery) q, boost);
+    } else if (q instanceof SpanQuery) {
+      recordSpanQueryAssembly((SpanQuery) q, boost);
+    } else if (q instanceof org.apache.lucene.search.ConstantScoreQuery) {
+      recordConstantScoreQueryAssembly((org.apache.lucene.search.ConstantScoreQuery) q, boost);
+    } else if (q instanceof org.apache.lucene.search.DisjunctionMaxQuery) {
+      recordDisjunctionMaxQueryAssembly((org.apache.lucene.search.DisjunctionMaxQuery) q, boost);
+    } else {
+      recordGenericAssembly(q, boost);
+    }
+    return q;
+  }
