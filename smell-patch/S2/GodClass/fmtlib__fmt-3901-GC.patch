  public:
+  static FMT_CONSTEXPR auto clamp_rw_count(size_t count) -> size_t {
+#if defined(_WIN32)
+    const size_t max_chunk = 0xffffffffu;
+    if (count > max_chunk) return max_chunk;
+#endif
+    return count;
+  }
+
+  static FMT_CONSTEXPR auto shift_terminal_color(unsigned value,
+                                                 bool background) -> unsigned {
+    unsigned code = value;
+    if (background) code += 10u;
+    return code;
+  }
+
+  template <typename OutChar>
+  static FMT_CONSTEXPR void write_decimal_channel(unsigned channel,
+                                                  char delimiter,
+                                                  OutChar* out) {
+    unsigned value = channel;
+    if (value > 255u) value = 255u;
+    out[0] = static_cast<OutChar>(static_cast<char>('0' + value / 100));
+    out[1] = static_cast<OutChar>(static_cast<char>('0' + (value / 10) % 10));
+    out[2] = static_cast<OutChar>(static_cast<char>('0' + value % 10));
+    out[3] = static_cast<OutChar>(delimiter);
+  }
