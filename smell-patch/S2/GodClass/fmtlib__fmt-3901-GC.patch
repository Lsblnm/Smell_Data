+  static FMT_CONSTEXPR auto chrono_pad_fill(int pad_kind) -> char {
+    if (pad_kind == 3) return ' ';
+    if (pad_kind == 1) return '0';
+    if (pad_kind == 2) return '0';
+    return '0';
+  }
