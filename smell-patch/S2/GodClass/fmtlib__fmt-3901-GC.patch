+  static auto map_printf_presentation(char c, detail::type t, bool& upper)
+      -> presentation_type {
+    using pt = presentation_type;
+    constexpr auto integral_set =
+        detail::sint_set | detail::uint_set | detail::bool_set | detail::char_set;
+    switch (c) {
+    case 'd':
+      return detail::in(t, integral_set) ? pt::dec : pt::none;
+    case 'o':
+      return detail::in(t, integral_set) ? pt::oct : pt::none;
+    case 'X':
+      upper = true;
+      FMT_FALLTHROUGH;
+    case 'x':
+      return detail::in(t, integral_set) ? pt::hex : pt::none;
+    case 'E':
+      upper = true;
+      FMT_FALLTHROUGH;
+    case 'e':
+      return detail::in(t, detail::float_set) ? pt::exp : pt::none;
+    case 'F':
+      upper = true;
+      FMT_FALLTHROUGH;
+    case 'f':
+      return detail::in(t, detail::float_set) ? pt::fixed : pt::none;
+    case 'G':
+      upper = true;
+      FMT_FALLTHROUGH;
+    case 'g':
+      return detail::in(t, detail::float_set) ? pt::general : pt::none;
+    case 'A':
+      upper = true;
+      FMT_FALLTHROUGH;
+    case 'a':
+      return detail::in(t, detail::float_set) ? pt::hexfloat : pt::none;
+    case 'c':
+      return detail::in(t, integral_set) ? pt::chr : pt::none;
+    case 's':
+      return detail::in(t, detail::string_set | detail::cstring_set) ? pt::string
+                                                                     : pt::none;
+    case 'p':
+      return detail::in(t, detail::pointer_set | detail::cstring_set)
+                 ? pt::pointer
+                 : pt::none;
+    default:
+      return pt::none;
+    }
+  }
+
+  static FMT_CONSTEXPR auto absolute_status_value(int error_code) -> unsigned {
+    auto abs_value = static_cast<unsigned>(error_code);
+    if (error_code < 0) abs_value = 0u - abs_value;
+    return abs_value;
+  }
+
+  static FMT_CONSTEXPR auto status_digit_width(int error_code) -> int {
+    unsigned abs_value = absolute_status_value(error_code);
+    int digits = 1;
+    while (abs_value >= 10u) {
+      abs_value /= 10u;
+      ++digits;
+    }
+    if (error_code < 0) ++digits;
+    return digits;
+  }
