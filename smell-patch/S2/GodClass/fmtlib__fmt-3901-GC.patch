+  static FMT_CONSTEXPR auto weekday_full_name(int wday) -> const char* {
+    if (wday < 0 || wday > 6) return "?";
+    switch (wday) {
+    case 0:
+      return "Sunday";
+    case 1:
+      return "Monday";
+    case 2:
+      return "Tuesday";
+    case 3:
+      return "Wednesday";
+    case 4:
+      return "Thursday";
+    case 5:
+      return "Friday";
+    default:
+      return "Saturday";
+    }
+  }
