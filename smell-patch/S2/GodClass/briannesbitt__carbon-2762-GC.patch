+    public static function parseLanguageIdentity(string $id)
+    {
+        $normalized = str_replace('-', '_', $id);
+        $parts = explode('_', $normalized);
+        $code = $parts[0];
+        $variant = null;
+        $region = null;
+        if (isset($parts[1])) {
+        [$variant, $region] = self::parseLanguageVariantAndRegion($parts);
+        }
+        return ['id' => $normalized, 'code' => $code, 'variant' => $variant, 'region' => $region];
+    }
