+    public static function offsetNameFromMinuteOffset(float $minutes)
+    {
+        $minutes = self::roundMinuteOffsetValue($minutes);
+        $sign = self::intervalMinuteSign($minutes);
+        $hours = self::hoursFromSignedMinuteOffset($minutes);
+        $remain = self::remainingMinutesFromSignedOffset($minutes);
+        return self::composeOffsetName($sign, $hours, $remain);
+    }
