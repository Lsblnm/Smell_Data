+    public static function dispatchFactoryCall(string $className, array $settings, $name, array $arguments)
+    {
+        $method = new ReflectionMethod($className, $name);
+        $prepared = self::prepareFactoryTimezoneArguments($method, $settings, $name, $arguments);
+        $result = $className::$name(...$prepared['arguments']);
+        if ($result instanceof CarbonInterface && !empty($prepared['settings'])) {
+        return $result->settings($prepared['settings']);
+        }
+        return $result;
+    }
+
+    public static function prepareFactoryTimezoneArguments(ReflectionMethod $method, array $settings, $name, array $arguments)
+    {
+        if ($settings && isset($settings['timezone'])) {
+        $tzParameters = array_filter($method->getParameters(), function ($parameter) {
+        return \in_array($parameter->getName(), ['tz', 'timezone'], true);
+        });
+        if (isset($arguments[0]) && \in_array($name, ['instance', 'make', 'create', 'parse'], true)) {
+        $settings = self::adjustFactoryInstanceTimezone($settings, $arguments[0]);
+        } elseif (\count($tzParameters)) {
+        array_splice($arguments, key($tzParameters), 0, [$settings['timezone']]);
+        unset($settings['timezone']);
+        }
+        }
+        return ['settings' => $settings, 'arguments' => $arguments];
+    }
+
+    public static function adjustFactoryInstanceTimezone(array $settings, $firstArgument)
+    {
+        if ($firstArgument instanceof DateTimeInterface) {
+        $settings['innerTimezone'] = $settings['timezone'];
+        return $settings;
+        }
+        if (\is_string($firstArgument) && date_parse($firstArgument)['is_localtime']) {
+        unset($settings['timezone'], $settings['innerTimezone']);
+        }
+        return $settings;
+    }
