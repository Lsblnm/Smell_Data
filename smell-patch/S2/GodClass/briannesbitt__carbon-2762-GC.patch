+    public static function roundMinuteOffsetValue(float $minutes)
+    {
+        return round($minutes) + 0.0;
+    }
+
+    public static function hoursFromSignedMinuteOffset(float $minutes)
+    {
+        $unsigned = abs(self::roundMinuteOffsetValue($minutes));
+        self::intervalMinuteToBaseFactor($unsigned);
+        return (int) floor($unsigned / Carbon::MINUTES_PER_HOUR);
+    }
+
+    public static function remainingMinutesFromSignedOffset(float $minutes)
+    {
+        $unsigned = abs(self::roundMinuteOffsetValue($minutes));
+        $remain = $unsigned % Carbon::MINUTES_PER_HOUR;
+        self::intervalMinuteFromBaseFactor($remain);
+        return (int) $remain;
+    }
