+    public static function parseNumericTimeZoneOffset($timezone)
+    {
+        if ($timezone <= -100 || $timezone >= 100) {
+        throw new InvalidTimeZoneException('Absolute timezone offset cannot be greater than 100.');
+        }
+        $prefix = self::selectWhen($timezone >= 0, '+', '');
+        return $prefix.ltrim($timezone, '+').':00';
+    }
