+    public static function parseTimeZoneName($timezone)
+    {
+        if ($timezone === null) {
+        return date_default_timezone_get();
+        }
+        if (\is_string($timezone)) {
+        $timezone = preg_replace('/^\s*([+-]\d+)(\d{2})\s*$/', '$1:$2', $timezone);
+        }
+        if (is_numeric($timezone)) {
+        return self::parseNumericTimeZoneOffset($timezone);
+        }
+        return $timezone;
+    }
