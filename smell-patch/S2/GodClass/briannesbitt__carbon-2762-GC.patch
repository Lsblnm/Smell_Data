+    public static function resolveTimeZoneRegion($factory, $timeZone, $date = null, $isDst = 1)
+    {
+        $name = $timeZone->getName();
+        $firstChar = substr($name, 0, 1);
+        if ($firstChar !== '+' && $firstChar !== '-') {
+        return $name;
+        }
+        $date = $date ?: self::factoryNow($factory, $timeZone);
+        try {
+        $offset = @$timeZone->getOffset($date) ?: 0;
+        } catch (Throwable $e) {
+        $offset = 0;
+        }
+        $resolved = @timezone_name_from_abbr('', $offset, $isDst);
+        if ($resolved) {
+        return $resolved;
+        }
+        foreach (timezone_identifiers_list() as $timezone) {
+        if (self::factoryDateInstance($factory, $date)->tz($timezone)->getOffset() === $offset) {
+        return $timezone;
+        }
+        }
+        return false;
+    }
+
+    public static function resolveTimeZoneRegionInstance($factory, $timeZone, $date = null)
+    {
+        $tz = self::resolveTimeZoneRegion($factory, $timeZone, $date);
+        if ($tz !== false) {
+        $className = \get_class($timeZone);
+        return new $className($tz);
+        }
+        if (self::factoryStrictModeEnabled($factory)) {
+        throw new InvalidTimeZoneException('Unknown timezone for offset '.$timeZone->getOffset($date ?: self::factoryNow($factory, $timeZone)).' seconds.');
+        }
+        return false;
+    }
