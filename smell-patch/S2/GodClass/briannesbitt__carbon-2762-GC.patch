+    public static function collectTranslatorDirectories(AbstractTranslator $translator)
+    {
+        $directories = $translator->getDirectories();
+        $normalized = [];
+        if (!\is_array($directories)) {
+        return $normalized;
+        }
+        foreach ($directories as $directory) {
