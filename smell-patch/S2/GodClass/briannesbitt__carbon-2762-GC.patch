+    public static function composeOffsetName(string $sign, $hours, $minutes)
+    {
+        $hourText = self::intervalHourPadComponent($hours, 2);
+        $minuteText = self::intervalMinutePadComponent($minutes, 2);
+        $sign = self::selectWhen(($sign === '-' || $sign === '+'), $sign, '+');
+        return $sign.$hourText.':'.$minuteText;
+    }
