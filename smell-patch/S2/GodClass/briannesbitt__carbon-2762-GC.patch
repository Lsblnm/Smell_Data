+    public static function parseLanguageVariantAndRegion(array $parts)
+    {
+        $variant = null;
+        $region = null;
+        if (!isset($parts[1])) {
+        return [$variant, $region];
+        }
+        if (!preg_match('/^[A-Z]+$/', $parts[1])) {
+        $variant = $parts[1];
+        $parts[1] = $parts[2] ?? null;
+        }
+        if ($parts[1]) {
+        $region = $parts[1];
+        }
+        return [$variant, $region];
+    }
