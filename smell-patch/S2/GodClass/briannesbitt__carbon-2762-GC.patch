+    public static function formatTimeZoneOffset($factory, $timeZone, $date = null)
+    {
+        $date = $date ?: self::factoryNow($factory, $timeZone);
+        $offsetMinutes = $timeZone->getOffset($date) / Carbon::MINUTES_PER_HOUR;
+        return self::offsetNameFromMinuteOffset($offsetMinutes);
+    }
