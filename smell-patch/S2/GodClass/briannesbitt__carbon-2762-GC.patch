+    public static function timeFormatByPrecision($dateClass, $unitPrecision)
+    {
+        $unit = $dateClass::singularUnit($unitPrecision);
+        if ($unit === 'minute') {
+        return 'H:i';
+        }
+        if ($unit === 'second') {
+        return 'H:i:s';
+        }
+        if ($unit === 'm' || $unit === 'millisecond') {
+        return 'H:i:s.v';
+        }
+        if ($unit === 'µ' || $unit === 'microsecond') {
+        return 'H:i:s.u';
+        }
+        throw new UnitException('Precision unit expected among: minute, second, millisecond and microsecond.');
