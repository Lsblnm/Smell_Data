+    public static function makeTimeZoneInstance($factory, $object = null, $objectDump = null, $className = null)
+    {
+        if (!$className) {
+            $className = DateTimeZone::class;
+        }
+        $tz = $object;
+        if ($tz instanceof $className) {
+        return $tz;
+        }
+        if ($tz === null) {
+        return new $className();
+        }
+        if (!$tz instanceof DateTimeZone) {
+        $tz = self::openTimeZoneFromName($object);
+        }
+        if ($tz !== false) {
+        return new $className($tz->getName());
+        }
+        if (self::factoryStrictModeEnabled($factory)) {
+        throw new InvalidTimeZoneException('Unknown or bad timezone ('.($objectDump ?: $object).')');
+        }
+        return false;
+    }
