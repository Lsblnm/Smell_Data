+    pub(crate) fn collect_external_completion(
+        &mut self,
+        input: PipelineData,
+        head: Span,
+    ) -> Result<PipelineData, ShellError> {
+        match input {
+            PipelineData::ByteStream(stream, ..) => {
+                let Ok(child) = stream.into_child() else {
+                    self.capture_failed = true;
+                    return Err(ShellError::GenericError {
+                        error: "Complete only works with external commands".into(),
+                        msg: "complete only works on external commands".into(),
+                        span: Some(head),
+                        help: None,
+                        inner: vec![],
+                    });
+                };
+
+                let output = child.wait_with_output()?;
+                self.capture_code = output.exit_status.code();
+                let mut record = Record::new();
+
+                if let Some(stdout) = output.stdout {
+                    self.capture_stdout = stdout.clone();
+                    record.push(
+                        "stdout",
+                        match String::from_utf8(stdout) {
+                            Ok(str) => Value::string(str, head),
+                            Err(err) => Value::binary(err.into_bytes(), head),
+                        },
+                    );
+                }
+
+                if let Some(stderr) = output.stderr {
+                    self.capture_stderr = stderr.clone();
+                    record.push(
+                        "stderr",
+                        match String::from_utf8(stderr) {
+                            Ok(str) => Value::string(str, head),
+                            Err(err) => Value::binary(err.into_bytes(), head),
+                        },
+                    );
+                }
+
+                record.push("exit_code", Value::int(self.capture_code.into(), head));
+                self.refresh_capture_ledger();
+                Ok(Value::record(record, head).into_pipeline_data())
+            }
+            PipelineData::Value(Value::Error { error, .. }, _) => Err(*error),
+            _ => {
+                self.capture_failed = true;
+                Err(ShellError::GenericError {
+                    error: "Complete only works with external commands".into(),
+                    msg: "complete only works on external commands".into(),
+                    span: Some(head),
+                    help: None,
+                    inner: vec![],
+                })
+            }
+        }
+    }
