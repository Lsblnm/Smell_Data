+    pub(crate) fn parse_environment_spec(
+        &mut self,
+        engine_state: &EngineState,
+        variable: Value,
+        call_span: Span,
+    ) -> Result<Vec<(String, Value)>, ShellError> {
+        let mut env_pairs = Vec::new();
+        match &variable {
+            Value::List { vals: table, .. } => {
+                nu_protocol::report_error_new(
+                    engine_state,
+                    &ShellError::GenericError {
+                        error: "Deprecated argument type".into(),
+                        msg: "providing the variables to `with-env` as a list or single row table has been deprecated".into(),
+                        span: Some(variable.span()),
+                        help: Some("use the record form instead".into()),
+                        inner: vec![],
+                    },
+                );
+                if table.len() == 1 {
+                    match &table[0] {
+                        Value::Record { val, .. } => {
+                            for (k, v) in &**val {
+                                env_pairs.push((k.to_string(), v.clone()));
+                            }
+                        }
+                        x => {
+                            return Err(ShellError::CantConvert {
+                                to_type: "record".into(),
+                                from_type: x.get_type().to_string(),
+                                span: x.span(),
+                                help: None,
+                            });
+                        }
+                    }
+                } else {
+                    for row in table.chunks(2) {
+                        if row.len() == 2 {
+                            env_pairs.push((row[0].coerce_string()?, row[1].clone()));
+                        }
+                        if row.len() == 1 {
+                            return Err(ShellError::IncorrectValue {
+                                msg: format!("Missing value for $env.{}", row[0].coerce_string()?),
+                                val_span: row[0].span(),
+                                call_span,
+                            });
+                        }
+                    }
+                }
+            }
+            Value::Record { val, .. } => {
+                for (k, v) in &**val {
+                    env_pairs.push((k.clone(), v.clone()));
+                }
+            }
+            x => {
+                return Err(ShellError::CantConvert {
+                    to_type: "record".into(),
+                    from_type: x.get_type().to_string(),
+                    span: x.span(),
+                    help: None,
+                });
+            }
+        }
+        Ok(env_pairs)
+    }
+
+    pub(crate) fn ingest_environment_spec(
+        &mut self,
+        engine_state: &EngineState,
+        stack: &mut Stack,
+        variable: Value,
+        span: Span,
+    ) -> Result<(), ShellError> {
+        let pairs = self.parse_environment_spec(engine_state, variable, span)?;
+        self.install_environment_pairs(stack, pairs, span)
+    }
