+    pub(crate) fn locate_applications(
+        &mut self,
+        engine_state: &EngineState,
+        stack: &mut Stack,
+        call: &Call,
+    ) -> Result<PipelineData, ShellError> {
+        let head = call.head;
+        let applications: Vec<Spanned<String>> = call.rest(engine_state, stack, 0)?;
+        let all = call.has_flag(engine_state, stack, "all")?;
+        let ctrlc = engine_state.ctrlc.clone();
+        if applications.is_empty() {
+            return Err(ShellError::MissingParameter {
+                param_name: "application".into(),
+                span: head,
+            });
+        }
+        #[allow(deprecated)]
+        let cwd = nu_engine::env::current_dir_str(engine_state, stack)?;
+        let paths = nu_engine::env::path_str(engine_state, stack, head)?;
+        self.lookup_cwd = cwd.clone();
+        self.lookup_path_blob = paths.clone();
+        let mut output = vec![];
+        for app in applications {
+            let values = self.which_single(app, all, engine_state, cwd.clone(), paths.clone());
+            for value in &values {
+                if let Value::Record { val, .. } = value {
+                    if let Some(path) = val.get("path").and_then(|v| v.as_str().ok()) {
+                        self.lookup_hits.push(path.to_string());
+                    }
+                }
+            }
+            output.extend(values);
+        }
+        self.refresh_lookup_ledger();
