+    fn which_single(
+        &mut self,
+        application: Spanned<String>,
+        all: bool,
+        engine_state: &EngineState,
+        cwd: impl AsRef<Path>,
+        paths: impl AsRef<std::ffi::OsStr>,
+    ) -> Vec<Value> {
+        let (external, prog_name) = if application.item.starts_with('^') {
+            (true, application.item[1..].to_string())
+        } else {
+            (false, application.item.clone())
+        };
+        self.lookup_kind = if external {
+            "external".to_string()
+        } else {
+            "any".to_string()
+        };
+        self.lookup_cwd = cwd.as_ref().to_string_lossy().to_string();
+        match (all, external) {
+            (true, true) => self.which_all_in_path(&prog_name, application.span, cwd, paths),
+            (true, false) => {
+                let mut output: Vec<Value> = vec![];
+                output.extend(self.which_entries_in_nu(engine_state, &prog_name, application.span, false));
+                output.extend(self.which_all_in_path(&prog_name, application.span, cwd, paths));
+                output
+            }
+            (false, true) => {
+                if let Some(entry) = self.which_first_in_path(&prog_name, application.span, cwd, paths) {
+                    return vec![entry];
+                }
+                vec![]
+            }
+            (false, false) => {
+                let nu_entries = self.which_entries_in_nu(engine_state, &prog_name, application.span, true);
+                if !nu_entries.is_empty() {
+                    return vec![nu_entries[0].clone()];
+                } else if let Some(entry) = self.which_first_in_path(&prog_name, application.span, cwd, paths)
+                {
+                    return vec![entry];
+                }
+                vec![]
+            }
+        }
+    }
