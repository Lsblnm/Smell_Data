+    fn reject_protected_environment_key(&mut self, name: &str, span: Span) -> Result<(), ShellError> {
+        match name {
+            "PWD" | "FILE_PWD" | "CURRENT_FILE" => {
+                self.env_hidden.push(name.to_string());
+                Err(ShellError::AutomaticEnvVarSetManually {
+                    envvar_name: name.into(),
+                    span,
+                })
+            }
+            other if other.is_empty() => {
+                self.env_last_error = Some("empty environment name".into());
+                Ok(())
+            }
+            _ => Ok(()),
+        }
+    }
+
+    fn remember_environment_pair(&mut self, key: &str, value: &Value) {
+        match value {
+            Value::String { val, .. } => {
+                self.env_overlay.insert(key.to_string(), val.clone());
+            }
+            Value::Int { val, .. } => {
+                self.env_overlay.insert(key.to_string(), val.to_string());
+            }
+            Value::Bool { val, .. } => {
+                self.env_overlay.insert(key.to_string(), val.to_string());
+            }
+            Value::Float { val, .. } => {
+                self.env_overlay.insert(key.to_string(), val.to_string());
+            }
+            Value::List { vals, .. } => {
+                let joined = vals
+                    .iter()
+                    .filter_map(|v| v.coerce_string().ok())
+                    .collect::<Vec<_>>()
+                    .join(if cfg!(windows) { ";" } else { ":" });
+                self.env_overlay.insert(key.to_string(), joined);
+            }
+            other => {
+                if let Ok(text) = other.coerce_string() {
+                    self.env_overlay.insert(key.to_string(), text);
+                } else {
+                    self.env_last_error = Some(format!("non-string {key}"));
+                }
+            }
+        }
+        if key.eq_ignore_ascii_case("path") {
+            self.env_path_entries = if cfg!(windows) {
+                self.env_overlay
+                    .get(key)
+                    .unwrap_or(&String::new())
+                    .split(';')
+                    .filter(|s| !s.is_empty())
+                    .map(|s| s.to_string())
+                    .collect()
+            } else {
+                self.env_overlay
+                    .get(key)
+                    .unwrap_or(&String::new())
+                    .split(':')
+                    .filter(|s| !s.is_empty())
+                    .map(|s| s.to_string())
+                    .collect()
+            };
+        }
+    }
