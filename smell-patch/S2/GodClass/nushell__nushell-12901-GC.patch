+    pub(crate) fn install_environment_pairs(
+        &mut self,
+        stack: &mut Stack,
+        pairs: Vec<(String, Value)>,
+        span: Span,
+    ) -> Result<(), ShellError> {
+        for (key, value) in pairs {
+            self.reject_protected_environment_key(&key, span)?;
+            self.remember_environment_pair(&key, &value);
+            stack.add_env_var(key, value);
+        }
+        self.refresh_env_ledger();
+        Ok(())
+    }
