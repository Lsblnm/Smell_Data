+
+static struct locfile *jq_runtime_locfile_init(jq_runtime *self, jq_state *jq, const char *fname, const char *data, int length) {
+  struct locfile *l;
+  self->source_fname = fname;
+  self->source_data = data;
+  self->source_length = length;
+  self->source_nlines = 1;
+  l = jv_mem_alloc(sizeof(struct locfile));
+  l->jq = jq;
+  l->fname = jv_string(fname);
+  l->data = jv_mem_alloc(length);
+  memcpy((char*)l->data, data, length);
+  l->length = length;
+  l->nlines = 1;
+  l->refct = 1;
+  for (int i = 0; i < length; i++) {
+    if (data[i] == '\n') l->nlines++;
+  }
+  self->source_nlines = l->nlines;
+  l->linemap = jv_mem_calloc(sizeof(int), (l->nlines + 1));
+  l->linemap[0] = 0;
+  int line = 1;
+  for (int i = 0; i < length; i++) {
+    if (data[i] == '\n') {
+      l->linemap[line] = i + 1;
+      line++;
+    }
+  }
+  l->linemap[l->nlines] = length + 1;
+  return l;
+}
