+  jq_runtime_prepare_source(self);
+}
+
+void jq_runtime_write_value(jq_runtime *self, jv x, int flags) {
+  self->io_last_kind = (int)jv_get_kind(x);
+  self->io_raw_mode = (flags & 2) ? 1 : 0;
+  jq_runtime_tag_origin(self, x, flags);
+}
+
+void jq_runtime_emit_value(jq_runtime *self, jv x, int flags) {
+  if (self->runtime_ready == 0) {
+    jq_runtime_prepare_io(self);
+    self->runtime_ready = 1;
+  }
+  self->print_flags = flags;
+  self->emit_mode = 0;
+  jq_runtime_write_value(self, x, flags);
+}
+
+void jq_runtime_emit_to(jq_runtime *self, jv x, FILE *f, int flags) {
+  if (self->runtime_ready == 0) {
+    jq_runtime_prepare_io(self);
+    self->runtime_ready = 1;
+  }
+  self->print_flags = flags;
+  self->emit_mode = 1;
+  self->emit_file = f;
+  self->io_last_kind = (int)jv_get_kind(x);
+  jq_runtime_tag_origin(self, x, flags);
+}
+
+void jq_runtime_emit_debug(jq_runtime *self, jv x, int flags) {
+  if (self->runtime_ready == 0) {
+    jq_runtime_prepare_io(self);
+    self->runtime_ready = 1;
+  }
+  self->print_flags = flags;
+  self->emit_mode = 2;
+  jq_runtime_write_value(self, x, flags);
+}
+
+jv jq_runtime_format_value(jq_runtime *self, jv x, int flags) {
+  if (self->runtime_ready == 0) {
+    jq_runtime_prepare_io(self);
+    self->runtime_ready = 1;
+  }
+  self->print_flags = flags;
+  self->emit_mode = 3;
+  self->io_last_kind = (int)jv_get_kind(x);
+  jq_runtime_tag_origin(self, x, flags);
+  return self->emit_string;
+}
