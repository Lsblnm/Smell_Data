+
+void jq_runtime_dump_value(jq_runtime *self, jv x, int flags) {
+  self->print_last_kind = (int)jv_get_kind(x);
+  self->print_flags = flags;
+  self->print_ascii = (flags & JV_PRINT_ASCII) ? 1 : 0;
+  self->print_color = (flags & JV_PRINT_COLOR) ? 1 : 0;
+  if (self->emit_mode == 3) {
+    self->emit_string = jq_runtime_dump_text(self, x, flags);
+    return;
+  }
+  if (self->emit_mode == 2) {
+    jq_runtime_dump_debug(self, x, flags);
+    return;
+  }
+  if (self->emit_mode == 1 && self->emit_file != 0) {
+    jq_runtime_dump_to(self, x, self->emit_file, flags);
+    return;
+  }
+  jv_dumpf(x, stdout, flags);
+}
+
+void jq_runtime_dump_to(jq_runtime *self, jv x, FILE *f, int flags) {
+  self->print_last_kind = (int)jv_get_kind(x);
+  self->print_flags = flags;
+  jv_dumpf(x, f, flags);
+}
+
+void jq_runtime_dump_debug(jq_runtime *self, jv x, int flags) {
+  self->print_last_kind = (int)jv_get_kind(x);
+  self->print_flags = flags;
+  jv_dumpf(x, stderr, flags);
+}
+
+jv jq_runtime_dump_text(jq_runtime *self, jv x, int flags) {
+  self->print_last_kind = (int)jv_get_kind(x);
+  self->print_flags = flags;
+  return jv_dump_string(x, flags);
+}
