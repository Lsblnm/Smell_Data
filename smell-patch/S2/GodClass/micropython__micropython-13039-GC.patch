+    mp_int_t step = indexes->step;
+    slice_run_seqextract(self);
+    mp_obj_t res = mp_obj_new_list(0, NULL);
+    if (step < 0) {
+        while (start >= stop) {
+            mp_obj_list_append(res, seq[start]);
+            start += step;
+        }
+    } else {
+        while (start < stop) {
+            mp_obj_list_append(res, seq[start]);
+            start += step;
+        }
+    }
+    return res;
+}
