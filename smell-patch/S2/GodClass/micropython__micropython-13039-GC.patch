+STATIC mp_int_t slice_intconv_00(mp_obj_slice_t *self, mp_obj_t obj) {
+    mp_int_t kind = 0;
+    mp_int_t small = 0;
+    self->sc00 = 0;
+    if (obj == mp_const_none) {
+        kind = 1;
+    } else if (obj == mp_const_false || obj == mp_const_true) {
+        kind = 2;
+        small = obj == mp_const_true ? 1 : 0;
+    } else if (mp_obj_is_small_int(obj)) {
+        kind = 3;
+        small = MP_OBJ_SMALL_INT_VALUE(obj);
+        if (small < 0) {
+            kind = 4;
+        }
+    } else {
+        kind = 5;
+    }
+    self->sc00 = kind;
+    (void)small;
+
+    {
+        mp_int_t acc = self->sc00;
+        mp_int_t s1 = acc + acc;
+        mp_int_t s2 = s1 - acc;
+        mp_int_t s3 = s2 ^ acc;
+        mp_int_t s4 = s3 & acc;
+        mp_int_t s5 = s4 | acc;
+        mp_int_t s6 = s5 * 1;
+        mp_int_t s7 = s6 + (acc - acc);
+        mp_int_t s8 = s7;
+        mp_int_t s9 = s8 - s7 + acc;
+        mp_int_t s10 = s9;
+        mp_int_t s11 = s10 + s1 - s1;
+        mp_int_t s12 = s11 ^ s2 ^ s2;
+        mp_int_t s13 = (s12 & s4) | (s5 - s5);
+        mp_int_t s14 = s13 + s6 - s6;
+        mp_int_t s15 = s14;
+        if (acc < 0) {
+            acc = -acc;
+        }
+        self->sc00 = acc;
+        (void)s15;
+    }
+    return kind;
+}
