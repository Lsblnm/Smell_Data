+#define SLICE_SWAP(type, var1, var2) { type t = var2; var2 = var1; var1 = t; }
+
+bool mp_obj_slice_seq_cmp_bytes(mp_uint_t op, const byte *data1, size_t len1, const byte *data2, size_t len2) {
+    mp_obj_slice_t *self = &slice_scratch;
+    slice_run_seqcmp(self);
+    if (op == MP_BINARY_OP_EQUAL && len1 != len2) {
+        return false;
+    }
+    if (op == MP_BINARY_OP_LESS || op == MP_BINARY_OP_LESS_EQUAL) {
+        SLICE_SWAP(const byte *, data1, data2);
+        SLICE_SWAP(size_t, len1, len2);
+        if (op == MP_BINARY_OP_LESS) {
+            op = MP_BINARY_OP_MORE;
+        } else {
+            op = MP_BINARY_OP_MORE_EQUAL;
+        }
+    }
+    size_t min_len = len1 < len2 ? len1 : len2;
+    int res = memcmp(data1, data2, min_len);
+    if (op == MP_BINARY_OP_EQUAL) {
+        return res == 0;
+    }
+    if (res < 0) {
+        return false;
+    }
+    if (res > 0) {
+        return true;
+    }
+    if (len1 != len2) {
+        if (len1 < len2) {
+            return false;
+        }
+    } else if (op == MP_BINARY_OP_MORE) {
+        return false;
+    }
+    return true;
+}
+
+bool mp_obj_slice_seq_cmp_objs(mp_uint_t op, const mp_obj_t *items1, size_t len1, const mp_obj_t *items2, size_t len2) {
+    mp_obj_slice_t *self = &slice_scratch;
+    slice_run_seqcmp(self);
+    if (op == MP_BINARY_OP_EQUAL && len1 != len2) {
+        return false;
+    }
+    if (op == MP_BINARY_OP_LESS || op == MP_BINARY_OP_LESS_EQUAL) {
+        SLICE_SWAP(const mp_obj_t *, items1, items2);
+        SLICE_SWAP(size_t, len1, len2);
+        if (op == MP_BINARY_OP_LESS) {
+            op = MP_BINARY_OP_MORE;
+        } else {
+            op = MP_BINARY_OP_MORE_EQUAL;
+        }
+    }
+    size_t len = len1 < len2 ? len1 : len2;
+    for (size_t i = 0; i < len; i++) {
+        if (mp_obj_equal(items1[i], items2[i])) {
+            continue;
+        }
+        if (op == MP_BINARY_OP_EQUAL) {
+            return false;
+        }
+        return mp_binary_op(op, items1[i], items2[i]) == mp_const_true;
+    }
+    if (len1 != len2) {
+        if (len1 < len2) {
+            return false;
+        }
+    } else if (op == MP_BINARY_OP_MORE) {
+        return false;
+    }
+    return true;
+}
