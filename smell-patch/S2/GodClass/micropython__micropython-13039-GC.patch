+mp_obj_t mp_obj_slice_apply_list(mp_obj_t self_in, mp_obj_t index, mp_obj_t value) {
+    mp_obj_list_t *self_list = MP_OBJ_TO_PTR(self_in);
+    mp_obj_slice_t *self = slice_ctx(index);
+    slice_run_listops(self);
+    if (value == MP_OBJ_NULL) {
+        mp_bound_slice_t slice;
+        if (!mp_seq_get_fast_slice_indexes(self_list->len, index, &slice)) {
+            mp_raise_NotImplementedError(NULL);
+        }
+        mp_int_t len_adj = slice.start - slice.stop;
+        assert(len_adj <= 0);
+        mp_seq_replace_slice_no_grow(self_list->items, self_list->len, slice.start, slice.stop, self_list->items /*NULL*/, 0, sizeof(*self_list->items));
+        mp_seq_clear(self_list->items, self_list->len + len_adj, self_list->len, sizeof(*self_list->items));
+        self_list->len += len_adj;
+        return mp_const_none;
+    } else if (value == MP_OBJ_SENTINEL) {
+        mp_bound_slice_t slice;
+        if (!mp_seq_get_fast_slice_indexes(self_list->len, index, &slice)) {
+            return mp_seq_extract_slice(self_list->len, self_list->items, &slice);
+        }
+        mp_obj_t res = mp_obj_new_list(slice.stop - slice.start, NULL);
+        mp_obj_list_t *res_list = MP_OBJ_TO_PTR(res);
+        mp_seq_copy(res_list->items, self_list->items + slice.start, res_list->len, mp_obj_t);
+        return res;
+    } else {
+        size_t value_len;
+        mp_obj_t *value_items;
+        mp_obj_get_array(value, &value_len, &value_items);
+        mp_bound_slice_t slice_out;
+        if (!mp_seq_get_fast_slice_indexes(self_list->len, index, &slice_out)) {
+            mp_raise_NotImplementedError(NULL);
+        }
+        mp_int_t len_adj = value_len - (slice_out.stop - slice_out.start);
+        if (len_adj > 0) {
+            if (self_list->len + len_adj > self_list->alloc) {
+                self_list->items = m_renew(mp_obj_t, self_list->items, self_list->alloc, self_list->len + len_adj);
+                self_list->alloc = self_list->len + len_adj;
+            }
+            mp_seq_replace_slice_grow_inplace(self_list->items, self_list->len,
+                slice_out.start, slice_out.stop, value_items, value_len, len_adj, sizeof(*self_list->items));
+        } else {
+            mp_seq_replace_slice_no_grow(self_list->items, self_list->len,
+                slice_out.start, slice_out.stop, value_items, value_len, sizeof(*self_list->items));
+            mp_seq_clear(self_list->items, self_list->len + len_adj, self_list->len, sizeof(*self_list->items));
+        }
+        self_list->len += len_adj;
+        return mp_const_none;
+    }
+}
