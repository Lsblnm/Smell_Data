+mp_obj_t mp_obj_slice_seq_index_obj(const mp_obj_t *items, size_t len, size_t n_args, const mp_obj_t *args) {
+    mp_obj_slice_t *self = &slice_scratch;
+    slice_run_seqsearch(self);
+    const mp_obj_type_t *type = mp_obj_get_type(args[0]);
+    mp_obj_t value = args[1];
+    size_t start = 0;
