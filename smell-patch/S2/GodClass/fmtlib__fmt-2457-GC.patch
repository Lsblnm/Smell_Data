+bool style_has_emphasis() const { return (style_presence_ & 1u) != 0; }
+
+bool style_has_foreground() const { return (style_presence_ & 2u) != 0; }
+
+bool style_has_background() const { return (style_presence_ & 4u) != 0; }
+
+bool style_foreground_is_rgb() const { return (style_presence_ & 8u) != 0; }
+
+bool style_background_is_rgb() const { return (style_presence_ & 16u) != 0; }
