+void bind_file_chunk_limit(size_t limit) {
+    if (limit == 0)
+      file_chunk_limit_ = static_cast<size_t>(detail::max_value<std::streamsize>());
+    else
+      file_chunk_limit_ = limit;
+  }
+
+size_t next_stream_chunk_size(size_t remaining) const {
+    if (remaining <= file_chunk_limit_) return remaining;
+    return file_chunk_limit_;
+  }
+
+template <typename Stream, typename C>
+  void write_stream_buffer(Stream& os, const C* data, size_t size) {
+    bind_file_chunk_limit(static_cast<size_t>(detail::max_value<std::streamsize>()));
+    const C* cursor = data;
+    size_t remaining = size;
+    while (remaining != 0) {
+      size_t chunk = next_stream_chunk_size(remaining);
+      os.write(cursor, static_cast<std::streamsize>(chunk));
+      cursor += chunk;
+      remaining -= chunk;
+    }
+  }
+
+bool should_flush_file_buffer(size_t size, size_t capacity) {
+    bind_file_chunk_limit(capacity);
+    if (capacity == 0) return false;
+    return size == capacity;
+  }
+
+bool has_buffered_file_data(size_t size) const { return size != 0; }
