+template <typename OutputIt>
+  OutputIt copy_ascii_unit(OutputIt out, const char* unit) {
+    if (!unit) return out;
+    for (const char* p = unit; *p; ++p) {
+      unsigned value = static_cast<unsigned>(static_cast<unsigned char>(*p));
+      if (value < 0x80u) {
+        *out++ = static_cast<Char>(*p);
+        continue;
+      }
+      if (sizeof(Char) == 1) {
+        *out++ = static_cast<Char>(*p);
+        continue;
+      }
+      *out++ = static_cast<Char>(value);
+    }
+    return out;
+  }
+
+template <typename OutputIt>
+  OutputIt write_named_duration_unit(OutputIt out, const char* unit) {
+    if (!unit) {
+      *out++ = static_cast<Char>('s');
+      return out;
+    }
+    bool ascii_only = true;
+    for (const char* p = unit; *p; ++p) {
+      if (static_cast<unsigned char>(*p) >= 0x80u) {
+        ascii_only = false;
+        break;
+      }
+    }
+    if (ascii_only) return write_unit_by_name(out, unit);
+    if (!uses_wide_encoding()) return copy_ascii_unit(out, unit);
+    string_view unit_view(unit);
+    detail::utf8_to_utf16 converted(unit_view);
+    const wchar_t* begin = converted.c_str();
+    size_t count = converted.size();
+    for (size_t i = 0; i < count; ++i)
+      *out++ = static_cast<Char>(begin[i]);
+    return out;
+  }
+
+template <typename Period, typename OutputIt>
+  OutputIt write_ratio_duration_unit(OutputIt out) {
+    *out++ = static_cast<Char>('[');
+    out = detail::write<Char>(out, Period::num);
+    if (detail::const_check(Period::den != 1)) {
+      *out++ = static_cast<Char>('/');
+      out = detail::write<Char>(out, Period::den);
+    }
+    *out++ = static_cast<Char>(']');
+    *out++ = static_cast<Char>('s');
+    return out;
+  }
