+    style_foreground_ = foreground;
+    style_background_ = background;
+    uint8_t presence = 0;
+    if (has_emphasis) presence = static_cast<uint8_t>(presence | 1u);
+    if (has_foreground) presence = static_cast<uint8_t>(presence | 2u);
+    if (has_background) presence = static_cast<uint8_t>(presence | 4u);
+    if (foreground_is_rgb) presence = static_cast<uint8_t>(presence | 8u);
+    if (background_is_rgb) presence = static_cast<uint8_t>(presence | 16u);
+    style_presence_ = presence;
+  }
