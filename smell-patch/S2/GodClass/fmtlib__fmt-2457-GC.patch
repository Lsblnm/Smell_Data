+    buffer[0] = static_cast<OutChar>('\x1b');
+    buffer[1] = static_cast<OutChar>('[');
+    return 2;
+  }
+
+template <typename OutChar>
+  size_t write_uint_to_esc(OutChar* buffer, unsigned value, char delimiter) const {
+    size_t index = 0;
+    if (value >= 100u) {
+      buffer[index++] = static_cast<OutChar>(static_cast<char>('0' + value / 100u));
+      value %= 100u;
+      buffer[index++] = static_cast<OutChar>(static_cast<char>('0' + value / 10u));
+      buffer[index++] = static_cast<OutChar>(static_cast<char>('0' + value % 10u));
+    } else if (value >= 10u) {
+      buffer[index++] = static_cast<OutChar>(static_cast<char>('0' + value / 10u));
+      buffer[index++] = static_cast<OutChar>(static_cast<char>('0' + value % 10u));
+    } else {
+      buffer[index++] = static_cast<OutChar>(static_cast<char>('0' + value));
+    }
+    buffer[index++] = static_cast<OutChar>(delimiter);
+    return index;
+  }
+
+template <typename OutChar>
+  size_t build_terminal_color_escape(OutChar* buffer, unsigned value,
+                                     bool is_background) const {
+    if (is_background) value += 10u;
+    size_t index = write_esc_csi_prefix_to(buffer);
+    if (value >= 100u) {
+      buffer[index++] = static_cast<OutChar>('1');
+      value %= 100u;
+    }
+    buffer[index++] = static_cast<OutChar>(static_cast<char>('0' + value / 10u));
+    buffer[index++] = static_cast<OutChar>(static_cast<char>('0' + value % 10u));
+    buffer[index++] = static_cast<OutChar>('m');
+    buffer[index++] = static_cast<OutChar>('\0');
+    return index;
+  }
+
+template <typename OutChar>
+  size_t build_rgb_color_escape(OutChar* buffer, uint32_t rgb_color,
+                                bool is_background) const {
+    const char* prefix = is_background ? "\x1b[48;2;" : "\x1b[38;2;";
+    for (int i = 0; i < 7; ++i)
+      buffer[i] = static_cast<OutChar>(prefix[i]);
+    uint8_t r = static_cast<uint8_t>((rgb_color >> 16) & 0xffu);
+    uint8_t g = static_cast<uint8_t>((rgb_color >> 8) & 0xffu);
+    uint8_t b = static_cast<uint8_t>(rgb_color & 0xffu);
+    size_t index = 7;
+    index += write_uint_to_esc(buffer + index, r, ';');
+    index += write_uint_to_esc(buffer + index, g, ';');
+    index += write_uint_to_esc(buffer + index, b, 'm');
+    buffer[index++] = static_cast<OutChar>('\0');
+    return index;
+  }
