+    codes[3] = emphasis_code_for_bit(style_emphasis_, 8u, 4u);
+    codes[4] = emphasis_code_for_bit(style_emphasis_, 16u, 5u);
+    codes[5] = emphasis_code_for_bit(style_emphasis_, 32u, 7u);
+    codes[6] = emphasis_code_for_bit(style_emphasis_, 64u, 8u);
+    codes[7] = emphasis_code_for_bit(style_emphasis_, 128u, 9u);
+    size_t index = 0;
+    for (size_t i = 0; i < 8; ++i) {
+      if (codes[i] == 0) continue;
+      index += write_esc_csi_prefix_to(buffer + index);
+      buffer[index++] = static_cast<OutChar>(static_cast<char>('0' + codes[i]));
+      buffer[index++] = static_cast<OutChar>('m');
+    }
+    buffer[index++] = static_cast<OutChar>('\0');
+    return index;
+  }
