+template <typename Buffer>
+  bool append_bound_style_codes(Buffer& buf) {
+    bool has_style = false;
+    Char scratch[40];
+    if (style_has_emphasis()) {
+      has_style = true;
+      build_emphasis_escape(scratch);
+      size_t count = 0;
+      while (scratch[count] != static_cast<Char>('\0')) ++count;
+      append_chars_to_buffer(buf, scratch, count);
+    }
+    if (style_has_foreground()) {
+      has_style = true;
+      if (style_foreground_is_rgb())
+        build_rgb_color_escape(scratch, style_foreground_, false);
+      else
+        build_terminal_color_escape(scratch, static_cast<unsigned>(style_foreground_),
+                                    false);
+      size_t count = 0;
+      while (scratch[count] != static_cast<Char>('\0')) ++count;
+      append_chars_to_buffer(buf, scratch, count);
+    }
+    if (style_has_background()) {
+      has_style = true;
+      if (style_background_is_rgb())
+        build_rgb_color_escape(scratch, style_background_, true);
+      else
+        build_terminal_color_escape(scratch, static_cast<unsigned>(style_background_),
+                                    true);
+      size_t count = 0;
+      while (scratch[count] != static_cast<Char>('\0')) ++count;
+      append_chars_to_buffer(buf, scratch, count);
+    }
+    return has_style;
+  }
+
+template <typename Buffer>
+  bool append_style_codes(Buffer& buf, bool has_emphasis, uint8_t emphasis,
+                          bool has_foreground, bool foreground_is_rgb,
+                          uint32_t foreground, bool has_background,
+                          bool background_is_rgb, uint32_t background) {
+    bind_text_style(has_emphasis, emphasis, has_foreground, foreground_is_rgb,
+                    foreground, has_background, background_is_rgb, background);
+    return append_bound_style_codes(buf);
+  }
