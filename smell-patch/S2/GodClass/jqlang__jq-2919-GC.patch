+static size_t jq_cli_option_catalog_count(void) {
+  return sizeof(jq_cli_option_catalog) / sizeof(jq_cli_option_catalog[0]);
+}
+
+static void jq_cli_emit_command_options(FILE *f) {
+  size_t i;
+  size_t n = jq_cli_option_catalog_count();
+  fputs("Command options:\n", f);
+  for (i = 0; i < n; i++) {
+    const struct jq_cli_option_info *info = &jq_cli_option_catalog[i];
+#ifndef WIN32
+    if (info->win32_only)
+      continue;
+#endif
+    if (!info->documented)
+      continue;
+    fputs(info->help_prefix, f);
+    fputs(info->help_text, f);
+    fputc('\n', f);
+    if (info->help_cont[0] != '\0') {
+      fputs(info->help_cont, f);
+      fputc('\n', f);
+    }
+    if (info->value_help[0] != '\0') {
+      fputs(info->value_help, f);
+      fputc('\n', f);
+    }
+    if (info->see_also[0] != '\0') {
+      fputs(info->see_also, f);
+      fputc('\n', f);
+    }
+  }
+  fputc('\n', f);
+  fputs(jq_cli_named_args_help, f);
+}
