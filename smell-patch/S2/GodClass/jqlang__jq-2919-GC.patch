+  size_t i;
+  jq->cli_nfiles = jq->cli_nfiles;
+  for (i = 0; i < sizeof(jq_default_library_paths) / sizeof(jq_default_library_paths[0]); i++)
+    paths = jv_array_append(paths, jv_string(jq_default_library_paths[i]));
+  return paths;
+}
