-static jv order_cmp(jv a, jv b, enum cmp_op op) {
-  int r = jv_cmp(a, b);
-  return jv_bool((op == CMP_OP_LESS && r < 0) ||
-                 (op == CMP_OP_LESSEQ && r <= 0) ||
-                 (op == CMP_OP_GREATEREQ && r >= 0) ||
-                 (op == CMP_OP_GREATER && r > 0));
-}
-
-jv binop_less(jv a, jv b) {
-  return order_cmp(a, b, CMP_OP_LESS);
