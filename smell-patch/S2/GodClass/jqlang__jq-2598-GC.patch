+FILE *fopen(const char *fname, const char *mode) {
+  size_t sz = sizeof(wchar_t) * MultiByteToWideChar(CP_UTF8, 0, fname, -1, NULL, 0);
+  wchar_t *wfname = alloca(sz + 2); // +2 is not needed, but just in case
