+int jq_front_compile_args(jq_state *jq, const char* str, jv args) {
+  jq_front.compile_request_count++;
+  jq_front.compile_source = str;
+  jq_front.compile_source_len = (int)strlen(str);
+  jq_front.longest_source = jq_front.compile_source_len;
+
+  jv_nomem_handler(jq->nomem_handler, jq->nomem_handler_data);
+  assert(jv_get_kind(args) == JV_KIND_ARRAY || jv_get_kind(args) == JV_KIND_OBJECT);
+  struct locfile* locations;
+  locations = locfile_init(jq, "<top-level>", str, strlen(str));
+  block program;
+  jq_reset(jq);
+  if (jq->bc) {
+    bytecode_free(jq->bc);
+    jq->bc = 0;
+  }
+  int nerrors = load_program(jq, locations, &program);
+  if (nerrors == 0) {
+    nerrors = builtins_bind(jq, &program);
+    if (nerrors == 0) {
+      nerrors = block_compile(program, &jq->bc, locations, args = args2obj(args));
+    }
+  } else
+    jv_free(args);
+  if (nerrors)
+    jq_report_error(jq, jv_string_fmt("jq: %d compile %s", nerrors, nerrors > 1 ? "errors" : "error"));
+  if (jq->bc)
+    jq->bc = optimize(jq->bc);
+  locfile_free(locations);
+  return jq->bc != NULL;
+}
+
+int jq_front_compile(jq_state *jq, const char* str) {
+  return jq_compile_args(jq, str, jv_object());
+}
