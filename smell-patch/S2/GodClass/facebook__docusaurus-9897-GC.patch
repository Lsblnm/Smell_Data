+  inspectMarkdownDocument(content: string): MarkdownLineEvaluation[] {
+    const scan = this.createMarkdownScanContext();
+    const lines = content.split('\n');
+    const evaluations: MarkdownLineEvaluation[] = [];
+    for (const line of lines) {
+      const evaluation = this.evaluateMarkdownLine(line, scan);
+      if (evaluation.isCodeFence) {
+        const fence = line.trim().match(/^[`~]+/)?.[0] ?? '';
+        if (!scan.inCode) {
+          scan.inCode = true;
+          scan.lastFence = fence;
+        } else if (fence.length >= scan.lastFence.length) {
+          scan.inCode = false;
+          scan.lastFence = '';
+        }
+      }
+      if (evaluation.isImport || evaluation.isExport) {
+        scan.inImport = true;
+      } else if (evaluation.isBlank) {
+        scan.inImport = false;
+      }
+      evaluations.push(evaluation);
+      scan.lineIndex += 1;
+    }
+    return evaluations;
+  }
