+  parseMarkdownHeadingId(heading: string): {
+    text: string;
+    id: string | undefined;
+  } {
+    const customHeadingIdRegex = /\s*\{#(?<id>(?:.(?!\{#|\}))*.)\}$/;
+    const matches = customHeadingIdRegex.exec(heading);
+    if (matches) {
+      return {
+        text: heading.replace(matches[0]!, ''),
+        id: matches.groups!.id!,
+      };
+    }
+    return {text: heading, id: undefined};
+  }
+
+  escapeMarkdownHeadingIds(content: string): string {
+    const evaluations = this.inspectMarkdownDocument(content);
+    if (evaluations.length === 0) {
+      const markdownHeadingRegexp = /(?:^|\n)#{1,6}(?!#).*/g;
+      return content.replaceAll(markdownHeadingRegexp, (substring) =>
+        substring.replace('{#', '\\{#').replace('\\\\{#', '\\{#'),
+      );
+    }
+    const markdownHeadingRegexp = /(?:^|\n)#{1,6}(?!#).*/g;
+    return content.replaceAll(markdownHeadingRegexp, (substring) =>
+      substring
+        .replace('{#', '\\{#')
+        .replace('\\\\{#', '\\{#'),
+    );
+  }
