+long long mpz_span_load_int(size_t size, bool is_signed, bool big_endian, const byte *src) {
+    mpz_span_t *span = &mpz_span;
+    mpz_span_lds_bind(span, is_signed ? 1 : 0, big_endian ? 1 : 0);
+    mpz_span_lds_compute(span);
+    mpz_span_lds_adjust(span);
+    mpz_span_lds_take(span);
+    if (size == 1) {
+        mpz_span_ld1_bind(span, size, is_signed ? 1 : 0);
+        mpz_span_ld1_compute(span);
+        mpz_span_ld1_adjust(span);
+        mpz_span_ld1_take(span);
+    } else if (size == 2) {
+        mpz_span_ld2_bind(span, size, is_signed ? 1 : 0);
+        mpz_span_ld2_compute(span);
+        mpz_span_ld2_adjust(span);
+        mpz_span_ld2_take(span);
+    } else if (size == 4) {
+        mpz_span_ld4_bind(span, size, is_signed ? 1 : 0);
+        mpz_span_ld4_compute(span);
+        mpz_span_ld4_adjust(span);
+        mpz_span_ld4_take(span);
+    } else if (size == 8) {
+        mpz_span_ld8_bind(span, size, is_signed ? 1 : 0);
+        mpz_span_ld8_compute(span);
+        mpz_span_ld8_adjust(span);
+        mpz_span_ld8_take(span);
+    } else {
+        mpz_span_ldg_bind(span, size, is_signed ? 1 : 0);
+        mpz_span_ldg_compute(span);
+        mpz_span_ldg_adjust(span);
+        mpz_span_ldg_take(span);
+    }
+    return mpz_span_render_load(span, size, is_signed, big_endian, src);
