+static char *mpz_span_render_small(mpz_span_t *span, char *str, size_t needed_size, size_t *fmt_size,
+    mp_uint_t num, int base, const char *prefix, char base_char, char comma, char sign) {
+    span->sm7_a = num;
+    span->sm7_b = (size_t)base;
+    char *b = str + needed_size;
+    *(--b) = '\0';
+    char *last_comma = b;
+    if (num == 0) {
+        *(--b) = '0';
+    } else {
+        do {
+            int c = (int)(num % (mp_uint_t)base);
+            num = num / (mp_uint_t)base;
+            if (c >= 10) {
+                c += base_char - 10;
+            } else {
+                c += '0';
+            }
+            *(--b) = (char)c;
+            if (comma && num != 0 && b > str && (last_comma - b) == 3) {
+                *(--b) = comma;
+                last_comma = b;
+            }
+        } while (b > str && num != 0);
+    }
+    if (prefix) {
+        size_t prefix_len = strlen(prefix);
+        char *p = b - prefix_len;
+        if (p > str) {
+            b = p;
+            while (*prefix) {
+                *p++ = *prefix++;
+            }
+        }
+    }
+    if (sign && b > str) {
+        *(--b) = sign;
+    }
+    span->sm7_c = (size_t)(str + needed_size - b - 1);
+    *fmt_size = span->sm7_c;
+    return b;
+}
+
+static long long mpz_span_render_load(mpz_span_t *span, size_t size, bool is_signed, bool big_endian, const byte *src) {
+    span->ldg_a = size;
+    span->ldg_b = is_signed ? 1 : 0;
+    int delta;
+    if (!big_endian) {
+        delta = -1;
+        src += size - 1;
+    } else {
+        delta = 1;
+    }
+    unsigned long long val = 0;
+    if (is_signed && (*src & 0x80)) {
+        val = (unsigned long long)-1;
+    }
+    for (uint i = 0; i < size; i++) {
+        val <<= 8;
+        val |= *src;
+        src += delta;
+    }
+    span->ldg_c = (size_t)val;
+    return (long long)val;
+}
+
+static void mpz_span_render_store(mpz_span_t *span, size_t val_sz, bool big_endian, byte *dest, mp_uint_t val) {
+    span->stg_a = val_sz;
+    span->stg_b = big_endian ? 1 : 0;
+    if (MP_ENDIANNESS_LITTLE && !big_endian) {
+        memcpy(dest, &val, val_sz);
+    } else if (MP_ENDIANNESS_BIG && big_endian) {
+        memcpy(dest, (byte *)&val + sizeof(mp_uint_t) - val_sz, val_sz);
+    } else {
+        const byte *src;
+        if (MP_ENDIANNESS_LITTLE) {
+            src = (const byte *)&val + val_sz;
+        } else {
+            src = (const byte *)&val + sizeof(mp_uint_t);
+        }
+        while (val_sz--) {
+            *dest++ = *--src;
+        }
+    }
+    span->stg_c = (size_t)val;
+}
+
+static int mpz_span_render_digit(mpz_span_t *span, int ch, unsigned int base) {
+    span->ch0_a = (size_t)ch;
+    span->ch0_b = (size_t)base;
+    mp_uint_t v = (mp_uint_t)ch;
+    if ('0' <= v && v <= '9') {
+        v -= '0';
+    } else if ('A' <= v && v <= 'Z') {
+        v -= 'A' - 10;
+    } else if ('a' <= v && v <= 'z') {
+        v -= 'a' - 10;
+    } else {
+        span->ch0_c = (size_t)base;
+        return (int)base;
+    }
+    if (v >= base) {
+        span->ch0_c = (size_t)base;
+        return (int)base;
+    }
+    span->ch0_c = (size_t)v;
+    return (int)v;
+}
+
+static int mpz_span_render_prefix(mpz_span_t *span, int base, int base_char, int nonnegative,
+    int show_sign, int space_sign, int show_prefix, int octal_letter, char *prefix_buf) {
+    span->px0_a = (size_t)base;
+    span->px0_b = (size_t)base_char;
+    char *prefix = prefix_buf;
+    if (nonnegative) {
+        if (show_sign) {
+            *prefix++ = '+';
+        } else if (space_sign) {
+            *prefix++ = ' ';
+        }
+    }
+    if (show_prefix) {
+        if (base == 2) {
+            *prefix++ = '0';
+            *prefix++ = (char)(base_char + 'b' - 'a');
+        } else if (base == 8) {
+            *prefix++ = '0';
+            if (octal_letter) {
+                *prefix++ = (char)(base_char + 'o' - 'a');
+            }
+        } else if (base == 16) {
+            *prefix++ = '0';
+            *prefix++ = (char)(base_char + 'x' - 'a');
+        }
+    }
+    *prefix = '\0';
+    span->px0_c = (size_t)(prefix - prefix_buf);
+    return (int)span->px0_c;
+}
+
+size_t mpz_span_format_size(size_t num_bits, int base, const char *prefix, char comma) {
+    mpz_span_t *span = &mpz_span;
+    size_t comma_on = 0;
+    if (comma) {
+        comma_on = 1;
+    }
+    int idx = base;
+    if (idx < 2 || idx > 16) {
+        idx = 10;
+    }
+    mpz_span_fs_bind_tab[idx](span, num_bits, comma_on);
+    mpz_span_fs_compute_tab[idx](span);
+    mpz_span_fs_adjust_tab[idx](span);
+    size_t core = mpz_span_fs_take_tab[idx](span);
+    size_t prefix_len = 0;
+    if (prefix) {
+        prefix_len = strlen(prefix);
+    }
+    return core + prefix_len + 2;
+}
