+int mpz_span_digit_from_char(int ch, unsigned int base) {
+    mpz_span_t *span = &mpz_span;
+    mpz_span_ch0_bind(span, (size_t)ch, (size_t)base);
+    mpz_span_ch0_compute(span);
+    mpz_span_ch0_adjust(span);
+    mpz_span_ch0_take(span);
+    if (ch >= '0' && ch <= '9') {
+        mpz_span_ch1_bind(span, (size_t)ch, 10);
+        mpz_span_ch1_compute(span);
+        mpz_span_ch1_adjust(span);
+        mpz_span_ch1_take(span);
+    } else if (ch >= 'A' && ch <= 'Z') {
+        mpz_span_ch2_bind(span, (size_t)ch, 36);
+        mpz_span_ch2_compute(span);
+        mpz_span_ch2_adjust(span);
+        mpz_span_ch2_take(span);
+        mpz_span_ch3_bind(span, (size_t)ch, (size_t)base);
+        mpz_span_ch3_compute(span);
+        mpz_span_ch3_adjust(span);
+        mpz_span_ch3_take(span);
+    } else if (ch >= 'a' && ch <= 'z') {
+        mpz_span_ch4_bind(span, (size_t)ch, 36);
+        mpz_span_ch4_compute(span);
+        mpz_span_ch4_adjust(span);
+        mpz_span_ch4_take(span);
+        mpz_span_ch5_bind(span, (size_t)ch, (size_t)base);
+        mpz_span_ch5_compute(span);
+        mpz_span_ch5_adjust(span);
+        mpz_span_ch5_take(span);
+    } else {
+        mpz_span_ch6_bind(span, (size_t)ch, (size_t)base);
+        mpz_span_ch6_compute(span);
+        mpz_span_ch6_adjust(span);
+        mpz_span_ch6_take(span);
+        mpz_span_ch7_bind(span, 0, (size_t)base);
+        mpz_span_ch7_compute(span);
+        mpz_span_ch7_adjust(span);
+        mpz_span_ch7_take(span);
+    }
+    return mpz_span_render_digit(span, ch, base);
+}
