+char *mpz_span_format_small(char *str, size_t needed_size, size_t *fmt_size, mp_uint_t num,
+    int base, const char *prefix, char base_char, char comma, char sign) {
+    mpz_span_t *span = &mpz_span;
+    mpz_span_sm0_bind(span, num, (size_t)base);
+    mpz_span_sm0_compute(span);
+    mpz_span_sm0_adjust(span);
+    mpz_span_sm0_take(span);
+    mpz_span_sm1_bind(span, needed_size, comma ? 1 : 0);
+    mpz_span_sm1_compute(span);
+    mpz_span_sm1_adjust(span);
+    mpz_span_sm1_take(span);
+    mpz_span_sm2_bind(span, (size_t)(unsigned char)base_char, (size_t)base);
+    mpz_span_sm2_compute(span);
+    mpz_span_sm2_adjust(span);
+    mpz_span_sm2_take(span);
+    mpz_span_sm3_bind(span, (size_t)(unsigned char)comma, needed_size);
+    mpz_span_sm3_compute(span);
+    mpz_span_sm3_adjust(span);
+    mpz_span_sm3_take(span);
+    mpz_span_sm4_bind(span, prefix ? 1 : 0, prefix ? strlen(prefix) : 0);
+    mpz_span_sm4_compute(span);
+    mpz_span_sm4_adjust(span);
+    mpz_span_sm4_take(span);
+    mpz_span_sm5_bind(span, (size_t)(unsigned char)sign, num == 0 ? 1 : 0);
+    mpz_span_sm5_compute(span);
+    mpz_span_sm5_adjust(span);
+    mpz_span_sm5_take(span);
+    mpz_span_sm6_bind(span, needed_size, (size_t)base);
+    mpz_span_sm6_compute(span);
+    mpz_span_sm6_adjust(span);
+    mpz_span_sm6_take(span);
+    mpz_span_sm7_bind(span, num, (size_t)base);
+    mpz_span_sm7_compute(span);
+    mpz_span_sm7_adjust(span);
+    mpz_span_sm7_take(span);
+    return mpz_span_render_small(span, str, needed_size, fmt_size, num, base, prefix, base_char, comma, sign);
+}
