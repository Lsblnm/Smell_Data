+char *mpz_span_format_mpz_buf(char **buf, size_t *buf_size, size_t *fmt_size, const mpz_t *z,
+    int base, const char *prefix, char base_char, char comma) {
+    mpz_span_t *span = &mpz_span;
+    size_t bits = mpz_max_num_bits(z);
+    mpz_span_mz0_bind(span, bits, (size_t)base);
+    mpz_span_mz0_compute(span);
+    mpz_span_mz0_adjust(span);
+    mpz_span_mz0_take(span);
+    mpz_span_mz1_bind(span, prefix ? 1 : 0, comma ? 1 : 0);
+    mpz_span_mz1_compute(span);
+    mpz_span_mz1_adjust(span);
+    mpz_span_mz1_take(span);
+    mpz_span_mz2_bind(span, (size_t)(unsigned char)base_char, (size_t)base);
+    mpz_span_mz2_compute(span);
+    mpz_span_mz2_adjust(span);
+    mpz_span_mz2_take(span);
+    mpz_span_mz3_bind(span, bits, (size_t)base);
+    mpz_span_mz3_compute(span);
+    mpz_span_mz3_adjust(span);
+    mpz_span_mz3_take(span);
+    mpz_span_mz4_bind(span, *buf_size, comma ? 1 : 0);
+    mpz_span_mz4_compute(span);
+    mpz_span_mz4_adjust(span);
+    mpz_span_mz4_take(span);
+    mpz_span_mz5_bind(span, bits, *buf_size);
+    mpz_span_mz5_compute(span);
+    mpz_span_mz5_adjust(span);
+    mpz_span_mz5_take(span);
+    size_t needed_size = mpz_span_format_size(bits, base, prefix, comma);
+    if (needed_size > *buf_size) {
+        *buf = m_new(char, needed_size);
+        *buf_size = needed_size;
+    }
+    char *str = *buf;
+    *fmt_size = mpz_as_str_inpl(z, (unsigned int)base, prefix, base_char, comma, str);
+    return str;
+}
