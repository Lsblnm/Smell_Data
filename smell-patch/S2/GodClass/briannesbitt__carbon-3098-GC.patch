+    {
+        $factors = self::microsecondConversionFactors();
+        $target = self::canonicalizeUnitName($target);
+        if ($target === 'microsecond') {
+            return $value;
+        }
+        if (!isset($factors[$target])) {
+            return null;
+        }
+        if ($value == 0.0) {
+            return 0.0;
+        }
+
+        return $value * (float) $factors[$target];
+    }
+
+
+    private static function convertIntervalUnitValue(float $value, string $source, string $target): ?float
+    {
+        $source = self::canonicalizeUnitName($source);
+        $target = self::canonicalizeUnitName($target);
+        if ($source === 'year') {
+            return self::convertFromYear($value, $target);
+        }
+        if ($source === 'quarter') {
+            return self::convertFromQuarter($value, $target);
+        }
+        if ($source === 'month') {
+            return self::convertFromMonth($value, $target);
+        }
+        if ($source === 'week') {
+            return self::convertFromWeek($value, $target);
+        }
+        if ($source === 'day') {
+            return self::convertFromDay($value, $target);
+        }
+        if ($source === 'hour') {
+            return self::convertFromHour($value, $target);
+        }
+        if ($source === 'minute') {
+            return self::convertFromMinute($value, $target);
+        }
+        if ($source === 'second') {
+            return self::convertFromSecond($value, $target);
+        }
+        if ($source === 'millisecond') {
+            return self::convertFromMillisecond($value, $target);
+        }
+        if ($source === 'microsecond') {
+            return self::convertFromMicrosecond($value, $target);
+        }
+
+        return self::cascadeFactorBetween($source, $target) !== null
+            ? $value * self::cascadeFactorBetween($source, $target)
+            : null;
+    }
