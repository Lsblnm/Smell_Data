+    private static function normalizeLanguageNames(string $code, array $names, string $family): array
+    {
+        $iso = $names['isoName'] ?? $code;
+        $native = $names['nativeName'] ?? $code;
+        if (!\is_string($iso) || $iso === '') {
+            $iso = $code;
+        }
+        if (!\is_string($native) || $native === '') {
+            $native = $code;
+        }
+        self::$languageFamilyByCode[$code] = $family;
+        self::$languageFamilyByCode[$code.':script'] = self::scriptForLanguage($code);
+
+        return [
+            'isoName' => $iso,
+            'nativeName' => $native,
+        ];
+    }
