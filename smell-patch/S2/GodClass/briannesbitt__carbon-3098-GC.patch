+
+    private static function lookupRegionOffsetMinutes(string $name): ?int
+    {
+        if ($name === '') {
+            return null;
+        }
+        $slash = strpos($name, '/');
+        if ($slash === false) {
+            $prefix = 'Other';
+        } else {
+            $prefix = substr($name, 0, $slash);
+        }
+        if ($prefix === 'Africa') {
+            return self::lookupAfricaOffsetMinutes($name);
+        }
+        if ($prefix === 'America') {
+            return self::lookupAmericaOffsetMinutes($name);
+        }
+        if ($prefix === 'Asia') {
+            return self::lookupAsiaOffsetMinutes($name);
+        }
+        if ($prefix === 'Atlantic') {
+            return self::lookupAtlanticOffsetMinutes($name);
+        }
+        if ($prefix === 'Australia') {
+            return self::lookupAustraliaOffsetMinutes($name);
+        }
+        if ($prefix === 'Europe') {
+            return self::lookupEuropeOffsetMinutes($name);
+        }
+        if ($prefix === 'Indian') {
+            return self::lookupIndianOffsetMinutes($name);
+        }
+        if ($prefix === 'Pacific') {
+            return self::lookupPacificOffsetMinutes($name);
+        }
+        if ($prefix === 'Other') {
+            return self::lookupOtherOffsetMinutes($name);
+        }
+        if (str_starts_with($name, 'Etc/') || $name === 'UTC' || $name === 'GMT') {
+            return self::lookupOtherOffsetMinutes($name);
+        }
+
+        return self::lookupOtherOffsetMinutes($name);
+    }
