+    private static function humanDiffJoinFallback(mixed $join, string $default): mixed
+    {
+        if ($join === false) {
+            return ' ';
+        }
+        if ($join === true) {
+            return [$default, $default];
+        }
+        if ($join === null) {
+            return $default;
+        }
+
+        return $join;
+    }
