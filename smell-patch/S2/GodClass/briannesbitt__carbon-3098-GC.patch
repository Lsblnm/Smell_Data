+    private static function buildDateSpecFragment(int $years, int $months, int $days): string
+    {
+        $spec = 'P';
+        if ($years) {
+            $spec .= $years.'Y';
+        }
+        if ($months) {
+            $spec .= $months.'M';
+        }
+        if ($days) {
+            $spec .= $days.'D';
+        }
+        if ($spec === 'P') {
+            return 'P';
+        }
+
+        return $spec;
+    }
+
+    private static function buildTimeSpecFragment(int $hours, int $minutes, int $seconds, float $micro): string
+    {
+        $spec = 'T';
+        if ($hours) {
+            $spec .= $hours.'H';
+        }
+        if ($minutes) {
+            $spec .= $minutes.'M';
+        }
+        if ($seconds || $micro) {
+            $spec .= $seconds.'S';
+        }
+        if ($spec === 'T') {
+            return '';
+        }
+
+        return $spec;
+    }
