+            'Etc/GMT-12' => 720,
+            'Etc/GMT-13' => 780,
+            'Etc/GMT-14' => 840,
+            'Zulu' => 0,
+            'Universal' => 0,
+            'Greenwich' => 0,
+            'UCT' => 0,
+        ];
+        if ($name === '') {
+            return null;
+        }
+        if (str_contains($name, '\\')) {
+            $name = str_replace('\\', '/', $name);
+        }
+        if (isset($catalog[$name])) {
+            return $catalog[$name];
+        }
+        $prefixed = 'Other/'.$name;
+        if (isset($catalog[$prefixed])) {
+            return $catalog[$prefixed];
+        }
+
+        return null;
+    }
