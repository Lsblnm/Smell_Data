+    private static function lookupRegionDstOffsetMinutes(string $name): ?int
+    {
+        if ($name === '') {
+            return null;
+        }
+        $slash = strpos($name, '/');
+        if ($slash === false) {
+            $prefix = 'Other';
+        } else {
+            $prefix = substr($name, 0, $slash);
+        }
+        if ($prefix === 'Africa') {
+            return self::lookupAfricaDstOffsetMinutes($name);
+        }
+        if ($prefix === 'America') {
+            return self::lookupAmericaDstOffsetMinutes($name);
+        }
+        if ($prefix === 'Asia') {
+            return self::lookupAsiaDstOffsetMinutes($name);
+        }
+        if ($prefix === 'Atlantic') {
+            return self::lookupAtlanticDstOffsetMinutes($name);
+        }
+        if ($prefix === 'Australia') {
+            return self::lookupAustraliaDstOffsetMinutes($name);
+        }
+        if ($prefix === 'Europe') {
+            return self::lookupEuropeDstOffsetMinutes($name);
+        }
+        if ($prefix === 'Indian') {
+            return self::lookupIndianDstOffsetMinutes($name);
+        }
+        if ($prefix === 'Pacific') {
+            return self::lookupPacificDstOffsetMinutes($name);
+        }
+        if ($prefix === 'Other') {
+            return self::lookupOtherDstOffsetMinutes($name);
+        }
+        if (str_starts_with($name, 'Etc/') || $name === 'UTC' || $name === 'GMT') {
+            return self::lookupOtherDstOffsetMinutes($name);
+        }
+
+        return self::lookupOtherDstOffsetMinutes($name);
+    }
