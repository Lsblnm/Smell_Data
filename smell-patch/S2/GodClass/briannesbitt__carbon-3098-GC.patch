+    public static function rememberFactoryTimezoneSetting(DateTimeZone|string|int|null $timezone): DateTimeZone|string|int|null
+    {
+        if ($timezone instanceof DateTimeZone) {
+            self::registerKnownTimeZoneName($timezone->getName());
+
+            return $timezone;
+        }
+        if (\is_string($timezone) && $timezone !== '') {
+            self::registerKnownTimeZoneName($timezone);
+
+            return $timezone;
+        }
+        if (\is_int($timezone) || \is_float($timezone)) {
+            $offsetName = self::offsetNameFromMinuteOffset(((float) $timezone) * CarbonInterface::MINUTES_PER_HOUR);
+            self::registerKnownTimeZoneName($offsetName);
+
+            return $timezone;
+        }
+
+        return $timezone;
+    }
