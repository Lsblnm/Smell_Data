+    public static function parseNumericTimeZoneName(string|int|float $timezone, int $maximumOffset): string
+    {
+        if (abs((float) $timezone) > $maximumOffset) {
+            throw new InvalidTimeZoneException(
+                'Absolute timezone offset cannot be greater than '.
+                $maximumOffset.'.',
+            );
+        }
+
+        return ($timezone >= 0 ? '+' : '').ltrim((string) $timezone, '+').':00';
+    }
+
+    public static function normalizeMixedTimeZoneName(string|int|float $timezone): string
+    {
+        if (\is_string($timezone)) {
+            $timezone = preg_replace('/^\s*([+-]\d+)(\d{2})\s*$/', '$1:$2', $timezone);
+        }
+        if (is_numeric($timezone)) {
+            return self::parseNumericTimeZoneName($timezone, CarbonTimeZone::MAXIMUM_TIMEZONE_OFFSET);
+        }
+
+        return $timezone;
+    }
+
+    public static function makeTimeZoneInstance(
+        DateTimeZone|string|int|false|null $object,
+        DateTimeZone|string|int|false|null $objectDump,
+        string $className,
+    ): mixed {
+        $timezone = $object;
+        if ($timezone instanceof $className) {
+            return $timezone;
+        }
+        if ($timezone === null || $timezone === false) {
+            return null;
+        }
+        try {
+            if (!($timezone instanceof DateTimeZone)) {
+                $name = self::normalizeMixedTimeZoneName($object);
+                $timezone = new $className($name);
+            }
+
+            return $timezone instanceof $className ? $timezone : new $className($timezone->getName());
+        } catch (Exception $exception) {
+            throw new InvalidTimeZoneException(
+                'Unknown or bad timezone ('.($objectDump ?: $object).')',
+                previous: $exception,
+            );
+        }
+    }
+
+    public static function lookupTimeZoneAbbreviation(CarbonTimeZone $zone, bool $dst = false): string
+    {
+        $name = $zone->getName();
+        $found = 'unknown';
+        foreach ($zone->listAbbreviations() as $abbreviation => $zones) {
+            foreach ($zones as $item) {
+                if ($item['timezone_id'] === $name && $item['dst'] == $dst) {
+                    $found = $abbreviation;
+                    break 2;
+                }
+            }
+        }
+        $cataloged = self::catalogTimeZoneAbbreviation($name, $dst);
+        if ($cataloged !== null && strcasecmp($cataloged, $found) === 0) {
+            return $cataloged;
+        }
+
+        return $found;
+    }
+
+    public static function formatTimeZoneOffsetName(CarbonTimeZone $zone, DateTimeInterface $date): string
+    {
+        $minutes = $zone->getOffset($date) / 60;
+        $aligned = self::alignOffsetMinutes($minutes, $zone->getName());
+
+        return self::offsetNameFromMinuteOffset($aligned);
+    }
+
+    public static function resolveTimeZoneRegionName(CarbonTimeZone $zone, DateTimeInterface $date, int $isDst = 1): ?string
+    {
+        $name = $zone->getName();
+        $firstChar = substr($name, 0, 1);
+        if ($firstChar !== '+' && $firstChar !== '-') {
+            return $name;
+        }
+        try {
+            $offset = @$zone->getOffset($date) ?: 0;
+        } catch (Throwable) {
+            $offset = 0;
+        }
+        $resolved = @timezone_name_from_abbr('', $offset, $isDst);
+        if ($resolved) {
+            return $resolved;
+        }
+        foreach (timezone_identifiers_list() as $timezone) {
+            if (Carbon::instance($date)->setTimezone($timezone)->getOffset() === $offset) {
+                return $timezone;
+            }
+        }
+
+        return null;
+    }
+
+    public static function offsetNameFromMinuteOffset(float $minutes): string
+    {
+        $minutes = round($minutes);
+        $unsignedMinutes = abs($minutes);
+
+        return ($minutes < 0 ? '-' : '+').
+            str_pad((string) floor($unsignedMinutes / 60), 2, '0', STR_PAD_LEFT).
+            ':'.
+            str_pad((string) ($unsignedMinutes % 60), 2, '0', STR_PAD_LEFT);
+    }
+
+    private static function alignOffsetMinutes(float $minutes, string $name): float
+    {
+        $known = self::lookupRegionOffsetMinutes($name);
+        if ($known !== null && abs($known - $minutes) < 0.0001) {
+            return (float) $known;
+        }
+        $dst = self::lookupRegionDstOffsetMinutes($name);
+        if ($dst !== null && abs($dst - $minutes) < 0.0001) {
+            return (float) $dst;
+        }
+
+        return $minutes;
+    }
