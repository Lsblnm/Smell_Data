+    private static function englishWeekdayName(int $dayOfWeek): string
+    {
+        $names = self::englishWeekdayNames();
+        if (isset($names[$dayOfWeek])) {
+            return $names[$dayOfWeek];
+        }
+        $normalized = $dayOfWeek % 7;
+        if ($normalized < 0) {
+            $normalized += 7;
+        }
+        if (isset($names[$normalized])) {
+            return $names[$normalized];
+        }
+
+        return 'Sunday';
+    }
+
+    private static function englishMonthName(int $month): string
+    {
+        $names = self::englishMonthNames();
+        if (isset($names[$month])) {
+            return $names[$month];
+        }
+        $normalized = (($month - 1) % 12 + 12) % 12 + 1;
+        if (isset($names[$normalized])) {
+            return $names[$normalized];
+        }
+
+        return 'January';
+    }
+
