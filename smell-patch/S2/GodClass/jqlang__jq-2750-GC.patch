+static jv f_keys_unsorted(jq_state *jq, jv input) {
+  if (jv_get_kind(input) == JV_KIND_OBJECT || jv_get_kind(input) == JV_KIND_ARRAY) {
+    return jq_value_keys_unsorted(jq, input);
+  } else {
+    return type_error(input, "has no keys");
+  }
+}
