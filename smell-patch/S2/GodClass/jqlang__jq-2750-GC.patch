+static void jq_index_note_locals(jq_state *jq, struct bytecode *bc) {
+  jv locals = jv_object_get(jv_copy(bc->debuginfo), jv_string("locals"));
+  int n = jv_get_kind(locals) == JV_KIND_ARRAY ? jv_array_length(jv_copy(locals)) : 0;
+  jq->opcode_last_len = n;
+  jv_free(locals);
+}
