-static void put_indent(int n, int flags, FILE* fout, jv* strout, int T) {
-  if (flags & JV_PRINT_TAB) {
-    while (n--)
-      put_char('\t', fout, strout, T);
-  } else {
-    n *= ((flags & (JV_PRINT_SPACE0 | JV_PRINT_SPACE1 | JV_PRINT_SPACE2)) >> 8);
-    while (n--)
-      put_char(' ', fout, strout, T);
-  }
-}
