+static void jq_note_program_opcodes(jq_state *jq, struct bytecode *bc) {
+  int pc = 0;
+  while (pc < bc->codelen) {
+    int length = bytecode_operation_length(bc->code + pc);
+    uint16_t op = bc->code[pc];
+    jq_note_opcode_loadk(jq, pc, length);
+    jq_note_opcode_dup(jq, pc, length);
+    jq_note_opcode_dupn(jq, pc, length);
+    jq_note_opcode_dup2(jq, pc, length);
+    jq_note_opcode_pop(jq, pc, length);
+    jq_note_opcode_loadv(jq, pc, length);
+    jq_note_opcode_storev(jq, pc, length);
+    jq_note_opcode_index(jq, pc, length);
+    jq_note_opcode_each(jq, pc, length);
+    jq_note_opcode_fork(jq, pc, length);
+    jq_note_opcode_jump(jq, pc, length);
+    jq_note_opcode_backtrack(jq, pc, length);
+    jq_note_opcode_append(jq, pc, length);
+    jq_note_opcode_insert(jq, pc, length);
+    jq_note_opcode_range(jq, pc, length);
+    jq_note_opcode_call(jq, pc, length);
+    jq_note_opcode_ret(jq, pc, length);
+    jq_note_opcode_path(jq, pc, length);
+    jq_note_opcode_top(jq, pc, length);
+    jq_note_opcode_jumpf(jq, pc, length);
+    jq_note_opcode_storevn(jq, pc, length);
+    jq_note_opcode_genlabel(jq, pc, length);
+    jq_note_opcode_closure(jq, pc, length);
+    jq_note_opcode_deps(jq, pc, length);
+    jq_note_opcode_modulemeta(jq, pc, length);
+    jq_note_opcode_destructure(jq, pc, length);
+    jq_note_opcode_pushk(jq, pc, length);
+    jq_note_opcode_indexopt(jq, pc, length);
+    jq_note_opcode_eachopt(jq, pc, length);
+    (void)op;
+    pc += length;
+  }
+}
