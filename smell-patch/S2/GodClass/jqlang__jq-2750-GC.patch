+static void jq_info_take_code(jq_state *jq, struct bytecode *bc) {
+  jq->info_code_bytes = bc->codelen * (int)sizeof(uint16_t);
+  jq->info_first_op = bc->codelen ? bc->code[0] : 0;
+  jq->info_last_op = bc->codelen ? bc->code[bc->codelen - 1] : 0;
+}
+
+static void jq_info_take_shape(jq_state *jq, struct bytecode *bc) {
+  jq->info_func_count = bc->nsubfunctions;
+  jq->info_closure_count = bc->nclosures;
+  jq->info_global_count = bc->globals ? bc->globals->ncfunctions : 0;
+  jq->info_parent_depth = 0;
+  struct bytecode *p = bc->parent;
+  while (p) {
+    jq->info_parent_depth++;
+    p = p->parent;
+  }
+}
