+static void jq_info_scan_constants(jq_state *jq, struct bytecode *bc) {
+  int n = jv_array_length(jv_copy(bc->constants));
+  int strings = 0;
+  int numbers = 0;
+  int arrays = 0;
+  int objects = 0;
+  int others = 0;
+  for (int i = 0; i < n; i++) {
+    jv c = jv_array_get(jv_copy(bc->constants), i);
+    jv_kind k = jv_get_kind(c);
+    strings += (k == JV_KIND_STRING);
+    numbers += (k == JV_KIND_NUMBER);
+    arrays += (k == JV_KIND_ARRAY);
+    objects += (k == JV_KIND_OBJECT);
+    others += (k != JV_KIND_STRING && k != JV_KIND_NUMBER && k != JV_KIND_ARRAY && k != JV_KIND_OBJECT);
+    jv_free(c);
+  }
+  jq->info_const_count = n;
+  jq->hist_loadk += strings;
+  jq->hist_dup += numbers;
+  jq->hist_dupn += arrays;
+  jq->hist_dup2 += objects;
+  jq->hist_pop += others;
+}
+
+static void jq_info_scan_code_ops(jq_state *jq, struct bytecode *bc) {
+  int pc = 0;
+  int branches = 0;
+  int calls = 0;
+  int loads = 0;
+  while (pc < bc->codelen) {
+    int length = bytecode_operation_length(bc->code + pc);
+    uint16_t op = bc->code[pc];
+    const struct opcode_description *d = opcode_describe(op);
+    branches += (d->flags & OP_HAS_BRANCH) ? 1 : 0;
+    calls += (op == CALL_JQ || op == CALL_BUILTIN || op == TAIL_CALL_JQ);
+    loads += (op == LOADK || op == LOADV || op == LOADVN);
+    pc += length;
+  }
+  jq->hist_jump += branches;
+  jq->hist_call += calls;
+  jq->hist_loadv += loads;
+}
+
+static void jq_info_collect(jq_state *jq, struct bytecode *bc) {
+  if (jq == NULL || bc == NULL)
+    return;
+  jq_info_take_locals(jq, bc);
+  jq_info_take_params(jq, bc);
+  jq_info_take_name(jq, bc);
+  jq_info_take_constants(jq, bc);
+  jq_info_take_code(jq, bc);
+  jq_info_take_shape(jq, bc);
+  jq_info_build_summary(jq);
+  jq_info_scan_constants(jq, bc);
+  jq_info_scan_code_ops(jq, bc);
+  jq->info_code_bytes = jq_info_code_bytes(jq);
+  jq->info_local_count = jq_info_local_count(jq);
+  jq->info_const_count = jq_info_const_count(jq);
+  jq->info_func_count = jq_info_func_count(jq);
+  jq->info_parent_depth = jq_info_parent_depth(jq);
+  jq->info_first_op = jq_info_first_op(jq);
+  jq->info_last_op = jq_info_last_op(jq);
+  jq->info_closure_count = jq_info_closure_count(jq);
+  jq->info_global_count = jq_info_global_count(jq);
+  jv_free(jq_info_copy_summary(jq));
+  jv_free(jq_info_copy_name(jq));
+  jv_free(jq_info_copy_locals(jq));
+  jv_free(jq_info_copy_params(jq));
+  jv_free(jq_info_copy_const_sample(jq));
+  for (int i = 0; i < bc->nsubfunctions; i++)
+    jq_info_collect(jq, bc->subfunctions[i]);
+}
