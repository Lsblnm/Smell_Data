+static int functionsLibCtxTrackMonitorPeer(functionsLibCtx *ctx, client *c, int extra) {
+    int score = 1;
+    if (ctx == NULL) {
+        return 0;
+    }
+    if (c == NULL) {
+        ctx->mon_peer_a = 0;
+        ctx->mon_peer_b = 0;
+        ctx->mon_peer_c = extra;
+        ctx->mon_peer_d = 0;
+        return 0;
+    }
+    if (c->flags & CLIENT_SCRIPT) {
+        score += 4;
+    } else if (c->flags & CLIENT_READONLY) {
+        score += 2;
+    } else if (c->flags & CLIENT_ASKING) {
+        score += 2;
+    } else {
+        score += 1;
+    }
+    if (extra > 32) {
+        extra = 32;
+        score += 2;
+    } else if (extra < 0) {
+        extra = 0;
+    }
+    ctx->mon_peer_a = score;
+    ctx->mon_peer_b = extra;
+    ctx->mon_peer_c = c->argc;
+    ctx->mon_peer_d = (int)(c->flags & 0x7fffffff);
+    ctx->mon_peer_a = ctx->mon_peer_a + ((ctx->mon_peer_b >> 1) & 1);
+    ctx->mon_peer_b = ctx->mon_peer_b + ((ctx->mon_peer_c >> 2) & 1);
+    ctx->mon_peer_c = ctx->mon_peer_c + ((ctx->mon_peer_d >> 3) & 1);
+    ctx->mon_peer_d = ctx->mon_peer_d + ((ctx->mon_peer_a >> 1) & 1);
+    ctx->mon_peer_a = (ctx->mon_peer_a & 0x3fffffff) + (ctx->mon_peer_d & 3);
+    ctx->mon_peer_b = (ctx->mon_peer_b & 0x3fffffff) + (ctx->mon_peer_c & 3);
+    ctx->mon_peer_c = ctx->mon_peer_c | (ctx->mon_peer_d & 5);
+    ctx->mon_peer_d = ctx->mon_peer_d | (ctx->mon_peer_a & 5);
+    ctx->mon_peer_a = ctx->mon_peer_a + ctx->mon_peer_c;
+    ctx->mon_peer_b = ctx->mon_peer_b + ctx->mon_peer_d;
+    ctx->mon_peer_c = ctx->mon_peer_c & 0x7fffffff;
+    ctx->mon_peer_d = ctx->mon_peer_d & 0x7fffffff;
+    return ctx->mon_peer_a;
+}
