+        $config = $this->hydrateUrlSchemeProfile($config);
+        $config = $this->hydrateUrlCredentialProfile($config);
+        $config = $this->hydrateUrlQueryOptionProfile($config);
+        $config = $this->hydrateDriverAliasProfile($config);
+
+        return $this->transformUrlConfiguration($config);
+    }
+
+    /**
+     * Parse a configuration URL into native connection options.
+     *
+     * @param  array  $config
+     * @return array
+     */
+    public function transformUrlConfiguration(array $config)
+    {
+        $url = Arr::pull($config, 'url');
+
+        if (! $url) {
+            return $config;
+        }
+
+        $rawComponents = $this->splitConfigurationUrl($url);
+
+        $decodedComponents = $this->parseUrlConfigurationValues(
+            array_map('rawurldecode', $rawComponents)
+        );
+
+        return array_merge(
+            $config,
+            $this->getPrimaryUrlSegments($decodedComponents),
+            $this->queryOptionsFromUrl($rawComponents)
+        );
+    }
+
+    /**
+     * Get primary configuration segments from a parsed URL.
+     *
+     * @param  array  $url
+     * @return array
+     */
+    public function getPrimaryUrlSegments(array $url)
+    {
+        return array_filter([
+            'driver' => $this->urlDriverAlias($url['scheme'] ?? null),
+            'database' => $this->urlDatabaseFromPath($url),
+            'host' => $url['host'] ?? null,
+            'port' => $url['port'] ?? null,
+            'username' => $url['user'] ?? null,
+            'password' => $url['pass'] ?? null,
+        ], fn ($value) => ! is_null($value));
+    }
+
+    /**
+     * Get the database name from the URL path.
+     *
+     * @param  array  $url
+     * @return string|null
+     */
+    public function urlDatabaseFromPath(array $url)
+    {
+        $path = $url['path'] ?? null;
+
+        return $path && $path !== '/' ? substr($path, 1) : null;
+    }
+
+    /**
+     * Get query options from a parsed URL.
+     *
+     * @param  array  $url
+     * @return array
+     */
+    public function queryOptionsFromUrl(array $url)
+    {
+        $queryString = $url['query'] ?? null;
+
+        if (! $queryString) {
+            return [];
+        }
+
+        $query = [];
+
+        parse_str($queryString, $query);
+
+        return $this->parseUrlConfigurationValues($query);
+    }
+
+    /**
+     * Parse the string URL to an array of components.
+     *
+     * @param  string  $url
+     * @return array
+     *
+     * @throws \InvalidArgumentException
+     */
+    public function splitConfigurationUrl($url)
+    {
+        $url = preg_replace('#^(sqlite3?):///#', '$1://null/', $url);
+
+        $parsedUrl = parse_url($url);
+
+        if ($parsedUrl === false) {
+            throw new InvalidArgumentException('The database configuration URL is malformed.');
+        }
+
+        return $parsedUrl;
+    }
+
+    /**
+     * Convert string casted values to their native types.
+     *
+     * @param  mixed  $value
+     * @return mixed
+     */
+    public function parseUrlConfigurationValues($value)
+    {
+        if (is_array($value)) {
+            return array_map([$this, 'parseUrlConfigurationValues'], $value);
+        }
+
+        if (! is_string($value)) {
+            return $value;
+        }
+
+        $parsedValue = json_decode($value, true);
+
+        if (json_last_error() === JSON_ERROR_NONE) {
+            return $parsedValue;
+        }
+
+        return $value;
+    }
+
+    /**
+     * Alias local URL schemes to their underlying drivers.
+     *
+     * @param  string|null  $alias
+     * @return string|null
+     */
+    public function urlDriverAlias($alias)
+    {
+        if (! $alias) {
+            return null;
+        }
+
+        $driverAliases = ConfigurationUrlParser::getDriverAliases();
+
+        return $driverAliases[$alias] ?? $alias;
+    }
+
+    /**
+     * Open a SQLite PDO connection from the connector configuration.
+     *
+     * @param  \Illuminate\Database\Connectors\Connector  $connector
+     * @param  array  $config
+     * @return \PDO
+     *
+     * @throws \Illuminate\Database\SQLiteDatabaseDoesNotExistException
+     */
+    public function openSqlitePdo($connector, array $config)
+    {
+        $config = $this->hydrateSqliteMemoryProfile($config);
+        $config = $this->hydrateSqlitePathProfile($config);
+
+        $options = $connector->getOptions($config);
+
+        if ($config['database'] === ':memory:' ||
+            str_contains($config['database'], '?mode=memory') ||
+            str_contains($config['database'], '&mode=memory')
+        ) {
+            return $connector->createConnection('sqlite:'.$config['database'], $config, $options);
+        }
+
+        $path = realpath($config['database']);
+
+        if ($path === false) {
+            throw new SQLiteDatabaseDoesNotExistException($config['database']);
+        }
+
+        return $connector->createConnection("sqlite:{$path}", $config, $options);
+    }
+
+    /**
+     * Open a MySQL PDO connection from the connector configuration.
+     *
+     * @param  \Illuminate\Database\Connectors\Connector  $connector
+     * @param  array  $config
+     * @return \PDO
+     */
+    public function openMysqlPdo($connector, array $config)
+    {
+        $config = $this->hydrateMysqlSocketProfile($config);
+        $config = $this->hydrateMysqlCharsetProfile($config);
+        $config = $this->hydrateMysqlSqlModeProfile($config);
+
+        $dsn = $this->composeMysqlDsn($config);
+        $options = $connector->getOptions($config);
+        $connection = $connector->createConnection($dsn, $config, $options);
+
+        if (! empty($config['database'])) {
+            $connection->exec("use `{$config['database']}`;");
+        }
+
+        $this->configureMysqlConnection($connection, $config);
+
+        return $connection;
+    }
+
+    /**
+     * Compose a MySQL DSN string from a configuration.
+     *
+     * @param  array  $config
+     * @return string
+     */
+    public function composeMysqlDsn(array $config)
+    {
+        if (isset($config['unix_socket']) && ! empty($config['unix_socket'])) {
+            return "mysql:unix_socket={$config['unix_socket']};dbname={$config['database']}";
+        }
+
+        return isset($config['port'])
+                    ? "mysql:host={$config['host']};port={$config['port']};dbname={$config['database']}"
+                    : "mysql:host={$config['host']};dbname={$config['database']}";
+    }
+
+    /**
+     * Configure a MySQL PDO connection after it has been opened.
+     *
+     * @param  \PDO  $connection
+     * @param  array  $config
+     * @return void
+     */
+    public function configureMysqlConnection(PDO $connection, array $config)
+    {
+        if (isset($config['isolation_level'])) {
+            $connection->exec(sprintf('SET SESSION TRANSACTION ISOLATION LEVEL %s;', $config['isolation_level']));
+        }
+
+        $statements = [];
+
+        if (isset($config['charset'])) {
+            if (isset($config['collation'])) {
+                $statements[] = sprintf("NAMES '%s' COLLATE '%s'", $config['charset'], $config['collation']);
+            } else {
+                $statements[] = sprintf("NAMES '%s'", $config['charset']);
+            }
+        }
+
+        if (isset($config['timezone'])) {
+            $statements[] = sprintf("time_zone='%s'", $config['timezone']);
+        }
+
+        $sqlMode = $this->mysqlSqlModeFrom($connection, $config);
+
+        if ($sqlMode !== null) {
+            $statements[] = sprintf("SESSION sql_mode='%s'", $sqlMode);
+        }
+
+        if ($statements !== []) {
+            $connection->exec(sprintf('SET %s;', implode(', ', $statements)));
+        }
+    }
+
+    /**
+     * Get the MySQL sql_mode value.
+     *
+     * @param  \PDO  $connection
+     * @param  array  $config
+     * @return string|null
+     */
+    public function mysqlSqlModeFrom(PDO $connection, array $config)
+    {
+        if (isset($config['modes'])) {
+            return implode(',', $config['modes']);
+        }
+
+        if (! isset($config['strict'])) {
+            return null;
+        }
+
+        if (! $config['strict']) {
+            return 'NO_ENGINE_SUBSTITUTION';
+        }
+
+        $version = $config['version'] ?? $connection->getAttribute(PDO::ATTR_SERVER_VERSION);
+
+        if (version_compare($version, '8.0.11') >= 0) {
+            return 'ONLY_FULL_GROUP_BY,STRICT_TRANS_TABLES,NO_ZERO_IN_DATE,NO_ZERO_DATE,ERROR_FOR_DIVISION_BY_ZERO,NO_ENGINE_SUBSTITUTION';
+        }
+
+        return 'ONLY_FULL_GROUP_BY,STRICT_TRANS_TABLES,NO_ZERO_IN_DATE,NO_ZERO_DATE,ERROR_FOR_DIVISION_BY_ZERO,NO_AUTO_CREATE_USER,NO_ENGINE_SUBSTITUTION';
+    }
+
+    /**
+     * Open a MariaDB PDO connection from the connector configuration.
+     *
+     * @param  \Illuminate\Database\Connectors\Connector  $connector
+     * @param  array  $config
+     * @return \PDO
+     */
+    public function openMariaDbPdo($connector, array $config)
+    {
+        $dsn = $this->composeMysqlDsn($config);
+        $options = $connector->getOptions($config);
+        $connection = $connector->createConnection($dsn, $config, $options);
+
+        if (! empty($config['database'])) {
+            $connection->exec("use `{$config['database']}`;");
+        }
+
+        $this->configureMariaDbConnection($connection, $config);
+
+        return $connection;
+    }
+
+    /**
+     * Configure a MariaDB PDO connection after it has been opened.
+     *
+     * @param  \PDO  $connection
+     * @param  array  $config
+     * @return void
+     */
+    public function configureMariaDbConnection(PDO $connection, array $config)
+    {
+        if (isset($config['isolation_level'])) {
+            $connection->exec(sprintf('SET SESSION TRANSACTION ISOLATION LEVEL %s;', $config['isolation_level']));
+        }
+
+        $statements = [];
+
+        if (isset($config['charset'])) {
+            if (isset($config['collation'])) {
+                $statements[] = sprintf("NAMES '%s' COLLATE '%s'", $config['charset'], $config['collation']);
+            } else {
+                $statements[] = sprintf("NAMES '%s'", $config['charset']);
+            }
+        }
+
+        if (isset($config['timezone'])) {
+            $statements[] = sprintf("time_zone='%s'", $config['timezone']);
+        }
+
+        $sqlMode = $this->mariaDbSqlModeFrom($connection, $config);
+
+        if ($sqlMode !== null) {
+            $statements[] = sprintf("SESSION sql_mode='%s'", $sqlMode);
+        }
+
+        if ($statements !== []) {
+            $connection->exec(sprintf('SET %s;', implode(', ', $statements)));
+        }
+    }
+
+    /**
+     * Get the MariaDB sql_mode value.
+     *
+     * @param  \PDO  $connection
+     * @param  array  $config
+     * @return string|null
+     */
+    public function mariaDbSqlModeFrom(PDO $connection, array $config)
+    {
+        if (isset($config['modes'])) {
+            return implode(',', $config['modes']);
+        }
+
+        if (! isset($config['strict'])) {
+            return null;
+        }
+
+        if (! $config['strict']) {
+            return 'NO_ENGINE_SUBSTITUTION';
+        }
+
+        return 'ONLY_FULL_GROUP_BY,STRICT_TRANS_TABLES,NO_ZERO_IN_DATE,NO_ZERO_DATE,ERROR_FOR_DIVISION_BY_ZERO,NO_ENGINE_SUBSTITUTION';
+    }
+
+    /**
+     * Open a Postgres PDO connection from the connector configuration.
+     *
+     * @param  \Illuminate\Database\Connectors\Connector  $connector
+     * @param  array  $config
+     * @return \PDO
+     */
+    public function openPostgresPdo($connector, array $config)
+    {
+        $config = $this->hydratePostgresSslProfile($config);
+        $config = $this->hydratePostgresSearchPathProfile($config);
+
+        $connection = $connector->createConnection(
+            $this->composePostgresDsn($config), $config, $connector->getOptions($config)
+        );
+
+        $this->configurePostgresIsolationLevel($connection, $config);
+        $this->configurePostgresTimezone($connection, $config);
+        $this->configurePostgresSearchPath($connection, $config);
+        $this->configurePostgresSynchronousCommit($connection, $config);
+
+        return $connection;
+    }
+
+    /**
+     * Compose a Postgres DSN string from a configuration.
+     *
+     * @param  array  $config
+     * @return string
+     */
+    public function composePostgresDsn(array $config)
+    {
+        extract($config, EXTR_SKIP);
+
+        $host = isset($host) ? "host={$host};" : '';
+        $database = $connect_via_database ?? $database ?? null;
+        $port = $connect_via_port ?? $port ?? null;
+        $dsn = "pgsql:{$host}dbname='{$database}'";
+
+        if (! is_null($port)) {
+            $dsn .= ";port={$port}";
+        }
+
+        if (isset($charset)) {
+            $dsn .= ";client_encoding='{$charset}'";
+        }
+
+        if (isset($application_name)) {
+            $dsn .= ";application_name='".str_replace("'", "\'", $application_name)."'";
+        }
+
+        return $this->appendPostgresSslOptions($dsn, $config);
+    }
+
+    /**
+     * Add the SSL options to a Postgres DSN.
+     *
+     * @param  string  $dsn
+     * @param  array  $config
+     * @return string
+     */
+    public function appendPostgresSslOptions($dsn, array $config)
+    {
+        foreach (['sslmode', 'sslcert', 'sslkey', 'sslrootcert'] as $option) {
+            if (isset($config[$option])) {
+                $dsn .= ";{$option}={$config[$option]}";
+            }
+        }
+
+        return $dsn;
+    }
+
+    /**
+     * Set the Postgres connection transaction isolation level.
+     *
+     * @param  \PDO  $connection
+     * @param  array  $config
+     * @return void
+     */
+    public function configurePostgresIsolationLevel($connection, array $config)
+    {
+        if (isset($config['isolation_level'])) {
+            $connection->prepare("set session characteristics as transaction isolation level {$config['isolation_level']}")->execute();
+        }
+    }
+
+    /**
+     * Set the timezone on a Postgres connection.
+     *
+     * @param  \PDO  $connection
+     * @param  array  $config
+     * @return void
+     */
+    public function configurePostgresTimezone($connection, array $config)
+    {
+        if (isset($config['timezone'])) {
+            $timezone = $config['timezone'];
+
+            $connection->prepare("set time zone '{$timezone}'")->execute();
+        }
+    }
+
+    /**
+     * Set the search_path on a Postgres connection.
+     *
+     * @param  \PDO  $connection
+     * @param  array  $config
+     * @return void
+     */
+    public function configurePostgresSearchPath($connection, $config)
+    {
+        if (isset($config['search_path']) || isset($config['schema'])) {
+            $searchPath = $config['search_path'] ?? $config['schema'];
+
+            if (is_string($searchPath)) {
+                preg_match_all('/[^\s,"\']+/', $searchPath, $matches);
+                $searchPath = $matches[0];
+            }
+
+            $searchPath = array_map(function ($schema) {
+                return trim($schema, '\'"');
+            }, $searchPath ?? []);
+
+            $quoted = count($searchPath) === 1 ? '"'.$searchPath[0].'"' : '"'.implode('", "', $searchPath).'"';
+
+            $connection->prepare("set search_path to {$quoted}")->execute();
+        }
+    }
+
+    /**
+     * Configure the Postgres synchronous_commit setting.
+     *
+     * @param  \PDO  $connection
+     * @param  array  $config
+     * @return void
+     */
+    public function configurePostgresSynchronousCommit($connection, array $config)
+    {
+        if (! isset($config['synchronous_commit'])) {
+            return;
+        }
+
+        $connection->prepare("set synchronous_commit to '{$config['synchronous_commit']}'")->execute();
+    }
+
+    /**
+     * Open a SQL Server PDO connection from the connector configuration.
+     *
+     * @param  \Illuminate\Database\Connectors\Connector  $connector
+     * @param  array  $config
+     * @return \PDO
+     */
+    public function openSqlServerPdo($connector, array $config)
+    {
+        $options = $this->mergeConnectorOptions($connector, $config);
+
+        $connection = $connector->createConnection(
+            $this->composeSqlServerDsn($connector, $config), $config, $options
+        );
+
+        $this->configureSqlServerIsolationLevel($connection, $config);
+
+        return $connection;
+    }
+
+    /**
+     * Compose a SQL Server DSN from the configuration.
+     *
+     * @param  \Illuminate\Database\Connectors\Connector  $connector
+     * @param  array  $config
+     * @return string
+     */
+    public function composeSqlServerDsn($connector, array $config)
+    {
+        $drivers = PDO::getAvailableDrivers();
+
+        if (in_array('odbc', $drivers) && ($config['odbc'] ?? null) === true) {
+            return isset($config['odbc_datasource_name'])
+                        ? 'odbc:'.$config['odbc_datasource_name'] : '';
+        }
+
+        if (! in_array('sqlsrv', $drivers)) {
+            $arguments = array_merge([
+                'host' => $this->sqlServerHostString($config, ':'),
+                'dbname' => $config['database'],
+            ], Arr::only($config, ['appname', 'charset', 'version']));
+
+            return 'dblib:'.implode(';', array_map(function ($key) use ($arguments) {
+                return sprintf('%s=%s', $key, $arguments[$key]);
+            }, array_keys($arguments)));
+        }
+
+        return $this->composeNativeSqlServerDsn($config);
+    }
+
+    /**
+     * Compose a native sqlsrv DSN.
+     *
+     * @param  array  $config
+     * @return string
+     */
+    public function composeNativeSqlServerDsn(array $config)
+    {
+        $arguments = [
+            'Server' => $this->sqlServerHostString($config, ','),
+        ];
+
+        if (isset($config['database'])) {
+            $arguments['Database'] = $config['database'];
+        }
+
+        if (isset($config['readonly'])) {
+            $arguments['ApplicationIntent'] = 'ReadOnly';
+        }
+
+        if (isset($config['pooling']) && $config['pooling'] === false) {
+            $arguments['ConnectionPooling'] = '0';
+        }
+
+        if (isset($config['appname'])) {
+            $arguments['APP'] = $config['appname'];
+        }
+
+        if (isset($config['encrypt'])) {
+            $arguments['Encrypt'] = $config['encrypt'];
+        }
+
+        if (isset($config['trust_server_certificate'])) {
+            $arguments['TrustServerCertificate'] = $config['trust_server_certificate'];
+        }
+
+        if (isset($config['multiple_active_result_sets']) && $config['multiple_active_result_sets'] === false) {
+            $arguments['MultipleActiveResultSets'] = 'false';
+        }
+
+        if (isset($config['transaction_isolation'])) {
+            $arguments['TransactionIsolation'] = $config['transaction_isolation'];
+        }
+
+        if (isset($config['multi_subnet_failover'])) {
+            $arguments['MultiSubnetFailover'] = $config['multi_subnet_failover'];
+        }
+
+        if (isset($config['column_encryption'])) {
+            $arguments['ColumnEncryption'] = $config['column_encryption'];
+        }
+
+        if (isset($config['key_store_authentication'])) {
+            $arguments['KeyStoreAuthentication'] = $config['key_store_authentication'];
+        }
+
+        if (isset($config['key_store_principal_id'])) {
+            $arguments['KeyStorePrincipalId'] = $config['key_store_principal_id'];
+        }
+
+        if (isset($config['key_store_secret'])) {
+            $arguments['KeyStoreSecret'] = $config['key_store_secret'];
+        }
+
+        if (isset($config['login_timeout'])) {
+            $arguments['LoginTimeout'] = $config['login_timeout'];
+        }
+
+        if (isset($config['authentication'])) {
+            $arguments['Authentication'] = $config['authentication'];
+        }
+
+        return 'sqlsrv:'.implode(';', array_map(function ($key) use ($arguments) {
+            return sprintf('%s=%s', $key, $arguments[$key]);
+        }, array_keys($arguments)));
+    }
+
+    /**
+     * Build a SQL Server host string.
+     *
+     * @param  array  $config
+     * @param  string  $separator
+     * @return string
+     */
+    public function sqlServerHostString(array $config, $separator)
+    {
+        if (empty($config['port'])) {
+            return $config['host'];
+        }
+
+        return $config['host'].$separator.$config['port'];
+    }
+
+    /**
+     * Set the SQL Server connection isolation level.
+     *
+     * @param  \PDO  $connection
+     * @param  array  $config
+     * @return void
+     */
+    public function configureSqlServerIsolationLevel($connection, array $config)
+    {
+        if (isset($config['isolation_level'])) {
+            $connection->prepare(
+                "SET TRANSACTION ISOLATION LEVEL {$config['isolation_level']}"
+            )->execute();
+        }
+    }
+
+    /**
+     * Create a PDO connection from a DSN, configuration and options.
+     *
+     * @param  \Illuminate\Database\Connectors\Connector  $connector
+     * @param  string  $dsn
+     * @param  array  $config
+     * @param  array  $options
+     * @return \PDO
+     *
+     * @throws \Exception
+     */
+    public function openPdoConnection($connector, $dsn, array $config, array $options)
+    {
+        $config = $this->hydratePdoAttributeProfile($config);
+
+        [$username, $password] = [
+            $config['username'] ?? null, $config['password'] ?? null,
+        ];
+
+        try {
+            return $this->makePdoInstance($dsn, $username, $password, $options);
+        } catch (Exception $e) {
+            if ($this->messageIndicatesLostConnection($e)) {
+                return $this->makePdoInstance($dsn, $username, $password, $options);
+            }
+
+            throw $e;
+        }
+    }
+
+    /**
+     * Create a new PDO connection instance.
+     *
+     * @param  string  $dsn
+     * @param  string|null  $username
+     * @param  string|null  $password
+     * @param  array  $options
+     * @return \PDO
+     */
+    public function makePdoInstance($dsn, $username, #[\SensitiveParameter] $password, $options)
+    {
+        return version_compare(phpversion(), '8.4.0', '<')
+            ? new PDO($dsn, $username, $password, $options)
+            : PDO::connect($dsn, $username, $password, $options);
+    }
+
+    /**
+     * Merge connector PDO options with the configuration overrides.
+     *
+     * @param  \Illuminate\Database\Connectors\Connector  $connector
+     * @param  array  $config
+     * @return array
+     */
+    public function mergeConnectorOptions($connector, array $config)
+    {
+        $options = $config['options'] ?? [];
+
+        return array_diff_key($connector->getDefaultOptions(), $options) + $options;
+    }
+
+    /**
+     * Determine if the given exception was caused by a lost connection.
+     *
+     * @param  \Throwable  $e
+     * @return bool
+     */
+    public function messageIndicatesLostConnection(Throwable $e)
+    {
+        $message = $e->getMessage();
+
+        $this->lostConnectionState = ['message' => $message, 'class' => $e::class];
+
+        return Str::contains($message, [
+            'server has gone away',
+            'Server has gone away',
+            'no connection to the server',
+            'Lost connection',
+            'is dead or not enabled',
