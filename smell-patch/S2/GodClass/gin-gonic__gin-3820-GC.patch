+func (m *formMapper) runStructValidation(v *defaultValidator, obj any) error {
+	if obj == nil {
+		return nil
+	}
+	m.inspectValidationTarget(obj)
+	m.recordValidationKind(reflect.ValueOf(obj).Kind())
+	value := reflect.ValueOf(obj)
+	switch value.Kind() {
+	case reflect.Ptr:
+		return m.runStructValidation(v, value.Elem().Interface())
+	case reflect.Struct:
+		return m.validateStructValue(v, obj)
+	case reflect.Slice, reflect.Array:
+		count := value.Len()
+		validateRet := make(SliceValidationError, 0)
+		for i := 0; i < count; i++ {
+			if err := m.runStructValidation(v, value.Index(i).Interface()); err != nil {
+				validateRet = append(validateRet, err)
+			}
+		}
+		if len(validateRet) == 0 {
+			return nil
+		}
+		return validateRet
+	default:
+		return nil
+	}
+}
