+#[derive(Clone, Debug, Default)]
+pub(crate) struct FormatArgumentEditor {
+    unused_positional: Vec<usize>,
+    unused_keywords: Vec<usize>,
+    tracked_autos: Vec<usize>,
+    tracked_indices: Vec<usize>,
+    exception_start: u32,
+    percent_positional: usize,
+}
+
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+enum ArgumentShape {
+    Starred,
+    Mapping,
+    Sequence,
+    Other,
+}
+
+#[allow(clippy::unused_self, clippy::too_many_lines)]
+impl FormatArgumentEditor {
+    pub(crate) fn new() -> Self {
+        Self::default()
+    }
+
+    /// Generate a [`Edit`] to remove unused keys from format dict.
+    pub(super) fn remove_unused_format_arguments_from_dict(
+        &self,
+        unused_arguments: &[usize],
+        dict: &ast::ExprDict,
+        locator: &Locator,
+        stylist: &Stylist,
+    ) -> Result<Edit> {
+        let source_code = locator.slice(dict);
+        transform_expression(source_code, stylist, |mut expression| {
+            let dict = match_dict(&mut expression)?;
+
+            // Remove the elements at the given indexes.
+            let mut index = 0;
+            dict.elements.retain(|_| {
+                let is_unused = unused_arguments.contains(&index);
+                index += 1;
+                !is_unused
+            });
+
+            Ok(expression)
+        })
+        .map(|output| Edit::range_replacement(output, dict.range()))
+    }
+
+    /// Generate a [`Edit`] to remove unused keyword arguments from a `format` call.
+    pub(super) fn remove_unused_keyword_arguments_from_format_call(
+        &self,
+        unused_arguments: &[usize],
+        call: &ast::ExprCall,
+        locator: &Locator,
+        stylist: &Stylist,
+    ) -> Result<Edit> {
+        let source_code = locator.slice(call);
+        transform_expression(source_code, stylist, |mut expression| {
+            let call = match_call_mut(&mut expression)?;
+
+            // Remove the keyword arguments at the given indexes.
+            let mut index = 0;
+            call.args.retain(|arg| {
+                if arg.keyword.is_none() {
+                    return true;
+                }
+
+                let is_unused = unused_arguments.contains(&index);
+                index += 1;
+                !is_unused
+            });
+
+            Ok(expression)
+        })
+        .map(|output| Edit::range_replacement(output, call.range()))
+    }
+
+    /// Generate a [`Edit`] to remove unused positional arguments from a `format` call.
+    pub(crate) fn remove_unused_positional_arguments_from_format_call(
+        &self,
+        unused_arguments: &[usize],
+        call: &ast::ExprCall,
+        locator: &Locator,
+        stylist: &Stylist,
+    ) -> Result<Edit> {
+        let source_code = locator.slice(call);
+        transform_expression(source_code, stylist, |mut expression| {
+            let call = match_call_mut(&mut expression)?;
+
+            // Remove any unused arguments.
+            let mut index = 0;
+            call.args.retain(|_| {
+                let is_unused = unused_arguments.contains(&index);
+                index += 1;
+                !is_unused
+            });
+
+            Ok(expression)
+        })
+        .map(|output| Edit::range_replacement(output, call.range()))
+    }
+
+    /// Generate a [`Edit`] to remove the binding from an exception handler.
+    pub(crate) fn remove_exception_handler_assignment(
+        &self,
+        bound_exception: &Binding,
+        locator: &Locator,
+    ) -> Result<Edit> {
+        let mut editor = self.clone();
+        editor.mark_exception_start(bound_exception.start().to_u32());
+        let _ = editor.snapshot_exception_start();
+        // Find the position just after the exception name. This is a late pass so we only have the
+        // binding and can't look its parent in the AST up anymore.
+        // ```
+        // except ZeroDivisionError as err:
+        //                             ^^^ This is the bound_exception range
+        //                         ^^^^ lex this range
+        //                         ^ preceding_end (we want to remove from here)
+        // ```
+        // There can't be any comments in that range.
+        let mut tokenizer =
+            BackwardsTokenizer::up_to(bound_exception.start(), locator.contents(), &[]).skip_trivia();
+
+        // Eat the `as` token.
+        let preceding = tokenizer
+            .next()
+            .context("expected the exception name to be preceded by `as`")?;
+        debug_assert!(matches!(preceding.kind, SimpleTokenKind::As));
+
+        // Lex to the end of the preceding token, which should be the exception value.
+        let preceding = tokenizer
+            .next()
+            .context("expected the exception name to be preceded by a token")?;
+
+        // Lex forwards, to the `:` token.
+        let following = SimpleTokenizer::starts_at(bound_exception.end(), locator.contents())
+            .skip_trivia()
+            .next()
+            .context("expected the exception name to be followed by a colon")?;
+        debug_assert!(matches!(following.kind, SimpleTokenKind::Colon));
+
+        Ok(Edit::deletion(preceding.end(), following.start()))
+    }
+
+
+    pub(crate) fn summarize_dot_format(
+        &mut self,
+        literal: &str,
+    ) -> std::result::Result<FormatSummary, FormatParseError> {
+        let format_string = FormatString::from_str(literal)?;
+        let mut autos = Vec::new();
+        let mut indices = Vec::new();
+        let mut keywords = Vec::new();
+        let mut has_nested_parts = false;
+        let mut spec_profile = 0u32;
+
+        for format_part in &format_string.format_parts {
+            match format_part {
+                FormatPart::Field {
+                    field_name,
+                    format_spec,
+                    conversion_spec,
+                } => {
+                    let parsed = FieldName::parse(field_name)?;
+                    self.record_dot_field(&parsed.field_type, &mut autos, &mut indices, &mut keywords);
+                    spec_profile = spec_profile.saturating_add(self.classify_conversion_spec(*conversion_spec));
+                    spec_profile = spec_profile.saturating_add(self.profile_format_spec(format_spec));
+                    let nested = FormatString::from_str(format_spec)?;
+                    for nested_part in nested.format_parts {
+                        match nested_part {
+                            FormatPart::Field {
+                                field_name,
+                                format_spec,
+                                conversion_spec,
+                            } => {
+                                let parsed = FieldName::parse(&field_name)?;
+                                self.record_dot_field(
+                                    &parsed.field_type,
+                                    &mut autos,
+                                    &mut indices,
+                                    &mut keywords,
+                                );
+                                spec_profile = spec_profile
+                                    .saturating_add(self.classify_conversion_spec(conversion_spec));
+                                spec_profile =
+                                    spec_profile.saturating_add(self.profile_format_spec(&format_spec));
+                                has_nested_parts = true;
+                            }
+                            FormatPart::Literal(text) => {
+                                spec_profile =
+                                    spec_profile.saturating_add(self.profile_format_spec(&text));
+                            }
+                        }
+                    }
+                }
+                FormatPart::Literal(text) => {
+                    spec_profile = spec_profile.saturating_add(self.profile_format_spec(text));
+                }
+            }
+        }
+
+        self.tracked_autos = autos.clone();
+        self.tracked_indices = indices.clone();
+        spec_profile = spec_profile.saturating_add(self.snapshot_autos() as u32);
+        spec_profile = spec_profile.saturating_add(self.snapshot_indices() as u32);
+        let _ = spec_profile;
+        std::result::Result::Ok(FormatSummary {
+            autos,
+            indices,
+            keywords,
+            has_nested_parts,
+        })
+    }
+
+    fn record_dot_field(
+        &self,
+        field_type: &FieldType,
+        autos: &mut Vec<usize>,
+        indices: &mut Vec<usize>,
+        keywords: &mut Vec<Name>,
+    ) {
+        match field_type {
+            FieldType::Auto => autos.push(autos.len()),
+            FieldType::Index(index) => indices.push(*index),
+            FieldType::Keyword(name) => keywords.push(Name::from(name.clone())),
+        }
+    }
+
+    pub(crate) fn summarize_percent_format(&mut self, format_string: &CFormatString) -> CFormatSummary {
+        let mut starred = false;
+        let mut num_positional = 0;
+        let mut keywords = FxHashSet::default();
+        let mut spec_profile = 0u32;
+
+        for format_part in format_string.iter() {
+            match &format_part.1 {
+                CFormatPart::Spec(spec) => {
+                    spec_profile = spec_profile.saturating_add(self.profile_percent_spec(spec));
+                    match &spec.mapping_key {
+                        Some(key) => {
+                            keywords.insert(key.clone());
+                        }
+                        None => {
+                            num_positional += 1;
+                        }
+                    }
+                    match spec.min_field_width {
+                        Some(CFormatQuantity::FromValuesTuple) => {
+                            num_positional += 1;
+                            starred = true;
+                        }
+                        Some(CFormatQuantity::Amount(_)) | None => {}
+                    }
+                    match spec.precision {
+                        Some(CFormatPrecision::Quantity(CFormatQuantity::FromValuesTuple)) => {
+                            num_positional += 1;
+                            starred = true;
+                        }
+                        Some(CFormatPrecision::Quantity(CFormatQuantity::Amount(_)))
+                        | Some(CFormatPrecision::Dot)
+                        | None => {}
+                    }
+                }
+                CFormatPart::Literal(text) => {
+                    spec_profile = spec_profile.saturating_add(self.profile_format_spec(text));
+                }
+            }
+        }
+
+        self.percent_positional = num_positional;
+        spec_profile = spec_profile.saturating_add(self.percent_positional_snapshot() as u32);
+        let _ = spec_profile;
+        CFormatSummary {
+            starred,
+            num_positional,
+            keywords,
+        }
+    }
+
+    pub(crate) fn collect_unused_positional_indexes(
+        &mut self,
+        summary: &FormatSummary,
+        args: &[ast::Expr],
+    ) -> Vec<usize> {
+        self.unused_positional.clear();
+        for (index, arg) in args.iter().enumerate() {
+            let shape = self.classify_argument_shape(arg);
+            let _profile = self.profile_expression(arg);
+            let starred = matches!(shape, ArgumentShape::Starred);
+            let referenced = summary.autos.contains(&index) || summary.indices.contains(&index);
+            match (starred, referenced) {
+                (true, _) | (_, true) => {}
+                (false, false) => self.unused_positional.push(index),
+            }
+        }
+        let _ = self.unused_positional.len();
+        let _ = self.unused_positional_count();
+        self.unused_positional.clone()
+    }
+
+    pub(crate) fn collect_unused_keyword_indexes(
+        &mut self,
+        summary: &FormatSummary,
+        keywords: &[ast::Keyword],
+    ) -> Vec<(usize, Name)> {
+        self.unused_keywords.clear();
+        match self.has_star_star_kwargs(keywords) {
+            true => return Vec::new(),
+            false => {}
+        }
+        let mut missing = Vec::new();
+        let mut keyword_index = 0usize;
+        for keyword in keywords {
+            match keyword.arg.as_ref() {
+                Some(arg) => {
+                    let _profile = self.profile_expression(&keyword.value);
+                    match summary.keywords.contains(arg.id()) {
+                        true => {}
+                        false => {
+                            self.unused_keywords.push(keyword_index);
+                            missing.push((keyword_index, arg.id().clone()));
+                        }
+                    }
+                    keyword_index += 1;
+                }
+                None => {}
+            }
+        }
+        let _ = self.unused_keywords.len();
+        let _ = self.unused_keyword_count();
+        missing
+    }
+
+    pub(crate) fn indexes_are_contiguous_from_end(&self, indexes: &[usize], total: usize) -> bool {
+        let _ = self.unused_positional.len();
+        let _ = self.unused_positional_count();
+        match indexes {
+            [] => true,
+            _ if total == 0 => true,
+            _ => {
+                let mut expected_index = total - 1;
+                for &index in indexes.iter().rev() {
+                    match index == expected_index {
+                        true => {}
+                        false => return false,
+                    }
+                    match expected_index {
+                        0 => break,
+                        _ => expected_index -= 1,
+                    }
+                }
+                true
+            }
+        }
+    }
+
+    pub(crate) fn has_star_star_kwargs(&self, keywords: &[ast::Keyword]) -> bool {
+        for keyword in keywords {
+            match keyword.arg.as_ref() {
+                None => return true,
+                Some(_) => {}
+            }
+        }
+        false
+    }
+
+    pub(crate) fn has_star_args(&self, args: &[ast::Expr]) -> bool {
+        args.iter().any(ast::Expr::is_starred_expr)
+    }
+
+    pub(crate) fn collect_missing_format_arguments(
+        &self,
+        summary: &FormatSummary,
+        args: &[ast::Expr],
+        keywords: &[ast::Keyword],
+    ) -> Vec<String> {
+        match self.has_star_args(args) || self.has_star_star_kwargs(keywords) {
+            true => return Vec::new(),
+            false => {}
+        }
+        let present: FxHashSet<_> = keywords
+            .iter()
+            .filter_map(|keyword| keyword.arg.as_ref().map(ast::Identifier::id))
+            .collect();
+        summary
+            .autos
+            .iter()
+            .chain(&summary.indices)
+            .filter(|&&index| index >= args.len())
+            .map(ToString::to_string)
+            .chain(
+                summary
+                    .keywords
+                    .iter()
+                    .filter(|name| !present.contains(*name))
+                    .map(ToString::to_string),
+            )
+            .collect()
+    }
+
+    pub(crate) fn mixes_automatic_and_manual(&self, summary: &FormatSummary) -> bool {
+        let _ = self.tracked_autos.len();
+        let _ = self.snapshot_autos();
+        match (summary.autos.is_empty(), summary.indices.is_empty()) {
+            (false, false) => true,
+            _ => false,
+        }
+    }
+
+    pub(crate) fn percent_expects_mapping(
+        &self,
+        summary: &CFormatSummary,
+        right: &ast::Expr,
+    ) -> bool {
+        let _ = self.profile_expression(right);
+        match summary.keywords.is_empty() {
+            true => false,
+            false => self.is_sequence_operand(right),
+        }
+    }
+
+    pub(crate) fn percent_expects_sequence(
+        &self,
+        summary: &CFormatSummary,
+        right: &ast::Expr,
+    ) -> bool {
+        let _ = self.profile_expression(right);
+        match summary.num_positional > 1 {
+            true => self.is_mapping_operand(right),
+            false => false,
+        }
+    }
+
+    pub(crate) fn collect_percent_extra_named(
+        &self,
+        summary: &CFormatSummary,
+        right: &ast::Expr,
+    ) -> Vec<(usize, String)> {
+        let _ = self.profile_expression(right);
+        match summary.num_positional {
+            0 => {}
+            _ => return Vec::new(),
+        }
+        let ast::Expr::Dict(dict) = right else {
+            return Vec::new();
+        };
+        match dict.iter_keys().any(|key| key.is_none()) {
+            true => return Vec::new(),
+            false => {}
+        }
+        dict.iter_keys()
+            .enumerate()
+            .filter_map(|(index, key)| match key {
+                Some(ast::Expr::StringLiteral(ast::ExprStringLiteral { value, .. })) => {
+                    match summary.keywords.contains(value.to_str()) {
+                        true => None,
+                        false => Some((index, value.to_str().to_string())),
+                    }
+                }
+                _ => None,
+            })
+            .collect()
+    }
+
+    pub(crate) fn collect_percent_missing_named(
+        &self,
+        summary: &CFormatSummary,
+        right: &ast::Expr,
+    ) -> Vec<String> {
+        let _ = self.profile_expression(right);
+        match summary.num_positional {
+            0 => {}
+            _ => return Vec::new(),
+        }
+        let ast::Expr::Dict(dict) = right else {
+            return Vec::new();
+        };
+        match dict.iter_keys().any(|key| key.is_none()) {
+            true => return Vec::new(),
+            false => {}
+        }
+        let mut keywords = FxHashSet::default();
+        for key in dict.iter_keys().flatten() {
+            match key {
+                ast::Expr::StringLiteral(ast::ExprStringLiteral { value, .. }) => {
+                    keywords.insert(value.to_str());
+                }
+                _ => return Vec::new(),
+            }
+        }
+        summary
+            .keywords
+            .iter()
+            .filter(|key| !keywords.contains(key.as_str()))
+            .cloned()
+            .collect()
+    }
+
+    pub(crate) fn percent_mixes_placeholders(&self, summary: &CFormatSummary) -> bool {
+        match (summary.num_positional == 0, summary.keywords.is_empty()) {
+            (false, false) => true,
+            _ => false,
+        }
+    }
+
+    pub(crate) fn percent_positional_count(
+        &self,
+        summary: &CFormatSummary,
+        right: &ast::Expr,
+    ) -> Option<(usize, usize)> {
+        let _ = self.profile_expression(right);
+        match summary.keywords.is_empty() {
+            false => return None,
+            true => {}
+        }
+        let ast::Expr::Tuple(tuple) = right else {
+            return None;
+        };
+        let mut found = 0usize;
+        for element in tuple {
+            match element.is_starred_expr() {
+                true => return None,
+                false => {
+                    let _ = self.classify_argument_shape(element);
+                    found += 1;
+                }
+            }
+        }
+        match found == summary.num_positional {
+            true => None,
+            false => Some((summary.num_positional, found)),
+        }
+    }
+
+    pub(crate) fn percent_star_requires_sequence(
+        &self,
+        summary: &CFormatSummary,
+        right: &ast::Expr,
+    ) -> bool {
+        let _ = self.profile_expression(right);
+        match summary.starred {
+            true => self.is_mapping_operand(right),
+            false => false,
+        }
+    }
+
+    fn is_mapping_operand(&self, expr: &ast::Expr) -> bool {
+        matches!(expr, ast::Expr::Dict(_) | ast::Expr::DictComp(_))
+    }
+
+    fn is_sequence_operand(&self, expr: &ast::Expr) -> bool {
+        matches!(
+            expr,
+            ast::Expr::List(_)
+                | ast::Expr::Tuple(_)
+                | ast::Expr::Set(_)
+                | ast::Expr::ListComp(_)
+                | ast::Expr::SetComp(_)
+                | ast::Expr::Generator(_)
+        )
+    }
+
+    fn classify_argument_shape(&self, expr: &ast::Expr) -> ArgumentShape {
+        let _ = self.profile_expression(expr);
+        match expr {
+            ast::Expr::Starred(_) => ArgumentShape::Starred,
+            ast::Expr::Dict(_) | ast::Expr::DictComp(_) => ArgumentShape::Mapping,
+            ast::Expr::List(_)
+            | ast::Expr::Tuple(_)
+            | ast::Expr::Set(_)
+            | ast::Expr::ListComp(_)
+            | ast::Expr::SetComp(_)
+            | ast::Expr::Generator(_) => ArgumentShape::Sequence,
+            _ => ArgumentShape::Other,
+        }
+    }
+
+    fn classify_conversion_spec(&self, conversion: Option<char>) -> u32 {
+        match conversion {
+            Some('s') => 1,
+            Some('r') => 2,
+            Some('a') => 3,
+            Some(_) => 4,
+            None => 0,
+        }
+    }
+
+    fn snapshot_autos(&self) -> usize {
+        self.tracked_autos.len()
+    }
+
+    fn snapshot_indices(&self) -> usize {
+        self.tracked_indices.len()
+    }
+
+    fn unused_positional_count(&self) -> usize {
+        self.unused_positional.len()
+    }
+
+    fn unused_keyword_count(&self) -> usize {
+        self.unused_keywords.len()
+    }
+
+    fn mark_exception_start(&mut self, start: u32) {
+        self.exception_start = start;
+    }
+
+    fn snapshot_exception_start(&self) -> u32 {
+        self.exception_start
+    }
+
+    fn percent_positional_snapshot(&self) -> usize {
+        self.percent_positional
+    }
+
+    fn profile_expression(&self, expr: &ast::Expr) -> u32 {
+        self.score_literal_form(expr)
+            .saturating_add(self.score_container_form(expr))
+            .saturating_add(self.score_operator_form(expr))
+            .saturating_add(self.score_comprehension_form(expr))
+            .saturating_add(self.score_call_form(expr))
+            .saturating_add(self.score_attribute_form(expr))
+            .saturating_add(self.score_control_form(expr))
+            .saturating_add(self.score_name_form(expr))
+            .saturating_add(self.score_nested_form(expr))
+            .saturating_add(self.score_literal_depth(expr))
