+    fn classify_percent_mapping_key(&self, spec: &CFormatSpec) -> u32 {
+        match &spec.mapping_key {
+            Some(key) => key.len() as u32,
+            None => 0,
+        }
+    }
+
+    fn classify_percent_width(&self, spec: &CFormatSpec) -> u32 {
+        match &spec.min_field_width {
+            Some(CFormatQuantity::FromValuesTuple) => 8,
+            Some(CFormatQuantity::Amount(amount)) => *amount as u32,
+            None => 0,
+        }
+    }
+
+    fn classify_percent_precision(&self, spec: &CFormatSpec) -> u32 {
+        match &spec.precision {
+            Some(CFormatPrecision::Dot) => 1,
+            Some(CFormatPrecision::Quantity(CFormatQuantity::FromValuesTuple)) => 8,
+            Some(CFormatPrecision::Quantity(CFormatQuantity::Amount(amount))) => *amount as u32,
+            None => 0,
