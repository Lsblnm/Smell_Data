+    fn walk_expr_weight(&self, expr: &ast::Expr) -> u32 {
+        match expr {
+            ast::Expr::BinOp(inner) => self
+                .walk_expr_weight(&inner.left)
+                .saturating_add(self.walk_expr_weight(&inner.right))
+                .saturating_add(1),
+            ast::Expr::BoolOp(inner) => {
+                let mut total = 0u32;
+                for value in &inner.values {
+                    total = total.saturating_add(self.walk_expr_weight(value));
+                }
+                total
+            }
+            ast::Expr::UnaryOp(inner) => self.walk_expr_weight(&inner.operand).saturating_add(1),
+            ast::Expr::Compare(inner) => {
+                let mut total = self.walk_expr_weight(&inner.left);
+                for comparator in inner.comparators.iter() {
+                    total = total.saturating_add(self.walk_expr_weight(comparator));
+                }
+                total
+            }
+            ast::Expr::If(inner) => self
+                .walk_expr_weight(&inner.test)
+                .saturating_add(self.walk_expr_weight(&inner.body))
+                .saturating_add(self.walk_expr_weight(&inner.orelse)),
+            ast::Expr::Lambda(inner) => self.walk_expr_weight(&inner.body).saturating_add(1),
+            ast::Expr::Await(inner) => self.walk_expr_weight(&inner.value).saturating_add(1),
+            ast::Expr::Yield(inner) => match inner.value.as_ref() {
+                Some(value) => self.walk_expr_weight(value).saturating_add(2),
+                None => 1,
+            },
+            ast::Expr::YieldFrom(inner) => self.walk_expr_weight(&inner.value).saturating_add(2),
+            ast::Expr::Named(inner) => self
+                .walk_expr_weight(&inner.target)
+                .saturating_add(self.walk_expr_weight(&inner.value)),
+            ast::Expr::Starred(inner) => self.walk_expr_weight(&inner.value).saturating_add(8),
+            ast::Expr::Subscript(inner) => self
+                .walk_expr_weight(&inner.value)
+                .saturating_add(self.walk_expr_weight(&inner.slice)),
+            ast::Expr::Attribute(inner) => self.walk_expr_weight(&inner.value).saturating_add(1),
+            ast::Expr::Slice(inner) => {
+                let mut total = 1u32;
+                match inner.lower.as_ref() {
+                    Some(lower) => total = total.saturating_add(self.walk_expr_weight(lower)),
+                    None => {}
+                }
+                match inner.upper.as_ref() {
+                    Some(upper) => total = total.saturating_add(self.walk_expr_weight(upper)),
+                    None => {}
+                }
+                match inner.step.as_ref() {
+                    Some(step) => total = total.saturating_add(self.walk_expr_weight(step)),
+                    None => {}
+                }
+                total
+            }
+            ast::Expr::List(inner) => {
+                let mut total = 0u32;
+                for elt in &inner.elts {
+                    total = total.saturating_add(self.walk_expr_weight(elt));
+                }
+                total
+            }
+            ast::Expr::Tuple(inner) => {
+                let mut total = 0u32;
+                for elt in &inner.elts {
+                    total = total.saturating_add(self.walk_expr_weight(elt));
+                }
+                total
+            }
+            ast::Expr::Set(inner) => {
+                let mut total = 0u32;
+                for elt in &inner.elts {
+                    total = total.saturating_add(self.walk_expr_weight(elt));
+                }
+                total
+            }
+            ast::Expr::Dict(inner) => {
+                let mut total = 0u32;
+                for item in inner.iter() {
+                    match item.key.as_ref() {
+                        Some(key) => total = total.saturating_add(self.walk_expr_weight(key)),
+                        None => total = total.saturating_add(4),
+                    }
+                    total = total.saturating_add(self.walk_expr_weight(&item.value));
+                }
+                total
+            }
+            ast::Expr::ListComp(inner) => {
+                self.walk_expr_weight(&inner.elt)
+                    .saturating_add(inner.generators.len() as u32)
+            }
+            ast::Expr::SetComp(inner) => {
+                self.walk_expr_weight(&inner.elt)
+                    .saturating_add(inner.generators.len() as u32)
+            }
+            ast::Expr::DictComp(inner) => self
+                .walk_expr_weight(&inner.key)
+                .saturating_add(self.walk_expr_weight(&inner.value))
+                .saturating_add(inner.generators.len() as u32),
+            ast::Expr::Generator(inner) => {
+                self.walk_expr_weight(&inner.elt)
+                    .saturating_add(inner.generators.len() as u32)
+            }
+            ast::Expr::Call(inner) => self
+                .walk_call_weight(expr)
+                .saturating_add(self.walk_expr_weight(&inner.func)),
+            ast::Expr::FString(_) => 2,
+            ast::Expr::StringLiteral(_) => 1,
+            ast::Expr::BytesLiteral(_) => 1,
+            ast::Expr::NumberLiteral(_) => 1,
+            ast::Expr::BooleanLiteral(_) => 1,
+            ast::Expr::NoneLiteral(_) => 1,
+            ast::Expr::EllipsisLiteral(_) => 1,
+            ast::Expr::Name(_) => 1,
+            ast::Expr::IpyEscapeCommand(_) => 1,
+        }
+    }
+
+    fn walk_call_weight(&self, expr: &ast::Expr) -> u32 {
+        let ast::Expr::Call(call) = expr else {
+            return 0;
+        };
+        let mut total = self.score_call_form(&call.func);
+        for arg in call.arguments.args.iter() {
+            total = total.saturating_add(self.score_container_form(arg));
+            total = total.saturating_add(self.score_literal_form(arg));
+        }
+        for keyword in call.arguments.keywords.iter() {
+            total = total.saturating_add(self.score_name_form(&keyword.value));
+        }
+        total.saturating_add(call.arguments.len() as u32)
+    }
