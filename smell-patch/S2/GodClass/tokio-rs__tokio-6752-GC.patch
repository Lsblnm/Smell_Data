+    pub(crate) fn next_occupied_slot_from(occupied: u64, now: u64, level: usize) -> Option<usize> {
+        if occupied == 0 {
+            return None;
+        }
+        let range = Self::slot_range_for_level(level);
+        let now_slot = (now / range) as usize;
+        let rotated = occupied.rotate_right(now_slot as u32);
+        let zeros = rotated.trailing_zeros() as usize;
+        Some((zeros + now_slot) % 64)
+    }
