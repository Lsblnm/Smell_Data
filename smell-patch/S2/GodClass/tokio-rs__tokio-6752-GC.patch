+    pub(crate) fn place_wheel_entry<S>(
+        wheel: &mut crate::time::wheel::Wheel<S>,
+        when: u64,
+        item: S::Owned,
+        store: &mut S::Store,
+    ) -> Result<(), (S::Owned, crate::time::wheel::InsertError)>
+    where
+        S: crate::time::wheel::Stack,
+    {
+        let elapsed = wheel.elapsed();
+        if when <= elapsed {
+            return Err((item, crate::time::wheel::InsertError::Elapsed));
+        } else if when - elapsed > crate::time::wheel::MAX_DURATION {
+            return Err((item, crate::time::wheel::InsertError::Invalid));
+        }
+        let level = Self::wheel_level_for(elapsed, when);
+        wheel.levels[level].add_entry(when, item, store);
+        debug_assert!({
+            wheel.levels[level]
+                .next_expiration(elapsed)
+                .map(|e| e.deadline >= elapsed)
+                .unwrap_or(true)
+        });
+        Ok(())
+    }
