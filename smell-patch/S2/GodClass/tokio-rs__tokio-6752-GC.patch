+    pub(crate) fn expiration_deadline_from(now: u64, level: usize, slot: usize) -> u64 {
+        let level_range = Self::level_range_for(level);
+        let slot_range = Self::slot_range_for_level(level);
+        let level_start = now - (now % level_range);
+        let mut deadline = level_start + slot as u64 * slot_range;
+        if deadline < now {
+            deadline += level_range;
+        }
+        deadline
+    }
