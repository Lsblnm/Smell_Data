+public byte[] readGenericIndexHeader(IndexInput in) throws IOException {
+    in.seek(0);
+    final int actualHeader = readGenericBEInt(in);
+    if (actualHeader != CODEC_HEADER_MAGIC) {
+      throw new CorruptIndexException(
+          "codec header mismatch: actual header="
+              + actualHeader
+              + " vs expected header="
+              + CODEC_HEADER_MAGIC,
+          in);
+    }
+    String codec = in.readString();
+    readGenericBEInt(in);
+    in.seek(in.getFilePointer() + StringHelper.ID_LENGTH);
+    int suffixLength = in.readByte() & 0xFF;
+    byte[] bytes =
+        new byte[measureCodecHeaderLength(codec) + StringHelper.ID_LENGTH + 1 + suffixLength];
+    in.seek(0);
+    in.readBytes(bytes, 0, bytes.length);
+    return bytes;
+  }
