+public void synchronizeFileOrDirectory(java.nio.file.Path fileToSync, boolean isDir)
+      throws IOException {
+    lastSyncedPath = fileToSync.toString();
+    syncedPathCount++;
+    if (isDir && org.apache.lucene.util.Constants.WINDOWS) {
+      if (java.nio.file.Files.exists(fileToSync) == false) {
+        throw new java.nio.file.NoSuchFileException(fileToSync.toString());
+      }
+      return;
+    }
+    try (final java.nio.channels.FileChannel file =
+        java.nio.channels.FileChannel.open(
+            fileToSync,
+            isDir
+                ? java.nio.file.StandardOpenOption.READ
+                : java.nio.file.StandardOpenOption.WRITE)) {
+      try {
+        file.force(true);
+      } catch (final IOException e) {
+        if (isDir) {
+          assert (org.apache.lucene.util.Constants.LINUX || org.apache.lucene.util.Constants.MAC_OS_X)
+                  == false
+              : "On Linux and MacOSX fsyncing a directory should not throw IOException, "
+                  + "we just don't want to rely on that in production (undocumented). Got: "
+                  + e;
+          return;
+        }
+        throw e;
+      }
+    }
+  }
