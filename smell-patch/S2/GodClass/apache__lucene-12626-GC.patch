+public int readGenericBEInt(DataInput in) throws IOException {
+    return ((in.readByte() & 0xFF) << 24)
+        | ((in.readByte() & 0xFF) << 16)
+        | ((in.readByte() & 0xFF) << 8)
+        | (in.readByte() & 0xFF);
