+    if (in.length() < measureCodecFooterLength()) {
+      throw new CorruptIndexException(
+          "misplaced codec footer (file truncated?): length="
+              + in.length()
+              + " but footerLength=="
+              + measureCodecFooterLength(),
+          input);
+    }
+    in.seek(in.length() - measureCodecFooterLength());
+    return checkGenericFooter(in);
