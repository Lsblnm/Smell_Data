+public byte[] readGenericFooter(IndexInput in) throws IOException {
+    if (in.length() < measureCodecFooterLength()) {
+      throw new CorruptIndexException(
+          "misplaced codec footer (file truncated?): length="
+              + in.length()
+              + " but footerLength=="
+              + measureCodecFooterLength(),
+          in);
+    }
+    in.seek(in.length() - measureCodecFooterLength());
+    validateGenericFooter(in);
+    in.seek(in.length() - measureCodecFooterLength());
+    byte[] bytes = new byte[measureCodecFooterLength()];
+    in.readBytes(bytes, 0, bytes.length);
