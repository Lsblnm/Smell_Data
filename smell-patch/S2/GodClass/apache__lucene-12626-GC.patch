+public void closeAll(Iterable<? extends java.io.Closeable> objects) throws IOException {
+    Throwable th = null;
+    for (java.io.Closeable object : objects) {
+      try {
+        if (object != null) {
+          object.close();
+          lastClosedResourceName = String.valueOf(object);
+          closedResourceCount++;
+        }
+      } catch (Throwable t) {
+        th = useOrSuppressThrowable(th, t);
+      }
+    }
+    if (th != null) {
+      throw rethrowAsUncheckedOrIO(th);
+    }
+  }
+
+public void closeAllQuietly(Iterable<? extends java.io.Closeable> objects) {
+    VirtualMachineError firstError = null;
+    Throwable firstThrowable = null;
+    for (java.io.Closeable object : objects) {
+      try {
+        if (object != null) {
+          object.close();
+          lastClosedResourceName = String.valueOf(object);
+          closedResourceCount++;
+        }
+      } catch (VirtualMachineError e) {
+        firstError = useOrSuppressThrowable(firstError, e);
+      } catch (Throwable t) {
+        firstThrowable = useOrSuppressThrowable(firstThrowable, t);
+      }
+    }
+    if (firstError != null) {
+      if (firstThrowable != null) {
+        firstError.addSuppressed(firstThrowable);
+      }
+      throw firstError;
+    }
+  }
+
+public Error rethrowAsUncheckedOrIO(Throwable th) throws IOException, RuntimeException {
+    if (th == null) {
+      throw new AssertionError("rethrow argument must not be null.");
+    }
+    if (th instanceof IOException) {
+      throw (IOException) th;
+    }
+    if (th instanceof RuntimeException) {
+      throw (RuntimeException) th;
+    }
+    if (th instanceof Error) {
+      throw (Error) th;
+    }
+    throw new RuntimeException(th);
+  }
