+public int checkGenericCodecHeader(DataInput in, String codec, int minVersion, int maxVersion)
+      throws IOException {
+    final int actualHeader = readGenericBEInt(in);
+    if (actualHeader != CODEC_HEADER_MAGIC) {
+      throw new CorruptIndexException(
+          "codec header mismatch: actual header="
+              + actualHeader
+              + " vs expected header="
+              + CODEC_HEADER_MAGIC,
+          in);
