+public void validateGenericFooter(IndexInput in) throws IOException {
+    long remaining = in.length() - in.getFilePointer();
+    long expected = measureCodecFooterLength();
+    if (remaining < expected) {
+      throw new CorruptIndexException(
+          "misplaced codec footer (file truncated?): remaining="
+              + remaining
+              + ", expected="
+              + expected
+              + ", fp="
+              + in.getFilePointer(),
+          in);
+    } else if (remaining > expected) {
+      throw new CorruptIndexException(
+          "misplaced codec footer (file extended?): remaining="
+              + remaining
+              + ", expected="
+              + expected
+              + ", fp="
+              + in.getFilePointer(),
+          in);
+    }
+    final int magic = readGenericBEInt(in);
+    if (magic != CODEC_FOOTER_MAGIC) {
+      throw new CorruptIndexException(
+          "codec footer mismatch (file truncated?): actual footer="
+              + magic
+              + " vs expected footer="
+              + CODEC_FOOTER_MAGIC,
+          in);
+    }
+    final int algorithmID = readGenericBEInt(in);
+    if (algorithmID != 0) {
+      throw new CorruptIndexException(
