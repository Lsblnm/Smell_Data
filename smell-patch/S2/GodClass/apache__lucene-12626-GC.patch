+public void copyVerifiedIndexHeader(IndexInput in, DataOutput out, byte[] expectedID)
+      throws IOException {
+    if (in.length() < measureCodecFooterLength() + measureCodecHeaderLength("")) {
+      throw new CorruptIndexException(
+          "compound sub-files must have a valid codec header and footer: file is too small ("
+              + in.length()
+              + " bytes)",
+          in);
+    }
+    int actualHeader = readGenericBEInt(in);
+    if (actualHeader != CODEC_HEADER_MAGIC) {
+      throw new CorruptIndexException(
+          "compound sub-files must have a valid codec header and footer: codec header mismatch: actual header="
+              + actualHeader
+              + " vs expected header="
+              + CODEC_HEADER_MAGIC,
+          in);
+    }
+    String codec = in.readString();
+    int version = readGenericBEInt(in);
+    checkGenericIndexHeaderID(in, expectedID);
+    int suffixLength = in.readByte() & 0xFF;
+    byte[] suffixBytes = new byte[suffixLength];
+    in.readBytes(suffixBytes, 0, suffixLength);
+    writeGenericBEInt(out, CODEC_HEADER_MAGIC);
+    out.writeString(codec);
+    writeGenericBEInt(out, version);
+    out.writeBytes(expectedID, 0, expectedID.length);
+    out.writeByte((byte) suffixLength);
+    out.writeBytes(suffixBytes, 0, suffixLength);
+  }
