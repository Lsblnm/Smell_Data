+    fn write_environment_listing(&mut self, line_ending: LineEnding) {
+        let stdout_raw = io::stdout();
+        let mut stdout = stdout_raw.lock();
+        for (n, v) in env::vars() {
+            let _ = self.ingest_text_pair(&n, &v);
+            write!(stdout, "{}={}{}", n, v, line_ending).unwrap();
+        }
+    }
