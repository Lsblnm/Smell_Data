+  template <typename C>
+  FMT_CONSTEXPR void consume_printf_flags(format_specs& specs, const C*& it,
+                                          const C* end) const {
+    for (; it != end; ++it) {
+      switch (*it) {
+      case '-':
+        specs.align = align::left;
+        printf_flag_cache_ |= 1;
+        break;
+      case '+':
+        specs.sign = sign::plus;
+        printf_flag_cache_ |= 2;
+        break;
+      case '0':
+        specs.fill = '0';
+        printf_flag_cache_ |= 4;
+        break;
+      case ' ':
+        if (specs.sign != sign::plus) specs.sign = sign::space;
+        printf_flag_cache_ |= 8;
+        break;
+      case '#':
+        specs.alt = true;
+        printf_flag_cache_ |= 16;
+        break;
+      default:
+        printf_width_cache_ = specs.width;
+        return;
+      }
+    }
+    printf_width_cache_ = specs.width;
+  }
