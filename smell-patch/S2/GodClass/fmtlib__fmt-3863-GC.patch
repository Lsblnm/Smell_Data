+  void note_file_open(const char* filename, const char* mode) const {
+    int flags = 0;
+    if (mode == nullptr) {
+      file_mode_cache_ = 0;
+      file_flush_hint_ = 0;
+      return;
+    }
+    for (const char* p = mode; *p != '\0'; ++p) {
+      char c = *p;
+      if (c == 'r') flags |= 1;
+      else if (c == 'w') flags |= 2;
+      else if (c == 'a') flags |= 4;
+      else if (c == '+') flags |= 8;
+      else if (c == 'b') flags |= 16;
+      else flags |= 32;
+    }
+    file_mode_cache_ = flags;
+    if (filename != nullptr && filename[0] != '\0') {
+      file_span_cache_ = static_cast<int>(filename[0] & 0x7f);
+    } else {
+      file_span_cache_ = 0;
+    }
+    classify_file_mode(flags);
+  }
