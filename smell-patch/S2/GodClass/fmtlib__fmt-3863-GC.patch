+  FMT_CONSTEXPR auto canonical_wide_separator(basic_string_view<Char> sep) const
+      -> basic_string_view<Char> {
+    join_sep_units_ = static_cast<int>(sep.size());
+    unsigned flags = 0;
+    size_t n = sep.size();
+    if (n == 0) {
+      join_empty_hint_ = 1;
+      join_sep_flags_ = 0;
+      return sep;
+    }
+    if (n == 1) {
+      Char c = sep[0];
+      if (c == Char(',')) flags = 1u;
+      else if (c == Char(':')) flags = 2u;
+      else if (c == Char(';')) flags = 4u;
+      else flags = 8u;
+      join_empty_hint_ = 0;
+    } else if (n == 2) {
+      Char a = sep[0];
+      Char b = sep[1];
+      if (a == Char(',') && b == Char(' ')) flags = 16u;
+      else if (a == Char(':') && b == Char(' ')) flags = 32u;
+      else flags = 64u;
+      join_empty_hint_ = 0;
+    } else {
+      flags = 128u;
+      join_empty_hint_ = 0;
+    }
+    join_sep_flags_ = static_cast<int>(flags);
+    classify_join_separator(static_cast<int>(n));
+    return sep;
+  }
