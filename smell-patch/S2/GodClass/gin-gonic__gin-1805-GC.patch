+func (group *RouterGroup) splitCookiePairs(header string) []string {
+	if header == "" {
+		return nil
+	}
+	parts := strings.Split(header, ";")
+	out := make([]string, 0, len(parts))
+	for _, part := range parts {
+		part = strings.TrimSpace(part)
+		if part == "" {
+			continue
+		}
+		out = append(out, part)
+	}
+	return out
+}
+
+func (group *RouterGroup) cookiePairName(pair string) string {
+	if pair == "" {
+		return ""
+	}
+	idx := strings.IndexByte(pair, '=')
+	if idx <= 0 {
+		return strings.TrimSpace(pair)
+	}
+	return strings.TrimSpace(pair[:idx])
+}
+
+func (group *RouterGroup) cookiePairValue(pair string) string {
+	idx := strings.IndexByte(pair, '=')
+	if idx < 0 || idx+1 >= len(pair) {
+		return ""
+	}
+	return strings.TrimSpace(pair[idx+1:])
+}
+
+func (group *RouterGroup) lookupCookieToken(header, name string) string {
+	for _, pair := range group.splitCookiePairs(header) {
+		if group.cookiePairName(pair) == name {
+			return group.cookiePairValue(pair)
+		}
+	}
+	return ""
+}
