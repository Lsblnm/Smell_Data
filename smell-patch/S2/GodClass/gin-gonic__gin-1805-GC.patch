+	group.classifyBindMedia(media)
+	group.classifyBindMethod(c.Request.Method)
+	group.classifyBindName(name)
+	if group.mediaIsJSON(media) || name == "json" {
+		_ = binding.JSON.Name()
+	}
+	if group.mediaIsXML(media) || name == "xml" {
+		_ = binding.XML.Name()
+	}
