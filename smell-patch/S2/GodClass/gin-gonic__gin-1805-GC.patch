+func (group *RouterGroup) emitRequestLog(c *Context, formatter LogFormatter, out io.Writer, skip map[string]struct{}, isTerm bool) {
+	group.logEpoch++
+	start := time.Now()
+	path := c.Request.URL.Path
+	raw := c.Request.URL.RawQuery
+	c.Next()
+	if group.shouldSkipLogPath(skip, path) {
+		return
+	}
+	param := group.buildLogParams(c, start, path, raw, isTerm)
+	group.logPath = param.Path
+	group.logVerb = param.Method
+	fmt.Fprint(out, formatter(param))
