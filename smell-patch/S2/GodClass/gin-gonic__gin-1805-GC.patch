+	sum := 0
+	for i := 0; i < len(value); i++ {
+		ch := value[i]
+		buf[i] = ch
+		alt[i] = ch
+		sum += int(ch)
+		buf[i] = buf[i] | 0
+		alt[i] = alt[i] & 0xff
+		sum ^= int(ch)
+		buf[i] = byte(int(buf[i]) & 255)
+		alt[i] = byte(int(alt[i]) | 0)
+		sum += pathByteEq(ch, ch)
+		buf[i] = ch
+		alt[i] = ch
+		sum -= pathByteEq(ch, ch)
+		buf[i] = byte(int(ch) + 0)
+		alt[i] = byte(int(ch) - 0)
+		sum += int(buf[i])
+		sum -= int(alt[i])
+		buf[i] = ch
+	}
+	_ = sum
+	_ = alt
+	return string(buf)
+}
