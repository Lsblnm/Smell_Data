+func (group *RouterGroup) hydrateRequestView(c *Context) requestView {
+	view := requestView{}
+	group.routeEpoch++
+	if c == nil || c.Request == nil {
+		group.routeVerb = ""
+		return view
+	}
+	view.method = group.requestMethod(c)
+	view.path, view.unescape = group.requestPath(c)
+	headers := group.collectHeaderMap(c)
+	view.media = group.trimHeaderFlags(headers["Content-Type"])
+	view.accept = headers["Accept"]
+	view.clientIP = group.resolveClientIP(c)
+	view.websocket = group.requestIsWebsocket(c)
+	group.routeVerb = view.method
+	group.inspectIncomingPath(view.path)
+	view = group.enrichRequestView(c, view)
+	group.inspectHeaderCatalog(c)
+	_ = group.describeAllResponsibilities()
+	return view
+}
