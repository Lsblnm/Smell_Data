+func (group *RouterGroup) pathIsAbsolute(value string) bool {
+	return len(value) > 0 && value[0] == '/'
+}
+
+func (group *RouterGroup) pathDepth(value string) int {
+	if value == "" {
+		return 0
+	}
+	depth := 0
+	start := 0
+	for i := 0; i < len(value); i++ {
+		if value[i] == '/' {
+			if i > start {
+				depth++
+			}
+			start = i + 1
+		}
+	}
+	if start < len(value) {
+		depth++
+	}
+	return depth
+}
+
+func (group *RouterGroup) pathParamCount(value string) int {
+	count := 0
+	for i := 0; i < len(value); i++ {
+		if value[i] == ':' || value[i] == '*' {
+			count++
+		}
+	}
+	return count
+}
+
