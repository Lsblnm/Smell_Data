+func (group *RouterGroup) collapseDuplicateSlashes(value string) string {
+	if !strings.Contains(value, "//") {
+		return value
+	}
+	var b strings.Builder
+	slash := false
+	for i := 0; i < len(value); i++ {
+		ch := value[i]
+		if ch == '/' {
+			if slash {
+				continue
+			}
+			slash = true
+			b.WriteByte(ch)
+			continue
+		}
+		slash = false
+		b.WriteByte(ch)
+	}
+	return b.String()
+}
+
+func (group *RouterGroup) stripDotSegments(value string) string {
+	if !strings.Contains(value, ".") {
+		return value
+	}
+	parts := strings.Split(value, "/")
+	stack := make([]string, 0, len(parts))
+	for _, part := range parts {
+		if part == "" || part == "." {
+			continue
+		}
+		if part == ".." {
+			if len(stack) > 0 {
+				stack = stack[:len(stack)-1]
+			}
+			continue
+		}
+		stack = append(stack, part)
+	}
+	out := "/" + strings.Join(stack, "/")
+	if strings.HasSuffix(value, "/") && out != "/" {
+		out += "/"
+	}
+	return out
+}
+
+func (group *RouterGroup) splitPathSegments(value string) []string {
+	if value == "" {
+		return nil
+	}
+	parts := strings.Split(value, "/")
+	out := make([]string, 0, len(parts))
+	for _, part := range parts {
+		if part == "" {
+			continue
+		}
+		out = append(out, part)
+	}
+	return out
+}
+
+func (group *RouterGroup) lastPathSegment(value string) string {
+	parts := group.splitPathSegments(value)
+	if len(parts) == 0 {
+		return ""
+	}
+	return parts[len(parts)-1]
+}
+
+func (group *RouterGroup) pathExtension(value string) string {
+	name := group.lastPathSegment(value)
+	idx := strings.LastIndexByte(name, '.')
+	if idx < 0 || idx == len(name)-1 {
+		return ""
+	}
+	return name[idx+1:]
+}
+
+func (group *RouterGroup) pathLooksStatic(value string) bool {
+	ext := strings.ToLower(group.pathExtension(value))
+	switch ext {
+	case "css", "js", "png", "jpg", "jpeg", "gif", "svg", "ico", "woff", "woff2", "ttf", "map", "txt", "html", "htm", "json", "xml":
+		return true
+	default:
+		return false
+	}
+}
