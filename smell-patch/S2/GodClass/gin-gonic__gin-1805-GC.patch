+func (group *RouterGroup) negotiateResponse(c *Context, code int, config Negotiate) {
+	switch group.matchAcceptedFormat(c, config.Offered...) {
+	case binding.MIMEJSON:
+		data := chooseData(config.JSONData, config.Data)
+		c.JSON(code, data)
+	case binding.MIMEHTML:
+		data := chooseData(config.HTMLData, config.Data)
+		c.HTML(code, config.HTMLName, data)
+	case binding.MIMEXML:
+		data := chooseData(config.XMLData, config.Data)
+		c.XML(code, data)
+	default:
+		c.AbortWithError(http.StatusNotAcceptable, errors.New("the accepted formats are not offered by the server"))
+	}
+}
+
+func (group *RouterGroup) matchAcceptedFormat(c *Context, offered ...string) string {
+	assert1(len(offered) > 0, "you must provide at least one offer")
+	if c.Accepted == nil {
+		c.Accepted = group.parseAcceptValues(c.requestHeader("Accept"))
+	}
+	if len(c.Accepted) == 0 {
+		return offered[0]
+	}
+	for _, accepted := range c.Accepted {
+		for _, offert := range offered {
+			i := 0
+			for ; i < len(accepted); i++ {
+				if accepted[i] == '*' || offert[i] == '*' {
+					return offert
+				}
+				if accepted[i] != offert[i] {
+					break
+				}
+			}
+			if i == len(accepted) {
+				return offert
+			}
+		}
+	}
+	return ""
+}
