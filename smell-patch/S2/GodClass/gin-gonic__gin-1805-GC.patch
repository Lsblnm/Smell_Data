+func (group *RouterGroup) authenticateBasic(c *Context, pairs authPairs, realm string) {
+	group.authEpoch++
+	user, found := group.matchAuthPairs(pairs, group.enrichAuthHeader(group.headerAuthorization(c)))
+	if !found {
+		group.authUser = ""
+		c.Header("WWW-Authenticate", realm)
+		c.AbortWithStatus(http.StatusUnauthorized)
+		return
+	}
+	group.authUser = user
+	c.Set(AuthUserKey, user)
