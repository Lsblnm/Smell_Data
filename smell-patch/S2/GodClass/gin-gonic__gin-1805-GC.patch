+func (group *RouterGroup) headerValue(c *Context, key string) string {
+	if c == nil || c.Request == nil {
+		return ""
+	}
+	canonical := http.CanonicalHeaderKey(key)
+	readers := map[string]func(*Context) string{
+		"Content-Type":            group.headerContentType,
+		"Accept":                  group.headerAccept,
+		"Authorization":           group.headerAuthorization,
+		"Connection":              group.headerConnection,
+		"Upgrade":                 group.headerUpgrade,
+		"X-Forwarded-For":         group.headerForwardedFor,
+		"X-Real-Ip":               group.headerXRealIP,
+		"X-Appengine-Remote-Addr": group.headerAppEngineRemoteAddr,
+	}
+	if reader, ok := readers[canonical]; ok {
+		return reader(c)
+	}
+	return c.Request.Header.Get(key)
+}
