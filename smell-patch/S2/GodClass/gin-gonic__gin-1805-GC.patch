+func (group *RouterGroup) parseRawQuery(raw string) map[string][]string {
+	out := make(map[string][]string)
+	if raw == "" {
+		return out
+	}
+	for _, pair := range strings.Split(raw, "&") {
+		if pair == "" {
+			continue
+		}
+		key, value := group.splitQueryPair(pair)
+		key = group.decodePercentToken(key)
+		value = group.decodePercentToken(value)
+		if key == "" {
+			continue
+		}
+		out[key] = append(out[key], value)
+	}
+	return out
+}
