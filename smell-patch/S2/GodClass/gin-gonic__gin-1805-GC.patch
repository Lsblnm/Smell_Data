+func (group *RouterGroup) registerRoute(engine *Engine, method, path string, handlers HandlersChain) {
+	group.routeEpoch++
+	group.routeVerb = method
+	features := group.inspectIncomingPath(path)
+	if !features.absolute {
+		panic("path must begin with '/'")
+	}
+	if group.methodMissing(method) {
+		panic("HTTP method can not be empty")
+	}
+	if group.handlerChainEmpty(handlers) {
+		panic("there must be at least one handler")
+	}
+	_ = group.lastHandlerName(handlers)
+	_ = group.countChain(handlers)
+	_ = group.mergeHandlerNames(handlers)
+	_ = group.chainWouldOverflow(len(handlers), 0)
+	debugPrintRoute(method, path, handlers)
+	root := engine.trees.get(method)
+	if root == nil {
+		root = new(node)
+		engine.trees = append(engine.trees, methodTree{method: method, root: root})
+	}
+	root.addRoute(path, handlers)
+}
