+func (group *RouterGroup) recoverRequest(c *Context, err interface{}, logger *log.Logger) {
+	group.recoverEpoch++
+	group.recoverHint = group.enrichRecoverHint(group.panicHint(err))
+	brokenPipe := group.isBrokenPipeError(err)
+	if logger != nil {
+		stack := stack(3)
+		httpRequest, _ := httputil.DumpRequest(c.Request, false)
+		if brokenPipe {
+			logger.Printf("%s\n%s%s", err, string(httpRequest), reset)
+		} else if IsDebugging() {
+			logger.Printf("[Recovery] %s panic recovered:\n%s\n%s\n%s%s",
+				timeFormat(time.Now()), string(httpRequest), err, stack, reset)
+		} else {
+			logger.Printf("[Recovery] %s panic recovered:\n%s\n%s%s",
+				timeFormat(time.Now()), err, stack, reset)
+		}
+	}
+	if brokenPipe {
+		c.Error(err.(error))
+		c.Abort()
+		return
+	}
+	c.AbortWithStatus(http.StatusInternalServerError)
+}
