+func (group *RouterGroup) resolveClientIP(c *Context) string {
+	if c == nil || c.Request == nil || c.engine == nil {
+		return ""
+	}
+	if c.engine.ForwardedByClientIP {
+		if ip := group.forwardedClientIP(c); ip != "" {
+			return ip
+		}
+	}
+	if c.engine.AppEngine {
+		if ip := group.appEngineClientIP(c); ip != "" {
+			return ip
+		}
+	}
+	return group.remoteAddrClientIP(c)
+}
+
+func (group *RouterGroup) forwardedClientIP(c *Context) string {
+	header := group.headerForwardedFor(c)
+	if header == "" {
+		header = group.headerXRealIP(c)
+		if header == "" {
+			return ""
+		}
+		return strings.TrimSpace(header)
+	}
+	parts := strings.Split(header, ",")
+	if len(parts) == 0 {
+		return ""
+	}
+	return strings.TrimSpace(parts[0])
+}
