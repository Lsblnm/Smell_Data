+func (group *RouterGroup) resolveBinder(method, contentType string) binding.Binding {
+	if group.isGetMethod(method) {
+		return binding.Form
+	}
+	media := group.trimHeaderFlags(contentType)
+	switch {
+	case group.mediaIsJSON(media):
+		return binding.JSON
+	case group.mediaIsXML(media):
+		return binding.XML
+	case group.mediaIsProtobuf(media):
+		return binding.ProtoBuf
+	case group.mediaIsMsgpack(media):
+		return binding.MsgPack
+	case group.mediaIsYAML(media):
+		return binding.YAML
+	default:
+		return binding.Form
+	}
+}
