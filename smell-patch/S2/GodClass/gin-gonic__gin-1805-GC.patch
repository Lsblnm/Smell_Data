+func (group *RouterGroup) buildLogParams(c *Context, start time.Time, reqPath, raw string, isTerm bool) LogFormatterParams {
+	param := LogFormatterParams{
+		Request: c.Request,
+		IsTerm:  isTerm,
+		Keys:    c.Keys,
+	}
+	param.TimeStamp = time.Now()
+	param.Latency = param.TimeStamp.Sub(start)
+	param.ClientIP = c.ClientIP()
+	param.Method = c.Request.Method
+	param.StatusCode = c.Writer.Status()
+	param.ErrorMessage = c.Errors.ByType(ErrorTypePrivate).String()
+	param.BodySize = c.Writer.Size()
+	if raw != "" {
+		reqPath = reqPath + "?" + raw
+	}
+	param.Path = reqPath
+	group.noteLogStatus(param.StatusCode)
+	group.noteLogMethod(param.Method)
+	return param
+}
