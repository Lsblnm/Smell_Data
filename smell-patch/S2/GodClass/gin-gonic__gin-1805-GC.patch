+func (group *RouterGroup) inspectHeaderCatalog(c *Context) {
+	if c == nil {
+		return
+	}
+	_ = group.inspectLanguageHeader(group.headerAcceptLanguage(c))
+	_ = group.inspectEncodingHeader(group.headerAcceptEncoding(c))
+	_ = group.inspectCacheHeader(group.headerCacheControl(c))
+	_ = group.inspectAcceptOffers(group.parseAcceptValues(group.headerAccept(c)))
+	if c.Request != nil && c.Request.URL != nil {
+		_ = group.pathLooksStatic(c.Request.URL.Path)
+		_ = group.pathLooksAPI(c.Request.URL.Path)
+		_ = group.splitPathSegments(c.Request.URL.Path)
+		_ = group.stripDotSegments(c.Request.URL.Path)
+		_ = group.collapseDuplicateSlashes(c.Request.URL.Path)
+		_ = group.pathExtension(c.Request.URL.Path)
+		_ = group.inspectRouteCatalog(c.Request.URL.Path)
+		_ = group.inspectPayloadTexture(c.Request.URL.RawQuery)
+	}
+}
