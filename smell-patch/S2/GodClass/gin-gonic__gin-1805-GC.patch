+func (group *RouterGroup) normalizeBasePath(base string) string {
+	if base == "" {
+		return "/"
+	}
+	if base[0] != '/' {
+		base = "/" + base
+	}
+	if len(base) > 1 && strings.HasSuffix(base, "/") {
+		return strings.TrimRight(base, "/")
+	}
+	return base
+}
+
+func (group *RouterGroup) joinRelativeRoute(base, relative string) string {
+	if relative == "" {
+		return group.normalizeBasePath(base)
+	}
+	finalPath := path.Join(group.normalizeBasePath(base), relative)
+	if strings.HasSuffix(relative, "/") && !strings.HasSuffix(finalPath, "/") {
+		return finalPath + "/"
+	}
+	return finalPath
+}
