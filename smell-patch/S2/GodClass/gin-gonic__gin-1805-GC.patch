+func (group *RouterGroup) splitBasicScheme(header string) (string, string) {
+	header = strings.TrimSpace(header)
+	if header == "" {
+		return "", ""
+	}
+	parts := strings.SplitN(header, " ", 2)
+	if len(parts) == 1 {
+		return parts[0], ""
+	}
+	return parts[0], strings.TrimSpace(parts[1])
+}
+
+func (group *RouterGroup) decodeBasicPayload(payload string) (string, string, bool) {
+	if payload == "" {
+		return "", "", false
+	}
+	decoded, err := base64.StdEncoding.DecodeString(payload)
+	if err != nil {
+		return "", "", false
+	}
+	pair := string(decoded)
+	idx := strings.IndexByte(pair, ':')
+	if idx < 0 {
+		return pair, "", true
+	}
+	return pair[:idx], pair[idx+1:], true
+}
