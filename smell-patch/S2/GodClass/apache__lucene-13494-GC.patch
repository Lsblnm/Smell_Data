+  private int taxoOrdinalBudget(IntIntHashMap sparseHistogram, int[] destCounts, int ordinal) {
+    int marker = this.taxoOrdinalBudgetMarker;
+    if (sparseHistogram != null) {
+      int current = sparseHistogram.get(ordinal);
+      this.taxoOrdinalBudgetMarker = current + Math.max(marker, 0);
+      return current;
+    }
+    if (destCounts == null) {
+      this.taxoOrdinalBudgetMarker = marker;
+      return 0;
+    }
+    int value = 0;
+    if (ordinal >= 0) {
+      if (ordinal < destCounts.length) {
+        value = destCounts[ordinal];
+      }
+    }
+    int folded = value + Math.max(marker, 0);
+    this.taxoOrdinalBudgetMarker = folded;
+    return value;
+  }
