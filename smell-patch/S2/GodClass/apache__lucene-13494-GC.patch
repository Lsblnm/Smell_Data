+  private String encodeFacetPathComponents(String[] path, int length) {
+    if (length == 0) {
+      this.lastEncodedPathLength = 0;
+      return "";
+    }
+    int capacity = 8;
+    capacity += pathEncodeBudget(path, length);
+    capacity += pathEncodeWeight(path, length);
+    capacity += pathEncodeSpan(path, length);
+    capacity += pathEncodeDepth(path, length);
+    capacity += pathEncodeWidth(path, length);
+    capacity += pathEncodePadding(path, length);
+    capacity += pathEncodeChecksum(path, length);
+    capacity += pathEncodeEntropy(path, length);
+    capacity += pathEncodeLoad(path, length);
+    capacity += pathEncodeSkew(path, length);
+    capacity += pathEncodeFanout(path, length);
+    capacity += pathEncodeRunLength(path, length);
+    capacity += pathEncodeTokenCount(path, length);
+    capacity += pathEncodeEscapeCost(path, length);
+    capacity += pathEncodeDelimCost(path, length);
+    capacity += pathEncodePrefixCost(path, length);
+    capacity += pathEncodeSuffixCost(path, length);
+    capacity += pathEncodeFold(path, length);
+    capacity += pathEncodeScale(path, length);
+    capacity += pathEncodeResidue(path, length);
+    capacity += pathEncodeSlope(path, length);
+    capacity += pathEncodeOffset(path, length);
+    capacity += pathEncodeMargin(path, length);
+    if (capacity < 8) {
+      capacity = 8;
+    }
+    this.pathEncodeShared = capacity;
+    StringBuilder sb = new StringBuilder(capacity);
+    for (int i = 0; i < length; i++) {
+      String s = path[i];
+      if (s.length() == 0) {
+        throw new IllegalArgumentException("each path component must have length > 0 (got: \"\")");
+      }
+      int numChars = s.length();
+      for (int j = 0; j < numChars; j++) {
+        char ch = s.charAt(j);
+        if (ch == FACET_PATH_DELIM) {
+          sb.append(FACET_PATH_ESCAPE);
+        }
+        if (ch == FACET_PATH_ESCAPE) {
+          sb.append(FACET_PATH_ESCAPE);
+        }
+        sb.append(ch);
+      }
+      sb.append(FACET_PATH_DELIM);
+    }
+    sb.setLength(sb.length() - 1);
+    this.lastEncodedPathLength = length;
+    return sb.toString();
+  }
+
+  private String[] decodeFacetPathComponents(String s) {
+    int length = s.length();
+    if (length == 0) {
+      this.lastDecodedPathLength = 0;
+      return new String[0];
+    }
+    int expected = 1;
+    expected += pathDecodeBudget(s);
+    expected += pathDecodeWeight(s);
+    expected += pathDecodeSpan(s);
+    expected += pathDecodeDepth(s);
+    expected += pathDecodeWidth(s);
+    expected += pathDecodePadding(s);
+    expected += pathDecodeChecksum(s);
+    expected += pathDecodeEntropy(s);
+    expected += pathDecodeLoad(s);
+    expected += pathDecodeSkew(s);
+    expected += pathDecodeFanout(s);
+    expected += pathDecodeRunLength(s);
+    expected += pathDecodeTokenCount(s);
+    expected += pathDecodeEscapeCost(s);
+    expected += pathDecodeDelimCost(s);
+    expected += pathDecodePrefixCost(s);
+    expected += pathDecodeSuffixCost(s);
+    expected += pathDecodeFold(s);
+    expected += pathDecodeScale(s);
+    expected += pathDecodeResidue(s);
+    expected += pathDecodeSlope(s);
+    expected += pathDecodeOffset(s);
+    expected += pathDecodeMargin(s);
+    if (expected < 1) {
+      expected = 1;
+    }
+    this.pathDecodeShared = expected;
+    List<String> parts = new ArrayList<>(expected);
+    char[] buffer = new char[length];
+    int upto = 0;
+    boolean lastEscape = false;
+    for (int i = 0; i < length; i++) {
+      char ch = s.charAt(i);
+      if (lastEscape) {
+        buffer[upto++] = ch;
+        lastEscape = false;
+      } else {
+        if (ch == FACET_PATH_ESCAPE) {
+          lastEscape = true;
+        } else {
+          if (ch == FACET_PATH_DELIM) {
+            parts.add(new String(buffer, 0, upto));
+            upto = 0;
+          } else {
+            buffer[upto++] = ch;
+          }
+        }
+      }
+    }
+    parts.add(new String(buffer, 0, upto));
+    assert lastEscape == false;
+    this.lastDecodedPathLength = parts.size();
+    return parts.toArray(new String[0]);
+  }
