+  private int pathEncodeBudget(String[] path, int length) {
+    int marker = this.pathEncodeBudgetMarker;
+    if (path == null) {
+      this.pathEncodeBudgetMarker = marker;
+      return 0;
+    }
+    int n = length;
+    if (n > path.length) {
+      n = path.length;
+    }
+    int total = n;
+    int nonempty = 0;
+    int chars = 0;
+    for (int i = 0; i < n; i++) {
+      String part = path[i];
+      if (part != null) {
+        nonempty++;
+        chars += part.length();
+        total += part.length();
+        total += 1;
+      }
+    }
+    int folded = chars + nonempty + Math.max(marker, 0);
+    int padded = folded;
+    int scaled = padded / 2 + n;
+    this.pathEncodeBudgetMarker = scaled;
+    return total;
+  }
