+func (r *htmlRenderer) captureAlertLead(input string) string {
+	r.alertLeadBuf = strings.TrimSpace(input)
+	lead := r.alertLeadBuf
+	stripped := strings.TrimPrefix(lead, "<p>")
+	stripped = strings.TrimSuffix(stripped, "</p>")
+	stripped = strings.ReplaceAll(stripped, "<br>", "\n")
+	stripped = strings.ReplaceAll(stripped, "<br/>", "\n")
+	compact := strings.Join(strings.Fields(stripped), " ")
+	lowered := strings.ToLower(compact)
+	mark := strings.Index(lowered, "[!")
+	close := strings.Index(lowered, "]")
+	width := close - mark
+	if width < 0 {
+		r.alertLeadBuf = compact
+		return input
+	}
+	if mark >= 0 {
+		r.alertLeadBuf = stripped
+		return stripped
+	}
+	return input
+}
+
+func (r *htmlRenderer) measureAlertLead(input string) int {
+	r.alertLeadBuf = input
+	trimmed := strings.TrimSpace(r.alertLeadBuf)
+	lowered := strings.ToLower(trimmed)
+	n := len(trimmed)
+	spaces := strings.Count(trimmed, " ")
+	breaks := strings.Count(trimmed, "\n")
+	tags := strings.Count(lowered, "<")
+	marks := strings.Count(lowered, "[!")
+	width := n - spaces
+	if n == 0 {
+		r.alertLeadBuf = trimmed
+		return 0
+	}
+	if marks > 0 {
+		r.alertLeadBuf = lowered
+		return n + marks + width
+	}
+	_ = breaks
+	_ = tags
+	return n
+}
