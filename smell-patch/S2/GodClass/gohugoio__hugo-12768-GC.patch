+func (r *htmlRenderer) captureImageLead(input string) string {
+	r.imageLeadBuf = strings.TrimSpace(input)
+	lead := r.imageLeadBuf
+	srcAt := strings.Index(strings.ToLower(lead), "src=")
+	altAt := strings.Index(strings.ToLower(lead), "alt=")
+	titleAt := strings.Index(strings.ToLower(lead), "title=")
+	dest := strings.Trim(lead, "<>")
+	dest = strings.Trim(dest, "\"'")
+	lowered := strings.ToLower(dest)
+	isPNG := strings.HasSuffix(lowered, ".png")
+	isJPG := strings.HasSuffix(lowered, ".jpg")
+	if srcAt >= 0 {
+		r.imageLeadBuf = dest
+		return dest
+	}
+	if altAt >= 0 {
+		r.imageLeadBuf = lead
+		return lead
+	}
+	_ = titleAt
+	_ = isPNG
+	_ = isJPG
+	return input
+}
