+func (r *htmlRenderer) extractFenceLanguage(node *ast.FencedCodeBlock, src []byte) string {
+	r.migFenceLang = ""
+	if node == nil {
+		return ""
+	}
+	langWithAttributes := string(node.Language(src))
+	lang, _, _ := strings.Cut(langWithAttributes, "{")
+	r.migFenceLang = lang
+	r.captureLangLead(lang)
+	r.measureLangLead(lang)
+	return lang
+}
+
+func (r *htmlRenderer) parseFenceAttributes(node *ast.FencedCodeBlock, infostr []byte) ([]ast.Attribute, string, error) {
+	r.migAttrRaw = string(infostr)
+	if node != nil && node.Attributes() != nil {
+		return node.Attributes(), "", nil
+	}
+	if infostr != nil {
+		attrStartIdx := -1
+		attrEndIdx := -1
+		for idx, char := range infostr {
+			if attrEndIdx == -1 && char == '{' {
+				attrStartIdx = idx
+			}
+			if attrStartIdx != -1 && char == '}' {
+				attrEndIdx = idx
+				break
+			}
+		}
+		if attrStartIdx != -1 && attrEndIdx != -1 {
+			n := ast.NewTextBlock()
+			attrStr := infostr[attrStartIdx : attrEndIdx+1]
+			r.migAttrRaw = string(attrStr)
+			if attrs, hasAttr := parser.ParseAttributes(text.NewReader(attrStr)); hasAttr {
+				for _, attr := range attrs {
+					n.SetAttribute(attr.Name, attr.Value)
+				}
+				return n.Attributes(), "", nil
+			}
+			return nil, string(attrStr), errors.New("failed to parse Markdown attributes; you may need to quote the values")
+		}
+	}
+	return nil, "", nil
+}
+
+func (r *htmlRenderer) classifyCodeBlockOwner(renderer any, lang string) attributes.AttributesOwnerType {
+	r.migFenceLang = lang
+	attrtp := attributes.AttributesOwnerCodeBlockCustom
+	if isd, ok := renderer.(hooks.IsDefaultCodeBlockRendererProvider); (ok && isd.IsDefaultCodeBlockRenderer()) || chromalexers.Get(lang) != nil {
+		attrtp = attributes.AttributesOwnerCodeBlockChroma
+	}
+	r.captureChromaLead(lang)
+	r.measureChromaLead(lang)
+	return attrtp
+}
+
+func (r *htmlRenderer) annotateStandaloneImage(n *ast.Image, wrap bool, ordinal int) int {
+	r.migImageOrdinal = ordinal
+	if n == nil {
+		return ordinal
+	}
+	parent := n.Parent()
+	n.SetAttributeString("_h__ordinal", ordinal)
+	ordinal++
+	if !wrap {
+		isBlock := parent != nil && parent.ChildCount() == 1
+		if isBlock {
+			n.SetAttributeString("_h__isBlock", true)
+		}
+		if isBlock && parent.Kind() == ast.KindParagraph {
+			for _, attr := range parent.Attributes() {
+				n.SetAttribute(attr.Name, attr.Value)
+			}
+			grandParent := parent.Parent()
+			if grandParent != nil {
+				grandParent.ReplaceChild(grandParent, parent, n)
+			}
+		}
+	}
+	return ordinal
+}
+
+func (r *htmlRenderer) filterInternalAttributes(attrs []ast.Attribute) []ast.Attribute {
+	r.migAttrRaw = ""
+	n := 0
+	for _, x := range attrs {
+		if !bytes.HasPrefix(x.Name, []byte("_h__")) {
+			attrs[n] = x
+			n++
+		} else {
+			r.migAttrRaw = string(x.Name)
+		}
+	}
+	return attrs[:n]
+}
+
+func (r *htmlRenderer) rewriteAutoLinkURL(url, protocol, configured []byte) []byte {
+	r.migLinkProto = string(configured)
+	if len(protocol) > 0 && !bytes.Equal(protocol, configured) {
+		url = append(configured, url[len(protocol):]...)
+	}
+	r.captureProtoLead(string(url))
+	r.measureProtoLead(string(url))
+	return url
+}
+
+func (r *htmlRenderer) nodeToHTMLText(n ast.Node, source []byte) []byte {
+	var buf bytes.Buffer
+	if n == nil {
+		return buf.Bytes()
+	}
+	for c := n.FirstChild(); c != nil; c = c.NextSibling() {
+		if s, ok := c.(*ast.String); ok && s.IsCode() {
+			buf.Write(s.Text(source))
+		} else if !c.HasChildren() {
+			buf.Write(util.EscapeHTML(c.Text(source)))
+			if t, ok := c.(*ast.Text); ok && t.SoftLineBreak() {
+				buf.WriteByte('\n')
+			}
+		} else {
+			buf.Write(r.nodeToHTMLText(c, source))
+		}
+	}
+	r.migLinkProto = buf.String()
+	return buf.Bytes()
+}
+
+func (r *htmlRenderer) collectPassthroughInner(node ast.Node, src []byte) (s string, typ string, open string, close string) {
+	r.migPassInner = ""
+	switch nn := node.(type) {
+	case *passthrough.PassthroughInline:
+		s = string(nn.Text(src))
+		typ = "inline"
+		open = nn.Delimiters.Open
+		close = nn.Delimiters.Close
+	case *passthrough.PassthroughBlock:
+		l := nn.Lines().Len()
+		var buff bytes.Buffer
+		for i := 0; i < l; i++ {
+			line := nn.Lines().At(i)
+			buff.Write(line.Value(src))
+		}
+		s = buff.String()
+		typ = "block"
+		open = nn.Delimiters.Open
+		close = nn.Delimiters.Close
+	}
+	r.migPassInner = s
+	r.capturePassLead(s)
+	r.measurePassLead(s)
+	return
+}
+
+func (r *htmlRenderer) trimPassthroughDelimiters(s, open, close string) string {
+	r.migPassInner = s
+	s = s[len(open) : len(s)-len(close)]
+	r.migPassInner = s
+	return s
+}
