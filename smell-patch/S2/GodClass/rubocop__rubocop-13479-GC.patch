+            insert_frozen_comment(corrector)
+          end
+        end
+
+        def missing_frozen_true_offense
+          @frozen_missing_true_range = @frozen_host.send(:source_range, @frozen_source.buffer, 0, 0)
+          @frozen_host.add_offense(@frozen_missing_true_range, message: Style::FrozenStringLiteralComment::MSG_MISSING_TRUE) do |corrector|
+            insert_frozen_comment(corrector)
