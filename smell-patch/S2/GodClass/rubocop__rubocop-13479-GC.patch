+          @help_begin_node = node
+          source = host.processed_source
+          first_comment = source.ast_with_comments[node].first
+          if first_comment && (first_comment.loc.line < node.loc.line)
+            host.send(:start_line_position, first_comment)
+          else
+            host.send(:start_line_position, node)
+          end
+        end
+
+        def help_start_line_position(host, node)
