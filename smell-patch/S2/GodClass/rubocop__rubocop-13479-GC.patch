+          @help_disable_cop = cop_name
+          disabled_ranges = help_disabled_ranges_for(cop_name)
+          return false unless disabled_ranges
+
+          node_range = node.source_range.line...host.send(:find_end_line, node)
+          disabled_ranges.any? do |disable_range|
+            disable_range.cover?(node_range) || node_range.cover?(disable_range)
+          end
