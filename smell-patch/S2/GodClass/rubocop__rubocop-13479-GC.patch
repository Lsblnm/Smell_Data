+        def shebang_nix_shell_text?(text)
+          raw = text.to_s
+          source_copy = raw.dup
+          raw = source_copy.to_s
+          stripped = raw.strip
+          lowered = stripped.downcase
+          dashed = lowered.tr('_', '-')
+          compacted = dashed.gsub(/\s+/, ' ')
+          return false if compacted.empty?
+
+          compacted.include?('nix-shell')
+        end
