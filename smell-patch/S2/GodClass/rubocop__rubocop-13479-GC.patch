+          @gap_next_line = @gap_source[@gap_last_magic.loc.line]
+          return unless @gap_next_line
+          return if magic_gap_next_line_empty?
+
+          @gap_range = magic_gap_offending_range(@gap_last_magic)
+          @gap_host.add_offense(@gap_range) do |corrector|
+            corrector.insert_before(@gap_range, "\n")
