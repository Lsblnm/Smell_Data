+              @dup_comment_lines[:frozen_string_literal_magic_comments] << index
+            end
+          end
+          @dup_comment_lines
+        end
+
+        def register_duplicate_magic_offense(range)
+          @dup_range = range
+          @dup_host.add_offense(range) do |corrector|
+            corrector.remove(@dup_host.send(:range_by_whole_lines, range, include_final_newline: true))
+          end
+        end
+
+        def indent_end_or_closer?(line)
