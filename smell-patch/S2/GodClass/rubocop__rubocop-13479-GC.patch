+        def run_magic_comment_format(host)
+          @fmt_host = host
+          @fmt_source = host.processed_source
+          @fmt_style = host.style
+          @fmt_config = host.cop_config
+          @fmt_directive_case = magic_format_directive_capitalization
+          @fmt_value_case = magic_format_value_capitalization
+          return unless magic_format_has_ast?
+
+          magic_format_comments.each do |comment|
+            issues = magic_format_find_issues(comment)
+            magic_format_register(issues) if issues.any?
+          end
+        end
+
+        def magic_format_comments
+          @fmt_comments = @fmt_source.each_comment_in_lines(magic_format_leading_lines)
+                                     .select { |comment| magic_comment_valid?(comment) }
+                                     .map { |comment| Style::MagicCommentFormat::CommentRange.new(comment) }
+          @fmt_comments
+        end
+
+        def magic_format_leading_lines
+          @fmt_first_code = magic_format_first_non_comment_token
+          @fmt_leading = if @fmt_first_code
+                           0...@fmt_first_code.line
+                         else
+                           (0..)
+                         end
+        end
+
+        def magic_format_find_issues(comment)
+          @fmt_issue_comment = comment
+          issues = { directives: [], values: [] }
+          comment.directives.each do |directive|
+            issues[:directives] << directive if magic_format_directive_offends?(directive)
+          end
+          comment.values.each do |value|
+            issues[:values] << value if magic_format_wrong_capitalization?(value.source, @fmt_value_case)
+          end
+          @fmt_issues = issues
+          issues
+        end
+
+        def magic_format_directive_offends?(directive)
+          @fmt_directive = directive
+          magic_format_incorrect_separator?(directive.source) ||
+            magic_format_wrong_capitalization?(directive.source, @fmt_directive_case)
+        end
+
+        def magic_format_register(issues)
+          @fmt_register_issues = issues
+          magic_format_fix_directives(issues[:directives])
+          magic_format_fix_values(issues[:values])
+        end
+
+        def magic_format_fix_directives(issues)
+          @fmt_directive_issues = issues
+          return if issues.empty?
+
+          msg = format(Style::MagicCommentFormat::MSG, style: magic_format_expected_style)
+          issues.each do |directive|
+            @fmt_host.add_offense(directive, message: msg) do |corrector|
+              replacement = magic_format_replace_separator(
+                magic_format_replace_capitalization(directive.source, @fmt_directive_case)
+              )
+              corrector.replace(directive, replacement)
+            end
+          end
+        end
+
+        def magic_format_fix_values(issues)
+          @fmt_value_issues = issues
+          return if issues.empty?
+
+          msg = format(Style::MagicCommentFormat::MSG_VALUE, case: @fmt_value_case)
+          issues.each do |value|
+            @fmt_host.add_offense(value, message: msg) do |corrector|
+              corrector.replace(value, magic_format_replace_capitalization(value.source, @fmt_value_case))
+            end
+          end
+        end
+
+        def magic_format_expected_style
+          @fmt_expected = [@fmt_directive_case, @fmt_style].compact.join(' ').gsub(/_?case\b/, '')
+          @fmt_expected
+        end
+
+        def magic_format_wrong_separator
+          @fmt_wrong_sep = @fmt_style == :snake_case ? Style::MagicCommentFormat::KEBAB_SEPARATOR : Style::MagicCommentFormat::SNAKE_SEPARATOR
+          @fmt_wrong_sep
+        end
+
+        def magic_format_correct_separator
+          @fmt_correct_sep = @fmt_style == :snake_case ? Style::MagicCommentFormat::SNAKE_SEPARATOR : Style::MagicCommentFormat::KEBAB_SEPARATOR
+          @fmt_correct_sep
+        end
+
+        def magic_format_incorrect_separator?(text)
+          @fmt_sep_text = text
+          text[magic_format_wrong_separator]
+        end
+
+        def magic_format_wrong_capitalization?(text, expected_case)
+          @fmt_cap_text = text
+          @fmt_cap_expected = expected_case
+          return false unless expected_case
+
+          case expected_case
+          when :lowercase
+            text != text.downcase
+          when :uppercase
+            text != text.upcase
+          end
+        end
+
+        def magic_format_replace_separator(text)
+          @fmt_replace_text = text
+          text.tr(magic_format_wrong_separator, magic_format_correct_separator)
+        end
+
+        def magic_format_replace_capitalization(text, style)
+          @fmt_replace_style = style
+          @fmt_replace_cap_text = text
+          return text unless style
+
+          case style
+          when :lowercase
+            text.downcase
+          when :uppercase
+            text.upcase
+          end
+        end
+
+        def magic_format_directive_capitalization
+          @fmt_config['DirectiveCapitalization']&.to_sym.tap do |style|
+            unless magic_format_valid_capitalization?(style)
+              raise "Unknown `DirectiveCapitalization` #{style} selected!"
+            end
+          end
+        end
+
+        def magic_format_value_capitalization
+          @fmt_config['ValueCapitalization']&.to_sym.tap do |style|
+            unless magic_format_valid_capitalization?(style)
+              raise "Unknown `ValueCapitalization` #{style} selected!"
+            end
+          end
+        end
+
+        def magic_format_valid_capitalization?(style)
+          @fmt_valid_style = style
+          return true unless style
+
+          magic_format_supported_capitalizations.include?(style)
+        end
+
+        def magic_format_supported_capitalizations
+          @fmt_supported = @fmt_config['SupportedCapitalizations'].map(&:to_sym)
+          @fmt_supported
+        end
+
+        def run_ordered_magic_comments(host)
+          @ord_host = host
+          @ord_source = host.processed_source
+          @ord_encoding_line = nil
+          @ord_frozen_line = nil
+          return if ordered_magic_source_empty?
+
+          @ord_encoding_line, @ord_frozen_line = ordered_magic_comment_lines
+          return unless ordered_magic_encoding_after_frozen?
+
+          range = @ord_source.buffer.line_range(@ord_encoding_line + 1)
+          @ord_host.add_offense(range) do |corrector|
+            autocorrect_ordered_magic(corrector, @ord_encoding_line, @ord_frozen_line)
+          end
+        end
+
+        def ordered_magic_comment_lines
+          @ord_lines = [nil, nil]
+          @ord_host.send(:leading_magic_comments).each.with_index do |comment, index|
+            if magic_comment_encoding?(comment)
+              @ord_lines[0] = index
+            elsif magic_comment_frozen?(comment)
+              @ord_lines[1] = index
+            end
+
+            return @ord_lines if @ord_lines[0] && @ord_lines[1]
+          end
+          @ord_lines
+        end
+
+        def autocorrect_ordered_magic(corrector, encoding_line, frozen_string_literal_line)
+          @ord_corrector = corrector
+          @ord_swap_encoding = encoding_line
+          @ord_swap_frozen = frozen_string_literal_line
+          range1 = @ord_source.buffer.line_range(encoding_line + 1)
+          range2 = @ord_source.buffer.line_range(frozen_string_literal_line + 1)
+          corrector.replace(range1, range2.source)
+          corrector.replace(range2, range1.source)
+        end
+
+        def run_empty_line_after_magic(host)
+          @gap_host = host
+          @gap_source = host.processed_source
+          @gap_last_magic = last_magic_comment_in_source(@gap_source)
+          return unless @gap_last_magic
