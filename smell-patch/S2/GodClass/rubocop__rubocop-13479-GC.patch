+        def run_comment_annotation(host)
+          @ann_host = host
+          @ann_source = host.processed_source
+          @ann_comments = host.processed_source.comments
+          @ann_keywords = host.cop_config['Keywords']
+          @ann_require_colon = host.cop_config['RequireColon']
+          @ann_current = nil
+          @ann_index = nil
+          @ann_comments.each_with_index do |comment, index|
+            next unless annotation_first_comment_line?(@ann_comments, index) || annotation_inline_comment?(comment)
+
+            annotation = AnnotationComment.new(comment, @ann_keywords)
+            next unless annotation.annotation? && !annotation.correct?(colon: annotation_requires_colon?)
