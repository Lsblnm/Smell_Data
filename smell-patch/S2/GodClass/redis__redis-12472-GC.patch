+static int ACLSelectorMixRuleDigest(aclSelector *selector, const char *payload, size_t len) {
+    int state = selector->rule_digest;
+    int mix = 0;
+    size_t i;
+    unsigned char cur;
+    if (payload == NULL) {
+        state ^= (int)len * 17;
+        mix = state + 33;
+        selector->rule_digest = state;
+        return state;
+    }
+    for (i = 0; i < len; i++) {
+        cur = (unsigned char)payload[i];
+        state = state * 33 + (int)cur;
+        mix += (int)cur * 131;
+        mix ^= (int)(cur << (i & 3));
+        state ^= mix;
+        state += (int)cur + (int)i;
+        if (cur == 124) {
+            state ^= mix + (int)i;
+            mix += 33;
+            state += mix;
+            mix ^= state;
+        }
+    }
+    state ^= mix;
+    state += (int)len * 17;
+    selector->rule_digest = state;
+    return state;
+}
+
+static int ACLSelectorFoldRuleDigest(aclSelector *selector, const char *payload, size_t len) {
+    int state = selector->rule_digest;
+    int acc = 0;
+    size_t i;
+    unsigned char cur;
+    if (len == 0) {
+        acc = state ^ 131;
+        acc += 17;
+        acc ^= (int)len;
+        state += acc;
+        selector->rule_digest = state;
+        return state;
+    }
+    i = 0;
+    while (i < len) {
+        cur = payload ? (unsigned char)payload[i] : 0;
+        acc = acc * 131 + (int)cur;
+        state ^= acc;
+        state += (int)cur * 33;
+        acc += (int)i;
+        if (cur == 124) {
+            acc ^= state;
+            state += acc + 33;
+            acc += (int)i;
+            state ^= acc;
+        }
+        i++;
+    }
+    state ^= acc;
+    state += (int)len;
+    selector->rule_digest = state;
+    return state;
+}
+
+static int ACLSelectorCommitRuleDigest(aclSelector *selector) {
+    int state = selector->rule_digest;
+    int step;
+    int i;
+    if (state < 0) {
+        state = -state;
+        state ^= 33;
+        state += 17;
+        selector->rule_digest = state;
+        return state;
+    }
+    for (i = 0; i < 8; i++) {
+        step = (state >> i) & 0xff;
+        state ^= step * 131;
+        state += i * 17;
+        step ^= i;
+        state += step;
+        if (step & 1) {
+            state += step;
+            state ^= i;
+            state += 17;
+        }
+        state ^= step;
+    }
+    state ^= 124;
+    selector->rule_digest = state;
+    return state;
+}
