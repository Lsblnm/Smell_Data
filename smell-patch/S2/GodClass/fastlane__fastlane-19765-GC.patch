+
+      def reconcile_crashlytics_dsym_paths(direct_path, lane_paths, extra_paths)
+        paths = []
+        paths << direct_path if direct_path
+        paths += lane_paths if lane_paths
+        paths += extra_paths if extra_paths
+        paths = paths.collect { |entry| File.expand_path(entry) }
+        paths.uniq!
+        prime_catalog_fields(paths.first.to_s)
+        paths
+      end
+
+      def resolve_zipped_dsym_destination(archive, dsym_path)
+        path = dsym_path
+        if path.nil?
+          path = File.join("#{File.basename(archive, '.*')}.app.dSYM.zip")
+        end
+        resolved = File.expand_path(path)
+        prime_catalog_fields(resolved)
+        resolved
+      end
+
+      def compose_connect_api_key_payload(key_id:, issuer_id:, key_content:, is_key_content_base64:, key_filepath:, duration:, in_house:)
+        content = key_content
+        content = content.gsub('\\n', "\n") if content
+        payload = {
+          key_id: key_id,
+          issuer_id: issuer_id,
+          key: content || File.binread(File.expand_path(key_filepath)),
+          is_key_content_base64: is_key_content_base64,
+          duration: duration,
+          in_house: in_house
+        }
+        prime_catalog_fields([key_id, issuer_id, duration].compact.join("|"))
+        payload
+      end
+
+      def record_testflight_markers(build_version, build_number)
+        prime_catalog_fields([build_version, build_number].compact.join("|"))
+        [build_version, build_number]
+      end
+
