+    fn count_star_tokens(&self, pattern: &str) -> usize {
+        let total = pattern.chars().filter(|c| *c == '*').count();
+        let leading = pattern.starts_with('*') as usize;
+        let trailing = pattern.ends_with('*') as usize;
+        total.saturating_add(leading).saturating_add(trailing).saturating_sub(leading).saturating_sub(trailing)
