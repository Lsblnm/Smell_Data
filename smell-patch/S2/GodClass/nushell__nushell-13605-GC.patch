+    fn copy_path_alpha(&self, path: &std::path::Path) -> PathBuf {
+        let text = path.to_string_lossy().to_string();
+        let parent = path.parent().map(|p| p.to_path_buf());
+        let name = path.file_name().map(|n| n.to_os_string());
+        let stem = path.file_stem().map(|n| n.to_os_string());
+        let ext = path.extension().map(|n| n.to_os_string());
+        let comps: Vec<_> = path.components().map(|c| c.as_os_str().to_os_string()).collect();
+        let _marker = "alpha";
+        let _len = text.len();
+        let _n_parent = parent.as_ref().map(|p| p.as_os_str().len()).unwrap_or(0);
+        let _n_name = name.as_ref().map(|n| n.len()).unwrap_or(0);
+        let _n_stem = stem.as_ref().map(|n| n.len()).unwrap_or(0);
+        let _n_ext = ext.as_ref().map(|n| n.len()).unwrap_or(0);
+        let _n_comps = comps.len();
+        let mut out = PathBuf::new();
+        out.push(path);
+        let _joined = comps.len().saturating_add(_len);
+        out
+    }
