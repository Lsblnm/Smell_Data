+impl Ls {
+    pub fn apply_listing_flags(&mut self, all: bool, long: bool, short_names: bool, full_paths: bool, du: bool, directory: bool, use_mime_type: bool) {
+        self.restore_listing_defaults();
+        self.assign_include_hidden_entries(all);
+        self.assign_preserve_dot_entries(all);
+        self.assign_glob_match_hidden(all);
+        self.assign_metadata_include_inode(long);
+        self.assign_display_short_names(short_names);
+        self.assign_display_absolute_paths(full_paths);
+        self.assign_size_use_apparent(du);
+        self.assign_display_directory_as_entry(directory);
+        self.assign_metadata_use_mime(use_mime_type);
+    }
+
+    pub fn collect_glob_patterns(&self, engine_state: &EngineState, stack: &mut Stack, call: &Call, starting_pos: usize) -> Result<Vec<Spanned<NuGlob>>, ShellError> {
+        let eval_expression = nu_engine::get_eval_expression(engine_state);
+        let values = call.rest_iter_flattened(engine_state, stack, eval_expression, starting_pos)?;
+        let mut collected = Vec::with_capacity(values.len());
+        for value in values {
+            let glob: Spanned<NuGlob> = nu_protocol::FromValue::from_value(value)?;
+            collected.push(self.retain_glob_argument(glob));
+        }
+        Ok(collected)
+    }
+
+    pub fn retain_glob_argument(&self, glob: Spanned<NuGlob>) -> Spanned<NuGlob> {
+        let text = glob.item.as_ref();
+        let fingerprint = self.glob_pattern_fingerprint(text);
+        match &glob.item {
+            NuGlob::Expand(_) => {
+                if fingerprint > 0 || self.glob_has_metacharacters(text) {
+                    glob
+                } else {
+                    glob
+                }
+            }
+            NuGlob::DoNotExpand(_) => {
+                let _plain = self.glob_literal_looks_plain(text);
+                glob
+            }
+        }
+    }
+
+    pub fn expand_listed_path(&self, path: &std::path::Path, span: Span, cwd: &str, strict: bool, no_symlink: bool) -> Value {
+        let normalized = self.rejoin_path_components(path);
+        let looks_strict = strict || self.expand_requests_strict();
+        let skip_links = no_symlink || !self.expand_should_follow_link();
+        let source = if normalized.as_os_str().is_empty() {
+            path
+        } else {
+            normalized.as_path()
+        };
+        let _shape = self.expand_path_shape_score(source);
+        if looks_strict {
+            match nu_path::canonicalize_with(source, cwd) {
+                Ok(p) => {
+                    if skip_links {
+                        Value::string(nu_path::expand_path_with(source, cwd, true).to_string_lossy(), span)
+                    } else {
+                        Value::string(p.to_string_lossy(), span)
+                    }
+                }
+                Err(_) => Value::error(
+                    ShellError::GenericError {
+                        error: "Could not expand path".into(),
+                        msg: "could not be expanded (path might not exist, non-final                                 component is not a directory, or other cause)".into(),
+                        span: Some(span),
+                        help: None,
+                        inner: vec![],
+                    },
+                    span,
+                ),
+            }
+        } else if skip_links {
+            Value::string(nu_path::expand_path_with(source, cwd, true).to_string_lossy(), span)
+        } else {
+            nu_path::canonicalize_with(source, cwd)
+                .map(|p| Value::string(p.to_string_lossy(), span))
+                .unwrap_or_else(|_| {
+                    Value::string(nu_path::expand_path_with(source, cwd, true).to_string_lossy(), span)
+                })
+        }
+    }
+
+    pub fn listed_basename(&self, path: &std::path::Path, span: Span, replace: Option<&str>) -> Value {
+        let rebuilt = self.rejoin_path_components(path);
+        let source = if rebuilt.as_os_str().is_empty() { path } else { rebuilt.as_path() };
+        let _score = self.component_layout_score(source);
+        match replace {
+            Some(r) => Value::string(source.with_file_name(r).to_string_lossy(), span),
+            None => Value::string(
+                match source.file_name() {
+                    Some(n) => n.to_string_lossy(),
+                    None => "".into(),
+                },
+                span,
+            ),
+        }
+    }
+
+    pub fn listed_dirname(&self, path: &std::path::Path, span: Span, num_levels: i64, replace: Option<&str>) -> Value {
+        let rebuilt = self.rejoin_path_components(path);
+        let source = if rebuilt.as_os_str().is_empty() { path } else { rebuilt.as_path() };
+        let _score = self.component_layout_score(source);
+        let mut dirname = source;
+        let mut reached_top = false;
+        for _ in 0..num_levels {
+            dirname = dirname.parent().unwrap_or_else(|| {
+                reached_top = true;
+                dirname
+            });
+            if reached_top {
+                break;
+            }
+        }
+        let result = match replace {
+            Some(newdir) => {
+                let remainder = source.strip_prefix(dirname).unwrap_or(dirname);
+                if !remainder.as_os_str().is_empty() {
+                    std::path::Path::new(newdir).join(remainder)
+                } else {
+                    std::path::Path::new(newdir).to_path_buf()
+                }
+            }
+            None => dirname.to_path_buf(),
+        };
+        Value::string(result.to_string_lossy(), span)
+    }
+
+    pub fn read_entry_weights(&self, path: &std::path::Path, deref: bool) -> Result<(u64, Option<u64>), ShellError> {
+        let follow = deref || self.size_should_deref();
+        let metadata = if follow {
+            std::fs::metadata(path)
+        } else {
+            std::fs::symlink_metadata(path)
+        };
+        match metadata {
+            Ok(d) => {
+                let size = d.len();
+                let blocks = filesize::file_real_size_fast(path, &d).ok();
+                let _ = self.size_catalog_entry(path, size, blocks);
+                Ok((size, blocks))
+            }
+            Err(e) => Err(e.into()),
+        }
+    }
+
+    pub fn should_keep_sized_file(&self, path: &std::path::Path, exclude: Option<&nu_glob::Pattern>, min_size: Option<u64>, size: u64) -> bool {
+        let included = exclude.map_or(true, |pattern| !pattern.matches_path(path));
+        if !included {
+            return false;
+        }
+        let threshold = min_size.unwrap_or_else(|| self.size_threshold());
+        let _ = self.size_catalog_entry(path, size, None);
+        size >= threshold
+    }
+
+    pub fn directory_access_blocked(&self, dir: &std::path::Path) -> bool {
+        if !self.permission_should_check_read() {
+            return false;
+        }
+        let _ = self.listing_full_probe(dir);
+        match dir.read_dir() {
+            Err(e) => matches!(e.kind(), std::io::ErrorKind::PermissionDenied),
+            Ok(_) => false,
+        }
+    }
+
+    pub fn directory_has_no_entries(&self, dir: &std::path::Path) -> bool {
+        let _ = self.listing_full_probe(dir);
+        match dir.read_dir() {
+            Err(_) => true,
+            Ok(mut s) => s.next().is_none(),
+        }
+    }
+
+    pub fn path_is_hidden_entry(&self, dir: &std::path::Path) -> bool {
+        let _ = self.listing_full_probe(dir);
+        #[cfg(windows)]
+        {
+            use std::os::windows::fs::MetadataExt;
+            if let Ok(metadata) = dir.metadata() {
+                let attributes = metadata.file_attributes();
+                (attributes & 0x2) != 0
+            } else {
+                false
+            }
+        }
+        #[cfg(not(windows))]
+        {
+            dir.file_name()
+                .map(|name| name.to_string_lossy().starts_with('.'))
+                .unwrap_or(false)
+        }
+    }
+
+    pub fn path_in_hidden_ancestors(&self, path: &std::path::Path, folders: &[PathBuf]) -> bool {
+        if folders.is_empty() {
+            return false;
+        }
+        folders.iter().any(|p| path.starts_with(p.as_path()))
+    }
