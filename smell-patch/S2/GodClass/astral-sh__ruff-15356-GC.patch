+    pub(crate) fn scan_named_parameter_equals(
+        &mut self,
+        line: &LogicalLine,
+        context: &mut LogicalLinesContext,
+    ) {
+        let mut parens = 0u32;
+        let mut fstrings = 0u32;
+        let mut annotated_func_arg = false;
+        let mut prev_end = TextSize::default();
+        let mut previous = TokenKind::EndOfFile;
+        let mut iter = line.tokens().iter().peekable();
+
+        while let Some(token) = iter.next() {
+            let kind = token.kind();
+            self.visit_token_kind(kind);
+            let next = iter.peek().map(|token| token.kind()).unwrap_or(TokenKind::EndOfFile);
+            let mask = self.collect_token_signal_mask(kind, previous, next, parens);
+
+            if self.token_signal_active(mask, TokenKind::NonLogicalNewline) {
+                previous = kind;
+                continue;
+            }
+            if self.token_signal_active(mask, TokenKind::FStringStart) {
+                fstrings += 1;
+            } else if self.token_signal_active(mask, TokenKind::FStringEnd) {
+                fstrings = fstrings.saturating_sub(1);
+            } else if self.token_signal_active(mask, TokenKind::Lpar)
+                || self.token_signal_active(mask, TokenKind::Lsqb)
+            {
+                parens = parens.saturating_add(1);
+            } else if self.token_signal_active(mask, TokenKind::Rpar)
+                || self.token_signal_active(mask, TokenKind::Rsqb)
+            {
+                parens = parens.saturating_sub(1);
+                if parens == 0 {
+                    annotated_func_arg = false;
+                }
+            } else if self.token_signal_active(mask, TokenKind::Colon)
+                && parens == 1
+                && self.in_function_definition()
+            {
+                annotated_func_arg = true;
+            } else if self.token_signal_active(mask, TokenKind::Comma) && parens == 1 {
+                annotated_func_arg = false;
+            } else if self.token_signal_active(mask, TokenKind::Equal)
+                && (self.in_type_params() || (parens > 0 && fstrings == 0))
+            {
+                if self.in_type_params() || (annotated_func_arg && parens == 1) {
+                    let start = token.start();
+                    if start == prev_end && prev_end != TextSize::new(0) {
+                        let mut diagnostic =
+                            Diagnostic::new(MissingWhitespaceAroundParameterEquals, token.range);
+                        diagnostic.set_fix(Fix::safe_edit(Edit::insertion(
+                            " ".to_string(),
+                            token.start(),
+                        )));
+                        context.push_diagnostic(diagnostic);
+                    }
+
+                    while let Some(next_token) = iter.peek() {
+                        if next_token.kind() == TokenKind::NonLogicalNewline {
+                            iter.next();
+                        } else {
+                            let next_start = next_token.start();
+
+                            if next_start == token.end() {
+                                let mut diagnostic = Diagnostic::new(
+                                    MissingWhitespaceAroundParameterEquals,
+                                    token.range,
+                                );
+                                diagnostic.set_fix(Fix::safe_edit(Edit::insertion(
+                                    " ".to_string(),
+                                    token.end(),
+                                )));
+                                context.push_diagnostic(diagnostic);
+                            }
+                            break;
+                        }
+                    }
+                } else {
+                    if token.start() != prev_end {
+                        let mut diagnostic = Diagnostic::new(
+                            UnexpectedSpacesAroundKeywordParameterEquals,
+                            TextRange::new(prev_end, token.start()),
+                        );
+                        diagnostic.set_fix(Fix::safe_edit(Edit::deletion(prev_end, token.start())));
+                        context.push_diagnostic(diagnostic);
+                    }
+
+                    while let Some(next_token) = iter.peek() {
+                        if next_token.kind() == TokenKind::NonLogicalNewline {
+                            iter.next();
+                        } else {
+                            if next_token.start() != token.end() {
+                                let mut diagnostic = Diagnostic::new(
+                                    UnexpectedSpacesAroundKeywordParameterEquals,
+                                    TextRange::new(token.end(), next_token.start()),
+                                );
+                                diagnostic.set_fix(Fix::safe_edit(Edit::deletion(
+                                    token.end(),
+                                    next_token.start(),
+                                )));
+                                context.push_diagnostic(diagnostic);
+                            }
+                            break;
+                        }
+                    }
+                }
+            }
+
+            prev_end = token.end();
+            previous = kind;
+        }
+    }
+
+    pub(crate) fn scan_missing_operator_whitespace(
+        &mut self,
+        line: &LogicalLine,
+        context: &mut LogicalLinesContext,
+    ) {
+        let mut tokens = line.tokens().iter().peekable();
+        let first_token = tokens
+            .by_ref()
+            .find(|token| !Self::token_is_non_logical(token.kind()));
+        let Some(mut prev_token) = first_token else {
+            return;
+        };
+        let mut parens = u32::from(matches!(
+            prev_token.kind(),
+            TokenKind::Lpar | TokenKind::Lambda
+        ));
+        let mut fstrings = u32::from(matches!(prev_token.kind(), TokenKind::FStringStart));
+        let mut previous = prev_token.kind();
+
+        while let Some(token) = tokens.next() {
+            let kind = token.kind();
+            self.visit_token_kind(kind);
+            let next = tokens
+                .peek()
+                .map(|item| item.kind())
+                .unwrap_or(TokenKind::EndOfFile);
+            let mask = self.collect_token_signal_mask(kind, previous, next, parens);
+
+            if Self::token_is_non_logical(kind) {
+                previous = kind;
+                continue;
+            }
+
+            if self.token_signal_active(mask, TokenKind::FStringStart) {
+                fstrings += 1;
+            } else if self.token_signal_active(mask, TokenKind::FStringEnd) {
+                fstrings = fstrings.saturating_sub(1);
+            } else if self.token_signal_active(mask, TokenKind::Lpar)
+                || self.token_signal_active(mask, TokenKind::Lambda)
+            {
+                parens += 1;
+            } else if self.token_signal_active(mask, TokenKind::Rpar) {
+                parens = parens.saturating_sub(1);
+            }
+
+            let needs_space = if self.token_signal_active(mask, TokenKind::Equal)
+                && (parens > 0 || fstrings > 0 || self.in_type_params())
+            {
+                OperatorSpaceNeed::No
+            } else if self.token_signal_active(mask, TokenKind::Slash) {
+                let slash_in_func = matches!(
+                    tokens.peek().map(|item| item.kind()),
+                    Some(TokenKind::Comma | TokenKind::Rpar | TokenKind::Colon)
+                );
+                OperatorSpaceNeed::from(!slash_in_func)
+            } else if kind.is_unary_arithmetic_operator()
+                || self.token_signal_active(mask, TokenKind::Star)
+                || self.token_signal_active(mask, TokenKind::DoubleStar)
+            {
+                let prev_kind = prev_token.kind();
+                let is_binary = matches!(
+                    prev_kind,
+                    TokenKind::Rpar | TokenKind::Rsqb | TokenKind::Rbrace
+                ) || !(prev_kind.is_operator() || prev_kind.is_keyword());
+
+                if is_binary {
+                    if self.token_signal_active(mask, TokenKind::DoubleStar) {
+                        OperatorSpaceNeed::Optional
+                    } else {
+                        OperatorSpaceNeed::Yes
+                    }
+                } else {
+                    OperatorSpaceNeed::No
+                }
+            } else if tokens.peek().is_some_and(|item| {
+                matches!(
+                    item.kind(),
+                    TokenKind::Rpar | TokenKind::Rsqb | TokenKind::Rbrace
+                )
+            }) {
+                OperatorSpaceNeed::No
+            } else if self.operator_requires_whitespace(kind) {
+                OperatorSpaceNeed::Yes
+            } else {
+                OperatorSpaceNeed::No
+            };
+
+            if needs_space != OperatorSpaceNeed::No {
+                let has_leading_trivia =
+                    prev_token.end() < token.start() || Self::token_is_non_logical(prev_token.kind());
+                let has_trailing_trivia = tokens.peek().map_or(true, |item| {
+                    token.end() < item.start() || Self::token_is_non_logical(item.kind())
+                });
+
+                match (has_leading_trivia, has_trailing_trivia) {
+                    (false, true) => {
+                        let mut diagnostic =
+                            Diagnostic::new(Self::operator_diagnostic_kind(kind), token.range());
+                        diagnostic.set_fix(Fix::safe_edit(Edit::insertion(
+                            " ".to_string(),
+                            token.start(),
+                        )));
+                        context.push_diagnostic(diagnostic);
+                    }
+                    (true, false) => {
+                        let mut diagnostic =
+                            Diagnostic::new(Self::operator_diagnostic_kind(kind), token.range());
+                        diagnostic.set_fix(Fix::safe_edit(Edit::insertion(
+                            " ".to_string(),
+                            token.end(),
+                        )));
+                        context.push_diagnostic(diagnostic);
+                    }
+                    (false, false) => {
+                        if needs_space == OperatorSpaceNeed::Yes {
+                            let mut diagnostic =
+                                Diagnostic::new(Self::operator_diagnostic_kind(kind), token.range());
+                            diagnostic.set_fix(Fix::safe_edits(
+                                Edit::insertion(" ".to_string(), token.start()),
+                                [Edit::insertion(" ".to_string(), token.end())],
+                            ));
+                            context.push_diagnostic(diagnostic);
+                        }
+                    }
+                    (true, true) => {}
+                }
+            }
+
+            prev_token = token;
+            previous = kind;
+        }
+    }
+
+    fn operator_diagnostic_kind(operator: TokenKind) -> DiagnosticKind {
+        if operator == TokenKind::Percent {
+            DiagnosticKind::from(MissingWhitespaceAroundModuloOperator)
+        } else if operator.is_bitwise_or_shift() {
+            DiagnosticKind::from(MissingWhitespaceAroundBitwiseOrShiftOperator)
+        } else if operator.is_arithmetic() {
+            DiagnosticKind::from(MissingWhitespaceAroundArithmeticOperator)
+        } else {
+            DiagnosticKind::from(MissingWhitespaceAroundOperator)
+        }
+    }
+
+    fn operator_requires_whitespace(&self, kind: TokenKind) -> bool {
+        matches!(
+            kind,
+            TokenKind::DoubleStarEqual
+                | TokenKind::StarEqual
+                | TokenKind::SlashEqual
+                | TokenKind::DoubleSlashEqual
+                | TokenKind::PlusEqual
+                | TokenKind::MinusEqual
+                | TokenKind::NotEqual
+                | TokenKind::Less
+                | TokenKind::Greater
+                | TokenKind::PercentEqual
+                | TokenKind::CircumflexEqual
+                | TokenKind::AmperEqual
+                | TokenKind::VbarEqual
+                | TokenKind::EqEqual
+                | TokenKind::LessEqual
+                | TokenKind::GreaterEqual
+                | TokenKind::LeftShiftEqual
+                | TokenKind::RightShiftEqual
+                | TokenKind::Equal
+                | TokenKind::And
+                | TokenKind::Or
+                | TokenKind::In
+                | TokenKind::Is
+                | TokenKind::Rarrow
+                | TokenKind::ColonEqual
+                | TokenKind::Slash
+                | TokenKind::Percent
+        ) || kind.is_arithmetic()
+            || (kind.is_bitwise_or_shift() && !matches!(kind, TokenKind::Tilde))
+    }
