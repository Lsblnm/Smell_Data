+            let kind = token.kind();
+            self.visit_token_kind(kind);
+            let next = iter.peek().map(|token| token.kind()).unwrap_or(TokenKind::EndOfFile);
+            let mask = self.collect_token_signal_mask(kind, previous, next, brackets.len() as u32);
+
+            if self.token_signal_active(mask, TokenKind::FStringStart) {
+                fstrings += 1;
+            } else if self.token_signal_active(mask, TokenKind::FStringEnd) {
+                fstrings = fstrings.saturating_sub(1);
+            } else if self.token_signal_active(mask, TokenKind::Lsqb) && fstrings == 0 {
+                brackets.push(kind);
+            } else if self.token_signal_active(mask, TokenKind::Rsqb) && fstrings == 0 {
+                brackets.pop();
+            } else if self.token_signal_active(mask, TokenKind::Lbrace) && fstrings == 0 {
+                brackets.push(kind);
+            } else if self.token_signal_active(mask, TokenKind::Rbrace) && fstrings == 0 {
+                brackets.pop();
+            } else if self.token_signal_active(mask, TokenKind::Colon) && fstrings > 0 {
+                previous = kind;
+                continue;
+            } else if self.token_signal_active(mask, TokenKind::Comma)
+                || self.token_signal_active(mask, TokenKind::Semi)
+                || self.token_signal_active(mask, TokenKind::Colon)
+            {
+                let after = line.text_after(token);
+
+                if after
+                    .chars()
+                    .next()
+                    .is_some_and(|ch| !(char::is_whitespace(ch) || ch == '\\'))
+                {
+                    if let Some(next_token) = iter.peek() {
+                        match (kind, next_token.kind()) {
+                            (TokenKind::Colon, _)
+                                if matches!(brackets.last(), Some(TokenKind::Lsqb))
+                                    && !(self.in_type_params() && brackets.len() == 1) =>
+                            {
+                                previous = kind;
+                                continue;
+                            }
+                            (TokenKind::Comma, TokenKind::Rpar | TokenKind::Rsqb) => {
+                                previous = kind;
+                                continue;
+                            }
+                            (TokenKind::Colon, TokenKind::Equal) => {
+                                previous = kind;
+                                continue;
+                            }
+                            _ => {}
+                        }
+                    }
+
+                    let diagnostic = missing_whitespace_diagnostic(kind, token.range());
+                    let fix = Fix::safe_edit(Edit::insertion(" ".to_string(), token.end()));
+                    context.push_diagnostic(diagnostic.with_fix(fix));
+                }
+            }
+
+            previous = kind;
+        }
+    }
+}
+
+
+#[derive(Copy, Clone, Eq, PartialEq, Debug)]
+enum OperatorSpaceNeed {
+    Yes,
+    No,
+    Optional,
+}
+
+impl From<bool> for OperatorSpaceNeed {
+    fn from(value: bool) -> Self {
+        if value {
+            OperatorSpaceNeed::Yes
+        } else {
+            OperatorSpaceNeed::No
+        }
+    }
+}
