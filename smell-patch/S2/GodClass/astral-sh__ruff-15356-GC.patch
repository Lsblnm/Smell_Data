+    pub(crate) fn expand_indent_columns(line: &str, indent_width: IndentWidth) -> usize {
+        let line = line.trim_end_matches(['\n', '\r']);
+        let prefix_len = line
+            .bytes()
+            .take_while(|byte| *byte == b' ' || *byte == b'\t')
+            .count();
+        crate::rules::pycodestyle::helpers::indent_display_width(&line[..prefix_len], indent_width)
+    }
