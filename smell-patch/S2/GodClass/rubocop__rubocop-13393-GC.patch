+        def layout_facts(node)
+          return [] unless node.is_a?(::RuboCop::AST::Node)
+
+          collector = LAYOUT_FACT_METHODS[node.type]
+          return send(collector, node) if collector
+
+          layout_facts_for_unknown(node)
+        end
+
+        def layout_facts_from_child(child)
+          return [] unless child.is_a?(::RuboCop::AST::Node)
+
+          layout_facts(child)
+        end
+
+        def layout_facts_for_unknown(node)
+          facts = []
+          children = node.children
+          index = 0
+          total = children.length
+          while index < total
+            facts.concat(layout_facts_from_child(children[index]))
+            index += 1
+          end
+          facts
+        end
