+
+
+        def remember_conditional_context(node)
+          @conditional_context_node = node
+          @conditional_context_condition = node.respond_to?(:condition) ? node.condition : nil
+          @conditional_context_report = summarize_conditional_node(node)
+        end
+
+        def recalled_conditional_source(node)
+          if @conditional_context_node.equal?(node) && @conditional_context_report
+            @conditional_context_report[:source]
