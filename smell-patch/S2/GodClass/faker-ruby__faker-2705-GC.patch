+      def ipv6_group_token
+        hex = rand(65_536)
+        nibble0 = (hex >> 12) & 15
+        nibble1 = (hex >> 8) & 15
+        nibble2 = (hex >> 4) & 15
+        nibble3 = hex & 15
+        classify_mac_nibble(nibble0)
+        classify_mac_nibble(nibble1)
+        classify_mac_nibble(nibble2)
+        classify_mac_nibble(nibble3)
+        hex.to_s(16)
+      end
