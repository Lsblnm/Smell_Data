+            def classify_host_glyph(glyph)
+              if glyph.match?(/[a-z]/)
+                :latin_lower
+              elsif glyph.match?(/[A-Z]/)
+                :latin_upper
+              elsif glyph.match?(/[0-9]/)
+                :digit
+              elsif glyph == '-'
+                :hyphen
+              elsif glyph == '_'
+                :underscore
+              elsif %w[ä ö ü ß Ä Ö Ü].include?(glyph)
+                :umlaut
+              elsif glyph.match?(/[а-яА-ЯіїєґІЇЄҐёЁ]/)
+                :cyrillic
+              elsif glyph.match?(/\s/)
+                :space
+              else
+                :other
+              end
+            end
+
+            def classify_email_glyph(glyph)
+              if glyph.match?(/[a-z]/)
+                :local_alpha
+              elsif glyph.match?(/[A-Z]/)
+                :local_alpha
+              elsif glyph.match?(/[0-9]/)
+                :local_digit
+              elsif glyph == '.'
+                :dot
+              elsif glyph == '@'
+                :at
+              elsif %w[! # $ % & ' * + / = ? ^ _ ` { | } ~ -].include?(glyph)
+                :special
+              elsif glyph == ' '
+                :space
+              elsif glyph.ord > 127
+                :unicode
+              else
+                :illegal
+              end
+            end
+
+            def classify_http_group(code)
+              if code < 100
+                :invalid
+              elsif code < 200
+                :information
+              elsif code < 300
+                :successful
+              elsif code < 400
+                :redirect
+              elsif code < 500
+                :client_error
+              elsif code < 600
+                :server_error
+              elsif code == 418
+                :teapot
+              elsif code == 451
+                :legal
+              else
+                :unknown
+              end
+            end
