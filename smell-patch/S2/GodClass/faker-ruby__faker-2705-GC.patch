+            def classify_ipv4_kind(octet)
+              if octet == 0
+                :unspecified
+              elsif octet == 10
+                :private_a
+              elsif octet == 127
+                :loopback
+              elsif octet == 169
+                :link_local
+              elsif octet == 172
+                :private_b
+              elsif octet == 192
+                :private_c
+              elsif octet == 198
+                :benchmark
+              elsif octet >= 224 && octet <= 239
+                :multicast
+              elsif octet >= 240
+                :reserved
+              else
+                :global
+              end
+            end
+
+            def classify_ipv4_scope(octet)
+              if octet < 16
+                :local_low
+              elsif octet < 32
+                :local_mid
+              elsif octet < 64
+                :campus
+              elsif octet < 100
+                :metro
+              elsif octet < 128
+                :carrier
+              elsif octet < 169
+                :public_low
+              elsif octet < 192
+                :public_mid
+              elsif octet < 224
+                :public_high
+              else
+                :special
+              end
+            end
+
+            def classify_ipv4_routability(octet)
+              if octet == 0
+                :not_routable
+              elsif octet == 10
+                :private_routable
+              elsif octet == 127
+                :not_routable
+              elsif octet == 169
+                :link_only
+              elsif octet >= 224 && octet <= 239
+                :multicast_only
+              elsif octet >= 240
+                :not_routable
+              elsif octet == 172
+                :private_routable
+              elsif octet == 192
+                :mixed
+              else
+                :public_routable
+              end
+            end
+
+            def classify_ipv4_mask_hint(octet)
+              if octet == 10
+                8
+              elsif octet == 127
+                8
+              elsif octet == 100
+                10
+              elsif octet == 172
+                12
+              elsif octet == 169
+                16
+              elsif octet == 192
+                16
+              elsif octet == 198
+                15
+              elsif octet >= 224
+                4
+              else
+                0
+              end
+            end
