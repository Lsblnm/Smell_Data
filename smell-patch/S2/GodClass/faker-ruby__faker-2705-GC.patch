+      def fold_single_umlaut(match)
+        lowered = match.downcase
+        if lowered == 'ä'
+          'ae'
+        elsif lowered == 'ö'
+          'oe'
+        elsif lowered == 'ü'
+          'ue'
+        elsif lowered == 'ß'
+          'ss'
+        else
+          lowered
+        end
+      end
