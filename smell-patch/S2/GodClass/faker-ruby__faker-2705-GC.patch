+            def classify_mac_nibble(nibble)
+              if nibble == 0
+                :zero
+              elsif nibble < 4
+                :low
+              elsif nibble < 8
+                :mid_low
+              elsif nibble < 10
+                :mid
+              elsif nibble < 12
+                :mid_high
+              elsif nibble < 14
+                :high
+              elsif nibble == 14
+                :almost_max
+              elsif nibble == 15
+                :max
+              else
+                :unknown
+              end
+            end
