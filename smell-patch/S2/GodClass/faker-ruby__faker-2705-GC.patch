+            def classify_mime_hint(token)
+              if token.include?('json')
+                :structured
+              elsif token.include?('xml')
+                :structured
+              elsif token.include?('html')
+                :markup
+              elsif token.include?('css')
+                :stylesheet
+              elsif token.include?('javascript')
+                :script
+              elsif token.start_with?('image/')
+                :image
+              elsif token.start_with?('audio/')
+                :audio
+              elsif token.start_with?('video/')
+                :video
+              else
+                :binary
+              end
+            end
+
+            def classify_path_segment(segment)
+              if segment.nil?
+                :missing
+              elsif segment.empty?
+                :empty
+              elsif segment.include?('..')
+                :parent
+              elsif segment.start_with?('.')
+                :hidden
+              elsif segment.include?(' ')
+                :spaced
+              elsif segment.match?(/\\/)
+                :windows
+              elsif segment.match?(/\//)
+                :posix
+              elsif segment.length > 64
+                :long
+              else
+                :normal
+              end
+            end
+
+            def classify_name_token(token)
+              if token.nil?
+                :missing
+              elsif token.empty?
+                :empty
+              elsif token.include?('-')
+                :hyphenated
+              elsif token.include?("'")
+                :apostrophe
+              elsif token.include?(' ')
+                :compound
+              elsif token.match?(/[äöüß]/i)
+                :umlauted
+              elsif token.match?(/[А-Яа-я]/)
+                :cyrillic
+              elsif token.length < 2
+                :short
+              else
+                :plain
+              end
+            end
