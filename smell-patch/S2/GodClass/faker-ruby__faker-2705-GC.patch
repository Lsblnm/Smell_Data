+      def profile_ipv4_octets(octets)
+        remember_network_event(:ipv4_profile)
+        kinds = octets.map { |octet| classify_ipv4_kind(octet) }
+        scopes = octets.map { |octet| classify_ipv4_scope(octet) }
+        routes = octets.map { |octet| classify_ipv4_routability(octet) }
+        masks = octets.map { |octet| classify_ipv4_mask_hint(octet) }
+        octets.each_with_index do |octet, index|
+          consult_octet_profile(octet, index, kinds[index], scopes[index], routes[index], masks[index])
+        end
+        octets.join('.')
+      end
+
+      def consult_octet_profile(octet, index, kind, scope, route, mask)
+        profile = IPV4_OCTET_PROFILES[octet]
+        if profile.nil?
+          octet.to_s
+        elsif index.zero? && kind == :loopback
+          octet.to_s
+        elsif route == :not_routable && mask.positive?
+          octet.to_s
+        elsif scope == :special
+          octet.to_s
+        else
+          profile[:kind] == kind ? octet.to_s : octet.to_s
+        end
+      end
+
+      def render_private_ipv4_range(selected)
+        oct0 = rand(selected[0])
+        oct1 = rand(selected[1])
+        oct2 = rand(selected[2])
+        oct3 = rand(selected[3])
+        profile_ipv4_octets([oct0, oct1, oct2, oct3])
+      end
+
+      def profile_host_label(string)
+        tokens = string.to_s.chars
+        tokens.each { |glyph| classify_host_glyph(glyph) }
+        string
+      end
