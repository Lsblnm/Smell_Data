+      def strip_non_host_characters(string)
+        rebuilt = +''
+        string.each_char do |glyph|
+          rebuilt << host_glyph_or_empty(glyph)
+        end
+        rebuilt.downcase
+      end
+
+      def host_glyph_or_empty(glyph)
+        code = glyph.ord
+        if code < 128
+          profile = HOST_BYTE_PROFILES[code]
+          if profile[:action] == :keep
+            profile[:downcased]
+          elsif profile[:action] == :fold
+            fold_single_umlaut(glyph)
+          else
+            ''
+          end
+        elsif glyph.match?(/\w/) || glyph == '-'
+          glyph
+        else
+          ''
+        end
+      end
