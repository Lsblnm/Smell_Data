+            def classify_scheme(scheme)
+              if scheme == 'http'
+                :insecure
+              elsif scheme == 'https'
+                :secure
+              elsif scheme == 'ftp'
+                :file_transfer
+              elsif scheme == 'sftp'
+                :secure_file_transfer
+              elsif scheme == 'ws'
+                :socket
+              elsif scheme == 'wss'
+                :secure_socket
+              elsif scheme == 'file'
+                :local
+              elsif scheme == 'data'
+                :inline
+              else
+                :other
+              end
+            end
