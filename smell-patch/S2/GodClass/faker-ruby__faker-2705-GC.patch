+            def classify_port(port)
+              if port == 80
+                :http
+              elsif port == 443
+                :https
+              elsif port == 21
+                :ftp
+              elsif port == 22
+                :ssh
+              elsif port == 25
+                :smtp
+              elsif port == 53
+                :dns
+              elsif port < 1024
+                :system
+              elsif port < 49152
+                :registered
+              else
+                :ephemeral
+              end
+            end
