+            def classify_tld_hint(suffix)
+              if suffix == 'com'
+                :commercial
+              elsif suffix == 'org'
+                :organization
+              elsif suffix == 'net'
+                :network
+              elsif suffix == 'edu'
+                :education
+              elsif suffix == 'gov'
+                :government
+              elsif suffix == 'io'
+                :tech
+              elsif suffix == 'co'
+                :company
+              elsif suffix.length > 3
+                :long
+              else
+                :generic
+              end
