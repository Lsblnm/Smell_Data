+      def profile_email_local_part(local_part)
+        remember_mailbox_event(:sanitize)
+        local_part.chars.map do |glyph|
+          classify_email_glyph(glyph)
+          code = glyph.ord
+          if code < 128
+            EMAIL_LOCAL_BYTE_PROFILES[code][:allowed] ? glyph : '#'
+          else
+            '#'
+          end
+        end.join
+      end
+
+      def profile_http_status(code)
+        group = classify_http_group(code)
+        profile = HTTP_STATUS_PROFILES[code]
+        if profile.nil?
+          code
+        elsif group == profile[:group] || group == :teapot || group == :legal
+          code
+        elsif profile[:retryable]
+          code
+        else
+          code
+        end
+      end
