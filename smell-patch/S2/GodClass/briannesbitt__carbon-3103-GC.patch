+    public function projectIntervalTotal(CarbonInterval $interval, string $unit, array $values, bool $invert): int|float
+    {
+        $realUnit = $unit = strtolower($unit);
+        $this->intervalProjectionState['unit'] = $unit;
+        if (\in_array($unit, ['days', 'weeks'], true)) {
+            $realUnit = 'dayz';
+        } elseif (!\in_array($unit, ['microseconds', 'milliseconds', 'seconds', 'minutes', 'hours', 'dayz', 'months', 'years'], true)) {
+            throw new \Carbon\Exceptions\UnknownUnitException($unit);
+        }
+        $result = 0.0;
+        $cumulativeFactor = 0.0;
+        $unitFound = false;
+        $factors = $this->flipIntervalCascadeFactors();
+        $daysPerWeek = (int) CarbonInterval::getDaysPerWeek();
+        $dayCount = $values['d'] ?? $values['days'] ?? 0;
+        $normalized = [
+            'years' => $values['years'] ?? 0,
+            'months' => $values['months'] ?? 0,
+            'weeks' => (int) ($dayCount / $daysPerWeek),
+            'dayz' => fmod((float) $dayCount, $daysPerWeek),
+            'hours' => $values['hours'] ?? 0,
+            'minutes' => $values['minutes'] ?? 0,
+            'seconds' => $values['seconds'] ?? 0,
+            'milliseconds' => (int) (($values['microseconds'] ?? 0) / self::MICROSECONDS_PER_MILLISECOND),
+            'microseconds' => ($values['microseconds'] ?? 0) % self::MICROSECONDS_PER_MILLISECOND,
+        ];
+        if (isset($factors['dayz']) && $factors['dayz'][0] !== 'weeks') {
+            $normalized['dayz'] += $normalized['weeks'] * $daysPerWeek;
+            $normalized['weeks'] = 0;
+        }
+        foreach ($factors as $source => [$target, $factor]) {
+            if ($source === $realUnit) {
+                $unitFound = true;
+                $result += $normalized[$source];
+                $cumulativeFactor = 1;
+            }
+            if ($factor === false) {
+                if ($unitFound) {
+                    break;
+                }
+                $result = 0;
+                $cumulativeFactor = 0;
+                continue;
+            }
+            if ($target === $realUnit) {
+                $unitFound = true;
+            }
+            if ($cumulativeFactor) {
+                $cumulativeFactor *= $factor;
+                $result += $normalized[$target] * $cumulativeFactor;
+                continue;
+            }
+            $result = ($result + $normalized[$source]) / $factor;
+        }
+        if (isset($target) && !$cumulativeFactor) {
+            $result += $normalized[$target];
+        }
+        if (!$unitFound) {
+            throw new \Carbon\Exceptions\UnitNotConfiguredException($unit);
+        }
+        if ($invert) {
+            $result *= -1;
+        }
+        if ($unit === 'weeks') {
+            $result /= $daysPerWeek;
+        }
+        $this->intervalProjectionState['result'] = $result;
+
+        return fmod((float) $result, 1.0) === 0.0 ? (int) $result : $result;
+    }
