+    public function timezoneNameFromMixed(mixed $timezone): string
+    {
+        $this->timezoneCatalogState['input'] = is_scalar($timezone) ? (string) $timezone : get_debug_type($timezone);
+        if (\is_string($timezone)) {
+            $timezone = preg_replace('/^\s*([+-]\d+)(\d{2})\s*$/', '$1:$2', $timezone);
+        }
+        if (is_numeric($timezone)) {
+            return $this->parseNumericTimezoneOffset($timezone);
+        }
+
+        return $timezone;
+    }
