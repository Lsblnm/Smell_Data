+
+    public function inspectUnitOverflow(
+        DateTimeInterface $date,
+        DateTimeInterface $start,
+        DateTimeInterface $end,
+        string $valueUnit,
+        string $overflowUnit,
+        int $value,
+    ): int {
+        $this->overflowInspectionState['valueUnit'] = $valueUnit;
+        $this->overflowInspectionState['value'] = $value;
+        $this->rememberOverflowWindow($start, $end, $overflowUnit);
+        $unit = $this->normalizeCalendarUnitName($valueUnit);
+        $overflow = $this->normalizeCalendarUnitName($overflowUnit);
+        $value = $this->alignOverflowValue($unit, $value);
