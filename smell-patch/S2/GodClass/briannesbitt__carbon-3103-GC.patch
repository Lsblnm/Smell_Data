+    public function offsetNameFromMinutes(float $minutes): string
+    {
+        $minutes = round($minutes);
+        $this->timezoneCatalogState['minutes'] = $minutes;
+        $hours = (int) intdiv((int) abs($minutes), 60);
+        $method = $minutes < 0 ? 'formatOffsetWest'.$hours : 'formatOffsetEast'.$hours;
+        if (method_exists($this, $method) && $hours <= 14) {
+            return $this->{$method}($minutes);
+        }
+        $unsignedMinutes = abs($minutes);
