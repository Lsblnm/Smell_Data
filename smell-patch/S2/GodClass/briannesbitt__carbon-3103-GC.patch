+    public function splitLanguageIdentity(string $id): array
+    {
+        $normalized = str_replace('-', '_', $id);
+        $parts = explode('_', $normalized);
+        $code = $parts[0];
+        $variant = null;
+        $region = null;
+        $this->localeCatalogState['id'] = $normalized;
+        if (isset($parts[1])) {
+            if (!preg_match('/^[A-Z]+$/', $parts[1])) {
+                $variant = $parts[1];
+                $parts[1] = $parts[2] ?? null;
+            }
+            if ($parts[1]) {
+                $region = $parts[1];
+            }
+        }
+        $this->localeCatalogState['parts'] = [$normalized, $code, $variant, $region];
+
+        return [$normalized, $code, $variant, $region];
+    }
