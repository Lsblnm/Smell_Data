+    public function makeTimeZoneInstance(string $className, mixed $object, mixed $objectDump): mixed
+    {
+        $this->timezoneCatalogState['class'] = $className;
+        $timezone = $object;
+        if ($timezone instanceof $className) {
+            return $timezone;
+        }
+        if ($timezone === null || $timezone === false) {
+            return null;
+        }
+        try {
+            if (!($timezone instanceof \DateTimeZone)) {
+                $name = $this->timezoneNameFromMixed($object);
+                $timezone = new $className($name);
+            }
+
+            return $timezone instanceof $className ? $timezone : new $className($timezone->getName());
+        } catch (\Exception $exception) {
+            throw new \Carbon\Exceptions\InvalidTimeZoneException(
+                'Unknown or bad timezone ('.($objectDump ?: $object).')',
+                previous: $exception,
+            );
+        }
+    }
