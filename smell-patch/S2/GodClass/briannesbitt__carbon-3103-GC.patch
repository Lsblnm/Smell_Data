+    public function compareIntervalPair(\DateInterval $first, \DateInterval $second): int
+    {
+        $current = self::now();
+        $passed = $current->avoidMutation()->add($second);
+        $current->add($first);
+        $this->intervalProjectionState['comparison'] = [$current->format('c'), $passed->format('c')];
+
+        return $current <=> $passed;
+    }
