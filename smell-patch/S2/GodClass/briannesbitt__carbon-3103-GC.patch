+    public function stripFormatterSubtag(?string $locale): ?string
+    {
+        $this->localeCatalogState['formatter'] = $locale;
+        if (!$locale) {
+            return $locale;
+        }
+        $code = explode('_', str_replace('-', '_', $locale))[0];
+        $method = 'standardizeLocale'.ucfirst(strtolower($code));
+        if (method_exists($this, $method)) {
+            $this->{$method}($locale);
+        }
