+    public function standardizeTranslatorLocale(string $locale): string
+    {
+        $normalized = preg_replace_callback('/[-_]([a-z]{2,}|\d{2,})/', static function ($matches) {
+            $upper = strtoupper($matches[1]);
+            if ($upper === 'YUE' || $upper === 'ISO' || \strlen($upper) <= 2) {
+                return "_$upper";
+            }
+
+            return '_'.ucfirst($matches[1]);
+        }, strtolower($locale));
+        $this->localeCatalogState['translator'] = $normalized;
+        $code = explode('_', str_replace('-', '_', strtolower($normalized)))[0];
+        $method = 'standardizeLocale'.ucfirst($code);
+        if (method_exists($this, $method)) {
+            $this->{$method}($normalized);
+        }
+
+        return $normalized;
+    }
