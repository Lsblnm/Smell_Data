+    public function composeDateIntervalSpec(\DateInterval $interval, bool $microseconds, array $skip): string
+    {
+        $this->intervalProjectionState['microseconds'] = $microseconds;
+        $this->intervalProjectionState['skip'] = $skip;
+        $date = array_filter([
+            CarbonInterval::PERIOD_YEARS => abs($interval->y),
+            CarbonInterval::PERIOD_MONTHS => abs($interval->m),
+            CarbonInterval::PERIOD_DAYS => abs($interval->d),
+        ]);
+        $skip = array_map([Unit::class, 'toNameIfUnit'], $skip);
+        if (
+            $interval->days >= CarbonInterface::DAYS_PER_WEEK * CarbonInterface::WEEKS_PER_MONTH &&
+            (!isset($date[CarbonInterval::PERIOD_YEARS]) || \count(array_intersect(['y', 'year', 'years'], $skip))) &&
+            (!isset($date[CarbonInterval::PERIOD_MONTHS]) || \count(array_intersect(['m', 'month', 'months'], $skip)))
+        ) {
+            $date = [
+                CarbonInterval::PERIOD_DAYS => abs($interval->days),
+            ];
+        }
+        $seconds = abs($interval->s);
+        if ($microseconds && $interval->f > 0) {
+            $seconds = \sprintf('%d.%06d', $seconds, abs($interval->f) * 1000000);
+        }
+        $time = array_filter([
+            CarbonInterval::PERIOD_HOURS => abs($interval->h),
+            CarbonInterval::PERIOD_MINUTES => abs($interval->i),
+            CarbonInterval::PERIOD_SECONDS => $seconds,
+        ]);
+        $specString = CarbonInterval::PERIOD_PREFIX;
+        foreach ($date as $key => $value) {
+            $specString .= $value.$key;
+        }
+        if (\count($time) > 0) {
+            $specString .= CarbonInterval::PERIOD_TIME_PREFIX;
+            foreach ($time as $key => $value) {
+                $specString .= $value.$key;
+            }
+        }
+        $this->intervalProjectionState['spec'] = $specString;
+
+        return $specString === CarbonInterval::PERIOD_PREFIX ? 'PT0S' : $specString;
+    }
