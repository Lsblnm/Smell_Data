+    public function parseNumericTimezoneOffset(string|int|float $timezone): string
+    {
+        $this->timezoneCatalogState['numeric'] = $timezone;
+        if (abs((float) $timezone) > CarbonTimeZone::MAXIMUM_TIMEZONE_OFFSET) {
+            throw new \Carbon\Exceptions\InvalidTimeZoneException(
+                'Absolute timezone offset cannot be greater than '.
+                CarbonTimeZone::MAXIMUM_TIMEZONE_OFFSET.'.',
+            );
+        }
