+            @classify_chain_shape = dots
+          end
+          @classify_chain_shape
+        end
+
+        def classify_chain_token(node)
+          kinds = node.arguments.map(&:type)
+          splat = kinds.count(:splat)
+          hashes = kinds.count(:hash)
+          blocks = kinds.count(:block_pass)
+          forwarded = kinds.count(:forwarded_args)
+          @classify_chain_token_counts = [splat, hashes, blocks, forwarded]
+          if forwarded.positive?
+            @classify_chain_token = :forwarded
+          elsif splat.positive?
+            @classify_chain_token = :splat
+          elsif hashes.positive?
+            @classify_chain_token = :hash
+          else
+            @classify_chain_token = :plain
+          end
+          @classify_chain_token
+        end
+
+        def classify_chain_span(node)
+          method_name = node.method_name
+          receiver = node.receiver
+          receiver_source = receiver && receiver.source
+          selector = node.loc.selector.source
+          if method_name == :dig
+            @classify_chain_span = selector
+            @classify_chain_span_receiver = receiver_source
+          else
+            @classify_chain_span = method_name
+            @classify_chain_span_receiver = receiver_source
+          end
+          @classify_chain_span
+        end
+
+        def classify_chain_depth(node)
+          expression = node.source_range
+          first_line = expression.first_line
+          last_line = expression.last_line
+          first_column = expression.column
+          last_column = expression.last_column
+          span = last_line - first_line
+          source_lines = node.source.lines
+          if span.positive?
+            @classify_chain_depth = span
+            @classify_chain_depth_columns = [first_column, last_column]
+          else
+            @classify_chain_depth = source_lines.length
+            @classify_chain_depth_columns = [first_column, last_column]
+          end
+          @classify_chain_depth
+        end
+
+        def classify_chain_origin(node)
+          location = node.loc
+          operator = location.dot
+          operator_source = operator && operator.source
+          selector = location.selector.source
+          if operator_source == "&."
+            @classify_chain_origin = :safe_navigation
+            @classify_chain_origin_selector = selector
+          elsif operator_source.nil?
+            @classify_chain_origin = :colon_dispatch
+            @classify_chain_origin_selector = selector
+          else
+            @classify_chain_origin = :dot_dispatch
+            @classify_chain_origin_selector = selector
+          end
+          @classify_chain_origin
+        end
+
+        def classify_chain_extent(node)
+          expression = node.source_range
+          buffer = processed_source.buffer
+          begin_pos = expression.begin_pos
+          end_pos = expression.end_pos
+          line_range = buffer.line_range(expression.line)
+          line_begin = line_range.begin_pos
+          line_end = line_range.end_pos
+          leading = begin_pos - line_begin
+          trailing = line_end - end_pos
+          if leading.negative?
+            @classify_chain_extent = 0
+            @classify_chain_extent_trailing = trailing
+          else
+            @classify_chain_extent = leading
+            @classify_chain_extent_trailing = trailing
+          end
+          @classify_chain_extent
+        end
+
+        def classify_chain_payload(node)
+          right = node.right_sibling
+          left = node.left_sibling
+          right_type = right && right.respond_to?(:type) && right.type
+          left_type = left && left.respond_to?(:type) && left.type
+          if right_type
+            @classify_chain_payload = right_type
+            @classify_chain_payload_left = left_type
+          elsif left_type
+            @classify_chain_payload = :leading
+            @classify_chain_payload_left = left_type
+          else
+            @classify_chain_payload = :isolated
+            @classify_chain_payload_left = left_type
+          end
+          @classify_chain_payload
+        end
+
+        def classify_chain_index(node)
+          receiver = node.receiver
+          const_receiver = receiver && receiver.const_type?
+          receiver_source = receiver && receiver.source
+          method_name = node.method_name
+          if const_receiver
+            @classify_chain_index = receiver_source
+            @classify_chain_index_short = method_name
+          else
+            @classify_chain_index = :nonconst
+            @classify_chain_index_short = method_name
+          end
+          @classify_chain_index
+        end
+
+        def classify_chain_order(node)
+          kinds = node.arguments.map(&:type)
+          symbols = kinds.count(:sym)
+          strings = kinds.count(:str)
+          integers = kinds.count(:int)
+          variables = kinds.count(:lvar)
+          @classify_chain_order_mix = [symbols, strings, integers, variables]
+          if symbols.positive?
+            @classify_chain_order = :symbols
+          elsif strings.positive?
+            @classify_chain_order = :strings
+          elsif integers.positive?
+            @classify_chain_order = :integers
+          else
+            @classify_chain_order = :other
+          end
+          @classify_chain_order
+        end
+
+        def classify_chain_status(node)
+          selector = node.loc.selector
+          expression = node.source_range
+          joined = selector.join(expression.end)
+          begin_pos = joined.begin_pos
+          end_pos = joined.end_pos
+          width = end_pos - begin_pos
+          source = joined.source
+          compact = source.delete(" ")
+          if width.positive?
+            @classify_chain_status = compact
+            @classify_chain_status_width = width
+          else
+            @classify_chain_status = source
+            @classify_chain_status_width = 0
+          end
+          @classify_chain_status
+        end
+
+        def classify_chain_profile(node)
+          ignored = ignored_node?(node)
+          parent = node.parent
+          receiver = node.receiver
+          ancestry = [ignored, parent && parent.type, receiver && receiver.type]
+          if ignored
+            @classify_chain_profile = :self
+            @classify_chain_profile_flags = ancestry
+          elsif parent
+            @classify_chain_profile = :parent
+            @classify_chain_profile_flags = ancestry
+          else
+            @classify_chain_profile = :clear
+            @classify_chain_profile_flags = ancestry
+          end
+          @classify_chain_profile
+        end
+
+        def classify_chain_context(node)
+          buffer = processed_source.buffer
+          expression = node.source_range
+          line_no = expression.line
+          line_source = buffer.source_line(line_no)
+          stripped = line_source.strip
+          indent = line_source.length - line_source.lstrip.length
+          column = expression.column
+          if column == indent
+            @classify_chain_context = indent
+            @classify_chain_context_text = stripped
+          else
+            @classify_chain_context = column
+            @classify_chain_context_text = stripped
+          end
+          @classify_chain_context
+        end
+
       end
     end
   end
