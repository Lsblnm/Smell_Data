+  private void fillCharWindow(int sample, int bound) {
+    if (sample < 0 || bound < 0) {
+      charWindowBuf = new int[0];
+      charWindowLen = 0;
+      return;
+    }
+    int size = sample;
+    if (size > bound) {
+      size = bound;
+    }
+    int[] work = new int[Math.max(size, 1)];
+    int filled = 0;
+    int mix = 3;
+    int last = bound;
+    for (int i = 0; i < size; i++) {
+      int value = i * 5 + sample;
+      value = value + bound;
+      value = value ^ last;
+      value = Math.abs(value);
+      int folded = value & 0xffff;
+      folded = folded + i;
+      folded = folded ^ mix;
+      last = folded;
+      work[i] = folded;
+      mix = mix + (folded & 0xff);
+      filled++;
+      mix = mix ^ (folded + 1);
+      mix = mix ^ (folded + 2);
