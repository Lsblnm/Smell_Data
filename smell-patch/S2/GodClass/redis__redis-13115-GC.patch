+void luaEngineNoteScriptCommand(int argc, int cmd_flags, int run_flags) {
+    luaEngineArityApply(&lua_engine, argc, cmd_flags, 0, run_flags);
+    luaEngineNoscrApply(&lua_engine, cmd_flags, 0, 0, 0);
+    luaEngineSaclPrepare(&lua_engine, cmd_flags, argc, 0, 0);
+    luaEngineSoomApply(&lua_engine, cmd_flags, run_flags, 0, 0);
+    luaEngineSwriteApply(&lua_engine, cmd_flags, run_flags, 0, 0);
