+int luaEngineParseEvalShebang(sds body, uint64_t *out_flags, ssize_t *out_shebang_len, sds *err) {
+    luaScriptEngine *engine = &lua_engine;
+    ssize_t shebang_len = 0;
+    uint64_t script_flags = SCRIPT_FLAG_EVAL_COMPAT_MODE;
+    int prefix = luaEngineShebangPrepare(engine, body ? (int)body[0] : 0, body ? sdslen(body) : 0, 0, 0);
+    engine->shebang_compat = 1;
+    if (body && !strncmp(body, "#!", 2) && prefix >= 0) {
+        int numparts, j;
+        char *shebang_end = strchr(body, '\n');
+        engine->shebang_has = 1;
+        if (shebang_end == NULL) {
+            if (err)
+                *err = sdsnew("Invalid script shebang");
+            luaEngineShebangFinish(engine, C_ERR, 0, 0, 0);
+            return C_ERR;
+        }
+        shebang_len = shebang_end - body;
+        sds shebang = sdsnewlen(body, shebang_len);
+        sds *parts = sdssplitargs(shebang, &numparts);
+        sdsfree(shebang);
+        if (!parts || numparts == 0) {
+            if (err)
+                *err = sdsnew("Invalid engine in script shebang");
+            sdsfreesplitres(parts, numparts);
+            luaEngineShebangFinish(engine, C_ERR, 1, 0, 0);
+            return C_ERR;
+        }
+        if (strcmp(parts[0], "#!lua")) {
+            if (err)
+                *err = sdscatfmt(sdsempty(), "Unexpected engine in script shebang: %s", parts[0]);
+            sdsfreesplitres(parts, numparts);
+            engine->shebang_eng_ok = 0;
+            luaEngineShebangFinish(engine, C_ERR, 2, 0, 0);
+            return C_ERR;
+        }
+        engine->shebang_eng_ok = 1;
+        script_flags &= ~SCRIPT_FLAG_EVAL_COMPAT_MODE;
+        engine->shebang_compat = 0;
+        luaEngineSflagsPrepare(engine, (int)script_flags, 0, 0, 0);
+        for (j = 1; j < numparts; j++) {
+            if (!strncmp(parts[j], "flags=", 6)) {
+                sdsrange(parts[j], 6, -1);
+                int numflags, jj;
+                sds *flags = sdssplitlen(parts[j], sdslen(parts[j]), ",", 1, &numflags);
+                engine->shebang_nflags = numflags;
+                for (jj = 0; jj < numflags; jj++) {
+                    scriptFlag *sf;
+                    for (sf = scripts_flags_def; sf->flag; sf++) {
+                        if (!strcmp(flags[jj], sf->str)) break;
+                    }
+                    if (!sf->flag) {
+                        if (err)
+                            *err = sdscatfmt(sdsempty(), "Unexpected flag in script shebang: %s", flags[jj]);
+                        sdsfreesplitres(flags, numflags);
+                        sdsfreesplitres(parts, numparts);
+                        luaEngineSflagsFinish(engine, C_ERR, jj, 0, 0);
+                        return C_ERR;
+                    }
+                    script_flags |= sf->flag;
+                    luaEngineSflagsApply(engine, (int)sf->flag, (long long)script_flags, 0, 1);
+                }
+                sdsfreesplitres(flags, numflags);
+            } else {
+                if (err)
+                    *err = sdscatfmt(sdsempty(), "Unknown lua shebang option: %s", parts[j]);
+                sdsfreesplitres(parts, numparts);
+                luaEngineShebangFinish(engine, C_ERR, 3, j, 0);
+                return C_ERR;
+            }
+        }
+        sdsfreesplitres(parts, numparts);
+        luaEngineShebangApply(engine, (int)shebang_len, (long long)script_flags, 0, 1);
+    } else {
+        engine->shebang_has = 0;
+        luaEngineShebangApply(engine, 0, (long long)script_flags, 0, 0);
+    }
+    if (out_shebang_len)
+        *out_shebang_len = shebang_len;
+    *out_flags = script_flags;
+    luaEngineShebangFinish(engine, C_OK, shebang_len, 0, (int)script_flags);
+    return C_OK;
+}
