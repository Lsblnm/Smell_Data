+int luaEngineMapReplyToken(const char *proto, size_t proto_len, int type, size_t len) {
+    luaScriptEngine *engine = &lua_engine;
+    int ch = (proto && proto_len > 0) ? (unsigned char)proto[0] : 0;
+    luaEngineCrprotoPrepare(engine, ch, (long long)proto_len, 0, type);
+    luaEngineCrtypePrepare(engine, type, (long long)len, 0, ch);
+    luaEngineCrlenPrepare(engine, (int)len, (long long)type, 0, 0);
+    if (ch == '*' || ch == '~')
+        luaEngineProtoaPrepare(engine, type, (long long)len, 0, ch);
+    else if (ch == '$')
+        luaEngineProtobPrepare(engine, type, (long long)len, 0, ch);
+    else if (ch == ':')
+        luaEngineProtoiPrepare(engine, type, (long long)len, 0, ch);
+    else if (ch == '%' || ch == '|')
+        luaEngineProtomPrepare(engine, type, (long long)len, 0, ch);
+    else
+        luaEngineProtoxPrepare(engine, type, (long long)len, 0, ch);
+    luaEngineCrtypeFinish(engine, C_OK, type, 0, (int)len);
+    return type;
