+static int luaEngineInspectLuaType(luaScriptEngine *engine, lua_State *lua, int idx) {
+    int t = lua_type(lua, idx);
+    luaEngineStackgPrepare(engine, t, lua_gettop(lua), 0, idx);
+    if (t == LUA_TNUMBER) {
+        luaEngineNumcvPrepare(engine, t, 0, lua_tonumber(lua, idx), 0);
+    } else if (t == LUA_TSTRING) {
+        size_t len = 0;
+        lua_tolstring(lua, idx, &len);
+        luaEngineStrcvPrepare(engine, t, (long long)len, 0, 0);
+    } else if (t == LUA_TTABLE) {
+        luaEngineErrtabPrepare(engine, t, 0, 0, 0);
+    } else if (t == LUA_TBOOLEAN) {
+        luaEngineProtoxApply(engine, t, lua_toboolean(lua, idx), 0, 0);
+    } else {
+        luaEngineStackgApply(engine, t, lua_gettop(lua), 0, idx);
+    }
+    return t;
+}
