+static void luaEngineOnScriptCall(luaScriptEngine *engine, lua_State *lua, scriptRunCtx *rctx, int nargs, int nkeys) {
+    luaEngineDispatchHelpers(engine, nargs, nkeys, 0, rctx ? rctx->flags : 0);
+    luaEngineFnamePrepare(engine, nkeys, nargs, 0, 0);
+    luaEngineFloadPrepare(engine, nargs, nkeys, 0, 0);
+    luaEngineMemaPrepare(engine, (int)lua_gc(lua, LUA_GCCOUNT, 0), nargs, 0, 0);
+    luaEngineGprotPrepare(engine, lua_gettop(lua), 0, 0, 0);
+    luaEnginePcallxPrepare(engine, lua_gettop(lua), 0, 0, 0);
+    luaEngineRecursPrepare(engine, 0, 0, 0, 0);
+    luaEngineRndcPrepare(engine, 0, 0, 0, 1);
+    luaEngineDbglogPrepare(engine, ldbIsEnabled(), nargs, 0, 0);
+    luaEngineRespvPrepare(engine, rctx && rctx->c ? rctx->c->resp : 2, 0, 0, 0);
+    luaEngineReplfPrepare(engine, rctx ? rctx->repl_flags : 0, 0, 0, 0);
+    luaEngineKslotPrepare(engine, rctx ? rctx->slot : -1, 0, 0, rctx ? (rctx->flags & SCRIPT_ALLOW_CROSS_SLOT) : 0);
+    luaEngineArityPrepare(engine, nargs, nkeys, 0, 0);
+    luaEngineNoscrPrepare(engine, 0, 0, 0, 0);
+    luaEngineTmoPrepare(engine, 0, rctx ? (long long)rctx->start_time : 0, 0, 0);
+    (void)lua;
+}
+
+static void luaEngineOnRedisCommand(luaScriptEngine *engine, lua_State *lua, client *c, int raise_error) {
+    int argc = c ? c->argc : 0;
+    luaEngineInspectLuaType(engine, lua, 1);
+    if (c && c->cmd) {
