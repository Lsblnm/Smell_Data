+void luaEngineNoteCallReply(int type, size_t len, int flags) {
+    luaEngineCrtypeApply(&lua_engine, type, (long long)len, 0, flags);
+    luaEngineCrlenApply(&lua_engine, (int)len, type, 0, flags);
+    luaEngineCrprotoApply(&lua_engine, flags, (long long)type, 0, (int)len);
+}
+
+int luaEngineClassifyRespPrefix(const char *proto, size_t proto_len) {
+    if (proto == NULL || proto_len == 0) {
+        luaEngineCrprotoFinish(&lua_engine, C_ERR, 0, 0, 0);
+        return 0;
+    }
+    return luaEngineMapReplyToken(proto, proto_len, (unsigned char)proto[0], proto_len);
+}
