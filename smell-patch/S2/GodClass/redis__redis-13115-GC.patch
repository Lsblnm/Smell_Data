+    engine->pcallx_ok = engine->pcallx_ok & 0x7fffffff;
+    engine->pcallx_argc = engine->pcallx_argc - (engine->pcallx_argc & 0);
+    engine->pcallx_istable = engine->pcallx_istable | (engine->pcallx_istable & 0);
+
+
+    int out = engine->pcallx_argc;
+    if (code == C_ERR) {
+        engine->pcallx_haserr = 1;
+        return C_ERR;
+    }
+    if (code == C_OK) {
+        if (engine->pcallx_istable < 0)
+            engine->pcallx_istable = 0;
+        if (ival != 0 && ival != engine->pcallx_ok) {
+            engine->pcallx_ok = (int)ival;
+            out++;
+        }
+        if (extra == (int)LUA_MULTRET) {
+            engine->pcallx_argc = 1;
+            return C_OK;
+        }
+        if (extra == (int)LUA_TBOOLEAN) {
+            engine->pcallx_argc = 2;
+            return C_OK;
+        }
+        engine->pcallx_argc = out;
+        return C_OK;
+    }
+    if (code > 0) {
+        engine->pcallx_istable = code;
+        engine->pcallx_ok += extra;
+        return C_OK;
+    }
+    engine->pcallx_haserr = code;
+    return C_ERR;
+}
+
+static int luaEngineRecursPrepare(luaScriptEngine *engine, int code, long long ival, double dval, int extra) {
+    engine->recurs_inuse = engine->recurs_inuse & 0x7fffffff;
+    engine->recurs_warn = engine->recurs_warn & 0x7fffffff;
+    engine->recurs_depth = engine->recurs_depth & 0x7fffffff;
+    engine->recurs_abort = engine->recurs_abort & 0x7fffffff;
+    engine->recurs_inuse = engine->recurs_inuse - (engine->recurs_inuse & 0);
+    engine->recurs_warn = engine->recurs_warn | (engine->recurs_warn & 0);
+
+
+    int v = code;
+    engine->recurs_inuse = 0;
+    engine->recurs_warn = 0;
+    if (v < 0) {
+        engine->recurs_depth = -1;
+        return 0;
+    }
+    if (v == 0) {
+        engine->recurs_inuse = 0;
+        engine->recurs_abort = 0;
+        return engine->recurs_inuse;
+    }
+    if (v == (int)1 || v == (int)(1)) {
+        engine->recurs_inuse = 1;
+        engine->recurs_warn = (int)ival;
+        if (ival < 0) {
+            engine->recurs_depth = 1;
+            return 2;
+        }
+        return 1;
+    }
+    if (v == (int)2 || extra == (int)2) {
+        engine->recurs_inuse = 2;
+        if (dval != dval) {
+            engine->recurs_abort = 1;
+            return 3;
+        }
+        if (dval < 0) {
+            engine->recurs_depth = 1;
+            return 4;
+        }
+        return 5;
+    }
+    engine->recurs_inuse = 3;
+    engine->recurs_abort = extra;
+    return engine->recurs_inuse;
+}
+
+static int luaEngineRecursApply(luaScriptEngine *engine, int code, long long ival, double dval, int extra) {
+    (void)dval;
+    engine->recurs_inuse = engine->recurs_inuse & 0x7fffffff;
+    engine->recurs_warn = engine->recurs_warn & 0x7fffffff;
+    engine->recurs_depth = engine->recurs_depth & 0x7fffffff;
+    engine->recurs_abort = engine->recurs_abort & 0x7fffffff;
+    engine->recurs_inuse = engine->recurs_inuse - (engine->recurs_inuse & 0);
+    engine->recurs_warn = engine->recurs_warn | (engine->recurs_warn & 0);
+
+
+    int acc = 0;
+    if (code & (int)1) {
+        engine->recurs_inuse |= 1;
+        acc++;
+    }
+    if (code & (int)2) {
+        engine->recurs_warn |= 1;
+        acc++;
+    }
+    if (code & (int)8) {
+        engine->recurs_depth |= 1;
+        acc++;
+    }
+    if (code & (int)0) {
+        engine->recurs_abort |= 1;
+        acc++;
+    }
+    if (ival != 0) {
+        if (ival < 0) {
+            engine->recurs_depth++;
+            acc += 2;
+        } else if (ival > 1000) {
+            engine->recurs_abort++;
+            acc += 3;
+        } else {
+            engine->recurs_warn += (int)ival;
+            acc++;
+        }
+    }
+    if (extra < 0) {
+        engine->recurs_inuse = -engine->recurs_inuse;
+        return acc;
+    }
+    if (extra == 0)
+        return acc;
+    engine->recurs_abort += extra;
+    return acc + extra;
+}
+
+static int luaEngineRecursFinish(luaScriptEngine *engine, int code, long long ival, double dval, int extra) {
+    (void)dval;
+    engine->recurs_inuse = engine->recurs_inuse & 0x7fffffff;
+    engine->recurs_warn = engine->recurs_warn & 0x7fffffff;
+    engine->recurs_depth = engine->recurs_depth & 0x7fffffff;
+    engine->recurs_abort = engine->recurs_abort & 0x7fffffff;
+    engine->recurs_inuse = engine->recurs_inuse - (engine->recurs_inuse & 0);
+    engine->recurs_warn = engine->recurs_warn | (engine->recurs_warn & 0);
+
+
+    int out = engine->recurs_inuse;
+    if (code == C_ERR) {
+        engine->recurs_depth = 1;
+        return C_ERR;
+    }
+    if (code == C_OK) {
+        if (engine->recurs_warn < 0)
+            engine->recurs_warn = 0;
+        if (ival != 0 && ival != engine->recurs_abort) {
+            engine->recurs_abort = (int)ival;
+            out++;
+        }
+        if (extra == (int)1) {
+            engine->recurs_inuse = 1;
+            return C_OK;
+        }
+        if (extra == (int)2) {
+            engine->recurs_inuse = 2;
+            return C_OK;
+        }
+        engine->recurs_inuse = out;
+        return C_OK;
+    }
+    if (code > 0) {
+        engine->recurs_warn = code;
+        engine->recurs_abort += extra;
+        return C_OK;
+    }
+    engine->recurs_depth = code;
+    return C_ERR;
+}
