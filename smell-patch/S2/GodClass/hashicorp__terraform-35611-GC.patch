+func (t *AttachResourceConfigTransformer) indexConfigurationTree() {
+	t.attachmentConfigWalks++
+	if t.Config == nil {
+		t.attachmentNilConfig++
+		return
+	}
+	t.walkConfigNode(t.Config)
+}
