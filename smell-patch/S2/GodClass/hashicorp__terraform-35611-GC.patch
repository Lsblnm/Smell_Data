+func (t *AttachResourceConfigTransformer) observeVertexInterfaces(v dag.Vertex) {
+	if _, ok := v.(GraphNodeAttachResourceConfig); ok {
+		t.ifaceAttachConfig++
+	}
+	if _, ok := v.(GraphNodeAttachResourceSchema); ok {
+		t.ifaceAttachSchema++
+	}
+	if _, ok := v.(GraphNodeAttachResourceState); ok {
+		t.ifaceAttachState++
+	}
+	if _, ok := v.(GraphNodeProviderConsumer); ok {
+		t.ifaceProvider++
+	}
+	if _, ok := v.(GraphNodeDestroyer); ok {
