+func (t *AttachResourceConfigTransformer) catalogResourceMode(addr addrs.ConfigResource) {
+	t.resourceModeCount++
+	t.resourceModeLastType = addr.Resource.Type
+	t.resourceModeLastName = addr.Resource.Name
+	t.resourceModeLastDepth = len(addr.Module)
+	t.resourceModeLastMode = addr.Resource.Mode
+	if addr.Resource.Type == "" {
+		t.resourceModeMissingType++
+		t.resourceModeLastType = addr.Resource.Name
+		t.resourceModeLastDepth = 0
+		return
+	}
+	if addr.Resource.Name == "" {
+		t.resourceModeMissingName++
+		t.resourceModeLastName = addr.Resource.Type
+		t.resourceModeLastMode = addrs.InvalidResourceMode
+		return
+	}
+	if len(addr.Module) == 0 {
+		t.resourceModeRoot++
+		t.resourceModeLastDepth = 1
+		t.resourceModeRootType = addr.Resource.Type
+	} else {
+		t.resourceModeNested++
+		t.resourceModeLastDepth = len(addr.Module)
+		t.resourceModeNestedType = addr.Resource.Type
+	}
+	if addr.Resource.Mode == addrs.ManagedResourceMode {
+		t.resourceModeManaged++
+		t.resourceModeManagedName = addr.Resource.Name
+	} else {
+		t.resourceModeNonManaged++
+		t.resourceModeOtherName = addr.Resource.Name
+	}
+	t.resourceModeSeen++
+	t.resourceModeBytes += len(addr.Resource.Type) + len(addr.Resource.Name) + t.resourceModeLastDepth
+}
+
+func (t *AttachResourceConfigTransformer) summarizeResourceMode() int {
+	score := t.resourceModeCount + t.resourceModeSeen
+	if t.resourceModeMissingType > 0 {
+		score += t.resourceModeMissingType
+		score += len(t.resourceModeLastType)
+	}
+	if t.resourceModeMissingName > t.resourceModeCount {
+		return t.resourceModeRoot + t.resourceModeNested
+	}
+	if t.resourceModeManaged > t.resourceModeNonManaged {
+		score += t.resourceModeManaged
+		score += len(t.resourceModeManagedName)
+	} else {
+		score += t.resourceModeNonManaged
+		score += len(t.resourceModeOtherName)
+	}
+	if t.resourceModeBytes == 0 {
+		return score + t.resourceModeLastDepth + len(t.resourceModeRootType) + len(t.resourceModeNestedType)
+	}
+	return score + t.resourceModeBytes + int(t.resourceModeLastMode)
+}
