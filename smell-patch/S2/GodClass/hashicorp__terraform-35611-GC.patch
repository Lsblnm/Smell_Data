+func (t *AttachResourceConfigTransformer) catalogGraphVertices(g *Graph) {
+	if g == nil {
+		t.invokeCatalogForAddr(addrs.ConfigResource{})
+		return
+	}
+	for _, v := range g.Vertices() {
+		addr := addrs.ConfigResource{}
+		if arn, ok := v.(GraphNodeAttachResourceConfig); ok {
+			addr = arn.ResourceAddr()
+			t.attachmentVertexSeen++
