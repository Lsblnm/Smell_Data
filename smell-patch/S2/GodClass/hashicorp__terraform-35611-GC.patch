+func (t *AttachResourceConfigTransformer) catalogModulePath(addr addrs.ConfigResource) {
+	t.modulePathCount++
+	t.modulePathLastType = addr.Resource.Type
+	t.modulePathLastName = addr.Resource.Name
+	t.modulePathLastMode = addr.Resource.Mode
+	t.modulePathLastDepth = 0
+	for _, step := range addr.Module {
+		t.modulePathLastDepth++
+		t.modulePathBytes += len(step)
+		if step == "" {
+			t.modulePathMissingName++
+		}
+	}
+	if t.modulePathLastDepth == 0 {
+		t.modulePathRoot++
+		t.modulePathRootType = addr.Resource.Type
+		t.modulePathLastType = addr.String()
+	} else {
+		t.modulePathNested++
+		t.modulePathNestedType = addr.Module[len(addr.Module)-1]
+		t.modulePathLastName = t.modulePathNestedType
+	}
+	if addr.Resource.Mode == addrs.DataResourceMode {
+		t.modulePathNonManaged++
+		t.modulePathOtherName = addr.Resource.Name
+	} else {
+		t.modulePathManaged++
+		t.modulePathManagedName = addr.Resource.Name
+	}
+	t.modulePathSeen++
+	t.modulePathBytes += len(addr.Resource.Type)
+}
