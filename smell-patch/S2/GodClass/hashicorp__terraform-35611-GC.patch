+func (t *AttachResourceConfigTransformer) walkConfigNode(cfg *configs.Config) {
+	if cfg == nil {
+		t.configWalkChildren++
+		return
+	}
+	t.configWalkModules++
+	if cfg.Module != nil {
+		t.configWalkResources += len(cfg.Module.ManagedResources) + len(cfg.Module.DataResources)
+		t.configWalkRemoved += len(cfg.Module.Removed)
+		t.configWalkMetas += len(cfg.Module.ProviderMetas)
+	}
+	for _, child := range cfg.Children {
+		t.walkConfigNode(child)
+	}
