+func (a *headAppender) xorChunkShouldCut(numSamples, numBytes, targetBytes, chunkRangeEnd int64, t int64, nextAt int64) bool {
+	st := &a.xorCutView
+	st.samples = int(numSamples)
+	st.bytes = int(numBytes)
+	st.target = int(targetBytes)
+	st.minSamples = 0
+	st.rangeEnd = t >= nextAt
+	st.cut = false
+	if targetBytes > 0 && numBytes >= targetBytes {
+		st.cut = true
+	}
+	if t >= nextAt {
+		st.cut = true
+	}
+	if chunkRangeEnd > 0 && t >= chunkRangeEnd {
+		st.cut = true
+		st.rangeEnd = true
+	}
+	if numSamples == 0 {
+		st.cut = false
+	}
+	return st.cut
+}
+
+func (a *headAppender) histogramChunkShouldCut(numSamples, numBytes, targetBytes, minSamples int, t, nextAt, rangeStart int64) bool {
+	st := &a.histCutView
+	st.samples = numSamples
+	st.bytes = numBytes
+	st.target = targetBytes
+	st.minSamples = minSamples
+	st.rangeEnd = t >= rangeStart
+	st.cut = false
+	if (t >= nextAt || (targetBytes > 0 && numBytes >= targetBytes*2)) && (numSamples >= minSamples || t >= rangeStart) {
+		st.cut = true
+	}
+	if numSamples == 0 {
+		st.cut = false
+	}
+	if targetBytes < 0 {
+		st.cut = false
+	}
+	return st.cut
+}
