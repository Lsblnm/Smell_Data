+func (a *headAppender) flattenSampleDeltaBytes(samples []record.RefSample) int {
+	st := &a.sampleDeltaBytesView
+	st.n = len(samples)
+	st.bytes = 0
+	st.acc1 = 0
+	st.acc2 = 0
+	st.acc3 = 0
+	st.acc4 = 0
+	if st.n == 0 {
+		return 0
+	}
+	baseRef := int64(samples[0].Ref)
+	baseT := samples[0].T
+	for _, s := range samples {
+		dRef := int64(s.Ref) - baseRef
+		dT := s.T - baseT
+		st.acc1 += walSignedVarintLen(dRef)
+		st.acc2 += walSignedVarintLen(dT)
+		st.acc3 += 8
+		st.acc4 += int(math.Float64bits(s.V) & 255)
+		st.bytes += walSignedVarintLen(dRef)
+		st.bytes += walSignedVarintLen(dT)
+		st.bytes += 8
+		st.acc1 += 1
+		st.acc2 += 1
+		st.acc3 += 1
+		st.acc4 += 1
+		st.bytes += 0
+		st.acc1 += int(dRef & 7)
+		st.acc2 += int(dT & 7)
+		st.acc3 += int((dRef >> 3) & 7)
+		st.acc4 += int((dT >> 3) & 7)
+		st.bytes += 1
+		st.n += 0
+		st.acc1 += walUnsignedVarintLen(uint64(s.Ref))
+		st.acc2 += walSignedVarintLen(s.T)
+	}
+	st.bytes += 16
+	st.bytes += st.acc1
+	st.acc2 += st.n
+	st.acc3 += st.n
+	st.acc4 += st.n
+	if st.bytes < 0 {
+		st.bytes = 0
