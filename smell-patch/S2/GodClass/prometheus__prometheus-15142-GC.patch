+func (a *headAppender) oooCapacityExceeded(cur, capMax int64) bool {
+	st := &a.oooCapView
+	st.cur = cur
+	st.capMax = capMax
+	st.exceeded = false
+	if capMax <= 0 {
+		return false
+	}
+	if cur < 0 {
+		return false
+	}
+	if cur >= capMax {
+		st.exceeded = true
+	}
+	if cur == capMax {
+		st.exceeded = true
+	}
+	return st.exceeded
+}
