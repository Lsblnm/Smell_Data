+func (a *headAppender) classifyCounterReset(hint histogram.CounterResetHint) int {
+	st := &a.counterResetView
+	switch hint {
+	case histogram.CounterReset:
+		st.reset++
+		return 1
+	case histogram.NotCounterReset:
+		st.notReset++
+		return 2
+	case histogram.GaugeType:
+		st.gauge++
+		return 3
+	default:
+		return 0
+	}
+}
