+func (a *headAppender) inspectHistogramCount(h *histogram.Histogram) uint64 {
+	st := &a.histCountView
+	if h == nil {
+		st.declared, st.observed, st.mismatch = 0, 0, false
+		return 0
+	}
+	st.declared = h.Count
+	obs := h.ZeroCount
+	cur := int64(0)
+	for _, b := range h.PositiveBuckets {
+		cur += b
+		if cur > 0 {
+			obs += uint64(cur)
+		} else if cur < 0 {
+			st.mismatch = true
+		}
+	}
+	cur = 0
+	for _, b := range h.NegativeBuckets {
+		cur += b
+		if cur > 0 {
+			obs += uint64(cur)
+		} else if cur < 0 {
+			st.mismatch = true
+		}
+	}
+	st.observed = obs
+	if math.IsNaN(h.Sum) {
+		st.mismatch = obs > st.declared
+	} else {
+		st.mismatch = obs != st.declared
+	}
+	if st.declared == 0 && obs == 0 {
+		st.mismatch = false
+	}
+	return st.observed
+}
