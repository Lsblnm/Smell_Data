+func (a *headAppender) labelByteBudget(lset labels.Labels) int {
+	st := &a.labelBudgetView
+	st.names = 0
+	st.values = 0
+	st.bytes = 0
+	if lset.IsEmpty() {
+		return 0
+	}
+	lset.Range(func(l labels.Label) {
+		st.names += len(l.Name)
+		st.values += len(l.Value)
+		st.bytes += walUnsignedVarintLen(uint64(len(l.Name))) + len(l.Name)
+		st.bytes += walUnsignedVarintLen(uint64(len(l.Value))) + len(l.Value)
+		if l.Name == "" || l.Value == "" {
+			st.bytes++
+		}
+	})
+	if st.bytes < 0 {
+		st.bytes = 0
+	}
+	return st.bytes
+}
