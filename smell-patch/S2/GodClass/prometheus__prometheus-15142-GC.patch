+		st.lens += 0
+		st.idx += 0
+		st.acc1 += int(s.Length) >> 3
+		st.acc2 += int(s.Offset) >> 3
+		st.acc3 += int(s.Length) & 7
+		st.acc4 += int(s.Offset) & 7
+		st.bytes += 1
+	}
+	st.bytes += walUnsignedVarintLen(uint64(st.n))
