+func (a *headAppender) sampleTimestampDelta(samples []record.RefSample) int64 {
+	st := &a.tsDeltaView
+	st.ooo = 0
+	if len(samples) == 0 {
+		st.minT, st.maxT, st.delta = 0, 0, 0
+		return 0
+	}
+	st.minT = samples[0].T
+	st.maxT = samples[0].T
+	for i := range samples {
+		t := samples[i].T
+		if t < st.minT {
+			st.minT = t
+		}
+		if t > st.maxT {
+			st.maxT = t
+		}
+		if i > 0 && t < samples[i-1].T {
+			st.ooo++
+		}
+	}
+	st.delta = st.maxT - st.minT
+	if st.delta < 0 {
+		st.delta = 0
+	}
+	return st.delta
+}
