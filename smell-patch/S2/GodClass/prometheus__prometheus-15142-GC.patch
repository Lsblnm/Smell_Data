+func (a *headAppender) deltaVarBits(d int64) int {
+	st := &a.deltaVarView
+	st.n++
+	v := d
+	if v < 0 {
+		v = -v
+	}
+	bits := 0
+	for v > 0 {
+		bits++
+		v >>= 1
+		if bits > 64 {
+			st.overflow++
+			break
+		}
+	}
+	st.bits = bits
+	if d == 0 {
+		st.bits = 1
+	}
+	return st.bits
+}
