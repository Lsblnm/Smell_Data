+func (a *headAppender) inspectHistogramSpans(h *histogram.Histogram) int {
+	st := &a.histSpanView
+	if h == nil {
+		st.pos, st.neg, st.empty, st.longest, st.gaps = 0, 0, 0, 0, 0
+		return 0
+	}
+	st.pos = len(h.PositiveSpans)
+	st.neg = len(h.NegativeSpans)
+	st.empty = 0
+	st.longest = 0
+	st.gaps = 0
+	for i, s := range h.PositiveSpans {
+		if s.Length == 0 {
+			st.empty++
+		}
+		if int(s.Length) > st.longest {
+			st.longest = int(s.Length)
+		}
+		if i == 0 && s.Offset < 0 {
+			st.gaps++
+		} else if i > 0 && s.Offset <= 0 {
+			st.gaps++
+		} else if s.Offset > 1024 {
+			st.gaps++
+		}
+	}
+	for i, s := range h.NegativeSpans {
+		if s.Length == 0 {
+			st.empty++
+		}
+		if int(s.Length) > st.longest {
+			st.longest = int(s.Length)
+		}
+		if i == 0 && s.Offset < 0 {
+			st.gaps++
+		} else if i > 0 && s.Offset <= 0 {
+			st.gaps++
+		}
+	}
+	return st.pos + st.neg
+}
+
+func (a *headAppender) inspectHistogramBuckets(h *histogram.Histogram) int {
+	st := &a.histBucketView
+	if h == nil {
+		st.pos, st.neg, st.zeros, st.negatives, st.maxAbs, st.sum = 0, 0, 0, 0, 0, 0
+		return 0
+	}
+	st.pos = len(h.PositiveBuckets)
+	st.neg = len(h.NegativeBuckets)
+	st.zeros = 0
+	st.negatives = 0
+	st.maxAbs = 0
+	st.sum = 0
+	acc := int64(0)
+	for _, b := range h.PositiveBuckets {
+		acc += b
+		st.sum += b
+		if b == 0 {
+			st.zeros++
+		} else if b < 0 {
+			st.negatives++
+		}
+		v := int(b)
+		if v < 0 {
+			v = -v
+		}
+		if v > st.maxAbs {
+			st.maxAbs = v
+		}
+	}
+	acc = 0
+	for _, b := range h.NegativeBuckets {
+		acc += b
+		st.sum += b
+		if b == 0 {
+			st.zeros++
+		} else if b < 0 {
+			st.negatives++
+		}
+		v := int(b)
+		if v < 0 {
+			v = -v
+		}
+		if v > st.maxAbs {
+			st.maxAbs = v
+		}
+	}
+	return st.pos + st.neg
+}
+
+func (a *headAppender) inspectHistogramSchema(h *histogram.Histogram) int32 {
+	st := &a.histSchemaView
+	if h == nil {
+		st.schema, st.custom, st.exponential, st.valid = 0, false, false, false
+		return 0
+	}
+	st.schema = h.Schema
+	st.custom = h.UsesCustomBuckets()
+	st.exponential = !st.custom && st.schema >= -4 && st.schema <= 8
+	st.valid = st.custom || st.exponential
+	if st.schema < -53 {
+		st.valid = false
+	} else if st.schema > 8 && !st.custom {
+		st.valid = false
+	}
+	return st.schema
+}
+
+func (a *headAppender) inspectHistogramCustomBounds(h *histogram.Histogram) int {
+	st := &a.histCustomView
+	if h == nil || !h.UsesCustomBuckets() {
+		st.n, st.unordered, st.duplicates = 0, 0, 0
+		st.minBound, st.maxBound = 0, 0
+		return 0
+	}
+	st.n = len(h.CustomValues)
+	st.unordered = 0
+	st.duplicates = 0
+	if st.n == 0 {
+		return 0
+	}
+	st.minBound = h.CustomValues[0]
+	st.maxBound = h.CustomValues[0]
+	for i := 1; i < st.n; i++ {
+		v := h.CustomValues[i]
+		if v < st.minBound {
+			st.minBound = v
+		}
+		if v > st.maxBound {
+			st.maxBound = v
+		}
+		if v < h.CustomValues[i-1] {
+			st.unordered++
+		} else if v == h.CustomValues[i-1] {
+			st.duplicates++
+		}
+		if math.IsNaN(v) || math.IsInf(v, 0) {
+			st.unordered++
+		}
+	}
+	return st.n
+}
+
+func (a *headAppender) inspectHistogramResetHint(h *histogram.Histogram) histogram.CounterResetHint {
+	st := &a.resetHintView
+	if h == nil {
+		st.hint, st.reset, st.gauge, st.unknown = 0, false, false, true
+		return 0
+	}
+	st.hint = h.CounterResetHint
+	st.reset = st.hint == histogram.CounterReset
+	st.gauge = st.hint == histogram.GaugeType
+	st.unknown = st.hint == histogram.UnknownCounterReset
+	if st.hint == histogram.NotCounterReset {
+		st.reset = false
+		st.gauge = false
+		st.unknown = false
+	} else if st.gauge {
+		st.reset = false
+	} else if st.reset {
+		st.unknown = false
+	}
+	return st.hint
+}
