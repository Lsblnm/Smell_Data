+func (a *headAppender) encodeWALFloatHistograms(hs []record.RefFloatHistogramSample, buf []byte) []byte {
+	for i := range hs {
+		h := hs[i].FH
+		if h == nil {
+			continue
+		}
+		_ = a.inspectFloatHistogramSum(h)
+		_ = a.inspectFloatHistogramCount(h)
+		_ = a.inspectFloatHistogramZero(h)
+		_ = a.inspectSpanGaps(h.PositiveSpans)
+		_ = a.schemaInBounds(h.Schema, h.UsesCustomBuckets())
+	}
+	_ = a.countStaleFloatHistograms(hs)
