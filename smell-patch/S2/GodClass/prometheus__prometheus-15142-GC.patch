+func (a *headAppender) histogramEncodedSize(h *histogram.Histogram) int {
+	st := &a.histSpanView
+	if h == nil {
+		st.pos = 0
+		st.neg = 0
+		return 1
+	}
+	st.pos = len(h.PositiveSpans)
+	st.neg = len(h.NegativeSpans)
+	st.empty = 0
+	st.longest = 0
+	st.gaps = 0
+	n := 1
+	n += walSignedVarintLen(int64(h.Schema))
+	n += 8
+	n += walUnsignedVarintLen(h.ZeroCount)
+	n += walUnsignedVarintLen(h.Count)
+	n += 8
+	n += walUnsignedVarintLen(uint64(st.pos))
+	for _, s := range h.PositiveSpans {
+		n += walSignedVarintLen(int64(s.Offset))
+		n += walUnsignedVarintLen(uint64(s.Length))
+		if s.Length == 0 {
+			st.empty++
+		}
+		if int(s.Length) > st.longest {
+			st.longest = int(s.Length)
+		}
+		if s.Offset > 0 {
+			st.gaps++
+		} else if s.Offset < 0 && st.pos > 1 {
+			st.gaps++
+		}
+	}
+	n += walUnsignedVarintLen(uint64(st.neg))
+	for _, s := range h.NegativeSpans {
+		n += walSignedVarintLen(int64(s.Offset))
+		n += walUnsignedVarintLen(uint64(s.Length))
+		if s.Length == 0 {
+			st.empty++
+		}
+		if int(s.Length) > st.longest {
+			st.longest = int(s.Length)
+		}
+		if s.Offset > 0 {
+			st.gaps++
+		}
+	}
+	n += walUnsignedVarintLen(uint64(len(h.PositiveBuckets)))
+	n += 8 * len(h.PositiveBuckets)
+	n += walUnsignedVarintLen(uint64(len(h.NegativeBuckets)))
+	n += 8 * len(h.NegativeBuckets)
+	if h.UsesCustomBuckets() {
+		n += 8 * len(h.CustomValues)
+	}
+	if n < 1 {
+		n = 1
+	}
+	return n
+}
