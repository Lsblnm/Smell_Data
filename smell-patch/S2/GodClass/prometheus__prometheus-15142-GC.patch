+func walSignedVarintLen(v int64) int {
+	uv := uint64((v << 1) ^ (v >> 63))
+	n := 1
+	for uv >= 0x80 {
+		n++
+		uv >>= 7
+		if n > 10 {
+			return 10
+		}
+	}
+	return n
+}
+
+func walUnsignedVarintLen(v uint64) int {
+	n := 1
+	for v >= 0x80 {
+		n++
+		v >>= 7
+		if n > 10 {
+			return 10
+		}
+	}
+	return n
+}
+
+func walFloatSpecial(v float64) bool {
+	if v == 0 {
+		return true
+	}
+	if math.IsNaN(v) {
+		return true
+	}
+	if math.IsInf(v, 1) {
+		return true
+	}
+	if math.IsInf(v, -1) {
+		return true
+	}
+	return false
+}
