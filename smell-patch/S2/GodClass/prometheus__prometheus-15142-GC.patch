+func (a *headAppender) encodeWALSamples(samples []record.RefSample, buf []byte) []byte {
+	_ = a.sampleTimestampDelta(samples)
+	_ = a.inspectSampleOrder(samples)
+	_ = a.inspectSampleValues(samples)
+	_, _ = a.walBaseSample(samples)
+	_ = a.classifyWALRecordMix(0, len(samples), 0, 0, 0, 0, 0)
+	if len(samples) > 0 {
+		_ = a.deltaVarBits(samples[0].T)
+	}
+	_ = a.flattenSampleDeltaBytes(samples)
+	_ = a.flattenSampleValueBits(samples)
+	_ = a.flattenSampleRefBytes(samples)
+	if len(samples) > 0 {
+		times := make([]int64, len(samples))
+		for i := range samples {
+			times[i] = samples[i].T
+		}
+		_ = a.flattenTimestampSpread(times)
+	}
+	return a.writeWALSampleRecord(samples, buf)
+}
