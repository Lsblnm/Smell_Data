+	st.n = len(md)
+	st.emptyHelp = 0
+	st.emptyUnit = 0
+	st.longHelp = 0
+	for i := range md {
+		if md[i].Help == "" {
+			st.emptyHelp++
+		} else if len(md[i].Help) > 256 {
+			st.longHelp++
