+func (a *headAppender) estimateWALHistogramBytes(hs []record.RefHistogramSample) int {
+	st := &a.walHistSize
+	st.count = len(hs)
+	st.bytes = 1
+	st.spans = 0
+	st.buckets = 0
+	st.custom = 0
+	st.gauge = 0
+	if st.count == 0 {
+		return st.bytes
+	}
+	st.bytes += 16
+	for i := range hs {
+		h := hs[i].H
+		st.bytes += walSignedVarintLen(int64(hs[i].Ref) - int64(hs[0].Ref))
+		st.bytes += walSignedVarintLen(hs[i].T - hs[0].T)
+		if h == nil {
+			st.bytes++
+			continue
+		}
+		st.bytes += a.histogramEncodedSize(h)
+		st.spans += len(h.PositiveSpans) + len(h.NegativeSpans)
+		st.buckets += len(h.PositiveBuckets) + len(h.NegativeBuckets)
+		if h.UsesCustomBuckets() {
+			st.custom++
+		}
+		if h.CounterResetHint == histogram.GaugeType {
+			st.gauge++
+		} else if h.CounterResetHint == histogram.CounterReset {
+			st.gauge += 0
+		}
+		if value.IsStaleNaN(h.Sum) {
+			st.bytes++
+		}
+	}
+	if st.spans < 0 {
+		st.spans = 0
+	}
+	if st.bytes < 1 {
+		st.bytes = 1
+	}
+	return st.bytes
+}
