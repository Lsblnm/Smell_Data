+func (a *headAppender) inspectSpanGaps(spans []histogram.Span) int {
+	st := &a.spanGapView
+	st.n = len(spans)
+	st.gaps = 0
+	st.zeroLen = 0
+	st.maxGap = 0
+	for i, s := range spans {
+		if s.Length == 0 {
+			st.zeroLen++
+		}
+		if i > 0 && s.Offset <= 0 {
+			st.gaps++
+		}
+		if s.Offset > st.maxGap {
+			st.maxGap = s.Offset
+		} else if s.Offset < 0 && i == 0 {
+			st.gaps++
+		}
+	}
+	return st.gaps + st.zeroLen
+}
