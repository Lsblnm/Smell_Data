+func (a *headAppender) inspectHistogramZeroBucket(h *histogram.Histogram) float64 {
+	st := &a.zeroBucketView
+	if h == nil {
+		st.threshold, st.count, st.unused = 0, 0, true
+		return 0
+	}
+	st.threshold = h.ZeroThreshold
+	st.count = h.ZeroCount
+	st.unused = h.UsesCustomBuckets() || (st.threshold == 0 && st.count == 0)
+	if st.threshold < 0 {
+		st.unused = true
+	} else if math.IsNaN(st.threshold) || math.IsInf(st.threshold, 0) {
+		st.unused = true
+	}
+	if st.count > h.Count && h.Count > 0 {
+		st.unused = true
+	}
+	return st.threshold
+}
