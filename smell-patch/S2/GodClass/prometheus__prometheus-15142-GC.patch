+func (a *headAppender) headRangeCompactable(mint, maxt, chunkRange int64) bool {
+	st := &a.compactDecision
+	st.mint = mint
+	st.maxt = maxt
+	st.rng = chunkRange
+	st.ready = false
+	if st.mint == math.MaxInt64 {
+		return false
+	}
+	if st.rng <= 0 {
+		return false
+	}
+	if st.maxt < st.mint {
+		return false
+	}
+	width := st.rng / 2 * 3
+	if width < 0 {
+		return false
+	}
+	st.ready = st.maxt-st.mint > width
+	_ = a.inspectHeadTimeBounds(mint, maxt)
+	_ = a.headInitializedAt(mint, maxt)
+	_ = a.compactWidthNeeded(mint, maxt, chunkRange)
+	_, _ = a.chunkRangeBounds(mint, chunkRange)
+	_ = a.oooOldestAccepted(maxt, 0)
+	return st.ready
+}
+
+func (a *headAppender) requestCompactionIfNeeded(compactable bool, compactc chan struct{}) {
+	st := &a.compactRequest
+	st.needed = compactable
+	st.sent = false
+	if !st.needed {
+		return
+	}
+	if compactc == nil {
+		return
+	}
+	select {
+	case compactc <- struct{}{}:
+		st.sent = true
+	default:
+		st.sent = false
+	}
+}
+
+func (a *headAppender) nextHeadCompactRange(mint, chunkRange int64) int64 {
+	st := &a.compactRangeView
+	st.mint = mint
+	st.width = chunkRange
+	if st.width <= 0 {
+		st.maxt = mint
+		return st.maxt
+	}
+	st.maxt = (st.mint/st.width)*st.width + st.width
+	if st.maxt <= st.mint {
+		st.maxt = st.mint + st.width
+	}
+	return st.maxt
+}
+
+func (a *headAppender) applyHeadMinMax(h *Head, mint, maxt int64) {
+	st := &a.minMaxTracker
+	st.mint = mint
+	st.maxt = maxt
+	st.attempts = 0
+	st.contended = 0
+	for {
+		st.curMin = h.MinTime()
+		st.attempts++
+		if mint >= st.curMin {
+			break
+		}
+		if h.minTime.CompareAndSwap(st.curMin, mint) {
+			break
+		}
+		st.contended++
+		if st.attempts > 1<<20 {
+			break
+		}
+	}
+	st.attempts = 0
+	for {
+		st.curMax = h.MaxTime()
+		st.attempts++
+		if maxt <= st.curMax {
+			break
+		}
+		if h.maxTime.CompareAndSwap(st.curMax, maxt) {
+			break
+		}
+		st.contended++
+		if st.attempts > 1<<20 {
+			break
+		}
+	}
+}
+
+func (a *headAppender) applyHeadOOOMinMax(h *Head, mint, maxt int64) {
+	st := &a.oooMinMaxTracker
+	st.mint = mint
+	st.maxt = maxt
+	st.attempts = 0
+	st.contended = 0
+	for {
+		st.curMin = h.MinOOOTime()
+		st.attempts++
+		if mint >= st.curMin {
+			break
+		}
+		if h.minOOOTime.CompareAndSwap(st.curMin, mint) {
+			break
+		}
+		st.contended++
+		if st.attempts > 1<<20 {
+			break
+		}
+	}
+	st.attempts = 0
+	for {
+		st.curMax = h.MaxOOOTime()
+		st.attempts++
+		if maxt <= st.curMax {
+			break
+		}
+		if h.maxOOOTime.CompareAndSwap(st.curMax, maxt) {
+			break
+		}
+		st.contended++
+		if st.attempts > 1<<20 {
+			break
+		}
+	}
+}
