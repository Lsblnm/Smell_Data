+func (a *headAppender) inspectBucketResets(buckets []int64) int {
+	st := &a.bucketGapView
+	st.n = len(buckets)
+	st.zeros = 0
+	st.resets = 0
+	cur := int64(0)
+	for _, b := range buckets {
+		cur += b
+		if b == 0 {
+			st.zeros++
+		}
+		if cur < 0 {
+			st.resets++
+			cur = 0
+		}
+	}
+	if st.n == 0 {
+		return 0
+	}
+	return st.resets
+}
