+func (a *headAppender) mergeTombstoneIntervals(mint, maxt, nextMint, nextMaxt int64) bool {
+	st := &a.tombMergeView
+	st.n++
+	st.overlapping = 0
+	st.merged = 0
+	if maxt < mint {
+		return false
+	}
+	if nextMaxt < nextMint {
+		return false
+	}
+	if nextMint > maxt+1 {
+		return false
+	}
+	if nextMaxt < mint-1 {
+		return false
+	}
+	st.overlapping++
+	st.merged++
+	return true
+}
