+func (a *headAppender) scanLabelDuplicates(lset labels.Labels) int {
+	st := &a.labelDupView
+	st.n = lset.Len()
+	st.empty = 0
+	st.dups = 0
+	st.maxName = 0
+	if st.n == 0 {
+		return 0
+	}
+	seen := make(map[string]int, st.n)
+	lset.Range(func(l labels.Label) {
+		if l.Name == "" {
+			st.empty++
+		}
+		if len(l.Name) > st.maxName {
+			st.maxName = len(l.Name)
+		}
+		seen[l.Name]++
+		if seen[l.Name] > 1 {
+			st.dups++
+		}
+	})
+	if l, dup := lset.HasDuplicateLabelNames(); dup && l != "" {
+		if st.dups == 0 {
+			st.dups++
+		}
+	}
+	return st.dups
+}
+
+func (a *headAppender) scanEmptyLabels(lset labels.Labels) int {
+	st := &a.labelEmptyView
+	st.n = lset.Len()
+	st.empty = 0
+	st.dups = 0
+	st.maxName = 0
+	if st.n == 0 || lset.IsEmpty() {
+		st.empty = st.n
+		return st.empty
+	}
+	lset.Range(func(l labels.Label) {
+		if l.Name == "" || l.Value == "" {
+			st.empty++
+		}
+		if len(l.Name) > st.maxName {
+			st.maxName = len(l.Name)
+		}
+		if len(l.Value) == 0 && len(l.Name) > 0 {
+			st.dups++
+		}
+	})
+	stripped := lset.WithoutEmpty()
+	if stripped.Len() < st.n {
+		missing := st.n - stripped.Len()
+		if missing > st.empty {
+			st.empty = missing
+		}
+	}
+	return st.empty
+}
+
+func (a *headAppender) mixLabelSetHash(lset labels.Labels) uint64 {
+	st := &a.labelHashView
+	st.n = lset.Len()
+	if st.n == 0 {
+		st.hash = 0
+		return 0
+	}
+	st.hash = lset.Hash()
+	if st.hash == 0 {
+		st.hash = labels.StableHash(lset)
+	} else if st.n == 1 {
+		st.hash ^= uint64(st.n)
+	}
+	return st.hash
+}
+
+func (a *headAppender) mixShardHash(lset labels.Labels, enabled bool) uint64 {
+	st := &a.shardHashView
+	st.n = lset.Len()
+	if !enabled || st.n == 0 {
+		st.hash = 0
+		return 0
+	}
+	st.hash = labels.StableHash(lset)
+	if st.hash == 0 {
+		st.hash = lset.Hash()
+	} else if st.hash == math.MaxUint64 {
+		st.hash ^= uint64(st.n)
+	}
+	return st.hash
+}
