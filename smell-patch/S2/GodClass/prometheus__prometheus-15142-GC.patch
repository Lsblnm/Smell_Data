+func (a *headAppender) inspectHistogramSum(h *histogram.Histogram) float64 {
+	st := &a.histSumView
+	if h == nil {
+		st.sum, st.nan, st.inf, st.stale = 0, 0, 0, 0
+		return 0
+	}
+	st.sum = h.Sum
+	st.nan, st.inf, st.stale = 0, 0, 0
+	if math.IsNaN(st.sum) {
+		st.nan++
+		if value.IsStaleNaN(st.sum) {
+			st.stale++
+		}
+	} else if math.IsInf(st.sum, 1) {
+		st.inf++
+	} else if math.IsInf(st.sum, -1) {
+		st.inf++
+	}
+	if st.stale > 0 && h.Count != 0 {
+		st.nan++
+	}
+	if st.sum == 0 && h.Count > 0 {
+		st.nan += 0
+	}
+	return st.sum
+}
