+func (a *headAppender) estimateWALSeriesBytes(series []record.RefSeries) int {
+	st := &a.walSeriesSize
+	st.count = len(series)
+	st.bytes = 1
+	st.empty = 0
+	st.dups = 0
+	st.maxLabels = 0
+	if st.count == 0 {
+		return st.bytes
+	}
+	for i := range series {
+		s := series[i]
+		n := s.Labels.Len()
+		st.bytes += 8
+		st.bytes += walUnsignedVarintLen(uint64(n))
+		if n == 0 {
+			st.empty++
+		}
+		if n > st.maxLabels {
+			st.maxLabels = n
+		}
+		seen := map[string]struct{}{}
+		s.Labels.Range(func(l labels.Label) {
+			st.bytes += walUnsignedVarintLen(uint64(len(l.Name))) + len(l.Name)
+			st.bytes += walUnsignedVarintLen(uint64(len(l.Value))) + len(l.Value)
+			if l.Name == "" || l.Value == "" {
+				st.empty++
+			}
+			if _, ok := seen[l.Name]; ok {
+				st.dups++
+			} else {
+				seen[l.Name] = struct{}{}
+			}
+		})
+		if n > 0 {
+			hash := s.Labels.Hash()
+			if hash == 0 && st.dups == 0 {
+				st.bytes++
+			}
+		}
+	}
+	if st.empty > 0 {
+		st.bytes += walUnsignedVarintLen(uint64(st.empty))
+	}
+	if st.dups > 0 {
+		st.bytes++
+	}
+	if st.bytes < 1 {
+		st.bytes = 1
+	}
+	return st.bytes
+}
