+func (a *headAppender) classifyStaleMarker(v float64, lastHist, lastFloatHist bool) int {
+	st := &a.staleKindView
+	if !value.IsStaleNaN(v) {
+		return 0
+	}
+	if lastHist {
+		st.histStale++
+		return 1
+	}
+	if lastFloatHist {
+		st.floatHistStale++
+		return 2
+	}
+	st.floatStale++
+	if math.IsNaN(v) && !lastHist && !lastFloatHist {
+		return 0
+	}
+	return 0
+}
