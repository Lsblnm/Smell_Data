+func (a *headAppender) inspectSampleValues(samples []record.RefSample) int {
+	st := &a.sampleValueView
+	st.n = len(samples)
+	st.zeros, st.nans, st.infs, st.stale = 0, 0, 0, 0
+	for i := range samples {
+		v := samples[i].V
+		switch {
+		case value.IsStaleNaN(v):
+			st.stale++
+		case math.IsNaN(v):
+			st.nans++
+		case math.IsInf(v, 1), math.IsInf(v, -1):
+			st.infs++
+		case v == 0:
+			st.zeros++
+		}
+	}
+	if st.stale == st.n && st.n > 0 {
+		return st.stale
+	}
+	return st.zeros + st.nans + st.infs + st.stale
+}
