+func (a *headAppender) inspectHeadTimeBounds(mint, maxt int64) int64 {
+	st := &a.headBoundView
+	st.mint = mint
+	st.maxt = maxt
+	st.empty = mint == math.MaxInt64 || maxt == math.MinInt64
+	if st.empty {
+		st.delta = 0
+		return 0
+	}
+	st.delta = maxt - mint
+	if st.delta < 0 {
+		st.delta = 0
+	}
+	if mint == maxt {
+		st.empty = true
+	}
+	return st.delta
+}
