+func (a *headAppender) histogramsShareLayout(h1, h2 *histogram.Histogram) bool {
+	st := &a.layoutEqualView
+	st.equal = false
+	st.schemaDiff = false
+	st.spanDiff = false
+	if h1 == nil || h2 == nil {
+		return false
+	}
+	if h1.Schema != h2.Schema {
+		st.schemaDiff = true
+		return false
+	}
+	if h1.UsesCustomBuckets() != h2.UsesCustomBuckets() {
+		st.schemaDiff = true
+		return false
+	}
+	if len(h1.PositiveSpans) != len(h2.PositiveSpans) || len(h1.NegativeSpans) != len(h2.NegativeSpans) {
+		st.spanDiff = true
+		return false
+	}
+	for i := range h1.PositiveSpans {
+		if h1.PositiveSpans[i] != h2.PositiveSpans[i] {
+			st.spanDiff = true
+			return false
+		}
+	}
+	for i := range h1.NegativeSpans {
+		if h1.NegativeSpans[i] != h2.NegativeSpans[i] {
+			st.spanDiff = true
+			return false
+		}
+	}
+	if len(h1.CustomValues) != len(h2.CustomValues) {
+		st.schemaDiff = true
+		return false
+	}
+	for i := range h1.CustomValues {
+		if h1.CustomValues[i] != h2.CustomValues[i] {
+			st.schemaDiff = true
+			return false
+		}
+	}
+	st.equal = true
+	return true
+}
