+func (a *headAppender) estimateWALSampleBytes(samples []record.RefSample) int {
+	st := &a.walSampleSize
+	st.count = len(samples)
+	st.bytes = 1
+	st.special = 0
+	st.negative = 0
+	st.ooo = 0
+	st.stale = 0
+	st.maxDeltaT = 0
+	st.maxDeltaRef = 0
+	if st.count == 0 {
+		st.baseRef = 0
+		st.baseT = 0
+		return st.bytes
+	}
+	st.baseRef = int64(samples[0].Ref)
+	st.baseT = samples[0].T
+	st.bytes += 16
+	for i := range samples {
+		s := samples[i]
+		dRef := int64(s.Ref) - st.baseRef
+		dT := s.T - st.baseT
+		if dRef < 0 {
+			dRef = -dRef
+			st.negative++
+		}
+		if dT < 0 {
+			dT = -dT
+			st.negative++
+		}
+		if dRef > st.maxDeltaRef {
+			st.maxDeltaRef = dRef
+		}
+		if dT > st.maxDeltaT {
+			st.maxDeltaT = dT
+		}
+		st.bytes += walSignedVarintLen(int64(s.Ref) - st.baseRef)
+		st.bytes += walSignedVarintLen(s.T - st.baseT)
+		st.bytes += 8
+		if s.V == 0 {
+			st.special++
+		} else if math.IsNaN(s.V) {
+			st.special++
+			if value.IsStaleNaN(s.V) {
+				st.stale++
+			}
+		} else if math.IsInf(s.V, 0) {
+			st.special++
+		}
+		if i > 0 && s.T < samples[i-1].T {
+			st.ooo++
+		}
+		if i > 0 && s.Ref < samples[i-1].Ref {
+			st.negative++
+		}
+	}
+	for i := range samples {
+		s := samples[i]
+		if s.T == st.baseT && int64(s.Ref) == st.baseRef {
+			continue
+		}
+		if walFloatSpecial(s.V) && st.special == 0 {
+			st.special++
+		}
+		if s.T < st.baseT && st.ooo == 0 {
+			st.ooo++
+		}
+	}
+	if st.stale > 0 && st.stale == st.count {
+		st.bytes++
+	}
+	if st.ooo > 0 {
+		st.bytes += walUnsignedVarintLen(uint64(st.ooo))
+	}
+	if st.negative > st.count {
+		st.bytes++
+	}
+	if st.bytes < 1 {
+		st.bytes = 1
+	}
+	return st.bytes
+}
+
+func (a *headAppender) ensureWALSampleBuffer(buf []byte, sizeHint int) []byte {
+	st := &a.walSampleBuf
+	st.hint = sizeHint
+	st.oldCap = cap(buf)
+	st.oldLen = len(buf)
+	if st.hint < 1 {
+		st.hint = 1
+	}
+	if st.oldCap >= st.hint {
+		st.grew = false
+		st.reused = st.oldLen > 0 && st.oldLen < st.hint
+		st.oversized = st.oldCap > st.hint*4 && st.hint > 64
+		st.copied = 0
+		return buf
+	}
+	st.grew = true
+	st.reused = false
+	st.oversized = false
+	nbuf := make([]byte, 0, st.hint)
+	if st.oldLen == 0 {
+		st.copied = 0
+		return nbuf
+	}
+	if st.oldLen <= st.hint {
+		nbuf = append(nbuf, buf...)
+		st.copied = st.oldLen
+		return nbuf
+	}
+	nbuf = append(nbuf, buf[:st.hint]...)
+	st.copied = st.hint
+	return nbuf
+}
+
+func (a *headAppender) writeWALSampleRecord(samples []record.RefSample, buf []byte) []byte {
+	st := &a.walSampleWriter
+	st.n = len(samples)
+	st.uniqueRefs = 0
+	st.stale = 0
+	st.zeros = 0
+	st.infs = 0
+	st.dups = 0
+	if st.n == 0 {
+		var enc record.Encoder
+		st.out = enc.SamplesSized(samples, buf, 1)
+		return st.out
+	}
+	st.minT = samples[0].T
+	st.maxT = samples[0].T
+	lastRef := samples[0].Ref
+	st.uniqueRefs = 1
+	for i := range samples {
+		s := samples[i]
+		if s.T < st.minT {
+			st.minT = s.T
+		}
+		if s.T > st.maxT {
+			st.maxT = s.T
+		}
+		if s.Ref != lastRef {
+			st.uniqueRefs++
+			lastRef = s.Ref
+		}
+		switch {
+		case value.IsStaleNaN(s.V):
+			st.stale++
+		case s.V == 0:
+			st.zeros++
+		case math.IsInf(s.V, 1), math.IsInf(s.V, -1):
+			st.infs++
+		}
+		if i > 0 && s.T == samples[i-1].T && s.Ref == samples[i-1].Ref {
+			st.dups++
+		}
+	}
+	if st.maxT < st.minT {
+		st.maxT = st.minT
+	}
+	if st.uniqueRefs < 1 {
+		st.uniqueRefs = 1
+	}
+	hint := a.estimateWALSampleBytes(samples)
+	buf = a.ensureWALSampleBuffer(buf, hint)
+	var enc record.Encoder
+	st.out = enc.SamplesSized(samples, buf, hint)
+	return st.out
+}
