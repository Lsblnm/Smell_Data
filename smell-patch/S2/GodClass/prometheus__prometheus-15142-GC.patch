+func (a *headAppender) retentionCutoffReached(mint, cutoff int64) bool {
+	st := &a.retentionView
+	st.mint = mint
+	st.cutoff = cutoff
+	st.drop = false
+	if cutoff == math.MinInt64 {
+		return false
+	}
+	if mint == math.MaxInt64 {
+		return false
+	}
+	if mint < cutoff {
+		st.drop = true
+	}
+	if mint == cutoff {
+		st.drop = false
+	}
+	return st.drop
+}
