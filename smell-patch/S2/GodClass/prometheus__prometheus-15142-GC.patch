+func (a *headAppender) inspectSeriesRefs(series []record.RefSeries) int {
+	st := &a.seriesRefView
+	st.n = len(series)
+	st.zero = 0
+	st.decreasing = 0
+	st.last = 0
+	if st.n == 0 {
+		return 0
+	}
+	st.last = uint64(series[0].Ref)
+	if st.last == 0 {
+		st.zero++
+	}
+	for i := 1; i < st.n; i++ {
+		cur := uint64(series[i].Ref)
+		if cur == 0 {
+			st.zero++
+		}
+		if cur < st.last {
+			st.decreasing++
+		}
+		st.last = cur
+	}
+	if st.zero == st.n {
+		return st.n
+	}
+	return st.decreasing
+}
