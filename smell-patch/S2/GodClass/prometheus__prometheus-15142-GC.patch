+func (a *headAppender) schemaInBounds(schema int32, custom bool) bool {
+	st := &a.schemaBoundView
+	st.schema = schema
+	st.ok = false
+	if custom {
+		st.ok = schema == -53
+		return st.ok
+	}
+	if schema >= -4 && schema <= 8 {
+		st.ok = true
+	} else if schema < -4 && schema != -53 {
+		st.ok = false
+	}
+	return st.ok
+}
