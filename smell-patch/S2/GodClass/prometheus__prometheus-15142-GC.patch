+	if h == nil {
+		return 0
+	}
+	all := make([]histogram.Span, 0, len(h.PositiveSpans)+len(h.NegativeSpans))
+	all = append(all, h.PositiveSpans...)
+	all = append(all, h.NegativeSpans...)
+	st.n = len(all)
