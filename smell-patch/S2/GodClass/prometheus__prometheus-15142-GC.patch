+func (a *headAppender) appendableWindowBound(headMaxt, minValid, oooWindow int64) int64 {
+	st := &a.appendWindowView
+	st.headMaxt = headMaxt
+	st.minValid = minValid
+	st.oooWindow = oooWindow
+	if st.oooWindow == 0 {
+		st.bound = st.minValid
+		return st.bound
+	}
+	bound := st.headMaxt - st.oooWindow
+	if bound < st.minValid {
+		st.bound = bound
+	} else {
+		st.bound = st.minValid
+	}
+	if st.oooWindow < 0 {
+		st.bound = st.minValid
+	}
+	return st.bound
+}
