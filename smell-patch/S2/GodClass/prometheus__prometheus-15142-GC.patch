+func (a *headAppender) estimatePostingsCardinality(n int) int {
+	st := &a.postingsView
+	st.n = n
+	st.cardinality = n
+	if n < 0 {
+		st.cardinality = 0
+		return 0
+	}
+	if n == 0 {
+		return 0
+	}
+	if n > 1<<20 {
+		st.cardinality = 1 << 20
+	} else if n > 1024 {
+		st.cardinality = n
+	}
+	return st.cardinality
+}
