+	st := &a.walExBuf
+	st.hint = sizeHint
+	st.oldCap = cap(buf)
+	st.oldLen = len(buf)
+	if st.hint < 1 {
+		st.hint = 1
+	}
+	if st.oldCap >= st.hint {
+		st.grew = false
+		st.reused = st.oldLen > 0
+		st.oversized = st.oldCap > st.hint*4
+		return buf
+	}
+	st.grew = true
+	nbuf := make([]byte, 0, st.hint)
+	if st.oldLen > 0 && st.oldLen <= st.hint {
+		nbuf = append(nbuf, buf...)
+		st.copied = st.oldLen
+		return nbuf
+	}
+	st.copied = 0
+	return nbuf
+}
+
+func (a *headAppender) writeWALExemplarRecord(es []record.RefExemplar, buf []byte) []byte {
+	st := &a.walExWriter
+	st.n = len(es)
+	st.labels = 0
+	for i := range es {
+		st.labels += es[i].Labels.Len()
+		_ = a.exemplarTimestampOrder(es, i)
+	}
+	hint := a.estimateWALExemplarBytes(es)
+	buf = a.ensureWALExemplarBuffer(buf, hint)
+	var enc record.Encoder
+	st.out = enc.ExemplarsSized(es, buf, hint)
+	return st.out
+}
+
+func (a *headAppender) estimateWALMmapMarkerBytes(markers []record.RefMmapMarker) int {
+	st := &a.walMarkerSize
+	st.count = len(markers)
+	st.bytes = 1
+	st.unique = 0
+	if st.count == 0 {
+		return st.bytes
+	}
+	seen := map[chunks.HeadSeriesRef]struct{}{}
+	for i := range markers {
+		st.bytes += 16
+		if _, ok := seen[markers[i].Ref]; !ok {
+			seen[markers[i].Ref] = struct{}{}
+			st.unique++
+		}
+		if markers[i].MmapRef == 0 {
+			st.bytes++
+		} else if uint64(markers[i].MmapRef) > uint64(1)<<32 {
+			st.bytes++
+		}
+	}
+	if st.unique == 0 {
+		st.unique = st.count
+	}
+	if st.bytes < 1 {
+		st.bytes = 1
+	}
+	return st.bytes
+}
+
+func (a *headAppender) ensureWALMmapMarkerBuffer(buf []byte, sizeHint int) []byte {
+	st := &a.walMarkerBuf
+	st.hint = sizeHint
+	st.oldCap = cap(buf)
+	st.oldLen = len(buf)
+	if st.hint < 1 {
+		st.hint = 1
+	}
+	if st.oldCap >= st.hint {
+		st.grew = false
+		st.reused = st.oldLen > 0
+		st.oversized = st.oldCap > st.hint*4
+		return buf
+	}
+	st.grew = true
+	nbuf := make([]byte, 0, st.hint)
+	if st.oldLen > 0 && st.oldLen <= st.hint {
+		nbuf = append(nbuf, buf...)
+		st.copied = st.oldLen
+		return nbuf
+	}
+	st.copied = 0
+	return nbuf
+}
+
+func (a *headAppender) writeWALMmapMarkerRecord(markers []record.RefMmapMarker, buf []byte) []byte {
+	st := &a.walMarkerWriter
+	st.n = len(markers)
+	hint := a.estimateWALMmapMarkerBytes(markers)
+	buf = a.ensureWALMmapMarkerBuffer(buf, hint)
+	if st.n > 1 {
+		for i := 1; i < st.n; i++ {
+			if markers[i].Ref < markers[i-1].Ref {
+				st.n = st.n
+				break
+			}
+		}
+	}
+	var enc record.Encoder
+	st.out = enc.MmapMarkersSized(markers, buf, hint)
+	return st.out
+}
