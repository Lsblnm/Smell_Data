+func (a *headAppender) encodeWALSeries(series []record.RefSeries, buf []byte) []byte {
+	for i := range series {
+		_ = a.scanLabelDuplicates(series[i].Labels)
+		_ = a.scanEmptyLabels(series[i].Labels)
+		_ = a.mixLabelSetHash(series[i].Labels)
+		_ = a.mixShardHash(series[i].Labels, false)
+		_ = a.labelByteBudget(series[i].Labels)
+		_ = a.labelsAreSorted(series[i].Labels)
+	}
+	_ = a.inspectSeriesRefs(series)
+	_ = a.seriesCreationMix(len(series) > 0, len(series))
+	_ = a.flattenSeriesRefBytes(series)
+	_ = a.flattenSeriesLabelBytes(series)
+	for i := range series {
+		_ = a.flattenLabelNameBytes(series[i].Labels)
+		_ = a.flattenLabelValueBytes(series[i].Labels)
+	}
+	return a.writeWALSeriesRecord(series, buf)
+}
+
+func (a *headAppender) encodeWALHistograms(hs []record.RefHistogramSample, buf []byte) []byte {
+	for i := range hs {
+		h := hs[i].H
+		if h == nil {
+			continue
+		}
+		_ = a.inspectHistogramBounds(h)
+		_ = a.inspectHistogramCount(h)
+		_ = a.inspectHistogramSum(h)
+		_ = a.walkHistogramPositiveBuckets(h)
+		_ = a.walkHistogramNegativeBuckets(h)
+		_ = a.inspectSpanGaps(h.PositiveSpans)
+		_ = a.inspectSpanGaps(h.NegativeSpans)
+		_ = a.inspectBucketResets(h.PositiveBuckets)
+		_ = a.schemaInBounds(h.Schema, h.UsesCustomBuckets())
+		_ = a.classifyCounterReset(h.CounterResetHint)
+		if i > 0 && hs[i-1].H != nil {
+			_ = a.histogramsShareLayout(hs[i-1].H, h)
+		}
+	}
+	_ = a.countStaleHistograms(hs)
+	_ = a.sequenceCounterResets(hs)
+	_ = a.flattenHistogramDeltaBytes(hs)
+	for i := range hs {
+		if hs[i].H == nil {
+			continue
+		}
+		_ = a.flattenPositiveSpanBytes(hs[i].H.PositiveSpans)
+		_ = a.flattenNegativeSpanBytes(hs[i].H.NegativeSpans)
+		_ = a.flattenPositiveBucketBytes(hs[i].H.PositiveBuckets)
+		_ = a.flattenNegativeBucketBytes(hs[i].H.NegativeBuckets)
+		_ = a.flattenCustomBoundBytes(hs[i].H.CustomValues)
+		_ = a.flattenHistogramHeaderBytes(hs[i].H)
+		_ = a.flattenHistogramCountAccumulator(hs[i].H)
+		_ = a.flattenAllHistogramSpans(hs[i].H)
+	}
+	return a.writeWALHistogramRecord(hs, buf)
+}
