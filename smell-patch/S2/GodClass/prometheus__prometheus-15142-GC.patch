+func (a *headAppender) accumulateHistogramBucketDeltas(h *histogram.Histogram) int64 {
+	st := &a.bucketDeltaView
+	if h == nil {
+		st.n, st.negatives, st.zeros, st.total = 0, 0, 0, 0
+		return 0
+	}
+	st.n = len(h.PositiveBuckets) + len(h.NegativeBuckets)
+	st.negatives = 0
+	st.zeros = 0
+	st.total = 0
+	cur := int64(0)
+	for _, b := range h.PositiveBuckets {
+		cur += b
+		st.total += cur
+		if cur < 0 {
+			st.negatives++
+		} else if cur == 0 {
+			st.zeros++
+		}
+	}
+	cur = 0
+	for _, b := range h.NegativeBuckets {
+		cur += b
+		st.total += cur
+		if cur < 0 {
+			st.negatives++
+		} else if cur == 0 {
+			st.zeros++
+		}
+	}
+	return st.total
+}
