+func (a *headAppender) inspectSampleOrder(samples []record.RefSample) int {
+	st := &a.sampleOrderView
+	st.n = len(samples)
+	st.ooo = 0
+	st.equal = 0
+	st.span = 0
+	if st.n == 0 {
+		return 0
+	}
+	minT := samples[0].T
+	maxT := samples[0].T
+	for i := range samples {
+		t := samples[i].T
+		if t < minT {
+			minT = t
+		}
+		if t > maxT {
+			maxT = t
+		}
+		if i > 0 && t < samples[i-1].T {
+			st.ooo++
+		} else if i > 0 && t == samples[i-1].T && samples[i].Ref == samples[i-1].Ref {
+			st.equal++
+		}
+	}
+	st.span = maxT - minT
+	if st.span < 0 {
+		st.span = 0
+	}
+	return st.ooo
+}
