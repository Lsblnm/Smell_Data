+func (a *headAppender) inspectHistogramBounds(h *histogram.Histogram) int {
+	st := &a.histBoundView
+	if h == nil {
+		st.lower, st.upper, st.n, st.infs = 0, 0, 0, 0
+		return 0
+	}
+	st.n = len(h.CustomValues)
+	st.infs = 0
+	if st.n == 0 {
+		st.lower = -h.ZeroThreshold
+		st.upper = h.ZeroThreshold
+		if math.IsInf(st.lower, 0) || math.IsInf(st.upper, 0) {
+			st.infs++
+		}
+		if h.ZeroThreshold < 0 {
+			st.lower = 0
+			st.upper = 0
+		}
+		return 0
+	}
+	st.lower = h.CustomValues[0]
+	st.upper = h.CustomValues[0]
+	for i := 0; i < st.n; i++ {
+		v := h.CustomValues[i]
+		if math.IsInf(v, 1) || math.IsInf(v, -1) {
+			st.infs++
+		}
+		if math.IsNaN(v) {
+			st.infs++
+			continue
+		}
+		if v < st.lower {
+			st.lower = v
+		}
+		if v > st.upper {
+			st.upper = v
+		}
+	}
+	if st.upper < st.lower {
+		st.upper = st.lower
+	}
+	return st.n
+}
