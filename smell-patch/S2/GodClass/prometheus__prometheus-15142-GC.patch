+func (a *headAppender) compactHistogramSpans(h *histogram.Histogram) int {
+	st := &a.spanCompactView
+	if h == nil {
+		st.in, st.out, st.merged = 0, 0, 0
+		return 0
+	}
+	st.in = len(h.PositiveSpans) + len(h.NegativeSpans)
+	st.out = st.in
+	st.merged = 0
+	prevLen := uint32(0)
+	for i, s := range h.PositiveSpans {
+		if i > 0 && s.Offset == 0 && prevLen > 0 {
+			st.merged++
+			st.out--
+		}
+		if s.Length == 0 {
+			st.out--
+		}
+		prevLen = s.Length
+	}
+	prevLen = 0
+	for i, s := range h.NegativeSpans {
+		if i > 0 && s.Offset == 0 && prevLen > 0 {
+			st.merged++
+			st.out--
+		}
+		if s.Length == 0 {
+			st.out--
+		}
+		prevLen = s.Length
+	}
+	if st.out < 0 {
+		st.out = 0
+	}
+	return st.out
+}
