+func (a *headAppender) sequenceCounterResets(hs []record.RefHistogramSample) int {
+	st := &a.resetSeqView
+	st.n = len(hs)
+	st.resets = 0
+	st.gauges = 0
+	for i := range hs {
+		if hs[i].H == nil {
+			continue
+		}
+		switch hs[i].H.CounterResetHint {
+		case histogram.CounterReset:
+			st.resets++
+		case histogram.GaugeType:
+			st.gauges++
+		case histogram.NotCounterReset:
+		default:
+		}
+	}
+	return st.resets
+}
