+func (a *headAppender) exemplarTimestampOrder(es []record.RefExemplar, i int) bool {
+	st := &a.exemplarOrderView
+	if i <= 0 || i >= len(es) {
+		if len(es) > 0 {
+			st.lastT = es[0].T
+		}
+		st.ooo = 0
+		return true
+	}
+	st.lastT = es[i-1].T
+	if es[i].T < st.lastT {
+		st.ooo++
+		return false
+	}
+	if es[i].T == st.lastT && es[i].Ref < es[i-1].Ref {
+		st.ooo++
+		return false
+	}
+	return true
+}
