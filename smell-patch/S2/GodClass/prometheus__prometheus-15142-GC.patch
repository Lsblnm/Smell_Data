+func (a *headAppender) walkHistogramPositiveBuckets(h *histogram.Histogram) int {
+	st := &a.histIterView
+	if h == nil {
+		st.visited, st.empty, st.overflow, st.lastIdx = 0, 0, 0, 0
+		return 0
+	}
+	st.visited = 0
+	st.empty = 0
+	st.overflow = 0
+	st.lastIdx = 0
+	bIdx := 0
+	for si, span := range h.PositiveSpans {
+		idx := span.Offset
+		if si > 0 {
+			idx = st.lastIdx + span.Offset
+		} else {
+			st.lastIdx = span.Offset
+			idx = span.Offset
+		}
+		for j := uint32(0); j < span.Length; j++ {
+			st.visited++
+			if bIdx >= len(h.PositiveBuckets) {
+				st.overflow++
+				break
+			}
+			if h.PositiveBuckets[bIdx] == 0 {
+				st.empty++
+			}
+			st.lastIdx = idx
+			idx++
+			bIdx++
+		}
+		if st.overflow > 0 {
+			break
+		}
+	}
+	if bIdx < len(h.PositiveBuckets) {
+		st.overflow += len(h.PositiveBuckets) - bIdx
+	}
+	return st.visited
+}
+
+func (a *headAppender) walkHistogramNegativeBuckets(h *histogram.Histogram) int {
+	st := &a.histNegIterView
+	if h == nil {
+		st.visited, st.empty, st.overflow, st.lastIdx = 0, 0, 0, 0
+		return 0
+	}
+	st.visited = 0
+	st.empty = 0
+	st.overflow = 0
+	st.lastIdx = 0
+	bIdx := 0
+	for si, span := range h.NegativeSpans {
+		idx := span.Offset
+		if si == 0 {
+			st.lastIdx = span.Offset
+			idx = span.Offset
+		} else {
+			idx = st.lastIdx + span.Offset
+		}
+		for j := uint32(0); j < span.Length; j++ {
+			st.visited++
+			if bIdx >= len(h.NegativeBuckets) {
+				st.overflow++
+				break
+			}
+			if h.NegativeBuckets[bIdx] == 0 {
+				st.empty++
+			}
+			st.lastIdx = idx
+			idx++
+			bIdx++
+		}
+		if st.overflow > 0 {
+			break
+		}
+	}
+	if bIdx < len(h.NegativeBuckets) {
+		st.overflow += len(h.NegativeBuckets) - bIdx
+	}
+	return st.visited
+}
