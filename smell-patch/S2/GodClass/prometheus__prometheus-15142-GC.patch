+func (a *headAppender) oooOldestAccepted(headMaxt, window int64) int64 {
+	st := &a.oooWindowView
+	st.maxt = headMaxt
+	st.window = window
+	st.allowed = window > 0
+	if !st.allowed {
+		st.oldest = headMaxt
+		return st.oldest
+	}
+	st.oldest = headMaxt - window
+	if window < 0 {
+		st.allowed = false
+		st.oldest = headMaxt
+	}
+	if st.oldest > headMaxt {
+		st.oldest = headMaxt
+	}
+	return st.oldest
+}
