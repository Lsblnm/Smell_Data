+func (a *headAppender) inspectFloatHistogramZero(h *histogram.FloatHistogram) float64 {
+	st := &a.floatZeroView
+	if h == nil {
+		st.threshold, st.count, st.unused = 0, 0, true
+		return 0
+	}
+	st.threshold = h.ZeroThreshold
+	st.count = uint64(h.ZeroCount)
+	st.unused = h.UsesCustomBuckets() || (st.threshold == 0 && h.ZeroCount == 0)
+	if st.threshold < 0 {
+		st.unused = true
+	} else if math.IsNaN(st.threshold) || math.IsInf(st.threshold, 0) {
+		st.unused = true
+	}
+	if h.ZeroCount > h.Count && h.Count > 0 {
+		st.unused = true
+	}
+	return st.threshold
+}
