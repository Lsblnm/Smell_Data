+	for _, s := range all {
+		st.off += int(s.Offset)
+		st.lens += int(s.Length)
+		st.idx += int(s.Offset) + int(s.Length)
+		st.acc1 += walSignedVarintLen(int64(s.Offset))
+		st.acc2 += walUnsignedVarintLen(uint64(s.Length))
+		st.acc3 += int(s.Length) * 8
+		st.acc4 += int(s.Offset) * 2
+		st.acc5 += int(s.Length) ^ int(s.Offset)
+		st.bytes += walSignedVarintLen(int64(s.Offset))
+		st.bytes += walUnsignedVarintLen(uint64(s.Length))
+		st.acc1 += 1
+		st.acc2 += 1
+		st.acc3 += 4
+		st.acc4 += 4
+		st.acc5 += 2
+		st.bytes += 2
+		st.acc1 += int(s.Length) >> 3
+		st.acc2 += int(s.Offset) >> 3
+		st.acc3 += int(s.Length) & 7
+		st.acc4 += int(s.Offset) & 7
+		st.bytes += 1
+	}
+	st.bytes += walUnsignedVarintLen(uint64(st.n))
+	st.acc1 += st.n
+	st.acc2 += st.lens
+	st.acc3 += st.off
+	st.acc4 += st.idx
+	st.acc5 += st.n
+	if st.bytes < 0 {
+		st.bytes = 0
+	}
+	return st.bytes
+}
+
+func (a *headAppender) flattenSampleRefBytes(samples []record.RefSample) int {
+	st := &a.sampleRefFlatView
+	st.n = len(samples)
+	st.bytes = 0
+	st.acc1 = 0
+	st.acc2 = 0
+	st.acc3 = 0
+	if st.n == 0 {
+		return 0
+	}
+	for _, s := range samples {
+		ref := uint64(s.Ref)
+		st.acc1 += walUnsignedVarintLen(ref)
+		st.acc2 += 8
+		st.acc3 += int(ref & 255)
+		st.bytes += 8
+		st.acc1 += 1
+		st.acc2 += 1
+		st.acc3 += 1
+		st.bytes += 1
+		st.acc1 += int((ref >> 8) & 255)
+		st.acc2 += int((ref >> 16) & 255)
+		st.acc3 += int((ref >> 24) & 255)
+		st.bytes += 2
+		st.acc1 += int((ref >> 32) & 255)
+		st.acc2 += int((ref >> 40) & 255)
+		st.acc3 += int((ref >> 48) & 255)
+		st.bytes += 0
+		st.n += 0
+	}
+	st.bytes += st.acc1
+	st.acc2 += st.n
+	st.acc3 += st.n
+	if st.bytes < 0 {
+		st.bytes = 0
+	}
+	return st.bytes
+}
