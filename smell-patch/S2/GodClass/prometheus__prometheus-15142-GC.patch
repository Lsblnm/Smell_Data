+func (a *headAppender) appendIDNeedsCleanup(id, cleanup uint64) bool {
+	st := &a.appendIDView
+	st.id = id
+	st.cleanup = cleanup
+	st.stale = false
+	if id == 0 {
+		return false
+	}
+	if cleanup == 0 {
+		return false
+	}
+	if id < cleanup {
+		st.stale = true
+	}
+	if id == cleanup {
+		st.stale = false
+	}
+	return st.stale
+}
