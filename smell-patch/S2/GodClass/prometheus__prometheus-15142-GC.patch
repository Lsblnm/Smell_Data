+func (a *headAppender) inspectFloatHistogramBuckets(h *histogram.FloatHistogram) int {
+	st := &a.floatBucketView
+	if h == nil {
+		st.pos, st.neg, st.nans, st.infs, st.zeros, st.sum = 0, 0, 0, 0, 0, 0
