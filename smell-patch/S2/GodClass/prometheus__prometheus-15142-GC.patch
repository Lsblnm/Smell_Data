+func (a *headAppender) walBaseSample(samples []record.RefSample) (uint64, int64) {
+	st := &a.walBaseView
+	st.n = len(samples)
+	if st.n == 0 {
+		st.baseRef = 0
+		st.baseT = 0
+		return 0, 0
+	}
+	st.baseRef = uint64(samples[0].Ref)
+	st.baseT = samples[0].T
+	if st.n > 1 && samples[1].T < st.baseT {
+		st.baseT = samples[0].T
+	}
+	if st.baseRef == 0 && st.n > 1 {
+		st.baseRef = uint64(samples[0].Ref)
+	}
+	return st.baseRef, st.baseT
+}
