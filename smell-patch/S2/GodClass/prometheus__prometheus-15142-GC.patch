+func (a *headAppender) inspectMmapRefs(markers []record.RefMmapMarker) int {
+	st := &a.mmapRefView
+	st.n = len(markers)
+	st.zero = 0
+	st.unique = 0
+	if st.n == 0 {
+		return 0
+	}
+	seen := map[chunks.ChunkDiskMapperRef]struct{}{}
+	for i := range markers {
+		if markers[i].MmapRef == 0 {
+			st.zero++
+		}
+		if _, ok := seen[markers[i].MmapRef]; !ok {
+			seen[markers[i].MmapRef] = struct{}{}
+			st.unique++
+		}
+	}
+	if st.unique == 0 {
+		st.unique = st.n
+	}
+	return st.unique
+}
