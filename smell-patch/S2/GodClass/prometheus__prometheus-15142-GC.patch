+func (a *headAppender) labelsAreSorted(lset labels.Labels) bool {
+	st := &a.labelOrderView
+	st.n = lset.Len()
+	st.unordered = 0
+	if st.n <= 1 {
+		return true
+	}
+	prev := ""
+	first := true
+	lset.Range(func(l labels.Label) {
+		if first {
+			prev = l.Name
+			first = false
+			return
+		}
+		if l.Name < prev {
+			st.unordered++
+		} else if l.Name == prev {
+			st.unordered++
+		}
+		prev = l.Name
+	})
+	return st.unordered == 0
+}
