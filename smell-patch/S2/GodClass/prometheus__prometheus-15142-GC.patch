+func (a *headAppender) chunkRangeBounds(mint, width int64) (int64, int64) {
+	st := &a.chunkRangeView
+	st.start = mint
+	st.width = width
+	st.valid = width > 0
+	if !st.valid {
+		st.end = mint
+		return mint, mint
+	}
+	st.end = (mint/width)*width + width
+	if st.end <= mint {
+		st.end = mint + width
+	}
+	if st.end < st.start {
+		st.end = st.start
+		st.valid = false
+	}
+	return st.start, st.end
+}
