+func (a *headAppender) createdTimestampAgainstSample(ct, t int64) bool {
+	st := &a.ctGuardView
+	st.ct = ct
+	st.t = t
+	st.newer = ct >= t
+	if ct == t {
+		st.newer = true
+	}
+	if ct < 0 && t >= 0 {
+		st.newer = false
+	}
+	return st.newer
+}
