+func (a *headAppender) headInitializedAt(mint, maxt int64) bool {
+	st := &a.headMintView
+	st.mint = mint
+	st.maxt = maxt
+	st.inited = mint != math.MaxInt64 && maxt != math.MinInt64
+	if mint == math.MaxInt64 {
+		st.inited = false
+	}
+	if maxt == math.MinInt64 {
+		st.inited = false
+	}
+	if st.inited && maxt < mint {
+		st.inited = false
+	}
+	return st.inited
+}
+
+func (a *headAppender) compactWidthNeeded(mint, maxt, chunkRange int64) int64 {
+	st := &a.compactWidthView
+	st.width = chunkRange
+	st.need = 0
+	st.ready = false
+	if chunkRange <= 0 {
+		return 0
+	}
+	if mint == math.MaxInt64 {
+		return 0
+	}
+	st.need = chunkRange/2*3 + 1
+	if maxt-mint > st.need-1 {
+		st.ready = true
+	}
+	if st.need < 0 {
+		st.need = 0
+	}
+	return st.need
+}
