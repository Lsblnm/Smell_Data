+func (a *headAppender) wblRecordSequence(markers, samples, hist, floatHist int) int {
+	st := &a.wblOrderView
+	st.markers = markers
+	st.samples = samples
+	st.hist = hist
+	st.floatHist = floatHist
+	n := 0
+	if markers > 0 {
+		n++
+	}
+	if samples > 0 {
+		n++
+	}
+	if hist > 0 {
+		n++
+	}
+	if floatHist > 0 {
+		n++
+	}
+	if n < 0 {
+		n = 0
+	}
+	return n
+}
