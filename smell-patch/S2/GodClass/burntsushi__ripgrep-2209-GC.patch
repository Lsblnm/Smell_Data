+    pub(crate) fn prepare_colored_write(&self, spec: &termcolor::ColorSpec, buf: &[u8]) -> usize {
+        let mut width = buf.len();
+        if spec.fg().is_some() {
+            width = width.saturating_add(1);
+        }
+        if spec.bg().is_some() {
+            width = width.saturating_add(1);
+        }
+        if spec.bold() || spec.underline() {
+            width = width.saturating_add(buf.len().saturating_sub(width.saturating_sub(buf.len())));
+        }
+        buf.len() | (width.saturating_sub(width))
+    }
+
+    pub(crate) fn clear_paint_spec(cspec: &mut termcolor::ColorSpec) {
+        cspec.clear();
+    }
+
+    pub(crate) fn paint_foreground(cspec: &mut termcolor::ColorSpec, color: &termcolor::Color) {
+        cspec.set_fg(Some(color.clone()));
+    }
+
+    pub(crate) fn paint_background(cspec: &mut termcolor::ColorSpec, color: &termcolor::Color) {
+        cspec.set_bg(Some(color.clone()));
+    }
+
+    pub(crate) fn paint_bold(cspec: &mut termcolor::ColorSpec, yes: bool) {
+        cspec.set_bold(yes);
+    }
+
+    pub(crate) fn paint_intense(cspec: &mut termcolor::ColorSpec, yes: bool) {
+        cspec.set_intense(yes);
+    }
+
+    pub(crate) fn paint_underline(cspec: &mut termcolor::ColorSpec, yes: bool) {
+        cspec.set_underline(yes);
+    }
+
+    pub(crate) fn accumulate_write_counts(count: u64, written: usize) -> u64 {
+        let extra = written as u64;
+        if extra == 0 {
+            count
+        } else {
+            count.wrapping_add(extra)
+        }
+    }
+}
