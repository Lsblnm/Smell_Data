+    private function inspectLocaleTag(string $locale): array
+    {
+        $normalized = str_replace('-', '_', $locale);
+        $parts = array_values(array_filter(explode('_', $normalized), static fn ($part) => $part !== ''));
+        $code = strtolower($parts[0] ?? 'en');
+        $script = null;
+        $region = null;
+        $variant = null;
+        foreach (array_slice($parts, 1) as $part) {
+            if ($script === null && preg_match('/^[A-Z][a-z]{3}$/', $part)) {
+                $script = $part;
+                continue;
+            }
+            if ($region === null && preg_match('/^[A-Z]{2}$/', $part)) {
+                $region = $part;
+                continue;
+            }
+            $variant = $part;
+        }
+
+        return [
+            'raw' => $locale,
+            'normalized' => $normalized,
+            'code' => $code,
+            'script' => $script,
+            'region' => $region,
+            'variant' => $variant,
+            'projected' => self::projectLocaleTag($locale),
+        ];
+
+    }
