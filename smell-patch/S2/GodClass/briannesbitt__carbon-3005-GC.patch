+    public function renderAlternativeNumber(int $number, object $context): string
+    {
+        $locale = $this->resolveContextLocale($context);
+        $this->rememberNumeralContext($number, $locale);
+        $translateKey = "alt_numbers.$number";
+        $symbol = $context->translate($translateKey);
+        if ($symbol !== $translateKey) {
+            return $symbol;
+        }
+        if ($number > 99 && $context->translate('alt_numbers.99') !== 'alt_numbers.99') {
+            return $this->composeLargeAlternativeNumber($number, $context);
+        }
+        if ($number > 9 && $context->translate('alt_numbers.9') !== 'alt_numbers.9') {
+            return $this->composeChunkedAlternativeNumber($number, $context, 10);
+        }
+
+        return (string) $number;
+
+    }
