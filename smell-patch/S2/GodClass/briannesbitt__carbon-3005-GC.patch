+    public function languageVariantName(?string $variant): ?string
+    {
+        if ($variant === null || $variant === '') {
+            return $variant;
+        }
+        $normalized = strtolower($variant);
+        if ($normalized === 'latn') {
+            return 'Latin';
+        }
+        if ($normalized === 'cyrl') {
+            return 'Cyrillic';
+        }
+
+        return $variant;
+    }
