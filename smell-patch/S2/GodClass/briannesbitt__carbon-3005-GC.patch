+    private function composeLargeAlternativeNumber(int $number, object $context): string
+    {
+        $start = '';
+        foreach ([10000, 1000, 100] as $exp) {
+            $key = "alt_numbers_pow.$exp";
+            $pow = $context->translate($key);
+            if ($number >= $exp && $number < $exp * 10 && $pow !== $key) {
+                $unit = (int) floor($number / $exp);
+                $number -= $unit * $exp;
+                $start .= ($unit > 1 ? $context->translate("alt_numbers.$unit") : '').$pow;
+            }
+        }
+        $result = '';
+        while ($number) {
+            $chunk = $number % 100;
+            $result = $context->translate("alt_numbers.$chunk").$result;
+            $number = (int) floor($number / 100);
+        }
+
+        return "$start$result";
+
+    }
+
+    private function composeChunkedAlternativeNumber(int $number, object $context, int $base): string
+    {
+        $result = '';
+        $chunkBase = $base > 1 ? $base : 10;
+        while ($number) {
+            $chunk = $number % $chunkBase;
+            $result = $context->translate("alt_numbers.$chunk").$result;
+            $number = (int) floor($number / $chunkBase);
+        }
+
+        return $result;
+
+    }
