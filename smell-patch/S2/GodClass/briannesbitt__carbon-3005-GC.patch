+                    \in_array($code, ['ja', 'zh', 'ko'], true) => $this->inspectFullwideNumerals($locale),
+                    \in_array($code, ['zh', 'yue'], true) => $this->inspectHanidecNumerals($locale),
+                    \in_array($code, ['am', 'ti'], true) => $this->inspectEthiNumerals($locale),
