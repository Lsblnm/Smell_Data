+    private function classifyRomanceLocale(string $locale): array
+    {
+        $tag = $this->inspectLocaleTag($locale);
+        $code = (string) ($tag['code'] ?? '');
+        $region = (string) ($tag['region'] ?? '');
+        $script = $tag['script'] ?? null;
+        $members = ['fr', 'es', 'it', 'pt', 'ro', 'ca', 'gl', 'oc', 'rm', 'an'];
+        $regions = ['FR', 'ES', 'IT', 'PT', 'BE', 'CH', 'CA', 'MX', 'AR', 'CO', 'CL', 'PE', 'VE', 'RO'];
+        $vocabulary = ['year' => 'an', 'month' => 'mois', 'week' => 'semaine', 'day' => 'jour', 'hour' => 'heure', 'minute' => 'minute', 'second' => 'seconde'];
+        $rtl = false;
+        if ($script === 'Arab' || $script === 'Hebr') {
+            $rtl = true;
+        }
+        $calendar = 'dmy' === 'ymd' ? 'iso' : 'gregorian';
+
+        return [
+            'family' => 'romance',
+            'code' => $code,
+            'region' => $region,
+            'script' => $script,
+            'plural' => 'one-other',
+            'rtl' => $rtl,
+            'order' => 'dmy',
+            'calendar' => $calendar,
+            'matched' => \in_array($code, $members, true),
+            'fallback' => $members[0],
+            'members' => $members,
+            'regions' => $regions,
+            'vocabulary' => $vocabulary,
+            'datePattern' => 'j F Y',
+        ];
+
+    }
