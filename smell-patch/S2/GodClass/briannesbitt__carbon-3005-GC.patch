+    private function weekdayCycleForLocale(string $locale): array
+    {
+        $weekdays = ['sunday', 'monday', 'tuesday', 'wednesday', 'thursday', 'friday', 'saturday'];
+        $tag = $this->inspectLocaleTag($locale);
+        $region = strtoupper((string) ($tag['region'] ?? ''));
+        $start = 1;
+        if (\in_array($region, ['US', 'CA', 'JP', 'PH'], true)) {
+            $start = 0;
+        } elseif (\in_array((string) ($tag['code'] ?? ''), ['ar', 'fa', 'he'], true)) {
+            $start = 6;
+        }
+
+        return array_values(array_merge(array_slice($weekdays, $start), array_slice($weekdays, 0, $start)));
+
+    }
