+    private function describeAtlanticTimezones(string $locale): array
+    {
+        $zones = ['UTC', 'GMT', 'Europe/London', 'Atlantic/Azores', 'America/Halifax'];
+        $labels = [];
+        foreach ($zones as $zone) {
+            $parts = explode('/', $zone);
+            $labels[$zone] = str_replace('_', ' ', (string) end($parts));
+        }
+
+        return [
+            'group' => 'Atlantic',
+            'locale' => $locale,
+            'labels' => $labels,
+        ];
+
+    }
