+    private function normalizeSharedLocaleIdentity(string $locale): string
+    {
+        $normalized = str_replace('-', '_', trim($locale));
+        if ($normalized === '') {
+            return 'en';
+        }
+        $aliases = ['me' => 'sr_Latn_ME', 'scr' => 'sh', 'iw' => 'he', 'in' => 'id', 'ji' => 'yi'];
+        if (isset($aliases[$normalized])) {
+            return $aliases[$normalized];
+        }
+
+        return $normalized;
+
+    }
