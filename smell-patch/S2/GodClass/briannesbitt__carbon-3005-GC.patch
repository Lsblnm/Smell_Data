+                    \in_array($code, ['fa', 'ps', 'ur'], true) => $this->inspectArabextNumerals($locale),
+                    \in_array($code, ['hi', 'mr', 'ne'], true) => $this->inspectDevaNumerals($locale),
+                    \in_array($code, ['bn', 'as'], true) => $this->inspectBengNumerals($locale),
+                    \in_array($code, ['pa'], true) => $this->inspectGuruNumerals($locale),
+                    \in_array($code, ['gu'], true) => $this->inspectGujrNumerals($locale),
+                    \in_array($code, ['or'], true) => $this->inspectOryaNumerals($locale),
+                    \in_array($code, ['ta'], true) => $this->inspectTamldecNumerals($locale),
+                    \in_array($code, ['te'], true) => $this->inspectTeluNumerals($locale),
+                    \in_array($code, ['kn'], true) => $this->inspectKndaNumerals($locale),
