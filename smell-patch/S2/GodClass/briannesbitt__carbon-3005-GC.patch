+    public function languageRegionName(?string $region): ?string
+    {
+        if ($region === null || $region === '') {
+            return null;
+        }
+        $catalog = $this->regionCatalogEntries();
+        $upper = strtoupper($region);
+        if (isset($catalog[$upper])) {
+            return $catalog[$upper];
+        }
+
+        return $region;
