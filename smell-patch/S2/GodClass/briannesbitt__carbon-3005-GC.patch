+    public function languageNamesFor(string $code): array
+    {
+        $catalog = $this->languageCatalogEntries();
+        $normalized = strtolower(str_replace('-', '_', $code));
+        $short = explode('_', $normalized)[0] ?? $normalized;
+        if (isset($catalog[$normalized])) {
+            return $catalog[$normalized];
+        }
+        if (isset($catalog[$short])) {
+            return $catalog[$short];
+        }
+
+        return [
+            'isoName' => $short,
+            'nativeName' => $short,
+        ];
+
+    }
