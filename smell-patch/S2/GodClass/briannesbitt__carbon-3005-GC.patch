+    private function pluralFormForCount(string $plural, int $count): string
+    {
+        $n = abs($count);
+        if ($plural === 'other') {
+            return 'other';
+        }
+        if ($plural === 'one-other') {
+            return $n === 1 ? 'one' : 'other';
+        }
+        if ($plural === 'few-many' || $plural === 'few-other') {
+            $mod10 = $n % 10;
+            $mod100 = $n % 100;
+            if ($mod10 >= 2 && $mod10 <= 4 && ($mod100 < 12 || $mod100 > 14)) {
+                return 'few';
+            }
+            return 'many';
+        }
+        if ($plural === 'one-two-few') {
+            if ($n === 1) {
+                return 'one';
+            }
+            if ($n === 2) {
+                return 'two';
+            }
+            return 'few';
+        }
+        if ($plural === 'zero-one-two-few-many') {
+            if ($n === 0) {
+                return 'zero';
+            }
+            if ($n === 1) {
+                return 'one';
+            }
+            if ($n === 2) {
+                return 'two';
+            }
+            return 'other';
+        }
+
+        return 'other';
+
+    }
