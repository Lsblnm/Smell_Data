+    def publishable_resource?(thing)
+      resource_marked_publishable?(thing) && !resource_hidden_in_future?(thing)
+    end
+
+    def resource_hidden_in_future?(thing)
+      thing.respond_to?(:date) && !future && thing.date.to_i > time.to_i
+    end
+
+    def resource_marked_publishable?(thing)
+      thing.data.fetch("published", true) || unpublished
+    end
