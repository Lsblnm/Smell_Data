+    def existing_destination_entries
+      files = Set.new
+      regex = keep_destination_file_regex
+      dirs = kept_destination_directories
+
+      Utils.safe_glob(in_dest_dir, ["**", "*"], File::FNM_DOTMATCH).each do |file|
+        next if Cleaner::HIDDEN_FILE_REGEX.match?(file) || regex.match?(file) || dirs.include?(file)
+
+        files << file
+      end
+
+      files
+    end
+
+    def planned_destination_files
+      @planned_destination_files ||= Set.new.tap do |files|
+        each_site_file { |item| files << item.destination(dest) }
+      end
+    end
+
+    def planned_destination_directories
+      @planned_destination_directories ||= planned_destination_files.flat_map { |file| parent_destination_directories(file) }.to_set
+    end
+
+    def parent_destination_directories(file)
+      parent_dir = File.dirname(file)
+      if parent_dir == dest
+        []
+      else
+        parent_destination_directories(parent_dir).unshift(parent_dir)
+      end
+    end
+
+    def replaced_destination_files
+      planned_destination_directories.select { |dir| File.file?(dir) }.to_set
+    end
+
+    def kept_destination_directories
+      keep_files.flat_map { |file| parent_destination_directories(in_dest_dir(file)) }.to_set
+    end
+
+    def keep_destination_file_regex
+      %r!\A#{Regexp.quote(dest)}/(#{Regexp.union(keep_files).source})!
