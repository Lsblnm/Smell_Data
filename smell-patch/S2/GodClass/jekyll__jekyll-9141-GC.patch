+    def posts_gathered_properly?
+      return true if config["collections_dir"].empty?
+
+      posts_at_root = in_source_dir("_posts")
+      return true unless File.directory?(posts_at_root)
+
+      Jekyll.logger.warn "Warning:",
+                         "Detected '_posts' directory outside custom `collections_dir`!"
+      Jekyll.logger.warn "",
+                         "Please move '#{posts_at_root}' into the custom directory at " \
+                         "'#{in_source_dir(config["collections_dir"])}'"
+      false
+    end
+
+    def deprecated_relative_permalinks_detected?
+      if config["relative_permalinks"]
+        Jekyll::Deprecator.deprecation_message "Your site still uses relative permalinks, " \
+                                               "which was removed in Jekyll v3.0.0."
+        true
+      end
+    end
+
+    def fsnotify_environment_healthy?
+      return true unless PathManager.fsevent_platform?
+
+      if Dir.pwd != `pwd`.strip
+        Jekyll.logger.error <<~STR
+          We have detected that there might be trouble using fsevent on your
+          operating system, you can read https://github.com/thibaudgg/rb-fsevent/wiki/no-fsevents-fired-(OSX-bug)
+          for possible work arounds or you can work around it immediately
+          with `--force-polling`.
+        STR
+
+        false
+      end
+
+      true
+    end
+
+    def urls_differ_only_by_case?
+      differed = false
+      case_insensitive_destination_urls(pages + docs_to_write, dest).each_value do |real_urls|
+        next unless real_urls.uniq.size > 1
+
+        differed = true
+        Jekyll.logger.warn "Warning:", "The following URLs only differ by case. On a " \
+                                       "case-insensitive file system one of the URLs will be " \
+                                       "overwritten by the other: #{real_urls.join(", ")}"
+      end
+      differed
+    end
+
+    def proper_configured_site_url?
+      url = config["url"]
+      [
+        configured_site_url_present?(url),
+        configured_site_url_parseable?(url),
+        configured_site_url_absolute?(url),
+      ].all?
+    end
+
+    def build_destination_conflict_map
+      {}.tap do |result|
+        each_site_file do |thing|
+          profile = profile_site_item(thing)
+          next unless include_item_in_destination_map?(thing, profile)
+
+          dest_path = resolve_profile_destination(thing, profile)
+          source_path = resolve_profile_source(thing, profile)
+          (result[dest_path] ||= []) << source_path
+        end
+      end
+    end
