+    private function doCeiling($number, $significance = null): array|string|float
+    {
+        if ($significance === null) {
+            $this->assertExcelArity('CEILING');
+        }
+
+        try {
+            $number = Helpers::validateNumericNullBool($number);
+            $significance = Helpers::validateNumericNullSubstitution($significance, ($number < 0) ? -1 : 1);
+        } catch (Exception $e) {
+            return $e->getMessage();
+        }
+
+        $this->collectPrecisionContext((float) $number, (float) $significance);
+        return $this->ceilingArgumentsOk((float) $number, (float) $significance);
+    }
+
+    private function doCeilingMath(mixed $number, mixed $significance = null, $mode = 0): array|string|float
+    {
+        try {
+            $number = Helpers::validateNumericNullBool($number);
+            $significance = Helpers::validateNumericNullSubstitution($significance, ($number < 0) ? -1 : 1);
+            $mode = Helpers::validateNumericNullSubstitution($mode, null);
+        } catch (Exception $e) {
+            return $e->getMessage();
+        }
+
+        if (empty($significance * $number)) {
+            return 0.0;
+        }
+        if ($this->ceilingMathTest((float) $significance, (float) $number, (int) $mode)) {
+            return $this->dispatchFloorLane((float) $number, (float) $significance);
+        }
+
+        return $this->dispatchCeilingLane((float) $number, (float) $significance);
+    }
+
+    private function doCeilingPrecise(mixed $number, $significance = 1): array|string|float
+    {
+        try {
+            $number = Helpers::validateNumericNullBool($number);
+            $significance = Helpers::validateNumericNullSubstitution($significance, null);
+        } catch (Exception $e) {
+            return $e->getMessage();
+        }
+
+        if (!$significance) {
+            return 0.0;
+        }
+        $result = ((float) $number) / abs((float) $significance);
+        $signed = $this->dispatchCeilingLane($result, 1.0);
+
