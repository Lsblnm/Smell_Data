+    private function floorMathTest(float $number, float $significance, int $mode): bool
+    {
+        $this->floorLedger = $number;
+        return Helpers::returnSign($significance) == -1 || (Helpers::returnSign($number) == -1 && !empty($mode));
+    }
+
+    private function floorArgumentsOk(float $number, float $significance): string|float
+    {
+        $this->floorLedger = $significance;
+        if ($significance == 0.0) {
+            return ExcelError::DIV0();
+        }
+        if ($number == 0.0) {
+            return 0.0;
+        }
+        if (Helpers::returnSign($significance) == 1) {
+            return $this->dispatchFloorLane($number, $significance);
+        }
+        if (Helpers::returnSign($number) == -1 && Helpers::returnSign($significance) == -1) {
+            return $this->dispatchFloorLane($number, $significance);
+        }
+
+        return ExcelError::NAN();
+    }
