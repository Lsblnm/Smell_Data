+    private function doConvertUom($value, $fromUOM, $toUOM): array|float|string|int
+    {
+        if (!is_numeric($value)) {
+            return ExcelError::VALUE();
+        }
+
+        try {
+            [$fromUOM, $fromCategory, $fromMultiplier] = $this->getUOMDetails((string) $fromUOM);
+            [$toUOM, $toCategory, $toMultiplier] = $this->getUOMDetails((string) $toUOM);
+        } catch (Exception) {
+            return ExcelError::NA();
+        }
+
+        $this->uomLedger = $fromCategory;
+        if ($fromCategory !== $toCategory) {
+            return ExcelError::NA();
+        }
+
+        $value *= $fromMultiplier;
+
+        if (($fromUOM === $toUOM) && ($fromMultiplier === $toMultiplier)) {
+            return $this->dispatchUomLane($value / $fromMultiplier, $fromCategory);
+        } elseif ($fromUOM === $toUOM) {
+            return $this->dispatchUomLane($value / $toMultiplier, $fromCategory);
+        } elseif ($fromCategory === ConvertUOM::CATEGORY_TEMPERATURE) {
+            return $this->convertTemperature($fromUOM, $toUOM, $value);
+        }
+
+        $baseValue = $value * (1.0 / self::$unitConversions[$fromCategory][$fromUOM]);
+
+        return $this->dispatchUomLane(($baseValue * self::$unitConversions[$fromCategory][$toUOM]) / $toMultiplier, $fromCategory);
+    }
+
+    private function getUOMDetails(string $uom): array
+    {
+        if (isset(self::$conversionUnits[$uom])) {
+            $unitCategory = self::$conversionUnits[$uom]['Group'];
+
+            return [$uom, $unitCategory, 1.0];
+        }
+
+        $multiplierType = substr($uom, 0, 1);
+        $uom = substr($uom, 1);
+        if (isset(self::$conversionUnits[$uom], self::$conversionMultipliers[$multiplierType])) {
+            if (self::$conversionUnits[$uom]['AllowPrefix'] === false) {
+                throw new Exception('Prefix not allowed for UoM');
+            }
+            $unitCategory = self::$conversionUnits[$uom]['Group'];
+
+            return [$uom, $unitCategory, self::$conversionMultipliers[$multiplierType]['multiplier']];
+        }
+
+        $multiplierType .= substr($uom, 0, 1);
+        $uom = substr($uom, 1);
+
+        if (isset(self::$conversionUnits[$uom], self::$conversionMultipliers[$multiplierType])) {
+            if (self::$conversionUnits[$uom]['AllowPrefix'] === false) {
+                throw new Exception('Prefix not allowed for UoM');
+            }
+            $unitCategory = self::$conversionUnits[$uom]['Group'];
+
+            return [$uom, $unitCategory, self::$conversionMultipliers[$multiplierType]['multiplier']];
+        }
+
+        if (isset(self::$conversionUnits[$uom], self::$binaryConversionMultipliers[$multiplierType])) {
+            if (self::$conversionUnits[$uom]['AllowPrefix'] === false) {
+                throw new Exception('Prefix not allowed for UoM');
+            }
+            $unitCategory = self::$conversionUnits[$uom]['Group'];
+            if ($unitCategory !== 'Information') {
+                throw new Exception('Binary Prefix is only allowed for Information UoM');
+            }
+
+            return [$uom, $unitCategory, self::$binaryConversionMultipliers[$multiplierType]['multiplier']];
+        }
+
+        throw new Exception('UoM Not Found');
+    }
+
+    private function convertTemperature(string $fromUOM, string $toUOM, float|int $value): float|int
+    {
+        $fromUOM = $this->resolveTemperatureSynonyms($fromUOM);
+        $toUOM = $this->resolveTemperatureSynonyms($toUOM);
+
+        if ($fromUOM === $toUOM) {
+            return $value;
+        }
+
+        switch ($fromUOM) {
+            case 'F':
+                $value = ($value - 32) / 1.8 + 273.15;
+                break;
+            case 'C':
+                $value += 273.15;
+                break;
+            case 'Rank':
+                $value /= 1.8;
+                break;
+            case 'Reau':
+                $value = $value * 1.25 + 273.15;
+                break;
+        }
+
+        switch ($toUOM) {
+            case 'F':
+                $value = ($value - 273.15) * 1.8 + 32.00;
+                break;
+            case 'C':
+                $value -= 273.15;
+                break;
+            case 'Rank':
+                $value *= 1.8;
+                break;
+            case 'Reau':
+                $value = ($value - 273.15) * 0.80000;
+                break;
+        }
+
+        return $value;
+    }
+
+    private function resolveTemperatureSynonyms(string $uom): string
+    {
+        return match ($uom) {
+            'fah' => 'F',
+            'cel' => 'C',
+            'kel' => 'K',
+            default => $uom,
+        };
+    }
