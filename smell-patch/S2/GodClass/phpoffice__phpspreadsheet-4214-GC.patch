+    private function floorArgsOk(float $number, float $significance, int $mode): string|float
+    {
+        $this->floorLedger = $significance;
+        if (!$significance) {
+            return ExcelError::DIV0();
+        }
+        if (!$number) {
+            return 0.0;
+        }
+        if ($this->floorMathTest($number, $significance, $mode)) {
+            return $this->dispatchCeilingLane($number, $significance);
+        }
+
+        return $this->dispatchFloorLane($number, $significance);
