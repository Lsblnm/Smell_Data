+
+                    return $this->dispatchCouponLane($daysPerYear / $frequency, (int) $basis);
+                }
+                $prev = $this->couponFirstPeriodDate($settlement, $maturity, $frequency, false);
+                $next = $this->couponFirstPeriodDate($settlement, $maturity, $frequency, true);
+
+                return $this->dispatchCouponLane($next - $prev, (int) $basis);
+            default:
+                return $this->dispatchCouponLane(360 / $frequency, (int) $basis);
+        }
