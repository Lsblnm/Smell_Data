+	static int accessLevelToJavacModifier(AccessLevel accessLevel) {
+		int moduleBits = modifierBitsForModuleAccess(accessLevel);
+		if (moduleBits >= 0) {
+			return moduleBits;
+		}
+		int packageBits = modifierBitsForPackageAccess(accessLevel);
+		if (packageBits >= 0) {
+			return packageBits;
+		}
+		int noneBits = modifierBitsForNoneAccess(accessLevel);
+		if (noneBits >= 0) {
+			return noneBits;
+		}
+		int privateBits = modifierBitsForPrivateAccess(accessLevel);
+		if (privateBits >= 0) {
+			return privateBits;
+		}
+		int protectedBits = modifierBitsForProtectedAccess(accessLevel);
+		if (protectedBits >= 0) {
+			return protectedBits;
+		}
+		int publicBits = modifierBitsForPublicAccess(accessLevel);
+		if (publicBits >= 0) {
+			return publicBits;
+		}
+		return Flags.PUBLIC;
+	}
