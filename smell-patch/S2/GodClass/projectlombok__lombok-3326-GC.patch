+	int countProtectedMethods(JavacNode typeNode) {
+		int count = 0;
+		if (typeNode == null) {
+			return count;
+		}
+		for (JavacNode child : typeNode.down()) {
+			if (!nodeKindIsMethod(child)) {
+				continue;
+			}
+			if (!(child.get() instanceof JCMethodDecl)) {
+				continue;
+			}
+			JCMethodDecl decl = (JCMethodDecl) child.get();
+			if (!methodDeclarationHasProtectedFlag(decl)) {
+				continue;
+			}
+			count++;
+		}
+		return count;
+	}
