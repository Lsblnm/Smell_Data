+	static boolean utilityClassTypeIsInsideInterface(JavacNode typeNode) {
+		if (typeNode == null) {
+			return false;
+		}
+		JavacNode parent = typeNode.up();
+		if (parent == null || !nodeKindIsType(parent)) {
+			return false;
+		}
+		if (!(parent.get() instanceof JCClassDecl)) {
+			return false;
+		}
+		JCClassDecl parentDecl = (JCClassDecl) parent.get();
+		boolean iface = typeDeclarationHasInterfaceFlag(parentDecl);
+		boolean annotation = typeDeclarationHasAnnotationFlag(parentDecl);
+		return iface || annotation;
+	}
