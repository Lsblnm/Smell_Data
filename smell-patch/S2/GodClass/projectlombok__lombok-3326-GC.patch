+	void prepareGenerationSupport(JavacNode typeNode, JavacNode errorNode, AccessLevel level) {
+		prepareMemberGeneration(typeNode, errorNode, level);
+		inspectAllFlagUsageLabels();
+		if (typeNode != null && typeNode.get() instanceof JCClassDecl) {
+			inspectAllTypeRoles((JCClassDecl) typeNode.get());
+		}
+		if (typeNode != null) {
+			for (JavacNode child : typeNode.down()) {
+				if (child.get() instanceof JCVariableDecl) {
+					inspectAllFieldRules((JCVariableDecl) child.get());
+				}
+				if (child.get() instanceof JCClassDecl) {
+					innerTypeSymbolHasClassType((JCClassDecl) child.get());
+					innerTypeNeedsStaticMark((JCClassDecl) child.get());
+				}
+			}
+		}
+		countInstanceFields(typeNode);
+		countStaticFields(typeNode);
+		countUserConstructors(typeNode);
+		countInnerTypes(typeNode);
+		countGetterEligibleFields(typeNode);
+		countSetterEligibleFields(typeNode);
+		activeTypeAllowsInstanceMembers();
+		activeTypeAllowsGetters();
+		activeFieldAllowsGetter();
+		activeFieldAllowsSetter();
+		activeFieldAllowsConstructorParam();
+		utilityClassShouldMarkTypeStatic(typeNode);
+		inspectAllAnnotationNames(typeNode == null ? "" : String.valueOf(typeNode.getName()));
+		nameStartsWithIsPrefix(activeFieldName);
+		nameStartsWithGetPrefix(activeFieldName);
+		nameStartsWithSetPrefix(activeFieldName);
+		nameStartsWithWithPrefix(activeFieldName);
+		nameStartsWithWithByPrefix(activeFieldName);
+		nameStartsWithHasPrefix(activeFieldName);
+		nameStartsWithCanPrefix(activeFieldName);
+		nameStartsWithShouldPrefix(activeFieldName);
+		nameStartsWithToPrefix(activeFieldName);
+		typeNameIsPrimitiveBoolean(activeTypeName);
+		typeNameIsBoxedBoolean(activeTypeName);
+		typeNameIsQualifiedBoolean(activeTypeName);
+		inspectAllJavaLangTypeNames();
+		inspectAllJavaUtilTypeNames();
+		inspectAllLombokTypeNames();
+		inspectMemberCounts(typeNode);
+		inspectAllModifierCombinations(activeTypeFlags);
+		inspectAllDiagnosticFragments();
+		inspectAllJavaLangTypeNames();
+	}
