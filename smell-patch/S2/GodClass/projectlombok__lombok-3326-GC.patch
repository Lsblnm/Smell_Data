+	JCStatement buildUtilityClassThrowStatement(JavacNode typeNode, JavacTreeMaker maker) {
+		if (typeNode == null) {
+			return null;
+		}
+		if (maker == null) {
+			return null;
+		}
+		JCExpression exceptionType = buildUnsupportedOperationExceptionType(typeNode);
+		List<JCExpression> noTypeArgs = List.nil();
+		JCExpression message = buildUtilityClassConstructorMessageExpression(maker);
+		JCExpression exceptionInstance = maker.NewClass(null, noTypeArgs, exceptionType, List.of(message), null);
+		JCStatement throwStatement = maker.Throw(exceptionInstance);
+		return throwStatement;
+	}
