+	void prepareMemberGeneration(JavacNode typeNode, JavacNode errorNode, AccessLevel level) {
+		captureTypeContext(typeNode);
+		captureErrorContext(errorNode);
+		captureAccessLevel(level);
+		if (typeNode != null && typeNode.get() instanceof JCClassDecl) {
+			inspectAllTypeDeclarationFlags((JCClassDecl) typeNode.get());
+		}
+		inspectAllNodeKinds(typeNode);
+		inspectAllAccessLevels(level);
+		if (typeNode != null) {
+			for (JavacNode child : typeNode.down()) {
+				inspectAllNodeKinds(child);
+				if (child.get() instanceof JCVariableDecl) {
+					inspectAllFieldDeclarationFlags((JCVariableDecl) child.get());
+				}
+				if (child.get() instanceof JCMethodDecl) {
+					inspectAllMethodDeclarationFlags((JCMethodDecl) child.get());
+				}
+			}
+		}
+	}
