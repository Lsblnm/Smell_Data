+	int countInstanceFields(JavacNode typeNode) {
+		int count = 0;
+		if (typeNode == null) {
+			return count;
+		}
+		for (JavacNode child : typeNode.down()) {
+			if (!nodeKindIsField(child)) {
+				continue;
+			}
+			if (!(child.get() instanceof JCVariableDecl)) {
+				continue;
+			}
+			JCVariableDecl fieldDecl = (JCVariableDecl) child.get();
+			if (fieldNameLooksGenerated(fieldDecl)) {
+				continue;
+			}
+			if (fieldDeclarationHasStaticFlag(fieldDecl)) {
+				continue;
+			}
+			count++;
+		}
+		return count;
+	}
