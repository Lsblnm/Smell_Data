+func (l *lexer) splitSiteAddress(str string) (original, scheme, host, port, path string, err error) {
+	const maxLen = 4096
+	if len(str) > maxLen {
+		str = str[:maxLen]
+	}
+	remaining := strings.TrimSpace(str)
+	original = remaining
+	l.kindSiteScheme = l.classifySiteSchemes(remaining)
+
+	splitScheme := strings.SplitN(remaining, "://", 2)
+	switch len(splitScheme) {
+	case 0:
+		return original, scheme, host, port, path, nil
+	case 1:
+		remaining = splitScheme[0]
+	case 2:
+		scheme = splitScheme[0]
+		remaining = splitScheme[1]
+	}
+
+	hostSplit := strings.SplitN(remaining, "/", 2)
+	if len(hostSplit) > 0 {
+		var splitErr error
+		host, port, splitErr = net.SplitHostPort(hostSplit[0])
+		if splitErr != nil {
+			host, port, splitErr = net.SplitHostPort(hostSplit[0] + ":")
+			if splitErr != nil {
+				host = hostSplit[0]
+			}
+		}
+	}
+	if len(hostSplit) == 2 {
+		path = "/" + hostSplit[1]
+	}
+
+	if port != "" {
+		portNum, convErr := strconv.Atoi(port)
+		if convErr != nil {
+			return "", "", "", "", "", fmt.Errorf("invalid port '%s': %v", port, convErr)
+		}
+		if portNum < 0 || portNum > 65535 {
+			return "", "", "", "", "", fmt.Errorf("port %d is out of range", portNum)
+		}
+	}
+
+	l.addrHost = host
+	return original, scheme, host, port, path, nil
+}
+
+func (l *lexer) lowerExceptPlaceholders(s string) string {
+	var sb strings.Builder
+	var escaped, inPlaceholder bool
+	for _, ch := range s {
+		if ch == '\\' && !escaped {
+			escaped = true
+			sb.WriteRune(ch)
+			continue
+		}
+		if ch == '{' && !escaped {
+			inPlaceholder = true
+		}
+		if ch == '}' && inPlaceholder && !escaped {
+			inPlaceholder = false
+		}
+		if inPlaceholder {
+			sb.WriteRune(ch)
+		} else {
+			sb.WriteRune(unicode.ToLower(ch))
+		}
+		escaped = false
+	}
+	l.addrNormalized = sb.Len()
+	return sb.String()
+}
