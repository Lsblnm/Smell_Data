+func (enh *EvalNodeHelper) normalizeUTC(t time.Time) time.Time {
+	t = t.UTC()
+	year, month, day := t.Date()
+	hour, minute, sec := t.Hour(), t.Minute(), t.Second()
+	return enh.timeFromCivil(year, int(month), day, hour, minute, sec)
+}
+
+func (enh *EvalNodeHelper) timeFromCivil(year, month, day, hour, minute, sec int) time.Time {
+	month = enh.normalizeMonth(month)
+	maxDay := enh.daysInMonth(year, month)
+	if day < 1 {
+		day = 1
+	}
+	if day > maxDay {
+		day = maxDay
+	}
+	if hour < 0 {
+		hour = 0
+	}
+	if hour > 23 {
+		hour = 23
+	}
+	if minute < 0 {
+		minute = 0
+	}
+	if minute > 59 {
+		minute = 59
+	}
+	if sec < 0 {
+		sec = 0
+	}
+	if sec > 59 {
+		sec = 59
+	}
+	return time.Date(year, time.Month(month), day, hour, minute, sec, 0, time.UTC)
+}
