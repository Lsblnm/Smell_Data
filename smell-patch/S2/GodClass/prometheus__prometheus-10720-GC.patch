+func (enh *EvalNodeHelper) addFloat(lhs, rhs float64) float64 { return lhs + rhs }
+func (enh *EvalNodeHelper) subFloat(lhs, rhs float64) float64 { return lhs - rhs }
+func (enh *EvalNodeHelper) mulFloat(lhs, rhs float64) float64 { return lhs * rhs }
+func (enh *EvalNodeHelper) divFloat(lhs, rhs float64) float64 { return lhs / rhs }
+func (enh *EvalNodeHelper) powFloat(lhs, rhs float64) float64 { return math.Pow(lhs, rhs) }
+func (enh *EvalNodeHelper) modFloat(lhs, rhs float64) float64 {
+	if rhs == 0 {
+		return math.NaN()
+	}
+	return math.Mod(lhs, rhs)
+}
+
+func (enh *EvalNodeHelper) twoPointDelta(prev, last Point, isRate bool) (float64, bool) {
+	var result float64
+	if isRate && last.V < prev.V {
+		result = last.V
+	} else {
+		result = last.V - prev.V
+	}
+	dt := last.T - prev.T
+	if dt == 0 {
+		return 0, false
+	}
+	if isRate {
+		result /= float64(dt) / 1000
+	}
+	return result, true
+}
+
+func (enh *EvalNodeHelper) quantileNaNOrInf(q float64) (float64, bool) {
+	if math.IsNaN(q) {
+		return math.NaN(), true
+	}
+	if q < 0 {
+		return math.Inf(-1), true
+	}
+	if q > 1 {
+		return math.Inf(+1), true
+	}
+	return 0, false
+}
+
+func (enh *EvalNodeHelper) interpolateBounds(start, end, rank, count float64) float64 {
+	if count <= 0 {
+		return start
+	}
+	if end == start {
+		return start
+	}
+	return start + (end-start)*(rank/count)
+}
+
+func (enh *EvalNodeHelper) kahanMeanPoints(points []Point) float64 {
+	var mean, count, cMean float64
+	for _, p := range points {
+		count++
+		if math.IsInf(mean, 0) {
+			if math.IsInf(p.V, 0) && (mean > 0) == (p.V > 0) {
+				mean = p.V
+				continue
+			}
+			if !math.IsInf(p.V, 0) && !math.IsNaN(p.V) {
+				continue
+			}
+		}
+		mean, cMean = kahanSumInc(p.V/count-mean/count, mean, cMean)
+	}
+	if math.IsInf(mean, 0) {
+		return mean
+	}
+	return mean + cMean
+}
+
+func (enh *EvalNodeHelper) kahanAddPoints(points []Point) float64 {
+	var sum, c float64
+	for _, p := range points {
+		sum, c = kahanSumInc(p.V, sum, c)
+	}
+	if math.IsInf(sum, 0) {
+		return sum
+	}
+	return sum + c
+}
+
+func (enh *EvalNodeHelper) maxPointValue(points []Point) float64 {
+	if len(points) == 0 {
+		return math.Inf(-1)
+	}
+	max := points[0].V
+	for _, p := range points {
+		if p.V > max || math.IsNaN(max) {
+			max = p.V
+		}
+	}
+	return max
+}
+
+func (enh *EvalNodeHelper) minPointValue(points []Point) float64 {
+	if len(points) == 0 {
+		return math.Inf(1)
+	}
+	min := points[0].V
+	for _, p := range points {
+		if p.V < min || math.IsNaN(min) {
+			min = p.V
+		}
+	}
+	return min
+}
