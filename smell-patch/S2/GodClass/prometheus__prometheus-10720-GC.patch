+		if matching.On {
+		Outer:
+			for _, l := range lhs {
+				for _, n := range matching.MatchingLabels {
+					if l.Name == n {
+						continue Outer
+					}
+				}
+				enh.lb.Del(l.Name)
+			}
+		} else {
+			enh.lb.Del(matching.MatchingLabels...)
+		}
+	}
+	for _, ln := range matching.Include {
+		if v := rhs.Get(ln); v != "" {
+			enh.lb.Set(ln, v)
+		} else {
+			enh.lb.Del(ln)
+		}
+	}
+}
