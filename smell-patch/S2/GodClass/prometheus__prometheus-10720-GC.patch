+func (enh *EvalNodeHelper) rangeDelta(isCounter bool) float64 {
+	pts := enh.rateWork
+	resultValue := pts[len(pts)-1].V - pts[0].V
+	if !isCounter {
+		return resultValue
+	}
+	var lastValue float64
+	for _, sample := range pts {
+		if sample.V < lastValue {
+			resultValue += lastValue
+		}
+		lastValue = sample.V
+	}
+	return resultValue
+}
