+func (enh *EvalNodeHelper) applyLabelReplace(vals []parser.Value, args parser.Expressions) Vector {
+	vector := vals[0].(Vector)
+	dst := enh.stringLiteral(args[1])
+	repl := enh.stringLiteral(args[2])
+	src := enh.stringLiteral(args[3])
+	regexStr := enh.stringLiteral(args[4])
+	if enh.regex == nil {
+		re, err := enh.compileReplaceRegex(regexStr)
+		if err != nil {
+			panic(errors.Errorf("invalid regular expression in label_replace(): %s", regexStr))
+		}
+		if !model.LabelNameRE.MatchString(dst) {
+			panic(errors.Errorf("invalid destination label name in label_replace(): %s", dst))
+		}
+		enh.regex = re
+		enh.Dmn = make(map[uint64]labels.Labels, len(enh.Out))
+	}
+	for _, el := range vector {
+		h := el.Metric.Hash()
+		outMetric, ok := enh.cachedMetric(h, el.Metric)
+		if !ok {
+			outMetric = enh.replaceLabelValue(el.Metric, dst, repl, src, enh.regex)
+			enh.storeCachedMetric(h, outMetric)
+		}
+		enh.Out = append(enh.Out, Sample{Metric: outMetric, Point: Point{V: el.Point.V}})
+	}
+	return enh.Out
+}
+
+func (enh *EvalNodeHelper) applyLabelJoin(vals []parser.Value, args parser.Expressions) Vector {
+	vector := vals[0].(Vector)
+	dst := enh.stringLiteral(args[1])
+	sep := enh.stringLiteral(args[2])
+	srcLabels := make([]string, len(args)-3)
+	if enh.Dmn == nil {
+		enh.Dmn = make(map[uint64]labels.Labels, len(enh.Out))
+	}
+	for i := 3; i < len(args); i++ {
+		src := enh.stringLiteral(args[i])
+		if !enh.validLabelName(src) {
+			panic(errors.Errorf("invalid source label name in label_join(): %s", src))
+		}
+		srcLabels[i-3] = src
+	}
+	if !enh.validLabelName(dst) {
+		panic(errors.Errorf("invalid destination label name in label_join(): %s", dst))
+	}
+	for _, el := range vector {
+		h := el.Metric.Hash()
+		outMetric, ok := enh.cachedMetric(h, el.Metric)
+		if !ok {
+			joined := enh.joinLabelValues(el.Metric, srcLabels, sep)
+			outMetric = enh.setOrDeleteLabel(el.Metric, dst, joined)
+			enh.storeCachedMetric(h, outMetric)
+		}
+		enh.Out = append(enh.Out, Sample{Metric: outMetric, Point: Point{V: el.Point.V}})
+	}
+	return enh.Out
+}
