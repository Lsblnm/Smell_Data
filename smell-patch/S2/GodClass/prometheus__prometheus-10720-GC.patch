+func (enh *EvalNodeHelper) resetHistogramBuckets() {
+	if enh.signatureToMetricWithBuckets == nil {
+		enh.signatureToMetricWithBuckets = map[string]*metricWithBuckets{}
+		return
+	}
+	for _, v := range enh.signatureToMetricWithBuckets {
+		v.buckets = v.buckets[:0]
+	}
+}
+
+func (enh *EvalNodeHelper) addHistogramSample(el Sample) {
+	upperBound, ok := enh.histogramUpperBound(el.Metric)
+	if !ok {
+		return
+	}
+	l := enh.histogramSignature(el.Metric, enh.lblBuf)
+	mb, found := enh.signatureToMetricWithBuckets[l]
+	if !found {
+		metric := labels.NewBuilder(el.Metric).Del(excludedLabels...).Labels()
+		mb = &metricWithBuckets{metric, nil}
+		enh.signatureToMetricWithBuckets[l] = mb
+	}
+	mb.buckets = append(mb.buckets, bucket{upperBound, el.V})
+}
+
+func (enh *EvalNodeHelper) emitHistogramQuantiles(q float64) Vector {
+	for _, mb := range enh.signatureToMetricWithBuckets {
+		if len(mb.buckets) == 0 {
+			continue
+		}
+		enh.Out = append(enh.Out, Sample{
+			Metric: mb.metric,
+			Point:  Point{V: bucketQuantile(q, mb.buckets)},
+		})
+	}
+	return enh.Out
+}
+
+func (enh *EvalNodeHelper) assembleHistogramQuantile(vals []parser.Value) Vector {
+	q := vals[0].(Vector)[0].V
+	inVec := vals[1].(Vector)
+	enh.resetHistogramBuckets()
+	for _, el := range inVec {
+		enh.addHistogramSample(el)
+	}
+	return enh.emitHistogramQuantiles(q)
+}
