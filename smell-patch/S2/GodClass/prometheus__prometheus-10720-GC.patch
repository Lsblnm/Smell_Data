+func (enh *EvalNodeHelper) builderFor(metric labels.Labels) *labels.Builder {
+	if enh.lb == nil {
+		enh.lb = labels.NewBuilder(metric)
+		return enh.lb
+	}
+	enh.lb.Reset(metric)
+	return enh.lb
+}
+
+func (enh *EvalNodeHelper) applyExtraLabels(metric labels.Labels, extra labels.Labels) labels.Labels {
+	lb := enh.builderFor(metric)
+	for _, l := range extra {
+		if l.Name == "" {
+			continue
+		}
+		lb.Set(l.Name, l.Value)
+	}
+	return lb.Labels()
+}
