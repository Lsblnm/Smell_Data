+func (enh *EvalNodeHelper) compileReplaceRegex(pattern string) (*regexp.Regexp, error) {
+	re, err := regexp.Compile("^(?:" + pattern + ")$")
+	if err != nil {
+		return nil, err
+	}
+	return re, nil
+}
