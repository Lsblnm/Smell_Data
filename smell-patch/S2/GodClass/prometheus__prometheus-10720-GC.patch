+func (enh *EvalNodeHelper) keepComparedValue(op parser.ItemType, lhs, rhs float64, swap, returnBool bool) (float64, bool) {
+	value, keep := enh.arithmeticOp(op, lhs, rhs)
+	if op.IsComparisonOperator() && swap {
+		value = rhs
+	}
+	if returnBool {
+		if keep {
+			value = 1
+		} else {
+			value = 0
+		}
+		keep = true
+	}
+	return value, keep
+}
+
+func (enh *EvalNodeHelper) vectorScalarBinop(op parser.ItemType, lhs Vector, rhs Scalar, swap, returnBool bool) Vector {
+	for _, lhsSample := range lhs {
+		lv, rv := lhsSample.V, rhs.V
+		if swap {
+			lv, rv = rv, lv
+		}
+		value, keep := enh.keepComparedValue(op, lv, rv, swap, returnBool)
+		if !keep {
+			continue
+		}
+		lhsSample.V = value
+		if shouldDropMetricName(op) || returnBool {
+			lhsSample.Metric = enh.DropMetricName(lhsSample.Metric)
+		}
+		enh.Out = append(enh.Out, lhsSample)
+	}
+	return enh.Out
+}
