+func (enh *EvalNodeHelper) countResets(points []Point) int {
+	if len(points) == 0 {
+		return 0
+	}
+	resets := 0
+	prev := points[0].V
+	for _, sample := range points[1:] {
+		if sample.V < prev {
+			resets++
+		}
+		prev = sample.V
+	}
+	return resets
+}
+
+func (enh *EvalNodeHelper) countChanges(points []Point) int {
+	if len(points) == 0 {
+		return 0
+	}
+	changes := 0
+	prev := points[0].V
+	for _, sample := range points[1:] {
+		current := sample.V
+		if current != prev && !(math.IsNaN(current) && math.IsNaN(prev)) {
+			changes++
+		}
+		prev = current
+	}
+	return changes
+}
