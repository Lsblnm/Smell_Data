+func (enh *EvalNodeHelper) vectorElementOp(op parser.ItemType, lhs, rhs float64) (float64, bool) {
+	switch op {
+	case parser.ADD, parser.SUB, parser.MUL, parser.DIV, parser.POW, parser.MOD, parser.ATAN2, parser.EQLC, parser.NEQ, parser.GTR, parser.LSS, parser.GTE, parser.LTE:
+		return enh.arithmeticOp(op, lhs, rhs)
+	default:
+		panic(errors.Errorf("operator %q not allowed for operations between Vectors", op))
+	}
+}
