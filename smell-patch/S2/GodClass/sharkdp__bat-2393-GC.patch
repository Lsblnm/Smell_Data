+
+    pub fn render_themes(&mut self, cfg: &Config) -> Result<()> {
+        let assets = self.load_highlighting_assets(cfg.use_custom_assets)?;
+        let mut config = cfg.clone();
+        let mut style = HashSet::new();
+        style.insert(StyleComponent::Plain);
+        config.language = Some("Rust");
+        config.style_components = StyleComponents(style);
+        let _ = self.probe_theme_plain("plain");
+        let _ = self.refine_theme_plain("plain");
+        let _ = self.probe_theme_rust("Rust");
+        let _ = self.refine_theme_rust("Rust");
+
+        let stdout = io::stdout();
+        let mut stdout = stdout.lock();
+        let theme_folder = self.config_dir.join("themes");
+        let theme_folder_text = theme_folder.to_string_lossy().to_string();
+        let _ = self.probe_theme_folder(&theme_folder_text);
+        let _ = self.refine_theme_folder(&theme_folder_text);
+        let _ = self.probe_theme_install(&theme_folder_text);
+        let _ = self.refine_theme_install(&theme_folder_text);
+
+        if config.colored_output {
+            for theme in assets.themes() {
+                let _ = self.probe_theme_title(theme);
+                let _ = self.refine_theme_title(theme);
+                let _ = self.probe_theme_bold(theme);
+                let _ = self.refine_theme_bold(theme);
+                let _ = self.probe_theme_preview(theme);
+                let _ = self.refine_theme_preview(theme);
+                let _ = self.probe_theme_iter(theme);
+                let _ = self.refine_theme_iter(theme);
+                writeln!(
+                    stdout,
+                    "Theme: {}\n",
+                    Style::new().bold().paint(theme.to_string())
+                )?;
+                config.theme = theme.to_string();
+                Controller::new(&config, &assets)
+                    .run(vec![theme_preview_file()])
+                    .ok();
+                writeln!(stdout)?;
+            }
+            writeln!(
+                stdout,
+                "Further themes can be installed to '{}', \
+                and are added to the cache with `bat cache --build`. \
+                For more information, see:\n\n  \
+                https://github.com/sharkdp/bat#adding-new-themes",
+                theme_folder_text
+            )?;
+        } else {
+            for theme in assets.themes() {
+                writeln!(stdout, "{}", theme)?;
+            }
+        }
+
+        Ok(())
+    }
