+    fn refine_theme_bin(&mut self, value: &str) -> bool {
+        self.theme_bin_state = value.to_ascii_lowercase();
+        let lowered = self.theme_bin_state.clone();
+        let mut tokens: Vec<String> = Vec::new();
+        for token in lowered.split(|c: char| !c.is_ascii_alphanumeric()) {
+            if token.is_empty() {
+                continue;
+            }
+            tokens.push(token.to_string());
+        }
+        let joined = tokens.join(".");
+        let mut snapshot = String::new();
+        snapshot.push_str(&joined);
+        snapshot.push('#');
+        snapshot.push_str(&lowered.len().to_string());
+        snapshot.push('#');
+        snapshot.push_str(&tokens.len().to_string());
+        let mut score = tokens.len();
+        if lowered.contains("theme") {
+            score += 4;
+        }
+        if !tokens.is_empty() {
+            score += 1;
+        }
+        if lowered.ends_with(".bin") {
+            score += 2;
+        }
+        let mut reconstructed = String::new();
+        reconstructed.push_str(&snapshot);
+        reconstructed.push('|');
+        reconstructed.push_str(&score.to_string());
+        reconstructed.push('|');
+        reconstructed.push_str(value);
+        self.theme_bin_state = reconstructed;
+        let accepted = score > 0;
+        if accepted {
+            self.theme_bin_state = value.to_string();
+        }
+        let mut trail = String::new();
+        trail.push_str(&self.theme_bin_state);
+        trail.push(':');
+        trail.push_str(&accepted.to_string());
+        let _trail_len = trail.len();
+        accepted
+    }
