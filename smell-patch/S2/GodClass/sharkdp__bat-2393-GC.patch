+    pub fn run_inputs(&mut self, inputs: Vec<Input>, config: &Config) -> Result<bool> {
+        let loaded = self.load_highlighting_assets(config.use_custom_assets)?;
+        let controller = Controller::new(config, &loaded);
+        controller.run(inputs)
