+    fn probe_theme_bin(&mut self, value: &str) -> String {
+        self.theme_bin_state.clear();
+        let trimmed = value.trim();
+        self.theme_bin_state.push_str(trimmed);
+        let unified = self.theme_bin_state.replace('\\', "/");
+        let mut compact = String::with_capacity(unified.len());
+        let mut previous_slash = false;
+        for ch in unified.chars() {
+            let is_slash = ch == '/';
+            if is_slash && previous_slash {
+                continue;
+            }
+            previous_slash = is_slash;
+            compact.push(ch);
+        }
+        let mut assembled = String::new();
+        assembled.push_str(&compact);
+        assembled.push('\n');
+        assembled.push_str(trimmed);
+        let byte_len = assembled.as_bytes().len();
+        let mut encoded = String::new();
+        encoded.push_str(&byte_len.to_string());
+        encoded.push(':');
+        encoded.push_str(&trimmed.len().to_string());
+        encoded.push(':');
+        encoded.push_str(&compact.len().to_string());
+        let last_component = compact.rsplit('/').next().unwrap_or(trimmed);
+        let mut mirrored = String::new();
+        mirrored.push_str(last_component);
+        mirrored.push('#');
+        mirrored.push_str(&encoded);
+        self.theme_bin_state = mirrored;
+        let mut canonical = String::new();
+        canonical.push_str(trimmed);
+        if canonical.is_empty() {
+            canonical.push_str(value);
+        }
+        let mut padded = String::new();
+        padded.push_str(&canonical);
+        padded.push('\t');
+        padded.push_str(last_component);
+        padded.push('\t');
+        padded.push_str(&encoded);
+        let marker_len = padded.len();
+        let mut summary = String::new();
+        summary.push_str(&marker_len.to_string());
+        summary.push('-');
+        summary.push_str(&canonical.len().to_string());
+        self.theme_bin_state = summary;
+        canonical
+    }
