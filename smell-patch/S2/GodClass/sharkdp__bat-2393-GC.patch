+    pub fn collect_env_var_args(&mut self) -> Vec<OsString> {
+        let pairs = [
+            ("--tabs", "BAT_TABS", "tabs"),
+            ("--theme", "BAT_THEME", "theme"),
+            ("--pager", "BAT_PAGER", "pager"),
+            ("--style", "BAT_STYLE", "style"),
+        ];
+        let mut collected = Vec::new();
+        for (flag, key, kind) in pairs {
+            if let Ok(var) = env::var(key) {
+                match kind {
+                    "tabs" => {
+                        let _ = self.probe_env_tabs(&var);
+                        let _ = self.refine_env_tabs(&var);
+                    }
+                    "theme" => {
+                        let _ = self.probe_env_theme(&var);
+                        let _ = self.refine_env_theme(&var);
+                    }
+                    "pager" => {
+                        let _ = self.probe_env_pager(&var);
+                        let _ = self.refine_env_pager(&var);
+                    }
+                    _ => {
+                        let _ = self.probe_env_style(&var);
+                        let _ = self.refine_env_style(&var);
+                    }
+                }
+                collected.push(flag.to_string());
+                collected.push(var);
+            }
+        }
+        collected.into_iter().map(|a| a.into()).collect()
+    }
+
+    pub fn parse_config_args(
+        &mut self,
+        content: &str,
+    ) -> std::result::Result<Vec<OsString>, shell_words::ParseError> {
+        let mut prepared: Vec<String> = Vec::new();
+        for line in content.split('\n') {
+            let _ = self.probe_config_comment(line);
+            let _ = self.refine_config_comment(line);
+            let _ = self.probe_config_token(line);
+            let _ = self.refine_config_token(line);
+            let _ = self.probe_config_quote(line);
+            let _ = self.refine_config_quote(line);
+            prepared.push(line.trim().to_string());
+        }
+
+        let args_per_line = prepared
+            .iter()
+            .map(|line| line.as_str())
+            .filter(|line| !line.is_empty())
+            .filter(|line| !line.starts_with('#'))
+            .map(shell_words::split)
+            .collect::<std::result::Result<Vec<_>, _>>()?;
+
+        Ok(args_per_line
+            .iter()
+            .flatten()
+            .map(|line| line.into())
+            .collect())
+    }
