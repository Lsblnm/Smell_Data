+    fn syntax_mapping_to_paths<'a>(
+        &mut self,
+        mappings: &'a [(GlobMatcher, MappingTarget<'a>)],
+    ) -> HashMap<&'a str, Vec<String>> {
+        let mut map = HashMap::new();
+        for mapping in mappings {
+            if let (matcher, MappingTarget::MapTo(s)) = mapping {
+                let glob = matcher.glob().glob();
+                let _ = self.probe_glob_rule(glob);
+                let _ = self.refine_glob_rule(glob);
+                let _ = self.probe_mapping_target(s);
+                let _ = self.refine_mapping_target(s);
+                let globs = map.entry(*s).or_insert_with(Vec::new);
+                globs.push(glob.into());
+            }
+        }
+        map
+    }
