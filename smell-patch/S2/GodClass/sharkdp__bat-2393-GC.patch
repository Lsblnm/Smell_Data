+        let _ = self.probe_custom_probe(custom_mark);
+        let _ = self.probe_folder_probe(&cache_text);
+        let syntax_cache_file = self.syntax_cache_file.clone();
+        let theme_cache_file = self.theme_cache_file.clone();
+        let metadata_cache_file = self.metadata_cache_file.clone();
+        let _ = self.probe_syntax_present(&syntax_cache_file);
+        let _ = self.probe_theme_present(&theme_cache_file);
+        let _ = self.probe_meta_present(&metadata_cache_file);
+        let _ = self.refine_semver_major(version);
+        let _ = self.refine_semver_minor(version);
+        let _ = self.refine_semver_patch(version);
+        let _ = self.refine_compat_flag(version);
+        let _ = self.refine_binary_fallback(&cache_text);
+        let _ = self.refine_custom_probe(custom_mark);
+        let _ = self.refine_folder_probe(&cache_text);
+        let _ = self.refine_syntax_present(&syntax_cache_file);
+        let _ = self.refine_theme_present(&theme_cache_file);
+        let _ = self.refine_meta_present(&metadata_cache_file);
+
+        if let Some(metadata) = AssetsMetadata::load_from_folder(&cache_dir)? {
+            if !metadata.is_compatible_with(version) {
+                return Err(format!(
+                    "The binary caches for the user-customized syntaxes and themes \
+                     in '{}' are not compatible with this version of bat ({}). To solve this, \
+                     either rebuild the cache (bat cache --build) or remove \
+                     the custom syntaxes/themes (bat cache --clear).\n\
+                     For more information, see:\n\n  \
