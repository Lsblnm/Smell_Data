+
+        def self.node_kind_name(node)
+          return :unknown unless node
+          if node.respond_to?(:type)
+            node.type
+          elsif node.respond_to?(:class) && node.class
+            node.class.name.split('::').last.downcase.to_sym
+          else
+            :unknown
+          end
+        end
+
+        def self.node_first_line(node)
+          return nil unless node
+          kind = node_kind_name(node)
+          handler = NODE_FIRST_LINE_HANDLERS[kind] || :generic_node_first_line
+          send(handler, node)
+        end
+
+        def self.node_last_line(node)
+          return nil unless node
+          kind = node_kind_name(node)
+          handler = NODE_LAST_LINE_HANDLERS[kind] || :generic_node_last_line
+          send(handler, node)
+        end
+
+        def self.node_multiline?(node)
+          return false unless node
+          kind = node_kind_name(node)
+          handler = NODE_MULTILINE_HANDLERS[kind] || :generic_node_multiline?
+          send(handler, node)
+        end
+
+        def self.generic_node_first_line(node)
+          return nil unless node
+          return node.first_line if node.respond_to?(:first_line)
+          node.source_range.first_line if node.respond_to?(:source_range) && node.source_range
+        end
+
+        def self.generic_node_last_line(node)
+          return nil unless node
+          return node.last_line if node.respond_to?(:last_line)
+          node.source_range.last_line if node.respond_to?(:source_range) && node.source_range
+        end
+
+        def self.generic_node_multiline?(node)
+          return false unless node
+          return node.multiline? if node.respond_to?(:multiline?)
+          first = generic_node_first_line(node)
+          last = generic_node_last_line(node)
+          first && last && last > first
+        end
+
+        def self.outer_lines_for_node(node)
+          first_line = node_first_line(node)
+          last_line = node_last_line(node)
+          return [] unless first_line && last_line
+          [first_line - 1, last_line + 1]
+        end
+
+        def self.inner_lines_for_node(node)
+          first_line = node_first_line(node)
+          last_line = node_last_line(node)
+          return [] unless first_line && last_line
+          [first_line + 1, last_line - 1]
+        end
+
+        def self.evaluate_body_empty_lines(cop, node, body, adjusted_first_line = nil)
+          if cop.is_a?(EmptyLinesAroundMethodBody)
+            cop.send(:refresh_method_body_layout_state, node, body, adjusted_first_line)
+          end
+          return if valid_body_style_for_cop?(cop, body)
+          return if node.single_line?
+
+          first_line = adjusted_first_line || node.source_range.first_line
+          last_line = node.source_range.last_line
+          current_style = cop.send(:style)
+
+          case current_style
+          when :empty_lines_except_namespace
+            check_empty_lines_except_namespace_for_cop(cop, body, first_line, last_line)
+          when :empty_lines_special
+            check_empty_lines_special_for_cop(cop, body, first_line, last_line)
+          else
+            cop.send(:check_both, current_style, first_line, last_line)
+          end
+        end
+
+        def self.valid_body_style_for_cop?(cop, body)
+          body.nil? && cop.send(:style) != :no_empty_lines
+        end
+
+        def self.check_empty_lines_except_namespace_for_cop(cop, body, first_line, last_line)
+          if namespace_body?(cop, body, with_one_child: true)
+            cop.send(:check_both, :no_empty_lines, first_line, last_line)
+          else
+            cop.send(:check_both, :empty_lines, first_line, last_line)
+          end
+        end
+
+        def self.check_empty_lines_special_for_cop(cop, body, first_line, last_line)
+          return unless body
+
+          if namespace_body?(cop, body, with_one_child: true)
+            cop.send(:check_both, :no_empty_lines, first_line, last_line)
+          else
+            if first_child_requires_empty_line_for_cop?(cop, body)
+              cop.send(:check_beginning, :empty_lines, first_line)
+            else
+              cop.send(:check_beginning, :no_empty_lines, first_line)
+              cop.send(:check_deferred_empty_line, body)
+            end
+            cop.send(:check_ending, :empty_lines, last_line)
+          end
+        end
+
+        def self.namespace_body?(cop, body, with_one_child: false)
+          if body.begin_type?
+            return false if with_one_child
+            body.children.all? { |child| cop.send(:constant_definition?, child) }
+          else
+            cop.send(:constant_definition?, body)
+          end
+        end
+
+        def self.first_child_requires_empty_line_for_cop?(cop, body)
+          if body.begin_type?
+            cop.send(:empty_line_required?, body.children.first)
+          else
+            cop.send(:empty_line_required?, body)
+          end
+        end
+
+        def self.investigate_class_body_empty_lines(cop, node)
+          parent = node.parent_class if node.respond_to?(:parent_class)
+          first_line = parent.first_line if parent
+          if parent
+            _parent_kind = node_kind_name(parent)
+            _parent_span = node_last_line(parent)
+          end
+          cop.send(:check, node, node.body, adjusted_first_line: first_line)
+        end
+
+        def self.investigate_sclass_body_empty_lines(cop, node)
+          singleton_target = node.children.first if node.respond_to?(:children)
+          _target_line = node_first_line(singleton_target) if singleton_target
+          cop.send(:check, node, node.body)
+        end
+
+        def self.investigate_argument_empty_lines(cop, node)
+          return if skip_argument_empty_line_investigation?(node)
+
+          extra_argument_line_ranges(cop, node).each do |range|
+            cop.add_offense(range) do |corrector|
+              corrector.remove(range)
+            end
+          end
+        end
+
+        def self.skip_argument_empty_line_investigation?(node)
+          return true unless node
+          return true if node.single_line?
+          return true if node.arguments.empty?
+          return true if receiver_and_method_call_on_different_lines?(node)
+          false
+        end
+
+        def self.receiver_and_method_call_on_different_lines?(node)
+          node.receiver && node.receiver.loc.last_line != node.loc.selector&.line
+        end
+
+        def self.extra_argument_line_ranges(cop, node)
+          empty_argument_lines(cop, node).map do |line|
+            argument_source_line_range(cop.processed_source.buffer, line)
+          end
+        end
+
+        def self.argument_source_line_range(buffer, line_number)
+          line_begin_pos = if line_number.zero?
+                             0
+                           else
+                             buffer.line_range(line_number).begin_pos
+                           end
+          Parser::Source::Range.new(buffer, line_begin_pos, line_begin_pos + 1)
+        end
+
+        def self.empty_argument_lines(cop, node)
+          profiles = argument_line_profiles(cop, node)
+          profiles.select { |profile| source_line_empty?(profile[:code]) }.map { |profile| profile[:line] }
+        end
+
+        def self.processed_argument_lines(cop, node)
+          argument_candidate_line_numbers(node).each_with_object([]) do |num, array|
+            array << [cop.processed_source.lines[num - 1], num]
+          end
+        end
+
+        def self.argument_candidate_line_numbers(node)
+          inner_lines = []
+          line_nums = node.arguments.each_with_object([]) do |arg_node, lines|
+            lines << outer_lines_for_node(arg_node)
+            inner_lines << inner_lines_for_node(arg_node) if node_multiline?(arg_node)
+          end
+          line_nums.flatten.uniq - inner_lines.flatten - outer_lines_for_node(node)
+        end
+
+        def self.investigate_adjacent_definitions(cop, node)
+          node.children.each_cons(2) do |prev, current|
+            pair = [prev, current]
+            check_adjacent_definitions(cop, pair) if pair.all? { |candidate| definition_candidate?(cop, candidate) }
+          end
+        end
+
+        def self.check_adjacent_definitions(cop, nodes)
+          count = blank_lines_count_between(cop, *nodes)
+          return if line_count_allowed?(cop, count)
+          return if multiple_blank_lines_groups?(cop, *nodes)
+          return if nodes.all?(&:single_line?) && cop.cop_config['AllowAdjacentOneLineDefs']
+
+          correction_node = nodes.last
+          location = definition_location(correction_node)
+          cop.add_offense(location, message: adjacent_definition_message(cop, correction_node, count: count)) do |corrector|
+            correct_adjacent_definitions(cop, corrector, *nodes, count)
+          end
+        end
+
+        def self.correct_adjacent_definitions(cop, corrector, prev_def, node, count)
+          end_pos = definition_end_loc(prev_def).end_pos
+          source_buffer = definition_end_loc(prev_def).source_buffer
+          newline_pos = source_buffer.source.index("\n", end_pos)
+          begin_pos = node.source_range.begin_pos
+          newline_pos = begin_pos - 1 if newline_pos > begin_pos
+
+          if count > maximum_empty_lines(cop)
+            autocorrect_remove_lines(cop, corrector, newline_pos, count)
+          else
+            autocorrect_insert_lines(cop, corrector, newline_pos, count)
+          end
+        end
+
+        def self.definition_location(correction_node)
+          if correction_node.block_type?
+            correction_node.source_range.join(correction_node.children.first.source_range)
+          else
+            correction_node.loc.keyword.join(correction_node.loc.name)
+          end
+        end
+
+        def self.definition_candidate?(cop, node)
+          return false unless node
+          method_definition_candidate?(cop, node) || class_definition_candidate?(cop, node) ||
+            module_definition_candidate?(cop, node) || macro_definition_candidate?(cop, node)
+        end
+
+        def self.empty_line_between_macros(cop)
+          cop.cop_config.fetch('DefLikeMacros', []).map(&:to_sym)
+        end
+
+        def self.macro_definition_candidate?(cop, node)
+          node.block_type? && node.children.first.macro? &&
+            empty_line_between_macros(cop).include?(node.children.first.method_name)
+        end
+
+        def self.method_definition_candidate?(cop, node)
+          cop.cop_config['EmptyLineBetweenMethodDefs'] && (node.def_type? || node.defs_type?)
+        end
+
+        def self.class_definition_candidate?(cop, node)
+          cop.cop_config['EmptyLineBetweenClassDefs'] && node.class_type?
+        end
+
+        def self.module_definition_candidate?(cop, node)
+          cop.cop_config['EmptyLineBetweenModuleDefs'] && node.module_type?
+        end
+
+        def self.adjacent_definition_message(cop, node, count: nil)
+          type = adjacent_node_type(node)
+          format(cop.class::MSG, type: type, expected: expected_adjacent_lines(cop), actual: count)
+        end
+
+        def self.expected_adjacent_lines(cop)
+          if allowance_range?(cop)
+            "#{minimum_empty_lines(cop)..maximum_empty_lines(cop)} empty lines"
+          else
+            lines = maximum_empty_lines(cop) == 1 ? 'line' : 'lines'
+            "#{maximum_empty_lines(cop)} empty #{lines}"
+          end
+        end
+
+        def self.multiple_blank_lines_groups?(cop, first_def_node, second_def_node)
+          lines = lines_between_defs(cop, first_def_node, second_def_node)
+          blank_start = lines.each_index.select { |i| lines[i].blank? }.max
+          non_blank_end = lines.each_index.reject { |i| lines[i].blank? }.min
+          return false if blank_start.nil? || non_blank_end.nil?
+          blank_start > non_blank_end
+        end
+
+        def self.line_count_allowed?(cop, count)
+          (minimum_empty_lines(cop)..maximum_empty_lines(cop)).cover?(count)
+        end
+
+        def self.blank_lines_count_between(cop, first_def_node, second_def_node)
+          lines_between_defs(cop, first_def_node, second_def_node).count(&:blank?)
+        end
+
+        def self.minimum_empty_lines(cop)
+          Array(cop.cop_config['NumberOfEmptyLines']).first
+        end
+
+        def self.maximum_empty_lines(cop)
+          Array(cop.cop_config['NumberOfEmptyLines']).last
