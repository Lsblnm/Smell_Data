+    protected function renderPersistedModifier($driver, $grammar, $column)
+    {
+        if ($driver !== 'sqlsrv') {
+            return null;
+        }
+        if ($column->change) {
+            if ($column->type === 'computed') {
+                return $column->persisted ? ' add persisted' : ' drop persisted';
+            }
+            return null;
+        }
+        return $column->persisted ? ' persisted' : null;
+    }
+
+    protected function renderDriverModifier($driver, $modifier, $grammar, $column)
+    {
+        if ($modifier === 'Unsigned') {
+            return $this->renderUnsignedModifier($driver, $grammar, $column);
+        }
+        if ($modifier === 'Charset') {
+            return $this->renderCharsetModifier($driver, $grammar, $column);
+        }
+        if ($modifier === 'Collate') {
+            return $this->renderCollateModifier($driver, $grammar, $column);
+        }
+        if ($modifier === 'VirtualAs') {
+            return $this->renderVirtualAsModifier($driver, $grammar, $column);
+        }
+        if ($modifier === 'StoredAs') {
+            return $this->renderStoredAsModifier($driver, $grammar, $column);
+        }
+        if ($modifier === 'Nullable') {
+            return $this->renderNullableModifier($driver, $grammar, $column);
+        }
+        if ($modifier === 'Default') {
+            return $this->renderDefaultModifier($driver, $grammar, $column);
+        }
+        if ($modifier === 'OnUpdate') {
+            return $this->renderOnUpdateModifier($driver, $grammar, $column);
+        }
+        if ($modifier === 'Invisible') {
+            return $this->renderInvisibleModifier($driver, $grammar, $column);
+        }
+        if ($modifier === 'Increment') {
+            return $this->renderIncrementModifier($driver, $grammar, $column);
+        }
+        if ($modifier === 'Comment') {
+            return $this->renderCommentModifier($driver, $grammar, $column);
+        }
+        if ($modifier === 'After') {
+            return $this->renderAfterModifier($driver, $grammar, $column);
+        }
+        if ($modifier === 'First') {
+            return $this->renderFirstModifier($driver, $grammar, $column);
+        }
+        if ($modifier === 'GeneratedAs') {
+            return $this->renderGeneratedAsModifier($driver, $grammar, $column);
+        }
+        if ($modifier === 'Persisted') {
+            return $this->renderPersistedModifier($driver, $grammar, $column);
+        }
+        return null;
+    }
