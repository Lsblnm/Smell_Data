+    protected function columnTypeSpecificationsForDriver($driver)
+    {
+        if ($driver === 'mariadb') {
+            return $this->mariadbColumnTypeSpecifications();
+        }
+        if ($driver === 'pgsql') {
+            return $this->pgsqlColumnTypeSpecifications();
+        }
+        if ($driver === 'sqlite') {
+            return $this->sqliteColumnTypeSpecifications();
+        }
+        if ($driver === 'sqlsrv') {
+            return $this->sqlsrvColumnTypeSpecifications();
+        }
+        return $this->mysqlColumnTypeSpecifications();
+    }
+
+    protected function mysqlModifierSequence()
+    {
+        return ['Unsigned', 'Charset', 'Collate', 'VirtualAs', 'StoredAs', 'Nullable', 'Default', 'OnUpdate', 'Invisible', 'Increment', 'Comment', 'After', 'First'];
+    }
+
+    protected function mariadbModifierSequence()
+    {
+        return ['Unsigned', 'Charset', 'Collate', 'VirtualAs', 'StoredAs', 'Nullable', 'Default', 'OnUpdate', 'Invisible', 'Increment', 'Comment', 'After', 'First'];
+    }
+
+    protected function pgsqlModifierSequence()
+    {
+        return ['Collate', 'Nullable', 'Default', 'VirtualAs', 'StoredAs', 'GeneratedAs', 'Increment'];
+    }
+
+    protected function sqliteModifierSequence()
+    {
+        return ['Increment', 'Nullable', 'Default', 'Collate', 'VirtualAs', 'StoredAs'];
+    }
+
+    protected function sqlsrvModifierSequence()
+    {
+        return ['Collate', 'Nullable', 'Default', 'Persisted', 'Increment'];
+    }
+
+    protected function driverModifierSequence($driver)
+    {
+        if ($driver === 'mariadb') {
+            return $this->mariadbModifierSequence();
+        }
+        if ($driver === 'pgsql') {
+            return $this->pgsqlModifierSequence();
+        }
+        if ($driver === 'sqlite') {
+            return $this->sqliteModifierSequence();
+        }
+        if ($driver === 'sqlsrv') {
+            return $this->sqlsrvModifierSequence();
+        }
+        return $this->mysqlModifierSequence();
+    }
+
+    protected function compileSpecifiedColumnType($driver, $column, $grammar)
+    {
+        $specs = $this->columnTypeSpecificationsForDriver($driver);
+        $type = $this->normalizeSchemaTypeAlias($column->type);
+        if (! isset($specs[$type])) {
+            return null;
+        }
+        $spec = $this->annotateColumnTypeSpec($driver, $specs[$type]);
+        if (! empty($spec['raw'])) {
+            return $column->offsetGet('definition');
+        }
+        if (! empty($spec['supports_serial']) && ! empty($spec['serial_keyword']) && $column->autoIncrement && is_null($column->generatedAs) && ! $column->change) {
+            return $spec['serial_keyword'];
+        }
+        if (! empty($spec['current'])) {
+            $this->applyTemporalCurrentDefault($driver, $column, $spec);
+        }
+        if ($type === 'binary') {
+            return $this->compileBinaryFromSpec($driver, $column, $spec);
+        }
+        if (! empty($spec['quoted_allowed'])) {
+            return $spec['keyword'].'('.$grammar->quoteString($column->allowed).')';
+        }
+        if (! empty($spec['check_in'])) {
+            return $this->compileCheckedEnumFromSpec($driver, $column, $spec, $grammar);
+        }
+        $sql = $this->keywordForColumnType($driver, $type);
+        if (! empty($spec['precision_keyword']) && $column->precision) {
+            return $spec['precision_keyword'].'('.$column->precision.')';
+        }
+        if (! empty($spec['length']) && empty($spec['length_optional']) && $column->length) {
+            $sql .= '('.$column->length.')';
+        }
+        if (! empty($spec['length_optional']) && $column->length) {
+            $sql .= '('.$column->length.')';
+        }
+        if (! empty($spec['precision']) && $column->precision && empty($spec['timezone'])) {
+            $sql .= '('.$column->precision.')';
+        }
+        if (! empty($spec['total'])) {
+            $sql .= '('.$column->total.', '.$column->places.')';
+        }
+        if (! empty($spec['timezone'])) {
+            $precision = is_null($column->precision) ? '' : '('.$column->precision.')';
+            $sql .= $precision.' '.$spec['timezone'];
+        }
+        return $sql;
+    }
+
+    protected function applyTemporalCurrentDefault($driver, $column, $spec)
+    {
+        if (! $column->useCurrent) {
+            if (! empty($spec['current_on_update']) && $column->useCurrentOnUpdate) {
+                $current = $column->precision ? "CURRENT_TIMESTAMP($column->precision)" : 'CURRENT_TIMESTAMP';
+                $column->onUpdate(new Expression($current));
+            }
+            return $column;
+        }
+        if ($driver === 'mysql' || $driver === 'mariadb') {
+            $current = $column->precision ? "CURRENT_TIMESTAMP($column->precision)" : 'CURRENT_TIMESTAMP';
+            $column->default(new Expression($current));
+            if (! empty($spec['current_on_update']) && $column->useCurrentOnUpdate) {
+                $column->onUpdate(new Expression($current));
+            }
+            return $column;
+        }
+        $column->default(new Expression('CURRENT_TIMESTAMP'));
+        return $column;
+    }
+
+    protected function compileBinaryFromSpec($driver, $column, $spec)
+    {
+        if ($driver === 'pgsql') {
+            return 'bytea';
+        }
+        if ($driver === 'sqlite') {
+            return 'blob';
+        }
+        if ($column->length) {
+            if ($column->fixed) {
+                return 'binary('.$column->length.')';
+            }
+            return 'varbinary('.$column->length.')';
+        }
+        if ($driver === 'sqlsrv') {
+            return 'varbinary(max)';
+        }
+        return $spec['keyword'];
+    }
+
+    protected function compileCheckedEnumFromSpec($driver, $column, $spec, $grammar)
+    {
+        $allowed = $grammar->quoteString($column->allowed);
+        if ($driver === 'pgsql') {
+            return sprintf('varchar(255) check ("%s" in (%s))', $column->name, $allowed);
+        }
+        if ($driver === 'sqlite') {
+            return sprintf('varchar check ("%s" in (%s))', $column->name, $allowed);
+        }
+        return sprintf('nvarchar(255) check ("%s" in (%s))', $column->name, $allowed);
+    }
+
+    public function compileGrammarColumnType($grammar, $column)
+    {
+        $driver = $this->resolveSchemaGrammarDriver($grammar);
+        if (! $this->isKnownSchemaDriver($driver)) {
+            $driver = 'mysql';
+        }
+        $this->rememberColumnTypeResolution($driver, $column->type ?? '');
+        $rendered = $this->compileSpecifiedColumnType($driver, $column, $grammar);
+        if ($rendered !== null) {
+            return $rendered;
+        }
+        return $grammar->typeNameForColumn($column);
+    }
+
+    protected function renderUnsignedModifier($driver, $grammar, $column)
+    {
+        if (! $this->driverSupportsUnsignedIntegers($driver)) {
+            return null;
+        }
+        return $column->unsigned ? ' unsigned' : null;
+    }
+
+    protected function renderCharsetModifier($driver, $grammar, $column)
+    {
+        if (! $this->driverSupportsCharsetModifiers($driver) || is_null($column->charset)) {
+            return null;
+        }
+        return ' character set '.$column->charset;
+    }
+
+    protected function renderCollateModifier($driver, $grammar, $column)
+    {
+        if (is_null($column->collation)) {
+            return null;
+        }
+        if ($driver === 'pgsql') {
+            return ' collate '.$grammar->wrapKeyword($column->collation);
+        }
+        if ($driver === 'sqlsrv') {
+            return ' collate '.$column->collation;
+        }
+        return " collate '{$column->collation}'";
+    }
+
+    protected function renderNullableModifier($driver, $grammar, $column)
+    {
+        if ($driver === 'pgsql' && $column->change) {
+            return $column->nullable ? 'drop not null' : 'set not null';
+        }
+        if ($driver === 'sqlsrv' && $column->type === 'computed') {
+            return null;
+        }
+        $generated = ! is_null($column->virtualAs) || ! is_null($column->virtualAsJson) || ! is_null($column->storedAs) || ! is_null($column->storedAsJson);
+        if ($driver === 'mysql' || $driver === 'mariadb') {
+            if (! $generated) {
+                return $column->nullable ? ' null' : ' not null';
+            }
+            return $column->nullable === false ? ' not null' : null;
+        }
+        if (! $this->driverEmitsExplicitNullKeyword($driver)) {
+            if (! $generated) {
+                return $column->nullable ? '' : ' not null';
+            }
+            return $column->nullable === false ? ' not null' : null;
+        }
+        return $column->nullable ? ' null' : ' not null';
+    }
+
+    protected function renderDefaultModifier($driver, $grammar, $column)
+    {
+        if ($driver === 'pgsql' && $column->change) {
+            if (! $column->autoIncrement || ! is_null($column->generatedAs)) {
+                return is_null($column->default) ? 'drop default' : 'set default '.$grammar->formatDefaultValue($column->default);
+            }
+            return null;
+        }
+        if ($driver === 'sqlsrv' && $column->change) {
+            return null;
+        }
+        if ($driver === 'sqlite') {
+            if (! is_null($column->default) && is_null($column->virtualAs) && is_null($column->virtualAsJson) && is_null($column->storedAs)) {
+                return ' default '.$grammar->formatDefaultValue($column->default);
+            }
+            return null;
+        }
+        if (! is_null($column->default)) {
+            return ' default '.$grammar->formatDefaultValue($column->default);
+        }
+        return null;
