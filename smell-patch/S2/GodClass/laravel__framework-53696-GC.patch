+    protected function renderOnUpdateModifier($driver, $grammar, $column)
+    {
+        if (($driver !== 'mysql' && $driver !== 'mariadb') || is_null($column->onUpdate)) {
+            return null;
+        }
+        return ' on update '.$grammar->getValue($column->onUpdate);
+    }
+
+    protected function renderInvisibleModifier($driver, $grammar, $column)
+    {
+        if (! $this->driverSupportsInvisibleColumns($driver) || is_null($column->invisible)) {
+            return null;
+        }
+        return ' invisible';
+    }
+
+    protected function renderIncrementModifier($driver, $grammar, $column)
+    {
+        $serials = $grammar->serialTypeNames();
+        if (! in_array($column->type, $serials, true) || ! $column->autoIncrement) {
+            return null;
+        }
+        if ($driver === 'mysql' || $driver === 'mariadb') {
+            if ($grammar->hasBlueprintCommand($this, 'primary') || ($column->change && ! $column->primary)) {
+                return ' auto_increment';
+            }
+            return ' auto_increment primary key';
+        }
+        if ($driver === 'sqlite') {
+            return ' primary key autoincrement';
+        }
+        if ($driver === 'sqlsrv' && ! $column->change) {
+            return $grammar->hasBlueprintCommand($this, 'primary') ? ' identity' : ' identity primary key';
+        }
+        return null;
+    }
