+    protected function renderVirtualAsModifier($driver, $grammar, $column)
+    {
+        if (! is_null($virtualAs = $column->virtualAsJson)) {
+            if ($grammar->jsonSelector($virtualAs)) {
+                $virtualAs = $grammar->wrappedJsonSelector($virtualAs);
+            }
+            return " as ({$virtualAs})";
+        }
+        if (! is_null($virtualAs = $column->virtualAs)) {
+            return " as ({$grammar->getValue($virtualAs)})";
+        }
+        return null;
+    }
