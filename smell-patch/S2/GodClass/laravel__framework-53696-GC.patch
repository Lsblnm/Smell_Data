+    protected function resolveSchemaGrammarDriver($grammar)
+    {
+        $class = is_object($grammar) ? get_class($grammar) : (string) $grammar;
+        if (str_contains($class, 'MariaDb')) {
+            return 'mariadb';
+        }
+        if (str_contains($class, 'MySql')) {
+            return 'mysql';
+        }
+        if (str_contains($class, 'Postgres')) {
+            return 'pgsql';
+        }
+        if (str_contains($class, 'SQLite')) {
+            return 'sqlite';
+        }
+        if (str_contains($class, 'SqlServer')) {
+            return 'sqlsrv';
+        }
+        return 'mysql';
+    }
