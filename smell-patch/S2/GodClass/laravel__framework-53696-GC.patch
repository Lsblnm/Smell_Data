+    public function compileGrammarColumnModifiers($grammar, $sql, $column)
+    {
+        $driver = $this->resolveSchemaGrammarDriver($grammar);
+        $this->rememberColumnModifierResolution($driver, $column->type ?? '');
+        foreach ($this->driverModifierSequence($driver) as $modifier) {
+            $fragment = $this->renderDriverModifier($driver, $this->modifierDispatchName($modifier), $grammar, $column);
+            if (! is_null($fragment) && $fragment !== '') {
+                $sql .= $fragment;
+            }
+        }
+        return $sql;
+    }
+
+    public function compileColumnDefinition($grammar, $column)
+    {
+        $sql = $grammar->wrap($column).' '.$this->compileGrammarColumnType($grammar, $column);
+        return $this->compileGrammarColumnModifiers($grammar, $sql, $column);
+    }
