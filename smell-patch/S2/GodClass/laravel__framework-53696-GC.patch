+    public function compileMysqlColumnsSql($grammar, $database, $table)
+    {
+        $this->rememberSchemaCatalogResolution('mysql', $this->catalogOperationName('columns'));
+        $select = implode(', ', [
+            $this->mysqlColumnsNameExpression(),
+            $this->mysqlColumnsTypeNameExpression(),
+            $this->mysqlColumnsTypeExpression(),
+            $this->mysqlColumnsCollationExpression(),
+            $this->mysqlColumnsNullableExpression(),
+            $this->mysqlColumnsDefaultExpression(),
+            $this->mysqlColumnsCommentExpression(),
+            $this->mysqlColumnsGenerationExpression(),
+            $this->mysqlColumnsExtraExpression(),
+        ]);
+        return sprintf(
+            'select '.$select.' '.$this->mysqlColumnsFromClause().' '.$this->mysqlColumnsWhereClause().' '.$this->mysqlColumnsOrderClause(),
+            $grammar->quoteString($database),
+            $grammar->quoteString($table)
+        );
+    }
