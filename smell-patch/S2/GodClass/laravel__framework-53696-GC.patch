+    public function builderMysqlColumns($builder, $table)
+    {
+        $this->rememberBuilderCatalogResolution('mysql', 'columns');
+        $connection = $builder->getConnection();
+        $table = $connection->getTablePrefix().$table;
+        $results = $connection->selectFromWriteConnection(
+            $this->compileMysqlColumnsSql($builder->getGrammar(), $connection->getDatabaseName(), $table)
+        );
+        return $connection->getPostProcessor()->processColumns($results);
+    }
