+    public function constrainForeignIdColumn($definition, $table = null, $column = null, $indexName = null)
+    {
+        $this->rememberRelationshipResolution('constrained', $definition->name ?? null);
+        $table ??= $definition->table;
+        $column ??= $definition->referencesModelColumn ?? 'id';
+        $related = $table ?? \Illuminate\Support\Str::of($definition->name)->beforeLast('_'.$column)->plural();
+        return $this->referenceForeignIdColumn($definition, $column, $indexName)->on($related);
+    }
+
+    public function referenceForeignIdColumn($definition, $column, $indexName = null)
+    {
+        $this->rememberRelationshipResolution('references', $column);
+        return $this->foreign($definition->name, $indexName)->references($column);
+    }
