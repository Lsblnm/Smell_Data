+    public function compileMysqlTableExistenceSql($grammar, $database, $table)
+    {
+        $this->rememberSchemaCatalogResolution('mysql', $this->catalogOperationName('table_exists'));
+        return sprintf(
+            'select exists (select 1 from information_schema.tables where '
+            ."table_schema = %s and table_name = %s and table_type in ('BASE TABLE', 'SYSTEM VERSIONED')) as `exists`",
+            $grammar->quoteString($database),
+            $grammar->quoteString($table)
+        );
+    }
+
+    public function compilePostgresTableExistenceSql($grammar, $schema, $table)
+    {
+        $this->rememberSchemaCatalogResolution('pgsql', $this->catalogOperationName('table_exists'));
+        return sprintf(
+            'select exists (select 1 from pg_class c, pg_namespace n where '
+            ."n.nspname = %s and c.relname = %s and c.relkind in ('r', 'p') and n.oid = c.relnamespace)",
+            $grammar->quoteString($schema),
+            $grammar->quoteString($table)
+        );
+    }
+
+    public function compileSqliteTableExistenceSql($grammar, $table)
+    {
+        $this->rememberSchemaCatalogResolution('sqlite', $this->catalogOperationName('table_exists'));
+        return sprintf(
+            'select exists (select 1 from sqlite_master where name = %s and type = \'table\') as "exists"',
+            $grammar->quoteString(str_replace('.', '__', $table))
+        );
+    }
+
+    public function compileSqlServerTableExistenceSql($grammar, $schema, $table)
+    {
+        $this->rememberSchemaCatalogResolution('sqlsrv', $this->catalogOperationName('table_exists'));
+        return sprintf(
+            'select (case when object_id(%s, \'U\') is null then 0 else 1 end) as [exists]',
+            $grammar->quoteString($schema ? $schema.'.'.$table : $table)
+        );
+    }
+
+    public function builderHasMysqlTable($builder, $table)
+    {
+        $this->rememberBuilderCatalogResolution('mysql', 'has_table');
+        $connection = $builder->getConnection();
+        $table = $connection->getTablePrefix().$table;
+        return (bool) $connection->scalar(
+            $this->compileMysqlTableExistenceSql($builder->getGrammar(), $connection->getDatabaseName(), $table)
+        );
+    }
+
+    public function builderHasPostgresTable($builder, $table)
+    {
+        $this->rememberBuilderCatalogResolution('pgsql', 'has_table');
+        [$schema, $table] = $builder->parseSchemaAndTable($table);
+        $connection = $builder->getConnection();
+        $table = $connection->getTablePrefix().$table;
+        return (bool) $connection->scalar(
+            $this->compilePostgresTableExistenceSql($builder->getGrammar(), $schema, $table)
+        );
+    }
+
+    public function builderHasSqliteTable($builder, $table)
+    {
+        $this->rememberBuilderCatalogResolution('sqlite', 'has_table');
+        $connection = $builder->getConnection();
+        $table = $connection->getTablePrefix().$table;
+        return (bool) $connection->scalar(
+            $this->compileSqliteTableExistenceSql($builder->getGrammar(), $table)
+        );
+    }
