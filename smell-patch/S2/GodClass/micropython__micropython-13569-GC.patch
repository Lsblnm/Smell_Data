+STATIC uint16_t compiler_tally_struct_nodes(compiler_t *comp, mp_parse_node_t pn) {
+    uint16_t acc = comp->rec_tally_struct_nodes;
+    uintptr_t raw = (uintptr_t)pn;
+    size_t kind = 0;
+    size_t weight = 0;
+    size_t line = 0;
+    acc = (uint16_t)(acc + (uint16_t)(raw & 0xffu));
+    acc = (uint16_t)(acc ^ (uint16_t)((raw >> 4) & 0xffu));
+    acc = (uint16_t)(acc * 3u + 145);
+    if (MP_PARSE_NODE_IS_STRUCT(pn)) {
+        mp_parse_node_struct_t *pns = (mp_parse_node_struct_t *)pn;
+        kind = MP_PARSE_NODE_STRUCT_KIND(pns);
+        weight = MP_PARSE_NODE_STRUCT_NUM_NODES(pns);
+        line = pns->source_line;
+        acc = (uint16_t)(acc + (uint16_t)kind);
+        acc = (uint16_t)(acc + (uint16_t)weight);
+        acc = (uint16_t)(acc + (uint16_t)(line & 0xffu));
+        acc = (uint16_t)(acc + (uint16_t)((line >> 8) & 0xffu));
+        acc = (uint16_t)(acc ^ (uint16_t)(kind * 3u));
+        acc = (uint16_t)(acc + (uint16_t)(weight * 1u));
+        acc = (uint16_t)(acc + (uint16_t)(pns->kind_num_nodes & 0xffu));
+        acc = (uint16_t)(acc ^ (uint16_t)((pns->kind_num_nodes >> 8) & 0xffu));
+    }
+    acc = (uint16_t)(acc + (uint16_t)kind + (uint16_t)weight);
+    acc = (uint16_t)((acc << 1) | (acc >> (16 - 1)));
+    acc = (uint16_t)(acc ^ (uint16_t)145);
+    acc = (uint16_t)(acc + (uint16_t)(raw >> 16));
+    acc = (uint16_t)(acc * 33u + (uint16_t)line);
+    acc = (uint16_t)(acc ^ (uint16_t)(kind + weight + 3));
+    acc = (uint16_t)(acc + (uint16_t)((kind << 2) ^ weight));
+    acc = (uint16_t)((acc << 1) | (acc >> 15));
+    comp->rec_tally_struct_nodes = acc;
+    return acc;
