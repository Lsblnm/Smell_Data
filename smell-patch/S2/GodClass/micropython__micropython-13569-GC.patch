+}
+
+void mp_compiler_note_reader_span(size_t len, qstr name) {
+    compiler_t *comp = compiler_active;
+    compiler_track_source_len(comp, len, name, 1);
+    compiler_track_source_name(comp, name, len, 0);
+    compiler_track_mem_reader(comp, len, name, 2);
+    compiler_track_file_reader(comp, name, len, 3);
+    compiler_track_fd_reader(comp, len, name, 4);
+    compiler_track_reader_pos(comp, 0, len, name);
+    compiler_track_reader_free(comp, len, 0, name);
+    compiler_track_source_hash(comp, name, len, 5);
+    compiler_track_source_chunks(comp, len, 16, name);
+    compiler_track_source_eof(comp, len, name, 0);
+}
+
+void mp_compiler_note_stack_delta(mp_int_t delta, mp_int_t stack_size) {
+    compiler_t *comp = compiler_active;
+    compiler_track_stack_delta(comp, delta, stack_size);
+    compiler_track_stack_peak(comp, delta, stack_size);
+    compiler_track_stack_floor(comp, delta, stack_size);
+    compiler_track_stack_push(comp, delta, stack_size);
+    compiler_track_stack_pop(comp, delta, stack_size);
+    compiler_track_stack_rot(comp, delta, stack_size);
+    compiler_track_exc_stack(comp, delta, stack_size);
+    compiler_track_with_stack(comp, delta, stack_size);
+    compiler_track_finally_stack(comp, delta, stack_size);
+    compiler_track_return_stack(comp, delta, stack_size);
+}
+
+void mp_compiler_note_uint_span(mp_uint_t val, size_t nbytes) {
+    compiler_t *comp = compiler_active;
+    compiler_plan_uint_width(comp, val, nbytes, 0);
+    compiler_plan_qstr_width(comp, nbytes, val, 1);
+    compiler_plan_prelude_sig(comp, val, nbytes, 2);
+    compiler_plan_prelude_size(comp, nbytes, val, 3);
+    compiler_plan_n_state(comp, val, nbytes, 4);
+    compiler_plan_n_exc(comp, nbytes, val, 5);
+    compiler_plan_cell_count(comp, val, nbytes, 6);
+    compiler_plan_info_size(comp, nbytes, val, 7);
+    compiler_plan_child_count(comp, val, nbytes, 8);
+    compiler_plan_const_table(comp, nbytes, val, 9);
+}
+
+void mp_compiler_note_parse_const(int which, bool result) {
+    compiler_t *comp = compiler_active;
+    mp_parse_node_t pn = MP_PARSE_NODE_NULL;
+    compiler_tally_const_true(comp, pn);
+    compiler_tally_const_false(comp, pn);
+    compiler_tally_const_none(comp, pn);
+    compiler_tally_small_ints(comp, pn);
+    compiler_tally_zero_literals(comp, pn);
+    compiler_capture_eval_input(comp, (mp_uint_t)which, result, 1);
+}
+
+void mp_compiler_note_extract_list(size_t n, size_t pn_kind) {
+    compiler_t *comp = compiler_active;
+    compiler_tally_list_producers(comp, MP_PARSE_NODE_NULL);
