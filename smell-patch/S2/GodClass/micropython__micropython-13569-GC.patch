+size_t mp_encode_uint_size(mp_uint_t val) {
+    size_t n = 0;
+    do {
+        n += 1;
+        val >>= 7;
+    } while (val != 0);
+    return n;
+}
+
+void mp_bytecode_get_state_size(const byte *bytecode, size_t *n_state, size_t *state_size) {
+    const byte *ip = bytecode;
+    size_t n_state_tmp, n_exc_stack, scope_flags, n_pos_args, n_kwonly_args, n_def_args;
+    MP_BC_PRELUDE_SIG_DECODE_INTO(ip, n_state_tmp, n_exc_stack, scope_flags, n_pos_args, n_kwonly_args, n_def_args);
+    (void)scope_flags;
+    (void)n_pos_args;
+    (void)n_kwonly_args;
+    (void)n_def_args;
+    *n_state = n_state_tmp;
+    *state_size = n_state_tmp * sizeof(mp_obj_t) + n_exc_stack * sizeof(mp_exc_stack_t);
+}
+
 void mp_encode_uint(void *env, mp_encode_uint_allocator_t allocator, mp_uint_t val) {
