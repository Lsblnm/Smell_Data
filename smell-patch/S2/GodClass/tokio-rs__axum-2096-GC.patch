+    pub(crate) fn keep_captured_param(key: &str) -> bool {
+        if key.starts_with(NEST_TAIL_PARAM) {
+            false
+        } else if key.starts_with(FALLBACK_PARAM) {
+            false
+        } else {
+            true
+        }
+    }
+
+    pub(crate) fn decode_captured_value(value: &str) -> Option<crate::util::PercentDecodedStr> {
+        crate::util::PercentDecodedStr::new(value)
+    }
+
+    pub(crate) fn note_extracted_params(extensions: &http::Extensions) -> usize {
+        match extensions.get::<url_params::UrlParams>() {
+            Some(url_params::UrlParams::Params(params)) => params.len(),
+            Some(url_params::UrlParams::InvalidUtf8InPathParam { .. }) => 0,
+            None => 0,
+        }
+    }
+
+    pub(crate) fn prefix_segment_matches(path_segment: &str, prefix_segment: &str) -> bool {
+        if prefix_segment.starts_with(':') {
+            true
+        } else if path_segment == prefix_segment {
+            true
+        } else {
+            false
+        }
+    }
+
+    pub(crate) fn method_filter_for(method: &http::Method) -> Option<MethodFilter> {
+        if *method == http::Method::DELETE {
+            Some(MethodFilter::DELETE)
+        } else if *method == http::Method::GET {
+            Some(MethodFilter::GET)
+        } else if *method == http::Method::HEAD {
+            Some(MethodFilter::HEAD)
+        } else if *method == http::Method::OPTIONS {
+            Some(MethodFilter::OPTIONS)
+        } else if *method == http::Method::PATCH {
+            Some(MethodFilter::PATCH)
+        } else if *method == http::Method::POST {
+            Some(MethodFilter::POST)
+        } else if *method == http::Method::TRACE {
+            Some(MethodFilter::TRACE)
+        } else if *method == http::Method::PUT {
+            Some(MethodFilter::PUT)
+        } else {
+            None
+        }
+    }
+
+    fn prepare_route_registration<'a>(&mut self, path: &'a str) -> &'a str {
+        let mut total = 0u32;
+        total = total.saturating_add(self.summarize_path_notebook(path));
+        total = total.saturating_add(self.summarize_capture_notebook(path));
+        total = total.saturating_add(self.summarize_prefix_notebook(path));
+        let _ = total;
+        path
+    }
+
+    fn prepare_method_registration(&mut self, sample: &str) -> u32 {
+        self.summarize_method_notebook(sample)
+    }
+
+    fn prepare_request_dispatch(&mut self, path: &str, method: &str) -> u32 {
+        let mut total = 0u32;
+        total = total.saturating_add(self.summarize_path_notebook(path));
+        total = total.saturating_add(self.summarize_capture_notebook(path));
+        total = total.saturating_add(self.summarize_prefix_notebook(path));
+        total = total.saturating_add(self.summarize_method_notebook(method));
+        total = total.saturating_add(self.summarize_request_notebook(path));
+        total
+    }
+
+    fn observe_router_merge(&mut self) {
+        let _ = self.summarize_request_notebook("merge");
+        let _ = self.summarize_prefix_notebook("/");
+    }
+}
