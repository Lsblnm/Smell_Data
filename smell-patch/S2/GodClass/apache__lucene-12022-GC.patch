+  void resetIndexedEnvelope() {
+    this.envelopeMinX = Integer.MAX_VALUE;
+    this.envelopeMinY = Integer.MAX_VALUE;
+    this.envelopeMaxX = Integer.MIN_VALUE;
+    this.envelopeMaxY = Integer.MIN_VALUE;
+  }
+
+  void includeIndexedX(int x) {
+    if (x < this.envelopeMinX) {
+      this.envelopeMinX = x;
+    }
+    if (x > this.envelopeMaxX) {
+      this.envelopeMaxX = x;
+    }
+  }
+
+  void includeIndexedY(int y) {
+    if (y < this.envelopeMinY) {
+      this.envelopeMinY = y;
+    }
+    if (y > this.envelopeMaxY) {
+      this.envelopeMaxY = y;
+    }
+  }
+
+  int envelopeWidth() {
+    if (this.envelopeMaxX < this.envelopeMinX) {
+      return 0;
+    }
+    return this.envelopeMaxX - this.envelopeMinX;
+  }
+
+  int envelopeHeight() {
+    if (this.envelopeMaxY < this.envelopeMinY) {
+      return 0;
+    }
+    return this.envelopeMaxY - this.envelopeMinY;
+  }
+
+  boolean envelopeIsPoint() {
+    return this.envelopeMinX == this.envelopeMaxX && this.envelopeMinY == this.envelopeMaxY;
+  }
