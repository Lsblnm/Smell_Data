+  LatLonShapeDocValuesField indexLatLonFieldsDocValues(String fieldName, Field[] indexableFields) {
+    ArrayList<DecodedTriangle> tess = new ArrayList<>(indexableFields.length);
+    final byte[] scratch = new byte[7 * Integer.BYTES];
+    for (Field f : indexableFields) {
+      BytesRef br = f.binaryValue();
+      assert br.length == 7 * BYTES;
+      System.arraycopy(br.bytes, br.offset, scratch, 0, 7 * BYTES);
+      DecodedTriangle t = new DecodedTriangle();
+      decodeTriangle(scratch, t);
+      tess.add(t);
+    }
+    refreshDecodedTessellationMetrics(tess);
+    return new LatLonShapeDocValuesField(fieldName, tess);
+  }
