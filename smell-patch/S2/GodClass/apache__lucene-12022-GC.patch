+  void refreshLatLonPolygonMetrics(Polygon polygon, boolean checkSelfIntersections) {
+    if (polygon == null) {
+      throw new IllegalArgumentException("polygon must not be null");
+    }
+    this.selfIntersectionFlag = checkSelfIntersections;
+    foldAllGeometryMetrics(polygon.minLon, polygon.maxLon, polygon.minLat, polygon.maxLat, polygon.numPoints());
+    Polygon[] holes = polygon.getHoles();
+    if (holes != null && holes.length > 0) {
+      foldAllGeometryMetrics(
+          holes[0].minLon, holes[0].maxLon, holes[0].minLat, holes[0].maxLat, holes[0].numPoints());
+    }
+  }
