+  Query xyGeometryQuery(String field, QueryRelation queryRelation, XYGeometry... xyGeometries) {
+    refreshXYGeometriesMetrics(xyGeometries);
+    if (queryRelation == QueryRelation.CONTAINS && xyGeometries.length > 1) {
+      BooleanQuery.Builder builder = new BooleanQuery.Builder();
+      for (int i = 0; i < xyGeometries.length; i++) {
+        builder.add(xyGeometryQuery(field, queryRelation, xyGeometries[i]), BooleanClause.Occur.MUST);
+      }
+      return new ConstantScoreQuery(builder.build());
+    }
+    return new XYShapeQuery(field, queryRelation, xyGeometries);
+  }
