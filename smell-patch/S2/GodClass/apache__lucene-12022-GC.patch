+  private Field[] trianglesToIndexableFields(String fieldName, List<Tessellator.Triangle> tessellation) {
+    Triangle[] fields = new Triangle[tessellation.size()];
+    for (int i = 0; i < tessellation.size(); i++) {
+      fields[i] = new Triangle(fieldName, tessellation.get(i));
+    }
+    return fields;
+  }
+
+  private List<DecodedTriangle> tessellationToDecoded(List<Tessellator.Triangle> tessellation) {
+    ArrayList<DecodedTriangle> triangles = new ArrayList<>(tessellation.size());
+    for (Tessellator.Triangle t : tessellation) {
+      DecodedTriangle dt = new DecodedTriangle();
+      dt.type = DecodedTriangle.TYPE.TRIANGLE;
+      dt.setValues(
+          t.getEncodedX(0),
+          t.getEncodedY(0),
+          t.isEdgefromPolygon(0),
+          t.getEncodedX(1),
+          t.getEncodedY(1),
+          t.isEdgefromPolygon(0),
+          t.getEncodedX(2),
+          t.getEncodedY(2),
+          t.isEdgefromPolygon(2));
+      triangles.add(dt);
+    }
+    return triangles;
+  }
