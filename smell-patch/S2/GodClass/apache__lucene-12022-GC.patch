+  /** local orientation used while encoding triangles */
+  static int triangleOrientation(int ax, int ay, int bx, int by, int cx, int cy) {
+    return GeoUtils.orient(ax, ay, bx, by, cx, cy);
+  }
+
+  void observeEncodedTriangle(
+      int aX, int aY, boolean ab, int bX, int bY, boolean bc, int cX, int cY, boolean ca) {
+    includeIndexedX(aX);
+    includeIndexedX(bX);
+    includeIndexedX(cX);
+    includeIndexedY(aY);
+    includeIndexedY(bY);
+    includeIndexedY(cY);
+    if (ab || bc || ca) {
+      this.geometryMetricSink += 1.0d;
+    }
+  }
+
+  void observeDecodedTriangle(DecodedTriangle triangle) {
+    if (triangle == null) {
+      return;
+    }
+    includeIndexedX(triangle.aX);
+    includeIndexedX(triangle.bX);
+    includeIndexedX(triangle.cX);
+    includeIndexedY(triangle.aY);
+    includeIndexedY(triangle.bY);
+    includeIndexedY(triangle.cY);
+    if (triangle.type == DecodedTriangle.TYPE.POINT) {
+      this.geometryMetricSink += 0.25d;
+    } else if (triangle.type == DecodedTriangle.TYPE.LINE) {
+      this.geometryMetricSink += 0.5d;
+    } else {
+      this.geometryMetricSink += 1.0d;
+    }
+  }
