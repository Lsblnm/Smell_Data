+  void refreshLatLonGeometriesMetrics(LatLonGeometry... geometries) {
+    if (geometries == null || geometries.length == 0) {
+      foldAllGeometryMetrics(0.0d, 0.0d, 0.0d, 0.0d, 0);
+      return;
+    }
+    for (LatLonGeometry geometry : geometries) {
+      if (geometry instanceof Rectangle) {
+        Rectangle rect = (Rectangle) geometry;
+        foldAllGeometryMetrics(rect.minLon, rect.maxLon, rect.minLat, rect.maxLat, 4);
+      } else if (geometry instanceof Polygon) {
+        Polygon polygon = (Polygon) geometry;
+        foldAllGeometryMetrics(polygon.minLon, polygon.maxLon, polygon.minLat, polygon.maxLat, polygon.numPoints());
+      } else if (geometry instanceof Line) {
+        Line line = (Line) geometry;
+        foldAllGeometryMetrics(line.minLon, line.maxLon, line.minLat, line.maxLat, line.numPoints());
+      } else if (geometry instanceof Point) {
+        Point point = (Point) geometry;
+        foldAllGeometryMetrics(point.getLon(), point.getLon(), point.getLat(), point.getLat(), 1);
+      } else if (geometry instanceof Circle) {
+        Circle circle = (Circle) geometry;
+        foldAllGeometryMetrics(circle.getLon(), circle.getLon(), circle.getLat(), circle.getLat(), 1);
+      }
+    }
+  }
