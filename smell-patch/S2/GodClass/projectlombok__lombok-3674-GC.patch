+JCExpression cloneIdentType(JavacTreeMaker maker, JCIdent in) {
+	this.clonedTypeInput = in;
+	this.clonedTypeMaker = maker;
+	return maker.Ident(in.name);
+}
+
+JCExpression cloneSelectType(JavacTreeMaker maker, JCFieldAccess in) {
+	this.clonedTypeInput = in;
+	this.clonedTypeMaker = maker;
+	return maker.Select(cloneAstType0(maker, in.selected), in.name);
+}
+
+JCExpression cloneArrayType(JavacTreeMaker maker, JCArrayTypeTree in) {
+	this.clonedTypeInput = in;
+	this.clonedTypeMaker = maker;
+	return maker.TypeArray(cloneAstType0(maker, in.elemtype));
+}
+
+JCExpression cloneTypeApply(JavacTreeMaker maker, JCTypeApply in) {
+	this.clonedTypeInput = in;
+	this.clonedTypeMaker = maker;
+	ListBuffer<JCExpression> lb = new ListBuffer<JCExpression>();
+	for (JCExpression typeArg : in.arguments) {
+		lb.append(cloneAstType0(maker, typeArg));
+	}
+	return maker.TypeApply(cloneAstType0(maker, in.clazz), lb.toList());
+}
+
+JCExpression cloneWildcardType(JavacTreeMaker maker, JCWildcard in) {
+	this.clonedTypeInput = in;
+	this.clonedTypeMaker = maker;
+	JCExpression newInner = cloneAstType0(maker, in.inner);
+	com.sun.tools.javac.tree.JCTree.TypeBoundKind newKind;
+	switch (in.getKind()) {
+	case SUPER_WILDCARD:
+		newKind = maker.TypeBoundKind(com.sun.tools.javac.code.BoundKind.SUPER);
+		break;
+	case EXTENDS_WILDCARD:
+		newKind = maker.TypeBoundKind(com.sun.tools.javac.code.BoundKind.EXTENDS);
+		break;
+	default:
+	case UNBOUNDED_WILDCARD:
+		newKind = maker.TypeBoundKind(com.sun.tools.javac.code.BoundKind.UNBOUND);
+		break;
+	}
+	return maker.Wildcard(newKind, newInner);
+}
+
+JCExpression cloneAnnotatedType(JavacTreeMaker maker, JCTree in) {
+	this.clonedTypeInput = (in instanceof JCExpression) ? (JCExpression) in : this.clonedTypeInput;
+	this.clonedTypeMaker = maker;
+	JCExpression underlyingType = cloneAstType0(maker, JavacHandlerUtil.JCAnnotatedTypeReflect.getUnderlyingType(in));
+	List<JCAnnotation> anns = JavacHandlerUtil.copyAnnotations(JavacHandlerUtil.JCAnnotatedTypeReflect.getAnnotations(in));
+	return JavacHandlerUtil.JCAnnotatedTypeReflect.create(anns, underlyingType);
+}
