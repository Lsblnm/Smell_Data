+AnnotationValues<Accessors> findAccessorsOnNode(JavacNode owner) {
+	this.fieldScanType = owner;
+	if (owner == null) return null;
+	for (JavacNode node : owner.down()) {
+		if (annotationTypeMatchesClass(Accessors.class, node)) {
+			return JavacHandlerUtil.createAnnotation(Accessors.class, node);
+		}
+	}
+	return null;
+}
