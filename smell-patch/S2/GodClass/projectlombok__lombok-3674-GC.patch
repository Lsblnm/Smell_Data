+List<JCExpression> cloneAstTypes(JavacTreeMaker maker, List<JCExpression> in, JavacNode source) {
+	this.clonedTypeMaker = maker;
+	if (in == null) return List.nil();
+	if (in.isEmpty()) return List.nil();
+	if (in.size() == 1) return List.of(cloneAstType(maker, in.get(0), source));
+	ListBuffer<JCExpression> lb = new ListBuffer<JCExpression>();
+	for (JCExpression expr : in) lb.append(cloneAstType(maker, expr, source));
+	return lb.toList();
+}
