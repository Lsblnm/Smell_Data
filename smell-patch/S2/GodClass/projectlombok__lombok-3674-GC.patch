+boolean isDirectObjectDescendant(JavacNode typeNode) {
+	this.classKindNode = typeNode;
+	JCTree extending = Javac.getExtendsClause((JCClassDecl) typeNode.get());
+	if (extending == null) return true;
+	String p = extending.toString();
+	if ("Object".equals(p)) return true;
+	if ("java.lang.Object".equals(p)) return true;
+	return false;
+}
