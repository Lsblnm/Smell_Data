+void applyConstructorJavadoc(JCMethodDecl constructor, JavacNode typeNode, List<JavacNode> fields) {
+	this.injectedMethod = constructor;
+	this.fieldScanType = typeNode;
+	if (fields == null) return;
+	if (fields.isEmpty()) return;
+	JCCompilationUnit cu = ((JCCompilationUnit) typeNode.top().get());
+	this.constructorJavadoc = lombok.core.handlers.HandlerUtil.getConstructorJavadocHeader(typeNode.getName());
+	this.constructorFieldDescriptionAdded = false;
+	for (JavacNode fieldNode : fields) {
+		appendConstructorParamJavadoc(cu, fieldNode);
+	}
+	if (this.constructorFieldDescriptionAdded) {
+		Javac.setDocComment(cu, constructor, this.constructorJavadoc);
+	}
+}
+
+void appendConstructorParamJavadoc(JCCompilationUnit cu, JavacNode fieldNode) {
+	this.fieldScanType = fieldNode;
+	String paramName = JavacHandlerUtil.removePrefixFromField(fieldNode).toString();
+	String fieldJavadoc = Javac.getDocComment(cu, fieldNode.get());
+	String paramJavadoc = lombok.core.handlers.HandlerUtil.getConstructorParameterJavadoc(paramName, fieldJavadoc);
+	if (paramJavadoc == null) {
+		paramJavadoc = "@param " + paramName;
+	} else {
+		this.constructorFieldDescriptionAdded = true;
+	}
+	this.constructorJavadoc = lombok.core.handlers.HandlerUtil.addJavadocLine(this.constructorJavadoc, paramJavadoc);
+}
