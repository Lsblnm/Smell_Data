+JCExpression cloneAstType(JavacTreeMaker maker, JCExpression in, JavacNode source) {
+	this.clonedTypeMaker = maker;
+	this.clonedTypeInput = in;
+	JCExpression out = cloneAstType0(maker, in);
+	if (out != null) JavacHandlerUtil.recursiveSetGeneratedBy(out, source);
+	return out;
+}
+
+JCExpression cloneAstType0(JavacTreeMaker maker, JCTree in) {
+	this.clonedTypeMaker = maker;
+	if (in == null) return null;
+	if (in instanceof JCPrimitiveTypeTree) return clonePrimitiveType(maker, (JCPrimitiveTypeTree) in);
+	if (in instanceof JCIdent) return cloneIdentType(maker, (JCIdent) in);
+	if (in instanceof JCFieldAccess) return cloneSelectType(maker, (JCFieldAccess) in);
+	if (in instanceof JCArrayTypeTree) return cloneArrayType(maker, (JCArrayTypeTree) in);
+	if (in instanceof JCTypeApply) return cloneTypeApply(maker, (JCTypeApply) in);
+	if (in instanceof JCWildcard) return cloneWildcardType(maker, (JCWildcard) in);
+	if (JavacHandlerUtil.JCAnnotatedTypeReflect.is(in)) return cloneAnnotatedType(maker, in);
+	return (JCExpression) in;
+}
+
+JCExpression clonePrimitiveType(JavacTreeMaker maker, JCPrimitiveTypeTree in) {
+	this.clonedTypeInput = in;
+	this.clonedTypeMaker = maker;
+	return maker.TypeIdent(lombok.javac.JavacTreeMaker.TypeTag.typeTag(in));
+}
