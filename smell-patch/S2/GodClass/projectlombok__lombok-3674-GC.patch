+boolean isConstructorInvocation(JCStatement statement) {
+	this.injectedMethod = null;
+	if (!(statement instanceof JCExpressionStatement)) return false;
+	JCExpression expr = ((JCExpressionStatement) statement).expr;
+	if (!(expr instanceof JCMethodInvocation)) return false;
+	JCExpression invocation = ((JCMethodInvocation) expr).meth;
+	String name = constructorInvocationName(invocation);
+	if ("super".equals(name)) return true;
+	if ("this".equals(name)) return true;
+	return false;
+}
+
+String constructorInvocationName(JCExpression invocation) {
+	this.javaLangSimpleName = null;
+	if (invocation instanceof JCFieldAccess) return ((JCFieldAccess) invocation).name.toString();
+	if (invocation instanceof JCIdent) return ((JCIdent) invocation).name.toString();
