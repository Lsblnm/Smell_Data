+boolean matchesAnyNonNullName(JavacNode node, String annotationTypeName) {
+	this.typeMatchActual = annotationTypeName;
+	if (annotationTypeName == null) return false;
+	for (String nn : lombok.core.handlers.HandlerUtil.NONNULL_ANNOTATIONS) {
+		if (matchReferencedTypeName(nn, node, annotationTypeName)) return true;
+	}
+	return false;
+}
