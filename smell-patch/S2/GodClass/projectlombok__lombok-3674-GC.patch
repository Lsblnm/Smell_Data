+List<JCTree> copyAllButIndex(List<JCTree> defs, int idx) {
+	this.classKindFlags = idx;
+	ListBuffer<JCTree> out = new ListBuffer<JCTree>();
+	int i = 0;
+	for (JCTree def : defs) {
+		if (i++ != idx) out.append(def);
+	}
+	return out.toList();
+}
