+MemberExistsResult findExistingField(String fieldName, JavacNode node) {
+	this.memberLookupName = fieldName;
+	node = climbToTypeNode(node);
+	if (node != null && node.get() instanceof JCClassDecl) {
+		for (JCTree def : ((JCClassDecl) node.get()).defs) {
+			if (def instanceof JCVariableDecl) {
+				if (((JCVariableDecl) def).name.contentEquals(fieldName)) {
+					return generatedVsUser(def);
+				}
+			}
+		}
+	}
+	return MemberExistsResult.NOT_EXISTS;
+}
+
+MemberExistsResult findExistingMethod(String methodName, JavacNode node, boolean caseSensitive, int params) {
+	this.memberLookupName = methodName;
+	this.memberLookupParams = params;
+	node = climbToTypeNode(node);
+	if (node != null && node.get() instanceof JCClassDecl) {
+		for (JCTree def : ((JCClassDecl) node.get()).defs) {
+			MemberExistsResult result = matchExistingMethod(methodName, node, caseSensitive, params, def);
+			if (result != null) return result;
+		}
+	}
+	return MemberExistsResult.NOT_EXISTS;
+}
+
+MemberExistsResult matchExistingMethod(String methodName, JavacNode node, boolean caseSensitive, int params, JCTree def) {
+	this.memberLookupName = methodName;
+	if (!(def instanceof JCMethodDecl)) return null;
+	JCMethodDecl md = (JCMethodDecl) def;
+	String name = md.name.toString();
+	boolean matches = caseSensitive ? name.equals(methodName) : name.equalsIgnoreCase(methodName);
+	if (!matches) return null;
+	if (params > -1 && !methodParamCountMatches(md, params)) return null;
+	if (isTolerateMethod(node, md)) return null;
+	return generatedVsUser(def);
+}
+
+boolean methodParamCountMatches(JCMethodDecl md, int params) {
+	this.memberLookupParams = params;
+	List<JCVariableDecl> ps = md.params;
+	int minArgs = 0;
+	int maxArgs = 0;
+	if (ps != null && ps.length() > 0) {
+		minArgs = ps.length();
+		if ((ps.last().mods.flags & Flags.VARARGS) != 0) {
+			maxArgs = Integer.MAX_VALUE;
+			minArgs--;
+		} else {
+			maxArgs = minArgs;
+		}
+	}
+	if (params < minArgs) return false;
+	if (params > maxArgs) return false;
+	return true;
+}
+
+boolean isTolerateMethod(JavacNode node, JCMethodDecl md) {
+	this.memberLookupName = md == null ? null : md.name.toString();
+	if (md == null) return false;
+	List<JCAnnotation> annotations = md.getModifiers().getAnnotations();
+	if (annotations == null) return false;
+	for (JCAnnotation anno : annotations) {
+		if (matchReferencedType(lombok.experimental.Tolerate.class, node, anno.getAnnotationType())) return true;
+	}
+	return false;
+}
+
+MemberExistsResult generatedVsUser(JCTree def) {
+	this.injectedMethod = def instanceof JCMethodDecl ? (JCMethodDecl) def : this.injectedMethod;
+	return JavacHandlerUtil.getGeneratedBy(def) == null ? MemberExistsResult.EXISTS_BY_USER : MemberExistsResult.EXISTS_BY_LOMBOK;
+}
+
+MemberExistsResult findExistingConstructor(JavacNode node) {
+	this.memberLookupName = "<init>";
+	node = climbToTypeNode(node);
+	if (node != null && node.get() instanceof JCClassDecl) {
+		for (JCTree def : ((JCClassDecl) node.get()).defs) {
+			if (def instanceof JCMethodDecl) {
+				JCMethodDecl md = (JCMethodDecl) def;
+				if (md.name.contentEquals("<init>") && (md.mods.flags & Flags.GENERATEDCONSTR) == 0) {
+					return generatedVsUser(def);
+				}
+			}
+		}
+	}
+	return MemberExistsResult.NOT_EXISTS;
+}
