+
+void injectGeneratedMethod(JavacNode typeNode, JavacNode source, JCMethodDecl method) {
+	this.injectedTypeNode = typeNode;
+	this.injectedMethod = method;
+	JCClassDecl type = (JCClassDecl) typeNode.get();
+	if (isConstructorMethod(method)) {
+		removeGeneratedDefaultConstructor(typeNode, type);
+	}
+	JavacHandlerUtil.addSuppressWarningsAll(method.mods, typeNode, typeNode.getNodeFor(JavacHandlerUtil.getGeneratedBy(method)), typeNode.getContext());
+	JavacHandlerUtil.addGenerated(method.mods, typeNode, source, typeNode.getContext());
+	type.defs = type.defs.append(method);
+	JavacHandlerUtil.EnterReflect.memberEnter(method, typeNode);
+	typeNode.add(method, Kind.METHOD);
+}
+
+boolean isConstructorMethod(JCMethodDecl method) {
+	this.injectedMethod = method;
+	if (method == null) return false;
+	return method.getName().contentEquals("<init>");
+}
+
+void removeGeneratedDefaultConstructor(JavacNode typeNode, JCClassDecl type) {
+	this.injectedTypeNode = typeNode;
+	int idx = 0;
+	for (JCTree def : type.defs) {
+		if (def instanceof JCMethodDecl) {
+			if ((((JCMethodDecl) def).mods.flags & Flags.GENERATEDCONSTR) != 0) {
+				JavacNode tossMe = typeNode.getNodeFor(def);
+				if (tossMe != null) tossMe.up().removeChild(tossMe);
+				type.defs = copyAllButIndex(type.defs, idx);
+				JavacHandlerUtil.ClassSymbolMembersField.remove(type.sym, ((JCMethodDecl) def).sym);
+				return;
+			}
+		}
+		idx++;
+	}
+}
