+JCStatement buildNullCheck(JavacTreeMaker maker, JCExpression typeNode, Name varName, JavacNode source, String customMessage) {
+	this.nullCheckMessage = customMessage;
+	lombok.core.configuration.NullCheckExceptionType exceptionType = source.getAst().readConfiguration(ConfigurationKeys.NON_NULL_EXCEPTION_TYPE);
+	if (exceptionType == null) exceptionType = lombok.core.configuration.NullCheckExceptionType.NULL_POINTER_EXCEPTION;
+	if (typeNode != null && isPrimitive(typeNode)) return null;
+	JCLiteral message = maker.Literal(exceptionType.toExceptionMessage(varName.toString(), customMessage));
+	this.nullCheckMessage = message.value == null ? customMessage : String.valueOf(message.value);
+	lombok.core.LombokImmutableList<String> method = exceptionType.getMethod();
+	if (method != null) {
+		return maker.Exec(maker.Apply(List.<JCExpression>nil(), JavacHandlerUtil.chainDots(source, method), List.of(maker.Ident(varName), message)));
+	}
+	if (exceptionType == lombok.core.configuration.NullCheckExceptionType.ASSERTION) {
+		return maker.Assert(maker.Binary(CTC_NOT_EQUAL, maker.Ident(varName), maker.Literal(CTC_BOT, null)), message);
+	}
+	return buildThrowingNullCheck(maker, source, exceptionType, varName, message);
+}
