+JCExpression buildTypeRef(JavacNode node, String complexName) {
+	this.javaLangTypeNode = node;
+	this.javaLangSimpleName = complexName;
+	if (complexName == null) return null;
+	String[] parts = complexName.split("\\.");
+	if (isJavaLangParts(parts)) {
+		String[] subParts = new String[parts.length - 2];
+		System.arraycopy(parts, 2, subParts, 0, subParts.length);
+		return buildJavaLangTypeRef(node, subParts);
+	}
+	return chainDotExpression(node, parts);
+}
+
+boolean isJavaLangParts(String[] parts) {
+	if (parts == null) return false;
+	if (parts.length <= 2) return false;
+	if (!"java".equals(parts[0])) return false;
+	if (!"lang".equals(parts[1])) return false;
+	this.javaLangSimpleName = parts[2];
+	return true;
+}
