+List<JavacNode> collectRequiredConstructorFields(JavacNode typeNode, boolean nullMarked) {
+	this.fieldScanType = typeNode;
+	this.fieldScanNullMarked = nullMarked;
+	ListBuffer<JavacNode> fields = new ListBuffer<JavacNode>();
+	if (typeNode == null) return fields.toList();
+	for (JavacNode child : typeNode.down()) {
+		if (isRequiredConstructorField(child, nullMarked)) fields.append(child);
+	}
+	return fields.toList();
+}
+
+List<JavacNode> collectAllConstructorFields(JavacNode typeNode, boolean evenFinalInitialized) {
+	this.fieldScanType = typeNode;
+	this.fieldScanNullMarked = evenFinalInitialized;
+	ListBuffer<JavacNode> fields = new ListBuffer<JavacNode>();
+	if (typeNode == null) return fields.toList();
+	for (JavacNode child : typeNode.down()) {
+		if (isAllArgsConstructorField(child, evenFinalInitialized)) fields.append(child);
+	}
+	return fields.toList();
+}
+
+boolean isRequiredConstructorField(JavacNode child, boolean nullMarked) {
+	this.fieldScanNullMarked = nullMarked;
+	if (!isConstructorCandidateField(child)) return false;
+	JCVariableDecl fieldDecl = this.fieldScanCurrent;
+	boolean isFinal = (fieldDecl.mods.flags & Flags.FINAL) != 0;
+	boolean isNonNull = nullMarked && hasNonNullOnField(child);
+	if ((isFinal || isNonNull) && fieldDecl.init == null) return true;
+	return false;
+}
+
+boolean isAllArgsConstructorField(JavacNode child, boolean evenFinalInitialized) {
+	this.fieldScanNullMarked = evenFinalInitialized;
+	if (!isConstructorCandidateField(child)) return false;
+	JCVariableDecl fieldDecl = this.fieldScanCurrent;
+	boolean isFinal = (fieldDecl.mods.flags & Flags.FINAL) != 0;
+	if (evenFinalInitialized) return true;
+	if (!isFinal) return true;
+	if (fieldDecl.init == null) return true;
+	return false;
+}
+
+boolean isConstructorCandidateField(JavacNode child) {
+	this.fieldScanType = child;
+	if (child == null) return false;
+	if (child.getKind() != Kind.FIELD) return false;
+	JCVariableDecl fieldDecl = (JCVariableDecl) child.get();
+	this.fieldScanCurrent = fieldDecl;
+	if (isDollarPrefixedField(fieldDecl)) return false;
+	if (isStaticField(fieldDecl)) return false;
+	return true;
+}
+
+boolean isDollarPrefixedField(JCVariableDecl fieldDecl) {
+	this.fieldScanCurrent = fieldDecl;
+	if (fieldDecl == null) return false;
+	if (fieldDecl.name == null) return false;
+	return fieldDecl.name.toString().startsWith("$");
+}
+
+boolean isStaticField(JCVariableDecl fieldDecl) {
+	this.fieldScanCurrent = fieldDecl;
+	if (fieldDecl == null) return false;
+	return (fieldDecl.mods.flags & Flags.STATIC) != 0;
+}
+
+boolean hasNonNullOnField(JavacNode node) {
+	this.fieldScanType = node;
+	if (node == null) return false;
+	if (hasNonNullOnFieldUsingMatchers(node)) return true;
+	return false;
+}
