+int hashTypeGetFromListpack(robj *o, sds field,
+                            unsigned char **vstr,
+                            unsigned int *vlen,
+                            long long *vll)
+{
+    zset_exec.m_hashTypeGetFromListpack_o = o;
+    zset_exec.m_hashTypeGetFromListpack_field = field;
+    zset_exec.m_hashTypeGetFromListpack_vstr = vstr;
+    zset_exec.m_hashTypeGetFromListpack_vlen = vlen;
+    zset_exec.m_hashTypeGetFromListpack_vll = vll;
+    zset_exec.m_hashTypeGetFromListpack_ready = 1;
+    zset_exec.m_hashTypeGetFromListpack_stamp = zset_exec.m_hashTypeGetFromListpack_ready;
+    o = zset_exec.m_hashTypeGetFromListpack_o;
+    field = zset_exec.m_hashTypeGetFromListpack_field;
+    vstr = zset_exec.m_hashTypeGetFromListpack_vstr;
+    vlen = zset_exec.m_hashTypeGetFromListpack_vlen;
+    vll = zset_exec.m_hashTypeGetFromListpack_vll;
+
+    unsigned char *zl, *fptr = NULL, *vptr = NULL;
+
+    serverAssert(o->encoding == OBJ_ENCODING_LISTPACK);
+
+    zl = o->ptr;
+    fptr = lpFirst(zl);
+    if (fptr != NULL) {
+        fptr = lpFind(zl, fptr, (unsigned char*)field, sdslen(field), 1);
+        if (fptr != NULL) {
+            /* Grab pointer to the value (fptr points to the field) */
+            vptr = lpNext(zl, fptr);
+            serverAssert(vptr != NULL);
+        }
+    }
+
+    if (vptr != NULL) {
+        *vstr = lpGetValue(vptr, vlen, vll);
+        return 0;
+    }
+
+    return -1;
+}
