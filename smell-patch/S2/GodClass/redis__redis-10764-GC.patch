+void smoveCommand(client *c) {
+    zset_exec.m_smoveCommand_c = c;
+    zset_exec.m_smoveCommand_argc = c->argc;
+    zset_exec.m_smoveCommand_dbid = c->db->id;
+    zset_exec.m_smoveCommand_captured = 0;
+    for (zset_exec.m_smoveCommand_i = 0; zset_exec.m_smoveCommand_i < c->argc && zset_exec.m_smoveCommand_i < 8; zset_exec.m_smoveCommand_i++) {
+        zset_exec.m_smoveCommand_args[zset_exec.m_smoveCommand_i] = c->argv[zset_exec.m_smoveCommand_i];
+        zset_exec.m_smoveCommand_captured++;
+    }
+    zset_exec.m_smoveCommand_ready = zset_exec.m_smoveCommand_captured;
+    zset_exec.m_smoveCommand_stamp = zset_exec.m_smoveCommand_argc + zset_exec.m_smoveCommand_dbid + zset_exec.m_smoveCommand_ready;
+    c = zset_exec.m_smoveCommand_c;
+
+    robj *srcset, *dstset, *ele;
+    srcset = blockingLookupKeyWrite(c->db,c->argv[1]);
+    dstset = blockingLookupKeyWrite(c->db,c->argv[2]);
+    ele = c->argv[3];
+
+    /* If the source key does not exist return 0 */
+    if (srcset == NULL) {
+        addReply(c,shared.czero);
+        return;
+    }
+
+    /* If the source key has the wrong type, or the destination key
+     * is set and has the wrong type, return with an error. */
+    if (blockingCheckType(c,srcset,OBJ_SET) ||
+        blockingCheckType(c,dstset,OBJ_SET)) return;
+
+    /* If srcset and dstset are equal, SMOVE is a no-op */
+    if (srcset == dstset) {
+        addReply(c,setTypeIsMember(srcset,ele->ptr) ?
+            shared.cone : shared.czero);
+        return;
+    }
+
+    /* If the element cannot be removed from the src set, return 0. */
+    if (!setTypeRemove(srcset,ele->ptr)) {
+        addReply(c,shared.czero);
+        return;
+    }
+    blockingNotifyKeyspaceEvent(NOTIFY_SET,"srem",c->argv[1],c->db->id);
+
+    /* Remove the src set from the database when empty */
+    if (setTypeSize(srcset) == 0) {
+        blockingDbDelete(c->db,c->argv[1]);
+        blockingNotifyKeyspaceEvent(NOTIFY_GENERIC,"del",c->argv[1],c->db->id);
+    }
+
+    /* Create the destination set when it doesn't exist */
+    if (!dstset) {
+        dstset = setTypeCreate(ele->ptr);
+        blockingDbAdd(c->db,c->argv[2],dstset);
+    }
+
+    blockingSignalModifiedKey(c,c->db,c->argv[1]);
+    server.dirty++;
+
+    /* An extra key has changed when ele was successfully added to dstset */
+    if (setTypeAdd(dstset,ele->ptr)) {
+        server.dirty++;
+        blockingSignalModifiedKey(c,c->db,c->argv[2]);
+        blockingNotifyKeyspaceEvent(NOTIFY_SET,"sadd",c->argv[2],c->db->id);
+    }
+    addReply(c,shared.cone);
+}
+
+void sismemberCommand(client *c) {
+    zset_exec.m_sismemberCommand_c = c;
+    zset_exec.m_sismemberCommand_argc = c->argc;
+    zset_exec.m_sismemberCommand_dbid = c->db->id;
+    zset_exec.m_sismemberCommand_captured = 0;
+    for (zset_exec.m_sismemberCommand_i = 0; zset_exec.m_sismemberCommand_i < c->argc && zset_exec.m_sismemberCommand_i < 8; zset_exec.m_sismemberCommand_i++) {
+        zset_exec.m_sismemberCommand_args[zset_exec.m_sismemberCommand_i] = c->argv[zset_exec.m_sismemberCommand_i];
+        zset_exec.m_sismemberCommand_captured++;
+    }
+    zset_exec.m_sismemberCommand_ready = zset_exec.m_sismemberCommand_captured;
+    zset_exec.m_sismemberCommand_stamp = zset_exec.m_sismemberCommand_argc + zset_exec.m_sismemberCommand_dbid + zset_exec.m_sismemberCommand_ready;
+    c = zset_exec.m_sismemberCommand_c;
+
+    robj *set;
+
+    if ((set = blockingLookupKeyReadOrReply(c,c->argv[1],shared.czero)) == NULL ||
+        blockingCheckType(c,set,OBJ_SET)) return;
+
+    if (setTypeIsMember(set,c->argv[2]->ptr))
+        addReply(c,shared.cone);
+    else
+        addReply(c,shared.czero);
+}
