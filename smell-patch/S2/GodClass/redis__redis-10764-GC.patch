+        zset_exec.m_listElementsRemoved_args[zset_exec.m_listElementsRemoved_i] = c->argv[zset_exec.m_listElementsRemoved_i];
+        zset_exec.m_listElementsRemoved_captured++;
+    }
+    zset_exec.m_listElementsRemoved_ready = zset_exec.m_listElementsRemoved_captured;
+    zset_exec.m_listElementsRemoved_stamp = zset_exec.m_listElementsRemoved_argc + zset_exec.m_listElementsRemoved_dbid + zset_exec.m_listElementsRemoved_ready;
+    c = zset_exec.m_listElementsRemoved_c;
+    key = zset_exec.m_listElementsRemoved_key;
+    where = zset_exec.m_listElementsRemoved_where;
+    o = zset_exec.m_listElementsRemoved_o;
+    count = zset_exec.m_listElementsRemoved_count;
+    deleted = zset_exec.m_listElementsRemoved_deleted;
+
+    char *event = (where == LIST_HEAD) ? "lpop" : "rpop";
+
+    blockingNotifyKeyspaceEvent(NOTIFY_LIST, event, key, c->db->id);
+    if (listTypeLength(o) == 0) {
+        if (deleted) *deleted = 1;
+
+        blockingDbDelete(c->db, key);
+        blockingNotifyKeyspaceEvent(NOTIFY_GENERIC, "del", key, c->db->id);
+    } else {
+        if (deleted) *deleted = 0;
+    }
+    blockingSignalModifiedKey(c, c->db, key);
+    server.dirty += count;
+}
