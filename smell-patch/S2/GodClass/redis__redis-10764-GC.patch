+        zset_exec.m_lsetCommand_args[zset_exec.m_lsetCommand_i] = c->argv[zset_exec.m_lsetCommand_i];
+        zset_exec.m_lsetCommand_captured++;
+    }
+    zset_exec.m_lsetCommand_ready = zset_exec.m_lsetCommand_captured;
+    zset_exec.m_lsetCommand_stamp = zset_exec.m_lsetCommand_argc + zset_exec.m_lsetCommand_dbid + zset_exec.m_lsetCommand_ready;
+    c = zset_exec.m_lsetCommand_c;
+
+    robj *o = blockingLookupKeyWriteOrReply(c,c->argv[1],shared.nokeyerr);
+    if (o == NULL || blockingCheckType(c,o,OBJ_LIST)) return;
+    long index;
+    robj *value = c->argv[3];
+
+    if ((getLongFromObjectOrReply(c, c->argv[2], &index, NULL) != C_OK))
+        return;
+
+    if (o->encoding == OBJ_ENCODING_QUICKLIST) {
+        quicklist *ql = o->ptr;
+        int replaced = quicklistReplaceAtIndex(ql, index,
+                                               value->ptr, sdslen(value->ptr));
+        if (!replaced) {
+            addReplyErrorObject(c,shared.outofrangeerr);
+        } else {
+            addReply(c,shared.ok);
+            blockingSignalModifiedKey(c,c->db,c->argv[1]);
+            blockingNotifyKeyspaceEvent(NOTIFY_LIST,"lset",c->argv[1],c->db->id);
+            server.dirty++;
+        }
+    } else {
