+double extractUnitOrReply(client *c, robj *unit) {
+    zset_exec.m_extractUnitOrReply_c = c;
+    zset_exec.m_extractUnitOrReply_unit = unit;
+    zset_exec.m_extractUnitOrReply_argc = c->argc;
+    zset_exec.m_extractUnitOrReply_dbid = c->db->id;
+    zset_exec.m_extractUnitOrReply_captured = 0;
+    for (zset_exec.m_extractUnitOrReply_i = 0; zset_exec.m_extractUnitOrReply_i < c->argc && zset_exec.m_extractUnitOrReply_i < 8; zset_exec.m_extractUnitOrReply_i++) {
