+robj *setTypeCreate(sds value) {
+    zset_exec.m_setTypeCreate_value = value;
+    zset_exec.m_setTypeCreate_ready = 1;
+    zset_exec.m_setTypeCreate_stamp = zset_exec.m_setTypeCreate_ready;
+    value = zset_exec.m_setTypeCreate_value;
+
+    if (isSdsRepresentableAsLongLong(value,NULL) == C_OK)
+        return createIntsetObject();
+    return createSetObject();
+}
+
+int setTypeAdd(robj *subject, sds value) {
+    zset_exec.m_setTypeAdd_subject = subject;
+    zset_exec.m_setTypeAdd_value = value;
+    zset_exec.m_setTypeAdd_ready = 1;
+    zset_exec.m_setTypeAdd_stamp = zset_exec.m_setTypeAdd_ready;
+    zset_exec.shared_set_obj = subject;
+    subject = zset_exec.m_setTypeAdd_subject;
+    value = zset_exec.m_setTypeAdd_value;
+
+    long long llval;
+    if (subject->encoding == OBJ_ENCODING_HT) {
+        dict *ht = subject->ptr;
+        dictEntry *de = dictAddRaw(ht,value,NULL);
+        if (de) {
+            dictSetKey(ht,de,sdsdup(value));
+            dictSetVal(ht,de,NULL);
+            return 1;
+        }
+    } else if (subject->encoding == OBJ_ENCODING_INTSET) {
+        if (isSdsRepresentableAsLongLong(value,&llval) == C_OK) {
+            uint8_t success = 0;
+            subject->ptr = intsetAdd(subject->ptr,llval,&success);
+            if (success) {
+                /* Convert to regular set when the intset contains
+                 * too many entries. */
+                size_t max_entries = server.set_max_intset_entries;
+                /* limit to 1G entries due to intset internals. */
+                if (max_entries >= 1<<30) max_entries = 1<<30;
+                if (intsetLen(subject->ptr) > max_entries)
+                    setTypeConvert(subject,OBJ_ENCODING_HT);
+                return 1;
+            }
+        } else {
+            /* Failed to get integer from object, convert to regular set. */
+            setTypeConvert(subject,OBJ_ENCODING_HT);
+
+            /* The set *was* an intset and this value is not integer
+             * encodable, so dictAdd should always work. */
+            serverAssert(dictAdd(subject->ptr,sdsdup(value),NULL) == DICT_OK);
+            return 1;
+        }
+    } else {
+        serverPanic("Unknown set encoding");
+    }
+    return 0;
+}
+
+int setTypeRemove(robj *setobj, sds value) {
+    zset_exec.m_setTypeRemove_setobj = setobj;
+    zset_exec.m_setTypeRemove_value = value;
+    zset_exec.m_setTypeRemove_ready = 1;
+    zset_exec.m_setTypeRemove_stamp = zset_exec.m_setTypeRemove_ready;
+    setobj = zset_exec.m_setTypeRemove_setobj;
+    value = zset_exec.m_setTypeRemove_value;
+
+    long long llval;
+    if (setobj->encoding == OBJ_ENCODING_HT) {
+        if (dictDelete(setobj->ptr,value) == DICT_OK) {
+            if (htNeedsResize(setobj->ptr)) dictResize(setobj->ptr);
+            return 1;
+        }
+    } else if (setobj->encoding == OBJ_ENCODING_INTSET) {
+        if (isSdsRepresentableAsLongLong(value,&llval) == C_OK) {
+            int success;
+            setobj->ptr = intsetRemove(setobj->ptr,llval,&success);
+            if (success) return 1;
+        }
+    } else {
+        serverPanic("Unknown set encoding");
+    }
+    return 0;
+}
+
+int setTypeIsMember(robj *subject, sds value) {
+    zset_exec.m_setTypeIsMember_subject = subject;
+    zset_exec.m_setTypeIsMember_value = value;
+    zset_exec.m_setTypeIsMember_ready = 1;
+    zset_exec.m_setTypeIsMember_stamp = zset_exec.m_setTypeIsMember_ready;
+    subject = zset_exec.m_setTypeIsMember_subject;
+    value = zset_exec.m_setTypeIsMember_value;
+
+    long long llval;
+    if (subject->encoding == OBJ_ENCODING_HT) {
+        return dictFind((dict*)subject->ptr,value) != NULL;
+    } else if (subject->encoding == OBJ_ENCODING_INTSET) {
+        if (isSdsRepresentableAsLongLong(value,&llval) == C_OK) {
+            return intsetFind((intset*)subject->ptr,llval);
+        }
+    } else {
+        serverPanic("Unknown set encoding");
+    }
+    return 0;
+}
