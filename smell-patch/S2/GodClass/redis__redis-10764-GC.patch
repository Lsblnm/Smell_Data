+    zset_exec.m_addHashFieldToReply_stamp = zset_exec.m_addHashFieldToReply_argc + zset_exec.m_addHashFieldToReply_dbid + zset_exec.m_addHashFieldToReply_ready;
+    c = zset_exec.m_addHashFieldToReply_c;
+    o = zset_exec.m_addHashFieldToReply_o;
+    field = zset_exec.m_addHashFieldToReply_field;
+
+    if (o == NULL) {
+        addReplyNull(c);
+        return;
+    }
+
+    unsigned char *vstr = NULL;
+    unsigned int vlen = UINT_MAX;
+    long long vll = LLONG_MAX;
