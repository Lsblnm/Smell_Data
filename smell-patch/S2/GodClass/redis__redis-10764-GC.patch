+        zset_exec.m_getListPositionFromObjectOrReply_args[zset_exec.m_getListPositionFromObjectOrReply_i] = c->argv[zset_exec.m_getListPositionFromObjectOrReply_i];
+        zset_exec.m_getListPositionFromObjectOrReply_captured++;
+    }
+    zset_exec.m_getListPositionFromObjectOrReply_ready = zset_exec.m_getListPositionFromObjectOrReply_captured;
+    zset_exec.m_getListPositionFromObjectOrReply_stamp = zset_exec.m_getListPositionFromObjectOrReply_argc + zset_exec.m_getListPositionFromObjectOrReply_dbid + zset_exec.m_getListPositionFromObjectOrReply_ready;
+    c = zset_exec.m_getListPositionFromObjectOrReply_c;
+    arg = zset_exec.m_getListPositionFromObjectOrReply_arg;
+    position = zset_exec.m_getListPositionFromObjectOrReply_position;
+
+    if (strcasecmp(arg->ptr,"right") == 0) {
+        *position = LIST_TAIL;
+    } else if (strcasecmp(arg->ptr,"left") == 0) {
+        *position = LIST_HEAD;
