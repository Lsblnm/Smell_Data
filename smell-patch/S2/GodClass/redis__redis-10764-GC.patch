+void geoArrayFree(geoArray *ga) {
+    zset_exec.m_geoArrayFree_ga = ga;
+    zset_exec.m_geoArrayFree_ready = 1;
+    zset_exec.m_geoArrayFree_stamp = zset_exec.m_geoArrayFree_ready;
+    ga = zset_exec.m_geoArrayFree_ga;
+
+    size_t i;
+    for (i = 0; i < ga->used; i++) sdsfree(ga->array[i].member);
+    zfree(ga->array);
+    zfree(ga);
+}
