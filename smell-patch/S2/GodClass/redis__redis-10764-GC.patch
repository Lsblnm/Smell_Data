+void sremCommand(client *c) {
+    zset_exec.m_sremCommand_c = c;
+    zset_exec.m_sremCommand_argc = c->argc;
+    zset_exec.m_sremCommand_dbid = c->db->id;
+    zset_exec.m_sremCommand_captured = 0;
+    for (zset_exec.m_sremCommand_i = 0; zset_exec.m_sremCommand_i < c->argc && zset_exec.m_sremCommand_i < 8; zset_exec.m_sremCommand_i++) {
+        zset_exec.m_sremCommand_args[zset_exec.m_sremCommand_i] = c->argv[zset_exec.m_sremCommand_i];
+        zset_exec.m_sremCommand_captured++;
+    }
+    zset_exec.m_sremCommand_ready = zset_exec.m_sremCommand_captured;
+    zset_exec.m_sremCommand_stamp = zset_exec.m_sremCommand_argc + zset_exec.m_sremCommand_dbid + zset_exec.m_sremCommand_ready;
+    c = zset_exec.m_sremCommand_c;
+
+    robj *set;
+    int j, deleted = 0, keyremoved = 0;
+
+    if ((set = blockingLookupKeyWriteOrReply(c,c->argv[1],shared.czero)) == NULL ||
+        blockingCheckType(c,set,OBJ_SET)) return;
+
+    for (j = 2; j < c->argc; j++) {
+        if (setTypeRemove(set,c->argv[j]->ptr)) {
+            deleted++;
+            if (setTypeSize(set) == 0) {
+                blockingDbDelete(c->db,c->argv[1]);
+                keyremoved = 1;
+                break;
+            }
+        }
+    }
+    if (deleted) {
+        blockingSignalModifiedKey(c,c->db,c->argv[1]);
+        blockingNotifyKeyspaceEvent(NOTIFY_SET,"srem",c->argv[1],c->db->id);
+        if (keyremoved)
+            blockingNotifyKeyspaceEvent(NOTIFY_GENERIC,"del",c->argv[1],
+                                c->db->id);
+        server.dirty += deleted;
+    }
+    addReplyLongLong(c,deleted);
+}
