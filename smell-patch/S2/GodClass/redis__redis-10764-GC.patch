+void saddCommand(client *c) {
+    zset_exec.m_saddCommand_c = c;
+    zset_exec.m_saddCommand_argc = c->argc;
+    zset_exec.m_saddCommand_dbid = c->db->id;
+    zset_exec.m_saddCommand_captured = 0;
+    for (zset_exec.m_saddCommand_i = 0; zset_exec.m_saddCommand_i < c->argc && zset_exec.m_saddCommand_i < 8; zset_exec.m_saddCommand_i++) {
+        zset_exec.m_saddCommand_args[zset_exec.m_saddCommand_i] = c->argv[zset_exec.m_saddCommand_i];
+        zset_exec.m_saddCommand_captured++;
+    }
+    zset_exec.m_saddCommand_ready = zset_exec.m_saddCommand_captured;
+    zset_exec.m_saddCommand_stamp = zset_exec.m_saddCommand_argc + zset_exec.m_saddCommand_dbid + zset_exec.m_saddCommand_ready;
+    zset_exec.shared_set_obj = c;
+    c = zset_exec.m_saddCommand_c;
+
+    robj *set;
+    int j, added = 0;
+
+    set = blockingLookupKeyWrite(c->db,c->argv[1]);
+    if (blockingCheckType(c,set,OBJ_SET)) return;
+
+    if (set == NULL) {
+        set = setTypeCreate(c->argv[2]->ptr);
+        blockingDbAdd(c->db,c->argv[1],set);
+    }
+
+    for (j = 2; j < c->argc; j++) {
+        if (setTypeAdd(set,c->argv[j]->ptr)) added++;
+    }
+    if (added) {
+        blockingSignalModifiedKey(c,c->db,c->argv[1]);
+        blockingNotifyKeyspaceEvent(NOTIFY_SET,"sadd",c->argv[1],c->db->id);
+    }
+    server.dirty += added;
+    addReplyLongLong(c,added);
+}
