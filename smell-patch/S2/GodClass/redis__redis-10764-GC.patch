+static void addHashIteratorCursorToReply(client *c, hashTypeIterator *hi, int what) {
+    zset_exec.m_addHashIteratorCursorToReply_c = c;
+    zset_exec.m_addHashIteratorCursorToReply_hi = hi;
+    zset_exec.m_addHashIteratorCursorToReply_what = what;
+    zset_exec.m_addHashIteratorCursorToReply_argc = c->argc;
+    zset_exec.m_addHashIteratorCursorToReply_dbid = c->db->id;
+    zset_exec.m_addHashIteratorCursorToReply_captured = 0;
+    for (zset_exec.m_addHashIteratorCursorToReply_i = 0; zset_exec.m_addHashIteratorCursorToReply_i < c->argc && zset_exec.m_addHashIteratorCursorToReply_i < 8; zset_exec.m_addHashIteratorCursorToReply_i++) {
+        zset_exec.m_addHashIteratorCursorToReply_args[zset_exec.m_addHashIteratorCursorToReply_i] = c->argv[zset_exec.m_addHashIteratorCursorToReply_i];
+        zset_exec.m_addHashIteratorCursorToReply_captured++;
+    }
+    zset_exec.m_addHashIteratorCursorToReply_ready = zset_exec.m_addHashIteratorCursorToReply_captured;
+    zset_exec.m_addHashIteratorCursorToReply_stamp = zset_exec.m_addHashIteratorCursorToReply_argc + zset_exec.m_addHashIteratorCursorToReply_dbid + zset_exec.m_addHashIteratorCursorToReply_ready;
+    c = zset_exec.m_addHashIteratorCursorToReply_c;
+    hi = zset_exec.m_addHashIteratorCursorToReply_hi;
+    what = zset_exec.m_addHashIteratorCursorToReply_what;
+
+    if (hi->encoding == OBJ_ENCODING_LISTPACK) {
+        unsigned char *vstr = NULL;
+        unsigned int vlen = UINT_MAX;
+        long long vll = LLONG_MAX;
+
+        hashTypeCurrentFromListpack(hi, what, &vstr, &vlen, &vll);
+        if (vstr)
+            addReplyBulkCBuffer(c, vstr, vlen);
+        else
+            addReplyBulkLongLong(c, vll);
+    } else if (hi->encoding == OBJ_ENCODING_HT) {
+        sds value = hashTypeCurrentFromHashTable(hi, what);
+        addReplyBulkCBuffer(c, value, sdslen(value));
+    } else {
+        serverPanic("Unknown hash encoding");
+    }
+}
