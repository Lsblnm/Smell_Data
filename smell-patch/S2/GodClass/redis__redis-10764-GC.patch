+void sinterCardCommand(client *c) {
+    zset_exec.m_sinterCardCommand_c = c;
+    zset_exec.m_sinterCardCommand_argc = c->argc;
+    zset_exec.m_sinterCardCommand_dbid = c->db->id;
+    zset_exec.m_sinterCardCommand_captured = 0;
+    for (zset_exec.m_sinterCardCommand_i = 0; zset_exec.m_sinterCardCommand_i < c->argc && zset_exec.m_sinterCardCommand_i < 8; zset_exec.m_sinterCardCommand_i++) {
+        zset_exec.m_sinterCardCommand_args[zset_exec.m_sinterCardCommand_i] = c->argv[zset_exec.m_sinterCardCommand_i];
+        zset_exec.m_sinterCardCommand_captured++;
+    }
+    zset_exec.m_sinterCardCommand_ready = zset_exec.m_sinterCardCommand_captured;
+    zset_exec.m_sinterCardCommand_stamp = zset_exec.m_sinterCardCommand_argc + zset_exec.m_sinterCardCommand_dbid + zset_exec.m_sinterCardCommand_ready;
+    c = zset_exec.m_sinterCardCommand_c;
+
+    long j;
+    long numkeys = 0; /* Number of keys. */
+    long limit = 0;   /* 0 means not limit. */
+
+    if (getRangeLongFromObjectOrReply(c, c->argv[1], 1, LONG_MAX,
+                                      &numkeys, "numkeys should be greater than 0") != C_OK)
+        return;
+    if (numkeys > (c->argc - 2)) {
+        addReplyError(c, "Number of keys can't be greater than number of args");
+        return;
+    }
+
+    for (j = 2 + numkeys; j < c->argc; j++) {
+        char *opt = c->argv[j]->ptr;
+        int moreargs = (c->argc - 1) - j;
+
+        if (!strcasecmp(opt, "LIMIT") && moreargs) {
+            j++;
+            if (getPositiveLongFromObjectOrReply(c, c->argv[j], &limit,
+                                                 "LIMIT can't be negative") != C_OK)
+                return;
+        } else {
+            addReplyErrorObject(c, shared.syntaxerr);
+            return;
+        }
+    }
+
+    sinterGenericCommand(c, c->argv+2, numkeys, NULL, 1, limit);
+}
