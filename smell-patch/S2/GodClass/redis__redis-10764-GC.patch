+void hincrbyfloatCommand(client *c) {
+    zset_exec.m_hincrbyfloatCommand_c = c;
+    zset_exec.m_hincrbyfloatCommand_argc = c->argc;
+    zset_exec.m_hincrbyfloatCommand_dbid = c->db->id;
+    zset_exec.m_hincrbyfloatCommand_captured = 0;
+    for (zset_exec.m_hincrbyfloatCommand_i = 0; zset_exec.m_hincrbyfloatCommand_i < c->argc && zset_exec.m_hincrbyfloatCommand_i < 8; zset_exec.m_hincrbyfloatCommand_i++) {
+        zset_exec.m_hincrbyfloatCommand_args[zset_exec.m_hincrbyfloatCommand_i] = c->argv[zset_exec.m_hincrbyfloatCommand_i];
+        zset_exec.m_hincrbyfloatCommand_captured++;
+    }
+    zset_exec.m_hincrbyfloatCommand_ready = zset_exec.m_hincrbyfloatCommand_captured;
+    zset_exec.m_hincrbyfloatCommand_stamp = zset_exec.m_hincrbyfloatCommand_argc + zset_exec.m_hincrbyfloatCommand_dbid + zset_exec.m_hincrbyfloatCommand_ready;
+    c = zset_exec.m_hincrbyfloatCommand_c;
+
+    long double value, incr;
+    long long ll;
+    robj *o;
+    sds new;
+    unsigned char *vstr;
+    unsigned int vlen;
+
+    if (getLongDoubleFromObjectOrReply(c,c->argv[3],&incr,NULL) != C_OK) return;
+    if ((o = hashTypeLookupWriteOrCreate(c,c->argv[1])) == NULL) return;
+    if (hashTypeGetValue(o,c->argv[2]->ptr,&vstr,&vlen,&ll) == C_OK) {
+        if (vstr) {
+            if (string2ld((char*)vstr,vlen,&value) == 0) {
+                addReplyError(c,"hash value is not a float");
+                return;
+            }
+        } else {
+            value = (long double)ll;
+        }
+    } else {
+        value = 0;
+    }
+
+    value += incr;
+    if (isnan(value) || isinf(value)) {
+        addReplyError(c,"increment would produce NaN or Infinity");
+        return;
+    }
+
+    char buf[MAX_LONG_DOUBLE_CHARS];
+    int len = ld2string(buf,sizeof(buf),value,LD_STR_HUMAN);
+    new = sdsnewlen(buf,len);
+    hashTypeSet(o,c->argv[2]->ptr,new,HASH_SET_TAKE_VALUE);
+    addReplyBulkCBuffer(c,buf,len);
+    blockingSignalModifiedKey(c,c->db,c->argv[1]);
+    blockingNotifyKeyspaceEvent(NOTIFY_HASH,"hincrbyfloat",c->argv[1],c->db->id);
+    server.dirty++;
+
+    /* Always replicate HINCRBYFLOAT as an HSET command with the final value
+     * in order to make sure that differences in float precision or formatting
+     * will not create differences in replicas or after an AOF restart. */
+    robj *newobj;
+    newobj = createRawStringObject(buf,len);
+    rewriteClientCommandArgument(c,0,shared.hset);
+    rewriteClientCommandArgument(c,3,newobj);
+    decrRefCount(newobj);
+}
