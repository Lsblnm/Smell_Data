+        zset_exec.m_listPopRangeAndReplyWithKey_args[zset_exec.m_listPopRangeAndReplyWithKey_i] = c->argv[zset_exec.m_listPopRangeAndReplyWithKey_i];
+        zset_exec.m_listPopRangeAndReplyWithKey_captured++;
