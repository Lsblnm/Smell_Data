+    zset_exec.m_extractLongLatOrReply_stamp = zset_exec.m_extractLongLatOrReply_argc + zset_exec.m_extractLongLatOrReply_dbid + zset_exec.m_extractLongLatOrReply_ready;
+    c = zset_exec.m_extractLongLatOrReply_c;
