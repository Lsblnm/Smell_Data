+    char *u = unit->ptr;
+
+    if (!strcasecmp(u, "m")) {
+        return 1;
+    } else if (!strcasecmp(u, "km")) {
+        return 1000;
+    } else if (!strcasecmp(u, "ft")) {
+        return 0.3048;
