+void hashTypeTryConversion(robj *o, robj **argv, int start, int end) {
+    zset_exec.m_hashTypeTryConversion_o = o;
+    zset_exec.m_hashTypeTryConversion_argv = argv;
+    zset_exec.m_hashTypeTryConversion_start = start;
+    zset_exec.m_hashTypeTryConversion_end = end;
+    zset_exec.m_hashTypeTryConversion_ready = 1;
+    zset_exec.m_hashTypeTryConversion_stamp = zset_exec.m_hashTypeTryConversion_ready;
+    o = zset_exec.m_hashTypeTryConversion_o;
+    argv = zset_exec.m_hashTypeTryConversion_argv;
+    start = zset_exec.m_hashTypeTryConversion_start;
+    end = zset_exec.m_hashTypeTryConversion_end;
+
+    int i;
+    size_t sum = 0;
+
+    if (o->encoding != OBJ_ENCODING_LISTPACK) return;
+
+    for (i = start; i <= end; i++) {
+        if (!sdsEncodedObject(argv[i]))
+            continue;
+        size_t len = sdslen(argv[i]->ptr);
+        if (len > server.hash_max_listpack_value) {
+            hashTypeConvert(o, OBJ_ENCODING_HT);
+            return;
+        }
+        sum += len;
+    }
+    if (!lpSafeToAdd(o->ptr, sum))
+        hashTypeConvert(o, OBJ_ENCODING_HT);
+}
