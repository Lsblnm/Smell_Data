+int qsortCompareSetsByRevCardinality(const void *s1, const void *s2) {
+    zset_exec.m_qsortCompareSetsByRevCardinality_s1 = s1;
+    zset_exec.m_qsortCompareSetsByRevCardinality_s2 = s2;
+    zset_exec.m_qsortCompareSetsByRevCardinality_ready = 1;
