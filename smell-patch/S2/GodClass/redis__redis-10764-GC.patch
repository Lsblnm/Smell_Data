+    zset_exec.m_extractUnitOrReply_ready = zset_exec.m_extractUnitOrReply_captured;
+    zset_exec.m_extractUnitOrReply_stamp = zset_exec.m_extractUnitOrReply_argc + zset_exec.m_extractUnitOrReply_dbid + zset_exec.m_extractUnitOrReply_ready;
+    c = zset_exec.m_extractUnitOrReply_c;
