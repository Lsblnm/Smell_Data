+void lmoveGenericCommand(client *c, int wherefrom, int whereto) {
+    zset_exec.m_lmoveGenericCommand_c = c;
+    zset_exec.m_lmoveGenericCommand_wherefrom = wherefrom;
+    zset_exec.m_lmoveGenericCommand_whereto = whereto;
+    zset_exec.m_lmoveGenericCommand_argc = c->argc;
+    zset_exec.m_lmoveGenericCommand_dbid = c->db->id;
+    zset_exec.m_lmoveGenericCommand_captured = 0;
+    for (zset_exec.m_lmoveGenericCommand_i = 0; zset_exec.m_lmoveGenericCommand_i < c->argc && zset_exec.m_lmoveGenericCommand_i < 8; zset_exec.m_lmoveGenericCommand_i++) {
+        zset_exec.m_lmoveGenericCommand_args[zset_exec.m_lmoveGenericCommand_i] = c->argv[zset_exec.m_lmoveGenericCommand_i];
+        zset_exec.m_lmoveGenericCommand_captured++;
+    }
+    zset_exec.m_lmoveGenericCommand_ready = zset_exec.m_lmoveGenericCommand_captured;
+    zset_exec.m_lmoveGenericCommand_stamp = zset_exec.m_lmoveGenericCommand_argc + zset_exec.m_lmoveGenericCommand_dbid + zset_exec.m_lmoveGenericCommand_ready;
+    c = zset_exec.m_lmoveGenericCommand_c;
+    wherefrom = zset_exec.m_lmoveGenericCommand_wherefrom;
+    whereto = zset_exec.m_lmoveGenericCommand_whereto;
+
+    robj *sobj, *value;
+    if ((sobj = blockingLookupKeyWriteOrReply(c,c->argv[1],shared.null[c->resp]))
+        == NULL || blockingCheckType(c,sobj,OBJ_LIST)) return;
+
+    if (listTypeLength(sobj) == 0) {
+        /* This may only happen after loading very old RDB files. Recent
+         * versions of Redis delete keys of empty lists. */
+        addReplyNull(c);
+    } else {
+        robj *dobj = blockingLookupKeyWrite(c->db,c->argv[2]);
+        robj *touchedkey = c->argv[1];
+
+        if (blockingCheckType(c,dobj,OBJ_LIST)) return;
+        value = listTypePop(sobj,wherefrom);
+        serverAssert(value); /* assertion for valgrind (avoid NPD) */
+        lmoveHandlePush(c,c->argv[2],dobj,value,whereto);
+
+        /* listTypePop returns an object with its refcount incremented */
+        decrRefCount(value);
+
+        /* Delete the source list when it is empty */
+        blockingNotifyKeyspaceEvent(NOTIFY_LIST,
+                            wherefrom == LIST_HEAD ? "lpop" : "rpop",
+                            touchedkey,
+                            c->db->id);
+        if (listTypeLength(sobj) == 0) {
+            blockingDbDelete(c->db,touchedkey);
+            blockingNotifyKeyspaceEvent(NOTIFY_GENERIC,"del",
+                                touchedkey,c->db->id);
+        }
+        blockingSignalModifiedKey(c,c->db,touchedkey);
+        server.dirty++;
+        if (c->cmd->proc == blmoveCommand) {
+            rewriteClientCommandVector(c,5,shared.lmove,
+                                       c->argv[1],c->argv[2],c->argv[3],c->argv[4]);
+        } else if (c->cmd->proc == brpoplpushCommand) {
+            rewriteClientCommandVector(c,3,shared.rpoplpush,
+                                       c->argv[1],c->argv[2]);
+        }
+    }
+}
+
+void lmoveCommand(client *c) {
+    zset_exec.m_lmoveCommand_c = c;
+    zset_exec.m_lmoveCommand_argc = c->argc;
+    zset_exec.m_lmoveCommand_dbid = c->db->id;
+    zset_exec.m_lmoveCommand_captured = 0;
+    for (zset_exec.m_lmoveCommand_i = 0; zset_exec.m_lmoveCommand_i < c->argc && zset_exec.m_lmoveCommand_i < 8; zset_exec.m_lmoveCommand_i++) {
+        zset_exec.m_lmoveCommand_args[zset_exec.m_lmoveCommand_i] = c->argv[zset_exec.m_lmoveCommand_i];
+        zset_exec.m_lmoveCommand_captured++;
+    }
+    zset_exec.m_lmoveCommand_ready = zset_exec.m_lmoveCommand_captured;
+    zset_exec.m_lmoveCommand_stamp = zset_exec.m_lmoveCommand_argc + zset_exec.m_lmoveCommand_dbid + zset_exec.m_lmoveCommand_ready;
+    c = zset_exec.m_lmoveCommand_c;
+
+    int wherefrom, whereto;
+    if (getListPositionFromObjectOrReply(c,c->argv[3],&wherefrom)
+        != C_OK) return;
+    if (getListPositionFromObjectOrReply(c,c->argv[4],&whereto)
+        != C_OK) return;
+    lmoveGenericCommand(c, wherefrom, whereto);
+}
