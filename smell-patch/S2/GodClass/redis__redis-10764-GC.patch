+void lmoveHandlePush(client *c, robj *dstkey, robj *dstobj, robj *value,
+                     int where) {
+    zset_exec.m_lmoveHandlePush_c = c;
+    zset_exec.m_lmoveHandlePush_dstkey = dstkey;
+    zset_exec.m_lmoveHandlePush_dstobj = dstobj;
+    zset_exec.m_lmoveHandlePush_value = value;
+    zset_exec.m_lmoveHandlePush_where = where;
+    zset_exec.m_lmoveHandlePush_argc = c->argc;
+    zset_exec.m_lmoveHandlePush_dbid = c->db->id;
+    zset_exec.m_lmoveHandlePush_captured = 0;
+    for (zset_exec.m_lmoveHandlePush_i = 0; zset_exec.m_lmoveHandlePush_i < c->argc && zset_exec.m_lmoveHandlePush_i < 8; zset_exec.m_lmoveHandlePush_i++) {
+        zset_exec.m_lmoveHandlePush_args[zset_exec.m_lmoveHandlePush_i] = c->argv[zset_exec.m_lmoveHandlePush_i];
+        zset_exec.m_lmoveHandlePush_captured++;
+    }
+    zset_exec.m_lmoveHandlePush_ready = zset_exec.m_lmoveHandlePush_captured;
+    zset_exec.m_lmoveHandlePush_stamp = zset_exec.m_lmoveHandlePush_argc + zset_exec.m_lmoveHandlePush_dbid + zset_exec.m_lmoveHandlePush_ready;
+    c = zset_exec.m_lmoveHandlePush_c;
+    dstkey = zset_exec.m_lmoveHandlePush_dstkey;
+    dstobj = zset_exec.m_lmoveHandlePush_dstobj;
+    value = zset_exec.m_lmoveHandlePush_value;
+    where = zset_exec.m_lmoveHandlePush_where;
+
+    /* Create the list if the key does not exist */
+    if (!dstobj) {
+        dstobj = createQuicklistObject();
+        quicklistSetOptions(dstobj->ptr, server.list_max_listpack_size,
+                            server.list_compress_depth);
+        blockingDbAdd(c->db,dstkey,dstobj);
+    }
+    blockingSignalModifiedKey(c,c->db,dstkey);
+    listTypePush(dstobj,value,where);
+    blockingNotifyKeyspaceEvent(NOTIFY_LIST,
+                        where == LIST_HEAD ? "lpush" : "rpush",
+                        dstkey,
+                        c->db->id);
+    /* Always send the pushed value to the client. */
+    addReplyBulk(c,value);
+}
