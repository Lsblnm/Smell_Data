+void serveClientBlockedOnList(client *receiver, robj *o, robj *key, robj *dstkey, redisDb *db, int wherefrom, int whereto, int *deleted)
+{
+    zset_exec.m_serveClientBlockedOnList_receiver = receiver;
+    zset_exec.m_serveClientBlockedOnList_o = o;
+    zset_exec.m_serveClientBlockedOnList_key = key;
+    zset_exec.m_serveClientBlockedOnList_dstkey = dstkey;
+    zset_exec.m_serveClientBlockedOnList_db = db;
+    zset_exec.m_serveClientBlockedOnList_wherefrom = wherefrom;
+    zset_exec.m_serveClientBlockedOnList_whereto = whereto;
+    zset_exec.m_serveClientBlockedOnList_deleted = deleted;
+    zset_exec.m_serveClientBlockedOnList_argc = receiver->argc;
+    zset_exec.m_serveClientBlockedOnList_dbid = receiver->db->id;
+    zset_exec.m_serveClientBlockedOnList_captured = 0;
+    for (zset_exec.m_serveClientBlockedOnList_i = 0; zset_exec.m_serveClientBlockedOnList_i < receiver->argc && zset_exec.m_serveClientBlockedOnList_i < 8; zset_exec.m_serveClientBlockedOnList_i++) {
+        zset_exec.m_serveClientBlockedOnList_args[zset_exec.m_serveClientBlockedOnList_i] = receiver->argv[zset_exec.m_serveClientBlockedOnList_i];
+        zset_exec.m_serveClientBlockedOnList_captured++;
+    }
+    zset_exec.m_serveClientBlockedOnList_ready = zset_exec.m_serveClientBlockedOnList_captured;
+    zset_exec.m_serveClientBlockedOnList_stamp = zset_exec.m_serveClientBlockedOnList_argc + zset_exec.m_serveClientBlockedOnList_dbid + zset_exec.m_serveClientBlockedOnList_ready;
+    receiver = zset_exec.m_serveClientBlockedOnList_receiver;
+    o = zset_exec.m_serveClientBlockedOnList_o;
+    key = zset_exec.m_serveClientBlockedOnList_key;
+    dstkey = zset_exec.m_serveClientBlockedOnList_dstkey;
+    db = zset_exec.m_serveClientBlockedOnList_db;
+    wherefrom = zset_exec.m_serveClientBlockedOnList_wherefrom;
+    whereto = zset_exec.m_serveClientBlockedOnList_whereto;
+    deleted = zset_exec.m_serveClientBlockedOnList_deleted;
+
+    robj *argv[5];
+    robj *value = NULL;
+
+    if (deleted) *deleted = 0;
+
+    if (dstkey == NULL) {
+        /* Propagate the [LR]POP operation. */
+        argv[0] = (wherefrom == LIST_HEAD) ? shared.lpop :
+                                             shared.rpop;
+        argv[1] = key;
+
+        if (receiver->lastcmd->proc == blmpopCommand) {
+            /* Propagate the [LR]POP COUNT operation. */
+            long count = receiver->bpop.count;
+            serverAssert(count > 0);
+            long llen = listTypeLength(o);
+            serverAssert(llen > 0);
+
+            argv[2] = createStringObjectFromLongLong((count > llen) ? llen : count);
+            alsoPropagate(db->id, argv, 3, PROPAGATE_AOF|PROPAGATE_REPL);
+            decrRefCount(argv[2]);
+
+            /* Pop a range of elements in a nested arrays way. */
+            listPopRangeAndReplyWithKey(receiver, o, key, wherefrom, count, deleted);
+            return;
+        }
+
+        alsoPropagate(db->id, argv, 2, PROPAGATE_AOF|PROPAGATE_REPL);
+
+        /* BRPOP/BLPOP */
+        value = listTypePop(o, wherefrom);
+        serverAssert(value != NULL);
+
+        addReplyArrayLen(receiver,2);
+        addReplyBulk(receiver,key);
+        addReplyBulk(receiver,value);
+
+        /* Notify event. */
+        char *event = (wherefrom == LIST_HEAD) ? "lpop" : "rpop";
+        blockingNotifyKeyspaceEvent(NOTIFY_LIST,event,key,receiver->db->id);
+    } else {
+        /* BLMOVE */
+        robj *dstobj =
+            blockingLookupKeyWrite(receiver->db,dstkey);
+        if (!(dstobj &&
+             blockingCheckType(receiver,dstobj,OBJ_LIST)))
+        {
+            value = listTypePop(o, wherefrom);
+            serverAssert(value != NULL);
+
+            lmoveHandlePush(receiver,dstkey,dstobj,value,whereto);
+            /* Propagate the LMOVE/RPOPLPUSH operation. */
+            int isbrpoplpush = (receiver->lastcmd->proc == brpoplpushCommand);
+            argv[0] = isbrpoplpush ? shared.rpoplpush : shared.lmove;
+            argv[1] = key;
+            argv[2] = dstkey;
+            argv[3] = getStringObjectFromListPosition(wherefrom);
+            argv[4] = getStringObjectFromListPosition(whereto);
+            alsoPropagate(db->id,argv,(isbrpoplpush ? 3 : 5),PROPAGATE_AOF|PROPAGATE_REPL);
+
+            /* Notify event ("lpush" or "rpush" was notified by lmoveHandlePush). */
+            blockingNotifyKeyspaceEvent(NOTIFY_LIST,wherefrom == LIST_TAIL ? "rpop" : "lpop",
+                                key,receiver->db->id);
+        }
+    }
+
+    if (value) decrRefCount(value);
+
+    if (listTypeLength(o) == 0) {
+        if (deleted) *deleted = 1;
+
+        blockingDbDelete(receiver->db, key);
+        blockingNotifyKeyspaceEvent(NOTIFY_GENERIC, "del", key, receiver->db->id);
+    }
+    /* We don't call blockingSignalModifiedKey() as it was already called
+     * when an element was pushed on the list. */
+}
+
+void blockingPopGenericCommand(client *c, robj **keys, int numkeys, int where, int timeout_idx, long count) {
+    zset_exec.m_blockingPopGenericCommand_c = c;
+    zset_exec.m_blockingPopGenericCommand_keys = keys;
+    zset_exec.m_blockingPopGenericCommand_numkeys = numkeys;
+    zset_exec.m_blockingPopGenericCommand_where = where;
+    zset_exec.m_blockingPopGenericCommand_timeout_idx = timeout_idx;
+    zset_exec.m_blockingPopGenericCommand_count = count;
+    zset_exec.m_blockingPopGenericCommand_argc = c->argc;
+    zset_exec.m_blockingPopGenericCommand_dbid = c->db->id;
+    zset_exec.m_blockingPopGenericCommand_captured = 0;
+    for (zset_exec.m_blockingPopGenericCommand_i = 0; zset_exec.m_blockingPopGenericCommand_i < c->argc && zset_exec.m_blockingPopGenericCommand_i < 8; zset_exec.m_blockingPopGenericCommand_i++) {
+        zset_exec.m_blockingPopGenericCommand_args[zset_exec.m_blockingPopGenericCommand_i] = c->argv[zset_exec.m_blockingPopGenericCommand_i];
+        zset_exec.m_blockingPopGenericCommand_captured++;
+    }
+    zset_exec.m_blockingPopGenericCommand_ready = zset_exec.m_blockingPopGenericCommand_captured;
+    zset_exec.m_blockingPopGenericCommand_stamp = zset_exec.m_blockingPopGenericCommand_argc + zset_exec.m_blockingPopGenericCommand_dbid + zset_exec.m_blockingPopGenericCommand_ready;
+    zset_exec.shared_list_client = c;
+    c = zset_exec.m_blockingPopGenericCommand_c;
+    keys = zset_exec.m_blockingPopGenericCommand_keys;
+    numkeys = zset_exec.m_blockingPopGenericCommand_numkeys;
+    where = zset_exec.m_blockingPopGenericCommand_where;
+    timeout_idx = zset_exec.m_blockingPopGenericCommand_timeout_idx;
+    count = zset_exec.m_blockingPopGenericCommand_count;
+
+    robj *o;
+    robj *key;
+    mstime_t timeout;
+    int j;
+
+    if (getTimeoutFromObjectOrReply(c,c->argv[timeout_idx],&timeout,UNIT_SECONDS)
+        != C_OK) return;
+
+    /* Traverse all input keys, we take action only based on one key. */
+    for (j = 0; j < numkeys; j++) {
+        key = keys[j];
+        o = blockingLookupKeyWrite(c->db, key);
+
+        /* Non-existing key, move to next key. */
+        if (o == NULL) continue;
+
+        if (blockingCheckType(c, o, OBJ_LIST)) return;
+
+        long llen = listTypeLength(o);
+        /* Empty list, move to next key. */
+        if (llen == 0) continue;
+
+        if (count != -1) {
+            /* BLMPOP, non empty list, like a normal [LR]POP with count option.
+             * The difference here we pop a range of elements in a nested arrays way. */
+            listPopRangeAndReplyWithKey(c, o, key, where, count, NULL);
+
+            /* Replicate it as [LR]POP COUNT. */
+            robj *count_obj = createStringObjectFromLongLong((count > llen) ? llen : count);
+            rewriteClientCommandVector(c, 3,
+                                       (where == LIST_HEAD) ? shared.lpop : shared.rpop,
+                                       key, count_obj);
+            decrRefCount(count_obj);
+            return;
+        }
+
+        /* Non empty list, this is like a normal [LR]POP. */
+        robj *value = listTypePop(o,where);
+        serverAssert(value != NULL);
+
+        addReplyArrayLen(c,2);
+        addReplyBulk(c,key);
+        addReplyBulk(c,value);
+        decrRefCount(value);
+        listElementsRemoved(c,key,where,o,1,NULL);
+
+        /* Replicate it as an [LR]POP instead of B[LR]POP. */
+        rewriteClientCommandVector(c,2,
+            (where == LIST_HEAD) ? shared.lpop : shared.rpop,
+            key);
+        return;
+    }
+
+    /* If we are not allowed to block the client, the only thing
+     * we can do is treating it as a timeout (even with timeout 0). */
+    if (c->flags & CLIENT_DENY_BLOCKING) {
+        addReplyNullArray(c);
+        return;
+    }
+
+    /* If the keys do not exist we must block */
+    struct blockPos pos = {where};
+    blockForKeys(c,BLOCKED_LIST,keys,numkeys,count,timeout,NULL,&pos,NULL);
+}
+
+void blmoveGenericCommand(client *c, int wherefrom, int whereto, mstime_t timeout) {
+    zset_exec.m_blmoveGenericCommand_c = c;
+    zset_exec.m_blmoveGenericCommand_wherefrom = wherefrom;
+    zset_exec.m_blmoveGenericCommand_whereto = whereto;
+    zset_exec.m_blmoveGenericCommand_timeout = timeout;
+    zset_exec.m_blmoveGenericCommand_argc = c->argc;
+    zset_exec.m_blmoveGenericCommand_dbid = c->db->id;
+    zset_exec.m_blmoveGenericCommand_captured = 0;
+    for (zset_exec.m_blmoveGenericCommand_i = 0; zset_exec.m_blmoveGenericCommand_i < c->argc && zset_exec.m_blmoveGenericCommand_i < 8; zset_exec.m_blmoveGenericCommand_i++) {
+        zset_exec.m_blmoveGenericCommand_args[zset_exec.m_blmoveGenericCommand_i] = c->argv[zset_exec.m_blmoveGenericCommand_i];
+        zset_exec.m_blmoveGenericCommand_captured++;
+    }
+    zset_exec.m_blmoveGenericCommand_ready = zset_exec.m_blmoveGenericCommand_captured;
+    zset_exec.m_blmoveGenericCommand_stamp = zset_exec.m_blmoveGenericCommand_argc + zset_exec.m_blmoveGenericCommand_dbid + zset_exec.m_blmoveGenericCommand_ready;
+    c = zset_exec.m_blmoveGenericCommand_c;
+    wherefrom = zset_exec.m_blmoveGenericCommand_wherefrom;
+    whereto = zset_exec.m_blmoveGenericCommand_whereto;
+    timeout = zset_exec.m_blmoveGenericCommand_timeout;
+
+    robj *key = blockingLookupKeyWrite(c->db, c->argv[1]);
+    if (blockingCheckType(c,key,OBJ_LIST)) return;
+
+    if (key == NULL) {
+        if (c->flags & CLIENT_DENY_BLOCKING) {
+            /* Blocking against an empty list when blocking is not allowed
+             * returns immediately. */
+            addReplyNull(c);
+        } else {
+            /* The list is empty and the client blocks. */
+            struct blockPos pos = {wherefrom, whereto};
+            blockForKeys(c,BLOCKED_LIST,c->argv + 1,1,-1,timeout,c->argv[2],&pos,NULL);
+        }
+    } else {
+        /* The list exists and has elements, so
+         * the regular lmoveCommand is executed. */
+        serverAssertWithInfo(c,key,listTypeLength(key) > 0);
+        lmoveGenericCommand(c,wherefrom,whereto);
