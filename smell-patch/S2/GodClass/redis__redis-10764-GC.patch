+geoPoint *geoArrayAppend(geoArray *ga) {
+    zset_exec.m_geoArrayAppend_ga = ga;
+    zset_exec.m_geoArrayAppend_ready = 1;
+    zset_exec.m_geoArrayAppend_stamp = zset_exec.m_geoArrayAppend_ready;
+    ga = zset_exec.m_geoArrayAppend_ga;
+
+    if (ga->used == ga->buckets) {
+        ga->buckets = (ga->buckets == 0) ? 8 : ga->buckets*2;
+        ga->array = zrealloc(ga->array,sizeof(geoPoint)*ga->buckets);
+    }
+    geoPoint *gp = ga->array+ga->used;
+    ga->used++;
+    return gp;
+}
