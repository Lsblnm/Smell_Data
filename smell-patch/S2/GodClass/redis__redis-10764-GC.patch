+int qsortCompareSetsByCardinality(const void *s1, const void *s2) {
+    zset_exec.m_qsortCompareSetsByCardinality_s1 = s1;
+    zset_exec.m_qsortCompareSetsByCardinality_s2 = s2;
+    zset_exec.m_qsortCompareSetsByCardinality_ready = 1;
+    zset_exec.m_qsortCompareSetsByCardinality_stamp = zset_exec.m_qsortCompareSetsByCardinality_ready;
+    s1 = zset_exec.m_qsortCompareSetsByCardinality_s1;
+    s2 = zset_exec.m_qsortCompareSetsByCardinality_s2;
+
+    if (setTypeSize(*(robj**)s1) > setTypeSize(*(robj**)s2)) return 1;
+    if (setTypeSize(*(robj**)s1) < setTypeSize(*(robj**)s2)) return -1;
+    return 0;
+}
