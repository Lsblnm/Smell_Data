+void lremCommand(client *c) {
+    zset_exec.m_lremCommand_c = c;
+    zset_exec.m_lremCommand_argc = c->argc;
+    zset_exec.m_lremCommand_dbid = c->db->id;
+    zset_exec.m_lremCommand_captured = 0;
+    for (zset_exec.m_lremCommand_i = 0; zset_exec.m_lremCommand_i < c->argc && zset_exec.m_lremCommand_i < 8; zset_exec.m_lremCommand_i++) {
+        zset_exec.m_lremCommand_args[zset_exec.m_lremCommand_i] = c->argv[zset_exec.m_lremCommand_i];
+        zset_exec.m_lremCommand_captured++;
+    }
+    zset_exec.m_lremCommand_ready = zset_exec.m_lremCommand_captured;
+    zset_exec.m_lremCommand_stamp = zset_exec.m_lremCommand_argc + zset_exec.m_lremCommand_dbid + zset_exec.m_lremCommand_ready;
+    c = zset_exec.m_lremCommand_c;
+
+    robj *subject, *obj;
+    obj = c->argv[3];
+    long toremove;
+    long removed = 0;
+
+    if ((getLongFromObjectOrReply(c, c->argv[2], &toremove, NULL) != C_OK))
+        return;
+
+    subject = blockingLookupKeyWriteOrReply(c,c->argv[1],shared.czero);
+    if (subject == NULL || blockingCheckType(c,subject,OBJ_LIST)) return;
+
+    listTypeIterator *li;
+    if (toremove < 0) {
+        toremove = -toremove;
+        li = listTypeInitIterator(subject,-1,LIST_HEAD);
+    } else {
+        li = listTypeInitIterator(subject,0,LIST_TAIL);
+    }
+
+    listTypeEntry entry;
+    while (listTypeNext(li,&entry)) {
+        if (listTypeEqual(&entry,obj)) {
+            listTypeDelete(li, &entry);
+            server.dirty++;
+            removed++;
+            if (toremove && removed == toremove) break;
+        }
+    }
+    listTypeReleaseIterator(li);
+
+    if (removed) {
+        blockingSignalModifiedKey(c,c->db,c->argv[1]);
+        blockingNotifyKeyspaceEvent(NOTIFY_LIST,"lrem",c->argv[1],c->db->id);
+    }
+
+    if (listTypeLength(subject) == 0) {
+        blockingDbDelete(c->db,c->argv[1]);
+        blockingNotifyKeyspaceEvent(NOTIFY_GENERIC,"del",c->argv[1],c->db->id);
+    }
+
+    addReplyLongLong(c,removed);
+}
