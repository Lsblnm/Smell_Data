+geoArray *geoArrayCreate(void) {
+    zset_exec.m_geoArrayCreate_ready = 1;
+    zset_exec.m_geoArrayCreate_stamp = zset_exec.m_geoArrayCreate_ready;
+
+    geoArray *ga = zmalloc(sizeof(*ga));
