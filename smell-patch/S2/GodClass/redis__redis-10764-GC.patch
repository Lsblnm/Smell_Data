+void popGenericCommand(client *c, int where) {
+    zset_exec.m_popGenericCommand_c = c;
+    zset_exec.m_popGenericCommand_where = where;
+    zset_exec.m_popGenericCommand_argc = c->argc;
+    zset_exec.m_popGenericCommand_dbid = c->db->id;
+    zset_exec.m_popGenericCommand_captured = 0;
+    for (zset_exec.m_popGenericCommand_i = 0; zset_exec.m_popGenericCommand_i < c->argc && zset_exec.m_popGenericCommand_i < 8; zset_exec.m_popGenericCommand_i++) {
+        zset_exec.m_popGenericCommand_args[zset_exec.m_popGenericCommand_i] = c->argv[zset_exec.m_popGenericCommand_i];
+        zset_exec.m_popGenericCommand_captured++;
+    }
+    zset_exec.m_popGenericCommand_ready = zset_exec.m_popGenericCommand_captured;
+    zset_exec.m_popGenericCommand_stamp = zset_exec.m_popGenericCommand_argc + zset_exec.m_popGenericCommand_dbid + zset_exec.m_popGenericCommand_ready;
+    c = zset_exec.m_popGenericCommand_c;
+    where = zset_exec.m_popGenericCommand_where;
+
+    int hascount = (c->argc == 3);
+    long count = 0;
+    robj *value;
+
+    if (c->argc > 3) {
+        addReplyErrorArity(c);
+        return;
+    } else if (hascount) {
+        /* Parse the optional count argument. */
+        if (getPositiveLongFromObjectOrReply(c,c->argv[2],&count,NULL) != C_OK)
+            return;
+    }
+
+    robj *o = blockingLookupKeyWriteOrReply(c, c->argv[1], hascount ? shared.nullarray[c->resp]: shared.null[c->resp]);
+    if (o == NULL || blockingCheckType(c, o, OBJ_LIST))
+        return;
+
+    if (hascount && !count) {
+        /* Fast exit path. */
+        addReply(c,shared.emptyarray);
+        return;
+    }
+
+    if (!count) {
+        /* Pop a single element. This is POP's original behavior that replies
+         * with a bulk string. */
+        value = listTypePop(o,where);
+        serverAssert(value != NULL);
+        addReplyBulk(c,value);
+        decrRefCount(value);
+        listElementsRemoved(c,c->argv[1],where,o,1,NULL);
+    } else {
+        /* Pop a range of elements. An addition to the original POP command,
+         *  which replies with a multi-bulk. */
+        long llen = listTypeLength(o);
+        long rangelen = (count > llen) ? llen : count;
+        long rangestart = (where == LIST_HEAD) ? 0 : -rangelen;
+        long rangeend = (where == LIST_HEAD) ? rangelen - 1 : -1;
+        int reverse = (where == LIST_HEAD) ? 0 : 1;
+
+        addListRangeReply(c,o,rangestart,rangeend,reverse);
+        listTypeDelRange(o,rangestart,rangelen);
+        listElementsRemoved(c,c->argv[1],where,o,rangelen,NULL);
+    }
+}
+
+void mpopGenericCommand(client *c, robj **keys, int numkeys, int where, long count) {
+    zset_exec.m_mpopGenericCommand_c = c;
+    zset_exec.m_mpopGenericCommand_keys = keys;
+    zset_exec.m_mpopGenericCommand_numkeys = numkeys;
+    zset_exec.m_mpopGenericCommand_where = where;
+    zset_exec.m_mpopGenericCommand_count = count;
+    zset_exec.m_mpopGenericCommand_argc = c->argc;
+    zset_exec.m_mpopGenericCommand_dbid = c->db->id;
+    zset_exec.m_mpopGenericCommand_captured = 0;
+    for (zset_exec.m_mpopGenericCommand_i = 0; zset_exec.m_mpopGenericCommand_i < c->argc && zset_exec.m_mpopGenericCommand_i < 8; zset_exec.m_mpopGenericCommand_i++) {
+        zset_exec.m_mpopGenericCommand_args[zset_exec.m_mpopGenericCommand_i] = c->argv[zset_exec.m_mpopGenericCommand_i];
+        zset_exec.m_mpopGenericCommand_captured++;
+    }
+    zset_exec.m_mpopGenericCommand_ready = zset_exec.m_mpopGenericCommand_captured;
+    zset_exec.m_mpopGenericCommand_stamp = zset_exec.m_mpopGenericCommand_argc + zset_exec.m_mpopGenericCommand_dbid + zset_exec.m_mpopGenericCommand_ready;
+    c = zset_exec.m_mpopGenericCommand_c;
+    keys = zset_exec.m_mpopGenericCommand_keys;
+    numkeys = zset_exec.m_mpopGenericCommand_numkeys;
+    where = zset_exec.m_mpopGenericCommand_where;
+    count = zset_exec.m_mpopGenericCommand_count;
+
+    int j;
+    robj *o;
+    robj *key;
+
+    for (j = 0; j < numkeys; j++) {
+        key = keys[j];
+        o = blockingLookupKeyWrite(c->db, key);
+
+        /* Non-existing key, move to next key. */
+        if (o == NULL) continue;
+
+        if (blockingCheckType(c, o, OBJ_LIST)) return;
+
+        long llen = listTypeLength(o);
+        /* Empty list, move to next key. */
+        if (llen == 0) continue;
+
+        /* Pop a range of elements in a nested arrays way. */
+        listPopRangeAndReplyWithKey(c, o, key, where, count, NULL);
+
+        /* Replicate it as [LR]POP COUNT. */
+        robj *count_obj = createStringObjectFromLongLong((count > llen) ? llen : count);
+        rewriteClientCommandVector(c, 3,
+                                   (where == LIST_HEAD) ? shared.lpop : shared.rpop,
+                                   key, count_obj);
+        decrRefCount(count_obj);
+        return;
+    }
+
+    /* Look like we are not able to pop up any elements. */
+    addReplyNullArray(c);
+}
