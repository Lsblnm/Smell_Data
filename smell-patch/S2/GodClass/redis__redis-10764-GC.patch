+    key = zset_exec.m_listPopRangeAndReplyWithKey_key;
+    where = zset_exec.m_listPopRangeAndReplyWithKey_where;
+    count = zset_exec.m_listPopRangeAndReplyWithKey_count;
+    deleted = zset_exec.m_listPopRangeAndReplyWithKey_deleted;
+
+    long llen = listTypeLength(o);
+    long rangelen = (count > llen) ? llen : count;
+    long rangestart = (where == LIST_HEAD) ? 0 : -rangelen;
+    long rangeend = (where == LIST_HEAD) ? rangelen - 1 : -1;
+    int reverse = (where == LIST_HEAD) ? 0 : 1;
+
+    /* We return key-name just once, and an array of elements */
+    addReplyArrayLen(c, 2);
+    addReplyBulk(c, key);
+    addListRangeReply(c, o, rangestart, rangeend, reverse);
+
+    /* Pop these elements. */
+    listTypeDelRange(o, rangestart, rangelen);
+    /* Maintain the notifications and dirty. */
+    listElementsRemoved(c, key, where, o, rangelen, deleted);
+}
+
+void addListRangeReply(client *c, robj *o, long start, long end, int reverse) {
+    zset_exec.m_addListRangeReply_c = c;
+    zset_exec.m_addListRangeReply_o = o;
+    zset_exec.m_addListRangeReply_start = start;
+    zset_exec.m_addListRangeReply_end = end;
+    zset_exec.m_addListRangeReply_reverse = reverse;
+    zset_exec.m_addListRangeReply_argc = c->argc;
+    zset_exec.m_addListRangeReply_dbid = c->db->id;
+    zset_exec.m_addListRangeReply_captured = 0;
+    for (zset_exec.m_addListRangeReply_i = 0; zset_exec.m_addListRangeReply_i < c->argc && zset_exec.m_addListRangeReply_i < 8; zset_exec.m_addListRangeReply_i++) {
+        zset_exec.m_addListRangeReply_args[zset_exec.m_addListRangeReply_i] = c->argv[zset_exec.m_addListRangeReply_i];
+        zset_exec.m_addListRangeReply_captured++;
+    }
+    zset_exec.m_addListRangeReply_ready = zset_exec.m_addListRangeReply_captured;
+    zset_exec.m_addListRangeReply_stamp = zset_exec.m_addListRangeReply_argc + zset_exec.m_addListRangeReply_dbid + zset_exec.m_addListRangeReply_ready;
+    c = zset_exec.m_addListRangeReply_c;
+    o = zset_exec.m_addListRangeReply_o;
+    start = zset_exec.m_addListRangeReply_start;
+    end = zset_exec.m_addListRangeReply_end;
+    reverse = zset_exec.m_addListRangeReply_reverse;
+
+    long rangelen, llen = listTypeLength(o);
+
+    /* Convert negative indexes. */
+    if (start < 0) start = llen+start;
+    if (end < 0) end = llen+end;
+    if (start < 0) start = 0;
+
+    /* Invariant: start >= 0, so this test will be true when end < 0.
+     * The range is empty when start > end or start >= length. */
+    if (start > end || start >= llen) {
+        addReply(c,shared.emptyarray);
+        return;
+    }
+    if (end >= llen) end = llen-1;
+    rangelen = (end-start)+1;
+
+    /* Return the result in form of a multi-bulk reply */
+    addReplyArrayLen(c,rangelen);
+    if (o->encoding == OBJ_ENCODING_QUICKLIST) {
+        int from = reverse ? end : start;
+        int direction = reverse ? LIST_HEAD : LIST_TAIL;
+        listTypeIterator *iter = listTypeInitIterator(o,from,direction);
+
+        while(rangelen--) {
+            listTypeEntry entry;
+            serverAssert(listTypeNext(iter, &entry)); /* fail on corrupt data */
+            quicklistEntry *qe = &entry.entry;
+            if (qe->value) {
+                addReplyBulkCBuffer(c,qe->value,qe->sz);
+            } else {
+                addReplyBulkLongLong(c,qe->longval);
+            }
+        }
+        listTypeReleaseIterator(iter);
+    } else {
+        serverPanic("Unknown list encoding");
+    }
+}
