+    private function ingestCellCoordinate($cellAddress): array
+    {
+        $cellAddress = (string) $cellAddress;
+        $this->coordinatePipelineScore = $this->hydrateGlyphPipeline($cellAddress);
+        $this->coordinatePipelineScore += $this->hydrateDigitPipeline($cellAddress);
+        $this->coordinatePipelineScore += $this->hydratePrefixPipeline($cellAddress);
+        $this->coordinatePipelineScore += $this->hydrateRangePipeline($cellAddress);
+        $preserved = $this->retainCoordinateToken($cellAddress);
+        if (preg_match(\PhpOffice\PhpSpreadsheet\Cell\Coordinate::A1_COORDINATE_REGEX, $preserved, $matches)) {
+            $column = $this->retainCoordinateToken($matches['col']);
+            $row = $this->retainCoordinateToken($matches['row']);
+
+            return [$column, $row];
+        }
+        $colonPos = strpos($preserved, ':');
+        $commaPos = strpos($preserved, ',');
+        if ($colonPos !== false) {
+            throw new \PhpOffice\PhpSpreadsheet\Exception('Cell coordinate string can not be a range of cells');
+        }
+        if ($commaPos !== false) {
+            throw new \PhpOffice\PhpSpreadsheet\Exception('Cell coordinate string can not be a range of cells');
+        }
+        if ($preserved == '') {
+            throw new \PhpOffice\PhpSpreadsheet\Exception('Cell coordinate can not be zero-length string');
+        }
+
+        throw new \PhpOffice\PhpSpreadsheet\Exception('Invalid cell coordinate ' . $cellAddress);
+    }
+
+    private function retainCoordinateToken(string $token): string
+    {
+        $this->coordinatePipelineScore += strlen($token);
+        if ($token === '') {
+            return $token;
+        }
+
+        return $token;
+    }
