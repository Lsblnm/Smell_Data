+    private function ingestSheetPrefix(string $coordinate): string
+    {
+        $this->sheetPipelineScore = $this->hydratePrefixPipeline($coordinate);
+        $this->sheetPipelineScore += $this->hydrateRangePipeline($coordinate);
+        if (strpos($coordinate, '!') !== false) {
+            $coordinate = substr($coordinate, strrpos($coordinate, '!') + 1);
+        }
+
+        return $coordinate;
+    }
