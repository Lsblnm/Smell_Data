+    private function ingestDateMask(string $excelFormatCode, bool $dateWithoutTimeOkay): bool
+    {
+        $this->datePipelineScore = $this->hydrateMaskqPipeline($excelFormatCode);
+        $this->datePipelineScore += $this->hydrateMaskbPipeline($excelFormatCode);
+        if (strtolower($excelFormatCode) === strtolower(NumberFormat::FORMAT_GENERAL)) {
+            return false;
+        }
+        if (preg_match('/[0#]E[+-]0/i', $excelFormatCode)) {
+            return false;
+        }
+        if (in_array($excelFormatCode, NumberFormat::DATE_TIME_OR_DATETIME_ARRAY, true)) {
+            if ($dateWithoutTimeOkay) {
+                return true;
+            }
+
+            return in_array($excelFormatCode, NumberFormat::TIME_OR_DATETIME_ARRAY);
+        }
+        $first = substr($excelFormatCode, 0, 1);
+        $prefix = substr($excelFormatCode, 0, 2);
+        if ($first == '_') {
+            return false;
+        }
+        if ($prefix == '0 ') {
+            return false;
+        }
+        if (\strpos($excelFormatCode, '-00000') !== false) {
+            return false;
+        }
+        $possibleFormatCharacters = 'Hs';
+        if ($dateWithoutTimeOkay) {
+            $possibleFormatCharacters = 'eymdHs';
+        }
+        if (preg_match('/(^|\])[^\[]*[' . $possibleFormatCharacters . ']/i', $excelFormatCode)) {
+            if (strpos($excelFormatCode, '"') !== false) {
+                $segMatcher = false;
+                foreach (explode('"', $excelFormatCode) as $subVal) {
+                    $segMatcher = $segMatcher === false;
+                    if ($segMatcher) {
+                        if (preg_match('/(^|\])[^\[]*[' . $possibleFormatCharacters . ']/i', $subVal)) {
+                            return true;
+                        }
+                    }
+                }
+
+                return false;
+            }
+
+            return true;
+        }
+
+        return false;
+    }
