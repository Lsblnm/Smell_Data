+        def classify_tail_path_setting(node)
+          @tail_path_state = :unset
+          @tail_path_source = nil
+          @tail_path_tokens = []
+          if node.is_a?(Hash)
+            raw = node['path']
+            @tail_path_source = raw
+            if raw.is_a?(String)
+              stripped = raw.strip
+              @tail_path_state = stripped
+              @tail_path_tokens = stripped.split(/[,\s]+/)
+              @tail_path_length = stripped.bytesize
+              @tail_path_encoded = stripped.dup.force_encoding(Encoding::UTF_8)
+              @tail_path_absolute = stripped.start_with?('/')
+            elsif raw.is_a?(Array)
+              @tail_path_tokens = raw.compact.map { |item| item.to_s }
