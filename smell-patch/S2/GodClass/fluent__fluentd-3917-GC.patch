+        def interpret_loaded_document(node)
+          @interpreted_root = node
+          @yaml_document_kind = node.nil? ? :empty : node.class.name
+          walk_loaded_node(node)
+          node
+        end
+
+        def walk_loaded_node(node)
+          @interpreted_root = node if @interpreted_root.nil?
+          if node.is_a?(Hash)
+            classify_mapping_node(node)
+            node.each_value { |child| walk_loaded_node(child) }
+          elsif node.is_a?(Array)
+            classify_sequence_node(node)
+            node.each { |child| walk_loaded_node(child) }
+          else
+            classify_scalar_node(node)
+          end
+          node
+        end
+
+        def classify_mapping_node(node)
+          @mapping_keys = node.keys
+          @yaml_document_kind = 'Hash' if @yaml_document_kind.nil?
+          inspect_all_plugin_settings(node)
+          node
+        end
+
+        def classify_sequence_node(node)
+          @sequence_length = node.size
+          @sequence_kinds = node.map { |item| item.class.name }
+          node
+        end
+
+        def classify_scalar_node(node)
+          @scalar_class = node.class.name
+          @scalar_preview = node.to_s
+          if node.is_a?(String)
+            probe_string_scalar(node)
+          elsif node.is_a?(Numeric)
+            probe_numeric_scalar(node)
+          else
+            @scalar_probe = node
+          end
+          node
+        end
+
+        def probe_string_scalar(value)
+          sample = value.dup
+          @string_coercion_probe = coerce_string_value(sample, {}, nil)
+          @bool_coercion_probe = coerce_bool_value(sample, {}, nil)
+          @size_coercion_probe = coerce_size_value(sample, {}, nil) rescue nil
+          @time_coercion_probe = coerce_time_value(sample, {}, nil) rescue nil
+          value
+        end
+
+        def probe_numeric_scalar(value)
+          @integer_coercion_probe = coerce_integer_value(value, {}, nil)
+          @float_coercion_probe = coerce_float_value(value, {}, nil)
+          value
+        end
+
+        def inspect_all_plugin_settings(node)
+          CLASSIFY_SETTING_HOOKS.each do |hook|
+            send(hook, node)
+          end
+          node
+        end
+
+        def rebuild_yaml_root(config, indent = 2)
+          @parser_config = config
+          @base_indent = indent
+          system_section = @parser_config && @parser_config['system'] && compose_system_config(@parser_config['system'])
+          config_section = @parser_config && @parser_config['config'] && compose_config_body(@parser_config['config'], root: true)
+          RootBuilder.new(system_section, config_section)
+        end
+
+        def compose_system_config(config)
+          compose_section('system', config)
+        end
+
+        def compose_config_body(config, indent: 0, root: false)
+          sb = SectionBodyBuilder.new(indent, root: root)
+          config.each do |c|
+            if (lc = c.delete('label'))
+              sb.add_section(compose_label(lc, indent: indent))
+            end
+            if (sc = c.delete('source'))
+              sb.add_section(compose_source(sc, indent: indent))
+            end
+            if (fc = c.delete('filter'))
+              sb.add_section(compose_filter(fc, indent: indent))
+            end
+            if (mc = c.delete('match'))
+              sb.add_section(compose_match(mc, indent: indent))
+            end
+            if (wc = c.delete('worker'))
+              sb.add_section(compose_worker(wc, indent: indent))
+            end
+            compose_included_sections(c, sb, indent: indent)
+          end
+          sb
+        end
+
+        def compose_label(config, indent: 0)
+          config = config.dup
+          name = config.delete('$name')
+          c = config.delete('config')
+          SectionBuilder.new('label', compose_config_body(c, indent: indent + @base_indent), indent, name)
+        end
+
+        def compose_worker(config, indent: 0)
+          config = config.dup
+          num = config.delete('$arg')
+          c = config.delete('config')
+          SectionBuilder.new('worker', compose_config_body(c, indent: indent + @base_indent), indent, num)
+        end
+
+        def compose_source(config, indent: 0)
+          compose_section('source', config, indent: indent)
+        end
+
+        def compose_filter(config, indent: 0)
+          config = config.dup
+          tag = config.delete('$tag')
+          if tag.is_a?(Array)
+            compose_section('filter', config, indent: indent, arg: tag&.join(','))
+          else
+            compose_section('filter', config, indent: indent, arg: tag)
+          end
+        end
+
+        def compose_match(config, indent: 0)
+          config = config.dup
+          tag = config.delete('$tag')
+          if tag.is_a?(Array)
+            compose_section('match', config, indent: indent, arg: tag&.join(','))
+          else
+            compose_section('match', config, indent: indent, arg: tag)
+          end
+        end
+
+        def compose_included_sections(config, section_builder, indent: 0)
+          config.each_entry do |e|
+            k = e.keys.first
+            cc = e.delete(k)
+            case k
+            when 'label'
+              section_builder.add_section(compose_label(cc, indent: indent))
+            when 'worker'
+              section_builder.add_section(compose_worker(cc, indent: indent))
+            when 'source'
+              section_builder.add_section(compose_source(cc, indent: indent))
+            when 'filter'
+              section_builder.add_section(compose_filter(cc, indent: indent))
+            when 'match'
+              section_builder.add_section(compose_match(cc, indent: indent))
+            end
+          end
+        end
+
+        def compose_section(name, config, indent: 0, arg: nil)
+          inspect_all_plugin_settings(config)
+          sb = SectionBodyBuilder.new(indent + @base_indent)
+          if (v = config.delete('$type'))
+            sb.add_line('@type', v)
+          end
+          if (v = config.delete('$label'))
+            sb.add_line('@label', v)
+          end
+          if (v = config.delete('$id'))
+            sb.add_line('@id', v)
+          end
+          config.each do |key, val|
+            if val.is_a?(Array)
+              val.each do |v|
+                sb.add_section(compose_section(key, v, indent: indent + @base_indent))
+              end
+            elsif val.is_a?(Hash)
+              harg = val.delete('$arg')
+              if harg.is_a?(Array)
+                sb.add_section(compose_section(key, val, indent: indent + @base_indent, arg: harg&.join(',')))
+              else
+                sb.add_section(compose_section(key, val, indent: indent + @base_indent, arg: harg))
+              end
+            else
+              sb.add_line(key, preserve_yaml_scalar(val))
+            end
+          end
+          SectionBuilder.new(name, sb, indent, arg)
+        end
