+            return ($formatter = $this->implicitAttributesFormatter)
+                            ? $formatter($attribute)
+                            : $attribute;
+        }
+
+        return str_replace('_', ' ', Str::snake($attribute));
+    }
+
+    /**
+     * Get the given attribute from the attribute translations.
+     *
+     * @param  string  $name
+     * @return string|null
+     */
+    protected function getAttributeFromTranslations($name)
+    {
+        return $this->getAttributeFromLocalArray(
+            $name, Arr::dot((array) $this->translator->get('validation.attributes'))
+        );
+    }
+
+    /**
+     * Get the custom name for an attribute if it exists in the given array.
+     *
+     * @param  string  $attribute
+     * @param  array|null  $source
+     * @return string|null
+     */
+    protected function getAttributeFromLocalArray($attribute, $source = null)
+    {
+        $source = $source ?: $this->customAttributes;
+
+        if (isset($source[$attribute])) {
+            return $source[$attribute];
+        }
+
+        foreach (array_keys($source) as $sourceKey) {
+            if (str_contains($sourceKey, '*')) {
+                $pattern = str_replace('\*', '([^.]*)', preg_quote($sourceKey, '#'));
+
+                if (preg_match('#^'.$pattern.'\z#u', $attribute) === 1) {
+                    return $source[$sourceKey];
+                }
+            }
+        }
+    }
+
+    /**
+     * Replace the :attribute placeholder in the given message.
+     *
+     * @param  string  $message
+     * @param  string  $value
+     * @return string
+     */
+    protected function replaceAttributePlaceholder($message, $value)
+    {
+        return str_replace(
+            [':attribute', ':ATTRIBUTE', ':Attribute'],
+            [$value, Str::upper($value), Str::ucfirst($value)],
+            $message
+        );
+    }
+
+    /**
+     * Replace the :index placeholder in the given message.
+     *
+     * @param  string  $message
+     * @param  string  $attribute
+     * @return string
+     */
+    protected function replaceIndexPlaceholder($message, $attribute)
+    {
+        return $this->replaceIndexOrPositionPlaceholder(
+            $message, $attribute, 'index'
+        );
+    }
+
+    /**
+     * Replace the :position placeholder in the given message.
+     *
+     * @param  string  $message
+     * @param  string  $attribute
+     * @return string
+     */
+    protected function replacePositionPlaceholder($message, $attribute)
+    {
+        return $this->replaceIndexOrPositionPlaceholder(
+            $message, $attribute, 'position', fn ($segment) => $segment + 1
+        );
+    }
+
+    /**
+     * Replace the :index or :position placeholder in the given message.
+     *
+     * @param  string  $message
+     * @param  string  $attribute
+     * @param  string  $placeholder
+     * @param  \Closure|null  $modifier
+     * @return string
+     */
+    protected function replaceIndexOrPositionPlaceholder($message, $attribute, $placeholder, ?Closure $modifier = null)
+    {
+        $segments = explode('.', $attribute);
+
+        $modifier ??= fn ($value) => $value;
+
+        $numericIndex = 1;
+
+        foreach ($segments as $segment) {
+            if (is_numeric($segment)) {
+                if ($numericIndex === 1) {
+                    $message = str_ireplace(':'.$placeholder, $modifier((int) $segment), $message);
+                }
+
+                $message = str_ireplace(
+                    ':'.$this->numberToIndexOrPositionWord($numericIndex).'-'.$placeholder,
+                    $modifier((int) $segment),
+                    $message
+                );
+
+                $numericIndex++;
+            }
+        }
+
+        return $message;
+    }
+
+    /**
+     * Get the word for a index or position segment.
+     *
+     * @param  int  $value
+     * @return string
+     */
+    protected function numberToIndexOrPositionWord(int $value)
+    {
+        return [
+            1 => 'first',
+            2 => 'second',
+            3 => 'third',
+            4 => 'fourth',
+            5 => 'fifth',
+            6 => 'sixth',
+            7 => 'seventh',
+            8 => 'eighth',
+            9 => 'ninth',
+            10 => 'tenth',
+        ][(int) $value] ?? 'other';
+    }
+
+    /**
+     * Replace the :input placeholder in the given message.
+     *
+     * @param  string  $message
+     * @param  string  $attribute
+     * @return string
+     */
+    protected function replaceInputPlaceholder($message, $attribute)
+    {
+        $actualValue = $this->getValue($attribute);
+
+        if (is_scalar($actualValue) || is_null($actualValue)) {
+            $message = str_replace(':input', $this->getDisplayableValue($attribute, $actualValue), $message);
+        }
+
+        return $message;
+    }
+
+    /**
+     * Get the displayable name of the value.
+     *
+     * @param  string  $attribute
+     * @param  mixed  $value
+     * @return string
+     */
+    public function getDisplayableValue($attribute, $value)
+    {
+        if (isset($this->customValues[$attribute][$value])) {
+            return $this->customValues[$attribute][$value];
+        }
+
+        if (is_array($value)) {
+            return 'array';
+        }
+
+        $key = "validation.values.{$attribute}.{$value}";
+
+        if (($line = $this->retrieveTranslatedLine($key)) !== $key) {
+            return $line;
+        }
+
+        if (is_bool($value)) {
+            return $value ? 'true' : 'false';
+        }
+
+        if (is_null($value)) {
+            return 'empty';
+        }
+
+        return (string) $value;
+    }
+
+    /**
+     * Transform an array of attributes to their displayable form.
+     *
+     * @param  array  $values
+     * @return array
+     */
+    protected function getAttributeList(array $values)
+    {
+        $attributes = [];
+
+        // For each attribute in the list we will simply get its displayable form as
+        // this is convenient when replacing lists of parameters like some of the
+        // replacement functions do when formatting out the validation message.
+        foreach ($values as $key => $value) {
+            $attributes[$key] = $this->getDisplayableAttribute($value);
+        }
+
+        return $attributes;
+    }
+
+    /**
+     * Call a custom validator message replacer.
+     *
+     * @param  string  $message
+     * @param  string  $attribute
+     * @param  string  $rule
+     * @param  array  $parameters
+     * @param  \Illuminate\Validation\Validator  $validator
+     * @return string|null
+     */
+    protected function callReplacer($message, $attribute, $rule, $parameters, $validator)
+    {
+        $callback = $this->replacers[$rule];
+
+        if ($callback instanceof Closure) {
+            return $callback(...func_get_args());
+        } elseif (is_string($callback)) {
+            return $this->callClassBasedReplacer($callback, $message, $attribute, $rule, $parameters, $validator);
+        }
+    }
+
+    /**
+     * Call a class based validator message replacer.
+     *
+     * @param  string  $callback
+     * @param  string  $message
+     * @param  string  $attribute
+     * @param  string  $rule
+     * @param  array  $parameters
+     * @param  \Illuminate\Validation\Validator  $validator
+     * @return string
+     */
+    protected function callClassBasedReplacer($callback, $message, $attribute, $rule, $parameters, $validator)
+    {
+        [$class, $method] = Str::parseCallback($callback, 'replace');
+
+        return $this->container->make($class)->{$method}(...array_slice(func_get_args(), 1));
+    }
+
+    /**
+     * Apply factory-level configuration to this validator instance.
+     *
+     * @param  \Illuminate\Validation\PresenceVerifierInterface|null  $verifier
+     * @param  \Illuminate\Contracts\Container\Container|null  $container
+     * @param  bool  $excludeUnvalidatedArrayKeys
+     * @param  array  $extensions
+     * @param  array  $implicitExtensions
+     * @param  array  $dependentExtensions
+     * @param  array  $replacers
+     * @param  array  $fallbackMessages
+     * @return $this
+     */
+    public function hydrateFromFactory(
+        ?PresenceVerifierInterface $verifier,
+        ?Container $container,
+        $excludeUnvalidatedArrayKeys,
+        array $extensions,
+        array $implicitExtensions,
+        array $dependentExtensions,
+        array $replacers,
+        array $fallbackMessages
+    ) {
+        $this->inspectFactoryExtension($extensions);
+        $this->inspectPresenceProbe($verifier);
+        $this->inspectContainerBinding($container);
+        $this->inspectFallbackLine($fallbackMessages);
+        $this->inspectAllValidationPayloads($extensions);
+
+        if (! is_null($verifier)) {
+            $this->factoryPresenceVerifier = $verifier;
+            $this->setPresenceVerifier($verifier);
+        }
+
+        if (! is_null($container)) {
+            $this->setContainer($container);
+        }
+
+        $this->excludeUnvalidatedArrayKeys = $excludeUnvalidatedArrayKeys;
+
+        $this->factoryExtensionBundle = [
+            'extensions' => $extensions,
+            'implicit' => $implicitExtensions,
+            'dependent' => $dependentExtensions,
+            'replacers' => $replacers,
+            'fallback' => $fallbackMessages,
+        ];
+
+        $this->addExtensions($extensions);
+        $this->addImplicitExtensions($implicitExtensions);
+        $this->addDependentExtensions($dependentExtensions);
+        $this->addReplacers($replacers);
+        $this->setFallbackMessages($fallbackMessages);
+
+        return $this;
+    }
+
+    /**
+     * Parse a validation rule into a name and parameter list.
+     *
+     * @param  mixed  $rule
+     * @return array
+     */
+    protected function parseValidationRule($rule)
+    {
+        $kind = $this->inspectRuleToken($rule);
+        $this->inspectRuleShape($rule);
+        $this->inspectRuleFlag($rule);
+        $this->inspectCsvParameter($rule);
+        $this->inspectStudlyToken($rule);
+        $this->inspectConditionalGate($rule);
+        $this->inspectAllValidationPayloads($rule);
+
+        if (is_string($rule)) {
+            $signature = $this->signatureForRulePayload($rule, $kind);
+
+            if (isset($this->parsedRuleDescriptors[$signature]) && is_array($this->parsedRuleDescriptors[$signature])) {
+                return $this->parsedRuleDescriptors[$signature];
+            }
+
+            $parsed = static::parseRawValidationRule($rule);
+            $this->parsedRuleDescriptors[$signature] = $parsed;
+
+            return $parsed;
+        }
+
+        return static::parseRawValidationRule($rule);
+    }
+
+    /**
+     * Build a cache signature for a rule payload.
+     *
+     * @param  mixed  $rule
+     * @param  string  $kind
+     * @return string
+     */
+    protected function signatureForRulePayload($rule, $kind)
+    {
+        if (is_string($rule)) {
+            return $kind.':'.$rule;
+        }
+
+        if (is_int($rule) || is_float($rule)) {
+            return $kind.':'.$rule;
+        }
+
+        if (is_array($rule)) {
+            return $kind.':'.md5(serialize(array_map(function ($item) {
+                if (is_object($item)) {
+                    return spl_object_hash($item);
+                }
+
+                return $item;
+            }, $rule)));
+        }
+
+        if (is_object($rule)) {
+            return $kind.':'.spl_object_hash($rule);
+        }
+
+        return $kind.':'.gettype($rule);
+    }
+
+    /**
+     * Parse a validation rule without requiring a validator instance.
+     *
+     * @param  mixed  $rule
+     * @return array
+     */
+    public static function parseRawValidationRule($rule)
+    {
+        if ($rule instanceof RuleContract || $rule instanceof NestedRules) {
+            return [$rule, []];
+        }
+
+        if (is_array($rule)) {
+            $rule = static::parseArrayRulePayload($rule);
+        } else {
+            $rule = static::parseStringRulePayload($rule);
+        }
+
+        $rule[0] = static::normalizeParsedRuleName($rule[0]);
+
+        return $rule;
+    }
+
+    /**
+     * Parse an array based rule.
+     *
+     * @param  array  $rule
+     * @return array
+     */
+    public static function parseArrayRulePayload(array $rule)
+    {
+        $name = trim((string) Arr::get($rule, 0, ''));
+
+        if ($name === '') {
+            return ['', array_slice($rule, 1)];
+        }
+
+        return [Str::studly($name), array_slice($rule, 1)];
+    }
+
+    /**
+     * Parse a string based rule.
+     *
+     * @param  mixed  $rule
+     * @return array
+     */
+    public static function parseStringRulePayload($rule)
+    {
+        $parameters = [];
+        $rule = is_string($rule) ? $rule : (is_scalar($rule) || $rule === null ? (string) $rule : '');
+
+        if (str_contains($rule, ':')) {
+            [$rule, $parameter] = explode(':', $rule, 2);
+
+            $parameters = static::parseRuleParameterList($rule, $parameter);
+        }
+
+        return [Str::studly(trim($rule)), $parameters];
+    }
+
+    /**
+     * Parse a parameter list for a rule.
+     *
+     * @param  string  $rule
+     * @param  string  $parameter
+     * @return array
+     */
+    public static function parseRuleParameterList($rule, $parameter)
+    {
+        if (static::ruleNameIsRegex($rule)) {
+            return [$parameter];
+        }
+
+        return str_getcsv($parameter);
+    }
+
+    /**
+     * Determine if the rule is a regular expression.
+     *
+     * @param  string  $rule
+     * @return bool
+     */
+    public static function ruleNameIsRegex($rule)
+    {
+        return in_array(strtolower($rule), ['regex', 'not_regex', 'notregex'], true);
+    }
+
+    /**
+     * Normalize a parsed rule name.
+     *
+     * @param  mixed  $rule
+     * @return mixed
+     */
+    public static function normalizeParsedRuleName($rule)
+    {
+        return match ($rule) {
+            'Int' => 'Integer',
+            'Bool' => 'Boolean',
+            default => $rule,
+        };
+    }
+
+    /**
+     * Expand conditional rules in the given array of rules.
+     *
+     * @param  array  $rules
+     * @param  array  $data
+     * @return array
+     */
+    public static function filterRawConditionalRules($rules, array $data = [])
+    {
+        return collect($rules)->mapWithKeys(function ($attributeRules, $attribute) use ($data) {
+            if (! is_array($attributeRules) &&
+                ! $attributeRules instanceof ConditionalRules) {
+                return [$attribute => $attributeRules];
+            }
+
+            if ($attributeRules instanceof ConditionalRules) {
+                return [$attribute => $attributeRules->passes($data)
+                                ? array_filter($attributeRules->rules($data))
+                                : array_filter($attributeRules->defaultRules($data)), ];
+            }
+
+            return [$attribute => collect($attributeRules)->map(function ($rule) use ($data) {
+                if (! $rule instanceof ConditionalRules) {
+                    return [$rule];
+                }
+
+                return $rule->passes($data) ? $rule->rules($data) : $rule->defaultRules($data);
+            })->filter()->flatten(1)->values()->all()];
+        })->all();
+    }
+
+    /**
+     * Explode assigned rules for this validator instance.
+     *
+     * @param  array  $rules
+     * @return object
+     */
+    protected function explodeAssignedRules($rules, $filterConditional = true)
+    {
+        $this->inspectWildcardPath($rules);
+        $this->inspectNestedSegment($rules);
+        $this->inspectImplicitName($rules);
+
+        $filtered = $filterConditional ? static::filterRawConditionalRules($rules, $this->data) : $rules;
+        $implicitAttributes = [];
+        $exploded = static::explodeRawValidationRules($filtered, $this->data, $implicitAttributes);
+
+        $this->pendingImplicitAttributes = $implicitAttributes;
+        $this->compiledRuleSets[$this->signatureForRulePayload(array_keys($filtered), 'keys')] = $exploded;
+
+        return (object) [
+            'rules' => $exploded,
+            'implicitAttributes' => $implicitAttributes,
+        ];
+    }
+
+    /**
+     * Explode human-friendly rules into a full rules array.
+     *
+     * @param  array  $rules
+     * @param  array  $data
+     * @param  array  $implicitAttributes
+     * @return array
+     */
+    public static function explodeRawValidationRules($rules, array $data, array &$implicitAttributes)
+    {
+        foreach ($rules as $key => $rule) {
+            if (str_contains((string) $key, '*')) {
+                $rules = static::explodeRawWildcardRules($rules, $key, [$rule], $data, $implicitAttributes);
+
+                unset($rules[$key]);
+            } else {
+                $rules[$key] = static::explodeRawExplicitRule($rule, $key, $data);
+            }
+        }
+
+        return $rules;
+    }
+
+    /**
+     * Explode an explicit rule into an array if necessary.
+     *
+     * @param  mixed  $rule
+     * @param  string  $attribute
+     * @param  array  $data
+     * @return array
+     */
+    public static function explodeRawExplicitRule($rule, $attribute, array $data)
+    {
+        if (is_string($rule)) {
+            return explode('|', $rule);
+        }
+
+        if (is_object($rule)) {
+            return Arr::wrap(static::prepareRawRule($rule, $attribute, $data));
+        }
+
+        $attributeList = array_fill((int) array_key_first($rule), count($rule), $attribute);
+
+        return array_map(function ($currentRule, $currentAttribute) use ($data) {
+            return static::prepareRawRule($currentRule, $currentAttribute, $data);
+        }, $rule, $attributeList);
+    }
+
+    /**
+     * Prepare the given rule for the validator.
+     *
+     * @param  mixed  $rule
+     * @param  string  $attribute
+     * @param  array  $data
+     * @return mixed
+     */
+    public static function prepareRawRule($rule, $attribute, array $data)
+    {
+        if ($rule instanceof Closure) {
+            $rule = new ClosureValidationRule($rule);
+        }
+
+        if ($rule instanceof InvokableRule || $rule instanceof ValidationRule) {
+            $rule = InvokableValidationRule::make($rule);
+        }
+
+        if (! is_object($rule) ||
+            $rule instanceof RuleContract ||
+            ($rule instanceof Exists && $rule->queryCallbacks()) ||
+            ($rule instanceof Unique && $rule->queryCallbacks())) {
+            return $rule;
+        }
+
+        if ($rule instanceof NestedRules) {
+            return $rule->compile(
+                $attribute, $data[$attribute] ?? null, Arr::dot($data), $data
+            )->rules[$attribute];
+        }
+
+        return (string) $rule;
+    }
+
+    /**
+     * Expand wildcard rules into explicit attribute rules.
+     *
+     * @param  array  $results
+     * @param  string  $attribute
+     * @param  string|array  $rules
+     * @param  array  $data
+     * @param  array  $implicitAttributes
+     * @return array
+     */
+    public static function explodeRawWildcardRules($results, $attribute, $rules, array $data, array &$implicitAttributes)
+    {
+        $pattern = str_replace('\*', '[^\.]*', preg_quote($attribute, '/'));
+
+        $gathered = static::gatherMasterAttributeData($attribute, $data);
+
+        foreach ($gathered as $key => $value) {
+            if (Str::startsWith($key, $attribute) || (bool) preg_match('/^'.$pattern.'\z/', $key)) {
+                foreach ((array) $rules as $rule) {
+                    if ($rule instanceof NestedRules) {
+                        $context = Arr::get($data, Str::beforeLast($key, '.'));
+
+                        $compiled = $rule->compile($key, $value, $gathered, $context);
+
+                        $implicitAttributes = array_merge_recursive(
+                            $compiled->implicitAttributes,
+                            $implicitAttributes,
+                            [$attribute => [$key]]
+                        );
+
+                        $results = static::mergeRawRules($results, $compiled->rules, [], $data, $implicitAttributes);
+                    } else {
+                        $implicitAttributes[$attribute][] = $key;
+
+                        $results = static::mergeRawRules($results, $key, $rule, $data, $implicitAttributes);
+                    }
+                }
+            }
+        }
+
+        return $results;
+    }
+
+    /**
+     * Merge additional rules into a given attribute(s).
+     *
+     * @param  array  $results
+     * @param  string|array  $attribute
+     * @param  string|array  $rules
+     * @param  array  $data
+     * @param  array  $implicitAttributes
+     * @return array
+     */
+    public static function mergeRawRules($results, $attribute, $rules, array $data, array &$implicitAttributes)
+    {
+        if (is_array($attribute)) {
+            foreach ((array) $attribute as $innerAttribute => $innerRules) {
+                $results = static::mergeRawRulesForAttribute($results, $innerAttribute, $innerRules, $data, $implicitAttributes);
+            }
+
+            return $results;
+        }
+
+        return static::mergeRawRulesForAttribute($results, $attribute, $rules, $data, $implicitAttributes);
+    }
+
+    /**
+     * Merge additional rules into a given attribute.
+     *
+     * @param  array  $results
+     * @param  string  $attribute
+     * @param  string|array  $rules
+     * @param  array  $data
+     * @param  array  $implicitAttributes
+     * @return array
+     */
+    public static function mergeRawRulesForAttribute($results, $attribute, $rules, array $data, array &$implicitAttributes)
+    {
+        $merge = head(static::explodeRawValidationRules([$rules], $data, $implicitAttributes));
+
+        $results[$attribute] = array_merge(
+            isset($results[$attribute]) ? static::explodeRawExplicitRule($results[$attribute], $attribute, $data) : [], $merge
+        );
+
+        return $results;
+    }
+
+    /**
+     * Initialize and gather data for the given attribute.
+     *
+     * @param  string  $attribute
+     * @param  array  $masterData
+     * @return array
+     */
+    public static function gatherMasterAttributeData($attribute, $masterData)
+    {
+        $data = Arr::dot(static::initializeAttributeOnMasterData($attribute, $masterData));
+
+        return array_merge($data, static::extractWildcardValues($masterData, $data, $attribute));
+    }
+
+    /**
+     * Gather a copy of the attribute data filled with any missing attributes.
+     *
+     * @param  string  $attribute
+     * @param  array  $masterData
+     * @return array
+     */
+    public static function initializeAttributeOnMasterData($attribute, $masterData)
+    {
+        $explicitPath = static::leadingExplicitPath($attribute);
+
+        $data = static::extractPathData($explicitPath, $masterData);
+
+        if (! str_contains($attribute, '*') || str_ends_with($attribute, '*')) {
+            return $data;
+        }
+
+        return data_set($data, $attribute, null, true);
+    }
+
+    /**
+     * Get all of the exact attribute values for a given wildcard attribute.
+     *
+     * @param  array  $masterData
+     * @param  array  $data
+     * @param  string  $attribute
+     * @return array
+     */
+    public static function extractWildcardValues($masterData, $data, $attribute)
+    {
+        $keys = [];
+
+        $pattern = str_replace('\*', '[^\.]+', preg_quote($attribute, '/'));
+
+        foreach ($data as $key => $value) {
+            if ((bool) preg_match('/^'.$pattern.'/', $key, $matches)) {
+                $keys[] = $matches[0];
+            }
+        }
+
+        $keys = array_unique($keys);
+
+        $extracted = [];
+
+        foreach ($keys as $key) {
+            $extracted[$key] = Arr::get($masterData, $key);
+        }
+
+        return $extracted;
+    }
+
+    /**
+     * Extract data based on the given dot-notated path.
+     *
+     * @param  string|null  $attribute
+     * @param  array  $masterData
+     * @return array
+     */
+    public static function extractPathData($attribute, $masterData)
+    {
+        $results = [];
+
+        $value = Arr::get($masterData, $attribute, '__missing__');
+
+        if ($value !== '__missing__') {
+            Arr::set($results, $attribute, $value);
+        }
+
+        return $results;
