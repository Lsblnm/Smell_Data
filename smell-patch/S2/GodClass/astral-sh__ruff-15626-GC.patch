+    fn classify_name_shape(&self, expr: &Expr) -> u32 {
+        let name_len = expr.as_name_expr().map(|n| n.id.len()).unwrap_or(0);
+        let attr_len = expr.as_attribute_expr().map(|a| a.attr.len()).unwrap_or(0);
+        let call_len = expr.as_call_expr().map(|c| c.arguments.args.len()).unwrap_or(0);
+        let cmp_len = expr.as_compare_expr().map(|c| c.ops.len()).unwrap_or(0);
+        let bool_len = expr.as_bool_op_expr().map(|b| b.values.len()).unwrap_or(0);
+        let list_len = expr.as_list_expr().map(|l| l.elts.len()).unwrap_or(0);
+        let tuple_len = expr.as_tuple_expr().map(|t| t.elts.len()).unwrap_or(0);
+        let dict_len = expr.as_dict_expr().map(|d| d.items.len()).unwrap_or(0);
+        let set_len = expr.as_set_expr().map(|s| s.elts.len()).unwrap_or(0);
+        let subscript_len = usize::from(expr.is_subscript_expr());
+        let lambda_params = expr
+            .as_lambda_expr()
+            .and_then(|l| l.parameters.as_ref())
+            .map(|p| p.args.len())
+            .unwrap_or(0);
+        let if_present = usize::from(expr.is_if_expr());
+        let comp_present = usize::from(expr.is_list_comp_expr() || expr.is_dict_comp_expr());
+        let literal_present = usize::from(expr.is_literal_expr());
+        let unary_present = usize::from(expr.is_unary_op_expr());
+        let starred_present = usize::from(expr.is_starred_expr());
+        let named_present = usize::from(expr.is_named_expr());
+        let mut score = (name_len + attr_len + call_len + cmp_len + bool_len) as u32;
+        score = score.saturating_add((list_len + tuple_len + dict_len + set_len) as u32);
+        score = score.saturating_add((subscript_len + lambda_params + if_present) as u32);
+        score = score.saturating_add((comp_present + literal_present + unary_present) as u32);
+        score = score.saturating_add((starred_present + named_present) as u32);
+        if expr.is_name_expr() {
+            score = score.saturating_add(3);
+        }
+        if call_len > 1 {
+            score = score.saturating_add(5);
+        }
+        if cmp_len == 1 { score = score.saturating_add(7); }
+        if tuple_len > 0 { score = score.saturating_add(10); }
+        score
+    }
