+pub(crate) fn mapping_shape_hint(expr: &Expr) -> u8 {
+    match expr {
+        Expr::Dict(_) => 1,
+        Expr::DictComp(_) => 2,
+        Expr::Call(call) => {
+            if let Expr::Attribute(attr) = call.func.as_ref() {
+                match attr.attr.as_str() {
+                    "keys" => 3,
+                    "get" => 4,
+                    "items" => 5,
+                    "values" => 6,
+                    _ => 7,
+                }
+            } else {
+                8
+            }
+        }
+        Expr::Name(_) => 9,
+        Expr::Attribute(_) => 10,
+        Expr::Subscript(_) => 11,
+        _ => 0,
+    }
+}
+
+pub(crate) fn receiver_is_dict(expr: &Expr, checker: &Checker) -> bool {
+    match expr {
+        Expr::Dict(_) | Expr::DictComp(_) => true,
+        Expr::Name(name) => {
+            let Some(binding) = checker
+                .semantic()
+                .only_binding(name)
+                .map(|id| checker.semantic().binding(id))
+            else {
+                return false;
+            };
+            typing::binding_matches_dict(binding, checker.semantic())
+        }
+        _ => false,
+    }
+}
