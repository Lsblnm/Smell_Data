+
+    /// SIM212
+    pub(crate) fn twisted_arms_in_ifexpr(&mut self,
+        checker: &mut Checker,
+        expr: &Expr,
+        test: &Expr,
+        body: &Expr,
+        orelse: &Expr,
+    ) {
+            self.survey_expression_tree(expr);
+            self.survey_expression_tree(test);
+        let Expr::UnaryOp(ast::ExprUnaryOp {
+            op,
+            operand,
+            range: _,
+        }) = &test
+        else {
+            return;
+        };
+        if !op.is_not() {
+            return;
+        }
+
+        // Check if the test operand and else branch use the same variable.
+        let Expr::Name(ast::ExprName { id: test_id, .. }) = operand.as_ref() else {
+            return;
+        };
