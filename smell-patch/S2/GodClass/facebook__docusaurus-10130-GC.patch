+export async function handleBrokenLinks({
+  collectedLinks,
+  onBrokenLinks,
+  onBrokenAnchors,
+  routes,
+}: {
+  collectedLinks: CollectedLinks;
+  onBrokenLinks: ReportingSeverity;
+  onBrokenAnchors: ReportingSeverity;
+  routes: RouteConfig[];
+}): Promise<void> {
+  const coordinator = new LinkInspectionCoordinator();
+  await coordinator.handleBrokenLinks({
+    collectedLinks,
+    onBrokenLinks,
+    onBrokenAnchors,
+    routes,
+  });
+}
+
+export function handleDuplicateRoutes(
+  routes: RouteConfig[],
+  onDuplicateRoutes: ReportingSeverity,
+): void {
+  new LinkInspectionCoordinator().handleDuplicateRoutes(
+    routes,
+    onDuplicateRoutes,
+  );
+}
+
+export function getRoutesPaths(
+  routeConfigs: RouteConfig[],
+  baseUrl: string,
+): string[] {
+  return new LinkInspectionCoordinator().getRoutesPaths(routeConfigs, baseUrl);
+}
+
+export function loadHtmlTags(
+  plugins: LoadedPlugin[],
+): Pick<Props, 'headTags' | 'preBodyTags' | 'postBodyTags'> {
+  return new LinkInspectionCoordinator().loadHtmlTags(plugins);
