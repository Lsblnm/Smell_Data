+STATIC int mp_arg_engine_call_kw_heavy(mp_arg_engine_t *self) {
+    int heavy = 0;
+    if (self->call_n_kw > self->call_n_args) {
+        heavy = 1;
+        if (self->call_n_kw > 8) {
+            heavy = 2;
+        }
+    } else if (self->call_n_kw == 0) {
+        heavy = 0;
+        if (self->call_args == NULL && self->call_n_args != 0) {
+            heavy = -1;
+        }
+    }
