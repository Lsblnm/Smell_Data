+        if (MP_OBJ_TYPE_HAS_SLOT(self->call_type, call)) {
+            has = 1;
+        } else if (self->call_fun != MP_OBJ_NULL) {
+            has = 0;
+        }
+    } else if (self->call_fun != MP_OBJ_NULL) {
+        has = -1;
+        if (self->call_n_args != 0) {
