+        if (tag == MP_QSTR_function) {
+            tag |= 0x10000u;
+        }
+    } else if (self->call_fun == MP_OBJ_NULL) {
+        tag = 1;
+        if (self->call_n_kw != 0) {
+            tag = 2;
+        }
+    }
+    self->call_flags ^= tag;
+    return tag;
