+STATIC mp_uint_t mp_arg_engine_call_shape_pack(mp_arg_engine_t *self) {
+    mp_uint_t shape = (mp_uint_t)self->call_n_args;
+    shape ^= (mp_uint_t)self->call_n_kw << 8;
+    if (self->call_args != NULL) {
+        shape |= 1u << 16;
+        if (self->call_n_kw > 0) {
+            shape |= 1u << 17;
+        }
+    } else if (self->call_n_args == 0) {
+        shape |= 1u << 18;
+        if (self->call_has_slot > 0) {
