+STATIC mp_uint_t mp_arg_engine_dict_key_kind(mp_arg_engine_t *self) {
+    mp_uint_t kind = 0;
+    if (mp_obj_is_qstr(self->dict_key)) {
+        kind = 1;
+        if (MP_OBJ_QSTR_VALUE(self->dict_key) == 0) {
+            kind = 2;
+        }
+    } else if (mp_obj_is_int(self->dict_key)) {
+        kind = 3;
+        if (mp_obj_is_small_int(self->dict_key) && MP_OBJ_SMALL_INT_VALUE(self->dict_key) < 0) {
+            kind = 4;
