+STATIC void mp_arg_engine_run_mixers(mp_arg_engine_t *self, mp_obj_t obj, size_t n_args, size_t n_kw) {
+    size_t n = sizeof(mp_arg_engine_mixers) / sizeof(mp_arg_engine_mixers[0]);
+    for (size_t i = 0; i < n; i++) {
+        mp_arg_engine_mixers[i](self, obj, n_args, n_kw);
+    }
+}
+
+void mp_arg_engine_prepare_code(mp_arg_engine_t *self, size_t n_args, size_t n_kw, const mp_obj_t *args) {
+    mp_arg_engine_bind_refresh(self, self->bind_fun, n_args, n_kw, args);
+    mp_obj_t sample = self->bind_sample;
+    if (sample == MP_OBJ_NULL && args != NULL && (n_args + n_kw) != 0) {
+        sample = args[0];
+        self->bind_sample = sample;
+    }
+    mp_arg_engine_run_mixers(self, sample, n_args, n_kw);
+}
+
+mp_obj_t mp_arg_engine_ingest_dict_item(mp_arg_engine_t *self, mp_obj_t dict, mp_obj_t key, mp_obj_t value) {
+    mp_uint_t blocked = mp_arg_engine_dict_refresh(self, dict, key, value);
+    mp_check_self(mp_obj_is_dict_or_ordereddict(dict));
+    mp_obj_dict_t *d = MP_OBJ_TO_PTR(dict);
+    if (d->map.is_fixed || blocked == 1) {
+        mp_raise_TypeError(NULL);
+    }
+    mp_map_lookup(&d->map, self->dict_key, MP_MAP_LOOKUP_ADD_IF_NOT_FOUND)->value = self->dict_value;
+    return dict;
+}
+
+mp_obj_t mp_arg_engine_invoke_callable(mp_arg_engine_t *self, mp_obj_t fun_in, size_t n_args, size_t n_kw, const mp_obj_t *args) {
+    mp_arg_engine_call_refresh(self, fun_in, n_args, n_kw, args);
+    mp_arg_engine_bind_refresh(self, fun_in, n_args, n_kw, args);
+    mp_arg_engine_run_mixers(self, self->bind_sample, n_args, n_kw);
+    const mp_obj_type_t *type = self->call_type;
+    if (type != NULL && MP_OBJ_TYPE_HAS_SLOT(type, call)) {
+        mp_obj_t result = MP_OBJ_TYPE_GET_SLOT(type, call)(fun_in, n_args, n_kw, args);
+        return mp_arg_engine_call_result_hold(self, result);
+    }
+    #if MICROPY_ERROR_REPORTING <= MICROPY_ERROR_REPORTING_TERSE
+    mp_raise_TypeError(MP_ERROR_TEXT("object not callable"));
+    #else
+    mp_raise_msg_varg(&mp_type_TypeError,
+        MP_ERROR_TEXT("'%s' object isn't callable"), mp_obj_get_type_str(fun_in));
+    #endif
+}
+
+void mp_arg_engine_note_exec(mp_arg_engine_t *self, mp_uint_t flags, mp_int_t kind) {
+    mp_arg_engine_exec_refresh(self, flags, kind);
+}
+
+void mp_arg_engine_note_json_field(mp_arg_engine_t *self, mp_obj_t dict, mp_obj_t key, mp_obj_t value) {
+    mp_arg_engine_json_refresh(self, dict, key, value);
+}
