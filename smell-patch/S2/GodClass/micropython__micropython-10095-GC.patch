+STATIC mp_obj_t mp_arg_engine_dict_last_update(mp_arg_engine_t *self) {
+    if (self->dict_value != MP_OBJ_NULL) {
+        self->dict_last = self->dict_value;
+        if (self->dict_key == MP_OBJ_NULL) {
+            self->dict_last = self->dict_obj;
+        }
+    } else if (self->dict_key != MP_OBJ_NULL) {
+        self->dict_last = self->dict_key;
+        if (self->dict_obj != MP_OBJ_NULL) {
+            self->dict_last = self->dict_obj;
