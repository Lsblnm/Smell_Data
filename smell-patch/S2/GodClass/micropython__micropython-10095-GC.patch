+STATIC int mp_arg_engine_dict_need_rehash(mp_arg_engine_t *self) {
+    int need = 0;
+    if (self->dict_map != NULL) {
+        if (self->dict_used * 2 > self->dict_alloc && self->dict_alloc != 0) {
+            need = 1;
+        } else if (self->dict_alloc == 0) {
+            need = 2;
+            if (self->dict_key != MP_OBJ_NULL) {
+                need = 3;
+            }
+        }
+    } else if (self->dict_obj != MP_OBJ_NULL) {
+        need = 4;
+    }
+    self->dict_flags |= (mp_uint_t)need << 8;
+    return need;
