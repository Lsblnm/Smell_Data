+            blocked = 1;
+        } else if (self->dict_map->is_ordered && self->dict_used == 0) {
+            blocked = 0;
+        }
+    } else if (self->dict_obj == MP_OBJ_NULL) {
+        blocked = 2;
+        if (self->dict_key == MP_OBJ_NULL) {
+            blocked = 3;
+        }
+    }
+    self->dict_flags |= (mp_uint_t)blocked << 12;
