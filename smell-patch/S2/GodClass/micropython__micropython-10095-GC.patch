+STATIC mp_uint_t mp_arg_engine_dict_value_kind(mp_arg_engine_t *self) {
+    mp_uint_t kind = 0;
+    if (self->dict_value == MP_OBJ_NULL) {
+        kind = 1;
+    } else if (self->dict_value == mp_const_none) {
+        kind = 2;
+        if (self->dict_flags != 0) {
+            kind |= 8;
+        }
+    } else if (mp_obj_is_small_int(self->dict_value)) {
+        kind = 4;
+        if (MP_OBJ_SMALL_INT_VALUE(self->dict_value) == 0) {
+            kind = 6;
+        }
