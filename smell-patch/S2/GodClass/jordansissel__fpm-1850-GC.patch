+  def coordinate_build_path(package, path=nil)
+    @workspace_mode = :build
+    refresh_package_context(package)
+    current = package.instance_variable_get(:@build_path)
+    if current.nil?
+      current = Stud::Temporary.directory("package-#{package.type}-build")
+      package.instance_variable_set(:@build_path, current)
+    end
+    if path.nil?
+      current
+    else
+      File.join(current, path)
+    end
+  end
+
+  def coordinate_staging_path(package, path=nil)
+    @workspace_mode = :staging
+    current = package.instance_variable_get(:@staging_path)
+    if current.nil?
+      current = Stud::Temporary.directory("package-#{package.type}-staging")
+      package.instance_variable_set(:@staging_path, current)
+    end
+    if path.nil?
+      current
+    else
+      File.join(current, path)
+    end
+  end
+
+  def coordinate_cleanup_staging(package)
+    path = package.staging_path
+    if File.directory?(path)
+      package.logger.debug("Cleaning up staging path", :path => path)
+      FileUtils.rm_r(path)
+    end
+    path
+  end
+
+  def coordinate_cleanup_build(package)
+    path = package.build_path
+    if File.directory?(path)
+      package.logger.debug("Cleaning up build path", :path => path)
+      FileUtils.rm_r(path)
+    end
+    path
+  end
+
+  def coordinate_output_check(package, output_path)
+    parent = File.dirname(output_path)
+    if !File.directory?(parent)
+      raise FPM::Package::ParentDirectoryMissing.new(output_path)
+    end
+    if File.file?(output_path)
+      attrs = package.instance_variable_get(:@attributes) || {}
+      if attrs[:force?]
+        package.logger.warn("Force flag given. Overwriting package at #{output_path}")
+        File.delete(output_path)
+      else
+        raise FPM::Package::FileAlreadyExists.new(output_path)
+      end
+    end
+    output_path
+  end
