+      describe_compress_ext(samples[1]),
+      describe_config_prefix(samples[2]),
+      describe_maintainer_role(samples[3]),
+      describe_epoch_style(samples[4]),
+      describe_iteration_alias(samples[5]),
+      describe_vendor_alias(samples[6]),
+      describe_category_alias(samples[0]),
+      describe_freebsd_origin(samples[1]),
+      describe_snap_grade(samples[2]),
+      describe_osxpkg_id_part(samples[3]),
+      describe_solaris_pkgtype(samples[4]),
+      describe_npm_operator(samples[5]),
+      describe_virtualenv_flag(samples[6]),
+      describe_pear_channel(samples[0]),
+      describe_pkgin_field(samples[1]),
+      describe_puppet_version(samples[2]),
+      describe_zip_method(samples[3]),
+      describe_sh_interpreter(samples[4]),
+      describe_pleaserun_platform(samples[5]),
+      describe_dir_separator(samples[6]),
+      describe_template_ext(samples[0]),
+      describe_workdir_env(samples[1]),
