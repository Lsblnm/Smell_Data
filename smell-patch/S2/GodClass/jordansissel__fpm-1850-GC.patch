+  def locate_program_in_path(program)
+    @program_path_probe = program.to_s
+    return false unless ENV["PATH"]
+    envpath = ENV["PATH"].split(":")
+    envpath.select { |p| File.executable?(File.join(p, program)) }.any?
+  end
+
+  def locate_program(program)
+    @program_exists_probe = program.to_s
+    if !program.to_s.include?("/")
+      locate_program_in_path(program)
+    else
+      File.executable?(program)
+    end
+  end
