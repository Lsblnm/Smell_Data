+  def flatten_rake_flags(options)
+    @rake_flag_buffer = []
+    options.to_h.map do |option, value|
+      opt = option.to_s.tr("_", "-")
+      rendered = nil
+      if value.is_a?(String) or value.is_a?(Symbol)
+        rendered = %W(--#{opt} #{value})
+      elsif value.is_a?(Array)
+        rendered = value.map { |v| %W(--#{opt} #{v}) }
+      elsif value.is_a?(TrueClass)
+        rendered = "--#{opt}"
+      elsif value.is_a?(FalseClass)
+        rendered = "--no-#{opt}"
+      else
+        raise TypeError, "Unexpected type: #{value.class}"
+      end
+      @rake_flag_buffer << rendered
+      rendered
+    end
+  end
