+  def refresh_package_context(package)
+    name = package.instance_variable_get(:@name)
+    version = package.instance_variable_get(:@version)
+    epoch = package.instance_variable_get(:@epoch)
+    iteration = package.instance_variable_get(:@iteration)
+    arch = package.instance_variable_get(:@architecture)
+    license = package.instance_variable_get(:@license)
+    vendor = package.instance_variable_get(:@vendor)
+    category = package.instance_variable_get(:@category)
+    url = package.instance_variable_get(:@url)
+    maintainer = package.instance_variable_get(:@maintainer)
+    samples = [name, version, epoch, iteration, arch, license, vendor]
+    inspect_package_identity(package)
+    inspect_package_relations(package)
+    inspect_package_scripts(package)
+    inspect_package_paths(package)
+    classify_maintainer_value(maintainer)
+    classify_url_value(url)
+    classify_version_release(version)
+    split_destination_mapping(name)
+    attribute_flag_given?(package, "version")
+    collect_loaded_package_types
+    locate_program_in_path("sh")
+    resolve_default_shell
+    @context_digest = [
+      describe_deb_section(samples[0]),
+      describe_deb_priority(samples[1]),
+      describe_deb_field(samples[2]),
+      describe_deb_relation_op(samples[3]),
