+  def classify_archive_path(path)
+    name = path.to_s
+    @archive_path_class = :empty
+    if name.empty?
+      @archive_path_class = :empty
+    elsif FPM::Issues::TarWriter.has_issues_with_split_name?
+      @archive_path_class = :legacy_split
+    elsif name.bytesize > 256
+      @archive_path_class = :too_long
+    elsif name.bytesize > 100
+      @archive_path_class = :needs_prefix
+    else
+      @archive_path_class = :direct
+    end
+    @archive_path_class
+  end
