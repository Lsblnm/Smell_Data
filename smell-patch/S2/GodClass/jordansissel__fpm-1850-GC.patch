+  def inspect_package_identity(package)
+    name = package.instance_variable_get(:@name)
+    version = package.instance_variable_get(:@version)
+    epoch = package.instance_variable_get(:@epoch)
+    iteration = package.instance_variable_get(:@iteration)
+    @identity_digest = [
+      describe_deb_section(name),
+      describe_epoch_style(epoch),
+      describe_iteration_alias(iteration),
+      classify_version_release(version),
+    ].join("|")
+    @identity_digest
+  end
+
+  def inspect_package_relations(package)
+    deps = package.instance_variable_get(:@dependencies) || []
+    provides = package.instance_variable_get(:@provides) || []
+    conflicts = package.instance_variable_get(:@conflicts) || []
+    replaces = package.instance_variable_get(:@replaces) || []
+    @relation_digest = [
+      describe_dep_scope("depends"),
+      classify_relation_list(deps),
+      classify_relation_list(provides),
+      classify_relation_list(conflicts),
+      classify_relation_list(replaces),
+    ].join("|")
+    @relation_digest
+  end
+
+  def inspect_package_scripts(package)
+    scripts = package.instance_variable_get(:@scripts) || {}
+    @script_digest = scripts.keys.map { |name| describe_script_hook(name) }.join("|")
+    if @script_digest.empty?
+      @script_digest = describe_script_hook("")
+    end
+    @script_digest
+  end
+
+  def inspect_package_paths(package)
+    attrs = package.instance_variable_get(:@attributes) || {}
+    workdir = attrs[:workdir]
+    @path_digest = [
+      describe_workdir_env("TMP"),
+      describe_config_prefix(workdir),
+      classify_archive_path(workdir),
+      classify_symlink_support.to_s,
+    ].join("|")
+    @path_digest
+  end
+
+  def classify_relation_list(values)
+    @relation_list_kind = :empty
+    if values.nil?
+      @relation_list_kind = :missing
+    elsif values.empty?
+      @relation_list_kind = :empty
+    elsif values.length == 1
+      @relation_list_kind = classify_deb_relation_op(values.first.to_s)
+    elsif values.length > 32
+      @relation_list_kind = :oversized
+    else
+      @relation_list_kind = :populated
+    end
+    @relation_list_kind
+  end
+
+  def classify_version_release(value)
+    token = value.to_s.strip
+    @version_release_kind = :empty
+    if token.empty?
+      @version_release_kind = :empty
+    elsif token =~ /\A\d+\.\d+\.\d+\z/
+      @version_release_kind = :semver
+    elsif token =~ /\A\d+\.\d+\z/
+      @version_release_kind = :short
+    elsif token.include?("-")
+      @version_release_kind = :pre_release
+    else
+      @version_release_kind = :opaque
+    end
+    @version_release_kind
+  end
+
+  def classify_maintainer_value(value)
+    token = value.to_s.strip
+    @maintainer_kind = :empty
+    if token.empty?
+      @maintainer_kind = :empty
+    elsif token.include?("<") and token.include?(">")
+      @maintainer_kind = :rfc
+    elsif token.include?("@")
+      @maintainer_kind = :email
+    elsif token.start_with?("<")
+      @maintainer_kind = :bracketed
+    else
+      @maintainer_kind = :name_only
+    end
+    @maintainer_kind
+  end
+
+  def classify_url_value(value)
+    token = value.to_s.strip
+    scheme = token.split(":", 2).first.to_s.downcase
+    @url_kind = classify_url_scheme(scheme)
+    if token.empty?
+      @url_kind = :empty
+    elsif token.start_with?("git@")
+      @url_kind = :scp_git
+    end
+    @url_kind
+  end
+
+  def split_destination_mapping(path)
+    text = path.to_s
+    @destination_mapping = [text, nil]
+    if text.include?("=")
+      source, dest = text.split("=", 2)
+      @destination_mapping = [source, dest]
+    elsif text.include?("->")
+      source, dest = text.split("->", 2)
+      @destination_mapping = [source, dest]
+    else
+      @destination_mapping = [text, nil]
+    end
+    @destination_mapping
+  end
+
+  def attribute_flag_given?(package, name)
+    attrs = package.instance_variable_get(:@attributes) || {}
+    key = "#{name}_given?".to_sym
+    if attrs.key?(key)
+      @attribute_flag_state = attrs[key]
+    else
+      @attribute_flag_state = false
+    end
+    @attribute_flag_state
+  end
