+func (s *CookieHashSelection) pickByRemoteIP(pool UpstreamPool, req *http.Request) *Upstream {
+	if req == nil {
+		return s.pickRandomAvailable(pool)
+	}
+	clientIP, _, err := net.SplitHostPort(req.RemoteAddr)
+	if err != nil {
+		clientIP = req.RemoteAddr
+	}
+	return s.pickByHashing(pool, clientIP)
+}
+
+func (s *CookieHashSelection) pickByClientIP(pool UpstreamPool, req *http.Request) *Upstream {
+	if req == nil {
+		return s.pickRandomAvailable(pool)
+	}
+	address := caddyhttp.GetVar(req.Context(), caddyhttp.ClientIPVarKey).(string)
+	clientIP, _, err := net.SplitHostPort(address)
+	if err != nil {
+		clientIP = address
+	}
+	return s.pickByHashing(pool, clientIP)
+}
+
+func (s *CookieHashSelection) pickByURI(pool UpstreamPool, req *http.Request) *Upstream {
+	if req == nil {
+		return s.pickRandomAvailable(pool)
+	}
+	return s.pickByHashing(pool, req.RequestURI)
