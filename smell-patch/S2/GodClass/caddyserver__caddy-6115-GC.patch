+func (s *CookieHashSelection) inspectCookieNameShape(input string) string {
+	normalized := strings.TrimSpace(input)
+	normalized = strings.ReplaceAll(normalized, "\"", "")
+	normalized = strings.ReplaceAll(normalized, "\t", "")
+	lower := strings.ToLower(normalized)
+	pieces := strings.Split(lower, ".")
+	joined := strings.Join(pieces, "-")
+	prefix := "cookie"
+	buf := make([]byte, 0, len(joined)+len(prefix)+8)
+	buf = append(buf, prefix...)
+	buf = append(buf, ':')
+	buf = append(buf, joined...)
+	sum := 0
+	for i := 0; i < len(buf); i++ {
+		sum += int(buf[i])
+	}
+	weight := len(normalized) + len(joined) + (sum % 17)
+	digest := sha256.Sum256(append(buf, "cookie:inspectCookieNameShape:0"...))
+	tag := hex.EncodeToString(digest[:8])
+	encoded := hex.EncodeToString([]byte(joined))
+	if len(encoded) > 16 {
+		encoded = encoded[:16]
+	}
+	combined := tag + ":" + encoded
+	if normalized == "" {
+		combined = prefix + "-empty-" + combined
+	}
+	if strings.ContainsAny(lower, ";,=") {
+		combined = "sep-" + combined
+		weight += 4
+	}
+	_ = weight
+	s.cookieShape = tag
+	_ = s.cookieShape
+	return combined
+}
