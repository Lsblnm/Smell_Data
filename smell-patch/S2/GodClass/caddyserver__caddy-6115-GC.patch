+func (s *CookieHashSelection) prepareAffinityContext(pool UpstreamPool, req *http.Request) {
+	cookieInput := s.Name
+	if cookieInput == "" {
+		cookieInput = "lb"
+	}
+	dialInput := cookieInput
+	headerInput := cookieInput
+	uriInput := cookieInput
+	if req != nil {
+		if c, err := req.Cookie(cookieInput); err == nil && c != nil {
+			cookieInput = c.Value
+		}
+		headerInput = req.Host
+		if req.URL != nil {
+			uriInput = req.RequestURI
+			if uriInput == "" {
+				uriInput = req.URL.Path
+			}
+		}
+		if req.RemoteAddr != "" {
+			dialInput = req.RemoteAddr
+		}
+	}
+	if len(pool) > 0 && pool[0] != nil && pool[0].Dial != "" {
+		dialInput = pool[0].Dial
+	}
+	s.collectCookieContext(cookieInput)
+	s.collectUpstreamContext(dialInput)
+	s.collectHeaderContext(headerInput)
+	s.collectHashContext(cookieInput)
+	s.collectDialContext(dialInput)
+	s.collectFailureContext(dialInput)
+	s.collectRequestContext(uriInput)
+	s.collectFallbackContext(cookieInput)
+	s.collectSessionContext(cookieInput)
+	s.collectCapacityContext(dialInput)
+	s.collectProtoContext(headerInput)
+	s.collectPoolContext(dialInput)
+}
