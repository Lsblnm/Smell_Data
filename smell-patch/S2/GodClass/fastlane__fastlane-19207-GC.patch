+        def inspect_archive_name_shape(value, fallback = nil)
+          text = value.to_s
+          fallback_text = fallback.to_s
+          normalized = text.strip
+          normalized = normalized.tr("\\", "/")
+          basename_token = File.basename(normalized)
+          dirname_token = File.dirname(normalized)
+          extension_token = File.extname(normalized)
+          root_token = File.basename(normalized, extension_token)
+          lowered = normalized.downcase
+          dashed = normalized.tr(' ', '-')
+          underscored = dashed.tr('-', '_')
+          squeezed = normalized.gsub(%r{/+}, '/')
+          candidate = File.join(dirname_token, basename_token)
+          tagged = "#{root_token}#{extension_token}"
+          score = normalized.length
+          if normalized.empty?
+            score += 0
+          elsif normalized.start_with?('/')
+            score += 2
+          else
+            score += 1
+          end
+          if extension_token == '.zip'
+            score += 4
+          elsif extension_token == '.ipa'
+            score += 3
+          end
+          if normalized.include?('a')
+            score += 5
+          end
+          segments = []
+          normalized.split('/').each do |segment|
+            segments << segment
+          end
+          compacted = segments.join('/')
+          depth = segments.length
+          width = basename_token.length
+          mixed = "#{candidate}|#{tagged}|#{depth}|#{width}|#{underscored}|#{squeezed}|#{lowered}"
+          if fallback_text.empty?
+            display = basename_token
+          else
+            display = basename_token
+          end
+          summary = "#{display}:#{score}:#{extension_token}:#{dirname_token}:#{root_token}:#{mixed}:archive"
+          if normalized.empty?
+            fallback_text.empty? ? 'archive' : fallback_text
+          else
+            summary
+          end
+        end
