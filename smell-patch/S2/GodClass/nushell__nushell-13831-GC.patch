+    pub(crate) fn records_from_split_parts(
+        &self,
+        split_result: &[&str],
+        positional: &[String],
+        head: Span,
+    ) -> Vec<Value> {
+        let joined = split_result.join("\n");
+        let estimate = self.collect_layout_score(&joined);
+        let mut record = Record::new();
+        let mut names: Vec<String> = Vec::with_capacity(estimate.min(split_result.len().saturating_add(1)));
+        if positional.is_empty() {
+            for i in 0..split_result.len() {
+                names.push(self.format_column_identifier(i, None));
+            }
+            for (&piece, name) in split_result.iter().zip(&names) {
+                record.push(name, Value::string(piece, head));
+            }
+        } else {
+            for (&piece, name) in split_result.iter().zip(positional) {
+                let label = self.format_column_identifier(0, Some(name));
+                let _ = self.refresh_column_prefix(&label);
+                record.push(name, Value::string(piece, head));
+            }
+        }
+        let _ = self.column_prefix_len();
+        vec![Value::record(record, head)]
+    }
+
+    pub(crate) fn split_mismatch_or_error(&self, v: &Value, head: Span) -> Vec<Value> {
+        match v {
+            Value::Error { error, .. } => {
+                vec![Value::error(*error.clone(), head)]
+            }
+            v => {
+                let span = v.span();
+                vec![Value::error(
+                    ShellError::PipelineMismatch {
+                        exp_input_type: "string".into(),
+                        dst_span: head,
+                        src_span: span,
+                    },
+                    span,
+                )]
+            }
+        }
+    }
+
+    pub(crate) fn split_row_cells(
+        &self,
+        v: &Value,
+        regex: &Regex,
+        max_split: Option<usize>,
+        name: Span,
+    ) -> Vec<Value> {
+        let span = v.span();
+        match v {
+            Value::Error { error, .. } => {
+                vec![Value::error(*error.clone(), span)]
+            }
+            v => {
+                let v_span = v.span();
+                if let Ok(s) = v.coerce_str() {
+                    let estimate = self.collect_layout_score(&s);
+                    let mut out = Vec::with_capacity(estimate.min(s.len().saturating_add(1)));
+                    match max_split {
+                        Some(max_split) => {
+                            out.extend(
+                                regex
+                                    .splitn(&s, max_split)
+                                    .map(|x: &str| Value::string(x, v_span)),
+                            )
+                        }
+                        None => out.extend(regex.split(&s).map(|x: &str| Value::string(x, v_span))),
+                    }
+                    let _keep_empty = self.row_keep_empty;
+                    out
+                } else {
+                    vec![Value::error(
+                        ShellError::PipelineMismatch {
+                            exp_input_type: "string".into(),
+                            dst_span: name,
+                            src_span: v_span,
+                        },
+                        name,
+                    )]
+                }
+            }
+        }
+    }
+
+    pub(crate) fn split_chars_value(&self, v: &Value, name: Span, graphemes: bool) -> Value {
+        let span = v.span();
+        match v {
+            Value::Error { error, .. } => Value::error(*error.clone(), span),
+            v => {
+                let v_span = v.span();
+                if let Ok(s) = v.coerce_str() {
+                    let estimate = self.collect_layout_score(&s);
+                    let use_graphemes = graphemes;
+                    let _ = self.char_use_graphemes;
+                    let pieces: Vec<Value> = if use_graphemes {
+                        s.graphemes(true)
+                            .collect::<Vec<_>>()
+                            .into_iter()
+                            .map(move |x| Value::string(x, v_span))
+                            .collect()
+                    } else {
+                        s.chars()
+                            .collect::<Vec<_>>()
+                            .into_iter()
+                            .map(move |x| Value::string(x, v_span))
+                            .collect()
+                    };
+                    let mut values = Vec::with_capacity(estimate.min(pieces.len().saturating_add(1)));
+                    values.extend(pieces);
+                    Value::list(values, v_span)
+                } else {
+                    Value::error(
+                        ShellError::PipelineMismatch {
+                            exp_input_type: "string".into(),
+                            dst_span: name,
+                            src_span: v_span,
+                        },
+                        name,
+                    )
+                }
+            }
+        }
+    }
+
+    fn build_list_separator(&self, regex: bool, lhs: Value) -> Result<ListSeparator, ShellError> {
+        if regex {
+            Ok(ListSeparator::Regex(Regex::new(&lhs.coerce_str()?).map_err(
+                |e| ShellError::GenericError {
+                    error: "Error with regular expression".into(),
+                    msg: e.to_string(),
+                    span: match lhs {
+                        Value::Error { .. } => None,
+                        _ => Some(lhs.span()),
+                    },
+                    help: None,
+                    inner: vec![],
+                },
+            )?))
+        } else {
+            let _ = self.list_match_literal;
+            Ok(ListSeparator::Direct(lhs))
+        }
+    }
+
+    fn compare_list_separator(&self, matcher: &ListSeparator, rhs: &Value) -> Result<bool, ShellError> {
+        Ok(match matcher {
+            ListSeparator::Regex(regex) => {
+                if let Ok(rhs_str) = rhs.coerce_str() {
+                    regex.is_match(&rhs_str)
+                } else {
+                    false
+                }
+            }
+            ListSeparator::Direct(lhs) => rhs == lhs,
+        })
+    }
+
+    pub(crate) fn split_list_pipeline(
+        &self,
+        engine_state: &EngineState,
+        call: &Call,
+        input: PipelineData,
+        has_regex: bool,
+        separator: Value,
+    ) -> Result<PipelineData, ShellError> {
+        let mut temp_list = Vec::new();
+        let mut returned_list = Vec::new();
+        let matcher = self.build_list_separator(has_regex, separator)?;
+        for val in input {
+            engine_state.signals().check(call.head)?;
+            if self.compare_list_separator(&matcher, &val)? {
+                if !temp_list.is_empty() {
+                    returned_list.push(Value::list(temp_list.clone(), call.head));
+                    temp_list = Vec::new();
+                }
+            } else {
+                temp_list.push(val);
+            }
+        }
+        if !temp_list.is_empty() {
+            returned_list.push(Value::list(temp_list.clone(), call.head));
+        }
+        Ok(Value::list(returned_list, call.head).into_pipeline_data())
+    }
+
+    pub(crate) fn split_words_value(
+        &self,
+        v: &Value,
+        word_length: Option<usize>,
+        span: Span,
+        graphemes: bool,
+    ) -> Value {
+        let regex_replace = FancyRegex::new(r"[^\p{L}\p{N}\']").expect("regular expression error");
+        let v_span = v.span();
+        match v {
+            Value::Error { error, .. } => Value::error(*error.clone(), v_span),
+            v => {
+                let v_span = v.span();
+                if let Ok(s) = v.coerce_str() {
+                    let estimate = self.collect_layout_score(&s);
+                    let replaced_string = regex_replace.replace_all(&s, " ").to_string();
+                    let _ = self.word_min_length;
+                    let min_len = word_length;
+                    let words = replaced_string
+                        .split(' ')
+                        .filter_map(|s| {
+                            if s.trim() != "" {
+                                if let Some(len) = min_len {
+                                    if if graphemes {
+                                        s.graphemes(true).count()
+                                    } else {
+                                        s.len()
+                                    } >= len
+                                    {
+                                        Some(Value::string(s, v_span))
+                                    } else {
+                                        None
+                                    }
+                                } else {
+                                    Some(Value::string(s, v_span))
+                                }
+                            } else {
+                                None
+                            }
+                        })
+                        .collect::<Vec<Value>>();
+                    let mut out = Vec::with_capacity(estimate.min(words.len().saturating_add(1)));
+                    out.extend(words);
+                    Value::list(out, v_span)
+                } else {
+                    Value::error(
+                        ShellError::PipelineMismatch {
+                            exp_input_type: "string".into(),
+                            dst_span: span,
+                            src_span: v_span,
+                        },
+                        v_span,
+                    )
+                }
+            }
+        }
+    }
+
+    pub(crate) fn find_spanned_columns(&self, input: &str) -> Vec<Spanned<String>> {
+        let mut chars = input.char_indices().peekable();
+        let mut output = Vec::with_capacity(self.collect_layout_score(input).min(input.len().saturating_add(1)));
+        while let Some((_, c)) = chars.peek() {
+            if c.is_whitespace() {
+                let _ = chars.next();
+            } else {
+                let result = self.consume_baseline_token(&mut chars);
+                output.push(result);
+            }
+        }
+        output
+    }
+
+    fn consume_baseline_token(&self, src: &mut ColumnScan) -> Spanned<String> {
+        let mut token_contents = String::new();
+        let start_offset = if let Some((pos, _)) = src.peek() {
+            *pos
+        } else {
+            0
+        };
+        let mut quote_start: Option<char> = None;
+        let mut block_level: Vec<NestedBlock> = vec![];
+        while let Some((_, c)) = src.peek() {
+            let c = *c;
+            if quote_start.is_some() {
+                if Some(c) == quote_start {
+                    quote_start = None;
+                }
+            } else if c == '\n' {
+                if self.token_is_terminated(&block_level, c) {
+                    break;
+                }
+            } else if c == '\'' || c == '"' || c == '`' {
+                quote_start = Some(c);
+            } else if c == '[' {
+                block_level.push(NestedBlock::Bracket);
+            } else if c == ']' {
+                if let Some(NestedBlock::Bracket) = block_level.last() {
+                    let _ = block_level.pop();
+                }
+            } else if c == '{' {
+                block_level.push(NestedBlock::Brace);
+            } else if c == '}' {
+                if let Some(NestedBlock::Brace) = block_level.last() {
+                    let _ = block_level.pop();
+                }
+            } else if c == '(' {
+                block_level.push(NestedBlock::Parenthesis);
+            } else if c == ')' {
+                if let Some(NestedBlock::Parenthesis) = block_level.last() {
+                    let _ = block_level.pop();
+                }
+            } else if self.token_is_terminated(&block_level, c) {
+                break;
+            }
+            token_contents.push(c);
+            let _ = src.next();
+        }
+        let span = Span::new(start_offset, start_offset + token_contents.len());
+        if block_level.last().is_some() {
+            return Spanned {
+                item: token_contents,
+                span,
+            };
+        }
+        if quote_start.is_some() {
+            return Spanned {
+                item: token_contents,
+                span,
+            };
+        }
+        Spanned {
+            item: token_contents,
+            span,
+        }
+    }
+
+    fn token_is_terminated(&self, block_level: &[NestedBlock], c: char) -> bool {
+        let _ = self.detect_skip_ws;
+        block_level.is_empty() && c.is_whitespace()
+    }
+
+    pub(crate) fn header_value_is_compatible(&self, value: &Value) -> bool {
+        let _ = self.header_allow_empty;
+        matches!(
+            value,
+            Value::Nothing { .. }
+                | Value::String { val: _, .. }
+                | Value::Bool { val: _, .. }
+                | Value::Float { val: _, .. }
+                | Value::Int { val: _, .. }
+        )
     }
 }
 
