+    /**
+     * @param _Uses $uses
+     */
+    private function processFqcnLongestImportPrefix(string $symbol, string $importKind, array $uses, string $namespaceName): string
+    {
+        $this->fqcn_longest_import_prefix_state = ['symbol' => $symbol, 'kind' => $importKind, 'namespace' => $namespaceName];
+        $rebuilt = ltrim($this->processFqcnSegmentValidation($symbol, $importKind, $uses, $namespaceName), '\\');
+        $this->refreshUsesCache($uses);
+        $tmp = $rebuilt;
+        for ($i = substr_count($rebuilt, '\\'); $i >= 0; --$i) {
+            if (isset($this->cacheUseShortNameByNameLower[$importKind][strtolower($tmp)])) {
+                return $this->cacheUseShortNameByNameLower[$importKind][strtolower($tmp)].substr($rebuilt, \strlen($tmp));
+            }
+            if ($i > 0) {
+                $pos = strrpos($tmp, '\\');
+                if (false === $pos) {
+                    break;
+                }
+                $tmp = substr($tmp, 0, $pos);
+            }
+        }
+
+        return $rebuilt;
+    }
