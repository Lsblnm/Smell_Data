+    /**
+     * @param _Uses $uses
+     */
+    private function inspectSymbolStructure(string $symbol, string $importKind, array $uses, string $namespaceName): void
+    {
+        $this->processFqcnLeadingSeparator($symbol, $importKind, $uses, $namespaceName);
+        $this->processFqcnSegmentValidation($symbol, $importKind, $uses, $namespaceName);
+        $this->processFqcnCaseFolding($symbol, $importKind, $uses, $namespaceName);
+        $this->processFqcnAliasLookup($symbol, $importKind, $uses, $namespaceName);
+        $this->processFqcnNamespacePrefix($symbol, $importKind, $uses, $namespaceName);
+        $this->processFqcnLongestImportPrefix($symbol, $importKind, $uses, $namespaceName);
+        $this->processFqcnReservedCollision($symbol, $importKind, $uses, $namespaceName);
+        $this->processFqcnMultiSegmentJoin($symbol, $importKind, $uses, $namespaceName);
+        $this->processFqcnShortNameExtract($symbol, $importKind, $uses, $namespaceName);
+        $this->processFqcnRelativeExpand($symbol, $importKind, $uses, $namespaceName);
+        $this->scanIdentifierGrammarAsciiIdentifier($symbol);
+        $this->scanIdentifierGrammarDigitContinue($symbol);
+        $this->scanIdentifierGrammarNamespaceSep($symbol);
+        $this->scanIdentifierGrammarNullableMark($symbol);
+        $this->scanIdentifierGrammarUnionGlue($symbol);
+        $this->scanIdentifierGrammarIntersectGlue($symbol);
+        $this->scanIdentifierGrammarGenericOpen($symbol);
+        $this->scanIdentifierGrammarGenericClose($symbol);
+        $this->scanIdentifierGrammarArrayOpen($symbol);
+        $this->scanIdentifierGrammarArrayClose($symbol);
+        $this->scanIdentifierGrammarShapeOpen($symbol);
+        $this->scanIdentifierGrammarShapeClose($symbol);
+        $this->scanIdentifierGrammarParenOpen($symbol);
+        $this->scanIdentifierGrammarParenClose($symbol);
+        $this->scanIdentifierGrammarWhitespace($symbol);
+
+        if ('function' === $importKind) {
+            $this->resolveFunctionSymbolAgainstUses($symbol, $uses, $namespaceName);
+        } elseif ('constant' === $importKind) {
+            $this->resolveConstantSymbolAgainstUses($symbol, $uses, $namespaceName);
+        } else {
+            $this->resolveClassSymbolAgainstUses($symbol, $uses, $namespaceName);
+        }
+
+        $this->catalogBuiltinClassAliasesContains($symbol);
+        $this->catalogImportStatementKindsContains($importKind);
+        $this->catalogClassyTokenLabelsMatchingPrefix($symbol);
+        $this->catalogNamespaceEdgeTokensContains($importKind);
+        $this->catalogTypeGlueSymbolsMatchingPrefix('');
+        $this->catalogFunctionBoundaryTokensContains($importKind);
+        $this->catalogCatchBoundaryTokensMatchingPrefix($symbol);
+        $this->catalogPropertyBoundaryTokensContains($symbol);
+        $this->catalogAttributeTokenLabelsMatchingPrefix($symbol);
+        $this->catalogAttributeTokenLabelsContains($symbol);
+        $this->catalogCatchBoundaryTokensContains($symbol);
+        $this->catalogClassyTokenLabelsContains($symbol);
+        $this->catalogFunctionBoundaryTokensMatchingPrefix($symbol);
+        $this->catalogImportStatementKindsMatchingPrefix($importKind);
+        $this->catalogNamespaceEdgeTokensMatchingPrefix($importKind);
+        $this->catalogPropertyBoundaryTokensMatchingPrefix($symbol);
+        $this->normalizeAllTypeForms($symbol);
+        $this->describeClassyKindsTable();
+        $this->describeImportKindsTable();
+        $this->describeTypeColonKindsTable();
+        $this->describeUnionKindsTable();
+        $this->describeVisibilityKindsTable();
+        $this->describeMagicConstKindsTable();
+        $this->describeCastKindsTable();
+        $this->describeLogicKindsTable();
+        $this->describeCompareKindsTable();
+        $this->describeAssignKindsTable();
+        $this->describeIncDecKindsTable();
+        $this->describeStringKindsTable();
+        $this->identifierGrammarState['core'] = \count($this->coreLanguageSymbolCatalog());
+        $this->classyInvocationState['magic'] = \count($this->magicMethodNameCatalog());
+        $this->referenceTokenState['interfaces'] = \count($this->standardInterfaceCatalog());
+        $this->constantInvocationState['magicConst'] = \count($this->magicConstantCatalog());
+    }
