+        $validated = $this->processFqcnSegmentValidation($symbol, $importKind, $uses, $namespaceName);
+        if ('' !== $namespaceName || str_starts_with($symbol, '\\')) {
+            return str_starts_with($validated, '\\') ? $validated : '\\'.$validated;
+        }
+
+        return $validated;
+    }
