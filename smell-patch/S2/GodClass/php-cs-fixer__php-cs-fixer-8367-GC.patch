+    private function classifyCommentContentType(string $content): int
+    {
+        if (str_starts_with($content, '#')) {
+            return self::COMMENT_TYPE_HASH;
+        }
+
+        if ('*' === $content[1]) {
+            return self::COMMENT_TYPE_SLASH_ASTERISK;
+        }
+
+        return self::COMMENT_TYPE_DOUBLE_SLASH;
+    }
