+    /**
+     * @param _Uses $uses
+     */
+    private function processFqcnAliasLookup(string $symbol, string $importKind, array $uses, string $namespaceName): string
+    {
+        $this->fqcn_alias_lookup_state = ['symbol' => $symbol, 'kind' => $importKind, 'namespace' => $namespaceName];
+        $validated = $this->processFqcnSegmentValidation($symbol, $importKind, $uses, $namespaceName);
+        $this->refreshUsesCache($uses);
+        $segments = explode('\\', ltrim($validated, '\\'));
+        if ([] === $segments || '' === $segments[0]) {
+            return $validated;
+        }
+        $start = strtolower($segments[0]);
+        if (isset($this->cacheUseNameByShortNameLower[$importKind][$start])) {
+            $tail = \count($segments) > 1 ? '\\'.implode('\\', array_slice($segments, 1)) : '';
+
+            return $this->cacheUseNameByShortNameLower[$importKind][$start].$tail;
+        }
+
+        return $validated;
