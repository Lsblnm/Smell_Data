+    private function phpDocTypeHasBalancedDelimiters(string $type): bool
+    {
+        $depth = 0;
+        $length = \strlen($type);
+        for ($i = 0; $i < $length; ++$i) {
+            $ch = $type[$i];
+            if ('<' === $ch || '{' === $ch || '(' === $ch) {
+                ++$depth;
+            } elseif ('>' === $ch || '}' === $ch || ')' === $ch) {
+                --$depth;
+                if ($depth < 0) {
+                    return false;
+                }
+            }
+        }
+
+        return 0 === $depth;
+    }
+
