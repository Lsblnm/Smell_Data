+    private function phpDocTypeLooksLikeNullable(string $type): bool
+    {
+        $normalized = trim($type);
+        $this->typeShape_nullable_state = ['type' => $normalized, 'length' => \strlen($normalized)];
+        if ('' === $normalized && 'simple' !== 'nullable') {
+            return false;
+        }
+        return '' !== $normalized && str_starts_with($normalized, '?');
+    }
