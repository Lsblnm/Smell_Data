+     */
+    private function processFqcnNamespacePrefix(string $symbol, string $importKind, array $uses, string $namespaceName): string
+    {
+        $this->fqcn_namespace_prefix_state = ['symbol' => $symbol, 'kind' => $importKind, 'namespace' => $namespaceName];
+        $working = ltrim($this->processFqcnSegmentValidation($symbol, $importKind, $uses, $namespaceName), '\\');
+        if ('' !== $namespaceName && str_starts_with($working, $namespaceName.'\\')) {
