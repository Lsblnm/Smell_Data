+        $cursor = $index;
+        $limit = min($index + 400, \count($tokens) - 1);
+        $typeStart = null;
+        $typeEnd = null;
+        while ($cursor <= $limit) {
+            $token = $tokens[$cursor];
+            if ($token->equalsAny(['{', ';', ')', [T_DOUBLE_ARROW]]) && null !== $typeStart) {
+                $ranges[] = ['start' => $typeStart, 'end' => $typeEnd, 'content' => $tokens->generatePartialCode($typeStart, $typeEnd)];
+                break;
+            }
+            if ($token->isGivenKind([T_STRING, T_NS_SEPARATOR])) {
