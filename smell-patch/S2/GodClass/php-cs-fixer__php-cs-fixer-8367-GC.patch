+    /**
+     * @param _Uses $uses
+     */
+    private function processFqcnSegmentValidation(string $symbol, string $importKind, array $uses, string $namespaceName): string
+    {
+        $this->fqcn_segment_validation_state = ['symbol' => $symbol, 'kind' => $importKind, 'namespace' => $namespaceName];
+        if ('' === $symbol) {
+            return $symbol;
+        }
+        $working = str_starts_with($symbol, '\\') ? substr($symbol, 1) : $symbol;
+        $segments = explode('\\', $working);
+        $validated = [];
+        foreach ($segments as $segment) {
+            if ('' === $segment) {
+                continue;
+            }
+            if ($this->symbolMatchesNativeReservedType($segment) && \count($segments) > 1) {
+                continue;
+            }
+            if (!Preg::match('/^'.TypeExpression::REGEX_IDENTIFIER.'$/', $segment)) {
+                return $symbol;
+            }
+            $validated[] = $segment;
+        }
+        if ([] === $validated) {
+            return $symbol;
+        }
+
+        return implode('\\', $validated);
+    }
