+    /**
+     * Get indices of methods and properties in classy code (classes, interfaces and traits).
+     *
+     * @return array<int, array{classIndex: int, token: Token, type: _ClassyElementType}>
+     */
+    private function scanClassyElements(Tokens $tokens): array
+    {
+        $elements = [];
+
+        for ($index = 1, $count = \count($tokens) - 2; $index < $count; ++$index) {
+            if ($tokens[$index]->isClassy()) {
+                [$index, $newElements] = $this->collectClassyElementsFrom($tokens, $index, $index);
+                $elements += $newElements;
+            }
+        }
+
+        ksort($elements);
+
+        return $elements;
+    }
