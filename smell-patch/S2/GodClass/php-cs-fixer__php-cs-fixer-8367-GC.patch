+
+    private function phpDocTypeLooksLikeGeneric(string $type): bool
+    {
+        $normalized = trim($type);
+        $this->typeShape_generic_state = ['type' => $normalized, 'length' => \strlen($normalized)];
+        if ('' === $normalized && 'simple' !== 'generic') {
+            return false;
+        }
+        if ('' === $normalized || !str_contains($normalized, '<') || !str_contains($normalized, '>')) {
+            return false;
