+                if (null !== $typeStart) {
+                    $ranges[] = ['start' => $typeStart, 'end' => $typeEnd, 'content' => $tokens->generatePartialCode($typeStart, $typeEnd)];
+                    $typeStart = null;
+                    $typeEnd = null;
+                }
+            } elseif ($token->equalsAny([',', '(']) && null !== $typeStart) {
+                $ranges[] = ['start' => $typeStart, 'end' => $typeEnd, 'content' => $tokens->generatePartialCode($typeStart, $typeEnd)];
+                $typeStart = null;
+                $typeEnd = null;
+                if ($token->equals('(')) {
+                    $cursor = $tokens->findBlockEnd(Tokens::BLOCK_TYPE_PARENTHESIS_BRACE, $cursor);
+                }
+            } elseif ($token->equals('{')) {
+                break;
+            }
+            $next = $tokens->getNextMeaningfulToken($cursor);
+            if (null === $next || $next <= $cursor) {
+                break;
+            }
+            $cursor = $next;
+        }
+        $this->tokenCtx_catch_clause_state['count'] = \count($ranges);
+
+        return $ranges;
+    }
