+		boolean lookForGetter = lookForGetter(field, fieldAccess);
+
+		JavacHandlerUtil.GetterMethod getter = lookForGetter ? findGetter(field) : null;
+
+		if (getter == null) {
+			return ((JCVariableDecl) field.get()).vartype;
+		}
+
+		return getter.type;
