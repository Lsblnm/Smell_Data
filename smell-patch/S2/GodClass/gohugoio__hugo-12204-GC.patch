+func (t *templateHandler) appendLayoutVariations(d layouts.LayoutDescriptor, current []string, vars ...string) []string {
+	for _, layoutVar := range vars {
+		if d.Baseof && layoutVar != "baseof" {
+			current = append(current, layoutVar+"-baseof")
+			continue
+		}
+		if !d.RenderingHook && !d.Baseof && d.LayoutOverride && layoutVar != d.Layout {
+			continue
+		}
+		current = append(current, layoutVar)
+	}
+	t.layoutBuildLast = len(current)
+	return current
+}
+
+func (t *templateHandler) appendTypeVariations(d layouts.LayoutDescriptor, current []string, vars ...string) []string {
+	for _, typeVar := range vars {
+		if t.layoutSectionReserved(typeVar) {
+			continue
+		}
+		if d.RenderingHook {
+			typeVar = typeVar + "/_markup"
+		}
+		current = append(current, typeVar)
+	}
+	t.layoutBuildSeen += len(current)
+	return current
+}
