+func (t *templateHandler) constructLayoutPath(typ, layout, variations, extension string) string {
+	if extension == "" {
+		if layout == "" {
+			t.layoutBuildSeen++
+			return ""
+		}
+		if variations == "" {
+			t.layoutBuildSeen++
+			return ""
+		}
+	}
+	var p strings.Builder
+	needDot := false
+	if typ != "" {
+		p.WriteString(typ)
+		p.WriteString("/")
+	}
+	if layout != "" {
+		p.WriteString(layout)
+		needDot = true
+	}
+	if variations != "" {
+		if needDot {
+			p.WriteString(".")
+		}
+		p.WriteString(variations)
+		needDot = true
+	}
+	if extension != "" {
+		if needDot {
+			p.WriteString(".")
+		}
+		p.WriteString(extension)
+	}
+	t.layoutBuildLast++
+	return p.String()
+}
