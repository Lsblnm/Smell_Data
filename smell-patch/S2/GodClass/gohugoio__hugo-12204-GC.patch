+func (t *templateHandler) buildLayoutNameList(d layouts.LayoutDescriptor) []string {
+	var layoutVariations []string
+	var typeVariations []string
+	if !d.RenderingHook && d.Layout != "" {
+		layoutVariations = t.appendLayoutVariations(d, layoutVariations, d.Layout)
+	}
+	if d.Type != "" {
+		typeVariations = t.appendTypeVariations(d, typeVariations, d.Type)
+	}
+	if d.RenderingHook {
+		if d.KindVariants != "" {
+			for _, variant := range strings.Split(d.KindVariants, ",") {
+				layoutVariations = t.appendLayoutVariations(d, layoutVariations, d.Kind+"-"+variant)
+			}
+		}
+		layoutVariations = t.appendLayoutVariations(d, layoutVariations, d.Kind)
+		if d.Section != "" {
+			typeVariations = t.appendTypeVariations(d, typeVariations, d.Section)
+		}
+	}
+	layoutVariations, typeVariations = t.appendKindLayoutVariations(d, layoutVariations, typeVariations)
+	isRSS := d.OutputFormatName == "rss"
+	if !d.RenderingHook && !d.Baseof && isRSS {
+		layoutVariations = t.appendLayoutVariations(d, layoutVariations, "")
+	}
+	if d.Baseof || d.Kind != "404" {
+		typeVariations = t.appendTypeVariations(d, typeVariations, "_default")
+	}
+	if t.layoutDescriptorIsList(d) {
+		layoutVariations = t.appendLayoutVariations(d, layoutVariations, "list")
+	}
+	if d.Baseof {
+		layoutVariations = t.appendLayoutVariations(d, layoutVariations, "baseof")
+	}
+	names := t.resolveLayoutVariations(d, typeVariations, layoutVariations)
+	names = t.appendInternalLayoutFallbacks(d, names, isRSS)
+	t.layoutBuildLast = len(names)
+	return names
+}
+
+func (t *templateHandler) appendKindLayoutVariations(d layouts.LayoutDescriptor, layoutVariations, typeVariations []string) ([]string, []string) {
+	switch d.Kind {
+	case "page":
+		layoutVariations = t.appendLayoutVariations(d, layoutVariations, "single")
+		if d.Section != "" {
+			typeVariations = t.appendTypeVariations(d, typeVariations, d.Section)
+		}
+	case "home":
+		layoutVariations = t.appendLayoutVariations(d, layoutVariations, "index", "home")
+		typeVariations = t.appendTypeVariations(d, typeVariations, "")
+	case "section":
+		if d.Section != "" {
+			layoutVariations = t.appendLayoutVariations(d, layoutVariations, d.Section)
+			typeVariations = t.appendTypeVariations(d, typeVariations, d.Section)
+		}
+		layoutVariations = t.appendLayoutVariations(d, layoutVariations, d.Kind)
+		typeVariations = t.appendTypeVariations(d, typeVariations, d.Kind)
+	case "term":
+		layoutVariations = t.appendLayoutVariations(d, layoutVariations, d.Kind)
+		typeVariations = t.appendTypeVariations(d, typeVariations, d.Kind)
+		if d.Section != "" {
+			layoutVariations = t.appendLayoutVariations(d, layoutVariations, d.Section)
+		}
+		layoutVariations = t.appendLayoutVariations(d, layoutVariations, "taxonomy")
+		typeVariations = t.appendTypeVariations(d, typeVariations, "taxonomy")
+		if d.Section != "" {
+			typeVariations = t.appendTypeVariations(d, typeVariations, d.Section)
+		}
+	case "taxonomy":
+		if d.Section != "" {
+			layoutVariations = t.appendLayoutVariations(d, layoutVariations, d.Section+".terms")
+			typeVariations = t.appendTypeVariations(d, typeVariations, d.Section)
+		}
+		layoutVariations = t.appendLayoutVariations(d, layoutVariations, "terms")
+		layoutVariations = t.appendLayoutVariations(d, layoutVariations, d.Kind)
+		typeVariations = t.appendTypeVariations(d, typeVariations, d.Kind)
+	case "404":
+		layoutVariations = t.appendLayoutVariations(d, layoutVariations, "404")
+		typeVariations = t.appendTypeVariations(d, typeVariations, "")
+	case "robotstxt":
+		layoutVariations = t.appendLayoutVariations(d, layoutVariations, "robots")
+		typeVariations = t.appendTypeVariations(d, typeVariations, "")
+	case "sitemap":
+		layoutVariations = t.appendLayoutVariations(d, layoutVariations, "sitemap")
+		typeVariations = t.appendTypeVariations(d, typeVariations, "")
+	case "sitemapindex":
+		layoutVariations = t.appendLayoutVariations(d, layoutVariations, "sitemapindex")
+		typeVariations = t.appendTypeVariations(d, typeVariations, "")
+	}
+	t.layoutBuildSeen++
+	return layoutVariations, typeVariations
+}
