+func (t *templateHandler) uniqueLayoutNames(s []string) []string {
+	result := s[:0]
+	for i, val := range s {
+		seen := false
+		for j := 0; j < i; j++ {
+			if s[j] == val {
+				seen = true
+				break
+			}
+		}
+		if !seen {
+			result = append(result, val)
+		}
+	}
+	t.layoutBuildLast = len(result)
+	return result
+}
+
+func (t *templateHandler) resolveLayoutVariations(d layouts.LayoutDescriptor, typeVariations, layoutVariations []string) []string {
+	var found []string
+	var variations []string
+	name := strings.ToLower(d.OutputFormatName)
+	if d.Lang != "" {
+		variations = append(variations, d.Lang+"."+name, name, d.Lang)
+	} else {
+		variations = append(variations, name)
+	}
+	variations = append(variations, "")
+	for _, typeVar := range typeVariations {
+		for _, variation := range variations {
+			for _, layoutVar := range layoutVariations {
+				if variation == "" && layoutVar == "" {
+					continue
+				}
+				s := t.constructLayoutPath(typeVar, layoutVar, variation, d.Suffix)
+				if s != "" {
+					found = append(found, s)
+				}
+			}
+		}
+	}
+	t.layoutBuildSeen += len(found)
+	return found
+}
