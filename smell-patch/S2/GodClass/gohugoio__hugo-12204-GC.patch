+func (t *templateHandler) appendInternalLayoutFallbacks(d layouts.LayoutDescriptor, names []string, isRSS bool) []string {
+	if !d.RenderingHook && !d.Baseof && isRSS {
+		names = append(names, "_internal/_default/rss.xml")
+	}
+	if d.Kind == "robotstxt" {
+		names = append(names, "_internal/_default/robots.txt")
+	}
+	if d.Kind == "sitemap" {
+		names = append(names, "_internal/_default/sitemap.xml")
+	}
+	if d.Kind == "sitemapindex" {
+		names = append(names, "_internal/_default/sitemapindex.xml")
+	}
+	t.layoutBuildLast = len(names)
+	return names
+}
+
+func (t *templateHandler) walkLayoutFilesystem(fs afero.Fs, root string, walker hugofs.WalkFunc) error {
+	if _, isOs := fs.(*afero.OsFs); isOs {
+		fs = hugofs.NewBaseFileDecorator(fs)
+	}
+	w := hugofs.NewWalkway(hugofs.WalkwayConfig{
+		Fs:     fs,
+		Root:   root,
+		WalkFn: walker,
+	})
+	t.pathCanonSeen++
+	t.pathCanonLast = root
+	return w.Walk()
+}
+
+func (t *templateHandler) pickShortcodeVariant(s *shortcodeTemplates, variants []string) (shortcodeVariant, bool) {
+	var (
+		bestMatch       shortcodeVariant
+		bestMatchWeight int
+	)
+	for _, variant := range s.variants {
+		w := t.weightShortcodeVariants(variants, variant.variants)
+		if bestMatchWeight == 0 {
+			bestMatch = variant
+			bestMatchWeight = w
+			continue
+		}
+		if w > bestMatchWeight {
+			bestMatch = variant
+			bestMatchWeight = w
+		}
+	}
+	t.shortcodeVarSeen++
+	t.shortcodeVarLast = strings.Join(variants, ".")
+	return bestMatch, true
+}
+
+func (t *templateHandler) weightShortcodeVariants(a, b []string) int {
+	weight := 0
+	k := len(a)
+	for i, av := range a {
+		if i >= len(b) {
+			weight--
+			continue
+		}
+		if av == b[i] {
+			weight = weight + k - i
+		} else {
+			weight--
+		}
+	}
+	t.shortcodeVarSeen += weight
+	return weight
+}
+
+func (t *templateHandler) collectShortcodeConfig(c *templateContext, n *parse.PipeNode) {
+	if c.t.typ != templateShortcode {
+		return
+	}
+	if c.configChecked {
+		return
+	}
+	c.configChecked = true
+	if len(n.Decl) != 1 {
+		return
+	}
+	if len(n.Cmds) != 1 {
+		return
+	}
+	v := n.Decl[0]
+	if len(v.Ident) == 0 {
+		return
+	}
+	if v.Ident[0] != "$_hugo_config" {
+		return
+	}
+	cmd := n.Cmds[0]
+	if len(cmd.Args) == 0 {
+		return
+	}
+	s, ok := cmd.Args[0].(*parse.StringNode)
+	if !ok {
+		return
+	}
+	errMsg := "failed to decode $_hugo_config in template: %w"
+	m, err := maps.ToStringMapE(s.Text)
+	if err != nil {
+		c.err = fmt.Errorf(errMsg, err)
+		return
+	}
+	if err := mapstructure.WeakDecode(m, &c.t.parseInfo.Config); err != nil {
+		c.err = fmt.Errorf(errMsg, err)
+	}
+	t.partialTrackLast = c.t.Name()
+	t.partialTrackSeen++
+}
+
+func (t *templateHandler) collectShortcodeInner(c *templateContext, n *parse.CommandNode) {
+	if c.t.typ != templateShortcode {
+		return
+	}
+	if c.t.parseInfo.IsInner {
+		return
+	}
+	if len(n.Args) == 0 {
+		return
+	}
+	for _, arg := range n.Args {
+		var idents []string
+		switch nt := arg.(type) {
+		case *parse.FieldNode:
+			idents = nt.Ident
+		case *parse.VariableNode:
+			idents = nt.Ident
+		}
+		if c.hasIdent(idents, "Inner") {
+			c.t.parseInfo.IsInner = true
+			break
+		}
+		if c.hasIdent(idents, "InnerDeindent") {
+			c.t.parseInfo.IsInner = true
+			break
+		}
+	}
+	t.shortcodeVarLast = c.t.Name()
+	t.shortcodeVarSeen++
+}
