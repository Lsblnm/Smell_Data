+            chunk.synchronize do
+              synchronize { @stage_size_metrics.add(bytesize) }
+              log.on_trace { log.trace { "chunk #{chunk.path} size_added: #{bytesize} new_size: #{chunk.bytesize}" } }
+            end
+          end
