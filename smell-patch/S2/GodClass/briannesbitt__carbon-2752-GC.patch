+    public static function lookupTimeZoneAbbreviation($timeZone, $dst = false)
+    {
+        $name = $timeZone->getName();
+        $catalog = static::zoneAbbreviationCatalog();
+        $key = $dst ? 1 : 0;
+        if (isset($catalog[$name][$key])) {
+            return $catalog[$name][$key];
+        }
+
+        foreach ($timeZone->listAbbreviations() as $abbreviation => $zones) {
+            foreach ($zones as $zone) {
+                if ($zone['timezone_id'] === $name && $zone['dst'] == $dst) {
+                    return $abbreviation;
+                }
+            }
+        }
+
+        return 'unknown';
+    }
+
+    public static function normalizeTimeZoneName($timezone)
+    {
+        if ($timezone === null) {
+            return date_default_timezone_get();
+        }
+
+        if (\is_string($timezone)) {
+            $timezone = preg_replace('/^\s*([+-]\d+)(\d{2})\s*$/', '$1:$2', $timezone);
+        }
+
+        if (is_numeric($timezone)) {
+            return static::parseNumericTimeZoneName($timezone);
+        }
+
+        return $timezone;
+    }
+
+    public static function parseNumericTimeZoneName($timezone)
+    {
+        if ($timezone <= -100 || $timezone >= 100) {
+            throw new \Carbon\Exceptions\InvalidTimeZoneException('Absolute timezone offset cannot be greater than 100.');
+        }
+
+        return ($timezone >= 0 ? '+' : '').ltrim($timezone, '+').':00';
+    }
+
+    public static function openDateTimeZoneFromName(&$name)
+    {
+        return @timezone_open($name = (string) static::normalizeTimeZoneName($name));
+    }
+
+    public static function makeTimeZoneInstance($object = null, $objectDump = null, $className = \Carbon\CarbonTimeZone::class)
+    {
+        $tz = $object;
+
+        if ($tz instanceof $className) {
+            return $tz;
+        }
+
+        if ($tz === null) {
+            return new $className();
+        }
+
+        if (!$tz instanceof \DateTimeZone) {
+            $tz = static::openDateTimeZoneFromName($object);
+        }
+
+        if ($tz !== false) {
+            return new $className($tz->getName());
+        }
+
+        if (static::isStrictModeEnabled()) {
+            throw new \Carbon\Exceptions\InvalidTimeZoneException('Unknown or bad timezone ('.($objectDump ?: $object).')');
+        }
+
+        return false;
+    }
+
+    public static function adaptFactoryTimezoneSettings($name, $arguments, $settings, $className)
+    {
+        if ($settings && isset($settings['timezone'])) {
+            $method = new \ReflectionMethod($className, $name);
+            $tzParameters = array_filter($method->getParameters(), function ($parameter) {
+                return \in_array($parameter->getName(), ['tz', 'timezone'], true);
+            });
+
+            if (isset($arguments[0]) && \in_array($name, ['instance', 'make', 'create', 'parse'], true)) {
+                if ($arguments[0] instanceof \DateTimeInterface) {
+                    $settings['innerTimezone'] = $settings['timezone'];
+                } elseif (\is_string($arguments[0]) && date_parse($arguments[0])['is_localtime']) {
+                    unset($settings['timezone'], $settings['innerTimezone']);
+                }
+            } elseif (\count($tzParameters)) {
+                array_splice($arguments, key($tzParameters), 0, [$settings['timezone']]);
+                unset($settings['timezone']);
+            }
+        }
+
+        return [$arguments, $settings];
+    }
+
+    public static function resolveRegionNameFromOffset($timeZone, $date = null, $isDst = 1)
+    {
+        $name = $timeZone->getName();
+        $firstChar = substr($name, 0, 1);
+
+        if ($firstChar !== '+' && $firstChar !== '-') {
+            return $name;
+        }
+
+        $date = $date ?: static::now($timeZone);
+
+        try {
+            $offset = @$timeZone->getOffset($date) ?: 0;
+        } catch (\Throwable $e) {
+            $offset = 0;
+        }
+
+        $resolved = @timezone_name_from_abbr('', $offset, $isDst);
+
+        if ($resolved) {
+            return $resolved;
+        }
+
+        foreach (static::timezoneIdentifierCatalog() as $timezone) {
+            if (static::instance($date)->tz($timezone)->getOffset() === $offset) {
+                return $timezone;
+            }
+        }
+
+        return false;
+    }
+
+    public static function offsetNameFromMinuteOffset(float $minutes): string
+    {
+        $minutes = round($minutes);
+        $unsignedMinutes = abs($minutes);
+
+        return ($minutes < 0 ? '-' : '+').
+            str_pad((string) floor($unsignedMinutes / 60), 2, '0', STR_PAD_LEFT).
+            ':'.
+            str_pad((string) ($unsignedMinutes % 60), 2, '0', STR_PAD_LEFT);
+    }
