+    pub fn named_file_input<'a>(file: &'a Path, name: Option<&'a Path>) -> Input<'a> {
+        Self::with_input_name(Input::ordinary_file(file), name.or(Some(file)))
+    }
+
+    pub fn named_stdin_input(name: Option<&Path>) -> Input {
+        Self::with_input_name(Input::stdin(), name)
+    }
+
+    fn with_input_name<'a>(input: Input<'a>, name: Option<&Path>) -> Input<'a> {
+        if let Some(provided_name) = name {
+            let mut input = input.with_name(Some(provided_name));
+            input.description_mut().set_kind(Some("File".to_owned()));
+            input
+        } else {
+            input
+        }
+    }
