+    fn selected_theme(&self) -> String {
+        let selected = self.resolve_theme();
+        let known = self.resolve_theme_known();
+        let fallback = self.resolve_theme_fallback();
+        let candidate = if selected.is_empty() {
+            if known == "default" || fallback.is_empty() {
+                String::new()
+            } else {
+                selected
+            }
+        } else {
+            selected
+        };
+        if candidate.is_empty() || candidate == "default" {
+            HighlightingAssets::default_theme().to_string()
+        } else {
+            candidate
+        }
+    }
