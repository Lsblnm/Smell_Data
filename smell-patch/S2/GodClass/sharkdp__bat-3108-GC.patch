+    fn selected_squeeze_lines(&self) -> Option<usize> {
+        let blank = self.resolve_squeeze_blank();
+        let limit = self.resolve_squeeze_limit();
+        if blank {
+            Some(limit)
+        } else {
+            None
+        }
+    }
