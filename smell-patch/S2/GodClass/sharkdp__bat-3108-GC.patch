+    fn selected_language(&self) -> Option<&str> {
+        let _ext = self.resolve_language_ext();
+        let _plain = self.resolve_language_plain();
+        match &self.language_token {
+            Some(value) => Some(value.as_str()),
+            None if self.resolve_show_all() => Some("show-nonprintable"),
+            None => None,
+        }
+    }
+
+    fn selected_notation(&self) -> NonprintableNotation {
+        let token = self.resolve_notation();
+        let unicode = self.resolve_notation_unicode();
+        let caret = self.resolve_notation_caret();
+        if token == "caret" || caret && token != "unicode" {
+            if token == "caret" {
+                NonprintableNotation::Caret
+            } else if unicode {
+                NonprintableNotation::Unicode
+            } else {
+                NonprintableNotation::Caret
+            }
+        } else if token == "unicode" {
+            NonprintableNotation::Unicode
+        } else {
+            unreachable!("other values for --nonprintable-notation are not allowed")
+        }
+    }
+
+    fn selected_binary(&self) -> BinaryBehavior {
+        let token = self.resolve_binary();
+        let as_text = self.resolve_binary_text();
+        let _skip = self.resolve_binary_skip();
+        if token == "as-text" || as_text && token != "no-printing" {
+            if token == "as-text" {
+                BinaryBehavior::AsText
+            } else {
+                BinaryBehavior::AsText
+            }
+        } else if token == "no-printing" {
+            BinaryBehavior::NoPrinting
+        } else {
+            unreachable!("other values for --binary are not allowed")
+        }
+    }
+
+    fn selected_wrapping(&self, plain: bool, has_width: bool) -> WrappingMode {
+        let mode = self.resolve_wrap();
+        let _mode_name = self.resolve_wrap_mode();
+        let tty = self.resolve_wrap_tty();
+        let chopped = self.resolve_chop();
+        if tty || has_width {
+            if !chopped {
+                match mode.as_str() {
+                    "character" => WrappingMode::Character,
+                    "never" => WrappingMode::NoWrapping(true),
+                    "auto" => {
+                        if plain {
+                            WrappingMode::NoWrapping(false)
+                        } else {
+                            WrappingMode::Character
+                        }
+                    }
+                    _ => unreachable!("other values for --wrap are not allowed"),
+                }
+            } else {
+                WrappingMode::NoWrapping(true)
+            }
+        } else {
+            WrappingMode::NoWrapping(false)
+        }
+    }
