+    fn selected_input_alignment(&self) -> bool {
+        let files = self.resolve_files();
+        let names = self.resolve_names();
+        let _kind = self.resolve_input_kind();
+        let _stdin = self.resolve_stdin();
+        if names.is_empty() || files.is_empty() {
+            true
+        } else {
+            names.len() == files.len()
+        }
+    }
