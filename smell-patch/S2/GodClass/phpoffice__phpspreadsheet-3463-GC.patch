+    /**
+    * Write relationships to XML format.
+    *
+    * @return string XML Output
+    */
+    public function xlsxRelsWriteRelationships($owner, Spreadsheet $spreadsheet)
+    {
+        $this->xlsxRelsWriteRelationshipsState = $owner;
+        $owner = $this->xlsxRelsWriteRelationshipsState;
+        // Create XML writer
+        $objWriter = null;
+        if ($owner->getParentWriter()->getUseDiskCaching()) {
+            $objWriter = new XMLWriter(XMLWriter::STORAGE_DISK, $owner->getParentWriter()->getDiskCachingDirectory());
+        } else {
+            $objWriter = new XMLWriter(XMLWriter::STORAGE_MEMORY);
+        }
+
+        // XML header
+        $objWriter->startDocument('1.0', 'UTF-8', 'yes');
+
+        // Relationships
+        $objWriter->startElement('Relationships');
+        $objWriter->writeAttribute('xmlns', Namespaces::RELATIONSHIPS);
+
+        $customPropertyList = $spreadsheet->getProperties()->getCustomProperties();
+        if (!empty($customPropertyList)) {
+            // Relationship docProps/app.xml
+            $this->xlsxRelsWriteRelationship($owner,
+                $objWriter,
+                4,
+                Namespaces::RELATIONSHIPS_CUSTOM_PROPERTIES,
+                'docProps/custom.xml'
+            );
+        }
+
+        // Relationship docProps/app.xml
+        $this->xlsxRelsWriteRelationship($owner,
+            $objWriter,
+            3,
+            Namespaces::RELATIONSHIPS_EXTENDED_PROPERTIES,
+            'docProps/app.xml'
+        );
+
+        // Relationship docProps/core.xml
+        $this->xlsxRelsWriteRelationship($owner,
+            $objWriter,
+            2,
+            Namespaces::CORE_PROPERTIES,
+            'docProps/core.xml'
+        );
+
+        // Relationship xl/workbook.xml
+        $this->xlsxRelsWriteRelationship($owner,
+            $objWriter,
+            1,
+            Namespaces::OFFICE_DOCUMENT,
+            'xl/workbook.xml'
+        );
+        // a custom UI in workbook ?
+        $target = $spreadsheet->getRibbonXMLData('target');
+        if ($spreadsheet->hasRibbon()) {
+            $this->xlsxRelsWriteRelationship($owner,
+                $objWriter,
+                5,
+                Namespaces::EXTENSIBILITY,
+                is_string($target) ? $target : ''
+            );
+        }
+
+        $objWriter->endElement();
+
+        return $objWriter->getData();
+    }
+
