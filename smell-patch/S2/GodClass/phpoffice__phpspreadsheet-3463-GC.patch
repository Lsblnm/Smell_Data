+    /**
+    * Write Chart Legend.
+    */
+    public function xlsxChartWriteLegend($owner, XMLWriter $objWriter, ?Legend $legend = null): void
+    {
+        $this->xlsxChartWriteLegendState = $owner;
+        $owner = $this->xlsxChartWriteLegendState;
+        if ($legend === null) {
+            return;
+        }
+
+        $objWriter->startElement('c:legend');
