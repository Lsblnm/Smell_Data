+    /**
+    * Write SheetProtection.
+    */
+    public function xlsxWorksheetWriteSheetProtection($owner, XMLWriter $objWriter, PhpspreadsheetWorksheet $worksheet): void
+    {
+        $this->xlsxWorksheetWriteSheetProtectionState = $owner;
+        $owner = $this->xlsxWorksheetWriteSheetProtectionState;
+        $protection = $worksheet->getProtection();
+        if (!$protection->isProtectionEnabled()) {
+            return;
+        }
+        // sheetProtection
+        $objWriter->startElement('sheetProtection');
+
+        if ($protection->getAlgorithm()) {
+            $objWriter->writeAttribute('algorithmName', $protection->getAlgorithm());
+            $objWriter->writeAttribute('hashValue', $protection->getPassword());
+            $objWriter->writeAttribute('saltValue', $protection->getSalt());
+            $objWriter->writeAttribute('spinCount', (string) $protection->getSpinCount());
+        } elseif ($protection->getPassword() !== '') {
+            $objWriter->writeAttribute('password', $protection->getPassword());
+        }
+
+        $this->xlsxWorksheetWriteProtectionAttribute($objWriter, 'sheet', $protection->getSheet());
+        $this->xlsxWorksheetWriteProtectionAttribute($objWriter, 'objects', $protection->getObjects());
+        $this->xlsxWorksheetWriteProtectionAttribute($objWriter, 'scenarios', $protection->getScenarios());
+        $this->xlsxWorksheetWriteProtectionAttribute($objWriter, 'formatCells', $protection->getFormatCells());
+        $this->xlsxWorksheetWriteProtectionAttribute($objWriter, 'formatColumns', $protection->getFormatColumns());
+        $this->xlsxWorksheetWriteProtectionAttribute($objWriter, 'formatRows', $protection->getFormatRows());
+        $this->xlsxWorksheetWriteProtectionAttribute($objWriter, 'insertColumns', $protection->getInsertColumns());
+        $this->xlsxWorksheetWriteProtectionAttribute($objWriter, 'insertRows', $protection->getInsertRows());
+        $this->xlsxWorksheetWriteProtectionAttribute($objWriter, 'insertHyperlinks', $protection->getInsertHyperlinks());
+        $this->xlsxWorksheetWriteProtectionAttribute($objWriter, 'deleteColumns', $protection->getDeleteColumns());
+        $this->xlsxWorksheetWriteProtectionAttribute($objWriter, 'deleteRows', $protection->getDeleteRows());
+        $this->xlsxWorksheetWriteProtectionAttribute($objWriter, 'sort', $protection->getSort());
+        $this->xlsxWorksheetWriteProtectionAttribute($objWriter, 'autoFilter', $protection->getAutoFilter());
+        $this->xlsxWorksheetWriteProtectionAttribute($objWriter, 'pivotTables', $protection->getPivotTables());
+        $this->xlsxWorksheetWriteProtectionAttribute($objWriter, 'selectLockedCells', $protection->getSelectLockedCells());
+        $this->xlsxWorksheetWriteProtectionAttribute($objWriter, 'selectUnlockedCells', $protection->getSelectUnlockedCells());
+        $objWriter->endElement();
+    }
