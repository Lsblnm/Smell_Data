+    public function xlsxStyleStartFont($owner, XMLWriter $objWriter, bool &$fontStarted): void
+    {
+        $this->xlsxStyleStartFontState = $owner;
+        $owner = $this->xlsxStyleStartFontState;
+        if (!$fontStarted) {
+            $fontStarted = true;
+            $objWriter->startElement('font');
+        }
+    }
