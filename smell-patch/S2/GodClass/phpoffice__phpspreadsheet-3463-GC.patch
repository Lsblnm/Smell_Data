+    /**
+    * Write fonts to XML format.
+    *
+    * @param string[] $fontSet
+    */
+    public function xlsxThemeWriteFonts($owner, XMLWriter $objWriter, string $latinFont, array $fontSet): void
+    {
+        $this->xlsxThemeWriteFontsState = $owner;
+        $owner = $this->xlsxThemeWriteFontsState;
+        // a:latin
+        $objWriter->startElement('a:latin');
+        $objWriter->writeAttribute('typeface', $latinFont);
+        $objWriter->endElement();
+
+        // a:ea
+        $objWriter->startElement('a:ea');
+        $objWriter->writeAttribute('typeface', '');
+        $objWriter->endElement();
+
+        // a:cs
+        $objWriter->startElement('a:cs');
+        $objWriter->writeAttribute('typeface', '');
+        $objWriter->endElement();
+
+        foreach ($fontSet as $fontScript => $typeface) {
+            $objWriter->startElement('a:font');
+            $objWriter->writeAttribute('script', $fontScript);
+            $objWriter->writeAttribute('typeface', $typeface);
+            $objWriter->endElement();
+        }
+    }
