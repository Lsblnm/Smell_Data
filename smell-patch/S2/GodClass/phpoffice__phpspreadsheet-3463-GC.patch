+    public function xlsxStyleAllConditionalStyles($owner, Spreadsheet $spreadsheet)
+    {
+        $this->xlsxStyleAllConditionalStylesState = $owner;
+        $owner = $this->xlsxStyleAllConditionalStylesState;
+        // Get an array of all styles
+        $aStyles = [];
+
+        $sheetCount = $spreadsheet->getSheetCount();
+        for ($i = 0; $i < $sheetCount; ++$i) {
+            foreach ($spreadsheet->getSheet($i)->getConditionalStylesCollection() as $conditionalStyles) {
