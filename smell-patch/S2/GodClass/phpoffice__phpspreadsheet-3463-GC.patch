+    /**
+    * Write defined names.
+    */
+    public function xlsxDefinedNamesWriteNamedRangesAndFormulae($owner): void
+    {
+        $this->xlsxDefinedNamesWriteNamedRangesAndFormulaeState = $owner;
+        $owner = $this->xlsxDefinedNamesWriteNamedRangesAndFormulaeState;
+        // Loop named ranges
+        $definedNames = $this->definedNamesSpreadsheet->getDefinedNames();
+        foreach ($definedNames as $definedName) {
+            $this->xlsxDefinedNamesWriteDefinedName($owner, $definedName);
+        }
+    }
