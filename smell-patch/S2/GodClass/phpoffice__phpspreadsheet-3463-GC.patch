+    /**
+    * Write styles to XML format.
+    *
+    * @return string XML Output
+    */
+    public function xlsxStyleWriteStyles($owner, Spreadsheet $spreadsheet)
+    {
+        $this->xlsxStyleWriteStylesState = $owner;
+        $owner = $this->xlsxStyleWriteStylesState;
+        // Create XML writer
+        $objWriter = null;
+        if ($owner->getParentWriter()->getUseDiskCaching()) {
+            $objWriter = new XMLWriter(XMLWriter::STORAGE_DISK, $owner->getParentWriter()->getDiskCachingDirectory());
+        } else {
+            $objWriter = new XMLWriter(XMLWriter::STORAGE_MEMORY);
+        }
+
+        // XML header
+        $objWriter->startDocument('1.0', 'UTF-8', 'yes');
+
+        // styleSheet
+        $objWriter->startElement('styleSheet');
+        $objWriter->writeAttribute('xml:space', 'preserve');
+        $objWriter->writeAttribute('xmlns', Namespaces::MAIN);
+
+        // numFmts
+        $objWriter->startElement('numFmts');
+        $objWriter->writeAttribute('count', (string) $owner->getParentWriter()->getNumFmtHashTable()->count());
+
+        // numFmt
+        for ($i = 0; $i < $owner->getParentWriter()->getNumFmtHashTable()->count(); ++$i) {
+            $this->xlsxStyleWriteNumFmt($owner, $objWriter, $owner->getParentWriter()->getNumFmtHashTable()->getByIndex($i), $i);
+        }
+
+        $objWriter->endElement();
+
+        // fonts
+        $objWriter->startElement('fonts');
+        $objWriter->writeAttribute('count', (string) $owner->getParentWriter()->getFontHashTable()->count());
+
+        // font
+        for ($i = 0; $i < $owner->getParentWriter()->getFontHashTable()->count(); ++$i) {
+            $thisfont = $owner->getParentWriter()->getFontHashTable()->getByIndex($i);
+            if ($thisfont !== null) {
+                $this->xlsxStyleWriteFont($owner, $objWriter, $thisfont);
+            }
+        }
+
+        $objWriter->endElement();
+
+        // fills
+        $objWriter->startElement('fills');
+        $objWriter->writeAttribute('count', (string) $owner->getParentWriter()->getFillHashTable()->count());
+
+        // fill
+        for ($i = 0; $i < $owner->getParentWriter()->getFillHashTable()->count(); ++$i) {
+            $thisfill = $owner->getParentWriter()->getFillHashTable()->getByIndex($i);
+            if ($thisfill !== null) {
+                $this->xlsxStyleWriteFill($owner, $objWriter, $thisfill);
+            }
+        }
+
+        $objWriter->endElement();
+
+        // borders
+        $objWriter->startElement('borders');
+        $objWriter->writeAttribute('count', (string) $owner->getParentWriter()->getBordersHashTable()->count());
+
+        // border
+        for ($i = 0; $i < $owner->getParentWriter()->getBordersHashTable()->count(); ++$i) {
+            $thisborder = $owner->getParentWriter()->getBordersHashTable()->getByIndex($i);
+            if ($thisborder !== null) {
+                $this->xlsxStyleWriteBorder($owner, $objWriter, $thisborder);
+            }
+        }
+
+        $objWriter->endElement();
+
+        // cellStyleXfs
+        $objWriter->startElement('cellStyleXfs');
+        $objWriter->writeAttribute('count', '1');
+
+        // xf
+        $objWriter->startElement('xf');
+        $objWriter->writeAttribute('numFmtId', '0');
+        $objWriter->writeAttribute('fontId', '0');
+        $objWriter->writeAttribute('fillId', '0');
+        $objWriter->writeAttribute('borderId', '0');
+        $objWriter->endElement();
+
+        $objWriter->endElement();
+
+        // cellXfs
+        $objWriter->startElement('cellXfs');
+        $objWriter->writeAttribute('count', (string) count($spreadsheet->getCellXfCollection()));
+
+        // xf
+        foreach ($spreadsheet->getCellXfCollection() as $cellXf) {
+            $this->xlsxStyleWriteCellStyleXf($owner, $objWriter, $cellXf, $spreadsheet);
+        }
+
+        $objWriter->endElement();
+
+        // cellStyles
+        $objWriter->startElement('cellStyles');
+        $objWriter->writeAttribute('count', '1');
+
+        // cellStyle
+        $objWriter->startElement('cellStyle');
+        $objWriter->writeAttribute('name', 'Normal');
+        $objWriter->writeAttribute('xfId', '0');
+        $objWriter->writeAttribute('builtinId', '0');
+        $objWriter->endElement();
+
+        $objWriter->endElement();
+
+        // dxfs
+        $objWriter->startElement('dxfs');
+        $objWriter->writeAttribute('count', (string) $owner->getParentWriter()->getStylesConditionalHashTable()->count());
+
+        // dxf
+        for ($i = 0; $i < $owner->getParentWriter()->getStylesConditionalHashTable()->count(); ++$i) {
+            $thisstyle = $owner->getParentWriter()->getStylesConditionalHashTable()->getByIndex($i);
+            if ($thisstyle !== null) {
+                $this->xlsxStyleWriteCellStyleDxf($owner, $objWriter, $thisstyle->getStyle());
+            }
+        }
+
+        $objWriter->endElement();
+
+        // tableStyles
+        $objWriter->startElement('tableStyles');
+        $objWriter->writeAttribute('defaultTableStyle', 'TableStyleMedium9');
+        $objWriter->writeAttribute('defaultPivotStyle', 'PivotTableStyle1');
+        $objWriter->endElement();
+
+        $objWriter->endElement();
+
+        // Return
+        return $objWriter->getData();
+    }
+
