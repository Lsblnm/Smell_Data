+    /**
+    * Write workbook to XML format.
+    *
+    * @param bool $recalcRequired Indicate whether formulas should be recalculated before writing
+    *
+    * @return string XML Output
+    */
+    public function xlsxWorkbookWriteWorkbook($owner, Spreadsheet $spreadsheet, $recalcRequired = false)
+    {
+        $this->xlsxWorkbookWriteWorkbookState = $owner;
+        $owner = $this->xlsxWorkbookWriteWorkbookState;
+        // Create XML writer
+        if ($owner->getParentWriter()->getUseDiskCaching()) {
+            $objWriter = new XMLWriter(XMLWriter::STORAGE_DISK, $owner->getParentWriter()->getDiskCachingDirectory());
+        } else {
+            $objWriter = new XMLWriter(XMLWriter::STORAGE_MEMORY);
+        }
+
+        // XML header
+        $objWriter->startDocument('1.0', 'UTF-8', 'yes');
+
+        // workbook
+        $objWriter->startElement('workbook');
+        $objWriter->writeAttribute('xml:space', 'preserve');
+        $objWriter->writeAttribute('xmlns', Namespaces::MAIN);
+        $objWriter->writeAttribute('xmlns:r', Namespaces::SCHEMA_OFFICE_DOCUMENT);
+
+        // fileVersion
+        $this->xlsxWorkbookWriteFileVersion($owner, $objWriter);
+
+        // workbookPr
+        $this->xlsxWorkbookWriteWorkbookPr($owner, $objWriter);
+
+        // workbookProtection
+        $this->xlsxWorkbookWriteWorkbookProtection($owner, $objWriter, $spreadsheet);
+
+        // bookViews
+        if ($owner->getParentWriter()->getOffice2003Compatibility() === false) {
+            $this->xlsxWorkbookWriteBookViews($owner, $objWriter, $spreadsheet);
+        }
+
+        // sheets
+        $this->xlsxWorkbookWriteSheets($owner, $objWriter, $spreadsheet);
+
+        // definedNames
+        (new DefinedNamesWriter($objWriter, $spreadsheet))->write();
+
+        // calcPr
+        $this->xlsxWorkbookWriteCalcPr($owner, $objWriter, $recalcRequired);
+
+        $objWriter->endElement();
+
+        // Return
+        return $objWriter->getData();
+    }
