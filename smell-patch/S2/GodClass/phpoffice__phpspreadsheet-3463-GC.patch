+    /**
+    * Write workbook relationships to XML format.
+    *
+    * @return string XML Output
+    */
+    public function xlsxRelsWriteWorkbookRelationships($owner, Spreadsheet $spreadsheet)
+    {
+        $this->xlsxRelsWriteWorkbookRelationshipsState = $owner;
+        $owner = $this->xlsxRelsWriteWorkbookRelationshipsState;
+        // Create XML writer
+        $objWriter = null;
+        if ($owner->getParentWriter()->getUseDiskCaching()) {
+            $objWriter = new XMLWriter(XMLWriter::STORAGE_DISK, $owner->getParentWriter()->getDiskCachingDirectory());
+        } else {
+            $objWriter = new XMLWriter(XMLWriter::STORAGE_MEMORY);
+        }
+
+        // XML header
+        $objWriter->startDocument('1.0', 'UTF-8', 'yes');
+
+        // Relationships
+        $objWriter->startElement('Relationships');
+        $objWriter->writeAttribute('xmlns', Namespaces::RELATIONSHIPS);
+
+        // Relationship styles.xml
+        $this->xlsxRelsWriteRelationship($owner,
+            $objWriter,
+            1,
+            Namespaces::STYLES,
+            'styles.xml'
+        );
+
+        // Relationship theme/theme1.xml
+        $this->xlsxRelsWriteRelationship($owner,
+            $objWriter,
+            2,
+            Namespaces::THEME2,
+            'theme/theme1.xml'
+        );
+
+        // Relationship sharedStrings.xml
+        $this->xlsxRelsWriteRelationship($owner,
+            $objWriter,
+            3,
+            Namespaces::SHARED_STRINGS,
+            'sharedStrings.xml'
+        );
+
+        // Relationships with sheets
+        $sheetCount = $spreadsheet->getSheetCount();
+        for ($i = 0; $i < $sheetCount; ++$i) {
+            $this->xlsxRelsWriteRelationship($owner,
+                $objWriter,
+                ($i + 1 + 3),
+                Namespaces::WORKSHEET,
+                'worksheets/sheet' . ($i + 1) . '.xml'
+            );
+        }
+        // Relationships for vbaProject if needed
+        // id : just after the last sheet
+        if ($spreadsheet->hasMacros()) {
+            $this->xlsxRelsWriteRelationship($owner,
+                $objWriter,
+                ($i + 1 + 3),
+                Namespaces::VBA,
+                'vbaProject.bin'
+            );
+            ++$i; //increment i if needed for an another relation
+        }
+
+        $objWriter->endElement();
+
+        return $objWriter->getData();
+    }
