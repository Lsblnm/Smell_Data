+    public function xlsxDefinedNamesWrite($owner): void
+    {
+        $this->xlsxDefinedNamesWriteState = $owner;
+        $owner = $this->xlsxDefinedNamesWriteState;
+        // Write defined names
+        $this->definedNamesXmlWriter->startElement('definedNames');
+
+        // Named ranges
+        if (count($this->definedNamesSpreadsheet->getDefinedNames()) > 0) {
+            // Named ranges
+            $this->xlsxDefinedNamesWriteNamedRangesAndFormulae($owner);
+        }
+
+        // Other defined names
+        $sheetCount = $this->definedNamesSpreadsheet->getSheetCount();
+        for ($i = 0; $i < $sheetCount; ++$i) {
+            // NamedRange for autoFilter
+            $this->xlsxDefinedNamesWriteNamedRangeForAutofilter($owner, $this->definedNamesSpreadsheet->getSheet($i), $i);
+
+            // NamedRange for Print_Titles
+            $this->xlsxDefinedNamesWriteNamedRangeForPrintTitles($owner, $this->definedNamesSpreadsheet->getSheet($i), $i);
+
+            // NamedRange for Print_Area
+            $this->xlsxDefinedNamesWriteNamedRangeForPrintArea($owner, $this->definedNamesSpreadsheet->getSheet($i), $i);
+        }
+
+        $this->definedNamesXmlWriter->endElement();
+    }
