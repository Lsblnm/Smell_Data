+
+    public function xlsxWorksheetWriteCellError($owner, XMLWriter $objWriter, string $mappedType, string $cellValue, string $formulaerr = '#NULL!'): void
+    {
+        $this->xlsxWorksheetWriteCellErrorState = $owner;
+        $owner = $this->xlsxWorksheetWriteCellErrorState;
+        $objWriter->writeAttribute('t', $mappedType);
+        $cellIsFormula = substr($cellValue, 0, 1) === '=';
+        $this->xlsxWorksheetWriteElementIf($objWriter, $cellIsFormula, 'f', $this->rememberFormulaPrefixStripEquals($cellValue));
+        $objWriter->writeElement('v', $cellIsFormula ? $formulaerr : $cellValue);
+    }
+
+
+    public function xlsxWorksheetWriteCellFormula($owner, XMLWriter $objWriter, string $cellValue, Cell $cell): void
+    {
+        $this->xlsxWorksheetWriteCellFormulaState = $owner;
+        $owner = $this->xlsxWorksheetWriteCellFormulaState;
+        $calculatedValue = $owner->getParentWriter()->getPreCalculateFormulas() ? $cell->getCalculatedValue() : $cellValue;
+        if (is_string($calculatedValue)) {
+            if (ErrorValue::isError($calculatedValue)) {
+                $this->xlsxWorksheetWriteCellError($owner, $objWriter, 'e', $cellValue, $calculatedValue);
+
+                return;
+            }
+            $objWriter->writeAttribute('t', 'str');
+            $calculatedValue = StringHelper::controlCharacterPHP2OOXML($calculatedValue);
+        } elseif (is_bool($calculatedValue)) {
+            $objWriter->writeAttribute('t', 'b');
+            $calculatedValue = (int) $calculatedValue;
+        }
+
+        $attributes = $cell->getFormulaAttributes();
+        if (($attributes['t'] ?? null) === 'array') {
+            $objWriter->startElement('f');
+            $objWriter->writeAttribute('t', 'array');
+            $objWriter->writeAttribute('ref', $cell->getCoordinate());
+            $objWriter->writeAttribute('aca', '1');
+            $objWriter->writeAttribute('ca', '1');
+            $objWriter->text($this->rememberFormulaPrefixStripEquals($cellValue));
+            $objWriter->endElement();
+        } else {
+            $objWriter->writeElement('f', $this->rememberFormulaPrefixStripEquals($cellValue));
+            $this->xlsxWorksheetWriteElementIf(
+                $objWriter,
+                $owner->getParentWriter()->getOffice2003Compatibility() === false,
+                'v',
+                ($owner->getParentWriter()->getPreCalculateFormulas() && !is_array($calculatedValue) && substr($calculatedValue ?? '', 0, 1) !== '#')
+                    ? StringHelper::formatNumber($calculatedValue) : '0'
+            );
+        }
+    }
+
+
+    /**
+    * Write Cell.
+    *
+    * @param string $cellAddress Cell Address
+    * @param string[] $flippedStringTable String table (flipped), for faster index searching
+    */
+    public function xlsxWorksheetWriteCell($owner, XMLWriter $objWriter, PhpspreadsheetWorksheet $worksheet, string $cellAddress, array $flippedStringTable): void
+    {
+        $this->xlsxWorksheetWriteCellState = $owner;
+        $owner = $this->xlsxWorksheetWriteCellState;
+        // Cell
+        $pCell = $worksheet->getCell($cellAddress);
+        $objWriter->startElement('c');
+        $objWriter->writeAttribute('r', $cellAddress);
+
+        // Sheet styles
+        $xfi = $pCell->getXfIndex();
+        $this->xlsxWorksheetWriteAttributeIf($objWriter, (bool) $xfi, 's', "$xfi");
+
+        // If cell value is supplied, write cell value
+        $cellValue = $pCell->getValue();
+        if (is_object($cellValue) || $cellValue !== '') {
+            // Map type
+            $mappedType = $pCell->getDataType();
+
+            // Write data depending on its type
+            switch (strtolower($mappedType)) {
+                case 'inlinestr':    // Inline string
+                    $this->xlsxWorksheetWriteCellInlineStr($owner, $objWriter, $mappedType, $cellValue);
+
+                    break;
+                case 's':            // String
+                    $this->xlsxWorksheetWriteCellString($owner, $objWriter, $mappedType, $cellValue, $flippedStringTable);
+
+                    break;
+                case 'f':            // Formula
+                    $this->xlsxWorksheetWriteCellFormula($owner, $objWriter, $cellValue, $pCell);
+
+                    break;
+                case 'n':            // Numeric
+                    $this->xlsxWorksheetWriteCellNumeric($owner, $objWriter, $cellValue);
+
+                    break;
+                case 'b':            // Boolean
+                    $this->xlsxWorksheetWriteCellBoolean($owner, $objWriter, $mappedType, $cellValue);
+
+                    break;
+                case 'e':            // Error
+                    $this->xlsxWorksheetWriteCellError($owner, $objWriter, $mappedType, $cellValue);
+            }
+        }
+
+        $objWriter->endElement();
+    }
+
