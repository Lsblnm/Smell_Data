+    /**
+    * Write charts to XML format.
+    *
+    * @param mixed $calculateCellValues
+    *
+    * @return string XML Output
+    */
+    public function xlsxChartWriteChart($owner, \PhpOffice\PhpSpreadsheet\Chart\Chart $chart, $calculateCellValues = true)
+    {
+        $this->xlsxChartWriteChartState = $owner;
+        $owner = $this->xlsxChartWriteChartState;
+        // Create XML writer
+        $objWriter = null;
+        if ($owner->getParentWriter()->getUseDiskCaching()) {
+            $objWriter = new XMLWriter(XMLWriter::STORAGE_DISK, $owner->getParentWriter()->getDiskCachingDirectory());
+        } else {
+            $objWriter = new XMLWriter(XMLWriter::STORAGE_MEMORY);
+        }
+        //    Ensure that data series values are up-to-date before we save
+        if ($calculateCellValues) {
+            $chart->refresh();
+        }
+
+        // XML header
+        $objWriter->startDocument('1.0', 'UTF-8', 'yes');
+
+        // c:chartSpace
+        $objWriter->startElement('c:chartSpace');
+        $objWriter->writeAttribute('xmlns:c', Namespaces::CHART);
+        $objWriter->writeAttribute('xmlns:a', Namespaces::DRAWINGML);
+        $objWriter->writeAttribute('xmlns:r', Namespaces::SCHEMA_OFFICE_DOCUMENT);
+
+        $objWriter->startElement('c:date1904');
+        $objWriter->writeAttribute('val', '0');
+        $objWriter->endElement();
+        $objWriter->startElement('c:lang');
+        $objWriter->writeAttribute('val', 'en-GB');
+        $objWriter->endElement();
+        $objWriter->startElement('c:roundedCorners');
+        $objWriter->writeAttribute('val', $chart->getRoundedCorners() ? '1' : '0');
+        $objWriter->endElement();
+
+        $this->xlsxChartWriteAlternateContent($owner, $objWriter);
+
+        $objWriter->startElement('c:chart');
+
+        $this->xlsxChartWriteTitle($owner, $objWriter, $chart->getTitle());
+
+        $objWriter->startElement('c:autoTitleDeleted');
+        $objWriter->writeAttribute('val', (string) (int) $chart->getAutoTitleDeleted());
+        $objWriter->endElement();
+
+        $objWriter->startElement('c:view3D');
+        $surface2D = false;
+        $plotArea = $chart->getPlotArea();
+        if ($plotArea !== null) {
+            $seriesArray = $plotArea->getPlotGroup();
+            foreach ($seriesArray as $series) {
+                if ($series->getPlotType() === DataSeries::TYPE_SURFACECHART) {
+                    $surface2D = true;
+
+                    break;
+                }
+            }
+        }
+        $this->xlsxChartWriteView3D($owner, $objWriter, $chart->getRotX(), 'c:rotX', $surface2D, 90);
+        $this->xlsxChartWriteView3D($owner, $objWriter, $chart->getRotY(), 'c:rotY', $surface2D);
+        $this->xlsxChartWriteView3D($owner, $objWriter, $chart->getRAngAx(), 'c:rAngAx', $surface2D);
+        $this->xlsxChartWriteView3D($owner, $objWriter, $chart->getPerspective(), 'c:perspective', $surface2D);
+        $objWriter->endElement(); // view3D
+
+        $this->xlsxChartWritePlotArea($owner, $objWriter, $chart->getPlotArea(), $chart->getXAxisLabel(), $chart->getYAxisLabel(), $chart->getChartAxisX(), $chart->getChartAxisY());
+
+        $this->xlsxChartWriteLegend($owner, $objWriter, $chart->getLegend());
+
+        $objWriter->startElement('c:plotVisOnly');
+        $objWriter->writeAttribute('val', (string) (int) $chart->getPlotVisibleOnly());
+        $objWriter->endElement();
+
+        $objWriter->startElement('c:dispBlanksAs');
+        $objWriter->writeAttribute('val', $chart->getDisplayBlanksAs());
+        $objWriter->endElement();
+
+        $objWriter->startElement('c:showDLblsOverMax');
+        $objWriter->writeAttribute('val', '0');
+        $objWriter->endElement();
+
+        $objWriter->endElement(); // c:chart
+        if ($chart->getNoFill()) {
+            $objWriter->startElement('c:spPr');
+            $objWriter->startElement('a:noFill');
+            $objWriter->endElement(); // a:noFill
+            $objWriter->endElement(); // c:spPr
+        }
+
+        $this->xlsxChartWritePrintSettings($owner, $objWriter);
+
+        $objWriter->endElement(); // c:chartSpace
+
+        // Return
+        return $objWriter->getData();
+    }
+
