+    /**
+    * Write Data Labels.
+    */
+    public function xlsxChartWriteDataLabels($owner, XMLWriter $objWriter, ?Layout $chartLayout = null): void
+    {
+        $this->xlsxChartWriteDataLabelsState = $owner;
