+    /**
+    * Write comments to XML format.
+    *
+    * @return string XML Output
+    */
+    public function xlsxCommentsWriteComments($owner, \PhpOffice\PhpSpreadsheet\Worksheet\Worksheet $worksheet)
+    {
+        $this->xlsxCommentsWriteCommentsState = $owner;
+        $owner = $this->xlsxCommentsWriteCommentsState;
+        // Create XML writer
+        $objWriter = null;
+        if ($owner->getParentWriter()->getUseDiskCaching()) {
+            $objWriter = new XMLWriter(XMLWriter::STORAGE_DISK, $owner->getParentWriter()->getDiskCachingDirectory());
+        } else {
+            $objWriter = new XMLWriter(XMLWriter::STORAGE_MEMORY);
+        }
+
+        // XML header
+        $objWriter->startDocument('1.0', 'UTF-8', 'yes');
+
+        // Comments cache
+        $comments = $worksheet->getComments();
+
+        // Authors cache
+        $authors = [];
+        $authorId = 0;
+        foreach ($comments as $comment) {
+            if (!isset($authors[$comment->getAuthor()])) {
+                $authors[$comment->getAuthor()] = $authorId++;
+            }
+        }
+
+        // comments
+        $objWriter->startElement('comments');
+        $objWriter->writeAttribute('xmlns', Namespaces::MAIN);
+
+        // Loop through authors
+        $objWriter->startElement('authors');
+        foreach ($authors as $author => $index) {
+            $objWriter->writeElement('author', $author);
+        }
+        $objWriter->endElement();
+
+        // Loop through comments
+        $objWriter->startElement('commentList');
+        foreach ($comments as $key => $value) {
+            $this->xlsxCommentsWriteComment($owner, $objWriter, $key, $value, $authors);
+        }
+        $objWriter->endElement();
+
+        $objWriter->endElement();
+
+        // Return
+        return $objWriter->getData();
+    }
+
+
+    /**
+    * Write comment to XML format.
+    *
+    * @param string $cellReference Cell reference
+    * @param Comment $comment Comment
+    * @param array $authors Array of authors
+    */
+    public function xlsxCommentsWriteComment($owner, XMLWriter $objWriter, $cellReference, Comment $comment, array $authors): void
+    {
+        $this->xlsxCommentsWriteCommentState = $owner;
+        $owner = $this->xlsxCommentsWriteCommentState;
+        // comment
+        $objWriter->startElement('comment');
+        $objWriter->writeAttribute('ref', $cellReference);
+        $objWriter->writeAttribute('authorId', $authors[$comment->getAuthor()]);
+
+        // text
+        $objWriter->startElement('text');
+        $owner->getParentWriter()->getWriterPartstringtable()->writeRichText($objWriter, $comment->getText());
+        $objWriter->endElement();
+
+        $objWriter->endElement();
+    }
