+
+    public function xlsxWorksheetWriteCellBoolean($owner, XMLWriter $objWriter, string $mappedType, bool $cellValue): void
+    {
+        $this->xlsxWorksheetWriteCellBooleanState = $owner;
+        $owner = $this->xlsxWorksheetWriteCellBooleanState;
+        $objWriter->writeAttribute('t', $mappedType);
+        $objWriter->writeElement('v', $cellValue ? '1' : '0');
+    }
