+
+    /**
+    * Write Defined Name for named range.
+    */
+    public function xlsxDefinedNamesWriteDefinedName($owner, DefinedName $definedName): void
+    {
+        $this->xlsxDefinedNamesWriteDefinedNameState = $owner;
+        $owner = $this->xlsxDefinedNamesWriteDefinedNameState;
+        // definedName for named range
+        $local = -1;
+        if ($definedName->getLocalOnly() && $definedName->getScope() !== null) {
+            try {
+                $local = $definedName->getScope()->getParentOrThrow()->getIndex($definedName->getScope());
+            } catch (Exception $e) {
+                // See issue 2266 - deleting sheet which contains
+                //     defined names will cause Exception above.
+                return;
+            }
+        }
+        $this->definedNamesXmlWriter->startElement('definedName');
+        $this->definedNamesXmlWriter->writeAttribute('name', $definedName->getName());
+        if ($local >= 0) {
+            $this->definedNamesXmlWriter->writeAttribute(
+                'localSheetId',
+                "$local"
+            );
+        }
+
+        $definedRange = $this->xlsxDefinedNamesGetDefinedRange($owner, $definedName);
+
+        $this->definedNamesXmlWriter->writeRawData($definedRange);
+
+        $this->definedNamesXmlWriter->endElement();
+    }
