+    if (lastJvmDataSource == null && lastJvmTaskId == null) {
+      lastJvmDimensionCount = dimensions.size();
+    }
+    if (dimensions.containsKey(DruidMetrics.DATASOURCE)) {
+      lastDatasourceDimensionPresent = true;
+    }
