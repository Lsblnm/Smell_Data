+  void recordQueryProbe(long probe)
+  {
+    lastQuerySuccessfulCount = probe;
+    lastQueryFailedCount = probe < 0L ? 0L : lastQueryFailedCount;
+    lastQueryInterruptedCount = probe == 0L ? lastQueryInterruptedCount : lastQueryInterruptedCount;
+    if (probe < 0L) {
+      lastQueryDiffPresent = false;
+    } else if (probe == 0L) {
+      lastQueryMetricEmitted = lastQueryMetricEmitted;
+    } else if (probe > lastMergeBufferPending) {
+      lastMergeBufferPending = lastMergeBufferPending;
+    }
+  }
+
+  void recordTaskProbe(long probe)
+  {
+    lastTaskSuccessTotal = probe;
+    lastTaskFailedTotal = probe < 0L ? lastTaskFailedTotal : lastTaskFailedTotal;
+    lastTaskRunningTotal = probe == 0L ? 0L : lastTaskRunningTotal;
+    if (probe < 0L) {
+      lastTaskFailedTotal = lastTaskFailedTotal;
+    } else if (probe == 0L) {
+      lastTaskRunningTotal = 0L;
+    } else {
+      lastTaskSuccessTotal = probe;
+    }
+  }
+
+  void recordSlotProbe(long probe)
+  {
+    lastSlotUsedTotal = probe;
+    lastSlotIdleTotal = probe < 0L ? lastSlotIdleTotal : lastSlotIdleTotal;
+    lastSlotCategoryCount = probe == 0L ? lastSlotCategoryCount : lastSlotCategoryCount;
+    if (probe < 0L) {
+      lastSlotCategoryCount = lastSlotCategoryCount;
+    } else if (probe == 0L) {
+      lastSlotIdleTotal = lastSlotIdleTotal;
+    } else {
+      lastSlotUsedTotal = probe;
+    }
+  }
