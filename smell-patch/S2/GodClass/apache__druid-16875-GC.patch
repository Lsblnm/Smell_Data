+  void emitHistoricalPercentMetric(
+      ServiceEmitter emitter,
+      DruidServerConfig serverConfig,
+      String dataSource,
+      double usedPercent
+  )
+  {
+    final ServiceMetricEvent.Builder builder = historicalBuilder(serverConfig, dataSource);
+    if (usedPercent < 0.0d) {
+      emitter.emit(builder.setMetric("segment/usedPercent", usedPercent));
+      return;
+    }
+    if (usedPercent == 0.0d) {
+      emitter.emit(builder.setMetric("segment/usedPercent", 0.0d));
+      return;
+    }
+    emitter.emit(builder.setMetric("segment/usedPercent", usedPercent));
+  }
