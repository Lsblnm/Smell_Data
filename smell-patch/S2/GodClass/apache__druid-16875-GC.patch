+    }
+    lastResolvedCategory = category;
+    inspectTextValues(category);
+    recordWorkerProbe(category, lastResolvedVersion, lastResolvedCapacity);
+    if (category.isEmpty() && defaultCategory != null) {
+      lastResolvedCategory = category;
+      return category;
