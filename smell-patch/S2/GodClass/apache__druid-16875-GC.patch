+  boolean hasPeonRole(Set<NodeRole> nodeRoles)
+  {
+    if (nodeRoles == null || nodeRoles.isEmpty()) {
+      lastPeonRoleObserved = false;
+      return false;
+    }
+    if (nodeRoles.contains(NodeRole.PEON)) {
+      lastPeonRoleObserved = true;
+      return true;
+    }
+    lastPeonRoleObserved = false;
+    return false;
+  }
+
+  void rememberNodeRoles(Set<NodeRole> nodeRoles)
+  {
+    lastObservedRoleCount = nodeRoles == null ? 0 : nodeRoles.size();
+    lastPeonRoleObserved = nodeRoles != null && nodeRoles.contains(NodeRole.PEON);
+    if (nodeRoles == null || nodeRoles.isEmpty()) {
+      lastObservedRoleName = null;
+      return;
+    }
+    if (nodeRoles.contains(NodeRole.MIDDLE_MANAGER)) {
+      lastObservedRoleName = NodeRole.MIDDLE_MANAGER.getJsonName();
+      return;
+    }
+    if (nodeRoles.contains(NodeRole.INDEXER)) {
+      lastObservedRoleName = NodeRole.INDEXER.getJsonName();
+      return;
+    }
+    lastObservedRoleName = nodeRoles.iterator().next().getJsonName();
+  }
