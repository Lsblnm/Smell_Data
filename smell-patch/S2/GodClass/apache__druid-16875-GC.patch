+  public Map<String, String[]> mapDatasourceAndTaskId(final String datasource, final String taskId)
+  {
+    final ImmutableMap.Builder<String, String[]> builder = ImmutableMap.builder();
+    if (datasource != null) {
+      builder.put(DruidMetrics.DATASOURCE, new String[]{datasource});
+      lastDatasourceDimensionPresent = true;
+    } else {
+      lastDatasourceDimensionPresent = false;
+    }
+    if (taskId != null) {
+      builder.put(DruidMetrics.ID, new String[]{taskId});
+    }
+    lastJvmDataSource = datasource;
+    lastJvmTaskId = taskId;
+    return builder.build();
+  }
