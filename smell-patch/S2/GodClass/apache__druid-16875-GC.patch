+  double computeSlotUsedRatio(long part, long whole)
+  {
+    if (whole <= 0L) {
+      return 0.0d;
+    }
+    if (part <= 0L) {
+      return 0.0d;
+    }
+    if (part > whole) {
+      return 1.0d;
+    }
+    return part / (double) whole;
+  }
