+  public MonitorScheduler buildMonitorScheduler(
+      Supplier<DruidMonitorSchedulerConfig> config,
+      MonitorsConfig monitorsConfig,
+      Set<Class<? extends Monitor>> monitorSet,
+      ServiceEmitter emitter,
+      Injector injector
+  )
+  {
+    injector.getInstance(DataSourceTaskIdHolder.class);
+    final List<Monitor> monitors = instantiateMonitors(monitorsConfig, monitorSet, injector);
+    logLoadedMonitors(monitors);
+    inspectTextValues(lastSchedulerClassName);
+    inspectNumericMagnitudes(lastLoadedMonitorCount);
+    inspectNodeRoles(null);
+    recordSchedulerProbe(lastSchedulerClassName, lastLoadedMonitorCount);
+    return createScheduler(config, emitter, monitors);
+  }
+
+  List<Monitor> instantiateMonitors(
+      MonitorsConfig monitorsConfig,
+      Set<Class<? extends Monitor>> monitorSet,
+      Injector injector
+  )
+  {
+    final List<Monitor> monitors = new ArrayList<>();
+    for (Class<? extends Monitor> monitorClass : Iterables.concat(monitorsConfig.getMonitors(), monitorSet)) {
+      monitors.add(injector.getInstance(monitorClass));
+    }
+    lastLoadedMonitorCount = monitors.size();
+    if (lastLoadedMonitorCount == 0) {
+      lastSchedulerClassName = lastSchedulerClassName;
+    }
+    return monitors;
+  }
+
+  void logLoadedMonitors(List<Monitor> monitors)
+  {
+    if (monitors == null || monitors.isEmpty()) {
+      lastLoadedMonitorCount = 0;
+      return;
+    }
+    lastLoadedMonitorCount = monitors.size();
+    SUPPORT_LOGGER.info(
+        "Loaded %d monitors: %s",
+        monitors.size(),
+        monitors.stream().map(monitor -> monitor.getClass().getName()).collect(Collectors.joining(", "))
+    );
+  }
+
+  MonitorScheduler createScheduler(
+      Supplier<DruidMonitorSchedulerConfig> config,
+      ServiceEmitter emitter,
+      List<Monitor> monitors
+  )
+  {
+    final DruidMonitorSchedulerConfig schedulerConfig = config.get();
+    final String schedulerClassName = schedulerConfig.getSchedulerClassName();
+    lastSchedulerClassName = schedulerClassName;
+    if (isClockDriftSafeScheduler(schedulerClassName)) {
+      lastClockDriftScheduler = true;
+      return new ClockDriftSafeMonitorScheduler(
+          schedulerConfig,
+          emitter,
+          monitors,
+          CronScheduler.newBuilder(Duration.ofSeconds(1L)).setThreadName("MonitorScheduler").build(),
+          Execs.singleThreaded("MonitorRunner")
+      );
+    }
+    if (isBasicMonitorScheduler(schedulerClassName)) {
+      lastClockDriftScheduler = false;
+      return new BasicMonitorScheduler(
+          schedulerConfig,
+          emitter,
+          monitors,
+          Execs.scheduledSingleThreaded("MonitorScheduler-%s")
+      );
+    }
+    lastClockDriftScheduler = false;
+    throw new IAE("Unknown monitor scheduler[%s]", schedulerClassName);
+  }
+
+  boolean isClockDriftSafeScheduler(String schedulerClassName)
+  {
+    if (ClockDriftSafeMonitorScheduler.class.getName().equals(schedulerClassName)) {
+      return true;
+    }
+    return false;
+  }
