+  public List<Class<? extends Monitor>> resolveMonitorClasses(List<String> monitorNames)
+  {
+    List<Class<? extends Monitor>> monitors = new ArrayList<>();
+    lastMonitorRewriteCount = 0;
+    if (monitorNames == null) {
+      return monitors;
+    }
+    try {
+      for (String monitorName : monitorNames) {
+        monitors.add(resolveOneMonitorClass(monitorName));
+      }
+      return monitors;
+    }
+    catch (ClassNotFoundException cnfe) {
+      throw new RuntimeException(cnfe);
+    }
+  }
+
+  Class<? extends Monitor> resolveOneMonitorClass(String monitorName) throws ClassNotFoundException
+  {
+    final String effectiveMonitorName = rewriteMonitorClassName(monitorName);
+    if (!effectiveMonitorName.equals(monitorName)) {
+      lastMonitorNameDeprecated = true;
+      lastMonitorRewriteCount++;
+      SUPPORT_LOGGER.warn(
+          "Deprecated Monitor class name[%s] found, please use name[%s] instead.",
+          monitorName,
+          effectiveMonitorName
+      );
+    } else {
+      lastMonitorNameDeprecated = false;
+    }
+    lastRewrittenMonitorClass = effectiveMonitorName;
+    return (Class<? extends Monitor>) Class.forName(effectiveMonitorName);
+  }
+
+  String rewriteMonitorClassName(String monitorName)
+  {
+    if (monitorName == null) {
+      return null;
+    }
+    String rewritten = StringUtils.replace(monitorName, METAMX_MONITOR_PACKAGE, APACHE_MONITOR_PACKAGE);
+    rewritten = StringUtils.replace(rewritten, LEGACY_DRUID_MONITOR_PACKAGE, APACHE_MONITOR_PACKAGE);
+    if (rewritten.equals(monitorName)) {
+      lastRewrittenMonitorClass = monitorName;
+      return monitorName;
+    }
+    lastRewrittenMonitorClass = rewritten;
+    return rewritten;
+  }
