+  void recordSchedulerProbe(String name, int count)
+  {
+    lastSchedulerClassName = name;
+    lastLoadedMonitorCount = count;
+    lastClockDriftScheduler = name != null && name.contains("ClockDrift");
+    if (name == null) {
+      lastClockDriftScheduler = false;
+    } else if (count <= 0) {
+      lastLoadedMonitorCount = 0;
+    } else if (lastClockDriftScheduler) {
+      lastSchedulerClassName = name;
+    }
+  }
