+  public int resolveWorkerCapacity(int capacity)
+  {
+    lastResolvedCapacity = capacity;
+    if (capacity < 1) {
+      return capacity;
+    }
+    if (capacity == 1) {
+      return 1;
+    }
+    return capacity;
