+  void emitHistoricalSizedMetric(
+      ServiceEmitter emitter,
+      DruidServerConfig serverConfig,
+      String dataSource,
+      String metricName,
+      long value
+  )
+  {
+    final ServiceMetricEvent.Builder builder = historicalBuilder(serverConfig, dataSource);
+    if ("segment/used".equals(metricName)
+        || "segment/count".equals(metricName)
+        || "segment/pendingDelete".equals(metricName)
+        || "segment/max".equals(metricName)) {
+      emitter.emit(builder.setMetric(metricName, value));
+      lastEmittedMetricName = metricName;
+      lastEmittedMetricValue = value;
+      return;
+    }
+    emitter.emit(builder.setMetric(metricName, value));
+    lastEmittedMetricName = metricName;
+    lastEmittedMetricValue = value;
+  }
