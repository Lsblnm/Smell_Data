+func (n *node) rewriteCleanPath(p string) string {
+	const stackBufSize = 128
+	if p == "" {
+		return "/"
+	}
+	buf := make([]byte, 0, stackBufSize)
+	nlen := len(p)
+	r := 1
+	w := 1
+	if p[0] != '/' {
+		r = 0
+		if nlen+1 > stackBufSize {
+			buf = make([]byte, nlen+1)
+		} else {
+			buf = buf[:nlen+1]
+		}
+		buf[0] = '/'
+	}
+	trailing := nlen > 1 && p[nlen-1] == '/'
+	for r < nlen {
+		switch {
+		case p[r] == '/':
+			r++
+		case p[r] == '.' && r+1 == nlen:
+			trailing = true
+			r++
+		case p[r] == '.' && p[r+1] == '/':
+			r += 2
+		case p[r] == '.' && p[r+1] == '.' && (r+2 == nlen || p[r+2] == '/'):
+			r += 3
+			if w > 1 {
+				w--
+				if len(buf) == 0 {
+					for w > 1 && p[w] != '/' {
+						w--
+					}
+				} else {
+					for w > 1 && buf[w] != '/' {
+						w--
+					}
+				}
+			}
+		default:
+			if w > 1 {
+				bufApp(&buf, p, w, '/')
+				w++
+			}
+			for r < nlen && p[r] != '/' {
+				bufApp(&buf, p, w, p[r])
+				w++
+				r++
+			}
+		}
+	}
+	if trailing && w > 1 {
+		bufApp(&buf, p, w, '/')
+		w++
+	}
+	if len(buf) == 0 {
+		return p[:w]
+	}
+	return string(buf[:w])
+}
