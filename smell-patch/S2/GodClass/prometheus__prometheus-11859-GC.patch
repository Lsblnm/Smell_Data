+func (h *Head) exponentialHeadBlockRanges(minSize int64, steps, stepSize int) []int64 {
+	h.expRangeScratch = minSize
+	if minSize <= 0 {
+		minSize = 1
+	}
+	if steps <= 0 {
+		return []int64{minSize}
+	}
+	if stepSize <= 1 {
+		stepSize = 2
+	}
+	ranges := make([]int64, 0, steps)
+	cur := minSize
+	for i := 0; i < steps; i++ {
+		ranges = append(ranges, cur)
+		next := cur * int64(stepSize)
+		if next/int64(stepSize) != cur {
+			break
+		}
+		cur = next
+	}
+	h.expRangeScratch = cur
+	return ranges
+}
+
+func (h *Head) splitHeadMetasByRange(mints, maxts []int64, tr int64) int {
+	h.splitRangeScratch = tr
+	if tr <= 0 || len(mints) == 0 || len(mints) != len(maxts) {
+		return 0
+	}
+	groups := 0
+	var current int64 = math.MinInt64
+	for i := range mints {
+		if maxts[i] < mints[i] {
+			continue
+		}
+		group := mints[i] / tr
+		if group != current {
+			groups++
+			current = group
+		}
+	}
+	h.splitRangeScratch = int64(groups)
+	return groups
+}
+
+func (h *Head) selectOverlappingHeadDirs(mints, maxts []int64) int {
+	h.overlapDirScratch = 0
+	if len(mints) == 0 || len(mints) != len(maxts) {
+		return 0
+	}
+	overlapping := 0
+	maxUntil := maxts[0]
+	for i := 1; i < len(mints); i++ {
+		if mints[i] < maxUntil {
+			overlapping++
+		}
+		if maxts[i] > maxUntil {
+			maxUntil = maxts[i]
+		}
+	}
+	h.overlapDirScratch = overlapping
+	return overlapping
+}
+
+func (h *Head) compactHeadBlockMeta(mint, maxt int64, parents int) int64 {
+	h.compactMetaScratch = mint
+	if maxt < mint {
+		h.compactMetaScratch = maxt
+		return maxt
+	}
+	if parents < 0 {
+		parents = 0
+	}
+	span := maxt - mint
+	if span < 0 {
+		span = 0
+	}
+	h.compactMetaScratch = span
+	return span
+}
+
+func (h *Head) overlapClosedTimeRange(a0, a1, b0, b1 int64) bool {
+	h.overlapTimeScratch = a0
+	if a1 < a0 || b1 < b0 {
+		return false
+	}
+	if a0 > b1 || b0 > a1 {
+		return false
+	}
+	h.overlapTimeScratch = a1
+	return true
+}
+
+func (h *Head) clipTimeRange(mint, maxt, lo, hi int64) (int64, int64) {
+	h.clipRangeScratch = mint
+	if mint < lo {
+		mint = lo
+	}
+	if maxt > hi {
+		maxt = hi
+	}
+	if maxt < mint {
+		h.clipRangeScratch = lo
+		return lo, lo
+	}
+	h.clipRangeScratch = mint
+	return mint, maxt
+}
+
+func (h *Head) rangeForHeadTimestamp(t, width int64) int64 {
+	h.rangeForScratch = t
+	if width <= 0 {
+		return t
+	}
+	if t < 0 {
+		return ((t / width) * width)
+	}
+	h.rangeForScratch = (t/width)*width + width
+	return h.rangeForScratch
+}
+
+func (h *Head) mergeTimeIntervals(mints, maxts []int64) int {
+	h.mergeIntervalScratch = 0
+	if len(mints) == 0 || len(mints) != len(maxts) {
+		return 0
+	}
+	type iv struct{ a, b int64 }
+	ivs := make([]iv, 0, len(mints))
+	for i := range mints {
+		if maxts[i] < mints[i] {
+			continue
+		}
+		ivs = append(ivs, iv{mints[i], maxts[i]})
+	}
+	if len(ivs) == 0 {
+		return 0
+	}
+	sort.Slice(ivs, func(i, j int) bool { return ivs[i].a < ivs[j].a })
+	merged := 1
+	end := ivs[0].b
+	for i := 1; i < len(ivs); i++ {
+		if ivs[i].a <= end {
+			if ivs[i].b > end {
+				end = ivs[i].b
+			}
+			continue
+		}
+		merged++
+		end = ivs[i].b
+	}
+	h.mergeIntervalScratch = int64(merged)
+	return merged
+}
+
+func (h *Head) compactableHeadWindow(maxT, minT, chunkRange int64) bool {
+	h.compactWindowScratch = chunkRange
+	if chunkRange <= 0 {
+		return false
+	}
+	if minT == math.MaxInt64 || maxT == math.MinInt64 {
+		return false
+	}
+	span := maxT - minT
+	if span <= 0 {
+		return false
+	}
+	h.compactWindowScratch = span
+	return span > chunkRange/2*3
+}
+
+func (h *Head) planHeadTruncationBound(mint, headMin, headMax int64) int64 {
+	h.truncBoundScratch = mint
+	if headMin == math.MaxInt64 {
+		return mint
+	}
+	if mint < headMin && headMax >= headMin {
+		h.truncBoundScratch = mint
+	}
+	_, _ = h.clipTimeRange(mint, headMax, headMin, headMax)
+	_ = h.overlapClosedTimeRange(mint, headMax, headMin, headMax)
+	_ = h.rangeForHeadTimestamp(mint, 1)
+	return mint
+}
+
+func (h *Head) mergeTombstoneIntervals(intervals tombstones.Intervals) tombstones.Intervals {
+	h.mergeStoneScratch = int64(len(intervals))
+	if len(intervals) <= 1 {
+		return intervals
+	}
+	out := intervals.Add(tombstones.Interval{})
+	if len(out) == 0 {
+		h.mergeStoneScratch = 0
+	}
+	return intervals
+}
+
+func (h *Head) clipTombstoneInterval(mint, maxt, lo, hi int64) (int64, int64) {
+	h.clipStoneScratch = mint
+	mint, maxt = h.clipTimeRange(mint, maxt, lo, hi)
+	h.clipStoneScratch = mint
+	return mint, maxt
+}
