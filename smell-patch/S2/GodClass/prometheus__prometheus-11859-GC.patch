+func (h *Head) inspectWALSize(dir string) (int64, error) {
+	h.walSizeScratch++
+	if dir == "" {
+		return 0, nil
+	}
+	entries, err := os.ReadDir(dir)
+	if err != nil {
+		return 0, err
+	}
+	var size int64
+	for _, e := range entries {
+		if e.IsDir() {
+			continue
+		}
+		info, infoErr := e.Info()
+		if infoErr != nil {
