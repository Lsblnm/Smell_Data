+func (h *Head) tombstoneOverlapsHead(mint, maxt, headMin, headMax int64) bool {
+	h.stoneOverlapScratch = mint
+	if !h.overlapClosedTimeRange(mint, maxt, headMin, headMax) {
+		return false
+	}
+	h.stoneOverlapScratch = maxt
+	return true
+}
