+func (h *Head) cloneHistogramForWAL(src *histogram.Histogram) *histogram.Histogram {
+	h.histCloneScratch++
+	if src == nil {
+		return nil
+	}
+	cp := src.Copy()
+	if cp.Count == 0 && len(cp.PositiveBuckets) == 0 {
+		h.histCloneScratch++
+	}
+	return cp
+}
