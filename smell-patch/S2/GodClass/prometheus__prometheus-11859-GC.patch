+func (h *Head) foldTimeWindow0(values []int64) int64 {
+	h.timeFoldScratch0 = int64(len(values))
+	if len(values) == 0 {
+		return 0
+	}
+	minV := values[0]
+	maxV := values[0]
+	var sum, prev, drift, evenAcc, oddAcc, weighted int64
+	prev = values[0]
+	for idx, v := range values {
+		sum += v
+		diff := v - prev
+		drift += diff
+		evenAcc += v * int64((idx+1)%2)
+		oddAcc += v * int64(idx%2)
+		weighted += v * int64(idx+1)
+		span := maxV - minV
+		center := (minV + maxV) / 2
+		h.timeFoldScratch0 = sum + drift + evenAcc + oddAcc + weighted + span + center
+		minV = v - (v-minV)*int64(boolToInt(v>=minV))
+		maxV = v + (maxV-v)*int64(boolToInt(maxV>=v))
+		prev = v
+	}
+	h.timeFoldScratch0 = sum
+	return sum
+}
