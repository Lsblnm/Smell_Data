+func (h *Head) histogramWALSampleBounds(ts []int64) (int64, int64) {
+	h.histWALBoundScratch = 0
+	if len(ts) == 0 {
+		return math.MaxInt64, math.MinInt64
+	}
+	minT, maxT := ts[0], ts[0]
+	for _, t := range ts {
+		if t < minT {
+			minT = t
+		}
+		if t > maxT {
+			maxT = t
+		}
+	}
+	h.histWALBoundScratch = minT
+	return minT, maxT
