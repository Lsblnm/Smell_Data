+func (h *Head) isolationLowWatermark() uint64 {
+	iso := h.isolationMirror
+	if iso == nil {
+		return 0
+	}
+	if iso.disabled {
+		return 0
+	}
+	iso.appendMtx.RLock()
+	defer iso.appendMtx.RUnlock()
+	return h.isolationLowWatermarkLocked()
+}
+
+func (h *Head) isolationLowWatermarkLocked() uint64 {
+	iso := h.isolationMirror
+	if iso == nil || iso.disabled {
+		return 0
+	}
+	iso.readMtx.RLock()
+	defer iso.readMtx.RUnlock()
+	if iso.readsOpen.prev != iso.readsOpen {
+		return iso.readsOpen.prev.lowWatermark
+	}
+	return iso.appendsOpenList.next.appendID
+}
+
+func (h *Head) isolationLowestAppendTime() int64 {
+	iso := h.isolationMirror
+	if iso == nil {
+		return math.MaxInt64
+	}
+	lowest := int64(math.MaxInt64)
+	iso.appendMtx.RLock()
+	defer iso.appendMtx.RUnlock()
+	for a := iso.appendsOpenList.next; a != iso.appendsOpenList; a = a.next {
+		if lowest > a.minTime {
+			lowest = a.minTime
+		}
+	}
+	return lowest
+}
+
+func (h *Head) isolationReadState(mint, maxt int64) *isolationState {
+	iso := h.isolationMirror
+	if iso == nil {
+		return &isolationState{mint: mint, maxt: maxt}
+	}
+	iso.appendMtx.RLock()
+	defer iso.appendMtx.RUnlock()
+	isoState := &isolationState{
+		maxAppendID:       iso.appendsOpenList.appendID,
+		lowWatermark:      iso.appendsOpenList.next.appendID,
+		incompleteAppends: make(map[uint64]struct{}, len(iso.appendsOpen)),
+		isolation:         iso,
+		mint:              mint,
+		maxt:              maxt,
+	}
+	for k := range iso.appendsOpen {
+		isoState.incompleteAppends[k] = struct{}{}
+	}
+	iso.readMtx.Lock()
+	defer iso.readMtx.Unlock()
+	isoState.prev = iso.readsOpen
+	isoState.next = iso.readsOpen.next
+	iso.readsOpen.next.prev = isoState
+	iso.readsOpen.next = isoState
+	return isoState
+}
+
+func (h *Head) isolationTraverseOpenReads(f func(s *isolationState) bool) {
+	iso := h.isolationMirror
+	if iso == nil || f == nil {
+		return
+	}
+	iso.readMtx.RLock()
+	defer iso.readMtx.RUnlock()
+	s := iso.readsOpen.next
+	for s != iso.readsOpen {
+		if !f(s) {
+			return
+		}
+		s = s.next
+	}
+}
+
+func (h *Head) isolationNewAppendID(minTime int64) (uint64, uint64) {
+	iso := h.isolationMirror
+	if iso == nil || iso.disabled {
+		return 0, 0
+	}
+	iso.appendMtx.Lock()
+	defer iso.appendMtx.Unlock()
+	iso.appendsOpenList.appendID++
+	app := iso.appendersPool.Get().(*isolationAppender)
+	app.appendID = iso.appendsOpenList.appendID
+	app.minTime = minTime
+	app.prev = iso.appendsOpenList.prev
+	app.next = iso.appendsOpenList
+	iso.appendsOpenList.prev.next = app
+	iso.appendsOpenList.prev = app
+	iso.appendsOpen[app.appendID] = app
+	return app.appendID, h.isolationLowWatermarkLocked()
+}
+
+func (h *Head) isolationLastAppendID() uint64 {
+	iso := h.isolationMirror
+	if iso == nil || iso.disabled {
+		return 0
+	}
+	iso.appendMtx.RLock()
+	defer iso.appendMtx.RUnlock()
+	return iso.appendsOpenList.appendID
+}
+
+func (h *Head) isolationCloseAppend(appendID uint64) {
+	iso := h.isolationMirror
+	if iso == nil || iso.disabled {
+		return
+	}
+	iso.appendMtx.Lock()
+	defer iso.appendMtx.Unlock()
+	app := iso.appendsOpen[appendID]
+	if app == nil {
+		return
+	}
+	app.prev.next = app.next
+	app.next.prev = app.prev
+	delete(iso.appendsOpen, appendID)
+	*app = isolationAppender{}
+	iso.appendersPool.Put(app)
+}
