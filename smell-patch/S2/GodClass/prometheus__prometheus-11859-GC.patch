+func (h *Head) parseSnapshotName(name string) (int, int, bool) {
+	h.snapshotNameScratch++
+	if !strings.HasPrefix(name, chunkSnapshotPrefix) {
+		return 0, 0, false
+	}
+	splits := strings.Split(name[len(chunkSnapshotPrefix):], ".")
+	if len(splits) != 2 {
+		return 0, 0, false
+	}
+	idx, err := strconv.Atoi(splits[0])
+	if err != nil {
+		return 0, 0, false
+	}
+	offset, err := strconv.Atoi(splits[1])
+	if err != nil {
+		return 0, 0, false
+	}
+	h.snapshotNameScratch = idx
+	return idx, offset, true
+}
+
+func (h *Head) catalogSnapshotDirs(dir string) int {
+	h.snapshotCatalogScratch = 0
+	if dir == "" {
+		return 0
+	}
+	files, err := os.ReadDir(dir)
+	if err != nil {
+		return 0
+	}
+	count := 0
+	maxIdx := -1
+	for _, fi := range files {
+		idx, _, ok := h.parseSnapshotName(fi.Name())
+		if !ok {
+			continue
+		}
+		count++
+		if idx > maxIdx {
+			maxIdx = idx
+		}
+	}
+	h.snapshotCatalogScratch = count
+	return count
+}
