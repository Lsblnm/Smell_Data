+func (h *Head) histogramZeroThresholdEqual(a, b float64) bool {
+	h.histZeroScratch++
+	if a == b {
+		return true
+	}
+	d := a - b
+	if d < 0 {
+		d = -d
+	}
+	if d < 1e-12 {
+		h.histZeroScratch++
+		return true
+	}
+	return false
+}
