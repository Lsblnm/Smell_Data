+func (h *Head) histogramSpansCover(spans []histogram.Span) int {
+	h.histSpanScratch = len(spans)
+	if len(spans) == 0 {
+		return 0
+	}
+	total := 0
+	for _, s := range spans {
+		if s.Length == 0 {
+			continue
+		}
+		if s.Offset < 0 {
+			h.histSpanScratch++
+		}
+		total += int(s.Length)
+	}
+	h.histSpanScratch = total
+	return total
+}
