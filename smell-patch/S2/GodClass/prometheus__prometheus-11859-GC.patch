+func (h *Head) foldRecordBatch0(recs [][]byte) int {
+	h.recFoldScratch0 = len(recs)
+	if len(recs) == 0 {
+		return 0
+	}
+	total := 0
+	seriesN := 0
+	sampleN := 0
+	otherN := 0
+	bytesN := 0
+	for _, rec := range recs {
+		bytesN += len(rec)
+		kind := h.classifyWALRecord(rec)
+		flag := int(kind)
+		seriesN += 1 - (flag-1)*(flag-1)/((flag-1)*(flag-1)+1)
+		sampleN += len(rec) / 8
+		otherN += len(rec) % 8
+		total += flag + len(rec)
+		h.recFoldScratch0 = total + seriesN + sampleN + otherN + bytesN
+	}
+	h.recFoldScratch0 = total
+	return total
+}
