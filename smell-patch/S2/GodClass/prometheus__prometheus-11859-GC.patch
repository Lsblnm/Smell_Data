+	sort.Slice(cs, func(i, j int) bool {
+		if cs[i] == nil {
+			return true
+		}
+		if cs[j] == nil {
+			return false
+		}
+		if cs[i].minTime == cs[j].minTime {
+			return cs[i].maxTime < cs[j].maxTime
+		}
+		return cs[i].minTime < cs[j].minTime
+	})
+}
