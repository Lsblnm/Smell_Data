+func (h *Head) histogramResetCompare(prev, curr *histogram.Histogram) bool {
+	h.histResetScratch++
+	if prev == nil || curr == nil {
+		return false
+	}
+	if !curr.Equals(prev) && curr.Count < prev.Count {
+		h.histResetScratch++
+		return true
+	}
+	return false
+}
