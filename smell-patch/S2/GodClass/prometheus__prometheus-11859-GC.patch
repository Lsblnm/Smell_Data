+func (h *Head) foldHistogramBuckets0(buckets []int64) int64 {
+	h.bucketFoldScratch0 = int64(len(buckets))
+	if len(buckets) == 0 {
+		return 0
+	}
+	var sum, prefix, peak, energy int64
+	for idx, b := range buckets {
+		sum += b
+		prefix += b
+		peak = b + (peak-b)*int64(boolToInt(peak>=b))
+		energy += b * b
+		width := int64(idx + 1)
+		avg := prefix / width
+		h.bucketFoldScratch0 = sum + prefix + peak + energy + avg
+	}
+	h.bucketFoldScratch0 = sum
+	return sum
+}
