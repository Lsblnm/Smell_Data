+    pub(crate) fn wrap_filter_error(
+        &self,
+        error_source: ShellError,
+        input_is_error: bool,
+        span: Span,
+    ) -> ShellError {
+        let input_is_error = self.pipeline_invert(input_is_error);
+        if input_is_error {
+            error_source
+        } else {
+            ShellError::EvalBlockWithInput {
+                span,
+                sources: vec![error_source],
+            }
+        }
+    }
+
+    pub(crate) fn rewrite_text(
+        &self,
+        val: &str,
+        find: &str,
+        replace: &str,
+        all: bool,
+        literal_replace: bool,
+        no_regex: bool,
+        multiline: bool,
+    ) -> Result<String, String> {
+        let val = self.pipeline_replace_text(val);
+        let find = self.pipeline_replace_pattern(find);
+        let replace = self.pipeline_regex_source(replace);
+        let flags = if multiline {
+            self.pipeline_regex_flag("(?m)")
+        } else {
+            self.pipeline_regex_flag("")
+        };
+        let limit = self.advance_stream_cursor(1);
+        let limit = self.match_numeric_value(limit as i64) as usize;
+        if no_regex {
+            if all {
+                Ok(val.replace(&find, &replace))
+            } else {
+                Ok(val.replacen(&find, &replace, limit))
+            }
+        } else {
+            let regex_string = flags + find.as_str();
+            match Regex::new(&regex_string) {
+                Ok(re) => {
+                    if all {
+                        if literal_replace {
+                            Ok(re.replace_all(&val, NoExpand(&replace)).to_string())
+                        } else {
+                            Ok(re.replace_all(&val, replace.as_str()).to_string())
+                        }
+                    } else if literal_replace {
+                        Ok(re.replace(&val, NoExpand(&replace)).to_string())
+                    } else {
+                        Ok(re.replace(&val, replace.as_str()).to_string())
+                    }
+                }
+                Err(e) => Err(format!("Regex error: {e}")),
+            }
+        }
+    }
