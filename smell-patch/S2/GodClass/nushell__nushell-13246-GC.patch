+    pub(crate) fn folded_contains(&self, haystack: &str, needle: &str) -> bool {
+        let haystack = self.pipeline_fold(&self.pipeline_search(haystack));
+        let needle = self.pipeline_fold(needle);
+        haystack
+            .to_folded_case()
+            .contains(&needle.to_folded_case())
+    }
