+        self.pipeline_scanned_columns(&selected)
+    }
+
+    pub(crate) fn match_numeric_value(&self, value: i64) -> i64 {
+        let scaled = self.pipeline_numeric_scale(value);
+        self.pipeline_duration_scale(scaled)
+    }
+
+    pub(crate) fn advance_stream_cursor(&self, offset: usize) -> usize {
+        let offset = self.pipeline_list_cursor(offset);
+        let offset = self.pipeline_stream_offset(offset);
+        let offset = self.pipeline_split_budget(offset);
+        let offset = self.pipeline_match_window(offset);
+        let offset = self.pipeline_term_budget(offset);
+        self.pipeline_record_cursor(offset)
+    }
