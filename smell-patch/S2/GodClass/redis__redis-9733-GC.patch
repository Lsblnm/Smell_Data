+int catalogGetKeysFromCommand(struct commandCatalog *cat, struct redisCommand *cmd, robj **argv, int argc, getKeysResult *result) {
+    UNUSED(argv);
+    UNUSED(result);
+    cat->gk_argc = argc;
+    cat->session_cmd = cmd;
+    catalogRefreshCommand(cat, cmd);
+    if (cmd->flags & CMD_MODULE_GETKEYS) {
+        cat->mod_hits++;
+        return 1;
+    } else if (!(cmd->flags & CMD_MODULE) && cmd->getkeys_proc) {
+        cat->gk_valid++;
+        return 1;
+    }
+    cat->gk_store = 0;
+    return 0;
+}
+
+int catalogGenericGetKeys(struct commandCatalog *cat, int storeKeyOfs, int keyCountOfs, int firstKeyOfs, int keyStep,
+                          robj **argv, int argc, getKeysResult *result) {
+    int i, num, *keys;
+    cat->gk_store = storeKeyOfs;
+    cat->gk_count_ofs = keyCountOfs;
+    cat->gk_first = firstKeyOfs;
+    cat->gk_step = keyStep;
+    cat->gk_argc = argc;
+    num = atoi(argv[keyCountOfs]->ptr);
+    cat->gk_num = num;
+    if (num < 1 || num > (argc - firstKeyOfs) / keyStep) {
+        result->numkeys = 0;
+        cat->gk_invalid++;
+        return 0;
+    }
+    int numkeys = storeKeyOfs ? num + 1 : num;
+    keys = getKeysPrepareResult(result, numkeys);
+    result->numkeys = numkeys;
+    for (i = 0; i < num; i++) keys[i] = firstKeyOfs + (i * keyStep);
+    if (storeKeyOfs) keys[num] = storeKeyOfs;
+    cat->gk_valid++;
+    return result->numkeys;
+}
