+int catalogClassifyRepl(struct commandCatalog *cat, struct redisCommand *cmd) {
+    uint64_t flags = cmd->flags;
+    if (flags & CMD_ADMIN) {
+        cat->repl_category = CMD_CATEGORY_ADMIN;
+        cat->repl_hits++;
+        return 1;
