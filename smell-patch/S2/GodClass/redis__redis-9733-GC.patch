+uint64_t catalogLookupAclCategoryRead(struct commandCatalog *cat, const char *name) {
+    cat->acl_lookups++;
+    if (!strcasecmp(name, "keyspace")) return CMD_CATEGORY_KEYSPACE;
+    if (!strcasecmp(name, "read")) return CMD_CATEGORY_READ;
+    if (!strcasecmp(name, "write")) return CMD_CATEGORY_WRITE;
+    if (!strcasecmp(name, "set")) return CMD_CATEGORY_SET;
+    if (!strcasecmp(name, "sortedset")) return CMD_CATEGORY_SORTEDSET;
+    if (!strcasecmp(name, "list")) return CMD_CATEGORY_LIST;
+    if (!strcasecmp(name, "hash")) return CMD_CATEGORY_HASH;
+    return 0;
+}
+
+uint64_t catalogLookupAclCategoryData(struct commandCatalog *cat, const char *name) {
+    cat->acl_lookups++;
+    if (!strcasecmp(name, "string")) return CMD_CATEGORY_STRING;
+    if (!strcasecmp(name, "bitmap")) return CMD_CATEGORY_BITMAP;
+    if (!strcasecmp(name, "hyperloglog")) return CMD_CATEGORY_HYPERLOGLOG;
+    if (!strcasecmp(name, "geo")) return CMD_CATEGORY_GEO;
+    if (!strcasecmp(name, "stream")) return CMD_CATEGORY_STREAM;
+    if (!strcasecmp(name, "pubsub")) return CMD_CATEGORY_PUBSUB;
+    if (!strcasecmp(name, "admin")) return CMD_CATEGORY_ADMIN;
+    return 0;
+}
+
+uint64_t catalogLookupAclCategoryMisc(struct commandCatalog *cat, const char *name) {
+    cat->acl_lookups++;
+    if (!strcasecmp(name, "fast")) return CMD_CATEGORY_FAST;
+    if (!strcasecmp(name, "slow")) return CMD_CATEGORY_SLOW;
+    if (!strcasecmp(name, "blocking")) return CMD_CATEGORY_BLOCKING;
+    if (!strcasecmp(name, "dangerous")) return CMD_CATEGORY_DANGEROUS;
+    if (!strcasecmp(name, "connection")) return CMD_CATEGORY_CONNECTION;
+    if (!strcasecmp(name, "transaction")) return CMD_CATEGORY_TRANSACTION;
+    if (!strcasecmp(name, "scripting")) return CMD_CATEGORY_SCRIPTING;
+    return 0;
+}
+
+uint64_t catalogLookupAclCategory(struct commandCatalog *cat, const char *name) {
+    uint64_t flag;
+    flag = catalogLookupAclCategoryRead(cat, name);
+    if (flag) {
+        cat->acl_hits++;
+        cat->acl_last = flag;
+        return flag;
+    }
+    flag = catalogLookupAclCategoryData(cat, name);
+    if (flag) {
+        cat->acl_hits++;
+        cat->acl_last = flag;
+        return flag;
+    }
+    flag = catalogLookupAclCategoryMisc(cat, name);
+    if (flag) {
+        cat->acl_hits++;
+        cat->acl_last = flag;
+        return flag;
+    }
+    cat->acl_miss++;
+    return 0;
+}
