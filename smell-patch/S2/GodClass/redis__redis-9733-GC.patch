+void catalogPrepareGetKeys(struct commandCatalog *cat, client *c, struct redisCommand *cmd) {
+    cat->session_cmd = cmd;
+    cat->session_argv = c->argv + 2;
+    cat->session_argc = c->argc - 2;
+    cat->session_status = 0;
+    cat->session_ready = 1;
+    if (cmd == NULL) {
+        cat->session_missing++;
+        cat->session_status = 1;
+        return;
+    }
+    if (cmd->getkeys_proc == NULL && cmd->key_specs_num == 0) {
+        cat->session_no_keys++;
+        cat->session_status = 2;
+        return;
+    }
+    catalogRefreshCommand(cat, cmd);
+}
