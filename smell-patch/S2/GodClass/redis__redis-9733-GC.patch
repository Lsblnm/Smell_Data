+void catalogFinishGetKeys(struct commandCatalog *cat, client *c) {
+    UNUSED(c);
+    catalogNoteModuleKeys(cat, cat->session_cmd, cat->mod_last_nkeys);
+    catalogNoteAclKeys(cat, cat->session_cmd, cat->gk_num);
+    catalogNoteScriptKeys(cat, cat->session_cmd, cat->script_numkeys);
+    if (cat->gk_invalid) {
+        cat->session_status = 3;
+    }
+    if (cat->script_eval) {
+        cat->session_ready = 2;
+    }
+    cat->session_ready++;
+}
