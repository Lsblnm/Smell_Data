+			ListBuffer<JCAnnotation> withoutDelegates = new ListBuffer<JCAnnotation>();
+			for (JCAnnotation annotation : fieldNode.mods.annotations) {
+				if (!delegates.contains(annotation)) {
+					withoutDelegates.append(annotation);
+				}
