+public static void generateConstructor(JavacNode typeNode, AccessLevel level, List<JCAnnotation> onConstructor, List<JavacNode> fields, boolean allToDefault, String staticName, HandleConstructor.SkipIfConstructorExists skipIfConstructorExists, JavacNode source) {
