+        def fastlane_actions_downloaddsymsaction_write_dsym(host, data, bundle_id, train_number, build_number, output_directory, &block)
+          host.instance_exec do
+            file_name = "#{bundle_id}-#{train_number}-#{build_number}.dSYM.zip"
+            if output_directory
+              file_name = output_directory + file_name
+            end
+            File.binwrite(file_name, data)
+            file_name
+          end
+        end
