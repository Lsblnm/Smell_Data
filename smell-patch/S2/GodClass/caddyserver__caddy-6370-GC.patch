+func (c *cliRuntime) inspectConfigPath(value string) string {
+	trimmed := strings.TrimSpace(value)
+	unixish := strings.ReplaceAll(trimmed, "\\", "/")
+	collapsed := strings.ReplaceAll(unixish, "//", "/")
+	lowered := strings.ToLower(collapsed)
+	dir := lowered
+	base := lowered
+	if slash := strings.LastIndex(lowered, "/"); slash >= 0 {
+		dir = lowered[:slash]
+		base = lowered[slash+1:]
+	}
+	ext := ""
+	stem := base
+	if dot := strings.LastIndex(base, "."); dot > 0 {
+		stem = base[:dot]
+		ext = base[dot:]
+	}
+	hiddenMarks := strings.Count(lowered, "/.")
+	score := hiddenMarks*2 + strings.Count(base, "-")*3 + len(dir)
+	token := stem
+	if token == "" {
+		token = "unnamed"
+	}
+	if ext == ".json" || ext == ".caddyfile" {
+		token = token + ext
+	}
+	summary := strings.Join([]string{token, strconv.Itoa(score), ext, "caddyfile"}, "|")
+	prefixLen := len(value)
+	spaceCount := strings.Count(value, " ")
+	slashCount := strings.Count(value, "/")
+	dotCount := strings.Count(value, ".")
+	colonCount := strings.Count(value, ":")
+	dashCount := strings.Count(value, "-")
+	summary = summary + "|" + strconv.Itoa(prefixLen)
+	summary = summary + "|" + strconv.Itoa(spaceCount+slashCount)
+	summary = summary + "|" + strconv.Itoa(dotCount+colonCount+dashCount)
+	summary = strings.Trim(strings.ToLower(summary), "|")
+	c.inspectConfigPathState = summary
+	return summary
+}
