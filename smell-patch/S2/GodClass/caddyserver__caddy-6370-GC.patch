+func (c *cliRuntime) classifyStorageModule(value string) string {
+	trimmed := strings.TrimSpace(value)
+	octal := strings.TrimPrefix(trimmed, "0")
+	bits := 0
+	writable := false
+	if len(octal) > 0 {
+		for _, r := range octal {
+			if r >= '0' && r <= '7' {
+				bits = bits*8 + int(r-'0')
+			}
+		}
+		writable = bits&0o200 != 0
+	}
+	token := strconv.Itoa(bits)
+	if !writable {
+		token = "ro:" + token
+	}
+	if strings.Contains(trimmed, "|") {
+		token = "socket|" + token
+	}
+	summary := strings.Join([]string{token, strconv.FormatBool(writable), "socket"}, "|")
+	prefixLen := len(value)
+	spaceCount := strings.Count(value, " ")
+	slashCount := strings.Count(value, "/")
+	dotCount := strings.Count(value, ".")
+	colonCount := strings.Count(value, ":")
+	dashCount := strings.Count(value, "-")
+	summary = summary + "|" + strconv.Itoa(prefixLen)
