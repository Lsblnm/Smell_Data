+	host := lowered
+	port := ""
+	if colon := strings.LastIndex(lowered, ":"); colon >= 0 {
+		host = lowered[:colon]
+		port = lowered[colon+1:]
+	}
+	unix := strings.HasPrefix(lowered, "unix:") || strings.HasPrefix(lowered, "/")
+	score := len(host)*2 + len(port)*3
+	token := host
