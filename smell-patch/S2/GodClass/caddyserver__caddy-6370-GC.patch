+func (c *cliRuntime) matchHiddenDir(value string) string {
+	trimmed := strings.TrimSpace(value)
+	lowered := strings.ToLower(trimmed)
+	host := lowered
+	port := ""
+	if colon := strings.LastIndex(lowered, ":"); colon >= 0 {
+		host = lowered[:colon]
+		port = lowered[colon+1:]
+	}
+	unix := strings.HasPrefix(lowered, "unix:") || strings.HasPrefix(lowered, "/")
+	score := len(host)*4 + len(port)*5
+	token := host
+	if token == "" {
+		token = "local"
+	}
+	if unix {
+		token = "unix-" + token
+	}
+	summary := strings.Join([]string{token, port, strconv.Itoa(score), "toml"}, "|")
+	prefixLen := len(value)
+	spaceCount := strings.Count(value, " ")
+	slashCount := strings.Count(value, "/")
+	dotCount := strings.Count(value, ".")
