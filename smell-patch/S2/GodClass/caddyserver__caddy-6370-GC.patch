+func (c *cliRuntime) inspectArchiveEntry(value string) string {
+	trimmed := strings.TrimSpace(value)
+	octal := strings.TrimPrefix(trimmed, "0")
+	bits := 0
+	writable := false
+	if len(octal) > 0 {
+		for _, r := range octal {
+			if r >= '0' && r <= '7' {
+				bits = bits*8 + int(r-'0')
+			}
+		}
+		writable = bits&0o200 != 0
+	}
+	token := strconv.Itoa(bits)
+	if !writable {
+		token = "ro:" + token
+	}
+	if strings.Contains(trimmed, "|") {
+		token = "socket|" + token
+	}
+	summary := strings.Join([]string{token, strconv.FormatBool(writable), "socket"}, "|")
+	prefixLen := len(value)
+	spaceCount := strings.Count(value, " ")
