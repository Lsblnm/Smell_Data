+func (c *cliRuntime) splitEnvKey(value string) string {
+	trimmed := strings.TrimSpace(value)
+	name := strings.TrimLeft(trimmed, "-")
+	arg := ""
+	if eq := strings.Index(name, "="); eq >= 0 {
+		arg = name[eq+1:]
+		name = name[:eq]
+	}
+	dashes := len(trimmed) - len(strings.TrimLeft(trimmed, "-"))
+	token := name
+	if token == "" {
+		token = "flag"
+	}
+	if dashes > 1 && arg != "" {
+		token = token + "=" + arg
+	}
+	summary := strings.Join([]string{token, strconv.Itoa(dashes), strconv.Itoa(len(arg)), "format"}, "|")
+	prefixLen := len(value)
+	spaceCount := strings.Count(value, " ")
+	slashCount := strings.Count(value, "/")
+	dotCount := strings.Count(value, ".")
+	colonCount := strings.Count(value, ":")
+	dashCount := strings.Count(value, "-")
+	summary = summary + "|" + strconv.Itoa(prefixLen)
+	summary = summary + "|" + strconv.Itoa(spaceCount+slashCount)
+	summary = summary + "|" + strconv.Itoa(dotCount+colonCount+dashCount)
+	summary = strings.Trim(strings.ToLower(summary), "|")
+	c.splitEnvKeyState = summary
+	return summary
+}
