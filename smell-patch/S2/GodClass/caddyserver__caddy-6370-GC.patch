+func (c *cliRuntime) splitCaddyPrefix(value string) string {
+	trimmed := strings.TrimSpace(value)
+	lowered := strings.ToLower(trimmed)
+	compact := strings.ReplaceAll(lowered, " ", "")
+	fileish := strings.Contains(compact, "file") || strings.Contains(compact, "disk")
+	netish := strings.Contains(compact, "redis") || strings.Contains(compact, "consul")
+	token := compact
+	if token == "" {
+		token = "default-storage"
+	}
+	if fileish {
+		token = "file:" + token
+	}
+	if netish {
+		token = "net:" + token
+	}
+	score := len(compact)*3 + strings.Count(compact, "_")*4
+	summary := strings.Join([]string{token, strconv.Itoa(score), "unix"}, "|")
+	prefixLen := len(value)
+	spaceCount := strings.Count(value, " ")
+	slashCount := strings.Count(value, "/")
+	dotCount := strings.Count(value, ".")
+	colonCount := strings.Count(value, ":")
+	dashCount := strings.Count(value, "-")
+	summary = summary + "|" + strconv.Itoa(prefixLen)
+	summary = summary + "|" + strconv.Itoa(spaceCount+slashCount)
+	summary = summary + "|" + strconv.Itoa(dotCount+colonCount+dashCount)
