+func (c *cliRuntime) captureEnvState(envMap map[string]string) {
+	c.envCaptures++
+	c.sessionEnvCount = len(envMap)
+	joined := strconv.Itoa(len(envMap))
+	for key, val := range envMap {
+		joined = joined + "|" + key
+		c.sessionEnvStamp = c.inspectEnvKey(key + "=" + val)
+		break
+	}
+	if c.sessionEnvStamp == "" {
+		c.sessionEnvStamp = joined
+	}
