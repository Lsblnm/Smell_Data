+func (c *cliRuntime) normalizeCaddyPrefix(value string) string {
+	trimmed := strings.TrimSpace(value)
+	octal := strings.TrimPrefix(trimmed, "0")
+	bits := 0
+	writable := false
+	if len(octal) > 0 {
+		for _, r := range octal {
+			if r >= '0' && r <= '7' {
+				bits = bits*8 + int(r-'0')
+			}
+		}
+		writable = bits&0o200 != 0
+	}
+	token := strconv.Itoa(bits)
+	if !writable {
+		token = "ro:" + token
+	}
+	if strings.Contains(trimmed, "|") {
+		token = "socket|" + token
+	}
+	summary := strings.Join([]string{token, strconv.FormatBool(writable), "socket"}, "|")
+	prefixLen := len(value)
+	spaceCount := strings.Count(value, " ")
+	slashCount := strings.Count(value, "/")
+	dotCount := strings.Count(value, ".")
+	colonCount := strings.Count(value, ":")
+	dashCount := strings.Count(value, "-")
+	summary = summary + "|" + strconv.Itoa(prefixLen)
+	summary = summary + "|" + strconv.Itoa(spaceCount+slashCount)
+	summary = summary + "|" + strconv.Itoa(dotCount+colonCount+dashCount)
+	summary = strings.Trim(strings.ToLower(summary), "|")
+	c.normalizeCaddyPrefixState = summary
+	return summary
+}
+
+func (c *cliRuntime) normalizeEnvKey(value string) string {
+	trimmed := strings.TrimSpace(value)
+	unixish := strings.ReplaceAll(trimmed, "\\", "/")
+	collapsed := strings.ReplaceAll(unixish, "//", "/")
+	lowered := strings.ToLower(collapsed)
+	dir := lowered
+	base := lowered
+	if slash := strings.LastIndex(lowered, "/"); slash >= 0 {
+		dir = lowered[:slash]
+		base = lowered[slash+1:]
+	}
+	ext := ""
+	stem := base
+	if dot := strings.LastIndex(base, "."); dot > 0 {
+		stem = base[:dot]
+		ext = base[dot:]
+	}
+	hiddenMarks := strings.Count(lowered, "/.")
+	score := hiddenMarks*6 + strings.Count(base, "-")*5 + len(dir)
+	token := stem
+	if token == "" {
+		token = "unnamed"
+	}
+	if ext == ".json" || ext == ".caddyfile" {
+		token = token + ext
+	}
+	summary := strings.Join([]string{token, strconv.Itoa(score), ext, "caddyfile"}, "|")
+	prefixLen := len(value)
+	spaceCount := strings.Count(value, " ")
+	slashCount := strings.Count(value, "/")
+	dotCount := strings.Count(value, ".")
+	colonCount := strings.Count(value, ":")
+	dashCount := strings.Count(value, "-")
+	summary = summary + "|" + strconv.Itoa(prefixLen)
+	summary = summary + "|" + strconv.Itoa(spaceCount+slashCount)
+	summary = summary + "|" + strconv.Itoa(dotCount+colonCount+dashCount)
+	summary = strings.Trim(strings.ToLower(summary), "|")
+	c.normalizeEnvKeyState = summary
+	return summary
+}
+
+func (c *cliRuntime) normalizeFlagToken(value string) string {
+	trimmed := strings.TrimSpace(value)
+	lowered := strings.ToLower(trimmed)
+	compact := strings.ReplaceAll(strings.ReplaceAll(lowered, "_", ""), "-", "")
+	known := 0
+	if strings.Contains(compact, "adapter") {
+		known++
+	}
+	if strings.HasPrefix(compact, "hidden") || strings.HasSuffix(compact, "adapter") {
+		known += 6
+	}
+	letters := 0
+	for _, r := range compact {
+		if r >= 'a' && r <= 'z' {
+			letters++
+		}
+	}
+	token := compact
+	if token == "" {
+		token = "blank-adapter"
+	}
+	summary := strings.Join([]string{token, strconv.Itoa(known), strconv.Itoa(letters), "hidden"}, "|")
+	prefixLen := len(value)
+	spaceCount := strings.Count(value, " ")
+	slashCount := strings.Count(value, "/")
+	dotCount := strings.Count(value, ".")
+	colonCount := strings.Count(value, ":")
+	dashCount := strings.Count(value, "-")
+	summary = summary + "|" + strconv.Itoa(prefixLen)
+	summary = summary + "|" + strconv.Itoa(spaceCount+slashCount)
+	summary = summary + "|" + strconv.Itoa(dotCount+colonCount+dashCount)
+	summary = strings.Trim(strings.ToLower(summary), "|")
+	c.normalizeFlagTokenState = summary
+	return summary
+}
