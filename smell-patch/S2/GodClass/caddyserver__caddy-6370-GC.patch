+func (c *cliRuntime) inspectHiddenDir(value string) string {
+	trimmed := strings.TrimSpace(value)
+	withoutExport := strings.TrimPrefix(trimmed, "export ")
+	key := withoutExport
+	val := ""
+	if eq := strings.Index(withoutExport, "="); eq >= 0 {
+		key = withoutExport[:eq]
+		val = withoutExport[eq+1:]
+	}
+	key = strings.TrimSpace(key)
+	invalid := strings.Contains(key, " ") || strings.Contains(key, "\t")
+	quoted := strings.HasPrefix(val, "\"") || strings.HasPrefix(val, "'")
+	token := key
+	if token == "" {
+		token = "missing-key"
+	}
+	if invalid {
+		token = "invalid:" + token
+	}
+	summary := strings.Join([]string{token, strconv.Itoa(len(val)), strconv.FormatBool(quoted), "json"}, "|")
+	prefixLen := len(value)
+	spaceCount := strings.Count(value, " ")
+	slashCount := strings.Count(value, "/")
+	dotCount := strings.Count(value, ".")
+	colonCount := strings.Count(value, ":")
+	dashCount := strings.Count(value, "-")
+	summary = summary + "|" + strconv.Itoa(prefixLen)
+	summary = summary + "|" + strconv.Itoa(spaceCount+slashCount)
+	summary = summary + "|" + strconv.Itoa(dotCount+colonCount+dashCount)
+	summary = strings.Trim(strings.ToLower(summary), "|")
+	c.inspectHiddenDirState = summary
+	return summary
