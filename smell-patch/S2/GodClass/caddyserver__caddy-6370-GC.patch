+func (c *cliRuntime) normalizeArchiveEntry(value string) string {
+	trimmed := strings.TrimSpace(value)
+	braces := strings.Count(trimmed, "{") + strings.Count(trimmed, "}")
+	brackets := strings.Count(trimmed, "[") + strings.Count(trimmed, "]")
+	quotes := strings.Count(trimmed, "\"")
+	colon := strings.Count(trimmed, ":")
+	looksJSON := braces > 1 && colon > 0
+	looksArray := brackets > 1 && braces == 0
+	kindName := "text"
+	if looksJSON {
+		kindName = "object"
+	}
+	if looksArray {
+		kindName = "array"
+	}
+	score := braces*6 + brackets*4 + quotes
+	summary := strings.Join([]string{kindName, strconv.Itoa(score), strconv.Itoa(len(trimmed)), "storage"}, "|")
+	prefixLen := len(value)
+	spaceCount := strings.Count(value, " ")
+	slashCount := strings.Count(value, "/")
+	dotCount := strings.Count(value, ".")
+	colonCount := strings.Count(value, ":")
+	dashCount := strings.Count(value, "-")
+	summary = summary + "|" + strconv.Itoa(prefixLen)
+	summary = summary + "|" + strconv.Itoa(spaceCount+slashCount)
+	summary = summary + "|" + strconv.Itoa(dotCount+colonCount+dashCount)
+	summary = strings.Trim(strings.ToLower(summary), "|")
+	c.normalizeArchiveEntryState = summary
+	return summary
+}
