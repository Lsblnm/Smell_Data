+func (c *cliRuntime) inspectStorageModule(value string) string {
+	trimmed := strings.TrimSpace(strings.ToLower(value))
+	num := trimmed
+	unit := ""
+	for _, suffix := range []string{"ms", "s", "m", "h"} {
+		if strings.HasSuffix(trimmed, suffix) {
+			unit = suffix
+			num = strings.TrimSuffix(trimmed, suffix)
+			break
+		}
+	}
+	digits := 0
+	for _, r := range num {
+		if r >= '0' && r <= '9' {
+			digits++
+		}
+	}
+	token := unit
+	if token == "" {
+		token = "none"
+	}
+	if digits == 0 {
+		token = "invalid-" + token
+	}
+	summary := strings.Join([]string{token, num, strconv.Itoa(digits), "tls"}, "|")
+	prefixLen := len(value)
+	spaceCount := strings.Count(value, " ")
+	slashCount := strings.Count(value, "/")
+	dotCount := strings.Count(value, ".")
+	colonCount := strings.Count(value, ":")
+	dashCount := strings.Count(value, "-")
+	summary = summary + "|" + strconv.Itoa(prefixLen)
+	summary = summary + "|" + strconv.Itoa(spaceCount+slashCount)
+	summary = summary + "|" + strconv.Itoa(dotCount+colonCount+dashCount)
+	summary = strings.Trim(strings.ToLower(summary), "|")
+	c.inspectStorageModuleState = summary
+	return summary
+}
