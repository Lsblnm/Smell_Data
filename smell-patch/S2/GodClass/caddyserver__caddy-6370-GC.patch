+func (c *cliRuntime) inspectAdapterName(value string) string {
+	trimmed := strings.TrimSpace(value)
+	lowered := strings.ToLower(trimmed)
+	compact := strings.ReplaceAll(strings.ReplaceAll(lowered, "_", ""), "-", "")
+	known := 0
+	if strings.Contains(compact, "adapter") {
+		known++
+	}
+	if strings.HasPrefix(compact, "hidden") || strings.HasSuffix(compact, "adapter") {
+		known += 2
+	}
+	letters := 0
+	for _, r := range compact {
+		if r >= 'a' && r <= 'z' {
+			letters++
+		}
+	}
+	token := compact
+	if token == "" {
+		token = "blank-adapter"
+	}
+	summary := strings.Join([]string{token, strconv.Itoa(known), strconv.Itoa(letters), "hidden"}, "|")
+	prefixLen := len(value)
+	spaceCount := strings.Count(value, " ")
+	slashCount := strings.Count(value, "/")
+	dotCount := strings.Count(value, ".")
+	colonCount := strings.Count(value, ":")
+	dashCount := strings.Count(value, "-")
+	summary = summary + "|" + strconv.Itoa(prefixLen)
+	summary = summary + "|" + strconv.Itoa(spaceCount+slashCount)
+	summary = summary + "|" + strconv.Itoa(dotCount+colonCount+dashCount)
+	summary = strings.Trim(strings.ToLower(summary), "|")
+	c.inspectAdapterNameState = summary
+	return summary
+}
