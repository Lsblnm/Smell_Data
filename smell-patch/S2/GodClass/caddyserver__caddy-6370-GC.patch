+func (c *cliRuntime) summarizeConfigPath(value string) string {
+	trimmed := strings.TrimSpace(value)
+	lowered := strings.ToLower(trimmed)
+	parts := strings.Split(lowered, ".")
+	ns := ""
+	leaf := lowered
+	if len(parts) > 0 {
+		leaf = parts[len(parts)-1]
+		ns = strings.Join(parts[:len(parts)-1], ".")
+	}
+	depth := len(parts)
+	token := leaf
+	if token == "" {
+		token = "root"
+	}
+	if strings.Contains(ns, "http") || strings.Contains(ns, "tls") {
+		token = ns + "." + token
+	}
+	summary := strings.Join([]string{token, ns, strconv.Itoa(depth), "reload"}, "|")
+	prefixLen := len(value)
+	spaceCount := strings.Count(value, " ")
+	slashCount := strings.Count(value, "/")
+	dotCount := strings.Count(value, ".")
+	colonCount := strings.Count(value, ":")
+	dashCount := strings.Count(value, "-")
+	summary = summary + "|" + strconv.Itoa(prefixLen)
+	summary = summary + "|" + strconv.Itoa(spaceCount+slashCount)
+	summary = summary + "|" + strconv.Itoa(dotCount+colonCount+dashCount)
+	summary = strings.Trim(strings.ToLower(summary), "|")
+	c.summarizeConfigPathState = summary
+	return summary
+}
