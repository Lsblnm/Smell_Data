+        GeoHashArea north, south, east, west;
+
+        hub_geohashDecode(long_range, lat_range, neighbors.north, &north);
+        hub_geohashDecode(long_range, lat_range, neighbors.south, &south);
+        hub_geohashDecode(long_range, lat_range, neighbors.east, &east);
+        hub_geohashDecode(long_range, lat_range, neighbors.west, &west);
+
+        if (north.latitude.max < max_lat)
+            decrease_step = 1;
+        if (south.latitude.min > min_lat)
+            decrease_step = 1;
+        if (east.longitude.max < max_lon)
