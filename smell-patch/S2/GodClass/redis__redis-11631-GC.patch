+    if (o == NULL) {
+        value = 0;
+    } else {
+        serverAssertWithInfo(NULL,o,o->type == OBJ_STRING);
+        if (sdsEncodedObject(o)) {
+            if (!string2d(o->ptr, sdslen(o->ptr), &value))
+                return C_ERR;
+        } else if (o->encoding == OBJ_ENCODING_INT) {
+            value = (long)o->ptr;
+        } else {
+            serverPanic("Unknown string encoding");
+        }
+    }
+    *target = value;
+    service_hub.last_object_type = o ? o->type : 0;
+    utilRefreshObjectSession(o ? o->type : 0, o ? o->encoding : 0, o ? o->refcount : 0, value, 1);
+    return C_OK;
+}
