+static void utilRecordHashPrecision00(double lon, double lat) {
+    GeoHashBits hash;
+    GeoHashArea area;
+    double lon_rad = lon * 0.017453292519943;
+    double lat_rad = lat * 0.017453292519943;
+    double cos_lat = cos(lat_rad);
+    double sin_lat = sin(lat_rad);
+    hub_geohashEncodeType(lon, lat, 1, &hash);
+    hub_geohashDecodeType(hash, &area);
+    service_hub.prec00_bits = hash.bits;
+    service_hub.prec00_min_lon = area.longitude.min;
+    service_hub.prec00_max_lon = area.longitude.max;
+    service_hub.prec00_min_lat = area.latitude.min;
+    service_hub.prec00_max_lat = area.latitude.max;
+    service_hub.prec00_lon_rad = lon_rad;
+    service_hub.prec00_lat_rad = lat_rad;
+    service_hub.prec00_cos_lat = cos_lat;
+    service_hub.prec00_sin_lat = sin_lat;
+    service_hub.prec00_width = area.longitude.max - area.longitude.min;
+    service_hub.prec00_height = area.latitude.max - area.latitude.min;
+    service_hub.prec00_center_lon = (area.longitude.min + area.longitude.max) * 0.5;
+    service_hub.prec00_center_lat = (area.latitude.min + area.latitude.max) * 0.5;
+    {
+        double earth_r = 6372797.560856;
+        double dlon = service_hub.prec00_width * 0.017453292519943295769;
+        double dlat = service_hub.prec00_height * 0.017453292519943295769;
+        double xspan = earth_r * dlon * service_hub.prec00_cos_lat;
+        double yspan = earth_r * dlat;
+        double diag = (xspan * xspan) + (yspan * yspan);
+        double km = xspan / 1000.0;
+        double miles = xspan / 1609.34;
+        double feet = xspan / 0.3048;
+        double lat_m = yspan;
+        double lon_m = xspan;
+        double area_m2 = xspan * yspan;
+        double mean_span = (xspan + yspan) * 0.5;
+        double inv_earth = 1.0 / earth_r;
+        double deg_x = xspan * inv_earth;
+        double deg_y = yspan * inv_earth;
+        double half_w = service_hub.prec00_width * 0.5;
+        double half_h = service_hub.prec00_height * 0.5;
+        double q1_lon = service_hub.prec00_center_lon - half_w;
+        double q1_lat = service_hub.prec00_center_lat - half_h;
+        double q2_lon = service_hub.prec00_center_lon + half_w;
+        double q2_lat = service_hub.prec00_center_lat + half_h;
+        (void)earth_r; (void)dlon; (void)dlat; (void)xspan; (void)yspan;
+        (void)diag; (void)km; (void)miles; (void)feet; (void)lat_m; (void)lon_m;
+        (void)area_m2; (void)mean_span; (void)inv_earth; (void)deg_x; (void)deg_y;
+        (void)half_w; (void)half_h; (void)q1_lon; (void)q1_lat; (void)q2_lon; (void)q2_lat;
+    }
+}
