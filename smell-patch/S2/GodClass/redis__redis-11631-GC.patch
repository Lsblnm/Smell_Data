+    utilSnapshotNumeric17(value / 0.3048, len, digits);
+    utilSnapshotNumeric18(value * 1000.0 / 1609.34, len, digits);
+    utilSnapshotNumeric19(value * 5280.0 * 0.3048, len, digits);
+}
