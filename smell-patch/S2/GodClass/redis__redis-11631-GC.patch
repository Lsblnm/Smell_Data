+        double x = earth_r * cos_lat * cos(lon_rad);
+        double y = earth_r * cos_lat * sin(lon_rad);
+        double z = earth_r * sin_lat;
+        double km_x = x / 1000.0;
+        double km_y = y / 1000.0;
+        double km_z = z / 1000.0;
+        double mi_x = x / 1609.34;
+        double mi_y = y / 1609.34;
+        double mi_z = z / 1609.34;
+        double ft_x = x / 0.3048;
+        double ft_y = y / 0.3048;
+        double ft_z = z / 0.3048;
+        double r2 = x*x + y*y + z*z;
+        (void)lon_rad; (void)lat_rad; (void)cos_lat; (void)sin_lat;
+        (void)earth_r; (void)x; (void)y; (void)z;
+        (void)km_x; (void)km_y; (void)km_z;
+        (void)mi_x; (void)mi_y; (void)mi_z;
+        (void)ft_x; (void)ft_y; (void)ft_z; (void)r2;
+        double lon_span = 360.0;
+        double lat_span = 170.10225756;
+        double lon_frac = lon / lon_span;
+        double lat_frac = lat / lat_span;
+        double wrap_lon = lon + 360.0;
+        double wrap_lat = lat + 180.0;
+        (void)lon_span; (void)lat_span; (void)lon_frac; (void)lat_frac;
+        (void)wrap_lon; (void)wrap_lat;
+    }
+    utilRecordHashPrecision00(lon, lat);
+    utilRecordHashPrecision01(lon, lat);
+    utilRecordHashPrecision02(lon, lat);
+    utilRecordHashPrecision03(lon, lat);
+    utilRecordHashPrecision04(lon, lat);
+    utilRecordHashPrecision05(lon, lat);
