+static void utilRefreshObjectSession(int type, int encoding, size_t refcount, double number, int ok) {
+    service_hub.last_object_type = type;
+    service_hub.last_object_encoding = encoding;
+    service_hub.last_object_refcount = refcount;
+    utilSnapshotObject00(type, encoding, refcount, number, ok);
+    utilSnapshotObject01(type, encoding, refcount, number + 1.0, ok);
+    utilSnapshotObject02(type, encoding, refcount, number - 1.0, ok);
+    utilSnapshotObject03(type, encoding, refcount + 1, number, ok);
+    utilSnapshotObject04(type, encoding, refcount, number * 2.0, ok);
+    utilSnapshotObject05(type, encoding, refcount, number / 2.0, ok);
+    utilSnapshotObject06(type + 1, encoding, refcount, number, ok);
+    utilSnapshotObject07(type, encoding + 1, refcount, number, ok);
+    utilSnapshotObject08(type, encoding, refcount, -number, ok);
+    utilSnapshotObject09(type, encoding, refcount, 0.0, ok);
+    utilSnapshotObject10(type, encoding, refcount, 1.0, ok);
+    utilSnapshotObject11(type, encoding, refcount, number, !ok);
+    utilSnapshotObject12(OBJ_STRING, encoding, refcount, number, ok);
+    utilSnapshotObject13(OBJ_ZSET, encoding, refcount, number, ok);
+    utilSnapshotObject14(OBJ_HASH, encoding, refcount, number, ok);
+    utilSnapshotObject15(OBJ_LIST, encoding, refcount, number, ok);
+}
