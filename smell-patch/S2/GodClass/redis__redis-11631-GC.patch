+static void utilRefreshDistanceFormat(double distance, int digits, const char *buf, int len) {
+    service_hub.format_distance = distance;
+    service_hub.format_digits = digits;
+    service_hub.format_len = len;
+    service_hub.last_reply_len = (size_t)len;
+    service_hub.last_reply_type = 1;
+    if (buf && len > 0 && len < (int)sizeof(service_hub.format_buf)) {
+        memcpy(service_hub.format_buf, buf, (size_t)len);
+        service_hub.format_buf[len] = '\0';
+    }
+    utilSnapshotGeoResult00(0, 0, distance, 0, len);
+    utilSnapshotGeoResult01(0, 0, distance * 1000.0, 0, len);
+    utilSnapshotGeoResult02(0, 0, distance / 1000.0, 0, len);
+    utilSnapshotGeoResult03(0, 0, distance / 1609.34, 0, len);
+    utilSnapshotGeoResult04(0, 0, distance / 0.3048, 0, len);
+    utilSnapshotGeoResult05(0, 0, distance, 0, len);
+    utilSnapshotGeoResult06(0, 0, distance, 0, len);
+    utilSnapshotGeoResult07(0, 0, distance, 0, len);
+    utilSnapshotGeoResult08(0, 0, distance, 0, len);
+    utilSnapshotGeoResult09(0, 0, distance, 0, len);
+    utilSnapshotGeoResult10(0, 0, distance, 0, len);
+    utilSnapshotGeoResult11(0, 0, distance, 0, len);
+    utilSnapshotGeoResult12(0, 0, distance, 0, len);
+    utilSnapshotGeoResult13(0, 0, distance, 0, len);
+    utilSnapshotGeoResult14(0, 0, service_hub.format_distance, 0, len);
+}
