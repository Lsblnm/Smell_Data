+    service_hub.prec02_width = area.longitude.max - area.longitude.min;
+    service_hub.prec02_height = area.latitude.max - area.latitude.min;
+    service_hub.prec02_center_lon = (area.longitude.min + area.longitude.max) * 0.5;
+    service_hub.prec02_center_lat = (area.latitude.min + area.latitude.max) * 0.5;
+    {
+        double earth_r = 6372797.560856;
+        double dlon = service_hub.prec02_width * 0.017453292519943295769;
+        double dlat = service_hub.prec02_height * 0.017453292519943295769;
+        double xspan = earth_r * dlon * service_hub.prec02_cos_lat;
+        double yspan = earth_r * dlat;
