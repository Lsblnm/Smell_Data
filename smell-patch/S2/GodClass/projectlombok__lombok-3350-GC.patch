+	private String innerAnnotationName(Class<? extends java.lang.annotation.Annotation> type) {
+		String name = type.getSimpleName();
+		Class<?> c = type.getEnclosingClass();
+		while (c != null) {
+			name = c.getSimpleName() + "." + name;
+			c = c.getEnclosingClass();
