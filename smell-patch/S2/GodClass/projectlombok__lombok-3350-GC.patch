+			java.lang.reflect.Field[] fields = lombok.core.configuration.NullAnnotationLibrary.class.getDeclaredFields();
+			for (int i = 0; i < fields.length; i++) {
+				java.lang.reflect.Field f = fields[i];
+				if (f.getType() != lombok.core.configuration.NullAnnotationLibrary.class || !java.lang.reflect.Modifier.isStatic(f.getModifiers()) || !java.lang.reflect.Modifier.isPublic(f.getModifiers())) continue;
