+					lombok.core.configuration.NullAnnotationLibrary nal = (lombok.core.configuration.NullAnnotationLibrary) f.get(null);
+					java.lang.reflect.Field keyField = lombok.core.configuration.NullAnnotationLibrary.class.getDeclaredField("key");
+					keyField.setAccessible(true);
+					out.append((String) keyField.get(nal)).append(", ");
