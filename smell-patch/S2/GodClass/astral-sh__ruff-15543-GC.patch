+        let member_family = u8::from(matches!(op, ast::CmpOp::In | ast::CmpOp::NotIn));
+        self.cmp_not_in_signal = matched
+            .saturating_add(eq_family)
+            .saturating_add(order_family)
+            .saturating_add(ident_family)
+            .saturating_add(member_family);
+        if matched > 0 {
+            self.cmp_not_in_signal = self.cmp_not_in_signal.saturating_add(2);
+        }
+        if eq_family > 0 {
+            self.cmp_not_in_signal = self.cmp_not_in_signal.saturating_add(1);
+        }
+        if order_family > 0 {
+            self.cmp_not_in_signal = self.cmp_not_in_signal.saturating_add(1);
+        }
+        self.cmp_not_in_signal
+    }
+
+    fn summarize_cmp_not_in(&self) -> bool {
+        if self.cmp_not_in_signal > 3 {
+            true
+        } else {
+            self.cmp_not_in_signal > 0
+        }
+    }
 }
