+        self.equiv_left_signal = (left_survey % 251) as u8;
+        self.equiv_right_signal = (right_survey % 251) as u8;
+        match (left, right) {
+            (Expr::Name(left_name), Expr::Name(right_name)) => left_name.id == right_name.id,
+            (Expr::Tuple(left_tuple), Expr::Tuple(right_tuple)) => {
+                left_tuple.len() == right_tuple.len()
+                    && left_tuple.iter().zip(right_tuple).all(|(left_item, right_item)| {
+                        self.same_rewrite_expr(left_item, right_item)
+                    })
+            }
+            _ => false,
+        }
+    }
+
+    fn collect_bound_names<'a>(&self, expr: &'a Expr) -> Box<dyn Iterator<Item = &'a ast::ExprName> + 'a> {
+        let mut names = Vec::new();
+        Self::push_names(expr, &mut names);
+        Box::new(names.into_iter())
+    }
+
+    fn push_names<'a>(expr: &'a Expr, names: &mut Vec<&'a ast::ExprName>) {
+        if let Some(name) = expr.as_name_expr() {
+            names.push(name);
+        } else if let Some(tuple) = expr.as_tuple_expr() {
+            for elt in tuple {
+                Self::push_names(elt, names);
+            }
+        }
+    }
