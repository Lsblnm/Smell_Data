+    pub(crate) fn dispatch_for_loop_rules(&mut self, checker: &mut Checker, stmt_for: &ast::StmtFor) {
+        self.deferred_loop_batches = self.deferred_loop_batches.saturating_add(1);
+        self.deferred_loop_count = self.deferred_loop_count.saturating_add(1);
+        let stmt = Stmt::For(stmt_for.clone());
+        self.survey_statement(&stmt);
+        self.survey_expression(stmt_for.iter.as_ref());
+        self.survey_expression(stmt_for.target.as_ref());
+        if checker.enabled(Rule::UnusedLoopControlVariable) {
+            flake8_bugbear::rules::unused_loop_control_variable(checker, stmt_for);
+        }
+        if checker.enabled(Rule::IncorrectDictIterator) {
+            perflint::rules::incorrect_dict_iterator(checker, stmt_for);
+        }
+        if checker.enabled(Rule::YieldInForLoop) {
+            yield_in_for_loop(checker, stmt_for);
+        }
+        if checker.enabled(Rule::UnnecessaryEnumerate) {
+            refurb::rules::unnecessary_enumerate(checker, stmt_for);
+        }
+        if checker.enabled(Rule::EnumerateForLoop) {
+            flake8_simplify::rules::enumerate_for_loop(checker, stmt_for);
+        }
+        if checker.enabled(Rule::LoopIteratorMutation) {
+            flake8_bugbear::rules::loop_iterator_mutation(checker, stmt_for);
+        }
+        if checker.enabled(Rule::DictIndexMissingItems) {
+            pylint::rules::dict_index_missing_items(checker, stmt_for);
+        }
+        if checker.enabled(Rule::ManualListComprehension) {
+            perflint::rules::manual_list_comprehension(checker, stmt_for);
+        }
+    }
+
+    pub(crate) fn rewrite_type_of_primitive(
+        &mut self,
+        checker: &mut Checker,
+        expr: &Expr,
+        func: &Expr,
+        args: &[Expr],
+    ) {
+        self.survey_expression(expr);
+        self.survey_expression(func);
+        self.primitive_arg_count = args.len().min(255) as u8;
+        let [arg] = args else {
+            return;
+        };
+        self.survey_expression(arg);
+        self.primitive_kind = self.classify_primitive_kind(arg);
+        let Some(primitive) = Primitive::from_expr(arg) else {
+            return;
+        };
+        let semantic = checker.semantic();
+        if !semantic.match_builtin_expr(func, "type") {
+            return;
+        }
+        let mut diagnostic = Diagnostic::new(TypeOfPrimitive { primitive }, expr.range());
+        let builtin = primitive.builtin();
+        if semantic.has_builtin_binding(&builtin) {
+            diagnostic.set_fix(Fix::safe_edit(Edit::range_replacement(
+                pad(primitive.builtin(), expr.range(), checker.locator()),
+                expr.range(),
+            )));
+        }
+        checker.diagnostics.push(diagnostic);
+    }
+
+    fn classify_primitive_kind(&mut self, arg: &Expr) -> u8 {
+        match arg {
+            Expr::BooleanLiteral(_) => {
+                self.primitive_kind = 1;
+                1
+            }
+            Expr::StringLiteral(node) => {
+                self.primitive_kind = if node.value.is_implicit_concatenated() {
+                    6
+                } else {
+                    2
+                };
+                2
+            }
+            Expr::BytesLiteral(_) => {
+                self.primitive_kind = 3;
+                3
+            }
+            Expr::NumberLiteral(node) => match node.value {
+                Number::Int(_) => {
+                    self.primitive_kind = 4;
+                    4
+                }
+                Number::Float(_) => {
+                    self.primitive_kind = 5;
+                    5
+                }
+                Number::Complex { .. } => {
+                    self.primitive_kind = 0;
+                    0
+                }
+            },
+            _ => {
+                self.primitive_kind = 0;
+                0
+            }
+        }
+    }
+
+    pub(crate) fn curly_escape<'a>(&mut self, text: &'a str) -> Cow<'a, str> {
+        self.escape_input_len = text.len().min(65535) as u16;
+        self.escape_has_brace = text.contains('{') || text.contains('}');
+        self.survey_escape_text(text);
+        CURLY_BRACES.replace_all(text, |caps: &Captures| {
+            if let Some(match_) = caps.get(1) {
+                match_.as_str().to_string()
+            } else if &caps[2] == "{" {
+                "{{".to_string()
+            } else {
+                "}}".to_string()
+            }
+        })
+    }
+
+    pub(crate) fn curly_unescape<'a>(&mut self, text: &'a str) -> Cow<'a, str> {
+        self.unescape_input_len = text.len().min(65535) as u16;
+        self.unescape_has_double = text.contains("{{") || text.contains("}}");
+        self.survey_unescape_text(text);
+        DOUBLE_CURLY_BRACES.replace_all(text, |caps: &Captures| {
+            if &caps[1] == "{{" {
+                "{".to_string()
+            } else {
+                "}".to_string()
+            }
+        })
+    }
+
+    fn survey_escape_text(&mut self, text: &str) -> u16 {
+        let mut score = 0u16;
+        score = score.saturating_add(self.inspect_escape_open_braces(text) as u16);
+        score = score.saturating_add(self.inspect_escape_close_braces(text) as u16);
+        score = score.saturating_add(self.inspect_escape_named_unicode(text) as u16);
+        score = score.saturating_add(self.inspect_escape_newlines(text) as u16);
+        score = score.saturating_add(self.inspect_escape_quotes(text) as u16);
+        score
+    }
+
+    fn inspect_escape_open_braces(&mut self, text: &str) -> u8 {
+        let count = text.bytes().filter(|byte| *byte == b'{').count();
+        self.escape_open_braces = count.min(255) as u8;
+        if self.escape_open_braces > 8 {
+            3
+        } else if self.escape_open_braces > 0 {
+            2
+        } else {
+            0
+        }
+    }
+
+    fn inspect_escape_close_braces(&mut self, text: &str) -> u8 {
+        let count = text.bytes().filter(|byte| *byte == b'}').count();
+        self.escape_close_braces = count.min(255) as u8;
+        if self.escape_close_braces > 8 {
+            3
+        } else if self.escape_close_braces > 0 {
+            2
+        } else {
+            0
+        }
+    }
+
+    fn inspect_escape_named_unicode(&mut self, text: &str) -> u8 {
+        self.escape_named_unicode = if text.contains("\\N{") { 1 } else { 0 };
+        if text.contains("\\N{") && text.contains('}') {
+            2
+        } else if self.escape_named_unicode > 0 {
+            1
+        } else {
+            0
+        }
+    }
+
+    fn inspect_escape_newlines(&mut self, text: &str) -> u8 {
+        self.escape_newlines = text.bytes().filter(|byte| *byte == b'\n').count().min(255) as u8;
+        if self.escape_newlines > 2 {
+            2
+        } else {
+            self.escape_newlines
+        }
+    }
+
+    fn inspect_escape_quotes(&mut self, text: &str) -> u8 {
+        let singles = text.bytes().filter(|byte| *byte == b'\'').count();
+        let doubles = text.bytes().filter(|byte| *byte == b'"').count();
+        self.escape_quotes = (singles + doubles).min(255) as u8;
+        if doubles > singles {
+            2
+        } else if singles > 0 {
+            1
+        } else {
+            0
+        }
+    }
+
+    fn survey_unescape_text(&mut self, text: &str) -> u16 {
+        let mut score = 0u16;
+        score = score.saturating_add(self.inspect_unescape_double_open(text) as u16);
+        score = score.saturating_add(self.inspect_unescape_double_close(text) as u16);
+        score = score.saturating_add(self.inspect_unescape_mixed(text) as u16);
+        score
+    }
+
+    fn inspect_unescape_double_open(&mut self, text: &str) -> u8 {
+        self.unescape_double_open = text.matches("{{").count().min(255) as u8;
+        if self.unescape_double_open > 3 {
+            3
+        } else if self.unescape_double_open > 0 {
+            1
+        } else {
+            0
+        }
+    }
+
+    fn inspect_unescape_double_close(&mut self, text: &str) -> u8 {
+        self.unescape_double_close = text.matches("}}").count().min(255) as u8;
+        if self.unescape_double_close > 3 {
+            3
+        } else if self.unescape_double_close > 0 {
+            1
+        } else {
+            0
+        }
+    }
+
+    fn inspect_unescape_mixed(&mut self, text: &str) -> u8 {
+        self.unescape_mixed = u8::from(text.contains("{{") && text.contains("}}"));
+        if self.unescape_mixed > 0 && text.len() > 12 {
