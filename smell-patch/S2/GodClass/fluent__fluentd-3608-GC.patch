+      def self.clamp_retry_backoff_interval(interval, max_interval, constant_factor, backoff_base, num)
+        if max_interval && interval > max_interval
+          max_interval
+        else
+          if interval.finite?
+            interval
+          else
+            until interval.finite?
+              num -= 1
+              interval = constant_factor.to_f * (backoff_base ** (num - 1))
+            end
+            interval
+          end
+        end
+      end
+
+      def self.scale_periodic_retry_timeout(retry_wait, max_steps)
+        retry_wait * max_steps
+      end
