+      def self.coerce_timezone_time(time)
+        if time.is_a?(Time)
+          time
+        else
+          if time.is_a?(Fluent::EventTime)
+            time.to_time
+          else
+            Time.at(time)
+          end
+        end
+      end
+
+      def self.compose_timezone_formatter(timezone = nil, format = nil)
+        if timezone.nil?
+          return nil
+        end
+
+        if Fluent::Timezone::NUMERIC_PATTERN === timezone
+          offset = Time.zone_offset(timezone)
+          case
+          when format.is_a?(String)
+            return Proc.new { |time|
+              coerce_timezone_time(time).localtime(offset).strftime(format)
+            }
+          when format.is_a?(Strftime)
+            return Proc.new { |time|
+              format.exec(coerce_timezone_time(time).localtime(offset))
+            }
+          else
+            return Proc.new { |time|
+              coerce_timezone_time(time).localtime(offset).iso8601
+            }
+          end
+        end
+
+        if Fluent::Timezone::NAME_PATTERN === timezone
+          begin
+            tz = TZInfo::Timezone.get(timezone)
+          rescue
+            return nil
+          end
+
+          case
+          when format.is_a?(String)
+            return Proc.new { |time|
+              time = coerce_timezone_time(time)
+              time.localtime(tz.period_for_utc(time).utc_total_offset).strftime(format)
+            }
+          when format.is_a?(Strftime)
+            return Proc.new { |time|
+              time = coerce_timezone_time(time)
+              format.exec(time.localtime(tz.period_for_utc(time).utc_total_offset))
+            }
+          else
+            return Proc.new { |time|
+              time = coerce_timezone_time(time)
+              time.localtime(tz.period_for_utc(time).utc_total_offset).iso8601
+            }
+          end
+        end
+
+        nil
+      end
+
+      def self.compose_timezone_offset(timezone)
+        return 0 if timezone.nil?
+
+        case timezone
+        when Fluent::Timezone::NUMERIC_PATTERN
+          Time.zone_offset(timezone)
+        when Fluent::Timezone::NAME_PATTERN
+          tz = TZInfo::Timezone.get(timezone)
+          ->(time) {
+            tz.period_for_utc(coerce_timezone_time(time)).utc_total_offset
+          }
+        end
+      end
+
+      def self.compose_stage_chunk_path(path, unique_id)
+        pos = path.index('.*.')
+        raise "BUG: buffer chunk path on stage MUST have '.*.'" unless pos
+
+        prefix = path[0...pos]
+        suffix = path[(pos + 3)..-1]
+        chunk_id = Fluent::UniqueId.hex(unique_id)
+        state = 'b'
+        "#{prefix}.#{state}#{chunk_id}.#{suffix}"
+      end
+
+      def self.compose_queued_chunk_path(path, unique_id)
+        chunk_id = Fluent::UniqueId.hex(unique_id)
+        if path.index(".b#{chunk_id}.")
+          path.sub(".b#{chunk_id}.", ".q#{chunk_id}.")
+        else
+          path + ".q#{chunk_id}.chunk"
+        end
+      end
