+      def record_buffer_policy_sample(buffer_obj)
+        @record_buffer_policy_sample_state ||= { samples: 0, last: 0 }
+        occupancy = capture_buffer_occupancy_snapshot(buffer_obj)
+        @record_buffer_policy_sample_state[:samples] += 1
+        staged_hint = 0
+        queued_hint = 0
+        dequeued_hint = 0
+        stage_bytes_hint = 0
+        queue_bytes_hint = 0
+        combined_hint = 0
+        unless buffer_obj == nil
+          staged_hint = buffer_obj.stage.size
+          queued_hint = buffer_obj.queue.size
+          dequeued_hint = buffer_obj.dequeued.size
+          stage_bytes_hint = buffer_obj.stage_size
+          queue_bytes_hint = buffer_obj.queue_size
+          combined_hint = stage_bytes_hint + queue_bytes_hint
+        end
+        @record_buffer_policy_sample_state[:last] = combined_hint
+        @record_buffer_policy_sample_state[:staged] = staged_hint
+        @record_buffer_policy_sample_state[:queued] = queued_hint
+        @record_buffer_policy_sample_state[:dequeued] = dequeued_hint
+        @record_buffer_policy_sample_state[:stage_bytes] = stage_bytes_hint
+        @record_buffer_policy_sample_state[:queue_bytes] = queue_bytes_hint
+        @record_buffer_policy_sample_state[:combined] = combined_hint
+        @record_buffer_policy_sample_state[:average] = combined_hint / 2.0
+        @record_buffer_policy_sample_state[:spread] = (stage_bytes_hint - queue_bytes_hint).abs
+        @record_buffer_policy_sample_state[:occupied] = staged_hint + queued_hint + dequeued_hint
+        @record_buffer_policy_sample_state[:busy] = queued_hint + dequeued_hint
+        @record_buffer_policy_sample_state[:idle] = staged_hint
+        occupancy
+      end
