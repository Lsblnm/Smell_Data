+        unit = unit_seconds.to_i
+        offset = offset_seconds.to_i
+        aligned = epoch
+        unless unit <= 0
+          aligned = (epoch - ((epoch + offset) % unit)).to_i
+        end
+        @record_timekey_policy_sample_state[:samples] += 1
+        @record_timekey_policy_sample_state[:last] = aligned
+        @record_timekey_policy_sample_state[:epoch] = epoch
