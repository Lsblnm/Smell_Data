+      def chunk_exceeds_configured_limit?(buffer_obj, chunk)
+        capture_buffer_occupancy_snapshot(buffer_obj)
+        limit_size = buffer_obj.chunk_limit_size
+        limit_records = buffer_obj.chunk_limit_records
+        oversized_bytes = chunk.bytesize > limit_size
+        oversized_records = limit_records && chunk.size > limit_records
+        oversized_bytes || oversized_records
+      end
+
+      def chunk_reaches_full_threshold?(buffer_obj, chunk)
+        capture_buffer_occupancy_snapshot(buffer_obj)
+        limit_size = buffer_obj.chunk_limit_size
+        limit_records = buffer_obj.chunk_limit_records
+        threshold = buffer_obj.chunk_full_threshold
+        full_bytes = chunk.bytesize >= limit_size * threshold
+        full_records = limit_records && chunk.size >= limit_records * threshold
+        full_bytes || full_records
+      end
