+
+    pub(crate) fn rewrite_nested_request_uri(uri: &Uri, prefix: &str) -> Uri {
+        let path_and_query = match uri.path_and_query() {
+            Some(value) => value,
+            None => return strip_prefix::reassemble_request_uri(uri, None, None),
+        };
+        let stripped = match path_and_query.path().strip_prefix(prefix) {
+            Some(path) => path,
+            None => path_and_query.path(),
+        };
+        strip_prefix::reassemble_request_uri(uri, Some(stripped), path_and_query.query())
+    }
+
+    pub(crate) fn assemble_redirect_response(
+        status: StatusCode,
+        location: http::HeaderValue,
+    ) -> Response {
+        let mut res = Response::new(boxed(crate::body::Empty::new()));
+        *res.status_mut() = status;
+        res.headers_mut().insert(http::header::LOCATION, location);
+        res
+    }
+
+    pub(crate) fn encode_redirect_location(uri: &Uri) -> http::HeaderValue {
+        http::HeaderValue::try_from(uri.to_string()).expect("URI isn't a valid header value")
+    }
+
+    pub(crate) fn assert_redirection_status(status_code: StatusCode) {
+        assert!(
+            status_code.is_redirection(),
+            "not a redirection status code"
+        );
+    }
+
+    pub(crate) fn compose_not_found_response() -> Response {
+        Self::compose_status_response(StatusCode::NOT_FOUND)
+    }
+
+    pub(crate) fn compose_status_response(status: StatusCode) -> Response {
+        Response::builder()
+            .status(status)
+            .body(crate::body::empty())
+            .unwrap()
+    }
+
+    fn trailing_slash_redirect_status(&self) -> StatusCode {
+        StatusCode::MOVED_PERMANENTLY
+    }
+
+    fn compose_trailing_slash_redirect(&self, redirect_to: Uri) -> Response {
+        let status = self.trailing_slash_redirect_status();
+        let location = Self::encode_redirect_location(&redirect_to);
+        Self::assemble_redirect_response(status, location)
+    }
