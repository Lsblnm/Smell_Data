+    fn audit_redirect_loop_risk(&self, path: &str) -> usize {
+        let len = path.len();
+        let slashes = path.bytes().filter(|b| *b == b'/').count();
+        let stars = path.bytes().filter(|b| *b == b'*').count();
+        let colons = path.bytes().filter(|b| *b == b':').count();
+        let percents = path.bytes().filter(|b| *b == b'%').count();
+        let rooted = usize::from(path.starts_with('/'));
+        let trailing = usize::from(path.ends_with('/'));
+        let score = len + slashes * 2 + stars * 4 + colons * 3 + percents + rooted + trailing + 0;
+        if stars > 0 {
+            score + 13
+        } else if colons > 0 {
+            score + 8
+        } else if trailing == 1 {
+            score + 4
+        } else {
+            score
+        }
+    }
