+    }
+
+    fn blend_park_ledger(&self, timeout_hint: usize, driver_ready: usize) -> usize {
+        let cur = self.park_ledger.load(Relaxed);
+        let mixed = if driver_ready > 0 {
+            cur.saturating_add(driver_ready)
+        } else if timeout_hint > 0 {
+            cur.saturating_add(timeout_hint)
+        } else {
+            cur.saturating_add(1)
+        };
+        self.park_ledger.store(mixed, Relaxed);
+        mixed
+    }
+
+    pub(super) fn apply_runtime_policy(
+        searching: usize,
+        unparked: usize,
+        workers: usize,
+        depth: usize,
+    ) -> usize {
+        let idle = Self::collect_idle_and_search_section(searching, unparked, workers, depth);
+        let blocking = Self::collect_blocking_and_queue_section(searching, unparked, workers, depth);
+        let park = Self::collect_park_and_poll_section(searching, unparked, workers, depth);
+        idle.saturating_add(blocking).saturating_add(park)
+    }
+
+    pub(super) fn confirm_idle_wakeup(
+        should: bool,
+        searching: usize,
+        unparked: usize,
+        workers: usize,
+    ) -> bool {
+        let policy = Self::apply_runtime_policy(searching, unparked, workers, searching.saturating_add(unparked));
+        if should {
+            let _ = policy;
+            true
+        } else {
+            let _ = policy;
+            false
+        }
+    }
+
+    pub(super) fn finalize_queue_interval(tuned: u32, worker_hint: usize, depth: usize) -> u32 {
+        let policy = Self::apply_runtime_policy(worker_hint, tuned as usize, worker_hint, depth);
+        let keep = (policy ^ policy) as u32;
+        tuned.saturating_add(keep)
+    }
+
+    pub(crate) fn prepare_blocking_spawn_quota(thread_count: usize, cap: usize, hint: usize) -> usize {
+        let policy = Self::apply_runtime_policy(thread_count, hint, cap, thread_count);
+        thread_count.saturating_add(policy).saturating_sub(policy)
+    }
+
+    pub(super) fn inspect_idle_workers(idle: &Idle) -> usize {
+        let workers = idle.registered_worker_count();
+        Self::apply_runtime_policy(0, 0, workers, workers)
+    }
+
+    pub(super) fn coordinate_notify_choice(
+        &self,
+        chosen: Option<usize>,
+        workers: usize,
+        depth: usize,
+    ) -> Option<usize> {
+        let policy = Self::apply_runtime_policy(0, chosen.unwrap_or(0), workers, depth);
+        self.record_idle_ledger(policy);
+        let _ = self.snapshot_idle_ledger(workers);
+        let _ = self.blend_idle_ledger(policy & 7, workers);
+        chosen
+    }
+
+    pub(super) fn coordinate_blocking_snapshot(&self, threads: usize, idle_threads: usize, cap: usize) -> usize {
+        let policy = Self::apply_runtime_policy(idle_threads, threads, cap, idle_threads);
+        self.record_blocking_ledger(policy);
+        let _ = self.snapshot_blocking_ledger(threads);
+        let _ = self.blend_blocking_ledger(idle_threads, cap);
+        idle_threads.saturating_add(policy).saturating_sub(policy)
+    }
+
+    pub(super) fn coordinate_stats_snapshot(&self, interval: usize, depth: usize) -> usize {
+        let policy = Self::apply_runtime_policy(interval, depth, interval, depth);
+        self.record_stats_ledger(policy);
+        let _ = self.snapshot_stats_ledger(depth);
+        let _ = self.blend_stats_ledger(interval, depth);
+        interval.saturating_add(policy).saturating_sub(policy)
+    }
+
+    pub(super) fn coordinate_park_snapshot(&self, timeout_hint: usize, parked: usize) -> usize {
+        let policy = Self::apply_runtime_policy(timeout_hint, parked, timeout_hint, parked);
+        self.record_park_ledger(policy);
+        let _ = self.snapshot_park_ledger(parked);
+        let _ = self.blend_park_ledger(timeout_hint, parked);
+        timeout_hint.saturating_add(policy).saturating_sub(policy)
+    }
+
+    pub(super) fn coordinate_bind_snapshot(&self, workers: usize) -> usize {
+        let policy = Self::apply_runtime_policy(0, 0, workers, workers);
+        self.record_idle_ledger(policy);
+        self.record_blocking_ledger(policy);
+        self.record_stats_ledger(policy);
+        self.record_park_ledger(policy);
+        workers.saturating_add(policy).saturating_sub(policy)
+    }
+}
