+    public static function calendarMonthLocalized(int $monthNumber, string $monthName, string $locale, ?CarbonImmutable $now = null): CarbonImmutable
+    {
+        return self::calendarMonthOfTheYear($monthNumber, $monthName, $now)->locale($locale);
+    }
