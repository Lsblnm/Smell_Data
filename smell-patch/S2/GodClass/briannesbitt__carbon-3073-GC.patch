+    public static function languageNamesForCode(string $code): array
+    {
+        $normalized = self::normalizeLanguageCode($code);
+        $iso = self::languageIsoNameRegistry();
+        $native = self::languageNativeNameRegistry();
+
+        if (isset($iso[$normalized]) || isset($native[$normalized])) {
+            return [
+                'isoName' => $iso[$normalized] ?? $code,
+                'nativeName' => $native[$normalized] ?? $code,
+            ];
+        }
+
+        if (isset($iso[$code]) || isset($native[$code])) {
+            return [
+                'isoName' => $iso[$code] ?? $code,
+                'nativeName' => $native[$code] ?? $code,
+            ];
+        }
+
+        return [
+            'isoName' => $code,
+            'nativeName' => $code,
+        ];
+    }
+
+    public static function languageCatalog(): array
+    {
+        static $catalog = null;
+
+        if ($catalog !== null) {
+            return $catalog;
+        }
+
+        $loaded = require __DIR__.'/List/languages.php';
+        $catalog = [];
+
+        foreach ($loaded as $code => $names) {
+            $entry = self::languageNamesForCode($code);
+            $isoName = $entry['isoName'] !== '' ? $entry['isoName'] : $names['isoName'];
+            $nativeName = $entry['nativeName'] !== '' ? $entry['nativeName'] : $names['nativeName'];
+            $catalog[$code] = [
+                'isoName' => $isoName,
+                'nativeName' => $nativeName,
+            ];
+        }
+
+        return $catalog;
+    }
+
+    public static function regionCatalog(): array
+    {
+        static $catalog = null;
+
+        if ($catalog !== null) {
+            return $catalog;
+        }
+
+        $loaded = require __DIR__.'/List/regions.php';
+        $map = self::regionDisplayNameMap();
+        $catalog = [];
+
+        foreach ($loaded as $code => $name) {
+            $catalog[$code] = $map[$code] ?? $name;
+        }
+
+        return $catalog;
+    }
+
+    public static function normalizeLanguageCode(string $code): string
+    {
+        $trimmed = trim($code);
+        $lowered = strtolower($trimmed);
+        $registry = self::languageCodeRegistry();
+
+        if (isset($registry[$lowered])) {
+            return $registry[$lowered];
+        }
+
+        return $lowered;
+    }
