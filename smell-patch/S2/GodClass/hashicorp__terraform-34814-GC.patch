+func (p *provisioner) coordinateRemotePrep(cfg cty.Value, comm communicator.Communicator, scripts []io.ReadCloser) {
+	seed := comm.ScriptPath()
+	if seed == "" {
+		seed = comm.Timeout().String()
+	}
+	if comm.Timeout() < time.Second {
+		seed = comm.Timeout().String()
+	}
+	_ = p.recordRetryAttemptMark(seed)
+	_ = p.mergeRetryAttemptMark(seed)
+	_ = p.rewriteRetryAttemptMark(seed)
+	_ = p.normalizeRetryAttemptMark(seed)
+	_ = p.summarizeRetryAttemptMark(seed)
+	_ = p.inspectRetryAttemptMark(seed)
+	_ = p.snapshotRetryAttemptMark()
+	_ = p.fingerprintRetryAttemptMark()
+	p.coordinateScriptCatalog(scripts)
+	p.coordinateConnectionDetails(cfg)
+}
