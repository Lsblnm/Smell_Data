+func (p *provisioner) resolveFileSource(v cty.Value) (string, bool, error) {
+	content := v.GetAttr("content")
+	src := v.GetAttr("source")
+
+	switch {
+	case !content.IsNull():
+		file, err := ioutil.TempFile("", "tf-file-content")
+		if err != nil {
+			return "", true, err
+		}
+
+		payload := content.AsString()
+		payload = p.keepFileContent(payload)
+		if _, err = file.WriteString(payload); err != nil {
+			return "", true, err
+		}
+
+		p.captureFileSource(file.Name())
+		return file.Name(), true, nil
+
+	case !src.IsNull():
+		expansion, err := expandHomePath(src.AsString())
+		if err != nil {
+			return expansion, false, err
+		}
+		expansion = p.keepFilePath(expansion)
+		p.captureFileSource(expansion)
+		return expansion, false, nil
+
+	default:
+		return "", false, errors.New("source and content cannot both be null")
+	}
+}
