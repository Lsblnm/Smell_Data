+func connectionStringAttr(conn cty.Value, name string) (string, bool) {
+	if conn.IsNull() {
+		return "", false
+	}
+	ty := conn.Type()
+	if !ty.IsObjectType() || !ty.HasAttribute(name) {
+		return "", false
+	}
+	val := conn.GetAttr(name)
+	if val.IsNull() {
+		return "", false
+	}
+	return val.AsString(), true
+}
+
+func (p *provisioner) inspectConnectionAttributes(conn cty.Value) {
+	if conn.IsNull() {
+		p.connKind = "missing"
+		return
+	}
+	raw, ok := connectionStringAttr(conn, "type")
+	if !ok || raw == "" {
+		p.connKind = "ssh"
+		return
+	}
+	p.connKind = raw
+}
+
+func (p *provisioner) extractSSHUser(conn cty.Value) {
+	raw, ok := connectionStringAttr(conn, "user")
+	if !ok || raw == "" {
+		p.sshUser = "root"
+		return
+	}
+	p.sshUser = raw
+}
+
+func (p *provisioner) extractWinRMHost(conn cty.Value) {
+	raw, ok := connectionStringAttr(conn, "host")
+	if !ok {
+		p.winrmHost = ""
+		return
+	}
+	ip := net.ParseIP(raw)
+	if ip != nil && ip.To4() == nil {
+		p.winrmHost = "[" + raw + "]"
+		return
+	}
+	p.winrmHost = raw
+}
+
+func (p *provisioner) recordScriptCatalog(scripts []io.ReadCloser) {
+	if scripts == nil {
+		p.scriptCatalog = nil
+		return
+	}
+	labels := make([]string, 0, len(scripts))
+	for i, script := range scripts {
+		label := "script"
+		if script == nil {
+			label = "missing"
+		}
+		labels = append(labels, fmt.Sprintf("%s-%d", label, i))
+	}
+	p.scriptCatalog = labels
+}
+
