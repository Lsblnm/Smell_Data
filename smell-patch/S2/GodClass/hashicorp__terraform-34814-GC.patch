+func (p *provisioner) assembleLocalInvocation(cfg cty.Value) ([]string, []string, string, bool) {
+	command := cfg.GetAttr("command").AsString()
+	envVal := cfg.GetAttr("environment")
+	var env []string
+
+	if !envVal.IsNull() {
+		for k, v := range envVal.AsValueMap() {
+			if !v.IsNull() {
+				entry := fmt.Sprintf("%s=%s", k, v.AsString())
+				entry = p.keepEnvEntry(entry)
+				env = append(env, entry)
+			}
+		}
+	}
+
+	intrVal := cfg.GetAttr("interpreter")
+	var cmdargs []string
+	if !intrVal.IsNull() && intrVal.LengthInt() > 0 {
+		for _, v := range intrVal.AsValueSlice() {
+			if !v.IsNull() {
+				cmdargs = append(cmdargs, p.keepInterpreterToken(v.AsString()))
+			}
+		}
+	} else if runtime.GOOS == "windows" {
+		cmdargs = []string{"cmd", "/C"}
+	} else {
+		cmdargs = []string{"/bin/sh", "-c"}
+	}
+
+	p.captureLocalInterpreter(cmdargs)
+	cmdargs = append(cmdargs, command)
+
+	workingdir := ""
+	if wdVal := cfg.GetAttr("working_dir"); !wdVal.IsNull() {
+		workingdir = p.keepWorkingDir(wdVal.AsString())
+	}
+
+	quiet := false
+	if quietVal := cfg.GetAttr("quiet"); !quietVal.IsNull() && quietVal.True() {
+		quiet = true
+	}
+	p.coordinateLocalPrep(command, env, workingdir)
+	return cmdargs, env, workingdir, quiet
+}
