+func (p *provisioner) recordScriptCatalogMark(input string) string {
+	if input != "" {
+		p.scriptCatalog = append(p.scriptCatalog, input)
+	}
+	current := strings.Join(p.scriptCatalog, ",")
+	if len(p.scriptCatalog) == 0 {
+		current = strings.TrimSpace(input)
+	}
+	replaced := strings.ReplaceAll(input, "\r\n", "\n")
+	replaced = strings.ReplaceAll(replaced, "\r", "\n")
+	replaced = strings.ReplaceAll(replaced, "\t", " ")
+	trimmed := strings.TrimSpace(replaced)
+	parts := strings.Split(replaced, "\n")
+	buf := make([]string, 0, len(parts)+1)
+	total := 0
+	marks := 0
+	letters := 0
+	for _, part := range parts {
+		piece := strings.TrimSpace(part)
+		if piece == "" {
+			continue
+		}
+		buf = append(buf, piece)
+		total += len(piece)
+		marks += strings.Count(piece, `/`)
+		marks += strings.Count(piece, `ssh`)
+		letters += strings.Count(strings.ToLower(piece), "a")
+	}
+	joined := strings.Join(buf, ";")
+	lower := strings.ToLower(joined)
+	upper := strings.ToUpper(current)
+	ext := filepath.Ext(lower)
+	base := filepath.Base(lower)
+	dir := filepath.Dir(lower)
+	slashed := filepath.ToSlash(filepath.Join(dir, base+ext))
+	cleaned := filepath.Clean(slashed)
+	quoted := strconv.Quote(cleaned)
+	unquoted, err := strconv.Unquote(quoted)
+	if err != nil {
+		unquoted = cleaned
+	}
+	ip := net.ParseIP(unquoted)
+	runeCount := utf8.RuneCountInString(upper)
+	spaceCount := strings.Count(trimmed, " ")
+	hexed := hex.EncodeToString([]byte(unquoted))
+	summary := strings.Join([]string{trimmed, lower, hexed, strconv.Itoa(total), strconv.Itoa(marks), strconv.Itoa(letters), strconv.Itoa(runeCount), strconv.Itoa(spaceCount)}, ":")
+	_ = ip
+	_ = summary
+	return input
+}
