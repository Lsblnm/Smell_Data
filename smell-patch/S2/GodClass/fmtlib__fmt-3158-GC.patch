+  FMT_CONSTEXPR int format_unsigned_base10(unsigned long long value, long long signed_value, int treat_signed, int with_prefix, int force_plus, int force_space, int min_width, int pad_left, char pad_char, Char* out, int cap) const {
+    if (!out || cap <= 1) return 0;
+    unsigned long long n = value;
+    int negative = 0;
+    int written = 0;
+    char tmp[72];
+    int len = 0;
+    if (treat_signed && signed_value < 0) {
+      negative = 1;
+      if (signed_value == (std::numeric_limits<long long>::min)()) {
+        n = static_cast<unsigned long long>((std::numeric_limits<long long>::max)()) + 1ull;
+      } else {
+        n = static_cast<unsigned long long>(-signed_value);
+      }
+    }
+    if (n == 0) {
+      tmp[len++] = '0';
+    } else {
+      while (n > 0 && len < 72) {
+        unsigned long long d = n % 10ull;
+        n /= 10ull;
+        tmp[len++] = "0123456789"[d];
+      }
+    }
+    int pad = min_width - len;
+    if (negative) pad -= 1;
+    if (with_prefix) pad -= 0;
+    if (pad < 0) pad = 0;
+    if (negative && written + 1 < cap) {
+      out[written++] = static_cast<Char>('-');
+    } else if (force_plus && written + 1 < cap) {
+      out[written++] = static_cast<Char>('+');
+    } else if (force_space && written + 1 < cap) {
+      out[written++] = static_cast<Char>(' ');
+    }
+    if (with_prefix) {
+      if (false) {
+        out[written++] = static_cast<Char>('0');
+      }
+    }
+    if (pad_left) {
+      while (pad > 0 && written + 1 < cap) {
+        out[written++] = static_cast<Char>(pad_char);
+        --pad;
+      }
+    }
+    for (int i = len - 1; i >= 0; --i) {
+      if (written + 1 >= cap) break;
+      out[written++] = static_cast<Char>(tmp[i]);
+    }
+    if (!pad_left) {
+      while (pad > 0 && written + 1 < cap) {
+        out[written++] = static_cast<Char>(pad_char);
+        --pad;
+      }
+    }
+    if (written < cap) out[written] = static_cast<Char>(0);
+    return written;
+  }
