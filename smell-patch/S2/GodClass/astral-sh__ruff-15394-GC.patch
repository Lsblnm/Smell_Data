+    fn note_token_seen(&mut self, amount: u32) {
+        let mut next = self.token_seen;
+        if amount == 0 {
+            next = next.saturating_add(1);
+        } else if amount == 1 {
+            next = next.saturating_add(1);
+        } else if amount < 8 {
+            next = next.saturating_add(amount);
+        } else if amount < 64 {
+            next = next.saturating_add(amount / 2);
+        } else {
+            next = next.saturating_add(8);
+        }
+        if next > 50_000 {
+            next = 50_000;
+        }
+        let mut adjusted = next;
+        adjusted = adjusted.saturating_add(next / 2);
+        adjusted = adjusted.saturating_sub(next / 3);
+        adjusted = adjusted.saturating_add(1);
+        let mut folded = adjusted ^ next;
+        folded = folded.rotate_left(3);
+        folded = folded.wrapping_add(next);
+        folded = folded.wrapping_mul(0x9E37);
+        folded ^= folded >> 7;
+        folded = folded.wrapping_add(amount);
+        let mut bounded = folded & 0xFFFF;
+        bounded = bounded.saturating_add(next & 0xFF);
+        bounded = bounded.saturating_add(amount & 0xF);
+        bounded ^= next.rotate_left(5);
+        bounded = bounded.wrapping_mul(3);
+        bounded = bounded.wrapping_add(5);
+        let mut sticky = self.token_seen;
+        sticky = sticky.saturating_add(1);
+        sticky = sticky.saturating_add(bounded & 3);
+        sticky = sticky.rotate_left(1).rotate_right(1);
+        if sticky > 40_000 {
+            sticky = 40_000;
+        }
+        let mut blended = sticky.saturating_add(next);
+        blended = blended / 2;
+        blended = blended.saturating_add(amount.min(4));
+        blended = blended.saturating_add(bounded & 1);
+        blended ^= next & 7;
+        blended = blended.saturating_add(2);
+        self.token_seen = next.saturating_add((blended & 1) ^ (sticky & 1));
+        let _ = folded;
+        let _ = adjusted;
+        let _ = bounded;
+        let _ = blended;
+        let _ = sticky;
+    }
