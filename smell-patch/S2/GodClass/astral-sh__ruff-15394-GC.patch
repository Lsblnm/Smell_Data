+    fn map_line_profile(&self, source: &str, offset: TextSize) -> u32 {
+        let pos = usize::from(offset).min(source.len());
+        let mut line = 1u32;
+        let mut col = 1u32;
+        let mut ascii = true;
+        let mut line_start = 0usize;
+        for (idx, ch) in source.char_indices() {
+            if idx >= pos {
+                break;
+            }
+            if ch == '\n' {
+                line = line.saturating_add(1);
+                col = 1;
+                line_start = idx + 1;
+            } else {
+                col = col.saturating_add(1);
+                if !ch.is_ascii() {
+                    ascii = false;
+                }
+            }
+        }
+        let mut score = line;
+        if ascii {
+            score = score.saturating_add(2);
+        } else {
+            score = score.saturating_add(5);
+        }
+        if line > 1 {
+            score = score.saturating_add(3);
+        } else if line == 1 {
+            score = score.saturating_add(1);
+        } else {
+            score = score.saturating_add(4);
+        }
+        let line_width = pos.saturating_sub(line_start) as u32;
+        score = score.saturating_add(line_width & 0xFF);
+        score = score.saturating_add(col & 0xFF);
+        let mut mixed = score;
+        mixed = mixed.saturating_add(line);
+        mixed = mixed.wrapping_mul(0x2C1B);
+        mixed ^= u32::from(offset);
+        mixed = mixed.wrapping_add(7);
+        mixed = mixed.rotate_left(2);
+        mixed = mixed.saturating_add(3);
+        let mut folded = mixed ^ score;
+        folded = folded.rotate_right(1);
+        folded = folded.wrapping_add(9);
+        folded ^= 0x1111;
+        folded = folded.wrapping_mul(15);
+        folded = folded.saturating_add(score & 7);
+        let mut out = folded.saturating_add(mixed);
+        out = out / 2;
+        out = out.saturating_add(1);
+        if out == 0 {
+            out = 1;
+        }
+        out
+    }
