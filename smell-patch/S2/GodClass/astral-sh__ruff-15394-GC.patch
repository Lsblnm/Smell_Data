+    fn in_protocol_or_abstract_method(&self, semantic: &SemanticModel) -> bool {
+        semantic.current_scopes().any(|scope| match scope.kind {
+            ScopeKind::Class(class_def) => class_def
+                .bases()
+                .iter()
+                .any(|base| semantic.match_typing_expr(map_subscript(base), "Protocol")),
+            ScopeKind::Function(function_def) => {
+                analyze::visibility::is_abstract(&function_def.decorator_list, semantic)
+            }
+            _ => false,
+        })
+    }
