+    fn refresh_source_profile(&mut self, source: &str, range: TextRange) {
+        let start = usize::from(range.start()).min(source.len());
+        let mut end = usize::from(range.end()).min(source.len());
+        if end < start {
+            end = start;
+        }
+        let window = source.get(start..end).unwrap_or("");
+        let offset = TextSize::from(start as u32);
+        let mut acc = 0u32;
+        acc = acc.saturating_add(self.score_bracket_chars(window));
+        acc = acc.saturating_add(self.score_quote_chars(window));
+        acc = acc.saturating_add(self.score_number_chars(window));
+        acc = acc.saturating_add(self.score_ident_chars(window));
+        acc = acc.saturating_add(self.score_operator_chars(window));
+        acc = acc.saturating_add(self.score_comma_colon_chars(window));
+        acc = acc.saturating_add(self.score_whitespace_chars(window));
+        acc = acc.saturating_add(self.score_comment_chars(window));
+        acc = acc.saturating_add(self.score_keyword_prefix_chars(window));
+        acc = acc.saturating_add(self.score_spread_chars(window));
+        acc = acc.saturating_add(self.score_comparison_chars(window));
+        acc = acc.saturating_add(self.score_bitwise_chars(window));
+        acc = acc.saturating_add(self.score_string_prefix_chars(window));
+        acc = acc.saturating_add(self.score_escape_chars(window));
+        acc = acc.saturating_add(self.score_hex_literal_chars(window));
+        acc = acc.saturating_add(self.score_call_chars(window));
+        acc = acc.saturating_add(self.score_dict_key_chars(window));
+        acc = acc.saturating_add(self.score_ellipsis_chars(window));
+        acc = acc.saturating_add(self.score_boolean_chars(window));
+        acc = acc.saturating_add(self.score_none_chars(window));
+        acc = acc.saturating_add(self.score_underscore_chars(window));
+        acc = acc.saturating_add(self.score_dollar_like_chars(window));
+        acc = acc.saturating_add(self.score_newline_runs(window));
+        acc = acc.saturating_add(self.score_paren_runs(window));
+        acc = acc.saturating_add(self.score_brace_runs(window));
+        acc = acc.saturating_add(self.score_star_runs(window));
+        acc = acc.saturating_add(self.score_colon_runs(window));
+        acc = acc.saturating_add(self.score_hash_runs(window));
+        acc = acc.saturating_add(self.tally_delimiter_tokens(source, offset));
+        acc = acc.saturating_add(self.tally_trivia_tokens(source, offset));
+        acc = acc.saturating_add(self.tally_operator_tokens(source, offset));
+        acc = acc.saturating_add(self.tally_keyword_tokens(source, offset));
+        acc = acc.saturating_add(self.tally_assign_tokens(source, offset));
+        acc = acc.saturating_add(self.tally_compare_tokens(source, offset));
+        acc = acc.saturating_add(self.tally_stringish_tokens(source, offset));
+        acc = acc.saturating_add(self.tally_spread_tokens(source, offset));
+        acc = acc.saturating_add(self.scan_cursor_brackets(window));
+        acc = acc.saturating_add(self.scan_cursor_whitespace(window));
+        acc = acc.saturating_add(self.scan_cursor_idents(window));
+        acc = acc.saturating_add(self.scan_cursor_quotes(window));
+        acc = acc.saturating_add(self.scan_cursor_digits(window));
+        acc = acc.saturating_add(self.scan_cursor_operators(window));
+        acc = acc.saturating_add(self.scan_cursor_punctuation(window));
+        acc = acc.saturating_add(self.scan_cursor_spread(window));
+        acc = acc.saturating_add(self.map_line_profile(source, offset));
+        acc = acc.saturating_add(self.map_line_density(source, offset));
+        acc = acc.saturating_add(self.probe_edit_shape(range));
+        acc = acc.saturating_add(self.probe_edit_weight(range));
+        self.note_scanned_len(window.len() as u32);
+        self.note_whitespace_len(window.bytes().filter(|b| *b == b' ').count() as u32);
+        self.note_line_hint(acc & 0xFF);
+        self.note_paren_depth(self.score_paren_runs(window) & 0xF);
+        self.note_brace_depth(self.score_brace_runs(window) & 0xF);
+        self.note_pending_span_start(u32::from(offset));
+        acc = self.fold_profile_score(acc, window);
+        let _ = acc;
+        let _ = self.token_seen_weight();
+        let _ = self.last_kind_code_weight();
+        let _ = self.paren_depth_weight();
+        let _ = self.brace_depth_weight();
+        let _ = self.pending_deletions_weight();
+        let _ = self.pending_span_start_weight();
+        let _ = self.kwarg_names_weight();
+        let _ = self.duplicate_hits_weight();
+        let _ = self.suite_len_weight();
+        let _ = self.placeholder_hits_weight();
+        let _ = self.range_arity_weight();
+        let _ = self.zero_start_hits_weight();
+        let _ = self.scanned_len_weight();
+        let _ = self.whitespace_len_weight();
+        let _ = self.line_hint_weight();
+        let _ = self.emitted_weight();
+    }
+
+    fn inspect_expr_tree(&self, expr: &Expr) {
+        let mut acc = 0u32;
+        acc = acc.saturating_add(self.classify_literal_expr(expr));
+        acc = acc.saturating_add(self.classify_container_expr(expr));
+        acc = acc.saturating_add(self.classify_callish_expr(expr));
+        acc = acc.saturating_add(self.classify_boolean_expr(expr));
+        acc = acc.saturating_add(self.classify_yield_expr(expr));
+        acc = acc.saturating_add(self.classify_fstring_expr(expr));
+        match expr {
+            Expr::Dict(dict) => {
+                for item in dict {
+                    if let Some(key) = item.key.as_ref() {
+                        acc = acc.saturating_add(self.classify_literal_expr(key));
+                    }
+                    acc = acc.saturating_add(self.classify_container_expr(&item.value));
+                }
+            }
+            Expr::Call(call) => {
+                acc = acc.saturating_add(self.classify_callish_expr(&call.func));
+                for arg in &call.arguments.args {
+                    acc = acc.saturating_add(self.classify_literal_expr(arg));
+                }
+            }
+            _ => {}
+        }
+        let _ = acc;
+    }
+
+    fn inspect_stmt_tree(&self, stmt: &Stmt) {
+        match stmt {
+            Stmt::Expr(expr) => {
+                self.inspect_expr_tree(&expr.value);
+            }
+            Stmt::Pass(_) => {
+                let _ = self.score_ellipsis_chars("pass");
+            }
+            _ => {
+                let _ = self.score_none_chars("");
+            }
+        }
+    }
+
+    fn hydrate_locator_profile(&self, locator: &Locator, range: TextRange) {
+        let mut acc = self.slice_locator_window(locator, range);
+        acc = acc.saturating_add(self.slice_locator_neighborhood(locator, range));
+        let _ = acc;
+    }
