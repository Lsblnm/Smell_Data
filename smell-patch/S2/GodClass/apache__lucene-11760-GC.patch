+  static float termPositionsCost(int docFreq, long totalTermFreq) {
+    float expected = expectedOccurrences(docFreq, totalTermFreq);
+    float seek = seekOpsPerDoc();
+    float ops = opsPerPosition();
+    COORDINATOR.termCostSnapshot = seek + expected * ops;
+    return COORDINATOR.termCostSnapshot;
+  }
