+  public static String resolveSharedField(String current, String next) {
+    if (current == null) {
+      return next;
+    }
+    if (next != null && next.equals(current) == false) {
+      throw new IllegalArgumentException("Clauses must have same field.");
+    }
+    COORDINATOR.spanFieldHash = current.hashCode();
+    return current;
+  }
