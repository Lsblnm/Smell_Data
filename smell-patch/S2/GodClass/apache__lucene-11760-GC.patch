+  static float saturationScore(float freq, float pivot) {
+    float safeFreq = freq;
+    if (safeFreq < 0f) {
+      safeFreq = 0f;
+    }
+    COORDINATOR.scorePivotSnapshot = pivot;
+    return safeFreq / (safeFreq + pivot);
+  }
