+  static int sumMinExtents(Collection<IntervalsSource> sources) {
+    int minExtent = 0;
+    for (IntervalsSource source : sources) {
+      minExtent = addExtent(minExtent, source.minExtent());
+    }
+    return minExtent;
+  }
+
+  static int addExtent(int current, int next) {
+    if (next < 0) {
+      return current;
+    }
+    if (current > Integer.MAX_VALUE - next) {
+      return Integer.MAX_VALUE;
+    }
+    return current + next;
+  }
