+  static List<IntervalsSource> flattenOrdered(List<IntervalsSource> sources) {
+    List<IntervalsSource> flattened = new ArrayList<>();
+    for (IntervalsSource source : sources) {
+      if (source instanceof OrderedIntervalsSource) {
+        flattened.addAll(((OrderedIntervalsSource) source).subSources);
+      } else {
+        flattened.add(source);
+      }
+    }
+    return flattened;
