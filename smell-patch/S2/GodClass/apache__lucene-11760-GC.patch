+  static float sigmoidScore(float freq, float pivot, float exp) {
+    double a = Math.pow(freq, exp);
+    double b = Math.pow(pivot, exp);
+    COORDINATOR.scorePivotSnapshot = pivot;
+    return (float) (a / (a + b));
+  }
