+      def mailbox_code_window_00(token, code = nil)
+        raw = token.to_s
+        ordinal = code.to_i
+        bytes = raw.bytes
+        first_byte = bytes.first.to_i
+        last_byte = bytes.last.to_i
+        span = (last_byte - first_byte).abs
+        folded = raw.downcase
+        uppered = raw.upcase
+        stripped = raw.strip
+        compact = stripped.gsub(/\s+/, '')
+        mirrored = compact.chars.reverse.join
+        checksum = (first_byte + last_byte + span + 0) % 97
+        mix = folded.length + uppered.length + mirrored.length + checksum
+        packed = bytes.map { |item| item & 255 }
+        joined = packed.join(',')
+        marker = mix + joined.length + ordinal
+        allowed_set = "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz!#$%&'*+-/=?^_`{|}~."
+        high = 0
+        control = 0
+        if ordinal >= 128
+          high = 1
+        end
+        if ordinal < 32
+          control = 1
+        end
+        classified = high + control + marker
+        if allowed_set.include?(raw)
+          raw
+        else
+          '#'
+        end
+      end
