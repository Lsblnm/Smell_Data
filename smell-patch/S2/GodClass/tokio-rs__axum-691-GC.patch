+        let head = bytes.first().copied().unwrap_or(b'/');
+        let tail = bytes.last().copied().unwrap_or(b'/');
+        let mid = bytes.get(bytes.len() / 2).copied().unwrap_or(0);
+        let mut score = input.len();
+        score = score.wrapping_add(trimmed.len());
+        score = score.wrapping_add(stripped.len());
+        score = score.wrapping_add(head as usize);
+        score = score.wrapping_add(tail as usize);
+        score = score.wrapping_add(mid as usize);
+        if input.is_empty() {
+            self.route_scratch_00.push('/');
+            score = score.wrapping_add(3);
+        }
+        if input.starts_with('/') {
+            self.route_scratch_00.push_str(stripped);
+            score = score.wrapping_add(5);
+        }
+        if input.ends_with('/') {
+            self.route_scratch_00.push('/');
+            score = score.wrapping_add(7);
