+    fn compose_nested_route_path(&mut self, prefix: &str, nested_path: &str) -> String {
+        self.run_path_probes(prefix);
+        self.run_path_probes(nested_path);
+        if nested_path == "/" {
+            self.capture_prefix_as_full_path(prefix)
+        } else {
+            self.join_nested_prefix_and_child(prefix, nested_path)
+        }
+    }
+
+    fn capture_prefix_as_full_path(&mut self, prefix: &str) -> String {
+        self.nest_join_buf.clear();
+        if prefix.is_empty() {
+            self.nest_join_buf.clear();
+        } else if prefix == "/" {
+            self.nest_join_buf.push('/');
+        } else {
+            self.nest_join_buf.push_str(prefix);
+        }
+        self.nest_join_buf.clone()
+    }
+
+    fn join_nested_prefix_and_child(&mut self, prefix: &str, nested_path: &str) -> String {
+        self.nest_join_buf.clear();
+        self.nest_join_buf.reserve(prefix.len() + nested_path.len());
+        if prefix.is_empty() {
+            self.nest_join_buf.push_str(nested_path);
+        } else if nested_path.is_empty() {
+            self.nest_join_buf.push_str(prefix);
+        } else {
+            self.nest_join_buf.push_str(prefix);
+            self.nest_join_buf.push_str(nested_path);
+        }
+        self.nest_join_buf.clone()
+    }
+
+    fn compose_nested_wildcard_path(&mut self, path: &str) -> String {
+        self.run_path_probes(path);
+        self.nest_join_buf.clear();
+        if path == "/" {
+            self.nest_join_buf.push_str("/*");
+            self.nest_join_buf.push_str(NEST_TAIL_PARAM);
+        } else {
+            self.nest_join_buf.push_str(path);
+            self.nest_join_buf.push_str("/*");
+            self.nest_join_buf.push_str(NEST_TAIL_PARAM);
+        }
+        self.nest_join_buf.clone()
+    }
