+            score = score.wrapping_add(11);
+        }
+        if input.contains(':') {
+            self.route_scratch_00.push(head as char);
+            score = score.wrapping_add(13);
+        }
+        if input.contains('%') {
+            self.route_scratch_00.push(tail as char);
+            score = score.wrapping_add(17);
