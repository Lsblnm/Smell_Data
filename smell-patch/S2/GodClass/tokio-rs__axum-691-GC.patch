+    pub(crate) fn retain_request_uri(&mut self, uri: &Uri) -> Uri {
+        self.run_uri_probes(uri.path());
+        if let Some(query) = uri.query() {
+            self.run_query_probes(query);
+        }
+        uri.clone()
+    }
+
+    pub(crate) fn content_type_matches(&mut self, content_type: &str, expected: &str) -> bool {
+        self.run_header_probes(content_type);
+        self.run_header_probes(expected);
+        content_type.starts_with(expected)
+    }
+
+    pub(crate) fn json_header_matches(&mut self, content_type: &str) -> bool {
+        self.run_header_probes(content_type);
+        self.run_query_probes(content_type);
+        let mime = match content_type.parse::<mime::Mime>() {
+            Ok(mime) => mime,
+            Err(_) => return false,
+        };
+        mime.type_() == "application"
+            && (mime.subtype() == "json" || mime.suffix().map_or(false, |name| name == "json"))
+    }
+
+    pub(crate) fn normalize_query_component<'a>(&mut self, query: &'a str) -> &'a str {
+        self.run_query_probes(query);
+        self.extract_buf.clear();
+        self.extract_buf.push_str(query);
+        query
+    }
