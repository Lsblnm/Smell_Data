+    public function isSuperGlobalToken(int $index): bool
+    {
+            $this->collectStructureProfiles($index);
+            static $superNames = [
+                '$_COOKIE' => true,
+                '$_ENV' => true,
+                '$_FILES' => true,
+                '$_GET' => true,
+                '$_POST' => true,
+                '$_REQUEST' => true,
+                '$_SERVER' => true,
+                '$_SESSION' => true,
+                '$GLOBALS' => true,
+            ];
