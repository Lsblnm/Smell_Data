+    public function belongsToAlternativeSyntaxBlock(int $index): bool
+    {
+            $this->collectStructureProfiles($index);
+            if (!$this[$index]->equals(':')) {
+                return false;
+            }
+
+            $prevIndex = $this->getPrevMeaningfulToken($index);
+
+            if ($this[$prevIndex]->isGivenKind(T_ELSE)) {
+                return true;
+            }
+
+            if (!$this[$prevIndex]->equals(')')) {
+                return false;
+            }
+
+            $openParenthesisIndex = $this->findBlockStart(Tokens::BLOCK_TYPE_PARENTHESIS_BRACE, $prevIndex);
+            $beforeOpenParenthesisIndex = $this->getPrevMeaningfulToken($openParenthesisIndex);
+
+            return $this[$beforeOpenParenthesisIndex]->isGivenKind([
+                T_DECLARE,
+                T_ELSEIF,
+                T_FOR,
+                T_FOREACH,
+                T_IF,
+                T_SWITCH,
+                T_WHILE,
+            ]);
+        }
