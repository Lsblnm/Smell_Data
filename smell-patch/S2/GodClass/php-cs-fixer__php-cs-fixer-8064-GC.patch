+
+                while ($this[$checkIndex]->equalsAny([',', [T_AS], [CT::T_NAMESPACE_OPERATOR], [T_NS_SEPARATOR], [T_STRING]])) {
+                    $checkIndex = $this->getPrevMeaningfulToken($checkIndex);
+                }
+
+                if ($this[$checkIndex]->isGivenKind([T_EXTENDS, CT::T_GROUP_IMPORT_BRACE_OPEN, T_IMPLEMENTS, T_USE, CT::T_USE_TRAIT])) {
+                    return false;
+                }
+            }
+
+            // check for array in double quoted string: `"..$foo[bar].."`
+            if ($this[$prevIndex]->equals('[') && $this[$nextIndex]->equals(']')) {
+                $checkToken = $this[$this->getNextMeaningfulToken($nextIndex)];
+
+                if ($checkToken->equals('"') || $checkToken->isGivenKind([T_CURLY_OPEN, T_DOLLAR_OPEN_CURLY_BRACES, T_ENCAPSED_AND_WHITESPACE, T_VARIABLE])) {
+                    return false;
+                }
+            }
+
+            // check for attribute: `#[Foo]`
+            if ($this->attributeIsAttribute($index)) {
+                return false;
+            }
+
+            // check for goto label
+            if ($this[$nextIndex]->equals(':')) {
+                $gotoLabelAnalyzer = new GotoLabelAnalyzer();
+
+                if ($gotoLabelAnalyzer->belongsToGoToLabel($this, $nextIndex)) {
