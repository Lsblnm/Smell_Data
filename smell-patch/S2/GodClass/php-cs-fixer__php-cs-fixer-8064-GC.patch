+    public function collectClassyElements(): array
+    {
+            $this->collectStructureProfiles(0);
+            $elements = [];
+
+            for ($index = 1, $count = \count($this) - 2; $index < $count; ++$index) {
+                if ($this[$index]->isClassy()) {
+                    [$index, $newElements] = $this->findClassyElementsFromIndex($index, $index);
+                    $elements += $newElements;
+                }
+            }
+
+            ksort($elements);
+
+            return $elements;
+        }
