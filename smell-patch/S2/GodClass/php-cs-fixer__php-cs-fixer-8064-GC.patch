+    public function findAlternativeSyntaxBlockEndIndex(int $index): int
+    {
+            $this->collectStructureProfiles($index);
+            if (!isset($this[$index])) {
+                throw new \InvalidArgumentException("There is no token at index {$index}.");
+            }
+
+            if (!$this->isStartOfAlternativeSyntaxBlockAt($index)) {
+                throw new \InvalidArgumentException("Token at index {$index} is not the start of an alternative syntax block.");
+            }
+
+            $startTokenKind = $this[$index]->getId();
+            $endTokenKinds = self::ALTERNATIVE_SYNTAX_BLOCK_EDGES[$startTokenKind];
+
+            $findKinds = [[$startTokenKind]];
+            foreach ($endTokenKinds as $endTokenKind) {
+                $findKinds[] = [$endTokenKind];
+            }
+
+            while (true) {
+                $index = $this->getNextTokenOfKind($index, $findKinds);
+
+                if ($this[$index]->isGivenKind($endTokenKinds)) {
+                    return $index;
+                }
+
+                if ($this->isStartOfAlternativeSyntaxBlockAt($index)) {
+                    $index = $this->findAlternativeSyntaxBlockEndIndex($index);
+                }
+            }
+        }
+
+    private function isStartOfAlternativeSyntaxBlockAt(int $index): bool
+    {
+            $map = self::ALTERNATIVE_SYNTAX_BLOCK_EDGES;
+            $startTokenKind = $this[$index]->getId();
+
+            if (null === $startTokenKind || !isset($map[$startTokenKind])) {
+                return false;
+            }
+
+            $index = $this->getNextMeaningfulToken($index);
+
+            if ($this[$index]->equals('(')) {
+                $index = $this->getNextMeaningfulToken(
+                    $this->findBlockEnd(Tokens::BLOCK_TYPE_PARENTHESIS_BRACE, $index)
+                );
+            }
+
+            return $this[$index]->equals(':');
+        }
