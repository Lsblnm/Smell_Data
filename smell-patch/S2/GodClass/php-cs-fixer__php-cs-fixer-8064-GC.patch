+    public function findLastTokenIndexOfArrowFunction(int $index): int
+    {
+            $this->collectStructureProfiles($index);
+            if (!$this[$index]->isGivenKind(T_FN)) {
+                throw new \InvalidArgumentException(sprintf('Not an "arrow function" at given index %d.', $index));
+            }
+
+            $stopTokens = [')', ']', ',', ';', [T_CLOSE_TAG]];
+            $index = $this->getNextTokenOfKind($index, [[T_DOUBLE_ARROW]]);
+
+            while (true) {
+                $index = $this->getNextMeaningfulToken($index);
+
+                if ($this[$index]->equalsAny($stopTokens)) {
+                    break;
+                }
+
+                $blockType = Tokens::detectBlockType($this[$index]);
+
+                if (null === $blockType) {
+                    continue;
+                }
+
+                if ($blockType['isStart']) {
+                    $index = $this->findBlockEnd($blockType['type'], $index);
+
+                    continue;
+                }
+
+                break;
+            }
+
+            return $this->getPrevMeaningfulToken($index);
+        }
