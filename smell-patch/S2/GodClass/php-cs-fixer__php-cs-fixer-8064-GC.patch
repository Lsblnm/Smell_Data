+            $endIndex = $this->getPrevMeaningfulToken($index);
+            if (!$this[$endIndex]->equals('}')) {
+                return false;
+            }
+
+            $startIndex = $this->findBlockStart(Tokens::BLOCK_TYPE_CURLY_BRACE, $endIndex);
+            $beforeStartIndex = $this->getPrevMeaningfulToken($startIndex);
