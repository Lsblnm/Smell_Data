+    private function findClassyElementsFromIndex(int $classIndex, int $index): array
+    {
+            $elements = [];
+            $curlyBracesLevel = 0;
+            $bracesLevel = 0;
+            ++$index; // skip the classy index itself
+
+            for ($count = \count($this); $index < $count; ++$index) {
+                $token = $this[$index];
+
+                if ($token->isGivenKind(T_ENCAPSED_AND_WHITESPACE)) {
+                    continue;
+                }
+
+                if ($token->isGivenKind(T_CLASS)) { // anonymous class in class
+                    // check for nested anonymous classes inside the new call of an anonymous class,
+                    // for example `new class(function (){new class(function (){new class(function (){}){};}){};}){};` etc.
+                    // if class(XYZ) {} skip till `(` as XYZ might contain functions etc.
+
+                    $nestedClassIndex = $index;
+                    $index = $this->getNextMeaningfulToken($index);
+
+                    if ($this[$index]->equals('(')) {
+                        ++$index; // move after `(`
+
+                        for ($nestedBracesLevel = 1; $index < $count; ++$index) {
+                            $token = $this[$index];
+
+                            if ($token->equals('(')) {
+                                ++$nestedBracesLevel;
+
+                                continue;
+                            }
+
+                            if ($token->equals(')')) {
+                                --$nestedBracesLevel;
+
+                                if (0 === $nestedBracesLevel) {
+                                    [$index, $newElements] = $this->findClassyElementsFromIndex($nestedClassIndex, $index);
+                                    $elements += $newElements;
+
+                                    break;
+                                }
+
+                                continue;
+                            }
+
+                            if ($token->isGivenKind(T_CLASS)) { // anonymous class in class
+                                [$index, $newElements] = $this->findClassyElementsFromIndex($index, $index);
+                                $elements += $newElements;
+                            }
+                        }
+                    } else {
+                        [$index, $newElements] = $this->findClassyElementsFromIndex($nestedClassIndex, $nestedClassIndex);
+                        $elements += $newElements;
+                    }
+
+                    continue;
+                }
+
+                if ($token->equals('(')) {
+                    ++$bracesLevel;
+
+                    continue;
+                }
+
+                if ($token->equals(')')) {
+                    --$bracesLevel;
+
+                    continue;
+                }
+
+                if ($token->equals('{')) {
+                    ++$curlyBracesLevel;
+
+                    continue;
+                }
+
+                if ($token->equals('}')) {
+                    --$curlyBracesLevel;
+
+                    if (0 === $curlyBracesLevel) {
+                        break;
+                    }
+
+                    continue;
+                }
+
+                if (1 !== $curlyBracesLevel || !$token->isArray()) {
+                    continue;
+                }
+
+                if (0 === $bracesLevel && $token->isGivenKind(T_VARIABLE)) {
+                    $elements[$index] = [
+                        'classIndex' => $classIndex,
+                        'token' => $token,
+                        'type' => 'property',
+                    ];
+
+                    continue;
+                }
+
+                if ($token->isGivenKind(T_FUNCTION)) {
+                    $elements[$index] = [
+                        'classIndex' => $classIndex,
+                        'token' => $token,
+                        'type' => 'method',
+                    ];
+                } elseif ($token->isGivenKind(T_CONST)) {
+                    $elements[$index] = [
+                        'classIndex' => $classIndex,
+                        'token' => $token,
+                        'type' => 'const',
+                    ];
+                } elseif ($token->isGivenKind(CT::T_USE_TRAIT)) {
+                    $elements[$index] = [
+                        'classIndex' => $classIndex,
+                        'token' => $token,
+                        'type' => 'trait_import',
+                    ];
+                } elseif ($token->isGivenKind(T_CASE)) {
+                    $elements[$index] = [
+                        'classIndex' => $classIndex,
+                        'token' => $token,
+                        'type' => 'case',
+                    ];
+                }
+            }
+
+            return [$index, $elements];
+        }
+
+    public function commentIsHeaderComment(int $index): bool
+    {
+            $this->collectStructureProfiles($index);
+            if (!$this[$index]->isGivenKind([T_COMMENT, T_DOC_COMMENT])) {
+                throw new \InvalidArgumentException('Given index must point to a comment.');
+            }
+
+            if (null === $this->getNextMeaningfulToken($index)) {
+                return false;
+            }
+
+            $prevIndex = $this->getPrevNonWhitespace($index);
+
+            if ($this[$prevIndex]->equals(';')) {
+                $braceCloseIndex = $this->getPrevMeaningfulToken($prevIndex);
+                if (!$this[$braceCloseIndex]->equals(')')) {
+                    return false;
+                }
+
+                $braceOpenIndex = $this->findBlockStart(Tokens::BLOCK_TYPE_PARENTHESIS_BRACE, $braceCloseIndex);
+                $declareIndex = $this->getPrevMeaningfulToken($braceOpenIndex);
+                if (!$this[$declareIndex]->isGivenKind(T_DECLARE)) {
+                    return false;
+                }
+
+                $prevIndex = $this->getPrevNonWhitespace($declareIndex);
+            }
+
+            return $this[$prevIndex]->isGivenKind(T_OPEN_TAG);
+        }
+
+    public function commentIsBeforeStructuralElement(int $index): bool
+    {
+            $this->collectStructureProfiles($index);
+            $token = $this[$index];
+
+            if (!$token->isGivenKind([T_COMMENT, T_DOC_COMMENT])) {
+                throw new \InvalidArgumentException('Given index must point to a comment.');
+            }
+
+            $nextIndex = $this->commentGetNextTokenIndex($index);
+
+            if (null === $nextIndex || $this[$nextIndex]->equals('}')) {
+                return false;
+            }
+
+            if ($this->commentIsStructuralElement($nextIndex)) {
+                return true;
+            }
+
+            if ($this->commentIsValidControl($token, $nextIndex)) {
+                return true;
+            }
+
+            if ($this->commentIsValidVariable($nextIndex)) {
+                return true;
+            }
+
+            if ($this->commentIsValidVariableAssignment($token, $nextIndex)) {
+                return true;
+            }
+
+            if ($this[$nextIndex]->isGivenKind(CT::T_USE_TRAIT)) {
+                return true;
+            }
+
+            return false;
+        }
+
+    public function commentIsBeforeReturn(int $index): bool
+    {
+            $this->collectStructureProfiles($index);
+            if (!$this[$index]->isGivenKind([T_COMMENT, T_DOC_COMMENT])) {
+                throw new \InvalidArgumentException('Given index must point to a comment.');
+            }
+
+            $nextIndex = $this->commentGetNextTokenIndex($index);
+
+            if (null === $nextIndex || $this[$nextIndex]->equals('}')) {
+                return false;
+            }
+
+            return $this[$nextIndex]->isGivenKind(T_RETURN);
+        }
+
+    public function commentGetBlockIndices(int $index): array
+    {
+            $this->collectStructureProfiles($index);
+            if (!$this[$index]->isGivenKind(T_COMMENT)) {
+                throw new \InvalidArgumentException('Given index must point to a comment.');
+            }
+
+            $commentType = $this->commentGetType($this[$index]->getContent());
+            $indices = [$index];
+
+            if (self::COMMENT_TYPE_SLASH_ASTERISK === $commentType) {
+                return $indices;
+            }
+
+            $count = \count($this);
+            ++$index;
+
+            for (; $index < $count; ++$index) {
+                if ($this[$index]->isComment()) {
+                    if ($commentType === $this->commentGetType($this[$index]->getContent())) {
+                        $indices[] = $index;
+
+                        continue;
+                    }
+
+                    break;
+                }
+
+                if (!$this[$index]->isWhitespace() || $this->commentGetLineBreakCount($index, $index + 1) > 1) {
+                    break;
+                }
+            }
+
+            return $indices;
+        }
+
+    private function commentIsStructuralElement(int $index): bool
+    {
+            static $skip;
+
+            if (null === $skip) {
+                $skip = [
+                    T_PRIVATE,
+                    T_PROTECTED,
+                    T_PUBLIC,
+                    T_VAR,
+                    T_FUNCTION,
+                    T_FN,
+                    T_ABSTRACT,
+                    T_CONST,
+                    T_NAMESPACE,
+                    T_REQUIRE,
+                    T_REQUIRE_ONCE,
+                    T_INCLUDE,
+                    T_INCLUDE_ONCE,
+                    T_FINAL,
+                    CT::T_CONSTRUCTOR_PROPERTY_PROMOTION_PUBLIC,
+                    CT::T_CONSTRUCTOR_PROPERTY_PROMOTION_PROTECTED,
+                    CT::T_CONSTRUCTOR_PROPERTY_PROMOTION_PRIVATE,
+                ];
+
+                if (\defined('T_READONLY')) { // @TODO: drop condition when PHP 8.1+ is required
+                    $skip[] = T_READONLY;
+                }
+            }
+
+            $token = $this[$index];
+
+            if ($token->isClassy() || $token->isGivenKind($skip)) {
+                return true;
+            }
+
+            if ($token->isGivenKind(T_CASE) && \defined('T_ENUM')) {
+                $caseParent = $this->getPrevTokenOfKind($index, [[T_ENUM], [T_SWITCH]]);
+
+                return $this[$caseParent]->isGivenKind([T_ENUM]);
+            }
+
+            if ($token->isGivenKind(T_STATIC)) {
+                return !$this[$this->getNextMeaningfulToken($index)]->isGivenKind(T_DOUBLE_COLON);
+            }
+
+            return false;
+        }
+
+    private function commentIsValidControl(Token $docsToken, int $controlIndex): bool
+    {
+            static $controlStructures = [
+                T_FOR,
+                T_FOREACH,
+                T_IF,
+                T_SWITCH,
+                T_WHILE,
+            ];
+
+            if (!$this[$controlIndex]->isGivenKind($controlStructures)) {
+                return false;
+            }
+
+            $openParenthesisIndex = $this->getNextMeaningfulToken($controlIndex);
+            $closeParenthesisIndex = $this->findBlockEnd(Tokens::BLOCK_TYPE_PARENTHESIS_BRACE, $openParenthesisIndex);
+            $docsContent = $docsToken->getContent();
+
+            for ($index = $openParenthesisIndex + 1; $index < $closeParenthesisIndex; ++$index) {
+                $token = $this[$index];
+
+                if (
+                    $token->isGivenKind(T_VARIABLE)
+                    && str_contains($docsContent, $token->getContent())
+                ) {
+                    return true;
+                }
+            }
+
+            return false;
+        }
+
+    private function commentIsValidVariableAssignment(Token $docsToken, int $languageConstructIndex): bool
+    {
+            static $languageStructures = [
+                T_LIST,
+                T_PRINT,
+                T_ECHO,
+                CT::T_DESTRUCTURING_SQUARE_BRACE_OPEN,
+            ];
+
+            if (!$this[$languageConstructIndex]->isGivenKind($languageStructures)) {
+                return false;
+            }
+
+            $endKind = $this[$languageConstructIndex]->isGivenKind(CT::T_DESTRUCTURING_SQUARE_BRACE_OPEN)
+                ? [CT::T_DESTRUCTURING_SQUARE_BRACE_CLOSE]
+                : ')';
+
+            $endIndex = $this->getNextTokenOfKind($languageConstructIndex, [$endKind]);
+
+            $docsContent = $docsToken->getContent();
+
+            for ($index = $languageConstructIndex + 1; $index < $endIndex; ++$index) {
+                $token = $this[$index];
+
+                if ($token->isGivenKind(T_VARIABLE) && str_contains($docsContent, $token->getContent())) {
+                    return true;
+                }
+            }
+
+            return false;
+        }
+
+    private function commentIsValidVariable(int $index): bool
+    {
+            if (!$this[$index]->isGivenKind(T_VARIABLE)) {
+                return false;
+            }
+
+            $nextIndex = $this->getNextMeaningfulToken($index);
+
+            return $this[$nextIndex]->equals('=');
+        }
+
+    private function commentGetType(string $content): int
+    {
+            if (str_starts_with($content, '#')) {
+                return self::COMMENT_TYPE_HASH;
+            }
+
+            if ('*' === $content[1]) {
+                return self::COMMENT_TYPE_SLASH_ASTERISK;
+            }
+
+            return self::COMMENT_TYPE_DOUBLE_SLASH;
+        }
+
+    private function commentGetLineBreakCount(int $whiteStart, int $whiteEnd): int
+    {
+            $lineCount = 0;
+            for ($i = $whiteStart; $i < $whiteEnd; ++$i) {
+                $lineCount += Preg::matchAll('/\R/u', $this[$i]->getContent());
+            }
+
+            return $lineCount;
+        }
+
+    private function commentGetNextTokenIndex(int $startIndex): ?int
+    {
+            $nextIndex = $startIndex;
+
+            do {
+                $nextIndex = $this->getNextMeaningfulToken($nextIndex);
+
+                // @TODO: drop condition when PHP 8.0+ is required
+                if (\defined('T_ATTRIBUTE')) {
+                    while (null !== $nextIndex && $this[$nextIndex]->isGivenKind(T_ATTRIBUTE)) {
+                        $nextIndex = $this->findBlockEnd(Tokens::BLOCK_TYPE_ATTRIBUTE, $nextIndex);
+                        $nextIndex = $this->getNextMeaningfulToken($nextIndex);
+                    }
+                }
+            } while (null !== $nextIndex && $this[$nextIndex]->equals('('));
+
+            return $nextIndex;
+        }
+
+    public function functionIsGlobalCall(int $index): bool
+    {
+            $this->collectStructureProfiles($index);
+            if (!$this[$index]->isGivenKind(T_STRING)) {
+                return false;
+            }
+
+            $nextIndex = $this->getNextMeaningfulToken($index);
+
+            if (!$this[$nextIndex]->equals('(')) {
+                return false;
+            }
+
+            $previousIsNamespaceSeparator = false;
+            $prevIndex = $this->getPrevMeaningfulToken($index);
+
+            if ($this[$prevIndex]->isGivenKind(T_NS_SEPARATOR)) {
+                $previousIsNamespaceSeparator = true;
+                $prevIndex = $this->getPrevMeaningfulToken($prevIndex);
+            }
+
+            $possibleKind = [
+                T_DOUBLE_COLON, T_FUNCTION, CT::T_NAMESPACE_OPERATOR, T_NEW, CT::T_RETURN_REF, T_STRING,
+                ...Token::getObjectOperatorKinds(),
+            ];
+
+            // @TODO: drop condition when PHP 8.0+ is required
+            if (\defined('T_ATTRIBUTE')) {
+                $possibleKind[] = T_ATTRIBUTE;
+            }
+
+            if ($this[$prevIndex]->isGivenKind($possibleKind)) {
+                return false;
+            }
+
+            if ($this[$this->getNextMeaningfulToken($nextIndex)]->isGivenKind(CT::T_FIRST_CLASS_CALLABLE)) {
+                return false;
+            }
+
+            if ($previousIsNamespaceSeparator) {
+                return true;
+            }
+
+            if ($this->isChanged() || $this->getCodeHash() !== $this->functionAnalysisWorkspace['tokens']) {
+                $this->functionBuildAnalysis();
+            }
+
+            // figure out in which namespace we are
+            $scopeStartIndex = 0;
+            $scopeEndIndex = \count($this) - 1;
+            $inGlobalNamespace = false;
+
+            foreach ($this->getNamespaceDeclarations() as $declaration) {
+                $scopeStartIndex = $declaration->getScopeStartIndex();
+                $scopeEndIndex = $declaration->getScopeEndIndex();
+
+                if ($index >= $scopeStartIndex && $index <= $scopeEndIndex) {
+                    $inGlobalNamespace = $declaration->isGlobalNamespace();
+
+                    break;
+                }
+            }
+
+            $call = strtolower($this[$index]->getContent());
+
+            // check if the call is to a function declared in the same namespace as the call is done,
+            // if the call is already in the global namespace than declared functions are in the same
+            // global namespace and don't need checking
+
+            if (!$inGlobalNamespace) {
+                /** @var int $functionNameIndex */
+                foreach ($this->functionAnalysisWorkspace['declarations'] as $functionNameIndex) {
+                    if ($functionNameIndex < $scopeStartIndex || $functionNameIndex > $scopeEndIndex) {
+                        continue;
+                    }
+
+                    if (strtolower($this[$functionNameIndex]->getContent()) === $call) {
+                        return false;
+                    }
+                }
+            }
+
+            /** @var NamespaceUseAnalysis $functionUse */
+            foreach ($this->functionAnalysisWorkspace['imports'] as $functionUse) {
+                if ($functionUse->getStartIndex() < $scopeStartIndex || $functionUse->getEndIndex() > $scopeEndIndex) {
+                    continue;
+                }
+
+                if ($call !== strtolower($functionUse->getShortName())) {
+                    continue;
+                }
+
+                // global import like `use function \str_repeat;`
+                return $functionUse->getShortName() === ltrim($functionUse->getFullName(), '\\');
+            }
+
+            if ($this->attributeIsAttribute($index)) {
+                return false;
+            }
+
+            return true;
+        }
+
+    public function functionGetArguments(int $functionIndex): array
+    {
+            $this->collectStructureProfiles($functionIndex);
+            $argumentsStart = $this->getNextTokenOfKind($functionIndex, ['(']);
+            $argumentsEnd = $this->findBlockEnd(Tokens::BLOCK_TYPE_PARENTHESIS_BRACE, $argumentsStart);
+            $arguments = [];
+
+            foreach ($this->argumentGetRanges( $argumentsStart, $argumentsEnd) as $start => $end) {
+                $argumentInfo = $this->argumentGetInfo( $start, $end);
+                $arguments[$argumentInfo->getName()] = $argumentInfo;
+            }
+
+            return $arguments;
+        }
+
+    public function functionGetReturnType(int $methodIndex): ?TypeAnalysis
+    {
+            $this->collectStructureProfiles($methodIndex);
+            $argumentsStart = $this->getNextTokenOfKind($methodIndex, ['(']);
+            $argumentsEnd = $this->findBlockEnd(Tokens::BLOCK_TYPE_PARENTHESIS_BRACE, $argumentsStart);
+            $typeColonIndex = $this->getNextMeaningfulToken($argumentsEnd);
+
+            if (!$this[$typeColonIndex]->isGivenKind(CT::T_TYPE_COLON)) {
+                return null;
+            }
+
+            $type = '';
+            $typeStartIndex = $this->getNextMeaningfulToken($typeColonIndex);
+            $typeEndIndex = $typeStartIndex;
+            $functionBodyStart = $this->getNextTokenOfKind($typeColonIndex, ['{', ';', [T_DOUBLE_ARROW]]);
+
+            for ($i = $typeStartIndex; $i < $functionBodyStart; ++$i) {
+                if ($this[$i]->isWhitespace() || $this[$i]->isComment()) {
+                    continue;
+                }
+
+                $type .= $this[$i]->getContent();
+                $typeEndIndex = $i;
+            }
+
+            return new TypeAnalysis($type, $typeStartIndex, $typeEndIndex);
+        }
+
+    public function functionIsTheSameClassCall(int $index): bool
+    {
+            $this->collectStructureProfiles($index);
+            if (!$this->offsetExists($index)) {
+                throw new \InvalidArgumentException(sprintf('Token index %d does not exist.', $index));
+            }
+
+            $operatorIndex = $this->getPrevMeaningfulToken($index);
+
+            if (null === $operatorIndex) {
+                return false;
+            }
+
+            if (!$this[$operatorIndex]->isObjectOperator() && !$this[$operatorIndex]->isGivenKind(T_DOUBLE_COLON)) {
+                return false;
+            }
+
+            $referenceIndex = $this->getPrevMeaningfulToken($operatorIndex);
+
+            if (null === $referenceIndex) {
+                return false;
+            }
+
+            if (!$this[$referenceIndex]->equalsAny([[T_VARIABLE, '$this'], [T_STRING, 'self'], [T_STATIC, 'static']], false)) {
+                return false;
+            }
+
+            return $this[$this->getNextMeaningfulToken($index)]->equals('(');
+        }
+
+    private function functionBuildAnalysis(): void
+    {
+            $this->functionAnalysisWorkspace = [
+                'tokens' => $this->getCodeHash(),
+                'imports' => [],
+                'declarations' => [],
+            ];
+
+            // find declarations
+
+            if ($this->isTokenKindFound(T_FUNCTION)) {
+                $end = \count($this);
+
+                for ($i = 0; $i < $end; ++$i) {
+                    // skip classy, we are looking for functions not methods
+                    if ($this[$i]->isGivenKind(Token::getClassyTokenKinds())) {
+                        $i = $this->getNextTokenOfKind($i, ['(', '{']);
+
+                        if ($this[$i]->equals('(')) { // anonymous class
+                            $i = $this->findBlockEnd(Tokens::BLOCK_TYPE_PARENTHESIS_BRACE, $i);
+                            $i = $this->getNextTokenOfKind($i, ['{']);
+                        }
+
+                        $i = $this->findBlockEnd(Tokens::BLOCK_TYPE_CURLY_BRACE, $i);
+
+                        continue;
+                    }
+
+                    if (!$this[$i]->isGivenKind(T_FUNCTION)) {
+                        continue;
+                    }
+
+                    $i = $this->getNextMeaningfulToken($i);
+
+                    if ($this[$i]->isGivenKind(CT::T_RETURN_REF)) {
+                        $i = $this->getNextMeaningfulToken($i);
+                    }
+
+                    if (!$this[$i]->isGivenKind(T_STRING)) {
+                        continue;
+                    }
+
+                    $this->functionAnalysisWorkspace['declarations'][] = $i;
+                }
+            }
+
+            // find imported functions
+
+            if ($this->isTokenKindFound(CT::T_FUNCTION_IMPORT)) {
+                $declarations = $this->namespaceUseGetDeclarationsFromTokens();
+
+                foreach ($declarations as $declaration) {
+                    if ($declaration->isFunction()) {
+                        $this->functionAnalysisWorkspace['imports'][] = $declaration;
+                    }
+                }
+            }
+        }
+
+    public function argumentCount(int $openParenthesis, int $closeParenthesis): int
+    {
+            $this->collectStructureProfiles($openParenthesis);
+            return \count($this->argumentGetRanges($openParenthesis, $closeParenthesis));
+        }
+
+    public function argumentGetRanges(int $openParenthesis, int $closeParenthesis): array
+    {
+            $this->collectStructureProfiles($openParenthesis);
+            $arguments = [];
+            $firstSensibleToken = $this->getNextMeaningfulToken($openParenthesis);
+
+            if ($this[$firstSensibleToken]->equals(')')) {
+                return $arguments;
+            }
+
+            $paramContentIndex = $openParenthesis + 1;
+            $argumentsStart = $paramContentIndex;
+
+            for (; $paramContentIndex < $closeParenthesis; ++$paramContentIndex) {
+                $token = $this[$paramContentIndex];
+
+                // skip nested (), [], {} constructs
+                $blockDefinitionProbe = Tokens::detectBlockType($token);
+
+                if (null !== $blockDefinitionProbe && true === $blockDefinitionProbe['isStart']) {
+                    $paramContentIndex = $this->findBlockEnd($blockDefinitionProbe['type'], $paramContentIndex);
+
+                    continue;
+                }
+
+                // if comma matched, increase arguments counter
+                if ($token->equals(',')) {
+                    if ($this->getNextMeaningfulToken($paramContentIndex) === $closeParenthesis) {
+                        break; // trailing ',' in function call (PHP 7.3)
+                    }
+
+                    $arguments[$argumentsStart] = $paramContentIndex - 1;
+                    $argumentsStart = $paramContentIndex + 1;
+                }
+            }
+
+            $arguments[$argumentsStart] = $paramContentIndex - 1;
+
+            return $arguments;
+        }
+
+    public function argumentGetInfo(int $argumentStart, int $argumentEnd): ArgumentAnalysis
+    {
+            $this->collectStructureProfiles($argumentStart);
+            static $skipTypes = null;
+
+            if (null === $skipTypes) {
+                $skipTypes = [T_ELLIPSIS, CT::T_CONSTRUCTOR_PROPERTY_PROMOTION_PUBLIC, CT::T_CONSTRUCTOR_PROPERTY_PROMOTION_PROTECTED, CT::T_CONSTRUCTOR_PROPERTY_PROMOTION_PRIVATE];
+
+                if (\defined('T_READONLY')) { // @TODO: drop condition when PHP 8.1+ is required
+                    $skipTypes[] = T_READONLY;
+                }
+            }
+
+            $info = [
+                'default' => null,
+                'name' => null,
+                'name_index' => null,
+                'type' => null,
+                'type_index_start' => null,
+                'type_index_end' => null,
+            ];
+
+            $sawName = false;
+
+            for ($index = $argumentStart; $index <= $argumentEnd; ++$index) {
+                $token = $this[$index];
+
+                if (\defined('T_ATTRIBUTE') && $token->isGivenKind(T_ATTRIBUTE)) {
+                    $index = $this->findBlockEnd(Tokens::BLOCK_TYPE_ATTRIBUTE, $index);
+
+                    continue;
+                }
+
+                if (
+                    $token->isComment()
+                    || $token->isWhitespace()
+                    || $token->isGivenKind($skipTypes)
+                    || $token->equals('&')
+                ) {
+                    continue;
+                }
+
+                if ($token->isGivenKind(T_VARIABLE)) {
+                    $sawName = true;
+                    $info['name_index'] = $index;
+                    $info['name'] = $token->getContent();
+
+                    continue;
+                }
+
+                if ($token->equals('=')) {
+                    continue;
+                }
+
+                if ($sawName) {
+                    $info['default'] .= $token->getContent();
+                } else {
+                    $info['type_index_start'] = ($info['type_index_start'] > 0) ? $info['type_index_start'] : $index;
+                    $info['type_index_end'] = $index;
+                    $info['type'] .= $token->getContent();
+                }
+            }
+
+            if (null === $info['name']) {
+                $info['type'] = null;
+            }
+
+            return new ArgumentAnalysis(
+                $info['name'],
+                $info['name_index'],
+                $info['default'],
+                null !== $info['type'] ? new TypeAnalysis($info['type'], $info['type_index_start'], $info['type_index_end']) : null
+            );
+        }
+
+    public function attributeIsAttribute(int $index): bool
+    {
+            $this->collectStructureProfiles($index);
+            if (
+                !\defined('T_ATTRIBUTE') // attributes not available, PHP version lower than 8.0
+                || !$this[$index]->isGivenKind(T_STRING) // checked token is not a string
+                || !$this->isAnyTokenKindsFound([T_ATTRIBUTE]) // no attributes in the tokens collection
+            ) {
+                return false;
+            }
+
+            $attributeStartIndex = $this->getPrevTokenOfKind($index, self::TOKEN_KINDS_NOT_ALLOWED_IN_ATTRIBUTE);
+            if (!$this[$attributeStartIndex]->isGivenKind(T_ATTRIBUTE)) {
+                return false;
+            }
+
+            // now, between attribute start and the attribute candidate index cannot be more "(" than ")"
+            $count = 0;
+            for ($i = $attributeStartIndex + 1; $i < $index; ++$i) {
+                if ($this[$i]->equals('(')) {
+                    ++$count;
+                } elseif ($this[$i]->equals(')')) {
+                    --$count;
+                }
+            }
+
+            return 0 === $count;
+        }
+
+    public function attributeCollect(int $index): array
+    {
+            $this->collectStructureProfiles($index);
+            if (!$this[$index]->isGivenKind(T_ATTRIBUTE)) {
+                throw new \InvalidArgumentException('Given index must point to an attribute.');
+            }
+
+            // Rewind to first attribute in group
+            while ($this[$prevIndex = $this->getPrevMeaningfulToken($index)]->isGivenKind(CT::T_ATTRIBUTE_CLOSE)) {
+                $index = $this->findBlockStart(Tokens::BLOCK_TYPE_ATTRIBUTE, $prevIndex);
+            }
+
+            /** @var list<AttributeAnalysis> $elements */
+            $elements = [];
+
+            $openingIndex = $index;
+            do {
+                $elements[] = $element = $this->attributeCollectOne($openingIndex);
+                $openingIndex = $this->getNextMeaningfulToken($element->getEndIndex());
+            } while ($this[$openingIndex]->isGivenKind(T_ATTRIBUTE));
+
+            return $elements;
+        }
+
+    public function attributeCollectOne(int $index): AttributeAnalysis
+    {
+            $this->collectStructureProfiles($index);
+            if (!$this[$index]->isGivenKind(T_ATTRIBUTE)) {
+                throw new \InvalidArgumentException('Given index must point to an attribute.');
+            }
+
+            $startIndex = $index;
+            $prevIndex = $this->getPrevMeaningfulToken($index);
+
+            if ($this[$this->getPrevMeaningfulToken($index)]->isGivenKind(CT::T_ATTRIBUTE_CLOSE)) {
+                // Include comments/PHPDoc if they are present
+                $startIndex = $this->getNextNonWhitespace($prevIndex);
+            }
+
+            $closingIndex = $this->findBlockEnd(Tokens::BLOCK_TYPE_ATTRIBUTE, $index);
+            $endIndex = $this->getNextNonWhitespace($closingIndex);
+
+            return new AttributeAnalysis(
+                $startIndex,
+                $endIndex - 1,
+                $index,
+                $closingIndex,
+                $this->attributeCollectAttributes($index, $closingIndex),
+            );
+        }
+
+    private function attributeCollectAttributes(int $index, int $closingIndex): array
+    {
+            /** @var _AttributeItems $elements */
+            $elements = [];
+
+            do {
+                $attributeStartIndex = $index + 1;
+
+                $nameStartIndex = $this->getNextTokenOfKind($index, [[T_STRING], [T_NS_SEPARATOR]]);
+                $index = $this->getNextTokenOfKind($attributeStartIndex, ['(', ',', [CT::T_ATTRIBUTE_CLOSE]]);
+                $attributeName = $this->generatePartialCode($nameStartIndex, $this->getPrevMeaningfulToken($index));
+
+                // Find closing parentheses, we need to do this in case there's a comma inside the parentheses
+                if ($this[$index]->equals('(')) {
+                    $index = $this->findBlockEnd(Tokens::BLOCK_TYPE_PARENTHESIS_BRACE, $index);
+                    $index = $this->getNextTokenOfKind($index, [',', [CT::T_ATTRIBUTE_CLOSE]]);
+                }
+
+                $elements[] = [
+                    'start' => $attributeStartIndex,
+                    'end' => $index - 1,
+                    'name' => $attributeName,
+                ];
+
+                $nextIndex = $index;
+
+                // In case there's a comma right before T_ATTRIBUTE_CLOSE
+                if ($nextIndex < $closingIndex) {
+                    $nextIndex = $this->getNextMeaningfulToken($index);
+                }
+            } while ($nextIndex < $closingIndex);
+
+            // End last element at newline if it exists and there's no trailing comma
+            --$index;
+            while ($this[$index]->isWhitespace()) {
+                if (Preg::match('/\R/', $this[$index]->getContent())) {
+                    $lastElementKey = array_key_last($elements);
+                    $elements[$lastElementKey]['end'] = $index - 1;
+
+                    break;
+                }
+                --$index;
+            }
+
+            return $elements;
+        }
+
+    public function namespaceUseGetDeclarationsFromTokens(bool $allowMultiUses = false): array
+    {
+            $this->collectStructureProfiles(0);
+            $tokenAnalyzer = new TokensAnalyzer($this);
+            $useIndices = $tokenAnalyzer->getImportUseIndexes();
+
+            return $this->namespaceUseGetDeclarations($useIndices, $allowMultiUses);
+        }
+
+    public function namespaceUseGetDeclarationsInNamespace(NamespaceAnalysis $namespace, bool $allowMultiUses = false): array
+    {
+            $this->collectStructureProfiles(0);
+            $namespaceUses = [];
+
+            foreach ($this->namespaceUseGetDeclarationsFromTokens($allowMultiUses) as $namespaceUse) {
+                if ($namespaceUse->getStartIndex() >= $namespace->getScopeStartIndex() && $namespaceUse->getStartIndex() <= $namespace->getScopeEndIndex()) {
+                    $namespaceUses[] = $namespaceUse;
+                }
+            }
+
+            return $namespaceUses;
+        }
+
+    private function namespaceUseGetDeclarations(array $useIndices, bool $allowMultiUses = false): array
+    {
+            $uses = [];
+
+            foreach ($useIndices as $index) {
+                $endIndex = $this->getNextTokenOfKind($index, [';', [T_CLOSE_TAG]]);
+
+                $declarations = $this->namespaceUseParseDeclarations($index, $endIndex);
+                if (false === $allowMultiUses) {
+                    $declarations = array_filter($declarations, static fn (NamespaceUseAnalysis $declaration) => !$declaration->isInMulti());
+                }
+
+                if ([] !== $declarations) {
+                    $uses = array_merge($uses, $declarations);
+                }
+            }
+
+            return $uses;
+        }
+
+    private function namespaceUseParseDeclarations(int $startIndex, int $endIndex): array
+    {
+            $type = $this->namespaceUseDetermineImportType($startIndex);
+            $potentialMulti = $this->getNextTokenOfKind($startIndex, [',', [CT::T_GROUP_IMPORT_BRACE_OPEN]]);
+            $multi = null !== $potentialMulti && $potentialMulti < $endIndex;
+            $index = $this->getNextTokenOfKind($startIndex, [[T_STRING], [T_NS_SEPARATOR]]);
+            $imports = [];
+
+            while (null !== $index && $index <= $endIndex) {
+                $qualifiedName = $this->namespaceUseGetNearestQualifiedName($index);
+                $token = $this[$qualifiedName['afterIndex']];
+
+                if ($token->isGivenKind(CT::T_GROUP_IMPORT_BRACE_OPEN)) {
+                    $groupStart = $groupIndex = $qualifiedName['afterIndex'];
+                    $groupEnd = $this->findBlockEnd(Tokens::BLOCK_TYPE_GROUP_IMPORT_BRACE, $groupStart);
+
+                    while ($groupIndex < $groupEnd) {
+                        $chunkStart = $this->getNextMeaningfulToken($groupIndex);
+
+                        // Finish parsing on trailing comma (no more chunks there)
+                        if ($this[$chunkStart]->isGivenKind(CT::T_GROUP_IMPORT_BRACE_CLOSE)) {
+                            break;
+                        }
+
+                        $groupQualifiedName = $this->namespaceUseGetNearestQualifiedName($chunkStart);
+                        $imports[] = new NamespaceUseAnalysis(
+                            $type,
+                            $qualifiedName['fullName'].$groupQualifiedName['fullName'],
+                            $groupQualifiedName['shortName'],
+                            $groupQualifiedName['aliased'],
+                            true,
+                            $startIndex,
+                            $endIndex,
+                            $chunkStart,
+                            $this->getPrevMeaningfulToken($groupQualifiedName['afterIndex'])
+                        );
+
+                        $groupIndex = $groupQualifiedName['afterIndex'];
+                    }
+
+                    $index = $groupIndex;
+                } elseif ($token->equalsAny([',', ';', [T_CLOSE_TAG]])) {
+                    $previousToken = $this->getPrevMeaningfulToken($qualifiedName['afterIndex']);
+
+                    if (!$this[$previousToken]->isGivenKind(CT::T_GROUP_IMPORT_BRACE_CLOSE)) {
+                        $imports[] = new NamespaceUseAnalysis(
+                            $type,
+                            $qualifiedName['fullName'],
+                            $qualifiedName['shortName'],
+                            $qualifiedName['aliased'],
+                            $multi,
+                            $startIndex,
+                            $endIndex,
+                            $multi ? $index : null,
+                            $multi ? $previousToken : null
+                        );
+                    }
+
+                    $index = $qualifiedName['afterIndex'];
+                }
+
+                $index = $this->getNextMeaningfulToken($index);
+            }
+
+            return $imports;
+        }
+
+    private function namespaceUseDetermineImportType(int $startIndex): int
+    {
+            $potentialType = $this[$this->getNextMeaningfulToken($startIndex)];
+
+            if ($potentialType->isGivenKind(CT::T_FUNCTION_IMPORT)) {
+                return NamespaceUseAnalysis::TYPE_FUNCTION;
+            }
+
+            if ($potentialType->isGivenKind(CT::T_CONST_IMPORT)) {
+                return NamespaceUseAnalysis::TYPE_CONSTANT;
+            }
+
+            return NamespaceUseAnalysis::TYPE_CLASS;
+        }
+
+    private function namespaceUseGetNearestQualifiedName(int $index): array
+    {
+            $fullName = $shortName = '';
+            $aliased = false;
+
+            while (null !== $index) {
+                $token = $this[$index];
+
+                if ($token->isGivenKind(T_STRING)) {
+                    $shortName = $token->getContent();
+                    if (!$aliased) {
+                        $fullName .= $shortName;
+                    }
+                } elseif ($token->isGivenKind(T_NS_SEPARATOR)) {
+                    $fullName .= $token->getContent();
+                } elseif ($token->isGivenKind(T_AS)) {
+                    $aliased = true;
+                } elseif ($token->equalsAny([
+                    ',',
+                    ';',
+                    [CT::T_GROUP_IMPORT_BRACE_OPEN],
+                    [CT::T_GROUP_IMPORT_BRACE_CLOSE],
+                    [T_CLOSE_TAG],
+                ])) {
+                    break;
+                }
+
+                $index = $this->getNextMeaningfulToken($index);
+            }
+
+            return [
+                'fullName' => $fullName,
+                'shortName' => $shortName,
+                'aliased' => $aliased,
+                'afterIndex' => $index,
+            ];
+        }
+
+    public function collectNamespaceDeclarations(): array
+    {
+            $this->collectStructureProfiles(0);
+            $namespaces = [];
+
+            for ($index = 1, $count = \count($this); $index < $count; ++$index) {
+                $token = $this[$index];
+
+                if (!$token->isGivenKind(T_NAMESPACE)) {
+                    continue;
+                }
+
+                $declarationEndIndex = $this->getNextTokenOfKind($index, [';', '{']);
+                $namespace = trim($this->generatePartialCode($index + 1, $declarationEndIndex - 1));
+                $declarationParts = explode('\\', $namespace);
+                $shortName = end($declarationParts);
+
+                if ($this[$declarationEndIndex]->equals('{')) {
+                    $scopeEndIndex = $this->findBlockEnd(Tokens::BLOCK_TYPE_CURLY_BRACE, $declarationEndIndex);
+                } else {
+                    $scopeEndIndex = $this->getNextTokenOfKind($declarationEndIndex, [[T_NAMESPACE]]);
+                    if (null === $scopeEndIndex) {
+                        $scopeEndIndex = \count($this);
+                    }
+                    --$scopeEndIndex;
+                }
+
+                $namespaces[] = new NamespaceAnalysis(
+                    $namespace,
+                    $shortName,
+                    $index,
+                    $declarationEndIndex,
+                    $index,
+                    $scopeEndIndex
+                );
+
+                // Continue the analysis after the end of this namespace to find the next one
+                $index = $scopeEndIndex;
+            }
+
+            if (0 === \count($namespaces) && $this->isTokenKindFound(T_OPEN_TAG)) {
+                $namespaces[] = new NamespaceAnalysis(
+                    '',
+                    '',
+                    $openTagIndex = $this[0]->isGivenKind(T_INLINE_HTML) ? 1 : 0,
+                    $openTagIndex,
+                    $openTagIndex,
+                    \count($this) - 1,
+                );
+            }
+
+            return $namespaces;
+        }
+
+    public function collectNamespaceAt(int $index): NamespaceAnalysis
+    {
+            $this->collectStructureProfiles($index);
+            if (!$this->offsetExists($index)) {
+                throw new \InvalidArgumentException(sprintf('Token index %d does not exist.', $index));
+            }
+
+            foreach ($this->collectNamespaceDeclarations() as $namespace) {
+                if ($namespace->getScopeStartIndex() <= $index && $namespace->getScopeEndIndex() >= $index) {
+                    return $namespace;
+                }
+            }
+
+            throw new \LogicException(sprintf('Unable to get the namespace at index %d.', $index));
+        }
+
+    public function findControlCaseStructures(array $types): \Generator
+    {
+            $this->collectStructureProfiles(0);
+            if (\count($types) < 1) {
+                return; // quick skip
+            }
+
+            $typesWithCaseOrDefault = $this->getTypesWithCaseOrDefault();
+
+            foreach ($types as $type) {
+                if (!\in_array($type, $typesWithCaseOrDefault, true)) {
+                    throw new \InvalidArgumentException(sprintf('Unexpected type "%d".', $type));
+                }
+            }
+
+            if (!$this->isAnyTokenKindsFound($types)) {
+                return; // quick skip
+            }
+
+            $depth = -1;
+
+            /**
+             * @var list<array{
+             *     kind: int|null,
+             *     index: int,
+             *     brace_count: int,
+             *     cases: list<array{index: int, open: int}>,
+             *     default: array{index: int, open: int}|null,
+             *     alternative_syntax: bool,
+             * }> $stack
+             */
+            $stack = [];
+            $isTypeOfInterest = false;
+
+            foreach ($this as $index => $token) {
+                if ($token->isGivenKind($typesWithCaseOrDefault)) {
+                    ++$depth;
+
+                    $stack[$depth] = [
+                        'kind' => $token->getId(),
+                        'index' => $index,
+                        'brace_count' => 0,
+                        'cases' => [],
+                        'default' => null,
+                        'alternative_syntax' => false,
+                    ];
+
+                    $isTypeOfInterest = \in_array($stack[$depth]['kind'], $types, true);
+
+                    if ($token->isGivenKind(T_SWITCH)) {
+                        $index = $this->getNextMeaningfulToken($index);
+                        $index = $this->findBlockEnd(Tokens::BLOCK_TYPE_PARENTHESIS_BRACE, $index);
+
+                        $stack[$depth]['open'] = $this->getNextMeaningfulToken($index);
+                        $stack[$depth]['alternative_syntax'] = $this[$stack[$depth]['open']]->equals(':');
+                    } elseif (\defined('T_MATCH') && $token->isGivenKind(T_MATCH)) { // @TODO: drop condition when PHP 8.0+ is required
+                        $index = $this->getNextMeaningfulToken($index);
+                        $index = $this->findBlockEnd(Tokens::BLOCK_TYPE_PARENTHESIS_BRACE, $index);
+
+                        $stack[$depth]['open'] = $this->getNextMeaningfulToken($index);
+                    } elseif (\defined('T_ENUM') && $token->isGivenKind(T_ENUM)) {
+                        $stack[$depth]['open'] = $this->getNextTokenOfKind($index, ['{']);
+                    }
+
+                    continue;
+                }
+
+                if ($depth < 0) {
+                    continue;
+                }
+
+                if ($token->equals('{')) {
+                    ++$stack[$depth]['brace_count'];
+
+                    continue;
+                }
+
+                if ($token->equals('}')) {
+                    --$stack[$depth]['brace_count'];
+
+                    if (0 === $stack[$depth]['brace_count']) {
+                        if ($stack[$depth]['alternative_syntax']) {
+                            continue;
+                        }
+
+                        if ($isTypeOfInterest) {
+                            $stack[$depth]['end'] = $index;
+
+                            yield $stack[$depth]['index'] => $this->buildControlCaseStructureAnalysis($stack[$depth]);
+                        }
+
+                        array_pop($stack);
+                        --$depth;
+
+                        if ($depth < -1) { // @phpstan-ignore-line
+                            throw new \RuntimeException('Analysis depth count failure.');
+                        }
+
+                        if (isset($stack[$depth]['kind'])) {
+                            $isTypeOfInterest = \in_array($stack[$depth]['kind'], $types, true);
+                        }
+                    }
+
+                    continue;
+                }
+
+                if ($this[$index]->isGivenKind(T_ENDSWITCH)) {
+                    if (!$stack[$depth]['alternative_syntax']) {
+                        throw new \RuntimeException('Analysis syntax failure, unexpected "T_ENDSWITCH".');
+                    }
+
+                    if (T_SWITCH !== $stack[$depth]['kind']) {
+                        throw new \RuntimeException('Analysis type failure, unexpected "T_ENDSWITCH".');
+                    }
+
+                    if (0 !== $stack[$depth]['brace_count']) {
+                        throw new \RuntimeException('Analysis count failure, unexpected "T_ENDSWITCH".');
+                    }
+
+                    $index = $this->getNextTokenOfKind($index, [';', [T_CLOSE_TAG]]);
+
+                    if ($isTypeOfInterest) {
+                        $stack[$depth]['end'] = $index;
+
+                        yield $stack[$depth]['index'] => $this->buildControlCaseStructureAnalysis($stack[$depth]);
+                    }
+
+                    array_pop($stack);
+                    --$depth;
+
+                    if ($depth < -1) { // @phpstan-ignore-line
+                        throw new \RuntimeException('Analysis depth count failure ("T_ENDSWITCH").');
+                    }
+
+                    if (isset($stack[$depth]['kind'])) {
+                        $isTypeOfInterest = \in_array($stack[$depth]['kind'], $types, true);
+                    }
+                }
+
+                if (!$isTypeOfInterest) {
+                    continue; // don't bother to analyze stuff that caller is not interested in
+                }
+
+                if ($token->isGivenKind(T_CASE)) {
+                    $stack[$depth]['cases'][] = ['index' => $index, 'open' => $this->findControlCaseOpen($stack[$depth]['kind'], $index)];
+                } elseif ($token->isGivenKind(T_DEFAULT)) {
+                    if (null !== $stack[$depth]['default']) {
+                        throw new \RuntimeException('Analysis multiple "default" found.');
+                    }
+
+                    $stack[$depth]['default'] = ['index' => $index, 'open' => $this->findControlDefaultOpen($stack[$depth]['kind'], $index)];
+                }
+            }
+        }
+
+    private function buildControlCaseStructureAnalysis(array $analysis): AbstractControlCaseStructuresAnalysis
+    {
+            $default = null === $analysis['default']
+                ? null
+                : new DefaultAnalysis($analysis['default']['index'], $analysis['default']['open']);
+
+            $cases = [];
+
+            foreach ($analysis['cases'] as $case) {
+                $cases[$case['index']] = new CaseAnalysis($case['index'], $case['open']);
+            }
+
+            sort($cases);
+
+            if (T_SWITCH === $analysis['kind']) {
+                return new SwitchAnalysis(
+                    $analysis['index'],
+                    $analysis['open'],
+                    $analysis['end'],
+                    $cases,
+                    $default
+                );
+            }
+
+            if (\defined('T_ENUM') && T_ENUM === $analysis['kind']) {
+                return new EnumAnalysis(
+                    $analysis['index'],
+                    $analysis['open'],
+                    $analysis['end'],
+                    $cases
+                );
+            }
+
+            if (\defined('T_MATCH') && T_MATCH === $analysis['kind']) { // @TODO: drop condition when PHP 8.0+ is required
+                return new MatchAnalysis(
+                    $analysis['index'],
+                    $analysis['open'],
+                    $analysis['end'],
+                    $default
+                );
+            }
+
+            throw new \InvalidArgumentException(sprintf('Unexpected type "%d".', $analysis['kind']));
+        }
+
+    private function findControlCaseOpen(int $kind, int $index): int
+    {
+            if (T_SWITCH === $kind) {
+                $ternariesCount = 0;
+
+                do {
+                    if ($this[$index]->equalsAny(['(', '{'])) { // skip constructs
+                        $type = Tokens::detectBlockType($this[$index]);
+                        $index = $this->findBlockEnd($type['type'], $index);
+
+                        continue;
+                    }
+
+                    if ($this[$index]->equals('?')) {
+                        ++$ternariesCount;
+
+                        continue;
+                    }
+
+                    if ($this[$index]->equalsAny([':', ';'])) {
+                        if (0 === $ternariesCount) {
+                            break;
+                        }
+
+                        --$ternariesCount;
+                    }
+                } while (++$index);
+
+                return $index;
+            }
+
+            if (\defined('T_ENUM') && T_ENUM === $kind) {
+                return $this->getNextTokenOfKind($index, ['=', ';']);
+            }
+
+            throw new \InvalidArgumentException(sprintf('Unexpected case for type "%d".', $kind));
+        }
+
+    private function findControlDefaultOpen(int $kind, int $index): int
+    {
+            if (T_SWITCH === $kind) {
+                return $this->getNextTokenOfKind($index, [':', ';']);
+            }
+
+            if (\defined('T_MATCH') && T_MATCH === $kind) { // @TODO: drop condition when PHP 8.0+ is required
