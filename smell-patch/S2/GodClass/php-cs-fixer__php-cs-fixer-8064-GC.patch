+    public function isEnumCaseToken(int $caseIndex): bool
+    {
+            $this->collectStructureProfiles($caseIndex);
+            $token = $this[$caseIndex];
+
+            if (!$token->isGivenKind(T_CASE)) {
+                throw new \LogicException(sprintf(
+                    'No T_CASE given at index %d, got %s instead.',
+                    $caseIndex,
+                    $token->getName() ?? $token->getContent()
+                ));
+            }
+
+            if (!\defined('T_ENUM') || !$this->isTokenKindFound(T_ENUM)) {
+                return false;
+            }
