+    public function isAnonymousClassToken(int $index): bool
+    {
+            $this->collectStructureProfiles($index);
+            if (!$this[$index]->isClassy()) {
+                throw new \LogicException(sprintf('No classy token at given index %d.', $index));
+            }
+
+            if (!$this[$index]->isGivenKind(T_CLASS)) {
+                return false;
+            }
+
+            $index = $this->getPrevMeaningfulToken($index);
+
+            if (\defined('T_READONLY') && $this[$index]->isGivenKind(T_READONLY)) { // @TODO: drop condition when PHP 8.1+ is required
+                $index = $this->getPrevMeaningfulToken($index);
+            }
+
+            while ($this[$index]->isGivenKind(CT::T_ATTRIBUTE_CLOSE)) {
+                $index = $this->findBlockStart(Tokens::BLOCK_TYPE_ATTRIBUTE, $index);
+                $index = $this->getPrevMeaningfulToken($index);
+            }
+
+            return $this[$index]->isGivenKind(T_NEW);
+        }
+
+    public function isLambdaToken(int $index): bool
+    {
+            $this->collectStructureProfiles($index);
+            if (!$this[$index]->isGivenKind([T_FUNCTION, T_FN])) {
+                throw new \LogicException(sprintf('No T_FUNCTION or T_FN at given index %d, got "%s".', $index, $this[$index]->getName()));
+            }
+
+            $startParenthesisIndex = $this->getNextMeaningfulToken($index);
+            $startParenthesisToken = $this[$startParenthesisIndex];
+
+            // skip & for `function & () {}` syntax
+            if ($startParenthesisToken->isGivenKind(CT::T_RETURN_REF)) {
+                $startParenthesisIndex = $this->getNextMeaningfulToken($startParenthesisIndex);
+                $startParenthesisToken = $this[$startParenthesisIndex];
+            }
+
+            return $startParenthesisToken->equals('(');
+        }
