+            //   - function reference parameter: function baz(Foo & $bar) {}
+            //   - bit operator: $x = FOO & $bar;
+            if ($this[$nextIndex]->equals('&') && $this[$this->getNextMeaningfulToken($nextIndex)]->isGivenKind(T_VARIABLE)) {
+                $checkIndex = $this->getPrevTokenOfKind($prevIndex, [';', '{', '}', [T_FUNCTION], [T_OPEN_TAG], [T_OPEN_TAG_WITH_ECHO]]);
