+  def classify_output_path_token(value)
+    @classify_output_path_token_raw = value
+    @classify_output_path_token_text = value.to_s
+    @classify_output_path_token_text = @classify_output_path_token_text.strip
+    @classify_output_path_token_text = @classify_output_path_token_text.gsub(/\s+/, " ")
+    @classify_output_path_token_text = @classify_output_path_token_text.sub(/\A\./, "")
+    @classify_output_path_token_length = @classify_output_path_token_text.length
+    @classify_output_path_token_bytes = @classify_output_path_token_text.bytesize
+    @classify_output_path_token_parts = @classify_output_path_token_text.split(/[\/:_-]/)
+    @classify_output_path_token_head = @classify_output_path_token_parts.first.to_s
+    @classify_output_path_token_tail = @classify_output_path_token_parts.last.to_s
+    @classify_output_path_token_kind = "plain"
+    @classify_output_path_token_weight = 1
+    if @classify_output_path_token_text == ""
