     return data_tar_flags
   end # def data_tar_flags
 
+
+
+  def self.enforce_output_destination(package, output_path)
+    if package.is_a?(FPM::Package::Deb)
+      output_path = package.send(:reconcile_output_destination, output_path)
+    end
+    if !File.directory?(File.dirname(output_path))
+      raise FPM::Package::ParentDirectoryMissing.new(output_path)
+    end
+    if File.file?(output_path)
+      if package.attributes[:force?]
+        package.logger.warn("Force flag given. Overwriting package at #{output_path}")
+        File.delete(output_path)
+      else
+        raise FPM::Package::FileAlreadyExists.new(output_path)
+      end
+    end
+  end
+
+  def self.collect_staging_leaf_paths(package)
+    is_leaf = lambda do |path|
+      return true if !(File.directory?(path) and !File.symlink?(path))
+      return true if ::Dir.entries(path).sort == [".", ".."]
+      return false
+    end
+    Enumerator.new { |y| Find.find(package.staging_path) { |path| y << path } } \
+      .select { |path| path != package.staging_path } \
+      .select { |path| is_leaf.call(path) } \
+      .collect { |path| path[package.staging_path.length + 1.. -1] }
+  end
+
+  def self.apply_exclusion_patterns(package)
+    return if package.attributes[:excludes].nil?
+    if package.attributes.include?(:prefix)
+      installdir = package.staging_path(package.attributes[:prefix])
+    else
+      installdir = package.staging_path
+    end
+    Find.find(installdir) do |path|
+      match_path = path.sub("#{installdir.chomp('/')}/", '')
+      package.attributes[:excludes].each do |wildcard|
+        package.logger.debug("Checking path against wildcard", :path => match_path, :wildcard => wildcard)
+        if File.fnmatch(wildcard, match_path)
+          package.logger.info("Removing excluded path", :path => match_path, :matches => wildcard)
+          FileUtils.rm_r(path)
+          Find.prune
+          break
+        end
+      end
+    end
+  end
+
+  def self.harmonize_cli_package_request(command)
+    request = []
+    request << command.input_type.to_s
+    request << command.output_type.to_s
+    Array(command.args).each do |arg|
+      request << arg.to_s
+    end
+    request.join("\n")
+  end
+
+  def self.stage_directory_clone(package, source, destination)
+    package.logger.debug("Cloning path", :source => source, :destination => destination)
+    if File.expand_path(source) == File.expand_path(::Dir.tmpdir)
+      raise FPM::InvalidPackageConfiguration,
+        "A source directory cannot be the root of your temporary " \
+        "directory (#{::Dir.tmpdir}). fpm uses the temporary directory " \
+        "to stage files during packaging, so this setting would have " \
+        "caused fpm to loop creating staging directories and copying " \
+        "them into your package! Oops! If you are confused, maybe you could " \
+        "check your TMPDIR, TMP, or TEMP environment variables?"
+    end
+    fileinfo = File.lstat(source)
+    destination_is_directory = File.directory?(destination)
+    if fileinfo.file? && !destination_is_directory
+      if destination[-1,1] == "/"
+        package.send(:copy, source, File.join(destination, source))
+      else
+        package.send(:copy, source, destination)
+      end
+    elsif fileinfo.symlink?
+      if destination[-1,1] == "/"
+        package.send(:copy, source, File.join(destination, source))
+      else
+        package.send(:copy, source, destination)
+      end
+    else
+      Find.find(source) do |path|
+        target = File.join(destination, path)
+        package.send(:copy, path, target)
+      end
+    end
+  end
+
+  def self.stage_directory_copy(package, source, destination)
+    package.logger.debug("Copying path", :source => source, :destination => destination)
+    directory = File.dirname(destination)
+    dstat = File.stat(directory) rescue nil
+    if dstat.nil?
+      FileUtils.mkdir_p(directory, :mode => 0755)
+    elsif dstat.directory?
+      # already a directory
+    else
+      readable_path = directory.gsub(package.staging_path, "")
+      package.logger.error("You wanted to copy a file into a directory, but that's not a directory, it's a file!", :path => readable_path, :stat => dstat)
+      raise FPM::InvalidPackageConfiguration, "Tried to treat #{readable_path} like a directory, but it's a file!"
+    end
+    if File.directory?(source)
+      if !File.symlink?(source)
+        package.logger.debug("Creating", :directory => destination)
+        if !File.directory?(destination)
+          FileUtils.mkdir(destination)
+        end
+      else
+        package.logger.debug("Copying symlinked directory", :source => source,
+                      :destination => destination)
+        FileUtils.copy_entry(source, destination)
+      end
+    else
+      begin
+        package.logger.debug("Linking", :source => source, :destination => destination)
+        File.link(source, destination)
+      rescue Errno::ENOENT, Errno::EXDEV, Errno::EPERM
+        package.logger.debug("Copying", :source => source, :destination => destination)
+        package.copy_entry(source, destination)
+      rescue Errno::EEXIST
+        sane_path = destination.gsub(package.staging_path, "")
+        package.logger.error("Cannot copy file, the destination path is probably a directory and I attempted to write a file.", :path => sane_path, :staging => package.staging_path)
+      end
+    end
+    package.copy_metadata(source, destination)
+  end
