+	private boolean equalityJcAnnotatedTypeInit;
+
+	private Class<?> equalityJcAnnotatedTypeClass = null;
+
+	private Field equalityJcAnnotatedTypeUnderlyingTypeField = null;
+
+
+	private JCExpression equalityUnnotate(JCExpression type) {
+		if (!equalityIsJcAnnotatedType(type)) return type;
+		if (equalityJcAnnotatedTypeUnderlyingTypeField == null) return type;
+		try {
+			return (JCExpression) equalityJcAnnotatedTypeUnderlyingTypeField.get(type);
+		} catch (Exception ignore) {}
+		return type;
+	}
+
+
+	private boolean equalityIsJcAnnotatedType(JCExpression o) {
+		if (o == null) return false;
+		if (!equalityJcAnnotatedTypeInit) {
+			try {
+				equalityJcAnnotatedTypeClass = Class.forName("com.sun.tools.javac.tree.JCTree$JCAnnotatedType", false, o.getClass().getClassLoader());
+				equalityJcAnnotatedTypeUnderlyingTypeField = equalityJcAnnotatedTypeClass.getDeclaredField("underlyingType");
+			}
+			catch (Exception ignore) {}
+			equalityJcAnnotatedTypeInit = true;
+		}
+		return equalityJcAnnotatedTypeClass == o.getClass();
+	}
