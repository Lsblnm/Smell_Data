+	public void builderMakePrefixedSetterMethodsForBuilder(BuilderJob job, BuilderFieldData bfd, String prefix) {
+		boolean deprecate = isFieldDeprecated(bfd.originalFieldNode);
+		if (bfd.singularData == null || bfd.singularData.getSingularizer() == null) {
+			builderMakePrefixedSetterMethodForBuilder(job, bfd, deprecate, prefix);
+		} else {
+			bfd.singularData.getSingularizer().generateMethods(job, bfd.singularData, deprecate);
