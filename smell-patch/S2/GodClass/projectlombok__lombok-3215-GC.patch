+	public void witherCreateWithForFields(AccessLevel level, Collection<JavacNode> fieldNodes, JavacNode errorNode, boolean whineIfExists, List<JCAnnotation> onMethod, List<JCAnnotation> onParam) {
+		for (JavacNode fieldNode : fieldNodes) {
+			witherCreateWithForField(level, fieldNode, errorNode, whineIfExists, onMethod, onParam);
+		}
+	}
