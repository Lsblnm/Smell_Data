+	public static boolean ctorIsLocalType(JavacNode type) {
+		Kind kind = type.up().getKind();
+		if (kind == Kind.COMPILATION_UNIT) return false;
+		if (kind == Kind.TYPE) return ctorIsLocalType(type.up());
+		return true;
+	}
