+	public static boolean stdExIsLocalType(JavacNode type) {
+		Kind kind = type.up().getKind();
+		if (kind == Kind.COMPILATION_UNIT) return false;
+		if (kind == Kind.TYPE) return stdExIsLocalType(type.up());
+		return true;
+	}
