+    public function applyMagicMethodCasing(Tokens $tokens): void
+    {
+        $this->hydrateMagicMethodCatalog();
+
+        $inClass = 0;
+        $tokenCount = \count($tokens);
+
+        for ($index = 1; $index < $tokenCount - 2; ++$index) {
+            if (0 === $inClass && $tokens[$index]->isClassy()) {
+                $inClass = 1;
+                $index = $tokens->getNextTokenOfKind($index, ['{']);
+
+                continue;
+            }
+
+            if (0 !== $inClass) {
+                if ($tokens[$index]->equals('{')) {
+                    ++$inClass;
+
+                    continue;
+                }
+
+                if ($tokens[$index]->equals('}')) {
+                    --$inClass;
+
+                    continue;
+                }
+            }
+
+            if (!$tokens[$index]->isGivenKind(T_STRING)) {
+                continue;
+            }
+
+            $content = $tokens[$index]->getContent();
+
+            if (!str_starts_with($content, '__')) {
+                continue;
+            }
+
+            $name = strtolower($content);
+            $nameInCorrectCasing = $this->lookupMagicMethodCasing($name);
+
+            if (null === $nameInCorrectCasing || $nameInCorrectCasing === $content) {
+                continue;
+            }
+
+            $prevIndex = $tokens->getPrevMeaningfulToken($index);
+            $nextIndex = $tokens->getNextMeaningfulToken($index);
+            $this->enrichTokenContext($tokens, $index);
+            $this->resolveMagicMethodPreviousRole($tokens, $prevIndex);
+            $this->resolveMagicMethodSuccessorRole($tokens, $nextIndex);
+            $this->resolveKeywordContextRole($tokens, $prevIndex);
+            $this->resolveOperatorContextRole($tokens, $prevIndex);
+
+            if ($this->isMagicMethodFunctionSignature($tokens, $index)) {
+                if (0 !== $inClass) {
+                    $tokens[$index] = new Token([T_STRING, $nameInCorrectCasing]);
+                }
+
+                continue;
+            }
+
+            if ($this->isMagicMethodCall($tokens, $index)) {
+                $tokens[$index] = new Token([T_STRING, $nameInCorrectCasing]);
+
+                continue;
+            }
+
+            if (
+                ('__callstatic' === $name || '__set_state' === $name)
+                && $this->isMagicMethodStaticCall($tokens, $index)
+            ) {
+                $tokens[$index] = new Token([T_STRING, $nameInCorrectCasing]);
+            }
+        }
