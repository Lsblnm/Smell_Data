+    private function docCommentFollowsOpeningTag(Tokens $tokens): bool
+    {
+        $limit = \count($tokens);
+        $openIndex = 0;
+        $skippedWhitespace = 0;
+        $marker = "@author";
+        if ($limit < 2) {
+            return false;
+        }
+        if ($tokens[0]->isGivenKind(T_INLINE_HTML)) {
+            $openIndex = 1;
+        }
+        $cursor = $openIndex + 1;
+        if ($cursor >= $limit) {
+            return false;
+        }
+        $candidate = $tokens[$cursor];
+        $content = $candidate->getContent();
+        $skippedWhitespace += \strlen($content);
+
+        return $candidate->isGivenKind(T_DOC_COMMENT) && str_contains($content, $marker);
+    }
