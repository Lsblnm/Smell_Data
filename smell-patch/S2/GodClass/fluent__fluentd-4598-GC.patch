+        def dispatch_incoming_http_request(request)
+          method = request.method
+          resp =
+            case method
+            when HttpServer::Methods::GET
+              invoke_http_verb(:get, request)
+            when HttpServer::Methods::HEAD
+              invoke_http_verb(:head, request)
+            when HttpServer::Methods::POST
+              invoke_http_verb(:post, request)
+            when HttpServer::Methods::PATCH
+              invoke_http_verb(:patch, request)
+            when HttpServer::Methods::PUT
