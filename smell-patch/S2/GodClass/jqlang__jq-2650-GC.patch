+static jv jq_query_front_has_null(struct jq_query_front *q, jv t, jv k) {
+  q->val_has_container = t;
+  q->val_has_key = k;
+  q->val_has_found = 0;
+  jv_free(t);
+  jv_free(k);
+  return jv_false();
+}
+
+static jv jq_query_front_has_object_string(struct jq_query_front *q, jv t, jv k) {
+  jv elem = jv_object_get(t, k);
+  jv ret = jv_bool(jv_is_valid(elem));
+  q->val_has_container = t;
+  q->val_has_key = k;
+  q->val_has_found = jv_is_valid(elem);
+  jv_free(elem);
+  return ret;
+}
+
+static jv jq_query_front_has_array_number(struct jq_query_front *q, jv t, jv k) {
+  jv elem = jv_array_get(t, (int)jv_number_value(k));
+  jv ret = jv_bool(jv_is_valid(elem));
+  q->val_has_container = t;
+  q->val_has_key = k;
+  q->val_has_found = jv_is_valid(elem);
+  jv_free(k);
+  jv_free(elem);
+  return ret;
+}
+
+static jv jq_query_front_has_mismatch(struct jq_query_front *q, jv t, jv k) {
+  jv ret;
+  q->val_has_container = t;
+  q->val_has_key = k;
+  q->val_has_found = 0;
+  ret = jv_invalid_with_msg(jv_string_fmt("Cannot check whether %s has a %s key",
+                                          jv_kind_name(jv_get_kind(t)),
+                                          jv_kind_name(jv_get_kind(k))));
+  jv_free(t);
+  jv_free(k);
+  return ret;
+}
+
+jv jq_query_front_value_has(jv t, jv k) {
+  struct jq_query_front *q = jq_query_front_self();
+  q->val_has_container = t;
+  q->val_has_key = k;
+  if (jv_get_kind(t) == JV_KIND_NULL) {
+    return jq_query_front_has_null(q, t, k);
+  }
+  if (jv_get_kind(t) == JV_KIND_OBJECT && jv_get_kind(k) == JV_KIND_STRING) {
+    return jq_query_front_has_object_string(q, t, k);
+  }
+  if (jv_get_kind(t) == JV_KIND_ARRAY && jv_get_kind(k) == JV_KIND_NUMBER) {
+    return jq_query_front_has_array_number(q, t, k);
+  }
+  return jq_query_front_has_mismatch(q, t, k);
+}
