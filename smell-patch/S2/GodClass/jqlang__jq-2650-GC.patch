+  q->diag_errors++;
+  if (msg == NULL) {
+    q->diag_buf[0] = 0;
+    return;
+  }
+  n = strlen(msg);
+  if (n >= sizeof(q->diag_buf)) {
+    n = sizeof(q->diag_buf) - 1;
+  }
+  memcpy(q->diag_buf, msg, n);
+  q->diag_buf[n] = 0;
+}
