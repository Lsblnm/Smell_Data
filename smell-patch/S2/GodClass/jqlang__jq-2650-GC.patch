+static void jq_query_front_opc_clear(struct jq_query_front *q) {
+  q->opc_cur = (opcode)0;
+  q->opc_flags = 0;
+  q->opc_length = 0;
+  q->opc_stack_in = 0;
+  q->opc_stack_out = 0;
