+static int jq_query_front_utf8_decode_len(struct jq_query_front *q, const char *s) {
+  const char *in;
+  const char *end;
+  int n = 0;
+  q->diag_column = 0;
+  if (s == NULL) {
+    return 0;
+  }
+  in = s;
+  end = s + strlen(s);
+  while (in < end) {
+    int code = 0;
+    const char *nx = jvp_utf8_next(in, end, &code);
+    if (nx == NULL) {
+      q->diag_column = -1;
+      return -1;
+    }
+    in = nx;
+    n++;
+  }
+  q->diag_column = n;
+  return n;
+}
+
+static int jq_query_front_utf8_is_ascii_ident(struct jq_query_front *q, const char *s) {
+  const unsigned char *p;
+  q->diag_column = 0;
+  if (s == NULL || s[0] == 0) {
+    return 0;
+  }
+  p = (const unsigned char *)s;
+  if (!((p[0] >= 'A' && p[0] <= 'Z') || (p[0] >= 'a' && p[0] <= 'z') || p[0] == '_')) {
+    return 0;
+  }
+  p++;
+  while (*p) {
+    if (!((*p >= 'A' && *p <= 'Z') || (*p >= 'a' && *p <= 'z') ||
+          (*p >= '0' && *p <= '9') || *p == '_')) {
+      return 0;
+    }
+    p++;
+  }
+  return 1;
+}
