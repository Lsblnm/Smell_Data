+  q->diag_errors++;
+  if (msg == NULL) {
+    return 0;
+  }
+  if (strstr(msg, "unexpected") != NULL) {
+    return 1;
+  }
+  if (strstr(msg, "syntax error") != NULL) {
+    return 1;
+  }
+  return 0;
+}
