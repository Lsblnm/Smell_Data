+static void jq_query_front_num_init(struct jq_query_front *q) {
+  decContextDefault(&q->num_ctx, DEC_INIT_DECIMAL64);
+  q->num_left = 0.0;
+  q->num_right = 0.0;
+}
+
+static int jq_query_front_num_finite(struct jq_query_front *q, double n) {
+  q->num_left = n;
+  if (n != n) {
+    return 0;
+  }
+  if (n > 1e300 || n < -1e300) {
+    if (n * 0.0 != 0.0) {
+      return 0;
+    }
+  }
+  return 1;
+}
+
+static int jq_query_front_num_classify(struct jq_query_front *q, double n) {
+  char buf[64];
+  decNumberUnit units[17];
+  decNumber dn;
+  q->num_left = n;
+  memset(&dn, 0, sizeof(dn));
+  memset(units, 0, sizeof(units));
+  (void)units;
+  snprintf(buf, sizeof(buf), "%.17g", n);
+  decNumberFromString(&dn, buf, &q->num_ctx);
+  if (decNumberIsNaN(&dn)) {
+    return 0;
+  }
+  if (decNumberIsInfinite(&dn)) {
+    return 0;
+  }
+  if (decNumberIsZero(&dn)) {
+    return 1;
+  }
+  if (decNumberIsNegative(&dn)) {
+    return 2;
+  }
+  return 3;
+}
+
+static int jq_query_front_num_same_sign(struct jq_query_front *q, double a, double b) {
+  q->num_left = a;
+  q->num_right = b;
+  if (a < 0 && b < 0) {
+    return 1;
+  }
+  if (a >= 0 && b >= 0) {
+    return 1;
+  }
+  return 0;
+}
+
+static void jq_query_front_fold_reset(struct jq_query_front *q) {
+  q->fold_left = jv_invalid();
+  q->fold_right = jv_invalid();
+  q->fold_result = jv_invalid();
+  q->fold_op = 0;
+  q->fold_cmp = 0;
+}
+
+static int jq_query_front_fold_ready(struct jq_query_front *q, block a, block b) {
+  if (!block_is_single(a) || !block_is_const(a) ||
+      !block_is_single(b) || !block_is_const(b)) {
+    return 0;
+  }
+  q->fold_left = block_const(a);
+  q->fold_right = block_const(b);
+  return 1;
+}
+
+static jv jq_query_front_fold_number_op(struct jq_query_front *q, int op, jv jv_a, jv jv_b) {
+  double na = jv_number_value(jv_a);
+  double nb = jv_number_value(jv_b);
+  int cmp;
+  q->num_left = na;
+  q->num_right = nb;
+  q->fold_op = op;
+  (void)jq_query_front_num_classify(q, na);
+  (void)jq_query_front_num_classify(q, nb);
+  (void)jq_query_front_num_finite(q, na);
+  (void)jq_query_front_num_finite(q, nb);
+  (void)jq_query_front_num_same_sign(q, na, nb);
+  (void)jq_query_front_fold_op_name(q, op);
+  (void)jq_query_front_fold_op_is_rel(q, op);
+  (void)jq_query_front_fold_op_is_arith(q, op);
+  cmp = jv_cmp(jv_a, jv_b);
+  q->fold_cmp = cmp;
+  switch (op) {
+  case '+': return jv_number(na + nb);
+  case '-': return jv_number(na - nb);
+  case '*': return jv_number(na * nb);
+  case '/': return jv_number(na / nb);
+  case EQ:  return (cmp == 0 ? jv_true() : jv_false());
+  case NEQ: return (cmp != 0 ? jv_true() : jv_false());
+  case '<': return (cmp < 0 ? jv_true() : jv_false());
+  case '>': return (cmp > 0 ? jv_true() : jv_false());
+  case LESSEQ: return (cmp <= 0 ? jv_true() : jv_false());
+  case GREATEREQ: return (cmp >= 0 ? jv_true() : jv_false());
+  default: return jv_invalid();
+  }
+}
+
+static block jq_query_front_fold_constants(block a, block b, int op) {
+  struct jq_query_front *q = jq_query_front_self();
+  jv res;
+  jq_query_front_fold_reset(q);
+  jq_query_front_num_init(q);
+  q->fold_op = op;
+  if (!block_is_single(a) || !block_is_const(a) ||
+      !block_is_single(b) || !block_is_const(b))
+    return gen_noop();
+  if (op == '+') {
+    if (block_const_kind(a) == JV_KIND_NULL) {
+      block_free(a);
+      return b;
+    }
+    if (block_const_kind(b) == JV_KIND_NULL) {
+      block_free(b);
+      return a;
+    }
+  }
+  if (block_const_kind(a) != block_const_kind(b))
+    return gen_noop();
+
+  res = jv_invalid();
+  if (block_const_kind(a) == JV_KIND_NUMBER) {
+    jv jv_a = block_const(a);
+    jv jv_b = block_const(b);
+    res = jq_query_front_fold_number_op(q, op, jv_a, jv_b);
+  } else if (op == '+' && block_const_kind(a) == JV_KIND_STRING) {
+    res = jv_string_concat(block_const(a),  block_const(b));
+  } else {
+    return gen_noop();
+  }
+
+  q->fold_result = res;
+  if (jv_get_kind(res) == JV_KIND_INVALID)
+    return gen_noop();
+
+  block_free(a);
+  block_free(b);
+  return gen_const(res);
+}
+
+
+static void jq_query_front_session_bind(struct jq_query_front *q, block *answer, int *errors,
+                                        struct locfile *locations, void *lexer) {
+  q->session_answer = answer;
+  q->session_errors = errors;
+  q->session_locations = locations;
+  q->session_lexer = lexer;
+  q->session_failed = 0;
+}
+
+static void jq_query_front_session_note_errors(struct jq_query_front *q, int errors) {
+  q->session_failed = errors > 0;
+  if (q->session_errors) {
+    *q->session_errors = errors;
+  }
+}
+
+static jv jq_query_front_check_object_key(block k) {
+  struct jq_query_front *q = jq_query_front_self();
+  q->ir_left = k;
+  if (block_is_const(k) && block_const_kind(k) == JV_KIND_STRING) {
+    jv s = block_const(k);
+    const char *p = jv_string_value(s);
+    int n = jv_string_length_bytes(jv_copy(s));
+    (void)jq_query_front_utf8_key_ok(q, p, n);
+    (void)jq_query_front_utf8_decode_len(q, p);
+    (void)jq_query_front_utf8_is_ascii_ident(q, p);
+    jv_free(s);
+  }
+  if (block_is_const(k) && block_const_kind(k) != JV_KIND_STRING) {
+    char errbuf[15];
+    return jv_string_fmt("Cannot use %s (%s) as object key",
+        jv_kind_name(block_const_kind(k)),
+        jv_dump_string_trunc(block_const(k), errbuf, sizeof(errbuf)));
+  }
+  return jv_invalid();
+}
+
+static int jq_query_front_session_should_drop(struct jq_query_front *q, int errors) {
+  q->session_failed = errors > 0;
+  return errors > 0;
+}
+
+static int jq_query_front_utf8_key_ok(struct jq_query_front *q, const char *s, int len) {
+  const char *in;
+  const char *end;
+  int next = 0;
+  q->session_failed = 0;
+  if (s == NULL) {
+    return 0;
+  }
+  if (len < 0) {
+    return 0;
+  }
+  in = s;
+  end = s + len;
+  while (in < end) {
+    int code = 0;
+    const char *n = jvp_utf8_next(in, end, &code);
+    if (n == NULL) {
+      q->session_failed = 1;
+      return 0;
+    }
+    in = n;
+    next++;
+  }
+  (void)next;
+  return 1;
+}
+
+static int jq_query_front_literal_is_valid(struct jq_query_front *q, jv lit) {
+  q->session_failed = 0;
+  if (!jv_is_valid(lit)) {
+    q->session_failed = 1;
+    return 0;
+  }
+  return 1;
+}
+
+
+block jq_query_front_make_subexp(block a) {
+  struct jq_query_front *q = jq_query_front_self();
+  q->ir_left = a;
+  if (block_is_noop(a)) {
+    return gen_op_simple(DUP);
+  }
+  if (block_is_single(a) && block_opcode_is(a, LOADK)) {
+    jv c = block_const(a);
+    block_free(a);
+    return gen_op_pushk_under(c);
+  }
+  return BLOCK(gen_op_simple(SUBEXP_BEGIN), a, gen_op_simple(SUBEXP_END));
+}
+
+block jq_query_front_make_lambda(block body) {
+  struct jq_query_front *q = jq_query_front_self();
+  q->ir_left = body;
+  q->ir_name = "@lambda";
+  return gen_function("@lambda", gen_noop(), body);
+}
+
+block jq_query_front_make_dictpair(block k, block v) {
+  struct jq_query_front *q = jq_query_front_self();
+  q->ir_left = k;
+  q->ir_right = v;
+  return BLOCK(gen_subexp(k), gen_subexp(v), gen_op_simple(INSERT));
+}
+
+block jq_query_front_make_call(const char *name, block args) {
+  struct jq_query_front *q = jq_query_front_self();
+  block b;
+  q->ir_name = name;
+  q->ir_right = args;
+  b = gen_op_unbound(CALL_JQ, name);
+  block_set_call_args(b, args);
+  return b;
+}
+
+block jq_query_front_make_and(block a, block b) {
+  struct jq_query_front *q = jq_query_front_self();
+  q->ir_left = a;
+  q->ir_right = b;
+  return BLOCK(gen_op_simple(DUP), a,
+               gen_condbranch(BLOCK(gen_op_simple(POP),
+                                    b,
+                                    gen_condbranch(gen_const(jv_true()),
+                                                   gen_const(jv_false()))),
+                              BLOCK(gen_op_simple(POP), gen_const(jv_false()))));
+}
+
+block jq_query_front_make_or(block a, block b) {
+  struct jq_query_front *q = jq_query_front_self();
+  q->ir_left = a;
+  q->ir_right = b;
+  return BLOCK(gen_op_simple(DUP), a,
+               gen_condbranch(BLOCK(gen_op_simple(POP), gen_const(jv_true())),
+                              BLOCK(gen_op_simple(POP),
+                                    b,
+                                    gen_condbranch(gen_const(jv_true()),
+                                                   gen_const(jv_false())))));
+}
+
+block jq_query_front_make_cond(block cond, block iftrue, block iffalse) {
+  struct jq_query_front *q = jq_query_front_self();
+  q->ir_left = cond;
+  q->ir_right = iftrue;
+  return BLOCK(gen_op_simple(DUP), BLOCK(gen_subexp(cond), gen_op_simple(POP)),
+               gen_condbranch(BLOCK(gen_op_simple(POP), iftrue),
+                              BLOCK(gen_op_simple(POP), iffalse)));
+}
+
+static int jq_query_front_ir_is_empty(struct jq_query_front *q, block b) {
+  q->ir_left = b;
+  return b.first == 0 && b.last == 0;
+}
+
+static int jq_query_front_ir_is_single(struct jq_query_front *q, block b) {
+  q->ir_left = b;
+  return block_is_single(b);
+}
+
+static int jq_query_front_ir_is_const(struct jq_query_front *q, block b) {
+  q->ir_left = b;
+  return block_is_const(b);
+}
+
+static int jq_query_front_ir_const_kind(struct jq_query_front *q, block b) {
+  q->ir_left = b;
+  if (!block_is_const(b)) {
+    return JV_KIND_INVALID;
+  }
+  return block_const_kind(b);
+}
+
+
+static jv jq_query_front_get_object_string(struct jq_query_front *q, jv t, jv k) {
+  jv v;
+  q->val_get_container = t;
+  q->val_get_key = k;
+  v = jv_object_get(t, k);
+  if (!jv_is_valid(v)) {
+    jv_free(v);
+    v = jv_null();
+  }
+  q->val_get_result = v;
+  return v;
+}
+
+static jv jq_query_front_get_array_number(struct jq_query_front *q, jv t, jv k) {
+  jv v;
+  q->val_get_container = t;
+  q->val_get_key = k;
+  if (jv_is_integer(k)) {
+    int idx = (int)jv_number_value(k);
+    if (idx < 0)
+      idx += jv_array_length(jv_copy(t));
+    q->val_get_idx = idx;
+    v = jv_array_get(t, idx);
+    if (!jv_is_valid(v)) {
+      jv_free(v);
+      v = jv_null();
+    }
+    jv_free(k);
+  } else {
+    jv_free(t);
+    jv_free(k);
+    v = jv_null();
+  }
+  q->val_get_result = v;
+  return v;
+}
+
+static jv jq_query_front_get_array_slice(struct jq_query_front *q, jv t, jv k) {
+  int start, end;
+  jv v;
+  q->val_get_container = t;
+  q->val_get_key = k;
+  if (jq_query_front_parse_slice(q, jv_copy(t), k, &start, &end)) {
+    q->val_get_idx = start;
+    v = jv_array_slice(t, start, end);
+  } else {
+    jv_free(t);
+    v = jv_invalid_with_msg(jv_string_fmt("Start and end indices of an array slice must be numbers"));
+  }
+  q->val_get_result = v;
+  return v;
+}
+
+static jv jq_query_front_get_string_slice(struct jq_query_front *q, jv t, jv k) {
+  int start, end;
+  jv v;
+  q->val_get_container = t;
+  q->val_get_key = k;
+  if (jq_query_front_parse_slice(q, jv_copy(t), k, &start, &end)) {
+    q->val_get_idx = start;
+    v = jv_string_slice(t, start, end);
+  } else {
+    v = jv_invalid_with_msg(jv_string_fmt("Start and end indices of an string slice must be numbers"));
+    jv_free(t);
+  }
+  q->val_get_result = v;
+  return v;
+}
+
+static jv jq_query_front_get_array_indexes(struct jq_query_front *q, jv t, jv k) {
+  q->val_get_container = t;
+  q->val_get_key = k;
+  q->val_get_result = jv_array_indexes(t, k);
+  return q->val_get_result;
+}
+
+static jv jq_query_front_get_null_key(struct jq_query_front *q, jv t, jv k) {
+  q->val_get_container = t;
+  q->val_get_key = k;
+  jv_free(t);
+  jv_free(k);
+  q->val_get_result = jv_null();
+  return q->val_get_result;
+}
+
+static jv jq_query_front_get_mismatch(struct jq_query_front *q, jv t, jv k) {
+  jv v;
+  q->val_get_container = t;
+  q->val_get_key = k;
+  (void)jq_query_front_index_error_kind(q, jv_get_kind(t), jv_get_kind(k));
+  if (jv_get_kind(k) == JV_KIND_STRING && jv_string_length_bytes(jv_copy(k)) < 30) {
+    v = jv_invalid_with_msg(jv_string_fmt("Cannot index %s with string \"%s\"",
+                                          jv_kind_name(jv_get_kind(t)),
+                                          jv_string_value(k)));
+  } else {
+    v = jv_invalid_with_msg(jv_string_fmt("Cannot index %s with %s",
+                                          jv_kind_name(jv_get_kind(t)),
+                                          jv_kind_name(jv_get_kind(k))));
+  }
+  jv_free(t);
+  jv_free(k);
+  q->val_get_result = v;
+  return v;
+}
+
+jv jq_query_front_value_get(jv t, jv k) {
+  struct jq_query_front *q = jq_query_front_self();
+  jv_kind tk = jv_get_kind(t);
+  jv_kind kk = jv_get_kind(k);
+  q->val_get_container = t;
+  q->val_get_key = k;
+  (void)jq_query_front_get_pair_supported(q, tk, kk);
+  (void)jq_query_front_idx_accepts_field(q, tk);
+  (void)jq_query_front_idx_accepts_number(q, tk);
+  (void)jq_query_front_idx_accepts_slice(q, tk);
+  if (tk == JV_KIND_OBJECT && kk == JV_KIND_STRING) {
+    return jq_query_front_get_object_string(q, t, k);
+  }
+  if (tk == JV_KIND_ARRAY && kk == JV_KIND_NUMBER) {
+    return jq_query_front_get_array_number(q, t, k);
+  }
+  if (tk == JV_KIND_ARRAY && kk == JV_KIND_OBJECT) {
+    return jq_query_front_get_array_slice(q, t, k);
+  }
+  if (tk == JV_KIND_STRING && kk == JV_KIND_OBJECT) {
+    return jq_query_front_get_string_slice(q, t, k);
+  }
+  if (tk == JV_KIND_ARRAY && kk == JV_KIND_ARRAY) {
+    return jq_query_front_get_array_indexes(q, t, k);
+  }
+  if (tk == JV_KIND_NULL &&
+      (kk == JV_KIND_STRING || kk == JV_KIND_NUMBER || kk == JV_KIND_OBJECT)) {
+    return jq_query_front_get_null_key(q, t, k);
+  }
+  return jq_query_front_get_mismatch(q, t, k);
+}
+
+static jv jq_query_front_set_object_string(struct jq_query_front *q, jv t, jv k, jv v, int isnull) {
+  q->val_set_container = t;
+  q->val_set_key = k;
+  q->val_set_value = v;
+  if (isnull) t = jv_object();
+  return jv_object_set(t, k, v);
+}
+
+static jv jq_query_front_set_array_number(struct jq_query_front *q, jv t, jv k, jv v, int isnull) {
+  q->val_set_container = t;
+  q->val_set_key = k;
+  q->val_set_value = v;
+  if (isnull) t = jv_array();
+  t = jv_array_set(t, (int)jv_number_value(k), v);
+  jv_free(k);
+  return t;
+}
+
+static jv jq_query_front_set_array_slice(struct jq_query_front *q, jv t, jv k, jv v, int isnull) {
+  int start, end;
+  q->val_set_container = t;
+  q->val_set_key = k;
+  q->val_set_value = v;
+  if (isnull) t = jv_array();
+  if (jq_query_front_parse_slice(q, jv_copy(t), k, &start, &end)) {
+    q->val_set_start = start;
+    q->val_set_end = end;
+    if (jv_get_kind(v) == JV_KIND_ARRAY) {
+      int array_len = jv_array_length(jv_copy(t));
+      int slice_len = end - start;
+      int insert_len = jv_array_length(jv_copy(v));
+      if (slice_len < insert_len) {
+        int shift = insert_len - slice_len;
+        for (int i = array_len - 1; i >= end; i--) {
+          t = jv_array_set(t, i + shift, jv_array_get(jv_copy(t), i));
+        }
+      } else if (slice_len > insert_len) {
+        int shift = slice_len - insert_len;
+        for (int i = end; i < array_len; i++) {
+          t = jv_array_set(t, i - shift, jv_array_get(jv_copy(t), i));
+        }
+        t = jv_array_slice(t, 0, array_len - shift);
+      }
+      for (int i=0; i < insert_len; i++) {
+        t = jv_array_set(t, start + i, jv_array_get(jv_copy(v), i));
+      }
+      jv_free(v);
+    } else {
+      jv_free(t);
+      jv_free(v);
+      t = jv_invalid_with_msg(jv_string_fmt("A slice of an array can only be assigned another array"));
+    }
+  } else {
+    jv_free(t);
+    jv_free(v);
+    t = jv_invalid_with_msg(jv_string_fmt("Start and end indices of an array slice must be numbers"));
+  }
+  return t;
+}
+
+static jv jq_query_front_set_mismatch(struct jq_query_front *q, jv t, jv k, jv v) {
+  jv err;
+  q->val_set_container = t;
+  q->val_set_key = k;
+  q->val_set_value = v;
+  err = jv_invalid_with_msg(jv_string_fmt("Cannot update field at %s index of %s",
+                                           jv_kind_name(jv_get_kind(k)),
+                                           jv_kind_name(jv_get_kind(t))));
+  jv_free(t);
+  jv_free(k);
+  jv_free(v);
+  return err;
+}
+
+jv jq_query_front_value_set(jv t, jv k, jv v) {
+  struct jq_query_front *q = jq_query_front_self();
+  int isnull;
+  q->val_set_container = t;
+  q->val_set_key = k;
+  q->val_set_value = v;
+  if (!jv_is_valid(v)) {
+    jv_free(t);
+    jv_free(k);
+    return v;
+  }
+  isnull = jv_get_kind(t) == JV_KIND_NULL;
+  (void)jq_query_front_set_pair_supported(q, jv_get_kind(t), jv_get_kind(k));
+  if (jv_get_kind(k) == JV_KIND_STRING &&
+      (jv_get_kind(t) == JV_KIND_OBJECT || isnull)) {
+    return jq_query_front_set_object_string(q, t, k, v, isnull);
+  }
+  if (jv_get_kind(k) == JV_KIND_NUMBER &&
+      (jv_get_kind(t) == JV_KIND_ARRAY || isnull)) {
+    return jq_query_front_set_array_number(q, t, k, v, isnull);
+  }
+  if (jv_get_kind(k) == JV_KIND_OBJECT &&
+      (jv_get_kind(t) == JV_KIND_ARRAY || isnull)) {
+    return jq_query_front_set_array_slice(q, t, k, v, isnull);
+  }
+  return jq_query_front_set_mismatch(q, t, k, v);
