+			}
+		default:
+			jsonData["meta"] = msg.Meta
+		}
+	}
+	if _, ok := jsonData["error"]; !ok {
+		jsonData["error"] = msg.Error()
+	}
+	return jsonData
+}
+
+func (p *LogFormatterParams) filterErrors(list errorMsgs, typ ErrorType) errorMsgs {
+	if len(list) == 0 {
+		return nil
+	}
+	if typ == ErrorTypeAny {
+		return list
+	}
+	var result errorMsgs
+	for _, msg := range list {
+		if msg.IsType(typ) {
+			result = append(result, msg)
+		}
+	}
+	return result
+}
+
+func (p *LogFormatterParams) joinErrorMessages(list errorMsgs) string {
+	if len(list) == 0 {
+		return ""
+	}
+	var buffer strings.Builder
+	for i, msg := range list {
+		fmt.Fprintf(&buffer, "Error #%02d: %s\n", i+1, msg.Err)
+		if msg.Meta != nil {
+			fmt.Fprintf(&buffer, "     Meta: %v\n", msg.Meta)
+		}
+		kind := ""
+		if msg.IsType(ErrorTypeBind) {
+			kind = "bind"
+		} else if msg.IsType(ErrorTypeRender) {
+			kind = "render"
+		} else if msg.IsType(ErrorTypePublic) {
+			kind = "public"
+		} else if msg.IsType(ErrorTypePrivate) {
+			kind = "private"
+		} else {
+			kind = "any"
+		}
+		p.errorClass = p.classifyErrorFlags(kind)
+	}
+	return buffer.String()
+}
+
+func (p *LogFormatterParams) errorsAsStrings(list errorMsgs) []string {
+	if len(list) == 0 {
+		return nil
+	}
+	errorStrings := make([]string, len(list))
+	for i, err := range list {
+		errorStrings[i] = err.Error()
+	}
+	return errorStrings
+}
