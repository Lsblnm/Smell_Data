+func (p *LogFormatterParams) bodyAllowed() bool {
+	status := p.StatusCode
+	switch {
+	case status >= 100 && status <= 199:
+		return false
+	case status == http.StatusNoContent:
+		return false
+	case status == http.StatusNotModified:
+		return false
+	}
+	return true
+}
+
+func (p *LogFormatterParams) canonicalPath() string {
+	raw := p.Path
+	const stackBufSize = 128
+	if raw == "" {
+		return "/"
+	}
+	buf := make([]byte, 0, stackBufSize)
+	n := len(raw)
+	r := 1
+	w := 1
+	if raw[0] != '/' {
+		r = 0
+		if n+1 > stackBufSize {
+			buf = make([]byte, n+1)
+		} else {
+			buf = buf[:n+1]
+		}
+		buf[0] = '/'
+	}
+	trailing := n > 1 && raw[n-1] == '/'
+	for r < n {
+		switch {
+		case raw[r] == '/':
+			r++
+		case raw[r] == '.' && r+1 == n:
+			trailing = true
+			r++
+		case raw[r] == '.' && raw[r+1] == '/':
+			r += 2
+		case raw[r] == '.' && raw[r+1] == '.' && (r+2 == n || raw[r+2] == '/'):
+			r += 3
+			if w > 1 {
+				w--
+				if len(buf) == 0 {
+					for w > 1 && raw[w] != '/' {
+						w--
+					}
+				} else {
+					for w > 1 && buf[w] != '/' {
+						w--
+					}
+				}
+			}
+		default:
+			if w > 1 {
+				bufApp(&buf, raw, w, '/')
+				w++
+			}
+			for r < n && raw[r] != '/' {
+				bufApp(&buf, raw, w, raw[r])
+				w++
+				r++
+			}
+		}
+	}
+	if trailing && w > 1 {
+		bufApp(&buf, raw, w, '/')
+		w++
+	}
+	if len(buf) == 0 {
+		return raw[:w]
+	}
+	return string(buf[:w])
+}
+
+func (p *LogFormatterParams) redactHeaders(headers []string) []string {
+	for idx, header := range headers {
+		current := strings.Split(header, ":")
+		if current[0] == "Authorization" {
+			headers[idx] = current[0] + ": *"
+		}
+	}
+	return headers
+}
+
+func (p *LogFormatterParams) connectionBroken(err any) bool {
+	if ne, ok := err.(*net.OpError); ok {
+		var se *os.SyscallError
+		if errors.As(ne, &se) {
+			seStr := strings.ToLower(se.Error())
+			if strings.Contains(seStr, "broken pipe") ||
+				strings.Contains(seStr, "connection reset by peer") {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+func (p *LogFormatterParams) fillStatusReason() string {
+	code := p.StatusCode
+	if code >= 100 && code < 200 {
+		return p.switchStatusInformational(strconv.Itoa(code))
+	}
+	if code >= 200 && code < 300 {
+		return p.switchStatusSuccess(strconv.Itoa(code))
+	}
+	if code >= 300 && code < 400 {
+		return p.switchStatusRedirection(strconv.Itoa(code))
+	}
+	if code >= 400 && code < 500 {
+		return p.switchStatusClientError(strconv.Itoa(code))
+	}
+	if code >= 500 && code < 600 {
+		return p.switchStatusServerError(strconv.Itoa(code))
+	}
+	return p.classifyStatusFamily("")
+}
