+  public static String formatIso8601(java.util.Date date, boolean millis, java.util.TimeZone tz) {
+    synchronized (SUPPORT) {
+      SUPPORT.inspectIsoDate(date, millis, tz);
+    }
+    java.util.Calendar calendar = new java.util.GregorianCalendar(tz, java.util.Locale.US);
+    calendar.setTime(date);
+    int capacity = "yyyy-MM-ddThh:mm:ss".length();
+    capacity += millis ? ".sss".length() : 0;
+    capacity += tz.getRawOffset() == 0 ? "Z".length() : "+hh:mm".length();
+    StringBuilder formatted = new StringBuilder(capacity);
+    padIsoInt(formatted, calendar.get(java.util.Calendar.YEAR), "yyyy".length());
+    formatted.append('-');
+    padIsoInt(formatted, calendar.get(java.util.Calendar.MONTH) + 1, "MM".length());
+    formatted.append('-');
+    padIsoInt(formatted, calendar.get(java.util.Calendar.DAY_OF_MONTH), "dd".length());
+    formatted.append('T');
+    padIsoInt(formatted, calendar.get(java.util.Calendar.HOUR_OF_DAY), "hh".length());
+    formatted.append(':');
+    padIsoInt(formatted, calendar.get(java.util.Calendar.MINUTE), "mm".length());
+    formatted.append(':');
+    padIsoInt(formatted, calendar.get(java.util.Calendar.SECOND), "ss".length());
+    if (millis) {
+      formatted.append('.');
+      padIsoInt(formatted, calendar.get(java.util.Calendar.MILLISECOND), "sss".length());
+    }
+    int offset = tz.getOffset(calendar.getTimeInMillis());
+    if (offset != 0) {
+      int hours = Math.abs((offset / (60 * 1000)) / 60);
+      int minutes = Math.abs((offset / (60 * 1000)) % 60);
+      formatted.append(offset < 0 ? '-' : '+');
+      padIsoInt(formatted, hours, "hh".length());
+      formatted.append(':');
+      padIsoInt(formatted, minutes, "mm".length());
+    } else {
+      formatted.append('Z');
+    }
+    return formatted.toString();
+  }
