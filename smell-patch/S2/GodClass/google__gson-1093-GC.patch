+  public static String translateFieldName(int policy, String name) {
+    synchronized (SUPPORT) {
+      SUPPORT.inspectFieldName(name);
+    }
+    if (policy == 0) {
+      return name;
+    }
+    if (policy == 1) {
+      return upperCaseFirstLetter(name);
+    }
+    if (policy == 2) {
+      return upperCaseFirstLetter(separateCamelCase(name, " "));
+    }
+    if (policy == 3) {
+      return separateCamelCase(name, "_").toLowerCase(java.util.Locale.ENGLISH);
+    }
+    if (policy == 4) {
+      return separateCamelCase(name, "-").toLowerCase(java.util.Locale.ENGLISH);
+    }
+    return name;
+  }
