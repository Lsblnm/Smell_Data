+func (n *NodeAbstractResourceInstance) collectSchemaAttributePaths(schema *configschema.Block, prefix cty.Path) []cty.Path {
+	if schema == nil {
+		return nil
+	}
+	var paths []cty.Path
+	names := n.schemaAttributeNames(schema)
+	for _, name := range names {
+		attr := schema.Attributes[name]
+		path := n.appendAttrPath(prefix, name)
+		paths = append(paths, path)
+		if attr.NestedType != nil {
+			paths = append(paths, n.collectObjectAttributePaths(attr.NestedType, path)...)
+		}
+	}
+	blockNames := make([]string, 0, len(schema.BlockTypes))
+	for name := range schema.BlockTypes {
+		blockNames = append(blockNames, name)
+	}
+	sort.Strings(blockNames)
+	for _, name := range blockNames {
+		block := schema.BlockTypes[name]
+		path := n.appendAttrPath(prefix, name)
+		paths = append(paths, n.collectSchemaAttributePaths(&block.Block, path)...)
+	}
+	return paths
+}
+
+func (n *NodeAbstractResourceInstance) collectObjectAttributePaths(obj *configschema.Object, prefix cty.Path) []cty.Path {
+	if obj == nil {
+		return nil
+	}
+	var paths []cty.Path
+	names := make([]string, 0, len(obj.Attributes))
+	for name := range obj.Attributes {
+		names = append(names, name)
+	}
+	sort.Strings(names)
+	for _, name := range names {
+		attr := obj.Attributes[name]
+		path := n.appendAttrPath(prefix, name)
+		paths = append(paths, path)
+		if attr.NestedType != nil {
+			paths = append(paths, n.collectObjectAttributePaths(attr.NestedType, path)...)
+		}
+	}
+	return paths
+}
