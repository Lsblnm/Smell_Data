+func (n *NodeAbstractResourceInstance) catalogSchemaAttribute(name string, attr *configschema.Attribute) resourceSchemaAttrInfo {
+	info := resourceSchemaAttrInfo{name: name}
+	if attr == nil {
+		return info
+	}
+	info.required = attr.Required
+	info.optional = attr.Optional
+	info.computed = attr.Computed
+	info.sensitive = attr.Sensitive
+	info.deprecated = attr.Deprecated
+	info.typeName = n.formatAttrType(attr)
+	info.nested = attr.NestedType != nil
+	return info
+}
+
+func (n *NodeAbstractResourceInstance) catalogObjectAttributes(prefix string, obj *configschema.Object) []resourceSchemaAttrInfo {
+	if obj == nil {
+		return nil
+	}
+	out := make([]resourceSchemaAttrInfo, 0, len(obj.Attributes))
+	for _, name := range n.objectAttributeNames(obj) {
+		full := prefix + "." + name
+		out = append(out, n.catalogSchemaAttribute(full, obj.Attributes[name]))
+		attr := obj.Attributes[name]
+		if attr != nil && attr.NestedType != nil {
+			out = append(out, n.catalogObjectAttributes(full, attr.NestedType)...)
+		}
+	}
+	return out
+}
+
+func (n *NodeAbstractResourceInstance) formatAttributeCatalog(schema *configschema.Block) string {
+	items := n.catalogSchemaAttributes(schema)
+	parts := make([]string, 0, len(items))
+	for _, item := range items {
+		parts = append(parts, n.formatAttributeCatalogItem(item))
+	}
+	return strings.Join(parts, "\n")
+}
+
+func (n *NodeAbstractResourceInstance) formatAttributeCatalogItem(item resourceSchemaAttrInfo) string {
+	return strings.Join([]string{
+		item.name,
+		n.formatBool(item.required),
+		n.formatBool(item.optional),
+		n.formatBool(item.computed),
+		n.formatBool(item.sensitive),
+		n.formatBool(item.deprecated),
+		item.typeName,
+		n.formatBool(item.nested),
+	}, "|")
+}
+
+func (n *NodeAbstractResourceInstance) schemaBlockCount(schema *configschema.Block) int {
+	if schema == nil {
+		return 0
+	}
+	total := len(schema.BlockTypes)
+	for _, block := range schema.BlockTypes {
+		total += n.schemaBlockCount(&block.Block)
+	}
+	return total
+}
+
+func (n *NodeAbstractResourceInstance) schemaMaxDepth(schema *configschema.Block) int {
+	if schema == nil {
+		return 0
+	}
+	maxDepth := 1
+	for _, attr := range schema.Attributes {
+		if attr.NestedType != nil {
+			d := 1 + n.objectMaxDepth(attr.NestedType)
+			if d > maxDepth {
+				maxDepth = d
+			}
+		}
+	}
+	for _, block := range schema.BlockTypes {
+		d := 1 + n.schemaMaxDepth(&block.Block)
+		if d > maxDepth {
+			maxDepth = d
+		}
+	}
+	return maxDepth
+}
+
+func (n *NodeAbstractResourceInstance) objectMaxDepth(obj *configschema.Object) int {
+	if obj == nil {
+		return 0
+	}
+	maxDepth := 1
+	for _, attr := range obj.Attributes {
+		if attr.NestedType != nil {
+			d := 1 + n.objectMaxDepth(attr.NestedType)
+			if d > maxDepth {
+				maxDepth = d
+			}
+		}
+	}
+	return maxDepth
+}
