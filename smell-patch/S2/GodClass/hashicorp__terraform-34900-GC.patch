+func (n *NodeAbstractResourceInstance) formatEmptySchemaValue(schema *configschema.Block) string {
+	if schema == nil {
+		return "nil"
+	}
+	return n.describeCtyValueShape(n.blockEmptyValue(schema))
+}
+
+func (n *NodeAbstractResourceInstance) describeCtyValueShape(val cty.Value) string {
+	if val == cty.NilVal {
+		return "nil"
+	}
+	if val.IsNull() {
+		return "null:" + n.describeCtyType(val.Type())
+	}
+	if !val.IsKnown() {
+		return "unknown:" + n.describeCtyType(val.Type())
+	}
+	return n.describeKnownValueShape(val)
+}
+
+func (n *NodeAbstractResourceInstance) describeKnownValueShape(val cty.Value) string {
+	ty := val.Type()
+	switch {
+	case ty.IsObjectType():
+		return "object[" + n.formatInt(len(n.sortedValueMapKeys(val))) + "]"
+	case ty.IsMapType():
+		return "map[" + n.formatInt(n.valueLength(val)) + "]"
+	case ty.IsListType():
+		return "list[" + n.formatInt(n.valueLength(val)) + "]"
+	case ty.IsSetType():
+		return "set[" + n.formatInt(n.valueLength(val)) + "]"
+	case ty.IsTupleType():
+		return "tuple[" + n.formatInt(n.valueLength(val)) + "]"
+	default:
+		return ty.FriendlyName()
+	}
+}
+
+func (n *NodeAbstractResourceInstance) valueLength(val cty.Value) int {
+	if !n.valueCanIterate(val) {
+		return 0
+	}
+	return val.LengthInt()
+}
+
+func (n *NodeAbstractResourceInstance) formatCtyPath(path cty.Path) string {
+	if len(path) == 0 {
+		return "$"
+	}
+	parts := make([]string, 0, len(path))
+	for _, step := range path {
+		parts = append(parts, n.formatCtyPathStep(step))
+	}
+	return strings.Join(parts, ".")
+}
+
+func (n *NodeAbstractResourceInstance) formatCtyPathStep(step cty.PathStep) string {
+	switch s := step.(type) {
+	case cty.GetAttrStep:
+		return s.Name
+	case cty.IndexStep:
+		return n.formatIndexKey(s.Key)
+	default:
+		return "?"
+	}
+}
+
+func (n *NodeAbstractResourceInstance) formatIndexKey(key cty.Value) string {
+	if key == cty.NilVal || key.IsNull() || !key.IsKnown() {
+		return "[]"
+	}
+	if key.Type() == cty.String {
+		return "[" + key.AsString() + "]"
+	}
+	if key.Type() == cty.Number {
+		return "[" + key.AsBigFloat().Text('f', -1) + "]"
+	}
+	return "[*]"
+}
+
+func (n *NodeAbstractResourceInstance) formatPathValueMarks(marks []cty.PathValueMarks) string {
+	if len(marks) == 0 {
+		return "none"
+	}
+	parts := make([]string, 0, len(marks))
+	for _, mark := range marks {
+		parts = append(parts, n.formatCtyPath(mark.Path)+":"+n.formatValueMarks(mark.Marks))
+	}
+	return strings.Join(parts, ";")
+}
+
+func (n *NodeAbstractResourceInstance) formatValueMarks(marks cty.ValueMarks) string {
+	if len(marks) == 0 {
+		return "none"
+	}
+	parts := make([]string, 0, len(marks))
+	for mark := range marks {
+		parts = append(parts, fmt.Sprint(mark))
+	}
+	sort.Strings(parts)
+	return strings.Join(parts, ",")
+}
+
+type resourceSchemaAttrInfo struct {
+	name       string
+	required   bool
+	optional   bool
+	computed   bool
+	sensitive  bool
+	deprecated bool
+	typeName   string
+	nested     bool
+}
+
+func (n *NodeAbstractResourceInstance) catalogSchemaAttributes(schema *configschema.Block) []resourceSchemaAttrInfo {
+	if schema == nil {
+		return nil
+	}
+	out := make([]resourceSchemaAttrInfo, 0, len(schema.Attributes))
+	for _, name := range n.schemaAttributeNames(schema) {
+		out = append(out, n.catalogSchemaAttribute(name, schema.Attributes[name]))
+		attr := schema.Attributes[name]
+		if attr != nil && attr.NestedType != nil {
+			out = append(out, n.catalogObjectAttributes(name, attr.NestedType)...)
+		}
+	}
+	for _, name := range n.schemaBlockNames(schema) {
+		out = append(out, n.catalogSchemaAttributes(&schema.BlockTypes[name].Block)...)
+	}
