+func (n *NodeAbstractResourceInstance) writeSchemaInventory(b *strings.Builder, schema *configschema.Block) {
+	if schema == nil {
+		return
+	}
+	info := n.inspectResourceSchema(schema)
+	b.WriteString("inventory")
+	b.WriteString(" attrCount=")
+	b.WriteString(n.formatInt(info.attrCount))
+	b.WriteString(" computed=")
+	b.WriteString(n.formatBool(info.hasComputed))
+	b.WriteString(" optional=")
+	b.WriteString(n.formatBool(info.hasOptional))
+	b.WriteString(" sensitive=")
+	b.WriteString(n.formatBool(info.hasSensitive))
+	b.WriteString(" pathCount=")
+	b.WriteString(n.formatInt(len(info.paths)))
+	b.WriteString(" empty=")
+	b.WriteString(n.describeCtyValueShape(info.empty))
+	b.WriteString(" implied=")
+	b.WriteString(n.formatImpliedSchemaType(schema))
+	b.WriteString(" depth=")
+	b.WriteString(n.formatInt(n.schemaMaxDepth(schema)))
+	b.WriteString(" blocks=")
+	b.WriteString(n.formatInt(n.schemaBlockCount(schema)))
+	b.WriteByte('\n')
+	for _, path := range info.paths {
+		b.WriteString("path ")
+		b.WriteString(n.formatCtyPath(path))
+		b.WriteByte('\n')
+	}
+	for _, item := range n.catalogSchemaAttributes(schema) {
+		b.WriteString("item ")
+		b.WriteString(n.formatAttributeCatalogItem(item))
+		b.WriteByte('\n')
+	}
+}
