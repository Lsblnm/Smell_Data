+func (n *NodeAbstractResourceInstance) mergePathValueMarks(dst, src []cty.PathValueMarks) []cty.PathValueMarks {
+	if len(src) == 0 {
+		return dst
+	}
+	if len(dst) == 0 {
+		out := make([]cty.PathValueMarks, len(src))
+		copy(out, src)
+		return out
+	}
+	seen := make(map[string]bool, len(dst)+len(src))
+	out := make([]cty.PathValueMarks, 0, len(dst)+len(src))
+	for _, mark := range dst {
+		key := fmt.Sprintf("%#v", mark)
+		if seen[key] {
+			continue
+		}
+		seen[key] = true
+		out = append(out, mark)
+	}
+	for _, mark := range src {
+		key := fmt.Sprintf("%#v", mark)
+		if seen[key] {
+			continue
+		}
+		seen[key] = true
+		out = append(out, mark)
+	}
+	return out
+}
+
+func (n *NodeAbstractResourceInstance) marksApplyToValue(val cty.Value, marks []cty.PathValueMarks) []cty.PathValueMarks {
+	if len(marks) == 0 {
+		return nil
+	}
+	var out []cty.PathValueMarks
+	for _, mark := range marks {
+		if _, err := mark.Path.Apply(val); err == nil {
+			out = append(out, mark)
+		}
+	}
+	return out
+}
