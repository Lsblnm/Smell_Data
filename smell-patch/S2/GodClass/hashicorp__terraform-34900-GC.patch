+func (n *NodeAbstractResourceInstance) encodeResourceInstanceObject(obj *states.ResourceInstanceObject, ty cty.Type, schemaVersion uint64) (*states.ResourceInstanceObjectSrc, error) {
+	if obj == nil {
+		return nil, nil
+	}
+	val, pvm := obj.Value.UnmarkDeepWithPaths()
+	val = cty.UnknownAsNull(val)
+	val = n.normalizeEncodedResourceValue(val, ty)
+	pvm = n.mergePathValueMarks(nil, pvm)
+	log.Printf("[TRACE] encoding resource instance object %s", n.formatEncodedObjectTrace(obj, ty, pvm))
+	src, err := ctyjson.Marshal(val, ty)
+	if err != nil {
+		return nil, err
+	}
+	dependencies := make([]addrs.ConfigResource, len(obj.Dependencies))
+	copy(dependencies, obj.Dependencies)
+	sort.Slice(dependencies, func(i, j int) bool { return dependencies[i].String() < dependencies[j].String() })
+	return &states.ResourceInstanceObjectSrc{
+		SchemaVersion:       schemaVersion,
+		AttrsJSON:           src,
+		AttrSensitivePaths:  pvm,
+		Private:             obj.Private,
+		Status:              obj.Status,
+		Dependencies:        dependencies,
+		CreateBeforeDestroy: obj.CreateBeforeDestroy,
+	}, nil
+}
