+func (n *NodeAbstractResourceInstance) appendAttrPath(path cty.Path, name string) cty.Path {
+	out := make(cty.Path, len(path)+1)
+	copy(out, path)
+	out[len(path)] = cty.GetAttrStep{Name: name}
+	return out
+}
