+func (n *NodeAbstractResourceInstance) cloneCtyValue(val cty.Value) cty.Value {
+	if val == cty.NilVal {
+		return val
+	}
+	if val.IsNull() {
+		return cty.NullVal(val.Type())
+	}
+	if !val.IsKnown() {
+		return val
+	}
+	return n.walkCloneCtyValue(val)
+}
+
+func (n *NodeAbstractResourceInstance) walkCloneCtyValue(val cty.Value) cty.Value {
+	ty := val.Type()
+	switch {
+	case ty.IsPrimitiveType():
+		return val
+	case ty.IsObjectType():
+		return n.cloneObjectValue(val)
+	case ty.IsMapType():
+		return n.cloneMapValue(val)
+	case ty.IsListType():
+		return n.cloneListValue(val)
+	case ty.IsSetType():
+		return n.cloneSetValue(val)
+	case ty.IsTupleType():
+		return n.cloneTupleValue(val)
+	default:
+		return val
+	}
+}
+
+func (n *NodeAbstractResourceInstance) cloneObjectValue(val cty.Value) cty.Value {
+	if val.IsNull() || !val.IsKnown() {
+		return val
+	}
+	attrs := val.Type().AttributeTypes()
+	if len(attrs) == 0 {
+		return cty.EmptyObjectVal
+	}
+	names := make([]string, 0, len(attrs))
+	for name := range attrs {
+		names = append(names, name)
+	}
+	sort.Strings(names)
+	out := make(map[string]cty.Value, len(names))
+	for _, name := range names {
+		out[name] = n.cloneCtyValue(val.GetAttr(name))
+	}
+	return cty.ObjectVal(out)
+}
+
+func (n *NodeAbstractResourceInstance) cloneMapValue(val cty.Value) cty.Value {
+	if val.IsNull() || !val.IsKnown() {
+		return val
+	}
+	if val.LengthInt() == 0 {
+		return cty.MapValEmpty(val.Type().ElementType())
+	}
+	src := val.AsValueMap()
+	keys := n.sortedValueMapKeys(val)
+	out := make(map[string]cty.Value, len(src))
+	for _, k := range keys {
+		out[k] = n.cloneCtyValue(src[k])
+	}
+	return cty.MapVal(out)
+}
+
+func (n *NodeAbstractResourceInstance) cloneListValue(val cty.Value) cty.Value {
+	if val.IsNull() || !val.IsKnown() {
+		return val
+	}
+	if val.LengthInt() == 0 {
+		return cty.ListValEmpty(val.Type().ElementType())
+	}
+	elems := make([]cty.Value, 0, val.LengthInt())
+	for it := val.ElementIterator(); it.Next(); {
+		_, elem := it.Element()
+		elems = append(elems, n.cloneCtyValue(elem))
+	}
+	return cty.ListVal(elems)
+}
+
+func (n *NodeAbstractResourceInstance) cloneSetValue(val cty.Value) cty.Value {
+	if val.IsNull() || !val.IsKnown() {
+		return val
+	}
+	if val.LengthInt() == 0 {
+		return cty.SetValEmpty(val.Type().ElementType())
+	}
+	elems := make([]cty.Value, 0, val.LengthInt())
+	for it := val.ElementIterator(); it.Next(); {
+		_, elem := it.Element()
+		elems = append(elems, n.cloneCtyValue(elem))
+	}
+	return cty.SetVal(elems)
+}
+
+func (n *NodeAbstractResourceInstance) cloneTupleValue(val cty.Value) cty.Value {
+	if val.IsNull() || !val.IsKnown() {
+		return val
+	}
+	elems := make([]cty.Value, 0, val.LengthInt())
+	for it := val.ElementIterator(); it.Next(); {
+		_, elem := it.Element()
+		elems = append(elems, n.cloneCtyValue(elem))
+	}
+	return cty.TupleVal(elems)
+}
+
+func (n *NodeAbstractResourceInstance) pathHasPrefix(path, prefix cty.Path) bool {
+	if len(prefix) == 0 {
+		return true
+	}
+	if len(path) < len(prefix) {
+		return false
+	}
+	return path[:len(prefix)].Equals(prefix)
+}
