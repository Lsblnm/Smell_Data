+func (n *NodeAbstractResourceInstance) valueMarksIndicateSensitive(marks cty.ValueMarks) bool {
+	for mark := range marks {
+		if gs, ok := mark.(fmt.GoStringer); ok && gs.GoString() == "marks.Sensitive" {
+			return true
+		}
+		if fmt.Sprint(mark) == "Sensitive" {
+			return true
+		}
+	}
+	return false
+}
