+func (n *NodeAbstractResourceInstance) formatEncodedObjectTrace(obj *states.ResourceInstanceObject, ty cty.Type, pvm []cty.PathValueMarks) string {
+	var b strings.Builder
+	b.WriteString(n.formatResourceInstanceObjectMeta(obj))
+	b.WriteString(" | ")
+	b.WriteString(n.describeCtyType(ty))
+	b.WriteString(" | ")
+	b.WriteString(n.formatPathValueMarks(pvm))
+	b.WriteByte('\n')
