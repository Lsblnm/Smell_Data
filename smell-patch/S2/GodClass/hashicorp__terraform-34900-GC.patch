+	b.WriteString(" deps=")
+	b.WriteString(n.formatInt(len(obj.Dependencies)))
+	b.WriteString(" cbd=")
+	b.WriteString(n.formatBool(obj.CreateBeforeDestroy))
+	b.WriteString(" value=")
