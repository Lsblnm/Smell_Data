+func (n *NodeAbstractResourceInstance) alignValueToType(val cty.Value, ty cty.Type) cty.Value {
+	if ty == cty.NilType || val == cty.NilVal {
+		return val
+	}
+	converted, err := convert.Convert(val, ty)
+	if err != nil {
+		return val
+	}
+	return converted
+}
