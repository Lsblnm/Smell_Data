+func (n *NodeAbstractResourceInstance) nestedBlockEmptyByMode(block *configschema.NestedBlock) cty.Value {
+	if block == nil {
+		return cty.NullVal(cty.DynamicPseudoType)
+	}
+	return n.nestedBlockEmptyValue(block)
+}
+
+func (n *NodeAbstractResourceInstance) blockAttributeType(schema *configschema.Block, name string) cty.Type {
+	if schema == nil {
+		return cty.NilType
+	}
+	if attr, ok := schema.Attributes[name]; ok && attr != nil {
+		return attr.ImpliedType()
+	}
+	if block, ok := schema.BlockTypes[name]; ok && block != nil {
+		return n.nestedBlockEmptyValue(block).Type()
+	}
+	return cty.NilType
+}
+
+func (n *NodeAbstractResourceInstance) valueKnownNonNull(val cty.Value) bool {
+	return val != cty.NilVal && !val.IsNull() && val.IsKnown()
+}
+
+func (n *NodeAbstractResourceInstance) valueCanIterate(val cty.Value) bool {
+	return n.valueKnownNonNull(val) && val.CanIterateElements()
+}
+
+func (n *NodeAbstractResourceInstance) sortedValueMapKeys(val cty.Value) []string {
+	if !n.valueCanIterate(val) {
+		return nil
+	}
+	if !val.Type().IsObjectType() && !val.Type().IsMapType() {
+		return nil
+	}
+	src := val.AsValueMap()
+	keys := make([]string, 0, len(src))
+	for k := range src {
+		keys = append(keys, k)
+	}
+	sort.Strings(keys)
+	return keys
+}
+
+func (n *NodeAbstractResourceInstance) inspectResourceSchema(schema *configschema.Block) resourceSchemaInspection {
+	info := resourceSchemaInspection{}
+	if schema == nil {
+		return info
+	}
+	info.attrCount = n.countSchemaAttributes(schema)
+	info.hasComputed = n.schemaHasComputedAttributes(schema)
+	info.hasOptional = n.schemaHasOptionalAttributes(schema)
+	info.hasSensitive = n.blockContainsSensitive(schema)
+	info.empty = n.blockEmptyValue(schema)
+	info.paths = n.collectSchemaAttributePaths(schema, nil)
+	return info
+}
+
+type resourceSchemaInspection struct {
+	attrCount    int
+	hasComputed  bool
+	hasOptional  bool
+	hasSensitive bool
+	empty        cty.Value
+	paths        []cty.Path
+}
+
+
+func (n *NodeAbstractResourceInstance) formatResourceSchema(schema *configschema.Block) string {
+	if schema == nil {
+		return "nil-schema"
+	}
+	var b strings.Builder
+	n.writeSchemaDump(&b, schema, "")
+	b.WriteString("\n")
+	b.WriteString(n.formatAttributeCatalog(schema))
+	b.WriteString("\n")
+	b.WriteString(n.formatSchemaSummary(schema))
+	b.WriteString("\n")
+	b.WriteString(n.formatImpliedSchemaType(schema))
+	b.WriteString("\n")
+	b.WriteString(n.formatEmptySchemaValue(schema))
+	return b.String()
+}
+
+func (n *NodeAbstractResourceInstance) writeSchemaDump(b *strings.Builder, schema *configschema.Block, indent string) {
+	if schema == nil {
+		b.WriteString(indent)
+		b.WriteString("<nil>\n")
+		return
+	}
+	n.writeSchemaAttributeDump(b, schema, indent)
+	n.writeSchemaBlockDump(b, schema, indent)
+}
+
+func (n *NodeAbstractResourceInstance) writeSchemaAttributeDump(b *strings.Builder, schema *configschema.Block, indent string) {
+	for _, name := range n.schemaAttributeNames(schema) {
+		n.writeOneAttributeDump(b, name, schema.Attributes[name], indent)
+	}
+}
+
+func (n *NodeAbstractResourceInstance) writeSchemaBlockDump(b *strings.Builder, schema *configschema.Block, indent string) {
+	for _, name := range n.schemaBlockNames(schema) {
+		n.writeOneBlockDump(b, name, schema.BlockTypes[name], indent)
+	}
+}
+
+func (n *NodeAbstractResourceInstance) writeOneAttributeDump(b *strings.Builder, name string, attr *configschema.Attribute, indent string) {
+	b.WriteString(indent)
+	b.WriteString("attr ")
+	b.WriteString(name)
+	b.WriteByte(' ')
+	b.WriteString(n.formatAttrRequired(attr))
+	b.WriteByte(' ')
+	b.WriteString(n.formatAttrOptional(attr))
+	b.WriteByte(' ')
+	b.WriteString(n.formatAttrComputed(attr))
+	b.WriteByte(' ')
+	b.WriteString(n.formatAttrSensitive(attr))
+	b.WriteByte(' ')
+	b.WriteString(n.formatAttrDeprecated(attr))
+	b.WriteByte(' ')
+	b.WriteString(n.formatAttrType(attr))
+	b.WriteByte(' ')
+	b.WriteString(n.formatAttrDescription(attr))
+	b.WriteByte('\n')
+	if attr != nil && attr.NestedType != nil {
+		n.writeNestedObjectDump(b, attr.NestedType, indent+"  ")
+	}
+}
+
+func (n *NodeAbstractResourceInstance) writeOneBlockDump(b *strings.Builder, name string, block *configschema.NestedBlock, indent string) {
+	b.WriteString(indent)
+	b.WriteString("block ")
+	b.WriteString(name)
+	if block == nil {
+		b.WriteString(" <nil>\n")
+		return
+	}
+	b.WriteString(" nesting=")
+	b.WriteString(n.formatNestingMode(block.Nesting))
+	b.WriteString(" min=")
+	b.WriteString(n.formatInt(block.MinItems))
+	b.WriteString(" max=")
+	b.WriteString(n.formatInt(block.MaxItems))
+	b.WriteString(" deprecated=")
+	b.WriteString(n.formatBool(block.Deprecated))
+	b.WriteByte('\n')
+	n.writeSchemaDump(b, &block.Block, indent+"  ")
+}
+
+func (n *NodeAbstractResourceInstance) writeNestedObjectDump(b *strings.Builder, obj *configschema.Object, indent string) {
+	if obj == nil {
+		b.WriteString(indent)
+		b.WriteString("<nil-object>\n")
+		return
+	}
+	b.WriteString(indent)
+	b.WriteString("nested ")
+	b.WriteString(n.formatNestingMode(obj.Nesting))
+	b.WriteByte('\n')
+	for _, name := range n.objectAttributeNames(obj) {
+		n.writeOneAttributeDump(b, name, obj.Attributes[name], indent+"  ")
+	}
+}
+
+func (n *NodeAbstractResourceInstance) formatSchemaSummary(schema *configschema.Block) string {
+	return strings.Join([]string{
+		"attrs=" + n.formatInt(n.countSchemaAttributes(schema)),
+		"blocks=" + n.formatInt(n.schemaBlockCount(schema)),
+		"depth=" + n.formatInt(n.schemaMaxDepth(schema)),
+		"computed=" + n.formatBool(n.schemaHasComputedAttributes(schema)),
+		"optional=" + n.formatBool(n.schemaHasOptionalAttributes(schema)),
+		"sensitive=" + n.formatBool(n.blockContainsSensitive(schema)),
+		"paths=" + n.formatInt(len(n.collectSchemaAttributePaths(schema, nil))),
+	}, " ")
+}
