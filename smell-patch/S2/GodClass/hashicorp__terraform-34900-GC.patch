+func (n *NodeAbstractResourceInstance) resourceValueEqualForPlan(a, b cty.Value) bool {
+	if a == cty.NilVal && b == cty.NilVal {
+		return true
+	}
+	if a == cty.NilVal || b == cty.NilVal {
+		return false
+	}
+	au, _ := a.UnmarkDeep()
+	bu, _ := b.UnmarkDeep()
+	return n.unrefinedCtyValue(au).RawEquals(n.unrefinedCtyValue(bu))
+}
