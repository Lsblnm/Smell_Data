+func (n *NodeAbstractResourceInstance) normalizeEncodedResourceValue(val cty.Value, ty cty.Type) cty.Value {
+	if val == cty.NilVal || ty == cty.NilType {
+		return val
+	}
+	unmarked, marks := val.UnmarkDeep()
+	unmarked = cty.UnknownAsNull(unmarked)
+	aligned := n.alignValueToType(unmarked, ty)
+	if len(marks) > 0 {
+		aligned = aligned.WithMarks(marks)
+	}
+	return aligned
+}
