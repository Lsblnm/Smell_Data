+func (n *NodeAbstractResourceInstance) truncateSchemaText(s string, max int) string {
+	s = strings.ReplaceAll(s, "\n", " ")
+	if max <= 0 || len(s) <= max {
+		return s
+	}
+	return s[:max]
+}
