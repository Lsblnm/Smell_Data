+func (n *NodeAbstractResourceInstance) appendIndexPath(path cty.Path, key cty.Value) cty.Path {
+	out := make(cty.Path, len(path)+1)
+	copy(out, path)
+	out[len(path)] = cty.IndexStep{Key: key}
+	return out
+}
