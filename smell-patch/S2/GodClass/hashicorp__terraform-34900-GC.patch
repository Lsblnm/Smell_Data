+func (n *NodeAbstractResourceInstance) objectContainsSensitive(o *configschema.Object) bool {
+	if o == nil {
+		return false
+	}
+	for _, attrS := range o.Attributes {
+		if attrS.Sensitive {
+			return true
+		}
+		if attrS.NestedType != nil && n.objectContainsSensitive(attrS.NestedType) {
+			return true
+		}
+	}
+	return false
+}
