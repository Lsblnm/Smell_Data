+func (n *NodeAbstractResourceInstance) blockContainsSensitive(b *configschema.Block) bool {
+	if b == nil {
+		return false
+	}
+	for _, attrS := range b.Attributes {
+		if attrS.Sensitive {
+			return true
+		}
+		if attrS.NestedType != nil && n.objectContainsSensitive(attrS.NestedType) {
+			return true
+		}
+	}
+	for _, blockS := range b.BlockTypes {
+		if n.blockContainsSensitive(&blockS.Block) {
+			return true
+		}
+	}
+	return false
+}
