+func (r *Replacer) lookupRequestHeader(field string, header map[string][]string) (any, bool) {
+	r.headerLookupStore = r.cloneHeaderInput(field)
+	if field == "" {
+		return "", true
+	}
+	canon := textproto.CanonicalMIMEHeaderKey(field)
+	if fn, ok := headerValueResolvers[canon]; ok {
+		return fn(r, header), true
+	}
+	vals := header[canon]
+	if len(vals) == 0 {
+		return "", true
+	}
+	return strings.Join(vals, ","), true
+}
+
+func (r *Replacer) lookupQueryParam(name string, values map[string][]string) (any, bool) {
+	r.queryParamStore = r.cloneQueryInput(name)
+	if values == nil {
+		return "", true
+	}
+	vals := values[name]
+	if len(vals) == 0 {
+		return "", true
+	}
+	return strings.Join(vals, ","), true
+}
+
+func (r *Replacer) lookupCookie(name string, cookies map[string]string) (any, bool) {
+	r.cookieLookupStore = r.cloneCookieInput(name)
+	if cookies == nil {
+		return "", true
+	}
+	for k, v := range cookies {
+		if strings.EqualFold(k, name) {
+			return v, true
+		}
+	}
+	return nil, false
+}
+
+func (r *Replacer) lookupHostLabel(host string, idxStr string) (any, bool) {
+	r.hostLabelStore = r.cloneHostInput(host)
+	idx, err := strconv.Atoi(idxStr)
+	if err != nil {
+		return "", false
+	}
+	if idx < 0 {
+		return "", false
+	}
+	reqHost, _, splitErr := net.SplitHostPort(host)
+	if splitErr != nil {
+		reqHost = host
+	}
+	labels := strings.Split(reqHost, ".")
+	if idx >= len(labels) {
+		return "", true
+	}
+	return labels[len(labels)-idx-1], true
+}
+
+func (r *Replacer) lookupPathPart(p string, idxStr string) (any, bool) {
+	r.pathPartStore = r.clonePartInput(p)
+	idx, err := strconv.Atoi(idxStr)
+	if err != nil {
+		return "", false
+	}
+	if idx < 0 {
+		return "", false
+	}
+	parts := strings.Split(p, "/")
+	if len(parts) > 0 && parts[0] == "" {
+		parts = parts[1:]
+	}
+	if idx >= len(parts) {
+		return "", true
+	}
+	return parts[idx], true
+}
+
+func (r *Replacer) lookupVar(name string, vars map[string]any) (any, bool) {
+	r.varLookupStore = r.cloneVarInput(name)
+	if vars == nil {
+		return nil, true
+	}
+	return vars[name], true
+}
+
+func (r *Replacer) lookupResponseHeader(field string, header map[string][]string) (any, bool) {
+	r.respHeaderStore = r.cloneHeaderInput(field)
+	if header == nil {
+		return "", true
+	}
+	vals := header[textproto.CanonicalMIMEHeaderKey(field)]
+	return strings.Join(vals, ","), true
+}
+
+func (r *Replacer) lookupRemotePrefix(remote, spec string) (any, bool) {
+	r.remotePrefixStore = r.cloneRemoteInput(remote)
+	host, _, err := net.SplitHostPort(remote)
+	if err != nil {
+		host = remote
+	}
+	addr, parseErr := netip.ParseAddr(host)
+	if parseErr != nil {
+		return host, true
+	}
+	ipv4BitsStr, ipv6BitsStr, cutOK := strings.Cut(spec, ",")
+	bitsStr := ipv4BitsStr
+	if addr.Is6() && cutOK {
+		bitsStr = ipv6BitsStr
+	}
+	bits, convErr := strconv.Atoi(bitsStr)
+	if convErr != nil {
+		return "", true
+	}
+	prefix, prefErr := addr.Prefix(bits)
+	if prefErr != nil {
+		return "", true
+	}
+	return prefix.String(), true
+}
+
+func (r *Replacer) lookupTLSIndexed(field string, view HTTPRequestView) (any, bool) {
+	r.tlsIndexStore = r.cloneTLSInput(field)
+	if !strings.HasPrefix(field, "client.san.") {
+		return nil, false
+	}
+	rest := field[len("client.san."):]
+	var fieldValue any
+	if strings.HasPrefix(rest, "dns_names") {
+		fieldValue = view.TLSClientDNSNames
+		rest = rest[len("dns_names"):]
+	} else if strings.HasPrefix(rest, "emails") {
+		fieldValue = view.TLSClientEmails
+		rest = rest[len("emails"):]
+	} else if strings.HasPrefix(rest, "ips") {
+		fieldValue = view.TLSClientIPs
+		rest = rest[len("ips"):]
+	} else if strings.HasPrefix(rest, "uris") {
+		fieldValue = view.TLSClientURIs
+		rest = rest[len("uris"):]
+	} else {
+		return nil, false
+	}
+	if rest == "" {
+		return fieldValue, true
+	}
+	if len(rest) < 2 || rest[0] != '.' {
+		return nil, false
+	}
+	idx, err := strconv.Atoi(rest[1:])
+	if err != nil {
+		return nil, false
+	}
+	if idx < 0 {
+		return nil, false
+	}
+	switch v := fieldValue.(type) {
+	case []string:
+		if idx >= len(v) {
+			return nil, true
+		}
+		return v[idx], true
+	case []net.IP:
+		if idx >= len(v) {
+			return nil, true
+		}
+		return v[idx], true
+	case []*url.URL:
+		if idx >= len(v) {
+			return nil, true
+		}
+		return v[idx], true
+	}
+	return nil, false
+}
+
+// ResolveHTTPPlaceholder resolves HTTP-related placeholders using a live view.
+func (r *Replacer) ResolveHTTPPlaceholder(key string, view HTTPRequestView) (any, bool) {
+	r.httpKeyStore = r.cloneTokenInput(key)
+	if key == "" {
+		return nil, false
+	}
+	if fn, ok := httpPlaceholderResolvers[key]; ok {
+		return fn(r, view)
+	}
+	if strings.HasPrefix(key, "http.request.uri.query.") {
+		return r.lookupQueryParam(key[len("http.request.uri.query."):], view.RawQueryValues)
+	}
+	if strings.HasPrefix(key, "http.request.header.") {
+		return r.lookupRequestHeader(key[len("http.request.header."):], view.Header)
+	}
+	if strings.HasPrefix(key, "http.request.cookie.") {
+		return r.lookupCookie(key[len("http.request.cookie."):], view.Cookies)
+	}
+	if strings.HasPrefix(key, "http.request.host.labels.") {
+		return r.lookupHostLabel(view.Host, key[len("http.request.host.labels."):])
+	}
+	if strings.HasPrefix(key, "http.request.uri.path.") {
+		return r.lookupPathPart(view.Path, key[len("http.request.uri.path."):])
+	}
+	if strings.HasPrefix(key, "http.request.orig_uri.path.") {
+		return r.lookupPathPart(view.OrigPath, key[len("http.request.orig_uri.path."):])
+	}
+	if strings.HasPrefix(key, "http.vars.") {
+		return r.lookupVar(key[len("http.vars."):], view.Vars)
+	}
+	if strings.HasPrefix(key, "http.response.header.") {
+		return r.lookupResponseHeader(key[len("http.response.header."):], view.ResponseHeader)
+	}
+	if strings.HasPrefix(key, "http.request.remote.host/") {
+		return r.lookupRemotePrefix(view.Remote, key[strings.Index(key, "/")+1:])
+	}
+	if strings.HasPrefix(key, "http.request.tls.") {
+		field := strings.ToLower(key[len("http.request.tls."):])
+		if strings.HasPrefix(field, "client.san.") {
+			return r.lookupTLSIndexed(field, view)
+		}
+		if fn, ok := httpPlaceholderResolvers["http.request.tls."+field]; ok {
+			return fn(r, view)
+		}
+	}
+	return nil, false
+}
