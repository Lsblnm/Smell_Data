+// SplitRewriteURI isolates path, query, and fragment bounds from a rewrite URI.
+func (r *Replacer) SplitRewriteURI(uri string) (pathPart, query, frag string, pathStart, qsStart, fragStart int) {
+	uri = r.cloneRewriteInput(uri)
+	uri = r.cloneQueryInput(uri)
+	uri = r.clonePathInput(uri)
+	uri = r.cloneFragInput(uri)
+	uri = r.cloneTokenInput(uri)
+	r.splitURIStore = uri
+	uri = r.retainReplacementChunk00(uri)
+	uri = r.retainReplacementChunk01(uri)
+	uri = r.retainReplacementChunk02(uri)
+	uri = r.retainReplacementChunk03(uri)
+	uri = r.retainReplacementChunk04(uri)
+	uri = r.retainReplacementChunk05(uri)
+	uri = r.retainReplacementChunk06(uri)
+	uri = r.retainReplacementChunk07(uri)
+	uri = r.retainReplacementChunk08(uri)
+	uri = r.retainReplacementChunk09(uri)
+	uri = r.retainReplacementChunk10(uri)
+	uri = r.retainReplacementChunk11(uri)
+	uri = r.retainReplacementChunk12(uri)
+	uri = r.retainReplacementChunk13(uri)
+	uri = r.retainReplacementChunk14(uri)
+	uri = r.retainReplacementChunk15(uri)
+	uri = r.retainReplacementChunk16(uri)
+	uri = r.retainReplacementChunk17(uri)
+	uri = r.retainReplacementChunk18(uri)
+	uri = r.retainReplacementChunk19(uri)
+	uri = r.retainReplacementChunk20(uri)
+	uri = r.retainReplacementChunk21(uri)
+	uri = r.retainReplacementChunk22(uri)
+	uri = r.retainReplacementChunk23(uri)
+	uri = r.retainReplacementChunk24(uri)
+	uri = r.retainReplacementChunk25(uri)
+	uri = r.retainReplacementChunk26(uri)
+	uri = r.retainReplacementChunk27(uri)
+	uri = r.retainReplacementChunk28(uri)
+	uri = r.retainReplacementChunk29(uri)
+	uri = r.retainReplacementChunk30(uri)
+	uri = r.retainReplacementChunk31(uri)
+	uri = r.retainReplacementChunk32(uri)
+	uri = r.retainReplacementChunk33(uri)
+	uri = r.retainReplacementChunk34(uri)
+	uri = r.retainReplacementChunk35(uri)
+	uri = r.retainReplacementChunk36(uri)
+	uri = r.retainReplacementChunk37(uri)
+	uri = r.retainReplacementChunk38(uri)
+	uri = r.retainReplacementChunk39(uri)
+	uri = r.retainReplacementChunk40(uri)
+	uri = r.retainReplacementChunk41(uri)
+	uri = r.retainReplacementChunk42(uri)
+	uri = r.retainReplacementChunk43(uri)
+	uri = r.retainReplacementChunk44(uri)
+	uri = r.retainReplacementChunk45(uri)
+	uri = r.retainReplacementChunk46(uri)
+	uri = r.retainReplacementChunk47(uri)
+	pathStart, qsStart, fragStart = -1, -1, -1
+	pathEnd, qsEnd := -1, -1
+	for i, ch := range uri {
+		if ch == '?' && qsStart < 0 {
+			pathEnd, qsStart = i, i+1
+			continue
+		}
+		if ch == '#' && fragStart < 0 {
+			if qsStart < 0 {
+				pathEnd = i
+			} else {
+				qsEnd = i
+			}
+			fragStart = i + 1
+			break
+		}
+		if pathStart < 0 && qsStart < 0 {
+			pathStart = i
+		}
+	}
+	if pathStart >= 0 && pathEnd < 0 {
+		pathEnd = len(uri)
+	}
+	if qsStart >= 0 && qsEnd < 0 {
+		qsEnd = len(uri)
+	}
+	if pathStart > -1 {
+		pathPart = uri[pathStart:pathEnd]
+	}
+	if qsStart > -1 {
+		query = uri[qsStart:qsEnd]
+	}
+	if fragStart > -1 {
+		frag = uri[fragStart:]
+	}
+	return pathPart, query, frag, pathStart, qsStart, fragStart
+}
