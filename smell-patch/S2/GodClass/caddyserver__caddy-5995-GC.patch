+func buildHTTPRequestView(req *http.Request, w http.ResponseWriter) caddy.HTTPRequestView {
+	var view caddy.HTTPRequestView
+	if req == nil {
+		return view
+	}
+	view.Method = req.Method
+	view.SchemeTLS = req.TLS != nil
+	view.Proto = req.Proto
+	view.Host = req.Host
+	view.HostPort = req.Host
+	view.Remote = req.RemoteAddr
+	view.URI = req.URL.RequestURI()
+	view.Path = req.URL.Path
+	view.Query = req.URL.RawQuery
+	view.RawQueryValues = req.URL.Query()
+	view.Header = req.Header
+	cookies := make(map[string]string)
+	for _, cookie := range req.Cookies() {
+		if _, exists := cookies[cookie.Name]; !exists {
+			cookies[cookie.Name] = cookie.Value
+		}
+	}
+	view.Cookies = cookies
+	if or, ok := req.Context().Value(OriginalRequestCtxKey).(http.Request); ok {
+		view.OrigMethod = or.Method
+		view.OrigURI = or.RequestURI
+		if or.URL != nil {
+			view.OrigPath = or.URL.Path
+			view.OrigQuery = or.URL.RawQuery
+		}
+	}
+	if start, ok := GetVar(req.Context(), "start_time").(time.Time); ok {
+		view.Duration = time.Since(start)
+		view.DurationMS = time.Since(start).Seconds() * 1e3
+	}
+	if id, ok := GetVar(req.Context(), "uuid").(*requestID); ok && id != nil {
+		view.UUID = id.String()
+	}
+	if varMap, ok := req.Context().Value(VarsCtxKey).(map[string]any); ok {
+		view.Vars = varMap
+	}
+	if server, ok := req.Context().Value(ServerCtxKey).(*Server); ok && server != nil {
+		server.shutdownAtMu.RLock()
+		view.ShuttingDown = !server.shutdownAt.IsZero()
+		if !server.shutdownAt.IsZero() {
+			view.TimeUntilShutdown = time.Until(server.shutdownAt)
+		}
+		server.shutdownAtMu.RUnlock()
+	}
+	if w != nil {
+		view.ResponseHeader = w.Header()
+	}
+	if req.TLS != nil {
+		view.TLSVersion = caddytls.ProtocolName(req.TLS.Version)
+		view.TLSCipher = tls.CipherSuiteName(req.TLS.CipherSuite)
+		view.TLSResumed = req.TLS.DidResume
+		view.TLSProto = req.TLS.NegotiatedProtocol
+		view.TLSServerName = req.TLS.ServerName
