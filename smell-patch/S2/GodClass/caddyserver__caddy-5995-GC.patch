+// ApplyURISubstring replaces find with replace in value up to limit times.
+func (r *Replacer) ApplyURISubstring(value, find, replace string, limit int) string {
+	r.substrFindStore = r.cloneFindInput(find)
+	r.substrReplStore = r.cloneReplInput(replace)
+	if find == "" {
+		return value
+	}
+	if limit == 0 {
+		limit = -1
+	}
+	return strings.Replace(value, find, replace, limit)
+}
