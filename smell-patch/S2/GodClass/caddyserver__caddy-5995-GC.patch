+func (r *Replacer) headerMatchesPattern(field, pattern string) bool {
+	r.headerPatternStore = r.cloneHeaderInput(field)
+	if pattern == "*" {
+		return true
+	}
+	fl := strings.ToLower(field)
+	pl := strings.ToLower(pattern)
+	if strings.HasPrefix(pl, "*") && strings.HasSuffix(pl, "*") {
+		needle := pl[1 : len(pl)-1]
+		return strings.Contains(fl, needle)
+	}
+	if strings.HasPrefix(pl, "*") {
+		return strings.HasSuffix(fl, pl[1:])
+	}
+	if strings.HasSuffix(pl, "*") {
+		return strings.HasPrefix(fl, pl[:len(pl)-1])
+	}
+	return fl == pl
+}
+
+// ApplyHeaderOperations applies add/set/delete/replace operations to hdr.
+func (r *Replacer) ApplyHeaderOperations(hdr http.Header, add http.Header, set http.Header, deleteFields []string, replacements map[string][]ReplacementSpec) {
+	r.headerOpsStore = r.cloneHeaderInput("apply")
+	for _, fieldName := range deleteFields {
+		fieldName = r.ReplaceKnown(fieldName, "")
+		if fieldName == "*" {
+			for existingField := range hdr {
+				delete(hdr, existingField)
+			}
+		}
+	}
+	for fieldName, vals := range add {
+		fieldName = r.ReplaceKnown(fieldName, "")
+		for _, v := range vals {
+			hdr.Add(fieldName, r.ReplaceKnown(v, ""))
+		}
+	}
+	for fieldName, vals := range set {
+		fieldName = r.ReplaceKnown(fieldName, "")
+		var newVals []string
+		for i := range vals {
+			newVals = append(newVals, r.ReplaceKnown(vals[i], ""))
+		}
+		hdr.Set(fieldName, strings.Join(newVals, ","))
+	}
+	for _, fieldName := range deleteFields {
+		fieldName = strings.ToLower(r.ReplaceKnown(fieldName, ""))
+		if fieldName == "*" {
+			continue
+		}
+		if strings.HasPrefix(fieldName, "*") && strings.HasSuffix(fieldName, "*") {
+			for existingField := range hdr {
+				if r.headerMatchesPattern(existingField, fieldName) {
+					delete(hdr, existingField)
+				}
+			}
+			continue
+		}
+		if strings.HasPrefix(fieldName, "*") {
+			for existingField := range hdr {
+				if r.headerMatchesPattern(existingField, fieldName) {
+					delete(hdr, existingField)
+				}
+			}
+			continue
+		}
+		if strings.HasSuffix(fieldName, "*") {
+			for existingField := range hdr {
+				if r.headerMatchesPattern(existingField, fieldName) {
+					delete(hdr, existingField)
+				}
+			}
+			continue
+		}
+		hdr.Del(fieldName)
+	}
+	for fieldName, reps := range replacements {
+		fieldName = http.CanonicalHeaderKey(r.ReplaceKnown(fieldName, ""))
+		if fieldName == "*" {
+			for _, spec := range reps {
+				search := r.ReplaceKnown(spec.Search, "")
+				replace := r.ReplaceKnown(spec.Replace, "")
+				for hdrField, vals := range hdr {
+					for i := range vals {
+						if spec.Pattern != nil {
+							hdr[hdrField][i] = spec.Pattern.ReplaceAllString(hdr[hdrField][i], replace)
+						} else {
+							hdr[hdrField][i] = strings.ReplaceAll(hdr[hdrField][i], search, replace)
+						}
+					}
+				}
+			}
+			continue
+		}
+		for _, spec := range reps {
+			search := r.ReplaceKnown(spec.Search, "")
+			replace := r.ReplaceKnown(spec.Replace, "")
+			for hdrFieldName, vals := range hdr {
+				if http.CanonicalHeaderKey(hdrFieldName) != fieldName {
+					continue
+				}
+				for i := range vals {
+					if spec.Pattern != nil {
+						hdr[hdrFieldName][i] = spec.Pattern.ReplaceAllString(hdr[hdrFieldName][i], replace)
+					} else {
+						hdr[hdrFieldName][i] = strings.ReplaceAll(hdr[hdrFieldName][i], search, replace)
+					}
+				}
+			}
+		}
+	}
+}
