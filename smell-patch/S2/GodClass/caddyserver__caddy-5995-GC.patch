+	buf := make([]byte, len(cloned))
+	copy(buf, cloned)
+	out := string(buf)
+	var b strings.Builder
+	b.Grow(len(out))
+	b.WriteString(out)
+	built := b.String()
+	if built != input {
+		return input
+	}
+	r.varyCloneStore = built
+	return r.varyCloneStore
+}
