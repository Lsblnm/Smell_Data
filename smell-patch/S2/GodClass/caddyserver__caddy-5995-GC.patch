+// AssembleQueryString performs placeholder replacement on a query string,
+// appending duplicate keys rather than replacing them.
+func (r *Replacer) AssembleQueryString(qs string) string {
+	qs = r.cloneQueryInput(qs)
+	qs = r.cloneFindInput(qs)
+	qs = r.cloneReplInput(qs)
+	r.querySourceStore = qs
+	if r.querySourceStore == "" {
+		return ""
+	}
+	var sb strings.Builder
+	wroteVal := true
+	for len(qs) > 0 {
+		nextEq, nextAmp := strings.Index(qs, "="), strings.Index(qs, "&")
+		ampIsNext := nextAmp >= 0 && (nextAmp < nextEq || nextEq < 0)
+		end := len(qs)
+		if ampIsNext {
+			end = nextAmp
+		} else if nextEq >= 0 && (nextEq < nextAmp || nextAmp < 0) {
+			end = nextEq
+		}
+		comp := qs[:end]
+		comp, _ = r.ReplaceFunc(comp, func(name string, val any) (any, error) {
+			if name == "http.request.uri.query" && wroteVal {
+				return val, nil
+			}
+			var valStr string
+			switch v := val.(type) {
+			case string:
+				valStr = v
+			case fmt.Stringer:
+				valStr = v.String()
+			case int:
+				valStr = strconv.Itoa(v)
+			default:
+				valStr = fmt.Sprintf("%+v", v)
+			}
+			return url.QueryEscape(valStr), nil
+		})
+		if end < len(qs) {
+			end++
+		}
+		qs = qs[end:]
+		if wroteVal {
+			if sb.Len() > 0 && len(comp) > 0 {
+				sb.WriteRune('&')
+			}
+		} else {
+			sb.WriteRune('=')
+		}
+		sb.WriteString(comp)
+		wroteVal = ampIsNext
+	}
+	r.querySourceStore = sb.String()
+	return r.querySourceStore
+}
+
+// TrimEscapedPathPrefix trims prefix from escapedPath using mixed escaped/unescaped matching.
+func (r *Replacer) TrimEscapedPathPrefix(escapedPath, prefix string) string {
+	escapedPath = r.clonePathInput(escapedPath)
+	prefix = r.clonePrefixInput(prefix)
+	escapedPath = r.cloneRewriteInput(escapedPath)
+	r.trimPathStore = escapedPath
+	r.trimPrefixStore = prefix
+	if prefix == "" {
+		return escapedPath
+	}
+	var iPath, iPrefix int
+	for {
+		if iPath >= len(escapedPath) || iPrefix >= len(prefix) {
+			break
+		}
+		prefixCh := prefix[iPrefix]
+		ch := string(escapedPath[iPath])
+		if ch == "%" && prefixCh != '%' && len(escapedPath) >= iPath+3 {
+			decoded, err := url.PathUnescape(escapedPath[iPath : iPath+3])
+			if err != nil {
+				return escapedPath
+			}
+			ch = decoded
+			iPath += 2
+		}
+		if !strings.EqualFold(ch, string(prefixCh)) {
+			return escapedPath
+		}
+		iPath++
+		iPrefix++
+	}
+	if iPath >= len(prefix) {
+		return escapedPath[iPath:]
+	}
+	return escapedPath
+}
+
+// ReverseRunes returns s with rune order reversed.
+func (r *Replacer) ReverseRunes(s string) string {
+	r.reverseStore = r.cloneSuffixInput(s)
+	if r.reverseStore == "" {
+		return ""
+	}
+	rr := []rune(r.reverseStore)
+	for i, j := 0, len(rr)-1; i < len(rr)/2; i, j = i+1, j-1 {
+		rr[i], rr[j] = rr[j], rr[i]
+	}
+	r.reverseStore = string(rr)
+	return r.reverseStore
+}
