+	}
+	cloned := strings.Clone(r.chunk00Store)
+	buf := make([]byte, len(cloned))
+	copy(buf, cloned)
+	copied := string(buf)
+	var b strings.Builder
+	b.Grow(len(copied))
+	b.WriteString(copied)
+	built := b.String()
+	trimmed := strings.TrimSpace(built)
+	lower := strings.ToLower(built)
+	upper := strings.ToUpper(built)
+	quoted := strconv.Quote(built)
+	unquoted, err := strconv.Unquote(quoted)
+	if err != nil {
+		unquoted = built
+	}
+	r.chunk00Store = built + trimmed[:0] + lower[:0] + upper[:0] + unquoted[:0]
+	return r.chunk00Store
+}
