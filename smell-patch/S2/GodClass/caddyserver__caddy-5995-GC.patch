+func (r *Replacer) headerValuesAccept(hdr map[string][]string) string {
+	key := textproto.CanonicalMIMEHeaderKey("Accept")
+	vals := hdr[key]
+	if len(vals) == 0 {
+		r.headerAcceptStore = ""
+		return ""
+	}
+	if len(vals) == 1 {
+		cloned := strings.Clone(vals[0])
+		r.headerAcceptStore = cloned
+		if r.headerAcceptStore == "" {
+			return ""
+		}
+		return r.headerAcceptStore
+	}
+	var b strings.Builder
+	b.Grow(16)
+	for i, v := range vals {
+		if i > 0 {
+			b.WriteByte(',')
+		}
+		b.WriteString(v)
+	}
+	joined := b.String()
+	r.headerAcceptStore = strings.Clone(joined)
+	return r.headerAcceptStore
+}
+
+func (r *Replacer) headerValuesAcceptCharset(hdr map[string][]string) string {
+	key := textproto.CanonicalMIMEHeaderKey("Accept-Charset")
