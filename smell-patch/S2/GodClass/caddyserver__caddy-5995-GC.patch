+// InterpolateLogLevel expands placeholders in a log level string and lowercases it.
+func (r *Replacer) InterpolateLogLevel(levelInput string) (string, error) {
+	levelInput = r.cloneLevelInput(levelInput)
+	levelInput = r.clonePatternInput(levelInput)
+	r.logInputStore = levelInput
+	level, err := r.ReplaceOrErr(levelInput, true, true)
+	if err != nil {
+		return "", err
+	}
+	level = strings.ToLower(level)
+	r.logInputStore = r.cloneLevelInput(level)
+	return level, nil
+}
+
+// ExpandMatcherPattern expands placeholders in a matcher pattern.
+func (r *Replacer) ExpandMatcherPattern(pattern string) string {
+	r.matcherPatternStore = r.clonePatternInput(pattern)
+	if r.matcherPatternStore == "" {
+		return ""
+	}
+	out := r.ReplaceAll(r.matcherPatternStore, "")
+	r.matcherPatternStore = out
+	return out
+}
