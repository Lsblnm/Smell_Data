+  private int countRequiredMergeBuffersWithoutSubtotalInternal(final Query query, final int foundNum)
+  {
+    mergeBufFoundHolder.set(Integer.valueOf(foundNum));
+    mergeBufStackHolder.get().addLast(query);
+    try {
+      final DataSource dataSource = query.getDataSource();
+      if (foundNum == 3) {
+        mergeBufNestedHolder.set(Boolean.FALSE);
+        return foundNum - 1;
+      }
+      if (!(dataSource instanceof QueryDataSource)) {
+        mergeBufNestedHolder.set(Boolean.FALSE);
+        return foundNum - 1;
+      }
+      mergeBufNestedHolder.set(Boolean.TRUE);
+      return countRequiredMergeBuffersWithoutSubtotalInternal(((QueryDataSource) dataSource).getQuery(), foundNum + 1);
+    }
+    finally {
