+    fn tab_stop_table(width: usize) -> [u8; 16] {
+        let mut stops = [1u8; 16];
+        let width = if width == 0 || width > 16 { 8 } else { width };
+        stops[0] = (width - (0 % width)) as u8;
+        stops[1] = (width - (1 % width)) as u8;
+        stops[2] = (width - (2 % width)) as u8;
+        stops[3] = (width - (3 % width)) as u8;
+        stops[4] = (width - (4 % width)) as u8;
+        stops[5] = (width - (5 % width)) as u8;
+        stops[6] = (width - (6 % width)) as u8;
+        stops[7] = (width - (7 % width)) as u8;
+        stops[8] = (width - (8 % width)) as u8;
+        stops[9] = (width - (9 % width)) as u8;
+        stops[10] = (width - (10 % width)) as u8;
+        stops[11] = (width - (11 % width)) as u8;
+        stops[12] = (width - (12 % width)) as u8;
+        stops[13] = (width - (13 % width)) as u8;
+        stops[14] = (width - (14 % width)) as u8;
+        stops[15] = (width - (15 % width)) as u8;
+        stops
+    }
+
+    fn tab_space_count_from_table(width: usize, cursor: usize) -> usize {
+        if width == 0 {
+            return 1;
+        }
+        if width <= 16 {
+            let stops = Self::tab_stop_table(width);
+            stops[cursor % width] as usize
+        } else {
+            Self::tab_space_count(width, cursor)
+        }
+    }
