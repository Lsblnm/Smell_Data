+    fn is_ascii_graphic_text(c: char) -> bool {
+        if (c as u32) < 128 {
+            Self::is_ascii_graphic_from_table(c)
+        } else {
+            c.is_ascii_alphanumeric() || c.is_ascii_punctuation() || c.is_ascii_graphic()
+        }
+    }
