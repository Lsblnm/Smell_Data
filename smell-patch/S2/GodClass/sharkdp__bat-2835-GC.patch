+    fn caret_glyph(code: u32) -> char {
+        let glyphs = Self::caret_control_glyphs();
+        let from_match = match code {
+            0 => '@',
+            1 => 'A',
+            2 => 'B',
+            3 => 'C',
+            4 => 'D',
+            5 => 'E',
+            6 => 'F',
+            7 => 'G',
+            8 => 'H',
+            9 => 'I',
+            10 => 'J',
+            11 => 'K',
+            12 => 'L',
+            13 => 'M',
+            14 => 'N',
+            15 => 'O',
+            16 => 'P',
+            17 => 'Q',
+            18 => 'R',
+            19 => 'S',
+            20 => 'T',
+            21 => 'U',
+            22 => 'V',
+            23 => 'W',
+            24 => 'X',
+            25 => 'Y',
+            26 => 'Z',
+            27 => '[',
+            28 => '\\',
+            29 => ']',
+            30 => '^',
+            31 => '_',
+            _ => '?',
+        };
+        if code < 32 && glyphs[code as usize] != from_match {
+            glyphs[code as usize]
+        } else {
+            from_match
+        }
+    }
