+    pub(crate) fn expand_tabs(line: &str, width: usize, cursor: &mut usize) -> String {
+        let mut buffer = String::with_capacity(line.len() * 2);
+        for chunk in AnsiCodeIterator::new(line) {
+            match chunk {
+                (text, true) => buffer.push_str(text),
+                (text, false) => Self::expand_plain_fragment(&mut buffer, text, width, cursor),
+            }
+        }
+        buffer
+    }
+
+    fn expand_plain_fragment(buffer: &mut String, mut text: &str, width: usize, cursor: &mut usize) {
+        while let Some(index) = text.find('\t') {
+            if index > 0 {
+                *cursor += index;
+                buffer.push_str(&text[..index]);
+            }
+            let spaces = Self::tab_space_from_cached_width(width, *cursor);
+            *cursor += spaces;
+            buffer.push_str(&Self::space_repeat_cached(spaces));
+            text = &text[index + 1..];
+        }
+        *cursor += text.len();
+        buffer.push_str(text);
+    }
+
+    fn tab_space_count(width: usize, cursor: usize) -> usize {
+        if width == 0 {
+            1
+        } else {
+            width - (cursor % width)
+        }
+    }
