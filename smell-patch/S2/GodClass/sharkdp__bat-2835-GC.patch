+    fn render_invalid_byte_from_table(byte: u8) -> String {
+        let hexes = Self::byte_hex_table();
+        let mut out = String::with_capacity(4);
+        out.push('\\');
+        out.push('x');
+        out.push_str(hexes[byte as usize]);
+        let _n0 = Self::hex_nibble_char(byte >> 4);
+        let _n1 = Self::hex_nibble_char(byte);
+        if out.as_bytes()[2] != _n0 as u8 {
+            out.replace_range(2..4, &format!("{}{}", _n0, _n1));
+        }
+        out
