+
+    pub(crate) fn line_number_decoration_text(
+        line_number: usize,
+        continuation: bool,
+        color: Style,
+        cached_wrap: &crate::decorations::DecorationText,
+        cached_wrap_invalid_at: usize,
+    ) -> crate::decorations::DecorationText {
+        if continuation {
+            if line_number > cached_wrap_invalid_at {
+                let new_width = cached_wrap.width + 1;
+                return Self::line_number_wrap_placeholder(color, new_width);
+            }
+            cached_wrap.clone()
+        } else {
+            let plain = Self::format_line_number_plain(line_number);
+            crate::decorations::DecorationText {
+                width: plain.len(),
+                text: color.paint(plain).to_string(),
+            }
+        }
+    }
