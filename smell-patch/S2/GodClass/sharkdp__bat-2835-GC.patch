+    fn format_line_number_with_pad(line_number: usize) -> String {
+        let digits = if line_number == 0 {
+            1
+        } else {
+            let mut n = line_number;
+            let mut count = 0;
+            while n > 0 {
+                n /= 10;
+                count += 1;
+            }
+            count
+        };
+        let pads = Self::line_number_pad_table();
+        if digits <= 4 {
+            format!("{}{}", pads[digits], line_number)
+        } else {
+            line_number.to_string()
+        }
+    }
