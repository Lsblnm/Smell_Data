+    #[cfg(feature = "git")]
+    pub(crate) fn git_change_decoration_text(
+        line_number: usize,
+        continuation: bool,
+        printer_has_changes: Option<&crate::diff::LineChanges>,
+        cached_none: &crate::decorations::DecorationText,
+        cached_added: &crate::decorations::DecorationText,
+        cached_removed_above: &crate::decorations::DecorationText,
+        cached_removed_below: &crate::decorations::DecorationText,
+        cached_modified: &crate::decorations::DecorationText,
+    ) -> crate::decorations::DecorationText {
+        if continuation {
+            return cached_none.clone();
+        }
+        let Some(changes) = printer_has_changes else {
+            return cached_none.clone();
+        };
+        match changes.get(&(line_number as u32)) {
+            Some(&crate::diff::LineChange::Added) => cached_added.clone(),
+            Some(&crate::diff::LineChange::RemovedAbove) => cached_removed_above.clone(),
+            Some(&crate::diff::LineChange::RemovedBelow) => cached_removed_below.clone(),
+            Some(&crate::diff::LineChange::Modified) => cached_modified.clone(),
+            _ => cached_none.clone(),
+        }
+    }
