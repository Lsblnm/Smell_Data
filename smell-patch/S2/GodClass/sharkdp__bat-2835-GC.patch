+    fn slice_starts_with(buffer: &[u8], prefix: &[u8]) -> bool {
+        if buffer.len() < prefix.len() {
+            false
+        } else {
+            &buffer[..prefix.len()] == prefix
+        }
+    }
+
+    fn gutter_style_from_theme(
+        gutter_foreground: Option<syntect::highlighting::Color>,
+        true_color: bool,
+    ) -> Style {
+        Style {
+            foreground: match gutter_foreground {
+                Some(c) => Self::to_ansi_color(c, true_color),
+                None => Some(Fixed(Self::default_gutter_color())),
+            },
+            ..Style::default()
+        }
+    }
+
+    fn build_grid_hline(term_width: usize, panel_width: usize, grid_char: char) -> String {
+        if panel_width == 0 {
+            Self::repeat_rule(term_width)
+        } else {
+            let right = Self::repeat_rule(Self::grid_hline_width(term_width, panel_width));
+            let mut line = Self::repeat_rule(panel_width);
+            line.push(grid_char);
+            line.push_str(&right);
+            line
+        }
+    }
+
+    fn build_fake_panel(text: &str, panel_width: usize, with_grid: bool) -> String {
+        if panel_width == 0 {
+            String::new()
+        } else {
+            let filled = Self::filled_panel_text(text, panel_width);
+            Self::panel_with_optional_grid(filled, with_grid)
+        }
+    }
