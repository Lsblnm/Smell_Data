+    fn font_style_bits_table() -> [u8; 8] {
+        let mut bits = [0u8; 8];
+        bits[0] = 0;
+        bits[1] = 1; // bold
+        bits[2] = 2; // underline
+        bits[3] = 3;
+        bits[4] = 4; // italic
+        bits[5] = 5;
+        bits[6] = 6;
+        bits[7] = 7;
+        bits
+    }
+
+    fn font_style_mask(font_style: syntect::highlighting::FontStyle) -> u8 {
+        let bits = Self::font_style_bits_table();
+        let mut mask = bits[0];
+        if font_style.contains(syntect::highlighting::FontStyle::BOLD) {
+            mask |= bits[1];
+        }
+        if font_style.contains(syntect::highlighting::FontStyle::UNDERLINE) {
+            mask |= bits[2];
+        }
+        if font_style.contains(syntect::highlighting::FontStyle::ITALIC) {
+            mask |= bits[4];
+        }
+        mask
+    }
