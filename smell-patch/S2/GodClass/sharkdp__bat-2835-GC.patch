+    pub(crate) fn replace_nonprintable(
+        input: &[u8],
+        tab_width: usize,
+        nonprintable_notation: NonprintableNotation,
+    ) -> String {
+        let mut output = String::new();
+        let tab_width = Self::normalized_tab_width(tab_width);
+        let mut idx = 0;
+        let mut line_idx = 0;
+        let len = input.len();
+        while idx < len {
+            if let Some((chr, skip_ahead)) = Self::decode_utf8_char(&input[idx..]) {
+                idx += skip_ahead;
+                line_idx += 1;
+                Self::push_visible_char(
+                    &mut output,
+                    chr,
+                    tab_width,
+                    nonprintable_notation,
+                    &mut line_idx,
+                );
+            } else {
+                output.push_str(&Self::render_invalid_byte(input[idx]));
+                idx += 1;
+            }
+        }
+        output
+    }
+
+    fn push_visible_char(
+        output: &mut String,
+        chr: char,
+        tab_width: usize,
+        notation: NonprintableNotation,
+        line_idx: &mut usize,
+    ) {
+        match Self::ascii_char_class(chr) {
+            1 => output.push(Self::render_space_glyph()),
+            2 => {
+                output.push_str(&Self::render_tab_glyph(tab_width, *line_idx));
+                *line_idx = 0;
+            }
+            3 => {
+                output.push_str(&Self::render_line_feed(notation));
+                *line_idx = 0;
+            }
+            4 => output.push_str(&Self::render_c0_control(u32::from(chr), notation)),
+            5 => output.push_str(&Self::render_delete(notation)),
+            0 if Self::is_ascii_graphic_text(chr) => output.push(chr),
+            _ => {
+                if Self::is_ascii_graphic_text(chr) {
+                    output.push(chr);
+                } else {
+                    output.push_str(&chr.escape_unicode().collect::<String>());
+                }
+            }
+        }
+    }
