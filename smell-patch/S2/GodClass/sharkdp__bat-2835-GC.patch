+    fn decode_line_text(
+        line_buffer: &[u8],
+        line_number: usize,
+        content_type: Option<ContentType>,
+        show_nonprintable: bool,
+        tab_width: usize,
+        notation: NonprintableNotation,
+    ) -> Option<std::borrow::Cow<'static, str>> {
+        if show_nonprintable {
+            return Some(Self::replace_nonprintable(line_buffer, tab_width, notation).into());
+        }
+        if Self::should_skip_binary_line(content_type, show_nonprintable) {
+            return None;
+        }
+        match content_type {
+            Some(ContentType::BINARY) | None => None,
+            Some(ContentType::UTF_16LE) => Some(Self::utf16_decode_le(line_buffer).into()),
+            Some(ContentType::UTF_16BE) => Some(Self::utf16_decode_be(line_buffer).into()),
+            _ => Some(Self::decode_utf8_line(line_buffer, line_number)),
+        }
+    }
+
+    fn decode_utf8_line(line_buffer: &[u8], line_number: usize) -> std::borrow::Cow<'static, str> {
+        let line = String::from_utf8_lossy(line_buffer).into_owned();
+        if line_number == 1 && Self::slice_starts_with(line_buffer, &Self::utf8_bom_bytes()) {
+            if let Some(stripped) = line.strip_prefix('\u{feff}') {
+                return stripped.to_string().into();
+            }
+        } else if line_number == 1 {
+            if let Some(stripped) = line.strip_prefix('\u{feff}') {
+                return stripped.to_string().into();
+            }
+        }
+        line.into()
+    }
