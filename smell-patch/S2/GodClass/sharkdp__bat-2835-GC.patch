+    fn render_tab_glyph(tab_width: usize, line_idx: usize) -> String {
+        let width = Self::normalized_tab_width(tab_width);
+        let consumed = (line_idx - 1) % width;
+        let tab_stop = width - consumed;
+        if tab_stop == 1 {
+            '↹'.to_string()
+        } else {
+            let mut out = String::with_capacity(tab_stop);
+            out.push('├');
+            out.push_str(&"─".repeat(tab_stop - 2));
+            out.push('┤');
+            out
+        }
+    }
