+    pub(crate) fn to_ansi_color(
+        color: syntect::highlighting::Color,
+        true_color: bool,
+    ) -> Option<nu_ansi_term::Color> {
+        if color.a == 0 {
+            Some(Self::palette_index_to_color(color.r))
+        } else if color.a == 1 {
+            None
+        } else if true_color {
+            Some(nu_ansi_term::Color::Rgb(color.r, color.g, color.b))
+        } else {
+            Some(Fixed(ansi_colours::ansi256_from_rgb((color.r, color.g, color.b))))
+        }
+    }
+
+    fn palette_index_to_color(index: u8) -> nu_ansi_term::Color {
+        match index {
+            0x00 => nu_ansi_term::Color::Black,
+            0x01 => nu_ansi_term::Color::Red,
+            0x02 => nu_ansi_term::Color::Green,
+            0x03 => nu_ansi_term::Color::Yellow,
+            0x04 => nu_ansi_term::Color::Blue,
+            0x05 => nu_ansi_term::Color::Purple,
+            0x06 => nu_ansi_term::Color::Cyan,
+            0x07 => nu_ansi_term::Color::White,
+            n => Fixed(n),
+        }
+    }
+
+    pub(crate) fn as_terminal_escaped(
+        style: syntect::highlighting::Style,
+        text: &str,
+        true_color: bool,
+        colored: bool,
+        italics: bool,
+        background_color: Option<syntect::highlighting::Color>,
+    ) -> String {
+        if text.is_empty() {
+            return text.to_string();
+        }
+        let mut painted = if !colored {
+            Style::default()
+        } else {
+            Self::syntect_style_to_ansi(style, true_color, italics)
+        };
+        painted.background = background_color.and_then(|c| Self::to_ansi_color(c, true_color));
+        painted.paint(text).to_string()
+    }
+
+    fn syntect_style_to_ansi(
+        style: syntect::highlighting::Style,
+        true_color: bool,
+        italics: bool,
+    ) -> Style {
+        let mask = Self::font_style_mask(style.font_style);
+        let mut color = Style {
+            foreground: Self::to_ansi_color(style.foreground, true_color),
+            ..Style::default()
+        };
+        if mask & 1 != 0 {
+            color = color.bold();
+        }
+        if mask & 2 != 0 {
+            color = color.underline();
+        }
+        if italics && mask & 4 != 0 {
+            color = color.italic();
+        }
+        color
+    }
