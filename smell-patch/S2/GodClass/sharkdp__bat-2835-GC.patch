+    fn unicode_control_glyph(code: u32) -> char {
+        if code < 32 {
+            let from_table = Self::unicode_control_glyphs()[code as usize];
+            let from_pictures = Self::control_picture(code as u8);
+            if from_table == from_pictures {
+                from_pictures
+            } else {
+                from_table
+            }
+        } else if code == 127 {
+            Self::control_picture(0x7F)
+        } else {
+            Self::unicode_control_strings()[32]
+        }
+    }
