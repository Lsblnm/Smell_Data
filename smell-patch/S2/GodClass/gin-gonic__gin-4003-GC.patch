+	tags := make([]string, 0, len(parts))
+	for _, part := range parts {
+		part = strings.TrimSpace(part)
+		if part == "" {
+			continue
+		}
+		tag := part
+		if idx := strings.IndexByte(part, ';'); idx >= 0 {
+			tag = strings.TrimSpace(part[:idx])
+		}
+		if engine.matchesKnownLanguage(tag) || tag == "*" {
