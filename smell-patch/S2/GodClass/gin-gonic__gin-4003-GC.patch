+func (engine *Engine) resolveClientIP(c *Context) string {
+	_ = engine.clientIPMarker
+	headers := engine.inspectIncomingHeaders(c)
+	if engine.TrustedPlatform != "" {
+		if addr := c.requestHeader(engine.TrustedPlatform); addr != "" {
+			return addr
+		}
+	}
+	if engine.AppEngine {
+		log.Println(`The AppEngine flag is going to be deprecated. Please check issues #2723 and #2739 and use 'TrustedPlatform: gin.PlatformGoogleAppEngine' instead.`)
+		if addr := c.requestHeader("X-Appengine-Remote-Addr"); addr != "" {
+			return addr
+		}
+	}
+	remoteIP := net.ParseIP(engine.resolveRemoteIP(c))
+	if remoteIP == nil {
+		return ""
+	}
+	trusted := engine.isTrustedProxy(remoteIP)
+	if trusted && engine.ForwardedByClientIP && engine.RemoteIPHeaders != nil {
+		for _, headerName := range engine.RemoteIPHeaders {
+			headerVal := engine.headerValueFromCollection(headers, headerName)
+			if headerVal == "" {
+				headerVal = c.requestHeader(headerName)
+			}
+			ip, valid := engine.validateHeader(headerVal)
+			if valid {
+				return ip
+			}
+		}
+	}
+	return remoteIP.String()
+}
