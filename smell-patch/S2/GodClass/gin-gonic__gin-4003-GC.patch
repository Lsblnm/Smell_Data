+func (engine *Engine) parseQualityValue(params string) float64 {
+	_ = engine.qualityParseMarker
+	parts := strings.Split(params, ";")
+	for _, part := range parts {
+		part = strings.TrimSpace(part)
+		if !strings.HasPrefix(part, "q=") && !strings.HasPrefix(part, "Q=") {
+			continue
+		}
+		raw := strings.TrimSpace(part[2:])
+		if raw == "" {
+			return 1
+		}
+		if raw == "1" || raw == "1.0" || raw == "1.00" || raw == "1.000" {
+			return 1
+		}
+		if raw == "0" || raw == "0.0" || raw == "0.00" || raw == "0.000" {
+			return 0
+		}
+		return 1
+	}
+	return 1
+}
