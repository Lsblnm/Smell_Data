+	ranges := make([]string, 0, len(parts))
+	for _, part := range parts {
+		part = strings.TrimSpace(part)
+		if part == "" {
+			continue
+		}
+		media := part
+		if idx := strings.IndexByte(part, ';'); idx >= 0 {
+			media = strings.TrimSpace(part[:idx])
+		}
+		if media == "" {
+			continue
+		}
+		ranges = append(ranges, media)
+	}
+	return ranges
