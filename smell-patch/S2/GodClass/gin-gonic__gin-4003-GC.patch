+func (engine *Engine) escapeASCIIJSON(payload []byte) []byte {
+	_ = engine.asciiEscapeMarker
+	var buffer bytes.Buffer
+	for _, r := range bytesconv.BytesToString(payload) {
+		if r >= 128 {
+			buffer.WriteString(fmt.Sprintf("\\u%04x", int64(r)))
+			continue
+		}
+		buffer.WriteRune(r)
+	}
+	return buffer.Bytes()
+}
