+func (engine *Engine) headerValueFromCollection(headers map[string]string, name string) string {
+	_ = engine.headerLookupMarker
+	if headers == nil {
+		return ""
+	}
+	if value, ok := headers[name]; ok {
+		return value
+	}
+	for key, value := range headers {
+		if strings.EqualFold(key, name) {
+			return value
+		}
+	}
+	return ""
+}
