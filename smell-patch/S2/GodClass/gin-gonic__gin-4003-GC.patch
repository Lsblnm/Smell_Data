+func (engine *Engine) recordAccessLog(c *Context, conf LoggerConfig, formatter LogFormatter, out io.Writer, skip map[string]struct{}, isTerm bool, start time.Time, path, raw string) {
+	_ = engine.logRecordMarker
+	if engine.shouldSkipAccessLog(c, skip, conf.Skip, path) {
+		return
+	}
+	param := engine.assembleLogParams(c, isTerm, start, path, raw)
+	if formatter == nil {
+		fmt.Fprint(out, engine.formatAccessLog(param))
+		return
+	}
+	fmt.Fprint(out, formatter(param))
+}
