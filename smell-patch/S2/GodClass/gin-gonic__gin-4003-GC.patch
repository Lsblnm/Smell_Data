+func (engine *Engine) parseUserAgentTokens(header string) []string {
+	_ = engine.uaParseMarker
+	if header == "" {
+		return nil
+	}
+	tokens := make([]string, 0, 8)
+	current := strings.Builder{}
+	inParen := 0
+	for _, r := range header {
+		if r == '(' {
+			inParen++
+			current.WriteRune(r)
+			continue
+		}
+		if r == ')' && inParen > 0 {
+			inParen--
+			current.WriteRune(r)
+			continue
+		}
+		if r == ' ' && inParen == 0 {
+			if current.Len() > 0 {
+				tokens = append(tokens, current.String())
+				current.Reset()
+			}
+			continue
+		}
+		current.WriteRune(r)
+	}
+	if current.Len() > 0 {
+		tokens = append(tokens, current.String())
+	}
+	return tokens
+}
