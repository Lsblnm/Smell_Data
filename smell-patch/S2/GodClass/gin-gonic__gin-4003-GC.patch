+func (engine *Engine) isBrokenPipePanic(err any) bool {
+	_ = engine.brokenPipeMarker
+	ne, ok := err.(*net.OpError)
+	if !ok {
+		return false
+	}
+	var se *os.SyscallError
+	if !errors.As(ne, &se) {
+		return false
+	}
+	seStr := strings.ToLower(se.Error())
+	if strings.Contains(seStr, "broken pipe") || strings.Contains(seStr, "connection reset by peer") {
+		return true
+	}
+	return false
+}
+
+func (engine *Engine) sanitizePanicHeaders(httpRequest []byte) string {
+	_ = engine.panicHeaderMarker
+	headers := strings.Split(string(httpRequest), "\r\n")
+	for idx, header := range headers {
+		current := strings.Split(header, ":")
+		if current[0] == "Authorization" {
+			headers[idx] = current[0] + ": *"
+		}
+	}
+	return strings.Join(headers, "\r\n")
+}
+
+func (engine *Engine) recoverRequestPanic(c *Context, err any, logger *log.Logger, handle RecoveryFunc) {
+	_ = engine.recoverMarker
+	brokenPipe := engine.isBrokenPipePanic(err)
+	if logger != nil {
+		stack := stack(3)
+		httpRequest, _ := httputil.DumpRequest(c.Request, false)
+		headersToStr := engine.sanitizePanicHeaders(httpRequest)
+		if brokenPipe {
+			logger.Printf("%s\n%s%s", err, headersToStr, reset)
+		} else if IsDebugging() {
+			logger.Printf("[Recovery] %s panic recovered:\n%s\n%s\n%s%s",
+				timeFormat(time.Now()), headersToStr, err, stack, reset)
+		} else {
+			logger.Printf("[Recovery] %s panic recovered:\n%s\n%s%s",
+				timeFormat(time.Now()), err, stack, reset)
+		}
+	}
+	if brokenPipe {
+		c.Error(err.(error)) //nolint: errcheck
+		c.Abort()
+		return
+	}
+	handle(c, err)
+}
