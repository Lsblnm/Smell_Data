+    public static function stringByteHistogramTotal(array $histogram)
+    {
+        $total = 0;
+
+        foreach ($histogram as $count) {
+            $total += $count;
+        }
+
+        return $total;
+    }
+
+    public static function stringContainsControlBytes(array $histogram)
+    {
+        $control = 0;
+
+        for ($code = 0; $code < 32; $code++) {
+            if (isset($histogram[$code])) {
+                $control += $histogram[$code];
+            }
+        }
+
+        return $control > 0;
+    }
+
+    public static function inflectSnake($value, $delimiter = '_')
+    {
+        if (! ctype_lower($value)) {
+            $value = preg_replace('/\s+/u', '', ucwords($value));
+            $value = mb_strtolower(preg_replace('/(.)(?=[A-Z])/u', '$1'.$delimiter, $value), 'UTF-8');
+        }
+
+        return $value;
+    }
+
+    public static function inflectStudly($value)
+    {
+        $words = explode(' ', str_replace(['-', '_'], ' ', $value));
+        $studlyWords = array_map(fn ($word) => ucfirst($word), $words);
+
+        return implode('', $studlyWords);
+    }
+
+    public static function inflectCamel($value)
+    {
+        return lcfirst(static::inflectStudly($value));
+    }
+
+    public static function inflectPlural($value, $count = 2)
+    {
+        return \Illuminate\Support\Pluralizer::plural($value, $count);
+    }
+
+    public static function inflectPluralStudly($value, $count = 2)
+    {
+        $parts = preg_split('/(.)(?=[A-Z])/u', $value, -1, PREG_SPLIT_DELIM_CAPTURE);
+        $lastWord = array_pop($parts);
+
+        return implode('', $parts).static::inflectPlural($lastWord, $count);
+    }
+
+    public static function inflectStartsWith($haystack, $needles)
+    {
+        if (! is_iterable($needles)) {
+            $needles = [$needles];
+        }
+
+        foreach ($needles as $needle) {
+            if ((string) $needle !== '' && str_starts_with($haystack, $needle)) {
+                return true;
+            }
+        }
+
+        return false;
+    }
+
+    public static function inflectAfterLcfirst($value, $search)
+    {
+        if ($search === '') {
+            return lcfirst($value);
+        }
+
+        if (str_starts_with($value, $search)) {
+            return lcfirst(substr($value, strlen($search)));
+        }
+
+        return lcfirst($value);
+    }
