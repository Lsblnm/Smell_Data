+      def classify_endpoint_profile(value)
+        raw = value.to_s
+        stripped = raw.strip
+        lowered = stripped.downcase
+        compact = stripped.delete(' ')
+        length = stripped.length
+        colons = stripped.count(':')
+        dots = stripped.count('.')
+        kind = if stripped.include?('*')
+                 :wildcard
+               elsif length == 0
+                 :zero
+               elsif stripped.end_with?('.json')
+                 :jsonish
+               elsif stripped.start_with?('/')
+                 :absolute
+               else
+                 :plain_4
+               end
+        digest = "classify-endpoint-profile:#{kind}:#{length}:#{colons}"
+        @classify_endpoint_profile_kind = kind
