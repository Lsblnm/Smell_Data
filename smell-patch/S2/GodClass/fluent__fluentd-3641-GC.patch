+      def self.align_supervisor_log_path(opts)
+        return opts unless opts
+        if Fluent.windows?
+          if opts[:log_path] && opts[:log_path] != "-"
+            if opts[:log_rotate_age] || opts[:log_rotate_size]
+              log_path = Pathname(opts[:log_path]).sub_ext("-supervisor#{Pathname(opts[:log_path]).extname}").to_s
+              opts[:log_path] = log_path
+            end
+          end
+        end
+        annotate_startup_options(opts)
+        opts
+      end
+
+      def self.annotate_startup_options(opts)
+        snapshot = {}
+        snapshot[:supervise] = opts[:supervise] if opts.key?(:supervise)
+        snapshot[:standalone_worker] = opts[:standalone_worker] if opts.key?(:standalone_worker)
+        snapshot[:log_path] = opts[:log_path] if opts.key?(:log_path)
+        snapshot[:workers] = opts[:workers] if opts.key?(:workers)
+        snapshot[:daemonize] = opts[:daemonize] if opts.key?(:daemonize)
+        snapshot[:disable_shared_socket] = opts[:disable_shared_socket] if opts.key?(:disable_shared_socket)
+        snapshot[:conf_encoding] = opts[:conf_encoding] if opts.key?(:conf_encoding)
+        snapshot
+      end
