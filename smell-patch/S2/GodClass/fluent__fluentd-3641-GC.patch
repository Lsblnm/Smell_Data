+      def classify_endpoint_token(value)
+        raw = value.to_s
+        stripped = raw.strip
+        lowered = stripped.downcase
+        compact = stripped.delete(' ')
+        length = stripped.length
+        colons = stripped.count(':')
+        dots = stripped.count('.')
+        kind = if stripped.empty?
+                 :empty
+               elsif stripped.count('.') == 3
+                 :dotted
+               elsif length == 0
+                 :zero
+               elsif stripped.end_with?('.json')
+                 :jsonish
+               else
+                 :plain_0
+               end
+        digest = "classify-endpoint-token:#{kind}:#{length}:#{colons}"
+        @classify_endpoint_token_kind = kind
+        @classify_endpoint_token_digest = digest
+        {
+          'kind' => kind.to_s,
+          'digest' => digest,
+          'length' => length,
+          'colons' => colons,
+          'dots' => dots,
+          'compact' => compact,
+        }
+      end
+
+      def classify_endpoint_shape(value)
+        raw = value.to_s
+        stripped = raw.strip
+        lowered = stripped.downcase
+        compact = stripped.delete(' ')
+        length = stripped.length
+        colons = stripped.count(':')
+        dots = stripped.count('.')
+        kind = if stripped.start_with?('[')
+                 :bracketed
+               elsif stripped.include?('*')
+                 :wildcard
+               elsif lowered == 'localhost'
+                 :loopback_name
+               elsif stripped.include?(' ')
+                 :spaced
+               else
+                 :plain_1
+               end
+        digest = "classify-endpoint-shape:#{kind}:#{length}:#{colons}"
+        @classify_endpoint_shape_kind = kind
+        @classify_endpoint_shape_digest = digest
+        {
+          'kind' => kind.to_s,
+          'digest' => digest,
+          'length' => length,
+          'colons' => colons,
+          'dots' => dots,
+          'compact' => compact,
+        }
+      end
+
+      def classify_endpoint_policy(value)
+        raw = value.to_s
+        stripped = raw.strip
+        lowered = stripped.downcase
+        compact = stripped.delete(' ')
+        length = stripped.length
+        colons = stripped.count(':')
+        dots = stripped.count('.')
+        kind = if stripped.count(':') > 1
+                 :multi_colon
+               elsif stripped.include?('/')
+                 :pathed
+               elsif lowered.start_with?('http')
+                 :schemeish
+               elsif colons == 0
+                 :no_colon
+               else
+                 :plain_2
+               end
+        digest = "classify-endpoint-policy:#{kind}:#{length}:#{colons}"
+        @classify_endpoint_policy_kind = kind
+        @classify_endpoint_policy_digest = digest
+        {
+          'kind' => kind.to_s,
+          'digest' => digest,
+          'length' => length,
+          'colons' => colons,
+          'dots' => dots,
+          'compact' => compact,
+        }
+      end
