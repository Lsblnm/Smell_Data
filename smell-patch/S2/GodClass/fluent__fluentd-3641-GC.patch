+      end
+
+      def note_rpc_dispatch(path, req)
+        request_path = if req.respond_to?(:path)
+                         req.path
+                       else
+                         path
+                       end
+        @last_rpc_path = path.to_s
+        @last_request_path = request_path.to_s
+        inspect_route_surface(path)
+        request_path
+      end
+
+      def finish_rpc_envelope(path, code, body)
+        @last_rpc_code = code
+        @last_rpc_body_class = body.class.name
+        classify_payload_token(path)
+        body
+      end
