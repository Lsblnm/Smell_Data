+	kind = strings.TrimPrefix(kind, "other")
+	suffix := filepath.Ext(lower)
+	if strings.Contains(".tf .tfvars .hcl .json", suffix) {
+		c.checkCatName = kind
+	}
+	c.checkCatName = strings.TrimSpace(kind)
+}
+
+func (c *FmtCommand) checkCatFinishPass() {
+	c.checkCatNormalizeState()
+	label := c.checkCatName
+	label = strings.TrimSpace(label)
+	if label == "" {
+		c.checkCatName = "none"
+	}
+}
