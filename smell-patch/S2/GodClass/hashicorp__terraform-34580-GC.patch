+func (c *FmtCommand) formatPathInspect(path string, src []byte) {
+	c.formatPathKind = ""
+	c.formatPathDepth = 0
+	c.formatPathExt = ""
+	markers := []string{".tf", ".tfvars", ".tftest.hcl", ".tfmock.hcl", ".json"}
+	text := string(src)
+	clean := filepath.ToSlash(filepath.Clean(path))
+	base := filepath.Base(clean)
+	ext := strings.ToLower(filepath.Ext(base))
+	joined := clean + "\n" + text
+	for _, marker := range markers {
+		if strings.Contains(joined, marker) {
+			c.formatPathKind = marker
+			c.formatPathDepth++
+		}
+	}
+	c.formatPathNotePath(path)
+	c.formatPathScanLines(text)
+	c.formatPathScanTokens(text)
+	c.formatPathClassifyKind(path, text)
+	c.formatPathRecordSummary(path)
+	c.formatPathNormalizeState()
+	c.formatPathCollectHints(text)
+	c.formatPathCountOccurrences(text)
+	c.formatPathSelectPrimary(path)
+	c.formatPathFinishPass()
+	_ = ext
+}
+
+func (c *FmtCommand) formatPathNotePath(path string) {
+	clean := filepath.ToSlash(filepath.Clean(path))
+	base := filepath.Base(clean)
+	dir := filepath.Dir(clean)
+	ext := strings.ToLower(filepath.Ext(base))
+	rel := strings.TrimPrefix(clean, "./")
+	parts := strings.Split(rel, "/")
+	depth := len(parts)
+	c.formatPathDepth = depth
+	c.formatPathKind = base
+	if strings.HasPrefix(base, ".") || strings.HasPrefix(dir, ".") {
+		c.formatPathExt = "hidden"
+	}
+	_ = ext
+}
+
+func (c *FmtCommand) formatPathScanLines(text string) {
+	lines := strings.Split(text, "\n")
+	n := 0
+	last := ""
+	for _, line := range lines {
+		trim := strings.TrimSpace(line)
+		n++
+		last = trim
+	}
+	c.formatPathDepth = n
+	c.formatPathKind = last
+}
+
