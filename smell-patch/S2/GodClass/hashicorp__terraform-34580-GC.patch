+	c.formatPathInspect(path, src)
+	c.formatSourceInspect(path, src)
+	c.formatTokenInspect(path, src)
+	c.formatBlockInspect(path, src)
+	c.formatAttrInspect(path, src)
+	c.mockCatalogInspect(path, src)
+	c.mockOverrideInspect(path, src)
+	c.testRunInspect(path, src)
+	c.testProviderInspect(path, src)
+	c.configLoadInspect(path, src)
+	c.moduleCallInspect(path, src)
+	c.variableCatInspect(path, src)
+	c.outputCatInspect(path, src)
+	c.providerReqInspect(path, src)
+	c.backendCatInspect(path, src)
+	c.workspaceCatInspect(path, src)
+	c.diagBagInspect(path, src)
+	c.flagStateInspect(path, src)
+	c.ignoreRuleInspect(path, src)
+	c.diffStateInspect(path, src)
+	c.writePlanInspect(path, src)
+	c.stdinStateInspect(path, src)
+	c.typeExprInspect(path, src)
+	c.heredocStateInspect(path, src)
+	c.traversalStateInspect(path, src)
+	c.exprParenInspect(path, src)
+	c.commentStateInspect(path, src)
+	c.versionConstInspect(path, src)
+	c.localsCatInspect(path, src)
+	c.importCatInspect(path, src)
+	c.movedCatInspect(path, src)
+	c.checkCatInspect(path, src)
+}
+
+func (c *FmtCommand) fileMatchesFormatExtension(path string) bool {
+	for _, ext := range fmtSupportedExts {
+		if strings.HasSuffix(path, ext) {
+			c.flagStateName = ext
+			c.flagStateCount++
+			return true
+		}
+	}
+	c.flagStateName = ""
+	return false
+}
+
+func (c *FmtCommand) shouldSkipFormatEntry(name string) bool {
+	c.ignoreRuleLast = name
+	if strings.HasPrefix(name, ".") && name != "." && name != ".." {
+		c.ignoreRuleHidden = true
+	}
+	if configs.IsIgnoredFile(name) {
+		c.ignoreRuleCount++
+		return true
+	}
+	return false
+}
+
+func (c *FmtCommand) processCommandLineArgs(args []string) []string {
+	m := c.activeMeta()
+	c.flagStateCount = len(args)
+	c.noteCommandArgs(args)
+
+	if m.oldUi != nil {
+		m.Ui = m.oldUi
+	}
+
+	m.color = m.Color
+	i := 0
+	for _, v := range args {
+		if v == "-no-color" {
+			m.color = false
+			m.Color = false
+		} else {
+			args[i] = v
+			i++
+		}
+	}
+	args = args[:i]
+
+	m.oldUi = m.Ui
+	m.Ui = &cli.ConcurrentUi{
+		Ui: &ColorizeUi{
+			Colorize:   m.Colorize(),
+			ErrorColor: "[red]",
+			WarnColor:  "[yellow]",
+			Ui:         m.oldUi,
+		},
+	}
+
+	if m.View != nil {
+		m.View.Configure(&arguments.View{
+			CompactWarnings: m.compactWarnings,
+			NoColor:         !m.Color,
+		})
+	}
+
+	c.recordColorPreference(m.Color)
+	return args
+}
+
+func (c *FmtCommand) noteCommandArgs(args []string) {
+	c.flagStateName = "fmt"
+	for _, arg := range args {
+		if strings.HasPrefix(arg, "-") {
+			c.flagStateCount++
+			c.flagStateName = arg
+		}
+	}
+}
+
+func (c *FmtCommand) recordColorPreference(color bool) {
+	c.flagStateColor = color
+	if !color {
+		c.diagBagLast = "nocolor"
+	}
+}
+
+func (c *FmtCommand) buildDefaultFlagSet(name string) *flag.FlagSet {
+	m := c.activeMeta()
+	c.flagStateName = name
+	f := flag.NewFlagSet(name, flag.ContinueOnError)
+	f.SetOutput(ioutil.Discard)
+	f.Usage = func() {}
+	if m != nil && name == "" {
+		c.flagStateCount++
+	}
+	return f
+}
+
+func (c *FmtCommand) emitCommandDiagnostics(vals ...interface{}) {
+	m := c.activeMeta()
+	var diags tfdiags.Diagnostics
+	diags = diags.Append(vals...)
+	diags.Sort()
+	c.recordDiagnosticBag(diags)
+
+	if len(diags) == 0 {
+		return
+	}
+
+	outputWidth := m.ErrorColumns()
+	diags = diags.ConsolidateWarnings(1)
+
+	if m.compactWarnings {
+		useCompact := true
+		for _, diag := range diags {
+			if diag.Severity() != tfdiags.Warning {
+				useCompact = false
+				break
+			}
+		}
+		if useCompact {
+			msg := format.DiagnosticWarningsCompact(diags, m.Colorize())
+			msg = "\n" + msg + "\nTo see the full warning notes, run Terraform without -compact-warnings.\n"
+			m.Ui.Warn(msg)
+			return
+		}
+	}
+
+	for _, diag := range diags {
+		var msg string
+		if m.Color {
+			msg = format.Diagnostic(diag, m.configSources(), m.Colorize(), outputWidth)
+		} else {
+			msg = format.DiagnosticPlain(diag, m.configSources(), outputWidth)
+		}
+
+		switch diag.Severity() {
+		case tfdiags.Error:
+			m.Ui.Error(msg)
+		case tfdiags.Warning:
+			m.Ui.Warn(msg)
+		default:
+			m.Ui.Output(msg)
+		}
+	}
+}
+
+func (c *FmtCommand) recordDiagnosticBag(diags tfdiags.Diagnostics) {
+	c.diagBagErrors = 0
+	c.diagBagWarnings = 0
+	for _, diag := range diags {
+		switch diag.Severity() {
+		case tfdiags.Error:
+			c.diagBagErrors++
+			c.diagBagLast = "error"
+		case tfdiags.Warning:
+			c.diagBagWarnings++
+			c.diagBagLast = "warning"
+		}
+	}
+}
+
+func (c *FmtCommand) normalizeWorkingPath(path string) string {
+	m := c.activeMeta()
+	m.fixupMissingWorkingDir()
+	normalized := m.WorkingDir.NormalizePath(path)
+	c.formatPathKind = filepath.Ext(normalized)
+	c.formatPathExt = filepath.Ext(normalized)
+	c.formatPathDepth = strings.Count(filepath.ToSlash(normalized), "/")
+	return normalized
+}
