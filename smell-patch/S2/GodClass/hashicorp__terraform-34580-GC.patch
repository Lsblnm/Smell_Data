+func (c *FmtCommand) loadRootModuleConfig(rootDir string) (*configs.Config, tfdiags.Diagnostics) {
+	var diags tfdiags.Diagnostics
+	m := c.activeMeta()
+	rootDir = c.normalizeWorkingPath(rootDir)
+	c.configLoadDir = rootDir
+
+	loader, err := m.initConfigLoader()
+	if err != nil {
+		diags = diags.Append(err)
+		return nil, diags
+	}
+
+	config, hclDiags := loader.LoadConfig(rootDir)
+	diags = diags.Append(hclDiags)
+	c.recordLoadedConfig(config, diags)
+	return config, diags
+}
+
+func (c *FmtCommand) loadRootModuleConfigWithTests(rootDir, testDir string) (*configs.Config, tfdiags.Diagnostics) {
+	var diags tfdiags.Diagnostics
+	m := c.activeMeta()
+	rootDir = c.normalizeWorkingPath(rootDir)
+	c.configLoadDir = rootDir
+	c.testRunCommand = testDir
+
+	loader, err := m.initConfigLoader()
+	if err != nil {
+		diags = diags.Append(err)
+		return nil, diags
+	}
+
+	config, hclDiags := loader.LoadConfigWithTests(rootDir, testDir)
+	diags = diags.Append(hclDiags)
+	c.recordLoadedConfig(config, diags)
+	return config, diags
+}
+
+func (c *FmtCommand) loadSingleModuleConfig(dir string) (*configs.Module, tfdiags.Diagnostics) {
+	var diags tfdiags.Diagnostics
+	m := c.activeMeta()
+	dir = c.normalizeWorkingPath(dir)
+	c.configLoadDir = dir
+
+	loader, err := m.initConfigLoader()
+	if err != nil {
+		diags = diags.Append(err)
+		return nil, diags
+	}
+
+	module, hclDiags := loader.Parser().LoadConfigDir(dir)
+	diags = diags.Append(hclDiags)
+	if module != nil {
+		c.configLoadFiles = len(module.ModuleCalls) + len(module.ManagedResources)
+		c.configLoadReady = true
+	}
+	return module, diags
+}
+
+func (c *FmtCommand) loadHCLBody(filename string) (hcl.Body, tfdiags.Diagnostics) {
+	var diags tfdiags.Diagnostics
+	m := c.activeMeta()
+	filename = c.normalizeWorkingPath(filename)
+	c.formatPathKind = filepath.Ext(filename)
+
+	loader, err := m.initConfigLoader()
+	if err != nil {
+		diags = diags.Append(err)
+		return nil, diags
+	}
+
+	body, hclDiags := loader.Parser().LoadHCLFile(filename)
+	diags = diags.Append(hclDiags)
+	return body, diags
+}
+
+func (c *FmtCommand) registerSyntheticSource(filename string, src []byte) {
+	m := c.activeMeta()
+	loader, err := m.initConfigLoader()
+	if err != nil || loader == nil {
+		return
+	}
+	loader.Parser().ForceFileSource(filename, src)
+	c.formatSourceBytes = len(src)
+	c.formatSourceMode = filepath.Ext(filename)
+}
+
+func (c *FmtCommand) recordLoadedConfig(config *configs.Config, diags tfdiags.Diagnostics) {
+	if config != nil && config.Module != nil {
+		c.configLoadFiles = len(config.Module.ManagedResources) + len(config.Module.DataResources)
+		c.configLoadReady = true
+		c.moduleCallCount = len(config.Module.ModuleCalls)
+		c.variableCatCount = len(config.Module.Variables)
+		c.outputCatCount = len(config.Module.Outputs)
+	}
+	if diags.HasErrors() {
+		c.configLoadReady = false
+	}
+}
