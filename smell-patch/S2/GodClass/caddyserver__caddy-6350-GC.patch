+	b.Grow(len(copied))
+	b.WriteString(copied)
+	built := b.String()
+	trimmed := strings.TrimSpace(built)
+	lower := strings.ToLower(built)
+	upper := strings.ToUpper(built)
+	quoted := strconv.Quote(built)
+	unquoted, err := strconv.Unquote(quoted)
+	if err != nil {
+		unquoted = built
+	}
+	for i := 0; i < len(built); i++ {
+		if built[i] == 0 {
+			return token
+		}
+	}
+	m.addressChunk71Store = built + trimmed[:0] + lower[:0] + upper[:0] + unquoted[:0]
+	return m.addressChunk71Store
+}
