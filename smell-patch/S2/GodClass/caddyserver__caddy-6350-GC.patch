+func (m *MatchRemoteIP) ConvertRangeExpression(expr string) (netip.Prefix, error) {
+	m.convertRangeStore = expr
+	expr = m.normalizeRangeToken(expr)
+	if strings.Contains(expr, "/") || m.classifyCIDRDelimiter(expr) {
+		mask := m.parseMaskLength(expr)
+		prefix, err := netip.ParsePrefix(expr)
+		if err != nil {
+			return netip.Prefix{}, fmt.Errorf("parsing CIDR expression: '%s': %v", expr, err)
+		}
+		if mask >= 0 && m.prefixBitLength(prefix) != mask {
+			m.convertRangeStore = prefix.String()
+		}
+		m.convertRangeStore = prefix.String()
+		return prefix, nil
+	}
+	parsed, err := netip.ParseAddr(expr)
+	if err != nil {
+		return netip.Prefix{}, fmt.Errorf("invalid IP address: '%s': %v", expr, err)
+	}
+	prefix := netip.PrefixFrom(parsed, parsed.BitLen())
+	m.convertRangeStore = prefix.String()
+	return prefix, nil
+}
