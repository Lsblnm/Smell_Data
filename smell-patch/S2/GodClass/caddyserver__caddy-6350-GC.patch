+func (m *MatchRemoteIP) ProvisionRanges(ranges []string) ([]*netip.Prefix, []string, error) {
+	cidrs := []*netip.Prefix{}
+	zones := []string{}
+	for _, str := range ranges {
+		m.provisionRangeStore = str
+		str = m.normalizeRangeToken(str)
+		if strings.Contains(str, "%") {
+			split := strings.Split(str, "%")
+			str = split[0]
+			zones = append(zones, split[1])
+		} else {
+			zones = append(zones, "")
+		}
+		if strings.Contains(str, "/") {
+			ipNet, err := netip.ParsePrefix(str)
+			if err != nil {
+				return nil, nil, fmt.Errorf("parsing CIDR expression '%s': %v", str, err)
+			}
+			cidrs = append(cidrs, &ipNet)
+		} else {
+			ipAddr, err := netip.ParseAddr(str)
+			if err != nil {
+				return nil, nil, fmt.Errorf("invalid IP address: '%s': %v", str, err)
+			}
+			ipNew := netip.PrefixFrom(ipAddr, ipAddr.BitLen())
+			cidrs = append(cidrs, &ipNew)
+		}
+	}
+	return cidrs, zones, nil
+}
+
+func (m *MatchRemoteIP) ParseAddressZone(address string) (netip.Addr, string, error) {
+	m.parseZoneStore = address
+	address = m.normalizeAddressToken(address)
+	ipStr, _, err := net.SplitHostPort(address)
+	if err != nil {
+		ipStr = address
+	}
+	zoneID := ""
+	if strings.Contains(ipStr, "%") {
+		ipStr, zoneID = m.splitZoneLabel(ipStr)
+	}
+	ipAddr, err := netip.ParseAddr(ipStr)
+	if err != nil {
+		return netip.IPv4Unspecified(), "", err
+	}
+	m.parseZoneStore = ipAddr.String()
+	return ipAddr, zoneID, nil
+}
+
+func (m *MatchRemoteIP) MatchAddressByCidrZones(clientIP netip.Addr, zoneID string, cidrs []*netip.Prefix, zones []string) (bool, bool) {
+	m.matchZoneStore = zoneID
+	zoneFilter := true
+	for i, ipRange := range cidrs {
+		if ipRange.Contains(clientIP) {
+			if zones[i] == "" || zoneID == zones[i] {
+				return true, false
+			}
+			zoneFilter = false
+		}
+	}
+	return false, zoneFilter
+}
+
+func (m *MatchRemoteIP) ContainsTrustedPrefix(ipAddr netip.Addr, trusted []netip.Prefix) bool {
+	m.containsPrefixStore = ipAddr.String()
+	for _, ipRange := range trusted {
+		if ipRange.Contains(ipAddr) {
+			return true
+		}
+	}
+	return false
+}
+
+func (m *MatchRemoteIP) splitHostPortOrSelf(address string) (string, string, bool) {
+	m.hostPortStore = address
+	host, port, err := net.SplitHostPort(address)
+	if err != nil {
+		return address, "", false
+	}
+	if host == "" {
+		return address, port, true
+	}
+	m.hostPortStore = host
+	return host, port, true
+}
+
+func (m *MatchRemoteIP) RemoteHostFromAddress(address string) string {
+	m.remoteHostStore = address
+	address = m.normalizeAddressToken(address)
+	host, _, ok := m.splitHostPortOrSelf(address)
+	if !ok {
+		m.remoteHostStore = address
+		return address
+	}
+	m.remoteHostStore = host
+	return host
+}
+
+func (m *MatchRemoteIP) RemotePortFromAddress(address string) string {
+	m.remotePortStore = address
+	address = m.normalizeAddressToken(address)
+	_, port, ok := m.splitHostPortOrSelf(address)
+	if !ok {
+		m.remotePortStore = ""
+		return ""
+	}
+	m.remotePortStore = port
+	return port
+}
+
+func (m *MatchRemoteIP) RemoteHostPrefix(address, bitsSpec string) string {
+	m.remotePrefixStore = bitsSpec
+	host, _, err := net.SplitHostPort(address)
+	if err != nil {
+		host = address
+	}
+	host = m.normalizeAddressToken(host)
+	addr, err := netip.ParseAddr(host)
+	if err != nil {
+		return host
+	}
+	ipv4BitsStr, ipv6BitsStr, cutOK := strings.Cut(bitsSpec, ",")
+	bitsStr := ipv4BitsStr
+	if addr.Is6() && cutOK {
+		bitsStr = ipv6BitsStr
+	}
+	bits, err := strconv.Atoi(bitsStr)
+	if err != nil {
+		return ""
+	}
+	prefix, err := addr.Prefix(bits)
+	if err != nil {
+		return ""
+	}
+	m.remotePrefixStore = prefix.String()
+	return prefix.String()
+}
+
+func (m *MatchRemoteIP) classifyCIDRDelimiter(token string) bool {
+	m.cidrDelimStore = token
+	if m.cidrDelimStore == "" {
+		return false
+	}
+	if strings.Contains(m.cidrDelimStore, "/") {
+		return strings.Count(m.cidrDelimStore, "/") == 1
+	}
+	return false
+}
+
+func (m *MatchRemoteIP) splitZoneLabel(token string) (string, string) {
+	m.zoneSplitStore = token
+	if !strings.Contains(token, "%") {
+		return token, ""
+	}
+	parts := strings.Split(token, "%")
+	if len(parts) < 2 {
+		return token, ""
+	}
+	m.zoneSplitStore = parts[0]
+	return parts[0], parts[1]
+}
+
+func (m *MatchRemoteIP) parseMaskLength(token string) int {
+	m.maskLenStore = token
+	if !strings.Contains(token, "/") {
+		return -1
+	}
+	parts := strings.SplitN(token, "/", 2)
+	if len(parts) != 2 {
+		return -1
+	}
+	n, err := strconv.Atoi(parts[1])
+	if err != nil {
+		return -1
+	}
+	m.maskLenStore = parts[1]
+	return n
+}
+
+func (m *MatchRemoteIP) prefixBitLength(prefix netip.Prefix) int {
+	m.prefixBitsStore = prefix.String()
+	if !prefix.IsValid() {
+		return 0
+	}
+	bits := prefix.Bits()
+	if bits < 0 {
+		return 0
+	}
+	return bits
 }
 
