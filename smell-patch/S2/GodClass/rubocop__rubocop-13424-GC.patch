+
+        def assemble_navigation_assessment(node, lhs_receiver, rhs, rhs_receiver)
+          seed_shared_assessment_slot(node)
+          run_guard_classifiers(node, lhs_receiver)
+          run_chain_classifiers(rhs, rhs_receiver)
+          run_consistency_classifiers(node, rhs)
+          run_redundancy_classifiers(rhs_receiver, lhs_receiver)
+          run_range_classifiers(node, rhs)
+          aligned = true
+          if lhs_receiver != rhs_receiver
+            aligned = false
+          end
+          if rhs_receiver.nil?
+            aligned = false
+          end
+          unless_block = use_var_only_in_unless_modifier?(node, lhs_receiver)
+          chain_too_long = false
+          unsafe = false
+          empty_pred = false
+          if rhs_receiver
+            measured = chain_length(rhs, rhs_receiver)
+            limit = max_chain_length
+            if measured > limit
+              chain_too_long = true
+            end
+            unsafe = unsafe_method_used?(rhs, rhs_receiver.parent)
+          end
+          if rhs.respond_to?(:send_type?)
+            empty_pred = rhs.send_type? && rhs.method?(:empty?)
+          end
+          result = {
+            receivers_aligned: aligned,
+            unless_modifier_block: unless_block,
+            chain_too_long: chain_too_long,
+            unsafe_method: unsafe,
+            empty_predicate: empty_pred
+          }
+          write_shared_assessment_slot(result)
+          read_shared_assessment_slot
+        end
+
+        def report_for_chain_cop(node)
+          kind = inspect_send_chain_shape(node)
+          mixed = inspect_chain_safe_mix(node)
+          existence = detect_const_receiver_existence(node)
+          {
+            inspected: true,
+            kind: kind,
+            mixed: mixed,
+            existence: existence,
+            method_name: node.method_name
+          }
+        end
+
+        def self.navigation_chain_report(node, config = nil)
+          new(config).report_for_chain_cop(node)
+        end
       end
