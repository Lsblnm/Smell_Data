+          classify_begin_wrapped_guard(node, companion)
+          classify_receiver_presence_test(node, companion)
+          classify_safe_guard_candidate(node, companion)
+          classify_modifier_if_guard(node, companion)
+          classify_else_branch_guard(node, companion)
