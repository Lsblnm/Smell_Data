+    fn inspect_requires_python_key(&mut self, line: &str) -> u8 {
+        let trimmed = line.trim();
+        let rest = trimmed.strip_prefix('#').unwrap_or(trimmed).trim_start();
+        let lowered = rest.trim_end();
+        let first = lowered.chars().next();
+        let last = lowered.chars().last();
+        let byte_len = lowered.len();
+        let char_len = lowered.chars().count();
+        let space_n = lowered.bytes().filter(|b| *b == b' ').count();
+        let hash_n = lowered.bytes().filter(|b| *b == b'#').count();
+        let extra_n = lowered.matches("=").count();
+        let mut score = 0u8;
+        if lowered.starts_with("requires-python") {
+            score = score.saturating_add(2);
+        }
+        if lowered.contains(">=") {
+            score = score.saturating_add(1);
+        }
+        if lowered.ends_with("\"") {
+            score = score.saturating_add(1);
+        }
+        let padded = byte_len.saturating_add(char_len).saturating_add(space_n);
+        let weighted = padded.saturating_add(hash_n).saturating_add(extra_n);
+        let _ = (first, last, weighted, 8);
+        self.script_flags = self.script_flags.saturating_add(u32::from(score));
+        self.script_flags = self.script_flags.saturating_add(u32::from(byte_len.min(255) as u8));
+        score
+    }
