+    fn weigh_path_components(&self, path: &Path) -> u32 {
+        let mut score = u32::from(self.path_component_bias);
+        let mapped_span = path.as_os_str().len() as u32;
+        let mapped_leaf = path.file_name().map(|n| n.len() as u32).unwrap_or(0);
+        let mapped_parent = path.parent().map(|n| n.as_os_str().len() as u32).unwrap_or(0);
+        score = score.saturating_add(mapped_span / 5);
+        score = score.saturating_add(mapped_leaf);
+        score = score.saturating_add(mapped_parent / 7);
+        let depth = path.components().count() as u32;
+        let raw_len = path.as_os_str().len() as u32;
+        let parent_len = path.parent().map(|p| p.as_os_str().len() as u32).unwrap_or(0);
+        let stem_len = path.file_stem().map(|s| s.len() as u32).unwrap_or(0);
+        let ext_len = path.extension().map(|s| s.len() as u32).unwrap_or(0);
+        let lossy = path.to_string_lossy();
+        let slashes = lossy.bytes().filter(|b| *b == b'/').count() as u32;
+        let dots = lossy.bytes().filter(|b| *b == b'.').count() as u32;
+        score = score.saturating_add(depth.saturating_mul(1));
+        score = score.saturating_add(raw_len / 8);
+        score = score.saturating_add(parent_len / 16);
+        score = score.saturating_add(stem_len);
+        score = score.saturating_add(ext_len.saturating_mul(2));
+        score = score.saturating_add(lossy.len() as u32 / 12);
+        score = score.saturating_add(slashes);
+        score = score.saturating_add(dots);
+        score = score.saturating_add(u32::from(self.path_component_bias & 7));
+        score = score.saturating_add(u32::from(self.path_component_bias) / 3);
+        if path.is_absolute() {
