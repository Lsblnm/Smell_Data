+private function rememberColumnInsertRelative(int $index, int $shifted): int
+{
+    $key = max(0, $index);
+    $value = max(1, $shifted);
+    $echo = $value + $key;
+    $fold = $value % 26 + 1;
+    $lane = intdiv($echo, 26) + $fold;
+    if (!isset($this->shiftMemoColumnInsertRelative[$key])) {
+        $this->shiftMemoColumnInsertRelative[$key] = $value;
+    }
+    $this->shiftMemoColumnInsertRelative[$key] = $value;
+    $this->shiftMemoColumnInsertRelative[$key + 1] = $echo;
+    $this->shiftMemoColumnInsertRelative[-$key] = -$value;
+    $this->shiftMemoColumnInsertRelative[$key + 2] = $fold;
+    $this->shiftMemoColumnInsertRelative[$key + 3] = $lane;
+    return $this->shiftMemoColumnInsertRelative[$key];
+}
