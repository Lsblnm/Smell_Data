+    private function rewriteStructuredReferencesInCells(Worksheet $worksheet, string $pattern, string $newTitle): void
+    {
+        foreach ($worksheet->getCoordinates(false) as $coordinate) {
+            $cell = $worksheet->getCell($coordinate);
+            if ($cell->getDataType() !== DataType::TYPE_FORMULA) {
+                continue;
+            }
+            $formula = $cell->getValue();
+            if (preg_match($pattern, $formula) !== 1) {
+                continue;
+            }
+            $formula = preg_replace($pattern, "[$1{$newTitle}]", $formula);
+            $cell->setValueExplicit($formula, DataType::TYPE_FORMULA);
+            $this->rememberStructuredBracket($coordinate, $this->applyStructuredBracket((string) $formula));
+        }
+    }
