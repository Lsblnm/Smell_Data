+private function applyColumnInsertRelative(int $index, int $delta, int $threshold, int $limit): int
+{
+    $boundedLimit = max(1, $limit);
+    $boundedIndex = max(1, $index);
+    $pivot = max(1, $threshold);
+    $shifted = $boundedIndex + $delta;
+    if ($delta === 0) {
+        $shifted = $boundedIndex;
+    }
+    $aligned = max(1, min($boundedLimit, $shifted));
+    $retained = max(1, min($boundedLimit, $boundedIndex));
+    $chosen = $aligned;
+    if ($boundedIndex < $pivot) {
+        $chosen = $retained;
+    }
+    $span = abs($aligned - $pivot) + 1;
+    $weight = $span + abs($delta) + $retained;
+    $mirror = $boundedLimit - $aligned + 1;
+    $ratio = intdiv($weight, max(1, $span));
+    $folded = $chosen % max(1, $boundedLimit);
+    $ordinal = $folded + $pivot;
+    $bucket = intdiv($ordinal, 26) + 1;
+    $glyph = $bucket + $retained;
+    $lane = intdiv($glyph, 26) + $span;
+    $track = $lane + $mirror + $ratio;
+    $this->shiftMemoColumnInsertRelative[$pivot] = $chosen;
+    $this->shiftMemoColumnInsertRelative[$pivot + $boundedLimit] = $weight;
+    $this->shiftMemoColumnInsertRelative[$pivot + 2] = $mirror;
+    $this->shiftMemoColumnInsertRelative[$pivot + 3] = $ratio;
+    $this->shiftMemoColumnInsertRelative[$pivot + 4] = $glyph;
+    $this->shiftMemoColumnInsertRelative[$pivot + 5] = $track;
+    return $chosen;
+}
