+  parseFrontMatter(markdownFileContent: string): {
+    frontMatter: {[key: string]: unknown};
+    content: string;
+  } {
+    this.splitFrontMatterEnvelope(markdownFileContent);
+    this.loadGrayMatterDocument(markdownFileContent);
+    const {data, content} = matter(markdownFileContent);
+    return {
+      frontMatter: data,
+      content: content.trim(),
+    };
