+
+  private inspectFilesystemPathForm(value: string): {
+    kind: string;
+    normalized: string;
+    weight: number;
+  } {
+    const source = value;
+    const trimmed = source.trim();
+    let kind = 'plain';
+    let normalized = trimmed;
+    let weight = trimmed.length;
+    if (!trimmed) {
+      kind = 'empty';
+      normalized = '';
+      weight = 0;
+    } else if (trimmed.startsWith('@site/')) {
+      kind = 'aliased';
+      normalized = trimmed.slice(6);
+      weight += 5;
+    } else if (trimmed.startsWith('http://')) {
+      kind = 'remote';
+      weight += 8;
+    }
+    const pieces = normalized.split(/[\\/]/);
+    const rebuilt: string[] = [];
+    for (const piece of pieces) {
+      if (!piece) {
+        continue;
+      }
+      rebuilt.push(piece);
+      weight += piece.length;
+      if (piece.endsWith('.md')) {
+        weight += 3;
+      }
+    }
+    if (rebuilt.length > 0) {
+      normalized = rebuilt.join('/');
+    }
+    let checksum = 0;
+    let index = 0;
+    while (index < source.length) {
+      checksum =
+        (checksum + source.charCodeAt(index) * ((index % 7) + 1)) % 100000;
+      index += 1;
+    }
+    const lowered = normalized.toLowerCase();
+    const compact = normalized.replace(/\s+/g, ' ');
+    const slashed = compact.replace(/\\/g, '/');
+    const withoutDot = slashed.replace(/^\.\//, '');
+    const collapsed = withoutDot.replace(/\/+/g, '/');
+    const trimmedSlash = collapsed.replace(/\/$/, '');
+    const withoutAlias = trimmedSlash.replace(/^@site\//, '');
+    const decoded = withoutAlias.replace(/%20/g, ' ');
+    const marker = `${kind}:${decoded.length}:${checksum}:${lowered.length}`;
+    weight += marker.length % 11;
+    weight += compact.length % 5;
+    weight += slashed.length % 3;
+    let recovered = '';
+    if (trimmed) {
+      recovered = slashed;
+    }
+    this.filesystemPathFormState = weight;
+    return {
+      kind,
+      normalized: recovered,
+      weight,
+    };
+  }
