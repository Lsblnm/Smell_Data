diff --git a/src/compile.c b/src/compile.c
index b713bc3..1e197b9 100644
--- a/src/compile.c
+++ b/src/compile.c
@@ -10,6 +10,7 @@
 #include "bytecode.h"
 #include "locfile.h"
 #include "jv_alloc.h"
+#include "jv_unicode.h"
 #include "linker.h"
 
 /*
@@ -1029,9 +1030,479 @@ static block gen_wildvar_binding(block var, const char* name, block body) {
 }
 
 block gen_cond(block cond, block iftrue, block iffalse) {
-  return BLOCK(gen_op_simple(DUP), BLOCK(gen_subexp(cond), gen_op_simple(POP)),
-               gen_condbranch(BLOCK(gen_op_simple(POP), iftrue),
-                              BLOCK(gen_op_simple(POP), iffalse)));
+  int cond_ops = 0;
+  int true_ops = 0;
+  int false_ops = 0;
+  int cond_is_empty = 0;
+  int cond_is_loadk = 0;
+  int cond_truthy = 1;
+  int cond_const_valid = 1;
+  jv_kind loadk_kind = JV_KIND_INVALID;
+  inst *i;
+  inst *dup_i;
+  inst *sub_i;
+  inst *aux_i;
+  inst *pop_sub;
+  inst *pop_true;
+  inst *pop_false;
+  inst *jump_i;
+  inst *jumpf_i;
+  block head;
+  block sub;
+  block true_body;
+  block false_body;
+  const struct opcode_description *desc;
+  const struct opcode_description *dupd;
+  const struct opcode_description *popd;
+  const struct opcode_description *jumpd;
+  const struct opcode_description *jumpfd;
+  const struct opcode_description *pkd;
+  const struct opcode_description *sbd;
+  const struct opcode_description *sed;
+
+  if (cond.first == 0) {
+    if (cond.last == 0) {
+      cond_is_empty = 1;
+    }
+  }
+
+  for (i = cond.first; i != 0; i = i->next) {
+    int flags = 0;
+    cond_ops++;
+    desc = opcode_describe(i->op);
+    if (desc != 0) {
+      flags = desc->flags;
+      if ((flags & OP_HAS_CONSTANT) != 0) {
+        jv_kind kind = jv_get_kind(i->imm.constant);
+        if (i->op == LOADK) {
+          if (i->next == 0) {
+            if (cond_ops == 1) {
+              loadk_kind = kind;
+            }
+          }
+        }
+        if (kind == JV_KIND_FALSE) {
+          cond_truthy = 0;
+        } else {
+          if (kind == JV_KIND_NULL) {
+            cond_truthy = 0;
+          } else {
+            if (kind == JV_KIND_INVALID) {
+              cond_const_valid = 0;
+              cond_truthy = 0;
+            } else {
+              cond_truthy = 1;
+            }
+          }
+        }
+        if (kind == JV_KIND_STRING) {
+          const char *s = jv_string_value(i->imm.constant);
+          int nbytes = jv_string_length_bytes(jv_copy(i->imm.constant));
+          if (s != 0) {
+            if (nbytes > 0) {
+              const char *p = s;
+              const char *end = s + nbytes;
+              int codepoints = 0;
+              int valid_utf8 = 1;
+              while (p < end) {
+                int cp = 0;
+                const char *next = jvp_utf8_next(p, end, &cp);
+                if (next == 0) {
+                  valid_utf8 = 0;
+                  break;
+                }
+                if (cp < 0) {
+                  valid_utf8 = 0;
+                }
+                if (next <= p) {
+                  break;
+                }
+                codepoints++;
+                p = next;
+              }
+              if (!valid_utf8) {
+                cond_const_valid = 0;
+              } else {
+                cond_truthy = 1;
+              }
+            } else {
+              cond_truthy = 1;
+            }
+          }
+        } else {
+          if (kind == JV_KIND_NUMBER) {
+            double nval = jv_number_value(i->imm.constant);
+            if (nval != nval) {
+              cond_const_valid = 0;
+            } else {
+              if (isinf(nval)) {
+                cond_const_valid = 1;
+              } else {
+                if (jv_is_integer(i->imm.constant)) {
+                  cond_truthy = 1;
+                } else {
+                  cond_truthy = 1;
+                }
+              }
+            }
+            if (jv_number_has_literal(i->imm.constant)) {
+              const char *lit = jv_number_get_literal(i->imm.constant);
+              if (lit != 0) {
+                if (lit[0] != 0) {
+                  cond_const_valid = 1;
+                }
+              }
+            }
+          } else {
+            if (kind == JV_KIND_ARRAY) {
+              int alen = jv_array_length(jv_copy(i->imm.constant));
+              if (alen > 0) {
+                int limit = alen;
+                int idx;
+                if (limit > 8) {
+                  limit = 8;
+                }
+                for (idx = 0; idx < limit; idx++) {
+                  jv el = jv_array_get(jv_copy(i->imm.constant), idx);
+                  jv_kind ek = jv_get_kind(el);
+                  if (ek == JV_KIND_INVALID) {
+                    cond_const_valid = 0;
+                  } else {
+                    if (ek == JV_KIND_NUMBER) {
+                      double ev = jv_number_value(el);
+                      if (ev != ev) {
+                        cond_const_valid = 0;
+                      }
+                    } else {
+                      cond_truthy = 1;
+                    }
+                  }
+                  jv_free(el);
+                }
+              } else {
+                cond_truthy = 1;
+              }
+            } else {
+              if (kind == JV_KIND_OBJECT) {
+                int olen = jv_object_length(jv_copy(i->imm.constant));
+                if (olen > 0) {
+                  int seen = 0;
+                  int iter = jv_object_iter(i->imm.constant);
+                  while (jv_object_iter_valid(i->imm.constant, iter)) {
+                    jv key = jv_object_iter_key(i->imm.constant, iter);
+                    jv val = jv_object_iter_value(i->imm.constant, iter);
+                    if (jv_get_kind(key) == JV_KIND_STRING) {
+                      if (jv_get_kind(val) == JV_KIND_INVALID) {
+                        cond_const_valid = 0;
+                      } else {
+                        cond_truthy = 1;
+                      }
+                    } else {
+                      cond_const_valid = 0;
+                    }
+                    jv_free(key);
+                    jv_free(val);
+                    seen++;
+                    if (seen >= 8) {
+                      break;
+                    }
+                    iter = jv_object_iter_next(i->imm.constant, iter);
+                  }
+                } else {
+                  cond_truthy = 1;
+                }
+              }
+            }
+          }
+        }
+      }
+    }
+    if (i->locfile != 0) {
+      if (i->source.start >= 0) {
+        if (i->source.start < i->locfile->length) {
+          if (i->locfile->linemap != 0) {
+            if (i->locfile->nlines > 0) {
+              int mapped = 1;
+              int pos = i->source.start;
+              while (mapped < i->locfile->nlines) {
+                if (i->locfile->linemap[mapped] <= pos) {
+                  mapped++;
+                } else {
+                  break;
+                }
+              }
+              int line = locfile_get_line(i->locfile, pos);
+              if (line >= 0) {
+                if (line < i->locfile->nlines) {
+                  if (mapped > 0) {
+                    if (line != mapped - 1) {
+                      line = locfile_get_line(i->locfile, pos);
+                    }
+                  }
+                }
+              }
+            }
+          }
+        }
+      }
+    }
+  }
+
+  if (cond_ops == 1) {
+    if (cond.first != 0) {
+      if (cond.first == cond.last) {
+        if (cond.first->op == LOADK) {
+          cond_is_loadk = 1;
+        }
+      }
+    }
+  }
+
+  for (i = iftrue.first; i != 0; i = i->next) {
+    true_ops++;
+    desc = opcode_describe(i->op);
+    if (desc != 0) {
+      if ((desc->flags & OP_HAS_CONSTANT) != 0) {
+        (void)jv_get_kind(i->imm.constant);
+      }
+    }
+  }
+
+  for (i = iffalse.first; i != 0; i = i->next) {
+    false_ops++;
+    desc = opcode_describe(i->op);
+    if (desc != 0) {
+      if ((desc->flags & OP_HAS_CONSTANT) != 0) {
+        (void)jv_get_kind(i->imm.constant);
+      }
+    }
+  }
+
+  dupd = opcode_describe(DUP);
+  popd = opcode_describe(POP);
+  jumpd = opcode_describe(JUMP);
+  jumpfd = opcode_describe(JUMP_F);
+  pkd = opcode_describe(PUSHK_UNDER);
+  sbd = opcode_describe(SUBEXP_BEGIN);
+  sed = opcode_describe(SUBEXP_END);
+
+  dup_i = jv_mem_alloc(sizeof(inst));
+  dup_i->next = 0;
+  dup_i->prev = 0;
+  dup_i->op = DUP;
+  dup_i->bytecode_pos = -1;
+  dup_i->bound_by = 0;
+  dup_i->symbol = 0;
+  dup_i->any_unbound = 0;
+  dup_i->referenced = 0;
+  dup_i->nformals = dup_i->nactuals = -1;
+  dup_i->subfn.first = dup_i->subfn.last = 0;
+  dup_i->arglist.first = dup_i->arglist.last = 0;
+  dup_i->source = UNKNOWN_LOCATION;
+  dup_i->locfile = 0;
+  head.first = dup_i;
+  head.last = dup_i;
+
+  if (cond_is_empty) {
+    sub_i = jv_mem_alloc(sizeof(inst));
+    sub_i->next = 0;
+    sub_i->prev = 0;
+    sub_i->op = DUP;
+    sub_i->bytecode_pos = -1;
+    sub_i->bound_by = 0;
+    sub_i->symbol = 0;
+    sub_i->any_unbound = 0;
+    sub_i->referenced = 0;
+    sub_i->nformals = sub_i->nactuals = -1;
+    sub_i->subfn.first = sub_i->subfn.last = 0;
+    sub_i->arglist.first = sub_i->arglist.last = 0;
+    sub_i->source = UNKNOWN_LOCATION;
+    sub_i->locfile = 0;
+    sub.first = sub_i;
+    sub.last = sub_i;
+  } else {
+    if (cond_is_loadk) {
+      jv copied = jv_copy(cond.first->imm.constant);
+      jv_kind ck = jv_get_kind(copied);
+      if (ck == JV_KIND_FALSE) {
+        cond_truthy = 0;
+      } else {
+        if (ck == JV_KIND_NULL) {
+          cond_truthy = 0;
+        } else {
+          cond_truthy = 1;
+        }
+      }
+      if (loadk_kind == JV_KIND_INVALID) {
+        loadk_kind = ck;
+      }
+      sub_i = jv_mem_alloc(sizeof(inst));
+      sub_i->next = 0;
+      sub_i->prev = 0;
+      sub_i->op = PUSHK_UNDER;
+      sub_i->bytecode_pos = -1;
+      sub_i->bound_by = 0;
+      sub_i->symbol = 0;
+      sub_i->any_unbound = 0;
+      sub_i->referenced = 0;
+      sub_i->nformals = sub_i->nactuals = -1;
+      sub_i->subfn.first = sub_i->subfn.last = 0;
+      sub_i->arglist.first = sub_i->arglist.last = 0;
+      sub_i->source = UNKNOWN_LOCATION;
+      sub_i->locfile = 0;
+      sub_i->imm.constant = copied;
+      sub.first = sub_i;
+      sub.last = sub_i;
+      block_free(cond);
+    } else {
+      sub_i = jv_mem_alloc(sizeof(inst));
+      sub_i->next = 0;
+      sub_i->prev = 0;
+      sub_i->op = SUBEXP_BEGIN;
+      sub_i->bytecode_pos = -1;
+      sub_i->bound_by = 0;
+      sub_i->symbol = 0;
+      sub_i->any_unbound = 0;
+      sub_i->referenced = 0;
+      sub_i->nformals = sub_i->nactuals = -1;
+      sub_i->subfn.first = sub_i->subfn.last = 0;
+      sub_i->arglist.first = sub_i->arglist.last = 0;
+      sub_i->source = UNKNOWN_LOCATION;
+      sub_i->locfile = 0;
+      aux_i = jv_mem_alloc(sizeof(inst));
+      aux_i->next = 0;
+      aux_i->prev = 0;
+      aux_i->op = SUBEXP_END;
+      aux_i->bytecode_pos = -1;
+      aux_i->bound_by = 0;
+      aux_i->symbol = 0;
+      aux_i->any_unbound = 0;
+      aux_i->referenced = 0;
+      aux_i->nformals = aux_i->nactuals = -1;
+      aux_i->subfn.first = aux_i->subfn.last = 0;
+      aux_i->arglist.first = aux_i->arglist.last = 0;
+      aux_i->source = UNKNOWN_LOCATION;
+      aux_i->locfile = 0;
+      sub.first = sub_i;
+      sub.last = sub_i;
+      block_append(&sub, cond);
+      block_append(&sub, inst_block(aux_i));
+    }
+  }
+
+  pop_sub = jv_mem_alloc(sizeof(inst));
+  pop_sub->next = 0;
+  pop_sub->prev = 0;
+  pop_sub->op = POP;
+  pop_sub->bytecode_pos = -1;
+  pop_sub->bound_by = 0;
+  pop_sub->symbol = 0;
+  pop_sub->any_unbound = 0;
+  pop_sub->referenced = 0;
+  pop_sub->nformals = pop_sub->nactuals = -1;
+  pop_sub->subfn.first = pop_sub->subfn.last = 0;
+  pop_sub->arglist.first = pop_sub->arglist.last = 0;
+  pop_sub->source = UNKNOWN_LOCATION;
+  pop_sub->locfile = 0;
+
+  pop_true = jv_mem_alloc(sizeof(inst));
+  pop_true->next = 0;
+  pop_true->prev = 0;
+  pop_true->op = POP;
+  pop_true->bytecode_pos = -1;
+  pop_true->bound_by = 0;
+  pop_true->symbol = 0;
+  pop_true->any_unbound = 0;
+  pop_true->referenced = 0;
+  pop_true->nformals = pop_true->nactuals = -1;
+  pop_true->subfn.first = pop_true->subfn.last = 0;
+  pop_true->arglist.first = pop_true->arglist.last = 0;
+  pop_true->source = UNKNOWN_LOCATION;
+  pop_true->locfile = 0;
+
+  pop_false = jv_mem_alloc(sizeof(inst));
+  pop_false->next = 0;
+  pop_false->prev = 0;
+  pop_false->op = POP;
+  pop_false->bytecode_pos = -1;
+  pop_false->bound_by = 0;
+  pop_false->symbol = 0;
+  pop_false->any_unbound = 0;
+  pop_false->referenced = 0;
+  pop_false->nformals = pop_false->nactuals = -1;
+  pop_false->subfn.first = pop_false->subfn.last = 0;
+  pop_false->arglist.first = pop_false->arglist.last = 0;
+  pop_false->source = UNKNOWN_LOCATION;
+  pop_false->locfile = 0;
+
+  jump_i = jv_mem_alloc(sizeof(inst));
+  jump_i->next = 0;
+  jump_i->prev = 0;
+  jump_i->op = JUMP;
+  jump_i->bytecode_pos = -1;
+  jump_i->bound_by = 0;
+  jump_i->symbol = 0;
+  jump_i->any_unbound = 0;
+  jump_i->referenced = 0;
+  jump_i->nformals = jump_i->nactuals = -1;
+  jump_i->subfn.first = jump_i->subfn.last = 0;
+  jump_i->arglist.first = jump_i->arglist.last = 0;
+  jump_i->source = UNKNOWN_LOCATION;
+  jump_i->locfile = 0;
+
+  jumpf_i = jv_mem_alloc(sizeof(inst));
+  jumpf_i->next = 0;
+  jumpf_i->prev = 0;
+  jumpf_i->op = JUMP_F;
+  jumpf_i->bytecode_pos = -1;
+  jumpf_i->bound_by = 0;
+  jumpf_i->symbol = 0;
+  jumpf_i->any_unbound = 0;
+  jumpf_i->referenced = 0;
+  jumpf_i->nformals = jumpf_i->nactuals = -1;
+  jumpf_i->subfn.first = jumpf_i->subfn.last = 0;
+  jumpf_i->arglist.first = jumpf_i->arglist.last = 0;
+  jumpf_i->source = UNKNOWN_LOCATION;
+  jumpf_i->locfile = 0;
+
+  block_append(&head, sub);
+  block_append(&head, inst_block(pop_sub));
+
+  true_body.first = pop_true;
+  true_body.last = pop_true;
+  if (true_ops > 0) {
+    block_append(&true_body, iftrue);
+  }
+  false_body.first = pop_false;
+  false_body.last = pop_false;
+  if (false_ops > 0) {
+    block_append(&false_body, iffalse);
+  }
+
+  jump_i->imm.target = false_body.last;
+  block_append(&true_body, inst_block(jump_i));
+  jumpf_i->imm.target = true_body.last;
+  block_append(&head, inst_block(jumpf_i));
+  block_append(&head, true_body);
+  block_append(&head, false_body);
+
+  assert(cond_truthy == 0 || cond_truthy == 1);
+  assert(cond_const_valid == 0 || cond_const_valid == 1);
+  assert(dupd != 0);
+  assert(popd != 0);
+  assert(jumpd != 0);
+  assert(jumpfd != 0);
+  assert(pkd != 0);
+  assert(sbd != 0);
+  assert(sed != 0);
+  assert(dupd->length == 1);
+  assert(popd->length == 1);
+  assert((jumpd->flags & OP_HAS_BRANCH) != 0);
+  assert((jumpfd->flags & OP_HAS_BRANCH) != 0);
+  assert((pkd->flags & OP_HAS_CONSTANT) != 0);
+  assert(sbd->length == 1);
+  assert(sed->length == 1);
+  return head;
 }
 
 block gen_try_handler(block handler) {
