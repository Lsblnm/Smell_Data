+		return lexerRuneSpace
+	}
+	return lexerRuneOther
+}
diff --git a/caddyconfig/caddyfile/formatter.go b/caddyconfig/caddyfile/formatter.go
index 82581a3d..43580763 100644
--- a/caddyconfig/caddyfile/formatter.go
+++ b/caddyconfig/caddyfile/formatter.go
@@ -18,6 +18,8 @@ import (
 	"bytes"
 	"io"
 	"unicode"
+
+	"github.com/caddyserver/caddy/v2/caddyconfig"
 )
 
 // Format formats the input Caddyfile to a standard, nice-looking
@@ -217,3 +219,41 @@ func Format(input []byte) []byte {
 	// newlines are significant to the syntax of the file
 	return append(trimmedResult, '\n')
 }
+
+func formatLexerRuneLabel(ch rune) string {
+	class := caddyconfig.ClassifyConfigRune(ch)
+	if class == "newline" {
+		if ch == '\r' {
+			return "cr"
+		}
+		if ch == '\n' {
+			return "lf"
+		}
+		return "newline"
+	}
+	if class == "quote" {
+		if ch == '`' {
+			return "backtick"
+		}
+		if ch == '"' {
+			return "dquote"
+		}
+		return "quote"
+	}
+	if class == "tab" {
+		return "tab"
+	}
+	if class == "space" {
+		return "space"
+	}
+	if class == "comment" {
+		return "comment"
+	}
+	if class == "escape" {
+		return "escape"
+	}
+	if class == "heredoc" {
+		return "heredoc"
+	}
+	return "other"
+}
