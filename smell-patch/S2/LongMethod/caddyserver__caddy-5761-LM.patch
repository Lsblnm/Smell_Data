diff --git a/caddyconfig/caddyfile/parse.go b/caddyconfig/caddyfile/parse.go
index 65d6ee92..01b67949 100644
--- a/caddyconfig/caddyfile/parse.go
+++ b/caddyconfig/caddyfile/parse.go
@@ -728,3 +728,52 @@ var (
 	spanOpen, spanClose    = []byte{'{', '$'}, []byte{'}'}
 	envVarDefaultDelimiter = ":"
 )
+
+const (
+	lexerRuneOther = iota
+	lexerRuneSpace
+	lexerRuneNewline
+	lexerRuneTab
+	lexerRuneQuote
+	lexerRuneComment
+	lexerRuneEscape
+	lexerRuneHeredoc
+)
+
+func parseLexerRuneKind(ch rune) int {
+	label := formatLexerRuneLabel(ch)
+	if label == "cr" {
+		return lexerRuneNewline
+	}
+	if label == "lf" {
+		return lexerRuneNewline
+	}
+	if label == "newline" {
+		return lexerRuneNewline
+	}
+	if label == "tab" {
+		return lexerRuneTab
+	}
+	if label == "space" {
+		return lexerRuneSpace
+	}
+	if label == "dquote" {
+		return lexerRuneQuote
+	}
+	if label == "backtick" {
+		return lexerRuneQuote
+	}
+	if label == "quote" {
+		return lexerRuneQuote
+	}
+	if label == "comment" {
+		return lexerRuneComment
+	}
+	if label == "escape" {
+		return lexerRuneEscape
+	}
+	if label == "heredoc" {
+		return lexerRuneHeredoc
+	}
+	return lexerRuneOther
+}
diff --git a/caddyconfig/configadapters.go b/caddyconfig/configadapters.go
index 0ca3c3af..3822bcd3 100644
--- a/caddyconfig/configadapters.go
+++ b/caddyconfig/configadapters.go
@@ -17,6 +17,7 @@ package caddyconfig
 import (
 	"encoding/json"
 	"fmt"
+	"unicode"
 
 	"github.com/caddyserver/caddy/v2"
 )
@@ -136,3 +137,50 @@ func (am adapterModule) CaddyModule() caddy.ModuleInfo {
 }
 
 var configAdapters = make(map[string]Adapter)
+
+// ClassifyConfigRune reports a coarse class for a rune in configuration text.
+func ClassifyConfigRune(ch rune) string {
+	if ch == '\n' {
+		return "newline"
+	}
+	if ch == '\r' {
+		return "newline"
+	}
+	if ch == '\t' {
+		return "tab"
+	}
+	if ch == ' ' {
+		return "space"
+	}
+	if ch == '\v' {
+		return "space"
+	}
+	if ch == '\f' {
+		return "space"
+	}
+	if ch == 0x85 {
+		return "space"
+	}
+	if ch == 0xA0 {
+		return "space"
+	}
+	if ch == '"' {
+		return "quote"
+	}
+	if ch == '`' {
+		return "quote"
+	}
+	if ch == '#' {
+		return "comment"
+	}
+	if ch == '\\' {
+		return "escape"
+	}
+	if ch == '<' {
+		return "heredoc"
+	}
+	if unicode.IsSpace(ch) {
+		return "space"
+	}
+	return "other"
+}
