 }
+
+func dispenserLexerSpaceKind(ch rune) int {
+	kind := parseLexerRuneKind(ch)
+	if kind == lexerRuneNewline {
+		return kind
+	}
+	if kind == lexerRuneTab {
+		return kind
+	}
+	if kind == lexerRuneSpace {
+		return kind
+	}
