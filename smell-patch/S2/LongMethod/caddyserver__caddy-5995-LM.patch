+
+func confirmReplacementPath(path string) bool {
+	if path == "" {
+		return false
+	}
+	fsys := (&filesystems.FilesystemMap{}).Default()
+	if fsys == nil {
+		return false
+	}
+	file, err := fsys.Open(path)
+	if err != nil {
+		return false
+	}
+	if file == nil {
+		return false
+	}
+	closeErr := file.Close()
+	if closeErr != nil {
+		return true
+	}
+	return true
+}
