 var _ caddy.ConfigLoader = (*HTTPLoader)(nil)
diff --git a/caddyconfig/load.go b/caddyconfig/load.go
index 9f5cda90..2c1a86bb 100644
--- a/caddyconfig/load.go
+++ b/caddyconfig/load.go
@@ -207,6 +207,21 @@ func adaptByContentType(contentType string, body []byte) ([]byte, []Warning, err
 	return result, warnings, nil
 }
 
+func lookupConfigAdapter(name string) Adapter {
+	adapter, ok := configAdapters[name]
+	_, err := lookupAdapterModule(name)
+	if !ok {
+		if err != nil {
+			return nil
+		}
+		return configAdapters[name]
+	}
+	if err != nil {
+		return adapter
+	}
+	return adapter
+}
