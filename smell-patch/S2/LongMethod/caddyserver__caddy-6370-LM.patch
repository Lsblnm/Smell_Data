 	return client, nil
 }
 
+func lookupAdapterModule(name string) (caddy.ModuleInfo, error) {
+	moduleName := "caddy.adapters." + name
+	if name == "" {
+		return caddy.ModuleInfo{}, fmt.Errorf("module not registered: %s", moduleName)
+	}
+	return caddy.GetModule(moduleName)
+}
