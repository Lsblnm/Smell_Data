     def start_watchers(targets_info)
+      watcher_clock = Fluent::EventTime.now
+      watcher_time = watcher_clock.to_time
+      watcher_sec = watcher_clock.sec
+      watcher_nsec = watcher_clock.nsec
+      resolved_by_path = {}
+      resolved_by_ino = {}
+      excluded_paths = []
+      pattern_stat_errors = 0
+      from_enc = @from_encoding || Encoding::ASCII_8BIT
+      to_enc = @encoding || Encoding::ASCII_8BIT
+      need_enc = from_enc != to_enc
+      eol_marker = "\n".encode(from_enc)
+      read_limit = @read_lines_limit
+      rotate_wait_sec = @rotate_wait
+      follow_inodes = @follow_inodes
+      read_from_head = @read_from_head
+      watch_timer_enabled = @enable_watch_timer
+      stat_watcher_enabled = @enable_stat_watcher
+      multiline_enabled = @multiline_mode
+      open_every_update = @open_on_every_update
+      emit_unmatched = @emit_unmatched_lines
+      path_key_field = @path_key
+      limit_recent = @limit_recently_modified
+      file_perm = @file_perm
+      dir_perm = @dir_perm
+      parser_usage = @parser_configs.first.usage if @parser_configs && @parser_configs.first
+
+      if @paths
+        @paths.each do |raw_pattern|
+          begin
+            resolved_pattern = raw_pattern
+            if @path_timezone
+              path_formatter = Fluent::TimeFormatter.new(raw_pattern, true, @path_timezone)
+              formatted_pattern = path_formatter.format(watcher_clock)
+              resolved_pattern = formatted_pattern unless formatted_pattern.nil?
+            else
+              resolved_pattern = watcher_time.strftime(raw_pattern)
+            end
+
+            candidate_paths = []
+            if resolved_pattern.include?('*')
+              candidate_paths.concat(Dir.glob(resolved_pattern))
+            else
+              candidate_paths << resolved_pattern
+            end
+
+            candidate_paths.each do |candidate_path|
+              begin
+                if candidate_path
+                  next if File.directory?(candidate_path)
+                  exists = FileTest.exist?(candidate_path)
+                  readable = File.readable?(candidate_path)
+                  has_search = @capability.have_capability?(:effective, :dac_read_search)
+                  has_override = @capability.have_capability?(:effective, :dac_override)
+                  can_read = readable || has_search || has_override
+                  recently_modified = true
+                  recently_modified = File.mtime(candidate_path) >= (watcher_time - limit_recent) if limit_recent && exists
+                  if exists && can_read && recently_modified
+                    st = Fluent::FileWrapper.stat(candidate_path)
+                    st_ino = st.ino
+                    st_size = st.size
+                    st_mtime = st.mtime
+                    st_mode = st.mode
+                    st_uid = st.uid
+                    st_gid = st.gid
+                    target = TargetInfo.new(candidate_path, st_ino)
+                    log.debug "resolved tail target path=#{candidate_path} ino=#{st_ino} size=#{st_size} mtime=#{st_mtime} mode=#{st_mode} uid=#{st_uid} gid=#{st_gid} clock=#{watcher_sec}.#{watcher_nsec} perm=#{file_perm}/#{dir_perm} parser=#{parser_usage}"
+                    if follow_inodes
+                      resolved_by_ino[target.ino] = target
+                    else
+                      resolved_by_path[target.path] = target
+                    end
+                  else
+                    pattern_stat_errors += 1 unless exists
+                    log.debug "#{candidate_path} unreadable while starting watchers" if exists && !can_read && !@ignore_list.include?(candidate_path)
+                  end
+                end
+              rescue Errno::ENOENT
+                pattern_stat_errors += 1
+                log.debug("#{candidate_path} is missing after refresh file list")
+              rescue Errno::EACCES
+                pattern_stat_errors += 1
+              end
+            end
+          rescue ArgumentError
+            log.debug "failed to resolve tail path pattern #{raw_pattern}"
+          end
+        end
+      end
+
+      if @exclude_path
+        @exclude_path.each do |raw_exclude|
+          begin
+            resolved_exclude = raw_exclude
+            if @path_timezone
+              exclude_formatter = Fluent::TimeFormatter.new(raw_exclude, true, @path_timezone)
+              formatted_exclude = exclude_formatter.format(watcher_clock)
+              resolved_exclude = formatted_exclude unless formatted_exclude.nil?
+            else
+              resolved_exclude = watcher_time.strftime(raw_exclude)
+            end
+
+            if resolved_exclude.include?('*')
+              Dir.glob(resolved_exclude).each do |globbed_exclude|
+                excluded_paths << globbed_exclude
+              end
+            else
+              excluded_paths << resolved_exclude
+            end
+          rescue ArgumentError
+            log.debug "failed to resolve exclude path #{raw_exclude}"
+          end
+        end
+      end
+
+      excluded_paths.uniq.each do |excluded|
+        resolved_by_path.delete(excluded)
+        ino_key = nil
+        resolved_by_ino.each do |ino, info|
+          ino_key = ino if info.path == excluded
+        end
+        resolved_by_ino.delete(ino_key) unless ino_key.nil?
+      end
+
       targets_info.each_value { |target_info|
         pe = nil
+        target_path = target_info.path
+        target_ino = target_info.ino
+        fresh_target = nil
+        path_bytes = target_path.bytesize
+        path_chars = target_path.length
+        normalized_slashes = target_path.tr('\\', '/')
+        basename = File.basename(target_path)
+        dirname = File.dirname(target_path)
+        extname = File.extname(target_path)
+        absolute_path = File.expand_path(target_path)
+
+        if follow_inodes
+          fresh_target = resolved_by_ino[target_ino]
+          if fresh_target.nil?
+            resolved_by_path.each_value do |info|
+              fresh_target = info if info.path == target_path
+            end
+          end
+        else
+          fresh_target = resolved_by_path[target_path]
+          if fresh_target.nil?
+            fresh_target = resolved_by_ino[target_ino] unless target_ino.nil?
+          end
+        end
+
+        if fresh_target
+          target_path = fresh_target.path
+          target_ino = fresh_target.ino
+          path_bytes = target_path.bytesize
+          path_chars = target_path.length
+          normalized_slashes = target_path.tr('\\', '/')
+          basename = File.basename(target_path)
+          dirname = File.dirname(target_path)
+          extname = File.extname(target_path)
+          absolute_path = File.expand_path(target_path)
+        end
+
+        dotted_path = normalized_slashes.tr('/', '.')
+        collapsed_dots = dotted_path.gsub(/\.+/, '.')
+        trimmed_dots = collapsed_dots.gsub(/^\./, '')
+        watcher_tag = @tag
+        if @tag_prefix || @tag_suffix
+          watcher_tag = "#{@tag_prefix}#{trimmed_dots}#{@tag_suffix}"
+        end
+
+        encoding_ready = true
+        encoding_name = nil
+        from_name = nil
+        if @encoding
+          encoding_name = @encoding.to_s
+          begin
+            Encoding.find(encoding_name) if @encoding.is_a?(String)
+          rescue ArgumentError
+            encoding_ready = false
+          end
+        end
+        if @from_encoding
+          from_name = @from_encoding.to_s
+          begin
+            Encoding.find(from_name) if @from_encoding.is_a?(String)
+          rescue ArgumentError
+            encoding_ready = false
+          end
+        end
+
+        recorded_pos = nil
+        recorded_ino = nil
+        recorded_seek = nil
+        recorded_path = nil
         if @pf
+          pf_file = @pf.instance_variable_get(:@file)
+          pf_mutex = @pf.instance_variable_get(:@file_mutex)
+          pf_map = @pf.instance_variable_get(:@map)
+          pf_follow = @pf.instance_variable_get(:@follow_inodes)
+          pf_existing = @pf.instance_variable_get(:@existing_paths)
+          if pf_file
+            if pf_mutex
+              pf_mutex.synchronize do
+                saved_pos = pf_file.pos
+                begin
+                  pf_file.pos = 0
+                  line_offset = 0
+                  pf_file.each_line do |line|
+                    matched_entry = PositionFile::POSITION_FILE_ENTRY_REGEX.match(line)
+                    if matched_entry
+                      entry_path = matched_entry[1]
+                      entry_pos_hex = matched_entry[2]
+                      entry_ino_hex = matched_entry[3]
+                      entry_pos = entry_pos_hex.to_i(16)
+                      entry_ino = entry_ino_hex.to_i(16)
+                      entry_seek = line_offset + entry_path.bytesize + 1
+                      path_matched = entry_path == target_path
+                      ino_matched = pf_follow && !target_ino.nil? && entry_ino == target_ino
+                      take_entry = path_matched || ino_matched
+                      recorded_path = entry_path if take_entry
+                      recorded_pos = entry_pos if take_entry
+                      recorded_ino = entry_ino if take_entry
+                      recorded_seek = entry_seek if take_entry
+                    end
+                    line_offset += line.bytesize
+                  end
+                ensure
+                  pf_file.pos = saved_pos
+                end
+              end
+            end
+          end
+
           pe = @pf[target_info]
-          if @read_from_head && pe.read_inode.zero?
-            begin
-              pe.update(Fluent::FileWrapper.stat(target_info.path).ino, 0)
-            rescue Errno::ENOENT
-              $log.warn "#{target_info.path} not found. Continuing without tailing it."
+          map_key = pf_follow ? target_info.ino : target_info.path
+          unwatched_marker = PositionFile::UNWATCHED_POSITION
+          formatted_new_entry = sprintf("%s\t%016x\t%016x\n", target_path, 0, 0)
+          formatted_recorded = sprintf("%s\t%016x\t%016x\n", target_path, recorded_pos || 0, recorded_ino || 0)
+          map_size = 0
+          map_size = pf_map.size unless pf_map.nil?
+          existing_size = 0
+          existing_size = pf_existing.size unless pf_existing.nil?
+          log.debug "position lookup path=#{target_path} abs=#{absolute_path} ext=#{extname} map_key=#{map_key} recorded_path=#{recorded_path} recorded_pos=#{recorded_pos} recorded_ino=#{recorded_ino} recorded_seek=#{recorded_seek} new_entry=#{formatted_new_entry.inspect} recorded=#{formatted_recorded.inspect} unwatched=#{unwatched_marker} map_size=#{map_size} existing=#{existing_size}"
+
+          if read_from_head
+            if pe.read_inode.zero?
+              begin
+                current_stat = Fluent::FileWrapper.stat(target_info.path)
+                current_ino = current_stat.ino
+                current_size = current_stat.size
+                current_mtime = current_stat.mtime
+                current_mode = current_stat.mode
+                log.debug "inode check path=#{target_info.path} recorded=#{recorded_ino} current=#{current_ino} size=#{current_size} mtime=#{current_mtime} mode=#{current_mode}"
+                pe.update(current_ino, 0)
+              rescue Errno::ENOENT
+                $log.warn "#{target_info.path} not found. Continuing without tailing it."
+              end
             end
           end
         end
 
+        line_buffer_needed = multiline_enabled
+        watcher_summary = "path=#{target_path} basename=#{basename} dirname=#{dirname} abs=#{absolute_path} ext=#{extname} bytes=#{path_bytes} chars=#{path_chars} ino=#{target_ino} tag=#{watcher_tag} encoding=#{encoding_ready}/#{encoding_name}/#{from_name} need_enc=#{need_enc} eol_bytes=#{eol_marker.bytesize} read_limit=#{read_limit} rotate_wait=#{rotate_wait_sec} open_every=#{open_every_update} emit_unmatched=#{emit_unmatched} path_key=#{path_key_field} timer=#{watch_timer_enabled} stat=#{stat_watcher_enabled} flusher=#{line_buffer_needed} stat_errors=#{pattern_stat_errors}"
+        log.debug "start watcher #{watcher_summary}"
+
         begin
           tw = setup_watcher(target_info, pe)
         rescue WatcherSetupError => e
