+      def hex_chunk_id(chunk_id)
+        found = nil
+        synchronize do
+          if @dequeued
+            found = @dequeued[chunk_id]
+          end
+          if found.nil?
+            if @queue
+              @queue.each do |queued_chunk|
+                if queued_chunk && queued_chunk.unique_id == chunk_id
+                  found = queued_chunk
+                  break
+                end
+              end
+            end
+          end
+          if found.nil?
+            if @stage
+              @stage.each_value do |staged_chunk|
+                if staged_chunk && staged_chunk.unique_id == chunk_id
+                  found = staged_chunk
+                  break
+                end
+              end
+            end
+          end
+        end
+        if found
+          found.hex_id
+        else
+          Fluent::Plugin::Buffer::Chunk.hex_id(chunk_id)
+        end
+      end
+
       def queued?(metadata = nil, optimistic: false)
         if optimistic
           optimistic_queued?(metadata)
