diff --git a/packages/compiler-sfc/src/style/pluginTrim.ts b/packages/compiler-sfc/src/style/pluginTrim.ts
index ab5283438..434508d5f 100644
--- a/packages/compiler-sfc/src/style/pluginTrim.ts
+++ b/packages/compiler-sfc/src/style/pluginTrim.ts
@@ -1,11 +1,49 @@
 import type { PluginCreator } from 'postcss'
+import { warn } from '../warn'
+
+export function isBlankCombinatorValue(value: string | undefined): boolean {
+  if (value == null) {
+    return false
+  }
+  if (typeof value !== 'string') {
+    return false
+  }
+  if (value.length === 0) {
+    return false
+  }
+  return /^\s+$/.test(value)
+}
+
+export function shouldNormalizeStyleNode(type: string): boolean {
+  if (type === 'rule') {
+    return true
+  }
+  if (type === 'atrule') {
+    return true
+  }
+  return false
+}
+
+export function noteDeprecatedDeepCombinator(): void {
+  warn(
+    `the >>> and /deep/ combinators have been deprecated. ` +
+      `Use :deep() instead.`,
+  )
+}
+
+export function noteDeprecatedDeepUsage(value: string): void {
+  warn(
+    `${value} usage as a combinator has been deprecated. ` +
+      `Use :deep(<inner-selector>) instead of ${value} <inner-selector>.`,
+  )
+}
 
 const trimPlugin: PluginCreator<{}> = () => {
   return {
     postcssPlugin: 'vue-sfc-trim',
     Once(root) {
       root.walk(({ type, raws }) => {
-        if (type === 'rule' || type === 'atrule') {
+        if (shouldNormalizeStyleNode(type)) {
           if (raws.before) raws.before = '\n'
           if ('after' in raws && raws.after) raws.after = '\n'
         }
