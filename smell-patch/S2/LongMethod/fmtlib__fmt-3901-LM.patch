+inline auto grouped_int_is_decimal(presentation_type type) -> bool {
+  return type == presentation_type::none || type == presentation_type::dec;
+}
+inline auto grouped_int_is_hex(presentation_type type) -> bool {
+  return type == presentation_type::hex;
+}
+inline auto grouped_int_is_oct(presentation_type type) -> bool {
+  return type == presentation_type::oct;
+}
+inline auto grouped_int_is_bin(presentation_type type) -> bool {
+  return type == presentation_type::bin;
+}
+inline auto grouped_int_is_char(presentation_type type) -> bool {
+  return type == presentation_type::chr;
+}
+inline auto grouped_int_prefix_size(unsigned prefix) -> unsigned {
+  return prefix != 0 ? prefix >> 24 : 0;
+}
+inline auto grouped_int_prefix_chars(unsigned prefix) -> unsigned {
+  return prefix & 0xffffffu;
+}
