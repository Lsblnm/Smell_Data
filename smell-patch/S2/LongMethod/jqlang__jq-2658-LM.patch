diff --git a/src/jv_parse.c b/src/jv_parse.c
index e91f65d..e6fecbe 100644
--- a/src/jv_parse.c
+++ b/src/jv_parse.c
@@ -872,5 +872,309 @@ jv jv_parse_sized(const char* string, int length) {
 }
 
 jv jv_parse(const char* string) {
-  return jv_parse_sized(string, strlen(string));
+  int length = (int)strlen(string);
+  struct jv_parser parser;
+  struct jv_parser* p = &parser;
+  jv parsed = jv_invalid();
+  jv extra;
+  presult msg = 0;
+  presult answer = 0;
+  presult litmsg = 0;
+  presult tokmsg = 0;
+  presult vmsg = 0;
+  presult str_err = 0;
+  char ch = 0;
+  chclass cls;
+  char* in;
+  char* outp;
+  char* end;
+  char esc;
+  int hexvalue;
+  unsigned long codepoint;
+  unsigned long surrogate = 0;
+  const char* buf = string;
+  int remaining = length;
+
+  p->flags = 0;
+  p->path = jv_invalid();
+  p->stack = 0;
+  p->stacklen = 0;
+  p->stackpos = 0;
+  p->last_seen = JV_LAST_NONE;
+  p->output = jv_invalid();
+  p->next = jv_invalid();
+  p->tokenbuf = 0;
+  p->tokenlen = 0;
+  p->tokenpos = 0;
+  p->st = JV_PARSER_NORMAL;
+  p->eof = 0;
+  p->curr_buf = 0;
+  p->curr_buf_length = 0;
+  p->curr_buf_pos = 0;
+  p->curr_buf_is_partial = 0;
+  p->bom_strip_position = 0;
+  p->last_ch_was_ws = 0;
+  p->line = 1;
+  p->column = 0;
+  jvp_dtoa_context_init(&p->dtoa);
+
+  while (remaining > 0 && p->bom_strip_position < sizeof(UTF8_BOM)) {
+    if ((unsigned char)*buf == UTF8_BOM[p->bom_strip_position]) {
+      buf++;
+      remaining--;
+      p->bom_strip_position++;
+    } else if (p->bom_strip_position == 0) {
+      p->bom_strip_position = sizeof(UTF8_BOM);
+    } else {
+      p->bom_strip_position = 0xff;
+    }
+  }
+  p->curr_buf = buf;
+  p->curr_buf_length = remaining;
+  p->curr_buf_pos = 0;
+  p->curr_buf_is_partial = 0;
+
+  if (p->bom_strip_position == 0xff) {
+    parsed = jv_invalid_with_msg(jv_string("Malformed BOM"));
+    goto finish_parse;
+  }
+
+  while (!msg && p->curr_buf_pos < p->curr_buf_length) {
+    ch = p->curr_buf[p->curr_buf_pos++];
+    p->column++;
+    if (ch == '\n') {
+      p->line++;
+      p->column = 0;
+    }
+    if (ch == '\036') {
+      litmsg = check_literal(p);
+      if (litmsg) {
+        msg = litmsg;
+      } else if (p->st == JV_PARSER_NORMAL && parse_check_done(p, &parsed)) {
+        msg = OK;
+      } else {
+        assert(!jv_is_valid(parsed));
+        parser_reset(p);
+        jv_free(parsed);
+        parsed = jv_invalid();
+        msg = OK;
+      }
+      continue;
+    }
+
+    answer = 0;
+    p->last_ch_was_ws = 0;
+    if (p->st == JV_PARSER_NORMAL) {
+      cls = classify(ch);
+      if (cls == WHITESPACE)
+        p->last_ch_was_ws = 1;
+      if (cls != LITERAL) {
+        litmsg = check_literal(p);
+        if (litmsg) {
+          msg = litmsg;
+        } else if (parse_check_done(p, &parsed)) {
+          answer = OK;
+        }
+      }
+      if (!msg) {
+        switch (cls) {
+        case LITERAL:
+          assert(p->tokenpos <= p->tokenlen);
+          if (p->tokenpos >= (p->tokenlen - 1)) {
+            p->tokenlen = p->tokenlen * 2 + 256;
+            p->tokenbuf = jv_mem_realloc(p->tokenbuf, p->tokenlen);
+          }
+          assert(p->tokenpos < p->tokenlen);
+          p->tokenbuf[p->tokenpos++] = ch;
+          break;
+        case WHITESPACE:
+          break;
+        case QUOTE:
+          p->st = JV_PARSER_STRING;
+          break;
+        case STRUCTURE:
+          tokmsg = parse_token(p, ch);
+          if (tokmsg)
+            msg = tokmsg;
+          break;
+        case INVALID:
+          msg = "Invalid character";
+          break;
+        }
+        if (!msg && parse_check_done(p, &parsed))
+          answer = OK;
+      }
+    } else if (p->st == JV_PARSER_STRING || p->st == JV_PARSER_STRING_ESCAPE) {
+      if (ch == '"' && p->st == JV_PARSER_STRING) {
+        in = p->tokenbuf;
+        outp = p->tokenbuf;
+        end = p->tokenbuf + p->tokenpos;
+        str_err = 0;
+        while (in < end) {
+          char c = *in++;
+          if (c == '\\') {
+            if (in >= end) {
+              str_err = "Expected escape character at end of string";
+              break;
+            }
+            esc = *in++;
+            switch (esc) {
+            case '\\':
+            case '"':
+            case '/':
+              *outp++ = esc;
+              break;
+            case 'b':
+              *outp++ = '\b';
+              break;
+            case 'f':
+              *outp++ = '\f';
+              break;
+            case 't':
+              *outp++ = '\t';
+              break;
+            case 'n':
+              *outp++ = '\n';
+              break;
+            case 'r':
+              *outp++ = '\r';
+              break;
+            case 'u':
+              if (in + 4 > end) {
+                str_err = "Invalid \\uXXXX escape";
+                break;
+              }
+              hexvalue = unhex4(in);
+              if (hexvalue < 0) {
+                str_err = "Invalid characters in \\uXXXX escape";
+                break;
+              }
+              codepoint = (unsigned long)hexvalue;
+              in += 4;
+              if (0xD800 <= codepoint && codepoint <= 0xDBFF &&
+                  (in + 6 > end || in[0] != '\\' || in[1] != 'u')) {
+                str_err = "Invalid \\uXXXX\\uXXXX surrogate pair escape";
+                break;
+              }
+              if (0xD800 <= codepoint && codepoint <= 0xDBFF) {
+                surrogate = (unsigned long)unhex4(in+2);
+              }
+              if (0xD800 <= codepoint && codepoint <= 0xDBFF &&
+                  !(0xDC00 <= surrogate && surrogate <= 0xDFFF)) {
+                str_err = "Invalid \\uXXXX\\uXXXX surrogate pair escape";
+                break;
+              }
+              if (0xD800 <= codepoint && codepoint <= 0xDBFF) {
+                in += 6;
+                codepoint = 0x10000 + (((codepoint - 0xD800) << 10)
+                                       | (surrogate - 0xDC00));
+              }
+              if (codepoint > 0x10FFFF)
+                codepoint = 0xFFFD;
+              outp += jvp_utf8_encode((int)codepoint, outp);
+              break;
+            default:
+              str_err = "Invalid escape";
+              break;
+            }
+            if (str_err)
+              break;
+          } else if (c > 0 && c < 0x001f) {
+            str_err = "Invalid string: control characters from U+0000 through U+001F must be escaped";
+            break;
+          } else {
+            *outp++ = c;
+          }
+        }
+        if (str_err) {
+          msg = str_err;
+        } else {
+          vmsg = value(p, jv_string_sized(p->tokenbuf, outp - p->tokenbuf));
+          if (vmsg) {
+            msg = vmsg;
+          } else {
+            p->tokenpos = 0;
+            p->st = JV_PARSER_NORMAL;
+            if (parse_check_done(p, &parsed))
+              answer = OK;
+          }
+        }
+      } else {
+        assert(p->tokenpos <= p->tokenlen);
+        if (p->tokenpos >= (p->tokenlen - 1)) {
+          p->tokenlen = p->tokenlen * 2 + 256;
+          p->tokenbuf = jv_mem_realloc(p->tokenbuf, p->tokenlen);
+        }
+        assert(p->tokenpos < p->tokenlen);
+        p->tokenbuf[p->tokenpos++] = ch;
+        if (ch == '\\' && p->st == JV_PARSER_STRING) {
+          p->st = JV_PARSER_STRING_ESCAPE;
+        } else {
+          p->st = JV_PARSER_STRING;
+        }
+      }
+    }
+    if (!msg)
+      msg = answer;
+  }
+
+  if (msg == OK) {
+    /* a complete value was produced from the buffer */
+  } else if (msg) {
+    jv_free(parsed);
+    parsed = jv_invalid_with_msg(jv_string_fmt("%s at line %d, column %d", msg, p->line, p->column));
+    parser_reset(p);
+    p->curr_buf = 0;
+    p->curr_buf_pos = 0;
+  } else {
+    p->eof = 1;
+    jv_free(parsed);
+    if (p->st != JV_PARSER_NORMAL) {
+      parsed = jv_invalid_with_msg(jv_string_fmt("Unfinished string at EOF at line %d, column %d", p->line, p->column));
+      parser_reset(p);
+      p->st = JV_PARSER_WAITING_FOR_RS;
+    } else if ((msg = check_literal(p))) {
+      parsed = jv_invalid_with_msg(jv_string_fmt("%s at EOF at line %d, column %d", msg, p->line, p->column));
+      parser_reset(p);
+      p->st = JV_PARSER_WAITING_FOR_RS;
+    } else if (p->stackpos != 0) {
+      parsed = jv_invalid_with_msg(jv_string_fmt("Unfinished JSON term at EOF at line %d, column %d", p->line, p->column));
+      parser_reset(p);
+      p->st = JV_PARSER_WAITING_FOR_RS;
+    } else {
+      parsed = p->next;
+      p->next = jv_invalid();
+    }
+  }
+
+  if (jv_is_valid(parsed)) {
+    extra = jv_parser_next(p);
+    if (jv_is_valid(extra)) {
+      jv_free(parsed);
+      jv_free(extra);
+      parsed = jv_invalid_with_msg(jv_string("Unexpected extra JSON values"));
+    } else if (jv_invalid_has_msg(jv_copy(extra))) {
+      jv_free(parsed);
+      parsed = extra;
+    } else {
+      jv_free(extra);
+    }
+  } else if (jv_invalid_has_msg(jv_copy(parsed))) {
+    /* keep the parser error */
+  } else {
+    jv_free(parsed);
+    parsed = jv_invalid_with_msg(jv_string("Expected JSON value"));
+  }
+
+finish_parse:
+  parser_free(p);
+
+  if (!jv_is_valid(parsed) && jv_invalid_has_msg(jv_copy(parsed))) {
+    jv emsg = jv_invalid_get_msg(parsed);
+    parsed = jv_invalid_with_msg(jv_string_fmt("%s (while parsing '%s')",
+                                              jv_string_value(emsg),
+                                              string));
+    jv_free(emsg);
+  }
+  return parsed;
 }
