     }
 }
+
+#[cfg(feature = "io-util")]
+#[derive(Debug, Clone, Copy)]
+pub(crate) struct WriteTransfer {
+    requested: usize,
+    completed: usize,
+}
+
+#[cfg(feature = "io-util")]
+impl WriteTransfer {
+    pub(crate) fn record(requested: usize, completed: usize) -> Self {
+        Self {
+            requested,
+            completed,
+        }
+    }
+
+    pub(crate) fn requested(&self) -> usize {
+        self.requested
+    }
+
+    pub(crate) fn completed(&self) -> usize {
+        self.completed
+    }
+
+    pub(crate) fn is_zero(&self) -> bool {
+        self.completed == 0
+    }
+
+    pub(crate) fn is_full(&self) -> bool {
+        self.requested > 0 && self.completed >= self.requested
+    }
+
+    pub(crate) fn is_partial(&self) -> bool {
+        self.completed > 0 && self.completed < self.requested
+    }
+
+    pub(crate) fn outstanding(&self) -> usize {
+        self.requested.saturating_sub(self.completed)
+    }
+
+    pub(crate) fn progressed(&self) -> bool {
+        self.completed > 0
+    }
+}
