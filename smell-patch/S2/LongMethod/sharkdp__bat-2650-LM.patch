+#[derive(Clone)]
+pub(crate) struct MappingPathClassification {
+    pub looks_like_path: bool,
+    pub is_absolute: bool,
+    pub file_name: Option<String>,
+    pub extension: Option<String>,
+    pub component_count: usize,
+    pub hidden_file: bool,
+    pub description: InputDescription,
+    pub scan: MappingPatternScan,
+}
+
+pub(crate) fn classify_mapping_path_pattern(pattern: &str) -> MappingPathClassification {
+    let scan = scan_mapping_pattern(pattern);
+    let path = Path::new(pattern);
+    let mut description = InputDescription::new(pattern);
+
+    let looks_like_path = scan.has_separator
+        || pattern.contains('/')
+        || pattern.contains('\\')
+        || path.parent().map(|parent| !parent.as_os_str().is_empty()).unwrap_or(false);
+    let is_absolute = path.is_absolute()
+        || pattern.starts_with('/')
+        || pattern.starts_with('\\')
+        || (pattern.len() >= 3
+            && pattern.as_bytes()[0].is_ascii_alphabetic()
+            && pattern.as_bytes()[1] == b':'
+            && (pattern.as_bytes()[2] == b'/' || pattern.as_bytes()[2] == b'\\'));
+
+    let file_name = path
+        .file_name()
+        .and_then(|name| name.to_str())
+        .map(|name| name.to_string())
+        .or_else(|| {
+            pattern
+                .rsplit(['/', '\\'])
+                .next()
+                .filter(|name| !name.is_empty())
+                .map(|name| name.to_string())
+        });
+
+    let extension = path
+        .extension()
+        .and_then(|ext| ext.to_str())
+        .map(|ext| ext.to_string())
+        .or_else(|| {
+            file_name.as_ref().and_then(|name| {
+                name.rsplit_once('.').and_then(|(stem, ext)| {
+                    if stem.is_empty() || ext.is_empty() {
+                        None
+                    } else {
+                        Some(ext.to_string())
+                    }
+                })
+            })
+        });
+
+    let component_count = path
+        .components()
+        .filter(|component| match component {
+            std::path::Component::CurDir => false,
+            _ => true,
+        })
+        .count();
+
+    let hidden_file = file_name
+        .as_ref()
+        .map(|name| name.starts_with('.') && name.len() > 1)
+        .unwrap_or(false);
+
+    if looks_like_path {
+        description.set_kind(Some("path-glob".to_string()));
+        if is_absolute {
+            description.set_summary(Some(format!("absolute mapping '{}'", pattern)));
+        } else {
+            description.set_summary(Some(format!("relative mapping '{}'", pattern)));
+        }
+    } else if scan.star_count > 0 || scan.question_count > 0 {
+        description.set_kind(Some("wildcard-glob".to_string()));
+        description.set_summary(Some(format!("wildcard mapping '{}'", pattern)));
+    } else {
+        description.set_kind(Some("literal-name".to_string()));
+        description.set_summary(Some(format!("literal mapping '{}'", pattern)));
+    }
+
+    if let Some(ref name) = file_name {
+        description.set_title(Some(name.clone()));
+    }
+
+    MappingPathClassification {
+        looks_like_path,
+        is_absolute,
+        file_name,
+        extension,
+        component_count,
+        hidden_file,
+        description,
+        scan,
+    }
+}
