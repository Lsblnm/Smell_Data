+#[derive(Debug, Clone, Default)]
+pub(crate) struct MappingPatternScan {
+    pub star_count: usize,
+    pub question_count: usize,
+    pub double_star: bool,
+    pub has_char_class: bool,
+    pub class_is_negated: bool,
+    pub has_separator: bool,
+    pub has_dot: bool,
+    pub has_escape: bool,
+    pub control_char_count: usize,
+    pub printable_len: usize,
+    pub brace_count: usize,
+}
+
+pub(crate) fn scan_mapping_pattern(pattern: &str) -> MappingPatternScan {
+    let notation = NonprintableNotation::for_mapping_pattern_scan();
+    let bytes = pattern.as_bytes();
+    let mut idx = 0;
+    let mut scan = MappingPatternScan::default();
+    let mut prev_star = false;
+    let mut in_class = false;
+    let mut class_started = false;
+
+    while idx < bytes.len() {
+        if let Some((ch, skip)) = try_parse_utf8_char(&bytes[idx..]) {
+            idx += skip;
+            if notation.describe_control_char(ch).is_some() {
+                scan.control_char_count += 1;
+            }
+            match ch {
+                '*' => {
+                    scan.star_count += 1;
+                    if prev_star {
+                        scan.double_star = true;
+                    }
+                    prev_star = true;
+                    class_started = true;
+                }
+                '?' => {
+                    scan.question_count += 1;
+                    prev_star = false;
+                    class_started = true;
+                }
+                '[' => {
+                    scan.has_char_class = true;
+                    in_class = true;
+                    class_started = false;
+                    prev_star = false;
+                }
+                ']' => {
+                    in_class = false;
+                    class_started = true;
+                    prev_star = false;
+                }
+                '!' | '^' => {
+                    if in_class && !class_started {
+                        scan.class_is_negated = true;
+                    }
+                    class_started = true;
+                    prev_star = false;
+                    scan.printable_len += 1;
+                }
+                '/' => {
+                    scan.has_separator = true;
+                    prev_star = false;
+                    class_started = true;
+                }
+                '\\' => {
+                    scan.has_escape = true;
+                    scan.has_separator = true;
+                    prev_star = false;
+                    class_started = true;
+                }
+                '.' => {
+                    scan.has_dot = true;
+                    prev_star = false;
+                    class_started = true;
+                    scan.printable_len += 1;
+                }
+                '{' | '}' => {
+                    scan.brace_count += 1;
+                    prev_star = false;
+                    class_started = true;
+                    scan.printable_len += 1;
+                }
+                _ => {
+                    prev_star = false;
+                    class_started = true;
+                    scan.printable_len += 1;
+                }
+            }
+        } else {
+            idx += 1;
+        }
+    }
+
+    scan
+}
