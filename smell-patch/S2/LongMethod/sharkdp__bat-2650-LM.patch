--- a/src/nonprintable_notation.rs
+++ b/src/nonprintable_notation.rs
@@ -10,3 +10,39 @@ pub enum NonprintableNotation {
     #[default]
     Unicode,
 }
+
+impl NonprintableNotation {
+    pub(crate) fn for_mapping_pattern_scan() -> Self {
+        NonprintableNotation::Unicode
+    }
+
+    pub(crate) fn describe_control_char(self, ch: char) -> Option<&'static str> {
+        match ch {
+            '\t' => Some(match self {
+                NonprintableNotation::Caret => "^I",
+                NonprintableNotation::Unicode => "␉",
+            }),
+            '\n' => Some(match self {
+                NonprintableNotation::Caret => "^J",
+                NonprintableNotation::Unicode => "␊",
+            }),
+            '\r' => Some(match self {
+                NonprintableNotation::Caret => "^M",
+                NonprintableNotation::Unicode => "␍",
+            }),
+            '\0' => Some(match self {
+                NonprintableNotation::Caret => "^@",
+                NonprintableNotation::Unicode => "␀",
+            }),
+            '\u{1b}' => Some(match self {
+                NonprintableNotation::Caret => "^[",
+                NonprintableNotation::Unicode => "␛",
+            }),
+            c if (c as u32) < 32 => Some(match self {
+                NonprintableNotation::Caret => "^?",
+                NonprintableNotation::Unicode => "•",
+            }),
+            _ => None,
+        }
+    }
+}
