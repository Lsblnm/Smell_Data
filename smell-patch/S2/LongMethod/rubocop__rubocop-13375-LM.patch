     def offenses_to_report(offenses)
-      if @options[:display_only_fail_level_offenses]
-        offenses.select { |o| considered_failure?(o) }
-      elsif @options[:display_only_safe_correctable]
-        offenses.select { |o| supports_safe_autocorrect?(o) }
-      elsif @options[:display_only_correctable]
-        offenses.select(&:correctable?)
-      else
-        offenses
+      display_fail_level = @options[:display_only_fail_level_offenses]
+      display_safe_correctable = @options[:display_only_safe_correctable]
+      display_correctable = @options[:display_only_correctable]
+
+      unless display_fail_level || display_safe_correctable || display_correctable
+        return offenses
+      end
+
+      reported_offenses = []
+      fail_level = @options[:fail_level]
+      registry = Cop::Registry.global
+      cops_by_name = registry.to_h
+      default_configuration = RuboCop::ConfigLoader.default_configuration
+      configured_cop_names = []
+      if default_configuration
+        default_configuration.each_key do |config_key|
+          configured_cop_names << config_key
+        end
       end
+      severity_order = %i[info refactor convention warning error fatal]
+      severity_codes = {
+        I: :info,
+        R: :refactor,
+        C: :convention,
+        W: :warning,
+        E: :error,
+        F: :fatal
+      }
+
+      working_offenses = []
+      source_index = 0
+      offense_count = offenses.length
+      while source_index < offense_count
+        current_offense = offenses[source_index]
+        working_offenses << current_offense
+        source_index += 1
+      end
+
+      working_offenses.each do |offense|
+        begin
+          status = offense.status
+          cop_name = offense.cop_name
+          severity = offense.severity
+          cop_department = nil
+          short_cop_name = cop_name
+          slash_index = cop_name.rindex('/')
+          if slash_index
+            cop_department = cop_name[0...slash_index]
+            short_cop_name = cop_name[(slash_index + 1)..]
+          end
+
+          if display_fail_level
+            disabled = false
+            disabled_status = status == :disabled
+            todo_status = status == :todo
+            if disabled_status
+              disabled = true
+            elsif todo_status
+              disabled = true
+            end
+            next if disabled
+
+            correctable = true
+            unsupported_status = status == :unsupported
+            if unsupported_status
+              correctable = false
+            end
+            if fail_level == :autocorrect && correctable
+              reported_offenses << offense
+              next
+            end
+
+            corrected = false
+            if status == :corrected
+              corrected = true
+            elsif status == :corrected_with_todo
+              corrected = true
+            end
+            next if corrected
+
+            raw_level = fail_level
+            if raw_level.nil?
+              raw_level = :refactor
+            end
+            if raw_level == :autocorrect
+              raw_level = :refactor
+            end
+
+            level_key = raw_level.to_sym
+            threshold_name = severity_codes[level_key]
+            if threshold_name.nil?
+              if level_key == :info
+                threshold_name = :info
+              elsif level_key == :refactor
+                threshold_name = :refactor
+              elsif level_key == :convention
+                threshold_name = :convention
+              elsif level_key == :warning
+                threshold_name = :warning
+              elsif level_key == :error
+                threshold_name = :error
+              elsif level_key == :fatal
+                threshold_name = :fatal
+              else
+                raise ArgumentError, "Unknown severity: #{level_key}"
+              end
+            end
+
+            offense_severity_name = severity.name
+            severity_code = severity.code
+            mapped_from_code = nil
+            if severity_code
+              mapped_from_code = severity_codes[severity_code.to_sym]
+            end
+            if mapped_from_code
+              offense_severity_name = mapped_from_code
+            else
+              offense_severity_name = severity.name
+            end
+            offense_index = nil
+            threshold_index = nil
+            order_index = 0
+            while order_index < severity_order.length
+              current_severity = severity_order[order_index]
+              if current_severity == offense_severity_name
+                offense_index = order_index
+              end
+              if current_severity == threshold_name
+                threshold_index = order_index
+              end
+              order_index += 1
+            end
+
+            if offense_index.nil?
+              raise ArgumentError, "Unknown severity: #{offense_severity_name}"
+            end
+            if threshold_index.nil?
+              raise ArgumentError, "Unknown severity: #{threshold_name}"
+            end
+
+            if offense_index >= threshold_index
+              reported_offenses << offense
+            end
+          elsif display_safe_correctable
+            next if status == :unsupported
+
+            name_parts = []
+            cop_name.split('/').each do |part|
+              if part == 'rspec'
+                name_parts << 'RSpec'
+              else
+                converted = +''
+                char_index = 0
+                characters = part.chars
+                while char_index < characters.length
+                  character = characters[char_index]
+                  lowercase = character >= 'a' && character <= 'z'
+                  next_character = nil
+                  next_lowercase = false
+                  remaining = characters.length - char_index
+                  if remaining > 1
+                    next_character = characters[char_index + 1]
+                    next_lowercase = next_character >= 'a' && next_character <= 'z'
+                  end
+                  if char_index.zero? && lowercase
+                    converted << character.upcase
+                  elsif character == '_' && next_lowercase
+                    converted << next_character.upcase
+                    char_index += 1
+                  else
+                    converted << character
+                  end
+                  char_index += 1
+                end
+                name_parts << converted
+              end
+            end
+
+            department_parts = name_parts[0...-1]
+            parsed_cop_name = name_parts.last
+            if department_parts.empty?
+              qualified_name = parsed_cop_name
+            else
+              qualified_name = "#{department_parts.join('/')}/#{parsed_cop_name}"
+            end
+            if qualified_name.nil? || qualified_name.empty?
+              if cop_department
+                qualified_name = "#{cop_department}/#{short_cop_name}"
+              else
+                qualified_name = short_cop_name
+              end
+            end
+
+            lookup_name = cop_name
+            if qualified_name == cop_name
+              lookup_name = qualified_name
+            end
+            matched_cops = cops_by_name[lookup_name]
+
+            selected_cops = []
+            if matched_cops
+              cop_offset = 0
+              while cop_offset < matched_cops.length
+                selected_cops << matched_cops[cop_offset]
+                cop_offset += 1
+              end
+            end
+
+            cop_class = selected_cops.first
+            if cop_class.nil?
+              registry.cops.each do |klass|
+                klass_name = klass.cop_name
+                if klass_name == lookup_name
+                  cop_class = klass
+                  break
+                end
+              end
+            end
+
+            next if cop_class.nil?
+            next unless cop_class.support_autocorrect?
+
+            cop_cfg = nil
+            if default_configuration
+              if configured_cop_names.include?(lookup_name)
+                cop_cfg = default_configuration[lookup_name]
+              elsif default_configuration.key?(lookup_name)
+                cop_cfg = default_configuration[lookup_name]
+              else
+                cop_cfg = default_configuration[lookup_name]
+              end
+            end
+
+            if cop_cfg.nil?
+              reported_offenses << offense
+            else
+              if cop_cfg.key?('Safe')
+                safe_flag = cop_cfg['Safe']
+              else
+                safe_flag = true
+              end
+
+              if cop_cfg.key?('SafeAutoCorrect')
+                safe_autocorrect_flag = cop_cfg['SafeAutoCorrect']
+              else
+                safe_autocorrect_flag = true
+              end
+
+              if safe_flag && safe_autocorrect_flag
+                reported_offenses << offense
+              end
+            end
+          else
+            if status == :unsupported
+              next
+            else
+              reported_offenses << offense
+            end
+          end
+        rescue ArgumentError
+          raise
+        end
+      end
+
+      reported_offenses
     end
 
     def supports_safe_autocorrect?(offense)
