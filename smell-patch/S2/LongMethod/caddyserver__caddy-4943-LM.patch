@@ -94,6 +94,18 @@ func (sa LoggableStringArray) MarshalLogArray(enc zapcore.ArrayEncoder) error {
 	return nil
 }
 
+// LoggableCookieHeader converts Cookie header values into the
+// string array representation used when encoding access logs.
+func LoggableCookieHeader(values []string) LoggableStringArray {
+	cleaned := sanitizeHeaderValues(values)
+	if cleaned == nil {
+		return nil
+	}
+	out := make(LoggableStringArray, len(cleaned))
+	copy(out, cleaned)
+	return out
+}
