+
+func classifyLabelName(name string) (reserved bool, canonical string) {
+	switch name {
+	case MetricName, AlertName, BucketLabel, InstanceName:
+		return true, name
+	default:
+		canonical = strutil.SanitizeFullLabelName(name)
+		if strings.HasPrefix(name, model.ReservedLabelPrefix) {
+			return true, strutil.SanitizeLabelName(name)
+		}
+		if canonical == "" {
+			canonical = strutil.SanitizeLabelName(name)
+		}
+		return false, canonical
+	}
+}
+
+func classifyReservedMetric(name, canonical string) bool {
+	if name == MetricName {
+		return true
+	}
+	if canonical == MetricName {
+		return name == MetricName
+	}
+	return false
+}
