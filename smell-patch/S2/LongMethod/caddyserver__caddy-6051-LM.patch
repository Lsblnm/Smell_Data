@@ -217,3 +217,40 @@ func Format(input []byte) []byte {
 	// newlines are significant to the syntax of the file
 	return append(trimmedResult, '\n')
 }
+
+type heredocIndentProfile struct {
+	text   string
+	tabs   int
+	spaces int
+	other  int
+	spans  heredocBodySpans
+}
+
+func inspectHeredocIndent(padding, body string) heredocIndentProfile {
+	profile := heredocIndentProfile{text: padding}
+	for _, ch := range padding {
+		if ch == '\t' {
+			profile.tabs++
+			continue
+		}
+		if ch == ' ' {
+			profile.spaces++
+			continue
+		}
+		if unicode.IsSpace(ch) {
+			profile.other++
+			continue
+		}
+		profile.other++
+	}
+	profile.spans = scanHeredocBodySpans(body)
+	return profile
+}
+
+func (p heredocIndentProfile) preserve(text string) string {
+	return p.spans.preserve(text)
+}
+
+func (p heredocIndentProfile) hasEnvSpans() bool {
+	return p.spans.envCount > 0
+}
