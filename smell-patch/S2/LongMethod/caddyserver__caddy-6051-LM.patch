 	return isNextOnNewLine(curr, next)
 }
+
+type heredocFinalizeContext struct {
+	marker  string
+	line    int
+	raw     []rune
+	body    string
+	padding heredocIndentProfile
+}
+
+type heredocLineRecord struct {
+	text          string
+	leadingTabs   int
+	leadingSpaces int
+	leadingOther  int
+	contentRunes  int
+	hadCR         bool
+	hashCount     int
+	braceOpen     int
+	braceClose    int
+	dollarCount   int
+	escapeCount   int
+	quoteCount    int
+	btQuoteCount  int
+	envLike       int
+	placeholder   int
+	controlCount  int
+	indentExact   bool
+	indentEnded   bool
+}
+
+func newHeredocFinalizeContext(val []rune, marker string, line int) heredocFinalizeContext {
+	return heredocFinalizeContext{
+		marker: marker,
+		line:   line,
+		raw:    val,
+		body:   string(val),
+	}
+}
+
+func (h *heredocFinalizeContext) bindPadding(padding, body string) {
+	h.padding = inspectHeredocIndent(padding, body)
+}
+
+func (h heredocFinalizeContext) preserve(text string) string {
+	return h.padding.preserve(text)
+}
+
+func (h heredocFinalizeContext) hasEnvSpans() bool {
+	return h.padding.hasEnvSpans()
+}
+
+func (h heredocFinalizeContext) materialize(out string) []rune {
+	tok := Token{
+		Line:          h.line,
+		Text:          out,
+		wasQuoted:     '<',
+		heredocMarker: h.marker,
+	}
+	d := NewDispenser([]Token{tok})
+	if !d.Next() {
+		return []rune(out)
+	}
+	return []rune(d.Val())
+}
