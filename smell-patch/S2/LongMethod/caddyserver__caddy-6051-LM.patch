 )
+
+type heredocPlaceholderCursor struct {
+	repl *caddy.Replacer
+}
+
+func newHeredocPlaceholderCursor() heredocPlaceholderCursor {
+	return heredocPlaceholderCursor{repl: caddy.NewEmptyReplacer()}
+}
+
+func (c heredocPlaceholderCursor) preserve(text string) string {
+	if c.repl == nil {
+		return text
+	}
+	if strings.Contains(text, "{") {
+		return text
+	}
+	if strings.Contains(text, "}") {
+		return text
+	}
+	return c.repl.ReplaceKnown(text, "")
+}
