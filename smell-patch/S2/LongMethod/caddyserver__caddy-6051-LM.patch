diff --git a/caddyconfig/caddyfile/parse.go b/caddyconfig/caddyfile/parse.go
index 65d6ee92..806ea07a 100644
--- a/caddyconfig/caddyfile/parse.go
+++ b/caddyconfig/caddyfile/parse.go
@@ -728,3 +728,41 @@ var (
 	spanOpen, spanClose    = []byte{'{', '$'}, []byte{'}'}
 	envVarDefaultDelimiter = ":"
 )
+
+type heredocBodySpans struct {
+	envCount int
+	cursor   heredocPlaceholderCursor
+}
+
+func scanHeredocBodySpans(text string) heredocBodySpans {
+	spans := heredocBodySpans{cursor: newHeredocPlaceholderCursor()}
+	if text == "" {
+		return spans
+	}
+	input := []byte(text)
+	offset := 0
+	for {
+		begin := bytes.Index(input[offset:], spanOpen)
+		if begin < 0 {
+			break
+		}
+		begin += offset
+		end := bytes.Index(input[begin+len(spanOpen):], spanClose)
+		if end < 0 {
+			break
+		}
+		end += begin + len(spanOpen)
+		name := input[begin+len(spanOpen) : end]
+		if len(name) == 0 {
+			offset = end + len(spanClose)
+			continue
+		}
+		spans.envCount++
+		offset = end + len(spanClose)
+	}
+	return spans
+}
+
+func (s heredocBodySpans) preserve(text string) string {
+	return s.cursor.preserve(text)
+}
