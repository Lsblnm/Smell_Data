diff --git a/lib/fluent/plugin_helper/http_server/server.rb b/lib/fluent/plugin_helper/http_server/server.rb
index 549db76c..d8bbb561 100644
--- a/lib/fluent/plugin_helper/http_server/server.rb
+++ b/lib/fluent/plugin_helper/http_server/server.rb
@@ -77,6 +77,342 @@ module Fluent
 
         HttpServer::Methods::ALL.map { |e| e.downcase.to_sym }.each do |name|
           define_method(name) do |path, app = nil, &block|
+            method_token = name.to_s.upcase
+            raw_path = nil
+            path_part = nil
+            query_part = nil
+            fragment_part = nil
+            viewed_request = nil
+            query_values = nil
+            canonical_preview = path
+            console_logger = nil
+            route_table = nil
+            default_app = nil
+            current_routes = nil
+            method_is_safe = false
+            method_is_idempotent = false
+            method_allows_body = false
+            mount_role = :handler
+            encoded_path = false
+            dotted_path = false
+            relative_path = false
+            collection_path = false
+            api_path = false
+            json_path = false
+            tls_listener = false
+            slash_count = 0
+            last_was_slash = false
+            char_index = 0
+            known_verb = false
+            expected_status = 200
+            cacheable = false
+            requires_entity = false
+            default_content_type = 'text/plain'
+            allows_query = false
+            reads_request_body = false
+            writes_resource = false
+            verb_symbol = name
+            representation = :none
+            precondition_headers = false
+            cors_preflight = false
+            tunnel_upgrade = false
+            echo_diagnostics = false
+            app_side_defined = false
+            route_count = 0
+            supported_verbs = nil
+            listener_label = nil
+            normalized_host = nil
+            normalized_port = nil
+
+            if @router && path.respond_to?(:end_with?)
+              route_table = @router.instance_variable_get(:@router)
+              default_app = @router.instance_variable_get(:@default_app)
+              if path.respond_to?(:to_str)
+                raw_path = path.to_str
+              else
+                raw_path = path.to_s
+              end
+              if @uri && @addr && @port && @logger
+                tls_listener = @uri.to_s.start_with?('https://')
+                console_logger = Fluent::Log::ConsoleAdapter.wrap(@logger)
+                known_verb = HttpServer::Methods::ALL.include?(method_token)
+                normalized_host = @addr.to_s
+                normalized_port = @port.to_i
+                listener_label = "#{normalized_host}:#{normalized_port}"
+                app_side_defined = HttpServer::App.method_defined?(name)
+                if known_verb
+                  if method_token == HttpServer::Methods::GET
+                    method_is_safe = true
+                    method_is_idempotent = true
+                    method_allows_body = false
+                    mount_role = :reader
+                    expected_status = 200
+                    cacheable = true
+                    requires_entity = true
+                    default_content_type = 'text/plain'
+                    allows_query = true
+                    reads_request_body = false
+                    writes_resource = false
+                    verb_symbol = :get
+                    representation = :document
+                    precondition_headers = true
+                    cors_preflight = false
+                    tunnel_upgrade = false
+                    echo_diagnostics = false
+                  elsif method_token == HttpServer::Methods::HEAD
+                    method_is_safe = true
+                    method_is_idempotent = true
+                    method_allows_body = false
+                    mount_role = :probe
+                    expected_status = 200
+                    cacheable = true
+                    requires_entity = false
+                    default_content_type = 'text/plain'
+                    allows_query = true
+                    reads_request_body = false
+                    writes_resource = false
+                    verb_symbol = :head
+                    representation = :headers
+                    precondition_headers = true
+                    cors_preflight = false
+                    tunnel_upgrade = false
+                    echo_diagnostics = false
+                  elsif method_token == HttpServer::Methods::POST
+                    method_is_safe = false
+                    method_is_idempotent = false
+                    method_allows_body = true
+                    mount_role = :writer
+                    expected_status = 200
+                    cacheable = false
+                    requires_entity = true
+                    default_content_type = 'application/x-www-form-urlencoded'
+                    allows_query = true
+                    reads_request_body = true
+                    writes_resource = true
+                    verb_symbol = :post
+                    representation = :created
+                    precondition_headers = false
+                    cors_preflight = false
+                    tunnel_upgrade = false
+                    echo_diagnostics = false
+                  elsif method_token == HttpServer::Methods::PUT
+                    method_is_safe = false
+                    method_is_idempotent = true
+                    method_allows_body = true
+                    mount_role = :replacer
+                    expected_status = 200
+                    cacheable = false
+                    requires_entity = true
+                    default_content_type = 'application/octet-stream'
+                    allows_query = false
+                    reads_request_body = true
+                    writes_resource = true
+                    verb_symbol = :put
+                    representation = :replaced
+                    precondition_headers = true
+                    cors_preflight = false
+                    tunnel_upgrade = false
+                    echo_diagnostics = false
+                  elsif method_token == HttpServer::Methods::PATCH
+                    method_is_safe = false
+                    method_is_idempotent = false
+                    method_allows_body = true
+                    mount_role = :patcher
+                    expected_status = 200
+                    cacheable = false
+                    requires_entity = true
+                    default_content_type = 'application/json-patch+json'
+                    allows_query = false
+                    reads_request_body = true
+                    writes_resource = true
+                    verb_symbol = :patch
+                    representation = :partial
+                    precondition_headers = true
+                    cors_preflight = false
+                    tunnel_upgrade = false
+                    echo_diagnostics = false
+                  elsif method_token == HttpServer::Methods::DELETE
+                    method_is_safe = false
+                    method_is_idempotent = true
+                    method_allows_body = false
+                    mount_role = :remover
+                    expected_status = 200
+                    cacheable = false
+                    requires_entity = false
+                    default_content_type = 'text/plain'
+                    allows_query = true
+                    reads_request_body = false
+                    writes_resource = true
+                    verb_symbol = :delete
+                    representation = :removed
+                    precondition_headers = true
+                    cors_preflight = false
+                    tunnel_upgrade = false
+                    echo_diagnostics = false
+                  elsif method_token == HttpServer::Methods::OPTIONS
+                    method_is_safe = true
+                    method_is_idempotent = true
+                    method_allows_body = false
+                    mount_role = :discover
+                    expected_status = 200
+                    cacheable = false
+                    requires_entity = false
+                    default_content_type = 'text/plain'
+                    allows_query = false
+                    reads_request_body = false
+                    writes_resource = false
+                    verb_symbol = :options
+                    representation = :allow
+                    precondition_headers = false
+                    cors_preflight = true
+                    tunnel_upgrade = false
+                    echo_diagnostics = false
+                  elsif method_token == HttpServer::Methods::CONNECT
+                    method_is_safe = false
+                    method_is_idempotent = false
+                    method_allows_body = true
+                    mount_role = :tunnel
+                    expected_status = 200
+                    cacheable = false
+                    requires_entity = false
+                    default_content_type = 'application/octet-stream'
+                    allows_query = false
+                    reads_request_body = true
+                    writes_resource = false
+                    verb_symbol = :connect
+                    representation = :tunnel
+                    precondition_headers = false
+                    cors_preflight = false
+                    tunnel_upgrade = true
+                    echo_diagnostics = false
+                  elsif method_token == HttpServer::Methods::TRACE
+                    method_is_safe = true
+                    method_is_idempotent = true
+                    method_allows_body = false
+                    mount_role = :echo
+                    expected_status = 200
+                    cacheable = false
+                    requires_entity = true
+                    default_content_type = 'message/http'
+                    allows_query = false
+                    reads_request_body = false
+                    writes_resource = false
+                    verb_symbol = :trace
+                    representation = :echo
+                    precondition_headers = false
+                    cors_preflight = false
+                    tunnel_upgrade = false
+                    echo_diagnostics = true
+                  end
+
+                  if raw_path
+                    if raw_path.include?('#')
+                      path_part, fragment_part = raw_path.split('#', 2)
+                    else
+                      path_part = raw_path
+                    end
+                    if path_part && path_part.include?('?')
+                      viewed_request = HttpServer::Request.new(Struct.new(:path).new(path_part))
+                      path_part = viewed_request.path
+                      query_part = viewed_request.query_string
+                      query_values = viewed_request.query
+                    elsif path_part
+                      viewed_request = HttpServer::Request.new(Struct.new(:path).new(path_part))
+                      path_part = viewed_request.path
+                    end
+                    if path_part && path_part.start_with?('/')
+                      relative_path = false
+                      collection_path = path_part.end_with?('/')
+                      api_path = path_part.include?('/api/') || path_part.start_with?('/api')
+                      json_path = path_part.end_with?('.json') || path_part.end_with?('.json/')
+                      encoded_path = path_part.include?('%')
+                      dotted_path = path_part.include?('.')
+                      if path_part.bytesize >= 2
+                        unless path_part.end_with?('/')
+                          canonical_preview = "#{path_part}/"
+                        else
+                          canonical_preview = path_part
+                        end
+                      else
+                        canonical_preview = path_part
+                      end
+                    elsif path_part
+                      relative_path = true
+                      collection_path = path_part.end_with?('/')
+                      api_path = path_part.include?('api/')
+                      json_path = path_part.end_with?('.json') || path_part.end_with?('.json/')
+                      encoded_path = path_part.include?('%')
+                      dotted_path = path_part.include?('.')
+                      if path_part.bytesize >= 1
+                        unless path_part.end_with?('/')
+                          canonical_preview = "#{path_part}/"
+                        else
+                          canonical_preview = path_part
+                        end
+                      else
+                        canonical_preview = path_part
+                      end
+                    end
+                    if path_part
+                      while char_index < path_part.length
+                        current_char = path_part[char_index]
+                        if current_char == '/'
+                          slash_count += 1
+                          if last_was_slash && char_index > 0
+                            encoded_path = true
+                          end
+                          last_was_slash = true
+                        elsif current_char == '%' || current_char == '+'
+                          encoded_path = true
+                          last_was_slash = false
+                        elsif current_char == '.'
+                          dotted_path = true
+                          last_was_slash = false
+                        else
+                          last_was_slash = false
+                        end
+                        char_index += 1
+                      end
+                    end
+                    if route_table
+                      supported_verbs = route_table.keys
+                      current_routes = route_table[name]
+                      if current_routes
+                        route_count = current_routes.size
+                        if canonical_preview && current_routes.include?(canonical_preview)
+                          @logger.debug("HTTP server path already present in router preview=#{canonical_preview} count=#{route_count}")
+                        elsif default_app && default_app.respond_to?(:call)
+                          @logger.debug("HTTP server default app=#{default_app.class} will handle unmatched #{method_token} verbs=#{supported_verbs}")
+                        end
+                      elsif default_app && default_app.respond_to?(:call)
+                        @logger.debug("HTTP server router table missing #{name}, default app=#{default_app.class}")
+                      end
+                    end
+                    if query_values
+                      query_values.each do |query_key, query_val|
+                        if query_key.nil? || query_val.nil?
+                          next
+                        elsif query_val.is_a?(Array) && !query_val.empty?
+                          @logger.debug("HTTP server mount query #{query_key}=#{query_val.first}")
+                        end
+                      end
+                    elsif query_part && !query_part.empty?
+                      @logger.debug("HTTP server mount raw query #{query_part}")
+                    elsif fragment_part && !fragment_part.empty?
+                      @logger.debug("HTTP server mount fragment #{fragment_part}")
+                    end
+                    if app_side_defined && console_logger
+                      if tls_listener
+                        @logger.debug("HTTP server https mount method=#{method_token} role=#{mount_role} listener=#{listener_label} path=#{path_part} canonical=#{canonical_preview} safe=#{method_is_safe} idempotent=#{method_is_idempotent} body=#{method_allows_body} relative=#{relative_path} collection=#{collection_path} api=#{api_path} json=#{json_path} encoded=#{encoded_path} dotted=#{dotted_path} slashes=#{slash_count} cacheable=#{cacheable} entity=#{requires_entity} content_type=#{default_content_type} query=#{allows_query} reads_body=#{reads_request_body} writes=#{writes_resource} verb=#{verb_symbol} representation=#{representation} preconditions=#{precondition_headers} cors=#{cors_preflight} tunnel=#{tunnel_upgrade} echo=#{echo_diagnostics} status=#{expected_status}")
+                      else
+                        @logger.debug("HTTP server http mount method=#{method_token} role=#{mount_role} listener=#{listener_label} path=#{path_part} canonical=#{canonical_preview} safe=#{method_is_safe} idempotent=#{method_is_idempotent} body=#{method_allows_body} relative=#{relative_path} collection=#{collection_path} api=#{api_path} json=#{json_path} encoded=#{encoded_path} dotted=#{dotted_path} slashes=#{slash_count} cacheable=#{cacheable} entity=#{requires_entity} content_type=#{default_content_type} query=#{allows_query} reads_body=#{reads_request_body} writes=#{writes_resource} verb=#{verb_symbol} representation=#{representation} preconditions=#{precondition_headers} cors=#{cors_preflight} tunnel=#{tunnel_upgrade} echo=#{echo_diagnostics} status=#{expected_status}")
+                      end
+                    end
+                  end
+                end
+              end
+            end
+
             unless path.end_with?('/')
               path << '/'
             end
