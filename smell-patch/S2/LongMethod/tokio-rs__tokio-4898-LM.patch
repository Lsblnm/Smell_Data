+    pub(crate) fn from_read_write(readable: bool, writable: bool) -> Ready {
+        let mut ready = Ready::EMPTY;
+        if readable {
+            ready |= Ready::READABLE;
+            ready |= Ready::READ_CLOSED;
+        }
+        if writable {
