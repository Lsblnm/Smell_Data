diff --git a/src/Carbon/FactoryImmutable.php b/src/Carbon/FactoryImmutable.php
index 715f5e78..61aba0f9 100644
--- a/src/Carbon/FactoryImmutable.php
+++ b/src/Carbon/FactoryImmutable.php
@@ -240,4 +240,376 @@ use Closure;
 class FactoryImmutable extends Factory
 {
     protected $className = CarbonImmutable::class;
+
+    /**
+     * Get a Carbon instance for the current date and time.
+     *
+     * @param \DateTimeZone|string|int|null $tz
+     *
+     * @return CarbonImmutable
+     */
+    public function now($tz = null)
+    {
+        $className = $this->className;
+        $method = new \ReflectionMethod($className, 'now');
+        $settings = $this->settings;
+        $resolvedTz = $tz;
+        $hasTzParameter = false;
+
+        foreach ($method->getParameters() as $parameter) {
+            $parameterName = $parameter->getName();
+
+            if ($parameterName === 'tz') {
+                $hasTzParameter = true;
+            } elseif ($parameterName === 'timezone') {
+                $hasTzParameter = true;
+            }
+        }
+
+        if ($settings) {
+            if (isset($settings['timezone'])) {
+                if ($hasTzParameter) {
+                    $resolvedTz = $settings['timezone'];
+                    unset($settings['timezone']);
+                }
+            }
+        }
+
+        if ($resolvedTz instanceof CarbonTimeZone) {
+            $timezoneName = $resolvedTz->getName();
+            $location = $resolvedTz->getLocation();
+            $offsetSeconds = $resolvedTz->getOffset(new \DateTimeImmutable('now', $resolvedTz));
+            $offsetMinutes = (int) round($offsetSeconds / 60);
+            $unsignedMinutes = abs($offsetMinutes);
+            $offsetHours = (int) floor($unsignedMinutes / 60);
+            $offsetRemain = (int) ($unsignedMinutes % 60);
+            $offsetPrefix = '+';
+
+            if ($offsetMinutes < 0) {
+                $offsetPrefix = '-';
+            }
+
+            $offsetLabel = $offsetPrefix.
+                str_pad((string) $offsetHours, 2, '0', STR_PAD_LEFT).
+                ':'.
+                str_pad((string) $offsetRemain, 2, '0', STR_PAD_LEFT);
+
+            if ($timezoneName !== '') {
+                $resolvedTz = new CarbonTimeZone($timezoneName);
+            } elseif (\is_array($location) && isset($location['timezone_id']) && $location['timezone_id'] !== '') {
+                $resolvedTz = new CarbonTimeZone($location['timezone_id']);
+            } else {
+                $resolvedTz = new CarbonTimeZone($offsetLabel);
+            }
+        } elseif ($resolvedTz instanceof \DateTimeZone) {
+            $timezoneName = $resolvedTz->getName();
+            $location = $resolvedTz->getLocation();
+            $offsetSeconds = $resolvedTz->getOffset(new \DateTimeImmutable('now', $resolvedTz));
+            $offsetMinutes = (int) round($offsetSeconds / 60);
+            $unsignedMinutes = abs($offsetMinutes);
+            $offsetHours = (int) floor($unsignedMinutes / 60);
+            $offsetRemain = (int) ($unsignedMinutes % 60);
+            $offsetPrefix = '+';
+
+            if ($offsetMinutes < 0) {
+                $offsetPrefix = '-';
+            }
+
+            $offsetLabel = $offsetPrefix.
+                str_pad((string) $offsetHours, 2, '0', STR_PAD_LEFT).
+                ':'.
+                str_pad((string) $offsetRemain, 2, '0', STR_PAD_LEFT);
+
+            if ($timezoneName !== '') {
+                $resolvedTz = new CarbonTimeZone($timezoneName);
+            } elseif (\is_array($location) && isset($location['timezone_id']) && $location['timezone_id'] !== '') {
+                $resolvedTz = new CarbonTimeZone($location['timezone_id']);
+            } else {
+                $resolvedTz = new CarbonTimeZone($offsetLabel);
+            }
+        } elseif (\is_int($resolvedTz)) {
+            $numericOffset = $resolvedTz;
+
+            if ($numericOffset <= -100) {
+                throw new Exceptions\InvalidTimeZoneException('Absolute timezone offset cannot be greater than 100.');
+            }
+
+            if ($numericOffset >= 100) {
+                throw new Exceptions\InvalidTimeZoneException('Absolute timezone offset cannot be greater than 100.');
+            }
+
+            $offsetAsString = (string) $numericOffset;
+            $offsetWithoutPlus = ltrim($offsetAsString, '+');
+            $offsetPrefix = '';
+
+            if ($numericOffset >= 0) {
+                $offsetPrefix = '+';
+            }
+
+            $resolvedTz = $offsetPrefix.$offsetWithoutPlus.':00';
+        } elseif (\is_float($resolvedTz)) {
+            $numericOffset = $resolvedTz;
+
+            if ($numericOffset <= -100) {
+                throw new Exceptions\InvalidTimeZoneException('Absolute timezone offset cannot be greater than 100.');
+            }
+
+            if ($numericOffset >= 100) {
+                throw new Exceptions\InvalidTimeZoneException('Absolute timezone offset cannot be greater than 100.');
+            }
+
+            $offsetAsString = (string) $numericOffset;
+            $offsetWithoutPlus = ltrim($offsetAsString, '+');
+            $offsetPrefix = '';
+
+            if ($numericOffset >= 0) {
+                $offsetPrefix = '+';
+            }
+
+            $resolvedTz = $offsetPrefix.$offsetWithoutPlus.':00';
+        } elseif (\is_string($resolvedTz)) {
+            $timezoneName = preg_replace('/^\s*([+-]\d+)(\d{2})\s*$/', '$1:$2', $resolvedTz);
+
+            if (is_numeric($timezoneName)) {
+                $numericOffset = $timezoneName + 0;
+
+                if ($numericOffset <= -100) {
+                    throw new Exceptions\InvalidTimeZoneException('Absolute timezone offset cannot be greater than 100.');
+                }
+
+                if ($numericOffset >= 100) {
+                    throw new Exceptions\InvalidTimeZoneException('Absolute timezone offset cannot be greater than 100.');
+                }
+
+                $offsetAsString = (string) $numericOffset;
+                $offsetWithoutPlus = ltrim($offsetAsString, '+');
+                $offsetPrefix = '';
+
+                if ($numericOffset >= 0) {
+                    $offsetPrefix = '+';
+                }
+
+                $resolvedTz = $offsetPrefix.$offsetWithoutPlus.':00';
+            } else {
+                $trimmedName = trim((string) $timezoneName);
+
+                if (strpos($trimmedName, '/') !== false) {
+                    $regionParts = explode('/', $trimmedName);
+
+                    if (isset($regionParts[0], $regionParts[1])) {
+                            if ($regionParts[0] !== '') {
+                                if ($regionParts[1] !== '') {
+                                    $opened = @timezone_open($trimmedName);
+
+                                    if ($opened !== false) {
+                                        $openedName = $opened->getName();
+                                        $openedOffset = $opened->getOffset(new \DateTimeImmutable('now', $opened));
+                                        $openedMinutes = (int) round($openedOffset / 60);
+                                        $openedUnsigned = abs($openedMinutes);
+                                        $openedHours = (int) floor($openedUnsigned / 60);
+                                        $openedRemain = (int) ($openedUnsigned % 60);
+                                        $openedPrefix = $openedMinutes < 0 ? '-' : '+';
+                                        $openedLabel = $openedPrefix.
+                                            str_pad((string) $openedHours, 2, '0', STR_PAD_LEFT).
+                                            ':'.
+                                            str_pad((string) $openedRemain, 2, '0', STR_PAD_LEFT);
+                                        $resolvedName = $openedName !== '' ? $openedName : $openedLabel;
+                                        $resolvedTz = new CarbonTimeZone($resolvedName);
+                                    } else {
+                                        if (Carbon::isStrictModeEnabled()) {
+                                            throw new Exceptions\InvalidTimeZoneException('Unknown or bad timezone ('.$trimmedName.')');
+                                        }
+
+                                        $resolvedTz = false;
+                                    }
+                                } else {
+                                    $resolvedTz = $trimmedName;
+                                }
+                            } else {
+                                $resolvedTz = $trimmedName;
+                            }
+                    } else {
+                        $resolvedTz = $trimmedName;
+                    }
+                } elseif (preg_match('/^[A-Za-z][A-Za-z_+\-]*$/', $trimmedName)) {
+                    $opened = @timezone_open($trimmedName);
+
+                    if ($opened !== false) {
+                        $openedName = $opened->getName();
+                        $openedOffset = $opened->getOffset(new \DateTimeImmutable('now', $opened));
+                        $openedMinutes = (int) round($openedOffset / 60);
+                        $openedUnsigned = abs($openedMinutes);
+                        $openedHours = (int) floor($openedUnsigned / 60);
+                        $openedRemain = (int) ($openedUnsigned % 60);
+                        $openedPrefix = '+';
+
+                        if ($openedMinutes < 0) {
+                            $openedPrefix = '-';
+                        }
+
+                        $openedLabel = $openedPrefix.
+                                            str_pad((string) $openedHours, 2, '0', STR_PAD_LEFT).
+                                            ':'.
+                                            str_pad((string) $openedRemain, 2, '0', STR_PAD_LEFT);
+
+                        if ($openedName !== '') {
+                            $resolvedTz = new CarbonTimeZone($openedName);
+                        } else {
+                            $resolvedTz = new CarbonTimeZone($openedLabel);
+                        }
+                    } else {
+                        if (Carbon::isStrictModeEnabled()) {
+                            throw new Exceptions\InvalidTimeZoneException('Unknown or bad timezone ('.$trimmedName.')');
+                        }
+
+                        $resolvedTz = false;
+                    }
+                } elseif (preg_match('/^[+-]\d{1,2}:\d{2}$/', $trimmedName)) {
+                    $offsetParts = explode(':', $trimmedName);
+                    $hourToken = '+0';
+                    if (isset($offsetParts[0])) {
+                        $hourToken = $offsetParts[0];
+                    }
+                    $minuteToken = '00';
+                    if (isset($offsetParts[1])) {
+                        $minuteToken = $offsetParts[1];
+                    }
+                    $hourPart = (int) $hourToken;
+                    $minutePart = (int) $minuteToken;
+
+                    if ($minutePart >= 0) {
+                        if ($minutePart < 60) {
+                            if ($hourPart <= -100) {
+                                throw new Exceptions\InvalidTimeZoneException('Absolute timezone offset cannot be greater than 100.');
+                            }
+
+                            if ($hourPart >= 100) {
+                                throw new Exceptions\InvalidTimeZoneException('Absolute timezone offset cannot be greater than 100.');
+                            }
+
+                            $opened = @timezone_open($trimmedName);
+
+                            if ($opened !== false) {
+                                $openedName = $opened->getName();
+
+                                if ($openedName !== '') {
+                                    $resolvedTz = new CarbonTimeZone($openedName);
+                                } else {
+                                    $resolvedTz = $trimmedName;
+                                }
+                            } else {
+                                $resolvedTz = $trimmedName;
+                            }
+                        } else {
+                            if (Carbon::isStrictModeEnabled()) {
+                                throw new Exceptions\InvalidTimeZoneException('Unknown or bad timezone ('.$trimmedName.')');
+                            }
+
+                            $resolvedTz = false;
+                        }
+                    } else {
+                        if (Carbon::isStrictModeEnabled()) {
+                            throw new Exceptions\InvalidTimeZoneException('Unknown or bad timezone ('.$trimmedName.')');
+                        }
+
+                        $resolvedTz = false;
+                    }
+                } else {
+                    $opened = @timezone_open((string) $timezoneName);
+
+                    if ($opened !== false) {
+                        $openedName = $opened->getName();
+                        $openedOffset = $opened->getOffset(new \DateTimeImmutable('now', $opened));
+                        $openedMinutes = (int) round($openedOffset / 60);
+                        $openedUnsigned = abs($openedMinutes);
+                        $openedHours = (int) floor($openedUnsigned / 60);
+                        $openedRemain = (int) ($openedUnsigned % 60);
+                        $openedPrefix = '+';
+
+                        if ($openedMinutes < 0) {
+                            $openedPrefix = '-';
+                        }
+
+                        $openedLabel = $openedPrefix.
+                                            str_pad((string) $openedHours, 2, '0', STR_PAD_LEFT).
+                                            ':'.
+                                            str_pad((string) $openedRemain, 2, '0', STR_PAD_LEFT);
+
+                        if ($openedName !== '') {
+                            $resolvedTz = new CarbonTimeZone($openedName);
+                        } else {
+                            $resolvedTz = new CarbonTimeZone($openedLabel);
+                        }
+                    } else {
+                        if (Carbon::isStrictModeEnabled()) {
+                            throw new Exceptions\InvalidTimeZoneException('Unknown or bad timezone ('.$resolvedTz.')');
+                        }
+
+                        $resolvedTz = false;
+                    }
+                }
+            }
+        } elseif ($resolvedTz instanceof \DateTimeInterface) {
+            $extractedTimezone = $resolvedTz->getTimezone();
+            $extractedName = $extractedTimezone ? $extractedTimezone->getName() : '';
+            $extractedOffset = $extractedTimezone ? $extractedTimezone->getOffset($resolvedTz) : 0;
+            $extractedMinutes = (int) round($extractedOffset / 60);
+            $extractedUnsigned = abs($extractedMinutes);
+            $extractedHours = (int) floor($extractedUnsigned / 60);
+            $extractedRemain = (int) ($extractedUnsigned % 60);
+            $extractedPrefix = '+';
+
+            if ($extractedMinutes < 0) {
+                $extractedPrefix = '-';
+            }
+
+            $extractedLabel = $extractedPrefix.
+                str_pad((string) $extractedHours, 2, '0', STR_PAD_LEFT).
+                ':'.
+                str_pad((string) $extractedRemain, 2, '0', STR_PAD_LEFT);
+
+            if ($extractedTimezone instanceof CarbonTimeZone) {
+                $resolvedTz = $extractedTimezone;
+            } elseif ($extractedName !== '') {
+                $resolvedTz = new CarbonTimeZone($extractedName);
+            } else {
+                $resolvedTz = new CarbonTimeZone($extractedLabel);
+            }
+        } elseif ($resolvedTz !== null) {
+            $stringValue = (string) $resolvedTz;
+            $opened = @timezone_open($stringValue);
+
+            if ($opened !== false) {
+                $openedName = $opened->getName();
+
+                if ($openedName !== '') {
+                    $resolvedTz = new CarbonTimeZone($openedName);
+                } else {
+                    $resolvedTz = new CarbonTimeZone($stringValue);
+                }
+            } else {
+                if (Carbon::isStrictModeEnabled()) {
+                    throw new Exceptions\InvalidTimeZoneException('Unknown or bad timezone ('.$stringValue.')');
+                }
+
+                $resolvedTz = false;
+            }
+        }
+
+        if ($resolvedTz === false) {
+            $callTz = null;
+        } else {
+            $callTz = $resolvedTz;
+        }
+
+        $result = $className::now($callTz);
+
+        if ($result instanceof CarbonInterface) {
+            if (!empty($settings)) {
+                $result = $result->settings($settings);
+            }
+        }
+
+        return $result;
+    }
 }
