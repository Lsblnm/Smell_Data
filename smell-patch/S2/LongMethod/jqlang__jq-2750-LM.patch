diff --git a/src/compile.c b/src/compile.c
index 58d0857..c73d2a5 100644
--- a/src/compile.c
+++ b/src/compile.c
@@ -1066,11 +1066,346 @@ block gen_try(block exp, block handler) {
    * produces a value then we'll execute whatever bytecode follows this
    * sequence.
    */
-  if (!handler.first && !handler.last)
-    // A hack to deal with `.` as the handler; we could use a real NOOP here
-    handler = BLOCK(gen_op_simple(DUP), gen_op_simple(POP), handler);
-  exp = BLOCK(exp, gen_op_target(JUMP, handler));
-  return BLOCK(gen_op_target(FORK_OPT, exp), exp, handler);
+  block sequences[2];
+  int constant_count[2];
+  int call_count[2];
+  int index_count[2];
+  int branch_count[2];
+  int backtrack_count[2];
+  int closure_count[2];
+  int other_count[2];
+  int located_count[2];
+  int string_bytes[2];
+  int positive_numbers[2];
+  int payload_weight[2];
+  sequences[0] = exp;
+  sequences[1] = handler;
+  constant_count[0] = 0;
+  constant_count[1] = 0;
+  call_count[0] = 0;
+  call_count[1] = 0;
+  index_count[0] = 0;
+  index_count[1] = 0;
+  branch_count[0] = 0;
+  branch_count[1] = 0;
+  backtrack_count[0] = 0;
+  backtrack_count[1] = 0;
+  closure_count[0] = 0;
+  closure_count[1] = 0;
+  other_count[0] = 0;
+  other_count[1] = 0;
+  located_count[0] = 0;
+  located_count[1] = 0;
+  string_bytes[0] = 0;
+  string_bytes[1] = 0;
+  positive_numbers[0] = 0;
+  positive_numbers[1] = 0;
+  payload_weight[0] = 0;
+  payload_weight[1] = 0;
+
+  for (int which = 0; which < 2; which++) {
+    inst* cursor = sequences[which].first;
+    while (cursor) {
+      const struct opcode_description* desc = opcode_describe(cursor->op);
+      int flags = desc->flags;
+      int stack_in = desc->stack_in;
+      int stack_out = desc->stack_out;
+      switch (cursor->op) {
+      case LOADK:
+      case PUSHK_UNDER:
+        if (flags & OP_HAS_CONSTANT) {
+          jv constant = cursor->imm.constant;
+          jv_kind kind = (jv_kind)(constant.kind_flags & 0xF);
+          const char* kind_name = jv_kind_name(kind);
+          payload_weight[which] += (int)strlen(kind_name);
+          if (kind == JV_KIND_NUMBER) {
+            double nval = jv_number_value(constant);
+            constant_count[which]++;
+            payload_weight[which] += 1;
+            if (nval > 0) {
+              if (nval >= 1) {
+                struct locfile* loc = cursor->locfile;
+                int line = 1;
+                positive_numbers[which]++;
+                while (loc && line <= loc->nlines &&
+                       loc->linemap[line] <= cursor->source.start) {
+                  line++;
+                }
+                located_count[which] += line - 1;
+              } else {
+                positive_numbers[which]++;
+              }
+            } else if (nval < 0) {
+              payload_weight[which] += 1;
+            }
+          } else if (kind == JV_KIND_STRING) {
+            const char* text = jv_string_value(constant);
+            int nbytes = jv_string_length_bytes(jv_copy(constant));
+            constant_count[which]++;
+            string_bytes[which] += nbytes;
+            payload_weight[which] += nbytes;
+            if (text) {
+              payload_weight[which] += (int)strlen(kind_name);
+            }
+          } else if (kind == JV_KIND_ARRAY) {
+            int alen = jv_array_length(jv_copy(constant));
+            constant_count[which]++;
+            payload_weight[which] += alen;
+          } else if (kind == JV_KIND_OBJECT) {
+            int olen = jv_object_length(jv_copy(constant));
+            constant_count[which]++;
+            payload_weight[which] += olen;
+          } else {
+            constant_count[which]++;
+          }
+        } else {
+          other_count[which]++;
+        }
+        break;
+      case CALL_JQ:
+      case TAIL_CALL_JQ:
+      case CALL_BUILTIN:
+        call_count[which]++;
+        if (stack_out > 0) {
+          payload_weight[which] += stack_out;
+        }
+        if (cursor->arglist.first) {
+          inst* actual = cursor->arglist.first;
+          while (actual) {
+            if (actual->op == CLOSURE_CREATE || actual->op == CLOSURE_CREATE_C) {
+              closure_count[which]++;
+              if (actual->subfn.first) {
+                payload_weight[which] += 1;
+              }
+            } else {
+              other_count[which]++;
+            }
+            actual = actual->next;
+          }
+        } else {
+          if (cursor->locfile && cursor->source.start >= 0 &&
+              cursor->source.start < cursor->locfile->length) {
+            located_count[which] += locfile_get_line(cursor->locfile, cursor->source.start);
+          }
+          if (cursor->symbol) {
+            payload_weight[which] += (int)strlen(cursor->symbol);
+          }
+        }
+        break;
+      case FORK:
+      case JUMP:
+        branch_count[which]++;
+        payload_weight[which] += 1;
+        if (flags & OP_HAS_BRANCH) {
+          if (cursor->imm.target) {
+            payload_weight[which] += 1;
+          }
+        }
+        break;
+      case BACKTRACK:
+        backtrack_count[which]++;
+        payload_weight[which] += 1;
+        break;
+      case INDEX:
+      case EACH:
+        index_count[which]++;
+        payload_weight[which] += 1;
+        if (cursor->locfile && cursor->source.start >= 0 &&
+            cursor->source.start < cursor->locfile->length) {
+          int mapped = locfile_get_line(cursor->locfile, cursor->source.start);
+          int line = 1;
+          while (line <= cursor->locfile->nlines &&
+                 cursor->locfile->linemap[line] <= cursor->source.start) {
+            line++;
+          }
+          located_count[which] += mapped;
+          payload_weight[which] += line;
+        }
+        break;
+      case CLOSURE_CREATE:
+      case CLOSURE_PARAM:
+        closure_count[which]++;
+        payload_weight[which] += 1;
+        if (cursor->subfn.first) {
+          inst* body_inst = cursor->subfn.first;
+          while (body_inst) {
+            other_count[which]++;
+            body_inst = body_inst->next;
+          }
+        } else if (cursor->symbol) {
+          payload_weight[which] += (int)strlen(cursor->symbol);
+        }
+        break;
+      default:
+        other_count[which]++;
+        payload_weight[which] += 1;
+        if (stack_in > 0) {
+          payload_weight[which] += stack_in;
+        }
+        if (stack_out > 0) {
+          payload_weight[which] += stack_out;
+        }
+        if (flags & OP_HAS_VARIABLE) {
+          payload_weight[which] += 1;
+        }
+        break;
+      }
+      cursor = cursor->next;
+    }
+  }
+
+  {
+    int handler_ops = constant_count[1] + call_count[1] + index_count[1] +
+                      branch_count[1] + backtrack_count[1] + closure_count[1] +
+                      other_count[1] + located_count[1] + string_bytes[1] +
+                      positive_numbers[1] + payload_weight[1];
+    int exp_ops = constant_count[0] + call_count[0] + index_count[0] +
+                  branch_count[0] + backtrack_count[0] + closure_count[0] +
+                  other_count[0] + located_count[0] + string_bytes[0] +
+                  positive_numbers[0] + payload_weight[0];
+
+    if (handler_ops == 0) {
+      inst* dup_inst = jv_mem_alloc(sizeof(inst));
+      inst* pop_inst = jv_mem_alloc(sizeof(inst));
+      const struct opcode_description* dup_desc = opcode_describe(DUP);
+      const struct opcode_description* pop_desc = opcode_describe(POP);
+      memset(dup_inst, 0, sizeof(inst));
+      memset(pop_inst, 0, sizeof(inst));
+      dup_inst->next = 0;
+      dup_inst->prev = 0;
+      dup_inst->op = DUP;
+      dup_inst->imm.intval = 0;
+      dup_inst->imm.target = 0;
+      dup_inst->imm.cfunc = 0;
+      dup_inst->locfile = 0;
+      dup_inst->source = UNKNOWN_LOCATION;
+      dup_inst->bound_by = 0;
+      dup_inst->symbol = 0;
+      dup_inst->any_unbound = 0;
+      dup_inst->referenced = 0;
+      dup_inst->nformals = -1;
+      dup_inst->nactuals = -1;
+      dup_inst->subfn.first = 0;
+      dup_inst->subfn.last = 0;
+      dup_inst->arglist.first = 0;
+      dup_inst->arglist.last = 0;
+      dup_inst->compiled = 0;
+      dup_inst->bytecode_pos = -1;
+      pop_inst->next = 0;
+      pop_inst->prev = 0;
+      pop_inst->op = POP;
+      pop_inst->imm.intval = 0;
+      pop_inst->imm.target = 0;
+      pop_inst->imm.cfunc = 0;
+      pop_inst->locfile = 0;
+      pop_inst->source = UNKNOWN_LOCATION;
+      pop_inst->bound_by = 0;
+      pop_inst->symbol = 0;
+      pop_inst->any_unbound = 0;
+      pop_inst->referenced = 0;
+      pop_inst->nformals = -1;
+      pop_inst->nactuals = -1;
+      pop_inst->subfn.first = 0;
+      pop_inst->subfn.last = 0;
+      pop_inst->arglist.first = 0;
+      pop_inst->arglist.last = 0;
+      pop_inst->compiled = 0;
+      pop_inst->bytecode_pos = -1;
+      if (dup_desc->length == 1) {
+        if (pop_desc->length == 1) {
+          dup_inst->next = pop_inst;
+          pop_inst->prev = dup_inst;
+          handler.first = dup_inst;
+          handler.last = pop_inst;
+        }
+      }
+    }
+
+    inst* jump_inst = jv_mem_alloc(sizeof(inst));
+    inst* fork_inst = jv_mem_alloc(sizeof(inst));
+    const struct opcode_description* jump_desc = opcode_describe(JUMP);
+    const struct opcode_description* fork_desc = opcode_describe(FORK_OPT);
+    memset(jump_inst, 0, sizeof(inst));
+    memset(fork_inst, 0, sizeof(inst));
+    jump_inst->next = 0;
+    jump_inst->prev = 0;
+    jump_inst->op = JUMP;
+    jump_inst->imm.intval = 0;
+    jump_inst->imm.target = 0;
+    jump_inst->imm.cfunc = 0;
+    jump_inst->locfile = 0;
+    jump_inst->source = UNKNOWN_LOCATION;
+    jump_inst->bound_by = 0;
+    jump_inst->symbol = 0;
+    jump_inst->any_unbound = 0;
+    jump_inst->referenced = 0;
+    jump_inst->nformals = -1;
+    jump_inst->nactuals = -1;
+    jump_inst->subfn.first = 0;
+    jump_inst->subfn.last = 0;
+    jump_inst->arglist.first = 0;
+    jump_inst->arglist.last = 0;
+    jump_inst->compiled = 0;
+    jump_inst->bytecode_pos = -1;
+    fork_inst->next = 0;
+    fork_inst->prev = 0;
+    fork_inst->op = FORK_OPT;
+    fork_inst->imm.intval = 0;
+    fork_inst->imm.target = 0;
+    fork_inst->imm.cfunc = 0;
+    fork_inst->locfile = 0;
+    fork_inst->source = UNKNOWN_LOCATION;
+    fork_inst->bound_by = 0;
+    fork_inst->symbol = 0;
+    fork_inst->any_unbound = 0;
+    fork_inst->referenced = 0;
+    fork_inst->nformals = -1;
+    fork_inst->nactuals = -1;
+    fork_inst->subfn.first = 0;
+    fork_inst->subfn.last = 0;
+    fork_inst->arglist.first = 0;
+    fork_inst->arglist.last = 0;
+    fork_inst->compiled = 0;
+    fork_inst->bytecode_pos = -1;
+    if (jump_desc->flags & OP_HAS_BRANCH) {
+      if (handler.last) {
+        jump_inst->imm.target = handler.last;
+      }
+    }
+    if (fork_desc->flags & OP_HAS_BRANCH) {
+      fork_inst->imm.target = jump_inst;
+    }
+    if (exp_ops > 0) {
+      if (exp.first) {
+        if (exp.last) {
+          fork_inst->next = exp.first;
+          exp.first->prev = fork_inst;
+          exp.last->next = jump_inst;
+          jump_inst->prev = exp.last;
+        } else {
+          fork_inst->next = jump_inst;
+          jump_inst->prev = fork_inst;
+        }
+      } else {
+        fork_inst->next = jump_inst;
+        jump_inst->prev = fork_inst;
+      }
+    } else {
+      fork_inst->next = jump_inst;
+      jump_inst->prev = fork_inst;
+    }
+    if (handler.first) {
+      jump_inst->next = handler.first;
+      handler.first->prev = jump_inst;
+    }
+    block result;
+    result.first = fork_inst;
+    result.last = handler.last;
+    if (!result.last) {
+      result.last = jump_inst;
+    }
+    return result;
+  }
 }
 
 block gen_label(const char *label, block exp) {
