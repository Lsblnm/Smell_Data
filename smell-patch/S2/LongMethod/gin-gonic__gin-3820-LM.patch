+func fileHeaderFromValue(value reflect.Value) (*multipart.FileHeader, bool) {
+	if !value.IsValid() {
+		return nil, false
+	}
+	switch v := value.Interface().(type) {
+	case *multipart.FileHeader:
+		return v, true
+	case multipart.FileHeader:
+		header := v
+		return &header, true
+	default:
+		if value.Kind() == reflect.Ptr && !value.IsNil() {
+			return fileHeaderFromValue(value.Elem())
+		}
+		return nil, false
+	}
+}
