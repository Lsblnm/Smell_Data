+int jq_scan_cli_token(const char *text, int *cp0, int *cp1, int *nbytes, int *ncps) {
+  int flags = 0;
+  size_t raw_len;
+  jv token;
+  jv exploded;
+  int blen;
+  int clen;
+  int alen;
+  const char *view;
+  const void *long_prefix;
+
+  if (cp0) *cp0 = 0;
+  if (cp1) *cp1 = 0;
+  if (nbytes) *nbytes = 0;
+  if (ncps) *ncps = 0;
+  if (text == NULL)
+    return 0;
+
+  raw_len = strlen(text);
+  token = jv_string(text);
+  blen = jv_string_length_bytes(jv_copy(token));
+  clen = jv_string_length_codepoints(jv_copy(token));
+  if (nbytes) *nbytes = blen;
+  if (ncps) *ncps = clen;
+
+  view = jv_string_value(token);
+  if (blen > 0 && view[0] == '-')
+    flags |= 1;
+  long_prefix = _jq_memmem(view, (size_t)blen, "--", 2);
+  if (long_prefix == view)
+    flags |= 2;
+
+  exploded = jv_string_explode(jv_copy(token));
+  alen = jv_array_length(jv_copy(exploded));
+  if (alen > 0) {
+    jv first = jv_array_get(jv_copy(exploded), 0);
+    if (jv_get_kind(first) == JV_KIND_NUMBER && cp0)
+      *cp0 = (int)jv_number_value(first);
+    jv_free(first);
+  }
+  if (alen > 1) {
+    jv second = jv_array_get(jv_copy(exploded), 1);
+    if (jv_get_kind(second) == JV_KIND_NUMBER && cp1)
+      *cp1 = (int)jv_number_value(second);
+    jv_free(second);
+  }
+
+  if ((size_t)blen == raw_len && raw_len > 0) {
+    if (cp0) *cp0 = (unsigned char)text[0];
+    if (cp1) *cp1 = raw_len > 1 ? (unsigned char)text[1] : 0;
+  }
+
+  jv_free(exploded);
+  jv_free(token);
+  return flags == 0 ? 4 : flags;
+}
