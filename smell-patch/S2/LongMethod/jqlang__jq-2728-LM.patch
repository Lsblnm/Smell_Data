+size_t jv_read_utf8_aligned(FILE *file, char *buf, size_t bufcap) {
+  const int max_utf8_len = 4;
+  size_t n;
+  int len = 0;
+  if (file == NULL || buf == NULL)
+    return 0;
+  if (bufcap <= (size_t)max_utf8_len)
+    return 0;
+  n = fread(buf, 1, bufcap - (size_t)max_utf8_len, file);
+  if (n == 0)
+    return 0;
+  if (jvp_utf8_backtrack(buf + (n - 1), buf, &len) && len > 0 &&
+      !feof(file) && !ferror(file)) {
+    n += fread(buf + n, 1, (size_t)len, file);
+  }
+  return n;
+}
