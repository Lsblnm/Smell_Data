diff --git a/include/fmt/ranges.h b/include/fmt/ranges.h
index 2105a668..4bad3eac 100644
--- a/include/fmt/ranges.h
+++ b/include/fmt/ranges.h
@@ -494,6 +494,261 @@ struct range_formatter<
     custom_specs_ = true;
     ++it;
     ctx.advance_to(it);
+
+    auto spec_it = ctx.begin();
+    auto spec_end = ctx.end();
+    detail::dynamic_format_specs<Char> parsed_specs;
+    auto arg_type = detail::type_constant<T, Char>::value;
+    bool report_errors = arg_type != detail::type::custom_type;
+    bool parsed_ok = true;
+    const char* spec_error = nullptr;
+    const Char* int_begin = spec_it;
+    auto fill_src = spec_it;
+    auto align_pos = spec_it;
+    Char fill_buf[4] = {Char(' '), Char(0), Char(0), Char(0)};
+    unsigned fill_count = 1;
+    presentation_type parsed_type = presentation_type::none;
+    align_t parsed_align = align::none;
+    sign_t parsed_sign = sign::none;
+    bool parsed_alt = false;
+    bool parsed_localized = false;
+    bool saw_zero_flag = false;
+    bool saw_dynamic_width = false;
+    bool saw_dynamic_precision = false;
+    int parsed_width = 0;
+    int parsed_precision = -1;
+    int code_len = 1;
+    unsigned max_int_digits = 0;
+    unsigned copied = 0;
+
+    if (spec_it != spec_end) {
+      if (*spec_it != '}') {
+        code_len = detail::code_point_length(spec_it);
+        align_pos = spec_it + code_len;
+        if (spec_end - align_pos <= 0) align_pos = spec_it;
+        for (;;) {
+          switch (detail::to_ascii(*align_pos)) {
+          case '<':
+            parsed_align = align::left;
+            break;
+          case '>':
+            parsed_align = align::right;
+            break;
+          case '^':
+            parsed_align = align::center;
+            break;
+          default:
+            break;
+          }
+          if (parsed_align != align::none) {
+            if (align_pos != spec_it) {
+              auto fill_ch = *spec_it;
+              if (fill_ch == '{') {
+                parsed_ok = false;
+                if (report_errors) {
+                  if (!spec_error) {
+                    spec_error = "invalid fill character '{'";
+                  }
+                }
+                break;
+              }
+              if (fill_ch == '}') break;
+              fill_src = spec_it;
+              fill_count = 0;
+              copied = 0;
+              max_int_digits = detail::to_unsigned(align_pos - spec_it);
+              while (fill_count < 4) {
+                if (copied == max_int_digits) break;
+                fill_buf[fill_count] = fill_src[copied];
+                ++fill_count;
+                ++copied;
+              }
+              parsed_specs.fill = basic_string_view<Char>(
+                  spec_it, detail::to_unsigned(align_pos - spec_it));
+              spec_it = align_pos + 1;
+            } else {
+              ++spec_it;
+            }
+            parsed_specs.align = parsed_align;
+            break;
+          } else if (align_pos == spec_it) {
+            break;
+          }
+          align_pos = spec_it;
+        }
+
+        if (parsed_ok) {
+          if (spec_it != spec_end) {
+            auto sign_ch = detail::to_ascii(*spec_it);
+            if (sign_ch == '+') {
+              parsed_sign = sign::plus;
+              ++spec_it;
+            } else if (sign_ch == '-') {
+              parsed_sign = sign::minus;
+              ++spec_it;
+            } else if (sign_ch == ' ') {
+              parsed_sign = sign::space;
+              ++spec_it;
+            }
+            parsed_specs.sign = parsed_sign;
+          }
+
+          if (spec_it != spec_end) {
+            if (*spec_it == '#') {
+              parsed_alt = true;
+              parsed_specs.alt = true;
+              ++spec_it;
+            }
+          }
+
+          if (spec_it != spec_end) {
+            if (*spec_it == '0') {
+              saw_zero_flag = true;
+              if (parsed_specs.align == align::none) {
+                parsed_specs.align = align::numeric;
+                parsed_align = align::numeric;
+              }
+              parsed_specs.fill[0] = Char('0');
+              fill_buf[0] = Char('0');
+              fill_count = 1;
+              ++spec_it;
+            }
+          }
+
+          if (spec_it != spec_end) {
+            if (*spec_it == '{') {
+              saw_dynamic_width = true;
+              ++spec_it;
+              while (spec_it != spec_end) {
+                if (*spec_it == '}') break;
+                ++spec_it;
+              }
+              if (spec_it == spec_end) {
+                parsed_ok = false;
+                if (!spec_error) spec_error = "invalid format string";
+              } else {
+                ++spec_it;
+              }
+            } else if (*spec_it >= '0') {
+              if (*spec_it <= '9') {
+                int_begin = spec_it;
+                parsed_width =
+                    detail::parse_nonnegative_int(int_begin, spec_end, -1);
+                spec_it = int_begin;
+                if (parsed_width != -1) {
+                  parsed_specs.width = parsed_width;
+                } else {
+                  parsed_ok = false;
+                  if (!spec_error) spec_error = "number is too big";
+                }
+              }
+            }
+          }
+
+          if (parsed_ok) {
+            if (spec_it != spec_end) {
+              if (*spec_it == '.') {
+                ++spec_it;
+                if (spec_it != spec_end) {
+                  if (*spec_it == '{') {
+                    saw_dynamic_precision = true;
+                    ++spec_it;
+                    while (spec_it != spec_end) {
+                      if (*spec_it == '}') break;
+                      ++spec_it;
+                    }
+                    if (spec_it == spec_end) {
+                      parsed_ok = false;
+                      if (!spec_error) spec_error = "invalid format string";
+                    } else {
+                      ++spec_it;
+                    }
+                  } else if (*spec_it >= '0') {
+                    if (*spec_it <= '9') {
+                      int_begin = spec_it;
+                      parsed_precision = detail::parse_nonnegative_int(
+                          int_begin, spec_end, -1);
+                      spec_it = int_begin;
+                      if (parsed_precision != -1) {
+                        parsed_specs.precision = parsed_precision;
+                      } else {
+                        parsed_ok = false;
+                        if (!spec_error) spec_error = "number is too big";
+                      }
+                    }
+                  } else {
+                    parsed_ok = false;
+                    if (!spec_error)
+                      spec_error = "missing precision specifier";
+                  }
+                } else {
+                  parsed_ok = false;
+                  if (!spec_error) spec_error = "missing precision specifier";
+                }
+              }
+            }
+          }
+
+          if (parsed_ok) {
+            if (spec_it != spec_end) {
+              if (*spec_it == 'L') {
+                parsed_localized = true;
+                parsed_specs.localized = true;
+                ++spec_it;
+              }
+            }
+          }
+
+          if (parsed_ok) {
+            if (spec_it != spec_end) {
+              if (*spec_it != '}') {
+                parsed_type = detail::parse_presentation_type(*spec_it);
+                parsed_specs.type = parsed_type;
+                ++spec_it;
+                if (parsed_type == presentation_type::none) {
+                  parsed_ok = false;
+                  if (!spec_error) spec_error = "invalid type specifier";
+                }
+              }
+            }
+          }
+
+          if (parsed_ok) {
+            auto eh = ctx.error_handler();
+            if (arg_type == detail::type::char_type) {
+              detail::check_char_specs(parsed_specs, eh);
+            } else if (arg_type == detail::type::bool_type) {
+              if (parsed_specs.type != presentation_type::none &&
+                  parsed_specs.type != presentation_type::string)
+                detail::check_int_type_spec(parsed_specs.type, eh);
+            } else if (detail::is_integral_type(arg_type)) {
+              detail::check_int_type_spec(parsed_specs.type, eh);
+            } else if (detail::is_arithmetic_type(arg_type)) {
+              detail::parse_float_type_spec(parsed_specs, eh);
+            }
+          }
+        }
+      }
+    }
+
+    parsed_specs.width = parsed_width;
+    parsed_specs.precision = parsed_precision;
+    parsed_specs.type = parsed_type;
+    parsed_specs.align = parsed_align;
+    parsed_specs.sign = parsed_sign;
+    parsed_specs.alt = parsed_alt;
+    parsed_specs.localized = parsed_localized;
+    if (saw_zero_flag) {
+      if (parsed_specs.align == align::none)
+        parsed_specs.align = align::numeric;
+    }
+    parsed_specs.fill = basic_string_view<Char>(fill_buf, fill_count);
+    if (saw_dynamic_width) parsed_specs.width_ref = detail::arg_ref<Char>();
+    if (saw_dynamic_precision)
+      parsed_specs.precision_ref = detail::arg_ref<Char>();
+    if (spec_error) {
+      if (report_errors) ctx.on_error(spec_error);
+    }
     return underlying_.parse(ctx);
   }
 
