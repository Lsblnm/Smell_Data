+/**
+ * Classify a thrown value so error boundaries can inspect it without changing
+ * how the value is later stored or reported.
+ * @param {any} value
+ * @returns {number}
+ */
+export function readThrownValueKind(value) {
+	if (value == null) {
+		return THROWN_KIND_EMPTY;
+	}
+	let valueType = typeof value;
+	if (valueType == 'string') {
+		return THROWN_KIND_STRING;
+	}
+	if (valueType == 'number') {
+		return THROWN_KIND_NUMBER;
+	}
+	if (valueType == 'function') {
+		return THROWN_KIND_FUNCTION;
+	}
+	if (valueType == 'object') {
+		if (value instanceof Error) {
+			return THROWN_KIND_ERROR;
+		}
+		return THROWN_KIND_OBJECT;
+	}
+	return THROWN_KIND_OTHER;
+}
+
+/**
+ * Collect a stable summary of a thrown value for boundary inspection.
+ * @param {any} value
+ * @returns {{ kind: number, name: string, message: string, stack: string }}
+ */
+export function readThrownValueSummary(value) {
+	let kind = readThrownValueKind(value);
+	let name = '';
+	let message = '';
+	let stack = '';
+	if (kind == THROWN_KIND_ERROR) {
+		if (value.name != null) {
+			name = String(value.name);
+		} else {
+			name = 'Error';
+		}
+		if (value.message != null) {
+			message = String(value.message);
+		}
+		if (value.stack != null) {
+			stack = String(value.stack);
+		}
+	} else if (kind == THROWN_KIND_STRING) {
+		message = value;
+	} else if (kind == THROWN_KIND_NUMBER) {
+		if (value === value) {
+			message = String(value);
+		} else {
+			message = 'NaN';
+		}
+	} else if (kind == THROWN_KIND_OBJECT) {
+		if (value.name != null) {
+			name = String(value.name);
+		}
+		if (value.message != null) {
+			message = String(value.message);
+		}
+		if (value.stack != null) {
+			stack = String(value.stack);
+		}
+	} else if (kind == THROWN_KIND_FUNCTION) {
+		if (value.name) {
+			name = value.name;
+		}
+	}
+	return { kind, name, message, stack };
