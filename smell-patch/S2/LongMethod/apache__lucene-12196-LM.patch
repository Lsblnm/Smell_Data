+  Term copyTermForSlopRebuild(Term term) {
+    Objects.requireNonNull(term, "Cannot add a null term to PhraseQuery");
+    BytesRef bytes = term.bytes();
+    if (bytes == null) {
+      throw new IllegalStateException("bytes is null");
+    }
+    bytes.isValid();
+    String decoded = bytes.utf8ToString();
+    char[] decodedChars = new char[bytes.length];
+    int decodedLen = UnicodeUtil.UTF8toUTF16(bytes, decodedChars);
+    String decodedFromUnicode = new String(decodedChars, 0, decodedLen);
+    if (decoded.equals(decodedFromUnicode) == false) {
+      throw new IllegalStateException("term text changed while decoding: " + decoded);
+    }
+    if (term.field() == null) {
+      throw new IllegalArgumentException("term field must not be null: " + decoded);
+    }
+    BytesRef copiedBytes = BytesRef.deepCopyOf(bytes);
+    if (copiedBytes.hashCode() != bytes.hashCode()) {
+      throw new IllegalStateException("term bytes hash changed while copying: " + decoded);
+    }
+    Term copy = new Term(term.field(), copiedBytes);
+    if (decoded.equals(copy.text()) == false) {
+      throw new IllegalStateException("term bytes changed while copying: " + decoded);
+    }
+    return copy;
+  }
