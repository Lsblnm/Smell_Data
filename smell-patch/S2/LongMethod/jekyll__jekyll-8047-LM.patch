@@ -18,5 +29,45 @@ module Jekyll
 
       lookup || variable
     end
+
+    def self.normalized_expression_markup(markup)
+      Jekyll::Utils.normalized_expression_markup(markup)
+    end
+
+    def self.expression_markup_kind(markup)
+      text = normalized_expression_markup(markup)
+      return :blank_literal if text.nil? || text == ""
+      return :boolean_true if text == "true"
+      return :boolean_false if text == "false"
+      return :nil_literal if text == "nil"
+      return :null_literal if text == "null"
+      return :blank_method if text == "blank"
+      return :empty_method if text == "empty"
+      if text.start_with?("'") && text.end_with?("'") && text.length >= 2
+        return :single_string
+      end
+      if text.start_with?('"') && text.end_with?('"') && text.length >= 2
+        return :double_string
+      end
+      return :integer if Jekyll::Utils.integer_expression_markup?(text)
+      if text.start_with?("(") && text.end_with?(")") && text.include?("..")
+        return :range
+      end
+      return :float if Jekyll::Utils.float_expression_markup?(text)
+      :identifier
+    end
+
+    def self.expression_markup_segments(markup)
+      text = normalized_expression_markup(markup)
+      if text.include?("[")
+        [text]
+      else
+        text.split(".")
+      end
+    end
+
+    def self.comparison_operator_category(operator)
+      COMPARISON_OPERATORS[operator.to_s]
+    end
   end
 end
