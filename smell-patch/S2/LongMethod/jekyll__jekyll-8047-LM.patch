@@ -2,6 +2,17 @@
 
 module Jekyll
   module LiquidExtensions
+    COMPARISON_OPERATORS = {
+      "=="       => :equality,
+      "!="       => :inequality,
+      "<>"       => :inequality,
+      "<"        => :less_than,
+      ">"        => :greater_than,
+      "<="       => :less_or_equal,
+      ">="       => :greater_or_equal,
+      "contains" => :containment,
+    }.freeze
+
