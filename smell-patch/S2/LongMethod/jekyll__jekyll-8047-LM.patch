--- a/lib/jekyll/utils.rb
+++ b/lib/jekyll/utils.rb
@@ -312,6 +312,26 @@ module Jekyll
       merged
     end
 
+    INTEGER_EXPRESSION_MARKUP = %r!\A-?\d+\z!.freeze
+    FLOAT_EXPRESSION_MARKUP = %r!\A-?\d[\d.]+\z!.freeze
+
+    def normalized_expression_markup(markup)
+      text = markup.nil? ? "" : markup.to_s
+      encoding = Utils::Platforms.liquid_parser_encoding
+      if text.encoding != encoding
+        text = text.encode(encoding)
+      end
+      text
+    end
+
+    def integer_expression_markup?(markup)
+      INTEGER_EXPRESSION_MARKUP.match?(markup.to_s)
+    end
+
+    def float_expression_markup?(markup)
+      FLOAT_EXPRESSION_MARKUP.match?(markup.to_s)
+    end
+
     private
 
     def merge_values(target, overwrite)
