diff --git a/axum/src/body/mod.rs b/axum/src/body/mod.rs
index c788207c..b88563cc 100644
--- a/axum/src/body/mod.rs
+++ b/axum/src/body/mod.rs
@@ -19,3 +19,29 @@ pub use axum_core::body::{boxed, BoxBody};
 pub(crate) fn empty() -> BoxBody {
     boxed(Empty::new())
 }
+
+pub(crate) fn omitted_response_body() -> BoxBody {
+    empty()
+}
+
+pub(crate) fn response_body_size_hint<B>(body: &B) -> (u64, Option<u64>, Option<u64>)
+where
+    B: HttpBody,
+{
+    let hint = body.size_hint();
+    (hint.lower(), hint.upper(), hint.exact())
+}
+
+pub(crate) fn response_body_known_empty<B>(body: &B) -> bool
+where
+    B: HttpBody,
+{
+    let (lower, upper, exact) = response_body_size_hint(body);
+    if let Some(size) = exact {
+        size == 0
+    } else if let Some(upper) = upper {
+        upper == 0 && lower == 0
+    } else {
+        false
+    }
+}
