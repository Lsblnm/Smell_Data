@@ -413,6 +413,30 @@ module FastlaneCore
       return self.windows? ? path.gsub('/', '\\') : path
     end
 
+    def self.normalize_archive_path(path)
+      return path if path.nil?
+      text = path.to_s
+      return text if text.empty?
+
+      localized = localize_file_path(text)
+      if localized.include?("*") || localized.include?("?") || localized.include?("[")
+        return localized
+      end
+
+      FastlaneCore::FastlaneFolder.working_directories.each do |root|
+        next if root.nil?
+        root_text = root.to_s
+        next if root_text.empty?
+        slash = windows? ? "\\" : "/"
+        prefix = root_text.end_with?(slash) ? root_text : "#{root_text}#{slash}"
+        if localized == root_text || localized.start_with?(prefix)
+          return localized
+        end
+      end
+
+      localized
+    end
