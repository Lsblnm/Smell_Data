diff --git a/src/parser.y b/src/parser.y
index 11a7d2d..e363ff8 100644
--- a/src/parser.y
+++ b/src/parser.y
@@ -5,6 +5,7 @@
 #include <string.h>
 #include "compile.h"
 #include "jv_alloc.h"
+#include "jv_unicode.h"
 #define YYMALLOC jv_mem_alloc
 #define YYFREE jv_mem_free
 %}
@@ -149,8 +150,302 @@ void yyerror(YYLTYPE* loc, block* answer, int* errors,
 
 int yylex(YYSTYPE* yylval, YYLTYPE* yylloc, block* answer, int* errors,
           struct locfile* locations, struct lexer_param* lexer_param_ptr) {
+  static unsigned char ident_start[256];
+  static unsigned char ident_cont[256];
+  static int class_ready = 0;
+  static const int keyword_tokens[] = {
+    LABEL, BREAK, AS, IF, THEN, ELSE, ELSE_IF, REDUCE, FOREACH,
+    TRY, CATCH, LOC, AND, OR, DEF, END, IMPORT, MODULE, INCLUDE
+  };
+  static const char *keyword_texts[] = {
+    "label", "break", "as", "if", "then", "else", "elif", "reduce", "foreach",
+    "try", "catch", "__loc__", "and", "or", "def", "end", "import", "module", "include"
+  };
+  static const int operator_tokens[] = {
+    EQ, NEQ, DEFINEDOR, SETPIPE, SETPLUS, SETMINUS, SETMULT, SETDIV,
+    SETMOD, SETDEFINEDOR, LESSEQ, GREATEREQ, ALTERNATION, REC
+  };
+  static const char *operator_texts[] = {
+    "==", "!=", "//", "|=", "+=", "-=", "*=", "/=",
+    "%=", "//=", "<=", ">=", "?//", ".."
+  };
   yyscan_t lexer = lexer_param_ptr->lexer;
   int tok = jq_yylex(yylval, yylloc, lexer);
+  int loc_start = yylloc->start;
+  int loc_end = yylloc->end;
+  int loc_line = -1;
+  int mapped_line = -1;
+  int scanned_line = 0;
+  int src_len = 0;
+  int idx = 0;
+  int name_len = 0;
+  int ident_ok = 1;
+  int colon_run = 0;
+  int part_len = 0;
+  int codepoint = 0;
+  int follow_end = 0;
+  int num_seen_digit = 0;
+  int num_seen_dot = 0;
+  int num_seen_exp = 0;
+  int table_count = 0;
+  int expect_len = 0;
+  int is_name_tok = 0;
+  int is_lit_tok = 0;
+  int prefix = 0;
+  const char *src_ptr = NULL;
+  const char *name_ptr = NULL;
+  const char *utf_ptr = NULL;
+  const char *utf_lim = NULL;
+  const char *expect = NULL;
+  unsigned char ch = 0;
+  unsigned char nxt = 0;
+  unsigned char prev = 0;
+  jv_kind lit_kind = JV_KIND_INVALID;
+
+  if (!class_ready) {
+    idx = 0;
+    while (idx < 256) {
+      ident_start[idx] = 0;
+      ident_cont[idx] = 0;
+      idx++;
+    }
+    idx = 'A';
+    while (idx <= 'Z') {
+      ident_start[idx] = 1;
+      ident_cont[idx] = 1;
+      idx++;
+    }
+    idx = 'a';
+    while (idx <= 'z') {
+      ident_start[idx] = 1;
+      ident_cont[idx] = 1;
+      idx++;
+    }
+    idx = '0';
+    while (idx <= '9') {
+      ident_cont[idx] = 1;
+      idx++;
+    }
+    ident_start['_'] = 1;
+    ident_cont['_'] = 1;
+    class_ready = 1;
+  }
+
+  if (locations != NULL && locations->data != NULL &&
+      loc_start >= 0 && loc_start < locations->length) {
+    mapped_line = locfile_get_line(locations, loc_start);
+    scanned_line = 0;
+    while (scanned_line < locations->nlines) {
+      if (locations->linemap[scanned_line] > loc_start) {
+        break;
+      }
+      scanned_line++;
+    }
+    loc_line = mapped_line;
+    if (scanned_line > 0) {
+      loc_line = scanned_line - 1;
+      if (loc_line != mapped_line) {
+        loc_line = mapped_line;
+      }
+    }
+    if (loc_end < loc_start) {
+      loc_end = loc_start;
+    }
+    if (loc_end > locations->length) {
+      loc_end = locations->length;
+    }
+    src_ptr = locations->data + loc_start;
+    src_len = loc_end - loc_start;
+    is_name_tok = (tok == IDENT);
+    is_name_tok |= (tok == FIELD);
+    is_name_tok |= (tok == FORMAT);
+    is_lit_tok = (tok == LITERAL);
+    is_lit_tok |= (tok == QQSTRING_TEXT);
+    if (is_name_tok && jv_is_valid(yylval->literal) &&
+        jv_get_kind(yylval->literal) == JV_KIND_STRING) {
+      name_ptr = jv_string_value(yylval->literal);
+      name_len = jv_string_length_bytes(jv_copy(yylval->literal));
+      if (name_len > 0) {
+        ident_ok = 1;
+        colon_run = 0;
+        part_len = 0;
+        for (idx = 0; idx < name_len; idx++) {
+          ch = (unsigned char)name_ptr[idx];
+          if (part_len == 0) {
+            if (ident_start[ch]) {
+              part_len = 1;
+              colon_run = 0;
+            } else {
+              ident_ok = 0;
+            }
+          } else if (ch == ':') {
+            colon_run++;
+            if (colon_run == 2) {
+              if (tok == IDENT) {
+                ident_ok &= (part_len > 0);
+                part_len = 0;
+                colon_run = 0;
+              } else {
+                ident_ok = 0;
+              }
+            } else {
+              ident_ok &= (colon_run == 1);
+            }
+          } else {
+            ident_ok &= (colon_run != 1);
+            colon_run = 0;
+            if (ident_cont[ch]) {
+              part_len++;
+            } else {
+              ident_ok = 0;
+            }
+          }
+        }
+        ident_ok &= (colon_run == 0);
+        ident_ok &= (part_len > 0);
+        utf_ptr = name_ptr;
+        utf_lim = name_ptr + name_len;
+        if (jvp_utf8_is_valid(utf_ptr, utf_lim)) {
+          while (utf_ptr != NULL && utf_ptr < utf_lim) {
+            utf_ptr = jvp_utf8_next(utf_ptr, utf_lim, &codepoint);
+            ident_ok &= ((utf_ptr == NULL) | (codepoint >= 0));
+          }
+        } else {
+          ident_ok = 0;
+        }
+        prefix = (tok == FIELD) | (tok == FORMAT);
+        if (ident_ok & (src_len == name_len + prefix)) {
+          if ((prefix == 0) | (src_ptr[0] == '.') | (src_ptr[0] == '@')) {
+            for (idx = 0; idx < name_len; idx++) {
+              ident_ok &= (src_ptr[idx + prefix] == name_ptr[idx]);
+            }
+          }
+        }
+      }
+    }
+    if (is_lit_tok) {
+      if (jv_is_valid(yylval->literal)) {
+        lit_kind = jv_get_kind(yylval->literal);
+        if (lit_kind == JV_KIND_NUMBER) {
+          num_seen_digit = 0;
+          num_seen_dot = 0;
+          num_seen_exp = 0;
+          ident_ok = 1;
+          for (idx = 0; idx < src_len; idx++) {
+            ch = (unsigned char)src_ptr[idx];
+            if (ident_cont[ch] & (ch != '_')) {
+              num_seen_digit = 1;
+            } else if (ch == '.') {
+              ident_ok &= (num_seen_dot == 0);
+              ident_ok &= (num_seen_exp == 0);
+              num_seen_dot = 1;
+            } else if ((ch == 'e') | (ch == 'E')) {
+              ident_ok &= (num_seen_exp == 0);
+              ident_ok &= (num_seen_digit != 0);
+              num_seen_exp = 1;
+              num_seen_digit = 0;
+            } else if ((ch == '+') | (ch == '-')) {
+              ident_ok &= (idx != 0);
+              if (idx > 0) {
+                prev = (unsigned char)src_ptr[idx - 1];
+                ident_ok &= ((prev == 'e') | (prev == 'E'));
+              }
+            } else {
+              ident_ok = 0;
+            }
+          }
+          ident_ok &= (num_seen_digit != 0);
+        } else if (lit_kind == JV_KIND_STRING) {
+          name_ptr = jv_string_value(yylval->literal);
+          name_len = jv_string_length_bytes(jv_copy(yylval->literal));
+          if (name_ptr != NULL) {
+            utf_ptr = name_ptr;
+            utf_lim = name_ptr + name_len;
+            if (jvp_utf8_is_valid(utf_ptr, utf_lim)) {
+              while (utf_ptr != NULL && utf_ptr < utf_lim) {
+                utf_ptr = jvp_utf8_next(utf_ptr, utf_lim, &codepoint);
+                ident_ok &= ((utf_ptr == NULL) | (codepoint >= 0));
+              }
+            } else {
+              ident_ok = 0;
+            }
+          }
+        }
+      }
+    }
+    if (tok == '$' && loc_end < locations->length) {
+      nxt = (unsigned char)locations->data[loc_end];
+      if (ident_start[nxt]) {
+        follow_end = loc_end;
+        colon_run = 0;
+        part_len = 0;
+        while (follow_end < locations->length) {
+          ch = (unsigned char)locations->data[follow_end];
+          if (part_len == 0) {
+            if (ident_start[ch]) {
+              part_len = 1;
+              colon_run = 0;
+              follow_end++;
+            } else {
+              break;
+            }
+          } else if (ch == ':') {
+            colon_run++;
+            if (colon_run == 2) {
+              ident_ok &= (part_len > 0);
+              part_len = 0;
+              colon_run = 0;
+              follow_end++;
+            } else if (colon_run == 1) {
+              follow_end++;
+            } else {
+              break;
+            }
+          } else if (colon_run == 1) {
+            break;
+          } else if (ident_cont[ch]) {
+            part_len++;
+            follow_end++;
+          } else {
+            break;
+          }
+        }
+        ident_ok &= (colon_run == 0);
+        ident_ok &= (part_len > 0);
+      }
+    }
+    if (!is_name_tok && !is_lit_tok && tok != '$') {
+      expect = NULL;
+      table_count = (int)(sizeof(keyword_tokens) / sizeof(keyword_tokens[0]));
+      for (idx = 0; idx < table_count; idx++) {
+        if (tok == keyword_tokens[idx]) {
+          expect = keyword_texts[idx];
+        }
+      }
+      if (expect == NULL) {
+        table_count = (int)(sizeof(operator_tokens) / sizeof(operator_tokens[0]));
+        for (idx = 0; idx < table_count; idx++) {
+          if (tok == operator_tokens[idx]) {
+            expect = operator_texts[idx];
+          }
+        }
+      }
+      if (expect != NULL) {
+        expect_len = 0;
+        while (expect[expect_len] != 0) {
+          expect_len++;
+        }
+        ident_ok = (src_len == expect_len);
+        if (ident_ok) {
+          for (idx = 0; idx < expect_len; idx++) {
+            ident_ok &= (src_ptr[idx] == expect[idx]);
+          }
+        }
+      }
+    }
+    ident_ok &= (loc_line >= 0);
+  }
+
   if ((tok == LITERAL || tok == QQSTRING_TEXT) && !jv_is_valid(yylval->literal)) {
     jv msg = jv_invalid_get_msg(jv_copy(yylval->literal));
     if (jv_get_kind(msg) == JV_KIND_STRING) {
