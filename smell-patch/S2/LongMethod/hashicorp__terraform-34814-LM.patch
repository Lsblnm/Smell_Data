+// ConnectionRetryInitialDelay is the first pause between communicator connect attempts.
+var ConnectionRetryInitialDelay = time.Second
+
+// ConnectionRetryMaxDelay is the maximum pause between communicator connect attempts.
+var ConnectionRetryMaxDelay = 20 * time.Second
+
+// ExpandScriptPathToken replaces the %RAND% placeholder used in communicator script paths.
+func ExpandScriptPathToken(path string, randVal int64) string {
+	if path == "" {
+		return path
+	}
+	if !strings.Contains(path, "%RAND%") {
+		return path
+	}
+	return strings.Replace(path, "%RAND%", strconv.FormatInt(randVal, 10), -1)
+}
