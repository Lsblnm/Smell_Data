+    /// Collect the scanning knobs that word-boundary confirmation needs.
+    ///
+    /// The fast word matcher has to interpret wrapper bytes according to the
+    /// same Unicode, CRLF and line-terminator settings that produced this
+    /// HIR. Centralizing those knobs here keeps the confirmation path aligned
+    /// with how `(^|\W)(pat)($|\W)` was constructed.
+    pub(crate) fn word_scan_plan(&self) -> WordScanPlan {
+        let line_term_byte = crate::strip::word_line_terminator_byte(
+            self.config.line_terminator,
+            self.config.crlf,
+        );
+        WordScanPlan {
+            unicode: self.config.unicode,
+            crlf: self.config.crlf,
+            multi_line: self.config.multi_line,
+            line_term_byte,
+        }
+    }
