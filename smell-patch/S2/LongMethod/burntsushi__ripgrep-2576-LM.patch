+/// Settings that control how a word match is confirmed against its wrappers.
+#[derive(Clone, Copy, Debug)]
+pub(crate) struct WordScanPlan {
+    pub(crate) unicode: bool,
+    pub(crate) crlf: bool,
+    pub(crate) multi_line: bool,
+    pub(crate) line_term_byte: u8,
+}
