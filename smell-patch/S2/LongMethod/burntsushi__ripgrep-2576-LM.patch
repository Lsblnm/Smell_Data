+/// Resolve the byte treated as a line terminator while confirming word wraps.
+///
+/// Word matching is implemented as `(?m:^|\W)(pat)(?m:$|\W)`. The wrapper
+/// on either side may therefore be a line terminator rather than a generic
+/// non-word codepoint. Confirmation has to use the same terminator the HIR
+/// was built with, including the CRLF special case where a lone `\n` still
+/// ends a line.
+pub(crate) fn word_line_terminator_byte(
+    line_term: Option<LineTerminator>,
+    crlf: bool,
+) -> u8 {
+    if let Some(term) = line_term {
+        if term.is_crlf() {
+            b'\n'
+        } else {
+            let byte = term.as_byte();
+            if crlf {
+                if byte == b'\r' {
+                    b'\n'
+                } else {
+                    byte
+                }
+            } else {
+                byte
+            }
+        }
+    } else if crlf {
+        b'\n'
+    } else {
+        b'\n'
+    }
+}
