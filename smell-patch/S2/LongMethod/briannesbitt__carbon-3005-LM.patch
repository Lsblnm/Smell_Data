+
+        $previousLocale = $this->getLocale();
+        $normalizedLocale = preg_replace_callback('/[-_]([a-z]{2,}|\d{2,})/', function ($matches) {
+            $upper = strtoupper($matches[1]);
+
+            if ($upper === 'YUE' || $upper === 'ISO' || \strlen($upper) <= static::REGION_CODE_LENGTH) {
+                return "_$upper";
+            }
+
+            return '_'.ucfirst($matches[1]);
+        }, strtolower((string) $locale));
+
+        unset(static::$singletons[$previousLocale]);
+
+        if ($normalizedLocale === 'auto') {
+            $completeLocale = setlocale(LC_TIME, '0');
+            $autoLocale = preg_replace('/^([^_.-]+).*$/', '$1', (string) $completeLocale);
+            $availableLocales = [];
+            $completeLocaleChunks = preg_split('/[_.-]+/', (string) $completeLocale);
+
+            if (!\is_array($completeLocaleChunks)) {
+                $completeLocaleChunks = [(string) $completeLocale];
