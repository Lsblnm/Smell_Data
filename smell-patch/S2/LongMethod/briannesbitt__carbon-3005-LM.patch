+        $langDirectory = __DIR__.'/Lang';
+        $directorySeparator = '/';
+        $translationFileSuffix = '.php';
+        $langFileGlobSuffix = '*'.$translationFileSuffix;
+        $resourceFormat = 'array';
+        $loader = new ArrayLoader();
