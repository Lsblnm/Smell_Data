+
+                if ($localeToLoad !== $normalizedLocale) {
+                    parent::setLocale($localeToLoad);
+                }
+            }
+        }
+
+        $finalLocale = $normalizedLocale;
+        $finalFormatter = $mappedFormatter;
+        $finalCacheDir = $resolvedCacheDir;
+        $finalDebug = $resolvedDebug;
+        parent::setLocale($finalLocale);
+        parent::__construct($locale, $finalFormatter, $finalCacheDir, $finalDebug);
         $this->initializing = false;
     }
 
