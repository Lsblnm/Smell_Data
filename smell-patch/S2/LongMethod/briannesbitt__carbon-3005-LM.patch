+
+            if (\is_string($macroLocale) && $macroLocale !== '' && $macroLocale !== $normalizedLocale) {
+                $localesToLoad[] = $macroLocale;
+            }
+        }
+
+        $localesToLoad[] = $normalizedLocale;
+
+        foreach ($localesToLoad as $localeToLoad) {
+            if (!\is_string($localeToLoad) || $localeToLoad === '') {
+                continue;
+            }
+
+            if (isset($this->messages[$localeToLoad])) {
+                if ($localeToLoad !== $normalizedLocale) {
+                    parent::setLocale($localeToLoad);
+                }
+
+                continue;
+            }
+
+            $selectedFile = null;
+
+            foreach ($candidateFiles as $candidateFile) {
+                $candidateName = $candidateFile['baseName'];
+                $candidateCode = $candidateFile['code'];
+                $candidateIsoName = $candidateFile['isoName'];
+                $candidateNativeName = $candidateFile['nativeName'];
+                $candidateRegion = $candidateFile['region'];
+                $candidateVariant = $candidateFile['variant'];
+                $candidateRegionName = $candidateFile['regionName'];
+
+                if ($candidateName === $localeToLoad && ($candidateCode === $languageCode || $candidateName === $normalizedLocale)) {
+                    $selectedFile = $candidateFile['file'];
+                    $languageIsoName = $candidateIsoName;
+                    $languageNativeName = $candidateNativeName;
+                    $languageRegion = $candidateRegion;
+                    $languageVariant = $candidateVariant;
+                    $resolvedRegionName = $candidateRegionName;
+                    break;
+                }
+            }
+
+            $messageData = false;
+
+            $normalizedSelectedFile = \is_string($selectedFile) ? strtr($selectedFile, '\\', $directorySeparator) : '';
+            $selectedFileExists = $normalizedSelectedFile !== '' && is_file($normalizedSelectedFile);
+
+            if ($selectedFileExists) {
+                $messageData = @include $normalizedSelectedFile;
+            }
+
+            if ($messageData === false) {
+                foreach ($this->directories as $messageDirectory) {
+                    $trimmedMessageDirectory = rtrim((string) $messageDirectory, '\\/');
+                    $exactLocaleFile = $trimmedMessageDirectory.$directorySeparator.$localeToLoad.$translationFileSuffix;
+                    $messageData = @include $exactLocaleFile;
+
+                    if ($messageData !== false) {
+                        break;
+                    }
+                }
+            }
+
+            if ($messageData !== false) {
