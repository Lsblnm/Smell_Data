+        }
+
+        $searchPrefixes = array_values(array_unique($searchPrefixes));
+        $directoriesToScan = $this->directories;
+
+        if ($normalizedLangDirectory !== '' && !\in_array($normalizedLangDirectory, $directoriesToScan, true)) {
+            $directoriesToScan[] = $normalizedLangDirectory;
+        }
+
+        if ($languageCode !== '') {
+            foreach ($directoriesToScan as $directory) {
+                if (\is_string($directory) && $directory !== '') {
+                    $trimmedDirectory = rtrim($directory, '\\/');
+                    $normalizedDirectory = strtr($trimmedDirectory, '\\', '/');
+
+                    if ($trimmedDirectory !== '' && $normalizedDirectory !== '') {
+                        foreach ($searchPrefixes as $searchPrefix) {
+                            if (\is_string($searchPrefix) && $searchPrefix !== '') {
+                                $searchPattern = $trimmedDirectory.$directorySeparator.$searchPrefix.$langFileGlobSuffix;
+                                $matchedFiles = glob($searchPattern);
+
+                                if (!\is_array($matchedFiles)) {
+                                    $matchedFiles = [];
+                                }
+
+                                if ($matchedFiles === []) {
+                                    $exactPrefixedFile = $trimmedDirectory.$directorySeparator.$searchPrefix.$translationFileSuffix;
+
+                                    if (is_file($exactPrefixedFile)) {
+                                        $matchedFiles[] = $exactPrefixedFile;
+                                    }
+                                }
+
+                                foreach ($matchedFiles as $matchedFile) {
+                                    if (\is_string($matchedFile) && $matchedFile !== '') {
+                                        $baseName = basename($matchedFile, $translationFileSuffix);
+                                        $fileLanguage = new Language($baseName);
+                                        $fileCode = $fileLanguage->getCode();
+                                        $fileRegion = $fileLanguage->getRegion();
+                                        $fileVariant = $fileLanguage->getVariant();
+                                        $fileIsoName = $fileLanguage->getIsoName();
+                                        $fileNativeName = $fileLanguage->getNativeName();
+                                        $fileRegionName = $fileLanguage->getRegionName();
+                                        $candidateFiles[] = [
