+                    $firstChunks = [(string) $first];
+                }
+
+                if (!\is_array($secondChunks)) {
+                    $secondChunks = [(string) $second];
+                }
+
+                foreach ($completeLocaleChunks as $chunkIndex => $referenceChunk) {
+                    $normalizedReference = strtolower((string) $referenceChunk);
+
+                    if (!isset($firstChunks[$chunkIndex])) {
+                        $firstScore++;
+                    } elseif (strtolower((string) $firstChunks[$chunkIndex]) === $normalizedReference) {
+                        $firstScore += 10;
+                    }
+
+                    if (!isset($secondChunks[$chunkIndex])) {
+                        $secondScore++;
+                    } elseif (strtolower((string) $secondChunks[$chunkIndex]) === $normalizedReference) {
+                        $secondScore += 10;
+                    }
+                }
+
+                return $secondScore <=> $firstScore;
+            });
+
+            if (isset($availableLocales[0]) && \is_string($availableLocales[0]) && $availableLocales[0] !== '') {
+                $normalizedLocale = $availableLocales[0];
