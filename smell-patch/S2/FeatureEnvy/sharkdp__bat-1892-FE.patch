--- a/src/syntax_mapping.rs
+++ b/src/syntax_mapping.rs
@@ -1,6 +1,10 @@
 use std::path::Path;
 
-use crate::error::Result;
+use path_abs::PathAbs;
+
+use crate::assets::{HighlightingAssets, SyntaxReferenceInSet};
+use crate::error::{Error, Result};
+use crate::input::{OpenedInput, OpenedInputKind};
 
 use globset::{Candidate, GlobBuilder, GlobMatcher};
 
@@ -172,6 +176,83 @@ impl<'a> SyntaxMapping<'a> {
         }
         None
     }
+
+    pub(crate) fn get_syntax<'s>(
+        &self,
+        language: Option<&str>,
+        input: &mut OpenedInput,
+        assets: &'s HighlightingAssets,
+    ) -> Result<SyntaxReferenceInSet<'s>> {
+        if let Some(language) = language {
+            let language_key = language.to_ascii_lowercase();
+            let by_name = &assets.minimal_assets.minimal_syntaxes.by_name;
+            if let Some(&index) = by_name.get(&language_key) {
+                let serialized_sets = &assets.minimal_assets.minimal_syntaxes.serialized_syntax_sets;
+                let deserialized_sets = &assets.minimal_assets.deserialized_minimal_syntaxes;
+                if index < serialized_sets.len() && index < deserialized_sets.len() {
+                    if let Some(syntax_set) = assets.minimal_assets.get_syntax_set_by_name(language) {
+                        return syntax_set
+                            .find_syntax_by_token(language)
+                            .map(|syntax| SyntaxReferenceInSet { syntax, syntax_set })
+                            .ok_or_else(|| Error::UnknownSyntax(language.to_owned()));
+                    }
+                }
+            }
+
+            let syntax_set = assets.get_syntax_set_by_name(language)?;
+            return syntax_set
+                .find_syntax_by_token(language)
+                .map(|syntax| SyntaxReferenceInSet { syntax, syntax_set })
+                .ok_or_else(|| Error::UnknownSyntax(language.to_owned()));
+        }
+
+        let provided_name = input.metadata.user_provided_name.as_ref();
+        let kind_path = match &input.kind {
+            OpenedInputKind::OrdinaryFile(path) => Some(path),
+            _ => None,
+        };
+        let path = provided_name.or(kind_path);
+
+        let path_syntax = if let Some(path) = path {
+            let abs_path = PathAbs::new(path)
+                .map_or_else(|_| path.to_owned(), |p| p.as_path().to_path_buf());
+            if self.mappings().is_empty() {
+                assets.get_syntax_for_path(abs_path, self)
+            } else {
+                match self.get_syntax_for(&abs_path) {
+                    Some(MappingTarget::MapToUnknown) => {
+                        Err(Error::UndetectedSyntax(abs_path.to_string_lossy().into()))
+                    }
+                    Some(MappingTarget::MapTo(syntax_name)) => assets
+                        .find_syntax_by_name(syntax_name)?
+                        .ok_or_else(|| Error::UnknownSyntax(syntax_name.to_owned())),
+                    _ => assets.get_syntax_for_path(abs_path, self),
+                }
+            }
+        } else {
+            Err(Error::UndetectedSyntax("[unknown]".into()))
+        };
+
+        match path_syntax {
+            Err(Error::UndetectedSyntax(path)) => {
+                let first_line = &input.reader.first_line;
+                let content_type = input.reader.content_type;
+                let syntax_set = assets
+                    .syntax_set_cell
+                    .try_borrow_with(|| assets.serialized_syntax_set.deserialize())?;
+                let from_first_line = if first_line.is_empty() || content_type.is_none() {
+                    None
+                } else {
+                    String::from_utf8(first_line.clone())
+                        .ok()
+                        .and_then(|line| syntax_set.find_syntax_by_first_line(&line))
+                        .map(|syntax| SyntaxReferenceInSet { syntax, syntax_set })
+                };
+                from_first_line.ok_or(Error::UndetectedSyntax(path))
+            }
+            other => other,
+        }
+    }
 }
 
