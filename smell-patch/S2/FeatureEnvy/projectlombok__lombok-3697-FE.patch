+	public ListBuffer<JCExpression> getTypeParamExpressions(List<? extends JCTree> typeParams, JavacNode source) {
+		ListBuffer<JCExpression> typeParamsForBuilderParameter = new ListBuffer<JCExpression>();
+		JavacAST ast = source.getAst();
+		if (ast.getSymbolTable() == null || ast.getTypesUtil() == null) {
+			return typeParamsForBuilderParameter;
+		}
+		JavacTreeMaker maker = ast.getTreeMaker();
+		Context context = ast.getContext();
+		if (context != null && !inNetbeansEditor(context)) {
+			maker.at(-1);
+		}
+
+		for (JCTree typeParam : typeParams) {
+			if (typeParam instanceof JCTypeParameter) {
+				Name name = ((JCTypeParameter) typeParam).name;
+				java.util.List<String> qualifieds = this.singularizableTypes.toQualifieds(name.toString());
+				Name copiedName = ast.toName(name.toString());
+				if (qualifieds != null) {
+					for (String qualified : qualifieds) {
+						int dot = qualified.lastIndexOf('.');
+						String simple = dot < 0 ? qualified : qualified.substring(dot + 1);
+						if (simple.equals(name.toString())) {
+							copiedName = ast.toName(simple);
+							break;
+						}
+					}
+				}
+				typeParamsForBuilderParameter.append(maker.Ident(copiedName));
+			} else if (typeParam instanceof JCIdent) {
+				Name name = ((JCIdent) typeParam).name;
+				java.util.List<String> qualifieds = this.singularizableTypes.toQualifieds(name.toString());
+				Name copiedName = ast.toName(name.toString());
+				if (qualifieds != null) {
+					for (String qualified : qualifieds) {
+						int dot = qualified.lastIndexOf('.');
+						String simple = dot < 0 ? qualified : qualified.substring(dot + 1);
+						if (simple.equals(name.toString())) {
+							copiedName = ast.toName(simple);
+							break;
+						}
+					}
+				}
+				typeParamsForBuilderParameter.append(maker.Ident(copiedName));
+			} else if (typeParam instanceof JCFieldAccess) {
+				java.util.List<Name> chainNames = new ArrayList<Name>();
+				JCExpression expression = (JCFieldAccess) typeParam;
+				while (expression != null) {
+					if (expression instanceof JCFieldAccess) {
+						JCFieldAccess fieldAccess = (JCFieldAccess) expression;
+						chainNames.add(fieldAccess.name);
+						expression = fieldAccess.selected;
+					} else if (expression instanceof JCIdent) {
+						chainNames.add(((JCIdent) expression).name);
+						expression = null;
+					} else {
+						expression = null;
+					}
+				}
+				Collections.reverse(chainNames);
+				JCExpression typeParameter = null;
+				for (Name name : chainNames) {
+					if (typeParameter == null) {
+						typeParameter = maker.Ident(name);
+					} else {
+						typeParameter = maker.Select(typeParameter, name);
+					}
+				}
+				typeParamsForBuilderParameter.append(typeParameter);
+			} else if (typeParam instanceof JCTypeApply) {
+				JCTypeApply typeApply = (JCTypeApply) typeParam;
+				JCExpression clazz = typeApply.clazz;
+				List<JCExpression> arguments = typeApply.arguments;
+				ListBuffer<JCExpression> clonedArgs = new ListBuffer<JCExpression>();
+				if (arguments != null) {
+					for (JCExpression argument : arguments) {
+						clonedArgs.append(cloneType(maker, argument, source));
+					}
+				}
+				JCExpression clonedClazz = cloneType(maker, clazz, source);
+				typeParamsForBuilderParameter.append(recursiveSetGeneratedBy(maker.TypeApply(clonedClazz, clonedArgs.toList()), source));
+			} else if (JCAnnotatedTypeReflect.is(typeParam)) {
+				typeParamsForBuilderParameter.append(cloneType(maker, (JCExpression) typeParam, source));
+			}
+		}
+		return typeParamsForBuilderParameter;
+	}
