diff --git a/fastlane_core/lib/fastlane_core/command_executor.rb b/fastlane_core/lib/fastlane_core/command_executor.rb
index e95db7b8e..f596b2fe9 100644
--- a/fastlane_core/lib/fastlane_core/command_executor.rb
+++ b/fastlane_core/lib/fastlane_core/command_executor.rb
@@ -3,8 +3,57 @@ require_relative 'globals'
 require_relative 'fastlane_pty'
 
 module FastlaneCore
+  class ZipCommandFlags
+    attr_reader :recursive, :quiet_suffix, :symlink_flag, :filter_set
+
+    def initialize(verbose, symlinks, filter_set)
+      @recursive = "r"
+      @quiet_suffix = verbose ? "" : "q"
+      @symlink_flag = symlinks ? "y" : ""
+      @filter_set = filter_set
+    end
+  end
+
   # Executes commands and takes care of error handling and more
   class CommandExecutor
+    attr_reader :binary_name
+
+    def initialize(binary_name: "zip")
+      @binary_name = binary_name
+    end
+
+    def zip_command(runner)
+      paths = runner.path_details
+      flags = paths.command_flags
+      filters = flags.filter_set
+      params = filters.params
+
+      zip_options = "#{flags.recursive}#{flags.quiet_suffix}#{flags.symlink_flag}"
+      command = [binary_name, "-#{zip_options}"]
+
+      password = runner.password
+      password = params.config_file_options[:password] if password.nil?
+      if password
+        command << "-P"
+        command << password
+      end
+
+      command << runner.output_path
+      command << paths.entry_name
+
+      unless filters.include.empty?
+        command << "-i"
+        command += filters.include.map { |path| File.join(paths.entry_name, path) }
+      end
+
+      unless filters.exclude.empty?
+        command << "-x"
+        command += filters.exclude.map { |path| File.join(paths.entry_name, path) }
+      end
+
+      command
+    end
+
     class << self
       # Cross-platform way of finding an executable in the $PATH. Respects the $PATHEXT, which lists
       # valid file extensions for executables on Windows.
