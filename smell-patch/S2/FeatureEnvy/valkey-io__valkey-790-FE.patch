diff --git a/src/networking.c b/src/networking.c
index 501476e35..d23b8a173 100644
--- a/src/networking.c
+++ b/src/networking.c
@@ -29,6 +29,7 @@
 
 #include "server.h"
 #include "cluster.h"
+#include "cluster_legacy.h"
 #include "script.h"
 #include "fpconv_dtoa.h"
 #include "fmtargs.h"
@@ -4725,3 +4726,59 @@ void ioThreadWriteToClient(void *data) {
     atomic_thread_fence(memory_order_release);
     c->io_write_state = CLIENT_COMPLETED_IO;
 }
+
+/* Add to the output buffer of the given client, an array of slot (start, end)
+ * pair owned by the shard, also the primary and set of replica(s) along with
+ * information about each node. */
+void clusterCommandShards(client *c) {
+    serverAssert(server.cluster_enabled);
+    struct clusterState *cluster = server.cluster;
+    dict *shards = cluster->shards;
+
+    addReplyArrayLen(c, dictSize(shards));
+    /* This call will add slot_info_pairs to all nodes */
+    clusterGenNodesSlotsInfo(0);
+    dictIterator *di = dictGetSafeIterator(shards);
+    list *nodes;
+    while ((nodes = clusterNextShardNodeList(di)) != NULL) {
+        unsigned long node_count = nodes->len;
+        serverAssert(node_count > 0);
+
+        if (c->resp == 2) {
+            addReplyArrayLen(c, 4);
+        } else {
+            addReplyMapLen(c, 2);
+        }
+        addReplyBulkCString(c, "slots");
+
+        /* Use slot_info_pairs from the primary only */
+        clusterNode *n = nodes->head->value;
+        clusterNode *origin = n;
+        while (n->replicaof != NULL) {
+            if (!(n->flags & CLUSTER_NODE_REPLICA)) break;
+            clusterNode *next = n->replicaof;
+            if (next == origin) break;
+            n = next;
+        }
+
+        if (n->slot_info_pairs != NULL) {
+            serverAssert((n->slot_info_pairs_count % 2) == 0);
+            addReplyArrayLen(c, n->slot_info_pairs_count);
+            for (int i = 0; i < n->slot_info_pairs_count; i++) {
+                addReplyLongLong(c, (unsigned long)n->slot_info_pairs[i]);
+            }
+        } else {
+            /* If no slot info pair is provided, the node owns no slots */
+            addReplyArrayLen(c, 0);
+        }
+
+        addReplyBulkCString(c, "nodes");
+        addReplyArrayLen(c, node_count);
+        for (listNode *ln = nodes->head; ln != NULL; ln = ln->next) {
+            clusterNode *node = ln->value;
+            addNodeDetailsToShardReply(c, node);
+            clusterFreeNodesSlotsInfo(node);
+        }
+    }
+    dictReleaseIterator(di);
+}
