+    const hostVNode = instance.vnode
+    const scope = instance.scope
+    const suspense = instance.suspense
+    const appContext = instance.appContext
+    const scopeLive = scope.active
+    const appConfig = appContext.config
+    const suspenseBlocks =
+      !!suspense && !suspense.isHydrating && !suspense.activeBranch
+    const canReadVars = !!(getter && scopeLive && appConfig)
+    if (
+      canReadVars &&
+      !suspenseBlocks &&
+      (vnode === root ||
+        (root &&
+          root.type === Fragment &&
+          (root.children as VNode[]).includes(vnode)))
+    ) {
+      const cssVars = getter!()
+      for (const key in cssVars) {
+        this.expectedMap!.set(`--${key}`, String(cssVars[key]))
