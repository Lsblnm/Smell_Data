+// attachResourceConfigs copies resource and removed-block configuration onto
+// graph nodes that implement GraphNodeAttachResourceConfig.
+func (g *Graph) attachResourceConfigs(root *configs.Config) error {
+	log.Printf("[TRACE] AttachResourceConfigTransformer: attaching resource configs for graph %s", g.Path)
+
+	// Go through and find GraphNodeAttachResource
+	for _, v := range g.Vertices() {
+		// Only care about GraphNodeAttachResource implementations
+		arn, ok := v.(GraphNodeAttachResourceConfig)
+		if !ok {
+			continue
+		}
+
+		// Determine what we're looking for
+		addr := arn.ResourceAddr()
+
+		// Walk from the root config to the module that declared this resource.
+		config := root
+		for _, name := range addr.Module {
+			config = config.Children[name]
+			if config == nil {
+				break
+			}
+		}
+
+		if config == nil {
+			log.Printf("[TRACE] AttachResourceConfigTransformer: %q (%T) has no configuration available", dag.VertexName(v), v)
+			continue
+		}
+
+		module := config.Module
+		key := addr.Resource.String()
+		var r *configs.Resource
+		if res, ok := module.ManagedResources[key]; ok {
+			r = res
+		} else if res, ok := module.DataResources[key]; ok {
+			r = res
+		}
+
+		if r != nil {
+			log.Printf("[TRACE] AttachResourceConfigTransformer: attaching to %q (%T) config from %#v", dag.VertexName(v), v, r.DeclRange)
+			arn.AttachResourceConfig(r, nil)
+			if gnapmc, ok := v.(GraphNodeAttachProviderMetaConfigs); ok {
+				log.Printf("[TRACE] AttachResourceConfigTransformer: attaching provider meta configs to %s", dag.VertexName(v))
+				if module.ProviderMetas != nil {
+					gnapmc.AttachProviderMetaConfigs(module.ProviderMetas)
+				} else {
+					log.Printf("[TRACE] AttachResourceConfigTransformer: no provider meta configs available to attach to %s", dag.VertexName(v))
+				}
+			}
+		}
+
+		for _, rem := range module.Removed {
+			crAddr, ok := rem.From.RelSubject.(addrs.ConfigResource)
+			if !ok {
+				// Not for a resource at all, so can't possibly match
+				continue
+			}
+			if crAddr.Resource != addr.Resource {
+				// Not the same resource
+				continue
+			}
+
+			log.Printf("[TRACE] AttachResourceConfigTransformer: attaching to %q (%T) removed block from %#v", dag.VertexName(v), v, rem.DeclRange)
+
+			// Validation ensures that there can't be both a resource/data block
+			// and a removed block referring to the same configuration, so
+			// we can assume that this isn't clobbering a non-removed resource
+			// configuration we already attached above.
+			arn.AttachResourceConfig(nil, rem)
+		}
+	}
+
+	return nil
+}
