diff --git a/lib/fluent/plugin/in_tail/position_file.rb b/lib/fluent/plugin/in_tail/position_file.rb
index 88614d28..0b5a12cf 100644
--- a/lib/fluent/plugin/in_tail/position_file.rb
+++ b/lib/fluent/plugin/in_tail/position_file.rb
@@ -248,6 +248,55 @@ module Fluent::Plugin
       end
     end
 
-    TargetInfo = Struct.new(:path, :ino)
+    TargetInfo = Struct.new(:path, :ino) do
+      def start_watchers(plugin, targets_info)
+        pf = plugin.instance_variable_get(:@pf)
+        tails = plugin.instance_variable_get(:@tails)
+        follow_inodes = plugin.follow_inodes
+        read_from_head = plugin.read_from_head
+        own_path = path
+
+        targets_info.each_value { |target_info|
+          pe = nil
+          if pf
+            pf_follow_inodes = pf.instance_variable_get(:@follow_inodes)
+            pe = pf[target_info]
+            if read_from_head && pe.read_inode.zero? && (pf_follow_inodes == follow_inodes)
+              begin
+                pe.update(Fluent::FileWrapper.stat(target_info.path).ino, [pe.read_pos, 0].min)
+              rescue Errno::ENOENT
+                $log.warn "#{target_info.path} not found. Continuing without tailing it."
+              end
+            end
+          end
+
+          begin
+            tw = plugin.setup_watcher(target_info, pe)
+          rescue WatcherSetupError => e
+            plugin.log.warn "Skip #{target_info.path} because unexpected setup error happens: #{e}"
+            next
+          end
+
+          begin
+            io_handler = tw.instance_variable_get(:@io_handler)
+            watch_path = if io_handler && io_handler.instance_variable_defined?(:@path)
+                           io_handler.instance_variable_get(:@path)
+                         else
+                           target_info.path
+                         end
+            watch_path = own_path if target_info.equal?(self)
+            target_info = TargetInfo.new(watch_path, Fluent::FileWrapper.stat(target_info.path).ino)
+            tw.unwatched = false if tw.unwatched
+            tails[target_info] = tw
+          rescue Errno::ENOENT
+            $log.warn "stat() for #{target_info.path} failed with ENOENT. Drop tail watcher for now."
+            # explicitly detach and unwatch watcher `tw`.
+            if tw.watchers
+              plugin.stop_watchers(target_info, immediate: true, unwatched: tw.unwatched || true)
+            end
+          end
+        }
+      end
+    end
   end
