+func (h *Head) seriesFromChunkSnapshot(csr chunkSnapshotRecord) (chunks.HeadSeriesRef, *memSeries, error) {
+	series, _, err := h.getOrCreateWithID(csr.ref, csr.lset.Hash(), csr.lset)
+	if err != nil {
+		return 0, nil, err
+	}
+	for {
+		seriesID := uint64(series.ref)
+		lastSeriesID := h.lastSeriesID.Load()
+		if lastSeriesID >= seriesID || h.lastSeriesID.CompareAndSwap(lastSeriesID, seriesID) {
+			break
+		}
+	}
+	return csr.ref, series, nil
+}
+
+func (h *Head) addChunkSnapshotTombstones(tr tombstones.Reader) error {
+	return tr.Iter(func(ref storage.SeriesRef, ivs tombstones.Intervals) error {
+		h.tombstones.AddInterval(ref, ivs...)
+		return nil
+	})
+}
+
+func (h *Head) addChunkSnapshotExemplar(ms *memSeries, e record.RefExemplar) error {
+	return h.exemplars.AddExemplar(ms.lset, exemplar.Exemplar{
+		Labels: e.Labels,
+		Value:  e.V,
+		Ts:     e.T,
+	})
+}
+
+func chunkSnapshotAppender(mc *memChunk) (chunkenc.Appender, error) {
+	return mc.chunk.Appender()
+}
+
+func (h *Head) trackChunkSnapshotWindow(mc *memChunk) {
+	h.updateMinMaxTime(mc.minTime, mc.maxTime)
+}
+
+func decodeChunkSnapshotExemplars(dec *record.Decoder, rec []byte, buf []record.RefExemplar) ([]record.RefExemplar, error) {
+	decbuf := encoding.Decbuf{B: rec[1:]}
+	return dec.ExemplarsFromBuffer(&decbuf, buf)
+}
