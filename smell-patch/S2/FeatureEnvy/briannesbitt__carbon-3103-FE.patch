@@ -13,11 +13,14 @@ declare(strict_types=1);
 
 namespace Carbon;
 
+use BadMethodCallException;
+use Carbon\Exceptions\UnknownUnitException;
 use Closure;
 use DateTimeImmutable;
 use DateTimeInterface;
 use DateTimeZone;
 use InvalidArgumentException;
+use ReflectionException;
 use ReflectionMethod;
 use RuntimeException;
 use Symfony\Contracts\Translation\TranslatorInterface;
@@ -843,4 +846,67 @@ class Factory
             );
         }
     }
+
+    /**
+     * Set any unit to a new value without overflowing current other unit given.
+     */
+    public function applyUnitWithoutOverflow(
+        CarbonInterface $current,
+        string $valueUnit,
+        int $value,
+        string $overflowUnit,
+    ): CarbonInterface {
+        try {
+            $translator = $this->getTranslator();
+            $language = new Language($current->locale);
+            $weekStart = WeekDay::fromNumber((int) (
+                $current->getTranslationMessage('first_day_of_week', $language->getId())
+                ?? $current->getTranslationMessage('first_day_of_week', $language->getId(), null, $translator)
+                ?? 0
+            ))->value;
+
+            if ($overflowUnit === Unit::Week->value) {
+                $start = $current->avoidMutation()->startOfWeek($weekStart);
+                $end = $current->avoidMutation()->endOfWeek();
+            } else {
+                $start = $current->avoidMutation()->startOf($overflowUnit);
+                $end = $current->avoidMutation()->endOf($overflowUnit);
+            }
+
+            /** @var CarbonInterface $date */
+            $date = $current->$valueUnit($value);
+
+            if ($date < $start) {
+                $bound = $start;
+            } elseif ($date > $end) {
+                $bound = $end;
+            } else {
+                return $date;
+            }
+
+            if ($date instanceof DateTimeImmutable) {
+                return $date;
+            }
+
+            $utcDate = $bound->avoidMutation()->utc();
+            $monthNumber = Month::fromNumber($utcDate->month)->value;
+            $timeOfDay = $utcDate->avoidMutation()->startOfDay()->diffAsCarbonInterval($utcDate);
+            $unix = sprintf(
+                '%d.%06d',
+                gmmktime(
+                    $timeOfDay->hours,
+                    $timeOfDay->minutes,
+                    $timeOfDay->seconds,
+                    $monthNumber,
+                    $utcDate->day,
+                    $utcDate->year,
+                ),
+                $timeOfDay->microseconds,
+            );
+
+            return $date->modify('@'.$unix)->setTimezone($bound->timezone);
+        } catch (BadMethodCallException | ReflectionException $exception) {
+            throw new UnknownUnitException($valueUnit, 0, $exception);
+        }
+    }
 }
