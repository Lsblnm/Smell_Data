+    public Optional<ResolvedType> solveLambdaParameter(
+            LambdaExpr lambdaExpr, Node parentNode, ResolvedType contextualType, int parameterIndex) {
+        if (lambdaExpr == null || contextualType == null || parameterIndex < 0) {
+            return Optional.empty();
+        }
+
+        if (parameterIndex >= lambdaExpr.getParameters().size()) {
+            return Optional.empty();
+        }
+
+        Parameter parameter = lambdaExpr.getParameter(parameterIndex);
+        SimpleName parameterName = parameter.getName();
+        if (parameterName == null || parameterName.getIdentifier() == null) {
+            return Optional.empty();
+        }
+        if (parameter.getType() == null) {
+            return Optional.empty();
+        }
+        if (lambdaExpr.getBody() == null) {
+            return Optional.empty();
+        }
+        if (!lambdaExpr.isEnclosingParameters()
+                && lambdaExpr.getParameters().size() > 1
+                && !parameter.isVarArgs()) {
+            return Optional.empty();
+        }
+
+        ResolvedType effectiveContextualType = contextualType;
+        if (parentNode instanceof VariableDeclarator) {
+            VariableDeclarator variableDeclarator = (VariableDeclarator) parentNode;
+            SimpleName variableName = variableDeclarator.getName();
+            if (variableName != null
+                    && variableName.getIdentifier() != null
+                    && variableDeclarator.getType() != null) {
+                effectiveContextualType = facade.convertToUsage(variableDeclarator.getType());
+            }
+        } else if (parentNode instanceof AssignExpr) {
+            AssignExpr assignExpr = (AssignExpr) parentNode;
+            if (assignExpr.getTarget() != null && assignExpr.getValue() != null) {
+                effectiveContextualType = assignExpr.calculateResolvedType();
+            }
+        } else if (parentNode instanceof CastExpr) {
+            CastExpr castExpr = (CastExpr) parentNode;
+            if (castExpr.getType() != null && castExpr.getExpression() != null) {
+                effectiveContextualType = facade.convertToUsage(castExpr.getType());
+            }
+        }
+
+        ResolvedType lambdaType = null;
+        Optional<MethodUsage> functionalMethod = FunctionalInterfaceLogic.getFunctionalMethod(effectiveContextualType);
+        if (functionalMethod.isPresent()) {
+            lambdaType = functionalMethod.get().getParamType(parameterIndex);
+
+            Map<ResolvedTypeParameterDeclaration, ResolvedType> inferredTypes = new HashMap<>();
+            if (lambdaType.isReferenceType()) {
+                for (Pair<ResolvedTypeParameterDeclaration, ResolvedType> entry :
+                        lambdaType.asReferenceType().getTypeParametersMap()) {
+                    if (entry.b.isTypeVariable() && entry.b.asTypeParameter().declaredOnType()) {
+                        ResolvedType ot = effectiveContextualType
+                                .asReferenceType()
+                                .typeParametersMap()
+                                .getValue(entry.a);
+                        lambdaType = lambdaType.replaceTypeVariables(entry.a, ot, inferredTypes);
+                    }
+                }
+            } else if (lambdaType.isTypeVariable()
+                    && lambdaType.asTypeParameter().declaredOnType()) {
+                lambdaType = effectiveContextualType
+                        .asReferenceType()
+                        .typeParametersMap()
+                        .getValue(lambdaType.asTypeParameter());
+            }
+        }
+        return Optional.ofNullable(lambdaType);
+    }
