+impl RouteId {
+    pub(super) fn merge_path_router<S, const IS_FALLBACK: bool>(
+        &self,
+        dest: &mut PathRouter<S, IS_FALLBACK>,
+        other: PathRouter<S, IS_FALLBACK>,
+    ) -> Result<(), Cow<'static, str>>
+    where
+        S: Clone + Send + Sync + 'static,
+    {
+        let mut last_route_id = self.0;
+
+        for (id, endpoint) in other.routes {
+            let path = other
+                .node
+                .route_id_to_path
+                .get(&id)
+                .expect("no path for route id. This is a bug in axum. Please file an issue");
+
+            match endpoint {
+                Endpoint::MethodRouter(mut method_router) => {
+                    if let Some((route_id, Endpoint::MethodRouter(prev_method_router))) = dest
+                        .node
+                        .path_to_route_id
+                        .get(path.as_ref())
+                        .and_then(|route_id| dest.routes.get(route_id).map(|svc| (*route_id, svc)))
+                    {
+                        let mut prev = prev_method_router.clone();
+                        prev.get = match (prev.get, method_router.get) {
+                            (MethodEndpoint::None, MethodEndpoint::None) => MethodEndpoint::None,
+                            (MethodEndpoint::None, MethodEndpoint::Route(route))
+                            | (MethodEndpoint::Route(route), MethodEndpoint::None) => {
+                                MethodEndpoint::Route(Route(route.0))
+                            }
+                            (MethodEndpoint::None, MethodEndpoint::BoxedHandler(handler))
+                            | (MethodEndpoint::BoxedHandler(handler), MethodEndpoint::None) => {
+                                MethodEndpoint::BoxedHandler(BoxedIntoRoute(handler.0))
+                            }
+                            _ => panic!(
+                                "Overlapping method route. Handler for `GET {path}` already exists"
+                            ),
+                        };
+                        prev.head = match (prev.head, method_router.head) {
+                            (MethodEndpoint::None, MethodEndpoint::None) => MethodEndpoint::None,
+                            (MethodEndpoint::None, MethodEndpoint::Route(route))
+                            | (MethodEndpoint::Route(route), MethodEndpoint::None) => {
+                                MethodEndpoint::Route(Route(route.0))
+                            }
+                            (MethodEndpoint::None, MethodEndpoint::BoxedHandler(handler))
+                            | (MethodEndpoint::BoxedHandler(handler), MethodEndpoint::None) => {
+                                MethodEndpoint::BoxedHandler(BoxedIntoRoute(handler.0))
+                            }
+                            _ => panic!(
+                                "Overlapping method route. Handler for `HEAD {path}` already exists"
+                            ),
+                        };
+                        prev.delete = match (prev.delete, method_router.delete) {
+                            (MethodEndpoint::None, MethodEndpoint::None) => MethodEndpoint::None,
+                            (MethodEndpoint::None, MethodEndpoint::Route(route))
+                            | (MethodEndpoint::Route(route), MethodEndpoint::None) => {
+                                MethodEndpoint::Route(Route(route.0))
+                            }
+                            (MethodEndpoint::None, MethodEndpoint::BoxedHandler(handler))
+                            | (MethodEndpoint::BoxedHandler(handler), MethodEndpoint::None) => {
+                                MethodEndpoint::BoxedHandler(BoxedIntoRoute(handler.0))
+                            }
+                            _ => panic!(
+                                "Overlapping method route. Handler for `DELETE {path}` already exists"
+                            ),
+                        };
+                        prev.post = match (prev.post, method_router.post) {
+                            (MethodEndpoint::None, MethodEndpoint::None) => MethodEndpoint::None,
+                            (MethodEndpoint::None, MethodEndpoint::Route(route))
+                            | (MethodEndpoint::Route(route), MethodEndpoint::None) => {
+                                MethodEndpoint::Route(Route(route.0))
+                            }
+                            (MethodEndpoint::None, MethodEndpoint::BoxedHandler(handler))
+                            | (MethodEndpoint::BoxedHandler(handler), MethodEndpoint::None) => {
+                                MethodEndpoint::BoxedHandler(BoxedIntoRoute(handler.0))
+                            }
+                            _ => panic!(
+                                "Overlapping method route. Handler for `POST {path}` already exists"
+                            ),
+                        };
+                        method_router.get = MethodEndpoint::None;
+                        method_router.head = MethodEndpoint::None;
+                        method_router.delete = MethodEndpoint::None;
+                        method_router.post = MethodEndpoint::None;
+                        dest.routes.insert(
+                            route_id,
+                            Endpoint::MethodRouter(
+                                prev.merge_for_path(Some(path.as_ref()), method_router),
+                            ),
+                        );
+                    } else {
+                        last_route_id = last_route_id.checked_add(1).expect(
+                            "Over `u32::MAX` routes created. If you need this, please file an issue.",
+                        );
+                        let new_id = RouteId(last_route_id);
+                        dest.prev_route_id = new_id;
+                        let mut node = Arc::try_unwrap(Arc::clone(&dest.node))
+                            .unwrap_or_else(|node| (*node).clone());
+                        if let Err(err) = node.inner.insert(path.as_ref(), new_id) {
+                            return Err(format!("Invalid route {path:?}: {err}").into());
+                        }
+                        let shared_path: Arc<str> = path.as_ref().into();
+                        node.route_id_to_path.insert(new_id, shared_path.clone());
+                        node.path_to_route_id.insert(shared_path, new_id);
+                        dest.node = Arc::new(node);
+                        dest.routes
+                            .insert(new_id, Endpoint::MethodRouter(method_router));
+                    }
+                }
+                Endpoint::Route(route) => {
+                    last_route_id = last_route_id.checked_add(1).expect(
+                        "Over `u32::MAX` routes created. If you need this, please file an issue.",
+                    );
+                    let new_id = RouteId(last_route_id);
+                    dest.prev_route_id = new_id;
+                    let mut node = Arc::try_unwrap(Arc::clone(&dest.node))
+                        .unwrap_or_else(|node| (*node).clone());
+                    if let Err(err) = node.inner.insert(path.as_ref(), new_id) {
+                        return Err(format!("Invalid route {path:?}: {err}").into());
+                    }
+                    let shared_path: Arc<str> = path.as_ref().into();
+                    node.route_id_to_path.insert(new_id, shared_path.clone());
+                    node.path_to_route_id.insert(shared_path, new_id);
+                    dest.node = Arc::new(node);
+                    dest.routes.insert(new_id, Endpoint::Route(Route(route.0)));
+                }
+            }
+        }
+
+        Ok(())
+    }
+}
