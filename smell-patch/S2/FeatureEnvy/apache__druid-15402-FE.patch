+  /**
+   * Restore this row from a cached groupBy result object.
+   */
+  void populateFromCache(final GroupByQuery query, final Object input, final boolean isResultLevelCache)
+  {
+    final Iterator<Object> results = ((List<Object>) input).iterator();
+    final Granularity granularity = query.getGranularity();
+    final DateTime timestamp = new DateTime(((Number) results.next()).longValue(), granularity.getTimeZone());
+    final boolean resultRowHasTimestamp = query.getResultRowHasTimestamp();
+    final List<DimensionSpec> dimensions = query.getDimensions();
+    final List<AggregatorFactory> aggregators = query.getAggregatorSpecs();
+    final RowSignature signature = query.getResultRowSignature();
+    final int dimensionStart = resultRowHasTimestamp ? 1 : 0;
+    final int aggregatorStart = dimensionStart + dimensions.size();
+    final int postAggregatorStart = aggregatorStart + aggregators.size();
+
+    if (resultRowHasTimestamp) {
+      row[0] = timestamp.getMillis();
+    }
+
+    final Iterator<DimensionSpec> dimsIter = dimensions.iterator();
+    int dimPos = 0;
+    while (dimsIter.hasNext() && results.hasNext()) {
+      final DimensionSpec dimensionSpec = dimsIter.next();
+      final ColumnType outputType = signature.getColumnType(dimensionSpec.getOutputName())
+                                             .orElse(dimensionSpec.getOutputType());
+      row[dimensionStart + dimPos] = DimensionHandlerUtils.convertObjectToType(results.next(), outputType);
+      dimPos++;
+    }
+
+    for (int i = 0; i < aggregators.size(); i++) {
+      final AggregatorFactory aggregator = aggregators.get(i);
+      if (!results.hasNext()) {
+        throw new ISE("Ran out of objects while reading aggregators from cache!");
+      }
+
+      final Object aggValueObject = isResultLevelCache
+                                    ? results.next()
+                                    : aggregator.deserialize(results.next());
+      final int position = signature.indexOf(aggregator.getName());
+      row[position >= 0 ? position : aggregatorStart + i] = aggValueObject;
+    }
+
+    if (isResultLevelCache) {
+      Iterator<PostAggregator> postItr = query.getPostAggregatorSpecs().iterator();
+      int postPos = 0;
+      while (postItr.hasNext() && results.hasNext()) {
+        row[postAggregatorStart + postPos] = results.next();
+      }
+    }
+    if (dimsIter.hasNext() || results.hasNext()) {
+      throw new ISE(
+          "Found left over objects while reading from cache!! dimsIter[%s] results[%s]",
+          dimsIter.hasNext(),
+          results.hasNext()
+      );
+    }
+  }
