+  template <typename OutputIt, typename UInt, typename Char>
+  auto write_grouped(OutputIt out, UInt abs_value, unsigned prefix,
+                     const format_specs& specs,
+                     const detail::digit_grouping<Char>& grouping,
+                     detail::arg_ref<char> width_ref = {}) const -> OutputIt {
+    if (specs.type == presentation_type::hex ||
+        specs.type == presentation_type::oct ||
+        specs.type == presentation_type::bin ||
+        specs.type == presentation_type::chr) {
+      return detail::write_nondecimal_grouped(out, abs_value, prefix, specs,
+                                              grouping);
+    }
+
+    int width = specs.width != 0 ? specs.width : specs_.width;
+    if (width_ref.kind != detail::arg_id_kind::none && specs.width == 0)
+      width = specs_.width;
+    auto align = specs.align;
+    const auto& fill_spec = specs.fill;
+    size_t fill_size = fill_spec.size();
+
+    int num_digits = detail::count_digits(abs_value);
+    auto buffer = memory_buffer();
+    detail::format_decimal<char>(appender(buffer), abs_value, num_digits);
+    const char* digit_data = buffer.data();
+    size_t digit_count = buffer.size();
+    auto digits = string_view(digit_data, digit_count);
+    const char* view_data = digits.data();
+    size_t view_size = digits.size();
+
+    const auto& grouping_pattern = grouping.grouping();
+    const auto& thousands_sep = grouping.separator();
+    int extra_seps = grouping_pattern.empty()
+                         ? 0
+                         : grouping.count_separators(num_digits);
+    unsigned size = (prefix != 0 ? prefix >> 24 : 0) +
+                    detail::to_unsigned(num_digits) +
+                    detail::to_unsigned(extra_seps);
+
+    unsigned spec_width = detail::to_unsigned(width);
+    size_t padding = spec_width > size ? spec_width - size : 0;
+    auto* shifts = "\x00\x1f\x00\x01";
+    size_t left_padding = padding >> shifts[align];
+    size_t right_padding = padding - left_padding;
+    auto it = detail::reserve(out, size + padding * fill_size);
+    if (left_padding != 0) it = detail::fill<Char>(it, left_padding, fill_spec);
+    for (unsigned p = prefix & 0xffffff; p != 0; p >>= 8)
+      *it++ = static_cast<Char>(p & 0xff);
+    if (thousands_sep.empty()) {
+      it = detail::copy<Char>(view_data, view_data + view_size, it);
+    } else {
+      it = grouping.apply(it, string_view(view_data, view_size));
+    }
+    if (right_padding != 0)
+      it = detail::fill<Char>(it, right_padding, fill_spec);
+    return detail::base_iterator(out, it);
+  }
