index 0f8744b37..3d6908ee6 100644
--- a/fastlane/lib/fastlane/helper/s3_client_helper.rb
+++ b/fastlane/lib/fastlane/helper/s3_client_helper.rb
@@ -1,4 +1,5 @@
 require 'aws-sdk-s3'
+require 'fastlane_core/helper'
 
 module Fastlane
   module Helper
@@ -14,6 +15,40 @@ module Fastlane
         @client = s3_client
       end
 
+      def download_storage_objects(storage, encryption, account, bucket_option, appfile)
+        option_key = bucket_option.key if bucket_option
+        option_env = bucket_option.env_name if bucket_option
+        bucket_name = storage.s3_bucket
+        bucket_name = ENV[option_env] if bucket_name.to_s.empty? && option_env.to_s.length > 0
+
+        object_prefix = storage.s3_object_prefix.to_s
+        storage_root = storage.working_directory
+        encrypted_root = encryption.working_directory
+        working_directory = encrypted_root.to_s.empty? ? storage_root : encrypted_root
+        client = storage.s3_client
+
+        region_label = storage.s3_region
+        region_label = region if region_label.to_s.empty?
+
+        appfile_team = appfile.data[:team_id] if appfile
+        team_context = storage.team_id
+        team_context = appfile_team if team_context.to_s.empty?
+
+        keychain_identity = [account.prefix, encryption.keychain_name].join("_")
+        UI.verbose("Downloading match files for #{keychain_identity} (team #{team_context.inspect}, option #{option_key.inspect}, region #{region_label.inspect})")
+
+        client.find_bucket!(bucket_name).objects(prefix: object_prefix).each do |object|
+          file_path = object.key.gsub(/^#{object_prefix}/, "") # :s3_object_prefix:team_id/path/to/file
+
+          # strip s3_prefix from file_path
+          download_path = FastlaneCore::Helper.prepare_nested_file_path(working_directory, file_path)
+          UI.verbose("Downloading file from S3 '#{file_path}' on bucket #{bucket_name}")
+
+          object.download_file(download_path)
+        end
+        UI.verbose("Successfully downloaded files from S3 to #{working_directory}")
+      end
+
       def list_buckets
         return client.list_buckets
       end
