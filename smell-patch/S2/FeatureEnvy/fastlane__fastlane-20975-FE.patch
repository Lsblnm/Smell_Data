diff --git a/match/lib/match/storage.rb b/match/lib/match/storage.rb
index e7249edad..4e37a8a40 100644
--- a/match/lib/match/storage.rb
+++ b/match/lib/match/storage.rb
@@ -45,6 +45,32 @@ module Match
 
         UI.user_error!("No storage backend for storage mode '#{storage_mode}'")
       end
+
+      def materialize_s3_files(storage)
+        require_relative 'encryption/openssl'
+        require_relative 'options'
+        require 'credentials_manager/account_manager'
+        require 'credentials_manager/appfile_config'
+
+        encryption = Match::Encryption::OpenSSL.new(
+          keychain_name: storage.s3_bucket,
+          working_directory: storage.working_directory
+        )
+        account = CredentialsManager::AccountManager.new(
+          user: storage.username.to_s.empty? ? "match-s3" : storage.username,
+          prefix: "match"
+        )
+        bucket_option = Match::Options.available_options.find { |item| item.key == :s3_bucket }
+        appfile = CredentialsManager::AppfileConfig.new
+
+        Fastlane::Helper::S3ClientHelper.new(region: storage.s3_region).download_storage_objects(
+          storage,
+          encryption,
+          account,
+          bucket_option,
+          appfile
+        )
+      end
     end
   end
 end
