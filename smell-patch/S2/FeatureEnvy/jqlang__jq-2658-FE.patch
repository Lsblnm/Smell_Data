+void jq_util_input_add_input(jq_util_input_state *state, const char *text) {
+  if (state->remaining_mode == JQ_INPUT_STRINGS) {
+    int idx = positional_arg_count;
+    state->positional = jv_array_set(state->positional, idx, jv_string(text));
+    positional_arg_count = idx + 1;
+    return;
+  }
+
+  if (state->remaining_mode == JQ_INPUT_JSON) {
+    jv src = jv_string(text);
+    int len = jv_string_length_bytes(jv_copy(src));
+    const char *s = jv_string_value(src);
+    jv_parser *p = jv_parser_new(0);
+    jv_parser_set_buf(p, s, len, 0);
+    jv parsed = jv_parser_next(p);
+    if (jv_is_valid(parsed) &&
+        (p->curr_buf_pos < p->curr_buf_length || !p->eof || p->tokenpos > 0)) {
+      jv extra = jv_parser_next(p);
+      if (jv_is_valid(extra)) {
+        jv_free(parsed);
+        jv_free(extra);
+        parsed = jv_invalid_with_msg(jv_string("Unexpected extra JSON values"));
+      } else if (jv_invalid_has_msg(jv_copy(extra))) {
+        jv_free(parsed);
+        parsed = extra;
+      } else {
+        jv_free(extra);
+      }
+    } else if (!jv_is_valid(parsed) && !jv_invalid_has_msg(jv_copy(parsed))) {
+      jv_free(parsed);
+      parsed = jv_invalid_with_msg(jv_string("Expected JSON value"));
+    }
+    if (!jv_is_valid(parsed) && jv_invalid_has_msg(jv_copy(parsed))) {
+      jv msg = jv_invalid_get_msg(parsed);
+      parsed = jv_invalid_with_msg(jv_string_fmt("%s (while parsing '%s')",
+                                                jv_string_value(msg),
+                                                text));
+      jv_free(msg);
+    }
+    jv_parser_free(p);
+    jv_free(src);
+    int idx = positional_arg_count;
+    state->positional = jv_array_set(state->positional, idx, parsed);
+    positional_arg_count = idx + 1;
+    return;
+  }
+
+  state->files = jv_mem_realloc(state->files, (state->nfiles + 1) * sizeof(state->files[0]));
+  state->files[state->nfiles++] = jv_mem_strdup(text);
+}
