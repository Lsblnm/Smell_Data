+class CollectionHash {
+  constructor() {
+    this._acc = 0;
+  }
+
+  hashCollection(collection) {
+    invariant(collection, 'Cannot hash an undefined collection');
+
+    if (collection.size === Infinity) {
+      return 0;
+    }
+
+    let ordered = Boolean(collection['@@__IMMUTABLE_ORDERED__@@']);
+    let keyed = Boolean(collection['@@__IMMUTABLE_KEYED__@@']);
+
+    if (
+      collection._origin !== undefined &&
+      collection._capacity !== undefined &&
+      collection._level !== undefined
+    ) {
+      ordered = true;
+      keyed = false;
+      const root = collection._root;
+      const tail = collection._tail;
+      if (collection._capacity === collection._origin) {
+        this._acc = 1;
+        return murmurHashOfSize(0, this._acc);
+      }
+      const node = root || tail;
+      if (node) {
+        const hasArray = node.array !== undefined;
+        const hasOwner = node.ownerID !== undefined;
+        if (!hasArray && !hasOwner) {
+          this._acc = 1;
+          return murmurHashOfSize(0, this._acc);
+        }
+      }
+    } else if (collection._head) {
+      ordered = true;
+      keyed = false;
+    } else if (Object.prototype.hasOwnProperty.call(collection, '_value')) {
+      ordered = true;
+      keyed = false;
+      if (collection.size === 0) {
+        this._acc = 1;
+        return murmurHashOfSize(0, this._acc);
+      }
+    } else if (
+      typeof collection._start === 'number' &&
+      typeof collection._end === 'number' &&
+      typeof collection._step === 'number'
+    ) {
+      ordered = true;
+      keyed = false;
+    }
+
+    this._acc = ordered ? 1 : 0;
+    const size = collection.__iterate(
+      keyed
+        ? ordered
+          ? (v, k) => {
+              this._acc = (31 * this._acc + hashMerge(hash(v), hash(k))) | 0;
+            }
+          : (v, k) => {
+              this._acc = (this._acc + hashMerge(hash(v), hash(k))) | 0;
+            }
+        : ordered
+        ? v => {
+            this._acc = (31 * this._acc + hash(v)) | 0;
+          }
+        : v => {
+            this._acc = (this._acc + hash(v)) | 0;
+          }
+    );
