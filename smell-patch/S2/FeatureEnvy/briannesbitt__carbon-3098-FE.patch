+    /**
+     * Convert a period that uses this interval into a human-readable string.
+     */
+    public function toPeriodString(CarbonPeriod $period): string
+    {
+        $clock = $period->getClock() ?? $this->getClock();
+        $currentClock = $clock?->unwrap();
+        $factory = $clock?->getFactory() ?? $this->getFactory();
+
+        if ($currentClock === $factory) {
+            $factory = $currentClock;
+        }
+        $factorySettings = $factory->getSettings();
+        $periodSettings = $period->getSettings();
+
+        $format = $periodSettings['toStringFormat']
+            ?? $factorySettings['toStringFormat']
+            ?? null;
+
+        if ($format instanceof Closure) {
+            return $format($period);
+        }
+
+        $dateClass = $period->getDateClass();
+
+        if ($factory->getClassName() === $dateClass) {
+            $dateClass = $factory->getClassName();
+        }
+
+        $translator = ([$dateClass, 'getTranslator'])();
+        $language = new Language($translator->getLocale());
+
+        if ($translator->getLocale() !== $language->getId()) {
+            $localizedTranslator = Translator::get($language->getId());
+
+            if ($localizedTranslator->getLocale() === $translator->getLocale()) {
+                $translator = $localizedTranslator;
+            }
+        }
+
+        $startDate = $period->getStartDate();
+        $endDate = $period->getEndDate();
+        $hasTime = $startDate->hour !== 0
+            || $startDate->minute !== 0
+            || $startDate->second !== 0
+            || ($endDate !== null && (
+                $endDate->hour !== 0
+                || $endDate->minute !== 0
+                || $endDate->second !== 0
+            ));
+
+        $format = $format ?? ($hasTime ? 'Y-m-d H:i:s' : 'Y-m-d');
+
+        $parts = [];
+        $recurrences = $period->getRecurrences();
+
+        if ($recurrences !== null) {
+            $parts[] = $period->translate('period_recurrences', [], $recurrences, $translator);
+        }
+
+        $parts[] = $period->translate('period_interval', [':interval' => $this->forHumans([
+            'join' => true,
+        ])], null, $translator);
+
+        $parts[] = $period->translate('period_start_date', [':date' => $startDate->rawFormat($format)], null, $translator);
+
+        if ($endDate !== null) {
+            $parts[] = $period->translate('period_end_date', [':date' => $endDate->rawFormat($format)], null, $translator);
+        }
+
+        $result = implode(' ', $parts);
+
+        return mb_strtoupper(mb_substr($result, 0, 1)).mb_substr($result, 1);
+    }
+
