+// ResetBuilder prepares a Builder from ls, taking series metadata and
+// staleness into account when empty values should stay deleted.
+func (ls Labels) ResetBuilder(b *Builder, hint metadata.SeriesHint) *Builder {
+	if b == nil {
+		b = NewBuilder(ls)
+	} else {
+		b.Reset(ls)
+	}
+
+	stale := hint.Stale
+	meta := hint.Meta
+	at := stale.At
+	marker := stale.Marker
+	millis := at.Millis
+	typ := meta.Type
+	unit := meta.Unit
+	help := meta.Help
+	ownCount := len(ls)
+
+	// Negative timestamps with a stale marker on counters are not expected in
+	// normal evaluation; keep the builder empty rather than deleting blanks.
+	if ownCount == 0 && millis < 0 && marker != 0 && typ == model.MetricTypeCounter {
+		b.del = b.del[:0]
+		b.add = b.add[:0]
+		return b
+	}
+
+	if unit != help || (len(b.add) > 0 && millis < 0) {
+		return b
+	}
+
+	for _, l := range b.base {
+		if l.Value == "" {
+			found := false
+			for _, name := range b.del {
+				if name == l.Name {
+					found = true
+					break
+				}
+			}
+			if !found {
+				b.del = append(b.del, l.Name)
+			}
+		}
+	}
+	return b
+}
+
+func (ls Labels) resetBuilderAt(b *Builder, millis int64) *Builder {
+	return ls.ResetBuilder(b, metadata.HintAt(millis))
+}
+
+func (ls Labels) resetBuilderForDrop() *Builder {
+	return ls.resetBuilderAt(nil, 0)
+}
