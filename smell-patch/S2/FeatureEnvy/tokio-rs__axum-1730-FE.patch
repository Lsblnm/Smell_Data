+use super::{
+    future::RouteFuture,
+    method_routing::{AllowHeader, MethodEndpoint, MethodRouter},
+    route::Route,
+};
+use crate::body::HttpBody;
 use bitflags::bitflags;
-use http::Method;
+use bytes::Bytes;
+use http::{Method, Request};
 use std::{
     fmt,
     fmt::{Debug, Formatter},
@@ -66,6 +73,92 @@ impl TryFrom<Method> for MethodFilter {
     }
 }
 
+impl MethodFilter {
+    pub(crate) fn call_with_state<S, B, E>(
+        self,
+        method_router: &mut MethodRouter<S, B, E>,
+        fallback: &mut Route<B, E>,
+        req: Request<B>,
+        state: S,
+    ) -> RouteFuture<B, E>
+    where
+        B: HttpBody,
+        S: Clone,
+    {
+        macro_rules! call_endpoint {
+            ($req:expr, $strip_body:expr, $svc:expr) => {
+                match $svc {
+                    MethodEndpoint::None => {}
+                    MethodEndpoint::Route(route) => {
+                        return RouteFuture::from_future_parts(
+                            route.oneshot_inner($req),
+                            $strip_body,
+                            None,
+                        );
+                    }
+                    MethodEndpoint::BoxedHandler(handler) => {
+                        let mut route = handler.clone().0.into_route(state.clone());
+                        return RouteFuture::from_future_parts(
+                            route.oneshot_inner($req),
+                            $strip_body,
+                            None,
+                        );
+                    }
+                }
+            };
+        }
+
+        let strip_body = req.method() == Method::HEAD;
+
+        let MethodRouter {
+            get,
+            head,
+            delete,
+            options,
+            patch,
+            post,
+            put,
+            trace,
+            allow_header,
+            ..
+        } = method_router;
+
+        if self.contains(MethodFilter::HEAD) {
+            call_endpoint!(req, strip_body, head);
+            call_endpoint!(req, strip_body, get);
+        }
+        if self.contains(MethodFilter::GET) {
+            call_endpoint!(req, strip_body, get);
+        }
+        if self.contains(MethodFilter::POST) {
+            call_endpoint!(req, strip_body, post);
+        }
+        if self.contains(MethodFilter::OPTIONS) {
+            call_endpoint!(req, strip_body, options);
+        }
+        if self.contains(MethodFilter::PATCH) {
+            call_endpoint!(req, strip_body, patch);
+        }
+        if self.contains(MethodFilter::PUT) {
+            call_endpoint!(req, strip_body, put);
+        }
+        if self.contains(MethodFilter::DELETE) {
+            call_endpoint!(req, strip_body, delete);
+        }
+        if self.contains(MethodFilter::TRACE) {
+            call_endpoint!(req, strip_body, trace);
+        }
+
+        let allow_header = match allow_header {
+            AllowHeader::None => Some(Bytes::new()),
+            AllowHeader::Skip => None,
+            AllowHeader::Bytes(allow_header) => Some(allow_header.clone().freeze()),
+        };
+
+        RouteFuture::from_future_parts(fallback.oneshot_inner(req), false, allow_header)
+    }
+}
+
