+impl<B> Route<B, Infallible>
+where
+    B: Send + 'static,
+{
+    pub(super) fn route_request(
+        &self,
+        router: &Router<B>,
+        mut req: Request<B>,
+    ) -> RouterFuture<B> {
+        if req.extensions().get::<OriginalUri>().is_none() {
+            let original_uri = OriginalUri(req.uri().clone());
+            req.extensions_mut().insert(original_uri);
+        }
+
+        let uri = req.uri().clone();
+        let path = uri.path().to_owned();
+
+        match router.node.at(&path) {
+            Ok(match_) => {
+                let id = *match_.value;
+                req.extensions_mut().insert(id);
+
+                if let Some(matched_path) = router.node.route_id_to_path.get(&id) {
+                    let matched_path = join_matched_path(
+                        req.extensions_mut().get::<MatchedPath>(),
+                        matched_path,
+                    );
+                    req.extensions_mut().insert(MatchedPath(matched_path));
+                } else {
+                    #[cfg(debug_assertions)]
+                    panic!("should always have a matched path for a route id");
+                }
+
+                let params = match_
+                    .params
+                    .iter()
+                    .filter(|(key, _)| !key.starts_with(NEST_TAIL_PARAM))
+                    .map(|(key, value)| (key.to_owned(), value.to_owned()))
+                    .collect::<Vec<_>>();
+
+                insert_url_params(&mut req, params);
+
+                let mut route = router
+                    .routes
+                    .get(&id)
+                    .expect("no route for id. This is a bug in axum. Please file an issue")
+                    .clone();
+
+                match &mut route {
+                    Endpoint::MethodRouter(inner) => RouterFuture::from_future(inner.call(req)),
+                    Endpoint::Route(inner) => RouterFuture::from_future(inner.call(req)),
+                }
+            }
+            Err(err) => {
+                if err.tsr() {
+                    let redirect_path = if let Some(without_tsr) = path.strip_suffix('/') {
+                        without_tsr.to_owned()
+                    } else {
+                        format!("{}/", path)
+                    };
+
+                    let new_path = if redirect_path.starts_with('/') {
+                        Cow::Borrowed(redirect_path.as_str())
+                    } else {
+                        Cow::Owned(format!("/{}", redirect_path))
+                    };
+
+                    let path_and_query = if uri.path_and_query().is_some() {
+                        if let Some(query) = uri.query() {
+                            Some(
+                                format!("{}?{}", new_path, query)
+                                    .parse::<http::uri::PathAndQuery>()
+                                    .unwrap(),
+                            )
+                        } else {
+                            Some(new_path.parse().unwrap())
+                        }
+                    } else {
+                        None
+                    };
+
+                    let mut uri_parts = http::uri::Parts::default();
+                    uri_parts.scheme = uri.scheme().cloned();
+                    uri_parts.authority = uri.authority().cloned();
+                    uri_parts.path_and_query = path_and_query;
+                    let redirect_to = Uri::from_parts(uri_parts).unwrap();
+
+                    let res = Response::builder()
+                        .status(StatusCode::MOVED_PERMANENTLY)
+                        .header(LOCATION, redirect_to.to_string())
+                        .body(crate::body::empty())
+                        .unwrap();
+                    RouterFuture::from_response(res)
+                } else {
+                    RouterFuture::from_future(self.clone().call(req))
+                }
+            }
+        }
+    }
+}
+
+fn join_matched_path(previous: Option<&MatchedPath>, current: &Arc<str>) -> Arc<str> {
+    if let Some(previous) = previous {
+        let previous = if let Some(previous) =
+            previous.as_str().strip_suffix(NEST_TAIL_PARAM_CAPTURE)
+        {
+            previous
+        } else {
+            previous.as_str()
+        };
+        format!("{}{}", previous, current).into()
+    } else {
+        Arc::clone(current)
+    }
+}
