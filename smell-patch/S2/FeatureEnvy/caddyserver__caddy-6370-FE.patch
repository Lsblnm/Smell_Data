+type extKind struct {
+	JSON     bool
+	Present  bool
+	CaddyExt bool
+}
+
+func extKindFrom(ext string) extKind {
+	return extKind{
+		JSON:     ext == ".json",
+		Present:  ext != "",
+		CaddyExt: ext == ".caddyfile",
+	}
+}
