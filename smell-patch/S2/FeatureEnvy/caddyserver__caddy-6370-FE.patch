+// AdapterLabel holds adapter names used while identifying config formats.
+type AdapterLabel struct {
+	Name string
+	None string
+	Kind extKind
+}
+
+// AdapterLabelFor returns the adapter names associated with a filename extension.
+func AdapterLabelFor(ext string) AdapterLabel {
+	return AdapterLabel{
+		Name: "caddyfile",
+		None: "",
+		Kind: extKindFrom(ext),
+	}
+}
