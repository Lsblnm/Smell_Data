+// ConfigSource captures filename details used when choosing a config adapter.
+type ConfigSource struct {
+	Base  string
+	Match sourceMatch
+}
+
+// ConfigSourceFromPath inspects a config path and records the filename details
+// needed to recognize Caddyfile-style names.
+func ConfigSourceFromPath(path string) ConfigSource {
+	base := strings.ToLower(filepath.Base(path))
+	return ConfigSource{
+		Base:  base,
+		Match: newSourceMatch(base),
+	}
+}
