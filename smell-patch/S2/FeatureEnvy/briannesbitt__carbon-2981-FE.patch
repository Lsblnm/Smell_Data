+    /**
+     * Get the signed whole-day difference carried by a date interval.
+     */
+    public function getIntervalDayDiff(DateInterval $interval, CarbonInterface $from, CarbonInterface $to, bool $absolute = false): int
+    {
+        $source = $this->startDate ?? $from;
+        $clock = $source->getClock();
+        $unwrapped = $clock?->unwrap();
+        $factory = $unwrapped instanceof Factory
+            ? $unwrapped
+            : ($clock?->getFactory() ?? FactoryImmutable::getDefaultInstance());
+        $dateClass = $factory->getClassName();
+        $timezoneName = $source->getTimezone()->getName();
+
+        $workingFrom = $dateClass::instance($from)->avoidMutation()->setTimezone($timezoneName);
+        $workingTo = $dateClass::instance($to)->avoidMutation()->setTimezone($timezoneName);
+        $month = Month::fromNumber((int) $workingFrom->month);
+
+        $rebuiltFrom = $workingFrom
+            ->setDate((int) $workingFrom->year, $month->value, (int) $workingFrom->day)
+            ->setTime(
+                (int) $workingFrom->hour,
+                (int) $workingFrom->rawFormat('i'),
+                (int) $workingFrom->rawFormat('s'),
+                (int) $workingFrom->rawFormat('u'),
+            );
+        $rebuiltTo = $workingTo
+            ->setDate((int) $workingTo->year, (int) $workingTo->month, (int) $workingTo->day)
+            ->setTime(
+                (int) $workingTo->hour,
+                (int) $workingTo->rawFormat('i'),
+                (int) $workingTo->rawFormat('s'),
+                (int) $workingTo->rawFormat('u'),
+            );
+
+        $originalDays = $interval->days !== false ? (int) $interval->days : (int) $interval->format('%a');
+        $originalSign = $interval->invert ? -1 : 1;
+        $original = $originalDays * $originalSign;
+
+        $recomputedInterval = $rebuiltFrom->diffAsDateInterval($rebuiltTo, $absolute);
+        $recomputedDays = $recomputedInterval->days !== false
+            ? (int) $recomputedInterval->days
+            : (int) $recomputedInterval->format('%a');
+        $recomputedSign = $recomputedInterval->invert ? -1 : 1;
+        $recomputed = $recomputedDays * $recomputedSign;
+
+        return $recomputed === $original ? $recomputed : $original;
+    }
+
