+    public function determineAttributeFullyQualifiedName(Tokens $tokens, string $name, int $index): string
+    {
+        if ('\\' === $name[0]) {
+            return $name;
+        }
+
+        $nameToken = $tokens[$index];
+        $tokenId = $nameToken->getId();
+
+        if (!$nameToken->isArray() || (T_STRING !== $tokenId && T_NS_SEPARATOR !== $tokenId)) {
+            $index = $tokens->getNextTokenOfKind($index, [[T_STRING], [T_NS_SEPARATOR]]);
+            $nameToken = $tokens[$index];
+        }
+
+        $firstTokenOfName = $nameToken->getContent();
+
+        if (0 < $tokens->countTokenKind(T_ATTRIBUTE)) {
+            $attributeOpenIndex = $tokens->getPrevTokenOfKind($index, [[T_ATTRIBUTE], ';', '{', '}']);
+            if (null !== $attributeOpenIndex && $tokens[$attributeOpenIndex]->isGivenKind(T_ATTRIBUTE)) {
+                foreach (AttributeAnalyzer::collect($tokens, $attributeOpenIndex) as $attributeAnalysis) {
+                    foreach ($attributeAnalysis->getAttributes() as $existingAttribute) {
+                        if ($existingAttribute['start'] === $index) {
+                            $name = $existingAttribute['name'];
+                            break 2;
+                        }
+                    }
+                }
+            }
+        }
+
+        $namespaceAnalysis = $this->namespacesAnalyzer->getNamespaceAt($tokens, $index);
+        $namespace = $namespaceAnalysis->getFullName();
+        $namespaceShortName = $namespaceAnalysis->getShortName();
+        if ('' === $namespace) {
+            $namespace = $namespaceShortName;
+        }
+
+        $scopeStartIndex = $namespaceAnalysis->getScopeStartIndex();
+        $scopeEndIndex = $namespaceAnalysis->getScopeEndIndex();
+        $uses = [];
+        foreach ((new NamespaceUsesAnalyzer())->getDeclarationsInNamespace($tokens, $namespaceAnalysis) as $use) {
+            if (!$use->isClass()) {
+                continue;
+            }
+
+            $useStartIndex = $use->getStartIndex();
+            if ($useStartIndex < $scopeStartIndex || $useStartIndex > $scopeEndIndex) {
+                continue;
+            }
+
+            $uses[$use->getShortName()] = $use;
+        }
+
+        if (isset($uses[$firstTokenOfName])) {
+            $namespace = $uses[$firstTokenOfName]->getFullName();
+
+            if ($name === $firstTokenOfName) {
+                return $namespace;
+            }
+
+            $name = substr(strstr($name, '\\'), 1);
+        }
+
+        return $namespace.'\\'.$name;
+    }
+
