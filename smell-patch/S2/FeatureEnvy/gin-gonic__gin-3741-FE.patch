+func (p *LogFormatterParams) handleHTTPRequest(c *Context) {
+	engine := c.engine
+	p.Request = c.Request
+	httpMethod := p.Request.Method
+	rPath, rawPath := requestPathParts(p.Request)
+	unescape := false
+	if engine.UseRawPath && len(rawPath) > 0 {
+		rPath = rawPath
+		unescape = engine.UnescapePathValues
+	}
+	rPath = engine.normalizedPath(rPath)
+
+	t := engine.trees
+	for i, tl := 0, len(t); i < tl; i++ {
+		if t[i].method != httpMethod {
+			continue
+		}
+		root := t[i].root
+		value := lookupRouteValue(root, rPath, c, unescape)
+		applyRouteParams(c, value)
+		if value.handlers != nil {
+			runRoute(c, value.fullPath, value)
+			if c.writermem.Size() == noWritten {
+				c.writermem.WriteHeaderNow()
+			}
+			return
+		}
+		fallbackHTTPRequest(engine, c, root, value, httpMethod, rPath, unescape)
+		return
+	}
+	fallbackHTTPRequest(engine, c, nil, nodeValue{}, httpMethod, rPath, unescape)
+}
