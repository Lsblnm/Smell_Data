+  /**
+   * Replaces all segments in this writer's {@link SegmentInfos} with those from {@code commit}, but
+   * keeps generation, version and counter so that future commits remain write once.
+   */
+  void replace(IndexCommit commit, Directory expectedDirectory, InfoStream stream)
+      throws IOException {
+    SegmentInfos current = this.segmentInfos;
+    Directory commitDirectory = commit.getDirectory();
+    if (commitDirectory != expectedDirectory) {
+      throw new IllegalArgumentException(
+          "IndexCommit's directory doesn't match my directory, expected="
+              + expectedDirectory
+              + ", got="
+              + commitDirectory);
+    }
+
+    String commitSegmentsFile = commit.getSegmentsFileName();
+    SegmentInfos other = SegmentInfos.readCommit(expectedDirectory, commitSegmentsFile);
+    StringBuilder loaded =
+        new StringBuilder("init: loaded commit \"").append(commitSegmentsFile).append('"');
+
+    current.clear();
+    int createdMajor = current.getIndexCreatedVersionMajor();
+    for (SegmentCommitInfo commitInfo : other.asList()) {
+      SegmentInfo info = commitInfo.info;
+      Version minVersion = info.minVersion;
+      if (createdMajor >= 7 && minVersion == null) {
+        throw new IllegalArgumentException(
+            "All segments must record the minVersion for indices created on or after Lucene 7");
+      }
+      int maxDoc = info.maxDoc();
+      int delCount = commitInfo.getDelCount();
+      if (delCount < 0 || delCount > maxDoc) {
+        throw new IllegalStateException(
+            "cannot replace segment: invalid maxDoc=" + maxDoc + " delCount=" + delCount);
+      }
+      Codec codec = info.getCodec();
+      Version version = info.getVersion();
+      loaded
+          .append(" codec=")
+          .append(codec.getName())
+          .append(" major=")
+          .append(version.major)
+          .append(" maxDoc=")
+          .append(maxDoc)
+          .append(" dels=")
+          .append(delCount);
+      current.add(commitInfo);
+    }
+    current.lastGeneration = other.lastGeneration;
+
+    if (stream.isEnabled("IW")) {
+      stream.message("IW", loaded.toString());
+    }
+  }
+
