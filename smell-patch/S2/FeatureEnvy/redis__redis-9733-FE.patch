+/* Helper for COMMAND GETKEYS.
+ *
+ * COMMAND GETKEYS arg0 arg1 arg2 ... */
+void getKeysSubcommand(robj *cmdname, client *c) {
+    robj **cmdargv = c->argv + 2;
+    int cmdargc = c->argc - 2;
+    struct redisCommand *cmd = NULL;
+    getKeysResult result = GETKEYS_RESULT_INIT;
+    dictEntry *de;
+    int j;
+
+    de = dictFind(server.commands, cmdname->ptr);
+    if (de != NULL) {
+        cmd = dictGetVal(de);
+        if (cmd->subcommands_dict && dictSize(cmd->subcommands_dict) && cmdargc > 1) {
+            dictEntry *subde = dictFind(cmd->subcommands_dict, cmdargv[1]->ptr);
+            cmd = subde ? dictGetVal(subde) : NULL;
+        }
+    }
+
+    if (!cmd) {
+        addReplyError(c,"Invalid command specified");
+        return;
+    } else if (cmd->getkeys_proc == NULL && cmd->key_specs_num == 0 &&
+               !(cmd->flags & CMD_MODULE_GETKEYS))
+    {
+        addReplyError(c,"The command has no key arguments");
+        return;
+    } else if ((cmd->arity > 0 && cmd->arity != cmdargc) ||
+               (cmdargc < -cmd->arity))
+    {
+        addReplyError(c,"Invalid number of arguments specified for command");
+        return;
+    }
+
+    if (!getKeysFromCommand(cmd,cmdargv,cmdargc,&result)) {
+        addReplyError(c,"Invalid arguments specified for command");
+    } else {
+        addReplyArrayLen(c,result.numkeys);
+        for (j = 0; j < result.numkeys; j++) addReplyBulk(c,cmdargv[result.keys[j]]);
+    }
+    getKeysFreeResult(&result);
+}
