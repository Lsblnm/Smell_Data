+namespace detail {
+template <typename Char>
+template <typename RangeFormatter, typename R, typename FormatContext>
+auto loc_writer<Char>::format(const RangeFormatter& rng_fmt, R&& range,
+                              FormatContext& ctx) const -> decltype(ctx.out()) {
+  range_mapper<buffered_context<Char>> mapper;
+  auto out = ctx.out();
+  auto emit = [&](basic_string_view<Char> token) {
+    auto data = token.data();
+    auto size = token.size();
+    auto fill_size = specs.fill.size();
+    if ((specs.width != 0 || specs.type == presentation_type::debug) &&
+        fill_size > 0) {
+      return write<Char>(out, basic_string_view<Char>(data, size), specs);
+    }
+    basic_memory_buffer<Char> piece;
+    piece.append(data, data + size);
+    return copy<Char>(piece.data(), piece.data() + piece.size(), out);
+  };
+
+  out = emit(rng_fmt.opening_bracket_);
+  int i = 0;
+  auto it = range_begin(range);
+  auto end = range_end(range);
+  for (; it != end; ++it) {
+    if (i > 0) out = emit(rng_fmt.separator_);
+    ctx.advance_to(out);
+    auto&& item = *it;
+    out = rng_fmt.underlying_.format(mapper.map(item), ctx);
+    ++i;
+  }
+  out = emit(rng_fmt.closing_bracket_);
+  return out;
+}
+}  // namespace detail
+
 enum class range_format { disabled, map, set, sequence, string, debug_string };
 
