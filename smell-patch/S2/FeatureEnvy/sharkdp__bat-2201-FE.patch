+
+impl CliApp {
+    pub fn new(interactive_output: bool) -> Self {
+        CliApp { interactive_output }
+    }
+
+    pub fn build_config<'a>(&self, matches: &'a ArgMatches<'static>, inputs: &[Input<'_>]) -> Result<Config<'a>> {
+        let style_components = self.style_components(matches)?;
+
+        let paging_mode = match matches.value_of("paging") {
+            Some("always") => PagingMode::Always,
+            Some("never") => PagingMode::Never,
+            Some("auto") | None => {
+                // If we have -pp as an option when in auto mode, the pager should be disabled.
+                let extra_plain = matches.occurrences_of("plain") > 1;
+                if extra_plain || matches.is_present("no-paging") {
+                    PagingMode::Never
+                } else if inputs.iter().any(|input| {
+                    let description = input.description();
+                    let kind_is_stdin = description
+                        .kind()
+                        .map(|k| k.eq_ignore_ascii_case("stdin"))
+                        .unwrap_or(false);
+                    input.is_stdin() || (kind_is_stdin && input.is_stdin())
+                }) {
+                    // If we are reading from stdin, only enable paging if we write to an
+                    // interactive terminal and if we do not *read* from an interactive
+                    // terminal.
+                    if self.interactive_output && !atty::is(atty::Stream::Stdin) {
+                        PagingMode::QuitIfOneScreen
+                    } else {
+                        PagingMode::Never
+                    }
+                } else if self.interactive_output {
+                    PagingMode::QuitIfOneScreen
+                } else {
+                    PagingMode::Never
+                }
+            }
+            _ => unreachable!("other values for --paging are not allowed"),
+        };
+
+        let mut syntax_mapping = SyntaxMapping::builtin();
+
+        if let Some(values) = matches.values_of("ignored-suffix") {
+            for suffix in values {
+                syntax_mapping.insert_ignored_suffix(suffix);
+            }
+        }
+
+        if let Some(values) = matches.values_of("map-syntax") {
+            for from_to in values {
+                let parts: Vec<_> = from_to.split(':').collect();
+
+                if parts.len() != 2 {
+                    return Err("Invalid syntax mapping. The format of the -m/--map-syntax option is '<glob-pattern>:<syntax-name>'. For example: '*.cpp:C++'.".into());
+                }
+
+                syntax_mapping.insert(parts[0], MappingTarget::MapTo(parts[1]))?;
+            }
+        }
+
+        let maybe_term_width = matches.value_of("terminal-width").and_then(|w| {
+            if w.starts_with('+') || w.starts_with('-') {
+                // Treat argument as a delta to the current terminal width
+                w.parse().ok().map(|delta: i16| {
+                    let old_width: u16 = Term::stdout().size().1;
+                    let new_width: i32 = i32::from(old_width) + i32::from(delta);
+
+                    if new_width <= 0 {
+                        old_width as usize
+                    } else {
+                        new_width as usize
+                    }
+                })
+            } else {
+                w.parse().ok()
+            }
+        });
+
+        let defaults = Config::default();
+
+        Ok(Config {
+            true_color: is_truecolor_terminal(),
+            language: matches.value_of("language").or_else(|| {
+                if matches.is_present("show-all") {
+                    Some("show-nonprintable")
+                } else {
+                    None
+                }
+            }),
+            show_nonprintable: matches.is_present("show-all") || defaults.show_nonprintable,
+            wrapping_mode: if self.interactive_output || maybe_term_width.is_some() {
+                match matches.value_of("wrap") {
+                    Some("character") => WrappingMode::Character,
+                    Some("never") => WrappingMode::NoWrapping(true),
+                    Some("auto") | None => {
+                        if style_components.plain() {
+                            WrappingMode::NoWrapping(false)
+                        } else {
+                            WrappingMode::Character
+                        }
+                    }
+                    _ => unreachable!("other values for --wrap are not allowed"),
+                }
+            } else {
+                // We don't have the tty width when piping to another program.
+                // There's no point in wrapping when this is the case.
+                defaults.wrapping_mode
+            },
+            colored_output: matches.is_present("force-colorization")
+                || match matches.value_of("color") {
+                    Some("always") => true,
+                    Some("never") => false,
+                    Some("auto") => env::var_os("NO_COLOR").is_none() && self.interactive_output,
+                    _ => unreachable!("other values for --color are not allowed"),
+                }
+                || defaults.colored_output,
+            paging_mode,
+            term_width: maybe_term_width.unwrap_or(Term::stdout().size().1 as usize),
+            loop_through: !(self.interactive_output
+                || matches.value_of("color") == Some("always")
+                || matches.value_of("decorations") == Some("always")
+                || matches.is_present("force-colorization"))
+                || defaults.loop_through,
+            tab_width: matches
+                .value_of("tabs")
+                .map(String::from)
+                .or_else(|| env::var("BAT_TABS").ok())
+                .and_then(|t| t.parse().ok())
+                .unwrap_or(
+                    if style_components.plain() && paging_mode == PagingMode::Never {
+                        defaults.tab_width
+                    } else {
+                        4
+                    },
+                ),
+            theme: matches
+                .value_of("theme")
+                .map(String::from)
+                .or_else(|| env::var("BAT_THEME").ok())
+                .map(|s| {
+                    if s == "default" {
+                        String::from(HighlightingAssets::default_theme())
+                    } else {
+                        s
+                    }
+                })
+                .unwrap_or_else(|| String::from(HighlightingAssets::default_theme())),
+            visible_lines: match matches.is_present("diff") {
+                #[cfg(feature = "git")]
+                true => VisibleLines::DiffContext(
+                    matches
+                        .value_of("diff-context")
+                        .and_then(|t| t.parse().ok())
+                        .unwrap_or(2),
+                ),
+
+                _ => VisibleLines::Ranges(
+                    matches
+                        .values_of("line-range")
+                        .map(|vs| vs.map(LineRange::from).collect())
+                        .transpose()?
+                        .map(LineRanges::from)
+                        .unwrap_or_default(),
+                ),
+            },
+            style_components,
+            syntax_mapping,
+            pager: matches.value_of("pager").or(defaults.pager),
+            use_italic_text: matches.value_of("italic-text") == Some("always")
+                || defaults.use_italic_text,
+            highlighted_lines: matches
+                .values_of("highlight-line")
+                .map(|ws| ws.map(LineRange::from).collect())
+                .transpose()?
+                .map(LineRanges::from)
+                .map(HighlightedLineRanges)
+                .unwrap_or_else(|| HighlightedLineRanges(defaults.highlighted_lines.0)),
+            use_custom_assets: !matches.is_present("no-custom-assets"),
+        })
+    }
+
+    fn style_components(&self, matches: &ArgMatches<'static>) -> Result<StyleComponents> {
+        let mut styled_components =
+            StyleComponents(if matches.value_of("decorations") == Some("never") {
+                HashSet::new()
+            } else if matches.is_present("number") {
+                [StyleComponent::LineNumbers].iter().cloned().collect()
+            } else if matches.is_present("plain") {
+                [StyleComponent::Plain].iter().cloned().collect()
+            } else {
+                let env_style_components: Option<Vec<StyleComponent>> = env::var("BAT_STYLE")
+                    .ok()
+                    .map(|style_str| {
+                        style_str
+                            .split(',')
+                            .map(StyleComponent::from_str)
+                            .collect::<Result<Vec<StyleComponent>>>()
+                    })
+                    .transpose()?;
+
+                matches
+                    .value_of("style")
+                    .map(|styles| {
+                        styles
+                            .split(',')
+                            .map(|style| style.parse::<StyleComponent>())
+                            .filter_map(|style| style.ok())
+                            .collect::<Vec<_>>()
+                    })
+                    .or(env_style_components)
+                    .unwrap_or_else(|| vec![StyleComponent::Default])
+                    .into_iter()
+                    .map(|style| style.components(self.interactive_output))
+                    .fold(HashSet::new(), |mut acc, components| {
+                        acc.extend(components.iter().cloned());
+                        acc
+                    })
+            });
+
+        // If `grid` is set, remove `rule` as it is a subset of `grid`, and print a warning.
+        if styled_components.grid() && styled_components.0.remove(&StyleComponent::Rule) {
+            bat_warning!("Style 'rule' is a subset of style 'grid', 'rule' will not be visible.");
+        }
+
+        Ok(styled_components)
+    }
+}
