diff --git a/src/PhpSpreadsheet/Calculation/LookupRef/VLookup.php b/src/PhpSpreadsheet/Calculation/LookupRef/VLookup.php
index edeb1aa8c..e73215c83 100644
--- a/src/PhpSpreadsheet/Calculation/LookupRef/VLookup.php
+++ b/src/PhpSpreadsheet/Calculation/LookupRef/VLookup.php
@@ -3,14 +3,28 @@
 namespace PhpOffice\PhpSpreadsheet\Calculation\LookupRef;
 
 use PhpOffice\PhpSpreadsheet\Calculation\ArrayEnabled;
+use PhpOffice\PhpSpreadsheet\Calculation\Calculation;
 use PhpOffice\PhpSpreadsheet\Calculation\Exception;
 use PhpOffice\PhpSpreadsheet\Calculation\Information\ExcelError;
+use PhpOffice\PhpSpreadsheet\Calculation\Token\Stack;
+use PhpOffice\PhpSpreadsheet\Cell\Cell;
+use PhpOffice\PhpSpreadsheet\Cell\Coordinate;
+use PhpOffice\PhpSpreadsheet\DefinedName;
+use PhpOffice\PhpSpreadsheet\ReferenceHelper;
 use PhpOffice\PhpSpreadsheet\Shared\StringHelper;
+use PhpOffice\PhpSpreadsheet\Worksheet\Worksheet;
 
 class VLookup extends LookupBase
 {
     use ArrayEnabled;
 
+    /**
+     * Logger used while resolving defined names during formula evaluation.
+     *
+     * @var \PhpOffice\PhpSpreadsheet\Calculation\Engine\Logger
+     */
+    private $debugLog;
+
     /**
      * VLOOKUP
      * The VLOOKUP function searches for value in the left-most column of lookup_array and returns the value
@@ -114,4 +128,80 @@ class VLookup extends LookupBase
 
         return $rowNumber;
     }
+
+    /**
+     * Resolve a defined name encountered while evaluating a formula.
+     *
+     * @return mixed|string
+     */
+    public function evaluateDefinedName(
+        Calculation $calculation,
+        Cell $cell,
+        DefinedName $namedRange,
+        Worksheet $cellWorksheet,
+        Stack $stack
+    ) {
+        $this->debugLog = $calculation->getDebugLog();
+
+        $definedNameScope = $namedRange->getScope();
+        $hostTitle = $cellWorksheet->getTitle();
+        $scopeTitle = ($definedNameScope !== null) ? $definedNameScope->getTitle() : $hostTitle;
+        if ($definedNameScope !== null && ($definedNameScope !== $cellWorksheet || $scopeTitle !== $hostTitle)) {
+            // The defined name isn't in our current scope, so #REF
+            $result = ExcelError::REF();
+            $stack->push('Error', $result, $namedRange->getName());
+
+            return $result;
+        }
+
+        $definedNameValue = $namedRange->getValue();
+        $definedNameType = $namedRange->isFormula() ? 'Formula' : 'Range';
+        $definedNameWorksheet = $namedRange->getWorksheet();
+
+        if ($definedNameValue[0] !== '=') {
+            $definedNameValue = '=' . $definedNameValue;
+        }
+
+        $this->debugLog->writeDebugLog('Defined Name is a %s with a value of %s', $definedNameType, $definedNameValue);
+
+        $spreadsheet = $calculation->getSpreadsheet();
+        $recursiveCalculationCell = ($definedNameWorksheet !== null && $definedNameWorksheet !== $cellWorksheet)
+            ? $definedNameWorksheet->getCell('A1')
+            : $cell;
+        $recursiveCalculationCellAddress = $recursiveCalculationCell->getCoordinate();
+
+        $cellCollection = $cell->getParent();
+        $currentCoordinate = ($cellCollection !== null) ? $cellCollection->getCurrentCoordinate() : null;
+        if ($currentCoordinate === null || $currentCoordinate === '') {
+            $columnOffset = Coordinate::columnIndexFromString($cell->getColumn()) - 1;
+            $rowOffset = $cell->getRow() - 1;
+        } else {
+            [$currentColumn, $currentRow] = Coordinate::coordinateFromString($currentCoordinate);
+            $columnOffset = Coordinate::columnIndexFromString($currentColumn) - 1;
+            $rowOffset = (int) $currentRow - 1;
+        }
+
+        // Adjust relative references in ranges and formulae so that we execute the calculation for the correct rows and columns
+        $definedNameValue = ReferenceHelper::getInstance()->updateFormulaReferencesAnyWorksheet(
+            $definedNameValue,
+            $columnOffset,
+            $rowOffset
+        );
+
+        $this->debugLog->writeDebugLog('Value adjusted for relative references is %s', $definedNameValue);
+
+        $recursiveCalculator = new Calculation($spreadsheet);
+        $recursiveCalculator->getDebugLog()->setWriteDebugLog($this->debugLog->getWriteDebugLog());
+        $recursiveCalculator->getDebugLog()->setEchoDebugLog($this->debugLog->getEchoDebugLog());
+        $result = $recursiveCalculator->_calculateFormulaValue($definedNameValue, $recursiveCalculationCellAddress, $recursiveCalculationCell, true);
+
+        if ($this->debugLog->getWriteDebugLog()) {
+            $this->debugLog->mergeDebugLog(array_slice($recursiveCalculator->getDebugLog()->getLog(), 3));
+            $this->debugLog->writeDebugLog('Evaluation Result for Named %s %s is %s', $definedNameType, $namedRange->getName(), $calculation->showTypeDetails($result));
+        }
+
+        $stack->push('Defined Name', $result, $namedRange->getName());
+
+        return $result;
+    }
 }
