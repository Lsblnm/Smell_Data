 import lombok.Builder;
 import lombok.core.AST.Kind;
@@ -34,11 +43,40 @@ import lombok.core.HandlerPriority;
 import lombok.experimental.SuperBuilder;
 import lombok.javac.JavacAnnotationHandler;
 import lombok.javac.JavacNode;
+import lombok.javac.JavacTreeMaker;
+import lombok.javac.handlers.HandleBuilder.BuilderFieldData;
+import lombok.javac.handlers.HandleBuilder.BuilderJob;
 import lombok.spi.Provides;
 
 @Provides
 @HandlerPriority(-1025) //HandleBuilder's level, minus one.
 public class HandleBuilderDefault extends JavacAnnotationHandler<Builder.Default> {
+	private final String defaultProviderPrefix = HandleBuilder.DEFAULT_PREFIX;
+
+	public JCMethodDecl generateDefaultProvider(BuilderJob job, BuilderFieldData bfd, JavacNode fieldNode) {
+		JavacTreeMaker maker = fieldNode.getAst().getTreeMaker();
+		JCVariableDecl field = (JCVariableDecl) fieldNode.get();
+		JavacNode parentType = job.parentType;
+		JCClassDecl classDecl = (JCClassDecl) parentType.get();
+
+		Name defaultName = parentType.toName(this.defaultProviderPrefix + bfd.name);
+		Name setFlagName = parentType.toName(bfd.name + HandleBuilder.SET_PREFIX);
+		Name valueName = parentType.toName(bfd.name + HandleBuilder.VALUE_PREFIX);
+		bfd.nameOfDefaultProvider = defaultName;
+		bfd.nameOfSetFlag = setFlagName;
+		bfd.builderFieldName = valueName;
+
+		JCStatement statement = maker.Return(field.init);
+		field.init = null;
+
+		JCBlock body = maker.Block(0, List.<JCStatement>of(statement));
+		int modifiers = Flags.PRIVATE | Flags.STATIC;
+		JCMethodDecl methodDecl = maker.MethodDef(maker.Modifiers(modifiers), defaultName, cloneType(maker, field.vartype, fieldNode), copyTypeParams(fieldNode, classDecl.typarams), List.<JCVariableDecl>nil(), List.<JCExpression>nil(), body, null);
+		recursiveSetGeneratedBy(methodDecl, job.sourceNode);
+		if (methodDecl != null) injectMethod(parentType, methodDecl);
+		return methodDecl;
+	}
+
 	@Override public void handle(AnnotationValues<Builder.Default> annotation, JCAnnotation ast, JavacNode annotationNode) {
 		JavacNode annotatedField = annotationNode.up();
 		if (annotatedField.getKind() != Kind.FIELD) return;
