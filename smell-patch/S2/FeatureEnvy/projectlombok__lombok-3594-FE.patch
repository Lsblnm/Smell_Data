+	public ListBuffer<JCExpression> getTypeParamExpressions(com.sun.tools.javac.util.List<? extends JCTree> typeParams, JavacTreeMaker maker) {
+		ListBuffer<JCExpression> typeParamsForBuilderParameter = new ListBuffer<JCExpression>();
+		JavacTreeMaker astMaker = this.ast.getTreeMaker();
+		if (astMaker != null) maker = astMaker;
+		for (JCTree typeParam : typeParams) {
+			if (typeParam instanceof JCTypeParameter) {
+				JCTypeParameter declared = (JCTypeParameter) typeParam;
+				Name typeParamName = declared.name;
+				if (declared.bounds != null && typeParamName != null && this.ast.getContext() != null && this.ast.getSymbolTable() != null && this.ast.getTypesUtil() != null) {
+					typeParamName = this.ast.toName(typeParamName.toString());
+					String imported = getImportList().getFullyQualifiedNameForSimpleName(typeParamName.toString());
+					if (imported != null) {
+						int lastDot = imported.lastIndexOf('.');
+						typeParamName = this.ast.toName(lastDot >= 0 ? imported.substring(lastDot + 1) : imported);
+					}
+				}
+				typeParamsForBuilderParameter.append(maker.Ident(typeParamName));
+			} else if (typeParam instanceof JCIdent) {
+				JCIdent ident = (JCIdent) typeParam;
+				Name identName = ident.name;
+				if (ident.sym != null || this.ast.getContext() != null) {
+					identName = this.ast.toName(identName.toString());
+				}
+				String imported = getImportList().getFullyQualifiedNameForSimpleName(identName.toString());
+				if (imported != null) {
+					int lastDot = imported.lastIndexOf('.');
+					identName = this.ast.toName(lastDot >= 0 ? imported.substring(lastDot + 1) : imported);
+				}
+				typeParamsForBuilderParameter.append(maker.Ident(identName));
+			} else if (typeParam instanceof JCFieldAccess) {
+				java.util.List<Name> chainNames = new ArrayList<Name>();
+				JCExpression expression = (JCFieldAccess) typeParam;
+				while (expression != null) {
+					if (expression instanceof JCFieldAccess) {
+						JCFieldAccess part = (JCFieldAccess) expression;
+						chainNames.add(part.name);
+						expression = part.selected;
+					} else if (expression instanceof JCIdent) {
+						chainNames.add(((JCIdent) expression).name);
+						expression = null;
+					} else {
+						expression = null;
+					}
+				}
+				Collections.reverse(chainNames);
+				JCExpression typeParameter = null;
+				for (Name name : chainNames) {
+					if (typeParameter == null) {
+						typeParameter = maker.Ident(name);
+					} else {
+						typeParameter = maker.Select(typeParameter, name);
+					}
+				}
+				typeParamsForBuilderParameter.append(typeParameter);
+			} else if (typeParam instanceof JCTypeApply) {
+				JCTypeApply typeApply = (JCTypeApply) typeParam;
+				JCExpression clazzCopy = JavacHandlerUtil.cloneType(maker, typeApply.clazz, this);
+				ListBuffer<JCExpression> argumentCopies = new ListBuffer<JCExpression>();
+				if (typeApply.arguments != null) {
+					for (JCExpression argument : typeApply.arguments) {
+						argumentCopies.append(JavacHandlerUtil.cloneType(maker, argument, this));
+					}
+				}
+				JCExpression copied = maker.TypeApply(clazzCopy, argumentCopies.toList());
+				typeParamsForBuilderParameter.append(JavacHandlerUtil.recursiveSetGeneratedBy(copied, this));
+			}
+		}
+		return typeParamsForBuilderParameter;
+	}
