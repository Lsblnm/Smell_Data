+    /**
+     * Extract and normalize parameters used by interval human-readable formatting.
+     *
+     * @param mixed $syntax
+     * @param mixed $short
+     * @param mixed $parts
+     * @param mixed $options
+     *
+     * @return array
+     */
+    public function getForHumansParameters(
+        CarbonInterval $interval,
+        $syntax = null,
+        $short = false,
+        $parts = CarbonInterval::NO_LIMIT,
+        $options = null,
+    ): array {
+        $intervalTranslator = $interval->getLocalTranslator();
+        $language = new Language((string) $interval->locale);
+        $languageId = $language->getId();
+        $languageCode = $language->getCode();
+        $languageRegion = $language->getRegion();
+        $languageVariant = $language->getVariant();
+        $canonicalLocale = $languageId;
+
+        if ($languageVariant !== null || $languageRegion !== null) {
+            $canonicalLocale = $languageId;
+        }
+
+        $reference = $interval->start();
+        $timezoneName = $interval->tzName;
+        $resolvedTimezone = CarbonTimeZone::instance($timezoneName ?? $reference?->getTimezone() ?? 'UTC');
+        $timezoneName = $resolvedTimezone?->getName() ?? $timezoneName;
+
+        $factory = $reference?->getClock()?->getFactory();
+        $factorySettings = $factory?->getSettings() ?? [];
+        $factoryTranslator = $factory?->getTranslator();
+
+        $optionalSpace = ' ';
+        $storedMessages = $this->messages[$canonicalLocale] ?? $this->messages[$languageCode] ?? [];
+        $default = $interval->getTranslationMessage('list.0') ?? $interval->getTranslationMessage('list') ?? ' ';
+
+        if ($intervalTranslator === $this) {
+            $storedList = $storedMessages['list'] ?? null;
+
+            if (\is_array($storedList) && \in_array($default, $storedList, true)) {
+                $default = $storedList[array_search($default, $storedList, true)];
+            } elseif (\is_string($storedList) && $storedList === $default) {
+                $default = $storedList;
+            }
+        }
+
+        /** @var bool|string $join */
+        $join = $default === '' ? '' : ' ';
+        /** @var bool|array|string $altNumbers */
+        $altNumbers = false;
+        $aUnit = false;
+        $minimumUnit = 's';
+        $skip = [];
+        extract($this->getForHumansInitialVariables($syntax, $short));
+        $skip = array_map(
+            static fn ($unit) => $unit instanceof Unit ? $unit->value : $unit,
+            (array) $skip,
+        );
+        $skip = array_map(
+            'strtolower',
+            array_filter($skip, static fn ($unit) => \is_string($unit) && $unit !== ''),
+        );
+
+        $syntax ??= CarbonInterface::DIFF_ABSOLUTE;
+
+        if ($parts === CarbonInterval::NO_LIMIT) {
+            $parts = INF;
+        }
+
+        if ($timezoneName !== null && \array_key_exists('humanDiffOptions', $factorySettings)) {
+            $options ??= (int) $factorySettings['humanDiffOptions'];
+        } else {
+            $options ??= (int) ($factorySettings['humanDiffOptions'] ?? 0);
+        }
+
+        if ($join === false) {
+            $join = ' ';
+        } elseif ($join === true) {
+            $join = [
+                $default,
+                $interval->getTranslationMessage('list.1') ?? $default,
+            ];
+        }
+
+        if ($altNumbers && $altNumbers !== true) {
+            $altNumbers = \in_array($languageCode, (array) $altNumbers, true);
+        }
+
+        if (\is_array($join)) {
+            [$default, $last] = $join;
+
+            if ($default !== ' ') {
+                $optionalSpace = '';
+            }
+
+            $join = function ($list) use ($default, $last) {
+                if (\count($list) < 2) {
+                    return implode('', $list);
+                }
+
+                $end = array_pop($list);
+
+                return implode($default, $list).$last.$end;
+            };
+        }
+
+        if (\is_string($join)) {
+            if ($join !== ' ') {
+                $optionalSpace = '';
+            }
+
+            $glue = $join;
+            $join = static fn ($list) => implode($glue, $list);
+        }
+
+        $interpolations = [
+            ':optional-space' => $optionalSpace,
+        ];
+
+        if (!isset($translator) && isset($locale)) {
+            $requestedTranslator = Translator::get($locale);
+            $translator = $factoryTranslator === $requestedTranslator
+                ? $factoryTranslator
+                : $requestedTranslator;
+        }
+
+        $translator ??= null;
+
+        return [$syntax, $short, $parts, $options, $join, $aUnit, $altNumbers, $interpolations, $minimumUnit, $skip, $translator];
+    }
+
+    private function getForHumansInitialVariables($syntax, $short): array
+    {
+        if (\is_array($syntax)) {
+            return $syntax;
+        }
+
+        if (\is_int($short)) {
+            return [
+                'parts' => $short,
+                'short' => false,
+            ];
+        }
+
+        if (\is_bool($syntax)) {
+            return [
+                'short' => $syntax,
+                'syntax' => CarbonInterface::DIFF_ABSOLUTE,
+            ];
+        }
+
+        return [];
+    }
+
