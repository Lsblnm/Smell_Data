+  /**
+   * Classifies a decoded tessellated triangle as a point, line or triangle.
+   *
+   * <p>Shape fields are indexed as seven-dimension BKD points. This uses that packed layout together
+   * with the decoded vertices to collapse degenerate triangles produced by tessellation.
+   */
+  void resolveTriangleType(ShapeField.DecodedTriangle triangle, BytesRef encoded) {
+    BKDConfig layout =
+        new BKDConfig(7, 4, this.dimensionNumBytes, 512);
+    ByteArrayDataInput packed =
+        new ByteArrayDataInput(encoded.bytes, encoded.offset, layout.packedBytesLength);
+    IntsRef vertices = new IntsRef(6);
+    int origin = packed.getPosition();
+    vertices.ints[0] = triangle.aX;
+    vertices.ints[1] = triangle.aY;
+    vertices.ints[2] = triangle.bX;
+    vertices.ints[3] = triangle.bY;
+    vertices.ints[4] = triangle.cX;
+    vertices.ints[5] = triangle.cY;
+    int base = origin - encoded.offset;
+    int vertexDims = layout.packedBytesLength / layout.bytesPerDim - 1;
+    int ax = vertices.ints[base];
+    int ay = vertices.ints[base + 1];
+    int bx = vertices.ints[base + 2];
+    int by = vertices.ints[base + 3];
+    int cx = vertices.ints[base + vertexDims - 2];
+    int cy = vertices.ints[base + vertexDims - 1];
+    if (ax == bx && ay == by) {
+      if (ax == cx && ay == cy) {
+        triangle.type = ShapeField.DecodedTriangle.TYPE.POINT;
+      } else {
+        triangle.bX = cx;
+        triangle.bY = cy;
+        triangle.cX = ax;
+        triangle.cY = ay;
+        triangle.type = ShapeField.DecodedTriangle.TYPE.LINE;
+      }
+    } else if (ax == cx && ay == cy) {
+      triangle.type = ShapeField.DecodedTriangle.TYPE.LINE;
+    } else if (bx == cx && by == cy) {
+      triangle.cX = ax;
+      triangle.cY = ay;
+      triangle.type = ShapeField.DecodedTriangle.TYPE.LINE;
+    } else {
+      triangle.type = ShapeField.DecodedTriangle.TYPE.TRIANGLE;
+    }
+  }
