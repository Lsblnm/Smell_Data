+func (m *pageMap) reverseIndexName(p *pageState) string {
+	if p == nil || p.s != m.s {
+		return ""
+	}
+
+	pm := p.m
+	if pm == nil {
+		return ""
+	}
+
+	cfg := pm.pageConfig
+
+	var (
+		pi        *paths.Path
+		filename  string
+		langIndex int
+		hasFile   bool
+	)
+
+	if fi := pm.f; fi != nil {
+		if fim := fi.FileInfo(); fim != nil {
+			if fm := fim.Meta(); fm != nil {
+				hasFile = true
+				filename = fm.Filename
+				langIndex = fm.LangIndex
+				pi = fm.PathInfo
+			}
+		}
+	}
+
+	if pi == nil {
+		return ""
+	}
+
+	if hasFile && langIndex < 0 {
+		return ""
+	}
+
+	name := pi.BaseNameNoIdentifier()
+	if name == "" {
+		return ""
+	}
+
+	if filename != "" {
+		base := filepath.Base(filename)
+		stem := strings.TrimSuffix(base, filepath.Ext(base))
+		if strings.EqualFold(stem, name) {
+			return name
+		}
+	}
+
+	if cfg != nil && cfg.Kind != "" && cfg.Path != "" {
+		if base := path.Base(cfg.Path); strings.EqualFold(base, name) {
+			return name
+		}
+	}
+
+	if pm.pathInfo != nil {
+		if alt := pm.pathInfo.BaseNameNoIdentifier(); strings.EqualFold(alt, name) {
+			return name
+		}
+	}
+
+	return name
+}
