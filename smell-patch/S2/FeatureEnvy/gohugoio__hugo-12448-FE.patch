+func (m *pageMap) getLayoutDescriptor(p *pageState) layouts.LayoutDescriptor {
+	p.layoutDescriptorInit.Do(func() {
+		var section string
+		sections := p.SectionsEntries()
+		meta := p.m
+		cfg := meta.pageConfig
+		kind := cfg.Kind
+
+		switch kind {
+		case kinds.KindSection:
+			if len(sections) > 0 {
+				section = sections[0]
+			}
+		case kinds.KindTaxonomy, kinds.KindTerm:
+			if meta.singular != "" {
+				section = meta.singular
+			} else if len(sections) > 0 {
+				section = sections[0]
+			}
+		default:
+		}
+
+		typ := cfg.Type
+		if typ == "" {
+			if sect := meta.pathInfo.Section(); sect != "" {
+				typ = sect
+			} else {
+				typ = defaultContentType
+			}
+		}
+
+		p.layoutDescriptor = layouts.LayoutDescriptor{
+			Kind:    kind,
+			Type:    typ,
+			Lang:    m.cfg.lang,
+			Layout:  cfg.Layout,
+			Section: section,
+		}
+	})
+
+	return p.layoutDescriptor
+}
