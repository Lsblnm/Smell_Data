--- a/src/Illuminate/Support/MessageBag.php
+++ b/src/Illuminate/Support/MessageBag.php
@@ -351,6 +351,82 @@ public function getFormat()
         return $this->format;
     }
 
+    /**
+     * Get the given attribute from the attribute translations.
+     *
+     * @param  string  $name
+     * @param  \Illuminate\Validation\Validator  $validator
+     * @return string|null
+     */
+    public function getAttributeFromTranslations($name, $validator)
+    {
+        $format = $this->format;
+
+        $translator = $validator->getTranslator();
+        $data = $validator->getData();
+        $rules = $validator->getRules();
+        $customAttributes = $validator->customAttributes;
+        $customMessages = $validator->customMessages;
+        $customValues = $validator->customValues;
+
+        $locale = $translator->getLocale();
+        $fallback = method_exists($translator, 'getFallback') ? $translator->getFallback() : null;
+        $lineLocale = $locale ?: $fallback;
+
+        $payload = new Fluent(is_array($data) ? $data : []);
+        $input = new ValidatedInput(is_array($data) ? $data : []);
+        $payloadAttributes = $payload->getAttributes();
+        $presentInput = $input->all();
+
+        $key = 'validation.attributes';
+
+        if (method_exists($translator, 'parseKey')) {
+            [$namespace, $group, $item] = $translator->parseKey($key);
+
+            if ($group && $item) {
+                $key = ($namespace && $namespace !== '*')
+                    ? "{$namespace}::{$group}.{$item}"
+                    : "{$group}.{$item}";
+            }
+        }
+
+        $loader = method_exists($translator, 'getLoader') ? $translator->getLoader() : null;
+        $namespaces = is_object($loader) && method_exists($loader, 'namespaces')
+            ? $loader->namespaces()
+            : [];
+
+        $hasLocalContext = $format !== ''
+            && (isset($customAttributes[$name])
+                || isset($customMessages[$name])
+                || isset($customValues[$name])
+                || isset($rules[$name])
+                || array_key_exists($name, $payloadAttributes)
+                || array_key_exists($name, $presentInput)
+                || $namespaces !== []);
+
+        if ($hasLocalContext || $format !== '') {
+            $attributes = $translator->get($key, [], $lineLocale);
+        } else {
+            $attributes = $translator->get($key, [], $lineLocale);
+        }
+
+        $source = Arr::dot((array) $attributes);
+
+        if (isset($source[$name])) {
+            return (new HtmlString($source[$name]))->toHtml();
+        }
+
+        foreach (array_keys($source) as $sourceKey) {
+            if (str_contains($sourceKey, '*')) {
+                $pattern = str_replace('\*', '([^.]*)', preg_quote($sourceKey, '#'));
+
+                if (preg_match('#^'.$pattern.'\z#u', $name) === 1) {
+                    return (new HtmlString($source[$sourceKey]))->toHtml();
+                }
+            }
+        }
+    }
+
