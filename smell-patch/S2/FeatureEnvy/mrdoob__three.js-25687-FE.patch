diff --git a/src/core/Layers.js b/src/core/Layers.js
index 568afe924b..1adab7cc89 100644
--- a/src/core/Layers.js
+++ b/src/core/Layers.js
@@ -1,3 +1,121 @@
+function writeIdentity( source, object ) {
+
+	object.uuid = source.uuid;
+	object.type = source.type;
+
+	if ( source.name !== '' ) object.name = source.name;
+	if ( source.castShadow === true ) object.castShadow = true;
+	if ( source.receiveShadow === true ) object.receiveShadow = true;
+	if ( source.visible === false ) object.visible = false;
+	if ( source.frustumCulled === false ) object.frustumCulled = false;
+	if ( source.renderOrder !== 0 ) object.renderOrder = source.renderOrder;
+	if ( Object.keys( source.userData ).length > 0 ) object.userData = source.userData;
+
+}
+
+function appendInstancedMesh( source, object ) {
+
+	if ( source.isInstancedMesh ) {
+
+		object.type = 'InstancedMesh';
+		object.count = source.count;
+		object.instanceMatrix = source.instanceMatrix.toJSON();
+		if ( source.instanceColor !== null ) object.instanceColor = source.instanceColor.toJSON();
+
+	}
+
+}
+
+function appendDrawableGeometry( source, object, serialize, meta ) {
+
+	if ( source.isMesh || source.isLine || source.isPoints ) {
+
+		object.geometry = serialize( meta.geometries, source.geometry );
+
+		const parameters = source.geometry.parameters;
+
+		if ( parameters !== undefined && parameters.shapes !== undefined ) {
+
+			const shapes = parameters.shapes;
+
+			if ( Array.isArray( shapes ) ) {
+
+				for ( let i = 0, l = shapes.length; i < l; i ++ ) {
+
+					const shape = shapes[ i ];
+
+					serialize( meta.shapes, shape );
+
+				}
+
+			} else {
+
+				serialize( meta.shapes, shapes );
+
+			}
+
+		}
+
+	}
+
+}
+
+function appendSkinnedMesh( source, object, serialize, meta ) {
+
+	if ( source.isSkinnedMesh ) {
+
+		object.bindMode = source.bindMode;
+		object.bindMatrix = source.bindMatrix.toArray();
+
+		if ( source.skeleton !== undefined ) {
+
+			serialize( meta.skeletons, source.skeleton );
+
+			object.skeleton = source.skeleton.uuid;
+
+		}
+
+	}
+
+}
+
+function extractFromCache( cache ) {
+
+	const values = [];
+	for ( const key in cache ) {
+
+		const data = cache[ key ];
+		delete data.metadata;
+		values.push( data );
+
+	}
+
+	return values;
+
+}
+
+function collectCachedResources( output, meta ) {
+
+	const geometries = extractFromCache( meta.geometries );
+	const materials = extractFromCache( meta.materials );
+	const textures = extractFromCache( meta.textures );
+	const images = extractFromCache( meta.images );
+	const shapes = extractFromCache( meta.shapes );
+	const skeletons = extractFromCache( meta.skeletons );
+	const animations = extractFromCache( meta.animations );
+	const nodes = extractFromCache( meta.nodes );
+
+	if ( geometries.length > 0 ) output.geometries = geometries;
+	if ( materials.length > 0 ) output.materials = materials;
+	if ( textures.length > 0 ) output.textures = textures;
+	if ( images.length > 0 ) output.images = images;
+	if ( shapes.length > 0 ) output.shapes = shapes;
+	if ( skeletons.length > 0 ) output.skeletons = skeletons;
+	if ( animations.length > 0 ) output.animations = animations;
+	if ( nodes.length > 0 ) output.nodes = nodes;
+
+}
+
 class Layers {
 
 	constructor() {
@@ -54,6 +172,159 @@ class Layers {
 
 	}
 
+	serializeObject( source, meta ) {
+
+		// meta is a string when called from JSON.stringify
+		const isRootObject = ( meta === undefined || typeof meta === 'string' );
+
+		const output = {};
+
+		// meta is a hash used to collect geometries, materials.
+		// not providing it implies that this is the root object
+		// being serialized.
+		if ( isRootObject ) {
+
+			// initialize meta obj
+			meta = {
+				geometries: {},
+				materials: {},
+				textures: {},
+				images: {},
+				shapes: {},
+				skeletons: {},
+				animations: {},
+				nodes: {}
+			};
+
+			output.metadata = {
+				version: 4.5,
+				type: 'Object',
+				generator: 'Object3D.toJSON'
+			};
+
+		}
+
+		const object = {};
+
+		writeIdentity( source, object );
+
+		object.layers = this.mask;
+
+		const te = source.matrix.elements;
+		object.matrix = [
+			te[ 0 ], te[ 1 ], te[ 2 ], te[ 3 ],
+			te[ 4 ], te[ 5 ], te[ 6 ], te[ 7 ],
+			te[ 8 ], te[ 9 ], te[ 10 ], te[ 11 ],
+			te[ 12 ], te[ 13 ], te[ 14 ], te[ 15 ]
+		];
+
+		if ( source.matrixAutoUpdate === false ) object.matrixAutoUpdate = false;
+
+		function serialize( library, element ) {
+
+			if ( library[ element.uuid ] === undefined ) {
+
+				library[ element.uuid ] = element.toJSON( meta );
+
+			}
+
+			return element.uuid;
+
+		}
+
+		appendInstancedMesh( source, object );
+
+		if ( source.isScene ) {
+
+			const background = source.background;
+
+			if ( background ) {
+
+				if ( background.isColor ) {
+
+					object.background = background.toJSON();
+
+				} else if ( background.isTexture ) {
+
+					object.background = background.toJSON( meta ).uuid;
+
+				}
+
+			}
+
+			const environment = source.environment;
+
+			if ( environment && environment.isTexture && environment.isRenderTargetTexture !== true ) {
+
+				object.environment = environment.toJSON( meta ).uuid;
+
+			}
+
+		}
+
+		appendDrawableGeometry( source, object, serialize, meta );
+		appendSkinnedMesh( source, object, serialize, meta );
+
+		if ( source.material !== undefined ) {
+
+			if ( Array.isArray( source.material ) ) {
+
+				const uuids = [];
+
+				for ( let i = 0, l = source.material.length; i < l; i ++ ) {
+
+					uuids.push( serialize( meta.materials, source.material[ i ] ) );
+
+				}
+
+				object.material = uuids;
+
+			} else {
+
+				object.material = serialize( meta.materials, source.material );
+
+			}
+
+		}
+
+		if ( source.children.length > 0 ) {
+
+			object.children = [];
+
+			for ( let i = 0; i < source.children.length; i ++ ) {
+
+				object.children.push( source.children[ i ].toJSON( meta ).object );
+
+			}
+
+		}
+
+		if ( source.animations.length > 0 ) {
+
+			object.animations = [];
+
+			for ( let i = 0; i < source.animations.length; i ++ ) {
+
+				const animation = source.animations[ i ];
+
+				object.animations.push( serialize( meta.animations, animation ) );
+
+			}
+
+		}
+
+		if ( isRootObject ) {
+
+			collectCachedResources( output, meta );
+
+		}
+
+		output.object = object;
+
+		return output;
+
+	}
+
 }
 
 
