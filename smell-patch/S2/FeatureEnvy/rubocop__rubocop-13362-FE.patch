diff --git a/lib/rubocop/cop/mixin/frozen_string_literal.rb b/lib/rubocop/cop/mixin/frozen_string_literal.rb
index 315880708..9eaff5fcf 100644
--- a/lib/rubocop/cop/mixin/frozen_string_literal.rb
+++ b/lib/rubocop/cop/mixin/frozen_string_literal.rb
@@ -39,6 +39,64 @@ module RuboCop
       end
       alias frozen_heredoc? uninterpolated_heredoc?
 
+      def immutable_literal?(node)
+        node = if node.type == :begin && node.children.first
+                 node.children.first
+               else
+                 node
+               end
+
+        return true if node.immutable_literal?
+
+        source = processed_source
+        cop_config = config
+        literal_types = FROZEN_STRING_LITERAL_TYPES_RUBY27
+        source_ruby = source.ruby_version
+
+        if source_ruby
+          tokens = source.tokens
+          first_code_token = tokens.find { |token| !token.comment? }
+          cutoff_line = first_code_token&.line
+          leading_lines = if first_code_token
+                            source.lines[0...first_code_token.line - 1]
+                          else
+                            source.lines
+                          end
+          specified_comment = leading_lines.filter_map { |line| MagicComment.parse(line) }
+                                           .find(&:frozen_string_literal_specified?)
+
+          unless specified_comment
+            tokens.each do |token|
+              break if cutoff_line && token.line >= cutoff_line
+              next unless token.comment?
+
+              magic_comment = MagicComment.parse(token.text)
+              if magic_comment.frozen_string_literal_specified?
+                specified_comment = magic_comment
+                break
+              end
+            end
+          end
+
+          frozen_enabled = if specified_comment
+                             specified_comment.frozen_string_literal?
+                           else
+                             default_frozen = cop_config.string_literals_frozen_by_default?
+                             default_frozen.nil? ? false : default_frozen
+                           end
+
+          if frozen_enabled
+            if cop_config.target_ruby_version >= 3.0
+              return true if uninterpolated_string?(node) || uninterpolated_heredoc?(node)
+            elsif literal_types.include?(node.type)
+              return true
+            end
+          end
+        end
+
+        cop_config.target_ruby_version >= 3.0 && (node.regexp_type? || node.range_type?)
+      end
+
       def frozen_string_literals_enabled?
         ruby_version = processed_source.ruby_version
         return false unless ruby_version
