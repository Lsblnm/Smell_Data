@@ -154,6 +154,36 @@ module RuboCop
           register_offense(node, guard_clause_source(guard_clause), kw, guard)
         end
 
+        def non_simple_if_unless?(node)
+          loc = node.loc
+          source_range = node.source_range
+          buffer = processed_source.buffer
+          tokens = processed_source.tokens
+
+          question_loc = loc.respond_to?(:question) ? loc.question : nil
+          return true if question_loc
+
+          keyword_range = loc.keyword
+          if keyword_range &&
+             keyword_range.begin_pos >= source_range.begin_pos &&
+             keyword_range.end_pos <= source_range.end_pos
+            keyword_begin = keyword_range.begin_pos
+            keyword_end = keyword_range.end_pos
+            keyword_text = buffer.source[keyword_begin...keyword_end]
+            keyword_token = tokens.find { |token| token.pos.begin_pos == keyword_begin }
+            token_text = keyword_token&.text
+            return true if keyword_text == 'elsif' && (token_text.nil? || token_text == 'elsif')
+          end
+
+          else_loc = loc.respond_to?(:else) ? loc.else : nil
+          if else_loc
+            else_text = buffer.source[else_loc.begin_pos...else_loc.end_pos]
+            return true unless else_text.nil?
+          end
+
+          false
+        end
+
         private
 
         def check_ending_body(body)
@@ -283,7 +313,8 @@ module RuboCop
         end
 
         def accepted_if?(node, ending)
-          return true if node.modifier_form? || node.ternary? || node.elsif_conditional?
+          return true if node.modifier_form? || node.elsif_conditional? ||
+                         (non_simple_if_unless?(node) && node.ternary?)
 
           if ending
             node.else?
