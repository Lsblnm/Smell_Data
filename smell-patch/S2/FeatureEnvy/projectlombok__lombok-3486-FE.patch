+	void generateSimpleSetterMethodForBuilder(HandleSuperBuilder.SuperBuilderJob job, boolean deprecate, BuilderFieldData builderField, JCExpression returnType, JCStatement returnStatement, String setterPrefix) {
+		JavacNode fieldNode = builderField.createdFields.get(0);
+		if (fieldNode.getKind() != Kind.FIELD) {
+			fieldNode.addError(SETTER_NODE_NOT_SUPPORTED_ERR);
+			return;
+		}
+
+		Name paramName = builderField.name;
+		Name nameOfSetFlag = builderField.nameOfSetFlag;
+		List<JCAnnotation> annosOnParam = builderField.annotations;
+		JavacNode originalFieldNode = builderField.originalFieldNode;
+		JavacNode sourceNode = job.sourceNode;
+		JavacNode builderType = job.builderAbstractType;
+		CheckerFrameworkVersion checkerFramework = job.checkerFramework;
+
+		String setterName = buildAccessorName(sourceNode, setterPrefix, paramName.toString());
+		Name setterName_ = job.toName(setterName);
+
+		for (JavacNode child : builderType.down()) {
+			if (child.getKind() != Kind.METHOD) continue;
+			JCMethodDecl methodDecl = (JCMethodDecl) child.get();
+			Name existingName = methodDecl.name;
+			if (existingName.equals(setterName_) && !isTolerate(fieldNode, methodDecl)) return;
+		}
+
+		JavacTreeMaker maker = job.getTreeMaker();
+		List<JCAnnotation> methodAnns = findCopyableToSetterAnnotations(originalFieldNode);
+		if (checkerFramework.generateReturnsReceiver()) {
+			returnType = addCheckerFrameworkReturnsReceiver(returnType, maker, builderType, checkerFramework);
+		}
+
+		JCMethodDecl newMethod = createSetter(Flags.PUBLIC, deprecate, fieldNode, maker, setterName, paramName, nameOfSetFlag, returnType, returnStatement, sourceNode, methodAnns, annosOnParam);
+		injectMethod(builderType, newMethod);
+	}
 }
