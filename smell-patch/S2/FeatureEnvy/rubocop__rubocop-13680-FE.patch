+++ b/lib/rubocop/cop/style/redundant_line_continuation.rb
@@ -160,9 +160,50 @@ module RuboCop
         #     argument
         def method_with_argument?(line_range, current_token, next_token)
           return false unless ARGUMENT_TAKING_FLOW_TOKEN_TYPES.include?(current_token.type)
-          return false unless current_token.pos.overlaps?(line_range)
 
-          ARGUMENT_TYPES.include?(next_token.type)
+          token_pos = current_token.pos
+          return false unless token_pos.begin_pos < line_range.end_pos &&
+                              token_pos.end_pos > line_range.begin_pos
+          return false unless line_range.source_line.include?(current_token.text)
+          return false unless ARGUMENT_TYPES.include?(next_token.type)
+
+          comment_config = processed_source.comment_config
+          configured_source = comment_config.processed_source
+          return false if comment_config.comment_only_line?(token_pos.line)
+          return false unless comment_config.cop_enabled_at_line?(self.class.cop_name, token_pos.line)
+
+          fragment = configured_source.buffer.source[token_pos.end_pos...next_token.pos.begin_pos]
+          return false unless fragment&.include?(LINE_CONTINUATION)
+
+          comment = configured_source.comment_at_line(token_pos.line)
+          !(comment && comment.text.end_with?(LINE_CONTINUATION))
+        end
+
+        # which lines start inside a string literal?
+        # rubocop:disable Metrics/AbcSize, Metrics/CyclomaticComplexity, Metrics/PerceivedComplexity
+        def ignored_literal_ranges(ast)
+          return [] if ast.nil?
+
+          ast.each_node(:str, :dstr, :array).with_object(Set.new) do |literal, ranges|
+            loc = literal.location
+
+            if literal.array_type?
+              next unless literal.percent_literal?
+
+              ranges << loc.expression
+            elsif literal.heredoc?
+              ranges << loc.heredoc_body
+            elsif (loc.respond_to?(:begin) && loc.begin) || ignored_parent?(literal)
+              ranges << loc.expression
+            end
+          end
+        end
+        # rubocop:enable Metrics/AbcSize, Metrics/CyclomaticComplexity, Metrics/PerceivedComplexity
+
+        def ignored_parent?(node)
+          return false unless node.parent
+
+          node.parent.type?(:regexp, :xstr)
         end
 
