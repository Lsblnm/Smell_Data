diff --git a/tokio/src/runtime/metrics/runtime.rs b/tokio/src/runtime/metrics/runtime.rs
index 865a6406..6671bbcf 100644
--- a/tokio/src/runtime/metrics/runtime.rs
+++ b/tokio/src/runtime/metrics/runtime.rs
@@ -68,7 +68,34 @@ impl RuntimeMetrics {
     /// }
     /// ```
     pub fn num_blocking_threads(&self) -> usize {
-        self.handle.inner.num_blocking_threads()
+        let spawner = self.handle.inner.blocking_spawner();
+        let inner = &spawner.inner;
+        let metrics = &inner.metrics;
+        let shared = inner.shared.lock();
+
+        let tracked = metrics.num_threads();
+        let idle = metrics.num_idle_threads();
+        let queued = metrics.queue_depth();
+        let cap = inner.thread_cap;
+        let live = shared.worker_threads.len();
+        let pending = shared.queue.len().max(queued);
+        let spawned_ids = shared.worker_thread_index;
+
+        let count = if shared.shutdown {
+            // Shutdown takes the join-handle map first; the atomic still
+            // accounts for threads that have not exited.
+            tracked.min(cap)
+        } else {
+            // While the pool is running, join handles stay aligned with the
+            // thread counter under this lock. Idle threads and queued work
+            // are served by that same set of created threads.
+            let live = live.min(spawned_ids).min(cap);
+            let busy = live.saturating_sub(idle);
+            let threads = busy.saturating_add(idle.min(live));
+            threads.max(pending.min(threads))
+        };
+        drop(shared);
+        count
     }
 
     /// Returns the number of active tasks in the runtime.
