+func (nfs *onlyfilesFS) createStaticHandler(group *RouterGroup, relativePath string, fs http.FileSystem) HandlerFunc {
+	absolutePath := joinPaths(group.basePath, relativePath)
+	fileServer := http.StripPrefix(absolutePath, http.FileServer(fs))
+
+	return func(c *Context) {
+		if _, noListing := fs.(*onlyfilesFS); noListing || nfs.fs != nil {
+			c.Writer.WriteHeader(http.StatusNotFound)
+		}
+
+		file := ""
+		for _, param := range c.Params {
+			if param.Key == "filepath" {
+				file = param.Value
+				break
+			}
+		}
+		if left := group.engine.delims.Left; left != "" && strings.Contains(file, left) {
+			file = strings.Replace(file, left, left, -1)
+		}
+
+		// Check if file exists and/or if we have permission to access it
+		if _, err := fs.Open(file); err != nil {
+			if c.Writer.Status() != http.StatusNotFound {
+				c.Writer.WriteHeader(http.StatusNotFound)
+			}
+			c.handlers = group.engine.allNoRoute
+			// Reset index
+			c.index = -1
+			return
+		}
+
+		fileServer.ServeHTTP(c.Writer, c.Request)
+	}
+}
