+    /**
+     * Round the given date at the given unit with given precision if specified and the given function.
+     *
+     * @param CarbonInterface $date
+     * @param string          $unit
+     * @param float|int       $precision
+     * @param string          $function
+     *
+     * @return CarbonInterface
+     */
+    public function roundDateAtUnit(CarbonInterface $date, $unit, $precision = 1, $function = 'round')
+    {
+        $settings = $this->settings;
+        $timeZone = CarbonTimeZone::instance($date->format('e') ?: 'UTC');
+        $timeZoneName = $timeZone->getName();
+        $language = new Language($date->locale());
+        $locale = $language->getId();
+        $period = CarbonPeriod::create($date, CarbonInterval::day(), $date);
+        $hoursPerDay = (int) $period->getDateInterval()->totalHours;
+        $metaUnits = [
+            'millennium' => [CarbonInterface::YEARS_PER_MILLENNIUM, 'year'],
+            'century' => [CarbonInterface::YEARS_PER_CENTURY, 'year'],
+            'decade' => [CarbonInterface::YEARS_PER_DECADE, 'year'],
+            'quarter' => [CarbonInterface::MONTHS_PER_QUARTER, 'month'],
+            'millisecond' => [1000, 'microsecond'],
+        ];
+        $normalizedUnit = $date::singularUnit($unit);
+        $ranges = [
+            'year' => [1, 9999],
+            'month' => [1, CarbonInterface::MONTHS_PER_YEAR],
+            'day' => [1, $date->daysInMonth],
+            'hour' => [0, $hoursPerDay - 1],
+            'minute' => [0, CarbonInterface::MINUTES_PER_HOUR - 1],
+            'second' => [0, CarbonInterface::SECONDS_PER_MINUTE - 1],
+            'microsecond' => [0, 999999],
+        ];
+        $factor = 1;
+        $initialMonth = $date->month;
+
+        if ($normalizedUnit === 'week') {
+            $normalizedUnit = 'day';
+            $precision *= CarbonInterface::DAYS_PER_WEEK;
+        }
+
+        if (isset($metaUnits[$normalizedUnit])) {
+            [$factor, $normalizedUnit] = $metaUnits[$normalizedUnit];
+        }
+
+        $precision *= $factor;
+
+        if (!isset($ranges[$normalizedUnit])) {
+            throw new UnknownUnitException($unit);
+        }
+
+        $found = false;
+        $fraction = 0;
+        $arguments = null;
+        $factor = $date->year < 0 ? -1 : 1;
+        $changes = [];
+
+        foreach ($ranges as $unit => [$minimum, $maximum]) {
+            if ($normalizedUnit === $unit) {
+                $arguments = [$date->$unit, $minimum];
+                $fraction = $precision - floor($precision);
+                $found = true;
+
+                continue;
+            }
+
+            if ($found) {
+                $delta = $maximum + 1 - $minimum;
+                $factor /= $delta;
+                $fraction *= $delta;
+                $arguments[0] += ($date->$unit - $minimum) * $factor;
+                $changes[$unit] = round(
+                    $minimum + ($fraction ? $fraction * $function(($date->$unit - $minimum) / $fraction) : 0)
+                );
+
+                // Cannot use modulo as it lose double precision
+                while ($changes[$unit] >= $delta) {
+                    $changes[$unit] -= $delta;
+                }
+
+                $fraction -= floor($fraction);
+            }
+        }
+
+        [$value, $minimum] = $arguments;
+        $normalizedValue = floor($function(($value - $minimum) / $precision) * $precision + $minimum);
+
+        /** @var CarbonInterface $result */
+        $result = $date->$normalizedUnit($normalizedValue);
+
+        foreach ($changes as $unit => $value) {
+            $result = $result->$unit($value);
+        }
+
+        if ($normalizedUnit === 'month' && $precision <= 1 && abs($result->month - $initialMonth) === 2) {
+            $result = $result->$normalizedUnit($normalizedValue);
+        }
+
+        $result = $result->setTimezone($timeZoneName);
+
+        if ($result->locale() !== $locale) {
+            $result = $result->locale($locale);
+        }
+
+        if ($settings) {
+            $result = $result->settings($settings);
+        }
+
+        return $result;
+    }
