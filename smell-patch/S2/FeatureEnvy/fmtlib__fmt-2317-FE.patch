+template <typename Char>
+class hex_float_writer {
+ private:
+  align::type align_;
+
+ public:
+  explicit hex_float_writer(align::type align = align::left) : align_(align) {}
+
+  template <typename OutputIt, typename T>
+  OutputIt write(OutputIt out, T value, const basic_format_specs<Char>& specs,
+                 const float_specs& fspecs, buffer<char>& buf) {
+    if (fspecs.format == float_format::hex && fspecs.sign)
+      buf.push_back(data::signs[fspecs.sign]);
+    snprintf_float(promote_float(value), specs.precision, fspecs, buf);
+
+    byte_arg_value payload(buf.data(), buf.size());
+    const char* bytes = payload.data();
+    size_t size = payload.size();
+    unsigned spec_width = to_unsigned(specs.width);
+    size_t padding = spec_width > size ? spec_width - size : 0;
+    auto* shifts = align_ == align::left ? data::left_padding_shifts
+                                         : data::right_padding_shifts;
+    size_t left_padding = padding >> shifts[specs.align];
+    size_t right_padding = padding - left_padding;
+    size_t fill_size = specs.fill.size();
+    const Char* fill_data = specs.fill.data();
+    auto it = reserve(out, size + padding * fill_size);
+    if (left_padding != 0) {
+      if (fill_size == 1)
+        it = detail::fill_n(it, left_padding, fill_data[0]);
+      else {
+        for (size_t i = 0; i < left_padding; ++i)
+          it = copy_str<Char>(fill_data, fill_data + fill_size, it);
+      }
+    }
+    it = copy_str<Char>(bytes, bytes + size, it);
+    if (right_padding != 0) {
+      if (fill_size == 1)
+        it = detail::fill_n(it, right_padding, fill_data[0]);
+      else {
+        for (size_t i = 0; i < right_padding; ++i)
+          it = copy_str<Char>(fill_data, fill_data + fill_size, it);
+      }
+    }
+    return base_iterator(out, it);
+  }
+};
