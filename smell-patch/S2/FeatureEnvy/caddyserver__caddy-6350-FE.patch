+			sourceFile = surrounding.Keys[0].File
+		}
+		if sourceFile == "" && len(surrounding.Segments) > 0 && len(surrounding.Segments[0]) > 0 {
+			sourceFile = surrounding.Segments[0][0].File
+		}
+
+		if val == "" && tok.Line == 0 && sourceFile == "" && !surrounding.HasBraces && !surrounding.IsNamedRoute {
+			continue
+		}
+
+		if rejectForwarded && val == "forwarded" {
