+			m.Ranges = append(m.Ranges, staticRanges.Ranges...)
 			continue
 		}
-		m.Ranges = append(m.Ranges, d.Val())
+
+		clientRanges.Ranges = append(clientRanges.Ranges[:0], val)
+		m.Ranges = append(m.Ranges, clientRanges.Ranges...)
 	}
 	if d.NextBlock(0) {
-		return d.Err("malformed remote_ip matcher: blocks are not supported")
+		return d.Err(blockErr)
 	}
