diff --git a/lib/rubocop/cop/style/sole_nested_conditional.rb b/lib/rubocop/cop/style/sole_nested_conditional.rb
index fe5ae21c9..54259f0b1 100644
--- a/lib/rubocop/cop/style/sole_nested_conditional.rb
+++ b/lib/rubocop/cop/style/sole_nested_conditional.rb
@@ -250,6 +250,32 @@ module RuboCop
           end
         end
 
+        def right_hand_operand(node, left_hand_keyword)
+          condition = node.condition
+          condition_range = condition.source_range
+          source_buffer = processed_source.buffer
+          condition_span = range_between(condition_range.begin_pos, condition_range.end_pos)
+          condition_text = source_buffer.source[condition_span.begin_pos...condition_span.end_pos]
+
+          expr = if condition.send_type? && !condition.arguments.empty? &&
+                    !condition.operator_method?
+                   receiver = condition.receiver
+                   selector = condition.loc.selector
+                   rebuilt = +''
+                   rebuilt << "#{receiver.source}." if receiver
+                   rebuilt << source_buffer.source[selector.begin_pos...selector.end_pos]
+                   rebuilt << "(#{condition.arguments.map(&:source).join(', ')})"
+                   rebuilt
+                 else
+                   condition_text
+                 end
+
+          comparison_child = RuboCop::AST::Node::COMPARISON_OPERATORS & condition.children
+          expr = "(#{expr})" if condition.or_type? || !comparison_child.empty?
+          expr = "!#{expr}" unless left_hand_keyword == node.keyword
+          expr
+        end
+
         def parenthesized_method_arguments(node)
           method_call = node.source_range.begin.join(node.loc.selector.end).source
           arguments = node.first_argument.source_range.begin.join(node.source_range.end).source
