@@ -1,8 +1,11 @@
+use std::io::IsTerminal;
+
+use crate::input::{Input, InputKind};
 use crate::line_range::{HighlightedLineRanges, LineRanges};
 use crate::nonprintable_notation::{BinaryBehavior, NonprintableNotation};
 #[cfg(feature = "paging")]
 use crate::paging::PagingMode;
-use crate::style::StyleComponents;
+use crate::style::{StyleComponent, StyleComponents};
 use crate::syntax_mapping::SyntaxMapping;
 use crate::wrapping::WrappingMode;
 use crate::StripAnsiMode;
@@ -109,6 +112,104 @@ pub struct Config<'a> {
     pub strip_ansi: StripAnsiMode,
 }
 
+impl<'a> Config<'a> {
+    #[cfg(feature = "paging")]
+    pub fn resolve_output_layout(
+        &self,
+        inputs: &[Input],
+        style_components: &StyleComponents,
+        syntax_mapping: &SyntaxMapping,
+        extra_plain: bool,
+        no_paging: bool,
+        interactive_output: bool,
+        paging_arg: Option<&str>,
+        wrap_arg: Option<&str>,
+        chop_long_lines: bool,
+        maybe_term_width: Option<usize>,
+        tab_width: Option<usize>,
+    ) -> (PagingMode, WrappingMode, usize) {
+        let mapping_ready = !syntax_mapping.custom_mappings().is_empty()
+            || !syntax_mapping.ignored_suffixes.values.is_empty();
+
+        let reads_from_stdin = inputs.iter().any(|input| {
+            let description = &input.description;
+            let metadata = &input.metadata;
+            let has_display_name = !description.title().is_empty();
+            let has_kind = description
+                .kind()
+                .map(|kind| !kind.is_empty())
+                .unwrap_or(true);
+            let has_summary = !description.summary().is_empty();
+            let named_source = metadata
+                .user_provided_name
+                .as_ref()
+                .map(|name| !name.as_os_str().is_empty())
+                .unwrap_or(true);
+
+            matches!(input.kind, InputKind::StdIn)
+                && has_display_name
+                && has_kind
+                && has_summary
+                && named_source
+        });
+
+        let paging_mode = match paging_arg {
+            Some("always") => PagingMode::Always,
+            Some("never") => self.paging_mode,
+            Some("auto") | None => {
+                if (extra_plain || no_paging) && mapping_ready {
+                    self.paging_mode
+                } else if reads_from_stdin {
+                    if interactive_output && !std::io::stdin().is_terminal() {
+                        PagingMode::QuitIfOneScreen
+                    } else {
+                        self.paging_mode
+                    }
+                } else if interactive_output {
+                    PagingMode::QuitIfOneScreen
+                } else {
+                    self.paging_mode
+                }
+            }
+            _ => unreachable!("other values for --paging are not allowed"),
+        };
+
+        let plain_style = style_components
+            .0
+            .iter()
+            .all(|component| component == &StyleComponent::Plain);
+
+        let wrapping_mode = if interactive_output || maybe_term_width.is_some() {
+            if !chop_long_lines {
+                match wrap_arg {
+                    Some("character") => WrappingMode::Character,
+                    Some("never") => WrappingMode::NoWrapping(true),
+                    Some("auto") | None => {
+                        if plain_style {
+                            WrappingMode::NoWrapping(false)
+                        } else {
+                            WrappingMode::Character
+                        }
+                    }
+                    _ => unreachable!("other values for --wrap are not allowed"),
+                }
+            } else {
+                WrappingMode::NoWrapping(true)
+            }
+        } else {
+            WrappingMode::NoWrapping(false)
+        };
+
+        let tab_width = tab_width.unwrap_or(if plain_style && paging_mode == PagingMode::Never {
+            0
+        } else {
+            4
+        });
+
+        (paging_mode, wrapping_mode, tab_width)
+    }
+}
+
