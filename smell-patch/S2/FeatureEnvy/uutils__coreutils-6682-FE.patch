+/// Permission bits applied to directories created as parents.
+#[derive(Clone, Debug)]
+pub struct ModePlan {
+    /// Mode assigned to parent directories created with `-p`.
+    pub parent_mode: u32,
+    /// Reporting details for created directories.
+    pub report: CreationReport,
+}
+
+/// Layout of a directory that should be created.
+#[derive(Clone, Debug)]
+pub struct DirectoryLayout {
+    /// Path of the directory to create.
+    pub target: PathBuf,
+    /// Whether this path is an intermediate parent.
+    pub is_parent: bool,
+    /// Mode and reporting plan for the directory.
+    pub mode_plan: ModePlan,
+}
+
+impl DirectoryLayout {
+    /// Build a layout describing a directory creation request.
+    pub fn for_creation(
+        target: PathBuf,
+        is_parent: bool,
+        parent_mode: u32,
+        verbose: bool,
+    ) -> Self {
+        Self {
+            target,
+            is_parent,
+            mode_plan: ModePlan {
+                parent_mode,
+                report: CreationReport::for_directory_creation(verbose),
+            },
+        }
+    }
+
+    /// Derive a layout for an ancestor that must be created first.
+    pub fn for_parent(&self, parent: &Path) -> Self {
+        Self {
+            target: parent.to_path_buf(),
+            is_parent: true,
+            mode_plan: self.mode_plan.clone(),
+        }
+    }
+}
+
