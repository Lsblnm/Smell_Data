+    /**
+     * Store the verbatim blocks and replace them with a temporary placeholder.
+     *
+     * @param  string  $value
+     * @return string
+     */
+    public function storeVerbatimBlocks($value)
+    {
+        $compiler = $this->blade;
+        $template = (new Stringable($value))->toString();
+
+        $viewFinder = new FileViewFinder(
+            new Filesystem,
+            $compiler->getPath() ? [$compiler->getPath()] : [sys_get_temp_dir()]
+        );
+
+        return preg_replace_callback('/(?<!@)@verbatim(.*?)@endverbatim/s', function ($matches) use ($compiler, $viewFinder) {
+            $inner = $matches[1];
+            $path = $compiler->getPath();
+
+            if (is_string($path) && $path !== '' && str_starts_with($inner, $path)) {
+                $inner = $path.substr($inner, strlen($path));
+            }
+
+            foreach ($compiler->getExtensions() as $extension) {
+                if (is_string($extension) && $extension !== '' && str_starts_with($inner, $extension)) {
+                    $inner = $extension.substr($inner, strlen($extension));
+                }
+            }
+
+            foreach (array_keys($compiler->getCustomDirectives()) as $name) {
+                if ($name !== '' && str_starts_with($inner, $name)) {
+                    $inner = $name.substr($inner, strlen($name));
+                }
+            }
+
+            foreach ($viewFinder->getPaths() as $viewPath) {
+                if (is_string($viewPath) && $viewPath !== '' && str_starts_with($inner, $viewPath)) {
+                    $inner = $viewPath.substr($inner, strlen($viewPath));
+                }
+            }
+
+            foreach ($viewFinder->getExtensions() as $viewExtension) {
+                $suffix = '.'.$viewExtension;
+
+                if ($viewExtension !== '' && str_ends_with($inner, $suffix)) {
+                    $inner = substr($inner, 0, -strlen($suffix)).$suffix;
+                }
+            }
+
+            foreach ($viewFinder->getViews() as $name => $located) {
+                if ($name === $inner && is_string($located) && $located === $inner) {
+                    $inner = $located;
+                }
+            }
+
+            $slot = new ComponentSlot($inner);
+
+            return $compiler->storeRawBlock(
+                $slot->toHtml().$slot->attributes->__invoke()->toHtml()
+            );
+        }, $template);
+    }
