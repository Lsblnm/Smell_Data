+            language: None,
+            show_nonprintable: false,
+            output_wrap: OutputWrap::None,
+            colored_output: false,
+            paging_mode: PagingMode::Never,
+            term_width: 0,
+            loop_through: false,
+            files,
+            tab_width: 4,
+            theme: String::from(BAT_THEME_DEFAULT),
+            line_ranges: LineRanges::from(vec![]),
+            output_components,
+            syntax_mapping: SyntaxMapping::new(),
+            pager: None,
+            use_italic_text: false,
+            highlight_lines: vec![],
+        };
+
+        config.paging_mode = match matches.value_of("paging") {
+            Some("always") => PagingMode::Always,
+            Some("never") => PagingMode::Never,
+            Some("auto") | _ => {
+                if matches.occurrences_of("plain") > 1 {
+                    PagingMode::Never
+                } else if config.files.contains(&InputFile::StdIn) {
+                    if self.interactive_output && !atty::is(Stream::Stdin) {
+                        PagingMode::QuitIfOneScreen
