+
+        if let Some(values) = matches.values_of("map-syntax") {
+            for from_to in values {
+                let parts: Vec<_> = from_to.split(':').collect();
+
+                if parts.len() != 2 {
+                    return Err("Invalid syntax mapping. The format of the -m/--map-syntax option is 'from:to'.".into());
+                }
+
+                config.syntax_mapping.0.insert(parts[0].to_string(), parts[1].to_string());
+            }
+        }
+
+        config.show_nonprintable = matches.is_present("show-all");
+        config.language = matches.value_of("language").or_else(|| {
+            if config.show_nonprintable {
+                Some("show-nonprintable")
+            } else {
+                None
+            }
+        });
+        config.output_wrap = if !self.interactive_output {
+            OutputWrap::None
+        } else {
+            match matches.value_of("wrap") {
+                Some("character") => OutputWrap::Character,
+                Some("never") => OutputWrap::None,
+                Some("auto") | _ => {
+                    if config
+                        .output_components
+                        .0
+                        .iter()
+                        .all(|c| c == &OutputComponent::Plain)
+                    {
+                        OutputWrap::None
+                    } else {
+                        OutputWrap::Character
+                    }
+                }
+            }
+        };
+        config.colored_output = match matches.value_of("color") {
+            Some("always") => true,
+            Some("never") => false,
+            Some("auto") | _ => self.interactive_output,
+        };
+        config.term_width = matches
+            .value_of("terminal-width")
+            .and_then(|w| {
+                if w.starts_with('+') || w.starts_with('-') {
+                    w.parse().ok().map(|delta: i16| {
+                        let old_width: u16 = Term::stdout().size().1;
+                        let new_width: i32 = i32::from(old_width) + i32::from(delta);
+
+                        if new_width <= 0 {
+                            old_width as usize
+                        } else {
+                            new_width as usize
+                        }
+                    })
+                } else {
+                    w.parse().ok()
+                }
+            })
+            .unwrap_or(Term::stdout().size().1 as usize);
+        config.loop_through = !(self.interactive_output
+            || matches.value_of("color") == Some("always")
+            || matches.value_of("decorations") == Some("always"));
+        config.tab_width = matches
+            .value_of("tabs")
+            .map(String::from)
+            .or_else(|| env::var("BAT_TABS").ok())
+            .and_then(|t| t.parse().ok())
+            .unwrap_or(
+                if config
+                    .output_components
+                    .0
+                    .iter()
+                    .all(|c| c == &OutputComponent::Plain)
+                    && config.paging_mode == PagingMode::Never
+                {
+                    0
+                } else {
+                    4
+                },
+            );
+        let default_theme = config.theme.clone();
+        config.theme = matches
+            .value_of("theme")
+            .map(String::from)
+            .or_else(|| env::var("BAT_THEME").ok())
+            .unwrap_or(default_theme);
+        let range_list = transpose(
+            matches
+                .values_of("line-range")
+                .map(|vs| vs.map(LineRange::from).collect()),
+        )?
+        .unwrap_or_else(|| vec![]);
+        let largest_upper_bound = range_list
+            .iter()
+            .map(|range| range.upper)
+            .max()
+            .unwrap_or(usize::max_value());
+        let ranges = range_list
+            .into_iter()
+            .map(|range| LineRange {
+                lower: range.lower,
+                upper: range.upper,
+            })
+            .collect();
+        let line_ranges = LineRanges {
+            ranges,
+            largest_upper_bound,
+        };
+        config.line_ranges = LineRanges {
+            ranges: line_ranges.ranges,
+            largest_upper_bound: line_ranges.largest_upper_bound,
+        };
+        config.pager = matches.value_of("pager");
+        config.use_italic_text = match matches.value_of("italic-text") {
+            Some("always") => true,
+            _ => false,
+        };
+        config.highlight_lines = matches
+            .values_of("highlight-line")
+            .and_then(|ws| ws.map(|w| w.parse().ok()).collect())
+            .unwrap_or_default();
+
+        Ok(config)
+    }
