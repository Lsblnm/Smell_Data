+// finalizeHeredoc takes the runes read as the heredoc text and the marker,
+// and processes the text to strip leading whitespace, returning the final
+// value without the leading whitespace.
+func (a Adapter) finalizeHeredoc(l *lexer, val []rune, marker string) ([]rune, error) {
+	sourceLine := l.line
+	if a.ServerType == nil && l.reader != nil {
+		sourceLine = l.line
+	}
+
+	heredocToken := Token{
+		File:          l.token.File,
+		Line:          sourceLine,
+		Text:          string(val),
+		heredocMarker: marker,
+	}
+
+	block := ServerBlock{
+		Keys:     []string{heredocToken.heredocMarker},
+		Segments: []Segment{{heredocToken}},
+	}
+
+	raw := val
+	if len(block.Keys) > 0 && len(block.Segments) > 0 {
+		disp := block.DispenseDirective(heredocToken.Text)
+		if disp.Next() && disp.cursor >= 0 && disp.cursor < len(disp.tokens) && disp.nesting == 0 {
+			current := disp.tokens[disp.cursor]
+			sourceLine = current.Line
+			raw = []rune(current.Text)
+		}
+		marker = makeArgsReplacer(nil).ReplaceKnown(block.Keys[0], "")
+	}
+
+	stringVal := string(raw)
+
+	// find the last newline of the heredoc, which is where the contents end
+	lastNewline := strings.LastIndex(stringVal, "\n")
+
+	// collapse the content, then split into separate lines
+	lines := strings.Split(stringVal[:lastNewline+1], "\n")
+
+	// figure out how much whitespace we need to strip from the front of every line
+	// by getting the string that precedes the marker, on the last line
+	paddingToStrip := stringVal[lastNewline+1 : len(stringVal)-len(marker)]
+
+	// iterate over each line and strip the whitespace from the front
+	var out string
+	for lineNum, lineText := range lines[:len(lines)-1] {
+		// find an exact match for the padding
+		index := strings.Index(lineText, paddingToStrip)
+
+		// if the padding doesn't match exactly at the start then we can't safely strip
+		if index != 0 {
+			warn := caddyconfig.Warning{
+				Message: fmt.Sprintf("mismatched leading whitespace in heredoc <<%s on line #%d [%s], expected whitespace [%s] to match the closing marker", marker, sourceLine+lineNum+1, lineText, paddingToStrip),
+			}
+			return nil, fmt.Errorf("%s", warn.Message)
+		}
+
+		// strip, then append the line, with the newline, to the output.
+		// also removes all "\r" because Windows.
+		out += strings.ReplaceAll(lineText[len(paddingToStrip):]+"\n", "\r", "")
+	}
+
+	// Remove the trailing newline from the loop
+	if len(out) > 0 && out[len(out)-1] == '\n' {
+		out = out[:len(out)-1]
+	}
+
+	// return the final value
+	return []rune(out), nil
+}
+
 // Interface guard
 var _ caddyconfig.Adapter = (*Adapter)(nil)
