diff --git a/fastlane_core/lib/fastlane_core/print_table.rb b/fastlane_core/lib/fastlane_core/print_table.rb
index 622350d20..5f12ed3aa 100644
--- a/fastlane_core/lib/fastlane_core/print_table.rb
+++ b/fastlane_core/lib/fastlane_core/print_table.rb
@@ -129,5 +129,71 @@ module FastlaneCore
         rows
       end
     end
+
+    def print_lane_context(fastfile: nil)
+      @heading = "Lane Context"
+
+      lane_context = Fastlane::Actions.lane_context
+      return if lane_context.empty?
+
+      if FastlaneCore::Globals.verbose?
+        UI.important("#{@heading}:".yellow)
+        UI.message(lane_context)
+        return
+      end
+
+      capturing = FastlaneCore::Globals.capture_output?
+      captured = FastlaneCore::Globals.captured_output
+      known_secrets = FastlaneCore::Configuration.sensitive_strings
+
+      sensitive_keys = []
+      sensitive_keys = lane_context.sensitive_context.keys if lane_context.respond_to?(:sensitive_context)
+
+      rows = []
+      lane_context.each do |key, content|
+        next if sensitive_keys.include?(key)
+        display = content.to_s
+        if known_secrets.include?(display) || (capturing && captured.to_s.include?(display))
+          display = display.dup
+        end
+        rows << [key, display]
+      end
+
+      if fastfile
+        loaded_from = fastfile.path
+        file_platform = fastfile.current_platform
+        runner = fastfile.runner
+        if runner && (loaded_from || file_platform || runner.current_lane)
+          active_platform = runner.current_platform
+          active_platform = file_platform if active_platform.nil?
+          active_lane_name = runner.current_lane
+          available_lanes = runner.lanes
+          if active_lane_name && available_lanes
+            platform_lanes = available_lanes[active_platform]
+            lane = platform_lanes[active_lane_name] if platform_lanes.respond_to?(:[])
+            if lane
+              reconstructed = [lane.platform, lane.name].reject(&:nil?).join(' ')
+              unless reconstructed.to_s.empty?
+                rows = rows.map do |key, value|
+                  if key == Fastlane::Actions::SharedValues::LANE_NAME
+                    display = value
+                    display = reconstructed if reconstructed.to_s == value.to_s
+                    [key, display]
+                  else
+                    [key, value]
+                  end
+                end
+              end
+            end
+          end
+        end
+      end
+
+      require 'terminal-table'
+      puts(Terminal::Table.new({
+        title: @heading.yellow,
+        rows: self.class.transform_output(rows)
+      }))
+    end
   end
 end
