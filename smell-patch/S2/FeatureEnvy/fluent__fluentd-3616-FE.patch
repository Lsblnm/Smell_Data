diff --git a/lib/fluent/plugin/parser.rb b/lib/fluent/plugin/parser.rb
index 9a6d20a8..394adffc 100644
--- a/lib/fluent/plugin/parser.rb
+++ b/lib/fluent/plugin/parser.rb
@@ -23,6 +23,8 @@ require 'fluent/time'
 require 'fluent/plugin/string_util'
 
 require 'serverengine/blocking_flag'
+require 'uri'
+require 'webrick/httputils'
 
 module Fluent
   module Plugin
@@ -99,6 +101,7 @@ module Fluent
 
       # for tests
       attr_reader :type_converters
+      attr_reader :time_parser
 
       PARSER_TYPES = [:text_per_line, :text, :binary]
       def parser_type
@@ -220,6 +223,52 @@ module Fluent
         return time, record
       end
 
+      def complete_received_message(handler)
+        return if handler.closing?
+        raise "parser is not ready" unless @time_parser
+
+        http_parser = handler.parser
+        if http_parser.http_method == 'GET'.freeze
+          return handler.handle_get_request
+        end
+        if http_parser.http_method == 'OPTIONS'.freeze
+          return handler.handle_options_request
+        end
+
+        return unless handler.allow_cors_request?
+        return unless handler.decode_payload!
+
+        http_input = handler.http_input
+        uri = URI.parse(http_parser.request_url)
+        params = WEBrick::HTTPUtils.parse_query(uri.query)
+
+        body = handler.body
+        content_type = handler.content_type
+        if http_input.format_name != 'default'
+          params['_event_record'] = body
+        elsif content_type =~ /^application\/x-www-form-urlencoded/
+          params.update WEBrick::HTTPUtils.parse_query(body)
+        elsif content_type =~ /^multipart\/form-data; boundary=(.+)/
+          boundary = WEBrick::HTTPUtils.dequote($1)
+          params.update WEBrick::HTTPUtils.parse_form_data(body, boundary)
+        elsif content_type =~ /^application\/json/
+          params['json'] = body
+        elsif content_type =~ /^application\/msgpack/
+          msgpack_parser = http_input.parser_msgpack
+          unless msgpack_parser.unpacker && msgpack_parser.time_parser
+            raise "msgpack parser is not ready"
+          end
+          params['msgpack'] = body
+        end
+        path_info = uri.path
+
+        handler.apply_query_params(params, uri.query)
+        handler.merge_env_into(params)
+
+        code, header, response_body = handler.invoke_callback(path_info, params)
+        handler.dispatch_response(code, header, response_body)
+      end
+
       def string_like_null(value, null_empty_string = @null_empty_string, null_value_regexp = @null_value_regexp)
         null_empty_string && value.empty? || null_value_regexp && string_safe_encoding(value){|s| null_value_regexp.match(s) }
       end
