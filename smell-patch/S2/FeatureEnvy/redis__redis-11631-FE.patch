+static struct {
+    char buf[128];
+} geo_distance_state;
+
+/* The default addReplyDouble has too much accuracy.  We use this
+ * for returning location distances. "5.2145 meters away" is nicer
+ * than "5.2144992818115 meters away." We provide 4 digits after the dot
+ * so that the returned value is decently accurate even when the unit is
+ * the kilometer. */
+void addReplyDoubleDistance(client *c, geoArray *ga, GeoShape *shape, robj *zobj,
+                            int withdist, int withhash, int withcoords,
+                            int storedist, long returned_items)
+{
+    if (zobj == NULL) {
+        int option_length = 0;
+        if (withdist)
+            option_length++;
+        if (withcoords)
+            option_length++;
+        if (withhash)
+            option_length++;
+
+        addReplyArrayLen(c, returned_items);
+        for (long i = 0; i < returned_items; i++) {
+            geoPoint *gp = ga->array+i;
+            gp->dist /= shape->conversion; /* Fix according to unit. */
+
+            /* If we have options in option_length, return each sub-result
+             * as a nested multi-bulk.  Add 1 to account for result value
+             * itself. */
+            if (option_length)
+                addReplyArrayLen(c, option_length + 1);
+
+            addReplyBulkSds(c,gp->member);
+            gp->member = NULL;
+
+            if (withdist) {
+                const int dlen = fixedpoint_d2string(geo_distance_state.buf,
+                                                     sizeof(geo_distance_state.buf),
+                                                     gp->dist, 4);
+                addReplyBulkCBuffer(c, geo_distance_state.buf, dlen);
+            }
+
+            if (withhash)
+                addReplyLongLong(c, gp->score);
+
+            if (withcoords) {
+                addReplyArrayLen(c, 2);
+                addReplyHumanLongDouble(c, gp->longitude);
+                addReplyHumanLongDouble(c, gp->latitude);
+            }
+        }
+    } else {
+        zset *zs = zobj->ptr;
+        size_t maxelelen = 0, totelelen = 0;
+        for (long i = 0; i < returned_items; i++) {
+            zskiplistNode *znode;
+            geoPoint *gp = ga->array+i;
+            gp->dist /= shape->conversion; /* Fix according to unit. */
+            double score = storedist ? gp->dist : gp->score;
+            size_t elelen = sdslen(gp->member);
+
+            if (maxelelen < elelen) maxelelen = elelen;
+            totelelen += elelen;
+            znode = zslInsert(zs->zsl,score,gp->member);
+            serverAssert(dictAdd(zs->dict,gp->member,&znode->score) == DICT_OK);
+            gp->member = NULL;
+        }
+        zsetConvertToListpackIfNeeded(zobj,maxelelen,totelelen);
+    }
+}
