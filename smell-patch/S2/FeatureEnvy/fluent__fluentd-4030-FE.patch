diff --git a/lib/fluent/plugin/out_forward/connection_manager.rb b/lib/fluent/plugin/out_forward/connection_manager.rb
index af7096ea..2886a760 100644
--- a/lib/fluent/plugin/out_forward/connection_manager.rb
+++ b/lib/fluent/plugin/out_forward/connection_manager.rb
@@ -78,6 +78,47 @@ module Fluent::Plugin
         end
       end
 
+      def read_ack_from_sock(ack_handler, sock)
+        begin
+          raw_data = sock.instance_of?(Fluent::PluginHelper::Socket::WrappedSocket::TLS) ? sock.readpartial(ack_handler.read_length) : sock.recv(ack_handler.read_length)
+        rescue Errno::ECONNRESET, EOFError # ECONNRESET for #recv, #EOFError for #readpartial
+          raw_data = ''
+        end
+
+        info = ack_handler.find(sock)
+
+        # When connection is closed by remote host, socket is ready to read and #recv returns an empty string that means EOF.
+        # If this happens we assume the data wasn't delivered and retry it.
+        if raw_data.empty?
+          node = info.node
+          @log.warn 'destination node closed the connection. regard it as unavailable.', host: node.host, port: node.port, handshake_hostname: node.handshake.hostname, hard_timeout: node.failure.hard_timeout
+          # info.node.disable!
+          return info, AckHandler::Result::FAILED
+        else
+          unpacker = ack_handler.unpacker
+          unpacker.feed(raw_data)
+          res = unpacker.read
+          node = info.node
+          chunk_id = info.chunk_id
+          @log.trace 'getting response from destination', host: node.host, port: node.port, chunk_id: Fluent::UniqueId.hex(chunk_id), response: res, handshake_hostname: node.handshake.hostname, hard_timeout: node.failure.hard_timeout
+          if res['ack'] != info.chunk_id_base64
+            # Some errors may have occurred when ack and chunk id is different, so send the chunk again.
+            @log.warn 'ack in response and chunk id in sent data are different', chunk_id: Fluent::UniqueId.hex(chunk_id), ack: res['ack']
+            return info, AckHandler::Result::CHUNKID_UNMATCHED
+          else
+            @log.trace 'got a correct ack response', chunk_id: Fluent::UniqueId.hex(chunk_id)
+          end
+
+          return info, AckHandler::Result::SUCCESS
+        end
+      rescue => e
+        @log.error 'unexpected error while receiving ack message', error: e
+        @log.error_backtrace
+        [nil, AckHandler::Result::FAILED]
+      ensure
+        ack_handler.delete(info)
+      end
+
       private
 
       def connect_keepalive(host:, port:, hostname:, ack: nil)
