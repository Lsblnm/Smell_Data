+    pthread_once(&jvp_dec_tsd_state.once, jv_tsd_dec_ctx_init);
+    decContext *ctx = tsd_dec_ctx_get(&jvp_dec_keys_state.key);
+    if (la->refcnt.count > 0 && lb->refcnt.count > 0) {
+      decNumber *na = &la->num_decimal;
+      decNumber *nb = &lb->num_decimal;
+      int32_t saved_digits = ctx->digits;
