+        range: std::ops::Range<usize>,
+        is_context: bool,
+    ) -> io::Result<()> {
+        // Contextual lines are only eligible for replacement when invert
+        // match is enabled, because the searcher reports original matches as
+        // context in that mode.
+        if is_context && !searcher.invert_match() {
+            replacer.clear();
+            return Ok(());
+        }
+
+        let replacement = match self.config.replacement.as_ref() {
+            Some(r) => r.as_slice(),
+            None => {
+                replacer.clear();
+                return Ok(());
+            }
+        };
