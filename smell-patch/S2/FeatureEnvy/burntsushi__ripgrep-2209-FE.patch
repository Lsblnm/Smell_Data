+    /// since those lines correspond to original matches. This can fail if the
+    /// underlying matcher reports an error.
+    fn replace_all<M: Matcher>(
+        &self,
+        replacer: &mut Replacer<M>,
+        searcher: &Searcher,
+        matcher: &M,
