+        if is_multi_line {
+            if let Some(line_term) = matcher.line_terminator() {
+                if line_term == searcher.line_terminator() {
+                    is_multi_line = false;
+                }
+            }
+        }
+        if is_multi_line {
+            if let Some(non_matching) = matcher.non_matching_bytes() {
+                if non_matching.contains(
+                    searcher.line_terminator().as_byte(),
+                ) {
+                    is_multi_line = false;
+                }
+            }
+        }
+        if is_multi_line {
+            if subject[range.end..].len() >= crate::MAX_LOOK_AHEAD {
+                subject = &subject[..range.end + crate::MAX_LOOK_AHEAD];
