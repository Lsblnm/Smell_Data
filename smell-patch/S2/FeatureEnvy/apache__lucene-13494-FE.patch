 /** Keeps highest results, first by largest int value, then tie-break by smallest ord. */
 public class TopOrdAndIntQueue extends TopOrdAndNumberQueue {
 
@@ -54,4 +58,77 @@ public class TopOrdAndIntQueue extends TopOrdAndNumberQueue {
   public OrdAndValue newOrdAndValue() {
     return new OrdAndInt();
   }
+
+  FacetResult getTopChildren(StringValueFacetCounts counts, int topN, String dim, String... path)
+      throws IOException {
+    if (dim.equals(counts.state.field) == false) {
+      throw new IllegalArgumentException(
+          "invalid dim \"" + dim + "\"; should be \"" + counts.state.field + "\"");
+    }
+    if (path.length != 0) {
+      throw new IllegalArgumentException("path.length should be 0");
+    }
+
+    OrdAndInt reuse = null;
+    int bottomCount = 0;
+    int bottomOrd = Integer.MAX_VALUE;
+    int childCount = 0; // total number of labels with non-zero count
+
+    if (counts.sparseCounts != null) {
+      final int[] keys = counts.sparseCounts.keys;
+      final int[] values = counts.sparseCounts.values;
+      for (int slot = 0; slot < keys.length; slot++) {
+        int count = values[slot];
+        if (count != 0) {
+          childCount++;
+          int ord = keys[slot];
+          if (count > bottomCount || (count == bottomCount && ord < bottomOrd)) {
+            if (reuse == null) {
+              reuse = (OrdAndInt) newOrdAndValue();
+            }
+            reuse.ord = ord;
+            reuse.value = count;
+            reuse = (OrdAndInt) insertWithOverflow(reuse);
+            if (size() == topN) {
+              bottomCount = ((OrdAndInt) top()).value;
+              bottomOrd = top().ord;
+            }
+          }
+        }
+      }
+    } else {
+      for (int i = 0; i < counts.denseCounts.length; i++) {
+        int count = counts.denseCounts[i];
+        if (count != 0) {
+          childCount++;
+          if (count > bottomCount || (count == bottomCount && i < bottomOrd)) {
+            if (reuse == null) {
+              reuse = (OrdAndInt) newOrdAndValue();
+            }
+            reuse.ord = i;
+            reuse.value = count;
+            reuse = (OrdAndInt) insertWithOverflow(reuse);
+            if (size() == topN) {
+              bottomCount = ((OrdAndInt) top()).value;
+              bottomOrd = top().ord;
+            }
+          }
+        }
+      }
+    }
+
+    int resultCount = size();
+    LabelAndValue[] labelValues = new LabelAndValue[resultCount];
+    for (int i = labelValues.length - 1; i >= 0; i--) {
+      OrdAndInt ordAndValue = (OrdAndInt) pop();
+      final BytesRef term = counts.docValues.lookupOrd(ordAndValue.ord);
+      final char[] chars = new char[term.length];
+      final int charCount =
+          UnicodeUtil.UTF8toUTF16(term.bytes, term.offset, term.length, chars);
+      labelValues[i] = new LabelAndValue(new String(chars, 0, charCount), ordAndValue.value);
+    }
+
+    return new FacetResult(
+        counts.state.field, new String[0], counts.totalDocCount, labelValues, childCount);
+  }
 }
