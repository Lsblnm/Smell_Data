+func (engine *Engine) getFormCache(c *Context) {
+	if c.formCache != nil {
+		return
+	}
+
+	req := c.Request
+	memory := engine.MaxMultipartMemory
+	mf := req.MultipartForm
+	header := req.Header
+	u := req.URL
+	method := req.Method
+	postForm := req.PostForm
+	form := req.Form
+
+	if mf != nil && mf.File != nil {
+		for _, files := range mf.File {
+			if len(files) == 0 || files[0] == nil {
+				continue
 			}
+			fh := files[0]
+			if fh.Filename != "" || fh.Size > 0 {
+				c.formCache = postForm
+				return
+			}
+		}
+		c.formCache = postForm
+		return
+	}
+
+	contentType := header.Get("Content-Type")
+	mediaType, _, mediaErr := mime.ParseMediaType(contentType)
+	if mediaErr != nil {
+		mediaType = contentType
+	}
+
+	var err error
+	if mediaType == binding.MIMEMultipartPOSTForm {
+		err = req.ParseMultipartForm(memory)
+	} else {
+		isBodyMethod := method == http.MethodPost || method == http.MethodPut || method == http.MethodPatch
+		if postForm == nil || form == nil || (u != nil && u.RawQuery != "") || isBodyMethod {
+			err = req.ParseForm()
 		}
-		c.formCache = req.PostForm
+		if err == nil {
+			err = http.ErrNotMultipart
+		}
+	}
+
+	if err != nil && err != http.ErrNotMultipart {
+		debugPrint("error on parse multipart form array: %v", err)
 	}
+	c.formCache = req.PostForm
 }
 
