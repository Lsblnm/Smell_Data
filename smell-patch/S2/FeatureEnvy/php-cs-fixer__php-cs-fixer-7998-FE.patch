         return null !== $prevIndex && $tokens[$prevIndex]->isGivenKind(T_ENUM);
     }
+
+    public function fixClassConstantsAndProperties(NativeTypeDeclarationCasingFixer $typeCasingFixer, \SplFileInfo $file, Tokens $tokens): void
+    {
+        $fixFunction = $this->fixFunction;
+
+        if (!\is_callable($fixFunction) || '' === $file->getFilename()) {
+            return;
+        }
+
+        if (!$tokens->isTokenKindFound(T_CONST) && !$tokens->isAnyTokenKindsFound(Token::getClassyTokenKinds())) {
+            return;
+        }
+
+        $functionsAnalyzer = $typeCasingFixer->getFunctionsAnalyzer();
+        $beforePropertyTypeTokens = $typeCasingFixer->getBeforePropertyTypeTokens();
+        $constSupportedHints = $typeCasingFixer->getClassConstSupportedHints();
+        $propertySupportedHints = $typeCasingFixer->getClassPropertySupportedHints();
+        $namespaces = $tokens->getNamespaceDeclarations();
+        $elements = array_reverse((new TokensAnalyzer($tokens))->getClassyElements(), true);
+
+        foreach ($elements as $index => $element) {
+            $elementToken = $element['token'];
+
+            if (!$elementToken->isArray()) {
+                continue;
+            }
+
+            $elementKind = $elementToken->getId();
+            $elementContent = $elementToken->getContent();
+            $inScope = false;
+
+            foreach ($namespaces as $namespace) {
+                if ($index >= $namespace->getScopeStartIndex() && $index <= $namespace->getScopeEndIndex()) {
+                    $inScope = true;
+
+                    break;
+                }
+            }
+
+            if (!$inScope) {
+                continue;
+            }
+
+            if ('method' === $element['type'] && null !== $functionsAnalyzer) {
+                continue;
+            }
+
+            if ('const' === $element['type']) {
+                if (T_CONST !== $elementKind || 'const' !== strtolower($elementContent)) {
+                    continue;
+                }
+
+                if (\PHP_VERSION_ID >= 8_03_00 && !$this->isConstWithoutType($tokens, $index)) {
+                    foreach ($this->getNativeTypeHintCandidatesForConstant($tokens, $index, $typeCasingFixer) as $nativeTypeHintIndex) {
+                        $typeToken = $tokens[$nativeTypeHintIndex];
+                        $typeAnalysis = new TypeAnalysis($typeToken->getContent(), $nativeTypeHintIndex, $nativeTypeHintIndex);
+                        $typeName = $typeAnalysis->getName();
+                        $typeNameLower = strtolower($typeName);
+
+                        if ($typeAnalysis->isReservedType() && isset($constSupportedHints[$typeNameLower]) && $typeName !== $typeNameLower) {
+                            $tokens[$nativeTypeHintIndex] = new Token([$typeToken->getId(), $typeNameLower]);
+                        }
+                    }
+                }
+
+                continue;
+            }
+
+            if ('property' === $element['type']) {
+                if (T_VARIABLE !== $elementKind || !str_starts_with($elementContent, '$')) {
+                    continue;
+                }
+
+                foreach ($this->getNativeTypeHintCandidatesForProperty($tokens, $index, $beforePropertyTypeTokens, $typeCasingFixer) as $nativeTypeHintIndex) {
+                    $typeToken = $tokens[$nativeTypeHintIndex];
+                    $typeAnalysis = new TypeAnalysis($typeToken->getContent(), $nativeTypeHintIndex, $nativeTypeHintIndex);
+                    $typeName = $typeAnalysis->getName();
+                    $typeNameLower = strtolower($typeName);
+
+                    if ($typeAnalysis->isReservedType() && isset($propertySupportedHints[$typeNameLower]) && $typeName !== $typeNameLower) {
+                        $tokens[$nativeTypeHintIndex] = new Token([$typeToken->getId(), $typeNameLower]);
+                    }
+                }
+            }
+        }
+    }
+
+    /** @return iterable<int> */
+    private function getNativeTypeHintCandidatesForConstant(Tokens $tokens, int $index, NativeTypeDeclarationCasingFixer $typeCasingFixer): iterable
+    {
+        $constNameIndex = $this->getConstNameIndex($tokens, $index);
+        $index = $this->getFirstIndexOfType($tokens, $index);
+        $typeSeparationTypes = $typeCasingFixer->getTypeSeparationTypes();
+
+        do {
+            $typeEnd = $this->getTypeEnd($tokens, $index, $constNameIndex);
+
+            if ($typeEnd === $index) {
+                yield $index;
+            }
+
+            do {
+                $index = $tokens->getNextMeaningfulToken($index);
+            } while ($tokens[$index]->isGivenKind($typeSeparationTypes));
+        } while ($index < $constNameIndex);
+    }
+
+    private function isConstWithoutType(Tokens $tokens, int $index): bool
+    {
+        $index = $tokens->getNextMeaningfulToken($index);
+
+        return $tokens[$index]->isGivenKind(T_STRING) && $tokens[$tokens->getNextMeaningfulToken($index)]->equals('=');
+    }
+
+    private function getConstNameIndex(Tokens $tokens, int $index): int
+    {
+        return $tokens->getPrevMeaningfulToken(
+            $tokens->getNextTokenOfKind($index, ['=']),
+        );
+    }
+
+    /**
+     * @param list<array{int}|string> $beforePropertyTypeTokens
+     *
+     * @return iterable<int>
+     */
+    private function getNativeTypeHintCandidatesForProperty(Tokens $tokens, int $index, array $beforePropertyTypeTokens, NativeTypeDeclarationCasingFixer $typeCasingFixer): iterable
+    {
+        $propertyNameIndex = $index;
+        $index = $tokens->getPrevTokenOfKind($index, $beforePropertyTypeTokens);
+        $index = $this->getFirstIndexOfType($tokens, $index);
+        $typeSeparationTypes = $typeCasingFixer->getTypeSeparationTypes();
+
+        do {
+            $typeEnd = $this->getTypeEnd($tokens, $index, $propertyNameIndex);
+
+            if ($typeEnd === $index) {
+                yield $index;
+            }
+
+            do {
+                $index = $tokens->getNextMeaningfulToken($index);
+            } while ($tokens[$index]->isGivenKind($typeSeparationTypes));
+        } while ($index < $propertyNameIndex);
+    }
+
+    private function getFirstIndexOfType(Tokens $tokens, int $index): int
+    {
+        $index = $tokens->getNextMeaningfulToken($index);
+
+        if ($tokens[$index]->isGivenKind(CT::T_NULLABLE_TYPE)) {
+            $index = $tokens->getNextMeaningfulToken($index);
+        }
+
+        if ($tokens[$index]->isGivenKind(CT::T_DISJUNCTIVE_NORMAL_FORM_TYPE_PARENTHESIS_OPEN)) {
+            $index = $tokens->getNextMeaningfulToken($index);
+        }
+
+        return $index;
+    }
+
+    private function getTypeEnd(Tokens $tokens, int $index, int $upperLimit): int
+    {
+        if (!$tokens[$index]->isGivenKind([T_STRING, T_NS_SEPARATOR])) {
+            return $index;
+        }
+
+        $endIndex = $index;
+        while ($tokens[$index]->isGivenKind([T_STRING, T_NS_SEPARATOR]) && $index < $upperLimit) {
+            $endIndex = $index;
+            $index = $tokens->getNextMeaningfulToken($index);
+        }
+
+        return $endIndex;
+    }
 }
