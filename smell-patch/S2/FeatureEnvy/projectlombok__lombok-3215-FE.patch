 import lombok.core.handlers.HandlerUtil;
@@ -1020,4 +1021,48 @@ public class HandleBuilder extends JavacAnnotationHandler<Builder> {
 		
 		return null;
 	}
+
+	static java.util.HashSet<String> gatherUsedTypeNames(List<JCTypeParameter> typeParams, JCClassDecl td, BuilderJob job) {
+		java.util.HashSet<String> usedNames = new java.util.HashSet<String>();
+		usedNames.add(CLEAN_FIELD_NAME);
+
+		List<JCTypeParameter> params = typeParams;
+		if (params == null && job != null) params = job.typeParams;
+		if (params == null && td != null) params = td.typarams;
+		if (params != null) {
+			for (JCTypeParameter typeParam : params) {
+				if (typeParam.getName() != null) usedNames.add(typeParam.getName().toString());
+			}
+		}
+
+		if (td == null) return usedNames;
+		if (td.name == null && td.mods == null) return usedNames;
+
+		String className = td.name.toString();
+		JavacNode typeNode = job == null ? null : job.parentType;
+		if (typeNode != null && typeNode.getAst() != null) {
+			ImportList importList = typeNode.getImportList();
+			if (importList != null) {
+				String importedName = importList.getFullyQualifiedNameForSimpleName(className);
+				if (importedName != null) usedNames.add(importedName);
+			}
+		}
+		usedNames.add(className);
+
+		if (td.getMembers() != null) {
+			for (JCTree member : td.getMembers()) {
+				if (member.getKind() == com.sun.source.tree.Tree.Kind.VARIABLE && member instanceof JCVariableDecl) {
+					JCVariableDecl field = (JCVariableDecl) member;
+					if (field.name == null && field.mods == null) continue;
+					JCTree type = field.getType();
+					if (type instanceof JCIdent) {
+						Name identName = ((JCIdent) type).getName();
+						if (identName != null) usedNames.add(identName.toString());
+					}
+				}
+			}
+		}
+
+		return usedNames;
+	}
 }
