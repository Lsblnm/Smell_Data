+        (pluginPath?.length ?? 0) +
+        (name?.length ?? 0) +
+        (mainDocId?.length ?? 0) +
+        draftIds.length;
+      if (mainDocId && draftIds.includes(mainDocId)) {
+        weight += 1;
+      }
+      if (version.getIsLast()) {
+        weight += 1;
+      }
+
+      version.getDocuments().forEach((doc) => {
+        weight +=
+          (doc.getId()?.length ?? 0) +
+          (doc.getPath()?.length ?? 0) +
