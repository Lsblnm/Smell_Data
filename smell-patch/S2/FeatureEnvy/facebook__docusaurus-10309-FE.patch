+  matchActiveVersion(plugin: DocsPluginSnapshot): GlobalVersion | undefined {
+    const versions = plugin.getVersionSnapshots();
+    const lastVersion = versions.find((version) => version.getIsLast());
+    // Last version is a route like /docs/*,
+    // we need to match it last or it would match /docs/version-1.0/* as well
+    const orderedVersions = [
+      ...versions.filter((version) => version !== lastVersion),
+      lastVersion,
