 template <typename UInt> struct write_int_arg {
   UInt abs_value;
   unsigned prefix;
+
+  // Writes a decimal integer with digit grouping.
+  template <typename OutputIt, typename Char>
+  auto write_int(OutputIt out, unsigned prefix,
+                 const format_specs<Char>& specs,
+                 const digit_grouping<Char>& grouping) const -> OutputIt {
+    auto value = static_cast<uint64_or_128_t<UInt>>(abs_value);
+    int num_digits = count_digits(value);
+    auto buffer = memory_buffer();
+    if (buffer.capacity() < static_cast<size_t>(num_digits))
+      buffer.try_reserve(static_cast<size_t>(num_digits));
+    format_decimal<char>(appender(buffer), value, num_digits);
+    auto digits = string_view(buffer.data(), buffer.size());
+
+    int separator_count = 0;
+    if (!grouping.separator().empty()) {
+      const auto& groups = grouping.grouping();
+      int pos = 0;
+      auto group = groups.begin();
+      while (true) {
+        if (group == groups.end()) {
+          if (groups.empty()) break;
+          pos += groups.back();
+        } else if (*group <= 0 || *group == max_value<char>()) {
+          break;
+        } else {
+          pos += *group++;
+        }
+        if (num_digits <= pos) break;
+        ++separator_count;
+      }
+    }
+
+    unsigned size =
+        to_unsigned((prefix != 0 ? 1 : 0) + static_cast<int>(digits.size()) +
+                    separator_count);
+    unsigned spec_width = to_unsigned(specs.width);
+    size_t padding = spec_width > size ? spec_width - size : 0;
+    auto* shifts = "\x00\x1f\x00\x01";
+    size_t left_padding = padding >> shifts[specs.align];
+    size_t right_padding = padding - left_padding;
+    auto fill_size = specs.fill.size();
+    auto fill_data = specs.fill.data();
+    auto it = reserve(out, size + padding * fill_size);
+    auto apply_fill = [&](size_t count) {
+      if (count == 0) return;
+      if (fill_size == 1) {
+        it = detail::fill_n(it, count, fill_data[0]);
+      } else {
+        for (size_t i = 0; i < count; ++i)
+          it = copy_str<Char>(fill_data, fill_data + fill_size, it);
+      }
+    };
+    apply_fill(left_padding);
+    if (prefix != 0) {
+      char sign = static_cast<char>(prefix);
+      *it++ = static_cast<Char>(sign);
+    }
+    it = grouping.apply(
+        it, basic_string_view<char>(digits.data(), digits.size()));
+    apply_fill(right_padding);
+    return base_iterator(out, it);
+  }
 };
 
