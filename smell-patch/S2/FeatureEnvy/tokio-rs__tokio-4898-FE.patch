+impl IoDriver {
+    pub(crate) fn new_with_interest_and_handle<E: mio::event::Source>(
+        &self,
+        mut io: E,
+        interest: Interest,
+    ) -> io::Result<PollEvented<E>> {
+        use crate::io::driver::{Handle as IoHandle, Registration};
+
+        let inner = &self.inner;
+
+        let (address, shared) = {
+            let io_dispatch = inner.io_dispatch.read().unwrap();
+            if io_dispatch.is_shutdown {
+                return Err(io::Error::new(
+                    io::ErrorKind::Other,
+                    "failed to find event loop",
+                ));
+            }
+            match io_dispatch.allocator.allocate() {
+                Some(allocated) => allocated,
+                None => {
+                    return Err(io::Error::new(
+                        io::ErrorKind::Other,
+                        "reactor at max registered I/O resources",
+                    ));
+                }
+            }
+        };
+
+        {
+            let mut waiters = shared.waiters.lock();
+            waiters.reader.take();
+            waiters.writer.take();
+        }
+
+        let token = crate::io::driver::GENERATION.pack(
+            shared.generation(),
+            crate::io::driver::ADDRESS.pack(address.as_usize(), 0),
+        );
+
+        inner
+            .registry
+            .register(&mut io, mio::Token(token), interest.to_mio())?;
+
+        inner.metrics.incr_fd_count();
+
+        let registration = Registration {
+            handle: IoHandle {
+                inner: Arc::clone(inner),
+            },
+            shared,
+        };
+
+        Ok(PollEvented {
+            io: Some(io),
+            registration,
+        })
+    }
+}
