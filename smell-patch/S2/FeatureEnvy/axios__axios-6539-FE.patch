diff --git a/lib/helpers/isAbsoluteURL.js b/lib/helpers/isAbsoluteURL.js
index 4747a45..51e9373 100644
--- a/lib/helpers/isAbsoluteURL.js
+++ b/lib/helpers/isAbsoluteURL.js
@@ -1,5 +1,9 @@
 'use strict';
 
+import combineURLs from './combineURLs.js';
+import buildURL from './buildURL.js';
+import { ResolvedURL } from './parseProtocol.js';
+
 /**
  * Determines whether the specified URL is absolute
  *
@@ -13,3 +17,59 @@ export default function isAbsoluteURL(url) {
   // by any combination of letters, digits, plus, period, or hyphen.
   return /^([a-z][a-z\d+\-.]*:)?\/\//i.test(url);
 }
+
+class AbsoluteURLChecker {
+  constructor() {
+    this.fallbackOrigin = 'http://localhost';
+  }
+
+  resolveRequestTarget(requestPath, requestQuery, requestSpec, runtime) {
+    const requestedURL = requestPath.requestedURL;
+    const baseURL = requestPath.baseURL;
+    const fullPath = (baseURL && !isAbsoluteURL(requestedURL))
+      ? combineURLs(baseURL, requestedURL)
+      : requestedURL;
+
+    const parsed = new ResolvedURL(fullPath, this.fallbackOrigin);
+    const protocol = parsed.protocol || (runtime.protocols[0] + ':');
+
+    let auth = requestSpec.basicAuth;
+    if (!auth && parsed.userinfo) {
+      auth = parsed.userinfo;
+    }
+
+    let path;
+    try {
+      path = buildURL(
+        parsed.pathAndQuery,
+        requestQuery.params,
+        requestQuery.paramsSerializer
+      ).replace(/^\?/, '');
+    } catch (err) {
+      const pathError = new Error(err.message);
+      pathError.exists = true;
+      throw pathError;
+    }
+
+    const target = {
+      protocol,
+      auth,
+      path
+    };
+
+    if (requestSpec.socketPath) {
+      target.socketPath = requestSpec.socketPath;
+    } else {
+      target.hostname = parsed.hostname;
+      target.port = parsed.port;
+      target.proxy = requestSpec.proxy;
+      target.proxyLocation = protocol + '//' + parsed.hostname + (parsed.port ? ':' + parsed.port : '') + path;
+    }
+
+    return target;
+  }
+}
+
+const absoluteURLChecker = new AbsoluteURLChecker();
+
+export { absoluteURLChecker };
diff --git a/lib/helpers/parseProtocol.js b/lib/helpers/parseProtocol.js
index 586ec96..ec6370a 100644
--- a/lib/helpers/parseProtocol.js
+++ b/lib/helpers/parseProtocol.js
@@ -1,5 +1,16 @@
 'use strict';
 
+export class ResolvedURL {
+  constructor(url, base) {
+    const parsed = new URL(url, base);
+    this.protocol = parsed.protocol;
+    this.userinfo = parsed.username ? (parsed.username + ':' + parsed.password) : '';
+    this.pathAndQuery = parsed.pathname + parsed.search;
+    this.hostname = parsed.hostname;
+    this.port = parsed.port;
+  }
+}
+
 export default function parseProtocol(url) {
   const match = /^([-+\w]{1,25})(:?\/\/|:)/.exec(url);
   return match && match[1] || '';
