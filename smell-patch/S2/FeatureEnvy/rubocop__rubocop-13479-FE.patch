+        def comments_before_code
+          source = processed_source
+          comments = source.comments
+          ast = source.ast
+          tokens = source.tokens
+          buffer = source.buffer
+
+          return comments unless ast
+
+          comment_config = source.comment_config
+          buffer_source = buffer.source
+          first_code_token = tokens.find { |candidate| candidate.type != :tCOMMENT }
+          return comments unless first_code_token
+
+          first_code_line = first_code_token.pos.line
+
+          comments.take_while do |comment|
+            loc = comment.loc
+            text = comment.text
+            expr = loc.expression
+            begin_pos = expr.begin_pos
+            source_slice = buffer_source[begin_pos, text.length]
+            token = tokens.find { |candidate| candidate.pos.begin_pos == begin_pos }
+            comment_matches_source = source_slice.nil? || source_slice == text
+            comment_line = if token && token.type == :tCOMMENT && comment_matches_source
+                             token.pos.line
+                           else
+                             loc.line
+                           end
+
+            comment_line < first_code_line && comment_config.comment_only_line?(comment_line)
+          end
+        end
