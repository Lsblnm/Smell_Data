@@ -72,6 +72,45 @@ module Jekyll
         .gsub(%r!\s+!, "_")
     end
 
+    # Load data files for the current site and overlay theme data when available.
+    #
+    # Returns the merged data when a theme data path is present, otherwise nil.
+    def read_site_data
+      filter = @entry_filter
+      host = filter.site
+      configured_data_dir = host.config["data_dir"]
+      filter_base = filter.base_directory
+      data_dir = if filter_base.empty?
+                   configured_data_dir
+                 else
+                   File.join(filter_base, configured_data_dir)
+                 end
+      host.data = read(data_dir)
+
+      theme = host.theme
+      return unless theme && theme.data_path
+
+      theme_root = theme.root
+      theme_data_path = theme.data_path
+      return unless theme_data_path.start_with?(theme_root)
+      return if theme_data_path == host.regenerator.metadata_file
+
+      layout_reader = LayoutReader.new(host)
+      return if theme_data_path == layout_reader.layout_directory
+      return if host.layouts.values.any? { |layout| layout.path == theme_data_path }
+
+      Jekyll.logger.debug "Theme data:", theme.name
+
+      theme_data = DataReader.new(
+        host,
+        :in_source_dir => host.method(:in_theme_dir)
+      ).read(theme_data_path)
+
+      if Utils.mergable?(theme_data) && Utils.mergable?(host.data)
+        host.data = Utils.deep_merge_hashes(theme_data, host.data)
+      end
+    end
+
     private
 
     # @return [Hash]
