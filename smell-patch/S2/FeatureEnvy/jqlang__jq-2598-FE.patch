diff --git a/src/parser.c b/src/parser.c
index 28d47c5..f18f8ac 100644
--- a/src/parser.c
+++ b/src/parser.c
@@ -4372,9 +4372,57 @@ yyreturnlab:
 #line 1009 "src/parser.y"
 
 
+struct parser_context {
+  struct locfile *source;
+};
+
+static struct parser_context parser_ctx;
+
+block gen_cond(block cond, block iftrue, block iffalse) {
+  inst *anchor = 0;
+  block clauses[3];
+  clauses[0] = cond;
+  clauses[1] = iftrue;
+  clauses[2] = iffalse;
+
+  for (int n = 0; n < 3; n++) {
+    for (inst *cursor = clauses[n].first; cursor; cursor = cursor->next) {
+      const struct opcode_description *desc = opcode_describe(cursor->op);
+      int noteworthy = cursor->symbol || cursor->bound_by;
+      if ((desc->flags & OP_HAS_CONSTANT) &&
+          jv_get_kind(cursor->imm.constant) != JV_KIND_INVALID)
+        noteworthy = 1;
+      if ((noteworthy || cursor->locfile) &&
+          cursor->source.start >= 0 &&
+          cursor->source.end >= cursor->source.start &&
+          (parser_ctx.source == 0 || cursor->source.end <= parser_ctx.source->length))
+        anchor = cursor;
+    }
+  }
+
+  block compiled = BLOCK(gen_op_simple(DUP),
+                         BLOCK(gen_subexp(cond), gen_op_simple(POP)),
+                         gen_condbranch(BLOCK(gen_op_simple(POP), iftrue),
+                                        BLOCK(gen_op_simple(POP), iffalse)));
+  if (anchor && anchor->locfile) {
+    location src = anchor->source;
+    for (inst *i = compiled.first; i; i = i->next) {
+      if (i->source.start == UNKNOWN_LOCATION.start &&
+          i->source.end == UNKNOWN_LOCATION.end) {
+        i->source.start = src.start;
+        i->source.end = src.end;
+        i->locfile = locfile_retain(anchor->locfile);
+      }
+    }
+  }
+  return compiled;
+}
+
 int jq_parse(struct locfile* locations, block* answer) {
   struct lexer_param scanner;
+  struct locfile *previous_source = parser_ctx.source;
   YY_BUFFER_STATE buf;
+  parser_ctx.source = locations;
   jq_yylex_init_extra(0, &scanner.lexer);
   buf = jq_yy_scan_bytes(locations->data, locations->length, scanner.lexer);
   int errors = 0;
@@ -4386,6 +4434,7 @@ int jq_parse(struct locfile* locations, block* answer) {
     block_free(*answer);
     *answer = gen_noop();
   }
+  parser_ctx.source = previous_source;
   return errors;
 }
 
