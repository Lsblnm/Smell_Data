 namespace Illuminate\Container;
 
+use Closure;
+use Illuminate\Container\Attributes\Config;
+use Illuminate\Contracts\Container\BindingResolutionException;
 use Illuminate\Contracts\Container\Container;
 use Illuminate\Contracts\Container\ContextualBindingBuilder as ContextualBindingBuilderContract;
+use Illuminate\Support\Arr;
+use ReflectionParameter;
 
 class ContextualBindingBuilder implements ContextualBindingBuilderContract
 {
@@ -93,4 +98,80 @@ public function giveConfig($key, $default = null)
     {
         $this->give(fn ($container) => $container->get('config')->get($key, $default));
     }
+
+    /**
+     * Resolve a non-class hinted primitive dependency.
+     *
+     * @param  \ReflectionParameter  $parameter
+     * @return mixed
+     *
+     * @throws \Illuminate\Contracts\Container\BindingResolutionException
+     */
+    public function resolvePrimitive(ReflectionParameter $parameter)
+    {
+        $container = $this->container;
+        $parameterName = $parameter->name;
+        $abstract = '$'.$parameterName;
+        $buildStack = [];
+        $abstractAliases = [];
+        $contextual = [];
+        $configKey = null;
+
+        if ($container instanceof \Illuminate\Container\Container) {
+            [$buildStack, $abstractAliases] = Closure::bind(function () {
+                return [$this->buildStack, $this->abstractAliases];
+            }, $container, \Illuminate\Container\Container::class)();
+
+            $contextual = $container->contextual;
+        }
+
+        foreach ($parameter->getAttributes(Config::class) as $attribute) {
+            if ($attribute->getName() === Config::class) {
+                $configKey = $attribute->newInstance()->key;
+
+                break;
+            }
+        }
+
+        $current = end($buildStack);
+        $contextBindings = $contextual[$current] ?? [];
+        $concrete = Arr::get($contextBindings, $abstract);
+        $aliases = $abstractAliases[$abstract] ?? [];
+
+        if (is_string($configKey) && $configKey !== '') {
+            $aliases = array_values(array_unique(array_merge(
+                array_filter($aliases, fn ($alias) => $alias === $configKey || $alias === '$'.$configKey),
+                $aliases
+            )));
+        }
+
+        if (is_null($concrete)) {
+            foreach ($aliases as $alias) {
+                $concrete = Arr::get($contextBindings, $alias);
+
+                if (! is_null($concrete)) {
+                    break;
+                }
+            }
+        }
+
+        if (! is_null($concrete)) {
+            return $concrete instanceof Closure ? $concrete($container) : $concrete;
+        }
+
+        if ($parameter->isDefaultValueAvailable()) {
+            return $parameter->getDefaultValue();
+        }
+
+        $declaringFunction = $parameter->getDeclaringFunction();
+
+        if ($parameter->isVariadic() && $declaringFunction->getNumberOfParameters() > 0) {
+            return [];
+        }
+
+        $className = $parameter->getDeclaringClass()->getName();
+        $message = "Unresolvable dependency resolving [$parameter] in class {$className}";
+
+        throw new BindingResolutionException($message);
+    }
 }
