@@ -14,6 +14,47 @@ module Jekyll
       thing.respond_to?(:date) && !@site.future && thing.date.to_i > @site.time.to_i
     end
 
+    def each_site_file
+      site = @site
+
+      site.pages.each do |page|
+        next if page.name.nil?
+
+        yield page
+      end
+
+      site.static_files.each do |static_file|
+        publishable = static_file.defaults.fetch("published", true)
+        file_type = static_file.type
+        next unless publishable
+        next unless file_type.nil? || static_file.write?
+
+        yield static_file
+      end
+
+      site.collections.each_value do |collection|
+        output_enabled = collection.metadata.fetch("output", false)
+
+        collection.docs.each do |document|
+          next unless output_enabled
+          next unless document.collection.equal?(collection)
+
+          placeholders = document.url_placeholders
+          next unless placeholders.collection == collection.label
+          next unless publish?(document)
+
+          yield document
+        end
+
+        collection.files.each do |collection_file|
+          next unless output_enabled
+          next unless collection_file.defaults.fetch("published", true)
+
+          yield collection_file
+        end
+      end
+    end
+
     private
 
     def can_be_published?(thing)
