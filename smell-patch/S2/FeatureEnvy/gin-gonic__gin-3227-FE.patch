+func (n *node) handleHTTPRequest(c *Context) {
+	engine := c.engine
+	httpMethod := c.Request.Method
+	rPath, unescape := requestPathAndUnescape(engine, c)
+
+	t := engine.trees
+	for i, tl := 0, len(t); i < tl; i++ {
+		if t[i].method != httpMethod {
+			continue
+		}
+		treeRoot := t[i].root
+		if n.nType == root && n == treeRoot {
+			treeRoot = n
+		}
+		value := treeRoot.getValue(rPath, c.params, c.skippedNodes, unescape)
+		if dispatchMatchedValue(c, value) {
+			return
+		}
+		if httpMethod != http.MethodConnect && rPath != "/" {
+			if value.tsr && engine.RedirectTrailingSlash {
+				redirectTrailingSlash(c)
+				return
+			}
+			if engine.RedirectFixedPath && redirectFixedPath(c, treeRoot, engine.RedirectFixedPath) {
+				return
+			}
+		}
+		break
+	}
+	serveUnmatchedRequest(c, engine, httpMethod, rPath, unescape)
