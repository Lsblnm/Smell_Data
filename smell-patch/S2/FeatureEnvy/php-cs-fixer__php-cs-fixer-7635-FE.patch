@@ -154,6 +154,82 @@ public function getFunctionArguments(Tokens $tokens, int $functionIndex): array
         return $arguments;
     }
 
+    /**
+     * @param array<string, string> $uses
+     */
+    public function replaceByShortType(
+        Tokens $tokens,
+        TypeAnalysis $type,
+        array $uses,
+        string $namespaceName,
+        bool $importSymbols,
+        callable $registerSymbolForImport,
+        callable $determineShortType
+    ): void {
+        $codeHash = $tokens->getCodeHash();
+        if ($codeHash !== $this->functionsAnalysis['tokens']) {
+            $this->functionsAnalysis = [
+                'tokens' => '',
+                'imports' => [],
+                'declarations' => [],
+            ];
+        }
+
+        $typeStartIndex = $type->getStartIndex();
+        $typeEndIndex = $type->getEndIndex();
+
+        foreach ($tokens->getNamespaceDeclarations() as $namespace) {
+            if (
+                $typeStartIndex < $namespace->getScopeStartIndex()
+                || $typeStartIndex > $namespace->getScopeEndIndex()
+            ) {
+                continue;
+            }
+
+            $resolvedNamespaceName = strtolower($namespace->getFullName());
+            if ('' === $namespaceName || $namespaceName === $resolvedNamespaceName) {
+                $namespaceName = $resolvedNamespaceName;
+            }
+
+            $namespaceUsesAnalyzer = new NamespaceUsesAnalyzer();
+            foreach ($namespaceUsesAnalyzer->getDeclarationsInNamespace($tokens, $namespace) as $use) {
+                $importedShortName = $use->getShortName();
+                if (NamespaceUseAnalysis::TYPE_CLASS !== $use->getType()) {
+                    continue;
+                }
+
+                $normalised = strtolower(ltrim($use->getFullName(), '\\'));
+                if (!isset($uses[$normalised])) {
+                    $uses[$normalised] = $importedShortName;
+                }
+            }
+
+            break;
+        }
+
+        if ($type->isNullable() && $tokens[$typeStartIndex]->isGivenKind(CT::T_NULLABLE_TYPE)) {
+            $typeStartIndex = $tokens->getNextMeaningfulToken($typeStartIndex);
+        }
+
+        $types = $this->getTypes($tokens, $typeStartIndex, $typeEndIndex);
+
+        foreach ($types as $typeName => [$startIndex, $endIndex]) {
+            if ((new TypeAnalysis($typeName))->isReservedType()) {
+                return;
+            }
+
+            if ($importSymbols) {
+                $registerSymbolForImport('class', $typeName, $uses, $namespaceName);
+            }
+
+            $shortType = $determineShortType($typeName, $uses, $namespaceName);
+
+            if (null !== $shortType) {
+                $tokens->overrideRange($startIndex, $endIndex, $shortType);
+            }
+        }
+    }
+
     public function getFunctionReturnType(Tokens $tokens, int $methodIndex): ?TypeAnalysis
     {
         $argumentsStart = $tokens->getNextTokenOfKind($methodIndex, ['(']);
@@ -266,4 +342,62 @@ private function buildFunctionsAnalysis(Tokens $tokens): void
             }
