@@ -87,26 +87,61 @@ module RuboCop
           corrector.replace(range, correction)
         end
 
-        # rubocop:disable Metrics/AbcSize, Metrics/CyclomaticComplexity, Metrics/PerceivedComplexity
-        def ignored_literal_ranges(ast)
+        # rubocop:disable Metrics/AbcSize, Metrics/CyclomaticComplexity, Metrics/MethodLength, Metrics/PerceivedComplexity
+        def ignored_literal_ranges(ast, include_percent_arrays: true)
           # which lines start inside a string literal?
           return [] if ast.nil?
 
-          ast.each_node(:str, :dstr, :array).with_object(Set.new) do |literal, ranges|
+          source = processed_source
+          buffer = source.buffer
+          tokens = source.tokens
+          raw_source = source.raw_source
+          source_length = [buffer.source.length, raw_source.length].min
+          node_types = include_percent_arrays ? %i[str dstr array] : %i[str dstr]
+
+          ast.each_node(*node_types).with_object(Set.new) do |literal, ranges|
             loc = literal.location
+            next unless loc
+
+            parent = literal.parent
+            expression = loc.expression
+            next unless expression
+            next if expression.begin_pos.negative? || expression.end_pos > source_length
 
             if literal.array_type?
               next unless literal.percent_literal?
+              next unless tokens.empty? || tokens.any? do |token|
+                pos = token.pos
+                pos && pos.begin_pos < expression.end_pos && pos.end_pos > expression.begin_pos
+              end
 
               ranges << loc.expression
             elsif literal.heredoc?
+              body = loc.heredoc_body
+              next unless body
+              next if body.begin_pos.negative? || body.end_pos > source_length
+              next unless tokens.empty? || tokens.any? do |token|
+                pos = token.pos
+                pos && pos.begin_pos < body.end_pos && pos.end_pos > body.begin_pos
+              end
+
               ranges << loc.heredoc_body
             elsif loc.respond_to?(:begin) && loc.begin
+              parent_location = parent&.location
+              parent_expression = parent_location&.expression
+              next unless parent_expression.nil? ||
+                          (parent_expression.begin_pos <= expression.begin_pos &&
+                           parent_expression.end_pos >= expression.end_pos)
+              next unless tokens.empty? || tokens.any? do |token|
+                pos = token.pos
+                pos && pos.begin_pos < expression.end_pos && pos.end_pos > expression.begin_pos
+              end
+
               ranges << loc.expression
             end
           end
         end
-        # rubocop:enable Metrics/AbcSize, Metrics/CyclomaticComplexity, Metrics/PerceivedComplexity
+        # rubocop:enable Metrics/AbcSize, Metrics/CyclomaticComplexity, Metrics/MethodLength, Metrics/PerceivedComplexity
 
         def comment_ranges(comments)
           comments.map(&:source_range)
