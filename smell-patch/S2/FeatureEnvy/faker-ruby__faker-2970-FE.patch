+    class UsernameComposer
+      attr_reader :specifier
+
+      def username(specifier: nil, separators: %w[. _])
+        @specifier = specifier
+
+        Faker::Base.with_locale(:en) do
+          config_snapshot = Faker::Config::Snapshot.new
+          company_policy = Company::HandlePolicy.new
+
+          case @specifier
+          when ::String
+            name_source = Name::HandleSource.new
+            names = @specifier&.gsub(name_source.apostrophe, company_policy.blank)&.split
+            shuffled_names = names.shuffle(random: config_snapshot.random)
+
+            return shuffled_names.join(Faker::Base.sample(separators)).downcase
+          when Integer
+            requested = @specifier
+            # If specifier is Integer and has large value, Argument error exception is raised to overcome memory full error
+            raise ArgumentError, 'Given argument is too large' if requested > 10**6
+
+            tries = 0 # Don't try forever in case we get something like 1_000_000.
+            result = nil
+            loop do
+              result = username(specifier: nil, separators: separators)
+              tries += 1
+              break unless result.length < requested && tries < 7
+            end
+            return result * (requested / result.length + 1) if requested.positive?
+          when Range
+            requested = @specifier
+            tries = 0
+            result = nil
+            loop do
+              result = username(specifier: requested.min, separators: separators)
+              tries += 1
+              break unless !requested.include?(result.length) && tries < 7
+            end
+            return result[0...requested.max]
+          end
+
+          given_name = Name.first_name
+          alternate_given = Name.first_name
+          family_name = Name.last_name
+          name_source = Name::HandleSource.new(given_name: given_name, family_name: family_name)
+          char_map = Char::Transliterator.new
+          job_policy = Job::HandlePolicy.new
+
+          prepared = [name_source.given_name, alternate_given, name_source.family_name].map do |text|
+            uk_chars = char_map.uk_chars
+            ru_chars = char_map.ru_chars
+            mapped = if config_snapshot.locale == 'uk'
+                       text.gsub(/[а-яА-ЯіїєґІЇЄҐ]/, uk_chars)
+                     elsif config_snapshot.locale == 'ru'
+                       text.gsub(/[а-яА-Я]/, ru_chars)
+                     else
+                       text
+                     end
+
+            umlauts = char_map.umlauts
+            mapped = mapped.gsub(/[äöüß]/i) { |match| umlauts.fetch(match.downcase, match.downcase) }
+            mapped = mapped.gsub(job_policy.space, company_policy.blank)
+            mapped = mapped.gsub(job_policy.ampersand, company_policy.blank)
+            mapped.gsub(/[^\w#{Regexp.escape(company_policy.hyphen)}]/, company_policy.blank).downcase
+          end
+
+          joiner = Faker::Base.sample(separators)
+          [prepared[0], prepared[1..2].join(joiner)].sample(random: config_snapshot.random)
+        end
+      end
+    end
