+    def update_imported_git_checkout(git_import)
+      clone_folder = git_import.clone_folder
+      checkout_param = git_import.checkout_param
+      checkout_path = git_import.checkout_path
+      version = git_import.version
+      is_eligible_for_caching = git_import.eligible_for_caching
+
+      launch_context = FastlaneCore::ActionLaunchContext.context_for_action_name(
+        'import_from_git',
+        fastlane_client_language: :ruby,
+        args: ARGV
+      )
+      completion_context = FastlaneCore::ActionCompletionContext.context_for_action_name(
+        'import_from_git',
+        args: ARGV,
+        status: FastlaneCore::ActionCompletionStatus::SUCCESS
+      )
+      analytics_session = FastlaneCore.session
+      active_runner = self.runner
+
+      selected_lane = nil
+      if active_runner
+        platform_lanes = active_runner.lanes[active_runner.current_platform]
+        if platform_lanes && active_runner.current_lane
+          selected_lane = platform_lanes[active_runner.current_lane]
+        end
+      end
+
+      checkout_owner = [
+        launch_context.action_name,
+        launch_context.p_hash,
+        active_runner && active_runner.current_lane,
+        active_runner && active_runner.current_platform,
+        selected_lane && selected_lane.name,
+        completion_context.status,
+        analytics_session.session_id
+      ].map { |part| part.nil? ? '' : part.to_s }.join(':')
+
+      Helper.with_env_values('GIT_TERMINAL_PROMPT' => '0', 'FASTLANE_GIT_IMPORT_CONTEXT' => checkout_owner) do
+        if is_eligible_for_caching && version.nil?
+          # Update the repo if it's eligible for caching but the version isn't specified
+          UI.message("Fetching remote git branches and updating git repo...")
+          Helper.with_env_values('GIT_TERMINAL_PROMPT' => '0') do
+            Actions.sh("cd #{clone_folder.shellescape} && git fetch --all --quiet && git checkout #{checkout_param.shellescape} #{checkout_path} && git reset --hard && git rebase")
+          end
+        else
+          begin
+            # https://stackoverflow.com/a/1593574/865175
+            current_tag = Actions.sh("cd #{clone_folder.shellescape} && git describe --exact-match --tags HEAD").strip
+          rescue
+            current_tag = nil
+          end
+
+          if !version.nil? && current_tag != version
+            Actions.sh("cd #{clone_folder.shellescape} && git checkout #{checkout_param.shellescape} #{checkout_path}")
+          end
+        end
+      end
+    end
+
