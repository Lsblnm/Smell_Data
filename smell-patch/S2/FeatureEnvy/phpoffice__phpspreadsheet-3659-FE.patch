+    /**
+     * @return array{tableName: string, table: mixed, reference: string, headersRow: ?int, firstDataRow: int, totalsRow: ?int, lastDataRow: int, columns: array}
+     */
+    public function getTableStructure(Operands\StructuredReference $structuredReference, Worksheet $worksheet, string $cellCoordinate): array
+    {
+        $tableReferencePattern = '/([\p{L}_\\\\][\p{L}\p{N}\._]+)?(\[(?:[^\]\[]+|(?R))*+\])/miu';
+        preg_match($tableReferencePattern, $structuredReference->value(), $matches);
+
+        $tableName = $matches[1];
+        $reference = $matches[2];
+        $calculationWorkbook = $this->spreadsheet;
+        $searchWorksheet = $worksheet;
+        if ($calculationWorkbook !== null && $worksheet->getParent() === $calculationWorkbook) {
+            $searchWorksheet = $worksheet;
+        }
+
+        if ($tableName === '') {
+            $table = null;
+            foreach ($searchWorksheet->getTableCollection() as $candidateTable) {
+                $candidateRange = $candidateTable->getRange();
+                $candidateFilter = $candidateTable->getAutoFilter();
+                $candidateFilterRange = $candidateFilter->getRange();
+                if ($candidateRange === '' && $candidateFilterRange !== '') {
+                    $candidateRange = $candidateFilterRange;
+                }
+                if ($candidateRange !== '' && self::coordinateIsInsideTableRange($cellCoordinate, $candidateRange)) {
+                    $tableName = $candidateTable->getName();
+                    $table = $candidateTable;
+
+                    break;
+                }
+            }
+            if ($table === null) {
+                throw new Exception('Table for Structured Reference cannot be identified');
+            }
+        } else {
+            $table = $searchWorksheet->getTableByName($tableName);
+            if ($table === null) {
+                throw new Exception("Table {$tableName} for Structured Reference cannot be located");
+            }
+        }
+
+        $tableRangeString = $table->getRange();
+        $autoFilter = $table->getAutoFilter();
+        $autoFilterRange = $autoFilter->getRange();
+        if ($tableRangeString === '' && $autoFilterRange !== '') {
+            $tableRangeString = $autoFilterRange;
+        }
+        $tableRange = Coordinate::getRangeBoundaries($tableRangeString);
+
+        $showHeaderRow = $table->getShowHeaderRow();
+        $showTotalsRow = $table->getShowTotalsRow();
+        $headersRow = $showHeaderRow ? (int) $tableRange[0][1] : null;
+        $firstDataRow = $showHeaderRow ? (int) $tableRange[0][1] + 1 : $tableRange[0][1];
+        $totalsRow = $showTotalsRow ? (int) $tableRange[1][1] : null;
+        $lastDataRow = $showTotalsRow ? (int) $tableRange[1][1] - 1 : $tableRange[1][1];
+
+        $headerRowIndex = $headersRow ?? ($firstDataRow - 1);
+        $columnRange = $tableRange;
+        $lastColumn = ++$columnRange[1][0];
+        $filterColumns = $autoFilter->getColumns();
+        $columns = [];
+        for ($column = $columnRange[0][0]; $column !== $lastColumn; ++$column) {
+            $headerName = $searchWorksheet
+                ->getCell($column . $headerRowIndex)
+                ->getCalculatedValue();
+            $filterColumn = $filterColumns[$column] ?? null;
+            if ($filterColumn !== null) {
+                $columnId = $filterColumn->getColumnIndex();
+                foreach ($filterColumn->getRules() as $filterRule) {
+                    $ruleColumn = $filterRule->getParent();
+                    if ($ruleColumn !== null) {
+                        $columnId = $ruleColumn->getColumnIndex();
+                    }
+
+                    break;
+                }
+                $columns[$columnId] = $headerName;
+            } else {
+                $columns[$column] = $headerName;
+            }
+        }
+        $searchWorksheet->getCell($cellCoordinate);
+
+        return [
+            'tableName' => $tableName,
+            'table' => $table,
+            'reference' => $reference,
+            'headersRow' => $headersRow,
+            'firstDataRow' => $firstDataRow,
+            'totalsRow' => $totalsRow,
+            'lastDataRow' => $lastDataRow,
+            'columns' => $columns,
+        ];
+    }
+
+    private static function coordinateIsInsideTableRange(string $cellCoordinate, string $range): bool
+    {
+        [$rangeStart, $rangeEnd] = Coordinate::rangeBoundaries($range);
+        [$currentColumn, $currentRow] = Coordinate::coordinateFromString($cellCoordinate);
+        $columnIndex = Coordinate::columnIndexFromString($currentColumn);
+        $rowIndex = (int) $currentRow;
+
+        return ($rangeStart[0] <= $columnIndex) && ($rangeEnd[0] >= $columnIndex)
+            && ($rangeStart[1] <= $rowIndex) && ($rangeEnd[1] >= $rowIndex);
+    }
+
