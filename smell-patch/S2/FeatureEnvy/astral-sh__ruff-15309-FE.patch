 }
 
+impl FormatSummary {
+    /// Generate a [`Edit`] to remove unused positional arguments from a `format` call.
+    pub(crate) fn remove_unused_positional_arguments_from_format_call(
+        &self,
+        unused_arguments: &[usize],
+        call: &ast::ExprCall,
+        locator: &Locator,
+        stylist: &Stylist,
+    ) -> Result<Edit> {
+        let ast::ExprCall {
+            func,
+            arguments,
+            range: call_range,
+        } = call;
+
+        let named_arguments_are_keepable = arguments.keywords.iter().all(|keyword| {
+            let has_value = !locator.slice(&keyword.value).is_empty();
+            match &keyword.arg {
+                Some(name) => has_value && !name.as_str().is_empty(),
+                None => has_value,
+            }
+        });
+        let unused_arguments: Vec<usize> = unused_arguments
+            .iter()
+            .copied()
+            .filter(|index| {
+                named_arguments_are_keepable
+                    && *index < arguments.args.len() + arguments.keywords.len()
+                    && !self.indices.contains(index)
+            })
+            .collect();
+
+        let source_range = TextRange::new(func.start().min(call_range.start()), call_range.end());
+        let source_code = locator.slice(source_range);
+        let wrapped = format!("({source_code})");
+        let mut expression = match_expression(&wrapped)?;
+        {
+            let cst_call = match_call_mut(&mut expression)?;
+            let mut index = 0;
+            cst_call.args.retain(|_| {
+                let is_unused = unused_arguments.contains(&index);
+                index += 1;
+                !is_unused
+            });
+        }
+
+        let mut state = CodegenState {
+            default_newline: stylist.line_ending().as_str(),
+            default_indent: stylist.indentation(),
+            ..Default::default()
+        };
+        expression.codegen(&mut state);
+        let mut output = state.to_string();
+        output.drain(0..1);
+        output.drain(output.len() - 1..output.len());
+        Ok(Edit::range_replacement(output, *call_range))
+    }
+}
