diff --git a/lib/helpers/AxiosTransformStream.js b/lib/helpers/AxiosTransformStream.js
index 8e8c6d4..41624e7 100644
--- a/lib/helpers/AxiosTransformStream.js
+++ b/lib/helpers/AxiosTransformStream.js
@@ -186,6 +186,91 @@ class AxiosTransformStream extends stream.Transform{
     this[kInternals].length = +length;
     return this;
   }
+
+  configureResponsePipeline(res, req, zlib, ZlibHeaderTransformStream, AxiosHeaders, AxiosError, isBrotliSupported, onDownloadProgress, decompress, method, config) {
+    if (req.destroyed) {
+      return null;
+    }
+
+    const streams = [res];
+    const lastRequest = res.req || req;
+    const responseHeaders = AxiosHeaders.from(res.headers);
+    const contentLength = responseHeaders.getContentLength();
+    const statusCode = res.statusCode;
+    const statusMessage = res.statusMessage;
+
+    this[kInternals].length = utils.toFiniteNumber(contentLength);
+
+    if (onDownloadProgress) {
+      this.on('progress', progress => {
+        onDownloadProgress(Object.assign(progress, {
+          download: true
+        }));
+      });
+
+      streams.push(this);
+    }
+
+    // decompress the response body transparently if required
+    if (decompress !== false && responseHeaders.get('content-encoding')) {
+      // if no content, but headers still say that it is encoded,
+      // remove the header not confuse downstream operations
+      if (method === 'HEAD' || statusCode === 204) {
+        delete res.headers['content-encoding'];
+      }
+
+      const zlibConstants = zlib.constants;
+      const zlibOptions = {
+        flush: zlibConstants.Z_SYNC_FLUSH,
+        finishFlush: zlibConstants.Z_SYNC_FLUSH
+      };
+      const brotliOptions = {
+        flush: zlibConstants.BROTLI_OPERATION_FLUSH,
+        finishFlush: zlibConstants.BROTLI_OPERATION_FLUSH
+      };
+
+      switch (res.headers['content-encoding']) {
+      /*eslint default-case:0*/
+      case 'gzip':
+      case 'x-gzip':
+      case 'compress':
+      case 'x-compress':
+        // add the unzipper to the body stream processing pipeline
+        streams.push(zlib.createUnzip(zlibOptions));
+
+        // remove the content-encoding in order to not confuse downstream operations
+        delete res.headers['content-encoding'];
+        break;
+      case 'deflate': {
+        const headerStream = new ZlibHeaderTransformStream();
+        headerStream.cmf = 120;
+        headerStream.flg = 156;
+        streams.push(headerStream);
+
+        // add the unzipper to the body stream processing pipeline
+        streams.push(zlib.createUnzip(zlibOptions));
+
+        // remove the content-encoding in order to not confuse downstream operations
+        delete res.headers['content-encoding'];
+        break;
+      }
+      case 'br':
+        if (isBrotliSupported) {
+          streams.push(zlib.createBrotliDecompress(brotliOptions));
+          delete res.headers['content-encoding'];
+        }
+      }
+    }
+
+    const maxContentLengthError = (maxContentLength) => new AxiosError(
+      'maxContentLength size of ' + maxContentLength + ' exceeded',
+      AxiosError.ERR_BAD_RESPONSE,
+      config,
+      lastRequest
+    );
+
+    return {streams, lastRequest, statusCode, statusMessage, maxContentLengthError};
+  }
 }
 
 export default AxiosTransformStream;
