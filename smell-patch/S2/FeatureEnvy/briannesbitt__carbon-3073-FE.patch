+    /**
+     * Get the difference in the given unit between two dates.
+     *
+     * @param Unit|string $unit
+     */
+    public function diffInUnit(CarbonInterface $start, CarbonInterface $end, Unit|string $unit, bool $absolute = false, bool $utc = false): float
+    {
+        $clock = $this->getClock();
+        $factory = $clock?->getFactory() ?? FactoryImmutable::getDefaultInstance();
+        $locale = $factory->getSettings()['locale'] ?? 'en';
+        $language = new Language($locale);
+        $normalizedLocale = $language->getCode();
+
+        if ($language->getVariant()) {
+            $normalizedLocale .= '_'.$language->getVariant();
+        }
+
+        if ($language->getRegion()) {
+            $normalizedLocale .= '_'.$language->getRegion();
+        }
+
+        $rawUnit = $unit instanceof Unit ? $unit->value : rtrim((string) $unit, 'z');
+
+        try {
+            $resolvedUnit = Unit::fromName($rawUnit, $normalizedLocale);
+            $unitName = Carbon::pluralUnit($resolvedUnit->value);
+        } catch (Throwable) {
+            $unitName = Carbon::pluralUnit($rawUnit);
+        }
+
+        $startTimezone = CarbonTimeZone::instance($start->getTimezone());
+        $endTimezone = CarbonTimeZone::instance($end->getTimezone());
+
+        if (
+            !$utc
+            && $startTimezone
+            && $endTimezone
+            && $startTimezone->getName() !== $endTimezone->getName()
+        ) {
+            $start = $start->avoidMutation()->utc();
+            $end = $end->avoidMutation()->utc();
+        }
+
+        $start = $start->avoidMutation()->setDateTime(
+            $start->year,
+            $start->month,
+            $start->day,
+            $start->hour,
+            $start->minute,
+            $start->second,
+            $start->micro,
+        );
+        $end = $end->avoidMutation()->setDateTime(
+            $end->year,
+            $end->month,
+            $end->day,
+            $end->hour,
+            $end->minute,
+            $end->second,
+            $end->micro,
+        );
+
+        $method = 'diffIn'.$unitName;
+
+        if (!method_exists($start, $method)) {
+            throw new UnknownUnitException($unitName);
+        }
+
+        return $start->$method($end, $absolute, $utc);
+    }
