+    pub(crate) fn get_syntax_for<'s>(
+        &self,
+        assets: &'s HighlightingAssets,
+        language: Option<&str>,
+        input: &mut OpenedInput<'_>,
+        mapping: &SyntaxMapping<'a>,
+    ) -> Result<SyntaxReferenceInSet<'s>> {
+        if let Some(language) = language {
+            let syntax_set = assets
+                .syntax_set_cell
+                .get_or_try_init(|| assets.serialized_syntax_set.deserialize())?;
+            return syntax_set
+                .find_syntax_by_token(language)
+                .map(|syntax| SyntaxReferenceInSet { syntax, syntax_set })
+                .ok_or_else(|| Error::UnknownSyntax(language.to_owned()));
+        }
+
+        let path = input
+            .metadata
+            .user_provided_name
+            .as_ref()
+            .or(match input.kind {
+                OpenedInputKind::OrdinaryFile(ref path) => Some(path),
+                _ => None,
+            });
+
+        let path_syntax = if let Some(path) = path {
+            let path = PathAbs::new(path)
+                .map_or_else(|_| path.to_owned(), |p| p.as_path().to_path_buf());
+
+            let match_mappings = |path: &Path| {
+                let candidate = Candidate::new(path);
+                let candidate_filename = path.file_name().map(Candidate::new);
+                for entry in mapping.mappings().iter().rev() {
+                    let entry = MappingEntry::from_tuple(entry);
+                    if entry.glob_matcher().is_match_candidate(&candidate)
+                        || candidate_filename.as_ref().map_or(false, |filename| {
+                            entry.glob_matcher().is_match_candidate(filename)
+                        })
+                    {
+                        return Some(*entry.target());
+                    }
+                }
+                None
+            };
+
+            let syntax_match = match_mappings(&path);
+
+            if let Some(MappingTarget::MapToUnknown) = syntax_match {
+                Err(Error::UndetectedSyntax(path.to_string_lossy().into()))
+            } else if let Some(MappingTarget::MapTo(syntax_name)) = syntax_match {
+                assets
+                    .find_syntax_by_name(syntax_name)?
+                    .ok_or_else(|| Error::UnknownSyntax(syntax_name.to_owned()))
+            } else {
+                let file_name = path.file_name().unwrap_or_default();
+                let mut file_name_syntax = assets.find_syntax_by_extension(Some(file_name))?;
+                if file_name_syntax.is_none() {
+                    if let Some(file_str) = Path::new(file_name).to_str() {
+                        for suffix in self.values() {
+                            if let Some(stripped_file_name) = file_str.strip_suffix(*suffix) {
+                                file_name_syntax = assets.get_syntax_for_file_name(
+                                    OsStr::new(stripped_file_name),
+                                    &mapping.ignored_suffixes,
+                                )?;
+                                break;
+                            }
+                        }
+                    }
+                }
+
+                match (file_name_syntax, syntax_match) {
+                    (Some(syntax), _) => Ok(syntax),
+                    (_, Some(MappingTarget::MapExtensionToUnknown)) => {
+                        Err(Error::UndetectedSyntax(path.to_string_lossy().into()))
+                    }
+                    _ => assets
+                        .get_syntax_for_file_extension(file_name, &mapping.ignored_suffixes)?
+                        .ok_or_else(|| Error::UndetectedSyntax(path.to_string_lossy().into())),
+                }
+            }
+        } else {
+            Err(Error::UndetectedSyntax("[unknown]".into()))
+        };
+
+        match path_syntax {
+            Err(Error::UndetectedSyntax(path)) => {
+                let syntax_set = assets
+                    .syntax_set_cell
+                    .get_or_try_init(|| assets.serialized_syntax_set.deserialize())?;
+                String::from_utf8(input.reader.first_line.clone())
+                    .ok()
+                    .and_then(|l| syntax_set.find_syntax_by_first_line(&l))
+                    .map(|syntax| SyntaxReferenceInSet { syntax, syntax_set })
+                    .ok_or(Error::UndetectedSyntax(path))
+            }
+            other => other,
+        }
+    }
