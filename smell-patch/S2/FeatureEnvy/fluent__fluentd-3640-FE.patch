diff --git a/lib/fluent/time.rb b/lib/fluent/time.rb
index e535a027..2f706744 100644
--- a/lib/fluent/time.rb
+++ b/lib/fluent/time.rb
@@ -121,6 +121,49 @@ module Fluent
       from_time(Time.parse(*args))
     end
 
+    def calc_max_retry_timeout(retry_state, detector, chunk_wait, metadata)
+      require 'fluent/engine' unless defined?(Fluent::Engine)
+      engine = Fluent::Engine
+
+      steps = @sec
+      configured_steps = retry_state.max_steps
+      steps = configured_steps if configured_steps && configured_steps < steps
+
+      sys = engine.system_config
+      workers = sys.workers
+      workers = 1 if engine.supervisor_mode && (workers.nil? || workers < 1)
+      if workers && workers > 0
+        aligned = steps / workers * workers
+        steps = aligned < 1 ? @sec : aligned
+      end
+
+      wait = [retry_state.constant_factor, detector.heartbeat_interval].min
+      base = [retry_state.backoff_base, metadata.timekey].min
+      max_int = retry_state.max_interval
+      meta_max = metadata.variables && metadata.variables[:max_interval]
+      max_int = [max_int, meta_max].compact.min if max_int || meta_max
+
+      factor = retry_state.constant_factor.to_f
+      result = 0
+      steps.times { |i|
+        interval = retry_state.calc_interval(i)
+        interval = interval * wait / factor if factor != 0 && interval.finite?
+        if retry_state.backoff_base.to_f != 0 && interval.finite?
+          interval = interval * base / retry_state.backoff_base
+        end
+        if max_int && interval > max_int
+          interval = max_int
+        end
+        result += interval
+      }
+
+      cap = [detector.hard_timeout, chunk_wait.timeout].compact.min
+      if cap && result > cap
+        result = cap
+      end
+      result
+    end
+
     ## TODO: For performance, implement +, -, and so on
