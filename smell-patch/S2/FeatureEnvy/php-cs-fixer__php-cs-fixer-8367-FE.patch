+    /**
+     * @param array{
+     *     constant?: array<class-string, string>,
+     *     class?: array<class-string, string>,
+     *     function?: array<class-string, string>
+     * } $uses
+     * @param callable(string, string, array): ?list<Token> $determineShortType
+     */
+    public function fixFunction(Tokens $tokens, int $index, array $uses, string $namespaceName, callable $determineShortType): void
+    {
+        if ($tokens->getCodeHash() !== $this->functionsAnalysis['tokens']) {
+            $this->buildFunctionsAnalysis($tokens);
+        }
+
+        $resolvedNamespaceName = $namespaceName;
+        $namespaceUsesAnalyzer = new NamespaceUsesAnalyzer();
+        $effectiveUses = $uses;
+
+        foreach ($tokens->getNamespaceDeclarations() as $namespaceAnalysis) {
+            if ($index < $namespaceAnalysis->getScopeStartIndex() || $index > $namespaceAnalysis->getScopeEndIndex()) {
+                continue;
+            }
+
+            $lookedUpNamespaceName = $namespaceAnalysis->getFullName();
+            if ($lookedUpNamespaceName === $namespaceName) {
+                $resolvedNamespaceName = $lookedUpNamespaceName;
+            }
+
+            foreach ($namespaceUsesAnalyzer->getDeclarationsInNamespace($tokens, $namespaceAnalysis, true) as $use) {
+                if (!$use->isClass()) {
+                    continue;
+                }
+
+                $fullName = ltrim($use->getFullName(), '\\');
+                $shortName = $use->getShortName();
+                if (isset($uses['class'][$fullName])) {
+                    $effectiveUses['class'][$fullName] = $shortName;
+                }
+            }
+
+            break;
+        }
+
+        $arguments = $this->getFunctionArguments($tokens, $index);
+        foreach ($arguments as $argumentName => $argument) {
+            $argument = $this->getFunctionArguments($tokens, $index)[$argumentName];
+            if (!$argument->hasTypeAnalysis()) {
+                continue;
+            }
+
+            $type = $argument->getTypeAnalysis();
+            $typeStartIndex = $type->getStartIndex();
+            $typeEndIndex = $type->getEndIndex();
+
+            if ($tokens[$typeStartIndex]->isGivenKind(CT::T_NULLABLE_TYPE)) {
+                $typeStartIndex = $tokens->getNextMeaningfulToken($typeStartIndex);
+            }
+
+            foreach ($this->getTypeRanges($tokens, $typeStartIndex, $typeEndIndex) as [$startIndex, $endIndex]) {
+                $content = $tokens[$startIndex]->getContent();
+                if ($startIndex !== $endIndex) {
+                    $content = $tokens->generatePartialCode($startIndex, $endIndex);
+                }
+
+                $newTokens = $determineShortType($content, $resolvedNamespaceName, $effectiveUses);
+                if (null !== $newTokens) {
+                    $tokens->overrideRange($startIndex, $endIndex, $newTokens);
+                }
+            }
+        }
+
+        $returnTypeAnalysis = $this->getFunctionReturnType($tokens, $index);
+        if (null === $returnTypeAnalysis) {
+            return;
+        }
+
+        $typeStartIndex = $returnTypeAnalysis->getStartIndex();
+        $typeEndIndex = $returnTypeAnalysis->getEndIndex();
+
+        if ($tokens[$typeStartIndex]->isGivenKind(CT::T_NULLABLE_TYPE)) {
+            $typeStartIndex = $tokens->getNextMeaningfulToken($typeStartIndex);
+        }
+
+        foreach ($this->getTypeRanges($tokens, $typeStartIndex, $typeEndIndex) as [$startIndex, $endIndex]) {
+            $content = $tokens[$startIndex]->getContent();
+            if ($startIndex !== $endIndex) {
+                $content = $tokens->generatePartialCode($startIndex, $endIndex);
+            }
+
+            $newTokens = $determineShortType($content, $resolvedNamespaceName, $effectiveUses);
+            if (null !== $newTokens) {
+                $tokens->overrideRange($startIndex, $endIndex, $newTokens);
+            }
+        }
+    }
