+    /**
+     * Create a new cell at the specified coordinate on a worksheet.
+     *
+     * @param Worksheet $worksheet Worksheet that owns the cell
+     * @param string $coordinate Coordinate of the cell
+     *
+     * @return Cell Cell that was created
+     */
+    public function createNewCell(Worksheet $worksheet, string $coordinate): Cell
+    {
+        $activeHelper = $this->cellReferenceHelper;
+
+        [$column, $row, $columnString] = Coordinate::indexesFromString($coordinate);
+
+        $cellCollection = $worksheet->getCellCollection();
+        $cell = new Cell(null, DataType::TYPE_NULL, $worksheet);
+        $cellCollection->add($coordinate, $cell);
+
+        $highestColumnIndex = Coordinate::columnIndexFromString($worksheet->getHighestColumn());
+        $highestRow = $worksheet->getHighestRow();
+        if ($column > $highestColumnIndex || $row > $highestRow) {
+            $worksheet->updateCachedHighestCoordinates($column, $row);
+        }
+
+        $currentXf = $cell->getXfIndex();
+        $uninitializedCell = $cell->getDataType() === DataType::TYPE_NULL;
+        $parentSpreadsheet = $worksheet->getParent();
+        $cellXfCollection = $parentSpreadsheet !== null ? $parentSpreadsheet->getCellXfCollection() : [];
+
+        $xfSet = false;
+        if ($uninitializedCell && $worksheet->rowDimensionExists($row)) {
+            $rowDimension = $worksheet->getRowDimension($row);
+            $rowXf = (int) $rowDimension->getXfIndex();
+            if ($rowXf > $currentXf) {
+                if (isset($cellXfCollection[$rowXf])) {
+                    $rowStyle = $cellXfCollection[$rowXf];
+                    $matchedStyle = $parentSpreadsheet !== null
+                        ? $parentSpreadsheet->getCellXfByHashCode($rowStyle->getHashCode())
+                        : false;
+                    $cell->setXfIndex($matchedStyle !== false ? $matchedStyle->getIndex() : $rowStyle->getIndex());
+                } else {
+                    $cell->setXfIndex($rowXf);
+                }
+                $xfSet = true;
+            }
+        }
+        if (!$xfSet && $uninitializedCell && $worksheet->columnDimensionExists($columnString)) {
+            $columnDimension = $worksheet->getColumnDimension($columnString);
+            $colXf = (int) $columnDimension->getXfIndex();
+            if ($colXf > $cell->getXfIndex()) {
+                if (isset($cellXfCollection[$colXf])) {
+                    $columnStyle = $cellXfCollection[$colXf];
+                    $matchedStyle = $parentSpreadsheet !== null
+                        ? $parentSpreadsheet->getCellXfByHashCode($columnStyle->getHashCode())
+                        : false;
+                    $cell->setXfIndex($matchedStyle !== false ? $matchedStyle->getIndex() : $columnStyle->getIndex());
+                } else {
+                    $cell->setXfIndex($colXf);
+                }
+            }
+        }
+
+        $this->cellReferenceHelper = $activeHelper;
+
+        return $cell;
+    }
