   }
+
+  /**
+   * Returns true if cartesian point {@code (x, y)} (lon/lat) is inside the haversin circle
+   * represented by {@code calculator}.
+   */
+  boolean containsHaversin(Circle2D.HaversinDistance calculator, double x, double y) {
+    Circle circle = calculator.circle;
+    Rectangle rectangle = calculator.rectangle;
+    double minLonIncl = GeoEncodingUtils.decodeLongitude(GeoEncodingUtils.MIN_LON_ENCODED);
+    if (y < GeoUtils.MIN_LAT_INCL || y > GeoUtils.MAX_LAT_INCL) {
+      return false;
+    }
+    if (calculator.crossesDateline) {
+      if (Component2D.containsPoint(
+              x, y, rectangle.minLon, GeoUtils.MAX_LON_INCL, rectangle.minLat, rectangle.maxLat)
+          || Component2D.containsPoint(
+              x, y, minLonIncl, rectangle.maxLon, rectangle.minLat, rectangle.maxLat)) {
+        return SloppyMath.haversinSortKey(y, x, this.lat, circle.getLon()) <= calculator.sortKey;
+      }
+    } else {
+      if (Component2D.containsPoint(
+          x, y, rectangle.minLon, rectangle.maxLon, rectangle.minLat, rectangle.maxLat)) {
+        return SloppyMath.haversinSortKey(y, x, this.lat, circle.getLon()) <= calculator.sortKey;
+      }
+    }
+    return false;
+  }
 }
