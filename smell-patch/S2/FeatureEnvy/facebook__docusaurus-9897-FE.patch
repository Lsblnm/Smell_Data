+class MarkdownContentHost {
+  private readonly surroundingNewlineFactor: number = 1;
+
+  unwrapMdxCodeBlocks(content: string): string {
+    // We only support 3/4 backticks on purpose, should be good enough
+    const beginName = mdxBlockCaptureNames.beginName;
+    const spacesName = mdxBlockCaptureNames.spacesName;
+    const childrenName = mdxBlockCaptureNames.childrenName;
+    const endName = mdxBlockCaptureNames.endName;
+    const lineFeed = mdxFenceLineBreak.lineFeed;
+    const startAnchor = mdxFenceLineBreak.startAnchor;
+    const endAnchor = mdxFenceLineBreak.endAnchor;
+    const fence = mdxFenceDelimiter.backtickRun;
+    const extraFence = mdxFenceDelimiter.extraBacktick;
+    const language = mdxBlockInfoString.language;
+    const indentClass = mdxBlockInfoString.indentClass;
+    const flags = mdxRegexFlags.globalDotAll;
+    const newline = lineFeed;
+
+    const buildPattern = (marker: string) =>
+      `(?<${beginName}>${startAnchor}|${newline})${marker}(?<${spacesName}>${indentClass})${language}${newline}(?<${childrenName}>.*?)${newline}${marker}(?<${endName}>${newline}|${endAnchor})`;
+
+    const regexp3 = new RegExp(buildPattern(fence), flags);
+    const regexp4 = new RegExp(buildPattern(`${fence}${extraFence}`), flags);
+
+    // eslint-disable-next-line @typescript-eslint/no-explicit-any
+    const replacer = (substring: string, ...args: any[]) => {
+      const groups = args.at(-1);
+      const beginText = groups[beginName].repeat(this.surroundingNewlineFactor);
+      const endText = groups[endName].repeat(this.surroundingNewlineFactor);
+      return `${beginText}${groups[childrenName]}${endText}`;
+    };
+
+    return content.replaceAll(regexp3, replacer).replaceAll(regexp4, replacer);
+  }
+}
