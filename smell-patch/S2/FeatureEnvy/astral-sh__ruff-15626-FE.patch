+impl NegateEqualOp {
+    /// Emit a SIM201 diagnostic for a negated equality comparison.
+    fn report(&self, checker: &mut Checker, unary: &ast::ExprUnaryOp) {
+        if !matches!(unary.op, UnaryOp::Not) {
+            return;
+        }
+        let Expr::Compare(compare) = unary.operand.as_ref() else {
+            return;
+        };
+        let ast::ExprCompare {
+            left,
+            ops,
+            comparators,
+            range,
+        } = compare;
+        if !matches!(&ops[..], [CmpOp::Eq]) {
+            return;
+        }
+        if is_exception_check(checker.semantic().current_statement()) {
+            return;
+        }
+
+        let in_dunder_method = {
+            let semantic = checker.semantic();
+            let scope = &semantic.scopes[semantic.scope_id];
+            match &scope.kind {
+                ScopeKind::Function(function_def) => is_dunder_method(&function_def.name),
+                _ => false,
+            }
+        };
+        if in_dunder_method {
+            return;
+        }
+
+        let mut diagnostic = Diagnostic::new(
+            NegateEqualOp {
+                left: self.left.clone(),
+                right: checker.generator().expr(&comparators[0]),
+            },
+            unary.range,
+        );
+        let node = ast::ExprCompare {
+            left: left.clone(),
+            ops: Box::from([CmpOp::NotEq]),
+            comparators: comparators.clone(),
+            range: *range,
+        };
+        diagnostic.set_fix(Fix::safe_edit(Edit::range_replacement(
+            checker.generator().expr(&node.into()),
+            unary.range,
+        )));
+        checker.diagnostics.push(diagnostic);
+    }
+}
