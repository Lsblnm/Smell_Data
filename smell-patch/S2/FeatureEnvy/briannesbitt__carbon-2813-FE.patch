diff --git a/src/Carbon/FactoryImmutable.php b/src/Carbon/FactoryImmutable.php
index 715f5e78..07da4eba 100644
--- a/src/Carbon/FactoryImmutable.php
+++ b/src/Carbon/FactoryImmutable.php
@@ -12,6 +12,8 @@
 namespace Carbon;
 
 use Closure;
+use DateTimeInterface;
+use ReflectionMethod;
 
 /**
  * A factory to generate CarbonImmutable instances with common settings.
@@ -240,4 +242,128 @@ use Closure;
 class FactoryImmutable extends Factory
 {
     protected $className = CarbonImmutable::class;
+
+    public function __call($name, $arguments)
+    {
+        return $this->dispatch($name, $arguments, $this->className);
+    }
+
+    /**
+     * Forward a call to the configured date class and apply factory settings.
+     *
+     * @param string $name
+     * @param array  $arguments
+     * @param string $className
+     *
+     * @return mixed
+     */
+    public function dispatch($name, $arguments, $className)
+    {
+        $method = new ReflectionMethod($className, $name);
+        $settings = $this->settings;
+
+        if ($settings && isset($settings['timezone'])) {
+            $tzParameters = array_filter($method->getParameters(), function ($parameter) {
+                return \in_array($parameter->getName(), ['tz', 'timezone'], true);
+            });
+
+            if (isset($arguments[0]) && \in_array($name, ['instance', 'make', 'create', 'parse'], true)) {
+                if ($arguments[0] instanceof DateTimeInterface) {
+                    $settings['innerTimezone'] = $settings['timezone'];
+                } elseif (\is_string($arguments[0]) && date_parse($arguments[0])['is_localtime']) {
+                    unset($settings['timezone'], $settings['innerTimezone']);
+                }
+            } elseif (\count($tzParameters)) {
+                array_splice($arguments, key($tzParameters), 0, [$settings['timezone']]);
+                unset($settings['timezone']);
+            }
+        }
+
+        $result = $className::$name(...$arguments);
+
+        if (!($result instanceof CarbonInterface) || empty($settings)) {
+            return $result;
+        }
+
+        $currentLocale = null;
+        $currentTzName = null;
+        $year = null;
+
+        if ($result instanceof CarbonImmutable) {
+            $currentLocale = $result->locale;
+            $currentTzName = $result->tzName;
+            $year = $result->year;
+        } elseif ($result instanceof Carbon) {
+            $currentLocale = $result->locale;
+            $currentTzName = $result->tzName;
+            $year = $result->year;
+        }
+
+        $locale = $settings['locale'] ?? null;
+        $innerTimezone = $settings['innerTimezone'] ?? null;
+        $timezone = $settings['timezone'] ?? null;
+        unset($settings['locale'], $settings['innerTimezone'], $settings['timezone']);
+
+        if (!empty($settings)) {
+            $result = $result->settings($settings);
+        }
+
+        if ($locale !== null) {
+            $locales = \is_array($locale) ? $locale : [$locale];
+            $language = new Language($locales[0]);
+            if ($currentLocale && $language->getCode() === $currentLocale && !$language->getRegion()) {
+                $localeId = $currentLocale;
+            } else {
+                $localeId = $language->getRegion() ? $language->getId() : $language->getCode();
+            }
+            $translator = Translator::get($localeId);
+
+            if ($translator->getLocale() !== $localeId) {
+                $translator = Translator::get($language->getId());
+            }
+
+            $fallbackLocales = \array_slice($locales, 1);
+
+            if ($fallbackLocales) {
+                $translator->setFallbackLocales($fallbackLocales);
+
+                foreach ($fallbackLocales as $fallbackLocale) {
+                    $messages = Translator::get($fallbackLocale)->getMessages();
+
+                    if (isset($messages[$fallbackLocale])) {
+                        $translator->setMessages($fallbackLocale, $messages[$fallbackLocale]);
+                    }
+                }
+            }
+
+            $result = $result->setLocalTranslator($translator);
+        }
+
+        $timezoneToApply = $innerTimezone ?? $timezone;
+        $shift = $innerTimezone === null && $timezone !== null;
+
+        if ($timezoneToApply === null) {
+            return $result;
+        }
+
+        $targetTz = CarbonTimeZone::instance($timezoneToApply);
+
+        if ($targetTz === false) {
+            return $shift ? $result->shiftTimezone($timezoneToApply) : $result->setTimezone($timezoneToApply);
+        }
+
+        $targetName = $targetTz->getName();
+
+        if ($currentTzName === $targetName && $shift) {
+            return $result;
+        }
+
+        if ($shift && $year !== null) {
+            $wallTime = sprintf('%04d-%s', $year, $result->format('m-d H:i:s.u'));
+
+            return $result->setTimezone($targetName)->modify($wallTime);
+        }
+
+        return $shift ? $result->shiftTimezone($targetName) : $result->setTimezone($targetName);
+    }
 }
