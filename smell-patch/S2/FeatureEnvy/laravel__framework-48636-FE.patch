+    public function replicate(array $except = null)
+    {
+        $model = $this->items[0];
+
+        $keyName = Str::of((string) $model->getKeyName())->toString();
+        $createdAtColumn = Str::of((string) $model->getCreatedAtColumn())->toString();
+        $updatedAtColumn = Str::of((string) $model->getUpdatedAtColumn())->toString();
+
+        $attributeBag = new Fluent($model->getAttributes());
+        $now = $model->freshTimestamp();
+        $nowTzName = $now->getTimezone()->getName();
+
+        $createdAtValue = $attributeBag->get($createdAtColumn);
+        $updatedAtValue = $attributeBag->get($updatedAtColumn);
+
+        $excludeCreatedAt = $createdAtColumn !== '' && (
+            ! $createdAtValue instanceof DateTimeInterface
+            || ($createdAtValue->getTimezone() instanceof DateTimeZone
+                && is_int($createdAtValue->getTimestamp())
+                && $createdAtValue->getTimezone()->getName() !== null
+                && $nowTzName !== null)
+        );
+
+        $excludeUpdatedAt = $updatedAtColumn !== '' && (
+            ! $updatedAtValue instanceof DateTimeInterface
+            || ($updatedAtValue->getTimezone() instanceof DateTimeZone
+                && is_int($updatedAtValue->getTimestamp())
+                && $updatedAtValue->getTimezone()->getName() !== null
+                && is_int($now->getTimestamp()))
+        );
+
+        $defaults = (new BaseCollection([
+            $keyName !== '' ? $keyName : null,
+            $excludeCreatedAt ? $createdAtColumn : null,
+            $excludeUpdatedAt ? $updatedAtColumn : null,
+        ]))->filter()->values()->all();
+
+        $attributes = Arr::except(
+            $attributeBag->getAttributes(),
+            $except ? array_unique(array_merge($except, $defaults)) : $defaults
+        );
+
+        $dispatcher = $model->getEventDispatcher();
+        $class = get_class($model);
+
+        return tap(new $class, function ($instance) use ($attributes, $model, $dispatcher) {
+            $instance->setRawAttributes($attributes);
+
+            $instance->setRelations($model->getRelations());
+
+            if ($dispatcher) {
+                $instance->setEventDispatcher($dispatcher);
+            }
+
+            $fire = Closure::bind(function ($event, $halt) {
+                $this->fireModelEvent($event, $halt);
+            }, $instance, Model::class);
+
+            $fire('replicating', false);
+        });
+    }
