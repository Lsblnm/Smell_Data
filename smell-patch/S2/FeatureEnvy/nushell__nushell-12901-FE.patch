+pub struct ExternalSpawn {
+    cwd: String,
+}
+
+impl ExternalSpawn {
+    pub fn new(cwd: impl Into<String>) -> Self {
+        Self { cwd: cwd.into() }
+    }
+
+    /// Spawn a command without shelling out to an external shell
+    pub fn spawn_simple_command(
+        &self,
+        command: &ExternalCommand,
+        engine_state: &EngineState,
+        stack: &Stack,
+    ) -> Result<std::process::Command, ShellError> {
+        let (head, _, _) = trim_enclosing_quotes(&command.name.item);
+        let head = nu_path::expand_to_real_path(head)
+            .to_string_lossy()
+            .to_string();
+
+        let mut process = std::process::Command::new(head);
+
+        let mut env_pwd = None;
+
+        'stack_scopes: for scope in stack.env_vars.iter().rev() {
+            for overlay_name in stack.active_overlays.iter().rev() {
+                if let Some(vars) = scope.get(overlay_name) {
+                    if let Some(Value::String { val, .. }) = vars.get("PWD") {
+                        env_pwd = Some(val.clone());
+                        break 'stack_scopes;
+                    }
+                }
+            }
+        }
+
+        if env_pwd.is_none() {
+            for overlay_name in stack.active_overlays.iter().rev() {
+                let is_hidden = stack
+                    .env_hidden
+                    .get(overlay_name)
+                    .map(|hidden| hidden.contains("PWD"))
+                    .unwrap_or(false);
+                if is_hidden {
+                    continue;
+                }
+                if let Some(vars) = engine_state.env_vars.get(overlay_name) {
+                    if let Some(Value::String { val, .. }) = vars.get("PWD") {
+                        env_pwd = Some(val.clone());
+                        break;
+                    }
+                }
+            }
+        }
+
+        if env_pwd.is_none() {
+            for overlay_id in engine_state.scope.active_overlays.iter().rev() {
+                if let Some((overlay_name, _)) = engine_state.scope.overlays.get(*overlay_id) {
+                    let overlay_name = String::from_utf8_lossy(overlay_name);
+                    if let Some(vars) = engine_state.env_vars.get(overlay_name.as_ref()) {
+                        if let Some(Value::String { val, .. }) = vars.get("PWD") {
+                            env_pwd = Some(val.clone());
+                            break;
+                        }
+                    }
+                }
+            }
+        }
+
+        let cwd = match env_pwd {
+            Some(pwd) if pwd == self.cwd => pwd,
+            _ => self.cwd.clone(),
+        };
+
+        for (arg, arg_keep_raw) in command.args.iter().zip(command.arg_keep_raw.iter()) {
+            trim_expand_and_apply_arg(&mut process, arg, arg_keep_raw, &cwd);
+        }
+
+        Ok(process)
+    }
+}
