         return $model->newModelQuery()->whereKey($this->modelKeys());
     }
+
+    /**
+     * Set the inverse relation on all models in the collection.
+     *
+     * @param  \Illuminate\Database\Eloquent\Relations\Relation  $relation
+     * @param  \Illuminate\Database\Eloquent\Model|null  $parent
+     * @return $this
+     */
+    public function applyInverseRelationToCollection($relation, ?Model $parent = null)
+    {
+        $parent ??= $relation->getParent();
+
+        $identity = [
+            $parent->getTable(),
+            $parent->getKeyName(),
+            $parent->getKeyType(),
+            $parent->getIncrementing() ? '1' : '0',
+            (string) $parent->getConnectionName(),
+            (string) $relation->getInverseRelationship(),
+        ];
+
+        try {
+            $eloquentBuilder = $relation->getQuery();
+            $relatedModel = $eloquentBuilder->getModel();
+            $identity[] = $relatedModel instanceof Model ? $relatedModel->getTable() : '';
+            $identity[] = implode(',', array_keys((array) $eloquentBuilder->getEagerLoads()));
+        } catch (\Throwable) {
+            // Some relation instances do not currently expose a complete query builder.
+        }
+
+        try {
+            $connection = $parent->getConnection();
+            $identity[] = (string) $connection->getDatabaseName();
+            $identity[] = (string) $connection->getQueryGrammar()->getTablePrefix();
+        } catch (\Throwable) {
+            // The parent model may not have a resolved database connection.
+        }
+
+        $groups = [];
+
+        foreach ($this->items as $model) {
+            $groups[implode('|', $identity)][] = $model;
+        }
+
+        foreach ($groups as $models) {
+            foreach ($models as $model) {
+                $relation->applyInverseRelationToModel($model, $parent);
+            }
+        }
+
+        return $this;
+    }
 }
