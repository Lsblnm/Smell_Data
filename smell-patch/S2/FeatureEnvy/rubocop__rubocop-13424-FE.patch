diff --git a/lib/rubocop/cop/style/safe_navigation.rb b/lib/rubocop/cop/style/safe_navigation.rb
index 65d59776c..1f7cdc2bd 100644
--- a/lib/rubocop/cop/style/safe_navigation.rb
+++ b/lib/rubocop/cop/style/safe_navigation.rb
@@ -312,10 +312,60 @@ module RuboCop
         end
 
         def chain_length(method_chain, method)
-          method.each_ancestor(:send).inject(0) do |total, ancestor|
-            break total + 1 if ancestor == method_chain
+          chain = safe_navigation_chains(method, :send, consecutive: false)
+          index = chain.index(method_chain)
+          index ? index + 1 : chain.size
+        end
+
+        def safe_navigation_chains(node, *types, consecutive: true)
+          types = [:csend] if types.empty?
+          chain_limit = types.include?(:send) ? cop_config.fetch('MaxChainLength', 2) : nil
+          checked_name = node.name if node.variable?
+          enclosing_and = node.each_ancestor.find(&:and_type?)
+          enclosing_if = node.each_ancestor.find(&:if_type?)
+          guarded_lhs = enclosing_and.lhs if enclosing_and
+          guarded_condition = enclosing_if.condition if enclosing_if
+
+          node.each_ancestor.with_object([]) do |parent, chains|
+            matching_send = types.include?(:send) && parent.send_type?
+            matching_csend = types.include?(:csend) && parent.csend_type?
+            if consecutive
+              break chains unless matching_send || matching_csend
+            else
+              next unless matching_send || matching_csend
+            end
+
+            parent_loc = parent.loc
+            parent_range = parent.source_range
+            parent_dot = parent_loc.respond_to?(:dot) ? parent_loc.dot : nil
+            parent_selector = parent_loc.respond_to?(:selector) ? parent_loc.selector : nil
+            expression_begin = parent_range.begin_pos
+            expression_end = parent_range.end_pos
+            expression_line = parent_range.line
+            receiver = parent.receiver
+            method_name = parent.method_name
+
+            located_call = expression_begin && expression_end && expression_line && method_name
+            dot_in_expression = parent_dot.nil? || parent_dot.begin_pos >= expression_begin
+            selector_in_expression = parent_selector.nil? ||
+                                     parent_selector.begin_pos >= expression_begin
+            next unless located_call && dot_in_expression && selector_in_expression
+
+            unless consecutive
+              chain_head = receiver
+              while chain_head.respond_to?(:receiver) && chain_head.receiver
+                chain_head = chain_head.receiver
+              end
+              if checked_name && chain_head&.variable? && chain_head.name != checked_name
+                next
+              end
+
+              next if guarded_lhs&.equal?(parent)
+              next if guarded_condition&.equal?(parent)
+            end
 
-            total + 1
+            chains << parent
+            break chains if chain_limit && chains.size > chain_limit
           end
         end
 
