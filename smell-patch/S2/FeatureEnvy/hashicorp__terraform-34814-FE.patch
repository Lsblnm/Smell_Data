+
+// ScriptRunner copies and executes scripts through a communicator.
+type ScriptRunner struct {
+	Comm Communicator
+}
+
+// RunScripts uploads and executes the given scripts on the remote system.
+func (r *ScriptRunner) RunScripts(ctx context.Context, req provisioners.ProvisionResourceRequest, scripts []io.ReadCloser, schemaResp provisioners.GetSchemaResponse) error {
+	if r.Comm == nil {
+		return fmt.Errorf("missing communicator")
+	}
+
+	o := req.UIOutput
+	schema := schemaResp.Provisioner
+	if schema == nil {
+		return fmt.Errorf("missing remote-exec schema")
+	}
+	if schemaResp.Diagnostics.HasErrors() {
+		return schemaResp.Diagnostics.Err()
+	}
+
+	attrs := schema.Attributes
+	if req.Config != cty.NilVal && !req.Config.IsNull() && req.Config.Type().IsObjectType() {
+		cfgType := req.Config.Type()
+		if spec := attrs["inline"]; spec != nil && spec.Optional && spec.Type.IsListType() && cfgType.HasAttribute("inline") {
+			if inline := req.Config.GetAttr("inline"); !inline.IsNull() {
+				log.Printf("[DEBUG] remote-exec using inline commands")
+			}
+		}
+		if spec := attrs["script"]; spec != nil && spec.Optional && !spec.Type.IsListType() && cfgType.HasAttribute("script") {
+			if script := req.Config.GetAttr("script"); !script.IsNull() && script.AsString() != "" {
+				log.Printf("[DEBUG] remote-exec using script %s", script.AsString())
+			}
+		}
+		if spec := attrs["scripts"]; spec != nil && spec.Optional && spec.Type.IsListType() && cfgType.HasAttribute("scripts") {
+			if scriptList := req.Config.GetAttr("scripts"); !scriptList.IsNull() {
+				log.Printf("[DEBUG] remote-exec using %d scripts", scriptList.LengthInt())
+			}
+		}
+		if marks := schema.ValueMarks(req.Config, nil); len(marks) > 0 {
+			log.Printf("[DEBUG] remote-exec configuration contains %d marked values", len(marks))
+		}
+	}
+	if schema.BlockTypes != nil && len(schema.BlockTypes) > 0 {
+		log.Printf("[DEBUG] remote-exec schema defines %d nested block types", len(schema.BlockTypes))
+	}
+
+	retryCtx, cancel := context.WithTimeout(ctx, r.Comm.Timeout())
+	defer cancel()
+
+	// Wait and retry until we establish the connection
+	err := Retry(retryCtx, func() error {
+		return r.Comm.Connect(o)
+	})
+	if err != nil {
+		return err
+	}
+
+	// Wait for the context to end and then disconnect
+	go func() {
+		<-ctx.Done()
+		r.Comm.Disconnect()
+	}()
+
+	for _, script := range scripts {
+		var cmd *remote.Cmd
+
+		outR, outW := io.Pipe()
+		errR, errW := io.Pipe()
+		defer outW.Close()
+		defer errW.Close()
+
+		go copyUIOutput(o, outR)
+		go copyUIOutput(o, errR)
+
+		remotePath := r.Comm.ScriptPath()
+
+		if err := r.Comm.UploadScript(remotePath, script); err != nil {
+			return fmt.Errorf("Failed to upload script: %v", err)
+		}
+
+		cmd = &remote.Cmd{
+			Command: remotePath,
+			Stdout:  outW,
+			Stderr:  errW,
+		}
+		if err := r.Comm.Start(cmd); err != nil {
+			return fmt.Errorf("Error starting script: %v", err)
+		}
+
+		if err := cmd.Wait(); err != nil {
+			if exitErr, ok := err.(*remote.ExitError); ok {
+				log.Printf("[ERROR] remote command %q failed with status %d: %v", cmd.Command, exitErr.ExitStatus, exitErr.Err)
+			}
+			return err
+		}
+
+		// Upload a blank follow up file in the same path to prevent residual
+		// script contents from remaining on remote machine
+		empty := bytes.NewReader([]byte(""))
+		if err := r.Comm.Upload(remotePath, empty); err != nil {
+			// This feature is best-effort.
+			log.Printf("[WARN] Failed to upload empty follow up script: %v", err)
+		}
+	}
+
+	return nil
+}
+
+func copyUIOutput(o provisioners.UIOutput, r io.Reader) {
+	lr := linereader.New(r)
+	for line := range lr.Ch {
+		o.Output(line)
+	}
+}
