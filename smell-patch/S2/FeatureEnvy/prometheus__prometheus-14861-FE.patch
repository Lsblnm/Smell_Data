+// matrixSelector evaluates a matrix selector expression.
+func (ng *Engine) matrixSelector(ev *evaluator, ctx context.Context) (Matrix, annotations.Annotations) {
+	vs := ev.vectorSel
+	node := ev.matrixSel
+	qs := ev.samplesStats
+
+	offset := durationMilliseconds(vs.Offset)
+	maxt := ev.startTimestamp - offset
+	mint := maxt - durationMilliseconds(node.Range)
+	matrix := make(Matrix, 0, len(vs.Series))
+	it := storage.NewBuffer(durationMilliseconds(node.Range))
+
+	span := trace.SpanFromContext(ctx)
+	span.SetAttributes(attribute.Bool("engine_per_step_stats", ng.enablePerStepStats && qs.EnablePerStepStats))
+	if start := vs.PosRange.Start; start >= 0 {
+		span.SetAttributes(attribute.Int64("selector_start_pos", int64(start)))
+	}
+
+	ws, err := checkAndExpandSeriesSet(ctx, node)
+	if err != nil {
+		ev.error(errWithWarnings{fmt.Errorf("expanding series: %w", err), ws})
+	}
+
+	var chkIter chunkenc.Iterator
+	series := vs.Series
+	for i, s := range series {
+		if err := contextDone(ctx, "expression evaluation"); err != nil {
+			ev.error(err)
+		}
+		chkIter = s.Iterator(chkIter)
+		it.Reset(chkIter)
+		ss := Series{
+			Metric: series[i].Labels(),
+		}
+
+		ss.Floats, ss.Histograms = ev.matrixIterSlice(it, mint, maxt, nil, nil)
+		totalSize := int64(len(ss.Floats)) + int64(totalHPointSize(ss.Histograms))
+		qs.IncrementSamplesAtTimestamp(ev.startTimestamp, totalSize)
+
+		if totalSize > 0 {
+			matrix = append(matrix, ss)
+		} else {
+			putFPointSlice(ss.Floats)
+			putHPointSlice(ss.Histograms)
+		}
+	}
+	return matrix, ws
+}
