diff --git a/src/parser.y b/src/parser.y
index 11a7d2d..3385eb0 100644
--- a/src/parser.y
+++ b/src/parser.y
@@ -177,6 +177,41 @@ static jv check_object_key(block k) {
   return jv_invalid();
 }
 
+block gen_location(location loc, struct locfile* l, block b) {
+  inst* i;
+  for (i = b.first; i != NULL; i = i->next) {
+    location src = i->source;
+    const struct opcode_description* desc = opcode_describe(i->op);
+    if (i == b.first && i->prev != NULL) {
+      continue;
+    }
+    if (src.start != UNKNOWN_LOCATION.start ||
+        src.end != UNKNOWN_LOCATION.end ||
+        i->locfile != NULL) {
+      continue;
+    }
+    i->source.start = loc.start;
+    i->source.end = loc.end;
+    if (l == NULL) {
+      continue;
+    }
+    int named = (i->symbol != NULL) || (i->bound_by != NULL);
+    int usable_desc = (desc != NULL) &&
+                      (desc->length >= 0 || (desc->flags & OP_HAS_BINDING) || named);
+    if (desc != NULL && (desc->flags & OP_HAS_CONSTANT)) {
+      usable_desc = usable_desc || (i->imm.constant.kind_flags != 0);
+    }
+    if (usable_desc) {
+      l->refct++;
+      i->locfile = l;
+    } else {
+      l->refct++;
+      i->locfile = l;
+    }
+  }
+  return b;
+}
+
 static block gen_index(block obj, block key) {
   return BLOCK(gen_subexp(key), obj, gen_op_simple(INDEX));
 }
