+struct ChecksumPrinter {
+    emitted_raw: bool,
+}
+
+impl ChecksumPrinter {
+    fn write_digest_line(
+        &mut self,
+        spec: &ChecksumFormatSpec,
+        filename: &Path,
+        sum_hex: String,
+    ) -> UResult<()> {
+        let style = &spec.presentation;
+        let mode = &style.encoding;
+        let size_info = &mode.path_info;
+        let input_kind = &size_info.source;
+
+        if mode.raw {
+            let bytes = match spec.algo_name {
+                ALGORITHM_OPTIONS_CRC => sum_hex.parse::<u32>().unwrap().to_be_bytes().to_vec(),
+                ALGORITHM_OPTIONS_SYSV | ALGORITHM_OPTIONS_BSD => {
+                    sum_hex.parse::<u16>().unwrap().to_be_bytes().to_vec()
+                }
+                _ => hex::decode(sum_hex).unwrap(),
+            };
+            stdout().write_all(&bytes)?;
+            self.emitted_raw = true;
+            return Ok(());
+        }
+
+        let sum = if mode.base64 {
+            match spec.algo_name {
+                ALGORITHM_OPTIONS_CRC | ALGORITHM_OPTIONS_SYSV | ALGORITHM_OPTIONS_BSD => sum_hex,
+                _ => encoding::encode(encoding::Format::Base64, &hex::decode(sum_hex).unwrap())
+                    .unwrap(),
+            }
+        } else {
+            sum_hex
+        };
+
+        let not_file = input_kind.from_stdin;
+        let sz = size_info.byte_count;
+        let blocks = (sz + size_info.output_bits - 1) / size_info.output_bits;
+        // The BSD checksum output is 5 digit integer
+        let bsd_width = 5;
+        match (spec.algo_name, not_file) {
+            (ALGORITHM_OPTIONS_SYSV, true) => println!("{} {}", sum.parse::<u16>().unwrap(), blocks),
+            (ALGORITHM_OPTIONS_SYSV, false) => println!(
+                "{} {} {}",
+                sum.parse::<u16>().unwrap(),
+                blocks,
+                filename.display()
+            ),
+            (ALGORITHM_OPTIONS_BSD, true) => println!(
+                "{:0bsd_width$} {:bsd_width$}",
+                sum.parse::<u16>().unwrap(),
+                blocks
+            ),
+            (ALGORITHM_OPTIONS_BSD, false) => println!(
+                "{:0bsd_width$} {:bsd_width$} {}",
+                sum.parse::<u16>().unwrap(),
+                blocks,
+                filename.display()
+            ),
+            (ALGORITHM_OPTIONS_CRC, true) => println!("{sum} {sz}"),
+            (ALGORITHM_OPTIONS_CRC, false) => println!("{sum} {sz} {}", filename.display()),
+            (ALGORITHM_OPTIONS_BLAKE2B, _) if style.tagged => {
+                if let Some(length) = spec.length {
+                    // Multiply by 8 here, as we want to print the length in bits.
+                    println!("BLAKE2b-{} ({}) = {sum}", length * 8, filename.display());
+                } else {
+                    println!("BLAKE2b ({}) = {sum}", filename.display());
+                }
+            }
+            _ => {
+                if style.tagged {
+                    println!(
+                        "{} ({}) = {sum}",
+                        spec.algo_name.to_ascii_uppercase(),
+                        filename.display()
+                    );
+                } else {
+                    let prefix = if style.asterisk { "*" } else { " " };
+                    println!("{sum} {prefix}{}", filename.display());
+                }
+            }
+        }
+
+        Ok(())
+    }
+}
