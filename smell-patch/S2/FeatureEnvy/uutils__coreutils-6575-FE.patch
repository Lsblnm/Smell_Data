+/// Algorithm and presentation details used when emitting a checksum line.
+pub struct ChecksumFormatSpec {
+    pub algo_name: &'static str,
+    pub length: Option<usize>,
+    pub presentation: crate::display::ChecksumDisplayStyle,
+}
+
+impl ChecksumFormatSpec {
+    #[allow(clippy::too_many_arguments)]
+    pub fn new(
+        algo_name: &'static str,
+        length: Option<usize>,
+        tagged: bool,
+        asterisk: bool,
+        raw: bool,
+        base64: bool,
+        output_bits: usize,
+        byte_count: usize,
+        from_stdin: bool,
+    ) -> Self {
+        Self {
+            algo_name,
+            length,
+            presentation: crate::display::ChecksumDisplayStyle::new(
+                tagged,
+                asterisk,
+                raw,
+                base64,
+                output_bits,
+                byte_count,
+                from_stdin,
+            ),
+        }
+    }
+}
