+impl ArgumentGlob {
+    /// Performs glob expansion on `arg`. If the expansion found no matches or the pattern
+    /// is not a valid glob, then this returns the original string as the expansion result.
+    ///
+    /// Note: This matches the default behavior of Bash, but is known to be
+    /// error-prone. We might want to change this behavior in the future.
+    fn expand_glob(
+        &self,
+        arg: &str,
+        engine_state: &EngineState,
+        stack: &Stack,
+        expr: &Expression,
+    ) -> Result<Vec<String>, ShellError> {
+        let cwd = engine_state.cwd(Some(stack))?;
+        let error_span = Span::new(expr.span.start, expr.span.end);
+
+        let defaults = nu_glob::MatchOptions::default();
+        let options = nu_glob::MatchOptions {
+            case_sensitive: defaults.case_sensitive,
+            require_literal_separator: defaults.require_literal_separator,
+            require_literal_leading_dot: defaults.require_literal_leading_dot,
+            recursive_match_hidden_dir: defaults.recursive_match_hidden_dir,
+        };
 
-    if result.is_empty() {
-        result.push(arg.to_string());
-    }
+        let pattern_text = match nu_glob::Pattern::new(arg) {
+            Ok(pattern) => pattern.as_str().to_string(),
+            Err(_) => arg.to_string(),
+        };
 
-    Ok(result)
+        let Ok(paths) = nu_glob::glob_with_parent(&pattern_text, options, &cwd) else {
+            return Ok(vec![arg.into()]);
+        };
+
+        let mut result = vec![];
+        for path in paths {
+            let path = path.map_err(|err| ShellError::IOErrorSpanned {
+                msg: format!("{}: {:?}", err.path().display(), err.error()),
+                span: error_span,
+            })?;
+            let path = nu_path::expand_path_with(path, &cwd, false);
+            // Strip PWD from the resulting paths if possible.
+            let path_stripped = path.strip_prefix(&cwd).unwrap_or(&path);
+            let path_string = path_stripped.to_string_lossy().to_string();
+            result.push(path_string);
+        }
+
+        if result.is_empty() && self.keep_unmatched {
+            result.push(arg.to_string());
+        }
+
+        Ok(result)
+    }
 }
 
