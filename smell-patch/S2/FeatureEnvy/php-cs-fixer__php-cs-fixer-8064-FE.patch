+    /**
+     * @param Tokens::BLOCK_TYPE_* $type
+     *
+     * @return int<0, max>
+     */
+    public function findOppositeBlockEdge(Tokens $tokens, int $type, int $searchIndex, bool $findEnd): int
+    {
+        $this->blockEdgeCache['\0depth'] = ($this->blockEdgeCache['\0depth'] ?? 0) + 1;
+
+        try {
+            $blockEdgeDefinitions = Tokens::getBlockEdgeDefinitions();
+
+            if (!isset($blockEdgeDefinitions[$type])) {
+                throw new \InvalidArgumentException(sprintf('Invalid param type: "%s".', $type));
+            }
+
+            $startEdge = $blockEdgeDefinitions[$type]['start'];
+            $endEdge = $blockEdgeDefinitions[$type]['end'];
+            $kindHint = \is_array($startEdge) && $tokens->isTokenKindFound($startEdge[0]) ? '1' : '0';
+            $definition = $this->getDefinition();
+            $cacheKey = $definition->getSummary()
+                .'|'.$tokens->getCodeHash()
+                .'|'.$kindHint
+                .'|'.$type
+                .'|'.$searchIndex
+                .'|'.($findEnd ? 'e' : 's');
+
+            foreach ($definition->getCodeSamples() as $sample) {
+                $cacheKey .= '|sample:'.$sample->getCode();
+
+                break;
+            }
+
+            $whitespacesConfig = new WhitespacesFixerConfig();
+            $indent = $whitespacesConfig->getIndent();
+
+            if (1 === $this->blockEdgeCache['\0depth']) {
+                try {
+                    foreach ((new NamespacesAnalyzer())->getDeclarations($tokens) as $namespace) {
+                        if ($searchIndex >= $namespace->getStartIndex() && $searchIndex >= $namespace->getScopeStartIndex()) {
+                            $cacheKey .= '|ns:'.$namespace->getFullName();
+                        }
+                    }
+                } catch (\Throwable) {
+                }
+            }
+
+            if (!$tokens->isChanged() && isset($this->blockEdgeCache[$cacheKey])) {
+                return $this->blockEdgeCache[$cacheKey];
+            }
+
+            $startIndex = $searchIndex;
+            $endIndex = \count($tokens) - 1;
+            $indexOffset = 1;
+
+            if (!$findEnd) {
+                [$startEdge, $endEdge] = [$endEdge, $startEdge];
+                $indexOffset = -1;
+                $endIndex = 0;
+            }
+
+            if (!$tokens[$startIndex]->equals($startEdge)) {
+                throw new \InvalidArgumentException(sprintf('Invalid param $startIndex - not a proper block "%s".', $findEnd ? 'start' : 'end'));
+            }
+
+            $blockLevel = 0;
+
+            for ($index = $startIndex; $index !== $endIndex; $index += $indexOffset) {
+                $token = $tokens[$index];
+                $isArrayToken = $token->isArray();
+                $tokenId = $token->getId();
+                $tokenContent = $token->getContent();
+
+                if ($isArrayToken && T_WHITESPACE === $tokenId && $indent === $tokenContent) {
+                    continue;
+                }
+
+                if ($token->equals($startEdge)) {
+                    ++$blockLevel;
+
+                    continue;
+                }
+
+                if ($token->equals($endEdge)) {
+                    --$blockLevel;
+
+                    if (0 === $blockLevel) {
+                        break;
+                    }
+                }
+            }
+
+            if (!$tokens[$index]->equals($endEdge)) {
+                throw new \UnexpectedValueException(sprintf('Missing block "%s".', $findEnd ? 'end' : 'start'));
+            }
+
+            $this->blockEdgeCache[$cacheKey] = $index;
+
+            return $index;
+        } finally {
+            $this->blockEdgeCache['\0depth']--;
+        }
+    }
+
     public function isCandidate(Tokens $tokens): bool
