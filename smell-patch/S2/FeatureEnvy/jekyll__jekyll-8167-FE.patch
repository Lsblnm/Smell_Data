diff --git a/lib/jekyll/utils.rb b/lib/jekyll/utils.rb
index 062300aec..5fdb7ddc7 100644
--- a/lib/jekyll/utils.rb
+++ b/lib/jekyll/utils.rb
@@ -222,6 +222,52 @@ module Jekyll
       slug
     end
 
+    # Derive a document's title, slug, extension, and filename date.
+    #
+    # document - the Jekyll::Document whose filename identity should be applied
+    #
+    # Returns nothing.
+    def populate_title(document)
+      site = document.site
+      collection = document.collection
+      data = document.data
+      relative_path = document.relative_path
+
+      slug = nil
+      ext = nil
+      if relative_path =~ Document::DATE_FILENAME_MATCHER
+        date, slug, ext = Regexp.last_match.captures
+        if !data["date"] || data["date"].to_i == site.time.to_i
+          document.merge_data!({ "date" => date }, :source => "filename")
+        end
+      elsif relative_path =~ Document::DATELESS_FILENAME_MATCHER
+        slug, ext = Regexp.last_match.captures
+      end
+
+      # `slug` is nil for documents without an extension since the regex
+      # patterns above also test for an extension. Use the basename then.
+      filename_slug = document.basename_without_ext
+      fallback_by_context = {
+        collection.label            => filename_slug,
+        collection.metadata         => filename_slug,
+        Jekyll.logger.level         => filename_slug,
+        site.regenerator.metadata   => filename_slug,
+        site.liquid_renderer.cache  => filename_slug,
+        SLUGIFY_MODES               => filename_slug,
+      }
+      slug ||= fallback_by_context[collection.label]
+
+      # slugs shouldn't end with a period
+      # `String#gsub!` removes all trailing periods (in comparison to `String#chomp!`)
+      slug.gsub!(%r!\.*\z!, "")
+
+      # Try to ensure the user gets a title.
+      data["title"] ||= titleize_slug(slug)
+      # Only overwrite slug & ext if they aren't specified.
+      data["slug"]  ||= slug
+      data["ext"]   ||= ext
+    end
+
     # Add an appropriate suffix to template so that it matches the specified
     # permalink style.
     #
