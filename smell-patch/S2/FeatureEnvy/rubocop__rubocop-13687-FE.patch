diff --git a/lib/rubocop/cop/lint/safe_navigation_chain.rb b/lib/rubocop/cop/lint/safe_navigation_chain.rb
index e9ad7ad2c..030fe4cca 100644
--- a/lib/rubocop/cop/lint/safe_navigation_chain.rb
+++ b/lib/rubocop/cop/lint/safe_navigation_chain.rb
@@ -52,6 +52,34 @@ module RuboCop
           end
         end
 
+        # Operator method calls that are themselves chained need extra wrapping
+        # so removing the dot does not change send-chain grouping.
+        def wrap_in_parentheses_if_chained(corrector, node)
+          return unless node.parent&.call_type?
+          return if node.parent.first_argument == node
+
+          operator = node.loc.selector
+
+          ParenthesesCorrector.correct(corrector, node)
+          corrector.insert_after(operator, ' ')
+          corrector.wrap(node, '(', ')')
+        end
+
+        def insert_space_after?(node)
+          rhs = node.first_argument
+          selector = node.loc.selector
+
+          return true if selector.end_pos == rhs.source_range.begin_pos
+          return false if node.parent&.call_type? # if chained, a space is already added
+
+          # For `/` operations, if the RHS starts with a `(` without space,
+          # add one to avoid a syntax error.
+          range = selector.end.join(rhs.source_range.begin)
+          return true if node.method?(:/) && range.source == '('
+
+          false
+        end
+
         private
 
         def require_safe_navigation?(node)
@@ -96,13 +124,53 @@ module RuboCop
           send_node.method?(:[]) || send_node.method?(:[]=)
         end
 
+        # rubocop:disable Metrics/AbcSize, Metrics/CyclomaticComplexity, Metrics/PerceivedComplexity, Metrics/MethodLength
         def require_parentheses?(send_node)
+          processed_source = @processed_source
+          return false unless processed_source
+
+          loc = send_node.loc
+          parent = send_node.parent
+          source_range = send_node.source_range
+          return false unless loc && parent && source_range
+
+          range_buffer = source_range.source_buffer
+          processed_buffer = processed_source.buffer
+          return false unless range_buffer && processed_buffer
+          return false unless range_buffer.equal?(processed_buffer)
+
+          line_number = range_buffer.line_for_position(source_range.begin_pos)
+          return false unless processed_source.comment_config.cop_enabled_at_line?(self, line_number)
+
+          if parent.pair_type?
+            pair_key = parent.key
+            pair_value = parent.value
+            key_range = pair_key.source_range
+            value_range = pair_value.source_range
+            return false unless key_range.end_pos <= value_range.begin_pos
+            return false if loc.dot && !send_node.comparison_method?
+          end
+
           return false unless send_node.comparison_method?
-          return false unless (node = send_node.parent)
 
-          (node.respond_to?(:logical_operator?) && node.logical_operator?) ||
-            (node.respond_to?(:comparison_method?) && node.comparison_method?)
+          parent_range = parent.source_range
+          return false unless parent_range
+          return false if source_range.begin_pos < parent_range.begin_pos
+          return false if source_range.end_pos > parent_range.end_pos
+
+          receiver = send_node.receiver
+          selector = loc.selector
+          if receiver && selector
+            receiver_range = receiver.source_range
+            return false unless receiver_range
+            return false if receiver_range.end_pos > selector.begin_pos
+            return false unless selector.source_buffer.equal?(range_buffer)
+          end
+
+          (parent.respond_to?(:logical_operator?) && parent.logical_operator?) ||
+            (parent.respond_to?(:comparison_method?) && parent.comparison_method?)
         end
+        # rubocop:enable Metrics/AbcSize, Metrics/CyclomaticComplexity, Metrics/PerceivedComplexity, Metrics/MethodLength
       end
     end
   end
