+    /**
+     * Return the given date, or build a now instance aligned with the provided timezone.
+     */
+    public function resolveTimezoneDate(CarbonTimeZone $timezone, ?DateTimeInterface $date): DateTimeInterface
+    {
+        if ($date) {
+            return $date;
+        }
+
+        $dateClass = $this->dateClass;
+        $tzName = $timezone->getName();
+        $clock = $timezone->getClock();
+        $innerClock = $clock?->unwrap();
+        $factory = $innerClock instanceof Factory ? $innerClock : ($clock?->getFactory() ?? FactoryImmutable::getDefaultInstance());
+        $className = $factory->getClassName();
+        $creator = is_a($dateClass, $className, true) ? $dateClass : $className;
+        $now = $clock?->now() ?? $dateClass::now($tzName);
+        $carbon = $now instanceof CarbonInterface ? $now : $creator::instance($now);
+        $language = new Language($carbon->locale);
+        $resolved = $creator::create(
+            $carbon->year,
+            $carbon->month,
+            $carbon->day,
+            $carbon->hour,
+            $carbon->minute,
+            $carbon->second,
+            $carbon->tzName,
+        ) ?? $carbon;
+
+        return $resolved->locale($language->getId())->setTimezone($tzName);
+    }
+
