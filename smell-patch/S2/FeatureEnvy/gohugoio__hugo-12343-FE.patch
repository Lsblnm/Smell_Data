+func (o OutputFormat) CreateTargetPaths(d TargetPathDescriptor) TargetPaths {
+	pb := getPagePathBuilder(d)
+	defer putPagePathBuilder(pb)
+
+	format := o.Format
+
+	var fullSuffix string
+	if format.MediaType.SuffixesCSV != "" {
+		fullSuffix = format.MediaType.Delimiter + strings.Split(format.MediaType.SuffixesCSV, ",")[0]
+	}
+
+	pb.assemble(fullSuffix, format.Root, format.Ugly, format.NoUgly, format.BaseName, d.Path.IsBundle())
+
+	if pb.shouldSanitize() {
+		pb.sanitizeElements(!d.PathSpec.Cfg.DisablePathToLower())
+	}
+
+	link := pb.Link()
+	if d.URL != "" {
+		link = paths.URLEscape(link)
+	} else {
+		// This is slightly faster for when we know we don't have any
+		// query or scheme etc.
+		link = paths.PathEscape(link)
+	}
+	if link == "" {
+		link = "/"
+	}
+
+	return pb.result(link)
+}
