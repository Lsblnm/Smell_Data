+struct jq_cli {
+  int dumpopts;
+};
+
+static int jq_cli_apply_colors(struct jq_cli *cli, jq_state *jq,
+                               jq_util_input_state *input, const char *c,
+                               int parser_flags) {
+  int slurp = (options & SLURP) ? 1 : 0;
+  int colors_ok = 1;
+  jv_parser *parser = NULL;
+
+  if (c != NULL) {
+    const char *e;
+    size_t i;
+
+    jq_colors.active = jq_default_colors;
+    memset(jq_colors.bufs, 0, sizeof(jq_colors.bufs));
+    for (i = 0; i < sizeof(jq_default_colors) / sizeof(jq_default_colors[0]); i++)
+      jq_colors.bufps[i] = jq_default_colors[i];
+    for (i = 0; i < sizeof(jq_default_colors) / sizeof(jq_default_colors[0]) && *c != '\0'; i++, c = e) {
+      if ((e = strchr(c, ':')) == NULL)
+        e = c + strlen(c);
+      if ((size_t)(e - c) > sizeof(jq_colors.bufs[i]) - 4)
+        colors_ok = 0;
+      else {
+        jq_colors.bufs[i][0] = '\033';
+        jq_colors.bufs[i][1] = '[';
+        (void) strncpy(&jq_colors.bufs[i][2], c, e - c);
+        if (strspn(&jq_colors.bufs[i][2], "0123456789;") < strlen(&jq_colors.bufs[i][2]))
+          colors_ok = 0;
+        else {
+          jq_colors.bufs[i][2 + (e - c)] = 'm';
+          jq_colors.bufps[i] = jq_colors.bufs[i];
+          if (e[0] == ':')
+            e++;
+        }
+      }
+      if (!colors_ok)
+        break;
+    }
+    if (colors_ok)
+      jq_colors.active = jq_colors.bufps;
+  }
+
+  if (options & SEQ)
+    parser_flags |= JV_PARSE_SEQ;
+  if (!(options & RAW_INPUT))
+    parser = jv_parser_new(parser_flags);
+  jq_util_input_set_parser(input, parser, slurp);
+  if (parser == NULL && slurp)
+    assert(jv_get_kind(input->slurped) == JV_KIND_STRING);
+  else if (slurp)
+    assert(jv_get_kind(input->slurped) == JV_KIND_ARRAY);
+  else
+    assert(!jv_is_valid(input->slurped));
+
+  if (input->nfiles == 0)
+    jq_util_input_add_input(input, "-");
+
+  if (jq->bc && jq->bc->code && jq->bc->globals &&
+      jq->bc->globals->ncfunctions >= 0)
+    jq_set_debug_cb(jq, debug_cb, &cli->dumpopts);
+
+  return colors_ok;
+}
