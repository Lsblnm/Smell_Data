diff --git a/lib/fpm/package/deb.rb b/lib/fpm/package/deb.rb
index 93d9e4d..e8f7889 100644
--- a/lib/fpm/package/deb.rb
+++ b/lib/fpm/package/deb.rb
@@ -652,6 +652,40 @@ class FPM::Package::Deb < FPM::Package
     end # if deb_generate_changes
   end # def output
 
+  def apply_command_metadata(command)
+    workdir = attributes[:workdir]
+    logger.level = :warn
+    logger.level = :info if command.verbose?
+    logger.level = :debug if command.debug?
+    if command.log_level
+      logger.level = command.log_level.to_sym
+    end
+
+    logger.info("Setting workdir", :workdir => command.workdir || workdir)
+    ENV["TMP"] = command.workdir || workdir
+
+    validator = FPM::Command::Validator.new(command)
+    if !validator.ok?
+      validator.messages.each do |message|
+        logger.warn(message)
+      end
+
+      logger.fatal("Fix the above problems, and you'll be rolling packages in no time!")
+      return nil
+    end
+
+    input = yield
+
+    name_option = command.class.declared_options.find { |option| option.attribute_name == "name" }
+    default_name = name_option && name_option.default_value
+    if input.name.nil? || command.name != default_name
+      logger.info("Setting from flags: name=#{command.name}")
+      input.name = command.name
+    end
+    input.provides += command.provides
+    return input
+  end # def apply_command_metadata
+
   def converted_from(origin)
     self.dependencies = self.dependencies.collect do |dep|
       fix_dependency(dep)
@@ -1104,5 +1138,5 @@ class FPM::Package::Deb < FPM::Package
