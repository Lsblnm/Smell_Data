diff --git a/lib/fluent/rpc.rb b/lib/fluent/rpc.rb
index 53b899ad..afea5e89 100644
--- a/lib/fluent/rpc.rb
+++ b/lib/fluent/rpc.rb
@@ -33,6 +33,104 @@ module Fluent
         )
       end
 
+      def run_rpc_server(supervisor)
+        log = @log
+        endpoint = supervisor.instance_variable_get(:@rpc_endpoint)
+        enable_dump = supervisor.instance_variable_get(:@enable_get_dump)
+
+        engine = Fluent::Engine
+        sys = engine.system_config
+        log_section = sys.log
+        conf_elem = sys.config
+
+        worker_count = sys.workers
+        configured_level = sys.log_level
+        json_logs = log.format == :json || (log_section && log_section.format == :json)
+        time_fmt = log.time_format
+        conf_name = conf_elem.name if conf_elem
+        supervisor_proc = engine.supervisor_mode
+
+        log.debug "starting RPC services",
+                  endpoint: endpoint,
+                  workers: worker_count,
+                  log_level: configured_level,
+                  current_level: log.level,
+                  json: json_logs,
+                  time_format: time_fmt,
+                  conf: conf_name,
+                  supervisor: supervisor_proc
+
+        # built-in RPC for signals
+        mount_proc('/api/processes.interruptWorkers') { |req, res|
+          log.debug "fluentd RPC got /api/processes.interruptWorkers request", workers: worker_count
+          Process.kill :INT, $$
+          nil
+        }
+        mount_proc('/api/processes.killWorkers') { |req, res|
+          log.debug "fluentd RPC got /api/processes.killWorkers request", workers: worker_count
+          Process.kill :TERM, $$
+          nil
+        }
+        mount_proc('/api/processes.flushBuffersAndKillWorkers') { |req, res|
+          log.debug "fluentd RPC got /api/processes.flushBuffersAndKillWorkers request", workers: worker_count
+          if Fluent.windows?
+            supervisor.supervisor_sigusr1_handler
+            supervisor.stop(true)
+          else
+            Process.kill :USR1, $$
+            Process.kill :TERM, $$
+          end
+          nil
+        }
+        mount_proc('/api/plugins.flushBuffers') { |req, res|
+          log.debug "fluentd RPC got /api/plugins.flushBuffers request", workers: worker_count
+          if Fluent.windows?
+            supervisor.supervisor_sigusr1_handler
+          else
+            Process.kill :USR1, $$
+          end
+          nil
+        }
+        mount_proc('/api/config.reload') { |req, res|
+          log.debug "fluentd RPC got /api/config.reload request", conf: conf_name
+          if Fluent.windows?
+            # restart worker with auto restarting by killing
+            supervisor.kill_worker
+          else
+            Process.kill :HUP, $$
+          end
+          nil
+        }
+        mount_proc('/api/config.dump') { |req, res|
+          log.debug "fluentd RPC got /api/config.dump request", conf: conf_name
+          log.info "dump in-memory config"
+          supervisor.supervisor_dump_config_handler
+          nil
+        }
+
+        mount_proc('/api/config.gracefulReload') { |req, res|
+          log.debug "fluentd RPC got /api/config.gracefulReload request", conf: conf_name
+          if Fluent.windows?
+            supervisor.supervisor_sigusr2_handler
+          else
+            Process.kill :USR2, $$
+          end
+
+          nil
+        }
+
+        if enable_dump
+          mount_proc('/api/config.getDump') { |req, res|
+            log.debug "fluentd RPC got /api/config.getDump request", conf: conf_name
+            log.info "get dump in-memory config via HTTP"
+            res.body = supervisor.supervisor_get_dump_config_handler
+            [nil, nil, res]
+          }
+        end
+
+        start
+      end
+
       def mount(path, servlet, *args)
         @server.mount(path, servlet, *args)
         @log.debug "register #{path} RPC servlet"
