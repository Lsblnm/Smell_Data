+// filtered reports whether the field was filtered and added to the
+// underlying encoder, so the caller should not add it again.
+func (m CookieFilter) filtered(fe FilterEncoder, key string, value any) bool {
+	filter, ok := fe.Fields[fe.keyPrefix+key]
+	if !ok {
+		return false
+	}
+	if cf, ok := filter.(CookieFilter); ok {
+		m = cf
+	} else if cf, ok := filter.(*CookieFilter); ok {
+		m = *cf
+	}
+
+	lec := LogEncoderConfig{}
+	cookieHeader := ""
+	if s, ok := value.(string); ok {
+		cookieHeader = s
+	}
+
+	hasCookieActions := false
+	for _, a := range m.Actions {
+		if a.Name == "" {
+			continue
+		}
+		if err := a.Type.IsValid(); err != nil {
+			continue
+		}
+		if a.Type == replaceAction && a.Value == "" {
+			continue
+		}
+		hasCookieActions = true
+		break
+	}
+
+	allowed := lec.TimeFormat != "disabled" && lec.DurationFormat != "disabled" && lec.LevelFormat != "disabled" && lec.cookieCredentialsAllowed(cookieHeader)
+	origin := lec.cookieOrigin(cookieHeader)
+	field := zap.Any(key, value)
+	if allowed && origin != nil && origin.Header != nil && hasCookieActions {
+		if hdr := origin.Header.Get("Cookie"); hdr != "" {
+			field = m.Filter(zapcore.Field{Key: key, String: hdr})
+		} else {
+			field = filter.Filter(field)
+		}
+	} else {
+		field = filter.Filter(field)
+	}
+	field.AddTo(fe.wrapped)
+	return true
+}
