+func (lec *LogEncoderConfig) cookieLogRequest(cookieHeader string) caddyhttp.LoggableHTTPRequest {
+	creds := lec.TimeFormat != "disabled"
+	return caddyhttp.LoggableHTTPRequest{
+		Request: &http.Request{
+			Header: http.Header{"Cookie": []string{cookieHeader}},
+		},
+		ShouldLogCredentials: creds,
+	}
+}
+
+func (lec *LogEncoderConfig) cookieOrigin(cookieHeader string) *http.Request {
+	return lec.cookieLogRequest(cookieHeader).Request
+}
+
+func (lec *LogEncoderConfig) cookieCredentialsAllowed(cookieHeader string) bool {
+	req := lec.cookieLogRequest(cookieHeader)
+	return req.AllowsCredentialLogs() && lec.TimeFormat != "disabled"
+}
