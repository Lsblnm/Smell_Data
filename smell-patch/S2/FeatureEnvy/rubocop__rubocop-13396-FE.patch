diff --git a/lib/rubocop/cop/style/redundant_parentheses.rb b/lib/rubocop/cop/style/redundant_parentheses.rb
index ccf0a8030..d13d51fc1 100644
--- a/lib/rubocop/cop/style/redundant_parentheses.rb
+++ b/lib/rubocop/cop/style/redundant_parentheses.rb
@@ -186,10 +186,55 @@ module RuboCop
 
           return unless method_call_with_redundant_parentheses?(node)
           return if call_chain_starts_with_int?(begin_node, node)
+          return if require_parentheses?(begin_node.parent || begin_node, node)
 
           offense(begin_node, 'a method call')
         end
 
+        def require_parentheses?(node, condition_body)
+          config = @config
+          return false unless config
+
+          ruby_version = config.target_ruby_version
+          return false if ruby_version < 2.0
+
+          node_parent = node.parent
+          node_loc = node.loc
+          return false unless node_loc
+
+          expression = node_loc.expression
+          return false unless expression
+
+          begin_pos = expression.begin_pos
+          end_pos = expression.end_pos
+          source = expression.source
+          return false if begin_pos.negative? || end_pos < begin_pos || source.nil?
+
+          return false unless node.while_type? || node.until_type?
+          return false unless condition_body
+          return false if node_parent.equal?(condition_body)
+
+          block_node = (condition_body if condition_body.block_type? || condition_body.numblock_type?)
+          return false unless block_node
+
+          send_node = block_node.send_node
+          block_body = block_node.body
+          return false unless send_node
+          return false if block_body.equal?(node)
+
+          receiver = send_node.receiver
+          method_name = send_node.method_name
+          arguments = send_node.arguments
+          return false if method_name.nil?
+          return false unless arguments
+          return false unless receiver.nil? || node_parent.nil? || !node_parent.equal?(send_node)
+
+          method_name_source = method_name.to_s
+          return false unless method_name_source.match?(/\A\W/) || source.include?(method_name_source)
+
+          send_node.block_literal? && block_node.keywords?
+        end
+
         def check_unary(begin_node, node)
           return if begin_node.chained?
 
