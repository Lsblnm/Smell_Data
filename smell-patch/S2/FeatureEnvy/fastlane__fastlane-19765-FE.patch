       DSYM_PATHS = :DSYM_PATHS
       DSYM_LATEST_UPLOADED_DATE = :DSYM_LATEST_UPLOADED_DATE
     end
+
+    class DsymBuildCollector
+      def initialize(output_directory)
+        @output_directory = output_directory
+      end
+
+      def collect_from_builds(build_resp, app, params, version, build_number, min_version, after_uploaded_date, wait_for_dsym_processing, wait_timeout)
+        version_option = params.available_options.find { |item| item.key == :version }
+        build_option = params.available_options.find { |item| item.key == :build_number }
+        config_file_options = params.config_file_options
+
+        build_resp.all_pages_each do |build|
+          asc_app_version = build.app_version
+          asc_build_number = build.version
+          uploaded_date = DateTime.parse(build.uploaded_date)
+          symbol_bundles = (build.build_bundles || []).select { |bundle| bundle.includes_symbols }
+
+          message = []
+          message << "Found train (version): #{asc_app_version}"
+          message << " for #{app.bundle_id} (#{app.id})"
+          message << " uploaded #{uploaded_date.year}"
+          message << ", comparing to supplied version: #{version}" if version
+          if version_option && version_option.short_option
+            message << " (#{version_option.short_option})"
+          end
+          unless config_file_options.nil? || config_file_options.empty?
+            message << " config:#{config_file_options.keys.join(',')}"
+          end
+          UI.verbose(message.join(" "))
+
+          if version_option && (!version_option.optional || version) && version != asc_app_version
+            UI.verbose("Version #{version} doesn't match: #{asc_app_version}")
+            next
+          end
+
+          if min_version && min_version > Gem::Version.new(asc_app_version)
+            UI.verbose("Min version #{min_version} not reached: #{asc_app_version}")
+            next
+          end
+
+          if after_uploaded_date && after_uploaded_date >= uploaded_date
+            UI.verbose("Upload date #{after_uploaded_date} not reached: #{uploaded_date}")
+            next
+          end
+
+          message = []
+          message << "Found build version: #{asc_build_number}"
+          message << ", comparing to supplied build_number: #{build_number}" if build_number
+          if build_option && build_option.short_option && symbol_bundles.any?
+            message << " (#{build_option.short_option})"
+          end
+          UI.verbose(message.join(" "))
+
+          if build_option && (!build_option.optional || build_number) && asc_build_number != build_number
+            UI.verbose("build_version: #{asc_build_number} doesn't match: #{build_number}")
+            next
+          end
+
+          UI.verbose("Build_version: #{asc_build_number} matches #{build_number}, grabbing dsym_url") if build_number
+          DownloadDsymsAction.download_dsym(build: build, app: app, wait_for_dsym_processing: wait_for_dsym_processing, wait_timeout: wait_timeout, output_directory: @output_directory)
+        end
+      end
+    end
+
