+      def on_request(path_info, params, input)
+        begin
+          path = path_info[1..-1]  # remove /
+          tag = path.split('/').join('.')
+
+          json_parser = input.parser_json
+          msgpack_parser = input.parser_msgpack
+          json_time_key = json_parser && json_parser.time_key
+          json_estimate_current = json_parser && json_parser.estimate_current_event
+          msgpack_time_key = msgpack_parser && msgpack_parser.time_key
+          msgpack_estimate_current = msgpack_parser && msgpack_parser.estimate_current_event
+          dump_errors = input.dump_error_log
+          error_logging = dump_errors && @log.level <= Fluent::Log::LEVEL_ERROR
+
+          mes = Fluent::MultiEventStream.new
+          input.parse_params(params) do |record_time, record|
+            if record.nil?
+              @log.debug { "incoming event is invalid: path=#{path_info} params=#{params.to_json}" }
+              next
+            end
+
+            input.send(:add_params_to_record, record, params)
+
+            payload_time_key, payload_estimate = if params['msgpack']
+                                                   [msgpack_time_key, msgpack_estimate_current]
+                                                 elsif params['json'] || params['ndjson']
+                                                   [json_time_key, json_estimate_current]
+                                                 end
+
+            time = if param_time = params['time']
+                     param_time = param_time.to_f
+                     param_time.zero? ? Fluent::EventTime.now : input.float_time_parser.parse(param_time)
+                   elsif payload_time_key
+                     if record_time
+                       record_time
+                     elsif payload_estimate
+                       Fluent::EventTime.now
+                     else
+                       input.send(:convert_time_field, record)
+                     end
+                   elsif json_parser || msgpack_parser
+                     input.send(:convert_time_field, record)
+                   else
+                     record_time.nil? ? input.send(:convert_time_field, record) : record_time
+                   end
+
+            mes.add(time, record)
+          end
+        rescue => e
+          if error_logging
+            @log.error "failed to process request", error: e
+          end
+          return [RES_400_STATUS, RES_TEXT_HEADER, "400 Bad Request\n#{e}\n"]
+        end
+
+        # TODO server error
+        begin
+          unless mes.time_array.empty? || mes.record_array.empty?
+            input.emit_parsed_events(tag, mes)
+          end
+        rescue => e
+          if error_logging
+            @log.error "failed to emit data", error: e
+          end
+          return [RES_500_STATUS, RES_TEXT_HEADER, "500 Internal Server Error\n#{e}\n"]
+        end
+
+        if input.respond_with_empty_img
+          return RESPONSE_IMG
+        else
+          if input.use_204_response
+            return RESPONSE_204
+          else
+            return RESPONSE_200
+          end
+        end
+      end
