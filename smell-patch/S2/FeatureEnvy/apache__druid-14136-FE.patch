@@ -27,7 +39,98 @@ package org.apache.druid.timeline;
 public enum Partitions
 {
   /** Specifies that only complete partitions should be considered. */
-  ONLY_COMPLETE,
+  ONLY_COMPLETE(false),
   /** Specifies that complete as well as incomplete partitions should be considered. */
-  INCOMPLETE_OK
+  INCOMPLETE_OK(true);
+
+  private final boolean incompleteOk;
+
+  Partitions(boolean incompleteOk)
+  {
+    this.incompleteOk = incompleteOk;
+  }
+
+  /**
+   * Looks up timeline objects covering {@code interval}. Complete-only vs incomplete partitions are selected
+   * according to this enum value.
+   */
+  <VersionType, ObjectType extends Overshadowable<ObjectType>> List<TimelineObjectHolder<VersionType, ObjectType>> lookup(
+      VersionedIntervalTimeline<VersionType, ObjectType> versionedTimeline,
+      Interval interval,
+      boolean skipObjectsWithNoData
+  )
+  {
+    List<TimelineObjectHolder<VersionType, ObjectType>> retVal = new ArrayList<>();
+    final NavigableMap<Interval, VersionedIntervalTimeline<VersionType, ObjectType>.TimelineEntry> timeline;
+    if (incompleteOk) {
+      timeline = versionedTimeline.getIncompletePartitionsTimeline();
+    } else {
+      timeline = versionedTimeline.getCompletePartitionsTimeline();
+    }
+
+    for (Entry<Interval, VersionedIntervalTimeline<VersionType, ObjectType>.TimelineEntry> entry : timeline.entrySet()) {
+      Interval timelineInterval = entry.getKey();
+      VersionedIntervalTimeline<VersionType, ObjectType>.TimelineEntry val = entry.getValue();
+      PartitionHolder<ObjectType> partitionHolder = val.getPartitionHolder();
+      boolean holderHasData = false;
+      for (PartitionChunk<ObjectType> chunk : partitionHolder) {
+        if (chunk.getObject().hasData()) {
+          holderHasData = true;
+          break;
+        }
+      }
+
+      // exclude empty partition holders (i.e. tombstones) since they do not add value
+      // for higher level code...they have no data rows...
+      if ((!skipObjectsWithNoData || holderHasData) && timelineInterval.overlaps(interval)) {
+        retVal.add(
+            new TimelineObjectHolder<>(
+                timelineInterval,
+                val.getTrueInterval(),
+                val.getVersion(),
+                PartitionHolder.copyWithOnlyVisibleChunks(partitionHolder)
+            )
+        );
+      }
+    }
+
+    if (retVal.isEmpty()) {
+      return retVal;
+    }
+
+    TimelineObjectHolder<VersionType, ObjectType> firstEntry = retVal.get(0);
+    Interval firstInterval = firstEntry.getInterval();
+    if (interval.overlaps(firstInterval) && interval.getStart().isAfter(firstInterval.getStart())) {
+      DateTime trimmedStart = JodaUtils.maxDateTime(
+          JodaUtils.maxDateTime(interval.getStart(), firstInterval.getStart()),
+          DateTimes.MIN
+      );
+      retVal.set(
+          0,
+          new TimelineObjectHolder<>(
+              new Interval(trimmedStart, firstInterval.getEnd()),
+              firstEntry.getTrueInterval(),
+              firstEntry.getVersion(),
+              firstEntry.getObject()
+          )
+      );
+    }
+
+    TimelineObjectHolder<VersionType, ObjectType> lastEntry = retVal.get(retVal.size() - 1);
+    Interval lastInterval = lastEntry.getInterval();
+    if (interval.overlaps(lastInterval) && interval.getEnd().isBefore(lastInterval.getEnd())) {
+      DateTime trimmedEnd = JodaUtils.minDateTime(interval.getEnd(), lastInterval.getEnd());
+      retVal.set(
+          retVal.size() - 1,
+          new TimelineObjectHolder<>(
+              new Interval(lastInterval.getStart(), trimmedEnd),
+              lastEntry.getTrueInterval(),
+              lastEntry.getVersion(),
+              lastEntry.getObject()
+          )
+      );
+    }
+
+    return retVal;
+  }
 }
