+    def detect_device(platform)
+      screenshot = Frameit::Screenshot.allocate
+      screenshot.size = FastImage.size(self.path)
+      editor = Frameit::Editor.new(screenshot, {}, false)
+      size = editor.screenshot.size
+
+      UI.user_error!("Could not find or parse file at path '#{self.path}'") if size.nil? || size.count == 0
+
+      found_device = nil
+      filename_device = nil
+      filename = Pathname.new(self.path).basename.to_s
+      Frameit::Devices.constants.each do |c|
+        device = Frameit::Devices.const_get(c)
+        next unless device.resolutions.include?(size)
+        name_token = device.formatted_name.gsub("Apple", "").strip
+        matches_filename = filename.include?(name_token) || filename.include?(device.id)
+        option = Frameit::Options.available_options.find { |item| item.key == device.priority_config_key }
+        effective_priority = if option && Frameit.config[option.key]
+                               Frameit::Device::REQUIRED_PRIORITY
+                             else
+                               device.priority
+                             end
+        # assign to filename_device if the filename contains the formatted name / id and its priority is higher than the current filename_device
+        filename_device = device if matches_filename && (filename_device.nil? || filename_device.priority < effective_priority)
+        next unless (device.platform == platform || platform == Frameit::Platform::ANY) && (found_device.nil? || effective_priority > found_device.priority)
+        found_device = device
+      end
+
+      return filename_device if filename_device
+      return found_device if found_device
+
+      mismatch = AppScreenshotValidator::ValidationError.new(
+        type: AppScreenshotValidator::ValidationError::INVALID_SCREEN_SIZE,
+        path: self.path,
+        debug_info: size
+      )
+      UI.user_error!("Unsupported screen size #{mismatch.debug_info} for path '#{mismatch.path}'")
+      return nil
+    end
+
