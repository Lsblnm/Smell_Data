+
+#[derive(Debug, Clone)]
+pub struct PathExpansion {
+    relative_to: PathBuf,
+    expand_tilde: bool,
+    home: HomeContext,
+}
+
+impl PathExpansion {
+    pub fn for_parent(path: &Path) -> Self {
+        let relative_to = path
+            .parent()
+            .map(|parent| parent.to_path_buf())
+            .unwrap_or_else(|| path.to_path_buf());
+        let home = HomeContext::current();
+        let expand_tilde = home.home_path().is_some();
+        Self {
+            relative_to,
+            expand_tilde,
+            home,
+        }
+    }
+
+    pub fn for_parent_light(path: &Path) -> Self {
+        let relative_to = path
+            .parent()
+            .map(|parent| parent.to_path_buf())
+            .unwrap_or_else(|| path.to_path_buf());
+        Self {
+            relative_to,
+            expand_tilde: true,
+            home: HomeContext::empty(),
+        }
+    }
+
+    pub fn relative_to(&self) -> &Path {
+        &self.relative_to
+    }
+
+    pub fn expand_tilde(&self) -> bool {
+        self.expand_tilde
+    }
+
+    pub fn expand(&self, path: impl AsRef<Path>) -> PathBuf {
+        let expand_tilde = self.expand_tilde && self.home.home_path().is_some();
+        expand_path_with(path, &self.relative_to, expand_tilde)
+    }
+}
