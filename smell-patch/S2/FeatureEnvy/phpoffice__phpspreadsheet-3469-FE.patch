+    /**
+     * Get the correct Worksheet and coordinate from a coordinate that may
+     * contain a reference to another sheet or a named range.
+     *
+     * @return array{0: \PhpOffice\PhpSpreadsheet\Worksheet\Worksheet, 1: string}
+     */
+    public function getWorksheetAndCoordinate(\PhpOffice\PhpSpreadsheet\Worksheet\Worksheet $worksheet, string $coordinate): array
+    {
+        $sheet = null;
+        $finalCoordinate = null;
+
+        // Worksheet reference?
+        if (strpos($coordinate, '!') !== false) {
+            $worksheetReference = \PhpOffice\PhpSpreadsheet\Worksheet\Worksheet::extractSheetTitle($coordinate, true);
+
+            $sheet = $worksheet->getParentOrThrow()->getSheetByName($worksheetReference[0]);
+            $finalCoordinate = strtoupper($worksheetReference[1]);
+
+            if ($sheet === null) {
+                throw new \PhpOffice\PhpSpreadsheet\Exception('Sheet not found for name: ' . $worksheetReference[0]);
+            }
+        } elseif (
+            !preg_match('/^' . \PhpOffice\PhpSpreadsheet\Calculation\Calculation::CALCULATION_REGEXP_CELLREF . '$/i', $coordinate) &&
+            preg_match('/^' . \PhpOffice\PhpSpreadsheet\Calculation\Calculation::CALCULATION_REGEXP_DEFINEDNAME . '$/iu', $coordinate)
+        ) {
+            // Named range?
+            $namedRange = \PhpOffice\PhpSpreadsheet\DefinedName::resolveName($coordinate, $worksheet);
+            if ($namedRange !== null && $namedRange->isFormula()) {
+                $namedRange = null;
+            }
+            if ($namedRange !== null && $namedRange->getLocalOnly()) {
+                $rangeWorksheet = $namedRange->getWorksheet();
+                if ($rangeWorksheet === null || $worksheet->getHashCode() !== $rangeWorksheet->getHashCode()) {
+                    $namedRange = null;
+                }
+            }
+            if ($namedRange !== null) {
+                $sheet = $namedRange->getWorksheet();
+                if ($sheet === null) {
+                    throw new \PhpOffice\PhpSpreadsheet\Exception('Sheet not found for named range: ' . $namedRange->getName());
+                }
+
+                /** @phpstan-ignore-next-line */
+                $cellCoordinate = ltrim(substr($namedRange->getValue(), strrpos($namedRange->getValue(), '!')), '!');
+                $finalCoordinate = str_replace('$', '', $cellCoordinate);
+            }
+        }
+
+        if ($sheet === null || $finalCoordinate === null) {
+            $sheet = $worksheet;
+            $finalCoordinate = strtoupper($coordinate);
+        }
+
+        if (Coordinate::coordinateIsRange($finalCoordinate)) {
+            throw new \PhpOffice\PhpSpreadsheet\Exception('Cell coordinate string can not be a range of cells.');
+        } elseif (strpos($finalCoordinate, '$') !== false) {
+            throw new \PhpOffice\PhpSpreadsheet\Exception('Cell coordinate must not be absolute.');
+        }
+
+        $requestWorkbook = $worksheet->getParent();
+        if ($this->isSupervisor && $requestWorkbook !== null) {
+            $activeSheet = $requestWorkbook->getSheet($requestWorkbook->getActiveSheetIndex());
+            if (
+                strcasecmp((string) $sheet->getTitle(), (string) $activeSheet->getTitle()) === 0
+                && $sheet->getParentOrThrow()->getID() === $requestWorkbook->getID()
+            ) {
+                $sheet = $activeSheet;
+            }
+        }
+
+        [, $rowNumber, $columnName] = Coordinate::indexesFromString($finalCoordinate);
+        $rowDimensions = $sheet->getRowDimensions();
+        $columnDimensions = $sheet->getColumnDimensions();
+        $rowDimension = $rowDimensions[$rowNumber] ?? null;
+        $columnDimension = $columnDimensions[$columnName] ?? null;
+        if ($rowDimension !== null && $rowDimension->getRowIndex() !== null) {
+            $rowNumber = $rowDimension->getRowIndex();
+        }
+        if ($columnDimension !== null && $columnDimension->getColumnIndex() !== null) {
+            $columnName = $columnDimension->getColumnIndex();
+        }
+
+        $cellCollection = $sheet->getCellCollection();
+        if ($cellCollection->has($finalCoordinate)) {
+            $cell = $cellCollection->get($finalCoordinate);
+            if ($cell !== null) {
+                $columnName = $cell->getColumn();
+                if ($cell->getXfIndex() > 0 && $rowDimension !== null && $rowDimension->getRowIndex() !== null) {
+                    $rowNumber = $rowDimension->getRowIndex();
+                }
+            }
+        }
+
+        $finalCoordinate = $columnName . $rowNumber;
+
+        return [$sheet, $finalCoordinate];
+    }
