--- a/include/fmt/core.h
+++ b/include/fmt/core.h
@@ -2219,6 +2219,13 @@ template <typename Char> struct dynamic_spec {
 
 struct auto_id {};
 
+// Appends a prefix character sequence encoded in value to prefix. The highest
+// byte of prefix stores the encoded size.
+FMT_CONSTEXPR inline void prefix_append(unsigned& prefix, unsigned value) {
+  prefix |= prefix != 0 ? value << 8 : value;
+  prefix += (1u + (value > 0xff ? 1 : 0)) << 24;
+}
+
 // A format specifier handler that sets fields in basic_format_specs.
 template <typename Char> class specs_setter {
  protected:
@@ -2247,6 +2254,47 @@ template <typename Char> class specs_setter {
   FMT_CONSTEXPR void end_precision() {}
 
   FMT_CONSTEXPR void on_type(presentation_type type) { specs_.type = type; }
+
+  // Applies alternate-form prefixes and numeric/precision padding for integers.
+  template <typename IntData, typename IntArg>
+  FMT_CONSTEXPR void apply_int_padding(IntData& data, IntArg& arg, int num_digits,
+                                       locale_ref loc) {
+    if (specs_.alt) {
+      if (specs_.type == presentation_type::hex_upper) {
+        prefix_append(arg.prefix, unsigned('X') << 8 | '0');
+      } else if (specs_.type == presentation_type::hex_lower) {
+        prefix_append(arg.prefix, unsigned('x') << 8 | '0');
+      } else if (specs_.type == presentation_type::bin_upper) {
+        prefix_append(arg.prefix, unsigned('B') << 8 | '0');
+      } else if (specs_.type == presentation_type::bin_lower) {
+        prefix_append(arg.prefix, unsigned('b') << 8 | '0');
+      } else if (specs_.type == presentation_type::oct &&
+                 specs_.precision <= num_digits && arg.abs_value != 0) {
+        prefix_append(arg.prefix, '0');
+      }
+    }
+
+    unsigned prefix_size = arg.prefix >> 24;
+    auto fill_size = specs_.fill.size();
+    Char fill0 = specs_.fill[0];
+    bool locale_grouping = static_cast<bool>(loc) && specs_.localized;
+    data.size = prefix_size + to_unsigned(num_digits);
+    data.padding = 0;
+    if (locale_grouping || fill0 == Char(' ')) {
+      data.size = prefix_size + to_unsigned(num_digits);
+    }
+
+    if (specs_.align == align::numeric && fill_size > 0) {
+      auto width = to_unsigned(specs_.width);
+      if (width > data.size) {
+        data.padding = width - data.size;
+        data.size = width;
+      }
+    } else if (specs_.precision > num_digits) {
+      data.size = prefix_size + to_unsigned(specs_.precision);
+      data.padding = to_unsigned(specs_.precision - num_digits);
+    }
+  }
 };
 
