diff --git a/lib/jekyll/drops/document_drop.rb b/lib/jekyll/drops/document_drop.rb
index fef5920be..1fb6f6d8e 100644
--- a/lib/jekyll/drops/document_drop.rb
+++ b/lib/jekyll/drops/document_drop.rb
@@ -65,6 +65,90 @@ module Jekyll
           result[key] = doc[key] unless NESTED_OBJECT_FIELD_BLACKLIST.include?(key)
         end
       end
+
+      def read_source(opts = {}, load_content = true)
+        document = @obj
+        site = document.site
+        collection = document.collection
+        logger = Jekyll.logger
+
+        if load_content
+          if logger.writer.level <= ::Logger::DEBUG
+            logger.debug "Reading:", document.relative_path
+          end
+
+          if Document::YAML_FILE_EXTS.include?(File.extname(document.path))
+            document.instance_variable_set(:@data, SafeYAML.load_file(document.path))
+            return
+          end
+        end
+
+        populate = lambda do
+          if load_content
+            defaults = site.frontmatter_defaults.all(
+              document.relative_path,
+              collection.label.to_sym
+            )
+            unless defaults.empty?
+              document.merge_data!(defaults, :source => "front matter defaults")
+            end
+
+            document.content = File.read(
+              document.path,
+              **Utils.merged_file_read_opts(site, opts)
+            )
+            if document.content =~ Document::YAML_FRONT_MATTER_REGEXP
+              document.content = Regexp.last_match.post_match
+              data_file = SafeYAML.load(Regexp.last_match(1))
+              if data_file
+                document.merge_data!(data_file, :source => "YAML front matter")
+              end
+            end
+          end
+
+          slug = nil
+          ext = nil
+          if document.relative_path =~ Document::DATE_FILENAME_MATCHER
+            date, slug, ext = Regexp.last_match.captures
+            if !document.data["date"] || document.data["date"].to_i == site.time.to_i
+              document.merge_data!({ "date" => date }, :source => "filename")
+            end
+          elsif document.relative_path =~ Document::DATELESS_FILENAME_MATCHER
+            slug, ext = Regexp.last_match.captures
+          end
+          # Documents without an extension leave `slug` nil; use the path basename.
+          slug ||= File.basename(document.path, ".*")
+          slug.gsub!(%r!\.*\z!, "")
+          document.data["title"] ||= Utils.titleize_slug(slug)
+          document.data["slug"]  ||= slug
+          document.data["ext"]   ||= ext
+
+          document.populate_categories
+          document.populate_tags
+          document.data["excerpt"] ||= Jekyll::Excerpt.new(document) if document.generate_excerpt?
+        end
+
+        if load_content
+          begin
+            populate.call
+          rescue StandardError => error
+            if error.is_a? Psych::SyntaxError
+              logger.error "Error:",
+                           "YAML Exception reading #{document.path}: #{error.message}"
+            else
+              logger.error "Error:",
+                           "could not read file #{document.path}: #{error.message}"
+            end
+
+            if site.config["strict_front_matter"] || error.is_a?(Jekyll::Errors::FatalException)
+              raise error
+            end
+          end
+        else
+          populate.call
+        end
+      end
+      private :read_source
     end
   end
 end
