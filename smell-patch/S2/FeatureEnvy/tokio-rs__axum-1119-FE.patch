+
+    pub(super) fn call_unmatched(
+        &mut self,
+        err: MatchError,
+        req: Request<B>,
+    ) -> RouteFuture<B, E> {
+        let path = if let Some(path_and_query) = req.uri().path_and_query() {
+            path_and_query.path().to_owned()
+        } else {
+            req.uri().path().to_owned()
+        };
+
+        let raw_query = RawQuery(req.uri().query().map(str::to_owned));
+        let mut query = raw_query.0.clone();
+
+        #[cfg(feature = "original-uri")]
+        if let Some(original) = req.extensions().get::<crate::extract::OriginalUri>() {
+            let original_query = original.0.query().map(str::to_owned);
+            if query.is_none() {
+                query = original_query;
+            }
+        }
+
+        let scheme = req.uri().scheme().cloned();
+        let authority = req.uri().authority().cloned();
+        let host = req.uri().host().map(str::to_owned);
+
+        let new_path = match err {
+            MatchError::MissingTrailingSlash => Some(format!("{}/", path)),
+            MatchError::ExtraTrailingSlash => Some(path.strip_suffix('/').unwrap().to_owned()),
+            MatchError::NotFound => None,
+        };
+
+        if let Some(new_path) = new_path {
+            let mut new_path_and_query = new_path;
+            if let Some(query) = query.as_deref() {
+                new_path_and_query.push('?');
+                new_path_and_query.push_str(query);
+            }
+
+            let mut builder = http::Uri::builder();
+            if let Some(scheme) = scheme {
+                builder = builder.scheme(scheme);
+            }
+            if let Some(authority) = authority {
+                builder = builder.authority(authority);
+            } else if let Some(host) = host {
+                builder = builder.authority(host);
+            }
+
+            if let Ok(new_uri) = builder.path_and_query(new_path_and_query).build() {
+                let redirect = Redirect::permanent(&new_uri.to_string());
+                return RouteFuture::from_response(
+                    (
+                        redirect.status_code,
+                        [(header::LOCATION, redirect.location)],
+                    )
+                        .into_response(),
+                );
+            }
+        }
+
+        RouteFuture::from_future(self.0.clone().oneshot(req))
+    }
 }
 
