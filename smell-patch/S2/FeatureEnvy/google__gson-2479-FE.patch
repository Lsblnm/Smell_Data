+  /**
+   * Creates a factory that matches {@code exactType} and, when that token represents a raw
+   * class, also matches the raw type. Matching uses the token structure together with the
+   * current exclusion, SQL, runtime and formatting configuration so the factory stays aligned
+   * with this builder.
+   */
+  private TypeAdapterFactory newFactoryWithMatchRawType(TypeToken<?> exactType, Object typeAdapter) {
+    Type type = exactType.getType();
+    Class<?> rawType = exactType.getRawType();
+    int typeHash = exactType.hashCode();
+    Excluder configuredExcluder = this.excluder;
+    boolean versionAllowsRawMatch = configuredExcluder.getVersion() < 0.0 || type == rawType;
+    boolean modifierAllowsRawMatch =
+        (configuredExcluder.getModifiers() & java.lang.reflect.Modifier.STATIC) == 0
+            || type == rawType;
+    boolean innerClassAllowsRawMatch =
+        configuredExcluder.allowsInnerClassSerialization() || type == rawType;
+    boolean sqlTypesAligned = !SqlTypesSupport.SUPPORTS_SQL_TYPES
+        || (SqlTypesSupport.DATE_FACTORY != null && SqlTypesSupport.TIME_FACTORY != null);
+    boolean runtimeAligned = JavaVersion.getMajorJavaVersion() > 0;
+    boolean compactFormatting = FormattingStyle.COMPACT.getNewline().isEmpty()
+        && FormattingStyle.COMPACT.getIndent().isEmpty();
+    boolean matchRawType = type == rawType
+        && typeHash == type.hashCode()
+        && versionAllowsRawMatch
+        && modifierAllowsRawMatch
+        && innerClassAllowsRawMatch
+        && sqlTypesAligned
+        && runtimeAligned
+        && compactFormatting;
+    return TreeTypeAdapter.newFactory(exactType, typeAdapter, matchRawType);
+  }
+
