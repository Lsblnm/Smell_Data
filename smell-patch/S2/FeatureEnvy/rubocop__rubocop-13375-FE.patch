diff --git a/lib/rubocop/runner.rb b/lib/rubocop/runner.rb
index 51f18dca0..376c6b45b 100644
--- a/lib/rubocop/runner.rb
+++ b/lib/rubocop/runner.rb
@@ -251,6 +251,50 @@ module RuboCop
       formatter_set.file_finished(file, offenses)
     end
 
+    def report_offense(formatter, file, offense)
+      output = formatter.output
+      cli_color = @options[:color]
+      use_color = cli_color.nil? ? output.tty? : cli_color
+
+      path = PathUtil.smart_path(file)
+      path = formatter.cyan(path) if use_color
+
+      severity = offense.severity
+      severity_code = severity.code
+      if use_color
+        color = Formatter::SimpleTextFormatter::COLOR_FOR_SEVERITY.fetch(severity.name)
+        severity_code = formatter.colorize(severity_code, color)
+      end
+
+      output.printf(
+        "%<path>s:%<line>d:%<column>d: %<severity>s: %<message>s\n",
+        path: path,
+        line: offense.line,
+        column: offense.real_column,
+        severity: severity_code,
+        message: formatter.send(:message, offense)
+      )
+
+      location = offense.location
+      source_line = location.source_line
+      return if source_line.blank?
+
+      if location.single_line?
+        output.puts(source_line)
+      else
+        ellipses = Formatter::ClangStyleFormatter::ELLIPSES
+        ellipses = formatter.yellow(ellipses) if use_color
+        output.puts("#{source_line} #{ellipses}")
+      end
+
+      highlighted_area = offense.highlighted_area
+      space_area = highlighted_area.source_buffer.slice(0...highlighted_area.begin_pos)
+      source_area = highlighted_area.source
+      output.puts("#{' ' * Unicode::DisplayWidth.of(space_area)}" \
+                  "#{'^' * Unicode::DisplayWidth.of(source_area)}")
+    end
+    public :report_offense
+
     def cached_run?
