+/// Analyzes call expressions for uses of the builtin `exec` function.
+pub(crate) struct ExecCallAnalyzer<'c, 'a> {
+    pub(crate) checker: &'c mut Checker<'a>,
+}
+
+impl<'c, 'a> ExecCallAnalyzer<'c, 'a> {
+    /// S102
+    pub(crate) fn exec_used(&mut self, func: &Expr) {
+        let detected = {
+            let semantic = self.checker.semantic();
+            let in_forward_reference = semantic
+                .flags
+                .intersects(SemanticModelFlags::STRING_TYPE_DEFINITION)
+                || (semantic
+                    .flags
+                    .intersects(SemanticModelFlags::FUTURE_TYPE_DEFINITION)
+                    && semantic
+                        .flags
+                        .intersects(SemanticModelFlags::TYPING_ONLY_ANNOTATION));
+
+            let mut current = func;
+            let mut attribute_name = None;
+            let mut attribute_depth = 0usize;
+            let head = loop {
+                match current {
+                    Expr::Attribute(ast::ExprAttribute { value, attr, .. }) => {
+                        attribute_name = Some(attr.as_str());
+                        attribute_depth += 1;
+                        current = value.as_ref();
+                    }
+                    Expr::Name(name) => break Some(name),
+                    _ => break None,
+                }
+            };
+
+            if let Some(head) = head {
+                if let Some(binding_id) = semantic.resolve_name(head).or_else(|| {
+                    semantic.lookup_symbol_in_scope(
+                        head.id.as_str(),
+                        semantic.scope_id,
+                        in_forward_reference,
+                    )
+                }) {
+                    let binding = semantic.binding(binding_id);
+                    if binding.flags.intersects(BindingFlags::DELETED) {
+                        false
+                    } else {
+                        match &binding.kind {
+                            BindingKind::Builtin => {
+                                binding.scope.is_global()
+                                    && head.id.as_str() == "exec"
+                                    && attribute_name.is_none()
+                            }
+                            BindingKind::Import(import) => {
+                                import.qualified_name.segments() == ["builtin"]
+                                    && attribute_name == Some("exec")
+                                    && attribute_depth == 1
+                            }
+                            _ => semantic.resolve_qualified_name(func).is_some_and(
+                                |qualified_name| {
+                                    matches!(qualified_name.segments(), ["" | "builtin", "exec"])
+                                },
+                            ),
+                        }
+                    }
+                } else {
+                    false
+                }
+            } else {
+                false
+            }
+        };
+
+        if detected {
+            self.checker
+                .diagnostics
+                .push(Diagnostic::new(ExecBuiltin, func.range()));
+        }
     }
 }
