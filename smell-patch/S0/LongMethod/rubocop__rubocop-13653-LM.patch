+          return true unless node.access_modifier?
+
+          parent_node = node.parent
+          parent_type = nil
+          parent_type = parent_node.type unless parent_node.nil?
+          allowed_parent_types = ALLOWED_NODE_TYPES
+          pair_or_block_parent = allowed_parent_types.include?(parent_type)
+          if pair_or_block_parent
+            return true
+          end
+
+          argument_nodes = node.arguments
+          argument_count = argument_nodes.length
+          missing_arguments = argument_count.zero?
+          if missing_arguments
+            return false
+          end
+
+          inline_def_modifier = visibility_inline_on_def?(node)
+          if inline_def_modifier
+            return false
+          end
+
+          modifier_name = node.method_name
+          visibility_scope_member = VISIBILITY_SCOPES.include?(modifier_name)
+          module_function_modifier = modifier_name == :module_function
+          recognized_modifier = visibility_scope_member || module_function_modifier
+
+          symbol_flag_name = 'AllowModifiersOnSymbols'
+          allow_symbols = visibility_modifier_config_flag(symbol_flag_name)
+          matches_symbol_pattern = recognized_modifier
+          splat_count = 0
+          if allow_symbols
+            argument_nodes.each do |argument|
+              argument_type = argument.type
+              if argument_type == :sym
+                next
+              elsif argument_type == :splat
+                splat_count += 1
+                splat_value = argument.children.first
+                splat_type = nil
+                splat_type = splat_value.type unless splat_value.nil?
+                valid_const_or_send = %i[const send].include?(splat_type)
+                valid_percent_array = false
