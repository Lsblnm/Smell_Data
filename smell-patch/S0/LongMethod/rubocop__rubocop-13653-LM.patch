+                  valid_const_or_send = valid_percent_array
+                end
+                matches_symbol_pattern = false unless valid_const_or_send
+              else
+                matches_symbol_pattern = false
+              end
+            end
+
+            splat_zero = splat_count.zero?
+            splat_single = splat_count == 1
+            accepted_symbol_shape = splat_zero
+            if splat_single
+              accepted_symbol_shape = argument_count == 1
+            end
+            if matches_symbol_pattern
+              return true if accepted_symbol_shape
+            end
+          end
+
+          attr_flag_name = 'AllowModifiersOnAttrs'
+          allow_attrs = visibility_modifier_config_flag(attr_flag_name)
