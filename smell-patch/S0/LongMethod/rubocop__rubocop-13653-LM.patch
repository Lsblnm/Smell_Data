diff --git a/lib/rubocop/cop/mixin/visibility_help.rb b/lib/rubocop/cop/mixin/visibility_help.rb
index b7b960567..52462d3b2 100644
--- a/lib/rubocop/cop/mixin/visibility_help.rb
+++ b/lib/rubocop/cop/mixin/visibility_help.rb
@@ -67,6 +67,17 @@ module RuboCop
       def_node_matcher :visibility_inline_on_method_name?, <<~PATTERN
         (send nil? VISIBILITY_SCOPES (sym %method_name))
       PATTERN
+
+      def visibility_modifier_config_flag(flag_name)
+        settings = cop_config
+        if settings.nil?
+          false
+        elsif flag_name.nil?
+          false
+        else
+          settings[flag_name]
+        end
+      end
     end
   end
 end
diff --git a/lib/rubocop/cop/style/access_modifier_declarations.rb b/lib/rubocop/cop/style/access_modifier_declarations.rb
