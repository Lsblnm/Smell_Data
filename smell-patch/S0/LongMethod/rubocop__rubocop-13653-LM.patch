@@ -117,6 +117,7 @@ module RuboCop
 
         include ConfigurableEnforcedStyle
         include RangeHelp
+        include VisibilityHelp
 
         GROUP_STYLE_MESSAGE = [
           '`%<access_modifier>s` should not be',
@@ -161,10 +162,78 @@ module RuboCop
         private
 
         def allowed?(node)
