diff --git a/lib/jekyll/site.rb b/lib/jekyll/site.rb
index 2fad097be..2809f3335 100644
--- a/lib/jekyll/site.rb
+++ b/lib/jekyll/site.rb
@@ -360,9 +360,81 @@ module Jekyll
     end
 
     def each_site_file
-      %w(pages static_files_to_write docs_to_write).each do |type|
-        send(type).each do |item|
-          yield item
+      allow_unpublished = unpublished
+      allow_future_entries = future
+      current_site_time = time.to_i
+      defaults_handler = frontmatter_defaults
+      collection_map = collections
+      published_key = "published"
+      output_key = "output"
+      published_default = true
+      output_default = false
+
+      site_pages = pages
+      site_pages.each do |page|
+        yield page
+      end
+
+      site_static_files = static_files
+      site_static_files.each do |static_file|
+        file_type = static_file.type
+        file_url = static_file.url
+        file_defaults = defaults_handler.all(file_url, file_type)
+        publishable = file_defaults.fetch(published_key, published_default)
+
+        if file_type.nil?
+          if publishable
+            yield static_file
+          end
+        else
+          related_collection = static_file.instance_variable_get(:@collection)
+          collection_metadata = related_collection.metadata
+          output_enabled = collection_metadata.fetch(output_key, output_default)
+          writes_collection = !!output_enabled
+          if publishable
+            if writes_collection
+              yield static_file
+            end
+          end
+        end
+      end
+
+      docs_phase_items = []
+      collection_map.each_value do |collection|
+        collection_metadata = collection.metadata
+        output_enabled = collection_metadata.fetch(output_key, output_default)
+        writes_collection = !!output_enabled
+        next unless writes_collection
+
+        docs_phase_items |= collection.docs
+        docs_phase_items |= collection.files
+      end
+
+      docs_phase_items.each do |item|
+        has_date = item.respond_to?(:date)
+        if has_date
+          document_data = item.data
+          published_flag = document_data.fetch(published_key, published_default)
+          can_be_published = published_flag || allow_unpublished
+          if can_be_published
+            hidden_in_future = false
+            unless allow_future_entries
+              document_date = item.date
+              document_timestamp = document_date.to_i
+              hidden_in_future = document_timestamp > current_site_time
+            end
+            unless hidden_in_future
+              yield item
+            end
+          end
+        else
+          file_type = item.type
+          file_url = item.url
+          file_defaults = defaults_handler.all(file_url, file_type)
+          publishable = file_defaults.fetch(published_key, published_default)
+          if publishable
+            yield item
+          end
         end
       end
     end
