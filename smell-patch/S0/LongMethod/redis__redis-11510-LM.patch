diff --git a/src/functions.c b/src/functions.c
index f51aa62d0..08e324c4d 100644
--- a/src/functions.c
+++ b/src/functions.c
@@ -622,13 +622,29 @@ static void fcallCommandGeneric(client *c, int ro) {
         addReplyError(c, "Function not found");
         return;
     }
-    engine *engine = fi->li->ei->engine;
+    functionLibInfo *li = fi->li;
+    engineInfo *ei = li->ei;
+    engine *engine = ei->engine;
+    client *engine_client = ei->c;
+    sds func_name = fi->name;
+    uint64_t script_flags = fi->f_flags;
+    void *compiled_function = fi->function;
 
     long long numkeys;
-    /* Get the number of arguments that are keys */
-    if (getLongLongFromObject(c->argv[2], &numkeys) != C_OK) {
-        addReplyError(c, "Bad number of keys provided");
-        return;
+    robj *numkeys_obj = c->argv[2];
+    serverAssertWithInfo(NULL, numkeys_obj, numkeys_obj->type == OBJ_STRING);
+    if (sdsEncodedObject(numkeys_obj)) {
+        sds numkeys_str = numkeys_obj->ptr;
+        size_t numkeys_len = sdslen(numkeys_str);
+        if (string2ll(numkeys_str, numkeys_len, &numkeys) == 0) {
+            addReplyError(c, "Bad number of keys provided");
+            return;
+        }
+    } else if (numkeys_obj->encoding == OBJ_ENCODING_INT) {
+        long encoded_numkeys = (long)numkeys_obj->ptr;
+        numkeys = encoded_numkeys;
+    } else {
+        serverPanic("Unknown string encoding");
     }
     if (numkeys > (c->argc - 3)) {
         addReplyError(c, "Number of keys can't be greater than number of args");
@@ -639,13 +655,48 @@ static void fcallCommandGeneric(client *c, int ro) {
     }
 
     scriptRunCtx run_ctx;
-
-    if (scriptPrepareForRun(&run_ctx, fi->li->ei->c, c, fi->name, fi->f_flags, ro) != C_OK)
+    if (scriptPrepareForRun(&run_ctx, engine_client, c, func_name, script_flags, ro) != C_OK)
         return;
 
-    engine->call(&run_ctx, engine->engine_ctx, fi->function, c->argv + 3, numkeys,
-                 c->argv + 3 + numkeys, c->argc - 3 - numkeys);
-    scriptResetRun(&run_ctx);
+    robj **keys = c->argv + 3;
+    size_t nkeys = (size_t)numkeys;
+    robj **args = c->argv + 3 + numkeys;
+    size_t nargs = (size_t)(c->argc - 3 - numkeys);
+    engine->call(&run_ctx, engine->engine_ctx, compiled_function, keys, nkeys, args, nargs);
+
+    serverAssert(curr_run_ctx);
+    client *script_client = run_ctx.c;
+    client *caller_client = run_ctx.original_client;
+    script_client->flags &= ~CLIENT_MULTI;
+    server.script_caller = NULL;
+    if (scriptIsTimedout()) {
+        serverAssert(curr_run_ctx == &run_ctx);
+        serverAssert(scriptIsTimedout());
+        run_ctx.flags &= ~SCRIPT_TIMEDOUT;
+        if (!(--server.blocking_op_nesting)) {
+            server.blocked_last_cron = 0;
+        }
+        if (server.masterhost) {
+            client *master = server.master;
+            if (master) {
+                if (!(master->flags & CLIENT_UNBLOCKED)) {
+                    master->flags |= CLIENT_UNBLOCKED;
+                    listAddNodeTail(server.unblocked_clients, master);
+                }
+            }
+        }
+        if (caller_client->flags & CLIENT_PROTECTED) {
+            caller_client->flags &= ~CLIENT_PROTECTED;
+            if (caller_client->conn) {
+                connSetReadHandler(caller_client->conn, readQueryFromClient);
+                if (clientHasPendingReplies(caller_client)) {
+                    putClientInPendingWriteQueue(caller_client);
+                }
+            }
+        }
+    }
+    caller_client->flags |= CLIENT_PREVENT_PROP;
+    curr_run_ctx = NULL;
 }
 
