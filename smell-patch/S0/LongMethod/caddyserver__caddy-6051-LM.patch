+func normalizeCaddyfileText(raw any) string {
+	text := caddy.ToString(raw)
+	if len(text) == 0 {
+		return text
+	}
+	if bytes.Index([]byte(text), []byte("\r\n")) < 0 {
+		return text
+	}
+	return string(bytes.Replace([]byte(text), []byte("\r\n"), []byte("\n"), -1))
+}
