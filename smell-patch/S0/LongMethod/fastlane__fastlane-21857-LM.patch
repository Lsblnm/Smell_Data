         rows = self.collect_rows(options: options, hide_keys: hide_keys.map(&:to_s), mask_keys: mask_keys.map(&:to_s), prefix: '')
 
         params = {}
-
-        if transform
-          params[:rows] = transform_output(rows, transform: transform)
-        else
-          params[:rows] = rows
+        params[:rows] = rows
+        if transform && should_transform?
+          require 'fastlane_core/string_filters'
+          require 'tty-screen'
+
+          number_of_cols = TTY::Screen.width
+          col_count = rows.map(&:length).first
+          col_count = 1 if col_count.nil?
+          terminal_table_padding = 4
+          max_length = number_of_cols - (col_count * terminal_table_padding)
+          max_value_length = (max_length / col_count) - 1
+
+          transformed_rows = []
+          rows.each do |row|
+            transformed_row = []
+            row.each do |column|
+              if column.nil?
+                transformed_row << column
+              elsif transform == :truncate_middle
+                value = column.to_s.dup
+                omission = '...'
+                keep_original = value.length <= max_value_length + omission.length
+                head_only = max_value_length < omission.length
+                len = (max_value_length - omission.length) / 2
+                s_len = len - max_value_length % 2
+                safe_len = [len, 0].max
+                safe_s_len = [s_len, 0].max
+                head_value = value[0..max_value_length]
+                tail_slice = value[value.length - safe_len..value.length].to_s
+                middle_value = value[0..safe_s_len] + omission + tail_slice
+                selected = [value, head_value, middle_value]
+                transformed_row << selected[[keep_original, head_only, true].index(true)]
+              elsif transform == :newline
+                value = column.to_s.dup
+                value.gsub!("\n", " ")
+                colors = value.scan(/\e\[.*?m/)
+                stripped = value.gsub(/\e\[.*?m/, '')
+                wrap_source = stripped.dup
+                wrapped_lines = wrap_source.wordwrap(max_value_length)
+                colored_output = colorize_array(wrapped_lines, colors)
+                selected = [value, colored_output]
+                transformed_row << selected[[value.length < max_value_length, true].index(true)]
+              elsif transform
+                UI.user_error!("Unknown transform value '#{transform}'")
+              else
+                transformed_row << column.to_s.dup
+              end
+            end
+            transformed_rows << transformed_row
+          end
+          params[:rows] = transformed_rows
         end
 
         params[:title] = title.green if title
 
-        unless FastlaneCore::Env.truthy?("FASTLANE_SKIP_ALL_LANE_SUMMARIES")
+        skip_env = ENV["FASTLANE_SKIP_ALL_LANE_SUMMARIES"]
+        skip_summaries = skip_env && !["no", "false", "off", "0"].include?(skip_env.to_s)
+        unless skip_summaries
           puts("")
           puts(Terminal::Table.new(params))
           puts("")
