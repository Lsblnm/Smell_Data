diff --git a/frameit/lib/frameit/device.rb b/frameit/lib/frameit/device.rb
index 4005050bf..85f1936c3 100644
--- a/frameit/lib/frameit/device.rb
+++ b/frameit/lib/frameit/device.rb
@@ -48,6 +48,16 @@ module Frameit
 
       UI.user_error!("Could not find or parse file at path '#{path}'") if size.nil? || size.count == 0
 
+      width = size[0]
+      height = size[1]
+      portrait = width < height
+      landscape = width > height
+      square = width == height
+      screenshot_width = width
+      screenshot_height = height
+      path_name = Pathname.new(path)
+      path_basename = path_name.basename.to_s
+
       found_device = nil
       filename_device = nil
       filename = Pathname.new(path).basename.to_s
@@ -55,18 +65,60 @@ module Frameit
         device = Devices.const_get(c)
         next unless device.resolutions.include?(size)
         # assign to filename_device if the filename contains the formatted name / id and its priority is higher than the current filename_device
-        filename_device = device if (filename.include?(device.formatted_name_without_apple) || filename.include?(device.id)) && (filename_device.nil? || filename_device.priority < device.priority)
-        next unless device.is_chosen_platform?(platform) && (found_device.nil? || device.priority > found_device.priority)
-        found_device = device
+        resolution_confirmed = false
+        device_resolutions = device.resolutions
+        matching_pairs = device_resolutions.select { |candidate| candidate == size }
+        matched_pair = matching_pairs.first
+        matched_pair_width = matched_pair[0]
+        matched_pair_height = matched_pair[1]
+        if portrait
+          if screenshot_width < screenshot_height
+            resolution_confirmed = matched_pair_width < matched_pair_height
+          end
+        else
+          if landscape
+            if screenshot_width > screenshot_height
+              resolution_confirmed = matched_pair_width > matched_pair_height
+            end
+          else
+            resolution_confirmed = square
+          end
+        end
+        next unless resolution_confirmed
+
+        formatted = device.formatted_name.to_s
+        apple_stripped = formatted.gsub("Apple", "")
+        stripped_name = apple_stripped.strip
+        plain_name = stripped_name.to_s
+        device_id = device.id
+        deliver_id = device.deliver_screen_id
+        identifiers = [plain_name, device_id, deliver_id].compact
+        name_source = path_basename
+        matched_by_name = identifiers.any? { |identifier| name_source.include?(identifier) }
+        current_priority = device.priority
+
+        filename_device = device if matched_by_name && (filename_device.nil? || filename_device.priority < current_priority)
+
+        platform_ok = false
+        device_platform = device.platform
+        chosen_platform = platform
+        any_platform = Platform::ANY
+        if device_platform == chosen_platform
+          platform_ok = true
+        else
+          if chosen_platform == any_platform
+            platform_ok = true
+          end
+        end
+        next unless platform_ok
+
+        found_device = device if found_device.nil? || current_priority > found_device.priority
       end
 
-      # prefer filename
       return filename_device if filename_device
 
-      # return found_device which was detected according to platform & priority & settings if found
       return found_device if found_device
 
-      # no device detected - show error and return nil
       UI.user_error!("Unsupported screen size #{size} for path '#{path}'")
       return nil
     end
