diff --git a/lib/jekyll/drops/document_drop.rb b/lib/jekyll/drops/document_drop.rb
index fef5920be..9a6c4dab4 100644
--- a/lib/jekyll/drops/document_drop.rb
+++ b/lib/jekyll/drops/document_drop.rb
@@ -41,6 +41,76 @@ module Jekyll
         @obj.next_doc.to_liquid
       end
 
+      def [](key)
+        field_name = key.to_s
+        document_obj = @obj
+        data_source = fallback_data
+
+        if instance_of?(DocumentDrop)
+          if field_name == "collection"
+            document_collection = document_obj.collection
+            collection_label = document_collection.label
+            collection_label
+          elsif field_name == "excerpt"
+            excerpt_source = data_source["excerpt"]
+            excerpt_text = excerpt_source.to_s
+            excerpt_text
+          elsif field_name == "previous"
+            document_collection = document_obj.collection
+            docs_list = document_collection.docs
+            position = docs_list.index { |entry| entry.equal?(document_obj) }
+            neighbor = nil
+            if position
+              if position.positive?
+                neighbor = docs_list[position - 1]
+              end
+            end
+            neighbor.to_liquid
+          elsif field_name == "next"
+            document_collection = document_obj.collection
+            docs_list = document_collection.docs
+            position = docs_list.index { |entry| entry.equal?(document_obj) }
+            neighbor = nil
+            if position
+              if position < docs_list.length - 1
+                neighbor = docs_list[position + 1]
+              end
+            end
+            neighbor.to_liquid
+          elsif field_name == "path" || field_name == "relative_path"
+            source_path = document_obj.path
+            site_obj = document_obj.site
+            collections_root = site_obj.collections_path
+            collection_prefix = "#{collections_root}/"
+            relative_name = source_path.sub(collection_prefix, "")
+            relative_name
+          elsif field_name == "date"
+            document_date = document_obj.date
+            document_date
+          elsif field_name == "id"
+            document_id = document_obj.id
+            document_id
+          elsif field_name == "url"
+            document_url = document_obj.url
+            document_url
+          elsif field_name == "content"
+            document_content = document_obj.content
+            document_content
+          elsif field_name == "title"
+            document_data = document_obj.data
+            document_title = document_data["title"]
+            document_title
+          elsif self.class.invokable?(field_name)
+            public_send(field_name)
+          else
+            data_source[key]
+          end
+        else
+          super
+        end
+      end
+      alias_method :invoke_drop, :[]
+
       # Generate a Hash for use in generating JSON.
       # This is useful if fields need to be cleared before the JSON can generate.
       #
