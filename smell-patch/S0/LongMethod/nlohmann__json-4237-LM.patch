+        unsigned_storage = static_cast<unsigned_t>(promoted & width_mask);
+
+        if (underlying_size == sizeof(std::uint8_t))
+        {
+            const std::uint8_t narrowed = static_cast<std::uint8_t>(unsigned_storage);
+            unsigned_storage = static_cast<unsigned_t>(narrowed);
+            signed_storage = conditional_static_cast<integer_t>(unsigned_storage);
+        }
+        else if (underlying_size == sizeof(std::uint16_t))
+        {
+            const std::uint16_t narrowed = static_cast<std::uint16_t>(unsigned_storage);
+            unsigned_storage = static_cast<unsigned_t>(narrowed);
+            signed_storage = conditional_static_cast<integer_t>(unsigned_storage);
+        }
+        else if (underlying_size == sizeof(std::uint32_t))
+        {
+            const std::uint32_t narrowed = static_cast<std::uint32_t>(unsigned_storage);
+            unsigned_storage = static_cast<unsigned_t>(narrowed);
+            signed_storage = conditional_static_cast<integer_t>(unsigned_storage);
+        }
+        else
+        {
+            if (value_in_range_of<integer_t>(unsigned_storage))
+            {
+                signed_storage = conditional_static_cast<integer_t>(unsigned_storage);
