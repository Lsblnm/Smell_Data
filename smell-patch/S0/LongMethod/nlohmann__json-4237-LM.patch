+    const int signed_digits = static_cast<int>(signed_limits::digits);
+    const int unsigned_digits = static_cast<int>(unsigned_limits::digits);
+    const bool underlying_unsigned = std::is_unsigned<underlying_type>::value;
+    const bool compatible_signed = is_compatible_integer_type<integer_t, underlying_type>::value;
+    const bool compatible_unsigned = is_compatible_integer_type<unsigned_t, underlying_type>::value;
+    const bool signed_never_overflows = never_out_of_range<integer_t, underlying_type>::value;
+    const std::size_t underlying_size = sizeof(underlying_type);
