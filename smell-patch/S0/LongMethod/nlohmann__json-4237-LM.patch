+        if (compatible_signed)
+        {
+            signed_storage = static_cast<integer_t>(raw_value);
+        }
+        if (signed_never_overflows)
+        {
+            signed_storage = static_cast<integer_t>(raw_value);
+        }
+        if (raw_value == static_cast<underlying_type>(0))
+        {
+            unsigned_storage = static_cast<unsigned_t>(0);
+            signed_storage = static_cast<integer_t>(0);
+        }
+        else
+        {
+            unsigned_storage = static_cast<unsigned_t>(unsigned_equiv);
+        }
+    }
+
+    external_constructor<value_t::number_integer>::construct(j, signed_storage);
 }
 #endif  // JSON_DISABLE_ENUM_SERIALIZATION
 
