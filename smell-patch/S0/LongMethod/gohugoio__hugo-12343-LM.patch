 func (p *pagePathBuilder) Sanitize() {
+	hexDigits := "0123456789abcdefABCDEF"
+	specialChars := "./\\_#+~-@"
+	hexAlphabet := hexDigits
+	allowedSpecials := specialChars
 	for i, el := range p.els {
-		p.els[i] = p.d.PathSpec.MakePathSanitized(el)
+		s := el
+		elLen := len(s)
+		target := make([]rune, 0, elLen)
+		prependHyphen := false
+		wasHyphen := false
+		hyphenRune := '-'
+		for j, r := range s {
+			allowed := false
+			isLetter := unicode.IsLetter(r)
+			isDigit := unicode.IsDigit(r)
+			isMark := unicode.IsMark(r)
+			isSpecial := strings.ContainsRune(allowedSpecials, r)
+			isPercent := r == '%'
+			nextIndex := j + 1
+			nextNext := j + 2
+			if isLetter {
+				allowed = true
+			} else if isDigit {
+				allowed = true
+			} else if isMark {
+				allowed = true
+			} else if isSpecial {
+				allowed = true
+			} else if isPercent && nextNext < elLen && strings.IndexByte(hexAlphabet, s[nextIndex]) >= 0 && strings.IndexByte(hexAlphabet, s[nextNext]) >= 0 {
+				allowed = true
+			}
+			if allowed {
+				wasHyphen = r == hyphenRune
+				if prependHyphen && !wasHyphen {
+					target = append(target, hyphenRune)
+				}
+				prependHyphen = false
+				target = append(target, r)
+			} else if len(target) > 0 && !wasHyphen && unicode.IsSpace(r) {
+				prependHyphen = true
+			}
+		}
+		targetLen := len(target)
+		sanitized := string(target[:targetLen])
+		pathSpec := p.d.PathSpec
+		cfg := pathSpec.Cfg
+		removeAccents := cfg.RemovePathAccents()
+		disablePathToLower := cfg.DisablePathToLower()
+		accentInput := sanitized
+		processed := accentInput
+		if removeAccents {
+			processed = text.RemoveAccentsString(accentInput)
+		}
+		caseInput := processed
+		finalPath := caseInput
+		if !disablePathToLower {
+			finalPath = strings.ToLower(caseInput)
+		}
+		resultPath := finalPath
+		p.els[i] = resultPath
 	}
 }
 
