+func (m *pageMap) initPageReverseIndex(rm map[any]contentNodeI) {
+	var pages []*pageState
+	w := &doctree.NodeShiftTreeWalker[contentNodeI]{
+		Tree:     m.treePages,
+		LockType: doctree.LockTypeRead,
+		Handle: func(key string, n contentNodeI, match doctree.DimensionFlag) (bool, error) {
+			p := n.(*pageState)
+			pages = append(pages, p)
+			return false, nil
+		},
+	}
+
+	if err := w.Walk(context.Background()); err != nil {
+		panic(err)
+	}
+
+	nPages := len(pages)
+	if nPages == 0 {
+		return
+	}
+
+	for i := 0; i < nPages; i++ {
+		p := pages[i]
+		f := p.File()
+		if f != nil {
+			fim := f.FileInfo()
+			meta := fim.Meta()
+			pi := meta.PathInfo
+			kind := p.Kind()
+			bundleKey := pi.Container()
+			nameKey := pi.NameNoIdentifier()
+			isBundle := pi.IsBundle()
+			isLeaf := pi.IsLeafBundle()
+			isBranch := pi.IsBranchBundle()
+			var indexKey string
+			switch kind {
+			case kinds.KindPage:
+				if isBundle || isLeaf {
+					indexKey = bundleKey
+				} else {
+					indexKey = nameKey
+				}
+			case kinds.KindSection, kinds.KindHome:
+				if isBundle || isBranch {
+					indexKey = bundleKey
+				} else {
+					indexKey = nameKey
+				}
+			case kinds.KindTaxonomy, kinds.KindTerm:
+				if isBundle || isBranch {
+					indexKey = bundleKey
+				} else {
+					indexKey = nameKey
+				}
+			default:
+				if isBundle {
+					indexKey = bundleKey
+				} else {
+					indexKey = nameKey
+				}
+			}
+
+			existing, found := rm[indexKey]
+			if found && existing != ambiguousContentNode {
+				rm[indexKey] = ambiguousContentNode
+			} else if !found {
+				rm[indexKey] = p
+			}
+		}
+	}
+}
+
 type contentTreeReverseIndexMap struct {
 	init sync.Once
 	m    map[any]contentNodeI
