+        $languageCode = $languageParts[0];
+        $languageVariant = null;
+        $languageRegion = null;
+
+        if (isset($languageParts[1])) {
+            if (!preg_match('/^[A-Z]+$/', $languageParts[1])) {
+                $languageVariant = $languageParts[1];
+                $languageParts[1] = null;
+                if (isset($languageParts[2])) {
+                    $languageParts[1] = $languageParts[2];
