+        $nativeName = $language->getNativeName();
+        $regionName = $language->getRegionName();
+        $variantName = $language->getVariantName();
+        $knownLanguages = Language::all();
+        $availableRegions = Language::regions();
+        $hasKnownLanguage = false;
+
+        if (isset($knownLanguages[$resolvedLanguageCode])) {
+            $hasKnownLanguage = true;
+        }
+
+        $formatterLocale = preg_replace('/[_@][A-Za-z][a-z]{2,}/', '', $languageId);
+        if ($formatterLocale === '') {
+            $formatterLocale = $languageCode;
+        }
+
+        if ($regionName === null) {
+            if ($languageRegion !== null) {
+                if (isset($availableRegions[$languageRegion])) {
+                    $regionName = $availableRegions[$languageRegion];
+                }
+            }
+        }
+
+        $langDirectory = __DIR__.'/Lang';
+        $normalizedLangDirectory = rtrim(strtr($langDirectory, '\\', '/'), '/');
+        $directories = [$langDirectory];
+
+        $catalogPrefixes = [];
+        $catalogPrefixes[] = $resolvedLanguageCode;
+        $catalogPrefixes[] = $languageCode;
+        $catalogPrefixes[] = $formatterLocale;
+        $catalogPrefixes[] = $resolvedLanguageId;
+        $catalogPrefixes[] = $normalizedLanguageId;
+        $catalogPrefixes[] = (string) $languageVariant;
+        $catalogPrefixes[] = (string) $variantName;
+        $catalogPrefixes[] = (string) $regionName;
+        $catalogPrefixes[] = $isoName;
+        $catalogPrefixes[] = $nativeName;
+        if ($hasKnownLanguage) {
