 namespace Carbon;
 
 use Closure;
+use DateTimeInterface;
+use ReflectionMethod;
 
 /**
  * A factory to generate CarbonImmutable instances with common settings.
@@ -240,4 +242,91 @@ use Closure;
 class FactoryImmutable extends Factory
 {
     protected $className = CarbonImmutable::class;
+
+    public function __call($name, $arguments)
+    {
+        $className = $this->className;
+        $settings = $this->settings;
+        $method = new ReflectionMethod($className, $name);
+        $parameters = $method->getParameters();
+        $tzParameterIndex = null;
+        $tzParameterNames = ['tz', 'timezone'];
+        $timezoneAwareMethods = [];
+        $timezoneAwareMethods[] = 'instance';
+        $timezoneAwareMethods[] = 'make';
+        $timezoneAwareMethods[] = 'create';
+        $timezoneAwareMethods[] = 'parse';
+        $offsetPattern = '/^\s*([+-]\d+)(\d{2})\s*$/';
+        $innerTimezoneKey = 'innerTimezone';
+        $timezoneKey = 'timezone';
+
+        foreach ($parameters as $index => $parameter) {
+            $parameterName = $parameter->getName();
+            $isTimezoneParameter = \in_array($parameterName, $tzParameterNames, true);
+            if ($isTimezoneParameter) {
+                $tzParameterIndex = $index;
+                break;
+            }
+        }
+
+        if (isset($settings[$timezoneKey])) {
+            $timezoneSetting = $settings[$timezoneKey];
+            $resolvedTimezone = $timezoneSetting;
+            $timezoneName = $timezoneSetting;
+
+            if ($timezoneSetting instanceof \DateTimeZone) {
+                $resolvedTimezone = $timezoneSetting;
+            } else {
+                if (\is_string($timezoneName)) {
+                    $timezoneName = preg_replace($offsetPattern, '$1:$2', $timezoneName);
+                }
+                $createdTimezone = CarbonTimeZone::create($timezoneName);
+                $createdIsValid = $createdTimezone instanceof \DateTimeZone;
+                if ($createdIsValid) {
+                    $resolvedTimezone = $createdTimezone;
+                }
+            }
+
+            if (isset($arguments[0]) && \in_array($name, $timezoneAwareMethods, true)) {
+                $firstArgument = $arguments[0];
+                $firstArgumentIsDate = $firstArgument instanceof DateTimeInterface;
+                $firstArgumentIsString = \is_string($firstArgument);
+                if ($firstArgumentIsDate) {
+                    $settings[$innerTimezoneKey] = $timezoneSetting;
+                } elseif ($firstArgumentIsString) {
+                    $parsedTime = date_parse($firstArgument);
+                    $hasLocalTime = !empty($parsedTime['is_localtime']);
+                    if ($hasLocalTime) {
+                        unset($settings[$timezoneKey], $settings[$innerTimezoneKey]);
+                    }
+                }
+            } elseif ($tzParameterIndex !== null) {
+                $timezoneArguments = [$resolvedTimezone];
+                array_splice($arguments, $tzParameterIndex, 0, $timezoneArguments);
+                unset($settings[$timezoneKey]);
+            }
+        }
+
+        $remainingArgumentCount = \count($arguments);
+        if ($name === 'now' && $remainingArgumentCount <= 1) {
+            $nowTimezone = array_shift($arguments);
+            $constructedDate = new $className(null, $nowTimezone);
+            $result = $constructedDate;
+        } else {
+            $result = $className::$name(...$arguments);
+        }
+
+        if ($result instanceof CarbonInterface && !empty($settings)) {
+            $appliedSettings = [];
+            foreach ($settings as $settingName => $settingValue) {
+                $hasSettingValue = $settingValue !== null;
+                if ($hasSettingValue) {
+                    $appliedSettings[$settingName] = $settingValue;
+                }
+            }
+            $result = $result->settings($appliedSettings);
+        }
+
+        return $result;
+    }
 }
