+/// Map an I/O failure onto the standard "cannot set permissions" error.
+pub fn cannot_set_permissions(path: &Path, err: std::io::Error) -> Box<dyn UError> {
+    let quoted = crate::display::quote_path(path);
+    err.map_err_context(|| format!("cannot set permissions {quoted}")) as Box<dyn UError>
