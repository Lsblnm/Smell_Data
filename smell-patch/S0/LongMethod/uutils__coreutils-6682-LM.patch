+/// Set permissions on a directory created as an ancestor of `mkdir -p`.
+#[cfg(all(not(windows), feature = "mode"))]
+pub fn chmod_mkdir_parent_dir(path: &Path) -> crate::error::UResult<()> {
+    crate::mode::apply_mkdir_parent_permissions(path)
+}
