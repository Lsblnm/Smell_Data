+/// Permission bits for parent directories created by `mkdir -p`:
+/// GNU `=rwx,u+wx` applied on top of the current umask.
+pub fn parent_mkdir_mode() -> u32 {
+    (!get_umask() & 0o0777) | 0o0300
+}
+
+/// Apply the parent-directory mode used when `mkdir -p` creates an ancestor.
+pub fn apply_mkdir_parent_permissions(path: &Path) -> crate::error::UResult<()> {
+    use std::fs::{set_permissions, Permissions};
+    use std::os::unix::fs::PermissionsExt;
+
+    let mode = parent_mkdir_mode();
+    match set_permissions(path, Permissions::from_mode(mode)) {
+        Ok(()) => Ok(()),
+        Err(err) => Err(crate::error::cannot_set_permissions(path, err)),
+    }
+}
