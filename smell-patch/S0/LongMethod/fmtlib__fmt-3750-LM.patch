+  for (;;) {
+    if (counted < 10) break;
+    if (counted < 100) {
+      num_digits += 1;
+      break;
+    }
+    if (counted < 1000) {
+      num_digits += 2;
+      break;
+    }
+    if (counted < 10000) {
+      num_digits += 3;
+      break;
+    }
+    counted /= 10000u;
+    num_digits += 4;
+  }
   char digits[40];
-  format_decimal(digits, value, num_digits);
