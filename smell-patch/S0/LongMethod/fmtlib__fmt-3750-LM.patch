-  return write_padded<align::right>(
-      out, specs, size, size, [&](reserve_iterator<OutputIt> it) {
-        if (prefix != 0) {
-          char sign = static_cast<char>(prefix);
-          *it++ = static_cast<Char>(sign);
-        }
-        return grouping.apply(it, string_view(digits, to_unsigned(num_digits)));
-      });
+  char* digit_out = digits + num_digits;
+  UInt remaining = value;
+  while (remaining >= 100) {
+    digit_out -= 2;
+    unsigned remainder = static_cast<unsigned>(remaining % 100);
+    const char* pair = digits2(static_cast<size_t>(remainder));
+    digit_out[0] = pair[0];
+    digit_out[1] = pair[1];
+    remaining /= 100;
+  }
+  if (remaining < 10) {
+    *--digit_out = static_cast<char>('0' + remaining);
+  } else {
+    digit_out -= 2;
+    const char* pair = digits2(static_cast<size_t>(remaining));
+    digit_out[0] = pair[0];
+    digit_out[1] = pair[1];
+  }
+  string_view digit_view(digits, to_unsigned(num_digits));
+  int separator_count = grouping.count_separators(num_digits);
+  unsigned prefix_size = prefix != 0 ? 1u : 0u;
+  unsigned grouped_size =
+      prefix_size + to_unsigned(num_digits) + to_unsigned(separator_count);
+  unsigned spec_width = to_unsigned(specs.width);
+  size_t padding = spec_width > grouped_size ? spec_width - grouped_size : 0;
+  const char* shifts = "\x00\x1f\x00\x01";
+  unsigned align_index = static_cast<unsigned>(specs.align);
+  size_t left_padding = padding >> shifts[align_index];
+  size_t right_padding = padding - left_padding;
+  size_t fill_size = specs.fill.size();
+  const Char* fill_data = specs.fill.data();
+  auto it = reserve(out, grouped_size + padding * fill_size);
+  if (left_padding != 0) {
+    for (size_t n = 0; n < left_padding; ++n) {
+      const Char* fill_begin = fill_data;
+      const Char* fill_end = fill_data + fill_size;
+      while (fill_begin != fill_end) {
+        *it++ = static_cast<Char>(*fill_begin++);
+      }
+    }
+  }
+  if (prefix != 0) {
+    char sign = static_cast<char>(prefix);
+    *it++ = static_cast<Char>(sign);
+  }
+  if (!grouping.has_separator()) {
+    it = copy_str<Char>(digit_view.begin(), digit_view.end(), it);
+  } else {
+    it = grouping.apply(it, digit_view);
+  }
+  if (right_padding != 0) {
+    for (size_t n = 0; n < right_padding; ++n) {
+      const Char* fill_begin = fill_data;
+      const Char* fill_end = fill_data + fill_size;
+      while (fill_begin != fill_end) {
+        *it++ = static_cast<Char>(*fill_begin++);
+      }
+    }
+  }
+  return base_iterator(out, it);
