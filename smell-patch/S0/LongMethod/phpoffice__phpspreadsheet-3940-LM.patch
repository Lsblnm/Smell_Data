+    private function createMissingCellsBeforeInsert(
+        Worksheet $worksheet,
+        string $highestDataColumn,
+        int $highestDataRow
+    ): void {
+        $cellCollection = $worksheet->getCellCollection();
+        $columnAddress = $highestDataColumn;
+        $columnCharacterCount = mb_strlen($columnAddress, 'UTF-8');
+        if ($columnCharacterCount === 0) {
+            return;
+        }
+
+        static $columnIndexCache = [];
+        static $columnLookup = [
+            'A' => 1, 'B' => 2, 'C' => 3, 'D' => 4, 'E' => 5, 'F' => 6, 'G' => 7, 'H' => 8, 'I' => 9, 'J' => 10,
+            'K' => 11, 'L' => 12, 'M' => 13, 'N' => 14, 'O' => 15, 'P' => 16, 'Q' => 17, 'R' => 18, 'S' => 19,
+            'T' => 20, 'U' => 21, 'V' => 22, 'W' => 23, 'X' => 24, 'Y' => 25, 'Z' => 26,
+            'a' => 1, 'b' => 2, 'c' => 3, 'd' => 4, 'e' => 5, 'f' => 6, 'g' => 7, 'h' => 8, 'i' => 9, 'j' => 10,
+            'k' => 11, 'l' => 12, 'm' => 13, 'n' => 14, 'o' => 15, 'p' => 16, 'q' => 17, 'r' => 18, 's' => 19,
+            't' => 20, 'u' => 21, 'v' => 22, 'w' => 23, 'x' => 24, 'y' => 25, 'z' => 26,
+        ];
+
+        if (isset($columnIndexCache[$columnAddress])) {
+            $columnIndex = $columnIndexCache[$columnAddress];
+        } else {
+            $columnIndex = 0;
+            if (isset($columnAddress[0])) {
+                if (!isset($columnAddress[1])) {
+                    $columnIndex = $columnLookup[$columnAddress];
+                } elseif (!isset($columnAddress[2])) {
+                    $columnIndex = $columnLookup[$columnAddress[0]] * 26
+                        + $columnLookup[$columnAddress[1]];
+                } elseif (!isset($columnAddress[3])) {
+                    $columnIndex = $columnLookup[$columnAddress[0]] * 676
+                        + $columnLookup[$columnAddress[1]] * 26
+                        + $columnLookup[$columnAddress[2]];
+                }
+            }
+            if ($columnIndex > 0) {
+                $columnIndexCache[$columnAddress] = $columnIndex;
+            }
+        }
+
+        static $columnStringCache = [];
+        static $columnStringLookup = ' ABCDEFGHIJKLMNOPQRSTUVWXYZ';
+        if ($columnIndex > 0) {
+            if (!isset($columnStringCache[$columnIndex])) {
+                $indexValue = $columnIndex;
+                $base26 = '';
+                do {
+                    $remainder = $indexValue % 26;
+                    if ($remainder === 0) {
+                        $characterValue = 26;
+                    } else {
+                        $characterValue = $remainder;
+                    }
+                    $indexValue = ($indexValue - $characterValue) / 26;
+                    $base26 = $columnStringLookup[$characterValue] . $base26;
+                } while ($indexValue > 0);
+                $columnStringCache[$columnIndex] = $base26;
+            }
+
+            $normalizedColumn = mb_convert_case($columnStringCache[$columnIndex], MB_CASE_UPPER, 'UTF-8');
+            for ($row = 1; $row <= $highestDataRow; ++$row) {
+                $coordinate = $normalizedColumn . $row;
+                $coordinate = mb_convert_case($coordinate, MB_CASE_UPPER, 'UTF-8');
+                if (preg_match(Coordinate::A1_COORDINATE_REGEX, $coordinate) === 1) {
+                    if ($cellCollection->has($coordinate) === false) {
+                        $worksheet->createNewCell($coordinate);
+                    }
+                }
+            }
+        }
+    }
+
