diff --git a/src/t_stream.c b/src/t_stream.c
index c49889abe..a56311c22 100644
--- a/src/t_stream.c
+++ b/src/t_stream.c
@@ -1291,7 +1291,18 @@ void streamIteratorRemoveEntry(streamIterator *si, streamID *current) {
         /* In the base case we alter the counters of valid/deleted entries. */
         lp = lpReplaceInteger(lp,&p,aux-1);
         p = lpNext(lp,p); /* Seek deleted field. */
-        aux = lpGetInteger(p);
+        int64_t v;
+        unsigned char *ele = lpGet(p,&v,NULL);
+        if (ele == NULL) {
+            aux = v;
+        } else if (v == 1 && ele[0] >= '0' && ele[0] <= '9') {
+            aux = ele[0] - '0';
+        } else {
+            long long ll;
+            int ret = string2ll((char*)ele,v,&ll);
+            serverAssert(ret != 0);
+            aux = ll;
+        }
         lp = lpReplaceInteger(lp,&p,aux+1);
 
         /* Update the listpack with the new pointer. */
@@ -1304,23 +1315,85 @@ void streamIteratorRemoveEntry(streamIterator *si, streamID *current) {
 
     /* Re-seek the iterator to fix the now messed up state. */
     streamID start, end;
+    uint64_t raw_id[2];
     if (si->rev) {
-        streamDecodeID(si->start_key,&start);
+        memcpy(raw_id,si->start_key,sizeof(raw_id));
         end = *current;
     } else {
+        memcpy(raw_id,si->end_key,sizeof(raw_id));
         start = *current;
-        streamDecodeID(si->end_key,&end);
     }
-    streamIteratorStop(si);
-    streamIteratorStart(si,si->stream,&start,&end,si->rev);
+#if (BYTE_ORDER != BIG_ENDIAN)
+    unsigned char *x = (unsigned char *)raw_id, t;
+    t = x[0]; x[0] = x[7]; x[7] = t;
+    t = x[1]; x[1] = x[6]; x[6] = t;
+    t = x[2]; x[2] = x[5]; x[5] = t;
+    t = x[3]; x[3] = x[4]; x[4] = t;
+    x = (unsigned char *)(raw_id + 1);
+    t = x[0]; x[0] = x[7]; x[7] = t;
+    t = x[1]; x[1] = x[6]; x[6] = t;
+    t = x[2]; x[2] = x[5]; x[5] = t;
+    t = x[3]; x[3] = x[4]; x[4] = t;
+#endif
+    if (si->rev) {
+        start.ms = raw_id[0];
+        start.seq = raw_id[1];
+    } else {
+        end.ms = raw_id[0];
+        end.seq = raw_id[1];
+    }
+
+    /* Drop the current radix iterator before rebuilding the cursor. */
+    if (si->ri.key != si->ri.key_static_string) zfree(si->ri.key);
+    if (si->ri.stack.stack != si->ri.stack.static_items) zfree(si->ri.stack.stack);
+
+    /* Encode the rebuilt range as 128-bit big endian keys. */
+    uint64_t encoded[2];
+    encoded[0] = htonu64(start.ms);
+    encoded[1] = htonu64(start.seq);
+    memcpy(si->start_key,encoded,sizeof(encoded));
+    encoded[0] = htonu64(end.ms);
+    encoded[1] = htonu64(end.seq);
+    memcpy(si->end_key,encoded,sizeof(encoded));
+
+    si->ri.flags = RAX_ITER_EOF;
+    si->ri.rt = si->stream->rax;
+    si->ri.key_len = 0;
+    si->ri.key = si->ri.key_static_string;
+    si->ri.key_max = RAX_ITER_STATIC_LEN;
+    si->ri.data = NULL;
+    si->ri.node_cb = NULL;
+    si->ri.stack.stack = si->ri.stack.static_items;
+    si->ri.stack.items = 0;
+    si->ri.stack.maxitems = RAX_STACK_STATIC_ITEMS;
+    si->ri.stack.oom = 0;
+
+    if (!si->rev) {
+        if (start.ms || start.seq) {
+            raxSeek(&si->ri,"<=",(unsigned char*)si->start_key,
+                    sizeof(si->start_key));
+            if (si->ri.flags & RAX_ITER_EOF)
+                raxSeek(&si->ri,"^",NULL,0);
+        } else {
+            raxSeek(&si->ri,"^",NULL,0);
+        }
+    } else {
+        if (end.ms || end.seq) {
+            raxSeek(&si->ri,"<=",(unsigned char*)si->end_key,
+                    sizeof(si->end_key));
+            if (si->ri.flags & RAX_ITER_EOF)
+                raxSeek(&si->ri,"$",NULL,0);
+        } else {
+            raxSeek(&si->ri,"$",NULL,0);
+        }
+    }
+    si->lp = NULL;
+    si->lp_ele = NULL;
 
     /* TODO: perform a garbage collection here if the ration between
      * deleted and valid goes over a certain limit. */
 }
 
-/* Stop the stream iterator. The only cleanup we need is to free the rax
- * iterator, since the stream iterator itself is supposed to be stack
- * allocated. */
 void streamIteratorStop(streamIterator *si) {
     raxStop(&si->ri);
 }
