diff --git a/include/fmt/format.h b/include/fmt/format.h
index 4dc9e097..f5a4523d 100644
--- a/include/fmt/format.h
+++ b/include/fmt/format.h
@@ -1590,15 +1590,84 @@ template <typename Char, typename OutputIt>
 OutputIt write_nonfinite(OutputIt out, bool isinf,
                          const basic_format_specs<Char>& specs,
                          const float_specs& fspecs) {
-  auto str =
-      isinf ? (fspecs.upper ? "INF" : "inf") : (fspecs.upper ? "NAN" : "nan");
+  bool upper = fspecs.upper;
+  const char* str = "nan";
+  if (isinf) {
+    if (upper) {
+      str = "INF";
+    } else {
+      str = "inf";
+    }
+  } else if (upper) {
+    str = "NAN";
+  } else {
+    str = "nan";
+  }
   constexpr size_t str_size = 3;
-  auto sign = fspecs.sign;
-  auto size = str_size + (sign ? 1 : 0);
-  return write_padded(out, specs, size, [=](reserve_iterator<OutputIt> it) {
-    if (sign) *it++ = static_cast<Char>(data::signs[sign]);
-    return copy_str<Char>(str, str + str_size, it);
-  });
+  sign_t sign = fspecs.sign;
+  size_t prefix_size = 0;
+  if (sign) {
+    prefix_size = 1;
+  }
+  size_t size = str_size + prefix_size;
+  int width_field = specs.width;
+  unsigned spec_width = to_unsigned(width_field);
+  size_t padding = 0;
+  if (spec_width > size) {
+    padding = spec_width - size;
+  }
+  align_t alignment = specs.align;
+  const char* shifts = data::left_padding_shifts;
+  unsigned shift = static_cast<unsigned>(shifts[alignment]);
+  size_t left_padding = padding >> shift;
+  size_t right_padding = padding - left_padding;
+  fill_t<Char> fill = specs.fill;
+  size_t fill_size = fill.size();
+  const Char* fill_data = fill.data();
+  Char fill_buffer[4];
+  for (size_t i = 0; i < fill_size; ++i) {
+    fill_buffer[i] = fill_data[i];
+  }
+  size_t reserved = size + padding * fill_size;
+  auto it = reserve(out, reserved);
+  if (left_padding != 0) {
+    if (fill_size == 1) {
+      Char fill_char = fill_buffer[0];
+      for (size_t n = 0; n < left_padding; ++n) {
+        *it++ = fill_char;
+      }
+    } else {
+      for (size_t n = 0; n < left_padding; ++n) {
+        for (size_t k = 0; k < fill_size; ++k) {
+          *it++ = fill_buffer[k];
+        }
+      }
+    }
+  }
+  if (sign) {
+    char sign_char = data::signs[sign];
+    *it++ = static_cast<Char>(sign_char);
+  }
+  Char mapped[3];
+  for (size_t i = 0; i < str_size; ++i) {
+    mapped[i] = static_cast<Char>(str[i]);
+  }
+  it = copy_str<Char>(mapped, mapped + str_size, it);
+  if (right_padding != 0) {
+    if (fill_size == 1) {
+      Char fill_char = fill_buffer[0];
+      for (size_t n = 0; n < right_padding; ++n) {
+        *it++ = fill_char;
+      }
+    } else {
+      for (size_t n = 0; n < right_padding; ++n) {
+        for (size_t k = 0; k < fill_size; ++k) {
+          *it++ = fill_buffer[k];
+        }
+      }
+    }
+  }
+  return base_iterator(out, it);
 }
 
