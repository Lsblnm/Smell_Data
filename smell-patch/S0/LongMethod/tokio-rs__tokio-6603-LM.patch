+        if released {
+            let mut remaining = occupied;
+            let mut index = 0usize;
+            while index < capacity {
+                if index == offset {
+                    if (remaining & 1) == 1 {
+                        return true;
+                    }
+                    let bit = 1usize << offset;
+                    return (ready_bits & bit) == bit;
+                }
+                remaining >>= 1;
+                index += 1;
+            }
+            return false;
+        }
+
+        if tx_closed {
+            let mut remaining = occupied;
+            let mut index = 0usize;
+            while index < capacity {
+                if index == offset {
+                    if (remaining & 1) == 1 {
+                        return true;
+                    }
+                    return is_ready(ready_bits, offset);
+                }
+                remaining >>= 1;
+                index += 1;
+            }
+            return false;
+        }
+
+        let mut remaining = occupied;
+        let mut index = 0usize;
+        let mut found = false;
+        while index < capacity {
+            if index == offset {
+                if (remaining & 1) == 1 {
+                    found = true;
+                } else {
+                    let bit = 1usize << offset;
+                    found = (ready_bits & bit) == bit;
+                }
+                break;
+            }
+            remaining >>= 1;
+            index += 1;
+        }
+
+        if found {
+            true
+        } else {
+            is_ready(ready_bits, offset)
+        }
     }
 
