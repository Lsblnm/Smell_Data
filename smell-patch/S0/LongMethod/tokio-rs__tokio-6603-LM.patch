+        let tx_closed = (ready_bits & closed_flag) == closed_flag;
+        let all_slots_ready = occupied == ready_mask;
+
+        if all_slots_ready {
+            let bit = 1usize << offset;
+            return (occupied & bit) == bit;
+        }
+
+        if offset == 0 {
+            if (occupied & 1) == 1 {
+                return true;
+            }
+            if released {
+                return (ready_bits & 1) == 1;
