diff --git a/lib/rubocop/runner.rb b/lib/rubocop/runner.rb
index 51f18dca0..c76c78fcf 100644
--- a/lib/rubocop/runner.rb
+++ b/lib/rubocop/runner.rb
@@ -436,17 +436,93 @@ module RuboCop
       !offense.corrected? && offense.severity >= minimum_severity_to_fail
     end
 
+    # rubocop:disable Metrics/MethodLength, Metrics/AbcSize, Metrics/CyclomaticComplexity, Metrics/PerceivedComplexity, Metrics/BlockLength
     def offenses_to_report(offenses)
-      if @options[:display_only_fail_level_offenses]
-        offenses.select { |o| considered_failure?(o) }
-      elsif @options[:display_only_safe_correctable]
-        offenses.select { |o| supports_safe_autocorrect?(o) }
-      elsif @options[:display_only_correctable]
-        offenses.select(&:correctable?)
+      display_fail_level = @options[:display_only_fail_level_offenses]
+      display_safe_correctable = @options[:display_only_safe_correctable]
+      display_correctable = @options[:display_only_correctable]
+
+      if display_fail_level
+        selected = []
+        offenses.each do |offense|
+          selected << offense if considered_failure?(offense)
+        end
+        selected
+      elsif display_safe_correctable
+        selected = []
+        default_configuration = RuboCop::ConfigLoader.default_configuration
+        cop_registry = Cop::Registry.global
+        cops_by_name = cop_registry.to_h
+
+        offenses.each do |offense|
+          status = offense.status
+          next if status == :unsupported
+
+          raw_cop_name = offense.cop_name.to_s
+          name_parts = raw_cop_name.split('/')
+          short_cop_name = name_parts.last
+          if name_parts.length > 1
+            department_name = name_parts[0..-2].join('/')
+            qualified_cop_name = "#{department_name}/#{short_cop_name}"
+          else
+            department_name = nil
+            qualified_cop_name = raw_cop_name
+          end
+
+          if short_cop_name == 'rspec'
+            short_cop_name = 'RSpec'
+          elsif short_cop_name.match?(/^[a-z]|_[a-z]/)
+            short_cop_name = short_cop_name.gsub(/^[a-z]|_[a-z]/) do |match|
+              match[-1, 1].upcase
+            end
+          end
+          if department_name
+            qualified_cop_name = "#{department_name}/#{short_cop_name}"
+          else
+            qualified_cop_name = short_cop_name
+          end
+
+          matched_cops = cops_by_name[qualified_cop_name]
+          cop_class = nil
+          if matched_cops
+            cop_class = matched_cops.first
+          end
+
+          supports_autocorrect = false
+          if cop_class
+            supports_autocorrect = cop_class.support_autocorrect?
+          end
+          next unless supports_autocorrect
+
+          cop_config = default_configuration[qualified_cop_name]
+          safe_cop = true
+          safe_autocorrect = true
+          if cop_config
+            safe_cop = cop_config.fetch('Safe', true)
+            if safe_cop
+              safe_autocorrect = cop_config.fetch('SafeAutoCorrect', true)
+            else
+              safe_autocorrect = false
+            end
+          end
+
+          if safe_cop
+            selected << offense if safe_autocorrect
+          end
+        end
+        selected
+      elsif display_correctable
+        selected = []
+        offenses.each do |offense|
+          status = offense.status
+          selected << offense if status != :unsupported
+        end
+        selected
       else
         offenses
       end
     end
+    # rubocop:enable Metrics/MethodLength, Metrics/AbcSize, Metrics/CyclomaticComplexity, Metrics/PerceivedComplexity, Metrics/BlockLength
 
     def supports_safe_autocorrect?(offense)
       cop_class = Cop::Registry.global.find_by_cop_name(offense.cop_name)
