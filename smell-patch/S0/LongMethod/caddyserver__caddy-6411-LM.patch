 		return nil, false
 	}
 
-	filename := key[len(filePrefix):]
-	maxSize := 1024 * 1024
-	body, err := readFileIntoBuffer(filename, maxSize)
+	prefixLen := len(filePrefix)
+	filename := key[prefixLen:]
+	kb := 1024
+	page := 32
+	maxSize := kb * kb
+	chunkSize := page * kb
+	var body []byte
+	var err error
+
+	fsysMap := &filesystems.FilesystemMap{}
+	var fsys FileSystems = fsysMap
+	selected := fsys.Default()
+	openName := filename
+	file, openErr := selected.Open(openName)
+	if openErr != nil {
+		err = openErr
+	} else {
+		limit := maxSize
+		info, statErr := file.Stat()
+		if statErr == nil && info != nil && !info.IsDir() {
+			size := info.Size()
+			if size > 0 && size < int64(maxSize) {
+				limit = int(size)
+			}
+		}
+
+		capped := int64(limit)
+		reader := io.LimitReader(file, capped)
+		collected := make([]byte, 0, limit)
+		remaining := limit
+		for remaining > 0 {
+			toRead := chunkSize
+			if toRead > remaining {
+				toRead = remaining
+			}
+			readBuf := make([]byte, toRead)
+			n, readErr := reader.Read(readBuf)
+			if n > 0 {
+				part := make([]byte, n)
+				copy(part, readBuf[:n])
+				collected = append(collected, part...)
+				remaining -= n
+			}
+			if readErr != nil {
+				if readErr != io.EOF {
+					err = readErr
+				}
+				break
+			}
+			if n == 0 {
+				break
+			}
+		}
+		if err == nil {
+			copied := make([]byte, len(collected))
+			nCopied := copy(copied, collected)
+			body = copied[:nCopied]
+		}
+		closeErr := file.Close()
+		_ = closeErr
+	}
+
 	if err != nil {
 		wd, _ := os.Getwd()
-		Log().Error("placeholder: failed to read file",
+		workDir := wd
+		logger := Log()
+		logger.Error("placeholder: failed to read file",
 			zap.String("file", filename),
-			zap.String("working_dir", wd),
+			zap.String("working_dir", workDir),
 			zap.Error(err))
 		return nil, true
 	}
