+static int collect_positional_arg(jv *positional,
+                                  jq_util_input_state *input_state,
+                                  const char *text,
+                                  int as_string,
+                                  int as_json) {
+  if (as_string) {
+    int length = (int)strlen(text);
+    const char *end = text + length;
+    jv str;
+    if (jvp_utf8_is_valid(text, end)) {
+      str = jv_string_sized(text, length);
+    } else {
+      uint32_t maxlength = (uint32_t)length * 3 + 1;
+      char *outbuf = jv_mem_alloc(maxlength);
+      char *out = outbuf;
+      const char *cursor = text;
+      int codepoint = 0;
+      while ((cursor = jvp_utf8_next(cursor, end, &codepoint))) {
+        if (codepoint == -1) {
+          codepoint = 0xFFFD;
+        }
+        out += jvp_utf8_encode(codepoint, out);
+      }
+      str = jv_string_sized(outbuf, (int)(out - outbuf));
+      jv_mem_free(outbuf);
+    }
+    *positional = jv_array_set(*positional, jv_array_length(jv_copy(*positional)), str);
+    return 0;
+  } else if (as_json) {
+    int length = (int)strlen(text);
+    const unsigned char utf8_bom[] = {0xEF, 0xBB, 0xBF};
+    unsigned bom_strip_position = 0;
+    const char *buf = text;
+    int remaining = length;
+    jv value;
+    while (remaining > 0 && bom_strip_position < sizeof(utf8_bom)) {
+      if ((unsigned char)*buf == utf8_bom[bom_strip_position]) {
+        buf++;
+        remaining--;
+        bom_strip_position++;
+      } else if (bom_strip_position == 0) {
+        bom_strip_position = (unsigned)sizeof(utf8_bom);
+      } else {
+        bom_strip_position = 0xff;
+      }
+    }
+    if (bom_strip_position == 0xff) {
+      value = jv_invalid_with_msg(jv_string("Malformed BOM"));
+    } else {
+      jv_parser *parser = jv_parser_new(0);
+      jv_parser_set_buf(parser, text, length, 0);
+      value = jv_parser_next(parser);
+      if (jv_is_valid(value)) {
+        jv next = jv_parser_next(parser);
+        if (jv_is_valid(next)) {
+          jv_free(value);
+          jv_free(next);
+          value = jv_invalid_with_msg(jv_string("Unexpected extra JSON values"));
+        } else if (jv_invalid_has_msg(jv_copy(next))) {
+          jv_free(value);
+          value = next;
+        } else {
+          jv_free(next);
+        }
+      } else if (jv_invalid_has_msg(jv_copy(value))) {
+        /* keep the parser error so callers can inspect it later */
+      } else {
+        jv_free(value);
+        value = jv_invalid_with_msg(jv_string("Expected JSON value"));
+      }
+      jv_parser_free(parser);
+    }
+    if (!jv_is_valid(value) && jv_invalid_has_msg(jv_copy(value))) {
+      jv msg = jv_invalid_get_msg(value);
+      value = jv_invalid_with_msg(jv_string_fmt("%s (while parsing '%s')",
+                                                jv_string_value(msg),
+                                                text));
+      jv_free(msg);
+    }
+    *positional = jv_array_set(*positional, jv_array_length(jv_copy(*positional)), value);
+    return 0;
+  }
+  jq_util_input_add_input(input_state, text);
+  return 1;
+}
