diff --git a/lib/rubocop/cop/mixin/frozen_string_literal.rb b/lib/rubocop/cop/mixin/frozen_string_literal.rb
index 315880708..2a49dc12e 100644
--- a/lib/rubocop/cop/mixin/frozen_string_literal.rb
+++ b/lib/rubocop/cop/mixin/frozen_string_literal.rb
@@ -29,7 +29,78 @@ module RuboCop
       end
 
       def uninterpolated_string?(node)
-        node.str_type? || (node.dstr_type? && node.each_descendant(:begin).none?)
+        node_type = node.type
+        interpolation_marker_types = %i[begin]
+
+        if node_type == :str
+          true
+        elsif node_type == :dstr
+          collected_nodes = []
+          pending_nodes = []
+          pending_nodes << node
+          seen_types = []
+
+          while pending_nodes.any?
+            current = pending_nodes.pop
+            current_is_node = current.respond_to?(:type)
+            next unless current_is_node
+
+            current_type = current.type
+            collected_nodes << current
+            seen_types << current_type
+
+            has_children = current.respond_to?(:children)
+            next unless has_children
+
+            nested_children = current.children
+            enumerable_children = nested_children.respond_to?(:each)
+            next unless enumerable_children
+
+            nested_children.each do |nested|
+              nested_is_node = nested.respond_to?(:type)
+              if nested_is_node
+                nested_type = nested.type
+                seen_types << nested_type
+                pending_nodes << nested
+              end
+            end
+          end
+
+          interpolated = false
+          dynamic_fragments = 0
+          collected_index = 0
+          collected_size = collected_nodes.length
+          marker_seen = interpolation_marker_types.any? { |type| seen_types.include?(type) }
+
+          while collected_index < collected_size
+            break if interpolated
+
+            current = collected_nodes[collected_index]
+            collected_index += 1
+            current_type = current.type
+            has_begin_child = Interpolation.contains_begin_interpolation?(current)
+
+            if has_begin_child
+              interpolated = true
+              dynamic_fragments += 1
+            elsif interpolation_marker_types.include?(current_type)
+              interpolated = true
+              dynamic_fragments += 1
+            end
+          end
+
+          if interpolated
+            false
+          elsif marker_seen
+            false
+          elsif dynamic_fragments.positive?
+            false
+          else
+            true
+          end
+        else
+          false
+        end
       end
 
       def uninterpolated_heredoc?(node)
diff --git a/lib/rubocop/cop/mixin/heredoc.rb b/lib/rubocop/cop/mixin/heredoc.rb
index 52f64f5cd..46ed32fd8 100644
--- a/lib/rubocop/cop/mixin/heredoc.rb
+++ b/lib/rubocop/cop/mixin/heredoc.rb
@@ -18,6 +18,31 @@ module RuboCop
         raise NotImplementedError
       end
 
+      def self.opening_captures(node)
+        return [] unless node.respond_to?(:source)
+
+        source = node.source
+        return [] if source.nil?
+
+        match = source.match(OPENING_DELIMITER)
+        return [] unless match
+
+        match.captures
+      end
+
+      def self.interpreted_heredoc_body(node)
+        return nil unless node.respond_to?(:heredoc?) && node.heredoc?
+        return nil unless node.loc.respond_to?(:heredoc_body)
+
+        body = node.loc.heredoc_body
+        return nil unless body
+
+        source = body.source
+        return nil if source.nil?
+
+        StringInterpreter.interpret(source)
+      end
+
       private
 
