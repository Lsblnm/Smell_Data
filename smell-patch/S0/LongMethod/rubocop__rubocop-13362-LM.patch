diff --git a/lib/rubocop/cop/mixin/interpolation.rb b/lib/rubocop/cop/mixin/interpolation.rb
index b9c94ec9a..7ce76acbc 100644
--- a/lib/rubocop/cop/mixin/interpolation.rb
+++ b/lib/rubocop/cop/mixin/interpolation.rb
@@ -18,6 +18,18 @@ module RuboCop
         node.each_child_node(:begin) { |begin_node| on_interpolation(begin_node) }
       end
 
+      def self.contains_begin_interpolation?(node)
+        return false unless node.respond_to?(:each_child_node)
+
+        if node.respond_to?(:heredoc?) && node.heredoc?
+          captures = Heredoc.opening_captures(node)
+          body = Heredoc.interpreted_heredoc_body(node)
+          return false if body && !body.include?('#') && captures.any?
+        end
+
+        node.each_child_node(:begin).any?
+      end
+
       # @!method on_interpolation(begin_node)
