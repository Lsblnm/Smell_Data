+func copyCookieHeaderValues(values []string) []string {
+	if values == nil {
+		return nil
+	}
+	copied := make([]string, 0, len(values))
+	for _, value := range values {
+		copied = append(copied, rewriteCookieLine(value))
+	}
+	return copied
+}
