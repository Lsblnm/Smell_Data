diff --git a/include/fmt/format.h b/include/fmt/format.h
index a4a07899..37c670e6 100644
--- a/include/fmt/format.h
+++ b/include/fmt/format.h
@@ -4126,13 +4126,100 @@ template <typename T> struct formatter<group_digits_view<T>> : formatter<T> {
   auto format(group_digits_view<T> t, FormatContext& ctx) const
       -> decltype(ctx.out()) {
     auto specs = specs_;
-    detail::handle_dynamic_spec<detail::width_checker>(specs.width,
-                                                       specs.width_ref, ctx);
+    if (specs.width_ref.kind != detail::arg_id_kind::none) {
+      auto width_arg = specs.width_ref.kind == detail::arg_id_kind::index
+                           ? ctx.arg(specs.width_ref.val.index)
+                           : ctx.arg(specs.width_ref.val.name);
+      if (!width_arg) FMT_THROW(format_error("argument not found"));
+      unsigned long long width_value = width_arg.visit(detail::width_checker());
+      if (width_value > detail::to_unsigned(detail::max_value<int>()))
+        FMT_THROW(format_error("number is too big"));
+      specs.width = static_cast<int>(width_value);
+    }
     detail::handle_dynamic_spec<detail::precision_checker>(
         specs.precision, specs.precision_ref, ctx);
-    return detail::write_int(ctx.out(),
-                             static_cast<detail::uint64_or_128_t<T>>(t.value),
-                             0, specs, detail::digit_grouping<char>("\3", ","));
+
+    using uint_type = detail::uint64_or_128_t<T>;
+    auto abs_value = static_cast<uint_type>(t.value);
+    unsigned prefix = 0;
+    auto out = ctx.out();
+    if (specs.type != presentation_type::none &&
+        specs.type != presentation_type::dec) {
+      return detail::write_int(out, abs_value, prefix, specs,
+                               detail::digit_grouping<char>("\3", ","));
+    } else {
+      int num_digits = detail::count_digits(abs_value);
+      char digit_storage[detail::digits10<uint_type>() + 1] = {};
+      char* digit_ptr = digit_storage + num_digits;
+      auto remaining = abs_value;
+      while (remaining >= 100) {
+        digit_ptr -= 2;
+        detail::copy2(digit_ptr,
+                      detail::digits2(static_cast<size_t>(remaining % 100)));
+        remaining /= 100;
+      }
+      if (remaining < 10) {
+        *--digit_ptr = static_cast<char>('0' + remaining);
+      } else {
+        digit_ptr -= 2;
+        detail::copy2(digit_ptr,
+                      detail::digits2(static_cast<size_t>(remaining)));
+      }
+
+      std::string grouping("\3", 1);
+      std::basic_string<char> thousands_sep(1, ',');
+      int group_size =
+          static_cast<int>(static_cast<unsigned char>(grouping[0]));
+      int sep_count = 0;
+      int next_group = group_size;
+      while (num_digits > next_group) {
+        ++sep_count;
+        next_group += group_size;
+      }
+
+      unsigned prefix_size = prefix >> 24;
+      unsigned size = prefix_size + detail::to_unsigned(num_digits) +
+                      detail::to_unsigned(sep_count);
+      unsigned spec_width = detail::to_unsigned(specs.width);
+      size_t padding = spec_width > size ? spec_width - size : 0;
+      auto* shifts = "\x00\x1f\x00\x01";
+      size_t left_padding = padding >> shifts[specs.align];
+      size_t right_padding = padding - left_padding;
+      auto it = detail::reserve(out, size + padding * specs.fill.size());
+      if (left_padding != 0)
+        it = detail::fill<char>(it, left_padding, specs.fill);
+
+      unsigned prefix_chars = prefix & 0xffffff;
+      while (prefix_chars != 0) {
+        *it++ = static_cast<char>(prefix_chars & 0xff);
+        prefix_chars >>= 8;
+      }
+
+      auto separators = basic_memory_buffer<int>();
+      separators.push_back(0);
+      next_group = group_size;
+      while (next_group < num_digits) {
+        separators.push_back(next_group);
+        next_group += group_size;
+      }
+
+      int sep_index = static_cast<int>(separators.size() - 1);
+      for (int i = 0; i < num_digits; ++i) {
+        if (num_digits - i == separators[sep_index]) {
+          const char* sep_begin = thousands_sep.data();
+          const char* sep_end = sep_begin + thousands_sep.size();
+          while (sep_begin != sep_end) {
+            *it++ = static_cast<char>(*sep_begin++);
+          }
+          --sep_index;
+        }
+        *it++ = static_cast<char>(digit_ptr[detail::to_unsigned(i)]);
+      }
+
+      if (right_padding != 0)
+        it = detail::fill<char>(it, right_padding, specs.fill);
+      return detail::base_iterator(out, it);
+    }
   }
 };
 
