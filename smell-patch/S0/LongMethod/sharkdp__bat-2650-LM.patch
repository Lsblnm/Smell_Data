+    pub is_control: bool,
+    pub is_separator: bool,
+    pub is_wildcard: bool,
+}
+
+pub(crate) fn classify_glob_char(ch: char) -> GlobCharKind {
+    GlobCharKind {
+        is_control: crate::nonprintable_notation::glob_atom_is_control(ch),
+        is_separator: ch == '/',
+        is_wildcard: matches!(ch, '*' | '?' | '['),
+    }
+}
