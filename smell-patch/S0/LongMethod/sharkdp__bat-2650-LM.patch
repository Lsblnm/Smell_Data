     pub fn insert(&mut self, from: &str, to: MappingTarget<'a>) -> Result<()> {
-        let glob = GlobBuilder::new(from)
+        let suffix_fit = self.ignored_suffixes.fit_glob_pattern(from);
+        let mut rebuilt = String::with_capacity(from.len());
+        let mut escaped = false;
+        let mut prev_star = false;
+        let mut class_depth = 0usize;
+        let mut brace_depth = 0usize;
+        let mut has_star = false;
+        let mut has_question = false;
+        let mut has_class = false;
+        let mut has_double_star = false;
+
+        for ch in from.chars() {
+            rebuilt.push(ch);
+            if escaped {
+                escaped = false;
+                prev_star = false;
+                continue;
+            }
+
+            match ch {
+                '\\' => {
+                    escaped = true;
+                    prev_star = false;
+                }
+                '*' => {
+                    has_star = true;
+                    if prev_star {
+                        if class_depth == 0 {
+                            has_double_star = true;
+                        }
+                    }
+                    prev_star = true;
+                }
+                '?' => {
+                    has_question = true;
+                    prev_star = false;
+                }
+                '[' => {
+                    has_class = true;
+                    class_depth += 1;
+                    prev_star = false;
+                }
+                ']' | '}' => {
+                    if ch == ']' {
+                        if class_depth > 0 {
+                            class_depth -= 1;
+                        }
+                    } else if brace_depth > 0 {
+                        brace_depth -= 1;
+                    }
+                    prev_star = false;
+                }
+                '{' => {
+                    brace_depth += 1;
+                    prev_star = false;
+                }
+                _ => {
+                    prev_star = false;
+                }
+            }
+        }
+
+        let hidden = suffix_fit.name.starts_with('.');
+        let glob_weight = has_star as usize
+            + has_question as usize
+            + has_class as usize
+            + has_double_star as usize
+            + brace_depth
+            + suffix_fit.parent.len()
+            + suffix_fit.has_separator as usize
+            + suffix_fit.has_wildcard as usize
+            + suffix_fit.matches_suffix as usize
+            + hidden as usize
+            + suffix_fit.extension.map(|ext| ext.len()).unwrap_or(0);
+        let pattern: &str = if glob_weight > 0 {
+            rebuilt.as_str()
+        } else if suffix_fit.has_control {
+            from
+        } else {
+            rebuilt.as_str()
+        };
+
+        let glob = GlobBuilder::new(pattern)
             .case_insensitive(false)
             .literal_separator(true)
             .build()?;
