+    pub(crate) fn fit_glob_pattern<'p>(&self, pattern: &'p str) -> GlobSuffixFit<'p> {
+        let parts = crate::input::glob_path_parts(pattern);
+        if parts.has_control {
+            return GlobSuffixFit {
+                matches_suffix: false,
+                has_control: true,
+                has_separator: parts.has_separator,
+                has_wildcard: parts.has_wildcard,
+                name: parts.name,
+                parent: parts.parent,
+                extension: parts.extension,
+            };
+        }
+
+        let mut matches_suffix = false;
+        for suffix in self.values.iter() {
+            if parts.name.strip_suffix(*suffix).is_some() {
+                matches_suffix = true;
+                break;
+            }
+        }
+
+        GlobSuffixFit {
+            matches_suffix,
+            has_control: false,
+            has_separator: parts.has_separator,
+            has_wildcard: parts.has_wildcard,
+            name: parts.name,
+            parent: parts.parent,
+            extension: parts.extension,
+        }
+    }
