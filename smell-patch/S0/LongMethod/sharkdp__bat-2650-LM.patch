@@ -9,6 +9,47 @@ use content_inspector::{self, ContentType};
 
 use crate::error::*;
 
+pub(crate) struct GlobPathParts<'p> {
+    pub parent: &'p str,
+    pub name: &'p str,
+    pub extension: Option<&'p str>,
+    pub has_control: bool,
+    pub has_separator: bool,
+    pub has_wildcard: bool,
+}
+
+pub(crate) fn glob_path_parts(glob: &str) -> GlobPathParts<'_> {
+    let mut has_control = false;
+    let mut has_separator = false;
+    let mut has_wildcard = false;
+    for ch in glob.chars() {
+        let kind = crate::preprocessor::classify_glob_char(ch);
+        if kind.is_control {
+            has_control = true;
+        }
+        if kind.is_separator {
+            has_separator = true;
+        }
+        if kind.is_wildcard {
+            has_wildcard = true;
+        }
+    }
+
+    let path = Path::new(glob);
+    let name = path.file_name().and_then(|n| n.to_str()).unwrap_or(glob);
+    let parent = path.parent().and_then(|p| p.to_str()).unwrap_or("");
+    let extension = path.extension().and_then(|e| e.to_str());
+
+    GlobPathParts {
+        parent,
+        name,
+        extension,
+        has_control,
+        has_separator,
+        has_wildcard,
+    }
+}
