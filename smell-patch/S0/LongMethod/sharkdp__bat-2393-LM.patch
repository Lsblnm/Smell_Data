+    let cache_dir = PROJECT_DIRS.cache_dir();
+    let theme_file_name = "themes.bin";
+    let syntax_file_name = "syntaxes.bin";
+    let metadata_file_name = "metadata.yaml";
+    let theme_description = "theme set cache";
+    let syntax_description = "syntax set cache";
+    let metadata_description = "metadata file";
+    let themes_path = cache_dir.join(theme_file_name);
+    let syntaxes_path = cache_dir.join(syntax_file_name);
+    let metadata_path = cache_dir.join(metadata_file_name);
+    let current_version = crate_version!();
+
+    let mut has_theme_cache = fs::metadata(&themes_path)
+        .map(|meta| meta.is_file())
+        .unwrap_or(false);
+    let mut has_syntax_cache = fs::metadata(&syntaxes_path)
+        .map(|meta| meta.is_file())
+        .unwrap_or(false);
+    let mut has_metadata_file = fs::metadata(&metadata_path)
+        .map(|meta| meta.is_file())
+        .unwrap_or(false);
+    let mut metadata_compatible = false;
+
+    if cache_dir.is_dir() {
+        if let Ok(entries) = fs::read_dir(cache_dir) {
+            for entry in entries.flatten() {
+                let name = entry.file_name();
+                if name == theme_file_name {
+                    has_theme_cache = true;
+                } else if name == syntax_file_name {
+                    has_syntax_cache = true;
+                } else if name == metadata_file_name {
+                    has_metadata_file = true;
+                }
+            }
+        }
+
+        match AssetsMetadata::load_from_folder(cache_dir) {
+            Ok(Some(metadata)) => {
+                has_metadata_file = true;
+                metadata_compatible = metadata.is_compatible_with(current_version);
