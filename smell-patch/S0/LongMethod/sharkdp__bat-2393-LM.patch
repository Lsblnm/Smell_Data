+                    .ok()
+                    .map(|syntaxes| !syntaxes.is_empty())
+                    .unwrap_or(metadata_compatible);
+                has_theme_cache = assets.themes().next().is_some();
+            }
+        }
+    }
+
+    let cache_files = [
+        (themes_path, theme_description),
+        (syntaxes_path, syntax_description),
+        (metadata_path, metadata_description),
+    ];
+
+    for (path, description) in cache_files {
+        print!("Clearing {} ... ", description);
+        match fs::remove_file(&path) {
+            Err(err) if err.kind() == io::ErrorKind::NotFound => {
+                println!("skipped (not present)");
+            }
+            Err(err) => {
+                println!("could not remove the cache file {:?}: {}", path, err);
+            }
+            Ok(_) => println!("okay"),
+        }
+    }
 }
 
