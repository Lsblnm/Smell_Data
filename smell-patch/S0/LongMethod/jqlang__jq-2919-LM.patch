+static int take_cli_argument(const char *arg,
+                             int *args_done,
+                             const char **program,
+                             int further_args_are_strings,
+                             int further_args_are_json,
+                             jv *positional,
+                             jq_util_input_state *input_state,
+                             int *nfiles) {
+  int looks_like_option = isoptish(arg);
+  int is_end_of_opts = 0;
+
+  if (looks_like_option) {
+    if (arg[1] == '-') {
+      if (arg[2] == '\0') {
+        is_end_of_opts = 1;
+      }
+    }
+  }
+
+  if (!*args_done) {
+    if (is_end_of_opts) {
+      if (*program == NULL) {
+        usage(2, 1);
+      }
+      *args_done = 1;
+      return 1;
+    } else if (!looks_like_option) {
+      if (*program == NULL) {
+        *program = arg;
+        return 1;
+      }
+    } else {
+      return 0;
+    }
+  }
+
+  if (further_args_are_strings) {
+    int nbytes = 0;
+    const char *cursor = arg;
+    while (*cursor != '\0') {
+      nbytes++;
+      cursor++;
+    }
+    jv piece = jv_string_sized(arg, nbytes);
+    int idx = jv_array_length(jv_copy(*positional));
+    *positional = jv_array_set(*positional, idx, piece);
+  } else if (further_args_are_json) {
+    int nbytes = (int)strlen(arg);
+    jv_parser *parser = jv_parser_new(0);
+    jv_parser_set_buf(parser, arg, nbytes, 0);
+    jv value = jv_parser_next(parser);
+    if (jv_get_kind(value) != JV_KIND_INVALID) {
+      jv extra = jv_parser_next(parser);
+      if (jv_get_kind(extra) != JV_KIND_INVALID) {
+        jv_free(value);
+        jv_free(extra);
+        value = jv_invalid_with_msg(jv_string("Unexpected extra JSON values"));
+      } else {
+        if (jv_invalid_has_msg(jv_copy(extra))) {
+          jv_free(value);
+          value = extra;
+        } else {
+          jv_free(extra);
+        }
+      }
+    } else if (!jv_invalid_has_msg(jv_copy(value))) {
+      jv_free(value);
+      value = jv_invalid_with_msg(jv_string("Expected JSON value"));
+    }
+    jv_parser_free(parser);
+    if (jv_get_kind(value) == JV_KIND_INVALID) {
+      if (jv_invalid_has_msg(jv_copy(value))) {
+        jv msg = jv_invalid_get_msg(value);
+        const char *detail = jv_string_value(msg);
+        value = jv_invalid_with_msg(jv_string_fmt("%s (while parsing '%s')",
+                                                  detail,
+                                                  arg));
+        jv_free(msg);
+      }
+      jv_free(value);
+      fprintf(stderr, "%s: invalid JSON text passed to --jsonargs\n", progname);
+      die();
+    }
+    int idx = jv_array_length(jv_copy(*positional));
+    *positional = jv_array_set(*positional, idx, value);
+  } else {
+    int next_count = input_state->nfiles + 1;
+    size_t bytes = ((size_t)next_count) * sizeof(input_state->files[0]);
+    char **grown = jv_mem_realloc(input_state->files, bytes);
+    input_state->files = grown;
+    grown[input_state->nfiles] = jv_mem_strdup(arg);
+    input_state->nfiles = next_count;
+    *nfiles = *nfiles + 1;
+  }
+  return 1;
+}
