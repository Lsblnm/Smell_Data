diff --git a/src/acl.c b/src/acl.c
index 2f39e1fdc..a0ff0f962 100644
--- a/src/acl.c
+++ b/src/acl.c
@@ -382,20 +382,118 @@ aclSelector *ACLUserGetRootSelector(user *u) {
 user *ACLCreateUser(const char *name, size_t namelen) {
     if (raxFind(Users,(unsigned char*)name,namelen) != raxNotFound) return NULL;
     user *u = zmalloc(sizeof(*u));
-    u->name = sdsnewlen(name,namelen);
+
+    /* Encode the username as an SDS string with the matching header type. */
+    if (namelen < (1<<8)) {
+        if (namelen != 0) {
+            if (namelen < (1<<5)) {
+                int hdrlen = sizeof(struct sdshdr5);
+                void *hdr = zmalloc(hdrlen+namelen+1);
+                sds username = (char*)hdr+hdrlen;
+                unsigned char *fp = ((unsigned char*)username)-1;
+                *fp = SDS_TYPE_5 | (namelen << SDS_TYPE_BITS);
+                memcpy(username,name,namelen);
+                username[namelen] = '\0';
+                u->name = username;
+            } else {
+                size_t usable;
+                int hdrlen = sizeof(struct sdshdr8);
+                void *hdr = zmalloc_usable(hdrlen+namelen+1,&usable);
+                sds username = (char*)hdr+hdrlen;
+                unsigned char *fp = ((unsigned char*)username)-1;
+                usable = usable-hdrlen-1;
+                if (usable > ((size_t)(1<<8)-1)) usable = (size_t)(1<<8)-1;
+                struct sdshdr8 *sh = (void*)(username-sizeof(struct sdshdr8));
+                sh->len = namelen;
+                sh->alloc = usable;
+                *fp = SDS_TYPE_8;
+                memcpy(username,name,namelen);
+                username[namelen] = '\0';
+                u->name = username;
+            }
+        } else {
+            size_t usable;
+            int hdrlen = sizeof(struct sdshdr8);
+            void *hdr = zmalloc_usable(hdrlen+1,&usable);
+            sds username = (char*)hdr+hdrlen;
+            unsigned char *fp = ((unsigned char*)username)-1;
+            usable = usable-hdrlen-1;
+            if (usable > ((size_t)(1<<8)-1)) usable = (size_t)(1<<8)-1;
+            struct sdshdr8 *sh = (void*)(username-sizeof(struct sdshdr8));
+            sh->len = 0;
+            sh->alloc = usable;
+            *fp = SDS_TYPE_8;
+            username[0] = '\0';
+            u->name = username;
+        }
+    } else if (namelen < (1<<16)) {
+        size_t usable;
+        int hdrlen = sizeof(struct sdshdr16);
+        void *hdr = zmalloc_usable(hdrlen+namelen+1,&usable);
+        sds username = (char*)hdr+hdrlen;
+        unsigned char *fp = ((unsigned char*)username)-1;
+        usable = usable-hdrlen-1;
+        if (usable > ((size_t)(1<<16)-1)) usable = (size_t)(1<<16)-1;
+        struct sdshdr16 *sh = (void*)(username-sizeof(struct sdshdr16));
+        sh->len = namelen;
+        sh->alloc = usable;
+        *fp = SDS_TYPE_16;
+        memcpy(username,name,namelen);
+        username[namelen] = '\0';
+        u->name = username;
+    } else {
+        u->name = sdsnewlen(name,namelen);
+    }
+
     u->flags = USER_FLAG_DISABLED;
-    u->passwords = listCreate();
+
+    list *passwords = zmalloc(sizeof(*passwords));
+    memset(passwords,0,sizeof(*passwords));
+    u->passwords = passwords;
     listSetMatchMethod(u->passwords,ACLListMatchSds);
     listSetFreeMethod(u->passwords,ACLListFreeSds);
     listSetDupMethod(u->passwords,ACLListDupSds);
 
-    u->selectors = listCreate();
+    list *selectors = zmalloc(sizeof(*selectors));
+    memset(selectors,0,sizeof(*selectors));
+    u->selectors = selectors;
     listSetFreeMethod(u->selectors,ACLListFreeSelector);
     listSetDupMethod(u->selectors,ACLListDuplicateSelector);
 
-    /* Add the initial root selector */
-    aclSelector *s = ACLCreateSelector(SELECTOR_FLAG_ROOT);
-    listAddNodeHead(u->selectors, s);
+    aclSelector *selector = zmalloc(sizeof(*selector));
+    selector->flags = SELECTOR_FLAG_ROOT;
+    if (server.acl_pubsub_default) {
+        if (server.acl_pubsub_default & SELECTOR_FLAG_ALLCHANNELS) {
+            selector->flags |= SELECTOR_FLAG_ALLCHANNELS;
+        }
+        selector->flags |= (server.acl_pubsub_default & ~SELECTOR_FLAG_ALLCHANNELS);
+    }
+    selector->allowed_firstargs = NULL;
+
+    list *patterns = zmalloc(sizeof(*patterns));
+    memset(patterns,0,sizeof(*patterns));
+    selector->patterns = patterns;
+    listSetMatchMethod(selector->patterns,ACLListMatchKeyPattern);
+    listSetFreeMethod(selector->patterns,ACLListFreeKeyPattern);
+    listSetDupMethod(selector->patterns,ACLListDupKeyPattern);
+
+    list *channels = zmalloc(sizeof(*channels));
+    memset(channels,0,sizeof(*channels));
+    selector->channels = channels;
+    listSetMatchMethod(selector->channels,ACLListMatchSds);
+    listSetFreeMethod(selector->channels,ACLListFreeSds);
+    listSetDupMethod(selector->channels,ACLListDupSds);
+
+    size_t nwords = sizeof(selector->allowed_commands)/sizeof(selector->allowed_commands[0]);
+    for (size_t i = 0; i < nwords; i++) {
+        selector->allowed_commands[i] = 0;
+    }
+
+    listNode *node = zmalloc(sizeof(*node));
+    node->value = selector;
+    node->prev = node->next = NULL;
+    u->selectors->head = u->selectors->tail = node;
+    u->selectors->len = 1;
 
     raxInsert(Users,(unsigned char*)name,namelen,u,NULL);
     return u;
