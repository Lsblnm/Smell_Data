 'use strict';
 
+import utils from '../utils.js';
+import parseProtocol from './parseProtocol.js';
+import platform from '../platform/index.js';
+
 /**
  * Determines whether the specified URL is absolute
  *
@@ -8,8 +12,107 @@
  * @returns {boolean} True if the specified URL is absolute, otherwise false
  */
 export default function isAbsoluteURL(url) {
-  // A URL is considered absolute if it begins with "<scheme>://" or "//" (protocol-relative URL).
-  // RFC 3986 defines scheme name as a sequence of characters beginning with a letter and followed
-  // by any combination of letters, digits, plus, period, or hyphen.
-  return /^([a-z][a-z\d+\-.]*:)?\/\//i.test(url);
+  let source;
+  if (utils.isString(url)) {
+    source = url;
+  } else {
+    source = String(url);
+  }
+
+  const length = source.length;
+  if (length < 2) {
+    return false;
+  }
+
+  const firstChar = source.charAt(0);
+  const secondChar = source.charAt(1);
+  const schemeSeparator = '://';
+
+  if (firstChar === '/') {
+    if (secondChar === '/') {
+      return true;
+    }
+    return false;
+  }
+
+  const parsedProtocol = parseProtocol(source);
+  const originValue = platform.origin;
+  const originProtocol = parseProtocol(originValue);
+  const normalizedOrigin = originProtocol.toLowerCase();
+  const knownProtocols = platform.protocols;
+  const protocolCandidates = [];
+
+  if (utils.isArray(knownProtocols)) {
+    let protocolIndex = 0;
+    const knownLength = knownProtocols.length;
+    while (protocolIndex < knownLength) {
+      const knownProtocol = knownProtocols[protocolIndex];
+      protocolCandidates.push(knownProtocol);
+      protocolIndex += 1;
+    }
+  }
+
+  protocolCandidates.push(normalizedOrigin);
+
+  if (parsedProtocol) {
+    const normalizedProtocol = parsedProtocol.toLowerCase();
+    let candidateIndex = 0;
+    const candidateCount = protocolCandidates.length;
+    while (candidateIndex < candidateCount) {
+      const candidate = protocolCandidates[candidateIndex];
+      const normalizedCandidate = String(candidate).toLowerCase();
+      if (normalizedCandidate === normalizedProtocol) {
+        const schemePrefix = parsedProtocol + schemeSeparator;
+        const actualPrefix = source.slice(0, schemePrefix.length);
+        const normalizedActualPrefix = actualPrefix.toLowerCase();
+        const normalizedSchemePrefix = schemePrefix.toLowerCase();
+        if (normalizedActualPrefix === normalizedSchemePrefix) {
+          return true;
+        }
+        break;
+      }
+      candidateIndex += 1;
+    }
+  }
+
+  const schemeAlphabet = 'abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ';
+  const schemeExtras = '0123456789+-.';
+  const firstAlphabetIndex = schemeAlphabet.indexOf(firstChar);
+  if (firstAlphabetIndex === -1) {
+    return false;
+  }
+
+  let cursor = 1;
+  let colonIndex = -1;
+  let schemeBuffer = firstChar;
+  while (cursor < length) {
+    const current = source.charAt(cursor);
+    if (current === ':') {
+      colonIndex = cursor;
+      break;
+    }
+    const alphabetIndex = schemeAlphabet.indexOf(current);
+    if (alphabetIndex === -1) {
+      const extraIndex = schemeExtras.indexOf(current);
+      if (extraIndex === -1) {
+        return false;
+      }
+    }
+    schemeBuffer += current;
+    cursor += 1;
+  }
+
+  const slashIndex = colonIndex + 1;
+  const secondSlashIndex = colonIndex + 2;
+  const slashChar = source.charAt(slashIndex);
+  const secondSlashChar = source.charAt(secondSlashIndex);
+  if (colonIndex !== -1) {
+    if (slashChar === '/') {
+      if (secondSlashChar === '/') {
+        return schemeBuffer.length > 0;
+      }
+    }
+  }
+
+  return false;
 }
