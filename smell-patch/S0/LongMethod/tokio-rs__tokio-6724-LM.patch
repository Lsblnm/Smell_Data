+pub(super) struct BufWriteView<'a> {
+    remaining: usize,
+    writable: &'a [u8],
+}
+
+impl<'a> BufWriteView<'a> {
+    pub(super) fn from_buf<B: Buf>(buf: &'a B) -> Self {
+        let remaining = buf.remaining();
+        let chunk = buf.chunk();
+        let writable = super::write::writable_slice(chunk);
+        Self {
+            remaining,
+            writable,
+        }
+    }
+
+    pub(super) fn remaining(&self) -> usize {
+        self.remaining
+    }
+
+    pub(super) fn writable(&self) -> &'a [u8] {
+        self.writable
+    }
+}
