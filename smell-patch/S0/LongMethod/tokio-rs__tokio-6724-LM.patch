+pub(super) fn first_slice_bytes(chunk: &[u8]) -> &[u8] {
+    let slices = [IoSlice::new(chunk)];
+    let selected = super::super::async_write::first_non_empty_write_buf(&slices);
+    if selected.is_empty() {
+        super::super::async_write::empty_write_bytes()
+    } else {
+        chunk
+    }
+}
