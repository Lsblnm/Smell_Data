diff --git a/fastlane/lib/fastlane/actions/zip.rb b/fastlane/lib/fastlane/actions/zip.rb
index fe4937f31..44b5cd91e 100644
--- a/fastlane/lib/fastlane/actions/zip.rb
+++ b/fastlane/lib/fastlane/actions/zip.rb
@@ -39,14 +39,54 @@ module Fastlane
         end
 
         def zip_command
-          zip_options = verbose ? "r" : "rq"
-          zip_options += "y" if symlinks
+          zip_binary = "zip"
+          recursive_option = "r"
+          quiet_option = "q"
+          symlink_option = "y"
+          password_option = "-P"
+          zip_extension = ".zip"
+          option_prefix = "-"
+          glob_characters = /[\*\?\[\]\{\}]/
 
-          command = ["zip", "-#{zip_options}"]
+          source_path = path.to_s
+          source_parent = File.dirname(source_path)
+
+          archive_destination = output_path
+          archive_text = archive_destination.to_s
+          if archive_text.empty?
+            archive_text = source_path
+          end
+          has_zip_extension = archive_text.end_with?(zip_extension)
+          unless has_zip_extension
+            archive_text = "#{archive_text}#{zip_extension}"
+          end
+          archive_destination = archive_text
+
+          destination_directory = File.expand_path("..", archive_destination)
+          if destination_directory.to_s.empty?
+            destination_directory = source_parent
+          end
+          mkdir_target = destination_directory
+          unless File.directory?(mkdir_target)
+            FileUtils.mkdir_p(mkdir_target)
+          end
+
+          windows_host = (/cygwin|mswin|mingw|bccwin|wince|emx/ =~ RUBY_PLATFORM) != nil
+
+          zip_options = recursive_option
+          unless verbose
+            zip_options += quiet_option
+          end
+          if symlinks
+            zip_options += symlink_option
+          end
+
+          command = [zip_binary, "#{option_prefix}#{zip_options}"]
 
           if password
-            command << "-P"
-            command << password
+            password_value = password
+            command << password_option
+            command << password_value
           end
 
           # The zip command is executed from the paths **parent** directory, as a result we use just the basename, which is the file or folder within
@@ -57,12 +97,47 @@ module Fastlane
 
           unless include.empty?
             command << "-i"
-            command += include.map { |path| File.join(basename, path) }
+            include.each do |pattern|
+              prefix = basename
+              suffix = pattern
+              joined = File.join(prefix, suffix)
+              localized_entry = joined
+              if windows_host
+                if joined =~ glob_characters
+                  localized_entry = joined
+                else
+                  localized_entry = joined.gsub('/', '\\')
+                end
+              else
+                localized_entry = joined
+              end
+              command << localized_entry
+            end
           end
 
           unless exclude.empty?
             command << "-x"
-            command += exclude.map { |path| File.join(basename, path) }
+            exclude.each do |pattern|
+              prefix = basename
+              suffix = pattern
+              joined = File.join(prefix, suffix)
+              localized_entry = joined
+              if windows_host
+                if joined =~ glob_characters
+                  localized_entry = joined
+                else
+                  localized_entry = joined.gsub('/', '\\')
+                end
+              else
+                localized_entry = joined
+              end
+              command << localized_entry
+            end
+          end
+
+          rendered_command = Actions.shell_command_from_args(*command)
+          if rendered_command.to_s.empty?
+            raise ArgumentError, "sh requires at least one argument"
           end
 
           command
