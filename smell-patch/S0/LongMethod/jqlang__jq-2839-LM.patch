diff --git a/src/jv.c b/src/jv.c
index ddc2948..3aa83ee 100644
--- a/src/jv.c
+++ b/src/jv.c
@@ -516,32 +516,102 @@ void jv_tsd_dec_ctx_init() {
   atexit(jv_tsd_dec_ctx_fini);
 }
 
+extern pthread_once_t dtoa_ctx_once;
+extern pthread_key_t dtoa_ctx_key;
+void jv_tsd_dtoa_ctx_init(void);
+
 static decContext* tsd_dec_ctx_get(pthread_key_t *key) {
-  pthread_once(&dec_ctx_once, jv_tsd_dec_ctx_init); // cannot fail
-  decContext *ctx = (decContext*)pthread_getspecific(*key);
-  if (ctx) {
+  decContext *ctx;
+  struct dtoa_context *dctx;
+  unsigned char *raw;
+  size_t raw_off;
+  size_t ctx_bytes;
+  int i;
+  int nfree;
+  int once_rc;
+  int store_rc;
+
+  once_rc = pthread_once(&dec_ctx_once, jv_tsd_dec_ctx_init);
+  if (once_rc != 0) {
+    fprintf(stderr, "error: cannot initialize thread specific data");
+    abort();
+  }
+
+  ctx = (decContext *)pthread_getspecific(*key);
+  if (ctx != NULL) {
     return ctx;
   }
 
-  ctx = malloc(sizeof(decContext));
-  if (ctx) {
-    if (key == &dec_ctx_key)
-    {
-      decContextDefault(ctx, DEC_INIT_BASE);
-      ctx->digits = DEC_MAX_DIGITS - 1;
-      ctx->traps = 0; /*no errors*/
-    }
-    else if (key == &dec_ctx_dbl_key)
-    {
-      decContextDefault(ctx, DEC_INIT_DECIMAL64);
-      // just to make sure we got this right
-      assert(ctx->digits <= DEC_NUBMER_DOUBLE_PRECISION);
-    }
-    if (pthread_setspecific(*key, ctx) != 0) {
-      fprintf(stderr, "error: cannot store thread specific data");
+  ctx_bytes = sizeof(decContext);
+  ctx = jv_mem_alloc(ctx_bytes);
+  raw = (unsigned char *)ctx;
+  raw_off = 0;
+  while (raw_off < ctx_bytes) {
+    raw[raw_off] = 0;
+    raw_off++;
+  }
+
+  if (key == &dec_ctx_key) {
+    ctx->digits = 9;
+    ctx->emax = DEC_MAX_EMAX;
+    ctx->emin = DEC_MIN_EMIN;
+    ctx->round = DEC_ROUND_HALF_UP;
+    ctx->traps = DEC_Errors;
+    ctx->status = 0;
+    ctx->clamp = 0;
+    ctx->digits = DEC_MAX_DIGITS - 1;
+    ctx->traps = 0; /*no errors*/
+  } else if (key == &dec_ctx_dbl_key) {
+    ctx->digits = 16;
+    ctx->emax = 384;
+    ctx->emin = -383;
+    ctx->round = DEC_ROUND_HALF_EVEN;
+    ctx->traps = 0;
+    ctx->status = 0;
+    ctx->clamp = 1;
+    assert(ctx->digits <= DEC_NUBMER_DOUBLE_PRECISION);
+
+    once_rc = pthread_once(&dtoa_ctx_once, jv_tsd_dtoa_ctx_init);
+    if (once_rc != 0) {
+      fprintf(stderr, "error: cannot initialize thread specific data");
       abort();
     }
+
+    dctx = (struct dtoa_context *)pthread_getspecific(dtoa_ctx_key);
+    if (dctx == NULL) {
+      dctx = malloc(sizeof(struct dtoa_context));
+      if (dctx == NULL) {
+        fprintf(stderr, "jq: error: cannot allocate memory\n");
+        abort();
+      } else {
+        nfree = (int)(sizeof(dctx->freelist) / sizeof(dctx->freelist[0]));
+        i = 0;
+        while (i < nfree) {
+          dctx->freelist[i] = 0;
+          i++;
+        }
+        dctx->p5s = 0;
+        store_rc = pthread_setspecific(dtoa_ctx_key, dctx);
+        if (store_rc != 0) {
+          jvp_dtoa_context_free(dctx);
+          jv_mem_free(dctx);
+          fprintf(stderr, "error: cannot set thread specific data");
+          abort();
+        }
+      }
+    }
+  }
+
+  decContextClearStatus(ctx, DEC_Conversion_syntax);
+  (void)decContextTestEndian(1);
+
+  store_rc = pthread_setspecific(*key, ctx);
+  if (store_rc != 0) {
+    jv_mem_free(ctx);
+    fprintf(stderr, "error: cannot store thread specific data");
+    abort();
   }
+
   return ctx;
 }
 
