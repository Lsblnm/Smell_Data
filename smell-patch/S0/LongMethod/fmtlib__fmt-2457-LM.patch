diff --git a/include/fmt/ranges.h b/include/fmt/ranges.h
index a35c0664..a0d0f850 100644
--- a/include/fmt/ranges.h
+++ b/include/fmt/ranges.h
@@ -660,13 +660,75 @@ struct formatter<tuple_join_view<Char, T...>, Char> {
                    const Arg& arg, const Args&... args) ->
       typename FormatContext::iterator {
     using base = formatter<typename std::decay<Arg>::type, Char>;
-    auto out = base().format(arg, ctx);
-    if (sizeof...(Args) > 0) {
-      out = std::copy(value.sep.begin(), value.sep.end(), out);
+
+    const auto remaining_args = sizeof...(Args);
+    auto element_formatter = base();
+    auto out = element_formatter.format(arg, ctx);
+
+    if (remaining_args == 0) {
+      return out;
+    }
+
+    const auto sep_begin = value.sep.begin();
+    const auto sep_end = value.sep.end();
+    const auto sep_size = value.sep.size();
+
+    if (sep_size == 0) {
       ctx.advance_to(out);
       return format_args(value, ctx, args...);
     }
-    return out;
+
+    if (detail::const_check(sizeof(Char) == 1) && detail::is_utf8()) {
+      if (sep_size <= 4) {
+        Char local_sep[4];
+        size_t local_count = 0;
+        while (local_count < sep_size) {
+          local_sep[local_count] = static_cast<Char>(sep_begin[local_count]);
+          ++local_count;
+        }
+        if (local_count == 1) {
+          *out++ = local_sep[0];
+        } else if (local_count == 2) {
+          *out++ = local_sep[0];
+          *out++ = local_sep[1];
+        } else if (local_count == 3) {
+          *out++ = local_sep[0];
+          *out++ = local_sep[1];
+          *out++ = local_sep[2];
+        } else {
+          size_t written = 0;
+          while (written < local_count) {
+            *out++ = local_sep[written];
+            ++written;
+          }
+        }
+      } else {
+        auto src = sep_begin;
+        auto chars_left = sep_size;
+        while (chars_left > 0) {
+          auto first = static_cast<unsigned char>(*src);
+          int cp_len = detail::code_point_length(src);
+          if (first < 0x80) {
+            cp_len = 1;
+          }
+          if (static_cast<size_t>(cp_len) > chars_left) {
+            cp_len = static_cast<int>(chars_left);
+          }
+          out = detail::copy_str<Char>(src, src + cp_len, out);
+          src += cp_len;
+          chars_left -= static_cast<size_t>(cp_len);
+        }
+      }
+    } else if (sep_size == 1) {
+      *out++ = static_cast<Char>(*sep_begin);
+    } else if (sep_size == 2) {
+      out = detail::copy(value.sep, out);
+    } else {
+      out = detail::copy_str_noinline<Char>(sep_begin, sep_end, out);
+    }
+
+    ctx.advance_to(out);
+    return format_args(value, ctx, args...);
   }
 };
 
