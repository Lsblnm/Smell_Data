diff --git a/internal/terraform/marks.go b/internal/terraform/marks.go
index e57c4745fa..371895ca60 100644
--- a/internal/terraform/marks.go
+++ b/internal/terraform/marks.go
@@ -6,7 +6,10 @@ package terraform
 import (
 	"fmt"
 	"sort"
+	"strconv"
+	"strings"
 
+	"github.com/hashicorp/terraform/internal/lang/marks"
 	"github.com/zclconf/go-cty/cty"
 )
 
@@ -14,15 +17,91 @@ import (
 // the given value. When comparing existing marks to those from a map or other
 // dynamic value, we may not have values at the same paths and need to strip
 // out irrelevant marks.
-func filterMarks(val cty.Value, marks []cty.PathValueMarks) []cty.PathValueMarks {
+func filterMarks(val cty.Value, markList []cty.PathValueMarks) []cty.PathValueMarks {
 	var res []cty.PathValueMarks
-	for _, mark := range marks {
-		// any error here just means the path cannot apply to this value, so we
-		// don't need this mark for comparison.
-		if _, err := mark.Path.Apply(val); err == nil {
-			res = append(res, mark)
+	if len(markList) == 0 {
+		return res
+	}
+
+	containsSensitive := false
+	unmarkedVal := val
+	typeName := ""
+	if val != cty.NilVal {
+		containsSensitive = marks.Contains(val, marks.Sensitive)
+		if val.ContainsMarked() {
+			unmarkedVal, _ = val.UnmarkDeepWithPaths()
+		}
+		typeName = unmarkedVal.Type().FriendlyName()
+	}
+
+	pathApplies := make(map[string]bool, len(markList))
+
+	for _, pvm := range markList {
+		current := val
+		applicable := true
+		copiedPath := make(cty.Path, len(pvm.Path))
+		copy(copiedPath, pvm.Path)
+		keyParts := make([]string, 0, len(copiedPath))
+
+		for _, step := range copiedPath {
+			if !applicable {
+				break
+			}
+
+			switch s := step.(type) {
+			case cty.GetAttrStep:
+				attrName := s.Name
+				keyParts = append(keyParts, attrName)
+				if current.IsNull() {
+					applicable = false
+					continue
+				}
+				currentTy := current.Type()
+				if !currentTy.IsObjectType() {
+					applicable = false
+					continue
+				}
+				if !currentTy.HasAttribute(attrName) {
+					applicable = false
+					continue
+				}
+				attrVal := current.GetAttr(attrName)
+				if marks.Has(attrVal, marks.Sensitive) {
+					keyParts[len(keyParts)-1] = attrName
+				}
+				current = attrVal
+			case cty.IndexStep:
+				keyTy := s.Key.Type()
+				if keyTy == cty.String {
+					keyParts = append(keyParts, s.Key.AsString())
+				}
+				if keyTy == cty.Number {
+					idx, _ := s.Key.AsBigFloat().Int64()
+					keyParts = append(keyParts, strconv.Itoa(int(idx)))
+				}
+				next, err := s.Apply(current)
+				if err != nil {
+					applicable = false
+					continue
+				}
+				current = next
+			}
+		}
+
+		pathKey := strings.Join(keyParts, ".")
+		if containsSensitive {
+			pathKey = pathKey + ":" + typeName
+		}
+		if pathApplies[pathKey] {
+			res = append(res, pvm)
+			continue
+		}
+		pathApplies[pathKey] = applicable
+		if applicable {
+			res = append(res, pvm)
 		}
 	}
+
 	return res
 }
 
