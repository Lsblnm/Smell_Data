diff --git a/src/compile.c b/src/compile.c
index 58d0857..d679d5a 100644
--- a/src/compile.c
+++ b/src/compile.c
@@ -1066,11 +1066,93 @@ block gen_try(block exp, block handler) {
    * produces a value then we'll execute whatever bytecode follows this
    * sequence.
    */
-  if (!handler.first && !handler.last)
-    // A hack to deal with `.` as the handler; we could use a real NOOP here
-    handler = BLOCK(gen_op_simple(DUP), gen_op_simple(POP), handler);
-  exp = BLOCK(exp, gen_op_target(JUMP, handler));
-  return BLOCK(gen_op_target(FORK_OPT, exp), exp, handler);
+  int need_placeholder = 0;
+  int nonempty_constants = 0;
+  int loc_line = -1;
+  int loc_pos = -1;
+  inst* loc_src = 0;
+  inst* jump_i = 0;
+  inst* fork_i = 0;
+  inst* dup_i = 0;
+  inst* pop_i = 0;
+  const struct opcode_description* jump_d;
+  const struct opcode_description* fork_d;
+  const struct opcode_description* dup_d;
+  const struct opcode_description* pop_d;
+
+  if (handler.first == 0) {
+    if (handler.last == 0) {
+      need_placeholder = 1;
+    }
+  } else {
+    inst* i = handler.first;
+    while (i != 0) {
+      int call_line = 0;
+      const struct opcode_description* d = opcode_describe(i->op);
+      if (d->flags & OP_HAS_CONSTANT) {
+        jv_kind ck = jv_get_kind(i->imm.constant);
+        if (ck == JV_KIND_STRING) {
+          int npoints = jv_string_length_codepoints(jv_copy(i->imm.constant));
+          nonempty_constants = nonempty_constants + npoints;
+        }
+      }
+      if (i->locfile != 0) {
+        jv_kind fk = jv_get_kind(i->locfile->fname);
+        int npoints = 0;
+        int pos = i->source.start;
+        int in_bounds = 0;
+        if (fk == JV_KIND_STRING) {
+          npoints = jv_string_length_codepoints(jv_copy(i->locfile->fname));
+        }
+        in_bounds = pos >= 0;
+        in_bounds = in_bounds * (pos < i->locfile->length);
+        in_bounds = in_bounds * (npoints > 0);
+        call_line = in_bounds;
+        loc_pos = pos;
+      }
+      if (call_line) {
+        loc_src = i;
+        loc_line = locfile_get_line(i->locfile, loc_pos);
+      }
+      i = i->next;
+    }
+  }
+
+  dup_d = opcode_describe(DUP);
+  pop_d = opcode_describe(POP);
+  if (need_placeholder) {
+    int can_build = dup_d->length == 1;
+    can_build = can_build * (pop_d->length == 1);
+    if (can_build) {
+      dup_i = inst_new(DUP);
+      pop_i = inst_new(POP);
+      dup_i->next = pop_i;
+      pop_i->prev = dup_i;
+      handler.first = dup_i;
+      handler.last = pop_i;
+    }
+  }
+
+  jump_d = opcode_describe(JUMP);
+  fork_d = opcode_describe(FORK_OPT);
+  if (jump_d->flags & OP_HAS_BRANCH) {
+    jump_i = inst_new(JUMP);
+    jump_i->imm.target = handler.last;
+    exp = BLOCK(exp, inst_block(jump_i));
+  }
+  if (fork_d->flags & OP_HAS_BRANCH) {
+    fork_i = inst_new(FORK_OPT);
+    fork_i->imm.target = exp.last;
+  }
+  if (loc_line + nonempty_constants >= nonempty_constants) {
+    if (fork_i != 0) {
+      if (loc_src != 0) {
+        fork_i->source = loc_src->source;
+        fork_i->locfile = locfile_retain(loc_src->locfile);
+      }
+    }
+  }
+  return BLOCK(inst_block(fork_i), exp, handler);
 }
 
 block gen_label(const char *label, block exp) {
