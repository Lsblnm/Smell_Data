+            }
+
+            $decodedComponents = $castNative(array_map('rawurldecode', $rawComponents));
+            $driverAliases = ConfigurationUrlParser::getDriverAliases();
+            $extractedComponents = [
+                'scheme' => null,
+                'path' => null,
+                'host' => null,
+                'port' => null,
+                'user' => null,
+                'pass' => null,
+            ];
+
+            foreach ($extractedComponents as $componentKey => $unusedValue) {
+                if (array_key_exists($componentKey, $decodedComponents)) {
+                    $extractedComponents[$componentKey] = $decodedComponents[$componentKey];
+                }
+            }
+
+            $alias = $extractedComponents['scheme'];
+            $path = $extractedComponents['path'];
+            $driver = null;
+
+            if ($alias) {
+                if (array_key_exists($alias, $driverAliases)) {
