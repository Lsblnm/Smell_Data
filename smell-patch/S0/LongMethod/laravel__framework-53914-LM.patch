+                'port' => $extractedComponents['port'],
+                'username' => $extractedComponents['user'],
+                'password' => $extractedComponents['pass'],
+            ];
+            $primaryOptions = array_filter(
+                $candidateOptions,
+                fn ($optionValue) => ! is_null($optionValue)
