diff --git a/src/wrapping.rs b/src/wrapping.rs
index 57201750..29cd054f 100644
--- a/src/wrapping.rs
+++ b/src/wrapping.rs
@@ -10,3 +10,37 @@ impl Default for WrappingMode {
         WrappingMode::NoWrapping(false)
     }
 }
+
+impl WrappingMode {
+    pub fn from_cli(
+        interactive_output: bool,
+        terminal_width_override: bool,
+        chop_long_lines: bool,
+        wrap_preference: Option<&str>,
+        plain_style: bool,
+    ) -> Self {
+        let can_wrap_output = interactive_output || terminal_width_override;
+        if can_wrap_output {
+            if !chop_long_lines {
+                match wrap_preference {
+                    Some("character") => WrappingMode::Character,
+                    Some("never") => WrappingMode::NoWrapping(true),
+                    Some("auto") | None => {
+                        if plain_style {
+                            WrappingMode::NoWrapping(false)
+                        } else {
+                            WrappingMode::Character
+                        }
+                    }
+                    _ => unreachable!("other values for --wrap are not allowed"),
+                }
+            } else {
+                WrappingMode::NoWrapping(true)
+            }
+        } else {
+            // We don't have the tty width when piping to another program.
+            // There's no point in wrapping when this is the case.
+            WrappingMode::NoWrapping(false)
+        }
+    }
+}
