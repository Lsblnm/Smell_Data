diff --git a/include/fmt/format.h b/include/fmt/format.h
index 873e98bd..1891f37b 100644
--- a/include/fmt/format.h
+++ b/include/fmt/format.h
@@ -1683,11 +1683,12 @@ class arg_formatter_base {
   using iterator = typename Range::iterator;
   using format_specs = basic_format_specs<char_type>;
 
- private:
+ protected:
   iterator out_;  // Output iterator.
   locale_ref locale_;
   format_specs* specs_;
 
+ private:
   // Attempts to reserve space for n extra characters in the output range.
   // Returns a pointer to the reserved range or a reference to out_.
   auto reserve(size_t n) -> decltype(detail::reserve(out_, n)) {
@@ -1740,13 +1741,6 @@ class arg_formatter_base {
   void write(uint128_t value) { write_decimal(value); }
 #endif
 
-  template <typename T> void write_int(T value, const format_specs& spec) {
-    using uint_type = uint32_or_64_or_128_t<T>;
-    int_writer<iterator, char_type, uint_type> w(out_, locale_, value, spec);
-    handle_int_type_spec(spec.type, w);
-    out_ = w.out;
-  }
-
   void write(char value) {
     auto&& it = reserve(1);
     *it++ = value;
@@ -1788,6 +1782,13 @@ class arg_formatter_base {
   }
 
  protected:
+  template <typename T> void write_int(T value, const format_specs& spec) {
+    using uint_type = uint32_or_64_or_128_t<T>;
+    int_writer<iterator, char_type, uint_type> w(out_, locale_, value, spec);
+    handle_int_type_spec(spec.type, w);
+    out_ = w.out;
+  }
+
   iterator out() { return out_; }
   format_specs* specs() { return specs_; }
 
diff --git a/include/fmt/printf.h b/include/fmt/printf.h
index 6d014fcd..fb8ee88f 100644
--- a/include/fmt/printf.h
+++ b/include/fmt/printf.h
@@ -246,13 +246,16 @@ class printf_arg_formatter : public detail::arg_formatter_base<Range> {
   iterator operator()(T value) {
     // MSVC2013 fails to compile separate overloads for bool and char_type so
     // use std::is_same instead.
+    format_specs& fmt_specs = *this->specs();
     if (std::is_same<T, bool>::value) {
-      format_specs& fmt_specs = *this->specs();
-      if (fmt_specs.type != 's') return base::operator()(value ? 1 : 0);
+      if (fmt_specs.type != 's')
+        return (*this)(static_cast<int>(value));
       fmt_specs.type = 0;
-      this->write(value != 0);
+      const char* literal = "false";
+      if (value != 0) literal = "true";
+      string_view rendered(literal);
+      this->out_ = detail::write(this->out_, rendered, fmt_specs);
     } else if (std::is_same<T, char_type>::value) {
-      format_specs& fmt_specs = *this->specs();
       if (fmt_specs.type && fmt_specs.type != 'c')
         return (*this)(static_cast<int>(value));
       fmt_specs.sign = sign::none;
@@ -260,7 +263,64 @@ class printf_arg_formatter : public detail::arg_formatter_base<Range> {
       fmt_specs.align = align::right;
       return base::operator()(value);
     } else {
-      return base::operator()(value);
+      using uint_type = detail::uint32_or_64_or_128_t<T>;
+      using digit_it =
+          remove_reference_t<decltype(detail::reserve(this->out_, 0))>;
+      uint_type abs_value = static_cast<uint_type>(value);
+      char prefix[4];
+      unsigned prefix_size = 0;
+      if (detail::is_negative(value)) {
+        prefix[0] = '-';
+        prefix_size = 1;
+        abs_value = 0 - abs_value;
+      } else {
+        if (fmt_specs.sign != sign::none) {
+          if (fmt_specs.sign != sign::minus) {
+            prefix[0] = detail::data::signs[fmt_specs.sign];
+            prefix_size = 1;
+          }
+        }
+      }
+      char presentation = fmt_specs.type;
+      if (presentation == 0 || presentation == 'd') {
+        int num_digits = detail::count_digits(abs_value);
+        string_view prefix_view(prefix, prefix_size);
+        this->out_ = detail::write_int(
+            this->out_, num_digits, prefix_view, fmt_specs,
+            [abs_value, num_digits](digit_it it) {
+              return detail::format_decimal<char_type>(it, abs_value,
+                                                       num_digits);
+            });
+      } else if (presentation == 'x' || presentation == 'X') {
+        if (fmt_specs.alt) {
+          prefix[prefix_size++] = '0';
+          prefix[prefix_size++] = presentation;
+        }
+        int num_digits = detail::count_digits<4>(abs_value);
+        string_view prefix_view(prefix, prefix_size);
+        bool upper = presentation != 'x';
+        this->out_ = detail::write_int(
+            this->out_, num_digits, prefix_view, fmt_specs,
+            [abs_value, num_digits, upper](digit_it it) {
+              return detail::format_uint<4, char_type>(it, abs_value,
+                                                       num_digits, upper);
+            });
+      } else if (presentation == 'o') {
+        int num_digits = detail::count_digits<3>(abs_value);
+        if (fmt_specs.alt && fmt_specs.precision <= num_digits &&
+            abs_value != 0) {
+          prefix[prefix_size++] = '0';
+        }
+        string_view prefix_view(prefix, prefix_size);
+        this->out_ = detail::write_int(
+            this->out_, num_digits, prefix_view, fmt_specs,
+            [abs_value, num_digits](digit_it it) {
+              return detail::format_uint<3, char_type>(it, abs_value,
+                                                       num_digits);
+            });
+      } else {
+        this->write_int(value, fmt_specs);
+      }
     }
     return this->out();
   }
