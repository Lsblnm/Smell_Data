diff --git a/lib/fluent/event_router.rb b/lib/fluent/event_router.rb
index 166b4b4f..a62ddf04 100644
--- a/lib/fluent/event_router.rb
+++ b/lib/fluent/event_router.rb
@@ -177,8 +177,89 @@ module Fluent
       end
 
       def emit_events(tag, es)
-        processed = @optimizer.filter_stream(tag, es)
-        @output.emit_events(tag, processed)
+        filters = @filters
+        optimizer = @optimizer
+        processed = es
+
+        optimizable = optimizer.instance_variable_get(:@optimizable)
+        if optimizable.nil?
+          fs_filters = []
+          filters.each do |filter|
+            methods = filter.class.instance_methods(false)
+            if methods.include?(:filter_stream)
+              fs_filters << filter
+            end
+          end
+          optimizer.instance_variable_set(:@filters_having_filter_stream, fs_filters)
+
+          if fs_filters.empty?
+            optimizable = true
+          else
+            if filters.size > 1
+              $log.info "disable filter chain optimization because #{fs_filters.map(&:class)} uses `#filter_stream` method."
+            end
+            optimizable = false
+          end
+          optimizer.instance_variable_set(:@optimizable, optimizable)
+        end
+
+        unless optimizable
+          processed = es
+          filters.each do |filter|
+            processed = filter.filter_stream(tag, processed)
+            filter.measure_metrics(processed)
+          end
+          @output.emit_events(tag, processed)
+          return
+        end
+
+        new_es = MultiEventStream.new
+        unpacker = Thread.current[:local_msgpack_unpacker]
+        if unpacker.nil?
+          factory = Fluent::MessagePackFactory.engine_factory
+          unpacker = factory.unpacker
+          Thread.current[:local_msgpack_unpacker] = unpacker
+        end
+
+        materialized = []
+        if es.is_a?(MessagePackEventStream)
+          es.each(unpacker: unpacker) do |time, record|
+            materialized << [time, record]
+          end
+        else
+          es.each do |time, record|
+            materialized << [time, record]
+          end
+        end
+
+        materialized.each do |time, record|
+          filtered_record = record
+          filtered_time = time
+          dropped = false
+          filters.each do |filter|
+            break if dropped
+            if filter.has_filter_with_time
+              begin
+                filtered_time, filtered_record = filter.filter_with_time(tag, filtered_time, filtered_record)
+                dropped = true unless filtered_record && filtered_time
+                filter.measure_metrics(OneEventStream.new(time, record)) unless dropped
+              rescue => e
+                filter.router.emit_error_event(tag, filtered_time, filtered_record, e)
+              end
+            else
+              begin
+                filtered_record = filter.filter(tag, filtered_time, filtered_record)
+                dropped = true unless filtered_record
+                filter.measure_metrics(OneEventStream.new(time, record)) unless dropped
+              rescue => e
+                filter.router.emit_error_event(tag, filtered_time, filtered_record, e)
+              end
+            end
+          end
+          new_es.add(filtered_time, filtered_record) unless dropped
+        end
+
+        @output.emit_events(tag, new_es)
       end
 
       class FilterOptimizer
