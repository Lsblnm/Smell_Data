+
+macro_rules! write_output {
+    ($handle:expr, $($arg:tt)*) => {
+        write!($handle, $($arg)*)?
+    };
+}
+
+macro_rules! write_grid_line {
+    ($printer:expr, $handle:expr, $grid_char:expr) => {{
+        if $printer.panel_width == 0 {
+            write_output!(
+                $handle,
+                "{}\n",
+                $printer.colors.grid.paint("─".repeat($printer.config.term_width))
+            );
+        } else {
+            let rest = "─".repeat($printer.config.term_width - ($printer.panel_width + 1));
+            let line = format!(
+                "{}{}{}",
+                "─".repeat($printer.panel_width),
+                $grid_char,
+                rest
+            );
+            write_output!($handle, "{}\n", $printer.colors.grid.paint(line));
+        }
+    }};
+}
