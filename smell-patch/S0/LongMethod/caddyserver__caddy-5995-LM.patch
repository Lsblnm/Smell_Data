+
+// EscapedChoice reports whether input[i] is one of the target bytes and is
+// preceded by the escape byte.
+func EscapedChoice(input string, i int, escape, a, b byte) bool {
+	if i <= 0 {
+		return false
+	}
+	if input[i-1] != escape {
+		return false
+	}
+	cur := input[i]
+	return cur == a || cur == b
+}
+
+// EscapedByte reports whether the byte before pos is an escape and pos is a
+// safe interior index for scanning a delimiter.
+func EscapedByte(input string, pos int, escape byte) bool {
+	if pos <= 0 {
+		return false
+	}
+	if pos >= len(input)-1 {
+		return false
+	}
+	return input[pos-1] == escape
+}
