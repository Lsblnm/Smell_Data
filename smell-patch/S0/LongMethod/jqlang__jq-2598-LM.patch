 }
 
 block gen_cond(block cond, block iftrue, block iffalse) {
-  return BLOCK(gen_op_simple(DUP), BLOCK(gen_subexp(cond), gen_op_simple(POP)),
-               gen_condbranch(BLOCK(gen_op_simple(POP), iftrue),
-                              BLOCK(gen_op_simple(POP), iffalse)));
+  block cond_exp;
+  block dup_input;
+  block pop_cond;
+  block pop_true;
+  block pop_false;
+  block true_path;
+  block false_path;
+  block jump_end;
+  block branch;
+  block compiled;
+  inst *cursor;
+  inst *jump_inst;
+  inst *false_jump;
+  struct locfile *origin;
+  location origin_loc;
+  const struct opcode_description *jump_info;
+  const struct opcode_description *false_info;
+  jv constant;
+  int source_line;
+
+  origin = 0;
+  origin_loc = UNKNOWN_LOCATION;
+  source_line = -1;
+  jump_info = opcode_describe(JUMP);
+  false_info = opcode_describe(JUMP_F);
+
+  for (cursor = cond.first; cursor != 0; cursor = cursor->next) {
+    if (cursor->locfile != 0) {
+      if (cursor->source.start >= 0) {
+        origin = locfile_retain(cursor->locfile);
+        origin_loc = cursor->source;
+        break;
+      }
+    }
+  }
+
+  if (origin == 0) {
+    for (cursor = iftrue.first; cursor != 0; cursor = cursor->next) {
+      if (cursor->locfile != 0) {
+        if (cursor->source.start >= 0) {
+          origin = locfile_retain(cursor->locfile);
+          origin_loc = cursor->source;
+          break;
+        }
+      }
+    }
+  }
+
+  if (block_is_noop(cond)) {
+    cond_exp = gen_op_simple(DUP);
+  } else if (block_is_single(cond) && cond.first->op == LOADK) {
+    constant = jv_copy(cond.first->imm.constant);
+    block_free(cond);
+    cond_exp = gen_op_pushk_under(constant);
+  } else {
+    block begin_sub;
+    block end_sub;
+    begin_sub = gen_op_simple(SUBEXP_BEGIN);
+    end_sub = gen_op_simple(SUBEXP_END);
+    cond_exp = begin_sub;
+    cond_exp = block_join(cond_exp, cond);
+    cond_exp = block_join(cond_exp, end_sub);
+  }
+
+  dup_input = gen_op_simple(DUP);
+  pop_cond = gen_op_simple(POP);
+  pop_true = gen_op_simple(POP);
+  pop_false = gen_op_simple(POP);
+  false_path = pop_false;
+  false_path = block_join(false_path, iffalse);
+  true_path = pop_true;
+  true_path = block_join(true_path, iftrue);
+
+  jump_inst = inst_new(JUMP);
+  jump_inst->imm.target = false_path.last;
+  jump_end = inst_block(jump_inst);
+  true_path = block_join(true_path, jump_end);
+
+  false_jump = inst_new(JUMP_F);
+  false_jump->imm.target = true_path.last;
+  branch = inst_block(false_jump);
+
+  if (origin != 0) {
+    if (origin_loc.start >= 0) {
+      if (origin_loc.start < origin->length) {
+        source_line = locfile_get_line(origin, origin_loc.start);
+      }
+    }
+    if (source_line >= 0) {
+      if (jump_info != 0 && (jump_info->flags & OP_HAS_BRANCH) != 0) {
+        jump_inst->source = origin_loc;
+        jump_inst->locfile = locfile_retain(origin);
+      }
+      if (false_info != 0 && (false_info->flags & OP_HAS_BRANCH) != 0) {
+        false_jump->source = origin_loc;
+        false_jump->locfile = locfile_retain(origin);
+      }
+    }
+    locfile_free(origin);
+  }
+
+  compiled = dup_input;
+  compiled = block_join(compiled, cond_exp);
+  compiled = block_join(compiled, pop_cond);
+  compiled = block_join(compiled, branch);
+  compiled = block_join(compiled, true_path);
+  compiled = block_join(compiled, false_path);
+  return compiled;
 }
 
