diff --git a/src/bitops.c b/src/bitops.c
index e2384d814..0742b2237 100644
--- a/src/bitops.c
+++ b/src/bitops.c
@@ -511,20 +511,98 @@ robj *lookupStringForBitCommand(client *c, uint64_t maxbit, int *dirty) {
  * If the source object is NULL the function is guaranteed to return NULL
  * and set 'len' to 0. */
 unsigned char *getObjectReadOnlyString(robj *o, long *len, char *llbuf) {
-    serverAssert(!o || o->type == OBJ_STRING);
     unsigned char *p = NULL;
+    long outlen = 0;
 
-    /* Set the 'p' pointer to the string, that can be just a stack allocated
-     * array if our string was integer encoded. */
-    if (o && o->encoding == OBJ_ENCODING_INT) {
-        p = (unsigned char*) llbuf;
-        if (len) *len = ll2string(llbuf,LONG_STR_SIZE,(long)o->ptr);
-    } else if (o) {
-        p = (unsigned char*) o->ptr;
-        if (len) *len = sdslen(o->ptr);
+    /* Missing keys are treated as empty strings by bit commands. */
+    if (o == NULL) {
+        if (len != NULL) {
+            *len = 0;
+        }
+        return NULL;
+    }
+
+    serverAssert(o->type == OBJ_STRING);
+
+    if (o->encoding == OBJ_ENCODING_INT) {
+        long long svalue = (long) o->ptr;
+        unsigned long long magnitude;
+        int negative = 0;
+        int written;
+
+        /* Convert the integer encoding into an unsigned magnitude. */
+        if (svalue < 0) {
+            negative = 1;
+            if (svalue != LLONG_MIN) {
+                magnitude = (unsigned long long) (-svalue);
+            } else {
+                magnitude = ((unsigned long long) LLONG_MAX) + 1;
+            }
+        } else {
+            magnitude = (unsigned long long) svalue;
+        }
+
+        /* Single-digit positives are the common integer encoding. */
+        if (negative == 0 && magnitude < 10ULL) {
+            llbuf[0] = (char) ('0' + magnitude);
+            llbuf[1] = '\0';
+            written = 1;
+        } else {
+            written = ll2string(llbuf, LONG_STR_SIZE, svalue);
+        }
+
+        serverAssert(written == (int) stringObjectLen(o));
+        outlen = written;
+        p = (unsigned char *) llbuf;
+        if (len != NULL) {
+            *len = outlen;
+        }
+    } else if (o->encoding == OBJ_ENCODING_EMBSTR) {
+        sds s = (sds) o->ptr;
+        unsigned char flags = s[-1];
+        struct sdshdr8 *sh = (struct sdshdr8 *) sdsAllocPtr(s);
+        size_t slen = sh->len;
+
+        /* Embedded strings are allocated as SDS_TYPE_8. */
+        serverAssert((flags & SDS_TYPE_MASK) == SDS_TYPE_8);
+        serverAssert(s[slen] == '\0');
+        p = (unsigned char *) s;
+        if (len != NULL) {
+            *len = (long) slen;
+        }
+    } else if (o->encoding == OBJ_ENCODING_RAW) {
+        sds s = (sds) o->ptr;
+        unsigned char flags = s[-1];
+        int hdrtype = flags & SDS_TYPE_MASK;
+        size_t slen = 0;
+        void *hdr = sdsAllocPtr(s);
+
+        /* Decode the SDS header to obtain the string length. */
+        if (hdrtype == SDS_TYPE_5) {
+            slen = SDS_TYPE_5_LEN(flags);
+        } else if (hdrtype == SDS_TYPE_8) {
+            struct sdshdr8 *sh8 = (struct sdshdr8 *) hdr;
+            slen = sh8->len;
+        } else if (hdrtype == SDS_TYPE_16) {
+            struct sdshdr16 *sh16 = (struct sdshdr16 *) hdr;
+            slen = sh16->len;
+        } else if (hdrtype == SDS_TYPE_32) {
+            struct sdshdr32 *sh32 = (struct sdshdr32 *) hdr;
+            slen = sh32->len;
+        } else if (hdrtype == SDS_TYPE_64) {
+            struct sdshdr64 *sh64 = (struct sdshdr64 *) hdr;
+            slen = sh64->len;
+        }
+
+        serverAssert(s[slen] == '\0');
+        p = (unsigned char *) s;
+        if (len != NULL) {
+            *len = (long) slen;
+        }
     } else {
-        if (len) *len = 0;
+        serverPanic("Unknown string encoding");
     }
+
     return p;
 }
 
