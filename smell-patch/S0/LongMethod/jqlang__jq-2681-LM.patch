diff --git a/src/parser.y b/src/parser.y
index 11a7d2d..baf938e 100644
--- a/src/parser.y
+++ b/src/parser.y
@@ -135,16 +135,120 @@ struct lexer_param {
 
 void yyerror(YYLTYPE* loc, block* answer, int* errors,
              struct locfile* locations, struct lexer_param* lexer_param_ptr, const char *s){
+  location errloc;
+  const char *prefix_fmt;
+  const char *src_line;
+  const char *fname_str;
+  const char *msg1;
+  int unexpected;
+  int startline;
+  int offset;
+  int line_len;
+  int caret;
+  int pos;
+  int probe;
+  int next_off;
+  int remain;
+  int line_end;
+  int i;
+  jv m1;
+  jv m2;
+  jv fname;
+
   (*errors)++;
-  if (strstr(s, "unexpected")) {
+  errloc = *loc;
+  pos = errloc.start;
+  unexpected = 0;
+  if (strstr(s, "unexpected") != NULL) {
+    unexpected = 1;
+  }
 #ifdef WIN32
-      locfile_locate(locations, *loc, "jq: error: %s (Windows cmd shell quoting issues?)", s);
+  if (unexpected) {
+    prefix_fmt = "jq: error: %s (Windows cmd shell quoting issues?)";
+  } else {
+    prefix_fmt = "jq: error: %s";
+  }
 #else
-      locfile_locate(locations, *loc, "jq: error: %s (Unix shell quoting issues?)", s);
-#endif
+  if (unexpected) {
+    prefix_fmt = "jq: error: %s (Unix shell quoting issues?)";
   } else {
-      locfile_locate(locations, *loc, "jq: error: %s", s);
+    prefix_fmt = "jq: error: %s";
+  }
+#endif
+
+  startline = 0;
+  offset = 0;
+  line_len = 0;
+  next_off = 0;
+  remain = 0;
+  line_end = 0;
+  probe = 1;
+  src_line = "";
+
+  if (pos != -1) {
+    startline = locfile_get_line(locations, pos);
+    probe = 1;
+    while (locations->linemap[probe] <= pos) {
+      probe++;
+    }
+    if (startline >= 0) {
+      startline = probe - 1;
+      offset = locations->linemap[startline];
+      next_off = locations->linemap[startline + 1];
+      line_end = next_off - 1;
+      line_len = line_end - offset;
+      remain = locations->length - offset;
+      if (line_len < 0) {
+        line_len = 0;
+      } else {
+        if (line_len > remain) {
+          line_len = remain;
+        }
+      }
+      src_line = locations->data + offset;
+    }
   }
+
+  i = 0;
+  while (i < line_len) {
+    if (src_line[i] == '\n') {
+      line_len = i;
+      break;
+    }
+    i++;
+  }
+
+  m1 = jv_string_fmt(prefix_fmt, s);
+  if (!jv_is_valid(m1)) {
+    jq_report_error(locations->jq, m1);
+    return;
+  }
+  m1 = jq_format_error(m1);
+  msg1 = jv_string_value(m1);
+
+  if (pos == -1) {
+    m2 = jv_string_fmt("jq: error: %s\n<unknown location>", msg1);
+    jv_free(m1);
+    jq_report_error(locations->jq, m2);
+    return;
+  }
+
+  caret = pos - offset;
+  if (caret < 0) {
+    caret = 0;
+  }
+
+  fname = jv_copy(locations->fname);
+  fname_str = jv_string_value(fname);
+  m2 = jv_string_fmt("%s at %s, line %d:\n%.*s%*s",
+                     msg1,
+                     fname_str,
+                     startline + 1,
+                     line_len, src_line,
+                     caret, "");
+  jv_free(fname);
+  jv_free(m1);
+  jq_report_error(locations->jq, m2);
 }
 
 int yylex(YYSTYPE* yylval, YYLTYPE* yylloc, block* answer, int* errors,
