--- a/src/jv_print.c
+++ b/src/jv_print.c
@@ -36,6 +36,49 @@ static const char* def_colors[] =
 
 static const char **colors = def_colors;
 
+void
+jq_colors_reset(void)
+{
+  size_t i;
+
+  colors = def_colors;
+  memset(color_bufs, 0, sizeof(color_bufs));
+  for (i = 0; i < sizeof(def_colors) / sizeof(def_colors[0]); i++)
+    color_bufps[i] = def_colors[i];
+}
+
+int
+jq_colors_put(size_t slot, const char *spec, size_t n)
+{
+  if (slot >= sizeof(def_colors) / sizeof(def_colors[0]))
+    return 0;
+  if (spec == NULL)
+    return 0;
+  if (n > sizeof(color_bufs[slot]) - 4 /* ESC [ m NUL */)
+    return 0;
+  color_bufs[slot][0] = ESC[0];
+  color_bufs[slot][1] = '[';
+  (void) strncpy(&color_bufs[slot][2], spec, n);
+  color_bufs[slot][2 + n] = '\0';
+  if (strspn(&color_bufs[slot][2], "0123456789;") < strlen(&color_bufs[slot][2]))
+    return 0;
+  color_bufs[slot][2 + n] = 'm';
+  color_bufps[slot] = color_bufs[slot];
+  return 1;
+}
+
+void
+jq_colors_commit(void)
+{
+  colors = color_bufps;
+}
+
+size_t
+jq_colors_slot_count(void)
+{
+  return sizeof(def_colors) / sizeof(def_colors[0]);
+}
+
 int
 jq_set_colors(const char *c)
