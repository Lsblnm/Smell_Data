diff --git a/src/main.c b/src/main.c
index 97f3844..17b9384 100644
--- a/src/main.c
+++ b/src/main.c
@@ -254,6 +254,110 @@ static void debug_cb(void *data, jv input) {
   fprintf(stderr, "\n");
 }
 
+void jq_colors_reset(void);
+int jq_colors_put(size_t, const char *, size_t);
+void jq_colors_commit(void);
+size_t jq_colors_slot_count(void);
+
+static int configure_print_options(jq_state *jq, int dumpopts, const char *argv0, jv lib_search_paths) {
+  const char *jq_colors;
+  const char *ver_mark;
+  const char *cursor;
+  const char *sep;
+  char *origin;
+  size_t slot;
+  size_t spec_len;
+  size_t nslots;
+  int applied;
+  jv default_paths[3];
+
+#ifdef USE_ISATTY
+  if (isatty(STDOUT_FILENO)) {
+#ifndef WIN32
+    dumpopts |= JV_PRINT_ISATTY | JV_PRINT_COLOR;
+#else
+  /* Verify we actually have the console, as the NUL device is also regarded as
+     tty.  Windows can handle color if ANSICON (or ConEmu) is installed, or
+     Windows 10 supports the virtual terminal */
+    DWORD mode;
+    HANDLE con = GetStdHandle(STD_OUTPUT_HANDLE);
+    if (GetConsoleMode(con, &mode)) {
+      dumpopts |= JV_PRINT_ISATTY;
+      if (jq_getenv("ANSICON") != NULL ||
+          SetConsoleMode(con, mode | 4/*ENABLE_VIRTUAL_TERMINAL_PROCESSING*/))
+        dumpopts |= JV_PRINT_COLOR;
+    }
+#endif
+  }
+#endif
+  if (options & SORTED_OUTPUT) dumpopts |= JV_PRINT_SORTED;
+  if (options & ASCII_OUTPUT) dumpopts |= JV_PRINT_ASCII;
+  if (options & COLOR_OUTPUT) dumpopts |= JV_PRINT_COLOR;
+  if (options & NO_COLOR_OUTPUT) dumpopts &= ~JV_PRINT_COLOR;
+
+  jq_colors = jq_getenv("JQ_COLORS");
+  if (jq_colors != NULL) {
+    applied = 1;
+    slot = 0;
+    cursor = jq_colors;
+    nslots = jq_colors_slot_count();
+    jq_colors_reset();
+    while (slot < nslots) {
+      if (*cursor != '\0') {
+        sep = strchr(cursor, ':');
+        if (sep == NULL) {
+          spec_len = strlen(cursor);
+          sep = cursor + spec_len;
+        } else {
+          spec_len = (size_t)(sep - cursor);
+        }
+        if (!jq_colors_put(slot, cursor, spec_len)) {
+          applied = 0;
+          break;
+        }
+        cursor = sep + (*sep == ':');
+        slot++;
+      } else {
+        break;
+      }
+    }
+    if (applied) {
+      jq_colors_commit();
+    } else {
+      fprintf(stderr, "Failed to set $JQ_COLORS\n");
+    }
+  }
+
+  if (jv_get_kind(lib_search_paths) == JV_KIND_NULL) {
+    default_paths[0] = jv_string("~/.jq");
+    default_paths[1] = jv_string("$ORIGIN/../lib/jq");
+    default_paths[2] = jv_string("$ORIGIN/../lib");
+    lib_search_paths = jv_array();
+    lib_search_paths = jv_array_append(lib_search_paths, default_paths[0]);
+    lib_search_paths = jv_array_append(lib_search_paths, default_paths[1]);
+    lib_search_paths = jv_array_append(lib_search_paths, default_paths[2]);
+  }
+  jq_set_attr(jq, jv_string("JQ_LIBRARY_PATH"), lib_search_paths);
+
+  origin = strdup(argv0);
+  if (origin == NULL) {
+    fprintf(stderr, "jq: error: out of memory\n");
+    exit(1);
+  }
+  jq_set_attr(jq, jv_string("JQ_ORIGIN"), jv_string(dirname(origin)));
+  free(origin);
+
+  ver_mark = strchr(JQ_VERSION, '-');
+  if (ver_mark == NULL) {
+    jq_set_attr(jq, jv_string("VERSION_DIR"), jv_string(JQ_VERSION));
+  } else {
+    jq_set_attr(jq, jv_string("VERSION_DIR"),
+                jv_string_fmt("%.*s-master", (int)(ver_mark - JQ_VERSION), JQ_VERSION));
+  }
+
+  return dumpopts;
+}
+
 #ifdef WIN32
 int umain(int argc, char* argv[]);
 
