diff --git a/src/t_stream.c b/src/t_stream.c
index 478d75c5c..5416e93b9 100644
--- a/src/t_stream.c
+++ b/src/t_stream.c
@@ -1511,22 +1511,74 @@ long long streamEstimateDistanceFromFirstEverEntry(stream *s, streamID *id) {
         return SCG_INVALID_ENTRIES_READ;
     }
 
-    int cmp_id_first = streamCompareID(id,&s->first_id);
-    int cmp_xdel_first = streamCompareID(&s->max_deleted_entry_id,&s->first_id);
-    if (streamIDEqZero(&s->max_deleted_entry_id) || cmp_xdel_first < 0) {
-        /* There's definitely no fragmentation ahead. */
-        if (cmp_id_first < 0) {
-            /* Return the estimated counter. */
-            return s->entries_added - s->length;
-        } else if (cmp_id_first == 0) {
-            /* Return the exact counter of the first entry in the stream. */
-            return s->entries_added - s->length + 1;
+    /* Remaining IDs are compared as 128-bit big-endian radix-tree keys so the
+     * ordering matches streamEncodeID() / rax rather than repeating the
+     * millisecond/sequence branching from streamCompareID(). */
+    sds id_key = sdsnewlen(SDS_NOINIT, sizeof(streamID));
+    sds first_key = sdsnewlen(SDS_NOINIT, sizeof(streamID));
+    sds last_key = sdsnewlen(SDS_NOINIT, sizeof(streamID));
+    sds xdel_key = sdsnewlen(SDS_NOINIT, sizeof(streamID));
+    sds zero_key = sdsnewlen(NULL, sizeof(streamID));
+    uint64_t encoded[2];
+    long long estimated = SCG_INVALID_ENTRIES_READ;
+    int xdel_is_zero = 0;
+    int cmp_id_first, cmp_xdel_first, cmp_id_last;
+    uint64_t node_count;
+
+    encoded[0] = htonu64(id->ms);
+    encoded[1] = htonu64(id->seq);
+    memcpy(id_key, encoded, sizeof(encoded));
+
+    encoded[0] = htonu64(s->first_id.ms);
+    encoded[1] = htonu64(s->first_id.seq);
+    memcpy(first_key, encoded, sizeof(encoded));
+
+    encoded[0] = htonu64(s->last_id.ms);
+    encoded[1] = htonu64(s->last_id.seq);
+    memcpy(last_key, encoded, sizeof(encoded));
+
+    encoded[0] = htonu64(s->max_deleted_entry_id.ms);
+    encoded[1] = htonu64(s->max_deleted_entry_id.seq);
+    memcpy(xdel_key, encoded, sizeof(encoded));
+
+    if (memcmp(xdel_key, zero_key, sizeof(streamID)) == 0) {
+        xdel_is_zero = 1;
+    }
+    if (s->max_deleted_entry_id.ms == 0) {
+        if (s->max_deleted_entry_id.seq == 0) {
+            xdel_is_zero = 1;
+        }
+    }
+
+    cmp_id_first = memcmp(id_key, first_key, sizeof(streamID));
+    cmp_xdel_first = memcmp(xdel_key, first_key, sizeof(streamID));
+    cmp_id_last = memcmp(id_key, last_key, sizeof(streamID));
+    node_count = s->rax ? raxSize(s->rax) : 0;
+
+    if (cmp_id_last < 0) {
+        if ((xdel_is_zero || cmp_xdel_first < 0) &&
+            (node_count > 0 || s->length == 0))
+        {
+            /* There's definitely no fragmentation ahead. */
+            if (cmp_id_first < 0) {
+                /* Return the estimated counter. */
+                estimated = (long long)s->entries_added - s->length;
+            } else if (cmp_id_first == 0) {
+                /* Return the exact counter of the first entry in the stream. */
+                estimated = (long long)s->entries_added - s->length + 1;
+            }
         }
     }
 
+    sdsfree(id_key);
+    sdsfree(first_key);
+    sdsfree(last_key);
+    sdsfree(xdel_key);
+    sdsfree(zero_key);
+
     /* The ID is either before an XDEL that fragments the stream or an arbitrary
      * ID. Either case, so we can't make a prediction. */
-    return SCG_INVALID_ENTRIES_READ;
+    return estimated;
 }
 
