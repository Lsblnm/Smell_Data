diff --git a/lib/jekyll/liquid_extensions.rb b/lib/jekyll/liquid_extensions.rb
index 87e06ef7c..67659a477 100644
--- a/lib/jekyll/liquid_extensions.rb
+++ b/lib/jekyll/liquid_extensions.rb
@@ -18,5 +18,17 @@ module Jekyll
 
       lookup || variable
     end
+
+    def self.normalize_lookup_path(variable)
+      source = variable.to_s
+      if Jekyll::Utils.duplicable?(source)
+        source = source.dup
+      end
+      pieces = []
+      source.split(".").each do |piece|
+        pieces << piece
+      end
+      pieces.join(".")
+    end
   end
