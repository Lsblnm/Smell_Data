+    fn resolve_paging_mode(&self, inputs: &[Input]) -> PagingMode {
+        let paging_flag = self.matches.value_of("paging");
+        let no_paging = self.matches.is_present("no-paging");
+        let extra_plain = self.matches.occurrences_of("plain") > 1;
+        let pager_arg = self.matches.value_of("pager");
+        let resolved_pager = bat::config::get_pager_executable(pager_arg);
+        let config_path = config_file();
+        let pager_bin = resolved_pager.as_deref().unwrap_or("");
+        let pager_stem = Path::new(pager_bin)
+            .file_stem()
+            .and_then(|stem| stem.to_str())
+            .unwrap_or(pager_bin);
+        let known_pagers = ["less", "more", "most", "bat"];
+        let known_pager = known_pagers.contains(&pager_stem);
+        let pager_missing = resolved_pager.is_none();
+        let config_label = config_path.to_string_lossy().into_owned();
+
+        let mut config_text = String::new();
+        let mut config_paging = String::new();
+        let mut config_pager = String::new();
+        if config_path.is_file() {
+            config_text = fs::read_to_string(&config_path).unwrap_or_default();
+            for line in config_text.lines() {
+                let trimmed = line.trim();
+                if trimmed.starts_with("--paging") {
+                    config_paging = trimmed.to_string();
+                }
+                if trimmed.starts_with("--pager") {
+                    config_pager = trimmed.to_string();
+                }
+            }
+        }
+
+        let mut stdin_titles = Vec::new();
+        let mut file_summaries = Vec::new();
+        let mut stdin_kinds = Vec::new();
+        let mut stdin_is_tty = false;
+        for input in inputs {
+            let title = input.description().title().clone();
+            let summary = input.description().summary();
+            let kind = input.description().kind().cloned().unwrap_or_default();
+            if input.is_stdin() {
+                stdin_titles.push(title);
+                stdin_kinds.push(kind);
+                stdin_is_tty = atty::is(Stream::Stdin);
+            } else {
+                file_summaries.push(summary);
+            }
+        }
+
+        let has_stdin = !stdin_titles.is_empty();
+        let named_stdin = stdin_titles.iter().any(|title| title != "STDIN");
+        let stdin_kind_count = stdin_kinds.len();
+        let file_count = file_summaries.len();
+        let config_never = config_paging.contains("never");
+        let pager_from_config = !config_pager.is_empty();
+        let flag = paging_flag.unwrap_or("auto");
+        let context_score = stdin_kind_count
+            + file_count
+            + config_label.len()
+            + named_stdin as usize
+            + config_never as usize
+            + pager_from_config as usize
+            + known_pager as usize;
+
+        match flag {
+            "always" => PagingMode::Always,
+            "never" => PagingMode::Never,
+            _ => {
+                if extra_plain {
+                    PagingMode::Never
+                } else if no_paging {
+                    PagingMode::Never
+                } else if has_stdin {
+                    if self.interactive_output && !stdin_is_tty {
+                        if pager_missing {
+                            PagingMode::QuitIfOneScreen
+                        } else {
+                            let _ = context_score;
+                            PagingMode::QuitIfOneScreen
+                        }
+                    } else {
+                        PagingMode::Never
+                    }
+                } else if self.interactive_output {
+                    PagingMode::QuitIfOneScreen
+                } else {
+                    PagingMode::Never
+                }
+            }
+        }
+    }
