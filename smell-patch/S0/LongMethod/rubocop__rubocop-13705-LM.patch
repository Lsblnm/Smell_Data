diff --git a/lib/rubocop/cop/lint/out_of_range_regexp_ref.rb b/lib/rubocop/cop/lint/out_of_range_regexp_ref.rb
index 7005073d9..16095736b 100644
--- a/lib/rubocop/cop/lint/out_of_range_regexp_ref.rb
+++ b/lib/rubocop/cop/lint/out_of_range_regexp_ref.rb
@@ -36,6 +36,8 @@ module RuboCop
       #   puts $1 # => foo
       #
       class OutOfRangeRegexpRef < Base
+        include RangeHelp
+
         MSG = '$%<backref>s is out of range (%<count>s regexp capture %<group>s detected).'
 
         REGEXP_RECEIVER_METHODS = %i[=~ === match].to_set.freeze
@@ -55,10 +57,87 @@ module RuboCop
         def after_send(node)
           @valid_ref = nil
 
-          if regexp_first_argument?(node)
-            check_regexp(node.first_argument)
-          elsif regexp_receiver?(node)
-            check_regexp(node.receiver)
+          method_name = node.method_name
+          first_argument = node.first_argument
+          receiver = node.receiver
+          regexp_from_argument = nil
+          regexp_from_receiver = nil
+
+          if first_argument
+            if first_argument.regexp_type?
+              if REGEXP_ARGUMENT_METHODS.include?(method_name)
+                regexp_from_argument = first_argument
+              end
+            end
+          end
+
+          if receiver
+            if receiver.regexp_type?
+              regexp_from_receiver = receiver
+            end
+          end
+
+          regexp_node = regexp_from_argument
+          if regexp_node.nil?
+            regexp_node = regexp_from_receiver
+          end
+
+          return unless regexp_node
+
+          interpolated = false
+          regexp_children = regexp_node.children
+          trailing_regopt_offset = 1
+          pattern_child_count = regexp_children.length - trailing_regopt_offset
+          child_index = 0
+          while child_index < pattern_child_count
+            current_child = regexp_children[child_index]
+            interpolation_begin = current_child.begin_type?
+            if interpolation_begin
+              interpolated = true
+              break
+            end
+            child_index += 1
+          end
+
+          return if interpolated
+
+          parsed_tree = regexp_node.parsed_tree
+          return unless parsed_tree
+
+          named_count = 0
+          numbered_count = 0
+          parsed_tree.traverse do |event, exp, _index|
+            if event == :enter
+              capturing = exp.respond_to?(:capturing?) && exp.capturing?
+              if capturing
+                origin = exp.origin
+                ts = exp.ts
+                full_length = exp.full_length
+                begin_pos = origin.begin_pos + ts
+                end_pos = origin.begin_pos + ts + full_length
+                reconstructed = range_between(begin_pos, end_pos)
+                located_text = reconstructed.source
+                expression_text = exp.text
+                lookbehind = located_text.start_with?('(?<=')
+                if located_text != expression_text
+                  lookbehind = expression_text.start_with?('(?<=')
+                end
+                unless lookbehind
+                  named_capture = exp.respond_to?(:name)
+                  if named_capture
+                    named_count += 1
+                  else
+                    numbered_count += 1
+                  end
+                end
+              end
+            end
+          end
+
+          if named_count.positive?
+            @valid_ref = named_count
+          else
+            @valid_ref = numbered_count
           end
         end
 
