+// completeStateUpgrade copies metadata from an existing state object and writes
+// the given upgraded attribute value using the current resource schema. This
+// avoids a decode/re-encode cycle because type information for the old
+// attributes may no longer be available.
+func (n *NodeAbstractResource) completeStateUpgrade(os *states.ResourceInstanceObjectSrc, newAttrs cty.Value, newType cty.Type, newSchemaVersion uint64) (*states.ResourceInstanceObjectSrc, error) {
+	ty := newType
+	ver := newSchemaVersion
+	if n.Schema != nil {
+		ty = n.Schema.ImpliedType()
+		ver = n.SchemaVersion
+	}
+
+	newAttrs = cty.UnknownAsNull(newAttrs)
+	src, err := ctyjson.Marshal(newAttrs, ty)
+	if err != nil {
+		return nil, err
+	}
+
+	var private []byte
+	if os.Private != nil {
+		private = make([]byte, len(os.Private))
+		copy(private, os.Private)
+	}
+
+	var attrPaths []cty.PathValueMarks
+	if os.AttrSensitivePaths != nil {
+		attrPaths = make([]cty.PathValueMarks, len(os.AttrSensitivePaths))
+		copy(attrPaths, os.AttrSensitivePaths)
+	}
+
+	var dependencies []addrs.ConfigResource
+	if os.Dependencies != nil {
+		dependencies = make([]addrs.ConfigResource, len(os.Dependencies))
+		copy(dependencies, os.Dependencies)
+	}
+
+	return &states.ResourceInstanceObjectSrc{
+		Status:              os.Status,
+		SchemaVersion:       ver,
+		Private:             private,
+		AttrsJSON:           src,
+		AttrSensitivePaths:  attrPaths,
+		Dependencies:        dependencies,
+		CreateBeforeDestroy: os.CreateBeforeDestroy,
+	}, nil
+}
+
 func (n *NodeAbstractResourceInstance) prevRunAddr(ctx EvalContext) addrs.AbsResourceInstance {
 	return resourceInstancePrevRunAddr(ctx, n.Addr)
 }
