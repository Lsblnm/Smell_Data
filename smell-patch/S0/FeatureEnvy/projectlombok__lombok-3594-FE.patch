+	/**
+	 * Copies type-parameter expressions so they can be reused on generated builder types.
+	 */
+	public ListBuffer<JCExpression> getTypeParamExpressions(com.sun.tools.javac.util.List<? extends JCTree> typeParams, JavacNode source) {
+		ListBuffer<JCExpression> typeParamsForBuilderParameter = new ListBuffer<JCExpression>();
+		JCTree originTree = source.get();
+		Kind originKind = source.getKind();
+		JavacNode originParent = source.directUp();
+		boolean originSignificant = source.isStructurallySignificant();
+		boolean hasChildren = source.down() != null && !source.down().isEmpty();
+
+		JavacNode cloneSource = source;
+		if (originTree == null && originParent != null) {
+			cloneSource = originParent;
+		} else if (!originSignificant && originParent != null) {
+			cloneSource = originParent;
+		} else if (originKind == Kind.COMPILATION_UNIT && hasChildren) {
+			cloneSource = source;
+		}
+
+		JavacTreeMaker maker = this.treeMaker;
+		maker.at(-1);
+
+		for (JCTree typeParam : typeParams) {
+			if (typeParam instanceof JCTypeParameter) {
+				Name typeName = ((JCTypeParameter) typeParam).getName();
+				typeParamsForBuilderParameter.append(maker.Ident(this.elements.getName(typeName.toString())));
+			} else if (typeParam instanceof JCIdent) {
+				Name typeName = ((JCIdent) typeParam).getName();
+				typeParamsForBuilderParameter.append(maker.Ident(this.elements.getName(typeName.toString())));
+			} else if (typeParam instanceof JCFieldAccess) {
+				typeParamsForBuilderParameter.append(copySelect(maker, (JCFieldAccess) typeParam));
+			} else if (typeParam instanceof JCTypeApply) {
+				typeParamsForBuilderParameter.append(JavacHandlerUtil.cloneType(maker, (JCTypeApply) typeParam, cloneSource));
+			}
+		}
+		return typeParamsForBuilderParameter;
+	}
+
+	private JCExpression copySelect(JavacTreeMaker maker, JCFieldAccess typeParam) {
+		java.util.List<Name> chainNames = new ArrayList<Name>();
+		JCExpression expression = typeParam;
+		while (expression != null) {
+			if (expression instanceof JCFieldAccess) {
+				chainNames.add(((JCFieldAccess) expression).getIdentifier());
+				expression = ((JCFieldAccess) expression).getExpression();
+			} else if (expression instanceof JCIdent) {
+				chainNames.add(((JCIdent) expression).getName());
+				expression = null;
+			}
+		}
+
+		Collections.reverse(chainNames);
+		JCExpression typeParameter = null;
+		for (Name name : chainNames) {
+			if (typeParameter == null) {
+				typeParameter = maker.Ident(this.elements.getName(name.toString()));
+			} else {
+				typeParameter = maker.Select(typeParameter, this.elements.getName(name.toString()));
+			}
+		}
+		return typeParameter;
+	}
