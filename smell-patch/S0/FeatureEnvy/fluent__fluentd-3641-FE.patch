 require 'webrick'
+require 'fluent/log'
 
 module Fluent
   module RPC
@@ -33,6 +34,94 @@ module Fluent
         )
       end
 
+      def install_supervisor_routes(owner)
+        endpoint = owner.instance_variable_get(:@rpc_endpoint)
+        return unless endpoint
+
+        enable_get_dump = owner.instance_variable_get(:@enable_get_dump)
+        fluentd_conf = owner.instance_variable_get(:@fluentd_conf)
+        log = @log
+        level = log.level
+        formatter = log.instance_variable_get(:@formatter)
+        color_debug = log.instance_variable_get(:@color_debug)
+        color_reset = log.instance_variable_get(:@color_reset)
+
+        begin
+          if level && level <= Fluent::Log::LEVEL_DEBUG && formatter
+            args = ["listening RPC http server on http://#{@bind}:#{@port}/"]
+            type = log.log_type(args)
+            unless log.skipped_type?(type)
+              time, msg = log.event(:debug, args)
+              unless time.nil?
+                log.puts [color_debug, formatter.call(type, time, Fluent::Log::LEVEL_DEBUG, msg), color_reset].join
+              end
+            end
+          end
+        rescue
+        end
+
+        mount_proc('/api/processes.interruptWorkers') { |req, res|
+          $log.debug "fluentd RPC got /api/processes.interruptWorkers request"
+          Process.kill :INT, $$
+          nil
+        }
+        mount_proc('/api/processes.killWorkers') { |req, res|
+          $log.debug "fluentd RPC got /api/processes.killWorkers request"
+          Process.kill :TERM, $$
+          nil
+        }
+        mount_proc('/api/processes.flushBuffersAndKillWorkers') { |req, res|
+          $log.debug "fluentd RPC got /api/processes.flushBuffersAndKillWorkers request"
+          if Fluent.windows?
+            owner.supervisor_sigusr1_handler
+            owner.stop(true)
+          else
+            Process.kill :USR1, $$
+            Process.kill :TERM, $$
+          end
+          nil
+        }
+        mount_proc('/api/plugins.flushBuffers') { |req, res|
+          $log.debug "fluentd RPC got /api/plugins.flushBuffers request"
+          if Fluent.windows?
+            owner.supervisor_sigusr1_handler
+          else
+            Process.kill :USR1, $$
+          end
+          nil
+        }
+        mount_proc('/api/config.reload') { |req, res|
+          $log.debug "fluentd RPC got /api/config.reload request"
+          if Fluent.windows?
+            owner.kill_worker
+          else
+            Process.kill :HUP, $$
+          end
+          nil
+        }
+        mount_proc('/api/config.dump') { |req, res|
+          $log.debug "fluentd RPC got /api/config.dump request"
+          $log.info "dump in-memory config"
+          $log.info fluentd_conf
+          nil
+        }
+        mount_proc('/api/config.gracefulReload') { |req, res|
+          $log.debug "fluentd RPC got /api/config.gracefulReload request"
+          if Fluent.windows?
+            owner.supervisor_sigusr2_handler
+          else
+            Process.kill :USR2, $$
+          end
+          nil
+        }
+        mount_proc('/api/config.getDump') { |req, res|
+          $log.debug "fluentd RPC got /api/config.getDump request"
+          $log.info "get dump in-memory config via HTTP"
+          res.body = { conf: fluentd_conf }
+          [nil, nil, res]
+        } if enable_get_dump
+      end
+
       def mount(path, servlet, *args)
         @server.mount(path, servlet, *args)
         @log.debug "register #{path} RPC servlet"
@@ -73,7 +162,6 @@ module Fluent
