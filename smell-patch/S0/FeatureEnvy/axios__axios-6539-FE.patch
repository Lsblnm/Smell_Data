diff --git a/lib/helpers/parseProtocol.js b/lib/helpers/parseProtocol.js
index 586ec96..3f277d3 100644
--- a/lib/helpers/parseProtocol.js
+++ b/lib/helpers/parseProtocol.js
@@ -1,6 +1,22 @@
 'use strict';
 
+import { HrefParts } from '../platform/common/utils.js';
+
 export default function parseProtocol(url) {
   const match = /^([-+\w]{1,25})(:?\/\/|:)/.exec(url);
   return match && match[1] || '';
 }
+
+export class ProtocolReader {
+  read(url) {
+    const parts = new HrefParts(url);
+    const colonIndex = parts.raw.indexOf(':');
+
+    if (colonIndex > 0) {
+      parts.schemeName = parts.raw.slice(0, colonIndex);
+      parts.afterScheme = parts.raw.slice(colonIndex + 1);
+    }
+
+    return parts;
+  }
+}
