diff --git a/src/Carbon/Factory.php b/src/Carbon/Factory.php
index 31273baf..803894d8 100644
--- a/src/Carbon/Factory.php
+++ b/src/Carbon/Factory.php
@@ -718,6 +718,42 @@ class Factory
         return $factory;
     }
 
+    /**
+     * @template T of CarbonInterface
+     *
+     * @param T $host
+     * @param T $date
+     *
+     * @return T
+     */
+    public function mutateIfMutable(CarbonInterface $host, CarbonInterface $date): CarbonInterface
+    {
+        $context = clone $this;
+        $context->className = $this->className;
+        $context->settings = $this->settings;
+        $previousClock = FactoryImmutable::getCurrentClock();
+        FactoryImmutable::setCurrentClock($context);
+
+        try {
+            if ($host instanceof DateTimeImmutable) {
+                return $host;
+            }
+
+            $timezone = $date->getTimezone();
+            $timezoneName = $timezone->getName();
+            $timezoneType = $timezone->getType();
+            $timezoneOffset = $timezone->getOffset($date);
+            $appliedTimezone = $timezoneType === 1
+                ? $timezoneName
+                : ($timezoneOffset === $date->offset ? $timezone : $timezoneName);
+            $unix = sprintf('%d.%06d', $date->timestamp, $date->micro);
+
+            return $host->modify('@'.$unix)->setTimezone($appliedTimezone);
+        } finally {
+            FactoryImmutable::setCurrentClock($previousClock);
+        }
+    }
+
     public function __call(string $name, array $arguments): mixed
     {
         $method = new ReflectionMethod($this->className, $name);
