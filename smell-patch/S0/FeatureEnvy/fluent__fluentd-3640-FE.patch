diff --git a/lib/fluent/plugin_helper/timer.rb b/lib/fluent/plugin_helper/timer.rb
index d3047f82..35c2a57d 100644
--- a/lib/fluent/plugin_helper/timer.rb
+++ b/lib/fluent/plugin_helper/timer.rb
@@ -65,6 +65,42 @@ module Fluent
         @_timers = nil
       end
 
+      class RetryWindow
+        def initialize(start_time)
+          @sec = start_time.to_i
+          @nsec = start_time.nsec
+        end
+
+        def calc_max_retry_timeout(backoff)
+          result = 0
+          steps = backoff.max_steps
+          constant_factor = backoff.constant_factor
+          backoff_base = backoff.backoff_base
+          max_interval = backoff.max_interval
+          timeout = backoff.timeout
+          secondary_threshold = backoff.secondary_threshold
+
+          steps.times do |i|
+            interval = constant_factor.to_f * (backoff_base ** (i - 1))
+            if max_interval && interval > max_interval
+              interval = max_interval
+            else
+              unless interval.finite?
+                num = i
+                until interval.finite?
+                  num -= 1
+                  interval = constant_factor.to_f * (backoff_base ** (num - 1))
+                end
+              end
+            end
+            result += interval
+          end
+
+          result = timeout if result > timeout
+          Fluent::Clock.time_at(@sec, @nsec) + result * secondary_threshold
+        end
+      end
+
       class TimerWatcher < Coolio::TimerWatcher
         def initialize(title, interval, repeat, log, checker, detacher, &callback)
           @title = title
