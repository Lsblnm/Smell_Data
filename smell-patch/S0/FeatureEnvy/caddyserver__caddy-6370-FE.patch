+// ConfigFormat holds the filename and adapter clues used to decide
+// whether a config file should be treated as a Caddyfile.
+type ConfigFormat struct {
+	FileName   string
+	Adapter    string
+	BaseName   string
+	Extension  string
+	CaddyNamed bool
+}
