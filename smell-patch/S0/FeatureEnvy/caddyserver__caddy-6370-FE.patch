+// fileIdentity is the path-derived identity of a config file.
+type fileIdentity struct {
+	rawPath   string
+	baseName  string
+	directory string
+	extension string
+	lowerBase string
+}
+
+func newFileIdentity(path string) fileIdentity {
+	base := filepath.Base(path)
+	lower := strings.ToLower(base)
+	return fileIdentity{
+		rawPath:   path,
+		baseName:  base,
+		directory: filepath.Dir(path),
+		extension: filepath.Ext(lower),
+		lowerBase: lower,
+	}
+}
+
+// NewConfigFormat builds the filename/adapter clues used to decide
+// whether a config file should be treated as a Caddyfile.
+func NewConfigFormat(path, adapter string) *ConfigFormat {
+	ident := newFileIdentity(path)
+	joined := filepath.Join(ident.directory, ident.baseName)
+	base := ident.lowerBase
+	if base == "" {
+		base = strings.ToLower(filepath.Base(joined))
+	}
+	if base == "" {
+		base = strings.ToLower(ident.baseName)
+	}
+	ext := ident.extension
+	if ext == "" {
+		ext = filepath.Ext(base)
+	}
+	return &ConfigFormat{
+		FileName:   ident.rawPath,
+		Adapter:    adapter,
+		BaseName:   base,
+		Extension:  ext,
+		CaddyNamed: strings.HasPrefix(base, "caddyfile") || strings.HasSuffix(base, ".caddyfile"),
+	}
+}
