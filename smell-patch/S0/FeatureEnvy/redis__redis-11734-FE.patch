+/* A read-only view of a string object's payload used by bit commands. */
+typedef struct bitStringView {
+    unsigned char *p;
+    long len;
+} bitStringView;
+
+/* Load the byte payload of a string object into 'view'. Integer-encoded
+ * objects are rendered into 'llbuf' so callers can treat every object as a
+ * contiguous byte array. A NULL object yields an empty view. */
+static unsigned char *loadBitStringView(bitStringView *view, robj *o, char *llbuf) {
+    view->p = NULL;
+    view->len = 0;
+    serverAssert(!o || o->type == OBJ_STRING);
+
+    if (o && o->encoding == OBJ_ENCODING_INT) {
+        view->p = (unsigned char*) llbuf;
+        view->len = ll2string(llbuf,LONG_STR_SIZE,(long)o->ptr);
+    } else if (o) {
+        sds s = o->ptr;
+        unsigned char flags = ((unsigned char*)s)[-1];
+        view->p = (unsigned char*) s;
+        switch (flags & SDS_TYPE_MASK) {
+        case SDS_TYPE_5:
+            view->len = SDS_TYPE_5_LEN(flags);
+            break;
+        case SDS_TYPE_8:
+            view->len = SDS_HDR(8,s)->len;
+            break;
+        case SDS_TYPE_16:
+            view->len = SDS_HDR(16,s)->len;
+            break;
+        case SDS_TYPE_32:
+            view->len = SDS_HDR(32,s)->len;
+            break;
+        case SDS_TYPE_64:
+            view->len = SDS_HDR(64,s)->len;
+            break;
+        default:
+            view->len = sdslen(s);
+            break;
+        }
+    }
+    return view->p;
+}
