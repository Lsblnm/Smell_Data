+func (m *pageMap) applyDefaultValues(p *pageMeta) error {
+	if p.pageConfig.Build.IsZero() {
+		p.pageConfig.Build, _ = pagemeta.DecodeBuildConfig(nil)
+	}
+
+	kind := p.Kind()
+	disabled := !m.s.conf.IsKindEnabled(kind)
+	if kind == kinds.KindPage {
+		disabled = disabled || m.cfg.pageDisabled
+	} else if kind == kinds.KindTaxonomy {
+		disabled = disabled || m.cfg.taxonomyDisabled
+	} else if kind == kinds.KindTerm {
+		disabled = disabled || m.cfg.taxonomyTermDisabled
+	}
+	if disabled {
+		(&p.pageConfig.Build).Disable()
+	}
+
+	if p.pageConfig.Content.Markup == "" {
+		if p.File() != nil {
+			// Fall back to file extension
+			p.pageConfig.Content.Markup = m.s.ContentSpec.ResolveMarkup(p.File().Ext())
+		}
+		if p.pageConfig.Content.Markup == "" {
+			p.pageConfig.Content.Markup = "markdown"
+		}
+	}
+
+	if p.pageConfig.Title == "" && p.f == nil {
+		switch kind {
+		case kinds.KindHome:
+			p.pageConfig.Title = m.s.Title()
+		case kinds.KindSection:
+			sectionName := p.pathInfo.Unnormalized().BaseNameNoIdentifier()
+			if m.s.conf.PluralizeListTitles {
+				sectionName = flect.Pluralize(sectionName)
+			}
+			if m.s.conf.CapitalizeListTitles {
+				sectionName = m.s.conf.C.CreateTitle(sectionName)
+			}
+			p.pageConfig.Title = sectionName
+		case kinds.KindTerm:
+			if p.term != "" {
+				if m.s.conf.CapitalizeListTitles {
+					p.pageConfig.Title = m.s.conf.C.CreateTitle(p.term)
+				} else {
+					p.pageConfig.Title = p.term
+				}
+			} else {
+				panic("term not set")
+			}
+		case kinds.KindTaxonomy:
+			if m.s.conf.CapitalizeListTitles {
+				p.pageConfig.Title = strings.Replace(m.s.conf.C.CreateTitle(p.pathInfo.Unnormalized().BaseNameNoIdentifier()), "-", " ", -1)
+			} else {
+				p.pageConfig.Title = strings.Replace(p.pathInfo.Unnormalized().BaseNameNoIdentifier(), "-", " ", -1)
+			}
+		case kinds.KindStatus404:
+			p.pageConfig.Title = "404 Page not found"
+		}
+	}
+
+	return nil
+}
