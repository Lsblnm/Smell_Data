+    /**
+     * @param mixed ...$arguments
+     */
+    public function processArguments(ArrayArgumentHelper $arrayArgumentHelper, callable $method, ...$arguments): array
+    {
+        $this->argumentHelper = $arrayArgumentHelper;
+        $this->processedArguments = $arguments;
+
+        $indexStart = $this->argumentHelper->getIndexStart();
+        $argumentCount = $this->argumentHelper->getArgumentCount();
+        $rows = $this->argumentHelper->getRows();
+        $columns = $this->argumentHelper->getColumns();
+        $helperArguments = $this->argumentHelper->arguments();
+
+        $arrayArgumentCount = 0;
+        foreach (array_keys($helperArguments) as $argument) {
+            if ($rows[$argument] > 1 || $columns[$argument] > 1) {
+                ++$arrayArgumentCount;
+            }
+        }
+
+        if ($arrayArgumentCount === 0) {
+            return [$method(...$this->processedArguments)];
+        }
+
+        if ($arrayArgumentCount === 1) {
+            $nthArgument = 0;
+            $rowArrays = array_filter($rows, function ($value) {
+                return $value > 1;
+            });
+            $columnArrays = array_filter($columns, function ($value) {
+                return $value > 1;
+            });
+            for ($index = $indexStart; $index < $argumentCount; ++$index) {
+                if (isset($rowArrays[$index]) || isset($columnArrays[$index])) {
+                    $nthArgument = $index + 1;
+                    break;
+                }
+            }
+
+            return $this->evaluateNthArgumentAsArray($method, $nthArgument);
+        }
+
+        $rowVectors = [];
+        $columnVectors = [];
+        for ($index = $indexStart; $index < ($indexStart + $argumentCount); ++$index) {
+            if (isset($rows[$index], $columns[$index]) && $rows[$index] === 1 && $columns[$index] > 1) {
+                $rowVectors[] = $index;
+            }
+            if (isset($rows[$index], $columns[$index]) && $rows[$index] > 1 && $columns[$index] === 1) {
+                $columnVectors[] = $index;
+            }
+        }
+        $singleRowVectorIndex = count($rowVectors) === 1 ? array_pop($rowVectors) : null;
+        $singleColumnVectorIndex = count($columnVectors) === 1 ? array_pop($columnVectors) : null;
+
+        if ($singleRowVectorIndex !== null && $singleColumnVectorIndex !== null) {
+            return $this->evaluateVectorPair($method, $singleRowVectorIndex, $singleColumnVectorIndex);
+        }
+
+        $matrixPair = [];
+        for ($i = $indexStart; $i < ($indexStart + $argumentCount - 1); ++$i) {
+            for ($j = $i + 1; $j < $argumentCount; ++$j) {
+                if (isset($rows[$i], $rows[$j])) {
+                    $matrixPair = [$i, $j];
+                    break 2;
+                }
+            }
+        }
+        if ($matrixPair !== []) {
+            $firstIsVector = $rows[$matrixPair[0]] === 1 || $columns[$matrixPair[0]] === 1;
+            $secondIsVector = $rows[$matrixPair[1]] === 1 || $columns[$matrixPair[1]] === 1;
+            if (($firstIsVector === true && $secondIsVector === false) || ($firstIsVector === false && $secondIsVector === true)) {
+                return $this->evaluateVectorMatrixPair($method, $matrixPair);
+            }
+
+            return $this->evaluateMatrixPair($method, $matrixPair);
+        }
+
+        return ['#VALUE!'];
+    }
+
+    private function evaluateVectorMatrixPair(callable $method, array $matrixIndexes): array
+    {
+        $arguments = $this->processedArguments;
+        $rows = $this->argumentHelper->getRows();
+        $columns = $this->argumentHelper->getColumns();
+
+        $matrix2 = array_pop($matrixIndexes);
+        /** @var array $matrixValues2 */
+        $matrixValues2 = $arguments[$matrix2];
+        $matrix1 = array_pop($matrixIndexes);
+        /** @var array $matrixValues1 */
+        $matrixValues1 = $arguments[$matrix1];
+
+        $rowCount = min($rows[$matrix1], $rows[$matrix2]);
+        $columnCount = min($columns[$matrix1], $columns[$matrix2]);
+
+        if ($rowCount === 1) {
+            $rowCount = max($rows[$matrix1], $rows[$matrix2]);
+        }
+        if ($columnCount === 1) {
+            $columnCount = max($columns[$matrix1], $columns[$matrix2]);
+        }
+
+        $result = [];
+        for ($rowIndex = 0; $rowIndex < $rowCount; ++$rowIndex) {
+            for ($columnIndex = 0; $columnIndex < $columnCount; ++$columnIndex) {
+                $rowIndex1 = $rows[$matrix1] === 1 ? 0 : $rowIndex;
+                $columnIndex1 = $columns[$matrix1] === 1 ? 0 : $columnIndex;
+                $value1 = $matrixValues1[$rowIndex1][$columnIndex1];
+                $rowIndex2 = $rows[$matrix2] === 1 ? 0 : $rowIndex;
+                $columnIndex2 = $columns[$matrix2] === 1 ? 0 : $columnIndex;
+                $value2 = $matrixValues2[$rowIndex2][$columnIndex2];
+                $arguments[$matrix1] = $value1;
+                $arguments[$matrix2] = $value2;
+
+                $result[$rowIndex][$columnIndex] = $method(...$arguments);
+            }
+        }
+
+        return $result;
+    }
+
+    private function evaluateMatrixPair(callable $method, array $matrixIndexes): array
+    {
+        $arguments = $this->processedArguments;
+        $matrix2 = array_pop($matrixIndexes);
+        /** @var array $matrixValues2 */
+        $matrixValues2 = $arguments[$matrix2];
+        $matrix1 = array_pop($matrixIndexes);
+        /** @var array $matrixValues1 */
+        $matrixValues1 = $arguments[$matrix1];
+
+        $result = [];
+        foreach ($matrixValues1 as $rowIndex => $row) {
+            foreach ($row as $columnIndex => $value1) {
+                if (isset($matrixValues2[$rowIndex][$columnIndex]) === false) {
+                    continue;
+                }
+
+                $value2 = $matrixValues2[$rowIndex][$columnIndex];
+                $arguments[$matrix1] = $value1;
+                $arguments[$matrix2] = $value2;
+
+                $result[$rowIndex][$columnIndex] = $method(...$arguments);
+            }
+        }
+
+        return $result;
+    }
+
+    private function evaluateVectorPair(callable $method, int $rowIndex, int $columnIndex): array
+    {
+        $arguments = $this->processedArguments;
+        $rowVector = Functions::flattenArray($arguments[$rowIndex]);
+        $columnVector = Functions::flattenArray($arguments[$columnIndex]);
+
+        $result = [];
+        foreach ($columnVector as $column) {
+            $rowResults = [];
+            foreach ($rowVector as $row) {
+                $arguments[$rowIndex] = $row;
+                $arguments[$columnIndex] = $column;
+
+                $rowResults[] = $method(...$arguments);
+            }
+            $result[] = $rowResults;
+        }
+
+        return $result;
+    }
+
+    private function evaluateNthArgumentAsArray(callable $method, int $nthArgument): array
+    {
+        $arguments = $this->processedArguments;
+        $values = array_slice($arguments, $nthArgument - 1, 1);
+        /** @var array $values */
+        $values = array_pop($values);
+
+        $result = [];
+        foreach ($values as $value) {
+            $arguments[$nthArgument - 1] = $value;
+            $result[] = $method(...$arguments);
+        }
+
+        return $result;
+    }
 }
