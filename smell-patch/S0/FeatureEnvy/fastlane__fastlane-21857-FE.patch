diff --git a/fastlane_core/lib/fastlane_core/print_table.rb b/fastlane_core/lib/fastlane_core/print_table.rb
index 622350d20..bcbe3bdb2 100644
--- a/fastlane_core/lib/fastlane_core/print_table.rb
+++ b/fastlane_core/lib/fastlane_core/print_table.rb
@@ -129,5 +129,53 @@ module FastlaneCore
         rows
       end
     end
+
+    attr_accessor :colorize_keys
+    attr_accessor :colorize_deprecated
+
+    def initialize
+      @colorize_keys = true
+      @colorize_deprecated = true
+    end
+
+    def format_config_item_rows(options, fill_all = true)
+      rows = []
+      rows << [options] if options.kind_of?(String)
+
+      if options.kind_of?(Array)
+        options.each do |current|
+          if current.kind_of?(FastlaneCore::ConfigItem)
+            key_text = current.key.to_s
+            key_text = key_text.yellow if @colorize_keys
+
+            description_text = current.description
+            description_text = description_text.red if @colorize_deprecated && current.deprecated
+
+            env_text = current.env_names.join(", ")
+
+            default_text = if current.default_value_dynamic
+                             "#{current.default_value} *".strip
+                           elsif current.default_value.nil?
+                             ""
+                           elsif current.default_value.instance_of?(String) && current.default_value.empty?
+                             "''"
+                           elsif current.default_value.instance_of?(Symbol)
+                             ":#{current.default_value}"
+                           else
+                             current.default_value
+                           end
+
+            rows << [key_text, description_text, env_text, default_text]
+          elsif current.kind_of?(Array)
+            UI.user_error!("Invalid number of elements in this row: #{current}. Must be 2 or 3") unless [2, 3].include?(current.count)
+            rows << current
+            rows.last[0] = rows.last.first.yellow if @colorize_keys
+            rows.last << nil while fill_all && rows.last.count < 4
+          end
+        end
+      end
+
+      rows
+    end
   end
 end
