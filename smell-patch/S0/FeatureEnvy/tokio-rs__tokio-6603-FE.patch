+    fn is_empty(&self) -> bool {
+        self.rx_fields.with(|rx_fields_ptr| {
+            let rx_fields = unsafe { &*rx_fields_ptr };
+            let list = &rx_fields.list;
+            let block = unsafe { list.head.as_ref() };
+
+            let start_index = block.start_index();
+            let slot_capacity = block.slot_capacity();
+            let offset = list.index.wrapping_sub(start_index) & (slot_capacity - 1);
+            let ready_bits = block.ready_slots();
+            let ready_mask = 1 << offset;
+            if ready_mask == ready_mask & ready_bits {
+                return false;
+            }
+
+            // It is possible that a block has no value "now" but the list is still not empty.
+            // To be sure, it is necessary to check the length of the list.
+            list.len(&self.tx) == 0
+        })
+    }
