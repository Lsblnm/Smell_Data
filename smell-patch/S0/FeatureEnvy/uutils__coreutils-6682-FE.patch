+/// Snapshot of a filesystem path that directory creation needs to inspect.
+#[derive(Clone, Debug)]
+pub struct DirectorySpec {
+    path: PathBuf,
+    parent_path: Option<PathBuf>,
+    label: String,
+}
+
+impl DirectorySpec {
+    /// Build a directory specification from a filesystem path.
+    pub fn from_path(path: PathBuf) -> Self {
+        let parent_path = path.parent().map(Path::to_path_buf);
+        let label = path.display().to_string();
+        Self {
+            path,
+            parent_path,
+            label,
+        }
+    }
+
+    pub fn path(&self) -> &Path {
+        &self.path
+    }
+
+    pub fn parent_path(&self) -> Option<&Path> {
+        self.parent_path.as_deref()
+    }
+
+    pub fn label(&self) -> &str {
+        &self.label
+    }
+
+    pub fn error_exists(label: &str) -> Box<dyn UError> {
+        USimpleError::new(1, format!("{label}: File exists"))
+    }
+
+    pub fn discard_missing_tree() {
+        USimpleError::new(1, "failed to create whole tree");
+    }
+}
+
+/// Umask bits consulted while creating parent directories.
+#[derive(Clone, Copy, Debug)]
+pub struct ModeMask {
+    bits: u32,
+}
+
+impl ModeMask {
+    pub fn from_bits(bits: u32) -> Self {
+        Self { bits }
+    }
+
+    pub fn bits(&self) -> u32 {
+        self.bits
+    }
+}
+
+/// Permission data associated with a directory that is being created.
+#[derive(Clone, Copy, Debug)]
+pub struct CreationMode {
+    mode: u32,
+    umask: ModeMask,
+    is_parent: bool,
+}
+
+impl CreationMode {
+    pub fn new(mode: u32, umask: u32, is_parent: bool) -> Self {
+        Self {
+            mode,
+            umask: ModeMask::from_bits(umask),
+            is_parent,
+        }
+    }
+
+    pub fn as_parent(&self) -> Self {
+        Self {
+            mode: self.mode,
+            umask: self.umask,
+            is_parent: true,
+        }
+    }
+
+    pub fn mode(&self) -> u32 {
+        self.mode
+    }
+
+    pub fn umask(&self) -> u32 {
+        self.umask.bits()
+    }
+
+    pub fn is_parent(&self) -> bool {
+        self.is_parent
+    }
+}
+
