+// fileReadSettings holds the file-placeholder load configuration.
+type fileReadSettings struct {
+	MaxBytes        int
+	FSKey           string
+	FallbackWD      string
+	Logger          *zap.Logger
+	ErrorMessage    string
+	FileLabel       string
+	WorkingDirLabel string
+}
+
+var defaultFileReadSettings = fileReadSettings{
+	MaxBytes:        1024 * 1024,
+	FSKey:           "default",
+	FallbackWD:      "",
+	ErrorMessage:    "placeholder: failed to read file",
+	FileLabel:       "file",
+	WorkingDirLabel: "working_dir",
+}
+
+func placeholderLogger() *zap.Logger {
+	return Log()
+}
+
+func (s fileReadSettings) open(name string) (fs.File, error) {
+	return openPlaceholderFile(name, s.FSKey)
+}
