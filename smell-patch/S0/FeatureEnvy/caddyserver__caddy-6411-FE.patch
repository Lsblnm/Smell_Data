+func openPlaceholderFile(name, fsKey string) (fs.File, error) {
+	var table filesystems.FilesystemMap
+	fsys, ok := table.Get(fsKey)
+	if !ok || fsys == nil {
+		fsys = filesystems.DefaultFilesystem
+	}
+	return fsys.Open(name)
+}
