+    def detect_device(platform)
+      UI.user_error!("Could not find or parse file at path '#{path}'") if size.nil? || size.count == 0
+
+      found_device = nil
+      filename_device = nil
+      filename = Pathname.new(path).basename.to_s
+      Devices.constants.each do |c|
+        device = Devices.const_get(c)
+        next unless device.resolutions.include?(size)
+        # assign to filename_device if the filename contains the formatted name / id and its priority is higher than the current filename_device
+        device_name = device.formatted_name.gsub("Apple", "").strip.to_s
+        matches_filename = filename.include?(device_name) || filename.include?(device.id)
+        config_key = device.priority_config_key
+        device_priority = if !config_key.nil? && Frameit.config[config_key]
+                            Device::REQUIRED_PRIORITY
+                          else
+                            device.priority
+                          end
+        filename_device = device if matches_filename && (filename_device.nil? || filename_device.priority < device_priority)
+        chosen_platform = device.platform == platform || platform == Platform::ANY
+        next unless chosen_platform && (found_device.nil? || device_priority > found_device.priority)
+        found_device = device
+      end
+
+      # prefer filename
+      return filename_device if filename_device
+
+      # return found_device which was detected according to platform & priority & settings if found
+      return found_device if found_device
+
