+
+func (ash *Handler) checkCaddyfileLifetime(dur time.Duration) error {
+	if d := time.Duration(ash.caddyfileCA.IntermediateLifetime); d > 0 && dur > d {
+		return fmt.Errorf("certificate lifetime (%s) exceeds intermediate certificate lifetime (%s)", dur, d)
+	}
+	return nil
+}
