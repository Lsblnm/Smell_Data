diff --git a/modules/caddypki/acmeserver/policy.go b/modules/caddypki/acmeserver/policy.go
index 96137e6e..aa3d082b 100644
--- a/modules/caddypki/acmeserver/policy.go
+++ b/modules/caddypki/acmeserver/policy.go
@@ -3,6 +3,9 @@ package acmeserver
 import (
 	"github.com/smallstep/certificates/authority/policy"
 	"github.com/smallstep/certificates/authority/provisioner"
+
+	"github.com/caddyserver/caddy/v2"
+	"github.com/caddyserver/caddy/v2/caddyconfig/httpcaddyfile"
 )
 
 // Policy defines the criteria for the ACME server
@@ -81,3 +84,99 @@ func (p *Policy) normalizeRules() *provisioner.X509Options {
 		AllowWildcardNames: p.AllowWildcardNames,
 	}
 }
+
+// unmarshalACMEServer reads ACME server options from Caddyfile tokens.
+func (p *Policy) unmarshalACMEServer(h httpcaddyfile.Helper, matcherSet caddy.ModuleMap) ([]httpcaddyfile.ConfigValue, error) {
+	var acmeServer Handler
+	configured := false
+
+	for h.NextBlock(0) {
+		switch h.Val() {
+		case "ca":
+			if !h.AllArgs(&acmeServer.CA) {
+				return nil, h.ArgErr()
+			}
+			acmeServer.attachCaddyfileCA()
+		case "lifetime":
+			if !h.NextArg() {
+				return nil, h.ArgErr()
+			}
+
+			dur, err := caddy.ParseDuration(h.Val())
+			if err != nil {
+				return nil, err
+			}
+			if err := acmeServer.checkCaddyfileLifetime(dur); err != nil {
+				return nil, h.Errf("%s", err.Error())
+			}
+			acmeServer.Lifetime = caddy.Duration(dur)
+		case "resolvers":
+			acmeServer.Resolvers = h.RemainingArgs()
+			if len(acmeServer.Resolvers) == 0 {
+				return nil, h.Errf("must specify at least one resolver address")
+			}
+		case "challenges":
+			acmeServer.Challenges = append(acmeServer.Challenges, stringToChallenges(h.RemainingArgs())...)
+		case "allow_wildcard_names":
+			p.AllowWildcardNames = true
+			configured = true
+		case "allow":
+			r := &RuleSet{}
+			for h.Next() {
+				for h.NextBlock(h.Nesting() - 1) {
+					if h.CountRemainingArgs() == 0 {
+						return nil, h.ArgErr() // TODO:
+					}
+					switch h.Val() {
+					case "domains":
+						r.Domains = append(r.Domains, h.RemainingArgs()...)
+					case "ip_ranges":
+						r.IPRanges = append(r.IPRanges, h.RemainingArgs()...)
+					default:
+						return nil, h.Errf("unrecognized 'allow' subdirective: %s", h.Val())
+					}
+				}
+			}
+			p.Allow = r
+			configured = true
+		case "deny":
+			r := &RuleSet{}
+			for h.Next() {
+				for h.NextBlock(h.Nesting() - 1) {
+					if h.CountRemainingArgs() == 0 {
+						return nil, h.ArgErr() // TODO:
+					}
+					switch h.Val() {
+					case "domains":
+						r.Domains = append(r.Domains, h.RemainingArgs()...)
+					case "ip_ranges":
+						r.IPRanges = append(r.IPRanges, h.RemainingArgs()...)
+					default:
+						return nil, h.Errf("unrecognized 'deny' subdirective: %s", h.Val())
+					}
+				}
+			}
+			p.Deny = r
+			configured = true
+		default:
+			return nil, h.Errf("unrecognized ACME server directive: %s", h.Val())
+		}
+	}
+
+	if configured {
+		acmeServer.Policy = p
+	}
+
+	return acmeServer.caddyfileConfigValues(h, matcherSet), nil
+}
+
+func (ash Handler) caddyfileConfigValues(h httpcaddyfile.Helper, matcherSet caddy.ModuleMap) []httpcaddyfile.ConfigValue {
+	configVals := h.NewRoute(matcherSet, ash)
+	if ash.caddyfileCA == nil {
+		return configVals
+	}
+	return append(configVals, httpcaddyfile.ConfigValue{
+		Class: "pki.ca",
+		Value: ash.caddyfileCA,
+	})
+}
