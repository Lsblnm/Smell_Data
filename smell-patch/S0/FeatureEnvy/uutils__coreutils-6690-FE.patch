+    /// Copy a single directory-traversal entry using the active copy options.
+    #[allow(clippy::too_many_arguments)]
+    fn copy_direntry(
+        &self,
+        progress_bar: &Option<ProgressBar>,
+        context: &crate::copydir::Context,
+        entry: crate::copydir::Entry,
+        symlinked_files: &mut HashSet<FileInformation>,
+        preserve_hard_links: bool,
+        copied_destinations: &HashSet<PathBuf>,
+        copied_files: &mut HashMap<FileInformation, PathBuf>,
+    ) -> CopyResult<()> {
+        let source_absolute = context.current_dir.join(&entry.source_relative);
+        let descendant = crate::copydir::get_local_to_root_parent(
+            &source_absolute,
+            context.root_parent.as_deref(),
+        )?;
+        let relative_to_root = entry
+            .source_relative
+            .strip_prefix(context.root)
+            .unwrap_or(&entry.source_relative);
+        let local_to_target = context.target.join(
+            entry
+                .local_to_target
+                .strip_prefix(context.target)
+                .unwrap_or(relative_to_root),
+        );
+        let local_to_target = if local_to_target.as_os_str().is_empty() {
+            context.target.join(descendant)
+        } else {
+            local_to_target
+        };
+        let entry = crate::copydir::Entry {
+            source_absolute,
+            source_relative: entry.source_relative,
+            local_to_target,
+        };
+
+        // If the source is a symbolic link and the options tell us not to
+        // dereference the link, then copy the link object itself.
+        if entry.source_absolute.is_symlink() && !self.dereference {
+            return copy_link(
+                &entry.source_absolute,
+                &entry.local_to_target,
+                symlinked_files,
+            );
+        }
+
+        // If the source is a directory and the destination does not
+        // exist, ...
+        if entry.source_absolute.is_dir()
+            && !crate::copydir::ends_with_slash_dot(&entry.source_absolute)
+            && !entry.local_to_target.exists()
+        {
+            if context.target.is_file() {
+                return Err("cannot overwrite non-directory with directory".into());
+            } else {
+                crate::copydir::build_dir(self, &entry.local_to_target, false)?;
+                if self.verbose {
+                    println!(
+                        "{}",
+                        context_for(&entry.source_relative, &entry.local_to_target)
+                    );
+                }
+                return Ok(());
+            }
+        }
+
+        // If the source is not a directory, then we need to copy the file.
+        if !entry.source_absolute.is_dir() {
+            if preserve_hard_links {
+                match copy_file(
+                    progress_bar,
+                    &entry.source_absolute,
+                    entry.local_to_target.as_path(),
+                    self,
+                    symlinked_files,
+                    copied_destinations,
+                    copied_files,
+                    false,
+                ) {
+                    Ok(_) => Ok(()),
+                    Err(err) => {
+                        if entry.source_absolute.is_symlink() {
+                            // silent the error with a symlink
+                            // In case we do --archive, we might copy the symlink
+                            // before the file itself
+                            Ok(())
+                        } else {
+                            Err(err)
+                        }
+                    }
+                }?;
+            } else {
+                // At this point,  is just a plain old file.
+                // Terminate this function immediately if there is any
+                // kind of error *except* a "permission denied" error.
+                //
+                // TODO What other kinds of errors, if any, should
+                // cause us to continue walking the directory?
+                match copy_file(
+                    progress_bar,
+                    &entry.source_absolute,
+                    entry.local_to_target.as_path(),
+                    self,
+                    symlinked_files,
+                    copied_destinations,
+                    copied_files,
+                    false,
+                ) {
+                    Ok(_) => {}
+                    Err(Error::IoErrContext(e, _))
+                        if e.kind() == std::io::ErrorKind::PermissionDenied =>
+                    {
+                        show!(uio_error!(
+                            e,
+                            "cannot open {} for reading",
+                            entry.source_relative.quote(),
+                        ));
+                    }
+                    Err(e) => return Err(e),
+                }
+            }
+        }
+
+        Ok(())
+    }
