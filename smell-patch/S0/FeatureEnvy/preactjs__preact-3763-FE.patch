+/**
+ * Captures the props/state snapshot for a component being diffed and applies
+ * pending derived state plus queued setState callbacks.
+ */
+export function DiffFrame() {
+	this._oldProps = undefined;
+	this._oldState = undefined;
+}
+
+/**
+ * @param {import('../internal').Component} component
+ * @param {import('../internal').ComponentType} ctor
+ * @param {object} newProps
+ */
+DiffFrame.prototype.syncPropsState = function(component, ctor, newProps) {
+	if (component._nextState == null) {
+		component._nextState = component.state;
+	}
+
+	if (ctor.getDerivedStateFromProps != null) {
+		if (component._nextState == component.state) {
+			component._nextState = assign({}, component._nextState);
+		}
+
+		assign(
+			component._nextState,
+			ctor.getDerivedStateFromProps(newProps, component._nextState)
+		);
+	}
+
+	this._oldProps = component.props;
+	this._oldState = component.state;
+
+	for (let i = 0; i < component._stateCallbacks.length; i++) {
+		component._renderCallbacks.push(component._stateCallbacks[i]);
+		component._stateCallbacks = [];
+	}
+};
 
