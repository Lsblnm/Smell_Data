diff --git a/lib/rubocop/cop/correctors/if_then_corrector.rb b/lib/rubocop/cop/correctors/if_then_corrector.rb
index 54ada1e8f..8dab49904 100644
--- a/lib/rubocop/cop/correctors/if_then_corrector.rb
+++ b/lib/rubocop/cop/correctors/if_then_corrector.rb
@@ -15,6 +15,37 @@ module RuboCop
         corrector.replace(if_node, replacement)
       end
 
+      def accepted_if?(ending, cop)
+        node = if_node
+        config = cop.config
+        source = cop.processed_source
+        width = config && cop.send(:configured_indentation_width)
+        indent = indentation == width ? width : indentation
+
+        condition = node.condition
+        if_branch = node.if_branch
+        else_branch = node.else_branch
+        parent = node.parent
+        keyword = node.keyword
+
+        line_no = node.first_line
+        directive = source && cop.send(:directive_on_source_line?, line_no - 1)
+
+        return true if node.modifier_form?
+        return true if node.ternary? || (keyword.empty? && condition && if_branch && else_branch)
+        return true if else_branch&.if_type? && else_branch.elsif?
+        return true if condition.multiline?
+        return true if parent&.assignment?
+        return true if directive && node.ternary?
+
+        has_else = indent.is_a?(Integer) ? node.else? : node.else?
+        if ending
+          has_else
+        else
+          !has_else || node.elsif?
+        end
+      end
+
       private
 
       attr_reader :if_node, :indentation
