diff --git a/lib/fluent/plugin/parser.rb b/lib/fluent/plugin/parser.rb
index 9a6d20a8..b309a5c8 100644
--- a/lib/fluent/plugin/parser.rb
+++ b/lib/fluent/plugin/parser.rb
@@ -270,6 +270,109 @@ module Fluent
 
         converters
       end
+
+      def on_request(http_input, path_info, params)
+        begin
+          path = path_info[1..-1]  # remove /
+          tag = path.split('/').join('.')
+          record_time, record = http_input.parse_params(params)
+
+          # Skip nil record
+          if record.nil?
+            http_input.log.debug { "incoming event is invalid: path=#{path_info} params=#{params.to_json}" }
+            if http_input.respond_with_empty_img
+              return http_input.class::RESPONSE_IMG
+            else
+              if http_input.use_204_response
+                return http_input.class::RESPONSE_204
+              else
+                return http_input.class::RESPONSE_200
+              end
+            end
+          end
+
+          mes = nil
+          # Support batched requests
+          if record.is_a?(Array)
+            mes = Fluent::MultiEventStream.new
+            record.each do |single_record|
+              http_input.__send__(:add_params_to_record, single_record, params)
+
+              if param_time = params['time']
+                param_time = param_time.to_f
+                single_time = param_time.zero? ? Fluent::EventTime.now : http_input.float_time_parser.parse(param_time)
+              elsif custom_parser = http_input.custom_parser
+                single_time = custom_parser.parse_time(single_record)
+                single_time, single_record = custom_parser.convert_values(single_time, single_record)
+              else
+                if t = @keep_time_key ? single_record[@time_key] : single_record.delete(@time_key)
+                  time_parser = http_input.default_time_parser
+                  if time_parser
+                    single_time = time_parser.parse(t)
+                  else
+                    single_time = Fluent::EventTime.from_time(Time.at(t))
+                  end
+                else
+                  single_time = Fluent::EventTime.now
+                end
+              end
+
+              mes.add(single_time, single_record)
+            end
+          else
+            http_input.__send__(:add_params_to_record, record, params)
+
+            time = if param_time = params['time']
+                     param_time = param_time.to_f
+                     param_time.zero? ? Fluent::EventTime.now : http_input.float_time_parser.parse(param_time)
+                   else
+                     if record_time.nil?
+                       if t = @keep_time_key ? record[@time_key] : record.delete(@time_key)
+                         time_parser = http_input.default_time_parser
+                         if time_parser
+                           time_parser.parse(t)
+                         else
+                           Fluent::EventTime.from_time(Time.at(t))
+                         end
+                       else
+                         Fluent::EventTime.now
+                       end
+                     else
+                       record_time
+                     end
+                   end
+          end
+        rescue => e
+          if http_input.dump_error_log
+            http_input.log.error "failed to process request", error: e
+          end
+          return [http_input.class::RES_400_STATUS, http_input.class::RES_TEXT_HEADER, "400 Bad Request\n#{e}\n"]
+        end
+
+        # TODO server error
+        begin
+          if mes
+            http_input.router.emit_stream(tag, mes)
+          else
+            http_input.router.emit(tag, time, record)
+          end
+        rescue => e
+          if http_input.dump_error_log
+            http_input.log.error "failed to emit data", error: e
+          end
+          return [http_input.class::RES_500_STATUS, http_input.class::RES_TEXT_HEADER, "500 Internal Server Error\n#{e}\n"]
+        end
+
+        if http_input.respond_with_empty_img
+          return http_input.class::RESPONSE_IMG
+        else
+          if http_input.use_204_response
+            return http_input.class::RESPONSE_204
+          else
+            return http_input.class::RESPONSE_200
+          end
+        end
+      end
     end
   end
 end
