+        def ignored_literal_ranges(ast)
+          @ignored_literal_range_cache ||= {}
+          cache_key = [@processed_source.object_id, ast.object_id]
+          if @ignored_literal_range_cache.key?(cache_key)
+            return @ignored_literal_range_cache[cache_key]
+          end
+
+          collected = Set.new
+          if ast
+            ast.each_node(:str, :dstr, :array) do |literal|
+              loc = literal.location
+              parent = literal.parent
+
+              if literal.type == :array
+                next unless literal.percent_literal?
+
+                collected << loc.expression
+              elsif literal.heredoc?
+                marker_range = loc.expression
+                collected << if marker_range.single_line?
+                               loc.heredoc_body
+                             else
+                               marker_range
+                             end
+              elsif (loc.respond_to?(:begin) && loc.begin) ||
+                    (parent && parent.type?(:regexp, :xstr))
+                collected << loc.expression
+              end
+            end
+          end
+
+          @ignored_literal_range_cache[cache_key] = collected
+        end
