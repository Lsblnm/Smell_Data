+    /**
+     * Calculate a period end date from recurrences using this interval as the step.
+     */
+    public function calculateEndFromRecurrences(CarbonPeriod $period): ?CarbonInterface
+    {
+        $interval = new static(0);
+        $interval->copyProperties($this, true);
+        $interval->invert = $this->invert;
+        $interval->step = $this->step;
+
+        $recurrences = $period->getRecurrences();
+
+        if ($recurrences === null) {
+            throw new UnreachableException(
+                "Could not calculate period end without either explicit end or recurrences.\n".
+                "If you're looking for a forever-period, use ->setRecurrences(INF).",
+            );
+        }
+
+        $start = $period->getStartDate();
+        $filters = $period->getFilters();
+        $startExcluded = $period->isStartExcluded();
+
+        if ($recurrences === INF) {
+            $probe = $start->avoidMutation()->add($interval);
+            $order = ($start->timestamp <=> $probe->timestamp) ?: ($start->micro <=> $probe->micro);
+
+            return $order < 0
+                ? CarbonImmutable::endOfTime()
+                : CarbonImmutable::startOfTime();
+        }
+
+        if ($filters === [[CarbonPeriod::RECURRENCES_FILTER, null]]) {
+            return $start->avoidMutation()->add(
+                $interval->times(
+                    $recurrences - ($startExcluded ? 0 : 1),
+                ),
+            );
+        }
+
+        return null;
+    }
