 func (t *AttachResourceConfigTransformer) Transform(g *Graph) error {
@@ -91,3 +95,42 @@ func (t *AttachResourceConfigTransformer) Transform(g *Graph) error {
 
 	return nil
 }
+
+func (t *AttachResourceConfigTransformer) hasConfigConditions(addr addrs.AbsResourceInstance) bool {
+	root := t.base
+	if root == nil {
+		root = t.Config
+	}
+	if root == nil {
+		return false
+	}
+
+	if root.Root != nil {
+		root = root.Root
+	}
+	for root.Parent != nil {
+		root = root.Parent
+	}
+
+	cfg := root
+	for _, step := range addr.Module {
+		if cfg == nil {
+			return false
+		}
+		child := cfg.Children[step.Name]
+		if child == nil {
+			return false
+		}
+		cfg = child
+	}
+	if cfg == nil || cfg.Module == nil {
+		return false
+	}
+
+	res := cfg.Module.ResourceByAddr(addr.ConfigResource().Resource)
+	if res == nil {
+		return false
+	}
+
+	return len(res.Preconditions) > 0 || len(res.Postconditions) > 0
+}
