+/// Tracks progress through a PEP 695 type parameter list on a class, function,
+/// or type alias definition.
+#[derive(Debug, Clone, Copy)]
+pub(crate) struct TypeParamsState {
+    pub(crate) before_type_params: bool,
+    pub(crate) in_type_params: bool,
+    pub(crate) type_params_ended: bool,
+    pub(crate) inner_square_brackets: u32,
+}
+
+impl Default for TypeParamsState {
+    fn default() -> Self {
+        Self {
+            before_type_params: true,
+            in_type_params: false,
+            type_params_ended: false,
+            inner_square_brackets: 0,
+        }
+    }
+}
