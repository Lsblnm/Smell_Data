+                if type_params.type_params_ended {
+                    // Nested brackets after the type parameter list do not reopen it.
+                } else if type_params.before_type_params {
+                    type_params.before_type_params = false;
+                    type_params.in_type_params = true;
+                    type_params.type_params_ended = false;
+                    type_params.inner_square_brackets = 0;
+                } else if type_params.in_type_params {
+                    type_params.inner_square_brackets += 1;
+                }
