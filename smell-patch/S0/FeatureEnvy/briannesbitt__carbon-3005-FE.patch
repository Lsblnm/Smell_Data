+    /**
+     * Load this language on a translator, including fallbacks and aliases.
+     */
+    public function applyToTranslator(AbstractTranslator $translator): void
+    {
+        $id = $this->id;
+        $code = $this->code;
+        $compareChunkLists = \Closure::bind(
+            static fn ($referenceChunks, $chunks) => self::compareChunkLists($referenceChunks, $chunks),
+            null,
+            AbstractTranslator::class,
+        );
+
+        $apply = \Closure::bind(
+            function (string $id, string $code) use ($compareChunkLists): void {
+                $locale = preg_replace_callback('/[-_]([a-z]{2,}|\d{2,})/', function ($matches) {
+                    // _2-letters or YUE is a region, _3+-letters is a variant
+                    $upper = strtoupper($matches[1]);
+
+                    if ($upper === 'YUE' || $upper === 'ISO' || \strlen($upper) <= AbstractTranslator::REGION_CODE_LENGTH) {
+                        return "_$upper";
+                    }
+
+                    return '_'.ucfirst($matches[1]);
+                }, strtolower($id));
+
+                $previousLocale = $this->getLocale();
+
+                if ($previousLocale === $locale && isset($this->messages[$locale])) {
+                    return;
+                }
+
+                unset(static::$singletons[$previousLocale]);
+
+                if ($locale === 'auto') {
+                    $completeLocale = setlocale(LC_TIME, '0');
+                    $locale = preg_replace('/^([^_.-]+).*$/', '$1', $completeLocale);
+                    $locales = $this->getAvailableLocales($locale);
+
+                    $completeLocaleChunks = preg_split('/[_.-]+/', $completeLocale);
+
+                    $getScore = static fn ($language) => $compareChunkLists(
+                        $completeLocaleChunks,
+                        preg_split('/[_.-]+/', $language),
+                    );
+
+                    usort($locales, static fn ($first, $second) => $getScore($second) <=> $getScore($first));
+
+                    $locale = $locales[0];
+                }
+
+                if (isset($this->aliases[$locale])) {
+                    $locale = $this->aliases[$locale];
+                }
+
+                // If subtag (ex: en_CA) first load the macro (ex: en) to have a fallback
+                if (str_contains($locale, '_')) {
+                    $macroLocale = str_starts_with($locale, $code.'_')
+                        ? $code
+                        : preg_replace('/^([^_]+).*$/', '$1', $locale);
+
+                    if ($this->loadMessagesFromFile($macroLocale)) {
+                        $this->setParentLocale($macroLocale);
+                    }
+                }
+
+                if (!$this->loadMessagesFromFile($locale) && !$this->initializing) {
+                    return;
+                }
+
+                $this->setParentLocale($locale);
+            },
+            $translator,
+            AbstractTranslator::class,
+        );
+
+        $apply($id, $code);
+    }
+
