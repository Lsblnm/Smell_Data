+      def on_request(path_info, params)
+        begin
+          path = path_info[1..-1]  # remove /
+          tag = path.split('/').join('.')
+
+          mes = Fluent::MultiEventStream.new
+          @input.parse_params(params) do |record_time, record|
+            if record.nil?
+              @log.debug { "incoming event is invalid: path=#{path_info} params=#{params.to_json}" }
+              next
+            end
+
+            @input.add_params_to_record(record, params)
+
+            if @add_query_params
+              params.each_pair { |k, v|
+                if k.start_with?("QUERY_".freeze)
+                  record[k] = v
+                end
+              }
+            end
+
+            time = if param_time = params['time']
+                     param_time = param_time.to_f
+                     param_time.zero? ? Fluent::EventTime.now : @input.float_time_parser.parse(param_time)
+                   else
+                     record_time.nil? ? @input.convert_time_field(record) : record_time
+                   end
+
+            mes.time_array << time
+            mes.record_array << record
+          end
+        rescue => e
+          if @input.dump_error_log
+            @log.error "failed to process request", error: e
+          end
+          return [RES_400_STATUS, RES_TEXT_HEADER, "400 Bad Request\n#{e}\n"]
+        end
+
