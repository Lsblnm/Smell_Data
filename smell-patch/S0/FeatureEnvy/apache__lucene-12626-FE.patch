+  /**
+   * Replaces all segments with those from an explicit commit, while keeping generation, version and
+   * counter so future commits remain write once.
+   */
+  void replace(IndexCommit commit, Directory directory, LiveIndexWriterConfig config)
+      throws IOException {
+    final Directory commitDirectory = commit.getDirectory();
+    final String segmentsFileName = commit.getSegmentsFileName();
+    final long commitGeneration = commit.getGeneration();
+    final int commitSegmentCount = commit.getSegmentCount();
+    final Collection<String> commitFiles = commit.getFileNames();
+
+    if (commitDirectory != directory) {
+      throw new IllegalArgumentException(
+          "IndexCommit's directory doesn't match my directory, expected="
+              + directory
+              + ", got="
+              + commitDirectory);
+    }
+
+    final SegmentInfos other = readCommit(directory, segmentsFileName);
+    replace(other);
+    lastGeneration = commitGeneration;
+    final int loadedSegments = this.segments.size();
+
+    final InfoStream infoStream = config.getInfoStream();
+    if (infoStream.isEnabled("IW")) {
+      infoStream.message(
+          "IW",
+          "init: loaded commit \""
+              + segmentsFileName
+              + "\" generation="
+              + commitGeneration
+              + " segmentCount="
+              + commitSegmentCount
+              + " files="
+              + commitFiles.size()
+              + " loaded="
+              + loadedSegments);
+    }
+  }
