 namespace Illuminate\Container;
 
+use Closure;
+use Illuminate\Contracts\Container\BindingResolutionException;
 use Illuminate\Contracts\Container\Container;
 use Illuminate\Contracts\Container\ContextualBindingBuilder as ContextualBindingBuilderContract;
+use ReflectionParameter;
 
 class ContextualBindingBuilder implements ContextualBindingBuilderContract
 {
@@ -93,4 +96,59 @@ public function giveConfig($key, $default = null)
     {
         $this->give(fn ($container) => $container->get('config')->get($key, $default));
     }
+
+    /**
+     * Resolve a non-class hinted primitive dependency.
+     *
+     * @param  \ReflectionParameter  $parameter
+     * @return mixed
+     *
+     * @throws \Illuminate\Contracts\Container\BindingResolutionException
+     */
+    public function resolvePrimitive(ReflectionParameter $parameter)
+    {
+        $container = $this->container;
+        $builderContext = is_array($this->concrete) ? end($this->concrete) : $this->concrete;
+
+        $state = Closure::bind(function () {
+            return [$this->buildStack, $this->abstractAliases];
+        }, $container, get_class($container))();
+
+        [$buildStack, $abstractAliases] = $state;
+
+        $stackContext = end($buildStack);
+        $bindingContext = $stackContext === false ? $builderContext : $stackContext;
+        $abstract = '$'.$parameter->getName();
+        $contextual = $container->contextual;
+
+        $concrete = $contextual[$bindingContext][$abstract] ?? null;
+
+        if (is_null($concrete) && ! empty($abstractAliases[$abstract])) {
+            foreach ($abstractAliases[$abstract] as $alias) {
+                $aliased = $contextual[$bindingContext][$alias] ?? null;
+
+                if (! is_null($aliased)) {
+                    $concrete = $aliased;
+
+                    break;
+                }
+            }
+        }
+
+        if (! is_null($concrete)) {
+            return Util::unwrapIfClosure($concrete, $container);
+        }
+
+        if ($parameter->isDefaultValueAvailable()) {
+            return $parameter->getDefaultValue();
+        }
+
+        if ($parameter->isVariadic()) {
+            return [];
+        }
+
+        $message = "Unresolvable dependency resolving [$parameter] in class {$parameter->getDeclaringClass()->getName()}";
+
+        throw new BindingResolutionException($message);
+    }
 }
