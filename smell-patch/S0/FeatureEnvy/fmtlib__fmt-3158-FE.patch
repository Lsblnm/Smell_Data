diff --git a/include/fmt/format.h b/include/fmt/format.h
index 0c3231b5..3743aae5 100644
--- a/include/fmt/format.h
+++ b/include/fmt/format.h
@@ -973,6 +973,37 @@ class FMT_API format_error : public std::runtime_error {
   ~format_error() noexcept override FMT_MSC_DEFAULT;
 };
 
+template <typename Char>
+template <typename RangeFormatter, typename ParseContext>
+FMT_CONSTEXPR auto basic_string_view<Char>::parse_range_specs(
+    RangeFormatter& rng, ParseContext& ctx) const -> decltype(ctx.begin()) {
+  auto it = data_;
+  auto last = data_ + size_;
+  if (it == last || *it == '}') {
+    rng.maybe_set_debug_format(rng.underlying_, 0);
+    return it;
+  }
+
+  if (*it == 'n') {
+    rng.opening_bracket_ = {};
+    rng.closing_bracket_ = {};
+    ++it;
+  }
+
+  if (*it == '}') {
+    rng.maybe_set_debug_format(rng.underlying_, 0);
+    return it;
+  }
+
+  if (*it != ':')
+    FMT_THROW(format_error("no other top-level range formatters supported"));
+
+  rng.custom_specs_ = true;
+  ++it;
+  ctx.advance_to(it);
+  return rng.underlying_.parse(ctx);
+}
