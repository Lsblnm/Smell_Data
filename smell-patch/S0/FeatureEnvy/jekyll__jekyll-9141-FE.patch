       FileUtils.rm_rf(metadata_file) unless @site.incremental?
     end
 
+    # Yield every page, writeable static file, and writeable collection item.
+    # When an inventory set is being assembled for cleanup, destination paths
+    # are recorded alongside enumeration.
+    def each_site_file
+      inventory = @new_files
+      site = @site
+
+      site.pages.each do |item|
+        inventory << item.destination(site.dest) if inventory
+        yield item
+      end
+
+      site.static_files.each do |static_file|
+        next unless static_file.write?
+
+        inventory << static_file.destination(site.dest) if inventory
+        yield static_file
+      end
+
+      documents = Set.new
+      site.collections.each_value do |collection|
+        next unless collection.exists? || !collection.docs.empty? || !collection.files.empty?
+
+        if collection.metadata.fetch("output", false)
+          documents.merge(collection.docs)
+          documents.merge(collection.files)
+        end
+      end
+      documents.each do |item|
+        next unless item.write?
+
+        inventory << item.destination(site.dest) if inventory
+        yield item
+      end
+    end
+
     private
 
     # Private: The list of files and directories to be deleted during cleanup process
