+// cookieHeaderTransformer rewrites cookie header values for log field filters.
+type cookieHeaderTransformer struct {
+	origin      http.Header
+	transformed http.Header
+}
+
+func (t *cookieHeaderTransformer) rewriteCookies(actions []cookieFilterAction, in zapcore.Field) zapcore.Field {
+	if in.Interface == nil && in.String == "" {
+		return in
+	}
+
+	cookieValues := caddyhttp.LoggableStringArray{in.String}
+	t.origin = http.Header{"Cookie": []string(cookieValues)}
+	t.transformed = make(http.Header)
+
+	names, values := cookieNamesAndValues(t.origin)
+OUTER:
+	for i, name := range names {
+		val := values[i]
+		for _, a := range actions {
+			if name != a.Name {
+				continue
+			}
+
+			switch a.Type {
+			case replaceAction:
+				t.appendCookie(a.Name, a.Value)
+				continue OUTER
+
+			case hashAction:
+				t.appendCookie(a.Name, hash(val))
+				continue OUTER
+
+			case deleteAction:
+				continue OUTER
+			}
+		}
+
+		t.appendCookie(name, val)
+	}
+
+	in.String = t.transformed.Get("Cookie")
+	return in
+}
+
+func (t *cookieHeaderTransformer) appendCookie(name, value string) {
+	req := http.Request{Header: t.transformed}
+	req.AddCookie(&http.Cookie{Name: name, Value: value})
+	t.transformed = req.Header
+}
+
+func cookieNamesAndValues(header http.Header) (names, values []string) {
+	cookies := (&http.Request{Header: header}).Cookies()
+	names = make([]string, 0, len(cookies))
+	values = make([]string, 0, len(cookies))
+	for _, cookie := range cookies {
+		names = append(names, cookie.Name)
+		values = append(values, cookie.Value)
+	}
+	return names, values
+}
+
 // Interface guards
 var (
 	_ zapcore.Encoder         = (*FilterEncoder)(nil)
