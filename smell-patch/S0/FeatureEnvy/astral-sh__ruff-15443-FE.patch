+impl Checker<'_> {
+    /// S102
+    pub(crate) fn exec_used(&mut self, func: &Expr) {
+        let is_exec = match exec_name_head(func) {
+            Some(head) => {
+                let semantic = self.semantic();
+                let binding_id = semantic.resolve_name(head).or_else(|| {
+                    semantic.lookup_symbol_in_scope(
+                        head.id.as_str(),
+                        semantic.scope_id,
+                        semantic.in_forward_reference(),
+                    )
+                });
+                match binding_id {
+                    Some(binding_id) => {
+                        let binding = &semantic.bindings[binding_id];
+                        let could_be_exec = matches!(
+                            &binding.kind,
+                            BindingKind::Builtin
+                                | BindingKind::Import(_)
+                                | BindingKind::FromImport(_)
+                                | BindingKind::SubmoduleImport(_)
+                                | BindingKind::ClassDefinition(_)
+                                | BindingKind::FunctionDefinition(_)
+                        );
+                        could_be_exec
+                            && semantic
+                                .resolve_qualified_name(func)
+                                .is_some_and(|qualified_name| {
+                                    matches!(qualified_name.segments(), ["" | "builtin", "exec"])
+                                })
+                    }
+                    None => false,
+                }
+            }
+            None => false,
+        };
+
+        if is_exec {
+            self.diagnostics
+                .push(Diagnostic::new(ExecBuiltin, func.range()));
+        }
+    }
+}
+
+fn exec_name_head(func: &Expr) -> Option<&ruff_python_ast::ExprName> {
+    match func {
+        Expr::Attribute(attribute) => exec_name_head(&attribute.value),
+        Expr::Name(name) => Some(name),
+        _ => None,
     }
 }
