+impl<'a, W> WriteAllBuf<'a, W, CopyBuffer>
+where
+    W: AsyncWrite + Unpin + ?Sized,
+{
+    pub(super) fn for_copy_buffer(writer: &'a mut W, buf: &'a mut CopyBuffer) -> Self {
+        Self {
+            writer,
+            buf,
+            _pin: PhantomPinned,
+        }
+    }
+
+    pub(super) fn poll_copy<R>(
+        &mut self,
+        cx: &mut Context<'_>,
+        mut reader: Pin<&mut R>,
+    ) -> Poll<io::Result<u64>>
+    where
+        R: AsyncRead + ?Sized,
+    {
+        ready!(crate::trace::trace_leaf(cx));
+        #[cfg(any(
+            feature = "fs",
+            feature = "io-std",
+            feature = "net",
+            feature = "process",
+            feature = "rt",
+            feature = "signal",
+            feature = "sync",
+            feature = "time",
+        ))]
+        // Keep track of task budget
+        let coop = ready!(crate::runtime::coop::poll_proceed(cx));
+
+        let writer = &mut *self.writer;
+        let buffer = &mut *self.buf;
+
+        loop {
+            // If there is some space left in our buffer, then we try to read some
+            // data to continue, thus maximizing the chances of a large write.
+            if buffer.cap < buffer.buf.len() && !buffer.read_done {
+                let mut read_buf = ReadBuf::new(&mut buffer.buf);
+                read_buf.set_filled(buffer.cap);
+                match reader.as_mut().poll_read(cx, &mut read_buf) {
+                    Poll::Ready(Ok(())) => {
+                        let filled_len = read_buf.filled().len();
+                        buffer.read_done = buffer.cap == filled_len;
+                        buffer.cap = filled_len;
+                        #[cfg(any(
+                            feature = "fs",
+                            feature = "io-std",
+                            feature = "net",
+                            feature = "process",
+                            feature = "rt",
+                            feature = "signal",
+                            feature = "sync",
+                            feature = "time",
+                        ))]
+                        coop.made_progress();
+                    }
+                    Poll::Ready(Err(err)) => {
+                        #[cfg(any(
+                            feature = "fs",
+                            feature = "io-std",
+                            feature = "net",
+                            feature = "process",
+                            feature = "rt",
+                            feature = "signal",
+                            feature = "sync",
+                            feature = "time",
+                        ))]
+                        coop.made_progress();
+                        return Poll::Ready(Err(err));
+                    }
+                    Poll::Pending => {
+                        // Ignore pending reads when our buffer is not empty, because
+                        // we can try to write data immediately.
+                        if buffer.pos == buffer.cap {
+                            // Try flushing when the reader has no progress to avoid deadlock
+                            // when the reader depends on buffered writer.
+                            if buffer.need_flush {
+                                ready!(Pin::new(&mut *writer).poll_flush(cx))?;
+                                #[cfg(any(
+                                    feature = "fs",
+                                    feature = "io-std",
+                                    feature = "net",
+                                    feature = "process",
+                                    feature = "rt",
+                                    feature = "signal",
+                                    feature = "sync",
+                                    feature = "time",
+                                ))]
+                                coop.made_progress();
+                                buffer.need_flush = false;
+                            }
+
+                            return Poll::Pending;
+                        }
+                    }
+                }
+            }
+
+            // If our buffer has some data, let's write it out!
+            while buffer.pos < buffer.cap {
+                let i = match Pin::new(&mut *writer)
+                    .poll_write(cx, &buffer.buf[buffer.pos..buffer.cap])
+                {
+                    Poll::Pending => {
+                        // Top up the buffer towards full if we can read a bit more
+                        // data - this should improve the chances of a large write
+                        if !buffer.read_done && buffer.cap < buffer.buf.len() {
+                            let mut read_buf = ReadBuf::new(&mut buffer.buf);
+                            read_buf.set_filled(buffer.cap);
+                            ready!(reader.as_mut().poll_read(cx, &mut read_buf))?;
+                            let filled_len = read_buf.filled().len();
+                            buffer.read_done = buffer.cap == filled_len;
+                            buffer.cap = filled_len;
+                        }
+                        return Poll::Pending;
+                    }
+                    Poll::Ready(Ok(n)) => n,
+                    Poll::Ready(Err(err)) => return Poll::Ready(Err(err)),
+                };
+                #[cfg(any(
+                    feature = "fs",
+                    feature = "io-std",
+                    feature = "net",
+                    feature = "process",
+                    feature = "rt",
+                    feature = "signal",
+                    feature = "sync",
+                    feature = "time",
+                ))]
+                coop.made_progress();
+                if i == 0 {
+                    return Poll::Ready(Err(io::Error::new(
+                        io::ErrorKind::WriteZero,
+                        "write zero byte into writer",
+                    )));
+                } else {
+                    buffer.pos += i;
+                    buffer.amt += i as u64;
+                    buffer.need_flush = true;
+                }
+            }
+
+            // If pos larger than cap, this loop will never stop.
+            // In particular, user's wrong poll_write implementation returning
+            // incorrect written length may lead to thread blocking.
+            debug_assert!(
+                buffer.pos <= buffer.cap,
+                "writer returned length larger than input slice"
+            );
+
+            // All data has been written, the buffer can be considered empty again
+            buffer.pos = 0;
+            buffer.cap = 0;
+
+            // If we've written all the data and we've seen EOF, flush out the
+            // data and finish the transfer.
+            if buffer.read_done {
+                ready!(Pin::new(&mut *writer).poll_flush(cx))?;
+                #[cfg(any(
+                    feature = "fs",
+                    feature = "io-std",
+                    feature = "net",
+                    feature = "process",
+                    feature = "rt",
+                    feature = "signal",
+                    feature = "sync",
+                    feature = "time",
+                ))]
+                coop.made_progress();
+                return Poll::Ready(Ok(buffer.amt));
+            }
+        }
+    }
+}
