+/**
+ * Regex pieces that identify an `mdx-code-block` fence in Markdown/MDX.
+ */
+export class MdxFencePattern {
+  readonly fence: string;
+  readonly escapedFence: string;
+  readonly infoLabel: string;
+  readonly spaceClass: string;
+  readonly flags: string;
+
+  constructor(fence: string) {
+    this.fence = fence;
+    this.escapedFence = escapeRegexp(fence);
+    this.infoLabel = 'mdx-code-block';
+    this.spaceClass = '\\x20';
+    this.flags = 'gs';
+  }
+}
