+     * @param  \Illuminate\Cache\ArrayStore  $store
+     * @param  string|array  $key
+     * @return mixed
+     */
+    public function getFromArrayStore($store, $key)
+    {
+        if (! isset($store->storage[$key])) {
+            return;
+        }
+
+        $item = $store->storage[$key];
+
+        $expiresAt = $item['expiresAt'] ?? 0;
+
+        $defaultClassName = static::DEFAULT_CLASS_NAME;
+
+        if (static::$callable) {
+            $now = call_user_func(static::$callable, $defaultClassName::now());
+        } elseif (static::$factory) {
+            $now = static::$factory->now();
+        } else {
+            $dateClass = static::$dateClass ?: $defaultClassName;
+
+            if (method_exists($dateClass, 'now') ||
+                method_exists($dateClass, 'hasMacro') && $dateClass::hasMacro('now')) {
+                $now = $dateClass::now();
+            } else {
+                $now = $defaultClassName::now();
+
+                if (method_exists($dateClass, 'instance')) {
+                    $now = $dateClass::instance($now);
+                } else {
+                    $now = new $dateClass($now->format('Y-m-d H:i:s.u'), $now->getTimezone());
+                }
+            }
+        }
+
+        $currentTime = Carbon::create(
+            $now->year,
+            $now->month,
+            $now->day,
+            $now->hour,
+            $now->minute,
+            $now->second
+        )->getTimestamp();
+
+        if ($expiresAt !== 0 && $currentTime > $expiresAt) {
+            $store->forget($key);
+
+            return;
+        }
+
+        return $store->restoreValue($item['value']);
+    }
