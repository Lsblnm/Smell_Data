+  private Request rebuildRequestForLeader(Request source) throws IOException
+  {
+    final URL sourceUrl = source.getUrl();
+    final String previousLeader = currentKnownLeader.get();
+    final String leaderBase = getCurrentKnownLeader(false);
+    final String path = sourceUrl.getPath();
+    final String query = sourceUrl.getQuery();
+    final URL newUrl;
+    if (query == null) {
+      newUrl = new URL(leaderBase + path);
+    } else {
+      newUrl = new URL(leaderBase + path + "?" + query);
+    }
+    final Request rebuilt = new Request(source.getMethod(), newUrl);
+    rebuilt.addHeaderValues(source.getHeaders());
+    if (source.hasContent()) {
+      rebuilt.setContent(source.getContent());
+    }
+    log.debug(
+        "Rebuilt leader request from [%s] to [%s] path[%s] query[%s].",
+        previousLeader,
+        leaderBase,
+        path,
+        query
+    );
+    return rebuilt;
+  }
