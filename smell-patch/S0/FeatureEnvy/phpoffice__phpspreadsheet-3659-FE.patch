+    /**
+     * Keep structured reference formulae aligned with a table's current identity and layout.
+     *
+     * @return array
+     */
+    public function updateStructuredReferences(Table $table, string $name): array
+    {
+        $this->table = $table;
+
+        $currentName = $this->table->getName();
+        $worksheet = $this->table->getWorksheet();
+        $range = $this->table->getRange();
+        $showHeaderRow = $this->table->getShowHeaderRow();
+        $showTotalsRow = $this->table->getShowTotalsRow();
+        $tableColumns = $this->table->getColumns();
+
+        if ($range === '') {
+            $tableRange = Coordinate::getRangeBoundaries('A1:A1');
+        } else {
+            $tableRange = Coordinate::getRangeBoundaries($range);
+            $tableRange[0][1] = (int) $tableRange[0][1];
+            $tableRange[1][1] = (int) $tableRange[1][1];
+            $firstColumnIndex = Coordinate::columnIndexFromString($tableRange[0][0]);
+            $lastColumnIndex = Coordinate::columnIndexFromString($tableRange[1][0]);
+            $firstDataRow = $showHeaderRow ? $tableRange[0][1] + 1 : $tableRange[0][1];
+            $lastDataRow = $showTotalsRow ? $tableRange[1][1] - 1 : $tableRange[1][1];
+
+            foreach ($tableColumns as $column) {
+                $columnIndex = $column->getColumnIndex();
+                $numericIndex = Coordinate::columnIndexFromString($columnIndex);
+                if ($numericIndex < $firstColumnIndex || $numericIndex > $lastColumnIndex || $lastDataRow < $firstDataRow) {
+                    continue;
+                }
+                $firstColumnIndex = min($firstColumnIndex, $numericIndex);
+                $lastColumnIndex = max($lastColumnIndex, $numericIndex);
+            }
+            $tableRange[0][0] = Coordinate::stringFromColumnIndex($firstColumnIndex);
+            $tableRange[1][0] = Coordinate::stringFromColumnIndex($lastColumnIndex);
+        }
+
+        $operandValue = $this->value;
+        $operandMentionsTable = ($operandValue === ''
+            || stripos($operandValue, (string) $currentName) !== false
+            || stripos($operandValue, $name) !== false);
+
+        if (
+            $operandMentionsTable
+            && $worksheet !== null
+            && $currentName !== null
+            && $currentName !== ''
+            && StringHelper::strToLower($currentName) !== StringHelper::strToLower($name)
+        ) {
+            $this->rewriteStructuredReferenceNames($worksheet, $currentName, $name);
+        }
+
+        return $tableRange;
+    }
+
+    private function rewriteStructuredReferenceNames(Worksheet $worksheet, string $currentName, string $newName): void
+    {
+        $spreadsheet = $worksheet->getParentOrThrow();
+        foreach ($spreadsheet->getWorksheetIterator() as $sheet) {
+            $this->updateStructuredReferencesInCells($sheet, $currentName, $newName);
+        }
+        $this->updateStructuredReferencesInNamedFormulae($spreadsheet, $currentName, $newName);
+    }
+
+    private function updateStructuredReferencesInCells(Worksheet $worksheet, string $currentName, string $newName): void
+    {
+        $pattern = '/' . preg_quote($currentName, '/') . '\[/mui';
+
+        foreach ($worksheet->getCoordinates(false) as $coordinate) {
+            $cell = $worksheet->getCell($coordinate);
+            if ($cell->getDataType() === DataType::TYPE_FORMULA) {
+                $formula = $cell->getValue();
+                if (preg_match($pattern, $formula) === 1) {
+                    $formula = preg_replace($pattern, "{$newName}[", $formula);
+                    $cell->setValueExplicit($formula, DataType::TYPE_FORMULA);
+                }
+            }
+        }
+    }
+
+    private function updateStructuredReferencesInNamedFormulae(Spreadsheet $spreadsheet, string $currentName, string $newName): void
+    {
+        $pattern = '/' . preg_quote($currentName, '/') . '\[/mui';
+
+        foreach ($spreadsheet->getNamedFormulae() as $namedFormula) {
+            $formula = $namedFormula->getValue();
+            if (preg_match($pattern, $formula) === 1) {
+                $formula = preg_replace($pattern, "{$newName}[", $formula);
+                $namedFormula->setValue($formula); // @phpstan-ignore-line
+            }
+        }
+    }
+
