diff --git a/lib/rubocop/cop/correctors/empty_line_corrector.rb b/lib/rubocop/cop/correctors/empty_line_corrector.rb
index b230be170..90ddfa9af 100644
--- a/lib/rubocop/cop/correctors/empty_line_corrector.rb
+++ b/lib/rubocop/cop/correctors/empty_line_corrector.rb
@@ -20,6 +20,36 @@ module RuboCop
           corrector.insert_before(node, "\n")
         end
       end
+
+      def initialize(style, processed_source)
+        @style = style
+        @processed_source = processed_source
+      end
+
+      def check_method_body(cop, node)
+        return unless node.type == :def || node.type == :defs
+
+        body = node.body || node.children[-1]
+        return if body.nil? && @style != :no_empty_lines
+        return if node.first_line == node.last_line
+
+        first_line = node.first_line
+        last_line = node.last_line
+
+        [[first_line, 'beginning'], [last_line - 2, 'end']].each do |line_no, desc|
+          next unless @processed_source.lines[line_no].empty?
+
+          range = cop.send(:source_range, @processed_source.buffer, line_no + 1, 0)
+          message = format(
+            Layout::EmptyLinesAroundBody::MSG_EXTRA,
+            kind: cop.class::KIND,
+            location: desc
+          )
+          cop.add_offense(range, message: message) do |corrector|
+            self.class.correct(corrector, [@style, range])
+          end
+        end
+      end
     end
   end
 end
