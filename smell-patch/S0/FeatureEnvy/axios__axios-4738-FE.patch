+AxiosError.prepareHttpRequest = function prepareHttpRequest(config) {
+  var url = config.url;
+  var baseURL = config.baseURL;
+  var timeout = config.timeout;
+  var transitional = config.transitional || transitionalDefaults;
+  var maxBodyLength = config.maxBodyLength;
+  var insecureHTTPParser = config.insecureHTTPParser;
+  var fullPath = buildFullPath(baseURL, url);
+  var prepared = {
+    fullPath: fullPath,
+    maxBodyLength: maxBodyLength > -1 ? maxBodyLength : Infinity
+  };
+
+  if (insecureHTTPParser) {
+    prepared.insecureHTTPParser = insecureHTTPParser;
+  }
+
+  if (timeout) {
+    var parsedTimeout = parseInt(timeout, 10);
+    prepared.hasTimeout = true;
+    prepared.timeout = parsedTimeout;
+    prepared.timeoutInvalid = isNaN(parsedTimeout);
+    if (!prepared.timeoutInvalid) {
+      prepared.timeoutCode = transitional.clarifyTimeoutError ? this.ETIMEDOUT : this.ECONNABORTED;
+      prepared.timeoutMessage = 'timeout of ' + parsedTimeout + 'ms exceeded';
+    }
+  }
+
+  return prepared;
+};
+
 module.exports = AxiosError;
