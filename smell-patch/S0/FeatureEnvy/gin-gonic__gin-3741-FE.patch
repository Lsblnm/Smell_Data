+func (conf *LoggerConfig) StatusCodeColor(p *LogFormatterParams, isTerm bool, c *Context) string {
+	path := p.Path
+	if idx := strings.IndexByte(path, '?'); idx >= 0 {
+		path = path[:idx]
+	}
+	for _, skip := range conf.SkipPaths {
+		if skip == path {
+			return ""
+		}
+	}
 
