+    public function showValue(Calculation $engine, mixed $value): mixed
+    {
+        if ($engine->getDebugLog()->getWriteDebugLog()) {
+            $testArray = Functions::flattenArray($value);
+            if (count($testArray) == 1) {
+                $value = array_pop($testArray);
+            }
+
