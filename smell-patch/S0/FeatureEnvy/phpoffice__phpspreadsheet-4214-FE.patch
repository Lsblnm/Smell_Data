+        $cellStack = $logger->getCellStack();
+        $cacheEnabled = $engine->getCalculationCacheEnabled();
+        $engineError = $engine->formulaError;
+        $locale = $engine->getLocale();
+        $localeTrue = ($locale === 'en_us') ? 'TRUE' : Calculation::getTRUE();
+        $localeFalse = ($locale === 'en_us') ? 'FALSE' : Calculation::getFALSE();
+        $operand = $this->number;
+        $precision = $this->digits;
+
+        if (!$writeDebugLog) {
+            return null;
+        }
+
+        $testArray = Functions::flattenArray($value);
+        if (count($testArray) == 1) {
+            $value = array_pop($testArray);
+        }
+
+        if ($value === null) {
+            return 'a NULL value';
+        }
+        if (is_string($value) && $value !== '' && $value[0] === '#') {
+            $errorValue = ($engineError === $value) ? $engineError : $value;
+
+            return 'a ' . $errorValue . ' error';
+        }
+        if (is_float($value)) {
+            $typeString = 'a floating point number';
+        } elseif (is_int($value)) {
+            $typeString = 'an integer number';
+        } elseif (is_bool($value)) {
+            $typeString = 'a boolean';
+        } elseif (is_array($value)) {
+            $typeString = 'a matrix';
+        } else {
+            if ($value == '') {
+                return 'an empty string';
+            }
+            $typeString = 'a string';
+        }
+
+        if (is_bool($value)) {
+            $rendered = $value ? $localeTrue : $localeFalse;
