diff --git a/lib/rubocop/cop/mixin/parentheses.rb b/lib/rubocop/cop/mixin/parentheses.rb
index adea8f614..992ece72c 100644
--- a/lib/rubocop/cop/mixin/parentheses.rb
+++ b/lib/rubocop/cop/mixin/parentheses.rb
@@ -4,6 +4,22 @@ module RuboCop
   module Cop
     # Common functionality for handling parentheses.
     module Parentheses
+      # Snapshot of a parenthesized method call and the surrounding AST/source data
+      # needed to decide whether the parentheses are redundant.
+      class ParenthesizedCall
+        attr_reader :begin_node, :send_node, :parent, :location, :source_range, :children
+
+        def initialize(begin_node, send_node, processed_source)
+          span = RuboCop::Ext::SourceSpan.new(begin_node.source_range, processed_source)
+          @begin_node = begin_node
+          @send_node = send_node
+          @parent = begin_node.parent
+          @location = begin_node.loc
+          @source_range = span.range
+          @children = begin_node.children
+        end
+      end
+
       private
 
       def parens_required?(node)
