diff --git a/src/script.c b/src/script.c
index 57fa7eeba..6cecac148 100644
--- a/src/script.c
+++ b/src/script.c
@@ -30,6 +30,7 @@
 #include "server.h"
 #include "script.h"
 #include "cluster.h"
+#include "functions.h"
 
 scriptFlag scripts_flags_def[] = {
     {.flag = SCRIPT_FLAG_NO_WRITES, .str = "no-writes"},
@@ -272,6 +273,42 @@ void scriptResetRun(scriptRunCtx *run_ctx) {
     curr_run_ctx = NULL;
 }
 
+void fcallCommandGeneric(client *c, int ro) {
+    functionInfo *fi = functionsFind(c->argv[1]);
+    if (!fi) {
+        addReplyError(c, "Function not found");
+        return;
+    }
+
+    long long numkeys;
+    /* Get the number of arguments that are keys */
+    if (getLongLongFromObject(c->argv[2], &numkeys) != C_OK) {
+        addReplyError(c, "Bad number of keys provided");
+        return;
+    }
+    if (numkeys > (c->argc - 3)) {
+        addReplyError(c, "Number of keys can't be greater than number of args");
+        return;
+    } else if (numkeys < 0) {
+        addReplyError(c, "Number of keys can't be negative");
+        return;
+    }
+
+    scriptRunCtx run_ctx;
+    if (functionPrepareRun(fi->li, &run_ctx, c, fi->name, fi->f_flags, ro) != C_OK)
+        return;
+
+    run_ctx.funcname = fi->name;
+    run_ctx.c->resp = 2;
+    if (ro || (fi->f_flags & SCRIPT_FLAG_NO_WRITES) || (run_ctx.flags & SCRIPT_READ_ONLY)) {
+        run_ctx.flags |= SCRIPT_READ_ONLY;
+    }
+
+    functionInvoke(fi->li, fi->function, &run_ctx, c->argv + 3, numkeys,
+                   c->argv + 3 + numkeys, c->argc - 3 - numkeys);
+    scriptResetRun(&run_ctx);
+}
+
 /* return true if a script is currently running */
 int scriptIsRunning() {
     return curr_run_ctx != NULL;
