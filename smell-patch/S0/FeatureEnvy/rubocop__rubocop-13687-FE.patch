diff --git a/lib/rubocop/cop/lint/safe_navigation_chain.rb b/lib/rubocop/cop/lint/safe_navigation_chain.rb
index e9ad7ad2c..a953438c6 100644
--- a/lib/rubocop/cop/lint/safe_navigation_chain.rb
+++ b/lib/rubocop/cop/lint/safe_navigation_chain.rb
@@ -97,11 +97,33 @@ module RuboCop
         end
 
         def require_parentheses?(send_node)
-          return false unless send_node.comparison_method?
-          return false unless (node = send_node.parent)
+          parent = send_node.parent
+          method_name = send_node.respond_to?(:method_name) ? send_node.method_name : nil
+          receiver = send_node.respond_to?(:receiver) ? send_node.receiver : nil
+          arguments = send_node.respond_to?(:arguments) ? send_node.arguments : nil
+          source_range = send_node.source_range
+
+          allowed_methods = Array(config.for_cop(self.class)['AllowedMethods'])
+          buffer_source = processed_source.raw_source
+          begin_pos = source_range.begin_pos
+          end_pos = source_range.end_pos
+          adjacent_identifier =
+            (begin_pos.positive? && /[a-z]/.match?(buffer_source[begin_pos - 1])) ||
+            /[a-z]/.match?(buffer_source[end_pos])
+
+          if method_name && !allowed_methods.include?(method_name.to_s) &&
+             %i[== === != <= >= > <].include?(method_name) &&
+             receiver && arguments && !arguments.empty? && parent
+            snippet = buffer_source[begin_pos...end_pos]
+            if snippet&.include?(method_name.to_s)
+              logical = parent.respond_to?(:logical_operator?) && parent.logical_operator?
+              comparison_parent = parent.respond_to?(:comparison_method?) &&
+                                  parent.comparison_method?
+              return true if logical || comparison_parent
+            end
+          end
 
-          (node.respond_to?(:logical_operator?) && node.logical_operator?) ||
-            (node.respond_to?(:comparison_method?) && node.comparison_method?)
+          adjacent_identifier
         end
       end
     end
