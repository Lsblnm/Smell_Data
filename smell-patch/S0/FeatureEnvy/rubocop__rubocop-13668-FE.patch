diff --git a/lib/rubocop/cop/correctors/condition_corrector.rb b/lib/rubocop/cop/correctors/condition_corrector.rb
index 10f9494be..8720bdfac 100644
--- a/lib/rubocop/cop/correctors/condition_corrector.rb
+++ b/lib/rubocop/cop/correctors/condition_corrector.rb
@@ -4,6 +4,10 @@ module RuboCop
   module Cop
     # This class does condition autocorrection
     class ConditionCorrector
+      include RangeHelp
+
+      attr_reader :processed_source, :buffer
+
       class << self
         def correct_negative_condition(corrector, node)
           condition = negated_condition(node)
@@ -20,6 +24,31 @@ module RuboCop
           condition
         end
       end
+
+      def initialize(processed_source)
+        @processed_source = processed_source
+        @buffer = processed_source.buffer
+      end
+
+      def replace_condition(condition)
+        raise ArgumentError, 'processed source is required' unless processed_source && buffer
+
+        range = condition.source_range
+        source = range_between(range.begin_pos, range.end_pos).source
+        wrapping = condition.operator_keyword? ||
+                   (condition.call_type? && condition.arguments.any? && !condition.parenthesized?)
+        return source unless wrapping
+
+        if condition.call_type?
+          selector = condition.selector
+          argument_range = condition.first_argument.source_range
+          method_call = range_between(range.begin_pos, selector.end_pos).source
+          arguments = range_between(argument_range.begin_pos, range.end_pos).source
+          "#{method_call}(#{arguments})"
+        else
+          "(#{source})"
+        end
+      end
     end
   end
 end
