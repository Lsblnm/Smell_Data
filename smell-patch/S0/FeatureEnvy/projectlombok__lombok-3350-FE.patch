+	public void applyAnnotationToMethodDecl(JCMethodDecl method, NullAnnotationLibrary library, boolean nullable) {
+		String annotationType = nullable ? library.getNullableAnnotation() : library.getNonNullAnnotation();
+		if (annotationType == null) return;
+		boolean typeUse = library.isTypeUse();
+
+		treeMaker.at(-1);
+		String[] parts = annotationType.split("\\.");
+		JCExpression typeRef = treeMaker.Ident(elements.getName(parts[0]));
+		for (int i = 1; i < parts.length; i++) {
+			typeRef = treeMaker.Select(typeRef, elements.getName(parts[i]));
+		}
+		JCAnnotation annotation = treeMaker.Annotation(typeRef, com.sun.tools.javac.util.List.<JCExpression>nil());
+
+		if (typeUse) {
+			if (method.restype != null) annotateMethodReturnType(method, annotation);
+		} else if (method.mods != null) {
+			prependAnnotation(method.mods, annotation);
+		}
+	}
+
+	public void applyAnnotationToVarDecl(JCVariableDecl variable, NullAnnotationLibrary library, boolean nullable) {
+		String annotationType = nullable ? library.getNullableAnnotation() : library.getNonNullAnnotation();
+		if (annotationType == null) return;
+		boolean typeUse = library.isTypeUse();
+		JCAnnotation annotation = createMarkerAnnotation(annotationType);
+		if (typeUse) {
+			annotateVariableType(variable, annotation);
+		} else if (variable.mods != null) {
+			prependAnnotation(variable.mods, annotation);
+		}
+	}
+
+	private JCAnnotation createMarkerAnnotation(String annotationType) {
+		treeMaker.at(-1);
+		String[] parts = annotationType.split("\\.");
+		JCExpression typeRef = treeMaker.Ident(elements.getName(parts[0]));
+		for (int i = 1; i < parts.length; i++) {
+			typeRef = treeMaker.Select(typeRef, elements.getName(parts[i]));
+		}
+		return treeMaker.Annotation(typeRef, com.sun.tools.javac.util.List.<JCExpression>nil());
+	}
+
+	private void annotateMethodReturnType(JCMethodDecl method, JCAnnotation annotation) {
+		JCExpression resType = method.restype;
+		if (resType instanceof JCTypeApply) {
+			JCTypeApply ta = (JCTypeApply) resType;
+			if (ta.clazz instanceof JCFieldAccess) {
+				method.restype = treeMaker.TypeApply(treeMaker.AnnotatedType(com.sun.tools.javac.util.List.of(annotation), ta.clazz), ta.arguments);
+				return;
+			}
+			resType = ta.clazz;
+		}
+
+		if (resType instanceof JCFieldAccess || resType instanceof JCArrayTypeTree) {
+			method.restype = treeMaker.AnnotatedType(com.sun.tools.javac.util.List.of(annotation), resType);
+			return;
+		}
+
+		if (JCAnnotatedTypeReflect.is(resType)) {
+			com.sun.tools.javac.util.List<JCAnnotation> annotations = JCAnnotatedTypeReflect.getAnnotations(resType);
+			JCAnnotatedTypeReflect.setAnnotations(resType, annotations.prepend(annotation));
+			return;
+		}
+
+		if (resType instanceof JCPrimitiveTypeTree || resType instanceof JCIdent) {
+			prependAnnotation(method.mods, annotation);
+		}
+	}
+
+	private void annotateVariableType(JCVariableDecl variable, JCAnnotation annotation) {
+		JCExpression varType = variable.vartype;
+		JCTypeApply ta = null;
+		if (varType instanceof JCTypeApply) {
+			ta = (JCTypeApply) varType;
+			varType = ta.clazz;
+		}
+
+		if (varType instanceof JCFieldAccess || varType instanceof JCArrayTypeTree) {
+			varType = treeMaker.AnnotatedType(com.sun.tools.javac.util.List.of(annotation), varType);
+			if (ta != null) ta.clazz = varType;
+			else variable.vartype = varType;
+			return;
+		}
+
+		if (JCAnnotatedTypeReflect.is(varType)) {
+			com.sun.tools.javac.util.List<JCAnnotation> annotations = JCAnnotatedTypeReflect.getAnnotations(varType);
+			JCAnnotatedTypeReflect.setAnnotations(varType, annotations.prepend(annotation));
+			return;
+		}
+
+		if (varType instanceof JCPrimitiveTypeTree || varType instanceof JCIdent) {
+			prependAnnotation(variable.mods, annotation);
+		}
+	}
+
+	private void prependAnnotation(JCModifiers mods, JCAnnotation annotation) {
+		if (mods.annotations == null) mods.annotations = com.sun.tools.javac.util.List.of(annotation);
+		else mods.annotations = mods.annotations.prepend(annotation);
+	}
