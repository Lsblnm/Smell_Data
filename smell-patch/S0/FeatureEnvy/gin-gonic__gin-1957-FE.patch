+func (c *Context) withFormFieldAssigner(fn func() error) error {
+	prev := binding.FormFieldAssigner
+	binding.FormFieldAssigner = func(value reflect.Value, field reflect.StructField, form map[string][]string, tagValue string, isDefaultExists bool, defaultValue string) (bool, error) {
+		return c.assignFormField(value, field, form, tagValue, isDefaultExists, defaultValue)
+	}
+	defer func() { binding.FormFieldAssigner = prev }()
+	return fn()
+}
+
+func sameStringMap(a, b map[string][]string) bool {
+	if a == nil || b == nil {
+		return false
+	}
+	return reflect.ValueOf(a).Pointer() == reflect.ValueOf(b).Pointer()
+}
+
+func (c *Context) assignFormField(value reflect.Value, field reflect.StructField, form map[string][]string, tagValue string, isDefaultExists bool, defaultValue string) (bool, error) {
+	source := form
+	engine := (*Engine)(nil)
+	if c != nil {
+		engine = c.engine
+		req := c.Request
+		if req != nil {
+			if req.Method == http.MethodPost || req.Method == http.MethodPut || req.Method == http.MethodPatch {
+				if sameStringMap(source, req.PostForm) {
+					source = req.PostForm
+				} else if sameStringMap(source, req.Form) {
+					source = req.Form
+				}
+			} else if sameStringMap(source, req.Form) {
+				source = req.Form
+			} else if sameStringMap(source, req.PostForm) {
+				source = req.PostForm
+			}
+			if sameStringMap(source, map[string][]string(req.Header)) {
+				source = req.Header
+			} else if req.MultipartForm != nil && sameStringMap(source, req.MultipartForm.Value) {
+				source = req.MultipartForm.Value
+			}
+		}
+	}
+
+	vs, ok := source[tagValue]
+	if !ok && !isDefaultExists {
+		return false, nil
+	}
+
+	assignOne := func(raw string, dest reflect.Value) error {
+		switch dest.Kind() {
+		case reflect.Int:
+			return setIntField(raw, 0, dest)
+		case reflect.Int8:
+			return setIntField(raw, 8, dest)
+		case reflect.Int16:
+			return setIntField(raw, 16, dest)
+		case reflect.Int32:
+			return setIntField(raw, 32, dest)
+		case reflect.Int64:
+			switch dest.Interface().(type) {
+			case time.Duration:
+				d, err := time.ParseDuration(raw)
+				if err != nil {
+					return err
+				}
+				dest.Set(reflect.ValueOf(d))
+				return nil
+			}
+			return setIntField(raw, 64, dest)
+		case reflect.Uint:
+			return setUintField(raw, 0, dest)
+		case reflect.Uint8:
+			return setUintField(raw, 8, dest)
+		case reflect.Uint16:
+			return setUintField(raw, 16, dest)
+		case reflect.Uint32:
+			return setUintField(raw, 32, dest)
+		case reflect.Uint64:
+			return setUintField(raw, 64, dest)
+		case reflect.Bool:
+			return setBoolField(raw, dest)
+		case reflect.Float32:
+			return setFloatField(raw, 32, dest)
+		case reflect.Float64:
+			return setFloatField(raw, 64, dest)
+		case reflect.String:
+			dest.SetString(raw)
+			return nil
+		case reflect.Struct:
+			switch dest.Interface().(type) {
+			case time.Time:
+				return setTimeField(raw, field, dest)
+			}
+			return engine.decodeBindValue(raw, dest.Addr().Interface())
+		case reflect.Map:
+			return engine.decodeBindValue(raw, dest.Addr().Interface())
+		default:
+			return errors.New("Unknown type")
+		}
+	}
+
+	switch value.Kind() {
+	case reflect.Slice:
+		if !ok {
+			vs = []string{defaultValue}
+		}
+		slice := reflect.MakeSlice(value.Type(), len(vs), len(vs))
+		for i, s := range vs {
+			if err := assignOne(s, slice.Index(i)); err != nil {
+				return true, err
+			}
+		}
+		value.Set(slice)
+		return true, nil
+	case reflect.Array:
+		if !ok {
+			vs = []string{defaultValue}
+		}
+		if len(vs) != value.Len() {
+			return false, fmt.Errorf("%q is not valid value for %s", vs, value.Type().String())
+		}
+		for i, s := range vs {
+			if err := assignOne(s, value.Index(i)); err != nil {
+				return true, err
+			}
+		}
+		return true, nil
+	default:
+		var val string
+		if !ok {
+			val = defaultValue
+		}
+		if len(vs) > 0 {
+			val = vs[0]
+		}
+		return true, assignOne(val, value)
+	}
+}
+
+func setIntField(val string, bitSize int, field reflect.Value) error {
+	if val == "" {
+		val = "0"
+	}
+	intVal, err := strconv.ParseInt(val, 10, bitSize)
+	if err == nil {
+		field.SetInt(intVal)
+	}
+	return err
+}
+
+func setUintField(val string, bitSize int, field reflect.Value) error {
+	if val == "" {
+		val = "0"
+	}
+	uintVal, err := strconv.ParseUint(val, 10, bitSize)
+	if err == nil {
+		field.SetUint(uintVal)
+	}
+	return err
+}
+
+func setBoolField(val string, field reflect.Value) error {
+	if val == "" {
+		val = "false"
+	}
+	boolVal, err := strconv.ParseBool(val)
+	if err == nil {
+		field.SetBool(boolVal)
+	}
+	return err
+}
+
+func setFloatField(val string, bitSize int, field reflect.Value) error {
+	if val == "" {
+		val = "0.0"
+	}
+	floatVal, err := strconv.ParseFloat(val, bitSize)
+	if err == nil {
+		field.SetFloat(floatVal)
+	}
+	return err
+}
+
+func setTimeField(val string, structField reflect.StructField, value reflect.Value) error {
+	timeFormat := structField.Tag.Get("time_format")
+	if timeFormat == "" {
+		timeFormat = time.RFC3339
+	}
+
+	if val == "" {
+		value.Set(reflect.ValueOf(time.Time{}))
+		return nil
+	}
+
+	l := time.Local
+	if isUTC, _ := strconv.ParseBool(structField.Tag.Get("time_utc")); isUTC {
+		l = time.UTC
+	}
+
+	if locTag := structField.Tag.Get("time_location"); locTag != "" {
+		loc, err := time.LoadLocation(locTag)
+		if err != nil {
+			return err
+		}
+		l = loc
+	}
+
+	t, err := time.ParseInLocation(timeFormat, val, l)
+	if err != nil {
+		return err
+	}
+
+	value.Set(reflect.ValueOf(t))
+	return nil
 }
 
