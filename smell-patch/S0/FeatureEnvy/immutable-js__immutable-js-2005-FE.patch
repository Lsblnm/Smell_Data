+export class Hasher {
+  constructor() {
+    this._seed = 0;
+    this._acc = 0;
+  }
+
+  hashCollection(collection, hashValue) {
+    if (collection.size === Infinity) {
+      return 0;
+    }
+    const ordered = Boolean(collection[IS_ORDERED_SYMBOL]);
+    const keyed = Boolean(collection[IS_KEYED_SYMBOL]);
+    this._seed = ordered ? 1 : 0;
+    this._acc = this._seed;
+    const size = collection.__iterate(
+      keyed
+        ? ordered
+          ? (v, k) => {
+              this._acc =
+                (31 * this._acc + hashMerge(hashValue(v), hashValue(k))) | 0;
+            }
+          : (v, k) => {
+              this._acc =
+                (this._acc + hashMerge(hashValue(v), hashValue(k))) | 0;
+            }
+        : ordered
+        ? v => {
+            this._acc = (31 * this._acc + hashValue(v)) | 0;
+          }
+        : v => {
+            this._acc = (this._acc + hashValue(v)) | 0;
+          }
+    );
+    const math = new IntegerMath();
+    let h = this._acc;
+    h = imul(h, math.c1);
+    h = imul((h << 15) | (h >>> -15), math.c2);
+    h = imul((h << 13) | (h >>> -13), 5);
+    h = ((h + math.n) | 0) ^ size;
+    h = imul(h ^ (h >>> 16), 0x85ebca6b);
+    h = imul(h ^ (h >>> 13), 0xc2b2ae35);
+    h = smi(h ^ (h >>> 16));
+    return h;
+  }
+}
+
+function hashMerge(a, b) {
+  return (a ^ (b + 0x9e3779b9 + (a << 6) + (a >> 2))) | 0; // int
+}
