+	public void changeModifiersAndGenerateConstructor(JavacNode typeNode) {
+		JCClassDecl classDecl = (JCClassDecl) typeNode.get();
+		boolean makeConstructor = true;
+		addModifierFlag(classDecl, Flags.FINAL);
+
+		boolean markStatic = true;
+		JavacNode parent = typeNode.up();
+		if (parent.getKind() == Kind.COMPILATION_UNIT) markStatic = false;
+		if (markStatic && parent.getKind() == Kind.TYPE) {
+			if (hasAnyFlag(parent.get(), Flags.INTERFACE | Flags.ANNOTATION)) markStatic = false;
+		}
+
+		if (markStatic) addModifierFlag(classDecl, Flags.STATIC);
+
+		for (JavacNode element : typeNode.down()) {
+			if (element.getKind() == Kind.FIELD) {
+				addModifierFlag(element.get(), Flags.STATIC);
+			} else if (element.getKind() == Kind.METHOD) {
+				JCMethodDecl methodDecl = (JCMethodDecl) element.get();
+				if (isUserDeclaredConstructor(methodDecl)) {
+					element.addError("@UtilityClasses cannot have declared constructors.");
+					makeConstructor = false;
+					continue;
+				}
+				addModifierFlag(methodDecl, Flags.STATIC);
+			} else if (element.getKind() == Kind.TYPE) {
+				addModifierFlag(element.get(), Flags.STATIC);
+				ClassSymbol innerClassSymbol = (ClassSymbol) element.getElement();
+				if (innerClassSymbol != null && innerClassSymbol.owner != null && innerClassSymbol.type instanceof ClassType) {
+					((ClassType) innerClassSymbol.type).setEnclosingType(Type.noType);
+				}
+			}
+		}
+
+		if (makeConstructor) {
+			JavacTreeMaker maker = getTreeMaker();
+			Name name = toName("<init>");
+			createPrivateDefaultConstructor(typeNode, maker, name);
+		}
+	}
+
+	private static void addModifierFlag(JCTree tree, long flag) {
+		if (tree instanceof JCClassDecl) ((JCClassDecl) tree).mods.flags |= flag;
+		else if (tree instanceof JCMethodDecl) ((JCMethodDecl) tree).mods.flags |= flag;
+		else if (tree instanceof JCVariableDecl) ((JCVariableDecl) tree).mods.flags |= flag;
+	}
+
+	private static boolean hasAnyFlag(JCTree tree, long flags) {
+		if (tree instanceof JCClassDecl) return (((JCClassDecl) tree).mods.flags & flags) != 0;
+		if (tree instanceof JCMethodDecl) return (((JCMethodDecl) tree).mods.flags & flags) != 0;
+		if (tree instanceof JCVariableDecl) return (((JCVariableDecl) tree).mods.flags & flags) != 0;
+		return false;
+	}
+
+	private static boolean isUserDeclaredConstructor(JCMethodDecl methodDecl) {
+		return methodDecl.name.contentEquals("<init>")
+			&& JavacHandlerUtil.getGeneratedBy(methodDecl) == null
+			&& (methodDecl.mods.flags & Flags.GENERATEDCONSTR) == 0;
+	}
+
+	private void createPrivateDefaultConstructor(JavacNode typeNode, JavacTreeMaker maker, Name name) {
+		JCModifiers mods = maker.Modifiers(Flags.PRIVATE, com.sun.tools.javac.util.List.<JCAnnotation>nil());
+		JCBlock block = maker.Block(0L, createThrowStatement(typeNode, maker));
+		JCMethodDecl methodDef = maker.MethodDef(mods, name, null, com.sun.tools.javac.util.List.<JCTypeParameter>nil(), com.sun.tools.javac.util.List.<JCVariableDecl>nil(), com.sun.tools.javac.util.List.<JCExpression>nil(), block, null);
+		JCMethodDecl constructor = JavacHandlerUtil.recursiveSetGeneratedBy(methodDef, typeNode);
+		JavacHandlerUtil.injectMethod(typeNode, constructor);
+	}
+
+	private com.sun.tools.javac.util.List<JCStatement> createThrowStatement(JavacNode typeNode, JavacTreeMaker maker) {
+		JCExpression exceptionType = JavacHandlerUtil.genJavaLangTypeRef(typeNode, "UnsupportedOperationException");
+		com.sun.tools.javac.util.List<JCExpression> jceBlank = com.sun.tools.javac.util.List.nil();
+		JCExpression message = maker.Literal("This is a utility class and cannot be instantiated");
+		JCExpression exceptionInstance = maker.NewClass(null, jceBlank, exceptionType, com.sun.tools.javac.util.List.of(message), null);
+		JCStatement throwStatement = maker.Throw(exceptionInstance);
+		return com.sun.tools.javac.util.List.of(throwStatement);
+	}
+
