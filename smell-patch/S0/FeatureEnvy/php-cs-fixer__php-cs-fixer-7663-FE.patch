diff --git a/src/Fixer/Whitespace/StatementIndentationFixer.php b/src/Fixer/Whitespace/StatementIndentationFixer.php
index 59fed8f1c..6e26547c5 100644
--- a/src/Fixer/Whitespace/StatementIndentationFixer.php
+++ b/src/Fixer/Whitespace/StatementIndentationFixer.php
@@ -698,4 +698,164 @@ private function getSiblingContinuousSingleLineComment(Tokens $tokens, int $inde
 
         return $siblingIndex;
     }
+
+    public function findStatementEnd(Tokens $tokens, int $parenthesisEndIndex): int
+    {
+        $configuredIndent = $this->whitespacesConfig->getIndent();
+        $lineEnding = $this->whitespacesConfig->getLineEnding();
+        $fileIndent = $this->getLineIndentationWithBracesCompatibility(
+            $tokens,
+            $parenthesisEndIndex,
+            $this->extractIndent($this->computeNewLineContent($tokens, $parenthesisEndIndex))
+        );
+        $layoutIndent = $this->bracesFixerCompatibility ? $fileIndent : $configuredIndent;
+        $layoutWhitespace = $layoutIndent.$lineEnding." \t\n\r\0\x0B";
+
+        $nextIndex = $tokens->getNextMeaningfulToken($parenthesisEndIndex);
+        if (null === $nextIndex) {
+            return $parenthesisEndIndex;
+        }
+
+        $nextToken = $tokens[$nextIndex];
+        $nextId = $nextToken->getId();
+        $nextContent = $nextToken->getContent();
+        $nextIsArray = $nextToken->isArray();
+
+        if (!$nextIsArray && '{' === $nextContent && null === $nextId) {
+            return $tokens->findBlockEnd(Tokens::BLOCK_TYPE_CURLY_BRACE, $nextIndex);
+        }
+
+        $controlTokenIds = [
+            T_DECLARE,
+            T_DO,
+            T_ELSE,
+            T_ELSEIF,
+            T_FINALLY,
+            T_FOR,
+            T_FOREACH,
+            T_IF,
+            T_WHILE,
+            T_TRY,
+            T_CATCH,
+            T_SWITCH,
+        ];
+
+        if ($nextIsArray && null !== $nextId && '' !== $nextContent && \in_array($nextId, $controlTokenIds, true)) {
+            $parenthesisEndIndex = $this->findControlStructureParenthesisEnd($tokens, $nextIndex);
+            $endIndex = $this->findStatementEnd($tokens, $parenthesisEndIndex);
+
+            if (\in_array($nextId, [T_IF, T_TRY, T_DO], true)) {
+                while (true) {
+                    $continuationIndex = $tokens->getNextMeaningfulToken($endIndex);
+                    if (null === $continuationIndex) {
+                        break;
+                    }
+
+                    $continuationToken = $tokens[$continuationIndex];
+                    $continuationId = $continuationToken->getId();
+                    $continuationContent = $continuationToken->getContent();
+                    $continuationIsArray = $continuationToken->isArray();
+
+                    if (
+                        !$continuationIsArray
+                        || null === $continuationId
+                        || '' === $continuationContent
+                        || !\in_array($continuationId, $this->getControlContinuationTokenIds($nextId), true)
+                    ) {
+                        break;
+                    }
+
+                    $parenthesisEndIndex = $this->findControlStructureParenthesisEnd($tokens, $continuationIndex);
+                    $endIndex = $this->findStatementEnd($tokens, $parenthesisEndIndex);
+
+                    if (\in_array($continuationId, $this->getFinalControlContinuationTokenIds($nextId), true)) {
+                        return $endIndex;
+                    }
+                }
+            }
+
+            return $endIndex;
+        }
+
+        $index = $parenthesisEndIndex;
+
+        while (true) {
+            $token = $tokens[++$index];
+            $id = $token->getId();
+            $content = $token->getContent();
+            $isArray = $token->isArray();
+
+            if ($isArray && T_WHITESPACE === $id && '' === trim($content, $layoutWhitespace)) {
+                continue;
+            }
+
+            if (!$isArray && '{' === $content && null === $id) {
+                $index = $tokens->findBlockEnd(Tokens::BLOCK_TYPE_CURLY_BRACE, $index);
+
+                continue;
+            }
+
+            if (!$isArray && ';' === $content && null === $id) {
+                return $index;
+            }
+
+            if ($isArray && T_CLOSE_TAG === $id) {
+                return $tokens->getPrevNonWhitespace($index);
+            }
+        }
+    }
+
+    private function findControlStructureParenthesisEnd(Tokens $tokens, int $structureTokenIndex): int
+    {
+        $nextIndex = $tokens->getNextMeaningfulToken($structureTokenIndex);
+        $nextToken = $tokens[$nextIndex];
+
+        if ($nextToken->isArray() || '(' !== $nextToken->getContent() || null !== $nextToken->getId()) {
+            return $structureTokenIndex;
+        }
+
+        return $tokens->findBlockEnd(Tokens::BLOCK_TYPE_PARENTHESIS_BRACE, $nextIndex);
+    }
+
+    /**
+     * @return list<int>
+     */
+    private function getControlContinuationTokenIds(int $openingTokenKind): array
+    {
+        if (T_IF === $openingTokenKind) {
+            return [
+                T_ELSE,
+                T_ELSEIF,
+            ];
+        }
+
+        if (T_DO === $openingTokenKind) {
+            return [T_WHILE];
+        }
+
+        if (T_TRY === $openingTokenKind) {
+            return [
+                T_CATCH,
+                T_FINALLY,
+            ];
+        }
+
+        return [];
+    }
+
+    /**
+     * @return list<int>
+     */
+    private function getFinalControlContinuationTokenIds(int $openingTokenKind): array
+    {
+        if (T_IF === $openingTokenKind) {
+            return [T_ELSE];
+        }
+
+        if (T_TRY === $openingTokenKind) {
+            return [T_FINALLY];
+        }
+
+        return [];
+    }
 }
