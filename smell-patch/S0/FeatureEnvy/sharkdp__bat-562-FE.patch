+pub struct ParserSettings {
+    colored_help: bool,
+    infer_subcommands: bool,
+    args_negate_subcommands: bool,
+    disable_help_subcommand: bool,
+    versionless_subcommands: bool,
+    max_term_width: usize,
+    cache_action_required: bool,
+}
+
+impl ParserSettings {
+    pub fn from_interactive_output(interactive_output: bool) -> Self {
+        ParserSettings {
+            colored_help: interactive_output,
+            infer_subcommands: true,
+            args_negate_subcommands: true,
+            disable_help_subcommand: true,
+            versionless_subcommands: true,
+            max_term_width: 100,
+            // Check if the current directory contains a file name cache, if it does
+            // do not make the arguements for subcommand 'cache' required.
+            cache_action_required: !Path::new("cache").exists(),
+        }
+    }
+
+    pub fn colored_help(&self) -> bool {
+        self.colored_help
+    }
+
+    pub fn infer_subcommands(&self) -> bool {
+        self.infer_subcommands
+    }
+
+    pub fn args_negate_subcommands(&self) -> bool {
+        self.args_negate_subcommands
+    }
+
+    pub fn disable_help_subcommand(&self) -> bool {
+        self.disable_help_subcommand
+    }
+
+    pub fn versionless_subcommands(&self) -> bool {
+        self.versionless_subcommands
+    }
+
+    pub fn max_term_width(&self) -> usize {
+        self.max_term_width
+    }
+
+    pub fn cache_action_required(&self) -> bool {
+        self.cache_action_required
+    }
+}
