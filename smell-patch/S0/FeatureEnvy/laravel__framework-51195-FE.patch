+    /**
+     * Store the verbatim blocks and replace them with a temporary placeholder.
+     *
+     * @param  string  $value
+     * @return string
+     */
+    public function storeVerbatimBlocks($value)
+    {
+        $compiler = $this->blade;
+        $aliases = $this->aliases;
+
+        $contentTags = $compiler->getContentTags();
+        $rawTags = $compiler->getRawTags();
+        $escapedTags = $compiler->getEscapedTags();
+        $echoFormat = $compiler->getEchoFormat();
+        $normalizedPath = ViewName::normalize($compiler->getPath() ?: 'verbatim.block');
+
+        return preg_replace_callback('/(?<!@)@verbatim(.*?)@endverbatim/s', function ($matches) use ($compiler, $aliases, $contentTags, $rawTags, $escapedTags, $echoFormat, $normalizedPath) {
+            $block = $matches[1];
+
+            if (str_contains($block, $contentTags[0]) ||
+                str_contains($block, $rawTags[0]) ||
+                str_contains($block, $escapedTags[0])) {
+                $block = (new ComponentSlot($block, [
+                    'aliases' => $aliases,
+                ]))->toHtml();
+            } else {
+                $block = (new ComponentSlot($block, [
+                    'echo-format' => $echoFormat,
+                    'view' => $normalizedPath,
+                    'aliases' => $aliases,
+                ]))->toHtml();
+            }
+
+            return $compiler->storeRawBlock($block);
+        }, $value);
+    }
