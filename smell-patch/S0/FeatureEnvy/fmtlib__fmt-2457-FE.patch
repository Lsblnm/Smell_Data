+FMT_BEGIN_DETAIL_NAMESPACE
+
+template <typename Char> struct join_separator {
+  const Char* data;
+  const Char* end;
+  size_t size;
+  bool empty;
+  Char first;
+
+  join_separator()
+      : data(nullptr), end(nullptr), size(0), empty(true), first() {}
+
+  explicit join_separator(basic_string_view<Char> sep)
+      : data(sep.data()),
+        end(sep.data() + sep.size()),
+        size(sep.size()),
+        empty(sep.size() == 0),
+        first(sep.size() != 0 ? sep.data()[0] : Char()) {}
+};
+
+size_t counted_join_separator_length(const char* begin, const char* end);
+FMT_API size_t counted_join_separator(const char* begin, const char* end);
+
+template <typename Char, FMT_ENABLE_IF(!std::is_same<Char, char>::value)>
+inline auto counted_join_separator(const Char* begin, const Char* end)
+    -> size_t {
+  return static_cast<size_t>(end - begin);
+}
+
+template <typename OutputIt, typename Char>
+auto write_join_separator(OutputIt out, const Char* begin, size_t n)
+    -> OutputIt {
+  return copy_str<Char>(begin, begin + n, out);
+}
+
+template <typename OutputIt, typename Char>
+auto copy_join_separator(OutputIt out, const Char* begin, const Char* end)
+    -> OutputIt {
+  return write_join_separator(out, begin, counted_join_separator(begin, end));
+}
+
+FMT_END_DETAIL_NAMESPACE
+
