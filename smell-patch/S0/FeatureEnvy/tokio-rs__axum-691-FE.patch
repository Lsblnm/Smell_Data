+
+    fn add_nested_router(mut self, router: Router<B>, prefix: &str) -> Self {
+        let Router {
+            mut routes,
+            node,
+            fallback,
+            // nesting a router that has something nested at root
+            // doesn't mean something is nested at root in _this_ router
+            // thus we don't need to propagate that
+            nested_at_root: _,
+        } = router;
+
+        if let Fallback::Custom(_) = fallback {
+            panic!("Cannot nest `Router`s that has a fallback");
+        }
+
+        let nested_at_root = self.nested_at_root;
+        let fallback_before = self.fallback.clone();
+
+        for (id, nested_path) in node.route_id_to_path {
+            let id = node
+                .path_to_route_id
+                .get(&nested_path)
+                .copied()
+                .unwrap_or(id);
+            let id = match node.inner.at(&*nested_path) {
+                Ok(matched) => *matched.value,
+                Err(_) => id,
+            };
+            let route = routes.remove(&id).unwrap();
+            let full_path = if &*nested_path == "/" {
+                prefix.to_owned()
+            } else {
+                format!("{}{}", prefix, nested_path)
+            };
+            self = match route {
+                Endpoint::MethodRouter(method_router) => {
+                    let nested = StripPrefix::new(method_router, prefix);
+                    let strip_prefix = nested.prefix;
+                    let method_router = nested.inner;
+                    self.route(
+                        &full_path,
+                        method_router.layer(layer_fn(move |s| StripPrefix::new(s, &strip_prefix))),
+                    )
+                }
+                Endpoint::Route(route) => {
+                    let nested = StripPrefix::new(route, prefix);
+                    let strip_prefix = nested.prefix;
+                    let route = nested.inner;
+                    self.route(&full_path, StripPrefix::new(route, &strip_prefix))
+                }
+            };
+        }
+
+        debug_assert!(routes.is_empty());
+
+        if nested_at_root {
+            self.nested_at_root = true;
+        }
+        self.fallback = fallback_before;
 
         self
     }
