+template <typename OutputIt, typename Char>
+struct grouped_int_writer {
+  OutputIt out;
+  unsigned prefix;
+
+  template <typename UInt>
+  auto write_int(UInt value, const format_specs<Char>& specs,
+                 const digit_grouping<Char>& grouping) -> OutputIt {
+    static_assert(std::is_same<uint64_or_128_t<UInt>, UInt>::value, "");
+    int num_digits = count_digits(value);
+    char digits[40];
+    format_decimal(digits, value, num_digits);
+
+    const auto& grouping_chars = grouping.grouping();
+    const auto& thousands_sep = grouping.separator();
+    int sep_count = 0;
+    if (!thousands_sep.empty()) {
+      auto group = grouping_chars.begin();
+      int pos = 0;
+      auto next_pos = [&]() {
+        if (thousands_sep.empty()) return max_value<int>();
+        if (group == grouping_chars.end()) return pos += grouping_chars.back();
+        if (*group <= 0 || *group == max_value<char>()) return max_value<int>();
+        pos += *group++;
+        return pos;
+      };
+      while (num_digits > next_pos()) ++sep_count;
+    }
+
+    unsigned size = to_unsigned((prefix != 0 ? 1 : 0) + num_digits + sep_count);
+    auto write_digits = [&](reserve_iterator<OutputIt> it) {
+      if (prefix != 0) {
+        char sign = static_cast<char>(prefix);
+        *it++ = static_cast<Char>(sign);
+      }
+      return grouping.apply(it, string_view(digits, to_unsigned(num_digits)));
+    };
+
+    if ((specs.width | (specs.precision + 1)) == 0) {
+      auto it = reserve(out, size);
+      return base_iterator(out, write_digits(it));
+    }
+
+    unsigned spec_width = to_unsigned(specs.width);
+    size_t padding = spec_width > size ? spec_width - size : 0;
+    auto* shifts = "\x00\x1f\x00\x01";
+    size_t left_padding = padding >> shifts[specs.align];
+    size_t right_padding = padding - left_padding;
+    auto it = reserve(out, size + padding * specs.fill.size());
+    if (left_padding != 0) it = fill(it, left_padding, specs.fill);
+    it = write_digits(it);
+    if (right_padding != 0) it = fill(it, right_padding, specs.fill);
+    return base_iterator(out, it);
+  }
+};
 
