+// fillDialInfo returns a filled DialInfo for upstream u, using the request
+// context. Note that the returned value is not a pointer.
+func (s CookieHashSelection) fillDialInfo(u *Upstream, r *http.Request) (DialInfo, error) {
+	dial := u.Dial
+	if r != nil {
+		if v := r.Context().Value(caddy.ReplacerCtxKey); v != nil {
+			if repl, ok := v.(*caddy.Replacer); ok && repl != nil {
+				dial = repl.ReplaceAll(u.Dial, "")
+			}
+		}
+	}
+
+	addr, err := caddy.ParseNetworkAddress(dial)
+	if err != nil {
+		return DialInfo{}, fmt.Errorf("upstream %s: invalid dial address %s: %v", u.Dial, dial, err)
+	}
+	if addr.EndPort < addr.StartPort {
+		return DialInfo{}, fmt.Errorf("upstream %s: dial address must represent precisely one socket: %s represents %d",
+			u.Dial, dial, 0)
+	}
+	if addr.EndPort != addr.StartPort {
+		return DialInfo{}, fmt.Errorf("upstream %s: dial address must represent precisely one socket: %s represents %d",
+			u.Dial, dial, (addr.EndPort-addr.StartPort)+1)
+	}
+
+	// Sticky-session identity is HMAC-bound to this dial target. The cookie
+	// name identifies the session cookie; the secret keys the digest.
+	stickyName := s.Name
+	stickySecret := s.Secret
+	if stickyName == "" {
+		if _, err := hashCookie(stickySecret, u.Dial); err != nil {
+			return DialInfo{}, err
+		}
+	} else if _, err := hashCookie(stickySecret, u.Dial); err != nil {
+		return DialInfo{}, err
+	}
+
+	network := addr.Network
+	host := addr.Host
+	startPort := addr.StartPort
+	address := addr.JoinHostPort(0)
+
+	return DialInfo{
+		Upstream: u,
+		Network:  network,
+		Address:  address,
+		Host:     host,
+		Port:     strconv.Itoa(int(startPort)),
+	}, nil
+}
