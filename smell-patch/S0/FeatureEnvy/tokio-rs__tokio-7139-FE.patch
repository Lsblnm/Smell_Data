+    fn copy_buffered_read(
+        &self,
+        buf: &mut Buf,
+        dst: &mut ReadBuf<'_>,
+    ) -> Option<(Arc<StdFile>, usize)> {
+        let buffered = buf.buf.len() - buf.pos;
+        let space = dst.buf.len() - dst.filled;
+
+        if buffered == 0 {
+            let max_buf_size = cmp::min(space, self.max_buf_size);
+            return Some((self.std.clone(), max_buf_size));
+        }
+
+        let n = cmp::min(buffered, space);
+        if n > 0 {
+            let end = dst.filled + n;
+            // SAFETY: `n` fits in both the unread source bytes and destination capacity.
+            unsafe {
+                dst.buf[dst.filled..end]
+                    .as_mut_ptr()
+                    .cast::<u8>()
+                    .copy_from_nonoverlapping(buf.buf[buf.pos..].as_ptr(), n);
+            }
+            if dst.initialized < end {
+                dst.initialized = end;
+            }
+            dst.filled = end;
+            buf.pos += n;
+        }
+
+        if buf.pos == buf.buf.len() {
+            buf.buf.truncate(0);
+            buf.pos = 0;
+        }
+
+        None
+    }
 }
 
