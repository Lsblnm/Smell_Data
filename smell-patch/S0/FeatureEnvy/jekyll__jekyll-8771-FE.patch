diff --git a/lib/jekyll/readers/data_reader.rb b/lib/jekyll/readers/data_reader.rb
index 80b57bd6b..0adc43d83 100644
--- a/lib/jekyll/readers/data_reader.rb
+++ b/lib/jekyll/readers/data_reader.rb
@@ -72,6 +72,30 @@ module Jekyll
         .gsub(%r!\s+!, "_")
     end
 
+    # Read and merge the data files.
+    # If a theme is specified and it contains data, it will be read.
+    # Site data will overwrite theme data with the same key using the
+    # semantics of Utils.deep_merge_hashes.
+    #
+    # Returns nothing.
+    def read_data
+      @content = read(@site.config["data_dir"])
+      @site.data = @content
+
+      theme = @site.theme
+      data_path = theme&.data_path
+      return unless data_path
+
+      theme_root = theme.root
+      theme_data = self.class.new(
+        @site,
+        :in_source_dir => proc do |*paths|
+          paths.reduce(theme_root) { |base, path| Jekyll.sanitized_path(base, path) }
+        end
+      ).read(data_path)
+      @site.data = Jekyll::Utils.deep_merge_hashes(theme_data, @content)
+    end
+
     private
 
     # @return [Hash]
