+    /**
+     * Convert the stored date range into a total for the given unit.
+     */
+    private function totalFromDateRange(string $unit): float
+    {
+        $start = $this->startDate;
+        $end = $this->endDate;
+
+        if (!\in_array($unit, ['microseconds', 'milliseconds', 'seconds', 'minutes', 'hours'], true)) {
+            return $start->diffInUnit($unit, $end);
+        }
+
+        if (
+            $start->timezoneName !== $end->timezoneName
+            || $start->offset !== $end->offset
+            || $start->dst !== $end->dst
+        ) {
+            $start = $start->avoidMutation()->utc();
+            $end = $end->avoidMutation()->utc();
+        }
+
+        $microseconds = ($end->timestamp - $start->timestamp) * Carbon::MICROSECONDS_PER_SECOND
+            + $end->micro - $start->micro;
+
+        return match ($unit) {
+            'milliseconds' => $microseconds / Carbon::MICROSECONDS_PER_MILLISECOND,
+            'seconds' => $microseconds / Carbon::MICROSECONDS_PER_SECOND,
+            'minutes' => $microseconds / (Carbon::MICROSECONDS_PER_SECOND * Carbon::SECONDS_PER_MINUTE),
+            'hours' => $microseconds / (
+                Carbon::MICROSECONDS_PER_SECOND * Carbon::SECONDS_PER_MINUTE * Carbon::MINUTES_PER_HOUR
+            ),
+            default => $microseconds,
+        };
+    }
+
