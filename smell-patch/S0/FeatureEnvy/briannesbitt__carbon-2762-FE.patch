+    /**
+     * Get the signed whole-day difference encoded in a raw DateInterval.
+     *
+     * @param DateInterval $interval
+     *
+     * @return int
+     */
+    public static function getIntervalDayDiff(DateInterval $interval): int
+    {
+        $daysDiff = (int) $interval->format('%a');
+        $sign = $interval->format('%r') === '-' ? -1 : 1;
+
+        if (\is_int($interval->days) &&
+            $interval->y === 0 &&
+            $interval->m === 0 &&
+            version_compare(PHP_VERSION, '8.1.0-dev', '<') &&
+            abs($interval->d - $daysDiff) === 1
+        ) {
+            $daysDiff = abs($interval->d); // @codeCoverageIgnore
+        }
+
+        return $daysDiff * $sign;
+    }
+
+    /**
+     * Copy the calendar difference between two dates onto this interval.
+     *
+     * @param CarbonInterface $base
+     * @param CarbonInterface $rounded
+     *
+     * @return $this
+     */
+    protected function applyDateDifference(CarbonInterface $base, CarbonInterface $rounded)
+    {
+        $this->years = $rounded->year - $base->year;
+        $this->months = $rounded->month - $base->month;
+
+        if ($this->years !== 0 || $this->months !== 0) {
+            return $this->copyProperties($rounded->diffAsCarbonInterval($base), true);
+        }
+
+        $micro = $rounded->micro - $base->micro;
+        $second = $rounded->second - $base->second;
+        $minute = $rounded->minute - $base->minute;
+        $hour = $rounded->hour - $base->hour;
+        $day = $rounded->day - $base->day;
+
+        if ($micro < 0) {
+            $micro += Carbon::MICROSECONDS_PER_SECOND;
+            $second--;
+        }
+
+        if ($second < 0) {
+            $second += Carbon::SECONDS_PER_MINUTE;
+            $minute--;
+        }
+
+        if ($minute < 0) {
+            $minute += Carbon::MINUTES_PER_HOUR;
+            $hour--;
+        }
+
+        if ($hour < 0) {
+            $hour += Carbon::HOURS_PER_DAY;
+            $day--;
+        }
+
+        if ($day < 0) {
+            return $this->copyProperties($rounded->diffAsCarbonInterval($base), true);
+        }
+
+        return $this->set([
+            'days' => $day,
+            'hours' => $hour,
+            'minutes' => $minute,
+            'seconds' => $second,
+            'microseconds' => $micro,
+        ]);
+    }
+
     /**
      * Round the current instance at the given unit with given precision if specified and the given function.
