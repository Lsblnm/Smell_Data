+    /**
+     * Refresh the PDO connections using the given database manager.
+     *
+     * @param  \Illuminate\Database\DatabaseManager  $manager
+     * @return $this
+     *
+     * @throws \InvalidArgumentException
+     */
+    public function refreshPdoConnections(DatabaseManager $manager)
+    {
+        $name = ($this->config['name'] ?? null).($this->readWriteType ? '::'.$this->readWriteType : '');
+
+        $database = $name ?: $manager->getDefaultConnection();
+        $type = null;
+
+        if (str_ends_with((string) $database, '::read') || str_ends_with((string) $database, '::write')) {
+            [$database, $type] = explode('::', $database, 2);
+        }
+
+        $configName = $database ?: $manager->getDefaultConnection();
+        $config = $manager->rawConfiguration($configName);
+
+        if (is_null($config)) {
+            throw new InvalidArgumentException("Database connection [{$configName}] not configured.");
+        }
+
+        $config = (new ConfigurationUrlParser)->parseConfiguration($config);
+
+        $extensions = $manager->getExtensions();
+
+        if (isset($extensions[$configName])) {
+            $fresh = call_user_func($extensions[$configName], $config, $configName);
+        } elseif (isset($extensions[$driver = $config['driver']])) {
+            $fresh = call_user_func($extensions[$driver], $config, $configName);
+        } else {
+            $fresh = $manager->getFactory()->make($config, $configName);
+        }
+
+        $fresh = $manager->applyPdoType($fresh, $type)->setReadWriteType($type);
+
+        $app = $manager->getApplication();
+
+        if ($app->bound('events')) {
+            $fresh->setEventDispatcher($app['events']);
+        }
+
+        if ($app->bound('db.transactions')) {
+            $fresh->setTransactionManager($app['db.transactions']);
+        }
+
+        $fresh->setReconnector($manager->getReconnector());
+
+        return $manager->getConnections()[$name]
+                    ->setPdo($fresh->getRawPdo())
+                    ->setReadPdo($fresh->getRawReadPdo());
+    }
+
