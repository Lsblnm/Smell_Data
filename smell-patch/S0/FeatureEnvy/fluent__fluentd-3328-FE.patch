diff --git a/lib/fluent/plugin/in_tail/position_file.rb b/lib/fluent/plugin/in_tail/position_file.rb
index 88614d28..3845d7dc 100644
--- a/lib/fluent/plugin/in_tail/position_file.rb
+++ b/lib/fluent/plugin/in_tail/position_file.rb
@@ -15,9 +15,60 @@
 #
 
 require 'fluent/plugin/input'
+require 'fluent/plugin/owned_by_mixin'
 
 module Fluent::Plugin
   class TailInput < Fluent::Plugin::Input
+    class WatcherStartup
+      include OwnedByMixin
+
+      def start_watchers(targets_info)
+        plugin = owner
+        tails = plugin.instance_variable_get(:@tails)
+        pf = plugin.instance_variable_get(:@pf)
+        read_from_head = plugin.read_from_head
+        pos_file = plugin.pos_file
+
+        targets_info.each_value { |target_info|
+          path = target_info.path
+          pe = nil
+          if pos_file && pf
+            pe = pf[target_info]
+            if read_from_head
+              reset_unread_entry(pe, path)
+            end
+          end
+
+          begin
+            tw = plugin.setup_watcher(target_info, pe)
+          rescue WatcherSetupError => e
+            log.warn "Skip #{path} because unexpected setup error happens: #{e}"
+            next
+          end
+
+          begin
+            target_info = TargetInfo.new(path, Fluent::FileWrapper.stat(path).ino)
+            tails[target_info] = tw
+          rescue Errno::ENOENT
+            $log.warn "stat() for #{path} failed with ENOENT. Drop tail watcher for now."
+            # explicitly detach and unwatch watcher `tw`.
+            plugin.stop_watchers(target_info, immediate: true, unwatched: true)
+          end
+        }
+      end
+
+      private
+
+      def reset_unread_entry(pe, path)
+        return unless pe.read_inode.zero?
+        begin
+          pe.update(Fluent::FileWrapper.stat(path).ino, 0)
+        rescue Errno::ENOENT
+          $log.warn "#{path} not found. Continuing without tailing it."
+        end
+      end
+    end
+
     class PositionFile
       UNWATCHED_POSITION = 0xffffffffffffffff
       POSITION_FILE_ENTRY_REGEX = /^([^\t]+)\t([0-9a-fA-F]+)\t([0-9a-fA-F]+)/.freeze
