+
 class FunctionPrefix
 {
     const XLFNREGEXP = '/(?:_xlfn\.)?((?:_xlws\.)?('
@@ -159,6 +164,22 @@ class FunctionPrefix
         . '|sort'
         . ')\s*\(/mui';
 
+    /**
+     * @var string
+     */
+    private $xlfnPattern;
+
+    /**
+     * @var string
+     */
+    private $xlwsPattern;
+
+    public function __construct()
+    {
+        $this->xlfnPattern = self::XLFNREGEXP;
+        $this->xlwsPattern = self::XLWSREGEXP;
+    }
+
     /**
      * Prefix function name in string with _xlfn. where required.
      */
@@ -191,4 +212,59 @@ class FunctionPrefix
     {
         return self::addFunctionPrefix(substr($functionString, 1));
     }
+
+    /**
+     * Write a formula cell to XML.
+     */
+    public function writeCellFormula(XMLWriter $objWriter, Cell $cell, bool $preCalculateFormulas, bool $office2003Compatibility): void
+    {
+        $cellValue = $cell->getValue();
+        $mappedType = $cell->getDataType();
+        $calculatedValue = ($preCalculateFormulas && strtolower($mappedType) === 'f')
+            ? $cell->getCalculatedValue()
+            : $cellValue;
+        if (is_string($calculatedValue)) {
+            if (ErrorValue::isError($calculatedValue)) {
+                $objWriter->writeAttribute('t', 'e');
+                $formulaText = is_string($cellValue) ? $cellValue : (string) $cellValue;
+                $cellIsFormula = substr($formulaText, 0, 1) === '=';
+                if ($cellIsFormula) {
+                    $prefixedFormula = (string) preg_replace($this->xlfnPattern, '_xlfn.$1(', substr($formulaText, 1));
+                    $prefixedFormula = (string) preg_replace($this->xlwsPattern, '_xlws.$1(', $prefixedFormula);
+                    $objWriter->writeElement('f', $prefixedFormula);
+                }
+                $objWriter->writeElement('v', $cellIsFormula ? $calculatedValue : $formulaText);
+
+                return;
+            }
+            $objWriter->writeAttribute('t', 'str');
+            $calculatedValue = StringHelper::controlCharacterPHP2OOXML($calculatedValue);
+        } elseif (is_bool($calculatedValue)) {
+            $objWriter->writeAttribute('t', 'b');
+            $calculatedValue = (int) $calculatedValue;
+        }
+
+        $formulaText = is_string($cellValue) ? $cellValue : (string) $cellValue;
+        $prefixedFormula = (string) preg_replace($this->xlfnPattern, '_xlfn.$1(', substr($formulaText, 1));
+        $prefixedFormula = (string) preg_replace($this->xlwsPattern, '_xlws.$1(', $prefixedFormula);
+        $attributes = $cell->getFormulaAttributes();
+        if (($attributes['t'] ?? null) === 'array') {
+            $objWriter->startElement('f');
+            $objWriter->writeAttribute('t', 'array');
+            $objWriter->writeAttribute('ref', $cell->getCoordinate());
+            $objWriter->writeAttribute('aca', '1');
+            $objWriter->writeAttribute('ca', '1');
+            $objWriter->text($prefixedFormula);
+            $objWriter->endElement();
+        } else {
+            $objWriter->writeElement('f', $prefixedFormula);
+            if ($office2003Compatibility === false) {
+                $objWriter->writeElement(
+                    'v',
+                    ($preCalculateFormulas && !is_array($calculatedValue) && substr($calculatedValue ?? '', 0, 1) !== '#')
+                        ? StringHelper::formatNumber($calculatedValue) : '0'
+                );
+            }
+        }
+    }
 }
