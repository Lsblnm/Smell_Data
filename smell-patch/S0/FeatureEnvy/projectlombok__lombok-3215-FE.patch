+		java.util.HashSet<String> gatherUsedTypeNames() {
+			java.util.HashSet<String> usedNames = new HashSet<String>();
+			JavacNode typeNode = this.parentType;
+			if (typeNode == null || typeNode.getKind() != Kind.TYPE) return usedNames;
+
+			JavacNode enclosing = typeNode.up();
+			if (enclosing == null || typeNode.get() == null) return usedNames;
+
+			// 1. Add type parameter names.
+			for (JCTypeParameter typeParam : this.typeParams)
+				usedNames.add(typeParam.getName().toString());
+
+			// 2. Add class name. Nested types keep the simple name rather than a qualified enclosing name.
+			String typeName = typeNode.getName();
+			if (typeName != null) usedNames.add(typeName);
+
+			// 3. Add used type names from fields.
+			for (JavacNode child : typeNode.down()) {
+				if (child.getKind() != Kind.FIELD) continue;
+				for (JavacNode typeUse : child.down()) {
+					if (typeUse.getKind() != Kind.TYPE_USE) continue;
+					JCTree typeTree = typeUse.get();
+					if (typeTree instanceof JCIdent)
+						usedNames.add(typeTree.toString());
+				}
+			}
+
+			return usedNames;
+		}
