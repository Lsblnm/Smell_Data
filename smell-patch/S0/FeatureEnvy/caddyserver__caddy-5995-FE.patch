 	"go.uber.org/zap"
@@ -522,3 +523,113 @@ func (ctx Context) Module() Module {
 	}
 	return ctx.ancestry[len(ctx.ancestry)-1]
 }
+
+type replacementScan struct {
+	out    strings.Builder
+	cursor int
+}
+
+func (s *replacementScan) replace(r *Replacer, input, empty string,
+	treatUnknownAsEmpty, errOnEmpty, errOnUnknown bool,
+	f ReplacementFunc,
+) (string, error) {
+	if r.openBrace == 0 {
+		r.openBrace = phOpen
+		r.closeBrace = phClose
+		r.escapeChar = phEscape
+	}
+	if r.unclosedLimit == 0 {
+		r.unclosedLimit = 100
+	}
+
+	if !strings.Contains(input, string(r.openBrace)) {
+		return input, nil
+	}
+
+	s.out.Grow(len(input))
+	s.cursor = 0
+
+	var unclosedCount int
+
+scan:
+	for i := 0; i < len(input); i++ {
+		if i > 0 && input[i-1] == r.escapeChar && (input[i] == r.closeBrace || input[i] == r.openBrace) {
+			s.out.WriteString(input[s.cursor : i-1])
+			s.cursor = i
+			continue
+		}
+
+		if input[i] != r.openBrace {
+			continue
+		}
+
+		if unclosedCount > r.unclosedLimit {
+			return "", fmt.Errorf("too many unclosed placeholders")
+		}
+
+		end := strings.Index(input[i:], string(r.closeBrace)) + i
+		if end < i {
+			unclosedCount++
+			continue
+		}
+
+		for end > 0 && end < len(input)-1 && input[end-1] == r.escapeChar {
+			nextEnd := strings.Index(input[end+1:], string(r.closeBrace))
+			if nextEnd < 0 {
+				unclosedCount++
+				continue scan
+			}
+			end += nextEnd + 1
+		}
+
+		s.out.WriteString(input[s.cursor:i])
+
+		key := input[i+1 : end]
+
+		var val any
+		found := false
+		for _, mapFunc := range r.providers {
+			if v, ok := mapFunc(key); ok {
+				val, found = v, true
+				break
+			}
+		}
+		if !found {
+			if errOnUnknown {
+				return "", fmt.Errorf("unrecognized placeholder %s%s%s",
+					string(r.openBrace), key, string(r.closeBrace))
+			} else if !treatUnknownAsEmpty {
+				s.cursor = i
+				continue
+			}
+		}
+
+		if f != nil {
+			var err error
+			val, err = f(key, val)
+			if err != nil {
+				return "", err
+			}
+		}
+
+		valStr := ToString(val)
+
+		if valStr == "" {
+			if errOnEmpty {
+				return "", fmt.Errorf("evaluated placeholder %s%s%s is empty",
+					string(r.openBrace), key, string(r.closeBrace))
+			} else if empty != "" {
+				s.out.WriteString(empty)
+			}
+		} else {
+			s.out.WriteString(valStr)
+		}
+
+		i = end
+		s.cursor = i + 1
+	}
+
+	s.out.WriteString(input[s.cursor:])
+
+	return s.out.String(), nil
+}
