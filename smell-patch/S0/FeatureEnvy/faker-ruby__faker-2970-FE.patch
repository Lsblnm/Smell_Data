       [198..198, 18..19,   0..255, 1..255]  # 198.18.0.0/15  - Used for benchmark testing of inter-network communications between subnets
     ].each(&:freeze).freeze
 
+    def initialize(specifier = nil, separators = %w[. _])
+      @specifier = specifier
+      @separators = separators
+    end
+
+    def compose_username
+      case @specifier
+      when ::String
+        names = @specifier&.gsub("'", '')&.split
+        shuffled_names = self.class.shuffle(names)
+
+        return shuffled_names.join(self.class.sample(@separators)).downcase
+      when Integer
+        # If specifier is Integer and has large value, Argument error exception is raised to overcome memory full error
+        raise ArgumentError, 'Given argument is too large' if @specifier > 10**6
+
+        tries = 0 # Don't try forever in case we get something like 1_000_000.
+        result = nil
+        loop do
+          result = self.class.username(specifier: nil, separators: @separators)
+          tries += 1
+          break unless result.length < @specifier && tries < 7
+        end
+        return result * (@specifier / result.length + 1) if @specifier.positive?
+      when Range
+        tries = 0
+        result = nil
+        loop do
+          result = self.class.username(specifier: @specifier.min, separators: @separators)
+          tries += 1
+          break unless !@specifier.include?(result.length) && tries < 7
+        end
+        return result[0...@specifier.max]
+      end
+
+      person = Name.identity
+      name_fragments = self.class.shuffle(
+        [
+          Char.prepare(person.given_name),
+          Char.prepare(person.family_name),
+          Char.prepare(person.honorific),
+          Char.prepare(person.lineage_suffix),
+          Char.prepare(person.second_given_name)
+        ].reject(&:empty?)
+      )
+
+      self.class.sample([
+                          name_fragments.first,
+                          name_fragments.first(2).join(self.class.sample(@separators))
+                        ])
+    end
