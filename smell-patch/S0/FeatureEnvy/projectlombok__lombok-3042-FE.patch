+	public void clearTypes(JCTree tree) {
+		JavacAST compilation = this.ast;
+		JCTree origin = this.node;
+
+		TreeScanner scanner = new TreeScanner() {
+			@Override public void scan(JCTree tree) {
+				tree.type = null;
+				super.scan(tree);
+			}
+			@Override public void visitClassDef(JCClassDecl tree) {
+				tree.sym = null;
+				super.visitClassDef(tree);
+			}
+			@Override public void visitMethodDef(JCMethodDecl tree) {
+				tree.sym = null;
+				super.visitMethodDef(tree);
+			}
+			@Override public void visitVarDef(JCVariableDecl tree) {
+				tree.sym = null;
+				super.visitVarDef(tree);
+			}
+			@Override public void visitSelect(JCFieldAccess tree) {
+				tree.sym = null;
+				super.visitSelect(tree);
+			}
+			@Override public void visitIdent(JCIdent tree) {
+				tree.sym = null;
+				super.visitIdent(tree);
+			}
+			@Override public void visitAnnotation(JCAnnotation tree) {
+				JavacHandlerUtil.JCAnnotationReflect.setAttribute(tree, null);
+				super.visitAnnotation(tree);
+			}
+		};
+
+		if (compilation != null && tree != origin && tree instanceof JCAnnotation) {
+			JCAnnotation annotation = (JCAnnotation) tree;
+			JCTree annotationType = annotation.annotationType;
+			com.sun.tools.javac.util.List<JCExpression> args = annotation.args;
+			int start = annotation.pos;
+			int end = getEndPosition(annotation.pos());
+			compilation.removeFromDeferredDiagnostics(start, end);
+
+			if (annotationType != null) scanner.scan(annotationType);
+			if (args != null) {
+				for (JCExpression arg : args) {
+					if (arg instanceof JCNewArray) {
+						JCNewArray arr = (JCNewArray) arg;
+						JCExpression elemtype = arr.elemtype;
+						com.sun.tools.javac.util.List<JCExpression> dims = arr.dims;
+						com.sun.tools.javac.util.List<JCExpression> elems = arr.elems;
+						if (elemtype != null) scanner.scan(elemtype);
+						if (dims != null) {
+							for (JCExpression dim : dims) {
+								if (dim != null) scanner.scan(dim);
+							}
+						}
+						if (elems != null) {
+							for (JCExpression elem : elems) {
+								if (elem != null) scanner.scan(elem);
+							}
+						}
+					}
+				}
+			}
+		}
+
+		tree.accept(scanner);
+	}
