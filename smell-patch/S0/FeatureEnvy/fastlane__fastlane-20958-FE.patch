+    def checkout_git_import_session(session)
+      UI.verbose("Checking out #{session.branch} from #{session.clone_folder} for #{@path} (#{self.runner})")
+
+      if session.eligible_for_caching && session.version.nil?
+        # Update the repo if it's eligible for caching but the version isn't specified
+        UI.message("Fetching remote git branches and updating git repo...")
+        Helper.with_env_values('GIT_TERMINAL_PROMPT' => '0') do
+          Actions.sh("cd #{session.clone_folder.shellescape} && git fetch --all --quiet && git checkout #{session.checkout_param.shellescape} #{session.checkout_path} && git reset --hard && git rebase")
+        end
+      else
+        begin
+          # https://stackoverflow.com/a/1593574/865175
+          current_tag = Actions.sh("cd #{session.clone_folder.shellescape} && git describe --exact-match --tags HEAD").strip
+        rescue
+          current_tag = nil
+        end
+
+        if !session.version.nil? && current_tag != session.version
+          Actions.sh("cd #{session.clone_folder.shellescape} && git checkout #{session.checkout_param.shellescape} #{session.checkout_path}")
+        end
+      end
+    end
