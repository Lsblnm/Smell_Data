@@ -91,4 +91,41 @@ module FastlaneCore
       end
     end
   end
+
+  # Describes how a cloned repository should be checked out.
+  class GitCheckoutSpec
+    attr_reader :checkout_path
+    attr_reader :eligible_for_caching
+
+    def self.build(checkout_path:, eligible_for_caching:, checkout_param:, version:, branch:)
+      ref = GitRefSelection.new(
+        checkout_param: checkout_param,
+        version: version,
+        branch: branch
+      )
+      new(checkout_path: checkout_path, eligible_for_caching: eligible_for_caching, ref: ref)
+    end
+
+    def initialize(checkout_path:, eligible_for_caching:, ref:)
+      @checkout_path = checkout_path
+      @eligible_for_caching = eligible_for_caching
+      @ref = ref
+    end
+
+    def checkout_param
+      @ref.checkout_param
+    end
+
+    def checkout_param=(value)
+      @ref.checkout_param = value
+    end
+
+    def version
+      @ref.version
+    end
+
+    def branch
+      @ref.branch
+    end
+  end
 end
