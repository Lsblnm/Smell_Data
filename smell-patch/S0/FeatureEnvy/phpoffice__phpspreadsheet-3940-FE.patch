+    public function setSelectedCellsActivePane(Worksheet $worksheet): void
+    {
+        $freezePane = $worksheet->getFreezePane();
+        if (empty($freezePane)) {
+            return;
+        }
+
+        $active = new self($worksheet->getActiveCell());
+        if ($this->beforeColumn === 1) {
+            $activePane = ($active->beforeRow <= $this->beforeRow) ? 'topLeft' : 'bottomLeft';
+        } elseif ($this->beforeRow === 1) {
+            $activePane = ($active->beforeColumn <= $this->beforeColumn) ? 'topLeft' : 'topRight';
+        } elseif ($active->beforeRow <= $this->beforeRow) {
+            $activePane = ($active->beforeColumn <= $this->beforeColumn) ? 'topLeft' : 'topRight';
+        } else {
+            $activePane = ($active->beforeColumn <= $this->beforeColumn) ? 'bottomLeft' : 'bottomRight';
+        }
+
+        $worksheet->setActivePane($activePane);
+        $worksheet->setPane($activePane, new Pane($activePane, $worksheet->getSelectedCells(), $worksheet->getActiveCell()));
+    }
