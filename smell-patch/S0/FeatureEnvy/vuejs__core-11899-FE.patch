+export class NestedRuleSnapshot {
+  childNodes: ChildNode[]
+  isSlotted: boolean
+  markedDeep: boolean
+  private readonly hostRule: Rule
+
+  constructor(hostRule: Rule, isSlotted: boolean) {
+    this.hostRule = hostRule
+    this.childNodes = hostRule.nodes
+    this.isSlotted = isSlotted
+    this.markedDeep = !!(hostRule as any).__deep
+  }
+
+  markDeep() {
+    ;(this.hostRule as any).__deep = true
+    this.markedDeep = true
+  }
+
+  removeChild(child: ChildNode) {
+    this.hostRule.removeChild(child)
+  }
+
+  prepend(child: ChildNode) {
+    this.hostRule.prepend(child)
+  }
+
+  getHostRule() {
+    return this.hostRule
+  }
+}
 
