 use std::ops::Deref;
 
 use ruff_python_trivia::Cursor;
+use ruff_text_size::{TextLen, TextSize};
+
+/// Cursor over the remaining source of a PEP 723 script comment block.
+pub(crate) struct ScriptTagCursor<'a> {
+    pub(crate) text: &'a str,
+    pub(crate) offset: TextSize,
+    pub(crate) offset_back: TextSize,
+    pub(crate) line_start: TextSize,
+    pub(crate) line_end: TextSize,
+}
+
+impl<'a> ScriptTagCursor<'a> {
+    pub(crate) fn new(text: &'a str, offset: TextSize) -> Self {
+        let text_len = text.text_len();
+        Self {
+            text,
+            offset,
+            offset_back: offset + text_len,
+            line_start: offset,
+            line_end: offset,
+        }
+    }
+}
+
+/// Returns the body of a PEP 723 embedded content line, if `line` is a valid
+/// script-comment line.
+pub(crate) fn script_tag_line_body(line: &str) -> Option<&str> {
+    let mut cursor = Cursor::new(line);
+    if !cursor.eat_char('#') {
+        return None;
+    }
+    if cursor.is_eof() {
+        return Some("");
+    }
+    if !cursor.eat_char(' ') {
+        return None;
+    }
+    Some(cursor.as_str())
+}
 
