+    /**
+     * Apply styles from array to a worksheet cell or range, preserving the
+     * workbook active sheet and the worksheet selection.
+     *
+     * @param array $styleArray Array containing style information
+     */
+    public function applyStylesFromArray(Worksheet $worksheet, string $coordinate, array $styleArray): bool
+    {
+        if ($worksheet->getParent() === null) {
+            return false;
+        }
+
+        $properties = $this->properties;
+        $properties->setCreated($properties->getCreated());
+        $properties->setModified($properties->getModified());
+
+        $activeSheetIndex = $this->activeSheetIndex;
+        $originalSelected = $worksheet->getSelectedCells();
+        $sheetTitle = $worksheet->getTitle();
+        if (!$this->sheetNameExists($sheetTitle)) {
+            $this->getIndex($worksheet);
+        }
+
+        $worksheet->getStyle($coordinate)->applyFromArray($styleArray);
+        $worksheet->restoreSelectedCells($originalSelected);
+        $this->setActiveSheetIndex($activeSheetIndex);
+
+        return true;
+    }
+
