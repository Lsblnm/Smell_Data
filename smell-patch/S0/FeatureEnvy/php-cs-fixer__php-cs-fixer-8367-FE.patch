+    /**
+     * @param array<string, array<string, string>> $uses
+     */
+    public function shortenFollowingName(
+        FullyQualifiedStrictTypesFixer $fixer,
+        int $index,
+        array $uses,
+        string $namespaceName,
+        bool $requireKeyword = true,
+        bool $discoverSymbolsPhase = false
+    ): void {
+        if (!$this->isTokenKindFound(T_STRING) && !$this->isTokenKindFound(T_NS_SEPARATOR)) {
+            return;
+        }
+
+        if ([] === $this->getNamespaceDeclarations()) {
+            return;
+        }
+
+        $token = $this[$index];
+        $tokenId = $token->getId();
+        $tokenContent = $token->getContent();
+
+        if ('' === $tokenContent && null === $tokenId) {
+            return;
+        }
+
+        if ($requireKeyword) {
+            $matchesKeyword = T_NEW === $tokenId || T_INSTANCEOF === $tokenId || CT::T_USE_TRAIT === $tokenId;
+            if (!$matchesKeyword && $discoverSymbolsPhase && \in_array($tokenId, Token::getClassyTokenKinds(), true)) {
+                $matchesKeyword = true;
+            }
+            if (!$matchesKeyword) {
+                return;
+            }
+        }
+
+        $typeStartIndex = null;
+        $typeEndIndex = null;
+        $typeName = '';
+
+        while (true) {
+            $index = $this->getNextMeaningfulToken($index);
+            $current = $this[$index];
+            $currentId = $current->getId();
+
+            if (T_STRING === $currentId || T_NS_SEPARATOR === $currentId) {
+                if (null === $typeStartIndex) {
+                    $typeStartIndex = $index;
+                    $typeName = '';
+                }
+                $typeEndIndex = $index;
+                $typeName .= $current->getContent();
+            } else {
+                if (null !== $typeStartIndex) {
+                    $discoveredSymbols = $fixer->getDiscoveredSymbols();
+                    $reservedIdentifiersByLevel = $fixer->getReservedIdentifiersByLevel();
+
+                    $isReserved = false;
+                    if (!str_contains($typeName, '\\')) {
+                        foreach ($reservedIdentifiersByLevel as $reservedIdentifiers) {
+                            if (isset($reservedIdentifiers[$typeName])) {
+                                $isReserved = true;
+
+                                break;
+                            }
+                        }
+                        if (!$isReserved) {
+                            $isReserved = $fixer->isReservedIdentifier($typeName);
+                        }
+                    }
+
+                    if (null !== $discoveredSymbols) {
+                        if (!$isReserved) {
+                            $fixer->registerDiscoveredSymbol('class', $typeName);
+                        }
+                    } else {
+                        $fixer->refreshUsesCache($uses);
+                        $cacheUseNameByShortNameLower = $fixer->getCacheUseNameByShortNameLower();
+                        $cacheUseShortNameByNameLower = $fixer->getCacheUseShortNameByNameLower();
+                        $configuration = $fixer->getConfiguredOptions();
+
+                        if (str_starts_with($typeName, '\\')) {
+                            $fqcn = substr($typeName, 1);
+                        } elseif ($isReserved) {
+                            $fqcn = $typeName;
+                        } else {
+                            $symbolArr = explode('\\', $typeName, 2);
+                            $shortStartNameLower = strtolower($symbolArr[0]);
+                            if (isset($cacheUseNameByShortNameLower['class'][$shortStartNameLower])) {
+                                $fqcn = $cacheUseNameByShortNameLower['class'][$shortStartNameLower].(isset($symbolArr[1]) ? '\\'.$symbolArr[1] : '');
+                            } else {
+                                $fqcn = ('' !== $namespaceName ? $namespaceName.'\\' : '').$typeName;
+                            }
+                        }
+
+                        $fqcnReserved = $isReserved;
+                        if (!$fqcnReserved && !str_contains($fqcn, '\\')) {
+                            foreach ($reservedIdentifiersByLevel as $reservedIdentifiers) {
+                                if (isset($reservedIdentifiers[$fqcn])) {
+                                    $fqcnReserved = true;
+
+                                    break;
+                                }
+                            }
+                            if (!$fqcnReserved) {
+                                $fqcnReserved = $fixer->isReservedIdentifier($fqcn);
+                            }
+                        }
+
+                        $res = null;
+                        $iMin = 0;
+                        if ($fqcnReserved) {
+                            $res = $fqcn;
+                        } elseif (str_starts_with($fqcn, $namespaceName.'\\')) {
+                            $tmpRes = substr($fqcn, \strlen($namespaceName) + 1);
+                            $tmpResStartLower = strtolower(explode('\\', $tmpRes, 2)[0]);
+                            $tmpResReserved = false;
+                            if (!str_contains($tmpRes, '\\')) {
+                                foreach ($reservedIdentifiersByLevel as $reservedIdentifiers) {
+                                    if (isset($reservedIdentifiers[$tmpRes])) {
+                                        $tmpResReserved = true;
+
+                                        break;
+                                    }
+                                }
+                                if (!$tmpResReserved) {
+                                    $tmpResReserved = $fixer->isReservedIdentifier($tmpRes);
+                                }
+                            }
+                            if (!isset($cacheUseNameByShortNameLower['class'][$tmpResStartLower]) && !$tmpResReserved) {
+                                $res = $tmpRes;
+                                $iMin = substr_count($namespaceName, '\\') + 1;
+                            }
+                        }
+
+                        if (!$fqcnReserved) {
+                        $tmp = $fqcn;
+                        for ($i = substr_count($fqcn, '\\'); $i >= $iMin; --$i) {
+                            $tmpLower = strtolower($tmp);
+                            if (isset($cacheUseShortNameByNameLower['class'][$tmpLower])) {
+                                $tmpRes = $cacheUseShortNameByNameLower['class'][$tmpLower].substr($fqcn, \strlen($tmp));
+                                $tmpResReserved = false;
+                                if (!str_contains($tmpRes, '\\')) {
+                                    foreach ($reservedIdentifiersByLevel as $reservedIdentifiers) {
+                                        if (isset($reservedIdentifiers[$tmpRes])) {
+                                            $tmpResReserved = true;
+
+                                            break;
+                                        }
+                                    }
+                                    if (!$tmpResReserved) {
+                                        $tmpResReserved = $fixer->isReservedIdentifier($tmpRes);
+                                    }
+                                }
+                                if (!$tmpResReserved) {
+                                    $res = $tmpRes;
+
+                                    break;
+                                }
+                            }
+
+                            if ($i > 0) {
+                                $tmp = substr($tmp, 0, strrpos($tmp, '\\'));
+                            }
+                        }
+
+                        if (null === $res) {
+                            $res = $fqcn;
+                            if ('' !== $namespaceName
+                                || true === ($configuration['leading_backslash_in_global_namespace'] ?? false)
+                                || isset($cacheUseNameByShortNameLower['class'][strtolower(explode('\\', $res, 2)[0])])
+                            ) {
+                                $res = '\\'.$res;
+                            }
+                        }
+                        }
+
+                        if ($res !== $typeName) {
+                            $newTokens = [];
+                            $input = $res;
+                            if (str_starts_with($input, '\\')) {
+                                $newTokens[] = new Token([T_NS_SEPARATOR, '\\']);
+                                $input = substr($input, 1);
+                            }
+
+                            $parts = explode('\\', $input);
+                            foreach ($parts as $partIndex => $part) {
+                                $newTokens[] = new Token([T_STRING, $part]);
+                                if ($partIndex !== \count($parts) - 1) {
+                                    $newTokens[] = new Token([T_NS_SEPARATOR, '\\']);
+                                }
+                            }
+
+                            $this->overrideRange($typeStartIndex, $typeEndIndex, $newTokens);
+                        }
+                    }
+                }
+
+                break;
+            }
+        }
+    }
+
