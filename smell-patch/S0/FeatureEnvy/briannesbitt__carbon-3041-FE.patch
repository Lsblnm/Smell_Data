+    public function prepareForReturn(CarbonPeriod $period, CarbonInterface $date): CarbonInterface
+    {
+        $date = ([$period->getDateClass(), 'make'])($date);
+
+        $periodTzName = $period->tzName;
+        $name = $this->getName();
+        $type = $this->getType();
+        $start = $period->getStartDate();
+        $end = $period->getEndDate();
+        $dateTzName = $date->tzName;
+
+        $zone = $this;
+
+        if ($periodTzName !== null && $name !== $periodTzName) {
+            $zone = static::instance($periodTzName) ?? $this;
+        } elseif ($dateTzName === $name) {
+            $zone = $date->getTimezone();
+        } elseif ($type === 3 && $start->tzName === $name) {
+            $zone = $start->getTimezone();
+        } elseif ($end !== null && $end->tzName === $name) {
+            $zone = $end->getTimezone();
+        }
+
