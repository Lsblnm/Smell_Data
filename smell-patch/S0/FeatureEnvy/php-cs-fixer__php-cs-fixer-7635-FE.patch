+    /**
+     * @param array<string, string> $uses
+     *
+     * @return null|array{name: string, startIndex: int, endIndex: int, nullable: bool}
+     */
+    private function analyzeTypeForShortening(TypeAnalysis $type, array $uses, string $namespaceName): ?array
+    {
+        $name = $type->getName();
+        $startIndex = $type->getStartIndex();
+        $endIndex = $type->getEndIndex();
+        $nullable = $type->isNullable();
+
+        if (\in_array(strtolower($name), $type->getReservedTypes(), true)) {
+            return null;
+        }
+
+        if ($startIndex > $endIndex) {
+            return null;
+        }
+
+        if (true === $this->configuration['import_symbols']) {
+            $normalisedName = $this->normaliseSymbolName($name);
+            if (
+                !isset($this->symbolsForImport['class'][$normalisedName])
+                && !str_contains($name, '|')
+                && !str_contains($name, '&')
+            ) {
+                $this->registerSymbolForImport('class', $name, $uses, $namespaceName);
+            }
+        }
+
+        return [
+            'name' => $name,
+            'startIndex' => $startIndex,
+            'endIndex' => $endIndex,
+            'nullable' => $nullable,
+        ];
+    }
