+      unsigned spec_width = detail::to_unsigned(fmt_specs.width);
+      size_t padding = spec_width > 1 ? spec_width - 1 : 0;
+      const auto& fill = fmt_specs.fill;
+      size_t fill_size = fill.size();
+      const char_type* fill_data = fill.data();
+      auto* shifts = detail::data::left_padding_shifts;
+      size_t left_padding = padding >> shifts[fmt_specs.align];
+      auto it = detail::reserve(this->out_, 1 + padding * fill_size);
+      if (fill_size == 1) {
+        it = std::fill_n(it, left_padding, fill_data[0]);
+        *it++ = static_cast<char_type>(value);
+        it = std::fill_n(it, padding - left_padding, fill_data[0]);
+      } else {
+        for (size_t i = 0; i < left_padding; ++i)
+          it = std::copy_n(fill_data, fill_size, it);
+        *it++ = static_cast<char_type>(value);
+        for (size_t i = 0; i < padding - left_padding; ++i)
+          it = std::copy_n(fill_data, fill_size, it);
+      }
+      this->out_ = detail::base_iterator(this->out_, it);
+      return this->out_;
     } else {
