+      // This is [Document 1](doc1.md)
+      // [doc1]: doc1.md
+      const mdRegex =
+        /(?:\]\(|\]:\s*)(?!https?:\/\/|@site\/)<?(?<filename>[^'"\]\s>]+(?:\s[^'"\]\s>]+)*\.mdx?)>?/g;
