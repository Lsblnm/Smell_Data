+/** Site directory plus helpers for turning filesystem paths into `@site/` aliases. */
+export class SitePathRef {
+  readonly siteDir: string;
+
+  constructor(siteDir: string) {
+    this.siteDir = siteDir;
+  }
+
+  alias(filePath: string): string {
+    return aliasedSitePath(filePath, this.siteDir);
+  }
