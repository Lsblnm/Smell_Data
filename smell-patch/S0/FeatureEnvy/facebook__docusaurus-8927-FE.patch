+          .map((resolvedSource) => source.sitePath.alias(resolvedSource))
+          .find((resolvedSource) => source.sourceToPermalink[resolvedSource]);
+
+        const permalink: string | undefined = aliasedSourceMatch
+          ? source.sourceToPermalink[aliasedSourceMatch]
+          : undefined;
+
+        if (permalink) {
