@@ -2,6 +2,12 @@
 
 module Faker
   class String < Base
+    LOWERCASE_CHARACTERS = Alphanumeric::LOWER_CHARS
+    UPPERCASE_CHARACTERS = Alphanumeric::UPPER_CHARS
+    SYMBOL_CHARACTERS = %w[! @ # $ % ^ & *].freeze
