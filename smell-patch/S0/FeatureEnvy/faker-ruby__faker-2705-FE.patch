index b1a60faa..c28bdbf9 100644
--- a/lib/faker/default/types.rb
+++ b/lib/faker/default/types.rb
@@ -5,6 +5,8 @@ module Faker
     CHARACTERS = ('0'..'9').to_a + ('a'..'z').to_a
     SIMPLE_TYPES = %i[string fixnum].freeze
     COMPLEX_TYPES = %i[hash array].freeze
+    PASSWORD_MIX_CASE_OVERHEAD = 2
+    PASSWORD_SPECIAL_OVERHEAD = 1
 
     class << self
       ##
@@ -38,6 +40,55 @@ module Faker
         sample(CHARACTERS)
       end
 
+      ##
+      # Builds a randomized string of characters suitable for passwords.
+      #
+      # @return [String]
+      def password(min_length: 8, max_length: 16, mix_case: true, special_characters: false)
+        raise ArgumentError, 'max_length must be more than min_length' if max_length < min_length
+
+        character_types = []
+        required_min_length = 0
+
+        if mix_case
+          character_types << Faker::String::MIX_CASE_TOKEN
+          required_min_length += PASSWORD_MIX_CASE_OVERHEAD
+        end
+
+        if special_characters
+          character_types << Faker::String::SPECIAL_TOKEN
+          required_min_length += PASSWORD_SPECIAL_OVERHEAD
+        end
+
+        raise ArgumentError, "min_length should be at least #{required_min_length} to enable #{character_types.join(', ')} configuration" if min_length < required_min_length
+
+        target_length = rand(min_length..max_length)
+
+        password = []
+        character_bag = []
+
+        # use lower_chars by default and add upper_chars if mix_case
+        lower_chars = Faker::String::LOWERCASE_CHARACTERS
+        password << lower_chars[rand(lower_chars.count - 1)]
+        character_bag += lower_chars
+
+        if character_types.include?(Faker::String::MIX_CASE_TOKEN)
+          upper_chars = Faker::String::UPPERCASE_CHARACTERS
+          password << upper_chars[rand(upper_chars.count - 1)]
+          character_bag += upper_chars
+        end
+
+        if character_types.include?(Faker::String::SPECIAL_TOKEN)
+          special_chars = Faker::String::SYMBOL_CHARACTERS
+          password << special_chars[rand(special_chars.count - 1)]
+          character_bag += special_chars
+        end
+
+        password << character_bag[rand(character_bag.count - 1)] while password.length < target_length
+
+        shuffle(password).join
+      end
+
       ##
       # Produces a random integer.
       #
