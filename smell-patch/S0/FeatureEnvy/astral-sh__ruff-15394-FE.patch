@@ -786,6 +786,23 @@ impl<'a> SimpleTokenizer<'a> {
     pub fn skip_trivia(self) -> impl Iterator<Item = SimpleToken> + 'a {
         self.filter(|t| !t.kind().is_trivia())
     }
+
+    pub const fn current_offset(&self) -> TextSize {
+        self.offset
+    }
+
+    pub const fn is_bogus(&self) -> bool {
+        self.bogus
+    }
+
+    pub const fn source_text(&self) -> &'a str {
+        self.source
+    }
+
+    /// Remaining unconsumed source after the current offset.
+    pub fn rest(&self) -> &'a str {
+        self.cursor.as_str()
+    }
