+      def retry_limit_reached?
+        retry_state = @retry
+        config = @buffer_config
+        return false if retry_state.forever
+        deadline = retry_state.start + config.retry_timeout
+        time_exceeded = retry_state.next_time >= deadline
+        max_steps = retry_state.max_steps
+        steps_exceeded = !!(max_steps && retry_state.steps >= max_steps)
+        time_exceeded || steps_exceeded
+      end
