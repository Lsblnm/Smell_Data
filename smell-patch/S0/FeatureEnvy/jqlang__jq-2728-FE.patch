 static int options = 0;
+static int dumpopts;
+
+int jq_set_colors(const char *c) {
+  struct jv_color_palette *palette = jv_color_palette();
+  const char *e;
+  size_t i;
+
+  if (options & COLOR_OUTPUT)
+    dumpopts |= JV_PRINT_COLOR;
+  if (options & NO_COLOR_OUTPUT)
+    dumpopts &= ~JV_PRINT_COLOR;
+
+  if (c == NULL)
+    return 1;
+
+  palette->active = palette->defaults;
+  memset(palette->bufs, 0, sizeof(palette->bufs));
+  for (i = 0; i < palette->slot_count; i++)
+    palette->bufps[i] = palette->defaults[i];
+  if (!jvp_utf8_is_valid(c, c + strlen(c)))
+    return 0;
+  for (i = 0; i < palette->slot_count && *c != '\0'; i++, c = e) {
+    if ((e = strchr(c, ':')) == NULL)
+      e = c + strlen(c);
+    if ((size_t)(e - c) > sizeof(palette->bufs[i]) - 4 /* ESC [ m NUL */)
+      return 0;
+    palette->bufs[i][0] = palette->reset[0];
+    palette->bufs[i][1] = palette->reset[1];
+    (void) strncpy(&palette->bufs[i][2], c, e - c);
+    if (strspn(&palette->bufs[i][2], "0123456789;") < strlen(&palette->bufs[i][2]))
+      return 0;
+    palette->bufs[i][2 + (e - c)] = 'm';
+    palette->bufps[i] = palette->bufs[i];
+    if (e[0] == ':')
+      e++;
+  }
+  palette->active = palette->bufps;
+  return 1;
+}
 
