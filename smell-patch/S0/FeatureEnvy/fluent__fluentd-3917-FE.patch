           end
+        ensure
+          @current_path = saved_path
+        end
+
+        def eval_include(source, attrs = nil, elems = nil, uri = nil)
+          if source.respond_to?(:include_basepath)
+            parser = source
+            loader_context = @context
+            parser_context = parser.eval_context
+            nested_ctx = parser_context.nil? ? loader_context : parser_context
+            parent_ss = parser.ss
+            parent_logger = parser.logger
+            parent_fname = parser.fname
+            parent_base = parser.include_basepath
+            @current_path = @current_path || parent_fname
+
+            # replace space(s)(' ') with '+' to prevent invalid uri due to space(s).
+            # See: https://github.com/fluent/fluentd/pull/2780#issuecomment-576081212
+            u = URI.parse(uri.gsub(/ /, '+'))
+            if u.scheme == 'file' || (!u.scheme.nil? && u.scheme.length == 1) || u.path == uri.gsub(/ /, '+') # file path
+              # When the Windows absolute path then u.scheme.length == 1
+              # e.g. C:
+              path = URI.decode_www_form_component(u.path)
+              if path[0] != ?/
+                pattern = File.expand_path("#{parent_base}/#{path}")
+              else
+                pattern = path
+              end
+              Dir.glob(pattern).sort.each { |entry|
+                basepath = File.dirname(entry)
+                fname = File.basename(entry)
+                fname = parent_fname if fname.nil? || fname.empty?
+                data = File.read(entry)
+                data.force_encoding('UTF-8')
+                ss = parent_ss.class.new(data)
+                nested = parser.class.new(ss, basepath, fname, nested_ctx)
+                nested.instance_variable_set(:@logger, parent_logger)
+                nested.parse_element(true, nil, attrs, elems)
+              }
+            else
+              require 'open-uri'
+              basepath = '/'
+              fname = path
+              data = URI.open(uri) { |f| f.read }
+              data.force_encoding('UTF-8')
+              ss = parent_ss.class.new(data)
+              nested = parser.class.new(ss, basepath, fname, nested_ctx)
+              nested.instance_variable_set(:@logger, parent_logger)
+              nested.parse_element(true, nil, attrs, elems)
+            end
+          else
+            load(@current_path.parent.join(source))
+          end
+        rescue SystemCallError => e
+          if source.respond_to?(:include_basepath)
+            cpe = ConfigParseError.new("include error #{uri} - #{e}")
+            cpe.set_backtrace(e.backtrace)
+            raise cpe
+          else
+            raise
+          end
         end
 
         class Visitor < Psych::Visitors::ToRuby
