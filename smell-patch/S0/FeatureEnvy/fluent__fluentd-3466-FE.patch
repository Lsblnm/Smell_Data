diff --git a/lib/fluent/plugin/in_tail/position_file.rb b/lib/fluent/plugin/in_tail/position_file.rb
index d00ecd31..cb2b2554 100644
--- a/lib/fluent/plugin/in_tail/position_file.rb
+++ b/lib/fluent/plugin/in_tail/position_file.rb
@@ -264,6 +264,40 @@ module Fluent::Plugin
         return false unless other.is_a?(TargetInfo)
         self.path == other.path
       end
+
+      # refresh_watchers calls tails.keys so we don't use stop_watcher -> start_watcher sequence for safety.
+      def update_watcher(input, pe)
+        input.log.info("detected rotation of #{path}; waiting #{input.rotate_wait} seconds")
+
+        pf = input.instance_variable_get(:@pf)
+        tails = input.instance_variable_get(:@tails)
+
+        if pf
+          pe_inode = pe.read_inode
+          target_info_from_position_entry = TargetInfo.new(path, pe_inode)
+          unless pe_inode == pf[target_info_from_position_entry].read_inode
+            input.log.debug "Skip update_watcher because watcher has been already updated by other inotify event"
+            return
+          end
+        end
+
+        rotated_target_info = TargetInfo.new(path, pe.read_inode)
+        rotated_tw = tails[rotated_target_info]
+        new_target_info = TargetInfo.new(path, ino)
+
+        if input.follow_inodes
+          new_position_entry = pf[self]
+
+          if new_position_entry.read_inode == 0
+            tails[new_target_info] = input.setup_watcher(new_target_info, new_position_entry)
+            tails[new_target_info].on_notify
+          end
+        else
+          tails[new_target_info] = input.setup_watcher(new_target_info, pe)
+          tails[new_target_info].on_notify
+        end
+        input.detach_watcher_after_rotate_wait(rotated_tw, pe.read_inode) if rotated_tw
+      end
     end
