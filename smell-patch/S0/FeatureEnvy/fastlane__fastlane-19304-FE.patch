diff --git a/fastlane_core/lib/fastlane_core/command_executor.rb b/fastlane_core/lib/fastlane_core/command_executor.rb
index e95db7b8e..a5ced2a50 100644
--- a/fastlane_core/lib/fastlane_core/command_executor.rb
+++ b/fastlane_core/lib/fastlane_core/command_executor.rb
@@ -5,6 +5,48 @@ require_relative 'fastlane_pty'
 module FastlaneCore
   # Executes commands and takes care of error handling and more
   class CommandExecutor
+    attr_reader :verbose, :output_path
+
+    def initialize(verbose: nil, output_path: nil)
+      @verbose = verbose
+      @output_path = output_path
+    end
+
+    def zip_command(runner)
+      zip_options = verbose ? "r" : "rq"
+      zip_options += "y" if runner.symlinks
+
+      command = ["zip", "-#{zip_options}"]
+
+      if runner.password
+        command << "-P"
+        command << runner.password
+      end
+
+      # The zip command is executed from the paths **parent** directory, as a result we use just the basename, which is the file or folder within
+      basename = File.basename(runner.path)
+
+      command << output_path
+      command << basename
+
+      unless runner.include.empty?
+        command << "-i"
+        command += runner.include.map { |path| File.join(basename, path) }
+      end
+
+      unless runner.exclude.empty?
+        command << "-x"
+        command += runner.exclude.map { |path| File.join(basename, path) }
+      end
+
+      # The 'zip' command archives relative to the working directory, chdir to produce expected results relative to `path`
+      Dir.chdir(File.expand_path("..", runner.path)) do
+        Fastlane::Actions.sh(*command)
+      end
+
+      command
+    end
+
     class << self
       # Cross-platform way of finding an executable in the $PATH. Respects the $PATHEXT, which lists
       # valid file extensions for executables on Windows.
