diff --git a/internal/sockets.go b/internal/sockets.go
index 56ae9f4e..f3d778ce 100644
--- a/internal/sockets.go
+++ b/internal/sockets.go
@@ -15,12 +15,48 @@
 package internal
 
 import (
+	"encoding/json"
 	"fmt"
 	"io/fs"
 	"strconv"
 	"strings"
 )
 
+// ConfigAccess holds the parameters and decoded payload for a
+// low-level mutation of Caddy's raw JSON configuration tree.
+type ConfigAccess struct {
+	Method   string
+	Path     string
+	Body     []byte
+	Value    any
+	Parts    []string
+	Ellipses bool
+}
+
+// Prepare decodes the request body and splits the config path
+// into traversable segments used by the admin API.
+func (ca *ConfigAccess) Prepare() error {
+	if len(ca.Body) > 0 {
+		if err := json.Unmarshal(ca.Body, &ca.Value); err != nil {
+			return fmt.Errorf("decoding request body: %v", err)
+		}
+	}
+	cleanPath := strings.Trim(ca.Path, "/")
+	if cleanPath == "" {
+		return fmt.Errorf("no traversable path")
+	}
+	parts := strings.Split(cleanPath, "/")
+	if len(parts) == 0 {
+		return fmt.Errorf("path missing")
+	}
+	if parts[len(parts)-1] == "..." {
+		ca.Ellipses = true
+		parts = parts[:len(parts)-1]
+	}
+	ca.Parts = parts
+	return nil
+}
+
 // SplitUnixSocketPermissionsBits takes a unix socket address in the
 // unusual "path|bits" format (e.g. /run/caddy.sock|0222) and tries
 // to split it into socket path (host) and permissions bits (port).
