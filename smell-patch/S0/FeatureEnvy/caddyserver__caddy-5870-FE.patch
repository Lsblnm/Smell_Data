+type configAccessRequest struct {
+	data *configAccessData
+}
+
+func newConfigAccessRequest(method, path string, body []byte) (*configAccessRequest, error) {
+	d := &configAccessData{}
+	if err := d.populate(method, path, body); err != nil {
+		return nil, err
+	}
+	return &configAccessRequest{data: d}, nil
+}
+
+func (r *configAccessRequest) Method() string { return r.data.Method() }
+
+func (r *configAccessRequest) Path() string { return r.data.Path() }
+
+func (r *configAccessRequest) Value() any { return r.data.Value() }
+
+func (r *configAccessRequest) Parts() []string { return r.data.Parts() }
+
+func (r *configAccessRequest) Ellipses() bool { return r.data.Ellipses() }
