+    /**
+     * Walk toward a leaf, recording each level of children on the given iterator.
+     */
+    private void fillStackToLeaf(PostOrderIterator iterator) {
+        Node current = this;
+        while (true) {
+            List<Node> children;
+            if (current instanceof CompilationUnit) {
+                CompilationUnit compilationUnit = (CompilationUnit) current;
+                children = new ArrayList<>();
+                compilationUnit.getPackageDeclaration().ifPresent(children::add);
+                children.addAll(compilationUnit.getImports());
+                children.addAll(compilationUnit.getTypes());
+                compilationUnit.getModule().ifPresent(children::add);
+            } else {
+                children = new ArrayList<>();
+                for (Node child : current.getChildNodes()) {
+                    if (child.getParentNode().orElse(null) == current) {
+                        children.add(child);
+                    }
+                }
+            }
+            if (children.isEmpty()) {
+                break;
+            }
+            iterator.nodesStack.push(children);
+            iterator.cursorStack.push(0);
+            current = children.get(0);
+        }
+    }
