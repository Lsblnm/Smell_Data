index 8c8fb2ef91..977bb57790 100755
--- a/src/Illuminate/Support/MessageBag.php
+++ b/src/Illuminate/Support/MessageBag.php
@@ -66,6 +66,89 @@ public function add($key, $message)
         return $this;
     }
 
+    /**
+     * Get the inline message for a rule if it exists.
+     *
+     * @param  \Illuminate\Validation\Validator  $validator
+     * @param  string  $attribute
+     * @param  string  $lowerRule
+     * @param  array|null  $source
+     * @return string|null
+     */
+    public function getFromLocalArray($validator, $attribute, $lowerRule, $source = null)
+    {
+        $customMessages = $validator->customMessages;
+        $fallbackMessages = $validator->fallbackMessages;
+        $customAttributes = $validator->customAttributes;
+        $data = $validator->getData();
+        $rules = $validator->getRules();
+        $translator = $validator->getTranslator();
+
+        if ($translator instanceof \Illuminate\Translation\Translator) {
+            $translator->load('*', '*', $translator->getLocale());
+        }
+
+        $source = $source ?: $customMessages;
+
+        $keys = ["{$attribute}.{$lowerRule}", $lowerRule, $attribute];
+        $related = [];
+
+        if (array_key_exists($attribute, $customAttributes)) {
+            $related[] = $attribute;
+        }
+
+        if (array_key_exists($attribute, $data) || array_key_exists($attribute, $rules)) {
+            $related[] = "{$attribute}.{$lowerRule}";
+        }
+
+        if (array_key_exists($attribute, $fallbackMessages) || array_key_exists($lowerRule, $fallbackMessages)) {
+            $related[] = $lowerRule;
+        }
+
+        if (array_key_exists($attribute, $this->messages)) {
+            $related[] = $attribute;
+        }
+
+        if ($this->format !== '') {
+            $related[] = $lowerRule;
+        }
+
+        $keys = array_values(array_unique(array_merge($keys, $related)));
+
+        // First we will check for a custom message for an attribute specific rule
+        // message for the fields, then we will check for a general custom line
+        // that is not attribute specific. If we find either we'll return it.
+        foreach ($keys as $key) {
+            foreach (array_keys($source) as $sourceKey) {
+                if (str_contains($sourceKey, '*')) {
+                    $pattern = str_replace('\*', '([^.]*)', preg_quote($sourceKey, '#'));
+
+                    if (preg_match('#^'.$pattern.'\z#u', $key) === 1) {
+                        $message = $source[$sourceKey];
+
+                        if (is_array($message) && isset($message[$lowerRule])) {
+                            return $message[$lowerRule];
+                        }
+
+                        return $message;
+                    }
+
+                    continue;
+                }
+
+                if (Str::is($sourceKey, $key)) {
+                    $message = $source[$sourceKey];
+
+                    if ($sourceKey === $attribute && is_array($message) && isset($message[$lowerRule])) {
+                        return $message[$lowerRule];
+                    }
+
+                    return $message;
+                }
+            }
+        }
+    }
+
