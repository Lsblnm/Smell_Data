+/**
+ * @param {null} empty
+ * @param {string} fnType
+ */
+function RefHost(empty, fnType) {
+	this._empty = empty;
+	this._fnType = fnType;
+}
+
+/**
+ * Invoke or update a ref, depending on whether it is a function or object ref.
+ * @param {Ref<any>} ref
+ * @param {any} value
+ * @param {VNode} vnode
+ */
+RefHost.prototype.applyRef = function (ref, value, vnode) {
+	try {
+		if (
+			value != this._empty &&
+			vnode != null &&
+			vnode.constructor === undefined
+		) {
+			if (
+				typeof vnode.type == this._fnType &&
+				vnode._component != this._empty
+			) {
+				value = vnode._component;
+			} else if (vnode._dom != this._empty) {
+				value = vnode._dom;
+			}
+		}
+
+		if (typeof ref == 'function') ref(value);
+		else ref.current = value;
+	} catch (e) {
+		options._catchError(e, vnode);
+	}
+};
+
+export const refHost = new RefHost(null, 'function');
+
 export function Fragment(props) {
 	return props.children;
 }
