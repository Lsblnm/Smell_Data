+CatchErrorHost.prototype._catchError = function (
+	error,
+	vnode,
+	oldVNode,
+	errorInfo
+) {
+	/** @type {Component} */
+	let component,
+		/** @type {ComponentType} */
+		ctor;
+
+	this._error = error;
+	this._handled = false;
+
+	for (; (vnode = vnode._parent); ) {
+		if (
+			typeof vnode.type == 'function' &&
+			(component = vnode._component) &&
+			!component._processingException
