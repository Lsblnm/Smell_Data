diff --git a/lib/fpm/package/deb.rb b/lib/fpm/package/deb.rb
index 93d9e4d..94c519b 100644
--- a/lib/fpm/package/deb.rb
+++ b/lib/fpm/package/deb.rb
@@ -652,6 +652,41 @@ class FPM::Package::Deb < FPM::Package
     end # if deb_generate_changes
   end # def output
 
+  def output_check(output_path, package = self)
+    if instance_variable_defined?(:@name) && !@name.nil?
+      debian_name = name
+      debian_architecture = architecture
+    else
+      debian_name = nil
+      debian_architecture = nil
+    end
+
+    package_version = package.version
+    package_epoch = package.epoch
+    package_iteration = package.iteration
+    package_provides = package.provides
+    force_overwrite = package.attributes[:force?]
+
+    identity = package_version.to_s
+    identity = "#{package_epoch}:#{identity}" unless package_epoch.nil? || package_epoch.to_s.empty?
+    identity = "#{identity}-#{package_iteration}" unless package_iteration.nil? || package_iteration.to_s.empty?
+    provides_note = package_provides.nil? || package_provides.empty? ? "" : " provides=#{package_provides.inspect}"
+    debian_note = debian_name.nil? ? "" : " name=#{debian_name} arch=#{debian_architecture}"
+    logger.debug("Checking output destination for #{identity}#{provides_note}#{debian_note}", :path => output_path)
+
+    if !File.directory?(File.dirname(output_path))
+      raise ParentDirectoryMissing.new(output_path)
+    end
+    if File.file?(output_path)
+      if force_overwrite
+        logger.warn("Force flag given. Overwriting package at #{output_path}")
+        File.delete(output_path)
+      else
+        raise FileAlreadyExists.new(output_path)
+      end
+    end
+  end # def output_check
+
