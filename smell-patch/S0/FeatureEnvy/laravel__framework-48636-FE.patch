+    /**
+     * Set the where clause for a belongs-to-many relation query.
+     *
+     * @param  \Illuminate\Database\Eloquent\Relations\BelongsToMany  $relation
+     * @return \Illuminate\Database\Eloquent\Relations\BelongsToMany
+     */
+    public function addWhereConstraints($relation)
+    {
+        $parent = $relation->getParent();
+        $keyName = $relation->getParentKeyName();
+
+        $value = $keyName === $this->getKeyName()
+            ? $this->getKey()
+            : $this->getAttribute($keyName);
+
+        if ($parent !== $this) {
+            $value = $parent->getAttribute($keyName);
+        }
+
+        $foreignPivotKey = $relation->getForeignPivotKeyName();
+        $table = $relation->getTable();
+        $qualified = str_contains($foreignPivotKey, '.')
+            ? $foreignPivotKey
+            : $table.'.'.$foreignPivotKey;
+
+        $relation->getQuery()->where($qualified, '=', $value);
+
+        return $relation;
+    }
+
