+	Map<JCTree, JCTree> resolveMethodMember(JavacNode node) {
+		this.currentNode = node;
+		this.resolution = new JavacResolution(node.getContext());
+
+		ArrayDeque<JCTree> stack = new ArrayDeque<JCTree>();
+		JavacNode current = this.currentNode;
+		while (current != null) {
+			stack.push(current.get());
+			current = current.up();
+		}
+
+		CompilerMessageSuppressor suppressor = this.resolution.getMessageSuppressor();
+		suppressor.disableLoggers();
+		try {
+			JavacResolution.EnvFinder finder = new JavacResolution.EnvFinder(this.currentNode.getContext());
+			while (!stack.isEmpty()) stack.pop().accept(finder);
+
+			TreeMirrorMaker mirrorMaker = new TreeMirrorMaker(this.currentNode.getTreeMaker(), this.currentNode.getContext());
+			JCTree copy = mirrorMaker.copy(finder.copyAt());
+			Log log = Log.instance(this.currentNode.getContext());
+			JavaFileObject oldFileObject = log.useSource(((JCCompilationUnit) this.currentNode.top().get()).getSourceFile());
+			try {
+				this.resolution.memberEnterAndAttribute(copy, finder.get(), this.currentNode.getContext());
+				return mirrorMaker.getOriginalToCopyMap();
+			} finally {
+				log.useSource(oldFileObject);
+			}
+		} finally {
+			suppressor.enableLoggers();
+		}
+	}
 }
