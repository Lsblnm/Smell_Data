+    pub fn from_ls_metadata(
+        path: impl Into<PathBuf>,
+        metadata: Option<&std::fs::Metadata>,
+        tag: Span,
+    ) -> Self {
+        let path = path.into();
+        match metadata {
+            Some(md) => FileInfo {
+                path,
+                size: md.len(),
+                blocks: None,
+                tag,
+                readonly: md.permissions().readonly(),
+                modified: md.modified().ok(),
+                is_symlink: md.file_type().is_symlink(),
+                is_dir: md.is_dir(),
+                is_file: md.is_file(),
+            },
+            None => FileInfo {
+                path,
+                size: 0,
+                blocks: None,
+                tag,
+                readonly: false,
+                modified: None,
+                is_symlink: false,
+                is_dir: false,
+                is_file: false,
+            },
+        }
+    }
+
