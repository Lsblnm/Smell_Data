+fn apparent_dir_size(filename: &Path, span: Span, signals: &Signals) -> Result<u64, ShellError> {
+    let params = DirBuilder::new(Span::new(0, 2), None, false, None, false);
+    Ok(DirInfo::new(filename, &params, None, span, signals)?.get_size())
+}
