 /**
  * A factory to generate CarbonImmutable instances with common settings.
@@ -240,4 +242,66 @@ use Closure;
 class FactoryImmutable extends Factory
 {
     protected $className = CarbonImmutable::class;
+
+    /**
+     * Get a present-time instance using this factory's class and settings.
+     *
+     * @param DateTimeZone|string|int|null $tz
+     *
+     * @throws InvalidFormatException
+     *
+     * @return CarbonInterface
+     */
+    public function createNowInstance($tz = null)
+    {
+        $className = $this->className;
+        $settings = $this->settings;
+
+        if ($tz !== null && !$tz instanceof DateTimeZone) {
+            $safeTz = CarbonTimeZone::instance($tz);
+
+            if ($safeTz !== false) {
+                $tz = $safeTz;
+            }
+        }
+
+        try {
+            if (!$className::hasTestNow()) {
+                $now = $className::now($tz);
+            } else {
+                $now = $className::getTestNow();
+
+                if ($now instanceof Closure) {
+                    $now = $now($className::now($tz));
+                } else {
+                    $now = $now->avoidMutation()->tz($tz);
+                }
+            }
+        } catch (InvalidFormatException $exception) {
+            throw $exception;
+        }
+
+        if ($now instanceof CarbonInterface) {
+            $locale = $now->locale;
+            $now = $now->setDateTime(
+                $now->year,
+                $now->month,
+                $now->day,
+                $now->hour,
+                $now->minute,
+                (int) $now->rawFormat('s'),
+                (int) $now->rawFormat('u')
+            );
+
+            if ($locale && $now->locale !== $locale) {
+                $now = $now->locale($locale);
+            }
+
+            if ($settings) {
+                $now = $now->settings($settings);
+            }
+        }
+
+        return $now;
+    }
 }
