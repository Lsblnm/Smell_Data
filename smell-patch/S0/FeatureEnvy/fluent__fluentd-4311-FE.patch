+require 'fileutils'
+
 require 'fluent/configurable'
+require 'fluent/config'
 require 'fluent/config/element'
+require 'fluent/log'
 
 module Fluent
   class SystemConfig
@@ -165,6 +169,79 @@ module Fluent
       end
     end
 
+    def setup_global_logger(supervisor, supervisor_mode: false)
+      if supervisor_mode
+        worker_id = 0
+        process_type = :supervisor
+      else
+        worker_id = ENV['SERVERENGINE_WORKER_ID'].to_i
+        process_type = case
+                       when supervisor.standalone_worker then :standalone
+                       when worker_id == 0 then :worker0
+                       else :workers
+                       end
+      end
+
+      conf = Fluent::Config.build(**supervisor.config_build_options)
+      loaded = supervisor.prepared_system_config(conf)
+
+      supervisor.log_rotate_age ||= loaded.log.rotate_age
+      supervisor.log_rotate_size ||= loaded.log.rotate_size
+
+      rotate = supervisor.log_rotate_age || supervisor.log_rotate_size
+      actual_log_path = supervisor.log_path
+
+      if Fluent.windows? && rotate && supervisor.log_path && supervisor.log_path != "-"
+        actual_log_path = Fluent::Log.per_process_path(supervisor.log_path, process_type, worker_id)
+      end
+
+      if actual_log_path && actual_log_path != "-"
+        FileUtils.mkdir_p(File.dirname(actual_log_path)) unless File.exist?(actual_log_path)
+        if rotate
+          logdev = Fluent::LogDeviceIO.new(
+            actual_log_path,
+            shift_age: supervisor.log_rotate_age,
+            shift_size: supervisor.log_rotate_size,
+          )
+        else
+          logdev = File.open(actual_log_path, "a")
+        end
+
+        supervisor.apply_log_path_owner(actual_log_path)
+
+        if loaded.dir_permission
+          File.chmod(loaded.dir_permission || Fluent::DEFAULT_DIR_PERMISSION, File.dirname(actual_log_path))
+        end
+      else
+        logdev = STDOUT
+      end
+
+      $log = Fluent::Log.new(
+        ServerEngine::DaemonLogger.new(logdev, log_level: loaded.log_level - 1),
+        path: actual_log_path,
+        process_type: process_type,
+        worker_id: worker_id,
+        format: loaded.log.format,
+        **loaded.logger_runtime_options
+      )
+      $log.enable_color(false) if actual_log_path
+      $log.enable_debug if loaded.log_level <= Fluent::Log::LEVEL_DEBUG
+
+      $log.info "init #{process_type} logger",
+                path: actual_log_path,
+                rotate_age: supervisor.log_rotate_age,
+                rotate_size: supervisor.log_rotate_size
+    end
+
+    def logger_runtime_options
+      {
+        time_format: @log.time_format,
+        suppress_repeated_stacktrace: @suppress_repeated_stacktrace,
+        ignore_repeated_log_interval: @ignore_repeated_log_interval,
+        ignore_same_log_interval: @ignore_same_log_interval,
+      }
+    end
+
