diff --git a/lib/fluent/plugin/out_forward/ack_handler.rb b/lib/fluent/plugin/out_forward/ack_handler.rb
index 362117b9..9ca39155 100644
--- a/lib/fluent/plugin/out_forward/ack_handler.rb
+++ b/lib/fluent/plugin/out_forward/ack_handler.rb
@@ -79,6 +79,35 @@ module Fluent::Plugin
         end
       end
 
+      def ack_check(output, select_interval)
+        return unless output.require_ack_response
+
+        timeout_bound = [output.delayed_commit_timeout, output.ack_response_timeout, @timeout].compact.min
+        interval = select_interval
+        interval = timeout_bound if timeout_bound && interval && timeout_bound < interval
+        @log.debug 'waiting ack responses', timeout: @timeout, interval: interval, keepalive: output.keepalive
+
+        collect_response(interval) do |chunk_id, node, sock, result|
+          output.connection_manager.close(sock)
+
+          case result
+          when Result::SUCCESS
+            output.commit_write(chunk_id)
+          when Result::FAILED
+            node.disable!
+            output.rollback_write(chunk_id, update_retry: false)
+          when Result::CHUNKID_UNMATCHED
+            output.rollback_write(chunk_id, update_retry: false)
+          else
+            @log.warn("BUG: invalid status #{result} #{chunk_id}")
+
+            if chunk_id
+              output.rollback_write(chunk_id, update_retry: false)
+            end
+          end
+        end
+      end
+
       ACKWaitingSockInfo = Struct.new(:sock, :chunk_id, :chunk_id_base64, :node, :expired_time) do
         def expired?(now)
           expired_time < now
