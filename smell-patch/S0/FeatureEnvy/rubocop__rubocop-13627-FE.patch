diff --git a/lib/rubocop/cop/style/multiple_comparison.rb b/lib/rubocop/cop/style/multiple_comparison.rb
index 2387e38c4..ec2dd210d 100644
--- a/lib/rubocop/cop/style/multiple_comparison.rb
+++ b/lib/rubocop/cop/style/multiple_comparison.rb
@@ -152,6 +152,36 @@ module RuboCop
         def comparisons_threshold
           cop_config.fetch('ComparisonsThreshold', 2)
         end
+
+        public
+
+        def expand_if_then(node, extra_indentation, line_indent = nil)
+          column = node.source_range.column
+          column += (@current_offset || 0) if @processed_source
+          line_indent = ' ' * column if line_indent.nil?
+          body_indent = ' ' * extra_indentation
+
+          if_branch_source = node.if_branch&.source || 'nil'
+          elsif_indent = line_indent if node.respond_to?(:elsif?) && node.elsif?
+
+          rendered = <<~RUBY
+            #{elsif_indent}#{node.keyword} #{node.condition.source}
+            #{line_indent}#{body_indent}#{if_branch_source}
+          RUBY
+
+          else_branch = node.else_branch
+          rendered + if else_branch.nil?
+                       'end'
+                     elsif else_branch.if_type? && else_branch.elsif?
+                       expand_if_then(else_branch, extra_indentation, line_indent)
+                     else
+                       <<~RUBY.chomp
+                         #{line_indent}else
+                         #{line_indent}#{body_indent}#{else_branch.source}
+                         #{line_indent}end
+                       RUBY
+                     end
+        end
       end
     end
   end
