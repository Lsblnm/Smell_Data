diff --git a/src/locfile.c b/src/locfile.c
index 7415ab7..ecc15a2 100644
--- a/src/locfile.c
+++ b/src/locfile.c
@@ -7,6 +7,7 @@
 #include "jq.h"
 #include "jv_alloc.h"
 #include "locfile.h"
+#include "compile.h"
 
 
 struct locfile* locfile_init(jq_state *jq, const char *fname, const char* data, int length) {
@@ -90,3 +91,69 @@ void locfile_locate(struct locfile* l, location loc, const char* fmt, ...) {
   jq_report_error(l->jq, m2);
   return;
 }
+
+block gen_cond(block cond, block iftrue, block iffalse) {
+  struct locfile *srcfile = NULL;
+  inst *cursor;
+
+  for (cursor = cond.first; cursor; cursor = cursor->next) {
+    if (cursor->locfile) {
+      srcfile = cursor->locfile;
+      break;
+    }
+  }
+  if (srcfile == NULL) {
+    for (cursor = iftrue.first; cursor; cursor = cursor->next) {
+      if (cursor->locfile) {
+        srcfile = cursor->locfile;
+        break;
+      }
+    }
+  }
+  if (srcfile == NULL) {
+    for (cursor = iffalse.first; cursor; cursor = cursor->next) {
+      if (cursor->locfile) {
+        srcfile = cursor->locfile;
+        break;
+      }
+    }
+  }
+  if (srcfile)
+    srcfile = locfile_retain(srcfile);
+
+  block cond_exp;
+  if (cond.first == NULL && cond.last == NULL) {
+    cond_exp = gen_op_simple(DUP);
+  } else if (cond.first != NULL && cond.first == cond.last &&
+             cond.first->op == LOADK) {
+    jv constant = jv_copy(cond.first->imm.constant);
+    block_free(cond);
+    cond_exp = gen_op_pushk_under(constant);
+  } else {
+    cond_exp = BLOCK(gen_op_simple(SUBEXP_BEGIN), cond, gen_op_simple(SUBEXP_END));
+  }
+
+  block true_body = BLOCK(gen_op_simple(POP), iftrue);
+  block false_body = BLOCK(gen_op_simple(POP), iffalse);
+  block jump = gen_op_target(JUMP, false_body);
+  jump.first->imm.target = false_body.last;
+  true_body = BLOCK(true_body, jump);
+  block jumpf = gen_op_target(JUMP_F, true_body);
+  jumpf.first->imm.target = true_body.last;
+  block branches = BLOCK(jumpf, true_body, false_body);
+
+  block compiled = BLOCK(gen_op_simple(DUP),
+                         BLOCK(cond_exp, gen_op_simple(POP)),
+                         branches);
+
+  if (srcfile && srcfile->length > 0 && srcfile->data != NULL) {
+    for (cursor = compiled.first; cursor; cursor = cursor->next) {
+      if (cursor->locfile == NULL) {
+        cursor->locfile = locfile_retain(srcfile);
+      }
+    }
+  }
+  if (srcfile)
+    locfile_free(srcfile);
+  return compiled;
+}
