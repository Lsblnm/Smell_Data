     return C_OK;
 }
 
+/* Bind a client to an ACL user.
+ *
+ * When reloading is 0, the client is attached to the default user and the
+ * authenticated flag is initialized from that user's flags. This covers new
+ * connections and connection resets.
+ *
+ * When reloading is 1, the client is rebound to the user of the same name in
+ * the newly loaded ACL table. If that user no longer exists, or the client's
+ * Pub/Sub subscriptions are no longer permitted, the client is disconnected.
+ */
+void ACLBindClientUser(client *c, rax *user_channels, int reloading) {
+    if (!reloading) {
+        c->user = DefaultUser;
+        c->flag.authenticated = (c->user->flags & USER_FLAG_NOPASS) && !(c->user->flags & USER_FLAG_DISABLED);
+        return;
+    }
+
+    user *original = c->user;
+    list *channels = NULL;
+    user *new_user = NULL;
+    raxFind(Users, (unsigned char *)original->name, sdslen(original->name), (void **)&new_user);
+    if (new_user && user_channels) {
+        if (!raxFind(user_channels, (unsigned char *)(new_user->name), sdslen(new_user->name), (void **)&channels)) {
+            channels = getUpcomingChannelList(new_user, original);
+            raxInsert(user_channels, (unsigned char *)(new_user->name), sdslen(new_user->name), channels, NULL);
+        }
+    }
+
+    /* When the new channel list is NULL, it means the new user's channel list is a superset of the old user's
+     * list. */
+    if (!new_user) {
+        freeClient(c);
+        return;
+    }
+    if (channels && getClientType(c) == CLIENT_TYPE_PUBSUB) {
+        ClientPubSubData *pubsub = c->pubsub_data;
+        int has_patterns = dictSize(pubsub->pubsub_patterns) != 0;
+        int has_channels = dictSize(pubsub->pubsub_channels) != 0;
+        int has_shard_channels = dictSize(pubsub->pubsubshard_channels) != 0;
+        if ((has_patterns || has_channels || has_shard_channels) && ACLShouldKillPubsubClient(c, channels)) {
+            freeClient(c);
+            return;
+        }
+    }
+    c->user = new_user;
+}
+
