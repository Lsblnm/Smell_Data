 	@Override public int getStartPos() {
 		return node.getPreferredPosition();
 	}
+
+	public List<MethodSymbol> getExtension(TypeSymbol tsym) {
+		List<MethodSymbol> extensionMethods = new ArrayList<MethodSymbol>();
+		JavacAST currentAst = this.ast;
+		JCTree currentNode = this.node;
+		if (currentAst == null || currentNode == null) return extensionMethods;
+		if (tsym == null) return extensionMethods;
+
+		String qualified = tsym.getQualifiedName().toString();
+		if (qualified != null && qualified.indexOf('.') != -1 && qualified.indexOf('$') == -1) {
+			JavacNode contextNode = currentAst.get(currentNode);
+			if (contextNode == null) contextNode = this;
+			if (!currentAst.getImportListAsTypeResolver().typeMatches(contextNode, qualified, qualified)) return extensionMethods;
+		}
+
+		for (Symbol member : tsym.getEnclosedElements()) {
+			if (!(member instanceof MethodSymbol)) continue;
+			MethodSymbol method = (MethodSymbol) member;
+			if (method.getKind() != ElementKind.METHOD) continue;
+			if ((method.flags() & (Flags.STATIC | Flags.PUBLIC)) == 0) continue;
+			if (method.params().isEmpty()) continue;
+			Type methodType = method.type;
+			if (methodType != null && methodType.getParameterTypes() != null && methodType.getParameterTypes().isEmpty()) continue;
+			extensionMethods.add(method);
+		}
+		return extensionMethods;
+	}
 }
