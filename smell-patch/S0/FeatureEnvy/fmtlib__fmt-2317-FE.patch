+// Data for writing a byte sequence padded according to format specs. It is used
+// to avoid template code bloat.
+template <typename Char> struct write_bytes_data {
+  const char* bytes;
+  size_t size;
+
+  FMT_CONSTEXPR write_bytes_data(string_view value)
+      : bytes(value.data()), size(value.size()) {}
+
+  template <typename OutputIt>
+  FMT_CONSTEXPR OutputIt write_bytes(OutputIt out,
+                                     const basic_format_specs<Char>& specs) const {
+    unsigned spec_width = to_unsigned(specs.width);
+    size_t padding = spec_width > size ? spec_width - size : 0;
+    size_t left_padding = padding >> data::left_padding_shifts[specs.align];
+    size_t right_padding = padding - left_padding;
+    const auto& fill = specs.fill;
+    auto fill_size = fill.size();
+    auto it = reserve(out, size + padding * fill_size);
+    if (left_padding != 0) {
+      if (fill_size == 1) {
+        it = detail::fill_n(it, left_padding, fill[0]);
+      } else {
+        auto fill_data = fill.data();
+        for (size_t i = 0; i < left_padding; ++i)
+          it = copy_str<Char>(fill_data, fill_data + fill_size, it);
+      }
+    }
+    it = copy_str<Char>(bytes, bytes + size, it);
+    if (right_padding != 0) {
+      if (fill_size == 1) {
+        it = detail::fill_n(it, right_padding, fill[0]);
+      } else {
+        auto fill_data = fill.data();
+        for (size_t i = 0; i < right_padding; ++i)
+          it = copy_str<Char>(fill_data, fill_data + fill_size, it);
+      }
+    }
+    return base_iterator(out, it);
+  }
+};
 
