+export class ResolvedLinkPath {
+  pathname: string;
+  search?: string;
+  hash?: string;
+  sourcePath: string;
+  rawLink: string;
+
+  constructor(fields: {
+    pathname: string;
+    search?: string;
+    hash?: string;
+    sourcePath: string;
+    rawLink: string;
+  }) {
+    this.pathname = fields.pathname;
+    this.search = fields.search;
+    this.hash = fields.hash;
+    this.sourcePath = fields.sourcePath;
+    this.rawLink = fields.rawLink;
+  }
+
+  static fromRawLink(rawLink: string, sourcePath: string): ResolvedLinkPath {
+    const parsed = parseURLPath(rawLink, sourcePath);
+    return new ResolvedLinkPath({
+      pathname: parsed.pathname,
+      search: parsed.search,
+      hash: parsed.hash,
+      sourcePath,
+      rawLink,
+    });
+  }
+}
