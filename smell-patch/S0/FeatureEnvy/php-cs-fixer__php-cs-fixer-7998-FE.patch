+
+    /**
+     * @throws \LogicException when provided index does not point to token containing T_CASE
+     */
+    public function isEnumCase(Tokens $tokens, int $caseIndex): bool
+    {
+        $token = $tokens[$caseIndex];
+        $tokenId = $token->getId();
+        $tokenContent = $token->getContent();
+        $tokenIsArray = $token->isArray();
+
+        if (!$tokenIsArray || T_CASE !== $tokenId || !$token->isGivenKind(T_CASE)) {
+            throw new \LogicException(sprintf(
+                'No T_CASE given at index %d, got %s instead.',
+                $caseIndex,
+                $token->getName() ?? $tokenContent
+            ));
+        }
+
+        if (!\defined('T_ENUM') || !$tokens->isTokenKindFound(T_ENUM)) {
+            return false;
+        }
+
+        $prevIndex = $tokens->getPrevTokenOfKind($caseIndex, [[T_ENUM], [T_SWITCH]]);
+
+        if (null === $prevIndex) {
+            return false;
+        }
+
+        $enumToken = $tokens[$prevIndex];
 
-        return null !== $prevIndex && $tokens[$prevIndex]->isGivenKind(T_ENUM);
+        return $enumToken->isArray()
+            && null !== $enumToken->getId()
+            && T_ENUM === $enumToken->getId()
+            && '' !== $enumToken->getContent()
+            && $enumToken->isGivenKind(T_ENUM);
     }
 }
