+pub(crate) struct CommandBuilder {
+    cwd: PathBuf,
+    stdin: Stdio,
+}
+
+impl CommandBuilder {
+    pub(crate) fn new(cwd: PathBuf, stdin: Stdio) -> Self {
+        Self { cwd, stdin }
+    }
+
+    /// Spawn a command without shelling out to an external shell
+    pub(crate) fn spawn_simple_command(
+        self,
+        command: &ExternalCommand,
+    ) -> Result<std::process::Command, ShellError> {
+        let (head, _, _) = trim_enclosing_quotes(&command.name.item);
+        let head = nu_path::expand_to_real_path(head)
+            .to_string_lossy()
+            .to_string();
+
+        let mut process = std::process::Command::new(head);
+        let cwd = self.cwd.to_string_lossy();
+
+        for (arg, arg_keep_raw) in command.args.iter().zip(command.arg_keep_raw.iter()) {
+            trim_expand_and_apply_arg(&mut process, arg, arg_keep_raw, cwd.as_ref());
+        }
+
+        process.stdin(self.stdin);
+        process.envs(&command.env_vars);
+        process.stdout(Stdio::try_from(&command.out)?);
+        process.stderr(Stdio::try_from(&command.err)?);
+
+        Ok(process)
+    }
+}
