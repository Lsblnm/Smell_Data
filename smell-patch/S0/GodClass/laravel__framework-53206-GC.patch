+    /**
+     * Encode a fluent-style attribute list as JSON.
+     *
+     * @param  array  $attributes
+     * @param  int  $options
+     * @return string
+     */
+    public function encodeAttributeListAsJson($attributes, $options = 0)
+    {
+        $this->httpData = $attributes;
+        $this->httpEncodingOptions = $options;
+        $this->httpEncodedJson = json_encode($this->httpData, $this->httpEncodingOptions);
