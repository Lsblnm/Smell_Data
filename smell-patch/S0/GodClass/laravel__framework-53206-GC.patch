+        return $this->httpEncodedJson;
+    }
+
+    /**
+     * Determine whether HTTP content is JSON-able, arrayable, or a raw array.
+     *
+     * @param  mixed  $content
+     * @return bool
+     */
+    public function httpContentNeedsJsonEncoding($content)
+    {
+        $this->httpData = $content;
+
+        if ($this->shouldEncodeHttpContentAsJson($this->httpData)) {
+            return true;
+        }
+
+        return false;
+    }
