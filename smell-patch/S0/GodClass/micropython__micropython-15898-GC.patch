+void mpz_runtime_aligned_store(unsigned int val_type, void *p, mp_int_t index, mp_obj_t val) {
+    mpz_runtime.bytes_val_type = val_type;
+    mpz_runtime.bytes_ptr = p;
+    mpz_runtime.bytes_index = index;
+    mpz_runtime.bytes_len = 1;
+    #if MICROPY_PY_BUILTINS_FLOAT
+    if (mpz_runtime.bytes_val_type == MPZ_VAL_FLOAT32 || mpz_runtime.bytes_val_type == MPZ_VAL_FLOAT64) {
+        if (mpz_runtime.bytes_val_type == MPZ_VAL_FLOAT32) {
+            ((float *)mpz_runtime.bytes_ptr)[mpz_runtime.bytes_index] = mp_obj_get_float_to_f(val);
+        } else {
+            ((double *)mpz_runtime.bytes_ptr)[mpz_runtime.bytes_index] = mp_obj_get_float_to_d(val);
