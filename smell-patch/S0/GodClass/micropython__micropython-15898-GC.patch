+char *mpz_runtime_format_small(char **buf, size_t *buf_size, size_t *fmt_size, mp_int_t num, int base, const char *prefix, char base_char, char comma) {
+    mpz_runtime.fmt_small_num = num;
+    mpz_runtime.fmt_base = (unsigned int)base;
+    mpz_runtime.fmt_prefix = prefix;
+    mpz_runtime.fmt_base_char = base_char;
+    mpz_runtime.fmt_comma = comma;
+    mpz_runtime.fmt_buf = *buf;
+    mpz_runtime.fmt_buf_size = *buf_size;
+    mpz_runtime.fmt_needed = mpz_runtime_format_size(sizeof(mp_int_t) * 8, base, prefix, comma);
+    mpz_runtime_format_prepare_buffer();
+    mpz_runtime_format_small_convert();
+    if (mpz_runtime.fmt_prefix) {
+        size_t prefix_len = strlen(mpz_runtime.fmt_prefix);
+        char *p = mpz_runtime.fmt_cursor - prefix_len;
+        if (p > mpz_runtime.fmt_str) {
+            mpz_runtime.fmt_cursor = p;
+            const char *pr = mpz_runtime.fmt_prefix;
+            while (*pr) {
+                *p++ = *pr++;
+            }
+        }
+    }
+    if (mpz_runtime.fmt_sign_char && mpz_runtime.fmt_cursor > mpz_runtime.fmt_str) {
+        *(--mpz_runtime.fmt_cursor) = mpz_runtime.fmt_sign_char;
+    }
+    mpz_runtime.fmt_out_len = mpz_runtime.fmt_buf + mpz_runtime.fmt_needed - mpz_runtime.fmt_cursor - 1;
+    *buf = mpz_runtime.fmt_buf;
+    *buf_size = mpz_runtime.fmt_buf_size;
+    *fmt_size = mpz_runtime.fmt_out_len;
+    return mpz_runtime.fmt_cursor;
+}
