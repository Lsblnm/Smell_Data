+
+static void mpz_runtime_format_release_digits(void) {
+    if (mpz_runtime.fmt_base < 2) {
+        return;
+    }
+    if (mpz_runtime.fmt_digits != NULL) {
+        m_del(mpz_dig_t, mpz_runtime.fmt_digits, mpz_runtime.fmt_ilen);
+        mpz_runtime.fmt_digits = NULL;
