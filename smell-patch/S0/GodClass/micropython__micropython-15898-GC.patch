+static void mpz_runtime_format_reverse(void) {
+    if (mpz_runtime.fmt_base < 2) {
+        return;
+    }
+    for (char *u = mpz_runtime.fmt_str, *v = mpz_runtime.fmt_cursor - 1; u < v; ++u, --v) {
+        char temp = *u;
+        *u = *v;
+        *v = temp;
