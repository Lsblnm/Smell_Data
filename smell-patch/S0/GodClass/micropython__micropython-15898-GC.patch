+    if (mpz_runtime.fmt_prefix) {
+        const char *prefix = mpz_runtime.fmt_prefix;
+        while (*prefix) {
+            *mpz_runtime.fmt_cursor++ = *prefix++;
+        }
+    }
+    *mpz_runtime.fmt_cursor++ = '0';
+    *mpz_runtime.fmt_cursor = '\0';
+    mpz_runtime.fmt_out_len = mpz_runtime.fmt_cursor - mpz_runtime.fmt_str;
+    return mpz_runtime.fmt_out_len;
+}
