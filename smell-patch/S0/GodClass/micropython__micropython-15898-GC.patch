+                ((uint64_t *)mpz_runtime.bytes_ptr)[mpz_runtime.bytes_index] = (uint64_t)v;
+            } else {
+                byte *slot = (byte *)&((uint64_t *)mpz_runtime.bytes_ptr)[mpz_runtime.bytes_index];
