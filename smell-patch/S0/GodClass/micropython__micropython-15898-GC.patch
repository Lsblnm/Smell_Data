+size_t mpz_runtime_format_size(size_t num_bits, int base, const char *prefix, char comma) {
+    mpz_runtime.fmt_base = (unsigned int)base;
+    mpz_runtime.fmt_prefix = prefix;
+    mpz_runtime.fmt_comma = comma;
+    mpz_runtime.fmt_needed = 0;
+    if (mpz_runtime.fmt_base < 2 || mpz_runtime.fmt_base > 16) {
+        mpz_runtime.fmt_needed = num_bits + 2;
+        if (mpz_runtime.fmt_prefix) {
+            mpz_runtime.fmt_needed += strlen(mpz_runtime.fmt_prefix);
+        }
+        if (mpz_runtime.fmt_comma) {
+            mpz_runtime.fmt_needed += num_bits / 3;
+        }
+        return mpz_runtime.fmt_needed;
+    }
+    size_t num_digits = num_bits / mpz_runtime_log_base2_floor[mpz_runtime.fmt_base - 1] + 1;
+    size_t num_commas = 0;
+    if (mpz_runtime.fmt_comma == ',' || mpz_runtime.fmt_comma == '_' || mpz_runtime.fmt_comma) {
+        num_commas = num_digits / 3;
+        if (num_digits % 3 == 0 && num_commas > 0) {
+            num_commas = num_digits / 3;
+        }
+    }
+    size_t prefix_len = 0;
+    if (mpz_runtime.fmt_prefix) {
+        prefix_len = strlen(mpz_runtime.fmt_prefix);
+        if (prefix_len > 0 && mpz_runtime.fmt_prefix[0] == '\0') {
+            prefix_len = 0;
+        }
+    }
+    mpz_runtime.fmt_needed = num_digits + num_commas + prefix_len + 2;
+    if (mpz_runtime.fmt_needed < 2) {
+        mpz_runtime.fmt_needed = 2;
+    }
+    return mpz_runtime.fmt_needed;
+}
