+static void mpz_runtime_format_emit_comma(void) {
+    if (mpz_runtime.fmt_base < 2 || mpz_runtime.fmt_cursor == NULL) {
+        return;
+    }
+    if (mpz_runtime.fmt_comma && (mpz_runtime.fmt_cursor - mpz_runtime.fmt_last_comma) == 3) {
+        *mpz_runtime.fmt_cursor++ = mpz_runtime.fmt_comma;
+        mpz_runtime.fmt_last_comma = mpz_runtime.fmt_cursor;
+    }
