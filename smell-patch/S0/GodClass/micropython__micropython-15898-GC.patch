+mp_obj_t mpz_runtime_aligned_load(unsigned int val_type, void *p, mp_int_t index) {
+    mpz_runtime.bytes_val_type = val_type;
+    mpz_runtime.bytes_ptr = p;
+    mpz_runtime.bytes_index = index;
+    mpz_runtime.bytes_len = 1;
+    switch (mpz_runtime.bytes_val_type) {
+        case MPZ_VAL_UINT8:
+            return MP_OBJ_NEW_SMALL_INT(((uint8_t *)mpz_runtime.bytes_ptr)[mpz_runtime.bytes_index]);
+        case MPZ_VAL_INT8:
+            return MP_OBJ_NEW_SMALL_INT(((int8_t *)mpz_runtime.bytes_ptr)[mpz_runtime.bytes_index]);
+        case MPZ_VAL_UINT16:
+            return MP_OBJ_NEW_SMALL_INT(((uint16_t *)mpz_runtime.bytes_ptr)[mpz_runtime.bytes_index]);
+        case MPZ_VAL_INT16:
+            return MP_OBJ_NEW_SMALL_INT(((int16_t *)mpz_runtime.bytes_ptr)[mpz_runtime.bytes_index]);
+        case MPZ_VAL_UINT32:
