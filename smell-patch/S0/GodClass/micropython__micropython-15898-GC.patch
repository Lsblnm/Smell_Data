+
+static void mpz_runtime_format_emit_prefix(void) {
+    if (mpz_runtime.fmt_base < 2) {
+        return;
+    }
+    if (mpz_runtime.fmt_prefix) {
+        const char *p = &mpz_runtime.fmt_prefix[strlen(mpz_runtime.fmt_prefix)];
+        while (p > mpz_runtime.fmt_prefix) {
+            *mpz_runtime.fmt_cursor++ = *--p;
+        }
+    }
