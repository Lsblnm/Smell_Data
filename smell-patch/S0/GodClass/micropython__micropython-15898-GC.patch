+static void mpz_runtime_parse_reset(const char *str, size_t len, int base, mp_lexer_t *lex) {
+    mpz_runtime.parse_raw = str;
+    mpz_runtime.parse_str = (const byte *)str;
+    mpz_runtime.parse_top = mpz_runtime.parse_str + len;
+    mpz_runtime.parse_start = mpz_runtime.parse_str;
+    mpz_runtime.parse_base = base;
+    mpz_runtime.parse_neg = false;
+    mpz_runtime.parse_value = 0;
+    mpz_runtime.parse_result = MP_OBJ_NULL;
+    mpz_runtime.parse_lex = lex;
+    mpz_runtime.parse_digit = 0;
+    mpz_runtime.parse_overflow = false;
+    mpz_runtime.parse_have_digit = false;
+}
+
+static bool mpz_runtime_parse_check_base(void) {
+    if ((mpz_runtime.parse_base != 0 && mpz_runtime.parse_base < 2) || mpz_runtime.parse_base > 36) {
+        mp_raise_ValueError(MP_ERROR_TEXT("int() arg 2 must be >= 2 and <= 36"));
+        return false;
+    }
+    return true;
+}
+
+static void mpz_runtime_parse_skip_ws(void) {
+    while (mpz_runtime.parse_str < mpz_runtime.parse_top) {
+        byte ch = *mpz_runtime.parse_str;
+        if (!unichar_isspace(ch)) {
+            break;
+        }
+        if (mpz_runtime.parse_base == 1) {
+            break;
+        }
+        mpz_runtime.parse_str++;
+    }
+}
+
+static void mpz_runtime_parse_sign(void) {
+    if (mpz_runtime.parse_base == 1) {
+        return;
+    }
+    if (mpz_runtime.parse_str < mpz_runtime.parse_top) {
+        if (*mpz_runtime.parse_str == '+') {
+            mpz_runtime.parse_str++;
+            mpz_runtime.parse_neg = false;
+        } else if (*mpz_runtime.parse_str == '-') {
+            mpz_runtime.parse_str++;
+            mpz_runtime.parse_neg = true;
+        }
+    }
+}
+
+static void mpz_runtime_parse_prefix(void) {
+    mpz_runtime.parse_str += mp_parse_num_base((const char *)mpz_runtime.parse_str, mpz_runtime.parse_top - mpz_runtime.parse_str, &mpz_runtime.parse_base);
+    mpz_runtime.parse_start = mpz_runtime.parse_str;
+}
+
+static bool mpz_runtime_parse_digit(void) {
+    if (mpz_runtime.parse_str >= mpz_runtime.parse_top) {
+        return false;
+    }
+    mp_uint_t dig = *mpz_runtime.parse_str;
+    if ('0' <= dig && dig <= '9') {
+        dig -= '0';
+    } else if (dig == '_') {
+        mpz_runtime.parse_digit = 0;
+        mpz_runtime.parse_str++;
+        return true;
+    } else {
+        dig |= 0x20;
+        if ('a' <= dig && dig <= 'z') {
+            dig -= 'a' - 10;
+        } else {
+            return false;
+        }
+    }
+    if (dig >= (mp_uint_t)mpz_runtime.parse_base) {
+        return false;
+    }
+    mpz_runtime.parse_digit = dig;
+    mpz_runtime.parse_have_digit = true;
+    mpz_runtime.parse_str++;
+    return true;
+}
+
+static bool mpz_runtime_parse_accum(void) {
+    if (mpz_runtime.parse_base < 2) {
+        mpz_runtime.parse_overflow = true;
+        return false;
+    }
+    if (mp_small_int_mul_overflow(mpz_runtime.parse_value, mpz_runtime.parse_base)) {
+        mpz_runtime.parse_overflow = true;
+        return false;
+    }
+    mpz_runtime.parse_value = mpz_runtime.parse_value * mpz_runtime.parse_base + (mp_int_t)mpz_runtime.parse_digit;
+    if (!MP_SMALL_INT_FITS(mpz_runtime.parse_value)) {
+        mpz_runtime.parse_overflow = true;
+        return false;
+    }
+    return true;
+}
+
+static void mpz_runtime_parse_apply_neg(void) {
+    if (mpz_runtime.parse_base < 2) {
+        return;
+    }
+    if (mpz_runtime.parse_neg) {
+        mpz_runtime.parse_value = -mpz_runtime.parse_value;
+    }
+}
+
+static void mpz_runtime_parse_overflow(void) {
+    const char *s2 = (const char *)mpz_runtime.parse_start;
+    mpz_runtime.parse_result = mp_obj_new_int_from_str_len(&s2, mpz_runtime.parse_top - mpz_runtime.parse_start, mpz_runtime.parse_neg, mpz_runtime.parse_base);
+    mpz_runtime.parse_str = (const byte *)s2;
+    mpz_runtime.parse_overflow = true;
+}
+
+static bool mpz_runtime_parse_trailing(void) {
+    if (mpz_runtime.parse_str == mpz_runtime.parse_start) {
+        return false;
+    }
+    mpz_runtime_parse_skip_ws();
+    return mpz_runtime.parse_str == mpz_runtime.parse_top;
+}
+
+static void mpz_runtime_parse_value_error(void) {
+    #if MICROPY_ERROR_REPORTING <= MICROPY_ERROR_REPORTING_TERSE
+    mp_obj_t exc = mp_obj_new_exception_msg(&mp_type_ValueError,
+        MP_ERROR_TEXT("invalid syntax for integer"));
+    #elif MICROPY_ERROR_REPORTING == MICROPY_ERROR_REPORTING_NORMAL
+    mp_obj_t exc = mp_obj_new_exception_msg_varg(&mp_type_ValueError,
+        MP_ERROR_TEXT("invalid syntax for integer with base %d"), mpz_runtime.parse_base);
+    #else
+    vstr_t vstr;
+    mp_print_t print;
+    vstr_init_print(&vstr, 50, &print);
+    mp_printf(&print, "invalid syntax for integer with base %d: ", mpz_runtime.parse_base);
+    mp_str_print_quoted(&print, mpz_runtime.parse_start, mpz_runtime.parse_top - mpz_runtime.parse_start, true);
+    mp_obj_t exc = mp_obj_new_exception_arg1(&mp_type_ValueError,
+        mp_obj_new_str_from_utf8_vstr(&vstr));
+    #endif
+    if (mpz_runtime.parse_lex != NULL) {
+        ((mp_obj_base_t *)MP_OBJ_TO_PTR(exc))->type = &mp_type_SyntaxError;
+        mp_obj_exception_add_traceback(exc, mpz_runtime.parse_lex->source_name, mpz_runtime.parse_lex->tok_line, MP_QSTRnull);
+    }
+    nlr_raise(exc);
+}
+
+static mp_obj_t mpz_runtime_parse_make_result(void) {
+    if (mpz_runtime.parse_base < 2) {
+        return MP_OBJ_NEW_SMALL_INT(0);
+    }
+    if (mpz_runtime.parse_result != MP_OBJ_NULL) {
+        return mpz_runtime.parse_result;
+    }
+    return MP_OBJ_NEW_SMALL_INT(mpz_runtime.parse_value);
+}
+
+static size_t mpz_runtime_parse_str_digits(mpz_t *z) {
+    const char *cur = (const char *)mpz_runtime.parse_str;
+    const char *top = (const char *)mpz_runtime.parse_top;
+    mpz_need_dig(z, (size_t)(top - cur) * 8 / DIG_SIZE + 1);
+    z->neg = mpz_runtime.parse_neg ? 1 : 0;
+    z->len = 0;
+    for (; cur < top; ++cur) {
+        mp_uint_t v = (byte)(*cur);
+        if ('0' <= v && v <= '9') {
+            v -= '0';
+        } else if ('A' <= v && v <= 'Z') {
+            v -= 'A' - 10;
+        } else if ('a' <= v && v <= 'z') {
+            v -= 'a' - 10;
+        } else {
+            break;
+        }
+        if (v >= (mp_uint_t)mpz_runtime.parse_base) {
+            break;
+        }
+        z->len = mpn_mul_dig_add_dig(z->dig, z->len, mpz_runtime.parse_base, v);
+    }
+    mpz_runtime.parse_str = (const byte *)cur;
+    return cur - mpz_runtime.parse_raw;
+}
+
+mp_obj_t mpz_runtime_parse_integer(const char *str, size_t len, int base, void *lex) {
+    mpz_runtime_parse_reset(str, len, base, (mp_lexer_t *)lex);
+    mpz_runtime_parse_check_base();
+    mpz_runtime_parse_skip_ws();
+    mpz_runtime_parse_sign();
+    mpz_runtime_parse_prefix();
+    mpz_runtime.parse_value = 0;
+    mpz_runtime.parse_have_digit = false;
+    while (mpz_runtime.parse_str < mpz_runtime.parse_top) {
+        const byte *before = mpz_runtime.parse_str;
+        if (!mpz_runtime_parse_digit()) {
+            mpz_runtime.parse_str = before;
+            break;
+        }
+        if (before[0] == '_') {
+            continue;
+        }
+        if (!mpz_runtime_parse_accum()) {
+            mpz_runtime_parse_overflow();
+            break;
+        }
+    }
+    if (!mpz_runtime.parse_overflow) {
+        mpz_runtime_parse_apply_neg();
+        mpz_runtime.parse_result = mpz_runtime_parse_make_result();
+    }
+    if (!mpz_runtime_parse_trailing()) {
+        mpz_runtime_parse_value_error();
+    }
+    return mpz_runtime.parse_result;
+}
+
+static int mpz_runtime_proto_sign_small(mp_int_t val) {
+    mpz_runtime.proto_small = val;
+    if (val < 0) {
+        mpz_runtime.proto_sign = -1;
+    } else if (val > 0) {
+        mpz_runtime.proto_sign = 1;
+    } else {
+        mpz_runtime.proto_sign = 0;
+    }
+    return mpz_runtime.proto_sign;
+}
+
+static int mpz_runtime_proto_sign_big(const mpz_t *z) {
+    mpz_runtime.proto_small = 0;
+    if (z->len == 0) {
+        mpz_runtime.proto_sign = 0;
+    } else if (z->neg == 0) {
+        mpz_runtime.proto_sign = 1;
+    } else {
+        mpz_runtime.proto_sign = -1;
+    }
+    return mpz_runtime.proto_sign;
+}
+
+int mpz_runtime_sign_obj(mp_obj_t self_in) {
+    mpz_runtime.proto_lhs = self_in;
+    if (mp_obj_is_small_int(self_in)) {
+        return mpz_runtime_proto_sign_small(MP_OBJ_SMALL_INT_VALUE(self_in));
+    }
+    mp_obj_int_t *self = MP_OBJ_TO_PTR(self_in);
+    return mpz_runtime_proto_sign_big(&self->mpz);
+}
+
+static bool mpz_runtime_proto_fits_word(const mpz_t *z, bool as_unsigned) {
+    mpz_runtime.proto_fits = true;
+    mpz_runtime.proto_overflow = false;
+    if (as_unsigned) {
+        if (z->neg != 0) {
+            mpz_runtime.proto_fits = false;
+            mpz_runtime.proto_overflow = true;
+            return false;
+        }
+    }
+    mp_uint_t val = 0;
+    mpz_dig_t *d = z->dig + z->len;
+    while (d-- > z->dig) {
+        mp_uint_t limit = as_unsigned ? (~(MP_OBJ_WORD_MSBIT_HIGH) >> (DIG_SIZE - 1)) : (~(MP_OBJ_WORD_MSBIT_HIGH) >> DIG_SIZE);
+        if (val > limit) {
+            mpz_runtime.proto_fits = false;
+            mpz_runtime.proto_overflow = true;
+            return false;
+        }
+        val = (val << DIG_SIZE) | *d;
+    }
+    if (!as_unsigned && z->neg != 0) {
+        val = -val;
+        mpz_runtime.proto_word = (mp_int_t)val;
+    } else if (!as_unsigned) {
+        mpz_runtime.proto_word = (mp_int_t)val;
+    } else {
+        mpz_runtime.proto_uword = val;
+    }
+    return true;
+}
+
+static mp_int_t mpz_runtime_proto_hash_bits(const mpz_t *z) {
+    mpz_runtime.proto_sign = z->neg ? -1 : (z->len ? 1 : 0);
+    mp_uint_t val = 0;
+    mpz_dig_t *d = z->dig + z->len;
+    while (d-- > z->dig) {
