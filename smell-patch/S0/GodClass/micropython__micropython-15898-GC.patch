+        return;
+    }
+    #endif
+    mp_int_t v = mp_obj_get_int_truncated(val);
+    mpz_runtime.bytes_value = (mp_uint_t)v;
+    switch (mpz_runtime.bytes_val_type) {
+        case MPZ_VAL_UINT8:
+            ((uint8_t *)mpz_runtime.bytes_ptr)[mpz_runtime.bytes_index] = (uint8_t)v;
+            return;
+        case MPZ_VAL_INT8:
+            ((int8_t *)mpz_runtime.bytes_ptr)[mpz_runtime.bytes_index] = (int8_t)v;
+            return;
+        case MPZ_VAL_UINT16:
+            ((uint16_t *)mpz_runtime.bytes_ptr)[mpz_runtime.bytes_index] = (uint16_t)v;
+            return;
+        case MPZ_VAL_INT16:
+            ((int16_t *)mpz_runtime.bytes_ptr)[mpz_runtime.bytes_index] = (int16_t)v;
+            return;
+        case MPZ_VAL_UINT32:
+            ((uint32_t *)mpz_runtime.bytes_ptr)[mpz_runtime.bytes_index] = (uint32_t)v;
+            return;
+        case MPZ_VAL_INT32:
+            ((int32_t *)mpz_runtime.bytes_ptr)[mpz_runtime.bytes_index] = (int32_t)v;
+            return;
+        case MPZ_VAL_INT64:
+        case MPZ_VAL_UINT64:
