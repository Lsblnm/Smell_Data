+static void mpz_runtime_format_div_step(void) {
+    mpz_dig_t *d = mpz_runtime.fmt_digits + mpz_runtime.fmt_ilen;
+    mpz_dbl_dig_t a = 0;
+    while (--d >= mpz_runtime.fmt_digits) {
+        a = (a << DIG_SIZE) | *d;
+        *d = a / mpz_runtime.fmt_base;
+        a %= mpz_runtime.fmt_base;
+    }
+    mpz_runtime.fmt_remainder = a;
