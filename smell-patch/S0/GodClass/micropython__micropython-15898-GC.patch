+static void mpz_runtime_bytes_reset(bool big_endian, size_t len, const byte *src, byte *dest) {
+    mpz_runtime.bytes_big_endian = big_endian;
+    mpz_runtime.bytes_len = len;
+    mpz_runtime.bytes_src = src;
+    mpz_runtime.bytes_dest = dest;
+    mpz_runtime.bytes_as_signed = false;
+    mpz_runtime.bytes_delta = big_endian ? -1 : 1;
+    mpz_runtime.bytes_acc = 0;
+    mpz_runtime.bytes_bits = 0;
+    mpz_runtime.bytes_olen = len;
+    mpz_runtime.bytes_ok = true;
+    mpz_runtime.bytes_carry = 1;
+    mpz_runtime.bytes_val_type = 0;
+    mpz_runtime.bytes_ptr = dest;
+    mpz_runtime.bytes_index = 0;
+    mpz_runtime.bytes_value = 0;
+    mpz_runtime.bytes_overflow = false;
+}
+
+static void mpz_runtime_bytes_load_setup(mpz_t *z) {
+    if (mpz_runtime.bytes_big_endian && mpz_runtime.bytes_len != 0) {
+        mpz_runtime.bytes_src += mpz_runtime.bytes_len - 1;
+        mpz_runtime.bytes_delta = -1;
+    } else {
+        mpz_runtime.bytes_delta = 1;
+    }
+    mpz_need_dig(z, (mpz_runtime.bytes_len * 8 + DIG_SIZE - 1) / DIG_SIZE);
+    mpz_runtime.bytes_acc = 0;
+    mpz_runtime.bytes_bits = 0;
+    z->neg = 0;
+    z->len = 0;
+}
+
+static void mpz_runtime_bytes_load_loop(mpz_t *z) {
+    size_t len = mpz_runtime.bytes_len;
+    const byte *buf = mpz_runtime.bytes_src;
+    int delta = mpz_runtime.bytes_delta;
+    mpz_dig_t d = mpz_runtime.bytes_acc;
+    int num_bits = mpz_runtime.bytes_bits;
+    while (len) {
+        while (len && num_bits < DIG_SIZE) {
+            d |= *buf << num_bits;
+            num_bits += 8;
+            buf += delta;
+            len--;
+        }
+        z->dig[z->len++] = d & DIG_MASK;
+        #if DIG_SIZE != 8 && DIG_SIZE != 16 && DIG_SIZE != 32
+        d >>= DIG_SIZE;
+        #else
+        d = 0;
+        #endif
+        num_bits -= DIG_SIZE;
+    }
+    z->len = mpn_remove_trailing_zeros(z->dig, z->dig + z->len);
+    mpz_runtime.bytes_len = len;
+    mpz_runtime.bytes_src = buf;
+    mpz_runtime.bytes_acc = d;
+    mpz_runtime.bytes_bits = num_bits;
+}
+
+static void mpz_runtime_bytes_store_setup(const mpz_t *z) {
+    (void)z;
+    mpz_runtime.bytes_ok = true;
+    mpz_runtime.bytes_carry = 1;
+    mpz_runtime.bytes_olen = mpz_runtime.bytes_len;
+    mpz_runtime.bytes_bits = 0;
+    mpz_runtime.bytes_acc = 0;
+    if (mpz_runtime.bytes_big_endian) {
+        mpz_runtime.bytes_dest += mpz_runtime.bytes_len;
+    }
+}
+
+static void mpz_runtime_bytes_store_loop(const mpz_t *z) {
+    byte *b = mpz_runtime.bytes_dest;
+    mpz_dig_t *zdig = z->dig;
+    int bits = mpz_runtime.bytes_bits;
+    mpz_dbl_dig_t d = mpz_runtime.bytes_acc;
+    mpz_dbl_dig_t carry = mpz_runtime.bytes_carry;
+    size_t olen = mpz_runtime.bytes_olen;
+    bool ok = mpz_runtime.bytes_ok;
+    for (size_t zlen = z->len; zlen > 0; --zlen) {
+        bits += DIG_SIZE;
+        d = (d << DIG_SIZE) | *zdig++;
+        for (; bits >= 8; bits -= 8, d >>= 8) {
+            mpz_dig_t val = d;
+            if (z->neg) {
+                val = (~val & 0xff) + carry;
+                carry = val >> 8;
+            }
+            if (!olen) {
+                ok = ok && ((byte)val == 0);
+                continue;
+            }
+            if (mpz_runtime.bytes_big_endian) {
+                *--b = val;
+            } else {
+                *b++ = val;
+            }
+            olen--;
+        }
+    }
+    mpz_runtime.bytes_dest = b;
+    mpz_runtime.bytes_bits = bits;
+    mpz_runtime.bytes_acc = (mpz_dig_t)d;
+    mpz_runtime.bytes_carry = carry;
+    mpz_runtime.bytes_olen = olen;
+    mpz_runtime.bytes_ok = ok;
+}
+
+static void mpz_runtime_bytes_fill_rest(const mpz_t *z) {
+    byte *buf = mpz_runtime.bytes_ptr;
+    byte *b = mpz_runtime.bytes_dest;
+    if (mpz_runtime.bytes_as_signed && mpz_runtime.bytes_olen == 0 && mpz_runtime.bytes_len > 0) {
+        byte most_sig = mpz_runtime.bytes_big_endian ? buf[0] : buf[mpz_runtime.bytes_len - 1];
+        mpz_runtime.bytes_ok = mpz_runtime.bytes_ok && (bool)(most_sig & 0x80) == (bool)z->neg;
+    } else {
+        memset(mpz_runtime.bytes_big_endian ? buf : b, z->neg ? 0xff : 0x00, mpz_runtime.bytes_olen);
+    }
+}
+
+static bool mpz_runtime_bytes_overflow_check(const mpz_t *z) {
+    (void)z;
+    mpz_runtime.bytes_overflow = !mpz_runtime.bytes_ok;
+    return !mpz_runtime.bytes_overflow;
+}
+
+static mp_uint_t mpz_runtime_bytes_read_uint(void) {
+    mp_uint_t value = 0;
+    const byte *buf = mpz_runtime.bytes_src;
+    int delta = mpz_runtime.bytes_delta;
+    size_t len = mpz_runtime.bytes_len;
+    for (; len--; buf += delta) {
+        if (mpz_runtime_bytes_need_longint(value)) {
+            return value;
+        }
+        value = (value << 8) | *buf;
+    }
+    mpz_runtime.bytes_value = value;
+    mpz_runtime.bytes_overflow = false;
+    return value;
+}
+
+static void mpz_runtime_bytes_write_uint(mp_uint_t value) {
+    mpz_runtime.bytes_value = value;
+    if (mpz_runtime.bytes_len == 0) {
+        return;
+    }
+    mp_binary_set_int(mpz_runtime.bytes_len, mpz_runtime.bytes_big_endian, mpz_runtime.bytes_dest, value);
+}
+
+static void mpz_runtime_bytes_small_to_buf(mp_int_t val, bool big_endian, size_t dlen, byte *data) {
+    mpz_runtime.bytes_big_endian = big_endian;
+    mpz_runtime.bytes_len = dlen;
+    mpz_runtime.bytes_dest = data;
+    int slen;
+    if (val > 0) {
+        slen = (sizeof(mp_int_t) * 8 - mp_clz_mpi(val) + 7) / 8;
+    } else if (val < -1) {
+        slen = (sizeof(mp_int_t) * 8 - mp_clz_mpi(~val) + 8) / 8;
+    } else {
+        slen = -val;
+    }
+    if (slen <= (int)dlen) {
+        memset(data, val < 0 ? 0xFF : 0x00, dlen);
+        mpz_runtime.bytes_len = (size_t)slen;
+        mpz_runtime.bytes_dest = data + (big_endian ? (dlen - (size_t)slen) : 0);
+        mpz_runtime.bytes_big_endian = big_endian;
+        mpz_runtime_bytes_write_uint((mp_uint_t)val);
+        mpz_runtime.bytes_overflow = false;
+    } else {
+        mpz_runtime.bytes_overflow = true;
+    }
+}
+
+static bool mpz_runtime_bytes_need_longint(mp_uint_t value) {
+    mpz_runtime.bytes_value = value;
+    mpz_runtime.bytes_overflow = value > (MP_SMALL_INT_MAX >> 8);
+    return mpz_runtime.bytes_overflow;
+}
+
+mp_obj_t mpz_runtime_from_bytes_obj(size_t n_args, const mp_obj_t *args) {
+    mp_buffer_info_t bufinfo;
+    mp_get_buffer_raise(args[1], &bufinfo, MP_BUFFER_READ);
+    const byte *buf = (const byte *)bufinfo.buf;
+    bool big_endian = n_args < 3 || args[2] != MP_OBJ_NEW_QSTR(MP_QSTR_little);
+    mpz_runtime_bytes_reset(big_endian, bufinfo.len, buf, NULL);
+    if (!mpz_runtime.bytes_big_endian && mpz_runtime.bytes_len != 0) {
+        mpz_runtime.bytes_src += mpz_runtime.bytes_len - 1;
+        mpz_runtime.bytes_delta = -1;
+    } else {
+        mpz_runtime.bytes_delta = 1;
+    }
+    mp_uint_t value = mpz_runtime_bytes_read_uint();
+    if (mpz_runtime.bytes_overflow) {
+        return mp_obj_int_from_bytes_impl(big_endian, bufinfo.len, bufinfo.buf);
+    }
+    return mp_obj_new_int_from_uint(value);
+}
+
+mp_obj_t mpz_runtime_to_bytes_obj(size_t n_args, const mp_obj_t *args) {
+    mp_int_t dlen = n_args < 2 ? 1 : mp_obj_get_int(args[1]);
+    if (dlen < 0) {
+        mp_raise_ValueError(NULL);
+    }
+    bool big_endian = n_args < 3 || args[2] != MP_OBJ_NEW_QSTR(MP_QSTR_little);
+    vstr_t vstr;
+    vstr_init_len(&vstr, dlen);
+    byte *data = (byte *)vstr.buf;
+    mpz_runtime_bytes_reset(big_endian, dlen, NULL, data);
+    mpz_runtime.bytes_ptr = data;
+    mpz_runtime.bytes_len = (size_t)dlen;
+    mpz_runtime.bytes_big_endian = big_endian;
+    if (mpz_runtime.bytes_len == 0) {
+        mpz_runtime.bytes_overflow = false;
+        return mp_obj_new_bytes_from_vstr(&vstr);
+    }
+    if (!mp_obj_is_small_int(args[0])) {
+        mpz_runtime.bytes_overflow = !mp_obj_int_to_bytes_impl(args[0], big_endian, dlen, data);
+    } else {
+        mpz_runtime_bytes_small_to_buf(MP_OBJ_SMALL_INT_VALUE(args[0]), big_endian, dlen, data);
+    }
+    if (mpz_runtime.bytes_overflow) {
+        mp_raise_msg(&mp_type_OverflowError, MP_ERROR_TEXT("buffer too small"));
+    }
+    return mp_obj_new_bytes_from_vstr(&vstr);
+}
