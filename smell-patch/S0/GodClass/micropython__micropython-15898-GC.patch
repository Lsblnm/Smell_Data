+static void mpz_runtime_format_clone_digits(const mpz_t *i) {
+    if (mpz_runtime.fmt_base < 2 || mpz_runtime.fmt_base > 32) {
+        mpz_runtime.fmt_ilen = 0;
+        return;
+    }
+    mpz_runtime.fmt_ilen = i->len;
+    mpz_runtime.fmt_digits = m_new(mpz_dig_t, mpz_runtime.fmt_ilen);
+    memcpy(mpz_runtime.fmt_digits, i->dig, mpz_runtime.fmt_ilen * sizeof(mpz_dig_t));
+}
