+static void mpz_runtime_format_prepare_buffer(void) {
+    if (mpz_runtime.fmt_needed > mpz_runtime.fmt_buf_size) {
+        mpz_runtime.fmt_buf = m_new(char, mpz_runtime.fmt_needed);
+        mpz_runtime.fmt_buf_size = mpz_runtime.fmt_needed;
+    }
+    mpz_runtime.fmt_str = mpz_runtime.fmt_buf;
+    mpz_runtime.fmt_cursor = mpz_runtime.fmt_buf + mpz_runtime.fmt_needed;
+    *(--mpz_runtime.fmt_cursor) = '\0';
+    mpz_runtime.fmt_last_comma = mpz_runtime.fmt_cursor;
+}
+
+static void mpz_runtime_format_small_convert(void) {
+    mp_uint_t num;
+    if (mpz_runtime.fmt_small_num < 0) {
+        num = (mp_uint_t)(-mpz_runtime.fmt_small_num);
+        mpz_runtime.fmt_sign_char = '-';
+        mpz_runtime.fmt_neg = true;
+    } else {
+        num = (mp_uint_t)mpz_runtime.fmt_small_num;
+        mpz_runtime.fmt_sign_char = '\0';
+        mpz_runtime.fmt_neg = false;
+    }
+    if (num == 0) {
+        *(--mpz_runtime.fmt_cursor) = '0';
+        return;
+    }
+    do {
+        int c = (int)(num % mpz_runtime.fmt_base);
+        num = num / mpz_runtime.fmt_base;
+        if (c >= 10) {
+            c += mpz_runtime.fmt_base_char - 10;
+        } else {
+            c += '0';
+        }
+        *(--mpz_runtime.fmt_cursor) = c;
+        if (mpz_runtime.fmt_comma && num != 0 && mpz_runtime.fmt_cursor > mpz_runtime.fmt_str && (mpz_runtime.fmt_last_comma - mpz_runtime.fmt_cursor) == 3) {
+            *(--mpz_runtime.fmt_cursor) = mpz_runtime.fmt_comma;
+            mpz_runtime.fmt_last_comma = mpz_runtime.fmt_cursor;
+        }
+    } while (mpz_runtime.fmt_cursor > mpz_runtime.fmt_str && num != 0);
+}
