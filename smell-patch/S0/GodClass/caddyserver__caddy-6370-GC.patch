+	_, nonstandard, _, err := s.getModules()
+	if err != nil {
+		return caddy.ExitCodeFailedStartup, fmt.Errorf("unable to enumerate installed plugins: %v", err)
+	}
+	pluginPkgs, err := s.getPluginPackages(nonstandard)
+	s.pluginPkgs = pluginPkgs
