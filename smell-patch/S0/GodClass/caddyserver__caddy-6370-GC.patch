+func (s *cliSession) cmdUpgrade(fl Flags) (int, error) {
+	if s.pluginPkgs == nil {
+		s.pluginPkgs = make(map[string]struct{})
+	}
+
+	_, nonstandard, _, err := s.getModules()
+	if err != nil {
+		return caddy.ExitCodeFailedStartup, fmt.Errorf("unable to enumerate installed plugins: %v", err)
+	}
+	pluginPkgs, err := s.getPluginPackages(nonstandard)
+	s.pluginPkgs = pluginPkgs
+	if err != nil {
+		return caddy.ExitCodeFailedStartup, err
+	}
+
+	return s.upgradeBuild(pluginPkgs, fl)
+}
