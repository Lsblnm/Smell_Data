+func (s *cliSession) cmdAddPackage(fl Flags) (int, error) {
+	if s.pluginPkgs == nil {
+		s.pluginPkgs = make(map[string]struct{})
+	}
+
+	if len(fl.Args()) == 0 {
+		return caddy.ExitCodeFailedStartup, fmt.Errorf("at least one package name must be specified")
+	}
+	_, nonstandard, _, err := s.getModules()
+	if err != nil {
+		return caddy.ExitCodeFailedStartup, fmt.Errorf("unable to enumerate installed plugins: %v", err)
+	}
+	pluginPkgs, err := s.getPluginPackages(nonstandard)
+	s.pluginPkgs = pluginPkgs
+	if err != nil {
+		return caddy.ExitCodeFailedStartup, err
+	}
+
+	for _, arg := range fl.Args() {
+		if _, ok := pluginPkgs[arg]; ok {
+			return caddy.ExitCodeFailedStartup, fmt.Errorf("package is already added")
+		}
+		pluginPkgs[arg] = struct{}{}
+	}
+
+	return s.upgradeBuild(pluginPkgs, fl)
+}
