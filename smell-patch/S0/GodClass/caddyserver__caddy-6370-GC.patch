+func (s *cliSession) getModules() (standard, nonstandard, unknown []moduleInfo, err error) {
+	s.moduleList = s.moduleList[:0]
+	standard, nonstandard, unknown, err = listBuildModules()
+	s.moduleList = append(s.moduleList, standard...)
+	s.moduleList = append(s.moduleList, nonstandard...)
+	s.moduleList = append(s.moduleList, unknown...)
+	for _, mod := range nonstandard {
+		if mod.goModule != nil {
+			if s.pluginPkgs == nil {
+				s.pluginPkgs = make(map[string]struct{})
+			}
+			s.pluginPkgs[mod.goModule.Path] = struct{}{}
+		}
+	}
+	return
+}
+
+func (s *cliSession) getPluginPackages(modules []moduleInfo) (map[string]struct{}, error) {
+	if s.pluginPkgs == nil {
+		s.pluginPkgs = make(map[string]struct{})
+	}
+	pluginPkgs := s.pluginPkgs
+	if pluginPkgs == nil {
+		pluginPkgs = make(map[string]struct{})
+		s.pluginPkgs = pluginPkgs
+	}
+	for _, mod := range modules {
+		if mod.goModule.Replace != nil {
+			return nil, fmt.Errorf("cannot auto-upgrade when Go module has been replaced: %s => %s",
+				mod.goModule.Path, mod.goModule.Replace.Path)
+		}
+		pluginPkgs[mod.goModule.Path] = struct{}{}
+	}
+	s.pluginPkgs = pluginPkgs
+	return pluginPkgs, nil
+}
+
+func (s *cliSession) downloadBuild(qs url.Values) (*http.Response, error) {
+	if s.pluginPkgs == nil {
+		s.pluginPkgs = make(map[string]struct{})
+	}
+
+	l := caddy.Log()
+	l.Info("requesting build",
+		zap.String("os", qs.Get("os")),
+		zap.String("arch", qs.Get("arch")),
+		zap.Strings("packages", qs["p"]))
+	resp, err := http.Get(fmt.Sprintf("%s?%s", downloadPath, qs.Encode()))
+	if err != nil {
+		return nil, fmt.Errorf("secure request failed: %v", err)
+	}
+	if resp.StatusCode >= 400 {
+		var details struct {
+			StatusCode int `json:"status_code"`
+			Error      struct {
+				Message string `json:"message"`
+				ID      string `json:"id"`
+			} `json:"error"`
+		}
+		err2 := json.NewDecoder(resp.Body).Decode(&details)
+		if err2 != nil {
+			return nil, fmt.Errorf("download and error decoding failed: HTTP %d: %v", resp.StatusCode, err2)
+		}
+		return nil, fmt.Errorf("download failed: HTTP %d: %s (id=%s)", resp.StatusCode, details.Error.Message, details.Error.ID)
+	}
+	return resp, nil
+}
+
+func (s *cliSession) writeCaddyBinary(path string, body *io.ReadCloser, fileInfo os.FileInfo) error {
+	s.execPath = path
+	path = s.execPath
+
+	l := caddy.Log()
+	destFile, err := os.OpenFile(path, os.O_RDWR|os.O_CREATE|os.O_TRUNC, fileInfo.Mode())
+	if err != nil {
+		return fmt.Errorf("unable to open destination file: %v", err)
+	}
+	defer destFile.Close()
+
+	l.Info("downloading binary", zap.String("destination", path))
+
+	_, err = io.Copy(destFile, *body)
+	if err != nil {
+		return fmt.Errorf("unable to download file: %v", err)
+	}
+
+	err = destFile.Sync()
+	if err != nil {
+		return fmt.Errorf("syncing downloaded file to device: %v", err)
+	}
+
+	return nil
+}
