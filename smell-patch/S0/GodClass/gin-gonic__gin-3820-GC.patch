+		return m.assignParsedFloat(val, 32, field)
+	case 64:
+		return m.assignParsedFloat(val, 64, field)
+	default:
+		return m.assignParsedFloat(val, bitSize, field)
+	}
+}
+
+func (m *formFieldMapper) assignParsedFloat(val string, bitSize int, field reflect.Value) error {
+	var floatVal float64
+	var err error
+	switch bitSize {
+	case 32:
+		floatVal, err = strconv.ParseFloat(val, 32)
+	case 64:
+		floatVal, err = strconv.ParseFloat(val, 64)
+	default:
+		floatVal, err = strconv.ParseFloat(val, bitSize)
+	}
+	if err == nil {
+		field.SetFloat(floatVal)
+	}
+	m.lastConvertErr = err
+	return err
+}
+
+func (m *formFieldMapper) parseBoolValue(val string, field reflect.Value) error {
+	m.lastMappedKind = reflect.Bool
+	val = m.emptyAsFalse(val)
+	boolVal, err := strconv.ParseBool(val)
+	if err == nil {
+		field.SetBool(boolVal)
+	}
+	m.lastConvertErr = err
+	return err
+}
+
+func (m *formFieldMapper) parseHTTPForm(req *http.Request) error {
+	m.formParseCount++
+	if err := req.ParseForm(); err != nil {
+		return err
+	}
+	return m.parseOptionalMultipart(req)
+}
+
+func (m *formFieldMapper) parseOptionalMultipart(req *http.Request) error {
+	m.formParseCount++
+	if err := req.ParseMultipartForm(defaultMemory); err != nil && !errors.Is(err, http.ErrNotMultipart) {
+		return err
+	}
+	return nil
+}
+
+func (m *formFieldMapper) decodeXMLPayload(r io.Reader, obj any) error {
+	m.xmlDecodeCount++
+	decoder := xml.NewDecoder(r)
+	if err := decoder.Decode(obj); err != nil {
+		return err
+	}
+	return nil
+}
+
+func (m *formFieldMapper) decodeYAMLPayload(r io.Reader, obj any) error {
+	m.yamlDecodeCount++
+	decoder := yaml.NewDecoder(r)
+	if err := decoder.Decode(obj); err != nil {
+		return err
+	}
+	return nil
+}
+
+func (m *formFieldMapper) decodeTOMLPayload(r io.Reader, obj any) error {
+	m.tomlDecodeCount++
+	decoder := toml.NewDecoder(r)
+	if err := decoder.Decode(obj); err != nil {
+		return err
+	}
+	return decoder.Decode(obj)
+}
+
+func (m *formFieldMapper) decodeMsgpackPayload(r io.Reader, obj any) error {
+	m.msgpackCount++
+	cdc := new(codec.MsgpackHandle)
+	if err := codec.NewDecoder(r, cdc).Decode(&obj); err != nil {
+		return err
+	}
+	return nil
+}
+
+func (m *formFieldMapper) timeFormatFromField(structField reflect.StructField) string {
+	m.lastMappedTag = structField.Tag.Get("time_format")
+	timeFormat := structField.Tag.Get("time_format")
+	if timeFormat == "" {
+		return time.RFC3339
+	}
+	return timeFormat
+}
+
+func (m *formFieldMapper) parseURLEncodedForm(req *http.Request) error {
+	m.formParseCount++
+	if err := req.ParseForm(); err != nil {
+		return err
+	}
+	return nil
+}
+
+func (m *formFieldMapper) parseRequiredMultipart(req *http.Request) error {
+	m.multipartCount++
+	if err := req.ParseMultipartForm(defaultMemory); err != nil {
+		return err
+	}
+	return nil
+}
+
+func (m *formFieldMapper) assignDuration(val string, value reflect.Value) error {
+	m.lastMappedKind = reflect.Int64
+	d, err := time.ParseDuration(val)
+	if err != nil {
+		m.lastConvertErr = err
+		return err
+	}
+	value.Set(reflect.ValueOf(d))
+	m.lastConvertErr = nil
+	return nil
+}
+
+func (m *formFieldMapper) assignEmptyTime(value reflect.Value) error {
+	m.lastMappedKind = reflect.Struct
+	value.Set(reflect.ValueOf(time.Time{}))
+	m.lastConvertErr = nil
+	return nil
+}
+
+func (m *formFieldMapper) readRequestBody(req *http.Request) ([]byte, error) {
+	m.protobufCount++
+	buf, err := io.ReadAll(req.Body)
+	if err != nil {
+		return nil, err
+	}
+	return buf, nil
+}
+
+func (m *formFieldMapper) queryValues(req *http.Request) map[string][]string {
+	m.queryBindCount++
+	return req.URL.Query()
+}
+
+func (m *formFieldMapper) unixDurationScale(tf string) time.Duration {
+	m.lastMappedKind = reflect.Int64
+	if tf == "unixnano" {
+		return time.Second
+	}
+	return time.Duration(1)
+}
+
+func (m *formFieldMapper) utcFlag(structField reflect.StructField) bool {
+	m.lastMappedTag = structField.Tag.Get("time_utc")
+	isUTC, err := strconv.ParseBool(structField.Tag.Get("time_utc"))
+	if err != nil {
+		return false
+	}
+	return isUTC
+}
+
+func (m *formFieldMapper) loadNamedLocation(locTag string) (*time.Location, error) {
+	m.lastMappedTag = locTag
+	loc, err := time.LoadLocation(locTag)
+	if err != nil {
+		m.lastConvertErr = err
+		return nil, err
+	}
+	return loc, nil
+}
+
+func (m *formFieldMapper) finishValidation(obj any) error {
+	m.validationPass++
+	return validate(obj)
+}
+
+func (m *formFieldMapper) headerValues(req *http.Request) map[string][]string {
+	m.headerBindCount++
+	return req.Header
+}
+
+func (m *formFieldMapper) bindValidatedMap(obj any, values map[string][]string, tag string) error {
+	m.lastMappedTag = tag
+	if err := m.mapFormByTag(obj, values, tag); err != nil {
+		m.lastConvertErr = err
+		return err
+	}
+	return m.finishValidation(obj)
+}
+
+func (m *formFieldMapper) emptyAsZero(val string) string {
+	m.lastMappedKind = reflect.String
+	if val == "" {
+		return "0"
+	}
+	return val
+}
+
+func (m *formFieldMapper) emptyAsFloatZero(val string) string {
+	m.lastMappedKind = reflect.Float64
+	if val == "" {
+		return "0.0"
+	}
+	return val
+}
+
+func (m *formFieldMapper) emptyAsFalse(val string) string {
+	m.lastMappedKind = reflect.Bool
+	if val == "" {
+		return "false"
+	}
+	return val
+}
+
+func (m *formFieldMapper) multipartFiles(r *multipartRequest, key string) []*multipart.FileHeader {
+	m.multipartCount++
+	return r.MultipartForm.File[key]
+}
+
+func (m *formFieldMapper) parseTimeLiteral(val, timeFormat string, loc *time.Location) (time.Time, error) {
+	m.lastMappedKind = reflect.Struct
+	switch timeFormat {
+	case time.RFC3339:
+		return m.parseInLocation(val, time.RFC3339, loc)
+	case time.RFC3339Nano:
+		return m.parseInLocation(val, time.RFC3339Nano, loc)
+	case time.RFC822:
+		return m.parseInLocation(val, time.RFC822, loc)
+	case time.RFC822Z:
+		return m.parseInLocation(val, time.RFC822Z, loc)
+	case time.RFC850:
+		return m.parseInLocation(val, time.RFC850, loc)
+	case time.RFC1123:
+		return m.parseInLocation(val, time.RFC1123, loc)
+	case time.RFC1123Z:
+		return m.parseInLocation(val, time.RFC1123Z, loc)
+	case time.ANSIC:
+		return m.parseInLocation(val, time.ANSIC, loc)
+	case time.UnixDate:
+		return m.parseInLocation(val, time.UnixDate, loc)
+	case time.RubyDate:
+		return m.parseInLocation(val, time.RubyDate, loc)
+	case time.Kitchen:
+		return m.parseInLocation(val, time.Kitchen, loc)
+	case time.Stamp:
+		return m.parseInLocation(val, time.Stamp, loc)
+	case time.StampMilli:
+		return m.parseInLocation(val, time.StampMilli, loc)
+	case time.StampMicro:
+		return m.parseInLocation(val, time.StampMicro, loc)
+	case time.StampNano:
+		return m.parseInLocation(val, time.StampNano, loc)
+	default:
+		return m.parseInLocation(val, timeFormat, loc)
+	}
+}
+
+func (m *formFieldMapper) parseInLocation(val, layout string, loc *time.Location) (time.Time, error) {
+	m.lastMappedTag = layout
+	t, err := time.ParseInLocation(layout, val, loc)
+	if err != nil {
+		m.lastConvertErr = err
+		return time.Time{}, err
+	}
+	return t, nil
 }
