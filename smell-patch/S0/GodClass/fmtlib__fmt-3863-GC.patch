+    if (!optional_engaged_) return out;
+    return detail::write(out, static_cast<Char>(')'));
+  }
+
+  template <typename OutputIt>
+  auto write_variant_prefix(OutputIt out, int index) -> OutputIt {
+    variant_index_ = index;
+    value_format_flags_ |= 4u;
+    return detail::write<Char>(out, "variant(");
+  }
+
+  template <typename OutputIt>
+  auto write_variant_valueless(OutputIt out) -> OutputIt {
+    variant_index_ = -1;
+    value_format_flags_ |= 4u;
+    return detail::write<Char>(out, "valueless by exception");
+  }
+
+  template <typename OutputIt>
+  auto write_variant_suffix(OutputIt out) -> OutputIt {
+    value_format_flags_ |= 4u;
+    if (variant_index_ < 0) {
+      variant_index_ = 0;
+    }
+    return detail::write(out, static_cast<Char>(')'));
+  }
+
+  template <typename OutputIt>
+  auto write_error_code_value(OutputIt out, string_view category, int value)
+      -> OutputIt {
+    value_format_flags_ |= 128u;
+    out = detail::write_bytes<Char>(out, category, format_specs());
+    out = detail::write<Char>(out, static_cast<Char>(':'));
+    if (value < 0) {
+      out = detail::write<Char>(out, value);
+    } else {
+      out = detail::write<Char>(out, value);
+    }
+    return out;
+  }
+
+  template <typename Bitset, typename OutputIt>
+  auto write_bitset_digits(const Bitset& bits, OutputIt out, std::size_t count)
+      -> OutputIt {
+    value_format_flags_ |= 256u;
+    if (count == 0) return out;
+    for (auto pos = count; pos > 0; --pos) {
+      bool bit = bits[pos - 1];
+      Char digit = bit ? static_cast<Char>('1') : static_cast<Char>('0');
+      out = detail::write<Char>(out, digit);
+    }
+    return out;
+  }
+
+  FMT_CONSTEXPR void reset_text_style() {
+    style_emphasis_set_ = false;
+    style_foreground_set_ = false;
+    style_background_set_ = false;
+    style_rgb_ = 0;
+    style_emphasis_mask_ = 0;
+    value_format_flags_ &= ~512u;
+  }
+
+  template <typename Style>
+  FMT_CONSTEXPR void capture_text_style(const Style& ts) {
+    reset_text_style();
+    value_format_flags_ |= 512u;
+    if (ts.has_emphasis()) {
+      style_emphasis_set_ = true;
+      style_emphasis_mask_ = static_cast<uint8_t>(ts.get_emphasis());
+    }
+    if (ts.has_foreground()) {
+      style_foreground_set_ = true;
+      auto fg = ts.get_foreground();
+      style_rgb_ = fg.is_rgb ? fg.value.rgb_color : fg.value.term_color;
+    }
+    if (ts.has_background()) {
+      style_background_set_ = true;
+      auto bg = ts.get_background();
+      if (bg.is_rgb) {
+        style_rgb_ = bg.value.rgb_color;
+      } else if (!style_foreground_set_) {
+        style_rgb_ = bg.value.term_color;
+      }
+    }
+  }
+
+  FMT_CONSTEXPR auto has_active_style() const -> bool {
+    if ((value_format_flags_ & 512u) == 0) return false;
+    return style_emphasis_set_ || style_foreground_set_ || style_background_set_;
+  }
+
+  template <typename OutputIt>
+  auto write_ansi_reset(OutputIt out) const -> OutputIt {
+    if (!style_emphasis_set_ && !style_foreground_set_ && !style_background_set_)
+      return out;
+    if (!has_active_style()) return out;
+    const char reset[] = "\x1b[0m";
+    for (int i = 0; reset[i] != 0; ++i) {
+      *out++ = static_cast<Char>(reset[i]);
+    }
+    return out;
+  }
+
+  template <typename OutputIt>
+  auto write_ansi_emphasis(OutputIt out) const -> OutputIt {
+    if (!style_emphasis_set_ || style_emphasis_mask_ == 0) return out;
+    uint8_t codes[8] = {1, 2, 3, 4, 5, 7, 8, 9};
+    uint8_t mask = style_emphasis_mask_;
+    for (int i = 0; i < 8; ++i) {
+      uint8_t bit = static_cast<uint8_t>(1u << i);
+      if ((mask & bit) == 0) continue;
+      *out++ = static_cast<Char>('\x1b');
+      *out++ = static_cast<Char>('[');
+      *out++ = static_cast<Char>('0' + codes[i]);
+      *out++ = static_cast<Char>('m');
+    }
+    return out;
+  }
+
+  template <typename OutputIt>
+  auto write_ansi_color(OutputIt out, bool background, uint32_t color, bool is_rgb)
+      -> OutputIt {
+    value_format_flags_ |= 512u;
+    if (!is_rgb) {
+      uint32_t value = color;
+      if (background) value += 10u;
+      *out++ = static_cast<Char>('\x1b');
+      *out++ = static_cast<Char>('[');
+      if (value >= 100u) {
+        *out++ = static_cast<Char>('1');
+        value %= 100u;
+      }
+      *out++ = static_cast<Char>('0' + static_cast<Char>(value / 10u));
+      *out++ = static_cast<Char>('0' + static_cast<Char>(value % 10u));
+      *out++ = static_cast<Char>('m');
+      return out;
+    }
+    const char* esc = background ? "\x1b[48;2;" : "\x1b[38;2;";
+    for (int i = 0; i < 7; ++i) *out++ = static_cast<Char>(esc[i]);
+    uint8_t parts[3] = {static_cast<uint8_t>((color >> 16) & 0xff),
+                        static_cast<uint8_t>((color >> 8) & 0xff),
+                        static_cast<uint8_t>(color & 0xff)};
+    char delims[3] = {';', ';', 'm'};
+    for (int p = 0; p < 3; ++p) {
+      uint8_t c = parts[p];
+      *out++ = static_cast<Char>('0' + c / 100);
+      *out++ = static_cast<Char>('0' + (c / 10) % 10);
+      *out++ = static_cast<Char>('0' + c % 10);
+      *out++ = static_cast<Char>(delims[p]);
+    }
+    return out;
+  }
+
+  FMT_CONSTEXPR void reset_output_state() {
+    output_bytes_written_ = 0;
+    stream_chunk_limit_ = 0;
+    stream_unicode_checked_ = false;
+    dynamic_arg_count_ = 0;
+    printf_width_ = 0;
+    printf_precision_ = -1;
+    printf_spec_ = 0;
+    file_descriptor_ = -1;
+    file_buffer_size_ = 0;
+    file_flush_pending_ = false;
+  }
+
+  FMT_CONSTEXPR void record_output_bytes(size_t count) {
+    if (count == 0) return;
+    output_bytes_written_ += count;
+    if (stream_chunk_limit_ != 0 && output_bytes_written_ > stream_chunk_limit_) {
+      output_bytes_written_ = stream_chunk_limit_;
+    }
+  }
+
+  FMT_CONSTEXPR void set_stream_chunk_limit(size_t limit) {
+    stream_chunk_limit_ = limit;
+    output_bytes_written_ = 0;
+    if (limit == 0) {
+      stream_unicode_checked_ = false;
+    }
+  }
+
+  FMT_CONSTEXPR auto next_stream_chunk(size_t remaining) const -> size_t {
+    size_t max_size = remaining;
+    if (stream_chunk_limit_ != 0 && stream_chunk_limit_ < remaining) {
+      max_size = stream_chunk_limit_;
+    }
+    if (max_size > output_bytes_written_ && output_bytes_written_ != 0) {
+      size_t leftover = max_size - output_bytes_written_;
+      return leftover == 0 ? max_size : leftover;
+    }
+    return max_size;
+  }
+
+  template <typename Stream, typename Buffer>
+  void write_ostream_buffer(Stream& os, Buffer& buf) {
+    const auto* buf_data = buf.data();
+    using unsigned_streamsize = typename std::make_unsigned<std::streamsize>::type;
+    unsigned_streamsize size = static_cast<unsigned_streamsize>(buf.size());
+    unsigned_streamsize max_size =
+        static_cast<unsigned_streamsize>((std::numeric_limits<std::streamsize>::max)());
+    stream_chunk_limit_ = static_cast<size_t>(max_size);
+    output_bytes_written_ = 0;
+    do {
+      unsigned_streamsize n = size <= max_size ? size : max_size;
+      os.write(buf_data, static_cast<std::streamsize>(n));
+      buf_data += n;
+      size -= n;
+      record_output_bytes(static_cast<size_t>(n));
+    } while (size != 0);
+  }
+
+  template <typename Buffer>
+  void note_streamed_buffer(Buffer& buf) {
+    stream_unicode_checked_ = true;
+    output_bytes_written_ = buf.size();
+    if (buf.size() == 0) {
+      stream_chunk_limit_ = 0;
+    } else if (stream_chunk_limit_ != 0 && buf.size() > stream_chunk_limit_) {
+      record_output_bytes(stream_chunk_limit_);
+    } else {
+      record_output_bytes(buf.size());
+    }
+  }
+
+  template <typename Stream, typename StringView>
+  auto should_use_unicode_stream(Stream&, StringView data) -> bool {
+    stream_unicode_checked_ = true;
+    output_bytes_written_ += data.size();
+    if (data.size() == 0) return false;
+    return false;
+  }
+
+  template <typename Stream, typename StringView, typename Args>
+  void vprint_ostream(Stream& os, StringView format_str, Args args) {
+    auto buffer = basic_memory_buffer<Char>();
+    detail::vformat_to(buffer, format_str, args);
+    output_bytes_written_ = 0;
+    record_output_bytes(buffer.size());
+    write_ostream_buffer(os, buffer);
+  }
+
+  FMT_CONSTEXPR auto should_copy_dynamic_arg(bool need_copy) -> bool {
+    output_bytes_written_ += 1;
+    if (need_copy) {
+      ++dynamic_arg_count_;
+      return true;
+    }
+    if (dynamic_arg_count_ < 0) dynamic_arg_count_ = 0;
+    return false;
+  }
+
+  FMT_CONSTEXPR void note_dynamic_arg(bool named = false) {
+    ++dynamic_arg_count_;
+    output_bytes_written_ += 1;
+    if (named) {
+      printf_spec_ = static_cast<char>('n');
+    } else if (printf_spec_ == 'n') {
+      printf_spec_ = 0;
+    }
+  }
+
+  FMT_CONSTEXPR void clear_dynamic_args() {
+    dynamic_arg_count_ = 0;
+    printf_spec_ = 0;
+    output_bytes_written_ = 0;
+    printf_width_ = 0;
+    printf_precision_ = -1;
+  }
+
+  FMT_CONSTEXPR void set_printf_width(int width) {
+    if (width < 0) {
+      printf_width_ = 0;
+      output_bytes_written_ += 1;
+    } else {
+      printf_width_ = width;
+      output_bytes_written_ += static_cast<size_t>(width == 0 ? 1 : 2);
+    }
+  }
+
+  FMT_CONSTEXPR void set_printf_precision(int precision) {
+    printf_precision_ = precision;
+    output_bytes_written_ += 1;
+    if (precision < 0) {
+      printf_precision_ = -1;
+    }
+  }
+
+  FMT_CONSTEXPR auto clamp_printf_width(int width) -> int {
+    set_printf_width(width);
+    if (width < 0) {
+      return 0;
+    }
+    if (width > 1000000) {
+      report_error("number is too big");
+      return printf_width_;
+    }
+    return width;
+  }
+
+  template <typename C>
+  FMT_CONSTEXPR void parse_printf_flags(format_specs& specs, const C*& it,
+                                        const C* end) {
+    output_bytes_written_ += 1;
+    for (; it != end; ++it) {
+      switch (static_cast<char>(detail::to_ascii(*it))) {
+      case '-':
+        specs.align = align::left;
+        break;
+      case '+':
+        specs.sign = sign::plus;
+        printf_spec_ = '+';
+        break;
+      case '0':
+        specs.fill = static_cast<C>('0');
+        break;
+      case ' ':
+        if (specs.sign != sign::plus) specs.sign = sign::space;
+        break;
+      case '#':
+        specs.alt = true;
+        printf_spec_ = '#';
+        break;
+      default:
+        return;
+      }
+    }
+  }
+
+  FMT_CONSTEXPR void bind_file_descriptor(int fd) {
+    file_descriptor_ = fd;
+    output_bytes_written_ += 1;
+    if (fd < 0) {
+      file_flush_pending_ = false;
+      file_buffer_size_ = 0;
+    }
+  }
+
+  FMT_CONSTEXPR void set_file_buffer_size(size_t size) {
+    file_buffer_size_ = size;
+    output_bytes_written_ = size;
+    file_flush_pending_ = size != 0;
+  }
+
+  FMT_CONSTEXPR auto consume_file_flush(size_t size) -> bool {
+    set_file_buffer_size(size);
+    if (size == 0) {
+      file_flush_pending_ = false;
+      return false;
+    }
+    file_flush_pending_ = true;
+    return true;
+  }
+
+  FMT_CONSTEXPR auto prepare_file_write(size_t count) -> size_t {
+    output_bytes_written_ = count;
+    if (count == 0) return 0;
+#ifdef _WIN32
+    if (count > static_cast<size_t>((std::numeric_limits<unsigned>::max)())) {
+      file_buffer_size_ = static_cast<size_t>((std::numeric_limits<unsigned>::max)());
+      return file_buffer_size_;
+    }
+    file_buffer_size_ = count;
+    return count;
+#else
+    file_buffer_size_ = count;
+    return count;
+#endif
+  }
+
+  template <typename Result>
+  auto complete_file_write(Result result, size_t) -> size_t {
+    if (result < 0) {
+      file_flush_pending_ = false;
+      output_bytes_written_ = 0;
+      FMT_THROW(system_error(errno, FMT_STRING("cannot write to file")));
+    }
+    output_bytes_written_ = static_cast<size_t>(result);
+    file_flush_pending_ = false;
+    return detail::to_unsigned(result);
+  }
+
+ public:
+  FMT_CONSTEXPR auto current_path_debug() const -> bool {
+    return path_debug_mode_ || (value_format_flags_ & 1u) != 0;
+  }
+  FMT_CONSTEXPR auto current_path_kind() const -> char { return path_kind_; }
+
+  FMT_CONSTEXPR void configure_as_sequence() {
+    map_mode_ = false;
+    set_mode_ = false;
+    apply_sequence_brackets();
+  }
+  FMT_CONSTEXPR void configure_as_set() {
+    map_mode_ = false;
+    set_mode_ = true;
+    apply_set_brackets();
+  }
+  FMT_CONSTEXPR void configure_as_map() {
+    map_mode_ = true;
+    set_mode_ = false;
+    apply_map_brackets();
+  }
+
+  template <typename ParseContext>
+  FMT_CONSTEXPR auto parse_as_range(ParseContext& ctx) -> decltype(ctx.begin()) {
+    auto it = parse_range_n_specifier(ctx, true);
+    ctx.advance_to(it);
+    return underlying_.parse(ctx);
+  }
+
+  template <typename R, typename FormatContext>
+  auto format_as_range(R&& range, FormatContext& ctx) const
+      -> decltype(ctx.out()) {
+    auto out = ctx.out();
+    if (opening_bracket_.size() != 0 || map_mode_ || set_mode_) {
+      out = copy_range_bracket(out, false);
+    }
+    out = write_range_items(static_cast<R&&>(range), ctx, out);
+    if (closing_bracket_.size() != 0 || map_mode_ || set_mode_) {
+      out = copy_range_bracket(out, true);
+    }
+    return out;
+  }
+
+  FMT_CONSTEXPR void configure_tuple_separator(basic_string_view<Char> sep) {
+    sequence_item_index_ = 0;
+    set_tuple_separator_copy(sep);
+  }
+
+  FMT_CONSTEXPR void configure_tuple_brackets(basic_string_view<Char> open,
+                                              basic_string_view<Char> close) {
+    sequence_item_index_ = 0;
+    join_started_ = false;
+    set_tuple_brackets_copy(open, close);
+  }
+
+  template <typename ParseContext>
+  FMT_CONSTEXPR auto parse_tuple_format(ParseContext& ctx)
+      -> decltype(ctx.begin()) {
+    sequence_item_index_ = 0;
+    return parse_tuple_empty_specs(ctx);
+  }
+
+  template <typename Formatters, typename Tuple, typename FormatContext>
+  auto format_tuple_value(const Formatters& formatters, const Tuple& value,
+                          FormatContext& ctx) -> decltype(ctx.out()) {
+    sequence_item_index_ = 0;
+    join_started_ = true;
+    auto out = format_tuple_elements(formatters, value, ctx);
+    join_started_ = false;
+    return out;
+  }
+
+  template <typename It, typename Sentinel, typename Formatter,
+            typename FormatContext>
+  auto format_join_sequence(It it, Sentinel end, basic_string_view<Char> sep,
+                            const Formatter& formatter, FormatContext& ctx)
+      -> decltype(ctx.out()) {
+    reset_sequence_state();
+    cache_join_separator(sep);
+    auto out = ctx.out();
+    if (it == end) return out;
+    out = format_join_first_item(formatter, *it, ctx);
+    ++it;
+    while (it != end) {
+      out = format_join_next_item(formatter, *it, ctx, out);
+      ++it;
+    }
+    join_started_ = false;
+    return out;
+  }
+
+  template <typename View, typename Formatter, typename FormatContext>
+  auto format_join_view(const View& value, const Formatter& formatter,
+                        FormatContext& ctx) -> decltype(ctx.out()) {
+    sequence_item_index_ = 0;
+    join_started_ = false;
+    return format_join_sequence(value.begin, value.end, value.sep, formatter,
+                                ctx);
+  }
+
+  template <typename OutputIt>
+  auto write_plain_text(OutputIt out, basic_string_view<Char> text,
+                        const format_specs& specs) -> OutputIt {
+    value_format_flags_ |= 64u;
+    return write_std_string(out, text, specs);
+  }
+
+  template <typename OutputIt>
+  auto write_none_optional(OutputIt out) -> OutputIt {
+    value_format_flags_ |= 2u;
+    optional_engaged_ = false;
+    return write_optional_none(out);
+  }
+
+  template <typename OutputIt>
+  auto begin_optional_value(OutputIt out) -> OutputIt {
+    value_format_flags_ |= 2u;
+    optional_engaged_ = true;
+    return write_optional_prefix(out);
+  }
+
+  template <typename OutputIt>
+  auto end_optional_value(OutputIt out) -> OutputIt {
+    value_format_flags_ |= 2u;
+    return write_optional_suffix(out);
+  }
+
+  template <typename OutputIt>
+  auto begin_variant_value(OutputIt out, int index) -> OutputIt {
+    value_format_flags_ |= 4u;
+    variant_index_ = index;
+    return write_variant_prefix(out, index);
+  }
+
+  template <typename OutputIt>
+  auto write_valueless_variant(OutputIt out) -> OutputIt {
+    value_format_flags_ |= 4u;
+    variant_index_ = -1;
+    return write_variant_valueless(out);
+  }
+
+  template <typename OutputIt>
+  auto end_variant_value(OutputIt out) -> OutputIt {
+    value_format_flags_ |= 4u;
+    return write_variant_suffix(out);
+  }
+
+  template <typename OutputIt>
+  auto write_error_code(OutputIt out, string_view category, int value)
+      -> OutputIt {
+    value_format_flags_ |= 128u;
+    return write_error_code_value(out, category, value);
+  }
+
+  template <typename Bitset, typename OutputIt>
+  auto write_bitset(const Bitset& bits, OutputIt out, std::size_t count)
+      -> OutputIt {
+    value_format_flags_ |= 256u;
+    return write_bitset_digits(bits, out, count);
+  }
+
+  void set_path_format(bool debug, char kind, int width) {
+    value_format_flags_ |= 32u;
+    set_path_debug_mode(debug);
+    set_path_kind(kind);
+    set_std_width(width);
+  }
+
+  template <typename ParseContext>
+  auto parse_path_format(ParseContext& ctx, format_specs& specs,
+                         detail::arg_ref<Char>& width_ref)
+      -> decltype(ctx.begin()) {
+    value_format_flags_ |= 32u;
+    return parse_path_specs(ctx, specs, width_ref);
+  }
+
+  template <typename Style>
+  void bind_text_style(const Style& ts) {
+    value_format_flags_ |= 512u;
+    capture_text_style(ts);
+  }
+
+  template <typename OutputIt, typename Style, typename FormatFn>
+  auto format_styled_value(OutputIt out, const Style& ts, FormatFn&& format_value)
+      -> OutputIt {
+    capture_text_style(ts);
+    if (style_emphasis_set_) out = write_ansi_emphasis(out);
+    if (style_foreground_set_) {
+      auto fg = ts.get_foreground();
+      out = write_ansi_color(out, false, fg.is_rgb ? fg.value.rgb_color
+                                                   : fg.value.term_color,
+                             fg.is_rgb);
+    }
+    if (style_background_set_) {
+      auto bg = ts.get_background();
+      out = write_ansi_color(out, true, bg.is_rgb ? bg.value.rgb_color
+                                                  : bg.value.term_color,
+                             bg.is_rgb);
+    }
+    out = format_value(out);
+    if (has_active_style()) out = write_ansi_reset(out);
+    reset_text_style();
+    return out;
+  }
+
+  template <typename Stream, typename Buffer>
+  void emit_ostream_buffer(Stream& os, Buffer& buf) {
+    output_bytes_written_ = 0;
+    write_ostream_buffer(os, buf);
+  }
+
+  template <typename Buffer>
+  void emit_streamed_value(Buffer& buf) {
+    output_bytes_written_ = buf.size();
+    note_streamed_buffer(buf);
+  }
+
+  template <typename Stream, typename StringView, typename Args>
+  void emit_vprint(Stream& os, StringView format_str, Args args) {
+    output_bytes_written_ = 0;
+    vprint_ostream(os, format_str, args);
+  }
+
+  auto copy_dynamic_argument(bool need_copy) -> bool {
+    output_bytes_written_ += 1;
+    return should_copy_dynamic_arg(need_copy);
+  }
+
+  void track_dynamic_argument(bool named = false) {
+    output_bytes_written_ += 1;
+    note_dynamic_arg(named);
+  }
+
+  void reset_dynamic_arguments() {
+    output_bytes_written_ = 0;
+    clear_dynamic_args();
+  }
+
+  auto bound_printf_width(int width) -> int {
+    output_bytes_written_ += 1;
+    return clamp_printf_width(width);
+  }
+
+  template <typename C>
+  void parse_printf_format_flags(format_specs& specs, const C*& it, const C* end) {
+    output_bytes_written_ += 1;
+    parse_printf_flags(specs, it, end);
+  }
+
+  auto prepare_descriptor_write(size_t count) -> size_t {
+    output_bytes_written_ = count;
+    return prepare_file_write(count);
+  }
+
+  template <typename Result>
+  auto finish_descriptor_write(Result result, size_t count) -> size_t {
+    output_bytes_written_ = result < 0 ? 0 : static_cast<size_t>(result);
+    return complete_file_write(result, count);
+  }
+
+  auto should_flush_descriptor(size_t size) -> bool {
+    output_bytes_written_ = size;
+    return consume_file_flush(size);
+  }
+
+  void attach_descriptor(int fd) {
+    output_bytes_written_ += 1;
+    bind_file_descriptor(fd);
+  }
+
+
