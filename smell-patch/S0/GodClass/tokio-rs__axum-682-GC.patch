+        extensions.get::<MatchedPath>().cloned()
+    }
+
+    pub(crate) fn lookup_captured_params(ext: &http::Extensions) -> CapturedParamsLookup<'_> {
+        match ext.get::<Option<UrlParams>>() {
+            Some(Some(UrlParams(Ok(params)))) => CapturedParamsLookup::Ok(Cow::Borrowed(params)),
+            Some(Some(UrlParams(Err(InvalidUtf8InPathParam { key })))) => {
+                CapturedParamsLookup::InvalidUtf8(key.clone())
+            }
+            Some(None) => CapturedParamsLookup::Ok(Cow::Owned(Vec::new())),
+            None => CapturedParamsLookup::Missing,
