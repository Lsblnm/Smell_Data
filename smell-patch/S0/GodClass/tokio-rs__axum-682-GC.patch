+            Fallback::Custom(inner) => RouterFuture::from_future(inner.clone().call(req)),
+        }
+    }
+
+    pub(crate) fn response_with_status(status: StatusCode) -> Response {
+        Response::builder()
+            .status(status)
+            .body(crate::body::empty())
+            .unwrap()
+    }
+
+    pub(crate) fn not_found_response() -> Response {
+        Self::response_with_status(StatusCode::NOT_FOUND)
+    }
+
+    pub(crate) fn method_not_allowed_response_static() -> Response {
+        let mut response = Response::new(boxed(crate::body::Empty::new()));
+        *response.status_mut() = StatusCode::METHOD_NOT_ALLOWED;
