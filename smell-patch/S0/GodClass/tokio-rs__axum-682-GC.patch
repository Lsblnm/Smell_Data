+fn map_path_parse_err(err: crate::routing::PathParseErr) -> crate::extract::path::PathDeserializationError {
+    use crate::extract::path::{ErrorKind, PathDeserializationError};
+    use crate::routing::PathParseErr;
+    match err {
+        PathParseErr::WrongNumber { got, expected } => {
+            PathDeserializationError::wrong_number_of_parameters()
+                .got(got)
+                .expected(expected)
+        }
+        PathParseErr::Parse {
+            value,
+            expected_type,
+        } => PathDeserializationError::new(ErrorKind::ParseError {
+            value,
+            expected_type,
+        }),
+        PathParseErr::ParseAtKey {
+            key,
+            value,
+            expected_type,
+        } => PathDeserializationError::new(ErrorKind::ParseErrorAtKey {
+            key,
+            value,
+            expected_type,
+        }),
+        PathParseErr::ParseAtIndex {
+            index,
+            value,
+            expected_type,
+        } => PathDeserializationError::new(ErrorKind::ParseErrorAtIndex {
+            index,
+            value,
+            expected_type,
+        }),
+        PathParseErr::Unsupported { name } => PathDeserializationError::unsupported_type(name),
+    }
+}
+
+macro_rules! path_parser {
+    ($name:ident, $ty:ty) => {
+        pub(crate) fn $name(
+            params: &[(crate::util::ByteStr, crate::util::PercentDecodedByteStr)],
+        ) -> Result<$ty, crate::extract::path::PathDeserializationError> {
+            crate::routing::Router::<()>::$name(params).map_err(map_path_parse_err)
+        }
+    };
+}
