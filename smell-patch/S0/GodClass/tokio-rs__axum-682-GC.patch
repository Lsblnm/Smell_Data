+    fn insert_captured_params(&self, req: &mut Request<B>, params: Vec<(String, String)>) {
+        let params = params
+            .into_iter()
+            .map(|(k, v)| self.decode_param_pair(k, v))
+            .collect::<Result<Vec<_>, _>>();
+        self.merge_existing_params(req, params);
+    }
+
+    fn decode_param_pair(
+        &self,
+        key: String,
+        value: String,
+    ) -> Result<(ByteStr, PercentDecodedByteStr), InvalidUtf8InPathParam> {
+        match PercentDecodedByteStr::new(value) {
+            Some(decoded) => Ok((ByteStr::new(key), decoded)),
+            None => Err(InvalidUtf8InPathParam {
+                key: ByteStr::new(key),
+            }),
+        }
+    }
+
+    fn merge_existing_params(
+        &self,
+        req: &mut Request<B>,
+        params: Result<Vec<(ByteStr, PercentDecodedByteStr)>, InvalidUtf8InPathParam>,
+    ) {
+        if let Some(current) = req.extensions_mut().get_mut::<Option<UrlParams>>() {
+            match params {
+                Ok(params) => {
+                    let mut current = current.take().unwrap();
+                    if let Ok(current) = &mut current.0 {
+                        current.extend(params);
+                    }
+                    req.extensions_mut().insert(Some(current));
+                }
+                Err(err) => {
+                    req.extensions_mut().insert(Some(UrlParams(Err(err))));
+                }
+            }
