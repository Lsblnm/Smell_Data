+    pub(crate) fn parse_value_at_key_or_index<T>(
+        key: Option<&PathKeyOrIdx>,
+        value: &str,
+        expected_type: &'static str,
+    ) -> Result<T, PathParseErr>
+    where
+        T: std::str::FromStr,
+    {
+        value.parse().map_err(|_| match key {
+            Some(PathKeyOrIdx::Key(key)) => {
+                Self::path_parse_failure_at_key(key.as_str(), value, expected_type)
+            }
+            Some(PathKeyOrIdx::Idx(index)) => {
+                Self::path_parse_failure_at_index(*index, value, expected_type)
+            }
+            None => Self::path_parse_failure(value, expected_type),
+        })
+    }
