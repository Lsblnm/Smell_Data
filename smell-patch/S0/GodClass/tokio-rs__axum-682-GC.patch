+        second: Option<Route<B, E>>,
+        method_name: &'static str,
+    ) -> Option<Route<B, E>> {
+        match (first, second) {
+            (Some(_), Some(_)) => panic!(
+                "Overlapping method route. Cannot merge two method routes that both define `{}`",
+                method_name
+            ),
+            (Some(svc), None) => Some(svc),
+            (None, Some(svc)) => Some(svc),
+            (None, None) => None,
+        }
+    }
+
+    pub(crate) fn merge_method_fallbacks<E>(
+        first: Fallback<B, E>,
+        second: Fallback<B, E>,
+    ) -> Fallback<B, E> {
+        match (first, second) {
+            (pick @ Fallback::Default(_), Fallback::Default(_)) => pick,
+            (Fallback::Default(_), pick @ Fallback::Custom(_)) => pick,
+            (pick @ Fallback::Custom(_), Fallback::Default(_)) => pick,
+            (Fallback::Custom(_), Fallback::Custom(_)) => {
+                panic!("Cannot merge two `MethodRouter`s that both have a fallback")
+            }
+        }
+    }
+
+    pub(crate) fn dispatch_method_router<E>(
+        req: Request<B>,
+        get: Option<&Route<B, E>>,
+        head: Option<&Route<B, E>>,
+        delete: Option<&Route<B, E>>,
+        options: Option<&Route<B, E>>,
+        patch: Option<&Route<B, E>>,
+        post: Option<&Route<B, E>>,
+        put: Option<&Route<B, E>>,
+        trace: Option<&Route<B, E>>,
+        fallback: &Fallback<B, E>,
+    ) -> future::RouteFuture<B, E> {
+        let method = req.method().clone();
+        let strip_head = method == Method::HEAD;
+
+        if method == Method::HEAD {
+            if let Some(svc) = head {
+                return future::RouteFuture::new(svc.0.clone().oneshot(req)).strip_body(true);
+            }
+            if let Some(svc) = get {
+                return future::RouteFuture::new(svc.0.clone().oneshot(req)).strip_body(true);
+            }
+        }
+
+        if method == Method::GET {
+            if let Some(svc) = get {
+                return future::RouteFuture::new(svc.0.clone().oneshot(req)).strip_body(false);
+            }
+        }
+
+        if method == Method::POST {
+            if let Some(svc) = post {
+                return future::RouteFuture::new(svc.0.clone().oneshot(req)).strip_body(false);
+            }
+        }
+
+        if method == Method::OPTIONS {
+            if let Some(svc) = options {
+                return future::RouteFuture::new(svc.0.clone().oneshot(req)).strip_body(false);
+            }
+        }
+
+        if method == Method::PATCH {
+            if let Some(svc) = patch {
+                return future::RouteFuture::new(svc.0.clone().oneshot(req)).strip_body(false);
+            }
+        }
+
+        if method == Method::PUT {
+            if let Some(svc) = put {
+                return future::RouteFuture::new(svc.0.clone().oneshot(req)).strip_body(false);
+            }
+        }
+
+        if method == Method::DELETE {
+            if let Some(svc) = delete {
+                return future::RouteFuture::new(svc.0.clone().oneshot(req)).strip_body(false);
+            }
+        }
+
+        if method == Method::TRACE {
+            if let Some(svc) = trace {
+                return future::RouteFuture::new(svc.0.clone().oneshot(req)).strip_body(false);
+            }
+        }
+
+        match fallback {
+            Fallback::Default(fallback) => {
+                future::RouteFuture::new(fallback.0.clone().oneshot(req)).strip_body(strip_head)
+            }
+            Fallback::Custom(fallback) => {
+                future::RouteFuture::new(fallback.0.clone().oneshot(req)).strip_body(strip_head)
+            }
+        }
+    }
+
+    pub(crate) fn require_single_path_param<'a>(
+        params: &'a [(ByteStr, PercentDecodedByteStr)],
+        single_only: bool,
+    ) -> Result<&'a PercentDecodedByteStr, PathParseErr> {
+        if single_only && params.len() != 1 {
+            Err(PathParseErr::WrongNumber {
+                got: params.len(),
+                expected: 1,
+            })
+        } else if params.is_empty() {
+            Err(PathParseErr::WrongNumber {
+                got: 0,
+                expected: 1,
+            })
+        } else {
+            Ok(&params[0].1)
+        }
+    }
