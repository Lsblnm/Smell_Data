+
+    fn strip_nest_tail_capture<'a>(&self, previous: &'a str) -> &'a str {
+        match previous.strip_suffix(NEST_TAIL_PARAM_CAPTURE) {
+            Some(previous) => previous,
+            None => previous,
+        }
+    }
+
+    fn capture_route_params(&self, match_: &matchit::Match<&RouteId>) -> Vec<(String, String)> {
+        match_
