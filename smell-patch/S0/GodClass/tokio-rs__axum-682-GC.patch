+impl<B> Router<B> {
+    fn strip_uri_prefix(&self, uri: &Uri, prefix: &str) -> Uri {
+        match self.path_and_query_of(uri) {
+            Some(path_and_query) => {
+                let stripped = match path_and_query.path().strip_prefix(prefix) {
+                    Some(path) => path,
+                    None => path_and_query.path(),
+                };
+                let normalized = self.normalize_absolute_path(stripped);
+                let joined = self.join_path_with_query(&normalized, path_and_query.query());
+                Self::uri_from_parts(uri, Some(joined))
+            }
+            None => Self::uri_from_parts(uri, None),
+        }
+    }
+
+    pub(crate) fn strip_uri_prefix_parts(uri: &Uri, prefix: &str, preserve_query: bool) -> Uri {
+        let path_and_query = match uri.path_and_query() {
+            Some(path_and_query) => {
+                let stripped = match path_and_query.path().strip_prefix(prefix) {
+                    Some(path) => path,
+                    None => path_and_query.path(),
+                };
+                let normalized = Self::normalize_absolute_path_value(stripped);
+                Some(Self::join_path_and_query_value(
+                    &normalized,
+                    path_and_query.query(),
+                    preserve_query,
+                ))
+            }
+            None => None,
+        };
+        Self::uri_from_parts(uri, path_and_query)
+    }
+
+    fn with_replaced_path(&self, uri: &Uri, new_path: &str) -> Uri {
+        match self.path_and_query_of(uri) {
+            Some(path_and_query) => {
+                let normalized = self.normalize_absolute_path(new_path);
+                let joined = self.join_path_with_query(&normalized, path_and_query.query());
+                Self::uri_from_parts(uri, Some(joined))
+            }
+            None => Self::uri_from_parts(uri, None),
+        }
+    }
+
+    pub(crate) fn replace_uri_path(uri: &Uri, new_path: &str, preserve_query: bool) -> Uri {
+        let path_and_query = match uri.path_and_query() {
+            Some(path_and_query) => {
+                let normalized = Self::normalize_absolute_path_value(new_path);
+                Some(Self::join_path_and_query_value(
+                    &normalized,
+                    path_and_query.query(),
+                    preserve_query,
+                ))
+            }
+            None => None,
+        };
+        Self::uri_from_parts(uri, path_and_query)
+    }
+
+    fn join_path_with_query(&self, path: &str, query: Option<&str>) -> http::uri::PathAndQuery {
+        Self::join_path_and_query_value(path, query, self.preserve_query_on_rewrite)
+    }
+
+    fn normalize_absolute_path<'a>(&self, path: &'a str) -> Cow<'a, str> {
+        Self::normalize_absolute_path_value(path)
+    }
+
+    fn path_and_query_of<'a>(&self, uri: &'a Uri) -> Option<&'a http::uri::PathAndQuery> {
+        uri.path_and_query()
+    }
+
+    pub(crate) fn normalize_absolute_path_value(path: &str) -> Cow<'_, str> {
+        if path.starts_with('/') {
+            Cow::Borrowed(path)
+        } else {
+            Cow::Owned(format!("/{}", path))
+        }
+    }
+
+    pub(crate) fn join_path_and_query_value(
+        path: &str,
+        query: Option<&str>,
+        preserve_query: bool,
+    ) -> http::uri::PathAndQuery {
+        if preserve_query {
+            if let Some(query) = query {
+                return format!("{}?{}", path, query)
+                    .parse::<http::uri::PathAndQuery>()
+                    .unwrap();
+            }
+        }
+        path.parse().unwrap()
+    }
+
+    pub(crate) fn uri_from_parts(uri: &Uri, path_and_query: Option<http::uri::PathAndQuery>) -> Uri {
+        let mut parts = http::uri::Parts::default();
+        parts.scheme = uri.scheme().cloned();
+        parts.authority = uri.authority().cloned();
+        parts.path_and_query = path_and_query;
+        Uri::from_parts(parts).unwrap()
+    }
+
+    fn opposite_trailing_slash_path(&self, path: &str) -> String {
+        if let Some(without_tsr) = path.strip_suffix('/') {
+            without_tsr.to_owned()
