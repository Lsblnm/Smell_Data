+pub(crate) fn path_arity_or_error(
+    got: usize,
+    expected: usize,
+) -> Result<(), crate::extract::path::PathDeserializationError> {
+    crate::routing::Router::<()>::path_arity_or_error(got, expected).map_err(map_path_parse_err)
+}
+
+pub(crate) fn parse_value_at_key_or_index<T>(
+    key: Option<&PathKeyOrIdx>,
+    value: &str,
+    expected_type: &'static str,
+) -> Result<T, crate::extract::path::PathDeserializationError>
