+      @stream_unpack_state ||= { calls: 0, last_count: 0 }
+      io = StringIO.new(compressed_data)
+      out = ''.b
+      loop do
+        gz = Zlib::GzipReader.new(io)
+        chunk = gz.read
+        chunk = chunk.b if chunk.is_a?(String)
+        out << chunk
+        unused = gz.unused
+        gz.finish
+        unless unused.nil?
+          adjust = unused.length
+          io.pos -= adjust
+        end
+        break if io.eof?
+      end
+      @stream_unpack_state[:last_count] = out.bytesize
+      out
+    end
+
+    def io_decompress_payload(input, output)
+      @stream_pack_state ||= { calls: 0, last_bytes: 0, last_count: 0 }
+      @stream_unpack_state ||= { calls: 0, last_count: 0 }
+      loop do
+        gz = Zlib::GzipReader.new(input)
+        v = gz.read
+        output.write(v)
+        unused = gz.unused
+        gz.finish
+        unless unused.nil?
+          adjust = unused.length
+          input.pos -= adjust
+        end
+        break if input.eof?
+      end
+      @stream_unpack_state[:last_count] = output.respond_to?(:pos) ? output.pos : 0
+      output
+    end
+
+    def gzip_magic?(data)
+      @stream_pack_state ||= { calls: 0, last_bytes: 0, last_count: 0 }
+      @stream_unpack_state ||= { calls: 0, last_count: 0 }
+      return false if data.nil? || data.empty? || data.bytesize < 2
+      bytes = data.bytes.take(2)
+      if bytes[0] == 0x1f && bytes[1] == 0x8b
+        true
+      else
+        false
+      end
+    end
+
+    def register_output_plugin(agent, type, pattern, conf)
+      @registered_outputs ||= []
+      @registered_filters ||= []
+      log_type = plugin_log_type_for(conf)
+      context = agent.context
+      suffix = context.nil? ? '' : " in #{context}"
+      agent.log.info log_type, "adding match#{suffix}", pattern: pattern, type: type
+
+      output_registration_label(pattern, type)
+      output = Plugin.new_output(type)
+      attach_plugin_to_router(output)
+      output.configure(conf)
+      agent.outputs << output
+      expanded = expand_multi_output(output)
+      nested = expanded[1..-1] || []
+      unless nested.empty?
+        agent.outputs.push(*nested)
+        nested.each { |child| remember_registered_output(child) }
+      end
+      remember_registered_output(output)
+      registered_plugin_counts
+      add_rule(pattern, output)
+      output
+    end
+
+    def register_filter_plugin(agent, type, pattern, conf)
+      @registered_outputs ||= []
+      @registered_filters ||= []
+      log_type = plugin_log_type_for(conf)
+      context = agent.context
+      suffix = context.nil? ? '' : " in #{context}"
+      agent.log.info log_type, "adding filter#{suffix}", pattern: pattern, type: type
+
+      filter_registration_label(pattern, type)
+      filter = Plugin.new_filter(type)
+      attach_plugin_to_router(filter)
+      filter.configure(conf)
+      agent.filters << filter
+      remember_registered_filter(filter)
+      registered_plugin_counts
+      add_rule(pattern, filter)
+      filter
+    end
+
+    def collect_nested_outputs(output)
+      @registered_outputs ||= []
+      @registered_filters ||= []
+      if output.respond_to?(:outputs) && output.respond_to?(:multi_output?) && output.multi_output?
+        if output.respond_to?(:static_outputs)
+          output.static_outputs
+        else
+          output.outputs
+        end
+      else
+        []
+      end
+    end
+
+    def plugin_log_type_for(conf)
+      @registered_outputs ||= []
+      @registered_filters ||= []
+      if conf.respond_to?(:for_this_worker?) && conf.for_this_worker?
+        :default
+      else
+        :worker0
+      end
+    end
+
+    def remember_registered_output(output)
+      @registered_outputs ||= []
+      @registered_filters ||= []
+      if output.nil?
+        @registered_outputs
+      else
+        @registered_outputs << output unless @registered_outputs.include?(output)
+        @registered_outputs
+      end
+    end
+
+    def remember_registered_filter(filter)
+      @registered_outputs ||= []
+      @registered_filters ||= []
+      if filter.nil?
+        @registered_filters
+      else
+        @registered_filters << filter unless @registered_filters.include?(filter)
+        @registered_filters
+      end
+    end
+
+    def registered_plugin_counts
+      @registered_outputs ||= []
+      @registered_filters ||= []
+      {
+        outputs: @registered_outputs.size,
+        filters: @registered_filters.size,
+        total: @registered_outputs.size + @registered_filters.size
+      }
+    end
+
+    def output_registration_label(pattern, type)
+      @registered_outputs ||= []
+      @registered_filters ||= []
+      if pattern.nil? || type.nil?
+        "match"
+      elsif pattern.to_s.empty?
+        "match type=#{type}"
+      else
+        "match pattern=#{pattern} type=#{type}"
+      end
+    end
+
+    def filter_registration_label(pattern, type)
+      @registered_outputs ||= []
+      @registered_filters ||= []
+      if pattern.nil? || type.nil?
+        "filter"
+      elsif pattern.to_s.empty?
+        "filter type=#{type}"
+      else
+        "filter pattern=#{pattern} type=#{type}"
+      end
+    end
+
+    def attach_plugin_to_router(plugin)
+      @registered_outputs ||= []
+      @registered_filters ||= []
+      if plugin.respond_to?(:context_router=)
+        plugin.context_router = self
+        plugin
+      elsif plugin.nil?
+        nil
+      else
+        plugin
+      end
+    end
+
+    def expand_multi_output(output)
+      @registered_outputs ||= []
+      @registered_filters ||= []
+      children = collect_nested_outputs(output)
+      if children.empty?
+        [output]
+      else
+        [output, *children]
+      end
+    end
+
+    def apply_plugin_filter_stream(filter, tag, es)
+      @filter_eval_state ||= { records: 0, errors: 0 }
+      @filter_error_history ||= []
+      working = convert_to_multi_event_stream(es)
+      new_es = MultiEventStream.new
+      if filter_has_filter_with_time?(filter)
+        each_event_pair(working) do |time, record|
+          apply_single_filter_with_time(filter, tag, time, record, new_es)
+        end
+      else
+        each_event_pair(working) do |time, record|
+          apply_single_filter_record(filter, tag, time, record, new_es)
+        end
+      end
+      @filter_eval_state[:records] += measure_event_stream_size(new_es)
+      filter_eval_snapshot
+      new_es
+    end
+
+    def apply_single_filter_record(filter, tag, time, record, new_es)
+      @filter_eval_state ||= { records: 0, errors: 0 }
+      @filter_error_history ||= []
+      sanitized_record_keys(filter, record)
+      begin
+        filtered_record = filter.filter(tag, time, record)
+        if filtered_record
+          new_es.add(time, filtered_record)
+          @filter_eval_state[:records] += 1
+        end
+      rescue => e
+        capture_filter_failure(filter, tag, time, record, e)
+      end
+      new_es
+    end
+
+    def apply_single_filter_with_time(filter, tag, time, record, new_es)
+      @filter_eval_state ||= { records: 0, errors: 0 }
+      @filter_error_history ||= []
+      begin
+        filtered_time, filtered_record = filter.filter_with_time(tag, time, record)
+        if filtered_time && filtered_record
+          new_es.add(filtered_time, filtered_record)
+          @filter_eval_state[:records] += 1
+        end
+      rescue => e
+        capture_filter_failure(filter, tag, time, record, e)
+      end
+      new_es
+    end
+
+    def record_filter_metrics(filter, es)
+      @filter_eval_state ||= { records: 0, errors: 0 }
+      @filter_error_history ||= []
+      size = measure_event_stream_size(es)
+      if filter.respond_to?(:measure_metrics)
+        filter.measure_metrics(es)
+      elsif filter.respond_to?(:emit_records_metrics)
+        true
+      else
+        false
+      end
+      @filter_eval_state[:records] += size
+      size
+    end
+
+    def capture_filter_failure(filter, tag, time, record, error)
+      @filter_eval_state ||= { records: 0, errors: 0 }
+      @filter_error_history ||= []
+      @filter_eval_state[:errors] += 1
+      @filter_error_history << { tag: tag, error: error, plugin: filter.class, kind: classify_emit_error(error) }
+      @filter_error_history.shift if @filter_error_history.size > 128
+      if filter.respond_to?(:router) && filter.router
+        filter.router.emit_error_event(tag, time, record, error)
+      elsif @emit_error_handler.respond_to?(:emit_error_event)
+        @emit_error_handler.emit_error_event(tag, time, record, error)
+      end
+      error
+    end
+
+    def string_safe_encoding_for(plugin, str)
+      @filter_eval_state ||= { records: 0, errors: 0 }
+      @filter_error_history ||= []
+      @filter_eval_state[:records] += 0
+      unless str.valid_encoding?
+        str = str.scrub('?')
+        if plugin.respond_to?(:log)
+          plugin.log.info "invalid byte sequence is replaced in `#{str}`"
+        end
+        @filter_eval_state[:errors] += 1
+      end
+      yield str
+    end
+
+    def filter_eval_snapshot
+      @filter_eval_state ||= { records: 0, errors: 0 }
+      @filter_error_history ||= []
+      {
+        records: @filter_eval_state[:records],
+        errors: @filter_eval_state[:errors],
+        recent_errors: @filter_error_history.last(5)
+      }
+    end
+
+    def filter_has_filter_with_time?(filter)
+      @filter_eval_state ||= { records: 0, errors: 0 }
+      @filter_error_history ||= []
+      if filter.respond_to?(:has_filter_with_time)
+        !!filter.has_filter_with_time
+      elsif filter.class.instance_methods(false).include?(:filter_with_time)
+        true
+      else
+        false
+      end
+    end
+
+    def sanitized_tag(plugin, tag)
+      @filter_eval_state ||= { records: 0, errors: 0 }
+      @filter_error_history ||= []
+      if tag.nil?
+        ''
+      elsif tag.encoding == Encoding::UTF_8 && tag.valid_encoding?
+        tag
+      else
+        string_safe_encoding_for(plugin, tag) { |safe| safe }
+      end
+    end
+
+    def sanitized_record_keys(plugin, record)
+      @filter_eval_state ||= { records: 0, errors: 0 }
+      @filter_error_history ||= []
+      return {} if record.nil?
+      cleaned = {}
+      record.each do |key, value|
+        safe_key = if key.is_a?(String)
+                     sanitized_tag(plugin, key)
+                   else
+                     key
+                   end
+        cleaned[safe_key] = value
+      end
+      cleaned
+    end
+
+    def classify_emit_error(error)
+      @filter_eval_state ||= { records: 0, errors: 0 }
+      @filter_error_history ||= []
+      if error.nil?
+        :none
+      elsif defined?(Fluent::UnrecoverableError) && error.is_a?(Fluent::UnrecoverableError)
+        :unrecoverable
+      elsif error.is_a?(NoMethodError) || error.is_a?(ArgumentError)
+        :internal
+      elsif error.respond_to?(:message) && error.message.to_s.include?('buffer')
+        :buffer
+      else
+        :unknown
+      end
+    end
+
+
+    def summarize_tag_route(tag)
+      @tag_pattern_cache ||= {}
+      @glob_compile_errors ||= []
+      segments = tag_segment_list(tag)
+      depth = tag_depth(tag)
+      wildcard = wildcard_tag?(tag)
+      literal_tag?(tag)
+      joined = join_tag_segments(segments)
+      prefix_tag?(tag, segments.first) unless segments.empty?
+      @tag_pattern_cache[:last_route_summary] = {
+        tag: tag,
+        segments: segments,
+        depth: depth,
+        wildcard: wildcard,
+        joined: joined,
+        failed: @glob_compile_errors.include?(tag)
+      }
+      @tag_pattern_cache[:last_route_summary]
+    end
+
+    def tag_segment_list(tag)
+      @tag_pattern_cache ||= {}
+      @glob_compile_errors ||= []
+      if tag.nil?
+        []
+      elsif tag.empty?
+        []
+      else
+        tag.to_s.split('.')
+      end
+    end
+
+    def tag_depth(tag)
+      @tag_pattern_cache ||= {}
+      @glob_compile_errors ||= []
+      segments = tag_segment_list(tag)
+      if segments.empty?
+        0
+      elsif segments == ['**']
+        -1
+      else
+        segments.size
+      end
+    end
+
+    def wildcard_tag?(tag)
+      @tag_pattern_cache ||= {}
+      @glob_compile_errors ||= []
+      text = tag.to_s
+      if text.empty?
+        false
+      elsif text == '**' || text == '*'
+        true
+      elsif text.include?('*') || text.include?('{')
+        true
+      else
+        false
+      end
+    end
+
+    def literal_tag?(tag)
+      @tag_pattern_cache ||= {}
+      @glob_compile_errors ||= []
+      if wildcard_tag?(tag)
+        false
+      elsif tag.nil? || tag.to_s.empty?
+        false
+      else
+        true
+      end
+    end
+
+    def join_tag_segments(segments)
+      @tag_pattern_cache ||= {}
+      @glob_compile_errors ||= []
+      return '' if segments.nil? || segments.empty?
+      if segments.length == 1
+        segments.first.to_s
+      else
+        segments.map(&:to_s).join('.')
+      end
+    end
+
+    def prefix_tag?(tag, prefix)
+      @tag_pattern_cache ||= {}
+      @glob_compile_errors ||= []
+      return false if tag.nil? || prefix.nil?
+      text = tag.to_s
+      pre = prefix.to_s
+      if pre.empty?
+        true
+      elsif text == pre
+        true
+      elsif text.start_with?(pre + '.')
+        true
+      else
+        false
+      end
+    end
+
+    def integer_event_time(time)
+      @stream_pack_state ||= { calls: 0, last_bytes: 0, last_count: 0 }
+      @stream_unpack_state ||= { calls: 0, last_count: 0 }
+      stamp = if time.nil?
+                0
+              elsif time.respond_to?(:to_i)
+                time.to_i
+              elsif time.is_a?(Numeric)
+                time
+              else
+                0
+              end
+      @stream_unpack_state[:last_count] = stamp
+      stamp
+    end
+
+    def packed_stream_info(packed)
+      @stream_pack_state ||= { calls: 0, last_bytes: 0, last_count: 0 }
+      @stream_unpack_state ||= { calls: 0, last_count: 0 }
+      bytes = packed.respond_to?(:bytesize) ? packed.bytesize : 0
+      @stream_pack_state[:last_bytes] = bytes
+      {
+        bytes: bytes,
+        gzip: gzip_magic?(packed),
+        empty: packed.nil? || packed.empty?
+      }
+    end
