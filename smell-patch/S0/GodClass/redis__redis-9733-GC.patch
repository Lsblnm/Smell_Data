+
+int commandCatalogValidateEvalNumkeys(commandCatalog *cat, client *c, long long *numkeys) {
+    commandCatalogResetEvalState(cat);
+    cat->eval_client = c;
+    if (getLongLongFromObjectOrReply(c,c->argv[2],numkeys,NULL) != C_OK) {
+        cat->eval_numkeys = -1;
+        return C_ERR;
+    }
+    cat->eval_numkeys = *numkeys;
+    if (cat->eval_numkeys > (c->argc - 3)) {
+        addReplyError(c,"Number of keys can't be greater than number of args");
+        return C_ERR;
+    } else if (cat->eval_numkeys < 0) {
+        addReplyError(c,"Number of keys can't be negative");
+        return C_ERR;
+    }
+    return C_OK;
+}
+
+void commandCatalogEvalArgSlices(commandCatalog *cat, client *c, long long numkeys, robj ***keys, int *nkeys, robj ***args, int *nargs) {
+    cat->eval_client = c;
+    cat->eval_numkeys = numkeys;
+    cat->eval_keys_ofs = 3;
+    cat->eval_argv_ofs = 3 + (int)numkeys;
+    cat->eval_argv_count = c->argc - 3 - (int)numkeys;
+    if (keys) *keys = c->argv + cat->eval_keys_ofs;
+    if (nkeys) *nkeys = (int)cat->eval_numkeys;
+    if (args) *args = c->argv + cat->eval_argv_ofs;
+    if (nargs) *nargs = cat->eval_argv_count;
+}
