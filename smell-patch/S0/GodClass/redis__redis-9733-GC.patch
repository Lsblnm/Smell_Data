+    result->numkeys = num;
+    return num;
+}
+
+int commandCatalogExtractGeoRadiusKeys(commandCatalog *cat, struct redisCommand *cmd, robj **argv, int argc, getKeysResult *result) {
+    int i, num, *keys;
+    commandCatalogBindKeyCommand(cat, cmd, argv, argc, result);
+
+    /* Check for the presence of the stored key in the command */
+    int stored_key = -1;
+    for (i = 5; i < argc; i++) {
+        char *arg = argv[i]->ptr;
+        /* For the case when user specifies both "store" and "storedist" options, the
+         * second key specified would override the first key. This behavior is kept
+         * the same as in georadiusCommand method.
+         */
+        if ((!strcasecmp(arg, "store") || !strcasecmp(arg, "storedist")) && ((i+1) < argc)) {
+            stored_key = i+1;
+            i++;
+        }
+    }
+    num = 1 + (stored_key == -1 ? 0 : 1);
+
+    /* Keys in the command come from two places:
+     * argv[1] = key,
+     * argv[5...n] = stored key if present
+     */
+    keys = commandCatalogPrepareKeys(cat, result, num);
+
+    /* Add all key positions to keys[] */
+    keys[0] = 1;
+    cat->last_key_index = 1;
+    if(num > 1) {
+         keys[1] = stored_key;
+         cat->last_key_index = stored_key;
+    }
+    result->numkeys = num;
+    cat->keys_count = num;
+    return num;
+}
+
+int commandCatalogExtractLcsKeys(commandCatalog *cat, struct redisCommand *cmd, robj **argv, int argc, getKeysResult *result) {
+    int i;
+    int *keys;
+    commandCatalogBindKeyCommand(cat, cmd, argv, argc, result);
+    keys = commandCatalogPrepareKeys(cat, result, 2);
+
+    /* We need to parse the options of the command in order to check for the
+     * "KEYS" argument before the "STRINGS" argument. */
+    for (i = 1; i < argc; i++) {
+        char *arg = argv[i]->ptr;
+        int moreargs = (argc-1) - i;
+
+        if (!strcasecmp(arg, "strings")) {
+            break;
+        } else if (!strcasecmp(arg, "keys") && moreargs >= 2) {
+            keys[0] = i+1;
+            keys[1] = i+2;
+            cat->last_key_index = i+2;
+            result->numkeys = 2;
+            cat->keys_count = 2;
+            return result->numkeys;
+        }
+    }
+    result->numkeys = 0;
+    cat->keys_count = 0;
+    return result->numkeys;
+}
+
+int commandCatalogExtractXreadKeys(commandCatalog *cat, struct redisCommand *cmd, robj **argv, int argc, getKeysResult *result) {
+    int i, num = 0, *keys;
+    commandCatalogBindKeyCommand(cat, cmd, argv, argc, result);
+
+    /* We need to parse the options of the command in order to seek the first
+     * "STREAMS" string which is actually the option. This is needed because
+     * "STREAMS" could also be the name of the consumer group and even the
+     * name of the stream key. */
+    int streams_pos = -1;
+    for (i = 1; i < argc; i++) {
+        char *arg = argv[i]->ptr;
+        if (!strcasecmp(arg, "block")) {
+            i++; /* Skip option argument. */
+        } else if (!strcasecmp(arg, "count")) {
+            i++; /* Skip option argument. */
+        } else if (!strcasecmp(arg, "group")) {
+            i += 2; /* Skip option argument. */
+        } else if (!strcasecmp(arg, "noack")) {
+            /* Nothing to do. */
+        } else if (!strcasecmp(arg, "streams")) {
+            streams_pos = i;
+            break;
+        } else {
+            break; /* Syntax error. */
+        }
+    }
+    if (streams_pos != -1) num = argc - streams_pos - 1;
+
+    /* Syntax error. */
+    if (streams_pos == -1 || num == 0 || num % 2 != 0) {
+        result->numkeys = 0;
+        cat->keys_count = 0;
+        return 0;
+    }
+    num /= 2; /* We have half the keys as there are arguments because
+                 there are also the IDs, one per key. */
+
+    keys = commandCatalogPrepareKeys(cat, result, num);
+    for (i = streams_pos+1; i < argc-num; i++) {
+        keys[i-streams_pos-1] = i;
+        cat->last_key_index = i;
+    }
+    result->numkeys = num;
+    cat->keys_count = num;
+    return num;
+}
+
+void commandCatalogGetKeysSubcommand(commandCatalog *cat, client *c) {
+    struct redisCommand *cmd;
+    getKeysResult result = GETKEYS_RESULT_INIT;
+    int j;
+
+    cat->keys_client = c;
+    cat->keys_argv = c->argv+2;
+    cat->keys_argc = c->argc-2;
+    cmd = lookupCommand(cat->keys_argv, cat->keys_argc);
+    cat->keys_cmd = cmd;
+
+    if (!cmd) {
+        addReplyError(c,"Invalid command specified");
+        return;
+    }
+    commandCatalogHasKeyProc(cat, cmd);
+    if (cmd->getkeys_proc == NULL && cmd->key_specs_num == 0) {
+        addReplyError(c,"The command has no key arguments");
+        return;
+    } else if ((cmd->arity > 0 && cmd->arity != cat->keys_argc) ||
+               (cat->keys_argc < -cmd->arity))
+    {
+        addReplyError(c,"Invalid number of arguments specified for command");
+        return;
+    }
+
+    if (!commandCatalogExtractKeys(cat,cmd,cat->keys_argv,cat->keys_argc,&result)) {
+        addReplyError(c,"Invalid arguments specified for command");
+    } else {
+        addReplyArrayLen(c,result.numkeys);
+        for (j = 0; j < result.numkeys; j++) addReplyBulk(c,c->argv[result.keys[j]+2]);
+        cat->keys_count = result.numkeys;
+    }
+    commandCatalogFreeKeys(cat, &result);
+}
+
+void commandCatalogBindPopulateCommand(commandCatalog *cat, struct redisCommand *c) {
+    cat->pop_cmd = c;
+    cat->pop_argc = 0;
+    cat->pop_argv = NULL;
+    cat->pop_flag = NULL;
+    cat->pop_index = 0;
+    cat->pop_movable = 0;
+}
+
+sds commandCatalogFullName(commandCatalog *cat, struct redisCommand *cmd) {
+    cat->pop_cmd = cmd;
+    if (!cmd->parent) {
+        cat->pop_parent = NULL;
+        return sdsnew(cmd->name);
+    } else {
+        cat->pop_parent = cmd->parent;
+        return sdscatfmt(sdsempty(),"%s|%s",cmd->parent->name,cmd->name);
+    }
+}
+
+void commandCatalogAddSubcommand(commandCatalog *cat, struct redisCommand *parent, struct redisCommand *subcommand) {
+    cat->pop_parent = parent;
+    cat->pop_cmd = subcommand;
+    if (!parent->subcommands_dict)
+        parent->subcommands_dict = dictCreate(&commandTableDictType);
+
+    subcommand->parent = parent; /* Assign the parent command */
+    sds fullname = commandCatalogFullName(cat, subcommand);
+    subcommand->id = ACLGetCommandID(fullname); /* Assign the ID used for ACL. */
+    sdsfree(fullname);
+
+    serverAssert(dictAdd(parent->subcommands_dict, sdsnew(subcommand->name), subcommand) == DICT_OK);
+}
+
+void commandCatalogPopulateLegacyRange(commandCatalog *cat, struct redisCommand *c) {
+    cat->pop_cmd = c;
+    memset(&c->legacy_range_key_spec, 0, sizeof(c->legacy_range_key_spec));
+
+    if (c->key_specs_num == 0)
+        return;
+
+    if (c->key_specs_num == 1 &&
+        c->key_specs[0].begin_search_type == KSPEC_BS_INDEX &&
+        c->key_specs[0].find_keys_type == KSPEC_FK_RANGE)
+    {
+        /* Quick win */
+        c->legacy_range_key_spec = c->key_specs[0];
+        return;
+    }
+
+    int firstkey = INT_MAX, lastkey = 0;
+    int prev_lastkey = 0;
+    for (int i = 0; i < c->key_specs_num; i++) {
+        cat->pop_index = i;
+        if (c->key_specs[i].begin_search_type != KSPEC_BS_INDEX ||
+            c->key_specs[i].find_keys_type != KSPEC_FK_RANGE)
+            continue;
+        if (c->key_specs[i].fk.range.keystep != 1)
+            return;
+        if (prev_lastkey && prev_lastkey != c->key_specs[i].bs.index.pos-1)
+            return;
+        firstkey = min(firstkey, c->key_specs[i].bs.index.pos);
+        /* Get the absolute index for lastkey (in the "range" spec, lastkey is relative to firstkey) */
+        int lastkey_abs_index = c->key_specs[i].fk.range.lastkey;
+        if (lastkey_abs_index >= 0)
+            lastkey_abs_index += c->key_specs[i].bs.index.pos;
+        /* For lastkey we use unsigned comparison to handle negative values correctly */
+        lastkey = max((unsigned)lastkey, (unsigned)lastkey_abs_index);
+    }
+
+    if (firstkey == INT_MAX)
+        return;
+
+    serverAssert(firstkey != 0);
+    serverAssert(lastkey != 0);
+
+    c->legacy_range_key_spec.begin_search_type = KSPEC_BS_INDEX;
+    c->legacy_range_key_spec.bs.index.pos = firstkey;
+    c->legacy_range_key_spec.find_keys_type = KSPEC_FK_RANGE;
+    c->legacy_range_key_spec.fk.range.lastkey = lastkey < 0 ? lastkey : (lastkey-firstkey); /* in the "range" spec, lastkey is relative to firstkey */
+    c->legacy_range_key_spec.fk.range.keystep = 1;
+    c->legacy_range_key_spec.fk.range.limit = 0;
+}
+
+void commandCatalogPopulateMovableKeys(commandCatalog *cat, struct redisCommand *cmd) {
+    int movablekeys = 0;
+    cat->pop_cmd = cmd;
+    if (cmd->getkeys_proc && !(cmd->flags & CMD_MODULE)) {
+        /* Redis command with getkeys proc */
+        movablekeys = 1;
+    } else if (cmd->flags & CMD_MODULE_GETKEYS) {
+        /* Module command with getkeys proc */
+        movablekeys = 1;
+    } else {
+        /* Redis command without getkeys proc, but possibly has
+         * movable keys because of a keys spec. */
+        for (int i = 0; i < cmd->key_specs_num; i++) {
+            cat->pop_index = i;
+            if (cmd->key_specs[i].begin_search_type != KSPEC_BS_INDEX ||
+                cmd->key_specs[i].find_keys_type != KSPEC_FK_RANGE)
+            {
+                /* If we have a non-range spec it means we have movable keys */
+                movablekeys = 1;
+                break;
+            }
+        }
+    }
+
+    cmd->movablekeys = movablekeys;
+    cat->pop_movable = movablekeys;
+}
+
+void commandCatalogPopulateKeySpecFlags(commandCatalog *cat, struct redisCommand *c) {
+    commandCatalogBindPopulateCommand(cat, c);
+    /* Redis commands don't need more args than STATIC_KEY_SPECS_NUM (Number of keys
+     * specs can be greater than STATIC_KEY_SPECS_NUM only for module commands) */
+    c->key_specs = c->key_specs_static;
+    c->key_specs_max = STATIC_KEY_SPECS_NUM;
+
+    for (int i = 0; i < STATIC_KEY_SPECS_NUM; i++) {
+        cat->pop_index = i;
+        if (c->key_specs[i].begin_search_type == KSPEC_BS_INVALID)
+            continue;
+
+        /* Split the line into arguments for processing. */
+        cat->pop_argv = sdssplitargs(c->key_specs[i].sflags, &cat->pop_argc);
+        if (cat->pop_argv == NULL)
+            serverPanic("Failed splitting key sflags!");
+
+        for (int j = 0; j < cat->pop_argc; j++) {
+            char *flag = cat->pop_argv[j];
+            cat->pop_flag = flag;
+            if (!strcasecmp(flag,"write")) {
+                c->key_specs[i].flags |= CMD_KEY_WRITE;
+            } else if (!strcasecmp(flag,"read")) {
+                c->key_specs[i].flags |= CMD_KEY_READ;
+            } else if (!strcasecmp(flag,"incomplete")) {
+                c->key_specs[i].flags |= CMD_KEY_INCOMPLETE;
+            } else {
+                serverPanic("Unsupported key-arg flag %s", flag);
+            }
+        }
+
+        c->key_specs_num++;
+        sdsfreesplitres(cat->pop_argv, cat->pop_argc);
+        cat->pop_argv = NULL;
+    }
+}
+
+void commandCatalogPopulateStructure(commandCatalog *cat, struct redisCommand *c) {
+    commandCatalogBindPopulateCommand(cat, c);
+    commandCatalogPopulateKeySpecFlags(cat, c);
+    commandCatalogPopulateLegacyRange(cat, c);
+
+    /* Handle the "movablekeys" flag (must be done after populating all key specs). */
+    commandCatalogPopulateMovableKeys(cat, c);
+
+    /* Assign the ID used for ACL. */
+    c->id = ACLGetCommandID(c->name);
+
+    /* Handle subcommands */
+    if (c->subcommands) {
+        for (int j = 0; c->subcommands[j].name; j++) {
+            struct redisCommand *sub = c->subcommands+j;
+            cat->pop_index = j;
+
+            /* Translate the command string flags description into an actual
+             * set of flags. */
+            commandCatalogParseFlags(cat, sub, sub->sflags);
+            commandCatalogPopulateStructure(cat, sub);
+            commandCatalogAddSubcommand(cat, c, sub);
+        }
+    }
+}
+
+void commandCatalogPopulateTable(commandCatalog *cat) {
+    int j;
+    int numcommands = sizeof(redisCommandTable)/sizeof(struct redisCommand);
+
+    for (j = 0; j < numcommands; j++) {
+        struct redisCommand *c = redisCommandTable+j;
+        int retval1, retval2;
+        cat->pop_cmd = c;
+        cat->pop_index = j;
+
+        /* Translate the command string flags description into an actual
+         * set of flags. */
+        commandCatalogParseFlags(cat, c, c->sflags);
+
+        if (!(c->flags & CMD_SENTINEL) && server.sentinel_mode)
+            continue;
+
+        if (c->flags & CMD_ONLY_SENTINEL && !server.sentinel_mode)
+            continue;
+
+        commandCatalogPopulateStructure(cat, c);
+
+        retval1 = dictAdd(server.commands, sdsnew(c->name), c);
+        /* Populate an additional dictionary that will be unaffected
+         * by rename-command statements in redis.conf. */
+        retval2 = dictAdd(server.orig_commands, sdsnew(c->name), c);
+        serverAssert(retval1 == DICT_OK && retval2 == DICT_OK);
+    }
+}
+
+int commandCatalogReplyFlag(commandCatalog *cat, client *c, uint64_t flags, uint64_t f, char *reply) {
+    cat->reply_client = c;
+    cat->reply_flags = flags;
+    if (flags & f) {
+        addReplyStatus(c, reply);
+        cat->reply_count++;
+        return 1;
+    }
+    return 0;
+}
+
+void commandCatalogReplyFlagsForCommand(commandCatalog *cat, client *c, struct redisCommand *cmd) {
+    int flagcount = 0;
+    cat->reply_client = c;
+    cat->reply_cmd = cmd;
+    cat->reply_flags = cmd->flags;
+    cat->reply_flaglen = addReplyDeferredLen(c);
+    flagcount += commandCatalogReplyFlag(cat,c,cmd->flags,CMD_WRITE, "write");
+    flagcount += commandCatalogReplyFlag(cat,c,cmd->flags,CMD_READONLY, "readonly");
+    flagcount += commandCatalogReplyFlag(cat,c,cmd->flags,CMD_DENYOOM, "denyoom");
+    flagcount += commandCatalogReplyFlag(cat,c,cmd->flags,CMD_ADMIN, "admin");
+    flagcount += commandCatalogReplyFlag(cat,c,cmd->flags,CMD_PUBSUB, "pubsub");
+    flagcount += commandCatalogReplyFlag(cat,c,cmd->flags,CMD_NOSCRIPT, "noscript");
+    flagcount += commandCatalogReplyFlag(cat,c,cmd->flags,CMD_RANDOM, "random");
+    flagcount += commandCatalogReplyFlag(cat,c,cmd->flags,CMD_SORT_FOR_SCRIPT,"sort_for_script");
+    flagcount += commandCatalogReplyFlag(cat,c,cmd->flags,CMD_LOADING, "loading");
+    flagcount += commandCatalogReplyFlag(cat,c,cmd->flags,CMD_STALE, "stale");
+    flagcount += commandCatalogReplyFlag(cat,c,cmd->flags,CMD_SKIP_MONITOR, "skip_monitor");
+    flagcount += commandCatalogReplyFlag(cat,c,cmd->flags,CMD_SKIP_SLOWLOG, "skip_slowlog");
+    flagcount += commandCatalogReplyFlag(cat,c,cmd->flags,CMD_ASKING, "asking");
+    flagcount += commandCatalogReplyFlag(cat,c,cmd->flags,CMD_FAST, "fast");
+    flagcount += commandCatalogReplyFlag(cat,c,cmd->flags,CMD_NO_AUTH, "no_auth");
+    flagcount += commandCatalogReplyFlag(cat,c,cmd->flags,CMD_MAY_REPLICATE, "may_replicate");
+    /* "sentinel" and "only-sentinel" are hidden on purpose. */
+    if (cmd->movablekeys) {
+        addReplyStatus(c, "movablekeys");
+        flagcount += 1;
+    }
+    cat->reply_count = flagcount;
+    setDeferredSetLen(c, cat->reply_flaglen, flagcount);
+}
+
+void commandCatalogReplyFlagsForKeyArgs(commandCatalog *cat, client *c, uint64_t flags) {
+    int flagcount = 0;
+    cat->reply_client = c;
+    cat->reply_flags = flags;
+    cat->reply_flaglen = addReplyDeferredLen(c);
+    flagcount += commandCatalogReplyFlag(cat,c,flags,CMD_KEY_WRITE, "write");
+    flagcount += commandCatalogReplyFlag(cat,c,flags,CMD_KEY_READ, "read");
+    flagcount += commandCatalogReplyFlag(cat,c,flags,CMD_KEY_INCOMPLETE, "incomplete");
+    cat->reply_count = flagcount;
+    setDeferredSetLen(c, cat->reply_flaglen, flagcount);
+}
+
+void commandCatalogReplyBeginSearch(commandCatalog *cat, client *c, keySpec *spec) {
+    cat->reply_client = c;
+    addReplyBulkCString(c, "begin_search");
+    switch (spec->begin_search_type) {
+        case KSPEC_BS_UNKNOWN:
+            addReplyMapLen(c, 2);
+            addReplyBulkCString(c, "type");
+            addReplyBulkCString(c, "unknown");
+
+            addReplyBulkCString(c, "spec");
+            addReplyMapLen(c, 0);
+            cat->reply_count = 0;
+            break;
+        case KSPEC_BS_INDEX:
+            addReplyMapLen(c, 2);
+            addReplyBulkCString(c, "type");
+            addReplyBulkCString(c, "index");
+
+            addReplyBulkCString(c, "spec");
+            addReplyMapLen(c, 1);
+            addReplyBulkCString(c, "index");
+            addReplyLongLong(c, spec->bs.index.pos);
+            cat->reply_count = spec->bs.index.pos;
+            break;
+        case KSPEC_BS_KEYWORD:
+            addReplyMapLen(c, 2);
+            addReplyBulkCString(c, "type");
+            addReplyBulkCString(c, "keyword");
+
+            addReplyBulkCString(c, "spec");
+            addReplyMapLen(c, 2);
+            addReplyBulkCString(c, "keyword");
+            addReplyBulkCString(c, spec->bs.keyword.keyword);
+            addReplyBulkCString(c, "startfrom");
+            addReplyLongLong(c, spec->bs.keyword.startfrom);
+            cat->reply_count = spec->bs.keyword.startfrom;
+            break;
+        default:
+            serverPanic("Invalid begin_search key spec type %d", spec->begin_search_type);
+    }
+}
+
+void commandCatalogReplyFindKeys(commandCatalog *cat, client *c, keySpec *spec) {
+    cat->reply_client = c;
+    addReplyBulkCString(c, "find_keys");
+    switch (spec->find_keys_type) {
+        case KSPEC_FK_UNKNOWN:
+            addReplyMapLen(c, 2);
+            addReplyBulkCString(c, "type");
+            addReplyBulkCString(c, "unknown");
+
+            addReplyBulkCString(c, "spec");
+            addReplyMapLen(c, 0);
+            cat->reply_count = 0;
+            break;
+        case KSPEC_FK_RANGE:
+            addReplyMapLen(c, 2);
+            addReplyBulkCString(c, "type");
+            addReplyBulkCString(c, "range");
+
+            addReplyBulkCString(c, "spec");
+            addReplyMapLen(c, 3);
+            addReplyBulkCString(c, "lastkey");
+            addReplyLongLong(c, spec->fk.range.lastkey);
+            addReplyBulkCString(c, "keystep");
+            addReplyLongLong(c, spec->fk.range.keystep);
+            addReplyBulkCString(c, "limit");
+            addReplyLongLong(c, spec->fk.range.limit);
+            cat->reply_count = spec->fk.range.lastkey;
+            break;
+        case KSPEC_FK_KEYNUM:
+            addReplyMapLen(c, 2);
+            addReplyBulkCString(c, "type");
+            addReplyBulkCString(c, "keynum");
+
+            addReplyBulkCString(c, "spec");
+            addReplyMapLen(c, 3);
+            addReplyBulkCString(c, "keynumidx");
+            addReplyLongLong(c, spec->fk.keynum.keynumidx);
+            addReplyBulkCString(c, "firstkey");
+            addReplyLongLong(c, spec->fk.keynum.firstkey);
+            addReplyBulkCString(c, "keystep");
+            addReplyLongLong(c, spec->fk.keynum.keystep);
+            cat->reply_count = spec->fk.keynum.firstkey;
+            break;
+        default:
+            serverPanic("Invalid begin_search key spec type %d", spec->find_keys_type);
+    }
+}
+
+void commandCatalogReplyCommandKeyArgs(commandCatalog *cat, client *c, struct redisCommand *cmd) {
+    cat->reply_client = c;
+    cat->reply_cmd = cmd;
+    addReplySetLen(c, cmd->key_specs_num);
+    for (int i = 0; i < cmd->key_specs_num; i++) {
+        cat->reply_count = i;
+        addReplyMapLen(c, 3);
+
+        addReplyBulkCString(c, "flags");
+        commandCatalogReplyFlagsForKeyArgs(cat, c, cmd->key_specs[i].flags);
+        commandCatalogReplyBeginSearch(cat, c, &cmd->key_specs[i]);
+        commandCatalogReplyFindKeys(cat, c, &cmd->key_specs[i]);
+    }
+}
+
+void commandCatalogReplySubCommands(commandCatalog *cat, client *c, struct redisCommand *cmd) {
+    cat->reply_client = c;
+    cat->reply_cmd = cmd;
+    if (!cmd->subcommands_dict) {
+        addReplySetLen(c, 0);
+        cat->reply_count = 0;
+        return;
+    }
+
+    addReplyArrayLen(c, dictSize(cmd->subcommands_dict));
+    dictEntry *de;
+    dictIterator *di = dictGetSafeIterator(cmd->subcommands_dict);
+    cat->reply_count = 0;
+    while((de = dictNext(di)) != NULL) {
+        struct redisCommand *sub = (struct redisCommand *)dictGetVal(de);
+        commandCatalogReplyCommand(cat, c, sub);
+        cat->reply_count++;
+    }
+    dictReleaseIterator(di);
+}
+
+void commandCatalogReplyCommand(commandCatalog *cat, client *c, struct redisCommand *cmd) {
+    cat->reply_client = c;
+    cat->reply_cmd = cmd;
+    if (!cmd) {
+        addReplyNull(c);
+        cat->reply_count = 0;
+    } else {
+        int firstkey = 0, lastkey = 0, keystep = 0;
+        if (cmd->legacy_range_key_spec.begin_search_type != KSPEC_BS_INVALID) {
+            firstkey = cmd->legacy_range_key_spec.bs.index.pos;
+            lastkey = cmd->legacy_range_key_spec.fk.range.lastkey;
+            if (lastkey >= 0)
+                lastkey += firstkey;
+            keystep = cmd->legacy_range_key_spec.fk.range.keystep;
+        }
+        cat->reply_count = firstkey;
+        /* We are adding: command name, arg count, flags, first, last, offset, categories, key args, subcommands */
+        addReplyArrayLen(c, 9);
+        addReplyBulkCString(c, cmd->name);
+        addReplyLongLong(c, cmd->arity);
+        commandCatalogReplyFlagsForCommand(cat, c, cmd);
+        addReplyLongLong(c, firstkey);
+        addReplyLongLong(c, lastkey);
+        addReplyLongLong(c, keystep);
+        addReplyCommandCategories(c,cmd);
+        commandCatalogReplyCommandKeyArgs(cat, c, cmd);
+        commandCatalogReplySubCommands(cat, c, cmd);
+    }
+}
+
+void commandCatalogResetEvalState(commandCatalog *cat) {
+    cat->eval_client = NULL;
+    cat->eval_numkeys = 0;
