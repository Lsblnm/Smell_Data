+template <typename T, typename OutputIt, typename Char>
+void convert_printf_arg(basic_format_arg<basic_printf_context<OutputIt, Char>>& arg,
+                        Char type) {
+  using context = basic_printf_context<OutputIt, Char>;
+  if (std::is_same<T, signed char>::value)
+    printf_arg_formatter<buffer_range<Char>>::apply_length_mod_signed_char(arg, type);
+  else if (std::is_same<T, short>::value)
+    printf_arg_formatter<buffer_range<Char>>::apply_length_mod_short_val(arg, type);
+  else if (std::is_same<T, long>::value)
+    printf_arg_formatter<buffer_range<Char>>::apply_length_mod_long_val(arg, type);
+  else if (std::is_same<T, long long>::value)
+    printf_arg_formatter<buffer_range<Char>>::apply_length_mod_long_long_val(arg, type);
+  else if (std::is_same<T, size_t>::value)
+    printf_arg_formatter<buffer_range<Char>>::apply_length_mod_size_t_val(arg, type);
+  else if (std::is_same<T, std::ptrdiff_t>::value)
+    printf_arg_formatter<buffer_range<Char>>::apply_length_mod_ptrdiff_val(arg, type);
+  else if (std::is_same<T, intmax_t>::value)
+    printf_arg_formatter<buffer_range<Char>>::apply_length_mod_intmax_val(arg, type);
+  else if (!std::is_same<T, void>::value)
+    printf_arg_formatter<buffer_range<Char>>::apply_length_mod_unsigned_val(arg, type);
+  detail::convert_arg<T, context>(arg, type);
+}
