+		grown := s.newResourceSlots()
+		copy(grown, nodes)
+		nodes = grown
+	}
+	idx := s.contentNodeLanguageIndex(n)
+	if idx >= 0 && idx < len(nodes) {
+		nodes[idx] = n
+	}
+	return nodes
+}
