+func (s *contentNodeShifter) assignLanguagePage(nodes contentNodeIs, n *pageState) contentNodeIs {
+	if nodes == nil {
+		nodes = s.newContentNodeSlots()
+	} else if s.numLanguages > 0 && len(nodes) < s.numLanguages {
+		grown := s.newContentNodeSlots()
+		copy(grown, nodes)
+		nodes = grown
+	}
+	idx := s.contentNodeLanguageIndex(n)
+	if idx >= 0 && idx < len(nodes) {
+		nodes[idx] = n
+	}
+	return nodes
+}
