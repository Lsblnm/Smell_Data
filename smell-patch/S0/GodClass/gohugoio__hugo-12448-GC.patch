+func (sh *contentNodeShifter) forEachPage(m *pageMap, include predicate.P[*pageState], fn func(p *pageState) (bool, error)) error {
+	if include == nil {
+		include = func(p *pageState) bool {
+			return true
+		}
+	}
+	w := &doctree.NodeShiftTreeWalker[contentNodeI]{
+		Tree:     m.treePages,
+		LockType: doctree.LockTypeRead,
+		Handle: func(key string, n contentNodeI, match doctree.DimensionFlag) (bool, error) {
+			if p, ok := n.(*pageState); ok && include(p) {
+				if terminate, err := fn(p); terminate || err != nil {
+					return terminate, err
+				}
+			}
+			return false, nil
+		},
+	}
+
+	return w.Walk(context.Background())
+}
