+
+	tok := l.dispToken()
+	msg := fmt.Sprintf("syntax error: unexpected token '%s', expecting '%s', at %s:%d import chain: ['%s']", l.dispVal(), expected, l.dispFile(), l.dispLine(), strings.Join(tok.imports, "','"))
+	return fmt.Errorf("%s", msg)
+}
+
+func (l *lexer) dispWrapErr(err error) error {
+	if l.cursor.cursor < -1 {
+		l.cursor.cursor = -1
+	}
+
+	tok := l.dispToken()
+	if len(tok.imports) > 0 {
+		return fmt.Errorf("%w, at %s:%d import chain ['%s']", err, l.dispFile(), l.dispLine(), strings.Join(tok.imports, "','"))
+	}
+	return fmt.Errorf("%w, at %s:%d", err, l.dispFile(), l.dispLine())
+}
+
+func (l *lexer) dispNextSegment() Segment {
+	tkns := Segment{l.dispToken()}
+	for l.dispNextArg() {
+		tkns = append(tkns, l.dispToken())
+	}
+	var openedBlock bool
+	for nesting := l.dispNestingLevel(); l.dispNextBlock(nesting); {
+		if !openedBlock {
+			l.dispRetreat()
+			tkns = append(tkns, l.dispToken())
+			l.dispAdvance()
+			openedBlock = true
+		}
+		tkns = append(tkns, l.dispToken())
+	}
+	if openedBlock {
+		tkns = append(tkns, l.dispToken())
+	}
+	return tkns
+}
+
+func (l *lexer) expandEnvVars(input []byte) []byte {
+	l.env.input = input
+	l.env.offset = 0
+	for {
+		begin, end, ok := l.nextEnvSpan()
+		if !ok {
+			break
+		}
+		envString := l.env.input[begin+len(spanOpen) : end]
+		if len(envString) == 0 {
+			l.env.offset = end + len(spanClose)
+			continue
+		}
+		envVarValue := l.lookupEnvSpan(envString)
+		l.spliceEnvValue(begin, end, []byte(envVarValue))
+	}
+	return l.env.input
+}
+
+func (l *lexer) nextEnvSpan() (int, int, bool) {
+	if l.env.offset > len(l.env.input) {
+		return 0, 0, false
+	}
+	beginRel := bytes.Index(l.env.input[l.env.offset:], spanOpen)
+	if beginRel < 0 {
+		return 0, 0, false
+	}
+	begin := beginRel + l.env.offset
+	endRel := bytes.Index(l.env.input[begin+len(spanOpen):], spanClose)
+	if endRel < 0 {
+		return 0, 0, false
+	}
+	end := endRel + begin + len(spanOpen)
+	return begin, end, true
+}
+
+func (l *lexer) lookupEnvSpan(envString []byte) string {
+	if l.env.offset < 0 {
+		l.env.offset = 0
+	}
+
+	envParts := strings.SplitN(string(envString), envVarDefaultDelimiter, 2)
+	if len(envParts) == 0 {
+		return ""
+	}
+	envVarValue, found := os.LookupEnv(envParts[0])
+	if !found && len(envParts) == 2 {
+		return envParts[1]
+	}
+	return envVarValue
+}
+
+func (l *lexer) spliceEnvValue(begin, end int, envVarBytes []byte) {
+	l.env.input = append(l.env.input[:begin], append(envVarBytes, l.env.input[end+len(spanClose):]...)...)
+	l.env.offset = begin + len(envVarBytes)
+}
+
+func (l *lexer) formatCaddyfile(input []byte) []byte {
+	l.fmtReset()
+	input = bytes.TrimSpace(input)
+	rdr := bytes.NewReader(input)
+
+	for {
+		ch, _, err := rdr.ReadRune()
+		if err != nil {
+			if err == io.EOF {
+				break
+			}
+			panic(err)
+		}
+		if l.fmtConsumeSpecial(ch) {
+			continue
+		}
+		l.fmtWriteRegular(ch)
+	}
+
+	trimmedResult := bytes.TrimSpace(l.layout.out.Bytes())
+	return append(trimmedResult, '\n')
+}
+
+func (l *lexer) fmtReset() {
+	l.layout.out = new(bytes.Buffer)
+	l.layout.last = 0
+	l.layout.space = true
+	l.layout.beginningOfLine = true
+	l.layout.openBrace = false
+	l.layout.openBraceWritten = false
+	l.layout.openBraceSpace = false
+	l.layout.newLines = 0
+	l.layout.comment = false
+	l.layout.quoted = false
+	l.layout.escaped = false
+	l.layout.nesting = 0
+}
+
+func (l *lexer) fmtWrite(ch rune) {
+	l.layout.out.WriteRune(ch)
+	l.layout.last = ch
+}
+
+func (l *lexer) fmtIndent() {
+	for tabs := l.layout.nesting; tabs > 0; tabs-- {
+		l.fmtWrite('\t')
+	}
+}
+
+func (l *lexer) fmtNextLine() {
+	l.fmtWrite('\n')
+	l.layout.beginningOfLine = true
+}
+
+func (l *lexer) fmtConsumeSpecial(ch rune) bool {
+	if l.layout.comment {
+		return l.fmtHandleComment(ch)
+	}
+	if !l.layout.escaped && ch == '\\' {
+		return l.fmtHandleBackslash(ch)
+	}
+	if l.layout.escaped {
+		return l.fmtHandleEscaped(ch)
+	}
+	if l.layout.quoted {
+		return l.fmtHandleQuoted(ch)
+	}
+	if l.layout.space && ch == '"' {
+		l.layout.quoted = true
+	}
+	if unicode.IsSpace(ch) {
+		return l.fmtHandleSpace(ch)
+	}
+	return false
+}
+
+func (l *lexer) fmtHandleComment(ch rune) bool {
+	if ch == '\n' {
+		l.layout.comment = false
+		l.layout.space = true
+		l.fmtNextLine()
+		return true
+	}
+	l.fmtWrite(ch)
+	return true
+}
+
+func (l *lexer) fmtHandleBackslash(ch rune) bool {
+	if l.layout.space {
+		l.fmtWrite(' ')
+		l.layout.space = false
+	}
+	l.fmtWrite(ch)
+	l.layout.escaped = true
+	return true
+}
+
+func (l *lexer) fmtHandleEscaped(ch rune) bool {
+	l.fmtWrite(ch)
+	l.layout.escaped = false
+	return true
+}
+
+func (l *lexer) fmtHandleQuoted(ch rune) bool {
+	if ch == '"' {
+		l.layout.quoted = false
+	}
+	l.fmtWrite(ch)
+	return true
+}
+
+func (l *lexer) fmtHandleSpace(ch rune) bool {
+	l.layout.space = true
+	if ch == '\n' {
+		l.layout.newLines++
+	}
+	return true
+}
+
+func (l *lexer) fmtWriteRegular(ch rune) {
+	spacePrior := l.layout.space
+	l.layout.space = false
+
+	if ch == '#' {
+		l.layout.comment = true
+	}
+
+	if l.layout.openBrace && spacePrior && !l.layout.openBraceWritten {
+		l.fmtFlushOpenBrace()
+	}
+
+	if l.fmtHandleBraces(ch, spacePrior) {
+		return
+	}
+
+	l.fmtEmitContent(ch, spacePrior)
+}
+
+func (l *lexer) fmtFlushOpenBrace() {
+	if l.layout.nesting == 0 && l.layout.last == '}' {
+		l.fmtNextLine()
+		l.fmtNextLine()
+	}
+
+	l.layout.openBrace = false
+	if l.layout.beginningOfLine {
+		l.fmtIndent()
+	} else if !l.layout.openBraceSpace {
+		l.fmtWrite(' ')
+	}
+	l.fmtWrite('{')
+	l.layout.openBraceWritten = true
+	l.fmtNextLine()
+	l.layout.newLines = 0
+	if l.layout.nesting < 10 {
+		l.layout.nesting++
+	}
+}
+
+func (l *lexer) fmtHandleBraces(ch rune, spacePrior bool) bool {
+	switch {
+	case ch == '{':
+		l.layout.openBrace = true
+		l.layout.openBraceWritten = false
+		l.layout.openBraceSpace = spacePrior && !l.layout.beginningOfLine
+		if l.layout.openBraceSpace {
+			l.fmtWrite(' ')
+		}
+		return true
+	case ch == '}' && (spacePrior || !l.layout.openBrace):
+		if l.layout.last != '\n' {
+			l.fmtNextLine()
+		}
+		if l.layout.nesting > 0 {
+			l.layout.nesting--
+		}
+		l.fmtIndent()
+		l.fmtWrite('}')
+		l.layout.newLines = 0
+		return true
+	}
+	return false
+}
+
+func (l *lexer) fmtEmitContent(ch rune, spacePrior bool) {
+	if l.layout.newLines > 2 {
+		l.layout.newLines = 2
+	}
+	for i := 0; i < l.layout.newLines; i++ {
+		l.fmtNextLine()
+	}
+	l.layout.newLines = 0
+	if l.layout.beginningOfLine {
+		l.fmtIndent()
+	}
+	if l.layout.nesting == 0 && l.layout.last == '}' && l.layout.beginningOfLine {
+		l.fmtNextLine()
+		l.fmtNextLine()
+	}
+
+	if !l.layout.beginningOfLine && spacePrior {
+		l.fmtWrite(' ')
+	}
+
+	if l.layout.openBrace && !l.layout.openBraceWritten {
+		l.fmtWrite('{')
+		l.layout.openBraceWritten = true
+	}
+	l.fmtWrite(ch)
+	l.layout.beginningOfLine = false
+}
+
+func (l *lexer) parseSiteAddress(str string) error {
+	const maxLen = 4096
+	if len(str) > maxLen {
+		str = str[:maxLen]
+	}
+	remaining := strings.TrimSpace(str)
+	l.site.original = remaining
+	l.site.scheme = ""
+	l.site.host = ""
+	l.site.port = ""
+	l.site.path = ""
+
+	if err := l.extractAddrScheme(&remaining); err != nil {
+		return err
+	}
+	if err := l.extractAddrHostPort(remaining); err != nil {
+		return err
+	}
+	return l.validateAddrPort()
+}
+
+func (l *lexer) extractAddrScheme(remaining *string) error {
+	splitScheme := strings.SplitN(*remaining, "://", 2)
+	switch len(splitScheme) {
+	case 0:
+		return nil
+	case 1:
+		*remaining = splitScheme[0]
+	case 2:
+		l.site.scheme = splitScheme[0]
+		*remaining = splitScheme[1]
+	}
+	return nil
+}
+
+func (l *lexer) extractAddrHostPort(remaining string) error {
+	hostSplit := strings.SplitN(remaining, "/", 2)
+	if len(hostSplit) > 0 {
+		host, port, err := net.SplitHostPort(hostSplit[0])
+		if err != nil {
+			host, port, err = net.SplitHostPort(hostSplit[0] + ":")
+			if err != nil {
+				host = hostSplit[0]
+			}
+		}
+		l.site.host = host
+		l.site.port = port
+	}
+	if len(hostSplit) == 2 {
+		l.site.path = "/" + hostSplit[1]
+	}
+	return nil
+}
+
+func (l *lexer) validateAddrPort() error {
+	if l.site.port == "" {
+		return nil
+	}
+	portNum, err := strconv.Atoi(l.site.port)
+	if err != nil {
+		return fmt.Errorf("invalid port '%s': %v", l.site.port, err)
+	}
+	if portNum < 0 || portNum > 65535 {
+		return fmt.Errorf("port %d is out of range", portNum)
+	}
+	return nil
+}
+
+func (l *lexer) siteAddressParts() (scheme, host, port, path, original string) {
+	return l.site.scheme, l.site.host, l.site.port, l.site.path, l.site.original
+}
+
+func (l *lexer) normalizeSiteAddress(scheme, host, port, path string) (string, string, string, string) {
+	l.site.scheme = scheme
+	l.site.host = host
+	l.site.port = port
+	l.site.path = path
+	l.site.host = l.normalizeAddrHost(l.site.host)
+	l.site.scheme = l.lowerExceptPlaceholders(l.site.scheme)
+	l.site.host = l.lowerExceptPlaceholders(l.site.host)
+	return l.site.scheme, l.site.host, l.site.port, l.site.path
+}
+
+func (l *lexer) normalizeAddrHost(host string) string {
+	if l.site.original == "" && l.site.host == "" && l.site.scheme == "" {
+		l.site.host = host
+	}
+
+	host = strings.TrimSpace(host)
+	ip, err := netip.ParseAddr(host)
+	if err != nil {
+		return host
+	}
+	if ip.Is6() && !ip.Is4() && !ip.Is4In6() {
+		return ip.String()
+	}
+	return host
+}
+
+func (l *lexer) lowerExceptPlaceholders(s string) string {
+	if s == "" && l.site.host == "" && l.site.scheme == "" {
+		return s
+	}
+
+	var sb strings.Builder
+	var escaped, inPlaceholder bool
+	for _, ch := range s {
+		if ch == '\\' && !escaped {
+			escaped = true
+			sb.WriteRune(ch)
+			continue
+		}
+		if ch == '{' && !escaped {
+			inPlaceholder = true
+		}
+		if ch == '}' && inPlaceholder && !escaped {
+			inPlaceholder = false
+		}
+		if inPlaceholder {
+			sb.WriteRune(ch)
+		} else {
+			sb.WriteRune(unicode.ToLower(ch))
+		}
+		escaped = false
+	}
+	return sb.String()
+}
+
+func (l *lexer) resetImportTracker() {
+	l.imprt.tracker = &importGraph{
+		nodes: make(map[string]bool),
+		edges: make(adjacency),
+	}
+}
+
+func (l *lexer) ensureImportTracker() {
+	if l.imprt.tracker == nil {
+		l.resetImportTracker()
+	}
+}
+
+func (l *lexer) trackImportEdges(from string, tos []string) error {
+	l.ensureImportTracker()
+	l.imprt.tracker.addNode(from)
+	l.imprt.tracker.addNodes(tos)
+	if err := l.imprt.tracker.addEdges(from, tos); err != nil {
+		l.imprt.tracker.removeNodes(tos)
+		return err
+	}
+	return nil
+}
+
+func (l *lexer) importPathReaches(from, to string) bool {
+	l.ensureImportTracker()
+	collector := make(map[string]bool)
+
+	var visit func(string)
+	visit = func(start string) {
+		if !collector[start] {
+			collector[start] = true
+			for _, v := range l.imprt.tracker.edges[start] {
+				visit(v)
+			}
+		}
+	}
+
+	for _, v := range l.imprt.tracker.edges[from] {
+		visit(v)
+	}
+	for k := range collector {
+		if to == k {
+			return true
+		}
+	}
+	return false
+}
+
+func (l *lexer) validateImportGlob(pattern string) error {
+	l.ensureImportTracker()
+	l.imprt.globPattern = pattern
+	if strings.Count(l.imprt.globPattern, "*") > 1 || strings.Count(l.imprt.globPattern, "?") > 1 ||
+		(strings.Contains(l.imprt.globPattern, "[") && strings.Contains(l.imprt.globPattern, "]")) {
+		return fmt.Errorf("Glob pattern may only contain one wildcard (*), but has others: %s", l.imprt.globPattern)
+	}
+	return nil
+}
+
+func (l *lexer) resolveImportGlob(currentFile, importPattern string) (string, error) {
+	l.ensureImportTracker()
+	l.imprt.globPattern = importPattern
+	absFile, err := filepath.Abs(currentFile)
+	if err != nil {
+		return "", fmt.Errorf("Failed to get absolute path of file: %s: %v", currentFile, err)
+	}
+	if filepath.IsAbs(importPattern) {
+		return importPattern, nil
+	}
+	return filepath.Join(filepath.Dir(absFile), importPattern), nil
+}
+
+func (l *lexer) filterHiddenGlobMatches(globPattern string, matches []string) []string {
+	l.ensureImportTracker()
+	l.imprt.globPattern = globPattern
+	sep := string(filepath.Separator)
+	segGlobPattern := strings.Split(globPattern, sep)
+	if len(segGlobPattern) == 0 {
+		return matches
+	}
+	if !strings.HasPrefix(segGlobPattern[len(segGlobPattern)-1], "*") {
+		return matches
+	}
+	var tmpMatches []string
+	for _, m := range matches {
+		seg := strings.Split(m, sep)
+		if len(seg) == 0 {
+			continue
+		}
+		if !strings.HasPrefix(seg[len(seg)-1], ".") {
+			tmpMatches = append(tmpMatches, m)
+		}
+	}
+	return tmpMatches
+}
+
+func (l *lexer) parseVariadicArgs(token Token, argCount int) (bool, int, int) {
+	l.ensureImportTracker()
+	l.imprt.variadicLimit = argCount
+	if !strings.HasPrefix(token.Text, "{args[") {
+		return false, 0, 0
+	}
+	if !strings.HasSuffix(token.Text, "]}") {
+		return false, 0, 0
+	}
+
+	argRange := strings.TrimSuffix(strings.TrimPrefix(token.Text, "{args["), "]}")
+	if argRange == "" {
+		caddy.Log().Named("caddyfile").Warn(
+			"Placeholder "+token.Text+" cannot have an empty index",
+			zap.String("file", token.File+":"+strconv.Itoa(token.Line)), zap.Strings("import_chain", token.imports))
+		return false, 0, 0
+	}
+
+	start, end, found := strings.Cut(argRange, ":")
+	if !found {
+		return false, 0, 0
+	}
+	if strings.Contains(start, "}") || strings.Contains(end, "{") {
+		return false, 0, 0
+	}
+
+	startIndex := 0
+	endIndex := l.imprt.variadicLimit
+	var err error
+	if start != "" {
+		startIndex, err = strconv.Atoi(start)
+		if err != nil {
+			caddy.Log().Named("caddyfile").Warn(
+				"Variadic placeholder "+token.Text+" has an invalid start index",
+				zap.String("file", token.File+":"+strconv.Itoa(token.Line)), zap.Strings("import_chain", token.imports))
+			return false, 0, 0
+		}
+	}
+	if end != "" {
+		endIndex, err = strconv.Atoi(end)
+		if err != nil {
+			caddy.Log().Named("caddyfile").Warn(
+				"Variadic placeholder "+token.Text+" has an invalid end index",
+				zap.String("file", token.File+":"+strconv.Itoa(token.Line)), zap.Strings("import_chain", token.imports))
+			return false, 0, 0
+		}
+	}
+
+	if startIndex < 0 || startIndex > endIndex || endIndex > l.imprt.variadicLimit {
+		caddy.Log().Named("caddyfile").Warn(
+			"Variadic placeholder "+token.Text+" indices are out of bounds, only "+strconv.Itoa(l.imprt.variadicLimit)+" argument(s) exist",
+			zap.String("file", token.File+":"+strconv.Itoa(token.Line)), zap.Strings("import_chain", token.imports))
+		return false, 0, 0
+	}
+	return true, startIndex, endIndex
+}
+
+func (l *lexer) buildArgsReplacer(args []string) *caddy.Replacer {
+	l.ensureImportTracker()
+	l.imprt.args = args
+	repl := caddy.NewEmptyReplacer()
+	repl.Map(func(key string) (any, bool) {
+		return l.lookupImportArg(key)
+	})
+	return repl
+}
+
+func (l *lexer) lookupImportArg(key string) (any, bool) {
+	l.ensureImportTracker()
+	if matches := argsRegexpIndexDeprecated.FindStringSubmatch(key); len(matches) > 0 {
+		if matches[0] != key {
+			return nil, false
+		}
+		value, err := strconv.Atoi(matches[1])
+		if err != nil {
+			caddy.Log().Named("caddyfile").Warn(
+				"Placeholder {args." + matches[1] + "} has an invalid index")
+			return nil, false
+		}
+		if value >= len(l.imprt.args) {
+			caddy.Log().Named("caddyfile").Warn(
+				"Placeholder {args." + matches[1] + "} index is out of bounds, only " + strconv.Itoa(len(l.imprt.args)) + " argument(s) exist")
+			return nil, false
+		}
+		caddy.Log().Named("caddyfile").Warn(
+			"Placeholder {args." + matches[1] + "} deprecated, use {args[" + matches[1] + "]} instead")
+		return l.imprt.args[value], true
+	}
+
+	if matches := argsRegexpIndex.FindStringSubmatch(key); len(matches) > 0 {
+		if matches[0] != key {
+			return nil, false
+		}
+		if strings.Contains(matches[1], ":") {
+			caddy.Log().Named("caddyfile").Warn(
+				"Variadic placeholder {args[" + matches[1] + "]} must be a token on its own")
+			return nil, false
+		}
+		value, err := strconv.Atoi(matches[1])
+		if err != nil {
+			caddy.Log().Named("caddyfile").Warn(
+				"Placeholder {args[" + matches[1] + "]} has an invalid index")
+			return nil, false
+		}
+		if value >= len(l.imprt.args) {
+			caddy.Log().Named("caddyfile").Warn(
+				"Placeholder {args[" + matches[1] + "]} index is out of bounds, only " + strconv.Itoa(len(l.imprt.args)) + " argument(s) exist")
+			return nil, false
+		}
+		return l.imprt.args[value], true
+	}
+	return nil, false
+}
+
+func (l *lexer) importChainLabel(file string, line int, snippet string) string {
+	if l.imprt.tracker == nil {
+		l.resetImportTracker()
+	}
+
+	if snippet != "" {
+		return fmt.Sprintf("%s:%d (import %s)", file, line, snippet)
+	}
+	return fmt.Sprintf("%s:%d (import)", file, line)
+}
+
+func (l *lexer) snippetIdentifier(text string) bool {
+	if l.imprt.tracker == nil {
+		l.resetImportTracker()
+	}
+
+	return len(text) >= 3 && strings.HasPrefix(text, "(") && strings.HasSuffix(text, ")")
+}
+
+func (l *lexer) namedRouteIdentifier(text string) bool {
+	if l.imprt.tracker == nil {
+		l.resetImportTracker()
+	}
+
+	return strings.HasPrefix(text, "&(") && strings.HasSuffix(text, ")")
+}
+
+func (l *lexer) stripSnippetName(text string) string {
+	if l.imprt.tracker == nil {
+		l.resetImportTracker()
+	}
+
+	if l.snippetIdentifier(text) {
+		return strings.TrimSuffix(text[1:], ")")
+	}
+	if l.namedRouteIdentifier(text) {
+		return strings.TrimSuffix(text[2:], ")")
+	}
+	return text
+}
+
+func (l *lexer) emptyImportFile(input []byte) bool {
+	if l.imprt.tracker == nil {
+		l.resetImportTracker()
+	}
+
+	if len(input) == 0 {
+		return true
+	}
+	return len(strings.TrimSpace(string(input))) == 0
