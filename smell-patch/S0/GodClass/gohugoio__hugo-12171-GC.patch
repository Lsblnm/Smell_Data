+func (m *pageMap) navigateIsAncestor(p *pageState, other any) bool {
+	n, ok := other.(contentNodeI)
+	if !ok {
+		return false
+	}
+	if n.Path() == p.Path() {
+		return false
+	}
+	if existing := m.navTree.Get(n.Path()); existing != nil {
+		n = existing
+	}
+	return strings.HasPrefix(n.Path(), paths.AddTrailingSlash(p.Path()))
+}
+
+func (m *pageMap) navigateIsDescendant(p *pageState, other any) bool {
+	n, ok := other.(contentNodeI)
+	if !ok {
+		return false
+	}
+	if n.Path() == p.Path() {
+		return false
+	}
+	if existing := m.navTree.Get(n.Path()); existing != nil {
+		n = existing
+	}
+	return strings.HasPrefix(p.Path(), paths.AddTrailingSlash(n.Path()))
+}
+
+func (m *pageMap) navigateCurrentSection(p *pageState) page.Page {
+	if kinds.IsBranch(p.Kind()) {
+		return p
+	}
+
+	dir := p.m.pathInfo.Dir()
+	if dir == "/" {
+		return m.navSite.home
+	}
+
+	_, n := m.navTree.LongestPrefix(dir, true, func(n contentNodeI) bool { return n.isContentNodeBranch() })
+	if n != nil {
+		return n.(page.Page)
+	}
+
+	panic(fmt.Sprintf("CurrentSection not found for %q in lang %s", p.Path(), p.Lang()))
+}
+
+func (m *pageMap) navigateFirstSection(p *pageState) page.Page {
+	s := p.m.pathInfo.Dir()
+	if s == "/" {
+		return m.navSite.home
+	}
+
+	for {
+		k, n := m.navTree.LongestPrefix(s, true, func(n contentNodeI) bool { return n.isContentNodeBranch() })
+		if n == nil {
+			return nil
+		}
+		if strings.Count(k, "/") < 2 {
+			return n.(page.Page)
+		}
+		if s == "" {
+			return nil
+		}
+		s = paths.Dir(s)
+	}
+}
+
+func (m *pageMap) navigateInSection(p *pageState, other any) bool {
+	if p == nil || types.IsNil(other) || m.navTree == nil {
+		return false
+	}
+	pp, ok := other.(page.Page)
+	if !ok {
+		return false
+	}
+	if n := m.navTree.Get(p.Path()); n != nil {
+		if ps, ok := n.(*pageState); ok {
+			p = ps
+		}
+	}
+	return m.navigateCurrentSection(p) == pp.CurrentSection()
+}
+
+func (m *pageMap) navigateParent(p *pageState) page.Page {
+	if p.IsHome() {
+		return nil
+	}
+
+	dir := p.m.pathInfo.ContainerDir()
+	if dir == "" {
+		return m.navSite.home
+	}
+
+	_, n := m.navTree.LongestPrefix(dir, true, nil)
+	if n != nil {
+		return n.(page.Page)
+	}
+	return nil
+}
+
+func (m *pageMap) navigateAncestors(p *pageState) page.Pages {
+	var ancestors page.Pages
+	if m.navTree == nil {
+		return ancestors
+	}
+	parent := m.navigateParent(p)
+	for parent != nil {
+		if n := m.navTree.Get(parent.Path()); n != nil {
+			if ps, ok := n.(page.Page); ok {
+				parent = ps
+			}
+		}
+		ancestors = append(ancestors, parent)
+		parent = parent.Parent()
+	}
+	return ancestors
+}
+
+func (m *pageMap) navigateSections(p *pageState) page.Pages {
+	var (
+		pages               page.Pages
+		currentBranchPrefix string
+		s                   = p.Path()
+		prefix              = paths.AddTrailingSlash(s)
+		tree                = m.navTree
+	)
+
+	w := &doctree.NodeShiftTreeWalker[contentNodeI]{
+		Tree:   tree,
+		Prefix: prefix,
+	}
+	w.Handle = func(ss string, n contentNodeI, match doctree.DimensionFlag) (bool, error) {
+		if !n.isContentNodeBranch() {
+			return false, nil
+		}
+		if currentBranchPrefix == "" || !strings.HasPrefix(ss, currentBranchPrefix) {
+			if ps, ok := n.(*pageState); ok && ps.IsSection() && ps.m.shouldList(false) && ps.Parent() == p {
+				pages = append(pages, ps)
+			} else {
+				w.SkipPrefix(ss + "/")
+			}
+		}
+		currentBranchPrefix = ss + "/"
+		return false, nil
+	}
+
+	if err := w.Walk(context.Background()); err != nil {
+		panic(err)
+	}
+
+	page.SortByDefault(pages)
+	return pages
+}
+
+func (m *pageMap) navigateSectionsEntries(p *pageState) []string {
+	if m.navTree == nil {
+		return nil
+	}
+	sp := m.navigateSectionsPath(p)
+	if sp == "/" {
+		return nil
+	}
+	entries := strings.Split(sp[1:], "/")
+	if len(entries) == 0 {
+		return nil
+	}
+	return entries
+}
+
+func (m *pageMap) navigateSectionsPath(p *pageState) string {
+	if m.navTree == nil {
+		return p.Path()
+	}
+	return m.navigateCurrentSection(p).Path()
+}
