+func (m *pageMap) lookupPageForRefs(ref ...string) (page.Page, error) {
+	if m.finderTree == nil {
+		return nil, nil
+	}
+	var refs []string
+	for _, r := range ref {
+		if r != "" && r != "/" {
+			refs = append(refs, r)
+		}
+	}
+
+	var key string
+	if len(refs) > 2 {
+		return nil, fmt.Errorf(`too many arguments to .Site.GetPage: %v. Use lookups on the form {{ .Site.GetPage "/posts/mypage-md" }}`, ref)
+	}
+
+	if len(refs) == 0 || refs[0] == kinds.KindHome {
+		key = "/"
+	} else if len(refs) == 1 {
+		if len(ref) == 2 && refs[0] == kinds.KindSection {
+			key = "/"
+		} else {
+			key = refs[0]
+		}
+	} else {
+		key = refs[1]
+	}
+
+	key = filepath.ToSlash(key)
+	if !strings.HasPrefix(key, "/") {
+		key = "/" + key
+	}
+
+	return m.lookupPage(nil, key)
+}
+
+func (m *pageMap) lookupContentNode(context page.Page, isReflink bool, ref string) (contentNodeI, error) {
+	if m.finderTree == nil {
+		return nil, nil
+	}
+	ref = paths.ToSlashTrimTrailing(ref)
+	inRef := ref
+	if ref == "" {
+		ref = "/"
+	}
+
+	if paths.HasExt(ref) {
+		return m.lookupContentNodeForRef(context, isReflink, true, inRef, ref)
+	}
+
+	if ref == "/" {
+		if n, err := m.lookupContentNodeForRef(context, isReflink, false, inRef, "/_index"+defaultContentExt); n != nil || err != nil {
+			return n, err
+		}
+	} else if strings.HasSuffix(ref, "/index") {
+		if n, err := m.lookupContentNodeForRef(context, isReflink, false, inRef, ref+"/index"+defaultContentExt); n != nil || err != nil {
+			return n, err
+		}
+		if n, err := m.lookupContentNodeForRef(context, isReflink, false, inRef, ref+defaultContentExt); n != nil || err != nil {
+			return n, err
+		}
+	} else {
+		if n, err := m.lookupContentNodeForRef(context, isReflink, false, inRef, ref+defaultContentExt); n != nil || err != nil {
+			return n, err
+		}
+	}
+
+	return nil, nil
+}
+
+func (m *pageMap) lookupContentNodeForRef(context page.Page, isReflink, hadExtension bool, inRef, ref string) (contentNodeI, error) {
+	s := m.finderSite
+	if m.finderTree == nil || s == nil {
+		return nil, nil
+	}
+	contentPathParser := s.Conf.PathParser()
+
+	if context != nil && !strings.HasPrefix(ref, "/") {
+		var baseDir string
+		if pi := context.PathInfo(); pi != nil {
+			if pi.IsBranchBundle() || (hadExtension && strings.HasPrefix(ref, "../")) {
+				baseDir = pi.Dir()
+			} else {
+				baseDir = pi.ContainerDir()
+			}
+		}
+
+		rel := path.Join(baseDir, ref)
+		relPath, _ := contentPathParser.ParseBaseAndBaseNameNoIdentifier(files.ComponentFolderContent, rel)
+
+		n, err := m.lookupContentNodeFromPath(relPath, ref)
+		if n != nil || err != nil {
+			return n, err
+		}
+
+		if hadExtension && context.File() != nil {
+			if n, err := m.lookupContentNodeFromReverseLookup(inRef, context.File().FileInfo()); n != nil || err != nil {
+				return n, err
+			}
+		}
+	}
+
+	if strings.HasPrefix(ref, ".") {
+		return nil, nil
+	}
+
+	relPath, nameNoIdentifier := contentPathParser.ParseBaseAndBaseNameNoIdentifier(files.ComponentFolderContent, ref)
+	n, err := m.lookupContentNodeFromPath(relPath, ref)
+	if n != nil || err != nil {
+		return n, err
+	}
+
+	if hadExtension && s.home != nil && s.home.File() != nil {
+		if n, err := m.lookupContentNodeFromReverseLookup(inRef, s.home.File().FileInfo()); n != nil || err != nil {
+			return n, err
+		}
+	}
+
+	var doSimpleLookup bool
+	if isReflink || context == nil {
+		slashCount := strings.Count(inRef, "/")
+		if slashCount <= 1 {
+			doSimpleLookup = slashCount == 0 || ref[0] == '/'
+		}
+	}
+
+	if !doSimpleLookup {
+		return nil, nil
+	}
+
+	n = m.finderIndex.Get(nameNoIdentifier)
+	if n == ambiguousContentNode {
+		return nil, fmt.Errorf("page reference %q is ambiguous", inRef)
+	}
+
+	return n, nil
+}
+
+func (m *pageMap) lookupContentNodeFromReverseLookup(ref string, fi hugofs.FileMetaInfo) (contentNodeI, error) {
+	s := m.finderSite
+	meta := fi.Meta()
+	dir := meta.Filename
+	if !fi.IsDir() {
+		dir = filepath.Dir(meta.Filename)
+	}
+
+	realFilename := filepath.Join(dir, ref)
+	pcs, err := s.BaseFs.Content.ReverseLookup(realFilename, true)
+	if err != nil {
+		return nil, err
+	}
+
+	for _, pc := range pcs {
+		pi := s.Conf.PathParser().Parse(pc.Component, pc.Path)
+		if n := m.finderTree.Get(pi.Base()); n != nil {
+			return n, nil
+		}
+	}
+	return nil, nil
+}
+
+func (m *pageMap) lookupContentNodeFromPath(s string, ref string) (contentNodeI, error) {
+	n := m.finderTree.Get(s)
+	if n != nil {
+		return n, nil
+	}
+	return nil, nil
+}
