+              end
+            end
+
+            rvalue = rvalue.sub(Fluent::Plugin::Output::CHUNK_ID_PLACEHOLDER_PATTERN) {
+              if chunk_passed
+                output.dump_unique_id_hex(chunk.unique_id)
+              else
+                output.log.warn "${chunk_id} is not allowed in this plugin. Pass Chunk instead of metadata in extract_placeholders's 2nd argument"
+              end
+            }
+
+            chunk_keys = output.chunk_keys
+            if !chunk_keys.empty? && metadata.variables
+              hash = {'${tag}' => '${tag}'}
+              chunk_keys.each do |key|
+                hash["${#{key}}"] = metadata.variables[key.to_sym]
+              end
