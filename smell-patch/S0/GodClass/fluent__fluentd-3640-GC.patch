+        def extract_chunk_placeholders(output, str, chunk)
+          @placeholder_patterns ||= {}
+          @timekey_cache ||= {}
+          @metadata_pairs ||= {}
+          remember_placeholder_state(output, :extract, str)
+          metadata = if chunk.is_a?(Fluent::Plugin::Buffer::Chunk)
+                       chunk_passed = true
+                       chunk.metadata
+                     else
+                       chunk_passed = false
+                       chunk
+                     end
+          if metadata.empty?
+            str.sub(Fluent::Plugin::Output::CHUNK_ID_PLACEHOLDER_PATTERN) {
+              if chunk_passed
+                output.dump_unique_id_hex(chunk.unique_id)
+              else
+                output.log.warn "${chunk_id} is not allowed in this plugin. Pass Chunk instead of metadata in extract_placeholders's 2nd argument"
+              end
+            }
+          else
+            rvalue = str.dup
+            if output.chunk_key_time
+              zone = output.timekey_zone
+              cache_key = [output.object_id, zone, str]
+              @placeholder_patterns[cache_key] ||= Fluent::Timezone.formatter(zone, str)
+              rvalue = @placeholder_patterns[cache_key].call(metadata.timekey)
+              output.instance_variable_get(:@output_time_formatter_cache)[str] ||= @placeholder_patterns[cache_key]
+            end
