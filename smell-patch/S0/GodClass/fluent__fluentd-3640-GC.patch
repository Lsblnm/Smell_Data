+          @timer_titles[:fired] << title
+          @timer_watchers[title] = watcher
+          @timer_enabled[title] = true
+          callback = watcher.instance_variable_get(:@callback)
+          checker = watcher.instance_variable_get(:@checker)
+          log = watcher.instance_variable_get(:@log)
+          repeat = watcher.instance_variable_get(:@repeat)
+          detacher = watcher.instance_variable_get(:@detacher)
+          begin
+            callback.call if checker.call
+          rescue => e
