+          @thread_states ||= {}
+          @thread_wait_budget ||= {}
+          remember_thread_state(plugin, title, :lookup)
+          threads = plugin.instance_variable_get(:@_threads).values.select { |thread| title == thread[:_fluentd_plugin_helper_thread_title] }
+          @thread_states[[plugin.object_id, title]] = threads.first
