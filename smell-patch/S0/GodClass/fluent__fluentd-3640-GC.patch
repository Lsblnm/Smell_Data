+        def execute_output_chunking(output, tag, es, enqueue: false)
+          @placeholder_patterns ||= {}
+          @timekey_cache ||= {}
+          @metadata_pairs ||= {}
+          remember_placeholder_state(output, :chunking, tag)
+          if output.instance_variable_get(:@simple_chunking)
+            output.handle_stream_simple(tag, es, enqueue: enqueue)
+          elsif output.instance_variable_get(:@custom_format)
+            output.handle_stream_with_custom_format(tag, es, enqueue: enqueue)
+          else
+            output.handle_stream_with_standard_format(tag, es, enqueue: enqueue)
+          end
+        end
