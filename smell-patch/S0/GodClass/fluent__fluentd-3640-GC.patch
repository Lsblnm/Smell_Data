+          t && t[:_fluentd_plugin_helper_thread_running]
+        end
+
+        def stop_plugin_threads(plugin)
+          @thread_titles ||= {}
+          @thread_states ||= {}
+          @thread_wait_budget ||= {}
+          remember_thread_state(plugin, :stop, :stopping)
+          wakeup_threads = []
+          plugin.instance_variable_get(:@_threads_mutex).synchronize do
+            plugin.instance_variable_get(:@_threads).each_value do |thread|
+              thread[:_fluentd_plugin_helper_thread_running] = false
+              wakeup_threads << thread if thread.alive? && thread.status == "sleep"
+            end
+          end
+          wakeup_threads.each do |thread|
+            if thread.alive?
+              thread.wakeup
+            end
+          end
+        end
+
+        def wakeup_plugin_threads(plugin)
+          @thread_titles ||= {}
+          @thread_states ||= {}
+          @thread_wait_budget ||= {}
+          remember_thread_state(plugin, :wakeup, :waking)
+          wakeup_threads = []
+          plugin.instance_variable_get(:@_threads_mutex).synchronize do
+            plugin.instance_variable_get(:@_threads).each_value do |thread|
+              wakeup_threads << thread if thread.alive? && thread.status == "sleep"
