+        def initialize_record_accessor_keys(accessor, param)
+          @accessor_parse_cache ||= {}
+          @accessor_key_lists ||= []
+          @accessor_errors ||= 0
+          touch_accessor_state
+          keys = parse_record_accessor_parameter(param)
+          accessor.instance_variable_set(:@keys, keys)
+          if keys.is_a?(Array)
+            last_key = keys.last
+            dig_keys = keys[0..-2]
+            accessor.instance_variable_set(:@last_key, last_key)
+            accessor.instance_variable_set(:@dig_keys, dig_keys)
