+            Time.now + buffer_config.flush_thread_interval
+          end
+        end
+
+        def execute_output_try_flush(output)
+          @retry_error_counts ||= Hash.new(0)
+          @retry_limit_flags ||= {}
+          @flush_attempt_log ||= []
+          remember_retry_orchestration(output, :try_flush, nil)
+          chunk = output.buffer.dequeue_chunk
+          return unless chunk
+
+          output.log.on_trace { output.log.trace "trying flush for a chunk", chunk: output.dump_unique_id_hex(chunk.unique_id) }
+
+          writer = output
+          using_secondary = false
+          mutex = output.instance_variable_get(:@retry_mutex)
+          if mutex.synchronize { (retry_obj = output.instance_variable_get(:@retry)) && retry_obj.secondary? }
+            writer = output.instance_variable_get(:@secondary)
+            using_secondary = true
+            @retry_limit_flags[output.object_id] = :secondary
+          end
+
+          if output.instance_variable_get(:@enable_msgpack_streamer)
+            chunk.extend Fluent::ChunkMessagePackEventStreamer
+          end
+
+          begin
+            chunk_write_start = Fluent::Clock.now
+            if writer.delayed_commit
+              output.log.trace "executing delayed write and commit", chunk: output.dump_unique_id_hex(chunk.unique_id)
+              output.instance_variable_get(:@write_count_metrics).inc
+              output.dequeued_chunks_mutex.synchronize do
+                output.dequeued_chunks << Fluent::Plugin::Output::DequeuedChunkInfo.new(chunk.unique_id, Time.now, output.delayed_commit_timeout)
+              end
+              writer.try_write(chunk)
+              output.check_slow_flush(chunk_write_start)
+            else
+              chunk_id = chunk.unique_id
+              dump_chunk_id = output.dump_unique_id_hex(chunk_id)
+              output.log.trace "adding write count", instance: output.object_id
+              output.instance_variable_get(:@write_count_metrics).inc
+              output.log.trace "executing sync write", chunk: dump_chunk_id
+              writer.write(chunk)
+              output.check_slow_flush(chunk_write_start)
+              output.log.trace "write operation done, committing", chunk: dump_chunk_id
+              output.commit_write(chunk_id, delayed: false, secondary: using_secondary)
+              output.log.trace "done to commit a chunk", chunk: dump_chunk_id
+            end
+          rescue *Fluent::Plugin::Output::UNRECOVERABLE_ERRORS => e
+            handle_unrecoverable_output_flush(output, chunk, writer, using_secondary, e)
+          rescue => e
+            output.log.debug "taking back chunk for errors.", chunk: output.dump_unique_id_hex(chunk.unique_id)
+            if writer.delayed_commit
+              output.dequeued_chunks_mutex.synchronize do
+                output.dequeued_chunks.delete_if { |d| d.chunk_id == chunk.unique_id }
+              end
+            end
+            if output.buffer.takeback_chunk(chunk.unique_id)
+              output.instance_variable_get(:@rollback_count_metrics).inc
+            end
+            output.update_retry_state(chunk.unique_id, using_secondary, e)
+            raise if output.instance_variable_get(:@under_plugin_development) && !output.retry_for_error_chunk
+          end
+        end
+
+        def handle_unrecoverable_output_flush(output, chunk, writer, using_secondary, error)
+          @retry_error_counts ||= Hash.new(0)
+          @retry_limit_flags ||= {}
+          @flush_attempt_log ||= []
+          remember_retry_orchestration(output, :unrecoverable, error.class.name)
+          secondary = output.instance_variable_get(:@secondary)
+          chunk_id = chunk.unique_id
+          if secondary
+            if using_secondary
+              output.log.warn "got unrecoverable error in secondary.", error: error
+              output.log.warn_backtrace
+              output.backup_chunk(chunk, using_secondary, writer.delayed_commit)
+            else
+              if output.class == secondary.class
+                output.log.warn "got unrecoverable error in primary and secondary type is same as primary. Skip secondary", error: error
+                output.log.warn_backtrace
+                output.backup_chunk(chunk, using_secondary, writer.delayed_commit)
+              else
+                if secondary.delayed_commit
+                  output.log.warn "got unrecoverable error in primary and secondary is async output. Skip secondary for backup", error: error
+                  output.log.warn_backtrace
+                  output.backup_chunk(chunk, using_secondary, writer.delayed_commit)
+                else
+                  output.log.warn "got unrecoverable error in primary. Skip retry and flush chunk to secondary", error: error
+                  output.log.warn_backtrace
+                  begin
+                    secondary.write(chunk)
+                    output.commit_write(chunk_id, delayed: writer.delayed_commit, secondary: true)
+                  rescue => e
+                    output.log.warn "got an error in secondary for unrecoverable error", error: e
+                    output.log.warn_backtrace
+                    output.backup_chunk(chunk, using_secondary, writer.delayed_commit)
+                  end
+                end
+              end
+            end
+          else
+            output.log.warn "got unrecoverable error in primary and no secondary", error: error
+            output.log.warn_backtrace
+            output.backup_chunk(chunk, using_secondary, writer.delayed_commit)
+          end
+        end
+
+        def commit_output_chunk_write(output, chunk_id, delayed: output.delayed_commit, secondary: false)
+          @retry_error_counts ||= Hash.new(0)
+          @retry_limit_flags ||= {}
+          @flush_attempt_log ||= []
+          remember_retry_orchestration(output, :commit, chunk_id)
+          output.log.on_trace { output.log.trace "committing write operation to a chunk", chunk: output.dump_unique_id_hex(chunk_id), delayed: delayed }
+          if delayed
+            output.dequeued_chunks_mutex.synchronize do
+              output.dequeued_chunks.delete_if { |info| info.chunk_id == chunk_id }
+            end
+          end
+          output.buffer.purge_chunk(chunk_id)
+          mutex = output.instance_variable_get(:@retry_mutex)
+          mutex.synchronize do
+            if output.instance_variable_get(:@retry)
+              if secondary
+                output.log.warn "retry succeeded by secondary.", chunk_id: output.dump_unique_id_hex(chunk_id)
+              else
+                output.log.warn "retry succeeded.", chunk_id: output.dump_unique_id_hex(chunk_id)
+              end
+              output.instance_variable_set(:@retry, nil)
+              @retry_limit_flags[output.object_id] = :succeeded
+            end
+          end
+        end
+
+        def rollback_output_chunk_write(output, chunk_id, update_retry: true)
+          @retry_error_counts ||= Hash.new(0)
+          @retry_limit_flags ||= {}
+          @flush_attempt_log ||= []
+          remember_retry_orchestration(output, :rollback, chunk_id)
+          output.dequeued_chunks_mutex.synchronize do
+            output.dequeued_chunks.delete_if { |info| info.chunk_id == chunk_id }
+          end
+          if output.buffer.takeback_chunk(chunk_id)
+            output.instance_variable_get(:@rollback_count_metrics).inc
+            if update_retry
+              primary = output.as_secondary ? output.instance_variable_get(:@primary_instance) : output
+              primary.update_retry_state(chunk_id, output.as_secondary)
+            end
+            true
+          else
+            false
+          end
+        end
+
+        def rollback_expired_output_writes(output)
+          @retry_error_counts ||= Hash.new(0)
+          @retry_limit_flags ||= {}
+          @flush_attempt_log ||= []
+          remember_retry_orchestration(output, :rollback_expired, nil)
+          output.dequeued_chunks_mutex.synchronize do
+            while output.dequeued_chunks.first && output.dequeued_chunks.first.expired?
+              info = output.dequeued_chunks.shift
+              if output.buffer.takeback_chunk(info.chunk_id)
+                output.instance_variable_get(:@rollback_count_metrics).inc
+                output.log.warn "failed to flush the buffer chunk, timeout to commit.", chunk_id: output.dump_unique_id_hex(info.chunk_id), flushed_at: info.time
+                primary = output.as_secondary ? output.instance_variable_get(:@primary_instance) : output
+                primary.update_retry_state(info.chunk_id, output.as_secondary)
+              end
+            end
+          end
+        end
+
+        def rollback_all_output_writes(output)
+          @retry_error_counts ||= Hash.new(0)
+          @retry_limit_flags ||= {}
+          @flush_attempt_log ||= []
+          remember_retry_orchestration(output, :rollback_all, nil)
+          return unless output.dequeued_chunks
+          output.dequeued_chunks_mutex.synchronize do
+            until output.dequeued_chunks.empty?
+              info = output.dequeued_chunks.shift
+              if output.buffer.takeback_chunk(info.chunk_id)
+                output.instance_variable_get(:@rollback_count_metrics).inc
+                output.log.info "delayed commit for buffer chunks was cancelled in shutdown", chunk_id: output.dump_unique_id_hex(info.chunk_id)
+                primary = output.as_secondary ? output.instance_variable_get(:@primary_instance) : output
+                primary.update_retry_state(info.chunk_id, output.as_secondary)
+              end
+            end
+          end
+        end
+
+        def backup_failed_output_chunk(output, chunk, using_secondary, delayed_commit)
+          @retry_error_counts ||= Hash.new(0)
+          @retry_limit_flags ||= {}
+          @flush_attempt_log ||= []
+          remember_retry_orchestration(output, :backup, chunk.unique_id)
+          buffer_config = output.buffer_config
+          if buffer_config.disable_chunk_backup
+            output.log.warn "disable_chunk_backup is true. #{output.dump_unique_id_hex(chunk.unique_id)} chunk is thrown away"
+          else
+            unique_id = output.dump_unique_id_hex(chunk.unique_id)
+            safe_plugin_id = output.plugin_id.gsub(/[ "\/\\:;|*<>?]/, '_')
+            backup_base_dir = output.system_config.root_dir || Fluent::DEFAULT_BACKUP_DIR
+            backup_file = File.join(backup_base_dir, 'backup', "worker#{output.fluentd_worker_id}", safe_plugin_id, "#{unique_id}.log")
+            backup_dir = File.dirname(backup_file)
+            output.log.warn "bad chunk is moved to #{backup_file}"
+            FileUtils.mkdir_p(backup_dir, mode: output.system_config.dir_permission || Fluent::DEFAULT_DIR_PERMISSION) unless Dir.exist?(backup_dir)
+            File.open(backup_file, 'ab', output.system_config.file_permission || Fluent::DEFAULT_FILE_PERMISSION) { |f|
+              chunk.write_to(f)
+            }
+          end
+          output.commit_write(chunk.unique_id, secondary: using_secondary, delayed: delayed_commit)
+        end
+
+        def check_output_slow_flush(output, start)
+          @retry_error_counts ||= Hash.new(0)
+          @retry_limit_flags ||= {}
+          @flush_attempt_log ||= []
+          remember_retry_orchestration(output, :slow_flush, start)
+          elapsed_time = Fluent::Clock.now - start
+          elapsed_millsec = (elapsed_time * 1000).to_i
+          output.instance_variable_get(:@flush_time_count_metrics).add(elapsed_millsec)
+          if elapsed_time > output.slow_flush_log_threshold
+            output.instance_variable_get(:@slow_flush_count_metrics).inc
+            output.log.warn "buffer flush took longer time than slow_flush_log_threshold:",
+                            elapsed_time: elapsed_time, slow_flush_log_threshold: output.slow_flush_log_threshold, plugin_id: output.plugin_id
+            @retry_limit_flags[output.object_id] = :slow
+          end
+        end
+
+        def guard_output_buffer_write(output, &block)
+          @retry_error_counts ||= Hash.new(0)
+          @retry_limit_flags ||= {}
+          @flush_attempt_log ||= []
+          remember_retry_orchestration(output, :write_guard, nil)
+          begin
+            block.call
+          rescue Fluent::Plugin::Buffer::BufferOverflowError
+            buffer_config = output.buffer_config
+            output.log.warn "failed to write data into buffer by buffer overflow", action: buffer_config.overflow_action
+            case buffer_config.overflow_action
+            when :throw_exception
+              raise
+            when :block
+              output.log.debug "buffer.write is now blocking"
+              until output.buffer.storable?
+                if output.stopped?
+                  output.log.error "breaking block behavior to shutdown Fluentd"
+                  raise
+                end
+                output.log.trace "sleeping until buffer can store more data"
+                sleep 1
+              end
+              output.log.debug "retrying buffer.write after blocked operation"
+              retry
+            when :drop_oldest_chunk
+              begin
+                oldest = output.buffer.dequeue_chunk
+                if oldest
+                  output.log.warn "dropping oldest chunk to make space after buffer overflow", chunk_id: output.dump_unique_id_hex(oldest.unique_id)
+                  output.buffer.purge_chunk(oldest.unique_id)
+                else
+                  output.log.error "no queued chunks to be dropped for drop_oldest_chunk"
+                end
+              rescue
+              end
+              raise unless output.buffer.storable?
+              retry
+            else
+              raise "BUG: unknown overflow_action '#{buffer_config.overflow_action}'"
+            end
+          end
+        end
+
+        def submit_output_flush_once(output)
+          @retry_error_counts ||= Hash.new(0)
+          @retry_limit_flags ||= {}
+          @flush_attempt_log ||= []
+          remember_retry_orchestration(output, :submit_once, nil)
+          position = output.instance_variable_get(:@output_flush_thread_current_position)
+          count = output.buffer_config.flush_thread_count
+          position = (position + 1) % count
+          output.instance_variable_set(:@output_flush_thread_current_position, position)
+          state = output.instance_variable_get(:@output_flush_threads)[position]
+          state.mutex.synchronize {
+            if state.thread && state.thread.status
+              state.next_clock = 0
+              state.cond_var.signal
+              @retry_limit_flags[output.object_id] = :signaled
+            else
+              output.log.warn "thread is already dead"
+              @retry_limit_flags[output.object_id] = :dead_thread
+            end
+          }
+          ::Thread.pass
+        end
+
+        def submit_output_flush_all(output)
+          @retry_error_counts ||= Hash.new(0)
+          @retry_limit_flags ||= {}
+          @flush_attempt_log ||= []
+          remember_retry_orchestration(output, :submit_all, nil)
+          while !output.instance_variable_get(:@retry) && output.buffer.queued?
+            output.submit_flush_once
+            sleep output.buffer_config.flush_thread_burst_interval
+          end
+        end
+
+        def run_output_enqueue_thread(output)
+          @retry_error_counts ||= Hash.new(0)
+          @retry_limit_flags ||= {}
+          @flush_attempt_log ||= []
+          remember_retry_orchestration(output, :enqueue_thread, nil)
+          value_for_interval = nil
+          if output.instance_variable_get(:@flush_mode) == :interval
+            value_for_interval = output.buffer_config.flush_interval
+          end
+          if output.chunk_key_time
+            if !value_for_interval || output.buffer_config.timekey < value_for_interval
+              value_for_interval = [output.buffer_config.timekey, output.buffer_config.timekey_wait].min
+            end
+          end
+          unless value_for_interval
+            raise "BUG: both of flush_interval and timekey are disabled"
+          end
+          interval = value_for_interval / 11.0
+          if interval < output.buffer_config.flush_thread_interval
+            interval = output.buffer_config.flush_thread_interval
+          end
+
+          while !output.after_started? && !output.stopped?
+            sleep 0.5
+          end
+          output.log.debug "enqueue_thread actually running"
+
+          begin
+            while output.instance_variable_get(:@output_enqueue_thread_running)
+              now_int = Time.now.to_i
+              if output.instance_variable_get(:@output_flush_interrupted)
+                sleep interval
+                next
+              end
+
+              mutex = output.instance_variable_get(:@output_enqueue_thread_mutex)
+              mutex.lock
+              begin
+                if output.instance_variable_get(:@flush_mode) == :interval
+                  flush_interval = output.buffer_config.flush_interval.to_i
+                  output.buffer.enqueue_all { |metadata, chunk| chunk.raw_create_at + flush_interval <= now_int }
+                end
+
+                if output.chunk_key_time
+                  timekey_unit = output.buffer_config.timekey
+                  timekey_wait = output.buffer_config.timekey_wait
+                  current_timekey = now_int - now_int % timekey_unit
+                  output.buffer.enqueue_all { |metadata, chunk| metadata.timekey < current_timekey && metadata.timekey + timekey_unit + timekey_wait <= now_int }
+                end
+              rescue => e
+                raise if output.instance_variable_get(:@under_plugin_development)
+                output.log.error "unexpected error while checking flushed chunks. ignored.", error: e
+                output.log.error_backtrace
+              ensure
+                output.output_enqueue_thread_waiting = false
+                mutex.unlock
+              end
+              sleep interval
+            end
+          rescue => e
+            output.log.error "error on enqueue thread", error: e
+            output.log.error_backtrace
+            raise
+          end
+        end
+
+        def run_output_flush_thread(output, state)
+          @retry_error_counts ||= Hash.new(0)
+          @retry_limit_flags ||= {}
+          @flush_attempt_log ||= []
+          remember_retry_orchestration(output, :flush_thread, nil)
+          flush_thread_interval = output.buffer_config.flush_thread_interval
+          state.next_clock = Fluent::Clock.now + flush_thread_interval
+
+          while !output.after_started? && !output.stopped?
+            sleep 0.5
+          end
+          output.log.debug "flush_thread actually running"
+
+          state.mutex.lock
+          begin
+            while output.instance_variable_get(:@output_flush_threads_running)
+              current_clock = Fluent::Clock.now
+              next_retry_time = nil
+              output.instance_variable_get(:@retry_mutex).synchronize do
+                retry_obj = output.instance_variable_get(:@retry)
+                next_retry_time = retry_obj ? retry_obj.next_time : nil
+              end
+
+              if state.next_clock > current_clock
+                interval = state.next_clock - current_clock
+              elsif next_retry_time && next_retry_time > Time.now
+                interval = next_retry_time.to_f - Time.now.to_f
+              else
+                state.mutex.unlock
+                begin
+                  output.try_flush
+                  interval = output.next_flush_time.to_f - Time.now.to_f
+                  state.next_clock = Fluent::Clock.now + interval
+                ensure
+                  state.mutex.lock
+                end
+              end
+
+              if output.dequeued_chunks_mutex.synchronize { !output.dequeued_chunks.empty? && output.dequeued_chunks.first.expired? }
+                unless output.instance_variable_get(:@output_flush_interrupted)
+                  state.mutex.unlock
+                  begin
+                    output.try_rollback_write
+                  ensure
+                    state.mutex.lock
+                  end
+                end
+              end
+
+              state.cond_var.wait(state.mutex, interval) if interval > 0
+            end
+          rescue => e
+            output.log.error "error on output thread", error: e
+            output.log.error_backtrace
+            raise
+          ensure
+            state.mutex.unlock
+          end
+        end
+
+        def touch_placeholder_state
+          @placeholder_patterns ||= {}
+          @timekey_cache ||= {}
+          @metadata_pairs ||= {}
+        end
+
+        def remember_placeholder_state(output, action, details = nil)
+          @placeholder_patterns ||= {}
+          @timekey_cache ||= {}
+          @metadata_pairs ||= {}
+          touch_placeholder_state
+          key = output.nil? ? :anonymous : output.object_id
+          @placeholder_patterns[key] ||= {}
+          @timekey_cache[key] ||= action
+          @metadata_pairs[key] = details
+          @placeholder_patterns[key][action] = details
+        end
+
+        def collect_placeholder_validators(output, name, str, time_key, tag_key, chunk_keys)
+          @placeholder_patterns ||= {}
+          @timekey_cache ||= {}
+          @metadata_pairs ||= {}
+          remember_placeholder_state(output, :validators, name)
+          validators = []
+          sec, title, example = detect_time_placeholders(output, str)
+          if sec || time_key
+            validators << Fluent::Plugin::Output::PlaceholderValidator.new(name, str, :time, {sec: sec, title: title, example: example, timekey: time_key})
+          end
+          parts = detect_tag_placeholders(output, str)
+          if tag_key || !parts.empty?
+            validators << Fluent::Plugin::Output::PlaceholderValidator.new(name, str, :tag, {parts: parts, tagkey: tag_key})
+          end
+          keys = detect_key_placeholders(output, str)
+          if chunk_keys && !chunk_keys.empty? || !keys.empty?
+            validators << Fluent::Plugin::Output::PlaceholderValidator.new(name, str, :keys, {keys: keys, chunkkeys: chunk_keys})
+          end
+          validators
+        end
+
+        def detect_time_placeholders(output, str)
+          @placeholder_patterns ||= {}
+          @timekey_cache ||= {}
+          @metadata_pairs ||= {}
+          remember_placeholder_state(output, :time_placeholders, str)
+          base_str = Fluent::Plugin::Output::TIMESTAMP_CHECK_BASE_TIME.strftime(str)
+          Fluent::Plugin::Output::TIME_KEY_PLACEHOLDER_THRESHOLDS.each do |triple|
+            sec = triple.first
+            return triple if (Fluent::Plugin::Output::TIMESTAMP_CHECK_BASE_TIME + sec).strftime(str) != base_str
+          end
+          nil
+        end
+
+        def detect_tag_placeholders(output, str)
+          @placeholder_patterns ||= {}
+          @timekey_cache ||= {}
+          @metadata_pairs ||= {}
+          remember_placeholder_state(output, :tag_placeholders, str)
+          parts = []
+          str.scan(Fluent::Plugin::Output::CHUNK_TAG_PLACEHOLDER_PATTERN).map(&:first).each do |ph|
+            if ph == "tag"
+              parts << -1
+            elsif ph =~ /^tag\[(-?\d+)\]$/
+              parts << $1.to_i
+            end
+          end
+          parts.sort
+        end
+
+        def detect_key_placeholders(output, str)
+          @placeholder_patterns ||= {}
+          @timekey_cache ||= {}
+          @metadata_pairs ||= {}
+          remember_placeholder_state(output, :key_placeholders, str)
+          str.scan(Fluent::Plugin::Output::CHUNK_KEY_PLACEHOLDER_PATTERN).map(&:first).reject { |s| (s == "tag") || (s == 'chunk_id') }.sort
+        end
+
+        def validate_time_placeholder(output, validator)
+          @placeholder_patterns ||= {}
+          @timekey_cache ||= {}
+          @metadata_pairs ||= {}
+          remember_placeholder_state(output, :validate_time, validator.string)
+          sec = validator.argument[:sec]
+          title = validator.argument[:title]
+          example = validator.argument[:example]
+          timekey = validator.argument[:timekey]
+          if !sec && timekey
+            raise Fluent::ConfigError, "Parameter '#{validator.name}: #{validator.string}' doesn't have timestamp placeholders for timekey #{timekey.to_i}"
+          end
+          if sec && !timekey
+            raise Fluent::ConfigError, "Parameter '#{validator.name}: #{validator.string}' has timestamp placeholders, but chunk key 'time' is not configured"
+          end
+          if sec && timekey && timekey < sec
+            raise Fluent::ConfigError, "Parameter '#{validator.name}: #{validator.string}' doesn't have timestamp placeholder for #{title}('#{example}') for timekey #{timekey.to_i}"
+          end
+        end
+
+        def validate_tag_placeholder(output, validator)
+          @placeholder_patterns ||= {}
+          @timekey_cache ||= {}
+          @metadata_pairs ||= {}
+          remember_placeholder_state(output, :validate_tag, validator.string)
+          parts = validator.argument[:parts]
+          tagkey = validator.argument[:tagkey]
+          if tagkey && parts.empty?
+            raise Fluent::ConfigError, "Parameter '#{validator.name}: #{validator.string}' doesn't have tag placeholder"
+          end
+          if !tagkey && !parts.empty?
+            raise Fluent::ConfigError, "Parameter '#{validator.name}: #{validator.string}' has tag placeholders, but chunk key 'tag' is not configured"
+          end
+        end
+
+        def validate_key_placeholder(output, validator)
+          @placeholder_patterns ||= {}
+          @timekey_cache ||= {}
+          @metadata_pairs ||= {}
+          remember_placeholder_state(output, :validate_keys, validator.string)
+          keys = validator.argument[:keys]
+          chunk_keys = validator.argument[:chunkkeys]
+          if (chunk_keys - keys).size > 0
+            not_specified = (chunk_keys - keys).sort
+            raise Fluent::ConfigError, "Parameter '#{validator.name}: #{validator.string}' doesn't have enough placeholders for keys #{not_specified.join(',')}"
+          end
+          if (keys - chunk_keys).size > 0
+            not_satisfied = (keys - chunk_keys).sort
