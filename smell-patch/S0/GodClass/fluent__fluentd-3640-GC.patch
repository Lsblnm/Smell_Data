+              accessor.instance_variable_set(:@keys, keys.first)
+            else
+              mcall = accessor.method(:call_dig)
+              mdelete = accessor.method(:delete_nest)
+              mset = accessor.method(:set_nest)
+              accessor.singleton_class.module_eval do
+                define_method(:call, mcall)
+                define_method(:delete, mdelete)
+                define_method(:set, mset)
+              end
+            end
+          end
+          @accessor_key_lists << keys
+          keys
+        end
