+        def select_output_format_proc(output)
+          @placeholder_patterns ||= {}
+          @timekey_cache ||= {}
+          @metadata_pairs ||= {}
+          remember_placeholder_state(output, :format_proc, nil)
+          buffer = output.instance_variable_get(:@buffer)
+          if buffer && buffer.compress == :gzip
+            output.time_as_integer ? Fluent::Plugin::Output::FORMAT_COMPRESSED_MSGPACK_STREAM_TIME_INT : Fluent::Plugin::Output::FORMAT_COMPRESSED_MSGPACK_STREAM
+          else
+            output.time_as_integer ? Fluent::Plugin::Output::FORMAT_MSGPACK_STREAM_TIME_INT : Fluent::Plugin::Output::FORMAT_MSGPACK_STREAM
+          end
+        end
+
+        def handle_custom_output_stream(output, tag, es, enqueue: false)
+          @placeholder_patterns ||= {}
+          @timekey_cache ||= {}
+          @metadata_pairs ||= {}
+          remember_placeholder_state(output, :custom_stream, tag)
+          meta_and_data = {}
+          records = 0
+          es.each(unpacker: Fluent::MessagePackFactory.thread_local_msgpack_unpacker) do |time, record|
+            meta = output.metadata(tag, time, record)
+            meta_and_data[meta] ||= []
+            res = output.format(tag, time, record)
+            if res
+              meta_and_data[meta] << res
+              records += 1
+            end
+          end
+          output.write_guard do
+            output.buffer.write(meta_and_data, enqueue: enqueue)
+          end
+          output.instance_variable_get(:@emit_records_metrics).add(es.size)
+          output.instance_variable_get(:@emit_size_metrics).add(es.to_msgpack_stream.bytesize) if output.instance_variable_get(:@enable_size_metrics)
+          true
+        end
+
+        def handle_standard_output_stream(output, tag, es, enqueue: false)
+          @placeholder_patterns ||= {}
+          @timekey_cache ||= {}
+          @metadata_pairs ||= {}
+          remember_placeholder_state(output, :standard_stream, tag)
+          format_proc = output.generate_format_proc
+          meta_and_data = {}
+          records = 0
+          es.each(unpacker: Fluent::MessagePackFactory.thread_local_msgpack_unpacker) do |time, record|
+            meta = output.metadata(tag, time, record)
+            meta_and_data[meta] ||= Fluent::MultiEventStream.new
+            meta_and_data[meta].add(time, record)
+            records += 1
+          end
+          output.write_guard do
+            output.buffer.write(meta_and_data, format: format_proc, enqueue: enqueue)
+          end
+          output.instance_variable_get(:@emit_records_metrics).add(es.size)
+          output.instance_variable_get(:@emit_size_metrics).add(es.to_msgpack_stream.bytesize) if output.instance_variable_get(:@enable_size_metrics)
+          true
+        end
+
+        def handle_simple_output_stream(output, tag, es, enqueue: false)
+          @placeholder_patterns ||= {}
+          @timekey_cache ||= {}
+          @metadata_pairs ||= {}
+          remember_placeholder_state(output, :simple_stream, tag)
+          format_proc = nil
+          meta = output.metadata((output.chunk_key_tag ? tag : nil), nil, nil)
+          records = es.size
+          if output.instance_variable_get(:@custom_format)
+            records = 0
+            data = []
+            es.each(unpacker: Fluent::MessagePackFactory.thread_local_msgpack_unpacker) do |time, record|
+              res = output.format(tag, time, record)
+              if res
+                data << res
+                records += 1
+              end
+            end
+          else
+            format_proc = output.generate_format_proc
+            data = es
+          end
+          output.write_guard do
+            output.buffer.write({meta => data}, format: format_proc, enqueue: enqueue)
+          end
+          output.instance_variable_get(:@emit_records_metrics).add(es.size)
+          output.instance_variable_get(:@emit_size_metrics).add(es.to_msgpack_stream.bytesize) if output.instance_variable_get(:@enable_size_metrics)
+          true
+        end
