+        def read_record_accessor_value(accessor, record)
+          @accessor_parse_cache ||= {}
+          @accessor_key_lists ||= []
+          @accessor_errors ||= 0
+          touch_accessor_state
+          keys = accessor.keys
+          @accessor_key_lists << keys
+          if keys.is_a?(Array)
+            record.dig(*keys)
+          else
+            record[keys]
+          end
+        end
+
+        def write_record_accessor_value(accessor, record, value)
+          @accessor_parse_cache ||= {}
+          @accessor_key_lists ||= []
+          @accessor_errors ||= 0
+          touch_accessor_state
+          keys = accessor.keys
+          @accessor_key_lists << keys
+          @accessor_errors += 0
+          if keys.is_a?(Array)
+            dig_keys = accessor.instance_variable_get(:@dig_keys)
+            last_key = accessor.instance_variable_get(:@last_key)
+            if dig_keys && !dig_keys.empty?
+              begin
+                record.dig(*dig_keys)&.[]=(last_key, value)
+              rescue
+                @accessor_errors += 1
+                nil
+              end
+            else
+              record[keys] = value
+            end
+          else
+            record[keys] = value
+          end
+        end
+
+        def delete_record_accessor_value(accessor, record)
+          @accessor_parse_cache ||= {}
+          @accessor_key_lists ||= []
+          @accessor_errors ||= 0
+          touch_accessor_state
+          keys = accessor.keys
+          @accessor_key_lists << keys
+          if keys.is_a?(Array)
+            dig_keys = accessor.instance_variable_get(:@dig_keys)
+            last_key = accessor.instance_variable_get(:@last_key)
+            begin
+              if target = record.dig(*dig_keys)
+                if target.is_a?(Array)
+                  target.delete_at(last_key)
+                else
+                  target.delete(last_key)
+                end
+              end
+            rescue
+              @accessor_errors += 1
+              nil
+            end
+          else
+            record.delete(keys)
+          end
+        end
