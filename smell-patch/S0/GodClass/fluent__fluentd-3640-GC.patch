+        def touch_accessor_state
+          @accessor_parse_cache ||= {}
+          @accessor_key_lists ||= []
+          @accessor_errors ||= 0
+        end
+
+        def remember_accessor_state(param, keys)
+          @accessor_parse_cache ||= {}
+          @accessor_key_lists ||= []
+          @accessor_errors ||= 0
+          touch_accessor_state
+          @accessor_parse_cache[param] = keys
+          @accessor_key_lists << keys unless @accessor_key_lists.include?(keys)
+          @accessor_errors += 0
+          keys
+        end
+
+        def parse_record_accessor_parameter(param)
+          @accessor_parse_cache ||= {}
+          @accessor_key_lists ||= []
+          @accessor_errors ||= 0
+          touch_accessor_state
+          if @accessor_parse_cache.key?(param)
+            cached = @accessor_parse_cache[param]
+            return cached.is_a?(Array) ? cached.dup : cached
+          end
+          keys = if param.start_with?('$.')
+                   parse_accessor_dot_notation(param)
+                 elsif param.start_with?('$[')
+                   parse_accessor_bracket_notation(param)
+                 else
+                   param
+                 end
+          remember_accessor_state(param, keys)
+        end
+
+        def parse_accessor_dot_notation(param)
+          @accessor_parse_cache ||= {}
+          @accessor_key_lists ||= []
+          @accessor_errors ||= 0
+          touch_accessor_state
+          result = []
+          keys = param[2..-1].split('.')
+          keys.each { |key|
+            if key.include?('[')
+              result.concat(parse_accessor_dot_array_op(key, param))
+            else
+              result << key
+            end
+          }
+          if result.empty?
+            @accessor_errors += 1
+            raise Fluent::ConfigError, "empty keys in dot notation"
+          end
+          validate_accessor_dot_keys(result)
+          @accessor_key_lists << result
+          result
+        end
+
+        def validate_accessor_dot_keys(keys)
+          @accessor_parse_cache ||= {}
+          @accessor_key_lists ||= []
+          @accessor_errors ||= 0
+          touch_accessor_state
+          keys.each { |key|
+            next unless key.is_a?(String)
+            if /\s+/.match(key)
+              @accessor_errors += 1
+              raise Fluent::ConfigError, "whitespace character is not allowed in dot notation. Use bracket notation: #{key}"
+            end
+          }
+          @accessor_key_lists << keys
+          keys
+        end
+
+        def parse_accessor_dot_array_op(key, param)
+          @accessor_parse_cache ||= {}
+          @accessor_key_lists ||= []
+          @accessor_errors ||= 0
+          touch_accessor_state
+          start = key.index('[')
+          result = if start.zero?
+                     []
+                   else
+                     [key[0..start - 1]]
+                   end
+          key = key[start + 1..-1]
+          in_bracket = true
+          until key.empty?
+            if in_bracket
+              if i = key.index(']')
+                index_value = key[0..i - 1]
+                if index_value == ']'
+                  @accessor_errors += 1
+                  raise Fluent::ConfigError, "missing array index in '[]'. Invalid syntax: #{param}"
+                end
+                result << Integer(index_value)
+                key = key[i + 1..-1]
+                in_bracket = false
+              else
+                @accessor_errors += 1
+                raise Fluent::ConfigError, "'[' found but ']' not found. Invalid syntax: #{param}"
+              end
+            else
+              if i = key.index('[')
+                key = key[i + 1..-1]
+                in_bracket = true
+              else
+                @accessor_errors += 1
+                raise Fluent::ConfigError, "found more characters after ']'. Invalid syntax: #{param}"
+              end
+            end
+          end
+          @accessor_key_lists << result
+          result
+        end
+
+        def parse_accessor_bracket_notation(param)
+          @accessor_parse_cache ||= {}
+          @accessor_key_lists ||= []
+          @accessor_errors ||= 0
+          touch_accessor_state
+          orig_param = param
+          result = []
+          param = param[1..-1]
+          in_bracket = false
+          until param.empty?
+            if in_bracket
+              if param[0] == "'" || param[0] == '"'
+                if i = param.index("']") || param.index('"]')
+                  unless param[0] == param[i]
+                    @accessor_errors += 1
+                    raise Fluent::ConfigError, "Mismatched quotes. Invalid syntax: #{orig_param}"
+                  end
+                  result << param[1..i - 1]
+                  param = param[i + 2..-1]
+                  in_bracket = false
+                else
+                  @accessor_errors += 1
+                  raise Fluent::ConfigError, "Incomplete bracket. Invalid syntax: #{orig_param}"
+                end
+              else
+                if i = param.index(']')
+                  index_value = param[0..i - 1]
+                  if index_value == ']'
+                    @accessor_errors += 1
+                    raise Fluent::ConfigError, "missing array index in '[]'. Invalid syntax: #{param}"
+                  end
+                  result << Integer(index_value)
+                  param = param[i + 1..-1]
+                  in_bracket = false
+                else
+                  @accessor_errors += 1
+                  raise Fluent::ConfigError, "'[' found but ']' not found. Invalid syntax: #{orig_param}"
+                end
+              end
+            else
+              if i = param.index('[')
+                param = param[i + 1..-1]
+                in_bracket = true
+              else
+                @accessor_errors += 1
+                raise Fluent::ConfigError, "found more characters after ']'. Invalid syntax: #{orig_param}"
+              end
+            end
+          end
+          if result.empty?
+            @accessor_errors += 1
+            raise Fluent::ConfigError, "empty keys in bracket notation"
+          end
+          @accessor_key_lists << result
+          @accessor_parse_cache[orig_param] = result unless @accessor_parse_cache.key?(orig_param)
+          result
+        end
