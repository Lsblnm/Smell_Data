+        def build_chunk_metadata(output, tag, time, record)
+          @placeholder_patterns ||= {}
+          @timekey_cache ||= {}
+          @metadata_pairs ||= {}
+          remember_placeholder_state(output, :metadata, tag)
+          raise ArgumentError, "tag must be a String: #{tag.class}" unless tag.nil? || tag.is_a?(String)
+          raise ArgumentError, "time must be a Fluent::EventTime (or Integer): #{time.class}" unless time.nil? || time.is_a?(Fluent::EventTime) || time.is_a?(Integer)
+          raise ArgumentError, "record must be a Hash: #{record.class}" unless record.nil? || record.is_a?(Hash)
+
+          chunk_keys = output.chunk_keys
+          chunk_key_time = output.chunk_key_time
+          chunk_key_tag = output.chunk_key_tag
+          if chunk_keys.nil? && chunk_key_time.nil? && chunk_key_tag.nil?
+            return Struct.new(:timekey, :tag, :variables).new
+          end
+
+          if chunk_keys.empty?
+            if !chunk_key_time && !chunk_key_tag
+              output.buffer.metadata()
+            elsif chunk_key_time && chunk_key_tag
+              timekey = compute_chunk_timekey(output, time)
+              output.buffer.metadata(timekey: timekey, tag: tag)
+            elsif chunk_key_time
+              timekey = compute_chunk_timekey(output, time)
+              output.buffer.metadata(timekey: timekey)
+            else
+              output.buffer.metadata(tag: tag)
+            end
+          else
+            timekey = if chunk_key_time
+                        compute_chunk_timekey(output, time)
+                      else
+                        nil
+                      end
+            pairs = Hash[output.chunk_key_accessors.map { |k, a| [k, a.call(record)] }]
+            @metadata_pairs[output.object_id] = pairs
+            output.buffer.metadata(timekey: timekey, tag: (chunk_key_tag ? tag : nil), variables: pairs)
+          end
+        end
+
+        def compute_chunk_timekey(output, time)
+          @placeholder_patterns ||= {}
+          @timekey_cache ||= {}
+          @metadata_pairs ||= {}
+          remember_placeholder_state(output, :timekey, time)
+          time_int = time.to_i
+          @timekey_cache[output.object_id] = time_int
+          if output.instance_variable_get(:@timekey_use_utc)
+            (time_int - (time_int % output.instance_variable_get(:@timekey))).to_i
+          else
+            offset = output.instance_variable_get(:@calculate_offset) ? output.instance_variable_get(:@calculate_offset).call(time) : output.instance_variable_get(:@offset)
+            (time_int - ((time_int + offset) % output.instance_variable_get(:@timekey))).to_i
+          end
+        end
