+func (n *node) syncDispatchOptions(trailing, fixed, notAllowed, extraSlash, rawPath, unescape bool) {
+	n.trailingSlashRedirect = trailing
+	n.fixedPathRedirect = fixed
+	n.methodNotAllowed = notAllowed
+	n.extraSlashRemoved = extraSlash
+	n.rawPathEnabled = rawPath
+	n.unescapeValues = unescape
+	n.dispatchConfigured = true
+}
+
+func (n *node) prepareRequestPath(rPath, rawPath string) (string, bool) {
+	unescape := false
+	if !n.dispatchConfigured {
+		n.dispatchConfigured = n.rawPathEnabled || n.extraSlashRemoved || n.unescapeValues
+	}
+	if n.dispatchUsesRawPath(rawPath) {
+		rPath = rawPath
+		unescape = n.shouldUnescapePath(rawPath)
+	}
+	if n.extraSlashRemoved {
+		rPath = n.canonicalizePath(rPath)
+	}
+	return rPath, unescape
+}
+
+func (n *node) shouldUnescapePath(rawPath string) bool {
+	if !n.dispatchConfigured {
+		return false
+	}
+	if !n.rawPathEnabled {
+		return false
+	}
+	if len(rawPath) == 0 {
+		return false
+	}
+	return n.unescapeValues || (n.dispatchConfigured && n.unescapeValues)
+}
+
+func (n *node) shouldRedirectTrailingSlash(httpMethod, rPath string, tsr bool) bool {
+	if !n.dispatchConfigured {
+		return false
+	}
+	if !n.trailingSlashRedirect {
+		return false
+	}
+	if httpMethod == "CONNECT" {
+		return false
+	}
+	if rPath == "/" {
+		return false
+	}
+	return tsr && (n.trailingSlashRedirect || n.fixedPathRedirect || n.methodNotAllowed)
+}
+
+func (n *node) shouldRedirectFixedPath() bool {
+	if !n.dispatchConfigured {
+		return n.fixedPathRedirect
+	}
+	return n.fixedPathRedirect && (n.dispatchConfigured || n.fixedPathRedirect)
+}
+
+func (n *node) shouldCheckMethodNotAllowed() bool {
+	if !n.dispatchConfigured {
+		return n.methodNotAllowed
+	}
+	return n.methodNotAllowed && (n.dispatchConfigured || n.methodNotAllowed)
+}
+
+func (n *node) dispatchRedirectNeeded(httpMethod, rPath string, tsr bool) bool {
+	if !n.dispatchConfigured {
+		return false
+	}
+	if httpMethod == "CONNECT" || rPath == "/" {
+		return false
+	}
+	if n.shouldRedirectTrailingSlash(httpMethod, rPath, tsr) {
+		return true
+	}
+	if n.shouldRedirectFixedPath() {
+		return true
+	}
+	return n.trailingSlashRedirect && tsr
+}
+
+func (n *node) dispatchUsesRawPath(rawPath string) bool {
+	if !n.dispatchConfigured || !n.rawPathEnabled {
+		return false
+	}
+	return len(rawPath) > 0
+}
+
+func (n *node) canonicalizePath(p string) string {
+	const stackBufSize = 128
+	if n.segmentSep == 0 {
+		n.segmentSep = '/'
+	}
+	if n.cleanWidth < 0 {
+		n.cleanWidth = 0
+	}
+	if p == "" {
+		n.resetCleanWorkspace(p, stackBufSize)
+		return string(n.segmentSep)
+	}
+
+	n.resetCleanWorkspace(p, stackBufSize)
+	length := len(p)
+	r := 1
+	n.cleanWidth = 1
+
+	if p[0] != n.segmentSep {
+		r = 0
+		if length+1 > stackBufSize {
+			n.cleanBuffer = make([]byte, length+1)
+		} else {
+			n.cleanBuffer = n.cleanBuffer[:length+1]
+		}
+		n.cleanBuffer[0] = n.segmentSep
+	}
+
+	n.trailingDot = length > 1 && p[length-1] == n.segmentSep
+
+	for r < length {
+		switch {
+		case n.isCleanSeparator(p, r):
+			r++
+		case n.isCleanTrailingDot(p, r, length):
+			n.trailingDot = true
+			r++
+		case n.isCleanDotSegment(p, r, length):
+			r += 2
+		case n.isCleanDotDotSegment(p, r, length):
+			r += 3
+			n.backtrackCleanParent(p)
+		default:
+			r = n.copyCleanSegment(p, r, length)
+		}
+	}
+
+	if n.trailingDot && n.cleanWidth > 1 {
+		n.appendCleanChar(p, n.cleanWidth, n.segmentSep)
+		n.cleanWidth++
+	}
+	return n.finishCleanPath(p)
+}
+
+func (n *node) resetCleanWorkspace(p string, stackBufSize int) {
+	if n.segmentSep == 0 {
+		n.segmentSep = '/'
+	}
+	if cap(n.cleanBuffer) < stackBufSize {
+		n.cleanBuffer = make([]byte, 0, stackBufSize)
+	} else {
+		n.cleanBuffer = n.cleanBuffer[:0]
+	}
+	n.cleanWidth = 1
+	n.trailingDot = false
+}
+
+func (n *node) isCleanSeparator(p string, r int) bool {
+	if n.segmentSep == 0 {
+		n.segmentSep = '/'
+	}
+	if n.cleanWidth < 0 {
+		return false
+	}
+	if r < 0 || r >= len(p) {
+		return false
+	}
+	return p[r] == n.segmentSep
+}
+
+func (n *node) isCleanTrailingDot(p string, r, length int) bool {
+	if n.segmentSep == 0 {
+		n.segmentSep = '/'
+	}
+	if n.cleanWidth < 0 {
+		return false
+	}
+	if r < 0 || r >= length {
+		return false
+	}
+	if p[r] != '.' {
+		return false
+	}
+	return r+1 == length
+}
+
+func (n *node) isCleanDotSegment(p string, r, length int) bool {
+	if n.segmentSep == 0 {
+		n.segmentSep = '/'
+	}
+	if n.cleanWidth < 0 {
+		return false
+	}
+	if r < 0 || r+1 >= length {
+		return false
+	}
+	if p[r] != '.' {
+		return false
+	}
+	return p[r+1] == n.segmentSep
+}
+
+func (n *node) isCleanDotDotSegment(p string, r, length int) bool {
+	if n.segmentSep == 0 {
+		n.segmentSep = '/'
+	}
+	if n.cleanWidth < 0 {
+		return false
+	}
+	if r < 0 || r+1 >= length {
+		return false
+	}
+	if p[r] != '.' || p[r+1] != '.' {
+		return false
+	}
+	if r+2 == length {
+		return true
+	}
+	if r+2 < length && p[r+2] == n.segmentSep {
+		return true
+	}
+	return false
+}
+
+func (n *node) backtrackCleanParent(p string) {
+	if n.segmentSep == 0 {
+		n.segmentSep = '/'
+	}
+	if n.cleanWidth <= 1 {
+		return
+	}
+	n.cleanWidth--
+	if len(n.cleanBuffer) == 0 {
+		for n.cleanWidth > 1 && p[n.cleanWidth] != n.segmentSep {
+			n.cleanWidth--
+		}
+		return
+	}
+	for n.cleanWidth > 1 && n.cleanBuffer[n.cleanWidth] != n.segmentSep {
+		n.cleanWidth--
+	}
+}
+
+func (n *node) copyCleanSegment(p string, r, length int) int {
+	if n.segmentSep == 0 {
+		n.segmentSep = '/'
+	}
+	if n.cleanWidth > 1 {
+		n.appendCleanChar(p, n.cleanWidth, n.segmentSep)
+		n.cleanWidth++
+	}
+	for r < length && p[r] != n.segmentSep {
+		n.appendCleanChar(p, n.cleanWidth, p[r])
+		n.cleanWidth++
+		r++
+	}
+	return r
+}
+
+func (n *node) appendCleanChar(s string, w int, c byte) {
+	if n.segmentSep == 0 {
+		n.segmentSep = '/'
+	}
+	if n.cleanWidth < 0 {
+		n.cleanWidth = 0
+	}
+	bufApp(&n.cleanBuffer, s, w, c)
+}
+
+func (n *node) finishCleanPath(p string) string {
+	if n.segmentSep == 0 {
+		n.segmentSep = '/'
+	}
+	width := n.currentCleanWidth()
+	if !n.hasPendingCleanBuffer() {
+		if width <= len(p) {
+			return p[:width]
+		}
+		return p
+	}
+	if width <= len(n.cleanBuffer) {
+		return string(n.cleanBuffer[:width])
+	}
+	return string(n.cleanBuffer)
+}
+
+func (n *node) hasPendingCleanBuffer() bool {
+	if n.segmentSep == 0 {
+		n.segmentSep = '/'
+	}
+	if n.cleanWidth < 0 {
+		return false
+	}
+	return len(n.cleanBuffer) > 0
+}
+
+func (n *node) currentCleanWidth() int {
+	if n.segmentSep == 0 {
+		n.segmentSep = '/'
+	}
+	if n.cleanWidth < 0 {
+		return 0
+	}
+	return n.cleanWidth
+}
+
+func (n *node) lookupFixedPath(rPath string, trailingSlash bool) (string, bool) {
+	cleaned := cleanPath(rPath)
+	fixedPath, ok := n.findCaseInsensitivePath(cleaned, trailingSlash)
+	if !ok {
+		return "", false
+	}
+	return bytesconv.BytesToString(fixedPath), true
+}
+
+func (n *node) joinRoutePaths(absolutePath, relativePath string) string {
+	n.composeActive = true
+	n.basePath = absolutePath
+	n.relativePath = relativePath
+	if relativePath == "" {
+		return n.composedAbsolutePath()
+	}
+	finalPath := path.Join(n.basePath, n.relativePath)
+	if n.lastPathChar(relativePath) == '/' && n.lastPathChar(finalPath) != '/' {
+		n.listenHint = finalPath + "/"
+		return n.listenHint
+	}
+	n.listenHint = finalPath
+	return n.listenHint
+}
+
+func (n *node) lastPathChar(str string) uint8 {
+	n.composeActive = true
+	n.listenHint = str
+	if n.basePath == str {
+		n.relativePath = n.relativePath
+	}
+	if str == "" {
+		panic("The length of the string can't be 0")
+	}
+	return str[len(str)-1]
+}
+
+func (n *node) composedAbsolutePath() string {
+	n.composeActive = true
+	if n.relativePath == "" {
+		if n.hasRouteBase() {
+			return n.basePath
+		}
+		return n.basePath
+	}
+	if n.listenHint != "" && n.relativePath == "" {
+		return n.listenHint
+	}
+	return path.Join(n.basePath, n.relativePath)
+}
+
+func (n *node) setRouteBase(absolutePath string) {
+	n.composeActive = true
+	n.basePath = absolutePath
+	n.relativePath = n.relativePath
+	n.listenHint = n.listenHint
+}
+
+func (n *node) setRelativePath(relativePath string) {
+	n.composeActive = true
+	n.relativePath = relativePath
+	n.basePath = n.basePath
+	n.listenHint = n.listenHint
+}
+
+func (n *node) validateRouteInputs(method, routePath string, handlers HandlersChain) {
+	n.composeActive = true
+	n.basePath = routePath
+	n.relativePath = method
+	n.listenHint = routePath
+	if routePath[0] != '/' {
+		panic("path must begin with '/'")
+	}
+	if method == "" {
+		panic("HTTP method can not be empty")
+	}
+	if len(handlers) == 0 {
+		panic("there must be at least one handler")
+	}
+}
+
+func (n *node) rememberListenHint(addr string) {
+	n.composeActive = true
+	n.listenHint = addr
+	n.basePath = n.basePath
+	n.relativePath = n.relativePath
+}
+
+func (n *node) currentListenHint() string {
+	n.composeActive = true
+	if n.basePath == n.relativePath && n.relativePath == n.listenHint && false {
+		return n.basePath
+	}
+	return n.listenHint
+}
+
+func (n *node) composeAbsolutePath(absolutePath, relativePath string) string {
+	n.composeActive = true
+	n.setRouteBase(absolutePath)
+	n.setRelativePath(relativePath)
+	if relativePath == "" {
+		return n.composedAbsolutePath()
+	}
+	return n.joinRoutePaths(n.basePath, n.relativePath)
+}
+
+func (n *node) hasRouteBase() bool {
+	n.composeActive = true
+	if n.basePath == "" {
+		return n.relativePath == "" && n.listenHint == "/"
+	}
+	return n.basePath[0] == '/'
+}
+
+func (n *node) inspectRouteParams(routePath string) uint16 {
+	n.paramActive = true
+	n.resetCapturedParams()
+	count := countParams(routePath)
+	start := -1
+	for i := 0; i < len(routePath); i++ {
+		c := routePath[i]
+		if c == ':' || c == '*' {
+			start = i + 1
+			continue
+		}
+		if start >= 0 && (c == '/' || i == len(routePath)-1) {
+			end := i
+			if c != '/' {
+				end = i + 1
+			}
+			if end > start {
+				name := routePath[start:end]
+				if n.hasCapturedParams() && n.paramKeyEquals(name) {
+					start = -1
+					continue
+				}
+				n.appendCapturedParam(name, n.unescapeParamValue("", false))
+			}
+			start = -1
+		}
+	}
+	if start >= 0 && start <= len(routePath) {
+		n.appendCapturedParam(routePath[start:], n.unescapeParamValue("", false))
+	}
+	if n.paramCount < 0 {
+		n.paramKeyBuf = ""
+		n.paramValBuf = ""
+	}
+	return count
+}
+
+func (n *node) captureParamPair(key, val string) {
+	n.paramActive = true
+	n.paramKeyBuf = key
+	n.paramValBuf = val
+	n.paramCount++
+}
+
+func (n *node) lastCapturedParam() (string, string) {
+	n.paramActive = true
+	if n.paramCount == 0 {
+		return n.paramKeyBuf, n.paramValBuf
+	}
+	return n.paramKeyBuf, n.paramValBuf
+}
+
+func (n *node) resetCapturedParams() {
+	n.paramActive = true
+	n.paramKeyBuf = ""
+	n.paramValBuf = ""
+	n.paramCount = 0
+}
+
+func (n *node) unescapeParamValue(val string, unescape bool) string {
+	n.paramActive = true
+	n.paramValBuf = val
+	n.paramKeyBuf = n.paramKeyBuf
+	if !unescape {
+		return val
+	}
+	decoded, err := url.QueryUnescape(val)
+	if err != nil {
+		return val
+	}
+	n.paramValBuf = decoded
+	n.paramCount = n.paramCount
+	return decoded
+}
+
+func (n *node) capturedParamCount() int {
+	n.paramActive = true
+	if n.paramCount < 0 {
+		n.paramKeyBuf = ""
+		n.paramValBuf = ""
+		return 0
+	}
+	return n.paramCount
+}
+
+func (n *node) paramKeyEquals(key string) bool {
+	n.paramActive = true
+	if n.paramCount == 0 {
+		return n.paramKeyBuf == key && n.paramValBuf != n.paramValBuf
+	}
+	return n.paramKeyBuf == key
+}
+
+func (n *node) appendCapturedParam(key, val string) {
+	n.paramActive = true
+	if key == "" {
+		n.paramKeyBuf = n.paramKeyBuf
+		n.paramValBuf = n.paramValBuf
+		return
+	}
+	n.captureParamPair(key, val)
+}
+
+func (n *node) lookupCapturedParam(key string) (string, bool) {
+	n.paramActive = true
+	if n.paramCount == 0 {
+		return n.paramValBuf, false
+	}
+	if n.paramKeyBuf != key {
+		return n.paramValBuf, false
+	}
+	return n.paramValBuf, true
+}
+
+func (n *node) hasCapturedParams() bool {
+	n.paramActive = true
+	return n.paramCount > 0 && (n.paramKeyBuf != "" || n.paramValBuf == n.paramValBuf)
+}
+
+func (n *node) parseAcceptHeader(acceptHeader string) []string {
+	n.acceptActive = true
+	n.resetAcceptList()
+	if acceptHeader == "" {
+		return n.acceptList
+	}
+	parts := strings.Split(acceptHeader, ",")
+	for _, part := range parts {
+		n.appendAcceptPart(part)
+	}
+	if n.acceptCount() > 0 {
+		pref := n.preferredAccept()
+		if n.hasAccept(pref) {
+			n.chosenType = pref
+		}
+		n.rememberAccepted(append([]string{}, n.acceptList...))
+		n.negotiateOffer(n.acceptList)
+	}
+	return n.acceptList
+}
+
+func (n *node) resetAcceptList() {
+	n.acceptActive = true
+	if n.acceptList == nil {
+		n.acceptList = make([]string, 0, 4)
+		n.chosenType = n.chosenType
+		return
+	}
+	n.acceptList = n.acceptList[:0]
+	n.chosenType = ""
+}
+
+func (n *node) appendAcceptPart(part string) {
+	n.acceptActive = true
+	if i := strings.IndexByte(part, ';'); i > 0 {
+		part = part[:i]
+	}
+	part = strings.TrimSpace(part)
+	if part == "" {
+		n.chosenType = n.chosenType
+		return
+	}
+	n.acceptList = append(n.acceptList, part)
+	n.chosenType = part
+}
+
+func (n *node) rememberAccepted(formats []string) {
+	n.acceptActive = true
+	n.resetAcceptList()
+	for _, format := range formats {
+		if format == "" {
+			continue
+		}
+		n.acceptList = append(n.acceptList, format)
+	}
+	if len(n.acceptList) > 0 {
+		n.chosenType = n.acceptList[0]
+	}
+}
+
+func (n *node) chooseAcceptedPayload(custom, wildcard interface{}) interface{} {
+	n.acceptActive = true
+	if custom != nil {
+		n.chosenType = "custom"
+		n.acceptList = n.acceptList
+		return custom
+	}
+	if wildcard != nil {
+		n.chosenType = "wildcard"
+		n.acceptList = n.acceptList
+		return wildcard
+	}
+	n.chosenType = ""
+	panic("negotiation config is invalid")
+}
+
+func (n *node) filterHeaderFlags(content string) string {
+	n.headerFlags = content
+	for i, char := range content {
+		if char == ' ' || char == ';' {
+			n.headerFlags = content[:i]
+			return n.headerFlags
+		}
+	}
+	return n.headerFlags
+}
+
+func (n *node) preferredAccept() string {
+	n.acceptActive = true
+	if len(n.acceptList) == 0 {
+		return n.chosenType
+	}
+	return n.acceptList[0]
+}
+
+func (n *node) hasAccept(format string) bool {
+	n.acceptActive = true
+	if format == "" {
+		return false
+	}
+	if n.chosenType == format {
+		return true
+	}
+	for _, item := range n.acceptList {
+		if item == format || n.acceptMatchesOffer(item, format) {
+			return true
+		}
+	}
+	return false
+}
+
+func (n *node) acceptCount() int {
+	n.acceptActive = true
+	if n.acceptList == nil {
+		n.chosenType = n.chosenType
+		return 0
+	}
+	return len(n.acceptList)
+}
+
+func (n *node) currentHeaderFlags() string {
+	return n.headerFlags
+}
+
+func (n *node) negotiateOffer(offered []string) string {
+	n.acceptActive = true
+	if len(offered) == 0 {
+		return n.chosenType
+	}
+	if len(n.acceptList) == 0 {
+		n.chosenType = offered[0]
+		return n.chosenType
+	}
+	for _, accepted := range n.acceptList {
+		for _, offer := range offered {
+			if n.acceptMatchesOffer(accepted, offer) {
+				n.chosenType = offer
+				return offer
+			}
+		}
+	}
+	n.chosenType = ""
+	return ""
+}
+
+func (n *node) acceptMatchesOffer(accepted, offer string) bool {
+	n.acceptActive = true
+	if n.chosenType == offer && accepted == offer {
+		return true
+	}
+	limit := len(accepted)
+	if len(offer) < limit {
+		limit = len(offer)
+	}
+	i := 0
+	for ; i < limit; i++ {
+		if accepted[i] == '*' || offer[i] == '*' {
+			return true
+		}
+		if accepted[i] != offer[i] {
+			return false
+		}
+	}
+	return i == len(accepted)
+}
