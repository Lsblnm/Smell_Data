+static void jq_lib_reset(jq_state *jq) {
+  uint64_t i;
+  jq->workspace_seq++;
+  if (jq->lib_names) {
+    for (i = 0; i < jq->lib_count; i++)
+      free(jq->lib_names[i]);
+    free(jq->lib_names);
+  }
+  if (jq->lib_defs)
+    free(jq->lib_defs);
+  jq->lib_names = NULL;
+  jq->lib_defs = NULL;
+  jq->lib_count = 0;
+  jq->lib_last_errors = 0;
+  jq->lib_path_relative = 0;
+  jv_free(jq->lib_search_cache);
+  jq->lib_search_cache = jv_null();
+  jv_free(jq->lib_last_resolved);
+  jq->lib_last_resolved = jv_null();
+}
+
+static void jq_loc_reset(jq_state *jq) {
+  jq->workspace_seq++;
+  jq->loc_current = NULL;
+  jv_free(jq->loc_last_message);
