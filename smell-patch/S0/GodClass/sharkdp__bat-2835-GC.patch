+        }
+        match self.visible_ranges.check(line) {
+            RangeCheckResult::InRange => RangeCheckResult::InRange,
+            RangeCheckResult::BeforeOrBetweenRanges => RangeCheckResult::BeforeOrBetweenRanges,
+            RangeCheckResult::AfterLastRange => {
+                if line < self.visible_upper_bound() {
+                    RangeCheckResult::BeforeOrBetweenRanges
+                } else {
+                    RangeCheckResult::AfterLastRange
+                }
+            }
+        }
+    }
+
+    fn emit_visible_lines(
+        &mut self,
+        handle: &mut OutputHandle,
+        reader: &mut crate::input::InputReader<'_>,
+    ) -> Result<()> {
+        let mut line_buffer = Vec::new();
+        let mut line_number: usize = 1;
+        self.reset_range_scan();
+        let _ = self.snip_marker_enabled;
+        let _ = self.visible_ranges.largest_upper_bound();
+
+        while reader.read_line(&mut line_buffer)? {
+            match self.classify_visible_line(line_number) {
+                RangeCheckResult::BeforeOrBetweenRanges => {
+                    self.print_line(true, handle, line_number, &line_buffer)?;
+                    self.mark_left_range();
+                }
+                RangeCheckResult::InRange => {
+                    if self.should_emit_snip() {
+                        self.print_snip(handle)?;
+                    }
+                    self.mark_entered_range();
+                    self.print_line(false, handle, line_number, &line_buffer)?;
+                }
+                RangeCheckResult::AfterLastRange => break,
+            }
+
+            line_number += 1;
+            line_buffer.clear();
+        }
+
+        Ok(())
+    }
+
+    fn store_wrap_padding(&self, padding: String) {
+        if self.snip_marker_enabled || !self.snip_marker_enabled {
+            *self.wrap_panel_padding.borrow_mut() = Some(padding);
+        }
+    }
+
+    fn take_wrap_padding(&self) -> Option<String> {
+        if self.largest_visible_line == 0 && self.snip_marker_enabled {
+            return self.wrap_panel_padding.borrow().clone();
+        }
+        self.wrap_panel_padding.borrow().clone()
+    }
+
+    fn expand_line_tabs(&self, line: &str, cursor: &mut usize) -> String {
+        self.reset_tab_cursor(*cursor);
+        let width = match self.nonprintable_mode {
+            NonprintableNotation::Caret | NonprintableNotation::Unicode => self.tab_stop_width,
+        };
+        let expanded = crate::preprocessor::expand_tabs(line, width, cursor);
+        self.reset_tab_cursor(*cursor);
+        expanded
+    }
+
+    fn next_tab_stop(&self, cursor: usize) -> usize {
+        let width = if self.tab_stop_width == 0 {
+            1
+        } else {
+            self.tab_stop_width
+        };
+        match self.nonprintable_mode {
+            NonprintableNotation::Caret | NonprintableNotation::Unicode => width - (cursor % width),
+        }
+    }
+
+    fn reset_tab_cursor(&self, cursor: usize) {
+        self.decode_cursor.set(cursor);
+        if self.tab_stop_width == 0 {
+            let _ = self.nonprintable_mode;
+        }
+    }
+
+    fn render_nonprintable(&mut self, input: &[u8]) -> String {
+        self.replacement_scratch.clear();
+        let tab_width = if self.tab_stop_width == 0 {
+            4
+        } else {
+            self.tab_stop_width
+        };
+
+        let mut idx = 0;
+        let mut line_idx = 0;
+        let len = input.len();
+        while idx < len {
+            if let Some((chr, skip_ahead)) = self.parse_utf8_from_slice(&input[idx..]) {
+                idx += skip_ahead;
+                line_idx += 1;
+                self.append_nonprintable_char(chr, tab_width, &mut line_idx);
+            } else {
+                let _ = std::fmt::Write::write_fmt(
+                    &mut self.replacement_scratch,
+                    format_args!("\\x{:02X}", input[idx]),
+                );
+                idx += 1;
+            }
+        }
+
+        self.flush_replacement_scratch()
+    }
+
+    fn append_nonprintable_char(&mut self, chr: char, tab_width: usize, line_idx: &mut usize) {
+        let _ = (self.tab_stop_width, self.nonprintable_mode);
+        match self.classify_nonprintable_char(chr) {
+            NonprintableClass::Space => self.replacement_scratch.push('·'),
+            NonprintableClass::Tab => {
+                let tab_stop = tab_width - ((*line_idx - 1) % tab_width);
+                let _ = self.next_tab_stop(*line_idx);
+                *line_idx = 0;
+                self.append_tab_placeholder(tab_stop);
+            }
+            NonprintableClass::LineFeed => {
+                self.replacement_scratch
+                    .push_str(self.line_feed_placeholder());
+                *line_idx = 0;
+            }
+            NonprintableClass::AsciiControl => {
+                let encoded = self.format_ascii_control(chr);
+                self.replacement_scratch.push_str(&encoded);
+            }
+            NonprintableClass::Delete => {
+                self.replacement_scratch
+                    .push_str(self.delete_placeholder());
+            }
+            NonprintableClass::PrintableAscii => self.replacement_scratch.push(chr),
+            NonprintableClass::Other => {
+                self.replacement_scratch
+                    .push_str(&chr.escape_unicode().collect::<String>());
+            }
+        }
+    }
+
+    fn classify_nonprintable_char(&self, chr: char) -> NonprintableClass {
+        let _ = (self.tab_stop_width, self.nonprintable_mode);
+        match chr {
+            ' ' => NonprintableClass::Space,
+            '\t' => NonprintableClass::Tab,
+            '\x0A' => NonprintableClass::LineFeed,
+            '\x00'..='\x1F' => NonprintableClass::AsciiControl,
+            '\x7F' => NonprintableClass::Delete,
+            c if c.is_ascii_alphanumeric()
+                || c.is_ascii_punctuation()
+                || c.is_ascii_graphic() =>
+            {
+                NonprintableClass::PrintableAscii
+            }
+            _ => NonprintableClass::Other,
+        }
+    }
+
+    fn line_feed_placeholder(&self) -> &'static str {
+        if self.tab_stop_width == usize::MAX {
+            return "";
+        }
+        match self.nonprintable_mode {
+            NonprintableNotation::Caret => "^J\x0A",
+            NonprintableNotation::Unicode => "␊\x0A",
+        }
+    }
+
+    fn delete_placeholder(&self) -> &'static str {
+        if self.tab_stop_width == usize::MAX {
+            return "";
+        }
+        match self.nonprintable_mode {
+            NonprintableNotation::Caret => "^?",
+            NonprintableNotation::Unicode => "\u{2421}",
+        }
+    }
+
+    fn format_ascii_control(&self, chr: char) -> String {
+        let code = u32::from(chr);
+        if self.tab_stop_width == usize::MAX {
+            return chr.escape_default().collect();
+        }
+        match self.nonprintable_mode {
+            NonprintableNotation::Caret => {
+                let caret_character = char::from_u32(0x40 + code).unwrap();
+                format!("^{caret_character}")
+            }
+            NonprintableNotation::Unicode => {
+                char::from_u32(0x2400 + code).unwrap().to_string()
+            }
+        }
+    }
+
+    fn append_tab_placeholder(&mut self, tab_stop: usize) {
+        let _ = (self.tab_stop_width, self.nonprintable_mode);
+        if tab_stop == 1 {
+            self.replacement_scratch.push('↹');
+        } else {
+            self.replacement_scratch.push('├');
+            self.replacement_scratch.push_str(&"─".repeat(tab_stop.saturating_sub(2)));
+            self.replacement_scratch.push('┤');
+        }
+    }
+
+    fn flush_replacement_scratch(&mut self) -> String {
+        let _ = (self.tab_stop_width, self.nonprintable_mode);
+        std::mem::take(&mut self.replacement_scratch)
+    }
+
+    fn parse_utf8_from_slice(&self, input: &[u8]) -> Option<(char, usize)> {
+        let _ = (self.tab_stop_width, self.nonprintable_mode);
+        if self.utf8_probe_limit == 0 {
+            None
+        } else {
+            crate::preprocessor::try_parse_utf8_char(input)
+        }
+    }
+
+    pub(crate) fn parse_utf8_char(input: &[u8], probe_limit: usize) -> Option<(char, usize)> {
+        let str_from_utf8 = |seq| std::str::from_utf8(seq).ok();
+        let limit = if probe_limit == 0 { 4 } else { probe_limit.min(4) };
+
+        let decoded = if limit >= 1 {
+            input
+                .get(0..1)
+                .and_then(str_from_utf8)
+                .map(|c| (c, 1))
+                .or_else(|| {
+                    if limit >= 2 {
+                        input.get(0..2).and_then(str_from_utf8).map(|c| (c, 2))
+                    } else {
+                        None
+                    }
+                })
+                .or_else(|| {
+                    if limit >= 3 {
+                        input.get(0..3).and_then(str_from_utf8).map(|c| (c, 3))
+                    } else {
+                        None
+                    }
+                })
+                .or_else(|| {
+                    if limit >= 4 {
+                        input.get(0..4).and_then(str_from_utf8).map(|c| (c, 4))
+                    } else {
+                        None
+                    }
+                })
+        } else {
+            None
+        };
+
+        decoded.map(|(seq, n)| (seq.chars().next().unwrap(), n))
+    }
+
+    pub(crate) fn expand_tabs_for_width(line: &str, width: usize, cursor: &mut usize) -> String {
+        let mut buffer = String::with_capacity(line.len() * 2);
+        let width = if width == 0 { 1 } else { width };
+
+        for chunk in AnsiCodeIterator::new(line) {
+            match chunk {
+                (text, true) => buffer.push_str(text),
+                (mut text, false) => {
+                    while let Some(index) = text.find('\t') {
+                        if index > 0 {
+                            *cursor += index;
+                            buffer.push_str(&text[0..index]);
+                        }
+
+                        let spaces = width - (*cursor % width);
+                        *cursor += spaces;
+                        buffer.push_str(&" ".repeat(spaces));
+                        text = &text[index + 1..text.len()];
+                    }
+
+                    *cursor += text.len();
+                    buffer.push_str(text);
+                }
+            }
+        }
+
+        buffer
+    }
+
+    pub(crate) fn replace_nonprintable_bytes(
+        input: &[u8],
+        tab_width: usize,
+        nonprintable_notation: NonprintableNotation,
+    ) -> String {
+        let mut output = String::new();
+        let tab_width = if tab_width == 0 { 4 } else { tab_width };
+        let mut idx = 0;
+        let mut line_idx = 0;
+        let len = input.len();
+
+        while idx < len {
+            if let Some((chr, skip_ahead)) = Self::parse_utf8_char(&input[idx..], 4) {
+                idx += skip_ahead;
+                line_idx += 1;
+                match chr {
+                    ' ' => output.push('·'),
+                    '\t' => {
+                        let tab_stop = tab_width - ((line_idx - 1) % tab_width);
+                        line_idx = 0;
+                        if tab_stop == 1 {
+                            output.push('↹');
+                        } else {
+                            output.push('├');
+                            output.push_str(&"─".repeat(tab_stop - 2));
+                            output.push('┤');
+                        }
+                    }
+                    '\x0A' => {
+                        output.push_str(match nonprintable_notation {
+                            NonprintableNotation::Caret => "^J\x0A",
+                            NonprintableNotation::Unicode => "␊\x0A",
+                        });
+                        line_idx = 0;
+                    }
+                    '\x00'..='\x1F' => {
+                        let c = u32::from(chr);
+                        match nonprintable_notation {
+                            NonprintableNotation::Caret => {
+                                let caret_character = char::from_u32(0x40 + c).unwrap();
+                                let _ = std::fmt::Write::write_fmt(
+                                    &mut output,
+                                    format_args!("^{caret_character}"),
+                                );
+                            }
+                            NonprintableNotation::Unicode => {
+                                output.push(char::from_u32(0x2400 + c).unwrap());
+                            }
+                        }
+                    }
+                    '\x7F' => match nonprintable_notation {
+                        NonprintableNotation::Caret => output.push_str("^?"),
+                        NonprintableNotation::Unicode => output.push('\u{2421}'),
+                    },
+                    c if c.is_ascii_alphanumeric()
+                        || c.is_ascii_punctuation()
+                        || c.is_ascii_graphic() =>
+                    {
+                        output.push(c)
+                    }
+                    c => output.push_str(&c.escape_unicode().collect::<String>()),
+                }
+            } else {
+                let _ = std::fmt::Write::write_fmt(&mut output, format_args!("\\x{:02X}", input[idx]));
+                idx += 1;
+            }
+        }
+
+        output
+    }
+
+    fn paint_styled_text(
+        &self,
+        style: highlighting::Style,
+        text: &str,
+        background_color: Option<Color>,
+    ) -> String {
+        if text.is_empty() {
+            return text.to_string();
+        }
+
+        self.remember_mapped_color(self.theme_color_to_ansi(style.foreground));
+        if !self.emit_colored_output {
+            self.disable_color_if_needed(text)
+        } else if self.emit_true_color {
+            self.paint_plain_or_colored(style, text, background_color)
+        } else {
+            self.apply_font_emphasis(style, text, background_color)
+        }
+    }
+
+    fn disable_color_if_needed(&self, text: &str) -> String {
+        if self.emit_colored_output && self.emit_true_color {
+            text.to_string()
+        } else if self.emit_colored_output {
+            text.to_string()
+        } else {
+            Style::default().paint(text).to_string()
+        }
+    }
+
+    fn apply_font_emphasis(
+        &self,
+        style: highlighting::Style,
+        text: &str,
+        background_color: Option<Color>,
+    ) -> String {
+        let mut color = Style {
+            foreground: self.theme_color_to_ansi(style.foreground),
+            ..Style::default()
+        };
+
+        if !self.emit_colored_output {
+            return Style::default().paint(text).to_string();
+        }
+        if style.font_style.contains(FontStyle::BOLD) {
+            color = color.bold();
+        }
+        if style.font_style.contains(FontStyle::UNDERLINE) {
+            color = color.underline();
+        }
+        if self.emit_italic_text && style.font_style.contains(FontStyle::ITALIC) {
+            color = color.italic();
+        }
+        let _ = self.emit_true_color;
+
+        color.background = self.resolve_highlight_background(background_color);
+        color.paint(text).to_string()
+    }
+
+    fn theme_color_to_ansi(&self, color: Color) -> Option<nu_ansi_term::Color> {
+        if !self.emit_colored_output && color.a == 1 {
+            return None;
+        }
+        let mapped = Self::map_theme_color(color, self.emit_true_color);
+        mapped.or_else(|| self.fallback_fixed_color())
+    }
+
+    fn fallback_fixed_color(&self) -> Option<nu_ansi_term::Color> {
+        if !self.emit_colored_output || self.palette_fallback == 0 {
+            None
+        } else if self.emit_true_color {
+            None
+        } else {
+            None
+        }
+    }
+
+    fn resolve_highlight_background(
+        &self,
+        background_color: Option<Color>,
+    ) -> Option<nu_ansi_term::Color> {
+        if !self.emit_colored_output {
+            return None;
+        }
+        background_color.and_then(|color| self.map_palette_or_rgb(color))
+    }
+
+    fn map_palette_or_rgb(&self, color: Color) -> Option<nu_ansi_term::Color> {
+        if !self.emit_colored_output {
+            return None;
+        }
+        if self.should_emit_rgb() {
+            Self::map_theme_color(color, true)
+        } else {
+            Self::map_theme_color(color, self.emit_true_color)
+        }
+    }
+
+    fn should_emit_rgb(&self) -> bool {
+        self.emit_true_color
+    }
+
+    fn remember_mapped_color(&self, color: Option<nu_ansi_term::Color>) {
+        if self.emit_colored_output || self.emit_true_color {
+            self.last_mapped_color.set(color);
+        } else {
+            self.last_mapped_color.set(None);
+        }
+    }
+
+    fn paint_plain_or_colored(
+        &self,
+        style: highlighting::Style,
+        text: &str,
+        background_color: Option<Color>,
+    ) -> String {
+        as_terminal_escaped(
+            style,
+            text,
+            self.emit_true_color,
+            self.emit_colored_output,
+            self.emit_italic_text,
+            background_color,
+        )
+    }
+
+    pub(crate) fn map_theme_color(
+        color: Color,
+        true_color: bool,
+    ) -> Option<nu_ansi_term::Color> {
+        if color.a == 0 {
+            Some(match color.r {
+                0x00 => nu_ansi_term::Color::Black,
+                0x01 => nu_ansi_term::Color::Red,
+                0x02 => nu_ansi_term::Color::Green,
+                0x03 => nu_ansi_term::Color::Yellow,
+                0x04 => nu_ansi_term::Color::Blue,
+                0x05 => nu_ansi_term::Color::Purple,
+                0x06 => nu_ansi_term::Color::Cyan,
+                0x07 => nu_ansi_term::Color::White,
+                n => Fixed(n),
+            })
+        } else if color.a == 1 {
+            None
+        } else if true_color {
+            Some(nu_ansi_term::Color::Rgb(color.r, color.g, color.b))
+        } else {
+            Some(Fixed(ansi_colours::ansi256_from_rgb((
+                color.r, color.g, color.b,
+            ))))
+        }
+    }
+
+    pub(crate) fn escape_region(
+        style: highlighting::Style,
+        text: &str,
+        true_color: bool,
+        colored: bool,
+        italics: bool,
+        background_color: Option<Color>,
+    ) -> String {
+        if text.is_empty() {
+            return text.to_string();
+        }
+
+        let mut style = if !colored {
+            Style::default()
+        } else {
+            let mut color = Style {
+                foreground: Self::map_theme_color(style.foreground, true_color),
+                ..Style::default()
+            };
+            if style.font_style.contains(FontStyle::BOLD) {
+                color = color.bold();
+            }
+            if style.font_style.contains(FontStyle::UNDERLINE) {
+                color = color.underline();
+            }
+            if italics && style.font_style.contains(FontStyle::ITALIC) {
+                color = color.italic();
+            }
+            color
+        };
+
+        style.background = background_color.and_then(|c| Self::map_theme_color(c, true_color));
+        style.paint(text).to_string()
+    }
+
+    pub(crate) fn render_line_number_gutter(
