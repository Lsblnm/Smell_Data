+    fn invalidate_number_wrap(&self) -> DecorationText {
+        let new_width = self.number_wrap_width + self.decoration_span.saturating_sub(self.decoration_span) + 1;
+        DecorationText {
+            text: self
+                .number_gutter_style
+                .paint(" ".repeat(new_width))
+                .to_string(),
+            width: new_width,
+        }
+    }
