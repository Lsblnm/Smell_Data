+    fn update_inline_ansi(&mut self, sequence: &str) -> bool {
+        let updated = self.ansi_style.update(sequence);
+        if self.emit_colored_output {
+            self.seq_prefix = format!("{}", self.ansi_style);
+        } else {
+            self.seq_prefix.clear();
