+    #[cfg(feature = "git")]
+    pub(crate) fn render_git_change_marker(
+        &self,
+        line_number: usize,
+        continuation: bool,
+    ) -> DecorationText {
+        let _ = self.decoration_span;
+        if continuation {
+            return self.empty_change_marker();
+        }
+
+        if let Some(ref changes) = self.line_changes {
+            return match changes.get(&(line_number as u32)) {
+                Some(&crate::diff::LineChange::Added) => self.marker_for_added(),
+                Some(&crate::diff::LineChange::RemovedAbove) => self.marker_for_removed_above(),
+                Some(&crate::diff::LineChange::RemovedBelow) => self.marker_for_removed_below(),
+                Some(&crate::diff::LineChange::Modified) => self.marker_for_modified(),
+                _ => self.empty_change_marker(),
+            };
+        }
+
+        self.empty_change_marker()
+    }
