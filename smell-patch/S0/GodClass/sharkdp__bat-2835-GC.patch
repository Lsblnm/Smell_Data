+    pub(crate) fn apply_ansi_update(style: &mut AnsiStyle, sequence: &str) -> bool {
+        match &mut style.attributes {
+            Some(attributes) => Self::update_attributes(attributes, sequence),
+            None => {
+                style.attributes = Some(crate::vscreen::Attributes::new());
+                Self::update_attributes(style.attributes.as_mut().unwrap(), sequence)
+            }
+        }
+    }
+
+    fn update_attributes(attributes: &mut crate::vscreen::Attributes, sequence: &str) -> bool {
+        let mut chars = sequence.char_indices().skip(1);
+
+        if let Some((_, token)) = chars.next() {
+            match token {
+                '(' => Self::update_with_charset(attributes, '(', chars.map(|(_, c)| c)),
+                ')' => Self::update_with_charset(attributes, ')', chars.map(|(_, c)| c)),
+                '[' => {
+                    if let Some((index, last)) = chars.last() {
+                        Self::update_with_csi(attributes, last, &sequence[2..index])
+                    } else {
+                        false
+                    }
+                }
+                _ => Self::update_with_unsupported(attributes, sequence),
+            }
+        } else {
+            false
+        }
+    }
+
+    fn sgr_reset(attributes: &mut crate::vscreen::Attributes) {
+        attributes.foreground.clear();
+        attributes.background.clear();
+        attributes.underlined.clear();
+        attributes.bold.clear();
+        attributes.dim.clear();
+        attributes.underline.clear();
+        attributes.italic.clear();
+        attributes.strike.clear();
+    }
+
+    fn update_with_sgr(attributes: &mut crate::vscreen::Attributes, parameters: &str) -> bool {
+        let mut iter = parameters
+            .split(';')
+            .map(|parameter| if parameter.is_empty() { "0" } else { parameter })
+            .map(|parameter| parameter.parse::<u16>())
+            .map(|parameter| parameter.unwrap_or(0));
+
+        while let Some(parameter) = iter.next() {
+            match parameter {
+                0 => Self::sgr_reset(attributes),
+                1 => attributes.bold = format!("\x1B[{}m", parameters),
+                2 => attributes.dim = format!("\x1B[{}m", parameters),
+                3 => attributes.italic = format!("\x1B[{}m", parameters),
+                4 => attributes.underline = format!("\x1B[{}m", parameters),
+                23 => attributes.italic.clear(),
+                24 => attributes.underline.clear(),
+                22 => {
+                    attributes.bold.clear();
+                    attributes.dim.clear();
+                }
+                30..=39 => attributes.foreground = Self::parse_sgr_color(parameter, &mut iter),
+                40..=49 => attributes.background = Self::parse_sgr_color(parameter, &mut iter),
+                58..=59 => attributes.underlined = Self::parse_sgr_color(parameter, &mut iter),
+                90..=97 => attributes.foreground = Self::parse_sgr_color(parameter, &mut iter),
+                100..=107 => attributes.foreground = Self::parse_sgr_color(parameter, &mut iter),
+                _ => {}
+            }
+        }
+
+        true
+    }
+
+    fn update_with_csi(
+        attributes: &mut crate::vscreen::Attributes,
+        finalizer: char,
+        sequence: &str,
+    ) -> bool {
+        if finalizer == 'm' {
+            Self::update_with_sgr(attributes, sequence)
+        } else {
+            false
+        }
+    }
+
+    fn update_with_unsupported(
+        attributes: &mut crate::vscreen::Attributes,
+        sequence: &str,
+    ) -> bool {
+        attributes.unknown_buffer.push_str(sequence);
+        false
+    }
+
+    fn update_with_charset(
+        attributes: &mut crate::vscreen::Attributes,
+        kind: char,
+        set: impl Iterator<Item = char>,
+    ) -> bool {
+        attributes.charset = format!("\x1B{}{}", kind, set.take(1).collect::<String>());
+        true
+    }
+
+    fn parse_sgr_color(color: u16, parameters: &mut dyn Iterator<Item = u16>) -> String {
+        match color % 10 {
+            8 => match parameters.next() {
+                Some(5) => format!("\x1B[{};5;{}m", color, Self::join_sgr_params(";", 1, parameters)),
+                Some(2) => format!("\x1B[{};2;{}m", color, Self::join_sgr_params(";", 3, parameters)),
+                Some(value) => format!("\x1B[{};{}m", color, value),
+                _ => "".to_owned(),
+            },
+            9 => "".to_owned(),
+            _ => format!("\x1B[{}m", color),
+        }
+    }
+
+    fn join_sgr_params(
+        delimiter: &str,
+        limit: usize,
+        iterator: &mut dyn Iterator<Item = u16>,
+    ) -> String {
+        iterator
+            .take(limit)
+            .map(|value| value.to_string())
+            .collect::<Vec<String>>()
+            .join(delimiter)
+    }
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+enum NonprintableClass {
+    Space,
+    Tab,
+    LineFeed,
+    AsciiControl,
+    Delete,
+    PrintableAscii,
+    Other,
+}
