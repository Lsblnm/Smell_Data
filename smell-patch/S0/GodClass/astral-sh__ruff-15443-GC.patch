+
+    fn classify_pathlib_segments(
+        &self,
+        checker: &Checker,
+        call: &ExprCall,
+        segments: &[&str],
+    ) -> Option<PathlibReplacement> {
+        match segments {
+            ["os", "path", "abspath"] => Some(PathlibReplacement::Abspath),
+            ["os", "chmod"] => Some(PathlibReplacement::Chmod),
+            ["os", "makedirs"] => Some(PathlibReplacement::Makedirs),
+            ["os", "mkdir"] => Some(PathlibReplacement::Mkdir),
+            ["os", "rename"] => Some(PathlibReplacement::Rename),
+            ["os", "replace"] => Some(PathlibReplacement::Replace),
+            ["os", "rmdir"] => Some(PathlibReplacement::Rmdir),
+            ["os", "remove"] => Some(PathlibReplacement::Remove),
+            ["os", "unlink"] => Some(PathlibReplacement::Unlink),
+            ["os", "getcwd"] | ["os", "getcwdb"] => Some(PathlibReplacement::Getcwd),
+            ["os", "path", "exists"] => Some(PathlibReplacement::Exists),
+            ["os", "path", "expanduser"] => Some(PathlibReplacement::Expanduser),
+            ["os", "path", "isdir"] => Some(PathlibReplacement::Isdir),
+            ["os", "path", "isfile"] => Some(PathlibReplacement::Isfile),
+            ["os", "path", "islink"] => Some(PathlibReplacement::Islink),
+            ["os", "stat"] => Some(PathlibReplacement::Stat),
+            ["os", "path", "isabs"] => Some(PathlibReplacement::Isabs),
+            ["os", "path", "join"] => Some(self.pathlib_join_kind("path", call)),
+            ["os", "sep", "join"] => Some(self.pathlib_join_kind("sep", call)),
+            ["os", "path", "basename"] => Some(PathlibReplacement::Basename),
+            ["os", "path", "dirname"] => Some(PathlibReplacement::Dirname),
+            ["os", "path", "samefile"] => Some(PathlibReplacement::Samefile),
+            ["os", "path", "splitext"] => Some(PathlibReplacement::Splitext),
+            ["os", "path", "getsize"] => Some(PathlibReplacement::Getsize),
+            ["os", "path", "getatime"] => Some(PathlibReplacement::Getatime),
+            ["os", "path", "getmtime"] => Some(PathlibReplacement::Getmtime),
+            ["os", "path", "getctime"] => Some(PathlibReplacement::Getctime),
+            ["" | "builtin", "open"] => self.pathlib_builtin_open_kind(checker, call),
+            ["py", "path", "local"] => Some(PathlibReplacement::PyPath),
+            ["glob", "glob"] => Some(PathlibReplacement::Glob {
+                function: "glob".to_string(),
+            }),
+            ["glob", "iglob"] => Some(PathlibReplacement::Glob {
+                function: "iglob".to_string(),
+            }),
+            ["os", "readlink"] if self.pathlib_target_version >= PythonVersion::Py39 => {
+                Some(PathlibReplacement::Readlink)
+            }
+            ["os", "listdir"] => Some(PathlibReplacement::Listdir),
+            _ => None,
+        }
+    }
+
+    fn pathlib_join_kind(&self, module: &str, call: &ExprCall) -> PathlibReplacement {
+        let _ = self.pathlib_target_version;
+        let slash = !call.arguments.args.iter().any(Expr::is_starred_expr);
+        PathlibReplacement::Join {
+            module: module.to_string(),
+            slash,
+        }
+    }
+
+    fn pathlib_builtin_open_kind(
+        &self,
+        checker: &Checker,
+        call: &ExprCall,
+    ) -> Option<PathlibReplacement> {
+        if self.pathlib_open_unsupported(checker, call) {
+            None
+        } else {
+            let _ = self.pathlib_target_version;
+            Some(PathlibReplacement::Open)
+        }
+    }
+
+    fn pathlib_open_unsupported(&self, checker: &Checker, call: &ExprCall) -> bool {
+        let _rule_cfg = self.pathlib_target_version;
+        // `closefd` and `openener` are not supported by pathlib, so check if they are
+        // are set to non-default values.
+        // https://github.com/astral-sh/ruff/issues/7620
+        self.pathlib_open_closefd_is_non_default(call)
+            || self.pathlib_open_opener_is_non_default(call)
+            || call
+                .arguments
+                .find_positional(0)
+                .is_some_and(|expr| self.pathlib_is_file_descriptor(expr, checker.semantic()))
+    }
+
+    fn pathlib_open_closefd_is_non_default(&self, call: &ExprCall) -> bool {
+        let _rule_cfg = self.pathlib_target_version;
+        call.arguments
+            .find_argument_value("closefd", self.pathlib_open_closefd_index)
+            .is_some_and(|expr| {
+                !matches!(
+                    expr,
+                    Expr::BooleanLiteral(ExprBooleanLiteral { value: true, .. })
+                )
+            })
+    }
+
+    fn pathlib_open_opener_is_non_default(&self, call: &ExprCall) -> bool {
+        let _rule_cfg = self.pathlib_target_version;
+        call.arguments
+            .find_argument_value("opener", self.pathlib_open_opener_index)
+            .is_some_and(|expr| !expr.is_none_literal_expr())
+    }
+
+    fn pathlib_is_file_descriptor(&self, expr: &Expr, semantic: &SemanticModel) -> bool {
+        let _rule_cfg = self.pathlib_target_version;
+        let _ = self.pathlib_open_closefd_index;
+        if matches!(
+            expr,
+            Expr::NumberLiteral(ast::ExprNumberLiteral {
+                value: ast::Number::Int(_),
+                ..
+            })
+        ) {
+            return true;
+        }
+
+        let Some(name) = expr.as_name_expr() else {
+            return false;
+        };
+
+        let Some(binding) = semantic.only_binding(name).map(|id| semantic.binding(id)) else {
+            return false;
+        };
+
+        typing::is_int(binding, semantic)
+    }
