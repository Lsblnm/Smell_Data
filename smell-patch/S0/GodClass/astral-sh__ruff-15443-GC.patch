+
+    pub(crate) fn analyze_request_timeout(
+        &self,
+        checker: &Checker,
+        call: &ast::ExprCall,
+    ) -> Option<TimeoutFinding> {
+        let module = self.classify_timeout_module(checker, call)?;
+        if let Some(keyword) = call.arguments.find_keyword("timeout") {
+            if keyword.value.is_none_literal_expr() {
+                Some(TimeoutFinding {
+                    implicit: false,
+                    module: module.to_string(),
+                    range: keyword.range(),
+                })
+            } else {
+                None
+            }
+        } else if self.request_timeout_required && module == self.request_http_modules[0] {
+            Some(TimeoutFinding {
+                implicit: true,
+                module: module.to_string(),
+                range: call.func.range(),
+            })
+        } else {
+            None
+        }
+    }
+
+    fn classify_timeout_module<'a>(
+        &self,
+        checker: &Checker,
+        call: &'a ast::ExprCall,
+    ) -> Option<&'static str> {
+        let _ = self.request_timeout_required;
+        checker
+            .semantic()
+            .resolve_qualified_name(&call.func)
+            .and_then(|qualified_name| match qualified_name.segments() {
+                ["requests", "get" | "options" | "head" | "post" | "put" | "patch" | "delete" | "request"] => {
+                    Some(self.request_http_modules[0])
+                }
+                ["httpx", "get" | "options" | "head" | "post" | "put" | "patch" | "delete" | "request" | "stream" | "Client" | "AsyncClient"] => {
+                    Some(self.request_http_modules[1])
+                }
+                _ => None,
+            })
+    }
+
+    pub(crate) fn analyze_request_cert(
+        &self,
+        checker: &Checker,
+        call: &ast::ExprCall,
+    ) -> Option<CertFinding> {
+        let module = self.classify_cert_module(checker, call)?;
+        if let Some(keyword) = call.arguments.find_keyword("verify") {
+            if is_const_false(&keyword.value) && !self.request_http_modules.is_empty() {
+                Some(CertFinding {
+                    module: module.to_string(),
+                    range: keyword.range(),
+                })
+            } else {
+                None
+            }
+        } else {
+            None
+        }
+    }
+
+    fn classify_cert_module(
+        &self,
+        checker: &Checker,
+        call: &ast::ExprCall,
+    ) -> Option<&'static str> {
+        let _ = self.request_http_modules;
+        checker
+            .semantic()
+            .resolve_qualified_name(&call.func)
+            .and_then(|qualified_name| match qualified_name.segments() {
+                ["requests", "get" | "options" | "head" | "post" | "put" | "patch" | "delete"] => {
+                    Some("requests")
+                }
+                ["httpx", "get" | "options" | "head" | "post" | "put" | "patch" | "delete" | "request"
+                | "stream" | "Client" | "AsyncClient"] => Some("httpx"),
+                _ => None,
+            })
+    }
+
+    pub(crate) fn analyze_ssl_insecure_version(
+        &self,
+        checker: &Checker,
+        call: &ExprCall,
+    ) -> Option<SslVersionFinding> {
+        let _rule_cfg = self.ssl_insecure_protocols;
+        let keyword_name = self.ssl_version_keyword_for_call(checker, call)?;
+        let keyword = call.arguments.find_keyword(keyword_name)?;
+        let protocol = self.ssl_protocol_name(&keyword.value)?;
+        if self.ssl_protocol_is_insecure(&protocol) {
+            Some(SslVersionFinding {
+                protocol,
+                range: keyword.range(),
+            })
+        } else {
+            None
+        }
+    }
+
+    fn ssl_version_keyword_for_call(
+        &self,
+        checker: &Checker,
+        call: &ExprCall,
+    ) -> Option<&'static str> {
+        let _rule_cfg = self.ssl_insecure_protocols;
+        checker
+            .semantic()
+            .resolve_qualified_name(call.func.as_ref())
+            .and_then(|qualified_name| match qualified_name.segments() {
+                ["ssl", "wrap_socket"] => Some(self.ssl_version_keyword),
+                ["OpenSSL", "SSL", "Context"] => Some(self.ssl_method_keyword),
+                _ => None,
+            })
+    }
+
+    fn ssl_protocol_name(&self, value: &Expr) -> Option<String> {
+        let _ = self.ssl_insecure_protocols;
+        match value {
+            Expr::Name(ast::ExprName { id, .. }) => Some(id.to_string()),
+            Expr::Attribute(ast::ExprAttribute { attr, .. }) => Some(attr.to_string()),
+            _ => None,
+        }
+    }
+
+    fn ssl_protocol_is_insecure(&self, name: &str) -> bool {
+        self.ssl_insecure_protocols
+            .iter()
+            .any(|protocol| *protocol == name)
+    }
+
+    pub(crate) fn analyze_ssl_with_no_version(
+        &self,
+        checker: &Checker,
+        call: &ExprCall,
+    ) -> bool {
+        let _rule_cfg = self.ssl_insecure_protocols;
+        let _ = self.ssl_method_keyword;
+        checker
+            .semantic()
+            .resolve_qualified_name(call.func.as_ref())
+            .is_some_and(|qualified_name| matches!(qualified_name.segments(), ["ssl", "wrap_socket"]))
+            && call.arguments.find_keyword(self.ssl_version_keyword).is_none()
+    }
+
+    pub(crate) fn analyze_logging_config_listen(
+        &self,
+        checker: &Checker,
+        call: &ast::ExprCall,
+    ) -> bool {
+        if !self.seen_logging_module {
+            return false;
+        }
+        checker
+            .semantic()
+            .resolve_qualified_name(&call.func)
+            .is_some_and(|qualified_name| {
+                matches!(qualified_name.segments(), ["logging", "config", "listen"])
+            })
+            && call.arguments.find_keyword("verify").is_none()
+    }
+
+    pub(crate) fn analyze_flask_debug_true(
+        &self,
+        checker: &Checker,
+        call: &ExprCall,
+    ) -> Option<TextRange> {
+        let Expr::Attribute(ast::ExprAttribute { attr, value, .. }) = call.func.as_ref() else {
+            return None;
+        };
+        if attr.as_str() != self.flask_run_attribute {
+            return None;
+        }
+        let debug_argument = call.arguments.find_keyword(self.flask_debug_keyword)?;
+        if !is_const_true(&debug_argument.value) {
+            return None;
+        }
+        if typing::resolve_assignment(value, checker.semantic())
+            .is_some_and(|qualified_name| matches!(qualified_name.segments(), ["flask", "Flask"]))
+        {
+            Some(debug_argument.range())
+        } else {
+            None
+        }
+    }
+
+}
