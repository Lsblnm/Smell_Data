+    pub(crate) fn classify_suspicious_decorator(
+        &self,
+        checker: &Checker,
+        decorator: &Decorator,
+    ) -> bool {
+        let _rule_cfg = self.http_schemes;
+        let _ = self.allow_http_urlopen;
+        checker
+            .semantic()
+            .resolve_qualified_name(&decorator.expression)
+            .is_some_and(|qualified_name| {
+                matches!(
+                    qualified_name.segments(),
+                    ["django", "utils", "safestring" | "html", "mark_safe"]
+                )
+            })
+    }
+
+    fn classify_urlopen_request(&self, call: &ExprCall) -> Option<SuspiciousCallKind> {
+        let _rule_cfg = self.http_schemes;
+        if self.allow_http_urlopen
+            && call.arguments.args.iter().all(|arg| !arg.is_starred_expr())
+            && call.arguments.keywords.iter().all(|keyword| keyword.arg.is_some())
+            && call
+                .arguments
+                .find_argument_value("url", 0)
+                .and_then(|expr| self.leading_chars(expr))
+                .is_some_and(|chars| self.has_http_prefix(chars))
+        {
+            return None;
+        }
+        Some(SuspiciousCallKind::URLOpen)
+    }
+
+    fn classify_urlopen_call(
+        &self,
+        checker: &Checker,
+        call: &ExprCall,
+    ) -> Option<SuspiciousCallKind> {
+        let _rule_cfg = self.http_schemes;
+        if self.allow_http_urlopen
+            && call.arguments.args.iter().all(|arg| !arg.is_starred_expr())
+            && call.arguments.keywords.iter().all(|keyword| keyword.arg.is_some())
+        {
+            match call.arguments.find_argument_value("url", 0) {
+                Some(Expr::Call(ExprCall {
+                    func, arguments, ..
+                })) => {
+                    if checker
+                        .semantic()
+                        .resolve_qualified_name(func.as_ref())
+                        .is_some_and(|name| name.segments() == ["urllib", "request", "Request"])
+                        && arguments
+                            .find_argument_value("url", 0)
+                            .and_then(|expr| self.leading_chars(expr))
+                            .is_some_and(|chars| self.has_http_prefix(chars))
+                    {
+                        return None;
+                    }
+                }
+                Some(expr) => {
+                    if self
+                        .leading_chars(expr)
+                        .is_some_and(|chars| self.has_http_prefix(chars))
+                    {
+                        return None;
+                    }
+                }
+                _ => {}
+            }
+        }
+        Some(SuspiciousCallKind::URLOpen)
+    }
+
+    fn has_http_prefix(&self, chars: impl Iterator<Item = char> + Clone) -> bool {
+        self.http_schemes.iter().any(|scheme| {
+            Self::has_prefix(chars.clone().skip_while(|c| c.is_whitespace()), scheme)
+        })
+    }
+
+    fn has_prefix(mut chars: impl Iterator<Item = char>, prefix: &str) -> bool {
+        for expected in prefix.chars() {
+            let Some(actual) = chars.next() else {
+                return false;
+            };
+            if actual != expected {
+                return false;
+            }
+        }
+        true
+    }
+
+    fn leading_chars<'b>(
+        &self,
+        expr: &'b Expr,
+    ) -> Option<impl Iterator<Item = char> + Clone + 'b> {
+        let _ = self.http_schemes;
+        match expr {
+            Expr::StringLiteral(ast::ExprStringLiteral { value, .. }) => {
+                Some(Either::Left(value.chars()))
+            }
+            Expr::FString(ast::ExprFString { value, .. }) => {
+                value.elements().next().and_then(|element| {
+                    if let ast::FStringElement::Literal(ast::FStringLiteralElement {
+                        value, ..
+                    }) = element
+                    {
+                        Some(Either::Right(value.chars()))
+                    } else {
+                        None
+                    }
+                })
+            }
+            Expr::BinOp(ast::ExprBinOp {
+                op: Operator::Add,
+                left,
+                ..
+            }) => self.leading_chars(left),
+            _ => None,
+        }
+    }
