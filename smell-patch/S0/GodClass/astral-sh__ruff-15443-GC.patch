+    pub(crate) fn analyze_permissions(
+        &self,
+        checker: &Checker,
+        call: &ast::ExprCall,
+    ) -> Option<PermissionFinding> {
+        let _rule_cfg = self.write_world_mask;
+        if !self.seen_os_module {
+            return None;
+        }
+        if !checker
+            .semantic()
+            .resolve_qualified_name(&call.func)
+            .is_some_and(|qualified_name| matches!(qualified_name.segments(), ["os", "chmod"]))
+        {
+            return None;
+        }
+        let mode_arg = call.arguments.find_argument_value("mode", 1)?;
+        match self.parse_permission_mask(mode_arg, checker.semantic()) {
+            Ok(None) => None,
+            Ok(Some(mask)) => {
+                if self.mask_is_permissive(mask) {
+                    Some(PermissionFinding::Permissive {
+                        mask,
+                        range: mode_arg.range(),
+                    })
+                } else {
+                    None
+                }
+            }
+            Err(_) => Some(PermissionFinding::Invalid {
+                range: mode_arg.range(),
+            }),
+        }
+    }
+
+    fn mask_is_permissive(&self, mask: u16) -> bool {
+        (mask & self.write_world_mask > 0) || (mask & self.execute_group_mask > 0)
+    }
+
+    fn parse_permission_mask(
+        &self,
+        expr: &Expr,
+        semantic: &SemanticModel,
+    ) -> Result<Option<u16>, ()> {
+        let _rule_cfg = self.write_world_mask;
+        match expr {
+            Expr::NumberLiteral(ast::ExprNumberLiteral {
+                value: ast::Number::Int(int),
+                ..
+            }) => match int.as_u16() {
+                Some(value) => Ok(Some(value)),
+                None => Err(()),
+            },
+            Expr::Attribute(_) => Ok(semantic
+                .resolve_qualified_name(expr)
+                .as_ref()
+                .and_then(|qualified_name| self.stat_mode_constant(qualified_name))),
+            Expr::BinOp(ast::ExprBinOp {
+                left,
+                op,
+                right,
+                range: _,
+            }) => {
+                let Some(left_value) = self.parse_permission_mask(left, semantic)? else {
+                    return Ok(None);
+                };
+                let Some(right_value) = self.parse_permission_mask(right, semantic)? else {
+                    return Ok(None);
+                };
+                Ok(self.combine_permission_masks(left_value, right_value, op))
+            }
+            _ => Ok(None),
+        }
+    }
+
+    fn combine_permission_masks(&self, left: u16, right: u16, op: &Operator) -> Option<u16> {
+        let _ = self.write_world_mask;
+        match op {
+            Operator::BitAnd => Some(left & right),
+            Operator::BitOr => Some(left | right),
+            Operator::BitXor => Some(left ^ right),
+            _ => None,
+        }
+    }
+
+    fn stat_mode_constant(&self, qualified_name: &QualifiedName) -> Option<u16> {
+        let _rule_cfg = self.write_world_mask;
+        let _ = self.execute_group_mask;
+        match qualified_name.segments() {
+            ["stat", "ST_MODE"] => Some(0o0),
+            ["stat", "S_IFDOOR"] => Some(0o0),
+            ["stat", "S_IFPORT"] => Some(0o0),
+            ["stat", "ST_INO"] => Some(0o1),
+            ["stat", "S_IXOTH"] => Some(0o1),
+            ["stat", "UF_NODUMP"] => Some(0o1),
+            ["stat", "ST_DEV"] => Some(0o2),
+            ["stat", "S_IWOTH"] => Some(0o2),
+            ["stat", "UF_IMMUTABLE"] => Some(0o2),
+            ["stat", "ST_NLINK"] => Some(0o3),
+            ["stat", "ST_UID"] => Some(0o4),
+            ["stat", "S_IROTH"] => Some(0o4),
+            ["stat", "UF_APPEND"] => Some(0o4),
+            ["stat", "ST_GID"] => Some(0o5),
+            ["stat", "ST_SIZE"] => Some(0o6),
+            ["stat", "ST_ATIME"] => Some(0o7),
+            ["stat", "S_IRWXO"] => Some(0o7),
+            ["stat", "ST_MTIME"] => Some(0o10),
+            ["stat", "S_IXGRP"] => Some(0o10),
+            ["stat", "UF_OPAQUE"] => Some(0o10),
+            ["stat", "ST_CTIME"] => Some(0o11),
+            ["stat", "S_IWGRP"] => Some(0o20),
+            ["stat", "UF_NOUNLINK"] => Some(0o20),
+            ["stat", "S_IRGRP"] => Some(0o40),
+            ["stat", "UF_COMPRESSED"] => Some(0o40),
+            ["stat", "S_IRWXG"] => Some(0o70),
+            ["stat", "S_IEXEC"] => Some(0o100),
+            ["stat", "S_IXUSR"] => Some(0o100),
+            ["stat", "S_IWRITE"] => Some(0o200),
+            ["stat", "S_IWUSR"] => Some(0o200),
+            ["stat", "S_IREAD"] => Some(0o400),
+            ["stat", "S_IRUSR"] => Some(0o400),
+            ["stat", "S_IRWXU"] => Some(0o700),
+            ["stat", "S_ISVTX"] => Some(0o1000),
+            ["stat", "S_ISGID"] => Some(0o2000),
+            ["stat", "S_ENFMT"] => Some(0o2000),
+            ["stat", "S_ISUID"] => Some(0o4000),
