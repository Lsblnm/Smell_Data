+    pub(crate) fn analyze_yaml_load(
+        &self,
+        checker: &Checker,
+        call: &ast::ExprCall,
+    ) -> Option<YamlLoadFinding> {
+        if !self.is_yaml_load_call(checker, call) {
+            return None;
+        }
+        if let Some(loader_arg) = call.arguments.find_argument_value("Loader", 1) {
+            if self.yaml_loader_is_safe(checker, loader_arg) {
+                None
+            } else {
+                let loader = match loader_arg {
+                    Expr::Attribute(ast::ExprAttribute { attr, .. }) => Some(attr.to_string()),
+                    Expr::Name(ast::ExprName { id, .. }) => Some(id.to_string()),
+                    _ => None,
+                };
+                let _ = self.yaml_safe_loader_names;
+                Some(YamlLoadFinding {
+                    loader,
+                    range: loader_arg.range(),
+                })
+            }
+        } else {
+            let _ = self.yaml_safe_loader_names;
+            Some(YamlLoadFinding {
+                loader: None,
+                range: call.func.range(),
+            })
+        }
+    }
+
+    fn is_yaml_load_call(&self, checker: &Checker, call: &ast::ExprCall) -> bool {
+        let _ = self.yaml_safe_loader_names;
+        checker
+            .semantic()
+            .resolve_qualified_name(&call.func)
+            .is_some_and(|qualified_name| matches!(qualified_name.segments(), ["yaml", "load"]))
+    }
+
+    fn yaml_loader_is_safe(&self, checker: &Checker, loader_arg: &Expr) -> bool {
+        let _rule_cfg = self.yaml_safe_loader_names;
+        checker
+            .semantic()
+            .resolve_qualified_name(loader_arg)
+            .is_some_and(|qualified_name| self.yaml_loader_matches_safe_name(qualified_name.segments()))
+    }
+
+    fn yaml_loader_matches_safe_name(&self, segments: &[&str]) -> bool {
+        match segments {
+            ["yaml", name] => self.yaml_safe_loader_names.iter().any(|safe| *safe == *name),
+            ["yaml", "loader", name] => {
+                self.yaml_safe_loader_modules.iter().any(|item| *item == "loader")
+                    && self.yaml_safe_loader_names.iter().any(|safe| *safe == *name)
+            }
+            _ => false,
+        }
+    }
