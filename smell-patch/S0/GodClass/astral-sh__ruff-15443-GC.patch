+                Some(SuspiciousCallKind::InsecureCipherMode)
+            }
+            ["tempfile", "mktemp"] => Some(SuspiciousCallKind::Mktemp),
+            ["" | "builtins", "eval"] => Some(SuspiciousCallKind::Eval),
+            ["django", "utils", "safestring" | "html", "mark_safe"] => {
+                Some(SuspiciousCallKind::MarkSafe)
+            }
+            ["urllib", "request", "Request"]
+            | ["six", "moves", "urllib", "request", "Request"] => {
+                self.classify_urlopen_request(call)
+            }
+            ["urllib", "request", "urlopen" | "urlretrieve"]
+            | ["six", "moves", "urllib", "request", "urlopen" | "urlretrieve"] => {
+                self.classify_urlopen_call(checker, call)
+            }
+            ["urllib", "request", "URLopener" | "FancyURLopener"]
+            | ["six", "moves", "urllib", "request", "URLopener" | "FancyURLopener"] => {
+                Some(SuspiciousCallKind::URLOpen)
+            }
+            ["random", "Random" | "random" | "randrange" | "randint" | "choice" | "choices" | "uniform" | "triangular" | "randbytes"] => {
+                Some(SuspiciousCallKind::NonCryptographicRandom)
+            }
+            ["ssl", "_create_unverified_context"] => Some(SuspiciousCallKind::UnverifiedContext),
+            ["xml", "etree", "cElementTree", "parse" | "iterparse" | "fromstring" | "XMLParser"] => {
+                Some(SuspiciousCallKind::XMLCElementTree)
+            }
+            ["xml", "etree", "ElementTree", "parse" | "iterparse" | "fromstring" | "XMLParser"] => {
+                Some(SuspiciousCallKind::XMLElementTree)
+            }
+            ["xml", "sax", "expatreader", "create_parser"] => {
+                Some(SuspiciousCallKind::XMLExpatReader)
+            }
+            ["xml", "dom", "expatbuilder", "parse" | "parseString"] => {
+                Some(SuspiciousCallKind::XMLExpatBuilder)
+            }
+            ["xml", "sax", "parse" | "parseString" | "make_parser"] => {
+                Some(SuspiciousCallKind::XMLSax)
+            }
+            ["xml", "dom", "minidom", "parse" | "parseString"] => {
+                Some(SuspiciousCallKind::XMLMiniDOM)
+            }
+            ["xml", "dom", "pulldom", "parse" | "parseString"] => {
+                Some(SuspiciousCallKind::XMLPullDOM)
+            }
+            ["lxml", "etree", "parse" | "fromstring" | "RestrictedElement" | "GlobalParserTLS" | "getDefaultParser" | "check_docinfo"] => {
+                Some(SuspiciousCallKind::XMLETree)
+            }
+            ["telnetlib", ..] => Some(SuspiciousCallKind::Telnet),
+            ["ftplib", ..] => Some(SuspiciousCallKind::FTPLib),
+            _ => None,
+        }
+    }
