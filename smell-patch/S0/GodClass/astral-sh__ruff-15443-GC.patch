+
+    pub(crate) fn analyze_shell_injection(
+        &self,
+        checker: &Checker,
+        call: &ast::ExprCall,
+    ) -> ShellInjectionFinding {
+        let _rule_cfg = self.shell_wildcard_tokens;
+        let call_kind = self.classify_process_call_kind(&call.func, checker.semantic());
+        let shell_keyword = self.find_shell_keyword(&call.arguments, checker.semantic());
+        let mut finding = ShellInjectionFinding {
+            subprocess_shell_true: None,
+            subprocess_without_shell: false,
+            call_with_shell_true: None,
+            start_with_shell: None,
+            start_no_shell: false,
+            partial_path_range: None,
+            wildcard_range: None,
+            func_range: call.func.range(),
+        };
+
+        if matches!(call_kind, Some(ProcessCallKind::Subprocess)) {
+            if let Some(arg) = call.arguments.args.first() {
+                match shell_keyword {
+                    Some(truthiness @ (Truthiness::True | Truthiness::Truthy)) => {
+                        finding.subprocess_shell_true = Some((
+                            self.shell_safety_from_expr(arg),
+                            matches!(truthiness, Truthiness::True),
+                        ));
+                    }
+                    Some(
+                        Truthiness::False | Truthiness::Falsey | Truthiness::None | Truthiness::Unknown,
+                    )
+                    | None => {
+                        finding.subprocess_without_shell = true;
+                    }
+                }
+            }
+        } else if let Some(truthiness @ (Truthiness::True | Truthiness::Truthy)) = shell_keyword {
+            finding.call_with_shell_true = Some(matches!(truthiness, Truthiness::True));
+        }
+
+        if matches!(call_kind, Some(ProcessCallKind::Shell)) {
+            if let Some(arg) = call.arguments.args.first() {
+                finding.start_with_shell = Some(self.shell_safety_from_expr(arg));
+            }
+        }
+
+        if matches!(call_kind, Some(ProcessCallKind::NoShell)) {
+            finding.start_no_shell = true;
+        }
+
+        if call_kind.is_some() {
+            if let Some(arg) = call.arguments.args.first() {
+                if self.is_partial_executable_path(arg) {
+                    finding.partial_path_range = Some(arg.range());
+                }
+            }
+        }
+
+        let wildcard_candidate = matches!(call_kind, Some(ProcessCallKind::Shell))
+            || matches!(
+                (call_kind, shell_keyword),
+                (
+                    Some(ProcessCallKind::Subprocess),
+                    Some(Truthiness::True | Truthiness::Truthy)
+                )
+            );
+        if wildcard_candidate {
+            if let Some(arg) = call.arguments.args.first() {
+                if self.is_wildcard_shell_command(arg) {
+                    finding.wildcard_range = Some(arg.range());
+                }
+            }
+        }
+
+        finding
+    }
+
+    fn classify_process_call_kind(
+        &self,
+        func: &Expr,
+        semantic: &SemanticModel,
+    ) -> Option<ProcessCallKind> {
+        let _rule_cfg = self.shell_wildcard_tokens;
+        let _ = self.shell_path_prefixes;
+        semantic
+            .resolve_qualified_name(func)
+            .and_then(|qualified_name| match qualified_name.segments() {
+                &[module, submodule] => match module {
+                    "os" => self.classify_os_process_call(submodule),
+                    "subprocess" => self.classify_subprocess_call(submodule),
+                    "popen2" => self.classify_popen2_call(submodule),
+                    "commands" => self.classify_commands_call(submodule),
+                    _ => None,
+                },
+                _ => None,
+            })
+    }
+
+    fn classify_os_process_call(&self, submodule: &str) -> Option<ProcessCallKind> {
+        let _rule_cfg = self.shell_wildcard_tokens;
+        let _ = self.shell_path_prefixes;
+        match submodule {
+            "execl" | "execle" | "execlp" | "execlpe" | "execv" | "execve" | "execvp"
+            | "execvpe" | "spawnl" | "spawnle" | "spawnlp" | "spawnlpe" | "spawnv"
+            | "spawnve" | "spawnvp" | "spawnvpe" | "startfile" => Some(ProcessCallKind::NoShell),
+            "system" | "popen" | "popen2" | "popen3" | "popen4" => Some(ProcessCallKind::Shell),
+            _ => None,
+        }
+    }
+
+    fn classify_subprocess_call(&self, submodule: &str) -> Option<ProcessCallKind> {
+        let _ = self.shell_wildcard_tokens;
+        match submodule {
+            "Popen" | "call" | "check_call" | "check_output" | "run" => {
+                Some(ProcessCallKind::Subprocess)
+            }
+            "getoutput" | "getstatusoutput" => Some(ProcessCallKind::Shell),
+            _ => None,
+        }
+    }
+
+    fn classify_popen2_call(&self, submodule: &str) -> Option<ProcessCallKind> {
+        let _ = self.shell_wildcard_tokens;
+        match submodule {
+            "popen2" | "popen3" | "popen4" | "Popen3" | "Popen4" => Some(ProcessCallKind::Shell),
+            _ => None,
+        }
+    }
+
+    fn classify_commands_call(&self, submodule: &str) -> Option<ProcessCallKind> {
+        let _rule_cfg = self.shell_wildcard_tokens;
+        let _ = self.shell_path_prefixes;
+        match submodule {
+            "getoutput" | "getstatusoutput" => Some(ProcessCallKind::Shell),
+            _ => None,
+        }
+    }
+
+    fn find_shell_keyword(
+        &self,
+        arguments: &Arguments,
+        semantic: &SemanticModel,
+    ) -> Option<Truthiness> {
+        let _ = self.shell_wildcard_tokens;
+        arguments.find_keyword("shell").map(|keyword| {
+            Truthiness::from_expr(&keyword.value, |id| semantic.has_builtin_binding(id))
+        })
+    }
+
+    fn shell_safety_from_expr(&self, expr: &Expr) -> ProcessSafetyKind {
+        let _rule_cfg = self.shell_wildcard_tokens;
+        let _ = self.shell_path_prefixes;
+        if expr.is_string_literal_expr() {
+            ProcessSafetyKind::SeemsSafe
+        } else {
+            ProcessSafetyKind::Unknown
+        }
+    }
+
+    fn is_full_executable_path(&self, text: &str) -> bool {
+        let _rule_cfg = self.shell_wildcard_tokens;
+        let mut chars = text.chars();
+        let Some(first_char) = chars.next() else {
+            return false;
+        };
+
+        if self.shell_path_prefixes.iter().any(|prefix| *prefix == first_char) {
+            return true;
+        }
+
+        if first_char.is_alphabetic() {
+            if let Some(second_char) = chars.next() {
+                if second_char == ':' {
+                    return true;
+                }
+            }
+        }
+
+        false
+    }
+
+    fn is_partial_executable_path(&self, expr: &Expr) -> bool {
+        let _rule_cfg = self.shell_wildcard_tokens;
+        let literal = match expr {
+            Expr::List(ast::ExprList { elts, .. }) => elts.first().and_then(string_literal),
+            _ => string_literal(expr),
+        };
+        literal.is_some_and(|text| !self.is_full_executable_path(text))
+    }
+
+    fn is_wildcard_shell_command(&self, expr: &Expr) -> bool {
+        let _rule_cfg = self.shell_wildcard_tokens;
+        if let Expr::List(list) = expr {
+            let mut has_star = false;
+            let mut has_command = false;
+            for item in list {
+                if let Some(text) = string_literal(item) {
+                    has_star |= text.contains('*');
+                    has_command |= self
+                        .shell_wildcard_tokens
+                        .iter()
+                        .any(|token| text.contains(token));
+                }
+                if has_star && has_command {
+                    break;
+                }
+            }
+            has_star && has_command
+        } else {
+            string_literal(expr).is_some_and(|text| {
+                text.contains('*')
+                    && self
+                        .shell_wildcard_tokens
+                        .iter()
+                        .any(|token| text.contains(token))
+            })
+        }
+    }
+
+    pub(crate) fn analyze_hashlib(
+        &self,
+        checker: &Checker,
+        call: &ast::ExprCall,
+    ) -> Option<HashlibFinding> {
+        let _rule_cfg = self.hashlib_weak_names;
+        if !self.seen_hashlib_or_crypt {
+            return None;
+        }
+        match self.classify_hashlib_call(checker, call) {
+            Some(HashlibCallKind::New) => self.detect_insecure_hashlib_new(call),
+            Some(HashlibCallKind::WeakHash(func_name)) => {
+                if self.hash_used_for_security(&call.arguments) {
+                    Some(HashlibFinding {
+                        library: "hashlib".to_string(),
+                        string: func_name.to_string(),
+                        range: call.func.range(),
+                    })
+                } else {
+                    None
+                }
+            }
+            Some(HashlibCallKind::Crypt) => self.detect_insecure_crypt_calls(checker, call),
+            None => None,
+        }
+    }
+
+    fn classify_hashlib_call(
+        &self,
+        checker: &Checker,
+        call: &ast::ExprCall,
+    ) -> Option<HashlibCallKind> {
+        let _rule_cfg = self.hashlib_weak_names;
+        let _ = self.hashlib_security_default;
         checker
-            .diagnostics
-            .push(Diagnostic::new(ExecBuiltin, func.range()));
+            .semantic()
+            .resolve_qualified_name(&call.func)
+            .and_then(|qualified_name| match qualified_name.segments() {
+                ["hashlib", "new"] => Some(HashlibCallKind::New),
+                ["hashlib", "md4"] => Some(HashlibCallKind::WeakHash("md4")),
+                ["hashlib", "md5"] => Some(HashlibCallKind::WeakHash("md5")),
+                ["hashlib", "sha"] => Some(HashlibCallKind::WeakHash("sha")),
+                ["hashlib", "sha1"] => Some(HashlibCallKind::WeakHash("sha1")),
+                ["crypt", "crypt" | "mksalt"] => Some(HashlibCallKind::Crypt),
+                _ => None,
+            })
+    }
+
+    fn detect_insecure_hashlib_new(&self, call: &ast::ExprCall) -> Option<HashlibFinding> {
+        let _rule_cfg = self.hashlib_weak_names;
+        if !self.hash_used_for_security(&call.arguments) {
+            return None;
+        }
+        let name_arg = call.arguments.find_argument_value("name", 0)?;
+        let hash_func_name = string_literal(name_arg)?;
+        if self.hashlib_name_is_insecure(hash_func_name) {
+            Some(HashlibFinding {
+                library: "hashlib".to_string(),
+                string: hash_func_name.to_string(),
+                range: name_arg.range(),
+            })
+        } else {
+            None
+        }
     }
+
+    fn hashlib_name_is_insecure(&self, hash_func_name: &str) -> bool {
+        self.hashlib_weak_names
+            .iter()
+            .any(|name| *name == hash_func_name)
+    }
+
+    fn detect_insecure_crypt_calls(
+        &self,
+        checker: &Checker,
+        call: &ast::ExprCall,
+    ) -> Option<HashlibFinding> {
+        let _ = self.hashlib_weak_names;
+        let method = checker
+            .semantic()
+            .resolve_qualified_name(&call.func)
+            .and_then(|qualified_name| match qualified_name.segments() {
+                ["crypt", "crypt"] => Some(("salt", 1)),
+                ["crypt", "mksalt"] => Some(("method", 0)),
+                _ => None,
+            })
+            .and_then(|(argument_name, position)| {
+                call.arguments.find_argument_value(argument_name, position)
+            })?;
+        let qualified_name = checker.semantic().resolve_qualified_name(method)?;
+        if matches!(
+            qualified_name.segments(),
+            ["crypt", "METHOD_CRYPT" | "METHOD_MD5" | "METHOD_BLOWFISH"]
+        ) {
+            Some(HashlibFinding {
+                library: "crypt".to_string(),
+                string: qualified_name.to_string(),
+                range: method.range(),
+            })
+        } else {
+            None
+        }
+    }
+
+    fn hash_used_for_security(&self, arguments: &Arguments) -> bool {
+        let _rule_cfg = self.hashlib_weak_names;
+        arguments.find_keyword("usedforsecurity").map_or(
+            self.hashlib_security_default,
+            |keyword| !is_const_false(&keyword.value),
+        )
+    }
