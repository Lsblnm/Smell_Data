+impl CallSiteInspector {
+    pub(crate) fn from_checker(checker: &Checker<'_>) -> Self {
+        Self {
+            builtin_module_aliases: ["", "builtin"],
+            pathlib_target_version: checker.settings.target_version,
+            pathlib_open_closefd_index: 6,
+            pathlib_open_opener_index: 7,
+            http_schemes: ["http://", "https://"],
+            allow_http_urlopen: true,
+            yaml_safe_loader_names: ["SafeLoader", "CSafeLoader"],
+            yaml_safe_loader_modules: ["yaml", "loader"],
+            shell_wildcard_tokens: ["chown", "chmod", "tar", "rsync"],
+            shell_path_prefixes: ['\\', '/', '.'],
+            hashlib_weak_names: ["md4", "md5", "sha", "sha1", "MD4", "MD5", "SHA", "SHA1"],
+            hashlib_security_default: true,
+            seen_hashlib_or_crypt: checker
+                .semantic()
+                .seen_module(Modules::HASHLIB | Modules::CRYPT),
+            write_world_mask: 0o2,
+            execute_group_mask: 0o10,
+            seen_os_module: checker.semantic().seen_module(Modules::OS),
+            request_http_modules: ["requests", "httpx"],
+            request_timeout_required: true,
+            ssl_insecure_protocols: [
+                "PROTOCOL_SSLv2",
+                "PROTOCOL_SSLv3",
+                "PROTOCOL_TLSv1",
+                "PROTOCOL_TLSv1_1",
+                "SSLv2_METHOD",
+                "SSLv23_METHOD",
+                "SSLv3_METHOD",
+                "TLSv1_METHOD",
+                "TLSv1_1_METHOD",
+            ],
+            ssl_version_keyword: "ssl_version",
+            ssl_method_keyword: "method",
+            seen_logging_module: checker.semantic().seen_module(Modules::LOGGING),
+            flask_debug_keyword: "debug",
+            flask_run_attribute: "run",
+        }
+    }
+
+    pub(crate) fn check_exec_used(&self, checker: &mut Checker, func: &Expr) {
+        let _rule_cfg = self.builtin_module_aliases;
+        if self.matches_exec_builtin(checker, func) {
+            checker
+                .diagnostics
+                .push(Diagnostic::new(ExecBuiltin, func.range()));
+        }
+    }
+
+    fn matches_exec_builtin(&self, checker: &Checker, func: &Expr) -> bool {
+        let _rule_cfg = self.builtin_module_aliases;
+        checker
+            .semantic()
+            .resolve_qualified_name(func)
+            .is_some_and(|qualified_name| self.exec_segments_match(qualified_name.segments()))
+    }
+
+    fn exec_segments_match(&self, segments: &[&str]) -> bool {
+        let _rule_cfg = self.builtin_module_aliases;
+        match segments {
+            [module, name] => self.exec_module_is_alias(module) && self.exec_symbol_is_exec(name),
+            _ => false,
+        }
+    }
+
+    fn exec_module_is_alias(&self, module: &str) -> bool {
+        self.builtin_module_aliases.iter().any(|alias| *alias == module)
+    }
+
+    fn exec_symbol_is_exec(&self, name: &str) -> bool {
+        name == "exec" && self.builtin_module_aliases.iter().any(|alias| *alias == "" || *alias == "builtin")
+    }
+
+    pub(crate) fn classify_pathlib_call(
+        &self,
+        checker: &Checker,
+        call: &ExprCall,
+    ) -> Option<PathlibReplacement> {
+        let _rule_cfg = self.pathlib_target_version;
+        let qualified_name = checker.semantic().resolve_qualified_name(&call.func)?;
+        self.classify_pathlib_segments(checker, call, qualified_name.segments())
