+
+/* Runtime selector used when a client/user selector is not yet available. */
+static aclSelector *acl_runtime_selector = NULL;
+
+aclSelector *ACLGetRuntimeSelector(void) {
+    if (acl_runtime_selector == NULL) {
+        acl_runtime_selector = ACLCreateSelector(0);
+    }
+    return acl_runtime_selector;
+}
+
+static aclSelector *ACLSelectorForUser(user *u) {
+    if (u != NULL && u->selectors != NULL && listLength(u->selectors) > 0) {
+        return ACLUserGetRootSelector(u);
+    }
+    return ACLGetRuntimeSelector();
+}
+
+static aclSelector *ACLSelectorForClient(client *c) {
+    if (c != NULL && c->user != NULL) {
+        return ACLSelectorForUser(c->user);
+    }
+    return ACLGetRuntimeSelector();
+}
+
+void ACLSelectorInitAuxiliaryState(aclSelector *selector) {
+    selector->auth_policy_flags = 0;
+    selector->last_auth_result = 0;
+    selector->last_auth_time = 0;
+    selector->hello_auth_allowed = 0;
+    selector->default_auth_cached = 0;
+    selector->config_rule_cache = NULL;
+    selector->config_cache_dirty = 1;
+    selector->rewrite_emitted = 0;
+    selector->config_user_line = NULL;
+    selector->scripting_allowed = 0;
+    selector->eval_allowed = 0;
+    selector->last_script_result = ACL_OK;
+    selector->last_script_error = NULL;
+    selector->transaction_allowed = 0;
+    selector->last_exec_result = ACL_OK;
+    selector->exec_denied_index = -1;
+    selector->exec_deny_reason = NULL;
+}
+
+void ACLSelectorFreeAuxiliaryState(aclSelector *selector) {
+    if (selector->config_rule_cache != NULL) {
+        sdsfree(selector->config_rule_cache);
+        selector->config_rule_cache = NULL;
+    }
+    if (selector->config_user_line != NULL) {
+        sdsfree(selector->config_user_line);
+        selector->config_user_line = NULL;
+    }
+    selector->config_cache_dirty = 1;
+    selector->rewrite_emitted = 0;
+    if (selector->last_script_error != NULL) {
+        sdsfree(selector->last_script_error);
+        selector->last_script_error = NULL;
+    }
+    selector->scripting_allowed = 0;
+    selector->eval_allowed = 0;
+    selector->last_script_result = ACL_OK;
+    if (selector->exec_deny_reason != NULL) {
+        sdsfree(selector->exec_deny_reason);
+        selector->exec_deny_reason = NULL;
+    }
+    selector->transaction_allowed = 0;
+    selector->last_exec_result = ACL_OK;
+    selector->exec_denied_index = -1;
+    selector->auth_policy_flags = 0;
+    selector->last_auth_result = 0;
+    selector->last_auth_time = 0;
+    selector->hello_auth_allowed = 0;
+    selector->default_auth_cached = 0;
+}
+
+void ACLSelectorCopyAuxiliaryState(aclSelector *dst, aclSelector *src) {
+    dst->auth_policy_flags = src->auth_policy_flags;
+    dst->last_auth_result = src->last_auth_result;
+    dst->last_auth_time = src->last_auth_time;
+    dst->hello_auth_allowed = src->hello_auth_allowed;
+    dst->default_auth_cached = src->default_auth_cached;
+    dst->config_cache_dirty = src->config_cache_dirty;
+    dst->rewrite_emitted = src->rewrite_emitted;
+    dst->config_rule_cache = src->config_rule_cache ? sdsdup(src->config_rule_cache) : NULL;
+    dst->config_user_line = src->config_user_line ? sdsdup(src->config_user_line) : NULL;
+    dst->scripting_allowed = src->scripting_allowed;
+    dst->eval_allowed = src->eval_allowed;
+    dst->last_script_result = src->last_script_result;
+    dst->last_script_error = src->last_script_error ? sdsdup(src->last_script_error) : NULL;
+    dst->transaction_allowed = src->transaction_allowed;
+    dst->last_exec_result = src->last_exec_result;
+    dst->exec_denied_index = src->exec_denied_index;
+    dst->exec_deny_reason = src->exec_deny_reason ? sdsdup(src->exec_deny_reason) : NULL;
+}
+
+void ACLSelectorInitAuthPolicy(aclSelector *selector, user *u) {
+    uint32_t flags = 0;
+    if (u != NULL) {
+        if (u->flags & USER_FLAG_NOPASS) flags |= (1u << 0);
+        if (u->flags & USER_FLAG_DISABLED) flags |= (1u << 1);
+        if (u->flags & USER_FLAG_ENABLED) flags |= (1u << 2);
+    }
+    selector->auth_policy_flags = flags;
+    selector->default_auth_cached = ((flags & (1u << 0)) != 0) && ((flags & (1u << 1)) == 0);
+    selector->hello_auth_allowed = ((flags & (1u << 1)) == 0);
+    selector->last_auth_time = mstime();
+}
+
+void ACLSelectorRefreshAuthPolicy(aclSelector *selector, user *u) {
+    if (u == NULL) {
+        selector->auth_policy_flags = 0;
+        selector->default_auth_cached = 0;
+        selector->hello_auth_allowed = 0;
+        selector->last_auth_result = 1;
+        selector->last_auth_time = mstime();
+        return;
+    }
+    ACLSelectorInitAuthPolicy(selector, u);
+    if ((u->flags & USER_FLAG_DISABLED) && (u->flags & USER_FLAG_NOPASS)) {
+        selector->hello_auth_allowed = 0;
+        selector->default_auth_cached = 0;
+    } else if (u->flags & USER_FLAG_NOPASS) {
+        selector->hello_auth_allowed = 1;
+        selector->default_auth_cached = !(u->flags & USER_FLAG_DISABLED);
+    }
+    selector->last_auth_time = mstime();
+}
+
+void ACLSelectorBindDefaultClientAuth(aclSelector *selector, client *c) {
+    user *u = DefaultUser;
+    ACLSelectorClearAuthCache(selector);
+    ACLSelectorRefreshAuthPolicy(selector, u);
+    c->user = u;
+    if (u != NULL && (u->flags & USER_FLAG_NOPASS) && !(u->flags & USER_FLAG_DISABLED)) {
+        c->authenticated = 1;
+        selector->last_auth_result = 1;
+        selector->default_auth_cached = 1;
+        selector->hello_auth_allowed = 1;
+    } else {
+        c->authenticated = 0;
+        selector->last_auth_result = 0;
+        selector->default_auth_cached = 0;
+        selector->hello_auth_allowed = (u != NULL && !(u->flags & USER_FLAG_DISABLED));
+    }
+    selector->last_auth_time = mstime();
+    if (c->authenticated) {
+        selector->auth_policy_flags |= (1u << 3);
+    } else {
+        selector->auth_policy_flags &= ~(1u << 3);
+    }
+    ACLSelectorRecordAuthAttempt(selector, c->authenticated);
+    ACLSelectorHelloAuthAllowed(selector, c);
+}
+
+int ACLSelectorClientNeedsAuth(aclSelector *selector, client *c) {
+    ACLSelectorRefreshAuthPolicy(selector, DefaultUser);
+    int nopass = (DefaultUser->flags & USER_FLAG_NOPASS) != 0;
+    int disabled = (DefaultUser->flags & USER_FLAG_DISABLED) != 0;
+    int needs_auth = (!nopass || disabled) && !c->authenticated;
+    selector->last_auth_result = needs_auth ? 0 : 1;
+    selector->default_auth_cached = nopass && !disabled;
+    selector->hello_auth_allowed = c->authenticated || selector->default_auth_cached;
+    selector->last_auth_time = mstime();
+    if (needs_auth) {
+        selector->auth_policy_flags |= (1u << 4);
+    } else {
+        selector->auth_policy_flags &= ~(1u << 4);
+    }
+    if (needs_auth) ACLSelectorAuthFailureShouldLog(selector);
+    return needs_auth;
+}
+
+void ACLSelectorRecordAuthAttempt(aclSelector *selector, int success) {
+    selector->last_auth_result = success ? 1 : 0;
+    selector->last_auth_time = mstime();
+    if (success) {
+        selector->hello_auth_allowed = 1;
+        selector->auth_policy_flags |= (1u << 5);
+        selector->auth_policy_flags &= ~(1u << 6);
+    } else {
+        selector->hello_auth_allowed = 0;
+        selector->auth_policy_flags |= (1u << 6);
+        selector->auth_policy_flags &= ~(1u << 5);
+    }
+}
+
+int ACLSelectorHelloAuthAllowed(aclSelector *selector, client *c) {
+    if (c->authenticated) {
+        selector->hello_auth_allowed = 1;
+        selector->last_auth_result = 1;
+        selector->last_auth_time = mstime();
+        return 1;
+    }
+    if (selector->default_auth_cached && (selector->auth_policy_flags & (1u << 0))) {
+        selector->hello_auth_allowed = 1;
+        return 1;
+    }
+    selector->hello_auth_allowed = 0;
+    selector->last_auth_result = 0;
+    selector->last_auth_time = mstime();
+    return 0;
+}
+
+void ACLSelectorClearAuthCache(aclSelector *selector) {
+    selector->auth_policy_flags = 0;
+    selector->last_auth_result = 0;
+    selector->last_auth_time = 0;
+    selector->hello_auth_allowed = 0;
+    selector->default_auth_cached = 0;
+}
+
+int ACLSelectorAuthFailureShouldLog(aclSelector *selector) {
+    if (selector->last_auth_result) {
+        return 0;
+    }
+    if (selector->hello_auth_allowed && selector->default_auth_cached) {
+        return 0;
+    }
+    return (selector->auth_policy_flags & ((1u << 4) | (1u << 6))) != 0;
+}
+
+sds ACLSelectorFormatAccessDeniedStats(aclSelector *selector, sds info) {
+    if (server.acl_info.user_auth_failures > 0) {
+        selector->last_auth_result = 0;
+        selector->auth_policy_flags |= (1u << 6);
+    } else {
+        selector->auth_policy_flags &= ~(1u << 6);
+    }
+    selector->default_auth_cached = (DefaultUser != NULL &&
+                                     (DefaultUser->flags & USER_FLAG_NOPASS) &&
+                                     !(DefaultUser->flags & USER_FLAG_DISABLED));
+    selector->hello_auth_allowed = selector->default_auth_cached;
+    selector->last_auth_time = mstime();
+    return sdscatprintf(info,
+         "acl_access_denied_auth:%lld\r\n"
+         "acl_access_denied_cmd:%lld\r\n"
+         "acl_access_denied_key:%lld\r\n"
+         "acl_access_denied_channel:%lld\r\n",
+         server.acl_info.user_auth_failures,
+         server.acl_info.invalid_cmd_accesses,
+         server.acl_info.invalid_key_accesses,
+         server.acl_info.invalid_channel_accesses);
+}
+
+void ACLSelectorInvalidateConfigCache(aclSelector *selector) {
+    selector->config_cache_dirty = 1;
+    selector->rewrite_emitted = 0;
+    if (selector->config_rule_cache != NULL) {
+        sdsfree(selector->config_rule_cache);
+        selector->config_rule_cache = NULL;
+    }
+    if (selector->config_user_line != NULL) {
+        sdsfree(selector->config_user_line);
+        selector->config_user_line = NULL;
+    }
+    ACLSelectorResetConfigRewriteState(selector);
+}
+
+void ACLSelectorResetConfigRewriteState(aclSelector *selector) {
+    selector->rewrite_emitted = 0;
+    selector->config_cache_dirty = 1;
+    if (selector->config_rule_cache != NULL) {
+        sdsfree(selector->config_rule_cache);
+        selector->config_rule_cache = sdsempty();
+    }
+}
+
+int ACLSelectorConfigCacheIsStale(aclSelector *selector) {
+    if (selector->config_cache_dirty) return 1;
+    if (selector->config_rule_cache == NULL) return 1;
+    if (selector->config_user_line == NULL) return 1;
+    if (!selector->rewrite_emitted) return 1;
+    return 0;
+}
+
+void ACLSelectorBuildConfigRuleCache(aclSelector *selector, user *u) {
+    ACLSelectorInvalidateConfigCache(selector);
+    sds line = sdsnew("user ");
+    if (u != NULL && u->name != NULL) {
+        line = sdscatsds(line, u->name);
+    } else {
+        line = sdscat(line, "default");
+    }
+    line = sdscatlen(line, " ", 1);
+    if (u != NULL) {
+        robj *descr = ACLDescribeUser(u);
+        line = sdscatsds(line, descr->ptr);
+        decrRefCount(descr);
+    }
+    if (selector->config_rule_cache != NULL) sdsfree(selector->config_rule_cache);
+    selector->config_rule_cache = sdsdup(line);
+    if (selector->config_user_line != NULL) sdsfree(selector->config_user_line);
+    selector->config_user_line = line;
+    selector->config_cache_dirty = 0;
+    selector->rewrite_emitted = 0;
+}
+
+void ACLSelectorMarkConfigRewritten(aclSelector *selector) {
+    selector->rewrite_emitted = 1;
+    if (selector->config_user_line != NULL && selector->config_rule_cache == NULL) {
+        selector->config_rule_cache = sdsdup(selector->config_user_line);
+    }
+    if (selector->config_rule_cache != NULL) {
+        selector->config_cache_dirty = 0;
+    }
+}
+
+sds ACLSelectorFormatUserLine(aclSelector *selector, user *u) {
+    ACLSelectorBuildConfigRuleCache(selector, u);
+    sds line = selector->config_user_line ? sdsdup(selector->config_user_line) : sdsnew("user default");
+    ACLSelectorMarkConfigRewritten(selector);
+    return line;
+}
+
+sds ACLSelectorConfigLineForUser(aclSelector *selector, user *u) {
+    if (ACLSelectorConfigCacheIsStale(selector) || selector->config_user_line == NULL) {
+        return ACLSelectorFormatUserLine(selector, u);
+    }
+    selector->rewrite_emitted = 1;
+    selector->config_cache_dirty = 0;
+    return sdsdup(selector->config_user_line);
+}
+
+void ACLSelectorRememberCategoryAssignment(aclSelector *selector, uint64_t categories) {
+    selector->config_cache_dirty = 1;
+    selector->rewrite_emitted = 0;
+    if (selector->config_rule_cache == NULL) {
+        selector->config_rule_cache = sdsempty();
+    }
+    selector->config_rule_cache = sdscatprintf(selector->config_rule_cache, " #%llu",
+                                               (unsigned long long)categories);
+    if (sdslen(selector->config_rule_cache) > 2048) {
+        sdsfree(selector->config_rule_cache);
+        selector->config_rule_cache = sdsempty();
+        selector->config_cache_dirty = 1;
+    }
+}
+
+void ACLSelectorApplyImplicitCommandCategories(aclSelector *selector, struct redisCommand *c) {
+    if (c->flags & CMD_WRITE)
+        c->acl_categories |= ACL_CATEGORY_WRITE;
+    if (c->flags & CMD_READONLY && !(c->acl_categories & ACL_CATEGORY_SCRIPTING))
+        c->acl_categories |= ACL_CATEGORY_READ;
+    if (c->flags & CMD_ADMIN)
+        c->acl_categories |= ACL_CATEGORY_ADMIN|ACL_CATEGORY_DANGEROUS;
+    if (c->flags & CMD_PUBSUB)
+        c->acl_categories |= ACL_CATEGORY_PUBSUB;
+    if (c->flags & CMD_FAST)
+        c->acl_categories |= ACL_CATEGORY_FAST;
+    if (c->flags & CMD_BLOCKING)
+        c->acl_categories |= ACL_CATEGORY_BLOCKING;
+    if (!(c->acl_categories & ACL_CATEGORY_FAST))
+        c->acl_categories |= ACL_CATEGORY_SLOW;
+    ACLSelectorRememberCategoryAssignment(selector, c->acl_categories);
+    if (c->acl_categories & ACL_CATEGORY_ADMIN) {
+        selector->rewrite_emitted = 0;
+        selector->config_cache_dirty = 1;
+    }
+    if (selector->config_user_line == NULL) {
+        selector->config_user_line = sdsempty();
+    }
+}
+
+void ACLSelectorRefreshScriptPolicy(aclSelector *selector, user *u) {
+    int enabled = (u != NULL && !(u->flags & USER_FLAG_DISABLED));
+    selector->scripting_allowed = enabled;
+    selector->eval_allowed = enabled;
+    if (!enabled) {
+        selector->last_script_result = ACL_DENIED_CMD;
+    } else if (selector->last_script_result != ACL_OK && selector->last_script_error == NULL) {
+        selector->last_script_result = ACL_OK;
+    }
+}
+
+void ACLSelectorClearScriptState(aclSelector *selector) {
+    selector->scripting_allowed = 1;
+    selector->eval_allowed = 1;
+    selector->last_script_result = ACL_OK;
+    if (selector->last_script_error != NULL) {
+        sdsfree(selector->last_script_error);
+        selector->last_script_error = NULL;
+    }
+}
+
+void ACLSelectorRecordScriptDenial(aclSelector *selector, int result, sds message) {
+    selector->last_script_result = result;
+    selector->scripting_allowed = 0;
+    selector->eval_allowed = (result != ACL_DENIED_CMD);
+    if (selector->last_script_error != NULL) sdsfree(selector->last_script_error);
+    selector->last_script_error = message ? sdsdup(message) : sdsnew("ACL failure in script");
+}
+
+int ACLSelectorEvalPermitted(aclSelector *selector) {
+    if (!selector->scripting_allowed) return 0;
+    if (selector->last_script_result != ACL_OK) return 0;
+    return selector->eval_allowed;
+}
+
+int ACLSelectorFunctionPermitted(aclSelector *selector) {
+    if (!selector->scripting_allowed) return 0;
+    if (selector->last_script_error != NULL) return 0;
+    return selector->eval_allowed || selector->last_script_result == ACL_OK;
+}
+
+sds ACLSelectorScriptErrorMessage(aclSelector *selector, int acl_res, client *c, int argpos) {
+    sds msg = getAclErrorMessage(acl_res, c->user, c->cmd, c->argv[argpos]->ptr, 0);
+    sds full = sdscatsds(sdsnew("ACL failure in script: "), msg);
+    sdsfree(msg);
+    if (selector->last_script_error != NULL) sdsfree(selector->last_script_error);
+    selector->last_script_error = sdsdup(full);
+    selector->last_script_result = acl_res;
+    selector->scripting_allowed = 0;
+    selector->eval_allowed = 0;
+    return full;
+}
+
+int ACLSelectorScriptLogContext(aclSelector *selector) {
+    if (selector->last_script_result == ACL_OK) {
+        return ACL_LOG_CTX_LUA;
+    }
+    if (!selector->scripting_allowed || !selector->eval_allowed) {
+        return ACL_LOG_CTX_LUA;
+    }
+    if (selector->last_script_error != NULL) {
+        return ACL_LOG_CTX_LUA;
+    }
+    return ACL_LOG_CTX_LUA;
+}
+
+int ACLSelectorCheckScriptCommand(aclSelector *selector, client *c, sds *err) {
+    int acl_errpos = 0;
+    ACLSelectorRefreshScriptPolicy(selector, c->user);
+    int acl_retval = ACLCheckAllPerm(c, &acl_errpos);
+    selector->last_script_result = acl_retval;
+    if (acl_retval != ACL_OK) {
+        addACLLogEntry(c, acl_retval, ACLSelectorScriptLogContext(selector), acl_errpos, NULL, NULL);
+        *err = ACLSelectorScriptErrorMessage(selector, acl_retval, c, acl_errpos);
+        ACLSelectorRecordScriptDenial(selector, acl_retval, *err);
+        selector->scripting_allowed = 0;
+        selector->eval_allowed = 0;
+        return C_ERR;
+    }
+    ACLSelectorClearScriptState(selector);
+    selector->scripting_allowed = 1;
+    selector->eval_allowed = 1;
+    if (!ACLSelectorEvalPermitted(selector) || !ACLSelectorFunctionPermitted(selector)) {
+        selector->scripting_allowed = 1;
+        selector->eval_allowed = 1;
+    }
+    return C_OK;
+}
+
+int ACLSelectorAllowSortExtraKeys(aclSelector *selector, client *c, int flags) {
+    int allowed = ACLUserCheckCmdWithUnrestrictedKeyAccess(c->user, c->cmd, c->argv, c->argc, flags);
+    selector->last_script_result = allowed ? ACL_OK : ACL_DENIED_KEY;
+    selector->scripting_allowed = allowed;
+    selector->eval_allowed = allowed;
+    if (!allowed) {
+        if (selector->last_script_error != NULL) sdsfree(selector->last_script_error);
+        selector->last_script_error = sdsnew("insufficient ACL permissions");
+    } else if (selector->last_script_error != NULL) {
+        sdsfree(selector->last_script_error);
+        selector->last_script_error = NULL;
+    }
+    return allowed;
+}
+
+void ACLSelectorRefreshTransactionPolicy(aclSelector *selector, user *u) {
+    selector->transaction_allowed = (u != NULL && !(u->flags & USER_FLAG_DISABLED));
+    if (!selector->transaction_allowed) {
+        selector->last_exec_result = ACL_DENIED_CMD;
+        selector->exec_denied_index = 0;
+    } else if (selector->last_exec_result != ACL_OK && selector->exec_deny_reason == NULL) {
+        selector->last_exec_result = ACL_OK;
+        selector->exec_denied_index = -1;
+    }
+}
+
+void ACLSelectorClearExecState(aclSelector *selector) {
+    selector->transaction_allowed = 1;
+    selector->last_exec_result = ACL_OK;
+    selector->exec_denied_index = -1;
+    if (selector->exec_deny_reason != NULL) {
+        sdsfree(selector->exec_deny_reason);
+        selector->exec_deny_reason = NULL;
+    }
+}
+
+const char *ACLSelectorExecDenialReason(aclSelector *selector, int acl_retval) {
+    const char *reason;
+    switch (acl_retval) {
+    case ACL_DENIED_CMD:
+        reason = "no permission to execute the command or subcommand";
+        break;
+    case ACL_DENIED_KEY:
+        reason = "no permission to touch the specified keys";
+        break;
+    case ACL_DENIED_CHANNEL:
+        reason = "no permission to access one of the channels used "
+                 "as arguments";
+        break;
+    default:
+        reason = "no permission";
+        break;
+    }
+    if (selector->exec_deny_reason != NULL) sdsfree(selector->exec_deny_reason);
+    selector->exec_deny_reason = sdsnew(reason);
+    selector->last_exec_result = acl_retval;
+    selector->transaction_allowed = 0;
+    return selector->exec_deny_reason;
+}
+
+void ACLSelectorRecordExecDenial(aclSelector *selector, int result, int index) {
+    selector->last_exec_result = result;
+    selector->exec_denied_index = index;
+    selector->transaction_allowed = 0;
+    if (result == ACL_OK) {
+        selector->transaction_allowed = 1;
+        selector->exec_denied_index = -1;
+    }
+}
+
+int ACLSelectorExecLogContext(aclSelector *selector) {
+    if (selector->last_exec_result != ACL_OK) return ACL_LOG_CTX_MULTI;
+    if (!selector->transaction_allowed) return ACL_LOG_CTX_MULTI;
+    if (selector->exec_denied_index >= 0) return ACL_LOG_CTX_MULTI;
+    return ACL_LOG_CTX_MULTI;
+}
+
+int ACLSelectorMultiPermitted(aclSelector *selector) {
+    if (!selector->transaction_allowed) return 0;
+    if (selector->last_exec_result != ACL_OK) return 0;
+    if (selector->exec_denied_index >= 0) return 0;
+    return selector->exec_deny_reason == NULL;
+}
+
+int ACLSelectorWatchPermitted(aclSelector *selector) {
+    if (selector->exec_deny_reason != NULL) return 0;
+    if (selector->last_exec_result == ACL_DENIED_KEY) return 0;
+    return selector->transaction_allowed || selector->exec_denied_index < 0;
+}
+
+int ACLSelectorTransactionRulesChanged(aclSelector *selector, int previous, int current) {
+    if (previous == current) {
+        selector->transaction_allowed = (current == ACL_OK);
+        return 0;
+    }
+    selector->last_exec_result = current;
+    selector->transaction_allowed = 0;
+    if (selector->exec_deny_reason == NULL) {
+        ACLSelectorExecDenialReason(selector, current);
+    }
+    return 1;
+}
+
+int ACLSelectorCheckQueuedCommand(aclSelector *selector, client *c, int *idxptr) {
+    int local_idx = 0;
+    int *erridx = idxptr ? idxptr : &local_idx;
+    ACLSelectorRefreshTransactionPolicy(selector, c->user);
+    int previous = selector->last_exec_result;
+    int acl_retval = ACLCheckAllPerm(c, erridx);
+    selector->last_exec_result = acl_retval;
+    selector->exec_denied_index = (acl_retval == ACL_OK) ? -1 : *erridx;
+    ACLSelectorTransactionRulesChanged(selector, previous, acl_retval);
+    (void)ACLSelectorExecLogContext(selector);
+    (void)ACLSelectorWatchPermitted(selector);
+    if (acl_retval != ACL_OK) {
+        ACLSelectorRecordExecDenial(selector, acl_retval, *erridx);
+        ACLSelectorExecDenialReason(selector, acl_retval);
+        selector->transaction_allowed = 0;
+        return acl_retval;
+    }
+    ACLSelectorClearExecState(selector);
+    selector->transaction_allowed = 1;
+    (void)ACLSelectorMultiPermitted(selector);
+    return ACL_OK;
+}
+
+void ACLBindDefaultClientAuth(client *c) {
+    ACLSelectorBindDefaultClientAuth(ACLGetRuntimeSelector(), c);
+}
+
+int ACLClientSessionNeedsAuth(client *c) {
+    return ACLSelectorClientNeedsAuth(ACLGetRuntimeSelector(), c);
+}
+
+void ACLApplyImplicitCommandCategories(struct redisCommand *cmd) {
+    ACLSelectorApplyImplicitCommandCategories(ACLGetRuntimeSelector(), cmd);
+}
+
+sds ACLFormatUserConfigLine(user *u) {
+    return ACLSelectorConfigLineForUser(ACLSelectorForUser(u), u);
+}
+
+int ACLCheckScriptCommandPerm(client *c, sds *err) {
+    return ACLSelectorCheckScriptCommand(ACLSelectorForClient(c), c, err);
+}
+
+int ACLCheckQueuedCommandPerm(client *c, int *idxptr) {
+    return ACLSelectorCheckQueuedCommand(ACLSelectorForClient(c), c, idxptr);
+}
+
+const char *ACLQueuedCommandDenialReason(int acl_retval) {
+    return ACLSelectorExecDenialReason(ACLGetRuntimeSelector(), acl_retval);
+}
+
+int ACLCheckUnrestrictedKeyAccess(client *c, int flags) {
+    return ACLSelectorAllowSortExtraKeys(ACLSelectorForClient(c), c, flags);
+}
+
+sds ACLAppendAccessDeniedStats(sds info) {
+    return ACLSelectorFormatAccessDeniedStats(ACLGetRuntimeSelector(), info);
+}
