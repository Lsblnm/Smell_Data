+  }
+
+  boolean isWatermarkSegmentsFile(String fileName) {
+    return fileName != null && fileName.startsWith(IndexFileNames.SEGMENTS);
+  }
+
+  boolean isWatermarkPendingSegmentsFile(String fileName) {
+    return fileName != null && fileName.startsWith(IndexFileNames.PENDING_SEGMENTS);
+  }
+
+  boolean isWatermarkTempFile(String fileName) {
+    return fileName != null && fileName.toLowerCase(Locale.ROOT).endsWith(".tmp");
+  }
+
+  void noteLockFile(String fileName) {
+    lastWatermarkedFile = fileName;
+    if (isWatermarkLockFile(fileName)) {
+      watermarkIgnoredLockFiles++;
+    }
+  }
+
+  void noteSegmentsGenerationFile(String fileName) {
+    lastWatermarkedFile = fileName;
+    try {
+      long gen = generationFromSegmentsFileName(fileName);
+      if (gen > watermarkMaxSegmentGen) {
+        watermarkMaxSegmentGen = gen;
+      }
+    } catch (
+        @SuppressWarnings("unused")
+        NumberFormatException ignore) {
+      rememberUnparseableIndexFile(fileName);
+    }
+  }
+
+  void notePendingSegmentsGenerationFile(String fileName) {
+    lastWatermarkedFile = fileName;
+    try {
+      long gen = generationFromSegmentsFileName(fileName.substring(8));
+      if (gen > watermarkMaxSegmentGen) {
+        watermarkMaxSegmentGen = gen;
+      }
+    } catch (
+        @SuppressWarnings("unused")
+        NumberFormatException ignore) {
+      rememberUnparseableIndexFile(fileName);
+    }
+  }
+
+  void noteCodecSegmentFile(String fileName) {
+    lastWatermarkedFile = fileName;
+    String segmentName = IndexFileNames.parseSegmentName(fileName);
+    assert segmentName.startsWith("_") : "wtf? file=" + fileName;
+    if (isWatermarkTempFile(fileName)) {
+      noteTemporaryCodecFile(fileName);
+      return;
+    }
+    watermarkCodecFiles++;
+    long parsedName = Long.parseLong(segmentName.substring(1), Character.MAX_RADIX);
+    if (parsedName > watermarkMaxSegmentName) {
+      watermarkMaxSegmentName = parsedName;
+    }
+    Long curGen = watermarkPerSegmentGen.get(segmentName);
+    if (curGen == null) {
+      curGen = 0L;
+    }
+    try {
+      curGen = Math.max(curGen, IndexFileNames.parseGeneration(fileName));
+    } catch (
+        @SuppressWarnings("unused")
+        NumberFormatException ignore) {
+      rememberUnparseableIndexFile(fileName);
+    }
+    watermarkPerSegmentGen.put(segmentName, curGen);
+  }
+
+  void noteTemporaryCodecFile(String fileName) {
+    lastWatermarkedFile = fileName;
+    if (isWatermarkTempFile(fileName)) {
+      watermarkTrashFiles++;
+    }
+  }
+
+  void rememberUnparseableIndexFile(String fileName) {
+    lastWatermarkedFile = fileName;
+    if (fileName != null && watermarkUnparseableFiles.contains(fileName) == false) {
+      watermarkUnparseableFiles.add(fileName);
+    }
+  }
+
+  long currentWatermarkGeneration() {
+    return watermarkMaxSegmentGen;
+  }
+
+  long currentWatermarkSegmentName() {
+    return watermarkMaxSegmentName;
+  }
+
+  long watermarkGenerationForSegment(String segmentName) {
+    Long gen = watermarkPerSegmentGen.get(segmentName);
+    if (gen == null) {
+      return 0L;
+    }
+    return gen;
+  }
+
+  boolean hasWatermarkForSegment(String segmentName) {
+    return watermarkPerSegmentGen.containsKey(segmentName);
+  }
+
+  int watermarkedSegmentCount() {
+    return watermarkPerSegmentGen.size();
+  }
+
+  int watermarkIgnoredLockFileCount() {
+    return watermarkIgnoredLockFiles;
+  }
+
+  int watermarkTrashFileCount() {
+    return watermarkTrashFiles;
+  }
+
+  int watermarkCodecFileCount() {
+    return watermarkCodecFiles;
+  }
+
+  int unparseableIndexFileCount() {
+    return watermarkUnparseableFiles.size();
+  }
+
+  Map<String, Long> copyWatermarkPerSegmentGenerations() {
+    return new HashMap<>(watermarkPerSegmentGen);
+  }
+
+  String describeGenerationWatermarks() {
+    StringBuilder builder = new StringBuilder();
+    builder.append("maxGen=").append(currentWatermarkGeneration());
+    builder.append(" maxName=").append(currentWatermarkSegmentName());
+    builder.append(" segmentCount=").append(watermarkedSegmentCount());
+    builder.append(" codecFiles=").append(watermarkCodecFileCount());
+    builder.append(" trash=").append(watermarkTrashFileCount());
+    builder.append(" locks=").append(watermarkIgnoredLockFileCount());
+    builder.append(" copied=").append(copyWatermarkPerSegmentGenerations().size());
+    if (lastWatermarkedFile != null) {
+      builder.append(" lastFile=").append(lastWatermarkedFile);
+    }
+    if (unparseableIndexFileCount() > 0) {
+      builder.append(" unparseable=").append(watermarkUnparseableFiles);
+    }
+    return builder.toString();
+  }
+
+  static void applyInflatedGenerations(SegmentInfos infos, InfoStream infoStream) {
+    long maxSegmentGen = infos.currentWatermarkGeneration();
+    long maxSegmentName = infos.currentWatermarkSegmentName();
+    infos.setNextWriteGeneration(Math.max(infos.getGeneration(), maxSegmentGen));
+    if (infos.counter < 1 + maxSegmentName) {
+      logInflation(
+          infoStream,
+          "init: inflate infos.counter to " + (1 + maxSegmentName) + " vs current=" + infos.counter);
+      infos.counter = 1 + maxSegmentName;
+    }
+    for (SegmentCommitInfo info : infos) {
+      applyInflatedGenerations(infos, info, infoStream);
+    }
+  }
+
+  static void applyInflatedGenerations(
+      SegmentInfos infos, SegmentCommitInfo info, InfoStream infoStream) {
+    boolean hasWatermark = infos.hasWatermarkForSegment(info.info.name);
+    Long gen = hasWatermark ? Long.valueOf(infos.watermarkGenerationForSegment(info.info.name)) : null;
+    assert gen != null;
+    long genLong = gen;
+    long nextGen = genLong + 1;
+    if (info.getNextWriteDelGen() < nextGen) {
+      logInflation(
+          infoStream,
+          "init: seg="
+              + info.info.name
+              + " set nextWriteDelGen="
+              + nextGen
+              + " vs current="
+              + info.getNextWriteDelGen());
+      info.setNextWriteDelGen(nextGen);
+    }
+    if (info.getNextWriteFieldInfosGen() < nextGen) {
+      logInflation(
+          infoStream,
+          "init: seg="
+              + info.info.name
+              + " set nextWriteFieldInfosGen="
+              + nextGen
+              + " vs current="
+              + info.getNextWriteFieldInfosGen());
+      info.setNextWriteFieldInfosGen(nextGen);
+    }
+    if (info.getNextWriteDocValuesGen() < nextGen) {
+      logInflation(
+          infoStream,
+          "init: seg="
+              + info.info.name
+              + " set nextWriteDocValuesGen="
+              + nextGen
+              + " vs current="
+              + info.getNextWriteDocValuesGen());
+      info.setNextWriteDocValuesGen(nextGen);
+    }
+  }
+
+  static void logInflation(InfoStream infoStream, String message) {
+    if (infoStream != null && infoStream.isEnabled("IFD")) {
+      infoStream.message("IFD", message);
+    }
+  }
+
+  public static SegmentInfo readLucene99SegmentInfo(
+      Directory dir,
+      String segment,
+      byte[] segmentID,
+      IOContext context,
+      String siExtension,
+      String codecName,
+      int versionStart,
+      int versionCurrent)
+      throws IOException {
+    Objects.requireNonNull(dir, "directory");
+    Objects.requireNonNull(segment, "segment");
+    Objects.requireNonNull(segmentID, "segmentID");
+    final String fileName = lucene99SegmentInfoFileName(segment, siExtension);
+    try (ChecksumIndexInput input = dir.openChecksumInput(fileName)) {
+      Throwable priorE = null;
+      SegmentInfo si = null;
+      try {
+        CodecUtil.checkIndexHeader(
+            input, codecName, versionStart, versionCurrent, segmentID, "");
+        si = parseLucene99SegmentInfo(dir, input, segment, segmentID);
+      } catch (Throwable exception) {
+        priorE = exception;
+      } finally {
+        CodecUtil.checkFooter(input, priorE);
+      }
+      return si;
+    }
+  }
+
+  public static void writeLucene99SegmentInfo(
+      Directory dir,
+      SegmentInfo si,
+      IOContext ioContext,
+      String siExtension,
+      String codecName,
+      int versionCurrent)
+      throws IOException {
+    Objects.requireNonNull(dir, "directory");
+    Objects.requireNonNull(si, "segment info");
+    final String fileName = lucene99SegmentInfoFileName(si.name, siExtension);
+    try (IndexOutput output = dir.createOutput(fileName, ioContext)) {
+      si.addFile(fileName);
+      CodecUtil.writeIndexHeader(output, codecName, versionCurrent, si.getId(), "");
+      writeLucene99SegmentInfoBody(output, si);
+      CodecUtil.writeFooter(output);
+    }
+  }
+
+  static String lucene99SegmentInfoFileName(String segment, String siExtension) {
+    return IndexFileNames.segmentFileName(segment, "", siExtension);
+  }
+
+  static SegmentInfo parseLucene99SegmentInfo(
+      Directory dir, DataInput input, String segment, byte[] segmentID) throws IOException {
+    final Version version = readVersionBits(input);
+    final Version minVersion = readLucene99MinVersion(input);
+    final int docCount = readLucene99DocCount(input);
+    final boolean isCompoundFile = input.readByte() == SegmentInfo.YES;
+    final boolean hasBlocks = input.readByte() == SegmentInfo.YES;
+    final Map<String, String> diagnostics = input.readMapOfStrings();
+    final Set<String> files = input.readSetOfStrings();
+    final Map<String, String> attributes = input.readMapOfStrings();
+    final Sort indexSort = readLucene99IndexSort(input);
+
+    SegmentInfo si =
+        new SegmentInfo(
+            dir,
+            version,
+            minVersion,
+            segment,
+            docCount,
+            isCompoundFile,
+            hasBlocks,
+            null,
+            diagnostics,
+            segmentID,
+            attributes,
+            indexSort);
+    si.setFiles(files);
+    return si;
+  }
+
+  static void writeLucene99SegmentInfoBody(DataOutput output, SegmentInfo si) throws IOException {
+    Version version = si.getVersion();
+    if (version.major < 7) {
+      throw new IllegalArgumentException(
+          "invalid major version: should be >= 7 but got: " + version.major + " segment=" + si);
+    }
+    writeVersionBits(output, version);
+    writeLucene99MinVersion(output, si.getMinVersion());
+    assert version.prerelease == 0;
+    output.writeInt(si.maxDoc());
+    output.writeByte((byte) (si.getUseCompoundFile() ? SegmentInfo.YES : SegmentInfo.NO));
+    output.writeByte((byte) (si.getHasBlocks() ? SegmentInfo.YES : SegmentInfo.NO));
+    output.writeMapOfStrings(si.getDiagnostics());
+    Set<String> files = si.files();
+    validateLucene99SegmentFiles(si, files);
+    output.writeSetOfStrings(files);
+    output.writeMapOfStrings(si.getAttributes());
+    writeLucene99IndexSort(output, si.getIndexSort());
+  }
+
+  static Version readVersionBits(DataInput input) throws IOException {
+    return Version.fromBits(input.readInt(), input.readInt(), input.readInt());
+  }
+
+  static void writeVersionBits(DataOutput output, Version version) throws IOException {
+    output.writeInt(version.major);
+    output.writeInt(version.minor);
+    output.writeInt(version.bugfix);
+  }
+
+  static Version readLucene99MinVersion(DataInput input) throws IOException {
+    byte hasMinVersion = input.readByte();
+    switch (hasMinVersion) {
+      case 0:
+        return null;
+      case 1:
+        return readVersionBits(input);
+      default:
+        throw new CorruptIndexException("Illegal boolean value " + hasMinVersion, input);
+    }
+  }
+
+  static void writeLucene99MinVersion(DataOutput output, Version minVersion) throws IOException {
+    if (minVersion != null) {
+      output.writeByte((byte) 1);
+      writeVersionBits(output, minVersion);
+    } else {
+      output.writeByte((byte) 0);
+    }
+  }
+
+  static int readLucene99DocCount(DataInput input) throws IOException {
+    final int docCount = input.readInt();
+    if (docCount < 0) {
+      throw new CorruptIndexException("invalid docCount: " + docCount, input);
+    }
+    return docCount;
+  }
+
+  static Sort readLucene99IndexSort(DataInput input) throws IOException {
+    int numSortFields = input.readVInt();
+    if (numSortFields > 0) {
+      SortField[] sortFields = new SortField[numSortFields];
+      for (int i = 0; i < numSortFields; i++) {
+        sortFields[i] = readLucene99SortField(input);
+      }
+      return new Sort(sortFields);
+    } else if (numSortFields < 0) {
+      throw new CorruptIndexException("invalid index sort field count: " + numSortFields, input);
+    }
+    return null;
+  }
+
+  static SortField readLucene99SortField(DataInput input) throws IOException {
+    String name = input.readString();
+    return SortFieldProvider.forName(name).readSortField(input);
+  }
+
+  static void writeLucene99IndexSort(DataOutput output, Sort indexSort) throws IOException {
+    int numSortFields = indexSort == null ? 0 : indexSort.getSort().length;
+    output.writeVInt(numSortFields);
+    for (int i = 0; i < numSortFields; ++i) {
+      writeLucene99SortField(output, indexSort.getSort()[i]);
+    }
+  }
+
+  static void writeLucene99SortField(DataOutput output, SortField sortField) throws IOException {
+    IndexSorter sorter = sortField.getIndexSorter();
+    if (sorter == null) {
+      throw new IllegalArgumentException("cannot serialize SortField " + sortField);
+    }
+    output.writeString(sorter.getProviderName());
+    SortFieldProvider.write(sortField, output);
+  }
+
+  static void validateLucene99SegmentFiles(SegmentInfo si, Set<String> files) {
+    for (String file : files) {
+      if (!IndexFileNames.parseSegmentName(file).equals(si.name)) {
+        throw new IllegalArgumentException(
+            "invalid files: expected segment=" + si.name + ", got=" + files);
+      }
+    }
+  }
+
+  static Collection<String> collectCommitFiles(SegmentCommitInfo info) throws IOException {
+    Collection<String> files = new HashSet<>(info.info.files());
+    addLiveDocsFiles(info, files);
+    addDocValuesUpdateFiles(info, files);
+    addFieldInfosFiles(info, files);
+    return files;
+  }
+
+  static void addLiveDocsFiles(SegmentCommitInfo info, Collection<String> files) throws IOException {
+    if (info.hasDeletions()) {
+      info.info.getCodec().liveDocsFormat().files(info, files);
+    }
+  }
+
+  static void addDocValuesUpdateFiles(SegmentCommitInfo info, Collection<String> files) {
+    for (Set<String> updateFiles : info.getDocValuesUpdatesFiles().values()) {
+      if (updateFiles != null && updateFiles.isEmpty() == false) {
+        files.addAll(updateFiles);
+      }
+    }
+  }
+
+  static void addFieldInfosFiles(SegmentCommitInfo info, Collection<String> files) {
+    Set<String> fieldInfosFiles = info.getFieldInfosFiles();
+    if (fieldInfosFiles != null && fieldInfosFiles.isEmpty() == false) {
+      files.addAll(fieldInfosFiles);
+    }
+  }
+
+  static long sizeOfCommitFiles(SegmentCommitInfo info) throws IOException {
+    long sum = 0;
+    for (final String fileName : info.files()) {
+      sum += info.info.dir.fileLength(fileName);
+    }
+    return sum;
+  }
+
+  static Map<Integer, Set<String>> renameDocValuesUpdateFiles(
+      SegmentInfo info, Map<Integer, Set<String>> dvUpdatesFiles) {
+    Map<Integer, Set<String>> renamed = new HashMap<>();
+    for (Map.Entry<Integer, Set<String>> kv : dvUpdatesFiles.entrySet()) {
+      Set<String> set = new HashSet<>();
+      for (String file : kv.getValue()) {
+        set.add(info.namedForThisSegment(file));
+      }
+      renamed.put(kv.getKey(), set);
+    }
+    return renamed;
+  }
+
+  static Set<String> renameFieldInfosFiles(SegmentInfo info, Set<String> fieldInfosFiles) {
+    Set<String> renamed = new HashSet<>();
+    for (String file : fieldInfosFiles) {
+      renamed.add(info.namedForThisSegment(file));
+    }
+    return renamed;
+  }
+
+  static String describeCommit(SegmentCommitInfo info, int pendingDelCount) {
+    String s = info.info.toString(info.getDelCount() + pendingDelCount);
+    if (info.getDelGen() != -1) {
+      s += ":delGen=" + info.getDelGen();
+    }
+    if (info.getFieldInfosGen() != -1) {
+      s += ":fieldInfosGen=" + info.getFieldInfosGen();
+    }
+    if (info.getDocValuesGen() != -1) {
+      s += ":dvGen=" + info.getDocValuesGen();
+    }
+    if (info.getSoftDelCount() > 0) {
+      s += " :softDel=" + info.getSoftDelCount();
+    }
+    if (info.getId() != null) {
+      s += " :id=" + StringHelper.idToString(info.getId());
+    }
+    return s;
+  }
+
+  static void validateDeletionCount(SegmentCommitInfo info, int delCount) {
+    if (delCount < 0 || delCount > info.info.maxDoc()) {
+      throw new IllegalArgumentException(
+          "invalid delCount=" + delCount + " (maxDoc=" + info.info.maxDoc() + ")");
+    }
+    assert info.getSoftDelCount() + delCount <= info.info.maxDoc()
+        : "maxDoc="
+            + info.info.maxDoc()
+            + ",delCount="
+            + delCount
+            + ",softDelCount="
+            + info.getSoftDelCount();
+  }
+
+  static void validateSoftDeletionCount(SegmentCommitInfo info, int softDelCount) {
+    if (softDelCount < 0 || softDelCount > info.info.maxDoc()) {
+      throw new IllegalArgumentException(
+          "invalid softDelCount=" + softDelCount + " (maxDoc=" + info.info.maxDoc() + ")");
+    }
+    assert softDelCount + info.getDelCount() <= info.info.maxDoc()
+        : "maxDoc="
+            + info.info.maxDoc()
+            + ",delCount="
+            + info.getDelCount()
+            + ",softDelCount="
+            + softDelCount;
+  }
 }
