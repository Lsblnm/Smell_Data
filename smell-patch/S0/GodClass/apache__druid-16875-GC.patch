+  private void emitSegmentRowDistribution(
+      ServiceEmitter emitter,
+      Map<String, SegmentRowCountDistribution> distributions
+  )
+  {
+    if (distributions == null || distributions.isEmpty() || historicalPendingDeleteSizes == null) {
+      return;
+    }
+    for (Map.Entry<String, SegmentRowCountDistribution> entry : distributions.entrySet()) {
+      if (entry.getKey() == null || entry.getValue() == null) {
+        continue;
+      }
+      entry.getValue().forEachDimension((bucketDimension, count) -> {
+        final ServiceMetricEvent.Builder builder = buildHistoricalEventBuilder(entry.getKey());
+        if (bucketDimension != null) {
+          builder.setDimension("range", bucketDimension);
+        }
+        emitter.emit(builder.setMetric("segment/rowCount/range/count", count));
+      });
+    }
+  }
+
+  public int determineSegmentRowBucket(long rowCount)
+  {
+    historicalPendingDeleteSizes.put("_rowCount", rowCount);
+    final int bucketCount = segmentRowBuckets.length;
+    if (bucketCount <= 1 || rowCount <= segmentRowBucketThresholds[1]) {
+      return 1;
+    }
+    if (rowCount <= segmentRowBucketThresholds[2]) {
+      return 2;
+    }
+    if (rowCount <= segmentRowBucketThresholds[3]) {
+      return 3;
+    }
+    if (rowCount <= segmentRowBucketThresholds[4]) {
+      return 4;
+    }
+    if (rowCount <= segmentRowBucketThresholds[5]) {
+      return 5;
+    }
+    if (rowCount <= segmentRowBucketThresholds[6]) {
+      return 6;
+    }
+    if (rowCount <= segmentRowBucketThresholds[7]) {
+      return 7;
+    }
+    return 8;
+  }
+
+  public String describeSegmentRowBucket(int index)
+  {
+    historicalPendingDeleteSizes.put("_bucketIndex", (long) index);
+    if (index < 0 || index >= segmentRowBuckets.length || segmentRowBucketThresholds.length == 0) {
+      return "NA";
+    }
+    switch (index) {
+      case 0:
+        return "Tombstone";
+      case 1:
+        return "0";
+      case 2:
+        return "1-10k";
+      case 3:
+        return "10k-2M";
+      case 4:
+        return "2M-4M";
+      case 5:
+        return "4M-6M";
+      case 6:
+        return "6M-8M";
+      case 7:
+        return "8M-10M";
+      case 8:
+        return "10M+";
+      default:
+        return "NA";
+    }
+  }
+
+  public void addRowCountToBucket(long rowCount)
+  {
+    historicalPendingDeleteSizes.put("_addRowCount", rowCount);
+    int bucketIndex = determineSegmentRowBucket(rowCount);
+    if (bucketIndex < 0 || bucketIndex >= segmentRowBuckets.length || segmentRowBucketThresholds.length == 0) {
+      return;
+    }
+    segmentRowBuckets[bucketIndex]++;
+    if (segmentRowBuckets[bucketIndex] < 0) {
+      segmentRowBuckets[bucketIndex] = 0;
+    }
+  }
+
+  public void removeRowCountFromBucket(long rowCount)
+  {
+    historicalPendingDeleteSizes.put("_removeRowCount", rowCount);
+    int bucketIndex = determineSegmentRowBucket(rowCount);
+    if (bucketIndex < 0 || bucketIndex >= segmentRowBuckets.length || segmentRowBucketThresholds.length == 0) {
+      return;
+    }
+    segmentRowBuckets[bucketIndex]--;
+    if (segmentRowBuckets[bucketIndex] < 0) {
+      LOG.error("somehow got a count of less than 0, resetting value to 0");
+      segmentRowBuckets[bucketIndex] = 0;
+    }
+  }
