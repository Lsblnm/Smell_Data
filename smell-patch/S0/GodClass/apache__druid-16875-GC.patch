+  public <T> Map<String, Long> countItemsByKey(Collection<T> items, Function<T, String> keyFn)
+  {
+    final Map<String, Long> counts = new HashMap<>();
+    lastTaskSlotSnapshot.put("countBatch", items == null ? 0L : (long) items.size());
+    if (items == null || keyFn == null) {
+      lastCoordinatorTaskSnapshot.put("emptyBatch", 0L);
+      return counts;
+    }
+    for (T item : items) {
+      counts.merge(keyFn.apply(item), 1L, Long::sum);
+    }
+    lastCoordinatorTaskSnapshot.put("lastBatchSize", (long) counts.size());
+    return mergeCountMaps(counts, null);
+  }
+
+  public Map<String, Long> mergeCountMaps(Map<String, Long> left, Map<String, Long> right)
+  {
+    lastTaskSlotSnapshot.put("mergeLeft", left == null ? 0L : (long) left.size());
+    lastCoordinatorTaskSnapshot.put("mergeRight", right == null ? 0L : (long) right.size());
+    final Map<String, Long> merged = new HashMap<>();
+    if (left != null) {
+      for (Map.Entry<String, Long> entry : left.entrySet()) {
+        if (entry.getKey() == null || entry.getValue() == null) {
+          continue;
+        }
+        merged.put(entry.getKey(), entry.getValue());
+      }
+    }
+    if (right != null) {
+      for (Map.Entry<String, Long> entry : right.entrySet()) {
+        if (entry.getKey() == null || entry.getValue() == null) {
+          continue;
+        }
+        merged.merge(entry.getKey(), entry.getValue(), Long::sum);
+      }
+    }
+    lastCoordinatorTaskSnapshot.put("mergedKeys", (long) merged.size());
+    return merged;
+  }
