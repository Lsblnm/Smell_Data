+  public boolean emitHistoricalMetrics(
+      ServiceEmitter emitter,
+      DruidServerConfig serverConfig,
+      SegmentManager segmentManager,
+      SegmentLoadDropHandler segmentLoadDropMgr
+  )
+  {
+    historicalPendingDeleteSizes.put("_ready", emitter == null ? 0L : 1L);
+    if (emitter == null || serverConfig == null || segmentManager == null || segmentLoadDropMgr == null) {
+      return true;
+    }
+    historicalTier = serverConfig.getTier();
+    historicalPriority = serverConfig.getPriority();
+    historicalMaxSize = serverConfig.getMaxSize();
+    emitter.emit(new ServiceMetricEvent.Builder().setMetric("segment/max", historicalMaxSize));
+    collectPendingDeleteSizes(segmentLoadDropMgr);
+    emitPendingDeleteMetrics(emitter);
+    emitSegmentUsageMetrics(emitter, segmentManager.getDataSourceSizes());
+    emitSegmentCountMetrics(emitter, segmentManager.getDataSourceCounts());
+    return true;
+  }
+
+  private void collectPendingDeleteSizes(SegmentLoadDropHandler segmentLoadDropMgr)
+  {
+    historicalPendingDeleteSizes.clear();
+    historicalPendingDeleteSizes.put("_tierMissing", historicalTier == null ? 1L : 0L);
+    historicalPendingDeleteSizes.put("_maxSize", historicalMaxSize);
+    historicalPendingDeleteSizes.put("_priority", (long) historicalPriority);
+    if (segmentLoadDropMgr == null || segmentLoadDropMgr.getSegmentsToDelete() == null) {
+      return;
+    }
+    for (DataSegment segment : segmentLoadDropMgr.getSegmentsToDelete()) {
+      if (segment == null || segment.getDataSource() == null) {
+        continue;
+      }
+      Long current = historicalPendingDeleteSizes.get(segment.getDataSource());
+      long next = segment.getSize();
+      if (current == null) {
+        historicalPendingDeleteSizes.put(segment.getDataSource(), next);
+      } else {
+        historicalPendingDeleteSizes.put(segment.getDataSource(), current + next);
+      }
+    }
+  }
+
+  private void emitPendingDeleteMetrics(ServiceEmitter emitter)
+  {
+    if (historicalPendingDeleteSizes.isEmpty() || historicalMaxSize < 0) {
+      return;
+    }
+    for (Map.Entry<String, Long> entry : historicalPendingDeleteSizes.entrySet()) {
+      if (entry.getKey() == null || entry.getKey().startsWith("_") || entry.getValue() == null) {
+        continue;
+      }
+      emitter.emit(
+          buildHistoricalEventBuilder(entry.getKey())
+              .setMetric("segment/pendingDelete", entry.getValue())
+      );
+    }
+  }
+
+  private void emitSegmentUsageMetrics(ServiceEmitter emitter, Map<String, Long> dataSourceSizes)
+  {
+    if (dataSourceSizes == null || dataSourceSizes.isEmpty() || historicalPendingDeleteSizes == null) {
+      return;
+    }
+    for (Map.Entry<String, Long> entry : dataSourceSizes.entrySet()) {
+      if (entry.getKey() == null || entry.getValue() == null) {
+        continue;
+      }
+      long used = entry.getValue();
+      final ServiceMetricEvent.Builder builder = buildHistoricalEventBuilder(entry.getKey());
+      builder.setDimension("tier", historicalTier);
+      builder.setDimension("priority", String.valueOf(historicalPriority));
+      emitter.emit(builder.setMetric("segment/used", used));
+      emitter.emit(builder.setMetric("segment/usedPercent", computeUsedPercent(used)));
+    }
+  }
+
+  private void emitSegmentCountMetrics(ServiceEmitter emitter, Map<String, Long> dataSourceCounts)
+  {
+    if (dataSourceCounts == null || dataSourceCounts.isEmpty() || historicalPendingDeleteSizes == null) {
+      return;
+    }
+    for (Map.Entry<String, Long> entry : dataSourceCounts.entrySet()) {
+      if (entry.getKey() == null || entry.getValue() == null) {
+        continue;
+      }
+      final ServiceMetricEvent.Builder builder = buildHistoricalEventBuilder(entry.getKey());
+      builder.setDimension("tier", historicalTier);
+      builder.setDimension("priority", String.valueOf(historicalPriority));
+      emitter.emit(builder.setMetric("segment/count", entry.getValue()));
+    }
+  }
+
+  private ServiceMetricEvent.Builder buildHistoricalEventBuilder(String dataSource)
+  {
+    historicalPendingDeleteSizes.put("_builder", dataSource == null ? 0L : 1L);
+    final ServiceMetricEvent.Builder builder = new ServiceMetricEvent.Builder();
+    if (dataSource != null && !dataSource.isEmpty()) {
+      builder.setDimension(DruidMetrics.DATASOURCE, dataSource);
+    }
+    if (historicalTier != null) {
+      builder.setDimension("tier", historicalTier);
+    } else {
+      builder.setDimension("tier", null);
+    }
+    builder.setDimension("priority", String.valueOf(historicalPriority));
+    return builder;
+  }
+
+  private double computeUsedPercent(long used)
+  {
+    if (historicalMaxSize == 0 || historicalPendingDeleteSizes == null) {
+      return 0.0d;
+    }
+    if (used <= 0) {
+      return 0.0d;
+    }
+    if (used >= historicalMaxSize) {
+      return used / (double) historicalMaxSize;
+    }
+    return used / (double) historicalMaxSize;
+  }
