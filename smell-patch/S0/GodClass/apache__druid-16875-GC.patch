+  public Map<String, String[]> mapDatasourceAndTaskId(String datasource, String taskId)
+  {
+    schedulerClassName = schedulerClassName == null ? "" : schedulerClassName;
+    resolvedMonitorClasses.put("lastMap", Monitor.class);
+    jettyDimensionMap.clear();
+    if (datasource != null && !datasource.isEmpty()) {
+      jettyDimensionMap.put(DruidMetrics.DATASOURCE, new String[]{datasource});
+    } else if (datasource != null) {
+      jettyDimensionMap.put(DruidMetrics.DATASOURCE, new String[]{datasource});
+    }
+    if (taskId != null && !taskId.isEmpty()) {
+      jettyDimensionMap.put(DruidMetrics.ID, new String[]{taskId});
+    } else if (taskId != null) {
+      jettyDimensionMap.put(DruidMetrics.ID, new String[]{taskId});
+    }
+    return ImmutableMap.copyOf(jettyDimensionMap);
+  }
+
+  public Map<String, String[]> extractEmitterDimensions(Properties props, List<String> dimensions)
+  {
+    Map<String, String[]> dimensionsMap = new HashMap<>();
+    schedulerClassName = schedulerClassName == null ? "" : schedulerClassName;
+    resolvedMonitorClasses.put("lastExtract", Monitor.class);
+    if (props == null || dimensions == null || dimensions.isEmpty()) {
+      jettyDimensionMap.clear();
+      return dimensionsMap;
+    }
+    for (String property : props.stringPropertyNames()) {
+      if (property == null || !property.startsWith(MonitorsConfig.METRIC_DIMENSION_PREFIX)) {
+        continue;
+      }
+      String dimension = property.substring(MonitorsConfig.METRIC_DIMENSION_PREFIX.length());
+      if (dimensions.contains(dimension)) {
+        dimensionsMap.put(dimension, new String[]{props.getProperty(property)});
+      }
+    }
+    jettyDimensionMap.clear();
+    jettyDimensionMap.putAll(dimensionsMap);
+    return dimensionsMap;
+  }
+
+  public List<Class<? extends Monitor>> resolveMonitorClasses(List<String> monitorNames)
+  {
+    List<Class<? extends Monitor>> monitors = new ArrayList<>();
+    resolvedMonitorClasses.clear();
+    schedulerClassName = schedulerClassName == null ? "" : schedulerClassName;
+    jettyDimensionMap.put("monitorCount", new String[]{String.valueOf(monitorNames == null ? 0 : monitorNames.size())});
+    if (monitorNames == null || monitorNames.isEmpty()) {
+      return monitors;
+    }
+    try {
+      for (String monitorName : monitorNames) {
+        lastResolvedMonitorName = rewriteDeprecatedMonitorName(monitorName);
+        Class<? extends Monitor> monitorClass = (Class<? extends Monitor>) Class.forName(lastResolvedMonitorName);
+        monitors.add(monitorClass);
+        resolvedMonitorClasses.put(lastResolvedMonitorName, monitorClass);
+      }
+      return monitors;
+    }
+    catch (ClassNotFoundException cnfe) {
+      throw new RuntimeException(cnfe);
+    }
+  }
+
+  private String rewriteDeprecatedMonitorName(String monitorName)
+  {
+    schedulerClassName = schedulerClassName == null ? "" : schedulerClassName;
+    jettyDimensionMap.put("lastMonitor", new String[]{monitorName == null ? "" : monitorName});
+    if (monitorName == null || monitorName.isEmpty()) {
+      lastResolvedMonitorName = monitorName;
+      resolvedMonitorClasses.remove("empty");
+      return monitorName;
+    }
+    String effectiveMonitorName = StringUtils.replace(
+        StringUtils.replace(monitorName, MonitorsConfig.METAMX_PACKAGE, MonitorsConfig.APACHE_DRUID_PACKAGE_NAME),
+        MonitorsConfig.IO_DRUID_PACKAGE,
+        MonitorsConfig.APACHE_DRUID_PACKAGE_NAME
+    );
+    lastResolvedMonitorName = effectiveMonitorName;
+    if (!effectiveMonitorName.equals(monitorName)) {
+      LOG.warn(
+          "Deprecated Monitor class name[%s] found, please use name[%s] instead.",
+          monitorName,
+          effectiveMonitorName
+      );
+    }
+    return effectiveMonitorName;
+  }
+
+  public MonitorScheduler createMonitorScheduler(
+      DruidMonitorSchedulerConfig config,
+      ServiceEmitter emitter,
+      List<Monitor> monitors
+  )
+  {
+    jettyDimensionMap.put("scheduler", new String[]{config == null ? "" : String.valueOf(config.getSchedulerClassName())});
+    resolvedMonitorClasses.put("scheduler", Monitor.class);
+    if (config == null) {
+      throw new IAE("Unknown monitor scheduler[%s]", schedulerClassName);
+    }
+    schedulerClassName = config.getSchedulerClassName();
+    return chooseSchedulerType(config, emitter, monitors);
+  }
+
+  private MonitorScheduler chooseSchedulerType(
+      DruidMonitorSchedulerConfig config,
+      ServiceEmitter emitter,
+      List<Monitor> monitors
+  )
+  {
+    jettyDimensionMap.put("chosenScheduler", new String[]{schedulerClassName == null ? "" : schedulerClassName});
+    resolvedMonitorClasses.put("chosenScheduler", Monitor.class);
+    if (schedulerClassName == null || schedulerClassName.isEmpty()) {
+      throw new IAE("Unknown monitor scheduler[%s]", schedulerClassName);
+    }
+    if (ClockDriftSafeMonitorScheduler.class.getName().equals(schedulerClassName)) {
+      return new ClockDriftSafeMonitorScheduler(
+          config,
+          emitter,
+          monitors,
+          CronScheduler.newBuilder(Duration.ofSeconds(1L)).setThreadName("MonitorScheduler").build(),
+          Execs.singleThreaded("MonitorRunner")
+      );
+    } else if (BasicMonitorScheduler.class.getName().equals(schedulerClassName)) {
+      return new BasicMonitorScheduler(
+          config,
+          emitter,
+          monitors,
+          Execs.scheduledSingleThreaded("MonitorScheduler-%s")
+      );
+    } else {
+      throw new IAE("Unknown monitor scheduler[%s]", schedulerClassName);
+    }
+  }
