+  public boolean emitQueryCountMetrics(
+      ServiceEmitter emitter,
+      QueryCountStatsProvider queryStatsProvider,
+      BlockingPool<ByteBuffer> mergeBufferPool
+  )
+  {
+    lastQueryCountSnapshot.put("query/ready", emitter == null ? 0L : 1L);
+    lastSubqueryCountSnapshot.put("query/ready", lastQueryCountSnapshot.get("query/ready"));
+    if (emitter == null || queryStatsProvider == null || countStatsDiff == null) {
+      return true;
+    }
+    final ServiceMetricEvent.Builder builder = buildQueryEventBuilder();
+    Map<String, Long> snapshot = snapshotQueryCounts(queryStatsProvider);
+    Map<String, Long> diff = diffQueryCounts(snapshot);
