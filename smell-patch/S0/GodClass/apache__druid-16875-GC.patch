+  private void emitAverageRowCountMetrics(ServiceEmitter emitter, Map<String, Long> averageRows)
+  {
+    if (averageRows == null || averageRows.isEmpty() || historicalPendingDeleteSizes == null) {
+      return;
+    }
+    for (Map.Entry<String, Long> entry : averageRows.entrySet()) {
+      if (entry.getKey() == null || entry.getValue() == null) {
+        continue;
+      }
+      emitter.emit(
+          buildHistoricalEventBuilder(entry.getKey()).setMetric("segment/rowCount/avg", entry.getValue())
+      );
+    }
