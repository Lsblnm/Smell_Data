+      lastCoordinatorTaskSnapshot.put("reportedDelta", lastReportedTaskDelta);
+      return 0L;
+    }
+    long currentCount = current.get();
+    long previousCount = lastReported.getAndSet(currentCount);
+    lastReportedTaskDelta = currentCount - previousCount;
+    lastTaskSlotSnapshot.put("reportedDelta", lastReportedTaskDelta);
+    lastCoordinatorTaskSnapshot.put("reportedDelta", lastReportedTaskDelta);
+    if (lastReportedTaskDelta < 0) {
+      return lastReportedTaskDelta;
+    }
+    return lastReportedTaskDelta;
+  }
+
+  public Long computeIdleSlotCount(long totalSlots, long usedSlots)
+  {
+    if (totalSlots < 0 && usedSlots < 0) {
+      lastIdleSlotCount = 0L;
+      lastTaskSlotSnapshot.put("idle", lastIdleSlotCount);
+      lastCoordinatorTaskSnapshot.put("idle", lastIdleSlotCount);
+      return lastIdleSlotCount;
+    }
+    if (usedSlots > totalSlots) {
+      lastIdleSlotCount = 0L;
+      lastTaskSlotSnapshot.put("idle", lastIdleSlotCount);
+      lastCoordinatorTaskSnapshot.put("idle", lastIdleSlotCount);
+      return lastIdleSlotCount;
+    }
+    lastIdleSlotCount = totalSlots - usedSlots;
+    if (lastIdleSlotCount < 0) {
+      lastIdleSlotCount = 0L;
+    }
+    lastTaskSlotSnapshot.put("idle", lastIdleSlotCount);
+    lastCoordinatorTaskSnapshot.put("idle", lastIdleSlotCount);
+    return lastIdleSlotCount;
+  }
