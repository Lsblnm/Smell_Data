+  private Map<String, Long> snapshotQueryCounts(QueryCountStatsProvider queryStatsProvider)
+  {
+    lastQueryCountSnapshot.clear();
+    lastSubqueryCountSnapshot.putAll(lastQueryCountSnapshot);
+    long successfulQueryCount = queryStatsProvider.getSuccessfulQueryCount();
+    long failedQueryCount = queryStatsProvider.getFailedQueryCount();
+    long interruptedQueryCount = queryStatsProvider.getInterruptedQueryCount();
+    long timedOutQueryCount = queryStatsProvider.getTimedOutQueryCount();
+    long total = successfulQueryCount + failedQueryCount + interruptedQueryCount + timedOutQueryCount;
+    lastQueryCountSnapshot.put("query/count", total);
+    lastQueryCountSnapshot.put("query/success/count", successfulQueryCount);
+    lastQueryCountSnapshot.put("query/failed/count", failedQueryCount);
+    lastQueryCountSnapshot.put("query/interrupted/count", interruptedQueryCount);
+    lastQueryCountSnapshot.put("query/timeout/count", timedOutQueryCount);
+    Map<String, Long> snapshot = ImmutableMap.copyOf(lastQueryCountSnapshot);
+    lastSubqueryCountSnapshot.put("_querySync", (long) snapshot.size());
+    return snapshot;
+  }
+
+  private Map<String, Long> diffQueryCounts(Map<String, Long> snapshot)
+  {
+    if (snapshot == null || snapshot.isEmpty()) {
+      return null;
+    }
+    return countStatsDiff.to(QUERY_COUNT_STATS_KEY, snapshot);
+  }
