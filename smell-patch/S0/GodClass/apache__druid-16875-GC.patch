+  public boolean emitSegmentRowStats(
+      ServiceEmitter emitter,
+      DruidServerConfig serverConfig,
+      Map<String, Long> averageRows,
+      Map<String, SegmentRowCountDistribution> distributions
+  )
+  {
+    historicalPendingDeleteSizes.put("_rowStats", emitter == null ? 0L : 1L);
+    if (emitter == null || serverConfig == null) {
+      return true;
+    }
+    historicalTier = serverConfig.getTier();
+    historicalPriority = serverConfig.getPriority();
+    historicalMaxSize = serverConfig.getMaxSize();
+    emitAverageRowCountMetrics(emitter, averageRows);
+    emitSegmentRowDistribution(emitter, distributions);
+    if (averageRows != null) {
+      for (Long averageSize : averageRows.values()) {
+        if (averageSize != null) {
+          addRowCountToBucket(averageSize);
+          removeRowCountFromBucket(averageSize);
+        }
+      }
+    }
+    return true;
+  }
