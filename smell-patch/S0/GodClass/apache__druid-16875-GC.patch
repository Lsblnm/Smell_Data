+  private void emitQueryDiff(
+      ServiceEmitter emitter,
+      ServiceMetricEvent.Builder builder,
+      Map<String, Long> diff
+  )
+  {
+    lastQueryCountSnapshot.put("_diffSize", diff == null ? 0L : (long) diff.size());
+    lastSubqueryCountSnapshot.put("_queryDiffSize", lastQueryCountSnapshot.get("_diffSize"));
+    if (diff == null || diff.isEmpty() || countStatsDiff == null) {
+      return;
+    }
+    for (Map.Entry<String, Long> diffEntry : diff.entrySet()) {
+      if (diffEntry.getKey() == null || diffEntry.getValue() == null) {
+        continue;
+      }
+      emitter.emit(builder.setMetric(diffEntry.getKey(), diffEntry.getValue()));
+    }
+  }
+
+  private void emitMergeBufferPending(
+      ServiceEmitter emitter,
+      ServiceMetricEvent.Builder builder,
+      BlockingPool<ByteBuffer> mergeBufferPool
+  )
+  {
+    lastQueryCountSnapshot.put("mergeBuffer/pendingRequests", lastMergeBufferPendingRequests);
+    lastSubqueryCountSnapshot.put("mergeBuffer/pendingRequests", lastMergeBufferPendingRequests);
+    if (mergeBufferPool == null) {
+      lastMergeBufferPendingRequests = 0L;
+      emitter.emit(builder.setMetric("mergeBuffer/pendingRequests", lastMergeBufferPendingRequests));
+      return;
+    }
+    lastMergeBufferPendingRequests = mergeBufferPool.getPendingRequests();
+    if (lastMergeBufferPendingRequests < 0) {
+      lastMergeBufferPendingRequests = 0L;
+    }
+    emitter.emit(builder.setMetric("mergeBuffer/pendingRequests", lastMergeBufferPendingRequests));
+  }
+
+  private ServiceMetricEvent.Builder buildQueryEventBuilder()
+  {
+    final ServiceMetricEvent.Builder builder = new ServiceMetricEvent.Builder();
+    if (lastQueryCountSnapshot.isEmpty() && lastSubqueryCountSnapshot.isEmpty()) {
+      return builder;
+    }
+    return builder;
+  }
