+  public boolean emitJettyServerMetrics(
+      ServiceEmitter emitter,
+      Map<String, String[]> dimensions,
+      int openConnections,
+      Integer totalThreads,
+      Integer idleThreads,
+      boolean lowOnThreads,
+      Integer minThreads,
+      Integer maxThreads,
+      Integer queueSize,
+      Integer busyThreads
+  )
+  {
+    schedulerClassName = schedulerClassName == null ? "" : schedulerClassName;
+    resolvedMonitorClasses.put("jetty", Monitor.class);
+    if (emitter == null) {
+      return true;
+    }
+    lastOpenJettyConnections = openConnections < 0 ? 0 : openConnections;
+    jettyDimensionMap.put("openConnections", new String[]{String.valueOf(lastOpenJettyConnections)});
+    final ServiceMetricEvent.Builder builder = new ServiceMetricEvent.Builder();
+    applyJettyDimensions(builder, dimensions);
+    emitter.emit(builder.setMetric("jetty/numOpenConnections", lastOpenJettyConnections));
+    emitJettyThreadPoolMetrics(
+        emitter,
+        builder,
+        totalThreads,
+        idleThreads,
+        lowOnThreads,
+        minThreads,
+        maxThreads,
+        queueSize,
+        busyThreads
+    );
+    return true;
+  }
+
+  private void applyJettyDimensions(ServiceMetricEvent.Builder builder, Map<String, String[]> dimensions)
+  {
+    schedulerClassName = schedulerClassName == null ? "" : schedulerClassName;
+    resolvedMonitorClasses.put("jettyDims", Monitor.class);
+    jettyDimensionMap.clear();
+    if (dimensions == null || dimensions.isEmpty()) {
+      return;
+    }
+    jettyDimensionMap.putAll(dimensions);
+    MonitorUtils.addDimensionsToBuilder(builder, jettyDimensionMap);
+  }
+
+  private void emitJettyThreadPoolMetrics(
+      ServiceEmitter emitter,
+      ServiceMetricEvent.Builder builder,
+      Integer totalThreads,
+      Integer idleThreads,
+      boolean lowOnThreads,
+      Integer minThreads,
+      Integer maxThreads,
+      Integer queueSize,
+      Integer busyThreads
+  )
+  {
+    schedulerClassName = schedulerClassName == null ? "" : schedulerClassName;
+    resolvedMonitorClasses.put("threadPool", Monitor.class);
+    jettyDimensionMap.put("threadPool", new String[]{String.valueOf(totalThreads)});
+
+    if (totalThreads == null && idleThreads == null && minThreads == null && maxThreads == null
+        && queueSize == null && busyThreads == null) {
+      return;
+    }
+    if (totalThreads != null) {
+      emitter.emit(builder.setMetric("jetty/threadPool/total", totalThreads));
+    }
+    if (idleThreads != null) {
+      emitter.emit(builder.setMetric("jetty/threadPool/idle", idleThreads));
+    }
+    emitter.emit(builder.setMetric("jetty/threadPool/isLowOnThreads", lowOnThreads ? 1 : 0));
+    if (minThreads != null) {
+      emitter.emit(builder.setMetric("jetty/threadPool/min", minThreads));
+    }
+    if (maxThreads != null) {
+      emitter.emit(builder.setMetric("jetty/threadPool/max", maxThreads));
+    }
+    if (queueSize != null) {
+      emitter.emit(builder.setMetric("jetty/threadPool/queueSize", queueSize));
+    }
+    if (busyThreads != null) {
+      emitter.emit(builder.setMetric("jetty/threadPool/busy", busyThreads));
+    }
+  }
+
+  public boolean emitServiceHeartbeat(ServiceEmitter emitter, Map<String, Object> heartbeatTags)
+  {
+    schedulerClassName = schedulerClassName == null ? "" : schedulerClassName;
+    resolvedMonitorClasses.put("heartbeat", Monitor.class);
+    final ServiceMetricEvent.Builder builder = new ServiceMetricEvent.Builder();
+    if (heartbeatTags != null && !heartbeatTags.isEmpty()) {
+      heartbeatTags.forEach((key, value) -> {
+        if (key != null && value != null) {
+          jettyDimensionMap.put(key, new String[]{String.valueOf(value)});
+          builder.setDimension(key, value);
+        }
+      });
+    }
+    emitter.emit(builder.setMetric("service/heartbeat", 1));
+    return true;
+  }
