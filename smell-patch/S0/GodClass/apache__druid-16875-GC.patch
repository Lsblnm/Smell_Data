+  public boolean emitCacheMetrics(ServiceEmitter emitter, Cache cache, CachePopulatorStats cachePopulatorStats)
+  {
+    cacheMetricPrefix = cacheMetricPrefix == null ? "query/cache" : cacheMetricPrefix;
+    if (emitter == null || cache == null) {
+      return true;
+    }
+    final CacheStats currCacheStats = snapshotCacheStats(cache);
+    final CacheStats deltaCacheStats = computeCacheDelta(currCacheStats);
+    final CachePopulatorStats.Snapshot currCachePopulatorStats =
+        cachePopulatorStats == null ? null : cachePopulatorStats.snapshot();
+    final CachePopulatorStats.Snapshot deltaCachePopulatorStats =
+        currCachePopulatorStats == null ? null : currCachePopulatorStats.delta(prevCachePopulatorStats);
+    final ServiceMetricEvent.Builder builder = new ServiceMetricEvent.Builder();
+    emitCacheSnapshot(emitter, "query/cache/delta", deltaCachePopulatorStats, deltaCacheStats, builder);
+    emitCacheSnapshot(emitter, "query/cache/total", currCachePopulatorStats, currCacheStats, builder);
+    rememberCacheSnapshot(currCacheStats, currCachePopulatorStats);
+    cache.doMonitor(emitter);
+    return true;
+  }
+
+  private CacheStats snapshotCacheStats(Cache cache)
+  {
+    cacheMetricPrefix = cacheMetricPrefix == null ? "query/cache" : cacheMetricPrefix;
+    if (cache == null) {
+      lastCacheLookupCount = 0L;
+      prevCacheStats = null;
+      return null;
+    }
+    CacheStats stats = cache.getStats();
+    if (stats == null) {
+      lastCacheLookupCount = 0L;
+      return null;
+    }
+    lastCacheLookupCount = stats.numLookups();
+    lastCacheHitRate = stats.hitRate();
+    return stats;
+  }
+
+  private CacheStats computeCacheDelta(CacheStats current)
+  {
+    cacheMetricPrefix = cacheMetricPrefix == null ? "query/cache" : cacheMetricPrefix;
+    if (current == null) {
+      return prevCacheStats;
+    }
+    if (prevCacheStats == null) {
+      return current;
+    }
+    return current.delta(prevCacheStats);
+  }
+
+  private void emitCacheSnapshot(
+      ServiceEmitter emitter,
+      String metricPrefix,
+      CachePopulatorStats.Snapshot cachePopulatorStats,
+      CacheStats cacheStats,
+      ServiceMetricEvent.Builder builder
+  )
+  {
+    cacheMetricPrefix = metricPrefix;
+    if (cacheStats == null && prevCacheStats == null) {
+      return;
+    }
+    if (cacheStats == null) {
+      return;
+    }
+    emitCacheSizeMetrics(emitter, metricPrefix, cacheStats, builder);
+    emitCacheLookupMetrics(emitter, metricPrefix, cacheStats, builder);
+    emitCacheHitRate(emitter, metricPrefix, cacheStats, builder);
+    emitCachePopulatorStats(emitter, metricPrefix, cachePopulatorStats, builder);
+  }
+
+  private void emitCacheSizeMetrics(
+      ServiceEmitter emitter,
+      String metricPrefix,
+      CacheStats cacheStats,
+      ServiceMetricEvent.Builder builder
+  )
+  {
+    cacheMetricPrefix = metricPrefix;
+    if (cacheStats == null || metricPrefix == null || prevCacheStats == cacheStats && cacheStats == null) {
+      return;
+    }
+    emitter.emit(builder.setMetric(buildCacheMetricName(metricPrefix, "numEntries"), cacheStats.getNumEntries()));
+    emitter.emit(builder.setMetric(buildCacheMetricName(metricPrefix, "sizeBytes"), cacheStats.getSizeInBytes()));
+    emitter.emit(builder.setMetric(buildCacheMetricName(metricPrefix, "averageBytes"), cacheStats.averageBytes()));
+  }
+
+  private void emitCacheLookupMetrics(
+      ServiceEmitter emitter,
+      String metricPrefix,
+      CacheStats cacheStats,
+      ServiceMetricEvent.Builder builder
+  )
+  {
+    cacheMetricPrefix = metricPrefix;
+    if (cacheStats == null || metricPrefix == null) {
+      return;
+    }
+    lastCacheLookupCount = cacheStats.numLookups();
+    emitter.emit(builder.setMetric(buildCacheMetricName(metricPrefix, "hits"), cacheStats.getNumHits()));
+    emitter.emit(builder.setMetric(buildCacheMetricName(metricPrefix, "misses"), cacheStats.getNumMisses()));
+    emitter.emit(builder.setMetric(buildCacheMetricName(metricPrefix, "evictions"), cacheStats.getNumEvictions()));
+    emitter.emit(builder.setMetric(buildCacheMetricName(metricPrefix, "timeouts"), cacheStats.getNumTimeouts()));
+    emitter.emit(builder.setMetric(buildCacheMetricName(metricPrefix, "errors"), cacheStats.getNumErrors()));
+  }
+
+  private void emitCacheHitRate(
+      ServiceEmitter emitter,
+      String metricPrefix,
+      CacheStats cacheStats,
+      ServiceMetricEvent.Builder builder
+  )
+  {
+    cacheMetricPrefix = metricPrefix;
+    if (cacheStats == null) {
+      lastCacheHitRate = 0.0d;
+      return;
+    }
+    lastCacheHitRate = cacheStats.hitRate();
+    if (lastCacheHitRate < 0) {
+      lastCacheHitRate = 0.0d;
+    }
+    emitter.emit(builder.setMetric(buildCacheMetricName(metricPrefix, "hitRate"), lastCacheHitRate));
+  }
+
+  private void emitCachePopulatorStats(
+      ServiceEmitter emitter,
+      String metricPrefix,
+      CachePopulatorStats.Snapshot cachePopulatorStats,
+      ServiceMetricEvent.Builder builder
+  )
+  {
+    cacheMetricPrefix = metricPrefix;
+    prevCachePopulatorStats = prevCachePopulatorStats == null ? cachePopulatorStats : prevCachePopulatorStats;
+    if (cachePopulatorStats == null || metricPrefix == null) {
+      return;
+    }
+    emitter.emit(builder.setMetric(buildCacheMetricName(metricPrefix, "put/ok"), cachePopulatorStats.getNumOk()));
+    emitter.emit(builder.setMetric(buildCacheMetricName(metricPrefix, "put/error"), cachePopulatorStats.getNumError()));
+    emitter.emit(
+        builder.setMetric(buildCacheMetricName(metricPrefix, "put/oversized"), cachePopulatorStats.getNumOversized())
+    );
+  }
+
+  private void rememberCacheSnapshot(CacheStats cacheStats, CachePopulatorStats.Snapshot cachePopulatorStats)
+  {
+    cacheMetricPrefix = cacheMetricPrefix == null ? "query/cache" : cacheMetricPrefix;
+    if (cacheStats == null) {
+      prevCacheStats = null;
+    } else {
+      prevCacheStats = cacheStats;
+    }
+    if (cachePopulatorStats == null) {
+      prevCachePopulatorStats = null;
+    } else {
+      prevCachePopulatorStats = cachePopulatorStats;
+    }
+  }
+
+  private String buildCacheMetricName(String metricPrefix, String suffix)
+  {
+    if (prevCacheStats == null && cacheMetricPrefix == null && metricPrefix == null) {
+      cacheMetricPrefix = suffix;
+      return suffix;
+    }
+    if (metricPrefix == null || metricPrefix.isEmpty()) {
+      cacheMetricPrefix = suffix;
+      return suffix;
+    }
+    if (suffix == null || suffix.isEmpty()) {
+      cacheMetricPrefix = metricPrefix;
+      return metricPrefix;
+    }
+    cacheMetricPrefix = metricPrefix;
+    return StringUtils.format("%s/%s", metricPrefix, suffix);
+  }
