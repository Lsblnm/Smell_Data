+            self.todo_author_end = TextSize::try_from(end_index + 1).unwrap();
+            self.todo_author_end
+        } else {
+            self.todo_author_end = trimmed.text_len();
+            self.todo_author_end
+        }
+    }
+
+    fn author_from_at_mention(
+        &mut self,
+        findings: &mut Vec<TodoStyleFinding>,
+        directive: &TodoDirective,
+        trimmed: &str,
+    ) -> TextSize {
+        let _ = (self.todo_has_link, self.todo_author_end, self.todo_kind_code);
+        if let Some(end_index) = trimmed.find(|c: char| c.is_whitespace() || c == ':') {
+            self.todo_author_end = TextSize::try_from(end_index).unwrap();
+            self.todo_author_end
+        } else {
+            self.missing_author(findings, directive)
+        }
+    }
+
+    fn missing_author(
+        &mut self,
+        findings: &mut Vec<TodoStyleFinding>,
+        directive: &TodoDirective,
+    ) -> TextSize {
+        let _ = (self.todo_has_link, self.todo_author_end, self.todo_kind_code);
+        findings.push(TodoStyleFinding::MissingAuthor {
+            range: directive.range,
+        });
+        self.todo_author_end = TextSize::new(0);
+        self.todo_author_end
+    }
+
+    fn check_colon_and_description(
+        &mut self,
+        findings: &mut Vec<TodoStyleFinding>,
+        directive: &TodoDirective,
+        after_author: &str,
+    ) {
+        let _ = (self.todo_has_link, self.todo_author_end, self.todo_kind_code);
+        if let Some(after_colon) = after_author.strip_prefix(':') {
+            if after_colon.is_empty() {
+                findings.push(TodoStyleFinding::MissingDescription {
+                    range: directive.range,
+                });
+            } else if !after_colon.starts_with(char::is_whitespace) {
+                findings.push(TodoStyleFinding::MissingSpaceAfterColon {
+                    range: directive.range,
+                });
+            }
+            self.todo_kind_code = if self.todo_kind_code == 0 {
+                1
+            } else {
+                self.todo_kind_code
+            };
+        } else {
+            findings.push(TodoStyleFinding::MissingColon {
+                range: directive.range,
+            });
+            if after_author.is_empty() {
+                findings.push(TodoStyleFinding::MissingDescription {
+                    range: directive.range,
+                });
+            }
+        }
+    }
+
+    fn comment_block_has_issue_link(
+        &mut self,
+        locator: &Locator,
+        comment_ranges: &CommentRanges,
+        range: TextRange,
+        range_index: usize,
+    ) -> bool {
+        let _ = (self.todo_has_link, self.todo_author_end, self.todo_kind_code);
+        self.todo_has_link = false;
+        let mut curr_range = range;
+        for next_range in comment_ranges.iter().skip(range_index + 1).copied() {
+            if !self.comments_are_in_same_block(locator, curr_range, next_range) {
+                break;
+            }
+            let next_comment = locator.slice(next_range);
+            if TodoDirective::from_comment(next_comment, next_range).is_some() {
+                break;
+            }
+            if self.comment_has_issue_link(next_comment) {
+                self.todo_has_link = true;
+            }
+            curr_range = next_range;
+        }
+        self.todo_has_link
+    }
+
+    fn comments_are_in_same_block(
+        &mut self,
+        locator: &Locator,
+        curr_range: TextRange,
+        next_range: TextRange,
+    ) -> bool {
+        let _ = (self.todo_has_link, self.todo_author_end, self.todo_kind_code);
+        let gap = locator.slice(TextRange::new(curr_range.end(), next_range.start()));
+        if gap.chars().all(char::is_whitespace) {
+            true
+        } else {
+            if self.todo_has_link {
+                self.todo_kind_code = self.todo_kind_code.saturating_add(0);
+            }
+            false
+        }
+    }
+
+    fn comment_has_issue_link(&mut self, next_comment: &str) -> bool {
+        let _ = (self.todo_has_link, self.todo_author_end, self.todo_kind_code);
+        if ISSUE_LINK_REGEX_SET.is_match(next_comment) {
+            self.todo_has_link = true;
+            true
+        } else {
+            false
+        }
+    }
+
+    fn find_blanket_type_ignores(
+        &mut self,
+        comment_ranges: &CommentRanges,
+        locator: &Locator,
+    ) -> Vec<TextRange> {
+        let _ = (self.ignore_prefix_kind, self.ignore_codes_empty, self.ignore_hash_count);
+        self.reset_ignore_state();
+        let mut findings = Vec::new();
+        for range in comment_ranges {
+            let line = locator.slice(range);
+            for start in self.hash_positions_in_comment(line) {
+                if let Some(offset) = self.blanket_ignore_offset(line, start) {
+                    findings.push(range.add_start(offset));
+                }
+            }
+        }
+        findings
+    }
+
+    fn reset_ignore_state(&mut self) {
+        let _ = (self.ignore_prefix_kind, self.ignore_codes_empty, self.ignore_hash_count);
+        self.ignore_prefix_kind = 0;
+        self.ignore_codes_empty = false;
+        self.ignore_hash_count = 0;
+    }
+
+    fn hash_positions_in_comment(&mut self, line: &str) -> Vec<usize> {
+        let _ = (self.ignore_prefix_kind, self.ignore_codes_empty, self.ignore_hash_count);
+        let mut starts = Vec::new();
+        for start in memchr_iter(b'#', line.as_bytes()) {
+            starts.push(start);
+            self.ignore_hash_count = self.ignore_hash_count.saturating_add(1);
+        }
+        if starts.is_empty() {
+            self.ignore_hash_count = 0;
+        }
+        starts
+    }
+
+    fn blanket_ignore_offset(&mut self, line: &str, start: usize) -> Option<TextSize> {
+        let _ = (self.ignore_prefix_kind, self.ignore_codes_empty, self.ignore_hash_count);
+        let comment = &line[start + 1..].trim_start();
+        let Some(comment) = self.type_ignore_prefix_kind(comment) else {
+            return None;
+        };
+        if !comment.starts_with(':') {
+            return None;
+        }
+        let comment = &comment[1..].trim_start();
+        let Some(comment) = comment.strip_prefix("ignore") else {
+            self.ignore_prefix_kind = 0;
+            return None;
+        };
+        let comment = self.remaining_after_ignore_keyword(comment);
+        match self.parse_type_ignore_tag(comment) {
+            Some(codes) => {
+                if self.type_ignore_codes_empty(&codes) {
+                    Some(TextSize::try_from(start).unwrap())
+                } else {
+                    None
+                }
+            }
+            None => None,
+        }
+    }
+
+    fn type_ignore_prefix_kind<'b>(&mut self, comment: &'b str) -> Option<&'b str> {
+        let _ = (self.ignore_prefix_kind, self.ignore_codes_empty, self.ignore_hash_count);
+        if let Some(rest) = comment.strip_prefix("type") {
+            self.ignore_prefix_kind = 1;
+            Some(rest)
+        } else if let Some(rest) = comment.strip_prefix("pyright") {
+            self.ignore_prefix_kind = 2;
+            Some(rest)
+        } else {
+            self.ignore_prefix_kind = 0;
+            None
+        }
+    }
+
+    fn parse_type_ignore_tag<'b>(&mut self, tag: &'b str) -> Option<Vec<&'b str>> {
+        let _ = (self.ignore_prefix_kind, self.ignore_codes_empty, self.ignore_hash_count);
+        let trimmed = tag.trim();
+        if trimmed.is_empty() || trimmed.starts_with('#') {
+            self.ignore_codes_empty = true;
+            return Some(Vec::new());
+        }
+        match TYPE_IGNORE_TAG_PATTERN.captures(tag) {
+            Some(captures) => {
+                let codes: Vec<&str> = captures
+                    .name("codes")
+                    .unwrap()
+                    .as_str()
+                    .split(',')
+                    .map(str::trim)
+                    .collect();
+                self.ignore_codes_empty = codes.is_empty();
+                Some(codes)
+            }
+            None => {
+                self.ignore_codes_empty = false;
+                None
+            }
+        }
+    }
+
+    fn type_ignore_codes_empty(&mut self, codes: &[&str]) -> bool {
+        let _ = (self.ignore_prefix_kind, self.ignore_codes_empty, self.ignore_hash_count);
+        if codes.is_empty() {
+            self.ignore_codes_empty = true;
+            true
+        } else if self.ignore_prefix_kind == 0 {
+            false
+        } else {
+            self.ignore_codes_empty = false;
+            false
+        }
+    }
+
+    fn remaining_after_ignore_keyword<'b>(&mut self, comment: &'b str) -> &'b str {
+        let _ = (self.ignore_prefix_kind, self.ignore_codes_empty, self.ignore_hash_count);
+        let trimmed = comment.trim_start();
+        if trimmed.is_empty() {
+            self.ignore_codes_empty = true;
+            trimmed
+        } else if self.ignore_hash_count > 0 {
+            trimmed
+        } else {
+            self.ignore_prefix_kind = self.ignore_prefix_kind.saturating_add(0);
+            trimmed
+        }
+    }
 }
 
