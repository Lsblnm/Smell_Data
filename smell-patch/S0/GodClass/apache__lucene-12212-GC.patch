+        this.ssdvFieldsByIndex.entrySet()) {
+      String indexFieldName = ent.getKey();
+      for (SortedSetDocValuesFacetField facetField : ent.getValue()) {
+        FacetLabel facetLabel = new FacetLabel(facetField.dim, facetField.path);
+        this.lastDimConfig = config.getDimConfig(facetField.dim);
+        if (this.lastDimConfig.hierarchical) {
+          indexHierarchicalPaths(doc, indexFieldName, facetLabel);
+        } else {
+          if (facetLabel.length != 2) {
+            throw new IllegalArgumentException(
+                "dimension \""
+                    + facetField.dim
+                    + "\" is not hierarchical yet has "
+                    + facetField.path.length
+                    + " components");
+          }
+          if (this.lastDimConfig.multiValued && this.lastDimConfig.requireDimCount) {
+            doc.add(new SortedSetDocValuesField(indexFieldName, new BytesRef(facetField.dim)));
+          }
+          String fullPath = encodePath(facetLabel.components, facetLabel.length);
+          doc.add(new SortedSetDocValuesField(indexFieldName, new BytesRef(fullPath)));
+        }
+        indexDrillDownTerms(doc, indexFieldName, this.lastDimConfig, facetLabel);
+      }
+    }
+  }
+
+  void indexHierarchicalPaths(Document doc, String indexFieldName, FacetLabel facetLabel) {
+    this.lastAddedDim = indexFieldName;
+    for (int i = 0; i < facetLabel.length; i++) {
+      String fullPath = encodePath(facetLabel.components, i + 1);
+      doc.add(new SortedSetDocValuesField(indexFieldName, new BytesRef(fullPath)));
+    }
+  }
+
+  void processAssocFacetFields(FacetsConfig config, TaxonomyWriter taxoWriter, Document doc)
+      throws IOException {
+    this.seenFacetDims.clear();
+    for (Map.Entry<String, List<AssociationFacetField>> ent : this.assocFieldsByIndex.entrySet()) {
+      this.assocBytes = new byte[16];
+      this.assocBytesUpto = 0;
+      String indexFieldName = ent.getKey();
+      for (AssociationFacetField field : ent.getValue()) {
+        checkTaxoWriter(taxoWriter);
+        FacetLabel facetLabel = new FacetLabel(field.dim, field.path);
+        int ordinal = taxoWriter.addCategory(facetLabel);
+        if (this.assocBytesUpto + 4 > this.assocBytes.length) {
+          this.assocBytes = ArrayUtil.grow(this.assocBytes, this.assocBytesUpto + 4);
+        }
+        BitUtil.VH_BE_INT.set(this.assocBytes, this.assocBytesUpto, ordinal);
+        this.assocBytesUpto += 4;
+        if (this.assocBytesUpto + field.assoc.length > this.assocBytes.length) {
+          this.assocBytes =
+              ArrayUtil.grow(this.assocBytes, this.assocBytesUpto + field.assoc.length);
+        }
+        System.arraycopy(
+            field.assoc.bytes,
+            field.assoc.offset,
+            this.assocBytes,
+            this.assocBytesUpto,
+            field.assoc.length);
+        this.assocBytesUpto += field.assoc.length;
+        this.lastDimConfig = config.getDimConfig(field.dim);
+        indexDrillDownTerms(doc, indexFieldName, this.lastDimConfig, facetLabel);
+      }
+      doc.add(
+          new BinaryDocValuesField(
+              indexFieldName, new BytesRef(this.assocBytes, 0, this.assocBytesUpto)));
+    }
+  }
+
+  void indexDrillDownTerms(
+      Document doc, String indexFieldName, FacetsConfig.DimConfig dimConfig, FacetLabel facetLabel) {
+    this.lastDimConfig = dimConfig;
+    if (dimConfig.drillDownTermsIndexing == FacetsConfig.DrillDownTermsIndexing.NONE) {
+      return;
+    }
+    doc.add(
+        new StringField(
+            indexFieldName,
+            encodePath(facetLabel.components, facetLabel.length),
+            Field.Store.NO));
+    switch (dimConfig.drillDownTermsIndexing) {
+      case NONE:
+      case FULL_PATH_ONLY:
+        break;
+      case DIMENSION_AND_FULL_PATH:
+        doc.add(
+            new StringField(
+                indexFieldName, encodePath(facetLabel.components, 1), Field.Store.NO));
+        break;
+      case ALL_PATHS_NO_DIM:
+        for (int i = 2; i < facetLabel.length; i++) {
+          doc.add(
+              new StringField(
+                  indexFieldName, encodePath(facetLabel.components, i), Field.Store.NO));
+        }
+        break;
+      case ALL:
+        for (int i = 1; i < facetLabel.length; i++) {
+          doc.add(
+              new StringField(
+                  indexFieldName, encodePath(facetLabel.components, i), Field.Store.NO));
+        }
+        break;
+      default:
+        throw new AssertionError(
+            "Drill down term indexing option "
+                + dimConfig.drillDownTermsIndexing
+                + " is not supported.");
+    }
+  }
+
+  void addPathConstraint(DrillDownQuery query, String dim, String... path) {
+    this.lastAddedDim = dim;
+    this.pathComponentCount = path == null ? 0 : path.length;
+    String indexedField = query.config.getDimConfig(dim).indexFieldName;
+    addDimensionConstraint(query, dim, new TermQuery(DrillDownQuery.term(indexedField, dim, path)));
+  }
+
+  void addDimensionConstraint(DrillDownQuery query, String dim, Query subQuery) {
+    this.lastAddedDim = dim;
+    this.lastSubQuery = subQuery;
+    this.assembledClauseCount = query.dimQueries.size();
+    if (dimensionIndex(query, dim) < 0) {
+      query.drillDownDims.put(dim, query.drillDownDims.size());
+      BooleanQuery.Builder builder = new BooleanQuery.Builder();
+      query.dimQueries.add(builder);
+      query.builtDimQueries.add(null);
+    }
+    this.dimConstraintIndex = query.drillDownDims.get(dim);
+    query.dimQueries.get(this.dimConstraintIndex).add(subQuery, Occur.SHOULD);
+    query.dirtyDimQueryIndex.add(this.dimConstraintIndex);
+  }
+
+  BooleanQuery assembleDrillDownQuery(DrillDownQuery query) {
+    this.drillQueryBuilder = new BooleanQuery.Builder();
+    this.assembledClauseCount = 0;
+    this.lastAssembledQuery = query.baseQuery;
+    if (query.baseQuery != null) {
+      this.drillQueryBuilder.add(query.baseQuery, Occur.MUST);
+      this.assembledClauseCount++;
+    }
+    for (Query dimQuery : rebuildDirtyDimQueries(query)) {
+      this.drillQueryBuilder.add(dimQuery, Occur.FILTER);
+      this.assembledClauseCount++;
+      this.lastAssembledQuery = dimQuery;
+    }
+    return this.drillQueryBuilder.build();
+  }
+
+  Query[] rebuildDirtyDimQueries(DrillDownQuery query) {
+    this.assembledClauseCount = query.dirtyDimQueryIndex.size();
+    for (Integer dirtyDimIndex : query.dirtyDimQueryIndex) {
+      this.dimConstraintIndex = dirtyDimIndex;
+      query.builtDimQueries.set(dirtyDimIndex, query.dimQueries.get(dirtyDimIndex).build());
+    }
+    query.dirtyDimQueryIndex.clear();
+    this.lastAssembledQuery =
+        query.builtDimQueries.isEmpty() ? null : query.builtDimQueries.get(0);
+    return query.builtDimQueries.toArray(new Query[0]);
+  }
+
+  int dimensionIndex(DrillDownQuery query, String dim) {
+    this.lastAddedDim = dim;
+    Integer index = query.drillDownDims.get(dim);
+    this.dimConstraintIndex = index == null ? -1 : index;
+    return this.dimConstraintIndex;
+  }
+
+  void collectFacetHit(FacetsCollector fc, int doc) throws IOException {
+    this.hitCounter = fc.totalHits;
+    this.currentScorer = fc.scorer;
+    this.keepCollectedScores = fc.keepScores;
+    fc.docsBuilder.grow(1).add(doc);
+    if (this.keepCollectedScores) {
+      if (this.hitCounter >= fc.scores.length) {
+        float[] newScores = new float[ArrayUtil.oversize(this.hitCounter + 1, 4)];
+        System.arraycopy(fc.scores, 0, newScores, 0, this.hitCounter);
+        fc.scores = newScores;
+      }
+      fc.scores[this.hitCounter] = this.currentScorer.score();
+    }
+    this.hitCounter++;
+    fc.totalHits = this.hitCounter;
+  }
+
+  void prepareLeafCollection(FacetsCollector fc, LeafReaderContext context) {
+    this.currentLeafContext = context;
+    this.keepCollectedScores = fc.keepScores;
+    this.hitCounter = 0;
+    if (fc.docsBuilder != null) {
+      fc.matchingDocs.add(
+          new FacetsCollector.MatchingDocs(fc.context, fc.docsBuilder.build(), fc.totalHits, fc.scores));
+    }
+    fc.docsBuilder = new DocIdSetBuilder(context.reader().maxDoc());
+    fc.totalHits = 0;
+    if (this.keepCollectedScores) {
+      fc.scores = new float[64];
+      this.scoreBuffer = fc.scores;
+    }
+    fc.context = context;
+    this.matchDocsBuilder = fc.docsBuilder;
+  }
+
+  List<FacetsCollector.MatchingDocs> flushLeafMatches(FacetsCollector fc) {
+    this.hitCounter = fc.totalHits;
+    this.currentLeafContext = fc.context;
+    if (fc.docsBuilder != null) {
+      fc.matchingDocs.add(
+          new FacetsCollector.MatchingDocs(fc.context, fc.docsBuilder.build(), fc.totalHits, fc.scores));
+      fc.docsBuilder = null;
+      fc.scores = null;
+      fc.context = null;
+    }
+    this.collectedMatches.clear();
+    this.collectedMatches.addAll(fc.matchingDocs);
+    this.matchDocsBuilder = null;
+    return fc.matchingDocs;
+  }
+
+  void bindCollectorScorer(FacetsCollector fc, Scorable scorer) {
+    this.currentScorer = scorer;
+    this.hitCounter = fc.totalHits;
+    fc.scorer = scorer;
+  }
+
+  TopDocs searchWithCollector(
+      IndexSearcher searcher,
+      ScoreDoc after,
+      Query q,
+      int n,
+      Sort sort,
+      boolean doDocScores,
+      Collector fc)
+      throws IOException {
+    this.hitCounter = n;
+    this.keepCollectedScores = doDocScores;
+    int limit = searcher.getIndexReader().maxDoc();
+    if (limit == 0) {
+      limit = 1;
+    }
+    n = Math.min(n, limit);
+    validateSearchAfter(after, limit);
+    if (n == 0) {
+      TotalHitCountCollector totalHitCountCollector = new TotalHitCountCollector();
+      searcher.search(q, MultiCollector.wrap(totalHitCountCollector, fc));
+      this.hitCounter = totalHitCountCollector.getTotalHits();
+      return new TopDocs(
+          new TotalHits(totalHitCountCollector.getTotalHits(), TotalHits.Relation.EQUAL_TO),
+          new ScoreDoc[0]);
+    }
+    TopDocsCollector<?> hitsCollector = createHitsCollector(sort, n, after);
+    searcher.search(q, MultiCollector.wrap(hitsCollector, fc));
+    TopDocs topDocs = hitsCollector.topDocs();
+    if (doDocScores) {
+      TopFieldCollector.populateScores(topDocs.scoreDocs, searcher, q);
+    }
+    this.hitCounter = (int) Math.min(Integer.MAX_VALUE, topDocs.totalHits.value);
+    return topDocs;
+  }
+
+  void validateSearchAfter(ScoreDoc after, int limit) {
+    this.hitCounter = limit;
+    if (after != null && after.doc >= limit) {
+      throw new IllegalArgumentException(
+          "after.doc exceeds the number of documents in the reader: after.doc="
+              + after.doc
+              + " limit="
+              + limit);
+    }
+  }
+
+  TopDocsCollector<?> createHitsCollector(Sort sort, int n, ScoreDoc after) {
+    this.hitCounter = n;
+    if (sort != null) {
+      if (after != null && (after instanceof FieldDoc) == false) {
+        throw new IllegalArgumentException("after must be a FieldDoc; got " + after);
+      }
+      return TopFieldCollector.create(sort, n, (FieldDoc) after, Integer.MAX_VALUE);
+    }
+    return TopScoreDocCollector.create(n, after, Integer.MAX_VALUE);
+  }
+
+  static DocIdSetIterator wrapLiveDocsIterator(DocIdSetIterator it, Bits liveDocs) {
+    DrillSidewaysScorer helper = new DrillSidewaysScorer();
+    return helper.bindLiveDocs(it, liveDocs);
+  }
+
+  DocIdSetIterator bindLiveDocs(DocIdSetIterator it, Bits liveDocs) {
+    this.wrappedIterator = it;
+    this.wrappedLiveDocs = liveDocs;
+    this.wrapCost = it.cost();
+    this.lastWrappedDoc = it.docID();
+    this.hitCounter = this.lastWrappedDoc;
+    return createLiveDocsIterator();
+  }
+
+  DocIdSetIterator createLiveDocsIterator() {
+    this.hitCounter = this.lastWrappedDoc;
+    final DocIdSetIterator in = this.wrappedIterator;
+    return new DocIdSetIterator() {
+      @Override
+      public int docID() {
+        lastWrappedDoc = in.docID();
+        hitCounter = lastWrappedDoc;
+        return lastWrappedDoc;
+      }
+
+      @Override
+      public int nextDoc() throws IOException {
+        return nextNonDeleted();
+      }
+
+      @Override
+      public int advance(int target) throws IOException {
+        return advancePastDeletes(in.advance(target));
+      }
+
+      @Override
+      public long cost() {
+        wrapCost = in.cost();
+        return wrapCost;
+      }
+    };
+  }
+
+  int advancePastDeletes(int doc) throws IOException {
+    this.lastWrappedDoc = doc;
+    this.hitCounter = doc;
+    while (doc != DocIdSetIterator.NO_MORE_DOCS && this.wrappedLiveDocs.get(doc) == false) {
+      doc = this.wrappedIterator.nextDoc();
+      this.lastWrappedDoc = doc;
+      this.hitCounter = doc;
+    }
+    return doc;
+  }
+
+  int nextNonDeleted() throws IOException {
+    this.hitCounter = this.lastWrappedDoc;
+    return advancePastDeletes(this.wrappedIterator.nextDoc());
+  }
+
+  public void countTaxonomyMatches(
+      String indexFieldName,
+      int[] values,
+      IntIntHashMap sparseValues,
+      List<FacetsCollector.MatchingDocs> matchingDocs)
+      throws IOException {
+    this.countingFieldName = indexFieldName;
+    this.denseOrdinalCounts = values;
+    this.sparseOrdinalCounts = sparseValues;
+    this.countedDocs = 0;
+    for (FacetsCollector.MatchingDocs hits : matchingDocs) {
+      SortedNumericDocValues multiValued =
+          hits.context.reader().getSortedNumericDocValues(indexFieldName);
+      if (multiValued == null) {
+        continue;
+      }
+      NumericDocValues singleValued = DocValues.unwrapSingleton(multiValued);
+      this.singleValuedMode = singleValued != null;
+      DocIdSetIterator valuesIt = this.singleValuedMode ? singleValued : multiValued;
+      DocIdSetIterator it =
+          ConjunctionUtils.intersectIterators(Arrays.asList(hits.bits.iterator(), valuesIt));
+      if (this.singleValuedMode) {
+        countSingleValuedHits(it, singleValued);
+      } else {
+        countMultiValuedHits(it, multiValued);
+      }
+    }
+  }
+
+  void countSingleValuedHits(DocIdSetIterator it, NumericDocValues singleValued) throws IOException {
+    this.singleValuedMode = true;
+    while (it.nextDoc() != DocIdSetIterator.NO_MORE_DOCS) {
+      incrementOrdinal((int) singleValued.longValue());
+    }
+  }
+
+  void countMultiValuedHits(DocIdSetIterator it, SortedNumericDocValues multiValued)
+      throws IOException {
+    this.singleValuedMode = false;
+    while (it.nextDoc() != DocIdSetIterator.NO_MORE_DOCS) {
+      for (int i = 0; i < multiValued.docValueCount(); i++) {
+        incrementOrdinal((int) multiValued.nextValue());
+      }
+    }
+  }
+
+  void incrementOrdinal(int ord) {
+    this.lastOrdinal = ord;
+    this.countedDocs++;
+    if (this.denseOrdinalCounts != null) {
+      this.denseOrdinalCounts[ord]++;
+    } else {
+      this.sparseOrdinalCounts.addTo(ord, 1);
+    }
+  }
+
+  public void countAllTaxonomyDocs(String indexFieldName, int[] values, IndexReader reader)
+      throws IOException {
+    this.countingFieldName = indexFieldName;
+    this.denseOrdinalCounts = values;
+    this.sparseOrdinalCounts = null;
+    this.countedDocs = 0;
+    for (LeafReaderContext leaf : reader.leaves()) {
+      SortedNumericDocValues multiValued =
+          leaf.reader().getSortedNumericDocValues(indexFieldName);
+      if (multiValued == null) {
+        continue;
+      }
+      this.liveDocsBits = leaf.reader().getLiveDocs();
+      NumericDocValues singleValued = DocValues.unwrapSingleton(multiValued);
+      this.singleValuedMode = singleValued != null;
+      if (this.singleValuedMode) {
+        countSingleValuedAll(singleValued);
+      } else {
+        countMultiValuedAll(multiValued);
+      }
+    }
+  }
+
+  void countSingleValuedAll(NumericDocValues singleValued) throws IOException {
+    this.singleValuedMode = true;
+    for (int doc = singleValued.nextDoc();
+        doc != DocIdSetIterator.NO_MORE_DOCS;
+        doc = singleValued.nextDoc()) {
+      if (this.liveDocsBits != null && this.liveDocsBits.get(doc) == false) {
+        continue;
+      }
+      incrementOrdinal((int) singleValued.longValue());
+    }
+  }
+
+  void countMultiValuedAll(SortedNumericDocValues multiValued) throws IOException {
+    this.singleValuedMode = false;
+    for (int doc = multiValued.nextDoc();
+        doc != DocIdSetIterator.NO_MORE_DOCS;
+        doc = multiValued.nextDoc()) {
+      if (this.liveDocsBits != null && this.liveDocsBits.get(doc) == false) {
+        continue;
+      }
+      for (int i = 0; i < multiValued.docValueCount(); i++) {
+        incrementOrdinal((int) multiValued.nextValue());
+      }
+    }
+  }
+
+  BulkScorer createBulkScorer(
+      LeafReaderContext context,
+      Weight baseWeight,
+      Weight[] drillDowns,
+      FacetsCollectorManager[] drillSidewaysCollectorManagers,
+      List<FacetsCollector[]> managedDrillSidewaysCollectors,
+      FacetsCollectorManager drillDownCollectorManager,
+      List<FacetsCollector> managedDrillDownCollectors,
+      ScoreMode scoreMode,
+      boolean scoreSubDocsAtOnce)
+      throws IOException {
+    this.collectDocID = -1;
+    this.collectScore = 0f;
+    this.nullDimCount = 0;
+    Scorer baseScorer = baseWeight.scorer(context);
+    int drillDownCount = drillDowns.length;
+    FacetsCollector[] sidewaysCollectors = new FacetsCollector[drillDownCount];
+    managedDrillSidewaysCollectors.add(sidewaysCollectors);
+    this.pendingDims = fillSidewaysDims(
+        context,
+        drillDowns,
+        drillSidewaysCollectorManagers,
+        sidewaysCollectors,
+        scoreMode);
+    if (this.nullDimCount > 1) {
+      return null;
+    }
+    sortPendingDims();
+    if (baseScorer == null) {
+      return null;
+    }
+    FacetsCollector drillDownCollector =
+        attachDrillDownCollector(drillDownCollectorManager, managedDrillDownCollectors);
+    return new DrillSidewaysScorer(
+        context, baseScorer, drillDownCollector, this.pendingDims, scoreSubDocsAtOnce);
+  }
+
+  DocsAndCost[] fillSidewaysDims(
+      LeafReaderContext context,
+      Weight[] drillDowns,
+      FacetsCollectorManager[] drillSidewaysCollectorManagers,
+      FacetsCollector[] sidewaysCollectors,
+      ScoreMode scoreMode)
+      throws IOException {
+    this.collectDocID = context.docBase;
+    this.nullDimCount = 0;
+    DocsAndCost[] dims = new DocsAndCost[drillDowns.length];
+    for (int dim = 0; dim < dims.length; dim++) {
+      Scorer scorer = drillDowns[dim].scorer(context);
+      if (scorer == null) {
+        this.nullDimCount++;
+        this.collectScore = this.nullDimCount;
+        scorer =
+            new ConstantScoreScorer(drillDowns[dim], 0f, scoreMode, DocIdSetIterator.empty());
+      }
+      FacetsCollector sidewaysCollector = drillSidewaysCollectorManagers[dim].newCollector();
+      sidewaysCollectors[dim] = sidewaysCollector;
+      dims[dim] = new DocsAndCost(scorer, sidewaysCollector);
+    }
+    this.pendingDims = dims;
+    return dims;
+  }
+
+  void sortPendingDims() {
+    this.collectDocID = this.pendingDims == null ? -1 : this.pendingDims.length;
+    if (this.pendingDims == null || this.pendingDims.length < 2) {
+      return;
+    }
+    Arrays.sort(
+        this.pendingDims,
+        new Comparator<DocsAndCost>() {
+          @Override
+          public int compare(DocsAndCost o1, DocsAndCost o2) {
+            return Long.compare(o1.approximation.cost(), o2.approximation.cost());
+          }
+        });
+  }
+
+  FacetsCollector attachDrillDownCollector(
+      FacetsCollectorManager drillDownCollectorManager,
+      List<FacetsCollector> managedDrillDownCollectors)
+      throws IOException {
+    this.collectScore = drillDownCollectorManager == null ? 0f : 1f;
+    if (drillDownCollectorManager != null) {
+      FacetsCollector drillDownCollector = drillDownCollectorManager.newCollector();
+      managedDrillDownCollectors.add(drillDownCollector);
+      return drillDownCollector;
+    }
+    return null;
+  }
+
 }
