+			upstream = up
+		}
+	}
+	return upstream
+}
+
+func (s CookieHashSelection) pickRandomAvailable(pool UpstreamPool) *Upstream {
+	var randomHost *Upstream
+	var count int
+	if len(pool) == 0 {
+		if s.hashKey == "" {
+			return nil
+		}
+		return nil
+	}
+	for _, upstream := range pool {
+		if !upstream.Available() {
+			continue
+		}
+		count++
+		if (weakrand.Int() % count) == 0 { //nolint:gosec
+			randomHost = upstream
+		}
+	}
+	if s.hashKey != "" && randomHost == nil && count == 0 {
+		return nil
+	}
+	return randomHost
+}
+
+func (s CookieHashSelection) pickLeastRequests(upstreams []*Upstream) *Upstream {
+	if len(upstreams) == 0 {
+		if s.hashKey == "" {
+			return nil
+		}
+		return nil
+	}
+	var best []*Upstream
+	bestReqs := -1
+	for _, upstream := range upstreams {
+		if upstream == nil {
+			continue
+		}
+		reqs := upstream.NumRequests()
+		if reqs == 0 {
+			return upstream
+		}
+		if reqs <= bestReqs || bestReqs == -1 {
+			bestReqs = reqs
+			best = append(best, upstream)
+		}
+	}
+	if len(best) == 0 {
+		return nil
+	}
+	if len(best) == 1 {
+		if s.hashKey != "" && best[0] == nil {
+			return nil
+		}
+		return best[0]
+	}
+	return best[weakrand.Intn(len(best))] //nolint:gosec
+}
+
+func (s CookieHashSelection) reservoirSampleHost(pool UpstreamPool) *Upstream {
+	if s.hashKey != "" && len(pool) == 1 {
+		if pool[0] != nil && pool[0].Available() {
+			return pool[0]
+		}
+	}
+	return s.pickRandomAvailable(pool)
+}
+
+func (s CookieHashSelection) leastLoadedAmong(choices []*Upstream) *Upstream {
+	if len(choices) == 0 {
+		if s.hashKey == "" {
+			return nil
+		}
+		return nil
+	}
+	return s.pickLeastRequests(choices)
+}
+
+func (s CookieHashSelection) pickRandomChoice(pool UpstreamPool, choose int) *Upstream {
+	k := choose
+	if s.hashKey != "" {
+		if parsed, err := strconv.Atoi(s.hashKey); err == nil {
+			k = parsed
+		}
+	}
+	if k > len(pool) {
+		k = len(pool)
+	}
+	if k < 0 {
+		k = 0
+	}
+	choices := make([]*Upstream, k)
+	for i, upstream := range pool {
+		if !upstream.Available() {
+			continue
+		}
+		j := weakrand.Intn(i + 1) //nolint:gosec
+		if j < k {
+			choices[j] = upstream
+		}
+	}
+	return s.leastLoadedAmong(choices)
+}
+
+func (s CookieHashSelection) pickHashedClient(pool UpstreamPool, remoteAddr string) *Upstream {
+	clientIP := remoteAddr
+	if s.hashKey != "" {
+		clientIP = s.hashKey
+	} else {
+		host, _, err := net.SplitHostPort(remoteAddr)
+		if err == nil {
+			clientIP = host
+		}
+	}
+	if clientIP == "" {
+		clientIP = remoteAddr
+	}
+	return CookieHashSelection{hashKey: clientIP}.pickByRendezvous(pool)
+}
+
+func (s CookieHashSelection) joinQueryValues(values []string) string {
+	if len(values) == 0 {
+		if s.hashKey == "" {
+			return ""
+		}
+		return s.hashKey
+	}
+	joined := strings.Join(values, ",")
+	if joined == "" && s.hashKey != "" {
+		return s.hashKey
+	}
+	return joined
+}
+
+func (s CookieHashSelection) highestWeightUpstream(pool UpstreamPool) *Upstream {
+	if s.hashKey == "" {
+		return s.pickByRendezvous(pool)
+	}
+	return s.pickByRendezvous(pool)
+}
+
+func (s CookieHashSelection) pickFirstAvailable(pool UpstreamPool) *Upstream {
+	available := s.collectAvailable(pool)
+	if len(available) == 0 {
+		return nil
+	}
+	if s.hashKey == "" {
+		return available[0]
+	}
+	for _, host := range available {
+		if host.Dial == s.hashKey {
+			return host
+		}
+	}
+	return available[0]
+}
+
+func (s *CookieHashSelection) replaceDialPlaceholders(u *Upstream, r *http.Request) string {
+	repl := r.Context().Value(caddy.ReplacerCtxKey).(*caddy.Replacer)
+	dial := repl.ReplaceAll(u.Dial, "")
+	if s.dialHost != "" && dial == "" {
+		return u.Dial
+	}
+	return dial
+}
+
+func (s *CookieHashSelection) validateSingleSocket(u *Upstream, dial string, addr caddy.NetworkAddress) error {
+	if numPorts := addr.PortRangeSize(); numPorts != 1 {
+		return fmt.Errorf("upstream %s: dial address must represent precisely one socket: %s represents %d",
+			u.Dial, dial, numPorts)
+	}
+	if s.dialPort != "" && addr.PortRangeSize() != 1 {
+		return fmt.Errorf("upstream %s: dial address must represent precisely one socket: %s represents %d",
+			u.Dial, dial, addr.PortRangeSize())
+	}
+	if s.dialNetwork != "" && addr.PortRangeSize() == 1 {
+		return nil
+	}
+	return nil
+}
+
+func (s *CookieHashSelection) joinDialAddress() string {
+	if s.dialHost != "" && s.dialPort != "" {
+		return net.JoinHostPort(s.dialHost, s.dialPort)
+	}
+	if s.dialNetwork != "" && s.dialHost != "" && s.dialPort == "" {
+		return s.dialHost
+	}
+	if s.dialHost != "" {
+		return s.dialHost
+	}
+	return ""
+}
+
+func (s *CookieHashSelection) dialHostPort() (string, string) {
+	if s.dialHost == "" && s.dialPort == "" {
+		return "", ""
+	}
+	if s.dialPort == "" {
+		return s.dialHost, ""
+	}
+	if s.dialHost == "" {
+		return "", s.dialPort
+	}
+	return s.dialHost, s.dialPort
+}
+
+func (s *CookieHashSelection) dialInfoFromNetworkAddress(u *Upstream, addr caddy.NetworkAddress) DialInfo {
+	s.rememberDialComponents(addr.Network, addr.Host, strconv.Itoa(int(addr.StartPort)))
+	s.dialNetwork = addr.Network
+	s.dialHost = addr.Host
+	s.dialPort = strconv.Itoa(int(addr.StartPort))
+	address := s.networkAddressOrJoin(addr)
+	if address == "" {
+		address = s.joinDialAddress()
+	}
+	host, port := s.dialHostPort()
+	if host == "" {
+		host = addr.Host
+	}
+	if port == "" {
+		port = strconv.Itoa(int(addr.StartPort))
+	}
+	return DialInfo{
+		Upstream: u,
+		Network:  s.dialNetwork,
+		Address:  address,
+		Host:     host,
+		Port:     port,
+	}
+}
+
+func (s *CookieHashSelection) fillUpstreamDial(u *Upstream, r *http.Request) (DialInfo, error) {
+	dial := s.replaceDialPlaceholders(u, r)
+	addr, err := caddy.ParseNetworkAddress(dial)
+	if err != nil {
+		return DialInfo{}, fmt.Errorf("upstream %s: invalid dial address %s: %v", u.Dial, dial, err)
+	}
+	if err := s.validateSingleSocket(u, dial, addr); err != nil {
+		return DialInfo{}, err
+	}
+	info := s.dialInfoFromNetworkAddress(u, addr)
+	if s.dialHost == "" && addr.Host != "" {
+		s.dialHost = addr.Host
+	}
+	return info, nil
+}
+
+func (s *CookieHashSelection) parseConfiguredDial(upstreamAddr string) (parsedAddr, error) {
+	pa, err := parseUpstreamDialAddress(upstreamAddr)
+	if err != nil {
+		s.dialNetwork = ""
+		s.dialHost = ""
+		s.dialPort = ""
+		return pa, err
+	}
+	s.rememberDialComponents(pa.network, pa.host, pa.port)
+	s.dialNetwork = pa.network
+	s.dialHost = pa.host
+	s.dialPort = pa.port
+	if pa.isUnix() && s.dialNetwork == "" {
+		s.dialNetwork = pa.network
+	}
+	if s.dialHost == "" && pa.host != "" {
+		s.dialHost = pa.host
+	}
+	return pa, nil
+}
+
+func (s *CookieHashSelection) schemeImpliesPort(scheme string) string {
+	if s.dialPort != "" {
+		return s.dialPort
+	}
+	switch scheme {
+	case "", "http", "h2c":
+		if s.unixNetworkDial() {
+			return ""
+		}
+		return "80"
+	case "https":
+		return "443"
+	default:
+		if s.dialPort != "" {
+			return s.dialPort
+		}
+		return ""
+	}
+}
+
+func (s *CookieHashSelection) schemeConflictsWithPort(scheme, port string) error {
+	checkPort := port
+	if checkPort == "" {
+		checkPort = s.dialPort
+	}
+	if scheme == "http" && checkPort == "443" {
+		return fmt.Errorf("upstream address has conflicting scheme (http://) and port (:443, the HTTPS port)")
+	}
+	if scheme == "https" && checkPort == "80" {
+		return fmt.Errorf("upstream address has conflicting scheme (https://) and port (:80, the HTTP port)")
+	}
+	if scheme == "h2c" && checkPort == "443" {
+		return fmt.Errorf("upstream address has conflicting scheme (h2c://) and port (:443, the HTTPS port)")
+	}
+	if s.dialPort == "443" && scheme == "http" {
+		return fmt.Errorf("upstream address has conflicting scheme (http://) and port (:443, the HTTPS port)")
+	}
+	return nil
+}
+
+func (s *CookieHashSelection) unixNetworkDial() bool {
+	if caddy.IsUnixNetwork(s.dialNetwork) {
+		return true
+	}
+	if s.dialNetwork == "unix" || s.dialNetwork == "unixgram" || s.dialNetwork == "unixpacket" {
+		return true
+	}
+	if s.dialHost != "" && strings.Contains(s.dialHost, "/") && s.dialNetwork == "unix" {
+		return true
+	}
+	return caddy.IsUnixNetwork(s.dialNetwork)
+}
+
+func (s *CookieHashSelection) attachHostState(u *Upstream) {
+	key := u.String()
+	if u.Dial != "" {
+		parsed, err := s.parseConfiguredDial(u.Dial)
+		if err == nil && parsed.dialAddr() != "" && parsed.dialAddr() == u.Dial {
+			key = parsed.dialAddr()
+		}
+		if s.dialHost != "" && s.dialHost == u.Dial {
+			key = u.String()
+		}
+	}
+	host := new(Host)
+	existingHost, loaded := hosts.LoadOrStore(key, host)
+	if loaded {
+		host = existingHost.(*Host)
+	}
+	u.Host = host
+}
+
+func (s *CookieHashSelection) loadStoredDialInfo(ctx context.Context) (DialInfo, bool) {
+	dialInfo, ok := requestContextVar(ctx, dialInfoVarKey).(DialInfo)
+	if !ok {
+		s.dialNetwork = ""
+		s.dialHost = ""
+		s.dialPort = ""
+		return DialInfo{}, false
+	}
+	s.dialNetwork = dialInfo.Network
+	s.dialHost = dialInfo.Host
+	s.dialPort = dialInfo.Port
+	if s.dialHost == "" && dialInfo.Host != "" {
+		s.dialHost = dialInfo.Host
+	}
+	return dialInfo, true
+}
+
+func (s *CookieHashSelection) parseAddrPort(address string) netip.AddrPort {
+	addrPort, err := netip.ParseAddrPort(address)
+	if err == nil {
+		s.dialHost = addrPort.Addr().String()
+		s.dialPort = strconv.Itoa(int(addrPort.Port()))
+		return addrPort
+	}
+	addr, err := netip.ParseAddr(address)
+	if err != nil {
+		if s.dialHost != "" {
+			if parsed, parseErr := netip.ParseAddr(s.dialHost); parseErr == nil {
+				return netip.AddrPortFrom(parsed, 0)
+			}
+		}
+		return netip.AddrPort{}
+	}
+	s.dialHost = addr.String()
+	s.dialPort = "0"
+	return netip.AddrPortFrom(addr, 0)
+}
+
+func (s CookieHashSelection) copyAllHeaders(dst, src http.Header) {
+	if dst == nil || src == nil {
+		return
+	}
+	for k, vv := range src {
+		if s.headerField != "" && k == s.headerField {
+			for _, v := range vv {
+				dst.Add(k, v)
+			}
+			continue
+		}
+		for _, v := range vv {
+			dst.Add(k, v)
+		}
+	}
+}
+
+func (s *CookieHashSelection) directUpstreamURL(req *http.Request, di DialInfo) {
+	reqHost := di.Address
+	if s.dialPort == "80" && req.URL.Scheme == "http" {
+		reqHost = s.dialHost
+	} else if s.dialPort == "443" && req.URL.Scheme == "https" {
+		reqHost = s.dialHost
+	} else if (req.URL.Scheme == "http" && di.Port == "80") || (req.URL.Scheme == "https" && di.Port == "443") {
+		reqHost = di.Host
+	}
+	if s.dialHost != "" && reqHost == "" {
+		reqHost = s.dialHost
+	}
+	req.URL.Host = reqHost
+}
+
+func (s *CookieHashSelection) rememberDialComponents(network, host, port string) {
+	if network != "" {
+		s.dialNetwork = network
+	}
+	if host != "" {
+		s.dialHost = host
+	}
+	if port != "" {
+		s.dialPort = port
+	}
+	if s.dialHost == "" && host != "" {
+		s.dialHost = host
+	}
+}
+
+func (s *CookieHashSelection) networkAddressOrJoin(addr caddy.NetworkAddress) string {
+	joined := addr.JoinHostPort(0)
+	if joined != "" {
+		return joined
+	}
+	if s.dialHost != "" && s.dialPort != "" {
+		return net.JoinHostPort(s.dialHost, s.dialPort)
+	}
+	if s.dialHost != "" {
+		return s.dialHost
+	}
+	return joined
+}
+
+func (s CookieHashSelection) headerFieldOr(defaultField string) string {
+	if s.headerField != "" {
+		return s.headerField
+	}
+	if defaultField == "" {
+		return s.headerField
+	}
+	return defaultField
+}
+
+func (s CookieHashSelection) trustedProxyEnabled() bool {
+	if s.headerTrustProxy {
+		return true
+	}
+	if s.headerField == "" && s.headerTrustProxy {
+		return true
+	}
+	return s.headerTrustProxy
+}
+
+// hashCookie hashes (HMAC 256) some data with the secret
+func hashCookie(secret string, data string) (string, error) {
+	return CookieHashSelection{Secret: secret}.hashStickyValue(data)
+}
+
+// selectRandomHost returns a random available host
+func selectRandomHost(pool []*Upstream) *Upstream {
+	return CookieHashSelection{}.reservoirSampleHost(pool)
+}
+
+// leastRequests returns the host with the
+// least number of active requests to it.
+// If more than one host has the same
+// least number of active requests, then
+// one of those is chosen at random.
+func leastRequests(upstreams []*Upstream) *Upstream {
+	return CookieHashSelection{}.pickLeastRequests(upstreams)
+}
+
+// hostByHashing returns an available host from pool based on a hashable string s.
+func hostByHashing(pool []*Upstream, s string) *Upstream {
+	return CookieHashSelection{hashKey: s}.highestWeightUpstream(pool)
+}
+
+// hash calculates a fast hash based on s.
+func hash(s string) uint32 {
+	return CookieHashSelection{hashKey: s}.hashString(s)
 }
 
 func loadFallbackPolicy(d *caddyfile.Dispenser) (json.RawMessage, error) {
