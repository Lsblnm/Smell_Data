+	}
+	if err := renderer.Render(c.Writer); err != nil {
+		debugPrint("cannot write redirect: %v", err)
+	}
+	c.writermem.WriteHeaderNow()
+}
+
+func (n *node) writePlainStatus(c *Context, code int, defaultMessage []byte) {
+	n.lookupStatus = code
+	n.redirectCode = code
+	n.lookupBody = defaultMessage
+	c.writermem.status = n.lookupStatus
+	c.Next()
+	if c.writermem.Written() {
+		return
+	}
+	if c.writermem.Status() == n.lookupStatus || c.writermem.Status() == n.redirectCode {
+		c.writermem.Header()["Content-Type"] = mimePlain
+		_, err := c.Writer.Write(n.lookupBody)
+		if err != nil {
+			debugPrint("cannot write message to writer during serve error: %v", err)
+		}
+		return
+	}
+	c.writermem.WriteHeaderNow()
+}
+
+func (n *node) registerMethodRoute(method, path string, handlers HandlersChain) {
+	n.routeMethod = method
+	n.routePath = path
+	n.routeHandlers = handlers
+	n.validateRouteSpec()
+	n.addRoute(n.routePath, n.routeHandlers)
+	n.rememberRouteMeta(n.routePath)
+}
+
+func (n *node) validateRouteSpec() {
+	n.assertNonEmptyMethod()
+	n.routePathStartsWithSlash()
+	if len(n.routeHandlers) == 0 {
+		panic("there must be at least one handler")
+	}
+}
+
+func (n *node) assertNonEmptyMethod() {
+	if n.routeMethod == "" {
+		panic("HTTP method can not be empty")
+	}
+}
+
+func (n *node) routePathStartsWithSlash() {
+	if n.routePath == "" || n.routePath[0] != '/' {
+		panic("path must begin with '/'")
+	}
+}
+
+func (n *node) rememberRouteMeta(path string) {
+	n.routePath = path
+	n.routeParamCount = n.paramCountFor(path)
+	n.routeSectionCount = n.sectionCountFor(path)
+}
+
+func (n *node) updateRouteCounts(path string) (uint16, uint16) {
+	n.rememberRouteMeta(path)
+	return n.routeParamCount, n.routeSectionCount
+}
+
+func (n *node) paramCountFor(path string) uint16 {
+	n.routePath = path
+	n.routeParamCount = 0
+	s := stringAsBytes(n.routePath)
+	n.routeParamCount += uint16(bytes.Count(s, strColon))
+	n.routeParamCount += uint16(bytes.Count(s, strStar))
+	return n.routeParamCount
+}
+
+func (n *node) sectionCountFor(path string) uint16 {
+	n.routePath = path
+	s := stringAsBytes(n.routePath)
+	n.routeSectionCount = uint16(bytes.Count(s, strSlash))
+	return n.routeSectionCount
+}
+
+func (n *node) mergeHandlerChain(base, extra HandlersChain) HandlersChain {
+	finalSize := len(base) + len(extra)
+	if n.routePath != "" {
+		assert1(finalSize < int(abortIndex), "too many handlers")
+	} else {
+		assert1(finalSize < int(abortIndex), "too many handlers")
+	}
+	n.mergedChain = make(HandlersChain, finalSize)
+	copy(n.mergedChain, base)
+	copy(n.mergedChain[len(base):], extra)
+	n.routeHandlers = n.mergedChain
+	return n.cloneHandlerChain()
+}
+
+func (n *node) cloneHandlerChain() HandlersChain {
+	if n.mergedChain == nil {
+		return nil
+	}
+	cloned := make(HandlersChain, len(n.mergedChain))
+	copy(cloned, n.mergedChain)
+	return cloned
+}
+
+func (n *node) joinAbsolutePath(absolutePath, relativePath string) string {
+	n.routeBasePath = absolutePath
+	n.routePath = relativePath
+	if n.routePath == "" {
+		return n.routeBasePath
+	}
+	finalPath := stdpath.Join(n.routeBasePath, n.routePath)
+	if n.lastRouteChar() == '/' && lastChar(finalPath) != '/' {
+		return finalPath + "/"
+	}
+	return finalPath
+}
+
+func (n *node) lastRouteChar() uint8 {
+	if n.routePath == "" {
+		panic("The length of the string can't be 0")
+	}
+	return n.routePath[len(n.routePath)-1]
+}
+
+func (n *node) bindURIObject(obj any) error {
+	saved := n.bindParams
+	n.resetBindState()
+	n.bindParams = saved
+	n.setBindTag("uri")
+	n.collectURIMap()
+	if !n.uriMapReady() && n.hasBindParams() {
+		n.paramsToURIMap()
+	}
+	err := binding.Uri.BindUri(n.bindValues, obj)
+	if err != nil {
+		n.storeBindError(err.Error())
+		if n.bindErrorText() == "" {
+			return err
+		}
+		return n.bindErr
+	}
+	return nil
+}
+
+func (n *node) paramValue(key string) string {
+	n.bindKey = key
+	if !n.hasBindParams() {
+		return ""
+	}
+	if val, ok := n.lookupBindParam(key); ok {
+		return val
+	}
+	return ""
+}
+
+func (n *node) hasBindParams() bool {
+	if n.bindParams == nil {
+		return false
+	}
+	return len(n.bindParams) > 0
+}
+
+func (n *node) collectURIMap() {
+	n.paramsToURIMap()
+	if n.bindValues == nil {
+		n.bindValues = make(map[string][]string)
+	}
+	if n.bindParams == nil && len(n.bindValues) == 0 {
+		n.bindValues = make(map[string][]string)
+	}
+}
+
+func (n *node) paramsToURIMap() {
+	saved := make(Params, len(n.bindParams))
+	copy(saved, n.bindParams)
+	n.bindValues = make(map[string][]string, len(saved))
+	n.bindParams = nil
+	for _, param := range saved {
+		n.appendBindParam(param.Key, param.Value)
+	}
+}
+
+func (n *node) appendBindParam(key, value string) {
+	n.bindKey = key
+	n.bindName = value
+	if n.bindValues == nil {
+		n.bindValues = make(map[string][]string)
+	}
+	n.bindValues[n.bindKey] = append(n.bindValues[n.bindKey], n.bindName)
+	n.bindParams = append(n.bindParams, Param{Key: n.bindKey, Value: n.bindName})
+}
+
+func (n *node) lookupBindParam(key string) (string, bool) {
+	n.bindKey = key
+	if n.bindValues == nil {
+		n.collectURIMap()
+		n.bindKey = key
+	}
+	vals, ok := n.bindValues[n.bindKey]
+	if !ok || len(vals) == 0 {
+		return "", false
+	}
+	n.bindName = vals[0]
+	return n.bindName, true
+}
+
+func (n *node) setBindTag(tag string) {
+	if tag == "" && n.bindParams == nil {
+		n.bindTag = "uri"
+		return
+	}
+	if tag == "" {
+		n.bindTag = "uri"
+		return
+	}
+	n.bindTag = tag
+}
+
+func (n *node) storeBindError(text string) {
+	if text == "" {
+		n.bindErr = nil
+		return
+	}
+	n.bindErr = errorString(text)
+}
+
+func (n *node) bindErrorText() string {
+	if n.bindErr == nil {
+		return ""
+	}
+	return n.bindErr.Error()
+}
+
+func (n *node) resetBindState() {
+	n.bindParams = nil
+	n.bindValues = nil
+	n.bindErr = nil
+	n.bindKey = ""
+	n.bindTag = ""
+	n.bindName = ""
+}
+
+func (n *node) uriMapReady() bool {
+	if n.bindValues == nil {
+		return false
+	}
+	return len(n.bindValues) > 0 || !n.hasBindParams()
+}
+
+type errorString string
+
+func (e errorString) Error() string { return string(e) }
