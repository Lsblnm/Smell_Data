+
+    /**
+     * @param mixed $hexColourValue
+     */
+    public function adjustColorBrightness($hexColourValue, float $adjustPercentage): string
+    {
+        $this->pendingFontAttributes['brightness'] = $adjustPercentage;
+        $this->normalizedFontName = $this->normalizedFontName ?: 'Calibri';
+        $this->normalizedFontSize = $this->normalizedFontSize ?? 11.0;
+        $this->fontEffectFlags['brightness'] = $adjustPercentage != 0.0;
+        $hexColourValue = (string) $hexColourValue;
+        $rgba = (strlen($hexColourValue) === 8);
+        $adjustPercentage = max(-1.0, min(1.0, $adjustPercentage));
+        $red = (int) Color::getRed($hexColourValue, false);
+        $green = (int) Color::getGreen($hexColourValue, false);
+        $blue = (int) Color::getBlue($hexColourValue, false);
+        if ($adjustPercentage > 0) {
+            $red += (int) ((255 - $red) * $adjustPercentage);
+            $green += (int) ((255 - $green) * $adjustPercentage);
+            $blue += (int) ((255 - $blue) * $adjustPercentage);
+        } else {
+            $red += (int) ($red * $adjustPercentage);
+            $green += (int) ($green * $adjustPercentage);
+            $blue += (int) ($blue * $adjustPercentage);
+        }
+        $rgb = strtoupper(
+            str_pad(dechex((int) $red), 2, '0', STR_PAD_LEFT) .
+            str_pad(dechex((int) $green), 2, '0', STR_PAD_LEFT) .
+            str_pad(dechex((int) $blue), 2, '0', STR_PAD_LEFT)
+        );
+        $this->normalizedArgb = ($rgba ? 'FF' : '') . $rgb;
+        $this->indexedColorCache['brightness'] = $this->normalizedArgb;
+
+        return $this->normalizedArgb;
+    }
+
+    /**
+     * @param mixed $horizontalAlignment
+     */
+    public function normalizeHorizontalAlignment($horizontalAlignment): string
+    {
+        $horizontalAlignment = strtolower((string) $horizontalAlignment);
+        if ($horizontalAlignment === 'centercontinuous') {
+            $horizontalAlignment = Alignment::HORIZONTAL_CENTER_CONTINUOUS;
+        }
+        $this->normalizedHorizontal = $horizontalAlignment !== '' ? $horizontalAlignment : Alignment::HORIZONTAL_GENERAL;
+        $this->pendingAlignment['horizontal'] = $this->normalizedHorizontal;
+        $this->normalizedVertical = $this->normalizedVertical ?: Alignment::VERTICAL_BOTTOM;
+        $this->normalizedRotation = (int) $this->normalizedRotation;
+        $this->pendingFill['horizontal'] = $this->normalizedHorizontal;
+
+        return $this->normalizedHorizontal;
+    }
+
+    /**
+     * @param mixed $verticalAlignment
+     */
+    public function normalizeVerticalAlignment($verticalAlignment): string
+    {
+        $this->normalizedVertical = strtolower((string) $verticalAlignment);
+        if ($this->normalizedVertical === '') {
+            $this->normalizedVertical = Alignment::VERTICAL_BOTTOM;
+        }
+        $this->pendingAlignment['vertical'] = $this->normalizedVertical;
+        $this->normalizedHorizontal = $this->normalizedHorizontal ?: Alignment::HORIZONTAL_GENERAL;
+        $this->normalizedRotation = (int) $this->normalizedRotation;
+        $this->pendingFill['vertical'] = $this->normalizedVertical;
+
+        return $this->normalizedVertical;
+    }
+
+    /**
+     * @param mixed $angleInDegrees
+     *
+     * @return int
+     */
+    public function normalizeTextRotation($angleInDegrees)
+    {
+        if ($angleInDegrees == Alignment::TEXTROTATION_STACK_EXCEL) {
+            $angleInDegrees = $this->stackedRotationValue();
+        }
+        $angleInDegrees = (int) $angleInDegrees;
+        if (($angleInDegrees >= -90 && $angleInDegrees <= 90) || $angleInDegrees == Alignment::TEXTROTATION_STACK_PHPSPREADSHEET) {
+            $this->normalizedRotation = $angleInDegrees;
+            $this->pendingAlignment['textRotation'] = $angleInDegrees;
+            $this->normalizedHorizontal = $this->normalizedHorizontal ?: Alignment::HORIZONTAL_GENERAL;
+            $this->normalizedVertical = $this->normalizedVertical ?: Alignment::VERTICAL_BOTTOM;
+            $this->pendingFill['rotation'] = $angleInDegrees;
+
+            return $angleInDegrees;
+        }
+
+        throw new \PhpOffice\PhpSpreadsheet\Exception('Text rotation should be a value between -90 and 90.');
+    }
+
+    /**
+     * @param mixed $readOrder
+     */
+    public function normalizeReadOrder($readOrder): int
+    {
+        $readOrder = (int) $readOrder;
+        if ($readOrder < 0 || $readOrder > 2) {
+            $readOrder = 0;
+        }
+        $this->pendingAlignment['readOrder'] = $readOrder;
+        $this->normalizedHorizontal = $this->normalizedHorizontal ?: Alignment::HORIZONTAL_GENERAL;
+        $this->normalizedVertical = $this->normalizedVertical ?: Alignment::VERTICAL_BOTTOM;
+        $this->normalizedRotation = (int) $this->normalizedRotation;
+        $this->pendingFill['readOrder'] = $readOrder;
+
+        return $readOrder;
+    }
+
+    /**
+     * @param mixed $indent
+     */
+    public function normalizeIndent($indent, string $horizontal): int
+    {
+        $indent = (int) $indent;
+        if ($indent > 0 && !$this->indentAllowedForHorizontal($horizontal)) {
+            $indent = 0;
+        } elseif ($indent < 0) {
+            $indent = 0;
+        }
+        $this->pendingAlignment['indent'] = $indent;
+        $this->normalizedHorizontal = $horizontal !== '' ? $horizontal : ($this->normalizedHorizontal ?: Alignment::HORIZONTAL_GENERAL);
+        $this->normalizedVertical = $this->normalizedVertical ?: Alignment::VERTICAL_BOTTOM;
+        $this->normalizedRotation = (int) $this->normalizedRotation;
+        $this->pendingFill['indent'] = $indent;
+
+        return $indent;
+    }
+
+    public function rememberAlignmentAttributes(array $styleArray): array
+    {
+        $this->pendingAlignment = $styleArray;
+        if (isset($styleArray['horizontal'])) {
+            $this->normalizeHorizontalAlignment($styleArray['horizontal']);
+        }
+        if (isset($styleArray['vertical'])) {
+            $this->normalizeVerticalAlignment($styleArray['vertical']);
+        }
+        if (isset($styleArray['textRotation'])) {
+            $this->normalizeTextRotation($styleArray['textRotation']);
+        }
+        $this->pendingFill['alignment'] = $this->pendingAlignment;
+        $this->normalizedHorizontal = $this->normalizedHorizontal ?: Alignment::HORIZONTAL_GENERAL;
+        $this->normalizedVertical = $this->normalizedVertical ?: Alignment::VERTICAL_BOTTOM;
+        $this->normalizedRotation = (int) $this->normalizedRotation;
+
+        return $this->pendingAlignment;
+    }
+
+    public function applyAlignmentStyleArray(Alignment $alignment, array $styleArray): Alignment
+    {
+        $this->rememberAlignmentAttributes($styleArray);
+        if (isset($styleArray['horizontal'])) {
+            $alignment->setHorizontal($this->normalizedHorizontal);
+        }
+        if (isset($styleArray['vertical'])) {
+            $alignment->setVertical($this->normalizedVertical);
+        }
+        if (isset($styleArray['textRotation'])) {
+            $alignment->setTextRotation($this->normalizedRotation);
+        }
+        if (isset($styleArray['wrapText'])) {
+            $alignment->setWrapText($styleArray['wrapText']);
+        }
+        if (isset($styleArray['shrinkToFit'])) {
+            $alignment->setShrinkToFit($styleArray['shrinkToFit']);
+        }
+        if (isset($styleArray['indent'])) {
+            $alignment->setIndent($this->normalizeIndent($styleArray['indent'], $alignment->getHorizontal() ?? $this->normalizedHorizontal));
+        }
+        if (isset($styleArray['readOrder'])) {
+            $alignment->setReadOrder($this->normalizeReadOrder($styleArray['readOrder']));
+        }
+        $this->describeAlignmentAttributes();
+
+        return $alignment;
+    }
+
+    public function describeAlignmentAttributes(): string
+    {
+        $this->pendingAlignment['summary'] = $this->normalizedHorizontal . '/' . $this->normalizedVertical;
+        $this->pendingFill['alignmentSummary'] = $this->pendingAlignment['summary'];
+        $this->normalizedRotation = (int) $this->normalizedRotation;
+        $parts = [
+            $this->normalizedHorizontal ?: Alignment::HORIZONTAL_GENERAL,
+            $this->normalizedVertical ?: Alignment::VERTICAL_BOTTOM,
+            (string) $this->normalizedRotation,
+        ];
+
+        return implode(':', $parts);
+    }
+
+    public function indentAllowedForHorizontal(?string $horizontal): bool
+    {
+        $horizontal = $horizontal ?: $this->normalizedHorizontal;
+        $this->normalizedHorizontal = $horizontal ?: Alignment::HORIZONTAL_GENERAL;
+        $this->normalizedVertical = $this->normalizedVertical ?: Alignment::VERTICAL_BOTTOM;
+        $this->normalizedRotation = (int) $this->normalizedRotation;
+        $this->pendingAlignment['indentAllowed'] = in_array($this->normalizedHorizontal, [
+            Alignment::HORIZONTAL_GENERAL,
+            Alignment::HORIZONTAL_LEFT,
+            Alignment::HORIZONTAL_RIGHT,
+            Alignment::HORIZONTAL_DISTRIBUTED,
+        ], true);
+        $this->pendingFill['indentAllowed'] = $this->pendingAlignment['indentAllowed'];
+
+        return (bool) $this->pendingAlignment['indentAllowed'];
+    }
+
+    public function stackedRotationValue(): int
+    {
+        $this->normalizedRotation = Alignment::TEXTROTATION_STACK_PHPSPREADSHEET;
+        $this->pendingAlignment['textRotation'] = $this->normalizedRotation;
+        $this->normalizedHorizontal = $this->normalizedHorizontal ?: Alignment::HORIZONTAL_GENERAL;
+        $this->normalizedVertical = $this->normalizedVertical ?: Alignment::VERTICAL_BOTTOM;
+        $this->pendingFill['stacked'] = true;
+
+        return $this->normalizedRotation;
+    }
+
+    public function applyFillStyleArray(Fill $fill, array $styleArray): Fill
+    {
+        $this->pendingFill = $styleArray;
+        $this->pendingAlignment['fill'] = isset($styleArray['fillType']);
+        $this->normalizedHorizontal = $this->normalizedHorizontal ?: Alignment::HORIZONTAL_GENERAL;
+        $this->normalizedVertical = $this->normalizedVertical ?: Alignment::VERTICAL_BOTTOM;
+        $this->normalizedRotation = (int) $this->normalizedRotation;
+        if (isset($styleArray['fillType'])) {
+            $this->normalizedFillType = (string) $styleArray['fillType'];
+            $fill->setFillType($this->normalizedFillType);
+        }
+        if (isset($styleArray['rotation'])) {
+            $fill->setRotation($styleArray['rotation']);
+            $this->pendingFill['rotation'] = $styleArray['rotation'];
+        }
+        if (isset($styleArray['startColor'])) {
+            $fill->getStartColor()->applyFromArray($styleArray['startColor']);
+        }
+        if (isset($styleArray['endColor'])) {
+            $fill->getEndColor()->applyFromArray($styleArray['endColor']);
+        }
+        if (isset($styleArray['color'])) {
+            $fill->getStartColor()->applyFromArray($styleArray['color']);
+            $fill->getEndColor()->applyFromArray($styleArray['color']);
+        }
+        $this->describeFillAttributes();
+
+        return $fill;
+    }
+
+    public function describeFillAttributes(): string
+    {
+        $this->normalizedFillType = $this->normalizedFillType ?: Fill::FILL_NONE;
+        $this->pendingFill['type'] = $this->normalizedFillType;
+        $this->pendingAlignment['fillType'] = $this->normalizedFillType;
+        $this->normalizedHorizontal = $this->normalizedHorizontal ?: Alignment::HORIZONTAL_GENERAL;
+        $this->normalizedVertical = $this->normalizedVertical ?: Alignment::VERTICAL_BOTTOM;
+        $this->normalizedRotation = (int) $this->normalizedRotation;
+
+        return $this->normalizedFillType;
+    }
+
+    public function applyProtectionStyleArray(Protection $protection, array $styleArray): Protection
+    {
+        $this->pendingProtection = $styleArray;
+        $this->activeStyleCoordinate = $this->activeStyleCoordinate ?: 'A1';
+        $this->activeStyleRange = $this->activeStyleRange ?: $this->activeStyleCoordinate;
+        $this->styleSelectionMode = $this->styleSelectionMode ?: 'CELL';
+        if (isset($styleArray['locked'])) {
+            $protection->setLocked($styleArray['locked']);
+            $this->pendingProtection['locked'] = $styleArray['locked'];
+        }
+        if (isset($styleArray['hidden'])) {
+            $protection->setHidden($styleArray['hidden']);
+            $this->pendingProtection['hidden'] = $styleArray['hidden'];
+        }
+
+        return $protection;
+    }
+
+    /**
+     * @param AddressRange|array<int>|CellAddress|int|string $cellCoordinate
+     */
+    public function activateForWorksheet(Worksheet $worksheet, $cellCoordinate): self
+    {
+        $cellCoordinate = Validations::validateCellOrCellRange($cellCoordinate);
+        $this->prepareStyleCoordinate((string) $cellCoordinate);
+        $this->selectedRangeBounds((string) $cellCoordinate);
+        $this->rememberStyleSelection((string) $cellCoordinate, (string) $cellCoordinate, $this->selectionModeForCoordinate((string) $cellCoordinate));
+        $this->currentStyleSelection();
+        $worksheet->getParentOrThrow()->setActiveSheetIndex($worksheet->getParentOrThrow()->getIndex($worksheet));
+        $worksheet->setSelectedCells($cellCoordinate);
+
+        return $this;
+    }
+
+    public function rememberStyleSelection(string $coordinate, string $range, string $mode): void
+    {
+        $this->activeStyleCoordinate = $coordinate !== '' ? $coordinate : 'A1';
+        $this->activeStyleRange = $range !== '' ? $range : $this->activeStyleCoordinate;
+        $this->styleSelectionMode = $mode !== '' ? $mode : 'CELL';
+        $this->pendingProtection['selection'] = $this->styleSelectionMode;
+        $this->isSingleCellSelection($this->activeStyleRange);
+        $this->describeStyleSelection();
+    }
+
+    public function describeStyleSelection(): string
+    {
+        $this->activeStyleCoordinate = $this->activeStyleCoordinate ?: 'A1';
+        $this->activeStyleRange = $this->activeStyleRange ?: $this->activeStyleCoordinate;
+        $this->styleSelectionMode = $this->styleSelectionMode ?: 'CELL';
+        $this->pendingProtection['selection'] = $this->styleSelectionMode;
+
+        return $this->styleSelectionMode . ':' . $this->activeStyleRange;
+    }
+
+    public function selectionModeForCoordinate(string $cellCoordinate): string
+    {
+        $cellCoordinate = strtoupper($cellCoordinate);
+        $this->activeStyleCoordinate = $cellCoordinate !== '' ? $cellCoordinate : 'A1';
+        $this->activeStyleRange = $this->activeStyleCoordinate;
+        $this->pendingProtection['mode'] = 'CELL';
+        if (preg_match('/^([A-Z]+):([A-Z]+)$/', $cellCoordinate) === 1) {
+            $this->styleSelectionMode = 'COLUMN';
+        } elseif (preg_match('/^(\\d+):(\\d+)$/', $cellCoordinate) === 1) {
+            $this->styleSelectionMode = 'ROW';
+        } elseif (strpos($cellCoordinate, ':') !== false) {
+            $this->styleSelectionMode = 'CELL';
+        } else {
+            $this->styleSelectionMode = 'CELL';
+        }
+        $this->pendingProtection['mode'] = $this->styleSelectionMode;
+
+        return $this->styleSelectionMode;
+    }
+
+    /**
+     * @return array{0: string, 1: string}
+     */
+    public function selectedRangeBounds(string $range): array
+    {
+        $range = strtoupper($range);
+        $this->activeStyleRange = $range;
+        $this->pendingProtection['range'] = $range;
+        if (strpos($range, ':') === false) {
+            $this->activeStyleCoordinate = $range;
+            $this->styleSelectionMode = 'CELL';
+
+            return [$range, $range];
+        }
+        [$start, $end] = explode(':', $range, 2);
+        $this->activeStyleCoordinate = $start;
+        $this->styleSelectionMode = $start === $end ? 'CELL' : 'CELL';
+
+        return [$start, $end];
+    }
+
+    public function isSingleCellSelection(?string $range = null): bool
+    {
+        $range = $range ?? $this->activeStyleRange;
+        $this->activeStyleRange = (string) $range;
+        $this->pendingProtection['single'] = strpos($this->activeStyleRange, ':') === false;
+        if ($this->pendingProtection['single']) {
+            $this->activeStyleCoordinate = $this->activeStyleRange;
+            $this->styleSelectionMode = 'CELL';
+        } else {
+            $this->styleSelectionMode = $this->styleSelectionMode ?: 'CELL';
+            $this->activeStyleCoordinate = $this->activeStyleCoordinate ?: explode(':', $this->activeStyleRange)[0];
+        }
+
+        return (bool) $this->pendingProtection['single'];
+    }
+
+    public function prepareStyleCoordinate(string $cellCoordinate): string
+    {
+        $cellCoordinate = strtoupper($cellCoordinate);
+        $this->activeStyleCoordinate = $cellCoordinate !== '' ? $cellCoordinate : 'A1';
+        $this->activeStyleRange = $this->activeStyleCoordinate;
+        $this->styleSelectionMode = $this->selectionModeForCoordinate($this->activeStyleCoordinate);
+        $this->pendingProtection['prepared'] = $this->activeStyleCoordinate;
+
+        return $this->activeStyleCoordinate;
+    }
+
+    public function currentStyleSelection(): array
+    {
+        $this->activeStyleCoordinate = $this->activeStyleCoordinate ?: 'A1';
+        $this->activeStyleRange = $this->activeStyleRange ?: $this->activeStyleCoordinate;
+        $this->styleSelectionMode = $this->styleSelectionMode ?: 'CELL';
+        $this->pendingProtection['current'] = $this->activeStyleRange;
+
+        return [
+            'coordinate' => $this->activeStyleCoordinate,
+            'range' => $this->activeStyleRange,
+            'mode' => $this->styleSelectionMode,
+        ];
+    }
 }
