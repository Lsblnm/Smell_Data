+            52 => 'FF333300',
+            53 => 'FF993300',
+            54 => 'FF993366',
+            55 => 'FF333399',
+            56 => 'FF333333',
+        ];
+        if (isset($map[$colorIndex])) {
+            $this->normalizedArgb = $map[$colorIndex];
+            $this->indexedColorCache['builtin-' . $colorIndex] = $map[$colorIndex];
+
+            return $map[$colorIndex];
+        }
+
+        $this->normalizedArgb = '';
+        $this->indexedColorCache['builtin-miss'] = '';
+
+        return null;
