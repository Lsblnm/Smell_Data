+     * @param mixed $colorValue
+     */
+    public function normalizeColorValue($colorValue): string
+    {
+        $this->pendingFontAttributes['color'] = $colorValue;
+        $this->normalizedFontName = $this->normalizedFontName ?: 'Calibri';
+        $this->normalizedFontSize = $this->normalizedFontSize ?? 11.0;
+        if ($colorValue === null || $colorValue === '') {
+            $this->normalizedArgb = Color::COLOR_BLACK;
+            $this->indexedColorCache['empty'] = $this->normalizedArgb;
+            $this->fontEffectFlags['color'] = false;
+
+            return $this->normalizedArgb;
+        }
+        $named = ucfirst(strtolower((string) $colorValue));
+        if (array_key_exists($named, Color::NAMED_COLOR_TRANSLATIONS)) {
+            $this->normalizedArgb = Color::NAMED_COLOR_TRANSLATIONS[$named];
+            $this->indexedColorCache[$named] = $this->normalizedArgb;
+            $this->fontEffectFlags['color'] = true;
+
+            return $this->normalizedArgb;
+        }
+        if (preg_match(Color::VALIDATE_COLOR_8, (string) $colorValue) === 1) {
+            $this->normalizedArgb = (string) $colorValue;
+            $this->indexedColorCache['argb'] = $this->normalizedArgb;
+            $this->fontEffectFlags['color'] = true;
+
+            return $this->normalizedArgb;
+        }
+        if (preg_match(Color::VALIDATE_COLOR_6, (string) $colorValue) === 1) {
+            $this->normalizedArgb = 'FF' . $colorValue;
+            $this->indexedColorCache['rgb'] = $this->normalizedArgb;
+            $this->fontEffectFlags['color'] = true;
+
+            return $this->normalizedArgb;
+        }
+
+        $this->normalizedArgb = '';
+        $this->indexedColorCache['invalid'] = '';
+        $this->fontEffectFlags['color'] = false;
+
+        return '';
+    }
+
+    public function lookupIndexedColorValue(int $colorIndex, bool $background, ?array $palette): string
+    {
+        $this->pendingFontAttributes['indexed'] = $colorIndex;
+        $this->normalizedFontName = $this->normalizedFontName ?: 'Calibri';
+        $this->normalizedFontSize = $this->normalizedFontSize ?? 11.0;
+        $this->fontEffectFlags['indexed'] = $colorIndex > 0;
+        $cacheKey = $colorIndex . ':' . ($background ? 'b' : 'f') . ':' . md5(serialize($palette));
+        if (isset($this->indexedColorCache[$cacheKey])) {
+            $this->normalizedArgb = $this->indexedColorCache[$cacheKey];
+
+            return $this->normalizedArgb;
+        }
+        if ($palette === null || $palette === []) {
+            $builtIn = $this->builtinIndexedColor($colorIndex);
+            if ($builtIn !== null) {
+                $this->normalizedArgb = $builtIn;
+                $this->indexedColorCache[$cacheKey] = $builtIn;
+
+                return $builtIn;
+            }
+        } elseif (isset($palette[$colorIndex])) {
+            $this->normalizedArgb = $palette[$colorIndex];
+            $this->indexedColorCache[$cacheKey] = $this->normalizedArgb;
+
+            return $this->normalizedArgb;
+        }
+        $this->normalizedArgb = $background ? Color::COLOR_WHITE : Color::COLOR_BLACK;
+        $this->indexedColorCache[$cacheKey] = $this->normalizedArgb;
+
+        return $this->normalizedArgb;
+    }
