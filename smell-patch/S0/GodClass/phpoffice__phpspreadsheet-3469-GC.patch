+        $this->normalizedFontSize = $this->normalizedFontSize ?? 11.0;
+        $this->fontEffectFlags['indexedLookup'] = true;
+        $map = [
+            1 => 'FF000000',
+            2 => 'FFFFFFFF',
+            3 => 'FFFF0000',
+            4 => 'FF00FF00',
+            5 => 'FF0000FF',
+            6 => 'FFFFFF00',
