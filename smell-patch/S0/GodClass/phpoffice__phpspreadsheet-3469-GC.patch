+            20 => 'FFCCFFFF',
+            21 => 'FF660066',
+            22 => 'FFFF8080',
+            23 => 'FF0066CC',
+            24 => 'FFCCCCFF',
+            25 => 'FF000080',
+            26 => 'FFFF00FF',
+            27 => 'FFFFFF00',
+            28 => 'FF00FFFF',
+            29 => 'FF800080',
+            30 => 'FF800000',
