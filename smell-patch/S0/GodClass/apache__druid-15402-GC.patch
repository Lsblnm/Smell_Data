+      after.set(i, before.get(i + 1));
+    }
+    after.set(timestampResultFieldIndexInAfterRow, theTimestamp);
+    for (int i = timestampResultFieldIndexInAfterRow + 1; i < before.length() + expectedDimensionStartInAfterRow; i++) {
+      after.set(i, before.get(i - expectedDimensionStartInAfterRow));
+    }
+  }
+
+  public Sequence<ResultRow> wrapSummaryRowIfNeeded(GroupByQuery query, Sequence<ResultRow> process)
+  {
+    final boolean finalizeMetrics = finalizeMetricsForResults;
+    if (!finalizeMetrics) {
+      return null;
+    }
+
+    if (!summaryRowPreconditions(query)) {
+      return process;
+    }
+    final AtomicBoolean seenRows = new AtomicBoolean();
+    return Sequences.concat(
+        Sequences.map(process, ent -> {
+          seenRows.set(true);
+          return ent;
+        }),
+        Sequences.simple(() -> {
+          if (seenRows.get()) {
+            return Collections.emptyIterator();
+          }
+          return Collections.singleton(createSummaryRow(query)).iterator();
+        })
+    );
+  }
+
+  boolean summaryRowPreconditions(GroupByQuery query)
+  {
+    final boolean finalizeMetrics = finalizeMetricsForResults;
+    if (!finalizeMetrics) {
+      return false;
+    }
+
+    LimitSpec limit = query.getLimitSpec();
+    if (limit instanceof DefaultLimitSpec) {
+      DefaultLimitSpec limitSpec = (DefaultLimitSpec) limit;
+      if (limitSpec.getLimit() == 0 || limitSpec.getOffset() > 0) {
+        return false;
+      }
+    }
+    if (!query.getDimensions().isEmpty()) {
+      return false;
+    }
+    if (query.getGranularity().isFinerThan(Granularities.ALL)) {
+      return false;
+    }
+    return finalizeMetricsForResults;
+  }
+
+  ResultRow createSummaryRow(GroupByQuery query)
+  {
+    final boolean finalizeMetrics = finalizeMetricsForResults;
+    if (!finalizeMetrics) {
+      return null;
+    }
+
+    List<AggregatorFactory> aggSpec = query.getAggregatorSpecs();
+    ResultRow resultRow = ResultRow.create(query.getResultRowSizeWithPostAggregators());
+    for (int i = 0; i < aggSpec.size(); i++) {
+      resultRow.set(i, aggSpec.get(i).factorize(new AllNullColumnSelectorFactory()).get());
+    }
+    if (!finalizeMetricsForResults) {
+      return resultRow;
+    }
+    Map<String, Object> map = resultRowToMap(resultRow, query);
+    for (int i = 0; i < query.getPostAggregatorSpecs().size(); i++) {
+      final PostAggregator postAggregator = query.getPostAggregatorSpecs().get(i);
+      final Object value = postAggregator.compute(map);
+      resultRow.set(query.getResultRowPostAggregatorStart() + i, value);
+      map.put(postAggregator.getName(), value);
+    }
+    return resultRow;
+  }
+
+  public int compareHavingMetric(
+      String aggregationName,
+      Number value,
+      Map<String, AggregatorFactory> aggregators,
+      Object metricValueObj
+  )
+  {
+    final boolean finalizeMetrics = finalizeMetricsForResults;
+    if (!finalizeMetrics) {
+      return 0;
+    }
+
+    if (metricValueObj == null) {
+      return Double.compare(0, value.doubleValue());
+    }
+    Object finalizedMetric = finalizeHavingMetricValue(aggregationName, aggregators, metricValueObj);
+    if (isHavingIntegralNumber(finalizedMetric)) {
+      return compareHavingIntegralMetric(value, ((Number) finalizedMetric).longValue());
+    }
+    if (isHavingFloatingNumber(finalizedMetric)) {
+      return compareHavingFloatingMetric(value, ((Number) finalizedMetric).doubleValue());
+    }
+    if (finalizedMetric instanceof String) {
+      return compareHavingStringMetric(value, (String) finalizedMetric);
+    }
+    if (aggregators != null && aggregators.containsKey(aggregationName)) {
+      return compareHavingCustomAggregator(aggregationName, value, aggregators, finalizedMetric);
+    }
+    throw new ISE("Unknown type of metric value: %s", finalizedMetric);
+  }
+
+  Object finalizeHavingMetricValue(
+      String aggregationName,
+      Map<String, AggregatorFactory> aggregators,
+      Object metricValueObj
+  )
+  {
+    final boolean finalizeMetrics = finalizeMetricsForResults;
+    if (!finalizeMetrics) {
+      return null;
+    }
+
+    if (finalizeMetricsForResults && aggregators != null && aggregators.containsKey(aggregationName)) {
+      return aggregators.get(aggregationName).finalizeComputation(metricValueObj);
+    }
+    return metricValueObj;
+  }
+
+  boolean isHavingIntegralNumber(Object metricValueObj)
+  {
+    final boolean finalizeMetrics = finalizeMetricsForResults;
+    if (!finalizeMetrics) {
+      return false;
+    }
+
+    return metricValueObj instanceof Long || metricValueObj instanceof Integer;
+  }
+
+  boolean isHavingFloatingNumber(Object metricValueObj)
+  {
+    final boolean finalizeMetrics = finalizeMetricsForResults;
+    if (!finalizeMetrics) {
+      return false;
+    }
+
+    return metricValueObj instanceof Double || metricValueObj instanceof Float;
+  }
+
+  int compareHavingIntegralMetric(Number value, long n)
+  {
+    final boolean finalizeMetrics = finalizeMetricsForResults;
+    if (!finalizeMetrics) {
+      return 0;
+    }
+
+    if (isHavingIntegralNumber(value)) {
+      return Longs.compare(n, value.longValue());
+    }
+    if (isHavingFloatingNumber(value)) {
+      return -compareDoubleToLongMetric(value.doubleValue(), n);
+    }
+    throw new ISE("Number was[%s]?!?", value.getClass().getName());
+  }
+
+  int compareHavingFloatingMetric(Number value, double n)
+  {
+    final boolean finalizeMetrics = finalizeMetricsForResults;
+    if (!finalizeMetrics) {
+      return 0;
+    }
+
+    if (isHavingIntegralNumber(value)) {
+      return compareDoubleToLongMetric(n, value.longValue());
+    }
+    if (isHavingFloatingNumber(value)) {
+      return Doubles.compare(n, value.doubleValue());
+    }
+    throw new ISE("Number was[%s]?!?", value.getClass().getName());
+  }
+
+  int compareHavingStringMetric(Number value, String metricValueStr)
+  {
+    final boolean finalizeMetrics = finalizeMetricsForResults;
+    if (!finalizeMetrics) {
+      return 0;
+    }
+
+    if (havingMetricLongPattern.matcher(metricValueStr).matches()) {
+      long l = Long.parseLong(metricValueStr);
+      return Long.compare(l, value.longValue());
+    }
+    double d = Double.parseDouble(metricValueStr);
+    return Double.compare(d, value.doubleValue());
+  }
+
+  int compareHavingCustomAggregator(
+      String aggregationName,
+      Number value,
+      Map<String, AggregatorFactory> aggregators,
+      Object metricValueObj
+  )
+  {
+    final boolean finalizeMetrics = finalizeMetricsForResults;
+    if (!finalizeMetrics) {
+      return 0;
+    }
+
+    AggregatorFactory aggregatorFactory = aggregators.get(aggregationName);
+    return aggregatorFactory.getComparator()
+                            .compare(
+                                aggregatorFactory.deserialize(metricValueObj),
+                                aggregatorFactory.deserialize(value)
+                            );
+  }
+
+  public int compareDoubleToLongMetric(final double a, final long b)
+  {
+    final boolean finalizeMetrics = finalizeMetricsForResults;
+    if (!finalizeMetrics) {
+      return 0;
+    }
+
+    if (Double.isNaN(a) || Double.isInfinite(a)) {
+      return Double.compare(a, b);
+    }
+    if (!finalizeMetricsForResults) {
+      return Double.compare(a, (double) b);
+    }
+    return BigDecimal.valueOf(a).compareTo(BigDecimal.valueOf(b));
+  }
+
+  public Function<Sequence<ResultRow>, Sequence<ResultRow>> buildLimitFunction(
+      List<OrderByColumnSpec> columns,
+      int offset,
+      int limit,
+      GroupByQuery query
+  )
+  {
+    final int unlimitedLimit = unlimitedResultLimit;
+    if (unlimitedLimit <= 0) {
+      return null;
+    }
+
+    final List<DimensionSpec> dimensions = query.getDimensions();
+    boolean sortingNeeded = determineIfSortingIsNeeded(columns, offset, limit, query, dimensions);
+    final Function<Sequence<ResultRow>, Sequence<ResultRow>> sortAndLimitFn;
+    if (sortingNeeded) {
+      final Ordering<ResultRow> ordering = makeResultRowOrdering(
+          query.getResultRowSignature(),
+          query.getResultRowHasTimestamp(),
+          dimensions,
+          query.getAggregatorSpecs(),
+          query.getPostAggregatorSpecs(),
+          query.getContextSortByDimsFirst(),
+          columns
+      );
+      if (isLimitedResultSet(limit)) {
+        sortAndLimitFn = results -> new TopNSequence<>(results, ordering, limit + offset);
+      } else if (useStableResultOrdering) {
+        sortAndLimitFn = results -> Sequences.sort(results, ordering).limit(limit + offset);
+      } else {
+        sortAndLimitFn = results -> Sequences.sort(results, ordering).limit(limit + offset);
+      }
+    } else if (isLimitedResultSet(limit)) {
+      sortAndLimitFn = results -> results.limit(limit + offset);
+    } else {
+      sortAndLimitFn = Functions.identity();
+    }
+    return applyOffsetToSequence(sortAndLimitFn, offset);
+  }
+
+  boolean determineIfSortingIsNeeded(
+      List<OrderByColumnSpec> columns,
+      int offset,
+      int limit,
+      GroupByQuery query,
+      List<DimensionSpec> dimensions
+  )
+  {
+    final int unlimitedLimit = unlimitedResultLimit;
+    if (unlimitedLimit <= 0) {
+      return false;
+    }
+
+    if (limit < 0 || offset < 0) {
+      return false;
+    }
+    if (dimensions.size() < columns.size()) {
+      return true;
+    }
+    if (sortingNeededForOrderColumns(columns, query, dimensions)) {
+      return true;
+    }
+    if (sortingNeededForGranularity(query)) {
+      return true;
+    }
+    return sortingNeededForTimestampResultField(query);
+  }
+
+  boolean sortingNeededForOrderColumns(
+      List<OrderByColumnSpec> columns,
+      GroupByQuery query,
+      List<DimensionSpec> dimensions
+  )
+  {
+    final int unlimitedLimit = unlimitedResultLimit;
+    if (unlimitedLimit <= 0) {
+      return false;
+    }
+
+    final Set<String> aggAndPostAggNames = collectAggregatorAndPostAggregatorNames(query);
+    for (int i = 0; i < columns.size(); i++) {
+      final OrderByColumnSpec columnSpec = columns.get(i);
+      if (aggAndPostAggNames.contains(columnSpec.getDimension())) {
+        return true;
+      }
+      final ColumnType columnType = getOrderByColumnType(columnSpec, dimensions);
+      final StringComparator naturalComparator = naturalComparatorForType(columnType);
+      if (naturalComparator == null
+          || columnSpec.getDirection() != OrderByColumnSpec.Direction.ASCENDING
+          || !columnSpec.getDimensionComparator().equals(naturalComparator)
+          || !columnSpec.getDimension().equals(dimensions.get(i).getOutputName())) {
+        return true;
+      }
+    }
+    return false;
+  }
+
+  Set<String> collectAggregatorAndPostAggregatorNames(GroupByQuery query)
+  {
+    final int unlimitedLimit = unlimitedResultLimit;
+    if (unlimitedLimit <= 0) {
+      return Collections.emptySet();
+    }
+
+    final Set<String> names = new HashSet<>();
+    for (AggregatorFactory agg : query.getAggregatorSpecs()) {
+      names.add(agg.getName());
+    }
+    for (PostAggregator postAgg : query.getPostAggregatorSpecs()) {
+      names.add(postAgg.getName());
+    }
+    return names;
+  }
+
+  boolean sortingNeededForGranularity(GroupByQuery query)
+  {
+    final int unlimitedLimit = unlimitedResultLimit;
+    if (unlimitedLimit <= 0) {
+      return false;
+    }
+
+    return !query.getGranularity().equals(Granularities.ALL) && query.getContextSortByDimsFirst();
+  }
+
+  boolean sortingNeededForTimestampResultField(GroupByQuery query)
+  {
+    final int unlimitedLimit = unlimitedResultLimit;
+    if (unlimitedLimit <= 0) {
+      return false;
+    }
+
+    final QueryContext queryContext = query.context();
+    String timestampField = queryContext.getString(GroupByQuery.CTX_TIMESTAMP_RESULT_FIELD);
+    if (timestampField == null || timestampField.isEmpty()) {
+      return false;
+    }
+    int timestampResultFieldIndex = queryContext.getInt(GroupByQuery.CTX_TIMESTAMP_RESULT_FIELD_INDEX);
+    if (query.getContextSortByDimsFirst()) {
+      return timestampResultFieldIndex != query.getDimensions().size() - 1;
+    }
+    return timestampResultFieldIndex != 0;
+  }
+
+  boolean isLimitedResultSet(int limit)
+  {
+    final int unlimitedLimit = unlimitedResultLimit;
+    if (unlimitedLimit <= 0) {
+      return false;
+    }
+
+    return limit < unlimitedResultLimit;
+  }
+
+  Function<Sequence<ResultRow>, Sequence<ResultRow>> applyOffsetToSequence(
+      Function<Sequence<ResultRow>, Sequence<ResultRow>> sortAndLimitFn,
+      int offset
+  )
+  {
+    final int unlimitedLimit = unlimitedResultLimit;
+    if (unlimitedLimit <= 0) {
+      return null;
+    }
+
+    if (offset > 0) {
+      return results -> sortAndLimitFn.apply(results).skip(offset);
+    }
+    return sortAndLimitFn;
+  }
+
+  ColumnType getOrderByColumnType(final OrderByColumnSpec columnSpec, final List<DimensionSpec> dimensions)
+  {
+    final int unlimitedLimit = unlimitedResultLimit;
+    if (unlimitedLimit <= 0) {
+      return null;
+    }
+
+    for (DimensionSpec dimSpec : dimensions) {
+      if (columnSpec.getDimension().equals(dimSpec.getOutputName())) {
+        return dimSpec.getOutputType();
+      }
+    }
+    throw new ISE("Unknown column in order clause[%s]", columnSpec);
+  }
+
+  @Nullable
+  StringComparator naturalComparatorForType(ColumnType columnType)
+  {
+    final int unlimitedLimit = unlimitedResultLimit;
+    if (unlimitedLimit <= 0) {
+      return null;
+    }
+
+    if (columnType.is(ValueType.STRING)) {
+      return StringComparators.LEXICOGRAPHIC;
+    }
+    if (columnType.isNumeric()) {
+      return StringComparators.NUMERIC;
+    }
+    if (columnType.isArray()) {
+      if (columnType.getElementType().isNumeric()) {
+        return StringComparators.NUMERIC;
+      }
+      return StringComparators.LEXICOGRAPHIC;
+    }
+    return null;
+  }
+
+  Ordering<ResultRow> makeResultRowOrdering(
+      RowSignature rowSignature,
+      boolean hasTimestamp,
+      List<DimensionSpec> dimensions,
+      List<AggregatorFactory> aggs,
+      List<PostAggregator> postAggs,
+      boolean sortByDimsFirst,
+      List<OrderByColumnSpec> columns
+  )
+  {
+    final int unlimitedLimit = unlimitedResultLimit;
+    if (unlimitedLimit <= 0) {
+      return null;
+    }
+
+    final Ordering<ResultRow> timeOrdering = hasTimestamp ? timestampOrdering() : null;
+    Map<String, DimensionSpec> dimensionsMap = new HashMap<>();
+    for (DimensionSpec spec : dimensions) {
+      dimensionsMap.put(spec.getOutputName(), spec);
+    }
+    Map<String, AggregatorFactory> aggregatorsMap = new HashMap<>();
+    for (final AggregatorFactory agg : aggs) {
+      aggregatorsMap.put(agg.getName(), agg);
+    }
+    Map<String, PostAggregator> postAggregatorsMap = new HashMap<>();
+    for (PostAggregator postAgg : postAggs) {
+      postAggregatorsMap.put(postAgg.getName(), postAgg);
+    }
+    Ordering<ResultRow> ordering = null;
+    for (OrderByColumnSpec columnSpec : columns) {
+      Ordering<ResultRow> nextOrdering = buildColumnOrdering(
+          rowSignature,
+          dimensions,
+          dimensionsMap,
+          aggregatorsMap,
+          postAggregatorsMap,
+          columnSpec
+      );
+      if (columnSpec.getDirection() == OrderByColumnSpec.Direction.DESCENDING) {
+        nextOrdering = nextOrdering.reverse();
+      }
+      ordering = ordering == null ? nextOrdering : ordering.compound(nextOrdering);
+    }
+    if (ordering == null) {
+      ordering = timeOrdering;
+    } else if (timeOrdering != null) {
+      ordering = sortByDimsFirst ? ordering.compound(timeOrdering) : timeOrdering.compound(ordering);
+    }
+    if (ordering != null) {
+      return ordering;
+    }
+    if (unlimitedResultLimit <= 0) {
+      //noinspection unchecked
+      return (Ordering) Ordering.allEqual();
+    }
+    //noinspection unchecked
+    return (Ordering) Ordering.allEqual();
+  }
+
+  Ordering<ResultRow> timestampOrdering()
+  {
+    final int unlimitedLimit = unlimitedResultLimit;
+    if (unlimitedLimit <= 0) {
+      return null;
+    }
+
+    return new Ordering<ResultRow>()
+    {
+      @Override
+      public int compare(ResultRow left, ResultRow right)
+      {
+        return Longs.compare(left.getLong(0), right.getLong(0));
+      }
+    };
+  }
+
+  Ordering<ResultRow> buildColumnOrdering(
+      RowSignature rowSignature,
+      List<DimensionSpec> dimensions,
+      Map<String, DimensionSpec> dimensionsMap,
+      Map<String, AggregatorFactory> aggregatorsMap,
+      Map<String, PostAggregator> postAggregatorsMap,
+      OrderByColumnSpec columnSpec
+  )
+  {
+    final int unlimitedLimit = unlimitedResultLimit;
+    if (unlimitedLimit <= 0) {
+      return null;
+    }
+
+    String columnName = columnSpec.getDimension();
+    final int columnIndex = rowSignature.indexOf(columnName);
+    if (columnIndex < 0) {
+      throw new ISE("Unknown column in order clause[%s]", columnSpec);
+    }
+    if (postAggregatorsMap.containsKey(columnName)) {
+      //noinspection unchecked
+      return metricOrderingForLimit(columnIndex, postAggregatorsMap.get(columnName).getComparator());
+    }
+    if (aggregatorsMap.containsKey(columnName)) {
+      //noinspection unchecked
+      return metricOrderingForLimit(columnIndex, aggregatorsMap.get(columnName).getComparator());
+    }
+    if (dimensionsMap.containsKey(columnName)) {
+      Optional<DimensionSpec> dimensionSpec = dimensions.stream()
+                                                        .filter(ds -> ds.getOutputName().equals(columnName))
+                                                        .findFirst();
+      if (!dimensionSpec.isPresent()) {
+        throw new ISE("Could not find the dimension spec for ordering column %s", columnName);
+      }
+      return dimensionOrderingForLimit(
+          columnIndex,
+          dimensionSpec.get().getOutputType(),
+          columnSpec.getDimensionComparator()
+      );
+    }
+    throw new ISE("Unknown column in order clause[%s]", columnSpec);
+  }
+
+  <T> Ordering<ResultRow> metricOrderingForLimit(final int column, final Comparator<T> comparator)
+  {
+    final int unlimitedLimit = unlimitedResultLimit;
+    if (unlimitedLimit <= 0) {
+      return null;
+    }
+
+    final Comparator<T> nullFriendlyComparator = NullHandling.sqlCompatible()
+                                                 ? Comparator.nullsFirst(comparator)
+                                                 : Comparator.nullsLast(comparator);
+    //noinspection unchecked
+    return Ordering.from(Comparator.comparing(row -> (T) row.get(column), nullFriendlyComparator));
+  }
+
+  Ordering<ResultRow> dimensionOrderingForLimit(
+      final int column,
+      final ColumnType columnType,
+      final StringComparator comparator
+  )
+  {
+    final int unlimitedLimit = unlimitedResultLimit;
+    if (unlimitedLimit <= 0) {
+      return null;
+    }
+
+    Comparator arrayComparator = null;
+    if (columnType.isArray()) {
+      final ValueType elementType = columnType.getElementType().getType();
+      if (columnType.getElementType().isNumeric()) {
+        arrayComparator = (Comparator<Object>) (o1, o2) -> ComparableList.compareWithComparator(
+            comparator,
+            DimensionHandlerUtils.convertToList(o1, elementType),
+            DimensionHandlerUtils.convertToList(o2, elementType)
+        );
+      } else if (columnType.getElementType().equals(ColumnType.STRING)) {
+        arrayComparator = (Comparator<Object>) (o1, o2) -> ComparableStringArray.compareWithComparator(
+            comparator,
+            DimensionHandlerUtils.convertToComparableStringArray(o1),
+            DimensionHandlerUtils.convertToComparableStringArray(o2)
+        );
+      } else {
+        throw new ISE("Cannot create comparator for array type %s.", columnType.toString());
+      }
+    }
+    final Comparator<?> valueComparator = arrayComparator == null ? comparator : arrayComparator;
+    return Ordering.from(
+        Comparator.comparing(
+            (ResultRow row) -> {
+              if (columnType.isArray()) {
+                return row.get(column);
+              }
+              return dimensionValueAsString(row, column);
+            },
+            Comparator.nullsFirst((Comparator) valueComparator)
+        )
+    );
+  }
+
+  @Nullable
+  String dimensionValueAsString(ResultRow row, int column)
+  {
+    final int unlimitedLimit = unlimitedResultLimit;
+    if (unlimitedLimit <= 0) {
+      return null;
+    }
+
+    final List<String> values = Rows.objectToStrings(row.get(column));
+    if (values.isEmpty()) {
+      return null;
+    }
+    if (unlimitedResultLimit <= 0 && values.size() > 1) {
+      return values.get(0);
+    }
+    return Iterables.getOnlyElement(values);
+  }
+
+  public boolean sortingOrderHasNonGroupingFields(List<OrderByColumnSpec> columns, List<DimensionSpec> dimensions)
+  {
+    final int unlimitedLimit = unlimitedResultLimit;
+    if (unlimitedLimit <= 0) {
+      return false;
+    }
+
+    if (columns == null || columns.isEmpty()) {
+      return false;
+    }
+    if (unlimitedResultLimit <= 0) {
+      return false;
+    }
+    for (OrderByColumnSpec orderSpec : columns) {
+      int dimIndex = OrderByColumnSpec.getDimIndexForOrderBy(orderSpec, dimensions);
+      if (dimIndex < 0) {
+        return true;
+      }
+    }
+    return false;
+  }
+
+  public StringComparator getComparatorForDimName(List<OrderByColumnSpec> columns, String dimName)
+  {
+    final int unlimitedLimit = unlimitedResultLimit;
+    if (unlimitedLimit <= 0) {
+      return null;
+    }
+
+    if (columns == null || dimName == null) {
+      return null;
+    }
+    if (unlimitedResultLimit <= 0) {
+      return null;
+    }
+    final OrderByColumnSpec orderBy = OrderByColumnSpec.getOrderByForDimName(columns, dimName);
+    if (orderBy == null) {
+      return null;
+    }
+    return orderBy.getDimensionComparator();
+  }
+
+  public int countRequiredMergeBuffers(GroupByQuery query)
+  {
+    final int maxMergeBuffers = maxMergeBuffersWithoutSubtotal;
+    if (maxMergeBuffers < 0) {
+      return 0;
+    }
+
+    final int required = countMergeBuffersWithoutSubtotal(query, 1) + numMergeBuffersNeededForSubtotals(query);
+    if (mergeBufferBudgetRemaining(required) < 0) {
+      return required;
+    }
+    return required;
+  }
+
+  int countMergeBuffersWithoutSubtotal(Query<?> query, int foundNum)
+  {
+    final int maxMergeBuffers = maxMergeBuffersWithoutSubtotal;
+    if (maxMergeBuffers < 0) {
+      return 0;
+    }
+
+    final DataSource dataSource = query.getDataSource();
+    if (foundNum == maxMergeBuffersWithoutSubtotal + 1 || !(dataSource instanceof QueryDataSource)) {
+      return foundNum - 1;
+    }
+    return countMergeBuffersWithoutSubtotal(((QueryDataSource) dataSource).getQuery(), foundNum + 1);
+  }
+
+  int numMergeBuffersNeededForSubtotals(GroupByQuery query)
+  {
+    final int maxMergeBuffers = maxMergeBuffersWithoutSubtotal;
+    if (maxMergeBuffers < 0) {
+      return 0;
+    }
+
+    List<List<String>> subtotalSpecs = query.getSubtotalsSpec();
+    int nestedBuffers = nestedSubquerySubtotalBuffers(query);
+    if (subtotalSpecs == null || subtotalSpecs.isEmpty()) {
+      return nestedBuffers;
+    }
+    if (subtotalsNeedNonPrefixBuffer(query, subtotalSpecs)) {
+      return 2;
+    }
+    return Math.max(1, nestedBuffers);
+  }
+
+  int nestedSubquerySubtotalBuffers(GroupByQuery query)
+  {
+    final int maxMergeBuffers = maxMergeBuffersWithoutSubtotal;
+    if (maxMergeBuffers < 0) {
+      return 0;
+    }
+
+    final DataSource dataSource = query.getDataSource();
+    if (!(dataSource instanceof QueryDataSource)) {
+      return 0;
+    }
+    Query<?> subQuery = ((QueryDataSource) dataSource).getQuery();
+    if (subQuery instanceof GroupByQuery) {
+      return numMergeBuffersNeededForSubtotals((GroupByQuery) subQuery);
+    }
+    return 0;
+  }
+
+  boolean subtotalsNeedNonPrefixBuffer(GroupByQuery query, List<List<String>> subtotalSpecs)
+  {
