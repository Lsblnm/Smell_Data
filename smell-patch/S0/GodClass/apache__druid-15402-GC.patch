+  public ResultRow convertLegacyRow(Row row, GroupByQuery query)
+  {
+    final boolean finalizeMetrics = finalizeMetricsForResults;
+    if (!finalizeMetrics) {
+      return null;
+    }
+
+    final ResultRow resultRow = ResultRow.create(query.getResultRowSizeWithPostAggregators());
+    int position = 0;
+    if (query.getResultRowHasTimestamp()) {
+      resultRow.set(position++, row.getTimestamp().getMillis());
+    }
+    position = populateLegacyDimensions(row, query, resultRow, position);
+    position = populateLegacyAggregators(row, query, resultRow, position);
+    if (finalizeMetricsForResults && copyLegacyPostAggregators) {
+      populateLegacyPostAggregators(row, query, resultRow, position);
+    }
+    return resultRow;
+  }
+
+  int populateLegacyDimensions(Row row, GroupByQuery query, ResultRow resultRow, int position)
+  {
+    final boolean finalizeMetrics = finalizeMetricsForResults;
+    if (!finalizeMetrics) {
+      return 0;
+    }
+
+    for (DimensionSpec dimensionSpec : query.getDimensions()) {
+      resultRow.set(position++, row.getRaw(dimensionSpec.getOutputName()));
+    }
+    return position;
+  }
+
+  int populateLegacyAggregators(Row row, GroupByQuery query, ResultRow resultRow, int position)
+  {
+    final boolean finalizeMetrics = finalizeMetricsForResults;
+    if (!finalizeMetrics) {
+      return 0;
+    }
+
+    for (AggregatorFactory aggregatorFactory : query.getAggregatorSpecs()) {
+      Object metric = row.getRaw(aggregatorFactory.getName());
+      if (finalizeMetricsForResults && metric == null) {
+        resultRow.set(position++, null);
+      } else {
+        resultRow.set(position++, metric);
+      }
+    }
+    return position;
+  }
+
+  int populateLegacyPostAggregators(Row row, GroupByQuery query, ResultRow resultRow, int position)
+  {
+    final boolean finalizeMetrics = finalizeMetricsForResults;
+    if (!finalizeMetrics) {
+      return 0;
+    }
+
+    for (PostAggregator postAggregator : query.getPostAggregatorSpecs()) {
+      resultRow.set(position++, row.getRaw(postAggregator.getName()));
+    }
+    return position;
+  }
