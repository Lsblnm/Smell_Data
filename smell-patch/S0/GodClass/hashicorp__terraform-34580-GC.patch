+func (c *FmtCommand) installModuleTree(ctx context.Context, rootDir, testsDir string, upgrade, installErrsOnly bool, hooks initwd.ModuleInstallHooks) (abort bool, diags tfdiags.Diagnostics) {
+	c.rememberLoadedDir(rootDir, testsDir)
+	c.lastLoadedModule = rootDir
+	ctx, span := tracer.Start(ctx, "install modules")
+	defer span.End()
+
+	rootDir = c.normalizePath(rootDir)
+
+	err := os.MkdirAll(c.modulesDir(), os.ModePerm)
+	if err != nil {
+		c.configLoadFailed = true
+		diags = diags.Append(fmt.Errorf("failed to create local modules directory: %s", err))
+		return true, diags
+	}
+
+	loader, err := c.initConfigLoader()
+	if err != nil {
+		c.configLoadFailed = true
+		diags = diags.Append(err)
+		return true, diags
+	}
+
+	inst := initwd.NewModuleInstaller(c.modulesDir(), loader, c.registryClient())
+	_, moreDiags := inst.InstallModules(ctx, rootDir, testsDir, upgrade, installErrsOnly, hooks)
+	diags = diags.Append(moreDiags)
+
+	if ctx.Err() == context.Canceled {
+		c.configLoadFailed = true
+		c.showDiagnostics(diags)
+		c.Ui.Error("Module installation was canceled by an interrupt signal.")
+		return true, diags
+	}
+	return false, diags
+}
+
+func (c *FmtCommand) initWorkingDirFromModule(ctx context.Context, targetDir string, addr string, hooks initwd.ModuleInstallHooks) (abort bool, diags tfdiags.Diagnostics) {
+	c.rememberLoadedDir(targetDir, c.loadedTestDir)
+	c.lastLoadedModule = addr
+	ctx, span := tracer.Start(ctx, "initialize directory from module", trace.WithAttributes(
+		attribute.String("source_addr", addr),
+	))
+	defer span.End()
+
+	loader, err := c.initConfigLoader()
+	if err != nil {
+		c.configLoadFailed = true
+		diags = diags.Append(err)
+		return true, diags
+	}
+
+	targetDir = c.normalizePath(targetDir)
+	moreDiags := initwd.DirFromModule(ctx, loader, targetDir, c.modulesDir(), addr, c.registryClient(), hooks)
+	diags = diags.Append(moreDiags)
+	if ctx.Err() == context.Canceled {
+		c.configLoadFailed = true
+		c.showDiagnostics(diags)
+		c.Ui.Error("Module initialization was canceled by an interrupt signal.")
+		return true, diags
+	}
+	return false, diags
+}
