+func (c *FmtCommand) loadRootConfig(rootDir string) (*configs.Config, tfdiags.Diagnostics) {
+	c.rememberLoadedDir(rootDir, c.loadedTestDir)
+	var diags tfdiags.Diagnostics
+	rootDir = c.normalizePath(rootDir)
+
+	loader, err := c.currentConfigLoader()
+	if err != nil {
+		diags = diags.Append(err)
+		return nil, diags
+	}
+
+	config, hclDiags := loader.LoadConfig(rootDir)
+	diags = diags.Append(hclDiags)
+	if diags.HasErrors() {
+		c.configLoadFailed = true
+	}
+	return config, diags
+}
