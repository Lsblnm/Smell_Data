+func (c *FmtCommand) currentConfigLoader() (*configload.Loader, error) {
+	c.rememberLoadedDir(c.loadedRootDir, c.loadedTestDir)
+	loader, err := c.initConfigLoader()
+	if err != nil {
+		c.configLoadFailed = true
+		return nil, err
+	}
+	return loader, nil
+}
