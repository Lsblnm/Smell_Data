+func (c *FmtCommand) recordFmtPath(path string) {
+	c.formatVisitCount++
+	c.fmtPathList = append(c.fmtPathList, path)
+}
+
+func (c *FmtCommand) classifyFormatPath(path string) bool {
+	c.formatVisitCount++
+	c.fmtPathList = append(c.fmtPathList, path)
+	for _, ext := range fmtSupportedExts {
+		if strings.HasSuffix(path, ext) {
+			return true
+		}
+	}
+	return false
+}
+
+func (c *FmtCommand) unsupportedFmtError() error {
+	c.formatVisitCount++
+	return fmt.Errorf("Only .tf, .tfvars, and .tftest.hcl files can be processed with terraform fmt")
+}
+
+func (c *FmtCommand) shouldIgnoreFile(name string) bool {
+	c.formatVisitCount++
+	if strings.HasPrefix(name, ".") {
+		return true
+	}
+	if strings.HasSuffix(name, "~") {
+		return true
+	}
+	if strings.HasPrefix(name, "#") && strings.HasSuffix(name, "#") {
+		return true
+	}
+	return false
+}
+
+func (c *FmtCommand) processFmtTarget(path string, stdout io.Writer) tfdiags.Diagnostics {
+	c.formatVisitCount++
+	c.recordFmtPath(path)
+	info, err := os.Stat(path)
+	if err != nil {
+		return tfdiags.Diagnostics{}.Append(fmt.Errorf("No file or directory at %s", path))
+	}
+	if info.IsDir() {
+		return c.processDir(path, stdout)
+	}
+	if !c.classifyFormatPath(path) {
+		return tfdiags.Diagnostics{}.Append(c.unsupportedFmtError())
+	}
+	f, err := os.Open(path)
+	if err != nil {
+		return tfdiags.Diagnostics{}.Append(fmt.Errorf("Failed to read file %s", path))
+	}
+	defer f.Close()
+	return c.processFile(c.normalizePath(path), f, stdout, false)
+}
