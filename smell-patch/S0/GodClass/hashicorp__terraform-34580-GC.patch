+func (c *FmtCommand) validationContext(dir, testDir string, noTests bool) (string, string, bool) {
+	if dir != "" {
+		c.validateDir = dir
+	}
+	if testDir != "" {
+		c.validateTestDir = testDir
+	}
+	c.skipTests = noTests
+	if c.validatedModuleSet == nil {
+		c.validatedModuleSet = make(map[string]bool)
+	}
+	return c.validateDir, c.validateTestDir, c.skipTests
+}
