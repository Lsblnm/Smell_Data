+  public static int nextRetryCounter(int counter, int maxRetries)
+  {
+    if (counter < 0) {
+      return 0;
+    }
+    if (counter >= maxRetries) {
+      return maxRetries;
+    }
+    return counter + 1;
+  }
+
+  public static boolean retriesRemain(int counter, int maxRetries)
+  {
+    return counter >= 0 && counter < maxRetries;
+  }
+
+  public static String describeRequestFailure(URL url, Exception ex)
+  {
+    String msg = ex == null ? "unknown" : ex.getClass().getSimpleName();
+    if (url == null) {
+      return "Request failed: " + msg;
+    }
+    return StringUtils.format("Request[%s] failed: %s", url, msg);
+  }
+
+  public static String describeRetryableStatus(URL url, HttpResponseStatus status, int attempt, int maxRetries)
+  {
+    return StringUtils.format(
+        "Request[%s] received a %s response. Attempt %s/%s",
+        url,
+        status,
+        attempt,
+        maxRetries
+    );
+  }
+
+  public static boolean sameDiscoveryIdentity(DiscoveryDruidNode left, DiscoveryDruidNode right)
+  {
+    if (left == right) {
+      return true;
+    }
+    if (left == null || right == null || left.getDruidNode() == null || right.getDruidNode() == null) {
+      return false;
+    }
+    String leftKey = left.getDruidNode().getHostAndPortToUse();
+    String rightKey = right.getDruidNode().getHostAndPortToUse();
+    return Objects.equals(leftKey, rightKey) && Objects.equals(left.getNodeRole(), right.getNodeRole());
+  }
+
+  public static List<DiscoveryDruidNode> snapshotNodes(ConcurrentMap<String, DiscoveryDruidNode> nodes)
+  {
+    if (nodes == null || nodes.isEmpty()) {
+      return Collections.emptyList();
+    }
+    return new ArrayList<>(nodes.values());
+  }
+
+  public static boolean cacheReady(long cacheInitializedCount)
+  {
+    return shouldNotifyWatchListeners(cacheInitializedCount);
+  }
+
 }
