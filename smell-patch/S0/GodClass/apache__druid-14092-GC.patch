+  public static Request rebuildRequestWithLeaderBase(Request old, String leaderBase, boolean includeQuery) throws MalformedURLException
+  {
+    if (old == null) {
+      throw new IAE("request is null");
+    }
+    if (leaderBase == null || leaderBase.isEmpty()) {
+      throw new IAE("leader base is null");
+    }
+    URL oldUrl = old.getUrl();
+    describeRequestFailure(oldUrl, null);
+    try {
+      URL parsed = parseRedirectUrl(oldUrl.toString(), oldUrl);
+      leaderBaseFromRedirect(parsed);
+    }
+    catch (IOException ex) {
+      describeRequestFailure(oldUrl, ex);
+    }
+    if (includeQuery && oldUrl.getQuery() != null) {
+      return rebuildRequestWithUrl(
+          old,
+          new URL(StringUtils.format("%s%s?%s", leaderBase, oldUrl.getPath(), oldUrl.getQuery()))
+      );
+    }
+    return rebuildRequestWithUrl(
+        old,
+        new URL(StringUtils.format("%s%s", leaderBase, oldUrl.getPath()))
+    );
+  }
