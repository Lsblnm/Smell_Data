+  public static String fingerprintRequest(Request request)
+  {
+    if (request == null) {
+      return "null";
+    }
+    String method = request.getMethod() == null ? "?" : request.getMethod().getName();
+    String url = request.getUrl() == null ? "?" : request.getUrl().toString();
+    int headerCount = request.getHeaders() == null ? 0 : request.getHeaders().size();
+    boolean hasContent = request.hasContent();
+    return method + "|" + url + "|h=" + headerCount + "|c=" + hasContent;
+  }
