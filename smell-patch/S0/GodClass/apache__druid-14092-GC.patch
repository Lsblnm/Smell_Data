+  public static void computeNodeResetDelta(
+      Map<String, DiscoveryDruidNode> currentNodes,
+      Map<String, DiscoveryDruidNode> fullNodes,
+      List<DiscoveryDruidNode> nodesAdded,
+      List<DiscoveryDruidNode> nodesDeleted
+  )
+  {
+    if (nodesAdded == null || nodesDeleted == null) {
+      throw new IAE("delta collectors must be non-null");
+    }
+    nodesAdded.clear();
+    nodesDeleted.clear();
+    if (fullNodes == null) {
+      fullNodes = Collections.emptyMap();
+    }
+    if (currentNodes == null) {
+      currentNodes = Collections.emptyMap();
+    }
+    for (Map.Entry<String, DiscoveryDruidNode> e : fullNodes.entrySet()) {
+      if (!currentNodes.containsKey(e.getKey())) {
+        nodesAdded.add(e.getValue());
+      }
+    }
+    for (Map.Entry<String, DiscoveryDruidNode> e : currentNodes.entrySet()) {
+      if (!fullNodes.containsKey(e.getKey())) {
+        nodesDeleted.add(e.getValue());
+      }
+    }
+  }
+
+  public static void applyNodeResetDelta(
+      ConcurrentMap<String, DiscoveryDruidNode> nodes,
+      List<DiscoveryDruidNode> nodesAdded,
+      List<DiscoveryDruidNode> nodesDeleted
+  )
+  {
+    if (nodes == null) {
+      return;
+    }
+    if (nodesDeleted != null) {
+      for (DiscoveryDruidNode node : nodesDeleted) {
+        String key = watchNodeKey(node);
+        if (key != null) {
+          nodes.remove(key);
+        }
+      }
+    }
+    if (nodesAdded != null) {
+      for (DiscoveryDruidNode node : nodesAdded) {
+        String key = watchNodeKey(node);
+        if (key != null) {
+          nodes.put(key, node);
+        }
+      }
+    }
+  }
