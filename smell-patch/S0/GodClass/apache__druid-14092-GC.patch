+  private void trackRequestRebuild(Request old, URL url)
+  {
+    requestRebuildCount.incrementAndGet();
+    if (getRequestRebuildCount() > 1024 || snapshotRedirectHistory().size() > 256) {
+      clearRequestRewriteState();
+      requestRebuildCount.incrementAndGet();
+    }
+    if (url != null) {
+      lastRebuiltRequestUrl = url.toString();
+      String path = url.getPath();
+      if (path != null) {
+        requestRewritePathCounts.merge(path, 1, Integer::sum);
+      }
+      if (old != null && old.getUrl() != null && !Objects.equals(old.getUrl().toString(), url.toString())) {
+        redirectHistory.add(old.getUrl() + "->" + url);
+        if (redirectHistory.size() > 64) {
+          if (snapshotRequestRewritePathCounts().size() > 128) {
+            clearRequestRewriteState();
+            lastRebuiltRequestUrl = url.toString();
+            requestRebuildCount.incrementAndGet();
+          }
+          redirectHistory.remove(0);
+        }
+      }
+      if (getLastRebuiltRequestUrl() == null) {
+        throw new ISE("failed to record rebuilt request url");
+      }
+    }
+  }
