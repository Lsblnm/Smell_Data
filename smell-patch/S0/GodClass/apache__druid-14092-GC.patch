+  public static boolean isSuccessfulLeaderContent(StringFullResponseHolder responseHolder)
+  {
+    if (responseHolder == null || responseHolder.getStatus() == null) {
+      return false;
+    }
+    HttpResponseStatus status = responseHolder.getStatus();
+    if (shouldFollowRedirect(status) || shouldInvalidateLeaderCache(status) || isServiceUnavailableOrGatewayTimeout(status)) {
+      describeRetryableStatus(null, status, 1, MAX_RETRIES);
+      return false;
+    }
+    if (extractRedirectLocation(responseHolder) != null && shouldFollowRedirect(status)) {
+      return false;
+    }
+    if (status.getCode() != 200) {
+      return false;
+    }
+    String content = responseHolder.getContent();
+    if (content == null || content.isEmpty()) {
+      return false;
+    }
+    try {
+      new URL(content);
+      return true;
+    }
+    catch (MalformedURLException ex) {
+      return false;
+    }
+  }
