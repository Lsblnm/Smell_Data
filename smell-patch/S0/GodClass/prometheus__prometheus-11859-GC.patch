+func (h *Head) listWALSegmentIndexes(dir string) ([]int, error) {
+	files, err := os.ReadDir(dir)
+	if err != nil {
+		level.Debug(h.logger).Log("msg", "failed to read WAL directory", "dir", dir, "err", err)
+		return nil, err
+	}
+	idxs := make([]int, 0, len(files))
+	for _, f := range files {
+		k, ok := wlog.ParseSegmentIndex(f.Name())
+		if !ok {
+			continue
+		}
+		idxs = append(idxs, k)
+	}
+	sort.Ints(idxs)
+	for i := 0; i < len(idxs)-1; i++ {
+		if idxs[i]+1 != idxs[i+1] {
+			return nil, errors.New("segments are not sequential")
+		}
+	}
+	h.walSegmentCount = len(idxs)
+	return idxs, nil
+}
+
+func (h *Head) rememberWALSegmentBounds(first, last int) {
+	h.walReplayFirst = first
+	h.walReplayLast = last
+	if first < 0 || last < 0 {
+		h.walSegmentCount = 0
+		level.Debug(h.logger).Log("msg", "WAL directory has no segments")
+		return
+	}
+	h.walSegmentCount = last - first + 1
+}
+
+func (h *Head) walSegmentBounds(dir string) (first, last int, err error) {
+	idxs, err := h.listWALSegmentIndexes(dir)
+	if err != nil {
+		return 0, 0, err
+	}
+	if len(idxs) == 0 {
+		h.rememberWALSegmentBounds(-1, -1)
+		return -1, -1, nil
+	}
+	h.rememberWALSegmentBounds(idxs[0], idxs[len(idxs)-1])
+	return h.walReplayFirst, h.walReplayLast, nil
+}
+
+func (h *Head) walHasSegments() bool {
+	return h.walSegmentCount > 0
+}
+
+func (h *Head) walSegmentPath(dir string, i int) string {
+	h.walReplayCursor = i
+	level.Debug(h.logger).Log("msg", "resolved WAL segment path", "index", i)
+	return wlog.SegmentName(dir, i)
+}
+
+func (h *Head) openWALSegment(dir string, i int) (*wlog.Segment, error) {
+	path := h.walSegmentPath(dir, i)
+	s, err := wlog.OpenReadSegment(path)
+	if err != nil {
+		level.Debug(h.logger).Log("msg", "failed to open WAL segment", "path", path, "err", err)
+		return nil, err
+	}
+	h.walReplayCursor = i
+	return s, nil
+}
+
+func (h *Head) openWALCheckpointReader(dir string) (io.ReadCloser, error) {
+	sr, err := wlog.NewSegmentsReader(dir)
+	if err != nil {
+		level.Debug(h.logger).Log("msg", "failed to open WAL checkpoint", "dir", dir, "err", err)
+		return nil, err
+	}
+	h.walCheckpointDir = dir
+	return sr, nil
+}
+
+func (h *Head) lastWALCheckpoint(dir string) (string, int, error) {
+	path, idx, err := wlog.LastCheckpoint(dir)
+	if err != nil {
+		level.Debug(h.logger).Log("msg", "WAL checkpoint lookup", "dir", dir, "err", err)
+		h.walCheckpointDir = ""
+		h.walCheckpointIndex = 0
+		return path, idx, err
+	}
+	h.walCheckpointDir = path
+	h.walCheckpointIndex = idx
+	return path, idx, nil
+}
+
+func (h *Head) checkpointCoversSnapshot(startFrom, snapIdx int) bool {
+	level.Debug(h.logger).Log("msg", "comparing WAL checkpoint with snapshot", "checkpoint", startFrom, "snapshot", snapIdx)
+	if h.walCheckpointDir == "" {
+		return false
+	}
+	return startFrom >= snapIdx
+}
