+func (h *Head) decodeWALSeries(dec *record.Decoder, rec []byte, series []record.RefSeries) ([]record.RefSeries, error) {
+	series, err := dec.Series(rec, series)
+	h.recordLastType = record.Series
+	h.recordSeriesCount += len(series)
+	if err != nil {
+		h.recordUnknownCount++
+		level.Debug(h.logger).Log("msg", "decode WAL series failed", "err", err)
+	}
+	return series, err
+}
