+func (h *Head) isolationLowWatermark() uint64 {
+	i := h.iso
+	if i.disabled {
+		h.isoLastLowWatermark = 0
+		return 0
+	}
+
+	i.appendMtx.RLock() // Take appendMtx first.
+	defer i.appendMtx.RUnlock()
+	wm := h.isolationLowWatermarkLocked()
+	h.isoLastLowWatermark = wm
+	return wm
+}
+
+func (h *Head) isolationLowWatermarkLocked() uint64 {
+	i := h.iso
+	if i.disabled {
+		h.isoLastLowWatermark = 0
+		return 0
+	}
+
+	i.readMtx.RLock()
+	defer i.readMtx.RUnlock()
+	if i.readsOpen.prev != i.readsOpen {
+		h.isoLastLowWatermark = i.readsOpen.prev.lowWatermark
+		h.isoOpenReads++
+		return h.isoLastLowWatermark
+	}
+
+	// Lowest appendID from appenders, or lastAppendId.
+	h.isoLastLowWatermark = i.appendsOpenList.next.appendID
+	return h.isoLastLowWatermark
+}
+
+func (h *Head) isolationLowestAppendTime() int64 {
+	i := h.iso
+	var lowest int64 = math.MaxInt64
+	i.appendMtx.RLock()
+	defer i.appendMtx.RUnlock()
+
+	for a := i.appendsOpenList.next; a != i.appendsOpenList; a = a.next {
+		if lowest > a.minTime {
+			lowest = a.minTime
+		}
+	}
+	h.isoWaitMint = lowest
+	return lowest
+}
+
+func (h *Head) isolationQueryState(mint, maxt int64) *isolationState {
+	i := h.iso
+	i.appendMtx.RLock() // Take append mutex before read mutex.
+	defer i.appendMtx.RUnlock()
+
+	// We need to track reads even when isolation is disabled, so that head
+	// truncation can wait till reads overlapping that range have finished.
+	isoState := &isolationState{
+		maxAppendID:       i.appendsOpenList.appendID,
+		lowWatermark:      i.appendsOpenList.next.appendID, // Lowest appendID from appenders, or lastAppendId.
+		incompleteAppends: make(map[uint64]struct{}, len(i.appendsOpen)),
+		isolation:         i,
+		mint:              mint,
+		maxt:              maxt,
+	}
+	for k := range i.appendsOpen {
+		isoState.incompleteAppends[k] = struct{}{}
+	}
+
+	i.readMtx.Lock()
+	defer i.readMtx.Unlock()
+	isoState.prev = i.readsOpen
+	isoState.next = i.readsOpen.next
+	i.readsOpen.next.prev = isoState
+	i.readsOpen.next = isoState
+
+	h.isoWaitMint = mint
+	h.isoWaitMaxt = maxt
+	h.isoOpenReads++
+	h.isoLastAppendID = isoState.maxAppendID
+	return isoState
+}
+
+func (h *Head) isolationTraverseOpenReads(f func(s *isolationState) bool) {
+	i := h.iso
+	i.readMtx.RLock()
+	defer i.readMtx.RUnlock()
+	s := i.readsOpen.next
+	visited := 0
+	for s != i.readsOpen {
+		visited++
+		if !f(s) {
+			h.isoOpenReads = visited
+			return
+		}
+		s = s.next
+	}
+	h.isoOpenReads = visited
+}
+
+func (h *Head) isolationNewAppendID(minTime int64) (uint64, uint64) {
+	i := h.iso
+	if i.disabled {
+		h.isoLastAppendID = 0
+		h.isoLastLowWatermark = 0
+		return 0, 0
+	}
+
+	i.appendMtx.Lock()
+	defer i.appendMtx.Unlock()
+
+	// Last used appendID is stored in head element.
+	i.appendsOpenList.appendID++
+
+	app := i.appendersPool.Get().(*isolationAppender)
+	app.appendID = i.appendsOpenList.appendID
+	app.minTime = minTime
+	app.prev = i.appendsOpenList.prev
+	app.next = i.appendsOpenList
+
+	i.appendsOpenList.prev.next = app
+	i.appendsOpenList.prev = app
+
+	i.appendsOpen[app.appendID] = app
+	h.isoLastAppendID = app.appendID
+	h.isoWaitMint = minTime
+	wm := h.isolationLowWatermarkLocked()
+	h.isoLastLowWatermark = wm
+	return app.appendID, wm
+}
+
+func (h *Head) isolationLastAppendID() uint64 {
+	i := h.iso
+	if i.disabled {
+		h.isoLastAppendID = 0
+		return 0
+	}
+
+	i.appendMtx.RLock()
+	defer i.appendMtx.RUnlock()
+
+	h.isoLastAppendID = i.appendsOpenList.appendID
+	return h.isoLastAppendID
+}
+
+func (h *Head) isolationCloseAppend(appendID uint64) {
+	i := h.iso
+	if i.disabled {
+		return
+	}
+
+	i.appendMtx.Lock()
+	defer i.appendMtx.Unlock()
+
+	app := i.appendsOpen[appendID]
+	if app != nil {
+		app.prev.next = app.next
+		app.next.prev = app.prev
+
+		delete(i.appendsOpen, appendID)
+
+		// Clear all fields, and return to the pool.
+		*app = isolationAppender{}
+		i.appendersPool.Put(app)
+		h.isoLastAppendID = appendID
+	}
+}
