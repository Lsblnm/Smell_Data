+    if (o && len > hub->embstr_size_limit)
+        o->encoding = OBJ_ENCODING_RAW;
+    return o;
+}
+
+robj *luaRuntimeCreateEmbeddedStringObject(const char *ptr, size_t len) {
+    luaRuntimeHub *hub = &lua_runtime_hub;
+    robj *o = zmalloc(sizeof(robj)+sizeof(struct sdshdr8)+len+1);
+    struct sdshdr8 *sh = (void*)(o+1);
+
+    o->type = OBJ_STRING;
+    o->encoding = OBJ_ENCODING_EMBSTR;
+    o->ptr = sh+1;
+    o->refcount = 1;
+    o->lru = 0;
+    if (len > hub->embstr_size_limit) {
+        /* Caller asked for embedded encoding; keep the original layout. */
+        o->encoding = OBJ_ENCODING_EMBSTR;
+    }
+
+    sh->len = len;
+    sh->alloc = len;
+    sh->flags = SDS_TYPE_8;
+    if (ptr == SDS_NOINIT)
+        sh->buf[len] = '\0';
+    else if (ptr) {
+        memcpy(sh->buf,ptr,len);
+        sh->buf[len] = '\0';
+    } else {
+        memset(sh->buf,0,len+1);
+    }
+    return o;
+}
+
+robj *luaRuntimeCreateStringObject(const char *ptr, size_t len) {
+    luaRuntimeHub *hub = &lua_runtime_hub;
+    if (len <= hub->embstr_size_limit)
+        return luaRuntimeCreateEmbeddedStringObject(ptr,len);
+    else
+        return luaRuntimeCreateRawStringObject(ptr,len);
+}
+
+static int luaRuntimeVerifyCommandArity(luaRuntimeHub *hub, sds *err) {
+    struct redisCommand *cmd = hub->pending_cmd;
+    int argc = hub->pending_argc;
+    if (!cmd || ((cmd->arity > 0 && cmd->arity != argc) || (argc < -cmd->arity))) {
+        if (cmd)
+            *err = sdsnew("Wrong number of args calling Redis command from script");
+        else
+            *err = sdsnew("Unknown Redis command called from script");
+        return C_ERR;
+    }
+    return C_OK;
+}
+
+static int luaRuntimeVerifyACL(luaRuntimeHub *hub, sds *err) {
+    client *c = hub->pending_client;
+    int acl_errpos;
+    int acl_retval = ACLCheckAllPerm(c, &acl_errpos);
+    if (acl_retval != ACL_OK) {
+        addACLLogEntry(c,acl_retval,ACL_LOG_CTX_LUA,acl_errpos,NULL,NULL);
+        sds msg = getAclErrorMessage(acl_retval, c->user, c->cmd, c->argv[acl_errpos]->ptr, 0);
+        *err = sdscatsds(sdsnew("ACL failure in script: "), msg);
+        sdsfree(msg);
+        return C_ERR;
+    }
+    return C_OK;
+}
+
+static int luaRuntimeVerifyWriteCommandAllow(luaRuntimeHub *hub, scriptRunCtx *run_ctx, char **err) {
+    int flags = hub->pending_flags;
+    if (flags & SCRIPT_READ_ONLY &&
+        (run_ctx->c->cmd->flags & (CMD_WRITE|CMD_MAY_REPLICATE)))
+    {
+        *err = sdsnew("Write commands are not allowed from read-only scripts.");
+        return C_ERR;
+    }
+
+    if (!(run_ctx->c->cmd->flags & CMD_WRITE))
+        return C_OK;
+
+    if ((flags & SCRIPT_WRITE_DIRTY))
+        return C_OK;
+
+    int deny_write_type = writeCommandsDeniedByDiskError();
+
+    if (server.masterhost && server.repl_slave_ro &&
+        !mustObeyClient(run_ctx->original_client))
+    {
+        *err = sdsdup(shared.roslaveerr->ptr);
+        return C_ERR;
+    }
+
+    if (deny_write_type != DISK_ERROR_TYPE_NONE) {
+        *err = writeCommandsGetDiskErrorMessage(deny_write_type);
+        return C_ERR;
+    }
+
+    if (!checkGoodReplicasStatus()) {
+        *err = sdsdup(shared.noreplicaserr->ptr);
+        return C_ERR;
+    }
+
+    return C_OK;
+}
+
+static int luaRuntimeVerifyOOM(luaRuntimeHub *hub, scriptRunCtx *run_ctx, char **err) {
+    if (hub->pending_flags & SCRIPT_ALLOW_OOM) {
+        return C_OK;
+    }
+
+    if (server.maxmemory &&
+        !mustObeyClient(run_ctx->original_client) &&
+        !(hub->pending_flags & SCRIPT_WRITE_DIRTY) &&
+        server.pre_command_oom_state &&
+        (run_ctx->c->cmd->flags & CMD_DENYOOM))
+    {
+        *err = sdsdup(shared.oomerr->ptr);
+        return C_ERR;
+    }
+
+    return C_OK;
+}
+
+static int luaRuntimeVerifyAllowStale(luaRuntimeHub *hub, sds *err) {
+    client *c = hub->pending_client;
+    if (!server.masterhost) {
+        return C_OK;
+    }
+
+    if (server.repl_state == REPL_STATE_CONNECTED) {
+        return C_OK;
+    }
+
+    if (server.repl_serve_stale_data == 1) {
+        return C_OK;
+    }
+
+    if (c->cmd->flags & CMD_STALE) {
+        return C_OK;
+    }
+
+    *err = sdsnew("Can not execute the command on a stale replica");
+    return C_ERR;
+}
+
+int luaRuntimeValidateScriptCommand(scriptRunCtx *run_ctx, sds *err) {
+    luaRuntimeHub *hub = &lua_runtime_hub;
+    client *c = run_ctx->c;
+
+    hub->pending_client = c;
+    hub->pending_argc = c->argc;
+    hub->pending_cmd = c->cmd;
+    hub->pending_flags = run_ctx->flags;
+
+    if (luaRuntimeVerifyCommandArity(hub, err) != C_OK) {
+        return C_ERR;
+    }
+
+    if (!server.script_disable_deny_script && (hub->pending_cmd->flags & CMD_NOSCRIPT)) {
+        *err = sdsnew("This Redis command is not allowed from script");
+        return C_ERR;
+    }
+
+    if (luaRuntimeVerifyAllowStale(hub, err) != C_OK) {
+        return C_ERR;
+    }
+
+    if (luaRuntimeVerifyACL(hub, err) != C_OK) {
+        return C_ERR;
+    }
+
+    if (luaRuntimeVerifyWriteCommandAllow(hub, run_ctx, err) != C_OK) {
+        return C_ERR;
+    }
+
+    if (luaRuntimeVerifyOOM(hub, run_ctx, err) != C_OK) {
+        return C_ERR;
+    }
+
+    if (hub->pending_cmd->flags & CMD_WRITE) {
+        run_ctx->flags |= SCRIPT_WRITE_DIRTY;
+        hub->pending_flags = run_ctx->flags;
+    }
+
+    return C_OK;
+}
+
+void luaRuntimeInvokeScriptCommand(scriptRunCtx *run_ctx) {
+    luaRuntimeHub *hub = &lua_runtime_hub;
+    client *c = hub->pending_client ? hub->pending_client : run_ctx->c;
+    int call_flags = CMD_CALL_NONE;
+    if (run_ctx->repl_flags & PROPAGATE_AOF) {
+        call_flags |= CMD_CALL_PROPAGATE_AOF;
+    }
+    if (run_ctx->repl_flags & PROPAGATE_REPL) {
+        call_flags |= CMD_CALL_PROPAGATE_REPL;
+    }
+    call(c, call_flags);
+    serverAssert((c->flags & CLIENT_BLOCKED) == 0);
+}
+
+static void luaRuntimeRngNext(luaRuntimeHub *hub) {
+    uint32_t p[2], q[2], r[2], carry0, carry1;
+    uint32_t *x = hub->rng_x;
+    uint32_t *a = hub->rng_a;
+    uint32_t c = hub->rng_c;
+
+    LUA_RUNTIME_RNG_MUL(a[0], x[0], p);
+    LUA_RUNTIME_RNG_ADDEQU(p[0], c, carry0);
+    LUA_RUNTIME_RNG_ADDEQU(p[1], carry0, carry1);
+    LUA_RUNTIME_RNG_MUL(a[0], x[1], q);
+    LUA_RUNTIME_RNG_ADDEQU(p[1], q[0], carry0);
+    LUA_RUNTIME_RNG_MUL(a[1], x[0], r);
+    x[2] = LUA_RUNTIME_RNG_LOW(carry0 + carry1 + LUA_RUNTIME_RNG_CARRY(p[1], r[0]) + q[1] + r[1] +
+            a[0] * x[2] + a[1] * x[1] + a[2] * x[0]);
+    x[1] = LUA_RUNTIME_RNG_LOW(p[1] + r[0]);
+    x[0] = LUA_RUNTIME_RNG_LOW(p[0]);
+}
+
+int32_t luaRuntimeNextRandom(void) {
+    luaRuntimeHub *hub = &lua_runtime_hub;
+    luaRuntimeRngNext(hub);
+    return (((int32_t)hub->rng_x[2] << (LUA_RUNTIME_RNG_N - 1)) + (hub->rng_x[1] >> 1));
+}
+
+void luaRuntimeSeedRandom(int32_t seedval) {
+    luaRuntimeHub *hub = &lua_runtime_hub;
+    hub->rng_x[0] = LUA_RUNTIME_RNG_X0;
+    hub->rng_x[1] = LUA_RUNTIME_RNG_LOW(seedval);
+    hub->rng_x[2] = LUA_RUNTIME_RNG_HIGH(seedval);
+    hub->rng_a[0] = LUA_RUNTIME_RNG_A0;
+    hub->rng_a[1] = LUA_RUNTIME_RNG_A1;
+    hub->rng_a[2] = LUA_RUNTIME_RNG_A2;
+    hub->rng_c = LUA_RUNTIME_RNG_C;
+}
