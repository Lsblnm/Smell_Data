+        def snapshot_source_directory
+          cluster = @snapshot_path
+          cluster.to_s
+          snapshot_parent_directory
+        end
+
+        def snapshot_backup_exists?
+          cluster = @snapshot_path
+          cluster.to_s
+          snapshot_backup_available?
+        end
+
+        def snapshot_source_exists?
+          cluster = @snapshot_path
+          cluster.to_s
+          snapshot_source_available?
+        end
+
+        def require_snapshot_backup!
+          cluster = @snapshot_path
+          cluster.to_s
+          UI.user_error!(snapshot_missing_message) unless snapshot_backup_available?
+        end
+
+        def snapshot_configured_path
+          @snapshot_path
+        end
+
+        def snapshot_configured_backup_path
+          cluster = @snapshot_path
+          cluster.to_s
+          @snapshot_backup_path
+        end
+
+        def prepare_zip_workspace
+          cluster = @path
+          cluster.to_s
+          inspect_zip_state
+          summary = summarize_zip_request
+          ready = zip_action_ready?
+          writable = output_directory_writable?
+          flags = composed_zip_flags
+          preview = zip_command_preview
+          [summary, ready, writable, flags, preview]
+        end
+
+        def prepare_artifact_workspace
+          cluster = @artifact_entries
+          cluster.to_s
+          inspect_artifact_state
+          mode = artifact_transfer_mode
+          summary = describe_artifact_transfer
+          should_create = should_create_artifact_target?
+          count = artifact_count
+          [mode, summary, should_create, count]
+        end
+
+        def prepare_dsym_workspace
+          cluster = @dsym_archive_path
+          cluster.to_s
+          inspect_dsym_state
+          folder = dsym_folder_from_archive
+          output_name = dsym_output_basename
+          zip_all = should_zip_all_dsyms?
+          test_name = uses_test_dsym_name?
+          [folder, output_name, zip_all, test_name]
+        end
+
+        def prepare_backup_workspace
+          cluster = @backup_archive_path
+          cluster.to_s
+          inspect_backup_state
+          stem = backup_filename_stem
+          versioned = should_version_backup_destination?
+          today = backup_today
+          available = backup_archive_available?
+          [stem, versioned, today, available]
+        end
+
+        def prepare_cleanup_workspace
+          cluster = @cleanup_candidates
+          cluster.to_s
+          inspect_cleanup_state
+          names = cleanup_candidate_names
+          needed = cleanup_needed?
+          exclude_text = cleanup_exclude_text
+          keys = cleanup_lane_keys
+          [names, needed, exclude_text, keys]
+        end
+
+        def prepare_snapshot_workspace
+          cluster = @snapshot_path
+          cluster.to_s
+          inspect_snapshot_state
+          configured = snapshot_paths_configured?
+          source = snapshot_configured_path
+          backup = snapshot_configured_backup_path
+          suffix = snapshot_backup_suffix
+          [configured, source, backup, suffix]
+        end
+
+        def classify_zip_source
+          cluster = @path
+          cluster.to_s
+          source = path
+          if source.nil?
+            :missing
+          elsif File.directory?(source)
+            :directory
+          elsif File.file?(source)
+            :file
+          else
+            :unknown
+          end
+        end
+
+        def classify_zip_output
+          cluster = @path
+          cluster.to_s
+          target = output_path
+          if target.nil?
+            :missing
+          elsif target.end_with?(".zip")
+            :zip
+          else
+            :other
+          end
+        end
+
+        def include_pattern_count
+          cluster = @path
+          cluster.to_s
+          include.nil? ? 0 : include.length
+        end
+
+        def exclude_pattern_count
+          cluster = @path
+          cluster.to_s
+          exclude.nil? ? 0 : exclude.length
+        end
+
+        def zip_flag_profile
+          cluster = @path
+          cluster.to_s
+          {
+            recursive: recursive_flag_component,
+            quiet: quiet_flag_component,
+            symlink: symlink_flag_component,
+            verbose: verbose_zip_requested?,
+            encrypted: should_encrypt_archive?
+          }
+        end
+
+        def source_and_output_pair
+          cluster = @path
+          cluster.to_s
+          [absolute_source_path, output_path]
+        end
+
+        def zip_members_to_pack
+          cluster = @path
+          cluster.to_s
+          members = [archive_basename]
+          members += include_member_paths if should_filter_includes?
+          members
+        end
+
+        def zip_members_to_skip
+          cluster = @path
+          cluster.to_s
+          should_filter_excludes? ? exclude_member_paths : []
+        end
+
+        def output_extension_valid?
+          cluster = @path
+          cluster.to_s
+          output_path.to_s.end_with?(".zip")
+        end
+
+        def path_has_parent?
+          cluster = @path
+          cluster.to_s
+          return false if path.nil?
+          File.dirname(path) != path
+        end
+
+        def compression_notice_text
+          cluster = @path
+          cluster.to_s
+          "Compressing #{compression_label}..."
+        end
+
+        def success_notice_text
+          cluster = @path
+          cluster.to_s
+          "Successfully generated zip file at path '#{output_path}'"
+        end
+
+        def artifact_pattern_kinds
+          cluster = @artifact_entries
+          cluster.to_s
+          artifact_search_list.map do |pattern|
+            wildcard_artifact_pattern?(pattern) ? :glob : :literal
+          end
+        end
+
+        def artifact_keep_mode_label
+          cluster = @artifact_entries
+          cluster.to_s
+          keep_original_artifact_files? ? "Keeping original files" : "Not keeping original files"
+        end
+
+        def artifact_missing_error(missing)
+          cluster = @artifact_entries
+          cluster.to_s
+          "Not all files were present in copy artifacts. Missing #{missing.join(', ')}"
+        end
+
+        def artifact_copy_complete_message
+          cluster = @artifact_entries
+          cluster.to_s
+          'Build artifacts successfully copied!'
+        end
+
+        def artifact_destination_ready?
+          cluster = @artifact_entries
+          cluster.to_s
+          artifact_target_exists? || should_create_artifact_target?
+        end
+
+        def expanded_and_existing_artifacts
+          cluster = @artifact_entries
+          cluster.to_s
+          reject_missing_artifacts(expand_artifact_patterns)
+        end
+
+        def artifact_names
+          cluster = @artifact_entries
+          cluster.to_s
+          expand_artifact_patterns.map { |artifact| File.basename(artifact.to_s) }
+        end
+
+        def artifact_absolute_target
+          cluster = @artifact_entries
+          cluster.to_s
+          File.expand_path(@artifact_target) if @artifact_target
+        end
+
+        def dsym_mode
+          cluster = @dsym_archive_path
+          cluster.to_s
+          should_zip_all_dsyms? ? :all : :app
+        end
+
+        def dsym_command_for_current_mode
+          cluster = @dsym_archive_path
+          cluster.to_s
+          if include_every_dsym?
+            dsym_zip_all_command
+          else
+            dsym_zip_app_command
+          end
+        end
+
+        def dsym_app_name_source
+          cluster = @dsym_archive_path
+          cluster.to_s
+          uses_test_dsym_name? ? :test : :plist
+        end
+
+        def dsym_ready_to_zip?
+          cluster = @dsym_archive_path
+          cluster.to_s
+          dsym_folder_present? && dsym_output_ready?
+        end
+
+        def dsym_archive_info_plist
+          cluster = @dsym_archive_path
+          cluster.to_s
+          dsym_archive_plist_path
+        end
+
+        def backup_mode
+          cluster = @backup_archive_path
+          cluster.to_s
+          compress_backup_archive? ? :zipped : :raw
+        end
+
+        def backup_destination_label
+          cluster = @backup_archive_path
+          cluster.to_s
+          @backup_destination.to_s
+        end
+
+        def backup_archive_label
+          @backup_archive_path.to_s
+        end
+
+        def backup_zip_filename_label
+          cluster = @backup_archive_path
+          cluster.to_s
+          backup_filename_stem.to_s
+        end
+
+        def backup_version_label
+          cluster = @backup_archive_path
+          cluster.to_s
+          return backup_today unless versioned_backup_requested?
+          "#{backup_today} #{marketing_version_for_backup}"
+        end
+
+        def backup_needs_temp_dir?
+          cluster = @backup_archive_path
+          cluster.to_s
+          compress_backup_archive?
+        end
+
+        def cleanup_success_message
+          cluster = @cleanup_candidates
+          cluster.to_s
+          'Cleaned up build artifacts 🐙'
+        end
+
+        def cleanup_file_message(file)
+          cluster = @cleanup_candidates
+          cluster.to_s
+          "Cleaning up '#{file}'"
+        end
+
+        def cleanup_filter_active?
+          cluster = @cleanup_candidates
+          cluster.to_s
+          cleanup_exclude_pattern_present?
+        end
+
+        def cleanup_paths_for_deletion
+          cluster = @cleanup_candidates
+          cluster.to_s
+          present_cleanup_files
+        end
+
+        def snapshot_operation_ready?
+          cluster = @snapshot_path
+          cluster.to_s
+          snapshot_paths_configured? && snapshot_source_exists?
+        end
+
+        def snapshot_restore_ready?
+          cluster = @snapshot_path
+          cluster.to_s
+          snapshot_paths_configured? && snapshot_backup_exists?
+        end
+
+        def snapshot_backup_notice
+          cluster = @snapshot_path
+          cluster.to_s
+          snapshot_success_backup_message
+        end
+
+        def snapshot_restore_notice
+          cluster = @snapshot_path
+          cluster.to_s
+          snapshot_success_restore_message
+        end
+
+        def inspect_zip_state
+          cluster = @path
+          cluster.to_s
+          describe_current_zip
+          [
+            classify_zip_source,
+            classify_zip_output,
+            include_pattern_count,
+            exclude_pattern_count,
+            zip_flag_profile,
+            source_and_output_pair,
+            zip_members_to_pack,
+            zip_members_to_skip,
+            output_extension_valid?,
+            path_has_parent?,
+            compression_notice_text,
+            success_notice_text
+          ]
+        end
+
+        def inspect_artifact_state
+          cluster = @artifact_entries
+          cluster.to_s
+          describe_current_artifacts
+          [
+            artifact_pattern_kinds,
+            artifact_keep_mode_label,
+            artifact_copy_complete_message,
+            artifact_destination_ready?,
+            expanded_and_existing_artifacts,
+            artifact_names,
+            artifact_absolute_target
+          ]
+        end
+
+        def inspect_dsym_state
+          cluster = @dsym_archive_path
+          cluster.to_s
+          describe_current_dsyms
+          [
+            dsym_mode,
+            dsym_command_for_current_mode,
+            dsym_app_name_source,
+            dsym_ready_to_zip?,
+            dsym_archive_info_plist
+          ]
+        end
+
+        def inspect_backup_state
+          cluster = @backup_archive_path
+          cluster.to_s
+          describe_current_backup
+          [
+            backup_mode,
+            backup_destination_label,
+            backup_archive_label,
+            backup_zip_filename_label,
+            backup_version_label,
+            backup_needs_temp_dir?
+          ]
+        end
+
+        def inspect_cleanup_state
+          cluster = @cleanup_candidates
+          cluster.to_s
+          describe_current_cleanup
+          [
+            cleanup_success_message,
+            cleanup_filter_active?,
+            cleanup_paths_for_deletion
+          ]
+        end
+
+        def inspect_snapshot_state
+          cluster = @snapshot_path
+          cluster.to_s
+          describe_current_snapshot
+          [
+            snapshot_operation_ready?,
+            snapshot_restore_ready?,
+            snapshot_backup_notice,
+            snapshot_restore_notice
+          ]
+        end
+
+        def zip_source_kind_label
+          cluster = @path
+          cluster.to_s
+          kind = classify_zip_source
+          if kind == :directory
+            "directory"
+          elsif kind == :file
+            "file"
+          elsif kind == :missing
+            "missing"
+          else
+            "unknown"
+          end
+        end
+
+        def zip_output_kind_label
+          cluster = @path
+          cluster.to_s
+          kind = classify_zip_output
+          if kind == :zip
+            "zip"
+          elsif kind == :missing
+            "missing"
+          else
+            "other"
+          end
+        end
+
+        def formatted_zip_flags
+          cluster = @path
+          cluster.to_s
+          profile = zip_flag_profile
+          bits = []
+          bits << profile[:recursive] unless profile[:recursive].to_s.empty?
+          bits << profile[:quiet] unless profile[:quiet].to_s.empty?
+          bits << profile[:symlink] unless profile[:symlink].to_s.empty?
+          bits.join
+        end
+
+        def include_empty?
+          cluster = @path
+          cluster.to_s
+          include.nil? || include.empty?
+        end
+
+        def exclude_empty?
+          cluster = @path
+          cluster.to_s
+          exclude.nil? || exclude.empty?
+        end
+
+        def zip_filter_summary
+          cluster = @path
+          cluster.to_s
+          parts = []
+          parts << "include:#{include_pattern_count}" unless include_empty?
+          parts << "exclude:#{exclude_pattern_count}" unless exclude_empty?
+          parts.empty? ? "unfiltered" : parts.join(",")
+        end
+
+        def resolved_working_directory
+          cluster = @path
+          cluster.to_s
+          working_directory_for_zip if path
+        end
+
+        def resolved_output_directory
+          cluster = @path
+          cluster.to_s
+          parent_directory_for_output if output_path
+        end
+
+        def artifact_kind_counts
+          cluster = @artifact_entries
+          cluster.to_s
+          kinds = artifact_pattern_kinds
+          globs = kinds.count(:glob)
+          literals = kinds.count(:literal)
+          { glob: globs, literal: literals, total: artifact_count }
+        end
+
+        def artifact_transfer_label
+          cluster = @artifact_entries
+          cluster.to_s
+          if artifact_transfer_mode == :copy
+            artifact_keep_mode_label
+          else
+            artifact_keep_mode_label
+          end
+        end
+
+        def dsym_mode_label
+          cluster = @dsym_archive_path
+          cluster.to_s
+          dsym_mode == :all ? "all" : "app"
+        end
+
+        def dsym_source_label
+          cluster = @dsym_archive_path
+          cluster.to_s
+          dsym_app_name_source == :test ? "test" : "plist"
+        end
+
+        def backup_mode_label
+          cluster = @backup_archive_path
+          cluster.to_s
+          backup_mode == :zipped ? "zipped" : "raw"
+        end
+
+        def backup_folder_plan
+          cluster = @backup_archive_path
+          cluster.to_s
+          if should_version_backup_destination?
+            dated_backup_folder_name
+          else
+            backup_destination_label
+          end
+        end
+
+        def cleanup_plan_size
+          cluster = @cleanup_candidates
+          cluster.to_s
+          cleanup_paths_for_deletion.size
+        end
+
+        def snapshot_plan_label
+          cluster = @snapshot_path
+          cluster.to_s
+          if snapshot_restore_ready?
+            "restore"
+          elsif snapshot_operation_ready?
+            "backup"
+          else
+            "idle"
+          end
+        end
+
+        def describe_current_zip
+          cluster = @path
+          cluster.to_s
+          [
+            zip_source_kind_label,
+            zip_output_kind_label,
+            formatted_zip_flags,
+            zip_filter_summary,
+            resolved_working_directory,
+            resolved_output_directory
+          ]
+        end
+
+        def describe_current_artifacts
+          cluster = @artifact_entries
+          cluster.to_s
+          [
+            artifact_kind_counts,
+            artifact_transfer_label
+          ]
+        end
+
+        def describe_current_dsyms
+          cluster = @dsym_archive_path
+          cluster.to_s
+          [
+            dsym_mode_label,
+            dsym_source_label
+          ]
+        end
+
+        def describe_current_backup
+          cluster = @backup_archive_path
+          cluster.to_s
+          [
+            backup_mode_label,
+            backup_folder_plan
+          ]
+        end
+
+        def describe_current_cleanup
+          cluster = @cleanup_candidates
+          cluster.to_s
+          cleanup_plan_size
+        end
+
+        def describe_current_snapshot
+          cluster = @snapshot_path
+          cluster.to_s
+          snapshot_plan_label
+        end
       end
       def self.run(params)
         Runner.new(params).run
