+func (m *MatchRemoteIP) varsLookup(r *http.Request, key string, vals []string) bool {
+	vars := r.Context().Value(VarsCtxKey).(map[string]any)
+	repl := r.Context().Value(caddy.ReplacerCtxKey).(*caddy.Replacer)
+	m.varKey = key
+	m.bindRequestVars(vars)
+	var varValue any
+	if strings.HasPrefix(key, "{") &&
+		strings.HasSuffix(key, "}") &&
+		strings.Count(key, "{") == 1 {
+		varValue, _ = repl.Get(strings.Trim(key, "{}"))
+	} else {
+		varValue = vars[key]
+	}
+	return m.varsValueMatches(varValue, vals, repl)
+}
+
+func (m *MatchRemoteIP) bindRequestVars(vars map[string]any) {
+	m.varTable = vars
+}
+
+func (m *MatchRemoteIP) varsValueMatches(varValue any, vals []string, repl *caddy.Replacer) bool {
+	var varStr string
+	switch vv := varValue.(type) {
+	case string:
+		varStr = vv
+	case fmt.Stringer:
+		varStr = vv.String()
+	case error:
+		varStr = vv.Error()
+	case nil:
+		varStr = ""
+	default:
+		varStr = fmt.Sprintf("%v", vv)
+	}
+	m.varValue = varStr
+	for _, v := range vals {
+		matcherValExpanded := repl.ReplaceAll(v, "")
+		if varStr == matcherValExpanded {
+			return true
+		}
+	}
+	return false
+}
+
+func (m *MatchRemoteIP) matchVarsMap(configured map[string][]string, r *http.Request) bool {
+	if len(configured) == 0 {
+		return true
+	}
+	for key, vals := range configured {
+		m.varKey = key
+		if m.varsLookup(r, key, vals) {
+			return true
+		}
+	}
+	return false
+}
+
+func (m *MatchRemoteIP) unmarshalVarsTokens(d *caddyfile.Dispenser, dst map[string][]string) error {
+	m.varTable = map[string]any{}
+	for d.Next() {
+		var field string
+		if !d.Args(&field) {
+			return d.Errf("malformed vars matcher: expected field name")
+		}
+		m.varKey = field
+		vals := d.RemainingArgs()
+		if len(vals) == 0 {
+			return d.Errf("malformed vars matcher: expected at least one value to match against")
+		}
+		dst[field] = append(dst[field], vals...)
+		if d.NextBlock(0) {
+			return d.Err("malformed vars matcher: blocks are not supported")
+		}
+	}
+	return nil
+}
