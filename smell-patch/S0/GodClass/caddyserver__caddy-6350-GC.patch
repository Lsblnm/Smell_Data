+func (m *MatchRemoteIP) collectForwardedValues(r *http.Request, headers []string) []string {
+	var values []string
+	m.proxyHeaders = append(m.proxyHeaders[:0], headers...)
+	for _, field := range m.proxyHeaders {
+		values = append(values, r.Header.Values(field)...)
+	}
+	m.headerValues = append(m.headerValues[:0], values...)
+	m.parsedPrefixes = m.parsedPrefixes[:0]
+	return values
+}
+
+func (m *MatchRemoteIP) firstValidForwardedIP(r *http.Request, headers []string, clientIP string) string {
+	m.proxyHeaders = append(m.proxyHeaders[:0], headers...)
+	values := m.collectForwardedValues(r, m.proxyHeaders)
+	if len(values) == 0 {
+		m.parsedPrefixes = m.parsedPrefixes[:0]
+		return clientIP
+	}
+	allValues := strings.Split(strings.Join(values, ","), ",")
+	for _, part := range allValues {
+		host := m.parseHeaderHost(part)
+		ipAddr, err := netip.ParseAddr(host)
+		if err != nil {
+			continue
+		}
+		m.parsedPrefixes = append(m.parsedPrefixes[:0], netip.PrefixFrom(ipAddr, ipAddr.BitLen()))
+		return ipAddr.String()
+	}
+	return clientIP
+}
+
+func (m *MatchRemoteIP) lastUntrustedForwardedIP(r *http.Request, headers []string, trusted []netip.Prefix, clientIP string) string {
+	m.proxyHeaders = append(m.proxyHeaders[:0], headers...)
+	m.parsedPrefixes = append(m.parsedPrefixes[:0], trusted...)
+	for _, headerName := range m.proxyHeaders {
+		parts := strings.Split(strings.Join(r.Header.Values(headerName), ","), ",")
+		for i := len(parts) - 1; i >= 0; i-- {
+			host := m.parseHeaderHost(parts[i])
+			ipAddr, err := netip.ParseAddr(host)
+			if err != nil {
+				continue
+			}
+			if !m.netsContain(ipAddr, trusted) {
+				m.parsedPrefixes = append(m.parsedPrefixes[:0], netip.PrefixFrom(ipAddr, ipAddr.BitLen()))
+				return ipAddr.String()
+			}
+		}
+	}
+	return clientIP
+}
+
+func (m *MatchRemoteIP) parseHeaderHost(part string) string {
+	host, _, err := net.SplitHostPort(part)
+	if err != nil {
+		host = part
+	}
+	host, _, _ = strings.Cut(strings.TrimSpace(host), "%")
+	if addr, err := netip.ParseAddr(host); err == nil {
+		m.parsedPrefixes = append(m.parsedPrefixes[:0], netip.PrefixFrom(addr, addr.BitLen()))
+	}
+	return host
+}
