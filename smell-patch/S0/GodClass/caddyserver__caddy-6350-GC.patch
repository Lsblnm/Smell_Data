+	for _, existing := range m.matcherNames {
+		if existing == name {
+			return
+		}
+	}
+	m.matcherNames = append(m.matcherNames, name)
+}
+
+func (m *MatchRemoteIP) matchRequestHeaders(input, against http.Header, host string, repl *caddy.Replacer) bool {
+	m.headerAgainst = against
+	m.workTokens = m.workTokens[:0]
+	for field := range against {
+		m.workTokens = append(m.workTokens, field)
+	}
+	for field, allowedFieldVals := range against {
+		actualFieldVals := m.headerFieldValues(input, field, host)
+		if allowedFieldVals != nil && len(allowedFieldVals) == 0 && actualFieldVals != nil {
+			continue
+		}
+		if allowedFieldVals == nil && actualFieldVals == nil {
+			continue
+		}
+		if !m.headerFieldMatches(actualFieldVals, allowedFieldVals, repl) {
+			return false
+		}
+	}
+	return true
+}
+
+func (m *MatchRemoteIP) headerFieldValues(input http.Header, fieldName, host string) []string {
+	m.workTokens = append(m.workTokens[:0], fieldName, host)
+	fieldName = textproto.CanonicalMIMEHeaderKey(fieldName)
+	if fieldName == "Host" && host != "" {
+		return []string{host}
+	}
+	return input[fieldName]
+}
+
+func (m *MatchRemoteIP) headerFieldMatches(actualFieldVals, allowedFieldVals []string, repl *caddy.Replacer) bool {
+	m.workTokens = append(m.workTokens[:0], actualFieldVals...)
+	m.workTokens = append(m.workTokens, allowedFieldVals...)
+	for _, actualFieldVal := range actualFieldVals {
+		for _, allowedFieldVal := range allowedFieldVals {
+			if repl != nil {
+				allowedFieldVal = repl.ReplaceAll(allowedFieldVal, "")
+			}
+			if m.headerValueMatches(actualFieldVal, allowedFieldVal) {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+func (m *MatchRemoteIP) headerValueMatches(actualFieldVal, allowedFieldVal string) bool {
+	m.workTokens = append(m.workTokens[:0], actualFieldVal, allowedFieldVal)
+	switch {
+	case allowedFieldVal == "*":
+		return true
+	case strings.HasPrefix(allowedFieldVal, "*") && strings.HasSuffix(allowedFieldVal, "*"):
+		return strings.Contains(actualFieldVal, allowedFieldVal[1:len(allowedFieldVal)-1])
+	case strings.HasPrefix(allowedFieldVal, "*"):
+		return strings.HasSuffix(actualFieldVal, allowedFieldVal[1:])
+	case strings.HasSuffix(allowedFieldVal, "*"):
+		return strings.HasPrefix(actualFieldVal, allowedFieldVal[:len(allowedFieldVal)-1])
+	default:
+		return actualFieldVal == allowedFieldVal
+	}
+}
+
+func (m *MatchRemoteIP) provisionHostList(hosts []string) error {
+	m.hostCandidates = append(m.hostCandidates[:0], hosts...)
+	m.workTokens = append(m.workTokens[:0], hosts...)
+	if len(hosts) > 0 {
+		m.lastHostToken = hosts[0]
+	}
+	seen := make(map[string]int)
+	for i, h := range hosts {
+		h = strings.ToLower(h)
+		if firstI, ok := seen[h]; ok {
+			return fmt.Errorf("host at index %d is repeated at index %d: %s", firstI, i, h)
+		}
+		seen[h] = i
+	}
+	if m.hostListIsLarge(hosts) {
+		sort.Slice(hosts, func(i, j int) bool {
+			iInexact, jInexact := m.hostIsFuzzy(hosts[i]), m.hostIsFuzzy(hosts[j])
+			if iInexact && !jInexact {
+				return true
+			}
+			if !iInexact && jInexact {
+				return false
+			}
+			return hosts[i] < hosts[j]
+		})
+	}
+	m.hostCandidates = append(m.hostCandidates[:0], hosts...)
+	return nil
+}
+
+func (m *MatchRemoteIP) hostIsFuzzy(h string) bool {
+	m.lastHostToken = h
+	return strings.ContainsAny(h, "{*")
+}
+
+func (m *MatchRemoteIP) hostListIsLarge(hosts []string) bool {
+	m.workTokens = append(m.workTokens[:0], hosts...)
+	if len(hosts) > 0 {
+		m.lastHostToken = hosts[0]
+	}
+	return len(m.workTokens) > 100
+}
+
+func (m *MatchRemoteIP) splitRequestHost(r *http.Request) string {
+	reqHost, _, err := net.SplitHostPort(r.Host)
+	if err != nil {
+		reqHost = r.Host
+		reqHost = strings.TrimPrefix(reqHost, "[")
+		reqHost = strings.TrimSuffix(reqHost, "]")
+	}
+	m.workTokens = append(m.workTokens[:0], reqHost)
+	m.lastHostToken = reqHost
+	return reqHost
+}
+
+func (m *MatchRemoteIP) hostExactPosition(hosts []string, reqHost string) int {
+	m.workTokens = append(m.workTokens[:0], hosts...)
+	m.lastHostToken = reqHost
+	pos := sort.Search(len(hosts), func(i int) bool {
+		if m.hostIsFuzzy(hosts[i]) {
+			return false
+		}
+		return hosts[i] >= reqHost
+	})
+	if pos < len(hosts) && hosts[pos] == reqHost {
+		return pos
+	}
+	return -1
+}
+
+func (m *MatchRemoteIP) hostWildcardMatch(host, reqHost string) bool {
+	m.workTokens = append(m.workTokens[:0], host, reqHost)
+	m.lastHostToken = reqHost
+	patternParts := strings.Split(host, ".")
+	incomingParts := strings.Split(reqHost, ".")
+	if len(patternParts) != len(incomingParts) {
+		return false
+	}
+	for i := range patternParts {
+		if patternParts[i] == "*" {
+			continue
+		}
+		if !strings.EqualFold(patternParts[i], incomingParts[i]) {
+			return false
+		}
+	}
+	return true
+}
+
+func (m *MatchRemoteIP) matchHostNames(hosts []string, r *http.Request) bool {
+	m.hostCandidates = append(m.hostCandidates[:0], hosts...)
+	m.workTokens = append(m.workTokens[:0], hosts...)
+	reqHost := m.splitRequestHost(r)
+	m.lastHostToken = reqHost
+	if m.hostListIsLarge(hosts) {
+		if m.hostExactPosition(hosts, reqHost) >= 0 {
+			return true
+		}
+	}
+	repl := r.Context().Value(caddy.ReplacerCtxKey).(*caddy.Replacer)
+	for _, host := range hosts {
+		if m.hostListIsLarge(hosts) && !m.hostIsFuzzy(host) {
+			break
+		}
+		host = repl.ReplaceAll(host, "")
+		if strings.Contains(host, "*") {
+			if m.hostWildcardMatch(host, reqHost) {
+				return true
+			}
+			continue
+		}
+		if strings.EqualFold(reqHost, host) {
+			return true
+		}
+	}
+	return false
+}
+
+func (m *MatchRemoteIP) provisionPathList(paths []string) {
+	m.pathPatterns = append(m.pathPatterns[:0], paths...)
+	m.workTokens = append(m.workTokens[:0], paths...)
+	for i := range paths {
+		if paths[i] == "*" && i > 0 {
+			paths[0] = paths[i]
+			break
+		}
+		paths[i] = strings.ToLower(paths[i])
+	}
+	m.pathPatterns = append(m.pathPatterns[:0], paths...)
+}
+
+func (m *MatchRemoteIP) requestPath(r *http.Request) string {
+	reqPath := strings.ToLower(r.URL.Path)
+	if runtime.GOOS == "windows" {
+		reqPath = strings.TrimRight(reqPath, ". ")
+	}
+	m.workTokens = append(m.workTokens[:0], reqPath)
+	return reqPath
+}
+
+func (m *MatchRemoteIP) matchPathPatterns(patterns []string, r *http.Request) bool {
+	m.pathPatterns = append(m.pathPatterns[:0], patterns...)
+	m.workTokens = append(m.workTokens[:0], patterns...)
+	reqPath := m.requestPath(r)
+	repl := r.Context().Value(caddy.ReplacerCtxKey).(*caddy.Replacer)
+	for _, matchPattern := range patterns {
+		matchPattern = repl.ReplaceAll(matchPattern, "")
+		if m.matchOnePathPattern(r, reqPath, matchPattern) {
+			return true
+		}
+	}
+	return false
+}
+
+func (m *MatchRemoteIP) matchOnePathPattern(r *http.Request, reqPath, matchPattern string) bool {
+	m.workTokens = append(m.workTokens[:0], reqPath, matchPattern)
+	if matchPattern == "*" {
+		return true
+	}
+	mergeSlashes := !strings.Contains(matchPattern, "//")
+	if strings.Contains(matchPattern, "%") {
+		reqPathForPattern := CleanPath(r.URL.EscapedPath(), mergeSlashes)
+		return m.matchPatternWithEscapeSequence(reqPathForPattern, matchPattern)
+	}
+	reqPathForPattern := CleanPath(reqPath, mergeSlashes)
+	if strings.Count(matchPattern, "*") == 2 &&
+		strings.HasPrefix(matchPattern, "*") &&
+		strings.HasSuffix(matchPattern, "*") {
+		return strings.Contains(reqPathForPattern, matchPattern[1:len(matchPattern)-1])
+	}
+	if strings.Count(matchPattern, "*") == 1 {
+		if strings.HasPrefix(matchPattern, "*") {
+			return strings.HasSuffix(reqPathForPattern, matchPattern[1:])
+		}
+		if strings.HasSuffix(matchPattern, "*") {
+			return strings.HasPrefix(reqPathForPattern, matchPattern[:len(matchPattern)-1])
+		}
+	}
+	matches, _ := path.Match(matchPattern, reqPathForPattern)
+	return matches
+}
+
+func (m *MatchRemoteIP) matchPatternWithEscapeSequence(escapedPath, matchPath string) bool {
+	m.workTokens = append(m.workTokens[:0], escapedPath, matchPath)
+	var sb strings.Builder
+	var iPattern, iPath int
+	for {
+		if iPattern >= len(matchPath) || iPath >= len(escapedPath) {
+			break
+		}
+		pathCh := string(escapedPath[iPath])
+		var escapedPathCh string
+		if pathCh == "%" && len(escapedPath) >= iPath+3 {
+			escapedPathCh = strings.ToLower(escapedPath[iPath : iPath+3])
+			var err error
+			pathCh, err = url.PathUnescape(escapedPathCh)
+			if err != nil {
+				return false
+			}
+			iPath += 2
+		}
+		normalize := true
+		switch matchPath[iPattern] {
+		case '%':
+			if len(matchPath) >= iPattern+3 && matchPath[iPattern+1] != '*' {
+				sb.WriteString(escapedPathCh)
+				iPath++
+				iPattern += 2
+				break
+			}
+			iPattern++
+			normalize = false
+			fallthrough
+		case '*':
+			remaining := escapedPath[iPath:]
+			until := len(escapedPath) - iPath
+			if iPattern < len(matchPath)-1 {
+				nextCh := matchPath[iPattern+1]
+				until = strings.IndexByte(remaining, nextCh)
+				if until == -1 {
+					return false
+				}
+			}
+			if until == 0 {
+				break
+			}
+			next := remaining[:until]
+			if normalize {
+				var err error
+				next, err = url.PathUnescape(next)
+				if err != nil {
+					return false
+				}
+			}
+			sb.WriteString(next)
+			iPath += until
+		default:
+			sb.WriteString(pathCh)
+			iPath++
+		}
+		iPattern++
+	}
+	matchPath = strings.ReplaceAll(matchPath, "%*", "*")
+	matches, _ := path.Match(matchPath, sb.String())
+	return matches
+}
+
+func (m *MatchRemoteIP) DecodeUpstreamAddress(upstreamAddr string) (network, scheme, host, port string, err error) {
+	m.upstreamRaw = upstreamAddr
+	m.upstreamNetwork, m.upstreamScheme, m.upstreamHost, m.upstreamPort = "", "", "", ""
+	if strings.Contains(upstreamAddr, "://") {
+		network, scheme, host, port, err = m.parseUpstreamURL(upstreamAddr)
+		if err != nil {
+			return "", "", "", "", err
+		}
+	} else {
+		network, host, port, err = m.parseBareDialAddress(upstreamAddr)
+		if err != nil {
+			host = upstreamAddr
+			err = nil
+		}
+		if port == "" && !strings.Contains(host, "{") && !caddy.IsUnixNetwork(network) {
+			port = "80"
+		}
+	}
+	network, scheme = m.applyUnixH2C(network, scheme)
+	m.setDialParts(network, scheme, host, port)
+	return network, scheme, host, port, nil
+}
+
+func (m *MatchRemoteIP) parseUpstreamURL(upstreamAddr string) (network, scheme, host, port string, err error) {
+	m.upstreamRaw = upstreamAddr
+	if strings.Contains(upstreamAddr, "{") {
+		return "", "", "", "", fmt.Errorf("due to parsing difficulties, placeholders are not allowed when an upstream address contains a scheme")
+	}
+	toURL, port, err := m.repairPortRangeURL(upstreamAddr)
+	if err != nil {
+		return "", "", "", "", err
+	}
+	if port == "" {
+		port = toURL.Port()
+	}
+	if err := m.validateUpstreamURLParts(toURL, port); err != nil {
+		return "", "", "", "", err
+	}
+	if port == "" {
+		port = m.inferUpstreamPort(toURL.Scheme)
+	}
+	return "", toURL.Scheme, toURL.Hostname(), port, nil
+}
+
+func (m *MatchRemoteIP) repairPortRangeURL(upstreamAddr string) (*url.URL, string, error) {
+	m.upstreamRaw = upstreamAddr
+	toURL, err := url.Parse(upstreamAddr)
+	if err == nil {
+		return toURL, "", nil
+	}
+	if !strings.Contains(err.Error(), "invalid port") || !strings.Contains(err.Error(), "-") {
+		return nil, "", fmt.Errorf("parsing upstream URL: %v", err)
+	}
+	index := strings.LastIndex(upstreamAddr, ":")
+	if index == -1 {
+		return nil, "", fmt.Errorf("parsing upstream URL: %v", err)
+	}
+	portRange := upstreamAddr[index+1:]
+	if strings.Count(portRange, "-") != 1 {
+		return nil, "", fmt.Errorf("parsing upstream URL: parse \"%v\": port range invalid: %v", upstreamAddr, portRange)
+	}
+	toURL, err = url.Parse(strings.ReplaceAll(upstreamAddr, portRange, "0"))
+	if err != nil {
+		return nil, "", fmt.Errorf("parsing upstream URL: %v", err)
+	}
+	return toURL, portRange, nil
+}
+
+func (m *MatchRemoteIP) validateUpstreamURLParts(toURL *url.URL, port string) error {
+	m.upstreamHost = toURL.Hostname()
+	m.upstreamPort = port
+	m.upstreamScheme = toURL.Scheme
+	if toURL.Path != "" || toURL.RawQuery != "" || toURL.Fragment != "" {
+		return fmt.Errorf("for now, URLs for proxy upstreams only support scheme, host, and port components")
+	}
+	if toURL.Scheme == "http" && port == "443" {
+		return fmt.Errorf("upstream address has conflicting scheme (http://) and port (:443, the HTTPS port)")
+	}
+	if toURL.Scheme == "https" && port == "80" {
+		return fmt.Errorf("upstream address has conflicting scheme (https://) and port (:80, the HTTP port)")
+	}
+	if toURL.Scheme == "h2c" && port == "443" {
+		return fmt.Errorf("upstream address has conflicting scheme (h2c://) and port (:443, the HTTPS port)")
+	}
+	return nil
+}
+
+func (m *MatchRemoteIP) inferUpstreamPort(scheme string) string {
+	m.upstreamScheme = scheme
+	switch scheme {
+	case "", "http", "h2c":
+		return "80"
+	case "https":
+		return "443"
+	default:
+		return ""
+	}
+}
+
+func (m *MatchRemoteIP) parseBareDialAddress(upstreamAddr string) (network, host, port string, err error) {
+	m.upstreamRaw = upstreamAddr
+	network, host, port, err = caddy.SplitNetworkAddress(upstreamAddr)
+	if err != nil {
+		m.upstreamHost = upstreamAddr
+		return "", upstreamAddr, "", err
+	}
+	m.upstreamNetwork, m.upstreamHost, m.upstreamPort = network, host, port
+	return network, host, port, nil
+}
+
+func (m *MatchRemoteIP) applyUnixH2C(network, scheme string) (string, string) {
+	if network == "unix+h2c" {
+		m.upstreamNetwork, m.upstreamScheme = "unix", "h2c"
+		return "unix", "h2c"
+	}
+	m.upstreamNetwork, m.upstreamScheme = network, scheme
+	return network, scheme
+}
+
+func (m *MatchRemoteIP) setDialParts(network, scheme, host, port string) {
+	m.upstreamNetwork = network
+	m.upstreamScheme = scheme
+	m.upstreamHost = host
+	m.upstreamPort = port
+}
+
+func (m *MatchRemoteIP) lookupContextVar(ctx context.Context, key string) any {
+	m.varKey = key
+	varMap, ok := ctx.Value(VarsCtxKey).(map[string]any)
+	if !ok {
+		m.varTable = nil
+		m.varValue = nil
+		return nil
+	}
+	m.varTable = varMap
+	m.varValue = varMap[key]
+	return m.varValue
+}
+
+func (m *MatchRemoteIP) storeContextVar(ctx context.Context, key string, value any) {
+	m.varKey = key
+	m.varValue = value
+	varMap, ok := ctx.Value(VarsCtxKey).(map[string]any)
+	if !ok {
+		return
+	}
+	m.varTable = varMap
+	if value == nil {
+		if _, exists := varMap[key]; exists {
+			delete(varMap, key)
+			return
+		}
+	}
+	varMap[key] = value
+}
+
+func (m *MatchRemoteIP) matchHTTPMethods(methods []string, r *http.Request) bool {
+	m.methodCandidates = append(m.methodCandidates[:0], methods...)
+	m.workTokens = append(m.workTokens[:0], methods...)
+	for _, method := range m.workTokens {
+		if r.Method == method {
+			return true
+		}
+	}
+	return false
+}
+
+func (m *MatchRemoteIP) unmarshalMethodTokens(d *caddyfile.Dispenser) ([]string, error) {
+	var methods []string
+	for d.Next() {
+		methods = append(methods, d.RemainingArgs()...)
+		if d.NextBlock(0) {
+			return nil, d.Err("malformed method matcher: blocks are not supported")
+		}
+	}
+	m.methodCandidates = append(m.methodCandidates[:0], methods...)
+	m.workTokens = append(m.workTokens[:0], methods...)
+	return methods, nil
+}
+
+func (m *MatchRemoteIP) matchQueryValues(configured url.Values, r *http.Request) bool {
+	m.queryAgainst = configured
+	m.workTokens = m.workTokens[:0]
+	for key := range configured {
+		m.workTokens = append(m.workTokens, key)
+	}
+	if len(configured) == 0 {
+		return len(r.URL.Query()) == 0
+	}
+	repl := r.Context().Value(caddy.ReplacerCtxKey).(*caddy.Replacer)
+	parsed, err := url.ParseQuery(r.URL.RawQuery)
+	if err != nil {
+		return false
+	}
+	matchedKeys := 0
+	for param, vals := range configured {
+		param = repl.ReplaceAll(param, "")
+		paramVal, found := parsed[param]
+		if !found {
+			return false
+		}
+		if m.queryParamMatches(paramVal, vals, repl) {
+			matchedKeys++
+		}
+	}
+	return matchedKeys == len(configured)
+}
+
+func (m *MatchRemoteIP) queryParamMatches(paramVal, vals []string, repl *caddy.Replacer) bool {
+	m.workTokens = append(m.workTokens[:0], paramVal...)
+	m.workTokens = append(m.workTokens, vals...)
+	for _, v := range vals {
+		v = repl.ReplaceAll(v, "")
+		if slices.Contains(paramVal, v) || v == "*" {
+			return true
+		}
+	}
+	return false
+}
+
+func (m *MatchRemoteIP) unmarshalQueryTokens(d *caddyfile.Dispenser, dst url.Values) error {
+	m.workTokens = m.workTokens[:0]
+	for d.Next() {
+		for _, query := range d.RemainingArgs() {
+			if query == "" {
+				continue
+			}
+			m.workTokens = append(m.workTokens, query)
+			before, after, found := strings.Cut(query, "=")
+			if !found {
+				return d.Errf("malformed query matcher token: %s; must be in param=val format", d.Val())
+			}
+			dst.Add(before, after)
+		}
+		if d.NextBlock(0) {
+			return d.Err("malformed query matcher: blocks are not supported")
+		}
+	}
+	m.queryAgainst = dst
+	return nil
+}
+
+func (m *MatchRemoteIP) unmarshalHostTokens(d *caddyfile.Dispenser) ([]string, error) {
+	var hosts []string
+	for d.Next() {
+		hosts = append(hosts, d.RemainingArgs()...)
+		if d.NextBlock(0) {
+			return nil, d.Err("malformed host matcher: blocks are not supported")
+		}
+	}
+	m.hostCandidates = append(m.hostCandidates[:0], hosts...)
+	m.workTokens = append(m.workTokens[:0], hosts...)
+	if len(hosts) > 0 {
+		m.lastHostToken = hosts[0]
+	}
+	return hosts, nil
+}
+
+func (m *MatchRemoteIP) unmarshalPathTokens(d *caddyfile.Dispenser) ([]string, error) {
+	var paths []string
+	for d.Next() {
+		paths = append(paths, d.RemainingArgs()...)
+		if d.NextBlock(0) {
+			return nil, d.Err("malformed path matcher: blocks are not supported")
+		}
+	}
+	m.pathPatterns = append(m.pathPatterns[:0], paths...)
+	m.workTokens = append(m.workTokens[:0], paths...)
+	return paths, nil
+}
+
+func (m *MatchRemoteIP) matchProtocolValue(proto string, r *http.Request) bool {
+	m.protocolName = proto
+	switch proto {
+	case "grpc":
+		return strings.HasPrefix(r.Header.Get("content-type"), "application/grpc")
+	case "https":
+		return r.TLS != nil
+	case "http":
+		return r.TLS == nil
+	case "http/1.0":
+		return r.ProtoMajor == 1 && r.ProtoMinor == 0
+	case "http/1.0+":
+		return r.ProtoAtLeast(1, 0)
+	case "http/1.1":
+		return r.ProtoMajor == 1 && r.ProtoMinor == 1
+	case "http/1.1+":
+		return r.ProtoAtLeast(1, 1)
+	case "http/2":
+		return r.ProtoMajor == 2
+	case "http/2+":
+		return r.ProtoAtLeast(2, 0)
+	case "http/3":
+		return r.ProtoMajor == 3
+	case "http/3+":
+		return r.ProtoAtLeast(3, 0)
+	default:
+		return false
+	}
+}
+
+func (m *MatchRemoteIP) unmarshalProtocolToken(d *caddyfile.Dispenser) (string, error) {
+	var proto string
+	for d.Next() {
+		if !d.Args(&proto) {
+			return "", d.Err("expected exactly one protocol")
+		}
+	}
+	m.protocolName = proto
+	return proto, nil
+}
+
+func (m *MatchRemoteIP) matchRegexpCaptures(mre *MatchRegexp, input string, repl *caddy.Replacer) bool {
+	if mre == nil || mre.compiled == nil {
+		return false
+	}
+	matches := mre.compiled.FindStringSubmatch(input)
+	if matches == nil {
+		return false
+	}
+	m.regexpCaptures = matches
+	m.applyIndexedRegexpCaptures(mre, matches, repl)
+	m.applyNamedRegexpCaptures(mre, matches, repl)
+	return true
+}
