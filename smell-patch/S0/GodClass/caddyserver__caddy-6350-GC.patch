+func (m *MatchRemoteIP) loadTrustedNets(trusted []netip.Prefix) {
+	m.trustedNets = append(m.trustedNets[:0], trusted...)
+	m.parsedPrefixes = append(m.parsedPrefixes[:0], trusted...)
+}
+
+func (m *MatchRemoteIP) netsContain(ipAddr netip.Addr, trusted []netip.Prefix) bool {
+	m.trustedNets = trusted
+	m.parsedPrefixes = append(m.parsedPrefixes[:0], trusted...)
+	for _, ipRange := range m.trustedNets {
+		if ipRange.Contains(ipAddr) {
+			return true
+		}
+	}
+	return false
+}
