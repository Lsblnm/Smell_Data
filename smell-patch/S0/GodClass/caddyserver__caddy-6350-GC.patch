+func (m *MatchRemoteIP) resolveTrustedProxy(r *http.Request, s *Server) (bool, string) {
+	if s == nil {
+		m.proxyTrusted = false
+		m.resolvedClientIP = ""
+		return false, ""
+	}
+	clientIP, err := m.splitRemoteAddr(r.RemoteAddr)
+	if err != nil {
+		return false, ""
+	}
+	clientIP = m.stripIPZone(clientIP)
+	ipAddr, err := m.parseRemoteIPAddr(clientIP)
+	if err != nil {
+		return false, ""
+	}
+	if s.trustedProxies == nil {
+		return m.setProxyResult(false, ipAddr.String())
+	}
+	m.loadTrustedNets(s.trustedProxies.GetIPRanges(r))
+	m.proxyHeaders = append(m.proxyHeaders[:0], s.ClientIPHeaders...)
+	if m.netsContain(ipAddr, m.trustedNets) {
+		if s.TrustedProxiesStrict > 0 {
+			return m.setProxyResult(true, m.lastUntrustedForwardedIP(r, m.proxyHeaders, m.trustedNets, ipAddr.String()))
+		}
+		return m.setProxyResult(true, m.firstValidForwardedIP(r, m.proxyHeaders, ipAddr.String()))
+	}
+	return m.setProxyResult(false, ipAddr.String())
+}
+
+func (m *MatchRemoteIP) splitRemoteAddr(remoteAddr string) (string, error) {
+	host, _, err := net.SplitHostPort(remoteAddr)
