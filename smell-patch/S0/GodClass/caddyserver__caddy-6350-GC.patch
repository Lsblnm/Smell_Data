+func (m *MatchRemoteIP) applyIndexedRegexpCaptures(mre *MatchRegexp, matches []string, repl *caddy.Replacer) {
+	m.regexpCaptures = matches
+	for i, match := range matches {
+		keySuffix := "." + strconv.Itoa(i)
+		if mre.Name != "" {
+			repl.Set(regexpPlaceholderPrefix+"."+mre.Name+keySuffix, match)
+		}
+		repl.Set(regexpPlaceholderPrefix+keySuffix, match)
+	}
+}
+
+func (m *MatchRemoteIP) applyNamedRegexpCaptures(mre *MatchRegexp, matches []string, repl *caddy.Replacer) {
+	m.regexpCaptures = matches
+	for i, name := range mre.compiled.SubexpNames() {
+		if i == 0 || name == "" {
+			continue
+		}
+		keySuffix := "." + name
+		if mre.Name != "" {
+			repl.Set(regexpPlaceholderPrefix+"."+mre.Name+keySuffix, matches[i])
+		}
+		repl.Set(regexpPlaceholderPrefix+keySuffix, matches[i])
+	}
+}
+
+func (m *MatchRemoteIP) provisionRegexpPattern(mre *MatchRegexp) error {
+	re, err := regexp.Compile(mre.Pattern)
+	if err != nil {
+		return fmt.Errorf("compiling matcher regexp %s: %v", mre.Pattern, err)
+	}
+	mre.compiled = re
+	m.regexpCaptures = m.regexpCaptures[:0]
+	return nil
+}
+
+func (m *MatchRemoteIP) validateRegexpName(mre *MatchRegexp) error {
+	m.regexpCaptures = m.regexpCaptures[:0]
+	if mre.Name != "" {
+		m.regexpCaptures = append(m.regexpCaptures, mre.Name)
+	}
+	if mre.Name != "" && !wordRE.MatchString(mre.Name) {
+		return fmt.Errorf("invalid regexp name (must contain only word characters): %s", mre.Name)
+	}
+	return nil
+}
+
+func (m *MatchRemoteIP) unmarshalRegexpTokens(d *caddyfile.Dispenser, mre *MatchRegexp) error {
+	m.regexpCaptures = m.regexpCaptures[:0]
+	for d.Next() {
+		if mre.Pattern != "" {
+			return d.Err("regular expression can only be used once per named matcher")
+		}
+		args := d.RemainingArgs()
+		switch len(args) {
+		case 1:
+			mre.Pattern = args[0]
+		case 2:
+			mre.Name = args[0]
+			mre.Pattern = args[1]
+		default:
+			return d.ArgErr()
+		}
+		if mre.Name == "" {
+			mre.Name = d.GetContextString(caddyfile.MatcherNameCtxKey)
+		}
+		if d.NextBlock(0) {
+			return d.Err("malformed path_regexp matcher: blocks are not supported")
+		}
+	}
+	return nil
