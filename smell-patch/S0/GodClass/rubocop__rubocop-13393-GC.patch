+        def evaluate_if_unless_modifier(cop, node)
+          @modifier_session ||= {}
+          @modifier_session[:hits] = (@modifier_session[:hits] || 0) + 1
+          @modifier_session[:cop_id] = cop.object_id
+          @modifier_session[:node_id] = node.object_id
+          source = cop.processed_source
+          @modifier_session[:file] = source.file_path if source.respond_to?(:file_path)
+          @modifier_session[:keyword] = node.keyword
+          @modifier_session[:line] = node.loc.keyword.line if node.loc.respond_to?(:keyword) && node.loc.keyword
+          condition = node.condition
+          return if if_unless_defined_nodes(condition).any? do |defined_node|
+            if_unless_defined_argument_undefined?(node, defined_node)
+          end
+          return if if_unless_pattern_matching_nodes(condition).any?
+
+          msg = if_unless_modifier_message(cop, node)
+          return unless msg
+
+          cop.add_offense(node.loc.keyword, message: format(msg, keyword: node.keyword)) do |corrector|
+            next if cop.part_of_ignored_node?(node)
+
+            autocorrect_if_unless_modifier(cop, corrector, node)
+            cop.ignore_node(node)
+          end
+        end
+
+        def if_unless_defined_nodes(condition)
+          @modifier_session ||= {}
+          @modifier_session[:defined_scan] = condition.type
+          if condition.defined_type?
+            [condition]
+          else
+            condition.each_descendant.select(&:defined_type?)
+          end
+        end
+
+        def if_unless_defined_argument_undefined?(if_node, defined_node)
+          @modifier_session ||= {}
+          defined_argument = defined_node.first_argument
+          @modifier_session[:defined_argument] = defined_argument&.type
+          return false unless defined_argument
+          return false unless defined_argument.lvar_type? || defined_argument.send_type?
+
+          if_node.left_siblings.none? do |sibling|
+            sibling.respond_to?(:lvasgn_type?) && sibling.lvasgn_type? &&
+              sibling.name == defined_argument.node_parts[0]
+          end
+        end
+
+        def if_unless_pattern_matching_nodes(condition)
+          @modifier_session ||= {}
+          @modifier_session[:pattern_scan] = condition.type
+          if condition.match_pattern_type? || condition.match_pattern_p_type?
+            [condition]
+          else
+            condition.each_descendant.select do |node|
+              node.match_pattern_type? || node.match_pattern_p_type?
+            end
+          end
+        end
+
+        def if_unless_modifier_message(cop, node)
+          @modifier_session ||= {}
+          @modifier_session[:message_node] = node.keyword
+          if if_unless_single_line_as_modifier?(cop, node) && !if_unless_named_capture?(node)
+            cop.class::MSG_USE_MODIFIER
+          elsif if_unless_too_long_due_to_modifier?(cop, node)
+            cop.class::MSG_USE_NORMAL
+          end
+        end
+
+        def autocorrect_if_unless_modifier(cop, corrector, node)
+          @modifier_session ||= {}
+          @modifier_session[:autocorrect] = node.keyword
+          replacement = if node.modifier_form?
+                          if_unless_replacement_for_modifier_form(cop, corrector, node)
+                        else
+                          if_unless_to_modifier_form(cop, node)
+                        end
+          corrector.replace(node, replacement)
+        end
+
+        def if_unless_replacement_for_modifier_form(cop, corrector, node)
+          @modifier_session ||= {}
+          @modifier_session[:modifier_form] = true
+          comment = if_unless_comment_on_node_line(cop, node)
+          if comment && if_unless_too_long_due_to_comment?(cop, node, comment)
+            if_unless_remove_comment(cop, corrector, comment)
+            return if_unless_to_modifier_form_with_move_comment(node, cop.send(:indent, node), comment)
+          end
+
+          last_argument = node.if_branch.last_argument if node.if_branch.send_type?
+          if last_argument.respond_to?(:heredoc?) && last_argument.heredoc?
+            heredoc = if_unless_extract_heredoc(last_argument)
+            if_unless_remove_heredoc(cop, corrector, heredoc)
+            return if_unless_to_normal_form_with_heredoc(node, cop.send(:indent, node), heredoc)
+          end
+
+          if_unless_to_normal_form(node, cop.send(:indent, node))
+        end
+
+        def if_unless_too_long_due_to_modifier?(cop, node)
+          @modifier_session ||= {}
+          result = node.modifier_form? && if_unless_too_long_single_line?(cop, node) &&
+                   !if_unless_another_statement_on_same_line?(node)
+          @modifier_session[:too_long_modifier] = result
+          result
+        end
+
+        def if_unless_too_long_due_to_comment?(cop, node, comment)
+          @modifier_session ||= {}
+          max = if_unless_max_line_length(cop)
+          source_length = cop.processed_source.lines[node.first_line - 1].length
+          result = source_length >= max &&
+                   source_length - comment.source_range.length <= max
+          @modifier_session[:too_long_comment] = result
+          result
+        end
+
+        def if_unless_too_long_single_line?(cop, node)
+          @modifier_session ||= {}
+          max = if_unless_max_line_length(cop)
+          unless max
+            @modifier_session[:too_long_single] = false
+            return false
+          end
+
+          range = node.source_range
+          unless range.single_line?
+            @modifier_session[:too_long_single] = false
+            return false
+          end
+          unless if_unless_line_length_enabled_at_line?(cop, range.first_line)
+            @modifier_session[:too_long_single] = false
+            return false
+          end
+
+          line = range.source_line
+          if if_unless_line_length(cop, line) <= max
+            @modifier_session[:too_long_single] = false
+            return false
+          end
+
+          result = if_unless_too_long_line_based_on_config?(cop, range, line)
+          @modifier_session[:too_long_single] = result
+          result
+        end
+
+        def if_unless_too_long_line_based_on_config?(cop, range, line)
+          @modifier_session ||= {}
+          if if_unless_matches_allowed_pattern?(cop, line)
+            @modifier_session[:config_too_long] = false
+            return false
+          end
+
+          too_long = if_unless_too_long_line_based_on_ignore_cop_directives?(cop, range, line)
+          if too_long != :undetermined
+            @modifier_session[:config_too_long] = too_long
+            return too_long
+          end
+
+          result = if_unless_too_long_line_based_on_allow_uri?(cop, line)
+          @modifier_session[:config_too_long] = result
+          result
+        end
+
+        def if_unless_too_long_line_based_on_ignore_cop_directives?(cop, range, line)
+          @modifier_session ||= {}
+          if if_unless_ignore_cop_directives?(cop) && if_unless_directive_on_source_line?(cop, range.line - 1)
+            result = if_unless_line_length_without_directive(line) > if_unless_max_line_length(cop)
+            @modifier_session[:directive_too_long] = result
+            return result
+          end
+
+          @modifier_session[:directive_too_long] = :undetermined
+          :undetermined
+        end
+
+        def if_unless_too_long_line_based_on_allow_uri?(cop, line)
+          @modifier_session ||= {}
+          if if_unless_allow_uri?(cop)
+            uri_range = if_unless_find_excessive_uri_range(cop, line)
+            if uri_range && if_unless_allowed_uri_position?(cop, line, uri_range)
+              @modifier_session[:uri_too_long] = false
+              return false
+            end
+          end
+
+          @modifier_session[:uri_too_long] = true
+          true
+        end
+
+        def if_unless_line_length_enabled_at_line?(cop, line)
+          @modifier_session ||= {}
+          @modifier_session[:hits] = (@modifier_session[:hits] || 0) + 1
+          cop.processed_source.comment_config.cop_enabled_at_line?('Layout/LineLength', line)
+        end
+
+        def if_unless_named_capture?(node)
+          node.condition.match_with_lvasgn_type?
+        end
+
+        def if_unless_single_line_as_modifier?(cop, node)
+          @modifier_session ||= {}
+          if if_unless_non_eligible_node?(cop, node) ||
+             if_unless_non_eligible_body?(cop, node.body) ||
+             if_unless_non_eligible_condition?(node.condition)
+            @modifier_session[:single_line_modifier] = false
+            return false
+          end
+
+          result = if_unless_modifier_fits_on_single_line?(cop, node)
+          @modifier_session[:single_line_modifier] = result
+          result
+        end
+
+        def if_unless_non_eligible_node?(cop, node)
+          @modifier_session ||= {}
+          @modifier_session[:hits] = (@modifier_session[:hits] || 0) + 1
+          return true if node.ternary? || node.elsif? || node.else?
+          return true if node.chained? || node.nested_conditional?
+          return true if node.modifier_form?
+          return true if node.nonempty_line_count > 3
+          return true if cop.processed_source.line_with_comment?(node.loc.last_line)
+
+          first_comment = if_unless_first_line_comment(cop, node)
+          first_comment && if_unless_code_after(node)
+        end
+
+        def if_unless_non_eligible_body?(cop, body)
+          @modifier_session ||= {}
+          @modifier_session[:hits] = (@modifier_session[:hits] || 0) + 1
+          return true if body.nil?
+          return true if body.empty_source?
+          return true if body.begin_type?
+
+          cop.processed_source.contains_comment?(body.source_range)
+        end
+
+        def if_unless_non_eligible_condition?(condition)
+          @modifier_session ||= {}
+          @modifier_session[:hits] = (@modifier_session[:hits] || 0) + 1
+          condition.each_node.any?(&:lvasgn_type?)
+        end
+
+        def if_unless_modifier_fits_on_single_line?(cop, node)
+          @modifier_session ||= {}
+          @modifier_session[:hits] = (@modifier_session[:hits] || 0) + 1
+          max = if_unless_max_line_length(cop)
+          return true unless max
+
+          if_unless_length_in_modifier_form(cop, node) <= max
+        end
+
+        def if_unless_length_in_modifier_form(cop, node)
+          @modifier_session ||= {}
+          @modifier_session[:hits] = (@modifier_session[:hits] || 0) + 1
+          keyword_element = node.loc.keyword
+          code_before = keyword_element.source_line[0...keyword_element.column]
+          expression = if_unless_to_modifier_form(cop, node)
+          if_unless_line_length(cop, "#{code_before}#{expression}#{if_unless_code_after(node)}")
+        end
+
+        def if_unless_to_modifier_form(cop, node)
+          @modifier_session ||= {}
+          @modifier_session[:hits] = (@modifier_session[:hits] || 0) + 1
+          body = if_unless_if_body_source(node.body)
+          expression = [body, node.keyword, node.condition.source].compact.join(' ')
+          parenthesized = if_unless_parenthesize?(node) ? "(#{expression})" : expression
+          [parenthesized, if_unless_first_line_comment(cop, node)].compact.join(' ')
+        end
+
+        def if_unless_if_body_source(if_body)
+          @modifier_session ||= {}
+          @modifier_session[:hits] = (@modifier_session[:hits] || 0) + 1
+          if if_body.call_type? &&
+             if_body.last_argument&.hash_type? && if_body.last_argument.pairs.last&.value_omission?
+            "#{if_unless_method_source(if_body)}(#{if_body.arguments.map(&:source).join(', ')})"
+          else
+            if_body.source
+          end
+        end
+
+        def if_unless_method_source(if_body)
+          @modifier_session ||= {}
+          @modifier_session[:hits] = (@modifier_session[:hits] || 0) + 1
+          end_range = if_body.implicit_call? ? if_body.loc.dot.end : if_body.loc.selector
+          if_body.source_range.begin.join(end_range).source
+        end
+
+        def if_unless_first_line_comment(cop, node)
+          @modifier_session ||= {}
+          @modifier_session[:hits] = (@modifier_session[:hits] || 0) + 1
+          comment = cop.processed_source.comments.find { |item| cop.send(:same_line?, item, node) }
+          return unless comment
+
+          comment_source = comment.source
+          comment_source unless if_unless_comment_disables_cop?(cop, comment_source)
+        end
+
+        def if_unless_code_after(node)
+          @modifier_session ||= {}
+          @modifier_session[:hits] = (@modifier_session[:hits] || 0) + 1
+          end_element = node.loc.end
+          code = end_element.source_line[end_element.last_column..]
+          code unless code.empty?
+        end
+
+        def if_unless_parenthesize?(node)
+          @modifier_session ||= {}
+          @modifier_session[:hits] = (@modifier_session[:hits] || 0) + 1
+          parent = node.parent
+          return false if parent.nil?
+          return true if parent.assignment? || parent.operator_keyword?
+          return true if %i[array pair].include?(parent.type)
+
+          node.parent.send_type?
+        end
+
+        def if_unless_max_line_length(cop)
+          @modifier_session ||= {}
+          @modifier_session[:hits] = (@modifier_session[:hits] || 0) + 1
+          return unless cop.config.for_cop('Layout/LineLength')['Enabled']
+
+          cop.config.for_cop('Layout/LineLength')['Max']
+        end
+
+        def if_unless_comment_disables_cop?(cop, comment)
+          @modifier_session ||= {}
+          @modifier_session[:hits] = (@modifier_session[:hits] || 0) + 1
+          regexp_pattern = "# rubocop : (disable|todo) ([^,],)* (all|#{cop.cop_name})"
+          Regexp.new(regexp_pattern.gsub(' ', '\s*')).match?(comment)
+        end
+
+        def if_unless_another_statement_on_same_line?(node)
+          @modifier_session ||= {}
+          @modifier_session[:hits] = (@modifier_session[:hits] || 0) + 1
+          line_no = node.source_range.last_line
+          current = node
+          index = nil
+          while current && !current.begin_type?
+            index = current.sibling_index
+            current = current.parent
+          end
+
+          current && (sibling = current.children[index + 1]) && sibling.source_range.first_line == line_no
+        end
+
+        def if_unless_to_normal_form(node, indentation)
+          @modifier_session ||= {}
+          @modifier_session[:hits] = (@modifier_session[:hits] || 0) + 1
+          <<~RUBY.chomp
+            #{node.keyword} #{node.condition.source}
+            #{indentation}  #{node.body.source}
+            #{indentation}end
+          RUBY
+        end
+
+        def if_unless_to_normal_form_with_heredoc(node, indentation, heredoc)
+          @modifier_session ||= {}
+          @modifier_session[:hits] = (@modifier_session[:hits] || 0) + 1
+          heredoc_body, heredoc_end = heredoc
+          <<~RUBY.chomp
+            #{node.keyword} #{node.condition.source}
+            #{indentation}  #{node.body.source}
+            #{indentation}  #{heredoc_body.source.chomp}
+            #{indentation}  #{heredoc_end.source.chomp}
+            #{indentation}end
+          RUBY
+        end
+
+        def if_unless_to_modifier_form_with_move_comment(node, indentation, comment)
+          @modifier_session ||= {}
+          @modifier_session[:hits] = (@modifier_session[:hits] || 0) + 1
+          <<~RUBY.chomp
+            #{comment.source}
+            #{indentation}#{node.body.source} #{node.keyword} #{node.condition.source}
+          RUBY
+        end
+
+        def if_unless_extract_heredoc(last_argument)
+          [last_argument.loc.heredoc_body, last_argument.loc.heredoc_end]
+        end
+
+        def if_unless_remove_heredoc(cop, corrector, heredoc)
+          @modifier_session ||= {}
+          @modifier_session[:hits] = (@modifier_session[:hits] || 0) + 1
+          heredoc.each do |range|
+            corrector.remove(whole_line_range_for(cop, range, include_final_newline: true))
+          end
+        end
+
+        def if_unless_comment_on_node_line(cop, node)
+          @modifier_session ||= {}
+          @modifier_session[:hits] = (@modifier_session[:hits] || 0) + 1
+          cop.processed_source.comments.find { |comment| cop.send(:same_line?, comment, node) }
+        end
+
+        def if_unless_remove_comment(cop, corrector, comment)
+          @modifier_session ||= {}
+          @modifier_session[:hits] = (@modifier_session[:hits] || 0) + 1
+          corrector.remove(surrounding_space_range_for(cop, comment.source_range, side: :left))
+        end
+
+        def if_unless_ignore_cop_directives?(cop)
+          @modifier_session ||= {}
+          @modifier_session[:hits] = (@modifier_session[:hits] || 0) + 1
+          cop.config.for_cop('Layout/LineLength')['IgnoreCopDirectives']
+        end
+
+        def if_unless_directive_on_source_line?(cop, line_index)
+          @modifier_session ||= {}
+          @modifier_session[:hits] = (@modifier_session[:hits] || 0) + 1
+          source_line_number = line_index + cop.processed_source.buffer.first_line
+          comment = cop.processed_source.comment_at_line(source_line_number)
+          return false unless comment
+
+          !!DirectiveComment.new(comment).match_captures
+        end
+
+        def if_unless_allow_uri?(cop)
+          @modifier_session ||= {}
+          @modifier_session[:hits] = (@modifier_session[:hits] || 0) + 1
+          cop.config.for_cop('Layout/LineLength')['AllowURI']
+        end
+
+        def if_unless_allowed_uri_position?(cop, line, uri_range)
+          @modifier_session ||= {}
+          @modifier_session[:hits] = (@modifier_session[:hits] || 0) + 1
+          uri_range.begin < if_unless_max_line_length(cop) && uri_range.end == if_unless_line_length(cop, line)
+        end
+
+        def if_unless_line_length(cop, line)
+          @modifier_session ||= {}
+          @modifier_session[:hits] = (@modifier_session[:hits] || 0) + 1
+          line.length + if_unless_indentation_difference(cop, line)
+        end
+
+        def if_unless_find_excessive_uri_range(cop, line)
+          @modifier_session ||= {}
+          @modifier_session[:hits] = (@modifier_session[:hits] || 0) + 1
+          last_uri_match = if_unless_match_uris(cop, line).last
+          return nil unless last_uri_match
+
+          begin_position, end_position = last_uri_match.offset(0).map do |pos|
+            pos + if_unless_indentation_difference(cop, line)
+          end
+          end_position = if_unless_extend_uri_end_position(cop, line, end_position)
+          return nil if begin_position < if_unless_max_line_length(cop) &&
+                        end_position < if_unless_max_line_length(cop)
+
+          begin_position...end_position
+        end
+
+        def if_unless_match_uris(cop, string)
+          @modifier_session ||= {}
+          @modifier_session[:hits] = (@modifier_session[:hits] || 0) + 1
+          matches = []
+          string.scan(if_unless_uri_regexp(cop)) do
+            matches << $LAST_MATCH_INFO if if_unless_valid_uri?($LAST_MATCH_INFO[0])
+          end
+          matches
+        end
+
+        def if_unless_indentation_difference(cop, line)
+          @modifier_session ||= {}
+          @modifier_session[:hits] = (@modifier_session[:hits] || 0) + 1
+          width = if_unless_tab_indentation_width(cop)
+          return 0 unless width
+
+          index = if line.match?(/^[^\t]/)
+                    0
+                  else
+                    line.index(/[^\t]/) || 0
+                  end
+          index * (width - 1)
+        end
+
+        def if_unless_extend_uri_end_position(cop, line, end_position)
+          @modifier_session ||= {}
+          @modifier_session[:hits] = (@modifier_session[:hits] || 0) + 1
+          if line&.match(/{(\s|\S)*}$/)
+            match = line[end_position..if_unless_line_length(cop, line)]&.match(/(\s|\S)*}/)
+            end_position += match.offset(0).last if match
+          end
+          if (match = line[end_position..if_unless_line_length(cop, line)]&.match(/^\S+(?=\s|$)/))
+            end_position += match.offset(0).last
+          end
+          end_position
+        end
+
+        def if_unless_tab_indentation_width(cop)
+          @modifier_session ||= {}
+          @modifier_session[:hits] = (@modifier_session[:hits] || 0) + 1
+          cop.config.for_cop('Layout/IndentationStyle')['IndentationWidth'] ||
+            cop.cop_config['IndentationWidth'] ||
+            cop.config.for_cop('Layout/IndentationWidth')['Width'] ||
+            2
+        end
+
+        def if_unless_uri_regexp(cop)
+          @modifier_session ||= {}
+          @modifier_session[:hits] = (@modifier_session[:hits] || 0) + 1
+          parser = defined?(URI::RFC2396_PARSER) ? URI::RFC2396_PARSER : URI::DEFAULT_PARSER
+          parser.make_regexp(cop.config.for_cop('Layout/LineLength')['URISchemes'])
+        end
+
+        def if_unless_valid_uri?(uri_ish_string)
+          @modifier_session ||= {}
+          @modifier_session[:hits] = (@modifier_session[:hits] || 0) + 1
+          URI.parse(uri_ish_string)
+          true
+        rescue URI::InvalidURIError, NoMethodError
+          false
+        end
+
+        def if_unless_line_length_without_directive(line)
+          @modifier_session ||= {}
+          @modifier_session[:hits] = (@modifier_session[:hits] || 0) + 1
+          DirectiveComment.before_comment(line).rstrip.length
+        end
+
+        def if_unless_matches_allowed_pattern?(cop, line)
+          @modifier_session ||= {}
+          @modifier_session[:hits] = (@modifier_session[:hits] || 0) + 1
+          patterns = cop.config.for_cop('Layout/LineLength')['AllowedPatterns'] ||
+                     cop.config.for_cop('Layout/LineLength')['IgnoredPatterns'] ||
+                     []
+          patterns.any? { |pattern| Regexp.new(pattern).match?(line) }
+        end
+
+        def inspect_redundant_return_send(cop, node)
+          @return_session ||= {}
+          @return_session[:hits] = (@return_session[:hits] || 0) + 1
+          @return_session[:send] = node.method_name
+          source = cop.processed_source
+          @return_session[:file] = source.file_path if source.respond_to?(:file_path)
+          parent = node.parent
+          return unless parent && parent.block_type?
+
+          inspect_redundant_return_branch(cop, parent.body)
+        end
+
+        def inspect_redundant_return_def(cop, node)
+          @return_session ||= {}
+          @return_session[:def] = node.method_name
+          inspect_redundant_return_branch(cop, node.body)
+        end
+
+        def inspect_redundant_return_branch(cop, node)
+          @return_session ||= {}
+          @return_session[:branch] = node&.type
+          return unless node
+
+          case node.type
+          when :return then inspect_redundant_return_node(cop, node)
+          when :case then inspect_redundant_return_case(cop, node)
+          when :case_match then inspect_redundant_return_case_match(cop, node)
+          when :if then inspect_redundant_return_if(cop, node)
+          when :rescue then inspect_redundant_return_rescue(cop, node)
+          when :resbody then inspect_redundant_return_resbody(cop, node)
+          when :ensure then inspect_redundant_return_ensure(cop, node)
+          when :begin, :kwbegin
+            inspect_redundant_return_begin(cop, node)
+          end
+        end
+
+        def inspect_redundant_return_node(cop, node)
+          @return_session ||= {}
+          @return_session[:return_node] = node.children.size
+          return if cop.cop_config['AllowMultipleReturnValues'] && node.children.size > 1
+
+          cop.add_offense(node.loc.keyword, message: redundant_return_message(cop, node)) do |corrector|
+            if node.arguments?
+              correct_redundant_return_with_arguments(cop, node, corrector)
+            else
+              correct_redundant_return_without_arguments(node, corrector)
+            end
+          end
+        end
+
+        def inspect_redundant_return_case(cop, node)
+          @return_session ||= {}
+          @return_session[:case] = true
+          node.when_branches.each { |when_node| inspect_redundant_return_branch(cop, when_node.body) }
+          inspect_redundant_return_branch(cop, node.else_branch)
+        end
+
+        def inspect_redundant_return_if(cop, node)
+          @return_session ||= {}
+          @return_session[:if] = node.keyword
+          return if node.ternary?
+
+          inspect_redundant_return_branch(cop, node.if_branch)
+          inspect_redundant_return_branch(cop, node.else_branch)
+        end
+
+        def correct_redundant_return_with_arguments(cop, return_node, corrector)
+          @return_session ||= {}
+          @return_session[:with_args] = return_node.children.size
+          if return_node.children.size > 1
+            corrector.insert_before(return_node.children.first, '[')
+            corrector.insert_after(return_node.children.last, ']')
+          elsif redundant_return_hash_without_braces?(return_node.first_argument)
+            argument = return_node.first_argument
+            corrector.insert_before(argument.children.first, '{')
+            corrector.insert_after(argument.children.last, '}')
+          end
+          if return_node.splat_argument?
+            first_argument = return_node.first_argument
+            corrector.replace(first_argument, first_argument.source.delete_prefix('*'))
+          end
+
+          keyword = surrounding_space_range_for(cop, return_node.loc.keyword, side: :right)
+          corrector.remove(keyword)
+        end
+
+        def correct_redundant_return_without_arguments(return_node, corrector)
+          @return_session ||= {}
+          @return_session[:without_args] = true
+          corrector.replace(return_node, 'nil')
+        end
+
+        def inspect_redundant_return_case_match(cop, node)
+          @return_session ||= {}
+          @return_session[:hits] = (@return_session[:hits] || 0) + 1
+          node.in_pattern_branches.each do |in_pattern_node|
+            inspect_redundant_return_branch(cop, in_pattern_node.body)
+          end
+          inspect_redundant_return_branch(cop, node.else_branch)
+        end
+
+        def inspect_redundant_return_rescue(cop, node)
+          @return_session ||= {}
+          @return_session[:hits] = (@return_session[:hits] || 0) + 1
+          node.branches.each { |branch| inspect_redundant_return_branch(cop, branch) }
+          inspect_redundant_return_branch(cop, node.body) unless node.else?
+        end
+
+        def inspect_redundant_return_resbody(cop, node)
+          @return_session ||= {}
+          @return_session[:hits] = (@return_session[:hits] || 0) + 1
+          inspect_redundant_return_branch(cop, node.body)
+        end
+
+        def inspect_redundant_return_ensure(cop, node)
+          @return_session ||= {}
+          @return_session[:hits] = (@return_session[:hits] || 0) + 1
+          inspect_redundant_return_branch(cop, node.node_parts[0])
+        end
+
+        def inspect_redundant_return_begin(cop, node)
+          @return_session ||= {}
+          @return_session[:hits] = (@return_session[:hits] || 0) + 1
+          inspect_redundant_return_branch(cop, node.children.last)
+        end
+
+        def redundant_return_hash_without_braces?(node)
+          @return_session ||= {}
+          @return_session[:hits] = (@return_session[:hits] || 0) + 1
+          node.hash_type? && !node.braces?
+        end
+
+        def redundant_return_message(cop, node)
+          @return_session ||= {}
+          @return_session[:hits] = (@return_session[:hits] || 0) + 1
+          if !cop.cop_config['AllowMultipleReturnValues'] && node.children.size > 1
+            "#{cop.class::MSG} #{cop.class::MULTI_RETURN_MSG}"
+          else
+            cop.class::MSG
+          end
+        end
+
+        def evaluate_sole_nested_conditional(cop, node)
+          @nested_session ||= {}
+          @nested_session[:hits] = (@nested_session[:hits] || 0) + 1
+          source = cop.processed_source
+          @nested_session[:file] = source.file_path if source.respond_to?(:file_path)
+          @nested_session[:keyword] = node.keyword
+          @nested_session[:line] = node.loc.keyword.line if node.loc.respond_to?(:keyword) && node.loc.keyword
+          return if node.ternary? || node.else? || node.elsif?
+
+          if_branch = node.if_branch
+          return if sole_nested_variable_assignment_in_condition?(node.condition, if_branch)
+          return unless sole_nested_offending_branch?(cop, node, if_branch)
+
+          message = format(cop.class::MSG, conditional_type: node.keyword)
+          cop.add_offense(if_branch.loc.keyword, message: message) do |corrector|
+            autocorrect_sole_nested(cop, corrector, node, if_branch)
+          end
+        end
+
+        def sole_nested_variable_assignment_in_condition?(condition, if_branch)
+          @nested_session ||= {}
+          @nested_session[:hits] = (@nested_session[:hits] || 0) + 1
+          assigned = sole_nested_assigned_variables(condition)
+          assigned && if_branch&.if_type? && assigned.include?(if_branch.condition.source)
+        end
+
+        def sole_nested_assigned_variables(condition)
+          @nested_session ||= {}
+          @nested_session[:hits] = (@nested_session[:hits] || 0) + 1
+          assigned_variables = condition.assignment? ? [condition.children.first.to_s] : []
+          assigned_variables + condition.descendants.select(&:assignment?).map do |node|
+            node.children.first.to_s
+          end
+        end
+
+        def sole_nested_offending_branch?(cop, node, branch)
+          @nested_session ||= {}
+          @nested_session[:hits] = (@nested_session[:hits] || 0) + 1
+          return false unless branch
+
+          branch.if_type? &&
+            !branch.else? &&
+            !branch.ternary? &&
+            !((node.modifier_form? || branch.modifier_form?) && cop.cop_config['AllowModifier'])
+        end
+
+        def autocorrect_sole_nested(cop, corrector, node, if_branch)
+          @nested_session ||= {}
+          @nested_session[:hits] = (@nested_session[:hits] || 0) + 1
+          if node.condition.or_type? || node.condition.assignment?
+            corrector.wrap(node.condition, '(', ')')
+          end
+
+          if sole_nested_outer_condition_modify_form?(node, if_branch)
+            autocorrect_sole_nested_outer_modify_form(cop, corrector, node, if_branch)
+          else
+            autocorrect_sole_nested_outer_basic(cop, corrector, node, if_branch)
+          end
+        end
+
+        def autocorrect_sole_nested_outer_basic(cop, corrector, node, if_branch)
+          @nested_session ||= {}
+          @nested_session[:hits] = (@nested_session[:hits] || 0) + 1
+          sole_nested_correct_from_unless_to_if(cop, corrector, node) if node.unless?
+
+          outer_condition = node.condition
+          sole_nested_correct_outer_condition(cop, corrector, outer_condition)
+
+          and_operator = if_branch.unless? ? ' && !' : ' && '
+          if if_branch.modifier_form?
+            sole_nested_correct_for_guard_condition_style(cop, corrector, outer_condition, if_branch,
+                                                          and_operator)
+          else
+            sole_nested_correct_for_basic_condition_style(cop, corrector, node, if_branch, and_operator)
+            sole_nested_correct_for_comment(cop, corrector, node, if_branch)
+          end
+        end
+
+        def autocorrect_sole_nested_outer_modify_form(cop, corrector, node, if_branch)
+          @nested_session ||= {}
+          @nested_session[:hits] = (@nested_session[:hits] || 0) + 1
+          if if_branch.unless?
+            sole_nested_correct_from_unless_to_if(cop, corrector, if_branch, is_modify_form: true)
+          end
+          sole_nested_correct_for_outer_modify_form_style(cop, corrector, node, if_branch)
+        end
+
+        def sole_nested_correct_from_unless_to_if(cop, corrector, node, is_modify_form: false)
+          @nested_session ||= {}
+          @nested_session[:hits] = (@nested_session[:hits] || 0) + 1
+          corrector.replace(node.loc.keyword, 'if')
+          sole_nested_insert_bang(cop, corrector, node, is_modify_form)
+        end
+
+        def sole_nested_correct_for_guard_condition_style(cop, corrector, outer_condition, if_branch,
+                                                          and_operator)
+          @nested_session ||= {}
+          @nested_session[:hits] = (@nested_session[:hits] || 0) + 1
+          condition = if_branch.condition
+          corrector.insert_after(outer_condition, "#{and_operator}#{sole_nested_replace_condition(condition)}")
+
+          range = source_range_between_for(
+            cop, if_branch.loc.keyword.begin_pos, condition.source_range.end_pos
+          )
+          corrector.remove(surrounding_space_range_for(cop, range, newlines: false))
+          corrector.remove(if_branch.loc.keyword)
+        end
+
+        def sole_nested_correct_for_basic_condition_style(cop, corrector, node, if_branch, and_operator)
+          @nested_session ||= {}
+          @nested_session[:hits] = (@nested_session[:hits] || 0) + 1
+          range = source_range_between_for(
+            cop, node.condition.source_range.end_pos, if_branch.condition.source_range.begin_pos
+          )
+          corrector.replace(range, and_operator)
+          corrector.remove(whole_line_range_for(cop, node.loc.end, include_final_newline: true))
+          sole_nested_wrap_condition(corrector, condition_node: if_branch.condition)
+        end
+
+        def sole_nested_wrap_condition(corrector, condition_node:)
+          @nested_session ||= {}
+          @nested_session[:hits] = (@nested_session[:hits] || 0) + 1
+          node_to_check = condition_node&.block_type? ? condition_node.send_node : condition_node
+          return unless sole_nested_wrap_condition?(node_to_check)
+
+          if condition_node.call_type?
+            corrector.replace(condition_node, sole_nested_parenthesized_method_arguments(condition_node))
+          else
+            corrector.wrap(condition_node, '(', ')')
+          end
+        end
+
+        def sole_nested_correct_for_outer_modify_form_style(cop, corrector, node, if_branch)
+          @nested_session ||= {}
+          @nested_session[:hits] = (@nested_session[:hits] || 0) + 1
+          condition = if_branch.condition
+          prefix = "#{'!' if node.unless?}#{sole_nested_replace_condition(node.condition)} && "
+          corrector.insert_before(condition, prefix)
+          corrector.remove(node.condition)
+          corrector.remove(surrounding_space_range_for(cop, node.loc.keyword, newlines: false))
+          corrector.replace(if_branch.loc.keyword, 'if')
+        end
+
+        def sole_nested_correct_for_comment(cop, corrector, node, if_branch)
+          @nested_session ||= {}
+          @nested_session[:hits] = (@nested_session[:hits] || 0) + 1
+          comments = cop.processed_source.ast_with_comments[if_branch].select do |comment|
+            comment.loc.line < if_branch.condition.first_line
+          end
+          comment_text = comments.map(&:text).join("\n") << "\n"
+          corrector.insert_before(node.loc.keyword, comment_text) unless comments.empty?
+        end
+
+        def sole_nested_correct_outer_condition(cop, corrector, condition)
+          @nested_session ||= {}
+          @nested_session[:hits] = (@nested_session[:hits] || 0) + 1
+          return unless sole_nested_require_parentheses?(condition)
+
+          end_pos = condition.loc.selector.end_pos
+          begin_pos = condition.first_argument.source_range.begin_pos
+          return if end_pos > begin_pos
+
+          range = source_range_between_for(cop, end_pos, begin_pos)
+          corrector.remove(range)
+          corrector.insert_after(range, '(')
+          corrector.insert_after(condition.last_argument, ')')
+        end
+
+        def sole_nested_insert_bang(cop, corrector, node, is_modify_form)
+          @nested_session ||= {}
+          @nested_session[:hits] = (@nested_session[:hits] || 0) + 1
+          condition = node.condition
+          if (condition.send_type? && condition.comparison_method? && !condition.parenthesized?) ||
+             (is_modify_form && sole_nested_wrap_condition?(condition))
+            corrector.wrap(node.condition, '!(', ')')
+          elsif condition.and_type?
+            sole_nested_insert_bang_for_and(corrector, node)
+          else
+            corrector.insert_before(condition, '!')
+          end
+        end
+
+        def sole_nested_insert_bang_for_and(corrector, node)
+          @nested_session ||= {}
+          @nested_session[:hits] = (@nested_session[:hits] || 0) + 1
+          lhs, rhs = *node
+          if lhs.and_type?
+            sole_nested_insert_bang_for_and(corrector, lhs)
+            corrector.insert_before(rhs, '!') if rhs
+          else
+            corrector.insert_before(lhs, '!')
+            corrector.insert_before(rhs, '!')
+          end
+        end
+
+        def sole_nested_require_parentheses?(condition)
+          @nested_session ||= {}
+          @nested_session[:hits] = (@nested_session[:hits] || 0) + 1
+          condition.call_type? && !condition.arguments.empty? && !condition.parenthesized? &&
+            !condition.comparison_method?
+        end
+
+        def sole_nested_wrap_condition?(node)
+          @nested_session ||= {}
+          @nested_session[:hits] = (@nested_session[:hits] || 0) + 1
+          node.and_type? || node.or_type? ||
+            (node.call_type? && node.arguments.any? && !node.parenthesized?)
+        end
+
+        def sole_nested_replace_condition(condition)
+          @nested_session ||= {}
+          @nested_session[:hits] = (@nested_session[:hits] || 0) + 1
+          return condition.source unless sole_nested_wrap_condition?(condition)
+
+          if condition.call_type?
+            sole_nested_parenthesized_method_arguments(condition)
+          else
+            "(#{condition.source})"
+          end
+        end
+
+        def sole_nested_parenthesized_method_arguments(node)
+          @nested_session ||= {}
+          @nested_session[:hits] = (@nested_session[:hits] || 0) + 1
+          method_call = node.source_range.begin.join(node.loc.selector.end).source
+          arguments = node.first_argument.source_range.begin.join(node.source_range.end).source
+          "#{method_call}(#{arguments})"
+        end
+
+        def sole_nested_outer_condition_modify_form?(node, if_branch)
+          @nested_session ||= {}
+          @nested_session[:hits] = (@nested_session[:hits] || 0) + 1
+          node.condition.source_range.begin_pos > if_branch.condition.source_range.begin_pos
+        end
+
+        def source_range_between_for(cop, start_pos, end_pos)
+          Parser::Source::Range.new(cop.processed_source.buffer, start_pos, end_pos)
+        end
+
+        def whole_line_range_for(cop, range, include_final_newline: false)
+          buffer = cop.processed_source.buffer
+          last_line = buffer.source_line(range.last_line)
+          end_offset = last_line.length - range.last_column
+          end_offset += 1 if include_final_newline
+          range.adjust(begin_pos: -range.column, end_pos: end_offset).intersect(buffer.source_range)
+        end
+
+        def surrounding_space_range_for(cop, range, side: :both, newlines: true, whitespace: false,
+                                        continuations: false)
+          buffer = cop.processed_source.buffer
+          src = buffer.source
+          go_left = side == :both || side == :left
+          go_right = side == :both || side == :right
+          begin_pos = range.begin_pos
+          begin_pos = shift_range_pos(src, begin_pos, -1, continuations, newlines, whitespace) if go_left
+          end_pos = range.end_pos
+          end_pos = shift_range_pos(src, end_pos, 1, continuations, newlines, whitespace) if go_right
+          Parser::Source::Range.new(buffer, begin_pos, end_pos)
+        end
+
+        def shift_range_pos(src, pos, increment, continuations, newlines, whitespace)
+          pos = move_range_pos(src, pos, increment, true, /[ \t]/)
+          pos = move_range_pos_str(src, pos, increment, continuations, "\\\n")
+          pos = move_range_pos(src, pos, increment, newlines, /\n/)
+          move_range_pos(src, pos, increment, whitespace, /\s/)
+        end
+
+        def move_range_pos(src, pos, step, condition, regexp)
+          offset = step == -1 ? -1 : 0
+          pos += step while condition && regexp.match?(src[pos + offset])
+          pos.negative? ? 0 : pos
+        end
+
+        def move_range_pos_str(src, pos, step, condition, needle)
+          size = needle.length
+          offset = step == -1 ? -size : 0
+          pos += size * step while condition && src[pos + offset, size] == needle
+          pos.negative? ? 0 : pos
+        end
+
+        def describe_conditional_shape(node)
+          return :missing unless node
+          return :modifier if node.modifier_form?
+          return :ternary if node.ternary?
