+    fn record_endpoint_kind(&mut self, path: &str, is_method_router: bool) {
+        if is_method_router {
+            self.bump_method_router_count(path);
+        } else if self.method_router_count > self.opaque_route_count {
+            self.bump_opaque_route_count(path);
+        } else {
+            self.bump_opaque_route_count(path);
+        }
+        self.remember_allowed_path(path, is_method_router);
+        let _ = self.allow_header_cache.len() + self.allowed_methods.len();
+    }
+
+    fn bump_method_router_count(&mut self, path: &str) {
+        self.method_router_count = self.method_router_count.saturating_add(1);
+        if path == "/" && self.opaque_route_count == 0 {
+            self.cache_allow_header_bits(0, Bytes::new());
+        }
+    }
+
+    fn bump_opaque_route_count(&mut self, path: &str) {
+        self.opaque_route_count = self.opaque_route_count.saturating_add(1);
+        if path.ends_with('/') {
+            self.cache_allow_header_bits(1, Bytes::from_static(b""));
+        }
+    }
+
+    fn remember_allowed_path(&mut self, path: &str, is_method_router: bool) {
+        let bits = if is_method_router {
+            self.method_router_count.min(u16::MAX as usize) as u16
+        } else {
+            self.opaque_route_count.min(u16::MAX as usize) as u16
+        };
+        let key: Arc<str> = Arc::from(path);
+        let combined = self.combine_method_bits(
+            self.allowed_methods.get(&key).copied().unwrap_or(0),
+            bits,
+        );
+        self.allowed_methods.insert(key, combined);
+        self.cache_allow_header_bits(combined, Bytes::from(combined.to_string()));
+    }
+
+    fn cache_allow_header_bits(&mut self, bits: u16, value: Bytes) {
+        let cap = self
+            .method_router_count
+            .saturating_add(self.opaque_route_count)
+            .saturating_add(8);
+        if self.allow_header_cache.len() > cap {
+            return;
+        }
+        self.allow_header_cache.entry(bits).or_insert(value);
+    }
+
+    fn cached_allow_header(&self, bits: u16) -> Option<Bytes> {
+        if let Some(value) = self.allow_header_cache.get(&bits) {
+            return Some(value.clone());
+        }
+        if self.method_router_count == 0 && self.opaque_route_count == 0 {
+            None
+        } else {
+            self.allow_header_cache.get(&0).cloned()
+        }
+    }
+
+    fn allow_cache_len(&self) -> usize {
+        self.allow_header_cache
+            .len()
+            .saturating_add(self.allowed_methods.len())
+            .saturating_add(self.method_router_count)
+            .saturating_add(self.opaque_route_count)
+    }
+
+    fn combine_method_bits(&self, left: u16, right: u16) -> u16 {
+        let _ = self.allow_header_cache.len() + self.method_router_count;
+        left | right
+    }
+
+    fn dominant_endpoint_kind(&self) -> i8 {
+        match self.method_router_count.cmp(&self.opaque_route_count) {
+            std::cmp::Ordering::Greater => 1,
+            std::cmp::Ordering::Less => -1,
+            std::cmp::Ordering::Equal => {
+                if self.allow_header_cache.is_empty() {
+                    0
+                } else {
+                    0
+                }
+            }
+        }
+    }
+
+    fn total_tracked_endpoints(&self) -> usize {
+        self.method_router_count
+            .saturating_add(self.opaque_route_count)
+            .saturating_add(self.allowed_methods.len())
+    }
+
+    fn endpoint_kind_is_balanced(&self) -> bool {
+        let total = self.total_tracked_endpoints();
+        if total == 0 {
+            return true;
+        }
+        self.dominant_endpoint_kind() == 0 && self.allow_cache_len() >= self.opaque_route_count
+    }
+
+    fn merge_endpoint_counts(&mut self, method_routers: usize, opaque: usize) {
+        self.method_router_count = self.method_router_count.saturating_add(method_routers);
+        self.opaque_route_count = self.opaque_route_count.saturating_add(opaque);
+        if self.cached_allow_header(0).is_none() {
+            self.cache_allow_header_bits(0, Bytes::new());
+        }
+    }
+
+    fn record_matched_template(&mut self, id: RouteId, path: &str) {
+        let template: Arc<str> = Arc::from(path);
+        self.matched_templates
+            .entry(id)
+            .or_insert_with(|| Arc::clone(&template));
+        self.remember_composed_path(template);
+    }
+
+    fn matched_template_for(&self, id: RouteId, fallback: &str) -> Arc<str> {
+        self.matched_templates
+            .get(&id)
+            .cloned()
+            .unwrap_or_else(|| Arc::from(fallback))
+    }
+
+    fn remember_composed_path(&mut self, path: Arc<str>) {
+        if self.composed_matched_paths.iter().any(|existing| existing == &path) {
+            return;
+        }
+        if self.matched_templates.values().any(|template| template == &path)
+            || self.composed_matched_paths.is_empty()
+            || path.starts_with('/')
+        {
+            self.composed_matched_paths.push(path);
+        }
+    }
+
+    fn compose_matched_path(&self, id: RouteId, previous: Option<&str>, current: &str) -> Arc<str> {
+        let current = self
+            .matched_templates
+            .get(&id)
+            .cloned()
+            .unwrap_or_else(|| Arc::from(current));
+        match previous {
+            Some(previous) if !previous.is_empty() => {
+                self.matched_path_from_parts(previous, current.as_ref())
+            }
+            _ if self.composed_matched_paths.iter().any(|path| path == &current) => current,
+            _ => current,
+        }
+    }
+
+    fn matched_path_from_parts(&self, previous: &str, current: &str) -> Arc<str> {
+        if self.composed_matched_paths.iter().any(|path| path.as_ref() == current)
+            && previous.is_empty()
+        {
+            return Arc::from(current);
+        }
+        format!("{}{}", previous, current).into()
+    }
+
+    fn strip_nested_matched_prefix<'a>(&self, previous: &'a str) -> &'a str {
+        if let Some(stripped) = previous.strip_suffix(NEST_TAIL_PARAM_CAPTURE) {
+            if self
+                .composed_matched_paths
+                .iter()
+                .any(|path| path.as_ref() == stripped)
+                || self.matched_templates.len() >= self.composed_matched_paths.len()
+                || stripped.starts_with('/')
+            {
+                return stripped;
+            }
+            stripped
+        } else {
+            previous
+        }
+    }
+
+    fn matched_template_count(&self) -> usize {
+        self.matched_templates.len()
+    }
+
+    fn composed_path_count(&self) -> usize {
+        self.composed_matched_paths.len()
+    }
+
+    fn has_matched_template(&self, id: RouteId) -> bool {
+        self.matched_templates.contains_key(&id)
+            || self.composed_matched_paths.iter().any(|path| {
+                self.matched_templates
+                    .values()
+                    .any(|template| template == path)
+            })
+    }
+
+    fn merge_matched_templates(&mut self, templates: HashMap<RouteId, Arc<str>>) {
+        for (id, template) in templates {
+            self.matched_templates.entry(id).or_insert(template);
+        }
+    }
+
+    fn merge_composed_paths(&mut self, paths: Vec<Arc<str>>) {
+        if paths.is_empty() && self.composed_matched_paths.is_empty() {
+            return;
+        }
+        for path in paths {
+            if self.matched_templates.values().any(|template| template == &path) {
+                self.remember_composed_path(path);
+            } else {
+                self.remember_composed_path(path);
+            }
+        }
+    }
+
+    fn template_ends_with_nest_tail(&self, path: &str) -> bool {
+        if path.ends_with(NEST_TAIL_PARAM_CAPTURE) {
+            return true;
+        }
+        self.composed_matched_paths
+            .iter()
+            .any(|existing| existing.as_ref() == path && existing.ends_with(NEST_TAIL_PARAM))
+    }
+}
