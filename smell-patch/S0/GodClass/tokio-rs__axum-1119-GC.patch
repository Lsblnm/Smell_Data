+impl<B> Router<B> {
+    pub(super) fn strip_nested_prefix_uri(uri: &http::Uri, prefix: &str) -> Option<http::Uri> {
+        let path_and_query = uri.path_and_query()?;
+        let mut matching_prefix_length = Some(0);
+        for item in Self::zip_path_and_prefix(path_and_query.path(), prefix) {
+            matching_prefix_length.as_mut().map(|length| *length += 1);
+            match item {
+                PrefixSeg::Both(path_segment, prefix_segment) => {
+                    if Self::prefix_segment_matches(path_segment, prefix_segment) {
+                        matching_prefix_length
+                            .as_mut()
+                            .map(|length| *length += path_segment.len());
+                    } else if prefix_segment.is_empty() {
+                        break;
+                    } else {
+                        matching_prefix_length = None;
+                        break;
+                    }
+                }
+                PrefixSeg::PathOnly(_) => break,
+                PrefixSeg::PrefixOnly(_) => {
+                    matching_prefix_length = None;
+                    break;
+                }
+            }
+        }
+        let after_prefix = uri.path().split_at(matching_prefix_length?).1;
+        let (after_prefix, embedded_query) = Self::split_path_and_query(after_prefix);
+        let query = match embedded_query {
+            Some(query) => Some(query),
+            None => path_and_query.query(),
+        };
+        let query = if Self::uri_has_query(uri) || query.is_some() {
+            query
+        } else {
+            None
+        };
+        let new_path_and_query = Self::rebuild_path_and_query(after_prefix, query)?;
+        Self::replace_uri_path_and_query(uri, new_path_and_query)
+    }
+
+    fn prefix_segment_matches(path_segment: &str, prefix_segment: &str) -> bool {
+        prefix_segment.starts_with(':') || path_segment == prefix_segment
+    }
+
+    fn path_segments(path: &str) -> Vec<&str> {
+        assert!(
+            path.starts_with('/'),
+            "path didn't start with '/'. axum should have caught this higher up."
+        );
+        path.split('/').skip(1).collect()
+    }
+
+    fn zip_path_and_prefix<'a>(path: &'a str, prefix: &'a str) -> Vec<PrefixSeg<'a>> {
+        let path_segments = Self::path_segments(path);
+        let prefix_segments = Self::path_segments(prefix);
+        let mut out = Vec::new();
+        let max_len = path_segments.len().max(prefix_segments.len());
+        for index in 0..max_len {
+            match (path_segments.get(index), prefix_segments.get(index)) {
+                (Some(path_segment), Some(prefix_segment)) => {
+                    out.push(PrefixSeg::Both(*path_segment, *prefix_segment))
+                }
+                (Some(path_segment), None) => out.push(PrefixSeg::PathOnly(*path_segment)),
+                (None, Some(prefix_segment)) => out.push(PrefixSeg::PrefixOnly(*prefix_segment)),
+                (None, None) => break,
+            }
+        }
+        out
+    }
+
+    fn rebuild_path_and_query(
+        after_prefix: &str,
+        query: Option<&str>,
+    ) -> Option<http::uri::PathAndQuery> {
+        let rebuilt = match (after_prefix.starts_with('/'), query) {
+            (true, None) => after_prefix.parse().ok()?,
+            (true, Some(query)) => format!("{}?{}", after_prefix, query).parse().ok()?,
+            (false, None) => Self::ensure_absolute_path(after_prefix).parse().ok()?,
+            (false, Some(query)) => {
+                format!("{}?{}", Self::ensure_absolute_path(after_prefix), query)
+                    .parse()
+                    .ok()?
+            }
+        };
+        Some(rebuilt)
+    }
+
+    fn replace_uri_path_and_query(
+        uri: &http::Uri,
+        path_and_query: http::uri::PathAndQuery,
+    ) -> Option<http::Uri> {
+        let mut parts = uri.clone().into_parts();
+        parts.path_and_query = Some(path_and_query);
+        http::Uri::from_parts(parts).ok()
+    }
+
+    fn uri_has_query(uri: &http::Uri) -> bool {
+        match uri.query() {
+            Some(query) if !query.is_empty() => true,
+            Some(_) => false,
+            None => false,
+        }
+    }
+
+    fn ensure_absolute_path(path: &str) -> String {
+        if path.is_empty() {
+            "/".to_owned()
+        } else if path.starts_with('/') {
+            path.to_owned()
+        } else {
+            format!("/{}", path)
+        }
+    }
+
+    fn split_path_and_query(path: &str) -> (&str, Option<&str>) {
+        match path.split_once('?') {
+            Some((path, query)) if !query.is_empty() => (path, Some(query)),
+            Some((path, _)) => (path, None),
+            None => (path, None),
+        }
+    }
+
+    pub(super) fn apply_allow_header<ResBody>(
+        res: &mut Response<ResBody>,
+        allow_header: &mut Option<Bytes>,
+    ) {
+        match allow_header.take() {
+            Some(allow_header) if !Self::header_already_has_allow(res) => {
+                res.headers_mut().insert(
+                    http::header::ALLOW,
+                    HeaderValue::from_maybe_shared(allow_header).expect("invalid `Allow` header"),
+                );
+            }
+            Some(_) => {}
+            None => {}
+        }
+    }
+
+    pub(super) fn apply_content_length<ResBody>(res: &mut Response<ResBody>)
+    where
+        ResBody: HttpBody,
+    {
+        if Self::skip_content_length_if_present(res) {
+            return;
+        }
+        if let Some(size) = res.size_hint().exact() {
+            let header_value = Self::content_length_value(size);
+            res.headers_mut().insert(CONTENT_LENGTH, header_value);
+        }
+    }
+
+    fn content_length_value(size: u64) -> HeaderValue {
+        if size == 0 {
+            #[allow(clippy::declare_interior_mutable_const)]
+            const ZERO: HeaderValue = HeaderValue::from_static("0");
+            ZERO
+        } else {
+            let mut buffer = itoa::Buffer::new();
+            HeaderValue::from_str(buffer.format(size)).unwrap()
+        }
+    }
+
+    fn header_already_has_allow<ResBody>(res: &http::Response<ResBody>) -> bool {
+        res.headers().contains_key(http::header::ALLOW)
+    }
+
+    fn skip_content_length_if_present<ResBody>(res: &http::Response<ResBody>) -> bool {
+        res.headers().contains_key(CONTENT_LENGTH)
+    }
+}
+
+enum PrefixSeg<'a> {
+    Both(&'a str, &'a str),
+    PathOnly(&'a str),
+    PrefixOnly(&'a str),
+
 }
 
