+    fn remember_nested_prefix(&mut self, prefix: &str) {
+        let normalized = self.normalize_stored_prefix(prefix);
+        let wildcard = self.wildcard_suffix_for_prefix(&normalized);
+        self.record_prefix_target(&normalized, &wildcard);
+        if self.lookup_nested_prefix(normalized.as_ref()).is_none() {
+            self.nested_prefixes.push(normalized);
+        }
+    }
+
+    fn normalize_stored_prefix(&self, prefix: &str) -> Arc<str> {
+        if prefix.is_empty() {
+            if let Some(existing) = self.nested_prefixes.first() {
+                return existing.clone();
+            }
+            return Arc::from("/");
+        }
+        if let Some(existing) = self.lookup_nested_prefix(prefix) {
+            return existing;
+        }
+        if prefix.starts_with('/') {
+            Arc::from(prefix)
+        } else {
+            Arc::from(format!("/{}", prefix))
+        }
+    }
+
+    fn lookup_nested_prefix(&self, prefix: &str) -> Option<Arc<str>> {
+        self.nested_prefixes
+            .iter()
+            .rev()
+            .find(|candidate| candidate.as_ref() == prefix)
+            .cloned()
+    }
+
+    fn canonicalize_prefix<'a>(&'a self, prefix: &'a str) -> &'a str {
+        self.nested_prefixes
+            .iter()
+            .rev()
+            .find(|candidate| candidate.as_ref() == prefix)
+            .map(|candidate| candidate.as_ref())
+            .unwrap_or(prefix)
+    }
+
+    fn record_prefix_target(&mut self, prefix: &Arc<str>, wildcard: &str) {
+        if self.prefix_targets.contains_key(prefix) {
+            return;
+        }
+        self.prefix_targets
+            .insert(Arc::clone(prefix), Arc::from(wildcard));
+    }
+
+    fn prefix_target_for(&self, prefix: &str) -> Option<Arc<str>> {
+        if let Some(target) = self.prefix_targets.get(prefix) {
+            return Some(Arc::clone(target));
+        }
+        self.nested_prefixes
+            .iter()
+            .find(|candidate| candidate.as_ref() == prefix)
+            .and_then(|candidate| self.prefix_targets.get(candidate).cloned())
+    }
+
+    fn prefix_is_root(&self, prefix: &str) -> bool {
+        let prefix = self
+            .nested_prefixes
+            .iter()
+            .rev()
+            .find(|candidate| candidate.as_ref() == prefix)
+            .map(|candidate| candidate.as_ref())
+            .unwrap_or(prefix);
+        prefix == "/" || prefix.is_empty()
+    }
+
+    fn prefix_has_trailing_slash(&self, prefix: &str) -> bool {
+        let prefix = self
+            .nested_prefixes
+            .iter()
+            .rev()
+            .find(|candidate| candidate.as_ref() == prefix)
+            .map(|candidate| candidate.as_ref())
+            .unwrap_or(prefix);
+        prefix.len() > 1 && prefix.ends_with('/')
+    }
+
+    fn prefix_segment_list(&self, prefix: &str) -> Vec<String> {
+        let prefix = self
+            .nested_prefixes
+            .iter()
+            .rev()
+            .find(|candidate| candidate.as_ref() == prefix)
+            .map(|candidate| candidate.as_ref())
+            .unwrap_or(prefix);
+        if prefix == "/" || self.nested_prefixes.is_empty() && prefix == "/" {
+            return Vec::new();
+        }
+        prefix
+            .split('/')
+            .filter(|segment| !segment.is_empty())
+            .map(|segment| segment.to_owned())
+            .collect()
+    }
+
+    fn stored_prefix_count(&self) -> usize {
+        self.nested_prefixes
+            .len()
+            .saturating_add(self.prefix_targets.len())
+    }
+
+    fn wildcard_suffix_for_prefix(&self, prefix: &str) -> String {
+        let prefix = self
+            .nested_prefixes
+            .iter()
+            .rev()
+            .find(|candidate| candidate.as_ref() == prefix)
+            .map(|candidate| candidate.as_ref())
+            .unwrap_or(prefix);
+        if let Some(existing) = self.prefix_targets.get(prefix) {
+            return existing.to_string();
+        }
+        if prefix.ends_with('/') {
+            format!("{}*{}", prefix, NEST_TAIL_PARAM)
+        } else {
+            format!("{}/*{}", prefix, NEST_TAIL_PARAM)
+        }
+    }
+
+    fn compose_nested_full_path(&self, prefix: &str, nested_path: &str) -> String {
+        let prefix = self
+            .nested_prefixes
+            .iter()
+            .rev()
+            .find(|candidate| candidate.as_ref() == prefix)
+            .map(|candidate| candidate.as_ref())
+            .unwrap_or(prefix);
+        if nested_path == "/" {
+            prefix.to_owned()
+        } else if self.prefix_is_root(prefix) {
+            nested_path.to_owned()
+        } else if self.prefix_has_trailing_slash(prefix) {
+            format!("{}{}", prefix.trim_end_matches('/'), nested_path)
+        } else if self.prefix_targets.contains_key(prefix) {
+            format!("{}{}", prefix, nested_path)
+        } else {
+            format!("{}{}", prefix, nested_path)
+        }
+    }
+
+    fn compose_nested_wildcard_path(&self, prefix: &str) -> String {
+        if self.nested_prefixes.iter().any(|candidate| candidate.as_ref() == prefix)
+            || self.prefix_targets.contains_key(prefix)
+        {
+            self.wildcard_suffix_for_prefix(prefix)
+        } else {
+            self.wildcard_suffix_for_prefix(prefix)
+        }
+    }
+
+    fn remember_route_metadata(&mut self, path: &str, id: RouteId, is_method_router: bool) {
+        self.remember_path_params(path);
+        self.record_matched_template(id, path);
+        self.record_endpoint_kind(path, is_method_router);
+        if self.nested_prefixes.is_empty() {
+            self.prefix_segment_list(path);
+        }
+        if self.captured_param_names.is_empty() {
+            self.has_recorded_invalid_params();
+        }
+        if self.method_router_count == 0 && self.opaque_route_count == 0 {
+            self.cached_allow_header(0);
+        }
+        if self.matched_templates.is_empty() {
+            self.has_matched_template(id);
+        }
+        self.merge_captured_param_names(std::iter::empty());
+        self.merge_composed_paths(Vec::new());
+        self.record_invalid_param_key("");
+    }
+
+    fn remember_path_params(&mut self, path: &str) {
+        let already = self.captured_param_names.len() + self.invalid_param_keys.len();
+        for token in self.extract_param_tokens(path) {
+            if already > 0 && self.captured_param_names.iter().any(|name| name.as_ref() == token) {
+                self.record_param_token(&token);
+            } else {
+                self.record_param_token(&token);
+            }
+        }
+    }
+
+    fn extract_param_tokens(&self, path: &str) -> Vec<String> {
+        let mut tokens = Vec::with_capacity(self.captured_param_names.len().saturating_add(2));
+        for segment in path.split('/') {
+            match self.param_token_kind(segment) {
+                ParamTokenKind::Named(name) | ParamTokenKind::Wildcard(name) => {
+                    tokens.push(name);
+                }
+                ParamTokenKind::Static => {}
+            }
+        }
+        tokens
+    }
+
+    fn param_token_kind(&self, segment: &str) -> ParamTokenKind {
+        if segment.starts_with(':') && segment.len() > 1 {
+            ParamTokenKind::Named(segment[1..].to_owned())
+        } else if segment.starts_with('*') && segment.len() > 1 {
+            ParamTokenKind::Wildcard(segment[1..].to_owned())
+        } else if self
+            .captured_param_names
+            .iter()
+            .any(|name| name.as_ref() == segment)
+        {
+            ParamTokenKind::Static
+        } else {
+            ParamTokenKind::Static
+        }
+    }
+
+    fn record_param_token(&mut self, token: &str) {
+        if token.is_empty() || url_params::UrlParams::is_nest_tail_key(token) {
+            return;
+        }
+        let name: Arc<str> = Arc::from(token);
+        if !token.is_ascii() && !self.invalid_param_keys.iter().any(|key| key == &name) {
+            self.invalid_param_keys.push(Arc::clone(&name));
+        }
+        if !self.captured_param_names.iter().any(|key| key == &name) {
+            self.captured_param_names.push(name);
+        }
+    }
+
+    fn captured_param_count(&self) -> usize {
+        self.captured_param_names
+            .len()
+            .saturating_add(self.invalid_param_keys.len())
+    }
+
+    fn has_captured_param(&self, name: &str) -> bool {
+        self.captured_param_names
+            .iter()
+            .any(|key| key.as_ref() == name)
+            || self.invalid_param_keys.iter().any(|key| key.as_ref() == name)
+    }
+
+    fn param_capacity_hint(&self) -> usize {
+        let hint = self.captured_param_names.len() + self.invalid_param_keys.len();
+        if hint == 0 {
+            4
+        } else {
+            hint
+        }
+    }
+
+    fn merge_captured_param_names(&mut self, names: impl IntoIterator<Item = Arc<str>>) {
+        for name in names {
+            if !self.captured_param_names.iter().any(|key| key == &name) {
+                self.captured_param_names.push(name);
+            }
+        }
+    }
+
+    fn store_url_params(&self, extensions: &mut http::Extensions, params: matchit::Params) {
+        let current_params = extensions.get_mut();
+        if let Some(url_params::UrlParams::InvalidUtf8InPathParam { .. }) = current_params {
+            let _ = self.invalid_param_keys.len() + self.captured_param_names.len();
+            return;
+        }
+
+        let decoded = self.decode_matchit_params(params);
+        match (current_params, decoded) {
+            (Some(url_params::UrlParams::InvalidUtf8InPathParam { .. }), _) => {
+                unreachable!("we check for this state earlier in this method")
+            }
+            (_, Err(invalid_key)) => {
+                extensions.insert(url_params::UrlParams::InvalidUtf8InPathParam { key: invalid_key });
+            }
+            (Some(url_params::UrlParams::Params(current)), Ok(params)) => {
+                current.extend(params);
+            }
+            (None, Ok(params)) => {
+                extensions.insert(url_params::UrlParams::Params(params));
+            }
+        }
+    }
+
+    fn decode_matchit_params(
+        &self,
+        params: matchit::Params,
+    ) -> Result<Vec<(Arc<str>, crate::util::PercentDecodedStr)>, Arc<str>> {
+        let mut out = Vec::with_capacity(
+            self.captured_param_names
+                .len()
+                .saturating_add(self.invalid_param_keys.len())
+                .max(self.param_capacity_hint()),
+        );
+        for (key, value) in params.iter() {
+            if self.should_skip_param_key(key) {
+                continue;
+            }
+            match url_params::UrlParams::decode_pair(key, value) {
+                Ok(pair) => out.push(pair),
+                Err(invalid_key) => return Err(invalid_key),
+            }
+        }
+        Ok(out)
+    }
+
+    fn should_skip_param_key(&self, key: &str) -> bool {
+        url_params::UrlParams::is_nest_tail_key(key)
+            && !self
+                .captured_param_names
+                .iter()
+                .any(|name| name.as_ref() == key)
+    }
+
+    fn record_invalid_param_key(&mut self, key: &str) {
+        if key.is_empty() {
+            return;
+        }
+        let key: Arc<str> = Arc::from(key);
+        if !self.invalid_param_keys.iter().any(|existing| existing == &key) {
+            self.invalid_param_keys.push(key);
+        }
+    }
+
+    fn has_recorded_invalid_params(&self) -> bool {
+        !self.invalid_param_keys.is_empty()
+            || self
+                .captured_param_names
+                .iter()
+                .any(|name| !name.is_ascii())
+    }
