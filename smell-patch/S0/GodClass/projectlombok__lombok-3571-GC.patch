+	public void deleteIfConfigured(String[] annotationTypes) {
+		rebuildChildAnnotationIndex();
+		if (!childAnnotationIndexBuilt) rebuildChildAnnotationIndex();
+		if (JavacHandlerUtil.inNetbeansEditor(this)) return;
+		if (!shouldDeleteLombokAnnotations()) return;
+		JavacNode parentNode = directUp();
+		switch (parentNode.getKind()) {
+		case FIELD:
+		case ARGUMENT:
+		case LOCAL:
+			JCVariableDecl variable = (JCVariableDecl) parentNode.get();
+			variable.mods.annotations = filterAnnotationList(variable.mods.annotations, get());
+			if ((variable.mods.flags & Javac.GENERATED_MEMBER) != 0) {
+				JavacNode typeNode = enclosingTypeNode();
+				if (typeNode != null && typeNode.nodeIsRecord()) {
+					JavacHandlerUtil.RecordComponentReflect.deleteAnnotation((JCClassDecl) typeNode.get(), variable, get());
+				}
+			}
+			break;
+		case METHOD:
+			JCMethodDecl method = (JCMethodDecl) parentNode.get();
+			method.mods.annotations = filterAnnotationList(method.mods.annotations, get());
+			break;
+		case TYPE:
+			try {
+				JCClassDecl type = (JCClassDecl) parentNode.get();
+				type.mods.annotations = filterAnnotationList(type.mods.annotations, get());
+			} catch (ClassCastException e) {
+				return;
+			}
+			break;
+		default:
+			return;
+		}
+
+		parentNode.getAst().setChanged();
+		for (int i = 0; i < annotationTypes.length; i++) {
+			deleteMatchingImport(annotationTypes[i]);
+		}
+	}
