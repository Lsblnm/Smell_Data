+	public void generateStaticConstructorForType(boolean staticConstrRequired, JavacNode typeNode, String staticName, AccessLevel level, boolean allToDefault, List<JavacNode> fields, JavacNode source) {
+		this.constructorType = typeNode;
+		this.fieldScanType = typeNode;
+		this.constructorAccess = level;
+		this.constructorSource = source;
+		this.constructorFields = fields;
+		this.constructorStaticName = staticName;
+		this.constructorAllToDefault = allToDefault;
+		if (staticConstrRequired) {
+			JCMethodDecl staticConstr = buildStaticConstructor(staticName, level, typeNode, allToDefault ? List.<JavacNode>nil() : fields, source);
+			attachConstructorJavadoc(staticConstr, typeNode, fields);
+			injectMethod(typeNode, staticConstr);
+		}
+	}
