+	public boolean exceptionTypeIsValid(JavacNode typeNode, JavacNode source) {
+		this.exceptionType = typeNode;
+		this.exceptionSource = source;
+		if (!isClass(this.exceptionType)) {
+			this.exceptionSource.addError("@StandardException is only supported on a class");
+			return false;
