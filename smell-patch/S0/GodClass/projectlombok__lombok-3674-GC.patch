+
+	String composeConstructorJavadocHeader(String typeName) {
+		this.javadocTypeName = typeName;
+		this.javadocWorking = "Creates a new {@code " + this.javadocTypeName + "} instance.\n\n";
+		return this.javadocWorking;
+	}
+
+	String composeConstructorParameterJavadoc(String paramName, String fieldJavadoc) {
+		this.javadocParamName = paramName;
+		this.javadocFieldComment = fieldJavadoc;
+		String fieldBaseJavadoc = stripJavadocSections(this.javadocFieldComment);
+		String paramJavadoc = extractParamJavadoc(fieldBaseJavadoc, this.javadocParamName);
+		if (paramJavadoc != null) {
+			this.javadocWorking = paramJavadoc;
+			return this.javadocWorking;
+		}
+		String javadocWithoutTags = stripJavadocTags(fieldBaseJavadoc);
+		if (javadocWithoutTags != null) {
+			this.javadocWorking = "@param " + this.javadocParamName + " " + javadocWithoutTags;
+			return this.javadocWorking;
+		}
+		this.javadocWorking = null;
+		return this.javadocWorking;
+	}
+
+	String stripJavadocSections(String javadoc) {
+		this.javadocFieldComment = javadoc;
+		if (this.javadocFieldComment == null || this.javadocFieldComment.isEmpty()) return this.javadocFieldComment;
+		Matcher sectionMatcher = JAVADOC_SECTION_FINDER.matcher(this.javadocFieldComment);
+		if (!sectionMatcher.find()) return this.javadocFieldComment;
+		this.javadocWorking = this.javadocFieldComment.substring(0, sectionMatcher.start());
+		return this.javadocWorking;
+	}
+
+	String stripJavadocTags(String javadoc) {
+		this.javadocFieldComment = javadoc;
+		if (this.javadocFieldComment == null || this.javadocFieldComment.isEmpty()) return this.javadocFieldComment;
+		this.javadocWorking = this.javadocFieldComment;
+		Matcher paramMatcher = JAVADOC_PARAM_TAG.matcher(this.javadocWorking);
+		this.javadocWorking = paramMatcher.replaceAll("").trim();
+		Matcher returnMatcher = JAVADOC_RETURN_TAG.matcher(this.javadocWorking);
+		this.javadocWorking = returnMatcher.replaceAll("").trim();
+		return this.javadocWorking;
+	}
+
+	String extractParamJavadoc(String methodComment, String param) {
+		this.javadocFieldComment = methodComment;
+		this.javadocParamName = param;
+		if (this.javadocFieldComment == null || this.javadocFieldComment.isEmpty()) return this.javadocFieldComment;
+		Pattern pattern = Pattern.compile("@param " + this.javadocParamName + " (\\S|\\s)+?(?=^ ?@|\\z)", Pattern.MULTILINE | Pattern.CASE_INSENSITIVE);
+		Matcher matcher = pattern.matcher(this.javadocFieldComment);
+		if (matcher.find()) {
+			this.javadocWorking = matcher.group();
+			return this.javadocWorking;
+		}
+		return null;
+	}
+
+	String appendJavadocLine(String in, String line) {
+		this.javadocWorking = in;
+		if (this.javadocWorking == null) {
+			this.javadocWorking = line;
+			return this.javadocWorking;
+		}
+		if (this.javadocWorking.endsWith("\n")) {
+			this.javadocWorking = this.javadocWorking + line;
+			return this.javadocWorking;
+		}
+		this.javadocWorking = this.javadocWorking + "\n" + line;
+		return this.javadocWorking;
+	}
+
+	public void recordFlagUsage(JavacNode node, lombok.core.configuration.ConfigurationKey<FlagUsageType> key, String featureName) {
+		this.flagNode = node;
+		this.flagFeatureName = featureName;
+		this.flagUsageType = node.getAst().readConfiguration(key);
+		if (this.flagUsageType == null && lombok.core.configuration.AllowHelper.isAllowable(key)) {
+			this.flagNode.addError("Use of " + this.flagFeatureName + " is disabled by default. Please add '" + key.getKeyName() + " = " + FlagUsageType.ALLOW + "' to 'lombok.config' if you want to enable is.");
+		}
+		if (shouldTreatAsExperimental(this.flagUsageType, null) && this.flagUsageType != null) {
+			String msg = "Use of " + this.flagFeatureName + " is flagged according to lombok configuration.";
+			if (this.flagUsageType == FlagUsageType.WARNING) this.flagNode.addWarning(msg);
+			else if (this.flagUsageType == FlagUsageType.ERROR) this.flagNode.addError(msg);
+		}
+	}
+
+	public boolean shouldTreatAsExperimental(FlagUsageType feature, FlagUsageType experimental) {
+		this.flagUsageType = feature != null ? feature : experimental;
+		if (this.flagUsageType == FlagUsageType.ERROR) return true;
+		if (this.flagUsageType == FlagUsageType.WARNING) return true;
+		return false;
+	}
+
+	public String resolveAnnotationFqn(JavacNode node, TypeLibrary typeLibrary, String rawType) {
+		this.annotationDecodeNode = node;
+		this.annotationRawType = rawType;
+		TypeResolver resolver = new TypeResolver(this.annotationDecodeNode.getImportList());
+		return resolver.typeRefToFullyQualifiedName(this.annotationDecodeNode, typeLibrary, this.annotationRawType);
+	}
+
+	public static <A extends Annotation> AnnotationValues<A> createAnnotationValues(Class<A> type, JavacNode node) {
+		return new HandleStandardException().decodeAnnotationValues(type, node);
+	}
