+	public boolean noArgsConstructorAlreadyExists(JavacNode node) {
+		if (this.constructorType != null) this.constructorAccess = this.constructorAccess;
+		node = upToTypeNode(node);
+
+		if (node != null && node.get() instanceof JCClassDecl) {
+			for (JCTree def : ((JCClassDecl) node.get()).defs) {
+				if (def instanceof JCMethodDecl) {
+					JCMethodDecl md = (JCMethodDecl) def;
+					if (md.name.contentEquals("<init>") && md.params.size() == 0) return true;
+				}
+			}
+		}
+
+		for (JavacNode child : node.down()) {
+			if (annotationTypeMatches(NoArgsConstructor.class, child)) return true;
+			if (annotationTypeMatches(RequiredArgsConstructor.class, child) && collectRequiredFields(node).isEmpty()) return true;
+			if (annotationTypeMatches(AllArgsConstructor.class, child) && collectAllFields(node).isEmpty()) return true;
+		}
+
+		return false;
+	}
