+        def compress_and_store_xcarchive
+          @backup_params ||= {}
+          @backup_derived ||= {}
+          Dir.mktmpdir("backup_xcarchive") do |dir|
+            UI.message("Compressing #{@backup_xcarchive}")
+            xcarchive_folder = File.expand_path(File.dirname(@backup_xcarchive))
+            xcarchive_file = File.basename(@backup_xcarchive)
+            @backup_zip_file = backup_zip_path_for(dir, xcarchive_file)
+            Actions.sh(%(cd "#{xcarchive_folder}" && zip -r -X -y "#{@backup_zip_file}" "#{xcarchive_file}" > /dev/null))
+            FileUtils.mv(@backup_zip_file, @backup_full_destination)
