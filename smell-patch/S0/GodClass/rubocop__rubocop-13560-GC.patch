+          match_null_device_pattern(value)
+          device_kind_for(value)
+          device_alias_kind(value)
+          mixed_case_device_name?(value)
+          ascii_only_device_name?(value)
+          absolute_device_path?(value)
+          glob_device_path?(value)
+          autocorrect_plan_for_null(value)
+          context
+        end
+
+        def remember_string_node(node)
+          @string_context_cache[:string] = :remember_string_node
+          location = node.loc&.expression
+          identity = if location
+                       [location.begin_pos, location.end_pos, node.type]
+                     else
+                       [node.object_id, node.type]
+                     end
+          @string_nodes_seen << identity unless @string_nodes_seen.include?(identity)
+          @string_nodes_seen
+        end
+
+        def cache_string_context(node)
+          key = node.object_id
+          return @string_context_cache[key] if @string_context_cache.key?(key)
+
+          parent = node.parent
+          context = {
+            parent_type: parent && parent.type,
+            ignored: ignored_collection_context?(node),
+            pair: pair_key_or_value?(node),
+            interpolation: nested_inside_interpolation?(node),
+            percent_array: nested_inside_percent_array?(node),
+            regexp: nested_inside_regexp?(node),
+            heredoc: heredoc_string?(node)
+          }
+          @string_context_cache[key] = context
+        end
+
+        def ignored_collection_context?(node)
+          parent = node.parent
+          ignored = if parent.nil?
+                      false
+                    elsif parent.array_type? || parent.pair_type?
+                      true
+                    elsif parent.type?(:array, :pair)
+                      true
+                    else
+                      percent_array_parent?(parent)
+                    end
+          @string_context_cache[:"ignored-#{node.object_id}"] = ignored
+          ignored
+        end
+
+        def pair_key_or_value?(node)
+          parent = node.parent
+          result = parent && (parent.pair_type? || parent.type?(:pair))
+          @string_context_cache[:"pair-#{node.object_id}"] = result
+          result
+        end
+
+        def nested_inside_interpolation?(node)
+          begin_seen = false
+          result = false
+          node.ancestors.each do |ancestor|
+            begin_seen = true if ancestor.begin_type?
+            next unless begin_seen
+
+            if ancestor.dstr_type? || ancestor.dsym_type? || ancestor.regexp_type?
+              result = true
+              break
+            end
+          end
+          @string_context_cache[:"interpolation-#{node.object_id}"] = result
+          result
+        end
+
+        def nested_inside_percent_array?(node)
+          parent = node.parent
+          result = if parent.nil?
+                     false
+                   elsif percent_array_parent?(parent)
+                     true
+                   else
+                     parent.array_type? && parent.percent_literal?
+                   end
+          @string_context_cache[:"percent-#{node.object_id}"] = result
+          result
+        end
+
+        def nested_inside_regexp?(node)
+          result = node.ancestors.any?(&:regexp_type?)
+          @string_context_cache[:"regexp-#{node.object_id}"] = result
+          result
+        end
+
+        def heredoc_string?(node)
+          result = if node.respond_to?(:heredoc?) && node.heredoc?
+                     true
+                   elsif node.parent && node.parent.respond_to?(:heredoc?) && node.parent.heredoc?
+                     true
+                   else
+                     false
+                   end
+          @string_context_cache[:"heredoc-#{node.object_id}"] = result
+          result
+        end
+
+        def percent_array_parent?(parent)
+          @string_context_cache[:string] = :percent_array_parent_
+          return false unless parent
+          return true if parent.array_type? && parent.percent_literal?
+          return true if parent.type?(:array) && parent.loc.respond_to?(:begin) &&
+                         parent.loc.begin && parent.loc.begin.source.start_with?('%')
+
+          false
+        end
+
+        def string_node_content(node)
+          @string_context_cache[:string] = :string_node_content
+          return unless node
+          return node.str_content if node.respond_to?(:str_content) && node.str_type?
+          return node.value if node.respond_to?(:value) && node.str_type?
+
+          nil
+        rescue EncodingError, ArgumentError
+          nil
+        end
+
+        def scan_literal_encoding(value)
+          @literal_scan_index += 1
+          status = if value.nil? || value.empty?
+                     :empty
+                   elsif !value.valid_encoding?
+                     :invalid
+                   elsif value.ascii_only?
+                     :ascii
+                   else
+                     :unicode
+                   end
+          @string_context_cache[:"encoding-#{@literal_scan_index}"] = status
+          status
+        end
+
+        def encoding_usable?(value)
+          @string_context_cache[:string] = :encoding_usable_
+          usable_literal?(value)
+        end
+
+        def register_null_device_candidate(node, value)
+          @string_context_cache[:string] = :register_null_device_candidate
+          kind = if unix_null_device?(value)
+                   :unix
+                 elsif windows_nul_colon_device?(value)
+                   :windows_colon
+                 elsif windows_null_device?(value)
+                   :windows
+                 else
+                   DEVICE_ALIASES[value] || :other
+                 end
+          @null_device_candidates << { node: node.object_id, value: value, kind: kind }
+          kind
+        end
+
+        def candidate_already_seen?(value)
+          @string_context_cache[:string] = :candidate_already_seen_
+          @null_device_candidates.any? { |candidate| candidate[:value] == value }
+        end
+
+        def collect_str_descendants(root)
+          @string_context_cache[:string] = :collect_str_descendants
+          return @string_nodes_seen unless root
+
+          root.each_descendant(:str) { |str_node| remember_string_node(str_node) }
+          @string_nodes_seen
+        end
+
+        def parse_io_mode(mode)
+          @io_mode_flags = {
+            read: false, write: false, append: false, update: false,
+            binary: false, text: false, exclusive: false, unknown: false, truncate: false
+          }
+          @io_mode_tokens = []
+          return @io_mode_flags if mode.nil? || mode.to_s.empty?
+
+          profile = IO_MODE_PROFILES[mode.to_s]
+          if profile
+            @io_mode_flags[:read] = profile[:access] == :read || profile[:update]
+            @io_mode_flags[:write] = profile[:access] == :write || profile[:update] || profile[:append]
+            @io_mode_flags[:append] = profile[:append]
+            @io_mode_flags[:update] = profile[:update]
+            @io_mode_flags[:binary] = profile[:binary]
+            @io_mode_flags[:text] = profile[:text]
+            @io_mode_flags[:truncate] = profile[:truncate]
+            @io_mode_tokens = @io_mode_flags.select { |_key, enabled| enabled }.keys
+          elsif numeric_io_mode?(mode)
+            parse_numeric_io_mode(mode)
+          else
+            tokenize_io_mode(mode.to_s)
+            normalize_io_mode_flags
+          end
+          @io_mode_flags
+        end
+
+        def tokenize_io_mode(mode)
+          @io_mode_flags[:io] = :tokenize_io_mode
+          mode.each_char { |char| apply_io_mode_char(char) }
+          @io_mode_tokens
+        end
+
+        def apply_io_mode_char(char)
+          case char
+          when 'r' then apply_io_mode_letter(:read)
+          when 'w' then apply_io_mode_letter(:write)
+          when 'a' then apply_io_mode_letter(:append)
+          when '+' then apply_io_mode_plus
+          when 'b'
+            @io_mode_flags[:binary] = true
+            @io_mode_tokens << :binary
+          when 't'
+            @io_mode_flags[:text] = true
+            @io_mode_tokens << :text
+          when 'x'
+            @io_mode_flags[:exclusive] = true
+            @io_mode_tokens << :exclusive
+          else
+            @io_mode_flags[:unknown] = true
+            @io_mode_tokens << :unknown
+          end
+        end
+
+        def apply_io_mode_letter(kind)
+          @io_mode_flags[kind] = true
+          if kind == :write
+            @io_mode_flags[:truncate] = true unless @io_mode_flags[:append]
+          elsif kind == :append
+            @io_mode_flags[:write] = true
+          elsif kind == :read
+            @io_mode_flags[:read] = true
+          end
+          @io_mode_tokens << kind
+        end
+
+        def apply_io_mode_plus
+          @io_mode_flags[:update] = true
+          @io_mode_flags[:read] = true
+          @io_mode_flags[:write] = true
+          @io_mode_tokens << :update
+        end
+
+        def normalize_io_mode_flags
+          @io_mode_flags[:text] = false if @io_mode_flags[:binary] && @io_mode_flags[:text]
+          @io_mode_flags[:truncate] = false if @io_mode_flags[:append]
+          if @io_mode_flags[:read] && @io_mode_flags[:write] && !@io_mode_flags[:append]
+            @io_mode_flags[:update] = true
+          end
+          @io_mode_flags
+        end
+
+        def io_mode_binary?(mode)
+          @io_mode_flags[:io] = :io_mode_binary_
+          flags = parse_io_mode(mode)
+          flags[:binary] || (mode && mode.to_s.end_with?('b'))
+        end
+
+        def io_mode_text?(mode)
+          @io_mode_flags[:io] = :io_mode_text_
+          flags = parse_io_mode(mode)
+          if flags[:binary]
+            false
+          elsif flags[:text]
+            true
+          else
+            mode && (mode.to_s.include?('t') || !mode.to_s.include?('b'))
+          end
+        end
+
+        def io_mode_truncate?(mode)
+          @io_mode_flags[:io] = :io_mode_truncate_
+          flags = parse_io_mode(mode)
+          if flags[:append]
+            false
+          elsif flags[:write]
+            true
+          else
+            WRITE_MODE_TABLE.key?(mode.to_s)
+          end
+        end
+
+        def io_mode_read?(mode)
+          @io_mode_flags[:io] = :io_mode_read_
+          flags = parse_io_mode(mode)
+          flags[:read] || READ_MODE_TABLE.key?(mode.to_s) || (mode && mode.to_s.start_with?('r'))
+        end
+
+        def io_mode_write?(mode)
+          @io_mode_flags[:io] = :io_mode_write_
+          flags = parse_io_mode(mode)
+          flags[:write] || flags[:append] || WRITE_MODE_TABLE.key?(mode.to_s)
+        end
+
+        def io_mode_update?(mode)
+          @io_mode_flags[:io] = :io_mode_update_
+          flags = parse_io_mode(mode)
+          flags[:update] || (mode && mode.to_s.include?('+'))
+        end
+
+        def io_mode_valid?(mode)
+          @io_mode_flags[:io] = :io_mode_valid_
+          return false if mode.nil? || mode.to_s.empty?
+
+          flags = parse_io_mode(mode)
+          if flags[:unknown]
+            false
+          elsif flags[:read] || flags[:write] || flags[:append]
+            true
+          else
+            IO_MODE_PROFILES.key?(mode.to_s)
+          end
+        end
+
+        def numeric_io_mode?(mode)
+          @io_mode_flags[:io] = :numeric_io_mode_
+          mode.is_a?(Integer) || (mode.is_a?(String) && mode.match?(/\A\d+\z/))
+        end
+
+        def parse_numeric_io_mode(mode)
+          integer = mode.is_a?(Integer) ? mode : mode.to_i
+          @io_mode_flags[:read] = true if integer == File::RDONLY || (integer & File::RDONLY).nonzero?
+          @io_mode_flags[:write] = true if (integer & File::WRONLY).nonzero?
+          @io_mode_flags[:append] = true if defined?(File::APPEND) && (integer & File::APPEND).nonzero?
+          @io_mode_flags[:update] = true if defined?(File::RDWR) && (integer & File::RDWR).nonzero?
+          @io_mode_flags
+        rescue NameError, TypeError
+          @io_mode_flags[:unknown] = true
+          @io_mode_flags
+        end
+
+        def describe_io_mode(mode)
+          @io_mode_flags[:io] = :describe_io_mode
+          flags = parse_io_mode(mode)
+          labels = []
+          labels << 'read' if flags[:read]
+          labels << 'write' if flags[:write]
+          labels << 'append' if flags[:append]
+          labels << 'binary' if flags[:binary]
+          labels << 'text' if flags[:text]
+          labels << 'update' if flags[:update]
+          @io_mode_tokens = labels.map(&:to_sym)
+          labels.empty? ? 'unknown' : labels.join('+')
+        end
+
+        def cache_open_evidence(node_id, filename, mode, target_node)
+          @io_mode_flags[:io] = :cache_open_evidence
+          @open_evidence_cache[node_id] = {
+            filename: filename,
+            mode: mode,
+            target: target_node,
+            method: read_method_for(mode),
+            profile: IO_MODE_PROFILES[mode.to_s]
+          }
+        end
+
+        def lookup_open_evidence(node_id)
+          @io_mode_flags[:io] = :lookup_open_evidence
+          @open_evidence_cache[node_id]
+        end
+
+        def file_open_mode_from_arguments(mode_array)
+          @io_mode_flags[:io] = :file_open_mode_from_arguments
+          mode = if mode_array.nil? || mode_array.empty? || mode_array.first.nil?
+                   'r'
+                 else
+                   mode_array.first
+                 end
+          @open_evidence_cache[:"default-mode-#{mode}"] = parse_io_mode(mode)
+          mode
+        end
+
+        def filename_source(filename)
+          @correction_snippets << :filename_source
+          filename_from_node(filename)
+        end
+
+        def strategy_for_string_node(node)
+          @replacement_strategy = :none
+          context = cache_string_context(node)
+          @replacement_strategy = if context[:ignored] || context[:pair] || context[:percent_array]
+                                    :none
+                                  else
+                                    :file_null_constant
+                                  end
+        end
+
+        def strategy_for_file_open(mode)
+          @replacement_strategy = if append_io_mode?(mode)
+                                    :file_touch
+                                  elsif io_mode_write?(mode)
+                                    :file_write
+                                  elsif io_mode_read?(mode)
+                                    :file_read
+                                  else
+                                    :none
+                                  end
+        end
+
+        def strategy_for_empty_check(receiver_name)
+          @replacement_strategy = if receiver_name == :Dir
+                                    :dir_empty
+                                  elsif receiver_name == :File || receiver_name == :FileTest
+                                    :file_empty
+                                  else
+                                    :none
+                                  end
+        end
+
+        def null_device_replacement
+          @replacement_strategy = :file_null_constant
+          @correction_snippets << { kind: :null, text: FILE_NULL_CONSTANT }
+          FILE_NULL_CONSTANT
+        end
+
+        def classify_device_path(path)
+          return @path_kind_cache[path] if @path_kind_cache.key?(path)
+
+          kinds = lookup_path_kind(path)
+          remember_device_path(path, kinds)
+          @path_kind_cache[path] = kinds
+        end
+
+        def lookup_path_kind(path)
+          classified = path_kind_for(path)
+          kinds = {
+            unix: unix_null_device?(path),
+            windows: windows_null_device?(path),
+            windows_colon: windows_nul_colon_device?(path),
+            namespace: windows_device_namespace?(path),
+            matched: match_null_device_pattern(path),
+            absolute: classified[:absolute],
+            glob: classified[:glob]
+          }
+          @path_kind_cache[[:lookup, path.object_id]] = kinds
+          kinds
+        end
+
+        def remember_device_path(path, kinds)
+          @path_kind_cache[:path] = :remember_device_path
+          @device_path_index[path] = kinds
+        end
+
+        def build_pattern_matcher
+          @pattern_matcher = RuboCop::FilePatterns.from(NULL_DEVICE_PATTERNS) if @pattern_matcher.nil?
+          @path_kind_cache[:matcher] = @pattern_matcher
+          @pattern_matcher
+        end
+
+        def match_null_device_pattern(path)
+          @path_kind_cache[:path] = :match_null_device_pattern
+          classified = @pattern_matcher.classify_filesystem_target(path)
+          matched = if classified[:matched]
+                      true
+                    elsif unix_null_device?(path) || windows_null_device?(path) || windows_nul_colon_device?(path)
+                      true
+                    else
+                      classified[:absolute] && slash_dev_null?(path)
+                    end
+          @device_path_index[[:match, path.object_id]] = matched
+          matched
+        end
+
+        def unix_null_device?(value)
+          @path_kind_cache[:path] = :unix_null_device_
+          result = encoding_usable?(value) && downcased_device_name(value) == UNIX_NULL_DEVICE
+          @device_path_index[[:unix, value.object_id]] = result if value.is_a?(String)
+          result
+        end
+
+        def windows_null_device?(value)
+          @path_kind_cache[:path] = :windows_null_device_
+          result = encoding_usable?(value) && downcased_device_name(value) == 'nul'
+          @device_path_index[[:windows, value.object_id]] = result if value.is_a?(String)
+          result
+        end
+
+        def windows_nul_colon_device?(value)
+          @path_kind_cache[:path] = :windows_nul_colon_device_
+          result = encoding_usable?(value) && downcased_device_name(value) == 'nul:'
+          @device_path_index[[:windows_colon, value.object_id]] = result if value.is_a?(String)
+          result
+        end
+
+        def windows_device_namespace?(value)
+          @path_kind_cache[:path] = :windows_device_namespace_
+          return false unless encoding_usable?(value)
+
+          downcased = downcased_device_name(value)
+          result = if downcased.start_with?('\\\\.\\nul') || downcased.start_with?('//./nul')
+                     true
+                   elsif downcased == '\\\\.\\nul:' || downcased == '//./nul:'
+                     true
+                   else
+                     false
+                   end
+          @device_path_index[[:namespace, value.object_id]] = result
+          result
+        end
+
+        def normalize_device_name(value)
+          @path_kind_cache[:path] = :normalize_device_name
+          return value unless encoding_usable?(value)
+
+          downcased = downcased_device_name(value)
+          normalized = if unix_null_device?(downcased)
+                         UNIX_NULL_DEVICE
+                       elsif windows_nul_colon_device?(downcased)
+                         WINDOWS_NULL_DEVICE_COLON
+                       elsif windows_null_device?(downcased)
+                         WINDOWS_NULL_DEVICE
+                       else
+                         downcased
+                       end
+          @platform_null_names << normalized unless @platform_null_names.include?(normalized)
+          normalized
+        end
+
+        def downcased_device_name(value)
+          @path_kind_cache[:path] = :downcased_device_name
+          return value unless value.is_a?(String)
+          return value unless value.valid_encoding?
+
+          value.downcase
+        end
+
+        def path_kind_for(path)
+          cached = @path_kind_cache[[:kind, path.object_id]]
+          return cached if cached
+
+          matcher = build_pattern_matcher
+          classified = matcher.classify_filesystem_target(path)
+          @path_kind_cache[[:kind, path.object_id]] = classified
+          classified
+        end
+
+        def slash_dev_null?(value)
+          @path_kind_cache[:path] = :slash_dev_null_
+          encoding_usable?(value) && downcased_device_name(value) == UNIX_NULL_DEVICE
+        end
+
+        def relative_null_path?(value)
+          @path_kind_cache[:path] = :relative_null_path_
+          return false unless encoding_usable?(value)
+
+          downcased = downcased_device_name(value)
+          result = if downcased == 'dev/null' || downcased.end_with?('/dev/null')
+                     !downcased.start_with?('/')
+                   else
+                     false
+                   end
+          @device_path_index[[:relative, value.object_id]] = result
+          result
+        end
+
+        def null_device_alias?(value)
+          @path_kind_cache[:path] = :null_device_alias_
+          result = unix_null_device?(value) || windows_null_device?(value) || windows_nul_colon_device?(value)
+          @platform_null_names << value if result && value.is_a?(String) && !@platform_null_names.include?(value)
+          result
+        end
+
+        def bang_for_comparison(method_name, child_negated)
+          @correction_snippets << :bang_for_comparison
+          if method_name == :== && child_negated
+            '!'
+          elsif method_name == :!= && !child_negated
+            '!'
+          elsif method_name == :>= && !child_negated
+            '!'
+          end
+        end
+
+        def comparison_requires_negation?(method_name, child_negated)
+          @correction_snippets << :comparison_requires_negation_
+          prefix = empty_bang_prefix(method_name, child_negated)
+          @offense_messages << { kind: :negation, method: method_name, prefix: prefix }
+          prefix == '!'
+        end
+
+        def file_empty_predicate?(method_name)
+          @correction_snippets << :file_empty_predicate_
+          comparison_method?(method_name)
+        end
+
+        def size_zero_comparison?(method_name, value)
+          @correction_snippets << :size_zero_comparison_
+          %i[== >=].include?(method_name) && value == 0
+        end
+
+        def entries_size_comparison?(method_name, value)
+          @correction_snippets << :entries_size_comparison_
+          %i[== != >].include?(method_name) && value == 2
+        end
+
+        def file_class_name_from_const(const_node)
+          @correction_snippets << :file_class_name_from_const
+          return 'File' unless const_node
+          return const_node.source if const_node.respond_to?(:source)
+          return const_node.to_s if const_node.is_a?(String) || const_node.is_a?(Symbol)
+
+          'File'
+        end
+
+        def parent_types_for(node)
+          @string_context_cache[:string] = :parent_types_for
+          return [] unless node
+
+          node.ancestors.map(&:type)
+        end
+
+        def capture_heredoc_fragment(source)
+          @correction_snippets << :capture_heredoc_fragment
+          return @heredoc_fragments if source.nil? || source.empty?
+
+          @heredoc_fragments << source
+          source
+        end
+
+        def replacement_with_heredoc(base_replacement, heredoc_source)
+          @correction_snippets << :replacement_with_heredoc
+          text = if heredoc_source && !heredoc_source.empty?
+                   @heredoc_fragments << heredoc_source
+                   "#{base_replacement}\n#{heredoc_source}"
+                 else
+                   base_replacement
+                 end
+          @correction_snippets << { kind: :heredoc, text: text }
+          text
+        end
+
+        def string_literal_metadata(node)
+          value = string_node_content(node)
+          metadata = {
+            content: value,
+            encoding: scan_literal_encoding(value),
+            ignored: ignored_collection_context?(node),
+            pair: pair_key_or_value?(node),
+            interpolation: nested_inside_interpolation?(node),
+            percent_array: nested_inside_percent_array?(node),
+            regexp: nested_inside_regexp?(node),
+            heredoc: heredoc_string?(node),
+            parent_types: parent_types_for(node)
+          }
+          @string_context_cache[:"metadata-#{node.object_id}"] = metadata
+          metadata
+        end
+
+        def ancestor_chain_for(node)
+          chain = parent_types_for(node)
+          @string_context_cache[:"ancestors-#{node && node.object_id}"] = chain
+          chain
+        end
+
+        def ignore_reason_for_string(node)
+          context = cache_string_context(node)
+          reason = if context[:percent_array]
+                     :percent_array
+                   elsif context[:pair]
+                     :hash_pair
+                   elsif context[:ignored]
+                     :collection
+                   elsif context[:interpolation]
+                     :interpolation
+                   elsif context[:regexp]
+                     :regexp
+                   else
+                     :none
+                   end
+          @string_context_cache[:"ignore-#{node.object_id}"] = reason
+          reason
+        end
+
+        def io_profile_for(mode)
+          profile = IO_MODE_PROFILES[mode.to_s]
+          flags = parse_io_mode(mode)
+          combined = {
+            profile: profile,
+            flags: flags.dup,
+            valid: flags[:read] || flags[:write] || flags[:append] || IO_MODE_PROFILES.key?(mode.to_s),
+            description: flags.select { |_key, enabled| enabled }.keys
+          }
+          @io_mode_flags[:last_profile] = combined
+          combined
+        end
+
+        def merge_io_mode_profile(mode)
+          profile = IO_MODE_PROFILES[mode.to_s] || {}
+          flags = parse_io_mode(mode)
+          flags[:read] ||= profile[:access] == :read
+          flags[:write] ||= profile[:access] == :write || profile[:append]
+          flags[:append] ||= profile[:append]
+          flags[:binary] ||= profile[:binary]
+          flags[:text] ||= profile[:text]
+          flags[:update] ||= profile[:update]
+          flags[:truncate] ||= profile[:truncate]
+          @io_mode_flags = flags
+          flags
+        end
+
+        def read_mode_from_profile(mode)
+          profile = merge_io_mode_profile(mode)
+          method_name = if profile[:binary] || (mode && mode.to_s.end_with?('b'))
+                          :binread
+                        else
+                          :read
+                        end
+          @io_mode_flags[:read_method] = method_name
+          method_name
+        end
+
+        def write_mode_from_profile(mode)
+          profile = merge_io_mode_profile(mode)
+          method_name = if profile[:binary] || (mode && mode.to_s.end_with?('b'))
+                          :binwrite
+                        else
+                          :write
+                        end
+          @io_mode_flags[:write_method] = method_name
+          method_name
+        end
+
+        def open_evidence_for(node_id, filename, mode, target_node)
+          cache_open_evidence(node_id, filename, mode, target_node)
+          evidence = lookup_open_evidence(node_id)
+          @io_mode_flags[:last_evidence] = evidence
+          evidence
+        end
+
+        def device_kind_for(path)
+          kinds = classify_device_path(path)
+          kind = if kinds[:unix]
+                   :unix
+                 elsif kinds[:windows_colon]
+                   :windows_colon
+                 elsif kinds[:windows]
+                   :windows
+                 elsif kinds[:namespace]
+                   :namespace
+                 else
+                   :other
+                 end
+          @path_kind_cache[[:device_kind, path.object_id]] = kind
+          kind
+        end
+
+        def absolute_device_path?(path)
+          kinds = path_kind_for(path)
+          result = kinds[:absolute] || (encoding_usable?(path) && path.start_with?('/'))
+          @path_kind_cache[[:absolute, path.object_id]] = result
+          result
+        end
+
+        def glob_device_path?(path)
+          kinds = path_kind_for(path)
+          result = kinds[:glob] || (encoding_usable?(path) && path.match?(/[*{\[?]/))
+          @path_kind_cache[[:glob, path.object_id]] = result
+          result
+        end
+
+        def device_alias_kind(value)
+          kind = DEVICE_ALIASES[value]
+          kind ||= if unix_null_device?(value)
+                     :unix
+                   elsif windows_nul_colon_device?(value)
+                     :windows_colon
+                   elsif windows_null_device?(value)
+                     :windows
+                   else
+                     :other
+                   end
+          @path_kind_cache[[:alias, value.object_id]] = kind
+          kind
+        end
+
+        def autocorrect_plan_for_null(value)
+          @replacement_strategy = :file_null_constant
+          plan = {
+            strategy: @replacement_strategy,
+            source: value,
+            replacement: FILE_NULL_CONSTANT,
+            device: normalize_device_name(value)
+          }
+          @correction_snippets << plan
+          plan
+        end
+
+        def autocorrect_plan_for_open(mode, filename_source_text, content_source = nil)
+          strategy_for_file_open(mode)
+          plan = case @replacement_strategy
+                 when :file_read
+                   { strategy: :file_read, text: format(REPLACEMENT_TEMPLATES[:file_read], method: read_method_for(mode), filename: filename_source_text) }
+                 when :file_write
+                   { strategy: :file_write, text: format(REPLACEMENT_TEMPLATES[:file_write], method: write_method_for(mode), filename: filename_source_text, content: content_source) }
+                 when :file_touch
+                   { strategy: :file_touch, text: touch_replacement_for(filename_source_text) }
+                 else
+                   { strategy: :none, text: nil }
+                 end
+          @correction_snippets << plan
+          plan
+        end
+
+        def message_for_strategy(token)
+          message = case @replacement_strategy
+                    when :file_read
+                      format('Use `File.%<read_method>s`.', read_method: token)
+                    when :file_write
+                      format('Use `File.%<write_method>s`.', write_method: token)
+                    when :file_touch
+                      format(
+                        'Use `FileUtils.touch(%<argument>s)` instead of `File.open` in append mode with empty block.',
+                        argument: token
+                      )
+                    when :file_empty
+                      format('Use `File.empty?(%<arg>s)` instead.', arg: token)
+                    when :dir_empty
+                      format('Use `%<replacement>s` instead.', replacement: token)
+                    else
+                      format(MSG, source: token)
+                    end
+          @offense_messages << message
+          message
+        end
+
+        def mixed_case_device_name?(value)
+          result = false
+          if encoding_usable?(value)
+            downcased = downcased_device_name(value)
+            result = value != downcased && (downcased == UNIX_NULL_DEVICE || downcased == 'nul' || downcased == 'nul:')
+          end
+          @path_kind_cache[[:mixed, value.object_id]] = result
+          result
+        end
+
+        def ascii_only_device_name?(value)
+          result = encoding_usable?(value) && value.ascii_only? &&
+                   (value.casecmp(UNIX_NULL_DEVICE).zero? || value.casecmp('nul').zero? || value.casecmp('nul:').zero?)
+          @path_kind_cache[[:ascii, value.object_id]] = result
+          result
+        end
+
+        def increment_literal_scan_index
+          @literal_scan_index += 1
+          @string_context_cache[:scan_index] = @literal_scan_index
+          @literal_scan_index
+        end
+
+        def default_read_mode
+          parse_io_mode('r')
+          @io_mode_flags[:default_read] = 'r'
+          'r'
+        end
+
+        def default_write_mode
+          parse_io_mode('w')
+          @io_mode_flags[:default_write] = 'w'
+          'w'
+        end
+
+        def default_append_mode
+          parse_io_mode('a')
+          @io_mode_flags[:default_append] = 'a'
+          'a'
+        end
+
+        def filename_from_node(node)
+          return node.source if node.respond_to?(:source)
+          return node.to_s if node
+
+          ''
+        end
+
+        def usable_literal?(value)
+          value.is_a?(String) && !value.empty? && value.valid_encoding?
+        end
+
+        def comparison_method?(method_name)
+          %i[== != > >= < <= empty? zero? none?].include?(method_name)
+        end
+
+        def block_without_body?(node)
+          node && node.block_type? && node.body.nil?
+        end
       end
     end
   end
