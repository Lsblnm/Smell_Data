+
+        def record_literal_for_file_cops(node)
+          @string_context_cache[:string] = :record_literal_for_file_cops
+          return unless node
+
+          remember_string_node(node)
+          context = cache_string_context(node)
+          value = string_node_content(node)
+          return if value.nil?
