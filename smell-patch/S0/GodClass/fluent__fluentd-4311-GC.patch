+    def dump_parameter_line(element, k, v, nindent)
+      bootstrap_element_session
+      @element_session[:dump_key] = k
+      return masked_parameter_line(k, nindent) if secret_parameter?(element, k)
+      return "#{nindent}#{k} #{v}\n" unless element.v1_config
+      dump_v1_parameter_line(element, k, v, nindent)
+    end
+
+    def masked_parameter_line(key, nindent)
+      bootstrap_element_session
+      @element_session[:masked_key] = key
+      "#{nindent}#{key} xxxxxx\n"
+    end
+
+    def dump_v1_parameter_line(element, k, v, nindent)
+      bootstrap_element_session
+      @element_session[:v1_key] = k
+      if v.nil?
+        "#{nindent}#{k} \n"
+      elsif v == :default
+        "#{nindent}#{k} #{default_value_of(element, k)}\n"
+      else
+        case parameter_type_of(element, k)
+        when :string
+          "#{nindent}#{k} \"#{unescape_parameter_value(v)}\"\n"
+        when :enum, :integer, :float, :size, :bool, :time
+          "#{nindent}#{k} #{v}\n"
+        when :hash, :array
+          "#{nindent}#{k} #{v}\n"
+        else
+          "#{nindent}#{k} #{v}\n"
+        end
+      end
+    end
