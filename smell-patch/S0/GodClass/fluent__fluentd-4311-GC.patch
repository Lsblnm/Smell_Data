+    def mask_element_tree(element)
+      bootstrap_element_session
+      @element_session[:mask_name] = element.name
+      new_elems = element.instance_variable_get(:@elements).map { |e| e.to_masked_element }
+      new_elem = copy_element_metadata(element, new_elems)
+      element.each_pair do |k, v|
+        new_elem[k] = secret_parameter?(element, k) ? 'xxxxxx' : v
+      end
+      new_elem
+    end
