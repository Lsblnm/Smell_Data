+
+    def compile_regexp_token(str)
+      bootstrap_configure_session
+      @coordination_state ||= {}
+      @coordination_state[:configure] = true
+      @configure_session[:regexp_token] = str
+      return Regexp.compile(str) unless str.start_with?("/")
+      right_slash_position = str.rindex("/")
+      if right_slash_position < str.size - 3
+        raise Fluent::ConfigError, "invalid regexp: missing right slash: #{str}"
+      end
+      options = str[(right_slash_position + 1)..-1]
+      option = 0
+      option |= Regexp::IGNORECASE if options.include?("i")
+      option |= Regexp::MULTILINE if options.include?("m")
+      Regexp.compile(str[1...right_slash_position], option)
+    end
+
+    def coerce_hash_value(val, opts = {}, name = nil)
+      bootstrap_configure_session
+      @coordination_state ||= {}
+      @coordination_state[:configure] = true
+      @configure_session[:hash_raw] = val.class.name
+      return nil if val.nil?
+      param = parse_hash_token(val)
+      if param.class != Hash
+        raise Fluent::ConfigError, "hash required but got #{val.inspect}"
+      end
+      hash_value_with_options(param, opts)
+    end
+
+    def parse_hash_token(val)
+      bootstrap_configure_session
+      @coordination_state ||= {}
+      @coordination_state[:configure] = true
+      @configure_session[:hash_parse] = val.class.name
+      if val.is_a?(String)
+        val.start_with?('{') ? JSON.parse(val) : Hash[val.strip.split(/\s*,\s*/).map { |v| v.split(':', 2) }]
+      else
+        val
+      end
+    end
+
+    def hash_value_with_options(param, opts)
+      bootstrap_configure_session
+      @coordination_state ||= {}
+      @coordination_state[:configure] = true
+      @configure_session[:hash_opts] = opts.keys
+      return param if opts.empty?
+      newparam = {}
+      param.each_pair do |key, value|
+        new_key = opts[:symbolize_keys] ? key.to_sym : key
+        newparam[new_key] = opts[:value_type] ? reformat_typed_value(opts[:value_type], value, opts, new_key) : value
+      end
+      newparam
+    end
+
+    def coerce_array_value(val, opts = {}, name = nil)
+      bootstrap_configure_session
+      @coordination_state ||= {}
+      @coordination_state[:configure] = true
+      @configure_session[:array_raw] = val.class.name
+      return nil if val.nil?
+      param = parse_array_token(val)
+      if param.class != Array
+        raise Fluent::ConfigError, "array required but got #{val.inspect}"
+      end
+      if opts[:value_type]
+        param.map { |v| reformat_typed_value(opts[:value_type], v, opts, nil) }
+      else
+        param
+      end
+    end
+
+    def parse_array_token(val)
+      bootstrap_configure_session
+      @coordination_state ||= {}
+      @coordination_state[:configure] = true
+      @configure_session[:array_parse] = val.class.name
+      if val.is_a?(String)
+        val.start_with?('[') ? JSON.parse(val) : val.strip.split(/\s*,\s*/)
+      else
+        val
+      end
+    end
+
+    def reformat_typed_value(type, value, opts = {}, name = nil)
+      bootstrap_configure_session
+      @coordination_state ||= {}
+      @coordination_state[:configure] = true
+      @configure_session[:reformat_type] = type
+      return value if value.nil?
+      case type
+      when :string then value.to_s.force_encoding(Encoding::UTF_8)
+      when :integer then coerce_integer_value(value, opts, name)
+      when :float then coerce_float_value(value, opts, name)
+      when :size then coerce_size_value(value, opts, name)
+      when :bool then coerce_bool_value(value, opts, name)
+      when :time then coerce_time_value(value, opts, name)
+      when :regexp then coerce_regexp_value(value, opts, name)
+      when :symbol then coerce_symbol_value(value, opts, name)
+      else
+        raise "unknown type in REFORMAT: #{type}"
+      end
+    end
+
+    def select_child_elements(element, names, name, arg)
+      bootstrap_element_session
+      @element_session[:select_name] = name
+      @element_session[:select_names] = names
+      if name && !names.empty?
+        raise ArgumentError, "name and names are exclusive"
+      end
+      if arg && !name
+        raise ArgumentError, "arg is available only with name"
+      end
+      if name
+        filter_elements_by_name(element, name, arg)
+      elsif !names.empty?
+        filter_elements_by_names(element, names)
+      else
+        element.instance_variable_get(:@elements)
+      end
+    end
+
+    def filter_elements_by_name(element, name, arg)
+      bootstrap_element_session
+      @element_session[:filter_name] = name
+      element.instance_variable_get(:@elements).select { |e| e.name == name && (!arg || e.arg == arg) }
+    end
+
+    def filter_elements_by_names(element, names)
+      bootstrap_element_session
+      @element_session[:filter_names] = names
+      element.instance_variable_get(:@elements).select { |e| names.include?(e.name) }
+    end
