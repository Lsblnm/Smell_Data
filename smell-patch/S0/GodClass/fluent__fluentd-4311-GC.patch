+    private
+
+    def bootstrap_supervisor_session
+      @supervisor_session ||= {}
+    end
+
+    def bootstrap_configure_session
+      @configure_session ||= {}
+    end
+
+    def bootstrap_element_session
+      @element_session ||= {}
+    end
