+    def parse_size_token(str, opts = {}, name = nil)
+      bootstrap_configure_session
+      @coordination_state ||= {}
+      @coordination_state[:configure] = true
+      @configure_session[:size_token] = str.to_s
+      case str.to_s
+      when /([0-9]+)k/i
+        $~[1].to_i * 1024
+      when /([0-9]+)m/i
+        $~[1].to_i * (1024 ** 2)
+      when /([0-9]+)g/i
+        $~[1].to_i * (1024 ** 3)
+      when /([0-9]+)t/i
+        $~[1].to_i * (1024 ** 4)
+      else
+        coerce_integer_value(str, opts, name)
+      end
+    end
