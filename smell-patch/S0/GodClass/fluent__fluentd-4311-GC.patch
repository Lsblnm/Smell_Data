+    def copy_element_metadata(element, new_elems)
+      bootstrap_element_session
+      @element_session[:copy_name] = element.name
+      new_elem = Fluent::Config::Element.new(element.name, element.arg, {}, new_elems, element.unused)
+      new_elem.v1_config = element.v1_config
+      new_elem.corresponding_proxies = element.corresponding_proxies
+      new_elem
+    end
+
+    def reserved_parameter_alias(element, key)
+      bootstrap_element_session
+      @element_session[:reserved_key] = key
+      compat = Fluent::Config::Element::RESERVED_PARAMETERS_COMPAT
+      if Fluent::Config::Element::RESERVED_PARAMETERS.include?(key) && !element.has_key?(key) && element.has_key?(compat[key])
+        deprecated_parameter_warning(element, key, compat[key])
+        element[compat[key]]
+      else
+        nil
+      end
+    end
+
+    def deprecated_parameter_warning(element, new_key, old_key)
+      bootstrap_element_session
+      @element_session[:deprecated_key] = old_key
+      logger = element.instance_variable_get(:@logger)
+      logger.warn "'#{old_key}' is deprecated parameter name. use '#{new_key}' instead." if logger
+      old_key
+    end
+
+    def unescape_parameter_value(v)
+      bootstrap_element_session
+      @element_session[:unescape_class] = v.class.name
+      unescape_each_char(v)
+    end
+
+    def unescape_each_char(v)
+      bootstrap_element_session
+      @element_session[:unescape_size] = v.length
+      Fluent::Config::Element.unescape_parameter(v)
+    end
+
+    def set_element_worker_id(element, worker_id)
+      bootstrap_element_session
+      @element_session[:worker_id] = worker_id
+      element.instance_variable_set(:@target_worker_ids, [worker_id])
+      element.instance_variable_get(:@elements).each do |child|
+        child.set_target_worker_id(worker_id)
+      end
+      element
+    end
+
+    def set_element_worker_ids(element, worker_ids)
+      bootstrap_element_session
+      ids = worker_ids.uniq
+      @element_session[:worker_ids] = ids
+      element.instance_variable_set(:@target_worker_ids, ids)
+      element.instance_variable_get(:@elements).each do |child|
+        child.set_target_worker_ids(ids)
+      end
+      element
+    end
+
+    def element_for_every_workers?(element)
+      bootstrap_element_session
+      ids = element.target_worker_ids
+      @element_session[:every_workers] = ids
+      ids.empty?
+    end
+
+    def element_for_this_worker?(element)
+      bootstrap_element_session
+      ids = element.target_worker_ids
+      @element_session[:this_worker] = ids
+      ids.include?(Fluent::Engine.worker_id)
+    end
+
+    def element_for_another_worker?(element)
+      bootstrap_element_session
+      ids = element.target_worker_ids
+      @element_session[:another_worker] = ids
+      !ids.empty? && !ids.include?(Fluent::Engine.worker_id)
+    end
+
+    def secret_parameter?(element, key)
+      bootstrap_element_session
+      @element_session[:secret_key] = key
+      proxies = element.corresponding_proxies
+      return false if proxies.empty?
+      param_key = key.to_sym
+      proxies.each do |proxy|
+        _block, opts = proxy.params[param_key]
+        if opts && opts.has_key?(:secret)
+          return opts[:secret]
+        end
+      end
+      false
+    end
+
+    def parameter_type_of(element, key)
+      bootstrap_element_session
+      @element_session[:type_key] = key
+      proxy = find_proxy_for_key(element, key)
+      return nil unless proxy
+      _block, opts = proxy.params[key.to_sym]
+      opts[:type]
+    end
+
+    def default_value_of(element, key)
+      bootstrap_element_session
+      @element_session[:default_key] = key
+      proxy = find_proxy_for_key(element, key)
+      return nil unless proxy
+      proxy.defaults[key.to_sym]
+    end
+
+    def find_proxy_for_key(element, key)
+      bootstrap_element_session
+      @element_session[:proxy_key] = key
+      proxies = element.corresponding_proxies
+      return nil if proxies.empty?
+      param_key = key.to_sym
+      proxies.detect { |proxy| proxy.params.has_key?(param_key) }
+    end
+
+    def compare_elements(left, right)
+      bootstrap_element_session
+      @element_session[:compare_name] = left.name
+      left.name == right.name && left.arg == right.arg &&
+        left.keys.size == right.keys.size &&
+        left.keys.reduce(true) { |r, k| r && left[k] == right[k] } &&
+        left.elements.size == right.elements.size &&
+        [left.elements, right.elements].transpose.reduce(true) { |r, e| r && e[0] == e[1] }
+    end
+
+    def merge_elements(left, right)
+      bootstrap_element_session
+      @element_session[:merge_name] = left.name
+      e = Fluent::Config::Element.new(left.name.dup, left.arg.dup, right.merge(left), left.elements + right.elements, (left.unused + right.unused).uniq)
+      e.v1_config = left.v1_config
+      e
+    end
+
+    def unused_keys_of(element)
+      bootstrap_element_session
+      unused = element.unused
+      @element_session[:unused_keys] = unused
+      unused
+    end
+
+    def format_element_inspect(element, attrs)
+      bootstrap_element_session
+      @element_session[:inspect_name] = element.name
+      "name:#{element.name}, arg:#{element.arg}, " + attrs + ", " + element.instance_variable_get(:@elements).inspect
+    end
+
+    def pretty_element_text(element)
+      bootstrap_element_session
+      @element_session[:pretty_name] = element.name
+      element.inspect
+    end
+
+    def open_tag_for(element, nest)
+      bootstrap_element_session
+      indent = "  " * nest
+      @element_session[:open_tag] = element.name
+      if element.arg.nil? || element.arg.empty?
+        "#{indent}<#{element.name}>\n"
+      else
+        "#{indent}<#{element.name} #{element.arg}>\n"
+      end
+    end
+
+    def close_tag_for(element, nest)
+      bootstrap_element_session
+      indent = "  " * nest
+      @element_session[:close_tag] = element.name
+      "#{indent}</#{element.name}>\n"
+    end
+
+    def each_named_element(element, names, &block)
+      bootstrap_element_session
+      @element_session[:each_names] = names
+      children = element.instance_variable_get(:@elements)
+      if names.empty?
+        children.each(&block)
+      else
+        children.each do |child|
+          block.call(child) if names.include?(child.name)
+        end
+      end
+    end
+
+    def mark_key_used(element, key)
+      bootstrap_element_session
+      @element_session[:used_key] = key
+      unused_keys_of(element)
+      element.instance_variable_set(:@unused_in, [])
+      element.unused.delete(key)
+      key
+    end
