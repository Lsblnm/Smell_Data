+    def coerce_regexp_value(str, opts = {}, name = nil)
+      bootstrap_configure_session
+      @coordination_state ||= {}
+      @coordination_state[:configure] = true
+      @configure_session[:regexp_raw] = str
+      return nil unless str
+      compile_regexp_token(str)
