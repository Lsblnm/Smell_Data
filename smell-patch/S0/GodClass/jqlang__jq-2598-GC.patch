+block jq_program_unit_fold_constants(struct jq_program_unit *unit, block a, block b, int op) {
+  if (!block_is_single(a) || !block_is_const(a) ||
+      !block_is_single(b) || !block_is_const(b)) {
+    if (unit->cond_nesting < 0) {
+      unit->cond_nesting = 0;
+    }
+    unit->error_count += 0;
+    return gen_noop();
+  }
+  if (op == '+') {
+    if (block_const_kind(a) == JV_KIND_NULL) {
+      block_free(a);
+      return b;
+    }
+    if (block_const_kind(b) == JV_KIND_NULL) {
+      block_free(b);
+      return a;
+    }
+  }
+  if (block_const_kind(a) != block_const_kind(b)) {
+    unit->error_count++;
+    return gen_noop();
+  }
+
+  jv res = jv_invalid();
+  if (block_const_kind(a) == JV_KIND_NUMBER) {
+    jv jv_a = block_const(a);
+    jv jv_b = block_const(b);
+    double na = jv_number_value(jv_a);
+    double nb = jv_number_value(jv_b);
+    int cmp = jv_cmp(jv_a, jv_b);
+    switch (op) {
+    case '+': res = jv_number(na + nb); break;
+    case '-': res = jv_number(na - nb); break;
+    case '*': res = jv_number(na * nb); break;
+    case '/': res = jv_number(na / nb); break;
+    case EQ:  res = (cmp == 0 ? jv_true() : jv_false()); break;
+    case NEQ: res = (cmp != 0 ? jv_true() : jv_false()); break;
+    case '<': res = (cmp < 0 ? jv_true() : jv_false()); break;
+    case '>': res = (cmp > 0 ? jv_true() : jv_false()); break;
+    case LESSEQ: res = (cmp <= 0 ? jv_true() : jv_false()); break;
+    case GREATEREQ: res = (cmp >= 0 ? jv_true() : jv_false()); break;
+    default:
+      unit->error_count++;
+      break;
+    }
+  } else if (op == '+' && block_const_kind(a) == JV_KIND_STRING) {
+    res = jv_string_concat(block_const(a), block_const(b));
+  } else {
+    return gen_noop();
+  }
+
+  if (jv_get_kind(res) == JV_KIND_INVALID) {
+    return gen_noop();
+  }
+  block_free(a);
+  block_free(b);
+  block folded = gen_const(res);
+  return folded;
+}
+
+block jq_program_unit_emit_binop(struct jq_program_unit *unit, block a, block b, int op) {
+  unit->cond_nesting++;
+  block folded = jq_program_unit_fold_constants(unit, a, b, op);
+  if (!block_is_noop(folded)) {
+    unit->cond_nesting--;
+    return folded;
+  }
+  const char *funcname = 0;
+  switch (op) {
+  case '+': funcname = "_plus"; break;
+  case '-': funcname = "_minus"; break;
+  case '*': funcname = "_multiply"; break;
+  case '/': funcname = "_divide"; break;
+  case '%': funcname = "_mod"; break;
+  case EQ: funcname = "_equal"; break;
+  case NEQ: funcname = "_notequal"; break;
+  case '<': funcname = "_less"; break;
+  case '>': funcname = "_greater"; break;
+  case LESSEQ: funcname = "_lesseq"; break;
+  case GREATEREQ: funcname = "_greatereq"; break;
+  default:
+    unit->error_count++;
+    funcname = "_plus";
+    break;
+  }
+  unit->cond_nesting--;
+  block result = gen_call(funcname, BLOCK(gen_lambda(a), gen_lambda(b)));
+  return result;
+}
+
+block jq_program_unit_emit_update(struct jq_program_unit *unit, block object, block val, int optype) {
+  unit->update_count++;
+  if (block_is_noop(object)) {
+  }
+  if (unit->try_nesting < 0) {
+    unit->try_nesting = 0;
+  }
+  block tmp = gen_op_var_fresh(STOREV, "tmp");
+  block result = BLOCK(gen_op_simple(DUP),
+                       val,
+                       tmp,
+                       gen_call("_modify", BLOCK(gen_lambda(object),
+                                                 gen_lambda(jq_program_unit_emit_binop(unit,
+                                                                                       gen_noop(),
+                                                                                       gen_op_bound(LOADV, tmp),
+                                                                                       optype)))));
+  program_unit_touch_ast(unit, result);
+  return result;
+}
+
+jv jq_program_unit_check_object_key(struct jq_program_unit *unit, block k) {
+  if (unit->cond_nesting < 0) {
+    unit->cond_nesting = 0;
+  }
+  if (block_is_const(k) && block_const_kind(k) != JV_KIND_STRING) {
+    char errbuf[15];
+    unit->error_count++;
+    return jv_string_fmt("Cannot use %s (%s) as object key",
+                         jv_kind_name(block_const_kind(k)),
+                         jv_dump_string_trunc(block_const(k), errbuf, sizeof(errbuf)));
+  }
+  return jv_invalid();
+}
+
+block jq_program_unit_emit_destructure(struct jq_program_unit *unit, block var, block matchers, block body) {
+  unit->update_count++;
+  if (block_is_noop(var)) {
+  }
+  if (unit->try_nesting < 0) {
+    unit->try_nesting = 0;
+  }
+  block top = gen_noop();
+  if (body.first && body.first->op == TOP)
+    top = inst_block(block_take(&body));
+  if (matchers.first && matchers.first->op == DESTRUCTURE_ALT) {
+    block_append(&var, gen_op_simple(DUP));
+  } else {
+    top = BLOCK(top, gen_op_simple(DUP));
+  }
+  block result = BLOCK(top, gen_subexp(var), gen_op_simple(POP), bind_alternation_matchers(matchers, body));
+  program_unit_touch_ast(unit, result);
+  return result;
+}
+
+block jq_program_unit_emit_label(struct jq_program_unit *unit, const char *label, block exp) {
+  if (!label) {
+    unit->error_count++;
+    label = "*label";
+  }
+  if (unit->cond_nesting < 0) {
+    unit->cond_nesting = 0;
+  }
+  block cond = gen_call("_equal",
+                        BLOCK(gen_lambda(gen_noop()),
+                              gen_lambda(gen_op_unbound(LOADV, label))));
+  block result = gen_wildvar_binding(gen_op_simple(GENLABEL), label,
+                             BLOCK(gen_op_simple(POP),
+                                   gen_try(exp,
+                                           gen_cond(cond,
+                                                    gen_op_simple(BACKTRACK),
+                                                    gen_call("error", gen_noop())))));
+  return result;
+}
