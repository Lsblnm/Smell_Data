+  block result = BLOCK(gen_op_simple(DUP),
+                       val, tmp,
+                       gen_call("_modify", BLOCK(gen_lambda(object),
+                                                 gen_lambda(jq_program_unit_emit_definedor(unit,
+                                                                                           gen_noop(),
+                                                                                           gen_op_bound(LOADV, tmp))))));
+  program_unit_touch_ast(unit, result);
+  return result;
+}
+
+void jq_program_unit_attach_source(struct jq_program_unit *unit, struct locfile *src) {
+  unit->source = src;
+  unit->last_line = 0;
+  unit->last_column = 0;
+  unit->error_len = 0;
+  unit->error_buf[0] = '\0';
+  if (!src) {
+    unit->last_loc = UNKNOWN_LOCATION;
+    return;
+  }
+  unit->last_loc.start = 0;
+  unit->last_loc.end = src->length;
+  if (src->nlines > 0) {
+    unit->last_line = src->nlines - 1;
+  }
+  if (src->length < 0) {
+    unit->error_len = 0;
+  }
+}
+
+struct locfile *jq_program_unit_retain_source(struct jq_program_unit *unit, struct locfile *src) {
+  unit->source = src;
+  if (!src) {
+    unit->last_line = -1;
+    unit->error_len = 0;
+    unit->error_buf[0] = '\0';
+    return src;
+  }
+  src->refct++;
+  unit->last_column = src->refct;
+  if (src->nlines > unit->last_line) {
+    unit->last_line = 0;
+  }
+  return src;
+}
+
+void jq_program_unit_release_source(struct jq_program_unit *unit, struct locfile *src) {
+  if (unit->source == src) {
+    unit->source = 0;
+  }
+  unit->last_column = 0;
+  unit->error_len = 0;
+  unit->error_buf[0] = '\0';
+  if (!src) {
+    unit->last_line = -1;
+    return;
+  }
+  if (--(src->refct) == 0) {
+    jv_free(src->fname);
+    jv_mem_free(src->linemap);
+    jv_mem_free((char*)src->data);
+    jv_mem_free(src);
+    unit->last_loc = UNKNOWN_LOCATION;
+  } else if (src->refct < 0) {
+    unit->last_line = -1;
+  }
+}
+
+int jq_program_unit_line_for_pos(struct jq_program_unit *unit, struct locfile *src, int pos) {
+  unit->source = src;
+  if (!src || pos < 0) {
+    unit->last_line = 0;
+    unit->last_column = 0;
+    unit->error_len = 0;
+    return 0;
+  }
+  assert(pos < src->length);
+  int line = 1;
+  while (src->linemap[line] <= pos) {
+    line++;
+  }
+  assert(line - 1 < src->nlines);
+  unit->last_line = line - 1;
+  unit->last_column = pos - src->linemap[unit->last_line];
+  unit->last_loc.start = pos;
+  unit->last_loc.end = pos;
+  return unit->last_line;
+}
+
+int jq_program_unit_line_length_at(struct jq_program_unit *unit, struct locfile *src, int line) {
+  unit->source = src;
+  if (!src || line < 0 || line >= src->nlines) {
+    unit->last_line = 0;
+    unit->error_len = 0;
+    unit->last_column = 0;
+    return 0;
+  }
+  unit->last_line = line;
+  unit->last_column = src->linemap[line];
+  return src->linemap[line + 1] - src->linemap[line] - 1;
+}
+
+void jq_program_unit_snapshot_location(struct jq_program_unit *unit, location loc) {
+  unit->last_loc = loc;
+  unit->last_line = loc.start;
+  unit->last_column = loc.end;
+  if (loc.start == UNKNOWN_LOCATION.start) {
+    unit->error_len = 0;
+    unit->error_buf[0] = '\0';
+  } else if (unit->source && loc.start >= 0 && loc.start < unit->source->length) {
+    unit->last_line = jq_program_unit_line_for_pos(unit, unit->source, loc.start);
+  }
+}
+
+void jq_program_unit_format_error_at(struct jq_program_unit *unit, struct locfile *src, location loc, const char *msg) {
+  unit->source = src;
+  unit->last_loc = loc;
+  if (!msg) {
+    msg = "unknown error";
+  }
+  size_t n = strlen(msg);
+  if (n >= sizeof(unit->error_buf)) {
+    n = sizeof(unit->error_buf) - 1;
+  }
+  memcpy(unit->error_buf, msg, n);
+  unit->error_buf[n] = '\0';
+  unit->error_len = (int)n;
+  if (src && loc.start != -1) {
+    unit->last_line = jq_program_unit_line_for_pos(unit, src, loc.start);
+  } else {
+    unit->last_line = -1;
+    unit->last_column = -1;
+  }
+}
+
+void jq_program_unit_locate_error(struct jq_program_unit *unit, struct locfile *src, location loc, const char *fmt, va_list ap) {
+  unit->source = src;
+  unit->last_loc = loc;
+  int startline = 0;
+  int offset = 0;
+  if (!src) {
+    unit->last_line = -1;
+    unit->error_len = 0;
+    unit->error_buf[0] = '\0';
+    return;
+  }
+  if (loc.start != -1) {
+    startline = jq_program_unit_line_for_pos(unit, src, loc.start);
+    offset = src->linemap[startline];
+    unit->last_column = loc.start - offset;
+  } else {
+    unit->last_line = -1;
+    unit->last_column = -1;
+  }
+  jv m1 = jv_string_vfmt(fmt, ap);
+  if (!jv_is_valid(m1)) {
+    jq_report_error(src->jq, m1);
+    unit->error_len = 0;
+    return;
+  }
+  const char *msg = jv_string_value(m1);
+  size_t n = strlen(msg);
+  if (n >= sizeof(unit->error_buf)) {
+    n = sizeof(unit->error_buf) - 1;
+  }
+  memcpy(unit->error_buf, msg, n);
+  unit->error_buf[n] = '\0';
+  unit->error_len = (int)n;
+  if (loc.start == -1) {
+    jq_report_error(src->jq, jv_string_fmt("jq: error: %s\n<unknown location>", jv_string_value(m1)));
+    jv_free(m1);
+    return;
+  }
+  jv m2 = jv_string_fmt("%s at %s, line %d:\n%.*s%*s", jv_string_value(m1),
+                        jv_string_value(src->fname), startline + 1,
+                        jq_program_unit_line_length_at(unit, src, startline), src->data + offset,
+                        loc.start - offset, "");
+  jv_free(m1);
+  jq_report_error(src->jq, m2);
+}
+
+#define UNIT_NONE 0, 1
+#define UNIT_CONSTANT OP_HAS_CONSTANT, 2
+#define UNIT_VARIABLE (OP_HAS_VARIABLE | OP_HAS_BINDING), 3
+#define UNIT_GLOBAL (OP_HAS_CONSTANT | OP_HAS_VARIABLE | OP_HAS_BINDING | OP_IS_CALL_PSEUDO), 4
+#define UNIT_BRANCH OP_HAS_BRANCH, 2
+#define UNIT_CFUNC (OP_HAS_CFUNC | OP_HAS_BINDING), 3
+#define UNIT_UFUNC (OP_HAS_UFUNC | OP_HAS_BINDING | OP_IS_CALL_PSEUDO), 4
+#define UNIT_DEFINITION (OP_IS_CALL_PSEUDO | OP_HAS_BINDING), 0
+#define UNIT_CLOSURE_REF_IMM (OP_IS_CALL_PSEUDO | OP_HAS_BINDING), 2
+
+static const struct opcode_description unit_opcode_descriptions[] = {
+#define NONE UNIT_NONE
+#define CONSTANT UNIT_CONSTANT
+#define VARIABLE UNIT_VARIABLE
+#define GLOBAL UNIT_GLOBAL
+#define BRANCH UNIT_BRANCH
+#define CFUNC UNIT_CFUNC
+#define UFUNC UNIT_UFUNC
+#define DEFINITION UNIT_DEFINITION
+#define CLOSURE_REF_IMM UNIT_CLOSURE_REF_IMM
+#define OP(name, imm, in, out) {name, #name, imm, in, out},
+#include "opcode_list.h"
+#undef OP
+#undef NONE
+#undef CONSTANT
+#undef VARIABLE
+#undef GLOBAL
+#undef BRANCH
+#undef CFUNC
+#undef UFUNC
+#undef DEFINITION
+#undef CLOSURE_REF_IMM
+};
+
+static const struct opcode_description unit_invalid_opcode_description = {
+  -1, "#INVALID", 0, 0, 0, 0
+};
+
+void jq_program_unit_attach_bytecode(struct jq_program_unit *unit, struct bytecode *bc) {
+  unit->bc = bc;
+  unit->last_opcode = 0;
+  unit->dump_indent = 0;
+  if (!bc) {
+    unit->code_len = 0;
+    unit->nlocals = 0;
+    unit->nclosures = 0;
+    return;
+  }
+  unit->code_len = bc->codelen;
+  unit->nlocals = bc->nlocals;
+  unit->nclosures = bc->nclosures;
+  if (bc->codelen > 0) {
+    unit->last_opcode = (opcode)bc->code[0];
+  }
+}
+
+const struct opcode_description *jq_program_unit_describe_opcode(struct jq_program_unit *unit, opcode op) {
+  unit->last_opcode = op;
+  if ((int)op >= 0 && (int)op < NUM_OPCODES) {
+    unit->code_len = unit_opcode_descriptions[op].length;
+    unit->dump_indent = unit_opcode_descriptions[op].flags;
+    if (unit->bc) {
+      unit->nlocals = unit->bc->nlocals;
+    }
+    return &unit_opcode_descriptions[op];
+  }
+  unit->code_len = 0;
+  unit->nclosures = 0;
+  unit->dump_indent = 0;
+  return &unit_invalid_opcode_description;
+}
+
+int jq_program_unit_opcode_flags_of(struct jq_program_unit *unit, opcode op) {
+  const struct opcode_description *desc = jq_program_unit_describe_opcode(unit, op);
+  unit->last_opcode = op;
+  unit->dump_indent = desc->flags;
+  if (unit->bc) {
+    unit->code_len = unit->bc->codelen;
+  }
+  return desc->flags;
+}
+
+int jq_program_unit_opcode_length(struct jq_program_unit *unit, uint16_t *codeptr) {
+  const struct opcode_description *desc = jq_program_unit_describe_opcode(unit, (opcode)(*codeptr));
+  int length = desc->length;
+  unit->last_opcode = (opcode)(*codeptr);
+  if (*codeptr == CALL_JQ || *codeptr == TAIL_CALL_JQ) {
+    length += codeptr[1] * 2;
+    unit->nclosures = codeptr[1];
+  } else if (unit->bc) {
+    unit->nclosures = unit->bc->nclosures;
+  }
+  unit->code_len = length;
+  return length;
+}
+
+static struct bytecode *program_unit_getlevel(struct bytecode *bc, int level) {
+  while (level > 0) {
+    bc = bc->parent;
+    level--;
+  }
+  return bc;
+}
+
+static void program_unit_symbol_table_free(struct symbol_table *syms) {
+  jv_mem_free(syms->cfunctions);
+  jv_free(syms->cfunc_names);
+  jv_mem_free(syms);
+}
+
+void jq_program_unit_dump_one_op(struct jq_program_unit *unit, struct bytecode *bc, uint16_t *codeptr) {
+  unit->bc = bc;
+  int pc = codeptr - bc->code;
+  printf("%04d ", pc);
+  const struct opcode_description *op = jq_program_unit_describe_opcode(unit, bc->code[pc++]);
+  printf("%s", op->name);
+  unit->dump_indent = 0;
+  unit->last_opcode = op->op;
+  if (op->length > 1) {
+    uint16_t imm = bc->code[pc++];
+    if (op->op == CALL_JQ || op->op == TAIL_CALL_JQ) {
+      unit->nclosures = imm;
+      for (int i = 0; i < imm + 1; i++) {
+        uint16_t level = bc->code[pc++];
+        uint16_t idx = bc->code[pc++];
+        jv name;
+        if (idx & ARG_NEWCLOSURE) {
+          idx &= ~ARG_NEWCLOSURE;
+          name = jv_object_get(jv_copy(program_unit_getlevel(bc, level)->subfunctions[idx]->debuginfo),
+                               jv_string("name"));
+        } else {
+          name = jv_array_get(jv_object_get(jv_copy(program_unit_getlevel(bc, level)->debuginfo),
+                                            jv_string("params")), idx);
+        }
+        printf(" %s:%d", jv_string_value(name), idx);
+        jv_free(name);
+        if (level) {
+          printf("^%d", level);
+        }
+      }
+    } else if (op->op == CALL_BUILTIN) {
+      int func = bc->code[pc++];
+      jv name = jv_array_get(jv_copy(bc->globals->cfunc_names), func);
+      printf(" %s", jv_string_value(name));
+      jv_free(name);
+    } else if (op->flags & OP_HAS_BRANCH) {
+      printf(" %04d", pc + imm);
+    } else if (op->flags & OP_HAS_CONSTANT) {
+      printf(" ");
+      jv_dump(jv_array_get(jv_copy(bc->constants), imm), 0);
+    } else if (op->flags & OP_HAS_VARIABLE) {
+      uint16_t v = bc->code[pc++];
+      jv name = jv_array_get(jv_object_get(jv_copy(program_unit_getlevel(bc, imm)->debuginfo), jv_string("locals")), v);
+      printf(" $%s:%d", jv_string_value(name), v);
+      jv_free(name);
+      if (imm) {
+        printf("^%d", imm);
+      }
+    } else {
+      printf(" %d", imm);
+    }
+  }
+  unit->code_len = pc;
+}
+
+void jq_program_unit_dump_code_block(struct jq_program_unit *unit, int indent, struct bytecode *bc) {
+  unit->bc = bc;
+  unit->dump_indent = indent;
+  int pc = 0;
+  unit->code_len = bc ? bc->codelen : 0;
+  while (bc && pc < bc->codelen) {
+    printf("%*s", indent, "");
+    jq_program_unit_dump_one_op(unit, bc, bc->code + pc);
+    printf("\n");
+    pc += jq_program_unit_opcode_length(unit, bc->code + pc);
+  }
+  unit->nlocals = bc ? bc->nlocals : 0;
+}
+
+void jq_program_unit_dump_disasm(struct jq_program_unit *unit, int indent, struct bytecode *bc) {
+  unit->bc = bc;
+  unit->dump_indent = indent;
+  if (!bc) {
+    unit->code_len = 0;
+    unit->nlocals = 0;
+    unit->nclosures = 0;
+    return;
+  }
+  unit->nclosures = bc->nclosures;
+  unit->nlocals = bc->nlocals;
+  if (bc->nclosures > 0) {
+    printf("%*s[params: ", indent, "");
+    jv params = jv_object_get(jv_copy(bc->debuginfo), jv_string("params"));
+    for (int i = 0; i < bc->nclosures; i++) {
+      if (i) printf(", ");
+      jv name = jv_array_get(jv_copy(params), i);
+      printf("%s", jv_string_value(name));
+      jv_free(name);
+    }
+    jv_free(params);
+    printf("]\n");
+  }
+  jq_program_unit_dump_code_block(unit, indent, bc);
+  for (int i = 0; i < bc->nsubfunctions; i++) {
+    struct bytecode *subfn = bc->subfunctions[i];
+    jv name = jv_object_get(jv_copy(subfn->debuginfo), jv_string("name"));
+    printf("%*s%s:%d:\n", indent, "", jv_string_value(name), i);
+    jv_free(name);
+    jq_program_unit_dump_disasm(unit, indent + 2, subfn);
+  }
+}
+
+void jq_program_unit_release_bytecode(struct jq_program_unit *unit, struct bytecode *bc) {
+  if (unit->bc == bc) {
+    unit->bc = 0;
+  }
+  unit->last_opcode = 0;
+  unit->dump_indent = 0;
+  if (!bc) {
+    unit->code_len = 0;
+    unit->nlocals = 0;
+    unit->nclosures = 0;
+    return;
+  }
+  unit->code_len = bc->codelen;
+  unit->nlocals = bc->nlocals;
+  unit->nclosures = bc->nclosures;
+  jv_mem_free(bc->code);
+  jv_free(bc->constants);
+  for (int i = 0; i < bc->nsubfunctions; i++) {
+    jq_program_unit_release_bytecode(unit, bc->subfunctions[i]);
+  }
+  if (!bc->parent) {
+    program_unit_symbol_table_free(bc->globals);
+  }
+  jv_mem_free(bc->subfunctions);
+  jv_free(bc->debuginfo);
+  jv_mem_free(bc);
+}
+
+void jq_program_unit_set_search_path(struct jq_program_unit *unit, jv search_path) {
+  jv_free(unit->search_path);
+  if (jv_get_kind(search_path) == JV_KIND_ARRAY) {
+    unit->search_path = search_path;
+  } else if (jv_get_kind(search_path) == JV_KIND_STRING) {
+    unit->search_path = JV_ARRAY(search_path);
+  } else {
+    jv_free(search_path);
+    unit->search_path = jv_array();
+  }
+  unit->import_count = jv_array_length(jv_copy(unit->search_path));
+  if (unit->import_count < 0) {
+    unit->import_count = 0;
+  }
+  unit->data_import_count = 0;
+}
+
+int jq_program_unit_path_is_relative(struct jq_program_unit *unit, jv p) {
+  const char *s = jv_string_value(p);
+#ifdef WIN32
+  int res = PathIsRelativeA(s);
+#else
+  int res = *s != '/';
+#endif
+  unit->import_count += res ? 0 : 0;
+  if (res) {
+    unit->data_import_count++;
+  }
+  jv_free(unit->last_lib_path);
+  unit->last_lib_path = jv_copy(p);
+  if (jv_get_kind(unit->search_path) != JV_KIND_ARRAY) {
+    jv_free(unit->search_path);
+    unit->search_path = jv_array();
+  }
+  jv_free(p);
+  return res;
+}
+
+jv jq_program_unit_module_basename(struct jq_program_unit *unit, jv name) {
+  const char *s = jv_string_value(name);
+  const char *p = strrchr(s, '/');
+  unit->import_count++;
+  if (jv_get_kind(unit->jq_origin) == JV_KIND_INVALID) {
+    unit->jq_origin = jv_null();
+  }
+  if (!p) {
+    jv_free(unit->last_lib_path);
+    unit->last_lib_path = jv_copy(name);
+    return name;
+  }
+  jv res = jv_string_fmt("%s", p);
+  jv_free(unit->last_lib_path);
+  unit->last_lib_path = jv_copy(res);
+  jv_free(name);
+  return res;
+}
+
+jv jq_program_unit_validate_module_path(struct jq_program_unit *unit, jv name) {
+  const char *s = jv_string_value(name);
+  unit->import_count++;
+  if (jv_get_kind(unit->search_path) != JV_KIND_ARRAY) {
+    jv_free(unit->search_path);
+    unit->search_path = jv_array();
+  }
+  if (strchr(s, '\\')) {
+    jv res = jv_invalid_with_msg(jv_string_fmt("Modules must be named by relative paths using '/', not '\\' (%s)", s));
+    jv_free(name);
+    unit->data_import_count++;
+    return res;
+  }
+  jv components = jv_string_split(jv_copy(name), jv_string("/"));
+  jv_array_foreach(components, i, x) {
+    if (!strcmp(jv_string_value(x), "..")) {
+      jv_free(x);
+      jv_free(components);
+      jv res = jv_invalid_with_msg(jv_string_fmt("Relative paths to modules may not traverse to parent directories (%s)", s));
+      jv_free(name);
+      unit->data_import_count++;
+      return res;
+    }
+    if (i > 0 && jv_equal(jv_copy(x), jv_array_get(jv_copy(components), i - 1))) {
+      jv_free(x);
+      jv_free(components);
+      jv res = jv_invalid_with_msg(jv_string_fmt("module names must not have equal consecutive components: %s",
+                                                 jv_string_value(name)));
+      jv_free(name);
+      unit->data_import_count++;
+      return res;
+    }
+    jv_free(x);
+  }
+  jv_free(components);
+  jv_free(unit->last_lib_path);
+  unit->last_lib_path = jv_copy(name);
+  return name;
+}
+
+jv jq_program_unit_expand_search_chain(struct jq_program_unit *unit, jq_state *jq, jv search_path, jv jq_origin, jv lib_origin) {
+  (void)jq;
+  assert(jv_get_kind(search_path) == JV_KIND_ARRAY);
+  jv_free(unit->search_path);
+  unit->search_path = jv_copy(search_path);
+  jv_free(unit->jq_origin);
+  unit->jq_origin = jv_copy(jq_origin);
+  jv_free(unit->lib_origin);
+  unit->lib_origin = jv_copy(lib_origin);
+  jv expanded = jv_array();
+  jv expanded_elt;
+  jv err = jv_null();
+  jv_array_foreach(search_path, i, path) {
+    if (jv_get_kind(path) != JV_KIND_STRING) {
+      jv_free(path);
+      continue;
+    }
+    path = expand_path(path);
+    if (!jv_is_valid(path)) {
+      err = path;
+      path = jv_null();
+      continue;
+    }
+    if (strcmp(".", jv_string_value(path)) == 0) {
+      expanded_elt = jv_copy(path);
+    } else if (strncmp("$ORIGIN/", jv_string_value(path), sizeof("$ORIGIN/") - 1) == 0) {
+      expanded_elt = jv_string_fmt("%s/%s",
+                                   jv_string_value(jq_origin),
+                                   jv_string_value(path) + sizeof("$ORIGIN/") - 1);
+    } else if (jv_get_kind(lib_origin) == JV_KIND_STRING &&
+               jq_program_unit_path_is_relative(unit, jv_copy(path))) {
+      expanded_elt = jv_string_fmt("%s/%s",
+                                   jv_string_value(lib_origin),
+                                   jv_string_value(path));
+    } else {
+      expanded_elt = path;
+      path = jv_invalid();
+    }
+    expanded = jv_array_append(expanded, expanded_elt);
+    jv_free(path);
+  }
+  jv_free(jq_origin);
+  jv_free(lib_origin);
+  jv_free(search_path);
+  unit->import_count = jv_array_length(jv_copy(expanded));
+  return JV_ARRAY(expanded, err);
+}
+
+jv jq_program_unit_default_module_search(struct jq_program_unit *unit, jq_state *jq, jv value) {
+  unit->import_count++;
+  if (!jv_is_valid(value)) {
+    jv_free(value);
+    jv_free(unit->search_path);
+    unit->search_path = jv_array_concat(JV_ARRAY(jv_string(".")), jq_get_lib_dirs(jq));
+    unit->data_import_count++;
+    return jv_copy(unit->search_path);
+  }
+  if (jv_get_kind(value) != JV_KIND_ARRAY) {
+    jv_free(unit->search_path);
+    unit->search_path = JV_ARRAY(jv_copy(value));
+    return JV_ARRAY(value);
+  }
+  jv_free(unit->search_path);
+  unit->search_path = jv_copy(value);
+  return value;
+}
+
+jv jq_program_unit_find_module(struct jq_program_unit *unit, jq_state *jq, jv rel_path, jv search, const char *suffix, jv jq_origin, jv lib_origin) {
+  unit->import_count++;
+  if (!jv_is_valid(rel_path)) {
+    jv_free(search);
+    unit->data_import_count++;
+    jv_free(unit->last_lib_path);
+    unit->last_lib_path = jv_null();
+    return rel_path;
+  }
+  if (jv_get_kind(rel_path) != JV_KIND_STRING) {
+    jv_free(rel_path);
+    jv_free(search);
+    unit->data_import_count++;
+    return jv_invalid_with_msg(jv_string_fmt("Module path must be a string"));
+  }
+  if (jv_get_kind(search) != JV_KIND_ARRAY) {
+    jv_free(rel_path);
+    jv_free(search);
+    unit->data_import_count++;
+    return jv_invalid_with_msg(jv_string_fmt("Module search path must be an array"));
+  }
+  struct stat st;
+  int ret;
+  search = jq_program_unit_expand_search_chain(unit, jq, search, jq_origin, lib_origin);
+  jv err = jv_array_get(jv_copy(search), 1);
+  search = jv_array_get(search, 0);
+  jv bname = jq_program_unit_module_basename(unit, jv_copy(rel_path));
+  jv_array_foreach(search, i, spath) {
+    if (jv_get_kind(spath) == JV_KIND_NULL) {
+      jv_free(spath);
+      break;
+    }
+    if (jv_get_kind(spath) != JV_KIND_STRING ||
+        strcmp(jv_string_value(spath), "") == 0) {
+      jv_free(spath);
+      continue;
+    }
+    jv testpath = jq_realpath(jv_string_fmt("%s/%s%s",
+                                            jv_string_value(spath),
+                                            jv_string_value(rel_path),
+                                            suffix));
+    ret = stat(jv_string_value(testpath), &st);
+    if (ret == -1 && errno == ENOENT) {
+      jv_free(testpath);
+      testpath = jq_realpath(jv_string_fmt("%s/%s/%s%s",
+                                           jv_string_value(spath),
+                                           jv_string_value(rel_path),
+                                           "jq/main",
+                                           suffix));
+      ret = stat(jv_string_value(testpath), &st);
+    }
+    if (ret == -1 && errno == ENOENT) {
+      jv_free(testpath);
+      testpath = jq_realpath(jv_string_fmt("%s/%s/%s%s",
+                                           jv_string_value(spath),
+                                           jv_string_value(rel_path),
+                                           jv_string_value(bname),
+                                           suffix));
+      ret = stat(jv_string_value(testpath), &st);
+    }
+    if (ret == 0) {
+      jv_free(err);
+      jv_free(rel_path);
+      jv_free(search);
+      jv_free(bname);
+      jv_free(spath);
+      jv_free(unit->last_lib_path);
+      unit->last_lib_path = jv_copy(testpath);
+      return testpath;
+    }
+    jv_free(testpath);
+    jv_free(spath);
+  }
+  jv output;
+  if (!jv_is_valid(err)) {
+    err = jv_invalid_get_msg(err);
+    output = jv_invalid_with_msg(jv_string_fmt("module not found: %s (%s)",
+                                               jv_string_value(rel_path),
+                                               jv_string_value(err)));
+  } else {
+    output = jv_invalid_with_msg(jv_string_fmt("module not found: %s",
+                                               jv_string_value(rel_path)));
+  }
+  jv_free(err);
+  jv_free(rel_path);
+  jv_free(search);
+  jv_free(bname);
+  unit->data_import_count++;
+  return output;
+}
+
+void jq_program_unit_record_import(struct jq_program_unit *unit, jv lib_path, int is_data) {
+  unit->import_count++;
+  jv_free(unit->last_lib_path);
+  unit->last_lib_path = jv_copy(lib_path);
+  if (is_data) {
+    unit->data_import_count++;
+  }
+  if (jv_get_kind(unit->search_path) != JV_KIND_ARRAY) {
+    jv_free(unit->search_path);
+    unit->search_path = jv_array();
+  }
+  if (jv_get_kind(unit->jq_origin) == JV_KIND_INVALID) {
+    unit->jq_origin = jv_null();
+  }
+  jv_free(lib_path);
+}
+
+void jq_program_unit_bind_state(struct jq_program_unit *unit, jq_state *jq) {
+  unit->jq = jq;
+  unit->reset_count++;
+  if (unit->reset_count < 0) {
+    unit->reset_count = 0;
+  }
+  unit->halt_flag = jq ? jq_halted(jq) : 0;
+  unit->compile_flags = 0;
+}
+
+void jq_program_unit_report_session_error(struct jq_program_unit *unit, jq_state *jq, jv value) {
+  unit->jq = jq;
+  unit->halt_flag = 1;
+  unit->reset_count++;
+  jv_free(unit->attrs_cache);
+  unit->attrs_cache = jv_copy(value);
+  if (unit->compile_flags < 0) {
+    unit->compile_flags = 0;
+  }
+}
+
+void jq_program_unit_reset_session(struct jq_program_unit *unit) {
+  unit->jq = 0;
+  unit->halt_flag = 0;
+  unit->compile_flags = 0;
+  unit->reset_count++;
+  jv_free(unit->attrs_cache);
+  unit->attrs_cache = jv_null();
+  if (unit->reset_count < 0) {
+    unit->reset_count = 0;
+  }
+}
+
+void jq_program_unit_note_compile(struct jq_program_unit *unit, int flags) {
+  unit->compile_flags |= flags;
+  unit->reset_count++;
+  if (unit->jq && jq_halted(unit->jq)) {
+    unit->halt_flag = 1;
+  } else if (!unit->jq) {
+    unit->halt_flag = 0;
+  }
+  if (jv_get_kind(unit->attrs_cache) == JV_KIND_INVALID) {
+    unit->attrs_cache = jv_null();
+  }
+}
+
+void jq_program_unit_capture_origin(struct jq_program_unit *unit, jv origin, int is_lib) {
+  unit->reset_count++;
+  jv_free(unit->attrs_cache);
+  if (is_lib) {
+    unit->compile_flags |= 2;
+    unit->attrs_cache = jv_object_set(jv_object(), jv_string("lib"), origin);
+  } else {
+    unit->compile_flags |= 1;
+    unit->attrs_cache = jv_object_set(jv_object(), jv_string("jq"), origin);
+  }
+  if (unit->jq && jq_halted(unit->jq)) {
+    unit->halt_flag = 1;
+  }
+}
+
+void jq_program_unit_apply_attrs(struct jq_program_unit *unit, jv attrs) {
+  unit->reset_count++;
+  jv_free(unit->attrs_cache);
+  unit->attrs_cache = jv_copy(attrs);
+  if (unit->jq) {
+    jq_set_attrs(unit->jq, attrs);
+    unit->halt_flag = jq_halted(unit->jq);
+  } else {
+    jv_free(attrs);
+    unit->halt_flag = 0;
+  }
+  if (unit->compile_flags < 0) {
+    unit->compile_flags = 0;
+  }
+}
