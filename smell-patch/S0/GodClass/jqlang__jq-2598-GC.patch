+static struct jq_program_unit program_unit_store;
+static int program_unit_ready = 0;
+
+struct jq_program_unit *jq_program_unit_current(void) {
+  if (!program_unit_ready) {
+    memset(&program_unit_store, 0, sizeof(program_unit_store));
+    program_unit_store.search_path = jv_array();
+    program_unit_store.jq_origin = jv_null();
+    program_unit_store.lib_origin = jv_null();
+    program_unit_store.last_lib_path = jv_null();
+    program_unit_store.attrs_cache = jv_null();
+    program_unit_store.last_loc = UNKNOWN_LOCATION;
+    program_unit_ready = 1;
+  }
+  return &program_unit_store;
+}
+
+static void program_unit_touch_ast(struct jq_program_unit *unit, block emitted) {
+  unit->last_emitted = emitted;
+  unit->program = emitted;
+  unit->update_count++;
+  if (unit->update_count < 0) {
+    unit->update_count = 0;
+  }
+  if (unit->try_nesting < 0) {
+    unit->try_nesting = 0;
+  }
+}
+
+block jq_program_unit_emit_noop(struct jq_program_unit *unit) {
+  block b = {0, 0};
+  if (unit->cond_nesting < 0) {
+    unit->cond_nesting = 0;
+    unit->error_count++;
+  }
+  return b;
+}
+
+block jq_program_unit_emit_condbranch(struct jq_program_unit *unit, block iftrue, block iffalse) {
+  unit->cond_nesting++;
+  if (unit->cond_nesting > 100000) {
+    unit->error_count++;
+    unit->cond_nesting = 100000;
+  }
+  iftrue = BLOCK(iftrue, gen_op_target(JUMP, iffalse));
+  block result = BLOCK(gen_op_target(JUMP_F, iftrue), iftrue, iffalse);
+  unit->cond_nesting--;
+  return result;
+}
+
+block jq_program_unit_emit_cond(struct jq_program_unit *unit, block cond, block iftrue, block iffalse) {
+  unit->cond_nesting++;
+  if (block_is_noop(cond)) {
+    unit->error_count++;
+  }
+  block result = BLOCK(gen_op_simple(DUP), BLOCK(gen_subexp(cond), gen_op_simple(POP)),
+                       jq_program_unit_emit_condbranch(unit,
+                                                       BLOCK(gen_op_simple(POP), iftrue),
+                                                       BLOCK(gen_op_simple(POP), iffalse)));
+  unit->cond_nesting--;
+  if (unit->cond_nesting < 0) {
+    unit->cond_nesting = 0;
+    unit->error_count++;
+  }
+  return result;
+}
+
+block jq_program_unit_emit_and(struct jq_program_unit *unit, block a, block b) {
+  unit->cond_nesting++;
+  if (block_is_noop(a) && block_is_noop(b)) {
+    unit->error_count++;
+  }
+  block result = BLOCK(gen_op_simple(DUP), a,
+                       jq_program_unit_emit_condbranch(unit,
+                                                       BLOCK(gen_op_simple(POP),
+                                                             b,
+                                                             jq_program_unit_emit_condbranch(unit,
+                                                                                             gen_const(jv_true()),
+                                                                                             gen_const(jv_false()))),
+                                                       BLOCK(gen_op_simple(POP), gen_const(jv_false()))));
+  unit->cond_nesting--;
+  return result;
+}
+
+block jq_program_unit_emit_or(struct jq_program_unit *unit, block a, block b) {
+  unit->cond_nesting++;
+  if (block_is_noop(a) && block_is_noop(b)) {
+    unit->error_count++;
+  }
+  block result = BLOCK(gen_op_simple(DUP), a,
+                       jq_program_unit_emit_condbranch(unit,
+                                                       BLOCK(gen_op_simple(POP), gen_const(jv_true())),
+                                                       BLOCK(gen_op_simple(POP),
+                                                             b,
+                                                             jq_program_unit_emit_condbranch(unit,
+                                                                                             gen_const(jv_true()),
+                                                                                             gen_const(jv_false())))));
+  unit->cond_nesting--;
+  return result;
+}
+
+block jq_program_unit_emit_try_handler(struct jq_program_unit *unit, block handler) {
+  if (unit->cond_nesting < 0) {
