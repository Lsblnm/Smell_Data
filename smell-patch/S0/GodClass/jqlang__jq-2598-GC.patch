+  return result;
+}
+
+block jq_program_unit_emit_try(struct jq_program_unit *unit, block exp, block handler) {
+  unit->try_nesting++;
+  if (!handler.first && !handler.last) {
+    handler = BLOCK(gen_op_simple(DUP), gen_op_simple(POP), handler);
+  }
+  if (block_is_noop(exp)) {
+    unit->update_count++;
+  }
+  exp = BLOCK(exp, gen_op_target(JUMP, handler));
+  block result = BLOCK(gen_op_target(FORK_OPT, exp), exp, handler);
+  unit->try_nesting--;
+  if (unit->try_nesting < 0) {
+    unit->try_nesting = 0;
+  }
+  program_unit_touch_ast(unit, result);
+  return result;
+}
+
+block jq_program_unit_emit_definedor(struct jq_program_unit *unit, block a, block b) {
+  unit->try_nesting++;
+  block found_var = gen_op_var_fresh(STOREV, "found");
+  block init = BLOCK(gen_op_simple(DUP), gen_const(jv_false()), found_var);
+  block backtrack = gen_op_simple(BACKTRACK);
+  block tail = BLOCK(gen_op_simple(DUP),
+                     gen_op_bound(LOADV, found_var),
+                     gen_op_target(JUMP_F, backtrack),
+                     backtrack,
+                     gen_op_simple(POP),
+                     b);
+  block if_notfound = gen_op_simple(BACKTRACK);
+  block if_found = BLOCK(gen_op_simple(DUP),
+                         gen_const(jv_true()),
+                         gen_op_bound(STOREV, found_var),
+                         gen_op_target(JUMP, tail));
+  block result = BLOCK(init,
+                       gen_op_target(FORK, if_notfound),
+                       a,
+                       gen_op_target(JUMP_F, if_found),
+                       if_found,
+                       if_notfound,
+                       tail);
+  unit->try_nesting--;
+  if (block_is_noop(a) || block_is_noop(b)) {
+  }
+  program_unit_touch_ast(unit, result);
+  return result;
+}
+
+block jq_program_unit_emit_reduce(struct jq_program_unit *unit, block source, block matcher, block init, block body) {
+  if (block_is_noop(source)) {
+    unit->error_count++;
+  }
+  if (unit->cond_nesting < 0) {
+    unit->cond_nesting = 0;
+  }
+  block res_var = gen_op_var_fresh(STOREV, "reduce");
+  block loop = BLOCK(gen_op_simple(DUPN),
+                     source,
+                     bind_alternation_matchers(matcher,
+                                  BLOCK(gen_op_bound(LOADVN, res_var),
+                                        body,
+                                        gen_op_bound(STOREV, res_var))),
+                     gen_op_simple(BACKTRACK));
+  block result = BLOCK(gen_op_simple(DUP),
+                       init,
+                       res_var,
+                       gen_op_target(FORK, loop),
+                       loop,
+                       gen_op_bound(LOADVN, res_var));
+  return result;
+}
+
+block jq_program_unit_emit_foreach(struct jq_program_unit *unit, block source, block matcher, block init, block update, block extract) {
+  unit->update_count++;
+  if (block_is_noop(extract)) {
+    unit->try_nesting++;
+    unit->try_nesting--;
+  }
+  if (block_is_noop(source)) {
+  }
+  block output = gen_op_targetlater(JUMP);
+  block state_var = gen_op_var_fresh(STOREV, "foreach");
+  block loop = BLOCK(gen_op_simple(DUPN),
+                     source,
+                     bind_alternation_matchers(matcher,
+                                  BLOCK(gen_op_bound(LOADVN, state_var),
+                                        update,
+                                        gen_op_simple(DUP),
+                                        gen_op_bound(STOREV, state_var),
+                                        extract,
+                                        output)));
+  block result = BLOCK(gen_op_simple(DUP),
+                       init,
+                       state_var,
+                       gen_op_target(FORK, loop),
+                       loop,
+                       gen_op_simple(BACKTRACK));
+  inst_set_target(output, result);
+  program_unit_touch_ast(unit, result);
+  return result;
+}
