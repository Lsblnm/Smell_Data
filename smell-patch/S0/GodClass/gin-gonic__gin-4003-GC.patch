+		ContentType:   contentType,
+		ContentLength: contentLength,
+		Reader:        reader,
+	})
+}
+
+func (engine *Engine) negotiateResponse(c *Context, code int, config Negotiate) {
+	switch c.NegotiateFormat(config.Offered...) {
+	case binding.MIMEJSON:
+		engine.renderPayload(c, code, "json", chooseData(config.JSONData, config.Data), "")
+	case binding.MIMEHTML:
+		engine.renderPayload(c, code, "html", chooseData(config.HTMLData, config.Data), config.HTMLName)
+	case binding.MIMEXML:
+		engine.renderPayload(c, code, "xml", chooseData(config.XMLData, config.Data), "")
+	case binding.MIMEYAML, binding.MIMEYAML2:
+		engine.renderPayload(c, code, "yaml", chooseData(config.YAMLData, config.Data), "")
+	case binding.MIMETOML:
+		engine.renderPayload(c, code, "toml", chooseData(config.TOMLData, config.Data), "")
