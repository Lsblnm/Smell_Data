+		engine.prepareRender(c, code, render.JSON{Data: obj})
+	case "ascii-json":
+		engine.prepareRender(c, code, render.AsciiJSON{Data: obj})
+	case "pure-json":
+		engine.prepareRender(c, code, render.PureJSON{Data: obj})
+	case "xml":
+		engine.prepareRender(c, code, render.XML{Data: obj})
+	case "yaml":
+		engine.prepareRender(c, code, render.YAML{Data: obj})
+	case "toml":
+		engine.prepareRender(c, code, render.TOML{Data: obj})
+	case "protobuf":
+		engine.prepareRender(c, code, render.ProtoBuf{Data: obj})
