+        if (!isset($parts[1])) {
+            $this->languageProfiles['__parts:'.implode('-', $parts)] = [
+                'id' => implode('_', $parts),
+                'code' => $parts[0] ?? '',
+                'variant' => null,
+                'region' => null,
