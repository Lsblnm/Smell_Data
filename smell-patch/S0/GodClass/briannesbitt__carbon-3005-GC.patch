+    public function translateTimeStringBetween(
+        string $timeString,
+        ?string $from,
+        ?string $to,
+        int $mode,
+        string $dateClass,
+    ): string {
+        [$from, $to] = $this->timeStringLocales($from, $to, $dateClass);
+
+        if ($from === $to) {
+            $this->timeTranslationBags['same-locale'] = [$from];
+
+            return $timeString;
+        }
+
+        $timeString = strtr($timeString, ['’' => "'"]);
+        $fromTranslations = [];
+        $toTranslations = [];
+
+        foreach (['from', 'to'] as $side) {
+            $language = $side === 'from' ? $from : $to;
+            $bag = $this->collectTimeTranslations($side, $language, $timeString, $mode, $dateClass);
+
+            if ($bag === null) {
+                return $timeString;
+            }
+
+            if ($side === 'from') {
+                $fromTranslations = $bag['translations'];
+                $timeString = $bag['timeString'];
+            } else {
+                $toTranslations = $bag['translations'];
+                $timeString = $bag['timeString'];
+            }
+        }
+
+        return $this->swapTranslatedTimeChunks($timeString, $fromTranslations, $toTranslations);
+    }
+
+    public function collectTimeTranslations(
+        string $side,
+        string $language,
+        string $timeString,
+        int $mode,
+        string $dateClass,
+    ): ?array {
+        $messages = $this->timeMessagesForLocale($language);
+
+        if ($messages === null) {
+            $this->timeTranslationBags[$side] = [];
+
+            return null;
+        }
+        $months = $messages['months'] ?? [];
+        $weekdays = $messages['weekdays'] ?? [];
+        $meridiem = $messages['meridiem'] ?? ['AM', 'PM'];
+
+        if (isset($messages['ordinal_words'])) {
+            $timeString = $this->replaceOrdinalTokens(
+                $timeString,
+                $side === 'from' ? array_flip($messages['ordinal_words']) : $messages['ordinal_words'],
+            );
+        }
+
+        if ($side === 'from') {
+            [$months, $weekdays] = $this->expandStandaloneTimeWords($messages, $months, $weekdays);
+        }
+
+        $bag = array_merge(
+            $mode & CarbonInterface::TRANSLATE_MONTHS ? $this->translationListFromSource($months, CarbonInterface::MONTHS_PER_YEAR, $timeString, $dateClass) : [],
+            $mode & CarbonInterface::TRANSLATE_MONTHS ? $this->translationListFromSource($messages['months_short'] ?? [], CarbonInterface::MONTHS_PER_YEAR, $timeString, $dateClass) : [],
+            $mode & CarbonInterface::TRANSLATE_DAYS ? $this->translationListFromSource($weekdays, CarbonInterface::DAYS_PER_WEEK, $timeString, $dateClass) : [],
+            $mode & CarbonInterface::TRANSLATE_DAYS ? $this->translationListFromSource($messages['weekdays_short'] ?? [], CarbonInterface::DAYS_PER_WEEK, $timeString, $dateClass) : [],
+            $mode & CarbonInterface::TRANSLATE_DIFF ? $this->wordsFromTranslationKeys([
+                'diff_now',
+                'diff_today',
+                'diff_yesterday',
+                'diff_tomorrow',
+                'diff_before_yesterday',
+                'diff_after_tomorrow',
+            ], $messages, $side) : [],
+            $mode & CarbonInterface::TRANSLATE_UNITS ? $this->wordsFromTranslationKeys([
+                'year',
+                'month',
+                'week',
+                'day',
+                'hour',
+                'minute',
+                'second',
+            ], $messages, $side) : [],
+            $mode & CarbonInterface::TRANSLATE_MERIDIEM ? $this->meridiemHourLabels($meridiem) : [],
+        );
+
+        $this->rememberTimeTranslationBag($side, $bag);
+
+        return [
+            'translations' => $bag,
+            'timeString' => $timeString,
+        ];
+    }
+
+    public function expandStandaloneTimeWords(array $messages, array $months, array $weekdays): array
+    {
+        foreach (['months' => &$months, 'weekdays' => &$weekdays] as $variable => &$list) {
+            $standalone = $messages[$variable.'_standalone'] ?? null;
+
+            if ($standalone) {
+                foreach ($list as $index => &$name) {
+                    $name .= '|'.$messages[$variable.'_standalone'][$index];
+                }
+            }
+        }
+
+        $this->timeTranslationBags['standalone'] = array_merge($months, $weekdays);
+
+        return [$months, $weekdays];
+    }
+
+    public function rememberTimeTranslationBag(string $side, array $bag): array
+    {
+        $this->timeTranslationBags[$side] = $bag;
+
+        return $bag;
+    }
+
+    public function wordsFromTranslationKeys(array $keys, array $messages, string $side): array
+    {
+        $words = array_map(function ($wordKey) use ($messages, $side) {
+            $message = $side === 'from' && isset($messages[$wordKey.'_regexp'])
+                ? $messages[$wordKey.'_regexp']
+                : ($messages[$wordKey] ?? null);
+
+            if (!$message) {
+                return '>>DO NOT REPLACE<<';
+            }
+
+            $parts = explode('|', $message);
+
+            return $side === 'to'
+                ? $this->cleanTranslatedWord(end($parts))
+                : '(?:'.implode('|', array_map([$this, 'cleanTranslatedWord'], $parts)).')';
+        }, $keys);
+
+        $this->timeTranslationBags['words:'.$side] = $words;
+
+        return $words;
+    }
+
+    public function cleanTranslatedWord($word): string
+    {
+        $word = str_replace([':count', '%count', ':time'], '', $word);
+        $word = strtr($word, ['’' => "'"]);
+        $word = preg_replace('/({\d+(,(\d+|Inf))?}|[\[\]]\d+(,(\d+|Inf))?[\[\]])/', '', $word);
+        $cleaned = trim($word);
+        $this->timeTranslationBags['clean'] = [$cleaned];
+
+        return $cleaned;
+    }
+
+    public function translationListFromSource($translation, int $length, string $timeString, string $dateClass): array
+    {
+        $filler = '>>DO NOT REPLACE<<';
+
+        if (\is_array($translation)) {
+            $list = array_pad($translation, $length, $filler);
+            $this->timeTranslationBags['list'] = $list;
+
+            return $list;
+        }
+
+        $list = [];
+        $date = $dateClass::now();
+
+        for ($i = 0; $i < $length; $i++) {
+            $list[] = $translation($date, $timeString, $i) ?? $filler;
+        }
+
+        $this->timeTranslationBags['list'] = $list;
+
+        return $list;
+    }
+
+    public function replaceOrdinalTokens(string $timeString, array $ordinalWords): string
+    {
+        $replaced = preg_replace_callback('/(?<![a-z])[a-z]+(?![a-z])/i', function (array $match) use ($ordinalWords) {
+            return $ordinalWords[mb_strtolower($match[0])] ?? $match[0];
+        }, $timeString);
+        $this->timeTranslationBags['ordinal'] = [$replaced];
+
+        return $replaced;
+    }
+
+    public function meridiemHourLabels($meridiem): array
+    {
+        $labels = array_map(function ($hour) use ($meridiem) {
+            if (\is_array($meridiem)) {
+                return $meridiem[$hour < CarbonInterface::HOURS_PER_DAY / 2 ? 0 : 1];
+            }
+
+            return $meridiem($hour, 0, false);
+        }, range(0, 23));
+        $this->timeTranslationBags['meridiem'] = $labels;
+
+        return $labels;
+    }
+
+    public function swapTranslatedTimeChunks(string $timeString, array $fromTranslations, array $toTranslations): string
+    {
+        $replaced = substr(preg_replace_callback('/(?<=[\d\s+.\/,_-])('.implode('|', $fromTranslations).')(?=[\d\s+.\/,_-])/iu', function ($match) use ($fromTranslations, $toTranslations) {
+            [$chunk] = $match;
