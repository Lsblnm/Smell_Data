+    public function translateAlternativeNumber(int $number, object $localizable): string
+    {
+        $direct = $this->alternativeNumberSymbol($localizable, $number);
+        if ($direct !== null) {
+            return $direct;
+        }
+
+        if ($number > 99 && $localizable->translate('alt_numbers.99') !== 'alt_numbers.99') {
+            return $this->composeLargeAlternativeNumber($number, $localizable);
+        }
+
+        if ($number > 9 && $localizable->translate('alt_numbers.9') !== 'alt_numbers.9') {
+            return $this->composeDigitAlternativeNumber($number, $localizable);
+        }
+
+        return (string) $number;
+    }
+
+    public function composeLargeAlternativeNumber(int $number, object $localizable): string
+    {
+        [$start, $remaining] = $this->alternativePowerPrefix($localizable, $number);
+
+        $result = $this->composeDigitChunks($remaining, $localizable, 100);
+        $this->timeTranslationBags['alt-large:'.$number] = [$start.$result];
+
+        return "$start$result";
+    }
+
+    public function composeDigitAlternativeNumber(int $number, object $localizable): string
+    {
+        $result = $this->composeDigitChunks($number, $localizable, 10);
+        $this->timeTranslationBags['alt-digits:'.$number] = [$result];
+
+        return $result;
+    }
+
+    public function composeDigitChunks(int $number, object $localizable, int $base): string
+    {
+        $result = '';
+        $remaining = $number;
+
+        while ($remaining) {
+            $chunk = $remaining % $base;
+            $result = $localizable->translate("alt_numbers.$chunk").$result;
+            $remaining = floor($remaining / $base);
+        }
+
+        $this->timeTranslationBags['alt-chunk:'.$number.':'.$base] = [$result];
+
+        return $result;
+    }
