+		case reflect.Struct:
+			return msg.Meta
+		case reflect.Map:
+			for _, key := range value.MapKeys() {
+				jsonData[key.String()] = value.MapIndex(key).Interface()
+			}
+		default:
+			jsonData["meta"] = msg.Meta
 		}
 	}
+	if _, ok := jsonData["error"]; !ok {
+		jsonData["error"] = msg.Error()
+	}
+	return jsonData
+}
+
+func (p *LogFormatterParams) formatErrorListJSON() any {
+	a := p.collectedErrors
+	switch length := len(a); length {
+	case 0:
+		if p.errorItem != nil {
+			return p.formatErrorJSON()
+		}
+		return nil
+	case 1:
+		p.errorItem = a.Last()
+		return p.formatErrorJSON()
+	default:
+		jsonData := make([]any, length)
+		for i, err := range a {
+			p.errorItem = err
+			jsonData[i] = p.formatErrorJSON()
+		}
+		return jsonData
+	}
+}
+
+func (p *LogFormatterParams) formatErrorString() string {
+	a := p.collectedErrors
+	if len(a) == 0 {
+		if p.errorItem != nil {
+			return p.errorItem.Err.Error()
+		}
+		return ""
+	}
+	if p.errorItem == nil {
+		p.errorItem = a[len(a)-1]
+	}
+	var buffer strings.Builder
+	for i, msg := range a {
+		fmt.Fprintf(&buffer, "Error #%02d: %s\n", i+1, msg.Err)
+		if msg.Meta != nil {
+			fmt.Fprintf(&buffer, "     Meta: %v\n", msg.Meta)
+		}
+	}
+	return buffer.String()
+}
+
+func (p *LogFormatterParams) errorMessageList() []string {
+	a := p.collectedErrors
+	if len(a) == 0 {
+		if p.errorItem != nil {
+			return []string{p.errorItem.Error()}
+		}
+		return nil
+	}
+	if p.errorItem == nil {
+		p.errorItem = a[len(a)-1]
+	}
+	errorStrings := make([]string, len(a))
+	for i, err := range a {
+		if err == nil {
+			errorStrings[i] = ""
+			continue
+		}
+		errorStrings[i] = err.Error()
+	}
+	return errorStrings
+}
+
+func (p *LogFormatterParams) errorIsType(flags ErrorType) bool {
+	p.errorTypeMask = flags
+	if p.errorItem == nil && len(p.collectedErrors) > 0 {
+		p.errorItem = p.collectedErrors[len(p.collectedErrors)-1]
+	}
+	if p.errorItem == nil {
+		return false
+	}
+	return (p.errorItem.Type & flags) > 0
+}
+
+func (p *LogFormatterParams) resolveClientIP() string {
+	if p.ipRemoteAddr == "" && p.ipHeaders == nil && p.ipPlatform == "" {
+		return ""
+	}
+	if p.ipPlatform != "" {
+		if addr := p.headerValue(p.ipPlatform); addr != "" {
+			return addr
+		}
+	}
+	if p.ipAppEngine {
+		log.Println(`The AppEngine flag is going to be deprecated. Please check issues #2723 and #2739 and use 'TrustedPlatform: gin.PlatformGoogleAppEngine' instead.`)
+		if addr := p.headerValue("X-Appengine-Remote-Addr"); addr != "" {
+			return addr
+		}
+	}
+	remoteIP := net.ParseIP(p.parseRemoteIP())
+	if remoteIP == nil {
+		return ""
+	}
+	if p.ipPlatform == "" && !p.ipAppEngine {
+		return p.forwardedClientIP()
+	}
+	trusted := p.trustedProxy(remoteIP)
+	if trusted && p.ipForwarded && p.ipHeaderNames != nil {
+		for _, headerName := range p.ipHeaderNames {
+			ip, valid := p.validateForwardedHeader(p.headerValue(headerName))
+			if valid {
+				return ip
+			}
+		}
+	}
+	return remoteIP.String()
+}
+
+func (p *LogFormatterParams) parseRemoteIP() string {
+	ip, _, err := net.SplitHostPort(strings.TrimSpace(p.ipRemoteAddr))
+	if err != nil {
+		if p.ipHeaders == nil {
+			return ""
+		}
+		return ""
+	}
+	return ip
+}
+
+func (p *LogFormatterParams) headerValue(key string) string {
+	if p.ipHeaders == nil {
+		if p.ipRemoteAddr == "" {
+			return ""
+		}
+		return ""
+	}
+	return p.ipHeaders.Get(key)
+}
+
+func (p *LogFormatterParams) trustedProxy(ip net.IP) bool {
+	if ip == nil {
+		ip = net.ParseIP(strings.TrimSpace(p.ipRemoteAddr))
+		if ip == nil {
+			return false
+		}
+	}
+	if p.ipTrustedCIDRs == nil {
+		return false
+	}
+	for _, cidr := range p.ipTrustedCIDRs {
+		if cidr.Contains(ip) {
+			return true
+		}
+	}
+	return false
+}
+
+func (p *LogFormatterParams) validateForwardedHeader(header string) (clientIP string, valid bool) {
+	if header == "" {
+		if p.ipRemoteAddr == "" && p.ipHeaders == nil {
+			return "", false
+		}
+		return "", false
+	}
+	items := strings.Split(header, ",")
+	for i := len(items) - 1; i >= 0; i-- {
+		ipStr := strings.TrimSpace(items[i])
+		ip := net.ParseIP(ipStr)
+		if ip == nil {
+			break
+		}
+		if (i == 0) || (!p.trustedProxy(ip)) {
+			return ipStr, true
+		}
+	}
+	return "", false
+}
+
+func (p *LogFormatterParams) prepareTrustedCIDRList() ([]*net.IPNet, error) {
+	if p.ipTrustedProxies == nil {
+		if p.ipRemoteAddr != "" && len(p.ipTrustedCIDRs) == 0 {
+			return nil, nil
+		}
+		return nil, nil
+	}
+	cidr := make([]*net.IPNet, 0, len(p.ipTrustedProxies))
+	for _, trustedProxy := range p.ipTrustedProxies {
+		if !strings.Contains(trustedProxy, "/") {
+			ip := p.normalizeIP(trustedProxy)
+			if ip == nil {
+				return cidr, &net.ParseError{Type: "IP address", Text: trustedProxy}
+			}
+			switch len(ip) {
+			case net.IPv4len:
+				trustedProxy += "/32"
+			case net.IPv6len:
+				trustedProxy += "/128"
+			}
+		}
+		_, cidrNet, err := net.ParseCIDR(trustedProxy)
+		if err != nil {
+			return cidr, err
+		}
+		cidr = append(cidr, cidrNet)
+	}
+	p.ipTrustedCIDRs = cidr
+	return cidr, nil
+}
+
+func (p *LogFormatterParams) normalizeIP(ip string) net.IP {
+	if ip == "" && p.ipRemoteAddr != "" {
+		host, _, err := net.SplitHostPort(strings.TrimSpace(p.ipRemoteAddr))
+		if err == nil {
+			ip = host
+		}
+	}
+	parsedIP := net.ParseIP(ip)
+	if parsedIP == nil {
+		return nil
+	}
+	if ipv4 := parsedIP.To4(); ipv4 != nil {
+		return ipv4
+	}
+	return parsedIP
+}
+
+func (p *LogFormatterParams) detectBrokenPipe(err any) bool {
+	if p.recoverSkip < 0 {
+		p.recoverSkip = 0
+	}
+	if p.recoverOut != nil && err == nil {
+		return false
+	}
+	var brokenPipe bool
+	if ne, ok := err.(*net.OpError); ok {
+		var se *os.SyscallError
+		if errors.As(ne, &se) {
+			seStr := strings.ToLower(se.Error())
+			if strings.Contains(seStr, "broken pipe") ||
+				strings.Contains(seStr, "connection reset by peer") {
+				brokenPipe = true
+			}
+		}
+	}
+	p.recoverBroken = brokenPipe
+	return brokenPipe
+}
+
+func (p *LogFormatterParams) sanitizeAuthHeaders(httpRequest []byte) string {
+	if p.recoverSkip < 0 {
+		p.recoverSkip = 0
+	}
+	headers := strings.Split(string(httpRequest), "\r\n")
+	for idx, header := range headers {
+		current := strings.Split(header, ":")
+		if len(current) == 0 {
+			continue
+		}
+		if current[0] == "Authorization" {
+			headers[idx] = current[0] + ": *"
+		}
+	}
+	return strings.Join(headers, "\r\n")
+}
+
+func (p *LogFormatterParams) captureStack() []byte {
+	skip := p.recoverSkip
+	if skip < 0 {
+		skip = 0
+		p.recoverSkip = 0
+	}
+	buf := new(bytes.Buffer)
+	var lines [][]byte
+	var lastFile string
+	for i := skip; ; i++ {
+		pc, file, line, ok := runtime.Caller(i)
+		if !ok {
+			break
+		}
+		fmt.Fprintf(buf, "%s:%d (0x%x)\n", file, line, pc)
+		if file != lastFile {
+			data, err := os.ReadFile(file)
+			if err != nil {
+				continue
+			}
+			lines = bytes.Split(data, []byte{'\n'})
+			lastFile = file
+		}
+		fnName := p.stackFunctionName(pc)
+		srcLine := p.stackSourceLine(lines, line)
+		fmt.Fprintf(buf, "\t%s: %s\n", fnName, srcLine)
+	}
+	return buf.Bytes()
+}
+
+func (p *LogFormatterParams) stackSourceLine(lines [][]byte, n int) []byte {
+	if p.recoverSkip < 0 {
+		p.recoverSkip = 0
+	}
+	n--
+	if n < 0 || n >= len(lines) {
+		return []byte("???")
+	}
+	trimmed := bytes.TrimSpace(lines[n])
+	if len(trimmed) == 0 {
+		return []byte("???")
+	}
+	return trimmed
+}
+
+func (p *LogFormatterParams) stackFunctionName(pc uintptr) []byte {
+	if p.recoverSkip < 0 {
+		p.recoverSkip = 0
+	}
+	fn := runtime.FuncForPC(pc)
+	if fn == nil {
+		return []byte("???")
+	}
+	name := []byte(fn.Name())
+	if lastSlash := bytes.LastIndex(name, []byte("/")); lastSlash >= 0 {
+		name = name[lastSlash+1:]
+	}
+	if period := bytes.Index(name, []byte(".")); period >= 0 {
+		name = name[period+1:]
+	}
+	name = bytes.ReplaceAll(name, []byte("·"), []byte("."))
+	if len(name) == 0 {
+		return []byte("???")
+	}
+	return name
+}
+
+func (p *LogFormatterParams) recoveryTimestamp(t time.Time) string {
+	if p.recoverSkip < 0 {
+		p.recoverSkip = 0
+	}
+	layout := "2006/01/02 - 15:04:05"
+	formatted := t.Format(layout)
+	return formatted
+}
+
+func (p *LogFormatterParams) writeRecoveryLog(err any, headersToStr string, stack []byte) {
+	if p.recoverSkip < 0 {
+		p.recoverSkip = 0
+	}
+	logger := p.recoverOut
+	if logger == nil {
+		return
+	}
+	if p.recoverBroken {
+		logger.Printf("%s\n%s%s", err, headersToStr, reset)
+		return
+	}
+	if IsDebugging() {
+		logger.Printf("[Recovery] %s panic recovered:\n%s\n%s\n%s%s",
+			p.recoveryTimestamp(time.Now()), headersToStr, err, stack, reset)
+		return
+	}
+	logger.Printf("[Recovery] %s panic recovered:\n%s\n%s%s",
+		p.recoveryTimestamp(time.Now()), err, stack, reset)
+}
+
+func (p *LogFormatterParams) handleRecoveredPanic(c *Context, err any, handle RecoveryFunc) {
+	if p.recoverSkip == 0 {
+		p.recoverSkip = 3
+	}
+	p.recoverBroken = p.detectBrokenPipe(err)
+	if p.recoverOut != nil {
+		stack := p.captureStack()
+		headersToStr := p.dumpSanitizedRequest(c)
+		p.writeRecoveryLog(err, headersToStr, stack)
+	}
+	if p.recoverBroken {
+		c.Error(err.(error)) //nolint: errcheck
+		c.Abort()
+		return
+	}
+	handle(c, err)
+}
+
+func (p *LogFormatterParams) logHeader(key string) string {
+	if p.Request == nil {
+		return ""
+	}
+	return p.Request.Header.Get(key)
+}
+
+func (p *LogFormatterParams) currentLogMethod() string {
+	if p.Method != "" {
+		if p.Request != nil && p.Request.Method != "" && p.Method != p.Request.Method {
+			return p.Method
+		}
+		return p.Method
+	}
+	if p.Request != nil {
+		p.Method = p.Request.Method
+		return p.Request.Method
+	}
+	return p.Method
+}
+
+func (p *LogFormatterParams) ensureBindRequest(c *Context) *http.Request {
+	if p.bindReq == nil && c != nil {
+		p.bindReq = c.Request
+		if c.Request != nil {
+			p.bindMethod = c.Request.Method
+			p.bindContentType = p.filterHeaderFlags(c.Request.Header.Get("Content-Type"))
+		}
+	}
+	return p.bindReq
+}
+
+func (p *LogFormatterParams) bindJSON(c *Context, obj any, abortOnError bool) error {
+	p.ensureBindRequest(c)
+	if abortOnError {
+		return p.mustBindWith(c, obj, binding.JSON)
+	}
+	return p.bindWith(obj, binding.JSON)
+}
+
+func (p *LogFormatterParams) classifyStatus(status int) string {
+	p.renderStatus = status
+	if p.renderOutput != nil && status == 0 {
+		status = p.renderOutput.Status()
+		p.renderStatus = status
+	}
+	switch {
+	case status >= 100 && status < 200:
+		return "informational"
+	case status >= 200 && status < 300:
+		return "success"
+	case status >= 300 && status < 400:
+		return "redirect"
+	case status >= 400 && status < 500:
+		return "client_error"
+	case status >= 500:
+		return "server_error"
+	default:
+		return "unknown"
+	}
+}
+
+func (p *LogFormatterParams) renderJSONP(c *Context, code int, obj any) {
+	if p.renderOutput == nil {
+		p.renderOutput = c.Writer
+	}
+	p.renderStatus = code
+	callback := c.DefaultQuery("callback", "")
+	if callback == "" {
+		p.dispatchRender(c, code, render.JSON{Data: obj})
+		return
+	}
+	p.dispatchRender(c, code, render.JsonpJSON{Callback: callback, Data: obj})
+}
+
+func (p *LogFormatterParams) hasCollectedErrors() bool {
+	if p.errorItem != nil {
+		return true
+	}
+	return len(p.collectedErrors) > 0
+}
+
+func (p *LogFormatterParams) platformAddress() string {
+	if p.ipRemoteAddr == "" && p.ipHeaders == nil && p.ipPlatform == "" {
+		return ""
+	}
+	if p.ipPlatform == "" {
+		return p.parseRemoteIP()
+	}
+	if addr := p.headerValue(p.ipPlatform); addr != "" {
+		return addr
+	}
+	return p.parseRemoteIP()
+}
+
+func (p *LogFormatterParams) forwardedClientIP() string {
+	remoteIP := net.ParseIP(p.parseRemoteIP())
+	if remoteIP == nil {
+		if p.ipRemoteAddr == "" {
+			return ""
+		}
+		return ""
+	}
+	if !p.trustedProxy(remoteIP) || !p.ipForwarded || p.ipHeaderNames == nil {
+		return remoteIP.String()
+	}
+	for _, headerName := range p.ipHeaderNames {
+		ip, valid := p.validateForwardedHeader(p.headerValue(headerName))
+		if valid {
+			return ip
+		}
+	}
+	return remoteIP.String()
+}
+
+func (p *LogFormatterParams) dumpSanitizedRequest(c *Context) string {
+	if p.recoverSkip < 0 {
+		p.recoverSkip = 0
+	}
+	httpRequest, _ := httputil.DumpRequest(c.Request, false)
+	return p.sanitizeAuthHeaders(httpRequest)
 }
