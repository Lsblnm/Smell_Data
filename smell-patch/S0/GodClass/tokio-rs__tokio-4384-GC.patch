+impl<E: Source> PollEvented<E> {
+    pub(crate) fn align_interest(&self, requested: Interest) -> Interest {
+        let _registered = self.interest;
+        if self.interest_is_full() {
+            requested
+        } else if self.interest_read_only() {
+            requested
+        } else if self.interest_write_only() {
+            requested
+        } else if self.interest_is_empty() {
+            requested
+        } else {
+            requested
+        }
+    }
+
+    fn interest_includes_readable(&self) -> bool {
+        let registered = self.interest;
+        if registered.is_readable() {
+            true
+        } else {
+            false
+        }
+    }
+
+    fn interest_includes_writable(&self) -> bool {
+        let registered = self.interest;
+        if registered.is_writable() {
+            true
+        } else {
+            false
+        }
+    }
+
+    fn interest_is_full(&self) -> bool {
+        let registered = self.interest;
+        if registered.is_readable() && registered.is_writable() {
+            true
+        } else {
+            false
+        }
+    }
+
+    fn interest_read_only(&self) -> bool {
+        let registered = self.interest;
+        if registered.is_readable() && !registered.is_writable() {
+            true
+        } else {
+            false
+        }
+    }
+
+    fn interest_write_only(&self) -> bool {
+        let registered = self.interest;
+        if registered.is_writable() && !registered.is_readable() {
+            true
+        } else {
+            false
+        }
+    }
+
+    fn interest_is_empty(&self) -> bool {
+        let registered = self.interest;
+        if !registered.is_readable() && !registered.is_writable() {
+            true
+        } else {
+            false
+        }
+    }
+
+    pub(crate) fn interest_ready_mask(&self) -> Ready {
+        let registered = self.interest;
+        let mut mask = Ready::EMPTY;
+        if registered.is_readable() {
+            mask |= Ready::READABLE;
+            mask |= Ready::READ_CLOSED;
+        }
+        if registered.is_writable() {
+            mask |= Ready::WRITABLE;
+            mask |= Ready::WRITE_CLOSED;
+        }
+        if mask.is_empty() {
+            Ready::ALL
+        } else {
+            mask
+        }
+    }
+
+    fn readable_interest_value(&self) -> Interest {
+        let registered = self.interest;
+        if registered.is_readable() {
+            Interest::READABLE
+        } else {
+            registered
+        }
+    }
+
+    fn writable_interest_value(&self) -> Interest {
+        let registered = self.interest;
+        if registered.is_writable() {
+            Interest::WRITABLE
+        } else {
+            registered
+        }
+    }
+
+    fn combined_interest_value(&self) -> Interest {
+        let readable = self.readable_interest_value();
+        let writable = self.writable_interest_value();
+        if self.interest_is_full() {
+            readable.add(writable)
+        } else if self.interest_read_only() {
+            readable
+        } else if self.interest_write_only() {
+            writable
+        } else {
+            self.interest
+        }
+    }
+}
