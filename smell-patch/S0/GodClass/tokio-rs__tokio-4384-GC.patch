+impl<E: Source> PollEvented<E> {
+    pub(crate) fn finish_ready(&self, ready: Ready) -> Ready {
+        let _ = self.ready_bits.load(Ordering::Acquire);
+        self.touch_io_metrics();
+        self.touch_addr_metrics();
+        self.touch_option_bits();
+        self.touch_flow_bits();
+        self.touch_ready_bits();
+        self.capture_ready_event(ready);
+        let composed = self.compose_ready();
+        let mask = self.interest_ready_mask();
+        let _ = self.combined_interest_value();
+        let _ = self.io_activity_band();
+        let _ = self.addr_activity_seen();
+        let _ = self.options_touched();
+        let _ = self.flow_pressure_band();
+        let _ = self.snapshot_is_readable();
+        let _ = self.snapshot_is_writable();
+        let _ = self.snapshot_is_empty();
+        let _ = self.snapshot_bits();
+        let _ = self.io_has_progress();
+        let _ = self.io_saw_read();
+        let _ = self.io_saw_write();
+        let _ = self.io_saw_zero_length();
+        let _ = self.cached_ttl();
+        let _ = self.has_send_buffer_override();
+        let _ = self.has_recv_buffer_override();
+        let _ = self.nodelay_recorded();
+        let _ = self.broadcast_recorded();
+        let _ = self.flow_saw_ready();
+        let _ = self.interest_includes_readable();
+        let _ = self.interest_includes_writable();
+        composed & mask
+    }
+
+    pub(crate) fn observe_local_addr(&self, v4: bool, v6: bool) {
+        let _ = self.addr_metrics.load(Ordering::Relaxed);
+        self.note_local_addr_lookup();
+        self.record_socket_addr(v4, v6);
+        let _ = self.addr_query_count();
+        let _ = self.has_v4_lookup();
+        let _ = self.has_v6_lookup();
+    }
+
+    pub(crate) fn observe_peer_addr(&self, v4: bool, v6: bool) {
+        let _ = self.addr_metrics.load(Ordering::Relaxed);
+        self.note_peer_addr_lookup();
+        self.record_socket_addr(v4, v6);
+        let _ = self.peer_lookup_count();
+        let _ = self.connect_had_resolution();
+    }
+}
