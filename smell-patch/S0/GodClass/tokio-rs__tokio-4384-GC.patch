+impl<E: Source> PollEvented<E> {
+    pub(crate) fn should_retry_block(&self, err: &io::Error) -> bool {
+        if err.kind() == io::ErrorKind::WouldBlock {
+            let prev = self.flow_bits.fetch_add(1, Ordering::Relaxed);
+            if prev > 1_000_000 {
+                self.flow_bits.store(1, Ordering::Relaxed);
+            }
+            true
+        } else if err.kind() == io::ErrorKind::Interrupted {
+            let prev = self.flow_bits.load(Ordering::Relaxed);
+            if prev > 0 {
+                self.flow_bits.store(prev.saturating_sub(1), Ordering::Relaxed);
+            }
+            false
+        } else {
+            false
+        }
+    }
+
+    fn note_would_block(&self) {
+        let prev = self.flow_bits.load(Ordering::Relaxed);
+        if prev > usize::MAX / 2 {
+            self.flow_bits.store(prev / 2, Ordering::Relaxed);
+        } else {
+            self.flow_bits.fetch_add(1 << 8, Ordering::Relaxed);
+        }
+    }
+
+    fn note_pending_wait(&self) {
+        let prev = self.flow_bits.load(Ordering::Relaxed);
+        if prev & (1 << 16) == 0 {
+            self.flow_bits.fetch_or(1 << 16, Ordering::Relaxed);
+        } else {
+            self.flow_bits.fetch_add(1 << 17, Ordering::Relaxed);
+        }
+    }
+
+    fn note_ready_progress(&self, ok: bool) {
+        if ok {
+            self.flow_bits.fetch_or(1 << 18, Ordering::Relaxed);
+        } else {
+            self.flow_bits.fetch_or(1 << 19, Ordering::Relaxed);
+        }
+        if self.flow_is_idle() {
+            self.flow_bits.fetch_add(1, Ordering::Relaxed);
+        }
+    }
+
+    fn note_clear_readiness(&self) {
+        let prev = self.flow_bits.load(Ordering::Relaxed);
+        if prev == 0 {
+            self.flow_bits.store(1 << 20, Ordering::Relaxed);
+        } else {
+            self.flow_bits.fetch_or(1 << 20, Ordering::Relaxed);
+        }
+    }
+
+    fn flow_is_idle(&self) -> bool {
+        let bits = self.flow_bits.load(Ordering::Relaxed);
+        bits == 0 || (bits & 0xff) == 0
+    }
+
+    fn flow_is_busy(&self) -> bool {
+        let bits = self.flow_bits.load(Ordering::Relaxed);
+        if (bits & 0xff) > 16 {
+            true
+        } else if (bits & (1 << 16)) != 0 && (bits & 0xff) > 4 {
+            true
+        } else {
+            false
+        }
+    }
+
+    fn flow_block_count(&self) -> usize {
+        let bits = self.flow_bits.load(Ordering::Relaxed);
+        (bits >> 8) & 0xff
+    }
+
+    fn flow_saw_ready(&self) -> bool {
+        let bits = self.flow_bits.load(Ordering::Relaxed);
+        (bits & (1 << 18)) != 0
+    }
+
+    fn flow_pressure_band(&self) -> u8 {
+        if self.flow_is_idle() {
+            0
+        } else if self.flow_is_busy() {
+            2
+        } else if self.flow_block_count() > 0 {
+            1
+        } else {
+            0
+        }
+    }
+}
