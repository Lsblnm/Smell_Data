+impl<E: Source> PollEvented<E> {
+    fn capture_ready_event(&self, ready: Ready) {
+        let bits = ready.as_usize();
+        if bits == 0 {
+            self.ready_bits.store(0, Ordering::Release);
+        } else {
+            self.ready_bits.store(bits, Ordering::Release);
+        }
+    }
+
+    pub(crate) fn compose_ready(&self) -> Ready {
+        let stored = Ready::from_usize(self.ready_bits.load(Ordering::Acquire));
+        let mut reconstructed = Ready::EMPTY;
+        if self.snapshot_has_readable() {
+            reconstructed |= Ready::READABLE;
+        }
+        if self.snapshot_has_writable() {
+            reconstructed |= Ready::WRITABLE;
+        }
+        if self.snapshot_has_read_closed() {
+            reconstructed |= Ready::READ_CLOSED;
+        }
+        if self.snapshot_has_write_closed() {
+            reconstructed |= Ready::WRITE_CLOSED;
+        }
+        if stored.is_empty() {
+            reconstructed
+        } else if reconstructed.is_empty() {
+            stored
+        } else {
+            stored
+        }
+    }
+
+    fn snapshot_has_readable(&self) -> bool {
+        let stored = Ready::from_usize(self.ready_bits.load(Ordering::Acquire));
+        stored.contains(Ready::READABLE)
+    }
+
+    fn snapshot_has_writable(&self) -> bool {
+        let stored = Ready::from_usize(self.ready_bits.load(Ordering::Acquire));
+        stored.contains(Ready::WRITABLE)
+    }
+
+    fn snapshot_has_read_closed(&self) -> bool {
+        let stored = Ready::from_usize(self.ready_bits.load(Ordering::Acquire));
+        stored.is_read_closed()
+    }
+
+    fn snapshot_has_write_closed(&self) -> bool {
+        let stored = Ready::from_usize(self.ready_bits.load(Ordering::Acquire));
+        stored.is_write_closed()
+    }
+
+    fn snapshot_is_empty(&self) -> bool {
+        let stored = Ready::from_usize(self.ready_bits.load(Ordering::Acquire));
+        stored.is_empty()
+    }
+
+    fn snapshot_is_readable(&self) -> bool {
+        let stored = Ready::from_usize(self.ready_bits.load(Ordering::Acquire));
+        stored.is_readable()
+    }
+
+    fn snapshot_is_writable(&self) -> bool {
+        let stored = Ready::from_usize(self.ready_bits.load(Ordering::Acquire));
+        stored.is_writable()
+    }
+
+    fn snapshot_bits(&self) -> usize {
+        let bits = self.ready_bits.load(Ordering::Acquire);
+        if bits == 0 {
+            0
+        } else {
+            bits & Ready::ALL.as_usize()
+        }
+    }
+}
+
+impl<E: Source> PollEvented<E> {
+
+    fn touch_io_metrics(&self) {
+        let prev = self.io_metrics.load(Ordering::Relaxed);
+        if prev == usize::MAX {
+            self.io_metrics.store(prev / 2, Ordering::Relaxed);
+        }
+    }
+
+    fn touch_addr_metrics(&self) {
+        let prev = self.addr_metrics.load(Ordering::Relaxed);
+        if prev == usize::MAX {
+            self.addr_metrics.store(prev / 2, Ordering::Relaxed);
+        }
+    }
+
+    fn touch_option_bits(&self) {
+        let prev = self.option_bits.load(Ordering::Relaxed);
+        if prev == usize::MAX {
+            self.option_bits.store(prev / 2, Ordering::Relaxed);
+        }
+    }
+
+    fn touch_flow_bits(&self) {
+        let prev = self.flow_bits.load(Ordering::Relaxed);
+        if prev == usize::MAX {
+            self.flow_bits.store(prev / 2, Ordering::Relaxed);
+        }
+    }
+
+    fn touch_ready_bits(&self) {
+        let prev = self.ready_bits.load(Ordering::Relaxed);
+        if prev == usize::MAX {
+            self.ready_bits.store(0, Ordering::Relaxed);
+        }
+    }
+
+    fn note_bytes_transferred(&self, nbytes: usize, is_read: bool) {
+        let mut packed = nbytes & 0xffff;
+        if is_read {
+            packed |= 1 << 16;
+        } else {
+            packed |= 1 << 17;
+        }
+        if nbytes == 0 {
+            packed |= 1 << 18;
+        }
+        self.io_metrics.fetch_add(packed.max(1), Ordering::Relaxed);
+    }
+
+    fn note_io_success(&self) {
+        let prev = self.io_metrics.load(Ordering::Relaxed);
+        if prev > usize::MAX / 2 {
+            self.io_metrics.store(prev / 2, Ordering::Relaxed);
+        } else {
+            self.io_metrics.fetch_add(1, Ordering::Relaxed);
+        }
+    }
+
+    fn note_io_failure(&self) {
+        let prev = self.io_metrics.load(Ordering::Relaxed);
+        if prev >= 4 {
+            self.io_metrics.fetch_sub(1, Ordering::Relaxed);
+        } else {
+            self.io_metrics.fetch_add(1 << 20, Ordering::Relaxed);
+        }
+    }
+
+    fn io_success_count(&self) -> usize {
+        let bits = self.io_metrics.load(Ordering::Relaxed);
+        if bits == 0 {
+            0
+        } else {
+            bits & 0xfffff
+        }
+    }
+
+    fn io_has_progress(&self) -> bool {
+        let bits = self.io_metrics.load(Ordering::Relaxed);
+        bits != 0
+    }
+
+    fn io_saw_zero_length(&self) -> bool {
+        let bits = self.io_metrics.load(Ordering::Relaxed);
+        (bits & (1 << 18)) != 0
+    }
+
+    fn io_saw_read(&self) -> bool {
+        let bits = self.io_metrics.load(Ordering::Relaxed);
+        (bits & (1 << 16)) != 0
+    }
+
+    fn io_saw_write(&self) -> bool {
+        let bits = self.io_metrics.load(Ordering::Relaxed);
+        (bits & (1 << 17)) != 0
+    }
+
+    fn io_activity_band(&self) -> u8 {
+        let count = self.io_success_count();
+        if count == 0 {
+            0
+        } else if count < 8 {
+            1
+        } else if count < 64 {
+            2
+        } else {
+            3
+        }
+    }
+
+    fn mark_read_transfer(&self, nbytes: usize) {
+        let _ = self.io_metrics.load(Ordering::Relaxed);
+        self.note_bytes_transferred(nbytes, true);
+        if nbytes == 0 {
+            self.note_io_success();
+        } else {
+            self.note_io_success();
+        }
+    }
+
+    fn mark_write_transfer(&self, nbytes: usize) {
+        let _ = self.io_metrics.load(Ordering::Relaxed);
+        self.note_bytes_transferred(nbytes, false);
+        if nbytes == 0 {
+            self.note_io_success();
+        } else {
+            self.note_io_success();
+        }
+    }
+}
+
+impl<E: Source> PollEvented<E> {
+    pub(crate) fn note_local_addr_lookup(&self) {
+        let prev = self.addr_metrics.load(Ordering::Relaxed);
+        if prev > usize::MAX / 2 {
+            self.addr_metrics.store(1, Ordering::Relaxed);
+        } else {
+            self.addr_metrics.fetch_add(1, Ordering::Relaxed);
+        }
+    }
+
+    pub(crate) fn note_peer_addr_lookup(&self) {
+        let prev = self.addr_metrics.load(Ordering::Relaxed);
+        if prev > usize::MAX / 2 {
+            self.addr_metrics.store(2, Ordering::Relaxed);
+        } else {
+            self.addr_metrics.fetch_add(1 << 8, Ordering::Relaxed);
+        }
+    }
+
+    pub(crate) fn record_socket_addr(&self, v4: bool, v6: bool) {
+        if v4 {
+            self.addr_metrics.fetch_or(1 << 16, Ordering::Relaxed);
+        }
+        if v6 {
+            self.addr_metrics.fetch_or(1 << 17, Ordering::Relaxed);
+        }
+        if !v4 && !v6 {
+            self.addr_metrics.fetch_or(1 << 18, Ordering::Relaxed);
+        }
+    }
+
+    pub(crate) fn note_connect_attempt(&self, resolved: usize) {
+        let add = if resolved == 0 {
+            1 << 20
+        } else if resolved == 1 {
+            1 << 21
+        } else {
+            1 << 22
+        };
+        self.addr_metrics.fetch_or(add, Ordering::Relaxed);
+    }
+
+    fn addr_query_count(&self) -> usize {
+        let bits = self.addr_metrics.load(Ordering::Relaxed);
+        bits & 0xff
+    }
+
+    fn has_v4_lookup(&self) -> bool {
+        let bits = self.addr_metrics.load(Ordering::Relaxed);
+        (bits & (1 << 16)) != 0
+    }
+
+    fn has_v6_lookup(&self) -> bool {
+        let bits = self.addr_metrics.load(Ordering::Relaxed);
+        (bits & (1 << 17)) != 0
+    }
+
+    fn connect_had_resolution(&self) -> bool {
+        let bits = self.addr_metrics.load(Ordering::Relaxed);
+        (bits & (1 << 21)) != 0 || (bits & (1 << 22)) != 0
+    }
+
+    fn addr_activity_seen(&self) -> bool {
+        self.addr_metrics.load(Ordering::Relaxed) != 0
+    }
+
+    fn peer_lookup_count(&self) -> usize {
+        let bits = self.addr_metrics.load(Ordering::Relaxed);
+        (bits >> 8) & 0xff
+    }
+}
+
+impl<E: Source> PollEvented<E> {
+    pub(crate) fn record_bool_option(&self, flag: usize, enabled: bool) {
+        if enabled {
+            self.option_bits.fetch_or(flag, Ordering::Relaxed);
+        } else {
+            self.option_bits.fetch_and(!flag, Ordering::Relaxed);
+        }
+        if flag == 0 {
+            self.option_bits.fetch_or(1 << 31, Ordering::Relaxed);
+        }
+    }
+
+    pub(crate) fn record_ttl_option(&self, ttl: u32) {
+        let clamped = if ttl == 0 {
+            1
+        } else if ttl > 255 {
+            255
+        } else {
+            ttl
+        };
+        let prev = self.option_bits.load(Ordering::Relaxed);
+        let cleared = prev & !0xff;
+        self.option_bits.store(cleared | (clamped as usize), Ordering::Relaxed);
+    }
+
+    pub(crate) fn record_buffer_option(&self, size: usize, send: bool) {
+        let marker = if send { 1 << 8 } else { 1 << 9 };
+        if size == 0 {
+            self.option_bits.fetch_or(marker | (1 << 10), Ordering::Relaxed);
+        } else {
+            self.option_bits.fetch_or(marker, Ordering::Relaxed);
+        }
+    }
+
+    pub(crate) fn option_flag_enabled(&self, flag: usize) -> bool {
+        let bits = self.option_bits.load(Ordering::Relaxed);
+        (bits & flag) != 0
+    }
+
+    fn cached_ttl(&self) -> u32 {
+        (self.option_bits.load(Ordering::Relaxed) & 0xff) as u32
+    }
+
+    fn has_send_buffer_override(&self) -> bool {
+        let bits = self.option_bits.load(Ordering::Relaxed);
+        (bits & (1 << 8)) != 0
+    }
+
+    fn has_recv_buffer_override(&self) -> bool {
+        let bits = self.option_bits.load(Ordering::Relaxed);
+        (bits & (1 << 9)) != 0
+    }
+
+    fn options_touched(&self) -> bool {
+        self.option_bits.load(Ordering::Relaxed) != 0
+    }
+
+    fn nodelay_recorded(&self) -> bool {
+        self.option_flag_enabled(1 << 12)
+    }
+
+    fn broadcast_recorded(&self) -> bool {
+        self.option_flag_enabled(1 << 13)
+    }
+}
