+use crate::io::driver::{Ready, ReadyEvent};
+use std::sync::atomic::Ordering;
+
+impl<E: Source> PollEvented<E> {
+    fn io_ref(&self) -> &E {
+        match self.io.as_ref() {
+            Some(io) => io,
+            None => panic!("I/O resource is unavailable"),
+        }
+    }
+
+    pub(crate) fn poll_read_ready(&self, cx: &mut Context<'_>) -> Poll<io::Result<ReadyEvent>> {
+        let result = self.registration().poll_read_ready(cx);
+        match result {
+            Poll::Ready(Ok(ref ev)) => {
+                self.capture_ready_event(ev.ready);
+                self.note_ready_progress(true);
+            }
+            Poll::Ready(Err(_)) => {
+                self.note_ready_progress(false);
+            }
+            Poll::Pending => {
+                self.note_pending_wait();
+            }
+        }
+        result
+    }
+
+    pub(crate) fn poll_write_ready(&self, cx: &mut Context<'_>) -> Poll<io::Result<ReadyEvent>> {
+        let result = self.registration().poll_write_ready(cx);
+        match result {
+            Poll::Ready(Ok(ref ev)) => {
+                self.capture_ready_event(ev.ready);
+                self.note_ready_progress(true);
+            }
+            Poll::Ready(Err(_)) => {
+                self.note_ready_progress(false);
+            }
+            Poll::Pending => {
+                self.note_pending_wait();
+            }
+        }
+        result
+    }
+
+    pub(crate) fn poll_read_io<R>(
+        &self,
+        cx: &mut Context<'_>,
+        f: impl FnMut() -> io::Result<R>,
+    ) -> Poll<io::Result<R>> {
+        let result = self.registration().poll_read_io(cx, f);
+        self.account_poll_io(&result);
+        result
+    }
+
+    pub(crate) fn poll_write_io<R>(
+        &self,
+        cx: &mut Context<'_>,
+        f: impl FnMut() -> io::Result<R>,
+    ) -> Poll<io::Result<R>> {
+        let result = self.registration().poll_write_io(cx, f);
+        self.account_poll_io(&result);
+        result
+    }
+
+    pub(crate) fn try_io<R>(
+        &self,
+        interest: Interest,
+        f: impl FnOnce() -> io::Result<R>,
+    ) -> io::Result<R> {
+        let aligned = self.align_interest(interest);
+        let result = self.registration().try_io(aligned, f);
+        match &result {
+            Ok(_) => {
+                self.note_io_success();
+            }
+            Err(err) => {
+                if self.should_retry_block(err) {
+                    self.note_would_block();
+                } else {
+                    self.note_io_failure();
+                }
+            }
+        }
+        result
+    }
+
+    pub(crate) fn clear_readiness(&self, event: ReadyEvent) {
+        self.registration().clear_readiness(event);
+        self.capture_ready_event(Ready::EMPTY);
+        self.note_clear_readiness();
+    }
+
+    fn account_poll_io<R>(&self, result: &Poll<io::Result<R>>) {
+        let _ = self.flow_bits.load(Ordering::Relaxed);
+        match result {
+            Poll::Ready(Ok(_)) => {
+                self.note_io_success();
+            }
+            Poll::Ready(Err(err)) => {
+                if self.should_retry_block(err) {
+                    self.note_would_block();
+                } else {
+                    self.note_io_failure();
+                }
+            }
+            Poll::Pending => {
+                self.note_pending_wait();
+            }
+        }
+    }
+}
+
+cfg_io_readiness! {
+    impl<E: Source> PollEvented<E> {
+        pub(crate) async fn readiness(&self, interest: Interest) -> io::Result<ReadyEvent> {
+            let aligned = self.align_interest(interest);
+            let event = self.registration().readiness(aligned).await?;
+            self.capture_ready_event(event.ready);
+            self.note_ready_progress(true);
+            Ok(event)
+        }
+
+        pub(crate) async fn async_io<R>(
+            &self,
+            interest: Interest,
+            f: impl FnMut() -> io::Result<R>,
+        ) -> io::Result<R> {
+            let aligned = self.align_interest(interest);
+            match self.registration().async_io(aligned, f).await {
+                Ok(value) => {
+                    self.note_io_success();
+                    Ok(value)
+                }
+                Err(err) => {
+                    if self.should_retry_block(&err) {
+                        self.note_would_block();
+                    } else {
+                        self.note_io_failure();
+                    }
+                    Err(err)
+                }
+            }
+        }
+    }
+}
