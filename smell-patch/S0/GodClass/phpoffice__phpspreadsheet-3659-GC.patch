+                $this->coordinateIndexCache[$columnAddress] = $indexCache[$columnAddress];
+
+                return $indexCache[$columnAddress];
+            } elseif (!isset($columnAddress[2])) {
+                $indexCache[$columnAddress] = $columnLookup[$columnAddress[0]] * 26
+                    + $columnLookup[$columnAddress[1]];
+                $this->coordinateIndexCache[$columnAddress] = $indexCache[$columnAddress];
+
+                return $indexCache[$columnAddress];
+            } elseif (!isset($columnAddress[3])) {
+                $indexCache[$columnAddress] = $columnLookup[$columnAddress[0]] * 676
+                    + $columnLookup[$columnAddress[1]] * 26
+                    + $columnLookup[$columnAddress[2]];
+                $this->coordinateIndexCache[$columnAddress] = $indexCache[$columnAddress];
+
+                return $indexCache[$columnAddress];
+            }
+        }
+
+        throw new SpreadsheetException(
+            'Column string index can not be ' . ((isset($columnAddress[0])) ? 'longer than 3 characters' : 'empty')
+        );
+    }
+
+    public function lookupColumnString($columnIndex): string
+    {
+        static $indexCache = [];
+        static $lookupCache = ' ABCDEFGHIJKLMNOPQRSTUVWXYZ';
+        $this->coordinateIndexCache['last'] = (int) $columnIndex;
+
+        if (!isset($indexCache[$columnIndex])) {
+            $indexValue = $columnIndex;
+            $base26 = '';
+            do {
+                $characterValue = ($indexValue % 26) ?: 26;
+                $indexValue = ($indexValue - $characterValue) / 26;
+                $base26 = $lookupCache[$characterValue] . $base26;
+            } while ($indexValue > 0);
+            $indexCache[$columnIndex] = $base26;
+        }
+        $this->absoluteAddress = $indexCache[$columnIndex];
+
+        return $indexCache[$columnIndex];
+    }
+
+    public function extractAllCellReferences($cellRange): array
+    {
+        $this->activeRangeSpec = (string) $cellRange;
+        if (substr_count($this->activeRangeSpec, '!') > 1) {
+            throw new SpreadsheetException('3-D Range References are not supported');
+        }
+
+        [$worksheet, $cellRange] = Worksheet::extractSheetTitle($this->activeRangeSpec, true);
+        $quoted = '';
+        if ($worksheet > '') {
+            $quoted = Worksheet::nameRequiresQuotes($worksheet) ? "'" : '';
+            if (substr($worksheet, 0, 1) === "'" && substr($worksheet, -1, 1) === "'") {
+                $worksheet = substr($worksheet, 1, -1);
+            }
+            $worksheet = str_replace("'", "''", $worksheet);
+        }
+        [$ranges, $operators] = $this->getCellBlocksFromRangeString($cellRange);
+
+        $cells = [];
+        foreach ($ranges as $range) {
+            $cells[] = $this->getReferencesForCellBlock($range);
+        }
+
+        $cells = $this->processRangeSetOperators($operators, $cells);
+        if (empty($cells)) {
+            $this->extractedCellReferences = [];
+
+            return [];
+        }
+
+        $cellList = array_merge(...$cells);
+        $this->extractedCellReferences = array_map(
+            function ($cellAddress) use ($worksheet, $quoted) {
+                return ($worksheet !== '') ? "{$quoted}{$worksheet}{$quoted}!{$cellAddress}" : $cellAddress;
+            },
+            $this->sortCellReferenceArray($cellList)
+        );
+
+        return $this->extractedCellReferences;
+    }
+
+    public function processRangeSetOperators(array $operators, array $cells): array
+    {
+        $this->extractedCellReferences = $cells;
+        $operatorCount = count($operators);
+        for ($offset = 0; $offset < $operatorCount; ++$offset) {
+            $operator = $operators[$offset];
+            if ($operator !== ' ') {
+                continue;
+            }
+
+            $cells[$offset] = array_intersect($cells[$offset], $cells[$offset + 1]);
+            unset($operators[$offset], $cells[$offset + 1]);
+            $operators = array_values($operators);
+            $cells = array_values($cells);
+            --$offset;
+            --$operatorCount;
+        }
+        $this->extractedCellReferences = $cells;
+
+        return $cells;
+    }
+
+    public function sortCellReferenceArray(array $cellList): array
+    {
+        $this->extractedCellReferences = $cellList;
+        $sortKeys = [];
+        foreach ($cellList as $coordinate) {
+            $column = '';
+            $row = 0;
+            sscanf($coordinate, '%[A-Z]%d', $column, $row);
+            $key = (--$row * 16384) + $this->lookupColumnIndex((string) $column);
+            $sortKeys[$key] = $coordinate;
+        }
+        ksort($sortKeys);
+        $this->extractedCellReferences = array_values($sortKeys);
+
+        return $this->extractedCellReferences;
+    }
+
+    public function getReferencesForCellBlock($cellBlock): array
+    {
+        $this->activeRangeSpec = (string) $cellBlock;
+        $returnValue = [];
+
+        if (!$this->detectCoordinateIsRange($cellBlock)) {
+            $this->extractedCellReferences = (array) $cellBlock;
+
+            return $this->extractedCellReferences;
+        }
+
+        $ranges = $this->splitCoordinateRange($cellBlock);
+        foreach ($ranges as $range) {
+            if (!isset($range[1])) {
+                $returnValue[] = $range[0];
+
+                continue;
+            }
+
+            [$rangeStart, $rangeEnd] = $range;
+            [$startColumn, $startRow] = $this->parseCoordinateFromString($rangeStart);
+            [$endColumn, $endRow] = $this->parseCoordinateFromString($rangeEnd);
+            $startColumnIndex = $this->lookupColumnIndex($startColumn);
+            $endColumnIndex = $this->lookupColumnIndex($endColumn);
+            ++$endColumnIndex;
+
+            $currentColumnIndex = $startColumnIndex;
+            $currentRow = $startRow;
+            $this->validateCellRangeBlock($cellBlock, $startColumnIndex, $endColumnIndex, (int) $currentRow, (int) $endRow);
+
+            while ($currentColumnIndex < $endColumnIndex) {
+                while ($currentRow <= $endRow) {
+                    $returnValue[] = $this->lookupColumnString($currentColumnIndex) . $currentRow;
+                    ++$currentRow;
+                }
+                ++$currentColumnIndex;
+                $currentRow = $startRow;
+            }
+        }
+        $this->extractedCellReferences = $returnValue;
+
+        return $returnValue;
+    }
+
+    public function mergeRangesInCollection(array $coordinateCollection): array
+    {
+        $this->mergedRangeMap = [];
+        $hashedValues = [];
+        $mergedCoordCollection = [];
+
+        foreach ($coordinateCollection as $coord => $value) {
+            $this->activeRangeSpec = (string) $coord;
+            if ($this->detectCoordinateIsRange($coord)) {
+                $mergedCoordCollection[$coord] = $value;
+
+                continue;
+            }
+
+            [$column, $row] = $this->parseCoordinateFromString($coord);
+            $row = (int) (ltrim($row, '$'));
+            $hashCode = $column . '-' . ((is_object($value) && method_exists($value, 'getHashCode')) ? $value->getHashCode() : $value);
+
+            if (!isset($hashedValues[$hashCode])) {
+                $hashedValues[$hashCode] = (object) [
+                    'value' => $value,
+                    'col' => $column,
+                    'rows' => [$row],
+                ];
+            } else {
+                $hashedValues[$hashCode]->rows[] = $row;
+            }
+        }
+
+        ksort($hashedValues);
+
+        foreach ($hashedValues as $hashedValue) {
+            sort($hashedValue->rows);
+            $rowStart = null;
+            $rowEnd = null;
+            $ranges = [];
+
+            foreach ($hashedValue->rows as $row) {
+                if ($rowStart === null) {
+                    $rowStart = $row;
+                    $rowEnd = $row;
+                } elseif ($rowEnd === $row - 1) {
+                    $rowEnd = $row;
+                } else {
+                    if ($rowStart == $rowEnd) {
+                        $ranges[] = $hashedValue->col . $rowStart;
+                    } else {
+                        $ranges[] = $hashedValue->col . $rowStart . ':' . $hashedValue->col . $rowEnd;
+                    }
+
+                    $rowStart = $row;
+                    $rowEnd = $row;
+                }
+            }
+
+            if ($rowStart !== null) {
+                if ($rowStart == $rowEnd) {
+                    $ranges[] = $hashedValue->col . $rowStart;
+                } else {
+                    $ranges[] = $hashedValue->col . $rowStart . ':' . $hashedValue->col . $rowEnd;
+                }
+            }
+
+            foreach ($ranges as $range) {
+                $mergedCoordCollection[$range] = $hashedValue->value;
+            }
+        }
+        $this->mergedRangeMap = $mergedCoordCollection;
+
+        return $mergedCoordCollection;
+    }
+
+    public function getCellBlocksFromRangeString($rangeString): array
+    {
+        $this->activeRangeSpec = str_replace('$', '', strtoupper((string) $rangeString));
+        $tokens = preg_split('/([ ,])/', $this->activeRangeSpec, -1, PREG_SPLIT_DELIM_CAPTURE);
+        $split = array_chunk($tokens, 2);
+        $ranges = array_column($split, 0);
+        $operators = array_column($split, 1);
+        $this->extractedCellReferences = $ranges;
+
+        return [$ranges, $operators];
+    }
+
+    public function validateCellRangeBlock($cellBlock, $startColumnIndex, $endColumnIndex, $currentRow, $endRow): void
+    {
+        $this->activeRangeSpec = (string) $cellBlock;
+        $this->rangeBoundaryStart = [$startColumnIndex, $currentRow];
+        $this->rangeBoundaryEnd = [$endColumnIndex, $endRow];
+        if ($startColumnIndex >= $endColumnIndex || $currentRow > $endRow) {
+            throw new SpreadsheetException('Invalid range: "' . $cellBlock . '"');
+        }
+    }
+
+    public function scanDoubleQuotedFormulaString(string $formula, int $index, string $value): array
+    {
+        $this->formulaBuffer = $formula;
+        $this->formulaIndex = $index;
+        $this->formulaInString = true;
+        $formulaLength = strlen($formula);
+        $token = null;
+        if ($formula[$index] == '"') {
+            if ((($index + 2) <= $formulaLength) && ($formula[$index + 1] == '"')) {
+                $value .= '"';
+                ++$index;
+            } else {
+                $this->formulaInString = false;
+                $token = $value;
+                $value = '';
+            }
+        } else {
+            $value .= $formula[$index];
+        }
+        ++$index;
+        $this->formulaIndex = $index;
+        $this->formulaTokenAccumulator = ['value' => $value, 'token' => $token];
+
+        return [
+            'index' => $index,
+            'value' => $value,
+            'inString' => $this->formulaInString,
+            'token' => $token,
+        ];
+    }
+
+    public function scanSingleQuotedFormulaPath(string $formula, int $index, string $value): array
+    {
+        $this->formulaBuffer = $formula;
+        $this->formulaIndex = $index;
+        $this->formulaInPath = true;
+        $formulaLength = strlen($formula);
+        if ($formula[$index] == "'") {
+            if ((($index + 2) <= $formulaLength) && ($formula[$index + 1] == "'")) {
+                $value .= "'";
+                ++$index;
+            } else {
+                $this->formulaInPath = false;
+            }
+        } else {
+            $value .= $formula[$index];
+        }
+        ++$index;
+        $this->formulaIndex = $index;
+        $this->formulaTokenAccumulator = ['value' => $value];
+
+        return [
+            'index' => $index,
+            'value' => $value,
+            'inPath' => $this->formulaInPath,
+        ];
+    }
+
+    public function scanBracketedFormulaRange(string $formula, int $index, string $value): array
+    {
+        $this->formulaBuffer = $formula;
+        $this->formulaIndex = $index;
+        $this->formulaInRange = true;
+        if ($formula[$index] == ']') {
+            $this->formulaInRange = false;
+        }
+        $value .= $formula[$index];
+        ++$index;
+        $this->formulaIndex = $index;
+        $this->formulaTokenAccumulator = ['value' => $value];
+
+        return [
+            'index' => $index,
+            'value' => $value,
