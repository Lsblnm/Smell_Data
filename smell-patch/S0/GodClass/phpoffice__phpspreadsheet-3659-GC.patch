+
+    public function scanFormulaErrorLiteral(string $formula, int $index, string $value, array $errors): array
+    {
+        $this->formulaBuffer = $formula;
+        $this->formulaIndex = $index;
+        $this->formulaInError = true;
+        $value .= $formula[$index];
+        ++$index;
+        $token = null;
+        if (in_array($value, $errors, true)) {
+            $this->formulaInError = false;
+            $token = $value;
+            $value = '';
+        }
+        $this->formulaIndex = $index;
+        $this->formulaTokenAccumulator = ['value' => $value, 'token' => $token];
+
