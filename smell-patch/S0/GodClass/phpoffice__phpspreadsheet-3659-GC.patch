+
+    public function classifyScientificNotation(string $formula, int $index, string $value): array
+    {
+        $this->formulaBuffer = $formula;
+        $this->formulaIndex = $index;
+        $consumed = false;
+        if (strpos('+-', $formula[$index]) !== false) {
+            if (strlen($value) > 1) {
+                if (preg_match('/^[1-9]{1}(\\.\\d+)?E{1}$/', $formula[$index]) != 0) {
+                    $value .= $formula[$index];
+                    ++$index;
+                    $consumed = true;
+                }
+            }
+        }
+        $this->formulaIndex = $index;
+        $this->formulaParseState['scientific'] = $consumed;
+        $this->formulaTokenAccumulator = ['value' => $value];
+
+        return [
+            'index' => $index,
+            'value' => $value,
+            'consumed' => $consumed,
+        ];
+    }
+
+    public function classifyInfixMinus(string $tokenType, string $tokenSubType, string $tokenValue, int $position, ?string $previousType, ?string $previousSubType): array
+    {
+        $this->formulaParseState = [
+            'type' => $tokenType,
+            'subtype' => $tokenSubType,
+            'value' => $tokenValue,
+        ];
+        $this->formulaTokenAccumulator = $this->formulaParseState;
+        $this->formulaIndex = $position;
+        if ($tokenType == 'OperatorInfix' && $tokenValue == '-') {
+            if ($position == 0) {
+                return ['action' => 'keep', 'type' => 'OperatorPrefix', 'subtype' => $tokenSubType, 'value' => $tokenValue];
+            }
+            if (
+                (($previousType == 'Function') && ($previousSubType == 'Stop')) ||
+                (($previousType == 'Subexpression') && ($previousSubType == 'Stop')) ||
+                ($previousType == 'OperatorPostfix') ||
+                ($previousType == 'Operand')
+            ) {
+                return ['action' => 'keep', 'type' => $tokenType, 'subtype' => 'Math', 'value' => $tokenValue];
+            }
+
+            return ['action' => 'keep', 'type' => 'OperatorPrefix', 'subtype' => $tokenSubType, 'value' => $tokenValue];
+        }
+
+        return ['action' => 'continue', 'type' => $tokenType, 'subtype' => $tokenSubType, 'value' => $tokenValue];
+    }
+
+    public function classifyInfixPlus(string $tokenType, string $tokenSubType, string $tokenValue, int $position, ?string $previousType, ?string $previousSubType): array
+    {
+        $this->formulaParseState = [
+            'type' => $tokenType,
+            'subtype' => $tokenSubType,
+            'value' => $tokenValue,
+        ];
+        $this->formulaTokenAccumulator = $this->formulaParseState;
+        $this->formulaIndex = $position;
+        if ($tokenType == 'OperatorInfix' && $tokenValue == '+') {
+            if ($position == 0) {
+                return ['action' => 'skip', 'type' => $tokenType, 'subtype' => $tokenSubType, 'value' => $tokenValue];
+            }
+            if (
+                (($previousType == 'Function') && ($previousSubType == 'Stop')) ||
+                (($previousType == 'Subexpression') && ($previousSubType == 'Stop')) ||
+                ($previousType == 'OperatorPostfix') ||
+                ($previousType == 'Operand')
+            ) {
+                return ['action' => 'keep', 'type' => $tokenType, 'subtype' => 'Math', 'value' => $tokenValue];
+            }
+
+            return ['action' => 'skip', 'type' => $tokenType, 'subtype' => $tokenSubType, 'value' => $tokenValue];
+        }
+
+        return ['action' => 'continue', 'type' => $tokenType, 'subtype' => $tokenSubType, 'value' => $tokenValue];
+    }
+
+    public function classifyComparatorOperator(string $tokenType, string $tokenSubType, string $tokenValue): array
+    {
+        $this->formulaParseState = [
+            'type' => $tokenType,
+            'subtype' => $tokenSubType,
+            'value' => $tokenValue,
+        ];
+        $this->formulaTokenAccumulator = $this->formulaParseState;
+        $this->formulaBuffer = $tokenValue;
+        if ($tokenType == 'OperatorInfix' && $tokenSubType == 'Nothing') {
+            if (strpos('<>=', substr($tokenValue, 0, 1)) !== false) {
+                return ['action' => 'keep', 'type' => $tokenType, 'subtype' => 'Logical', 'value' => $tokenValue];
+            }
+            if ($tokenValue == '&') {
+                return ['action' => 'keep', 'type' => $tokenType, 'subtype' => 'Concatenation', 'value' => $tokenValue];
+            }
+
+            return ['action' => 'keep', 'type' => $tokenType, 'subtype' => 'Math', 'value' => $tokenValue];
+        }
+
+        return ['action' => 'continue', 'type' => $tokenType, 'subtype' => $tokenSubType, 'value' => $tokenValue];
+    }
+
+    public function classifyOperandSubtype(string $tokenType, string $tokenSubType, string $tokenValue): array
+    {
+        $this->formulaParseState = [
+            'type' => $tokenType,
+            'subtype' => $tokenSubType,
+            'value' => $tokenValue,
+        ];
+        $this->formulaTokenAccumulator = $this->formulaParseState;
+        $this->formulaBuffer = $tokenValue;
+        if ($tokenType == 'Operand' && $tokenSubType == 'Nothing') {
+            if (!is_numeric($tokenValue)) {
+                if (strtoupper($tokenValue) == 'TRUE' || strtoupper($tokenValue) == 'FALSE') {
+                    return ['action' => 'keep', 'type' => $tokenType, 'subtype' => 'Logical', 'value' => $tokenValue];
+                }
+
+                return ['action' => 'keep', 'type' => $tokenType, 'subtype' => 'Range', 'value' => $tokenValue];
+            }
+
+            return ['action' => 'keep', 'type' => $tokenType, 'subtype' => 'Number', 'value' => $tokenValue];
+        }
+
+        return ['action' => 'continue', 'type' => $tokenType, 'subtype' => $tokenSubType, 'value' => $tokenValue];
+    }
+
+    public function stripFunctionAtPrefix(string $tokenType, string $tokenSubType, string $tokenValue): array
+    {
+        $this->formulaParseState = [
+            'type' => $tokenType,
+            'subtype' => $tokenSubType,
+            'value' => $tokenValue,
+        ];
+        $this->formulaTokenAccumulator = $this->formulaParseState;
+        $this->formulaBuffer = $tokenValue;
+        if ($tokenType == 'Function') {
+            if (strlen($tokenValue) > 0) {
+                if (substr($tokenValue, 0, 1) == '@') {
+                    $tokenValue = substr($tokenValue, 1);
+                    $this->formulaParseState['value'] = $tokenValue;
+                    $this->formulaBuffer = $tokenValue;
+                }
+            }
+        }
+
+        return ['action' => 'keep', 'type' => $tokenType, 'subtype' => $tokenSubType, 'value' => $tokenValue];
+    }
+
+    public function classifyFormulaToken(
+        string $tokenType,
+        string $tokenSubType,
+        string $tokenValue,
+        int $position,
+        ?string $previousType,
+        ?string $previousSubType
+    ): array {
+        $this->formulaIndex = $position;
+        $this->formulaBuffer = $tokenValue;
+        $minus = $this->classifyInfixMinus($tokenType, $tokenSubType, $tokenValue, $position, $previousType, $previousSubType);
+        if ($minus['action'] !== 'continue') {
+            return $minus;
+        }
+        $plus = $this->classifyInfixPlus($tokenType, $tokenSubType, $tokenValue, $position, $previousType, $previousSubType);
+        if ($plus['action'] !== 'continue') {
+            return $plus;
+        }
+        $comparator = $this->classifyComparatorOperator($tokenType, $tokenSubType, $tokenValue);
+        if ($comparator['action'] !== 'continue') {
+            return $comparator;
+        }
+        $operand = $this->classifyOperandSubtype($tokenType, $tokenSubType, $tokenValue);
+        if ($operand['action'] !== 'continue') {
+            return $operand;
+        }
+
+        return $this->stripFunctionAtPrefix($tokenType, $tokenSubType, $tokenValue);
+    }
+
+    public function resetFormulaScanner(string $formula): void
+    {
+        $this->formulaBuffer = $formula;
+        $this->formulaIndex = 0;
+        $this->formulaParseState = [];
+        $this->formulaTokenAccumulator = [];
+        $this->formulaInString = false;
+        $this->formulaInPath = false;
+        $this->formulaInRange = false;
+        $this->formulaInError = false;
+    }
+
+    public function accumulateFormulaValue(string $formula, int $index, string $value): array
+    {
+        $this->formulaBuffer = $formula;
+        $this->formulaIndex = $index;
+        $value .= $formula[$index];
+        ++$index;
+        $this->formulaIndex = $index;
+        $this->formulaTokenAccumulator = ['value' => $value];
+
+        return ['index' => $index, 'value' => $value];
+    }
