+    public static <T> void postComplete(Subscriber<? super T> actual,
+                                        Queue<T> queue,
+                                        AtomicLong state,
+                                        BooleanSupplier isCancelled) {
+
+        if (queue.isEmpty()) {
+            actual.onComplete();
+            return;
+        }
+
+        if (postCompleteDrain(state.get(), actual, queue, state, isCancelled)) {
+            return;
+        }
+
+        for (; ; ) {
+            long r = state.get();
