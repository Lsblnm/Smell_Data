+                    postCompleteDrain(n | COMPLETED_MASK, actual, queue, state, isCancelled);
+
+                    return true;
+                }
+                // (active, r) -> (active, r + n) transition then continue with requesting from upstream
+                return false;
+            }
+        }
+
+    }
