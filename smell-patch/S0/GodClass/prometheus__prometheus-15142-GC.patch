+func (a *headAppender) resolveOrCreateSeries(hash uint64, lset labels.Labels) (*memSeries, bool, error) {
+	s := a.seriesByHash(hash, lset)
+	if s != nil {
+		return s, false, nil
+	}
+	id := chunks.HeadSeriesRef(a.head.lastSeriesID.Inc())
+	return a.resolveOrCreateSeriesWithID(id, hash, lset)
+}
+
+func (a *headAppender) resolveOrCreateSeriesWithID(id chunks.HeadSeriesRef, hash uint64, lset labels.Labels) (*memSeries, bool, error) {
+	s, created, err := a.head.series.getOrSet(hash, lset, func() *memSeries {
+		shardHash := uint64(0)
+		if a.head.opts.EnableSharding {
+			shardHash = labels.StableHash(lset)
+		}
+		return newMemSeries(lset, id, shardHash, a.head.opts.IsolationDisabled)
+	})
+	if err != nil {
+		return nil, false, err
+	}
+	if !created {
+		return s, false, nil
+	}
+	a.head.metrics.seriesCreated.Inc()
+	a.head.numSeries.Inc()
+	a.head.postings.Add(storage.SeriesRef(id), lset)
+	return s, true, nil
+}
