+// Rollback removes the samples and exemplars from headAppender and writes any series to WAL.
+func (a *headAppender) Rollback() (err error) {
+	if a.appenderAlreadyClosed() {
+		return a.appenderClosedError()
+	}
+	defer a.markAppenderClosed()
+	defer a.decrementActiveAppenders()
+	defer a.closeIsolation()
+	defer a.releaseSeriesBuffer(a.sampleSeries)
+
+	for i := range a.samples {
+		a.clearPendingCommit(a.pendingFloatSeries(i), a.isolationCleanupBound())
+	}
+	for i := range a.histograms {
+		a.clearPendingCommit(a.pendingHistogramSeries(i), a.isolationCleanupBound())
+	}
+	a.releaseAppendBuffer(a.samples)
+	a.releaseExemplarBuffer(a.exemplars)
+	a.releaseHistogramBuffer(a.histograms)
+	a.releaseFloatHistogramBuffer(a.floatHistograms)
+	a.releaseMetadataBuffer(a.metadata)
+	a.resetRollbackBuffers()
+
+	// Series are created in the head memory regardless of rollback. Thus we have
+	// to log them to the WAL in any case.
+	return a.log()
+}
