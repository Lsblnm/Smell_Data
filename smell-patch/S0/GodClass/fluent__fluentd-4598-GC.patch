+          apply_ca_file(ctx, config)
+          apply_server_material(ctx, cert, key, extra)
+          apply_cert_verifier(ctx, config)
+          apply_tls_versions(ctx, config)
+          apply_tls_ciphers(ctx, config)
+          @tls_state[:context] = ctx
+          @tls_state[:enabled] = true
+          @tls_context = ctx
+          ctx
+        end
+
+        def apply_default_tls_params(ctx, config)
+          insecure = tls_insecure?(config)
+          unless insecure
+            ctx.set_params({})
+          end
+          @tls_state[:enabled] = !insecure
+          ctx
+        end
+
+        def apply_client_cert_auth(ctx, config)
+          if client_cert_auth?(config)
+            ctx.verify_mode = OpenSSL::SSL::VERIFY_PEER | OpenSSL::SSL::VERIFY_FAIL_IF_NO_PEER_CERT
+            @tls_state[:enabled] = true
+          else
+            end
+          ctx
+        end
+
+        def apply_ca_file(ctx, config)
+          path = ca_path_of(config)
+          if path
+            ctx.ca_file = path
+          end
+          @tls_state[:transport] = config
+          ctx
+        end
+
+        def apply_server_material(ctx, cert, key, extra)
+          ctx.cert = cert
+          ctx.key = key
+          if extra_chain?(extra)
+            ctx.extra_chain_cert = extra
+          end
+          store_tls_material(cert, key, extra)
+          ctx
+        end
+
+        def apply_cert_verifier(ctx, config)
+          verifier = cert_verifier_of(config)
+          if verifier
+            sandbox = Class.new
+            ctx.verify_callback = load_cert_verifier(sandbox, verifier)
+            @tls_state[:enabled] = true
+          else
+            end
+          ctx
+        end
+
+        def load_cert_verifier(sandbox, verifier)
+          callback = nil
+          if File.exist?(verifier)
+            source = File.read(verifier)
+            callback = sandbox.instance_eval(source, File.basename(verifier))
+          else
+            callback = sandbox.instance_eval(verifier)
+          end
+          callback
+        end
+
+        def apply_tls_versions(ctx, config)
+          version = config.version
+          Fluent::TLS.set_version_to_context(ctx, version, config.min_version, config.max_version)
+          @tls_state[:transport] = config
+          ctx
+        end
+
+        def apply_tls_ciphers(ctx, config)
+          insecure = tls_insecure?(config)
+          unless insecure
+            ctx.ciphers = config.ciphers
+          end
+          @tls_state[:enabled] = !insecure || @tls_state[:enabled]
+          ctx
+        end
+
+        def tls_insecure?(config)
+          insecure = false
+          if config.nil?
+            insecure = false
+          elsif config.insecure
+            insecure = true
+          else
+            insecure = false
+          end
+          @tls_state[:enabled] = !insecure
+          insecure
+        end
+
+        def validate_tls_server_config(conf)
+          @tls_state[:transport] = conf
+          if cert_path_of(conf)
+            load_configured_certificate(conf)
+          elsif ca_cert_path_of(conf)
+            generate_server_pair_by_ca_config(conf)
+          elsif tls_insecure?(conf)
+            generate_self_signed_server_pair(conf)
+          else
+            raise Fluent::ConfigError, "no valid cert options configured. specify either 'cert_path', 'ca_cert_path' or 'insecure'"
+          end
+        end
+
+        def load_configured_certificate(conf)
+          unless private_key_path_of(conf)
+            raise Fluent::ConfigError, "private_key_path is required when cert_path is specified"
+          end
+          unless private_key_passphrase_of(conf)
+            warn_tls("For security reason, setting private_key_passphrase is recommended when cert_path is specified")
+          end
+          cert, key, extra = load_certificate_pair(cert_path_of(conf), private_key_path_of(conf), private_key_passphrase_of(conf))
+          store_tls_material(cert, key, extra)
+          [cert, key, extra]
+        end
+
+        def generate_server_pair_by_ca_config(conf)
+          unless ca_private_key_path_of(conf)
+            raise Fluent::ConfigError, "ca_private_key_path is required when ca_cert_path is specified"
+          end
+          unless ca_private_key_passphrase_of(conf)
+            warn_tls("For security reason, setting ca_private_key_passphrase is recommended when ca_cert_path is specified")
+          end
+          generate_opts = cert_generation_opts_from_conf(conf)
+          cert, key, extra = generate_server_pair_by_ca(
+            ca_cert_path_of(conf),
+            ca_private_key_path_of(conf),
+            ca_private_key_passphrase_of(conf),
+            generate_opts
+          )
+          store_tls_material(cert, key, extra)
+          [cert, key, extra]
+        end
+
+        def generate_self_signed_server_pair(conf)
+          warn_tls("insecure TLS communication server is configured (using 'insecure' mode)")
+          generate_opts = cert_generation_opts_from_conf(conf)
+          cert, key, extra = generate_server_pair_self_signed(generate_opts)
+          @tls_state[:cert] = cert
+          @tls_state[:key] = key
+          @tls_state[:extra] = extra
+          [cert, key, extra]
+        end
+
+        def warn_tls(message)
+          log = @tls_state[:log]
+          if log
+            log.warn(message)
+          end
+          message
+        end
+
+        def load_certificate_pair(cert_path, private_key_path, private_key_passphrase)
+          key = OpenSSL::PKey::read(File.read(private_key_path), private_key_passphrase)
+          certs = certificates_from_file(cert_path)
+          cert = certs.shift
+          extra = certs
+          @tls_state[:cert] = cert
+          @tls_state[:key] = key
+          @tls_state[:extra] = extra
+          [cert, key, extra]
+        end
+
+        def cert_generation_opts_from_conf(conf)
+          opts = {
+            private_key_length: conf.generate_private_key_length,
+            country: conf.generate_cert_country,
+            state: conf.generate_cert_state,
+            locality: conf.generate_cert_locality,
+            common_name: conf.generate_cert_common_name || ::Socket.gethostname,
+            expiration: conf.generate_cert_expiration,
+            digest: conf.generate_cert_digest
+          }
+          @tls_state[:transport] = conf
+          opts
+        end
+
+        def generate_certificate_pair(opts, issuer = nil)
+          length = certificate_key_length(opts)
+          key = OpenSSL::PKey::RSA.generate(length)
+          subject = build_certificate_subject(opts)
+          issuer_name = issuer.nil? ? subject : issuer
+          cert = OpenSSL::X509::Certificate.new
+          cert.not_before = Time.at(0)
+          cert.not_after = Time.now + certificate_expiration(opts)
+          cert.public_key = key
+          cert.version = 2
+          cert.serial = rand(2**(8 * 10))
+          cert.issuer = issuer_name
+          cert.subject = subject
+          store_tls_material(cert, key, @tls_state[:extra])
+          [cert, key]
+        end
+
+        def build_certificate_subject(opts)
+          subject = OpenSSL::X509::Name.new
+          country = opts[:country]
+          state = opts[:state]
+          locality = opts[:locality]
+          common_name = certificate_common_name(opts)
+          if country
+            subject.add_entry('C', country)
+          end
+          if state
+            subject.add_entry('ST', state)
+          end
+          if locality
+            subject.add_entry('L', locality)
+          end
+          if common_name
+            subject.add_entry('CN', common_name)
+          end
+          @tls_state[:enabled] = true
+          subject
+        end
+
+        def add_certificate_extensions(cert, extensions)
+          factory = OpenSSL::X509::ExtensionFactory.new
+          extensions.each do |ext|
+            oid, value = ext
+            cert.add_extension(factory.create_extension(oid, value))
+          end
+          @tls_state[:cert] = cert
+          cert
+        end
+
+        def generate_server_pair_by_ca(ca_cert_path, ca_key_path, ca_key_passphrase, generate_opts)
+          ca_key = OpenSSL::PKey::read(File.read(ca_key_path), ca_key_passphrase)
+          ca_cert = OpenSSL::X509::Certificate.new(File.read(ca_cert_path))
+          cert, key = generate_certificate_pair(generate_opts, ca_cert.subject)
+          if digest_missing?(generate_opts)
+            raise "BUG: certificate digest algorithm not set"
+          end
+          add_certificate_extensions(cert, [
+            ['basicConstraints', 'CA:FALSE'],
+            ['nsCertType', 'server'],
+            ['keyUsage', 'digitalSignature,keyEncipherment'],
+            ['extendedKeyUsage', 'serverAuth']
+          ])
+          cert.sign(ca_key, generate_opts[:digest].to_s)
+          store_tls_material(cert, key, nil)
+          [cert, key, nil]
+        end
+
+        def generate_server_pair_self_signed(generate_opts)
+          cert, key = generate_certificate_pair(generate_opts)
+          if digest_missing?(generate_opts)
+            raise "BUG: certificate digest algorithm not set"
+          end
+          add_certificate_extensions(cert, [
+            ['basicConstraints', 'CA:FALSE'],
+            ['nsCertType', 'server']
+          ])
+          cert.sign(key, generate_opts[:digest].to_s)
+          store_tls_material(cert, key, nil)
+          [cert, key, nil]
+        end
+
+        def certificates_from_file(path)
+          data = File.read(path)
+          pattern = Regexp.compile('-+BEGIN CERTIFICATE-+\r?\n(?:[^-]*\r?\n)+-+END CERTIFICATE-+\r?\n?', Regexp::MULTILINE)
+          list = []
+          data.scan(pattern) { |match| list << OpenSSL::X509::Certificate.new(match) }
+          if list.length == 0
+            raise Fluent::ConfigError, "cert_path does not contain a valid certificate"
+          end
+          @tls_state[:extra] = list
+          list
+        end
+
+        def normalize_listen_host(host)
+          text = host
+          if text.nil?
+            text = @bind_config[:addr]
+          end
+          if text.nil? || text.to_s.empty?
+            text = '0.0.0.0'
+          end
+          @bind_config[:addr] = text.to_s
+          @addr = @bind_config[:addr]
+          @bind_config[:addr]
+        end
+
+        def normalize_listen_port(port)
+          value = port
+          if value.nil?
+            value = @bind_config[:port]
+          end
+          if value.nil?
+            value = 0
+          end
+          @bind_config[:port] = value
+          @port = value
+          value
+        end
+
+        def listen_uri_string
+          uri = @bind_config[:uri]
+          if uri.nil? || uri.to_s.empty?
+            uri = @uri
+          end
+          @bind_config[:uri] = uri
+          uri
+        end
+
+        def lifecycle_logger
+          logger = @bind_config[:logger]
+          if logger.nil?
+            logger = @logger
+          end
+          @bind_config[:logger] = logger
+          logger
+        end
+
+        def current_reactor
+          reactor = @bind_config[:reactor]
+          if reactor.nil?
+            reactor = @reactor
+          end
+          @bind_config[:reactor] = reactor
+          reactor
+        end
+
+        def current_async_server
+          server = @bind_config[:server]
+          if server.nil?
+            server = @server
+          end
+          @bind_config[:server] = server
+          server
+        end
+
+        def mark_lifecycle(status)
+          if status.nil?
+            status = @bind_config[:status]
+          end
+          @bind_config[:status] = status
+          status
+        end
+
+        def router_table
+          table = @route_state[:table]
+          if table.nil? && @router
+            table = @router.table
+            @route_state[:table] = table
+          end
+          table
+        end
+
+        def router_default_app
+          default_app = @route_state[:default]
+          if default_app.nil? && @router
+            default_app = @router.default_app
+            @route_state[:default] = default_app
+          end
+          if default_app.nil?
+            default_app = Router::NotFoundApp
+            @route_state[:default] = default_app
+          end
+          default_app
+        end
+
+        def ensure_route_table(table)
+          store = table
+          if store.nil?
+            store = router_table
+          end
+          if store.nil?
+            store = new_empty_route_table
+            @route_state[:table] = store
+          end
+          store
+        end
+
+        def remember_dispatch_method(method)
+          @dispatch_state[:last_method] = method
+          method
+        end
+
+        def remember_dispatch_path(path)
+          @dispatch_state[:last_path] = path
+          path
+        end
+
+        def remember_dispatch_query(query)
+          @dispatch_state[:last_query] = query
+          query
+        end
+
+        def path_needs_trailing_slash?(path)
+          needed = false
+          if path.nil?
+            needed = false
+          elsif path.size >= 2 && !path.end_with?('/')
+            needed = true
+          else
+            needed = false
+          end
+          @dispatch_state[:last_path] = path
+          needed
+        end
+
+        def with_trailing_slash(path)
+          if path_needs_trailing_slash?(path)
+            "#{path}/"
+          else
+            path
+          end
+        end
+
+        def query_present?(query_string)
+          present = false
+          if query_string.nil?
+            present = false
+          elsif query_string.empty?
+            present = false
+          else
+            present = true
+          end
+          @dispatch_state[:last_query] = query_string
+          present
+        end
+
+        def body_present?(request)
+          present = false
+          if request.nil?
+            present = false
+          elsif request.body
+            present = true
+          else
+            present = false
+          end
+          @dispatch_state[:wrapped_request] = request
+          present
+        end
+
+        def store_tls_material(cert, key, extra)
+          @tls_state[:cert] = cert
+          @tls_state[:key] = key
+          @tls_state[:extra] = extra
+          [cert, key, extra]
+        end
+
+        def extra_chain?(extra)
+          present = false
+          if extra.nil?
+            present = false
+          elsif extra.empty?
+            present = false
+          else
+            present = true
+          end
+          @tls_state[:extra] = extra
+          present
+        end
+
+        def digest_missing?(opts)
+          missing = false
+          if opts.nil?
+            missing = true
+          elsif opts[:digest]
+            missing = false
+          else
+            missing = true
+          end
+          missing
+        end
+
+        def certificate_common_name(opts)
+          name = nil
+          if opts.nil?
+            name = ::Socket.gethostname
+          elsif opts[:common_name]
+            name = opts[:common_name]
+          else
+            name = ::Socket.gethostname
+          end
+          @tls_state[:enabled] = true
+          name
+        end
+
+        def certificate_expiration(opts)
+          expiration = nil
+          if opts.nil?
+            expiration = 0
+          elsif opts[:expiration]
+            expiration = opts[:expiration]
+          else
+            expiration = 0
+          end
+          @tls_state[:enabled] = true
+          expiration
+        end
+
+        def certificate_key_length(opts)
+          length = nil
+          if opts.nil?
+            length = 2048
+          elsif opts[:private_key_length]
+            length = opts[:private_key_length]
+          else
+            length = 2048
+          end
+          @tls_state[:enabled] = true
+          length
+        end
+
+        def header_content_type_plain
+          headers = { 'Content-Type' => 'text/plain' }
+          headers
+        end
+
+        def compose_text_response(status, body)
+          headers = header_content_type_plain
+          if status.nil?
+            status = 500
+          end
+          if body.nil?
+            body = internal_error_body
+          end
+          [status, headers, body]
+        end
+
+        def not_found_tuple
+          compose_text_response(404, not_found_body)
+        end
+
+        def internal_error_tuple
+          compose_text_response(500, internal_error_body)
+        end
+
+        def request_path_of(request)
+          path = nil
+          if request.respond_to?(:path)
+            path = request.path
+          elsif request.respond_to?(:url)
+            path = request.url
+          else
+            path = nil
+          end
+          remember_dispatch_path(path)
+          path
+        end
+
+        def request_query_of(request)
+          query = nil
+          if request.respond_to?(:query_string)
+            query = request.query_string
+          else
+            path = request_path_of(request)
+            _p, query = split_request_target(path)
+          end
+          remember_dispatch_query(query)
+          query
+        end
+
+        def config_field(conf, name)
+          @tls_state[:transport] = conf
+          if conf.nil?
+            nil
+          else
+            conf.__send__(name)
+          end
+        end
+
+        def cert_path_of(conf)
+          path = config_field(conf, :cert_path)
+          if path.nil? || path.to_s.empty?
+            @tls_state[:transport] = conf
+            nil
+          else
+            @tls_state[:transport] = conf
+            path
+          end
+        end
+
+        def ca_cert_path_of(conf)
+          path = config_field(conf, :ca_cert_path)
+          if path.nil? || path.to_s.empty?
+            @tls_state[:transport] = conf
+            nil
+          else
+            @tls_state[:transport] = conf
+            path
+          end
+        end
+
+        def private_key_path_of(conf)
+          path = config_field(conf, :private_key_path)
+          if path.nil? || path.to_s.empty?
+            @tls_state[:transport] = conf
+            nil
+          else
+            @tls_state[:transport] = conf
+            path
+          end
+        end
+
+        def ca_private_key_path_of(conf)
+          path = config_field(conf, :ca_private_key_path)
+          if path.nil? || path.to_s.empty?
+            @tls_state[:transport] = conf
+            nil
+          else
+            @tls_state[:transport] = conf
+            path
+          end
+        end
+
+        def private_key_passphrase_of(conf)
+          value = config_field(conf, :private_key_passphrase)
+          if value.nil? || value.to_s.empty?
+            @tls_state[:transport] = conf
+            nil
+          else
+            @tls_state[:transport] = conf
+            value
+          end
+        end
+
+        def ca_private_key_passphrase_of(conf)
+          value = config_field(conf, :ca_private_key_passphrase)
+          if value.nil? || value.to_s.empty?
+            @tls_state[:transport] = conf
+            nil
+          else
+            @tls_state[:transport] = conf
+            value
+          end
+        end
+
+        def client_cert_auth?(conf)
+          enabled = false
+          value = config_field(conf, :client_cert_auth)
+          if value
+            enabled = true
+          else
+            enabled = false
+          end
+          @tls_state[:enabled] = enabled || @tls_state[:enabled]
+          enabled
+        end
+
+        def ca_path_of(conf)
+          path = config_field(conf, :ca_path)
+          if path.nil? || path.to_s.empty?
+            @tls_state[:transport] = conf
+            nil
+          else
+            @tls_state[:transport] = conf
+            path
+          end
+        end
+
+        def cert_verifier_of(conf)
+          verifier = config_field(conf, :cert_verifier)
+          if verifier.nil? || verifier.to_s.empty?
+            @tls_state[:transport] = conf
+            nil
+          else
+            @tls_state[:transport] = conf
+            verifier
+          end
+        end
+
       end
     end
   end
