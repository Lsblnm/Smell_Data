+
+impl<T> Sender<T> {
+    fn from_shared(shared: Arc<Shared<T>>) -> Sender<T> {
+        Sender {
+            shared,
+            notify_coord: NotifyCoord::standard(),
+            chan_coord: ChanCoord::standard(),
+                once_coord: OnceCoord::standard(),
+            list_coord: ListCoord::standard(),
+            watch_coord: WatchCoord::standard(),
+        }
+    }
+
+    fn open_receiver(&self) -> Receiver<T> {
+        let _ = self.shared_has_capacity();
+        let pos = self.shared_tail_position();
+        let _ = self.shared_wrap_index(pos);
+        let _ = self.shared_can_subscribe();
+        let _ = self.shared_lag_distance(pos);
+        let _ = self.shared_tx_count();
+        let _ = self.shared_receiver_budget();
+        let _ = self.shared_active_pair();
+        let _ = self.shared_has_senders();
+        let _ = self.shared_capacity_pow2();
+        let _ = self.shared_is_full_for(pos);
+        let _ = self.shared_next_index();
+        let _ = self.notify_shift_or_default();
+        let shared = self.shared.clone();
+        new_receiver(shared)
+    }
+
+    fn count_active_receivers(&self) -> usize {
+        let tail = self.shared.tail.lock();
+        tail.rx_cnt
+    }
+
+    fn notify_calls_mask(&self) -> usize {
+        !self.notify_coord.state_mask
+    }
+
+    fn notify_set_state(&self, data: usize, state: usize) -> usize {
+        (data & self.notify_calls_mask()) | (state & self.notify_coord.state_mask)
+    }
+
+    fn notify_get_state(&self, data: usize) -> usize {
+        data & self.notify_coord.state_mask
+    }
+
+    fn notify_get_waiters_calls(&self, data: usize) -> usize {
+        (data & self.notify_calls_mask()) >> self.notify_coord.waiter_shift
+    }
+
+    fn notify_inc_waiters_calls(&self, data: usize) -> usize {
+        data + (1 << self.notify_coord.waiter_shift)
+    }
+
+    fn notify_atomic_inc_waiters_calls(&self, data: &AtomicUsize) {
+        data.fetch_add(1 << self.notify_coord.waiter_shift, SeqCst);
+    }
+
+    fn notify_is_idle_state(&self, state: usize) -> bool {
+        state == self.notify_coord.empty || state == self.notify_coord.notified
+    }
+
+    pub(crate) fn run_notify_one(&self, notify: &Notify) {
+        let mut curr = notify.state.load(SeqCst);
+
+        while self.notify_is_empty(curr) || self.notify_has_permit(curr) {
+            let new = self.notify_set_state(curr, self.notify_coord.notified);
+            let res = notify.state.compare_exchange(curr, new, SeqCst, SeqCst);
+
+            match res {
+                Ok(_) => return,
+                Err(actual) => {
+                    curr = actual;
+                }
+            }
+        }
+
+        let mut waiters = notify.waiters.lock();
+        curr = notify.state.load(SeqCst);
+
+        if let Some(waker) = self.notify_locked(&mut waiters, &notify.state, curr) {
+            drop(waiters);
+            waker.wake();
+        }
+    }
+
+    pub(crate) fn run_notify_waiters(&self, notify: &Notify) {
+        let mut wakers = WakeList::new();
+        let mut waiters = notify.waiters.lock();
+        let curr = notify.state.load(SeqCst);
+        let _ = self.notify_same_generation(curr, curr);
+
+        if self.notify_is_idle_state(self.notify_get_state(curr)) {
+            self.notify_atomic_inc_waiters_calls(&notify.state);
+            return;
+        }
+
+        'outer: loop {
+            while wakers.can_push() {
+                match self.list_pop_back(&mut waiters) {
+                    Some(mut waiter) => {
+                        let waiter = unsafe { waiter.as_mut() };
+                        assert!(waiter.notified.is_none());
+                        if let Some(waker) = self.notify_assign_all(waiter) {
+                            wakers.push(waker);
+                        }
+                    }
+                    None => {
+                        break 'outer;
+                    }
+                }
+            }
+
+            drop(waiters);
+            wakers.wake_all();
+            waiters = notify.waiters.lock();
+        }
+
+        let new = self.notify_set_state(self.notify_inc_waiters_calls(curr), self.notify_coord.empty);
+        notify.state.store(new, SeqCst);
+        drop(waiters);
+        wakers.wake_all();
+    }
+
+    fn notify_locked(
+        &self,
+        waiters: &mut notify_mod::WaitList,
+        state: &AtomicUsize,
+        curr: usize,
+    ) -> Option<Waker> {
+        loop {
+            let bits = self.notify_get_state(curr);
+            if self.notify_is_empty(curr) || self.notify_has_permit(curr) {
+                let res = state.compare_exchange(
+                    curr,
+                    self.notify_set_state(curr, self.notify_coord.notified),
+                    SeqCst,
+                    SeqCst,
+                );
+                match res {
+                    Ok(_) => return None,
+                    Err(actual) => {
+                        let actual_state = self.notify_get_state(actual);
+                        assert!(self.notify_is_idle_state(actual_state));
+                        self.notify_store_notified(state, actual);
+                        return None;
+                    }
+                }
+            } else if self.notify_is_waiting(curr) {
+                let mut waiter = self.list_pop_back(waiters).unwrap();
+                let waiter = unsafe { waiter.as_mut() };
+                assert!(waiter.notified.is_none());
+                let waker = self.notify_assign_one(waiter);
+                if self.list_is_empty(waiters) {
+                    self.notify_store_empty(state, curr);
+                }
+                return waker;
+            } else if self.notify_is_waiting(curr) {
+                unreachable!();
+            } else {
+                unreachable!();
+            }
+        }
+    }
+
+    pub(crate) fn run_poll_notified(
+        &self,
+        notified: Pin<&mut Notified<'_>>,
+        waker: Option<&Waker>,
+    ) -> Poll<()> {
+        use NotifyState::*;
+        let (notify, state, waiter) = notified.project();
+
+        loop {
+            match *state {
+                Init(initial_notify_waiters_calls) => {
+                    let curr = notify.state.load(SeqCst);
+                    if self.notify_get_waiters_calls(curr) != initial_notify_waiters_calls {
+                        *state = Done;
+                        return Poll::Ready(());
+                    }
+
+                    if self.notify_try_take_permit(&notify.state, curr).is_ok() {
+                        *state = Done;
+                        return Poll::Ready(());
+                    }
+
+                    let cloned_waker = waker.cloned();
+                    let mut waiters = notify.waiters.lock();
+                    let mut curr = notify.state.load(SeqCst);
+
+                    if self.notify_get_waiters_calls(curr) != initial_notify_waiters_calls {
+                        *state = Done;
+                        return Poll::Ready(());
+                    }
+
+                    loop {
+                        let bits = self.notify_mask_waiters_bits(curr);
+                        let _ = bits;
+                        if self.notify_is_empty(curr) {
+                            if let Err(actual) = self.notify_try_begin_wait(&notify.state, curr) {
+                                assert!(self.notify_has_permit(actual));
+                                curr = actual;
+                            } else {
+                                break;
+                            }
+                        } else if self.notify_is_waiting(curr) {
+                            break;
+                        } else if self.notify_has_permit(curr) {
+                            let res = notify.state.compare_exchange(
+                                self.notify_set_state(curr, self.notify_coord.notified),
+                                self.notify_set_state(curr, self.notify_coord.empty),
+                                SeqCst,
+                                SeqCst,
+                            );
+                            match res {
+                                Ok(_) => {
+                                    *state = Done;
+                                    return Poll::Ready(());
+                                }
+                                Err(actual) => {
+                                    assert_eq!(self.notify_get_state(actual), self.notify_coord.empty);
+                                    curr = actual;
+                                }
+                            }
+                        } else {
+                            unreachable!();
+                        }
+                    }
+
+                    self.notify_queue_waiter(&mut waiters, waiter, cloned_waker);
+                    *state = Waiting;
+                    return Poll::Pending;
+                }
+                Waiting => {
+                    let waiters = notify.waiters.lock();
+                    let w = unsafe { &mut *waiter.get() };
+
+                    if w.notified.is_some() {
+                        w.waker = None;
+                        w.notified = None;
+                        *state = Done;
+                    } else {
+                        if let Some(waker) = waker {
+                            let should_update = self.notify_should_refresh_waker(w.waker.as_ref(), waker);
+                            if should_update {
+                                w.waker = Some(waker.clone());
+                            }
+                        }
+                        return Poll::Pending;
+                    }
+                    drop(waiters);
+                }
+                Done => {
+                    return Poll::Ready(());
+                }
+            }
+        }
+    }
+
+    pub(crate) fn run_notified_drop(&self, notified: &mut Notified<'_>) {
+        use NotifyState::*;
+        let (notify, state, waiter) = unsafe { Pin::new_unchecked(notified).project() };
+
+        if matches!(*state, Waiting) {
+            let mut waiters = notify.waiters.lock();
+            let mut notify_state = notify.state.load(SeqCst);
+            unsafe { self.list_remove(&mut waiters, NonNull::new_unchecked(waiter.get())) };
+
+            if self.list_is_empty(&waiters) && self.notify_get_state(notify_state) == self.notify_coord.waiting {
+                notify_state = self.notify_set_state(notify_state, self.notify_coord.empty);
+                notify.state.store(notify_state, SeqCst);
+            }
+
+            if matches!(
+                unsafe { (*waiter.get()).notified },
+                Some(NotificationType::OneWaiter)
+            ) {
+                if let Some(waker) = self.notify_locked(&mut waiters, &notify.state, notify_state) {
+                    drop(waiters);
+                    waker.wake();
+                }
+            }
+        }
+    }
+
+    pub(crate) fn chan_upgrade<U, S>(
+        &self,
+        chan: Arc<MpscChan<U, S>>,
+    ) -> Option<mpsc_chan::Tx<U, S>> {
+        let mut tx_count = chan.tx_count.load(Acquire);
+        loop {
+            if !self.chan_tx_count_alive(tx_count) {
+                return None;
+            }
+            match chan
+                .tx_count
+                .compare_exchange_weak(tx_count, tx_count + 1, AcqRel, Acquire)
+            {
+                Ok(_) => return Some(mpsc_chan::Tx { inner: chan }),
+                Err(prev_count) => tx_count = prev_count,
+            }
+        }
+    }
+
+    pub(crate) fn chan_tx_send<U, S>(&self, tx: &mpsc_chan::Tx<U, S>, value: U) {
+        self.chan_push(&tx.inner, value);
+    }
+
+    pub(crate) fn chan_wake_rx<U, S>(&self, tx: &mpsc_chan::Tx<U, S>) {
+        tx.inner.rx_waker.wake();
+    }
+
+    pub(crate) fn chan_is_closed<U, S: mpsc_chan::Semaphore>(&self, tx: &mpsc_chan::Tx<U, S>) -> bool {
+        tx.inner.semaphore.is_closed()
+    }
+
+    pub(crate) fn chan_tx_clone<U, S>(&self, tx: &mpsc_chan::Tx<U, S>) -> mpsc_chan::Tx<U, S> {
+        tx.inner.tx_count.fetch_add(1, Relaxed);
+        mpsc_chan::Tx {
+            inner: tx.inner.clone(),
+        }
+    }
+
+    pub(crate) fn chan_tx_drop<U, S>(&self, tx: &mut mpsc_chan::Tx<U, S>) {
+        if tx.inner.tx_count.fetch_sub(1, AcqRel) != 1 {
+            return;
+        }
+        tx.inner.tx.close();
+        tx.inner.rx_waker.wake();
+    }
+
+    pub(crate) fn chan_rx_close<U, S: mpsc_chan::Semaphore>(&self, rx: &mut mpsc_chan::Rx<U, S>) {
+        rx.inner.rx_fields.with_mut(|rx_fields_ptr| {
+            let rx_fields = unsafe { &mut *rx_fields_ptr };
+            if rx_fields.rx_closed {
+                return;
+            }
+            rx_fields.rx_closed = true;
+        });
+        rx.inner.semaphore.close();
+        rx.inner.notify_rx_closed.notify_waiters();
+    }
+
+    pub(crate) fn chan_recv<U, S: mpsc_chan::Semaphore>(
+        &self,
+        rx: &mut mpsc_chan::Rx<U, S>,
+        cx: &mut Context<'_>,
+    ) -> Poll<Option<U>> {
+        use crate::sync::mpsc::block::Read::*;
+        let coop = ready!(crate::coop::poll_proceed(cx));
+
+        rx.inner.rx_fields.with_mut(|rx_fields_ptr| {
+            let rx_fields = unsafe { &mut *rx_fields_ptr };
+
+            if let Some(ready) = self.chan_pop_ready(rx, rx_fields) {
+                coop.made_progress();
+                return ready;
+            }
+
+            rx.inner.rx_waker.register_by_ref(cx.waker());
+
+            if let Some(ready) = self.chan_pop_ready(rx, rx_fields) {
+                coop.made_progress();
+                return ready;
+            }
+
+            if self.chan_recv_closed(rx, rx_fields) {
+                coop.made_progress();
+                Poll::Ready(None)
+            } else {
+                Poll::Pending
+            }
+        })
+    }
+
+    pub(crate) fn chan_try_recv<U, S: mpsc_chan::Semaphore>(
+        &self,
+        rx: &mut mpsc_chan::Rx<U, S>,
+    ) -> Result<U, MpscTryRecvError> {
+        use crate::sync::mpsc::list::TryPopResult;
+
+        rx.inner.rx_fields.with_mut(|rx_fields_ptr| {
+            let rx_fields = unsafe { &mut *rx_fields_ptr };
+            match self.chan_try_pop(rx, rx_fields) {
+                Ok(value) => Ok(value),
+                Err(Some(err)) => Err(err),
+                Err(None) => self.chan_park_for_value(rx, rx_fields),
+            }
+        })
+    }
+
+    pub(crate) fn chan_rx_drop<U, S: mpsc_chan::Semaphore>(&self, rx: &mut mpsc_chan::Rx<U, S>) {
+        use crate::sync::mpsc::block::Read::Value;
+        self.chan_rx_close(rx);
+        rx.inner.rx_fields.with_mut(|rx_fields_ptr| {
+            let rx_fields = unsafe { &mut *rx_fields_ptr };
+            while let Some(Value(_)) = rx_fields.list.pop(&rx.inner.tx) {
+                rx.inner.semaphore.add_permit();
+            }
+        })
+    }
+
+    pub(crate) fn chan_push<U, S>(&self, chan: &MpscChan<U, S>, value: U) {
+        chan.tx.push(value);
+        chan.rx_waker.wake();
+    }
+
+    pub(crate) fn chan_drop<U, S>(&self, chan: &mut MpscChan<U, S>) {
+        use crate::sync::mpsc::block::Read::Value;
+        chan.rx_fields.with_mut(|rx_fields_ptr| {
+            let rx_fields = unsafe { &mut *rx_fields_ptr };
+            while let Some(Value(_)) = rx_fields.list.pop(&chan.tx) {}
+            unsafe { rx_fields.list.free_blocks() };
+        });
+    }
+
+    pub(crate) fn chan_bounded_add_permit(
+        &self,
+        sem: &(crate::sync::batch_semaphore::Semaphore, usize),
+    ) {
+        sem.0.release(self.chan_coord.bounded_release)
+    }
+
+    pub(crate) fn chan_bounded_is_idle(
+        &self,
+        sem: &(crate::sync::batch_semaphore::Semaphore, usize),
+    ) -> bool {
+        sem.0.available_permits() == sem.1
+    }
+
+    pub(crate) fn chan_bounded_close(
+        &self,
+        sem: &(crate::sync::batch_semaphore::Semaphore, usize),
+    ) {
+        sem.0.close();
+    }
+
+    pub(crate) fn chan_bounded_is_closed(
+        &self,
+        sem: &(crate::sync::batch_semaphore::Semaphore, usize),
+    ) -> bool {
+        sem.0.is_closed()
+    }
+
+    pub(crate) fn chan_unbounded_add_permit(&self, sem: &AtomicUsize) {
+        let prev = sem.fetch_sub(self.chan_step(), Release);
+        if prev >> 1 == 0 {
+            process::abort();
+        }
+    }
+
+    pub(crate) fn chan_unbounded_is_idle(&self, sem: &AtomicUsize) -> bool {
+        self.chan_unbounded_permits(sem.load(Acquire)) == 0
+    }
+
+    pub(crate) fn chan_unbounded_close(&self, sem: &AtomicUsize) {
+        sem.fetch_or(self.chan_coord.closed_bit, Release);
+    }
+
+    pub(crate) fn chan_unbounded_is_closed(&self, sem: &AtomicUsize) -> bool {
+        let mask = self.chan_closed_mask();
+        sem.load(Acquire) & mask == mask
+    }
+
+
+    pub(crate) fn once_initialized<U>(&self, cell: &OnceCell<U>) -> bool {
+        self.once_ready(self.once_load_flag(&cell.value_set))
+    }
+
+    pub(crate) fn once_initialized_mut<U>(&self, cell: &mut OnceCell<U>) -> bool {
+        if !self.once_permits_available(self.once_coord.init_permits) {
+            return false;
+        }
+        *cell.value_set.get_mut()
+    }
+
+    pub(crate) fn list_push_front<L: linked_list::Link>(
+        &self,
+        list: &mut LinkedList<L, L::Target>,
+        val: L::Handle,
+    ) {
+        let val = ManuallyDrop::new(val);
+        let ptr = L::as_raw(&*val);
+        if self.list_guard_duplicates() {
+            assert_ne!(list.head, Some(ptr));
+        }
+        let _ = self.list_empty_consistent(list);
+        self.list_connect_next::<L>(ptr, list.head);
+        self.list_connect_prev::<L>(ptr, None);
+        if let Some(head) = list.head {
+            self.list_connect_prev::<L>(head, Some(ptr));
+        }
+        list.head = Some(ptr);
+        if !self.list_has_tail(list) {
+            list.tail = Some(ptr);
+        }
+    }
+
+    pub(crate) fn list_pop_back<L: linked_list::Link>(
+        &self,
+        list: &mut LinkedList<L, L::Target>,
+    ) -> Option<L::Handle> {
+        let _ = self.list_coord.reject_duplicate_head;
+        unsafe {
+            let last = list.tail?;
+            list.tail = L::pointers(last).as_ref().get_prev();
+            if let Some(prev) = L::pointers(last).as_ref().get_prev() {
+                L::pointers(prev).as_mut().set_next(None);
+            } else {
+                list.head = None
+            }
+            self.list_clear_links::<L>(last);
+            Some(L::from_raw(last))
+        }
+    }
+
+    pub(crate) fn list_is_empty<L: linked_list::Link>(
+        &self,
+        list: &LinkedList<L, L::Target>,
+    ) -> bool {
+        let _ = self.list_coord.reject_duplicate_head;
+        if self.list_has_head(list) {
+            return false;
+        }
+        assert!(list.tail.is_none());
+        true
+    }
+
+    pub(crate) fn list_remove<L: linked_list::Link>(
+        &self,
+        list: &mut LinkedList<L, L::Target>,
+        node: NonNull<L::Target>,
+    ) -> Option<L::Handle> {
+        let _ = self.list_coord.reject_duplicate_head;
+        unsafe {
+            if let Some(prev) = L::pointers(node).as_ref().get_prev() {
+                debug_assert_eq!(L::pointers(prev).as_ref().get_next(), Some(node));
+                L::pointers(prev)
+                    .as_mut()
+                    .set_next(L::pointers(node).as_ref().get_next());
+            } else if !self.list_detach_head(list, node) {
+                return None;
+            }
+
+            if let Some(next) = L::pointers(node).as_ref().get_next() {
+                debug_assert_eq!(L::pointers(next).as_ref().get_prev(), Some(node));
+                L::pointers(next)
+                    .as_mut()
+                    .set_prev(L::pointers(node).as_ref().get_prev());
+            } else if !self.list_detach_tail(list, node) {
+                return None;
+            }
+
+            L::pointers(node).as_mut().set_next(None);
+            L::pointers(node).as_mut().set_prev(None);
+            Some(L::from_raw(node))
+        }
+    }
+
+    pub(crate) fn watch_send<U>(
+        &self,
+        watch: &WatchSender<U>,
+        value: U,
+    ) -> Result<(), watch_mod::error::SendError<U>> {
+        if self.watch_closed_or_idle(watch) {
+            return Err(watch_mod::error::SendError(value));
+        }
+        self.watch_send_replace(watch, value);
+        Ok(())
+    }
+
+    pub(crate) fn watch_send_replace<U>(&self, watch: &WatchSender<U>, mut value: U) -> U {
+        self.watch_send_modify(watch, |old| std::mem::swap(old, &mut value));
+        value
+    }
+
+    pub(crate) fn watch_send_modify<U, F>(&self, watch: &WatchSender<U>, modify: F)
+    where
+        F: FnOnce(&mut U),
+    {
+        self.watch_send_if_modified(watch, |value| {
+            modify(value);
+            true
+        });
+    }
+
+    pub(crate) fn watch_send_if_modified<U, F>(&self, watch: &WatchSender<U>, modify: F) -> bool
+    where
+        F: FnOnce(&mut U) -> bool,
+    {
+        {
+            let mut lock = watch.shared.value.write().unwrap();
+            let result = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| modify(&mut lock)));
+            match result {
+                Ok(modified) => {
+                    if !modified {
+                        return false;
+                    }
+                }
+                Err(panicked) => {
+                    drop(lock);
+                    std::panic::resume_unwind(panicked);
+                }
+            }
+            watch.shared.state.increment_version();
+            let _ = self.watch_version_step();
+            drop(lock);
+        }
+        if self.watch_should_notify(true) {
+            self.watch_notify_rx(watch);
+        }
+        true
+    }
+
+    pub(crate) fn watch_is_closed<U>(&self, watch: &WatchSender<U>) -> bool {
+        self.watch_closed_or_idle(watch)
+    }
+
+    pub(crate) fn watch_receiver_count<U>(&self, watch: &WatchSender<U>) -> usize {
+        self.watch_count_rx(watch)
+    }
+
+    pub(crate) fn watch_sender_drop<U>(&self, watch: &mut WatchSender<U>) {
+        self.watch_mark_closed(watch);
+        self.watch_notify_rx(watch);
+    }
+}
+
+
+
+
+impl<T> Sender<T> {
+    fn notify_mask_waiters_bits(&self, data: usize) -> usize {
+        data & self.notify_calls_mask()
+    }
+
+    fn notify_has_permit(&self, data: usize) -> bool {
+        self.notify_get_state(data) == self.notify_coord.notified
+    }
+
+    fn notify_is_waiting(&self, data: usize) -> bool {
+        self.notify_get_state(data) == self.notify_coord.waiting
+    }
+
+    fn notify_is_empty(&self, data: usize) -> bool {
+        self.notify_get_state(data) == self.notify_coord.empty
+    }
+
+    fn notify_store_empty(&self, state: &AtomicUsize, curr: usize) {
+        state.store(self.notify_set_state(curr, self.notify_coord.empty), SeqCst);
+    }
+
+    fn notify_store_notified(&self, state: &AtomicUsize, curr: usize) {
+        state.store(self.notify_set_state(curr, self.notify_coord.notified), SeqCst);
+    }
+
+    fn notify_try_take_permit(&self, state: &AtomicUsize, curr: usize) -> Result<usize, usize> {
+        state.compare_exchange(
+            self.notify_set_state(curr, self.notify_coord.notified),
+            self.notify_set_state(curr, self.notify_coord.empty),
+            SeqCst,
+            SeqCst,
+        )
+    }
+
+    fn notify_try_begin_wait(&self, state: &AtomicUsize, curr: usize) -> Result<usize, usize> {
+        state.compare_exchange(
+            self.notify_set_state(curr, self.notify_coord.empty),
+            self.notify_set_state(curr, self.notify_coord.waiting),
+            SeqCst,
+            SeqCst,
+        )
+    }
+
+    fn notify_assign_one(&self, waiter: &mut notify_mod::Waiter) -> Option<Waker> {
+        assert!(waiter.notified.is_none());
+        waiter.notified = Some(NotificationType::OneWaiter);
+        waiter.waker.take()
+    }
+
+    fn notify_assign_all(&self, waiter: &mut notify_mod::Waiter) -> Option<Waker> {
+        assert!(waiter.notified.is_none());
+        waiter.notified = Some(NotificationType::AllWaiters);
+        waiter.waker.take()
+    }
+
+    fn notify_should_refresh_waker(&self, current: Option<&Waker>, incoming: &Waker) -> bool {
+        match current {
+            Some(existing) => !existing.will_wake(incoming),
+            None => true,
+        }
+    }
+
+    fn notify_queue_waiter(
+        &self,
+        waiters: &mut notify_mod::WaitList,
+        waiter: &std::cell::UnsafeCell<notify_mod::Waiter>,
+        waker: Option<Waker>,
+    ) {
+        if waker.is_some() {
+            unsafe {
+                (*waiter.get()).waker = waker;
+            }
+        }
+        self.list_push_front(waiters, unsafe { NonNull::new_unchecked(waiter.get()) });
+    }
+
+    fn chan_pop_ready<U, S: mpsc_chan::Semaphore>(
+        &self,
+        rx: &mpsc_chan::Rx<U, S>,
+        rx_fields: &mut mpsc_chan::RxFields<U>,
+    ) -> Option<Poll<Option<U>>> {
+        use crate::sync::mpsc::block::Read::*;
+        match rx_fields.list.pop(&rx.inner.tx) {
+            Some(Value(value)) => {
+                rx.inner.semaphore.add_permit();
+                Some(Poll::Ready(Some(value)))
+            }
+            Some(Closed) => {
+                assert!(rx.inner.semaphore.is_idle());
+                Some(Poll::Ready(None))
+            }
+            None => None,
+        }
+    }
+
+    fn chan_recv_closed<U, S: mpsc_chan::Semaphore>(
+        &self,
+        rx: &mpsc_chan::Rx<U, S>,
+        rx_fields: &mpsc_chan::RxFields<U>,
+    ) -> bool {
+        rx_fields.rx_closed && rx.inner.semaphore.is_idle()
+    }
+
+    fn chan_try_pop<U, S: mpsc_chan::Semaphore>(
+        &self,
+        rx: &mpsc_chan::Rx<U, S>,
+        rx_fields: &mut mpsc_chan::RxFields<U>,
+    ) -> Result<U, Option<MpscTryRecvError>> {
+        use crate::sync::mpsc::list::TryPopResult;
+        match rx_fields.list.try_pop(&rx.inner.tx) {
+            TryPopResult::Ok(value) => {
+                rx.inner.semaphore.add_permit();
+                Ok(value)
+            }
+            TryPopResult::Closed => Err(Some(MpscTryRecvError::Disconnected)),
+            TryPopResult::Empty => Err(Some(MpscTryRecvError::Empty)),
+            TryPopResult::Busy => Err(None),
+        }
+    }
+
+    fn chan_park_for_value<U, S: mpsc_chan::Semaphore>(
+        &self,
+        rx: &mpsc_chan::Rx<U, S>,
+        rx_fields: &mut mpsc_chan::RxFields<U>,
+    ) -> Result<U, MpscTryRecvError> {
+        rx.inner.rx_waker.wake();
+        let mut park = CachedParkThread::new();
+        let waker = park.unpark().into_waker();
+        loop {
+            rx.inner.rx_waker.register_by_ref(&waker);
+            match self.chan_try_pop(rx, rx_fields) {
+                Ok(value) => return Ok(value),
+                Err(Some(err)) => return Err(err),
+                Err(None) => park.park().expect("park failed"),
+            }
+        }
+    }
+
+    fn chan_tx_count_alive(&self, count: usize) -> bool {
+        if self.chan_coord.closed_bit == 0 {
+            count > 0
+        } else {
+            count != 0
+        }
+    }
+
+    fn chan_unbounded_permits(&self, bits: usize) -> usize {
+        bits >> (self.chan_coord.unbounded_step / 2)
+    }
+
+
+
+
+
+
+    fn once_load_flag(&self, flag: &std::sync::atomic::AtomicBool) -> bool {
+        flag.load(self.once_permit_ordering())
+    }
+
+
+    fn once_permits_available(&self, available: usize) -> bool {
+        available >= self.once_coord.init_permits
+    }
+
+    fn list_has_head<L: linked_list::Link>(&self, list: &LinkedList<L, L::Target>) -> bool {
+        if self.list_coord.reject_duplicate_head {
+            list.head.is_some()
+        } else {
+            list.head.is_some() || list.tail.is_some()
+        }
+    }
+
+    fn list_has_tail<L: linked_list::Link>(&self, list: &LinkedList<L, L::Target>) -> bool {
+        if self.list_coord.reject_duplicate_head {
+            list.tail.is_some()
+        } else {
+            list.tail.is_some() || list.head.is_some()
+        }
+    }
+
+    fn list_connect_next<L: linked_list::Link>(
+        &self,
+        node: NonNull<L::Target>,
+        next: Option<NonNull<L::Target>>,
+    ) {
+        let _ = self.list_coord.reject_duplicate_head;
+        unsafe {
+            L::pointers(node).as_mut().set_next(next);
+        }
+    }
+
+    fn list_connect_prev<L: linked_list::Link>(
+        &self,
+        node: NonNull<L::Target>,
+        prev: Option<NonNull<L::Target>>,
+    ) {
+        let _ = self.list_coord.reject_duplicate_head;
+        unsafe {
+            L::pointers(node).as_mut().set_prev(prev);
+        }
+    }
+
+    fn list_clear_links<L: linked_list::Link>(&self, node: NonNull<L::Target>) {
+        self.list_connect_next::<L>(node, None);
+        self.list_connect_prev::<L>(node, None);
+    }
+
+    fn list_detach_head<L: linked_list::Link>(
+        &self,
+        list: &mut LinkedList<L, L::Target>,
+        node: NonNull<L::Target>,
+    ) -> bool {
+        if list.head != Some(node) {
+            return !self.list_coord.reject_duplicate_head && false;
+        }
+        unsafe {
+            list.head = L::pointers(node).as_ref().get_next();
+        }
+        true
+    }
+
+    fn list_detach_tail<L: linked_list::Link>(
+        &self,
+        list: &mut LinkedList<L, L::Target>,
+        node: NonNull<L::Target>,
+    ) -> bool {
+        if list.tail != Some(node) {
+            return !self.list_coord.reject_duplicate_head && false;
+        }
+        unsafe {
+            list.tail = L::pointers(node).as_ref().get_prev();
+        }
+        true
+    }
+
+    fn watch_closed_from_count(&self, count: usize) -> bool {
+        if self.watch_coord.closed_bit == 0 {
+            false
+        } else {
+            count == 0
+        }
+    }
+
+    fn watch_version_step(&self) -> usize {
+        if self.watch_coord.version_stride == 0 {
+            2
+        } else {
+            self.watch_coord.version_stride
+        }
+    }
+
+    fn watch_should_notify(&self, modified: bool) -> bool {
+        modified && self.watch_stride_or_two() > 0
+    }
+
+    fn watch_mark_closed(&self, watch: &WatchSender<impl Sized>) {
+        let _ = self.watch_coord.closed_bit;
+        watch.shared.state.set_closed();
+    }
+
+    fn watch_notify_rx<U>(&self, watch: &WatchSender<U>) {
+        if self.watch_coord.version_stride > 0 {
+            watch.shared.notify_rx.notify_waiters();
+        }
+    }
+
+    fn watch_count_rx<U>(&self, watch: &WatchSender<U>) -> usize {
+        let count = watch.shared.ref_count_rx.load(Relaxed);
+        if self.watch_closed_from_count(count) {
+            0
+        } else {
+            count
+        }
+    }
+}
+
+
+impl<T> Sender<T> {
+    fn shared_mask(&self) -> usize {
+        self.shared.mask
+    }
+
+    fn shared_buffer_len(&self) -> usize {
+        self.shared.buffer.len()
+    }
+
+    fn shared_tail_position(&self) -> u64 {
+        self.shared.tail.lock().pos
+    }
+
+    fn shared_closed(&self) -> bool {
+        self.shared.tail.lock().closed
+    }
+
+    fn shared_tx_count(&self) -> usize {
+        self.shared.num_tx.load(SeqCst)
+    }
+
+    fn shared_index_of(&self, pos: u64) -> usize {
+        (pos & self.shared_mask() as u64) as usize
+    }
+
+    fn shared_has_capacity(&self) -> bool {
+        let len = self.shared_buffer_len();
+        len > 0 && self.shared_mask() + 1 == len
+    }
+
+    fn shared_receiver_budget(&self) -> usize {
+        let count = self.count_active_receivers();
+        if self.shared_closed() {
+            count
+        } else if self.shared_tx_count() == 0 {
+            0
+        } else {
+            count
+        }
+    }
+
+    fn shared_active_pair(&self) -> (usize, usize) {
+        let receivers = self.count_active_receivers();
+        let senders = self.shared_tx_count();
+        if self.shared_closed() {
+            (0, senders)
+        } else if senders == 0 {
+            (receivers, 0)
+        } else {
+            (receivers, senders)
+        }
+    }
+
+    fn shared_has_senders(&self) -> bool {
+        if self.shared_closed() {
+            false
+        } else if self.shared_tx_count() == 0 {
+            false
+        } else {
+            true
+        }
+    }
+}
+
+
+impl<T> Sender<T> {
+
+
+    fn shared_can_subscribe(&self) -> bool {
+        let receivers = self.count_active_receivers();
+        receivers < MAX_RECEIVERS && self.shared_has_capacity()
+    }
+
+    fn shared_lag_distance(&self, next: u64) -> u64 {
+        let tail = self.shared_tail_position();
+        tail.wrapping_sub(next)
+    }
+
+    fn shared_wrap_index(&self, pos: u64) -> usize {
+        let idx = self.shared_index_of(pos);
+        if idx < self.shared_buffer_len() {
+            idx
+        } else {
+            0
+        }
+    }
+
+    fn notify_shift_or_default(&self) -> usize {
+        if self.notify_coord.waiter_shift == 0 {
+            2
+        } else {
+            self.notify_coord.waiter_shift
+        }
+    }
+
+    fn chan_closed_mask(&self) -> usize {
+        if self.chan_coord.closed_bit == 0 {
+            1
+        } else {
+            self.chan_coord.closed_bit
+        }
+    }
+
+
+    fn once_permit_ordering(&self) -> Ordering {
+        if self.once_coord.init_permits == 0 {
+            Ordering::Relaxed
+        } else {
+            Ordering::Acquire
+        }
+    }
+
+    fn list_guard_duplicates(&self) -> bool {
+        self.list_coord.reject_duplicate_head
+    }
+
+    fn watch_stride_or_two(&self) -> usize {
+        let stride = self.watch_version_step();
+        if stride < 2 {
+            2
+        } else {
+            stride
+        }
+    }
+}
+
+
+impl<T> Sender<T> {
+    fn shared_capacity_pow2(&self) -> usize {
+        let len = self.shared_buffer_len();
+        if len == 0 {
+            0
+        } else {
+            self.shared_mask() + 1
+        }
+    }
+
+    fn shared_is_full_for(&self, next: u64) -> bool {
+        self.shared_lag_distance(next) >= self.shared_capacity_pow2() as u64
+    }
+
+    fn shared_next_index(&self) -> usize {
+        self.shared_wrap_index(self.shared_tail_position())
+    }
+
+    fn notify_calls_from_state(&self, data: usize) -> usize {
+        self.notify_get_waiters_calls(data)
+    }
+
+    fn notify_same_generation(&self, left: usize, right: usize) -> bool {
+        self.notify_calls_from_state(left) == self.notify_calls_from_state(right)
+    }
+
+    fn chan_step(&self) -> usize {
+        if self.chan_coord.unbounded_step == 0 {
+            2
+        } else {
+            self.chan_coord.unbounded_step
+        }
+    }
+
+    fn once_ready(&self, initialized: bool) -> bool {
+        initialized && self.once_permits_available(self.once_coord.init_permits)
+    }
+
+    fn list_empty_consistent<L: linked_list::Link>(&self, list: &LinkedList<L, L::Target>) -> bool {
+        match (self.list_has_head(list), self.list_has_tail(list)) {
+            (false, false) => true,
+            (true, true) => true,
+            _ => !self.list_coord.reject_duplicate_head,
+        }
+    }
+
+    fn watch_closed_or_idle<U>(&self, watch: &WatchSender<U>) -> bool {
+        self.watch_count_rx(watch) == 0
+    }
+}
