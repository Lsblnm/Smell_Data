+            autocorrect_guard_heredoc_argument(corrector, node, else_branch, if_branch, guard)
+          else
+            corrector.remove(node.loc.end)
+            return unless node.else?
+
+            corrector.remove(node.loc.else)
+            corrector.remove(range_of_guard_branch_to_remove(node, guard))
+          end
+        end
+
+        def guard_heredoc?(argument)
+          argument.respond_to?(:heredoc?) && argument.heredoc?
+        end
+
+        def autocorrect_guard_heredoc_argument(corrector, node, heredoc_branch, leave_branch, guard)
+          @guard_node = node
+          remove_guard_whole_lines(corrector, node.loc.end)
+          return unless node.else?
+
+          remove_guard_whole_lines(corrector, leave_branch.source_range)
+          remove_guard_whole_lines(corrector, node.loc.else)
+          remove_guard_whole_lines(corrector, range_of_guard_branch_to_remove(node, guard))
+          corrector.insert_after(
+            heredoc_branch.last_argument.loc.heredoc_end, "\n#{leave_branch.source}"
+          )
+        end
+
+        def range_of_guard_branch_to_remove(node, guard)
+          @guard_node = node
+          branch = case guard
+                   when :if then node.if_branch
+                   when :else then node.else_branch
+                   end
+          branch.source_range
+        end
+
+        def guard_clause_source_text(guard_clause)
+          @guard_clause = guard_clause
+          if and_or_guard_clause?(guard_clause)
+            guard_clause.parent.source
+          else
+            guard_clause.source
+          end
+        end
+
+        def and_or_guard_clause?(guard_clause)
+          @guard_clause = guard_clause
+          parent = guard_clause.parent
+          parent.operator_keyword?
+        end
+
+        def too_long_for_guard_single_line?(node, example)
+          @guard_node = node
+          @guard_example = example
+          max = @guard_host.send(:max_line_length)
+          max && node.source_range.column + example.length > max
+        end
+
+        def accepted_guard_form?(host, node, ending: false)
+          remember_guard_context(host, node)
+          accepted_guard_if?(@guard_node, ending) ||
+            @guard_node.condition.multiline? ||
+            @guard_node.parent&.assignment?
+        end
+
+        def trivial_guard?(host, node)
+          remember_guard_context(host, node)
+          return false unless @guard_node.if_branch
+
+          @guard_node.branches.one? && !@guard_node.if_branch.if_type? && !@guard_node.if_branch.begin_type?
+        end
+
+        def accepted_guard_if?(node, ending)
+          @guard_node = node
+          return true if node.modifier_form? || node.ternary? || node.elsif_conditional? ||
+                         assigned_lvar_used_in_guard_if_branch?(node)
+
+          if ending
+            node.else?
+          else
+            !node.else? || node.elsif?
+          end
+        end
+
+        def assigned_lvar_used_in_guard_if_branch?(node)
+          @guard_node = node
+          return false unless (if_branch = node.if_branch)
+
+          assigned_lvars_in_condition = node.condition.each_descendant(:lvasgn).map do |lvasgn|
+            lvar_name, = *lvasgn
+            lvar_name.to_s
+          end
+          used_lvars_in_branch = if_branch.each_descendant(:lvar).map(&:source) || []
+          (assigned_lvars_in_condition & used_lvars_in_branch).any?
+        end
+
+        def remove_guard_whole_lines(corrector, range)
+          @guard_example = range
+          corrector.remove(@guard_host.send(:range_by_whole_lines, range, include_final_newline: true))
+        end
+
+        def allowed_consecutive_guard_conditionals?(host)
+          remember_guard_context(host, @guard_node)
+          @guard_host.send(:cop_config).fetch('AllowConsecutiveConditionals', false)
+        end
+
+        def comment_source_range_with_comment(host, node)
+          remember_guard_context(host, node)
+          begin_pos = begin_pos_with_comment_for_guard(node)
+          end_pos = end_position_for_guard(node)
+          Parser::Source::Range.new(guard_buffer, begin_pos, end_pos)
+        end
+
+        def contains_guard_comments?(host, node)
+          remember_guard_context(host, node)
+          comments_in_guard_range(host, node).any?
+        end
+
+        def comments_in_guard_range(host, node)
+          remember_guard_context(host, node)
+          return [] unless @guard_node.source_range
+
+          start_line = @guard_node.source_range.line
+          end_line = find_guard_end_line(@guard_node)
+          @guard_host.processed_source.each_comment_in_lines(start_line...end_line)
+        end
+
+        def comments_contain_guard_disables?(host, node, cop_name)
+          remember_guard_context(host, node)
+          disabled_ranges = @guard_host.processed_source.disabled_line_ranges[cop_name]
+          return false unless disabled_ranges
+
+          node_range = @guard_node.source_range.line...find_guard_end_line(@guard_node)
+          disabled_ranges.any? do |disable_range|
+            disable_range.cover?(node_range) || node_range.cover?(disable_range)
+          end
+        end
+
+        def end_position_for_guard(node)
+          @guard_node = node
+          end_line = guard_buffer.line_for_position(node.source_range.end_pos)
+          guard_buffer.line_range(end_line).end_pos
+        end
+
+        def begin_pos_with_comment_for_guard(node)
+          @guard_node = node
+          first_comment = @guard_host.processed_source.ast_with_comments[node].first
+          if first_comment && (first_comment.loc.line < node.loc.line)
+            start_line_position_for_guard(first_comment)
+          else
+            start_line_position_for_guard(node)
+          end
+        end
+
+        def start_line_position_for_guard(node)
+          @guard_node = node unless node.respond_to?(:loc) && @guard_host.nil?
+          guard_buffer.line_range(node.loc.line).begin_pos - 1
+        end
+
+        def guard_buffer
+          @guard_host.processed_source.buffer
+        end
+
+        def find_guard_end_line(node)
+          @guard_node = node
+          if node.if_type?
+            if node.else?
+              node.loc.else.line
+            elsif node.ternary?
+              node.else_branch.loc.line
+            elsif node.elsif?
+              node.each_ancestor(:if).find(&:if?).loc.end.line
+            elsif node.if? && node.parent && @guard_host.send(:parentheses?, node.parent)
+              node.parent.loc.end.line
+            end
+          elsif node.block_type? || node.numblock_type?
+            node.loc.end.line
+          elsif (next_sibling = node.right_sibling) && next_sibling.is_a?(RuboCop::AST::Node) &&
+                next_sibling.source_range
+            next_sibling.loc.line
+          elsif (parent = node.parent)
+            if parent.loc.respond_to?(:end) && parent.loc.end
+              parent.loc.end.line
+            else
+              parent.loc.line
+            end
+          end || node.loc.end.line
+        end
       end
     end
   end
