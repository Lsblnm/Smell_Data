+            range: node.loc.end,
+            buffer: node.source_range.source_buffer,
+            side: :left,
+            newlines: true,
+            whitespace: true,
+            continuations: true
+          )
+        end
+
+        def extend_range_for_heredoc_comma(node, range)
+          @logical_node = node
+          return range unless parentheses_heredoc?(node)
+
