+          @logical_corrector = corrector
+          return unless parentheses_heredoc?(node)
+
+          corrector.insert_after(node.child_nodes.last, ',')
+        end
+
+        def parentheses_heredoc?(node)
+          @logical_node = node
+          node.child_nodes.last.loc.is_a?(Parser::Source::Map::Heredoc)
+        end
+
+        def remember_guard_context(host, node)
+          @guard_host = host
+          @guard_node = node
+          @guard_clause = nil
+          @guard_example = nil
+        end
+
+        def check_guard_ending_body(host, body)
