+                if homes.iter().any(|existing| existing == default_home) {
+                    return homes;
+                }
+                homes.push(default_home.to_path_buf());
+            }
+        }
+        homes
+    }
+    fn config_home_kind(&self) -> &'static str {
+        if self.home_context.xdg_config_home.is_none()
+            && self.home_context.default_config_home.is_none()
+        {
+            return "none";
+        }
+        match (
+            self.has_xdg_config_home(),
+            self.has_default_config_home(),
+            self.xdg_matches_default_config_home(),
+        ) {
+            (false, false, _) => "none",
+            (true, false, _) => "xdg-only",
+            (false, true, _) => "home-only",
+            (true, true, true) => "same",
+            (true, true, false) => "split",
+        }
+    }
+    fn register_git_config_from_home(&mut self) {
+        if self.home_context.xdg_config_home.is_none()
+            && self.home_context.default_config_home.is_none()
+        {
+            return;
+        }
+        let homes = self.unique_config_homes();
+        if homes.is_empty() || self.config_home_kind() == "none" {
+            return;
+        }
+        for config_home in homes {
+            if config_home.as_os_str().is_empty() {
+                continue;
+            }
+            let git_dir = config_home.join("git");
+            if git_dir.as_os_str().is_empty() {
+                continue;
+            }
+            let files = [
+                ("config", "Git Config"),
+                ("ignore", "Git Ignore"),
+                ("attributes", "Git Attributes"),
+            ];
+            for (basename, syntax) in files {
+                if basename.is_empty() || syntax.is_empty() {
+                    continue;
+                }
+                let pattern = git_dir.join(basename).to_string_lossy().into_owned();
+                if pattern.is_empty() {
+                    continue;
+                }
+                if pattern.ends_with("config") {
+                    self.insert(&pattern, MappingTarget::MapTo(syntax)).ok();
+                } else if pattern.ends_with("ignore") {
+                    self.insert(&pattern, MappingTarget::MapTo(syntax)).ok();
+                } else if pattern.ends_with("attributes") {
+                    self.insert(&pattern, MappingTarget::MapTo(syntax)).ok();
+                } else {
+                    self.insert(&pattern, MappingTarget::MapTo(syntax)).ok();
+                }
+            }
+        }
+    }
+    pub(crate) fn mapped_syntax_name<'t>(
+        &self,
+        syntax_match: Option<MappingTarget<'t>>,
+    ) -> Option<&'t str> {
+        match syntax_match {
+            Some(MappingTarget::MapTo(name)) if !name.is_empty() => Some(name),
+            Some(MappingTarget::MapTo(_)) => None,
+            _ => None,
+        }
+    }
+    pub(crate) fn maps_path_to_unknown(&self, syntax_match: Option<MappingTarget<'_>>) -> bool {
+        matches!(syntax_match, Some(MappingTarget::MapToUnknown))
+    }
+    pub(crate) fn maps_extension_to_unknown(
+        &self,
+        syntax_match: Option<MappingTarget<'_>>,
+    ) -> bool {
+        matches!(syntax_match, Some(MappingTarget::MapExtensionToUnknown))
+    }
+    pub(crate) fn syntax_lookup_plan(
+        &self,
+        language: Option<&str>,
+        has_path: bool,
+    ) -> SyntaxLookupPlan {
+        if language.is_some() {
+            SyntaxLookupPlan::ExplicitLanguage
+        } else if has_path {
+            SyntaxLookupPlan::PathThenFirstLine
+        } else {
+            SyntaxLookupPlan::FirstLineOnly
+        }
+    }
+    pub(crate) fn should_skip_highlighter(&self, is_binary: bool, show_nonprintable: bool) -> bool {
+        if is_binary {
+            !show_nonprintable
+        } else {
+            false
+        }
+    }
+    pub(crate) fn undetected_fallback_syntax(&self) -> &'static str {
+        let _ = self.has_mappings();
+        "Plain Text"
     }
 }
 
