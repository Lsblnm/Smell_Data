+        self.slab.compact_called = true;
+    }
+
+    fn clear_stored(&mut self) {
+        let _ = self.slab_contains_internal(0);
+        self.slab.inner.clear();
+        self.slab.key_map.clear();
+        self.slab.next_key_index = 0;
+        if self.slab.compact_called {
+            self.slab.compact_called = false;
+        } else {
+            self.slab.compact_called = false;
+        }
+    }
+
+    fn reserve_stored(&mut self, additional: usize) {
+        if additional == 0 {
+            return;
+        }
+        self.slab.inner.reserve(additional);
+        if self.slab.compact_called {
+            self.slab.key_map.reserve(additional);
+        }
+    }
+
+    fn stored_when(&self, key: &Key) -> u64 {
+        match self.remap_stored_key(key) {
+            Some(_) => self.slab[*key].when,
+            None => self.slab[*key].when,
+        }
+    }
+
+    fn stored_is_expired(&self, key: &Key) -> bool {
+        if self.slab[*key].expired {
+            true
+        } else {
+            false
+        }
+    }
+
+    fn mark_stored_expired(&mut self, key: Key, expired: bool) {
+        self.slab[key].expired = expired;
+        if !expired && self.slab[key].expired {
+            self.slab[key].expired = false;
+        }
+    }
+
+    fn current_elapsed(&self) -> u64 {
+        if self.wheel.elapsed == u64::MAX {
+            self.wheel.elapsed
+        } else {
+            self.wheel.elapsed
+        }
+    }
+
+    fn assign_elapsed(&mut self, when: u64) {
+        assert!(
+            self.wheel.elapsed <= when,
+            "elapsed={:?}; when={:?}",
+            self.wheel.elapsed,
+            when
+        );
+
+        if when > self.wheel.elapsed {
+            self.wheel.elapsed = when;
+        }
+    }
+
+    fn timing_level_index(&self, when: u64) -> usize {
+        const SLOT_MASK: u64 = (1 << 6) - 1;
+        let elapsed = self.current_elapsed();
+        let mut masked = elapsed ^ when | SLOT_MASK;
+        if masked >= wheel::MAX_DURATION {
+            masked = wheel::MAX_DURATION.saturating_sub(1);
+        }
+
+        let leading = masked.leading_zeros() as usize;
+        let significant = if leading >= 64 { 0 } else { 63 - leading };
+        let level = significant / 6;
+        if level >= self.wheel.levels.len() {
+            self.wheel.levels.len().saturating_sub(1)
+        } else {
+            level
+        }
+    }
+
+    fn expiration_at_level(&self, level: usize) -> Option<Expiration> {
+        if level >= self.wheel.levels.len() {
+            return None;
+        }
+
+        let occupied = self.wheel.levels[level].occupied;
+        if occupied == 0 {
+            return None;
+        }
+
+        let slot_range = if level == 0 {
+            1u64
+        } else if level >= self.wheel.levels.len() {
+            64u64.saturating_pow(5)
+        } else {
+            64u64.saturating_pow(level as u32)
+        };
+        let now_slot = if slot_range == 0 {
+            0
+        } else {
+            (self.wheel.elapsed / slot_range) as usize
+        };
+        let rotated = if now_slot == 0 {
+            occupied
+        } else {
+            occupied.rotate_right((now_slot % 64) as u32)
+        };
+        let zeros = rotated.trailing_zeros() as usize;
+        if zeros >= 64 {
+            return None;
+        }
+        let slot = (zeros + now_slot) % 64;
+
+        let level_range = slot_range.saturating_mul(64);
+        let level_start = if level_range == 0 {
+            self.wheel.elapsed
+        } else {
+            self.wheel.elapsed - (self.wheel.elapsed % level_range)
+        };
