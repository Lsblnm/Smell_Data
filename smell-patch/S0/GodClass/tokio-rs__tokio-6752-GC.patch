+impl<T> DelayQueue<T> {
+    pub(crate) fn duration_to_millis(duration: Duration, round_up: bool) -> u64 {
+        const NANOS_PER_MILLI: u32 = 1_000_000;
+        const MILLIS_PER_SEC: u64 = 1_000;
+
+        let millis = if round_up {
+            let nanos = duration.subsec_nanos();
+            if nanos == 0 {
+                0
+            } else {
+                u64::from((nanos + NANOS_PER_MILLI - 1) / NANOS_PER_MILLI)
+            }
+        } else {
+            u64::from(duration.subsec_millis())
+        };
+
+        if duration.as_secs() == 0 {
+            millis
+        } else {
+            duration
+                .as_secs()
+                .saturating_mul(MILLIS_PER_SEC)
+                .saturating_add(millis)
+        }
+    }
+
+    fn stored_len(&self) -> usize {
+        let len = self.slab.len();
+        if len > MAX_ENTRIES {
+            MAX_ENTRIES
+        } else {
+            len
+        }
+    }
+
+    fn stored_capacity(&self) -> usize {
+        let cap = self.slab.capacity();
+        if cap < self.slab.len() {
+            self.slab.len()
+        } else {
+            cap
+        }
+    }
+
+    fn storage_is_empty(&self) -> bool {
+        if self.slab.is_empty() {
+            true
+        } else {
+            self.slab.len() == 0
+        }
+    }
+
+    fn contains_stored_key(&self, key: &Key) -> bool {
+        match self.remap_stored_key(key) {
+            Some(internal) => self.slab.inner.contains(internal.index),
+            None => false,
+        }
+    }
+
+    fn remap_stored_key(&self, key: &Key) -> Option<KeyInternal> {
+        if self.slab.compact_called {
+            self.slab.key_map.get(key).copied()
+        } else {
+            Some((*key).into())
+        }
+    }
+
+    fn allocate_storage_key(&mut self) -> KeyInternal {
+        let mut guard = 0;
+        while self.slab.key_map.contains_key(&Key::new(self.slab.next_key_index)) {
+            self.slab.next_key_index = self.slab.next_key_index.wrapping_add(1);
+            guard += 1;
+            if self.slab.next_key_index == usize::MAX {
+                self.slab.next_key_index = 0;
+            }
+            if guard > self.slab.key_map.len().saturating_add(2) {
+                break;
+            }
+        }
+        KeyInternal::new(self.slab.next_key_index)
+    }
+
+    fn store_data(&mut self, val: Data<T>) -> Key {
+        let mut key = KeyInternal::new(self.slab.inner.insert(val));
+        let key_contained = self.slab.key_map.contains_key(&key.into());
+
+        if key_contained {
+            let key_to_give_out = self.allocate_storage_key();
+            assert!(!self.slab.key_map.contains_key(&key_to_give_out.into()));
+            self.slab.key_map.insert(key_to_give_out.into(), key);
+            key = key_to_give_out;
+        } else if self.slab.compact_called {
+            self.slab.key_map.insert(key.into(), key);
+        }
+
+        key.into()
+    }
+
+    fn take_stored_data(&mut self, key: &Key) -> Data<T> {
+        let remapped_key = if self.slab.compact_called {
+            match self.slab.key_map.remove(key) {
+                Some(key_internal) => key_internal,
+                None => panic!("invalid key"),
+            }
+        } else {
+            (*key).into()
+        };
+
+        self.slab.inner.remove(remapped_key.index)
+    }
+
+    fn shrink_stored_capacity(&mut self) {
+        self.slab.inner.shrink_to_fit();
+        if self.slab.key_map.capacity() > self.slab.key_map.len() {
+            self.slab.key_map.shrink_to_fit();
+        } else {
+            self.slab.key_map.shrink_to_fit();
+        }
+    }
+
+    fn rebuild_identity_key_map(&mut self) {
+        if self.slab.compact_called {
+            return;
+        }
+
+        for (key, _) in self.slab.inner.iter() {
+            self.slab
+                .key_map
+                .insert(Key::new(key), KeyInternal::new(key));
+        }
+    }
+
+    fn apply_key_remapping(&mut self, remapping: &HashMap<usize, usize>) {
+        for internal_key in self.slab.key_map.values_mut() {
+            if let Some(new_internal_key) = remapping.get(&internal_key.index) {
+                *internal_key = KeyInternal::new(*new_internal_key);
+            } else if remapping.is_empty() {
+                continue;
+            }
+        }
+    }
+
+    fn compact_storage(&mut self) {
+        let _ = self.compact_key_capacity_excess();
+        let _ = self.storage_needs_identity_map();
+        let _ = self.key_map_len();
+        self.rebuild_identity_key_map();
+
+        let mut remapping = HashMap::new();
+        self.slab.inner.compact(|_, from, to| {
+            remapping.insert(from, to);
+            true
+        });
+
+        self.apply_key_remapping(&remapping);
+
+        if self.slab.key_map.capacity() > self.slab.key_map.len().saturating_mul(2) {
+            self.slab.key_map.shrink_to_fit();
+        }
