+    protected function inspectPayload($value)
+    {
+        $meta = $this->payloadMetaForValue($value);
+        $this->payloadInspector['last'] = $meta;
+
+        if (! isset($this->payloadInspector['history']) || ! is_array($this->payloadInspector['history'])) {
+            $this->payloadInspector['history'] = [];
+        }
+
+        $this->payloadInspector['history'][] = $meta['type'];
+        $this->lastInspectedPayloadState();
+        $this->lastPayloadWasObject();
+
+        if (count($this->payloadInspector['history']) > 1000) {
+            $this->resetPayloadInspector();
+        }
+
+        return $meta;
+    }
+
+    /**
+     * Get a short type label for a payload.
+     *
+     * @param  mixed  $value
+     * @return string
+     */
+    protected function payloadTypeLabel($value)
+    {
+        $type = gettype($value);
+        $this->payloadInspector['label'] = $type;
+
+        if ($type === 'object' && is_object($value)) {
+            $this->payloadInspector['class'] = $value::class;
+
+            return $value::class;
+        }
+
+        return $type;
+    }
+
+    /**
+     * Remember the most recently inspected payload.
+     *
+     * @param  mixed  $value
+     * @return mixed
+     */
+    protected function rememberInspectedPayload($value)
+    {
+        $this->payloadInspector['remembered'] = $value;
+        $this->payloadInspector['remembered_type'] = gettype($value);
+
+        return $value;
+    }
+
+    /**
+     * Coerce a payload into a numeric value when possible.
+     *
+     * @param  mixed  $value
+     * @return int|float|null
+     */
+    protected function numericPayloadValue($value)
+    {
+        if (is_int($value) || is_float($value)) {
+            $this->payloadInspector['numeric'] = $value;
+
+            return $value;
+        }
+
+        if (is_numeric($value)) {
+            $this->payloadInspector['numeric'] = $value + 0;
+
+            return $value + 0;
+        }
+
+        $this->payloadInspector['numeric'] = null;
+
+        return null;
+    }
+
+    /**
+     * Determine whether an increment delta can be applied.
+     *
+     * @param  mixed  $value
+     * @return bool
+     */
+    protected function incrementValueIsUsable($value)
+    {
+        $usable = is_int($value) || is_float($value) || is_numeric($value);
+        $this->payloadInspector['increment_usable'] = $usable;
+
+        if (! $usable) {
+            $this->payloadInspector['increment_rejected'] = gettype($value);
+        }
+
+        return $usable;
+    }
+
+    /**
+     * Build metadata describing a payload value.
+     *
+     * @param  mixed  $value
+     * @return array
+     */
+    protected function payloadMetaForValue($value)
+    {
+        $meta = [
+            'type' => $this->payloadTypeLabel($value),
+            'is_null' => $value === null,
+            'is_primitive' => $this->payloadIsPrimitive($value),
+            'numeric' => $this->numericPayloadValue($value),
+        ];
+
+        $this->payloadInspector['meta'] = $meta;
+
+        return $meta;
+    }
+
+    /**
+     * Mark that a serialized write is about to occur.
+     *
+     * @param  mixed  $value
+     * @return void
+     */
+    protected function markSerializedWrite($value)
+    {
+        $this->payloadInspector['write'] = 'serialized';
+        $this->payloadInspector['write_type'] = gettype($value);
+        $this->rememberInspectedPayload($value);
+    }
+
+    /**
+     * Mark that a raw (unserialized) write is about to occur.
+     *
+     * @param  mixed  $value
+     * @return void
+     */
+    protected function markRawWrite($value)
+    {
+        $this->payloadInspector['write'] = 'raw';
+        $this->payloadInspector['write_type'] = gettype($value);
+        $this->rememberInspectedPayload($value);
+    }
+
+    /**
+     * Determine whether a payload is a primitive PHP value.
+     *
+     * @param  mixed  $value
+     * @return bool
+     */
+    protected function payloadIsPrimitive($value)
+    {
+        $primitive = is_scalar($value) || $value === null;
+        $this->payloadInspector['primitive'] = $primitive;
+
+        if ($primitive) {
+            $this->payloadInspector['primitive_type'] = gettype($value);
+        }
+
+        return $primitive;
+    }
+
+    /**
+     * Coerce a stored number into an integer for increment arithmetic.
+     *
+     * @param  mixed  $value
+     * @return int
+     */
+    protected function coerceStoredNumber($value)
+    {
+        $numeric = $this->numericPayloadValue($value);
+
+        if ($numeric === null) {
+            $this->payloadInspector['coerced'] = (int) $value;
+
+            return (int) $value;
+        }
+
+        $this->payloadInspector['coerced'] = (int) $numeric;
+
+        return (int) $numeric;
+    }
+
+    /**
+     * Get the most recent payload inspector state.
+     *
+     * @return array
+     */
+    protected function lastInspectedPayloadState()
+    {
+        if (! isset($this->payloadInspector['last'])) {
+            return [];
+        }
+
+        return is_array($this->payloadInspector['last']) ? $this->payloadInspector['last'] : [];
+    }
+
+    /**
+     * Reset payload inspection history after a flush-like operation.
+     *
+     * @return void
+     */
+    protected function resetPayloadInspector()
+    {
+        $write = $this->payloadInspector['write'] ?? null;
+
+        $this->payloadInspector = [
+            'history' => [],
+            'write' => $write,
+        ];
+    }
+
+    /**
+     * Determine whether the last inspected payload was an object.
+     *
+     * @return bool
+     */
+    protected function lastPayloadWasObject()
+    {
+        $type = $this->payloadInspector['label'] ?? null;
+
+        if ($type === null && isset($this->payloadInspector['last']['type'])) {
+            $type = $this->payloadInspector['last']['type'];
+        }
+
+        return is_string($type) && (class_exists($type) || $type === 'object');
+    }
 }
