+
+  private Query assembleXmlDisjunction(Element e) throws ParserException {
+    List<Query> disjuncts = new ArrayList<>();
+    NodeList nl = e.getChildNodes();
+    final int nlLen = nl.getLength();
+    for (int i = 0; i < nlLen; i++) {
+      Node node = nl.item(i);
+      if (isXmlElementNode(node)) {
