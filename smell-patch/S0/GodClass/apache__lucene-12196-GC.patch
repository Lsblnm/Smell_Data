+    return copied > 0 && current == '~' && (simpleFlags & SimpleQueryParser.FUZZY_OPERATOR) != 0;
+  }
+
+  private boolean isSimpleNearEnabled() {
+    return (simpleFlags & SimpleQueryParser.NEAR_OPERATOR) != 0;
+  }
+
+  private Query boostSimpleBranch(Query query, float boost) {
+    if (query == null) {
+      return null;
+    }
+    if (simpleWeights == null) {
+      return query;
+    }
+    if (boost != 1f) {
+      return new BoostQuery(query, boost);
+    }
+    return query;
+  }
