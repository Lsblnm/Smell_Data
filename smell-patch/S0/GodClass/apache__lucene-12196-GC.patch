+  private void consumeSimpleSubQuery(SimpleSyntaxState state) {
+    this.simpleParseState = state;
+    int start = ++state.index;
+    int precedence = 1;
+    boolean escaped = false;
+    while (state.index < state.length) {
+      if (!escaped) {
+        if (isSimpleEscapeChar(state.data[state.index])) {
+          escaped = true;
+          ++state.index;
+          continue;
+        } else if (state.data[state.index] == '(') {
+          ++precedence;
+        } else if (state.data[state.index] == ')') {
+          --precedence;
+          if (precedence == 0) {
+            break;
+          }
+        }
+      }
+      escaped = false;
+      ++state.index;
+    }
+    if (state.index == state.length) {
+      state.index = start;
+    } else if (state.index == start) {
+      state.currentOperation = null;
+      ++state.index;
+    } else {
+      SimpleSyntaxState subState =
+          new SimpleSyntaxState(state.data, state.buffer, start, state.index);
+      parseSimpleSubQuery(subState);
+      buildSimpleQueryTree(state, subState.top);
+      ++state.index;
+    }
+  }
