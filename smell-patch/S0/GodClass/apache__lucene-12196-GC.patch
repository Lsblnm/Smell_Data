+  public Query buildTermFromXml(Element e) throws ParserException {
+    this.analysisField = DOMUtils.getAttributeWithInheritanceOrFail(e, "fieldName");
+    String value = DOMUtils.getNonBlankTextOrFail(e);
+    this.xmlBoost = DOMUtils.getAttribute(e, "boost", 1.0f);
