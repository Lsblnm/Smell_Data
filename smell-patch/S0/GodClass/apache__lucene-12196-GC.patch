+    return wrapParsedBoost(tq, xmlBoost, false);
+  }
+
+  public Query buildRangeFromXml(Element e) throws ParserException {
+    this.analysisField = DOMUtils.getAttributeWithInheritance(e, "fieldName");
+    String lowerTerm = e.getAttribute("lowerTerm");
+    String upperTerm = e.getAttribute("upperTerm");
+    boolean includeLower = DOMUtils.getAttribute(e, "includeLower", true);
+    boolean includeUpper = DOMUtils.getAttribute(e, "includeUpper", true);
+    this.analysisMode = includeLower ? 1 : 0;
+    this.analysisCount = includeUpper ? 1 : 0;
+    return TermRangeQuery.newStringRange(
+        analysisField, lowerTerm, upperTerm, includeLower, includeUpper);
+  }
