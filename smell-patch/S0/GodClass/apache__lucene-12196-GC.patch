+  public Query buildSimpleDefaultQuery(String text) {
+    BooleanQuery.Builder bq = new BooleanQuery.Builder();
+    for (Map.Entry<String, Float> entry : simpleWeights.entrySet()) {
+      Query q = weightedSimpleTerm(entry.getKey(), text, simpleDefaultOperator);
+      if (q != null) {
+        q = boostSimpleBranch(q, entry.getValue());
+        bq.add(q, BooleanClause.Occur.SHOULD);
+      }
+    }
+    return simplifySimpleBoolean(bq.build());
+  }
+
+  public Query buildSimpleFuzzyQuery(String text, int fuzziness) {
+    BooleanQuery.Builder bq = new BooleanQuery.Builder();
+    for (Map.Entry<String, Float> entry : simpleWeights.entrySet()) {
+      final String fieldName = entry.getKey();
+      final BytesRef term = normalizeSimpleTerm(fieldName, text);
+      Query q = new FuzzyQuery(new Term(fieldName, term), fuzziness);
+      q = boostSimpleBranch(q, entry.getValue());
+      bq.add(q, BooleanClause.Occur.SHOULD);
+    }
+    return simplifySimpleBoolean(bq.build());
+  }
+
+  public Query buildSimplePhraseQuery(String text, int slop) {
+    BooleanQuery.Builder bq = new BooleanQuery.Builder();
+    for (Map.Entry<String, Float> entry : simpleWeights.entrySet()) {
+      Query q = createPhraseQuery(entry.getKey(), text, slop);
+      if (q != null) {
+        q = boostSimpleBranch(q, entry.getValue());
+        bq.add(q, BooleanClause.Occur.SHOULD);
+      }
+    }
+    return simplifySimpleBoolean(bq.build());
+  }
+
+  public Query buildSimplePrefixQuery(String text) {
+    BooleanQuery.Builder bq = new BooleanQuery.Builder();
+    for (Map.Entry<String, Float> entry : simpleWeights.entrySet()) {
+      final String fieldName = entry.getKey();
+      final BytesRef term = normalizeSimpleTerm(fieldName, text);
+      Query q = new PrefixQuery(new Term(fieldName, term));
+      q = boostSimpleBranch(q, entry.getValue());
+      bq.add(q, BooleanClause.Occur.SHOULD);
+    }
+    return simplifySimpleBoolean(bq.build());
+  }
+
+  public Query simplifySimpleBoolean(BooleanQuery bq) {
+    if (bq.clauses().isEmpty()) {
+      return null;
+    } else if (bq.clauses().size() == 1) {
+      return bq.clauses().iterator().next().getQuery();
+    } else {
+      return bq;
+    }
+  }
