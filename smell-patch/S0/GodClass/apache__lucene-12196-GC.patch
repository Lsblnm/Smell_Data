+  private Query assembleXmlBoolean(Element e) throws ParserException {
+    BooleanQuery.Builder bq = new BooleanQuery.Builder();
+    bq.setMinimumNumberShouldMatch(currentXmlMinimumShouldMatch());
+    NodeList nl = e.getChildNodes();
+    final int nlLen = nl.getLength();
+    for (int i = 0; i < nlLen; i++) {
+      Node node = nl.item(i);
+      if (isXmlClauseNode(node)) {
+        Element clauseElem = (Element) node;
+        BooleanClause.Occur occurs = resolveXmlOccurs(clauseElem);
+        Element clauseQuery = DOMUtils.getFirstChildOrFail(clauseElem);
+        Query q = xmlChildQuery(clauseQuery);
