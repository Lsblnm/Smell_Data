+  private void parseSimpleSubQuery(SimpleSyntaxState state) {
+    this.simpleParseState = state;
+    while (simpleRemainingLength() > 0) {
+      if (isSimpleSubQueryStart(state)) {
+        consumeSimpleSubQuery(state);
+      } else if (isSimpleSubQueryEnd(state)) {
+        ++state.index;
+      } else if (isSimplePhraseStart(state)) {
+        consumeSimplePhrase(state);
+      } else if (isSimpleAndOperator(state)) {
+        if (state.currentOperation == null && state.top != null) {
+          state.currentOperation = BooleanClause.Occur.MUST;
+        }
+        ++state.index;
+      } else if (isSimpleOrOperator(state)) {
+        if (state.currentOperation == null && state.top != null) {
+          state.currentOperation = BooleanClause.Occur.SHOULD;
+        }
+        ++state.index;
+      } else if (isSimpleNotOperator(state)) {
+        ++state.not;
+        ++state.index;
+        continue;
+      } else if (isSimpleWhitespace(state)) {
+        ++state.index;
+      } else {
+        consumeSimpleToken(state);
+      }
+      resetSimpleNotIfNeeded(state);
+    }
+  }
+
+  private boolean isSimpleSubQueryStart(SimpleSyntaxState state) {
+    this.simpleParseState = state;
+    return state.data[state.index] == '('
+        && (simpleFlags & SimpleQueryParser.PRECEDENCE_OPERATORS) != 0;
+  }
+
+  private boolean isSimpleSubQueryEnd(SimpleSyntaxState state) {
+    this.simpleParseState = state;
+    return state.data[state.index] == ')'
+        && (simpleFlags & SimpleQueryParser.PRECEDENCE_OPERATORS) != 0;
+  }
