+  private boolean isSimpleWhitespace(SimpleSyntaxState state) {
+    this.simpleParseState = state;
+    char current = currentSimpleChar();
+    if ((simpleFlags & SimpleQueryParser.WHITESPACE_OPERATOR) == 0) {
