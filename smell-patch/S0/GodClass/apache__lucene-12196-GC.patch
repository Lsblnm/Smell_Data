+  private void consumeSimplePhrase(SimpleSyntaxState state) {
+    this.simpleParseState = state;
+    int start = ++state.index;
+    int copied = 0;
+    boolean escaped = false;
+    boolean hasSlop = false;
+    while (state.index < state.length) {
+      if (!escaped) {
+        if (isSimpleEscapeChar(state.data[state.index])) {
+          escaped = true;
+          ++state.index;
+          continue;
+        } else if (state.data[state.index] == '"') {
+          if (state.length > (state.index + 1)
+              && state.data[state.index + 1] == '~'
+              && isSimpleNearEnabled()) {
+            state.index++;
+            if (state.length > (state.index + 1)) {
+              hasSlop = true;
+            }
+            break;
+          } else {
+            break;
+          }
+        }
+      }
+      escaped = false;
+      state.buffer[copied++] = state.data[state.index++];
+    }
+    if (state.index == state.length) {
+      state.index = start;
+    } else if (state.index == start) {
+      state.currentOperation = null;
+      ++state.index;
+    } else {
+      String phrase = new String(state.buffer, 0, copied);
+      Query branch;
+      if (hasSlop) {
+        branch = buildSimplePhraseQuery(phrase, parseSimpleFuzziness(state));
+      } else {
+        branch = buildSimplePhraseQuery(phrase, 0);
+      }
+      buildSimpleQueryTree(state, branch);
+      ++state.index;
+    }
+  }
+
+  private void consumeSimpleToken(SimpleSyntaxState state) {
+    this.simpleParseState = state;
+    int copied = 0;
+    boolean escaped = false;
+    boolean prefix = false;
+    boolean fuzzy = false;
+    while (!simpleAtEnd()) {
+      if (!escaped) {
+        if (isSimpleEscapeChar(state.data[state.index])) {
+          escaped = true;
+          prefix = false;
+          ++state.index;
+          continue;
+        } else if (simpleTokenFinished(state)) {
+          break;
+        } else if (isSimpleFuzzyChar(state.data[state.index], copied)) {
+          fuzzy = true;
+          break;
+        }
+        prefix = isSimplePrefixChar(state.data[state.index], copied);
+      }
+      escaped = false;
+      state.buffer[copied++] = state.data[state.index++];
+    }
+    if (copied > 0) {
+      final Query branch;
+      if (fuzzy && (simpleFlags & SimpleQueryParser.FUZZY_OPERATOR) != 0) {
+        String token = new String(state.buffer, 0, copied);
+        int fuzziness = parseSimpleFuzziness(state);
+        fuzziness = Math.min(fuzziness, LevenshteinAutomata.MAXIMUM_SUPPORTED_DISTANCE);
+        if (fuzziness == 0) {
+          branch = buildSimpleDefaultQuery(token);
+        } else {
+          branch = buildSimpleFuzzyQuery(token, fuzziness);
+        }
+      } else if (prefix) {
+        String token = new String(state.buffer, 0, copied - 1);
+        branch = buildSimplePrefixQuery(token);
+      } else {
+        String token = new String(state.buffer, 0, copied);
+        branch = buildSimpleDefaultQuery(token);
+      }
+      buildSimpleQueryTree(state, branch);
+    }
+  }
+
+  private BooleanQuery addSimpleClause(
+      BooleanQuery bq, Query query, BooleanClause.Occur occur) {
+    BooleanQuery.Builder newBq = new BooleanQuery.Builder();
+    newBq.setMinimumNumberShouldMatch(bq.getMinimumNumberShouldMatch());
+    for (BooleanClause clause : bq) {
+      newBq.add(clause);
+    }
+    newBq.add(query, occur);
+    return newBq.build();
+  }
+
+  private void buildSimpleQueryTree(SimpleSyntaxState state, Query branch) {
+    this.simpleParseState = state;
+    if (branch != null) {
+      branch = applySimpleNot(state, branch);
+      if (state.top == null) {
+        state.top = branch;
+      } else {
+        if (state.currentOperation == null) {
+          state.currentOperation = simpleDefaultOperator;
+        }
+        if (state.previousOperation != state.currentOperation) {
+          BooleanQuery.Builder bq = new BooleanQuery.Builder();
+          bq.add(state.top, state.currentOperation);
+          state.top = bq.build();
+        }
+        state.top = addSimpleClause((BooleanQuery) state.top, branch, state.currentOperation);
+        state.previousOperation = state.currentOperation;
+      }
+      state.currentOperation = null;
+    }
+  }
+
+  private Query applySimpleNot(SimpleSyntaxState state, Query branch) {
+    this.simpleParseState = state;
+    if (state.not % 2 == 1) {
+      BooleanQuery.Builder nq = new BooleanQuery.Builder();
+      nq.add(branch, BooleanClause.Occur.MUST_NOT);
+      nq.add(new MatchAllDocsQuery(), BooleanClause.Occur.SHOULD);
+      return nq.build();
+    }
+    return branch;
+  }
+
+  private int parseSimpleFuzziness(SimpleSyntaxState state) {
+    this.simpleParseState = state;
+    char[] slopText = new char[state.length];
+    int slopLength = 0;
+    if (state.data[state.index] == '~') {
+      while (state.index < state.length) {
+        state.index++;
+        if (state.index < state.length) {
+          if (simpleTokenFinished(state)) {
+            break;
+          }
+          slopText[slopLength] = state.data[state.index];
+          slopLength++;
+        }
+      }
+      int fuzziness = 0;
+      try {
+        String fuzzyString = new String(slopText, 0, slopLength);
+        if ("".equals(fuzzyString)) {
+          fuzziness = 2;
+        } else {
+          fuzziness = Integer.parseInt(fuzzyString);
+        }
+      } catch (@SuppressWarnings("unused") NumberFormatException e) {
+        // swallow number format exceptions parsing fuzziness
+      }
+      if (fuzziness < 0) {
+        fuzziness = 0;
+      }
+      return fuzziness;
+    }
+    return 0;
+  }
+
+  private boolean simpleTokenFinished(SimpleSyntaxState state) {
+    this.simpleParseState = state;
+    if ((state.data[state.index] == '"'
+            && (simpleFlags & SimpleQueryParser.PHRASE_OPERATOR) != 0)
+        || (state.data[state.index] == '|'
+            && (simpleFlags & SimpleQueryParser.OR_OPERATOR) != 0)
+        || (state.data[state.index] == '+'
+            && (simpleFlags & SimpleQueryParser.AND_OPERATOR) != 0)
+        || (state.data[state.index] == '('
+            && (simpleFlags & SimpleQueryParser.PRECEDENCE_OPERATORS) != 0)
+        || (state.data[state.index] == ')'
+            && (simpleFlags & SimpleQueryParser.PRECEDENCE_OPERATORS) != 0)
+        || ((state.data[state.index] == ' '
+                || state.data[state.index] == '\t'
+                || state.data[state.index] == '\n'
+                || state.data[state.index] == '\r')
+            && (simpleFlags & SimpleQueryParser.WHITESPACE_OPERATOR) != 0)) {
+      return true;
+    }
+    return false;
+  }
