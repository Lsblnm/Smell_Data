+  public Query parseSimpleSyntax(String queryText) {
+    if ("*".equals(queryText.trim())) {
+      return new MatchAllDocsQuery();
+    }
+    char[] data = queryText.toCharArray();
+    char[] buffer = new char[data.length];
+    SimpleSyntaxState state = new SimpleSyntaxState(data, buffer, 0, data.length);
+    this.simpleParseState = state;
+    parseSimpleSubQuery(state);
+    if (state.top == null) {
+      return new MatchNoDocsQuery("empty string passed to query parser");
+    }
+    return state.top;
+  }
