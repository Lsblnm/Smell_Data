+  public Query rewriteComplexPhrase(
+      String field,
+      String phrasedQueryStringContents,
+      int slopFactor,
+      boolean inOrder,
+      Query contents,
+      IndexSearcher indexSearcher)
+      throws IOException {
+    this.phraseField = field;
+    this.phraseQueryText = phrasedQueryStringContents;
+    this.phraseSlop = slopFactor;
+    this.phraseInOrder = inOrder;
+    this.phraseContents = contents;
+    return rewriteLoadedComplexPhrase(indexSearcher);
+  }
+
+  private Query rewriteLoadedComplexPhrase(IndexSearcher indexSearcher) throws IOException {
+    final Query contents = this.phraseContents;
+    if (isSimplePhraseTerm(contents)) {
+      return contents;
+    }
+    if (!(contents instanceof BooleanQuery)) {
+      throw unknownPhraseQueryType(contents);
+    }
+    BooleanQuery bq = (BooleanQuery) contents;
+    SpanQuery[] allSpanClauses = new SpanQuery[bq.clauses().size()];
+    int numNegatives = 0;
+    int i = 0;
+    for (BooleanClause clause : bq) {
+      Query qc = rewritePhraseClause(indexSearcher, clause);
+      if (isProhibitedClause(clause)) {
+        numNegatives++;
+      }
+      qc = unwrapBoostedQuery(qc);
+      allSpanClauses[i] = spanForPhraseClause(qc);
+      i += 1;
+    }
+    this.analysisCount = numNegatives;
+    if (numNegatives == 0) {
+      return new SpanNearQuery(allSpanClauses, currentPhraseSlop(), phraseUsesInOrder());
+    }
+    return buildSpanNotFromMixedPhrase(bq, allSpanClauses, numNegatives);
+  }
+
+  private boolean isSimplePhraseTerm(Query contents) {
+    this.analysisQuery = contents;
+    this.analysisMode = 1;
+    return contents instanceof TermQuery
+        || contents instanceof MultiTermQuery
+        || contents instanceof SynonymQuery;
+  }
+
+  private Query rewritePhraseClause(IndexSearcher indexSearcher, BooleanClause clause)
+      throws IOException {
+    this.analysisMode = 2;
+    Query qc = clause.getQuery();
+    return indexSearcher.rewrite(qc);
+  }
+
+  private Query unwrapBoostedQuery(Query qc) {
+    this.analysisQuery = qc;
+    while (qc instanceof BoostQuery) {
+      qc = ((BoostQuery) qc).getQuery();
+      this.analysisQuery = qc;
+    }
+    return qc;
+  }
+
+  private SpanQuery spanForPhraseClause(Query qc) {
+    this.analysisQuery = qc;
+    if (qc instanceof BooleanQuery || qc instanceof SynonymQuery) {
+      return spanForBooleanOrSynonym(qc);
+    }
+    if (qc instanceof MatchNoDocsQuery) {
+      return dummyPhraseSpan();
+    }
+    if (qc instanceof TermQuery) {
+      TermQuery tq = (TermQuery) qc;
+      return new SpanTermQuery(tq.getTerm());
+    }
+    throw unknownPhraseQueryType(qc);
+  }
+
+  private SpanQuery spanForBooleanOrSynonym(Query qc) {
+    this.analysisMode = 3;
+    ArrayList<SpanQuery> sc = new ArrayList<>();
+    BooleanQuery booleanClause =
+        qc instanceof BooleanQuery ? (BooleanQuery) qc : convertSynonym((SynonymQuery) qc);
+    addComplexPhraseClause(sc, booleanClause);
+    if (sc.size() > 0) {
+      return sc.get(0);
+    }
+    return dummyPhraseSpan();
+  }
+
+  private IllegalArgumentException unknownPhraseQueryType(Query qc) {
+    this.analysisQuery = qc;
+    return new IllegalArgumentException(
+        "Unknown query type \""
+            + qc.getClass().getName()
+            + "\" found in phrase query string \""
+            + phraseQueryText
+            + "\"");
+  }
+
+  private Query buildSpanNotFromMixedPhrase(
+      BooleanQuery bq, SpanQuery[] allSpanClauses, int numNegatives) {
+    this.analysisCount = numNegatives;
+    ArrayList<SpanQuery> positiveClauses = new ArrayList<>();
+    int i = 0;
+    for (BooleanClause clause : bq) {
+      if (!clause.getOccur().equals(BooleanClause.Occur.MUST_NOT)) {
+        positiveClauses.add(allSpanClauses[i]);
+      }
+      i += 1;
+    }
+    SpanQuery[] includeClauses = positiveClauses.toArray(new SpanQuery[positiveClauses.size()]);
+    SpanQuery include;
+    if (includeClauses.length == 1) {
+      include = includeClauses[0];
+    } else {
+      include = new SpanNearQuery(includeClauses, currentPhraseSlop() + numNegatives, phraseUsesInOrder());
+    }
+    SpanNearQuery exclude = new SpanNearQuery(allSpanClauses, currentPhraseSlop(), phraseUsesInOrder());
+    return new SpanNotQuery(include, exclude);
+  }
+
+  private BooleanQuery convertSynonym(SynonymQuery qc) {
+    this.analysisQuery = qc;
+    BooleanQuery.Builder bqb = new BooleanQuery.Builder();
+    for (Term t : qc.getTerms()) {
+      bqb.add(new BooleanClause(new TermQuery(t), Occur.SHOULD));
+    }
+    return bqb.build();
+  }
+
+  private void addComplexPhraseClause(List<SpanQuery> spanClauses, BooleanQuery qc) {
+    this.analysisQuery = qc;
+    ArrayList<SpanQuery> ors = new ArrayList<>();
+    ArrayList<SpanQuery> nots = new ArrayList<>();
+    for (BooleanClause clause : qc) {
+      Query childQuery = unwrapBoostedQuery(clause.getQuery());
+      ArrayList<SpanQuery> chosenList = ors;
+      if (clause.getOccur() == BooleanClause.Occur.MUST_NOT) {
+        chosenList = nots;
+      }
+      if (childQuery instanceof TermQuery) {
+        TermQuery tq = (TermQuery) childQuery;
+        chosenList.add(new SpanTermQuery(tq.getTerm()));
+      } else if (childQuery instanceof BooleanQuery) {
+        addComplexPhraseClause(chosenList, (BooleanQuery) childQuery);
+      } else if (childQuery instanceof MatchNoDocsQuery) {
+        chosenList.add(dummyPhraseSpan());
+      } else {
+        throw new IllegalArgumentException("Unknown query type:" + childQuery.getClass().getName());
+      }
+    }
+    if (ors.size() == 0) {
+      return;
+    }
