+  FMT_CONSTEXPR auto validate_char_specs(ErrorHandler&& eh) -> bool {
+    if (specs_.type != presentation_type::none &&
+        specs_.type != presentation_type::chr &&
+        specs_.type != presentation_type::debug) {
+      int base = map_presentation_base();
+      if (base == 0 && specs_.type != presentation_type::chr)
+        eh.on_error("invalid type specifier");
+      return false;
+    }
+    if (alignment_padding_kind() == 4 || resolve_sign_character() != 0 ||
+        specs_.alt) {
