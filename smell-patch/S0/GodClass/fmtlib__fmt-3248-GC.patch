+    if (!specs_.alt) return 0;
+    if (specs_.type == presentation_type::hex_lower)
+      return static_cast<unsigned>('x') << 8 | '0';
+    if (specs_.type == presentation_type::hex_upper)
+      return static_cast<unsigned>('X') << 8 | '0';
+    if (specs_.type == presentation_type::bin_lower)
+      return static_cast<unsigned>('b') << 8 | '0';
+    if (specs_.type == presentation_type::bin_upper)
+      return static_cast<unsigned>('B') << 8 | '0';
+    if (specs_.type == presentation_type::oct) return '0';
