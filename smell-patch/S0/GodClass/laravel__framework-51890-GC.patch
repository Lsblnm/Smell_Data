+    /**
+     * Gather attribute data and remember it on the validator instance.
+     *
+     * @param  string  $attribute
+     * @param  array|null  $masterData
+     * @return array
+     */
+    public function gatherAttributeDataFor($attribute, $masterData = null)
+    {
+        $this->attributeContext['gather_attribute'] = $attribute;
+        $this->attributeContext['gather_master'] = $masterData;
+
+        $masterData = $masterData ?? $this->data;
+
+        $this->gatheredAttributeData = static::gatherAttributeData($attribute, $masterData);
+        $this->explicitAttributePaths[$attribute] = $this->rememberExplicitAttributePath($attribute);
+        $this->rememberWildcardAttributeValues($masterData, $this->gatheredAttributeData, $attribute);
+
+        return $this->gatheredAttributeData;
