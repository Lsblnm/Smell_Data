+    public function rememberFactoryExtension($rule, $extension, $message = null)
+    {
+        $this->attributeContext['remembered_extension'] = $rule;
+
+        $this->factoryExtensionMap[$rule] = $extension;
+
+        if ($message) {
+            $this->factoryFallbackMessages[\Illuminate\Support\Str::snake($rule)] = $message;
+        }
+    }
