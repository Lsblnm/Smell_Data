+    protected function applyRememberedFactoryExtensions()
+    {
+        $this->attributeContext['applied_factory_extensions'] = array_keys($this->factoryExtensionMap);
+
+        $this->addExtensions($this->factoryExtensionMap);
+        $this->addImplicitExtensions($this->factoryImplicitExtensionMap);
+        $this->addDependentExtensions($this->factoryDependentExtensionMap);
+        $this->addReplacers($this->factoryReplacerMap);
+        $this->setFallbackMessages($this->factoryFallbackMessages);
+    }
