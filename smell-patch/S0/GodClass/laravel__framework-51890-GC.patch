+    /**
+     * Resolve a validation translation line through the translator.
+     *
+     * @param  string  $key
+     * @param  array  $replace
+     * @param  string|null  $locale
+     * @return mixed
+     */
+    protected function resolveValidationTranslation($key, array $replace = [], $locale = null)
+    {
+        $this->attributeContext['translation_key'] = $key;
+        $this->attributeContext['translation_replace'] = $replace;
+
+        $locale = $locale ?: $this->resolveTranslationLocale();
+        $this->attributeContext['translation_locale'] = $locale;
+
+        $line = $this->translator->get($key, $replace, $locale);
+
+        if (is_string($line) && str_contains($line, '|') && $replace !== []) {
+            $number = $replace['count'] ?? $replace['value'] ?? 1;
+            $line = $this->resolveValidationChoice($line, $number, $replace, $locale);
+        }
+
+        $this->attributeContext['translation_line'] = is_string($line) ? $line : null;
+
+        return $line;
+    }
