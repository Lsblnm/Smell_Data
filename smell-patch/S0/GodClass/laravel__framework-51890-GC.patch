+    protected function allRecordedFailures($format = null)
+    {
+        $this->attributeContext['all_failures_format'] = $format;
+
+        $format = $this->failureFormat($format);
+
+        $all = [];
+
+        foreach ($this->recordedFailureMessages as $key => $messages) {
+            $all = array_merge($all, $this->transformRecordedFailures($messages, $format, $key));
+        }
+
+        return $all;
+    }
+
+    /**
+     * Format recorded failure messages.
+     *
+     * @param  array  $messages
+     * @param  string  $format
+     * @param  string  $messageKey
+     * @return array
+     */
+    protected function transformRecordedFailures($messages, $format, $messageKey)
+    {
+        $this->attributeContext['transformed_failure_key'] = $messageKey;
+
+        if ($format == ':message') {
+            return (array) $messages;
+        }
+
+        $transformed = [];
+
+        foreach ((array) $messages as $message) {
+            $transformed[] = str_replace([':message', ':key'], [$message, $messageKey], $format);
+        }
+
+        return $transformed;
+    }
