+        return $wildcard;
+    }
+
+    /**
+     * Remember the leading explicit path for an attribute in shared context.
+     *
+     * @param  string  $attribute
+     * @return string|null
+     */
+    protected function rememberExplicitAttributePath($attribute)
+    {
+        $path = $this->leadingExplicitAttributePathFor($attribute);
+
+        return $path;
+    }
 }
