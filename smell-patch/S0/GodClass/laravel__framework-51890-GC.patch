+    /**
+     * Replace placeholders in a translated validation line.
+     *
+     * @param  string  $line
+     * @param  array  $replace
+     * @return string
+     */
+    protected function applyValidationTranslationReplacements($line, array $replace)
+    {
+
+        if ($replace === []) {
+            return $line;
+        }
+
+        $shouldReplace = [];
+
+        foreach ($replace as $key => $value) {
+            if (is_object($value) && method_exists($value, '__toString')) {
+                $value = (string) $value;
+            }
+
+            if (is_array($value) || (is_object($value) && ! method_exists($value, '__toString'))) {
+                continue;
+            }
+
+            $shouldReplace[':'.\Illuminate\Support\Str::ucfirst($key)] = \Illuminate\Support\Str::ucfirst($value ?? '');
+            $shouldReplace[':'.$key] = $value;
+        }
+
+        return strtr($line, $shouldReplace);
+    }
