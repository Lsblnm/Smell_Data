+    public function configureExtensionsFromMaps(array $extensions, array $implicitExtensions, array $dependentExtensions, array $replacers, array $fallbackMessages)
+    {
+        $this->attributeContext['factory_extensions'] = array_keys($extensions);
+        $this->attributeContext['factory_replacers'] = array_keys($replacers);
+
+        $this->factoryExtensionMap = [];
+        $this->factoryImplicitExtensionMap = [];
+        $this->factoryDependentExtensionMap = [];
+        $this->factoryReplacerMap = [];
+        $this->factoryFallbackMessages = $fallbackMessages;
+
+        foreach ($extensions as $rule => $extension) {
+            $this->rememberFactoryExtension($rule, $extension);
+        }
+
+        foreach ($implicitExtensions as $rule => $extension) {
+            $this->rememberFactoryImplicitExtension($rule, $extension);
+        }
+
+        foreach ($dependentExtensions as $rule => $extension) {
+            $this->rememberFactoryDependentExtension($rule, $extension);
+        }
+
+        foreach ($replacers as $rule => $replacer) {
+            $this->rememberFactoryReplacer($rule, $replacer);
+        }
+
+        $this->applyRememberedFactoryExtensions();
+    }
