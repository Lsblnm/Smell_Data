+    /**
+     * Determine whether a validation translation exists for the given key.
+     *
+     * @param  string  $key
+     * @param  string|null  $locale
+     * @return bool
+     */
+    protected function hasValidationTranslation($key, $locale = null)
+    {
+        $line = $this->resolveValidationTranslation($key, [], $locale);
+
+        return $line !== $key;
+    }
+
+    /**
+     * Resolve a custom validation translation, including wildcard matches.
+     *
+     * @param  array|string  $keys
+     * @return string
+     */
+    protected function resolveCustomValidationTranslation($keys)
+    {
+        foreach (\Illuminate\Support\Arr::wrap($keys) as $key) {
+            $this->attributeContext['custom_translation_key'] = $key;
+
+            if ($this->hasValidationTranslation($key)) {
+                return $this->resolveValidationTranslation($key);
+            }
+
+            $shortKey = preg_replace('/^validation\.custom\./', '', $key);
+            $custom = $this->translator->get('validation.custom');
+
+            $message = $this->getWildcardCustomMessages(
+                \Illuminate\Support\Arr::dot((array) $custom),
+                $shortKey,
+                $key
+            );
+
+            if ($message !== $key) {
+                return $message;
+            }
+        }
+
+        return \Illuminate\Support\Arr::last(\Illuminate\Support\Arr::wrap($keys));
+    }
