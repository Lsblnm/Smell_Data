+    public function extractAttributeDataFromPathFor($attribute, $masterData = null)
+    {
+        $this->attributeContext['extract_attribute'] = $attribute;
+        $this->attributeContext['extract_master'] = $masterData;
+
+        $masterData = $masterData ?? $this->data;
+
+        $extracted = static::extractAttributeDataFromPath($attribute, $masterData);
+
+        $this->gatheredAttributeData = $extracted;
+        $this->explicitAttributePaths[(string) $attribute] = $attribute;
+
+        return $extracted;
+    }
