+    public static function gatherAttributeData($attribute, $masterData)
+    {
+        $data = \Illuminate\Support\Arr::dot(static::initializeAttributeOnMasterData($attribute, $masterData));
+
+        return array_merge($data, static::extractWildcardValuesFromMasterData(
+            $masterData, $data, $attribute
