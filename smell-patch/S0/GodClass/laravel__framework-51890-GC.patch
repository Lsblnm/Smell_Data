+    /**
+     * Define a set of rules that apply to each element in an array attribute.
+     *
+     * @param  array  $results
+     * @param  string  $attribute
+     * @param  string|array  $rules
+     * @return array
+     */
+    protected function explodeAssignedWildcardRules($results, $attribute, $rules)
+    {
+        $this->attributeContext['wildcard_rule_attribute'] = $attribute;
+
+        $pattern = $this->wildcardAttributePattern($attribute, '[^\.]*');
+
+        $data = $this->gatherAttributeDataFor($attribute, $this->data);
+
+        foreach ($data as $key => $value) {
+            if (\Illuminate\Support\Str::startsWith($key, $attribute) || (bool) preg_match('/^'.$pattern.'\z/', $key)) {
+                foreach ((array) $rules as $rule) {
+                    if (is_object($rule) && get_class($rule) === 'Illuminate\\Validation\\NestedRules') {
+                        $context = \Illuminate\Support\Arr::get($this->data, \Illuminate\Support\Str::beforeLast($key, '.'));
+
+                        $compiled = $this->compileNestedAssignedRules($rule, $key, $value, $data, $context);
+
+                        $this->parsedImplicitAttributes = array_merge_recursive(
+                            $compiled->implicitAttributes,
+                            $this->parsedImplicitAttributes,
+                            [$attribute => [$key]]
+                        );
+
+                        $results = $this->mergeAssignedRules($results, $compiled->rules);
+                    } else {
+                        $this->parsedImplicitAttributes[$attribute][] = $key;
+
+                        $results = $this->mergeAssignedRules($results, $key, $rule);
+                    }
+                }
+            }
+        }
+
+        return $results;
+    }
