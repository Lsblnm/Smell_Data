+    /**
+     * Get all of the exact attribute values for a given wildcard attribute.
+     *
+     * @param  array  $masterData
+     * @param  array  $data
+     * @param  string  $attribute
+     * @return array
+     */
+    protected static function extractWildcardValuesFromMasterData($masterData, $data, $attribute)
+    {
+        $keys = [];
+
+        $pattern = str_replace('\*', '[^\.]+', preg_quote($attribute, '/'));
+
+        foreach ($data as $key => $value) {
+            if ((bool) preg_match('/^'.$pattern.'/', $key, $matches)) {
+                $keys[] = $matches[0];
+            }
+        }
+
+        $keys = array_unique($keys);
+
+        $extracted = [];
+
+        foreach ($keys as $key) {
+            $extracted[$key] = \Illuminate\Support\Arr::get($masterData, $key);
+        }
+
+        return $extracted;
+    }
+
+    /**
+     * Extract data based on the given dot-notated path.
+     *
+     * @param  string|null  $attribute
+     * @param  array  $masterData
+     * @return array
+     */
+    public static function extractAttributeDataFromPath($attribute, $masterData)
+    {
+        $results = [];
+
+        $value = \Illuminate\Support\Arr::get($masterData, $attribute, '__missing__');
+
+        if ($value !== '__missing__') {
+            \Illuminate\Support\Arr::set($results, $attribute, $value);
+        }
+
+        return $results;
+    }
+
