+     * @param  string|null  $key
+     * @param  string|null  $format
+     * @return string
+     */
+    protected function firstRecordedFailure($key = null, $format = null)
+    {
+        $this->attributeContext['first_failure_key'] = $key;
+
+        $messages = is_null($key) ? $this->allRecordedFailures($format) : $this->recordedFailuresFor($key, $format);
+
+        $firstMessage = \Illuminate\Support\Arr::first($messages, null, '');
+
+        return is_array($firstMessage) ? \Illuminate\Support\Arr::first($firstMessage) : $firstMessage;
+    }
+
+    /**
+     * Get recorded failures for a key.
+     *
+     * @param  string  $key
+     * @param  string|null  $format
+     * @return array
+     */
+    protected function recordedFailuresFor($key, $format = null)
+    {
+        $this->attributeContext['failures_for_key'] = $key;
+
+        if (array_key_exists($key, $this->recordedFailureMessages)) {
+            return $this->transformRecordedFailures(
+                $this->recordedFailureMessages[$key], $this->failureFormat($format), $key
+            );
+        }
