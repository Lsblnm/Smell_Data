+    /**
+     * Extract the rule name and parameters from a rule.
+     *
+     * @param  array|string|object  $rule
+     * @return array
+     */
+    public static function parseAssignedRule($rule)
+    {
+        if ($rule instanceof \Illuminate\Contracts\Validation\Rule ||
+            (is_object($rule) && get_class($rule) === 'Illuminate\\Validation\\NestedRules')) {
+            return [$rule, []];
+        }
+
+        if (is_array($rule)) {
+            $rule = static::parseAssignedArrayRule($rule);
+        } else {
+            $rule = static::parseAssignedStringRule($rule);
+        }
+
+        $rule[0] = static::normalizeAssignedRule($rule[0]);
+
+        return $rule;
+    }
+
+    /**
+     * Parse an array based rule.
+     *
+     * @param  array  $rule
+     * @return array
+     */
+    protected static function parseAssignedArrayRule(array $rule)
+    {
+        return [\Illuminate\Support\Str::studly(trim(\Illuminate\Support\Arr::get($rule, 0, ''))), array_slice($rule, 1)];
+    }
+
+    /**
+     * Parse a string based rule.
+     *
+     * @param  string  $rule
+     * @return array
+     */
+    protected static function parseAssignedStringRule($rule)
+    {
+        $parameters = [];
+
+        if (str_contains($rule, ':')) {
+            [$rule, $parameter] = explode(':', $rule, 2);
+
+            $parameters = static::parseAssignedParameters($rule, $parameter);
+        }
+
+        return [\Illuminate\Support\Str::studly(trim($rule)), $parameters];
+    }
+
+    /**
+     * Parse a parameter list.
+     *
+     * @param  string  $rule
+     * @param  string  $parameter
+     * @return array
+     */
+    protected static function parseAssignedParameters($rule, $parameter)
+    {
+        return static::assignedRuleIsRegex($rule) ? [$parameter] : str_getcsv($parameter);
+    }
+
+    /**
+     * Determine if the rule is a regular expression.
+     *
+     * @param  string  $rule
+     * @return bool
+     */
+    protected static function assignedRuleIsRegex($rule)
+    {
+        return in_array(strtolower($rule), ['regex', 'not_regex', 'notregex'], true);
+    }
+
+    /**
+     * Normalizes a rule so that we can accept short types.
+     *
+     * @param  string  $rule
+     * @return string
+     */
+    protected static function normalizeAssignedRule($rule)
+    {
+        return match ($rule) {
+            'Int' => 'Integer',
+            'Bool' => 'Boolean',
+            default => $rule,
+        };
+    }
+
+    /**
+     * Expand the conditional rules in the given array of rules.
+     *
+     * @param  array  $rules
+     * @param  array  $data
+     * @return array
+     */
+    public static function filterAssignedConditionalRules($rules, array $data = [])
+    {
+        return collect($rules)->mapWithKeys(function ($attributeRules, $attribute) use ($data) {
+            if (! is_array($attributeRules) &&
+                ! $attributeRules instanceof \Illuminate\Validation\ConditionalRules) {
+                return [$attribute => $attributeRules];
+            }
+
+            if ($attributeRules instanceof \Illuminate\Validation\ConditionalRules) {
+                return [$attribute => $attributeRules->passes($data)
+                                ? array_filter($attributeRules->rules($data))
+                                : array_filter($attributeRules->defaultRules($data)), ];
+            }
+
+            return [$attribute => collect($attributeRules)->map(function ($rule) use ($data) {
+                if (! $rule instanceof \Illuminate\Validation\ConditionalRules) {
+                    return [$rule];
+                }
+
+                return $rule->passes($data) ? $rule->rules($data) : $rule->defaultRules($data);
+            })->filter()->flatten(1)->values()->all()];
+        })->all();
+    }
