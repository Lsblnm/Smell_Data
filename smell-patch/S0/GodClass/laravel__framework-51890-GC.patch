+     * @param  string  $key
+     * @param  string|null  $format
+     * @return array
+     */
+    protected function recordedFailuresForWildcardKey($key, $format)
+    {
+        $this->attributeContext['wildcard_failure_key'] = $key;
+
+        $results = [];
+
+        foreach ($this->recordedFailureMessages as $messageKey => $messages) {
+            if (\Illuminate\Support\Str::is($key, $messageKey)) {
+                $results[$messageKey] = $this->transformRecordedFailures(
+                    $messages, $this->failureFormat($format), $messageKey
+                );
+            }
+        }
+
+        return $results;
+    }
+
+    /**
+     * Get all recorded failure messages.
+     *
+     * @param  string|null  $format
+     * @return array
