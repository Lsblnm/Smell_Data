+    protected function selectPluralLine($line, $number, $locale)
+    {
+
+        $segments = explode('|', $line);
+
+        if (($value = $this->extractPluralSegment($segments, $number)) !== null) {
+            return trim($value);
+        }
+
+        $segments = $this->stripPluralConditions($segments);
+
+        $pluralIndex = $this->pluralIndexForLocale($locale, $number);
+
+        if (count($segments) === 1 || ! isset($segments[$pluralIndex])) {
+            return $segments[0];
+        }
+
+        return $segments[$pluralIndex];
+    }
