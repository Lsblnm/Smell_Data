+    /**
+     * Determine if a recorded failure message is unique.
+     *
+     * @param  string  $key
+     * @param  string  $message
+     * @return bool
+     */
+    protected function failureMessageIsUnique($key, $message)
+    {
+        $this->attributeContext['unique_failure_key'] = $key;
+
+        $messages = (array) $this->recordedFailureMessages;
+
+        return ! isset($messages[$key]) || ! in_array($message, $messages[$key]);
+    }
+
+    /**
+     * Determine if a failure has been recorded for the given key.
+     *
+     * @param  array|string|null  $key
+     * @return bool
+     */
+    protected function hasRecordedFailure($key)
+    {
+        $this->attributeContext['has_failure_key'] = $key;
+
+        if ($this->recordedFailureMessages === []) {
+            return false;
+        }
+
+        if (is_null($key)) {
+            return $this->recordedFailureMessages !== [];
+        }
+
+        $keys = is_array($key) ? $key : func_get_args();
+
+        foreach ($keys as $failureKey) {
+            if ($this->firstRecordedFailure($failureKey) === '') {
+                return false;
+            }
+        }
+
+        return true;
+    }
+
+    /**
+     * Get the first recorded failure for a key.
