+        return collect($segments)
+            ->map(fn ($part) => preg_replace('/^[\{\[]([^\[\]\{\}]*)[\}\]]/', '', $part))
+            ->all();
+    }
+
+    protected function pluralIndexForLocale($locale, $number)
+    {
+        if ($this->translator instanceof Translator) {
+            $this->translationMessageSelector = $this->translator->getSelector();
+
+            return $this->translationMessageSelector->getPluralIndex($locale, $number);
+        }
+
+        $locale = str_replace('-', '_', (string) $locale);
+
+        if (in_array($locale, ['zh', 'zh_CN', 'zh_TW', 'ja', 'ja_JP', 'ko', 'ko_KR', 'vi', 'th', 'id'], true)) {
+            return 0;
+        }
+
+        return ((int) $number == 1) ? 0 : 1;
+    }
