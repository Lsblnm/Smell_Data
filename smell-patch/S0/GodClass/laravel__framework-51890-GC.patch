+        $locale = $this->resolveTranslationLocale();
+        $this->pluralSelectionNumber = (int) $number;
+        $this->pluralSelectionLocale = $locale;
+        $this->attributeContext['translated_line'] = $line;
+        $this->attributeContext['translated_number'] = (int) $number;
+        $this->attributeContext['translated_locale'] = $locale;
+        $this->lastPluralIndex = $this->pluralIndexForLocale($locale, (int) $number);
