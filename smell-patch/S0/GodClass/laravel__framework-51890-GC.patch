+    /**
+     * Record a formatted failure message on the validator.
+     *
+     * @param  string  $key
+     * @param  string  $message
+     * @return void
+     */
+    public function recordFormattedFailure($key, $message)
+    {
+        $this->attributeContext['recorded_failure_key'] = $key;
+        $this->attributeContext['recorded_failure_message'] = $message;
+
+        if ($this->failureMessageIsUnique($key, $message)) {
+            $this->recordedFailureMessages[$key][] = $message;
+            $this->recordedFailureKeys[$key] = $key;
+        }
+
+        if ($this->messages) {
+            $this->messages->add($key, $message);
+        }
+
+        $this->attributeContext['failure_keys'] = $this->recordedFailureMessageKeys();
+        $this->attributeContext['failure_count'] = $this->countRecordedFailures();
+        $this->attributeContext['failures_are_empty'] = $this->recordedFailuresAreEmpty();
+        $this->attributeContext['has_any_failure'] = $this->hasAnyRecordedFailure($key);
+        $this->attributeContext['missing_failure'] = $this->missingRecordedFailure($key);
+        $this->attributeContext['unique_failures'] = $this->uniqueRecordedFailures();
+        $this->attributeContext['failure_summary'] = $this->summarizeRecordedFailures();
+        $this->setFailureMessageFormat($this->failureMessageFormat);
+    }
