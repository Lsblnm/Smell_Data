+    /**
+     * Explode the given rules into a full rules array for the validator.
+     *
+     * @param  array  $rules
+     * @return \stdClass
+     */
+    public function explodeAssignedRules($rules)
+    {
+        $this->attributeContext['exploded_rule_keys'] = array_keys((array) $rules);
+
+        $this->parsedImplicitAttributes = [];
+
+        $rules = $this->explodeAssignedRuleList($rules);
+
+        $this->parsedRuleSet = $rules;
+
+        return (object) [
+            'rules' => $rules,
+            'implicitAttributes' => $this->parsedImplicitAttributes,
+        ];
+    }
+
+    /**
+     * Explode the rules into an array of explicit rules.
+     *
+     * @param  array  $rules
+     * @return array
+     */
+    protected function explodeAssignedRuleList($rules)
+    {
+        $this->attributeContext['explicit_rule_keys'] = array_keys((array) $rules);
+
+        foreach ($rules as $key => $rule) {
+            if ($this->attributePathIsWildcard($key)) {
+                $rules = $this->explodeAssignedWildcardRules($rules, $key, [$rule]);
+
+                unset($rules[$key]);
+            } else {
+                $rules[$key] = $this->explodeAssignedExplicitRule($rule, $key);
+            }
+        }
+
+        return $rules;
+    }
+
+    /**
+     * Explode the explicit rule into an array if necessary.
+     *
+     * @param  mixed  $rule
+     * @param  string  $attribute
+     * @return array
+     */
+    protected function explodeAssignedExplicitRule($rule, $attribute)
+    {
+        $this->attributeContext['explicit_rule_attribute'] = $attribute;
+
+        if (is_string($rule)) {
+            return explode('|', $rule);
+        }
+
+        if (is_object($rule)) {
+            return \Illuminate\Support\Arr::wrap($this->prepareAssignedRule($rule, $attribute));
+        }
+
+        return array_map(
+            [$this, 'prepareAssignedRule'],
+            $rule,
+            array_fill((int) array_key_first($rule), count($rule), $attribute)
+        );
+    }
