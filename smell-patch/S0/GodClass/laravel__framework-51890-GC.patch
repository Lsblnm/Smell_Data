+    /**
+     * Merge additional rules into a given attribute(s).
+     *
+     * @param  array  $results
+     * @param  string|array  $attribute
+     * @param  string|array  $rules
+     * @return array
+     */
+    public function mergeAssignedRules($results, $attribute, $rules = [])
+    {
+        $this->attributeContext['merged_rule_attribute'] = is_array($attribute) ? array_keys($attribute) : $attribute;
+
+        if (is_array($attribute)) {
+            foreach ((array) $attribute as $innerAttribute => $innerRules) {
+                $results = $this->mergeAssignedRulesForAttribute($results, $innerAttribute, $innerRules);
+            }
+
+            return $results;
+        }
+
+        return $this->mergeAssignedRulesForAttribute(
+            $results, $attribute, $rules
+        );
+    }
+
+    /**
+     * Merge additional rules into a given attribute.
+     *
+     * @param  array  $results
+     * @param  string  $attribute
+     * @param  string|array  $rules
+     * @return array
+     */
+    protected function mergeAssignedRulesForAttribute($results, $attribute, $rules)
+    {
+        $this->attributeContext['merged_for_attribute'] = $attribute;
+
+        $merge = head($this->explodeAssignedRuleList([$rules]));
+
+        $results[$attribute] = array_merge(
+            isset($results[$attribute]) ? $this->explodeAssignedExplicitRule($results[$attribute], $attribute) : [], $merge
+        );
+
+        return $results;
+    }
