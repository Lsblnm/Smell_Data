+    /**
+     * Choose a pluralized validation line using the translator selector.
+     *
+     * @param  string  $line
+     * @param  mixed  $number
+     * @param  array  $replace
+     * @param  string|null  $locale
+     * @return string
+     */
+    protected function resolveValidationChoice($line, $number, array $replace = [], $locale = null)
+    {
+        $locale = $locale ?: $this->resolveTranslationLocale();
+
+        if (is_countable($number)) {
+            $number = count($number);
+        }
+
+        $number = (int) $number;
+        $replace['count'] = $number;
+        $this->attributeContext['choice_number'] = $number;
+        $this->attributeContext['choice_locale'] = $locale;
+
+        if ($this->translator instanceof Translator) {
+            $this->translationMessageSelector = $this->translator->getSelector();
+            $chosen = $this->translationMessageSelector->choose($line, $number, $locale);
