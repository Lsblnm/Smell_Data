+    /**
+     * Prepare the given rule for the validator.
+     *
+     * @param  mixed  $rule
+     * @param  string  $attribute
+     * @return mixed
+     */
+    protected function prepareAssignedRule($rule, $attribute)
+    {
+        $this->attributeContext['prepared_rule_attribute'] = $attribute;
+
+        if ($rule instanceof \Closure) {
+            $rule = new \Illuminate\Validation\ClosureValidationRule($rule);
+        }
+
+        if ($rule instanceof \Illuminate\Contracts\Validation\InvokableRule || $rule instanceof \Illuminate\Contracts\Validation\ValidationRule) {
+            $rule = \Illuminate\Validation\InvokableValidationRule::make($rule);
+        }
+
+        if (! is_object($rule) ||
+            $rule instanceof \Illuminate\Contracts\Validation\Rule ||
+            ($rule instanceof \Illuminate\Validation\Rules\Exists && $rule->queryCallbacks()) ||
+            ($rule instanceof \Illuminate\Validation\Rules\Unique && $rule->queryCallbacks())) {
+            return $rule;
+        }
+
+        if (is_object($rule) && get_class($rule) === 'Illuminate\\Validation\\NestedRules') {
+            return $this->compileNestedAssignedRules(
+                $rule, $attribute, $this->data[$attribute] ?? null, \Illuminate\Support\Arr::dot($this->data), $this->data
+            )->rules[$attribute];
+        }
+
+        return (string) $rule;
+    }
