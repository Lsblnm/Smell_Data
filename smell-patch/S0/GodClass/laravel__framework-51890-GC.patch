+        if ($this->translator instanceof Translator) {
+            $this->translationMessageSelector = $this->translator->getSelector();
+            $this->lastChosenTranslationLine = $this->translationMessageSelector->choose(
+                $line, (int) $number, $locale
+            );
+
+            return $this->lastChosenTranslationLine;
+        }
+
+        $this->lastChosenTranslationLine = $this->selectPluralLine($line, (int) $number, $locale);
