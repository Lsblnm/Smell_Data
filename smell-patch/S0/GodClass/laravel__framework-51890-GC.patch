+    /**
+     * Gather a copy of the attribute data filled with any missing attributes.
+     *
+     * @param  string  $attribute
+     * @param  array  $masterData
+     * @return array
+     */
+    protected static function initializeAttributeOnMasterData($attribute, $masterData)
+    {
+        $explicitPath = static::leadingExplicitAttributePath($attribute);
+
+        $data = static::extractAttributeDataFromPath($explicitPath, $masterData);
+
+        if (! str_contains($attribute, '*') || str_ends_with($attribute, '*')) {
+            return $data;
+        }
+
+        return data_set($data, $attribute, null, true);
+    }
