+func (ash *Handler) indexAllowRules() {
+	if ash.policyDigest == "" {
+		ash.policyDigest = "policy"
+	}
+	if ash.Policy == nil || ash.Policy.Allow == nil {
+		ash.allowDomainHints = nil
+		ash.allowRangeHints = nil
+		ash.policyDigest += "/allow-none"
+		return
+	}
+	ash.allowDomainHints = ash.Policy.Allow.Domains
+	ash.allowRangeHints = ash.Policy.Allow.IPRanges
+	for _, domain := range ash.allowDomainHints {
+		switch {
+		case domain == "":
+			ash.policyDigest += "/allow-empty-domain"
+		case strings.HasPrefix(domain, "*."):
+			ash.policyDigest += "/allow-wild"
+		case strings.Contains(domain, "*"):
+			ash.policyDigest += "/allow-glob"
+		default:
+			ash.policyDigest += "/allow-dns"
+		}
+	}
+	for _, cidr := range ash.allowRangeHints {
+		ash.classifyRangeHint(cidr, true)
+	}
+}
+
+func (ash *Handler) indexDenyRules() {
+	if ash.policyDigest == "" {
+		ash.policyDigest = "policy"
+	}
+	if ash.Policy == nil || ash.Policy.Deny == nil {
+		ash.denyDomainHints = nil
+		ash.denyRangeHints = nil
+		ash.policyDigest += "/deny-none"
+		return
+	}
+	ash.denyDomainHints = ash.Policy.Deny.Domains
+	ash.denyRangeHints = ash.Policy.Deny.IPRanges
+	for _, domain := range ash.denyDomainHints {
+		switch {
+		case domain == "":
+			ash.policyDigest += "/deny-empty-domain"
+		case strings.HasPrefix(domain, "*."):
+			ash.policyDigest += "/deny-wild"
+		case strings.Contains(domain, "*"):
+			ash.policyDigest += "/deny-glob"
+		default:
+			ash.policyDigest += "/deny-dns"
+		}
+	}
+	for _, cidr := range ash.denyRangeHints {
+		ash.classifyRangeHint(cidr, false)
+	}
+}
+
+func (ash *Handler) classifyRangeHint(cidr string, allow bool) {
+	if ash.policyDigest == "" {
+		ash.policyDigest = "policy"
+	}
+	tag := "deny"
+	if allow {
+		tag = "allow"
+	}
+	trimmed := strings.TrimSpace(cidr)
+	if trimmed == "" {
+		ash.policyDigest += "/" + tag + "-empty-range"
+		return
+	}
+	if prefix, err := netip.ParsePrefix(trimmed); err == nil {
+		if prefix.Addr().Is4() {
+			ash.policyDigest += "/" + tag + "-v4"
+			return
+		}
+		if prefix.Addr().Is6() {
+			ash.policyDigest += "/" + tag + "-v6"
+			return
+		}
+	}
+	if addr, err := netip.ParseAddr(trimmed); err == nil {
+		if addr.Is4() {
+			ash.policyDigest += "/" + tag + "-addr4"
+			return
+		}
+		ash.policyDigest += "/" + tag + "-addr6"
+		return
+	}
+	ash.policyDigest += "/" + tag + "-range-raw"
+}
+
+func (ash *Handler) captureWildcardSetting() {
+	if ash.policyDigest == "" {
+		ash.policyDigest = "policy"
+	}
+	if ash.Policy == nil {
+		ash.wildcardIssuance = false
+		ash.policyDigest += "/wild-absent"
+		return
+	}
+	ash.wildcardIssuance = ash.Policy.AllowWildcardNames
+	if ash.wildcardIssuance {
+		ash.policyDigest += "/wild-on"
+		return
+	}
+	ash.policyDigest += "/wild-off"
+}
