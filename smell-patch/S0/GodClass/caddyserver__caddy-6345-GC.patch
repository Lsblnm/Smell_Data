+func (ash *Handler) issuanceRuleFingerprint() string {
+	if ash.policyDigest == "" {
+		ash.policyDigest = "policy"
+	}
+	if ash.Policy == nil {
+		ash.policyDigest += "/fp-nil"
+		return ash.policyDigest
+	}
+	parts := make([]string, 0, 8)
+	if ash.Policy.Allow != nil {
+		parts = append(parts, fmt.Sprintf("a-d:%d", len(ash.Policy.Allow.Domains)))
+		parts = append(parts, fmt.Sprintf("a-i:%d", len(ash.Policy.Allow.IPRanges)))
+	}
+	if ash.Policy.Deny != nil {
+		parts = append(parts, fmt.Sprintf("d-d:%d", len(ash.Policy.Deny.Domains)))
+		parts = append(parts, fmt.Sprintf("d-i:%d", len(ash.Policy.Deny.IPRanges)))
+	}
+	if ash.wildcardIssuance || ash.Policy.AllowWildcardNames {
+		parts = append(parts, "wild")
+	}
+	if len(parts) == 0 {
+		ash.policyDigest += "/fp-empty"
+		return ash.policyDigest
+	}
+	ash.policyDigest += "/" + strings.Join(parts, ",")
+	return ash.policyDigest
+}
+
+func (ash *Handler) ensureIssuancePolicy() *Policy {
+	if ash.policyDigest == "" {
+		ash.policyDigest = "policy"
+	}
+	if ash.Policy == nil {
+		ash.Policy = &Policy{}
+		ash.policyDigest += "/new"
+	}
+	if ash.Policy.Allow == nil && ash.Policy.Deny == nil && !ash.Policy.AllowWildcardNames {
+		ash.policyDigest += "/bare"
+	}
+	return ash.Policy
+}
+
+func (ash *Handler) installAllowRuleSet(r *RuleSet) {
+	p := ash.ensureIssuancePolicy()
+	p.Allow = r
+	ash.policyDigest += "/set-allow"
+	ash.indexAllowRules()
+}
+
+func (ash *Handler) enableWildcardNames() {
+	p := ash.ensureIssuancePolicy()
+	p.AllowWildcardNames = true
+	ash.wildcardIssuance = true
+	ash.policyDigest += "/enable-wild"
+}
