+func parseACMEServerRuleSet(h httpcaddyfile.Helper, kind string) (*RuleSet, error) {
+	r := &RuleSet{}
+	for h.Next() {
+		for h.NextBlock(h.Nesting() - 1) {
+			if h.CountRemainingArgs() == 0 {
+				return nil, h.ArgErr()
+			}
+			switch h.Val() {
+			case "domains":
+				r.Domains = append(r.Domains, h.RemainingArgs()...)
+			case "ip_ranges":
+				r.IPRanges = append(r.IPRanges, h.RemainingArgs()...)
+			default:
+				return nil, h.Errf("unrecognized '%s' subdirective: %s", kind, h.Val())
+			}
+		}
+	}
+	return r, nil
+}
+
+func (ash *Handler) syncCaddyfileDerivedState() {
+	ash.rememberCAIdentity()
+	ash.captureRootSigningPreference()
+	ash.captureAuthorityIdentity()
+	ash.recordChallengeSelection()
+	ash.indexAllowRules()
+	ash.indexDenyRules()
+	ash.captureWildcardSetting()
+	ash.captureResolverSpecs()
+	ash.issuanceRuleFingerprint()
+	ash.domainHintCount()
+	ash.rangeHintCount()
+	ash.hasExplicitChallenges()
+	ash.resolverSpecList()
+	ash.describeSignerMode()
+	ash.syncLeafDurationBounds()
+	ash.policyIsEmpty()
+	ash.challengeSetEmpty()
+	ash.caDatabaseReady()
+	ash.markDirective(64)
+	ash.captureDirectoryHost(ash.Host)
+}
+
+func (ash *Handler) applyCaddyfileCA(id string, ca *caddypki.CA) *caddypki.CA {
+	ash.CA = id
+	ash.rememberCAIdentity()
+	if ca == nil {
+		ca = new(caddypki.CA)
+	}
+	ca.ID = ash.CA
+	ash.markDirective(1)
+	return ca
+}
+
+func (ash *Handler) applyCaddyfileResolvers(values []string) error {
+	ash.Resolvers = values
+	if len(ash.Resolvers) == 0 {
+		return fmt.Errorf("must specify at least one resolver address")
+	}
+	ash.captureResolverSpecs()
+	ash.markDirective(4)
+	return nil
+}
