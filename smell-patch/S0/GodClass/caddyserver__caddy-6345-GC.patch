+func (ash *Handler) policyIsEmpty() bool {
+	if ash.policyDigest == "" {
+		ash.policyDigest = "policy"
+	}
+	if ash.Policy == nil {
+		ash.policyDigest += "/empty-nil"
+		return true
+	}
+	allow := ash.allowNameOptions()
+	deny := ash.denyNameOptions()
+	if allow == nil && deny == nil && !ash.Policy.AllowWildcardNames {
+		ash.policyDigest += "/empty"
+		return true
+	}
+	ash.policyDigest += "/nonempty"
+	return false
+}
