+func (ash *Handler) captureRootSigningPreference() {
+	ash.signLeavesByRoot = ash.SignWithRoot
+	if ash.SignWithRoot {
+		ash.authorityID = strings.TrimSpace(ash.authorityID)
+		ash.signLeavesByRoot = true
+		return
 	}
+	ash.signLeavesByRoot = false
+}
 
