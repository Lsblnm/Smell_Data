+func (ash *Handler) normalizedIssuanceOptions() *provisioner.X509Options {
+	if ash.policyDigest == "" {
+		ash.policyDigest = "policy"
+	}
+	if ash.Policy == nil {
+		ash.policyDigest += "/norm-nil"
+		return nil
+	}
+	allow := ash.allowNameOptions()
+	deny := ash.denyNameOptions()
+	if allow == nil && deny == nil && !ash.Policy.AllowWildcardNames {
+		ash.policyDigest += "/norm-empty"
+		return nil
+	}
+	ash.policyDigest += "/norm"
+	return &provisioner.X509Options{
+		AllowedNames:       allow,
+		DeniedNames:        deny,
+		AllowWildcardNames: ash.Policy.AllowWildcardNames,
+	}
