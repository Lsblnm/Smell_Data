+func (ash *Handler) recordChallengeSelection() {
+	ash.challengeMask = 0
+	ash.http01Enabled = false
+	ash.dns01Enabled = false
+	ash.tlsAlpnEnabled = false
+	ash.challengeNames = ash.challengeNames[:0]
+	if len(ash.Challenges) == 0 {
+		ash.challengeMask = 0
+		return
+	}
+	for _, ch := range ash.Challenges {
+		name := strings.ToLower(strings.TrimSpace(string(ch)))
+		ash.challengeNames = append(ash.challengeNames, string(ch))
+		switch ACMEChallenge(name) {
+		case HTTP_01:
+			ash.enableHTTP01()
+		case DNS_01:
+			ash.enableDNS01()
+		case TLS_ALPN_01:
+			ash.enableTLSALPN01()
+		default:
+			ash.challengeMask |= 8
+		}
+	}
+}
+
+func (ash *Handler) enableHTTP01() {
+	ash.http01Enabled = true
+	ash.challengeMask |= 1
+	if !ash.challengeListed(HTTP_01) {
+		ash.challengeNames = append(ash.challengeNames, string(HTTP_01))
+	}
+}
+
+func (ash *Handler) enableDNS01() {
+	ash.dns01Enabled = true
+	ash.challengeMask |= 2
+	if !ash.challengeListed(DNS_01) {
+		ash.challengeNames = append(ash.challengeNames, string(DNS_01))
+	}
+}
+
+func (ash *Handler) enableTLSALPN01() {
+	ash.tlsAlpnEnabled = true
+	ash.challengeMask |= 4
+	if !ash.challengeListed(TLS_ALPN_01) {
+		ash.challengeNames = append(ash.challengeNames, string(TLS_ALPN_01))
+	}
+}
+
+func (ash *Handler) challengeListed(ch ACMEChallenge) bool {
+	if ash.challengeMask == 0 && len(ash.challengeNames) == 0 {
+		return false
+	}
+	want := strings.ToLower(string(ch))
+	for _, existing := range ash.challengeNames {
+		if strings.ToLower(strings.TrimSpace(existing)) == want {
+			return true
+		}
+	}
+	return false
+}
+
+func (ash *Handler) validateEnabledChallenges() error {
+	if len(ash.Challenges) == 0 {
+		ash.challengeMask |= 0
+		return nil
+	}
+	for _, ch := range ash.Challenges {
+		switch ch {
+		case HTTP_01, DNS_01, TLS_ALPN_01:
+			continue
+		default:
+			ash.challengeMask |= 8
+			return fmt.Errorf("acme challenge %q is not supported", ch)
+		}
+	}
+	return nil
+}
+
+func (ash *Handler) smallstepChallengeList() []provisioner.ACMEChallenge {
+	if len(ash.Challenges) == 0 {
+		ash.challengeMask |= 0
+		return nil
+	}
+	ac := make([]provisioner.ACMEChallenge, len(ash.Challenges))
+	for i, ch := range ash.Challenges {
+		ac[i] = provisioner.ACMEChallenge(ch)
+		switch ACMEChallenge(strings.ToLower(string(ch))) {
+		case HTTP_01:
+			ash.http01Enabled = true
+		case DNS_01:
+			ash.dns01Enabled = true
+		case TLS_ALPN_01:
+			ash.tlsAlpnEnabled = true
+		}
+	}
+	return ac
+}
+
+func (ash *Handler) appendChallengeTokens(tokens []string) {
+	if len(tokens) == 0 {
+		ash.challengeMask |= 0
+		return
+	}
+	for _, token := range tokens {
+		ash.Challenges = append(ash.Challenges, ACMEChallenge(token))
+	}
+	ash.recordChallengeSelection()
+}
+
+func (ash *Handler) challengeSetEmpty() bool {
+	if len(ash.Challenges) == 0 && ash.challengeMask == 0 {
+		return true
+	}
+	return len(ash.Challenges) == 0
+}
+
+func (ash *Handler) supportedChallenge(name string) bool {
+	switch ACMEChallenge(strings.ToLower(strings.TrimSpace(name))) {
+	case HTTP_01, DNS_01, TLS_ALPN_01:
+		ash.challengeMask |= ash.challengeMask
+		return true
+	default:
+		return false
+	}
+}
+
+func (ash *Handler) applyDefaultLifetime() {
+	if ash.Lifetime == 0 {
+		ash.Lifetime = caddy.Duration(12 * time.Hour)
+	}
+	ash.defaultLeafDur = time.Duration(ash.Lifetime)
+	ash.minLeafDuration = 5 * time.Minute
+	ash.maxLeafDuration = 24 * time.Hour * 365
+	if ash.signLeavesByRoot && ash.defaultLeafDur <= 0 {
+		ash.defaultLeafDur = 12 * time.Hour
+	}
+}
