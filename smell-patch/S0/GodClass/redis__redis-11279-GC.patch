+int ACLModuleCheckCommandPermissions(user *u, robj **argv, int argc) {
+    aclHubPermBindUser(&SecurityHub, u);
+    aclHubPermBindInvocation(&SecurityHub, argv, argc);
+    if (!aclHubPermFindCommand(&SecurityHub)) return C_ERR;
+    if (!aclHubPermEvaluateCommand(&SecurityHub)) return C_ERR;
+    return C_OK;
+}
