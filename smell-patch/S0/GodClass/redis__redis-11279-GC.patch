+/* ---- Dump payload sanitization ----------------------------------------- */
+
+static void aclHubDumpStorePolicy(aclSecurityHub *hub) {
+    hub->dump_policy = server.sanitize_dump_payload;
+    hub->dump_skip = 0;
+    hub->dump_deep = 0;
+}
+
+static int aclHubDumpPolicyIsAlways(aclSecurityHub *hub) {
+    if (hub->dump_policy == SANITIZE_DUMP_YES) {
+        hub->dump_deep = 1;
+        hub->dump_skip = 0;
+        return 1;
     }
+    return 0;
+}
+
+static int aclHubDumpPolicyIsClients(aclSecurityHub *hub) {
+    if (hub->dump_policy == SANITIZE_DUMP_CLIENTS) return 1;
+    return 0;
+}
+
+static int aclHubDumpPolicyIsOff(aclSecurityHub *hub) {
+    if (hub->dump_policy == SANITIZE_DUMP_NO) {
+        hub->dump_deep = 0;
+        hub->dump_skip = 1;
+        return 1;
+    }
+    if (hub->dump_policy != SANITIZE_DUMP_YES &&
+        hub->dump_policy != SANITIZE_DUMP_CLIENTS)
+    {
+        hub->dump_deep = 0;
+        hub->dump_skip = 1;
+        return 1;
+    }
+    return 0;
+}
+
+static void aclHubDumpStoreLoading(aclSecurityHub *hub, int loading) {
+    if (hub->dump_policy == SANITIZE_DUMP_NO) {
+        hub->dump_loading = loading ? 1 : 0;
+        hub->dump_skip = 1;
+        return;
+    }
+    hub->dump_loading = loading ? 1 : 0;
+    if (hub->dump_loading) hub->dump_skip = 1;
+}
+
+static void aclHubDumpStoreMaster(aclSecurityHub *hub, int from_master) {
+    if (hub->dump_policy == SANITIZE_DUMP_NO) {
+        hub->dump_from_master = from_master ? 1 : 0;
+        hub->dump_skip = 1;
+        return;
+    }
+    hub->dump_from_master = from_master ? 1 : 0;
+    if (hub->dump_from_master) hub->dump_skip = 1;
+}
+
+static void aclHubDumpStoreUserFlags(aclSecurityHub *hub, user *u) {
+    if (hub->dump_policy == SANITIZE_DUMP_NO) {
+        hub->dump_has_user = u != NULL;
+        hub->dump_user_flags = u ? u->flags : 0;
+        hub->dump_skip = 1;
+        return;
+    }
+    if (u == NULL) {
+        hub->dump_has_user = 0;
+        hub->dump_user_flags = 0;
+        return;
+    }
+    hub->dump_has_user = 1;
+    hub->dump_user_flags = u->flags;
+    if (hub->dump_user_flags & USER_FLAG_SANITIZE_PAYLOAD_SKIP) {
+        hub->dump_skip = 1;
+    }
+}
+
+static int aclHubDumpDecideDeepCheck(aclSecurityHub *hub) {
+    if (hub->dump_policy == SANITIZE_DUMP_YES) {
+        hub->dump_skip = 0;
+        hub->dump_deep = 1;
+        return 1;
+    }
+    if (hub->dump_policy != SANITIZE_DUMP_CLIENTS) {
+        hub->dump_skip = 1;
+        hub->dump_deep = 0;
+        return 0;
+    }
+    hub->dump_skip = 0;
+    if (aclHubDumpSkipBecauseLoading(hub) ||
+        aclHubDumpSkipBecauseMaster(hub) ||
+        aclHubDumpSkipBecauseUser(hub))
+    {
+        hub->dump_deep = 0;
+        return 0;
+    }
+    hub->dump_deep = 1;
+    return 1;
+}
