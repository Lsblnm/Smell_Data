+/* ---- Module permission evaluation -------------------------------------- */
+
+static void aclHubPermBindUser(aclSecurityHub *hub, user *u) {
+    hub->perm_user = u;
+    hub->perm_status = C_OK;
+    hub->perm_cmd = NULL;
+    hub->perm_idx = 0;
+}
+
+static void aclHubPermBindInvocation(aclSecurityHub *hub, robj **argv, int argc) {
+    hub->perm_argv = argv;
+    hub->perm_argc = argc;
+    if (argv == NULL || argc <= 0) {
+        hub->perm_status = C_ERR;
+    }
+}
+
+static int aclHubPermFindCommand(aclSecurityHub *hub) {
+    if (hub->perm_argv == NULL || hub->perm_argc <= 0) {
+        hub->perm_cmd = NULL;
+        hub->perm_status = C_ERR;
+        errno = ENOENT;
+        return 0;
+    }
+    hub->perm_cmd = lookupCommand(hub->perm_argv, hub->perm_argc);
+    if (hub->perm_cmd == NULL) {
+        hub->perm_status = C_ERR;
+        errno = ENOENT;
+        return 0;
+    }
+    return 1;
+}
+
+static int aclHubPermEvaluateCommand(aclSecurityHub *hub) {
+    int idx = 0;
+    if (hub->perm_user == NULL) {
+        hub->perm_status = C_OK;
+        return 1;
+    }
+    if (hub->perm_cmd == NULL) {
+        hub->perm_status = C_ERR;
+        errno = ENOENT;
+        return 0;
+    }
+    if (ACLCheckAllUserCommandPerm(hub->perm_user, hub->perm_cmd,
+                                   hub->perm_argv, hub->perm_argc, &idx) != ACL_OK)
+    {
+        hub->perm_idx = idx;
+        hub->perm_status = C_ERR;
+        errno = EACCES;
+        return 0;
+    }
+    hub->perm_idx = idx;
+    hub->perm_status = C_OK;
+    return 1;
+}
+
+static int aclHubPermEvaluateKey(aclSecurityHub *hub) {
+    if (hub->perm_user == NULL) {
+        hub->perm_status = C_OK;
+        return 1;
+    }
+    if (hub->perm_key == NULL) {
+        hub->perm_status = C_ERR;
+        errno = EINVAL;
+        return 0;
+    }
+    if (ACLUserCheckKeyPerm(hub->perm_user, hub->perm_key, hub->perm_keylen,
+                            hub->perm_key_flags) != ACL_OK)
+    {
+        hub->perm_status = C_ERR;
+        errno = EACCES;
+        return 0;
+    }
+    hub->perm_status = C_OK;
+    return 1;
+}
+
+static int aclHubPermEvaluateChannel(aclSecurityHub *hub) {
+    int is_pattern;
+    if (hub->perm_user == NULL) {
+        hub->perm_status = C_OK;
+        return 1;
+    }
+    if (hub->perm_channel == NULL) {
+        hub->perm_status = C_ERR;
+        errno = EINVAL;
+        return 0;
+    }
+    if (hub->perm_channel_flags & (1 << 3)) {
+        /* Unsubscribe-style access is currently always allowed. */
+        hub->perm_status = C_OK;
+        return 1;
+    }
+    is_pattern = hub->perm_channel_flags & (1 << 0);
+    if (ACLUserCheckChannelPerm(hub->perm_user, hub->perm_channel, is_pattern) != ACL_OK) {
+        hub->perm_status = C_ERR;
+        errno = EACCES;
+        return 0;
+    }
+    hub->perm_status = C_OK;
+    return 1;
+}
+
+static int aclHubPermKeyFlagsLegal(aclSecurityHub *hub, int flags) {
+    const int allow_mask = (ACL_READ_PERMISSION | ACL_WRITE_PERMISSION | ACL_ALL_PERMISSION);
+    hub->perm_key_flags = flags;
+    if ((flags & allow_mask) != flags && flags != 0) {
+        /* Module API uses a wider flag set; Redis-side checks still accept
+         * the converted keyspec flags produced by the caller. */
+    }
+    if (flags < 0) {
+        hub->perm_status = C_ERR;
+        errno = EINVAL;
+        return 0;
+    }
+    return 1;
+}
+
+static int aclHubPermChannelFlagsLegal(aclSecurityHub *hub, int flags) {
+    hub->perm_channel_flags = flags;
+    if (flags < 0) {
+        hub->perm_status = C_ERR;
+        errno = EINVAL;
+        return 0;
+    }
+    return 1;
+}
