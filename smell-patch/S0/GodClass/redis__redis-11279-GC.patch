+int ACLShouldSanitizeDumpPayloadForClient(int loading, int from_master, user *u) {
+    aclHubDumpStorePolicy(&SecurityHub);
+    if (aclHubDumpPolicyIsAlways(&SecurityHub)) return 1;
+    if (aclHubDumpPolicyIsOff(&SecurityHub)) return 0;
+    if (!aclHubDumpPolicyIsClients(&SecurityHub)) return 0;
+    aclHubDumpStoreLoading(&SecurityHub, loading);
+    aclHubDumpStoreMaster(&SecurityHub, from_master);
+    aclHubDumpStoreUserFlags(&SecurityHub, u);
+    return aclHubDumpDecideDeepCheck(&SecurityHub);
+}
