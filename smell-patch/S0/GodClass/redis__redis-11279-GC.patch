+int ACLModuleCheckKeyPermissions(user *u, const char *key, size_t keylen, int flags) {
+    aclHubPermBindUser(&SecurityHub, u);
+    if (!aclHubPermKeyFlagsLegal(&SecurityHub, flags)) return C_ERR;
+    SecurityHub.perm_key = key;
+    SecurityHub.perm_keylen = keylen;
+    if (!aclHubPermEvaluateKey(&SecurityHub)) return C_ERR;
+    return C_OK;
+}
