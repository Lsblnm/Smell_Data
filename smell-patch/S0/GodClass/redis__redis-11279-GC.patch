+/* ---- Client session authentication ------------------------------------- */
+
+static void aclHubSessionAttachClient(aclSecurityHub *hub, client *c) {
+    hub->session_client = c;
+    hub->session_user = NULL;
+    hub->session_flags = 0;
+    hub->session_nopass = 0;
+    hub->session_disabled = 0;
+    hub->session_authed = 0;
+    hub->session_needs_auth = 0;
+}
+
+static void aclHubSessionBindDefault(aclSecurityHub *hub) {
+    hub->session_user = DefaultUser;
+    if (hub->session_client != NULL) {
+        hub->session_authed = hub->session_client->authenticated;
+    }
+}
+
+static void aclHubSessionReadFlags(aclSecurityHub *hub) {
+    if (hub->session_user == NULL) {
+        hub->session_flags = 0;
+        hub->session_nopass = 0;
+        hub->session_disabled = 0;
+        return;
+    }
+    hub->session_flags = hub->session_user->flags;
+    hub->session_nopass = (hub->session_flags & USER_FLAG_NOPASS) ? 1 : 0;
+    hub->session_disabled = (hub->session_flags & USER_FLAG_DISABLED) ? 1 : 0;
+}
+
+static void aclHubSessionSetAuthenticatedBit(aclSecurityHub *hub) {
+    if (hub->session_nopass && !hub->session_disabled) {
+        hub->session_authed = 1;
+    } else {
+        hub->session_authed = 0;
+    }
+}
+
+static void aclHubSessionWriteBack(aclSecurityHub *hub) {
+    if (hub->session_client == NULL) return;
+    hub->session_client->user = hub->session_user;
+    hub->session_client->authenticated = hub->session_authed;
+}
+
+static int aclHubSessionNeedsAuth(aclSecurityHub *hub) {
+    int default_blocks;
+    if (hub->session_user != NULL) {
+        hub->session_flags = hub->session_user->flags;
+    }
+    if (hub->session_client == NULL) {
+        hub->session_needs_auth = 1;
+        return 1;
+    }
+    default_blocks = (!hub->session_nopass) || hub->session_disabled;
+    if (default_blocks && !hub->session_client->authenticated) {
+        hub->session_needs_auth = 1;
+        return 1;
+    }
+    hub->session_needs_auth = 0;
+    return 0;
+}
+
+static int aclHubSessionLookupByUsername(aclSecurityHub *hub, robj *username) {
+    hub->session_username = username;
+    hub->session_user = NULL;
+    if (username == NULL || username->ptr == NULL) {
+        errno = ENOENT;
+        return 0;
+    }
+    hub->session_user = ACLGetUserByName(username->ptr, sdslen(username->ptr));
+    if (hub->session_user == NULL) {
+        errno = ENOENT;
+        return 0;
+    }
+    hub->session_flags = hub->session_user->flags;
+    hub->session_disabled = (hub->session_flags & USER_FLAG_DISABLED) ? 1 : 0;
+    hub->session_nopass = (hub->session_flags & USER_FLAG_NOPASS) ? 1 : 0;
+    if (hub->session_disabled) {
+        errno = EINVAL;
+        return 0;
+    }
+    return 1;
+}
+
+static int aclHubSessionPasswordMatches(aclSecurityHub *hub, robj *password) {
+    listIter li;
+    listNode *ln;
+    hub->session_password = password;
+    if (hub->session_user == NULL) {
+        errno = EINVAL;
+        return 0;
+    }
+    if (hub->session_nopass) return 1;
+    if (password == NULL || password->ptr == NULL) {
+        errno = EINVAL;
+        return 0;
+    }
+    if (hub->session_hash) {
+        sdsfree(hub->session_hash);
+        hub->session_hash = NULL;
+    }
+    hub->session_hash = ACLHashPassword(password->ptr, sdslen(password->ptr));
+    listRewind(hub->session_user->passwords, &li);
+    while ((ln = listNext(&li))) {
+        sds thispass = listNodeValue(ln);
+        if (!time_independent_strcmp(hub->session_hash, thispass, HASH_PASSWORD_LEN)) {
+            sdsfree(hub->session_hash);
+            hub->session_hash = NULL;
+            return 1;
+        }
+    }
+    sdsfree(hub->session_hash);
+    hub->session_hash = NULL;
+    errno = EINVAL;
+    return 0;
+}
