+/* ---- Default user password / requirepass -------------------------------- */
+
+static void aclHubPwdBindDefault(aclSecurityHub *hub) {
+    hub->pwd_user = DefaultUser;
+    hub->pwd_nopass = 0;
+    hub->pwd_disabled = 0;
+    if (hub->pwd_user != NULL) {
+        hub->pwd_nopass = (hub->pwd_user->flags & USER_FLAG_NOPASS) ? 1 : 0;
+        hub->pwd_disabled = (hub->pwd_user->flags & USER_FLAG_DISABLED) ? 1 : 0;
+    }
+}
+
+static void aclHubPwdResetExisting(aclSecurityHub *hub) {
+    if (hub->pwd_user == NULL) return;
+    ACLSetUser(hub->pwd_user, "resetpass", -1);
+}
+
+static int aclHubPwdHasSecret(aclSecurityHub *hub, sds password) {
+    if (hub->pwd_user == NULL) hub->pwd_user = DefaultUser;
+    hub->pwd_secret = password;
+    if (password != NULL) {
+        hub->pwd_has_secret = 1;
+        return 1;
+    }
+    hub->pwd_has_secret = 0;
+    return 0;
+}
+
+static void aclHubPwdInstallSecret(aclSecurityHub *hub) {
+    if (hub->pwd_user == NULL) return;
+    if (hub->pwd_op) {
+        sdsfree(hub->pwd_op);
+        hub->pwd_op = NULL;
+    }
+    hub->pwd_op = sdscatlen(sdsnew(">"), hub->pwd_secret, sdslen(hub->pwd_secret));
+    ACLSetUser(hub->pwd_user, hub->pwd_op, sdslen(hub->pwd_op));
+    sdsfree(hub->pwd_op);
+    hub->pwd_op = NULL;
+}
+
+static void aclHubPwdInstallNopass(aclSecurityHub *hub) {
+    if (hub->pwd_user == NULL) return;
+    ACLSetUser(hub->pwd_user, "nopass", -1);
+    hub->pwd_nopass = 1;
+}
+
+static int aclHubPwdDefaultIsNopass(aclSecurityHub *hub) {
+    aclHubPwdBindDefault(hub);
+    return hub->pwd_nopass;
+}
+
+static int aclHubPwdDefaultIsDisabled(aclSecurityHub *hub) {
+    aclHubPwdBindDefault(hub);
+    return hub->pwd_disabled;
+}
+
+static void aclHubPwdApplyRequirepass(aclSecurityHub *hub, sds password) {
+    aclHubPwdBindDefault(hub);
+    aclHubPwdResetExisting(hub);
+    if (aclHubPwdHasSecret(hub, password)) {
+        aclHubPwdInstallSecret(hub);
+    } else {
+        aclHubPwdInstallNopass(hub);
+    }
+}
