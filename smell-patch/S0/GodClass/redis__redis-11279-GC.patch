+int ACLModuleCheckChannelPermissions(user *u, sds channel, int flags) {
+    aclHubPermBindUser(&SecurityHub, u);
+    if (!aclHubPermChannelFlagsLegal(&SecurityHub, flags)) return C_ERR;
+    SecurityHub.perm_channel = channel;
+    if (!aclHubPermEvaluateChannel(&SecurityHub)) return C_ERR;
+    return C_OK;
+}
