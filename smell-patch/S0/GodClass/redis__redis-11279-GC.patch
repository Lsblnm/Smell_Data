+static void aclHubReleaseBornStorage(aclSecurityHub *hub) {
+    user *u = hub->born_user;
+    if (u == NULL) return;
+    if (u->name) {
+        sdsfree(u->name);
+        u->name = NULL;
+    }
+    if (u->passwords) {
+        listRelease(u->passwords);
+        u->passwords = NULL;
+    }
+    if (u->selectors) {
+        listRelease(u->selectors);
+        u->selectors = NULL;
+    }
+    zfree(u);
+    hub->born_user = NULL;
+    hub->born_flags = 0;
+    hub->born_name = NULL;
+    hub->born_namelen = 0;
+}
+
+static void aclHubCopyUserState(aclSecurityHub *hub, user *dst, user *src) {
+    hub->born_user = dst;
+    if (dst == NULL || src == NULL) return;
+    if (dst->passwords) listRelease(dst->passwords);
+    if (dst->selectors) listRelease(dst->selectors);
+    dst->passwords = listDup(src->passwords);
+    dst->selectors = listDup(src->selectors);
+    dst->flags = src->flags;
+    hub->born_flags = dst->flags;
+}
+
+static int aclHubDumpSkipBecauseLoading(aclSecurityHub *hub) {
+    if (hub->dump_policy != SANITIZE_DUMP_CLIENTS) return 0;
+    if (hub->dump_loading) {
+        hub->dump_skip = 1;
+        return 1;
+    }
+    return 0;
+}
+
+static int aclHubDumpSkipBecauseMaster(aclSecurityHub *hub) {
+    if (hub->dump_policy != SANITIZE_DUMP_CLIENTS) return 0;
+    if (hub->dump_skip) return 1;
+    if (hub->dump_from_master) {
+        hub->dump_skip = 1;
+        return 1;
+    }
+    return 0;
+}
+
+static int aclHubDumpSkipBecauseUser(aclSecurityHub *hub) {
+    if (hub->dump_policy != SANITIZE_DUMP_CLIENTS) return 0;
+    if (hub->dump_skip) return 1;
+    if (hub->dump_has_user &&
+        (hub->dump_user_flags & USER_FLAG_SANITIZE_PAYLOAD_SKIP))
+    {
+        hub->dump_skip = 1;
+        return 1;
+    }
+    return 0;
+}
+
+static void aclHubSessionRetargetToDefault(aclSecurityHub *hub, client *c) {
+    hub->session_client = c;
+    if (c == NULL) return;
+    c->user = DefaultUser;
+    c->authenticated = 0;
+    hub->session_user = DefaultUser;
+    hub->session_authed = 0;
+    if (c == server.current_client) {
+        c->flags |= CLIENT_CLOSE_AFTER_COMMAND;
+    } else {
+        freeClientAsync(c);
+    }
+}
+
+static void aclHubSessionKillMatchingClients(aclSecurityHub *hub) {
+    listIter li;
+    listNode *ln;
+    user *victim = hub->session_user;
+    if (victim == NULL) return;
+    listRewind(server.clients, &li);
+    while ((ln = listNext(&li)) != NULL) {
+        client *c = listNodeValue(ln);
+        if (c->user == victim) {
+            aclHubSessionRetargetToDefault(hub, c);
+            hub->session_user = victim;
+        }
+    }
+}
+
+static void aclHubPermAttachClient(aclSecurityHub *hub, client *c) {
+    hub->perm_client = c;
+    hub->perm_denied = 0;
+    hub->perm_reason = NULL;
+    hub->perm_idx = 0;
+    hub->perm_status = C_OK;
+    if (c != NULL) {
+        hub->perm_user = c->user;
+        hub->perm_cmd = c->cmd;
+        hub->perm_argv = c->argv;
+        hub->perm_argc = c->argc;
+    } else {
+        hub->perm_user = NULL;
+        hub->perm_cmd = NULL;
+        hub->perm_argv = NULL;
+        hub->perm_argc = 0;
+    }
+}
+
+static int aclHubPermRunClientCheck(aclSecurityHub *hub) {
+    int idx = 0;
+    if (hub->perm_client == NULL) {
+        hub->perm_status = ACL_OK;
+        hub->perm_denied = 0;
+        return ACL_OK;
+    }
+    hub->perm_status = ACLCheckAllPerm(hub->perm_client, &idx);
+    hub->perm_idx = idx;
+    if (hub->perm_status != ACL_OK) {
+        hub->perm_denied = 1;
+    } else {
+        hub->perm_denied = 0;
+    }
+    return hub->perm_status;
+}
+
+static void aclHubPermChooseLogContext(aclSecurityHub *hub, int context) {
+    if (context == ACL_LOG_CTX_MULTI || context == ACL_LOG_CTX_LUA ||
+        context == ACL_LOG_CTX_TOPLEVEL || context == ACL_LOG_CTX_MODULE)
+    {
+        hub->perm_log_ctx = context;
+        return;
+    }
+    if (hub->perm_client && (hub->perm_client->flags & CLIENT_MULTI)) {
+        hub->perm_log_ctx = ACL_LOG_CTX_MULTI;
+    } else {
+        hub->perm_log_ctx = ACL_LOG_CTX_TOPLEVEL;
+    }
+}
+
+static const char *aclHubPermTopLevelDenial(aclSecurityHub *hub) {
+    if (hub->perm_status == ACL_DENIED_CMD) {
+        hub->perm_reason = "command";
+        return "command";
+    }
+    if (hub->perm_status == ACL_DENIED_KEY) {
+        hub->perm_reason = "key";
+        return "key";
+    }
+    if (hub->perm_status == ACL_DENIED_CHANNEL) {
+        hub->perm_reason = "channel";
+        return "channel";
+    }
+    hub->perm_reason = "generic";
+    return "generic";
+}
+
+static const char *aclHubPermTransactionDenial(aclSecurityHub *hub) {
+    if (hub->perm_status == ACL_DENIED_CMD) {
+        hub->perm_reason = "no permission to execute the command or subcommand";
+    } else if (hub->perm_status == ACL_DENIED_KEY) {
+        hub->perm_reason = "no permission to touch the specified keys";
+    } else if (hub->perm_status == ACL_DENIED_CHANNEL) {
+        hub->perm_reason = "no permission to access one of the channels used "
+                           "as arguments";
+    } else {
+        hub->perm_reason = "no permission";
+    }
+    return hub->perm_reason;
+}
+
+static sds aclHubPermScriptDenial(aclSecurityHub *hub) {
+    aclHubPermTopLevelDenial(hub);
+    return sdscatfmt(sdsempty(), "The user executing the script %s",
+                     getAclErrorMessage(hub->perm_status));
+}
