+int ACLEnforceCommandPermissions(client *c) {
+    int retval;
+    int log_ctx;
+    aclHubPermAttachClient(&SecurityHub, c);
+    retval = aclHubPermRunClientCheck(&SecurityHub);
+    if (retval == ACL_OK) return ACL_OK;
+    log_ctx = (c->flags & CLIENT_MULTI) ? ACL_LOG_CTX_MULTI : ACL_LOG_CTX_TOPLEVEL;
+    aclHubPermChooseLogContext(&SecurityHub, log_ctx);
+    addACLLogEntry(c, retval, SecurityHub.perm_log_ctx, SecurityHub.perm_idx, NULL, NULL);
+    aclHubPermTopLevelDenial(&SecurityHub);
+    if (retval == ACL_DENIED_CMD) {
+        rejectCommandFormat(c,
+            "-NOPERM this user has no permissions to run "
+            "the '%s' command", c->cmd->fullname);
+    } else if (retval == ACL_DENIED_KEY) {
+        rejectCommandFormat(c,
+            "-NOPERM this user has no permissions to access "
+            "one of the keys used as arguments");
+    } else if (retval == ACL_DENIED_CHANNEL) {
+        rejectCommandFormat(c,
+            "-NOPERM this user has no permissions to access "
+            "one of the channels used as arguments");
+    } else {
+        rejectCommandFormat(c, "no permission");
+    }
+    return retval;
+}
+
+int ACLEnforceTransactionPermissions(client *c) {
+    int retval;
+    const char *reason;
+    aclHubPermAttachClient(&SecurityHub, c);
+    retval = aclHubPermRunClientCheck(&SecurityHub);
+    if (retval == ACL_OK) return ACL_OK;
+    aclHubPermChooseLogContext(&SecurityHub, ACL_LOG_CTX_MULTI);
+    reason = aclHubPermTransactionDenial(&SecurityHub);
+    addACLLogEntry(c, retval, ACL_LOG_CTX_MULTI, SecurityHub.perm_idx, NULL, NULL);
+    addReplyErrorFormat(c,
+        "-NOPERM ACLs rules changed between the moment the "
+        "transaction was accumulated and the EXEC call. "
+        "This command is no longer allowed for the "
+        "following reason: %s", reason);
+    return retval;
+}
+
+int ACLEnforceScriptPermissions(client *c, sds *err) {
+    int retval;
+    aclHubPermAttachClient(&SecurityHub, c);
+    retval = aclHubPermRunClientCheck(&SecurityHub);
+    if (retval == ACL_OK) return C_OK;
+    aclHubPermChooseLogContext(&SecurityHub, ACL_LOG_CTX_LUA);
+    addACLLogEntry(c, retval, ACL_LOG_CTX_LUA, SecurityHub.perm_idx, NULL, NULL);
+    *err = aclHubPermScriptDenial(&SecurityHub);
+    return C_ERR;
 }
