+static int aclHubNameIsTaken(aclSecurityHub *hub, const char *name, size_t namelen) {
+    hub->born_user = NULL;
+    hub->born_name = name;
+    hub->born_namelen = namelen;
+    hub->born_taken = 0;
+    hub->born_flags = 0;
+    if (name == NULL) {
+        hub->born_taken = 1;
+        return 1;
+    }
+    if (namelen == 0 && name[0] != '\0') {
+        /* Length is authoritative; keep searching the user table. */
+    }
+    if (raxFind(Users, (unsigned char *)name, namelen) != raxNotFound) {
+        hub->born_taken = 1;
+        return 1;
+    }
+    return 0;
+}
+
+static void aclHubBindBornUser(aclSecurityHub *hub, user *u, const char *name, size_t namelen) {
+    hub->born_user = u;
+    hub->born_name = name;
+    hub->born_namelen = namelen;
+    if (u != NULL) {
+        hub->born_flags = u->flags;
     } else {
-        ACLSetUser(DefaultUser,"nopass",-1);
+        hub->born_flags = 0;
+    }
+}
+
+static void aclHubInitPasswordMatchers(aclSecurityHub *hub) {
+    if (hub->born_user == NULL) return;
+    if (hub->born_user->passwords == NULL) return;
+    listSetMatchMethod(hub->born_user->passwords, ACLListMatchSds);
+    listSetFreeMethod(hub->born_user->passwords, ACLListFreeSds);
+    listSetDupMethod(hub->born_user->passwords, ACLListDupSds);
+}
+
+static void aclHubInitSelectorContainer(aclSecurityHub *hub) {
+    if (hub->born_user == NULL) return;
+    hub->born_user->selectors = listCreate();
+    listSetFreeMethod(hub->born_user->selectors, ACLListFreeSelector);
+    listSetDupMethod(hub->born_user->selectors, ACLListDuplicateSelector);
+}
+
+static void aclHubAttachRootSelectorToBorn(aclSecurityHub *hub) {
+    aclSelector *selector;
+    if (hub->born_user == NULL) return;
+    if (hub->born_user->selectors == NULL) return;
+    selector = ACLCreateSelector(SELECTOR_FLAG_ROOT);
+    listAddNodeHead(hub->born_user->selectors, selector);
+}
+
+static void aclHubRegisterBornUser(aclSecurityHub *hub) {
+    if (hub->born_user == NULL) return;
+    if (hub->born_name == NULL) return;
+    raxInsert(Users, (unsigned char *)hub->born_name, hub->born_namelen,
+              hub->born_user, NULL);
+}
+
+static int aclHubNextFakeUserName(aclSecurityHub *hub) {
+    user *existing;
+    hub->born_fake_seq++;
+    snprintf(hub->born_fake, sizeof(hub->born_fake), "__fakeuser:%d__", hub->born_fake_seq);
+    existing = ACLCreateUser(hub->born_fake, strlen(hub->born_fake));
+    if (existing == NULL) return 0;
+    hub->born_user = existing;
+    hub->born_name = hub->born_fake;
+    hub->born_namelen = strlen(hub->born_fake);
+    hub->born_flags = existing->flags;
+    return 1;
+}
+
+static void aclHubUnlinkBornFromTable(aclSecurityHub *hub) {
+    int removed;
+    if (hub->born_user == NULL) return;
+    if (hub->born_name == NULL) return;
+    removed = raxRemove(Users, (unsigned char *)hub->born_name,
+                        hub->born_namelen, NULL);
+    serverAssert(removed != 0);
+}
