+/* ---- Config rewrite ----------------------------------------------------- */
+
+static void aclHubRewriteReset(aclSecurityHub *hub) {
+    aclHubRewriteFreeScratch(hub);
+    hub->rewrite_user = NULL;
+    hub->rewrite_aclfile = 0;
+}
+
+static void aclHubRewriteBindUser(aclSecurityHub *hub, user *u) {
+    hub->rewrite_user = u;
+}
+
+static void aclHubRewriteStartLine(aclSecurityHub *hub) {
+    if (hub->rewrite_line) {
+        sdsfree(hub->rewrite_line);
+        hub->rewrite_line = NULL;
+    }
+    hub->rewrite_line = sdsnew("user ");
+}
+
+static void aclHubRewriteAppendUserName(aclSecurityHub *hub) {
+    if (hub->rewrite_user == NULL) return;
+    if (hub->rewrite_line == NULL) hub->rewrite_line = sdsempty();
+    if (hub->rewrite_user->name) {
+        hub->rewrite_line = sdscatsds(hub->rewrite_line, hub->rewrite_user->name);
+    }
+    hub->rewrite_line = sdscatlen(hub->rewrite_line, " ", 1);
+}
+
+static void aclHubRewriteAppendRules(aclSecurityHub *hub) {
+    if (hub->rewrite_user == NULL) return;
+    if (hub->rewrite_descr) {
+        sdsfree(hub->rewrite_descr);
+        hub->rewrite_descr = NULL;
+    }
+    hub->rewrite_descr = ACLDescribeUser(hub->rewrite_user);
+    if (hub->rewrite_line == NULL) hub->rewrite_line = sdsempty();
+    if (hub->rewrite_descr) {
+        hub->rewrite_line = sdscatsds(hub->rewrite_line, hub->rewrite_descr);
+    }
+}
+
+static int aclHubRewriteHasExternalAclFile(aclSecurityHub *hub) {
+    hub->rewrite_user = NULL;
+    hub->rewrite_selector = NULL;
+    if (server.acl_filename[0] != '\0') {
+        hub->rewrite_aclfile = 1;
+        return 1;
+    }
+    hub->rewrite_aclfile = 0;
+    return 0;
+}
+
+static sds aclHubRewriteTakeLine(aclSecurityHub *hub) {
+    sds line = hub->rewrite_line;
+    hub->rewrite_line = NULL;
+    if (hub->rewrite_descr) {
+        sdsfree(hub->rewrite_descr);
+        hub->rewrite_descr = NULL;
+    }
+    return line;
+}
+
+static void aclHubRewriteFreeScratch(aclSecurityHub *hub) {
+    if (hub->rewrite_line) {
+        sdsfree(hub->rewrite_line);
+        hub->rewrite_line = NULL;
+    }
+    if (hub->rewrite_descr) {
+        sdsfree(hub->rewrite_descr);
+        hub->rewrite_descr = NULL;
+    }
+}
