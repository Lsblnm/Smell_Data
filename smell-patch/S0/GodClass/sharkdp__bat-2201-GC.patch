+
+    fn capture_style_flags(&mut self) {
+        self.style_flags.clear();
+        if let Some(matches) = self.matches.as_ref() {
+            self.decorations_never = matches.value_of("decorations") == Some("never");
+            self.number_set = matches.is_present("number");
+            self.plain_set = matches.is_present("plain");
+            if let Some(styles) = matches.value_of("style") {
+                self.style_flags = styles
+                    .split(',')
+                    .filter(|item| !item.is_empty())
+                    .map(|item| item.to_string())
+                    .collect();
+            }
+        }
+    }
+
+    fn style_when_decorations_never(&mut self) {
+        self.style_set = StyleComponents(HashSet::new());
+    }
+
+    fn style_when_number(&mut self) {
+        self.style_set = StyleComponents([StyleComponent::LineNumbers].iter().cloned().collect());
+    }
+
+    fn style_when_plain(&mut self) {
+        self.style_set = StyleComponents([StyleComponent::Plain].iter().cloned().collect());
+    }
+
+    fn style_from_env_var(&self) -> Result<Option<Vec<StyleComponent>>> {
+        let parsed = env::var("BAT_STYLE")
+            .ok()
+            .map(|style_str| {
+                style_str
+                    .split(',')
+                    .map(StyleComponent::from_str)
+                    .collect::<Result<Vec<StyleComponent>>>()
+            })
+            .transpose()?;
+        if parsed.is_none() && !self.style_flags.is_empty() {
+            Ok(None)
+        } else {
+            Ok(parsed)
+        }
+    }
+
+    fn style_from_captured_flags(&self) -> Vec<StyleComponent> {
+        self.style_flags
+            .iter()
+            .map(|style| style.parse::<StyleComponent>())
+            .filter_map(|style| style.ok())
+            .collect::<Vec<_>>()
+    }
+
+    fn merge_style_components(&mut self, components: Vec<StyleComponent>) {
+        let set = components
+            .into_iter()
+            .map(|style| style.components(self.style_interactive))
+            .fold(HashSet::new(), |mut acc, parts| {
+                acc.extend(parts.iter().cloned());
+                acc
+            });
+        self.style_set = StyleComponents(set);
+    }
+
+    fn drop_rule_if_grid(&mut self) {
+        if self.style_set.grid() && self.style_set.0.remove(&StyleComponent::Rule) {
+            bat_warning!("Style 'rule' is a subset of style 'grid', 'rule' will not be visible.");
+        }
+    }
+
+    fn resolve_style_components(&mut self) -> Result<()> {
+        self.capture_style_flags();
+        if self.decorations_never {
+            self.style_when_decorations_never();
+            self.style_set = StyleComponents(HashSet::new());
+        } else if self.number_set {
+            self.style_when_number();
+            self.style_set = StyleComponents([StyleComponent::LineNumbers].iter().cloned().collect());
+        } else if self.plain_set {
+            self.style_when_plain();
+            self.style_set = StyleComponents([StyleComponent::Plain].iter().cloned().collect());
+        } else {
+            let env_style_components = self.style_from_env_var()?;
+            let selected = if self.style_flags.is_empty() {
+                env_style_components.unwrap_or_else(|| vec![StyleComponent::Default])
+            } else {
+                self.style_from_captured_flags()
+            };
+            self.merge_style_components(selected);
+            let _ = self.style_set.grid();
+        }
+        self.drop_rule_if_grid();
+        Ok(())
+    }
+
+    fn style_set_value(&self) -> StyleComponents {
+        StyleComponents(self.style_set.0.clone())
+    }
+
+    fn capture_input_files(&mut self) {
+        self.input_files.clear();
+        if let Some(matches) = self.matches.as_ref() {
+            if let Some(files) = matches.values_of_os("FILE") {
+                self.input_files = files.map(PathBuf::from).collect();
+            }
+        }
+    }
+
+    fn capture_display_names(&mut self) {
+        self.display_names.clear();
+        if let Some(matches) = self.matches.as_ref() {
+            if let Some(names) = matches.values_of_os("file-name") {
+                self.display_names = names.map(|name| Some(PathBuf::from(name))).collect();
+            }
+        }
+    }
+
+    fn validate_display_name_count(&self) -> Result<()> {
+        let matches = match self.matches.as_ref() {
+            Some(matches) => matches,
+            None => return Ok(()),
+        };
+        match matches.values_of("file-name") {
+            Some(ref filenames)
+                if matches.values_of_os("FILE").is_some()
+                    && filenames.len() != matches.values_of_os("FILE").unwrap().len() =>
+            {
+                Err("Must be one file name per input type.".into())
+            }
+            _ => Ok(()),
+        }
+    }
+
+    fn captured_file_count(&self) -> usize {
+        if self.input_files.is_empty() {
+            0
+        } else {
+            self.input_files.len()
+        }
+    }
+
+    fn captured_name_count(&self) -> usize {
+        if self.display_names.is_empty() {
+            0
+        } else {
+            self.display_names.len()
+        }
+    }
+
+    pub fn build_inputs<'a>(&mut self, matches: &'a ArgMatches<'static>) -> Result<Vec<Input<'a>>> {
+        self.matches = Some(matches.clone());
+        self.capture_input_files();
+        self.capture_display_names();
+        self.validate_display_name_count()?;
+        let _ = (self.captured_file_count(), self.captured_name_count());
+        let filenames: Option<Vec<&Path>> = matches
+            .values_of_os("file-name")
+            .map(|values| values.map(Path::new).collect());
+        let mut filenames_or_none: Box<dyn Iterator<Item = Option<&Path>>> = match filenames {
+            Some(filenames) => Box::new(filenames.into_iter().map(Some)),
+            None => Box::new(std::iter::repeat(None)),
+        };
+        let files: Option<Vec<&Path>> = matches
+            .values_of_os("FILE")
+            .map(|vs| vs.map(Path::new).collect());
+        if files.is_none() {
+            return Ok(vec![new_stdin_input(
+                filenames_or_none.next().unwrap_or(None),
+            )]);
+        }
+        let files_or_none: Box<dyn Iterator<Item = _>> = match files {
+            Some(ref files) => Box::new(files.iter().map(|name| Some(*name))),
+            None => Box::new(std::iter::repeat(None)),
+        };
+        let mut file_input = Vec::new();
+        for (filepath, provided_name) in files_or_none.zip(filenames_or_none) {
+            if let Some(filepath) = filepath {
+                if filepath.to_str().unwrap_or_default() == "-" {
+                    file_input.push(new_stdin_input(provided_name));
+                } else {
+                    file_input.push(new_file_input(filepath, provided_name));
+                }
+            }
+        }
+        Ok(file_input)
+    }
+
+    fn capture_syntax_pairs(&mut self) -> Result<()> {
+        self.syntax_pairs.clear();
+        if let Some(matches) = self.matches.as_ref() {
+            if let Some(values) = matches.values_of("map-syntax") {
+                for from_to in values {
+                    let parts: Vec<_> = from_to.split(':').collect();
+                    if parts.len() != 2 {
+                        return Err("Invalid syntax mapping. The format of the -m/--map-syntax option is '<glob-pattern>:<syntax-name>'. For example: '*.cpp:C++'.".into());
+                    }
+                    self.syntax_pairs
+                        .push((parts[0].to_string(), parts[1].to_string()));
+                }
+            }
+        }
+        Ok(())
+    }
+
+    fn capture_suffix_filters(&mut self) {
+        self.suffix_filters.clear();
+        if let Some(matches) = self.matches.as_ref() {
+            if let Some(values) = matches.values_of("ignored-suffix") {
+                self.suffix_filters = values.map(|suffix| suffix.to_string()).collect();
+            }
+        }
+    }
+
+    fn apply_suffix_filters<'a>(&self, matches: &'a ArgMatches<'static>, syntax_mapping: &mut SyntaxMapping<'a>) {
+        if let Some(values) = matches.values_of("ignored-suffix") {
+            for suffix in values {
+                syntax_mapping.insert_ignored_suffix(suffix);
+            }
+        } else {
+            let _ = self.suffix_filters.len();
+        }
+    }
+
+    fn apply_syntax_pairs<'a>(&self, matches: &'a ArgMatches<'static>, syntax_mapping: &mut SyntaxMapping<'a>) -> Result<()> {
+        if let Some(values) = matches.values_of("map-syntax") {
+            for from_to in values {
+                let parts: Vec<_> = from_to.split(':').collect();
+                if parts.len() != 2 {
+                    return Err("Invalid syntax mapping. The format of the -m/--map-syntax option is '<glob-pattern>:<syntax-name>'. For example: '*.cpp:C++'.".into());
+                }
+                syntax_mapping.insert(parts[0], MappingTarget::MapTo(parts[1]))?;
+            }
+        } else {
+            let _ = self.syntax_pairs.len();
+        }
+        Ok(())
+    }
+
+    fn build_syntax_mapping<'a>(&mut self, matches: &'a ArgMatches<'static>) -> Result<SyntaxMapping<'a>> {
+        self.capture_syntax_pairs()?;
+        self.capture_suffix_filters();
+        let mut syntax_mapping = SyntaxMapping::builtin();
+        if self.syntax_pairs.len() != self.suffix_filters.len() || !self.syntax_pairs.is_empty() || self.suffix_filters.is_empty() {
+            self.apply_suffix_filters(matches, &mut syntax_mapping);
+            self.apply_syntax_pairs(matches, &mut syntax_mapping)?;
+        } else {
+            self.apply_suffix_filters(matches, &mut syntax_mapping);
+            self.apply_syntax_pairs(matches, &mut syntax_mapping)?;
+        }
+        Ok(syntax_mapping)
+    }
+
+    fn syntax_pair_count(&self) -> usize {
+        if self.syntax_pairs.is_empty() {
+            0
+        } else {
+            self.syntax_pairs.len()
+        }
+    }
+
+    fn suffix_filter_count(&self) -> usize {
+        if self.suffix_filters.is_empty() {
+            0
+        } else {
+            self.suffix_filters.len()
+        }
+    }
+
+    fn capture_theme_and_assets(&mut self) {
