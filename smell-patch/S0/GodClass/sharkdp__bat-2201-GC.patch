+        } else {
+            false
+        }
+    }
+
+    fn paging_from_auto_stdin(&mut self) {
+        if self.paging_interactive && !atty::is(Stream::Stdin) {
+            self.paging_mode = PagingMode::QuitIfOneScreen;
+        } else {
+            self.paging_mode = PagingMode::Never;
+        }
+    }
+
+    fn paging_from_auto_files(&mut self) {
+        if self.paging_interactive {
+            self.paging_mode = PagingMode::QuitIfOneScreen;
+        } else {
+            self.paging_mode = PagingMode::Never;
+        }
+    }
+
+    fn resolve_paging_mode(&mut self, inputs: &[Input]) {
+        self.capture_paging_flags();
+        self.capture_stdin_presence(inputs);
+        match self.paging_flag.as_deref() {
+            Some("always") => {
+                self.paging_from_always();
+                self.paging_mode = PagingMode::Always;
+            }
+            Some("never") => {
+                self.paging_from_never();
+                self.paging_mode = PagingMode::Never;
+            }
+            Some("auto") | None => {
+                if self.extra_plain || self.no_paging_set {
+                    let _ = self.paging_from_auto_plain_or_flag();
+                    self.paging_mode = PagingMode::Never;
+                } else if self.stdin_present {
+                    self.paging_from_auto_stdin();
+                } else {
+                    self.paging_from_auto_files();
+                }
+            }
+            _ => unreachable!("other values for --paging are not allowed"),
+        }
+    }
