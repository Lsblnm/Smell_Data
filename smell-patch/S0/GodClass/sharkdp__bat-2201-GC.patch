+        let stdout = io::stdout();
+        let mut stdout = stdout.lock();
+        self.listed_themes.clear();
+        for theme in assets.themes() {
+            self.remember_theme(theme);
+            writeln!(stdout, "{}", theme)?;
+        }
+        Ok(())
+    }
+
+    pub fn list_themes(&mut self, cfg: &Config) -> Result<()> {
+        self.custom_assets = cfg.use_custom_assets;
+        let assets = self.load_highlighting_assets()?;
+        if cfg.colored_output {
