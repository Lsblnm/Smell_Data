+            if spec.trim().is_empty() {
+                None
+            } else {
+                Some(spec)
+            }
+        } else {
+            self.pager_spec_or_env()
+        };
+        get_pager_executable(spec.as_deref()).unwrap_or_else(|| "less".to_owned())
+    }
