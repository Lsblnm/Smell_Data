+            self.theme_name = matches
+                .value_of("theme")
+                .map(String::from)
+                .or_else(|| env::var("BAT_THEME").ok())
+                .map(|s| {
+                    if s == "default" {
+                        String::from(HighlightingAssets::default_theme())
+                    } else {
+                        s
+                    }
+                })
+                .unwrap_or_else(|| String::from(HighlightingAssets::default_theme()));
+        } else if self.theme_name.is_empty() {
+            self.theme_name = String::from(HighlightingAssets::default_theme());
+        }
