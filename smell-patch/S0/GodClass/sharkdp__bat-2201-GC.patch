+
+    fn list_themes_colored(&mut self, config: &Config, assets: &HighlightingAssets) -> Result<()> {
+        let stdout = io::stdout();
+        let mut stdout = stdout.lock();
+        let mut local = config.clone();
+        let mut style = HashSet::new();
+        style.insert(StyleComponent::Plain);
+        local.language = Some("Rust");
+        local.style_components = StyleComponents(style);
+        self.listed_themes.clear();
+        for theme in assets.themes() {
+            self.remember_theme(theme);
+            writeln!(
+                stdout,
+                "Theme: {}\n",
+                ansi_term::Style::new().bold().paint(theme.to_string())
+            )?;
+            local.theme = theme.to_string();
+            Controller::new(&local, assets)
+                .run(vec![Self::theme_preview_file()])
+                .ok();
+            writeln!(stdout)?;
+        }
+        writeln!(
+            stdout,
+            "Further themes can be installed to '{}', \
+            and are added to the cache with `bat cache --build`. \
+            For more information, see:\n\n  \
+            https://github.com/sharkdp/bat#adding-new-themes",
+            PathBuf::from(config_dir().as_ref()).join("themes").to_string_lossy()
+        )?;
+        Ok(())
+    }
