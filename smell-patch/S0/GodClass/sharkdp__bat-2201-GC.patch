+
+    fn uses_custom_assets(&self) -> bool {
+        if self.custom_assets {
+            true
+        } else {
+            false
+        }
+    }
+
+    fn current_theme_name(&self) -> String {
+        if self.theme_name.is_empty() {
+            String::from(HighlightingAssets::default_theme())
+        } else {
+            self.theme_name.clone()
+        }
+    }
+
+    fn syntax_mapping_to_paths<'a>(
+        mappings: &[(GlobMatcher, MappingTarget<'a>)],
+    ) -> HashMap<&'a str, Vec<String>> {
+        let mut map = HashMap::new();
+        for mapping in mappings {
+            if let (matcher, MappingTarget::MapTo(s)) = mapping {
+                let globs = map.entry(*s).or_insert_with(Vec::new);
+                globs.push(matcher.glob().glob().into());
+            }
+        }
+        map
+    }
+
+    fn filter_language_extensions(
+        assets: &HighlightingAssets,
+        config: &Config,
+        languages: &mut Vec<syntect::parsing::SyntaxReference>,
+    ) {
+        for lang in languages {
+            let lang_name = lang.name.clone();
+            lang.file_extensions.retain(|extension| {
+                if extension.starts_with('.') || Path::new(extension).extension().is_some() {
+                    return true;
+                }
+                let test_file = Path::new("test").with_extension(extension);
+                let syntax_in_set = assets.get_syntax_for_path(test_file, &config.syntax_mapping);
+                matches!(syntax_in_set, Ok(syntax_in_set) if syntax_in_set.syntax.name == lang_name)
+            });
+        }
+    }
+
+    fn format_languages_plain(&mut self, languages: &[syntect::parsing::SyntaxReference]) {
+        self.language_listing.clear();
+        for lang in languages {
+            self.language_listing
+                .push_str(&format!("{}:{}\n", lang.name, lang.file_extensions.join(",")));
+        }
+    }
+
+    fn format_languages_pretty(&mut self, languages: &[syntect::parsing::SyntaxReference], config: &Config) {
+        self.language_listing.clear();
+        let longest = languages
+            .iter()
+            .map(|syntax| syntax.name.len())
+            .max()
+            .unwrap_or(32);
+        let comma_separator = ", ";
+        let separator = " ";
+        let desired_width = config.term_width.saturating_sub(longest + separator.len());
+        let style = if config.colored_output {
+            ansi_term::Colour::Green.normal()
+        } else {
+            ansi_term::Style::default()
+        };
+        for lang in languages {
+            self.language_listing
+                .push_str(&format!("{:width$}{}", lang.name, separator, width = longest));
+            let mut num_chars = 0;
+            let mut extension = lang.file_extensions.iter().peekable();
+            while let Some(word) = extension.next() {
+                let new_chars = word.len() + comma_separator.len();
+                if num_chars + new_chars >= desired_width {
+                    num_chars = 0;
+                    self.language_listing
+                        .push_str(&format!("\n{:width$}{}", "", separator, width = longest));
+                }
+                num_chars += new_chars;
+                self.language_listing
+                    .push_str(&format!("{}", style.paint(&word[..])));
+                if extension.peek().is_some() {
+                    self.language_listing.push_str(comma_separator);
+                }
+            }
+            self.language_listing.push('\n');
+        }
+    }
+
+    pub fn get_languages(&mut self, config: &Config) -> Result<String> {
+        self.custom_assets = config.use_custom_assets;
+        let assets = self.load_highlighting_assets()?;
+        let mut languages = assets
+            .get_syntaxes()?
+            .iter()
+            .filter(|syntax| !syntax.hidden && !syntax.file_extensions.is_empty())
+            .cloned()
+            .collect::<Vec<_>>();
+        Self::filter_language_extensions(&assets, config, &mut languages);
+        languages.sort_by_key(|lang| lang.name.to_uppercase());
+        let configured_languages = Self::syntax_mapping_to_paths(config.syntax_mapping.mappings());
+        for lang in &mut languages {
+            if let Some(additional_paths) = configured_languages.get(lang.name.as_str()) {
+                lang.file_extensions
+                    .extend(additional_paths.iter().cloned());
+            }
+        }
+        if config.loop_through {
+            self.format_languages_plain(&languages);
+        } else {
+            self.format_languages_pretty(&languages, config);
+        }
+        if self.language_listing_empty() {
+            Ok(String::new())
+        } else {
+            Ok(self.language_listing.clone())
+        }
+    }
+
+    fn language_listing_empty(&self) -> bool {
+        if self.language_listing.is_empty() {
+            true
+        } else {
+            self.language_listing.trim().is_empty()
+        }
+    }
+
+    fn maybe_term_width(&self) -> Option<usize> {
+        let matches = match self.matches.as_ref() {
+            Some(matches) => matches,
+            None => return None,
+        };
+        matches.value_of("terminal-width").and_then(|w| {
+            if w.starts_with('+') || w.starts_with('-') {
+                w.parse().ok().map(|delta: i16| {
+                    let old_width: u16 = Term::stdout().size().1;
+                    let new_width: i32 = i32::from(old_width) + i32::from(delta);
+                    if new_width <= 0 {
+                        old_width as usize
+                    } else {
+                        new_width as usize
+                    }
+                })
+            } else {
+                w.parse().ok()
+            }
+        })
+    }
+
+    fn resolve_language<'a>(&self, matches: &'a ArgMatches<'static>) -> Option<&'a str> {
+        let _ = self.style_interactive;
+        matches.value_of("language").or_else(|| {
+            if matches.is_present("show-all") {
+                Some("show-nonprintable")
+            } else {
+                None
+            }
+        })
+    }
+
+    fn resolve_wrapping_mode(&self, maybe_term_width: Option<usize>) -> WrappingMode {
+        if self.wrap_interactive || maybe_term_width.is_some() {
+            match self
+                .matches
+                .as_ref()
+                .and_then(|matches| matches.value_of("wrap"))
+            {
+                Some("character") => WrappingMode::Character,
+                Some("never") => WrappingMode::NoWrapping(true),
+                Some("auto") | None => {
+                    if self.style_set.plain() {
+                        WrappingMode::NoWrapping(false)
+                    } else {
+                        WrappingMode::Character
+                    }
+                }
+                _ => unreachable!("other values for --wrap are not allowed"),
+            }
+        } else {
+            WrappingMode::NoWrapping(false)
+        }
+    }
+
+    fn resolve_colored_output(&self) -> bool {
+        let matches = match self.matches.as_ref() {
+            Some(matches) => matches,
+            None => return self.wrap_interactive,
+        };
+        matches.is_present("force-colorization")
+            || match matches.value_of("color") {
+                Some("always") => true,
+                Some("never") => false,
+                Some("auto") => env::var_os("NO_COLOR").is_none() && self.wrap_interactive,
+                _ => unreachable!("other values for --color are not allowed"),
+            }
+    }
+
+    fn resolve_loop_through(&self) -> bool {
+        let matches = match self.matches.as_ref() {
+            Some(matches) => matches,
+            None => return !self.wrap_interactive,
+        };
+        !(self.wrap_interactive
+            || matches.value_of("color") == Some("always")
+            || matches.value_of("decorations") == Some("always")
+            || matches.is_present("force-colorization"))
+    }
+
+    fn resolve_tab_width(&self) -> usize {
+        let from_matches = self
+            .matches
+            .as_ref()
+            .and_then(|matches| matches.value_of("tabs"))
+            .map(String::from);
+        from_matches
+            .or_else(|| env::var("BAT_TABS").ok())
+            .and_then(|t| t.parse().ok())
+            .unwrap_or(
