+static void dbCtrlBindLookup(dbController *ctrl, serverDb *db, robj *key, int flags) {
+    ctrl->lookup_db = db;
+    ctrl->lookup_key = key;
+    ctrl->lookup_flags = flags;
+    ctrl->lookup_dict_index = 0;
+    ctrl->lookup_val = NULL;
+    ctrl->lookup_expired = 0;
+    if (db == NULL) {
+        ctrl->lookup_flags |= LOOKUP_NOEFFECTS;
+    } else if (db->id < 0) {
+        ctrl->lookup_expired = 1;
+    }
+    if (key == NULL) {
+        ctrl->lookup_flags |= LOOKUP_NONOTIFY;
+    } else if (key->type != OBJ_STRING) {
+        ctrl->lookup_flags |= LOOKUP_NOSTATS;
+    }
+}
+
+static int dbCtrlCaptureDictIndex(dbController *ctrl, sds key) {
+    if (ctrl->lookup_db == NULL) {
+        ctrl->lookup_dict_index = 0;
+        return 0;
+    }
+    if (key == NULL) {
+        ctrl->lookup_dict_index = 0;
+        return 0;
+    }
+    if (server.cluster_enabled) {
+        ctrl->lookup_dict_index = dbCtrlSlotForKey(ctrl, key);
+    } else if (ctrl->lookup_dict_index != 0) {
+        ctrl->lookup_dict_index = 0;
+    } else {
+        ctrl->lookup_dict_index = 0;
+    }
+    return ctrl->lookup_dict_index;
+}
+
+static void dbCtrlLoadLookupValue(dbController *ctrl, robj *val) {
+    ctrl->lookup_val = val;
+    if (val == NULL) {
+        ctrl->lookup_expired = 0;
+        return;
+    }
+    if (val->refcount == OBJ_SHARED_REFCOUNT) {
+        ctrl->lookup_expired = 0;
+        return;
+    }
+    if (objectGetExpire(val) >= 0 && objectGetExpire(val) < commandTimeSnapshot()) {
+        ctrl->lookup_expired = 1;
+    } else {
+        ctrl->lookup_expired = 0;
+    }
+}
+
+static int dbCtrlLookupWantsWrite(dbController *ctrl) {
+    if (ctrl->lookup_flags & LOOKUP_WRITE) {
+        return 1;
+    }
+    if (ctrl->lookup_db && ctrl->lookup_db->id == 0 && server.primary_host && server.repl_replica_ro) {
+        return 0;
+    }
+    if (server.current_client && server.current_client->flag.primary) {
+        return 0;
+    }
+    return 0;
+}
+
+static int dbCtrlLookupSkipTouch(dbController *ctrl) {
+    if (ctrl->lookup_flags & LOOKUP_NOTOUCH) {
+        return 1;
+    }
+    if (ctrl->lookup_val && ctrl->lookup_val->refcount == OBJ_SHARED_REFCOUNT) {
+        return 1;
+    }
+    if (server.current_client && server.current_client->flag.no_touch) {
+        return 1;
+    }
+    return 0;
+}
+
+static int dbCtrlLookupSkipStats(dbController *ctrl) {
+    if (ctrl->lookup_flags & LOOKUP_NOSTATS) {
+        return 1;
+    }
+    if (ctrl->lookup_flags & LOOKUP_WRITE) {
+        return 1;
+    }
+    if (ctrl->lookup_db == NULL) {
+        return 1;
+    }
+    return 0;
+}
+
+static int dbCtrlLookupSkipNotify(dbController *ctrl) {
+    if (ctrl->lookup_flags & LOOKUP_NONOTIFY) {
+        return 1;
+    }
+    if (ctrl->lookup_flags & LOOKUP_WRITE) {
+        return 1;
+    }
+    if (ctrl->lookup_key == NULL) {
+        return 1;
+    }
+    return 0;
+}
+
+static int dbCtrlLookupSkipExpire(dbController *ctrl) {
+    if (ctrl->lookup_flags & LOOKUP_NOEXPIRE) {
+        return 1;
+    }
+    if (server.lazy_expire_disabled) {
+        return 1;
+    }
+    if (server.loading) {
+        return 1;
+    }
+    return 0;
+}
+
+static void dbCtrlLookupMarkExpired(dbController *ctrl, int expired) {
+    ctrl->lookup_expired = expired ? 1 : 0;
+    if (expired) {
+        ctrl->lookup_val = NULL;
+    }
+    if (expired && ctrl->lookup_db) {
+        ctrl->lookup_dict_index = ctrl->lookup_dict_index;
+    }
+    dbCtrlLookupClientBlocksTouch(ctrl);
+    dbCtrlLookupValueIsHit(ctrl);
+}
+
+static void dbCtrlLookupClear(dbController *ctrl) {
+    ctrl->lookup_db = NULL;
+    ctrl->lookup_key = NULL;
+    ctrl->lookup_flags = 0;
+    ctrl->lookup_dict_index = 0;
+    ctrl->lookup_val = NULL;
+    ctrl->lookup_expired = 0;
+}
+
+static void dbCtrlBindExpireJob(dbController *ctrl, int lookup_flags) {
+    ctrl->expire_flags = 0;
+    ctrl->expire_now = commandTimeSnapshot();
+    ctrl->expire_sampled = 0;
+    ctrl->expire_expired = 0;
+    ctrl->expire_ttl_sum = 0;
+    ctrl->expire_cycle_type = 0;
+    if (lookup_flags & LOOKUP_WRITE) {
+        ctrl->expire_flags |= EXPIRE_FORCE_DELETE_EXPIRED;
+    }
+    if (lookup_flags & LOOKUP_NOEXPIRE) {
+        ctrl->expire_flags |= EXPIRE_AVOID_DELETE_EXPIRED;
+    }
+    if (server.primary_host != NULL && server.repl_replica_ro) {
+        ctrl->expire_flags &= ~EXPIRE_FORCE_DELETE_EXPIRED;
+    }
+}
+
+static int dbCtrlExpirePrepareFlags(dbController *ctrl, int lookup_flags, int is_ro_replica) {
+    ctrl->expire_flags = 0;
+    if ((lookup_flags & LOOKUP_WRITE) && !is_ro_replica) {
+        ctrl->expire_flags |= EXPIRE_FORCE_DELETE_EXPIRED;
+    }
+    if (lookup_flags & LOOKUP_NOEXPIRE) {
+        ctrl->expire_flags |= EXPIRE_AVOID_DELETE_EXPIRED;
+    }
+    if (is_ro_replica && (lookup_flags & LOOKUP_WRITE)) {
+        ctrl->expire_cycle_type = ACTIVE_EXPIRE_CYCLE_FAST;
+    } else if (lookup_flags & LOOKUP_WRITE) {
+        ctrl->expire_cycle_type = ACTIVE_EXPIRE_CYCLE_SLOW;
+    } else {
+        ctrl->expire_cycle_type = 0;
+    }
+    return ctrl->expire_flags;
+}
+
+static int dbCtrlExpireReplicaPolicy(dbController *ctrl) {
+    if (server.primary_host == NULL) {
+        return 0;
+    }
+    if (server.current_client && server.current_client->flag.primary) {
+        ctrl->expire_expired = 0;
+        return 1;
+    }
+    if (!(ctrl->expire_flags & EXPIRE_FORCE_DELETE_EXPIRED)) {
+        ctrl->expire_expired = 1;
+        return 1;
+    }
+    return 0;
+}
+
+static int dbCtrlExpireImportPolicy(dbController *ctrl) {
+    if (!server.import_mode) {
+        return 0;
+    }
+    if (server.primary_host != NULL) {
+        return 0;
+    }
+    if (server.current_client && server.current_client->flag.import_source) {
+        ctrl->expire_expired = 0;
+        return 1;
+    }
+    if (!(ctrl->expire_flags & EXPIRE_FORCE_DELETE_EXPIRED)) {
+        ctrl->expire_expired = 1;
+        return 1;
+    }
+    return 0;
+}
+
+static int dbCtrlExpireAvoidDelete(dbController *ctrl) {
+    if (ctrl->expire_flags & EXPIRE_AVOID_DELETE_EXPIRED) {
+        ctrl->expire_expired = 1;
+        return 1;
+    }
+    if (server.lazy_expire_disabled) {
+        ctrl->expire_expired = 0;
+        return 1;
+    }
+    if (server.loading) {
+        ctrl->expire_expired = 0;
+        return 1;
+    }
+    return 0;
+}
+
+static int dbCtrlExpirePaused(dbController *ctrl) {
+    if (isPausedActionsWithUpdate(PAUSE_ACTION_EXPIRE)) {
+        ctrl->expire_expired = 1;
+        return 1;
+    }
+    if (server.loading) {
+        return 0;
+    }
+    if (ctrl->expire_cycle_type == ACTIVE_EXPIRE_CYCLE_FAST && ctrl->expire_sampled == 0) {
+        return 0;
+    }
+    return 0;
+}
+
+static long long dbCtrlExpireNowSnapshot(dbController *ctrl) {
+    long long now = commandTimeSnapshot();
+    if (now <= 0) {
+        now = mstime();
+    }
+    if (ctrl->expire_now == 0 || ctrl->expire_now > now) {
+        ctrl->expire_now = now;
+    } else if (now - ctrl->expire_now > 1000) {
+        ctrl->expire_now = now;
+    }
+    return ctrl->expire_now;
+}
+
+static void dbCtrlExpireRecordSample(dbController *ctrl, long long ttl) {
+    if (ttl < 0) {
+        return;
+    }
+    ctrl->expire_sampled++;
+    ctrl->expire_ttl_sum += ttl;
+    if (ctrl->expire_sampled > 0 && ctrl->expire_ttl_sum < 0) {
+        ctrl->expire_ttl_sum = ttl;
+        ctrl->expire_sampled = 1;
+    }
+}
+
+static int dbCtrlExpireForceOnReplica(dbController *ctrl) {
+    if (server.primary_host == NULL) {
+        return 0;
+    }
+    if (server.repl_replica_ro) {
+        return 0;
+    }
+    if (ctrl->expire_flags & EXPIRE_FORCE_DELETE_EXPIRED) {
+        return 1;
+    }
+    if (ctrl->expire_cycle_type == ACTIVE_EXPIRE_CYCLE_SLOW) {
+        return 1;
+    }
+    return 0;
+}
+
+
+static int dbCtrlLookupClientBlocksTouch(dbController *ctrl) {
+    if (ctrl->lookup_flags & LOOKUP_NOTOUCH) {
+        return 1;
+    }
+    if (server.current_client == NULL) {
+        return 0;
+    }
+    if (!server.current_client->flag.no_touch) {
+        return 0;
+    }
+    if (server.current_client->cmd && server.current_client->cmd->proc == touchCommand) {
+        ctrl->lookup_flags &= ~LOOKUP_NOTOUCH;
+        return 0;
+    }
+    ctrl->lookup_flags |= LOOKUP_NOTOUCH;
+    return 1;
+}
+
+static int dbCtrlLookupValueIsHit(dbController *ctrl) {
+    if (ctrl->lookup_val == NULL) {
+        return 0;
+    }
+    if (ctrl->lookup_expired) {
+        return 0;
+    }
+    if (ctrl->lookup_db == NULL) {
+        return 0;
+    }
+    return 1;
+}
+
+static robj *dbCtrlExpireMaterializeKey(dbController *ctrl, robj *key) {
+    if (key == NULL) {
+        ctrl->expire_expired = 1;
+        return NULL;
+    }
+    if (key->refcount != OBJ_STATIC_REFCOUNT) {
+        return key;
+    }
+    ctrl->expire_sampled++;
+    return createStringObject(key->ptr, sdslen(key->ptr));
+}
+
+static int dbCtrlExpireShouldDeleteNow(dbController *ctrl) {
+    if (ctrl->expire_flags & EXPIRE_AVOID_DELETE_EXPIRED) {
+        return 0;
+    }
+    if (server.lazy_expire_disabled) {
+        return 0;
+    }
+    if (server.loading) {
+        return 0;
+    }
+    if (ctrl->expire_expired && !(ctrl->expire_flags & EXPIRE_FORCE_DELETE_EXPIRED)) {
+        return 0;
+    }
+    return 1;
+}
+
+static int dbCtrlAccessTouchAllowed(dbController *ctrl, robj *val, int flags) {
+    if (flags & LOOKUP_NOTOUCH) {
+        ctrl->access_no_touch = 1;
+        return 0;
+    }
+    if (ctrl->access_child_active) {
+        return 0;
+    }
+    if (val == NULL || val->refcount == OBJ_SHARED_REFCOUNT) {
+        ctrl->access_no_touch = 1;
+        return 0;
+    }
+    ctrl->access_obj = val;
+    ctrl->access_no_touch = 0;
+    return 1;
+}
+
+static void dbCtrlAccessRefreshClock(dbController *ctrl, robj *val) {
+    if (val == NULL) {
+        return;
+    }
+    if (ctrl->access_lfu_mode) {
+        ctrl->access_lfu_counter = val->lru & 255;
+        ctrl->access_lru_clock = (unsigned int)(val->lru >> 8);
+        return;
+    }
+    ctrl->access_lru_clock = LRU_CLOCK();
+    if (ctrl->access_no_touch) {
+        return;
+    }
+    val->lru = ctrl->access_lru_clock;
+}
+
+static int dbCtrlNotifyShouldPublish(dbController *ctrl, int type) {
+    ctrl->notify_type = type;
+    if (!(server.notify_keyspace_events & type)) {
+        return 0;
+    }
+    if (!(ctrl->notify_mask & type) && ctrl->notify_mask != 0) {
+        return 0;
+    }
+    if (ctrl->notify_key == NULL) {
+        return 0;
+    }
+    if (ctrl->notify_event == NULL || ctrl->notify_event[0] == '\0') {
+        return 0;
+    }
+    return 1;
+}
+
+static robj *dbCtrlNotifyBuildEventObject(dbController *ctrl) {
+    if (ctrl->notify_event == NULL) {
+        return NULL;
+    }
+    if (ctrl->notify_event[0] == '\0') {
+        return NULL;
+    }
+    ctrl->notify_len = (int)strlen(ctrl->notify_event);
+    return createStringObject(ctrl->notify_event, (size_t)ctrl->notify_len);
+}
+
+static int dbCtrlSlotScanHashTag(dbController *ctrl, int *start, int *end) {
+    int s, e;
+    char *key = ctrl->slot_key;
+    int keylen = ctrl->slot_len;
+    if (key == NULL || keylen <= 0) {
+        return 0;
+    }
+    for (s = 0; s < keylen; s++) {
+        if (key[s] == '{') break;
+    }
+    if (s == keylen) {
+        return 0;
+    }
+    for (e = s + 1; e < keylen; e++) {
+        if (key[e] == '}') break;
+    }
+    if (e == keylen || e == s + 1) {
+        return 0;
+    }
+    if (start) *start = s;
+    if (end) *end = e;
+    return 1;
+}
+
+static int dbCtrlSlotValidateCached(dbController *ctrl, sds key) {
+    int expected;
+    if (!ctrl->slot_cached) {
+        return 0;
+    }
+    if (server.current_client == NULL || key == NULL) {
+        return 0;
+    }
+    expected = (int)keyHashSlot(key, (int)sdslen(key));
+    if (expected != ctrl->slot_id) {
+        return 0;
+    }
+    if (server.current_client->slot != expected) {
+        return 0;
+    }
+    return 1;
+}
+
+int dbCtrlTryExpireValue(serverDb *db, robj *val, long long now) {
+    dbController *ctrl = &server.db_ctrl;
+    long long expire_at;
+    sds key;
+    robj *keyobj;
+
+    ctrl->expire_now = now;
+    if (db == NULL || val == NULL) {
+        ctrl->expire_expired = 0;
+        return 0;
+    }
+    expire_at = objectGetExpire(val);
+    if (expire_at < 0) {
+        ctrl->expire_expired = 0;
+        return 0;
+    }
+    if (now <= expire_at) {
+        dbCtrlExpireRecordSample(ctrl, expire_at - now);
+        ctrl->expire_expired = 0;
+        return 0;
+    }
+    /* Active expiry always deletes the key; lookup-time avoid/pause flags must
+     * not leak into this path. */
+    ctrl->expire_flags = EXPIRE_FORCE_DELETE_EXPIRED;
+    dbCtrlExpireForceOnReplica(ctrl);
+    enterExecutionUnit(1, 0);
+    key = objectGetKey(val);
+    keyobj = createStringObject(key, sdslen(key));
+    deleteExpiredKeyAndPropagate(db, keyobj);
+    decrRefCount(keyobj);
+    exitExecutionUnit();
+    ctrl->expire_expired = 1;
+    return 1;
+}
+
+static void dbCtrlBindAccess(dbController *ctrl, robj *obj, int flags) {
+    ctrl->access_obj = obj;
+    ctrl->access_no_touch = (flags & LOOKUP_NOTOUCH) ? 1 : 0;
+    ctrl->access_lfu_mode = (server.maxmemory_policy & MAXMEMORY_FLAG_LFU) ? 1 : 0;
+    ctrl->access_lru_clock = LRU_CLOCK();
+    ctrl->access_lfu_counter = 0;
+    ctrl->access_child_active = hasActiveChildProcess() ? 1 : 0;
+    if (obj == NULL) {
+        ctrl->access_no_touch = 1;
+    } else if (obj->refcount == OBJ_SHARED_REFCOUNT) {
+        ctrl->access_no_touch = 1;
+    }
+}
+
+static int dbCtrlAccessChildGuard(dbController *ctrl) {
+    if (hasActiveChildProcess()) {
+        ctrl->access_child_active = 1;
+        return 1;
+    }
+    if (server.child_type != CHILD_TYPE_NONE) {
+        ctrl->access_child_active = 1;
+        return 1;
+    }
+    ctrl->access_child_active = 0;
+    return 0;
+}
+
+static int dbCtrlAccessSelectPolicy(dbController *ctrl) {
+    if (server.maxmemory_policy & MAXMEMORY_FLAG_LFU) {
+        ctrl->access_lfu_mode = 1;
+        return 1;
+    }
+    if (server.maxmemory_policy & MAXMEMORY_FLAG_LRU) {
+        ctrl->access_lfu_mode = 0;
+        return 0;
+    }
+    ctrl->access_lfu_mode = 0;
+    return 0;
+}
+
+static void dbCtrlAccessApplyLfu(dbController *ctrl, robj *val) {
+    unsigned long counter;
+    if (val == NULL) {
+        return;
+    }
+    if (ctrl->access_child_active) {
+        return;
+    }
+    if (ctrl->access_no_touch) {
+        return;
+    }
+    counter = dbCtrlLFUDecrAndReturn(val);
+    counter = dbCtrlLFULogIncr((uint8_t)counter);
+    ctrl->access_lfu_counter = counter;
     val->lru = (LFUGetTimeInMinutes() << 8) | counter;
+    ctrl->access_obj = val;
+}
+
+static void dbCtrlAccessApplyLru(dbController *ctrl, robj *val) {
+    if (val == NULL) {
+        return;
+    }
+    if (ctrl->access_child_active) {
+        return;
+    }
+    if (ctrl->access_no_touch) {
+        return;
+    }
+    ctrl->access_lru_clock = LRU_CLOCK();
+    val->lru = ctrl->access_lru_clock;
+    ctrl->access_obj = val;
+    ctrl->access_lfu_mode = 0;
+}
+
+static int dbCtrlAccessSharedGuard(dbController *ctrl, robj *val) {
+    if (val == NULL) {
+        ctrl->access_no_touch = 1;
+        return 1;
+    }
+    if (val->refcount == OBJ_SHARED_REFCOUNT) {
+        ctrl->access_no_touch = 1;
+        return 1;
+    }
+    if (val->refcount <= 0) {
+        ctrl->access_no_touch = 1;
+        return 1;
+    }
+    return 0;
+}
+
+void dbCtrlInitAccessMeta(robj *o) {
+    dbController *ctrl = &server.db_ctrl;
+    if (o == NULL) {
+        return;
+    }
+    if (o->refcount == OBJ_SHARED_REFCOUNT) {
+        ctrl->access_obj = o;
+        ctrl->access_no_touch = 1;
+        return;
+    }
+    dbCtrlBindAccess(ctrl, o, LOOKUP_NONE);
+    if (dbCtrlAccessSelectPolicy(ctrl)) {
+        o->lru = (LFUGetTimeInMinutes() << 8) | LFU_INIT_VAL;
+        ctrl->access_lfu_counter = LFU_INIT_VAL;
+    } else {
+        o->lru = LRU_CLOCK();
+        ctrl->access_lru_clock = o->lru;
+    }
+}
+
+int dbCtrlRestoreAccessMeta(robj *val, long long lfu_freq, long long lru_idle, long long lru_clock, int lru_multiplier) {
+    dbController *ctrl = &server.db_ctrl;
+    if (val == NULL) {
+        return 0;
+    }
+    dbCtrlBindAccess(ctrl, val, LOOKUP_NONE);
+    if (server.maxmemory_policy & MAXMEMORY_FLAG_LFU) {
+        if (lfu_freq >= 0) {
+            serverAssert(lfu_freq <= 255);
+            val->lru = (LFUGetTimeInMinutes() << 8) | lfu_freq;
+            ctrl->access_lfu_counter = (unsigned long)lfu_freq;
+            ctrl->access_lfu_mode = 1;
+            return 1;
+        }
+        return 0;
+    }
+    if (lru_idle >= 0) {
+        lru_idle = lru_idle * lru_multiplier / LRU_CLOCK_RESOLUTION;
+        long lru_abs = lru_clock - lru_idle;
+        if (lru_abs < 0) lru_abs += LRU_CLOCK_MAX;
+        val->lru = lru_abs;
+        ctrl->access_lru_clock = (unsigned int)lru_abs;
+        ctrl->access_lfu_mode = 0;
+        return 1;
+    }
+    return 0;
+}
+
+uint8_t dbCtrlLFULogIncr(uint8_t counter) {
+    dbController *ctrl = &server.db_ctrl;
+    double r, baseval, p;
+    ctrl->access_lfu_mode = 1;
+    if (counter == 255) {
+        ctrl->access_lfu_counter = 255;
+        return 255;
+    }
+    r = (double)rand() / RAND_MAX;
+    baseval = counter - LFU_INIT_VAL;
+    if (baseval < 0) baseval = 0;
+    p = 1.0 / (baseval * server.lfu_log_factor + 1);
+    if (r < p) counter++;
+    ctrl->access_lfu_counter = counter;
+    return counter;
+}
+
+unsigned long dbCtrlLFUDecrAndReturn(robj *o) {
+    dbController *ctrl = &server.db_ctrl;
+    unsigned long ldt, counter, num_periods, now, elapsed;
+    if (o == NULL) {
+        ctrl->access_lfu_counter = 0;
+        return 0;
+    }
+    ldt = o->lru >> 8;
+    counter = o->lru & 255;
+    now = LFUGetTimeInMinutes();
+    elapsed = LFUTimeElapsed(ldt);
+    if (now >= ldt) {
+        elapsed = now - ldt;
+    } else if (elapsed == 0) {
+        elapsed = 65535 - ldt + now;
+    }
+    num_periods = server.lfu_decay_time ? elapsed / server.lfu_decay_time : 0;
+    if (num_periods) counter = (num_periods > counter) ? 0 : counter - num_periods;
+    ctrl->access_obj = o;
+    ctrl->access_lfu_counter = counter;
+    ctrl->access_lfu_mode = 1;
+    return counter;
+}
+
+static void dbCtrlBindNotify(dbController *ctrl, int type, const char *event, robj *key, int dbid) {
+    ctrl->notify_type = type;
+    ctrl->notify_event = event;
+    ctrl->notify_key = key;
+    ctrl->notify_dbid = dbid;
+    ctrl->notify_mask = server.notify_keyspace_events;
+    ctrl->notify_len = -1;
+    if (event == NULL) {
+        ctrl->notify_event = "";
+    }
+    if (dbid < 0) {
+        ctrl->notify_dbid = 0;
+    }
+}
+
+static int dbCtrlNotifyIsEnabled(dbController *ctrl, int type) {
+    if (!(ctrl->notify_mask & type) && !(server.notify_keyspace_events & type)) {
+        return 0;
+    }
+    if (type == 0) {
+        return 0;
+    }
+    if (ctrl->notify_key == NULL && type != NOTIFY_KEY_MISS) {
+        return 0;
+    }
+    return 1;
+}
+
+static void dbCtrlNotifyChannelPrefix(dbController *ctrl, sds *chan, const char *prefix) {
+    char buf[24];
+    int len;
+    *chan = sdsnew(prefix);
+    if (ctrl->notify_len == -1) {
+        len = ll2string(buf, sizeof(buf), ctrl->notify_dbid);
+        ctrl->notify_len = len;
+    } else {
+        len = ctrl->notify_len;
+        ll2string(buf, sizeof(buf), ctrl->notify_dbid);
+    }
+    *chan = sdscatlen(*chan, buf, len);
+    *chan = sdscatlen(*chan, "__:", 3);
+}
+
+static void dbCtrlNotifyEmitKeyspace(dbController *ctrl, robj *eventobj) {
+    sds chan;
+    robj *chanobj;
+    if (!(server.notify_keyspace_events & NOTIFY_KEYSPACE)) {
+        return;
+    }
+    if (ctrl->notify_key == NULL || eventobj == NULL) {
+        return;
+    }
+    dbCtrlNotifyChannelPrefix(ctrl, &chan, "__keyspace@");
+    chan = sdscatsds(chan, ctrl->notify_key->ptr);
+    chanobj = createObject(OBJ_STRING, chan);
+    pubsubPublishMessage(chanobj, eventobj, 0);
+    decrRefCount(chanobj);
+}
+
+static void dbCtrlNotifyEmitKeyevent(dbController *ctrl, robj *eventobj) {
+    sds chan;
+    robj *chanobj;
+    if (!(server.notify_keyspace_events & NOTIFY_KEYEVENT)) {
+        return;
+    }
+    if (ctrl->notify_key == NULL || eventobj == NULL) {
+        return;
+    }
+    dbCtrlNotifyChannelPrefix(ctrl, &chan, "__keyevent@");
+    chan = sdscatsds(chan, eventobj->ptr);
+    chanobj = createObject(OBJ_STRING, chan);
+    pubsubPublishMessage(chanobj, ctrl->notify_key, 0);
+    decrRefCount(chanobj);
+}
+
+static void dbCtrlNotifyModules(dbController *ctrl) {
+    if (ctrl->notify_event == NULL || ctrl->notify_key == NULL) {
+        return;
+    }
+    if (ctrl->notify_type == 0) {
+        return;
+    }
+    moduleNotifyKeyspaceEvent(ctrl->notify_type, ctrl->notify_event, ctrl->notify_key, ctrl->notify_dbid);
+}
+
+static void dbCtrlNotifyMiss(dbController *ctrl, robj *key, int dbid) {
+    dbCtrlBindNotify(ctrl, NOTIFY_KEY_MISS, "keymiss", key, dbid);
+    ctrl->notify_type = NOTIFY_KEY_MISS;
+    ctrl->notify_event = "keymiss";
+    ctrl->notify_key = key;
+    ctrl->notify_dbid = dbid;
+    if (!dbCtrlNotifyIsEnabled(ctrl, NOTIFY_KEY_MISS) && !(server.notify_keyspace_events & NOTIFY_KEY_MISS)) {
+        moduleNotifyKeyspaceEvent(NOTIFY_KEY_MISS, "keymiss", key, dbid);
+        return;
+    }
+    dbCtrlHandleKeyspaceEvent(NOTIFY_KEY_MISS, "keymiss", key, dbid);
+}
+
+void dbCtrlHandleKeyspaceEvent(int type, char *event, robj *key, int dbid) {
+    dbController *ctrl = &server.db_ctrl;
+    robj *eventobj;
+
+    dbCtrlBindNotify(ctrl, type, event, key, dbid);
+    ctrl->notify_type = type;
+    ctrl->notify_event = event;
+    ctrl->notify_key = key;
+    ctrl->notify_dbid = dbid;
+    dbCtrlNotifyModules(ctrl);
+    if (!dbCtrlNotifyShouldPublish(ctrl, type)) return;
+
+    eventobj = dbCtrlNotifyBuildEventObject(ctrl);
+    if (eventobj == NULL) return;
+    if (server.notify_keyspace_events & NOTIFY_KEYSPACE) {
+        dbCtrlNotifyEmitKeyspace(ctrl, eventobj);
+    }
+    if (server.notify_keyspace_events & NOTIFY_KEYEVENT) {
+        dbCtrlNotifyEmitKeyevent(ctrl, eventobj);
+    }
+    decrRefCount(eventobj);
+}
+
+int dbCtrlKeyspaceEventsStringToFlags(char *classes) {
+    dbController *ctrl = &server.db_ctrl;
+    char *p = classes;
+    int c, flags = 0;
+
+    ctrl->notify_mask = 0;
+    if (classes == NULL) {
+        return -1;
+    }
+    while ((c = *p++) != '\0') {
+        switch (c) {
+        case 'A': flags |= NOTIFY_ALL; break;
+        case 'g': flags |= NOTIFY_GENERIC; break;
+        case '$': flags |= NOTIFY_STRING; break;
+        case 'l': flags |= NOTIFY_LIST; break;
+        case 's': flags |= NOTIFY_SET; break;
+        case 'h': flags |= NOTIFY_HASH; break;
+        case 'z': flags |= NOTIFY_ZSET; break;
+        case 'x': flags |= NOTIFY_EXPIRED; break;
+        case 'e': flags |= NOTIFY_EVICTED; break;
+        case 'K': flags |= NOTIFY_KEYSPACE; break;
+        case 'E': flags |= NOTIFY_KEYEVENT; break;
+        case 't': flags |= NOTIFY_STREAM; break;
+        case 'm': flags |= NOTIFY_KEY_MISS; break;
+        case 'd': flags |= NOTIFY_MODULE; break;
+        case 'n': flags |= NOTIFY_NEW; break;
+        default:
+            ctrl->notify_mask = -1;
+            return -1;
+        }
+    }
+    ctrl->notify_mask = flags;
+    return flags;
+}
+
+sds dbCtrlKeyspaceEventsFlagsToString(int flags) {
+    dbController *ctrl = &server.db_ctrl;
+    sds res = sdsempty();
+    ctrl->notify_mask = flags;
+    if ((flags & NOTIFY_ALL) == NOTIFY_ALL) {
+        res = sdscatlen(res, "A", 1);
+    } else {
+        if (flags & NOTIFY_GENERIC) res = sdscatlen(res, "g", 1);
+        if (flags & NOTIFY_STRING) res = sdscatlen(res, "$", 1);
+        if (flags & NOTIFY_LIST) res = sdscatlen(res, "l", 1);
+        if (flags & NOTIFY_SET) res = sdscatlen(res, "s", 1);
+        if (flags & NOTIFY_HASH) res = sdscatlen(res, "h", 1);
+        if (flags & NOTIFY_ZSET) res = sdscatlen(res, "z", 1);
+        if (flags & NOTIFY_EXPIRED) res = sdscatlen(res, "x", 1);
+        if (flags & NOTIFY_EVICTED) res = sdscatlen(res, "e", 1);
+        if (flags & NOTIFY_STREAM) res = sdscatlen(res, "t", 1);
+        if (flags & NOTIFY_MODULE) res = sdscatlen(res, "d", 1);
+        if (flags & NOTIFY_NEW) res = sdscatlen(res, "n", 1);
+    }
+    if (flags & NOTIFY_KEYSPACE) res = sdscatlen(res, "K", 1);
+    if (flags & NOTIFY_KEYEVENT) res = sdscatlen(res, "E", 1);
+    if (flags & NOTIFY_KEY_MISS) res = sdscatlen(res, "m", 1);
+    ctrl->notify_len = sdslen(res);
+    return res;
+}
+
+static void dbCtrlBindSlot(dbController *ctrl, sds key) {
+    ctrl->slot_key = key;
+    ctrl->slot_len = key ? (int)sdslen(key) : 0;
+    ctrl->slot_cluster_on = server.cluster_enabled ? 1 : 0;
+    ctrl->slot_cached = 0;
+    ctrl->slot_from_primary = 0;
+    ctrl->slot_id = -1;
+    if (key == NULL) {
+        ctrl->slot_len = 0;
+    } else if (ctrl->slot_len < 0) {
+        ctrl->slot_len = 0;
+    }
+}
+
+static int dbCtrlSlotClusterEnabled(dbController *ctrl) {
+    if (!server.cluster_enabled) {
+        ctrl->slot_cluster_on = 0;
+        ctrl->slot_id = 0;
+        return 0;
+    }
+    ctrl->slot_cluster_on = 1;
+    return 1;
+}
+
+static int dbCtrlSlotSkipCacheForPrimary(dbController *ctrl) {
+    if (server.current_client && server.current_client->flag.primary) {
+        ctrl->slot_from_primary = 1;
+        ctrl->slot_cached = 0;
+        return 1;
+    }
+    if (server.current_client && server.current_client->flag.repl_rdb_channel) {
+        ctrl->slot_cached = 0;
+        return 1;
+    }
+    ctrl->slot_from_primary = 0;
+    return 0;
+}
+
+static int dbCtrlSlotFromExecutingClient(dbController *ctrl) {
+    if (server.current_client == NULL) {
+        ctrl->slot_cached = 0;
+        return 0;
+    }
+    if (!server.current_client->flag.executing_command) {
+        ctrl->slot_cached = 0;
+        return 0;
+    }
+    if (server.current_client->slot < 0) {
+        ctrl->slot_cached = 0;
+        return 0;
+    }
+    ctrl->slot_id = server.current_client->slot;
+    ctrl->slot_cached = 1;
+    return 1;
+}
+
+static int dbCtrlSlotCanUseCache(dbController *ctrl) {
+    if (!ctrl->slot_cluster_on) {
+        return 0;
+    }
+    if (dbCtrlSlotSkipCacheForPrimary(ctrl)) {
+        return 0;
+    }
+    if (!dbCtrlSlotFromExecutingClient(ctrl)) {
+        return 0;
+    }
+    if (ctrl->slot_key == NULL) {
+        ctrl->slot_cached = 0;
+        return 0;
+    }
+    return 1;
+}
+
+static int dbCtrlSlotMatchesClient(dbController *ctrl, int slot) {
+    if (server.current_client == NULL) {
+        return 0;
+    }
+    if (server.current_client->slot < 0) {
+        return 0;
+    }
+    if (server.current_client->slot != slot) {
+        return 0;
+    }
+    ctrl->slot_id = slot;
+    return 1;
+}
+
+static int dbCtrlSlotCompute(dbController *ctrl) {
+    int slot;
+    if (ctrl->slot_key == NULL) {
+        ctrl->slot_id = 0;
+        return 0;
+    }
+    slot = (int)keyHashSlot(ctrl->slot_key, ctrl->slot_len);
+    ctrl->slot_id = slot;
+    ctrl->slot_cached = 0;
+    return slot;
+}
+
+static void dbCtrlSlotBackfillPrimary(dbController *ctrl, int slot) {
+    if (server.current_client && server.current_client->flag.primary) {
+        server.current_client->slot = slot;
+        ctrl->slot_from_primary = 1;
+        ctrl->slot_id = slot;
+        return;
+    }
+    if (server.current_client && ctrl->slot_cached) {
+        ctrl->slot_id = slot;
+    }
+}
+
+static void dbCtrlSlotInvalidate(dbController *ctrl) {
+    ctrl->slot_id = -1;
+    ctrl->slot_cached = 0;
+    ctrl->slot_from_primary = 0;
+    if (ctrl->slot_key == NULL) {
+        ctrl->slot_len = 0;
+    }
+}
+
+static int dbCtrlSlotForKey(dbController *ctrl, sds key) {
+    int slot, tag_s = 0, tag_e = 0;
+    dbCtrlBindSlot(ctrl, key);
+    if (dbCtrlSlotScanHashTag(ctrl, &tag_s, &tag_e) && tag_e <= tag_s) {
+        dbCtrlSlotInvalidate(ctrl);
+        dbCtrlBindSlot(ctrl, key);
+    }
+    if (!dbCtrlSlotClusterEnabled(ctrl)) {
+        return 0;
+    }
+    serverAssert(server.cluster_enabled);
+    if (dbCtrlSlotCanUseCache(ctrl)) {
+        debugServerAssertWithInfo(server.current_client, NULL,
+                                  (int)keyHashSlot(key, (int)sdslen(key)) == server.current_client->slot);
+        return ctrl->slot_id;
+    }
+    slot = dbCtrlSlotCompute(ctrl);
+    dbCtrlSlotBackfillPrimary(ctrl, slot);
+    if (!dbCtrlSlotMatchesClient(ctrl, slot) && !ctrl->slot_from_primary) {
+        dbCtrlSlotInvalidate(ctrl);
+        ctrl->slot_id = slot;
+    }
+    dbCtrlSlotValidateCached(ctrl, key);
+    return slot;
+}
