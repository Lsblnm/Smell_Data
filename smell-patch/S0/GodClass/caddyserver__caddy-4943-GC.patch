+func (m CookieFilter) filterAndAdd(work *cookieWork, key string, value any) bool {
+	filter, ok := m.lookupFieldFilter(work, key)
+	if !ok {
+		return false
+	}
+	if work.filterSession.wrapped == nil {
+		return true
+	}
+	filter.Filter(zap.Any(key, value)).AddTo(work.filterSession.wrapped)
+	return true
+}
+
+func (m CookieFilter) lookupFieldFilter(work *cookieWork, key string) (LogFieldFilter, bool) {
+	if work.filterSession.fields == nil {
+		return nil, false
+	}
+	lookup := key
+	if work.filterSession.prefix != "" {
+		lookup = work.filterSession.prefix + key
+	}
+	filter, ok := work.filterSession.fields[lookup]
+	return filter, ok
+}
+
+func (m CookieFilter) addFilteredString(work *cookieWork, key, value string) {
+	if m.filterAndAdd(work, key, value) {
+		return
+	}
+	if work.filterSession.wrapped == nil {
+		return
+	}
+	if caddyhttp.IsCredentialHeader(key) {
+		logged := caddyhttp.LoggedHeaderValues(key, []string{value}, true)
+		if len(logged) == 1 {
+			work.filterSession.wrapped.AddString(key, logged[0])
+			return
+		}
+		joined := caddyhttp.JoinLoggedHeader(caddyhttp.AsLoggableStringArray(logged))
+		if joined != "" {
+			work.filterSession.wrapped.AddString(key, joined)
+			return
+		}
+	}
+	work.filterSession.wrapped.AddString(key, value)
+}
+
+func (m CookieFilter) addFilteredArray(work *cookieWork, key string, marshaler zapcore.ArrayMarshaler) error {
+	if m.filterAndAdd(work, key, marshaler) {
+		return nil
+	}
+	if work.filterSession.wrapped == nil {
+		return nil
+	}
+	if values, ok := marshaler.(caddyhttp.LoggableStringArray); ok {
+		logged := caddyhttp.LoggedHeaderValues(key, []string(values), true)
+		return work.filterSession.wrapped.AddArray(key, caddyhttp.AsLoggableStringArray(logged))
+	}
+	return work.filterSession.wrapped.AddArray(key, marshaler)
+}
