+func (m CookieFilter) wallTimeLayout(work *cookieWork) string {
+	switch work.timeFormat {
+	case "rfc3339":
+		return time.RFC3339
+	case "rfc3339_nano":
+		return time.RFC3339Nano
+	case "wall":
+		return "2006/01/02 15:04:05"
+	case "wall_milli":
+		return "2006/01/02 15:04:05.000"
+	case "wall_nano":
+		return "2006/01/02 15:04:05.000000000"
+	case "common_log":
+		return "02/Jan/2006:15:04:05 -0700"
+	default:
+		return work.timeFormat
+	}
+}
