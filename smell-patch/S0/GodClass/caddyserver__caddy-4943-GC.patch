+func (m CookieFilter) applyRollDefaults(work *cookieWork) {
+	if work.roll == nil || *work.roll {
+		if work.rollSizeMB == 0 {
+			work.rollSizeMB = 100
+		}
+		if work.rollCompress == nil {
+			compress := true
+			work.rollCompress = &compress
+		}
+		if work.rollKeep == 0 {
+			work.rollKeep = 10
+		}
+		if work.rollKeepDays == 0 {
+			work.rollKeepDays = 90
+		}
+	}
+}
