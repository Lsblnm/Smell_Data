+func (f *CookieFilter) cookieDeleteNames() []string {
+	names := make([]string, 0, len(f.Actions))
+	for _, a := range f.Actions {
+		if a.Type == deleteAction {
+			names = append(names, a.Name)
+		}
+	}
+	return names
+}
+
+func (f *CookieFilter) cookieContains(name string, action filterAction) bool {
+	for _, a := range f.Actions {
+		if a.Name == name && a.Type == action {
+			return true
+		}
+	}
+	return false
+}
+
+func (f *CookieFilter) cookieValidCount() int {
+	n := 0
+	for _, a := range f.Actions {
+		if a.Type.IsValid() != nil {
+			continue
+		}
+		if a.Type == replaceAction || a.Type == hashAction || a.Type == deleteAction {
+			n++
+			continue
+		}
+		n++
+	}
+	return n
+}
+
+func (f *CookieFilter) cookieInvalidCount() int {
+	return len(f.Actions) - f.cookieValidCount()
+}
