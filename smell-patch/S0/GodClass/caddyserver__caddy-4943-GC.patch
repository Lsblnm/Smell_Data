+func (m CookieFilter) cloneFilteredEncoder(work *cookieWork) zapcore.Encoder {
+	cloned := filterSession{
+		fields: work.filterSession.fields,
+		prefix: work.filterSession.prefix,
+	}
+	if work.filterSession.wrapped != nil {
+		cloned.wrapped = work.filterSession.wrapped.Clone()
+	}
+	return FilterEncoder{
+		Fields:    cloned.fields,
+		wrapped:   cloned.wrapped,
+		keyPrefix: cloned.prefix,
+	}
+}
