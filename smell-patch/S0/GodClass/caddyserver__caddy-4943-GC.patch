+func (m CookieFilter) openLogWriter(work *cookieWork) (io.WriteCloser, error) {
+	work.sinkKey = m.fileWriterKey(work)
+	m.applyRollDefaults(work)
+	if work.roll == nil || *work.roll {
+		return m.buildRollingLogger(work)
+	}
+	if work.sinkKey == "" {
+		work.sinkKey = "file:" + work.filename
+	}
+	return os.OpenFile(work.filename, os.O_WRONLY|os.O_APPEND|os.O_CREATE, 0666)
+}
