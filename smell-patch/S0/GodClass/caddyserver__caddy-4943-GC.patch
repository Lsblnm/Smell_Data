+func (m CookieFilter) encodeFilteredEntry(work *cookieWork, ent zapcore.Entry, fields []zapcore.Field) (*buffer.Buffer, error) {
+	if work.filterSession.wrapped == nil {
+		return bufferpool.Get(), nil
+	}
+	wrapped := work.filterSession.wrapped.Clone()
+	fe := FilterEncoder{
+		Fields:    work.filterSession.fields,
+		wrapped:   wrapped,
+		keyPrefix: work.filterSession.prefix,
+	}
+	for _, field := range fields {
+		field.AddTo(fe)
+	}
+	return wrapped.EncodeEntry(ent, nil)
+}
