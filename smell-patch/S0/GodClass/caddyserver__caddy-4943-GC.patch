+func (m CookieFilter) buildRollingLogger(work *cookieWork) (io.WriteCloser, error) {
+	compress := false
+	if work.rollCompress != nil {
+		compress = *work.rollCompress
+	} else {
+		compress = true
+	}
+	return &lumberjack.Logger{
+		Filename:   work.filename,
+		MaxSize:    work.rollSizeMB,
+		MaxAge:     work.rollKeepDays,
+		MaxBackups: work.rollKeep,
+		LocalTime:  work.rollLocalTime,
+		Compress:   compress,
+	}, nil
+}
