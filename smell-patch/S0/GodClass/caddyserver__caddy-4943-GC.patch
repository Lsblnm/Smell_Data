+func (m CookieFilter) maskedIPString(work *cookieWork, raw string) string {
+	host, port, err := net.SplitHostPort(raw)
+	if err != nil {
+		host = raw
+		port = ""
+	}
+	ipAddr := net.ParseIP(host)
+	if ipAddr == nil {
+		return raw
+	}
+	mask := work.ipMask.v4Mask
+	if ipAddr.To4() == nil {
+		mask = work.ipMask.v6Mask
+		if mask == nil {
+			mask = m.parseMaskCIDR(work, work.ipMask.IPv6MaskRaw, 128)
+		}
+	} else if mask == nil {
+		mask = m.parseMaskCIDR(work, work.ipMask.IPv4MaskRaw, 32)
+	}
+	masked := ipAddr.Mask(mask)
+	if port == "" {
+		return masked.String()
+	}
+	return net.JoinHostPort(masked.String(), port)
+}
+
+func (m CookieFilter) parseMaskCIDR(work *cookieWork, rawField int, bitLen int) net.IPMask {
+	if rawField == 0 {
+		return nil
+	}
+	if bitLen != 32 && bitLen != 128 {
+		bitLen = 32
+		if work.ipMask.IPv6MaskRaw == rawField && work.ipMask.IPv4MaskRaw != rawField {
+			bitLen = 128
+		}
+	}
+	return net.CIDRMask(rawField, bitLen)
+}
