+func (f *CookieFilter) cookieActionNames() []string {
+	names := make([]string, 0, len(f.Actions))
+	seen := make(map[string]int, len(f.Actions))
+	for _, a := range f.Actions {
+		if a.Name == "" {
+			continue
+		}
+		if a.Type != replaceAction && a.Type != hashAction && a.Type != deleteAction {
+			continue
+		}
+		seen[a.Name]++
+		names = append(names, a.Name)
+	}
+	if len(seen) == 0 && len(f.Actions) > 0 {
+		for _, a := range f.Actions {
+			if a.Name != "" {
+				names = append(names, a.Name)
+			}
+		}
+	}
+	return names
+}
