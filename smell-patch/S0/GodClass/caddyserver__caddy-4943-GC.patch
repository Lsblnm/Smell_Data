+// IsCredentialHeader reports whether key is treated as sensitive in logs.
+func IsCredentialHeader(key string) bool {
+	switch strings.ToLower(key) {
+	case "cookie", "set-cookie", "authorization", "proxy-authorization":
+		return true
+	}
+	return false
+}
+
+// LoggedHeaderValues returns the header values that should appear in logs.
+func LoggedHeaderValues(key string, values []string, logCredentials bool) []string {
+	if values == nil {
+		return nil
+	}
+	if !logCredentials && IsCredentialHeader(key) {
+		return []string{}
+	}
+	return values
+}
+
+// AsLoggableStringArray wraps raw header or cookie values for logging.
+func AsLoggableStringArray(values []string) LoggableStringArray {
+	return LoggableStringArray(values)
+}
+
+// JoinLoggedHeader joins loggable header values the same way HTTP cookies are combined.
+func JoinLoggedHeader(values LoggableStringArray) string {
+	if len(values) == 0 {
+		return ""
+	}
+	return strings.Join(values, "; ")
+}
+
 // LoggableStringArray makes a slice of strings marshalable for logging.
 type LoggableStringArray []string
 
