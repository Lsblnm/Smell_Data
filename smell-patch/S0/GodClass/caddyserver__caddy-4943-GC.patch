+func (f *CookieFilter) unmarshalFileWriterDirective(work *cookieWork, d *caddyfile.Dispenser) error {
+	switch d.Val() {
+	case "roll_disabled":
+		var disabled bool
+		work.roll = &disabled
+		if d.NextArg() {
+			return d.ArgErr()
+		}
+	case "roll_size":
+		var sizeStr string
+		if !d.AllArgs(&sizeStr) {
+			return d.ArgErr()
+		}
+		size, err := humanize.ParseBytes(sizeStr)
+		if err != nil {
+			return d.Errf("parsing size: %v", err)
+		}
+		work.rollSizeMB = int(math.Ceil(float64(size) / humanize.MiByte))
+	case "roll_uncompressed":
+		var uncompressed bool
+		work.rollCompress = &uncompressed
+		if d.NextArg() {
+			return d.ArgErr()
+		}
+	case "roll_local_time":
+		work.rollLocalTime = true
+		if d.NextArg() {
+			return d.ArgErr()
+		}
+	case "roll_keep":
+		var keepStr string
+		if !d.AllArgs(&keepStr) {
+			return d.ArgErr()
+		}
+		keep, err := strconv.Atoi(keepStr)
+		if err != nil {
+			return d.Errf("parsing roll_keep number: %v", err)
+		}
+		work.rollKeep = keep
+	case "roll_keep_for":
+		var keepForStr string
+		if !d.AllArgs(&keepForStr) {
+			return d.ArgErr()
+		}
+		keepFor, err := caddy.ParseDuration(keepForStr)
+		if err != nil {
+			return d.Errf("parsing roll_keep_for duration: %v", err)
+		}
+		if keepFor < 0 {
+			return d.Errf("negative roll_keep_for duration: %v", keepFor)
+		}
+		work.rollKeepDays = int(math.Ceil(keepFor.Hours() / 24))
+	default:
+		return d.Errf("unrecognized subdirective %s", d.Val())
+	}
+	return nil
+}
