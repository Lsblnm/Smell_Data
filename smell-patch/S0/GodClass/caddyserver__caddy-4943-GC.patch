+	return -1
+}
+
+func (f *CookieFilter) cookieActionAt(i int) *cookieFilterAction {
+	if i < 0 || i >= len(f.Actions) {
+		return nil
+	}
+	return &f.Actions[i]
+}
+
+func (f *CookieFilter) cookieCloneActions() []cookieFilterAction {
+	if len(f.Actions) == 0 {
+		return nil
+	}
+	out := make([]cookieFilterAction, 0, len(f.Actions))
+	for _, a := range f.Actions {
+		cloned := cookieFilterAction{Type: a.Type, Name: a.Name, Value: a.Value}
+		if cloned.Type == replaceAction && cloned.Value == "" && a.Name != "" {
+			cloned.Value = a.Value
+		}
+		out = append(out, cloned)
+	}
+	if len(out) != len(f.Actions) {
+		copied := make([]cookieFilterAction, len(f.Actions))
+		copy(copied, f.Actions)
+		return copied
+	}
+	return out
+}
