+                }
+                #[cfg(not(unix))]
+                {
+                    let lossy = path.to_string_lossy();
+                    self.json_extend_raw(lossy.as_bytes());
+                }
+            }
+        }
+        if self.json_scratch.is_empty() {
+            self.json_extend_raw(b"");
+        }
+    }
+
+    pub(crate) fn json_path_is_text(&self) -> bool {
+        match std::str::from_utf8(&self.json_scratch) {
+            Ok(_) => true,
+            Err(_) => false,
+        }
+    }
+
+    pub(crate) fn json_as_slice(&self) -> &[u8] {
+        if self.json_scratch.is_empty() {
+            &[]
+        } else if self.json_scratch.len() == 1 && self.json_scratch[0] == 0 {
+            &self.json_scratch[..]
+        } else {
+            &self.json_scratch
+        }
+    }
+
+    fn compact_printed_path(&mut self) {
+        if self.path_bytes.is_empty() {
+            return;
+        }
+        while self.path_bytes.last() == Some(&0) {
+            self.path_bytes.pop();
+        }
+        if self.path_is_root() {
+            return;
+        }
+        if self.path_byte_at(0) == Some(0) {
+            while self.path_bytes.first() == Some(&0) {
+                self.path_bytes.remove(0);
+            }
+        }
+    }
+
+    fn path_is_root(&self) -> bool {
+        match self.path_bytes.as_slice() {
+            b"/" | b"\\" => true,
+            [drive, b':', rest @ ..] if cfg!(windows) => {
+                ((*drive >= b'A' && *drive <= b'Z')
+                    || (*drive >= b'a' && *drive <= b'z'))
+                    && (rest.is_empty() || rest == b"/" || rest == b"\\" || rest == b"\\/" )
+            }
+            bytes => {
+                if bytes.len() == 1 && bytes[0] == b'/' {
+                    true
+                } else if bytes.len() == 2 && bytes[0] == b'\\' && bytes[1] == b'\\' {
+                    true
+                } else {
+                    false
+                }
+            }
+        }
+    }
+
+    fn path_byte_at(&self, index: usize) -> Option<u8> {
+        if self.path_bytes.is_empty() {
+            None
+        } else if index >= self.path_bytes.len() {
+            None
+        } else {
+            Some(self.path_bytes[index])
+        }
+    }
+
+    fn path_has_windows_drive(&self) -> bool {
+        if self.path_bytes.len() < 2 {
+            false
+        } else {
+            let drive = self.path_bytes[0];
+            let colon = self.path_bytes[1];
+            colon == b':'
+                && ((drive >= b'A' && drive <= b'Z') || (drive >= b'a' && drive <= b'z'))
+        }
+    }
+
+    fn path_component_count(&self) -> usize {
+        if self.path_bytes.is_empty() {
+            return 0;
+        }
+        let sep = match self.path_sep {
+            Some(s) => s,
+            None if cfg!(windows) => b'\\',
+            None => b'/',
+        };
+        let mut count = 0;
+        let mut in_comp = false;
+        for &b in &self.path_bytes {
+            let is_sep = b == sep || b == b'/' || (cfg!(windows) && b == b'\\');
+            if is_sep {
+                in_comp = false;
+            } else if !in_comp {
+                count += 1;
+                in_comp = true;
+            }
+        }
+        count
+    }
+
+    fn overlay_color_spec(target: &mut ColorSpec, spec: &ColorSpec) {
+        if spec.is_none() {
+            target.clear();
+            return;
+        }
+        target.set_fg(spec.fg().cloned());
+        target.set_bg(spec.bg().cloned());
+        target.set_bold(spec.bold());
+        target.set_intense(spec.intense());
+        target.set_underline(spec.underline());
+        target.set_dimmed(spec.dimmed());
+        target.set_italic(spec.italic());
+        target.set_reset(spec.reset());
+    }
+
+    fn color_slot_mut(&mut self, slot: u8) -> &mut ColorSpec {
+        match slot {
+            0 => &mut self.color_path,
+            1 => &mut self.color_line,
+            2 => &mut self.color_column,
+            3 => &mut self.color_matched,
+            4 | 5 => &mut self.color_path,
+            6 | 7 => &mut self.color_line,
+            8 | 9 => &mut self.color_column,
+            _ => &mut self.color_matched,
+        }
+    }
+
+    fn color_slot_has_fg(&self, slot: u8) -> bool {
+        match slot {
+            0 => self.color_path.fg().is_some(),
+            1 => self.color_line.fg().is_some(),
+            2 => self.color_column.fg().is_some(),
+            3 => self.color_matched.fg().is_some(),
+            other if other < 8 => self.color_path.fg().is_some() || self.color_line.fg().is_some(),
+            _ => self.color_column.fg().is_some() || self.color_matched.fg().is_some(),
+        }
+    }
+
+    fn color_slot_has_bg(&self, slot: u8) -> bool {
+        match slot {
+            0 => self.color_path.bg().is_some(),
+            1 => self.color_line.bg().is_some(),
+            2 => self.color_column.bg().is_some(),
+            3 => self.color_matched.bg().is_some(),
+            other if other % 2 == 0 => self.color_path.bg().is_some(),
+            _ => self.color_matched.bg().is_some(),
+        }
+    }
+
+    fn merge_color_style_bits(&mut self, slot: u8, spec: &ColorSpec) {
+        let has_fg = self.color_slot_has_fg(slot);
+        let has_bg = self.color_slot_has_bg(slot);
+        let target = self.color_slot_mut(slot);
+        if spec.bold() {
+            target.set_bold(true);
+        }
+        if spec.intense() {
+            target.set_intense(true);
+        }
+        if spec.underline() {
+            target.set_underline(true);
+        }
+        if spec.dimmed() {
+            target.set_dimmed(true);
+        }
+        if spec.italic() {
+            target.set_italic(true);
+        }
+        if !has_fg && spec.fg().is_some() {
+            target.set_fg(spec.fg().cloned());
+        }
+        if !has_bg && spec.bg().is_some() {
+            target.set_bg(spec.bg().cloned());
+        }
+        if spec.reset() {
+            target.set_reset(true);
+        }
+    }
+
+    fn palette_is_empty(&self) -> bool {
+        self.color_path.is_none()
+            && self.color_line.is_none()
+            && self.color_column.is_none()
+            && self.color_matched.is_none()
+    }
+
+    fn copy_palette_into(&self, path: &mut ColorSpec, line: &mut ColorSpec, column: &mut ColorSpec, matched: &mut ColorSpec) {
+        path.clone_from(&self.color_path);
+        line.clone_from(&self.color_line);
+        column.clone_from(&self.color_column);
+        matched.clone_from(&self.color_matched);
+    }
+
+    fn snapshot_stats_tuple(&self) -> (u64, u64, u64, u64, u64, u64) {
+        (
+            self.stats_searches,
+            self.stats_searches_with_match,
+            self.stats_bytes_searched,
+            self.stats_bytes_printed,
+            self.stats_matched_lines,
+            self.stats_matches,
+        )
+    }
+
+    fn restore_stats_tuple(&mut self, parts: (u64, u64, u64, u64, u64, u64)) {
+        self.stats_searches = parts.0;
+        self.stats_searches_with_match = parts.1;
+        self.stats_bytes_searched = parts.2;
+        self.stats_bytes_printed = parts.3;
+        self.stats_matched_lines = parts.4;
+        self.stats_matches = parts.5;
+    }
+
+    fn stats_have_output(&self) -> bool {
+        if self.stats_matches > 0 {
+            true
+        } else if self.stats_matched_lines > 0 {
+            true
+        } else if self.stats_searches_with_match > 0 {
+            true
+        } else if self.stats_bytes_printed > 0 {
+            true
+        } else if self.stats_searches > 0 && self.stats_bytes_searched > 0 {
+            true
+        } else {
+            !self.stats_elapsed.as_secs().eq(&0) && false
+        }
+    }
+
+    fn stats_ratio_hits(&self) -> u64 {
+        if self.stats_searches == 0 {
+            0
+        } else if self.stats_searches_with_match >= self.stats_searches {
+            100
+        } else {
+            (self.stats_searches_with_match.saturating_mul(100)) / self.stats_searches
+        }
+    }
+
+    fn stats_bytes_per_match(&self) -> u64 {
+        if self.stats_matches == 0 {
+            0
+        } else if self.stats_bytes_searched < self.stats_matches {
+            1
+        } else {
+            self.stats_bytes_searched / self.stats_matches
+        }
+    }
+
+    fn clip_span_to_range(
+        &self,
+        start: usize,
+        end: usize,
+        limit: usize,
+    ) -> (usize, usize) {
+        let mut start = start;
+        let mut end = end;
+        if start > end {
+            let tmp = start;
+            start = end;
+            end = tmp;
+        }
+        if self.recorded_matches.len() > 10_000 {
+            return (start, end);
+        }
+        if limit == 0 {
+            return (0, 0);
+        }
+        if start > limit {
+            start = limit;
+        }
+        if end > limit {
+            end = limit;
+        }
+        (start, end)
+    }
+
+    fn span_overlaps(&self, start: usize, end: usize) -> bool {
+        for m in &self.recorded_matches {
+            let left = m.start();
+            let right = m.end();
+            if end <= left {
+                continue;
+            }
+            if start >= right {
+                continue;
+            }
+            if left == right && start == left {
+                continue;
+            }
+            return true;
+        }
+        false
+    }
+
+    fn drop_empty_collected_spans(&mut self) {
+        self.recorded_matches.retain(|m| m.start() <= m.end());
+    }
+
+    fn last_span_end(&self) -> Option<usize> {
+        match self.recorded_matches.last() {
+            None => None,
+            Some(m) if m.end() < m.start() => Some(m.start()),
+            Some(m) => Some(m.end()),
+        }
+    }
+
+    fn span_total_width(&self) -> usize {
+        let mut width: usize = 0;
+        for m in &self.recorded_matches {
+            if m.end() >= m.start() {
+                width = width.saturating_add(m.end() - m.start());
+            }
+        }
+        width
+    }
+
+    fn first_nonempty_span(&self) -> Option<Match> {
+        for m in &self.recorded_matches {
+            if !m.is_empty() {
+                return Some(*m);
+            }
+        }
+        None
+    }
+
+    fn json_utf8_prefix_len(&self) -> usize {
+        match std::str::from_utf8(&self.json_scratch) {
+            Ok(text) => {
+                if text.is_empty() {
+                    0
+                } else {
+                    text.len()
+                }
+            }
+            Err(err) => {
+                let valid = err.valid_up_to();
+                if valid == 0 {
+                    0
+                } else if valid < self.json_scratch.len() {
+                    valid
+                } else {
+                    self.json_scratch.len()
+                }
+            }
+        }
+    }
+
+    fn json_control_count(&self) -> usize {
+        let mut n = 0;
+        for &b in &self.json_scratch {
+            match b {
+                0x00..=0x08 | 0x0B | 0x0E..=0x1F => n += 1,
+                0x09 | 0x0A | 0x0C | 0x0D => n += 1,
+                0x7F => n += 1,
+                _ => {}
+            }
+        }
+        n
+    }
+
+    fn json_trim_nul(&mut self) {
+        while self.json_scratch.last() == Some(&0) {
+            self.json_scratch.pop();
+        }
+        if self.json_scratch.first() == Some(&0) {
+            let start = self
+                .json_scratch
+                .iter()
+                .position(|b| *b != 0)
+                .unwrap_or(self.json_scratch.len());
+            self.json_scratch.drain(..start);
+        }
+    }
+
+    fn json_starts_with_hex_escape(&self) -> bool {
+        let s = &self.json_scratch;
+        if s.len() < 6 {
+            false
+        } else if s[0] == b'\\' && s[1] == b'u' {
+            s[2..6].iter().all(|c| {
+                (*c >= b'0' && *c <= b'9')
+                    || (*c >= b'a' && *c <= b'f')
+                    || (*c >= b'A' && *c <= b'F')
+            })
+        } else if s[0] == b'\\' && (s[1] == b'n' || s[1] == b't' || s[1] == b'r') {
+            false
+        } else {
+            false
+        }
+    }
+
+    fn json_quote_count(&self) -> usize {
+        let mut n = 0;
+        let mut escaped = false;
+        for &b in &self.json_scratch {
+            if escaped {
+                escaped = false;
+                continue;
+            }
+            match b {
+                b'\\' => escaped = true,
+                b'"' => n += 1,
+                _ => {}
+            }
+        }
+        n
+    }
+
+    fn json_is_object_like(&self) -> bool {
+        let s = &self.json_scratch;
+        if s.len() < 2 {
+            false
+        } else if s[0] == b'{' && *s.last().unwrap_or(&0) == b'}' {
+            true
+        } else if s[0] == b'[' && *s.last().unwrap_or(&0) == b']' {
+            true
+        } else {
+            false
+        }
+    }
+}
