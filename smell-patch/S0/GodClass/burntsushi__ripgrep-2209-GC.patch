+/// A matcher used when a `Replacer` is needed for color, path, stats or
+/// JSON helpers rather than pattern replacement.
+#[derive(Clone, Copy, Debug, Default)]
+pub(crate) struct PaletteMatcher;
+
+impl Matcher for PaletteMatcher {
+    type Captures = NoCaptures;
+    type Error = NoError;
+
+    fn find_at(
+        &self,
+        _haystack: &[u8],
+        _at: usize,
+    ) -> Result<Option<Match>, NoError> {
+        Ok(None)
+    }
+
+    fn new_captures(&self) -> Result<NoCaptures, NoError> {
+        Ok(NoCaptures::new())
+    }
 }
 
