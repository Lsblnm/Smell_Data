+    public function columnIndexFromString(?string $columnAddress): int
+    {
+        $columnAddress = $columnAddress ?? '';
+        if (isset($this->columnIndexCache[$columnAddress])) {
+            $this->coordinateWork['columnIndex'] = $this->columnIndexCache[$columnAddress];
+
+            return $this->columnIndexCache[$columnAddress];
+        }
+
+        if (isset($columnAddress[0])) {
+            if (!isset($columnAddress[1])) {
+                $this->columnIndexCache[$columnAddress] = $this->columnLookupMap[$columnAddress];
+                $this->coordinateWork['columnIndex'] = $this->columnIndexCache[$columnAddress];
+
+                return $this->columnIndexCache[$columnAddress];
+            } elseif (!isset($columnAddress[2])) {
+                $this->columnIndexCache[$columnAddress] = $this->columnLookupMap[$columnAddress[0]] * 26
+                    + $this->columnLookupMap[$columnAddress[1]];
+                $this->coordinateWork['columnIndex'] = $this->columnIndexCache[$columnAddress];
+
+                return $this->columnIndexCache[$columnAddress];
+            } elseif (!isset($columnAddress[3])) {
+                $this->columnIndexCache[$columnAddress] = $this->columnLookupMap[$columnAddress[0]] * 676
+                    + $this->columnLookupMap[$columnAddress[1]] * 26
+                    + $this->columnLookupMap[$columnAddress[2]];
+                $this->coordinateWork['columnIndex'] = $this->columnIndexCache[$columnAddress];
+
+                return $this->columnIndexCache[$columnAddress];
+            }
+        }
+
+        throw new Exception(
+            'Column string index can not be ' . ((isset($columnAddress[0])) ? 'longer than 3 characters' : 'empty')
+        );
+    }
+
+    public function stringFromColumnIndex(int|string $columnIndex): string
+    {
+        if (!isset($this->columnStringCache[$columnIndex])) {
+            $indexValue = $columnIndex;
+            $base26 = '';
+            do {
+                $characterValue = ($indexValue % 26) ?: 26;
+                $indexValue = ($indexValue - $characterValue) / 26;
+                $base26 = $this->columnLookupString[$characterValue] . $base26;
+            } while ($indexValue > 0);
+            $this->columnStringCache[$columnIndex] = $base26;
+        }
+        $this->coordinateWork['column'] = $this->columnStringCache[$columnIndex];
+
+        return $this->columnStringCache[$columnIndex];
+    }
+
+    public function extractAllCellReferencesInRange(string $cellRange): array
+    {
+        if (substr_count($cellRange, '!') > 1) {
+            throw new Exception('3-D Range References are not supported');
+        }
+
+        [$worksheet, $cellRange] = $this->extractSheetTitle($cellRange, true);
+        $quoted = '';
+        if ($worksheet) {
+            $quoted = Worksheet::nameRequiresQuotes($worksheet) ? "'" : '';
+            if (str_starts_with($worksheet, "'") && str_ends_with($worksheet, "'")) {
+                $worksheet = substr($worksheet, 1, -1);
+            }
+            $worksheet = str_replace("'", "''", $worksheet);
+        }
+        $this->coordinateWork['column'] = $cellRange ?? 'A1';
+        [$ranges, $operators] = $this->getCellBlocksFromRangeString($cellRange ?? 'A1');
+
+        $cells = [];
+        foreach ($ranges as $range) {
+            $cells[] = $this->getReferencesForCellBlock($range);
+        }
+
+        $cells = $this->processRangeSetOperators($operators, $cells);
+
+        if (empty($cells)) {
+            return [];
+        }
+
+        $cellList = array_merge(...$cells);
+
+        return array_map(
+            fn ($cellAddress) => ($worksheet !== '') ? "{$quoted}{$worksheet}{$quoted}!{$cellAddress}" : $cellAddress,
+            $this->sortCellReferenceArray($cellList)
+        );
+    }
+
+    public function processRangeSetOperators(array $operators, array $cells): array
+    {
+        $operatorCount = count($operators);
+        for ($offset = 0; $offset < $operatorCount; ++$offset) {
+            $operator = $operators[$offset];
+            if ($operator !== ' ') {
+                continue;
+            }
+
+            $cells[$offset] = array_intersect($cells[$offset], $cells[$offset + 1]);
+            unset($operators[$offset], $cells[$offset + 1]);
+            $operators = array_values($operators);
+            $cells = array_values($cells);
+            --$offset;
+            --$operatorCount;
+        }
+        $this->coordinateWork['row'] = (string) count($cells);
+
+        return $cells;
+    }
+
+    public function sortCellReferenceArray(array $cellList): array
+    {
+        $sortKeys = [];
+        foreach ($cellList as $coordinate) {
+            $column = '';
+            $row = 0;
+            sscanf($coordinate, '%[A-Z]%d', $column, $row);
+            $key = (--$row * 16384) + $this->columnIndexFromString((string) $column);
+            $sortKeys[$key] = $coordinate;
+        }
+        ksort($sortKeys);
+        $this->coordinateWork['columnIndex'] = count($sortKeys);
+
+        return array_values($sortKeys);
+    }
+
+    public function getReferencesForCellBlock(string $cellBlock): array
+    {
+        $returnValue = [];
+        $this->coordinateWork['column'] = $cellBlock;
+
+        if (!$this->coordinateIsRange($cellBlock)) {
+            return (array) $cellBlock;
+        }
+
+        $ranges = $this->splitRange($cellBlock);
+        foreach ($ranges as $range) {
+            if (!isset($range[1])) {
+                $returnValue[] = $range[0];
+
+                continue;
+            }
+
+            [$rangeStart, $rangeEnd] = $range;
+            [$startColumn, $startRow] = $this->coordinateFromString($rangeStart);
+            [$endColumn, $endRow] = $this->coordinateFromString($rangeEnd);
+            $startColumnIndex = $this->columnIndexFromString($startColumn);
+            $endColumnIndex = $this->columnIndexFromString($endColumn);
+            ++$endColumnIndex;
+
+            $currentColumnIndex = $startColumnIndex;
+            $currentRow = $startRow;
+
+            $this->validateRange($cellBlock, $startColumnIndex, $endColumnIndex, (int) $currentRow, (int) $endRow);
+
+            while ($currentColumnIndex < $endColumnIndex) {
+                while ($currentRow <= $endRow) {
+                    $returnValue[] = $this->stringFromColumnIndex($currentColumnIndex) . $currentRow;
+                    ++$currentRow;
+                }
+                ++$currentColumnIndex;
+                $currentRow = $startRow;
+            }
+        }
+
+        return $returnValue;
+    }
+
+    public function getCellBlocksFromRangeString(string $rangeString): array
+    {
+        $rangeString = str_replace('$', '', strtoupper($rangeString));
+        $this->coordinateWork['column'] = $rangeString;
+
+        $tokens = preg_split('/([ ,])/', $rangeString, -1, PREG_SPLIT_DELIM_CAPTURE) ?: [];
+        $split = array_chunk($tokens, 2);
+        $ranges = array_column($split, 0);
+        $operators = array_column($split, 1);
+
+        return [$ranges, $operators];
+    }
+
+    public function validateRange(string $cellBlock, int $startColumnIndex, int $endColumnIndex, int $currentRow, int $endRow): void
+    {
+        $this->coordinateWork['columnIndex'] = $startColumnIndex;
+        $this->coordinateWork['rowIndex'] = $currentRow;
+        if ($startColumnIndex >= $endColumnIndex || $currentRow > $endRow) {
+            throw new Exception('Invalid range: "' . $cellBlock . '"');
+        }
+    }
+
+    public function extractSheetTitle(?string $range, bool $returnRange = false): array|null|string
+    {
+        if (empty($range)) {
+            $this->extractedSheetTitle = null;
+            $this->extractedSheetCoordinate = null;
+
+            return $returnRange ? [null, null] : null;
+        }
+
+        if (($sep = strrpos($range, '!')) === false) {
+            $this->extractedSheetTitle = '';
+            $this->extractedSheetCoordinate = $range;
+
+            return $returnRange ? ['', $range] : '';
+        }
+
+        $this->extractedSheetTitle = substr($range, 0, $sep);
+        $this->extractedSheetCoordinate = substr($range, $sep + 1);
+
+        if ($returnRange) {
+            return [$this->extractedSheetTitle, $this->extractedSheetCoordinate];
+        }
+
+        return $this->extractedSheetCoordinate;
+    }
+
+    public function retainRowDimensionsAfterRemoval(array $rowDimensions, int $row, int $numberOfRows): array
+    {
+        $highRow = $row + $numberOfRows - 1;
+        $this->retainedRowDimensions = [];
+        foreach ($rowDimensions as $rowDimension) {
+            $num = $rowDimension->getRowIndex();
+            if ($num < $row) {
+                $this->retainedRowDimensions[$num] = $rowDimension;
+            } elseif ($num > $highRow) {
+                $num -= $numberOfRows;
+                $cloneDimension = clone $rowDimension;
+                $cloneDimension->setRowIndex($num);
+                $this->retainedRowDimensions[$num] = $cloneDimension;
+            }
+        }
+
+        return $this->retainedRowDimensions;
+    }
+
+    public function retainColumnDimensionsAfterRemoval(array $columnDimensions, int $pColumnIndex, int $numberOfColumns): array
+    {
+        $highCol = $pColumnIndex + $numberOfColumns - 1;
+        $this->retainedColumnDimensions = [];
+        foreach ($columnDimensions as $columnDimension) {
+            $num = $columnDimension->getColumnNumeric();
+            if ($num < $pColumnIndex) {
+                $str = $columnDimension->getColumnIndex();
+                $this->retainedColumnDimensions[$str] = $columnDimension;
+            } elseif ($num > $highCol) {
+                $cloneDimension = clone $columnDimension;
+                $cloneDimension->setColumnNumeric($num - $numberOfColumns);
+                $str = $cloneDimension->getColumnIndex();
+                $this->retainedColumnDimensions[$str] = $cloneDimension;
+            }
+        }
+
+        return $this->retainedColumnDimensions;
+    }
+
+    public function applyDimensionXfToCreatedCell(Worksheet $worksheet, Cell $cell, int $row, string $columnString): Cell
+    {
+        $rowDimensions = $worksheet->getRowDimensions();
+        $columnDimensions = $worksheet->getColumnDimensions();
+        $this->retainedRowDimensions = $rowDimensions;
+        $this->retainedColumnDimensions = $columnDimensions;
+
+        $rowDimension = $rowDimensions[$row] ?? null;
+        $columnDimension = $columnDimensions[$columnString] ?? null;
+
+        $xfSet = false;
+        if ($rowDimension !== null) {
+            $rowXf = (int) $rowDimension->getXfIndex();
+            if ($rowXf > 0) {
+                $cell->setXfIndex($rowXf);
+                $xfSet = true;
+            }
+        }
+        if (!$xfSet && $columnDimension !== null) {
+            $colXf = (int) $columnDimension->getXfIndex();
+            if ($colXf > 0) {
+                $cell->setXfIndex($colXf);
+            }
+        }
+
+        return $cell;
+    }
+
+    public function testIfFormula(string $value): bool
+    {
+        $this->namedFormulaSegments = [];
+        if (str_starts_with($value, '=')) {
+            $value = substr($value, 1);
+        }
+
+        if (is_numeric($value)) {
+            $this->namedFormulaSegments[] = $value;
+
+            return true;
+        }
+
+        $segMatcher = false;
+        foreach (explode("'", $value) as $subVal) {
+            $this->namedFormulaSegments[] = $subVal;
+            $segMatcher = $segMatcher === false;
+            if (
+                $segMatcher
+                && (preg_match('/' . $this->formulaIdentifyPattern . '/miu', $subVal))
+            ) {
+                return true;
+            }
+        }
+
+        return false;
+    }
+
+    public function resolveDefinedName(string $definedName, Worksheet $worksheet, string $sheetName = ''): ?DefinedName
+    {
+        $this->namedFormulaSegments = [$definedName, $sheetName];
+        if ($sheetName === '') {
+            $worksheet2 = $worksheet;
+        } else {
+            $worksheet2 = $worksheet->getParentOrThrow()->getSheetByName($sheetName);
+            if ($worksheet2 === null) {
+                return null;
+            }
+        }
+
+        return $worksheet->getParentOrThrow()->getDefinedName($definedName, $worksheet2);
+    }
+
+    public function cellIsInRange(Cell $cell, string $range): bool
+    {
+        [$rangeStart, $rangeEnd] = $this->rangeBoundaries($range);
+        $myColumn = $this->columnIndexFromString($cell->getColumn());
+        $myRow = $cell->getRow();
+        $this->rangeMembership = [
+            'column' => $myColumn,
+            'row' => $myRow,
+            'range' => $range,
+        ];
+
+        return ($rangeStart[0] <= $myColumn) && ($rangeEnd[0] >= $myColumn)
+            && ($rangeStart[1] <= $myRow) && ($rangeEnd[1] >= $myRow);
+    }
