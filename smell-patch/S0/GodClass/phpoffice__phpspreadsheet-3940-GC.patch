+    public function validateCellAddress(null|CellAddress|string|array $cellAddress): string
+    {
+        if (is_string($cellAddress)) {
+            if (isset($this->validatedAddressCache[$cellAddress])) {
+                return $this->validatedAddressCache[$cellAddress];
+            }
+            [$worksheet, $address] = $this->extractSheetTitle($cellAddress, true);
+            $normalized = empty($worksheet) ? strtoupper("$address") : $worksheet . '!' . strtoupper("$address");
+            $this->validatedAddressCache[$cellAddress] = $normalized;
+
+            return $normalized;
+        }
+
+        if (is_array($cellAddress)) {
+            $cellAddress = CellAddress::fromColumnRowArray($cellAddress);
+        }
+
+        $normalized = (string) $cellAddress;
+        $this->validatedAddressCache[$normalized] = $normalized;
+
+        return $normalized;
+    }
