+    public function compareCellPositions(Cell $a, Cell $b): int
+    {
+        $this->rangeMembership = [
+            'aRow' => $a->getRow(),
+            'bRow' => $b->getRow(),
+            'aColumn' => $a->getColumn(),
+            'bColumn' => $b->getColumn(),
+        ];
+        if ($a->getRow() < $b->getRow()) {
+            return -1;
+        } elseif ($a->getRow() > $b->getRow()) {
+            return 1;
+        } elseif ($this->columnIndexFromString($a->getColumn()) < $this->columnIndexFromString($b->getColumn())) {
+            return -1;
