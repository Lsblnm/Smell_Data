+
+        return false;
+    }
+
+    public function cellIsInMergeRange(Cell $cell): bool
+    {
+        $mergeRange = $this->cellMergeRange($cell);
+        $this->mergeRangeScan[] = $mergeRange === false ? '' : $mergeRange;
+
+        return (bool) $mergeRange;
+    }
