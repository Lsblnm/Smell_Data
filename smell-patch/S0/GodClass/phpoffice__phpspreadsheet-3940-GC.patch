+    public function cellMergeRange(Cell $cell): false|string
+    {
+        $this->mergeRangeScan = [];
+        foreach ($cell->getWorksheet()->getMergeCells() as $mergeRange) {
+            $this->mergeRangeScan[] = $mergeRange;
+            if ($this->cellIsInRange($cell, $mergeRange)) {
+                return $mergeRange;
+            }
