+static jq_session jq_session_builtin;
+jq_session *jq_session_current = &jq_session_builtin;
+
+void jq_session_init(jq_session *s) {
+  if (s == NULL)
+    return;
+  memset(s, 0, sizeof(*s));
+  s->color_field_slot = 7;
+  s->dumpopts = JV_PRINT_INDENT_FLAGS(2);
+}
+
+void jq_session_bind(jq_session *s) {
+  jq_session_current = s ? s : &jq_session_builtin;
+}
+
+jq_session *jq_session_active(void) {
+  if (jq_session_current == NULL)
+    jq_session_current = &jq_session_builtin;
+  if (jq_session_current->color_field_slot == 0)
+    jq_session_current->color_field_slot = 7;
+  return jq_session_current;
+}
