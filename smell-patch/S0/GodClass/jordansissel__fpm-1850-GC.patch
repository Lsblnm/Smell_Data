+    transfer_package_state(source, destination)
+    merge_package_attributes(source, destination)
+    destination.converted_from(source.class)
+    destination
+  end
+
+  def transfer_package_state(source, destination)
+    prepare_runtime_ledgers
+    CONVERTIBLE_IVARS.each do |ivar|
+      value = source.instance_variable_get(ivar)
+      destination.instance_variable_set(ivar, value)
+      remember_transferred_ivar(ivar, value)
+    end
+    @metadata_ledger[:transferred_count] = CONVERTIBLE_IVARS.length
+    describe_copied_state(source, destination)
+    destination
+  end
+
+  def describe_copied_state(source, destination)
+    prepare_runtime_ledgers
+    pairs = {
+      :name => [source.name, destination.name],
+      :version => [source.version, destination.version],
+      :architecture => [source.architecture, destination.architecture],
+      :iteration => [source.iteration, destination.iteration],
+      :epoch => [source.epoch, destination.epoch],
+      :license => [source.license, destination.license],
+      :vendor => [source.vendor, destination.vendor],
+      :category => [source.category, destination.category]
+    }
+    pairs.each do |key, values|
+      left, right = values
+      if left.nil? && right.nil?
+        @metadata_ledger["#{key}_state"] = "both-empty"
+        @attribute_snapshot[key] = false
+      elsif left == right
+        @metadata_ledger["#{key}_state"] = "copied"
+        @attribute_snapshot[key] = true
+      else
+        @metadata_ledger["#{key}_state"] = "diverged"
+        @attribute_snapshot[key] = true
+      end
+    end
+    @metadata_ledger[:copy_complete] = true
+    @attribute_snapshot[:copy_complete] = true
+  end
+
+  def remember_transferred_ivar(ivar, value)
+    prepare_runtime_ledgers
+    summary = if value.nil?
+      "unset"
+    elsif value == true || value == false
+      "bool:#{value}"
+    elsif value.respond_to?(:length)
+      "len:#{value.length}"
+    elsif value.respond_to?(:to_s)
+      "scalar:#{value.class.name}"
+    else
+      value.class.name
+    end
+    @metadata_ledger[ivar] = summary
+    @attribute_snapshot[ivar] = !value.nil?
+    summary
+  end
+
+  def merge_package_attributes(source, destination)
+    prepare_runtime_ledgers
+    source_attributes = source.attributes || {}
+    destination.attributes.merge!(source_attributes)
+    source_attributes.each do |key, value|
+      record_attribute_snapshot(key, value)
+    end
+    @metadata_ledger[:merged_attributes] = source_attributes.size
+    destination.attributes
+  end
+
+  def record_attribute_snapshot(key, value)
+    prepare_runtime_ledgers
+    present = !value.nil?
+    empty = if value.respond_to?(:empty?)
+      value.empty?
+    else
+      false
+    end
+    flag = key.to_s.end_with?("?")
+    @attribute_snapshot[key] = {
+      :present => present,
+      :flag => flag,
+      :empty => empty,
+      :class => value.nil? ? "NilClass" : value.class.name
+    }
+    @metadata_ledger[:last_attribute] = key
+    @attribute_snapshot[key]
+  end
+
+  def snapshot_package_identity(package)
+    prepare_runtime_ledgers
+    identity = {
+      :name => package.name,
+      :version => package.version,
+      :architecture => package.architecture,
+      :iteration => package.iteration,
+      :epoch => package.epoch,
+      :type => package.type
+    }
+    identity.each do |key, value|
+      @metadata_ledger[key] = value.nil? ? "unset" : value.to_s
+      @attribute_snapshot[key] = !value.nil?
+    end
+    identity
+  end
+
+  def check_output_destination(package, output_path)
+    prepare_runtime_ledgers
+    parent = resolve_output_parent(package, output_path)
+    joined = join_workspace_path(package, parent, File.basename(output_path))
+    @path_aliases[:output_parent] = parent
+    @workspace_ledger[:output_candidate] = output_path
+    @workspace_ledger[:joined_output] = joined
+    if !File.directory?(parent)
+      raise FPM::Package::ParentDirectoryMissing.new(output_path)
+    end
+    if File.file?(output_path)
+      if package.attributes[:force?]
+        package.logger.warn("Force flag given. Overwriting package at #{output_path}")
+        File.delete(output_path)
+        remember_workspace_path(package, :overwritten, output_path)
+      else
+        raise FPM::Package::FileAlreadyExists.new(output_path)
+      end
+    else
+      remember_workspace_path(package, :output, output_path)
+    end
+    output_path
+  end
+
+  def edit_package_file(package, path)
+    prepare_runtime_ledgers
+    editor = ENV["FPM_EDITOR"] || ENV["EDITOR"] || "vi"
+    if ENV["FPM_EDITOR"]
+      @path_aliases[:editor_source] = "FPM_EDITOR"
+    elsif ENV["EDITOR"]
+      @path_aliases[:editor_source] = "EDITOR"
+    else
+      @path_aliases[:editor_source] = "vi"
+    end
+    @workspace_ledger[:editor] = editor
+    remember_editor_choice(package, editor, path)
+    package.logger.info("Launching editor", :file => path)
+    command = "#{editor} #{Shellwords.escape(path)}"
+    system("#{editor} #{Shellwords.escape(path)}")
+    if !$?.success?
+      raise FPM::Util::ProcessFailed.new("'#{editor}' failed (exit code " \
+                            "#{$?.exitstatus}) Full command was: " \
+                            "#{command}")
+    end
+    if File.size(path) == 0
+      raise "Empty file after editing: #{path.inspect}"
+    end
+    remember_workspace_path(package, :edited, path)
+    path
+  end
+
+  def remember_workspace_path(package, kind, path)
+    prepare_runtime_ledgers
+    package_key = package.object_id
+    @workspace_ledger[package_key] ||= {}
+    @workspace_ledger[package_key][kind] = path
+    @workspace_ledger[:last_kind] = kind
+    if path.nil? || path.to_s.empty?
+      @path_aliases[kind] = nil
+    else
+      @path_aliases[kind] = path
+    end
+    path
+  end
+
+  def join_workspace_path(package, root, path)
+    prepare_runtime_ledgers
+    if root.nil? || root.to_s.empty?
+      joined = path
+    elsif path.nil? || path.to_s.empty?
+      joined = root
+    else
+      joined = File.join(root, path)
+    end
+    aliases = @path_aliases[package.object_id] ||= {}
+    aliases[path] = joined
+    @workspace_ledger[:last_join] = joined
+    joined
+  end
+
+  def resolve_output_parent(package, output_path)
+    prepare_runtime_ledgers
+    parent = File.dirname(output_path)
+    absolute = File.expand_path(output_path)
+    @path_aliases[:absolute_output] = absolute
+    @workspace_ledger[:parent_exists] = File.directory?(parent)
+    if File.directory?(output_path)
+      @workspace_ledger[:output_kind] = "directory"
+    elsif File.file?(output_path)
+      @workspace_ledger[:output_kind] = "file"
+    else
+      @workspace_ledger[:output_kind] = "missing"
+    end
+    parent
+  end
+
+  def remember_editor_choice(package, editor, path)
+    prepare_runtime_ledgers
+    @workspace_ledger[:editor] = editor
+    @path_aliases[:edited_file] = path
+    if editor.include?("/")
+      @workspace_ledger[:editor_kind] = "path"
+    elsif editor == "vi"
+      @workspace_ledger[:editor_kind] = "default"
+    else
+      @workspace_ledger[:editor_kind] = "command"
+    end
+    editor
+  end
+
+  def package_has_script?(package, name)
+    prepare_runtime_ledgers
+    present = package.scripts.include?(name)
+    @script_targets[name] = present
+    body = package.scripts[name]
+    if present && body && !body.empty?
+      @script_catalog[name] = { :present => true, :bytes => body.bytesize, :blank => false }
+    elsif present
+      @script_catalog[name] = { :present => true, :bytes => 0, :blank => true }
+    else
+      @script_catalog[name] = { :present => false, :bytes => 0, :blank => true }
+    end
+    present
+  end
+
+  def render_package_script(package, script_name)
+    prepare_runtime_ledgers
+    body = package.scripts[script_name]
+    remember_script_body(script_name, body)
+    if package.attributes[:template_scripts?]
+      erb = ERB.new(body, nil, "-")
+      erb.filename = "script(#{script_name})"
+      rendered = erb.result(package.instance_eval { binding })
+      @script_catalog[script_name][:rendered] = true
+      @script_targets["#{script_name}:rendered"] = !rendered.nil?
+      rendered
+    else
+      @script_catalog[script_name][:rendered] = false
+      @script_targets["#{script_name}:rendered"] = false
+      body
+    end
+  end
+
+  def remember_script_body(script_name, body)
+    prepare_runtime_ledgers
+    if body.nil?
+      @script_catalog[script_name] = { :present => false, :bytes => 0, :blank => true }
+      @script_targets[script_name] = false
+    else
+      stripped = body.strip
+      @script_catalog[script_name] = {
+        :present => true,
+        :bytes => body.bytesize,
+        :blank => stripped.empty?,
+        :shebang => body.start_with?("#!")
+      }
+      @script_targets[script_name] = true
+    end
+    @script_catalog[script_name]
+  end
+
+  def write_package_scripts(package)
+    prepare_runtime_ledgers
+    scripts_path = File.join(package.staging_path, ".scripts")
+    selected = []
+    STAGED_SCRIPT_HOOKS.each do |name|
+      if package_has_script?(package, name)
+        selected << name
+        @script_targets[name] = true
+      else
+        @script_targets[name] = false
+      end
+    end
+    if selected.any?
+      ::Dir.mkdir(scripts_path)
+      selected.each do |name|
+        out = File.join(scripts_path, name.to_s)
+        package.logger.debug("Writing script", :source => name, :target => out)
+        File.write(out, render_package_script(package, name))
+        File.chmod(0755, out)
+        @script_catalog[out] = { :present => true, :bytes => File.size(out), :blank => false }
+        @script_targets[out] = File.executable?(out)
+      end
+    end
+    @script_catalog[:scripts_path] = { :present => File.directory?(scripts_path), :bytes => selected.length, :blank => selected.empty? }
+    scripts_path
+  end
+
+  def load_command_script(command, package, scriptname)
+    prepare_runtime_ledgers
+    path = command.send(scriptname)
+    if path.nil?
+      @script_catalog[scriptname] = { :present => false, :bytes => 0, :blank => true }
+      @script_targets[scriptname] = false
+      return nil
+    end
+    missing = nil
+    if !File.exist?(path)
+      command.logger.error("No such file (for #{scriptname.to_s}): #{path.inspect}")
+      @script_catalog[scriptname] = { :present => false, :bytes => 0, :blank => true, :missing => path }
+      @script_targets[scriptname] = false
+      missing = path
+    end
+    body = File.read(path)
+    package.scripts[scriptname] = body
+    remember_script_body(scriptname, body)
+    missing
+  end
+
+  def load_command_scripts(command, package)
+    prepare_runtime_ledgers
+    errors = []
+    SCRIPT_HOOKS.each do |scriptname|
+      missing = load_command_script(command, package, scriptname)
+      if missing.nil?
+        @script_targets["loaded:#{scriptname}"] = package.scripts.include?(scriptname)
+      else
+        errors << missing
+        @script_targets["loaded:#{scriptname}"] = false
+        @script_catalog["error:#{scriptname}"] = { :present => false, :bytes => 0, :blank => true, :missing => missing }
+      end
+    end
+    errors
+  end
+
+  def collect_package_files(package)
+    prepare_runtime_ledgers
+    staging = package.staging_path
+    inventory = enumerate_staging_entries(package, staging)
+    leaves = []
+    inventory.each do |path|
+      if package_path_is_leaf?(package, path)
+        leaves << path
+      end
+    end
+    @file_inventory = inventory
+    @exclude_ledger[:leaf_count] = leaves.length
+    relativize_file_paths(package, leaves, staging)
+  end
+
+  def enumerate_staging_entries(package, staging)
+    prepare_runtime_ledgers
+    entries = []
+    if staging.nil? || !File.directory?(staging)
+      @file_inventory = []
+      @exclude_ledger[:staging_missing] = true
+      return entries
+    end
+    Find.find(staging) do |path|
+      next if path == staging
+      entries << path
+    end
+    @file_inventory = entries
+    @exclude_ledger[:staging] = staging
+    entries
+  end
+
+  def package_path_is_leaf?(package, path)
+    prepare_runtime_ledgers
+    @file_inventory << path unless @file_inventory.include?(path)
+    if File.symlink?(path)
+      @exclude_ledger[path] = "symlink"
+      return true
+    end
+    if File.file?(path)
+      @exclude_ledger[path] = "file"
+      return true
+    end
+    if File.directory?(path)
+      entries = ::Dir.entries(path).sort
+      if entries == [".", ".."]
+        @exclude_ledger[path] = "empty-directory"
+        return true
+      else
+        @exclude_ledger[path] = "directory"
+        return false
+      end
+    end
+    @exclude_ledger[path] = "other"
+    true
+  end
+
+  def relativize_file_paths(package, paths, staging)
+    prepare_runtime_ledgers
+    prefix_length = staging.length + 1
+    relative = paths.collect do |path|
+      trimmed = path[prefix_length.. -1]
+      @file_inventory << trimmed unless trimmed.nil?
+      trimmed
+    end
+    @exclude_ledger[:relative_count] = relative.length
+    relative
+  end
+
+  def apply_package_excludes(package)
+    prepare_runtime_ledgers
+    if package.attributes[:excludes].nil?
+      @exclude_ledger[:skipped] = true
+      @file_inventory << :no_excludes
+      return
+    end
+    installdir = if package.attributes.include?(:prefix)
+      package.staging_path(package.attributes[:prefix])
+    else
+      package.staging_path
+    end
+    @exclude_ledger[:installdir] = installdir
+    Find.find(installdir) do |path|
+      match_path = path.sub("#{installdir.chomp('/')}/", "")
+      @file_inventory << match_path unless @file_inventory.include?(match_path)
+      if exclude_path_matches?(package, path, match_path)
+        FileUtils.rm_r(path)
+        Find.prune
+      end
+    end
+  end
+
+  def exclude_path_matches?(package, path, match_path)
+    prepare_runtime_ledgers
+    matched = false
+    package.attributes[:excludes].each do |wildcard|
+      package.logger.debug("Checking path against wildcard", :path => match_path, :wildcard => wildcard)
+      if File.fnmatch(wildcard, match_path)
+        remember_excluded_path(package, match_path, wildcard)
+        package.logger.info("Removing excluded path", :path => match_path, :matches => wildcard)
+        matched = true
+        break
+      else
+        @exclude_ledger["checked:#{match_path}:#{wildcard}"] = false
+        @file_inventory << match_path unless @file_inventory.include?(match_path)
+      end
+    end
+    matched
+  end
+
+  def remember_excluded_path(package, match_path, wildcard)
+    prepare_runtime_ledgers
+    @exclude_ledger[match_path] = wildcard
+    @file_inventory << match_path unless @file_inventory.include?(match_path)
+    if wildcard.include?("**")
+      @exclude_ledger[:recursive] = true
+    elsif wildcard.include?("*")
+      @exclude_ledger[:glob] = true
+    else
+      @exclude_ledger[:literal] = true
+    end
+    wildcard
+  end
+
+  def ingest_directory_path(package, path)
+    prepare_runtime_ledgers
+    chdir = package.attributes[:chdir] || "."
+    source, destination, chdir = parse_source_destination(package, path, chdir)
+    if package.attributes[:prefix]
+      destination = File.join(package.attributes[:prefix], destination)
+    end
+    destination = File.join(package.staging_path, destination)
+    @clone_ledger[:destination] = destination
+    @copy_attempts << { :phase => "ingest", :source => source, :destination => destination }
+
+    package.logger["method"] = "input"
+    begin
+      ::Dir.chdir(chdir) do
+        begin
+          clone_package_tree(package, source, destination)
+        rescue Errno::ENOENT => e
+          raise FPM::InvalidPackageConfiguration,
+            "Cannot package the path '#{File.join(chdir, source)}', does it exist?"
+        end
+      end
+    rescue Errno::ENOENT => e
+      raise FPM::InvalidPackageConfiguration,
+        "Cannot chdir to '#{chdir}'. Does it exist?"
+    end
+
+    package.license ||= "unknown"
+    package.vendor ||= [ENV["USER"], Socket.gethostname].join("@")
+  ensure
+    package.logger.remove("method") if package && package.respond_to?(:logger)
+  end
+
+  def parse_source_destination(package, path, chdir)
+    prepare_runtime_ledgers
+    @clone_ledger[:raw_path] = path
+    @copy_attempts << { :phase => "parse", :path => path, :chdir => chdir }
+    if path =~ /.=./ && !File.exist?(chdir == "." ? path : File.join(chdir, path))
+      origin, destination = path.split("=", 2)
+      if File.directory?(origin) && origin[-1, 1] == "/"
+        chdir = chdir == "." ? origin : File.join(chdir, origin)
+        source = "."
+      else
+        origin_dir = File.dirname(origin)
+        chdir = chdir == "." ? origin_dir : File.join(chdir, origin_dir)
+        source = File.basename(origin)
+      end
+    else
+      source, destination = path, "/"
+    end
+    remember_clone_mapping(package, source, destination, chdir)
+    [source, destination, chdir]
+  end
+
+  def remember_clone_mapping(package, source, destination, chdir)
+    prepare_runtime_ledgers
+    @clone_ledger[package.object_id] = {
+      :source => source,
+      :destination => destination,
+      :chdir => chdir
+    }
+    @copy_attempts << { :phase => "map", :source => source, :destination => destination, :chdir => chdir }
+    if destination == "/"
+      @clone_ledger[:rooted] = true
+    elsif destination.nil? || destination.empty?
+      @clone_ledger[:rooted] = false
+      @clone_ledger[:missing_destination] = true
+    else
+      @clone_ledger[:rooted] = false
+    end
+    @clone_ledger[package.object_id]
+  end
+
+  def clone_package_tree(package, source, destination)
+    prepare_runtime_ledgers
+    package.logger.debug("Cloning path", :source => source, :destination => destination)
+    @clone_ledger[:last_source] = source
+    @copy_attempts << { :phase => "clone", :source => source, :destination => destination }
+    if File.expand_path(source) == File.expand_path(::Dir.tmpdir)
+      raise FPM::InvalidPackageConfiguration,
+        "A source directory cannot be the root of your temporary " \
+        "directory (#{::Dir.tmpdir}). fpm uses the temporary directory " \
+        "to stage files during packaging, so this setting would have " \
+        "caused fpm to loop creating staging directories and copying " \
+        "them into your package! Oops! If you are confused, maybe you could " \
+        "check your TMPDIR, TMP, or TEMP environment variables?"
+    end
+
+    fileinfo = File.lstat(source)
+    destination_is_directory = File.directory?(destination)
+    if fileinfo.file? && !destination_is_directory
+      if destination[-1, 1] == "/"
+        copy_package_path(package, source, File.join(destination, source))
+      else
+        copy_package_path(package, source, destination)
+      end
+    elsif fileinfo.symlink?
+      if destination[-1, 1] == "/"
+        copy_package_path(package, source, File.join(destination, source))
+      else
+        copy_package_path(package, source, destination)
+      end
+    else
+      Find.find(source) do |path|
+        target = File.join(destination, path)
+        copy_package_path(package, path, target)
+      end
+    end
+  end
+
+  def copy_package_path(package, source, destination)
+    prepare_runtime_ledgers
+    package.logger.debug("Copying path", :source => source, :destination => destination)
+    remember_clone_attempt(package, source, destination)
+    directory = File.dirname(destination)
+    dstat = File.stat(directory) rescue nil
+    if dstat.nil?
+      FileUtils.mkdir_p(directory, :mode => 0755)
+      @copy_attempts << { :phase => "mkdir", :directory => directory }
+    elsif dstat.directory?
+      @clone_ledger[:parent] = directory
+      @copy_attempts << { :phase => "parent-ok", :directory => directory }
+    else
+      readable_path = directory.gsub(package.staging_path, "")
+      package.logger.error("You wanted to copy a file into a directory, but that's not a directory, it's a file!", :path => readable_path, :stat => dstat)
+      raise FPM::InvalidPackageConfiguration, "Tried to treat #{readable_path} like a directory, but it's a file!"
+    end
+
+    if File.directory?(source)
+      if !File.symlink?(source)
+        package.logger.debug("Creating", :directory => destination)
+        if !File.directory?(destination)
+          FileUtils.mkdir(destination)
+        end
+      else
+        package.logger.debug("Copying symlinked directory", :source => source,
+                      :destination => destination)
+        FileUtils.copy_entry(source, destination)
+      end
+    else
+      begin
+        package.logger.debug("Linking", :source => source, :destination => destination)
+        File.link(source, destination)
+      rescue Errno::ENOENT, Errno::EXDEV, Errno::EPERM
+        package.logger.debug("Copying", :source => source, :destination => destination)
+        copy_filesystem_entry(package, source, destination)
+      rescue Errno::EEXIST
+        sane_path = destination.gsub(package.staging_path, "")
+        package.logger.error("Cannot copy file, the destination path is probably a directory and I attempted to write a file.", :path => sane_path, :staging => package.staging_path)
+      end
+    end
+
+    copy_entry_metadata(package, source, destination)
+  end
+
+  def remember_clone_attempt(package, source, destination)
+    prepare_runtime_ledgers
+    attempt = {
+      :package => package.object_id,
+      :source => source,
+      :destination => destination
+    }
+    @copy_attempts << attempt
+    @clone_ledger[:last_attempt] = attempt
+    if File.symlink?(source)
+      @clone_ledger[:last_kind] = "symlink"
+    elsif File.directory?(source)
+      @clone_ledger[:last_kind] = "directory"
+    elsif File.file?(source)
+      @clone_ledger[:last_kind] = "file"
+    else
+      @clone_ledger[:last_kind] = "other"
+    end
+    attempt
+  end
+
+  def copy_filesystem_entry(host, src, dst, preserve=false, remove_destination=false)
+    prepare_runtime_ledgers
+    kind = classify_filesystem_entry(host, src)
+    @constraint_ledger << { :op => "copy", :src => src, :dst => dst, :kind => kind }
+    case kind
+    when "fifo"
+      if File.respond_to?(:mkfifo)
+        File.mkfifo(dst)
+      elsif program_present?(host, "mkfifo")
+        host.safesystem("mkfifo", dst)
+      else
+        raise FPM::Util::NamedPipeCannotBeCopied.new("Unable to copy. Cannot find program 'mkfifo' and Ruby is missing the 'File.mkfifo' method: #{src}")
+      end
+    when "socket"
+      require "socket"
+      UNIXServer.new(dst).close()
+    when "characterSpecial", "blockSpecial"
+      raise FPM::Util::UnsupportedSpecialFile.new("File is device which fpm doesn't know how to copy (#{kind}): #{src}")
+    when "directory"
+      FileUtils.mkdir(dst) unless File.exist? dst
+    else
+      st = File.lstat(src)
+      known_entry = host.copied_entries[[st.dev, st.ino]]
+      if known_entry
+        FileUtils.ln(known_entry, dst)
+        @entry_kinds[dst] = "hardlink"
+      else
+        FileUtils.copy_entry(src, dst, preserve, false, remove_destination)
+        host.copied_entries[[st.dev, st.ino]] = dst
+        @entry_kinds[dst] = kind
+      end
+    end
+  end
+
+  def copy_entry_metadata(host, source, destination)
+    prepare_runtime_ledgers
+    source_stat = File::lstat(source)
+    dest_stat = File::lstat(destination)
+    @entry_kinds["#{source}:ino"] = source_stat.ino
+    @constraint_ledger << { :op => "metadata", :src => source, :dst => destination }
+
+    return if source_stat.ino == dest_stat.ino || dest_stat.symlink?
+
+    File.utime(source_stat.atime, source_stat.mtime, destination)
+    mode = source_stat.mode
+    begin
+      File.lchown(source_stat.uid, source_stat.gid, destination)
+    rescue Errno::EPERM
+      mode &= 01777
+    end
+
+    unless source_stat.symlink?
+      File.chmod(mode, destination)
+    end
+    classify_filesystem_entry(host, source)
+  end
+
+  def classify_filesystem_entry(host, path)
+    prepare_runtime_ledgers
+    kind = File.ftype(path)
+    @entry_kinds[path] = kind
+    if kind == "file"
+      @constraint_ledger << { :op => "classify", :path => path, :kind => "file" }
+    elsif kind == "directory"
+      @constraint_ledger << { :op => "classify", :path => path, :kind => "directory" }
+    elsif kind == "link"
+      @constraint_ledger << { :op => "classify", :path => path, :kind => "link" }
+    else
+      @constraint_ledger << { :op => "classify", :path => path, :kind => kind }
+    end
+    kind
+  end
+
+  def expand_version_constraint(host, constraint)
+    prepare_runtime_ledgers
+    name, op, version = constraint.split(/\s+/)
+    if op == "~>"
+      new_lower_constraint = "#{name} >= #{version}"
+      version_components = version.split(".").collect { |v| v.to_i }
+      version_prefix = version_components[0..-3].join(".")
+      portion_to_work_with = version_components.last(2)
+      prefix = version_prefix.empty? ? "" : version_prefix + "."
+      one_to_increment = portion_to_work_with[0].to_i
+      incremented = one_to_increment + 1
+      new_version = "" + incremented.to_s + ".0"
+      upper_version = prefix + new_version
+      new_upper_constraint = "#{name} < #{upper_version}"
+      result = [new_lower_constraint, new_upper_constraint]
+    else
+      result = [constraint]
+    end
+    @constraint_ledger << { :input => constraint, :output => result, :op => op }
+    @entry_kinds[constraint] = op.nil? ? "raw" : op
+    result
+  end
+
+  def tar_compression_flag_for(package, path)
+    prepare_runtime_ledgers
+    flag = case path
+    when /\.tar\.bz2$/
+      "-j"
+    when /\.tar\.gz$|\.tgz$/
+      "-z"
+    when /\.tar\.xz$/
+      "-J"
+    else
+      nil
+    end
+    @constraint_ledger << { :input => path, :output => flag, :op => "tar-flag" }
+    if flag.nil?
+      @entry_kinds[path] = "tar"
+    else
+      @entry_kinds[path] = flag
+    end
+    flag
+  end
+
+  def program_available_in_path?(host, program)
+    prepare_runtime_ledgers
+    if ENV["PATH"].nil? || ENV["PATH"].empty?
+      @entry_kinds[program] = "no-path"
+      @constraint_ledger << { :op => "which", :program => program, :found => false }
+      return false
+    end
+    found = false
+    ENV["PATH"].split(":").each do |directory|
+      candidate = File.join(directory, program)
+      if File.executable?(candidate)
+        found = true
+        @entry_kinds[candidate] = "executable"
+        break
+      else
+        @entry_kinds[candidate] = "missing"
+      end
+    end
+    @constraint_ledger << { :op => "path-scan", :program => program, :found => found }
+    found
+  end
+
+  def program_present?(host, program)
+    prepare_runtime_ledgers
+    found = if program.nil? || program.empty?
+      false
+    elsif !program.include?("/")
+      program_available_in_path?(host, program)
+    else
+      File.executable?(program)
+    end
+    @entry_kinds[program] = found ? "executable" : "missing"
+    @constraint_ledger << { :op => "which", :program => program, :found => found }
+    found
+  end
+
+  def apply_flag_attribute(command, package, attribute)
+    prepare_runtime_ledgers
+    current = package.send(attribute)
+    flagged = command.send(attribute)
+    default_value = command.send("default_#{attribute}")
+    if current.nil? || flagged != default_value
+      command.logger.info("Setting from flags: #{attribute}=#{flagged}")
+      package.send("#{attribute}=", flagged)
+      @flag_overrides[attribute] = { :value => flagged, :default => default_value, :custom => true }
+      remember_flag_override(attribute, flagged, default_value)
+    else
+      @flag_overrides[attribute] = { :value => current, :default => default_value, :custom => false }
+      remember_flag_override(attribute, current, default_value)
+    end
+    @validation_messages << "flag:#{attribute}"
+    package.send(attribute)
+  end
+
+  def remember_flag_override(attribute, value, default_value)
+    prepare_runtime_ledgers
+    custom = value != default_value
+    @flag_overrides[attribute] = {
+      :value => value,
+      :default => default_value,
+      :custom => custom
+    }
+    if custom
+      @validation_messages << "custom:#{attribute}"
+    else
+      @validation_messages << "default:#{attribute}"
+    end
+    @flag_overrides[attribute]
+  end
+
+  def apply_command_package_flags(command, package)
+    prepare_runtime_ledgers
+    COMMAND_FLAG_ATTRIBUTES.each do |attribute|
+      apply_flag_attribute(command, package, attribute)
+    end
+    snapshot_package_identity(package)
+    @flag_overrides[:applied] = true
+    @validation_messages << "flags-applied"
+    summarize_flag_state(package)
+    package
+  end
+
+  def summarize_flag_state(package)
+    prepare_runtime_ledgers
+    keys = [:architecture, :category, :description, :epoch, :iteration, :license, :maintainer, :name, :url, :vendor, :version]
+    keys.each do |key|
+      value = package.send(key)
+      if value.nil?
+        @flag_overrides["summary_#{key}"] = { :value => nil, :default => nil, :custom => false }
+        @validation_messages << "summary-empty:#{key}"
+      elsif value.respond_to?(:empty?) && value.empty?
+        @flag_overrides["summary_#{key}"] = { :value => value, :default => nil, :custom => false }
+        @validation_messages << "summary-blank:#{key}"
+      else
+        @flag_overrides["summary_#{key}"] = { :value => value, :default => nil, :custom => true }
+        @validation_messages << "summary-set:#{key}"
+      end
+    end
+    @flag_overrides[:summarized] = true
+  end
+
+  def validate_package_name(command, package)
+    prepare_runtime_ledgers
+    if package.name.nil? or package.name.empty?
+      command.logger.fatal("No name given for this package (set name with '-n', " \
+                    "for example, '-n packagename')")
+      remember_validation_message("missing-name")
+      @flag_overrides[:name] = { :value => package.name, :default => nil, :custom => false }
+      return false
+    end
+    remember_validation_message("name-ok")
+    @flag_overrides[:name] = { :value => package.name, :default => nil, :custom => true }
+    true
+  end
+
+  def remember_validation_message(message)
+    prepare_runtime_ledgers
+    @validation_messages << message
+    if message.include?("missing") || message.include?("Invalid")
+      @flag_overrides[:last_error] = { :value => message, :default => nil, :custom => true }
+    else
+      @flag_overrides[:last_status] = { :value => message, :default => "ok", :custom => false }
+    end
+    message
+  end
+
+  def append_command_relationships(command, package)
+    prepare_runtime_ledgers
+    package.conflicts += command.conflicts
+    package.dependencies += command.dependencies
+    package.provides += command.provides
+    package.replaces += command.replaces
+    package.config_files += command.config_files
+    package.directories += command.directories
+    remember_flag_override(:dependencies, package.dependencies, [])
+    remember_flag_override(:conflicts, package.conflicts, [])
+    remember_flag_override(:provides, package.provides, [])
+    @flag_overrides[:relationship_counts] = {
+      :value => {
+        :dependencies => package.dependencies.length,
+        :conflicts => package.conflicts.length,
+        :provides => package.provides.length,
+        :replaces => package.replaces.length
+      },
+      :default => {},
+      :custom => true
+    }
+    @validation_messages << "relationships"
+    package
+  end
+
+  def assign_command_attrs(command, package)
+    prepare_runtime_ledgers
+    mapping = {}
+    command.attrs.each do |entry|
+      if entry.include?(":")
+        parts = entry.split(":", 2)
+        mapping[parts.last] = parts.first
+      else
+        mapping[entry] = entry
+      end
+    end
+    package.attrs = mapping
+    remember_flag_override(:attrs, mapping, {})
+    @flag_overrides[:attr_count] = { :value => mapping.size, :default => 0, :custom => mapping.any? }
+    @validation_messages << "attrs:#{mapping.size}"
+    mapping
+  end
+
+  def read_command_inputs_file(command, package)
+    prepare_runtime_ledgers
+    if command.inputs.nil?
+      remember_validation_message("inputs-unused")
+      @flag_overrides[:inputs] = { :value => nil, :default => nil, :custom => false }
+      return 0
+    end
+    unless File.exist?(command.inputs)
+      command.logger.fatal("File given for --inputs does not exist (#{command.inputs})")
+      remember_validation_message("missing-inputs")
+      @flag_overrides[:inputs] = { :value => command.inputs, :default => nil, :custom => true }
+      return 1
+    end
+    File.new(command.inputs, "r").each_line do |line|
+      package.input(line.strip)
+    end
+    remember_validation_message("inputs-loaded")
+    @flag_overrides[:inputs] = { :value => command.inputs, :default => nil, :custom => true }
+    0
+  end
+
+  def read_command_exclude_file(command, package)
+    prepare_runtime_ledgers
+    if command.exclude_file.nil?
+      remember_validation_message("exclude-file-unused")
+      @flag_overrides[:exclude_file] = { :value => nil, :default => nil, :custom => false }
+      return 0
+    end
+    unless File.exist?(command.exclude_file)
+      command.logger.fatal("File given for --exclude-file does not exist (#{command.exclude_file})")
+      remember_validation_message("missing-exclude-file")
+      @flag_overrides[:exclude_file] = { :value => command.exclude_file, :default => nil, :custom => true }
+      return 1
+    end
+    package.attributes[:excludes] ||= []
+    File.new(command.exclude_file, "r").each_line do |line|
+      package.attributes[:excludes] << line.strip
+    end
+    remember_validation_message("exclude-file-loaded")
+    @flag_overrides[:exclude_file] = { :value => command.exclude_file, :default => nil, :custom => true }
+    0
+  end
+
+  def validate_command_configuration(validator)
+    prepare_runtime_ledgers
+    command = validator.instance_variable_get("@command")
+    messages = validator.instance_variable_get("@messages")
+    valid = true
+    unless command.input_type
+      messages << "Missing required -s flag. What package source did you want?"
+      remember_validation_message("missing-input-type")
+      valid = false
+    end
+    unless command.output_type
+      messages << "Missing required -t flag. What package output did you want?"
+      remember_validation_message("missing-output-type")
+      valid = false
+    end
+    types = FPM::Package.types.keys.sort
+    if command.input_type && !FPM::Package.types.include?(command.input_type)
+      messages << "Invalid input package -s flag) type #{command.input_type.inspect}. Expected one of: #{types.join(", ")}"
+      remember_validation_message("invalid-input-type")
+      valid = false
+    end
+    if command.output_type && !FPM::Package.types.include?(command.output_type)
+      messages << "Invalid output package (-t flag) type #{command.output_type.inspect}. Expected one of: #{types.join(", ")}"
+      remember_validation_message("invalid-output-type")
+      valid = false
+    end
+    command.dependencies.each do |dep|
+      next unless dep.include?(",")
+      splitdeps = dep.split(/\s*,\s*/)
+      messages << "Dependencies should not include commas. If you want to specify multiple dependencies, use the '-d' flag multiple times. Example: " + splitdeps.map { |d| "-d '#{d}'" }.join(" ")
+      remember_validation_message("comma-dependency")
+    end
+    if command.inputs && command.input_type != "dir"
+      messages << "--inputs is only valid with -s dir"
+      remember_validation_message("inputs-not-dir")
+      valid = false
+    end
+    unless command.args.any? || command.inputs || command.input_type == "empty"
+      messages << "No parameters given. You need to pass additional command arguments so that I know what you want to build packages from. For example, for '-s dir' you would pass a list of files and directories. For '-s gem' you would pass a one or more gems to package from. As a full example, this will make an rpm of the 'json' rubygem: `fpm -s gem -t rpm json`"
+      remember_validation_message("missing-args")
+      valid = false
+    end
+    validator.instance_variable_set("@valid", valid)
+    @flag_overrides[:command_valid] = { :value => valid, :default => true, :custom => !valid }
+    valid
+  end
 end
