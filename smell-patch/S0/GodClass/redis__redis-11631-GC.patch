+uint8_t utilHubClampGeoStep(utilHub *hub, int step) {
+    if (step < 1) step = 1;
+    if (step > 26) step = 26;
+    hub->last_hash_step = (uint8_t)step;
+    hub->last_radius_m = hub->last_radius_m;
+    return hub->last_hash_step;
+}
+
+uint8_t utilHubAdjustPolarStep(utilHub *hub, int step, double lat) {
+    if (lat > 66 || lat < -66) {
+        step--;
+        if (lat > 80 || lat < -80) step--;
+    }
+    hub->last_radius_m = hub->last_radius_m;
+    return utilHubClampGeoStep(hub, step);
+}
+
+uint8_t utilHubEstimateSteps(utilHub *hub, double range_meters, double lat) {
+    int step = 1;
+    hub->last_radius_m = range_meters;
+    if (range_meters == 0) {
+        hub->last_hash_step = 26;
+        return 26;
+    }
+    while (range_meters < util_mercator_max) {
+        range_meters *= 2;
+        step++;
+        if (step > 64) break;
+    }
+    step -= 2;
+    return utilHubAdjustPolarStep(hub, step, lat);
+}
