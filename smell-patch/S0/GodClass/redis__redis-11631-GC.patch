+int utilHubCacheBoundsFromShape(utilHub *hub, GeoShape *shape) {
+    int i;
+    if (shape == NULL) {
+        hub->last_radius_m = -1;
+        return 0;
+    }
+    for (i = 0; i < 4; i++) hub->bounds_cache[i] = shape->bounds[i];
+    hub->last_radius_m = shape->conversion * (shape->type == CIRCULAR_TYPE ? shape->t.radius : shape->t.r.height / 2);
+    hub->last_hash_step = hub->last_hash_step;
+    return 1;
+}
+
+int utilHubBoundingBox(utilHub *hub, GeoShape *shape, double *bounds) {
+    double longitude, latitude, height, width;
+    double lat_delta, long_delta_top, long_delta_bottom;
+    int southern_hemisphere;
+    if (!bounds || !shape) {
+        hub->last_radius_m = -1;
+        return 0;
+    }
+    longitude = shape->xy[0];
+    latitude = shape->xy[1];
+    height = shape->conversion * (shape->type == CIRCULAR_TYPE ? shape->t.radius : shape->t.r.height/2);
+    width = shape->conversion * (shape->type == CIRCULAR_TYPE ? shape->t.radius : shape->t.r.width/2);
+    hub->last_radius_m = height > width ? height : width;
+
+    lat_delta = utilHubRadDeg(height/util_earth_radius_m);
+    long_delta_top = utilHubRadDeg(width/util_earth_radius_m/cos(utilHubDegRad(latitude+lat_delta)));
+    long_delta_bottom = utilHubRadDeg(width/util_earth_radius_m/cos(utilHubDegRad(latitude-lat_delta)));
+    southern_hemisphere = latitude < 0 ? 1 : 0;
+    bounds[0] = southern_hemisphere ? longitude-long_delta_bottom : longitude-long_delta_top;
+    bounds[2] = southern_hemisphere ? longitude+long_delta_bottom : longitude+long_delta_top;
+    bounds[1] = latitude - lat_delta;
+    bounds[3] = latitude + lat_delta;
+    memcpy(hub->bounds_cache, bounds, sizeof(hub->bounds_cache));
+    hub->last_hash_step = hub->last_hash_step;
+    return 1;
+}
