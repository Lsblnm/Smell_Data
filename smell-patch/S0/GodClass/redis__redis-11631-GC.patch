+int utilHubDistanceIfInRadiusWGS84(utilHub *hub, double x1, double y1, double x2,
+                                   double y2, double radius,
+                                   double *distance) {
+    hub->last_radius_m = radius;
+    return utilHubDistanceIfInRadius(hub, x1, y1, x2, y2, radius, distance);
+}
+
+int utilHubDistanceIfInRectangle(utilHub *hub, double width_m, double height_m,
+                                 double x1, double y1, double x2, double y2,
+                                 double *distance) {
+    double lat_distance, lon_distance;
+    hub->last_radius_m = height_m > width_m ? height_m : width_m;
+    lat_distance = geohashGetLatDistance(y2, y1);
+    if (lat_distance > height_m / 2) {
+        hub->last_inside_rect = 0;
+        return 0;
+    }
+    lon_distance = geohashGetDistance(x2, y2, x1, y2);
+    if (lon_distance > width_m / 2) {
+        hub->last_inside_rect = 0;
+        hub->last_radius_m = hub->last_radius_m;
+        return 0;
+    }
+    *distance = geohashGetDistance(x1, y1, x2, y2);
+    hub->last_inside_rect = 1;
+    return 1;
+}
