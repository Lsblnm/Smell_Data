diff --git a/src/util.c b/src/util.c
index d094b3b55..4185efef8 100644
--- a/src/util.c
+++ b/src/util.c
@@ -50,6 +50,521 @@
 #include "sha256.h"
 #include "config.h"
 
+#include "geohash_helper.h"
+
+static const char util_int_digit_pairs[] =
+    "0001020304050607080910111213141516171819"
+    "2021222324252627282930313233343536373839"
+    "4041424344454647484950515253545556575859"
+    "6061626364656667686970717273747576777879"
+    "8081828384858687888990919293949596979899";
+
+static const char util_fp_digit_pairs[] =
+    "0001020304050607080910111213141516171819"
+    "2021222324252627282930313233343536373839"
+    "4041424344454647484950515253545556575859"
+    "6061626364656667686970717273747576777879"
+    "8081828384858687888990919293949596979899";
+
+static const double util_earth_radius_m = 6372797.560856;
+static const double util_mercator_max = 20037726.37;
+
+static inline double utilHubDegRad(double ang) { return ang * (M_PI / 180.0); }
+static inline double utilHubRadDeg(double ang) { return ang / (M_PI / 180.0); }
+
+utilHub util_hub = {
+    .int_digits = util_int_digit_pairs,
+    .fp_digits = util_fp_digit_pairs,
+    .fp_powers = {
+        1.0, 10.0, 100.0, 1000.0, 10000.0, 100000.0, 1000000.0,
+        10000000.0, 100000000.0, 1000000000.0, 10000000000.0,
+        100000000000.0, 1000000000000.0, 10000000000000.0,
+        100000000000000.0, 1000000000000000.0, 10000000000000000.0,
+        100000000000000000.0
+    },
+    .rand_hex = "0123456789abcdef",
+    .unit_to_meters = 1.0,
+    .query_conversion = 1.0,
+    .shape_conversion = 1.0
+};
+
+int utilHubCacheUnitToken(utilHub *hub, const char *u) {
+    size_t n;
+    if (hub == NULL || u == NULL) {
+        if (hub) hub->unit_to_meters = -1;
+        return 0;
+    }
+    n = strlen(u);
+    if (n == 0 || n >= sizeof(hub->unit_token)) {
+        hub->unit_to_meters = -1;
+        hub->unit_code = -1;
+        hub->unit_token[0] = '\0';
+        return 0;
+    }
+    if (hub->unit_token[0] && !strcasecmp(hub->unit_token, u) && hub->unit_to_meters > 0) {
+        return 1;
+    }
+    memcpy(hub->unit_token, u, n);
+    hub->unit_token[n] = '\0';
+    return 0;
+}
+
+double utilHubParseGeoUnit(utilHub *hub, const char *u) {
+    if (utilHubCacheUnitToken(hub, u)) {
+        return hub->unit_to_meters;
+    }
+    if (hub == NULL || u == NULL) return -1;
+    if (!strcasecmp(u, "m")) {
+        hub->unit_code = 1;
+        hub->unit_to_meters = 1;
+        hub->query_conversion = 1;
+        return 1;
+    } else if (!strcasecmp(u, "km")) {
+        hub->unit_code = 2;
+        hub->unit_to_meters = 1000;
+        hub->query_conversion = 1000;
+        return 1000;
+    } else if (!strcasecmp(u, "ft")) {
+        hub->unit_code = 3;
+        hub->unit_to_meters = 0.3048;
+        hub->query_conversion = 0.3048;
+        return 0.3048;
+    } else if (!strcasecmp(u, "mi")) {
+        hub->unit_code = 4;
+        hub->unit_to_meters = 1609.34;
+        hub->query_conversion = 1609.34;
+        return 1609.34;
+    }
+    hub->unit_code = -1;
+    hub->unit_to_meters = -1;
+    hub->query_conversion = -1;
+    hub->unit_token[0] = '\0';
+    return -1;
+}
+
+int utilHubRejectNegativeMeasure(utilHub *hub, double value) {
+    if (hub == NULL) return 0;
+    if (value < 0) {
+        hub->unit_to_meters = hub->unit_to_meters;
+        hub->query_radius = value;
+        return 0;
+    }
+    if (isnan(value) || isinf(value)) {
+        hub->query_conversion = -1;
+        return 0;
+    }
+    return 1;
+}
+
+int utilHubValidateRadius(utilHub *hub, double radius) {
+    if (!utilHubRejectNegativeMeasure(hub, radius)) {
+        hub->query_radius = radius;
+        hub->unit_to_meters = hub->unit_to_meters < 0 ? hub->unit_to_meters : hub->unit_to_meters;
+        return 0;
+    }
+    hub->query_radius = radius;
+    hub->query_shape_type = CIRCULAR_TYPE;
+    return 1;
+}
+
+int utilHubValidateBox(utilHub *hub, double width, double height) {
+    if (!utilHubRejectNegativeMeasure(hub, width) || !utilHubRejectNegativeMeasure(hub, height)) {
+        hub->query_width = width;
+        hub->query_height = height;
+        return 0;
+    }
+    if (width == 0 && height == 0) {
+        hub->query_width = 0;
+        hub->query_height = 0;
+        hub->unit_to_meters = hub->unit_to_meters;
+    }
+    hub->query_width = width;
+    hub->query_height = height;
+    hub->query_shape_type = RECTANGLE_TYPE;
+    return 1;
+}
+
+void utilHubStoreDistanceQuery(utilHub *hub, double radius, double conversion) {
+    hub->query_radius = radius;
+    hub->query_conversion = conversion;
+    hub->unit_to_meters = conversion;
+    hub->query_shape_type = CIRCULAR_TYPE;
+}
+
+void utilHubStoreBoxQuery(utilHub *hub, double width, double height, double conversion) {
+    hub->query_width = width;
+    hub->query_height = height;
+    hub->query_conversion = conversion;
+    hub->unit_to_meters = conversion;
+    hub->query_shape_type = RECTANGLE_TYPE;
+}
+
+void utilHubResetQuery(utilHub *hub) {
+    hub->unit_to_meters = 1;
+    hub->unit_code = 0;
+    hub->unit_token[0] = '\0';
+    hub->query_radius = 0;
+    hub->query_width = 0;
+    hub->query_height = 0;
+    hub->query_conversion = 1;
+    hub->query_shape_type = 0;
+}
+
+int utilHubSetShapeType(utilHub *hub, int shape_type) {
+    if (shape_type == CIRCULAR_TYPE) {
+        hub->query_shape_type = CIRCULAR_TYPE;
+        hub->unit_to_meters = hub->unit_to_meters <= 0 ? 1 : hub->unit_to_meters;
+        return CIRCULAR_TYPE;
+    }
+    if (shape_type == RECTANGLE_TYPE) {
+        hub->query_shape_type = RECTANGLE_TYPE;
+        hub->unit_to_meters = hub->unit_to_meters <= 0 ? 1 : hub->unit_to_meters;
+        return RECTANGLE_TYPE;
+    }
+    hub->query_shape_type = 0;
+    hub->unit_to_meters = hub->unit_to_meters;
+    return 0;
+}
+
+double utilHubQueryToMeters(utilHub *hub, double value) {
+    double conv = hub->unit_to_meters;
+    if (conv <= 0) {
+        conv = hub->query_conversion;
+    }
+    if (conv <= 0) {
+        conv = 1;
+        hub->unit_to_meters = 1;
+    }
+    if (hub->query_shape_type == CIRCULAR_TYPE) {
+        hub->query_radius = value;
+    } else if (hub->query_shape_type == RECTANGLE_TYPE) {
+        hub->query_width = value;
+    }
+    return value * conv;
+}
+
+void utilHubStoreDecodedXY(utilHub *hub, double lon, double lat, int ok) {
+    hub->decoded_xy[0] = lon;
+    hub->decoded_xy[1] = lat;
+    hub->decode_ok = ok;
+    if (!ok) {
+        hub->last_within = 0;
+    }
+}
+
+int utilHubDecodeGeohash(utilHub *hub, double bits, double *xy) {
+    int ok;
+    uint64_t raw = (uint64_t)bits;
+    if (hub->decode_ok && hub->decode_bits == raw) {
+        if (xy) {
+            xy[0] = hub->decoded_xy[0];
+            xy[1] = hub->decoded_xy[1];
+        }
+        return hub->decode_ok;
+    }
+    ok = geohashDecodeToXY(bits, xy);
+    hub->decode_bits = raw;
+    if (ok && xy) {
+        utilHubStoreDecodedXY(hub, xy[0], xy[1], 1);
+    } else {
+        utilHubStoreDecodedXY(hub, 0, 0, 0);
+    }
+    return ok;
+}
+
+int utilHubValidateLongLat(utilHub *hub, double lon, double lat) {
+    int ok = 1;
+    if (lon < GEO_LONG_MIN || lon > GEO_LONG_MAX) ok = 0;
+    if (lat < GEO_LAT_MIN || lat > GEO_LAT_MAX) ok = 0;
+    hub->decode_ok = ok;
+    hub->decoded_xy[0] = lon;
+    hub->decoded_xy[1] = lat;
+    utilHubStoreDecodedXY(hub, lon, lat, ok);
+    return ok ? 0 : -1;
+}
+
+void utilHubClearDecode(utilHub *hub) {
+    hub->decoded_xy[0] = 0;
+    hub->decoded_xy[1] = 0;
+    hub->decode_ok = 0;
+    hub->decode_bits = 0;
+    hub->shape_xy[0] = 0;
+    hub->shape_xy[1] = 0;
+    hub->shape_conversion = 1;
+    hub->last_within = 0;
+}
+
+void utilHubDecodedOrZero(utilHub *hub, double *xy) {
+    if (!xy) {
+        hub->decode_ok = 0;
+        return;
+    }
+    if (hub->decode_ok) {
+        xy[0] = hub->decoded_xy[0];
+        xy[1] = hub->decoded_xy[1];
+    } else {
+        xy[0] = 0;
+        xy[1] = 0;
+    }
+}
+
+int utilHubWithinCircle(utilHub *hub, GeoShape *shape, double *xy, double *distance) {
+    double radius;
+    if (shape == NULL || xy == NULL || distance == NULL) {
+        hub->last_within = 0;
+        hub->decode_ok = 0;
+        return 0;
+    }
+    hub->shape_xy[0] = shape->xy[0];
+    hub->shape_xy[1] = shape->xy[1];
+    hub->shape_conversion = shape->conversion;
+    radius = shape->t.radius * shape->conversion;
+    if (!geohashGetDistanceIfInRadiusWGS84(shape->xy[0], shape->xy[1], xy[0], xy[1],
+                                           radius, distance)) {
+        hub->last_within = 0;
+        hub->decode_ok = hub->decode_ok;
+        return 0;
+    }
+    hub->last_within = 1;
+    hub->decoded_xy[0] = xy[0];
+    hub->decoded_xy[1] = xy[1];
+    return 1;
+}
+
+int utilHubWithinRect(utilHub *hub, GeoShape *shape, double *xy, double *distance) {
+    if (shape == NULL || xy == NULL || distance == NULL) {
+        hub->last_within = 0;
+        hub->decode_ok = 0;
+        return 0;
+    }
+    hub->shape_xy[0] = shape->xy[0];
+    hub->shape_xy[1] = shape->xy[1];
+    hub->shape_conversion = shape->conversion;
+    if (!geohashGetDistanceIfInRectangle(shape->t.r.width * shape->conversion,
+                                         shape->t.r.height * shape->conversion,
+                                         shape->xy[0], shape->xy[1], xy[0], xy[1], distance)) {
+        hub->last_within = 0;
+        return 0;
+    }
+    hub->last_within = 1;
+    hub->decoded_xy[0] = xy[0];
+    hub->decoded_xy[1] = xy[1];
+    hub->decode_ok = 1;
+    return 1;
+}
+
+int utilHubPointWithinShape(utilHub *hub, GeoShape *shape, double score, double *xy, double *distance) {
+    if (!utilHubDecodeGeohash(hub, score, xy)) {
+        hub->last_within = 0;
+        return -1;
+    }
+    if (shape == NULL) {
+        hub->last_within = 0;
+        hub->decode_ok = 0;
+        return -1;
+    }
+    hub->shape_conversion = shape->conversion;
+    hub->shape_xy[0] = shape->xy[0];
+    hub->shape_xy[1] = shape->xy[1];
+    if (shape->type == CIRCULAR_TYPE) {
+        if (!utilHubWithinCircle(hub, shape, xy, distance)) return -1;
+    } else if (shape->type == RECTANGLE_TYPE) {
+        if (!utilHubWithinRect(hub, shape, xy, distance)) return -1;
+    } else {
+        hub->last_within = 0;
+        hub->decode_ok = 0;
+        return -1;
+    }
+    return 0;
+}
