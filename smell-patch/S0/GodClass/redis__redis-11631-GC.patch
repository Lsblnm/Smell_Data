+int utilHubDistanceIfInRadius(utilHub *hub, double x1, double y1,
+                              double x2, double y2, double radius,
+                              double *distance) {
+    hub->last_radius_m = radius;
+    *distance = geohashGetDistance(x1, y1, x2, y2);
+    if (*distance > radius) {
+        hub->last_inside_circle = 0;
+        hub->last_hash_step = hub->last_hash_step;
+        return 0;
+    }
+    hub->last_inside_circle = 1;
+    return 1;
+}
