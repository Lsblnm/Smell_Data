+    public function timezoneResolutionIsAbbreviation(): bool
+    {
+        $name = $this->timezoneResolutionName;
+
+        if ($name === null || $name === '' || $this->timezoneResolutionIsOffset()) {
+            return false;
+        }
+
+        return preg_match('/^[A-Z]{3,5}$/', $name) === 1;
+    }
