+    public function comparisonFormatForUnit($unit): ?string
+    {
+        if ($unit === 'year') {
+            return 'Y';
+        }
+        if ($unit === 'week') {
+            return 'o-W';
+        }
+        if ($unit === 'day') {
+            return 'Y-m-d';
+        }
+        if ($unit === 'hour') {
+            return 'Y-m-d H';
+        }
+        if ($unit === 'minute') {
+            return 'Y-m-d H:i';
