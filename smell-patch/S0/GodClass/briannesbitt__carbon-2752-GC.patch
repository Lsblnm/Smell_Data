+    public function resolveAbbreviatedTimezoneName(CarbonTimeZone $timezone, $dst = false): string
+    {
+        $this->rememberTimezoneResolution($timezone);
+        $name = $this->timezoneResolutionName;
+
+        foreach ($timezone->listAbbreviations() as $abbreviation => $zones) {
+            foreach ($zones as $zone) {
+                if ($zone['timezone_id'] === $name && $zone['dst'] == $dst) {
+                    $this->timezoneAbbreviation = $abbreviation;
+
+                    return $abbreviation;
+                }
+            }
+        }
