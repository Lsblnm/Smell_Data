+        [$arguments, $settings] = $this->applyFactoryTimezoneArguments($arguments, $method);
+        $result = $className::$name(...$arguments);
+
+        return $result instanceof CarbonInterface && !empty($settings)
+            ? $result->settings($settings)
+            : $result;
+    }
