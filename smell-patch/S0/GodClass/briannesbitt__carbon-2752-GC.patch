+    public static function parseLanguageIdentity(string $id): array
+    {
+        $normalized = str_replace('-', '_', $id);
+        $parts = explode('_', $normalized);
+        $code = $parts[0];
+        $variant = null;
+        $region = null;
+
+        if (isset($parts[1])) {
+            if (!preg_match('/^[A-Z]+$/', $parts[1])) {
+                $variant = $parts[1];
+                $parts[1] = $parts[2] ?? null;
