+    public function captureTimezoneOffsetName(CarbonTimeZone $timezone, DateTimeInterface $date = null): string
+    {
+        $this->rememberTimezoneResolution($timezone);
+        $date = $date ?: static::now($timezone);
+        $this->timezoneOffsetMinutes = $timezone->getOffset($date) / 60;
+        $this->timezoneResolutionName = static::coordinateOffsetNameFromMinutes($this->timezoneOffsetMinutes);
+
+        return $this->timezoneResolutionName;
+    }
+
+    public function captureTimezoneRegionName(CarbonTimeZone $timezone, DateTimeInterface $date = null, $isDst = 1)
+    {
+        $this->rememberTimezoneResolution($timezone);
+        $name = $this->timezoneResolutionName;
+        $firstChar = substr((string) $name, 0, 1);
+
+        if ($firstChar !== '+' && $firstChar !== '-') {
+            return $name;
+        }
+
+        $date = $date ?: static::now($timezone);
+
+        try {
+            $offset = @$timezone->getOffset($date) ?: 0;
+        } catch (\Throwable $e) {
+            $offset = 0;
+        }
+
+        $this->timezoneOffsetMinutes = $offset / 60;
+        $resolved = @timezone_name_from_abbr('', $offset, $isDst);
+
+        if ($resolved) {
+            $this->timezoneResolutionName = $resolved;
+
+            return $resolved;
+        }
+
+        foreach (timezone_identifiers_list() as $identifier) {
+            if (Carbon::instance($date)->tz($identifier)->getOffset() === $offset) {
+                $this->timezoneResolutionName = $identifier;
+
+                return $identifier;
+            }
+        }
+
+        return false;
+    }
