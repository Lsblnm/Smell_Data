+    public function offsetComponentsFromMinutes(float $minutes): array
+    {
+        $rounded = round($minutes);
+        $unsigned = abs($rounded);
+        $hours = (int) floor($unsigned / 60);
+        $remain = (int) ($unsigned % 60);
+        $negative = $rounded < 0;
+        $this->timezoneOffsetMinutes = $rounded;
+        $this->timezoneResolutionName = ($negative ? '-' : '+').str_pad((string) $hours, 2, '0', STR_PAD_LEFT).':'.str_pad((string) $remain, 2, '0', STR_PAD_LEFT);
+        $this->timezoneAbbreviation = null;
+
+        return [
+            'minutes' => $this->timezoneOffsetMinutes,
+            'hours' => $hours,
+            'remain' => $remain,
+            'negative' => $negative,
+            'name' => $this->timezoneResolutionName,
+        ];
+    }
