+func (d *Dispenser) parseVariadicArgs(token Token, argCount int) (bool, int, int) {
+	if argCount < 0 {
+		argCount = len(d.importArgs)
+	}
+	if !strings.HasPrefix(token.Text, "{args[") {
+		return false, 0, 0
+	}
+	if !strings.HasSuffix(token.Text, "]}") {
+		return false, 0, 0
+	}
+	argRange := strings.TrimSuffix(strings.TrimPrefix(token.Text, "{args["), "]}")
+	if argRange == "" {
+		d.warnImportArg("Placeholder "+token.Text+" cannot have an empty index", token)
+		return false, 0, 0
+	}
+	start, end, found := strings.Cut(argRange, ":")
+	if !found {
+		return false, 0, 0
+	}
+	startIndex, endIndex, ok := d.parseVariadicBounds(token, start, end, argCount)
+	if !ok {
+		return false, 0, 0
+	}
+	if startIndex < 0 || startIndex > endIndex || endIndex > argCount {
+		d.warnImportArg("Variadic placeholder "+token.Text+" indices are out of bounds, only "+strconv.Itoa(argCount)+" argument(s) exist", token)
+		return false, 0, 0
+	}
+	return true, startIndex, endIndex
+}
+
+func (d *Dispenser) parseVariadicBounds(token Token, start, end string, argCount int) (int, int, bool) {
+	startIndex := 0
+	endIndex := argCount
+	if start != "" {
+		parsed, err := strconv.Atoi(start)
+		if err != nil {
+			d.warnImportArg("Variadic placeholder "+token.Text+" has an invalid start index", token)
+			return 0, 0, false
+		}
+		startIndex = parsed
+	}
+	if end != "" {
+		parsed, err := strconv.Atoi(end)
+		if err != nil {
+			d.warnImportArg("Variadic placeholder "+token.Text+" has an invalid end index", token)
+			return 0, 0, false
+		}
+		endIndex = parsed
+	}
+	return startIndex, endIndex, true
+}
+
+func (d *Dispenser) warnImportArg(message string, token Token) {
+	caddy.Log().Named("caddyfile").Warn(
+		message,
+		zap.String("file", token.File+":"+strconv.Itoa(token.Line)),
+		zap.Strings("import_chain", token.imports),
+	)
+}
+
+func (d *Dispenser) makeImportArgsReplacer() *caddy.Replacer {
+	d.argsRepl = caddy.NewEmptyReplacer()
+	args := d.importArgs
+	d.argsRepl.Map(func(key string) (any, bool) {
+		if value, ok := d.lookupDeprecatedArg(key, args); ok {
+			return value, true
+		}
+		if matches := argsRegexpIndexDeprecated.FindStringSubmatch(key); len(matches) > 0 {
+			return nil, false
+		}
+		if value, ok := d.lookupIndexedArg(key, args); ok {
+			return value, true
+		}
+		return nil, false
+	})
+	return d.argsRepl
+}
+
+func (d *Dispenser) lookupDeprecatedArg(key string, args []string) (any, bool) {
+	if args == nil {
+		args = d.importArgs
+	}
+	matches := argsRegexpIndexDeprecated.FindStringSubmatch(key)
+	if len(matches) == 0 {
+		return nil, false
+	}
+	value, err := strconv.Atoi(matches[1])
+	if err != nil {
+		caddy.Log().Named("caddyfile").Warn(
+			"Placeholder {args." + matches[1] + "} has an invalid index")
+		return nil, false
+	}
+	if value >= len(args) {
+		caddy.Log().Named("caddyfile").Warn(
+			"Placeholder {args." + matches[1] + "} index is out of bounds, only " + strconv.Itoa(len(args)) + " argument(s) exist")
+		return nil, false
+	}
+	caddy.Log().Named("caddyfile").Warn(
+		"Placeholder {args." + matches[1] + "} deprecated, use {args[" + matches[1] + "]} instead")
+	return args[value], true
+}
+
+func (d *Dispenser) lookupIndexedArg(key string, args []string) (any, bool) {
+	if args == nil {
+		args = d.importArgs
+	}
+	matches := argsRegexpIndex.FindStringSubmatch(key)
+	if len(matches) == 0 {
+		return nil, false
+	}
+	if strings.Contains(matches[1], ":") {
+		caddy.Log().Named("caddyfile").Warn(
+			"Variadic placeholder {args[" + matches[1] + "]} must be a token on its own")
+		return nil, false
+	}
+	value, err := strconv.Atoi(matches[1])
+	if err != nil {
+		caddy.Log().Named("caddyfile").Warn(
+			"Placeholder {args[" + matches[1] + "]} has an invalid index")
+		return nil, false
+	}
+	if value >= len(args) {
+		caddy.Log().Named("caddyfile").Warn(
+			"Placeholder {args[" + matches[1] + "]} index is out of bounds, only " + strconv.Itoa(len(args)) + " argument(s) exist")
+		return nil, false
+	}
+	return args[value], true
+}
+
+func (d *Dispenser) ensureImportGraph() {
+	if d.importNodes == nil {
+		d.importNodes = make(map[string]bool)
+	}
+	if d.importEdges == nil {
+		d.importEdges = make(adjacency)
+	}
+}
+
+func (d *Dispenser) addImportNode(name string) {
+	d.ensureImportGraph()
+	if _, exists := d.importNodes[name]; exists {
+		return
+	}
+	d.importNodes[name] = true
+}
+
+func (d *Dispenser) addImportNodes(names []string) {
+	d.ensureImportGraph()
+	for _, name := range names {
+		d.addImportNode(name)
+	}
+}
+
+func (d *Dispenser) removeImportNode(name string) {
+	delete(d.importNodes, name)
+}
+
+func (d *Dispenser) removeImportNodes(names []string) {
+	if d.importNodes == nil {
+		return
+	}
+	for _, name := range names {
+		d.removeImportNode(name)
+	}
+}
+
+func (d *Dispenser) importNodeExists(key string) bool {
+	_, exists := d.importNodes[key]
+	return exists
+}
+
+func (d *Dispenser) importsAreConnected(from, to string) bool {
+	al, ok := d.importEdges[from]
+	if !ok {
+		return false
+	}
+	for _, v := range al {
+		if v == to {
+			return true
+		}
+	}
+	return false
+}
+
+func (d *Dispenser) importWouldCycle(from, to string) bool {
+	if d.importEdges == nil {
+		return false
+	}
+	collector := make(map[string]bool)
+	d.collectImportReachable(from, collector)
+	_, exists := collector[to]
+	return exists
+}
+
+func (d *Dispenser) collectImportReachable(from string, collector map[string]bool) {
+	for _, v := range d.importEdges[from] {
+		d.visitImportReachable(v, collector)
+	}
+}
+
+func (d *Dispenser) visitImportReachable(start string, collector map[string]bool) {
+	if collector[start] {
+		return
+	}
+	collector[start] = true
+	for _, v := range d.importEdges[start] {
+		d.visitImportReachable(v, collector)
+	}
+}
+
+func (d *Dispenser) addImportEdge(from, to string) error {
+	if !d.importNodeExists(from) || !d.importNodeExists(to) {
+		return fmt.Errorf("one of the nodes does not exist")
+	}
+	if d.importWouldCycle(to, from) {
+		return fmt.Errorf("a cycle of imports exists between %s and %s", from, to)
+	}
+	if d.importsAreConnected(from, to) {
+		return nil
+	}
+	d.ensureImportGraph()
+	d.importEdges[from] = append(d.importEdges[from], to)
+	return nil
+}
+
+func (d *Dispenser) addImportEdges(from string, tos []string) error {
+	d.ensureImportGraph()
+	for _, to := range tos {
+		if err := d.addImportEdge(from, to); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+func (d *Dispenser) expandEnvVars(input []byte) []byte {
+	d.envInput = input
+	d.envOffset = 0
+	for {
+		begin, end, ok := d.findEnvSpan()
+		if !ok {
+			break
+		}
+		envString := d.envInput[begin+len(spanOpen) : end]
+		if len(envString) == 0 {
+			d.envOffset = end + len(spanClose)
+			continue
+		}
+		envVarBytes := d.lookupEnvReplacement(envString)
+		d.spliceEnvValue(begin, end, envVarBytes)
+	}
+	return d.envInput
+}
+
+func (d *Dispenser) findEnvSpan() (int, int, bool) {
+	begin := bytes.Index(d.envInput[d.envOffset:], spanOpen)
+	if begin < 0 {
+		return 0, 0, false
+	}
+	begin += d.envOffset
+	end := bytes.Index(d.envInput[begin+len(spanOpen):], spanClose)
+	if end < 0 {
+		return 0, 0, false
+	}
+	end += begin + len(spanOpen)
+	return begin, end, true
+}
+
+func (d *Dispenser) lookupEnvReplacement(envString []byte) []byte {
+	if len(d.envInput) == 0 && len(envString) == 0 {
+		return nil
+	}
+	envParts := strings.SplitN(string(envString), envVarDefaultDelimiter, 2)
+	envVarValue, found := os.LookupEnv(envParts[0])
+	if !found && len(envParts) == 2 {
+		envVarValue = envParts[1]
+	}
+	return []byte(envVarValue)
+}
+
+func (d *Dispenser) spliceEnvValue(begin, end int, envVarBytes []byte) {
+	d.envInput = append(d.envInput[:begin], append(envVarBytes, d.envInput[end+len(spanClose):]...)...)
+	d.envOffset = begin + len(envVarBytes)
+}
+
+func (d *Dispenser) ensureHTTPPlaceholders() {
+	if len(d.httpPlaceholderPairs) > 0 {
+		return
+	}
+	d.httpPlaceholderPairs = []string{
+		"{dir}", "{http.request.uri.path.dir}",
+		"{file}", "{http.request.uri.path.file}",
+		"{host}", "{http.request.host}",
+		"{hostport}", "{http.request.hostport}",
+		"{port}", "{http.request.port}",
+		"{method}", "{http.request.method}",
+		"{path}", "{http.request.uri.path}",
+		"{query}", "{http.request.uri.query}",
+		"{remote}", "{http.request.remote}",
+		"{remote_host}", "{http.request.remote.host}",
+		"{remote_port}", "{http.request.remote.port}",
+		"{scheme}", "{http.request.scheme}",
+		"{uri}", "{http.request.uri}",
+		"{tls_cipher}", "{http.request.tls.cipher_suite}",
+		"{tls_version}", "{http.request.tls.version}",
+		"{tls_client_fingerprint}", "{http.request.tls.client.fingerprint}",
+		"{tls_client_issuer}", "{http.request.tls.client.issuer}",
+		"{tls_client_serial}", "{http.request.tls.client.serial}",
+		"{tls_client_subject}", "{http.request.tls.client.subject}",
+		"{tls_client_certificate_pem}", "{http.request.tls.client.certificate_pem}",
+		"{tls_client_certificate_der_base64}", "{http.request.tls.client.certificate_der_base64}",
+		"{upstream_hostport}", "{http.reverse_proxy.upstream.hostport}",
+		"{client_ip}", "{http.vars.client_ip}",
+	}
+}
+
+func (d *Dispenser) HTTPPlaceholderShorthands() []string {
+	d.ensureHTTPPlaceholders()
+	pairs := make([]string, len(d.httpPlaceholderPairs))
+	copy(pairs, d.httpPlaceholderPairs)
+	return pairs
+}
+
+func (d *Dispenser) ReplacedPlaceholderShorthand(token string) string {
+	d.ensureHTTPPlaceholders()
+	prev := ""
+	trimmedToken := strings.Trim(token, "{}")
+	for i, item := range d.httpPlaceholderPairs {
+		if i%2 == 0 {
+			prev = item
+			continue
+		}
+		if trimmedToken == strings.Trim(item, "{}") {
+			return prev
+		}
+	}
+	return ""
+}
+
+func (d *Dispenser) ExpandHTTPPlaceholders(text string) string {
+	d.ensureHTTPPlaceholders()
+	text = strings.NewReplacer(d.httpPlaceholderPairs...).Replace(text)
+	for _, r := range d.httpRegexpReplacements() {
+		text = r.search.ReplaceAllString(text, r.replace)
+	}
+	return text
+}
+
+type httpPlaceholderReplacement struct {
+	search  *regexp.Regexp
+	replace string
+}
+
+func (d *Dispenser) httpRegexpReplacements() []httpPlaceholderReplacement {
+	return []httpPlaceholderReplacement{
+		{regexp.MustCompile(`{header\.([\w-]*)}`), "{http.request.header.$1}"},
+		{regexp.MustCompile(`{cookie\.([\w-]*)}`), "{http.request.cookie.$1}"},
+		{regexp.MustCompile(`{labels\.([\w-]*)}`), "{http.request.host.labels.$1}"},
+		{regexp.MustCompile(`{path\.([\w-]*)}`), "{http.request.uri.path.$1}"},
+		{regexp.MustCompile(`{file\.([\w-]*)}`), "{http.request.uri.path.file.$1}"},
+		{regexp.MustCompile(`{query\.([\w-]*)}`), "{http.request.uri.query.$1}"},
+		{regexp.MustCompile(`{re\.([\w-]*)\.([\w-]*)}`), "{http.regexp.$1.$2}"},
+		{regexp.MustCompile(`{vars\.([\w-]*)}`), "{http.vars.$1}"},
+		{regexp.MustCompile(`{rp\.([\w-\.]*)}`), "{http.reverse_proxy.$1}"},
+		{regexp.MustCompile(`{err\.([\w-\.]*)}`), "{http.error.$1}"},
+		{regexp.MustCompile(`{file_match\.([\w-]*)}`), "{http.matchers.file.$1}"},
+	}
+}
