+func (d *Dispenser) loadLexer(input io.Reader) error {
+	d.lexReader = bufio.NewReader(input)
+	d.lexLine = 1
+	d.lexSkippedLines = 0
+	d.lexToken = Token{}
+	d.resetLexerScanState()
+
+	firstCh, _, err := d.lexReader.ReadRune()
+	if err != nil {
+		return err
+	}
+	if firstCh != 0xFEFF {
+		if err := d.lexReader.UnreadRune(); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+func (d *Dispenser) resetLexerScanState() {
+	d.lexVal = nil
+	d.lexComment = false
+	d.lexQuoted = false
+	d.lexBtQuoted = false
+	d.lexInHeredoc = false
+	d.lexHeredocEscaped = false
+	d.lexEscaped = false
+	d.lexHeredocMarker = ""
+}
+
+func (d *Dispenser) lexerMakeToken(quoted rune) bool {
+	d.lexToken.Text = string(d.lexVal)
+	d.lexToken.wasQuoted = quoted
+	d.lexToken.heredocMarker = d.lexHeredocMarker
+	return true
+}
+
+func (d *Dispenser) nextLexerToken() (bool, error) {
+	d.resetLexerScanState()
+	for {
+		ch, _, err := d.lexReader.ReadRune()
+		if err != nil {
+			if len(d.lexVal) > 0 {
+				if d.lexInHeredoc {
+					return false, fmt.Errorf("incomplete heredoc <<%s on line #%d, expected ending marker %s", d.lexHeredocMarker, d.lexLine+d.lexSkippedLines, d.lexHeredocMarker)
+				}
+				return d.lexerMakeToken(0), nil
+			}
+			if err == io.EOF {
+				return false, nil
+			}
+			return false, err
+		}
+
+		if !d.lexInHeredoc && !d.lexHeredocEscaped && len(d.lexVal) > 1 && string(d.lexVal[:2]) == "<<" {
+			if ch == '<' {
+				return false, fmt.Errorf("too many '<' for heredoc on line #%d; only use two, for example <<END", d.lexLine)
+			}
+			if ch == '\r' {
+				continue
+			}
+			if ch == '\n' {
+				d.lexHeredocMarker = string(d.lexVal[2:])
+				if !heredocMarkerRegexp.Match([]byte(d.lexHeredocMarker)) {
+					return false, fmt.Errorf("heredoc marker on line #%d must contain only alpha-numeric characters, dashes and underscores; got '%s'", d.lexLine, d.lexHeredocMarker)
+				}
+				d.lexInHeredoc = true
+				d.lexSkippedLines++
+				d.lexVal = nil
+				continue
+			}
+			d.lexVal = append(d.lexVal, ch)
+			continue
+		}
+
+		if d.lexInHeredoc {
+			done, err := d.consumeLexerHeredoc(ch)
+			if err != nil {
+				return false, err
+			}
+			if done {
+				return d.lexerMakeToken('<'), nil
+			}
+			continue
+		}
+
+		if !d.lexEscaped && !d.lexBtQuoted && ch == '\\' {
+			d.lexEscaped = true
+			continue
+		}
+
+		if d.lexQuoted || d.lexBtQuoted {
+			if d.finishLexerQuoted(ch) {
+				return d.lexerMakeToken(ch), nil
+			}
+			continue
+		}
+
+		if unicode.IsSpace(ch) {
+			if d.consumeLexerSpace(ch) {
+				return d.lexerMakeToken(0), nil
+			}
+			continue
+		}
+
+		if ch == '#' && len(d.lexVal) == 0 {
+			d.lexComment = true
+		}
+		if d.lexComment {
+			continue
+		}
+
+		if len(d.lexVal) == 0 {
+			d.lexToken = Token{Line: d.lexLine}
+			if ch == '"' {
+				d.lexQuoted = true
+				continue
+			}
+			if ch == '`' {
+				d.lexBtQuoted = true
+				continue
+			}
+		}
+
+		if d.lexEscaped {
+			if ch == '<' {
+				d.lexHeredocEscaped = true
+			} else {
+				d.lexVal = append(d.lexVal, '\\')
+			}
+			d.lexEscaped = false
+		}
+
+		d.lexVal = append(d.lexVal, ch)
+	}
+}
+
+func (d *Dispenser) consumeLexerHeredoc(ch rune) (bool, error) {
+	d.lexVal = append(d.lexVal, ch)
+	if ch == '\n' {
+		d.lexSkippedLines++
+	}
+	marker := d.lexHeredocMarker
+	if len(d.lexVal) > len(marker) && marker == string(d.lexVal[len(d.lexVal)-len(marker):]) {
+		val, err := d.finalizeLexerHeredoc(d.lexVal, marker)
+		if err != nil {
+			return false, err
+		}
+		d.lexVal = val
+		d.lexLine += d.lexSkippedLines
+		d.lexSkippedLines = 0
+		return true, nil
+	}
+	return false, nil
+}
+
+func (d *Dispenser) finishLexerQuoted(ch rune) bool {
+	if d.lexQuoted && d.lexEscaped {
+		if ch != '"' {
+			d.lexVal = append(d.lexVal, '\\')
+		}
+		d.lexEscaped = false
+	} else if (d.lexQuoted && ch == '"') || (d.lexBtQuoted && ch == '`') {
+		return true
+	}
+	if ch == '\n' {
+		d.lexLine += 1 + d.lexSkippedLines
+		d.lexSkippedLines = 0
+	}
+	d.lexVal = append(d.lexVal, ch)
+	return false
+}
+
+func (d *Dispenser) consumeLexerSpace(ch rune) bool {
+	if ch == '\r' {
+		return false
+	}
+	if ch == '\n' {
+		if d.lexEscaped {
+			d.lexSkippedLines++
+			d.lexEscaped = false
+		} else {
+			d.lexLine += 1 + d.lexSkippedLines
+			d.lexSkippedLines = 0
+		}
+		d.lexComment = false
+	}
+	return len(d.lexVal) > 0
+}
+
+func (d *Dispenser) finalizeLexerHeredoc(val []rune, marker string) ([]rune, error) {
+	stringVal := string(val)
+	lastNewline := strings.LastIndex(stringVal, "\n")
+	lines := strings.Split(stringVal[:lastNewline+1], "\n")
+	paddingToStrip := stringVal[lastNewline+1 : len(stringVal)-len(marker)]
+
+	var out string
+	for lineNum, lineText := range lines[:len(lines)-1] {
+		index := strings.Index(lineText, paddingToStrip)
+		if index != 0 {
+			return nil, fmt.Errorf("mismatched leading whitespace in heredoc <<%s on line #%d [%s], expected whitespace [%s] to match the closing marker", marker, d.lexLine+lineNum+1, lineText, paddingToStrip)
+		}
+		out += strings.ReplaceAll(lineText[len(paddingToStrip):]+"\n", "\r", "")
+	}
+	if len(out) > 0 && out[len(out)-1] == '\n' {
+		out = out[:len(out)-1]
+	}
+	return []rune(out), nil
+}
+
+func (d *Dispenser) formatCaddyfile(input []byte) []byte {
+	d.resetFormatter()
+	input = bytes.TrimSpace(input)
+	rdr := bytes.NewReader(input)
+
+	for {
+		ch, _, err := rdr.ReadRune()
+		if err != nil {
+			if err == io.EOF {
+				break
+			}
+			panic(err)
+		}
+		if d.fmtComment {
+			d.formatCommentRune(ch)
+			continue
+		}
+		if d.formatEscapeRune(ch) {
+			continue
+		}
+		if d.fmtQuoted {
+			d.formatQuotedRune(ch)
+			continue
+		}
+		if d.fmtSpace && ch == '"' {
+			d.fmtQuoted = true
+		}
+		if unicode.IsSpace(ch) {
+			d.fmtSpace = true
+			if ch == '\n' {
+				d.fmtNewLines++
+			}
+			continue
+		}
+		spacePrior := d.fmtSpace
+		d.fmtSpace = false
+		if ch == '#' {
+			d.fmtComment = true
+		}
+		if d.fmtOpenBrace && spacePrior && !d.fmtOpenBraceWritten {
+			d.flushPendingOpenBrace()
+		}
+		if d.formatSpecialRune(ch, spacePrior) {
+			continue
+		}
+		d.writeFormattedWord(ch, spacePrior)
+	}
+	return d.finishFormatted()
+}
+
+func (d *Dispenser) resetFormatter() {
+	d.fmtOut = new(bytes.Buffer)
+	d.fmtLast = 0
+	d.fmtSpace = true
+	d.fmtBeginningOfLine = true
+	d.fmtOpenBrace = false
+	d.fmtOpenBraceWritten = false
+	d.fmtOpenBraceSpace = false
+	d.fmtNewLines = 0
+	d.fmtComment = false
+	d.fmtQuoted = false
+	d.fmtEscaped = false
+	d.fmtNesting = 0
+}
+
+func (d *Dispenser) fmtWrite(ch rune) {
+	d.fmtOut.WriteRune(ch)
+	d.fmtLast = ch
+}
+
+func (d *Dispenser) fmtIndent() {
+	for tabs := d.fmtNesting; tabs > 0; tabs-- {
+		d.fmtWrite('\t')
+	}
+}
+
+func (d *Dispenser) fmtNextLine() {
+	d.fmtWrite('\n')
+	d.fmtBeginningOfLine = true
+}
+
+func (d *Dispenser) formatCommentRune(ch rune) {
+	if ch == '\n' {
+		d.fmtComment = false
+		d.fmtSpace = true
+		d.fmtNextLine()
+		return
+	}
+	d.fmtWrite(ch)
+}
+
+func (d *Dispenser) formatEscapeRune(ch rune) bool {
+	if !d.fmtEscaped && ch == '\\' {
+		if d.fmtSpace {
+			d.fmtWrite(' ')
+			d.fmtSpace = false
+		}
+		d.fmtWrite(ch)
+		d.fmtEscaped = true
+		return true
+	}
+	if d.fmtEscaped {
+		d.fmtWrite(ch)
+		d.fmtEscaped = false
+		return true
+	}
+	return false
+}
+
+func (d *Dispenser) formatQuotedRune(ch rune) {
+	if ch == '"' {
+		d.fmtQuoted = false
+	}
+	d.fmtWrite(ch)
+}
+
+func (d *Dispenser) flushPendingOpenBrace() {
+	if d.fmtNesting == 0 && d.fmtLast == '}' {
+		d.fmtNextLine()
+		d.fmtNextLine()
+	}
+	d.fmtOpenBrace = false
+	if d.fmtBeginningOfLine {
+		d.fmtIndent()
+	} else if !d.fmtOpenBraceSpace {
+		d.fmtWrite(' ')
+	}
+	d.fmtWrite('{')
+	d.fmtOpenBraceWritten = true
+	d.fmtNextLine()
+	d.fmtNewLines = 0
+	if d.fmtNesting < 10 {
+		d.fmtNesting++
+	}
+}
+
+func (d *Dispenser) formatSpecialRune(ch rune, spacePrior bool) bool {
+	if ch == '{' {
+		d.fmtOpenBrace = true
+		d.fmtOpenBraceWritten = false
+		d.fmtOpenBraceSpace = spacePrior && !d.fmtBeginningOfLine
+		if d.fmtOpenBraceSpace {
+			d.fmtWrite(' ')
+		}
+		return true
+	}
+	if ch == '}' && (spacePrior || !d.fmtOpenBrace) {
+		if d.fmtLast != '\n' {
+			d.fmtNextLine()
+		}
+		if d.fmtNesting > 0 {
+			d.fmtNesting--
+		}
+		d.fmtIndent()
+		d.fmtWrite('}')
+		d.fmtNewLines = 0
+		return true
+	}
+	return false
+}
+
+func (d *Dispenser) writeFormattedWord(ch rune, spacePrior bool) {
+	if d.fmtNewLines > 2 {
+		d.fmtNewLines = 2
+	}
+	for i := 0; i < d.fmtNewLines; i++ {
+		d.fmtNextLine()
+	}
+	d.fmtNewLines = 0
+	if d.fmtBeginningOfLine {
+		d.fmtIndent()
+	}
+	if d.fmtNesting == 0 && d.fmtLast == '}' && d.fmtBeginningOfLine {
+		d.fmtNextLine()
+		d.fmtNextLine()
+	}
+	if !d.fmtBeginningOfLine && spacePrior {
+		d.fmtWrite(' ')
+	}
+	if d.fmtOpenBrace && !d.fmtOpenBraceWritten {
+		d.fmtWrite('{')
+		d.fmtOpenBraceWritten = true
+	}
+	d.fmtWrite(ch)
+	d.fmtBeginningOfLine = false
+}
+
+func (d *Dispenser) finishFormatted() []byte {
+	trimmedResult := bytes.TrimSpace(d.fmtOut.Bytes())
+	return append(trimmedResult, '\n')
+}
