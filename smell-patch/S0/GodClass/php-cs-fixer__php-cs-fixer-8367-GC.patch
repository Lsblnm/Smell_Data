+    /**
+     * Count amount of parameters in a function/method reference.
+     */
+    public function countCallArguments(Tokens $tokens, int $openParenthesis, int $closeParenthesis): int
+    {
+        $this->argumentScanState['open'] = $openParenthesis;
+        $this->argumentScanState['close'] = $closeParenthesis;
