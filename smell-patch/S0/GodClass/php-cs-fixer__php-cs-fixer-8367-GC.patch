+     * @return array<int, int>
+     */
+    public function collectCallArguments(Tokens $tokens, int $openParenthesis, int $closeParenthesis): array
+    {
+        $this->argumentScanState['open'] = $openParenthesis;
+        $this->argumentScanState['close'] = $closeParenthesis;
+        $this->argumentScanState['tokensHash'] = $tokens->getCodeHash();
+        $arguments = [];
+        $firstSensibleToken = $tokens->getNextMeaningfulToken($openParenthesis);
