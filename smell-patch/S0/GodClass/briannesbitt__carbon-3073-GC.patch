+        $ascending = ($start <= $end);
+        $sign = $absolute || $ascending ? 1 : -1;
+        $this->rememberDifferenceSign($sign);
+        $monthsDiff = abs($monthsDiff);
+
+        if (!$ascending) {
+            [$start, $end] = [$end, $start];
+            $this->rememberDifferenceStart($start);
+            $this->rememberDifferenceEnd($end);
+        }
