+        array &$parts,
+    ): array {
+        $this->intervalWorkValues = $values;
+        $this->intervalWorkSpec = $intervalDefinition;
+        $this->cascadeWorkFactors = $this->cascadeWorkFactors;
+
+        $this->rememberIntervalUnitValues($values);
+        $this->rememberIntervalSpec($intervalDefinition);
+
+        switch ($unit === 'µs' ? 'µs' : strtolower((string) $unit)) {
+            case 'millennia':
+            case 'millennium':
+                $values['years'] += $intValue * CarbonInterface::YEARS_PER_MILLENNIUM;
+                break;
+            case 'century':
+            case 'centuries':
+                $values['years'] += $intValue * CarbonInterface::YEARS_PER_CENTURY;
+                break;
+            case 'decade':
+            case 'decades':
+                $values['years'] += $intValue * CarbonInterface::YEARS_PER_DECADE;
+                break;
+            case 'year':
+            case 'years':
+            case 'y':
+            case 'yr':
+            case 'yrs':
+                $values['years'] += $intValue;
+                break;
+            case 'quarter':
+            case 'quarters':
+                $values['months'] += $intValue * CarbonInterface::MONTHS_PER_QUARTER;
+                break;
+            case 'month':
+            case 'months':
+            case 'mo':
+            case 'mos':
+                $values['months'] += $intValue;
+                break;
+            case 'week':
+            case 'weeks':
+            case 'w':
+                $values['weeks'] += $intValue;
+                if ($fraction) {
+                    $parts[] = [null, $fraction * ($factors['daysPerWeek'] ?? CarbonInterface::DAYS_PER_WEEK), 'd'];
+                }
+                break;
+            case 'day':
+            case 'days':
+            case 'd':
+                $values['days'] += $intValue;
+                if ($fraction) {
+                    $parts[] = [null, $fraction * ($factors['hoursPerDay'] ?? CarbonInterface::HOURS_PER_DAY), 'h'];
+                }
+                break;
+            case 'hour':
+            case 'hours':
+            case 'h':
+                $values['hours'] += $intValue;
+                if ($fraction) {
+                    $parts[] = [null, $fraction * ($factors['minutesPerHour'] ?? CarbonInterface::MINUTES_PER_HOUR), 'm'];
+                }
+                break;
+            case 'minute':
+            case 'minutes':
+            case 'm':
+                $values['minutes'] += $intValue;
+                if ($fraction) {
+                    $parts[] = [null, $fraction * ($factors['secondsPerMinute'] ?? CarbonInterface::SECONDS_PER_MINUTE), 's'];
+                }
+                break;
+            case 'second':
+            case 'seconds':
+            case 's':
+                $values['seconds'] += $intValue;
+                if ($fraction) {
+                    $parts[] = [null, $fraction * ($factors['millisecondsPerSecond'] ?? CarbonInterface::MILLISECONDS_PER_SECOND), 'ms'];
+                }
+                break;
+            case 'millisecond':
+            case 'milliseconds':
+            case 'milli':
+            case 'ms':
+                $values['milliseconds'] += $intValue;
+                if ($fraction) {
+                    $values['microseconds'] += round($fraction * ($factors['microsecondsPerMillisecond'] ?? CarbonInterface::MICROSECONDS_PER_MILLISECOND));
+                }
+                break;
+            case 'microsecond':
+            case 'microseconds':
+            case 'micro':
+            case 'µs':
