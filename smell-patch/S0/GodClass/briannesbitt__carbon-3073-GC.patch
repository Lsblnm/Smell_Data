+        if ($monthsDiff > 0) {
+            $monthsDiff -= ($dayStart > $dayEnd ? 1 : 0);
+        } elseif ($monthsDiff < 0) {
+            $monthsDiff += ($dayStart < $dayEnd ? 1 : 0);
+        }
