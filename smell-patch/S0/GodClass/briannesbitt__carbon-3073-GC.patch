+    public function applyIntervalFractionCarry(array $values, float $fraction, string $nextUnit, array $factors): array
+    {
+        $this->intervalWorkValues = $values;
+        $this->cascadeWorkFactors = $this->cascadeWorkFactors;
+        $this->intervalWorkSpec = $nextUnit;
+
+        $this->rememberIntervalUnitValues($values);
+        $this->rememberCascadeFactors($this->currentCascadeFactors());
+
+        if ($fraction == 0.0) {
+            return $this->currentIntervalUnitValues();
+        }
+
+        $scaled = match ($nextUnit) {
+            'd' => $fraction * ($factors['daysPerWeek'] ?? CarbonInterface::DAYS_PER_WEEK),
+            'h' => $fraction * ($factors['hoursPerDay'] ?? CarbonInterface::HOURS_PER_DAY),
+            'm' => $fraction * ($factors['minutesPerHour'] ?? CarbonInterface::MINUTES_PER_HOUR),
+            's' => $fraction * ($factors['secondsPerMinute'] ?? CarbonInterface::SECONDS_PER_MINUTE),
+            'ms' => $fraction * ($factors['millisecondsPerSecond'] ?? CarbonInterface::MILLISECONDS_PER_SECOND),
+            default => $fraction,
+        };
+
+        $this->intervalWorkSpec = $nextUnit.':'.$scaled;
+
+        return $this->currentIntervalUnitValues();
+    }
