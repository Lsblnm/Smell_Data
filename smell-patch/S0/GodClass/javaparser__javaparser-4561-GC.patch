+
+    private Context buildContextFromNode() {
+        Node node = this.contextNode;
+        TypeSolver typeSolver = this.contextTypeSolver;
+        if (node == null) {
+            throw new NullPointerException("Node should not be null");
+        }
+        if (node instanceof ArrayAccessExpr) {
+            return contextForArrayAccess();
+        }
+        if (node instanceof AnnotationDeclaration) {
+            return contextForAnnotationDeclaration();
+        }
+        if (node instanceof BinaryExpr) {
+            return contextForBinaryExpr();
+        }
+        if (node instanceof BlockStmt) {
+            return contextForBlockStmt();
+        }
+        if (node instanceof CompilationUnit) {
+            return contextForCompilationUnit();
+        }
+        if (node instanceof EnclosedExpr) {
+            return contextForEnclosedExpr();
+        }
+        if (node instanceof ForEachStmt) {
+            return contextForForEachStmt();
+        }
+        if (node instanceof ForStmt) {
+            return contextForForStmt();
+        }
+        if (node instanceof IfStmt) {
+            return contextForIfStmt();
+        }
+        if (node instanceof WhileStmt) {
+            return contextForWhileStmt();
+        }
+        if (node instanceof DoStmt) {
+            return contextForDoStmt();
+        }
+        if (node instanceof InstanceOfExpr) {
+            return contextForInstanceOfExpr();
+        }
+        if (node instanceof LambdaExpr) {
+            return contextForLambdaExpr();
+        }
+        if (node instanceof MethodDeclaration) {
+            return contextForMethodDeclaration();
+        }
+        if (node instanceof ConstructorDeclaration) {
+            return contextForConstructorDeclaration();
+        }
+        if (node instanceof ClassOrInterfaceDeclaration) {
+            return contextForClassOrInterfaceDeclaration();
+        }
+        if (node instanceof MethodCallExpr) {
+            return contextForMethodCallExpr();
+        }
+        if (node instanceof MethodReferenceExpr) {
+            return contextForMethodReferenceExpr();
+        }
+        if (node instanceof EnumDeclaration) {
+            return contextForEnumDeclaration();
+        }
+        if (node instanceof RecordDeclaration) {
+            return contextForRecordDeclaration();
+        }
+        if (node instanceof FieldAccessExpr) {
+            return contextForFieldAccessExpr();
+        }
+        if (node instanceof SwitchEntry) {
+            return contextForSwitchEntry();
+        }
+        if (node instanceof TryStmt) {
+            return contextForTryStmt();
+        }
+        if (node instanceof Statement) {
+            return contextForStatement();
+        }
+        if (node instanceof CatchClause) {
+            return contextForCatchClause();
+        }
+        if (node instanceof UnaryExpr) {
+            return contextForUnaryExpr();
+        }
+        if (node instanceof VariableDeclarator) {
+            return contextForVariableDeclarator();
+        }
+        if (node instanceof VariableDeclarationExpr) {
+            return contextForVariableDeclarationExpr();
+        }
+        if (node instanceof ObjectCreationExpr
+                && ((ObjectCreationExpr) node).getAnonymousClassBody().isPresent()) {
+            return contextForAnonymousObjectCreation();
+        }
+        if (node instanceof ObjectCreationExpr) {
+            return contextForObjectCreation();
+        }
+        if (node instanceof ConditionalExpr) {
+            return contextForConditionalExpr();
+        }
+        if (node instanceof NameExpr) {
+            return contextForNameExpr();
+        }
+        final Node parentNode = demandParentNode(node);
+        if (node instanceof ClassOrInterfaceType && parentNode instanceof ClassOrInterfaceDeclaration) {
+            return contextForClassOrInterfaceType((ClassOrInterfaceDeclaration) parentNode);
+        }
+        return new TypeExtractor().buildContext(parentNode, typeSolver);
+    }
