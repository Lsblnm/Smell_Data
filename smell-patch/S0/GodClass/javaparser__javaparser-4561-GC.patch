+    public String containerNameOf(Node container) {
+        this.astContainer = container;
+        String packageName = packageNameOf(container);
+        String className = classNameOf("", container);
+        return packageName + ((!packageName.isEmpty() && !className.isEmpty()) ? "." : "") + className;
+    }
+
+    public String packageNameOf(Node container) {
+        this.astContainer = container;
+        String packageName = "";
+        if (container == null) {
+            return packageName;
+        }
+        Optional<CompilationUnit> cu = container.findCompilationUnit();
+        if (cu.isPresent()) {
+            packageName = cu.get()
+                    .getPackageDeclaration()
+                    .map(pd -> pd.getNameAsString())
+                    .orElse("");
+        }
+        return packageName;
+    }
+
+    public String classNameOf(String base, Node container) {
+        this.astNameBase = base;
