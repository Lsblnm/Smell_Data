+    public ResolvedType resolveNumericConditional(ResolvedType thenExpr, ResolvedType elseExpr) {
+        this.numericThenType = thenExpr;
+        this.numericElseType = elseExpr;
+        prepareNumericConverter();
+        return resolveNumericConditionalType();
+    }
+
+    private void prepareNumericConverter() {
+        this.numericConverter = new HashMap<>();
+        this.numericConverter.put(
+                ResolvedPrimitiveType.SHORT, Arrays.asList(ResolvedPrimitiveType.SHORT, ResolvedPrimitiveType.BYTE));
+        this.numericPrimitiveSubList = new ResolvedPrimitiveType[] {
+            ResolvedPrimitiveType.BYTE, ResolvedPrimitiveType.SHORT, ResolvedPrimitiveType.CHAR
+        };
+    }
+
+    private ResolvedType resolveNumericConditionalType() {
+        ResolvedType thenExpr = this.numericThenType;
+        ResolvedType elseExpr = this.numericElseType;
+        String qnameTypeThenExpr = thenExpr.isPrimitive()
+                ? thenExpr.asPrimitive().describe()
+                : thenExpr.asReferenceType().describe();
+        String qnameTypeElseExpr = elseExpr.isPrimitive()
+                ? elseExpr.asPrimitive().describe()
+                : elseExpr.asReferenceType().describe();
+        if (qnameTypeThenExpr.equals(qnameTypeElseExpr)) {
+            return thenExpr;
+        }
+        if (thenExpr.isPrimitive()
+                && elseExpr.isReferenceType()
+                && elseExpr.asReferenceType()
+                        .isUnboxableTo((ResolvedPrimitiveType) ResolvedPrimitiveType.byName(qnameTypeThenExpr))) {
+            return thenExpr;
+        }
+        if (elseExpr.isPrimitive()
+                && thenExpr.isReferenceType()
+                && thenExpr.asReferenceType()
+                        .isUnboxableTo((ResolvedPrimitiveType) ResolvedPrimitiveType.byName(qnameTypeElseExpr))) {
+            return elseExpr;
+        }
+        if ((isResolvableToNumeric(ResolvedPrimitiveType.SHORT, thenExpr)
+                        && relaxNumericMatch(elseExpr, ResolvedPrimitiveType.BYTE))
+                || (isResolvableToNumeric(ResolvedPrimitiveType.SHORT, elseExpr)
+                        && relaxNumericMatch(thenExpr, ResolvedPrimitiveType.BYTE))) {
+            return ResolvedPrimitiveType.SHORT;
+        }
+        if (thenExpr.isPrimitive() && elseExpr.isPrimitive()) {
+            if (((ResolvedPrimitiveType) thenExpr).in(this.numericPrimitiveSubList)
+                    && ((ResolvedPrimitiveType) elseExpr).equals(ResolvedPrimitiveType.INT)) {
+                return thenExpr;
+            }
+            if (((ResolvedPrimitiveType) elseExpr).in(this.numericPrimitiveSubList)
+                    && ((ResolvedPrimitiveType) thenExpr).equals(ResolvedPrimitiveType.INT)) {
+                return elseExpr;
+            }
+        }
+        if (thenExpr.isReference()
+                && elseExpr.isPrimitive()
+                && thenExpr.asReferenceType().isUnboxable()
+                && thenExpr.asReferenceType().toUnboxedType().get().in(this.numericPrimitiveSubList)
+                && ((ResolvedPrimitiveType) elseExpr).equals(ResolvedPrimitiveType.INT)) {
+            return thenExpr.asReferenceType().toUnboxedType().get();
+        }
+        if (elseExpr.isReference()
+                && thenExpr.isPrimitive()
+                && elseExpr.asReferenceType().isUnboxable()
+                && elseExpr.asReferenceType().toUnboxedType().get().in(this.numericPrimitiveSubList)
+                && ((ResolvedPrimitiveType) thenExpr).equals(ResolvedPrimitiveType.INT)) {
+            return elseExpr.asReferenceType().toUnboxedType().get();
+        }
+        ResolvedPrimitiveType primitiveThenExpr = thenExpr.isPrimitive()
+                ? thenExpr.asPrimitive()
+                : thenExpr.asReferenceType().toUnboxedType().get();
+        ResolvedPrimitiveType primitiveElseExpr = elseExpr.isPrimitive()
+                ? elseExpr.asPrimitive()
+                : elseExpr.asReferenceType().toUnboxedType().get();
+        return primitiveThenExpr.bnp(primitiveElseExpr);
+    }
+
+    private boolean exactNumericMatch(ResolvedType type, ResolvedPrimitiveType... types) {
+        return type.isPrimitive() && type.asPrimitive().in(types);
+    }
+
+    private boolean relaxNumericMatch(ResolvedType type, ResolvedPrimitiveType... types) {
+        return exactNumericMatch(type, types)
+                || (type.isReferenceType()
+                        && Arrays.stream(types).anyMatch(t -> type.asReferenceType()
+                                .getQualifiedName()
+                                .equals(t.getBoxTypeQName())));
+    }
+
+    private boolean isResolvableToNumeric(ResolvedPrimitiveType toType, ResolvedType resolvedType) {
+        return isResolvableToNumeric(toType, resolvedType, true);
+    }
+
+    private boolean isResolvableToNumeric(
+            ResolvedPrimitiveType toType, ResolvedType resolvedType, boolean verifyBoxedType) {
+        return this.numericConverter.entrySet().stream()
+                .filter(e -> e.getKey() == toType)
+                .flatMap(entry -> entry.getValue().stream())
+                .anyMatch(rt -> rt == resolvedType
+                        || (verifyBoxedType
+                                && resolvedType.isReferenceType()
+                                && resolvedType
+                                                .asReferenceType()
+                                                .toUnboxedType()
+                                                .get()
+                                        == toType));
+    }
+
+    public RuntimeException handleFailure(Throwable th) {
+        return handleFailure(th, null);
+    }
+
+    public RuntimeException handleFailure(Throwable th, String message) {
+        prepareFailureConverter();
+        Function<Throwable, ? extends RuntimeException> converter =
+                this.failureConverter.get(findRootCause(th).getClass());
+        if (converter != null) {
+            return converter.apply(th);
+        }
+        if (RuntimeException.class.isAssignableFrom(th.getClass())) {
+            return (RuntimeException) th;
+        }
+        return runtimeExceptionFrom(findRootCause(th), message);
+    }
+
+    private void prepareFailureConverter() {
+        if (this.failureConverter == null) {
+            this.failureConverter = new HashMap<>();
+            this.failureConverter.put(UnsolvedSymbolException.class, (Throwable th) -> (RuntimeException) th);
+        }
+    }
+
+    private <E extends Throwable> E findRootCause(Throwable failure) {
+        if (this.failureConverter == null) {
+            prepareFailureConverter();
+        }
+        while (failure != null) {
+            if (isRootCause(failure)) {
+                return (E) failure;
+            }
+            failure = failure.getCause();
+        }
+        return null;
+    }
+
+    private boolean isRootCause(Throwable th) {
+        if (this.failureConverter == null) {
+            prepareFailureConverter();
+        }
+        return th.getCause() == null;
+    }
+
+    private RuntimeException runtimeExceptionFrom(Throwable th, String message) {
+        if (this.failureConverter == null) {
+            prepareFailureConverter();
+        }
+        if (message == null || message.isEmpty()) {
+            return new RuntimeException(findRootCause(th));
+        }
+        return new RuntimeException(message, findRootCause(th));
+    }
