+    private Context contextForClassOrInterfaceType(ClassOrInterfaceDeclaration parentDeclaration) {
+        Node node = this.contextNode;
+        TypeSolver typeSolver = this.contextTypeSolver;
+        if (parentDeclaration.getImplementedTypes().contains(node)
+                || parentDeclaration.getExtendedTypes().contains(node)) {
+            return new ClassOrInterfaceDeclarationExtendsContext(parentDeclaration, typeSolver);
+        }
+        return new TypeExtractor().buildContext(parentDeclaration, typeSolver);
+    }
