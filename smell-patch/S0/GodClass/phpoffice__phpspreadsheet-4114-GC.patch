+    public function storeCustomDocumentProperty(string $propertyName, bool|int|float|string|null $propertyValue = '', ?string $propertyType = null): void
+    {
+        $validTypes = [
+            Properties::PROPERTY_TYPE_BOOLEAN,
+            Properties::PROPERTY_TYPE_INTEGER,
+            Properties::PROPERTY_TYPE_FLOAT,
+            Properties::PROPERTY_TYPE_DATE,
+            Properties::PROPERTY_TYPE_STRING,
+        ];
+        if ($propertyType === null || !in_array($propertyType, $validTypes, true)) {
+            $propertyType = $this->identifyDocumentPropertyType($propertyValue);
+        }
+        $converted = $this->convertDocumentProperty($propertyValue, $propertyType);
+        $this->workbookCoordinationState['properties']['custom'][$propertyName] = [
+            'type' => $propertyType,
+            'converted' => $converted,
+        ];
+        $this->properties->putCustomProperty($propertyName, $converted, $propertyType);
+    }
