+    public function applyWorksheetCodeName(Worksheet $worksheet, string $codeName, bool $validate = true): Worksheet
+    {
+        $this->workbookCoordinationState['sheet']['codeName'] = [
+            'requested' => $codeName,
+            'validate' => $validate,
+            'current' => $worksheet->getCodeName(),
+        ];
+        if ($worksheet->getCodeName() == $codeName) {
+            return $worksheet;
+        }
+
+        if ($validate) {
+            $codeName = str_replace(' ', '_', $codeName);
+            $worksheet->assertValidCodeName($codeName);
+            if ($this->sheetCodeNameExists($codeName)) {
+                if (StringHelper::countCharacters($codeName) > 29) {
+                    $codeName = StringHelper::substring($codeName, 0, 29);
+                }
+                $i = 1;
+                while ($this->sheetCodeNameExists($codeName . '_' . $i)) {
+                    ++$i;
+                    if ($i == 10) {
+                        if (StringHelper::countCharacters($codeName) > 28) {
+                            $codeName = StringHelper::substring($codeName, 0, 28);
+                        }
+                    } elseif ($i == 100) {
+                        if (StringHelper::countCharacters($codeName) > 27) {
+                            $codeName = StringHelper::substring($codeName, 0, 27);
+                        }
+                    }
+                }
+                $codeName .= '_' . $i;
+            }
+        }
+
+        $this->workbookCoordinationState['sheet']['codeNameApplied'] = $codeName;
+        $worksheet->writeCodeNameValue($codeName);
+
+        return $worksheet;
+    }
