+    public function assignExplicitCellValue(Cell $cell, mixed $value, string $dataType): Cell
+    {
+        $this->workbookCoordinationState['cell']['assign'] = [
+            'coordinate' => $cell->getCoordinate(),
+            'dataType' => $dataType,
+        ];
+        $worksheet = $cell->getWorksheetOrNull();
+        if ($worksheet !== null) {
+            foreach ($this->workSheetCollection as $index => $sheet) {
+                if ($sheet === $worksheet) {
+                    $this->workbookCoordinationState['cell']['sheetIndex'] = $index;
+                    break;
+                }
+            }
+        }
+
+        $oldValue = $cell->getValue();
+        $quotePrefix = false;
+        $assignedValue = $value;
+
+        switch ($dataType) {
+            case 'null':
+                $assignedValue = null;
+
+                break;
+            case 'str':
+                $dataType = 's';
+                // no break
+            case 's':
+                if (is_string($value) && strlen($value) > 1 && $value[0] === '=') {
+                    $quotePrefix = true;
+                }
+                // no break
+            case 'inlineStr':
+                if ($value !== null && !is_scalar($value) && !($value instanceof Stringable)) {
+                    throw new Exception('Invalid unstringable value for datatype Inline/String/String2');
+                }
+                $assignedValue = $cell->sanitizeAssignedString($value);
+
+                break;
+            case 'n':
+                if (is_string($value) && !is_numeric($value)) {
+                    throw new Exception('Invalid numeric value for datatype Numeric');
+                }
+                $assignedValue = 0 + $value;
+
+                break;
+            case 'f':
+                if ($value !== null && !is_scalar($value) && !($value instanceof Stringable)) {
+                    throw new Exception('Invalid unstringable value for datatype Formula');
+                }
+                $assignedValue = (string) $value;
+
+                break;
+            case 'b':
+                $assignedValue = (bool) $value;
+
+                break;
+            case 'd':
+                $assignedValue = $cell->convertIsoDateValue($value);
+                $dataType = 'n';
+
+                break;
+            case 'e':
+                $assignedValue = $cell->sanitizeAssignedError($value);
+
+                break;
+            default:
+                throw new Exception('Invalid datatype: ' . $dataType);
+        }
+
+        $cell->installExplicitValue($assignedValue, $dataType);
+        $cellCoordinate = $cell->getCoordinate();
+        $cell->notifyTableHeaderChange($oldValue, $value);
+        $cell->getWorksheet()->applyStylesFromArray($cellCoordinate, ['quotePrefix' => $quotePrefix]);
+
+        return $cell->getParent()?->get($cellCoordinate) ?? $cell;
+    }
