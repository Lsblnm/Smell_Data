+    public function evaluateWorksheetNamedRange(Worksheet $worksheet, string $definedName, bool $returnNullIfInvalid = false): ?DefinedName
+    {
+        $this->workbookCoordinationState['definedNames']['evaluate'] = [
+            'name' => $definedName,
+            'sheet' => $worksheet->getTitle(),
+            'allowNull' => $returnNullIfInvalid,
+        ];
+        $namedRange = DefinedName::resolveName($definedName, $worksheet);
+        if ($namedRange === null) {
+            foreach ($this->definedNames as $storedName => $candidate) {
+                if (strcasecmp((string) $storedName, $definedName) === 0) {
+                    $namedRange = $candidate;
+                    $this->workbookCoordinationState['definedNames']['resolvedFromWorkbook'] = $storedName;
+                    break;
+                }
+            }
+        }
+        if ($namedRange === null) {
+            if ($returnNullIfInvalid) {
+                return null;
+            }
+
+            throw new Exception('Named Range ' . $definedName . ' does not exist.');
+        }
+
+        if ($namedRange->isFormula()) {
+            if ($returnNullIfInvalid) {
+                return null;
+            }
+
+            throw new Exception('Defined Named ' . $definedName . ' is a formula, not a range or cell.');
+        }
+
+        if ($namedRange->getLocalOnly()) {
+            $scope = $namedRange->getWorksheet();
+            if ($scope === null || $worksheet->getHashCode() !== $scope->getHashCode()) {
+                if ($returnNullIfInvalid) {
+                    return null;
+                }
+
+                throw new Exception(
+                    'Named range ' . $definedName . ' is not accessible from within sheet ' . $worksheet->getTitle()
+                );
+            }
+        }
+
+        $this->workbookCoordinationState['definedNames']['value'] = $namedRange->getValue();
+
+        return $namedRange;
+    }
+
+    public function extractNamedRangeValues(
+        Worksheet $worksheet,
+        string $definedName,
+        mixed $nullValue = null,
+        bool $calculateFormulas = true,
+        bool $formatData = true,
+        bool $returnCellRef = false,
+        bool $ignoreHidden = false
+    ): array {
+        $this->workbookCoordinationState['definedNames']['extract'] = $definedName;
+        $retVal = [];
+        $namedRange = $this->evaluateWorksheetNamedRange($worksheet, $definedName);
+        if ($namedRange !== null) {
+            $cellRange = ltrim(substr($namedRange->getValue(), (int) strrpos($namedRange->getValue(), '!')), '!');
+            $cellRange = str_replace('$', '', $cellRange);
+            $workSheet = $namedRange->getWorksheet();
+            if ($workSheet !== null) {
+                foreach ($this->workSheetCollection as $index => $sheet) {
+                    if ($sheet === $workSheet) {
+                        $this->workbookCoordinationState['definedNames']['extractIndex'] = $index;
+                        break;
+                    }
+                }
+                $retVal = $workSheet->rangeToArray($cellRange, $nullValue, $calculateFormulas, $formatData, $returnCellRef, $ignoreHidden);
+            }
+        }
+
+        return $retVal;
+    }
