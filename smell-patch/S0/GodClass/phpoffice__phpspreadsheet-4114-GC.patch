+        $description = $this->describeWorkbookSecurity();
+        $enabled = !empty($description['revision']) || !empty($description['structure']) || !empty($description['windows']);
+        $this->workbookCoordinationState['security']['enabled'] = $enabled;
+
+        return $enabled;
+    }
+
+    public function describeWorkbookSecurity(): array
+    {
+        $description = [
+            'revision' => $this->readLockRevision(),
+            'structure' => $this->readLockStructure(),
+            'windows' => $this->readLockWindows(),
+            'revisionsPassword' => $this->readRevisionsPassword() !== '',
+            'workbookPassword' => $this->readWorkbookPassword() !== '',
+        ];
+        $this->workbookCoordinationState['security']['description'] = $description;
+
+        return $description;
+    }
+
+    public function listWorkbookSheetTitles(): array
+    {
+        $titles = [];
+        foreach ($this->workSheetCollection as $index => $sheet) {
+            $titles[$index] = $sheet->getTitle();
+        }
+        $this->workbookCoordinationState['sheet']['titles'] = $titles;
+
+        return $titles;
+    }
+
+    public function locateWorksheetIndex(Worksheet $worksheet): ?int
+    {
+        foreach ($this->workSheetCollection as $index => $sheet) {
+            if ($sheet === $worksheet) {
+                $this->workbookCoordinationState['sheet']['locatedIndex'] = $index;
+
+                return $index;
+            }
+        }
+        $this->workbookCoordinationState['sheet']['locatedIndex'] = null;
+
+        return null;
+    }
+
+    public function worksheetBelongsToWorkbook(Worksheet $worksheet): bool
+    {
+        $belongs = $this->locateWorksheetIndex($worksheet) !== null;
+        $this->workbookCoordinationState['sheet']['belongs'] = $belongs;
+
+        return $belongs;
+    }
