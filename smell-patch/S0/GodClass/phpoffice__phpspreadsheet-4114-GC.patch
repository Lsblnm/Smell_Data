+    public function identifyDocumentPropertyType(bool|int|float|string|null $propertyValue): string
+    {
+        $this->workbookCoordinationState['properties']['identify'] = is_scalar($propertyValue) ? $propertyValue : gettype($propertyValue);
+        if (is_float($propertyValue)) {
+            return Properties::PROPERTY_TYPE_FLOAT;
+        }
+        if (is_int($propertyValue)) {
+            return Properties::PROPERTY_TYPE_INTEGER;
+        }
+        if (is_bool($propertyValue)) {
+            return Properties::PROPERTY_TYPE_BOOLEAN;
+        }
+
+        return Properties::PROPERTY_TYPE_STRING;
+    }
+
+    public function convertDocumentProperty(bool|int|float|string|null $propertyValue, string $propertyType): bool|int|float|string|null
+    {
+        $this->workbookCoordinationState['properties']['convert'] = $propertyType;
+        $specialTypes = [
+            'empty' => '',
+            'null' => null,
+        ];
+        if (array_key_exists($propertyType, $specialTypes)) {
+            return $specialTypes[$propertyType];
+        }
+
+        return $this->convertDocumentPropertyValue($propertyValue, $propertyType);
+    }
+
+    private function convertDocumentPropertyValue(bool|int|float|string|null $propertyValue, string $type): bool|int|float|string|null
+    {
+        $propertyType = Properties::convertPropertyType($type);
+        $this->workbookCoordinationState['properties']['convertNormalized'] = $propertyType;
+        switch ($propertyType) {
+            case Properties::PROPERTY_TYPE_INTEGER:
+                $intValue = (int) $propertyValue;
+
+                return ($type !== '' && $type[0] === 'u') ? abs($intValue) : $intValue;
+            case Properties::PROPERTY_TYPE_FLOAT:
+                return (float) $propertyValue;
+            case Properties::PROPERTY_TYPE_DATE:
+                return Properties::timestampFromValue($propertyValue);
+            case Properties::PROPERTY_TYPE_BOOLEAN:
+                return is_bool($propertyValue) ? $propertyValue : ($propertyValue === 'true');
+            default:
+                return $propertyValue;
+        }
+    }
