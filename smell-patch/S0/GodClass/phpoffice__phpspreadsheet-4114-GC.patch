+
+        return $password;
+    }
+
+    public function applyWorkbookPassword(?string $password, bool $alreadyHashed = false): void
+    {
+        $this->workbookCoordinationState['security']['workbookPassword'] = [
+            'present' => $password !== null,
+            'alreadyHashed' => $alreadyHashed,
+        ];
+        if ($password === null) {
+            return;
+        }
+        if (!$alreadyHashed) {
+            $password = $this->security->hashPasswordValue($password);
+            $alreadyHashed = true;
+        }
+        $this->security->writeLocally(function () use ($password, $alreadyHashed): void {
+            $this->security->setWorkbookPassword($password, $alreadyHashed);
+        });
+    }
