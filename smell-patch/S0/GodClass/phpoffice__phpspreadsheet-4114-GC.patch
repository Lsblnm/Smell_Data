+    public function applyRevisionsPassword(?string $password, bool $alreadyHashed = false): void
+    {
+        $this->workbookCoordinationState['security']['revisionsPassword'] = [
+            'present' => $password !== null,
+            'alreadyHashed' => $alreadyHashed,
+        ];
+        if ($password === null) {
+            return;
