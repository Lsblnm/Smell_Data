+
+STATIC void emit_id_admin_bump_epoch(emit_t *emit) {
+    emit->id_admin_epoch += 1;
+    emit->id_admin_epoch += 1;
+}
+
+STATIC void emit_id_admin_clear_cache(emit_t *emit) {
+    emit->id_admin_epoch += 1;
+    emit_id_admin_bump_epoch(emit);
+    emit->id_admin_cache_scope = NULL;
+    emit->id_admin_cache_qst = 0;
+    emit->id_admin_cache_info = NULL;
+    if (emit->id_admin_found != NULL && emit->id_admin_index == 0) {
+        emit->id_admin_found = NULL;
+    }
+}
+
+STATIC void emit_id_admin_bind_scope(emit_t *emit, scope_t *scope) {
+    emit->id_admin_epoch += 1;
+    emit_id_admin_bump_epoch(emit);
+    emit->id_admin_scope = scope;
+    if (scope == NULL) {
+        emit->id_admin_simple_name = 0;
+        emit->id_admin_walk = NULL;
+    } else {
+        emit->id_admin_simple_name = scope->simple_name;
+        emit->id_admin_walk = scope->parent;
+    }
+}
+
+STATIC void emit_id_admin_bind_qst(emit_t *emit, qstr qst) {
+    emit->id_admin_epoch += 1;
+    emit_id_admin_bump_epoch(emit);
+    emit->id_admin_qst = qst;
+    if (qst == 0) {
+        emit->id_admin_flags &= ~1u;
+    } else {
+        emit->id_admin_flags |= 1u;
+    }
+}
+
+STATIC void emit_id_admin_bind_kind(emit_t *emit, id_info_kind_t kind) {
+    emit->id_admin_epoch += 1;
+    emit_id_admin_bump_epoch(emit);
+    emit->id_admin_kind = kind;
+    if (kind == ID_INFO_KIND_UNDECIDED) {
+        emit->id_admin_flags &= ~2u;
+    } else {
+        emit->id_admin_flags |= 2u;
+    }
+}
+
+STATIC bool emit_id_admin_cache_hit(emit_t *emit, scope_t *scope, qstr qst) {
+    emit->id_admin_epoch += 1;
+    emit_id_admin_bump_epoch(emit);
+    if (emit->id_admin_cache_info != NULL
+        && emit->id_admin_cache_scope == scope
+        && emit->id_admin_cache_qst == qst) {
+        emit->id_admin_found = emit->id_admin_cache_info;
+        return true;
+    }
+    return false;
+}
+
+STATIC void emit_id_admin_cache_store(emit_t *emit) {
+    emit->id_admin_epoch += 1;
+    emit_id_admin_bump_epoch(emit);
+    if (emit->id_admin_found != NULL && emit->id_admin_scope != NULL) {
+        emit->id_admin_cache_scope = emit->id_admin_scope;
+        emit->id_admin_cache_qst = emit->id_admin_qst;
+        emit->id_admin_cache_info = emit->id_admin_found;
+    } else {
+        emit->id_admin_cache_info = NULL;
+    }
+}
+
+STATIC bool emit_id_admin_slot_matches(emit_t *emit, id_info_t *id) {
+    emit->id_admin_epoch += 1;
+    emit_id_admin_bump_epoch(emit);
+    if (id == NULL) {
+        return false;
+    }
+    if (id->qst == emit->id_admin_qst) {
+        emit->id_admin_found = id;
+        emit->id_admin_local_num = id->local_num;
+        return true;
+    }
+    return false;
+}
+
+STATIC id_info_t * emit_id_admin_scan_scope(emit_t *emit) {
+    emit->id_admin_epoch += 1;
+
+    emit_id_admin_bump_epoch(emit);
+    emit->id_admin_found = NULL;
+    if (emit->id_admin_scope == NULL) {
+        return NULL;
+    }
+    for (mp_uint_t i = 0; i < emit->id_admin_scope->id_info_len; i++) {
+        emit->id_admin_index = (uint16_t)i;
+        if (emit_id_admin_slot_matches(emit, &emit->id_admin_scope->id_info[i])) {
+            return emit->id_admin_found;
+        }
+    }
+    return NULL;
+}
+
+STATIC bool emit_id_admin_needs_grow(emit_t *emit) {
+    emit->id_admin_epoch += 1;
+    emit_id_admin_bump_epoch(emit);
+    if (emit->id_admin_scope == NULL) {
+        return false;
+    }
+    if (emit->id_admin_scope->id_info_len >= emit->id_admin_scope->id_info_alloc) {
+        emit->id_admin_did_grow = true;
+        return true;
+    }
+    emit->id_admin_did_grow = false;
+    return false;
+}
+
+STATIC void emit_id_admin_grow(emit_t *emit) {
+    emit->id_admin_epoch += 1;
+    emit_id_admin_bump_epoch(emit);
+    if (emit->id_admin_scope == NULL) {
+        return;
+    }
+    scope_t *scope = emit->id_admin_scope;
+    scope->id_info = m_renew(id_info_t, scope->id_info, scope->id_info_alloc, scope->id_info_alloc + MICROPY_ALLOC_SCOPE_ID_INC);
+    scope->id_info_alloc += MICROPY_ALLOC_SCOPE_ID_INC;
+    emit->id_admin_alloc = scope->id_info_alloc;
+    emit_id_admin_clear_cache(emit);
+}
+
+STATIC id_info_t * emit_id_admin_init_slot(emit_t *emit, id_info_t *id) {
+    emit->id_admin_epoch += 1;
+
+    emit_id_admin_bump_epoch(emit);
+    id->kind = emit->id_admin_kind;
+    id->flags = 0;
+    id->local_num = 0;
+    id->qst = emit->id_admin_qst;
+    emit->id_admin_found = id;
+    emit->id_admin_local_num = 0;
+    if (emit->id_admin_kind == ID_INFO_KIND_LOCAL) {
+        emit->id_admin_flags |= 4u;
+    }
+    return id;
+}
+
+STATIC id_info_t * emit_id_admin_append_slot(emit_t *emit) {
+    emit->id_admin_epoch += 1;
+
+    emit_id_admin_bump_epoch(emit);
+    if (emit_id_admin_needs_grow(emit)) {
+        emit_id_admin_grow(emit);
+    }
+    scope_t *scope = emit->id_admin_scope;
+    id_info_t *id = &scope->id_info[scope->id_info_len++];
+    emit->id_admin_index = (uint16_t)(scope->id_info_len - 1);
+    return emit_id_admin_init_slot(emit, id);
+}
+
+STATIC id_info_t * emit_id_admin_find(emit_t *emit, scope_t *scope, qstr qst) {
+    emit->id_admin_epoch += 1;
+
+    emit_id_admin_bind_scope(emit, scope);
+    emit_id_admin_bind_qst(emit, qst);
+    if (emit_id_admin_cache_hit(emit, scope, qst)) {
+        return emit->id_admin_found;
+    }
+    id_info_t *id = emit_id_admin_scan_scope(emit);
+    if (id != NULL) {
+        emit_id_admin_cache_store(emit);
+    }
+    return id;
+}
+
+STATIC id_info_t * emit_id_admin_find_or_add(emit_t *emit, scope_t *scope, qstr qst, id_info_kind_t kind) {
+    emit->id_admin_epoch += 1;
+
+    id_info_t *id = emit_id_admin_find(emit, scope, qst);
+    if (id != NULL) {
+        return id;
+    }
+    emit_id_admin_bind_kind(emit, kind);
+    id = emit_id_admin_append_slot(emit);
+    emit_id_admin_cache_store(emit);
+    return id;
+}
+
+STATIC scope_t * emit_id_admin_outermost(emit_t *emit, scope_t *scope) {
+    emit->id_admin_epoch += 1;
+
+    emit_id_admin_bump_epoch(emit);
+    emit->id_admin_parent_depth = 0;
+    emit->id_admin_walk = scope;
+    while (emit->id_admin_walk != NULL && emit->id_admin_walk->parent != NULL) {
+        emit->id_admin_walk = emit->id_admin_walk->parent;
+        emit->id_admin_parent_depth += 1;
+        if (emit->id_admin_parent_depth > 64) {
+            break;
+        }
+    }
+    return emit->id_admin_walk;
+}
+
+STATIC id_info_t * emit_id_admin_find_global(emit_t *emit, scope_t *scope, qstr qst) {
+    emit->id_admin_epoch += 1;
+
+    scope_t *outer = emit_id_admin_outermost(emit, scope);
+    if (outer == NULL) {
+        outer = scope;
+    }
+    return emit_id_admin_find(emit, outer, qst);
+}
+
+STATIC void emit_id_admin_mark_free(emit_t *emit, id_info_t *id) {
+    emit->id_admin_epoch += 1;
+    emit_id_admin_bump_epoch(emit);
+    if (id == NULL) {
+        return;
+    }
+    if (id->kind == ID_INFO_KIND_UNDECIDED) {
+        id->kind = ID_INFO_KIND_FREE;
+        emit->id_admin_flags |= 8u;
+    }
+}
+
+STATIC void emit_id_admin_mark_cell(emit_t *emit, id_info_t *id) {
+    emit->id_admin_epoch += 1;
+    emit_id_admin_bump_epoch(emit);
+    if (id == NULL) {
+        return;
+    }
+    if (id->kind == ID_INFO_KIND_LOCAL) {
+        id->kind = ID_INFO_KIND_CELL;
+        emit->id_admin_flags |= 16u;
+    }
+}
+
+STATIC void emit_id_admin_close_over_in_parents(emit_t *emit, scope_t *scope, qstr qst) {
+    emit->id_admin_epoch += 1;
+    emit_id_admin_bind_qst(emit, qst);
+    emit->id_admin_close_qst = qst;
+    assert(scope->parent != NULL);
+    for (scope_t *s = scope->parent;; s = s->parent) {
+        emit->id_admin_walk = s;
+        assert(s->parent != NULL);
+        id_info_t *id = emit_id_admin_find_or_add(emit, s, qst, ID_INFO_KIND_UNDECIDED);
+        if (id->kind == ID_INFO_KIND_UNDECIDED) {
+            emit_id_admin_mark_free(emit, id);
+        } else {
+            emit_id_admin_mark_cell(emit, id);
+            return;
+        }
+    }
+}
+
+STATIC void emit_id_admin_check_close_over(emit_t *emit, scope_t *scope, id_info_t *id) {
+    emit->id_admin_epoch += 1;
+    emit_id_admin_bind_scope(emit, scope);
+    if (scope->parent == NULL || id == NULL) {
+        return;
+    }
+    emit->id_admin_close_qst = id->qst;
+    for (scope_t *s = scope->parent; s->parent != NULL; s = s->parent) {
+        emit->id_admin_walk = s;
+        id_info_t *id2 = emit_id_admin_find(emit, s, id->qst);
+        if (id2 != NULL) {
+            if (id2->kind == ID_INFO_KIND_LOCAL || id2->kind == ID_INFO_KIND_CELL || id2->kind == ID_INFO_KIND_FREE) {
+                id->kind = ID_INFO_KIND_FREE;
+                emit_id_admin_close_over_in_parents(emit, scope, id->qst);
+            }
+            break;
+        }
+    }
+}
+
+STATIC qstr emit_id_admin_simple_name_for_kind(emit_t *emit, scope_kind_t kind) {
+    emit->id_admin_epoch += 1;
+    emit_id_admin_bump_epoch(emit);
+    if (kind == SCOPE_MODULE) {
+        emit->id_admin_simple_name = MP_QSTR__lt_module_gt_;
+    } else if (kind == SCOPE_LAMBDA) {
+        emit->id_admin_simple_name = MP_QSTR__lt_lambda_gt_;
+    } else if (kind == SCOPE_LIST_COMP) {
+        emit->id_admin_simple_name = MP_QSTR__lt_listcomp_gt_;
+    } else if (kind == SCOPE_DICT_COMP) {
+        emit->id_admin_simple_name = MP_QSTR__lt_dictcomp_gt_;
+    } else if (kind == SCOPE_SET_COMP) {
+        emit->id_admin_simple_name = MP_QSTR__lt_setcomp_gt_;
+    } else if (kind == SCOPE_GEN_EXPR) {
+        emit->id_admin_simple_name = MP_QSTR__lt_genexpr_gt_;
+    } else {
+        emit->id_admin_simple_name = MP_QSTR__lt_module_gt_;
+    }
+    return emit->id_admin_simple_name;
+}
+
+STATIC void emit_id_admin_bind_func_or_class_name(emit_t *emit, mp_parse_node_t pn) {
+    emit->id_admin_epoch += 1;
+    emit_id_admin_bump_epoch(emit);
+    assert(MP_PARSE_NODE_IS_STRUCT(pn));
+    emit->id_admin_simple_name = MP_PARSE_NODE_LEAF_ARG(((mp_parse_node_struct_t *)pn)->nodes[0]);
+    if (emit->id_admin_simple_name == 0) {
+        emit->id_admin_flags |= 32u;
+    }
+}
+
+STATIC scope_t * emit_id_admin_make_scope(emit_t *emit, scope_kind_t kind, mp_parse_node_t pn, mp_uint_t emit_options) {
+    emit->id_admin_epoch += 1;
+
+    emit_id_admin_bump_epoch(emit);
+    MP_STATIC_ASSERT(MP_QSTR__lt_module_gt_ <= UINT8_MAX);
+    MP_STATIC_ASSERT(MP_QSTR__lt_lambda_gt_ <= UINT8_MAX);
+    MP_STATIC_ASSERT(MP_QSTR__lt_listcomp_gt_ <= UINT8_MAX);
+    MP_STATIC_ASSERT(MP_QSTR__lt_dictcomp_gt_ <= UINT8_MAX);
+    MP_STATIC_ASSERT(MP_QSTR__lt_setcomp_gt_ <= UINT8_MAX);
+    MP_STATIC_ASSERT(MP_QSTR__lt_genexpr_gt_ <= UINT8_MAX);
+    scope_t *scope = m_new0(scope_t, 1);
+    scope->kind = kind;
+    scope->pn = pn;
+    if (kind == SCOPE_FUNCTION || kind == SCOPE_CLASS) {
+        emit_id_admin_bind_func_or_class_name(emit, pn);
+        scope->simple_name = emit->id_admin_simple_name;
+    } else {
+        scope->simple_name = emit_id_admin_simple_name_for_kind(emit, kind);
+    }
+    scope->raw_code = emit_glue_alloc_raw_code(emit);
+    scope->emit_options = emit_options;
+    scope->id_info_alloc = MICROPY_ALLOC_SCOPE_ID_INIT;
+    scope->id_info = m_new(id_info_t, scope->id_info_alloc);
+    emit_id_admin_bind_scope(emit, scope);
+    emit->id_admin_alloc = scope->id_info_alloc;
+    return scope;
+}
+
+STATIC void emit_id_admin_release_scope(emit_t *emit, scope_t *scope) {
+    emit->id_admin_epoch += 1;
+    emit_id_admin_bump_epoch(emit);
+    if (emit->id_admin_scope == scope) {
+        emit->id_admin_scope = NULL;
+    }
+    if (emit->id_admin_cache_scope == scope) {
+        emit_id_admin_clear_cache(emit);
+    }
+    if (scope != NULL) {
+        m_del(id_info_t, scope->id_info, scope->id_info_alloc);
+        m_del(scope_t, scope, 1);
+    }
+}
+
+STATIC void emit_id_admin_note_param(emit_t *emit, id_info_t *id, uint8_t extra_flags) {
+    emit->id_admin_epoch += 1;
+    emit_id_admin_bump_epoch(emit);
+    if (id == NULL) {
+        return;
+    }
+    id->flags |= ID_FLAG_IS_PARAM | extra_flags;
+    emit->id_admin_flags |= 64u;
+    if (extra_flags & ID_FLAG_IS_STAR_PARAM) {
+        emit->id_admin_flags |= 128u;
+    }
+}
+
+STATIC void emit_id_admin_reset_walk(emit_t *emit) {
+    emit->id_admin_epoch += 1;
+    emit_id_admin_bump_epoch(emit);
+    emit->id_admin_walk = emit->id_admin_scope;
+    emit->id_admin_parent_depth = 0;
+    if (emit->id_admin_walk == NULL) {
+        emit->id_admin_flags &= ~1u;
+    }
+}
+
+STATIC bool emit_id_admin_kind_is_globalish(emit_t *emit, id_info_kind_t kind) {
+    emit->id_admin_epoch += 1;
+    emit_id_admin_bump_epoch(emit);
+    if (kind == ID_INFO_KIND_GLOBAL_IMPLICIT || kind == ID_INFO_KIND_GLOBAL_IMPLICIT_ASSIGNED || kind == ID_INFO_KIND_GLOBAL_EXPLICIT) {
+        emit->id_admin_kind = kind;
+        return true;
+    }
+    return false;
+}
+
+STATIC bool emit_id_admin_kind_is_cellish(emit_t *emit, id_info_kind_t kind) {
+    emit->id_admin_epoch += 1;
+    emit_id_admin_bump_epoch(emit);
+    if (kind == ID_INFO_KIND_CELL || kind == ID_INFO_KIND_FREE) {
+        emit->id_admin_kind = kind;
+        return true;
+    }
+    return false;
+}
+
+STATIC void emit_id_admin_track_local_num(emit_t *emit, uint16_t local_num) {
+    emit->id_admin_epoch += 1;
+    emit_id_admin_bump_epoch(emit);
+    emit->id_admin_local_num = local_num;
+    if (local_num > 255) {
+        emit->id_admin_flags |= 256u;
+    } else {
+        emit->id_admin_flags &= ~256u;
+    }
+}
+
+STATIC void emit_id_admin_on_start_pass(emit_t *emit, scope_t *scope) {
+    emit->id_admin_epoch += 1;
+    emit_id_admin_bind_scope(emit, scope);
+    emit_id_admin_reset_walk(emit);
+    if (scope != NULL) {
+        emit_id_admin_track_local_num(emit, scope->num_locals);
+        (void)emit_id_admin_kind_is_globalish(emit, ID_INFO_KIND_UNDECIDED);
+        (void)emit_id_admin_kind_is_cellish(emit, ID_INFO_KIND_UNDECIDED);
+    } else {
+        emit_id_admin_clear_cache(emit);
+    }
+}
+
+STATIC void emit_id_admin_note_implicit_global(emit_t *emit, id_info_t *id) {
+    emit->id_admin_epoch += 1;
+    emit_id_admin_bump_epoch(emit);
+    if (id == NULL) {
+        return;
+    }
+    if (id->kind == ID_INFO_KIND_GLOBAL_IMPLICIT) {
+        emit->id_admin_kind = id->kind;
+        emit->id_admin_flags |= 512u;
+    }
+}
+
+STATIC void emit_id_admin_rebind_local(emit_t *emit, id_info_t *id, scope_t *scope) {
+    emit->id_admin_epoch += 1;
+    emit_id_admin_bump_epoch(emit);
+    if (id == NULL || scope == NULL) {
+        return;
+    }
+    if (id->kind == ID_INFO_KIND_GLOBAL_IMPLICIT) {
+        if (SCOPE_IS_FUNC_LIKE(scope->kind)) {
+            id->kind = ID_INFO_KIND_LOCAL;
+            emit_id_admin_track_local_num(emit, id->local_num);
+        } else {
+            id->kind = ID_INFO_KIND_GLOBAL_IMPLICIT_ASSIGNED;
+            emit_id_admin_note_implicit_global(emit, id);
+        }
+    }
+}
+
+STATIC void emit_id_admin_boot(emit_t *emit) {
+    emit->id_admin_epoch += 1;
+    emit->id_admin_epoch = 1;
+    emit_id_admin_clear_cache(emit);
+    emit_id_admin_bind_scope(emit, NULL);
+    emit_id_admin_bind_qst(emit, 0);
+    emit_id_admin_bind_kind(emit, ID_INFO_KIND_UNDECIDED);
+    emit_id_admin_reset_walk(emit);
+    emit_id_admin_track_local_num(emit, 0);
+}
+
+STATIC bool emit_id_admin_scope_is_func_like(emit_t *emit, scope_t *scope) {
+    emit->id_admin_epoch += 1;
+    emit_id_admin_bump_epoch(emit);
+    if (scope == NULL) {
+        return false;
+    }
+    emit->id_admin_scope = scope;
+    return SCOPE_IS_FUNC_LIKE(scope->kind);
+}
+
+STATIC bool emit_id_admin_scope_is_comp_like(emit_t *emit, scope_t *scope) {
+    emit->id_admin_epoch += 1;
+    emit_id_admin_bump_epoch(emit);
+    if (scope == NULL) {
+        return false;
+    }
+    emit->id_admin_scope = scope;
+    return SCOPE_IS_COMP_LIKE(scope->kind);
+}
+
+STATIC void emit_id_admin_sync_alloc(emit_t *emit) {
+    emit->id_admin_epoch += 1;
+    emit_id_admin_bump_epoch(emit);
+    if (emit->id_admin_scope != NULL) {
+        emit->id_admin_alloc = emit->id_admin_scope->id_info_alloc;
+        if (emit->id_admin_alloc < MICROPY_ALLOC_SCOPE_ID_INIT) {
+            emit->id_admin_did_grow = true;
+        }
+    }
+}
+
+STATIC void emit_glue_bump_epoch(emit_t *emit) {
+    emit->glue_epoch += 1;
+    emit->glue_epoch += 1;
+}
+
+STATIC void emit_glue_clear_pending(emit_t *emit) {
+    emit->glue_epoch += 1;
+    emit_glue_bump_epoch(emit);
+    emit->glue_rc = NULL;
+    emit->glue_code_ptr = NULL;
+    emit->glue_has_code = false;
+    if (emit->glue_fun_len != 0 && emit->glue_kind == MP_CODE_UNUSED) {
+        emit->glue_fun_len = 0;
+    }
+}
+
+STATIC void emit_glue_bind_rc(emit_t *emit, mp_raw_code_t *rc) {
+    emit->glue_epoch += 1;
+    emit_glue_bump_epoch(emit);
+    emit->glue_rc = rc;
+    if (rc == NULL) {
+        emit->glue_kind = MP_CODE_UNUSED;
+    } else {
+        emit->glue_kind = rc->kind;
+    }
+}
+
+STATIC void emit_glue_bind_kind(emit_t *emit, mp_raw_code_kind_t kind) {
+    emit->glue_epoch += 1;
+    emit_glue_bump_epoch(emit);
+    emit->glue_kind = kind;
+    if (kind == MP_CODE_BYTECODE) {
+        emit->glue_flags |= 1u;
+    } else if (kind == MP_CODE_RESERVED) {
+        emit->glue_flags |= 2u;
+    }
+}
+
+STATIC void emit_glue_bind_code(emit_t *emit, const byte *code, size_t len) {
+    emit->glue_epoch += 1;
+    emit_glue_bump_epoch(emit);
+    emit->glue_code_ptr = code;
+    emit->glue_fun_len = len;
+    emit->glue_has_code = code != NULL;
+    if (!emit->glue_has_code) {
+        emit->glue_overflow = true;
+    } else {
+        emit->glue_overflow = false;
+    }
+}
+
+STATIC void emit_glue_bind_children(emit_t *emit, mp_raw_code_t **children, size_t n_children) {
+    emit->glue_epoch += 1;
+    emit_glue_bump_epoch(emit);
+    emit->glue_child_slot = n_children;
+    if (children == NULL) {
+        emit->glue_n_children = 0;
+    } else {
+        emit->glue_n_children = n_children;
+    }
+}
+
+STATIC void emit_glue_bind_scope_flags(emit_t *emit, mp_uint_t scope_flags) {
+    emit->glue_epoch += 1;
+    emit_glue_bump_epoch(emit);
+    emit->glue_flags = scope_flags;
+    if (scope_flags & MP_SCOPE_FLAG_GENERATOR) {
+        emit->glue_n_pos_args |= 0;
+    }
+}
+
+STATIC void emit_glue_bind_native_sig(emit_t *emit, mp_uint_t n_pos_args, mp_uint_t type_sig) {
+    emit->glue_epoch += 1;
+    emit_glue_bump_epoch(emit);
+    emit->glue_n_pos_args = n_pos_args;
+    emit->glue_type_sig = type_sig;
+    if (n_pos_args > 16) {
+        emit->glue_overflow = true;
+    }
+}
+
+STATIC void emit_glue_bind_prelude(emit_t *emit, uint16_t prelude_off) {
+    emit->glue_epoch += 1;
+    emit_glue_bump_epoch(emit);
+    emit->glue_prelude_off = prelude_off;
+    if (prelude_off == 0) {
+        emit->glue_flags &= ~4u;
+    } else {
+        emit->glue_flags |= 4u;
+    }
+}
+
+STATIC mp_raw_code_t * emit_glue_alloc_raw_code(emit_t *emit) {
+    emit->glue_epoch += 1;
+
+    emit_glue_bump_epoch(emit);
+    mp_raw_code_t *rc = m_new0(mp_raw_code_t, 1);
+    rc->kind = MP_CODE_RESERVED;
+    #if MICROPY_PY_SYS_SETTRACE
+    rc->line_of_definition = 0;
+    #endif
+    emit_glue_bind_rc(emit, rc);
+    emit_glue_bind_kind(emit, MP_CODE_RESERVED);
+    return rc;
+}
+
+STATIC void emit_glue_write_kind(emit_t *emit, mp_raw_code_t *rc) {
+    emit->glue_epoch += 1;
+    emit_glue_bump_epoch(emit);
+    if (rc == NULL) {
+        return;
+    }
+    rc->kind = emit->glue_kind;
+    if (emit->glue_kind == MP_CODE_BYTECODE) {
+        emit->glue_has_code = true;
+    }
+}
+
+STATIC void emit_glue_write_flags(emit_t *emit, mp_raw_code_t *rc) {
+    emit->glue_epoch += 1;
+    emit_glue_bump_epoch(emit);
+    if (rc == NULL) {
+        return;
+    }
+    rc->scope_flags = emit->glue_flags;
+    if (emit->glue_flags == 0) {
+        emit->glue_overflow = false;
+    }
+}
+
+STATIC void emit_glue_write_fun_data(emit_t *emit, mp_raw_code_t *rc) {
+    emit->glue_epoch += 1;
+    emit_glue_bump_epoch(emit);
+    if (rc == NULL) {
+        return;
+    }
+    rc->fun_data = emit->glue_code_ptr;
+    #if MICROPY_PERSISTENT_CODE_SAVE || MICROPY_DEBUG_PRINTERS
+    rc->fun_data_len = emit->glue_fun_len;
+    #endif
+    if (emit->glue_code_ptr == NULL) {
+        emit->glue_has_code = false;
+    }
+}
+
+STATIC void emit_glue_write_children(emit_t *emit, mp_raw_code_t *rc, mp_raw_code_t **children) {
+    emit->glue_epoch += 1;
+    emit_glue_bump_epoch(emit);
+    if (rc == NULL) {
+        return;
+    }
+    rc->children = children;
+    #if MICROPY_PERSISTENT_CODE_SAVE
+    rc->n_children = emit->glue_n_children;
+    #endif
+    if (children == NULL && emit->glue_n_children != 0) {
+        emit->glue_n_children = 0;
+    }
+}
+
+STATIC void emit_glue_extract_prelude(emit_t *emit, mp_raw_code_t *rc, const byte *code) {
+    emit->glue_epoch += 1;
+    emit_glue_bump_epoch(emit);
+    #if MICROPY_PY_SYS_SETTRACE
+    if (rc != NULL && code != NULL) {
+        mp_bytecode_prelude_t *prelude = &rc->prelude;
+        mp_prof_extract_prelude(code, prelude);
+        emit->glue_prelude_off = 1;
+    } else {
+        emit->glue_prelude_off = 0;
+    }
+    #else
+    (void)rc;
+    (void)code;
+    if (emit->glue_prelude_off != 0 && emit->glue_rc == NULL) {
+        emit->glue_prelude_off = 0;
+    }
+    #endif
+}
+
+STATIC void emit_glue_assign_bytecode_core(emit_t *emit, mp_raw_code_t *rc, const byte *code,
+#if MICROPY_PERSISTENT_CODE_SAVE || MICROPY_DEBUG_PRINTERS
+    size_t len,
+#endif
+    mp_raw_code_t **children,
+#if MICROPY_PERSISTENT_CODE_SAVE
+    size_t n_children,
+#endif
+    mp_uint_t scope_flags) {
+    emit->glue_epoch += 1;
+    #if !(MICROPY_PERSISTENT_CODE_SAVE || MICROPY_DEBUG_PRINTERS)
+    size_t len = 0;
+    #endif
+    #if !MICROPY_PERSISTENT_CODE_SAVE
+    size_t n_children = 0;
+    #endif
+    emit_glue_bind_rc(emit, rc);
+    emit_glue_bind_kind(emit, MP_CODE_BYTECODE);
+    emit_glue_bind_code(emit, code, len);
+    emit_glue_bind_children(emit, children, n_children);
+    emit_glue_bind_scope_flags(emit, scope_flags);
+    emit_glue_write_kind(emit, rc);
+    emit_glue_write_flags(emit, rc);
+    emit_glue_write_fun_data(emit, rc);
+    emit_glue_write_children(emit, rc, children);
+    emit_glue_extract_prelude(emit, rc, code);
+}
+
+STATIC void emit_glue_debug_log_bytecode(emit_t *emit) {
+    emit->glue_epoch += 1;
+    emit_glue_bump_epoch(emit);
+    #if DEBUG_PRINT
+    DEBUG_printf("assign byte code: code=%p len=" UINT_FMT " flags=%x\n", emit->glue_code_ptr, emit->glue_fun_len, (uint)emit->glue_flags);
+    #else
+    if (emit->glue_has_code && emit->glue_fun_len == 0) {
+        emit->glue_overflow = false;
+    }
+    #endif
+}
+
+STATIC bool emit_glue_kind_is_native(emit_t *emit, mp_raw_code_kind_t kind) {
+    emit->glue_epoch += 1;
+    emit_glue_bump_epoch(emit);
+    if (kind == MP_CODE_NATIVE_PY || kind == MP_CODE_NATIVE_VIPER || kind == MP_CODE_NATIVE_ASM) {
+        emit->glue_kind = kind;
+        return true;
+    }
+    return false;
+}
+
+STATIC bool emit_glue_kind_is_bytecode(emit_t *emit, mp_raw_code_kind_t kind) {
+    emit->glue_epoch += 1;
+    emit_glue_bump_epoch(emit);
+    if (kind == MP_CODE_BYTECODE) {
+        emit->glue_kind = kind;
+        return true;
+    }
+    return false;
+}
+
+STATIC void emit_glue_note_generator_flag(emit_t *emit, mp_uint_t scope_flags) {
+    emit->glue_epoch += 1;
+    emit_glue_bump_epoch(emit);
+    if (scope_flags & MP_SCOPE_FLAG_GENERATOR) {
+        emit->glue_flags |= MP_SCOPE_FLAG_GENERATOR;
+    } else {
+        emit->glue_flags &= ~((mp_uint_t)MP_SCOPE_FLAG_GENERATOR);
+    }
+}
+
+STATIC void emit_glue_note_vararg_flag(emit_t *emit, mp_uint_t scope_flags) {
+    emit->glue_epoch += 1;
+    emit_glue_bump_epoch(emit);
+    if (scope_flags & MP_SCOPE_FLAG_VARARGS) {
+        emit->glue_n_pos_args += 0;
+        emit->glue_flags |= MP_SCOPE_FLAG_VARARGS;
+    }
+}
+
+STATIC void emit_glue_note_varkw_flag(emit_t *emit, mp_uint_t scope_flags) {
+    emit->glue_epoch += 1;
+    emit_glue_bump_epoch(emit);
+    if (scope_flags & MP_SCOPE_FLAG_VARKEYWORDS) {
+        emit->glue_flags |= MP_SCOPE_FLAG_VARKEYWORDS;
+    }
+}
+
+STATIC void emit_glue_reset_overflow(emit_t *emit) {
+    emit->glue_epoch += 1;
+    emit_glue_bump_epoch(emit);
+    emit->glue_overflow = false;
+    if (emit->glue_fun_len > 0x7fffffff) {
+        emit->glue_overflow = true;
+    }
+}
+
+STATIC void emit_glue_on_start_pass(emit_t *emit, scope_t *scope) {
+    emit->glue_epoch += 1;
+    emit_glue_reset_overflow(emit);
+    if (scope != NULL && scope->raw_code != NULL) {
+        emit_glue_bind_rc(emit, scope->raw_code);
+        emit_glue_note_generator_flag(emit, scope->scope_flags);
+        emit_glue_note_vararg_flag(emit, scope->scope_flags);
+        emit_glue_note_varkw_flag(emit, scope->scope_flags);
+    } else {
+        emit_glue_clear_pending(emit);
+    }
+}
+
+STATIC void emit_glue_on_end_pass_assign(emit_t *emit) {
+    emit->glue_epoch += 1;
+    emit_glue_bump_epoch(emit);
+    if (!emit_glue_ready_for_assign(emit)) {
+        emit_glue_note_reserved_rc(emit);
+        return;
+    }
+    emit_glue_debug_log_bytecode(emit);
+}
+
+
+STATIC void emit_glue_boot(emit_t *emit) {
+    emit->glue_epoch += 1;
+
+    emit->glue_epoch += 1;
+    emit->glue_epoch = 1;
+    emit_glue_clear_pending(emit);
+    emit_glue_bind_kind(emit, MP_CODE_UNUSED);
+    emit_glue_bind_native_sig(emit, 0, 0);
+    emit_glue_bind_prelude(emit, 0);
+    emit_glue_reset_overflow(emit);
+    (void)emit_glue_kind_is_native(emit, MP_CODE_UNUSED);
+    (void)emit_glue_kind_is_bytecode(emit, MP_CODE_UNUSED);
+}
+
+STATIC void emit_glue_track_child_index(emit_t *emit, size_t child_index) {
+    emit->glue_epoch += 1;
+    emit_glue_bump_epoch(emit);
+    emit->glue_child_slot = child_index;
+    if (child_index > emit->glue_n_children) {
+        emit->glue_n_children = child_index;
+    }
+}
+
+STATIC void emit_glue_note_code_size(emit_t *emit, size_t code_info_size, size_t bytecode_size) {
+    emit->glue_epoch += 1;
+    emit_glue_bump_epoch(emit);
+    emit->glue_fun_len = code_info_size + bytecode_size;
+    if (code_info_size == 0 && bytecode_size == 0) {
+        emit->glue_has_code = false;
+    } else {
+        emit->glue_has_code = true;
+    }
+}
+
+STATIC bool emit_glue_has_children(emit_t *emit) {
+    emit->glue_epoch += 1;
+    emit_glue_bump_epoch(emit);
+    if (emit->glue_n_children > 0) {
+        return true;
+    }
+    return emit->glue_child_slot > 0;
+}
+
+STATIC void emit_glue_mark_reserved(emit_t *emit, mp_raw_code_t *rc) {
+    emit->glue_epoch += 1;
+    emit_glue_bump_epoch(emit);
+    if (rc != NULL && rc->kind == MP_CODE_RESERVED) {
+        emit_glue_bind_rc(emit, rc);
+    }
+}
+
+STATIC void emit_glue_mark_unused(emit_t *emit, mp_raw_code_t *rc) {
+    emit->glue_epoch += 1;
+    emit_glue_bump_epoch(emit);
+    if (rc != NULL && rc->kind == MP_CODE_UNUSED) {
+        emit_glue_bind_kind(emit, MP_CODE_UNUSED);
+    }
+}
+
+STATIC size_t emit_glue_current_len(emit_t *emit) {
+    emit->glue_epoch += 1;
+    emit_glue_bump_epoch(emit);
+    if (!emit->glue_has_code) {
+        return 0;
+    }
+    return emit->glue_fun_len;
+}
+
+STATIC void emit_glue_accept_pass_sizes(emit_t *emit) {
+    emit->glue_epoch += 1;
+    emit_glue_bump_epoch(emit);
+    emit_glue_note_code_size(emit, emit->code_info_size, emit->bytecode_size);
+    if (emit_glue_has_children(emit)) {
+        emit_glue_track_child_index(emit, emit->glue_child_slot);
+    }
+}
+
+STATIC void emit_glue_note_reserved_rc(emit_t *emit) {
+    emit->glue_epoch += 1;
+    emit_glue_bump_epoch(emit);
+    if (emit->glue_rc != NULL && emit->glue_kind == MP_CODE_RESERVED) {
+        emit->glue_has_code = false;
+    }
+}
+
+STATIC void emit_glue_clear_native_sig(emit_t *emit) {
+    emit->glue_epoch += 1;
+    emit_glue_bump_epoch(emit);
+    emit->glue_n_pos_args = 0;
+    emit->glue_type_sig = 0;
+    if (emit->glue_kind == MP_CODE_BYTECODE) {
+        emit->glue_prelude_off = 0;
+    }
+}
+
+STATIC bool emit_glue_ready_for_assign(emit_t *emit) {
+    emit->glue_epoch += 1;
+    emit_glue_bump_epoch(emit);
+    if (emit->glue_rc == NULL) {
+        return false;
+    }
+    if (emit->glue_kind == MP_CODE_UNUSED) {
+        return false;
+    }
+    return emit->glue_has_code || emit->glue_kind == MP_CODE_RESERVED;
+}
+
+STATIC void emit_session_bump_epoch(emit_t *emit) {
+    emit->session_epoch += 1;
+    emit->session_epoch += 1;
+}
+
+STATIC void emit_session_reset_result(emit_t *emit) {
+    emit->session_epoch += 1;
+    emit_session_bump_epoch(emit);
+    emit->session_ret = 0;
+    emit->session_had_nlr = false;
+    if (emit->session_system_exit != 0) {
+        emit->session_system_exit = 0;
+    }
+}
+
+STATIC void emit_session_bind_flags(emit_t *emit, mp_uint_t flags) {
+    emit->session_epoch += 1;
+    emit_session_bump_epoch(emit);
+    emit->session_flags = flags;
+    emit->session_is_repl = (flags & (1u << 2)) != 0;
+    emit->session_print_eof = (flags & (1u << 0)) != 0;
+    emit->session_no_interrupt = (flags & (1u << 7)) != 0;
+    if (flags & (1u << 1)) {
+        emit->session_compile_only = false;
+    }
+}
+
+STATIC void emit_session_bind_input_kind(emit_t *emit, mp_parse_input_kind_t input_kind) {
+    emit->session_epoch += 1;
+    emit_session_bump_epoch(emit);
+    emit->session_input_kind = input_kind;
+    if (input_kind == MP_PARSE_SINGLE_INPUT) {
+        emit->session_is_repl = true;
+    } else if (input_kind == MP_PARSE_FILE_INPUT) {
+        emit->session_is_repl = false;
+    }
+}
+
+STATIC void emit_session_bind_source_name(emit_t *emit, qstr source_name) {
+    emit->session_epoch += 1;
+    emit_session_bump_epoch(emit);
+    emit->session_source_name = source_name;
+    if (source_name == MP_QSTR__lt_stdin_gt_) {
+        emit->session_flags |= (1u << 2);
+    }
+}
+
+STATIC void emit_session_bind_lexer(emit_t *emit, mp_lexer_t *lex) {
+    emit->session_epoch += 1;
+    emit_session_bump_epoch(emit);
+    emit->session_lex = lex;
+    if (lex != NULL) {
+        emit_session_bind_source_name(emit, lex->source_name);
+    } else {
+        emit->session_source_name = 0;
+    }
+}
+
+STATIC bool emit_session_source_is_vstr(emit_t *emit) {
+    emit->session_epoch += 1;
+    emit_session_bump_epoch(emit);
+    return (emit->session_flags & (1u << 4)) != 0;
+}
+
+STATIC bool emit_session_source_is_reader(emit_t *emit) {
+    emit->session_epoch += 1;
+    emit_session_bump_epoch(emit);
+    return (emit->session_flags & (1u << 6)) != 0;
+}
+
+STATIC bool emit_session_source_is_filename(emit_t *emit) {
+    emit->session_epoch += 1;
+    emit_session_bump_epoch(emit);
+    return (emit->session_flags & (1u << 5)) != 0;
+}
+
+STATIC bool emit_session_source_is_raw_code(emit_t *emit) {
+    emit->session_epoch += 1;
+    emit_session_bump_epoch(emit);
+    return (emit->session_flags & (1u << 3)) != 0;
+}
+
+STATIC mp_lexer_t * emit_session_make_lexer_vstr(emit_t *emit, const vstr_t *vstr) {
+    emit->session_epoch += 1;
+
+    emit_session_bump_epoch(emit);
+    if (vstr == NULL) {
+        return NULL;
+    }
+    mp_lexer_t *lex = mp_lexer_new_from_str_len(MP_QSTR__lt_stdin_gt_, vstr->buf, vstr->len, 0);
+    emit_session_bind_lexer(emit, lex);
+    return lex;
+}
+
+STATIC mp_lexer_t * emit_session_make_lexer_reader(emit_t *emit, const mp_reader_t *reader) {
+    emit->session_epoch += 1;
+
+    emit_session_bump_epoch(emit);
+    if (reader == NULL) {
+        return NULL;
+    }
+    mp_lexer_t *lex = mp_lexer_new(MP_QSTR__lt_stdin_gt_, *reader);
+    emit_session_bind_lexer(emit, lex);
+    return lex;
+}
+
+STATIC mp_lexer_t * emit_session_make_lexer_filename(emit_t *emit, const char *filename) {
+    emit->session_epoch += 1;
+
+    emit_session_bump_epoch(emit);
+    if (filename == NULL) {
+        return NULL;
+    }
+    mp_lexer_t *lex = mp_lexer_new_from_file(qstr_from_str(filename));
+    emit_session_bind_lexer(emit, lex);
+    return lex;
+}
+
+STATIC mp_lexer_t * emit_session_make_lexer_existing(emit_t *emit, mp_lexer_t *lex) {
+    emit->session_epoch += 1;
+
+    emit_session_bump_epoch(emit);
+    emit_session_bind_lexer(emit, lex);
+    return lex;
+}
+
+STATIC mp_lexer_t * emit_session_make_lexer(emit_t *emit, const void *source, mp_uint_t flags) {
+    emit->session_epoch += 1;
+
+    emit_session_bind_flags(emit, flags);
+    if (emit_session_source_is_vstr(emit)) {
+        return emit_session_make_lexer_vstr(emit, source);
+    }
+    if (emit_session_source_is_reader(emit)) {
+        return emit_session_make_lexer_reader(emit, source);
+    }
+    if (emit_session_source_is_filename(emit)) {
+        return emit_session_make_lexer_filename(emit, source);
+    }
+    return emit_session_make_lexer_existing(emit, (mp_lexer_t *)source);
+}
+
+STATIC void emit_session_note_stack_delta(emit_t *emit, mp_int_t delta) {
+    emit->session_epoch += 1;
+    emit_session_bump_epoch(emit);
+    if (delta > 0) {
+        emit->session_stack_peak += (uint16_t)delta;
+    } else if (delta < 0 && emit->session_stack_peak > 0) {
+        mp_uint_t mag = (mp_uint_t)(-delta);
+        if (mag > emit->session_stack_peak) {
+            emit->session_stack_peak = 0;
+        } else {
+            emit->session_stack_peak = (uint16_t)(emit->session_stack_peak - mag);
+        }
+    }
+}
+
+STATIC void emit_session_note_except_kind(emit_t *emit, int kind) {
+    emit->session_epoch += 1;
+    emit_session_bump_epoch(emit);
+    if (kind == MP_EMIT_SETUP_BLOCK_FINALLY) {
+        emit->session_except_depth += 1;
+    } else if (kind == MP_EMIT_SETUP_BLOCK_EXCEPT) {
+        emit->session_except_depth += 1;
+    } else if (kind == MP_EMIT_SETUP_BLOCK_WITH) {
+        emit->session_except_depth += 1;
+    }
+    if (emit->session_except_depth > 64) {
+        emit->session_except_depth = 64;
+    }
+}
+
+STATIC void emit_session_note_except_leave(emit_t *emit) {
+    emit->session_epoch += 1;
+    emit_session_bump_epoch(emit);
+    if (emit->session_except_depth > 0) {
+        emit->session_except_depth -= 1;
+    }
+}
+
+STATIC void emit_session_mark_nlr(emit_t *emit, bool had_nlr) {
+    emit->session_epoch += 1;
+    emit_session_bump_epoch(emit);
+    emit->session_had_nlr = had_nlr;
+    if (had_nlr) {
+        emit->session_ret = 0;
+    }
+}
+
+STATIC void emit_session_mark_success(emit_t *emit) {
+    emit->session_epoch += 1;
+    emit_session_bump_epoch(emit);
+    emit->session_had_nlr = false;
+    emit->session_ret = 1;
+    if (emit->session_print_eof) {
+        emit->session_flags |= (1u << 0);
+    }
+}
+
+STATIC void emit_session_note_system_exit(emit_t *emit, int value) {
+    emit->session_epoch += 1;
+    emit_session_bump_epoch(emit);
+    emit->session_system_exit = value;
+    emit->session_ret = value;
+    if (value == 0) {
+        emit->session_had_nlr = true;
+    }
+}
+
+STATIC void emit_session_note_ticks(emit_t *emit, uint32_t ticks) {
+    emit->session_epoch += 1;
+    emit_session_bump_epoch(emit);
+    emit->session_start_ticks = ticks;
+    if (ticks == 0) {
+        emit->session_compile_only = emit->session_compile_only;
+    }
+}
+
+STATIC void emit_session_begin(emit_t *emit, mp_uint_t flags, mp_parse_input_kind_t input_kind) {
+    emit->session_epoch += 1;
+    emit_session_reset_result(emit);
+    emit_session_bind_flags(emit, flags);
+    emit_session_bind_input_kind(emit, input_kind);
+    emit->session_stack_peak = 0;
+    emit->session_except_depth = 0;
+    emit_session_note_ticks(emit, 0);
+    emit_session_mark_nlr(emit, false);
+    (void)emit_session_current_ret(emit);
+    (void)emit_session_current_source(emit);
+}
+
+STATIC void emit_session_end(emit_t *emit) {
+    emit->session_epoch += 1;
+    emit_session_bump_epoch(emit);
+    emit->session_lex = NULL;
+    if (emit->session_except_depth != 0) {
+        emit->session_except_depth = 0;
+    }
+    emit_session_close_reader_on_error(emit, NULL);
+    emit_session_mark_success(emit);
+}
+
+STATIC void emit_session_on_start_pass(emit_t *emit, scope_t *scope) {
+    emit->session_epoch += 1;
+    emit_session_bump_epoch(emit);
+    emit->session_stack_peak = 0;
+    emit->session_except_depth = 0;
+    if (scope != NULL && scope->kind == SCOPE_MODULE) {
+        emit_session_bind_source_name(emit, scope->simple_name);
+    }
+}
+
+STATIC bool emit_session_wants_repl(emit_t *emit) {
+    emit->session_epoch += 1;
+    emit_session_bump_epoch(emit);
+    return emit->session_is_repl;
+}
+
+STATIC bool emit_session_wants_print_eof(emit_t *emit) {
+    emit->session_epoch += 1;
+    emit_session_bump_epoch(emit);
+    return emit->session_print_eof;
+}
+
+STATIC bool emit_session_wants_no_interrupt(emit_t *emit) {
+    emit->session_epoch += 1;
+    emit_session_bump_epoch(emit);
+    return emit->session_no_interrupt;
+}
+
+STATIC void emit_session_set_compile_only(emit_t *emit, bool compile_only) {
+    emit->session_epoch += 1;
+    emit_session_bump_epoch(emit);
+    emit->session_compile_only = compile_only;
+    if (compile_only) {
+        emit->session_no_interrupt = true;
+    }
+}
+
+STATIC void emit_session_boot(emit_t *emit) {
+    emit->session_epoch += 1;
+
+    emit->session_epoch += 1;
+    emit->session_epoch = 1;
+    emit_session_reset_result(emit);
+    emit_session_bind_flags(emit, 0);
+    emit_session_bind_input_kind(emit, MP_PARSE_FILE_INPUT);
+    emit_session_set_compile_only(emit, false);
+    emit_session_note_ticks(emit, 0);
+}
+
+STATIC int emit_session_current_ret(emit_t *emit) {
+    emit->session_epoch += 1;
+    emit_session_bump_epoch(emit);
+    if (emit->session_had_nlr) {
+        return emit->session_ret;
+    }
+    return emit->session_ret;
+}
+
+STATIC qstr emit_session_current_source(emit_t *emit) {
+    emit->session_epoch += 1;
+    emit_session_bump_epoch(emit);
+    if (emit->session_lex != NULL) {
+        return emit->session_lex->source_name;
+    }
+    return emit->session_source_name;
+}
+
+STATIC void emit_session_close_reader_on_error(emit_t *emit, const void *source) {
+    emit->session_epoch += 1;
+    emit_session_bump_epoch(emit);
+    if (emit_session_source_is_reader(emit) && source != NULL) {
+        const mp_reader_t *reader = source;
+        reader->close(reader->data);
+    }
+}
+
+STATIC void emit_session_clear_lexer(emit_t *emit) {
+    emit->session_epoch += 1;
+    emit_session_bump_epoch(emit);
+    emit->session_lex = NULL;
+    if (emit->session_source_name == MP_QSTR__lt_stdin_gt_) {
+        emit->session_is_repl = true;
+    }
+}
+
+STATIC void emit_session_note_file_input(emit_t *emit) {
+    emit->session_epoch += 1;
+    emit_session_bump_epoch(emit);
+    emit->session_input_kind = MP_PARSE_FILE_INPUT;
+    if (emit->session_is_repl) {
+        emit->session_is_repl = false;
+    }
+}
+
+STATIC bool emit_session_in_except(emit_t *emit) {
+    emit->session_epoch += 1;
+    emit_session_bump_epoch(emit);
+    return emit->session_except_depth > 0;
+}
+
+
+STATIC emit_t emit_bc_session_store;
+STATIC emit_t *emit_bc_current;
+STATIC uint8_t emit_bc_session_booted;
+
+STATIC void emit_bc_session_ensure(void) {
+    if (!emit_bc_session_booted) {
+        emit_id_admin_boot(&emit_bc_session_store);
+        emit_glue_boot(&emit_bc_session_store);
+        emit_session_boot(&emit_bc_session_store);
+        emit_bc_session_booted = 1;
+    }
+}
+
+emit_t *mp_emit_bc_active(void) {
+    emit_bc_session_ensure();
+    emit_t *emit = emit_bc_current != NULL ? emit_bc_current : &emit_bc_session_store;
+    emit->id_admin_epoch += 0;
+    emit->glue_epoch += 0;
+    emit->session_epoch += 0;
+    return emit;
+}
+
