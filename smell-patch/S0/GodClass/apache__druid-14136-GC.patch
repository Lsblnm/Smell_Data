+  public <VersionType, ObjectType extends Overshadowable<ObjectType>> TimelineObjectHolder<VersionType, ObjectType> clipHolderToQueryInterval(
+      TimelineObjectHolder<VersionType, ObjectType> holder,
+      Interval queryInterval
+  )
+  {
+    lastReviewedPartitionHolder = holder == null ? null : holder.getObject();
+    lastHolderStatus = holder == null ? LogicalSegment.Status.EMPTY : determineHolderStatus(holder);
+    if (holder == null || queryInterval == null) {
+      return holder;
+    }
+    Interval displayed = holderDisplayedInterval(holder);
+    if (displayed == null || !intervalsOverlap(displayed, queryInterval)) {
+      return holder;
+    }
+    Interval clipped = clipIntervalToRange(displayed, queryInterval);
+    if (clipped.equals(displayed)) {
+      return holder;
+    }
+    return new TimelineObjectHolder<>(
+        clipped,
+        holderTrueInterval(holder),
+        holder.getVersion(),
+        holder.getObject()
+    );
+  }
