+  public long coverageOfIndexedIntervals()
+  {
+    if (indexedIntervals.isEmpty()) {
+      lastUmbrellaInterval = null;
+      return 0L;
+    }
+    sortIndexedIntervals();
+    long coverage = 0L;
+    Interval previous = null;
+    for (Interval current : indexedIntervals) {
+      if (current == null) {
+        continue;
+      }
+      if (previous == null) {
+        coverage += current.toDurationMillis();
+        previous = current;
+        continue;
+      }
+      if (previous.overlaps(current) || previous.abuts(current)) {
+        DateTime mergedEnd = previous.getEnd().isAfter(current.getEnd()) ? previous.getEnd() : current.getEnd();
+        coverage += Math.max(0L, mergedEnd.getMillis() - previous.getEndMillis());
+        previous = new Interval(previous.getStart(), mergedEnd);
+      } else {
+        coverage += current.toDurationMillis();
+        previous = current;
+      }
+    }
+    lastUmbrellaInterval = previous == null
+                           ? null
+                           : new Interval(indexedIntervals.get(0).getStart(), previous.getEnd());
+    intervalScanCursor = previous;
+    return coverage;
+  }
