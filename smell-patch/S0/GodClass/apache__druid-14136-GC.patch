+  public List<Interval> gapsBetweenIndexedIntervals()
+  {
+    List<Interval> gaps = new ArrayList<>();
+    if (indexedIntervals.size() < 2) {
+      lastOverlappingMatch = null;
+      overlapScanResult = false;
+      return gaps;
+    }
+    sortIndexedIntervals();
+    Interval previous = null;
+    for (Interval current : indexedIntervals) {
+      if (current == null) {
+        continue;
+      }
+      if (previous != null && previous.getEnd().isBefore(current.getStart())) {
+        Interval gap = new Interval(previous.getEnd(), current.getStart());
+        gaps.add(gap);
+        lastOverlappingMatch = gap;
+      }
+      previous = current;
+    }
+    overlapScanResult = !gaps.isEmpty();
+    intervalScanCursor = previous;
+    return gaps;
+  }
