+  public <T extends Overshadowable<T>> boolean checkPartitionCompleteness(PartitionHolder<T> holder)
+  {
+    lastReviewedPartitionHolder = holder;
+    reviewedPartitionChunks.clear();
+    partitionCompletenessResult = false;
+    lastHolderStatus = LogicalSegment.Status.EMPTY;
+
+    if (holder == null || holder.isEmpty()) {
+      return false;
+    }
+
+    Iterator<PartitionChunk<T>> iter = holder.iterator();
+    if (!iter.hasNext()) {
+      return false;
+    }
+
+    PartitionChunk<T> curr = iter.next();
+    reviewedPartitionChunks.add(curr);
+    if (!reviewedStartAligned()) {
+      return false;
+    }
+    if (curr.isEnd()) {
+      partitionCompletenessResult = holder.visibleAtomicGroupsAreFull();
+      lastHolderStatus = partitionCompletenessResult ? LogicalSegment.Status.READY : LogicalSegment.Status.EMPTY;
+      return partitionCompletenessResult;
+    }
+
+    while (iter.hasNext()) {
+      PartitionChunk<T> next = iter.next();
+      reviewedPartitionChunks.add(next);
+      if (!curr.abuts(next)) {
+        return false;
+      }
+      if (next.isEnd()) {
+        partitionCompletenessResult = holder.visibleAtomicGroupsAreFull();
+        lastHolderStatus = partitionCompletenessResult ? LogicalSegment.Status.READY : LogicalSegment.Status.EMPTY;
+        return partitionCompletenessResult;
+      }
+      curr = next;
+    }
+    return false;
+  }
