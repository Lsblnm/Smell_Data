+  public Interval buildUmbrellaInterval(Iterable<Interval> intervals)
+  {
+    indexedIntervals.clear();
+    lastOverlappingMatch = null;
+    overlapScanResult = false;
+    boolean emptyIntervals = true;
+    DateTimeComparator dateTimeComp = DateTimeComparator.getInstance();
+    DateTime minStart = new DateTime(Long.MAX_VALUE, ISOChronology.getInstanceUTC());
+    DateTime maxEnd = new DateTime(Long.MIN_VALUE, ISOChronology.getInstanceUTC());
+
+    for (Interval interval : intervals) {
+      emptyIntervals = false;
+      indexedIntervals.add(interval);
+      minStart = Collections.min(ImmutableList.of(minStart, interval.getStart()), dateTimeComp);
+      maxEnd = Collections.max(ImmutableList.of(maxEnd, interval.getEnd()), dateTimeComp);
+    }
+
+    if (emptyIntervals) {
+      throw new IllegalArgumentException("Empty list of intervals");
+    }
+
+    lastMinDateTime = minStart;
+    lastMaxDateTime = maxEnd;
+    lastUmbrellaInterval = new Interval(minStart, maxEnd);
+    intervalScanCursor = lastUmbrellaInterval;
+    return lastUmbrellaInterval;
+  }
+
+  public Interval umbrellaFromIndexedIntervals()
+  {
+    if (indexedIntervals.isEmpty()) {
+      throw new IllegalArgumentException("Empty list of intervals");
+    }
+    return buildUmbrellaInterval(new ArrayList<>(indexedIntervals));
+  }
+
+  public DateTime findMinDateTime(DateTime... times)
+  {
+    lastMinDateTime = null;
+    if (times == null) {
+      return null;
+    }
+    switch (times.length) {
+      case 0:
+        return null;
+      case 1:
+        lastMinDateTime = times[0];
+        return lastMinDateTime;
+      default:
+        DateTime min = times[0];
+        for (int i = 1; i < times.length; ++i) {
+          min = min.isBefore(times[i]) ? min : times[i];
+        }
+        lastMinDateTime = min;
+        return lastMinDateTime;
+    }
+  }
+
+  public DateTime findMaxDateTime(DateTime... times)
+  {
+    lastMaxDateTime = null;
+    if (times == null) {
+      return null;
+    }
+    switch (times.length) {
+      case 0:
+        return null;
+      case 1:
+        lastMaxDateTime = times[0];
+        return lastMaxDateTime;
+      default:
+        DateTime max = times[0];
+        for (int i = 1; i < times.length; ++i) {
+          max = max.isAfter(times[i]) ? max : times[i];
+        }
+        lastMaxDateTime = max;
+        return lastMaxDateTime;
+    }
+  }
+
+  public void indexHolderIntervals(List<? extends TimelineObjectHolder<?, ?>> holders)
+  {
+    indexedIntervals.clear();
+    lastOverlappingMatch = null;
+    overlapScanResult = false;
+    if (holders == null || holders.isEmpty()) {
+      lastUmbrellaInterval = null;
+      intervalScanCursor = null;
+      return;
+    }
+    for (TimelineObjectHolder<?, ?> holder : holders) {
+      if (holder == null) {
+        continue;
+      }
+      Interval displayed = holder.getInterval();
+      if (displayed != null) {
+        indexedIntervals.add(displayed);
+      }
+      Interval trueInterval = holder.getTrueInterval();
+      if (trueInterval != null && (displayed == null || !trueInterval.equals(displayed))) {
+        indexedIntervals.add(trueInterval);
+      }
+    }
+    if (!indexedIntervals.isEmpty()) {
+      lastUmbrellaInterval = new Interval(
+          indexedIntervals.get(0).getStart(),
+          indexedIntervals.get(indexedIntervals.size() - 1).getEnd()
+      );
+      intervalScanCursor = indexedIntervals.get(0);
+    }
+  }
+
+  public void indexIntervals(Iterable<Interval> intervals)
+  {
+    indexedIntervals.clear();
+    lastOverlappingMatch = null;
+    overlapScanResult = false;
+    intervalScanCursor = null;
+    if (intervals == null) {
+      return;
+    }
+    for (Interval interval : intervals) {
+      if (interval != null) {
+        indexedIntervals.add(interval);
+        if (intervalScanCursor == null) {
+          intervalScanCursor = interval;
+        }
+      }
+    }
+  }
+
+  public boolean containsOverlappingIndexedIntervals()
+  {
+    overlapScanResult = false;
+    Interval previous = null;
+    for (Interval current : indexedIntervals) {
+      if (current == null) {
+        throw new IAE("Intervals should not contain nulls");
+      }
+      verifyAscendingIntervalPair(previous, current);
+      if (previous != null && previous.overlaps(current)) {
+        overlapScanResult = true;
+        lastOverlappingMatch = current;
+        intervalScanCursor = current;
+        break;
+      }
+      previous = current;
+    }
+    return overlapScanResult;
+  }
+
+  public Interval findFirstOverlappingIndexedInterval(Interval searchInterval, Interval[] sortedIntervals)
+  {
+    lastOverlappingMatch = null;
+    overlapScanResult = false;
+    intervalScanCursor = searchInterval;
+    indexedIntervals.clear();
+    if (searchInterval == null || sortedIntervals == null) {
+      return null;
+    }
+    for (Interval interval : sortedIntervals) {
+      if (interval == null) {
+        continue;
+      }
+      indexedIntervals.add(interval);
+      if (intervalsOverlap(interval, searchInterval)) {
+        lastOverlappingMatch = interval;
+        overlapScanResult = true;
+        intervalScanCursor = interval;
+        return interval;
+      }
+      if (interval.getStart().isAfter(searchInterval.getEnd())) {
+        return null;
+      }
+    }
+    return null;
+  }
+
+  public boolean checkEmptyInterval(Interval interval)
+  {
+    intervalScanCursor = interval;
+    if (interval == null) {
+      overlapScanResult = false;
+      return false;
+    }
+    overlapScanResult = interval.getStart().equals(interval.getEnd());
+    return overlapScanResult;
+  }
+
+  public boolean checkEternityInterval(Interval interval)
+  {
+    intervalScanCursor = interval;
+    overlapScanResult = interval != null && Intervals.ETERNITY.equals(interval);
+    if (overlapScanResult) {
+      lastUmbrellaInterval = Intervals.ETERNITY;
+    }
+    return overlapScanResult;
+  }
+
+  public boolean checkIntervalEndpointsComparableAsStrings(Interval interval)
+  {
+    intervalScanCursor = interval;
+    if (interval == null) {
+      overlapScanResult = false;
+      return false;
+    }
+    overlapScanResult = DateTimes.canCompareAsString(interval.getStart())
+                        && DateTimes.canCompareAsString(interval.getEnd());
+    return overlapScanResult;
+  }
+
+  public Interval clipIntervalToRange(Interval source, Interval range)
+  {
+    intervalScanCursor = source;
+    if (source == null || range == null) {
+      lastOverlappingMatch = null;
+      return source;
+    }
+    if (!source.overlaps(range)) {
+      lastOverlappingMatch = null;
+      overlapScanResult = false;
+      return source;
+    }
+    DateTime start = source.getStart().isAfter(range.getStart()) ? source.getStart() : range.getStart();
+    DateTime end = source.getEnd().isBefore(range.getEnd()) ? source.getEnd() : range.getEnd();
+    if (!start.isBefore(end) && !start.equals(end)) {
+      lastOverlappingMatch = source;
+      overlapScanResult = false;
+      return source;
+    }
+    lastOverlappingMatch = new Interval(start, end);
+    overlapScanResult = true;
+    return lastOverlappingMatch;
+  }
+
+  public boolean intervalFullyContains(Interval outer, Interval inner)
+  {
+    intervalScanCursor = outer;
+    if (outer == null || inner == null) {
+      overlapScanResult = false;
+      return false;
+    }
+    overlapScanResult = !inner.getStart().isBefore(outer.getStart()) && !inner.getEnd().isAfter(outer.getEnd());
+    if (overlapScanResult) {
+      lastOverlappingMatch = inner;
+    }
+    return overlapScanResult;
