+  public boolean reviewedChunksAreContiguous()
+  {
+    if (reviewedPartitionChunks.size() < 2) {
+      partitionCompletenessResult = reviewedPartitionChunks.size() == 1;
+      return partitionCompletenessResult;
+    }
+    for (int i = 1; i < reviewedPartitionChunks.size(); i++) {
+      PartitionChunk<?> previous = reviewedPartitionChunks.get(i - 1);
+      PartitionChunk<?> current = reviewedPartitionChunks.get(i);
+      if (previous == null || current == null || !partitionChunksAbut(previous, current)) {
+        partitionCompletenessResult = false;
+        return false;
+      }
+    }
+    partitionCompletenessResult = true;
+    return true;
+  }
