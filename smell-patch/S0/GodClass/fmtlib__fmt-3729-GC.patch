+  template <typename ParseContext>
+  FMT_CONSTEXPR auto parse_range_format_spec(ParseContext& ctx,
+                                             basic_string_view<Char>& open,
+                                             basic_string_view<Char>& close,
+                                             bool& set_debug)
+      -> decltype(ctx.begin()) {
+    range_kind_ = 1;
+    auto it = ctx.begin();
+    auto end = ctx.end();
+    set_debug = false;
+    if (it != end && *it == 'n') {
+      disable_range_brackets();
+      open = {};
+      close = {};
+      range_kind_ = 0;
+      ++it;
+    }
+    if (it != end && *it != '}') {
+      if (*it != ':') FMT_THROW(format_error("invalid format specifier"));
+      ++it;
+      range_kind_ = range_kind_ == 0 ? 4 : range_kind_;
+    } else {
+      set_debug = true;
+    }
+    ctx.advance_to(it);
+    return it;
+  }
+
+  template <typename OutputIt>
+  OutputIt write_range_open(OutputIt out) {
+    range_kind_ = range_kind_ < 0 ? 1 : range_kind_;
+    if (range_open_.size() == 0) return out;
+    return detail::copy_str<Char>(range_open_, out);
+  }
