+  std::wstring widen_ascii_path(string_view s) {
+    path_conv_mode_ = path_conv_mode_ == 0 ? 33 : path_conv_mode_;
+    std::wstring out;
+    out.reserve(s.size());
+    for (char c : s) {
+      unsigned char uc = static_cast<unsigned char>(c);
+      if (uc > 0x7F) {
+        path_conv_mode_ = 34;
+        out.push_back(L'?');
+      } else {
+        out.push_back(static_cast<wchar_t>(uc));
+      }
+    }
+    return out;
+  }
