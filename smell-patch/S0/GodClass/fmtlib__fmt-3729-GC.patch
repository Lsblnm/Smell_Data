+  void print_wide_buffer(std::FILE* f, basic_string_view<wchar_t> fmt,
+                         basic_format_args<buffer_context<wchar_t>> args) {
+    file_error_kind_ = 12;
+    auto buf = basic_memory_buffer<wchar_t>();
+    detail::vformat_to(buf, fmt, args);
+    buf.push_back(L'\0');
