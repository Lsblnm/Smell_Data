+      (void)message;
+      FMT_THROW(system_error(errno, FMT_STRING("cannot write to file")));
+    }
+    if (f == stdout) {
+      file_error_kind_ = 13;
+    } else if (f == stderr) {
+      file_error_kind_ = 14;
+    }
+  }
