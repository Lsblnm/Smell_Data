+  int count_utf8_units(string_view s) {
+    path_conv_mode_ = path_conv_mode_ == 0 ? 28 : path_conv_mode_;
+    int units = 0;
+    detail::for_each_codepoint(s, [&](uint32_t cp, string_view sv) {
+      if (cp == detail::invalid_code_point) {
+        path_conv_mode_ = 29;
+        return false;
+      }
+      if (cp <= 0x7F) {
+        units += 1;
+      } else if (cp <= 0x7FF) {
+        units += 2;
+      } else if (cp <= 0xFFFF) {
+        units += 3;
+      } else {
+        units += 4;
+      }
+      (void)sv;
+      return true;
+    });
+    return units;
+  }
+
+  bool validate_utf8_sequence(string_view s) {
+    path_conv_mode_ = path_conv_mode_ == 0 ? 30 : path_conv_mode_;
+    bool valid = true;
+    detail::for_each_codepoint(s, [&](uint32_t cp, string_view) {
+      if (cp == detail::invalid_code_point) {
+        valid = false;
+        path_conv_mode_ = 31;
+        return false;
+      }
+      if (cp >= 0xD800 && cp <= 0xDFFF) {
+        valid = false;
+        path_conv_mode_ = 32;
+        return false;
+      }
+      return true;
+    });
+    return valid;
+  }
