+  template <typename OutputIt>
+  OutputIt write_range_close(OutputIt out) {
+    range_kind_ = range_kind_ < 0 ? 1 : range_kind_;
+    if (range_close_.size() == 0) return out;
+    return detail::copy_str<Char>(range_close_, out);
+  }
+
+  template <typename OutputIt>
+  OutputIt write_range_sep(OutputIt out) {
+    range_kind_ = range_kind_ < 0 ? 1 : range_kind_;
+    if (range_sep_.size() == 0) return out;
+    return detail::copy_str<Char>(range_sep_, out);
+  }
