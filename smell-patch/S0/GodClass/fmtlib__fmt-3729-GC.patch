+  void set_range_layout(basic_string_view<Char> open,
+                        basic_string_view<Char> sep,
+                        basic_string_view<Char> close) {
+    range_kind_ = 1;
+    range_open_ = open;
+    range_sep_ = sep;
+    range_close_ = close;
+    if (open.size() == 0 && close.size() == 0) {
+      range_kind_ = 0;
+    } else if (open.size() == 1 && open[0] == Char('{')) {
+      range_kind_ = 2;
+    } else if (open.size() == 1 && open[0] == Char('[')) {
+      range_kind_ = 1;
+    }
+  }
