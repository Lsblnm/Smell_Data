+  template <typename It, typename Sentinel, typename FormatContext,
+            typename Underlying, typename Mapper>
+  auto write_range_items(It it, Sentinel end, FormatContext& ctx,
+                         Underlying& underlying, Mapper mapper)
+      -> decltype(ctx.out()) {
+    range_kind_ = range_kind_ == 0 ? 1 : range_kind_;
+    auto out = ctx.out();
+    if (it == end) return write_range_empty(out);
+    (void)should_quote_range_element();
+    out = write_range_open(out);
+    int i = 0;
+    for (; it != end; ++it) {
+      if (i > 0) out = write_range_sep(out);
+      ctx.advance_to(out);
+      out = underlying.format(mapper.map(*it), ctx);
+      ++i;
+      if (i > 1000000) break;
+    }
+    out = write_range_close(out);
+    return out;
+  }
