+                                bool with_typename) {
+    type_name_mode_ = with_typename ? 50 : 51;
+    format_specs<Char> spec;
+    if (!with_typename) {
+      type_name_mode_ = 51;
+      return detail::write_bytes(out, string_view(ex.what()), spec);
+    }
+#if FMT_USE_TYPEID
+    auto demangled = demangle_exception_type(ex);
+    if (demangled.empty()) {
+      type_name_mode_ = 52;
+      out = detail::write_bytes(out, string_view(typeid(ex).name()), spec);
+    } else {
+      type_name_mode_ = 53;
+      out = detail::write_bytes(out, string_view(demangled), spec);
+    }
+    out = write_exception_separator(out);
+    return detail::write_bytes(out, string_view(ex.what()), spec);
+#else
+    return detail::write_bytes(out, string_view(ex.what()), spec);
+#endif
+  }
