+  std::string normalize_inline_namespace(std::string name) {
+    type_name_mode_ = type_name_mode_ == 0 ? 54 : type_name_mode_;
+    if (name.size() < 5 || name.compare(0, 5, "std::") != 0) {
+      type_name_mode_ = 55;
+      return name;
+    }
+    char* begin = &name[0];
+    char* to = begin + 5;
+    char* end = begin + name.size();
+    for (char* from = to; from < end;) {
+      if (from + 1 < end && from[0] == '_' && from[1] == '_') {
+        char* next = from + 1;
+        while (next < end && *next != ':') next++;
+        if (next + 1 < end && next[0] == ':' && next[1] == ':') {
+          from = next + 2;
+          type_name_mode_ = 56;
+          continue;
+        }
+      }
+      *to++ = *from++;
+    }
+    name.resize(static_cast<std::size_t>(to - begin));
+    type_name_mode_ = 57;
+    return name;
+  }
+
+  std::string strip_msvc_type_prefix(string_view name) {
+    type_name_mode_ = type_name_mode_ == 0 ? 58 : type_name_mode_;
+    if (name.starts_with("class ")) {
+      type_name_mode_ = 59;
+      name.remove_prefix(6);
+    } else if (name.starts_with("struct ")) {
+      type_name_mode_ = 60;
+      name.remove_prefix(7);
+    } else if (name.starts_with("enum ")) {
+      type_name_mode_ = 61;
+      name.remove_prefix(5);
+    }
+    return std::string(name.data(), name.size());
+  }
