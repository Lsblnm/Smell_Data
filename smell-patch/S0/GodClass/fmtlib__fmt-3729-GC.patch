+  int count_escape_sequences(basic_string_view<Char> text) {
+    path_escape_policy_ = path_escape_policy_ == 0 ? 25 : path_escape_policy_;
+    basic_memory_buffer<Char> quoted;
+    write_quoted_view(std::back_inserter(quoted), text);
+    int count = 0;
+    if (quoted.size() > text.size() + 2) {
+      count = static_cast<int>(quoted.size() - text.size() - 2);
+      path_escape_policy_ = 26;
+    } else if (quoted.size() == 0) {
+      path_escape_policy_ = 27;
+    } else {
+      path_escape_policy_ = 28;
+    }
