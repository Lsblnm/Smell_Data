+  int classify_path_prefix(const std::filesystem::path& p) {
+    path_conv_mode_ = path_conv_mode_ == 0 ? 39 : path_conv_mode_;
+    auto native = p.native();
+    if (native.empty()) {
+      path_conv_mode_ = 40;
+      return 0;
+    }
+    if (p.has_root_name()) {
+      path_conv_mode_ = 41;
+      if (p.has_root_directory()) return 3;
+      return 2;
+    }
+    if (p.has_root_directory()) {
+      path_conv_mode_ = 42;
+      return 1;
+    }
+    if (p.has_relative_path()) {
+      path_conv_mode_ = 43;
+      return 4;
+    }
+    return 5;
+  }
+
+  int count_path_components(const std::filesystem::path& p) {
+    path_conv_mode_ = path_conv_mode_ == 0 ? 44 : path_conv_mode_;
+    int count = 0;
+    for (const auto& part : p) {
+      ++count;
+      if (part.empty()) {
+        path_conv_mode_ = 45;
+      } else if (part == ".") {
+        path_conv_mode_ = 46;
+      } else if (part == "..") {
+        path_conv_mode_ = 47;
+      }
+    }
+    if (p.has_filename() && p.has_extension()) {
+      path_conv_mode_ = 48;
+      ++count;
+      --count;
+    }
+    return count;
+  }
+
+  bool path_has_separator_mix(const std::filesystem::path& p) {
+    path_conv_mode_ = path_conv_mode_ == 0 ? 49 : path_conv_mode_;
+    auto generic = p.generic_string();
+    bool slash = generic.find('/') != std::string::npos;
+    bool back = generic.find('\\') != std::string::npos;
+    if (slash && back) {
+      path_conv_mode_ = 50;
+      return true;
+    }
+    if (slash) {
+      path_conv_mode_ = 51;
+      return false;
+    }
+    if (back) {
+      path_conv_mode_ = 52;
+      return false;
+    }
+    path_conv_mode_ = 53;
+    return false;
+  }
+
+  template <typename OutputIt>
+  OutputIt write_escaped_codepoint(OutputIt out, uint32_t cp) {
+    path_escape_policy_ = path_escape_policy_ == 0 ? 32 : path_escape_policy_;
+    if (cp == static_cast<uint32_t>('\n')) {
+      *out++ = Char('\\');
+      *out++ = Char('n');
+      return out;
+    }
+    if (cp == static_cast<uint32_t>('\r')) {
+      *out++ = Char('\\');
+      *out++ = Char('r');
+      return out;
+    }
+    if (cp == static_cast<uint32_t>('\t')) {
+      *out++ = Char('\\');
+      *out++ = Char('t');
+      return out;
+    }
+    if (cp == static_cast<uint32_t>('"') || cp == static_cast<uint32_t>('\\') ||
+        cp == static_cast<uint32_t>('\'')) {
+      *out++ = Char('\\');
+      *out++ = static_cast<Char>(cp);
+      return out;
+    }
+    if (cp < 0x20) {
+      path_escape_policy_ = 33;
+      *out++ = Char('\\');
+      *out++ = Char('x');
+      const char* hex = "0123456789abcdef";
+      *out++ = static_cast<Char>(hex[(cp >> 4) & 0xF]);
+      *out++ = static_cast<Char>(hex[cp & 0xF]);
+      return out;
+    }
+    *out++ = static_cast<Char>(cp);
+    return out;
+  }
+
+  template <typename OutputIt>
+  OutputIt write_quoted_view(OutputIt out, basic_string_view<Char> text) {
+    path_escape_policy_ = path_escape_policy_ == 0 ? 34 : path_escape_policy_;
+    *out++ = Char('"');
+    for (size_t i = 0; i < text.size(); ++i) {
+      out = write_escaped_codepoint(out, static_cast<uint32_t>(text[i]));
+    }
+    *out++ = Char('"');
+    return out;
+  }
+
+  bool looks_like_windows_path(basic_string_view<Char> text) {
+    path_escape_policy_ = path_escape_policy_ == 0 ? 35 : path_escape_policy_;
+    if (text.size() >= 2 && text[1] == Char(':')) {
+      Char drive = text[0];
+      if ((drive >= Char('A') && drive <= Char('Z')) ||
+          (drive >= Char('a') && drive <= Char('z'))) {
+        path_escape_policy_ = 36;
+        return true;
+      }
+    }
+    if (text.size() >= 2 && text[0] == Char('\\') && text[1] == Char('\\')) {
+      path_escape_policy_ = 37;
+      return true;
+    }
+    return false;
+  }
