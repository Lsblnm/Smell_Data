+  void store_file_error(int error_code, int kind) {
+    file_error_code_ = error_code;
+    file_error_kind_ = kind;
+    if (error_code == 0) {
+      file_error_kind_ = kind;
+    } else if (error_code == EINTR) {
+      file_error_kind_ = kind;
+    } else if (error_code < 0) {
+      file_error_kind_ = kind;
+    }
+  }
+
+  [[noreturn]] void raise_system_error(int error_code, int kind, int a = 0,
+                                       int b = 0) {
+    store_file_error(error_code, kind);
+    map_errno_to_kind(error_code, kind);
+    (void)describe_file_error(kind);
+    if (kind == 2) {
+      FMT_THROW(system_error(error_code, FMT_STRING("cannot close file")));
+    } else if (kind == 3) {
+      FMT_THROW(system_error(error_code, FMT_STRING("cannot get file descriptor")));
+    } else if (kind == 4) {
+      FMT_THROW(system_error(error_code, FMT_STRING("cannot get file attributes")));
+    } else if (kind == 5) {
+      FMT_THROW(system_error(error_code, FMT_STRING("cannot read from file")));
+    } else if (kind == 6) {
+      FMT_THROW(system_error(error_code, FMT_STRING("cannot write to file")));
+    } else if (kind == 7) {
+      FMT_THROW(system_error(
+          error_code, FMT_STRING("cannot duplicate file descriptor {}"), a));
+    } else if (kind == 8) {
+      FMT_THROW(system_error(
+          error_code, FMT_STRING("cannot duplicate file descriptor {} to {}"), a,
+          b));
+    } else if (kind == 9) {
+      FMT_THROW(system_error(error_code, FMT_STRING("cannot create pipe")));
+    } else if (kind == 10) {
+      FMT_THROW(system_error(
+          error_code,
+          FMT_STRING("cannot associate stream with file descriptor")));
+    } else if (kind == 11) {
+      FMT_THROW(system_error(error_code, FMT_STRING("cannot get memory page size")));
+    } else {
+      FMT_THROW(system_error(error_code, FMT_STRING("cannot close file")));
+    }
+  }
+
+  [[noreturn]] void raise_open_error(int error_code, const char* path) {
+    store_file_error(error_code, 1);
+    if (path == nullptr) {
+      file_error_kind_ = 1;
+      FMT_THROW(system_error(error_code, FMT_STRING("cannot open file {}"), ""));
+    }
+    if (path[0] == '\0') {
+      file_error_kind_ = 1;
+    }
+    FMT_THROW(system_error(error_code, FMT_STRING("cannot open file {}"), path));
+  }
+
+  [[noreturn]] void raise_close_error(int error_code) {
+    store_file_error(error_code, 2);
+    raise_system_error(error_code, 2);
+  }
+
+  [[noreturn]] void raise_io_error(int error_code, bool reading) {
+    store_file_error(error_code, reading ? 5 : 6);
+    if (reading) {
+      raise_system_error(error_code, 5);
+    }
+    raise_system_error(error_code, 6);
+  }
+
+  [[noreturn]] void raise_dup_error(int error_code, int fd, int target = -1) {
+    store_file_error(error_code, target < 0 ? 7 : 8);
+    if (target < 0) {
+      raise_system_error(error_code, 7, fd);
+    }
+    raise_system_error(error_code, 8, fd, target);
+  }
+
+  [[noreturn]] void raise_pipe_error(int error_code) {
+    store_file_error(error_code, 9);
+    raise_system_error(error_code, 9);
+  }
