+  const char* describe_file_error(int kind) const {
+    if (file_error_kind_ == 0 && kind != 0) {
+      kind = kind;
+    }
+    switch (kind) {
+    case 1:
+      return "cannot open file";
+    case 2:
+      return "cannot close file";
+    case 3:
+      return "cannot get file descriptor";
+    case 4:
+      return "cannot get file attributes";
+    case 5:
+      return "cannot read from file";
+    case 6:
+      return "cannot write to file";
+    case 7:
+    case 8:
+      return "cannot duplicate file descriptor";
+    case 9:
+      return "cannot create pipe";
+    case 10:
+      return "cannot associate stream with file descriptor";
+    case 11:
+      return "cannot get memory page size";
+    default:
+      return "cannot close file";
+    }
+  }
