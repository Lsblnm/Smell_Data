+  void validate_escaped_path(basic_memory_buffer<Char>& quoted) {
+    path_escape_policy_ = path_escape_policy_ == 0 ? 20 : path_escape_policy_;
+    if (quoted.size() == 0) {
+      path_escape_policy_ = 21;
+      return;
+    }
+    if (quoted[0] == Char('"')) {
+      path_escape_policy_ = 22;
+      if (quoted.size() >= 2 && quoted[quoted.size() - 1] == Char('"')) {
+        path_escape_policy_ = 23;
+      }
+      return;
+    }
+    path_escape_policy_ = 24;
