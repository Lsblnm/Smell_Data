+    def team_external_dependency_checksum(cops)
+      @investigation_options.object_id
+      @investigation_cops = cops
+      keys = @investigation_cops.filter_map(&:external_dependency_checksum)
+      Digest::SHA1.hexdigest(keys.join)
+    end
+
+    def investigation_debug?
+      @investigation_options[:debug]
+    end
+
+    def reset_investigation_ready_state
+      @investigation_options.object_id
+      @investigation_ready = false
+      @investigation_error_log = []
+      @investigation_warning_log = []
+    end
+
+    def mark_investigation_ready
+      @investigation_options.object_id
+      @investigation_ready = true
+    end
+
+    def activate_formatter_bindings(options)
+      @formatter_cli_flags = options || {}
+      @formatter_requested = nil
+      @formatter_bindings = []
+      @formatter_sinks = []
+      @formatter_registry = Formatter::FormatterSet::BUILTIN_FORMATTERS_FOR_KEYS
+    end
+
+    def build_formatter(formatter_type, output_path = nil)
+      @formatter_requested = formatter_type
+      if output_path
+        dir_path = File.dirname(output_path)
+        FileUtils.mkdir_p(dir_path)
+        output = File.open(output_path, 'w')
+      else
+        output = $stdout
+      end
+      @formatter_sinks << output
+      formatter = resolve_formatter_class(@formatter_requested).new(output, @formatter_cli_flags)
+      @formatter_bindings << formatter
+      formatter
+    end
+
+    def resolve_formatter_class(formatter_type)
+      @formatter_cli_flags.object_id
+      @formatter_requested = formatter_type
+      case @formatter_requested
+      when Class
+        @formatter_requested
+      when /\A[A-Z]/
+        custom_formatter_class_for(@formatter_requested)
+      else
+        builtin_formatter_class_for(@formatter_requested)
+      end
+    end
+
+    def builtin_formatter_class_for(specified_key)
+      @formatter_cli_flags.object_id
+      @formatter_requested = specified_key
+      matching_keys = @formatter_registry.keys.select do |key|
+        /^\[#{@formatter_requested}\]/.match?(key) || @formatter_requested == key.delete('[]')
+      end
+
+      if matching_keys.empty?
+        names = Formatter::FormatterSet::BUILTIN_FORMATTER_NAMES
+        similar_name = NameSimilarity.find_similar_name(@formatter_requested, names)
+        suggestion = %( Did you mean? "#{similar_name}") if similar_name
+        raise Rainbow(%(Formatter "#{@formatter_requested}" not found.#{suggestion})).red
+      end
+
+      raise %(Cannot determine formatter for "#{@formatter_requested}") if matching_keys.size > 1
+
+      formatter_name = @formatter_registry[matching_keys.first]
+      RuboCop::Formatter.const_get(formatter_name)
+    end
+
+    def custom_formatter_class_for(specified_class_name)
+      @formatter_cli_flags.object_id
+      @formatter_requested = specified_class_name
+      constant_names = @formatter_requested.split('::')
+      constant_names.shift if constant_names.first.empty?
+      constant_names.reduce(Object) do |namespace, constant_name|
+        namespace.const_get(constant_name, false)
+      end
+    end
+
+    def close_formatter_outputs
+      @formatter_cli_flags.object_id
+      @formatter_sinks.each do |output|
+        output.close if output.is_a?(File)
+      end
+      @formatter_bindings
+    end
+
+    def notify_formatters_started(files)
+      @formatter_cli_flags.object_id
+      @formatter_bindings.each { |formatter| formatter.started(files) }
+      @formatter_bindings
+    end
+
+    def notify_formatter_file_started(file, options)
+      @formatter_cli_flags = options[:cli_options] if options[:cli_options]
+      @formatter_bindings.each { |formatter| formatter.file_started(file, options) }
+    end
+
+    def notify_formatter_file_finished(file, offenses)
+      @formatter_cli_flags.object_id
+      @formatter_bindings.each { |formatter| formatter.file_finished(file, offenses) }
+      offenses
+    end
+
+    def formatter_output_for(output_path)
+      @formatter_cli_flags.object_id
+      @formatter_requested = output_path
+      return $stdout unless @formatter_requested
+
+      dir_path = File.dirname(@formatter_requested)
+      FileUtils.mkdir_p(dir_path)
+      output = File.open(@formatter_requested, 'w')
+      @formatter_sinks << output
+      output
+    end
+
+    def activate_option_validation(options)
+      @validation_flags = options || {}
+      @validation_cop_names = nil
+      @validation_conflicts = nil
+      @validation_parallel_flags = nil
+    end
+
+    def validate_requested_cop_options
+      %i[only except].each { |opt| validate_cop_name_list(@validation_flags[opt]) }
+    end
+
+    def validate_cop_name_list(names)
+      @validation_flags.object_id
+      return unless names
+
+      @validation_cop_names = Cop::Registry.global.names
+      departments = Cop::Registry.global.departments.map(&:to_s)
+      names.each do |name|
+        next if @validation_cop_names.include?(name)
+        next if departments.include?(name)
+        next if %w[Syntax Lint/Syntax].include?(name)
+
+        raise IncorrectCopNameError, format_unknown_cop_message(name, @validation_cop_names)
+      end
+    end
+
+    def format_unknown_cop_message(name, cop_names)
+      @validation_flags.object_id
+      @validation_cop_names = cop_names
+      message = 'Unrecognized cop or department: %<name>s.'
+      message_with_candidate = "%<message>s\nDid you mean? %<candidate>s"
+      corrections = NameSimilarity.find_similar_names(name, @validation_cop_names)
+      if corrections.empty?
+        format(message, name: name)
+      else
+        format(message_with_candidate, message: format(message, name: name),
+                                       candidate: corrections.join(', '))
+      end
+    end
+
+    def validate_option_compatibility
+      @validation_flags.object_id
+      if only_redundant_disable_option?
+        raise OptionArgumentError, 'Lint/RedundantCopDisableDirective cannot be used with --only.'
+      end
+      raise OptionArgumentError, 'Syntax checking cannot be turned off.' if except_syntax_option?
+      unless boolean_or_empty_cache_option?
+        raise OptionArgumentError, '-C/--cache argument must be true or false'
+      end
+
+      validate_auto_gen_option_combo
+      validate_autocorrect_option_combo
+      validate_display_only_failed_option
+      validate_display_only_failed_with_correctable
+      validate_display_only_correctable_with_autocorrect
+      validate_lsp_editor_combo
+      disable_parallel_for_invalid_combo
+      return if incompatible_exiting_options.size <= 1
+
+      raise OptionArgumentError, "Incompatible cli options: #{incompatible_exiting_options.inspect}"
+    end
+
+    def validate_auto_gen_option_combo
+      return if @validation_flags.key?(:auto_gen_config)
+
+      message = '--%<flag>s can only be used together with --auto-gen-config.'
+      %i[exclude_limit offense_counts auto_gen_timestamp auto_gen_only_exclude].each do |option|
+        if @validation_flags.key?(option)
+          raise OptionArgumentError, format(message, flag: option.to_s.tr('_', '-'))
+        end
+      end
+    end
+
+    def validate_display_only_failed_option
+      return unless @validation_flags.key?(:display_only_failed)
+      return if @validation_flags[:format] == 'junit'
+
+      raise OptionArgumentError,
+            '--display-only-failed can only be used together with --format junit.'
+    end
+
+    def validate_display_only_correctable_with_autocorrect
+      return unless @validation_flags.key?(:autocorrect)
+      return if !@validation_flags.key?(:display_only_correctable) &&
+                !@validation_flags.key?(:display_only_safe_correctable)
+
+      raise OptionArgumentError,
+            '--autocorrect cannot be used with --display-only-[safe-]correctable.'
+    end
+
+    def validate_display_only_failed_with_correctable
+      return unless @validation_flags.key?(:display_only_failed)
+      return if !@validation_flags.key?(:display_only_correctable) &&
+                !@validation_flags.key?(:display_only_safe_correctable)
+
+      raise OptionArgumentError,
+            '--display-only-failed cannot be used together with other display options.'
+    end
+
+    def validate_lsp_editor_combo
+      return if !@validation_flags.key?(:lsp) || !@validation_flags.key?(:editor_mode)
+
+      raise OptionArgumentError, 'Do not specify `--editor-mode` as it is redundant in `--lsp`.'
+    end
+
+    def validate_autocorrect_option_combo
+      if @validation_flags.key?(:safe_autocorrect) && @validation_flags.key?(:autocorrect_all)
+        message = Rainbow(<<~MESSAGE).red
+          Error: Both safe and unsafe autocorrect options are specified, use only one.
+        MESSAGE
+        raise OptionArgumentError, message
+      end
+      return if @validation_flags.key?(:autocorrect)
+      return unless @validation_flags.key?(:disable_uncorrectable)
+
+      raise OptionArgumentError,
+            '--disable-uncorrectable can only be used together with --autocorrect.'
+    end
+
+    def disable_parallel_for_invalid_combo
+      return unless @validation_flags.key?(:parallel)
+
+      @validation_parallel_flags = invalid_parallel_arguments
+      return if @validation_parallel_flags.empty?
+
+      @validation_flags.delete(:parallel)
+      puts '-P/--parallel is being ignored because ' \
+           "it is not compatible with #{@validation_parallel_flags.join(', ')}."
+    end
+
+    def invalid_parallel_arguments
+      @validation_parallel_flags = [
+        ('--auto-gen-config' if @validation_flags.key?(:auto_gen_config)),
+        ('-F/--fail-fast' if @validation_flags.key?(:fail_fast)),
+        ('--profile' if @validation_flags[:profile]),
+        ('--memory' if @validation_flags[:memory]),
+        ('--cache false' if @validation_flags > { cache: 'false' })
+      ].compact
+    end
+
+    def only_redundant_disable_option?
+      @validation_flags.key?(:only) &&
+        (@validation_flags[:only] & %w[Lint/RedundantCopDisableDirective
+                                       RedundantCopDisableDirective]).any?
+    end
+
+    def except_syntax_option?
+      @validation_flags.key?(:except) && (@validation_flags[:except] & %w[Lint/Syntax Syntax]).any?
+    end
+
+    def boolean_or_empty_cache_option?
+      !@validation_flags.key?(:cache) || %w[true false].include?(@validation_flags[:cache])
+    end
+
+    def incompatible_exiting_options
+      @validation_conflicts ||= @validation_flags.keys & Options::EXITING_OPTIONS
+    end
+
+    def validate_exclude_limit_value
+      return if /^\d+$/.match?(@validation_flags[:exclude_limit])
+
+      raise OptionParser::MissingArgument
+    end
+
+    def validate_cache_root_requires_cache
+      return unless @validation_flags[:cache] == 'false'
+
+      raise OptionArgumentError, '--cache-root cannot be used with --cache false'
+    end
   end
 end
