+    pub fn render_languages_table(&mut self, config: &Config) {
+        self.listing_buffer.clear();
+        let longest = self.longest_syntax_name();
+        let comma_separator = ", ";
+        let separator = " ";
+        let desired_width = config.term_width - longest - separator.len();
+        let style = if config.colored_output {
+            Green.normal()
+        } else {
+            Style::default()
+        };
+
+        for lang in &self.syntax_entries {
+            write!(
+                self.listing_buffer,
+                "{:width$}{}",
+                lang.name,
+                separator,
+                width = longest
+            )
+            .ok();
+
+            let mut num_chars = 0;
+            let mut extension = lang.file_extensions.iter().peekable();
+            while let Some(word) = extension.next() {
+                let new_chars = word.len() + comma_separator.len();
+                if num_chars + new_chars >= desired_width {
+                    num_chars = 0;
+                    write!(
+                        self.listing_buffer,
+                        "\n{:width$}{}",
+                        "",
+                        separator,
+                        width = longest
+                    )
+                    .ok();
+                }
+
+                num_chars += new_chars;
+                write!(self.listing_buffer, "{}", style.paint(&word[..])).ok();
+                if extension.peek().is_some() {
+                    self.listing_buffer += comma_separator;
+                }
+            }
+            self.listing_buffer += "\n";
+        }
+    }
