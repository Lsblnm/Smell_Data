+                         '--style=plain'. When '-p' is used twice ('-pp'), it also disables \
+                         automatic paging (alias for '--style=plain --paging=never').",
+                    ),
+            )
+            .arg(
+                Arg::new("language")
+                    .short('l')
+                    .long("language")
+                    .overrides_with("language")
