+    pub fn syntax_mapping_from_matches<'a>(
+        &mut self,
+        matches: &'a ArgMatches,
+    ) -> Result<SyntaxMapping<'a>> {
+        let mut syntax_mapping = SyntaxMapping::builtin();
+        self.ignored_suffixes.clear();
+        if let Some(values) = matches.get_many::<String>("ignored-suffix") {
+            for suffix in values {
+                self.ignored_suffixes.push(suffix.to_string());
+                syntax_mapping.insert_ignored_suffix(suffix);
+            }
+        }
+
+        self.syntax_globs.clear();
+        if let Some(values) = matches.get_many::<String>("map-syntax") {
+            for from_to in values {
+                self.syntax_globs.push(from_to.to_string());
+                let parts: Vec<_> = from_to.split(':').collect();
+                if parts.len() != 2 {
+                    return Err("Invalid syntax mapping. The format of the -m/--map-syntax option is '<glob-pattern>:<syntax-name>'. For example: '*.cpp:C++'.".into());
+                }
+                syntax_mapping.insert(parts[0], MappingTarget::MapTo(parts[1]))?;
+            }
+        }
+        Ok(syntax_mapping)
+    }
