+// ParseCaddyfile tokenizes and parses a Caddyfile into server blocks.
+func (st ServerType) ParseCaddyfile(filename string, body []byte) ([]caddyfile.ServerBlock, error) {
+	st.adaptState.filename = filename
+	st.adaptState.body = body
+	return caddyfile.Parse(filename, body)
+}
+
+// ExportAdaptedConfig lints the original Caddyfile and marshals the adapted config.
+func (st ServerType) ExportAdaptedConfig(cfg *caddy.Config, filename string, body []byte, warnings []caddyconfig.Warning) ([]byte, []caddyconfig.Warning, error) {
+	st.adaptState.filename = filename
+	st.adaptState.body = body
+	normalizedBody := bytes.Replace(body, []byte("\r\n"), []byte("\n"), -1)
+	formatted := caddyfile.Format(normalizedBody)
+	if !bytes.Equal(formatted, normalizedBody) {
+		line := 1
+		for i, ch := range normalizedBody {
+			if i >= len(formatted) || ch != formatted[i] {
+				break
+			}
+			if ch == '\n' {
+				line++
+			}
+		}
+		warnings = append(warnings, caddyconfig.Warning{
+			File:    filename,
+			Line:    line,
+			Message: "Caddyfile input is not formatted; run the 'caddy fmt' command to fix inconsistencies",
+		})
+	}
+	result, err := json.Marshal(cfg)
+	return result, warnings, err
+}
