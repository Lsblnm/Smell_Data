+    def sweep_available_transfer_sockets(cache)
+      @transfer_runtime ||= {}
+      @transfer_runtime[:socket_cache] = cache
+      sockets = []
+      mutex = cache.instance_variable_get(:@mutex)
+      mutex.synchronize do
+        available = cache.instance_variable_get(:@available_sockets)
+        inactive = cache.instance_variable_get(:@inactive_sockets)
+        available.each do |_, socks|
+          socks.each do |sock|
+            if transfer_socket_expired?(cache, sock)
+              sockets << sock
+              socks.delete(sock)
+            end
+          end
+        end
+        available.reject! { |_, v| v.empty? }
+        sockets += inactive
+        inactive.clear
+      end
+      sockets.each do |s|
+        s.sock.close rescue nil
+      end
+    end
