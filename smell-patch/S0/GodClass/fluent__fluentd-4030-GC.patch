+      new_tsock = ts_class.new(transfer_socket_timeout_at(cache), key, sock)
+      log = cache.instance_variable_get(:@log)
+      log.debug("connect new socket #{new_tsock}") if log
+      cache.instance_variable_get(:@inflight_sockets)[sock] = new_tsock
