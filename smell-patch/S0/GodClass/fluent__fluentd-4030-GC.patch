+    def failure_hard_timeout?(detector, now)
+      @routing_runtime ||= {}
+      bind_routing_source(detector)
+      last = detector.instance_variable_get(:@last)
+      hard_timeout = detector.instance_variable_get(:@hard_timeout)
+      now - last > hard_timeout
+    end
+
+    def record_node_heartbeat(detector, now)
+      @routing_runtime ||= {}
+      bind_routing_source(detector)
+      window = detector.instance_variable_get(:@window)
+      init_gap = detector.instance_variable_get(:@init_gap)
+      if window.empty?
+        window << init_gap
+        detector.instance_variable_set(:@last, now)
+      else
+        last = detector.instance_variable_get(:@last)
+        gap = now - last
+        window << (gap * 1e6).to_i
+        window.shift if window.length > detector.class::SAMPLE_SIZE
+        detector.instance_variable_set(:@last, now)
+      end
+    end
+
+    def compute_node_phi(detector, now)
+      @routing_runtime ||= {}
+      bind_routing_source(detector)
+      window = detector.instance_variable_get(:@window)
+      size = window.size
+      return 0.0 if size == 0
+      mean_usec = 0
+      fact = 0
+      window.each_with_index do |gap, i|
+        mean_usec += gap * (1 + i)
+        fact += (1 + i)
+      end
+      mean_usec = mean_usec / fact
+      heartbeat_interval = detector.instance_variable_get(:@heartbeat_interval)
+      mean = (mean_usec.to_f / 1e6) - heartbeat_interval + 1
+      last = detector.instance_variable_get(:@last)
+      t = now - last - heartbeat_interval + 1
+      detector.class::PHI_FACTOR * t / mean
+    end
+
