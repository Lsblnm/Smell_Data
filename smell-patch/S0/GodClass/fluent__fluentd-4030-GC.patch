+    def pick_available_transfer_socket(cache, key)
+      @transfer_runtime ||= {}
+      @transfer_runtime[:socket_cache] = cache
+      available = cache.instance_variable_get(:@available_sockets)
+      inflight = cache.instance_variable_get(:@inflight_sockets)
+      if available[key].empty?
+        return nil
+      end
+
+      t = Time.now
+      if (s = available[key].find { |sock| !transfer_socket_expired?(cache, sock, time: t) })
+        inflight[s.sock] = available[key].delete(s)
+        s.timeout = transfer_socket_timeout_at(cache)
+        s
+      else
+        nil
+      end
+    end
