+    def open_keepalive_connection(manager, host:, port:, hostname:, ack: nil, &block)
+      @transfer_runtime ||= {}
+      bind_transfer_manager(manager)
+      @transfer_runtime[:keepalive_endpoint] = [host, port, hostname]
+      cache = manager.instance_variable_get(:@socket_cache)
+      factory = manager.instance_variable_get(:@connection_factory)
+      request_info = connection_request_info(manager, existing: true)
+      socket = cache.checkout_or([host, port, hostname]) do
+        s = factory.call(host, port, hostname)
+        request_info = connection_request_info(manager, existing: false)
+        s
+      end
+
+      unless block
+        return [socket, request_info]
+      end
+
+      ret = nil
+      begin
+        ret = yield(socket, request_info)
+      rescue
+        cache.revoke(socket)
+        raise
+      else
+        if ack
+          ack.enqueue(socket)
+        else
+          cache.checkin(socket)
+        end
+      end
+      ret
+    end
