+    def select_healthy_forward_node(balancer)
+      @routing_runtime ||= {}
+      bind_routing_source(balancer)
+      error = nil
+      weight_array = balancer.instance_variable_get(:@weight_array)
+      mutex = balancer.instance_variable_get(:@mutex)
+      wlen = weight_array.size
+      wlen.times do
+        node = mutex.synchronize do
+          rr = balancer.instance_variable_get(:@rr)
+          r = rr % balancer.instance_variable_get(:@weight_array).size
+          balancer.instance_variable_set(:@rr, (r + 1) % balancer.instance_variable_get(:@weight_array).size)
+          balancer.instance_variable_get(:@weight_array)[r]
+        end
+        next unless node.available?
+
+        begin
+          ret = yield node
+          return ret, node
+        rescue
+          error = $!
+        end
+      end
+
+      raise error if error
+      raise NoNodesAvailable, "no nodes are available"
+    end
