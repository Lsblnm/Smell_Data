+    def transfer_socket_timeout_at(cache)
+      @transfer_runtime ||= {}
+      @transfer_runtime[:socket_cache] = cache
+      timeout = cache.instance_variable_get(:@timeout)
+      timeout && Time.now + timeout
+    end
