+    def establish_node_session(node, sock, ri)
+      @routing_runtime ||= {}
+      bind_routing_source(node)
+      sender = node.instance_variable_get(:@sender)
+      handshake = node.instance_variable_get(:@handshake)
+      log = node.instance_variable_get(:@log)
+      host = node.instance_variable_get(:@host)
+      port = node.instance_variable_get(:@port)
+      name = node.instance_variable_get(:@name)
+      while ri.state != :established
+        begin
+          buf = sock.read_nonblock(sender.read_length)
+          if buf.empty?
+            sleep sender.read_interval
+            next
+          end
+          Fluent::MessagePackFactory.msgpack_unpacker.feed_each(buf) do |data|
+            if handshake.invoke(sock, ri, data) == :established
+              log.debug "connection established", host: host, port: port if log
+            end
+          end
+        rescue IO::WaitReadable
+          sleep sender.read_interval unless ri.state == :established
+        rescue SystemCallError => e
+          log.warn "disconnected by error", host: host, port: port, error: e if log
+          node.disable!
+          break
+        rescue EOFError
+          log.warn "disconnected", host: host, port: port if log
+          node.disable!
+          break
+        rescue HeloError
+          log.warn "received invalid helo message from #{name}" if log
+          node.disable!
+          break
+        rescue PingpongError => e
+          log.warn "connection refused to #{name || host}: #{e.message}" if log
+          node.disable!
+          break
+        end
+      end
+    end
+
+    def send_node_data_actual(node, sock, tag, chunk)
+      @routing_runtime ||= {}
+      bind_routing_source(node)
+      compress = node.instance_variable_get(:@compress)
+      ack_handler = node.instance_variable_get(:@ack_handler)
+      sender = node.instance_variable_get(:@sender)
+      option = { 'size' => chunk.size, 'compressed' => compress }
+      option['chunk'] = Base64.encode64(chunk.unique_id) if ack_handler
+      tag = tag.dup.force_encoding(Encoding::UTF_8)
+      sock.write sender.forward_header
+      sock.write tag.to_msgpack
+      chunk.open(compressed: compress) do |chunk_io|
+        entries = [0xdb, chunk_io.size].pack('CN')
+        sock.write entries.force_encoding(Encoding::UTF_8)
+        IO.copy_stream(chunk_io, sock)
+      end
+      sock.write option.to_msgpack
+    end
+
+    def send_node_data(node, tag, chunk)
+      @routing_runtime ||= {}
+      bind_routing_source(node)
+      ack_handler = node.instance_variable_get(:@ack_handler)
+      ack = ack_handler && ack_handler.create_ack(chunk.unique_id, node)
+      connect_node_socket(node, nil, ack) do |sock, ri|
+        ensure_node_established(node, sock, ri)
+        send_node_data_actual(node, sock, tag, chunk)
+      end
+      heartbeat_node(node, false)
+      nil
+    end
