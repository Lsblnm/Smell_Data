+    def rebuild_forward_weight_array(balancer, nodes)
+      @routing_runtime ||= {}
+      bind_routing_source(balancer)
+      standby_nodes, regular_nodes = split_nodes_by_standby(balancer, nodes)
+      lost_weight = recover_weight_from_standby(balancer, regular_nodes, standby_nodes)
+      log = balancer.instance_variable_get(:@log)
+      if regular_nodes.empty?
+        log.warn('No nodes are available') if log
+        mutex = balancer.instance_variable_get(:@mutex)
+        mutex.synchronize do
+          balancer.instance_variable_set(:@weight_array, [])
+        end
+        return balancer.instance_variable_get(:@weight_array)
+      end
+      weight_array = materialize_weight_array(balancer, regular_nodes)
+      weight_array = shuffle_weight_array(balancer, weight_array)
+      mutex = balancer.instance_variable_get(:@mutex)
+      mutex.synchronize do
+        balancer.instance_variable_set(:@weight_array, weight_array)
+      end
+      balancer.instance_variable_get(:@weight_array)
+    end
+
+    def split_nodes_by_standby(balancer, nodes)
+      @routing_runtime ||= {}
+      bind_routing_source(balancer)
+      nodes.select { |e| e.weight > 0 }.partition { |n| n.standby? }
+    end
+
+    def recover_weight_from_standby(balancer, regular_nodes, standby_nodes)
+      @routing_runtime ||= {}
+      bind_routing_source(balancer)
+      lost_weight = 0
+      regular_nodes.each do |n|
+        unless n.available?
+          lost_weight += n.weight
+        end
+      end
+      log = balancer.instance_variable_get(:@log)
+      log.debug("rebuilding weight array", lost_weight: lost_weight) if log
+      if lost_weight > 0
+        standby_nodes.each do |n|
+          if n.available?
+            regular_nodes << n
+            log.warn "using standby node #{n.host}:#{n.port}", weight: n.weight if log
+            lost_weight -= n.weight
+            break if lost_weight <= 0
+          end
+        end
+      end
+      lost_weight
+    end
+
+    def materialize_weight_array(balancer, regular_nodes)
+      @routing_runtime ||= {}
+      bind_routing_source(balancer)
+      weight_array = []
+      gcd = regular_nodes.map { |n| n.weight }.inject(0) { |r, w| r.gcd(w) }
+      regular_nodes.each do |n|
+        (n.weight / gcd).times do
+          weight_array << n
+        end
+      end
+      coe = (regular_nodes.size * 6) / weight_array.size
+      weight_array *= coe if coe > 1
+      weight_array
+    end
+
+    def shuffle_weight_array(balancer, weight_array)
+      @routing_runtime ||= {}
+      bind_routing_source(balancer)
+      seed = balancer.instance_variable_get(:@rand_seed)
+      r = Random.new(seed)
+      weight_array.sort_by! { r.rand }
+      weight_array
+    end
+
+    def perform_handshake_step(handshake, sock, ri, data)
+      @routing_runtime ||= {}
+      bind_routing_source(handshake)
+      case ri.state
+      when :helo
+        unless verify_helo_payload(handshake, ri, data)
+          raise HeloError, 'received invalid helo message'
+        end
+        sock.write(compose_ping_payload(handshake, ri).to_msgpack)
+        ri.state = :pingpong
+      when :pingpong
+        succeeded, reason = verify_pong_payload(handshake, ri, data)
+        unless succeeded
+          raise PingpongError, reason
+        end
+        ri.state = :established
+      else
+        raise "BUG: unknown session state: #{ri.state}"
+      end
+    end
+
+    def verify_helo_payload(handshake, ri, message)
+      @routing_runtime ||= {}
+      bind_routing_source(handshake)
+      log = handshake.instance_variable_get(:@log)
+      log.debug('checking helo') if log
+      unless message.size == 2 && message[0] == 'HELO'
+        return false
+      end
+      opts = message[1] || {}
+      ri.shared_key_nonce = opts['nonce'] || ''
+      ri.auth = opts['auth'] || ''
+      true
+    end
+
+    def verify_pong_payload(handshake, ri, message)
+      @routing_runtime ||= {}
+      bind_routing_source(handshake)
+      log = handshake.instance_variable_get(:@log)
+      log.debug('checking pong') if log
+      unless message.size == 5 && message[0] == 'PONG'
+        return false, 'invalid format for PONG message'
+      end
+      _pong, auth_result, reason, hostname, shared_key_hexdigest = message
+      unless auth_result
+        return false, 'authentication failed: ' + reason
+      end
+      if hostname == handshake.instance_variable_get(:@hostname)
+        return false, 'same hostname between input and output: invalid configuration'
+      end
+      salt = handshake.instance_variable_get(:@shared_key_salt)
+      shared_key = handshake.instance_variable_get(:@shared_key)
+      clientside = Digest::SHA512.new.update(salt).update(hostname).update(ri.shared_key_nonce).update(shared_key).hexdigest
+      unless shared_key_hexdigest == clientside
+        return false, 'shared key mismatch'
+      end
+      [true, nil]
+    end
+
+    def compose_ping_payload(handshake, ri)
+      @routing_runtime ||= {}
+      bind_routing_source(handshake)
+      log = handshake.instance_variable_get(:@log)
+      log.debug('generating ping') if log
+      salt = handshake.instance_variable_get(:@shared_key_salt)
+      hostname = handshake.instance_variable_get(:@hostname)
+      shared_key = handshake.instance_variable_get(:@shared_key)
+      username = handshake.instance_variable_get(:@username)
+      password = handshake.instance_variable_get(:@password)
+      shared_key_hexdigest = Digest::SHA512.new.update(salt)
+        .update(hostname)
+        .update(ri.shared_key_nonce)
+        .update(shared_key)
+        .hexdigest
+      ping = ['PING', hostname, salt, shared_key_hexdigest]
+      if !ri.auth.empty?
+        if username.nil? || password.nil?
+          raise PingpongError, "username and password are required"
+        end
+        password_hexdigest = Digest::SHA512.new.update(ri.auth).update(username).update(password).hexdigest
+        ping.push(username, password_hexdigest)
+      else
+        ping.push('', '')
+      end
+      ping
+    end
+
+    def new_handshake_salt(handshake)
+      @routing_runtime ||= {}
+      bind_routing_source(handshake)
+      SecureRandom.hex(16)
+    end
