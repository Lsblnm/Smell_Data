+    def heartbeat_node_packet(node)
+      @routing_runtime ||= {}
+      bind_routing_source(node)
+      sender = node.instance_variable_get(:@sender)
+      log = node.instance_variable_get(:@log)
+      name = node.instance_variable_get(:@name)
+      host = node.instance_variable_get(:@host)
+      port = node.instance_variable_get(:@port)
+      begin
