+/* Format a signed integer into dst, returning the number of characters
+ * written (excluding the terminator). This keeps integer-to-text conversion
+ * next to the other numeric helpers used by string payloads. */
+size_t utilFormatSignedInteger(char *dst, size_t dstlen, long long value) {
+    int written;
+    if (dst == NULL || dstlen == 0) return 0;
+    written = ll2string(dst, dstlen, value);
+    if (written < 0) return 0;
+    return (size_t) written;
+}
