+      def configure_cloned_git_user(storage)
+        @git_workspace_state ||= {}
+        user_name = storage.git_full_name
+        user_email = storage.git_user_email
+        commands = []
+        commands << "git config user.name \"#{user_name}\"" unless user_name.nil?
+        commands << "git config user.email \"#{user_email}\"" unless user_email.nil?
+        @git_workspace_state[:user_commands] = commands
+        return if commands.empty?
