+          @git_workspace_state[:valid] = false
+          UI.user_error!("A git_url is required to clone match certificates")
+        elsif url.include?(" ") && !url.start_with?("file://")
+          @git_workspace_state[:valid] = false
+          UI.user_error!("The git_url '#{url}' contains spaces and cannot be used")
+        elsif branch.empty?
+          @git_workspace_state[:branch] = "master"
+          @git_workspace_state[:valid] = true
+        else
+          @git_workspace_state[:valid] = true
+        end
+        @git_workspace_state[:valid]
+      end
+
+      def git_remote_protocol(url)
+        @git_workspace_state ||= {}
+        normalized = url.to_s.strip
+        protocol = if normalized.empty?
+                     "missing"
+                   elsif normalized.start_with?("git@", "ssh://")
+                     "ssh"
+                   elsif normalized.start_with?("https://")
+                     "https"
+                   elsif normalized.start_with?("http://")
+                     "http"
+                   elsif normalized.start_with?("file://") || normalized.start_with?("/")
+                     "local"
+                   elsif normalized.include?(":") && !normalized.include?("://")
+                     "ssh"
+                   else
+                     "unknown"
+                   end
+        @git_workspace_state[:protocol] = protocol
+        protocol
+      end
+
+      def git_clone_uses_ssh?(url)
+        @git_workspace_state ||= {}
+        protocol = git_remote_protocol(url)
+        uses_ssh = protocol == "ssh"
+        @git_workspace_state[:uses_ssh] = uses_ssh
+        uses_ssh
+      end
+
+      def git_clone_uses_https?(url)
+        @git_workspace_state ||= {}
+        protocol = git_remote_protocol(url)
+        uses_https = protocol == "https" || protocol == "http"
+        @git_workspace_state[:uses_https] = uses_https
+        uses_https
+      end
