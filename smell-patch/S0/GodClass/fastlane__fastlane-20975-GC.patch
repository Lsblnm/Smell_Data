+                         .map { |k, v| [mapping.fetch(k, k), v] }
+        @certificate_state[:subject_pairs] = pairs
+        pairs
+      end
+
+      def readable_certificate_attribute_map
+        @certificate_state ||= {}
+        mapping = {
+          'UID' => 'User ID',
+          'CN' => 'Common Name',
+          'OU' => 'Organisation Unit',
+          'O' => 'Organisation',
+          'C' => 'Country',
+          'notBefore' => 'Start Datetime',
+          'notAfter' => 'End Datetime'
+        }
+        @certificate_state[:attribute_map] = mapping
+        mapping
+      end
+
+      def load_certificate_binary(cer_certificate)
+        @certificate_state ||= {}
+        data = cer_certificate
+        begin
+          if File.exist?(cer_certificate)
+            data = File.binread(cer_certificate)
+            @certificate_state[:source] = "path"
+          else
+            @certificate_state[:source] = "inline"
+          end
+        rescue ArgumentError
