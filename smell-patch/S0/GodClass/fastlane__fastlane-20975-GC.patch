+
+      def encrypt_match_file(path: nil, password: nil, keychain_name: nil, working_directory: nil)
+        @encryption_state ||= {}
+        capture_encryption_settings(keychain_name, working_directory, password)
+        validate_match_encryption_password(password)
+        data_to_encrypt = File.binread(path)
+        salt = SecureRandom.random_bytes(8)
+        cipher = build_match_encryption_cipher(password, salt)
+        encrypted_data = salted_encrypted_payload(cipher, data_to_encrypt, salt)
+        File.write(path, Base64.encode64(encrypted_data))
+        @encryption_state[:last_encrypted_path] = path
+        path
+      rescue FastlaneCore::Interface::FastlaneError
+        raise
+      rescue => error
+        UI.error(error.to_s)
+        UI.crash!("Error encrypting '#{path}'")
+      end
+
+      def decrypt_match_file(path: nil, password: nil, hash_algorithm: "MD5", keychain_name: nil, working_directory: nil)
