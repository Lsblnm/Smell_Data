+      def stage_and_push_git_commands(storage, commands, custom_message)
+        @git_workspace_state ||= {}
+        commit_message = compose_git_commit_message(storage, custom_message)
+        commands = commands.dup
+        commands << "git commit -m #{commit_message.shellescape}"
+        git_push_command = "git push origin #{storage.branch.shellescape}"
+        git_push_command = wrap_git_command_with_private_key(storage, git_push_command) unless storage.git_private_key.nil?
+        commands << git_push_command
+        @git_workspace_state[:push_commands] = commands
+        UI.message("Pushing changes to remote git repo...")
+        begin
+          Helper.with_env_values('GIT_TERMINAL_PROMPT' => '0') do
+            commands.each do |command|
+              FastlaneCore::CommandExecutor.execute(command: command,
+                                                print_all: FastlaneCore::Globals.verbose?,
+                                            print_command: FastlaneCore::Globals.verbose?)
+            end
+          end
+          @git_workspace_state[:push_status] = "ok"
+        rescue => ex
+          @git_workspace_state[:push_status] = "failed"
+          UI.error("Couldn't commit or push changes back to git...")
+          UI.error(ex)
+        end
+      end
