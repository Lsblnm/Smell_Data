+        UI.message("Add git user config to local git repo...")
+        run_git_commands(storage.working_directory, commands)
+      end
+
+      def checkout_cloned_git_branch(storage)
+        @git_workspace_state ||= {}
+        return unless storage.working_directory
+
+        commands = []
+        if git_remote_branch_exists?(storage)
+          commands << "git checkout #{storage.branch.shellescape}"
+          @git_workspace_state[:checkout_mode] = "existing"
+        else
+          commands << "git checkout --orphan #{storage.branch.shellescape}"
+          commands << "git reset --hard"
+          @git_workspace_state[:checkout_mode] = "orphan"
+        end
+        UI.message("Checking out branch #{storage.branch}...")
+        run_git_commands(storage.working_directory, commands)
+      end
+
+      def git_remote_branch_exists?(storage)
+        @git_workspace_state ||= {}
+        return false unless storage.working_directory
+
+        result = Dir.chdir(storage.working_directory) do
+          FastlaneCore::CommandExecutor.execute(command: "git --no-pager branch --list origin/#{storage.branch.shellescape} --no-color -r",
+                                                print_all: FastlaneCore::Globals.verbose?,
+                                                print_command: FastlaneCore::Globals.verbose?)
+        end
+        exists = !result.to_s.empty?
+        @git_workspace_state[:remote_branch_exists] = exists
