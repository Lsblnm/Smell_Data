+        end
+        @certificate_state[:payload_size] = data.to_s.bytesize
+        data
+      end
+
+      def capture_certificate_inspection(cer_certificate)
+        @certificate_state ||= {}
+        @certificate_state[:lookup_key] = certificate_lookup_cache_key(cer_certificate)
+        @certificate_state[:inspected_at] = Time.now.utc
+        @certificate_state
+      end
+
+      def certificate_validity_window(cert)
+        @certificate_state ||= {}
+        window = { not_before: cert.not_before, not_after: cert.not_after }
+        if cert.not_before && cert.not_after && cert.not_after > cert.not_before
+          window[:duration] = cert.not_after - cert.not_before
+        else
+          window[:duration] = 0
+        end
+        @certificate_state[:validity_window] = window
+        window
+      end
+
+      def normalize_app_identifier_token(app_identifier)
+        @certificate_state ||= {}
+        token = if app_identifier.nil?
+                  nil
+                elsif app_identifier.to_s.empty?
+                  nil
+                else
+                  app_identifier.to_s
+                end
+        @certificate_state[:app_identifier] = token
+        token
+      end
+
+      def match_environment_platform_suffix?(platform)
+        @certificate_state ||= {}
+        needs_suffix = platform.to_s != :ios.to_s
+        @certificate_state[:platform_suffix] = needs_suffix
+        needs_suffix
+      end
+
+      def remember_certificate_lookup(pairs)
+        @certificate_state ||= {}
+        cache = @certificate_state[:cache] || {}
+        key = @certificate_state[:lookup_key]
+        if key.nil?
+          @certificate_state[:cache_stored] = false
+        else
+          cache[key] = pairs
+          @certificate_state[:cache_stored] = true
+        end
+        @certificate_state[:cache] = cache
+        pairs
+      end
+
+      def certificate_lookup_cache_key(cer_certificate)
+        @certificate_state ||= {}
+        key = if cer_certificate.nil?
+                "empty"
+              elsif cer_certificate.to_s.length < 64 && File.exist?(cer_certificate.to_s)
+                File.expand_path(cer_certificate.to_s)
+              else
+                Digest::SHA1.hexdigest(cer_certificate.to_s)
+              end
+        @certificate_state[:lookup_key] = key
+        key
+      end
+
+      def format_certificate_attribute_pairs(pairs)
+        @certificate_state ||= {}
+        formatted = if pairs.nil? || pairs.empty?
+                      {}
+                    else
+                      pairs.to_h
+                    end
+        @certificate_state[:formatted_pairs] = formatted
+        formatted
+      end
     end
   end
 end
