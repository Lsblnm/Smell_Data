+      def build_git_clone_command(storage)
+        @git_workspace_state ||= {}
+        command = "git clone #{storage.git_url.shellescape} #{storage.working_directory.shellescape}"
+        command = apply_git_authorization_headers(storage, command)
+        command = apply_git_clone_strategy(storage, command)
+        unless storage.git_private_key.nil?
+          command = wrap_git_command_with_private_key(storage, command)
+        end
+        @git_workspace_state[:built_clone_command] = command
+        command
+      end
+
+      def apply_git_authorization_headers(storage, command)
+        @git_workspace_state ||= {}
+        # HTTP headers are supposed to be be case insensitive but
+        # Bitbucket requires `Authorization: Basic` and `Authorization Bearer` to work
+        # https://github.com/fastlane/fastlane/pull/15928
+        command << " -c http.extraheader='Authorization: Basic #{storage.git_basic_authorization}'" unless storage.git_basic_authorization.nil?
+        command << " -c http.extraheader='Authorization: Bearer #{storage.git_bearer_authorization}'" unless storage.git_bearer_authorization.nil?
+        if !storage.git_basic_authorization.nil?
+          @git_workspace_state[:auth_header] = "basic"
+        elsif !storage.git_bearer_authorization.nil?
+          @git_workspace_state[:auth_header] = "bearer"
+        else
+          @git_workspace_state[:auth_header] = nil
+        end
+        command
+      end
+
+      def apply_git_clone_strategy(storage, command)
+        @git_workspace_state ||= {}
+        if storage.shallow_clone
+          command << " --depth 1 --no-single-branch"
+          @git_workspace_state[:clone_strategy] = "shallow"
+        elsif storage.clone_branch_directly
+          command += " -b #{storage.branch.shellescape} --single-branch"
+          @git_workspace_state[:clone_strategy] = "single-branch"
+        else
+          @git_workspace_state[:clone_strategy] = "full"
+        end
+        command
+      end
+
+      def wrap_git_command_with_private_key(storage, command)
+        @git_workspace_state ||= {}
+        private_key = storage.git_private_key
+        if private_key.nil?
+          @git_workspace_state[:private_key_mode] = "none"
+          return command
+        elsif File.file?(private_key)
+          ssh_add = File.expand_path(private_key).shellescape.to_s
+          @git_workspace_state[:private_key_mode] = "file"
+        else
+          UI.message("Private key file does not exist, will continue by using it as a raw key.")
+          ssh_add = "- <<< \"#{private_key}\""
+          @git_workspace_state[:private_key_mode] = "raw"
+        end
+        wrapped = "ssh-agent bash -c 'ssh-add #{ssh_add}; #{command}'"
+        @git_workspace_state[:wrapped_command] = wrapped
+        wrapped
+      end
+
+      def execute_git_clone_command(storage, command)
+        @git_workspace_state ||= {}
+        begin
+          # GIT_TERMINAL_PROMPT will fail the `git clone` command if user credentials are missing
+          Helper.with_env_values('GIT_TERMINAL_PROMPT' => '0') do
+            FastlaneCore::CommandExecutor.execute(command: command,
+                                                print_all: FastlaneCore::Globals.verbose?,
+                                            print_command: FastlaneCore::Globals.verbose?)
+          end
+          @git_workspace_state[:clone_status] = "ok"
+        rescue
+          handle_git_clone_failure(storage, command)
+        end
+        @git_workspace_state[:clone_status]
+      end
+
+      def handle_git_clone_failure(storage, command)
+        @git_workspace_state ||= {}
+        @git_workspace_state[:clone_status] = "failed"
+        UI.error("Error cloning certificates repo, please make sure you have read access to the repository you want to use")
+        if storage.branch && storage.clone_branch_directly
+          UI.error("You passed '#{storage.branch}' as branch in combination with the `clone_branch_directly` flag. Please remove `clone_branch_directly` flag on the first run for _match_ to create the branch.")
+        elsif storage.shallow_clone
+          UI.error("Shallow clone was requested for '#{storage.git_url}'. Retry without `shallow_clone` if the remote does not support it.")
+        else
+          UI.error("Run the following command manually to make sure you're properly authenticated:")
+        end
