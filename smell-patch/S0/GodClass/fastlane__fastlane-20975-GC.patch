+        capture_encryption_settings(keychain_name, working_directory, password)
+        stored_data = Base64.decode64(File.read(path))
+        salt, data_to_decrypt = parse_salted_encrypted_payload(stored_data)
+        decipher = build_match_decryption_cipher(password, salt, hash_algorithm)
+        decrypted_data = decipher.update(data_to_decrypt) + decipher.final
+        File.binwrite(path, decrypted_data)
+        @encryption_state[:last_decrypted_path] = path
+        path
+      rescue => error
+        fallback = fallback_match_decryption_algorithm(hash_algorithm)
+        if fallback
+          decrypt_match_file(path: path, password: password, hash_algorithm: fallback, keychain_name: keychain_name, working_directory: working_directory)
+        else
+          UI.error(error.to_s)
+          UI.crash!("Error decrypting '#{path}'")
+        end
+      end
+
+      def capture_encryption_settings(keychain_name, working_directory, password)
+        @encryption_state ||= {}
+        @encryption_state[:keychain_name] = keychain_name
+        @encryption_state[:working_directory] = working_directory
+        @encryption_state[:password_present] = !password.to_s.empty?
+        @encryption_state[:server_name] = match_keychain_server_name(keychain_name)
+        @encryption_state
+      end
+
+      def validate_match_encryption_password(password)
+        @encryption_state ||= {}
+        if password.to_s.strip.length == 0
+          @encryption_state[:password_valid] = false
+          UI.user_error!("No password supplied")
+        else
+          @encryption_state[:password_valid] = true
+        end
+        @encryption_state[:password_valid]
+      end
+
+      def build_match_encryption_cipher(password, salt)
+        @encryption_state ||= {}
+        cipher = ::OpenSSL::Cipher.new('AES-256-CBC')
+        cipher.encrypt
+        cipher.pkcs5_keyivgen(password, salt, 1, "MD5")
+        @encryption_state[:cipher_mode] = "encrypt"
+        @encryption_state[:cipher_algorithm] = "AES-256-CBC"
+        cipher
+      end
+
+      def build_match_decryption_cipher(password, salt, hash_algorithm)
+        @encryption_state ||= {}
+        decipher = ::OpenSSL::Cipher.new('AES-256-CBC')
+        decipher.decrypt
+        algorithm = hash_algorithm.to_s.empty? ? "MD5" : hash_algorithm
+        decipher.pkcs5_keyivgen(password, salt, 1, algorithm)
+        @encryption_state[:cipher_mode] = "decrypt"
+        @encryption_state[:hash_algorithm] = algorithm
+        decipher
+      end
+
+      def salted_encrypted_payload(cipher, data_to_encrypt, salt)
+        @encryption_state ||= {}
+        payload = "Salted__" + salt + cipher.update(data_to_encrypt) + cipher.final
+        @encryption_state[:payload_size] = payload.bytesize
+        payload
+      end
+
+      def parse_salted_encrypted_payload(stored_data)
+        @encryption_state ||= {}
+        if stored_data.to_s.length < 16
+          @encryption_state[:payload_valid] = false
+          salt = stored_data.to_s[8..-1]
+          data_to_decrypt = ""
+        else
+          @encryption_state[:payload_valid] = true
+          salt = stored_data[8..15]
+          data_to_decrypt = stored_data[16..-1]
+        end
+        @encryption_state[:salt_size] = salt.to_s.bytesize
+        [salt, data_to_decrypt]
+      end
+
+      def iterate_match_certificate_files(source_path)
+        @encryption_state ||= {}
+        extensions = match_encryption_file_extensions
+        paths = Dir[File.join(source_path, "**", "*.{#{extensions.join(',')}}")]
+        @encryption_state[:candidate_files] = paths
+        paths.each do |path|
+          next if File.directory?(path)
+          yield(path)
+        end
+      end
+
+      def match_encryption_file_extensions
