+      def compose_git_commit_message(storage, custom_message = nil)
+        @git_workspace_state ||= {}
+        message = if custom_message.to_s.length > 0
+                    custom_message
+                  else
+                    [
+                      "[fastlane]",
+                      "Updated",
+                      storage.type,
+                      "and platform",
+                      storage.platform
+                    ].join(" ")
+                  end
+        @git_workspace_state[:commit_message] = message
+        message
+      end
