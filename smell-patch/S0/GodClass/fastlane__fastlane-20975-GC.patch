+      def push_git_storage_changes(storage, files_to_upload, custom_message)
+        @git_workspace_state ||= {}
+        capture_git_storage_settings(storage)
+        commands = files_to_upload.map do |current_file|
+          "git add #{current_file.shellescape}"
+        end
+        if files_to_upload.nil? || files_to_upload.empty?
+          @git_workspace_state[:push_mode] = "empty"
+        else
+          @git_workspace_state[:push_mode] = "files"
+        end
+        stage_and_push_git_commands(storage, commands, custom_message)
+      end
+
+      def delete_git_storage_changes(storage, files_to_delete, custom_message)
+        @git_workspace_state ||= {}
+        capture_git_storage_settings(storage)
+        commands = ["git add -A"]
+        if files_to_delete.nil? || files_to_delete.empty?
+          @git_workspace_state[:delete_mode] = "all"
+        else
+          @git_workspace_state[:delete_mode] = "listed"
