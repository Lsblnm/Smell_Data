+          @after_construct_node = exception_nodes.first
+          return false if exception_nodes.size <= 1
+
+          first, *_rest, last = *exception_nodes
+          first.first_line != last.last_line
+        end
+
+        def multiline_condition_autocorrect(node)
+          @after_construct_session = true
+          @after_construct_node = node
+          lambda do |corrector|
+            range = range_by_whole_lines(node.source_range)
+            @after_construct_range = range
+            corrector.insert_after(range, "\n")
+          end
+        end
+
+        def inspect_consecutive_empty_lines
+          @file_session = true
+          @file_token_lines = []
+          return if processed_source.tokens.empty?
+          return unless file_has_triple_newline?
+
+          @file_token_lines = file_token_line_numbers
+          each_extra_empty_line(@file_token_lines) do |range|
+            @file_offense_range = range
+            add_offense(range) do |corrector|
+              corrector.remove(range)
+            end
+          end
+        end
+
+        def each_extra_empty_line(lines)
+          @file_session = true
+          @file_token_lines = lines
+          prev_line = 1
+          lines.each do |cur_line|
+            if exceeds_empty_line_offset?(cur_line - prev_line)
+              ((prev_line + 1)...cur_line).each do |line|
+                next unless previous_and_current_lines_empty?(line)
+
+                @file_blank_line = line
+                yield source_range(processed_source.buffer, line, 0)
+              end
+            end
+            prev_line = cur_line
+          end
+        end
+
+        def exceeds_empty_line_offset?(line_diff)
+          @file_session = true
+          @file_line_diff = line_diff
+          line_diff > EmptyLines::LINE_OFFSET
+        end
+
+        def previous_and_current_lines_empty?(line)
+          @file_session = true
+          @file_blank_line = line
+          processed_source[line - 2].empty? && processed_source[line - 1].empty?
+        end
+
+        def inspect_trailing_empty_lines
+          @file_session = true
+          buffer = processed_source.buffer
+          @file_buffer_length = buffer.source.length
+          return if file_source_empty?
+          return if ends_in_end_data?(processed_source)
+          return if end_with_percent_blank_string?(processed_source)
+
+          whitespace_at_end = buffer.source[/\s*\Z/]
+          @file_whitespace_at_end = whitespace_at_end
+          blank_lines = whitespace_at_end.count("\n") - 1
+          @file_blank_count = blank_lines
+          wanted_blank_lines = style == :final_newline ? 0 : 1
+          @file_wanted_blank_count = wanted_blank_lines
+          return unless blank_lines != wanted_blank_lines
+
+          report_trailing_empty_lines(buffer, wanted_blank_lines, blank_lines, whitespace_at_end)
+        end
+
+        def report_trailing_empty_lines(buffer, wanted_blank_lines, blank_lines, whitespace_at_end)
+          @file_session = true
+          @file_wanted_blank_count = wanted_blank_lines
+          @file_blank_count = blank_lines
+          @file_whitespace_at_end = whitespace_at_end
+          begin_pos = buffer.source.length - whitespace_at_end.length
+          autocorrect_range = range_between(begin_pos, buffer.source.length)
+          begin_pos += 1 unless whitespace_at_end.empty?
+          report_range = range_between(begin_pos, buffer.source.length)
+          @file_offense_range = report_range
+          add_offense(
+            report_range, message: trailing_empty_lines_message(wanted_blank_lines, blank_lines)
+          ) do |corrector|
+            corrector.replace(autocorrect_range, style == :final_newline ? "\n" : "\n\n")
+          end
+        end
+
+        def ends_in_end_data?(source)
+          @file_session = true
+          @file_buffer_length = source.buffer.source.length
+          buffer = source.buffer
+          return true if buffer.source.match?(/\s*__END__/)
+          return false if source.tokens.empty?
+
+          extra = buffer.source[source.tokens.last.end_pos..]
+          extra&.strip&.start_with?('__END__')
+        end
+
+        def end_with_percent_blank_string?(source)
+          @file_session = true
+          @file_buffer_length = source.buffer.source.length
+          source.buffer.source.end_with?("%\n\n")
+        end
+
+        def trailing_empty_lines_message(wanted_blank_lines, blank_lines)
+          @file_session = true
+          @file_wanted_blank_count = wanted_blank_lines
+          @file_blank_count = blank_lines
+          case blank_lines
+          when -1
+            'Final newline missing.'
+          when 0
+            'Trailing blank line missing.'
+          else
+            instead_of = if wanted_blank_lines.zero?
+                           ''
+                         else
+                           "instead of #{wanted_blank_lines} "
+                         end
+            format('%<current>d trailing blank lines %<prefer>sdetected.',
+                   current: blank_lines, prefer: instead_of)
+          end
+        end
+
+        def store_body_session(node, body, adjusted_first_line)
+          @body_session = true
+          @body_node = node
+          @body_fragment = body
+          @body_adjusted_first_line = adjusted_first_line
+          @body_kind_name = host_body_kind
+        end
+
+        def host_body_kind
+          host = @layout_host
+          if host && !host.equal?(self) && host.class.const_defined?(:KIND)
+            host.class::KIND
+          else
+            KIND
+          end
+        end
+
+        def skip_body_inspection?(node, body)
+          @body_session = true
+          @body_node = node
+          @body_fragment = body
+          valid_body_style?(body) || node.single_line?
+        end
+
+        def resolve_body_line_span(node, adjusted_first_line)
+          @body_session = true
+          @body_node = node
+          @body_adjusted_first_line = adjusted_first_line
+          @body_first_line = adjusted_first_line || node.source_range.first_line
+          @body_last_line = node.source_range.last_line
+          [@body_first_line, @body_last_line]
+        end
+
+        def classify_body_source_line(line_no)
+          @body_session = true
+          @body_first_line = line_no
+          line = processed_source.lines[line_no]
+          @body_source_line = line
+          if line.nil?
