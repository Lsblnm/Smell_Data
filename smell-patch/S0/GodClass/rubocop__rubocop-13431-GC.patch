+          elsif line.empty?
+            :empty
+          elsif comment_line?(line)
+            :comment
+          else
+            :code
+          end
+        end
+
+        def body_line_empty?(line_no)
+          @body_session = true
+          classify_body_source_line(line_no) == :empty
+        end
+
+        def body_requires_empty_line_style?(style_name)
+          @body_session = true
+          @body_style = style_name
+          style_name == :empty_lines || style_name == :beginning_only || style_name == :ending_only
+        end
+
+        def body_forbids_empty_line_style?(style_name)
+          @body_session = true
+          @body_style = style_name
+          style_name == :no_empty_lines
+        end
+
+        def register_body_line_offense(style_name, line, msg)
+          @body_session = true
+          @body_style = style_name
+          @body_first_line = line
+          @body_offense_message = msg
+          inspect_body_line(style_name, line, msg) { |source_line| body_line_matches_style?(style_name, source_line) }
+        end
+
+        def body_line_matches_style?(style_name, source_line)
+          @body_session = true
+          @body_style = style_name
+          @body_source_line = source_line
+          if style_name == :no_empty_lines
+            source_line.empty?
+          elsif style_name == :empty_lines
+            !source_line.empty?
+          else
+            false
+          end
+        end
+
+        def argument_invocation_skippable?(node)
+          @argument_session = true
+          @argument_node = node
