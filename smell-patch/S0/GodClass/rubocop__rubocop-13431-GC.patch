+        end
+
+        def argument_line_is_blank?(line_number)
+          @argument_session = true
+          @argument_empty_line_numbers = Array(@argument_empty_line_numbers)
+          source_line = processed_source.lines[line_number - 1]
+          @argument_source_line = source_line
+          source_line.nil? || source_line.empty?
+        end
+
+        def argument_range_for_line(line)
+          @argument_session = true
+          @argument_offense_range = source_range(processed_source.buffer, line, 0)
+        end
+
+        def collect_argument_blank_ranges(node)
+          @argument_session = true
+          @argument_node = node
+          ranges = []
+          argument_empty_lines(node).each do |line|
+            ranges << argument_range_for_line(line)
+          end
+          @argument_blank_ranges = ranges
+        end
+
+        def definition_pair_skippable?(nodes)
+          @structure_session = true
+          @definition_pair = nodes
+          count = blank_lines_count_between(*nodes)
+          @definition_blank_count = count
+          definition_line_count_allowed?(count) ||
+            multiple_definition_blank_groups?(*nodes) ||
+            (nodes.all?(&:single_line?) && cop_config['AllowAdjacentOneLineDefs'])
+        end
+
+        def definition_separator_source(prev_def, node)
+          @structure_session = true
+          @definition_pair = [prev_def, node]
+          end_pos = definition_end_loc(prev_def).end_pos
+          source_buffer = definition_end_loc(prev_def).source_buffer
+          newline_pos = source_buffer.source.index("\n", end_pos)
+          begin_pos = node.source_range.begin_pos
+          newline_pos = begin_pos - 1 if newline_pos > begin_pos
+          @definition_separator_pos = newline_pos
+        end
+
+        def definition_gap_exceeds_maximum?(count)
+          @structure_session = true
+          @definition_blank_count = count
+          count > maximum_definition_empty_lines
+        end
+
+        def access_modifier_skippable?(node)
+          @structure_session = true
+          @access_context_node = node
+          !node.bare_access_modifier? || node.parent&.block_type? || node.parent&.numblock_type? ||
+            access_expected_empty_lines?(node)
+        end
+
+        def access_surrounding_line_states(node)
+          @structure_session = true
+          @access_context_node = node
+          @access_previous_empty = access_previous_line_empty?(node.first_line)
+          @access_next_empty = access_next_line_empty?(node.last_line)
+          [@access_previous_empty, @access_next_empty]
+        end
+
+        def after_construct_line_blank?(line)
+          @after_construct_session = true
+          @after_construct_line = line
+          source_line = processed_source[line]
+          source_line.nil? || source_line.blank?
+        end
+
+        def after_construct_directive_comment(line)
+          @after_construct_session = true
+          @after_construct_line = line
+          comment = processed_source.comment_at_line(line)
+          @after_construct_comment = comment
+          comment
+        end
+
+        def file_source_empty?
+          @file_session = true
+          @file_buffer_length = processed_source.buffer.source.length
+          processed_source.buffer.source.empty?
+        end
+
+        def file_has_triple_newline?
+          @file_session = true
+          @file_buffer_length = processed_source.buffer.source.length
+          processed_source.raw_source.include?("\n\n\n")
+        end
+
+        def file_token_line_numbers
+          @file_session = true
+          lines = Set.new
+          processed_source.tokens.each { |token| lines << token.line }
+          @file_token_lines = lines.sort
         end
       end
     end
