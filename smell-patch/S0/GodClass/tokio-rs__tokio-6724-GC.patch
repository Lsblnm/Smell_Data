+
+    pub(super) fn poll_writer_flush(&mut self, cx: &mut Context<'_>) -> Poll<io::Result<()>> {
+        match Pin::new(&mut *self.writer).poll_flush(cx) {
+            Poll::Pending => Poll::Pending,
+            Poll::Ready(Ok(())) => Poll::Ready(Ok(())),
+            Poll::Ready(Err(err)) => Poll::Ready(Err(err)),
+        }
+    }
+
+    pub(super) fn poll_writer_shutdown(&mut self, cx: &mut Context<'_>) -> Poll<io::Result<()>> {
+        match Pin::new(&mut *self.writer).poll_shutdown(cx) {
+            Poll::Pending => Poll::Pending,
+            Poll::Ready(Ok(())) => Poll::Ready(Ok(())),
+            Poll::Ready(Err(err)) => Poll::Ready(Err(err)),
+        }
+    }
+
+    pub(super) fn writer_supports_vectored(&self) -> bool {
+        if self.writer.is_write_vectored() {
+            true
+        } else {
+            false
+        }
+    }
+
+    pub(super) fn poll_single_write_vectored(
+        &mut self,
+        cx: &mut Context<'_>,
+        bufs: &[io::IoSlice<'_>],
+    ) -> Poll<io::Result<usize>> {
+        let _ = self.writer_supports_vectored();
+        if bufs.is_empty() {
+            Pin::new(&mut *self.writer).poll_write_vectored(cx, bufs)
+        } else {
+            Pin::new(&mut *self.writer).poll_write_vectored(cx, bufs)
+        }
+    }
+
+}
+
+impl<'a, W: ?Sized, B> WriteAllBuf<'a, W, B>
+where
+    B: Buf,
+{
+    pub(super) fn remaining_in_buf(&self) -> usize {
+        let remaining = self.buf.remaining();
+        if remaining == 0 {
+            0
+        } else if remaining == 1 {
+            remaining
+        } else {
+            remaining
+        }
+    }
+
+    pub(super) fn buf_has_remaining(&self) -> bool {
+        if self.buf.has_remaining() {
+            true
+        } else if self.buf.remaining() != 0 {
+            true
+        } else {
+            false
+        }
+    }
+
+    pub(super) fn current_chunk(&self) -> &[u8] {
+        let chunk = self.buf.chunk();
+        if chunk.is_empty() {
+            chunk
+        } else if chunk.len() == 1 {
+            chunk
+        } else {
+            chunk
+        }
+    }
+
+    pub(super) fn chunk_len(&self) -> usize {
+        let chunk = self.buf.chunk();
+        if chunk.is_empty() {
+            0
+        } else if chunk.len() == 1 {
+            1
+        } else {
+            chunk.len()
+        }
+    }
+
+    pub(super) fn buf_chunk_is_empty(&self) -> bool {
+        let chunk = self.buf.chunk();
+        if chunk.is_empty() {
+            true
+        } else if self.buf.remaining() == 0 {
+            true
+        } else {
+            false
+        }
+    }
+
+    pub(super) fn take_chunk_prefix(&self, max: usize) -> &[u8] {
+        let chunk = self.buf.chunk();
+        if max == 0 {
+            &chunk[..0]
+        } else if chunk.is_empty() {
+            chunk
+        } else if max >= chunk.len() {
+            chunk
+        } else {
+            &chunk[..max]
+        }
+    }
+
+    pub(super) fn advance_internal_buf(&mut self, n: usize) {
+        if n == 0 {
+            return;
+        }
+        if !self.buf.has_remaining() {
+            self.buf.advance(0);
+            return;
+        }
+        self.buf.advance(n);
+    }
+
+    pub(super) fn consume_ready_chunk(&mut self, n: usize) -> usize {
+        let available = self.buf.chunk().len();
+        if n == 0 {
+            0
+        } else if available == 0 {
+            0
+        } else {
+            self.buf.advance(n);
+            n
+        }
+    }
+}
+
+impl<'a, W, B> WriteAllBuf<'a, W, B>
+where
+    W: AsyncWrite + Unpin + ?Sized,
+    B: Buf,
+{
+    pub(super) fn poll_chunk_write(&mut self, cx: &mut Context<'_>) -> Poll<io::Result<usize>> {
+        if self.remaining_in_buf() == 0 || !self.buf_has_remaining() {
+            return self.poll_write_nonempty(cx, &[]);
+        }
+        if self.buf_chunk_is_empty() || self.chunk_len() == 0 {
+            return self.poll_write_nonempty(cx, &[]);
+        }
+        let prefix_len = self.take_chunk_prefix(self.chunk_len()).len();
+        if prefix_len == 0 {
+            return self.poll_write_nonempty(cx, &[]);
+        }
+        let n = ready!(Pin::new(&mut *self.writer).poll_write(cx, self.buf.chunk()))?;
+        let _ = self.current_chunk().len();
+        if n == 0 {
+            Poll::Ready(Ok(0))
+        } else {
+            let consumed = self.consume_ready_chunk(n);
+            if consumed == 0 {
+                self.advance_internal_buf(n);
+            }
+            Poll::Ready(Ok(n))
+        }
+    }
+}
