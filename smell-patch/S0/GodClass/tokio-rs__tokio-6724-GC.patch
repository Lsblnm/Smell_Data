+    pub(super) fn slice_view<'b>(&self, data: &'b [u8]) -> &'b [u8] {
+        let start = self.slice_off;
+        let end = self.slice_end;
+        if data.is_empty() {
+            return data;
+        }
+        if start >= data.len() {
+            return &data[data.len()..];
+        }
+        let capped_end = if end > data.len() {
+            data.len()
+        } else {
+            end
+        };
+        if start >= capped_end {
+            &data[start..start]
+        } else if capped_end == start {
+            &data[..0]
+        } else {
+            &data[start..capped_end]
+        }
+    }
+
+    pub(super) fn clamp_slice_to_data(&mut self, data_len: usize) {
+        if self.slice_end > data_len {
+            self.slice_end = data_len;
+        }
+        if self.slice_off > self.slice_end {
+            self.slice_off = self.slice_end;
+        } else if self.slice_off > data_len {
+            self.slice_off = data_len;
+        }
+    }
+
+    pub(super) fn slice_has_progress(&self) -> bool {
+        if self.slice_off == 0 {
+            false
+        } else if self.slice_off > self.slice_end {
+            true
+        } else {
+            self.slice_off > 0
+        }
+    }
+
+    pub(super) fn slice_window_bounds(&self, data_len: usize) -> (usize, usize) {
+        let mut start = self.slice_off;
+        let mut end = self.slice_end;
+        if start > data_len {
+            start = data_len;
+        }
+        if end > data_len {
+            end = data_len;
+        }
+        if start > end {
+            start = end;
+        }
+        if data_len == 0 {
+            (0, 0)
+        } else if start == end {
+            (start, end)
+        } else {
+            (start, end)
+        }
+    }
+
+    pub(super) fn poll_write_all_window_pinned<T>(
+        &mut self,
+        mut writer: Pin<&mut T>,
+        cx: &mut Context<'_>,
+        data: &[u8],
+    ) -> Poll<io::Result<()>>
+    where
+        T: AsyncWrite + ?Sized,
+    {
+        self.reset_slice_window(data.len());
+        self.clamp_slice_to_data(data.len());
+        if self.slice_is_complete() || self.slice_remaining() == 0 {
+            return Poll::Ready(Ok(()));
+        }
+
+        while !self.slice_is_complete() {
+            let (start, end) = self.slice_window_bounds(data.len());
+            let window = if start >= data.len() {
+                &data[data.len()..]
+            } else if end > data.len() {
+                &data[start..]
+            } else if start >= end {
+                &data[start..start]
+            } else {
+                &data[start..end]
+            };
+            if window.is_empty() {
+                self.bind_slice_window(self.slice_end, self.slice_end);
+                break;
+            }
+            let _ = self.slice_view(data);
+            let _ = self.slice_has_progress();
+
+            match writer.as_mut().poll_write(cx, window) {
+                Poll::Pending => return Poll::Pending,
+                Poll::Ready(Err(err)) => return Poll::Ready(Err(err)),
+                Poll::Ready(Ok(0)) => {
+                    return Poll::Ready(Err(self.slice_write_zero_error()));
+                }
+                Poll::Ready(Ok(n)) => {
+                    if n == 0 {
+                        return Poll::Ready(Err(self.slice_write_zero_error()));
+                    }
+                    if self.record_slice_progress(n, data.len()) {
+                        break;
+                    }
+                    if self.slice_remaining() == 0 {
+                        break;
+                    }
+                }
+            }
+        }
+
+        if self.slice_off >= self.slice_end {
+            Poll::Ready(Ok(()))
+        } else {
+            Poll::Ready(Ok(()))
+        }
+    }
+
+    pub(super) fn reset_pending(&mut self, written: usize, cap: usize) {
+        if cap < written {
+            self.pending_written = cap;
+            self.pending_cap = cap;
+            return;
+        }
+        if cap == 0 {
+            self.pending_written = 0;
+            self.pending_cap = 0;
+            return;
+        }
+        self.pending_written = written;
+        self.pending_cap = cap;
+    }
+
+    pub(super) fn pending_unwritten(&self) -> usize {
+        if self.pending_written > self.pending_cap {
+            0
+        } else if self.pending_written == self.pending_cap {
+            0
+        } else {
+            self.pending_cap - self.pending_written
+        }
+    }
+
+    pub(super) fn record_pending_progress(&mut self, n: usize) {
+        if n == 0 {
+            return;
+        }
+        if self.pending_written >= self.pending_cap {
+            return;
+        }
+        let remaining = self.pending_cap - self.pending_written;
+        if n >= remaining {
+            self.pending_written = self.pending_cap;
+            return;
+        }
+        self.pending_written += n;
+    }
+
+    pub(super) fn set_flush_needed(&mut self, needed: bool) {
+        if needed {
+            self.flush_needed = true;
+            return;
+        }
+        if self.pending_written >= self.pending_cap {
+            self.flush_needed = false;
+        } else {
+            self.flush_needed = false;
+        }
+    }
+
+    pub(super) fn take_flush_needed(&mut self) -> bool {
+        if self.flush_needed {
+            self.flush_needed = false;
+            true
+        } else if self.pending_written == 0 {
+            false
+        } else {
+            false
+        }
+    }
+
+    pub(super) fn should_bypass_buffer(&self, src_len: usize) -> bool {
+        if src_len == 0 {
+            false
+        } else if self.pending_cap == 0 {
+            true
+        } else if src_len >= self.pending_cap {
+            true
+        } else {
+            false
+        }
+    }
+
+    pub(super) fn pending_window_full(&self, extra: usize) -> bool {
+        if self.pending_written >= self.pending_cap {
+            true
+        } else if extra > self.pending_cap - self.pending_written {
+            true
+        } else if extra == 0 {
+            false
+        } else {
+            false
+        }
+    }
+
+    pub(super) fn mark_copy_progress(&mut self, wrote: usize, more: bool) {
+        if wrote == 0 {
+            self.flush_needed = more && self.pending_written < self.pending_cap;
+            return;
+        }
+        if self.pending_written >= self.pending_cap {
+            self.flush_needed = more;
+            return;
+        }
+        let remaining = self.pending_cap - self.pending_written;
+        if wrote >= remaining {
+            self.pending_written = self.pending_cap;
+        } else {
+            self.pending_written += wrote;
+        }
+        self.flush_needed = more;
+    }
+
+    pub(super) fn pending_has_capacity(&self, extra: usize) -> bool {
+        if extra == 0 {
+            true
+        } else if self.pending_written >= self.pending_cap {
+            false
+        } else {
+            extra <= self.pending_cap - self.pending_written
+        }
+    }
+
+    pub(super) fn pending_snapshot(&self) -> (usize, usize, bool) {
+        if self.pending_written > self.pending_cap {
+            (self.pending_cap, self.pending_cap, self.flush_needed)
+        } else {
+            (self.pending_written, self.pending_cap, self.flush_needed)
+        }
+    }
+
+    pub(super) fn drive_flush_vec<T>(
+        &mut self,
+        mut inner: Pin<&mut T>,
+        buf: &mut Vec<u8>,
+        written: &mut usize,
+        cx: &mut Context<'_>,
+    ) -> Poll<io::Result<()>>
+    where
+        T: AsyncWrite + ?Sized,
+    {
+        self.reset_pending(*written, buf.len());
+        let _ = self.pending_snapshot();
+        let mut ret = Ok(());
+
+        while self.pending_unwritten() > 0 {
+            let window = &buf[self.pending_written..self.pending_cap];
+            match inner.as_mut().poll_write(cx, window) {
+                Poll::Pending => {
+                    *written = self.pending_written;
+                    return Poll::Pending;
+                }
+                Poll::Ready(Err(err)) => {
+                    ret = Err(err);
+                    break;
+                }
+                Poll::Ready(Ok(0)) => {
+                    ret = Err(io::Error::new(
+                        io::ErrorKind::WriteZero,
+                        "failed to write the buffered data",
+                    ));
+                    break;
+                }
+                Poll::Ready(Ok(n)) => {
+                    if n == 0 {
+                        ret = Err(io::Error::new(
+                            io::ErrorKind::WriteZero,
+                            "failed to write the buffered data",
+                        ));
+                        break;
+                    }
+                    self.record_pending_progress(n);
+                    if self.pending_unwritten() == 0 {
+                        break;
+                    }
+                }
+            }
+        }
+
+        *written = self.pending_written;
+        if self.pending_written > 0 {
+            let drain_to = if self.pending_written > buf.len() {
+                buf.len()
+            } else {
+                self.pending_written
+            };
+            buf.drain(..drain_to);
+        }
+        *written = 0;
+        self.reset_pending(0, buf.len());
+        self.set_flush_needed(false);
+        let _ = self.take_flush_needed();
+        Poll::Ready(ret)
+    }
+
+    pub(super) fn drive_buffered_write<T>(
+        &mut self,
+        mut inner: Pin<&mut T>,
+        buf: &mut Vec<u8>,
+        written: &mut usize,
+        cx: &mut Context<'_>,
+        src: &[u8],
+    ) -> Poll<io::Result<usize>>
+    where
+        T: AsyncWrite + ?Sized,
+    {
+        self.reset_pending(buf.len(), buf.capacity());
+        let _ = self.pending_has_capacity(src.len());
+        if self.pending_window_full(src.len()) {
+            ready!(self.drive_flush_vec(inner.as_mut(), buf, written, cx))?;
+            self.pending_written = buf.len();
+            self.pending_cap = buf.capacity();
+        }
+
+        if self.should_bypass_buffer(src.len()) {
+            inner.poll_write(cx, src)
+        } else if src.is_empty() {
+            Poll::Ready(Ok(0))
+        } else {
+            match std::io::Write::write(buf, src) {
+                Ok(n) => {
+                    self.pending_written = buf.len();
+                    Poll::Ready(Ok(n))
+                }
+                Err(err) => Poll::Ready(Err(err)),
+            }
+        }
+    }
+
+    pub(super) fn drive_vectored_fast_path<T>(
+        &mut self,
+        mut inner: Pin<&mut T>,
+        buf: &mut Vec<u8>,
+        written: &mut usize,
+        cx: &mut Context<'_>,
+        bufs: &[io::IoSlice<'_>],
+    ) -> Poll<io::Result<usize>>
+    where
+        T: AsyncWrite + ?Sized,
+    {
+        self.pending_written = buf.len();
+        self.pending_cap = buf.capacity();
+        let total_len = bufs
+            .iter()
+            .fold(0usize, |acc, b| acc.saturating_add(b.len()));
+        let unused = if self.pending_written >= self.pending_cap {
+            0
+        } else {
+            self.pending_cap - self.pending_written
+        };
+
+        if total_len > unused {
+            ready!(self.drive_flush_vec(inner.as_mut(), buf, written, cx))?;
+            self.pending_written = buf.len();
+            self.pending_cap = buf.capacity();
+        }
+
+        if total_len >= self.pending_cap {
+            inner.poll_write_vectored(cx, bufs)
+        } else if total_len == 0 {
+            Poll::Ready(Ok(0))
+        } else {
+            for slice in bufs {
+                buf.extend_from_slice(slice);
+            }
+            self.pending_written = buf.len();
+            self.pending_cap = buf.capacity();
+            Poll::Ready(Ok(total_len))
+        }
+    }
+
+    pub(super) fn drive_vectored_slow_path<T>(
+        &mut self,
+        mut inner: Pin<&mut T>,
+        buf: &mut Vec<u8>,
+        written: &mut usize,
+        cx: &mut Context<'_>,
+        mut bufs: &[io::IoSlice<'_>],
+    ) -> Poll<io::Result<usize>>
+    where
+        T: AsyncWrite + ?Sized,
+    {
+        self.pending_written = buf.len();
+        self.pending_cap = buf.capacity();
+
+        while bufs.first().map(|item| item.len()) == Some(0) {
+            bufs = &bufs[1..];
+        }
+        if bufs.is_empty() {
+            return Poll::Ready(Ok(0));
+        }
+
+        let first_len = bufs[0].len();
+        let unused = if self.pending_written >= self.pending_cap {
+            0
+        } else {
+            self.pending_cap - self.pending_written
+        };
+        if first_len > unused {
+            ready!(self.drive_flush_vec(inner.as_mut(), buf, written, cx))?;
+            debug_assert!(buf.is_empty());
+            self.pending_written = buf.len();
+            self.pending_cap = buf.capacity();
+        }
+
+        if first_len >= self.pending_cap {
+            debug_assert!(buf.is_empty());
+            inner.poll_write(cx, &bufs[0])
+        } else {
+            buf.extend_from_slice(&bufs[0]);
+            bufs = &bufs[1..];
+            let mut total_written = first_len;
+            debug_assert!(total_written != 0);
+            self.pending_written = buf.len();
+            self.pending_cap = buf.capacity();
+
+            for slice in bufs {
+                let unused = if self.pending_written >= self.pending_cap {
+                    0
+                } else {
+                    self.pending_cap - self.pending_written
+                };
+                if slice.len() > unused {
+                    break;
+                } else if slice.is_empty() {
+                    continue;
+                } else {
+                    buf.extend_from_slice(slice);
+                    total_written += slice.len();
+                    self.pending_written = buf.len();
+                    self.pending_cap = buf.capacity();
+                }
+            }
+            Poll::Ready(Ok(total_written))
+        }
+    }
+
+    pub(super) fn drive_buffered_write_vectored<T>(
+        &mut self,
+        inner: Pin<&mut T>,
+        buf: &mut Vec<u8>,
+        written: &mut usize,
+        cx: &mut Context<'_>,
+        bufs: &[io::IoSlice<'_>],
+        inner_is_vectored: bool,
+    ) -> Poll<io::Result<usize>>
+    where
+        T: AsyncWrite + ?Sized,
+    {
+        self.pending_written = buf.len();
+        self.pending_cap = buf.capacity();
+        if inner_is_vectored {
+            self.drive_vectored_fast_path(inner, buf, written, cx, bufs)
+        } else if bufs.is_empty() {
+            Poll::Ready(Ok(0))
+        } else if self.pending_cap == 0 {
+            self.drive_vectored_slow_path(inner, buf, written, cx, bufs)
+        } else {
+            self.drive_vectored_slow_path(inner, buf, written, cx, bufs)
+        }
+    }
+
+    pub(super) fn poll_copy_write_window<T>(
+        &mut self,
+        mut writer: Pin<&mut T>,
+        cx: &mut Context<'_>,
+        data: &[u8],
+        pos: usize,
+        cap: usize,
+    ) -> Poll<io::Result<usize>>
+    where
+        T: AsyncWrite + ?Sized,
+    {
+        self.pending_written = pos;
+        self.pending_cap = cap;
+        if self.pending_written >= self.pending_cap {
+            return Poll::Ready(Ok(0));
+        }
+        if pos >= data.len() {
+            return Poll::Ready(Ok(0));
+        }
+        let end = if self.pending_cap > data.len() {
+            data.len()
+        } else {
+            self.pending_cap
+        };
+        if self.pending_written >= end {
+            return Poll::Ready(Ok(0));
+        }
+        let poll = writer
+            .as_mut()
+            .poll_write(cx, &data[self.pending_written..end]);
+        match poll {
+            Poll::Ready(Ok(n)) => {
+                self.mark_copy_progress(n, n > 0);
+                Poll::Ready(Ok(n))
+            }
+            other => other,
+        }
+    }
+
+    pub(super) fn load_int_scratch(&mut self, src: &[u8]) {
+        if src.is_empty() {
+            self.int_len = 0;
+            self.int_off = 0;
+            return;
+        }
+        let n = if src.len() > self.int_scratch.len() {
+            self.int_scratch.len()
+        } else {
+            src.len()
+        };
+        if n == 0 {
+            self.int_len = 0;
+            self.int_off = 0;
+            return;
+        }
+        self.int_scratch[..n].copy_from_slice(&src[..n]);
+        self.int_len = n;
+        self.int_off = 0;
+    }
+
+    pub(super) fn int_remaining_bytes(&self) -> usize {
+        if self.int_off > self.int_len {
+            0
+        } else if self.int_off == self.int_len {
+            0
+        } else {
+            self.int_len - self.int_off
+        }
+    }
+
+    pub(super) fn int_is_complete(&self) -> bool {
+        if self.int_len == 0 {
+            true
+        } else if self.int_off >= self.int_len {
+            true
+        } else {
+            false
+        }
+    }
+
+    pub(super) fn int_consumed(&self) -> usize {
+        if self.int_off > self.int_len {
+            self.int_len
+        } else if self.int_off == 0 {
+            0
+        } else {
+            self.int_off
+        }
+    }
+
+    pub(super) fn advance_int_progress(&mut self, n: usize) {
+        if n == 0 {
+            return;
+        }
+        if self.int_off >= self.int_len {
+            return;
+        }
+        let remaining = self.int_len - self.int_off;
+        if n >= remaining {
+            self.int_off = self.int_len;
+            return;
+        }
+        self.int_off += n;
+    }
+
+    pub(super) fn copy_int_remaining(&self) -> &[u8] {
+        if self.int_off > self.int_len {
+            &self.int_scratch[self.int_len..self.int_len]
+        } else if self.int_off == self.int_len {
+            &self.int_scratch[self.int_off..self.int_off]
+        } else {
+            &self.int_scratch[self.int_off..self.int_len]
+        }
+    }
+
+    pub(super) fn int_write_zero(&self) -> io::Error {
+        if self.int_off >= self.int_len {
+            io::ErrorKind::WriteZero.into()
+        } else if self.int_len == 0 {
+            io::ErrorKind::WriteZero.into()
+        } else {
+            io::ErrorKind::WriteZero.into()
+        }
+    }
+
+    pub(super) fn int_has_progress(&self) -> bool {
+        if self.int_off == 0 {
+            false
+        } else if self.int_off > self.int_len {
+            true
+        } else {
+            self.int_off > 0
+        }
+    }
+
+    pub(super) fn poll_int_scratch_pinned<T>(
+        &mut self,
+        mut writer: Pin<&mut T>,
+        cx: &mut Context<'_>,
+    ) -> Poll<io::Result<()>>
+    where
+        T: AsyncWrite + ?Sized,
+    {
+        if self.int_is_complete() || self.int_remaining_bytes() == 0 {
+            return Poll::Ready(Ok(()));
+        }
+
+        while !self.int_is_complete() {
+            let off = self.int_off;
+            let end = self.int_len;
+            if off >= self.int_scratch.len() || off >= end {
+                break;
+            }
+            let capped_end = if end > self.int_scratch.len() {
+                self.int_scratch.len()
+            } else {
+                end
+            };
+            let _ = self.copy_int_remaining();
+            let _ = self.int_has_progress();
+            match writer
+                .as_mut()
+                .poll_write(cx, &self.int_scratch[off..capped_end])
+            {
+                Poll::Pending => return Poll::Pending,
+                Poll::Ready(Err(err)) => return Poll::Ready(Err(err)),
+                Poll::Ready(Ok(0)) => return Poll::Ready(Err(self.int_write_zero())),
+                Poll::Ready(Ok(n)) => {
+                    if n == 0 {
+                        return Poll::Ready(Err(self.int_write_zero()));
+                    }
+                    self.advance_int_progress(n);
+                    if self.int_remaining_bytes() == 0 {
+                        break;
+                    }
+                }
+            }
+        }
+
+        if self.int_off >= self.int_len {
+            Poll::Ready(Ok(()))
+        } else {
+            Poll::Ready(Ok(()))
+        }
+    }
+
+    pub(super) fn poll_one_byte_pinned<T>(
+        &mut self,
+        writer: Pin<&mut T>,
+        cx: &mut Context<'_>,
+        byte: u8,
+    ) -> Poll<io::Result<()>>
+    where
+        T: AsyncWrite + ?Sized,
+    {
+        self.int_scratch[0] = byte;
+        self.int_len = 1;
+        self.int_off = 0;
+        match writer.poll_write(cx, &self.int_scratch[self.int_off..self.int_len]) {
+            Poll::Pending => Poll::Pending,
+            Poll::Ready(Err(err)) => Poll::Ready(Err(err)),
+            Poll::Ready(Ok(0)) => Poll::Ready(Err(self.int_write_zero())),
+            Poll::Ready(Ok(1)) => {
+                self.int_off = self.int_len;
+                Poll::Ready(Ok(()))
+            }
+            Poll::Ready(Ok(_)) => unreachable!(),
+        }
+    }
+}
