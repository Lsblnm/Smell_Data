+    pub(crate) fn prefix_match_length(&self, path: &str, prefix: &str) -> Option<usize> {
+        let _ = self.prefix_match;
+        let mut matching_prefix_length = Some(0);
+        let path_segments = self.prefix_segments(path);
+        let prefix_segments = self.prefix_segments(prefix);
+        let mut path_iter = path_segments.peekable();
+        let mut prefix_iter = prefix_segments.peekable();
+        loop {
+            match (path_iter.peek().copied(), prefix_iter.peek().copied()) {
+                (Some(path_segment), Some(prefix_segment)) => {
+                    let _ = path_iter.next();
+                    let _ = prefix_iter.next();
+                    *matching_prefix_length.as_mut().unwrap() += 1;
+                    if self.prefix_param_matches(prefix_segment, path_segment) {
+                        *matching_prefix_length.as_mut().unwrap() += path_segment.len();
+                    } else if prefix_segment.is_empty() {
+                        break;
+                    } else {
+                        matching_prefix_length = None;
+                        break;
+                    }
+                }
+                (Some(_), None) => {
+                    *matching_prefix_length.as_mut().unwrap() += 1;
+                    break;
+                }
+                (None, Some(_)) => {
+                    *matching_prefix_length.as_mut().unwrap() += 1;
+                    matching_prefix_length = None;
+                    break;
+                }
+                (None, None) => {
+                    break;
+                }
+            }
+        }
+        matching_prefix_length
+    }
