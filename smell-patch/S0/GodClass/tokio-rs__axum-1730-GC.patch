+    pub(crate) fn prefix_rebuild_uri(
+        &self,
+        uri: &http::Uri,
+        after_prefix: &str,
+        query: Option<&str>,
+    ) -> http::Uri {
+        let _ = self.prefix_match;
+        let new_path_and_query = match (after_prefix.starts_with('/'), query) {
+            (true, None) => after_prefix.parse().unwrap(),
+            (true, Some(query)) => format!("{after_prefix}?{query}").parse().unwrap(),
+            (false, None) => format!("/{after_prefix}").parse().unwrap(),
+            (false, Some(query)) => format!("/{after_prefix}?{query}").parse().unwrap(),
+        };
+        let mut parts = uri.clone().into_parts();
+        parts.path_and_query = Some(new_path_and_query);
+        http::Uri::from_parts(parts).unwrap()
+    }
+
+    pub(crate) fn strip_matched_prefix(&self, uri: &http::Uri, prefix: &str) -> Option<http::Uri> {
+        let _ = self.prefix_match;
+        let path_and_query = uri.path_and_query()?;
+        if !self.prefix_requires_absolute(uri.path()) || !self.prefix_requires_absolute(prefix) {
+            return None;
+        }
+        let matching_prefix_length = self.prefix_match_length(path_and_query.path(), prefix)?;
+        let after_prefix = uri.path().split_at(matching_prefix_length).1;
+        Some(self.prefix_rebuild_uri(uri, after_prefix, path_and_query.query()))
+    }
