+        }
+    }
+
+    pub(crate) fn should_write_content_length(&self, headers: &http::HeaderMap) -> bool {
+        if !self.response_finish.write_content_length {
+            false
+        } else {
+            !headers.contains_key(http::header::CONTENT_LENGTH)
+        }
