+    pub(crate) fn apply_head_body_policy(&self, res: Response, strip_body: bool) -> Response {
+        let _ = self.response_finish;
+        if self.should_strip_head_body(strip_body) {
+            res.map(|_| crate::body::boxed(crate::body::Empty::new()))
+        } else {
+            res
+        }
+    }
+
+    pub(crate) fn finish_response(
+        &self,
+        mut res: Response,
+        strip_body: bool,
+        allow_header: &mut Option<Bytes>,
+    ) -> Response {
+        let _ = self.response_finish;
+        if self.already_passed_through(&res) {
+            return res;
+        }
+        self.mark_passed_through(&mut res);
+        self.write_allow_header_value(res.headers_mut(), allow_header);
+        self.write_content_length_value(res.size_hint(), res.headers_mut());
+        self.apply_head_body_policy(res, strip_body)
+    }
