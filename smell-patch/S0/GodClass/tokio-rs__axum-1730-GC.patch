+    pub(crate) fn prefix_segments<'a>(&self, s: &'a str) -> std::vec::IntoIter<&'a str> {
+        let _ = self.prefix_match;
+        assert!(
+            self.prefix_requires_absolute(s),
+            "path didn't start with '/'. axum should have caught this higher up."
+        );
