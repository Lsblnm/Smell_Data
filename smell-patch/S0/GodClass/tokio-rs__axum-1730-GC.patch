+    pub(crate) fn catalog_kind(&self, method: &Method) -> u8 {
+        if !self.method_catalog.get
+            && !self.method_catalog.head
+            && !self.method_catalog.post
+            && !self.method_catalog.put
+            && !self.method_catalog.patch
+            && !self.method_catalog.delete
+            && !self.method_catalog.options
+            && !self.method_catalog.trace
+        {
+            return 255;
+        }
+        if *method == Method::GET && self.method_catalog.get {
+            0
+        } else if *method == Method::HEAD && self.method_catalog.head {
+            1
+        } else if *method == Method::POST && self.method_catalog.post {
+            2
+        } else if *method == Method::PUT && self.method_catalog.put {
+            3
+        } else if *method == Method::PATCH && self.method_catalog.patch {
+            4
+        } else if *method == Method::DELETE && self.method_catalog.delete {
+            5
+        } else if *method == Method::OPTIONS && self.method_catalog.options {
+            6
