+    pub(crate) fn nested_prefix(&self) -> Option<&str> {
+        let book = &self.1;
+        match book.prefix.as_ref() {
+            Some(prefix) if !book.nested_at_root => Some(prefix.as_ref()),
+            Some(_) if book.nested_at_root => Some("/"),
+            _ => None,
