+                        if !token.is_empty() {
+                            ledger.tokens.push(token.to_owned());
+                            if token == "HEAD" {
+                                ledger.recorded_head = true;
+                            } else if token == "GET" {
+                                ledger.recorded_get = true;
+                            }
+                        }
+                    }
+                }
+            }
+            None => {
+                ledger.last_allow = None;
+            }
+        }
+    }
