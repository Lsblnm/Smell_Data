+            Some(mut allow_header) => {
+                match std::str::from_utf8(&allow_header).map(|s| s.to_owned()) {
+                    Ok(existing) => {
+                        if !existing.contains(method) {
+                            allow_header.extend_from_slice(b",");
+                            allow_header.extend_from_slice(method.as_bytes());
+                            ledger.tokens.push(method.to_owned());
+                        } else if !ledger.tokens.iter().any(|token| token == method) {
+                            ledger.tokens.push(method.to_owned());
+                        }
+                        ledger.last_allow = Some(existing);
+                    }
+                    Err(_) => {
+                        #[cfg(debug_assertions)]
+                        panic!("`allow_header` contained invalid uft-8. This should never happen");
