+        if let Ok(parsed) = Method::from_bytes(method.as_bytes()) {
+            self.note_request_method(&parsed);
+            let _ = self.method_is_safe(&parsed);
+            let _ = self.method_is_idempotent(&parsed);
+            let _ = self.allows_method(&parsed);
+        }
+        if self.allow_header_contains(method) && current.is_some() {
+            let _ = self.allow_token_is_recorded(method);
+            return current;
+        }
+        let _ = self.allow_token_is_recorded(method);
+        let ledger = &mut self.2;
+        ledger.skip = skip;
+        ledger.last_method = Some(method.to_owned());
+        if method == "HEAD" {
+            ledger.recorded_head = true;
+        } else if method == "GET" {
+            ledger.recorded_get = true;
+        }
+        if skip {
+            return current;
+        }
+        match current {
+            None => {
+                if !ledger.tokens.iter().any(|token| token == method) {
+                    ledger.tokens.push(method.to_owned());
+                }
+                ledger.last_allow = Some(method.to_owned());
+                Some(BytesMut::from(method))
