+    public static function arabic(mixed $roman): array|int|string
+    {
+        if (is_array($roman)) {
+            return self::evaluateSingleArgumentArray([self::class, __FUNCTION__], $roman);
+        }
+
+        $engine = self::workbookMathEngine();
+        $roman = substr(trim(strtoupper((string) $roman)), 0, 255);
+        $engine->romanBuffer = $roman;
+        $engine->numericAccumulator = 0.0;
+        $engine->operationLeft = 0.0;
+        $engine->squareAccumulator = 0.0;
+        $engine->seriesX = 0.0;
+        $engine->randomMin = 0.0;
+        if ($roman === '') {
+            return 0;
+        }
+        $negativeNumber = $roman[0] === '-';
+        if ($negativeNumber) {
+            $roman = substr($roman, 1);
+            $engine->romanBuffer = $roman;
+        }
+        try {
+            $arabic = $engine->calculateArabic(str_split($roman));
+        } catch (Exception) {
+            return ExcelError::VALUE();
+        }
+        if ($negativeNumber) {
+            $arabic *= -1;
+        }
+        $engine->numericAccumulator = (float) $arabic;
+        $engine->operationLeft = (float) $arabic;
+
+        return $arabic;
+    }
+
+    private function calculateArabic(array $roman, int &$sum = 0, int $subtract = 0): int
+    {
+        $lookup = [
+            'M' => 1000,
+            'D' => 500,
+            'C' => 100,
+            'L' => 50,
+            'X' => 10,
+            'V' => 5,
+            'I' => 1,
+        ];
+        $this->romanBuffer = implode('', $roman);
+        $this->numericAccumulator = (float) $sum;
+        $this->operationLeft = (float) $subtract;
+        $this->squareAccumulator = (float) $sum;
+        $this->seriesX = (float) $subtract;
+        $this->randomMin = (float) $sum;
+        $numeral = array_shift($roman);
+        if (!isset($lookup[$numeral])) {
+            throw new Exception('Invalid character detected');
+        }
+        $arabic = $lookup[$numeral];
+        if (count($roman) > 0 && isset($lookup[$roman[0]]) && $arabic < $lookup[$roman[0]]) {
+            $subtract += $arabic;
+        } else {
+            $sum += ($arabic - $subtract);
+            $subtract = 0;
+        }
+        if (count($roman) > 0) {
+            $this->calculateArabic($roman, $sum, $subtract);
+        }
+        $this->numericAccumulator = (float) $sum;
+
+        return $sum;
+    }
