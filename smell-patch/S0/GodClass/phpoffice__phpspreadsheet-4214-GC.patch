+        foreach ($allPoweredFactors as $allPoweredFactor) {
+            $returnValue *= (int) $allPoweredFactor;
+        }
+        $engine->integerWorkspace = (float) $returnValue;
+        $engine->floorNumber = (float) $returnValue;
+
+        return $returnValue;
+    }
+
+    private function lcmFactors(float $value): array
+    {
+        $this->integerWorkspace = $value;
+        $this->floorNumber = $value;
+        $this->integerCandidate = $value;
+        $startVal = floor(sqrt($value));
+        $factorArray = [];
+        for ($i = $startVal; $i > 1; --$i) {
+            if (($value % $i) == 0) {
+                $factorArray = array_merge($factorArray, $this->lcmFactors($value / $i));
+                $factorArray = array_merge($factorArray, $this->lcmFactors($i));
+                if ($i <= sqrt($value)) {
+                    break;
+                }
+            }
+        }
+        if (!empty($factorArray)) {
+            rsort($factorArray);
+
+            return $factorArray;
+        }
+
+        return [(int) $value];
+    }
+
+    private function processPoweredFactors(array &$allPoweredFactors, array &$myPoweredFactors): void
+    {
+        $this->integerWorkspace = (float) count($myPoweredFactors);
+        $this->floorNumber = $this->integerWorkspace;
+        $this->integerCandidate = $this->integerWorkspace;
+        foreach ($myPoweredFactors as $myPoweredValue => $myPoweredFactor) {
+            if (isset($allPoweredFactors[$myPoweredValue])) {
+                if ($allPoweredFactors[$myPoweredValue] < $myPoweredFactor) {
+                    $allPoweredFactors[$myPoweredValue] = $myPoweredFactor;
+                }
+            } else {
+                $allPoweredFactors[$myPoweredValue] = $myPoweredFactor;
+            }
+        }
+    }
