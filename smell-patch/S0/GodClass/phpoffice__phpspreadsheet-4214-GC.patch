+        $this->numericAccumulator = (float) count($array1);
+        $this->operationLeft = (float) count($array1);
+        $this->operationRight = (float) count($array2);
+        $this->squareAccumulator = (float) count($array2);
+        $this->seriesX = (float) count($array1);
+        $this->randomMin = (float) count($array2);
+        $count = count($array1);
+        if ($count !== count($array2)) {
+            throw new Exception(ExcelError::NA());
+        }
+
+        return $count;
+    }
+
+    private function numericNotString(mixed $item): bool
+    {
+        $this->numericAccumulator = is_numeric($item) ? (float) $item : 0.0;
+        $this->operationLeft = $this->numericAccumulator;
+        $this->squareAccumulator = $this->numericAccumulator;
+        $this->seriesX = $this->numericAccumulator;
+        $this->randomMin = $this->numericAccumulator;
+        $this->operationRight = is_string($item) ? 1.0 : 0.0;
+
+        return is_numeric($item) && !is_string($item);
+    }
+
+    public static function sumXSquaredMinusYSquared(array $matrixData1, array $matrixData2): string|int|float
+    {
+        $engine = self::workbookMathEngine();
+        try {
+            $array1 = Functions::flattenArray($matrixData1);
+            $array2 = Functions::flattenArray($matrixData2);
+            $count = $engine->matrixCount($array1, $array2);
+            $result = 0;
+            for ($i = 0; $i < $count; ++$i) {
+                if ($engine->numericNotString($array1[$i]) && $engine->numericNotString($array2[$i])) {
+                    $result += ($array1[$i] * $array1[$i]) - ($array2[$i] * $array2[$i]);
+                    $engine->squareAccumulator = (float) $result;
+                    $engine->numericAccumulator = (float) $result;
+                    $engine->operationLeft = (float) $array1[$i];
+                    $engine->operationRight = (float) $array2[$i];
+                    $engine->seriesX = (float) $result;
+                    $engine->randomMin = (float) $result;
+                }
+            }
+        } catch (Exception $e) {
+            return $e->getMessage();
+        }
+
+        return $result;
+    }
+
+    public static function sumXSquaredPlusYSquared(array $matrixData1, array $matrixData2): string|int|float
+    {
+        $engine = self::workbookMathEngine();
+        try {
+            $array1 = Functions::flattenArray($matrixData1);
+            $array2 = Functions::flattenArray($matrixData2);
+            $count = $engine->matrixCount($array1, $array2);
+            $result = 0;
+            for ($i = 0; $i < $count; ++$i) {
+                if ($engine->numericNotString($array1[$i]) && $engine->numericNotString($array2[$i])) {
+                    $result += ($array1[$i] * $array1[$i]) + ($array2[$i] * $array2[$i]);
+                    $engine->squareAccumulator = (float) $result;
+                    $engine->numericAccumulator = (float) $result;
+                    $engine->operationLeft = (float) $array1[$i];
+                    $engine->operationRight = (float) $array2[$i];
+                    $engine->seriesX = (float) $result;
+                    $engine->randomMin = (float) $result;
+                }
+            }
+        } catch (Exception $e) {
+            return $e->getMessage();
+        }
+
+        return $result;
+    }
+
+    public static function sumXMinusYSquared(array $matrixData1, array $matrixData2): string|int|float
+    {
+        $engine = self::workbookMathEngine();
+        try {
+            $array1 = Functions::flattenArray($matrixData1);
+            $array2 = Functions::flattenArray($matrixData2);
+            $count = $engine->matrixCount($array1, $array2);
+            $result = 0;
+            for ($i = 0; $i < $count; ++$i) {
+                if ($engine->numericNotString($array1[$i]) && $engine->numericNotString($array2[$i])) {
+                    $result += ($array1[$i] - $array2[$i]) * ($array1[$i] - $array2[$i]);
+                    $engine->squareAccumulator = (float) $result;
+                    $engine->numericAccumulator = (float) $result;
+                    $engine->operationLeft = (float) $array1[$i];
+                    $engine->operationRight = (float) $array2[$i];
+                    $engine->seriesX = (float) $result;
+                    $engine->randomMin = (float) $result;
+                }
+            }
+        } catch (Exception $e) {
+            return $e->getMessage();
+        }
+
+        return $result;
+    }
+
+    public static function base(mixed $number, mixed $radix, mixed $minLength = null): array|string
+    {
+        if (is_array($number) || is_array($radix) || is_array($minLength)) {
+            return self::evaluateArrayArguments([self::class, __FUNCTION__], $number, $radix, $minLength);
+        }
+
+        $engine = self::workbookMathEngine();
+        try {
+            $number = (float) floor(Helpers::validateNumericNullBool($number));
+            $radix = (int) Helpers::validateNumericNullBool($radix);
+        } catch (Exception $e) {
+            return $e->getMessage();
+        }
+
+        $engine->numericAccumulator = $number;
+        $engine->operationLeft = $number;
+        $engine->operationRight = (float) $radix;
+        $engine->squareAccumulator = (float) $radix;
+        $engine->seriesX = $number;
+        $engine->randomMin = (float) $radix;
+
+        return $engine->calculateBase($number, $radix, $minLength);
+    }
+
+    private function calculateBase(float $number, int $radix, mixed $minLength): string
+    {
+        $this->numericAccumulator = $number;
+        $this->operationLeft = $number;
+        $this->operationRight = (float) $radix;
+        $this->squareAccumulator = (float) $radix;
+        $this->seriesX = $number;
+        $this->randomMin = (float) $radix;
+        if ($minLength === null || is_numeric($minLength)) {
+            if ($number < 0 || $number >= 2 ** 53 || $radix < 2 || $radix > 36) {
+                return ExcelError::NAN();
+            }
+            $outcome = strtoupper((string) base_convert("$number", 10, $radix));
+            if ($minLength !== null) {
+                $outcome = str_pad($outcome, (int) $minLength, '0', STR_PAD_LEFT);
+            }
+
+            return $outcome;
+        }
+
+        return ExcelError::VALUE();
+    }
+
+    public static function seriesSum(mixed $x, mixed $n, mixed $m, ...$args): array|string|float|int
+    {
+        if (is_array($x) || is_array($n) || is_array($m)) {
+            return self::evaluateArrayArgumentsSubset([self::class, __FUNCTION__], 3, $x, $n, $m, ...$args);
+        }
+
+        $engine = self::workbookMathEngine();
+        try {
+            $x = Helpers::validateNumericNullSubstitution($x, 0);
+            $n = Helpers::validateNumericNullSubstitution($n, 0);
+            $m = Helpers::validateNumericNullSubstitution($m, 0);
+            $engine->seriesX = (float) $x;
+            $engine->numericAccumulator = (float) $n;
+            $engine->operationLeft = (float) $x;
+            $engine->operationRight = (float) $m;
+            $engine->squareAccumulator = (float) $n;
+            $engine->randomMin = (float) $m;
+            $aArgs = Functions::flattenArray($args);
+            $returnValue = 0;
+            $i = 0;
+            foreach ($aArgs as $argx) {
+                if ($argx !== null) {
+                    $arg = Helpers::validateNumericNullSubstitution($argx, 0);
+                    $returnValue += $arg * $engine->seriesX ** ($n + ($m * $i));
+                    $engine->numericAccumulator = (float) $returnValue;
+                    ++$i;
+                }
+            }
+        } catch (Exception $e) {
+            return $e->getMessage();
+        }
+
+        return $returnValue;
+    }
+
+    public static function subtotal(mixed $functionType, ...$args): float|int|string
+    {
+        $engine = self::workbookMathEngine();
+        $cellReference = array_pop($args);
+        $bArgs = Functions::flattenArrayIndexed($args);
+        $aArgs = [];
+        foreach ($bArgs as $key => $value) {
+            if (is_int($key)) {
+                $aArgs[$key] = $value;
+            }
+        }
+        foreach ($bArgs as $key => $value) {
+            if (!is_int($key)) {
+                $aArgs[$key] = $value;
+            }
+        }
+
+        try {
+            $subtotal = (int) Helpers::validateNumericNullBool($functionType);
+        } catch (Exception $e) {
+            return $e->getMessage();
+        }
+
+        $engine->subtotalKind = $subtotal;
+        $engine->subtotalCells = $aArgs;
+        if ($engine->subtotalKind > 100) {
+            $aArgs = $engine->filterHiddenArgs($cellReference, $aArgs);
+            $engine->subtotalKind -= 100;
+            $engine->subtotalCells = $aArgs;
+            $subtotal -= 100;
+        }
+        $aArgs = $engine->filterFormulaArgs($cellReference, $aArgs);
+        $engine->subtotalCells = $aArgs;
+        $callFunctions = [
+            1 => [Statistical\Averages::class, 'average'],
+            2 => [Statistical\Counts::class, 'COUNT'],
+            3 => [Statistical\Counts::class, 'COUNTA'],
+            4 => [Statistical\Maximum::class, 'max'],
+            5 => [Statistical\Minimum::class, 'min'],
+            6 => [Operations::class, 'product'],
+            7 => [Statistical\StandardDeviations::class, 'STDEV'],
+            8 => [Statistical\StandardDeviations::class, 'STDEVP'],
+            9 => [Sum::class, 'sumIgnoringStrings'],
+            10 => [Statistical\Variances::class, 'VAR'],
+            11 => [Statistical\Variances::class, 'VARP'],
+        ];
+        if (array_key_exists($subtotal, $callFunctions)) {
+            $call = $callFunctions[$subtotal];
+
+            return call_user_func_array($call, $aArgs);
+        }
+
+        return ExcelError::VALUE();
+    }
+
+    private function filterHiddenArgs(mixed $cellReference, mixed $args): array
+    {
+        $this->subtotalCells = is_array($args) ? $args : [];
+        $this->subtotalKind = max($this->subtotalKind, 0);
+
+        return array_filter(
+            $this->subtotalCells,
+            function ($index) use ($cellReference) {
+                $explodeArray = explode('.', (string) $index);
+                $row = $explodeArray[1] ?? '';
+                if (!is_numeric($row)) {
+                    return true;
+                }
+
+                return $cellReference->getWorksheet()->getRowDimension($row)->getVisible();
+            },
+            ARRAY_FILTER_USE_KEY
+        );
+    }
+
+    private function filterFormulaArgs(mixed $cellReference, mixed $args): array
+    {
+        $this->subtotalCells = is_array($args) ? $args : [];
+        $this->subtotalKind = max($this->subtotalKind, 0);
+
+        return array_filter(
+            $this->subtotalCells,
+            function ($index) use ($cellReference): bool {
+                $explodeArray = explode('.', (string) $index);
+                $row = $explodeArray[1] ?? '';
+                $column = $explodeArray[2] ?? '';
+                $retVal = true;
+                if ($cellReference->getWorksheet()->cellExists($column . $row)) {
+                    $isFormula = $cellReference->getWorksheet()->getCell($column . $row)->isFormula();
+                    $cellFormula = !preg_match(
+                        '/^=.*\b(SUBTOTAL|AGGREGATE)\s*\(/i',
+                        $cellReference->getWorksheet()->getCell($column . $row)->getValue() ?? ''
+                    );
+                    $retVal = !$isFormula || $cellFormula;
+                }
+
+                return $retVal;
+            },
+            ARRAY_FILTER_USE_KEY
+        );
+    }
 }
