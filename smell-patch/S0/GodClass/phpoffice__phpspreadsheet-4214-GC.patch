+    public static function fact($factVal): array|string|float|int
+    {
+        if (is_array($factVal)) {
+            return self::evaluateSingleArgumentArray([self::class, __FUNCTION__], $factVal);
+        }
+
+        $engine = self::workbookMathEngine();
+        try {
+            $factVal = Helpers::validateNumericNullBool($factVal);
+            Helpers::validateNotNegative($factVal);
+        } catch (Exception $e) {
+            return $e->getMessage();
+        }
+
+        $engine->factorialValue = (float) $factVal;
+        $engine->signOperand = (float) $factVal;
+        $factLoop = floor($engine->factorialValue);
+        if ($engine->factorialValue > $factLoop) {
+            if (Functions::getCompatibilityMode() == Functions::COMPATIBILITY_GNUMERIC) {
+                return Statistical\Distributions\Gamma::gammaValue($engine->factorialValue + 1);
+            }
+        }
+
+        $factorial = 1;
+        while ($factLoop > 1) {
+            $factorial *= $factLoop--;
+        }
+        $engine->factorialValue = (float) $factorial;
+
+        return $factorial;
+    }
