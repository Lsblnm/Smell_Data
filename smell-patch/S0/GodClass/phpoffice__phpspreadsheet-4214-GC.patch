+
+        $engine->operationLeft = (float) $dividend;
+        $engine->operationRight = (float) $divisor;
+        $engine->numericAccumulator = (float) $dividend;
+        $engine->squareAccumulator = (float) $divisor;
+        $engine->seriesX = (float) $dividend;
+        $engine->randomMin = (float) $divisor;
+        if (($engine->operationLeft < 0.0) && ($engine->operationRight > 0.0)) {
+            return $engine->operationRight - fmod(abs($engine->operationLeft), $engine->operationRight);
+        }
+        if (($engine->operationLeft > 0.0) && ($engine->operationRight < 0.0)) {
+            return $engine->operationRight + fmod($engine->operationLeft, abs($engine->operationRight));
+        }
+
+        return fmod($engine->operationLeft, $engine->operationRight);
+    }
