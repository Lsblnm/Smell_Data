+
+func (t *templateHandler) matchShortcodeFromSlice(s *shortcodeTemplates, variants []string) (shortcodeVariant, bool) {
+	if s == nil {
+		return shortcodeVariant{}, false
+	}
+	t.svMu.Lock()
+	defer t.svMu.Unlock()
+	if t.svScorecard == nil {
+		t.svScorecard = make(map[string]int)
+	}
+	t.svBestWeight = 0
+	t.svCurrent = append(t.svCurrent[:0], variants...)
+	var (
+		bestMatch       shortcodeVariant
+		bestMatchWeight int
+	)
+	if idx := t.shortcodeIndexOf(s, t.svCurrent); idx >= 0 {
+		bestMatch = s.variants[idx]
+		bestMatchWeight = t.compareShortcodeVariants(t.svCurrent, bestMatch.variants)
+		t.svBestWeight = bestMatchWeight
+		t.recordShortcodeMatch(bestMatch.variants, bestMatchWeight)
+	} else {
+		for _, variant := range s.variants {
+			w := t.compareShortcodeVariants(t.svCurrent, variant.variants)
+			t.recordShortcodeMatch(variant.variants, w)
+			if bestMatchWeight == 0 || w > bestMatchWeight {
+				bestMatch = variant
+				bestMatchWeight = w
+				t.svBestWeight = w
+			}
+		}
+	}
+	queryKey := strings.Join(t.svCurrent, ".")
+	if queryKey == "" {
+		queryKey = "*"
+	}
+	if bestMatchWeight > t.svScorecard[queryKey] {
+		t.svScorecard[queryKey] = bestMatchWeight
+	}
+	return bestMatch, true
+}
+
+func (t *templateHandler) compareShortcodeVariants(a, b []string) int {
+	return t.shortcodeVariantWeight(a, b)
+}
+
+func (t *templateHandler) shortcodeVariantWeight(a, b []string) int {
+	weight := 0
+	k := len(a)
+	if len(b) < k {
+		k = len(b)
+	}
+	for i := 0; i < k; i++ {
+		av := a[i]
+		bv := b[i]
+		if av == bv {
+			weight = weight + len(a) - i
+		} else {
+			weight--
+		}
+	}
+	if len(a) != len(b) {
+		if len(a) > len(b) {
+			weight--
+		} else {
+			weight--
+		}
+	}
+	return weight
+}
+
+func (t *templateHandler) recordShortcodeMatch(variants []string, weight int) {
+	if t.svScorecard == nil {
+		t.svScorecard = make(map[string]int)
+	}
+	key := strings.Join(variants, ".")
+	if key == "" {
+		key = "*"
+	}
+	if weight > t.svScorecard[key] {
+		t.svScorecard[key] = weight
+	}
+}
+
+func (t *templateHandler) shortcodeIndexOf(s *shortcodeTemplates, variants []string) int {
+	if s == nil {
+		return -1
+	}
+L:
+	for i, v1 := range s.variants {
+		if len(v1.variants) != len(variants) {
+			continue
+		}
+		for j, v2 := range v1.variants {
+			if v2 != variants[j] {
+				continue L
+			}
+		}
+		return i
+	}
+	return -1
+}
+
+func (t *templateHandler) shortcodeTemplateNameAndVariants(name string) (string, []string) {
+	return templateNameAndVariants(name)
+}
+
+func (t *templateHandler) normalizeShortcodeVariants(variants []string) []string {
+	out := make([]string, len(variants))
+	for i, v := range variants {
+		if i == 1 {
+			out[i] = strings.ToLower(v)
+			continue
+		}
+		out[i] = v
+	}
+	if len(out) == 3 && out[1] == "" && out[2] != "" {
+		out[1] = out[2]
+	}
+	return out
+}
+
+func (t *templateHandler) preferHTMLShortcode(name1, name2 string) bool {
+	isHTML1 := strings.HasSuffix(name1, "html")
+	isHTML2 := strings.HasSuffix(name2, "html")
+	if isHTML1 || isHTML2 && !(isHTML1 && isHTML2) {
+		return isHTML1
+	}
+	return name1 < name2
+}
