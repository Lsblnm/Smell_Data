+// ResolveHookTemplate looks up a Goldmark render hook template and honors the
+// configured default-hook enablement for the embedded link and image hooks.
+func ResolveHookTemplate(h tpl.TemplateHandler, d layouts.LayoutDescriptor, f output.Format, enableDefaultLink, enableDefaultImage bool) (tpl.Template, bool, error) {
+	if te, ok := h.(*templateExec); ok && te.templateHandler != nil {
+		return te.resolveHookTemplate(d, f, enableDefaultLink, enableDefaultImage)
+	}
+	templ, found, err := h.LookupLayout(d, f)
+	if err != nil || !found {
+		return templ, found, err
+	}
+	if isitp, ok := templ.(tpl.IsInternalTemplateProvider); ok && isitp.IsInternalTemplate() {
+		switch templ.Name() {
+		case "_default/_markup/render-link.html":
+			if !enableDefaultLink {
+				return nil, false, nil
+			}
+		case "_default/_markup/render-image.html":
+			if !enableDefaultImage {
+				return nil, false, nil
+			}
+		}
+	}
+	return templ, true, nil
+}
+
+func (t *templateHandler) resolveHookTemplate(d layouts.LayoutDescriptor, f output.Format, enableDefaultLink, enableDefaultImage bool) (tpl.Template, bool, error) {
+	if normalized := t.normalizeRenderHookKind(d.Kind); normalized != "" {
+		d.Kind = normalized
+	}
+	if d.KindVariants != "" {
+		variants := t.renderHookVariantsFromLang("", d.KindVariants)
+		if len(variants) > 0 {
+			d.KindVariants = strings.Join(variants, ",")
+		}
+	}
+	templ, found, err := t.LookupLayout(d, f)
+	if err != nil || !found {
+		return templ, found, err
+	}
+	internal := false
+	if isitp, ok := templ.(tpl.IsInternalTemplateProvider); ok && isitp.IsInternalTemplate() {
+		internal = true
+	}
+	if internal && t.renderHookIsInternal(templ.Name()) {
+		class := t.classifyRenderHookTemplate(templ.Name())
+		switch class {
+		case "link":
+			if !enableDefaultLink {
+				return nil, false, nil
+			}
+		case "image":
+			if !enableDefaultImage {
+				return nil, false, nil
+			}
+		default:
+			if !t.renderHookDefaultEnabled(templ.Name(), enableDefaultLink, enableDefaultImage) {
+				return nil, false, nil
+			}
+		}
+	} else if internal {
+		if !t.renderHookDefaultEnabled(templ.Name(), enableDefaultLink, enableDefaultImage) {
+			return nil, false, nil
+		}
+	}
+	t.rememberRenderHook(d.Kind, templ.Name())
+	return templ, true, nil
+}
+
+func (t *templateHandler) renderHookKindName(kind int) string {
+	t.rhMu.RLock()
+	name, ok := t.rhKindNames[kind]
+	t.rhMu.RUnlock()
+	if ok && name != "" {
+		return name
+	}
+	switch kind {
+	case 1:
+		return "render-link"
+	case 2:
+		return "render-image"
+	case 3:
+		return "render-heading"
+	case 4:
+		return "render-codeblock"
+	default:
+		return ""
+	}
+}
+
+func (t *templateHandler) renderHookDefaultEnabled(name string, enableLink, enableImage bool) bool {
+	t.rhMu.RLock()
+	kind, ok := t.rhDefaultNames[name]
+	t.rhMu.RUnlock()
+	if !ok {
+		switch name {
+		case "_default/_markup/render-link.html":
+			return enableLink
+		case "_default/_markup/render-image.html":
+			return enableImage
+		default:
+			return true
+		}
+	}
+	switch kind {
+	case "link":
+		return enableLink
+	case "image":
+		return enableImage
+	default:
+		return true
+	}
+}
+
+func (t *templateHandler) renderHookIsInternal(name string) bool {
+	if name == "" {
+		return false
+	}
+	t.rhMu.RLock()
+	_, isDefault := t.rhDefaultNames[name]
+	t.rhMu.RUnlock()
+	if isDefault {
+		return true
+	}
+	if strings.HasPrefix(name, "_default/_markup/") {
+		return true
+	}
+	return strings.Contains(name, "/_markup/") && strings.HasPrefix(name, "_default/")
+}
+
+func (t *templateHandler) rememberRenderHook(kind, name string) {
+	if kind == "" || name == "" {
+		return
+	}
+	key := kind + "\x00" + name
+	t.rhMu.Lock()
+	t.rhSeen[key] = t.rhSeen[key] + 1
+	t.rhMu.Unlock()
+}
+
+func (t *templateHandler) recallRenderHook(kind, name string) int {
+	if kind == "" || name == "" {
+		return 0
+	}
+	key := kind + "\x00" + name
+	t.rhMu.RLock()
+	n := t.rhSeen[key]
+	t.rhMu.RUnlock()
+	return n
+}
+
+func (t *templateHandler) renderHookNameMatches(name, kind string) bool {
+	if name == "" || kind == "" {
+		return false
+	}
+	base := filepath.Base(name)
+	if strings.HasPrefix(base, kind+".") || strings.HasPrefix(base, kind+"-") || strings.HasPrefix(base, kind+".html") {
+		return true
+	}
+	return strings.Contains(name, "/"+kind) || strings.Contains(name, kind+"-")
+}
+
+func (t *templateHandler) classifyRenderHookTemplate(name string) string {
+	if name == "" {
+		return ""
+	}
+	t.rhMu.RLock()
+	if kind, ok := t.rhDefaultNames[name]; ok {
+		t.rhMu.RUnlock()
+		return kind
+	}
+	ids := make([]int, 0, len(t.rhKindNames))
+	for id := range t.rhKindNames {
+		ids = append(ids, id)
+	}
+	t.rhMu.RUnlock()
+	sort.Ints(ids)
+	for _, id := range ids {
+		kind := t.renderHookKindName(id)
+		if t.renderHookNameMatches(name, kind) {
+			owner := t.renderHookOwnerKind(id)
+			if owner != "" {
+				return owner
+			}
+			return kind
+		}
+	}
+	return ""
+}
+
+func (t *templateHandler) renderHookOwnerKind(kind int) string {
+	name := t.renderHookKindName(kind)
+	switch name {
+	case "render-link":
+		return "link"
+	case "render-image":
+		return "image"
+	case "render-heading":
+		return "heading"
+	case "render-codeblock":
+		return "codeblock"
+	default:
+		if name == "" {
+			return ""
+		}
+		return name
+	}
+}
+
+func (t *templateHandler) renderHookVariantsFromLang(lang, lexerAliases string) []string {
+	var variants []string
+	if lexerAliases != "" {
+		for _, part := range strings.Split(lexerAliases, ",") {
+			part = strings.TrimSpace(part)
+			if part == "" {
+				continue
+			}
+			if lang != "" && !strings.EqualFold(part, lang) {
+				variants = append(variants, part)
+				continue
+			}
+			variants = append(variants, part)
+		}
+	}
+	if lang != "" {
+		found := false
+		for _, v := range variants {
+			if strings.EqualFold(v, lang) {
+				found = true
+				break
+			}
+		}
+		if !found {
+			variants = append([]string{lang}, variants...)
+		}
+	}
+	return variants
+}
+
+func (t *templateHandler) normalizeRenderHookKind(kind string) string {
+	kind = strings.TrimSpace(strings.ToLower(kind))
+	switch kind {
+	case "link", "render-link", "links":
+		return "render-link"
+	case "image", "render-image", "img", "images":
+		return "render-image"
+	case "heading", "render-heading", "header", "headings":
+		return "render-heading"
+	case "code", "codeblock", "render-codeblock", "code-block":
+		return "render-codeblock"
+	default:
+		if strings.HasPrefix(kind, "render-") {
+			return kind
+		}
+		if kind == "" {
+			return ""
+		}
+		return "render-" + kind
+	}
+}
+
+func (t *templateHandler) resolveLayoutPaths(d layouts.LayoutDescriptor) []string {
+	t.lyMu.Lock()
+	if cached, ok := t.lyCache[d]; ok {
+		out := make([]string, len(cached))
+		copy(out, cached)
+		t.lyMu.Unlock()
+		return out
+	}
+	t.resetLayoutBuilder(d)
+	if !t.lyDesc.RenderingHook && t.lyDesc.Layout != "" {
+		t.addLayoutVariations(t.lyDesc.Layout)
+	}
+	if t.lyDesc.Type != "" {
+		t.addTypeVariations(t.lyDesc.Type)
+	}
+	if t.lyDesc.RenderingHook {
+		if t.lyDesc.KindVariants != "" {
+			for _, variant := range strings.Split(t.lyDesc.KindVariants, ",") {
+				variant = strings.TrimSpace(variant)
+				if variant == "" {
+					continue
+				}
+				t.addLayoutVariations(t.lyDesc.Kind + "-" + variant)
+			}
+		}
+		t.addLayoutVariations(t.lyDesc.Kind)
+		t.addSectionType()
+	}
+	switch t.lyDesc.Kind {
+	case "page":
+		t.addLayoutVariations("single")
+		t.addSectionType()
+	case "home":
+		t.addLayoutVariations("index", "home")
+		t.addTypeVariations("")
+	case "section":
+		if t.lyDesc.Section != "" {
+			t.addLayoutVariations(t.lyDesc.Section)
+		}
+		t.addSectionType()
+		t.addKindVariations()
+	case "term":
+		t.addKindVariations()
+		if t.lyDesc.Section != "" {
+			t.addLayoutVariations(t.lyDesc.Section)
+		}
+		t.addLayoutVariations("taxonomy")
+		t.addTypeVariations("taxonomy")
+		t.addSectionType()
+	case "taxonomy":
+		if t.lyDesc.Section != "" {
+			t.addLayoutVariations(t.lyDesc.Section + ".terms")
+		}
+		t.addSectionType()
+		t.addLayoutVariations("terms")
+		t.addKindVariations()
+	case "404":
+		t.addLayoutVariations("404")
+		t.addTypeVariations("")
+	case "robotstxt":
+		t.addLayoutVariations("robots")
+		t.addTypeVariations("")
+	case "sitemap":
+		t.addLayoutVariations("sitemap")
+		t.addTypeVariations("")
+	case "sitemapindex":
+		t.addLayoutVariations("sitemapindex")
+		t.addTypeVariations("")
+	}
+	isRSS := t.lyDesc.OutputFormatName == "rss"
+	if !t.lyDesc.RenderingHook && !t.lyDesc.Baseof && isRSS {
+		t.addLayoutVariations("")
+	}
+	if t.lyDesc.Baseof || t.lyDesc.Kind != "404" {
+		t.addTypeVariations("_default")
+	}
+	if t.isListLayout() {
+		t.addLayoutVariations("list")
+	}
+	if t.lyDesc.Baseof {
+		t.addLayoutVariations("baseof")
+	}
+	layouts := t.resolveLayoutVariations()
+	layouts = t.appendInternalLayouts(layouts, isRSS)
+	layouts = t.uniqueLayoutNames(layouts)
+	stored := make([]string, len(layouts))
+	copy(stored, layouts)
+	t.lyCache[d] = stored
+	t.lyMu.Unlock()
+	return layouts
+}
+
+func (t *templateHandler) resetLayoutBuilder(d layouts.LayoutDescriptor) {
+	t.lyDesc = d
+	t.lyLayoutVars = t.lyLayoutVars[:0]
+	t.lyTypeVars = t.lyTypeVars[:0]
+}
+
+func (t *templateHandler) addLayoutVariations(vars ...string) {
+	for _, layoutVar := range vars {
+		if t.lyDesc.Baseof && layoutVar != "baseof" {
+			t.lyLayoutVars = append(t.lyLayoutVars, layoutVar+"-baseof")
+			continue
+		}
+		if !t.lyDesc.RenderingHook && !t.lyDesc.Baseof && t.lyDesc.LayoutOverride && layoutVar != t.lyDesc.Layout {
+			continue
+		}
+		t.lyLayoutVars = append(t.lyLayoutVars, layoutVar)
+	}
+}
+
+func (t *templateHandler) addTypeVariations(vars ...string) {
+	for _, typeVar := range vars {
+		if t.lyReserved[typeVar] {
+			continue
+		}
+		if t.lyDesc.RenderingHook {
+			typeVar = typeVar + "/_markup"
+		}
+		t.lyTypeVars = append(t.lyTypeVars, typeVar)
+	}
+}
+
+func (t *templateHandler) addSectionType() {
+	if t.lyDesc.Section != "" {
+		t.addTypeVariations(t.lyDesc.Section)
+	}
+}
+
+func (t *templateHandler) addKindVariations() {
+	t.addLayoutVariations(t.lyDesc.Kind)
+	t.addTypeVariations(t.lyDesc.Kind)
+}
+
+func (t *templateHandler) isListLayout() bool {
+	d := t.lyDesc
+	if d.RenderingHook {
+		return false
+	}
+	switch d.Kind {
+	case "page", "404", "sitemap", "sitemapindex":
+		return false
+	default:
+		return true
+	}
+}
+
+func (t *templateHandler) layoutVariationSet() []string {
+	name := strings.ToLower(t.lyDesc.OutputFormatName)
+	var variations []string
+	if t.lyDesc.Lang != "" {
+		variations = append(variations, t.lyDesc.Lang+"."+name, name, t.lyDesc.Lang)
+	} else if name != "" {
+		variations = append(variations, name)
+	}
+	variations = append(variations, "")
+	return variations
+}
+
+func (t *templateHandler) preferLangLayout(variation, layoutVar, suffix string) string {
+	if variation == "" && layoutVar == "" {
+		return ""
+	}
+	return t.constructLayoutPath(t.lyDesc.Type, layoutVar, variation, suffix)
+}
+
+func (t *templateHandler) layoutPathForParts(typ, layoutVar, variation, suffix string) string {
+	if variation == "" && layoutVar == "" {
+		return ""
+	}
+	return t.constructLayoutPath(typ, layoutVar, variation, suffix)
+}
+
+func (t *templateHandler) resolveLayoutVariations() []string {
+	var out []string
+	variations := t.layoutVariationSet()
+	suffix := t.lyDesc.Suffix
+	for _, typeVar := range t.lyTypeVars {
+		for _, variation := range variations {
+			for _, layoutVar := range t.lyLayoutVars {
+				var s string
+				if typeVar == t.lyDesc.Type {
+					s = t.preferLangLayout(variation, layoutVar, suffix)
+				} else {
+					s = t.layoutPathForParts(typeVar, layoutVar, variation, suffix)
+				}
+				if s != "" {
+					out = append(out, s)
+				}
+			}
+		}
+	}
+	return out
+}
+
+func (t *templateHandler) constructLayoutPath(typ, layout, variations, extension string) string {
+	if extension == "" && (layout == "" || variations == "") {
+		return ""
+	}
+	var (
+		p       strings.Builder
+		needDot bool
+	)
+	if typ != "" {
+		p.WriteString(typ)
+		p.WriteString("/")
+	}
+	if layout != "" {
+		p.WriteString(layout)
+		needDot = true
+	}
+	if variations != "" {
+		if needDot {
+			p.WriteString(".")
+		}
+		p.WriteString(variations)
+		needDot = true
+	}
+	if extension != "" {
+		if needDot {
+			p.WriteString(".")
+		}
+		p.WriteString(extension)
+	}
+	return p.String()
+}
+
+func (t *templateHandler) uniqueLayoutNames(s []string) []string {
+	if len(s) < 2 {
+		return s
+	}
+	result := s[:0]
+	for i, val := range s {
+		seen := false
+		for j := 0; j < i; j++ {
+			if s[j] == val {
+				seen = true
+				break
+			}
+		}
+		if !seen {
+			result = append(result, val)
+		}
+	}
+	return result
+}
+
+func (t *templateHandler) appendInternalLayouts(layouts []string, isRSS bool) []string {
+	d := t.lyDesc
+	if !d.RenderingHook && !d.Baseof && isRSS {
+		layouts = append(layouts, "_internal/_default/rss.xml")
+	}
+	switch d.Kind {
+	case "robotstxt":
+		layouts = append(layouts, "_internal/_default/robots.txt")
+	case "sitemap":
+		layouts = append(layouts, "_internal/_default/sitemap.xml")
+	case "sitemapindex":
+		layouts = append(layouts, "_internal/_default/sitemapindex.xml")
+	}
+	return layouts
+}
+
+func (t *templateHandler) embeddedTemplateName(path, name string) string {
+	switch t.classifyEmbeddedPath(path) {
+	case "markup", "server":
+		return name
+	}
+	if t.shouldPreserveInternalPrefix(path, name) {
+		return name
+	}
+	t.emMu.RLock()
+	prefixes := t.emInternalPrefixes
+	t.emMu.RUnlock()
+	for _, prefix := range prefixes {
+		if prefix == internalPathPrefix {
+			return prefix + name
+		}
+	}
+	return internalPathPrefix + name
+}
+
+func (t *templateHandler) isEmbeddedMarkupHook(path, name string) bool {
+	if strings.Contains(path, "_default/_markup") || strings.Contains(name, "_markup/") {
+		return true
+	}
+	t.emMu.RLock()
+	kinds := t.emMarkupKinds
+	t.emMu.RUnlock()
+	base := filepath.Base(name)
+	for _, kind := range kinds {
+		if strings.HasPrefix(base, kind+".") || strings.HasPrefix(base, kind+"-") || base == kind+".html" {
+			return true
+		}
+	}
+	return false
+}
+
+func (t *templateHandler) isEmbeddedServerTemplate(name string) bool {
+	if strings.HasPrefix(name, "_server/") {
+		return true
+	}
+	if strings.HasPrefix(name, "partials/_funcs/") {
+		return true
+	}
+	t.emMu.RLock()
+	prefixes := t.emInternalPrefixes
+	t.emMu.RUnlock()
+	for _, prefix := range prefixes {
+		if prefix == "_server/" && strings.HasPrefix(name, prefix) {
+			return true
+		}
+	}
+	return false
+}
+
+func (t *templateHandler) resolveEmbeddedAlias(name string) []string {
+	t.emMu.RLock()
+	aliases := t.emAliasIndex[name]
+	t.emMu.RUnlock()
+	if len(aliases) == 0 {
+		return nil
+	}
+	out := make([]string, 0, len(aliases))
+	for _, alias := range aliases {
+		if alias == "" {
+			continue
+		}
+		out = append(out, internalPathPrefix+alias)
+	}
+	return out
+}
+
+func (t *templateHandler) shouldPreserveInternalPrefix(path, name string) bool {
+	if t.isEmbeddedMarkupHook(path, name) {
+		return true
+	}
+	if t.isEmbeddedServerTemplate(name) {
+		return true
+	}
+	return false
+}
+
+func (t *templateHandler) classifyEmbeddedPath(path string) string {
+	name := strings.TrimPrefix(filepath.ToSlash(path), "embedded/templates/")
+	switch {
+	case t.isEmbeddedMarkupHook(path, name):
+		return "markup"
+	case t.isEmbeddedServerTemplate(name):
+		return "server"
+	case strings.HasPrefix(name, shortcodesPathPrefix) || strings.Contains(name, "/shortcodes/"):
+		return "shortcode"
+	case strings.HasPrefix(name, "partials/"):
+		return "partial"
+	default:
+		return "layout"
+	}
+}
