+	case *parse.WithNode:
+		t.applyTransformationsToNodes(x.Pipe, x.List, x.ElseList)
+	case *parse.RangeNode:
+		t.applyTransformationsToNodes(x.Pipe, x.List, x.ElseList)
+	case *parse.TemplateNode:
+		subTempl := t.transformGetIfNotVisited(x.Name)
+		if subTempl != nil {
+			t.applyTransformationsToNodes(t.transformParseTree(subTempl.Template).Root)
+		}
+	case *parse.PipeNode:
+		t.collectTransformConfig(x)
+		for i, cmd := range x.Cmds {
+			keep, _ := t.applyNodeTransformations(cmd)
+			if !keep {
+				x.Cmds = append(x.Cmds[:i], x.Cmds[i+1:]...)
+			}
+		}
+	case *parse.CommandNode:
+		t.collectTransformInner(x)
+		keep := t.collectTransformReturnNode(x)
+		for _, elem := range x.Args {
+			switch an := elem.(type) {
+			case *parse.PipeNode:
+				t.applyNodeTransformations(an)
+			}
+		}
+		return keep, t.xfErr
+	}
+	return true, t.xfErr
+}
+
+func (t *templateHandler) applyTransformationsToNodes(nodes ...parse.Node) {
+	for _, node := range nodes {
+		t.applyNodeTransformations(node)
+	}
+}
+
+func (t *templateHandler) transformHasIdent(idents []string, ident string) bool {
+	for _, id := range idents {
+		if id == ident {
+			return true
+		}
+	}
+	return false
+}
+
+func (t *templateHandler) collectTransformConfig(n *parse.PipeNode) {
+	if t.xfCurrent == nil || t.xfCurrent.typ != templateShortcode {
+		return
+	}
+	if t.xfConfigChecked {
+		return
+	}
+	t.xfConfigChecked = true
+
+	if n == nil || len(n.Decl) != 1 || len(n.Cmds) != 1 {
+		return
+	}
+
+	v := n.Decl[0]
+	if len(v.Ident) == 0 || v.Ident[0] != "$_hugo_config" {
+		return
+	}
+
+	cmd := n.Cmds[0]
+	if len(cmd.Args) == 0 {
+		return
+	}
+
+	if s, ok := cmd.Args[0].(*parse.StringNode); ok {
+		errMsg := "failed to decode $_hugo_config in template: %w"
+		m, err := maps.ToStringMapE(s.Text)
+		if err != nil {
+			t.xfErr = fmt.Errorf(errMsg, err)
+			return
+		}
+		if err := mapstructure.WeakDecode(m, &t.xfCurrent.parseInfo.Config); err != nil {
+			t.xfErr = fmt.Errorf(errMsg, err)
+		}
+	}
+}
+
+func (t *templateHandler) collectTransformInner(n *parse.CommandNode) {
+	if t.xfCurrent == nil || t.xfCurrent.typ != templateShortcode {
+		return
+	}
+	if t.xfCurrent.parseInfo.IsInner || n == nil || len(n.Args) == 0 {
+		return
+	}
+
+	for _, arg := range n.Args {
+		var idents []string
+		switch nt := arg.(type) {
+		case *parse.FieldNode:
+			idents = nt.Ident
+		case *parse.VariableNode:
+			idents = nt.Ident
+		}
+		if t.transformHasIdent(idents, "Inner") || t.transformHasIdent(idents, "InnerDeindent") {
+			t.xfCurrent.parseInfo.IsInner = true
+			break
+		}
+	}
+}
+
+func (t *templateHandler) collectTransformReturnNode(n *parse.CommandNode) bool {
+	if t.xfCurrent == nil || t.xfCurrent.typ != templatePartial || t.transformReturnNode() != nil {
+		return true
+	}
+	if n == nil || len(n.Args) < 2 {
+		return true
+	}
+	ident, ok := n.Args[0].(*parse.IdentifierNode)
+	if !ok || ident.Ident != "return" {
+		return true
+	}
+	t.xfReturn = n
+	n.Args = n.Args[1:]
+	return false
+}
+
+func (t *templateHandler) transformPartialReturn(n *parse.ListNode) *parse.ListNode {
+	if n == nil || t.transformReturnNode() == nil {
+		return n
+	}
+	return t.wrapPartialReturn(n)
+}
