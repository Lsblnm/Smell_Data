+
+// LayoutKind returns the template kind used to look up a render hook layout.
+func LayoutKind(t RendererType) string {
+	switch t {
+	case LinkRendererType:
+		return "render-link"
+	case ImageRendererType:
+		return "render-image"
+	case HeadingRendererType:
+		return "render-heading"
+	case CodeBlockRendererType:
+		return "render-codeblock"
+	default:
+		return ""
+	}
+}
+
+// IsEmbeddedDefaultHook reports whether name is one of the embedded default
+// link or image render hook templates.
+func IsEmbeddedDefaultHook(name string) (isLink, isImage bool) {
+	switch name {
+	case "_default/_markup/render-link.html":
+		return true, false
+	case "_default/_markup/render-image.html":
+		return false, true
+	default:
+		return false, false
+	}
+}
+
+// LookupRenderer returns the renderer registered for t, if any.
+func LookupRenderer(get GetRendererFunc, t RendererType, id any) any {
+	if get == nil {
+		return nil
+	}
+	return get(t, id)
+}
