@@ -1,5 +1,7 @@
 # frozen_string_literal: true
 
+require 'uri'
+
 module RuboCop
   module Cop
     module Layout
@@ -134,6 +136,1076 @@ module RuboCop
         def space_style?
           cop_config['EnforcedStyle'] == 'space'
         end
+
+        public
+
+        LEADING_SPACE_LINE_1_ENDING = /['"]\s*\\\n/.freeze
+        LEADING_SPACE_LINE_2_BEGINNING = /\A\s*['"]/.freeze
+        LEADING_SPACE_LEADING_OFFENSE = /(?<trailing_spaces>\s+)(?<ending>#{LEADING_SPACE_LINE_1_ENDING})/.freeze
+        LEADING_SPACE_TRAILING_OFFENSE = /(?<beginning>#{LEADING_SPACE_LINE_2_BEGINNING})(?<leading_spaces>\s+)/.freeze
+
+        def leading_space_raw_lines(processed_source, node)
+          @leading_continuation_cache ||= {}
+          key = [processed_source.object_id, node.object_id, :raw_lines]
+          cached = @leading_continuation_cache[key]
+          return cached if cached
+
+          first_line = node.first_line
+          size = (node.first_line..node.last_line).size
+          lines = processed_source.raw_source.lines[first_line - 1, size]
+          @leading_continuation_cache[key] = lines
+          lines
+        end
+
+        def leading_space_continuation?(line, line_num, node)
+          @leading_continuation_cache ||= {}
+          return false unless line.end_with?("\\\n")
+
+          children = node.children
+          spanning = children.any? do |child|
+            next false unless child.respond_to?(:first_line) && child.respond_to?(:last_line)
+
+            (child.first_line...child.last_line).cover?(line_num) && child.multiline?
+          end
+          @leading_continuation_cache[:last_continuation_check] = !spanning
+          !spanning
+        end
+
+        def leading_space_style_leading?(cop_config)
+          @leading_continuation_cache ||= {}
+          @leading_continuation_cache[:style] = cop_config['EnforcedStyle']
+          @leading_continuation_cache[:style] == 'leading'
+        end
+
+        def leading_space_match_leading_offense(first_line)
+          @leading_continuation_cache ||= {}
+          matches = first_line.match(LEADING_SPACE_LEADING_OFFENSE)
+          @leading_continuation_cache[:leading_match] = matches
+          matches
+        end
+
+        def leading_space_match_trailing_offense(second_line)
+          @leading_continuation_cache ||= {}
+          matches = second_line.match(LEADING_SPACE_TRAILING_OFFENSE)
+          @leading_continuation_cache[:trailing_match] = matches
+          matches
+        end
+
+        def leading_space_leading_bounds(end_of_first_line, matches)
+          @leading_continuation_cache ||= {}
+          ending = matches[:ending]
+          trailing_spaces = matches[:trailing_spaces]
+          end_pos = end_of_first_line - ending.length
+          begin_pos = end_pos - trailing_spaces.length
+          @leading_continuation_cache[:leading_bounds] = [begin_pos, end_pos]
+          [begin_pos, end_pos]
+        end
+
+        def leading_space_trailing_bounds(end_of_first_line, matches)
+          @leading_continuation_cache ||= {}
+          beginning = matches[:beginning]
+          leading_spaces = matches[:leading_spaces]
+          begin_pos = end_of_first_line + beginning.length
+          end_pos = begin_pos + leading_spaces.length
+          @leading_continuation_cache[:trailing_bounds] = [begin_pos, end_pos]
+          [begin_pos, end_pos]
+        end
+
+        def leading_space_leading_insert_pos(end_of_first_line, second_line)
+          @leading_continuation_cache ||= {}
+          beginning = second_line[LEADING_SPACE_LINE_2_BEGINNING]
+          insert_pos = end_of_first_line + beginning.length
+          @leading_continuation_cache[:leading_insert] = insert_pos
+          insert_pos
+        end
+
+        def leading_space_trailing_insert_pos(end_of_first_line, first_line)
+          @leading_continuation_cache ||= {}
+          ending = first_line[LEADING_SPACE_LINE_1_ENDING]
+          insert_pos = end_of_first_line - ending.length
+          @leading_continuation_cache[:trailing_insert] = insert_pos
+          insert_pos
+        end
+
+        def leading_space_message(cop_config)
+          @leading_continuation_cache ||= {}
+          if leading_space_style_leading?(cop_config)
+            @leading_continuation_cache[:message] = 'Move trailing spaces to the start of the next line.'
+          else
+            @leading_continuation_cache[:message] = 'Move leading spaces to the end of the previous line.'
+          end
+          @leading_continuation_cache[:message]
+        end
+
+        def leading_space_each_offense(processed_source, node, cop_config)
+          @leading_continuation_cache ||= {}
+          return unless node.source.include?('\\')
+
+          end_of_first_line = node.source_range.begin_pos - node.source_range.column
+          lines = leading_space_raw_lines(processed_source, node)
+          offenses = []
+          lines.each_cons(2).with_index(node.first_line) do |(raw_line_one, raw_line_two), line_num|
+            end_of_first_line += raw_line_one.length
+            next unless leading_space_continuation?(raw_line_one, line_num, node)
+
+            offense = leading_space_offense_for_pair(raw_line_one, raw_line_two, end_of_first_line, cop_config)
+            next unless offense
+
+            offenses << offense
+            yield(*offense) if block_given?
+          end
+          @leading_continuation_cache[:offenses] = offenses
+          offenses
+        end
+
+        def leading_space_offense_for_pair(first_line, second_line, end_of_first_line, cop_config)
+          @leading_continuation_cache ||= {}
+          if leading_space_style_leading?(cop_config)
+            matches = leading_space_match_leading_offense(first_line)
+            return unless matches
+
+            bounds = leading_space_leading_bounds(end_of_first_line, matches)
+            insert_pos = leading_space_leading_insert_pos(end_of_first_line, second_line)
+            @leading_continuation_cache[:last_pair] = [bounds, insert_pos, matches[:trailing_spaces]]
+            [bounds, insert_pos, matches[:trailing_spaces]]
+          else
+            matches = leading_space_match_trailing_offense(second_line)
+            return unless matches
