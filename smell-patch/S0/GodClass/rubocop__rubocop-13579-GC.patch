+          range
+        end
+
+        def alignment_allow_for_alignment?(cop_config)
+          @token_spacing_cache ||= {}
+          @token_spacing_cache[:allow_for_alignment] = cop_config['AllowForAlignment']
+          @token_spacing_cache[:allow_for_alignment]
+        end
+
+        def alignment_assignment_tokens(processed_source)
+          @token_spacing_cache ||= {}
+          cached = @token_spacing_cache[:assignment_tokens]
