+          unique_tokens
+        end
+
+        def alignment_assignment_lines(processed_source)
+          @token_spacing_cache ||= {}
+          cached = @token_spacing_cache[:assignment_lines]
+          return cached if cached
+
+          lines = alignment_assignment_tokens(processed_source).map(&:line)
+          @token_spacing_cache[:assignment_lines] = lines
+          lines
+        end
+
+        def alignment_remove_optarg_equals(asgn_tokens, processed_source)
+          @token_spacing_cache ||= {}
+          ast = processed_source.ast
+          unless ast
+            @token_spacing_cache[:optarg_equals] = asgn_tokens
+            return asgn_tokens
+          end
