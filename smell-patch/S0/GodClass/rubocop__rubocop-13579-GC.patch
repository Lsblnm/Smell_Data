+          end.map(&:line)
+          @token_spacing_cache[:comment_lines] = lines
+          lines
+        end
+
+        def alignment_aligned_words?(range, line)
+          @token_spacing_cache ||= {}
+          left_edge = range.column
+          if left_edge.positive? && /\s\S/.match?(line[left_edge - 1, 2])
+            @token_spacing_cache[:aligned_words] = true
+            return true
+          end
+
+          token = range.source
+          aligned = token == line[left_edge, token.length]
+          @token_spacing_cache[:aligned_words] = aligned
+          aligned
+        end
+
+        def alignment_aligned_identical?(range, line)
+          @token_spacing_cache ||= {}
+          identical = range.source == line[range.column, range.size]
+          @token_spacing_cache[:aligned_identical] = identical
+          identical
