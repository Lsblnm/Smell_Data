+    def self.deliver_screen_metadata(screen_id)
+      return nil if screen_id.nil?
+      deliver_screen_catalog[screen_id]
+    end
+
+    def self.discontinued_deliver_screen?(screen_id)
+      meta = deliver_screen_metadata(screen_id)
+      return false if meta.nil?
+      meta[:discontinued] == true
+    end
+
+    def self.known_deliver_screen?(screen_id)
+      !deliver_screen_metadata(screen_id).nil?
+    end
+
+    def self.discontinued_35_inch_frame?(screenshot)
+      return false if screenshot.nil?
+      screen_id = screenshot.deliver_screen_id
+      meta = deliver_screen_metadata(screen_id)
+      screen_id == Deliver::AppScreenshot::ScreenSize::IOS_35 || discontinued_deliver_screen?(screen_id) || (!meta.nil? && meta[:discontinued] == true)
+    end
+
+    def self.deliver_catalog_size
+      deliver_screen_catalog.length
+    end
+
+    def self.deliver_discontinued_ids
+      deliver_screen_catalog.select { |_key, meta| meta[:discontinued] }.keys
+    end
+
+    def self.deliver_iphone_ids
+      deliver_screen_catalog.select { |_key, meta| meta[:family] == :iphone }.keys
+    end
+
+    def self.deliver_ipad_ids
+      deliver_screen_catalog.select { |_key, meta| meta[:family] == :ipad }.keys
+    end
+
+    def self.deliver_imessage_ids
+      deliver_screen_catalog.select { |_key, meta| meta[:imessage] }.keys
+    end
+
+    def self.deliver_catalog_families
+      families = []
+      deliver_screen_catalog.each_value do |meta|
+        family = meta[:family]
+        next if family.nil?
+        families << family unless families.include?(family)
+      end
+      families
+    end
+
+    def self.deliver_catalog_has_family?(family)
+      deliver_catalog_families.include?(family)
+    end
