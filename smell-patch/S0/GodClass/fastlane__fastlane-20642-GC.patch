+      UI.user_error!("Could not find offset_information for '#{screenshot}'")
+    end
+
+    def self.scaled_offset_hash(offset_information, multiplicator)
+      hash = offset_information['offset']
+      x = hash.split("+")[1].to_f * multiplicator
+      y = hash.split("+")[2].to_f * multiplicator
+      offset_information['offset'] = "+#{x.round}+#{y.round}"
+      offset_information
+    end
+
+    def self.title_below_image?(config)
+      config['title_below_image']
+    end
+
+    def self.scale_padding_value(padding, image_width, image_height, device)
+      if padding.kind_of?(String) && padding.end_with?('%')
+        padding = ([image_width, image_height].min * padding.to_f * 0.01).ceil
+      end
+      padding * device.padding_density_multiplier
+    end
+
+    def self.horizontal_frame_padding(config, image_width, image_height, device)
+      padding = config['padding']
+      if padding.kind_of?(String) && padding.split('x').length == 2
+        padding = padding.split('x')[0]
+        padding = padding.to_i unless padding.end_with?('%')
+      end
+      scale_padding_value(padding, image_width, image_height, device)
+    end
+
+    def self.vertical_frame_padding(config, image_width, image_height, device)
+      padding = config['padding']
+      if padding.kind_of?(String) && padding.split('x').length == 2
+        padding = padding.split('x')[1]
+        padding = padding.to_i unless padding.end_with?('%')
+      end
+      scale_padding_value(padding, image_width, image_height, device)
+    end
+
+    def self.title_min_height(config, image_width, image_height)
+      height = config['title_min_height'] || 0
+      if height.kind_of?(String) && height.end_with?('%')
+        height = ([image_width, image_height].min * height.to_f * 0.01).ceil
+      end
+      height
+    end
+
+    def self.device_top_offset(background_height, image_height, text_height, below_image)
+      if below_image
+        background_height - text_height - image_height
+      else
+        text_height
+      end
+    end
+
+    def self.frame_resize_multiplicator(screenshot, offset_information)
+      screenshot_width = screenshot.portrait? ? screenshot.size[0] : screenshot.size[1]
+      screenshot_width.to_f / offset_information['width'].to_f
+    end
+
+    def self.actual_font_size_for(config, key, image_width)
+      font_size = config[key.to_s]['font_size']
+      return font_size if !font_size.nil? && font_size > 0
+      font_scale_factor = config['font_scale_factor'] || 0.1
+      UI.user_error!("Parameter 'font_scale_factor' can not be 0. Please provide a value larger than 0.0 (default = 0.1).") if font_scale_factor == 0.0
+      [image_width * font_scale_factor].max.round
+    end
+
+    def self.fetch_screenshot_text(screenshot, config, type)
+      UI.user_error!("Valid parameters :keyword, :title") unless [:keyword, :title].include?(type)
+      nearest = File.join(File.expand_path("../", screenshot.path), "#{type}.strings")
+      parent = File.join(File.expand_path("../../", screenshot.path), "#{type}.strings")
+      ancestor = File.join(File.expand_path("../../../", screenshot.path), "#{type}.strings")
+      if File.exist?(nearest)
+        strings_path = nearest
+      elsif File.exist?(parent)
+        strings_path = parent
+      else
+        strings_path = ancestor
+      end
+      if File.exist?(strings_path)
+        parsed = StringsParser.parse(strings_path)
+        text_array = parsed.find { |k, v| screenshot.path.upcase.include?(k.upcase) }
+        if text_array && text_array.last && text_array.last.length > 0
+          return text_array.last
+        end
+      end
+      UI.verbose("Falling back to text in Framefile.json as there was nothing specified in the #{type}.strings file")
+      type_config = config[type.to_s]
+      if type_config && type_config['text'] && type_config['text'].length > 0
+        return type_config['text']
+      end
+      nil
+    end
+
+    def self.fetch_configured_frame_color(config)
+      color = config['frame']
+      return nil if color.nil?
+      Frameit::Color.constants.each do |c|
+        constant = Frameit::Color.const_get(c)
+        return constant if color == constant.upcase.gsub(' ', '_')
+      end
+      nil
+    end
+
+    def self.apply_frame_color_from_config(screenshot, config)
+      color = fetch_configured_frame_color(config)
+      screenshot.color = color if color
+      color
+    end
+
+    def self.font_for_key(screenshot, config, key)
+      single_font = config[key.to_s]['font']
+      return single_font if single_font
+      fonts = config[key.to_s]['fonts']
+      if fonts
+        fonts.each do |font|
+          if font['supported']
+            font['supported'].each do |language|
+              return font["font"] if screenshot.language == language
+            end
+          else
+            UI.verbose("Found a font with no list of supported languages, using this now")
+            return font["font"]
+          end
+        end
+      end
+      UI.verbose("No custom font specified for #{screenshot}, using the default one")
+      nil
+    end
+
+    def self.compose_framefile_values(data, path, config_path)
+      specifics = data['data'].select { |a| path.include?(a['filter']) }
+      default = data['default']
+      values = default.clone
+      specifics.each do |specific|
+        values = values.fastlane_deep_merge(specific)
+      end
+      absolutize_framefile_paths!(values, config_path)
+      validate_framefile_values(values)
+      values
+    end
+
+    def self.absolutize_framefile_paths!(values, config_path)
+      values.each do |key, value|
+        if value.kind_of?(Hash)
+          absolutize_framefile_paths!(value, config_path)
+        elsif value.kind_of?(Array)
+          value.each do |current|
+            absolutize_framefile_paths!(current, config_path) if current.kind_of?(Hash)
+          end
+        elsif ['font', 'background'].include?(key) && config_path
+          containing_folder = File.expand_path('..', config_path)
+          value.replace(File.join(containing_folder, value))
+        end
+      end
+    end
+
+    def self.validate_framefile_values(values)
+      values.each do |key, value|
+        if value.kind_of?(Hash)
+          validate_framefile_values(value)
+        else
+          validate_framefile_key(key, value)
+        end
+      end
+    end
+
+    def self.validate_framefile_key(key, value)
+      case key
+      when 'font'
+        UI.user_error!("Could not find font at path '#{File.expand_path(value)}'") unless File.exist?(value)
+      when 'fonts'
+        check_font_entries(value)
+      when 'background'
+        UI.user_error!("Could not find background image at path '#{File.expand_path(value)}'") unless File.exist?(value)
+      when 'color'
+        UI.user_error!("Invalid color '#{value}'. Must be valid Hex #123123") unless value.include?("#")
+      when 'padding'
+        unless integer_or_percentage?(value) || value.split('x').length == 2
+          UI.user_error!("padding must be an integer, or pair of integers of format 'AxB', or a percentage of screen size")
+        end
+      when 'title_min_height'
+        unless integer_or_percentage?(value)
+          UI.user_error!("padding must be an integer, or a percentage of screen size")
+        end
+      when 'show_complete_frame', 'title_below_image'
+        UI.user_error!("'#{key}' must be a Boolean") unless [true, false].include?(value)
+      when 'font_scale_factor'
+        UI.user_error!("font_scale_factor must be numeric") unless value.kind_of?(Numeric)
+      when 'frame'
+        UI.user_error!("Invalid frame color '#{value}'. Frame color must be one of " + Color.all_colors.join(', ')) unless supported_color?(value)
+      when 'use_platform'
+        UI.user_error!("Invalid platform type '#{value}'. Available values are " + Platform.all_platforms.join(', ') + ".") unless supported_platform?(value)
+      when 'force_device_type'
+        UI.user_error!("Invalid device type '#{value}'. Available values: " + Devices.all_device_names_without_apple.join(', ')) unless supported_device?(value)
+      end
+    end
+
+    def self.check_font_entries(value)
+      UI.user_error!("`fonts` must be an array") unless value.kind_of?(Array)
+      value.each do |current|
+        UI.user_error!("You must specify a font path") if current.fetch('font', '').length == 0
+        UI.user_error!("Could not find font at path '#{File.expand_path(current.fetch('font'))}'") unless File.exist?(current.fetch('font'))
+        UI.user_error!("`supported` must be an array") unless current.fetch('supported', []).kind_of?(Array)
+      end
+    end
+
+    def self.integer_or_percentage?(value)
+      value.kind_of?(Integer) || (value.end_with?('%') && value.to_f > 0)
+    end
+
+    def self.supported_color?(value)
+      return false if value.nil?
+      Color.all_colors.any?(value)
+    end
+
+    def self.supported_platform?(value)
+      return false if value.nil?
+      Platform.all_platforms.any?(value)
+    end
+
+    def self.supported_device?(value)
+      !find_device_by_id_or_name(value).nil?
+    end
