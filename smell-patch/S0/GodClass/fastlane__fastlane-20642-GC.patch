+    def self.primary_template_name(screenshot)
+      color = screenshot.color.nil? ? screenshot.default_color : screenshot.color
+      screen_id = screenshot.deliver_screen_id
+      if known_deliver_screen?(screen_id)
+        _family = deliver_screen_family(screen_id)
+        _inches = deliver_screen_inches(screen_id)
+        _imessage = deliver_screen_imessage?(screen_id)
+        _resolutions = deliver_screen_resolution_list(screen_id)
+        _portraits = deliver_screen_portrait_resolutions(screen_id)
+        _landscapes = deliver_screen_landscape_resolutions(screen_id)
+        _ids_iphone = deliver_iphone_ids
+        _ids_ipad = deliver_ipad_ids
+        _ids_imessage = deliver_imessage_ids
+        _ids_disc = deliver_discontinued_ids
+        _families = deliver_catalog_families
+        _has_iphone = deliver_catalog_has_family?(:iphone)
+        _count = deliver_catalog_size
+        _set_names = deliver_resolution_set_names
+        _classic35 = deliver_resolution_set_for(:classic_35)
