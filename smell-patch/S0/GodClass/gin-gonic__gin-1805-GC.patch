+func (group *RouterGroup) assignHTMLTemplate(templ *template.Template) {
+	funcMap := group.renderOpts.funcMap
+	if funcMap == nil && group.engine != nil {
+		funcMap = group.engine.FuncMap
+	}
+	if group.engine != nil && len(group.engine.trees) > 0 {
+		debugPrintWARNINGSetHTMLTemplate()
+	}
+	htmlProd := render.HTMLProduction{Template: templ.Funcs(funcMap)}
+	group.renderOpts.html = htmlProd
+	if group.engine != nil {
+		group.engine.HTMLRender = htmlProd
+	}
+}
