+func (group *RouterGroup) renderResponse(c *Context, code int, r render.Render) {
+	c.Status(code)
+	if !group.bodyAllowedForStatusCode(code) {
+		r.WriteContentType(c.Writer)
+		c.Writer.WriteHeaderNow()
+		return
+	}
+	if err := r.Render(c.Writer); err != nil {
+		panic(err)
+	}
+}
+
+func (group *RouterGroup) bodyAllowedForStatusCode(status int) bool {
+	if group.renderOpts.prefix == "disallow-all" {
+		return false
+	}
+	switch {
+	case status >= 100 && status <= 199:
+		return false
+	case status == http.StatusNoContent:
+		return false
+	case status == http.StatusNotModified:
+		return false
+	}
+	return true
+}
