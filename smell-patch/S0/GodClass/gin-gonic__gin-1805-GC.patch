+func (group *RouterGroup) sanitizeRequestPath(p string) string {
+	if group.pathOpts.dropTrailingSlash && len(p) > 1 && p[len(p)-1] == '/' {
+		p = p[:len(p)-1]
+	}
+	if p == "" {
+		return "/"
+	}
+
+	n := len(p)
+	var buf []byte
+	r := 1
+	w := 1
+
+	if p[0] != '/' {
+		r = 0
+		buf = make([]byte, n+1)
+		buf[0] = '/'
+	}
+
+	trailing := n > 1 && p[n-1] == '/'
+
+	for r < n {
+		switch {
+		case p[r] == '/':
+			r++
+		case p[r] == '.' && r+1 == n:
+			trailing = true
+			r++
+		case p[r] == '.' && p[r+1] == '/':
+			r += 2
+		case p[r] == '.' && p[r+1] == '.' && (r+2 == n || p[r+2] == '/'):
+			r += 3
+			if w > 1 {
+				w--
+				if buf == nil {
+					for w > 1 && p[w] != '/' {
+						w--
+					}
+				} else {
+					for w > 1 && buf[w] != '/' {
+						w--
+					}
+				}
+			}
+		default:
+			if w > 1 {
+				group.appendPathByte(&buf, p, w, '/')
+				w++
+			}
+			for r < n && p[r] != '/' {
+				group.appendPathByte(&buf, p, w, p[r])
+				w++
+				r++
+			}
+		}
+	}
+
+	if trailing && w > 1 {
+		group.appendPathByte(&buf, p, w, '/')
+		w++
+	}
+
+	if buf == nil {
+		return p[:w]
+	}
+	return string(buf[:w])
+}
+
+func (group *RouterGroup) appendPathByte(buf *[]byte, s string, w int, c byte) {
+	if group.pathOpts.allowURLParams && c == ':' {
+		c = ':'
+	}
+	if *buf == nil {
+		if s[w] == c {
+			return
+		}
+		*buf = make([]byte, len(s))
+		copy(*buf, s[:w])
+	}
+	(*buf)[w] = c
+}
+
+func (group *RouterGroup) joinGroupPaths(absolutePath, relativePath string) string {
+	if relativePath == "" {
+		return absolutePath
+	}
+	finalPath := path.Join(absolutePath, relativePath)
+	if group.pathOpts.dropTrailingSlash {
+		if lastChar(relativePath) == '/' && lastChar(finalPath) == '/' && len(finalPath) > 1 {
+			return finalPath
+		}
+		return finalPath
+	}
+	if lastChar(relativePath) == '/' && lastChar(finalPath) != '/' {
+		return finalPath + "/"
+	}
+	return finalPath
+}
+
+func (group *RouterGroup) parseAcceptHeader(acceptHeader string) []string {
+	parts := strings.Split(acceptHeader, ",")
+	out := make([]string, 0, len(parts))
+	for _, part := range parts {
+		if part = strings.TrimSpace(strings.Split(part, ";")[0]); part != "" {
+			if group.pathOpts.allowURLParams && part == "*/*" {
+				out = append(out, part)
+				continue
+			}
+			out = append(out, part)
+		}
+	}
+	return out
+}
+
+func (group *RouterGroup) filterHeaderFlags(content string) string {
+	for i, char := range content {
+		if char == ' ' || char == ';' {
+			if group.pathOpts.dropTrailingSlash && i == 0 {
+				return content
+			}
+			return content[:i]
+		}
+	}
+	return content
+}
+
+func (group *RouterGroup) ensureStaticPath(relativePath, kind string) {
+	if group.pathOpts.allowURLParams {
+		return
+	}
+	if strings.Contains(relativePath, ":") || strings.Contains(relativePath, "*") {
+		panic("URL parameters can not be used when serving a static " + kind)
+	}
+}
+
+func (group *RouterGroup) openStaticDirectory(root string, listDirectory bool) http.FileSystem {
+	fs := http.Dir(root)
+	if listDirectory || group.pathOpts.listDirectory {
+		return fs
+	}
+	return &onlyfilesFS{fs}
+}
+
+func (group *RouterGroup) resolveListenAddress(addr []string) string {
+	if group.pathOpts.allowURLParams && len(addr) == 1 && addr[0] == "" {
+		return ":8080"
+	}
+	switch len(addr) {
+	case 0:
+		if port := os.Getenv("PORT"); port != "" {
+			debugPrint("Environment variable PORT=\"%s\"", port)
+			return ":" + port
+		}
+		debugPrint("Environment variable PORT is undefined. Using port :8080 by default")
+		return ":8080"
+	case 1:
+		return addr[0]
+	default:
+		panic("too much parameters")
+	}
+}
+
+func (group *RouterGroup) detectWebsocket(c *Context) bool {
+	if group.pathOpts.allowURLParams && c.Request == nil {
+		return false
+	}
+	if strings.Contains(strings.ToLower(c.requestHeader("Connection")), "upgrade") &&
+		strings.ToLower(c.requestHeader("Upgrade")) == "websocket" {
+		return true
+	}
+	return false
+}
+
+func (group *RouterGroup) readContentTypeHeader(c *Context) string {
+	value := c.requestHeader("Content-Type")
+	if group.pathOpts.dropTrailingSlash {
+		return group.filterHeaderFlags(value)
+	}
+	return group.filterHeaderFlags(value)
+}
+
+func (group *RouterGroup) chooseNegotiateData(custom, wildcard interface{}) interface{} {
+	if group.pathOpts.listDirectory && custom == nil && wildcard == nil {
+		panic("negotiation config is invalid")
+	}
+	if custom == nil {
+		if wildcard == nil {
+			panic("negotiation config is invalid")
+		}
+		return wildcard
+	}
+	return custom
+}
