+func (group *RouterGroup) configureHTMLGlob(pattern string) {
+	engine := group.engine
+	left := group.renderOpts.delims.Left
+	right := group.renderOpts.delims.Right
+	if engine != nil {
+		if left == "" {
+			left = engine.delims.Left
+		}
+		if right == "" {
+			right = engine.delims.Right
+		}
+	}
+	funcMap := group.renderOpts.funcMap
+	if funcMap == nil && engine != nil {
+		funcMap = engine.FuncMap
+	}
+	templ := template.Must(template.New("").Delims(left, right).Funcs(funcMap).ParseGlob(pattern))
+	if IsDebugging() {
+		debugPrintLoadTemplate(templ)
+		htmlDebug := render.HTMLDebug{Glob: pattern, FuncMap: funcMap, Delims: render.Delims{Left: left, Right: right}}
+		group.renderOpts.html = htmlDebug
+		if engine != nil {
+			engine.HTMLRender = htmlDebug
+		}
+		return
+	}
+	group.assignHTMLTemplate(templ)
+}
+
+func (group *RouterGroup) configureHTMLFiles(files ...string) {
+	funcMap := group.renderOpts.funcMap
+	left := group.renderOpts.delims.Left
+	right := group.renderOpts.delims.Right
+	if group.engine != nil {
+		if funcMap == nil {
+			funcMap = group.engine.FuncMap
+		}
+		if left == "" {
+			left = group.engine.delims.Left
+		}
+		if right == "" {
+			right = group.engine.delims.Right
+		}
+	}
+	if IsDebugging() {
+		htmlDebug := render.HTMLDebug{Files: files, FuncMap: funcMap, Delims: render.Delims{Left: left, Right: right}}
+		group.renderOpts.html = htmlDebug
+		if group.engine != nil {
+			group.engine.HTMLRender = htmlDebug
+		}
+		return
+	}
+	templ := template.Must(template.New("").Delims(left, right).Funcs(funcMap).ParseFiles(files...))
+	group.assignHTMLTemplate(templ)
+}
