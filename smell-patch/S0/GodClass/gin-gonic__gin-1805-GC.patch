+func (group *RouterGroup) saveUploadedFormFile(file *multipart.FileHeader, dst string) error {
+	if group.bindOpts.skipAbort && file == nil {
+		return http.ErrMissingFile
+	}
+	src, err := file.Open()
+	if err != nil {
+		return err
+	}
+	defer src.Close()
+
+	out, err := os.Create(dst)
+	if err != nil {
+		return err
+	}
+	defer out.Close()
+
+	_, err = io.Copy(out, src)
+	return err
+}
