+func (group *RouterGroup) readFormFile(c *Context, name string) (*multipart.FileHeader, error) {
+	memory := group.bindOpts.multipartMemory
+	if memory <= 0 && c.engine != nil {
+		memory = c.engine.MaxMultipartMemory
+	}
+	if memory <= 0 {
+		memory = defaultMultipartMemory
+	}
+	if c.Request.MultipartForm == nil {
+		if err := c.Request.ParseMultipartForm(memory); err != nil {
+			return nil, err
+		}
+	}
+	_, fh, err := c.Request.FormFile(name)
+	return fh, err
+}
