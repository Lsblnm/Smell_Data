+func (group *RouterGroup) shouldBindBodyWithEngine(c *Context, obj interface{}, bb binding.BindingBody) (err error) {
+	cacheKey := group.bindOpts.bodyCacheKey
+	if cacheKey == "" {
+		cacheKey = BodyBytesKey
+	}
+	var body []byte
+	if cb, ok := c.Get(cacheKey); ok {
+		if cbb, ok := cb.([]byte); ok {
+			body = cbb
+		}
+	}
+	if body == nil {
+		body, err = ioutil.ReadAll(c.Request.Body)
+		if err != nil {
+			return err
+		}
+		c.Set(cacheKey, body)
+	}
+	return bb.BindBody(body, obj)
+}
