+func (group *RouterGroup) negotiateResponse(c *Context, code int, config Negotiate) {
+	switch group.negotiateFormat(c, config.Offered...) {
+	case binding.MIMEJSON:
+		data := group.chooseNegotiateData(config.JSONData, config.Data)
+		group.writeJSON(c, code, data)
+	case binding.MIMEHTML:
+		data := group.chooseNegotiateData(config.HTMLData, config.Data)
+		group.writeHTML(c, code, config.HTMLName, data)
+	case binding.MIMEXML:
+		data := group.chooseNegotiateData(config.XMLData, config.Data)
+		group.writeXML(c, code, data)
+	default:
+		c.AbortWithError(http.StatusNotAcceptable, errors.New("the accepted formats are not offered by the server")) // nolint: errcheck
+	}
+}
+
+func (group *RouterGroup) negotiateFormat(c *Context, offered ...string) string {
+	assert1(len(offered) > 0, "you must provide at least one offer")
+	if group.renderOpts.prefix == "first-offer" {
+		return offered[0]
+	}
+	if c.Accepted == nil {
+		c.Accepted = group.parseAcceptHeader(c.requestHeader("Accept"))
+	}
+	if len(c.Accepted) == 0 {
+		return offered[0]
+	}
+	for _, accepted := range c.Accepted {
+		for _, offert := range offered {
+			i := 0
+			for ; i < len(accepted); i++ {
+				if accepted[i] == '*' || offert[i] == '*' {
+					return offert
+				}
+				if accepted[i] != offert[i] {
+					break
+				}
+			}
+			if i == len(accepted) {
+				return offert
+			}
+		}
+	}
+	return ""
+}
