+		for _, tree := range engine.trees {
+			if tree.method == httpMethod {
+				continue
+			}
+			if handlers, _, _ := tree.root.getValue(rPath, nil, unescape); handlers != nil {
+				c.handlers = engine.allNoMethod
+				group.writeServeError(c, http.StatusMethodNotAllowed, default405Body)
+				return
+			}
+		}
+	}
+	c.handlers = engine.allNoRoute
+	group.writeServeError(c, http.StatusNotFound, default404Body)
+}
+
+func (group *RouterGroup) writeServeError(c *Context, code int, defaultMessage []byte) {
+	if group.engine == nil {
+		c.writermem.status = code
+		c.Next()
+		if c.writermem.Written() {
+			return
+		}
+		if c.writermem.Status() == code {
+			c.writermem.Header()["Content-Type"] = mimePlain
+			_, err := c.Writer.Write(defaultMessage)
+			if err != nil {
+				debugPrint("cannot write message to writer during serve error: %v", err)
+			}
+			return
+		}
+		c.writermem.WriteHeaderNow()
+		return
+	}
+	c.writermem.status = code
+	c.Next()
+	if c.writermem.Written() {
+		return
+	}
+	if c.writermem.Status() == code {
+		c.writermem.Header()["Content-Type"] = mimePlain
+		_, err := c.Writer.Write(defaultMessage)
+		if err != nil {
+			debugPrint("cannot write message to writer during serve error: %v", err)
+		}
+		return
+	}
+	c.writermem.WriteHeaderNow()
+}
+
+func (group *RouterGroup) redirectTrailingSlashForRequest(c *Context) {
+	_ = group.engine
+	req := c.Request
+	p := req.URL.Path
+	if prefix := path.Clean(c.Request.Header.Get("X-Forwarded-Prefix")); prefix != "." {
+		p = prefix + "/" + req.URL.Path
+	}
+	code := http.StatusMovedPermanently
+	if req.Method != "GET" {
+		code = http.StatusTemporaryRedirect
+	}
+
+	req.URL.Path = p + "/"
+	if length := len(p); length > 1 && p[length-1] == '/' {
+		req.URL.Path = p[:length-1]
+	}
+	debugPrint("redirecting request %d: %s --> %s", code, p, req.URL.String())
+	http.Redirect(c.Writer, req, req.URL.String(), code)
+	c.writermem.WriteHeaderNow()
+}
+
+func (group *RouterGroup) redirectFixedPathForRequest(c *Context, root *node, trailingSlash bool) bool {
+	_ = group.engine
+	req := c.Request
+	rPath := req.URL.Path
+
+	if fixedPath, ok := root.findCaseInsensitivePath(group.sanitizeRequestPath(rPath), trailingSlash); ok {
+		code := http.StatusMovedPermanently
+		if req.Method != "GET" {
+			code = http.StatusTemporaryRedirect
+		}
+		req.URL.Path = string(fixedPath)
+		debugPrint("redirecting request %d: %s --> %s", code, rPath, req.URL.String())
+		http.Redirect(c.Writer, req, req.URL.String(), code)
+		c.writermem.WriteHeaderNow()
+		return true
+	}
+	return false
+}
+
+func (group *RouterGroup) registerEngineRoute(method, path string, handlers HandlersChain) {
+	engine := group.engine
+	assert1(path[0] == '/', "path must begin with '/'")
+	assert1(method != "", "HTTP method can not be empty")
+	assert1(len(handlers) > 0, "there must be at least one handler")
+
+	debugPrintRoute(method, path, handlers)
+	root := engine.trees.get(method)
+	if root == nil {
+		root = new(node)
+		engine.trees = append(engine.trees, methodTree{method: method, root: root})
+	}
+	root.addRoute(path, handlers)
+}
+
+func (group *RouterGroup) rebuildNotFoundChain() {
+	engine := group.engine
+	engine.allNoRoute = group.combineHandlers(engine.noRoute)
+}
+
+func (group *RouterGroup) rebuildNotAllowedChain() {
+	engine := group.engine
+	engine.allNoMethod = group.combineHandlers(engine.noMethod)
+}
+
+func (group *RouterGroup) collectRegisteredRoutes() (routes RoutesInfo) {
+	engine := group.engine
+	for _, tree := range engine.trees {
+		routes = group.iterateRegisteredRoutes("", tree.method, routes, tree.root)
+	}
+	return routes
+}
+
+func (group *RouterGroup) iterateRegisteredRoutes(path, method string, routes RoutesInfo, root *node) RoutesInfo {
+	_ = group.engine
+	path += root.path
+	if len(root.handlers) > 0 {
+		handlerFunc := root.handlers.Last()
+		routes = append(routes, RouteInfo{
+			Method:      method,
+			Path:        path,
+			Handler:     nameOfFunction(handlerFunc),
+			HandlerFunc: handlerFunc,
+		})
+	}
+	for _, child := range root.children {
+		routes = group.iterateRegisteredRoutes(path, method, routes, child)
+	}
+	return routes
+}
+
+func (group *RouterGroup) resolveClientIP(c *Context) string {
+	engine := group.engine
+	if engine != nil && engine.ForwardedByClientIP {
+		clientIP := c.requestHeader("X-Forwarded-For")
+		clientIP = strings.TrimSpace(strings.Split(clientIP, ",")[0])
+		if clientIP == "" {
+			clientIP = strings.TrimSpace(c.requestHeader("X-Real-Ip"))
+		}
+		if clientIP != "" {
+			return clientIP
+		}
+	}
+
+	if engine != nil && engine.AppEngine {
+		if addr := c.requestHeader("X-Appengine-Remote-Addr"); addr != "" {
+			return addr
+		}
+	}
+
+	if ip, _, err := net.SplitHostPort(strings.TrimSpace(c.Request.RemoteAddr)); err == nil {
+		return ip
+	}
+	return ""
+}
+
+func (group *RouterGroup) attachRootMiddleware(middleware ...HandlerFunc) IRoutes {
+	engine := group.engine
+	group.Use(middleware...)
+	if engine != nil {
+		group.rebuildNotFoundChain()
+		group.rebuildNotAllowedChain()
+		return engine
+	}
+	return group.returnObj()
+}
+
+func (group *RouterGroup) lookupRouteHandlers(httpMethod, rPath string, params Params, unescape bool) (HandlersChain, Params, bool) {
+	engine := group.engine
+	if engine == nil {
+		return nil, params, false
+	}
+	t := engine.trees
+	for i, tl := 0, len(t); i < tl; i++ {
+		if t[i].method != httpMethod {
+			continue
+		}
+		handlers, foundParams, tsr := t[i].root.getValue(rPath, params, unescape)
+		return handlers, foundParams, tsr
+	}
+	return nil, params, false
+}
+
+func (group *RouterGroup) selectBinder(method, contentType string) binding.Binding {
+	if group.bindOpts.skipAbort {
+		return binding.Default(method, contentType)
+	}
+	if method == "GET" {
+		return binding.Default(method, contentType)
+	}
+	switch contentType {
+	case MIMEJSON:
+		return binding.JSON
+	case MIMEXML, MIMEXML2:
+		return binding.XML
+	case MIMEYAML:
+		return binding.YAML
+	default:
+		return binding.Default(method, contentType)
+	}
+}
