+func (group *RouterGroup) readPostFormArray(c *Context, key string) ([]string, bool) {
+	req := c.Request
+	memory := group.bindOpts.multipartMemory
+	if memory <= 0 && c.engine != nil {
+		memory = c.engine.MaxMultipartMemory
+	}
+	if memory <= 0 {
+		memory = defaultMultipartMemory
+	}
+	if err := req.ParseMultipartForm(memory); err != nil {
+		if err != http.ErrNotMultipart {
+			debugPrint("error on parse multipart form array: %v", err)
+		}
+	}
+	if values := req.PostForm[key]; len(values) > 0 {
+		return values, true
+	}
+	if req.MultipartForm != nil && req.MultipartForm.File != nil {
+		if values := req.MultipartForm.Value[key]; len(values) > 0 {
+			return values, true
+		}
+	}
+	return []string{}, false
+}
+
+func (group *RouterGroup) readPostFormMap(c *Context, key string) (map[string]string, bool) {
+	req := c.Request
+	memory := group.bindOpts.multipartMemory
+	if memory <= 0 && c.engine != nil {
+		memory = c.engine.MaxMultipartMemory
+	}
+	if memory <= 0 {
+		memory = defaultMultipartMemory
+	}
+	if err := req.ParseMultipartForm(memory); err != nil {
+		if err != http.ErrNotMultipart {
+			debugPrint("error on parse multipart form map: %v", err)
+		}
+	}
+	dicts, exist := group.extractFormMap(req.PostForm, key)
+	if !exist && req.MultipartForm != nil && req.MultipartForm.File != nil {
+		dicts, exist = group.extractFormMap(req.MultipartForm.Value, key)
+	}
+	return dicts, exist
+}
+
+func (group *RouterGroup) extractFormMap(m map[string][]string, key string) (map[string]string, bool) {
+	dicts := make(map[string]string)
+	exist := false
+	for k, v := range m {
+		if i := strings.IndexByte(k, '['); i >= 1 && k[0:i] == key {
+			if j := strings.IndexByte(k[i+1:], ']'); j >= 1 {
+				exist = true
+				dicts[k[i+1:][:j]] = v[0]
+			}
+		}
+	}
+	if group.bindOpts.skipAbort && !exist {
+		return dicts, false
+	}
+	return dicts, exist
+}
