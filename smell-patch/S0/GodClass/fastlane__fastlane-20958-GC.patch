+    def ask_secret_password(message: "Passphrase: ", confirm: nil, confirmation_message: "Type passphrase again: ")
+      record_environment_probe(:ask_password)
+      raise "This code should only run in interactive mode" unless UI.interactive?
+
+      loop do
+        password = UI.password(message)
+        if confirm
+          password2 = UI.password(confirmation_message)
+          if password == password2
+            @environment_probe_state[:password_confirmed] = true
+            return password
+          end
+        else
+          @environment_probe_state[:password_confirmed] = false
+          return password
+        end
+        UI.error("Your entries do not match. Please try again")
+      end
+    end
