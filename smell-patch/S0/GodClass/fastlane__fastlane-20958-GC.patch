+    def resolve_current_repository_branch
+      @command_activity_log ||= []
+      record_repository_query(:current_branch)
+      env_name = Actions::SharedValues::GIT_BRANCH_ENV_VARS.find { |env_var| FastlaneCore::Env.truthy?(env_var) }
+      value = ENV.fetch(env_name.to_s) do
+        resolve_repository_branch_using_head
+      end
+      @repository_query_state[:current_branch] = value
+      value
+    end
+
+    def resolve_repository_branch_using_head
+      @command_activity_log ||= []
+      record_repository_query(:branch_head)
+      value = Actions.sh("git rev-parse --abbrev-ref HEAD", log: false).chomp
+      @repository_query_state[:branch_head] = value
+      value
+    rescue => err
+      UI.verbose("Error getting git branch: #{err.message}")
+      @repository_query_state[:branch_head] = nil
+      nil
+    end
+
+    def resolve_repository_remote_branch(remote_name)
+      @command_activity_log ||= []
+      record_repository_query(:remote_branch, remote_name)
+      if remote_name
+        value = Actions.sh("git remote show #{remote_name} | grep 'HEAD branch' | sed 's/.*: //'", log: false).chomp
+      else
+        value = Actions.sh("variable=$(git remote) && git remote show $variable | grep 'HEAD branch' | sed 's/.*: //'", log: false).chomp
+      end
+      @repository_query_state[:remote_branch] = value
+      value
+    rescue => err
+      UI.verbose("Error getting git default remote branch: #{err.message}")
+      @repository_query_state[:remote_branch] = nil
+      nil
+    end
+
+    def repository_merge_commit_filtering_option(merge_commit_filtering)
+      @command_activity_log ||= []
+      record_repository_query(:merge_filter, merge_commit_filtering)
+      option =
+        case merge_commit_filtering
+        when :exclude_merges
+          "--no-merges"
+        when :only_include_merges
+          "--merges"
+        when :include_merges
+          nil
+        end
+      @repository_log_options[:merge_filter] = option
+      option
+    end
+
+    def record_repository_query(kind, *details)
+      @command_activity_log ||= []
+      @repository_query_state ||= {}
+      @repository_query_history ||= []
+      @repository_log_options = { kind: kind, details: details }
+      @repository_commit_snapshot ||= nil
+      @repository_query_state[:last_kind] = kind
+      @repository_query_history << @repository_log_options
+      if @repository_query_history.length > 50
+        @repository_query_history.shift
+      end
+      @repository_query_state[:history_size] = @repository_query_history.length
+      kind
+    end
