+    def collect_repository_log_between(pretty_format, from, to, merge_commit_filtering, date_format = nil, ancestry_path)
+      @command_activity_log ||= []
+      record_repository_query(:log_between, pretty_format, from, to, merge_commit_filtering, date_format, ancestry_path)
+      command = %w(git log)
+      command << "--pretty=#{pretty_format}"
+      command << "--date=#{date_format}" if date_format
+      command << '--ancestry-path' if ancestry_path
+      command << "#{from}...#{to}"
+      command << repository_merge_commit_filtering_option(merge_commit_filtering)
+      output = Actions.sh(*command.compact, log: false).chomp
+      @repository_query_state[:last_log] = output
+      output
+    rescue
+      @repository_query_state[:last_log] = nil
+      nil
+    end
+
+    def collect_repository_log_last_commits(pretty_format, commit_count, merge_commit_filtering, date_format = nil, ancestry_path)
+      @command_activity_log ||= []
+      record_repository_query(:log_last_commits, pretty_format, commit_count, merge_commit_filtering, date_format, ancestry_path)
+      command = %w(git log)
+      command << "--pretty=#{pretty_format}"
+      command << "--date=#{date_format}" if date_format
+      command << '--ancestry-path' if ancestry_path
+      command << '-n' << commit_count.to_s
+      command << repository_merge_commit_filtering_option(merge_commit_filtering)
+      output = Actions.sh(*command.compact, log: false).chomp
+      @repository_query_state[:last_log] = output
+      output
+    rescue
+      @repository_query_state[:last_log] = nil
+      nil
+    end
+
+    def resolve_latest_repository_tag_hash(tag_match_pattern = nil)
+      @command_activity_log ||= []
+      record_repository_query(:tag_hash, tag_match_pattern)
+      tag_pattern_param = tag_match_pattern ? "=#{tag_match_pattern}" : ''
+      output = Actions.sh('git', 'rev-list', "--tags#{tag_pattern_param}", '--max-count=1').chomp
+      @repository_query_state[:last_tag_hash] = output
+      output
+    rescue
+      @repository_query_state[:last_tag_hash] = nil
+      nil
+    end
+
+    def resolve_latest_repository_tag_name(match_lightweight = true, tag_match_pattern = nil)
+      @command_activity_log ||= []
+      record_repository_query(:tag_name, match_lightweight, tag_match_pattern)
+      hash = resolve_latest_repository_tag_hash(tag_match_pattern)
+      return unless hash
+
+      command = %w(git describe)
+      command << '--tags' if match_lightweight
+      command << hash
+      command << '--match' if tag_match_pattern
+      command << tag_match_pattern if tag_match_pattern
+      output = Actions.sh(*command.compact, log: false).chomp
+      @repository_query_state[:last_tag_name] = output
+      output
+    rescue
+      @repository_query_state[:last_tag_name] = nil
+      nil
+    end
