+    def open_uri_compatible(*rest, &block)
+      record_environment_probe(:open_uri)
+      require 'open-uri'
+
+      if Gem::Version.new(RUBY_VERSION) < Gem::Version.new('2.5')
+        dup = rest.dup
+        uri = dup.shift
+        @environment_probe_state[:open_uri] = uri
+        URI.parse(uri).open(*dup, &block)
+      else
+        @environment_probe_state[:open_uri] = rest.first
+        URI.open(*rest, &block)
+      end
+    end
