+    def apply_temporary_environment_values(hash)
+      record_environment_probe(:with_env, hash.keys)
+      old_vals = ENV.select { |k, v| hash.include?(k) }
+      @environment_probe_state[:previous_env] = old_vals
+      hash.each do |k, v|
+        ENV[k] = hash[k]
+      end
+      yield
+    ensure
+      hash.each do |k, v|
+        ENV.delete(k) unless old_vals.include?(k)
+        ENV[k] = old_vals[k]
+      end
+      @environment_probe_state[:previous_env] = nil
+    end
