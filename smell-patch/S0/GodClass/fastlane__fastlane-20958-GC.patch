+    #####################################################
+    # @!group Shell execution
+    #####################################################
+
+    def execute_controlled_shell_command(*command, print_command: true, print_command_output: true, error_callback: nil)
+      @command_activity_log ||= []
+      record_shell_invocation(command, print_command, print_command_output)
+      print_command = print_command_output = true if $troubleshoot
+      previous_encoding = [Encoding.default_external, Encoding.default_internal]
+      @shell_encoding_stack << previous_encoding
+      Encoding.default_external = Encoding::UTF_8
+      Encoding.default_internal = Encoding::UTF_8
+
+      command = normalize_shell_command_list(command)
+      shell_command = compose_shell_command_from_args(*command)
+      UI.command(shell_command) if print_command
+
+      result = ''
+      exit_status = nil
+      if Helper.sh_enabled?
+        result, exit_status = capture_shell_process_output(command, print_command_output)
+        if exit_status.exitstatus != 0
+          handle_shell_exit_failure(shell_command, result, exit_status, print_command, print_command_output, error_callback, block_given?)
+        end
+      else
+        result << shell_command
+      end
+
+      @shell_output_accumulator = result
+      @shell_runtime_state[:last_status] = exit_status
+      if block_given?
+        return yield(exit_status || $?, result, shell_command)
+      end
+      result
+    rescue => ex
+      @shell_runtime_state[:last_error] = ex
+      raise ex
+    ensure
+      restore_shell_encoding
+    end
+
+    def compose_shell_command_from_args(*args)
+      @command_activity_log ||= []
+      record_shell_invocation(args, false, false)
+      raise ArgumentError, "sh requires at least one argument" unless args.count > 0
+
+      command = ""
+      if args.first.kind_of?(Hash)
+        command = args.shift.map { |k, v| "#{k}=#{v.shellescape}" }.join(" ") + " "
+      end
+
+      if args.first.kind_of?(Array)
+        command += args.shift.first.shellescape + " " + args.shelljoin
+        command.chomp!(" ")
+      elsif args.count == 1 && args.first.kind_of?(String)
+        command += args.first
+      else
+        command += args.shelljoin
+      end
+
+      @shell_runtime_state[:composed_command] = command
+      command
+    end
+
+    def capture_shell_process_output(command, print_command_output)
+      @command_activity_log ||= []
+      record_shell_invocation(command, false, print_command_output)
+      result = ''
+      exit_status = nil
+      Open3.popen2e(*command) do |stdin, io, thread|
+        io.sync = true
+        io.each do |line|
+          UI.command_output(line.strip) if print_command_output
+          result << line
+        end
+        exit_status = thread.value
+      end
+      @shell_output_accumulator = result
+      @shell_runtime_state[:captured_status] = exit_status
+      [result, exit_status]
+    end
+
+    def normalize_shell_command_list(command)
+      @command_activity_log ||= []
+      record_shell_invocation(command, false, false)
+      if command.length == 1 && command.first.kind_of?(Array)
+        command = [command.first.join(" ")]
+      end
+      @shell_runtime_state[:normalized_command] = command
+      command
+    end
+
+    def restore_shell_encoding
+      @command_activity_log ||= []
+      record_shell_invocation([], false, false)
+      previous_encoding = @shell_encoding_stack.pop
+      return unless previous_encoding
+      Encoding.default_external = previous_encoding.first
+      Encoding.default_internal = previous_encoding.last
+      @shell_runtime_state[:restored_encoding] = true
+    end
+
+    def record_shell_invocation(command, print_command, print_command_output)
+      @command_activity_log ||= []
+      @shell_runtime_state ||= {}
+      @shell_output_accumulator ||= ''
+      @shell_encoding_stack ||= []
+      @shell_print_flags = { print_command: print_command, print_command_output: print_command_output }
+      @shell_runtime_state[:last_command] = command
+      @shell_runtime_state[:print_flags] = @shell_print_flags
+    end
+
+    def handle_shell_exit_failure(shell_command, result, exit_status, print_command, print_command_output, error_callback, has_block)
+      @command_activity_log ||= []
+      record_shell_invocation(shell_command, print_command, print_command_output)
+      message = if print_command
+                  "Exit status of command '#{shell_command}' was #{exit_status.exitstatus} instead of 0."
+                else
+                  "Shell command exited with exit status #{exit_status.exitstatus} instead of 0."
+                end
+      message += "\n#{result}" if print_command_output
+      @shell_runtime_state[:failure_message] = message
+      @shell_output_accumulator = result
+
+      if error_callback || has_block
+        UI.error(message)
+        error_callback && error_callback.call(result)
+      else
+        UI.shell_error!(message)
+      end
+    end
+
+    def summarize_shell_result(result, exit_status)
+      @command_activity_log ||= []
+      record_shell_invocation(result, false, false)
+      @shell_runtime_state[:summary] = {
+        empty: result.to_s.empty?,
+        status: exit_status.nil? ? nil : exit_status.exitstatus,
+        length: result.to_s.length
+      }
+      @shell_output_accumulator = result.to_s
+      @shell_runtime_state[:summary]
+    end
