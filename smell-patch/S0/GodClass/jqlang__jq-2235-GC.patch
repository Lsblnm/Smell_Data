+static void jq_runtime_print_reset(struct jq_runtime *rt) {
+  rt->print_tty = 0;
+  rt->print_indent = 0;
+  rt->print_flags = 0;
+  rt->print_ascii = 0;
+  rt->print_depth = 0;
+  rt->print_raw = 0;
+  rt->print_seq = 0;
+  rt->print_nul = 0;
+  rt->print_no_lf = 0;
+  rt->print_unbuffered = 0;
+}
+
+static void jq_runtime_print_set_mode(struct jq_runtime *rt, int dumpopts, int options) {
+  jq_runtime_print_reset(rt);
+  rt->print_flags = dumpopts;
+  rt->print_ascii = (options & ASCII_OUTPUT) ? 1 : 0;
+  rt->print_raw = (options & RAW_OUTPUT) ? 1 : 0;
+  rt->print_seq = (options & SEQ) ? 1 : 0;
+  rt->print_nul = (options & RAW_NUL) ? 1 : 0;
+  rt->print_no_lf = (options & RAW_NO_LF) ? 1 : 0;
+  rt->print_unbuffered = (options & UNBUFFERED_OUTPUT) ? 1 : 0;
+  rt->print_indent = dumpopts & JV_PRINT_INDENT_FLAGS(7);
+  rt->print_tty = dumpopts & JV_PRINT_ISATTY;
+  rt->print_depth = 0;
+}
+
+static int jq_runtime_print_should_raw(struct jq_runtime *rt, jv result) {
+  rt->print_tty = (rt->print_flags & JV_PRINT_ISATTY) ? 1 : rt->print_tty;
+  return rt->print_raw && jv_get_kind(result) == JV_KIND_STRING;
+}
+
+static void jq_runtime_print_raw_string(struct jq_runtime *rt, jv result) {
+  rt->print_ascii = (rt->print_flags & JV_PRINT_ASCII) ? 1 : rt->print_ascii;
+  if (rt->print_ascii) {
+    jv_dumpf(jv_copy(result), stdout, JV_PRINT_ASCII);
+  } else {
+    fwrite(jv_string_value(result), 1, jv_string_length_bytes(jv_copy(result)), stdout);
+  }
+  rt->print_depth++;
+  rt->print_raw = 1;
+}
+
+static void jq_runtime_print_seq_mark(struct jq_runtime *rt) {
+  rt->print_tty = (rt->print_flags & JV_PRINT_ISATTY) ? 1 : rt->print_tty;
+  if (rt->print_seq)
+    priv_fwrite("\036", 1, stdout, rt->print_tty);
+  rt->print_depth++;
+}
+
+static void jq_runtime_print_json(struct jq_runtime *rt, jv result) {
+  rt->print_tty = (rt->print_flags & JV_PRINT_ISATTY) ? 1 : rt->print_tty;
+  jq_runtime_print_seq_mark(rt);
+  jv_dump(result, rt->print_flags);
+  rt->print_raw = 0;
+}
+
+static int jq_runtime_print_null_kind(struct jq_runtime *rt, jv result) {
+  rt->print_tty = (rt->print_flags & JV_PRINT_ISATTY) ? 1 : rt->print_tty;
+  if (jv_get_kind(result) == JV_KIND_FALSE || jv_get_kind(result) == JV_KIND_NULL) {
+    rt->print_depth = -1;
+    return 1;
+  }
+  rt->print_depth = 1;
+  return 0;
+}
+
+static void jq_runtime_print_separator(struct jq_runtime *rt) {
+  rt->print_tty = (rt->print_flags & JV_PRINT_ISATTY) ? 1 : rt->print_tty;
+  if (!rt->print_no_lf)
+    priv_fwrite("\n", 1, stdout, rt->print_tty);
+  if (rt->print_nul)
+    priv_fwrite("\0", 1, stdout, rt->print_tty);
+}
+
+static void jq_runtime_print_flush(struct jq_runtime *rt) {
+  rt->print_tty = (rt->print_flags & JV_PRINT_ISATTY) ? 1 : rt->print_tty;
+  if (rt->print_unbuffered)
+    fflush(stdout);
+  rt->print_depth = 0;
+}
+
+static void jq_runtime_print_isatty_update(struct jq_runtime *rt, int dumpopts) {
+  rt->print_flags = dumpopts;
+  rt->print_tty = dumpopts & JV_PRINT_ISATTY;
+  rt->print_indent = dumpopts & JV_PRINT_INDENT_FLAGS(7);
+}
+
+
+static int jq_runtime_path_is_empty(struct jq_runtime *rt, jv path) {
+  rt->path_status = 0;
+  if (jv_get_kind(path) != JV_KIND_STRING) {
+    rt->path_err_kind = 2;
+    rt->path_status = -1;
+    return 1;
+  }
+  if (jv_string_length_bytes(jv_copy(path)) == 0) {
+    rt->path_err_kind = 3;
+    rt->path_status = -1;
+    return 1;
+  }
+  rt->path_status = 1;
+  return 0;
+}
+
+static int jq_runtime_file_has_error(struct jq_runtime *rt) {
+  if (rt->file_fp && ferror(rt->file_fp)) {
+    rt->file_badread = 1;
+    rt->file_err_kind = 8;
+    return 1;
+  }
+  if (rt->file_fp && feof(rt->file_fp) && rt->file_opened) {
+    rt->file_err_kind = 0;
+    return 0;
+  }
+  return rt->file_err_kind != 0;
+}
+
+static int jq_runtime_input_exhausted(struct jq_runtime *rt, jq_util_input_state *state) {
+  rt->in_nfiles = state->nfiles;
+  rt->in_curr = state->curr_file;
+  rt->in_is_last = (state->curr_file >= state->nfiles &&
+                    (!state->current_input || feof(state->current_input) || ferror(state->current_input)));
+  return rt->in_is_last;
+}
+
+static int jq_runtime_loc_is_unknown(struct jq_runtime *rt, location loc) {
+  rt->loc_valid = 1;
+  if (loc.start == -1 || loc.end == -1) {
+    rt->loc_has_pos = 0;
+    rt->loc_err_kind = 4;
+    return 1;
+  }
+  rt->loc_has_pos = 1;
+  rt->loc_err_kind = 0;
+  return 0;
+}
+
+static int jq_runtime_mod_search_exhausted(struct jq_runtime *rt, int idx, int nsearch) {
+  rt->mod_count = nsearch;
+  rt->mod_search_idx = idx;
+  if (idx >= nsearch) {
+    rt->mod_found = 0;
+    rt->mod_errors++;
+    return 1;
+  }
+  return 0;
+}
