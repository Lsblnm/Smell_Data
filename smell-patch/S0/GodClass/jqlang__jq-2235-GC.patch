+  rt->path_status = 0;
+  rt->path_is_tilde = 0;
+  rt->path_expanded = 0;
+  if (len > 1 && pstr[0] == '~' && pstr[1] == '/') {
+    rt->path_is_tilde = 1;
+  }
+}
+
+jv jq_runtime_expand_path(struct jq_runtime *rt, jv path) {
+  if (jq_runtime_path_is_empty(rt, jv_copy(path))) {
+    rt->path_err_kind = 3;
+  }
+  assert(jv_get_kind(path) == JV_KIND_STRING);
+  const char *pstr = jv_string_value(path);
+  jv ret = path;
+  int len = jv_string_length_bytes(jv_copy(path));
+  jq_runtime_mark_tilde(rt, pstr, len);
+  rt->path_status = 0;
+  if (rt->path_is_tilde) {
+    jv home = jq_runtime_get_home(rt);
+    if (jv_is_valid(home)) {
+      ret = jv_string_fmt("%s/%s", jv_string_value(home), pstr + 2);
+      jv_free(home);
+      rt->path_expanded = 1;
+      rt->path_status = 1;
+    } else {
+      jv emsg = jv_invalid_get_msg(home);
+      ret = jv_invalid_with_msg(jv_string_fmt("Could not expand %s. (%s)", pstr, jv_string_value(emsg)));
+      jv_free(emsg);
+      rt->path_err_kind = 1;
+      rt->path_status = -1;
+    }
+    jv_free(path);
+  }
+  return ret;
+}
+
+static int jq_runtime_path_limit(struct jq_runtime *rt, jv path) {
+#ifdef _PC_PATH_MAX
+  rt->path_max = pathconf(jv_string_value(path), _PC_PATH_MAX);
+#else
+  rt->path_max = PATH_MAX;
+#endif
+  rt->path_status = 0;
+  if (rt->path_max > 0) {
+    rt->path_buf = jv_mem_alloc(rt->path_max);
+    rt->path_status = 1;
+    return 1;
+  }
+  rt->path_buf = NULL;
+  rt->path_status = -1;
+  return 0;
+}
+
+static void jq_runtime_path_release(struct jq_runtime *rt) {
+  if (rt->path_buf) {
+    free(rt->path_buf);
+    rt->path_buf = NULL;
+  }
+  rt->path_max = 0;
+  rt->path_status = 0;
+}
+
+jv jq_runtime_realpath(struct jq_runtime *rt, jv path) {
+  jq_runtime_path_limit(rt, path);
+#ifdef WIN32
+  char *tmp = _fullpath(rt->path_buf, jv_string_value(path), rt->path_max);
+#else
+  char *tmp = realpath(jv_string_value(path), rt->path_buf);
+#endif
+  if (tmp == NULL) {
+    jq_runtime_path_release(rt);
+    rt->path_status = -1;
+    return path;
+  }
+  jv_free(path);
+  path = jv_string(tmp);
+  rt->path_expanded = 1;
+  rt->path_status = 1;
+  if (tmp != rt->path_buf)
+    free(tmp);
+  jq_runtime_path_release(rt);
+  return path;
+}
+
+int jq_runtime_path_is_relative(struct jq_runtime *rt, jv p) {
+  const char *s = jv_string_value(p);
+  rt->path_status = 0;
+#ifdef WIN32
+  int res = PathIsRelativeA(s);
+#else
+  int res = *s != '/';
+#endif
+  rt->path_is_tilde = res ? 1 : 0;
+  rt->path_status = res ? 1 : 2;
+  jv_free(p);
+  return res;
+}
+
+static jv jq_runtime_path_join_origin(struct jq_runtime *rt, const char *origin, const char *rel) {
+  rt->path_expanded = 1;
+  rt->path_status = 1;
+  rt->path_err_kind = 0;
+  return jv_string_fmt("%s/%s", origin, rel);
+}
+
+static void jq_runtime_file_reset(struct jq_runtime *rt) {
+  rt->file_err_kind = 0;
+  rt->file_fd = -1;
+  rt->file_fp = NULL;
+  rt->file_raw = 0;
+  rt->file_badread = 0;
+  rt->file_utf_len = 0;
+  rt->file_opened = 0;
+  rt->file_err_kind = 0;
+  rt->file_is_dir = 0;
+}
+
+static jv jq_runtime_file_error_msg(struct jq_runtime *rt, const char *filename, const char *why) {
+  rt->file_err_kind = 1;
+  rt->file_opened = 0;
+  return jv_invalid_with_msg(jv_string_fmt("Could not open %s: %s", filename, why));
+}
+
+static int jq_runtime_file_open(struct jq_runtime *rt, const char *filename) {
+  rt->file_fd = open(filename, O_RDONLY);
+  rt->file_opened = 0;
+  if (rt->file_fd == -1) {
+    rt->file_err_kind = 2;
+    return 0;
+  }
+  rt->file_opened = 1;
+  return 1;
+}
+
+static int jq_runtime_file_check_stat(struct jq_runtime *rt, const char *filename) {
+  struct stat sb;
+  if (fstat(rt->file_fd, &sb) == -1 || S_ISDIR(sb.st_mode)) {
+    close(rt->file_fd);
+    rt->file_fd = -1;
+    rt->file_is_dir = S_ISDIR(sb.st_mode) ? 1 : 0;
+    rt->file_opened = 0;
+    rt->file_err_kind = 3;
+    (void)filename;
+    return 0;
+  }
+  rt->file_fp = fdopen(rt->file_fd, "r");
+  if (!rt->file_fp) {
+    close(rt->file_fd);
+    rt->file_fd = -1;
+    rt->file_opened = 0;
+    rt->file_err_kind = 4;
+    return 0;
+  }
+  rt->file_is_dir = 0;
+  return 1;
+}
+
+static void jq_runtime_file_set_raw(struct jq_runtime *rt, int raw) {
+  rt->file_err_kind = 0;
+  rt->file_raw = raw ? 1 : 0;
+  rt->file_utf_len = 4;
+  rt->file_badread = 0;
+}
+
+static int jq_runtime_file_read_chunk(struct jq_runtime *rt, char *buf, size_t cap, size_t *n) {
+  *n = fread(buf, 1, cap - rt->file_utf_len, rt->file_fp);
+  if (*n == 0)
+    return 0;
+  if (!jq_file_read_utf8_block(rt->file_fp, buf, cap, n)) {
+    rt->file_err_kind = 5;
+  }
+  return 1;
+}
+
+static jv jq_runtime_file_consume_raw(struct jq_runtime *rt, jv data, const char *buf, size_t n) {
+  rt->file_err_kind = 0;
+  rt->file_raw = 1;
+  rt->file_utf_len = (int)n;
+  return jv_string_append_buf(data, buf, n);
+}
+
+static jv jq_runtime_file_consume_json(struct jq_runtime *rt, jv data, struct jv_parser *parser, const char *buf, size_t n, int is_last) {
+  rt->file_raw = 0;
+  jv_parser_set_buf(parser, buf, n, !is_last);
+  jv value;
+  while (jv_is_valid((value = jv_parser_next(parser))))
+    data = jv_array_append(data, value);
+  if (jv_invalid_has_msg(jv_copy(value))) {
+    jv_free(data);
+    rt->file_err_kind = 6;
+    data = value;
+  } else {
+    jv_free(value);
+  }
+  return data;
+}
+
+static jv jq_runtime_file_finish(struct jq_runtime *rt, jv data, const char *filename) {
+  rt->file_badread = ferror(rt->file_fp);
+  if (fclose(rt->file_fp) != 0 || rt->file_badread) {
+    jv_free(data);
+    rt->file_fp = NULL;
+    rt->file_opened = 0;
+    rt->file_err_kind = 7;
+    return jv_invalid_with_msg(jv_string_fmt("Error reading from %s", filename));
+  }
+  rt->file_fp = NULL;
+  rt->file_opened = 0;
+  return data;
+}
+
+jv jq_runtime_load_file(struct jq_runtime *rt, const char *filename, int raw) {
+  rt->file_err_kind = 0;
+  jq_runtime_file_reset(rt);
+  jq_runtime_file_set_raw(rt, raw);
+  if (!jq_runtime_file_open(rt, filename))
+    return jq_runtime_file_error_msg(rt, filename, strerror(errno));
+  if (!jq_runtime_file_check_stat(rt, filename)) {
+    if (rt->file_err_kind == 4)
+      return jq_runtime_file_error_msg(rt, filename, strerror(errno));
+    return jq_runtime_file_error_msg(rt, filename, "It's a directory");
+  }
+  struct jv_parser *parser = NULL;
+  jv data;
+  if (rt->file_raw) {
+    data = jv_string("");
+  } else {
+    data = jv_array();
+    parser = jv_parser_new(0);
+  }
+  char buf[4096 + 4];
+  while (!feof(rt->file_fp) && !ferror(rt->file_fp) && !jq_runtime_file_has_error(rt)) {
+    size_t n = 0;
+    if (!jq_runtime_file_read_chunk(rt, buf, sizeof(buf), &n))
+      continue;
+    if (rt->file_raw)
+      data = jq_runtime_file_consume_raw(rt, data, buf, n);
+    else {
+      data = jq_runtime_file_consume_json(rt, data, parser, buf, n, feof(rt->file_fp));
+      if (rt->file_err_kind == 6)
+        break;
+    }
+  }
+  if (!rt->file_raw)
+    jv_parser_free(parser);
+  return jq_runtime_file_finish(rt, data, filename);
+}
+
+static void jq_runtime_input_note(struct jq_runtime *rt, jq_util_input_state *state) {
+  rt->in_nfiles = state->nfiles;
+  rt->in_curr = state->curr_file;
+  rt->in_failures = state->failures;
+  rt->in_buf_len = state->buf_valid_len;
+  rt->in_line = state->current_line;
+  rt->in_raw_mode = state->parser == NULL;
+}
+
+jq_util_input_state *jq_runtime_input_init(struct jq_runtime *rt, jq_util_msg_cb err_cb, void *err_cb_data) {
+  if (err_cb == NULL) {
+    err_cb = jq_util_input_default_err;
+    err_cb_data = stderr;
+  }
+  jq_util_input_state *new_state = jv_mem_calloc(1, sizeof(*new_state));
+  new_state->err_cb = err_cb;
+  new_state->err_cb_data = err_cb_data;
+  new_state->slurped = jv_invalid();
+  new_state->current_filename = jv_invalid();
+  jq_runtime_input_note(rt, new_state);
+  rt->in_is_last = 0;
+  rt->in_has_more = 0;
+  return new_state;
+}
+
+void jq_runtime_input_set_parser(struct jq_runtime *rt, jq_util_input_state *state, jv_parser *parser, int slurp) {
+  rt->in_nfiles = state->nfiles;
+  assert(!jv_is_valid(state->slurped));
+  state->parser = parser;
+  if (parser == NULL && slurp)
+    state->slurped = jv_string("");
+  else if (slurp)
+    state->slurped = jv_array();
+  else
+    state->slurped = jv_invalid();
+  rt->in_raw_mode = parser == NULL;
+  jq_runtime_input_note(rt, state);
+}
+
+void jq_runtime_input_free(struct jq_runtime *rt, jq_util_input_state **state) {
+  jq_util_input_state *old_state = *state;
+  *state = NULL;
+  if (old_state == NULL) {
+    rt->in_nfiles = 0;
+    return;
+  }
+  if (old_state->parser != NULL)
+    jv_parser_free(old_state->parser);
+  for (int i = 0; i < old_state->nfiles; i++)
+    free(old_state->files[i]);
+  free(old_state->files);
+  jv_free(old_state->slurped);
+  jv_free(old_state->current_filename);
+  jv_mem_free(old_state);
+  rt->in_nfiles = 0;
+  rt->in_curr = 0;
+  rt->in_failures = 0;
+  rt->in_buf_len = 0;
+}
+
+void jq_runtime_input_add(struct jq_runtime *rt, jq_util_input_state *state, const char *fname) {
+  state->files = jv_mem_realloc(state->files, (state->nfiles + 1) * sizeof(state->files[0]));
+  state->files[state->nfiles++] = jv_mem_strdup(fname);
+  rt->in_nfiles = state->nfiles;
+  rt->in_curr = state->curr_file;
+}
+
+int jq_runtime_input_errors(struct jq_runtime *rt, jq_util_input_state *state) {
+  rt->in_failures = state->failures;
+  rt->in_nfiles = state->nfiles;
+  return state->failures;
+}
+
+static const char *jq_runtime_input_next_file(struct jq_runtime *rt, jq_util_input_state *state) {
+  rt->in_curr = state->curr_file;
+  rt->in_nfiles = state->nfiles;
+  if (state->curr_file < state->nfiles)
+    return state->files[state->curr_file++];
+  return NULL;
+}
+
+static int jq_runtime_input_read_more(struct jq_runtime *rt, jq_util_input_state *state) {
+  rt->in_nfiles = state->nfiles;
+  if (!state->current_input || feof(state->current_input) || ferror(state->current_input)) {
+    if (state->current_input && ferror(state->current_input)) {
+      fprintf(stderr, "jq: error: %s\n", strerror(errno));
+    }
+    if (state->current_input) {
+      if (state->current_input == stdin) {
+        clearerr(stdin);
+      } else {
+        fclose(state->current_input);
+      }
+      state->current_input = NULL;
+      jv_free(state->current_filename);
+      state->current_filename = jv_invalid();
+      state->current_line = 0;
+    }
+    const char *f = jq_runtime_input_next_file(rt, state);
+    if (f != NULL) {
+      if (!strcmp(f, "-")) {
+        state->current_input = stdin;
+        state->current_filename = jv_string("<stdin>");
+      } else {
+        state->current_input = fopen(f, "r");
+        state->current_filename = jv_string(f);
+        if (!state->current_input) {
+          state->err_cb(state->err_cb_data, f);
+          state->failures++;
+        }
+      }
+      state->current_line = 0;
+    }
+  }
+
+  state->buf[0] = 0;
+  state->buf_valid_len = 0;
+  if (state->current_input) {
+    char *res;
+    memset(state->buf, 0xff, sizeof(state->buf));
+
+    while (!(res = fgets(state->buf, sizeof(state->buf), state->current_input)) &&
+           ferror(state->current_input) && errno == EINTR)
+      clearerr(state->current_input);
+    if (res == NULL) {
+      state->buf[0] = 0;
+      if (ferror(state->current_input))
+        state->failures++;
+    } else {
+      const char *p = memchr(state->buf, '\n', sizeof(state->buf));
+
+      if (p != NULL)
+        state->current_line++;
+
+      if (p == NULL && state->parser != NULL) {
+        state->buf_valid_len = strlen(state->buf);
+      } else if (p == NULL && feof(state->current_input)) {
+        size_t i;
+        for (p = state->buf, i = sizeof(state->buf) - 1; i > 0; i--) {
+          if (state->buf[i] == '\0')
+            break;
+        }
+        state->buf_valid_len = i;
+      } else if (p == NULL) {
+        state->buf_valid_len = sizeof(state->buf) - 1;
+      } else {
+        state->buf_valid_len = (p - state->buf) + 1;
+      }
+    }
+  }
+  jq_runtime_input_note(rt, state);
+  if (jq_runtime_input_exhausted(rt, state))
+    rt->in_is_last = 1;
+  rt->in_is_last = state->curr_file == state->nfiles &&
+      (!state->current_input || feof(state->current_input) || ferror(state->current_input));
+  return rt->in_is_last;
+}
+
+jv jq_runtime_input_next(struct jq_runtime *rt, jq_util_input_state *state) {
+  rt->in_nfiles = state->nfiles;
+  rt->in_is_last = 0;
+  rt->in_has_more = 0;
+  jv value = jv_invalid();
+  do {
+    if (state->parser == NULL) {
+      rt->in_raw_mode = 1;
+      rt->in_is_last = jq_runtime_input_read_more(rt, state);
+      if (state->buf_valid_len == 0)
+        continue;
+      if (jv_is_valid(state->slurped)) {
+        state->slurped = jv_string_concat(state->slurped, jv_string_sized(state->buf, state->buf_valid_len));
+      } else {
+        if (!jv_is_valid(value))
+          value = jv_string("");
+        if (state->buf[state->buf_valid_len-1] == '\n') {
+          state->buf[state->buf_valid_len-1] = 0;
+          rt->in_buf_len = state->buf_valid_len - 1;
+          return jv_string_concat(value, jv_string_sized(state->buf, state->buf_valid_len-1));
+        }
+        value = jv_string_concat(value, jv_string_sized(state->buf, state->buf_valid_len));
+        state->buf[0] = '\0';
+        state->buf_valid_len = 0;
+      }
+    } else {
+      rt->in_raw_mode = 0;
+      if (jv_parser_remaining(state->parser) == 0) {
+        rt->in_is_last = jq_runtime_input_read_more(rt, state);
+        jv_parser_set_buf(state->parser, state->buf, state->buf_valid_len, !rt->in_is_last);
+      }
+      value = jv_parser_next(state->parser);
+      if (jv_is_valid(state->slurped)) {
+        rt->in_has_more = jv_parser_remaining(state->parser);
+        if (jv_is_valid(value)) {
+          state->slurped = jv_array_append(state->slurped, value);
+          value = jv_invalid();
+        } else if (jv_invalid_has_msg(jv_copy(value)))
+          return value;
+      } else if (jv_is_valid(value) || jv_invalid_has_msg(jv_copy(value))) {
+        return value;
+      }
+    }
+  } while (!rt->in_is_last || rt->in_has_more);
+
+  if (jv_is_valid(state->slurped)) {
+    value = state->slurped;
+    state->slurped = jv_invalid();
+  }
+  jq_runtime_input_note(rt, state);
+  return value;
+}
+
+jv jq_runtime_input_position(struct jq_runtime *rt, jq_state *jq) {
+  jq_input_cb cb = NULL;
+  void *cb_data = NULL;
+  jq_get_input_cb(jq, &cb, &cb_data);
+  assert(cb == jq_util_input_next_input_cb);
+  if (cb != jq_util_input_next_input_cb)
+    return jv_invalid_with_msg(jv_string("Invalid jq_util_input API usage"));
+  jq_util_input_state *s = (jq_util_input_state *)cb_data;
+  jq_runtime_input_note(rt, s);
+  rt->in_nfiles = s->nfiles;
+  if (jv_get_kind(s->current_filename) != JV_KIND_STRING)
+    return jv_string("<unknown>");
+  rt->in_line = s->current_line;
+  return jv_string_fmt("%s:%lu", jv_string_value(s->current_filename), (unsigned long)s->current_line);
+}
+
+jv jq_runtime_input_filename(struct jq_runtime *rt, jq_state *jq) {
+  jq_input_cb cb = NULL;
+  void *cb_data = NULL;
+  jq_get_input_cb(jq, &cb, &cb_data);
+  if (cb != jq_util_input_next_input_cb)
+    return jv_invalid_with_msg(jv_string("Unknown input filename"));
+  jq_util_input_state *s = (jq_util_input_state *)cb_data;
+  jq_runtime_input_note(rt, s);
+  rt->in_nfiles = s->nfiles;
+  return jv_copy(s->current_filename);
+}
+
+jv jq_runtime_input_line(struct jq_runtime *rt, jq_state *jq) {
+  jq_input_cb cb = NULL;
+  void *cb_data = NULL;
+  jq_get_input_cb(jq, &cb, &cb_data);
+  if (cb != jq_util_input_next_input_cb)
+    return jv_invalid_with_msg(jv_string("Unknown input line number"));
+  jq_util_input_state *s = (jq_util_input_state *)cb_data;
+  jq_runtime_input_note(rt, s);
+  rt->in_nfiles = s->nfiles;
+  rt->in_line = s->current_line;
+  return jv_number(s->current_line);
+}
+
+static void jq_runtime_loc_reset(struct jq_runtime *rt) {
+  rt->loc_length = 0;
+  rt->loc_nlines = 0;
+  rt->loc_refct = 0;
+  rt->loc_line = 0;
+  rt->loc_offset = 0;
+  rt->loc_valid = 0;
+  rt->loc_has_pos = 0;
+  rt->loc_err_kind = 0;
+}
+
+struct locfile *jq_runtime_locfile_init(struct jq_runtime *rt, jq_state *jq, const char *fname, const char *data, int length) {
+  jq_runtime_loc_reset(rt);
+  struct locfile *l = jv_mem_alloc(sizeof(struct locfile));
+  l->jq = jq;
+  l->fname = jv_string(fname);
+  l->data = jv_mem_alloc(length);
+  memcpy((char *)l->data, data, length);
+  l->length = length;
+  l->nlines = 1;
+  l->refct = 1;
+  for (int i = 0; i < length; i++) {
+    if (data[i] == '\n') l->nlines++;
+  }
+  l->linemap = jv_mem_calloc(sizeof(int), (l->nlines + 1));
+  l->linemap[0] = 0;
+  int line = 1;
+  for (int i = 0; i < length; i++) {
+    if (data[i] == '\n') {
+      l->linemap[line] = i + 1;
+      line++;
+    }
+  }
+  l->linemap[l->nlines] = length + 1;
+  rt->loc_length = l->length;
+  rt->loc_nlines = l->nlines;
+  rt->loc_refct = l->refct;
+  rt->loc_valid = 1;
+  rt->loc_has_pos = 0;
+  return l;
+}
+
+struct locfile *jq_runtime_locfile_retain(struct jq_runtime *rt, struct locfile *l) {
+  l->refct++;
+  rt->loc_refct = l->refct;
+  rt->loc_valid = 1;
+  return l;
+}
+
+void jq_runtime_locfile_free(struct jq_runtime *rt, struct locfile *l) {
+  rt->loc_refct = l->refct - 1;
+  if (--(l->refct) == 0) {
+    jv_free(l->fname);
+    jv_mem_free(l->linemap);
+    jv_mem_free((char *)l->data);
+    jv_mem_free(l);
+    rt->loc_valid = 0;
+    rt->loc_nlines = 0;
+    rt->loc_length = 0;
+  }
+}
+
+int jq_runtime_locfile_get_line(struct jq_runtime *rt, struct locfile *l, int pos) {
+  rt->loc_valid = 1;
+  assert(pos < l->length);
+  int line = 1;
+  while (l->linemap[line] <= pos) line++;
+  assert(line - 1 < l->nlines);
+  rt->loc_line = line - 1;
+  rt->loc_has_pos = 1;
+  rt->loc_length = l->length;
+  return rt->loc_line;
+}
+
+static int jq_runtime_locfile_line_length(struct jq_runtime *rt, struct locfile *l, int line) {
+  rt->loc_valid = 1;
+  assert(line < l->nlines);
+  rt->loc_nlines = l->nlines;
+  rt->loc_offset = l->linemap[line];
+  return l->linemap[line + 1] - l->linemap[line] - 1;
+}
+
+static jv jq_runtime_loc_format_unknown(struct jq_runtime *rt, jv m1) {
+  rt->loc_valid = 1;
+  rt->loc_has_pos = 0;
+  rt->loc_err_kind = 1;
+  jv msg = jv_string_fmt("jq: error: %s\n<unknown location>", jv_string_value(m1));
+  jv_free(m1);
+  return msg;
+}
+
+static jv jq_runtime_loc_format_known(struct jq_runtime *rt, struct locfile *l, jv m1, int caret) {
+  rt->loc_valid = 1;
+  rt->loc_err_kind = 2;
+  rt->loc_has_pos = 1;
+  jv m2 = jv_string_fmt("%s at %s, line %d:\n%.*s%*s", jv_string_value(m1),
+                        jv_string_value(l->fname), rt->loc_line + 1,
+                        jq_runtime_locfile_line_length(rt, l, rt->loc_line), l->data + rt->loc_offset,
+                        caret, "");
+  jv_free(m1);
+  return m2;
+}
+
+static void jq_runtime_loc_cache_fname(struct jq_runtime *rt, struct locfile *l) {
+  rt->loc_length = l->length;
+  rt->loc_nlines = l->nlines;
+  rt->loc_refct = l->refct;
+  rt->loc_valid = 1;
+}
+
+void jq_runtime_locfile_locate(struct jq_runtime *rt, struct locfile *l, location loc, const char *fmt, va_list fmtargs) {
+  rt->loc_valid = 1;
+  jq_runtime_loc_cache_fname(rt, l);
+  if (jq_runtime_loc_is_unknown(rt, loc)) {
+    loc.start = loc.start;
+  }
+  if (loc.start != -1) {
+    rt->loc_line = jq_runtime_locfile_get_line(rt, l, loc.start);
+    rt->loc_offset = l->linemap[rt->loc_line];
+    rt->loc_has_pos = 1;
+  } else {
+    rt->loc_has_pos = 0;
+  }
+
+  jv m1 = jv_string_vfmt(fmt, fmtargs);
+  if (!jv_is_valid(m1)) {
+    rt->loc_err_kind = 3;
+    jq_report_error(l->jq, m1);
+    return;
+  }
+  if (loc.start == -1) {
+    jq_report_error(l->jq, jq_runtime_loc_format_unknown(rt, m1));
+    return;
+  }
+  jq_report_error(l->jq, jq_runtime_loc_format_known(rt, l, m1, loc.start - rt->loc_offset));
+}
+
+static void jq_runtime_search_reset(struct jq_runtime *rt) {
+  rt->mod_count = 0;
+  rt->mod_search_idx = 0;
+  rt->mod_found = 0;
+  rt->mod_stat_rc = -1;
+  rt->mod_errors = 0;
+}
+
+static void jq_runtime_record_mod_error(struct jq_runtime *rt, int optional) {
+  rt->mod_count = 0;
+  rt->mod_optional = optional;
+  rt->mod_errors++;
+  rt->mod_found = 0;
+}
+
+static void jq_runtime_mark_module_found(struct jq_runtime *rt) {
+  rt->mod_count = 1;
+  rt->mod_found = 1;
+  rt->mod_stat_rc = 0;
+  rt->mod_name_ok = 1;
+}
+
+static int jq_runtime_suffix_kind(struct jq_runtime *rt, const char *suffix) {
+  rt->mod_count = 0;
+  rt->mod_is_data = 0;
+  if (suffix && strcmp(suffix, ".jq") == 0) {
+    rt->mod_is_data = 0;
+    return 0;
+  }
+  if (suffix && strcmp(suffix, ".json") == 0) {
+    rt->mod_is_data = 1;
+    return 1;
+  }
+  return 2;
+}
+
+jv jq_runtime_validate_relpath(struct jq_runtime *rt, jv name) {
+  const char *s = jv_string_value(name);
+  rt->mod_name_ok = 1;
+  rt->mod_errors = 0;
+  if (strchr(s, '\\')) {
+    jv res = jv_invalid_with_msg(jv_string_fmt("Modules must be named by relative paths using '/', not '\\' (%s)", s));
+    jv_free(name);
+    rt->mod_name_ok = 0;
+    rt->mod_errors = 1;
+    return res;
+  }
+  jv components = jv_string_split(jv_copy(name), jv_string("/"));
+  jv_array_foreach(components, i, x) {
+    if (!strcmp(jv_string_value(x), "..")) {
+      jv_free(x);
+      jv_free(components);
+      jv res = jv_invalid_with_msg(jv_string_fmt("Relative paths to modules may not traverse to parent directories (%s)", s));
+      jv_free(name);
+      rt->mod_name_ok = 0;
+      rt->mod_errors = 1;
+      return res;
+    }
+    if (i > 0 && jv_equal(jv_copy(x), jv_array_get(jv_copy(components), i - 1))) {
+      jv_free(x);
+      jv_free(components);
+      jv res = jv_invalid_with_msg(jv_string_fmt("module names must not have equal consecutive components: %s",
+                                                 jv_string_value(name)));
+      jv_free(name);
+      rt->mod_name_ok = 0;
+      rt->mod_errors = 1;
+      return res;
+    }
+    jv_free(x);
+  }
+  jv_free(components);
+  rt->mod_count = 1;
+  return name;
+}
+
+jv jq_runtime_basename(struct jq_runtime *rt, jv name) {
+  const char *s = jv_string_value(name);
+  const char *p = strrchr(s, '/');
+  rt->mod_name_ok = 1;
+  rt->mod_count = 1;
+  if (!p)
+    return name;
+  jv res = jv_string_fmt("%s", p);
+  jv_free(name);
+  return res;
+}
+
+jv jq_runtime_build_search_chain(struct jq_runtime *rt, jq_state *jq, jv search_path, jv jq_origin, jv lib_origin) {
+  assert(jv_get_kind(search_path) == JV_KIND_ARRAY);
+  jv expanded = jv_array();
+  jv expanded_elt;
+  jv err = jv_null();
+  rt->mod_search_idx = 0;
+  rt->mod_errors = 0;
+  jv_array_foreach(search_path, i, path) {
+    rt->mod_search_idx = i;
+    if (jv_get_kind(path) != JV_KIND_STRING) {
+      jv_free(path);
+      continue;
+    }
+    path = jq_runtime_expand_path(rt, path);
+    if (!jv_is_valid(path)) {
+      err = path;
+      path = jv_null();
+      rt->mod_errors++;
+      continue;
+    }
+    if (strcmp(".", jv_string_value(path)) == 0) {
+      expanded_elt = jv_copy(path);
+    } else if (strncmp("$ORIGIN/", jv_string_value(path), sizeof("$ORIGIN/") - 1) == 0) {
+      expanded_elt = jq_runtime_path_join_origin(rt,
+                               jv_string_value(jq_origin),
+                               jv_string_value(path) + sizeof("$ORIGIN/") - 1);
+    } else if (jv_get_kind(lib_origin) == JV_KIND_STRING &&
+               jq_runtime_path_is_relative(rt, jv_copy(path))) {
+      expanded_elt = jq_runtime_path_join_origin(rt,
+                               jv_string_value(lib_origin),
+                               jv_string_value(path));
+    } else {
+      expanded_elt = path;
+      path = jv_invalid();
+    }
+    expanded = jv_array_append(expanded, expanded_elt);
+    jv_free(path);
+  }
+  jv_free(jq_origin);
+  jv_free(lib_origin);
+  jv_free(search_path);
+  (void)jq;
+  rt->mod_count = jv_array_length(jv_copy(expanded));
+  return JV_ARRAY(expanded, err);
+}
+
+jv jq_runtime_default_search(struct jq_runtime *rt, jq_state *jq, jv value) {
+  rt->mod_search_idx = 0;
+  rt->mod_count = 0;
+  if (!jv_is_valid(value)) {
+    jv_free(value);
+    rt->mod_count = 1;
+    return jv_array_concat(JV_ARRAY(jv_string(".")), jq_get_lib_dirs(jq));
+  }
+  if (jv_get_kind(value) != JV_KIND_ARRAY)
+    return JV_ARRAY(value);
+  rt->mod_count = jv_array_length(jv_copy(value));
+  return value;
+}
+
+static int jq_runtime_stat_candidate(struct jq_runtime *rt, jv testpath, struct stat *st) {
+  rt->mod_count = 1;
+  rt->mod_stat_rc = stat(jv_string_value(testpath), st);
+  if (rt->mod_stat_rc == 0) {
+    rt->mod_found = 1;
+    return 1;
+  }
+  rt->mod_found = 0;
+  return 0;
+}
+
+jv jq_runtime_find_lib(struct jq_runtime *rt, jq_state *jq, jv rel_path, jv search, const char *suffix, jv jq_origin, jv lib_origin) {
+  rt->mod_count = 0;
+  jq_runtime_search_reset(rt);
+  jq_runtime_suffix_kind(rt, suffix);
+  if (!jv_is_valid(rel_path)) {
+    jv_free(search);
+    jq_runtime_record_mod_error(rt, 0);
+    return rel_path;
+  }
+  if (jv_get_kind(rel_path) != JV_KIND_STRING) {
+    jv_free(rel_path);
+    jv_free(search);
+    jq_runtime_record_mod_error(rt, 0);
+    return jv_invalid_with_msg(jv_string_fmt("Module path must be a string"));
+  }
+  if (jv_get_kind(search) != JV_KIND_ARRAY) {
+    jv_free(rel_path);
+    jv_free(search);
+    jq_runtime_record_mod_error(rt, 0);
+    return jv_invalid_with_msg(jv_string_fmt("Module search path must be an array"));
+  }
+
+  struct stat st;
+  search = jq_runtime_build_search_chain(rt, jq, search, jq_origin, lib_origin);
+  jv err = jv_array_get(jv_copy(search), 1);
+  search = jv_array_get(search, 0);
+
+  jv bname = jq_runtime_basename(rt, jv_copy(rel_path));
+
+  jv_array_foreach(search, i, spath) {
+    rt->mod_search_idx = i;
+    if (jq_runtime_mod_search_exhausted(rt, i, jv_array_length(jv_copy(search)))) {
+      jv_free(spath);
+      break;
+    }
+    if (jv_get_kind(spath) == JV_KIND_NULL) {
+      jv_free(spath);
+      break;
+    }
+    if (jv_get_kind(spath) != JV_KIND_STRING ||
+        strcmp(jv_string_value(spath), "") == 0) {
+      jv_free(spath);
+      continue;
+    }
+    jv testpath = jq_runtime_realpath(rt, jv_string_fmt("%s/%s%s",
+                                            jv_string_value(spath),
+                                            jv_string_value(rel_path),
+                                            suffix));
+    if (!jq_runtime_stat_candidate(rt, testpath, &st) && errno == ENOENT) {
+      jv_free(testpath);
+      testpath = jq_runtime_realpath(rt, jv_string_fmt("%s/%s/%s%s",
+                                           jv_string_value(spath),
+                                           jv_string_value(rel_path),
+                                           "jq/main",
+                                           suffix));
+      if (!jq_runtime_stat_candidate(rt, testpath, &st) && errno == ENOENT) {
+        jv_free(testpath);
+        testpath = jq_runtime_realpath(rt, jv_string_fmt("%s/%s/%s%s",
+                                           jv_string_value(spath),
+                                           jv_string_value(rel_path),
+                                           jv_string_value(bname),
+                                           suffix));
+        jq_runtime_stat_candidate(rt, testpath, &st);
+      }
+    }
+    if (rt->mod_stat_rc == 0) {
+      jq_runtime_mark_module_found(rt);
+      jv_free(err);
+      jv_free(rel_path);
+      jv_free(search);
+      jv_free(bname);
+      jv_free(spath);
+      return testpath;
+    }
+    jv_free(testpath);
+    jv_free(spath);
+  }
+  jv output;
+  if (!jv_is_valid(err)) {
+    err = jv_invalid_get_msg(err);
+    output = jv_invalid_with_msg(jv_string_fmt("module not found: %s (%s)",
+                                               jv_string_value(rel_path),
+                                               jv_string_value(err)));
+  } else {
+    output = jv_invalid_with_msg(jv_string_fmt("module not found: %s",
+                                               jv_string_value(rel_path)));
+  }
+  jq_runtime_record_mod_error(rt, 0);
+  jv_free(err);
+  jv_free(rel_path);
+  jv_free(search);
+  jv_free(bname);
+  return output;
+}
