+
+static struct jq_runtime jq_runtime_singleton;
+
+static int jq_runtime_path_is_empty(struct jq_runtime *rt, jv path);
+static int jq_runtime_file_has_error(struct jq_runtime *rt);
+static int jq_runtime_input_exhausted(struct jq_runtime *rt, jq_util_input_state *state);
+static int jq_runtime_loc_is_unknown(struct jq_runtime *rt, location loc);
+static int jq_runtime_mod_search_exhausted(struct jq_runtime *rt, int idx, int nsearch);
+
+struct jq_runtime *jq_runtime_get(void) {
+  return &jq_runtime_singleton;
+}
+
+void jq_runtime_init(struct jq_runtime *rt) {
+  if (rt->home_ready)
+    jv_free(rt->home_value);
+  if (rt->path_buf) {
+    free(rt->path_buf);
+  }
+  memset(rt, 0, sizeof(*rt));
+  rt->home_value = jv_invalid();
+  rt->path_status = 0;
+  rt->file_fd = -1;
+  rt->loc_refct = 0;
+  rt->mod_count = 0;
+}
+
+static jv jq_runtime_home_from_env(struct jq_runtime *rt) {
+  rt->path_status = 0;
+  char *home = getenv("HOME");
+  rt->home_ready = 0;
+  if (home) {
+    rt->home_value = jv_string(home);
+    rt->home_ready = 1;
+    return jv_copy(rt->home_value);
+  }
+  rt->home_value = jv_invalid();
+  return jv_invalid();
+}
+
+static jv jq_runtime_home_from_passwd(struct jq_runtime *rt) {
+  rt->path_status = 0;
+#ifndef WIN32
+  struct passwd *pwd = getpwuid(getuid());
+  rt->home_ready = 0;
+  if (pwd) {
+    rt->home_value = jv_string(pwd->pw_dir);
+    rt->home_ready = 1;
+    return jv_copy(rt->home_value);
+  }
+  rt->home_ready = -1;
+  return jv_invalid_with_msg(jv_string("Could not find home directory."));
+#else
+  char *home = getenv("USERPROFILE");
+  rt->home_ready = 0;
+  if (home) {
+    rt->home_value = jv_string(home);
+    rt->home_ready = 1;
+    return jv_copy(rt->home_value);
+  }
+  char *hd = getenv("HOMEDRIVE");
+  if (!hd) hd = "";
+  home = getenv("HOMEPATH");
+  if (!home) {
+    rt->home_ready = -1;
+    return jv_invalid_with_msg(jv_string("Could not find home directory."));
+  }
+  rt->home_value = jv_string_fmt("%s%s", hd, home);
+  rt->home_ready = 1;
+  return jv_copy(rt->home_value);
+#endif
+}
+
+jv jq_runtime_get_home(struct jq_runtime *rt) {
+  rt->path_status = 0;
+  jv env_home = jq_runtime_home_from_env(rt);
+  if (rt->home_ready == 1)
+    return env_home;
+  jv_free(env_home);
+  return jq_runtime_home_from_passwd(rt);
+}
+
