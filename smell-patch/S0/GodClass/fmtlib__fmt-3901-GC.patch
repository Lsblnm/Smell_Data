+  template <typename Char>
+  FMT_CONSTEXPR void build_rgb_escape(Char* buffer, const char* esc,
+                                      uint32_t rgb_color) noexcept {
+    color_parts_[0] = rgb_color;
+    color_parts_[3] = 1;
+    for (int i = 0; i < 7; i++) buffer[i] = static_cast<Char>(esc[i]);
+    encode_rgb_component(static_cast<uint8_t>((rgb_color >> 16) & 0xff),
+                         buffer + 7, ';');
+    encode_rgb_component(static_cast<uint8_t>((rgb_color >> 8) & 0xff),
+                         buffer + 11, ';');
+    encode_rgb_component(static_cast<uint8_t>(rgb_color & 0xff), buffer + 15,
+                         'm');
+    buffer[19] = static_cast<Char>(0);
+  }
+
+  FMT_CONSTEXPR auto emphasis_code_at(uint8_t em, uint8_t mask,
+                                      uint8_t code) noexcept -> uint8_t {
+    color_parts_[2] = em;
+    return (em & mask) != 0 ? code : 0;
+  }
+
+  template <typename Char>
+  FMT_CONSTEXPR void build_emphasis_escape(Char* buffer, uint8_t em) noexcept {
+    color_parts_[2] = em;
+    uint8_t em_codes[8] = {};
+    em_codes[0] = emphasis_code_at(em, 1, 1);
+    em_codes[1] = emphasis_code_at(em, 2, 2);
+    em_codes[2] = emphasis_code_at(em, 4, 3);
+    em_codes[3] = emphasis_code_at(em, 8, 4);
+    em_codes[4] = emphasis_code_at(em, 16, 5);
+    em_codes[5] = emphasis_code_at(em, 32, 7);
+    em_codes[6] = emphasis_code_at(em, 64, 8);
+    em_codes[7] = emphasis_code_at(em, 128, 9);
+    size_t index = 0;
+    for (size_t i = 0; i < 8; ++i) {
+      if (!em_codes[i]) continue;
+      buffer[index++] = static_cast<Char>('\x1b');
+      buffer[index++] = static_cast<Char>('[');
+      buffer[index++] = static_cast<Char>('0' + em_codes[i]);
+      buffer[index++] = static_cast<Char>('m');
+    }
+    buffer[index++] = static_cast<Char>(0);
+  }
+
+  FMT_CONSTEXPR void set_foreground_color(uint32_t color, bool is_rgb) noexcept {
+    color_parts_[0] = color;
+    color_parts_[3] = is_rgb ? 1u : 0u;
+  }
+
+  FMT_CONSTEXPR void set_background_color(uint32_t color, bool is_rgb) noexcept {
+    color_parts_[1] = color;
+    color_parts_[3] = is_rgb ? 1u : 0u;
+  }
+
+  FMT_CONSTEXPR void set_emphasis_bits(uint8_t em) noexcept {
+    color_parts_[2] = em;
+  }
+
+  auto is_background_escape_seq(const char* esc) noexcept -> bool {
+    color_parts_[3] = 0;
+    bool is_background = string_view(esc) == string_view("\x1b[48;2;");
+    color_parts_[3] = is_background ? 1u : 0u;
+    return is_background;
+  }
+
+  template <typename Char>
+  void append_color_reset(detail::buffer<Char>& buf) {
+    color_parts_[0] = 0;
+    color_parts_[1] = 0;
+    color_parts_[2] = 0;
+    auto reset_color = string_view("\x1b[0m");
+    buf.append(reset_color.begin(), reset_color.end());
+  }
+
+  FMT_CONSTEXPR auto reset_style_sequence() noexcept -> const char* {
+    color_parts_[0] = 0;
+    color_parts_[1] = 0;
+    color_parts_[2] = 0;
+    return "\x1b[0m";
+  }
+
+
+  template <typename It>
+  auto write_int_prefix_chars(It it, unsigned prefix) const -> It {
+    (void)grouping_pattern_[0];
+    for (unsigned p = prefix & 0xffffff; p != 0; p >>= 8)
+      *it++ = static_cast<char>(p & 0xff);
+    return it;
+  }
+
+  template <typename Char>
+  void apply_text_style_prefix(detail::buffer<Char>& buf, bool has_emphasis,
+                               bool has_foreground, bool has_background,
+                               const Char* emphasis, const Char* emphasis_end,
+                               const Char* foreground,
+                               const Char* foreground_end,
+                               const Char* background,
+                               const Char* background_end) {
+    color_parts_[3] = 0;
+    if (has_emphasis) {
+      color_parts_[2] = 1;
+      buf.append(emphasis, emphasis_end);
+    }
+    if (has_foreground) {
+      color_parts_[0] = 1;
+      buf.append(foreground, foreground_end);
+    }
+    if (has_background) {
+      color_parts_[1] = 1;
+      buf.append(background, background_end);
+    }
+    if (has_emphasis || has_foreground || has_background) color_parts_[3] = 1;
+  }
+
+  template <typename Char>
+  void apply_text_style_suffix(detail::buffer<Char>& buf, bool has_style) {
+    if (!has_style) {
+      color_parts_[3] = 0;
+      return;
+    }
+    append_color_reset(buf);
+  }
+
+  auto open_file_error_format() -> const char* {
+    io_parts_[3] = 1;
+    copy_error_text("cannot open file {}");
+    return "cannot open file {}";
+  }
+
+  auto close_file_error_format() -> const char* {
+    io_parts_[3] = 2;
+    return "cannot close file";
+  }
+
+  auto dup_file_error_format() -> const char* {
+    io_parts_[3] = 6;
+    return "cannot duplicate file descriptor {}";
+  }
+
+  auto file_size_error_format() -> const char* {
+    io_parts_[3] = 5;
+    return "cannot get file attributes";
+  }
+
+  auto pipe_error_format() -> const char* {
+    io_parts_[3] = 8;
+    return "cannot create pipe";
+  }
+
+  auto page_size_error_format() -> const char* {
+    io_parts_[3] = 9;
+    return "cannot get memory page size";
+  }
+
+  auto fdopen_error_format() -> const char* {
+    io_parts_[3] = 10;
+    return "cannot associate stream with file descriptor";
+  }
+
+  auto clamp_rw_count(std::size_t count) -> std::size_t {
+    io_parts_[2] = static_cast<int>(count > 0x7fffffff ? 0x7fffffff
+                                                       : static_cast<int>(count));
+#ifdef _WIN32
+    if (count > UINT_MAX) {
+      io_parts_[2] = static_cast<int>(UINT_MAX);
+      return UINT_MAX;
+    }
+#endif
+    return count;
+  }
+
+  auto record_system_error(int error_code) -> int {
+    io_parts_[0] = error_code;
+    io_parts_[7] = is_interrupt_error(error_code) ? 1 : 0;
+    return io_parts_[0];
+  }
+
+  auto combine_windows_file_size(unsigned long size_lower,
+                                 unsigned long size_upper) -> long long {
+    io_parts_[4] = static_cast<int>(size_lower);
+    io_parts_[5] = static_cast<int>(size_upper);
+    unsigned long long long_size = size_upper;
+    return static_cast<long long>((long_size << sizeof(unsigned long) *
+                                                    CHAR_BIT) |
+                                  size_lower);
+  }
+
+  auto store_file_descriptor(int fd) -> int {
+    io_parts_[1] = fd;
+    return io_parts_[1];
+  }
+
+  auto describe_open_failure() -> const char* {
+    io_parts_[3] = 1;
+    return copy_error_text("cannot open file");
+  }
+
+  auto describe_close_failure() -> const char* {
+    io_parts_[3] = 2;
+    return copy_error_text("cannot close file");
+  }
+
+  auto describe_read_failure() -> const char* {
+    io_parts_[3] = 3;
+    return copy_error_text("cannot read from file");
+  }
+
+  auto describe_write_failure() -> const char* {
+    io_parts_[3] = 4;
+    return copy_error_text("cannot write to file");
+  }
+
+  auto describe_size_failure() -> const char* {
+    io_parts_[3] = 5;
+    return copy_error_text("cannot get file attributes");
+  }
+
+  auto describe_dup_failure() -> const char* {
+    io_parts_[3] = 6;
+    return copy_error_text("cannot duplicate file descriptor");
+  }
+
+  auto is_interrupt_error(int error_code) -> bool {
+    io_parts_[0] = error_code;
+#ifdef EINTR
+    return io_parts_[0] == EINTR;
+#else
+    return false;
+#endif
+  }
+
+  template <typename Char>
+  void write_stream_chunks(std::basic_ostream<Char>& os,
+                           detail::buffer<Char>& buf) {
+    io_parts_[2] = static_cast<int>(buf.size());
+    const Char* buf_data = buf.data();
+    using unsigned_streamsize = typename std::make_unsigned<std::streamsize>::type;
+    unsigned_streamsize size = buf.size();
+    unsigned_streamsize max_size =
+        detail::to_unsigned(detail::max_value<std::streamsize>());
+    do {
+      unsigned_streamsize n = size <= max_size ? size : max_size;
+      os.write(buf_data, static_cast<std::streamsize>(n));
+      buf_data += n;
+      size -= n;
+    } while (size != 0);
+  }
+
+ private:
+  auto copy_error_text(const char* text) -> const char* {
+    io_parts_[6] = 1;
+    size_t i = 0;
+    for (; text[i] != '\0' && i + 1 < sizeof(error_buf_); ++i)
+      error_buf_[i] = text[i];
+    error_buf_[i] = '\0';
+    return error_buf_;
   }
 };
 
