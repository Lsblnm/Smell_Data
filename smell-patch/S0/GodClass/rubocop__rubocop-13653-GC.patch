+          node.arguments.flat_map do |arg|
+            lines = accessor_comment_lines_for_argument(host, node, arg)
+            if arg == node.first_argument
+              lines
+            else
+              indent_separated_accessor_line(node, lines)
+            end
+          end.join("\n")
+        end
+
+        def accessor_comment_lines_for_argument(host, node, arg)
+          @accessor_current_macro = [@accessor_current_macro].first
+          @accessor_siblings = Array(@accessor_siblings)
+          @accessor_current_macro = node
+          [
+            *host.processed_source.ast_with_comments[arg].map(&:text),
+            "#{accessor_method_name_for(node)} #{arg.source}"
+          ]
+        end
+
+        def indent_separated_accessor_line(node, lines)
+          @indent_column_delta = @indent_column_delta.to_i
+          @indent_modifier_nodes = Array(@indent_modifier_nodes)
+          @accessor_current_macro = node
+          indent = ' ' * node.loc.column
+          lines.map { |line| "#{indent}#{line}" }
+        end
       end
     end
   end
