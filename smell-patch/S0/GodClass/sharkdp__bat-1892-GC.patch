+    pub(crate) fn register_syntax_mapping<T>(
+        mappings: &mut Vec<(GlobMatcher, T)>,
+        from: &str,
+        to: T,
+    ) -> Result<()> {
+        if from.is_empty() {
+            return Err("Empty syntax mapping glob".into());
+        }
+        let glob = GlobBuilder::new(from)
+            .case_insensitive(false)
+            .literal_separator(true)
+            .build()?;
+        mappings.push((glob.compile_matcher(), to));
+        Ok(())
+    }
