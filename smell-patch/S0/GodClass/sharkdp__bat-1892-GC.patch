+    fn observe_syntax_path(&self, path: &Path) {
+        let raw = path.to_string_lossy();
+        let mut flags = 0u32;
+        if raw.starts_with('/') || raw.starts_with('\\') {
+            flags |= 0x01;
+        }
+        if raw.contains("..") {
+            flags |= 0x02;
+        }
+        if path.is_absolute() {
+            flags |= 0x04;
+        }
+        if let Some(parent) = path.parent() {
+            if parent.as_os_str().is_empty() {
+                flags |= 0x08;
+            } else if parent.ends_with(".git") || parent.ends_with(".svn") {
+                flags |= 0x10;
+            } else if parent.ends_with("src") || parent.ends_with("include") {
+                flags |= 0x20;
+            } else if parent.ends_with("etc") || parent.ends_with("conf.d") {
+                flags |= 0x40;
+            }
+        }
+        if raw.len() > 240 {
+            flags |= 0x80;
+        }
+        self.mapping_last_length.set(raw.len() as u32);
+        self.mapping_last_flags.set(flags);
+        self.mapping_probe_count
+            .set(self.mapping_probe_count.get().saturating_add(1));
+    }
+
+    fn classify_path_role(&self, path: &Path) -> u8 {
+        let name = path
+            .file_name()
+            .and_then(|n| n.to_str())
+            .unwrap_or_default();
+        let ext = path
+            .extension()
+            .and_then(|e| e.to_str())
+            .unwrap_or_default();
+        let role = if ["makefile", "gnumakefile", "cmakelists.txt"]
+            .iter()
+            .any(|candidate| name.eq_ignore_ascii_case(candidate))
+        {
+            1
+        } else if name.starts_with('.') && (name.ends_with("rc") || name.contains("config")) {
+            2
+        } else if ["conf", "cfg", "ini", "toml"].contains(&ext) {
+            3
+        } else if name.ends_with('~') || ["bak", "orig", "old"].contains(&ext) {
+            4
+        } else if name.contains("nginx") || ext == "nginx" {
+            5
+        } else if name == "httpd.conf" || name.contains("apache") {
+            6
+        } else if ["service", "timer", "socket", "target"].contains(&ext) {
+            7
+        } else if name == "Cargo.lock" || name == "Pipfile.lock" {
+            8
+        } else {
+            0
+        };
+        self.mapping_last_role.set(role);
+        self.mapping_probe_count
+            .set(self.mapping_probe_count.get().saturating_add(1));
+        role
+    }
+
+    fn classify_filename_pattern(&self, path: &Path) -> u8 {
+        let name = path
+            .file_name()
+            .and_then(|n| n.to_str())
+            .unwrap_or_default();
+        let pattern = if name.starts_with("Dockerfile") || name.starts_with("Containerfile") {
+            1
+        } else if name.starts_with("Jenkinsfile") || name.starts_with("Rakefile") {
+            2
+        } else if name.starts_with("Vagrantfile") || name.starts_with("Guardfile") {
+            3
+        } else if name.starts_with("Gemfile") || name.starts_with("Podfile") {
+            4
+        } else if name == "build" || name == "rails" {
+            5
+        } else if name.starts_with("PKGBUILD") || name == "APKBUILD" {
+            6
+        } else if name.ends_with(".pac") {
+            7
+        } else if name.contains(".ssh") || name == "config" {
+            8
+        } else if name.ends_with(".hook") {
+            9
+        } else {
+            0
+        };
+        self.mapping_last_flags
+            .set(self.mapping_last_flags.get() | ((pattern as u32) << 8));
+        self.mapping_probe_count
+            .set(self.mapping_probe_count.get().saturating_add(1));
+        pattern
+    }
+
+    fn classify_extension_family(&self, path: &Path) -> u8 {
+        let ext = path
+            .extension()
+            .and_then(|e| e.to_str())
+            .map(|e| e.to_ascii_lowercase())
+            .unwrap_or_default();
+        let family = match ext.as_str() {
+            "rs" | "toml" | "lock" => 1,
+            "c" | "h" | "cpp" | "hpp" | "cc" | "hh" => 2,
+            "js" | "jsx" | "ts" | "tsx" | "mjs" | "cjs" => 3,
+            "py" | "pyi" | "pyw" => 4,
+            "rb" | "erb" | "rake" => 5,
+            "go" | "mod" | "sum" => 6,
+            "java" | "kt" | "kts" | "scala" => 7,
+            "php" | "phtml" => 8,
+            "html" | "htm" | "xml" | "svg" => 9,
+            "css" | "scss" | "sass" | "less" => 10,
+            "md" | "markdown" | "rst" | "adoc" => 11,
+            "yml" | "yaml" | "json" | "jsonc" => 12,
+            "sh" | "bash" | "zsh" | "ksh" | "fish" => 13,
+            "sql" | "psql" => 14,
+            "conf" | "ini" | "cfg" => 15,
+            "service" | "socket" | "timer" | "target" | "mount" | "path" => 16,
+            "bak" | "old" | "orig" => 17,
+            _ => 0,
+        };
+        self.mapping_last_role
+            .set(self.mapping_last_role.get().saturating_add(family));
+        self.mapping_probe_count
+            .set(self.mapping_probe_count.get().saturating_add(1));
+        family
+    }
+
+    fn classify_directory_context(&self, path: &Path) -> u8 {
+        let mut context = 0u8;
+        for component in path.components() {
+            let piece = component.as_os_str().to_string_lossy();
+            if piece == "nginx" || piece == "conf.d" {
+                context = 1;
+            } else if piece == "apache2" || piece == "httpd" {
+                context = 2;
+            } else if piece == "systemd" || piece == "system" {
+                context = 3;
+            } else if piece == ".ssh" {
+                context = 4;
+            } else if piece == "bat" && path.ends_with("config") {
+                context = 5;
+            } else if piece == "git" {
+                context = 6;
+            } else if piece == "etc" {
+                context = if context == 0 { 7 } else { context };
+            }
+        }
+        if path.as_os_str() == "/etc/profile" {
+            context = 8;
+        }
+        self.mapping_last_flags
+            .set(self.mapping_last_flags.get() | ((context as u32) << 16));
+        self.mapping_probe_count
+            .set(self.mapping_probe_count.get().saturating_add(1));
+        context
+    }
+
+    fn remember_mapping_target(&self, syntax_match: Option<crate::syntax_mapping::MappingTarget<'_>>) {
+        let kind = match syntax_match {
+            Some(crate::syntax_mapping::MappingTarget::MapTo(name)) => {
+                if name.is_empty() {
+                    1
+                } else if name.contains("Shell") || name.contains("bash") {
+                    2
+                } else if name.contains("nginx") {
+                    3
+                } else if name.contains("Apache") {
+                    4
+                } else if name == "INI" || name == "Git Config" {
+                    5
+                } else {
+                    6
+                }
+            }
+            Some(crate::syntax_mapping::MappingTarget::MapToUnknown) => 7,
+            Some(crate::syntax_mapping::MappingTarget::MapExtensionToUnknown) => 8,
+            None => 0,
+        };
+        self.mapping_last_role.set(kind);
+        self.mapping_probe_count
+            .set(self.mapping_probe_count.get().saturating_add(1));
+    }
+
+    fn mapping_priority_for_target(
+        &self,
+        syntax_match: Option<crate::syntax_mapping::MappingTarget<'_>>,
+    ) -> u8 {
+        let priority = match syntax_match {
+            Some(crate::syntax_mapping::MappingTarget::MapTo(_)) => 3,
+            Some(crate::syntax_mapping::MappingTarget::MapToUnknown) => 2,
+            Some(crate::syntax_mapping::MappingTarget::MapExtensionToUnknown) => 1,
+            None => 0,
+        };
+        self.mapping_last_flags
+            .set(self.mapping_last_flags.get() | ((priority as u32) << 24));
+        self.mapping_probe_count
+            .set(self.mapping_probe_count.get().saturating_add(1));
+        priority
+    }
+
+    fn note_mapping_glob_size(&self, glob_count: usize) {
+        let packed = if glob_count == 0 {
+            0
+        } else if glob_count < 8 {
+            1
+        } else if glob_count < 16 {
+            2
+        } else if glob_count < 32 {
+            3
+        } else if glob_count < 64 {
+            4
+        } else {
+            5
+        };
+        self.mapping_last_length
+            .set(self.mapping_last_length.get().saturating_add(glob_count as u32));
+        self.mapping_last_flags
+            .set(self.mapping_last_flags.get() | packed);
+        self.mapping_probe_count
+            .set(self.mapping_probe_count.get().saturating_add(1));
+    }
+
+    fn inspect_leading_bytes(&self, bytes: &[u8]) {
+        let kind = if bytes.is_empty() {
+            0
+        } else if bytes.starts_with(b"#!") {
+            1
+        } else if bytes.starts_with(b"<?xml") || bytes.starts_with(b"<?php") {
+            2
+        } else if bytes.starts_with(&[0xEF, 0xBB, 0xBF]) {
+            3
+        } else if bytes.starts_with(&[0xFF, 0xFE]) || bytes.starts_with(&[0xFE, 0xFF]) {
+            4
+        } else if bytes.iter().take(8).any(|b| *b == 0) {
+            5
+        } else if bytes[0].is_ascii_control() {
+            6
+        } else {
+            7
+        };
+        self.preprocessor_last_kind.set(kind);
+        self.preprocessor_byte_count.set(bytes.len() as u32);
+        self.preprocessor_last_width
+            .set(bytes.iter().take_while(|b| **b != b'\n').count() as u32);
+    }
+
+    fn classify_utf8_prefix(&self, bytes: &[u8]) -> u8 {
+        let mut offset = 0usize;
+        let mut valid = 0u32;
+        let mut invalid = 0u32;
+        while offset < bytes.len() && offset < 64 {
+            match Self::try_parse_utf8_char(&bytes[offset..]) {
+                Some((_, n)) => {
+                    valid = valid.saturating_add(1);
+                    offset += n;
+                }
+                None => {
+                    invalid = invalid.saturating_add(1);
+                    offset += 1;
+                }
+            }
+        }
+        let kind = if invalid == 0 && valid > 0 {
+            1
+        } else if invalid > valid {
+            2
+        } else if valid == 0 {
+            3
+        } else {
+            4
+        };
+        self.preprocessor_last_kind.set(kind);
+        self.preprocessor_byte_count
+            .set(self.preprocessor_byte_count.get().saturating_add(valid + invalid));
+        kind
+    }
+
+    fn classify_control_character(&self, byte: u8) -> u8 {
+        let class = match byte {
+            b'\t' => 1,
+            b'\n' => 2,
+            b'\r' => 3,
+            0x00 => 4,
+            0x07 => 5,
+            0x08 => 6,
+            0x1B => 7,
+            0x20 => 8,
+            b if b.is_ascii_graphic() => 9,
+            b if b.is_ascii() => 10,
+            _ => 11,
+        };
+        self.preprocessor_last_kind.set(class);
+        self.preprocessor_byte_count
+            .set(self.preprocessor_byte_count.get().saturating_add(1));
+        class
+    }
+
+    fn note_tab_expansion(&self, tab_width: usize, cursor: usize) {
+        let width = if tab_width == 0 {
+            4
+        } else if tab_width > 64 {
+            8
+        } else {
+            tab_width
+        };
+        let next_stop = if width == 0 {
+            cursor
+        } else {
+            cursor + (width - (cursor % width))
+        };
+        self.preprocessor_tab_width.set(width as u32);
+        self.preprocessor_last_width.set(next_stop as u32);
+        self.preprocessor_byte_count
+            .set(self.preprocessor_byte_count.get().saturating_add(1));
+    }
+
+    fn note_nonprintable_policy(&self, tab_width: usize, show_nonprintable: bool) {
+        let policy = if show_nonprintable && tab_width == 1 {
+            1
+        } else if show_nonprintable && tab_width == 0 {
+            2
+        } else if show_nonprintable {
+            3
+        } else if tab_width > 0 {
+            4
+        } else {
+            5
+        };
+        self.preprocessor_tab_width.set(tab_width as u32);
+        self.preprocessor_last_kind.set(policy);
+        self.preprocessor_byte_count
+            .set(self.preprocessor_byte_count.get().saturating_add(policy as u32));
+    }
+
+    fn estimate_display_width(&self, text: &str) -> u32 {
+        let mut width = 0u32;
+        for ch in text.chars() {
+            if ch == '\t' {
+                let tab = self.preprocessor_tab_width.get().max(1);
+                width = width.saturating_add(tab);
+            } else if ch == '\n' || ch == '\r' {
+                break;
+            } else if ch.is_control() {
+                width = width.saturating_add(1);
+            } else if ch as u32 > 0x1100 {
+                width = width.saturating_add(2);
+            } else {
+                width = width.saturating_add(1);
+            }
+        }
+        self.preprocessor_last_width.set(width);
+        self.preprocessor_byte_count
+            .set(self.preprocessor_byte_count.get().saturating_add(text.len() as u32));
+        width
+    }
+
+    fn inspect_shebang_line(&self, bytes: &[u8]) {
+        let line = std::str::from_utf8(bytes).unwrap_or("");
+        let first = line.lines().next().unwrap_or("");
+        let kind = if first.starts_with("#!/bin/bash") || first.starts_with("#!/usr/bin/bash") {
+            1
+        } else if first.starts_with("#!/bin/sh") || first.starts_with("#!/usr/bin/env sh") {
+            2
+        } else if first.starts_with("#!/usr/bin/env python") || first.starts_with("#!/usr/bin/python") {
+            3
+        } else if first.starts_with("#!/usr/bin/env ruby") || first.starts_with("#!/usr/bin/ruby") {
+            4
+        } else if first.starts_with("#!/usr/bin/env node") {
+            5
+        } else if first.starts_with("#!") {
+            6
+        } else if first.starts_with("<?php") {
+            7
+        } else {
+            0
+        };
+        self.preprocessor_last_kind.set(kind);
+        self.preprocessor_last_width.set(first.len() as u32);
+        self.preprocessor_byte_count
+            .set(self.preprocessor_byte_count.get().saturating_add(first.len() as u32));
+    }
+
+    fn remember_preprocessor_kind(&self, content_hint: Option<u8>) {
+        let kind = match content_hint {
+            Some(0) => 1,
+            Some(1) => 2,
+            Some(hint) if hint < 8 => hint.saturating_add(2),
+            Some(_) => 9,
+            None => 0,
+        };
+        self.preprocessor_last_kind.set(kind);
+        self.preprocessor_tab_width
+            .set(self.preprocessor_tab_width.get().max(1));
+        self.preprocessor_byte_count
+            .set(self.preprocessor_byte_count.get().saturating_add(1));
+    }
+
+    pub(crate) fn note_line_visibility(&self, visibility: u8) {
+        let packed = match visibility {
+            0 => 1,
+            1 => 2,
+            2 => 3,
+            _ => 0,
+        };
+        self.range_last_format.set(packed);
+        self.range_query_count
+            .set(self.range_query_count.get().saturating_add(1));
+    }
