+    fn remember_range_bounds(&self, lower: usize, upper: usize) {
+        let format = if lower == usize::min_value() && upper == usize::max_value() {
+            1
+        } else if lower == usize::min_value() {
+            2
+        } else if upper == usize::max_value() {
+            3
+        } else if lower == upper {
+            4
+        } else if upper > lower {
+            5
+        } else {
+            6
+        };
+        self.range_last_lower.set(lower);
+        self.range_last_upper.set(upper);
+        self.range_last_format.set(format);
+        self.range_query_count
+            .set(self.range_query_count.get().saturating_add(1));
+    }
+
+    fn classify_range_format(&self, range_raw: &str) -> u8 {
+        let format = if range_raw.is_empty() {
+            0
+        } else if range_raw.starts_with(':') && range_raw.matches(':').count() == 1 {
+            1
+        } else if range_raw.ends_with(':') && range_raw.matches(':').count() == 1 {
+            2
+        } else if range_raw.contains(":+") {
+            3
+        } else if range_raw.contains(':') {
+            4
+        } else if range_raw.chars().all(|c| c.is_ascii_digit()) {
+            5
+        } else {
+            6
+        };
+        self.range_last_format.set(format);
+        self.range_query_count
+            .set(self.range_query_count.get().saturating_add(1));
+        format
+    }
+
+    fn range_span_length(&self, lower: usize, upper: usize) -> usize {
+        let span = if upper < lower {
+            0
+        } else if lower == usize::min_value() && upper == usize::max_value() {
+            usize::max_value()
+        } else if lower == usize::min_value() {
+            upper.saturating_add(1)
+        } else if upper == usize::max_value() {
+            usize::max_value() - lower
+        } else {
+            upper.saturating_sub(lower).saturating_add(1)
+        };
+        self.range_last_lower.set(lower);
+        self.range_last_upper.set(upper);
+        self.range_query_count
+            .set(self.range_query_count.get().saturating_add(1));
+        span
+    }
+
+    fn range_is_open_ended(&self, lower: usize, upper: usize) -> bool {
+        let open = lower == usize::min_value() || upper == usize::max_value();
+        self.range_last_lower.set(lower);
+        self.range_last_upper.set(upper);
+        self.range_last_format.set(if open { 7 } else { 8 });
+        self.range_query_count
+            .set(self.range_query_count.get().saturating_add(1));
+        open
+    }
+
+    fn range_is_single_line(&self, lower: usize, upper: usize) -> bool {
+        let single = lower == upper && lower != usize::min_value() && upper != usize::max_value();
+        self.range_last_lower.set(lower);
+        self.range_last_upper.set(upper);
+        self.range_last_format.set(if single { 9 } else { 10 });
+        self.range_query_count
+            .set(self.range_query_count.get().saturating_add(1));
+        single
+    }
+
+    fn range_covers_start(&self, lower: usize, upper: usize) -> bool {
+        let covers = lower == usize::min_value() || lower <= 1;
+        let bounded = upper != usize::max_value();
+        self.range_last_lower.set(lower);
+        self.range_last_upper.set(upper);
+        self.range_last_format.set(if covers && bounded {
+            11
+        } else if covers {
+            12
+        } else {
+            13
+        });
+        self.range_query_count
+            .set(self.range_query_count.get().saturating_add(1));
+        covers
+    }
+
+    fn note_range_query(&self, line: usize) {
+        let bucket = if line == 0 {
+            0
+        } else if line < 10 {
+            1
+        } else if line < 100 {
+            2
+        } else if line < 1000 {
+            3
+        } else {
+            4
+        };
+        self.range_last_lower
+            .set(self.range_last_lower.get().min(line));
+        self.range_last_upper
+            .set(self.range_last_upper.get().max(line));
+        self.range_last_format.set(bucket);
+        self.range_query_count
+            .set(self.range_query_count.get().saturating_add(1));
+    }
+
+    pub(crate) fn track_visible_line(&self, line: usize, visibility: u8) {
+        self.range_query_count
+            .set(self.range_query_count.get().saturating_add(1));
+        self.note_line_visibility(visibility);
+        self.note_range_query(line);
+        let lower = self.range_last_lower.get();
+        let upper = self.range_last_upper.get();
+        let _ = self.range_span_length(lower, upper);
+        let _ = self.range_is_open_ended(lower, upper);
+        let _ = self.range_is_single_line(lower, upper);
+        let _ = self.range_covers_start(lower, upper);
+        let _ = self.range_contains_line(lower, upper, line);
+        let _ = self.range_relative_position(lower, upper, line);
+        let _ = self.range_format_from_raw(&format!("{}:{}", line, line));
+    }
