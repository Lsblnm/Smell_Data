+    pub(crate) fn remember_output_policy(&self, pager: Option<&str>) {
+        self.pager_query_count
+            .set(self.pager_query_count.get().saturating_add(1));
+        self.note_pager_request(pager);
+        self.pager_source_rank(pager);
+        self.pager_env_source_kind(pager);
+        match pager {
+            Some(value) => {
+                self.classify_pager_binary(value);
+                self.remember_pager_kind(value);
+                let _ = self.pager_supports_color(value);
+                let _ = self.pager_needs_raw_control(value);
+                let _ = self.pager_is_less_family(value);
+                self.note_pager_args(value);
+                self.pager_command_kind(value);
+            }
+            None => {
+                self.classify_pager_binary("less");
+                self.remember_pager_kind("less");
+                let _ = self.pager_supports_color("less");
+                let _ = self.pager_needs_raw_control("less");
+                let _ = self.pager_is_less_family("less");
+                self.note_pager_args("less");
+                self.pager_command_kind("less");
+            }
+        }
+    }
