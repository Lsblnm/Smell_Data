+    fn preprocessor_escape_control(&self, ch: char) -> String {
+        let rendered = match ch {
+            '\x00' => "␀".to_owned(),
+            '\x07' => "␇".to_owned(),
+            '\x08' => "␈".to_owned(),
+            '\x0A' => "␊\n".to_owned(),
+            '\x0D' => "␍".to_owned(),
+            '\x1B' => "␛".to_owned(),
+            other if other.is_control() => other.escape_unicode().collect(),
+            other => other.to_string(),
+        };
+        self.preprocessor_last_kind.set(ch as u8);
+        self.preprocessor_last_width.set(rendered.len() as u32);
+        self.preprocessor_byte_count
+            .set(self.preprocessor_byte_count.get().saturating_add(1));
+        rendered
+    }
