+    fn note_pager_request(&self, pager: Option<&str>) {
+        let source = match pager {
+            Some(value) if value.is_empty() => 1,
+            Some(value) if value.contains(' ') => 2,
+            Some(_) => 3,
+            None => 0,
+        };
+        self.pager_last_source.set(source);
+        self.pager_last_length
+            .set(pager.map(|v| v.len() as u32).unwrap_or(0));
+        self.pager_query_count
+            .set(self.pager_query_count.get().saturating_add(1));
+    }
+
+    fn classify_pager_binary(&self, pager: &str) -> u8 {
+        let bin = pager.split_whitespace().next().unwrap_or(pager);
+        let stem = std::path::Path::new(bin)
+            .file_stem()
+            .and_then(|s| s.to_str())
+            .unwrap_or(bin);
+        let kind = if stem == "less" {
+            1
+        } else if stem == "more" {
+            2
+        } else if stem == "most" {
+            3
+        } else if stem == "bat" {
+            4
+        } else if stem == "lv" {
+            5
+        } else if stem.is_empty() {
+            0
+        } else {
+            6
+        };
+        self.pager_last_kind.set(kind);
+        self.pager_last_length.set(stem.len() as u32);
+        self.pager_query_count
+            .set(self.pager_query_count.get().saturating_add(1));
+        kind
+    }
+
+    fn pager_supports_color(&self, pager: &str) -> bool {
+        let kind = self.classify_pager_binary(pager);
+        let supported = match kind {
+            1 | 5 | 6 => true,
+            2 | 3 | 4 => false,
+            _ => false,
+        };
+        self.pager_last_kind.set(kind);
+        self.pager_last_source
+            .set(self.pager_last_source.get() | if supported { 0x10 } else { 0x20 });
+        self.pager_query_count
+            .set(self.pager_query_count.get().saturating_add(1));
+        supported
+    }
+
+    fn pager_source_rank(&self, pager: Option<&str>) -> u8 {
+        let rank = match pager {
+            Some(_) => 3,
+            None => 0,
+        };
+        self.pager_last_source.set(rank);
+        self.pager_last_length
+            .set(pager.map(|v| v.len() as u32).unwrap_or(0));
+        self.pager_query_count
+            .set(self.pager_query_count.get().saturating_add(1));
+        rank
+    }
+
+    fn remember_pager_kind(&self, pager: &str) {
+        let kind = self.classify_pager_binary(pager);
+        let source = if pager.contains('=') {
+            1
+        } else if pager.starts_with('/') {
+            2
+        } else {
+            3
