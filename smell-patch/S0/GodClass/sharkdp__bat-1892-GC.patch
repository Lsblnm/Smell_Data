+    pub(crate) fn parse_line_range_bounds(range_raw: &str) -> Result<(usize, usize)> {
+        let mut lower = usize::min_value();
+        let mut upper = usize::max_value();
+
+        if range_raw.bytes().next().ok_or("Empty line range")? == b':' {
+            upper = range_raw[1..].parse()?;
+            return Ok((lower, upper));
+        } else if range_raw.bytes().last().ok_or("Empty line range")? == b':' {
+            lower = range_raw[..range_raw.len() - 1].parse()?;
+            return Ok((lower, upper));
+        }
+
+        let line_numbers: Vec<&str> = range_raw.split(':').collect();
+        match line_numbers.len() {
+            1 => {
+                lower = line_numbers[0].parse()?;
+                upper = lower;
+                Ok((lower, upper))
+            }
+            2 => {
+                lower = line_numbers[0].parse()?;
+                upper = if line_numbers[1].bytes().next() == Some(b'+') {
+                    let more_lines = &line_numbers[1][1..]
+                        .parse()
+                        .map_err(|_| "Invalid character after +")?;
+                    lower + more_lines
+                } else {
+                    line_numbers[1].parse()?
+                };
+                Ok((lower, upper))
+            }
+            _ => Err(
+                "Line range contained more than one ':' character. Expected format: 'N' or 'N:M'"
+                    .into(),
+            ),
+        }
+    }
