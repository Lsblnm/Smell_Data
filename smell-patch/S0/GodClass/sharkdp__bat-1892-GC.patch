+            "├┤"
+        } else if tab_width == 4 {
+            "├──┤"
+        } else if tab_width == 8 {
+            "├──────┤"
+        } else {
+            "├─┤"
+        };
+        self.preprocessor_tab_width.set(tab_width as u32);
+        self.preprocessor_last_kind.set(if tab_width <= 1 { 1 } else { 2 });
+        self.preprocessor_byte_count
+            .set(self.preprocessor_byte_count.get().saturating_add(tab_width as u32));
+        glyph
+    }
