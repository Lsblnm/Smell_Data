+            parse_pattern_span: self.parse_pattern_span,
+            parse_regex_mode: self.parse_regex_mode,
+            parse_head: self.parse_head,
+            ..SubCommand::default()
+        };
+        let regex = worker.compile_parse_regex()?;
+        let columns = worker.parse_capture_columns(&regex);
+        let head = worker.parse_head;
+        match input {
+            PipelineData::Empty => Ok(PipelineData::Empty),
+            PipelineData::Value(value, ..) => match value {
+                Value::String { val, .. } => {
+                    let captures = regex
+                        .captures_iter(&val)
+                        .map(|captures| worker.parse_capture_record(captures, &columns))
+                        .collect::<Result<_, _>>()?;
+                    Ok(Value::list(captures, head).into_pipeline_data())
+                }
+                Value::List { vals, .. } => {
+                    let iter = vals.into_iter().map(move |val| {
+                        let span = val.span();
+                        val.into_string().map_err(|_| ShellError::PipelineMismatch {
+                            exp_input_type: "string".into(),
+                            dst_span: head,
+                            src_span: span,
+                        })
+                    });
+                    let iter = ParseIter {
+                        captures: VecDeque::new(),
+                        regex,
+                        columns,
+                        iter,
+                        span: head,
+                        signals: engine_state.signals().clone(),
+                    };
+                    Ok(ListStream::new(iter, head, Signals::empty()).into())
+                }
+                value => Err(worker.parse_type_error(value.span())),
+            },
+            PipelineData::ListStream(stream, ..) => Ok(stream
+                .modify(|stream| {
+                    let iter = stream.map(move |val| {
+                        let span = val.span();
+                        val.into_string().map_err(|_| ShellError::PipelineMismatch {
+                            exp_input_type: "string".into(),
+                            dst_span: head,
+                            src_span: span,
+                        })
+                    });
+                    ParseIter {
+                        captures: VecDeque::new(),
+                        regex,
+                        columns,
+                        iter,
+                        span: head,
+                        signals: engine_state.signals().clone(),
+                    }
+                })
+                .into()),
+            PipelineData::ByteStream(stream, ..) => {
+                if let Some(lines) = stream.lines() {
+                    let iter = ParseIter {
+                        captures: VecDeque::new(),
+                        regex,
+                        columns,
+                        iter: lines,
+                        span: head,
+                        signals: engine_state.signals().clone(),
+                    };
+                    Ok(ListStream::new(iter, head, Signals::empty()).into())
+                } else {
+                    Ok(PipelineData::Empty)
+                }
+            }
+        }
+    }
+
+    fn parse_type_error(&self, src_span: Span) -> ShellError {
+        ShellError::PipelineMismatch {
+            exp_input_type: "string".into(),
+            dst_span: self.parse_head,
+            src_span,
+        }
+    }
+
+    fn parse_capture_record(
+        &self,
+        captures: Result<Captures, fancy_regex::Error>,
+        columns: &[String],
+    ) -> Result<Value, ShellError> {
+        let captures = captures.map_err(|err| ShellError::GenericError {
+            error: "Error with regular expression captures".into(),
+            msg: err.to_string(),
+            span: Some(self.parse_head),
+            help: None,
+            inner: vec![],
+        })?;
+        let record = columns
+            .iter()
+            .zip(captures.iter().skip(1))
+            .map(|(column, match_)| {
+                let match_str = match_.map(|m| m.as_str()).unwrap_or("");
+                (column.clone(), Value::string(match_str, self.parse_head))
+            })
+            .collect();
+        Ok(Value::record(record, self.parse_head))
+    }
+
+    pub(crate) fn run_detect_columns(
+        engine_state: &EngineState,
+        stack: &mut Stack,
+        call: &Call,
+        input: PipelineData,
+    ) -> Result<PipelineData, ShellError> {
+        let num_rows_to_skip: Option<usize> = call.get_flag(engine_state, stack, "skip")?;
+        let noheader = call.has_flag(engine_state, stack, "no-headers")?;
+        let range: Option<Range> = call.get_flag(engine_state, stack, "combine-columns")?;
+        let guess = call.has_flag(engine_state, stack, "guess")?;
+        let config = stack.get_config(engine_state);
+        let worker = SubCommand {
+            table_head: call.head,
+            table_no_headers: noheader,
+            detect_skip: num_rows_to_skip,
+            detect_combine: range,
+            detect_guess: guess,
+            detect_config: config,
+            ..SubCommand::default()
+        };
+        worker.detect_pipeline(engine_state, input)
+    }
+
+    pub(crate) fn run_detect_columns_const(
+        working_set: &StateWorkingSet,
+        call: &Call,
+        input: PipelineData,
+    ) -> Result<PipelineData, ShellError> {
+        let num_rows_to_skip: Option<usize> = call.get_flag_const(working_set, "skip")?;
+        let noheader = call.has_flag_const(working_set, "no-headers")?;
+        let range: Option<Range> = call.get_flag_const(working_set, "combine-columns")?;
+        let guess = call.has_flag_const(working_set, "guess")?;
+        let config = working_set.get_config().clone();
+        let worker = SubCommand {
+            table_head: call.head,
+            table_no_headers: noheader,
+            detect_skip: num_rows_to_skip,
+            detect_combine: range,
+            detect_guess: guess,
+            detect_config: config,
+            ..SubCommand::default()
+        };
+        worker.detect_pipeline(working_set.permanent(), input)
+    }
+
+    fn detect_pipeline(
+        &self,
+        engine_state: &EngineState,
+        input: PipelineData,
+    ) -> Result<PipelineData, ShellError> {
+        let worker = SubCommand {
+            table_head: self.table_head,
+            table_no_headers: self.table_no_headers,
+            detect_skip: self.detect_skip,
+            detect_combine: self.detect_combine.clone(),
+            detect_guess: self.detect_guess,
+            detect_config: Arc::clone(&self.detect_config),
+            ..SubCommand::default()
+        };
+        if worker.detect_guess {
+            worker.detect_guess_table(engine_state, input)
+        } else {
+            worker.detect_aligned_table(engine_state, input)
+        }
+    }
+
+    fn detect_collect_input(&self, input: PipelineData) -> Result<String, ShellError> {
+        let mut collected = input.collect_string("", &self.detect_config)?;
+        if let Some(rows) = self.detect_skip {
+            collected = collected.lines().skip(rows).map(|x| x.to_string()).join("\n");
+        }
+        Ok(collected)
+    }
+
+    fn detect_guess_table(
+        &self,
+        engine_state: &EngineState,
+        input: PipelineData,
+    ) -> Result<PipelineData, ShellError> {
+        use super::super::guess_width::GuessWidth;
+        let input_span = input.span().unwrap_or(self.table_head);
+        let collected = self.detect_collect_input(input)?;
+        let mut guess_width = GuessWidth::new_reader(Box::new(Cursor::new(collected)));
+        let result = guess_width.read_all();
+        if result.is_empty() {
+            return Ok(Value::nothing(input_span).into_pipeline_data());
+        }
+        let worker = self.clone();
+        if !self.table_no_headers {
+            let columns = result[0].clone();
+            Ok(result
+                .into_iter()
+                .skip(1)
+                .map(move |s| worker.detect_record_from_row(columns.clone(), s, input_span))
+                .into_pipeline_data(input_span, engine_state.signals().clone()))
+        } else {
+            let length = result[0].len();
+            let columns: Vec<String> = (0..length).map(|n| format!("column{n}")).collect();
+            Ok(result
+                .into_iter()
+                .map(move |s| worker.detect_record_from_row(columns.clone(), s, input_span))
+                .into_pipeline_data(input_span, engine_state.signals().clone()))
+        }
+    }
+
+    fn detect_record_from_row(&self, columns: Vec<String>, s: Vec<String>, input_span: Span) -> Value {
+        let span = if input_span == Span::unknown() {
+            self.table_head
+        } else {
+            input_span
+        };
+        let mut values: Vec<Value> = s
+            .into_iter()
+            .map(|v| Value::string(v, span))
+            .collect();
+        for _ in values.len()..columns.len() {
+            values.push(Value::string("", span));
+        }
+        let record = Record::from_raw_cols_vals(columns, values, span, span);
+        match record {
+            Ok(r) => self.merge_detect_record(r, span),
+            Err(e) => Value::error(e, span),
+        }
+    }
+
+    fn detect_aligned_table(
+        &self,
+        engine_state: &EngineState,
+        input: PipelineData,
+    ) -> Result<PipelineData, ShellError> {
+        let name_span = self.table_head;
+        let input = input.collect_string("", &self.detect_config)?;
+        let input: Vec<_> = input
+            .lines()
+            .skip(self.detect_skip.unwrap_or_default())
+            .map(|x| x.to_string())
+            .collect();
+        let mut input = input.into_iter();
+        let headers = input.next();
+        if let Some(orig_headers) = headers {
+            let headers = self.detect_headers_from_line(&orig_headers);
+            let worker = self.clone();
+            Ok(self
+                .table_no_headers
+                .then_some(orig_headers)
+                .into_iter()
+                .chain(input)
+                .map(move |x| worker.detect_row_record(&headers, &x, name_span))
+                .into_pipeline_data(name_span, engine_state.signals().clone()))
+        } else {
+            Ok(PipelineData::empty())
+        }
+    }
+
+    fn detect_headers_from_line(&self, orig_headers: &str) -> Vec<Spanned<String>> {
+        let mut headers = find_detect_columns(orig_headers);
+        if orig_headers.is_empty() && self.table_head == Span::unknown() {
+            return headers;
+        }
+        if self.table_no_headers {
+            for header in headers.iter_mut().enumerate() {
+                header.1.item = format!("column{}", header.0);
+            }
+        }
+        headers
+    }
+
+    fn detect_row_record(
+        &self,
+        headers: &[Spanned<String>],
+        x: &str,
+        name_span: Span,
+    ) -> Value {
+        let span = if name_span == Span::unknown() {
+            self.table_head
+        } else {
+            name_span
+        };
+        let row = find_detect_columns(x);
+        let mut record = Record::new();
+        if headers.len() == row.len() {
+            for (header, val) in headers.iter().zip(row.iter()) {
+                record.push(&header.item, Value::string(&val.item, span));
+            }
+        } else {
+            let pre_output = self.detect_fill_missing(headers, &row, span);
+            for header in headers {
+                for pre_o in &pre_output {
+                    if pre_o.0 == header.item {
+                        record.push(&header.item, pre_o.1.clone());
+                    }
+                }
+            }
+        }
+        self.merge_detect_record(record, span)
+    }
+
+    fn detect_fill_missing(
+        &self,
+        headers: &[Spanned<String>],
+        row: &[Spanned<String>],
+        name_span: Span,
+    ) -> Vec<(String, Value)> {
+        let span = if name_span == Span::unknown() {
+            self.table_head
+        } else {
+            name_span
+        };
+        let mut pre_output = vec![];
+        for cell in row {
+            for header in headers {
+                if cell.span.start <= header.span.end && cell.span.end > header.span.start {
+                    pre_output.push((header.item.to_string(), Value::string(&cell.item, span)));
+                }
+            }
+        }
+        for header in headers {
+            let mut found = false;
+            for pre_o in &pre_output {
+                if pre_o.0 == header.item {
+                    found = true;
+                    break;
+                }
+            }
+            if !found {
+                pre_output.push((header.item.to_string(), Value::nothing(span)));
+            }
+        }
+        pre_output
+    }
+
+    fn merge_detect_record(&self, record: Record, input_span: Span) -> Value {
+        match &self.detect_combine {
+            Some(range) => {
+                let (start_index, end_index) = match self.process_detect_range(range, record.len(), input_span)
+                {
+                    Ok(Some((l_idx, r_idx))) => (l_idx, r_idx),
+                    Ok(None) => return Value::record(record, input_span),
+                    Err(e) => return Value::error(e, input_span),
+                };
+                match self.merge_detect_record_impl(record, start_index, end_index, input_span) {
+                    Ok(rec) => Value::record(rec, input_span),
+                    Err(err) => Value::error(err, input_span),
+                }
+            }
+            None => {
+                let span = if input_span == Span::unknown() {
+                    self.table_head
+                } else {
+                    input_span
+                };
+                Value::record(record, span)
+            }
+        }
+    }
+
+    fn process_detect_range(
+        &self,
+        range: &Range,
+        length: usize,
+        input_span: Span,
+    ) -> Result<Option<(usize, usize)>, ShellError> {
+        match nu_cmd_base::util::process_range(range) {
+            Ok((l_idx, r_idx)) => {
+                let l_idx = if l_idx < 0 {
+                    length as isize + l_idx
+                } else {
+                    l_idx
+                };
+                let r_idx = if r_idx < 0 {
+                    length as isize + r_idx
+                } else {
+                    r_idx
+                };
+                if !(l_idx <= r_idx && (r_idx >= 0 || l_idx < (length as isize))) {
+                    return Ok(None);
+                }
+                Ok(Some((
+                    l_idx.max(0) as usize,
+                    (r_idx as usize + 1).min(length),
+                )))
+            }
+            Err(processing_error) => {
+                let span = if input_span == Span::unknown() {
+                    self.table_head
+                } else {
+                    input_span
+                };
+                Err(processing_error("could not find range index", span))
+            }
+        }
+    }
+
+    fn merge_detect_record_impl(
+        &self,
+        record: Record,
+        start_index: usize,
+        end_index: usize,
+        input_span: Span,
+    ) -> Result<Record, ShellError> {
+        let (mut cols, mut vals): (Vec<_>, Vec<_>) = record.into_iter().unzip();
+        ((start_index + 1)..(cols.len() - end_index + start_index + 1)).for_each(|idx| {
+            cols.swap(idx, end_index - start_index - 1 + idx);
+        });
+        cols.truncate(cols.len() - end_index + start_index + 1);
+        let combined = vals
+            .iter()
+            .take(end_index)
+            .skip(start_index)
+            .map(|v| v.coerce_str().unwrap_or_default())
+            .join(" ");
+        let binding = Value::string(combined, Span::unknown());
+        let last_seg = vals.split_off(end_index);
+        vals.truncate(start_index);
+        vals.push(binding);
+        vals.extend(last_seg);
+        let span = if input_span == Span::unknown() {
+            self.table_head
+        } else {
+            input_span
+        };
+        Record::from_raw_cols_vals(cols, vals, Span::unknown(), span)
+    }
+
+    pub(crate) fn from_delimited_config(
+        separator: char,
+        comment: Option<char>,
+        quote: char,
+        escape: Option<char>,
+        noheaders: bool,
+        flexible: bool,
+        no_infer: bool,
+        trim: Trim,
+        name: Span,
+    ) -> Self {
+        SubCommand {
+            table_head: name,
+            table_no_headers: noheaders,
+            delimited_separator: separator,
+            delimited_comment: comment,
+            delimited_quote: quote,
+            delimited_escape: escape,
+            delimited_flexible: flexible,
+            delimited_no_infer: no_infer,
+            delimited_trim: trim,
+            ..SubCommand::default()
+        }
+    }
+
+    pub(crate) fn delimited_pipeline(&self, input: PipelineData) -> Result<PipelineData, ShellError> {
+        match input {
+            PipelineData::Empty => Ok(PipelineData::Empty),
+            PipelineData::Value(value, metadata) => {
+                let string = value.into_string()?;
+                let byte_stream = ByteStream::read_string(string, self.table_head, Signals::empty());
+                Ok(PipelineData::ListStream(
+                    self.delimited_from_bytes(byte_stream)?,
+                    metadata,
+                ))
+            }
+            PipelineData::ListStream(list_stream, _) => Err(ShellError::OnlySupportsThisInputType {
+                exp_input_type: "string".into(),
+                wrong_type: "list".into(),
+                dst_span: self.table_head,
+                src_span: list_stream.span(),
+            }),
+            PipelineData::ByteStream(byte_stream, metadata) => Ok(PipelineData::ListStream(
+                self.delimited_from_bytes(byte_stream)?,
+                metadata,
+            )),
+        }
+    }
+
+    fn delimited_from_bytes(&self, input: ByteStream) -> Result<ListStream, ShellError> {
+        let input_reader = if let Some(stream) = input.reader() {
+            stream
+        } else {
+            return Ok(ListStream::new(std::iter::empty(), self.table_head, Signals::empty()));
+        };
+        let mut reader = self.delimited_reader(input_reader);
+        let headers = self.delimited_headers(&mut reader)?;
+        let worker = self.clone();
+        let iter = reader.into_records().map(move |row| worker.delimited_row_value(row, &headers));
+        Ok(ListStream::new(iter, self.table_head, Signals::empty()))
+    }
+
+    fn delimited_reader<R: std::io::Read>(&self, input_reader: R) -> csv::Reader<R> {
+        ReaderBuilder::new()
+            .has_headers(!self.table_no_headers)
+            .flexible(self.delimited_flexible)
+            .delimiter(self.delimited_separator as u8)
+            .comment(self.delimited_comment.map(|c| c as u8))
+            .quote(self.delimited_quote as u8)
+            .escape(self.delimited_escape.map(|c| c as u8))
+            .trim(self.delimited_trim)
+            .from_reader(input_reader)
+    }
+
+    fn delimited_headers<R: std::io::Read>(
+        &self,
+        reader: &mut csv::Reader<R>,
+    ) -> Result<Vec<String>, ShellError> {
+        if self.table_no_headers {
+            Ok((0..reader
+                .headers()
+                .map_err(|err| self.delimited_error(err))?
+                .len())
+                .map(|i| format!("column{i}"))
+                .collect::<Vec<String>>())
+        } else {
+            Ok(reader
+                .headers()
+                .map_err(|err| self.delimited_error(err))?
+                .iter()
+                .map(String::from)
+                .collect())
+        }
+    }
+
+    fn delimited_row_value(
+        &self,
+        row: Result<csv::StringRecord, csv::Error>,
+        headers: &[String],
+    ) -> Value {
+        let span = self.table_head;
+        let row = match row {
+            Ok(row) => row,
+            Err(err) => return Value::error(self.delimited_error(err), span),
+        };
+        let columns = headers.iter().cloned();
+        let values = row
+            .into_iter()
+            .map(|s| self.delimited_infer_value(s))
+            .chain(std::iter::repeat(Value::nothing(span)));
+        Value::record(columns.zip(values).collect(), span)
+    }
+
+    fn delimited_infer_value(&self, s: &str) -> Value {
+        let span = self.table_head;
+        if self.delimited_no_infer {
+            Value::string(s, span)
+        } else if let Ok(i) = s.parse() {
+            Value::int(i, span)
+        } else if let Ok(f) = s.parse() {
+            Value::float(f, span)
+        } else {
+            Value::string(s, span)
+        }
+    }
+
+    fn delimited_error(&self, err: csv::Error) -> ShellError {
+        ShellError::DelimiterError {
+            msg: err.to_string(),
+            span: self.table_head,
+        }
+    }
+
+    pub(crate) fn run_from_ssv(
+        engine_state: &EngineState,
+        stack: &mut Stack,
+        call: &Call,
+        input: PipelineData,
+    ) -> Result<PipelineData, ShellError> {
+        let name = call.head;
+        let noheaders = call.has_flag(engine_state, stack, "noheaders")?;
+        let aligned_columns = call.has_flag(engine_state, stack, "aligned-columns")?;
+        let minimum_spaces: Option<Spanned<usize>> =
+            call.get_flag(engine_state, stack, "minimum-spaces")?;
+        let (concat_string, _span, metadata) = input.collect_string_strict(name)?;
+        let split_at = match minimum_spaces {
+            Some(number) => number.item,
+            None => 2,
+        };
+        let worker = SubCommand {
+            table_head: name,
+            table_no_headers: noheaders,
+            ssv_aligned: aligned_columns,
+            ssv_split_at: split_at,
+            ..SubCommand::default()
+        };
+        Ok(worker
+            .ssv_string_to_value(&concat_string)
+            .into_pipeline_data_with_metadata(metadata))
+    }
+
+    #[cfg(test)]
+    pub(crate) fn for_ssv_table(noheaders: bool, aligned_columns: bool, split_at: usize) -> Self {
+        SubCommand {
+            table_no_headers: noheaders,
+            ssv_aligned: aligned_columns,
+            ssv_split_at: split_at,
+            ..SubCommand::default()
+        }
+    }
+
+    pub(crate) fn ssv_string_to_table(&self, s: &str) -> Vec<Vec<(String, String)>> {
+        if s.is_empty() && self.table_head == Span::unknown() {
+            return vec![];
+        }
+        let mut lines = s
+            .lines()
+            .filter(|l| !l.trim().is_empty() && !l.trim().starts_with('#'));
+        let separator = " ".repeat(std::cmp::max(self.ssv_split_at, 1));
+        let (ls, header_options) = if self.table_no_headers {
+            (lines, HeaderOptions::WithoutHeaders)
+        } else {
+            match lines.next() {
+                Some(header) => (lines, HeaderOptions::WithHeaders(header)),
+                None => return vec![],
+            }
+        };
+        if self.ssv_aligned {
+            self.ssv_parse_aligned(ls, header_options, &separator)
+        } else {
+            self.ssv_parse_separated(ls, header_options, &separator)
+        }
+    }
+
+    fn ssv_string_to_value(&self, s: &str) -> Value {
+        let rows = self
+            .ssv_string_to_table(s)
+            .into_iter()
+            .map(|row| {
+                let mut dict = IndexMap::new();
+                for (col, entry) in row {
+                    dict.insert(col, Value::string(entry, self.table_head));
+                }
+                Value::record(dict.into_iter().collect(), self.table_head)
+            })
+            .collect();
+        Value::list(rows, self.table_head)
+    }
+
+    fn ssv_parse_aligned<'a>(
+        &self,
+        lines: impl Iterator<Item = &'a str>,
+        headers: HeaderOptions<'a>,
+        separator: &str,
+    ) -> Vec<Vec<(String, String)>> {
+        match headers {
+            HeaderOptions::WithHeaders(headers_raw) => self.ssv_construct_aligned(
+                lines,
+                self.ssv_headers_with_indices(headers_raw, separator),
+            ),
+            HeaderOptions::WithoutHeaders => {
+                let ls: Vec<&str> = lines.collect();
+                self.ssv_construct_aligned(
+                    ls.iter().copied(),
+                    self.ssv_headers_without_indices(&ls, separator),
+                )
+            }
+        }
+    }
+
+    fn ssv_find_indices(&self, line: &str, separator: &str) -> Vec<usize> {
+        let values = line
+            .split(separator)
+            .map(str::trim)
+            .filter(|item| !item.is_empty());
+        values
+            .fold(
+                (0, vec![]),
+                |(current_pos, mut indices), value| match line[current_pos..].find(value) {
+                    None => (current_pos, indices),
+                    Some(index) => {
+                        let absolute_index = current_pos + index;
+                        indices.push(absolute_index);
+                        (absolute_index + value.len(), indices)
+                    }
+                },
+            )
+            .1
+    }
+
+    fn ssv_headers_with_indices(&self, headers_raw: &str, separator: &str) -> Vec<(String, usize)> {
+        let indices = self.ssv_find_indices(headers_raw, separator);
+        headers_raw
+            .split(separator)
+            .map(str::trim)
+            .filter(|item| !item.is_empty())
+            .map(String::from)
+            .zip(indices)
+            .collect()
+    }
+
+    fn ssv_headers_without_indices(&self, ls: &[&str], separator: &str) -> Vec<(String, usize)> {
+        let mut indices = ls
+            .iter()
+            .flat_map(|s| self.ssv_find_indices(s, separator))
+            .collect::<Vec<usize>>();
+        indices.sort_unstable();
+        indices.dedup();
+        indices
+            .iter()
+            .enumerate()
+            .map(|(i, position)| (format!("column{}", i), *position))
+            .collect()
+    }
+
+    fn ssv_construct_aligned<'a>(
+        &self,
+        lines: impl Iterator<Item = &'a str>,
+        headers: Vec<(String, usize)>,
+    ) -> Vec<Vec<(String, String)>> {
+        lines
+            .map(|l| {
+                headers
+                    .iter()
+                    .enumerate()
+                    .map(|(i, (header_name, start_position))| {
+                        let char_index_start = match l.char_indices().nth(*start_position) {
+                            Some(idx) => idx.0,
+                            None => *start_position,
+                        };
+                        let val = match headers.get(i + 1) {
+                            Some((_, end)) => {
+                                if *end < l.len() {
+                                    let char_index_end = match l.char_indices().nth(*end) {
+                                        Some(idx) => idx.0,
+                                        None => *end,
+                                    };
+                                    l.get(char_index_start..char_index_end)
+                                } else {
+                                    l.get(char_index_start..)
+                                }
+                            }
+                            None => l.get(char_index_start..),
+                        }
+                        .unwrap_or("")
+                        .trim()
+                        .into();
+                        (header_name.clone(), val)
+                    })
+                    .collect()
+            })
+            .collect()
+    }
+
+    fn ssv_parse_separated<'a>(
+        &self,
+        lines: impl Iterator<Item = &'a str>,
+        headers: HeaderOptions<'a>,
+        separator: &str,
+    ) -> Vec<Vec<(String, String)>> {
+        match headers {
+            HeaderOptions::WithHeaders(headers_raw) => {
+                let headers = headers_raw
+                    .split(separator)
+                    .map(str::trim)
+                    .map(str::to_owned)
+                    .filter(|item| !item.is_empty())
+                    .collect();
+                self.ssv_collect_separated(headers, lines, separator)
+            }
+            HeaderOptions::WithoutHeaders => {
+                let ls: Vec<&str> = lines.collect();
+                let num_columns = ls.iter().map(|r| r.len()).max().unwrap_or(0);
+                let headers = (0..=num_columns)
+                    .map(|i| format!("column{i}"))
+                    .collect::<Vec<String>>();
+                self.ssv_collect_separated(headers, ls.into_iter(), separator)
+            }
+        }
+    }
+
+    fn ssv_collect_separated<'a>(
+        &self,
+        headers: Vec<String>,
+        rows: impl Iterator<Item = &'a str>,
+        separator: &str,
+    ) -> Vec<Vec<(String, String)>> {
+        rows.map(|r| {
+            headers
+                .iter()
+                .zip(r.split(separator).map(str::trim).filter(|item| !item.is_empty()))
+                .map(|(a, b)| (a.to_owned(), b.to_owned()))
+                .collect()
+        })
+        .collect()
+    }
+}
+
+enum HeaderOptions<'a> {
+    WithHeaders(&'a str),
+    WithoutHeaders,
+}
+
+#[derive(Clone, Copy)]
+enum BlockKind {
+    Parenthesis,
+    Brace,
+    Bracket,
+}
+
+fn find_detect_columns(input: &str) -> Vec<Spanned<String>> {
+    let mut chars = input.char_indices().peekable();
+    let mut output = vec![];
+    while let Some((_, c)) = chars.peek() {
+        if c.is_whitespace() {
+            let _ = chars.next();
+        } else {
+            output.push(baseline_detect_token(&mut chars));
+        }
+    }
+    output
+}
+
+fn baseline_detect_token(src: &mut DetectInput) -> Spanned<String> {
+    let mut token_contents = String::new();
+    let start_offset = if let Some((pos, _)) = src.peek() {
+        *pos
+    } else {
+        0
+    };
+    let mut quote_start: Option<char> = None;
+    let mut block_level: Vec<BlockKind> = vec![];
+    fn is_termination(block_level: &[BlockKind], c: char) -> bool {
+        block_level.is_empty() && c.is_whitespace()
+    }
+    while let Some((_, c)) = src.peek() {
+        let c = *c;
+        if quote_start.is_some() {
+            if Some(c) == quote_start {
+                quote_start = None;
+            }
+        } else if c == '\n' {
+            if is_termination(&block_level, c) {
+                break;
             }
+        } else if c == '\'' || c == '"' || c == '`' {
+            quote_start = Some(c);
+        } else if c == '[' {
+            block_level.push(BlockKind::Bracket);
+        } else if c == ']' {
+            if let Some(BlockKind::Bracket) = block_level.last() {
+                let _ = block_level.pop();
+            }
+        } else if c == '{' {
+            block_level.push(BlockKind::Brace);
+        } else if c == '}' {
+            if let Some(BlockKind::Brace) = block_level.last() {
+                let _ = block_level.pop();
+            }
+        } else if c == '(' {
+            block_level.push(BlockKind::Parenthesis);
+        } else if c == ')' {
+            if let Some(BlockKind::Parenthesis) = block_level.last() {
+                let _ = block_level.pop();
+            }
+        } else if is_termination(&block_level, c) {
+            break;
+        }
+        token_contents.push(c);
+        let _ = src.next();
+    }
+    let span = Span::new(start_offset, start_offset + token_contents.len());
+    if block_level.last().is_some() {
+        return Spanned {
+            item: token_contents,
+            span,
+        };
+    }
+    if quote_start.is_some() {
+        return Spanned {
+            item: token_contents,
+            span,
+        };
+    }
+    Spanned {
+        item: token_contents,
+        span,
+    }
+}
+
+struct ParseIter<I: Iterator<Item = Result<String, ShellError>>> {
+    captures: VecDeque<Value>,
+    regex: FancyRegex,
+    columns: Vec<String>,
+    iter: I,
+    span: Span,
+    signals: Signals,
+}
+
+impl<I: Iterator<Item = Result<String, ShellError>>> ParseIter<I> {
+    fn populate_captures(&mut self, value: &str) -> Result<(), ShellError> {
+        for captures in self.regex.captures_iter(value) {
+            self.captures
+                .push_back(captures_to_parse_value(captures, &self.columns, self.span)?);
         }
+        Ok(())
     }
 }
 
+impl<I: Iterator<Item = Result<String, ShellError>>> Iterator for ParseIter<I> {
+    type Item = Value;
+    fn next(&mut self) -> Option<Value> {
+        loop {
+            if self.signals.interrupted() {
+                return None;
+            }
+            if let Some(val) = self.captures.pop_front() {
+                return Some(val);
+            }
+            let result = self
+                .iter
+                .next()?
+                .and_then(|value| self.populate_captures(&value));
+            if let Err(err) = result {
+                return Some(Value::error(err, self.span));
+            }
+        }
+    }
+}
+
+fn captures_to_parse_value(
+    captures: Result<Captures, fancy_regex::Error>,
+    columns: &[String],
+    span: Span,
+) -> Result<Value, ShellError> {
+    let captures = captures.map_err(|err| ShellError::GenericError {
+        error: "Error with regular expression captures".into(),
+        msg: err.to_string(),
+        span: Some(span),
+        help: None,
+        inner: vec![],
+    })?;
+    let record = columns
+        .iter()
+        .zip(captures.iter().skip(1))
+        .map(|(column, match_)| {
+            let match_str = match_.map(|m| m.as_str()).unwrap_or("");
+            (column.clone(), Value::string(match_str, span))
+        })
+        .collect();
+    Ok(Value::record(record, span))
+}
