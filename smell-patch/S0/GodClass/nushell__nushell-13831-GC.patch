+    fn compile_parse_regex(&self) -> Result<FancyRegex, ShellError> {
+        let item_to_parse = if self.parse_regex_mode {
+            self.parse_pattern.clone()
+        } else {
+            self.build_simple_parse_pattern()?
+        };
+        FancyRegex::new(&item_to_parse).map_err(|e| ShellError::GenericError {
+            error: "Error with regular expression".into(),
+            msg: e.to_string(),
