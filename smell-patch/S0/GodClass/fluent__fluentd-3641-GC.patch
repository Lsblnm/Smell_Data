+      def capture_system_settings(system_config)
+        @system_snapshot = system_config
+        @conf_dump = @conf_dump
+        summarize_system_snapshot
+        @system_snapshot
+      end
+
+      def snapshot_conf_text(owner)
+        text = if owner.nil?
+                 nil
+               elsif owner.instance_variable_defined?(:@fluentd_conf)
+                 owner.instance_variable_get(:@fluentd_conf)
+               else
+                 nil
+               end
+        @conf_dump = text
+        text
+      end
+
+      def dump_conf_text(owner)
+        text = snapshot_conf_text(owner)
+        if text.nil?
+          $log.info nil if $log
+        else
+          $log.info text if $log
+        end
+        @conf_dump
+      end
+
+      def dumped_conf_payload(owner)
+        text = snapshot_conf_text(owner)
+        if text.nil?
+          { conf: nil }
+        else
+          { conf: @conf_dump }
+        end
+      end
