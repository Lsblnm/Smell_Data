+      def workers_from_system
+        if @system_snapshot.nil?
+          1
+        elsif @system_snapshot.respond_to?(:workers)
+          value = @system_snapshot.workers
+          if value.nil? || value.to_i < 1
+            1
+          else
+            value.to_i
+          end
+        else
+          1
+        end
+      end
