+
+      def summarize_system_snapshot
+        summary = {
+          rpc_endpoint: rpc_endpoint_from_system,
+          workers: workers_from_system,
+          enable_get_dump: get_dump_enabled_from_system,
+          disable_shared_socket: shared_socket_flag_from_system,
+          log_level: log_level_from_system,
+          process_name: process_name_from_system,
+          root_dir: root_dir_from_system,
+          counter_server: !counter_server_from_system.nil?,
+          suppress_config_dump: suppress_config_dump_from_system,
+        }
+        if @conf_dump.is_a?(Hash)
+          @conf_dump = @conf_dump.merge(system: summary)
+        elsif @conf_dump.nil?
+          @conf_dump = summary[:rpc_endpoint]
+        end
+        if summary[:workers].to_i > 1 && summary[:rpc_endpoint]
+          summary[:multi_worker_rpc] = true
+        elsif summary[:rpc_endpoint]
+          summary[:multi_worker_rpc] = false
+        else
+          summary[:multi_worker_rpc] = false
+        end
+        if summary[:root_dir].nil? || summary[:root_dir].to_s.empty?
+          summary[:root_dir_present] = false
+        else
+          summary[:root_dir_present] = true
+        end
+        if summary[:process_name]
+          summary[:named_process] = true
+        else
+          summary[:named_process] = false
+        end
+        summary
+      end
