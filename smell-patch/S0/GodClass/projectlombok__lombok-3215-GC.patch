+	void writeToStringMethod(JavacNode typeNode, JavacNode source, java.util.List<Included<JavacNode, ToString.Include>> members,
+		boolean includeFieldNames, Boolean callSuper, boolean whineIfExists, FieldAccess fieldAccess) {
+		this.activeToStringSource = source;
+		this.activeToStringIncludeNames = includeFieldNames;
+		if (!isClassOrEnum(typeNode)) {
+			source.addError("@ToString is only supported on a class or enum.");
+			return;
+		}
+		switch (methodExists("toString", typeNode, 0)) {
+		case NOT_EXISTS:
+			if (callSuper == null) {
+				if (isDirectDescendantOfObject(typeNode)) {
+					callSuper = false;
+				} else {
+					CallSuperType cst = typeNode.getAst().readConfiguration(ConfigurationKeys.TO_STRING_CALL_SUPER);
+					if (cst == null) cst = CallSuperType.SKIP;
+					switch (cst) {
+					default:
+					case SKIP:
+						callSuper = false;
+						break;
+					case WARN:
+						source.addWarning("Generating toString implementation but without a call to superclass, even though this class does not extend java.lang.Object. If this is intentional, add '@ToString(callSuper=false)' to your type.");
+						callSuper = false;
+						break;
+					case CALL:
+						callSuper = true;
+						break;
+					}
+				}
+			}
+			this.activeToStringCallSuper = callSuper.booleanValue();
+			JCMethodDecl method = assembleToStringMethod(typeNode, members, includeFieldNames, callSuper.booleanValue(), fieldAccess, source);
+			injectMethod(typeNode, method);
+			break;
+		case EXISTS_BY_LOMBOK:
+			break;
+		default:
+		case EXISTS_BY_USER:
+			if (whineIfExists) {
+				source.addWarning("Not generating toString(): A method with that name already exists");
+			}
+			break;
+		}
+	}
+
+	JCMethodDecl assembleToStringMethod(JavacNode typeNode, Collection<Included<JavacNode, ToString.Include>> members,
+		boolean includeNames, boolean callSuper, FieldAccess fieldAccess, JavacNode source) {
+		this.activeToStringSource = source;
+		this.activeToStringIncludeNames = includeNames;
+		this.activeToStringCallSuper = callSuper;
+		JavacTreeMaker maker = typeNode.getTreeMaker();
+
+		JCAnnotation overrideAnnotation = maker.Annotation(genJavaLangTypeRef(typeNode, "Override"), List.<JCExpression>nil());
+		List<JCAnnotation> annsOnMethod = List.of(overrideAnnotation);
+		if (getCheckerFrameworkVersion(typeNode).generateSideEffectFree()) annsOnMethod = annsOnMethod.prepend(maker.Annotation(genTypeRef(typeNode, CheckerFrameworkVersion.NAME__SIDE_EFFECT_FREE), List.<JCExpression>nil()));
+		JCModifiers mods = maker.Modifiers(Flags.PUBLIC, annsOnMethod);
+		JCExpression returnType = genJavaLangTypeRef(typeNode, "String");
+
+		boolean first = true;
+		String typeName = typeQualifiedName(typeNode);
+		boolean isEnum = typeNode.isEnumType();
+		String infix = ", ";
+		String suffix = ")";
+		String prefix = toStringPrefixFor(typeNode, members, includeNames, callSuper);
+
+		JCExpression current;
+		if (!isEnum) {
+			current = maker.Literal(typeName + prefix);
+		} else {
+			current = maker.Binary(CTC_PLUS, maker.Literal(typeName + "."), maker.Apply(List.<JCExpression>nil(),
+					maker.Select(maker.Ident(typeNode.toName("this")), typeNode.toName("name")),
+					List.<JCExpression>nil()));
+			if (!prefix.isEmpty()) current = maker.Binary(CTC_PLUS, current, maker.Literal(prefix));
+		}
+
+		if (callSuper) {
+			JCMethodInvocation callToSuper = maker.Apply(List.<JCExpression>nil(),
+				maker.Select(maker.Ident(typeNode.toName("super")), typeNode.toName("toString")),
+				List.<JCExpression>nil());
+			current = maker.Binary(CTC_PLUS, current, callToSuper);
+			first = false;
+		}
+
+		for (Included<JavacNode, ToString.Include> member : members) {
+			JCExpression expr = toStringMemberExpression(maker, member, fieldAccess);
+			JavacNode memberNode = member.getNode();
+			if (first) {
+				current = maker.Binary(CTC_PLUS, current, expr);
+				first = false;
+				continue;
+			}
+			if (includeNames) {
+				String n = member.getInc() == null ? "" : member.getInc().name();
+				if (n.isEmpty()) n = memberNode.getName();
+				current = maker.Binary(CTC_PLUS, current, maker.Literal(infix + n + "="));
+			} else {
+				current = maker.Binary(CTC_PLUS, current, maker.Literal(infix));
+			}
+			current = maker.Binary(CTC_PLUS, current, expr);
+		}
+
+		if (!first) current = maker.Binary(CTC_PLUS, current, maker.Literal(suffix));
+		JCStatement returnStatement = maker.Return(current);
+		JCBlock body = maker.Block(0, List.of(returnStatement));
+		JCMethodDecl methodDef = maker.MethodDef(mods, typeNode.toName("toString"), returnType,
+			List.<JCTypeParameter>nil(), List.<JCVariableDecl>nil(), List.<JCExpression>nil(), body, null);
+		createRelevantNonNullAnnotation(typeNode, methodDef);
+		return recursiveSetGeneratedBy(methodDef, source);
+	}
+
+	String toStringPrefixFor(JavacNode typeNode, Collection<Included<JavacNode, ToString.Include>> members, boolean includeNames, boolean callSuper) {
+		this.activeToStringIncludeNames = includeNames;
+		this.activeToStringCallSuper = callSuper;
+		boolean isEnum = typeNode.isEnumType();
+		if (callSuper) {
+			return "(super=";
+		} else if (members.isEmpty()) {
+			return isEnum ? "" : "()";
+		} else if (includeNames) {
+			Included<JavacNode, ToString.Include> firstMember = members.iterator().next();
+			String name = firstMember.getInc() == null ? "" : firstMember.getInc().name();
+			if (name.isEmpty()) name = firstMember.getNode().getName();
+			return "(" + name + "=";
+		}
+		return "(";
+	}
+
+	JCExpression toStringMemberExpression(JavacTreeMaker maker, Included<JavacNode, ToString.Include> member, FieldAccess fieldAccess) {
+		if (this.activeToStringSource == null && member != null) this.activeToStringSource = member.getNode();
+		JavacNode memberNode = member.getNode();
+		JCExpression memberAccessor;
+		if (memberNode.getKind() == Kind.METHOD) {
+			memberAccessor = createMethodAccessor(maker, memberNode);
+		} else {
+			memberAccessor = createFieldAccessor(maker, memberNode, fieldAccess);
+		}
+		JCExpression memberType = getFieldType(memberNode, fieldAccess);
+		boolean fieldIsPrimitiveArray = memberType instanceof JCArrayTypeTree && ((JCArrayTypeTree) memberType).elemtype instanceof JCPrimitiveTypeTree;
+		boolean fieldIsObjectArray = !fieldIsPrimitiveArray && memberType instanceof JCArrayTypeTree;
+		if (fieldIsPrimitiveArray || fieldIsObjectArray) {
+			JCExpression tsMethod = chainDots(memberNode, "java", "util", "Arrays", fieldIsObjectArray ? "deepToString" : "toString");
+			return maker.Apply(List.<JCExpression>nil(), tsMethod, List.<JCExpression>of(memberAccessor));
+		}
+		return memberAccessor;
+	}
+
+	String typeQualifiedName(JavacNode typeNode) {
+		if (this.activeToStringSource == null) this.activeToStringSource = typeNode;
+		String typeName = typeNode.getName();
+		JavacNode upType = typeNode.up();
+		while (upType.getKind() == Kind.TYPE && !upType.getName().isEmpty()) {
+			typeName = upType.getName() + "." + typeName;
+			upType = upType.up();
+		}
+		return typeName;
+	}
+
+	<A extends Annotation> AnnotationValues<A> decodeAnnotationValues(Class<A> type, JavacNode node) {
+		this.activeAnnotationNode = node;
+		this.activeAnnotationType = type;
+		return decodeAnnotationFromAst(type, (JCAnnotation) node.get(), node);
+	}
+
+	<A extends Annotation> AnnotationValues<A> decodeAnnotationFromAst(Class<A> type, JCAnnotation anno, final JavacNode node) {
+		this.activeAnnotationNode = node;
+		this.activeAnnotationAst = anno;
+		this.activeAnnotationType = type;
+		Map<String, AnnotationValue> values = new HashMap<String, AnnotationValue>();
+		List<JCExpression> arguments = anno.getArguments();
+		for (JCExpression arg : arguments) {
+			recordAnnotationArgument(type, node, values, arg);
+		}
+		fillMissingAnnotationMethods(type, node, values);
+		return new AnnotationValues<A>(type, values, node);
+	}
+
+	<A extends Annotation> void recordAnnotationArgument(Class<A> type, final JavacNode node, Map<String, AnnotationValue> values, JCExpression arg) {
+		this.activeAnnotationNode = node;
+		this.activeAnnotationType = type;
+		String mName;
+		JCExpression rhs;
+		java.util.List<String> raws = new ArrayList<String>();
+		java.util.List<Object> guesses = new ArrayList<Object>();
+		java.util.List<Object> expressions = new ArrayList<Object>();
+		final java.util.List<DiagnosticPosition> positions = new ArrayList<DiagnosticPosition>();
+
+		if (arg instanceof JCAssign) {
+			JCAssign assign = (JCAssign) arg;
+			mName = assign.lhs.toString();
+			rhs = assign.rhs;
+		} else {
+			rhs = arg;
+			mName = "value";
+		}
+
+		if (rhs instanceof JCNewArray) {
+			List<JCExpression> elems = ((JCNewArray) rhs).elems;
+			for (JCExpression inner : elems) {
+				raws.add(inner.toString());
+				expressions.add(inner);
+				guesses.add(guessNestedAnnotationValue(node, inner));
+				positions.add(inner.pos());
+			}
+		} else {
+			raws.add(rhs.toString());
+			expressions.add(rhs);
+			guesses.add(guessNestedAnnotationValue(node, rhs));
+			positions.add(rhs.pos());
+		}
+
+		values.put(mName, new AnnotationValue(node, raws, expressions, guesses, true) {
+			@Override public void setError(String message, int valueIdx) {
+				if (valueIdx < 0) node.addError(message);
+				else node.addError(message, positions.get(valueIdx));
+			}
+			@Override public void setWarning(String message, int valueIdx) {
+				if (valueIdx < 0) node.addWarning(message);
+				else node.addWarning(message, positions.get(valueIdx));
+			}
+		});
+	}
+
+	<A extends Annotation> void fillMissingAnnotationMethods(Class<A> type, final JavacNode node, Map<String, AnnotationValue> values) {
+		this.activeAnnotationNode = node;
+		this.activeAnnotationType = type;
+		for (Method m : type.getDeclaredMethods()) {
+			if (!java.lang.reflect.Modifier.isPublic(m.getModifiers())) continue;
+			String name = m.getName();
+			if (!values.containsKey(name)) {
+				values.put(name, new AnnotationValue(node, new ArrayList<String>(), new ArrayList<Object>(), new ArrayList<Object>(), false) {
+					@Override public void setError(String message, int valueIdx) {
+						node.addError(message);
+					}
+					@Override public void setWarning(String message, int valueIdx) {
+						node.addWarning(message);
+					}
+				});
+			}
+		}
+	}
+
+	Object guessNestedAnnotationValue(JavacNode node, JCExpression expr) {
+		this.activeAnnotationNode = node;
+		if (expr instanceof JCAnnotation) {
+			try {
+				@SuppressWarnings("unchecked")
+				Class<Annotation> innerClass = (Class<Annotation>) Class.forName(expr.type.toString());
+				return decodeAnnotationFromAst(innerClass, (JCAnnotation) expr, node);
+			} catch (ClassNotFoundException ex) {
+				return calculateGuess(expr);
+			}
+		}
+		return calculateGuess(expr);
+	}
 }
