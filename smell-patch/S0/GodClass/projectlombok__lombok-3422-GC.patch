+		JCVariableDecl fieldDecl = (JCVariableDecl) field.get();
+		//Skip fields that start with $
+		if (fieldDecl.name.toString().startsWith("$")) return false;
+		//Skip static fields.
+		if ((fieldDecl.mods.flags & Flags.STATIC) != 0) return false;
+		return true;
