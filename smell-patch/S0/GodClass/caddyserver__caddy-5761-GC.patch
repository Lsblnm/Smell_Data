+	if value >= len(l.importArgs) {
+		caddy.Log().Named("caddyfile").Warn(
+			"Placeholder {args." + matches[1] + "} index is out of bounds, only " + strconv.Itoa(len(l.importArgs)) + " argument(s) exist")
+		return nil, false
+	}
+	caddy.Log().Named("caddyfile").Warn(
+		"Placeholder {args." + matches[1] + "} deprecated, use {args[" + matches[1] + "]} instead")
+	return l.importArgs[value], true
