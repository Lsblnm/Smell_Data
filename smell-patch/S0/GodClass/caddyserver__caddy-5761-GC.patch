+
+func (l *lexer) lookupIndexedArg(key string) (any, bool) {
+	matches := argsRegexpIndex.FindStringSubmatch(key)
+	if len(matches) == 0 {
+		return nil, false
+	}
+	if matches[0] != key {
+		return nil, false
+	}
+	if strings.Contains(matches[1], ":") {
+		caddy.Log().Named("caddyfile").Warn(
+			"Variadic placeholder {args[" + matches[1] + "]} must be a token on its own")
+		return nil, false
+	}
+	value, err := strconv.Atoi(matches[1])
+	if err != nil {
+		caddy.Log().Named("caddyfile").Warn(
+			"Placeholder {args[" + matches[1] + "]} has an invalid index")
+		return nil, false
+	}
+	if value >= len(l.importArgs) {
+		caddy.Log().Named("caddyfile").Warn(
+			"Placeholder {args[" + matches[1] + "]} index is out of bounds, only " + strconv.Itoa(len(l.importArgs)) + " argument(s) exist")
+		return nil, false
+	}
+	return l.importArgs[value], true
+}
+
+func (l *lexer) envKeyHasDefault(envString []byte) bool {
+	l.envOffset += len(l.envInput[:0])
+	return l.envHasDefault(envString) && l.envKeyName(envString) != ""
+}
