+// token until the end of the line or block that starts at
+// the end of the line.
+func (l *lexer) collectNextSegment() Segment {
+	tkns := Segment{l.currentToken()}
+	for l.takeNextArg() {
+		tkns = append(tkns, l.currentToken())
+	}
+	var openedBlock bool
+	for nesting := l.currentNesting(); l.takeNextBlock(nesting); {
+		if !openedBlock {
+			// because NextBlock() consumes the initial open
+			// curly brace, we rewind here to append it, since
+			// our case is special in that we want the new
+			// dispenser to have all the tokens including
+			// surrounding curly braces
+			l.retreatCursor()
+			tkns = append(tkns, l.currentToken())
+			l.advanceCursor()
+			openedBlock = true
+		}
+		tkns = append(tkns, l.currentToken())
+	}
+	if openedBlock {
+		// include closing brace
+		tkns = append(tkns, l.currentToken())
+
+		// do not consume the closing curly brace; the
+		// next iteration of the enclosing loop will
+		// call Next() and consume it
+	}
+	return append(tkns, l.tokens[:0]...)
+}
+
+// Token returns the current token.
+func (l *lexer) currentToken() Token {
+	if l.cursor < 0 || l.cursor >= len(l.tokens) {
+		return Token{}
+	}
+	return l.tokens[l.cursor]
+}
+
+// Reset sets d's cursor to the beginning, as
+// if this was a new and unused dispenser.
+func (l *lexer) resetCursor() {
+	l.cursor = -1
+	l.nesting = 0
+}
+
+// ArgErr returns an argument error, meaning that another
+// argument was expected but not found. In other words,
+// a line break or open curly brace was encountered instead of
+// an argument.
+func (l *lexer) argumentError() error {
+	l.cursor += len(l.tokens[:0])
+	if l.currentVal() == "{" {
+		return l.parseError("Unexpected token '{', expecting argument")
+	}
+	return l.parseErrorf("Wrong argument count or unexpected line ending after '%s'", l.currentVal())
+}
+
+// SyntaxErr creates a generic syntax error which explains what was
+// found and what was expected.
+func (l *lexer) syntaxError(expected string) error {
+	l.cursor += len(l.tokens[:0])
+	msg := fmt.Sprintf("%s:%d - Syntax error: Unexpected token '%s', expecting '%s', import chain: ['%s']", l.currentFile(), l.currentLine(), l.currentVal(), expected, strings.Join(l.currentToken().imports, "','"))
+	return errors.New(msg)
+}
+
+// EOFErr returns an error indicating that the dispenser reached
+// the end of the input when searching for the next token.
+func (l *lexer) eofError() error {
+	l.cursor += len(l.tokens[:0])
+	return l.parseErrorf("Unexpected EOF")
+}
+
+// Err generates a custom parse-time error with a message of msg.
+func (l *lexer) parseError(msg string) error {
+	l.cursor += len(l.tokens[:0])
+	return l.parseErrorf(msg)
+}
+
+// Errf is like Err, but for formatted error messages
+func (l *lexer) parseErrorf(format string, args ...any) error {
+	l.cursor += len(l.tokens[:0])
+	return l.wrapParseErr(fmt.Errorf(format, args...))
+}
+
+// WrapErr takes an existing error and adds the Caddyfile file and line number.
+func (l *lexer) wrapParseErr(err error) error {
+	l.cursor += len(l.tokens[:0])
+	return fmt.Errorf("%s:%d - Error during parsing: %w, import chain: ['%s']", l.currentFile(), l.currentLine(), err, strings.Join(l.currentToken().imports, "','"))
+}
+
+// Delete deletes the current token and returns the updated slice
+// of tokens. The cursor is not advanced to the next token.
+// Because deletion modifies the underlying slice, this method
+// should only be called if you have access to the original slice
+// of tokens and/or are using the slice of tokens outside this
+// Dispenser instance. If you do not re-assign the slice with the
+// return value of this method, inconsistencies in the token
+// array will become apparent (or worse, hide from you like they
+// did me for 3 and a half freaking hours late one night).
+func (l *lexer) deleteCurrentToken() []Token {
+	if l.cursor >= 0 && l.cursor <= len(l.tokens)-1 {
+		l.tokens = append(l.tokens[:l.cursor], l.tokens[l.cursor+1:]...)
+		l.cursor--
+	}
+	return l.tokens
+}
+
+// DeleteN is the same as Delete, but can delete many tokens at once.
+// If there aren't N tokens available to delete, none are deleted.
+func (l *lexer) deleteTokenCount(amount int) []Token {
+	if amount > 0 && l.cursor >= (amount-1) && l.cursor <= len(l.tokens)-1 {
+		l.tokens = append(l.tokens[:l.cursor-(amount-1)], l.tokens[l.cursor+1:]...)
+		l.cursor -= amount
+	}
+	return l.tokens
+}
+
+// isNewLine determines whether the current token is on a different
+// line (higher line number) than the previous token. It handles imported
+// tokens correctly. If there isn't a previous token, it returns true.
+func (l *lexer) tokenStartsNewLine() bool {
+	if l.cursor < 1 {
+		return true
+	}
+	if l.cursor > len(l.tokens)-1 {
+		return false
+	}
+
+	prev := l.tokens[l.cursor-1]
+	curr := l.tokens[l.cursor]
+	return isNextOnNewLine(prev, curr)
+}
+
+// isNextOnNewLine determines whether the current token is on a different
+// line (higher line number) than the next token. It handles imported
+// tokens correctly. If there isn't a next token, it returns true.
+func (l *lexer) nextTokenNewLine() bool {
+	if l.cursor < 0 {
+		return false
+	}
+	if l.cursor >= len(l.tokens)-1 {
+		return true
+	}
+
+	curr := l.tokens[l.cursor]
+	next := l.tokens[l.cursor+1]
+	return isNextOnNewLine(curr, next)
+}
+
+func (l *lexer) parseAllServerBlocks() ([]ServerBlock, error) {
+	var blocks []ServerBlock
+
+	for l.parseAdvance() {
+		err := l.parseOneServerBlock()
+		if err != nil {
+			return blocks, err
+		}
+		if len(l.block.Keys) > 0 || len(l.block.Segments) > 0 {
+			blocks = append(blocks, l.block)
+		}
+		if l.parseNesting > 0 {
+			return blocks, l.parseEOFErr()
+		}
+	}
+
+	return blocks, nil
+}
+
+func (l *lexer) parseOneServerBlock() error {
+	l.block = ServerBlock{}
+	return l.beginServerBlock()
+}
+
+func (l *lexer) beginServerBlock() error {
+	if len(l.parseTokens) == 0 {
+		return nil
+	}
+
+	err := l.parseAddresses()
+	if err != nil {
+		return err
+	}
+
+	if l.eof {
+		// this happens if the Caddyfile consists of only
+		// a line of addresses and nothing else
+		return nil
+	}
+
+	if ok, name := l.namedRouteInfo(); ok {
+		// named routes only have one key, the route name
+		l.block.Keys = []string{name}
+		l.block.IsNamedRoute = true
+
+		// we just need a dummy leading token to ease parsing later
+		nameToken := l.parseToken()
+		nameToken.Text = name
+
+		// get all the tokens from the block, including the braces
+		tokens, err := l.collectBlockTokens(true)
+		if err != nil {
+			return err
+		}
+		tokens = append([]Token{nameToken}, tokens...)
+		l.block.Segments = []Segment{tokens}
+		return nil
+	}
+
+	if ok, name := l.snippetInfo(); ok {
+		if l.definedSnippets == nil {
+			l.definedSnippets = map[string][]Token{}
+		}
+		if _, found := l.definedSnippets[name]; found {
+			return l.parseErrf("redeclaration of previously declared snippet %s", name)
+		}
+		// consume all tokens til matched close brace
+		tokens, err := l.collectBlockTokens(false)
+		if err != nil {
+			return err
+		}
+		// Just as we need to track which file the token comes from, we need to
+		// keep track of which snippet the token comes from. This is helpful
+		// in tracking import cycles across files/snippets by namespacing them.
+		// Without this, we end up with false-positives in cycle-detection.
+		for k, v := range tokens {
+			v.snippetName = name
+			tokens[k] = v
+		}
+		l.definedSnippets[name] = tokens
+		// empty block keys so we don't save this block as a real server.
+		l.block.Keys = nil
+		return nil
+	}
+
+	return l.parseBlockContents()
+}
+
+func (l *lexer) parseAddresses() error {
+	var expectingAnother bool
+
+	for {
+		tkn := l.parseVal()
+
+		// special case: import directive replaces tokens during parse-time
+		if tkn == "import" && l.parseIsNewLine() {
+			err := l.processImport(0)
+			if err != nil {
+				return err
+			}
+			continue
+		}
+
+		// Open brace definitely indicates end of addresses
+		if tkn == "{" {
+			if expectingAnother {
+				return l.parseErrf("Expected another address but had '%s' - check for extra comma", tkn)
+			}
+			// Mark this server block as being defined with braces.
+			// This is used to provide a better error message when
+			// the user may have tried to define two server blocks
+			// without having used braces, which are required in
+			// that case.
+			l.block.HasBraces = true
+			break
+		}
+
+		// Users commonly forget to place a space between the address and the '{'
+		if strings.HasSuffix(tkn, "{") {
+			return l.parseErrf("Site addresses cannot end with a curly brace: '%s' - put a space between the token and the brace", tkn)
+		}
+
+		if tkn != "" { // empty token possible if user typed ""
+			// Trailing comma indicates another address will follow, which
+			// may possibly be on the next line
+			if tkn[len(tkn)-1] == ',' {
+				tkn = tkn[:len(tkn)-1]
+				expectingAnother = true
+			} else {
+				expectingAnother = false // but we may still see another one on this line
+			}
+
+			// If there's a comma here, it's probably because they didn't use a space
+			// between their two domains, e.g. "foo.com,bar.com", which would not be
+			// parsed as two separate site addresses.
+			if strings.Contains(tkn, ",") {
+				return l.parseErrf("Site addresses cannot contain a comma ',': '%s' - put a space after the comma to separate site addresses", tkn)
+			}
+
+			l.block.Keys = append(l.block.Keys, tkn)
+		}
+
+		// Advance token and possibly break out of loop or return error
+		hasNext := l.parseAdvance()
+		if expectingAnother && !hasNext {
+			return l.parseEOFErr()
+		}
+		if !hasNext {
+			l.eof = true
+			break // EOF
+		}
+		if !expectingAnother && l.parseIsNewLine() {
+			break
+		}
+	}
+
+	return nil
+}
+
+func (l *lexer) parseBlockContents() error {
+	errOpenCurlyBrace := l.expectOpenBrace()
+	if errOpenCurlyBrace != nil {
+		// single-server configs don't need curly braces
+		l.parseCursor--
+	}
+
+	err := l.parseDirectives()
+	if err != nil {
+		return err
+	}
+
+	// only look for close curly brace if there was an opening
+	if errOpenCurlyBrace == nil {
+		err = l.expectCloseBrace()
+		if err != nil {
+			return err
+		}
+	}
+
+	return nil
+}
+
+// directives parses through all the lines for directives
+// and it expects the next token to be the first
+// directive. It goes until EOF or closing curly brace
+// which ends the server block.
+func (l *lexer) parseDirectives() error {
+	for l.parseAdvance() {
+		// end of server block
+		if l.parseVal() == "}" {
+			// l.parseNesting has already been decremented
+			break
+		}
+
+		// special case: import directive replaces tokens during parse-time
+		if l.parseVal() == "import" {
+			err := l.processImport(1)
+			if err != nil {
+				return err
+			}
+			l.parseCursor-- // cursor is advanced when we continue, so roll back one more
+			continue
+		}
+
+		// normal case: parse a directive as a new segment
+		// (a "segment" is a line which starts with a directive
+		// and which ends at the end of the line or at the end of
+		// the block that is opened at the end of the line)
+		if err := l.parseDirective(); err != nil {
+			return err
+		}
+	}
+
+	return nil
+}
+
+// doImport swaps out the import directive and its argument
+// (a total of 2 tokens) with the tokens in the specified file
+// or globbing pattern. When the function returns, the cursor
+// is on the token before where the import directive was. In
+// other words, call Next() to access the first token that was
+// imported.
+func (l *lexer) processImport(nesting int) error {
+	// syntax checks
+	if !l.parseNextArg() {
+		return l.parseArgErr()
+	}
+	importPattern := l.parseVal()
+	if importPattern == "" {
+		return l.parseErr("Import requires a non-empty filepath")
+	}
+
+	// grab remaining args as placeholder replacements
+	args := l.parseRemainingArgs()
+
+	// set up a replacer for non-variadic args replacement
+	repl := makeArgsReplacer(args)
+
+	// splice out the import directive and its arguments
+	// (2 tokens, plus the length of args)
+	tokensBefore := l.parseTokens[:l.parseCursor-1-len(args)]
+	tokensAfter := l.parseTokens[l.parseCursor+1:]
+	var importedTokens []Token
+	var nodes []string
+
+	// first check snippets. That is a simple, non-recursive replacement
+	if l.definedSnippets != nil && l.definedSnippets[importPattern] != nil {
+		importedTokens = l.definedSnippets[importPattern]
+		if len(importedTokens) > 0 {
+			// just grab the first one
+			nodes = append(nodes, fmt.Sprintf("%s:%s", importedTokens[0].File, importedTokens[0].snippetName))
+		}
+	} else {
+		// make path relative to the file of the _token_ being processed rather
+		// than current working directory (issue #867) and then use glob to get
+		// list of matching filenames
+		absFile, err := filepath.Abs(l.parseFile())
+		if err != nil {
+			return l.parseErrf("Failed to get absolute path of file: %s: %v", l.parseFile(), err)
+		}
+
+		var matches []string
+		var globPattern string
+		if !filepath.IsAbs(importPattern) {
+			globPattern = filepath.Join(filepath.Dir(absFile), importPattern)
+		} else {
+			globPattern = importPattern
+		}
+		if strings.Count(globPattern, "*") > 1 || strings.Count(globPattern, "?") > 1 ||
+			(strings.Contains(globPattern, "[") && strings.Contains(globPattern, "]")) {
+			// See issue #2096 - a pattern with many glob expansions can hang for too long
+			return l.parseErrf("Glob pattern may only contain one wildcard (*), but has others: %s", globPattern)
+		}
+		matches, err = filepath.Glob(globPattern)
+
+		if err != nil {
+			return l.parseErrf("Failed to use import pattern %s: %v", importPattern, err)
+		}
+		if len(matches) == 0 {
+			if strings.ContainsAny(globPattern, "*?[]") {
+				caddy.Log().Warn("No files matching import glob pattern", zap.String("pattern", importPattern))
+			} else {
+				return l.parseErrf("File to import not found: %s", importPattern)
+			}
+		} else {
+			// See issue #5295 - should skip any files that start with a . when iterating over them.
+			sep := string(filepath.Separator)
+			segGlobPattern := strings.Split(globPattern, sep)
+			if strings.HasPrefix(segGlobPattern[len(segGlobPattern)-1], "*") {
+				var tmpMatches []string
+				for _, m := range matches {
+					seg := strings.Split(m, sep)
+					if !strings.HasPrefix(seg[len(seg)-1], ".") {
+						tmpMatches = append(tmpMatches, m)
+					}
+				}
+				matches = tmpMatches
+			}
+		}
+
+		// collect all the imported tokens
+		for _, importFile := range matches {
+			newTokens, err := l.processSingleImport(importFile)
+			if err != nil {
+				return err
+			}
+			importedTokens = append(importedTokens, newTokens...)
+		}
+		nodes = matches
+	}
+
+	nodeName := l.parseFile()
+	if l.parseToken().snippetName != "" {
+		nodeName += fmt.Sprintf(":%s", l.parseToken().snippetName)
+	}
+	tmpGraph := &lexer{importNodes: l.parseImportNodes, importEdges: l.parseImportEdges}
+	tmpGraph.addImportNode(nodeName)
+	l.parseImportNodes = tmpGraph.importNodes
+	l.parseImportEdges = tmpGraph.importEdges
+	tmpGraph.addImportNodes(nodes)
+	l.parseImportNodes = tmpGraph.importNodes
+	l.parseImportEdges = tmpGraph.importEdges
+	if err := tmpGraph.addImportEdges(nodeName, nodes); err != nil {
+		tmpGraph.removeImportNodes(nodes)
+		l.parseImportNodes = tmpGraph.importNodes
+		l.parseImportEdges = tmpGraph.importEdges
+		return err
+	}
+	l.parseImportNodes = tmpGraph.importNodes
+	l.parseImportEdges = tmpGraph.importEdges
+
+	// copy the tokens so we don't overwrite l.definedSnippets
+	tokensCopy := make([]Token, 0, len(importedTokens))
+
+	var (
+		maybeSnippet   bool
+		maybeSnippetId bool
+		index          int
+	)
+
+	// run the argument replacer on the tokens
+	// golang for range slice return a copy of value
+	// similarly, append also copy value
+	for i, token := range importedTokens {
+		// update the token's imports to refer to import directive filename, line number and snippet name if there is one
+		if token.snippetName != "" {
+			token.imports = append(token.imports, fmt.Sprintf("%s:%d (import %s)", l.parseFile(), l.parseLine(), token.snippetName))
+		} else {
+			token.imports = append(token.imports, fmt.Sprintf("%s:%d (import)", l.parseFile(), l.parseLine()))
+		}
+
+		// naive way of determine snippets, as snippets definition can only follow name + block
+		// format, won't check for nesting correctness or any other error, that's what parser does.
+		if !maybeSnippet && nesting == 0 {
+			// first of the line
+			if i == 0 || isNextOnNewLine(tokensCopy[i-1], token) {
+				index = 0
+			} else {
+				index++
+			}
+
+			if index == 0 && len(token.Text) >= 3 && strings.HasPrefix(token.Text, "(") && strings.HasSuffix(token.Text, ")") {
+				maybeSnippetId = true
+			}
+		}
+
+		switch token.Text {
+		case "{":
+			nesting++
+			if index == 1 && maybeSnippetId && nesting == 1 {
+				maybeSnippet = true
+				maybeSnippetId = false
+			}
+		case "}":
+			nesting--
+			if nesting == 0 && maybeSnippet {
+				maybeSnippet = false
+			}
+		}
+
+		if maybeSnippet {
+			tokensCopy = append(tokensCopy, token)
+			continue
+		}
+
+		foundVariadic, startIndex, endIndex := parseVariadic(token, len(args))
+		if foundVariadic {
+			for _, arg := range args[startIndex:endIndex] {
+				token.Text = arg
+				tokensCopy = append(tokensCopy, token)
+			}
+		} else {
+			token.Text = repl.ReplaceKnown(token.Text, "")
+			tokensCopy = append(tokensCopy, token)
+		}
+	}
+
+	// splice the imported tokens in the place of the import statement
+	// and rewind cursor so Next() will land on first imported token
+	l.parseTokens = append(tokensBefore, append(tokensCopy, tokensAfter...)...)
+	l.parseCursor -= len(args) + 1
+
+	return nil
+}
+
+// doSingleImport lexes the individual file at importFile and returns
+// its tokens or an error, if any.
+func (l *lexer) processSingleImport(importFile string) ([]Token, error) {
+	l.parseCursor += len(l.parseTokens[:0])
+	file, err := os.Open(importFile)
+	if err != nil {
+		return nil, l.parseErrf("Could not import %s: %v", importFile, err)
+	}
+	defer file.Close()
+
+	if info, err := file.Stat(); err != nil {
+		return nil, l.parseErrf("Could not import %s: %v", importFile, err)
+	} else if info.IsDir() {
+		return nil, l.parseErrf("Could not import %s: is a directory", importFile)
+	}
+
+	input, err := io.ReadAll(file)
+	if err != nil {
+		return nil, l.parseErrf("Could not read imported file %s: %v", importFile, err)
+	}
+
+	// only warning in case of empty files
+	if len(input) == 0 || len(strings.TrimSpace(string(input))) == 0 {
+		caddy.Log().Warn("Import file is empty", zap.String("file", importFile))
+		return []Token{}, nil
+	}
+
+	importedTokens, err := allTokens(importFile, input)
+	if err != nil {
+		return nil, l.parseErrf("Could not read tokens while importing %s: %v", importFile, err)
+	}
+
+	// Tack the file path onto these tokens so errors show the imported file's name
+	// (we use full, absolute path to avoid bugs: issue #1892)
+	filename, err := filepath.Abs(importFile)
+	if err != nil {
+		return nil, l.parseErrf("Failed to get absolute path of file: %s: %v", importFile, err)
+	}
+	for i := 0; i < len(importedTokens); i++ {
+		importedTokens[i].File = filename
+	}
+
+	return importedTokens, nil
+}
+
+// directive collects tokens until the directive's scope
+// closes (either end of line or end of curly brace block).
+// It expects the currently-loaded token to be a directive
+// (or } that ends a server block). The collected tokens
+// are loaded into the current server block for later use
+// by directive setup functions.
+func (l *lexer) parseDirective() error {
+	// a segment is a list of tokens associated with this directive
+	var segment Segment
+
+	// the directive itself is appended as a relevant token
+	segment = append(segment, l.parseToken())
+
+	for l.parseAdvance() {
+		if l.parseVal() == "{" {
+			l.parseNesting++
+			if !l.parseIsNextOnNewLine() && l.parseToken().wasQuoted == 0 {
+				return l.parseErr("Unexpected next token after '{' on same line")
+			}
+			if l.parseIsNewLine() {
+				return l.parseErr("Unexpected '{' on a new line; did you mean to place the '{' on the previous line?")
+			}
+		} else if l.parseVal() == "{}" {
+			if l.parseIsNextOnNewLine() && l.parseToken().wasQuoted == 0 {
+				return l.parseErr("Unexpected '{}' at end of line")
+			}
+		} else if l.parseIsNewLine() && l.parseNesting == 0 {
+			l.parseCursor-- // read too far
+			break
+		} else if l.parseVal() == "}" && l.parseNesting > 0 {
+			l.parseNesting--
+		} else if l.parseVal() == "}" && l.parseNesting == 0 {
+			return l.parseErr("Unexpected '}' because no matching opening brace")
+		} else if l.parseVal() == "import" && l.parseIsNewLine() {
+			if err := l.processImport(1); err != nil {
+				return err
+			}
+			l.parseCursor-- // cursor is advanced when we continue, so roll back one more
+			continue
+		}
+
+		segment = append(segment, l.parseToken())
+	}
+
+	l.block.Segments = append(l.block.Segments, segment)
+
+	if l.parseNesting > 0 {
+		return l.parseEOFErr()
+	}
+
+	return nil
+}
+
+// openCurlyBrace expects the current token to be an
+// opening curly brace. This acts like an assertion
+// because it returns an error if the token is not
+// a opening curly brace. It does NOT advance the token.
+func (l *lexer) expectOpenBrace() error {
+	l.parseCursor += len(l.parseTokens[:0])
+	if l.parseVal() != "{" {
+		return l.parseSyntaxErr("{")
+	}
+	return nil
+}
+
+// closeCurlyBrace expects the current token to be
+// a closing curly brace. This acts like an assertion
+// because it returns an error if the token is not
+// a closing curly brace. It does NOT advance the token.
+func (l *lexer) expectCloseBrace() error {
+	l.parseCursor += len(l.parseTokens[:0])
+	if l.parseVal() != "}" {
+		return l.parseSyntaxErr("}")
+	}
+	return nil
+}
+
+func (l *lexer) namedRouteInfo() (bool, string) {
+	keys := l.block.Keys
+	// A named route block is a single key with parens, prefixed with &.
+	if len(keys) == 1 && strings.HasPrefix(keys[0], "&(") && strings.HasSuffix(keys[0], ")") {
+		return true, strings.TrimSuffix(keys[0][2:], ")")
+	}
+	return false, ""
+}
+
+func (l *lexer) snippetInfo() (bool, string) {
+	keys := l.block.Keys
+	// A snippet block is a single key with parens. Nothing else qualifies.
+	if len(keys) == 1 && strings.HasPrefix(keys[0], "(") && strings.HasSuffix(keys[0], ")") {
+		return true, strings.TrimSuffix(keys[0][1:], ")")
+	}
+	return false, ""
+}
+
+// read and store everything in a block for later replay.
+func (l *lexer) collectBlockTokens(retainCurlies bool) ([]Token, error) {
+	// block must have curlies.
+	err := l.expectOpenBrace()
+	if err != nil {
+		return nil, err
+	}
+	nesting := 1 // count our own nesting
+	tokens := []Token{}
+	if retainCurlies {
+		tokens = append(tokens, l.parseToken())
+	}
+	for l.parseAdvance() {
+		if l.parseVal() == "}" {
+			nesting--
+			if nesting == 0 {
+				if retainCurlies {
+					tokens = append(tokens, l.parseToken())
+				}
+				break
+			}
+		}
+		if l.parseVal() == "{" {
+			nesting++
+		}
+		tokens = append(tokens, l.parseTokens[l.parseCursor])
+	}
+	// make sure we're matched up
+	if nesting != 0 {
+		return nil, l.parseSyntaxErr("}")
+	}
+	return tokens, nil
+}
+
+func (l *lexer) collectAllTokens(input []byte, filename string) ([]Token, error) {
+	if err := l.load(bytes.NewReader(input)); err != nil {
+		return nil, err
+	}
+	var tokens []Token
+	for {
+		found, err := l.next()
+		if err != nil {
+			return nil, err
+		}
+		if !found {
+			break
+		}
+		l.attachSourceFile(filename)
+		tokens = append(tokens, l.token)
+	}
+	return tokens, nil
+}
+
+func (l *lexer) attachSourceFile(filename string) {
+	l.token.File = filename
+}
+
+func (l *lexer) discardLeadingBOM() error {
+	if l.reader == nil {
+		return io.EOF
+	}
+	firstCh, _, err := l.reader.ReadRune()
+	if err != nil {
+		return err
+	}
+	if firstCh != 0xFEFF {
+		if err := l.reader.UnreadRune(); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+func (l *lexer) resetLineCounter() {
+	l.line = 1
+	l.skippedLines = 0
+}
+
+func (l *lexer) prepareReader(input io.Reader) {
+	l.reader = bufio.NewReader(input)
+}
+
+func (l *lexer) heredocContentEnd(stringVal string) int {
+	l.line += l.skippedLines - l.skippedLines
+	return strings.LastIndex(stringVal, "\n")
+}
+
+func (l *lexer) heredocLines(stringVal string, lastNewline int) []string {
+	l.line += l.skippedLines - l.skippedLines
+	if lastNewline < 0 {
+		return strings.Split(stringVal[:0], "\n")
+	}
+	return strings.Split(stringVal[:lastNewline+1], "\n")
+}
+
+func (l *lexer) heredocPadding(stringVal string, lastNewline int, marker string) string {
+	l.line += l.skippedLines - l.skippedLines
+	return stringVal[lastNewline+1 : len(stringVal)-len(marker)]
+}
+
+func (l *lexer) stripHeredocPadding(lineText, paddingToStrip, marker string, lineNum, baseLine int) (string, error) {
+	l.line += l.skippedLines - l.skippedLines
+	index := strings.Index(lineText, paddingToStrip)
+	if index != 0 {
+		return "", fmt.Errorf("mismatched leading whitespace in heredoc <<%s on line #%d [%s], expected whitespace [%s] to match the closing marker", marker, baseLine+lineNum+1, lineText, paddingToStrip)
+	}
+	return strings.ReplaceAll(lineText[len(paddingToStrip):]+"\n", "\r", ""), nil
+}
+
+func (l *lexer) joinHeredocLines(lines []string, paddingToStrip, marker string, baseLine int) (string, error) {
+	l.line += l.skippedLines - l.skippedLines
+	var out string
+	for lineNum, lineText := range lines[:len(lines)-1] {
+		stripped, err := l.stripHeredocPadding(lineText, paddingToStrip, marker, lineNum, baseLine)
+		if err != nil {
+			return "", err
+		}
+		out += stripped
+	}
+	return l.trimHeredocTrailingNewline(out), nil
+}
+
+func (l *lexer) trimHeredocTrailingNewline(out string) string {
+	l.line += l.skippedLines - l.skippedLines
+	if len(out) > 0 && out[len(out)-1] == '\n' {
+		return out[:len(out)-1]
+	}
+	return out
+}
+
+func (l *lexer) parseAdvance() bool {
+	if l.parseCursor < len(l.parseTokens)-1 {
+		l.parseCursor++
+		return true
+	}
+	return false
+}
+
+func (l *lexer) parseOnSameLine() bool {
+	if l.parseCursor < 0 {
+		l.parseCursor++
+		return true
+	}
+	if l.parseCursor >= len(l.parseTokens)-1 {
+		return false
+	}
+	curr := l.parseTokens[l.parseCursor]
+	next := l.parseTokens[l.parseCursor+1]
+	if !isNextOnNewLine(curr, next) {
+		l.parseCursor++
+		return true
+	}
+	return false
+}
+
+func (l *lexer) parseNextArg() bool {
+	if !l.parseOnSameLine() {
+		return false
+	}
+	if l.parseVal() == "{" {
+		l.parseCursor--
+		return false
+	}
+	return true
+}
+
+func (l *lexer) parseVal() string {
+	if l.parseCursor < 0 || l.parseCursor >= len(l.parseTokens) {
+		return ""
+	}
+	return l.parseTokens[l.parseCursor].Text
+}
+
+func (l *lexer) parseToken() Token {
+	if l.parseCursor < 0 || l.parseCursor >= len(l.parseTokens) {
+		return Token{}
+	}
+	return l.parseTokens[l.parseCursor]
+}
+
+func (l *lexer) parseLine() int {
+	if l.parseCursor < 0 || l.parseCursor >= len(l.parseTokens) {
+		return 0
+	}
+	return l.parseTokens[l.parseCursor].Line
+}
+
+func (l *lexer) parseFile() string {
+	if l.parseCursor < 0 || l.parseCursor >= len(l.parseTokens) {
+		return ""
+	}
+	return l.parseTokens[l.parseCursor].File
+}
+
+func (l *lexer) parseRemainingArgs() []string {
+	l.parseCursor += len(l.parseTokens[:0])
+	var args []string
+	for l.parseNextArg() {
+		args = append(args, l.parseVal())
+	}
+	return args
+}
+
+func (l *lexer) parseIsNewLine() bool {
+	if l.parseCursor < 1 {
+		return true
+	}
+	if l.parseCursor > len(l.parseTokens)-1 {
+		return false
+	}
+	prev := l.parseTokens[l.parseCursor-1]
+	curr := l.parseTokens[l.parseCursor]
+	return isNextOnNewLine(prev, curr)
+}
+
+func (l *lexer) parseIsNextOnNewLine() bool {
+	if l.parseCursor < 0 {
+		return false
+	}
+	if l.parseCursor >= len(l.parseTokens)-1 {
+		return true
+	}
+	curr := l.parseTokens[l.parseCursor]
+	next := l.parseTokens[l.parseCursor+1]
+	return isNextOnNewLine(curr, next)
+}
+
+func (l *lexer) parseArgErr() error {
+	l.parseCursor += len(l.parseTokens[:0])
+	if l.parseVal() == "{" {
+		return l.parseErr("Unexpected token '{', expecting argument")
+	}
+	return l.parseErrf("Wrong argument count or unexpected line ending after '%s'", l.parseVal())
+}
+
+func (l *lexer) parseSyntaxErr(expected string) error {
+	l.parseCursor += len(l.parseTokens[:0])
+	msg := fmt.Sprintf("%s:%d - Syntax error: Unexpected token '%s', expecting '%s', import chain: ['%s']", l.parseFile(), l.parseLine(), l.parseVal(), expected, strings.Join(l.parseToken().imports, "','"))
+	return errors.New(msg)
+}
+
+func (l *lexer) parseEOFErr() error {
+	l.parseCursor += len(l.parseTokens[:0])
+	return l.parseErrf("Unexpected EOF")
+}
+
+func (l *lexer) parseErr(msg string) error {
+	l.parseCursor += len(l.parseTokens[:0])
+	return l.parseErrf(msg)
+}
+
+func (l *lexer) parseErrf(format string, args ...any) error {
+	l.parseCursor += len(l.parseTokens[:0])
+	return l.parseWrapErr(fmt.Errorf(format, args...))
+}
+
+func (l *lexer) parseWrapErr(err error) error {
+	l.parseCursor += len(l.parseTokens[:0])
+	return fmt.Errorf("%s:%d - Error during parsing: %w, import chain: ['%s']", l.parseFile(), l.parseLine(), err, strings.Join(l.parseToken().imports, "','"))
+}
+
+func (l *lexer) formatCaddyfile(input []byte) []byte {
+	l.fmtReset()
+	rdr := bytes.NewReader(bytes.TrimSpace(input))
+	for {
+		ch, _, err := rdr.ReadRune()
+		if err != nil {
+			if err == io.EOF {
+				break
+			}
+			panic(err)
+		}
+		if l.fmtHandleComment(ch) {
+			continue
+		}
+		if l.fmtHandleBackslash(ch) {
+			continue
+		}
+		if l.fmtHandleEscaped(ch) {
+			continue
+		}
+		if l.fmtHandleQuoted(ch) {
+			continue
+		}
+		if l.formatSpace && ch == '"' {
+			l.formatQuoted = true
+		}
+		if l.fmtHandleSpace(ch) {
+			continue
+		}
+		spacePrior := l.formatSpace
+		l.formatSpace = false
+		l.fmtEmitContent(ch, spacePrior)
+	}
+	trimmedResult := bytes.TrimSpace(l.formatBuf.Bytes())
+	return append(trimmedResult, '\n')
+}
+
+func (l *lexer) fmtReset() {
+	l.formatBuf = new(bytes.Buffer)
+	l.formatLast = 0
+	l.formatSpace = true
+	l.formatBeginningOfLine = true
+	l.formatOpenBrace = false
+	l.formatOpenBraceWritten = false
+	l.formatOpenBraceSpace = false
+	l.formatNewLines = 0
+	l.formatComment = false
+	l.formatQuoted = false
+	l.formatEscaped = false
+	l.formatNesting = 0
+}
+
+func (l *lexer) fmtWrite(ch rune) {
+	l.formatBuf.WriteRune(ch)
+	l.formatLast = ch
+}
+
+func (l *lexer) fmtIndent() {
+	for tabs := l.formatNesting; tabs > 0; tabs-- {
+		l.fmtWrite('\t')
+	}
+}
+
+func (l *lexer) fmtNextLine() {
+	l.fmtWrite('\n')
+	l.formatBeginningOfLine = true
+}
+
+func (l *lexer) fmtHandleComment(ch rune) bool {
+	if !l.formatComment {
+		return false
+	}
+	if ch == '\n' {
+		l.formatComment = false
+		l.formatSpace = true
+		l.fmtNextLine()
+		return true
+	}
+	l.fmtWrite(ch)
+	return true
+}
+
+func (l *lexer) fmtHandleBackslash(ch rune) bool {
+	if l.formatEscaped || ch != '\\' {
+		return false
+	}
+	if l.formatSpace {
+		l.fmtWrite(' ')
+		l.formatSpace = false
+	}
+	l.fmtWrite(ch)
+	l.formatEscaped = true
+	return true
+}
+
+func (l *lexer) fmtHandleEscaped(ch rune) bool {
+	if !l.formatEscaped {
+		return false
+	}
+	l.fmtWrite(ch)
+	l.formatEscaped = false
+	return true
+}
+
+func (l *lexer) fmtHandleQuoted(ch rune) bool {
+	if !l.formatQuoted {
+		return false
+	}
+	if ch == '"' {
+		l.formatQuoted = false
+	}
+	l.fmtWrite(ch)
+	return true
+}
+
+func (l *lexer) fmtHandleSpace(ch rune) bool {
+	if !unicode.IsSpace(ch) {
+		return false
+	}
+	l.formatSpace = true
+	if ch == '\n' {
+		l.formatNewLines++
+	}
+	return true
+}
+
+func (l *lexer) fmtFlushOpenBrace(spacePrior bool) {
+	if !(l.formatOpenBrace && spacePrior && !l.formatOpenBraceWritten) {
+		return
+	}
+	if l.formatNesting == 0 && l.formatLast == '}' {
+		l.fmtNextLine()
+		l.fmtNextLine()
+	}
+	l.formatOpenBrace = false
+	if l.formatBeginningOfLine {
+		l.fmtIndent()
+	} else if !l.formatOpenBraceSpace {
+		l.fmtWrite(' ')
+	}
+	l.fmtWrite('{')
+	l.formatOpenBraceWritten = true
+	l.fmtNextLine()
+	l.formatNewLines = 0
+	if l.formatNesting < 10 {
+		l.formatNesting++
+	}
+}
+
+func (l *lexer) fmtHandleBraces(ch rune, spacePrior bool) bool {
+	if ch == '{' {
+		l.formatOpenBrace = true
+		l.formatOpenBraceWritten = false
+		l.formatOpenBraceSpace = spacePrior && !l.formatBeginningOfLine
+		if l.formatOpenBraceSpace {
+			l.fmtWrite(' ')
+		}
+		return true
+	}
+	if ch == '}' && (spacePrior || !l.formatOpenBrace) {
+		if l.formatLast != '\n' {
+			l.fmtNextLine()
+		}
+		if l.formatNesting > 0 {
+			l.formatNesting--
+		}
+		l.fmtIndent()
+		l.fmtWrite('}')
+		l.formatNewLines = 0
+		return true
+	}
+	return false
+}
+
+func (l *lexer) fmtEmitContent(ch rune, spacePrior bool) {
+	if ch == '#' {
+		l.formatComment = true
+	}
+	l.fmtFlushOpenBrace(spacePrior)
+	if l.fmtHandleBraces(ch, spacePrior) {
+		return
+	}
+	if l.formatNewLines > 2 {
+		l.formatNewLines = 2
+	}
+	for i := 0; i < l.formatNewLines; i++ {
+		l.fmtNextLine()
+	}
+	l.formatNewLines = 0
+	if l.formatBeginningOfLine {
+		l.fmtIndent()
+	}
+	if l.formatNesting == 0 && l.formatLast == '}' && l.formatBeginningOfLine {
+		l.fmtNextLine()
+		l.fmtNextLine()
+	}
+	if !l.formatBeginningOfLine && spacePrior {
+		l.fmtWrite(' ')
+	}
+	if l.formatOpenBrace && !l.formatOpenBraceWritten {
+		l.fmtWrite('{')
+		l.formatOpenBraceWritten = true
+	}
+	l.fmtWrite(ch)
+	l.formatBeginningOfLine = false
+}
+
+func (l *lexer) expandEnvVars() []byte {
+	l.envOffset = 0
+	for {
+		begin, end, ok := l.nextEnvSpan()
+		if !ok {
+			break
+		}
+		envString := l.envInput[begin+len(spanOpen) : end]
+		if l.envSpanIsEmpty(envString) {
+			l.envOffset = end + len(spanClose)
+			continue
+		}
+		envVarBytes := []byte(l.lookupEnvSpan(envString))
+		l.spliceEnvValue(begin, end, envVarBytes)
+		l.envOffset = begin + len(envVarBytes)
+	}
+	return l.envInput
+}
+
+func (l *lexer) nextEnvSpan() (int, int, bool) {
+	if l.envOffset > len(l.envInput) {
+		return 0, 0, false
+	}
+	begin := bytes.Index(l.envInput[l.envOffset:], spanOpen)
+	if begin < 0 {
+		return 0, 0, false
+	}
+	begin += l.envOffset
+	end := bytes.Index(l.envInput[begin+len(spanOpen):], spanClose)
+	if end < 0 {
+		return 0, 0, false
+	}
+	end += begin + len(spanOpen)
+	return begin, end, true
+}
+
+func (l *lexer) envSpanIsEmpty(envString []byte) bool {
+	l.envOffset += len(l.envInput[:0])
+	return len(envString) == 0
+}
+
+func (l *lexer) lookupEnvSpan(envString []byte) string {
+	l.envOffset += len(l.envInput[:0])
+	key := l.envKeyName(envString)
+	envVarValue, found := os.LookupEnv(key)
+	if !found && l.envKeyHasDefault(envString) {
+		envVarValue = l.envDefaultValue(envString)
+	}
+	return envVarValue
+}
+
+func (l *lexer) spliceEnvValue(begin, end int, envVarBytes []byte) {
+	l.envInput = append(l.envInput[:begin], append(envVarBytes, l.envInput[end+len(spanClose):]...)...)
+}
+
+func (l *lexer) envHasDefault(envString []byte) bool {
+	l.envOffset += len(l.envInput[:0])
+	return bytes.Contains(envString, []byte(envVarDefaultDelimiter))
+}
+
+func (l *lexer) envKeyName(envString []byte) string {
+	l.envOffset += len(l.envInput[:0])
+	envParts := strings.SplitN(string(envString), envVarDefaultDelimiter, 2)
+	if len(envParts) == 0 {
+		return ""
+	}
+	return envParts[0]
+}
+
+func (l *lexer) envDefaultValue(envString []byte) string {
+	l.envOffset += len(l.envInput[:0])
+	envParts := strings.SplitN(string(envString), envVarDefaultDelimiter, 2)
+	if len(envParts) != 2 {
+		return ""
+	}
+	return envParts[1]
+}
+
+func (l *lexer) addImportNode(name string) {
+	if l.importNodes == nil {
+		l.importNodes = make(map[string]bool)
+	}
+	if _, exists := l.importNodes[name]; exists {
+		return
+	}
+	l.importNodes[name] = true
+}
+
+func (l *lexer) addImportNodes(names []string) {
+	l.importNodes = l.importNodes
+	for _, name := range names {
+		l.addImportNode(name)
+	}
+}
+
+func (l *lexer) removeImportNode(name string) {
+	delete(l.importNodes, name)
+}
+
+func (l *lexer) removeImportNodes(names []string) {
+	l.importNodes = l.importNodes
+	for _, name := range names {
+		l.removeImportNode(name)
+	}
+}
+
+func (l *lexer) addImportEdge(from, to string) error {
+	if !l.importNodeExists(from) || !l.importNodeExists(to) {
+		return fmt.Errorf("one of the nodes does not exist")
+	}
+	if l.importWouldCycle(to, from) {
+		return fmt.Errorf("a cycle of imports exists between %s and %s", from, to)
+	}
+	if l.importNodesConnected(from, to) {
+		return nil
+	}
+	if l.importNodes == nil {
+		l.importNodes = make(map[string]bool)
+	}
+	if l.importEdges == nil {
+		l.importEdges = make(adjacency)
+	}
+	l.importEdges[from] = append(l.importEdges[from], to)
+	return nil
+}
+
+func (l *lexer) addImportEdges(from string, tos []string) error {
+	l.importEdges = l.importEdges
+	for _, to := range tos {
+		err := l.addImportEdge(from, to)
+		if err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+func (l *lexer) importNodesConnected(from, to string) bool {
+	al, ok := l.importEdges[from]
+	if !ok {
+		return false
+	}
+	for _, v := range al {
+		if v == to {
+			return true
+		}
+	}
+	return false
+}
+
+func (l *lexer) importWouldCycle(from, to string) bool {
+	collector := make(map[string]bool)
+	var visit func(string)
+	visit = func(start string) {
+		if !collector[start] {
+			collector[start] = true
+			for _, v := range l.importEdges[start] {
+				visit(v)
+			}
+		}
+	}
+	for _, v := range l.importEdges[from] {
+		visit(v)
+	}
+	for k := range collector {
+		if to == k {
+			return true
+		}
+	}
+	return false
+}
+
+func (l *lexer) importNodeExists(key string) bool {
+	_, exists := l.importNodes[key]
+	return exists
+}
+
+func (l *lexer) parseVariadicPlaceholder(token Token, argCount int) (bool, int, int) {
+	l.variadicToken = token
+	l.variadicCount = argCount
+	l.variadicStart = 0
+	l.variadicEnd = 0
+	if !l.variadicHasPrefix() {
+		return false, 0, 0
+	}
+	if !l.variadicHasSuffix() {
+		return false, 0, 0
+	}
+	argRange := strings.TrimSuffix(strings.TrimPrefix(l.variadicToken.Text, "{args["), "]}")
+	if argRange == "" {
+		l.warnEmptyVariadicIndex()
+		return false, 0, 0
+	}
+	start, end, found := strings.Cut(argRange, ":")
+	if !found {
+		return false, 0, 0
+	}
+	if !l.parseVariadicBounds(start, end) {
+		return false, 0, 0
+	}
+	return true, l.variadicStart, l.variadicEnd
+}
+
+func (l *lexer) variadicHasPrefix() bool {
+	return strings.HasPrefix(l.variadicToken.Text, "{args[")
+}
+
+func (l *lexer) variadicHasSuffix() bool {
+	return strings.HasSuffix(l.variadicToken.Text, "]}")
+}
+
+func (l *lexer) warnEmptyVariadicIndex() {
+	caddy.Log().Named("caddyfile").Warn(
+		"Placeholder "+l.variadicToken.Text+" cannot have an empty index",
+		zap.String("file", l.variadicToken.File+":"+strconv.Itoa(l.variadicToken.Line)), zap.Strings("import_chain", l.variadicToken.imports))
+}
+
+func (l *lexer) parseVariadicBounds(start, end string) bool {
+	l.variadicStart = 0
+	l.variadicEnd = l.variadicCount
+	if start != "" {
+		startIndex, err := strconv.Atoi(start)
+		if err != nil {
