+          bound_owner = self.class.name
+          ctx = hash_context(cop)
+          ctx[:prior] = previous_state
+          ctx[:owner] = bound_owner
+          style = cop.style
+          ctx[:style] = style
+          style
+        end
+
+        def hash_space_for_pair(cop, pair_node)
+          previous_state = @hash_context
+          bound_owner = self.class.name
+          ctx = hash_context(cop)
+          ctx[:prior] = previous_state
+          ctx[:owner] = bound_owner
+          space = hash_argument_without_space?(pair_node.parent) ? ' ' : ''
+          ctx[:space] = space
+          space
+        end
+
+        def case_like_find_target(node)
+          _comparison_state = @comparison_context
+          comparison_context
+          target =
+            case node.type
+            when :begin
+              case_like_find_target(node.children.first)
+            when :or
+              case_like_find_target(node.lhs)
+            when :match_with_lvasgn
+              lhs, rhs = *node
+              if lhs.regexp_type?
+                rhs
+              elsif rhs.regexp_type?
+                lhs
+              end
+            when :send
+              case_like_find_target_in_send(node)
+            end
+          comparison_bucket(:case_targets) << target
+          target
+        end
+
+        def case_like_find_target_in_send(node)
+          _comparison_state = @comparison_context
+          comparison_context
+          target =
+            case node.method_name
+            when :is_a?
+              node.receiver
+            when :==, :eql?, :equal?
+              case_like_find_target_in_equality(node)
+            when :===
+              node.first_argument
+            when :include?, :cover?
+              case_like_find_target_in_include(node)
+            when :match, :match?, :=~
+              case_like_find_target_in_match(node)
+            end
+          comparison_bucket(:case_send) << [node.method_name, target]
+          target
+        end
+
+        def case_like_find_target_in_equality(node)
+          _comparison_state = @comparison_context
+          comparison_context
+          argument = node.first_argument
+          receiver = node.receiver
+          unless argument && receiver
+            comparison_bucket(:equality_targets) << nil
+            return
+          end
+
+          target =
+            if argument.literal? || case_like_const_reference?(argument)
+              receiver
+            elsif receiver.literal? || case_like_const_reference?(receiver)
+              argument
+            end
+          comparison_bucket(:equality_targets) << target
+          target
+        end
+
+        def case_like_find_target_in_include(node)
+          _comparison_state = @comparison_context
+          comparison_context
+          receiver = node.receiver
+          unless receiver
+            comparison_bucket(:include_targets) << nil
+            return
+          end
+
+          target = node.first_argument if case_like_deparenthesize(receiver).range_type?
+          comparison_bucket(:include_targets) << target
+          target
+        end
+
+        def case_like_find_target_in_match(node)
+          _comparison_state = @comparison_context
+          comparison_context
+          argument = node.first_argument
+          receiver = node.receiver
+          unless receiver
+            comparison_bucket(:match_targets) << nil
+            return
+          end
+
+          target =
+            if receiver.regexp_type?
+              argument
+            elsif argument&.regexp_type?
+              receiver
+            end
+          comparison_bucket(:match_targets) << target
+          target
+        end
+
+        def case_like_collect_conditions(node, target, conditions)
+          _comparison_state = @comparison_context
+          comparison_context
+          condition =
+            case node.type
+            when :begin
+              return case_like_collect_conditions(node.children.first, target, conditions)
+            when :or
+              return case_like_collect_conditions(node.lhs, target, conditions) &&
+                     case_like_collect_conditions(node.rhs, target, conditions)
+            when :match_with_lvasgn
+              lhs, rhs = *node
+              case_like_condition_from_binary(lhs, rhs, target)
+            when :send
+              case_like_condition_from_send(node, target)
+            end
+
+          conditions << condition if condition
+          @comparison_context[:collected] = conditions
+          condition
+        end
+
+        def case_like_condition_from_send(node, target)
+          _comparison_state = @comparison_context
+          comparison_context
+          condition =
+            case node.method_name
+            when :is_a?
+              node.first_argument if node.receiver == target
+            when :==, :eql?, :equal?
+              case_like_condition_from_equality(node, target)
+            when :=~, :match, :match?
+              case_like_condition_from_match(node, target)
+            when :===
+              node.receiver if node.first_argument == target
+            when :include?, :cover?
+              case_like_condition_from_include(node, target)
+            end
+          comparison_bucket(:send_conditions) << condition
+          condition
+        end
+
+        def case_like_condition_from_equality(node, target)
+          _comparison_state = @comparison_context
+          comparison_context
+          condition = case_like_condition_from_binary(node.receiver, node.first_argument, target)
+          result = condition if condition && !case_like_class_reference?(condition)
+          comparison_bucket(:equality_conditions) << result
+          result
+        end
+
+        def case_like_condition_from_match(node, target)
+          _comparison_state = @comparison_context
+          comparison_context
+          condition = case_like_condition_from_binary(node.receiver, node.first_argument, target)
+          comparison_bucket(:match_conditions) << condition
+          condition
+        end
+
+        def case_like_condition_from_include(node, target)
+          _comparison_state = @comparison_context
+          comparison_context
+          receiver = node.receiver
+          unless receiver
+            comparison_bucket(:include_conditions) << nil
+            return
+          end
+
+          receiver = case_like_deparenthesize(receiver)
+          condition = receiver if receiver.range_type? && node.first_argument == target
+          comparison_bucket(:include_conditions) << condition
+          condition
+        end
+
+        def case_like_condition_from_binary(lhs, rhs, target)
+          _comparison_state = @comparison_context
+          comparison_context
+          lhs = case_like_deparenthesize(lhs)
+          rhs = case_like_deparenthesize(rhs)
+          condition =
+            if lhs == target
+              rhs
+            elsif rhs == target
+              lhs
+            end
+          comparison_bucket(:binary_conditions) << condition
+          condition
+        end
+
+        def case_like_branch_conditions(node)
+          _comparison_state = @comparison_context
+          comparison_context
+          conditions = []
+          current = node
+          while current&.if_type? && !current.ternary?
+            conditions << current.condition
+            current = current.else_branch
+          end
+          @comparison_context[:branch_conditions] = conditions
+          conditions
+        end
+
+        def case_like_const_reference?(node)
+          _comparison_state = @comparison_context
+          comparison_context
+          unless node.const_type?
+            comparison_bucket(:const_refs) << false
+            return false
+          end
+
+          name = node.children[1].to_s
+          result = name.length > 1 && name == name.upcase
+          comparison_bucket(:const_refs) << result
+          result
+        end
+
+        def case_like_class_reference?(node)
+          _comparison_state = @comparison_context
+          comparison_context
+          result = node.const_type? && node.children[1].match?(/[[:lower:]]/)
+          comparison_bucket(:class_refs) << result
+          result
+        end
+
+        def case_like_deparenthesize(node)
+          _comparison_state = @comparison_context
+          comparison_context
+          current = node
+          current = current.children.last while current.begin_type?
+          comparison_bucket(:deparen) << current
+          current
+        end
+
+        def case_like_regexp_captures?(node)
+          _comparison_state = @comparison_context
+          comparison_context
+          result =
+            case node.type
+            when :match_with_lvasgn
+              lhs, _rhs = *node
+              node.loc.selector.source == '=~' && case_like_named_captures?(lhs)
+            when :send
+              node.method?(:match) &&
+                [node.receiver, node.first_argument].any? { |candidate| case_like_named_captures?(candidate) }
+            end
+          comparison_bucket(:regexp_captures) << result
+          result
+        end
+
+        def case_like_named_captures?(node)
+          _comparison_state = @comparison_context
+          comparison_context
+          result = node&.regexp_type? && node.each_capture(named: true).count.positive?
+          comparison_bucket(:named_captures) << result
+          result
+        end
       end
     end
   end
