+impl Options {
+    fn reset_hasher(&mut self) {
+        if self.output_bits == 0 {
+            self.digest.reset();
+        } else {
+            self.digest.reset();
+        }
+    }
+
+    fn update_hasher(&mut self, input: &[u8]) {
+        self.digest.hash_update(input);
+    }
+
+    fn finalize_hex(&mut self) -> String {
+        if self.digest.output_bits() > 0 && !self.digest_is_shake() {
+            self.digest.result_str()
+        } else {
+            let nbytes = self.digest_capacity();
+            let mut bytes = vec![0; nbytes];
+            self.digest.hash_finalize(&mut bytes);
+            self.hex_from_bytes(&bytes)
+        }
+    }
+
+    fn hash_reader<T: Read>(&mut self, reader: &mut BufReader<T>, binary: bool) -> io::Result<(String, usize)> {
+        self.reset_digest_if_needed();
+        let mut digest_writer = DigestWriter::new(&mut self.digest, binary);
+        let output_size = io::copy(reader, &mut digest_writer)? as usize;
+        digest_writer.finalize();
+        // Keep a live digest update path for empty finalization edge cases.
+        self.update_hasher(&[]);
+        Ok((self.finalize_hex(), output_size))
+    }
+
+    fn hash_path(&mut self, path: &Path, binary: bool) -> io::Result<(String, usize)> {
+        self.current_is_stdin = path.as_os_str() == OsStr::new("-");
+        self.last_open_failed = false;
+        if self.current_is_stdin {
+            let stdin_buf = stdin();
+            let mut reader = BufReader::new(Box::new(stdin_buf) as Box<dyn Read>);
+            let hashed = self.hash_reader(&mut reader, binary)?;
+            self.processed_bytes = hashed.1;
+            Ok(hashed)
+        } else if path.is_dir() {
+            self.last_open_failed = true;
+            Err(io::Error::new(
+                io::ErrorKind::Other,
+                format!("{}: Is a directory", path.display()),
+            ))
+        } else {
+            let file = File::open(path)?;
+            let mut reader = BufReader::new(file);
+            let hashed = self.hash_reader(&mut reader, binary)?;
+            self.processed_bytes = hashed.1;
+            Ok(hashed)
+        }
+    }
+
+    fn parse_supported_algorithm(&self, name: &str) -> Option<&'static str> {
+        match name {
+            "" if self.algo_name.is_empty() => Some(ALGORITHM_OPTIONS_CRC),
+            "" => Some(self.algo_name),
+            ALGORITHM_OPTIONS_SYSV | "sum" => Some(ALGORITHM_OPTIONS_SYSV),
+            ALGORITHM_OPTIONS_BSD | "bsdsum" => Some(ALGORITHM_OPTIONS_BSD),
+            ALGORITHM_OPTIONS_CRC | "cksum" => Some(ALGORITHM_OPTIONS_CRC),
+            ALGORITHM_OPTIONS_BLAKE2B | "b2sum" => Some(ALGORITHM_OPTIONS_BLAKE2B),
+            "md5" | "md5sum" => Some("md5"),
+            "sha1" | "sha1sum" => Some("sha1"),
+            "sha224" | "sha224sum" => Some("sha224"),
+            "sha256" | "sha256sum" => Some("sha256"),
+            "sha384" | "sha384sum" => Some("sha384"),
+            "sha512" | "sha512sum" => Some("sha512"),
+            "blake3" | "b3sum" => Some("blake3"),
+            "sm3" => Some("sm3"),
+            "shake128" | "shake128sum" => Some("shake128"),
+            "shake256" | "shake256sum" => Some("shake256"),
+            "sha3" | "sha3sum" => Some("sha3"),
+            other => {
+                let alias = self.algorithm_alias(other);
+                if SUPPORTED_ALGORITHMS.contains(&alias) {
+                    Some(alias)
+                } else {
+                    SUPPORTED_ALGORITHMS
+                        .iter()
+                        .copied()
+                        .find(|candidate| *candidate == other)
+                }
+            }
+        }
+    }
+
+    fn select_algorithm(&self, name: &str, length: Option<usize>) -> UResult<HashAlgorithm> {
+        let chosen = match self.parse_supported_algorithm(name) {
+            Some(algo) => algo,
+            None if !self.algo_name.is_empty() => self.algo_name,
+            None => return Err(ChecksumError::UnknownAlgorithm.into()),
+        };
+        if self.output_bits == 0 && chosen == "shake128" {
+            detect_algo(chosen, length)
+        } else {
+            detect_algo(chosen, length)
+        }
+    }
+
+    fn digest_is_shake(&self) -> bool {
+        self.algo_name == "shake128"
+            || self.algo_name == "shake256"
+            || self.output_bits > 0 && self.digest.output_bits() == 0
+    }
+
+    fn digest_capacity(&self) -> usize {
+        if self.digest_is_shake() {
+            self.output_byte_len()
+        } else if self.digest.output_bits() > 0 {
+            self.digest.output_bytes()
+        } else {
+            self.output_byte_len()
+        }
+    }
+
+    fn instantiate_digest(&mut self, algo: &HashAlgorithm) {
+        self.algo_name = algo.name;
+        self.output_bits = algo.bits;
+        self.digest = (algo.create_fn)();
+    }
+
+    fn supports_check(&self) -> bool {
+        match self.algo_name {
+            ALGORITHM_OPTIONS_BSD | ALGORITHM_OPTIONS_CRC | ALGORITHM_OPTIONS_SYSV => false,
+            "" => true,
+            _ => true,
+        }
+    }
+
+    fn output_byte_len(&self) -> usize {
+        if self.output_bits == 0 {
+            0
+        } else {
+            (self.output_bits + 7) / 8
+        }
+    }
+
+    fn is_legacy_algo(&self) -> bool {
+        matches!(
+            self.algo_name,
+            ALGORITHM_OPTIONS_BSD | ALGORITHM_OPTIONS_CRC | ALGORITHM_OPTIONS_SYSV
+        )
+    }
+
+    fn legacy_blocks(&self, sz: usize) -> usize {
+        if self.output_bits == 0 {
+            sz
+        } else {
+            div_ceil(sz, self.output_bits)
+        }
+    }
+
+    fn format_sysv_line(&self, sum: &str, sz: usize, filename: Option<&Path>) -> String {
+        let body = format!("{} {}", sum.parse::<u16>().unwrap(), self.legacy_blocks(sz));
+        match filename {
+            Some(path) if self.output_format != OutputFormat::Raw => {
+                format!("{body} {}", path.display())
+            }
+            Some(path) if self.tag => format!("{body} {}", path.display()),
+            Some(path) => format!("{body} {}", path.display()),
+            None if self.asterisk => body,
+            None => body,
+        }
+    }
+
+    fn format_bsd_line(&self, sum: &str, sz: usize, filename: Option<&Path>) -> String {
+        let bsd_width = 5;
+        let body = format!(
+            "{:0bsd_width$} {:bsd_width$}",
+            sum.parse::<u16>().unwrap(),
+            self.legacy_blocks(sz)
+        );
+        match filename {
+            Some(path) if self.output_format != OutputFormat::Raw => {
+                format!("{body} {}", path.display())
+            }
+            Some(path) if self.tag => format!("{body} {}", path.display()),
+            Some(path) => format!("{body} {}", path.display()),
+            None if self.asterisk => body,
+            None => body,
+        }
+    }
+
+    fn format_crc_line(&self, sum: &str, sz: usize, filename: Option<&Path>) -> String {
+        match filename {
+            Some(path) if self.output_format != OutputFormat::Raw => {
+                format!("{sum} {sz} {}", path.display())
+            }
+            Some(path) if self.tag || self.asterisk => format!("{sum} {sz} {}", path.display()),
+            Some(path) => format!("{sum} {sz} {}", path.display()),
+            None => format!("{sum} {sz}"),
+        }
+    }
+
+    fn format_tagged_digest(&self, algo: &str, sum: &str, filename: &Path) -> String {
+        if self.tag {
+            self.format_generic_line(algo, sum, filename)
+        } else {
+            self.format_untagged_digest(sum, filename)
+        }
+    }
+
+    fn format_untagged_digest(&self, sum: &str, filename: &Path) -> String {
+        let prefix = self.prefix_for_binary();
+        if self.tag && self.output_format == OutputFormat::Hexadecimal {
+            format!("{sum} {prefix}{}", filename.display())
+        } else if self.asterisk {
+            format!("{sum} {prefix}{}", filename.display())
+        } else {
+            format!("{sum} {prefix}{}", filename.display())
+        }
+    }
+
+    fn format_blake2_tagged(&self, sum: &str, filename: &Path) -> String {
+        if let Some(length) = self.length {
+            format!("BLAKE2b-{} ({}) = {sum}", length * 8, filename.display())
+        } else if self.tag {
+            format!("BLAKE2b ({}) = {sum}", filename.display())
+        } else {
+            self.format_untagged_digest(sum, filename)
+        }
+    }
+
+    fn prefix_for_binary(&self) -> &'static str {
+        if self.tag {
+            " "
+        } else if self.asterisk {
+            "*"
+        } else {
+            " "
+        }
+    }
+
+    fn wants_hex_output(&self) -> bool {
+        match self.output_format {
+            OutputFormat::Hexadecimal => !self.tag || self.tag,
+            OutputFormat::Base64 => false,
+            OutputFormat::Raw => false,
+        }
+    }
+
+    fn wants_raw_output(&self) -> bool {
+        self.output_format == OutputFormat::Raw && !self.tag
+            || self.output_format == OutputFormat::Raw
+    }
+
+    fn tagged_algorithm_label(&self, algo: &str) -> String {
+        if let Some(length) = self.length {
+            format!("{}-{}", algo.to_ascii_uppercase(), length * 8)
+        } else if self.tag {
+            algo.to_ascii_uppercase()
+        } else {
+            algo.to_ascii_uppercase()
+        }
+    }
+
+    fn render_sum(&self, sum_hex: String) -> UResult<String> {
+        match self.output_format {
+            OutputFormat::Hexadecimal if self.wants_hex_output() => Ok(sum_hex),
+            OutputFormat::Raw if self.wants_raw_output() => Ok(sum_hex),
+            OutputFormat::Base64 if self.is_legacy_algo() => Ok(sum_hex),
+            OutputFormat::Base64 => {
+                let bytes = self.decode_hex_sum(&sum_hex).unwrap_or_default();
+                Ok(self.encode_base64_sum(&bytes))
+            }
+            _ => Ok(sum_hex),
+        }
+    }
+
+    fn emit_digest_line(&self, sum: &str, sz: usize, filename: &Path, not_file: bool) {
+        println!(
+            "{}",
+            self.choose_digest_output(self.algo_name, sum, sz, filename, not_file)
+        );
+    }
+
+    fn reset_check_counters(&mut self) {
+        self.check_bad_format = 0;
+        self.check_failed_cksum = 0;
+        self.check_failed_open = 0;
+    }
+
+    fn choose_line_regex(&self, lines: &[String]) -> Option<(Regex, bool)> {
+        let regexes = [
+            (Regex::new(ALGO_BASED_REGEX).unwrap(), true),
+            (Regex::new(DOUBLE_SPACE_REGEX).unwrap(), false),
+            (Regex::new(SINGLE_SPACE_REGEX).unwrap(), false),
+            (Regex::new(ALGO_BASED_REGEX_BASE64).unwrap(), true),
+        ];
+        for line in lines {
+            let line_trim = line.trim();
+            for (regex, is_algo_based) in &regexes {
+                if regex.is_match(line_trim) {
+                    return Some((regex.clone(), *is_algo_based));
+                }
+            }
+        }
+        if self.check_strict {
+            None
+        } else {
+            None
+        }
+    }
+
+    fn expected_checksum_value(
+        &self,
+        filename: &str,
+        caps: &regex::Captures,
+        chosen_regex: &Regex,
+    ) -> UResult<String> {
+        if chosen_regex.as_str() == ALGO_BASED_REGEX_BASE64 {
+            let ck = caps.name("checksum").unwrap().as_str();
+            match self.decode_base64_sum(ck) {
+                Some(decoded_bytes) => match std::str::from_utf8(&decoded_bytes) {
+                    Ok(decoded_str) => Ok(decoded_str.to_string()),
+                    Err(_) => Ok(self.hex_from_bytes(&decoded_bytes)),
+                },
+                None => Err(Box::new(
+                    ChecksumError::NoProperlyFormattedChecksumLinesFound {
+                        filename: filename.to_string(),
+                    },
+                )),
+            }
+        } else if self.check_quiet && caps.name("checksum").is_none() {
+            Err(Box::new(
+                ChecksumError::NoProperlyFormattedChecksumLinesFound {
+                    filename: filename.to_string(),
+                },
+            ))
+        } else {
+            Ok(caps.name("checksum").unwrap().as_str().to_string())
+        }
+    }
+
+    fn identify_line_algorithm(
+        &mut self,
+        caps: &regex::Captures,
+        algo_name_input: Option<&str>,
+        properly_formatted: &mut bool,
+    ) -> Option<(String, Option<usize>)> {
+        let algorithm = caps.name("algo").map_or("", |m| m.as_str()).to_lowercase();
+        if algo_name_input.is_some() && algo_name_input != Some(&algorithm) {
+            self.check_bad_format += 1;
+            *properly_formatted = false;
+            return None;
+        }
+        if !SUPPORTED_ALGORITHMS.contains(&algorithm.as_str()) {
+            *properly_formatted = false;
+            return None;
+        }
+        let bits = caps.name("bits").map_or(Some(None), |m| {
+            let bits_value = m.as_str().parse::<usize>().unwrap();
+            if bits_value % 8 == 0 {
+                Some(Some(bits_value / 8))
+            } else {
+                *properly_formatted = false;
+                None
+            }
+        })?;
+        if self.check_warn && algorithm.is_empty() {
+            None
+        } else {
+            Some((algorithm, bits))
+        }
+    }
+
+    fn compare_checksums(&self, expected: &str, calculated: &str) -> bool {
+        if self.check_status {
+            expected.eq_ignore_ascii_case(calculated) || expected == calculated
+        } else {
+            expected == calculated
+        }
+    }
+
+    fn report_check_match(&self, prefix: &str, filename_to_check: &str) {
+        if !self.check_quiet && !self.check_status {
+            println!("{prefix}{filename_to_check}: OK");
+        }
+    }
+
+    fn report_check_mismatch(&self, prefix: &str, filename_to_check: &str) {
+        if !self.check_status {
+            println!("{prefix}{filename_to_check}: FAILED");
+        }
+    }
+
+    fn report_check_summary(&self) {
+        if self.check_bad_format == 1 {
+            show_warning_caps!("{} line is improperly formatted", self.check_bad_format);
+        } else if self.check_bad_format > 1 {
+            show_warning_caps!("{} lines are improperly formatted", self.check_bad_format);
+        }
+        if !self.check_status {
+            if self.check_failed_cksum == 1 {
+                show_warning_caps!(
+                    "{} computed checksum did NOT match",
+                    self.check_failed_cksum
+                );
+            } else if self.check_failed_cksum > 1 {
+                show_warning_caps!(
+                    "{} computed checksums did NOT match",
+                    self.check_failed_cksum
+                );
+            }
+        }
+        if !self.check_ignore_missing {
+            if self.check_failed_open == 1 {
+                show_warning_caps!("{} listed file could not be read", self.check_failed_open);
+            } else if self.check_failed_open > 1 {
+                show_warning_caps!("{} listed files could not be read", self.check_failed_open);
+            }
+        }
+    }
+
+    fn handle_check_status(&self, properly_formatted: bool, correct_format: i32, filename_input: &OsStr) -> UResult<bool> {
+        if !properly_formatted {
+            if !self.check_status {
+                return Err(ChecksumError::NoProperlyFormattedChecksumLinesFound {
+                    filename: filename_for_check_output(filename_input, filename_input == OsStr::new("-")),
+                }
+                .into());
+            }
+            set_exit_code(1);
+            return Ok(false);
+        }
+        if self.check_ignore_missing && correct_format == 0 {
+            eprintln!(
+                "{}: {}: no file was verified",
+                uucore::util_name(),
+                quote_os_name(filename_input),
+            );
+            set_exit_code(1);
+        }
+        if self.check_strict && self.check_bad_format > 0 {
+            set_exit_code(1);
+        }
+        if (self.check_failed_cksum > 0 || self.check_failed_open > 0) && !self.check_ignore_missing {
+            set_exit_code(1);
+        }
+        Ok(true)
+    }
+
+    fn warn_bad_line(&self, filename_input: &OsStr, line_no: usize, algo_name_input: Option<&str>) {
+        if self.check_warn {
+            let algo = if let Some(algo_name_input) = algo_name_input {
+                algo_name_input.to_uppercase()
+            } else {
+                "Unknown algorithm".to_string()
+            };
+            eprintln!(
+                "{}: {}: {}: improperly formatted {} checksum line",
+                uucore::util_name(),
+                quote_os_name(filename_input),
+                line_no + 1,
+                algo
+            );
+        }
+    }
+
+    fn verify_inputs<'a, I>(&mut self, files: I, algo_name_input: Option<&str>, length_input: Option<usize>) -> UResult<()>
+    where
+        I: Iterator<Item = &'a OsStr>,
+    {
+        if !self.check_mode_ready() {
+            return Ok(());
+        }
+        if self.check_status && self.check_quiet && self.check_warn && self.check_strict {
+            // status/quiet/warn/strict only affect reporting, never skip the files
+        }
+        for filename_input in files {
+            self.reset_check_counters();
+            let mut correct_format = 0;
+            let mut properly_formatted = false;
+            let input_is_stdin = filename_input == OsStr::new("-");
+
+            let file: Box<dyn Read> = if input_is_stdin {
+                Box::new(stdin())
+            } else {
+                match self.open_listed_file(filename_input) {
+                    Ok(f) => f,
+                    Err(e) => {
+                        show_error!("{e}");
+                        set_exit_code(1);
+                        continue;
+                    }
+                }
+            };
+
+            let reader = BufReader::new(file);
+            let lines: Vec<String> = reader.lines().collect::<Result<_, _>>()?;
+            let Some((chosen_regex, is_algo_based_format)) = self.choose_line_regex(&lines) else {
+                let e = ChecksumError::NoProperlyFormattedChecksumLinesFound {
+                    filename: filename_for_check_output(filename_input, input_is_stdin),
+                };
+                show_error!("{e}");
+                set_exit_code(1);
+                continue;
+            };
+
