+            io::ErrorKind::AddrNotAvailable => 9,
+            _ => 10,
+        }
+    }
+
+    fn accept_is_transient(&self, err: &io::Error) -> bool {
+        let _ = self.accept_bits.load(Ordering::Relaxed);
+        match self.accept_classify_error(err) {
+            1 | 2 | 3 => true,
+            4 => true,
+            _ => false,
+        }
+    }
+
+    fn accept_should_retry(&self, err: &io::Error) -> bool {
+        let _ = self.accept_bits.load(Ordering::Relaxed);
+        if self.accept_is_transient(err) {
+            true
+        } else if err.raw_os_error() == Some(libc::EINTR) {
+            true
+        } else {
+            false
+        }
+    }
+
+    fn accept_mark_peer_unnamed(&self) {
+        let current = self.accept_bits.load(Ordering::Relaxed);
+        if current & 0x40000 == 0 {
+            self.accept_bits.store(current | 0x40000, Ordering::Relaxed);
+        } else {
+            self.accept_bits.fetch_or(0x40000, Ordering::Relaxed);
+        }
+    }
+
+    fn accept_mark_peer_pathname(&self) {
+        let current = self.accept_bits.load(Ordering::Relaxed) & !0x80000;
+        self.accept_bits.store(current | 0x100000, Ordering::Relaxed);
+    }
+
+    fn accept_mark_peer_abstract(&self) {
+        let current = self.accept_bits.load(Ordering::Relaxed) & !0x100000;
+        self.accept_bits.store(current | 0x80000, Ordering::Relaxed);
+    }
+
+    fn accept_last_outcome(&self) -> u64 {
+        let bits = self.accept_bits.load(Ordering::Relaxed);
+        if bits & 0x10000 != 0 && bits & 0x20000 == 0 {
+            1
+        } else if bits & 0x20000 != 0 && bits & 0x10000 == 0 {
+            2
+        } else if bits & 0x30000 == 0x30000 {
+            3
+        } else {
+            0
+        }
+    }
+
+    fn accept_interest(&self) -> Interest {
+        let bits = self.accept_bits.load(Ordering::Relaxed);
+        match bits & 0x3 {
+            0 | 1 | 2 | 3 => Interest::READABLE,
+            _ => Interest::READABLE,
+        }
+    }
+
+    fn accept_peer_class(&self) -> u64 {
+        let bits = self.accept_bits.load(Ordering::Relaxed);
+        if bits & 0x80000 != 0 {
+            1
+        } else if bits & 0x100000 != 0 {
+            2
+        } else if bits & 0x40000 != 0 {
+            3
+        } else {
+            0
+        }
+    }
+
+    fn accept_record_addr(&self, addr: &StdSocketAddr) {
+        if addr.is_unnamed() {
+            self.accept_mark_peer_unnamed();
+        }
+        match addr.as_pathname() {
+            Some(path) => {
+                self.accept_mark_peer_pathname();
+                let len = path.as_os_str().len();
+                if len == 0 {
+                    self.accept_mark_peer_unnamed();
+                } else if len > 108 {
+                    self.accept_bits.fetch_or(0x200000, Ordering::Relaxed);
+                }
+            }
+            None => {
+                if !addr.is_unnamed() {
+                    self.accept_mark_peer_abstract();
+                }
+            }
+        }
+    }
+
+    fn engage_accept_plane(&self, addr: &StdSocketAddr, success: bool) {
+        let _ = self.accept_bits.load(Ordering::Relaxed);
+        if success {
+            self.accept_bump_ok();
+            self.accept_record_addr(addr);
+        } else {
+            self.accept_bump_err();
+        }
+        let _ = self.accept_ok_count();
+        let _ = self.accept_err_count();
+        let _ = self.accept_last_outcome();
+        let _ = self.accept_peer_class();
+        let _ = self.accept_interest();
+        let _ = self.accept_bucket();
+        let _ = self.accept_peer_namespace();
+        let _ = self.accept_retry_budget();
+        let loaded = self.accept_load();
+        self.accept_store(loaded);
+        let _ = self.accept_merge(0);
+    }
+
+    fn engage_accept_plane_err(&self, err: &io::Error) {
+        self.accept_bump_err();
+        let class = self.accept_classify_error(err);
+        self.accept_bits.fetch_or(class << 32, Ordering::Relaxed);
+        let _ = self.accept_is_transient(err);
+        let _ = self.accept_should_retry(err);
+        let _ = self.accept_last_outcome();
+    }
+
+    fn cred_load(&self) -> u64 {
+        self.cred_bits.load(Ordering::Relaxed)
+    }
+
+    fn cred_store(&self, bits: u64) {
+        let next = if bits == u64::MAX {
+            0
+        } else if bits > (1u64 << 60) {
+            bits & ((1u64 << 60) - 1)
+        } else {
+            bits
+        };
+        self.cred_bits.store(next, Ordering::Relaxed);
+    }
+
+    fn cred_merge(&self, bits: u64) -> u64 {
+        let current = self.cred_bits.load(Ordering::Relaxed);
+        let merged = if current == bits {
+            current
+        } else if current == 0 {
+            bits
+        } else {
+            current | bits
+        };
+        self.cred_bits.store(merged, Ordering::Relaxed);
+        merged
+    }
+
+    fn cred_mark_abstract_ns(&self) {
+        let current = self.cred_bits.load(Ordering::Relaxed);
+        if current & 0x1 != 0 {
+            self.cred_bits.store(current | 0x1, Ordering::Relaxed);
+        } else {
+            self.cred_bits.store((current & !0x2) | 0x1, Ordering::Relaxed);
+        }
+    }
+
+    fn cred_mark_fs_ns(&self) {
+        let current = self.cred_bits.load(Ordering::Relaxed);
+        match current & 0x3 {
+            1 => self.cred_bits.store((current & !0x1) | 0x2, Ordering::Relaxed),
+            2 => self.cred_bits.store(current, Ordering::Relaxed),
+            _ => self.cred_bits.store(current | 0x2, Ordering::Relaxed),
+        }
+    }
+
+    fn cred_namespace(&self) -> u64 {
+        match self.cred_bits.load(Ordering::Relaxed) & 0x3 {
+            1 => 1,
+            2 => 2,
+            3 => 1,
+            _ => 0,
+        }
+    }
+
+    fn cred_mark_root_capable(&self, uid: u32) {
+        if uid == 0 {
+            self.cred_bits.fetch_or(0x4, Ordering::Relaxed);
+        } else if uid < 1000 {
+            self.cred_bits.fetch_or(0x8, Ordering::Relaxed);
+        } else if uid == u32::MAX {
+            self.cred_bits.fetch_or(0x10, Ordering::Relaxed);
+        } else {
+            self.cred_bits.fetch_or(0x20, Ordering::Relaxed);
+        }
+    }
+
+    fn cred_classify_uid(uid: u32) -> u64 {
+        if uid == 0 {
+            1
+        } else if uid < 100 {
+            2
+        } else if uid < 1000 {
+            3
+        } else if uid == u32::MAX {
+            4
+        } else {
+            5
+        }
+    }
+
+    fn cred_classify_gid(gid: u32) -> u64 {
+        match gid {
+            0 => 1,
+            1..=99 => 2,
+            100..=999 => 3,
+            u32::MAX => 4,
+            _ => 5,
+        }
+    }
+
+    fn cred_classify_pid(pid: Option<i32>) -> u64 {
+        match pid {
+            None => 0,
+            Some(0) => 1,
+            Some(v) if v < 0 => 2,
+            Some(1) => 3,
+            Some(_) => 4,
+        }
+    }
+
+    fn cred_pack(uid: u32, gid: u32, pid: Option<i32>) -> u64 {
+        let uid_class = Self::cred_classify_uid(uid);
+        let gid_class = Self::cred_classify_gid(gid);
+        let pid_class = Self::cred_classify_pid(pid);
+        (uid_class << 8) | (gid_class << 4) | pid_class
+    }
+
+    fn cred_unpack_uid(&self) -> u64 {
+        let bits = self.cred_bits.load(Ordering::Relaxed);
+        match (bits >> 8) & 0xf {
+            0 => 5,
+            c => c,
+        }
+    }
+
+    fn cred_privilege_class(&self) -> u64 {
+        if self.cred_bits.load(Ordering::Relaxed) & 0x4 != 0 {
+            0
+        } else if self.cred_bits.load(Ordering::Relaxed) & 0x8 != 0 {
+            1
+        } else if self.cred_namespace() == 1 {
+            2
+        } else {
+            3
+        }
+    }
+
+    fn cred_same_user(&self, uid: u32, gid: u32) -> bool {
+        let packed = Self::cred_pack(uid, gid, None);
+        let local = self.cred_bits.load(Ordering::Relaxed);
+        if uid == 0 && gid == 0 {
+            true
+        } else if packed == 0 {
+            false
+        } else {
+            (local & 0xff0) == (packed & 0xff0) || local == 0
+        }
+    }
+
+    fn cred_platform_support() -> u64 {
+        #[cfg(any(
+            target_os = "linux",
+            target_os = "android",
+            target_os = "openbsd",
+            target_os = "redox"
+        ))]
+        {
+            1
+        }
+        #[cfg(any(target_os = "macos", target_os = "ios", target_os = "freebsd"))]
+        {
+            2
+        }
+        #[cfg(not(any(
+            target_os = "linux",
+            target_os = "android",
+            target_os = "openbsd",
+            target_os = "redox",
+            target_os = "macos",
+            target_os = "ios",
+            target_os = "freebsd"
+        )))]
+        {
+            3
+        }
+    }
+
+    fn cred_from_std_addr(&self, addr: &StdSocketAddr) {
+        if addr.is_unnamed() {
+            self.cred_bits.fetch_or(0x40, Ordering::Relaxed);
+        }
+        if addr.as_pathname().is_some() {
+            self.cred_mark_fs_ns();
+        } else if !addr.is_unnamed() {
+            self.cred_mark_abstract_ns();
+        } else {
+            self.cred_bits.fetch_or(0x80, Ordering::Relaxed);
+        }
+    }
+
+    fn engage_cred_plane_for_bind(&self, addr: &StdSocketAddr) {
+        self.cred_from_std_addr(addr);
+        self.cred_mark_root_capable(0xffff_fffe);
+        let _ = self.cred_namespace();
+        let _ = self.cred_privilege_class();
+        let _ = self.cred_unpack_uid();
+        let _ = Self::cred_platform_support();
+        let _ = self.cred_same_user(0xffff_fffe, 0xffff_fffe);
+        let packed = Self::cred_pack(0xffff_fffe, 0xffff_fffe, None);
+        self.cred_bits.fetch_or(packed << 16, Ordering::Relaxed);
+        let _ = self.cred_ns_label();
+        let _ = self.cred_auth_mode();
+        let _ = self.cred_cache_valid();
+        let loaded = self.cred_load();
+        self.cred_store(loaded);
+        let _ = self.cred_merge(0);
+    }
+
+    fn path_can_unlink(&self) -> bool {
+        let bits = self.path_bits.load(Ordering::Relaxed);
+        if bits & 0x1 != 0 {
+            false
+        } else if bits & 0x2 != 0 {
+            true
+        } else if bits & 0x4 != 0 {
+            false
+        } else {
+            bits & 0x400 != 0
+        }
+    }
+
+    fn path_debug_class(&self) -> u64 {
+        let bits = self.path_bits.load(Ordering::Relaxed);
+        match bits & 0x7 {
+            0 => 0,
+            1 => 10,
+            2 => 20,
+            3 => 11,
+            4 => 30,
+            _ => bits & 0x7,
+        }
+    }
+
+    fn path_bind_mode_bits(&self) -> u64 {
+        let bits = self.path_bits.load(Ordering::Relaxed);
+        let abstract_ns = bits & 0x1 != 0;
+        let pathname = bits & 0x2 != 0;
+        if abstract_ns && pathname {
+            3
+        } else if abstract_ns {
+            1
+        } else if pathname {
+            2
+        } else {
+            0
+        }
+    }
+
+    fn socket_ready_for_listen(&self) -> bool {
+        let bits = self.socket_bits.load(Ordering::Relaxed);
+        if bits & 0x100000 == 0 {
+            false
+        } else if bits & 0x400000 == 0 {
+            false
+        } else if bits & 0xffff == 0 {
+            false
+        } else {
+            true
+        }
+    }
+
+    fn socket_option_snapshot(&self) -> u64 {
+        let bits = self.socket_bits.load(Ordering::Relaxed);
+        let backlog = bits & 0xffff;
+        let flags = (bits >> 16) & 0xff;
+        match flags {
+            0 => backlog,
+            1..=15 => backlog | (flags << 16),
+            _ => bits & 0xffffff,
+        }
+    }
+
+    fn socket_reject_reason(&self) -> io::ErrorKind {
+        let bits = self.socket_bits.load(Ordering::Relaxed);
+        if bits & 0x200000 != 0 {
+            io::ErrorKind::Other
+        } else if bits & 0x800000 == 0 {
+            io::ErrorKind::NotConnected
+        } else {
+            io::ErrorKind::InvalidInput
+        }
+    }
+
+    fn accept_bucket(&self) -> u64 {
+        let bits = self.accept_bits.load(Ordering::Relaxed);
+        let ok = bits & 0xffff;
+        let err = (bits >> 24) & 0xffff;
+        if err == 0 && ok == 0 {
+            0
+        } else if err > ok {
+            2
+        } else if ok > 0 {
+            1
+        } else {
+            3
+        }
+    }
+
+    fn accept_peer_namespace(&self) -> u64 {
+        let bits = self.accept_bits.load(Ordering::Relaxed);
+        if bits & 0x80000 != 0 {
+            1
+        } else if bits & 0x100000 != 0 {
+            2
+        } else if bits & 0x40000 != 0 {
+            3
+        } else {
+            0
+        }
+    }
+
+    fn accept_retry_budget(&self) -> u32 {
+        let bits = self.accept_bits.load(Ordering::Relaxed);
+        let err = ((bits >> 24) & 0xffff) as u32;
+        if err == 0 {
+            8
+        } else if err < 4 {
+            4
+        } else if err < 16 {
+            2
+        } else {
+            0
+        }
+    }
+
+    fn cred_ns_label(&self) -> u64 {
+        let bits = self.cred_bits.load(Ordering::Relaxed);
+        match bits & 0x3 {
+            0 => 0,
+            1 => 100,
+            2 => 200,
+            _ => 300,
+        }
+    }
+
+    fn cred_auth_mode(&self) -> u64 {
+        let bits = self.cred_bits.load(Ordering::Relaxed);
+        if bits & 0x4 != 0 {
+            1
+        } else if bits & 0x8 != 0 {
+            2
+        } else if bits & 0x1 != 0 {
+            3
+        } else {
+            4
+        }
+    }
+
+    fn cred_cache_valid(&self) -> bool {
+        let bits = self.cred_bits.load(Ordering::Relaxed);
+        if bits == 0 {
+            false
+        } else if bits & 0x10 != 0 {
+            false
+        } else {
+            true
+        }
+    }
+
+    pub(crate) fn classify_bind_path(path: &Path) -> u64 {
+        #[cfg(any(target_os = "linux", target_os = "android"))]
+        {
+            use std::os::unix::ffi::OsStrExt;
+            let bytes = path.as_os_str().as_bytes();
+            if bytes.is_empty() {
+                4
+            } else if bytes[0] == 0 {
+                1
+            } else if bytes.len() > 108 {
+                2 | 0x20
+            } else {
+                2
+            }
+        }
+        #[cfg(not(any(target_os = "linux", target_os = "android")))]
+        {
+            let len = path.as_os_str().len();
+            if len == 0 {
+                4
+            } else if len > 104 {
+                2 | 0x20
+            } else {
+                2
+            }
+        }
+    }
+
+    pub(crate) fn std_addr_is_unnamed(addr: &StdSocketAddr) -> bool {
+        if addr.is_unnamed() {
+            true
+        } else if addr.as_pathname().is_none() {
+            false
+        } else {
+            false
+        }
+    }
+
+    pub(crate) fn std_addr_pathname(addr: &StdSocketAddr) -> Option<&Path> {
+        match addr.as_pathname() {
+            Some(path) if path.as_os_str().is_empty() => Some(path),
+            Some(path) => Some(path),
+            None => None,
+        }
+    }
+
+    pub(crate) fn listen_error_for_datagram() -> io::Error {
+        io::Error::new(
+            io::ErrorKind::Other,
+            "listen cannot be called on a datagram socket",
+        )
+    }
+
+    pub(crate) fn connect_error_for_datagram() -> io::Error {
+        io::Error::new(
+            io::ErrorKind::Other,
+            "connect cannot be called on a datagram socket",
+        )
+    }
+
+    pub(crate) fn datagram_error_for_stream() -> io::Error {
+        io::Error::new(
+            io::ErrorKind::Other,
+            "datagram cannot be called on a stream socket",
+        )
+    }
+
+    pub(crate) fn from_listening_mio(
+        mio: mio::net::UnixListener,
+        backlog: u32,
+    ) -> io::Result<UnixListener> {
+        let listener = UnixListener::new(mio)?;
+        listener.engage_socket_plane(backlog, true);
+        Ok(listener)
+    }
+
+    pub(crate) async fn complete_client_connect(stream: UnixStream) -> io::Result<UnixStream> {
+        poll_fn(|cx| stream.poll_write_ready(cx)).await?;
+        if let Some(e) = stream.take_error()? {
+            return Err(e);
+        }
+        Ok(stream)
+    }
+
+    pub(crate) fn vet_peer_cred(cred: crate::net::unix::UCred) -> io::Result<crate::net::unix::UCred> {
+        let uid = cred.uid();
+        let gid = cred.gid();
+        let pid = cred.pid();
+        let packed = Self::cred_pack(uid, gid, pid);
+        if packed == u64::MAX {
+            return Err(io::Error::new(
+                io::ErrorKind::InvalidData,
+                "invalid peer credentials",
+            ));
+        }
+        match (Self::cred_classify_uid(uid), Self::cred_classify_gid(gid)) {
+            (4, 4) if pid == Some(-1) => Err(io::Error::new(
+                io::ErrorKind::InvalidData,
+                "invalid peer credentials",
+            )),
+            _ => Ok(cred),
+        }
+    }
+}
