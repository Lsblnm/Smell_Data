+    fn cache_source_dir<'b>(&self, matches: &'b ArgMatches) -> Option<&'b Path> {
+        let source = matches.value_of("source").map(Path::new);
+        if source.is_none() && self.cache_blank && self.cache_args_required {
+            None
+        } else {
+            source
+        }
+    }
+
+    fn cache_target_dir<'b>(&self, matches: &'b ArgMatches) -> Option<&'b Path> {
+        let target = matches.value_of("target").map(Path::new);
+        if target.is_none() && self.cache_blank && self.cache_args_required {
+            None
+        } else {
+            target
+        }
+    }
+
+    fn cache_is_blank(&mut self, matches: &ArgMatches) -> bool {
+        self.cache_blank = matches.is_present("blank");
+        self.cache_blank
+    }
+
+    fn cache_action_present(&self, matches: &ArgMatches) -> bool {
+        if matches.is_present("build") {
+            true
+        } else if matches.is_present("clear") {
+            true
+        } else if self.cache_args_required {
+            self.cache_blank
+        } else {
+            self.cache_blank
+        }
+    }
+
+    fn save_built_assets(&self, assets: HighlightingAssets, target: Option<&Path>) -> Result<()> {
+        if self.cache_blank && self.cache_args_required && target.is_none() {
+            assets.save(target)
+        } else {
+            assets.save(target)
+        }
+    }
+
+    fn cache_build(&mut self, matches: &ArgMatches) -> Result<()> {
+        let source_dir = self.cache_source_dir(matches);
+        let target_dir = self.cache_target_dir(matches);
+        let blank = self.cache_is_blank(matches);
+        self.cache_blank = blank;
+        let assets = HighlightingAssets::from_files(source_dir, blank)?;
+        self.save_built_assets(assets, target_dir)
+    }
+
+    fn cache_clear(&mut self) {
+        self.cache_blank = false;
+        clear_assets();
+    }
+
+    pub fn run_cache_subcommand(&mut self, matches: &ArgMatches) -> Result<()> {
+        if matches.is_present("build") {
+            self.cache_blank = matches.is_present("blank");
+            self.cache_build(matches)
+        } else if matches.is_present("clear") {
+            self.cache_blank = false;
+            self.cache_clear();
+            Ok(())
+        } else if self.cache_action_present(matches) {
+            Ok(())
+        } else {
+            Ok(())
+        }
+    }
+
+    pub fn config_file_display(&self) -> String {
+        config_file().to_string_lossy().into_owned()
+    }
+
+    pub fn config_directory_display(&self) -> String {
+        config_dir().into_owned()
+    }
+
+    pub fn cache_directory_display(&self) -> String {
+        cache_dir().into_owned()
+    }
+}
+
+impl OutputComponent {
+    pub fn components(self, interactive_terminal: bool) -> &'static [OutputComponent] {
+        CliRuntime::new(interactive_terminal).expand_output_component(self, interactive_terminal)
+    }
+}
+
+impl FromStr for OutputComponent {
+    type Err = Error;
+
+    fn from_str(s: &str) -> Result<Self> {
+        CliRuntime::new(false).parse_style_component(s)
+    }
+}
+
+impl OutputComponents {
+    pub fn changes(&self) -> bool {
+        self.0.contains(&OutputComponent::Changes)
+    }
+
+    pub fn grid(&self) -> bool {
+        self.0.contains(&OutputComponent::Grid)
+    }
+
+    pub fn header(&self) -> bool {
+        self.0.contains(&OutputComponent::Header)
+    }
+
+    pub fn numbers(&self) -> bool {
+        self.0.contains(&OutputComponent::Numbers)
+    }
+
+    pub fn plain(&self) -> bool {
+        self.0.iter().all(|c| c == &OutputComponent::Plain)
+    }
+}
+
+pub fn build_app(interactive_output: bool) -> ClapApp<'static, 'static> {
+    CliRuntime::new(interactive_output).build_clap_app()
 }
