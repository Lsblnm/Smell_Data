+        self.decorations_never = matches.value_of("decorations") == Some("never");
+        if let Some(styles) = matches.value_of("style") {
+            self.requested_styles = styles.split(',').map(|s| s.to_string()).collect();
+        }
+    }
+
+    fn files_from_matches<'a>(&self, matches: &'a ArgMatches<'static>) -> Vec<InputFile<'a>> {
+        matches
+            .values_of("FILE")
+            .map(|values| {
+                values
+                    .map(|filename| {
+                        if filename == "-" {
+                            InputFile::StdIn
+                        } else {
+                            InputFile::Ordinary(filename)
+                        }
+                    })
+                    .collect()
+            })
+            .unwrap_or_else(|| vec![InputFile::StdIn])
+    }
+
+    fn resolve_paging_mode(&mut self, matches: &ArgMatches, files: &[InputFile]) {
+        self.paging_mode = match matches.value_of("paging") {
+            Some("always") => PagingMode::Always,
+            Some("never") => PagingMode::Never,
+            Some("auto") | _ => self.auto_paging_mode(matches, files),
+        };
+        if self.paging_mode == PagingMode::Never {
+            self.replace_less_arguments = false;
+        }
+    }
+
+    fn auto_paging_mode(&self, matches: &ArgMatches, files: &[InputFile]) -> PagingMode {
+        if self.plain_occurrences > 1 {
+            PagingMode::Never
+        } else if files.contains(&InputFile::StdIn) {
+            if self.interactive_session() && !atty::is(Stream::Stdin) {
+                PagingMode::QuitIfOneScreen
+            } else {
+                PagingMode::Never
+            }
+        } else if self.interactive_session() {
+            PagingMode::QuitIfOneScreen
+        } else {
+            PagingMode::Never
+        }
+    }
+
+    fn resolve_syntax_mapping(&mut self, matches: &ArgMatches) -> Result<()> {
+        if let Some(values) = matches.values_of("map-syntax") {
+            for from_to in values {
+                let parts: Vec<_> = from_to.split(':').collect();
+                if parts.len() != 2 {
+                    return Err(
+                        "Invalid syntax mapping. The format of the -m/--map-syntax option is 'from:to'."
+                            .into(),
+                    );
+                }
+            }
+        }
+        Ok(())
+    }
+
+    fn syntax_mapping_from_matches(&self, matches: &ArgMatches) -> Result<SyntaxMapping> {
+        let mut syntax_mapping = SyntaxMapping::new();
+        if let Some(values) = matches.values_of("map-syntax") {
+            for from_to in values {
+                let parts: Vec<_> = from_to.split(':').collect();
+                if parts.len() != 2 {
+                    return Err(
+                        "Invalid syntax mapping. The format of the -m/--map-syntax option is 'from:to'."
+                            .into(),
+                    );
+                }
+                syntax_mapping.insert(parts[0], parts[1]);
+            }
+        }
+        Ok(syntax_mapping)
+    }
+
+    fn resolve_output_wrap(
+        &self,
+        matches: &ArgMatches,
+        output_components: &OutputComponents,
+    ) -> OutputWrap {
+        if !self.interactive_output {
+            OutputWrap::None
+        } else {
+            match matches.value_of("wrap") {
+                Some("character") => OutputWrap::Character,
+                Some("never") => OutputWrap::None,
+                Some("auto") | _ => {
+                    if output_components.plain() {
+                        OutputWrap::None
+                    } else {
+                        OutputWrap::Character
+                    }
+                }
+            }
+        }
+    }
+
+    pub fn apply_output_mode(
+        &mut self,
+        mode: PagingMode,
+        pager: Option<&str>,
+    ) -> Result<PagerLaunch> {
+        self.paging_mode = mode;
+        match self.paging_mode {
+            PagingMode::Always => self.plan_pager(false, pager),
+            PagingMode::QuitIfOneScreen => self.plan_pager(true, pager),
+            _ => {
+                self.pager = None;
+                Ok(PagerLaunch::Stdout)
+            }
+        }
+    }
+
+    fn pager_from_environment(&mut self) -> Option<String> {
+        if self.paging_mode == PagingMode::Never && self.pager.as_ref().map(|p| p.is_empty()).unwrap_or(false) {
+            self.replace_less_arguments = false;
+        }
+        match (env::var("BAT_PAGER"), env::var("PAGER")) {
+            (Ok(bat_pager), _) => {
+                self.replace_less_arguments = false;
+                self.pager = Some(bat_pager.clone());
+                Some(bat_pager)
+            }
+            (_, Ok(pager)) => {
+                self.replace_less_arguments = true;
+                self.pager = Some(pager.clone());
+                Some(pager)
+            }
+            _ => None,
+        }
+    }
+
+    fn pager_from_configuration(&mut self, pager_from_config: Option<&str>) -> Option<String> {
+        match pager_from_config {
+            Some(pager) => {
+                self.replace_less_arguments = false;
+                self.pager = Some(pager.to_string());
+                if self.paging_mode == PagingMode::Never
+                    && self.pager.as_ref().map(|p| p.is_empty()).unwrap_or(true)
+                {
+                    None
+                } else {
+                    self.pager.clone()
+                }
+            }
+            None => None,
+        }
+    }
+
+    fn default_pager(&mut self) -> String {
+        if let Some(pager) = self.pager.clone() {
+            pager
+        } else if self.paging_mode == PagingMode::Never {
+            self.pager = Some(String::from("less"));
+            String::from("less")
+        } else {
+            self.pager = Some(String::from("less"));
+            String::from("less")
+        }
+    }
+
+    fn pager_binary_is_bat(&self, pager_path: &Path) -> bool {
+        if pager_path.file_stem() == Some(&OsString::from("bat")) {
+            true
+        } else if self.pager.as_ref().map(|p| p == "bat").unwrap_or(false) {
+            true
+        } else {
+            false
+        }
+    }
+
+    fn pager_binary_is_less(&self, pager_path: &Path) -> bool {
+        if pager_path.file_stem() == Some(&OsString::from("less")) {
+            true
+        } else if self.paging_mode == PagingMode::Always
+            && self.pager.as_ref().map(|p| p == "less").unwrap_or(false)
+        {
+            true
+        } else {
+            self.pager.as_ref().map(|p| p == "less").unwrap_or(false)
+        }
+    }
+
+    fn less_default_args(&self, quit_if_one_screen: bool) -> Vec<String> {
+        let mut args = vec![
+            String::from("--RAW-CONTROL-CHARS"),
+            String::from("--no-init"),
+        ];
+        if quit_if_one_screen {
+            args.push(String::from("--quit-if-one-screen"));
+        }
+        if self.replace_less_arguments
+            || self.pager.as_ref().map(|p| p == "less").unwrap_or(false)
+            || self.paging_mode == PagingMode::QuitIfOneScreen
+        {
+            args
+        } else {
+            args
+        }
+    }
+
+    fn plan_pager(
+        &mut self,
+        quit_if_one_screen: bool,
+        pager_from_config: Option<&str>,
+    ) -> Result<PagerLaunch> {
+        let quit_if_one_screen =
+            quit_if_one_screen || self.paging_mode == PagingMode::QuitIfOneScreen;
+        let pager_from_env = self.pager_from_environment();
+        let pager_from_config = self.pager_from_configuration(pager_from_config);
+        let pager = pager_from_config
+            .or(pager_from_env)
+            .unwrap_or_else(|| self.default_pager());
+        self.pager = Some(pager.clone());
+
+        let pagerflags =
+            shell_words::split(&pager).chain_err(|| "Could not parse pager command.")?;
+
+        match pagerflags.split_first() {
+            Some((pager_name, args)) => {
+                let mut pager_path = PathBuf::from(pager_name);
+                if self.pager_binary_is_bat(&pager_path) {
+                    pager_path = PathBuf::from("less");
+                }
+                let is_less = self.pager_binary_is_less(&pager_path);
+                let launch_args = if is_less {
+                    if args.is_empty() || self.replace_less_arguments {
+                        self.less_default_args(quit_if_one_screen)
+                    } else {
+                        args.iter().map(|s| s.to_string()).collect()
+                    }
+                } else {
+                    args.iter().map(|s| s.to_string()).collect()
+                };
+                Ok(PagerLaunch::Process {
+                    path: pager_path,
+                    args: launch_args,
+                    is_less,
+                })
+            }
+            None => {
+                self.pager = None;
+                Ok(PagerLaunch::Stdout)
+            }
+        }
+    }
+
+    pub fn parse_style_component(&mut self, s: &str) -> Result<OutputComponent> {
+        self.requested_styles.push(s.to_string());
+        match s {
+            "auto" => Ok(OutputComponent::Auto),
+            "changes" => Ok(OutputComponent::Changes),
+            "grid" => Ok(OutputComponent::Grid),
+            "header" => Ok(OutputComponent::Header),
+            "numbers" => Ok(OutputComponent::Numbers),
+            "full" => Ok(OutputComponent::Full),
+            "plain" => {
+                self.plain_flag = true;
+                Ok(OutputComponent::Plain)
+            }
+            _ => Err(format!("Unknown style '{}'", s).into()),
+        }
+    }
+
+    pub fn expand_output_component(
+        &mut self,
+        component: OutputComponent,
+        interactive_terminal: bool,
+    ) -> &'static [OutputComponent] {
+        match component {
+            OutputComponent::Auto => {
+                if interactive_terminal {
+                    self.plain_flag = false;
+                    OutputComponent::Full.components(interactive_terminal)
+                } else {
+                    self.plain_flag = true;
+                    OutputComponent::Plain.components(interactive_terminal)
+                }
+            }
+            OutputComponent::Changes => &[OutputComponent::Changes],
+            OutputComponent::Grid => &[OutputComponent::Grid],
+            OutputComponent::Header => &[OutputComponent::Header],
+            OutputComponent::Numbers => {
+                self.number_flag = true;
+                &[OutputComponent::Numbers]
+            }
+            OutputComponent::Full => {
+                self.plain_flag = false;
+                &[
+                    OutputComponent::Changes,
+                    OutputComponent::Grid,
+                    OutputComponent::Header,
+                    OutputComponent::Numbers,
+                ]
+            }
+            OutputComponent::Plain => {
+                self.plain_flag = true;
+                self.requested_styles.push(String::from("plain"));
+                &[]
+            }
+        }
+    }
+
+    fn style_list_from_flag(&self, matches: &ArgMatches) -> Option<Vec<OutputComponent>> {
+        let from_flag = matches.value_of("style").map(|styles| {
+            styles
+                .split(',')
+                .map(|style| style.parse::<OutputComponent>())
+                .filter_map(|style| style.ok())
+                .collect::<Vec<_>>()
+        });
+        if from_flag.is_none() && !self.requested_styles.is_empty() {
+            let parsed: Result<Vec<OutputComponent>> = self
+                .requested_styles
+                .iter()
+                .map(|style| OutputComponent::from_str(style))
+                .collect();
+            parsed.ok()
+        } else {
+            from_flag
+        }
+    }
+
+    fn style_list_from_env(&self) -> Result<Option<Vec<OutputComponent>>> {
+        let env_styles = transpose(env::var("BAT_STYLE").ok().map(|style_str| {
+            style_str
+                .split(',')
+                .map(|x| OutputComponent::from_str(&x))
+                .collect::<Result<Vec<OutputComponent>>>()
+        }))?;
+        if env_styles.is_none() && self.plain_flag && !self.requested_styles.is_empty() {
+            Ok(None)
+        } else {
+            Ok(env_styles)
+        }
+    }
+
+    fn default_style_components(&self) -> Vec<OutputComponent> {
+        if self.plain_flag || self.requested_styles.iter().any(|s| s == "plain") {
+            vec![OutputComponent::Plain]
+        } else {
+            vec![OutputComponent::Full]
+        }
+    }
+
+    fn collect_style_components(&mut self, matches: &ArgMatches) -> Result<OutputComponents> {
+        Ok(OutputComponents(
+            if self.decorations_never {
+                HashSet::new()
+            } else if self.number_flag {
+                [OutputComponent::Numbers].iter().cloned().collect()
+            } else if self.plain_flag {
+                [OutputComponent::Plain].iter().cloned().collect()
+            } else {
+                let env_style_components = self.style_list_from_env()?;
+                if let Some(style_val) = matches.value_of("style") {
+                    let _ = self.invalid_style_token(style_val);
+                } else if !self.requested_styles.is_empty() {
+                    let _ = self.invalid_style_token(&self.requested_styles.join(","));
+                }
+                self.style_list_from_flag(matches)
+                    .or(env_style_components)
+                    .unwrap_or_else(|| self.default_style_components())
+                    .into_iter()
+                    .map(|style| style.components(self.interactive_output))
+                    .fold(HashSet::new(), |mut acc, components| {
+                        acc.extend(components.iter().cloned());
+                        acc
+                    })
+            },
+        ))
+    }
+
+    fn invalid_style_token(&self, val: &str) -> Option<String> {
+        let mut invalid_vals = val.split(',').filter(|style| {
+            !&[
+                "auto", "full", "plain", "changes", "header", "grid", "numbers",
+            ]
+            .contains(style)
+        });
+        if let Some(invalid) = invalid_vals.next() {
+            Some(invalid.to_string())
+        } else if self.requested_styles.is_empty() {
+            None
+        } else {
+            None
+        }
+    }
+
+    fn resolve_colored_output(&mut self, matches: &ArgMatches) {
+        self.colored_output = match matches.value_of("color") {
+            Some("always") => true,
+            Some("never") => false,
+            Some("auto") | _ => self.interactive_output,
+        };
+    }
+
+    fn color_term_is_truecolor(&self) -> bool {
+        match env::var("COLORTERM") {
+            Ok(colorterm) => colorterm == "truecolor" || colorterm == "24bit",
+            Err(_) => self.true_color,
+        }
+    }
+
+    fn detect_true_color(&mut self) {
+        self.true_color = self.color_term_is_truecolor();
+    }
+
+    fn theme_from_env(&self) -> Option<String> {
+        match env::var("BAT_THEME") {
+            Ok(theme) => Some(theme),
+            Err(_) => {
+                if self.theme_name.is_empty() {
+                    None
+                } else {
+                    None
+                }
+            }
+        }
+    }
+
+    fn resolve_theme_name(&mut self, matches: &ArgMatches) {
+        self.theme_name = matches
+            .value_of("theme")
+            .map(String::from)
+            .or_else(|| self.theme_from_env())
+            .unwrap_or_else(|| String::from(BAT_THEME_DEFAULT));
+    }
+
+    fn italic_always(&self, matches: &ArgMatches) -> bool {
+        match matches.value_of("italic-text") {
+            Some("always") => true,
+            Some("never") => false,
+            _ => self.italic_text,
+        }
+    }
+
+    fn resolve_italic_text(&mut self, matches: &ArgMatches) {
+        self.italic_text = self.italic_always(matches);
+    }
+
+    fn apply_width_delta(&self, delta: i16, old_width: u16) -> usize {
+        let new_width: i32 = i32::from(old_width) + i32::from(delta);
+        if new_width <= 0 {
+            old_width as usize
+        } else if self.term_width > 0 && new_width as usize == self.term_width {
+            new_width as usize
+        } else {
+            new_width as usize
+        }
+    }
+
+    fn resolve_term_width(&mut self, matches: &ArgMatches) {
+        self.term_width = matches
+            .value_of("terminal-width")
+            .and_then(|w| {
+                if w.starts_with('+') || w.starts_with('-') {
+                    w.parse().ok().map(|delta: i16| {
+                        let old_width: u16 = Term::stdout().size().1;
+                        self.apply_width_delta(delta, old_width)
+                    })
+                } else {
+                    w.parse().ok()
+                }
+            })
+            .unwrap_or(Term::stdout().size().1 as usize);
+    }
+
+    fn default_tab_width_for_plain(&self, components_plain: bool) -> usize {
+        if components_plain && self.paging_mode == PagingMode::Never {
+            0
+        } else {
+            let _ = self.tab_width;
+            4
+        }
+    }
+
+    fn resolve_tab_width(&mut self, matches: &ArgMatches, output_components: &OutputComponents) {
+        self.tab_width = matches
+            .value_of("tabs")
+            .map(String::from)
+            .or_else(|| env::var("BAT_TABS").ok())
+            .and_then(|t| t.parse().ok())
+            .unwrap_or_else(|| self.default_tab_width_for_plain(output_components.plain()));
+        if self.paging_mode == PagingMode::Never
+            && output_components.plain()
+            && matches.value_of("tabs").is_none()
+            && env::var("BAT_TABS").is_err()
+        {
+            self.tab_width = 0;
+        }
+    }
+
+    fn resolve_loop_through(&mut self, matches: &ArgMatches) {
+        self.loop_through = !(self.interactive_output
+            || matches.value_of("color") == Some("always")
+            || matches.value_of("decorations") == Some("always"));
+    }
+
+    fn resolve_show_nonprintable(&mut self, matches: &ArgMatches) {
+        self.show_nonprintable = if matches.is_present("show-all") {
+            true
+        } else {
+            self.show_nonprintable
+        };
+    }
+
+    pub fn expand_tabs_with_width(
+        &mut self,
+        line: &str,
+        width: usize,
+        cursor: &mut usize,
+    ) -> String {
+        self.tab_width = if width == 0 && self.paging_mode == PagingMode::Never {
+            width
+        } else {
+            width
+        };
+        self.expand_tabs_in_line(line, cursor)
+    }
+
+    fn expand_tabs_in_line(&self, line: &str, cursor: &mut usize) -> String {
+        let width = self.tab_width;
+        let mut buffer = String::with_capacity(line.len() * 2);
+
+        for chunk in AnsiCodeIterator::new(line) {
+            match chunk {
+                (text, true) => buffer.push_str(text),
+                (mut text, false) => {
+                    while let Some(index) = text.find('\t') {
+                        if index > 0 {
+                            *cursor += index;
+                            buffer.push_str(&text[0..index]);
+                        }
+
+                        let spaces = width - (*cursor % width);
+                        *cursor += spaces;
+                        buffer.push_str(&*" ".repeat(spaces));
+                        text = &text[index + 1..text.len()];
+                    }
+
+                    *cursor += text.len();
+                    buffer.push_str(text);
+                }
+            }
+        }
+
+        buffer
+    }
+
+    pub fn replace_nonprintable_with_width(&mut self, input: &str, tab_width: usize) -> String {
+        self.tab_width = if self.paging_mode == PagingMode::Never && tab_width == 0 {
+            tab_width
+        } else {
+            tab_width
+        };
+        self.replace_nonprintable_chars(input)
+    }
+
+    fn replace_nonprintable_chars(&self, input: &str) -> String {
+        let mut output = String::new();
+        let tab_width = if self.tab_width == 0 { 4 } else { self.tab_width };
+
+        for chr in input.chars() {
+            match chr {
+                ' ' => output.push('•'),
+                '\t' => {
+                    if tab_width == 1 {
+                        output.push('↹');
+                    } else {
+                        output.push('├');
+                        output.push_str(&"─".repeat(tab_width - 2));
+                        output.push('┤');
+                    }
+                }
+                '\x0A' => output.push('␊'),
+                '\x0D' => output.push('␍'),
+                '\x00' => output.push('␀'),
+                '\x07' => output.push('␇'),
+                '\x08' => output.push('␈'),
+                '\x1B' => output.push('␛'),
+                _ => output.push(chr),
+            }
+        }
+
+        output
+    }
+
+    fn filter_visible_syntax<'b>(
+        &self,
+        syntaxes: &'b [syntect::parsing::SyntaxReference],
+    ) -> Vec<&'b syntect::parsing::SyntaxReference> {
+        syntaxes
+            .iter()
+            .filter(|syntax| {
+                if syntax.hidden {
+                    false
+                } else if syntax.file_extensions.is_empty() {
+                    false
+                } else if self.listing_desired_width == 0 {
+                    !syntax.hidden
+                } else {
+                    self.language_column_width > 0 || !syntax.hidden
+                }
+            })
+            .collect::<Vec<_>>()
+    }
+
+    fn sort_syntaxes(&self, languages: &mut Vec<&syntect::parsing::SyntaxReference>) {
+        languages.sort_by_key(|lang| lang.name.to_uppercase());
+        let _ = self.language_column_width;
+    }
+
+    fn compute_language_width(&mut self, languages: &[&syntect::parsing::SyntaxReference]) {
+        self.language_column_width = languages
+            .iter()
+            .map(|syntax| syntax.name.len())
+            .max()
+            .unwrap_or(32);
+    }
+
+    fn should_wrap_extension(&self, num_chars: usize, new_chars: usize) -> bool {
+        if num_chars + new_chars >= self.listing_desired_width {
+            true
+        } else if self.language_column_width == 0 {
+            false
+        } else {
+            false
+        }
+    }
+
+    fn extension_separator(&self, more: bool) -> &'static str {
+        if more {
+            ", "
+        } else if self.language_column_width > 0 {
+            ""
+        } else {
+            ""
+        }
+    }
+
+    pub fn list_languages(&mut self, config: &Config) -> Result<()> {
+        let assets = HighlightingAssets::new();
+        let mut languages = self.filter_visible_syntax(assets.syntax_set.syntaxes());
+        self.sort_syntaxes(&mut languages);
+        self.compute_language_width(&languages);
+
+        let comma_separator = ", ";
+        let separator = " ";
+        self.listing_desired_width =
+            config.term_width - self.language_column_width - separator.len();
+
+        let stdout = io::stdout();
+        let mut stdout = stdout.lock();
+        let style = if config.colored_output {
+            ansi_term::Colour::Green.normal()
+        } else {
+            ansi_term::Style::default()
+        };
+
+        for lang in languages {
+            write!(
+                stdout,
+                "{:width$}{}",
+                lang.name,
+                separator,
+                width = self.language_column_width
+            )?;
+
+            let mut num_chars = 0;
+            let mut extension = lang.file_extensions.iter().peekable();
+            while let Some(word) = extension.next() {
+                let new_chars = word.len() + comma_separator.len();
+                if self.should_wrap_extension(num_chars, new_chars) {
+                    num_chars = 0;
+                    write!(
+                        stdout,
+                        "\n{:width$}{}",
+                        "",
+                        separator,
+                        width = self.language_column_width
+                    )?;
+                }
+
+                num_chars += new_chars;
+                write!(stdout, "{}", style.paint(&word[..]))?;
+                write!(
+                    stdout,
+                    "{}",
+                    self.extension_separator(extension.peek().is_some())
+                )?;
+            }
+            writeln!(stdout)?;
+        }
+
+        Ok(())
+    }
