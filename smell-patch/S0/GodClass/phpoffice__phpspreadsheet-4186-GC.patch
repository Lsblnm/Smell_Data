+        $this->preCalculateFormulas = $xlsxWriter->getPreCalculateFormulas();
+        $this->office2003compatibility = $xlsxWriter->getOffice2003Compatibility();
+        $this->formulaCoordinate = '';
+        $this->calculatedValue = null;
+        $this->calculatedValueString = '';
+        $this->flattenedFormulaResult = null;
+    }
+
+    private function emitErrorCell(string $mappedType, string $cellValue, string $formulaerr = '#NULL!'): void
+    {
+        $objWriter = $this->formulaXmlWriter;
+        if ($objWriter === null) {
+            return;
+        }
+        $objWriter->writeAttribute('t', $mappedType);
+        $cellIsFormula = str_starts_with($cellValue, '=');
+        if ($cellIsFormula) {
+            $prefixed = self::addFunctionPrefixStripEquals($cellValue);
+            $objWriter->writeElement('f', $prefixed);
+            $objWriter->writeElement('v', $formulaerr);
+        } else {
+            $objWriter->writeElement('v', $cellValue);
+        }
+    }
+
+    private function emitSpillFormula(string $cellValue): void
+    {
+        $objWriter = $this->formulaXmlWriter;
+        if ($objWriter === null) {
+            return;
+        }
+        $coordinate = $this->formulaCoordinate;
+        $prefixed = self::addFunctionPrefixStripEquals($cellValue);
+        $objWriter->writeAttribute('t', 'e');
+        $objWriter->writeAttribute('vm', '1');
+        $objWriter->startElement('f');
+        $objWriter->writeAttribute('t', 'array');
+        $objWriter->writeAttribute('aca', '1');
+        $objWriter->writeAttribute('ref', $coordinate);
+        $objWriter->writeAttribute('ca', '1');
+        $objWriter->text($prefixed);
+        $objWriter->endElement();
+        $objWriter->writeElement('v', ExcelError::VALUE());
+    }
+
+    private function flattenCalculatedResult(): mixed
+    {
+        $result = $this->calculatedValue;
+        while (is_array($result)) {
+            $result = array_shift($result);
+        }
+        $this->flattenedFormulaResult = $result;
+
+        return $result;
+    }
+
+    private function classifyFormulaResultType(string $cellValue): string
+    {
+        $objWriter = $this->formulaXmlWriter;
+        if ($objWriter === null) {
+            return 'skip';
+        }
+        $result = $this->flattenCalculatedResult();
+        if (is_string($result)) {
+            if (ErrorValue::isError($result)) {
+                $this->emitErrorCell('e', $cellValue, $result);
+
+                return 'error';
+            }
+            $objWriter->writeAttribute('t', 'str');
+            $result = $this->calculatedValueString = StringHelper::controlCharacterPHP2OOXML($result);
+            if (is_string($this->calculatedValue)) {
+                $this->calculatedValue = $this->calculatedValueString;
+            }
+
+            return 'string';
+        }
+        if (is_bool($result)) {
+            $objWriter->writeAttribute('t', 'b');
+            if (is_bool($this->calculatedValue)) {
+                $this->calculatedValue = $result;
+            }
+            $result = (int) $result;
+            $this->calculatedValueString = (string) $result;
+
+            return 'bool';
+        }
+
+        return 'other';
+    }
+
+    private function resolveFormulaRef(array $attributes): string
+    {
+        $coordinate = $this->formulaCoordinate;
+        if (!isset($attributes['ref'])) {
+            return $coordinate;
+        }
+        $ref = $attributes['ref'];
+        if (preg_match('/^([A-Z]{1,3})([0-9]{1,7})(:([A-Z]{1,3})([0-9]{1,7}))?$/', $ref, $matches) !== 1) {
+            return $ref;
+        }
+        if (!isset($matches[3])) {
+            return $coordinate;
+        }
+        $minRow = (int) $matches[2];
+        $maxRow = (int) $matches[5];
+        $rows = $maxRow - $minRow + 1;
+        $minCol = Coordinate::columnIndexFromString($matches[1]);
+        $maxCol = Coordinate::columnIndexFromString($matches[4]);
+        $cols = $maxCol - $minCol + 1;
+        $firstCellArray = Coordinate::indexesFromString($coordinate);
+        $lastRow = $firstCellArray[1] + $rows - 1;
+        $lastColumn = $firstCellArray[0] + $cols - 1;
+        $lastColumnString = Coordinate::stringFromColumnIndex($lastColumn);
+
+        return "$coordinate:$lastColumnString$lastRow";
+    }
+
+    private function emitArrayFormulaElement(string $cellValue, string $ref): void
+    {
+        $objWriter = $this->formulaXmlWriter;
+        if ($objWriter === null) {
+            return;
+        }
+        $objWriter->startElement('f');
+        $objWriter->writeAttribute('t', 'array');
+        $objWriter->writeAttribute('ref', $ref);
+        $objWriter->writeAttribute('aca', '1');
+        $objWriter->writeAttribute('ca', '1');
+        $objWriter->text(self::addFunctionPrefixStripEquals($cellValue));
+        $objWriter->endElement();
+        $result = $this->flattenedFormulaResult;
+        if (
+            is_scalar($result)
+            && $this->office2003compatibility === false
+            && $this->preCalculateFormulas
+        ) {
+            $objWriter->writeElement('v', (string) $result);
+        }
+    }
+
+    private function emitScalarFormulaElement(string $cellValue): void
+    {
+        $objWriter = $this->formulaXmlWriter;
+        if ($objWriter === null) {
+            return;
+        }
+        $prefixed = self::addFunctionPrefixStripEquals($cellValue);
+        $objWriter->writeElement('f', $prefixed);
+        $writeValue = $this->office2003compatibility === false
+            && $this->preCalculateFormulas
+            && $this->calculatedValue !== null;
+        if ($writeValue) {
+            $cached = $this->calculatedValueString;
+            if (!is_array($this->calculatedValue) && !str_starts_with($cached, '#')) {
+                $value = StringHelper::formatNumber($cached);
+            } else {
+                $value = '0';
+            }
+            $objWriter->writeElement('v', $value);
+        }
+    }
+
+    private function emitFormulaCell(string $cellValue, Cell $cell): void
+    {
+        $objWriter = $this->formulaXmlWriter;
+        if ($objWriter === null || $this->xlsxWriter === null) {
+            return;
+        }
+        $attributes = $cell->getFormulaAttributes() ?? [];
+        $this->formulaCoordinate = $cell->getCoordinate();
+        $this->calculatedValue = $this->preCalculateFormulas ? $cell->getCalculatedValue() : $cellValue;
+        if ($this->calculatedValue === ExcelError::SPILL()) {
+            $this->emitSpillFormula($cellValue);
+
+            return;
+        }
+        $this->calculatedValueString = $this->preCalculateFormulas ? $cell->getCalculatedValueString() : $cellValue;
+        $status = $this->classifyFormulaResultType($cellValue);
+        if ($status === 'error' || $status === 'skip') {
+            return;
+        }
+        $ref = $this->resolveFormulaRef($attributes);
+        $attributes = $this->normalizeFormulaAttributes($attributes);
+        if (($attributes['t'] ?? null) === 'array') {
+            $this->emitArrayFormulaElement($cellValue, $ref);
+        } else {
+            $this->emitScalarFormulaElement($cellValue);
+        }
+    }
+
+    private function normalizeFormulaAttributes(array $attributes): array
+    {
+        if (is_array($this->calculatedValue)) {
+            $attributes['t'] = 'array';
+        }
+
+        return $attributes;
+    }
+
+    private function emitOtherConditionalFormulas(Conditional $conditional, string $cellCoordinate): void
+    {
+        $objWriter = $this->formulaXmlWriter;
+        if ($objWriter === null) {
+            return;
+        }
+        $conditions = $conditional->getConditions();
+        $conditionType = $conditional->getConditionType();
+        $writeListedFormulas = $conditionType == Conditional::CONDITION_CELLIS
+            || $conditionType == Conditional::CONDITION_EXPRESSION
+            || !empty($conditions);
+        if ($writeListedFormulas) {
+            foreach ($conditions as $formula) {
+                if (is_bool($formula)) {
+                    $formula = $formula ? 'TRUE' : 'FALSE';
+                }
+                $objWriter->writeElement('formula', self::addFunctionPrefix("$formula"));
+            }
+        } elseif ($conditionType == Conditional::CONDITION_CONTAINSBLANKS) {
+            $objWriter->writeElement('formula', 'LEN(TRIM(' . $cellCoordinate . '))=0');
+        } elseif ($conditionType == Conditional::CONDITION_NOTCONTAINSBLANKS) {
+            $objWriter->writeElement('formula', 'LEN(TRIM(' . $cellCoordinate . '))>0');
+        } elseif ($conditionType == Conditional::CONDITION_CONTAINSERRORS) {
+            $objWriter->writeElement('formula', 'ISERROR(' . $cellCoordinate . ')');
+        } elseif ($conditionType == Conditional::CONDITION_NOTCONTAINSERRORS) {
+            $objWriter->writeElement('formula', 'NOT(ISERROR(' . $cellCoordinate . '))');
+        }
+    }
+
+    private function emitTimePeriodConditionalFormulas(Conditional $conditional, string $cellCoordinate): void
+    {
+        $objWriter = $this->formulaXmlWriter;
+        if ($objWriter === null) {
+            return;
+        }
+        $txt = $conditional->getText();
+        if (empty($txt)) {
+            return;
+        }
+        $objWriter->writeAttribute('timePeriod', $txt);
+        if (empty($conditional->getConditions())) {
+            if ($conditional->getOperatorType() == Conditional::TIMEPERIOD_TODAY) {
+                $objWriter->writeElement('formula', 'FLOOR(' . $cellCoordinate . ')=TODAY()');
+            } elseif ($conditional->getOperatorType() == Conditional::TIMEPERIOD_TOMORROW) {
+                $objWriter->writeElement('formula', 'FLOOR(' . $cellCoordinate . ')=TODAY()+1');
+            } elseif ($conditional->getOperatorType() == Conditional::TIMEPERIOD_YESTERDAY) {
+                $objWriter->writeElement('formula', 'FLOOR(' . $cellCoordinate . ')=TODAY()-1');
+            } elseif ($conditional->getOperatorType() == Conditional::TIMEPERIOD_LAST_7_DAYS) {
+                $objWriter->writeElement('formula', 'AND(TODAY()-FLOOR(' . $cellCoordinate . ',1)<=6,FLOOR(' . $cellCoordinate . ',1)<=TODAY())');
+            } elseif ($conditional->getOperatorType() == Conditional::TIMEPERIOD_LAST_WEEK) {
+                $objWriter->writeElement('formula', 'AND(TODAY()-ROUNDDOWN(' . $cellCoordinate . ',0)>=(WEEKDAY(TODAY())),TODAY()-ROUNDDOWN(' . $cellCoordinate . ',0)<(WEEKDAY(TODAY())+7))');
+            } elseif ($conditional->getOperatorType() == Conditional::TIMEPERIOD_THIS_WEEK) {
+                $objWriter->writeElement('formula', 'AND(TODAY()-ROUNDDOWN(' . $cellCoordinate . ',0)<=WEEKDAY(TODAY())-1,ROUNDDOWN(' . $cellCoordinate . ',0)-TODAY()<=7-WEEKDAY(TODAY()))');
+            } elseif ($conditional->getOperatorType() == Conditional::TIMEPERIOD_NEXT_WEEK) {
+                $objWriter->writeElement('formula', 'AND(ROUNDDOWN(' . $cellCoordinate . ',0)-TODAY()>(7-WEEKDAY(TODAY())),ROUNDDOWN(' . $cellCoordinate . ',0)-TODAY()<(15-WEEKDAY(TODAY())))');
+            } elseif ($conditional->getOperatorType() == Conditional::TIMEPERIOD_LAST_MONTH) {
+                $objWriter->writeElement('formula', 'AND(MONTH(' . $cellCoordinate . ')=MONTH(EDATE(TODAY(),0-1)),YEAR(' . $cellCoordinate . ')=YEAR(EDATE(TODAY(),0-1)))');
+            } elseif ($conditional->getOperatorType() == Conditional::TIMEPERIOD_THIS_MONTH) {
+                $objWriter->writeElement('formula', 'AND(MONTH(' . $cellCoordinate . ')=MONTH(TODAY()),YEAR(' . $cellCoordinate . ')=YEAR(TODAY()))');
+            } elseif ($conditional->getOperatorType() == Conditional::TIMEPERIOD_NEXT_MONTH) {
+                $objWriter->writeElement('formula', 'AND(MONTH(' . $cellCoordinate . ')=MONTH(EDATE(TODAY(),0+1)),YEAR(' . $cellCoordinate . ')=YEAR(EDATE(TODAY(),0+1)))');
+            }
+        } else {
+            $objWriter->writeElement('formula', (string) ($conditional->getConditions()[0]));
+        }
+    }
+
+    private function emitTextConditionalFormulas(Conditional $conditional, string $cellCoordinate): void
+    {
+        $objWriter = $this->formulaXmlWriter;
+        if ($objWriter === null) {
+            return;
+        }
+        $txt = $conditional->getText();
+        if (empty($txt)) {
+            return;
+        }
+        $objWriter->writeAttribute('text', $txt);
+        if (empty($conditional->getConditions())) {
+            if ($conditional->getOperatorType() == Conditional::OPERATOR_CONTAINSTEXT) {
+                $objWriter->writeElement('formula', 'NOT(ISERROR(SEARCH("' . $txt . '",' . $cellCoordinate . ')))');
+            } elseif ($conditional->getOperatorType() == Conditional::OPERATOR_BEGINSWITH) {
+                $objWriter->writeElement('formula', 'LEFT(' . $cellCoordinate . ',LEN("' . $txt . '"))="' . $txt . '"');
+            } elseif ($conditional->getOperatorType() == Conditional::OPERATOR_ENDSWITH) {
+                $objWriter->writeElement('formula', 'RIGHT(' . $cellCoordinate . ',LEN("' . $txt . '"))="' . $txt . '"');
+            } elseif ($conditional->getOperatorType() == Conditional::OPERATOR_NOTCONTAINS) {
+                $objWriter->writeElement('formula', 'ISERROR(SEARCH("' . $txt . '",' . $cellCoordinate . '))');
+            }
+        } else {
+            $objWriter->writeElement('formula', (string) ($conditional->getConditions()[0]));
+        }
+    }
+
+    private function bindDefinedNameContext(XMLWriter $objWriter, Spreadsheet $spreadsheet): void
+    {
+        $this->definedNameXmlWriter = $objWriter;
+        $this->definedNameSpreadsheet = $spreadsheet;
+        $this->definedRangeBuffer = '';
+        $this->definedNameLocalId = -1;
+        $this->quotedSheetTitle = '';
+    }
+
+    private function resolveLocalSheetIndex(DefinedName $definedName): int
+    {
+        $this->definedNameLocalId = -1;
+        if ($definedName->getLocalOnly() && $definedName->getScope() !== null) {
+            try {
+                $this->definedNameLocalId = $definedName->getScope()->getParentOrThrow()->getIndex($definedName->getScope());
+            } catch (\Exception) {
+                $this->definedNameLocalId = -2;
+            }
+        }
+
+        return $this->definedNameLocalId;
+    }
+
+    private function quoteSheetTitle(string $title): string
+    {
+        $quoted = "'" . str_replace("'", "''", $title) . "'";
+        if ($this->quotedSheetTitle !== $quoted) {
+            $this->quotedSheetTitle = $quoted;
+        }
+
+        return $this->quotedSheetTitle;
+    }
+
+    private function rewriteDefinedRange(DefinedName $definedName): string
+    {
+        $definedRange = $definedName->getValue();
+        $splitCount = preg_match_all(
+            '/' . Calculation::CALCULATION_REGEXP_CELLREF_RELATIVE . '/mui',
+            $definedRange,
+            $splitRanges,
+            PREG_OFFSET_CAPTURE
+        );
+
+        $matchedTokens = $splitRanges[0] ?? [];
+        $lengths = array_map('strlen', array_column($matchedTokens, 0));
+        $offsets = array_column($matchedTokens, 1);
+
+        $worksheets = $splitRanges[2] ?? [];
+        $columns = $splitRanges[6] ?? [];
+        $rows = $splitRanges[7] ?? [];
+
+        while ($splitCount > 0) {
+            --$splitCount;
+            $length = $lengths[$splitCount];
+            $offset = $offsets[$splitCount];
+            $worksheet = $worksheets[$splitCount][0];
+            $column = $columns[$splitCount][0];
+            $row = $rows[$splitCount][0];
+
+            $newRange = '';
+            if (empty($worksheet)) {
+                $precededByRangeOperator = ($offset !== 0) && ($definedRange[$offset - 1] === ':');
+                if ($offset === 0 || $precededByRangeOperator === false) {
+                    $ws = $definedName->getWorksheet();
+                    $worksheet = ($ws === null) ? null : $ws->getTitle();
+                }
+            } else {
+                $worksheet = str_replace("''", "'", trim($worksheet, "'"));
+            }
+
+            if (!empty($worksheet)) {
+                $newRange = $this->quoteSheetTitle((string) $worksheet) . '!';
+            }
+            $newRange = "{$newRange}{$column}{$row}";
+
+            $prefix = substr($definedRange, 0, $offset);
+            $suffix = substr($definedRange, $offset + $length);
+            $definedRange = $prefix . $newRange . $suffix;
+        }
+
+        if (str_starts_with($definedRange, '=')) {
+            $definedRange = substr($definedRange, 1);
+        }
+        $this->definedRangeBuffer = $definedRange;
+
+        return $this->definedRangeBuffer;
+    }
+
+    private function emitNamedRange(DefinedName $definedName): void
+    {
+        $objWriter = $this->definedNameXmlWriter;
+        if ($objWriter === null) {
+            return;
+        }
+        $local = $this->resolveLocalSheetIndex($definedName);
+        if ($local === -2) {
+            return;
+        }
+        $name = $definedName->getName();
+        $objWriter->startElement('definedName');
+        $objWriter->writeAttribute('name', $name);
+        if ($local >= 0) {
+            $objWriter->writeAttribute(
+                'localSheetId',
+                "$local"
+            );
+        }
+        $definedRange = $this->rewriteDefinedRange($definedName);
+        $this->definedRangeBuffer = $definedRange;
+        $objWriter->writeRawData($this->definedRangeBuffer);
+        $objWriter->endElement();
+    }
+
+    private function emitAutofilterDefinedName(ActualWorksheet $worksheet, int $worksheetId = 0): void
+    {
+        $objWriter = $this->definedNameXmlWriter;
+        if ($objWriter === null) {
+            return;
+        }
+        $autoFilterRange = $worksheet->getAutoFilter()->getRange();
+        if (empty($autoFilterRange)) {
+            return;
+        }
+        $objWriter->startElement('definedName');
+        $objWriter->writeAttribute('name', '_xlnm._FilterDatabase');
+        $objWriter->writeAttribute('localSheetId', "$worksheetId");
+        $objWriter->writeAttribute('hidden', '1');
+
+        $range = Coordinate::splitRange($autoFilterRange);
+        $range = $range[0];
+        [, $range[0]] = ActualWorksheet::extractSheetTitle($range[0], true);
+
+        $range[0] = Coordinate::absoluteCoordinate($range[0] ?? '');
+        if (count($range) > 1) {
+            $range[1] = Coordinate::absoluteCoordinate($range[1]);
+        }
+        $range = implode(':', $range);
+        $this->definedRangeBuffer = $this->quoteSheetTitle($worksheet->getTitle()) . '!' . $range;
+        $objWriter->writeRawData($this->definedRangeBuffer);
+        $objWriter->endElement();
+    }
+
+    private function emitPrintTitlesDefinedName(ActualWorksheet $worksheet, int $worksheetId = 0): void
+    {
+        $objWriter = $this->definedNameXmlWriter;
+        if ($objWriter === null) {
+            return;
+        }
+        if (!$worksheet->getPageSetup()->isColumnsToRepeatAtLeftSet() && !$worksheet->getPageSetup()->isRowsToRepeatAtTopSet()) {
+            return;
+        }
+        $objWriter->startElement('definedName');
+        $objWriter->writeAttribute('name', '_xlnm.Print_Titles');
+        $objWriter->writeAttribute('localSheetId', "$worksheetId");
+
+        $settingString = '';
+        $quotedTitle = $this->quoteSheetTitle($worksheet->getTitle());
+        if ($worksheet->getPageSetup()->isColumnsToRepeatAtLeftSet()) {
+            $repeat = $worksheet->getPageSetup()->getColumnsToRepeatAtLeft();
+            $settingString .= $quotedTitle . '!$' . $repeat[0] . ':$' . $repeat[1];
+        }
+        if ($worksheet->getPageSetup()->isRowsToRepeatAtTopSet()) {
+            if ($worksheet->getPageSetup()->isColumnsToRepeatAtLeftSet()) {
+                $settingString .= ',';
+            }
+            $repeat = $worksheet->getPageSetup()->getRowsToRepeatAtTop();
+            $settingString .= $quotedTitle . '!$' . $repeat[0] . ':$' . $repeat[1];
+        }
+        $this->definedRangeBuffer = $settingString;
+        $objWriter->writeRawData($this->definedRangeBuffer);
+        $objWriter->endElement();
+    }
+
+    private function emitPrintAreaDefinedName(ActualWorksheet $worksheet, int $worksheetId = 0): void
+    {
+        $objWriter = $this->definedNameXmlWriter;
+        if ($objWriter === null) {
+            return;
+        }
+        if (!$worksheet->getPageSetup()->isPrintAreaSet()) {
+            return;
+        }
+        $objWriter->startElement('definedName');
+        $objWriter->writeAttribute('name', '_xlnm.Print_Area');
+        $objWriter->writeAttribute('localSheetId', "$worksheetId");
+
+        $printArea = Coordinate::splitRange($worksheet->getPageSetup()->getPrintArea());
+        $chunks = [];
+        $quotedTitle = $this->quoteSheetTitle($worksheet->getTitle());
+        foreach ($printArea as $printAreaRect) {
+            $printAreaRect[0] = Coordinate::absoluteReference($printAreaRect[0]);
+            $printAreaRect[1] = Coordinate::absoluteReference($printAreaRect[1]);
+            $chunks[] = $quotedTitle . '!' . implode(':', $printAreaRect);
+        }
+        $this->definedRangeBuffer = implode(',', $chunks);
+        $objWriter->writeRawData($this->definedRangeBuffer);
+        $objWriter->endElement();
+    }
+
+    private function emitDataValidations(ActualWorksheet $worksheet): void
+    {
+        $objWriter = $this->formulaXmlWriter;
+        if ($objWriter === null) {
+            return;
+        }
+        $dataValidationCollection = $worksheet->getDataValidationCollection();
+        if (empty($dataValidationCollection)) {
+            return;
+        }
+        $dataValidationCollection = Coordinate::mergeRangesInCollection($dataValidationCollection);
+        $objWriter->startElement('dataValidations');
+        $objWriter->writeAttribute('count', (string) count($dataValidationCollection));
+        foreach ($dataValidationCollection as $coordinate => $dv) {
+            $objWriter->startElement('dataValidation');
+            if ($dv->getType() != '') {
+                $objWriter->writeAttribute('type', $dv->getType());
+            }
+            if ($dv->getErrorStyle() != '') {
+                $objWriter->writeAttribute('errorStyle', $dv->getErrorStyle());
+            }
+            if ($dv->getOperator() != '') {
+                $objWriter->writeAttribute('operator', $dv->getOperator());
+            }
+            $objWriter->writeAttribute('allowBlank', ($dv->getAllowBlank() ? '1' : '0'));
+            $objWriter->writeAttribute('showDropDown', (!$dv->getShowDropDown() ? '1' : '0'));
+            $objWriter->writeAttribute('showInputMessage', ($dv->getShowInputMessage() ? '1' : '0'));
+            $objWriter->writeAttribute('showErrorMessage', ($dv->getShowErrorMessage() ? '1' : '0'));
+            if ($dv->getErrorTitle() !== '') {
+                $objWriter->writeAttribute('errorTitle', $dv->getErrorTitle());
+            }
+            if ($dv->getError() !== '') {
+                $objWriter->writeAttribute('error', $dv->getError());
+            }
+            if ($dv->getPromptTitle() !== '') {
+                $objWriter->writeAttribute('promptTitle', $dv->getPromptTitle());
+            }
+            if ($dv->getPrompt() !== '') {
+                $objWriter->writeAttribute('prompt', $dv->getPrompt());
+            }
+            $objWriter->writeAttribute('sqref', $dv->getSqref() ?? $coordinate);
+            if ($dv->getFormula1() !== '') {
+                $objWriter->writeElement('formula1', $dv->getFormula1());
+            }
+            if ($dv->getFormula2() !== '') {
+                $objWriter->writeElement('formula2', $dv->getFormula2());
+            }
+            $objWriter->endElement();
+        }
+        $objWriter->endElement();
+    }
+
+    private function emitNamedRangesAndFormulae(): void
+    {
+        $spreadsheet = $this->definedNameSpreadsheet;
+        if ($spreadsheet === null) {
+            return;
+        }
+        foreach ($spreadsheet->getDefinedNames() as $definedName) {
+            $this->emitNamedRange($definedName);
+        }
+    }
+
+    private function emitAllDefinedNames(): void
+    {
+        $objWriter = $this->definedNameXmlWriter;
+        $spreadsheet = $this->definedNameSpreadsheet;
+        if ($objWriter === null || $spreadsheet === null) {
+            return;
+        }
+        $objWriter->startElement('definedNames');
+        $definedNames = $spreadsheet->getDefinedNames();
+        if (count($definedNames) > 0) {
+            $this->emitNamedRangesAndFormulae();
+        }
+        $sheetCount = $spreadsheet->getSheetCount();
+        for ($i = 0; $i < $sheetCount; ++$i) {
+            $sheet = $spreadsheet->getSheet($i);
+            $this->definedNameLocalId = $i;
+            $this->emitAutofilterDefinedName($sheet, $i);
+            $this->emitPrintTitlesDefinedName($sheet, $i);
+            $this->emitPrintAreaDefinedName($sheet, $i);
+        }
+        $objWriter->endElement();
+    }
+
+    private function bindAutoFilterContext(XMLWriter $objWriter): void
+    {
+        $this->autoFilterXmlWriter = $objWriter;
+        $this->autoFilterRange = '';
+        $this->filterColumnId = 0;
+        $this->filterJoin = '';
+        $this->filterRuleType = '';
+    }
+
+    private function normalizeAutoFilterRange(string $autoFilterRange): string
+    {
+        $range = Coordinate::splitRange($autoFilterRange);
+        $range = $range[0];
+        [$ws, $range[0]] = ActualWorksheet::extractSheetTitle($range[0], true);
+        $normalized = implode(':', $range);
+        $this->autoFilterRange = str_replace('$', '', $normalized);
+
+        return $this->autoFilterRange;
+    }
+
+    private function isBlankEqualFilterRule(Column $column, Rule $rule): bool
+    {
+        $this->filterRuleType = $rule->getRuleType();
+
+        return ($column->getFilterType() === Column::AUTOFILTER_FILTERTYPE_FILTER)
+            && ($rule->getOperator() === Rule::AUTOFILTER_COLUMN_RULE_EQUAL)
+            && ($rule->getValue() === '');
+    }
+
+    private function emitDynamicFilterAttributes(Column $column, Rule $rule): void
+    {
+        $objWriter = $this->autoFilterXmlWriter;
+        if ($objWriter === null) {
+            return;
+        }
+        $this->filterRuleType = $rule->getRuleType();
+        $objWriter->writeAttribute('type', $rule->getGrouping());
+        $val = $column->getAttribute('val');
+        if ($val !== null) {
+            $objWriter->writeAttribute('val', "$val");
+        }
+        $maxVal = $column->getAttribute('maxVal');
+        if ($maxVal !== null) {
+            $objWriter->writeAttribute('maxVal', "$maxVal");
+        }
+    }
+
+    private function emitTopTenFilterAttributes(Rule $rule): void
+    {
+        $objWriter = $this->autoFilterXmlWriter;
+        if ($objWriter === null) {
+            return;
+        }
+        $this->filterRuleType = $rule->getRuleType();
+        $ruleValue = $rule->getValue();
+        if (!is_array($ruleValue)) {
+            $objWriter->writeAttribute('val', "$ruleValue");
+        }
+        $objWriter->writeAttribute('percent', (($rule->getOperator() === Rule::AUTOFILTER_COLUMN_RULE_TOPTEN_PERCENT) ? '1' : '0'));
+        $objWriter->writeAttribute('top', (($rule->getGrouping() === Rule::AUTOFILTER_COLUMN_RULE_TOPTEN_TOP) ? '1' : '0'));
+    }
+
+    private function emitStandardFilterRule(Rule $rule): void
+    {
+        $objWriter = $this->autoFilterXmlWriter;
+        if ($objWriter === null) {
+            return;
+        }
+        $this->filterRuleType = $rule->getRuleType();
+        $objWriter->startElement($rule->getRuleType());
+        if ($rule->getOperator() !== Rule::AUTOFILTER_COLUMN_RULE_EQUAL) {
+            $objWriter->writeAttribute('operator', $rule->getOperator());
+        }
+        if ($rule->getRuleType() === Rule::AUTOFILTER_RULETYPE_DATEGROUP) {
+            $ruleValue = $rule->getValue();
+            if (is_array($ruleValue)) {
+                foreach ($ruleValue as $key => $value) {
+                    $objWriter->writeAttribute($key, "$value");
+                }
+            }
+            $objWriter->writeAttribute('dateTimeGrouping', $rule->getGrouping());
+        } else {
+            $ruleValue = $rule->getValue();
+            if (!is_array($ruleValue)) {
+                $objWriter->writeAttribute('val', "$ruleValue");
+            }
+        }
+        $objWriter->endElement();
+    }
+
+    private function emitAutoFilterColumn(Column $column, int $colId): void
+    {
+        $objWriter = $this->autoFilterXmlWriter;
+        if ($objWriter === null) {
+            return;
+        }
+        $rules = $column->getRules();
+        if (count($rules) === 0) {
+            return;
+        }
+        $this->filterColumnId = $colId;
+        $this->filterJoin = $column->getJoin();
+        $filterType = $column->getFilterType();
+        $objWriter->startElement('filterColumn');
+        $objWriter->writeAttribute('colId', "$colId");
+        $objWriter->startElement($filterType);
+        if ($this->filterJoin == Column::AUTOFILTER_COLUMN_JOIN_AND) {
+            $objWriter->writeAttribute('and', '1');
+        }
+        foreach ($rules as $rule) {
+            $ruleType = $rule->getRuleType();
+            if ($this->isBlankEqualFilterRule($column, $rule)) {
+                $objWriter->writeAttribute('blank', '1');
+            } elseif ($ruleType === Rule::AUTOFILTER_RULETYPE_DYNAMICFILTER) {
+                $this->emitDynamicFilterAttributes($column, $rule);
+            } elseif ($ruleType === Rule::AUTOFILTER_RULETYPE_TOPTENFILTER) {
+                $this->emitTopTenFilterAttributes($rule);
+            } else {
+                $this->emitStandardFilterRule($rule);
+            }
+        }
+        $objWriter->endElement();
+        $objWriter->endElement();
+    }
+
+    private function emitWorksheetAutoFilter(ActualWorksheet $worksheet): void
+    {
+        $objWriter = $this->autoFilterXmlWriter;
+        if ($objWriter === null) {
+            return;
+        }
+        $autoFilter = $worksheet->getAutoFilter();
+        $autoFilterRange = $autoFilter->getRange();
+        if (empty($autoFilterRange)) {
+            return;
+        }
+        $objWriter->startElement('autoFilter');
+        $normalized = $this->normalizeAutoFilterRange($autoFilterRange);
+        $objWriter->writeAttribute('ref', $normalized);
+        $columns = $autoFilter->getColumns();
+        if (count($columns) > 0) {
+            foreach ($columns as $columnID => $column) {
+                $colId = $autoFilter->getColumnOffset($columnID);
+                $this->filterColumnId = $colId;
+                $this->emitAutoFilterColumn($column, $colId);
+            }
+        }
+        $objWriter->endElement();
+    }
 }
