+    fn note_body_event(&mut self) {
+        self.body_event_count = self.body_event_count.saturating_add(1);
+    }
+
+    fn note_literal_rewrite(&mut self) {
+        self.literal_rewrite_count = self.literal_rewrite_count.saturating_add(1);
+    }
