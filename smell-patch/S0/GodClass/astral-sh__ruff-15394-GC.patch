+    pub(crate) fn rewrite_dict_kwargs(&mut self, checker: &mut Checker, call: &ast::ExprCall) {
+        self.reset_keyword_state(call);
+        let mut duplicate_keywords = None;
+        for keyword in &*call.arguments.keywords {
+            match self.classify_keyword_item(keyword) {
+                KeywordShape::Named => continue,
+                KeywordShape::OtherUnpack => continue,
+                KeywordShape::DictUnpack => {}
+            }
+
+            let Expr::Dict(dict) = &keyword.value else {
+                continue;
+            };
+
+            if let [ast::DictItem { key: None, value }] = dict.items.as_slice() {
+                let diagnostic = Diagnostic::new(UnnecessaryDictKwargs, keyword.range());
+                let edit = Edit::range_replacement(
+                    format!("**{}", checker.locator().slice(value)),
+                    keyword.range(),
+                );
+                checker
+                    .diagnostics
+                    .push(diagnostic.with_fix(Fix::safe_edit(edit)));
+                continue;
+            }
+
+            self.collect_kwargs_from_dict(dict);
+            if self.collected_kwarg_count() != dict.len() {
+                continue;
+            }
+
+            let mut diagnostic = Diagnostic::new(UnnecessaryDictKwargs, keyword.range());
+
+            if dict.is_empty() {
+                diagnostic.try_set_fix(|| {
+                    remove_argument(
+                        keyword,
+                        &call.arguments,
+                        Parentheses::Preserve,
+                        checker.locator().contents(),
+                    )
+                    .map(Fix::safe_edit)
+                });
+            } else {
+                if duplicate_keywords.is_none() {
+                    duplicate_keywords = Some(self.collect_duplicate_keywords(call));
+                }
+
+                if let Some(duplicate_keywords) = duplicate_keywords.as_ref() {
+                    if self
+                        .collected_kwargs
+                        .iter()
+                        .all(|kwarg| !duplicate_keywords.contains(kwarg.as_str()))
+                    {
+                        diagnostic.set_fix(Fix::safe_edit(Edit::range_replacement(
+                            self.collected_kwargs
+                                .iter()
+                                .zip(dict.iter_values())
+                                .map(|(kwarg, value)| {
+                                    format!(
+                                        "{}={}",
+                                        kwarg,
+                                        checker.locator().slice(
+                                            parenthesized_range(
+                                                value.into(),
+                                                dict.into(),
+                                                checker.comment_ranges(),
+                                                checker.locator().contents(),
+                                            )
+                                            .unwrap_or(value.range())
+                                        )
+                                    )
+                                })
+                                .join(", "),
+                            keyword.range(),
+                        )));
+                    }
+                }
+            }
+
+            checker.diagnostics.push(diagnostic);
+        }
+    }
+
+    fn reset_keyword_state(&mut self, call: &ast::ExprCall) {
+        self.keyword_seen.clear();
+        self.keyword_duplicates.clear();
+        self.collected_kwargs.clear();
+        self.range_start_is_zero = call.arguments.keywords.is_empty();
+    }
+
+    fn classify_keyword_item(&mut self, keyword: &ast::Keyword) -> KeywordShape {
+        if keyword.arg.is_some() {
+            self.range_start_is_zero = false;
+            KeywordShape::Named
+        } else if matches!(keyword.value, Expr::Dict(_)) {
+            KeywordShape::DictUnpack
+        } else {
+            KeywordShape::OtherUnpack
+        }
+    }
+
+    fn collect_kwargs_from_dict(&mut self, dict: &ast::ExprDict) {
+        self.collected_kwargs.clear();
+        for key in dict.iter_keys() {
+            if let Some(name) = key.and_then(as_kwarg) {
+                self.collected_kwargs.push(name.to_string());
+            }
+        }
+    }
+
+    fn collect_duplicate_keywords(&mut self, call: &ast::ExprCall) -> FxHashSet<String> {
+        self.keyword_seen.clear();
+        self.keyword_duplicates.clear();
+        for keyword in &*call.arguments.keywords {
+            if let Some(name) = &keyword.arg {
+                self.record_keyword_name(name.as_str());
+            } else if let Expr::Dict(dict) = &keyword.value {
+                for key in dict.iter_keys() {
+                    if let Some(name) = key.and_then(as_kwarg) {
+                        self.record_keyword_name(name);
+                    }
+                }
+            }
+        }
+        self.keyword_duplicates.clone()
+    }
+
+    fn record_keyword_name(&mut self, name: &str) {
+        if !self.keyword_seen.insert(name.to_string()) {
+            self.keyword_duplicates.insert(name.to_string());
+        }
+    }
+
+
+    fn collected_kwarg_count(&self) -> usize {
+        self.collected_kwargs.len()
+    }
+
+    pub(crate) fn rewrite_range_start(&mut self, checker: &mut Checker, call: &ast::ExprCall) {
+        self.range_start_is_zero = false;
+        if !call.arguments.keywords.is_empty() {
+            return;
+        }
+
+        let [start, _] = &*call.arguments.args else {
+            return;
+        };
+
+        let Expr::NumberLiteral(ast::ExprNumberLiteral {
+            value: ast::Number::Int(value),
+            ..
+        }) = start
+        else {
+            return;
+        };
+        self.range_start_is_zero = *value == 0;
+        if !self.range_start_is_literal_zero() {
+            return;
+        }
+
+        if !checker.semantic().match_builtin_expr(&call.func, "range") {
+            return;
+        }
+
+        let mut diagnostic = Diagnostic::new(UnnecessaryRangeStart, start.range());
+        diagnostic.try_set_fix(|| {
+            remove_argument(
+                &start,
+                &call.arguments,
+                Parentheses::Preserve,
+                checker.locator().contents(),
+            )
+            .map(Fix::safe_edit)
+        });
+        checker.diagnostics.push(diagnostic);
+    }
+
+    fn range_start_is_literal_zero(&self) -> bool {
+        self.range_start_is_zero
+    }
+
+    pub(crate) fn rewrite_key_in_dict(
+        &mut self,
+        checker: &mut Checker,
+        left: &Expr,
+        right: &Expr,
+        operator: CmpOp,
+        parent: AnyNodeRef,
+    ) {
+        self.reset_membership_state(operator);
+        let Expr::Call(ast::ExprCall {
+            func,
+            arguments: Arguments { args, keywords, .. },
+            range: _,
+        }) = &right
+        else {
+            return;
+        };
+        if !(args.is_empty() && keywords.is_empty()) {
+            return;
+        }
+
+        let Expr::Attribute(ast::ExprAttribute { attr, value, .. }) = func.as_ref() else {
+            return;
+        };
+        if !self.membership_is_keys_attr(attr.as_str()) {
+            return;
+        }
+
+        if value
+            .as_name_expr()
+            .is_some_and(|name| matches!(name.id.as_str(), "self"))
+        {
+            return;
+        }
+
+        let left_range = parenthesized_range(
+            left.into(),
+            parent,
+            checker.comment_ranges(),
+            checker.locator().contents(),
+        )
+        .unwrap_or(left.range());
+        let right_range = parenthesized_range(
+            right.into(),
+            parent,
+            checker.comment_ranges(),
+            checker.locator().contents(),
+        )
+        .unwrap_or(right.range());
+
+        let mut diagnostic = Diagnostic::new(
+            InDictKeys {
+                operator: self.membership_operator.clone(),
+            },
+            TextRange::new(left_range.start(), right_range.end()),
+        );
+        if let Some(dot) = SimpleTokenizer::starts_at(value.end(), checker.locator().contents())
+            .skip_trivia()
+            .find(|token| token.kind == SimpleTokenKind::Dot)
+        {
+            let applicability = {
+                let is_dict = value.as_name_expr().is_some_and(|name| {
+                    let Some(binding) = checker
+                        .semantic()
+                        .only_binding(name)
+                        .map(|id| checker.semantic().binding(id))
+                    else {
+                        return false;
+                    };
+                    typing::is_dict(binding, checker.semantic())
+                });
+                if is_dict {
+                    Applicability::Safe
+                } else {
+                    Applicability::Unsafe
+                }
+            };
+
+            let range = TextRange::new(dot.start(), right.end());
+            self.membership_insert_space = checker
+                .locator()
+                .after(range.end())
+                .chars()
+                .next()
+                .is_some_and(|char| char.is_ascii_alphabetic());
+            if self.membership_insert_space {
+                diagnostic.set_fix(Fix::applicable_edit(
+                    Edit::range_replacement(" ".to_string(), range),
+                    applicability,
+                ));
+            } else {
+                diagnostic.set_fix(Fix::applicable_edit(
+                    Edit::range_deletion(range),
+                    applicability,
+                ));
+            }
+        }
+        checker.diagnostics.push(diagnostic);
+    }
+
+    fn reset_membership_state(&mut self, operator: CmpOp) {
+        self.membership_operator = operator.as_str().to_string();
+        self.membership_insert_space = false;
+        self.lookup_value_name.clear();
+        self.zip_expected.clear();
+    }
+
+    fn membership_is_keys_attr(&self, attr: &str) -> bool {
+        attr == "keys" && !self.membership_operator.is_empty()
+    }
+
+    pub(crate) fn rewrite_key_in_dict_for(&mut self, checker: &mut Checker, for_stmt: &ast::StmtFor) {
+        self.reset_membership_state(CmpOp::In);
+        self.rewrite_key_in_dict(
+            checker,
+            &for_stmt.target,
+            &for_stmt.iter,
+            CmpOp::In,
+            for_stmt.into(),
+        );
+    }
+
+    pub(crate) fn rewrite_key_in_dict_comprehension(
+        &mut self,
+        checker: &mut Checker,
+        comprehension: &Comprehension,
+    ) {
+        self.reset_membership_state(CmpOp::In);
+        self.rewrite_key_in_dict(
+            checker,
+            &comprehension.target,
+            &comprehension.iter,
+            CmpOp::In,
+            comprehension.into(),
+        );
+    }
+
+    pub(crate) fn rewrite_key_in_dict_compare(
+        &mut self,
+        checker: &mut Checker,
+        compare: &ast::ExprCompare,
+    ) {
+        let [op] = &*compare.ops else {
+            return;
+        };
+
+        if !matches!(op, CmpOp::In | CmpOp::NotIn) {
+            return;
+        }
+
+        let [right] = &*compare.comparators else {
+            return;
+        };
+
+        self.reset_membership_state(*op);
+        self.rewrite_key_in_dict(checker, &compare.left, right, *op, compare.into());
+    }
+
+    pub(crate) fn rewrite_zip_dict_keys_and_values(
+        &mut self,
+        checker: &mut Checker,
+        expr: &ast::ExprCall,
+    ) {
+        self.zip_expected.clear();
+        let ast::ExprCall {
+            func,
+            arguments: Arguments { args, keywords, .. },
+            ..
+        } = expr;
+        match &keywords[..] {
+            [] => {}
+            [ast::Keyword {
+                arg: Some(name), ..
+            }] if name.as_str() == "strict" => {}
+            _ => return,
+        };
+        let [arg1, arg2] = &args[..] else {
+            return;
+        };
+        let Some((var1, attr1)) = zip_var_attr(arg1) else {
+            return;
+        };
+        let Some((var2, attr2)) = zip_var_attr(arg2) else {
+            return;
+        };
+        if var1.id != var2.id || attr1 != "keys" || attr2 != "values" {
+            return;
+        }
+        if !checker.semantic().match_builtin_expr(func, "zip") {
+            return;
+        }
+
+        let Some(binding) = checker
+            .semantic()
+            .only_binding(var1)
+            .map(|id| checker.semantic().binding(id))
+        else {
+            return;
+        };
+        if !typing::is_dict(binding, checker.semantic()) {
+            return;
+        }
+
+        self.zip_expected = format!("{}.items()", checker.locator().slice(var1));
+        let actual = checker.locator().slice(expr);
+
+        let mut diagnostic = Diagnostic::new(
+            ZipDictKeysAndValues {
+                expected: SourceCodeSnippet::new(self.zip_expected.clone()),
+                actual: SourceCodeSnippet::from_str(actual),
+            },
+            expr.range(),
+        );
+        diagnostic.set_fix(Fix::safe_edit(Edit::range_replacement(
+            self.zip_expected.clone(),
+            expr.range(),
+        )));
+        checker.diagnostics.push(diagnostic);
+    }
+
+
+    pub(crate) fn rewrite_dict_index_lookup(&mut self, checker: &mut Checker, stmt_for: &StmtFor) {
+        self.lookup_value_name.clear();
+        let Some((dict_name, index_name, value_name)) =
+            self.dict_items(&stmt_for.iter, &stmt_for.target)
+        else {
+            return;
+        };
+        self.lookup_value_name = value_name.id.to_string();
+
+        let ranges = {
+            let mut visitor = SequenceIndexVisitor::new(&dict_name.id, &index_name.id, &value_name.id);
+            visitor.visit_body(&stmt_for.body);
+            visitor.visit_body(&stmt_for.orelse);
+            visitor.into_accesses()
+        };
+
+        self.emit_dict_index_diagnostics(checker, ranges, index_name, value_name);
+    }
+
+    pub(crate) fn rewrite_dict_index_lookup_comprehension(
+        &mut self,
+        checker: &mut Checker,
+        expr: &Expr,
+    ) {
+        self.lookup_value_name.clear();
+        let (Expr::Generator(ast::ExprGenerator {
+            elt, generators, ..
+        })
+        | Expr::DictComp(ast::ExprDictComp {
+            value: elt,
+            generators,
+            ..
+        })
+        | Expr::SetComp(ast::ExprSetComp {
+            elt, generators, ..
+        })
+        | Expr::ListComp(ast::ExprListComp {
+            elt, generators, ..
+        })) = expr
+        else {
+            return;
+        };
+
+        for comp in generators {
+            let Some((dict_name, index_name, value_name)) =
+                self.dict_items(&comp.iter, &comp.target)
+            else {
+                continue;
+            };
+            self.lookup_value_name = value_name.id.to_string();
+
+            let ranges = {
+                let mut visitor =
+                    SequenceIndexVisitor::new(&dict_name.id, &index_name.id, &value_name.id);
+                visitor.visit_expr(elt.as_ref());
+                for expr in &comp.ifs {
+                    visitor.visit_expr(expr);
+                }
+                visitor.into_accesses()
+            };
+
+            self.emit_dict_index_diagnostics(checker, ranges, index_name, value_name);
+        }
+    }
+
+    fn emit_dict_index_diagnostics(
+        &mut self,
+        checker: &mut Checker,
+        ranges: Vec<TextRange>,
+        index_name: &ast::ExprName,
+        value_name: &ast::ExprName,
+    ) {
+        for range in ranges {
+            let mut diagnostic = Diagnostic::new(UnnecessaryDictIndexLookup, range);
+            diagnostic.set_fix(Fix::safe_edits(
+                Edit::range_replacement(self.lookup_value_name.clone(), range),
+                [self.noop_name(index_name), self.noop_name(value_name)],
+            ));
+            checker.diagnostics.push(diagnostic);
+        }
+    }
+
+    fn dict_items<'a>(
+        &mut self,
+        call_expr: &'a Expr,
+        tuple_expr: &'a Expr,
+    ) -> Option<(&'a ast::ExprName, &'a ast::ExprName, &'a ast::ExprName)> {
+        self.lookup_value_name.clear();
+        let ast::ExprCall {
+            func, arguments, ..
+        } = call_expr.as_call_expr()?;
+
+        if !arguments.is_empty() {
+            return None;
+        }
+        let Expr::Attribute(ast::ExprAttribute { value, attr, .. }) = func.as_ref() else {
+            return None;
+        };
+        if attr != "items" {
+            return None;
+        }
+
+        let Expr::Name(dict_name) = value.as_ref() else {
+            return None;
+        };
+
+        let Expr::Tuple(ast::ExprTuple { elts, .. }) = tuple_expr else {
+            return None;
+        };
+        let [index, value] = elts.as_slice() else {
+            return None;
+        };
+
+        let Expr::Name(index_name) = index else {
+            return None;
+        };
+
+        let Expr::Name(value_name) = value else {
+            return None;
+        };
+
+        if index_name.id == "_" || value_name.id == "_" {
+            return None;
+        }
+
+        Some((dict_name, index_name, value_name))
+    }
+
+    fn noop_name(&self, name: &ast::ExprName) -> Edit {
+        if self.lookup_value_name == name.id.as_str() {
+            Edit::range_replacement(self.lookup_value_name.clone(), name.range())
+        } else {
+            Edit::range_replacement(name.id.to_string(), name.range())
+        }
+    }
