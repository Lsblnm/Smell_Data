+    public function resolveIntervalFactor(string $source, string $target): int|float|null
+    {
+        $this->coordinationState['factor_source'] = $source;
+        $this->coordinationState['factor_target'] = $target;
+        $this->coordinationState['hub'] = ((int) ($this->coordinationState['hub'] ?? 0)) + 1;
+        $mapped = self::defaultCascadeFactorBetween($source, $target);
+
+        if ($mapped !== null) {
+            return $mapped;
+        }
+
+        $factors = $this->defaultIntervalCascadeFactors();
+
+        if (isset($factors[$source]) && $factors[$source][1] === $target) {
+            return $factors[$source][0];
+        }
+
+        if (isset($factors[$target]) && $factors[$target][1] === $source) {
+            return 1 / $factors[$target][0];
+        }
+
+        return null;
+    }
