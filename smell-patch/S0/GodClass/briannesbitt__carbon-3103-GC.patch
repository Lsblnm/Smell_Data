+        $monthOverflow = $this->applyMonthOverflowPolicy();
+        $yearOverflow = $this->applyYearOverflowPolicy();
+        $boundary = [
+            'value_unit' => $normalizedValue,
+            'overflow_unit' => $normalizedOverflow,
+            'factor' => $factor,
+            'month_overflow' => $monthOverflow,
+            'year_overflow' => $yearOverflow,
+        ];
+        $this->coordinationState['boundary'] = $boundary;
+
+        return $boundary;
+    }
