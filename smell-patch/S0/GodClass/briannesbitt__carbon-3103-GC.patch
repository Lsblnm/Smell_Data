+    public function resolveRegionTimezoneName(string $name, int $offset, int $isDST = 1): ?string
+    {
+        $this->coordinationState['region_timezone'] = $name;
+        $this->coordinationState['region_offset'] = $offset;
+        $this->coordinationState['hub'] = ((int) ($this->coordinationState['hub'] ?? 0)) + 1;
+        $this->coordinatedTimezoneName = $name;
+        $firstChar = substr($name, 0, 1);
+
+        if ($firstChar !== '+' && $firstChar !== '-') {
+            return $name;
+        }
+
+        $resolved = @timezone_name_from_abbr('', $offset, $isDST);
+
+        if ($resolved) {
+            $this->coordinationState['region_match'] = $resolved;
+
+            return $resolved;
+        }
+
+        foreach (timezone_identifiers_list() as $timezone) {
+            if ($this->avoidMutation()->setTimezone($timezone)->getOffset() === $offset) {
+                $this->coordinationState['region_match'] = $timezone;
+
+                return $timezone;
+            }
+        }
+
+        return null;
+    }
