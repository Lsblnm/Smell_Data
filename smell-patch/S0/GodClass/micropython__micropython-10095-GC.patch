+
+STATIC qstr mp_bc_runtime_decode_fun_name(mp_bc_runtime_t *self) {
+    const byte *code_info = self->bytecode;
+    MP_BC_PRELUDE_SIZE_DECODE(code_info);
+    mp_uint_t name = mp_decode_uint_value(code_info);
+    #if MICROPY_EMIT_BYTECODE_USES_QSTR_TABLE
+    name = self->fun_bc->context->constants.qstr_table[name];
+    #endif
+    self->fun_name = name;
+    return self->fun_name;
+}
+
+qstr mp_bc_runtime_fun_get_name(mp_bc_runtime_t *self) {
+    self->fun_bc = (struct _mp_obj_fun_bc_t *)MP_OBJ_TO_PTR(self->fun_obj);
+    self->bytecode = self->fun_bc->bytecode;
+    const byte *bc = self->bytecode;
+    MP_BC_PRELUDE_SIG_DECODE(bc);
+    self->bytecode = bc;
+    return mp_bc_runtime_decode_fun_name(self);
+}
+
+#if MICROPY_CPYTHON_COMPAT
+void mp_bc_runtime_fun_bc_print(mp_bc_runtime_t *self) {
+    (void)self->attr_name;
+    self->fun_name = mp_bc_runtime_fun_get_name(self);
+    mp_printf(self->print, "<function %q at 0x%p>", self->fun_name, self->fun_bc);
+}
+#endif
+
+#if MICROPY_PY_FUNCTION_ATTRS
+void mp_bc_runtime_fun_bc_attr(mp_bc_runtime_t *self) {
+    if (self->attr_dest[0] != MP_OBJ_NULL) {
+        return;
+    }
+    if (self->attr_name == MP_QSTR___name__) {
+        self->attr_dest[0] = MP_OBJ_NEW_QSTR(mp_bc_runtime_fun_get_name(self));
+    }
+    if (self->attr_name == MP_QSTR___globals__) {
+        self->fun_bc = (struct _mp_obj_fun_bc_t *)MP_OBJ_TO_PTR(self->fun_obj);
+        self->attr_dest[0] = MP_OBJ_FROM_PTR(self->fun_bc->context->module.globals);
+    }
 }
 #endif
+
+mp_obj_t mp_bc_runtime_new_fun_bc(mp_bc_runtime_t *self) {
+    size_t n_def_args = 0;
+    size_t n_extra_args = 0;
+    mp_obj_tuple_t *def_pos_args = NULL;
+    mp_obj_t def_kw_args = MP_OBJ_NULL;
+    if (self->def_args != NULL && self->def_args[0] != MP_OBJ_NULL) {
+        assert(mp_obj_is_type(self->def_args[0], &mp_type_tuple));
+        def_pos_args = MP_OBJ_TO_PTR(self->def_args[0]);
+        n_def_args = def_pos_args->len;
+        n_extra_args = def_pos_args->len;
+    }
+    if (self->def_args != NULL && self->def_args[1] != MP_OBJ_NULL) {
+        assert(mp_obj_is_type(self->def_args[1], &mp_type_dict));
+        def_kw_args = self->def_args[1];
+        n_extra_args += 1;
+    }
+    mp_obj_fun_bc_t *o = mp_obj_malloc_var(mp_obj_fun_bc_t, mp_obj_t, n_extra_args, &mp_type_fun_bc);
+    o->bytecode = self->fun_code;
+    o->context = self->fun_context;
+    o->child_table = self->fun_child_table;
+    self->fun_bc = o;
+    if (def_pos_args != NULL) {
+        memcpy(o->extra_args, def_pos_args->items, n_def_args * sizeof(mp_obj_t));
+    }
+    if (def_kw_args != MP_OBJ_NULL) {
+        o->extra_args[n_def_args] = def_kw_args;
+    }
+    self->fun_obj = MP_OBJ_FROM_PTR(o);
+    return self->fun_obj;
+}
+
+#if MICROPY_STACKLESS
+mp_code_state_t *mp_bc_runtime_prepare_codestate(mp_bc_runtime_t *self) {
+    MP_STACK_CHECK();
+    self->fun_bc = (struct _mp_obj_fun_bc_t *)MP_OBJ_TO_PTR(self->fun_obj);
+    self->bytecode = self->fun_bc->bytecode;
+    mp_bc_runtime_decode_fun_prelude(self);
+    mp_code_state_t *code_state;
+    #if MICROPY_ENABLE_PYSTACK
+    code_state = mp_pystack_alloc(sizeof(mp_code_state_t) + self->state_size);
+    #else
+    code_state = m_new_obj_var_maybe(mp_code_state_t, byte, self->state_size);
+    if (!code_state) {
+        self->code_state = NULL;
+        return NULL;
+    }
+    #endif
+    self->code_state = code_state;
+    mp_bc_runtime_init_code_state(self);
+    mp_bc_runtime_install_fun_globals(self);
+    return self->code_state;
+}
+#endif
+
+STATIC void mp_bc_runtime_decode_arg_sig(mp_bc_runtime_t *self) {
+    self->arg_takes_kw = self->arg_sig & 1;
+    self->arg_n_min = self->arg_sig >> 17;
+    self->arg_n_max = (self->arg_sig >> 1) & 0xffff;
+}
+
+STATIC void mp_bc_runtime_reject_unexpected_kwargs(mp_bc_runtime_t *self) {
+    if (self->arg_n_kw && !self->arg_takes_kw) {
+        #if MICROPY_ERROR_REPORTING <= MICROPY_ERROR_REPORTING_TERSE
+        mp_bc_runtime_arg_error_terse_mismatch(self);
+        #else
+        (void)self;
+        mp_raise_TypeError(MP_ERROR_TEXT("function doesn't take keyword arguments"));
+        #endif
+    }
+}
+
+STATIC void mp_bc_runtime_check_exact_arity(mp_bc_runtime_t *self) {
+    if (self->arg_n_args != self->arg_n_min) {
+        #if MICROPY_ERROR_REPORTING <= MICROPY_ERROR_REPORTING_TERSE
+        mp_bc_runtime_arg_error_terse_mismatch(self);
+        #else
+        mp_raise_msg_varg(&mp_type_TypeError,
+            MP_ERROR_TEXT("function takes %d positional arguments but %d were given"),
+            self->arg_n_min, self->arg_n_args);
+        #endif
+    }
+}
+
+STATIC void mp_bc_runtime_check_min_arity(mp_bc_runtime_t *self) {
+    if (self->arg_n_args < self->arg_n_min) {
+        #if MICROPY_ERROR_REPORTING <= MICROPY_ERROR_REPORTING_TERSE
+        mp_bc_runtime_arg_error_terse_mismatch(self);
+        #else
+        mp_raise_msg_varg(&mp_type_TypeError,
+            MP_ERROR_TEXT("function missing %d required positional arguments"),
+            self->arg_n_min - self->arg_n_args);
+        #endif
+    }
+}
+
+STATIC void mp_bc_runtime_check_max_arity(mp_bc_runtime_t *self) {
+    if (self->arg_n_args > self->arg_n_max) {
+        #if MICROPY_ERROR_REPORTING <= MICROPY_ERROR_REPORTING_TERSE
+        mp_bc_runtime_arg_error_terse_mismatch(self);
+        #else
+        mp_raise_msg_varg(&mp_type_TypeError,
+            MP_ERROR_TEXT("function expected at most %d arguments, got %d"),
+            self->arg_n_max, self->arg_n_args);
+        #endif
+    }
+}
+
+STATIC void mp_bc_runtime_check_arity_range(mp_bc_runtime_t *self) {
+    if (self->arg_n_args < self->arg_n_min || self->arg_n_args > self->arg_n_max) {
+        mp_bc_runtime_check_min_arity(self);
+        mp_bc_runtime_check_max_arity(self);
+    }
+}
+
+void mp_bc_runtime_arg_check_num_sig(mp_bc_runtime_t *self) {
+    mp_bc_runtime_decode_arg_sig(self);
+    mp_bc_runtime_reject_unexpected_kwargs(self);
+    if (self->arg_n_min == self->arg_n_max) {
+        mp_bc_runtime_check_exact_arity(self);
+    } else {
+        mp_bc_runtime_check_arity_range(self);
+    }
+}
+
+STATIC void mp_bc_runtime_bind_arg_range(mp_bc_runtime_t *self) {
+    self->arg_sig = MP_OBJ_FUN_MAKE_SIG(self->arg_n_min, self->arg_n_max, self->arg_takes_kw);
+}
+
+mp_obj_t mp_bc_runtime_fun_builtin_fixed_call(mp_bc_runtime_t *self) {
+    self->fun_builtin_fixed = MP_OBJ_TO_PTR(self->fun_obj);
+    self->arg_n_args = self->n_args;
+    self->arg_n_kw = self->n_kw;
+    self->arg_n_min = self->fun_nfixed;
+    self->arg_n_max = self->fun_nfixed;
+    self->arg_takes_kw = false;
+    mp_bc_runtime_bind_arg_range(self);
+    mp_bc_runtime_arg_check_num_sig(self);
+    switch (self->fun_nfixed) {
+        case 0:
+            return self->fun_builtin_fixed->fun._0();
+        case 1:
+            return self->fun_builtin_fixed->fun._1(self->args[0]);
+        case 2:
+            return self->fun_builtin_fixed->fun._2(self->args[0], self->args[1]);
+        default:
+            return self->fun_builtin_fixed->fun._3(self->args[0], self->args[1], self->args[2]);
+    }
+}
+
+mp_obj_t mp_bc_runtime_fun_builtin_var_call(mp_bc_runtime_t *self) {
+    self->fun_builtin_var = MP_OBJ_TO_PTR(self->fun_obj);
+    self->arg_n_args = self->n_args;
+    self->arg_n_kw = self->n_kw;
+    self->arg_sig = self->fun_builtin_var->sig;
+    mp_bc_runtime_arg_check_num_sig(self);
+    if (self->arg_sig & 1) {
+        mp_map_t kw_args;
+        mp_map_init_fixed_table(&kw_args, self->n_kw, self->args + self->n_args);
+        return self->fun_builtin_var->fun.kw(self->n_args, self->args, &kw_args);
+    }
+    return self->fun_builtin_var->fun.var(self->n_args, self->args);
+}
+
+NORETURN void mp_bc_runtime_arg_error_terse_mismatch(mp_bc_runtime_t *self) {
+    (void)self->arg_sig;
+    mp_raise_TypeError(MP_ERROR_TEXT("argument num/types mismatch"));
+}
+
+#if MICROPY_CPYTHON_COMPAT
+NORETURN void mp_bc_runtime_arg_error_unimpl_kw(mp_bc_runtime_t *self) {
+    (void)self->arg_n_kw;
+    mp_raise_NotImplementedError(MP_ERROR_TEXT("keyword argument(s) not yet implemented - use normal args instead"));
+}
+#endif
+
+STATIC void mp_bc_runtime_take_positional_arg(mp_bc_runtime_t *self) {
+    if (self->arg_allowed[self->arg_index].flags & MP_ARG_KW_ONLY) {
+        #if MICROPY_ERROR_REPORTING <= MICROPY_ERROR_REPORTING_TERSE
+        mp_bc_runtime_arg_error_terse_mismatch(self);
+        #else
+        mp_raise_TypeError(MP_ERROR_TEXT("extra positional arguments given"));
+        #endif
+    }
+    self->arg_pos_found++;
+    self->arg_given = self->arg_pos[self->arg_index];
+}
+
+STATIC bool mp_bc_runtime_lookup_allowed_kw(mp_bc_runtime_t *self) {
+    mp_map_elem_t *kw = mp_map_lookup(self->arg_kws, MP_OBJ_NEW_QSTR(self->arg_allowed[self->arg_index].qst), MP_MAP_LOOKUP);
+    if (kw == NULL) {
+        if (self->arg_allowed[self->arg_index].flags & MP_ARG_REQUIRED) {
+            #if MICROPY_ERROR_REPORTING <= MICROPY_ERROR_REPORTING_TERSE
+            mp_bc_runtime_arg_error_terse_mismatch(self);
+            #else
+            mp_raise_msg_varg(&mp_type_TypeError, MP_ERROR_TEXT("'%q' argument required"), self->arg_allowed[self->arg_index].qst);
+            #endif
+        }
+        self->arg_out_vals[self->arg_index] = self->arg_allowed[self->arg_index].defval;
+        return false;
+    }
+    self->arg_kws_found++;
+    self->arg_given = kw->value;
+    return true;
+}
+
+STATIC void mp_bc_runtime_coerce_allowed_arg(mp_bc_runtime_t *self) {
+    if ((self->arg_allowed[self->arg_index].flags & MP_ARG_KIND_MASK) == MP_ARG_BOOL) {
+        self->arg_out_vals[self->arg_index].u_bool = mp_obj_is_true(self->arg_given);
+    } else if ((self->arg_allowed[self->arg_index].flags & MP_ARG_KIND_MASK) == MP_ARG_INT) {
+        self->arg_out_vals[self->arg_index].u_int = mp_obj_get_int(self->arg_given);
+    } else {
+        assert((self->arg_allowed[self->arg_index].flags & MP_ARG_KIND_MASK) == MP_ARG_OBJ);
+        self->arg_out_vals[self->arg_index].u_obj = self->arg_given;
+    }
+}
+
+STATIC void mp_bc_runtime_reject_extra_positional(mp_bc_runtime_t *self) {
+    if (self->arg_pos_found < self->arg_n_pos) {
+        #if MICROPY_ERROR_REPORTING <= MICROPY_ERROR_REPORTING_TERSE
+        mp_bc_runtime_arg_error_terse_mismatch(self);
+        #else
+        mp_raise_TypeError(MP_ERROR_TEXT("extra positional arguments given"));
+        #endif
+    }
+}
+
+STATIC void mp_bc_runtime_reject_extra_keywords(mp_bc_runtime_t *self) {
+    if (self->arg_kws_found < self->arg_kws->used) {
+        #if MICROPY_ERROR_REPORTING <= MICROPY_ERROR_REPORTING_TERSE
+        mp_bc_runtime_arg_error_terse_mismatch(self);
+        #else
+        mp_raise_TypeError(MP_ERROR_TEXT("extra keyword arguments given"));
+        #endif
+    }
+}
+
+void mp_bc_runtime_arg_parse_all(mp_bc_runtime_t *self) {
+    self->arg_pos_found = 0;
+    self->arg_kws_found = 0;
+    for (self->arg_index = 0; self->arg_index < self->arg_n_allowed; self->arg_index++) {
+        if (self->arg_index < self->arg_n_pos) {
+            mp_bc_runtime_take_positional_arg(self);
+        } else if (!mp_bc_runtime_lookup_allowed_kw(self)) {
+            continue;
+        }
+        mp_bc_runtime_coerce_allowed_arg(self);
+    }
+    mp_bc_runtime_reject_extra_positional(self);
+    mp_bc_runtime_reject_extra_keywords(self);
+}
+
+void mp_bc_runtime_arg_parse_all_kw_array(mp_bc_runtime_t *self) {
+    mp_map_t kw_args;
+    mp_map_init_fixed_table(&kw_args, self->arg_n_kw, self->arg_pos + self->arg_n_pos);
+    self->arg_kws = &kw_args;
+    mp_bc_runtime_arg_parse_all(self);
+}
+
+STATIC void mp_bc_runtime_dict_require_mutable(mp_bc_runtime_t *self) {
+    if (self->dict->map.is_fixed) {
+        mp_raise_TypeError(NULL);
+    }
+}
+
+STATIC void mp_bc_runtime_dict_bind_obj(mp_bc_runtime_t *self) {
+    mp_check_self(mp_obj_is_dict_or_ordereddict(self->dict_obj));
+    self->dict = MP_OBJ_TO_PTR(self->dict_obj);
+    self->dict_map = &self->dict->map;
+}
+
+mp_obj_t mp_bc_runtime_dict_store(mp_bc_runtime_t *self) {
+    mp_bc_runtime_dict_bind_obj(self);
+    mp_bc_runtime_dict_require_mutable(self);
+    self->dict_elem = mp_map_lookup(self->dict_map, self->dict_key, MP_MAP_LOOKUP_ADD_IF_NOT_FOUND);
+    self->dict_elem->value = self->dict_value;
+    return self->dict_obj;
+}
+
+void mp_bc_runtime_dict_init(mp_bc_runtime_t *self) {
+    self->dict->base.type = &mp_type_dict;
+    mp_map_init(&self->dict->map, self->dict_alloc_hint);
+    self->dict_map = &self->dict->map;
+}
+
+mp_obj_t mp_bc_runtime_new_dict(mp_bc_runtime_t *self) {
+    self->dict = m_new_obj(mp_obj_dict_t);
+    mp_bc_runtime_dict_init(self);
+    self->dict_obj = MP_OBJ_FROM_PTR(self->dict);
+    return self->dict_obj;
+}
+
+mp_obj_t mp_bc_runtime_dict_get(mp_bc_runtime_t *self) {
+    mp_bc_runtime_dict_bind_obj(self);
+    self->dict_elem = mp_map_lookup(self->dict_map, self->dict_key, MP_MAP_LOOKUP);
+    if (self->dict_elem == NULL) {
+        mp_raise_type_arg(&mp_type_KeyError, self->dict_key);
+    }
+    self->dict_value = self->dict_elem->value;
+    return self->dict_value;
+}
+
+STATIC mp_map_elem_t *mp_bc_runtime_dict_iter_next(mp_bc_runtime_t *self) {
+    size_t max = self->dict->map.alloc;
+    mp_map_t *map = &self->dict->map;
+    size_t i = self->dict_cur;
+    for (; i < max; i++) {
+        if (mp_map_slot_is_filled(map, i)) {
+            self->dict_cur = i + 1;
+            self->dict_elem = &(map->table[i]);
+            return self->dict_elem;
+        }
+    }
+    self->dict_elem = NULL;
+    return NULL;
+}
+
+mp_obj_t mp_bc_runtime_dict_delete(mp_bc_runtime_t *self) {
+    mp_bc_runtime_dict_bind_obj(self);
+    mp_bc_runtime_dict_require_mutable(self);
+    self->dict_elem = mp_map_lookup(self->dict_map, self->dict_key, MP_MAP_LOOKUP_REMOVE_IF_FOUND);
+    if (self->dict_elem == NULL || self->dict_elem->value == MP_OBJ_NULL) {
+        mp_raise_type_arg(&mp_type_KeyError, self->dict_key);
+    }
+    self->dict_value = self->dict_elem->value;
+    self->dict_elem->value = MP_OBJ_NULL;
+    return self->dict_obj;
+}
+
+size_t mp_bc_runtime_dict_len(mp_bc_runtime_t *self) {
+    mp_bc_runtime_dict_bind_obj(self);
+    return self->dict_map->used;
+}
+
+mp_obj_t mp_bc_runtime_dict_copy(mp_bc_runtime_t *self) {
+    mp_bc_runtime_dict_bind_obj(self);
+    mp_obj_t other_out = mp_obj_new_dict(self->dict->map.alloc);
+    mp_obj_dict_t *other = MP_OBJ_TO_PTR(other_out);
+    other->base.type = self->dict->base.type;
+    other->map.used = self->dict->map.used;
+    other->map.all_keys_are_qstrs = self->dict->map.all_keys_are_qstrs;
+    other->map.is_fixed = 0;
+    other->map.is_ordered = self->dict->map.is_ordered;
+    memcpy(other->map.table, self->dict->map.table, self->dict->map.alloc * sizeof(mp_map_elem_t));
+    self->dict_map = &other->map;
+    return other_out;
+}
+
+STATIC void mp_bc_runtime_dict_update_from_dict(mp_bc_runtime_t *self, mp_obj_dict_t *other) {
+    mp_bc_runtime_t other_rt;
+    mp_bc_runtime_init(&other_rt);
+    other_rt.dict = other;
+    other_rt.dict_map = &other->map;
+    other_rt.dict_cur = 0;
+    while (mp_bc_runtime_dict_iter_next(&other_rt) != NULL) {
+        mp_map_lookup(self->dict_map, other_rt.dict_elem->key, MP_MAP_LOOKUP_ADD_IF_NOT_FOUND)->value = other_rt.dict_elem->value;
+    }
+}
+
+STATIC void mp_bc_runtime_dict_update_from_seq(mp_bc_runtime_t *self) {
+    mp_obj_t iter = mp_getiter(self->dict_args[1], NULL);
+    mp_obj_t next = MP_OBJ_NULL;
+    while ((next = mp_iternext(iter)) != MP_OBJ_STOP_ITERATION) {
+        mp_obj_t inneriter = mp_getiter(next, NULL);
+        mp_obj_t key = mp_iternext(inneriter);
+        mp_obj_t value = mp_iternext(inneriter);
+        mp_obj_t stop = mp_iternext(inneriter);
+        if (key == MP_OBJ_STOP_ITERATION
+            || value == MP_OBJ_STOP_ITERATION
+            || stop != MP_OBJ_STOP_ITERATION) {
+            mp_raise_ValueError(MP_ERROR_TEXT("dict update sequence has wrong length"));
+        } else {
+            mp_map_lookup(self->dict_map, key, MP_MAP_LOOKUP_ADD_IF_NOT_FOUND)->value = value;
+        }
+    }
+}
+
+STATIC void mp_bc_runtime_dict_update_from_kwargs(mp_bc_runtime_t *self) {
+    for (size_t i = 0; i < self->dict_kwargs->alloc; i++) {
+        if (mp_map_slot_is_filled(self->dict_kwargs, i)) {
+            mp_map_lookup(self->dict_map, self->dict_kwargs->table[i].key, MP_MAP_LOOKUP_ADD_IF_NOT_FOUND)->value = self->dict_kwargs->table[i].value;
+        }
+    }
+}
+
+mp_obj_t mp_bc_runtime_dict_update(mp_bc_runtime_t *self) {
+    self->dict_obj = self->dict_args[0];
+    mp_bc_runtime_dict_bind_obj(self);
+    mp_bc_runtime_dict_require_mutable(self);
+    self->arg_n_args = self->dict_n_args;
+    self->arg_n_kw = self->dict_kwargs->used;
+    self->arg_n_min = 1;
+    self->arg_n_max = 2;
+    self->arg_takes_kw = true;
+    mp_bc_runtime_bind_arg_range(self);
+    mp_bc_runtime_arg_check_num_sig(self);
+    if (self->dict_n_args == 2) {
+        if (mp_obj_is_dict_or_ordereddict(self->dict_args[1])) {
+            if (self->dict_args[1] != self->dict_args[0]) {
+                mp_bc_runtime_dict_update_from_dict(self, MP_OBJ_TO_PTR(self->dict_args[1]));
+            }
+        } else {
+            mp_bc_runtime_dict_update_from_seq(self);
+        }
+    }
+    mp_bc_runtime_dict_update_from_kwargs(self);
+    return mp_const_none;
+}
