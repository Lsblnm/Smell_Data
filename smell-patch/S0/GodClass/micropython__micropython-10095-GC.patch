+}
+
+STATIC mp_uint_t mp_bc_runtime_uctypes_scalar_size(mp_bc_runtime_t *self) {
+    if (self->uct_val_type == MP_BC_UCT_FLOAT32) {
+        return 4;
+    }
+    return MP_BC_UCT_GET_SCALAR_SIZE(self->uct_val_type & 7);
+}
+
+STATIC mp_uint_t mp_bc_runtime_uctypes_size(mp_bc_runtime_t *self, mp_obj_t desc_in, int layout_type, mp_uint_t *max_field_size);
+
+STATIC mp_uint_t mp_bc_runtime_uctypes_agg_size(mp_bc_runtime_t *self, mp_obj_tuple_t *t, int layout_type, mp_uint_t *max_field_size) {
+    self->uct_tuple = t;
+    mp_int_t offset_ = MP_OBJ_SMALL_INT_VALUE(t->items[0]);
+    mp_uint_t agg_type = MP_BC_UCT_GET_TYPE(offset_, 2);
+    switch (agg_type) {
+        case MP_BC_UCT_STRUCT:
+            return mp_bc_runtime_uctypes_size(self, t->items[1], layout_type, max_field_size);
+        case MP_BC_UCT_PTR:
+            if (sizeof(void *) > *max_field_size) {
+                *max_field_size = sizeof(void *);
+            }
+            return sizeof(void *);
+        case MP_BC_UCT_ARRAY: {
+            mp_int_t arr_sz = MP_OBJ_SMALL_INT_VALUE(t->items[1]);
+            uint val_type = MP_BC_UCT_GET_TYPE(arr_sz, MP_BC_UCT_VAL_TYPE_BITS);
+            arr_sz &= MP_BC_UCT_VALUE_MASK(MP_BC_UCT_VAL_TYPE_BITS);
+            mp_uint_t item_s;
+            if (t->len == 2) {
+                self->uct_val_type = val_type;
+                item_s = mp_bc_runtime_uctypes_scalar_size(self);
+                if (item_s > *max_field_size) {
+                    *max_field_size = item_s;
+                }
+            } else {
+                item_s = mp_bc_runtime_uctypes_size(self, t->items[2], layout_type, max_field_size);
+            }
+            return item_s * arr_sz;
+        }
+        default:
+            assert(0);
+            return 0;
+    }
+}
+
+STATIC mp_uint_t mp_bc_runtime_uctypes_size(mp_bc_runtime_t *self, mp_obj_t desc_in, int layout_type, mp_uint_t *max_field_size) {
+    self->uct_desc = desc_in;
+    self->uct_layout = layout_type;
+    if (!mp_obj_is_dict_or_ordereddict(desc_in)) {
+        if (mp_obj_is_type(desc_in, &mp_type_tuple)) {
+            return mp_bc_runtime_uctypes_agg_size(self, (mp_obj_tuple_t *)MP_OBJ_TO_PTR(desc_in), layout_type, max_field_size);
+        } else if (mp_obj_is_small_int(desc_in)) {
+            mp_raise_TypeError(MP_ERROR_TEXT("can't unambiguously get sizeof scalar"));
+        }
+        mp_bc_runtime_uctypes_syntax_error(self);
+    }
+
+    mp_obj_dict_t *d = MP_OBJ_TO_PTR(desc_in);
+    mp_uint_t total_size = 0;
+    for (mp_uint_t i = 0; i < d->map.alloc; i++) {
+        if (mp_map_slot_is_filled(&d->map, i)) {
+            mp_obj_t v = d->map.table[i].value;
+            if (mp_obj_is_small_int(v)) {
+                mp_uint_t offset = MP_OBJ_SMALL_INT_VALUE(v);
+                mp_uint_t val_type = MP_BC_UCT_GET_TYPE(offset, MP_BC_UCT_VAL_TYPE_BITS);
+                offset &= MP_BC_UCT_VALUE_MASK(MP_BC_UCT_VAL_TYPE_BITS);
+                if (val_type >= MP_BC_UCT_BFUINT8 && val_type <= MP_BC_UCT_BFINT32) {
+                    offset &= (1 << MP_BC_UCT_OFFSET_BITS) - 1;
+                }
+                self->uct_val_type = val_type;
+                mp_uint_t s = mp_bc_runtime_uctypes_scalar_size(self);
+                if (s > *max_field_size) {
+                    *max_field_size = s;
+                }
+                if (offset + s > total_size) {
+                    total_size = offset + s;
+                }
+            } else {
+                if (!mp_obj_is_type(v, &mp_type_tuple)) {
+                    mp_bc_runtime_uctypes_syntax_error(self);
+                }
+                mp_obj_tuple_t *t = MP_OBJ_TO_PTR(v);
+                mp_int_t offset = MP_OBJ_SMALL_INT_VALUE(t->items[0]);
+                offset &= MP_BC_UCT_VALUE_MASK(2);
+                mp_uint_t s = mp_bc_runtime_uctypes_agg_size(self, t, layout_type, max_field_size);
+                if (offset + s > total_size) {
+                    total_size = offset + s;
+                }
+            }
+        }
+    }
+    if (layout_type == MP_BC_UCT_LAYOUT_NATIVE) {
+        total_size = (total_size + *max_field_size - 1) & ~(*max_field_size - 1);
+    }
+    self->uct_size = total_size;
+    return total_size;
+}
+
+STATIC mp_obj_t mp_bc_runtime_uctypes_get_unaligned(mp_bc_runtime_t *self) {
+    char struct_type = self->uct_big_endian ? '>' : '<';
+    static const char type2char[16] = "BbHhIiQq------fd";
+    byte *p = self->uct_addr;
+    return mp_binary_get_val(struct_type, type2char[self->uct_val_type], p, &p);
+}
+
+STATIC void mp_bc_runtime_uctypes_set_unaligned(mp_bc_runtime_t *self) {
+    char struct_type = self->uct_big_endian ? '>' : '<';
+    static const char type2char[16] = "BbHhIiQq------fd";
+    byte *p = self->uct_addr;
+    mp_binary_set_val(struct_type, type2char[self->uct_val_type], self->uct_value, p, &p);
+}
+
+STATIC mp_uint_t mp_bc_runtime_uctypes_get_aligned_basic(mp_bc_runtime_t *self) {
+    void *p = self->uct_addr;
+    switch (self->uct_val_type) {
+        case MP_BC_UCT_UINT8:
+            return *(uint8_t *)p;
+        case MP_BC_UCT_UINT16:
+            return *(uint16_t *)p;
+        case MP_BC_UCT_UINT32:
+            return *(uint32_t *)p;
+    }
+    assert(0);
+    return 0;
+}
+
+STATIC void mp_bc_runtime_uctypes_set_aligned_basic(mp_bc_runtime_t *self, mp_uint_t v) {
+    void *p = self->uct_addr;
+    switch (self->uct_val_type) {
+        case MP_BC_UCT_UINT8:
+            *(uint8_t *)p = (uint8_t)v;
+            return;
+        case MP_BC_UCT_UINT16:
+            *(uint16_t *)p = (uint16_t)v;
+            return;
+        case MP_BC_UCT_UINT32:
+            *(uint32_t *)p = (uint32_t)v;
+            return;
+    }
+    assert(0);
+}
+
+STATIC mp_obj_t mp_bc_runtime_uctypes_get_aligned(mp_bc_runtime_t *self) {
+    void *p = self->uct_addr;
+    mp_int_t index = self->uct_index;
+    switch (self->uct_val_type) {
+        case MP_BC_UCT_UINT8:
+            return MP_OBJ_NEW_SMALL_INT(((uint8_t *)p)[index]);
+        case MP_BC_UCT_INT8:
+            return MP_OBJ_NEW_SMALL_INT(((int8_t *)p)[index]);
+        case MP_BC_UCT_UINT16:
+            return MP_OBJ_NEW_SMALL_INT(((uint16_t *)p)[index]);
+        case MP_BC_UCT_INT16:
+            return MP_OBJ_NEW_SMALL_INT(((int16_t *)p)[index]);
+        case MP_BC_UCT_UINT32:
+            return mp_obj_new_int_from_uint(((uint32_t *)p)[index]);
+        case MP_BC_UCT_INT32:
+            return mp_obj_new_int(((int32_t *)p)[index]);
+        case MP_BC_UCT_UINT64:
+            return mp_obj_new_int_from_ull(((uint64_t *)p)[index]);
+        case MP_BC_UCT_INT64:
+            return mp_obj_new_int_from_ll(((int64_t *)p)[index]);
+        #if MICROPY_PY_BUILTINS_FLOAT
+        case MP_BC_UCT_FLOAT32:
+            return mp_obj_new_float_from_f(((float *)p)[index]);
+        case MP_BC_UCT_FLOAT64:
+            return mp_obj_new_float_from_d(((double *)p)[index]);
+        #endif
+        default:
+            assert(0);
+            return MP_OBJ_NULL;
+    }
+}
+
+STATIC void mp_bc_runtime_uctypes_set_aligned(mp_bc_runtime_t *self) {
+    void *p = self->uct_addr;
+    mp_int_t index = self->uct_index;
+    mp_obj_t val = self->uct_value;
+    #if MICROPY_PY_BUILTINS_FLOAT
+    if (self->uct_val_type == MP_BC_UCT_FLOAT32 || self->uct_val_type == MP_BC_UCT_FLOAT64) {
+        if (self->uct_val_type == MP_BC_UCT_FLOAT32) {
+            ((float *)p)[index] = mp_obj_get_float_to_f(val);
+        } else {
+            ((double *)p)[index] = mp_obj_get_float_to_d(val);
+        }
+        return;
+    }
+    #endif
+    mp_int_t v = mp_obj_get_int_truncated(val);
+    switch (self->uct_val_type) {
+        case MP_BC_UCT_UINT8:
+            ((uint8_t *)p)[index] = (uint8_t)v;
+            return;
+        case MP_BC_UCT_INT8:
+            ((int8_t *)p)[index] = (int8_t)v;
+            return;
+        case MP_BC_UCT_UINT16:
+            ((uint16_t *)p)[index] = (uint16_t)v;
+            return;
+        case MP_BC_UCT_INT16:
+            ((int16_t *)p)[index] = (int16_t)v;
+            return;
+        case MP_BC_UCT_UINT32:
+            ((uint32_t *)p)[index] = (uint32_t)v;
+            return;
+        case MP_BC_UCT_INT32:
+            ((int32_t *)p)[index] = (int32_t)v;
+            return;
+        case MP_BC_UCT_INT64:
+        case MP_BC_UCT_UINT64:
+            if (sizeof(mp_int_t) == 8) {
+                ((uint64_t *)p)[index] = (uint64_t)v;
+            } else {
+                self->uct_addr = (byte *)&((uint64_t *)p)[index];
+                self->uct_big_endian = MP_ENDIANNESS_BIG;
+                mp_bc_runtime_uctypes_set_unaligned(self);
+            }
+            return;
+        default:
+            assert(0);
+    }
+}
+
+STATIC mp_obj_t mp_bc_runtime_uctypes_make_substruct(mp_bc_runtime_t *self, mp_obj_t desc, byte *addr) {
+    mp_obj_uctypes_struct_t *o = mp_obj_malloc(mp_obj_uctypes_struct_t, self->uct_type);
+    o->desc = desc;
+    o->addr = addr;
+    o->flags = self->uct_flags;
+    return MP_OBJ_FROM_PTR(o);
+}
+
+STATIC mp_obj_t mp_bc_runtime_uctypes_attr_op(mp_bc_runtime_t *self) {
+    mp_obj_uctypes_struct_t *obj = MP_OBJ_TO_PTR(self->uct_obj);
+    self->uct_desc = obj->desc;
+    self->uct_addr = obj->addr;
+    self->uct_flags = obj->flags;
+    if (!mp_obj_is_dict_or_ordereddict(self->uct_desc)) {
+        mp_raise_TypeError(MP_ERROR_TEXT("struct: no fields"));
+    }
+    mp_obj_t deref = mp_obj_dict_get(self->uct_desc, MP_OBJ_NEW_QSTR(self->uct_attr));
+    if (mp_obj_is_small_int(deref)) {
+        mp_int_t offset = MP_OBJ_SMALL_INT_VALUE(deref);
+        mp_uint_t val_type = MP_BC_UCT_GET_TYPE(offset, MP_BC_UCT_VAL_TYPE_BITS);
+        offset &= MP_BC_UCT_VALUE_MASK(MP_BC_UCT_VAL_TYPE_BITS);
+        self->uct_val_type = val_type;
+        if (val_type <= MP_BC_UCT_INT64 || val_type == MP_BC_UCT_FLOAT32 || val_type == MP_BC_UCT_FLOAT64) {
+            self->uct_index = 0;
+            if (self->uct_flags == MP_BC_UCT_LAYOUT_NATIVE) {
+                byte *saved = self->uct_addr;
+                self->uct_addr = saved + offset;
+                if (self->uct_value == MP_OBJ_NULL) {
+                    return mp_bc_runtime_uctypes_get_aligned(self);
+                }
+                mp_bc_runtime_uctypes_set_aligned(self);
+                return self->uct_value;
+            }
+            self->uct_big_endian = self->uct_flags;
+            self->uct_addr = self->uct_addr + offset;
+            if (self->uct_value == MP_OBJ_NULL) {
+                return mp_bc_runtime_uctypes_get_unaligned(self);
+            }
+            mp_bc_runtime_uctypes_set_unaligned(self);
+            return self->uct_value;
+        } else if (val_type >= MP_BC_UCT_BFUINT8 && val_type <= MP_BC_UCT_BFINT32) {
+            uint bit_offset = (offset >> MP_BC_UCT_OFFSET_BITS) & 31;
+            uint bit_len = (offset >> MP_BC_UCT_LEN_BITS) & 31;
+            offset &= (1 << MP_BC_UCT_OFFSET_BITS) - 1;
+            mp_uint_t val;
+            byte *base = self->uct_addr + offset;
+            if (self->uct_flags == MP_BC_UCT_LAYOUT_NATIVE) {
+                self->uct_val_type = val_type & 6;
+                self->uct_addr = base;
+                val = mp_bc_runtime_uctypes_get_aligned_basic(self);
+            } else {
+                val = mp_binary_get_int(MP_BC_UCT_GET_SCALAR_SIZE(val_type & 7), val_type & 1, self->uct_flags, base);
+            }
+            if (self->uct_value == MP_OBJ_NULL) {
+                val >>= bit_offset;
+                val &= (1 << bit_len) - 1;
+                assert((val_type & 1) == 0);
+                return mp_obj_new_int(val);
+            }
+            mp_uint_t set_val_int = (mp_uint_t)mp_obj_get_int(self->uct_value);
+            mp_uint_t mask = (1 << bit_len) - 1;
+            set_val_int &= mask;
+            set_val_int <<= bit_offset;
+            mask <<= bit_offset;
+            val = (val & ~mask) | set_val_int;
+            if (self->uct_flags == MP_BC_UCT_LAYOUT_NATIVE) {
+                self->uct_val_type = val_type & 6;
+                self->uct_addr = base;
+                mp_bc_runtime_uctypes_set_aligned_basic(self, val);
+            } else {
+                mp_binary_set_int(MP_BC_UCT_GET_SCALAR_SIZE(val_type & 7), self->uct_flags == MP_BC_UCT_LAYOUT_BIG_ENDIAN, base, val);
+            }
+            return self->uct_value;
+        }
+        assert(0);
+        return MP_OBJ_NULL;
+    }
+    if (!mp_obj_is_type(deref, &mp_type_tuple)) {
+        mp_bc_runtime_uctypes_syntax_error(self);
+    }
+    if (self->uct_value != MP_OBJ_NULL) {
+        mp_bc_runtime_uctypes_syntax_error(self);
+    }
+    mp_obj_tuple_t *sub = MP_OBJ_TO_PTR(deref);
+    mp_int_t offset = MP_OBJ_SMALL_INT_VALUE(sub->items[0]);
+    mp_uint_t agg_type = MP_BC_UCT_GET_TYPE(offset, 2);
+    offset &= MP_BC_UCT_VALUE_MASK(2);
+    switch (agg_type) {
+        case MP_BC_UCT_STRUCT:
+            return mp_bc_runtime_uctypes_make_substruct(self, sub->items[1], obj->addr + offset);
+        case MP_BC_UCT_ARRAY: {
+            mp_uint_t dummy = 0;
+            if (sub->len == 2 && MP_BC_UCT_GET_TYPE(MP_OBJ_SMALL_INT_VALUE(sub->items[1]), MP_BC_UCT_VAL_TYPE_BITS) == MP_BC_UCT_UINT8) {
+                return mp_obj_new_bytearray_by_ref(mp_bc_runtime_uctypes_agg_size(self, sub, obj->flags, &dummy), obj->addr + offset);
+            }
+            MP_FALLTHROUGH
+        }
+        case MP_BC_UCT_PTR:
+            return mp_bc_runtime_uctypes_make_substruct(self, MP_OBJ_FROM_PTR(sub), obj->addr + offset);
+        default:
+            assert(0);
+            return MP_OBJ_NULL;
+    }
+}
+
+mp_obj_t mp_bc_runtime_uctypes_make_new(mp_bc_runtime_t *self) {
+    self->arg_n_args = self->uct_n_args;
+    self->arg_n_kw = self->uct_n_kw;
+    self->arg_n_min = 2;
+    self->arg_n_max = 3;
+    self->arg_takes_kw = false;
+    mp_bc_runtime_bind_arg_range(self);
+    mp_bc_runtime_arg_check_num_sig(self);
+    mp_obj_uctypes_struct_t *o = mp_obj_malloc(mp_obj_uctypes_struct_t, self->uct_type);
+    o->addr = (void *)(uintptr_t)mp_obj_int_get_truncated(self->uct_args[0]);
+    o->desc = self->uct_args[1];
+    o->flags = MP_BC_UCT_LAYOUT_NATIVE;
+    if (self->uct_n_args == 3) {
+        o->flags = mp_obj_get_int(self->uct_args[2]);
+    }
+    self->uct_addr = o->addr;
+    self->uct_desc = o->desc;
+    self->uct_flags = o->flags;
+    return MP_OBJ_FROM_PTR(o);
+}
+
+void mp_bc_runtime_uctypes_print(mp_bc_runtime_t *self) {
+    (void)self->uct_print_kind;
+    mp_obj_uctypes_struct_t *obj = MP_OBJ_TO_PTR(self->uct_obj);
+    self->uct_desc = obj->desc;
+    self->uct_addr = obj->addr;
+    const char *typen = "unk";
+    if (mp_obj_is_dict_or_ordereddict(self->uct_desc)) {
+        typen = "STRUCT";
+    } else if (mp_obj_is_type(self->uct_desc, &mp_type_tuple)) {
+        mp_obj_tuple_t *t = MP_OBJ_TO_PTR(self->uct_desc);
+        mp_int_t offset = MP_OBJ_SMALL_INT_VALUE(t->items[0]);
+        uint agg_type = MP_BC_UCT_GET_TYPE(offset, 2);
+        switch (agg_type) {
+            case MP_BC_UCT_PTR:
+                typen = "PTR";
+                break;
+            case MP_BC_UCT_ARRAY:
+                typen = "ARRAY";
+                break;
+        }
+    } else {
+        typen = "ERROR";
+    }
+    mp_printf(self->uct_print, "<struct %s %p>", typen, self->uct_addr);
+}
+
+void mp_bc_runtime_uctypes_attr(mp_bc_runtime_t *self) {
+    if (self->uct_dest[0] == MP_OBJ_NULL) {
+        self->uct_value = MP_OBJ_NULL;
+        self->uct_dest[0] = mp_bc_runtime_uctypes_attr_op(self);
+    } else {
+        self->uct_value = self->uct_dest[1];
+        if (mp_bc_runtime_uctypes_attr_op(self) != MP_OBJ_NULL) {
+            self->uct_dest[0] = MP_OBJ_NULL;
+        }
+    }
+}
+
+mp_obj_t mp_bc_runtime_uctypes_subscr(mp_bc_runtime_t *self) {
+    mp_obj_uctypes_struct_t *obj = MP_OBJ_TO_PTR(self->uct_obj);
+    self->uct_desc = obj->desc;
+    self->uct_addr = obj->addr;
+    self->uct_flags = obj->flags;
+    if (self->uct_value == MP_OBJ_NULL) {
+        return MP_OBJ_NULL;
+    }
+    if (!mp_obj_is_type(self->uct_desc, &mp_type_tuple)) {
+        mp_raise_TypeError(MP_ERROR_TEXT("struct: can't index"));
+    }
+    mp_obj_tuple_t *t = MP_OBJ_TO_PTR(self->uct_desc);
+    mp_int_t offset = MP_OBJ_SMALL_INT_VALUE(t->items[0]);
+    uint agg_type = MP_BC_UCT_GET_TYPE(offset, 2);
+    self->uct_index = MP_OBJ_SMALL_INT_VALUE(self->uct_index_obj);
+    if (agg_type == MP_BC_UCT_ARRAY) {
+        mp_int_t arr_sz = MP_OBJ_SMALL_INT_VALUE(t->items[1]);
+        uint val_type = MP_BC_UCT_GET_TYPE(arr_sz, MP_BC_UCT_VAL_TYPE_BITS);
+        arr_sz &= MP_BC_UCT_VALUE_MASK(MP_BC_UCT_VAL_TYPE_BITS);
+        if (self->uct_index >= arr_sz) {
+            mp_raise_msg(&mp_type_IndexError, MP_ERROR_TEXT("struct: index out of range"));
+        }
+        if (t->len == 2) {
+            self->uct_val_type = val_type;
+            if (self->uct_flags == MP_BC_UCT_LAYOUT_NATIVE) {
+                if (self->uct_value == MP_OBJ_SENTINEL) {
+                    return mp_bc_runtime_uctypes_get_aligned(self);
+                }
+                mp_bc_runtime_uctypes_set_aligned(self);
+                return self->uct_value;
+            }
+            self->uct_val_type = val_type;
+            byte *p = obj->addr + mp_bc_runtime_uctypes_scalar_size(self) * self->uct_index;
+            self->uct_addr = p;
+            self->uct_big_endian = self->uct_flags;
+            if (self->uct_value == MP_OBJ_SENTINEL) {
+                return mp_bc_runtime_uctypes_get_unaligned(self);
+            }
+            mp_bc_runtime_uctypes_set_unaligned(self);
+            return self->uct_value;
+        } else if (self->uct_value == MP_OBJ_SENTINEL) {
+            mp_uint_t dummy = 0;
+            mp_uint_t size = mp_bc_runtime_uctypes_size(self, t->items[2], self->uct_flags, &dummy);
+            return mp_bc_runtime_uctypes_make_substruct(self, t->items[2], obj->addr + size * self->uct_index);
+        }
+        return MP_OBJ_NULL;
+    } else if (agg_type == MP_BC_UCT_PTR) {
+        byte *p = *(void **)obj->addr;
+        if (mp_obj_is_small_int(t->items[1])) {
+            self->uct_val_type = MP_BC_UCT_GET_TYPE(MP_OBJ_SMALL_INT_VALUE(t->items[1]), MP_BC_UCT_VAL_TYPE_BITS);
+            self->uct_addr = p;
+            return mp_bc_runtime_uctypes_get_aligned(self);
+        }
+        mp_uint_t dummy = 0;
+        mp_uint_t size = mp_bc_runtime_uctypes_size(self, t->items[1], self->uct_flags, &dummy);
+        return mp_bc_runtime_uctypes_make_substruct(self, t->items[1], p + size * self->uct_index);
+    }
+    assert(0);
+    return MP_OBJ_NULL;
+}
+
+mp_obj_t mp_bc_runtime_uctypes_unary_op(mp_bc_runtime_t *self) {
+    mp_obj_uctypes_struct_t *obj = MP_OBJ_TO_PTR(self->uct_obj);
+    self->uct_desc = obj->desc;
+    self->uct_addr = obj->addr;
+    switch (self->uct_unary_op) {
+        case MP_UNARY_OP_INT:
+            if (mp_obj_is_type(self->uct_desc, &mp_type_tuple)) {
+                mp_obj_tuple_t *t = MP_OBJ_TO_PTR(self->uct_desc);
+                mp_int_t offset = MP_OBJ_SMALL_INT_VALUE(t->items[0]);
+                uint agg_type = MP_BC_UCT_GET_TYPE(offset, 2);
+                if (agg_type == MP_BC_UCT_PTR) {
+                    byte *p = *(void **)self->uct_addr;
+                    return mp_obj_new_int((mp_int_t)(uintptr_t)p);
+                }
+            }
+            MP_FALLTHROUGH
+        default:
+            return MP_OBJ_NULL;
+    }
+}
+
+mp_int_t mp_bc_runtime_uctypes_get_buffer(mp_bc_runtime_t *self) {
+    mp_obj_uctypes_struct_t *obj = MP_OBJ_TO_PTR(self->uct_obj);
+    self->uct_desc = obj->desc;
+    self->uct_addr = obj->addr;
+    self->uct_flags = obj->flags;
