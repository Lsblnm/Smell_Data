+    mp_uint_t max_field_size = 0;
+    if (mp_obj_is_type(obj_in, &mp_type_bytearray)) {
+        return mp_obj_len(obj_in);
+    }
+    int layout_type = MP_BC_UCT_LAYOUT_NATIVE;
