+mp_obj_t mp_bc_runtime_uctypes_bytearray_at(mp_bc_runtime_t *self) {
+    return mp_obj_new_bytearray_by_ref(mp_obj_int_get_truncated(self->uct_value), (void *)(uintptr_t)mp_obj_int_get_truncated(self->uct_obj));
+}
+
+mp_obj_t mp_bc_runtime_uctypes_bytes_at(mp_bc_runtime_t *self) {
