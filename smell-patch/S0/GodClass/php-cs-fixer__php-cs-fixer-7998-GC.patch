+            T_NEW,
+            CT::T_NULLABLE_TYPE,
+            CT::T_TYPE_ALTERNATION,
+            CT::T_TYPE_INTERSECTION,
+            CT::T_TYPE_COLON,
+            CT::T_USE_TRAIT,
