+        return $this->isClassyImplementsOrTraitUseList($prev);
+    }
+
+    private function isClassyFunctionReferenceParameter(int $prev, int $next, Token $nextToken): bool
+    {
+        $tokens = $this->classyInvocationTokens;
+        if (null === $tokens) {
+            return false;
+        }
+
+        $nextNext = $tokens->getNextMeaningfulToken($next);
+        if (!$nextToken->equals('&') || null === $nextNext || !$tokens[$nextNext]->isGivenKind(T_VARIABLE)) {
+            return false;
+        }
