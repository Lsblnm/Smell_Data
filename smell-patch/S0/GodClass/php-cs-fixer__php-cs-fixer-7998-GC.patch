+            return false;
+        }
+
+        while ($tokens[$prev]->isGivenKind([CT::T_NAMESPACE_OPERATOR, T_NS_SEPARATOR, T_STRING])) {
+            $prev = $tokens->getPrevMeaningfulToken($prev);
+            if (null === $prev) {
+                return false;
+            }
+        }
+
+        $prevToken = $tokens[$prev];
+        if ($prevToken->isGivenKind($this->classyInvocationForbiddenPrevKinds)) {
+            return true;
+        }
+
+        if (\PHP_VERSION_ID >= 8_00_00 && $nextToken->equals(')') && $prevToken->equals('(')) {
+            $catchIndex = $tokens->getPrevMeaningfulToken($prev);
