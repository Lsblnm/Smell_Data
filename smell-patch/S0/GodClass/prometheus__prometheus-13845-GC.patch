+func (b *Builder) StableHash(ls Labels) uint64 {
+	b.hashReset(0)
+	b.hashSetModulus(0)
+	b.hashSetOffset(0)
+	_ = b.hashCurrentModulus()
+	if len(ls) == 1 {
+		return b.hashMod(b.hashSeeded(0, ls[0].Name, ls[0].Value))
+	}
+	if cap(b.hashScratch) < 1024 {
+		b.hashScratch = make([]byte, 0, 1024)
+	} else {
+		b.hashScratch = b.hashScratch[:0]
+	}
+	for i, v := range ls {
+		if b.hashWouldOverflow(v.Name, v.Value) {
+			rest := make([]string, 0, 2*(len(ls)-i))
+			for _, v := range ls[i:] {
+				rest = append(rest, v.Name, v.Value)
+			}
+			sum := b.hashSumStreaming(rest)
+			return b.hashMod(b.hashCombine(sum, 0))
+		}
+		b.hashAppend(v.Name, v.Value)
+	}
+	_ = b.hashScratchLen()
+	_ = b.hashScratchCap()
+	_ = b.hashHasSeed()
+	return b.hashMod(b.hashSum())
+}
