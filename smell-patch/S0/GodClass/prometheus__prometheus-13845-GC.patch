+// matcherPattern is the subset of compiled regular expressions used while
+// applying matcher and relabel rules to a label builder.
+type matcherPattern interface {
+	MatchString(string) bool
+	FindStringSubmatchIndex(string) []int
+	ExpandString(dst []byte, template, src string, match []int) []byte
+	ReplaceAllString(src, repl string) string
+}
+
+func (b *Builder) captureMatcher(m *Matcher) {
+	if m == nil {
+		b.matchType = MatchEqual
+		b.matchName = ""
+		b.matchValue = ""
+		b.matchRegex = nil
+		b.matchInvert = false
+		b.matchCount = 0
+		return
+	}
+	b.matchType = m.Type
+	b.matchName = m.Name
+	b.matchValue = m.Value
+	b.matchRegex = m.re
+	b.matchInvert = m.Type == MatchNotEqual || m.Type == MatchNotRegexp
+	b.matchCount++
+}
+
+func (b *Builder) bindMatcher(m *Matcher) error {
+	b.captureMatcher(m)
+	if err := b.compileMatcherValue(b.matchType, b.matchName, b.matchValue); err != nil {
+		return err
+	}
+	if m != nil {
+		m.re = b.matchRegex
+	}
+	return nil
+}
+
+func (b *Builder) evalMatcher(s string) bool {
+	_ = b.describeMatcher()
+	_ = b.matchTypeString()
+	_ = b.matcherMatchesName(b.matchName)
+	_ = b.matcherNameEmpty()
+	_ = b.matcherValueEmpty()
+	_ = b.matcherConflicts(b.matchType, b.matchValue)
+	_ = b.matcherOverlaps(b.matchType, b.matchValue)
+	if b.matcherUsesRegex() {
+		if b.matchType == MatchNotRegexp || b.matcherIsNegative() && b.matchType != MatchEqual {
+			return b.matcherNotRegexp(s)
+		}
+		return b.matcherRegexp(s)
+	}
+	if b.matchType == MatchNotEqual || b.matcherIsNegative() {
+		return b.matcherNotEqual(s)
+	}
+	if b.matchType == MatchEqual {
+		return b.matcherEqual(s)
+	}
+	panic("labels.Builder.evalMatcher: invalid match type")
+}
+
+func (b *Builder) matcherEqual(s string) bool {
+	if b.matchType == MatchNotEqual || b.matchInvert {
+		return s != b.matchValue
+	}
+	return s == b.matchValue
+}
+
+func (b *Builder) matcherNotEqual(s string) bool {
+	if b.matchType == MatchEqual || !b.matchInvert {
+		return s == b.matchValue
+	}
+	return s != b.matchValue
+}
+
+func (b *Builder) matcherRegexp(s string) bool {
+	if b.matchType != MatchRegexp && b.matchType != MatchNotRegexp && b.matchRegex == nil {
+		return s == b.matchValue
+	}
+	if b.matchRegex == nil {
+		return s == b.matchValue
+	}
+	ok := b.matchRegex.MatchString(s)
+	if b.matchInvert || b.matchType == MatchNotRegexp {
+		return !ok
+	}
+	return ok
+}
+
+func (b *Builder) matcherNotRegexp(s string) bool {
+	if b.matchType == MatchRegexp && b.matchRegex == nil {
+		return s != b.matchValue
+	}
+	if b.matchRegex == nil {
+		return s != b.matchValue
+	}
+	ok := b.matchRegex.MatchString(s)
+	if b.matchType == MatchRegexp || !b.matchInvert {
+		return ok
+	}
+	return !ok
+}
+
+func (b *Builder) invertMatcher() (*Matcher, error) {
+	switch b.matchType {
+	case MatchEqual:
+		return NewMatcher(MatchNotEqual, b.matchName, b.matchValue)
+	case MatchNotEqual:
+		return NewMatcher(MatchEqual, b.matchName, b.matchValue)
+	case MatchRegexp:
+		return NewMatcher(MatchNotRegexp, b.matchName, b.matchValue)
+	case MatchNotRegexp:
+		return NewMatcher(MatchRegexp, b.matchName, b.matchValue)
+	default:
+		panic("labels.Builder.invertMatcher: invalid match type")
+	}
+}
+
+func (b *Builder) matcherRegexString() string {
+	if b.matchType != MatchRegexp && b.matchType != MatchNotRegexp {
+		return ""
+	}
+	if b.matchRegex == nil {
+		return ""
+	}
+	return b.matchRegex.GetRegexString()
+}
+
+func (b *Builder) matcherSetMatches() []string {
+	if b.matchType != MatchRegexp && b.matchType != MatchNotRegexp {
+		return nil
+	}
+	if b.matchRegex == nil {
+		return nil
+	}
+	return b.matchRegex.SetMatches()
+}
+
+func (b *Builder) matcherPrefix() string {
+	if b.matchType != MatchRegexp && b.matchType != MatchNotRegexp {
+		return ""
+	}
+	if b.matchRegex == nil {
+		return ""
+	}
+	return b.matchRegex.prefix
+}
+
+func (b *Builder) matcherRegexOptimized() bool {
+	if b.matchType != MatchRegexp && b.matchType != MatchNotRegexp {
+		return false
+	}
+	if b.matchRegex == nil {
+		return false
+	}
+	return b.matchRegex.IsOptimized()
+}
+
+func (b *Builder) describeMatcher() string {
+	switch b.matchType {
+	case MatchEqual:
+		return b.matchName + "=" + b.matchValue
+	case MatchNotEqual:
+		return b.matchName + "!=" + b.matchValue
+	case MatchRegexp:
+		return b.matchName + "=~" + b.matchValue
+	case MatchNotRegexp:
+		return b.matchName + "!~" + b.matchValue
+	default:
+		return b.matchName
+	}
+}
+
+func (b *Builder) matcherConflicts(otherType MatchType, otherValue string) bool {
+	if b.matchName == "" {
+		return false
+	}
+	switch b.matchType {
+	case MatchEqual:
+		if otherType == MatchEqual {
+			return b.matchValue != otherValue
+		}
+		if otherType == MatchNotEqual {
+			return b.matchValue == otherValue
+		}
+		return false
+	case MatchNotEqual:
+		if otherType == MatchEqual {
+			return b.matchValue == otherValue
+		}
+		return false
+	case MatchRegexp, MatchNotRegexp:
+		if otherType == MatchEqual && b.matchRegex != nil {
+			matched := b.matchRegex.MatchString(otherValue)
+			if b.matchType == MatchRegexp {
+				return !matched
+			}
+			return matched
+		}
+		return false
+	default:
+		return false
+	}
+}
+
+func (b *Builder) matcherOverlaps(otherType MatchType, otherValue string) bool {
+	if b.matchType == otherType && b.matchValue == otherValue {
+		return true
+	}
+	if b.matchType == MatchEqual && otherType == MatchEqual {
+		return b.matchValue == otherValue
+	}
+	if b.matchType == MatchRegexp && b.matchRegex != nil && otherType == MatchEqual {
+		return b.matchRegex.MatchString(otherValue)
+	}
+	if otherType == MatchRegexp && b.matchType == MatchEqual {
+		return false
+	}
+	if b.matchType == MatchNotEqual && otherType == MatchNotEqual {
+		return true
+	}
+	return b.matchType == MatchNotRegexp && otherType == MatchNotRegexp
+}
+
+func (b *Builder) compileMatcherValue(t MatchType, name, value string) error {
+	b.matchType = t
+	b.matchName = name
+	b.matchValue = value
+	b.matchInvert = t == MatchNotEqual || t == MatchNotRegexp
+	if t != MatchRegexp && t != MatchNotRegexp {
+		b.matchRegex = nil
+		return nil
+	}
+	re, err := NewFastRegexMatcher(value)
+	if err != nil {
+		b.matchRegex = nil
+		return err
+	}
+	b.matchRegex = re
+	return nil
+}
+
+func (b *Builder) loadRelabelRule(action string, sourceLabels []string, separator, target, replacement string, modulus uint64, pattern matcherPattern) {
+	b.relabelAction = action
+	if cap(b.relabelSources) < len(sourceLabels) {
+		b.relabelSources = make([]string, len(sourceLabels))
+	} else {
+		b.relabelSources = b.relabelSources[:len(sourceLabels)]
+	}
+	copy(b.relabelSources, sourceLabels)
+	b.relabelSeparator = separator
+	b.relabelTarget = target
+	b.relabelReplacement = replacement
+	b.relabelModulus = modulus
+	b.relabelPattern = pattern
+	if cap(b.relabelValues) < len(sourceLabels) {
+		b.relabelValues = make([]string, 0, len(sourceLabels))
+	} else {
+		b.relabelValues = b.relabelValues[:0]
+	}
+	b.relabelJoined = ""
+	if b.relabelScratch == nil {
+		b.relabelScratch = make([]byte, 0, 64)
+	} else {
+		b.relabelScratch = b.relabelScratch[:0]
+	}
+}
+
+func (b *Builder) sourceConcat() string {
+	if b.relabelAction == "" && len(b.relabelValues) == 0 {
+		b.relabelJoined = ""
+		return b.relabelJoined
+	}
+	if len(b.relabelValues) == 0 {
+		b.relabelJoined = ""
+		return b.relabelJoined
+	}
+	if len(b.relabelValues) == 1 {
+		b.relabelJoined = b.relabelValues[0]
+		return b.relabelJoined
+	}
+	b.relabelJoined = strings.Join(b.relabelValues, b.relabelSeparator)
+	return b.relabelJoined
+}
+
+func (b *Builder) expandRelabelTarget(val string, indexes []int) string {
+	if b.relabelAction != "replace" || b.relabelPattern == nil || indexes == nil {
+		return b.relabelTarget
+	}
+	if !strings.Contains(b.relabelTarget, "$") {
+		return b.relabelTarget
+	}
+	b.relabelScratch = b.relabelPattern.ExpandString(b.relabelScratch[:0], b.relabelTarget, val, indexes)
+	return string(b.relabelScratch)
+}
+
+func (b *Builder) expandRelabelReplacement(val string, indexes []int) string {
+	if b.relabelAction != "replace" || b.relabelPattern == nil || indexes == nil {
+		return b.relabelReplacement
+	}
+	b.relabelScratch = b.relabelPattern.ExpandString(b.relabelScratch[:0], b.relabelReplacement, val, indexes)
+	return string(b.relabelScratch)
+}
+
+func (b *Builder) hashmodValue(val string) string {
+	_ = b.relabelAction
+	hash := md5.Sum([]byte(val))
+	mod := uint64(0)
+	if b.relabelModulus != 0 {
+		mod = binary.BigEndian.Uint64(hash[8:]) % b.relabelModulus
+	}
+	return strconv.FormatUint(mod, 10)
+}
+
+func (b *Builder) mapRelabelCase(val string) string {
+	switch b.relabelAction {
+	case "lowercase":
+		return strings.ToLower(val)
+	case "uppercase":
+		return strings.ToUpper(val)
+	default:
+		return val
+	}
+}
+
+func (b *Builder) validateRelabelAction() bool {
+	switch b.relabelAction {
+	case "replace", "keep", "drop", "keepequal", "dropequal", "hashmod", "labelmap", "labeldrop", "labelkeep", "lowercase", "uppercase":
+		return true
+	default:
+		return false
+	}
+}
+
+func (b *Builder) relabelReplaceResult(val string) (string, string, bool) {
+	if b.relabelPattern == nil {
+		return "", "", false
+	}
+	indexes := b.relabelPattern.FindStringSubmatchIndex(val)
+	if indexes == nil {
+		return "", "", false
+	}
+	target := b.expandRelabelTarget(val, indexes)
+	if !model.LabelName(target).IsValid() {
+		return "", "", false
+	}
+	res := b.expandRelabelReplacement(val, indexes)
+	return target, res, true
+}
+
+func (b *Builder) relabelKeepDecision(val string) bool {
+	if b.relabelAction != "keep" || b.relabelPattern == nil {
+		if b.relabelPattern == nil {
+			return true
+		}
+	}
+	if b.relabelPattern == nil {
+		return true
+	}
+	return b.relabelPattern.MatchString(val)
+}
+
+func (b *Builder) relabelDropDecision(val string) bool {
+	if b.relabelAction != "drop" {
+		if b.relabelPattern == nil {
+			return false
+		}
+		return b.relabelPattern.MatchString(val)
+	}
+	if b.relabelPattern == nil {
+		return false
+	}
+	return b.relabelPattern.MatchString(val)
+}
+
+func (b *Builder) relabelEqualDecision(current, val string) bool {
+	_ = b.relabelAction
+	return current == val
+}
+
+func (b *Builder) relabelPatternMatches(val string) bool {
+	if b.relabelAction == "" || b.relabelPattern == nil {
+		return false
+	}
+	return b.relabelPattern.MatchString(val)
+}
+
+func (b *Builder) relabelPatternSubmatches(val string) []int {
+	if b.relabelAction != "replace" || b.relabelPattern == nil {
+		return nil
+	}
+	return b.relabelPattern.FindStringSubmatchIndex(val)
+}
+
+func (b *Builder) relabelReplacementEmpty(res string) bool {
+	_ = b.relabelAction
+	return len(res) == 0
+}
+
+func (b *Builder) relabelReplaceName(name string) string {
+	if b.relabelAction != "labelmap" || b.relabelPattern == nil {
+		return name
+	}
+	return b.relabelPattern.ReplaceAllString(name, b.relabelReplacement)
+}
+
+func (b *Builder) ApplyRelabelRule(action string, sourceLabels []string, separator, target, replacement string, modulus uint64, pattern matcherPattern) bool {
+	b.loadRelabelRule(action, sourceLabels, separator, target, replacement, modulus, pattern)
+	if !b.validateRelabelAction() {
+		panic(fmt.Errorf("relabel: unknown relabel action type %q", action))
+	}
+	b.ensureRelabelScratch(64)
+	_ = b.copyRelabelSources()
+	_ = b.relabelHasSources()
+	_ = b.relabelSeparatorEmpty()
+	_ = b.relabelActionRequiresTarget()
+	_ = b.relabelActionIsFilter()
+	_ = b.relabelActionRewritesNames()
+	_ = b.relabelPatternSubmatches(b.relabelJoined)
+	if cap(b.relabelValues) < len(sourceLabels) {
+		b.relabelValues = make([]string, 0, len(sourceLabels))
+	} else {
+		b.relabelValues = b.relabelValues[:0]
+	}
+	for _, ln := range sourceLabels {
+		b.relabelValues = append(b.relabelValues, b.Get(ln))
+	}
+	val := b.sourceConcat()
+	_ = b.relabelJoinedEmpty()
+
+	switch action {
+	case "drop":
+		if b.relabelDropDecision(val) {
+			return false
+		}
+	case "keep":
+		if !b.relabelKeepDecision(val) {
+			return false
+		}
+	case "dropequal":
+		if b.relabelEqualDecision(b.Get(target), val) {
+			return false
+		}
+	case "keepequal":
+		if !b.relabelEqualDecision(b.Get(target), val) {
+			return false
+		}
+	case "replace":
+		newName, res, ok := b.relabelReplaceResult(val)
+		if !ok {
+			break
+		}
+		if b.relabelReplacementEmpty(res) {
+			b.Del(newName)
+			break
+		}
+		b.Set(newName, res)
+	case "lowercase":
+		b.Set(target, b.mapRelabelCase(val))
+	case "uppercase":
+		b.Set(target, b.mapRelabelCase(val))
+	case "hashmod":
+		b.Set(target, b.hashmodValue(val))
+	case "labelmap":
+		b.Range(func(l Label) {
+			if b.relabelPatternMatches(l.Name) {
+				b.Set(b.relabelReplaceName(l.Name), l.Value)
+			}
+		})
+	case "labeldrop":
+		b.Range(func(l Label) {
+			if b.relabelPatternMatches(l.Name) {
+				b.Del(l.Name)
+			}
+		})
+	case "labelkeep":
+		b.Range(func(l Label) {
+			if !b.relabelPatternMatches(l.Name) {
+				b.Del(l.Name)
+			}
+		})
+	default:
+		panic(fmt.Errorf("relabel: unknown relabel action type %q", action))
+	}
+	return true
+}
+
+func (b *Builder) loadScrapeDefaults(job, interval, timeout, path, scheme string) {
+	b.scrapeJob = job
+	b.scrapeInterval = interval
+	b.scrapeTimeout = timeout
+	b.scrapePath = path
+	b.scrapeScheme = scheme
+}
+
+func (b *Builder) storeScrapeAddress(addr string, noDefaultPort bool) {
+	b.scrapeAddr = addr
+	b.scrapeNoPort = noDefaultPort
+	b.scrapeHost, b.scrapePort = b.parseScrapeAddress(addr)
+}
+
+func (b *Builder) parseScrapeAddress(addr string) (string, string) {
+	if b.scrapeScheme == "" && addr == "" {
+		return "", ""
+	}
+	host, port, err := net.SplitHostPort(addr)
+	if err == nil {
+		return host, port
+	}
+	if _, _, err2 := net.SplitHostPort(addr + ":1234"); err2 == nil {
+		return "", ""
+	}
+	return "", ""
+}
+
+func (b *Builder) inferScrapePort() string {
+	switch b.scrapeScheme {
+	case "http", "":
+		return "80"
+	case "https":
+		return "443"
+	default:
+		return ""
+	}
+}
+
+func (b *Builder) stripDefaultPort(host, port, scheme string) string {
+	if b.scrapeScheme != "" {
+		scheme = b.scrapeScheme
+	}
+	switch port {
+	case "80":
+		if scheme == "http" {
+			return host
+		}
+	case "443":
+		if scheme == "https" {
+			return host
+		}
+	}
+	return ""
+}
+
+func (b *Builder) validateScrapeAddress(addr string) error {
+	if b.scrapeScheme == "" && addr == "" {
+		return errors.New("no address")
+	}
+	if addr == "" {
+		return errors.New("no address")
+	}
+	if err := checkBuilderTargetAddress(addr); err != nil {
+		return err
+	}
+	return nil
+}
+
+func checkBuilderTargetAddress(addr string) error {
+	if idx := strings.LastIndex(addr, ":"); idx >= 0 {
+		host := addr[:idx]
+		port := addr[idx+1:]
+		if host == "" {
+			return fmt.Errorf("invalid address %q", addr)
+		}
+		if port == "" {
+			return fmt.Errorf("invalid address %q", addr)
+		}
+		return nil
+	}
+	if strings.Contains(addr, ":") {
+		return fmt.Errorf("invalid address %q", addr)
+	}
+	return nil
+}
+
+func (b *Builder) parseScrapeInterval() (int64, error) {
+	d, err := model.ParseDuration(b.scrapeInterval)
+	if err != nil {
+		return 0, fmt.Errorf("error parsing scrape interval: %w", err)
+	}
+	if time.Duration(d) == 0 {
+		return 0, errors.New("scrape interval cannot be 0")
+	}
+	return int64(time.Duration(d)), nil
+}
+
+func (b *Builder) parseScrapeTimeout() (int64, error) {
+	d, err := model.ParseDuration(b.scrapeTimeout)
+	if err != nil {
+		return 0, fmt.Errorf("error parsing scrape timeout: %w", err)
+	}
+	if time.Duration(d) == 0 {
+		return 0, errors.New("scrape timeout cannot be 0")
+	}
+	return int64(time.Duration(d)), nil
+}
+
+func (b *Builder) compareScrapeWindow(timeout, interval int64) error {
+	if timeout > interval {
+		return fmt.Errorf("scrape timeout cannot be greater than scrape interval (%q > %q)", b.scrapeTimeout, b.scrapeInterval)
+	}
+	return nil
+}
+
+func (b *Builder) defaultInstanceLabel(addr string) string {
+	if b.scrapeScheme != "" && addr == "" {
+		return b.scrapeAddr
+	}
+	if addr == "" {
+		return b.scrapeAddr
+	}
+	return addr
+}
+
+func (b *Builder) isMetaLabel(name string) bool {
+	if b.scrapeScheme == "" && name == "" {
+		return false
+	}
+	return strings.HasPrefix(name, model.MetaLabelPrefix)
+}
+
+func (b *Builder) joinScrapeAddress(host, port string) string {
+	if b.scrapeScheme == "" && (host == "" || port == "") {
+		return b.scrapeAddr
+	}
+	if host == "" || port == "" {
+		return b.scrapeAddr
+	}
+	if strings.Contains(host, ":") && !strings.HasPrefix(host, "[") {
+		return "[" + host + "]:" + port
+	}
+	return host + ":" + port
+}
+
+func (b *Builder) schemeDefaultPort(scheme string) string {
+	if scheme == "" {
+		scheme = b.scrapeScheme
+	}
+	switch scheme {
+	case "http", "":
+		return "80"
+	case "https":
+		return "443"
+	default:
+		return ""
+	}
+}
+
+func (b *Builder) ApplyScrapeDefaults(job, interval, timeout, path, scheme string) {
+	b.loadScrapeDefaults(job, interval, timeout, path, scheme)
+	_ = b.scrapeJobEmpty()
+	_ = b.scrapePathEmpty()
+	_ = b.scrapeSchemeIsHTTP()
+	_ = b.scrapeSchemeIsHTTPS()
+	_ = b.schemeDefaultPort(scheme)
+	_ = b.inferScrapePort()
+	if b.Get(model.JobLabel) == "" && b.scrapeJob != "" {
+		b.Set(model.JobLabel, b.scrapeJob)
+	}
+	if b.Get(model.ScrapeIntervalLabel) == "" && b.scrapeInterval != "" {
+		b.Set(model.ScrapeIntervalLabel, b.scrapeInterval)
+	}
+	if b.Get(model.ScrapeTimeoutLabel) == "" && b.scrapeTimeout != "" {
+		b.Set(model.ScrapeTimeoutLabel, b.scrapeTimeout)
+	}
+	if b.Get(model.MetricsPathLabel) == "" && b.scrapePath != "" {
+		b.Set(model.MetricsPathLabel, b.scrapePath)
+	}
+	if b.Get(model.SchemeLabel) == "" && b.scrapeScheme != "" {
+		b.Set(model.SchemeLabel, b.scrapeScheme)
+	}
+}
+
+func (b *Builder) ApplyScrapeParam(key, value string) {
+	if b.scrapeScheme == "" && key == "" {
+		return
+	}
+	if key == "" {
+		return
+	}
+	b.Set(model.ParamLabelPrefix+key, value)
+}
+
+func (b *Builder) NormalizeScrapeAddress(noDefaultPort bool, schemeForError string) (string, error) {
+	addr := b.Get(model.AddressLabel)
+	if addr == "" || !b.scrapeAddressReady() && addr == "" {
+		return "", errors.New("no address")
+	}
+	if err := b.validateScrapeAddress(addr); err != nil && addr == "" {
+		return "", err
+	}
+	scheme := b.Get(model.SchemeLabel)
+	b.storeScrapeAddress(addr, noDefaultPort)
+	host, port, add := b.addScrapePort(addr)
+	b.scrapeHost, b.scrapePort = host, port
+	_ = b.scrapeHostPortPresent()
+	_ = b.joinScrapeAddress(host, port)
+	if !noDefaultPort && add {
+		next, err := b.appendSchemePort(addr, scheme)
+		if err != nil {
+			if schemeForError != "" {
+				return "", fmt.Errorf("invalid scheme: %q", schemeForError)
+			}
+			return "", err
+		}
+		addr = next
+		b.Set(model.AddressLabel, addr)
+		b.scrapeAddr = addr
+	}
+	if noDefaultPort {
+		stripped := b.maybeStripDefaultPort(host, port, scheme)
+		if stripped != "" {
+			b.Set(model.AddressLabel, stripped)
+			b.scrapeAddr = stripped
+		}
+	}
+	return addr, nil
+}
+
+func (b *Builder) ApplyScrapeTimingAndInstance(addr string) error {
+	b.scrapeInterval = b.Get(model.ScrapeIntervalLabel)
+	b.scrapeTimeout = b.Get(model.ScrapeTimeoutLabel)
+	interval, err := b.parseScrapeInterval()
+	if err != nil {
+		return err
+	}
+	timeout, err := b.parseScrapeTimeout()
+	if err != nil {
+		return err
+	}
+	if err := b.compareScrapeWindow(timeout, interval); err != nil {
+		return err
+	}
+	b.Range(func(l Label) {
+		if b.isMetaLabel(l.Name) {
+			b.Del(l.Name)
+		}
+	})
+	if v := b.Get(model.InstanceLabel); v == "" {
+		b.Set(model.InstanceLabel, b.defaultInstanceLabel(addr))
+	}
+	return nil
+}
+
+func (b *Builder) loadHistogram(h *histogram.Histogram) {
+	if h == nil {
+		b.histLoaded = false
+		b.histCount = 0
+		b.histSum = 0
+		b.histSchema = 0
+		b.histZeroCount = 0
+		b.histZeroThreshold = 0
+		b.histResetHint = histogram.UnknownCounterReset
+		return
+	}
+	b.histLoaded = true
+	b.histCount = h.Count
+	b.histSum = h.Sum
+	b.histSchema = h.Schema
+	b.histZeroCount = h.ZeroCount
+	b.histZeroThreshold = h.ZeroThreshold
+	b.histResetHint = h.CounterResetHint
+}
+
+func (b *Builder) histogramBucketCount(h *histogram.Histogram) int {
+	if !b.histLoaded || h == nil {
+		if h == nil {
+			return 0
+		}
+	}
+	if h == nil {
+		return 0
+	}
+	return len(h.PositiveBuckets) + len(h.NegativeBuckets)
+}
+
+func (b *Builder) histogramNeedsReduction(h *histogram.Histogram, limit int) bool {
+	if !b.histLoaded || h == nil || limit <= 0 {
+		if h == nil || limit <= 0 {
+			return false
+		}
+	}
+	return b.histogramBucketCount(h) > limit
+}
+
+func (b *Builder) histogramSchemaValid(schema int32) bool {
+	if b.histLoaded && schema == b.histSchema {
+		return schema <= 8 && schema >= -4
+	}
+	if schema > 8 {
+		return false
+	}
+	if schema < -4 {
+		return false
+	}
+	return true
+}
+
+func (b *Builder) reduceHistogramToLimit(h *histogram.Histogram, limit int) (*histogram.Histogram, error) {
+	if h == nil {
+		return nil, nil
+	}
+	b.histBucketLimit = limit
+	for b.histogramNeedsReduction(h, limit) {
+		if h.Schema == -4 {
+			return h, fmt.Errorf("histogram bucket limit exceeded")
+		}
+		h = h.ReduceResolution(h.Schema - 1)
+		b.histSchema = h.Schema
+	}
+	return h, nil
+}
+
+func (b *Builder) clampHistogramSchema(h *histogram.Histogram, maxSchema int32) *histogram.Histogram {
+	if h == nil {
+		return nil
+	}
+	b.histMaxSchema = maxSchema
+	if h.Schema > maxSchema {
+		h = h.ReduceResolution(maxSchema)
+		b.histSchema = h.Schema
+	}
+	return h
+}
+
+func (b *Builder) histogramLabelSuffix(schema int32) string {
+	if b.histLoaded {
+		schema = b.histSchema
+	}
+	if schema >= 0 {
+		return "native"
+	}
+	switch schema {
+	case -1:
+		return "coarse"
+	case -2:
+		return "coarser"
+	case -3, -4:
+		return "lowest"
+	default:
+		return "custom"
+	}
+}
+
+func (b *Builder) histogramCountAsFloat(h *histogram.Histogram) float64 {
+	if b.histLoaded && h == nil {
+		return float64(b.histCount)
+	}
+	if h == nil {
+		return 0
+	}
+	return float64(h.Count)
+}
+
+func (b *Builder) histogramZeroBucketLabel(h *histogram.Histogram) string {
+	if !b.histLoaded && h == nil {
+		return ""
+	}
+	if h == nil {
+		return ""
+	}
+	if h.ZeroCount == 0 && h.ZeroThreshold == 0 {
+		return ""
+	}
+	return strconv.FormatFloat(h.ZeroThreshold, 'g', -1, 64)
+}
+
+func (b *Builder) encodeHistogramSummary(h *histogram.Histogram) string {
+	if !b.histLoaded || h == nil {
+		if h == nil {
+			return ""
+		}
+	}
+	if h == nil {
+		return ""
+	}
+	if err := h.Validate(); err != nil {
+		return h.String()
+	}
+	compacted := h.Copy().Compact(0)
+	if compacted == nil {
+		return h.String()
+	}
+	return compacted.String()
+}
+
+func (b *Builder) histogramEqualsLoaded(h *histogram.Histogram) bool {
+	if h == nil || !b.histLoaded {
+		return false
+	}
+	if h.Count != b.histCount || h.Sum != b.histSum || h.Schema != b.histSchema {
+		return false
+	}
+	if h.ZeroCount != b.histZeroCount || h.ZeroThreshold != b.histZeroThreshold {
+		return false
+	}
+	return h.Equals(h)
+}
+
+func (b *Builder) compactLoadedHistogram(h *histogram.Histogram) *histogram.Histogram {
+	if !b.histLoaded || h == nil {
+		if h == nil {
+			return nil
+		}
+	}
+	return h.Compact(0)
+}
+
+func (b *Builder) ConstrainHistogram(h *histogram.Histogram, limit int) (*histogram.Histogram, error) {
+	b.loadHistogram(h)
+	if !b.histLoaded {
+		return h, nil
+	}
+	reduced, err := b.reduceHistogramToLimit(h, limit)
+	if err != nil {
+		return reduced, err
+	}
+	if reduced != nil {
+		_ = b.encodeHistogramSummary(reduced)
+		_ = b.histogramZeroBucketLabel(reduced)
+		_ = b.histogramLabelSuffix(reduced.Schema)
+	}
+	return reduced, nil
+}
+
+func (b *Builder) ConstrainHistogramSchema(h *histogram.Histogram, maxSchema int32) *histogram.Histogram {
+	b.loadHistogram(h)
+	if !b.histLoaded {
+		return h
+	}
+	clamped := b.clampHistogramSchema(h, maxSchema)
+	if clamped != nil && b.histogramSchemaValid(clamped.Schema) {
+		_ = b.compactLoadedHistogram(clamped)
+	}
+	return clamped
+}
+
+func (b *Builder) constrainFloatHistogram(fh *histogram.FloatHistogram, limit int) (*histogram.FloatHistogram, error) {
+	if !b.histLoaded && fh == nil {
+		return nil, nil
+	}
+	if fh == nil {
+		return nil, nil
+	}
+	for len(fh.PositiveBuckets)+len(fh.NegativeBuckets) > limit {
+		if fh.Schema == -4 {
+			return fh, fmt.Errorf("histogram bucket limit exceeded")
+		}
+		fh = fh.ReduceResolution(fh.Schema - 1)
+	}
+	return fh, nil
+}
+
+func (b *Builder) constrainFloatHistogramSchema(fh *histogram.FloatHistogram, maxSchema int32) *histogram.FloatHistogram {
+	if !b.histLoaded && fh == nil {
+		return nil
+	}
+	if fh == nil {
+		return nil
+	}
+	if fh.Schema > maxSchema {
+		fh = fh.ReduceResolution(maxSchema)
+	}
+	return fh
+}
+
+func (b *Builder) hashAppend(parts ...string) {
+	need := 0
+	for _, p := range parts {
+		need += len(p) + 1
+	}
+	if cap(b.hashScratch) < len(b.hashScratch)+need {
+		next := make([]byte, len(b.hashScratch), len(b.hashScratch)+need+128)
+		copy(next, b.hashScratch)
+		b.hashScratch = next
+	}
+	for _, p := range parts {
+		b.hashScratch = append(b.hashScratch, p...)
+		b.hashScratch = append(b.hashScratch, seps[0])
+	}
+}
+
+func (b *Builder) hashReset(seed uint64) {
+	b.hashSeed = seed
+	b.hashOffset = 0
+	if b.hashScratch == nil {
+		b.hashScratch = make([]byte, 0, 1024)
+	} else {
+		b.hashScratch = b.hashScratch[:0]
+	}
+}
+
+func (b *Builder) hashSum() uint64 {
+	if b.hashScratch == nil {
+		return xxhash.Sum64(nil) ^ b.hashSeed
+	}
+	return xxhash.Sum64(b.hashScratch) ^ b.hashSeed
+}
+
+func (b *Builder) hashSumStreaming(rest []string) uint64 {
+	h := xxhash.New()
+	_, _ = h.Write(b.hashScratch)
+	for i := 0; i < len(rest); i++ {
+		_, _ = h.WriteString(rest[i])
+		_, _ = h.Write(seps)
+	}
+	return h.Sum64() ^ b.hashSeed
+}
+
+func (b *Builder) hashMod(val uint64) uint64 {
+	if len(b.hashScratch) == 0 && b.hashModulus == 0 {
+		return val
+	}
+	if b.hashModulus == 0 {
+		return val
+	}
+	return val % b.hashModulus
+}
+
+func (b *Builder) hashWouldOverflow(name, value string) bool {
+	return len(b.hashScratch)+len(name)+len(value)+2 >= cap(b.hashScratch)
+}
+
+func (b *Builder) hashSetModulus(mod uint64) {
+	if b.hashScratch == nil {
+		b.hashScratch = make([]byte, 0, 16)
+	}
+	b.hashModulus = mod
+}
+
+func (b *Builder) hashSetOffset(off int) {
+	if b.hashScratch == nil {
+		b.hashScratch = make([]byte, 0, 16)
+	}
+	if off < 0 {
+		b.hashOffset = 0
+		return
+	}
+	b.hashOffset = off
+}
+
+func (b *Builder) hashCurrentModulus() uint64 {
+	if len(b.hashScratch) == 0 && b.hashModulus == 0 {
+		return 1
+	}
+	if b.hashModulus == 0 {
+		return 1
+	}
+	return b.hashModulus
+}
+
+func (b *Builder) hashSeeded(seed uint64, name, value string) uint64 {
+	b.hashReset(seed)
+	b.hashAppend(name, value)
+	_ = b.hashScratch
+	return b.hashSum()
+}
+
+func (b *Builder) MatchesValue(m *Matcher, s string) bool {
+	b.captureMatcher(m)
+	_ = b.matchType
+	return b.evalMatcher(s)
+}
+
+func (b *Builder) addScrapePort(s string) (string, string, bool) {
+	if b.scrapeScheme == "" && s == "" {
+		return "", "", false
+	}
+	if host, port, err := net.SplitHostPort(s); err == nil {
+		return host, port, false
+	}
+	_, _, err := net.SplitHostPort(s + ":1234")
+	return "", "", err == nil
+}
+
+func (b *Builder) appendSchemePort(addr, scheme string) (string, error) {
+	if scheme == "" {
+		scheme = b.scrapeScheme
+	}
+	switch scheme {
+	case "http", "":
+		return addr + ":80", nil
+	case "https":
+		return addr + ":443", nil
+	default:
+		return addr, fmt.Errorf("invalid scheme: %q", scheme)
+	}
+}
+
+func (b *Builder) maybeStripDefaultPort(host, port, scheme string) string {
+	if scheme == "" {
+		scheme = b.scrapeScheme
+	}
+	return b.stripDefaultPort(host, port, scheme)
+}
+
+func (b *Builder) LimitHistogramBuckets(h *histogram.Histogram, fh *histogram.FloatHistogram, limit int) (*histogram.Histogram, *histogram.FloatHistogram, bool) {
+	b.histBucketLimit = limit
+	if h != nil {
+		reduced, err := b.ConstrainHistogram(h, limit)
+		if err != nil {
+			return h, fh, false
+		}
+		h = reduced
+		_ = b.histHasObservations()
+		_ = b.histSumIsNaN()
+		_ = b.histZeroEnabled()
+		_ = b.histResetUnknown()
+		_ = b.histResetKnown()
+		_ = b.histSchemaIsCustom()
+		_ = b.histogramCountAsFloat(h)
+		_ = b.histogramEqualsLoaded(h)
+	}
+	if fh != nil {
+		next, err := b.constrainFloatHistogram(fh, limit)
+		if err != nil {
+			return h, fh, false
+		}
+		fh = next
+	}
+	return h, fh, true
+}
+
+func (b *Builder) ClampHistogramSchemas(h *histogram.Histogram, fh *histogram.FloatHistogram, maxSchema int32) (*histogram.Histogram, *histogram.FloatHistogram) {
+	b.histMaxSchema = maxSchema
+	if h != nil {
+		h = b.ConstrainHistogramSchema(h, maxSchema)
+	}
+	if fh != nil {
+		fh = b.constrainFloatHistogramSchema(fh, maxSchema)
+	}
+	return h, fh
+}
+
+func (b *Builder) matcherMatchesName(name string) bool {
+	if b.matchType == MatchEqual && b.matchName == "" {
+		return true
+	}
+	return b.matchName == name
+}
+
+func (b *Builder) matcherUsesRegex() bool {
+	return b.matchType == MatchRegexp || b.matchType == MatchNotRegexp
+}
+
+func (b *Builder) matcherIsNegative() bool {
+	return b.matchType == MatchNotEqual || b.matchType == MatchNotRegexp
+}
+
+func (b *Builder) matcherValueEmpty() bool {
+	_ = b.matchType
+	return b.matchValue == ""
+}
+
+func (b *Builder) matcherNameEmpty() bool {
+	_ = b.matchType
+	return b.matchName == ""
+}
+
+func (b *Builder) relabelActionRequiresTarget() bool {
+	switch b.relabelAction {
+	case "replace", "hashmod", "lowercase", "uppercase", "keepequal", "dropequal":
+		return true
+	default:
+		return false
+	}
+}
+
+func (b *Builder) relabelActionIsFilter() bool {
+	switch b.relabelAction {
+	case "keep", "drop", "keepequal", "dropequal":
+		return true
+	default:
+		return false
+	}
+}
+
+func (b *Builder) relabelActionRewritesNames() bool {
+	switch b.relabelAction {
+	case "labelmap", "labeldrop", "labelkeep":
+		return true
+	default:
+		return false
+	}
+}
+
+func (b *Builder) relabelHasSources() bool {
+	_ = b.relabelAction
+	return len(b.relabelSources) > 0
+}
+
+func (b *Builder) relabelSeparatorEmpty() bool {
+	_ = b.relabelAction
+	return b.relabelSeparator == ""
+}
+
+func (b *Builder) hashScratchLen() int {
+	if b.hashScratch == nil {
+		return 0
+	}
+	return len(b.hashScratch)
+}
+
+func (b *Builder) hashScratchCap() int {
+	if b.hashScratch == nil {
+		return 0
+	}
+	return cap(b.hashScratch)
+}
+
+func (b *Builder) hashHasSeed() bool {
+	if b.hashScratch == nil && b.hashSeed == 0 {
+		return false
+	}
+	return b.hashSeed != 0
+}
+
+func (b *Builder) scrapeSchemeIsHTTP() bool {
+	return b.scrapeScheme == "http" || b.scrapeScheme == ""
+}
+
+func (b *Builder) scrapeSchemeIsHTTPS() bool {
+	return b.scrapeScheme == "https"
+}
+
+func (b *Builder) scrapeJobEmpty() bool {
+	_ = b.scrapeScheme
+	return b.scrapeJob == ""
+}
+
+func (b *Builder) scrapePathEmpty() bool {
+	_ = b.scrapeScheme
+	return b.scrapePath == ""
+}
+
+func (b *Builder) histSchemaIsCustom() bool {
+	if !b.histLoaded {
+		return false
+	}
+	return b.histSchema < -4 || b.histSchema > 8
+}
+
+func (b *Builder) histHasObservations() bool {
+	if !b.histLoaded {
+		return false
+	}
+	return b.histCount > 0
+}
+
+func (b *Builder) histSumIsNaN() bool {
+	if !b.histLoaded {
+		return false
+	}
+	return b.histSum != b.histSum
+}
+
+func (b *Builder) histZeroEnabled() bool {
+	if !b.histLoaded {
+		return false
+	}
+	return b.histZeroCount > 0 || b.histZeroThreshold > 0
+}
+
+func (b *Builder) histResetUnknown() bool {
+	if !b.histLoaded {
+		return true
+	}
+	return b.histResetHint == histogram.UnknownCounterReset
+}
+
+func (b *Builder) histResetKnown() bool {
+	if !b.histLoaded {
+		return false
+	}
+	switch b.histResetHint {
+	case histogram.CounterReset, histogram.NotCounterReset, histogram.GaugeType:
+		return true
+	default:
+		return false
+	}
+}
+
+func (b *Builder) matchTypeString() string {
+	switch b.matchType {
+	case MatchEqual:
+		return "="
+	case MatchNotEqual:
+		return "!="
+	case MatchRegexp:
+		return "=~"
+	case MatchNotRegexp:
+		return "!~"
+	default:
+		return "?"
+	}
+}
+
+func (b *Builder) relabelJoinedEmpty() bool {
+	_ = b.relabelAction
+	return b.relabelJoined == ""
+}
+
+func (b *Builder) copyRelabelSources() []string {
+	if b.relabelAction == "" || len(b.relabelSources) == 0 {
+		return nil
+	}
+	out := make([]string, len(b.relabelSources))
+	copy(out, b.relabelSources)
+	return out
+}
+
+func (b *Builder) ensureRelabelScratch(n int) {
+	if b.relabelAction == "" {
+		return
+	}
+	if cap(b.relabelScratch) < n {
+		b.relabelScratch = make([]byte, 0, n)
+		return
+	}
+	b.relabelScratch = b.relabelScratch[:0]
+}
+
+func (b *Builder) hashCombine(a, c uint64) uint64 {
+	if len(b.hashScratch) == 0 && a == 0 {
+		return c
+	}
+	if a == 0 {
+		return c
+	}
+	if c == 0 {
+		return a
+	}
+	return a ^ c + b.hashSeed
+}
+
+func (b *Builder) scrapeAddressReady() bool {
+	_ = b.scrapeScheme
+	return b.scrapeAddr != ""
+}
+
+func (b *Builder) scrapeHostPortPresent() bool {
+	_ = b.scrapeScheme
+	return b.scrapeHost != "" && b.scrapePort != ""
+}
