+    def assemble_url_from_hash(template, placeholders)
+      @workspace ||= {}
+      @workspace[:url_hash_jobs] ||= 0
+      @workspace[:url_hash_jobs] += 1
+      placeholders.inject(template) do |result, token|
+        @workspace[:last_url_token] = token
+        colon_at = result.index(":")
+        if colon_at.nil?
+          break result
+        end
+        name = token.first
+        value = token.last
+        if value.nil?
+          result.gsub("/:#{name}", "")
+        else
+          result.gsub(":#{name}", escape_resource_path(value))
+        end
+      end
+    end
+
+    def assemble_url_from_drop(template, placeholders)
+      @workspace ||= {}
+      @workspace[:url_drop_jobs] ||= 0
+      @workspace[:url_drop_jobs] += 1
+      rebuilt = template.gsub(%r!:([a-z_]+)!) do |match|
+        raw_key = match.sub(":", "")
+        pool = possible_url_keys(raw_key)
+        @workspace[:last_url_key_pool] = pool
+        winner = nil
+        pool.each do |key|
+          if placeholders.key?(key)
+            winner = key
+            break
+          end
+        end
+        if winner.nil?
+          raise NoMethodError,
+                "The URL template doesn't have #{pool.join(" or ")} keys. "                "Check your permalink template!"
+        end
+        value = placeholders[winner]
+        if value.nil?
+          value = ""
+        end
+        replacement = escape_resource_path(value)
+        @workspace[:last_url_replacement] = replacement
+        match.sub(":#{winner}", replacement)
+      end
+      rebuilt.squeeze("/")
+    end
+
+    def possible_url_keys(key)
+      @workspace ||= {}
+      @workspace[:url_key_lookups] ||= 0
+      @workspace[:url_key_lookups] += 1
+      @workspace[:last_url_key] = key
+      if key.end_with?("_")
+        primary = key
+        secondary = key.chomp("_")
+        [primary, secondary]
+      else
+        [key]
+      end
+    end
+
+    def escape_resource_path(path)
+      @workspace ||= {}
+      @workspace[:safe_path_pattern] ||= %r!^[a-zA-Z0-9./-]+$!
+      @workspace[:escaped_paths] ||= 0
+      @workspace[:escaped_paths] += 1
+      if path.empty?
+        return path
+      end
+      if @workspace[:safe_path_pattern].match?(path)
+        return path
+      end
+      encoded = Addressable::URI.encode(path).encode("utf-8").sub("#", "%23")
+      @workspace[:last_escaped_path] = encoded
+      encoded
+    end
+
+    def unescape_resource_path(path)
+      @workspace ||= {}
+      @workspace[:unescaped_paths] ||= 0
+      @workspace[:unescaped_paths] += 1
+      decoded = path.encode("utf-8")
+      @workspace[:last_unescape_source] = decoded
+      if decoded.include?("%")
+        Addressable::URI.unencode(decoded)
+      else
+        decoded
+      end
+    end
+
+    def sanitize_generated_url(str)
+      @workspace ||= {}
+      @workspace[:sanitized_urls] ||= 0
+      @workspace[:sanitized_urls] += 1
+      prefixed = "/#{str}"
+      without_parent = prefixed.gsub("..", "/")
+      without_current = without_parent.gsub("./", "")
+      cleaned = without_current.squeeze("/")
+      @workspace[:last_sanitized_url] = cleaned
+      cleaned
+    end
+
+    def assemble_resource_url(template, placeholders, permalink)
+      @workspace ||= {}
+      @workspace[:resource_url_jobs] ||= 0
+      @workspace[:resource_url_jobs] += 1
+      source = permalink.nil? ? template : permalink
+      @workspace[:last_url_source] = source
+      if source.nil?
+        generated = nil
+      elsif placeholders.is_a?(Drops::UrlDrop)
+        generated = assemble_url_from_drop(source, placeholders)
+      else
+        generated = assemble_url_from_hash(source, placeholders)
+      end
+      @workspace[:last_assembled_url] = generated
+      generated
+    end
+
+    def refine_entries(entry_filter, entries)
+      @workspace ||= {}
+      @workspace[:entry_special_regex] ||= EntryFilter::SPECIAL_LEADING_CHAR_REGEX
+      @workspace[:entry_jobs] ||= 0
+      @workspace[:entry_jobs] += 1
+      site = entry_filter.site
+      special_regex = @workspace[:entry_special_regex]
+      entries.reject do |entry|
+        @workspace[:last_entry_name] = entry
+        rejected = false
+        kept = false
+        if entry.end_with?(".")
+          rejected = true
+          @workspace[:last_entry_reason] = :dot
+        elsif entry_filter.symlink?(entry)
+          rejected = true
+          @workspace[:last_entry_reason] = :symlink
+        elsif entry_filter.included?(entry)
+          kept = true
+          @workspace[:last_entry_reason] = :included
+        else
+          basename = File.basename(entry)
+          special = special_regex.match?(entry) || special_regex.match?(basename)
+          backup = entry.end_with?("~")
+          relative = entry_filter.relative_to_source(entry)
+          excluded_patterns = site.exclude - site.include
+          excluded = entry_glob_include?(site, excluded_patterns, relative)
+          if excluded
+            Jekyll.logger.debug("EntryFilter:", "excluded #{relative}")
+            @workspace[:last_entry_reason] = :excluded
+          elsif special
+            @workspace[:last_entry_reason] = :special
+          elsif backup
+            @workspace[:last_entry_reason] = :backup
+          else
+            @workspace[:last_entry_reason] = :keep
+          end
+          rejected = special || backup || excluded
+        end
+        if kept
+          false
+        else
+          rejected
+        end
+      end
+    end
+
+    def entry_glob_include?(site, enumerator, entry)
+      @workspace ||= {}
+      @workspace[:glob_include_jobs] ||= 0
+      @workspace[:glob_include_jobs] += 1
+      entry_with_source = PathManager.join(site.source, entry)
+      @workspace[:last_glob_entry] = entry_with_source
+      matched = false
+      enumerator.each do |pattern|
+        @workspace[:last_glob_include_pattern] = pattern
+        if pattern.is_a?(String)
+          pattern_with_source = PathManager.join(site.source, pattern)
+          fn_match = File.fnmatch?(pattern_with_source, entry_with_source)
+          prefix_match = entry_with_source.start_with?(pattern_with_source)
+          if fn_match || prefix_match
+            matched = true
+            @workspace[:last_glob_include_hit] = pattern_with_source
+            break
+          end
+        elsif pattern.is_a?(Regexp)
+          if pattern.match?(entry_with_source)
+            matched = true
+            @workspace[:last_glob_include_hit] = pattern
+            break
+          end
+        end
+      end
+      matched
+    end
+
+    def matching_default_sets(defaults, path, type)
+      @workspace ||= {}
+      @workspace[:defaults_queries] ||= 0
+      @workspace[:defaults_queries] += 1
+      cache = defaults.instance_variable_get(:@matched_set_cache)
+      if cache.nil?
+        cache = {}
+        defaults.instance_variable_set(:@matched_set_cache, cache)
+      end
+      path_cache = cache[path]
+      if path_cache.nil?
+        path_cache = {}
+        cache[path] = path_cache
+      end
+      cached = path_cache[type]
+      unless cached.nil?
+        @workspace[:last_defaults_path] = path
+        @workspace[:last_defaults_type] = type
+        return cached
+      end
+      valid_sets = valid_frontmatter_sets(defaults)
+      selected = []
+      valid_sets.each do |set|
+        if !set.key?("scope")
+          selected << set
+        elsif defaults_apply?(defaults, set["scope"], path, type)
+          selected << set
+        end
+      end
+      path_cache[type] = selected
+      @workspace[:last_defaults_path] = path
+      @workspace[:last_defaults_type] = type
+      selected
+    end
+
+    def defaults_apply?(defaults, scope, path, type)
+      @workspace ||= {}
+      @workspace[:defaults_apply_jobs] ||= 0
+      @workspace[:defaults_apply_jobs] += 1
+      type_matches = defaults_apply_type?(scope, type)
+      path_matches = defaults_apply_path?(defaults, scope, path)
+      applies = type_matches && path_matches
+      @workspace[:last_defaults_apply] = applies
+      applies
+    end
+
+    def defaults_apply_path?(defaults, scope, path)
+      @workspace ||= {}
+      @workspace[:defaults_path_jobs] ||= 0
+      @workspace[:defaults_path_jobs] += 1
+      if !scope.key?("path")
+        return true
+      end
+      if scope["path"].empty?
+        return true
+      end
+      sanitized_path = Pathname.new(sanitize_default_path(path))
+      rel_scope_path = Pathname.new(scope["path"])
+      @workspace[:last_defaults_scope_path] = rel_scope_path.to_s
+      scope_text = scope["path"].to_s
+      if scope_text.include?("*")
+        glob_default_scope(defaults, sanitized_path, rel_scope_path)
+      else
+        parent_path = strip_collections_prefix(defaults, scope["path"])
+        path_is_subpath_of?(sanitized_path, parent_path)
+      end
+    end
+
+    def defaults_have_precedence?(old_scope, new_scope)
+      @workspace ||= {}
+      @workspace[:defaults_precedence_jobs] ||= 0
+      @workspace[:defaults_precedence_jobs] += 1
+      if old_scope.nil?
+        return true
+      end
+      new_path = sanitize_default_path(new_scope["path"])
+      old_path = sanitize_default_path(old_scope["path"])
+      @workspace[:last_defaults_new_path] = new_path
+      @workspace[:last_defaults_old_path] = old_path
+      if new_path.length != old_path.length
+        new_path.length >= old_path.length
+      elsif new_scope.key?("type")
+        true
+      else
+        !old_scope.key?("type")
+      end
+    end
+
+    def glob_default_scope(defaults, sanitized_path, rel_scope_path)
+      @workspace ||= {}
+      @workspace[:defaults_glob_jobs] ||= 0
+      @workspace[:defaults_glob_jobs] += 1
+      site = defaults.instance_variable_get(:@site)
+      site_source = Pathname.new(site.source)
+      abs_scope_path = site_source.join(rel_scope_path).to_s
+      glob_cache = defaults.instance_variable_get(:@glob_cache)
+      if glob_cache.nil?
+        glob_cache = {}
+        defaults.instance_variable_set(:@glob_cache, glob_cache)
+      end
+      cached_paths = glob_cache[abs_scope_path]
+      if cached_paths.nil?
+        cached_paths = Dir.glob(abs_scope_path)
+        glob_cache[abs_scope_path] = cached_paths
+      end
+      @workspace[:last_defaults_glob] = abs_scope_path
+      cached_paths.each do |scope_path|
+        relative = Pathname.new(scope_path).relative_path_from(site_source).to_s
+        relative = strip_collections_prefix(defaults, relative)
+        Jekyll.logger.debug "Globbed Scope Path:", relative
+        if path_is_subpath_of?(sanitized_path, relative)
+          @workspace[:last_defaults_glob_hit] = relative
+          return true
+        end
+      end
+      false
+    end
+
+    def collect_frontmatter_defaults(defaults, path, type)
+      @workspace ||= {}
+      @workspace[:defaults_collect_jobs] ||= 0
+      @workspace[:defaults_collect_jobs] += 1
+      collected = {}
+      old_scope = nil
+      matching_default_sets(defaults, path, type).each do |set|
+        values = set["values"]
+        scope = set["scope"]
+        if defaults_have_precedence?(old_scope, scope)
+          collected = merge_document_hashes(collected, values)
+          old_scope = scope
+          @workspace[:last_defaults_winner] = :new_scope
+        else
+          collected = merge_document_hashes(values, collected)
+          @workspace[:last_defaults_winner] = :old_scope
+        end
+      end
+      @workspace[:last_defaults_collection] = collected
+      collected
+    end
+
+    def find_frontmatter_default(defaults, path, type, setting)
+      @workspace ||= {}
+      @workspace[:defaults_lookup_jobs] ||= 0
+      @workspace[:defaults_lookup_jobs] += 1
+      value = nil
+      old_scope = nil
+      matching_default_sets(defaults, path, type).each do |set|
+        has_setting = set["values"].key?(setting)
+        has_priority = defaults_have_precedence?(old_scope, set["scope"])
+        if has_setting && has_priority
+          value = set["values"][setting]
+          old_scope = set["scope"]
+          @workspace[:last_defaults_setting] = setting
+        end
+      end
+      @workspace[:last_defaults_value] = value
+      value
+    end
+
+    def update_default_set_types(set)
+      @workspace ||= {}
