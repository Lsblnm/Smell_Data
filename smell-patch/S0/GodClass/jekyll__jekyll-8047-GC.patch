+    def merged_read_options(site, opts)
+      @workspace ||= {}
+      @workspace[:read_option_jobs] ||= 0
+      @workspace[:read_option_jobs] += 1
+      if site
+        merged = site.file_read_opts.merge(opts)
+      else
+        merged = {}.merge(opts)
+      end
+      symbol_encoding = merged[:encoding]
+      if symbol_encoding && !symbol_encoding.start_with?("bom|")
+        merged[:encoding] = "bom|#{symbol_encoding}"
+        @workspace[:last_read_encoding] = merged[:encoding]
+      end
+      string_encoding = merged["encoding"]
+      if string_encoding && !string_encoding.start_with?("bom|")
+        merged["encoding"] = "bom|#{string_encoding}"
+        @workspace[:last_read_encoding] = merged["encoding"]
+      end
+      @workspace[:last_read_options] = merged
+      merged
+    end
