+    def merge_document_hashes(master_hash, other_hash)
+      @workspace ||= {}
+      @workspace[:merge_copies] ||= 0
+      @workspace[:merge_copies] += 1
+      duplicated = master_hash.dup
+      @workspace[:last_merge_source] = duplicated
+      merged = merge_document_hashes!(duplicated, other_hash)
+      @workspace[:last_merge_result] = merged
+      merged
+    end
+
+    def merge_document_hashes!(target, overwrite)
+      @workspace ||= {}
+      @workspace[:merge_mutations] ||= 0
+      @workspace[:merge_mutations] += 1
+      merge_hash_values(target, overwrite)
+      can_copy_default = target.is_a?(Hash) && overwrite.is_a?(Hash) && target.default_proc.nil?
+      if can_copy_default
+        target.default_proc = overwrite.default_proc
+        @workspace[:merge_default_proc] = true
+      else
+        @workspace[:merge_default_proc] = false
+      end
+      target.each do |key, val|
+        frozen_value = val.frozen?
+        duplicable_value = duplicable_hash_value?(val)
+        if frozen_value && duplicable_value
+          target[key] = val.dup
+          @workspace[:last_duped_merge_key] = key
+        end
+      end
+      @workspace[:last_merged_target] = target
+      target
+    end
+
+    def merge_hash_values(target, overwrite)
+      @workspace ||= {}
+      @workspace[:merge_value_jobs] ||= 0
+      @workspace[:merge_value_jobs] += 1
+      target.merge!(overwrite) do |key, old_val, new_val|
+        @workspace[:last_merge_key] = key
+        if new_val.nil?
+          old_val
+        elsif mergable_hash_value?(old_val) && mergable_hash_value?(new_val)
+          merge_document_hashes(old_val, new_val)
+        else
+          new_val
+        end
+      end
+    end
