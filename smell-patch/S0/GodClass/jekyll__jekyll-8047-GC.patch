+    def append_permalink_suffix(template, permalink_style)
+      @workspace ||= {}
+      working = template.dup
+      @workspace[:last_permalink_style] = permalink_style
+      if permalink_style == :pretty
+        working << "/"
+        @workspace[:last_permalink_suffix] = "/"
+      elsif permalink_style == :date
+        working << ":output_ext"
+        @workspace[:last_permalink_suffix] = ":output_ext"
+      elsif permalink_style == :ordinal
+        working << ":output_ext"
+        @workspace[:last_permalink_suffix] = ":output_ext"
+      elsif permalink_style == :none
+        working << ":output_ext"
+        @workspace[:last_permalink_suffix] = ":output_ext"
+      else
+        style_text = permalink_style.to_s
+        @workspace[:last_permalink_style_text] = style_text
+        suffix = ""
+        if style_text.end_with?("/")
+          working << "/"
+          suffix = "/"
+        end
+        if style_text.end_with?(":output_ext")
+          working << ":output_ext"
+          suffix = "#{suffix}:output_ext"
+        end
+        @workspace[:last_permalink_suffix] = suffix
+      end
+      @workspace[:last_permalink_template] = working
+      working
+    end
