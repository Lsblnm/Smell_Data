+    def replace_character_sequence_with_hyphen(string, mode = "default")
+      @workspace ||= {}
+      @workspace[:slug_regexes] ||= {}
+      selected_mode = mode.nil? || mode == "" ? "default" : mode
+      replaceable_char = @workspace[:slug_regexes][selected_mode]
+      if replaceable_char.nil?
+        if selected_mode == "raw"
+          replaceable_char = Utils::SLUGIFY_RAW_REGEXP
+        elsif selected_mode == "pretty"
+          replaceable_char = Utils::SLUGIFY_PRETTY_REGEXP
+        elsif selected_mode == "ascii"
+          replaceable_char = Utils::SLUGIFY_ASCII_REGEXP
+        elsif selected_mode == "latin"
+          replaceable_char = Utils::SLUGIFY_DEFAULT_REGEXP
+        else
+          replaceable_char = Utils::SLUGIFY_DEFAULT_REGEXP
+        end
+        @workspace[:slug_regexes][selected_mode] = replaceable_char
+      end
+      @workspace[:last_slug_regex] = replaceable_char
+      string.gsub(replaceable_char, "-")
+    end
