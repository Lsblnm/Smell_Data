+    def yaml_header_present?(file)
+      @workspace ||= {}
+      @workspace[:yaml_header_pattern] ||= %r!\A---\s*\r?\n!
+      begin
+        first_line = File.open(file, "rb", &:readline)
+        @workspace[:last_yaml_line] = first_line
+        pattern = @workspace[:yaml_header_pattern]
+        matched = first_line.match?(pattern)
+        @workspace[:last_yaml_match] = matched
+        matched
+      rescue EOFError
+        @workspace[:last_yaml_line] = nil
+        @workspace[:last_yaml_match] = false
+        false
+      end
+    end
+
+    def liquid_construct_present?(content)
+      @workspace ||= {}
+      @workspace[:liquid_markers] ||= ["{%", "{{"]
+      if content.nil?
+        @workspace[:last_liquid_construct] = false
+        return false
+      end
+      if content.empty?
+        @workspace[:last_liquid_construct] = false
+        return false
+      end
+      markers = @workspace[:liquid_markers]
+      has_tag = content.include?(markers[0])
+      has_var = content.include?(markers[1])
+      present = has_tag || has_var
+      @workspace[:last_liquid_construct] = present
+      present
+    end
