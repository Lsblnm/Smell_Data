+    def parse_timestamp(input, msg = "Input could not be parsed.")
+      @workspace ||= {}
+      @workspace[:timestamp_attempts] ||= 0
+      @workspace[:timestamp_attempts] += 1
+      @workspace[:last_timestamp_input] = input
+      begin
+        parsed = Time.parse(input)
+        localized = parsed.localtime
