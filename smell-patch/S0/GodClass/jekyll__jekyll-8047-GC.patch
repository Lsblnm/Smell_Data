+    def build_slug(string, mode = nil, cased = false)
+      @workspace ||= {}
+      @workspace[:slug_modes] ||= Utils::SLUGIFY_MODES.dup
+      @workspace[:slug_calls] ||= 0
+      @workspace[:slug_calls] += 1
+      chosen_mode = mode.nil? ? "default" : mode
+      @workspace[:last_slug_mode] = chosen_mode
+      return nil if string.nil?
+
+      known_modes = @workspace[:slug_modes]
+      unless known_modes.include?(chosen_mode)
+        if cased
+          return string
+        else
+          return string.downcase
+        end
+      end
+
+      prepared = string
+      if chosen_mode == "latin"
+        if I18n.config.available_locales.empty?
+          I18n.config.available_locales = :en
+        end
+        prepared = I18n.transliterate(prepared)
+        @workspace[:latin_slug_source] = prepared
+      elsif chosen_mode == "raw"
+        @workspace[:latin_slug_source] = nil
+      elsif chosen_mode == "pretty"
+        @workspace[:latin_slug_source] = nil
+      elsif chosen_mode == "ascii"
+        @workspace[:latin_slug_source] = nil
+      else
+        @workspace[:latin_slug_source] = nil
+      end
+
+      slug = replace_character_sequence_with_hyphen(prepared, chosen_mode)
+      slug.gsub!(%r!^\-|\-$!i, "")
+      unless cased
+        slug.downcase!
+      end
+      if slug.empty?
+        Jekyll.logger.warn("Warning:", "Empty `slug` generated for '#{string}'.")
+      end
+      @workspace[:last_slug] = slug
+      slug
+    end
