+    def safe_file_glob(dir, patterns, flags = 0)
+      @workspace ||= {}
+      @workspace[:glob_queries] ||= 0
+      @workspace[:glob_queries] += 1
+      @workspace[:last_glob_dir] = dir
+      unless Dir.exist?(dir)
+        return []
+      end
+      pattern = File.join(Array(patterns))
+      @workspace[:last_glob_pattern] = pattern
+      if pattern.empty?
+        return [dir]
+      end
+      Dir.chdir(dir) do
+        Dir.glob(pattern, flags).map { |f| File.join(dir, f) }
+      end
+    end
