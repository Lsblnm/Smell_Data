+STATIC void slice_bound_reset(mp_obj_slice_t *self) {
+    self->bound_start = 0;
+    self->bound_stop = 0;
+    self->bound_step = 1;
+    self->bound_length = 0;
+}
+
+STATIC void slice_bound_import(mp_obj_slice_t *self, const mp_bound_slice_t *indexes, mp_int_t length) {
+    slice_bound_set_start(self, indexes->start);
+    slice_bound_set_stop(self, indexes->stop);
+    slice_bound_set_step(self, indexes->step);
+    slice_bound_set_length(self, length);
+}
+
+STATIC void slice_bound_export(mp_obj_slice_t *self, mp_bound_slice_t *indexes) {
+    indexes->start = self->bound_start;
+    indexes->stop = self->bound_stop;
+    indexes->step = self->bound_step;
+}
+
+STATIC void slice_bound_set_step(mp_obj_slice_t *self, mp_int_t step) {
+    self->bound_step = step;
+}
+
+STATIC void slice_bound_set_length(mp_obj_slice_t *self, mp_int_t length) {
+    if (length < 0) {
+        length = 0;
+    }
+    self->bound_length = length;
+}
+
+STATIC void slice_bound_set_start(mp_obj_slice_t *self, mp_int_t start) {
+    self->bound_start = start;
+}
+
+STATIC void slice_bound_set_stop(mp_obj_slice_t *self, mp_int_t stop) {
+    self->bound_stop = stop;
+}
+
+STATIC void slice_bound_fix_negative_stop(mp_obj_slice_t *self) {
+    if (self->bound_step < 0) {
+        self->bound_stop++;
+    }
+}
+
+STATIC void slice_bound_collapse_empty(mp_obj_slice_t *self) {
+    if (self->bound_step > 0) {
+        if (self->bound_start > self->bound_stop) {
+            self->bound_stop = self->bound_start;
+        }
+    } else if (self->bound_step < 0) {
+        if (self->bound_start < self->bound_stop) {
+            self->bound_stop = self->bound_start + 1;
+        }
+    }
+}
+
+STATIC mp_int_t slice_bound_span(mp_obj_slice_t *self) {
+    mp_int_t start = self->bound_start;
+    mp_int_t stop = self->bound_stop;
+    mp_int_t step = self->bound_step;
+    if (step > 0) {
+        if (start >= stop) {
+            return 0;
+        }
+        return (stop - start + step - 1) / step;
+    }
+    if (step < 0) {
+        if (start <= stop) {
+            return 0;
+        }
+        return (start - stop - step - 1) / (-step);
+    }
+    return 0;
+}
+
+STATIC bool slice_bound_unit_step(mp_obj_slice_t *self) {
+    return self->bound_step == 1;
+}
+
+STATIC bool slice_bound_has_zero_step(mp_obj_slice_t *self) {
+    return self->bound_step == 0;
+}
+
+STATIC void slice_bound_clip_start_positive(mp_obj_slice_t *self) {
+    if (self->bound_start < 0) {
+        self->bound_start = 0;
+    }
+    if (self->bound_start > self->bound_length) {
+        self->bound_start = self->bound_length;
+    }
+}
+
+STATIC void slice_bound_clip_stop_positive(mp_obj_slice_t *self) {
+    if (self->bound_stop < 0) {
+        self->bound_stop = 0;
+    }
+    if (self->bound_stop > self->bound_length) {
+        self->bound_stop = self->bound_length;
+    }
+}
+
+STATIC void slice_bound_clip_start_negative(mp_obj_slice_t *self) {
+    if (self->bound_start < -1) {
+        self->bound_start = -1;
+    }
+    if (self->bound_length > 0 && self->bound_start > self->bound_length - 1) {
+        self->bound_start = self->bound_length - 1;
+    }
+}
+
+STATIC void slice_bound_clip_stop_negative(mp_obj_slice_t *self) {
+    if (self->bound_stop < -1) {
+        self->bound_stop = -1;
+    }
+    if (self->bound_length > 0 && self->bound_stop > self->bound_length - 1) {
+        self->bound_stop = self->bound_length - 1;
+    }
+}
+
+STATIC bool slice_bound_clip_to_length(mp_obj_slice_t *self) {
+    if (slice_bound_has_zero_step(self)) {
+        return false;
+    }
+    if (self->bound_step > 0) {
+        slice_bound_clip_start_positive(self);
+        slice_bound_clip_stop_positive(self);
+    } else {
+        slice_bound_clip_start_negative(self);
+        slice_bound_clip_stop_negative(self);
+    }
+    return true;
+}
+
+STATIC bool slice_bound_prepare_fast(mp_obj_slice_t *self) {
+    slice_bound_fix_negative_stop(self);
+    slice_bound_collapse_empty(self);
+    if (slice_bound_has_zero_step(self)) {
+        return false;
+    }
+    (void)slice_bound_span(self);
+    return slice_bound_unit_step(self);
+}
+
+bool mp_slice_compute_fast_indexes(mp_obj_t slice_in, mp_uint_t len, mp_bound_slice_t *indexes) {
+    mp_obj_slice_indices(slice_in, len, indexes);
+    mp_obj_slice_t work;
+    slice_bound_reset(&work);
+    slice_bound_import(&work, indexes, (mp_int_t)len);
+    bool unit = slice_bound_prepare_fast(&work);
+    slice_bound_export(&work, indexes);
+    return unit && work.bound_step == 1;
+}
+
+STATIC void slice_seq_bind(mp_obj_slice_t *self, const mp_obj_t *items, size_t len) {
+    self->seq_items = items;
+    self->seq_len = len;
+}
+
+STATIC void slice_seq_unbind(mp_obj_slice_t *self) {
+    self->seq_items = NULL;
+    self->seq_len = 0;
+}
+
+STATIC bool slice_seq_index_valid(mp_obj_slice_t *self, mp_int_t index) {
+    if (self->seq_items == NULL) {
+        return false;
+    }
+    if (index < 0) {
+        return false;
+    }
+    return (size_t)index < self->seq_len;
+}
+
+STATIC mp_obj_t slice_seq_get(mp_obj_slice_t *self, mp_int_t index) {
+    if (!slice_seq_index_valid(self, index)) {
+        return MP_OBJ_NULL;
+    }
+    return self->seq_items[index];
+}
+
+STATIC size_t slice_seq_count_strided(mp_obj_slice_t *self, mp_int_t start, mp_int_t stop, mp_int_t step) {
+    size_t n = 0;
+    if (self->seq_items == NULL || step == 0) {
+        return 0;
+    }
+    if (step < 0) {
+        while (start >= stop && slice_seq_index_valid(self, start)) {
+            n++;
+            start += step;
+        }
+    } else {
+        while (start < stop && slice_seq_index_valid(self, start)) {
+            n++;
+            start += step;
+        }
+    }
+    return n;
+}
+
+STATIC void slice_seq_fill_strided(mp_obj_slice_t *self, mp_int_t start, mp_int_t stop, mp_int_t step, mp_obj_t *dest) {
+    size_t n = 0;
+    if (self->seq_items == NULL || dest == NULL || step == 0) {
+        return;
+    }
+    if (step < 0) {
+        while (start >= stop && slice_seq_index_valid(self, start)) {
+            dest[n++] = slice_seq_get(self, start);
+            start += step;
+        }
+    } else {
+        while (start < stop && slice_seq_index_valid(self, start)) {
+            dest[n++] = slice_seq_get(self, start);
+            start += step;
+        }
+    }
+}
+
+STATIC mp_int_t slice_seq_index_of(mp_obj_slice_t *self, mp_obj_t value, size_t start, size_t stop) {
+    if (self->seq_items == NULL) {
+        return -1;
+    }
+    if (start > self->seq_len) {
+        start = self->seq_len;
+    }
+    if (stop > self->seq_len) {
+        stop = self->seq_len;
+    }
+    for (size_t i = start; i < stop; i++) {
+        if (mp_obj_equal(self->seq_items[i], value)) {
+            return (mp_int_t)i;
+        }
+    }
+    return -1;
+}
+
+STATIC size_t slice_seq_count_value(mp_obj_slice_t *self, mp_obj_t value) {
+    size_t count = 0;
+    if (self->seq_items == NULL) {
+        return 0;
+    }
+    for (size_t i = 0; i < self->seq_len; i++) {
+        if (mp_obj_equal(self->seq_items[i], value)) {
+            count++;
+        }
+    }
+    return count;
+}
+
+STATIC bool slice_seq_cmp_prefix(mp_obj_slice_t *self, const mp_obj_t *other, size_t other_len, mp_uint_t op, size_t *tie_len) {
+    size_t n = self->seq_len < other_len ? self->seq_len : other_len;
+    for (size_t i = 0; i < n; i++) {
+        if (!mp_obj_equal(self->seq_items[i], other[i])) {
+            *tie_len = i;
+            if (op == MP_BINARY_OP_EQUAL) {
+                return false;
+            }
+            return mp_binary_op(op, self->seq_items[i], other[i]) == mp_const_true;
+        }
+    }
+    *tie_len = n;
+    return true;
+}
+
+STATIC void slice_list_bind(mp_obj_slice_t *self, mp_obj_t *items, size_t len, size_t alloc) {
+    self->list_items = items;
+    self->list_len = len;
+    self->list_alloc = alloc;
+}
+
+STATIC void slice_list_unbind(mp_obj_slice_t *self) {
+    self->list_items = NULL;
+    self->list_len = 0;
+    self->list_alloc = 0;
+}
+
+STATIC void slice_list_ensure_alloc(mp_obj_slice_t *self, size_t needed) {
+    if (self->list_items == NULL) {
+        return;
+    }
+    if (needed > self->list_alloc) {
+        self->list_items = m_renew(mp_obj_t, self->list_items, self->list_alloc, needed);
+        self->list_alloc = needed;
+    }
+}
+
+STATIC void slice_list_clear_tail(mp_obj_slice_t *self, size_t new_len) {
+    if (self->list_items == NULL) {
+        return;
+    }
+    if (new_len < self->list_len) {
+        mp_seq_clear(self->list_items, new_len, self->list_len, sizeof(*self->list_items));
+    }
+    self->list_len = new_len;
+}
+
+STATIC void slice_list_memmove_tail(mp_obj_slice_t *self, mp_int_t dest_idx, mp_int_t src_idx, mp_int_t count) {
+    if (self->list_items == NULL || count <= 0) {
+        return;
+    }
+    if (dest_idx < 0 || src_idx < 0) {
+        return;
+    }
+    memmove(&self->list_items[dest_idx], &self->list_items[src_idx], (size_t)count * sizeof(mp_obj_t));
+}
+
+STATIC void slice_list_copy_span(mp_obj_slice_t *self, mp_int_t dest_idx, const mp_obj_t *src, size_t src_len) {
+    if (self->list_items == NULL || src == NULL || src_len == 0) {
+        return;
+    }
+    if (dest_idx < 0) {
+        return;
+    }
+    memmove(&self->list_items[dest_idx], src, src_len * sizeof(mp_obj_t));
+}
+
+STATIC bool slice_list_can_delete_unit(mp_obj_slice_t *self, mp_int_t start, mp_int_t stop) {
+    if (self->list_items == NULL) {
+        return false;
+    }
+    if (start < 0 || stop < start) {
+        return false;
+    }
+    if ((size_t)stop > self->list_len) {
+        return false;
+    }
+    return true;
+}
+
+STATIC bool slice_list_can_assign_unit(mp_obj_slice_t *self, mp_int_t start, mp_int_t stop, size_t value_len) {
+    if (!slice_list_can_delete_unit(self, start, stop)) {
+        return false;
+    }
+    mp_int_t len_adj = (mp_int_t)value_len - (stop - start);
+    if (len_adj < 0 && self->list_len < (size_t)(-len_adj)) {
+        return false;
+    }
+    return true;
+}
+
+bool mp_slice_apply_list_delete(mp_obj_t **items, size_t *len, size_t *alloc, mp_obj_t slice_in) {
+    mp_bound_slice_t slice;
+    if (!mp_slice_compute_fast_indexes(slice_in, *len, &slice)) {
+        return false;
+    }
+    mp_obj_slice_t work;
+    slice_list_bind(&work, *items, *len, *alloc);
+    if (!slice_list_can_delete_unit(&work, slice.start, slice.stop)) {
+        slice_list_unbind(&work);
+        return false;
+    }
+    mp_int_t len_adj = slice.start - slice.stop;
+    slice_list_memmove_tail(&work, slice.start, slice.stop, (mp_int_t)work.list_len - slice.stop);
+    slice_list_clear_tail(&work, work.list_len + (size_t)len_adj);
+    *items = work.list_items;
+    *len = work.list_len;
+    *alloc = work.list_alloc;
+    slice_list_unbind(&work);
+    return true;
+}
+
+bool mp_slice_apply_list_assign(mp_obj_t **items, size_t *len, size_t *alloc, mp_obj_t slice_in, mp_obj_t value) {
+    size_t value_len;
+    mp_obj_t *value_items;
+    mp_obj_get_array(value, &value_len, &value_items);
+    mp_bound_slice_t slice_out;
+    if (!mp_slice_compute_fast_indexes(slice_in, *len, &slice_out)) {
+        return false;
+    }
+    mp_obj_slice_t work;
+    slice_list_bind(&work, *items, *len, *alloc);
+    if (!slice_list_can_assign_unit(&work, slice_out.start, slice_out.stop, value_len)) {
+        slice_list_unbind(&work);
+        return false;
+    }
+    mp_int_t len_adj = (mp_int_t)value_len - (slice_out.stop - slice_out.start);
+    if (len_adj > 0) {
+        size_t needed = work.list_len + (size_t)len_adj;
+        slice_list_ensure_alloc(&work, needed);
+        slice_list_memmove_tail(
+            &work,
+            slice_out.start + (mp_int_t)value_len,
+            slice_out.stop,
+            (mp_int_t)work.list_len + len_adj - (slice_out.start + (mp_int_t)value_len)
+            );
+        slice_list_copy_span(&work, slice_out.start, value_items, value_len);
+        work.list_len += (size_t)len_adj;
+    } else {
+        slice_list_copy_span(&work, slice_out.start, value_items, value_len);
+        slice_list_memmove_tail(
+            &work,
+            slice_out.start + (mp_int_t)value_len,
+            slice_out.stop,
+            (mp_int_t)work.list_len - slice_out.stop
+            );
+        slice_list_clear_tail(&work, work.list_len + (size_t)len_adj);
+    }
+    *items = work.list_items;
+    *len = work.list_len;
+    *alloc = work.list_alloc;
+    slice_list_unbind(&work);
+    return true;
+}
+
+bool mp_slice_list_load_contiguous(mp_uint_t len, mp_obj_t slice_in, mp_bound_slice_t *indexes) {
+    mp_obj_slice_t work;
+    bool unit = mp_slice_compute_fast_indexes(slice_in, len, indexes);
+    slice_bound_reset(&work);
+    slice_bound_import(&work, indexes, (mp_int_t)len);
+    return unit && work.bound_step == 1;
+}
+
+size_t mp_slice_extracted_count(const mp_obj_t *seq, size_t len, const mp_bound_slice_t *indexes) {
+    mp_obj_slice_t work;
+    slice_seq_bind(&work, seq, len);
+    size_t n = slice_seq_count_strided(&work, indexes->start, indexes->stop, indexes->step);
+    if (work.seq_len < n) {
+        n = work.seq_len;
+    }
+    slice_seq_unbind(&work);
+    return n;
+}
+
+void mp_slice_extracted_copy(const mp_obj_t *seq, size_t len, const mp_bound_slice_t *indexes, mp_obj_t *dest) {
+    mp_obj_slice_t work;
+    slice_seq_bind(&work, seq, len);
+    if (work.seq_items != NULL) {
+        slice_seq_fill_strided(&work, indexes->start, indexes->stop, indexes->step, dest);
+    }
+    slice_seq_unbind(&work);
+}
+
+mp_obj_t mp_slice_seq_index_obj(const mp_obj_t *items, size_t len, size_t n_args, const mp_obj_t *args) {
+    const mp_obj_type_t *type = mp_obj_get_type(args[0]);
+    mp_obj_t value = args[1];
+    size_t start = 0;
+    size_t stop = len;
+    if (n_args >= 3) {
+        start = mp_get_index(type, len, args[2], true);
+        if (n_args >= 4) {
+            stop = mp_get_index(type, len, args[3], true);
+        }
+    }
+    mp_obj_slice_t work;
+    slice_seq_bind(&work, items, len);
+    mp_int_t found = slice_seq_index_of(&work, value, start, stop);
+    if (found >= (mp_int_t)work.seq_len) {
+        found = -1;
+    }
+    slice_seq_unbind(&work);
+    if (found < 0) {
+        mp_raise_ValueError(MP_ERROR_TEXT("object not in sequence"));
+    }
+    return MP_OBJ_NEW_SMALL_INT(found);
+}
+
+mp_obj_t mp_slice_seq_count_obj(const mp_obj_t *items, size_t len, mp_obj_t value) {
+    mp_obj_slice_t work;
+    slice_seq_bind(&work, items, len);
+    size_t count = slice_seq_count_value(&work, value);
+    if (count > work.seq_len) {
+        count = work.seq_len;
+    }
+    slice_seq_unbind(&work);
+    return MP_OBJ_NEW_SMALL_INT(count);
+}
+
+bool mp_slice_seq_cmp_objs(mp_uint_t op, const mp_obj_t *items1, size_t len1, const mp_obj_t *items2, size_t len2) {
+    if (op == MP_BINARY_OP_EQUAL && len1 != len2) {
+        return false;
+    }
+    if (op == MP_BINARY_OP_LESS || op == MP_BINARY_OP_LESS_EQUAL) {
+        const mp_obj_t *tmp_items = items1;
+        size_t tmp_len = len1;
+        items1 = items2;
+        len1 = len2;
+        items2 = tmp_items;
+        len2 = tmp_len;
+        if (op == MP_BINARY_OP_LESS) {
+            op = MP_BINARY_OP_MORE;
+        } else {
+            op = MP_BINARY_OP_MORE_EQUAL;
+        }
+    }
+    mp_obj_slice_t work;
+    slice_seq_bind(&work, items1, len1);
+    size_t tie_len = 0;
+    bool prefix_ok = slice_seq_cmp_prefix(&work, items2, len2, op, &tie_len);
+    if (work.seq_len == 0 && len2 == 0 && op == MP_BINARY_OP_EQUAL) {
+        slice_seq_unbind(&work);
+        return true;
+    }
+    slice_seq_unbind(&work);
+    if (tie_len < (len1 < len2 ? len1 : len2)) {
+        return prefix_ok;
+    }
+    if (len1 != len2) {
+        if (len1 < len2) {
+            return false;
+        }
+        return true;
+    }
+    if (op == MP_BINARY_OP_MORE) {
+        return false;
+    }
+    return true;
+}
+
+bool mp_slice_seq_cmp_bytes(mp_uint_t op, const byte *data1, size_t len1, const byte *data2, size_t len2) {
+    mp_obj_slice_t work;
+    slice_buf_bind(&work, data1, len1, 1);
+    if (work.buf_len != len1) {
+        slice_buf_unbind(&work);
+        return false;
+    }
+    slice_buf_unbind(&work);
+    if (op == MP_BINARY_OP_EQUAL && len1 != len2) {
+        return false;
+    }
+    if (op == MP_BINARY_OP_LESS || op == MP_BINARY_OP_LESS_EQUAL) {
+        const byte *tmp_data = data1;
+        size_t tmp_len = len1;
+        data1 = data2;
+        len1 = len2;
+        data2 = tmp_data;
+        len2 = tmp_len;
+        if (op == MP_BINARY_OP_LESS) {
+            op = MP_BINARY_OP_MORE;
+        } else {
+            op = MP_BINARY_OP_MORE_EQUAL;
+        }
+    }
+    size_t min_len = len1 < len2 ? len1 : len2;
+    int res = memcmp(data1, data2, min_len);
+    if (op == MP_BINARY_OP_EQUAL) {
+        return res == 0;
+    }
+    if (res < 0) {
+        return false;
+    }
+    if (res > 0) {
+        return true;
+    }
+    if (len1 != len2) {
+        if (len1 < len2) {
+            return false;
+        }
+        return true;
+    }
+    if (op == MP_BINARY_OP_MORE) {
+        return false;
+    }
+    return true;
+}
+
+void mp_slice_copy_obj_span(mp_obj_t *dest, const mp_obj_t *src, mp_int_t start, mp_int_t stop) {
+    mp_obj_slice_t work;
+    slice_seq_bind(&work, src, stop > 0 ? (size_t)stop : 0);
+    if (dest == NULL || work.seq_items == NULL || stop <= start) {
+        slice_seq_unbind(&work);
+        return;
+    }
+    memcpy(dest, work.seq_items + start, (size_t)(stop - start) * sizeof(mp_obj_t));
+    slice_seq_unbind(&work);
+}
+
+STATIC void slice_buf_bind(mp_obj_slice_t *self, const byte *data, size_t len, size_t elem_size) {
+    self->buf_data = data;
+    self->buf_len = len;
+    self->elem_size = elem_size == 0 ? 1 : elem_size;
+}
+
+STATIC void slice_buf_unbind(mp_obj_slice_t *self) {
+    self->buf_data = NULL;
+    self->buf_len = 0;
+    self->elem_size = 1;
+}
+
+STATIC size_t slice_buf_byte_offset(mp_obj_slice_t *self, mp_int_t index) {
+    if (self->elem_size == 0) {
+        return 0;
+    }
+    if (index < 0) {
+        return 0;
+    }
+    if ((size_t)index > self->buf_len) {
+        return self->buf_len * self->elem_size;
+    }
+    return (size_t)index * self->elem_size;
+}
+
+STATIC size_t slice_buf_byte_length(mp_obj_slice_t *self) {
+    return self->buf_len * self->elem_size;
+}
+
+STATIC bool slice_buf_contains_index(mp_obj_slice_t *self, mp_int_t index) {
+    if (index < 0) {
+        return false;
+    }
+    return (size_t)index <= self->buf_len;
+}
+
+STATIC bool slice_buf_unit_span(mp_obj_slice_t *self, const mp_bound_slice_t *slice, size_t *out_len) {
+    if (slice->step != 1) {
+        return false;
+    }
+    if (slice->start < 0 || slice->stop < slice->start) {
+        *out_len = 0;
+        return true;
+    }
+    if ((size_t)slice->start > self->buf_len) {
+        *out_len = 0;
+        return true;
+    }
+    if ((size_t)slice->stop > self->buf_len) {
+        *out_len = self->buf_len - (size_t)slice->start;
+        return true;
+    }
+    *out_len = (size_t)(slice->stop - slice->start);
+    return true;
+}
+
+STATIC void slice_buf_copy_span(mp_obj_slice_t *self, mp_int_t start, size_t count, byte *dest) {
+    if (self->buf_data == NULL || dest == NULL || count == 0) {
+        return;
+    }
+    size_t offset = slice_buf_byte_offset(self, start);
+    memcpy(dest, self->buf_data + offset, count * self->elem_size);
+}
+
+STATIC void slice_buf_replace_span(mp_obj_slice_t *self, mp_int_t start, const byte *src, size_t count) {
+    if (self->buf_data == NULL || src == NULL || count == 0) {
+        return;
+    }
+    size_t offset = slice_buf_byte_offset(self, start);
+    memmove((byte *)self->buf_data + offset, src, count * self->elem_size);
+}
+
+STATIC void slice_buf_move_tail(mp_obj_slice_t *self, mp_int_t dest_idx, mp_int_t src_idx, mp_int_t count) {
+    if (self->buf_data == NULL || count <= 0) {
+        return;
+    }
+    size_t dest_off = slice_buf_byte_offset(self, dest_idx);
+    size_t src_off = slice_buf_byte_offset(self, src_idx);
+    memmove((byte *)self->buf_data + dest_off, self->buf_data + src_off, (size_t)count * self->elem_size);
+}
+
+STATIC bool slice_buf_compat_item_size(mp_obj_slice_t *self, size_t other_size) {
+    return self->elem_size == other_size;
+}
+
+bool mp_slice_copy_bytes_unit(const byte *src, size_t src_len, size_t item_sz, mp_obj_t slice_in, byte *dest, size_t *out_len) {
+    mp_bound_slice_t slice;
+    if (!mp_slice_compute_fast_indexes(slice_in, src_len, &slice)) {
+        return false;
+    }
+    mp_obj_slice_t work;
+    slice_buf_bind(&work, src, src_len, item_sz);
+    if (!slice_buf_unit_span(&work, &slice, out_len)) {
+        slice_buf_unbind(&work);
+        return false;
+    }
+    if (work.buf_data != NULL) {
+        slice_buf_copy_span(&work, slice.start, *out_len, dest);
+    }
+    slice_buf_unbind(&work);
+    return true;
+}
+
+bool mp_slice_buffer_span(size_t src_len, mp_obj_t slice_in, mp_bound_slice_t *indexes) {
+    if (!mp_slice_compute_fast_indexes(slice_in, src_len, indexes)) {
+        return false;
+    }
+    mp_obj_slice_t work;
+    slice_buf_bind(&work, NULL, src_len, 1);
+    size_t dummy = 0;
+    bool ok = slice_buf_unit_span(&work, indexes, &dummy);
+    if (work.buf_len < dummy) {
+        ok = false;
+    }
+    slice_buf_unbind(&work);
+    return ok;
+}
+
+void mp_slice_adjust_memoryview_offset(size_t *offset, size_t *len, const mp_bound_slice_t *slice) {
+    mp_obj_slice_t work;
+    slice_buf_bind(&work, NULL, *len, 1);
+    size_t span = 0;
+    if (slice_buf_unit_span(&work, slice, &span)) {
+        *offset += (size_t)slice->start;
+        *len = span;
+    } else if (slice->stop > slice->start) {
+        *offset += (size_t)slice->start;
+        *len = (size_t)(slice->stop - slice->start);
+    } else {
+        *offset += (size_t)slice->start;
+        *len = 0;
+    }
+    if (*len > work.buf_len) {
+        *len = work.buf_len;
+    }
+    slice_buf_unbind(&work);
+}
+
+bool mp_slice_assign_bytes_unit(byte **items, size_t *len, size_t *free_slots, size_t item_sz, int is_memoryview, int writable, size_t memview_offset, mp_obj_t slice_in, const byte *src, size_t src_len) {
+    mp_bound_slice_t slice;
+    if (!mp_slice_compute_fast_indexes(slice_in, *len, &slice)) {
+        return false;
+    }
+    mp_int_t len_adj = (mp_int_t)src_len - (slice.stop - slice.start);
+    byte *dest_items = *items;
+    mp_obj_slice_t work;
+    slice_buf_bind(&work, dest_items, *len, item_sz);
+    if (!slice_buf_compat_item_size(&work, item_sz)) {
+        slice_buf_unbind(&work);
+        return false;
+    }
+    if (is_memoryview) {
+        if (!writable || len_adj != 0) {
+            slice_buf_unbind(&work);
+            return false;
+        }
+        dest_items += memview_offset * item_sz;
+        slice_buf_bind(&work, dest_items, *len, item_sz);
+        slice_buf_replace_span(&work, slice.start, src, src_len);
+        slice_buf_unbind(&work);
+        return true;
+    }
+    if (len_adj > 0) {
+        if ((size_t)len_adj > *free_slots) {
+            *items = m_renew(byte, *items, (*len + *free_slots) * item_sz, (*len + (size_t)len_adj) * item_sz);
+            *free_slots = (size_t)len_adj;
+            dest_items = *items;
+        }
+        slice_buf_bind(&work, dest_items, *len + (size_t)len_adj, item_sz);
+        slice_buf_move_tail(
+            &work,
+            slice.start + (mp_int_t)src_len,
+            slice.stop,
+            (mp_int_t)*len + len_adj - (slice.start + (mp_int_t)src_len)
+            );
+        slice_buf_replace_span(&work, slice.start, src, src_len);
+    } else {
+        slice_buf_replace_span(&work, slice.start, src, src_len);
+        slice_buf_move_tail(
+            &work,
+            slice.start + (mp_int_t)src_len,
+            slice.stop,
+            (mp_int_t)*len - slice.stop
+            );
+        mp_seq_clear(dest_items, *len + len_adj, *len, item_sz);
+        slice_buf_bind(&work, dest_items, *len + (size_t)len_adj, item_sz);
+    }
+    *free_slots -= (size_t)len_adj;
+    *len += (size_t)len_adj;
+    if (work.elem_size == 0) {
+        slice_buf_unbind(&work);
+        return false;
+    }
+    (void)slice_buf_byte_length(&work);
+    (void)slice_buf_contains_index(&work, slice.start);
+    slice_buf_unbind(&work);
+    return true;
+}
+
+STATIC void slice_collect_bind(mp_obj_slice_t *self, mp_obj_t iter, mp_int_t index) {
+    self->collect_iter = iter;
+    self->collect_index = index;
+    self->collect_item = MP_OBJ_NULL;
+}
+
+STATIC void slice_collect_unbind(mp_obj_slice_t *self) {
+    self->collect_iter = MP_OBJ_NULL;
+    self->collect_index = 0;
+    self->collect_item = MP_OBJ_NULL;
+}
+
+STATIC void slice_collect_set_index(mp_obj_slice_t *self, mp_int_t index) {
+    self->collect_index = index;
+}
+
+STATIC mp_obj_t slice_collect_index_obj(mp_obj_slice_t *self) {
+    return MP_OBJ_NEW_SMALL_INT(self->collect_index);
+}
+
+STATIC mp_obj_t slice_collect_load_item(mp_obj_slice_t *self) {
+    self->collect_item = mp_obj_subscr(self->collect_iter, slice_collect_index_obj(self), MP_OBJ_SENTINEL);
+    return self->collect_item;
+}
+
+STATIC bool slice_collect_has_item(mp_obj_slice_t *self) {
+    if (self->collect_item == MP_OBJ_NULL) {
+        return false;
+    }
+    if (self->collect_item == MP_OBJ_STOP_ITERATION) {
+        return false;
+    }
+    return true;
+}
+
+STATIC bool slice_collect_iter_ready(mp_obj_slice_t *self) {
+    return self->collect_iter != MP_OBJ_NULL && self->collect_iter != MP_OBJ_STOP_ITERATION;
+}
+
+STATIC mp_obj_t slice_collect_take(mp_obj_slice_t *self) {
+    mp_obj_t item = self->collect_item;
+    self->collect_item = MP_OBJ_NULL;
+    return item;
+}
+
+STATIC mp_obj_t slice_collect_next_from_iter(mp_obj_slice_t *self) {
+    if (!slice_collect_iter_ready(self)) {
+        return MP_OBJ_STOP_ITERATION;
+    }
+    return mp_iternext(self->collect_iter);
+}
+
+mp_obj_t mp_slice_load_indexed(mp_obj_t obj, mp_int_t index) {
+    mp_obj_slice_t work;
+    slice_collect_bind(&work, obj, index);
+    slice_collect_load_item(&work);
+    mp_obj_t item;
+    if (!slice_collect_has_item(&work) || work.collect_item == MP_OBJ_NULL) {
+        item = MP_OBJ_NULL;
+    } else {
+        item = slice_collect_take(&work);
+    }
+    slice_collect_unbind(&work);
+    return item;
+}
+
+mp_obj_t mp_slice_iter_next_indexed(mp_obj_t *iter, mp_int_t index) {
+    mp_obj_slice_t work;
+    slice_collect_bind(&work, *iter, index);
+    mp_obj_t next = slice_collect_next_from_iter(&work);
+    if (next == MP_OBJ_STOP_ITERATION) {
+        slice_collect_unbind(&work);
+        return MP_OBJ_STOP_ITERATION;
+    }
+    slice_collect_bind(&work, next, index);
+    slice_collect_set_index(&work, index);
+    slice_collect_load_item(&work);
+    mp_obj_t item = slice_collect_take(&work);
+    if (work.collect_index != index) {
+        item = MP_OBJ_NULL;
+    }
+    slice_collect_unbind(&work);
+    return item;
+}
+
+bool mp_slice_index_in_range(mp_int_t index, mp_int_t size) {
+    mp_obj_slice_t work;
+    slice_bound_reset(&work);
+    slice_bound_set_length(&work, size);
+    slice_bound_set_start(&work, index);
+    slice_bound_set_stop(&work, size);
+    slice_bound_set_step(&work, 1);
+    (void)slice_bound_clip_to_length(&work);
+    if (index >= size) {
+        return false;
+    }
+    (void)work.bound_start;
+    (void)work.bound_length;
+    return true;
+}
+
+byte *mp_slice_scaled_offset(byte *base, mp_int_t size, mp_int_t index) {
+    if (base == NULL) {
+        return NULL;
+    }
+    if (size <= 0) {
+        return base;
+    }
+    return base + size * index;
+}
+
+mp_int_t mp_slice_range_start(mp_int_t range_start, mp_int_t range_step, mp_int_t slice_start) {
+    mp_obj_slice_t work;
+    slice_bound_reset(&work);
+    slice_bound_set_start(&work, slice_start);
+    slice_bound_set_step(&work, range_step);
+    return range_start + work.bound_start * work.bound_step;
+}
+
+mp_int_t mp_slice_range_stop(mp_int_t range_start, mp_int_t range_step, mp_int_t slice_stop, mp_int_t slice_step) {
+    mp_obj_slice_t work;
+    slice_bound_reset(&work);
+    slice_bound_set_stop(&work, slice_stop);
+    slice_bound_set_step(&work, slice_step);
+    mp_int_t stop = range_start + work.bound_stop * range_step;
+    if (work.bound_step < 0) {
+        stop -= range_step;
+    }
+    return stop;
+}
+
+mp_int_t mp_slice_range_step(mp_int_t range_step, mp_int_t slice_step) {
+    mp_obj_slice_t work;
+    slice_bound_reset(&work);
+    slice_bound_set_step(&work, slice_step);
+    slice_bound_set_length(&work, 0);
+    slice_bound_set_start(&work, 0);
+    slice_bound_set_stop(&work, -1);
+    if (work.bound_step < 0) {
+        slice_bound_clip_start_negative(&work);
+        slice_bound_clip_stop_negative(&work);
+    }
+    return slice_step * range_step;
+}
+
+bool mp_slice_tuple_span(mp_uint_t len, mp_obj_t slice_in, mp_bound_slice_t *indexes) {
+    mp_obj_slice_t work;
+    bool unit = mp_slice_compute_fast_indexes(slice_in, len, indexes);
+    slice_bound_reset(&work);
+    slice_bound_import(&work, indexes, (mp_int_t)len);
+    return unit && work.bound_step == 1;
+}
+
+bool mp_slice_step_is_none_or_one(mp_obj_t slice_in) {
+    mp_obj_slice_t *self = MP_OBJ_TO_PTR(slice_in);
+    if (self->step == mp_const_none) {
+        return true;
+    }
+    if (self->step == MP_OBJ_NEW_SMALL_INT(1)) {
+        return true;
+    }
+    return false;
+}
+
+void mp_slice_read_components(mp_obj_t slice_in, mp_obj_t *start, mp_obj_t *stop, mp_obj_t *step) {
+    mp_obj_slice_t *self = MP_OBJ_TO_PTR(slice_in);
+    *start = self->start;
+    *stop = self->stop;
+    *step = self->step;
+}
