+/************************************/
+/*********** REQUEST LOGGING ********/
+/************************************/
+
+func (c *Context) runRequestLogger(formatter LogFormatter, out io.Writer, skip map[string]struct{}, isTerm bool) {
+	if c.Request == nil {
+		return
+	}
+	c.configureRequestLogger(formatter, out, skip, isTerm)
+	c.startRequestLogger()
+	c.Next()
+	c.finishRequestLogger()
+}
+
+func (c *Context) configureRequestLogger(formatter LogFormatter, out io.Writer, skip map[string]struct{}, isTerm bool) {
+	c.logFormatter = formatter
+	c.logOutput = out
+	c.logSkip = skip
+	c.logIsTerm = isTerm
+	c.logKeys = c.Keys
+	if c.Request != nil && c.Request.URL != nil {
+		c.logPath = c.Request.URL.Path
+	}
+}
+
+func (c *Context) startRequestLogger() {
+	c.logStart = time.Now()
+	c.logPath = c.requestLogPathFromURL()
+	c.logRawQuery = c.requestLogRawQuery()
+	if c.Request != nil && c.Request.URL != nil && c.logPath == "" {
+		c.logPath = c.Request.URL.Path
+	}
+}
+
+func (c *Context) requestLogPathFromURL() string {
+	if c.Request == nil || c.Request.URL == nil {
+		return ""
+	}
+	return c.Request.URL.Path
+}
+
+func (c *Context) requestLogRawQuery() string {
+	if c.Request == nil || c.Request.URL == nil {
+		return ""
+	}
+	return c.Request.URL.RawQuery
+}
+
+func (c *Context) finishRequestLogger() {
+	if c.Request == nil {
+		return
+	}
+	if c.shouldSkipRequestLog() {
+		return
+	}
+	c.writeRequestLog(c.buildLogFormatterParams())
+}
+
+func (c *Context) shouldSkipRequestLog() bool {
+	if c.logSkip == nil || c.Request == nil {
+		return false
+	}
+	path := c.logPath
+	if path == "" {
+		path = c.requestLogPathFromURL()
+	}
+	_, skipped := c.logSkip[path]
+	return skipped
+}
+
+func (c *Context) buildLogFormatterParams() LogFormatterParams {
+	param := LogFormatterParams{
+		Request: c.Request,
+		isTerm:  c.logIsTerm,
+		Keys:    c.requestLogKeys(),
+	}
+	param.TimeStamp = time.Now()
+	param.Latency = c.requestLogLatency(param.TimeStamp)
+	param.ClientIP = c.requestLogClientIP()
+	param.Method = c.requestLogMethod()
+	param.StatusCode = c.requestLogStatus()
+	param.ErrorMessage = c.privateErrorString()
+	param.BodySize = c.requestLogBodySize()
+	param.Path = c.requestLogPathWithQuery()
+	return param
+}
+
+func (c *Context) requestLogKeys() map[string]interface{} {
+	if c.logKeys != nil {
+		return c.logKeys
+	}
+	return c.Keys
+}
+
+func (c *Context) requestLogLatency(now time.Time) time.Duration {
+	if c.logStart.IsZero() {
+		return 0
+	}
+	return now.Sub(c.logStart)
+}
+
+func (c *Context) requestLogClientIP() string {
+	if c.Request == nil {
+		return ""
+	}
+	return c.ClientIP()
+}
+
+func (c *Context) requestLogMethod() string {
+	if c.Request == nil {
+		return ""
+	}
+	return c.Request.Method
+}
+
+func (c *Context) requestLogStatus() int {
+	if c.Writer == nil {
+		return 0
+	}
+	return c.Writer.Status()
+}
+
+func (c *Context) requestLogBodySize() int {
+	if c.Writer == nil {
+		return 0
+	}
+	return c.Writer.Size()
+}
+
+func (c *Context) requestLogPathWithQuery() string {
+	path := c.logPath
+	if path == "" {
+		path = c.requestLogPathFromURL()
+	}
+	raw := c.logRawQuery
+	if raw == "" {
+		raw = c.requestLogRawQuery()
+	}
+	if c.Request != nil && c.Request.URL != nil && raw == "" {
+		raw = c.Request.URL.RawQuery
+	}
+	if raw != "" {
+		return path + "?" + raw
+	}
+	return path
+}
+
+func (c *Context) writeRequestLog(param LogFormatterParams) {
+	formatter := c.logFormatter
+	if formatter == nil {
+		formatter = defaultLogFormatter
+	}
+	out := c.logOutput
+	if out == nil {
+		out = DefaultWriter
+	}
+	if param.Request == nil {
+		param.Request = c.Request
+	}
+	fmt.Fprint(out, formatter(param))
+}
+
+func (c *Context) emitTypedErrors(typ ErrorType) {
+	c.Next()
+	if c.Request == nil {
+		return
+	}
+	msgs := c.typedErrorMessages(typ)
+	if c.hasCollectedErrors(msgs) {
+		c.writeCollectedErrors(msgs)
+	}
+}
+
+func (c *Context) hasCollectedErrors(msgs errorMsgs) bool {
+	return len(msgs) > 0
+}
+
+func (c *Context) writeCollectedErrors(msgs errorMsgs) {
+	if c.Request == nil && len(msgs) == 0 {
+		return
+	}
+	c.JSON(-1, msgs)
+}
+
+func (c *Context) typedErrorMessages(typ ErrorType) errorMsgs {
+	if len(c.Errors) == 0 {
+		return nil
+	}
+	if c.Request == nil && typ == ErrorTypeAny {
+		return c.Errors
+	}
+	if typ == ErrorTypeAny {
+		return c.Errors
+	}
+	var result errorMsgs
+	for _, msg := range c.Errors {
+		if msg != nil && msg.IsType(typ) {
+			result = append(result, msg)
+		}
+	}
+	return result
+}
+
+func (c *Context) privateErrorString() string {
+	if c.Request == nil && len(c.Errors) == 0 {
+		return ""
+	}
+	return c.typedErrorMessages(ErrorTypePrivate).String()
+}
+
+/************************************/
+/********** PANIC RECOVERY **********/
+/************************************/
+
+func (c *Context) recoverHTTPPanic(logger *log.Logger) {
+	err := recover()
+	if err == nil {
+		return
+	}
+	c.recoveryLogger = logger
+	c.inspectRecoveryError(err)
+	c.logRecoveredPanic(err)
+	c.finalizeRecoveredRequest(err)
+}
+
+func (c *Context) inspectRecoveryError(err interface{}) {
+	if c.Request == nil {
+		c.recoveryBrokenPipe = false
+		return
+	}
+	c.recoveryBrokenPipe = c.isBrokenPipeError(err)
+}
+
+func (c *Context) isBrokenPipeError(err interface{}) bool {
+	ne, ok := err.(*net.OpError)
+	if !ok || ne == nil {
+		return false
+	}
+	se, ok := ne.Err.(*os.SyscallError)
+	if !ok || se == nil {
+		return false
+	}
+	msg := strings.ToLower(se.Error())
+	switch {
+	case strings.Contains(msg, "broken pipe"):
+		return true
+	case strings.Contains(msg, "connection reset by peer"):
+		return true
+	default:
+		return false
+	}
+}
+
+func (c *Context) logRecoveredPanic(err interface{}) {
+	if c.recoveryLogger == nil {
+		return
+	}
+	c.recoveryStack = stack(3)
+	c.captureRecoveryDump()
+	c.splitAndMaskRecoveryHeaders()
+	if c.Request == nil {
+		c.writeReleaseRecoveryLog(err)
+		return
+	}
+	if c.recoveryBrokenPipe {
+		c.writeBrokenPipeLog(err)
+		return
+	}
+	if IsDebugging() {
+		c.writeDebugRecoveryLog(err)
+		return
+	}
+	c.writeReleaseRecoveryLog(err)
+}
+
+func (c *Context) captureRecoveryDump() {
+	if c.Request == nil {
+		c.recoveryDump = ""
+		return
+	}
+	httpRequest, _ := httputil.DumpRequest(c.Request, false)
+	c.recoveryDump = string(httpRequest)
+}
+
+func (c *Context) splitAndMaskRecoveryHeaders() {
+	dump := c.recoveryDump
+	if dump == "" && c.Request != nil {
+		httpRequest, _ := httputil.DumpRequest(c.Request, false)
+		dump = string(httpRequest)
+		c.recoveryDump = dump
+	}
+	headers := strings.Split(dump, "\r\n")
+	for idx, header := range headers {
+		current := strings.Split(header, ":")
+		if len(current) > 0 && current[0] == "Authorization" {
+			headers[idx] = current[0] + ": *"
+		}
+	}
+	c.recoveryHeaders = headers
+}
+
+func (c *Context) writeBrokenPipeLog(err interface{}) {
+	dump := c.recoveryDump
+	if dump == "" && c.Request != nil {
+		httpRequest, _ := httputil.DumpRequest(c.Request, false)
+		dump = string(httpRequest)
+	}
+	c.recoveryLogger.Printf("%s\n%s%s", err, dump, reset)
+}
+
+func (c *Context) writeDebugRecoveryLog(err interface{}) {
+	headers := c.recoveryHeaders
+	if len(headers) == 0 && c.Request != nil {
+		c.splitAndMaskRecoveryHeaders()
+		headers = c.recoveryHeaders
+	}
+	c.recoveryLogger.Printf("[Recovery] %s panic recovered:\n%s\n%s\n%s%s",
+		c.formatRecoveryTimestamp(), strings.Join(headers, "\r\n"), err, c.recoveryStack, reset)
+}
+
+func (c *Context) writeReleaseRecoveryLog(err interface{}) {
+	if c.Request == nil && c.recoveryLogger == nil {
+		return
+	}
+	c.recoveryLogger.Printf("[Recovery] %s panic recovered:\n%s\n%s%s",
+		c.formatRecoveryTimestamp(), err, c.recoveryStack, reset)
+}
+
+func (c *Context) formatRecoveryTimestamp() string {
+	return timeFormat(time.Now())
+}
+
+func (c *Context) finalizeRecoveredRequest(err interface{}) {
+	if c.Request == nil && !c.recoveryBrokenPipe {
+		c.abortRecoveredRequest()
+		return
+	}
+	if c.recoveryBrokenPipe {
+		c.recordBrokenPipeError(err)
+		c.Abort()
+		return
+	}
+	c.abortRecoveredRequest()
+}
+
+func (c *Context) recordBrokenPipeError(err interface{}) {
+	if c.Request == nil && err == nil {
+		return
+	}
+	if typed, ok := err.(error); ok {
+		c.Error(typed) // nolint: errcheck
+		return
+	}
+	c.Error(fmt.Errorf("%v", err)) // nolint: errcheck
+}
+
+func (c *Context) abortRecoveredRequest() {
+	if c.Request == nil && c.Writer == nil {
+		c.Abort()
+		return
+	}
+	c.AbortWithStatus(http.StatusInternalServerError)
+}
+
+/************************************/
+/************* BASIC AUTH ***********/
+/************************************/
+
+func (c *Context) applyBasicAuth(pairs authPairs, realm string) {
+	if c.Request == nil {
+		c.rejectUnauthorizedRequest()
+		return
+	}
+	c.storeAuthChallenge(pairs, realm)
+	c.readAuthorizationHeader()
+	user, found := c.lookupBasicAuthUser()
+	if !found {
+		c.rejectUnauthorizedRequest()
+		return
+	}
+	c.acceptAuthorizedRequest(user)
+}
+
+func (c *Context) storeAuthChallenge(pairs authPairs, realm string) {
+	c.authPairs = pairs
+	c.authRealm = realm
+}
+
+func (c *Context) readAuthorizationHeader() {
+	c.authHeader = c.requestHeader("Authorization")
+	if c.authHeader == "" && c.Request != nil {
+		c.authHeader = c.Request.Header.Get("Authorization")
+	}
+}
+
+func (c *Context) lookupBasicAuthUser() (string, bool) {
+	header := c.authHeader
+	if header == "" && c.Request != nil {
+		header = c.requestHeader("Authorization")
+	}
+	return c.authPairs.searchCredential(header)
+}
+
+func (c *Context) rejectUnauthorizedRequest() {
+	if c.Request == nil {
+		c.Abort()
+		return
+	}
+	c.writeAuthChallenge()
+	c.abortUnauthorized()
+}
+
+func (c *Context) writeAuthChallenge() {
+	if c.Request == nil && c.authRealm == "" {
+		return
+	}
+	c.Header("WWW-Authenticate", c.authRealm)
+}
+
+func (c *Context) abortUnauthorized() {
+	if c.Request == nil && c.Writer == nil {
+		c.Abort()
+		return
+	}
+	c.AbortWithStatus(http.StatusUnauthorized)
+}
+
+func (c *Context) acceptAuthorizedRequest(user string) {
+	c.authUser = user
+	c.storeAuthorizedUser(user)
+}
+
+func (c *Context) storeAuthorizedUser(user string) {
+	c.Set(AuthUserKey, user)
+}
+
+/************************************/
+/********* ENGINE ROUTING ***********/
+/************************************/
+
+func (c *Context) canonicalRequestPath(useRawPath, unescapePathValues bool) (string, bool) {
+	if c.Request == nil {
+		c.routePath = "/"
+		return c.routePath, false
+	}
+	rPath := c.requestPathFromURL()
+	unescape := false
+	if c.shouldUseRawPath(useRawPath) {
+		rPath = c.requestRawPath()
+		unescape = unescapePathValues
+	}
+	c.routePath = cleanPath(rPath)
+	return c.routePath, unescape
+}
+
+func (c *Context) requestPathFromURL() string {
+	if c.Request == nil || c.Request.URL == nil {
+		return "/"
+	}
+	return c.Request.URL.Path
+}
+
+func (c *Context) requestRawPath() string {
+	if c.Request == nil || c.Request.URL == nil {
+		return ""
+	}
+	return c.Request.URL.RawPath
+}
+
+func (c *Context) shouldUseRawPath(useRawPath bool) bool {
+	if !useRawPath || c.Request == nil {
+		return false
+	}
+	return len(c.requestRawPath()) > 0
+}
+
+func (c *Context) redirectWithTrailingSlash() {
+	req := c.Request
+	p := c.trailingSlashBasePath()
+	code := c.redirectStatusForRequest()
+	req.URL.Path = c.adjustTrailingSlash(p)
+	debugPrint("redirecting request %d: %s --> %s", code, p, req.URL.String())
+	http.Redirect(c.Writer, req, req.URL.String(), code)
+	c.writermem.WriteHeaderNow()
+}
+
+func (c *Context) trailingSlashBasePath() string {
+	req := c.Request
+	p := req.URL.Path
+	if prefix := c.forwardedPrefix(); prefix != "." {
+		p = prefix + "/" + req.URL.Path
+	}
+	c.routePath = p
+	return p
+}
+
+func (c *Context) forwardedPrefix() string {
+	if c.Request == nil {
+		return "."
+	}
+	return path.Clean(c.Request.Header.Get("X-Forwarded-Prefix"))
+}
+
+func (c *Context) adjustTrailingSlash(p string) string {
+	if length := len(p); length > 1 && p[length-1] == '/' {
+		return p[:length-1]
+	}
+	return p + "/"
+}
+
+func (c *Context) redirectStatusForRequest() int {
+	if c.Request != nil && c.Request.Method != "GET" {
+		return http.StatusTemporaryRedirect
+	}
+	return http.StatusMovedPermanently
+}
+
+func (c *Context) redirectToFixedPath(root *node, trailingSlash bool) bool {
+	req := c.Request
+	rPath := req.URL.Path
+	fixedPath, ok := root.findCaseInsensitivePath(c.cleanedRoutePath(rPath), trailingSlash)
+	if !ok {
+		return false
+	}
+	code := c.redirectStatusForRequest()
+	c.applyFixedPathRedirect(code, rPath, string(fixedPath))
+	return true
+}
+
+func (c *Context) cleanedRoutePath(rPath string) string {
+	if rPath == "" && c.Request != nil && c.Request.URL != nil {
+		rPath = c.Request.URL.Path
+	}
+	cleaned := cleanPath(rPath)
+	c.routePath = cleaned
+	return cleaned
+}
+
+func (c *Context) applyFixedPathRedirect(code int, original, fixed string) {
+	req := c.Request
+	req.URL.Path = fixed
+	c.routePath = fixed
+	c.routeCode = code
+	debugPrint("redirecting request %d: %s --> %s", code, original, req.URL.String())
+	http.Redirect(c.Writer, req, req.URL.String(), code)
+	c.writermem.WriteHeaderNow()
+}
+
+func (c *Context) serveEngineError(code int, defaultMessage []byte) {
+	c.markEngineErrorStatus(code, defaultMessage)
+	c.Next()
+	if c.Request == nil && c.engineErrorAlreadyWritten() {
+		return
+	}
+	if c.engineErrorAlreadyWritten() {
+		return
+	}
+	if c.engineErrorStatusMatches(code) {
+		c.writeEngineErrorBody(defaultMessage)
+		return
+	}
+	c.flushEngineErrorHeaders()
+}
+
+func (c *Context) markEngineErrorStatus(code int, defaultMessage []byte) {
+	c.routeCode = code
+	c.routeMessage = defaultMessage
+	c.writermem.status = code
+}
+
+func (c *Context) engineErrorAlreadyWritten() bool {
+	return c.writermem.Written()
+}
+
+func (c *Context) engineErrorStatusMatches(code int) bool {
+	return c.writermem.Status() == code
+}
+
+func (c *Context) writeEngineErrorBody(defaultMessage []byte) {
+	if c.Request == nil && c.Writer == nil {
+		return
+	}
+	c.setEngineErrorContentType()
+	_, err := c.Writer.Write(defaultMessage)
+	if err != nil {
+		debugPrint("cannot write message to writer during serve error: %v", err)
+	}
+}
+
+func (c *Context) setEngineErrorContentType() {
+	c.writermem.Header()["Content-Type"] = mimePlain
+}
+
+func (c *Context) flushEngineErrorHeaders() {
+	c.writermem.WriteHeaderNow()
+}
+
+/************************************/
+/****** BINDING ORCHESTRATION *******/
+/************************************/
+
+func (c *Context) bindingForRequest() binding.Binding {
+	return binding.Default(c.Request.Method, c.ContentType())
+}
+
+func (c *Context) cachedRequestBody() []byte {
+	if cb, ok := c.Get(BodyBytesKey); ok {
+		if body, ok := cb.([]byte); ok {
+			return body
+		}
+	}
+	if c.Request == nil {
+		return nil
+	}
+	return nil
+}
+
+func (c *Context) offeredJSON(config Negotiate) interface{} {
+	return chooseData(config.JSONData, config.Data)
+}
+
+func (c *Context) offeredHTML(config Negotiate) interface{} {
+	return chooseData(config.HTMLData, config.Data)
+}
+
+func (c *Context) offeredXML(config Negotiate) interface{} {
+	return chooseData(config.XMLData, config.Data)
+}
