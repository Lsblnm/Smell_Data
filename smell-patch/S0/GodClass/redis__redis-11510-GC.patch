+
+/* ---- Script execution, persistence and flag parsing owned by functionsLibCtx ---- */
+
+int functionsLibCtxIsTimedout(functionsLibCtx *ctx);
+
+static void functionsLibCtxClearRunError(functionsLibCtx *ctx) {
+    if (!ctx || !ctx->last_run_error) return;
+    sdsfree(ctx->last_run_error);
+    ctx->last_run_error = NULL;
+}
+
+static void functionsLibCtxRecordRunError(functionsLibCtx *ctx, const char *err) {
+    if (!ctx) return;
+    functionsLibCtxClearRunError(ctx);
+    if (err) ctx->last_run_error = sdsnew(err);
+}
+
+static void functionsLibCtxClearPersistState(functionsLibCtx *ctx) {
+    if (!ctx) return;
+    ctx->last_persist_written = 0;
+    ctx->last_payload_libs = 0;
+    ctx->last_payload_rdbver = 0;
+    if (ctx->last_persist_error) {
+        sdsfree(ctx->last_persist_error);
+        ctx->last_persist_error = NULL;
+    }
+}
+
+static void functionsLibCtxBeginPersist(functionsLibCtx *ctx) {
+    if (!ctx) return;
+    functionsLibCtxClearPersistState(ctx);
+}
+
+static void functionsLibCtxRecordPersistError(functionsLibCtx *ctx, const char *err) {
+    if (!ctx) return;
+    if (ctx->last_persist_error) sdsfree(ctx->last_persist_error);
+    ctx->last_persist_error = err ? sdsnew(err) : NULL;
+}
+
+static void functionsLibCtxNotePayloadVersion(functionsLibCtx *ctx, uint16_t rdbver) {
+    if (!ctx) return;
+    ctx->last_payload_rdbver = rdbver;
+}
+
+static void functionsLibCtxCountSavedLibraries(functionsLibCtx *ctx, size_t count) {
+    if (!ctx) return;
+    ctx->last_payload_libs = count;
+}
+
+static int functionsLibCtxParseRestorePolicy(functionsLibCtx *ctx, const char *policy_str) {
+    if (!ctx) return C_ERR;
+    if (!policy_str) {
+        ctx->last_restore_policy = restorePolicy_Append;
+        return C_OK;
+    }
+    if (!strcasecmp(policy_str, "append")) {
+        ctx->last_restore_policy = restorePolicy_Append;
+        return C_OK;
+    } else if (!strcasecmp(policy_str, "replace")) {
+        ctx->last_restore_policy = restorePolicy_Replace;
+        return C_OK;
+    } else if (!strcasecmp(policy_str, "flush")) {
+        ctx->last_restore_policy = restorePolicy_Flush;
+        return C_OK;
+    }
+    return C_ERR;
+}
+
+static void functionsLibCtxExitTimeout(functionsLibCtx *ctx, scriptRunCtx *run_ctx) {
+    serverAssert(ctx && run_ctx == ctx->active_run);
+    serverAssert(functionsLibCtxIsTimedout(ctx));
+    run_ctx->flags &= ~SCRIPT_TIMEDOUT;
+    ctx->run_timedout = 0;
+    blockingOperationEnds();
+    if (server.masterhost && server.master) queueClientForReprocessing(server.master);
+}
+
+static void functionsLibCtxEnterTimeout(functionsLibCtx *ctx, scriptRunCtx *run_ctx) {
+    serverAssert(ctx && run_ctx == ctx->active_run);
+    serverAssert(!functionsLibCtxIsTimedout(ctx));
+    run_ctx->flags |= SCRIPT_TIMEDOUT;
+    ctx->run_timedout = 1;
+    blockingOperationStarts();
+}
+
+static int functionsLibCtxCheckClusterFlag(functionsLibCtx *ctx, client *caller) {
+    if (!ctx) return C_ERR;
+    if ((ctx->last_script_flags & SCRIPT_FLAG_NO_CLUSTER) && server.cluster_enabled) {
+        addReplyError(caller, "Can not run script on cluster, 'no-cluster' flag is set.");
+        return C_ERR;
+    }
+    return C_OK;
+}
+
+static int functionsLibCtxCheckStalePolicy(functionsLibCtx *ctx, client *caller, int running_stale) {
+    if (!ctx) return C_ERR;
+    if (running_stale && !(ctx->last_script_flags & SCRIPT_FLAG_ALLOW_STALE)) {
+        addReplyError(caller, "-MASTERDOWN Link with MASTER is down, "
+                         "replica-serve-stale-data is set to 'no' "
+                         "and 'allow-stale' flag is not set on the script.");
+        return C_ERR;
+    }
+    return C_OK;
+}
+
+static int functionsLibCtxCheckWritePermission(functionsLibCtx *ctx, client *caller, int obey_client) {
+    if (!ctx) return C_ERR;
+    if (ctx->last_script_flags & SCRIPT_FLAG_NO_WRITES) return C_OK;
+
+    if (server.masterhost && server.repl_slave_ro && !obey_client) {
+        addReplyError(caller, "-READONLY Can not run script with write flag on readonly replica");
+        return C_ERR;
+    }
+
+    int deny_write_type = writeCommandsDeniedByDiskError();
+    if (deny_write_type != DISK_ERROR_TYPE_NONE && !obey_client) {
+        if (deny_write_type == DISK_ERROR_TYPE_RDB)
+            addReplyError(caller, "-MISCONF Redis is configured to save RDB snapshots, "
+                             "but it's currently unable to persist to disk. "
+                             "Writable scripts are blocked. Use 'no-writes' flag for read only scripts.");
+        else
+            addReplyErrorFormat(caller, "-MISCONF Redis is configured to persist data to AOF, "
+                                   "but it's currently unable to persist to disk. "
+                                   "Writable scripts are blocked. Use 'no-writes' flag for read only scripts. "
+                                   "AOF error: %s", strerror(server.aof_last_write_errno));
+        return C_ERR;
+    }
+
+    if (ctx->last_run_readonly) {
+        addReplyError(caller, "Can not execute a script with write flag using *_ro command.");
+        return C_ERR;
+    }
+
+    if (!checkGoodReplicasStatus()) {
+        addReplyErrorObject(caller, shared.noreplicaserr);
+        return C_ERR;
+    }
+    return C_OK;
+}
+
+static int functionsLibCtxCheckOomPermission(functionsLibCtx *ctx, client *caller, int client_allow_oom) {
+    if (!ctx) return C_ERR;
+    if (!client_allow_oom && server.pre_command_oom_state && server.maxmemory &&
+        !(ctx->last_script_flags & (SCRIPT_FLAG_ALLOW_OOM|SCRIPT_FLAG_NO_WRITES)))
+    {
+        addReplyError(caller, "-OOM allow-oom flag is not set on the script, "
+                              "can not run it when used memory > 'maxmemory'");
+        return C_ERR;
+    }
+    return C_OK;
+}
+
+static void functionsLibCtxApplyRunFlags(functionsLibCtx *ctx, scriptRunCtx *run_ctx, int client_allow_oom) {
+    run_ctx->flags = 0;
+    run_ctx->repl_flags = PROPAGATE_AOF | PROPAGATE_REPL;
+    ctx->run_eval_mode = 0;
+    ctx->run_timedout = 0;
+
+    if (ctx->last_run_readonly ||
+        (!(ctx->last_script_flags & SCRIPT_FLAG_EVAL_COMPAT_MODE) &&
+         (ctx->last_script_flags & SCRIPT_FLAG_NO_WRITES))) {
+        run_ctx->flags |= SCRIPT_READ_ONLY;
+    }
+    if (client_allow_oom ||
+        (!(ctx->last_script_flags & SCRIPT_FLAG_EVAL_COMPAT_MODE) &&
+         (ctx->last_script_flags & SCRIPT_FLAG_ALLOW_OOM))) {
+        run_ctx->flags |= SCRIPT_ALLOW_OOM;
+    }
+    if ((ctx->last_script_flags & SCRIPT_FLAG_EVAL_COMPAT_MODE) ||
+        (ctx->last_script_flags & SCRIPT_FLAG_ALLOW_CROSS_SLOT)) {
+        run_ctx->flags |= SCRIPT_ALLOW_CROSS_SLOT;
+    }
+}
+
+int functionsLibCtxPrepareRun(functionsLibCtx *ctx, scriptRunCtx *run_ctx, client *engine_client, client *caller, const char *funcname, uint64_t script_flags, int ro) {
+    serverAssert(ctx);
+    serverAssert(!ctx->active_run);
+    bool client_allow_oom = caller->flags & CLIENT_ALLOW_OOM;
+
+    ctx->last_script_flags = script_flags;
+    ctx->last_run_readonly = ro;
+    functionsLibCtxClearRunError(ctx);
+
+    int running_stale = server.masterhost &&
+            server.repl_state != REPL_STATE_CONNECTED &&
+            server.repl_serve_stale_data == 0;
+    int obey_client = mustObeyClient(caller);
+
+    if (!(script_flags & SCRIPT_FLAG_EVAL_COMPAT_MODE)) {
+        if (functionsLibCtxCheckClusterFlag(ctx, caller) != C_OK) return C_ERR;
+        if (functionsLibCtxCheckStalePolicy(ctx, caller, running_stale) != C_OK) return C_ERR;
+        if (functionsLibCtxCheckWritePermission(ctx, caller, obey_client) != C_OK) return C_ERR;
+        if (functionsLibCtxCheckOomPermission(ctx, caller, client_allow_oom) != C_OK) return C_ERR;
+    } else {
+        if (running_stale) {
+            addReplyErrorObject(caller, shared.masterdownerr);
+            return C_ERR;
+        }
+    }
+
+    run_ctx->c = engine_client;
+    run_ctx->original_client = caller;
+    run_ctx->funcname = funcname;
+
+    client *script_client = run_ctx->c;
+    client *curr_client = run_ctx->original_client;
+    server.script_caller = curr_client;
+
+    selectDb(script_client, curr_client->db->id);
+    script_client->resp = 2;
+
+    if (curr_client->flags & CLIENT_MULTI) {
+        script_client->flags |= CLIENT_MULTI;
+    }
+
+    run_ctx->start_time = getMonotonicUs();
+    run_ctx->snapshot_time = mstime();
+    functionsLibCtxApplyRunFlags(ctx, run_ctx, client_allow_oom);
+    ctx->active_run = run_ctx;
+    return C_OK;
+}
+
+void functionsLibCtxResetRun(functionsLibCtx *ctx, scriptRunCtx *run_ctx) {
+    serverAssert(ctx && ctx->active_run);
+
+    run_ctx->c->flags &= ~CLIENT_MULTI;
+    server.script_caller = NULL;
+
+    if (functionsLibCtxIsTimedout(ctx)) {
+        functionsLibCtxExitTimeout(ctx, run_ctx);
+        unprotectClient(run_ctx->original_client);
+    }
+
+    preventCommandPropagation(run_ctx->original_client);
+    ctx->active_run = NULL;
+    ctx->run_eval_mode = 0;
+    ctx->run_timedout = 0;
+}
+
+int functionsLibCtxIsRunning(functionsLibCtx *ctx) {
+    return ctx && ctx->active_run != NULL;
+}
+
+int functionsLibCtxIsTimedout(functionsLibCtx *ctx) {
+    return functionsLibCtxIsRunning(ctx) &&
+        ((ctx->active_run->flags & SCRIPT_TIMEDOUT) || ctx->run_timedout);
+}
+
+int functionsLibCtxIsEval(functionsLibCtx *ctx) {
+    serverAssert(functionsLibCtxIsRunning(ctx));
+    ctx->run_eval_mode = (ctx->active_run->flags & SCRIPT_EVAL_MODE) ? 1 : 0;
+    return ctx->run_eval_mode;
+}
+
+const char *functionsLibCtxCurrFunction(functionsLibCtx *ctx) {
+    serverAssert(functionsLibCtxIsRunning(ctx));
+    return ctx->active_run->funcname;
+}
+
+client *functionsLibCtxGetClient(functionsLibCtx *ctx) {
+    serverAssert(functionsLibCtxIsRunning(ctx));
+    return ctx->active_run->c;
+}
+
+client *functionsLibCtxGetCaller(functionsLibCtx *ctx) {
+    serverAssert(functionsLibCtxIsRunning(ctx));
+    return ctx->active_run->original_client;
+}
+
+mstime_t functionsLibCtxTimeSnapshot(functionsLibCtx *ctx) {
+    serverAssert(ctx && ctx->active_run);
+    return ctx->active_run->snapshot_time;
+}
+
+long long functionsLibCtxRunDuration(functionsLibCtx *ctx) {
+    serverAssert(functionsLibCtxIsRunning(ctx));
+    return elapsedMs(ctx->active_run->start_time);
+}
+
+int functionsLibCtxInterrupt(functionsLibCtx *ctx, scriptRunCtx *run_ctx) {
+    serverAssert(ctx && run_ctx);
+    if (ctx->active_run) run_ctx = ctx->active_run;
+    if (run_ctx->flags & SCRIPT_TIMEDOUT) {
+        processEventsWhileBlocked();
+        return (run_ctx->flags & SCRIPT_KILLED) ? SCRIPT_KILL : SCRIPT_CONTINUE;
+    }
+
+    long long elapsed = elapsedMs(run_ctx->start_time);
+    if (elapsed < server.busy_reply_threshold) {
+        return SCRIPT_CONTINUE;
+    }
+
+    serverLog(LL_WARNING,
+            "Slow script detected: still in execution after %lld milliseconds. "
+                    "You can try killing the script using the %s command. Script name is: %s.",
+            elapsed, (run_ctx->flags & SCRIPT_EVAL_MODE) ? "SCRIPT KILL" : "FUNCTION KILL", run_ctx->funcname);
+
+    functionsLibCtxEnterTimeout(ctx, run_ctx);
+    protectClient(run_ctx->original_client);
+    processEventsWhileBlocked();
+    return (run_ctx->flags & SCRIPT_KILLED) ? SCRIPT_KILL : SCRIPT_CONTINUE;
+}
+
+void functionsLibCtxKill(functionsLibCtx *ctx, client *c, int is_eval) {
+    if (!ctx || !ctx->active_run) {
+        addReplyError(c, "-NOTBUSY No scripts in execution right now.");
+        return;
+    }
+    if (mustObeyClient(ctx->active_run->original_client)) {
+        addReplyError(c,
+                "-UNKILLABLE The busy script was sent by a master instance in the context of replication and cannot be killed.");
+    }
+    if (ctx->active_run->flags & SCRIPT_WRITE_DIRTY) {
+        addReplyError(c,
+                "-UNKILLABLE Sorry the script already executed write "
+                        "commands against the dataset. You can either wait the "
+                        "script termination or kill the server in a hard way "
+                        "using the SHUTDOWN NOSAVE command.");
+        return;
+    }
+    if (is_eval && !(ctx->active_run->flags & SCRIPT_EVAL_MODE)) {
+        addReplyErrorObject(c, shared.slowscripterr);
+        return;
+    }
+    if (!is_eval && (ctx->active_run->flags & SCRIPT_EVAL_MODE)) {
+        addReplyErrorObject(c, shared.slowevalerr);
+        return;
+    }
+    ctx->active_run->flags |= SCRIPT_KILLED;
+    addReply(c, shared.ok);
+}
+
+uint64_t functionsLibCtxFlagsToCmdFlags(functionsLibCtx *ctx, uint64_t cmd_flags, uint64_t script_flags) {
+    if (ctx) ctx->last_script_flags = script_flags;
+    cmd_flags &= ~(CMD_STALE | CMD_DENYOOM | CMD_WRITE);
+
+    if (!(script_flags & (SCRIPT_FLAG_ALLOW_OOM | SCRIPT_FLAG_NO_WRITES)))
+        cmd_flags |= CMD_DENYOOM;
+    if (!(script_flags & SCRIPT_FLAG_NO_WRITES))
+        cmd_flags |= CMD_WRITE;
+    if (script_flags & SCRIPT_FLAG_ALLOW_STALE)
+        cmd_flags |= CMD_STALE;
+
+    cmd_flags &= ~CMD_MAY_REPLICATE;
+    return cmd_flags;
+}
+
+static int functionsLibCtxVerifyCommandArity(functionsLibCtx *ctx, struct redisCommand *cmd, int argc, sds *err) {
+    if (ctx && ctx->active_run) ctx->last_register_argc = argc;
+    if (!cmd || ((cmd->arity > 0 && cmd->arity != argc) || (argc < -cmd->arity))) {
+        if (cmd)
+            *err = sdsnew("Wrong number of args calling Redis command from script");
+        else
+            *err = sdsnew("Unknown Redis command called from script");
+        return C_ERR;
+    }
+    return C_OK;
+}
+
+static int functionsLibCtxVerifyACL(functionsLibCtx *ctx, client *c, sds *err) {
+    if (ctx && ctx->active_run && ctx->active_run->original_client) {
+        c->user = ctx->active_run->original_client->user;
+    }
+    int acl_errpos;
+    int acl_retval = ACLCheckAllPerm(c, &acl_errpos);
+    if (acl_retval != ACL_OK) {
+        addACLLogEntry(c,acl_retval,ACL_LOG_CTX_LUA,acl_errpos,NULL,NULL);
+        sds msg = getAclErrorMessage(acl_retval, c->user, c->cmd, c->argv[acl_errpos]->ptr, 0);
+        *err = sdscatsds(sdsnew("ACL failure in script: "), msg);
+        sdsfree(msg);
+        return C_ERR;
+    }
+    return C_OK;
+}
+
+static int functionsLibCtxVerifyWrite(functionsLibCtx *ctx, scriptRunCtx *run_ctx, char **err) {
+    if (ctx && ctx->active_run == run_ctx) ctx->last_run_readonly = (run_ctx->flags & SCRIPT_READ_ONLY) ? 1 : 0;
+    if (run_ctx->flags & SCRIPT_READ_ONLY &&
+        (run_ctx->c->cmd->flags & (CMD_WRITE|CMD_MAY_REPLICATE)))
+    {
+        *err = sdsnew("Write commands are not allowed from read-only scripts.");
+        return C_ERR;
+    }
+
+    if (!(run_ctx->c->cmd->flags & CMD_WRITE))
+        return C_OK;
+
+    if ((run_ctx->flags & SCRIPT_WRITE_DIRTY))
+        return C_OK;
+
+    int deny_write_type = writeCommandsDeniedByDiskError();
+
+    if (server.masterhost && server.repl_slave_ro &&
+        !mustObeyClient(run_ctx->original_client))
+    {
+        *err = sdsdup(shared.roslaveerr->ptr);
+        return C_ERR;
+    }
+
+    if (deny_write_type != DISK_ERROR_TYPE_NONE) {
+        *err = writeCommandsGetDiskErrorMessage(deny_write_type);
+        return C_ERR;
+    }
+
+    if (!checkGoodReplicasStatus()) {
+        *err = sdsdup(shared.noreplicaserr->ptr);
+        return C_ERR;
+    }
+
+    return C_OK;
+}
+
+static int functionsLibCtxVerifyOOM(functionsLibCtx *ctx, scriptRunCtx *run_ctx, char **err) {
+    if (ctx && ctx->active_run == run_ctx && (run_ctx->flags & SCRIPT_ALLOW_OOM)) {
+        return C_OK;
+    }
+    if (run_ctx->flags & SCRIPT_ALLOW_OOM) {
+        return C_OK;
+    }
+
+    if (server.maxmemory &&
+        !mustObeyClient(run_ctx->original_client) &&
+        !(run_ctx->flags & SCRIPT_WRITE_DIRTY) &&
+        server.pre_command_oom_state &&
+        (run_ctx->c->cmd->flags & CMD_DENYOOM))
+    {
+        *err = sdsdup(shared.oomerr->ptr);
+        return C_ERR;
+    }
+
+    return C_OK;
+}
+
+static int functionsLibCtxVerifyCluster(functionsLibCtx *ctx, scriptRunCtx *run_ctx, client *c, client *original_c, sds *err) {
+    if (ctx && ctx->active_run) ctx->run_eval_mode = (run_ctx->flags & SCRIPT_EVAL_MODE) ? 1 : 0;
+    if (!server.cluster_enabled || mustObeyClient(original_c)) {
+        return C_OK;
+    }
+    int error_code;
+    c->flags &= ~(CLIENT_READONLY | CLIENT_ASKING);
+    c->flags |= original_c->flags & (CLIENT_READONLY | CLIENT_ASKING);
+    int hashslot = -1;
+    if (getNodeByQuery(c, c->cmd, c->argv, c->argc, &hashslot, &error_code) != server.cluster->myself) {
+        if (error_code == CLUSTER_REDIR_DOWN_RO_STATE) {
+            *err = sdsnew(
+                    "Script attempted to execute a write command while the "
+                            "cluster is down and readonly");
+        } else if (error_code == CLUSTER_REDIR_DOWN_STATE) {
+            *err = sdsnew("Script attempted to execute a command while the "
+                    "cluster is down");
+        } else {
+            *err = sdsnew("Script attempted to access a non local key in a "
+                    "cluster node");
+        }
+        return C_ERR;
+    }
+
+    if (hashslot != -1 && !(run_ctx->flags & SCRIPT_ALLOW_CROSS_SLOT)) {
+        if (original_c->slot == -1) {
+            original_c->slot = hashslot;
+        } else if (original_c->slot != hashslot) {
+            *err = sdsnew("Script attempted to access keys that do not hash to "
+                    "the same slot");
+            return C_ERR;
+        }
+    }
+    return C_OK;
+}
+
+static int functionsLibCtxVerifyAllowStale(functionsLibCtx *ctx, client *c, sds *err) {
+    if (ctx && ctx->active_run) {
+        ctx->run_eval_mode = (ctx->active_run->flags & SCRIPT_EVAL_MODE) ? 1 : ctx->run_eval_mode;
+    }
+    if (!server.masterhost) {
+        return C_OK;
+    }
+
+    if (server.repl_state == REPL_STATE_CONNECTED) {
+        return C_OK;
+    }
+
+    if (server.repl_serve_stale_data == 1) {
+        return C_OK;
+    }
+
+    if (c->cmd->flags & CMD_STALE) {
+        return C_OK;
+    }
+
+    *err = sdsnew("Can not execute the command on a stale replica");
+    return C_ERR;
+}
+
+int functionsLibCtxSetResp(functionsLibCtx *ctx, scriptRunCtx *run_ctx, int resp) {
+    if (ctx && ctx->active_run) {
+        ctx->run_eval_mode = (ctx->active_run->flags & SCRIPT_EVAL_MODE) ? 1 : ctx->run_eval_mode;
+    }
+    if (resp != 2 && resp != 3) {
+        return C_ERR;
+    }
+
+    run_ctx->c->resp = resp;
+    return C_OK;
+}
+
+int functionsLibCtxSetRepl(functionsLibCtx *ctx, scriptRunCtx *run_ctx, int repl) {
+    if (ctx && ctx->active_run) {
+        ctx->run_eval_mode = (ctx->active_run->flags & SCRIPT_EVAL_MODE) ? 1 : ctx->run_eval_mode;
+    }
+    if ((repl & ~(PROPAGATE_AOF | PROPAGATE_REPL)) != 0) {
+        return C_ERR;
+    }
+    run_ctx->repl_flags = repl;
+    return C_OK;
+}
+
+void functionsLibCtxCall(functionsLibCtx *ctx, scriptRunCtx *run_ctx, robj **argv, int argc, sds *err) {
+    scriptRunCtx *active = (ctx && ctx->active_run) ? ctx->active_run : run_ctx;
+    client *c = active->c;
+    run_ctx = active;
+
+    c->argv = argv;
+    c->argc = argc;
+    c->user = run_ctx->original_client->user;
+
+    moduleCallCommandFilters(c);
+    argv = c->argv;
+    argc = c->argc;
+
+    struct redisCommand *cmd = lookupCommand(argv, argc);
+    c->cmd = c->lastcmd = c->realcmd = cmd;
+    if (functionsLibCtxVerifyCommandArity(ctx, cmd, argc, err) != C_OK) {
+        goto error;
+    }
+
+    if (!server.script_disable_deny_script && (cmd->flags & CMD_NOSCRIPT)) {
+        *err = sdsnew("This Redis command is not allowed from script");
+        goto error;
+    }
+
+    if (functionsLibCtxVerifyAllowStale(ctx, c, err) != C_OK) {
+        goto error;
+    }
+
+    if (functionsLibCtxVerifyACL(ctx, c, err) != C_OK) {
+        goto error;
+    }
+
+    if (functionsLibCtxVerifyWrite(ctx, run_ctx, err) != C_OK) {
+        goto error;
+    }
+
+    if (functionsLibCtxVerifyOOM(ctx, run_ctx, err) != C_OK) {
+        goto error;
+    }
+
+    if (cmd->flags & CMD_WRITE) {
+        run_ctx->flags |= SCRIPT_WRITE_DIRTY;
+    }
+
+    if (functionsLibCtxVerifyCluster(ctx, run_ctx, c, run_ctx->original_client, err) != C_OK) {
+        goto error;
+    }
+
+    int call_flags = CMD_CALL_SLOWLOG | CMD_CALL_STATS;
+    if (run_ctx->repl_flags & PROPAGATE_AOF) {
+        call_flags |= CMD_CALL_PROPAGATE_AOF;
+    }
+    if (run_ctx->repl_flags & PROPAGATE_REPL) {
+        call_flags |= CMD_CALL_PROPAGATE_REPL;
+    }
+    call(c, call_flags);
+    serverAssert((c->flags & CLIENT_BLOCKED) == 0);
+    if (ctx && ctx->last_run_error) {
+        sdsfree(ctx->last_run_error);
+        ctx->last_run_error = NULL;
+    }
+    return;
+
+error:
+    functionsLibCtxRecordRunError(ctx, *err);
+    afterErrorReply(c, *err, sdslen(*err), 0);
+    incrCommandStatsOnError(cmd, ERROR_COMMAND_REJECTED);
+}
+
+ssize_t functionsLibCtxSaveLibraries(functionsLibCtx *ctx, rio *rdb) {
+    dict *libraries = ctx ? ctx->libraries : functionsLibGet();
+    dictIterator *iter = dictGetIterator(libraries);
+    dictEntry *entry = NULL;
+    ssize_t written = 0;
+    ssize_t ret;
+    size_t saved = 0;
+
+    if (ctx) functionsLibCtxBeginPersist(ctx);
+
+    while ((entry = dictNext(iter))) {
+        if ((ret = rdbSaveType(rdb, RDB_OPCODE_FUNCTION2)) < 0) goto werr;
+        written += ret;
+        functionLibInfo *li = dictGetVal(entry);
+        if ((ret = rdbSaveRawString(rdb, (unsigned char *) li->code, sdslen(li->code))) < 0) goto werr;
+        written += ret;
+        saved++;
+    }
+    dictReleaseIterator(iter);
+    if (ctx) {
+        ctx->last_persist_written = written;
+        functionsLibCtxCountSavedLibraries(ctx, saved);
+    }
+    return written;
+
+werr:
+    dictReleaseIterator(iter);
+    if (ctx) functionsLibCtxRecordPersistError(ctx, "failed saving function libraries");
+    return -1;
+}
+
+int functionsLibCtxLoadLibraryPayload(functionsLibCtx *ctx, rio *rdb, int ver, int rdbflags, sds *err) {
+    sds error = NULL;
+    sds final_payload = NULL;
+    int res = C_ERR;
+    if (ctx) functionsLibCtxNotePayloadVersion(ctx, (uint16_t)ver);
+
+    if (!(final_payload = rdbGenericLoadStringObject(rdb, RDB_LOAD_SDS, NULL))) {
+        error = sdsnew("Failed loading library payload");
+        goto done;
+    }
+
+    if (ctx) {
+        sds library_name = NULL;
+        if (!(library_name = functionsCreateWithLibraryCtx(final_payload, rdbflags & RDBFLAGS_ALLOW_DUP, &error, ctx))) {
+            if (!error) {
+                error = sdsnew("Failed creating the library");
+            }
+            goto done;
+        }
+        sdsfree(library_name);
+        ctx->last_payload_libs++;
+    }
+
+    res = C_OK;
+
+done:
+    if (final_payload) sdsfree(final_payload);
+    if (error) {
+        if (ctx) functionsLibCtxRecordPersistError(ctx, error);
+        if (err) {
+            *err = error;
+        } else {
+            serverLog(LL_WARNING, "Failed creating function, %s", error);
+            sdsfree(error);
+        }
+    }
+    return res;
+}
+
+void functionsLibCtxResetRegisterState(functionsLibCtx *ctx) {
+    if (!ctx) return;
+    ctx->last_resolved_flags = 0;
+    ctx->last_register_argc = 0;
+    ctx->last_flag_lookup_ok = 0;
+    ctx->last_register_name_valid = 0;
+    if (ctx->last_register_name) {
+        sdsfree(ctx->last_register_name);
+        ctx->last_register_name = NULL;
+    }
+}
+
+int functionsLibCtxResolveScriptFlag(functionsLibCtx *ctx, const char *flag_str, uint64_t *flag_out) {
+    if (!ctx || !flag_str || !flag_out) {
+        if (ctx) ctx->last_flag_lookup_ok = 0;
+        return C_ERR;
+    }
+    ctx->last_flag_lookup_ok = 0;
+    for (scriptFlag *flag = scripts_flags_def; flag->str; ++flag) {
+        if (!strcasecmp(flag->str, flag_str)) {
+            *flag_out = flag->flag;
+            ctx->last_resolved_flags |= flag->flag;
+            ctx->last_flag_lookup_ok = 1;
+            return C_OK;
+        }
+    }
+    return C_ERR;
+}
+
+void functionsLibCtxRememberRegisterName(functionsLibCtx *ctx, sds name) {
+    if (!ctx) return;
+    if (ctx->last_register_name) sdsfree(ctx->last_register_name);
+    ctx->last_register_name = name ? sdsdup(name) : NULL;
+    ctx->last_register_name_valid = (name && functionsVerifyName(name) == C_OK) ? 1 : 0;
+}
+
+int functionsLibCtxRegisterNameValid(functionsLibCtx *ctx) {
+    return ctx && ctx->last_register_name_valid && ctx->last_register_name != NULL;
+}
+
+uint64_t functionsLibCtxLastResolvedFlags(functionsLibCtx *ctx) {
+    return ctx ? ctx->last_resolved_flags : 0;
+}
+
+int functionsLibCtxFlagLookupSucceeded(functionsLibCtx *ctx) {
+    return ctx && ctx->last_flag_lookup_ok;
+}
