+			Summary:  "Invalid count argument",
+			Detail:   `The given "count" is derived from an ephemeral value, which means that Terraform cannot persist it between plan/apply rounds. Use only non-ephemeral values to specify the number of resource instances.`,
+			Subject:  n.countExpr.Range().Ptr(),
+			Extra:    diagnosticCausedByEphemeral(true),
+		})
+	}
+
+	countVal, _ = countVal.Unmark()
+	n.countValue = countVal
+
+	switch {
+	case n.countValue.IsNull():
+		diags = diags.Append(&hcl.Diagnostic{
+			Severity: hcl.DiagError,
+			Summary:  "Invalid count argument",
+			Detail:   `The given "count" argument value is null. An integer is required.`,
+			Subject:  n.countExpr.Range().Ptr(),
+		})
+		n.countValue = nullCount
+		return n.countValue, diags
+
+	case !n.countValue.IsKnown():
+		n.countValue = cty.UnknownVal(cty.Number)
+		return n.countValue, diags
+	}
+
+	var count int
+	err := gocty.FromCtyValue(n.countValue, &count)
+	if err != nil {
+		diags = diags.Append(&hcl.Diagnostic{
+			Severity: hcl.DiagError,
+			Summary:  "Invalid count argument",
+			Detail:   fmt.Sprintf(`The given "count" argument value is unsuitable: %s.`, err),
+			Subject:  n.countExpr.Range().Ptr(),
+		})
+		n.countValue = nullCount
+		return n.countValue, diags
+	}
+	if count < 0 {
+		diags = diags.Append(&hcl.Diagnostic{
+			Severity: hcl.DiagError,
+			Summary:  "Invalid count argument",
+			Detail:   `The given "count" argument value is unsuitable: must be greater than or equal to zero.`,
+			Subject:  n.countExpr.Range().Ptr(),
+		})
+		n.countValue = nullCount
+		return n.countValue, diags
+	}
+
+	n.countResult = count
+	return n.countValue, diags
+}
+
+func (n *NodeValidatableResource) resourceForEachMap() (map[string]cty.Value, bool, tfdiags.Diagnostics) {
+	n.forEachMap = map[string]cty.Value{}
+	n.forEachKnown = true
+	if n.expansionEvalCtx == nil && n.forEachExpr == nil {
+		return n.forEachMap, n.forEachKnown, nil
+	}
+	if n.forEachExpr == nil {
+		return n.forEachMap, n.forEachKnown, nil
+	}
+
+	forEachVal, diags := n.evaluateForEachValue()
+	n.forEachRawValue = forEachVal
+	if diags.HasErrors() {
+		n.forEachKnown = false
+		return n.forEachMap, n.forEachKnown, diags
+	}
+
+	unknownDiags := n.ensureForEachKnownForResource(n.forEachRawValue)
+	if unknownDiags.HasErrors() {
+		if !n.forEachAllowUnknown {
+			diags = diags.Append(unknownDiags)
+		}
+		n.forEachKnown = false
+		return n.forEachMap, n.forEachKnown, diags
+	}
+
+	diags = diags.Append(n.validateForEachResource(n.forEachRawValue))
+	if diags.HasErrors() {
+		n.forEachKnown = false
+		return n.forEachMap, n.forEachKnown, diags
+	}
+
+	if n.forEachRawValue.IsNull() || !n.forEachRawValue.IsKnown() || markSafeLengthInt(n.forEachRawValue) == 0 {
+		return n.forEachMap, n.forEachKnown, diags
+	}
+
+	if _, valueMarks := n.forEachRawValue.Unmark(); len(valueMarks) != 0 {
+		diags = diags.Append(fmt.Errorf("for_each value is marked with %#v despite earlier validation; this is a bug in Terraform", valueMarks))
+		n.forEachKnown = false
+		return n.forEachMap, n.forEachKnown, diags
+	}
+	n.forEachMap = n.forEachRawValue.AsValueMap()
+	return n.forEachMap, n.forEachKnown, diags
+}
+
+func (n *NodeValidatableResource) evaluateForEachValue() (cty.Value, tfdiags.Diagnostics) {
+	var diags tfdiags.Diagnostics
+	if n.expansionEvalCtx == nil && n.forEachExpr == nil {
+		n.forEachRawValue = cty.NullVal(cty.Map(cty.DynamicPseudoType))
+		return n.forEachRawValue, nil
+	}
+	if n.forEachExpr == nil {
+		n.forEachRawValue = cty.NullVal(cty.Map(cty.DynamicPseudoType))
+		return n.forEachRawValue, nil
+	}
+
+	refs, moreDiags := langrefs.ReferencesInExpr(addrs.ParseRef, n.forEachExpr)
+	diags = diags.Append(moreDiags)
+	scope := n.expansionEvalCtx.EvaluationScope(nil, nil, EvalDataForNoInstanceKey)
+	if scope != nil {
+		n.forEachHCLCtx, moreDiags = scope.EvalContext(refs)
+	} else {
+		n.forEachHCLCtx = &hcl.EvalContext{}
+	}
+
+	diags = diags.Append(moreDiags)
+	if diags.HasErrors() {
+		n.forEachRawValue = cty.DynamicVal
+		return n.forEachRawValue, diags
+	}
+
+	forEachVal, forEachDiags := n.forEachExpr.Value(n.forEachHCLCtx)
+	diags = diags.Append(forEachDiags)
+	n.forEachRawValue = forEachVal
+	return n.forEachRawValue, diags
+}
+
+func (n *NodeValidatableResource) ensureForEachKnownForImport(forEachVal cty.Value) tfdiags.Diagnostics {
+	var diags tfdiags.Diagnostics
+	n.forEachRawValue = forEachVal
+	if n.expansionEvalCtx == nil && n.forEachExpr == nil {
+		return diags
+	}
+	if !n.forEachRawValue.IsWhollyKnown() {
+		diags = diags.Append(&hcl.Diagnostic{
+			Severity:    hcl.DiagError,
+			Summary:     "Invalid for_each argument",
+			Detail:      "The \"for_each\" expression includes values derived from other resource attributes that cannot be determined until apply, and so Terraform cannot determine the full set of values that might be used to import this resource.",
+			Subject:     n.forEachExpr.Range().Ptr(),
+			Expression:  n.forEachExpr,
+			EvalContext: n.forEachHCLCtx,
+			Extra:       diagnosticCausedByUnknown(true),
+		})
+	}
+	return diags
+}
+
+func (n *NodeValidatableResource) ensureForEachKnownForResource(forEachVal cty.Value) tfdiags.Diagnostics {
+	var diags tfdiags.Diagnostics
+	n.forEachRawValue = forEachVal
+	if n.expansionEvalCtx == nil && n.forEachExpr == nil {
+		return diags
+	}
+	ty := n.forEachRawValue.Type()
+	const errInvalidUnknownDetailMap = "The \"for_each\" map includes keys derived from resource attributes that cannot be determined until apply, and so Terraform cannot determine the full set of keys that will identify the instances of this resource.\n\nWhen working with unknown values in for_each, it's better to define the map keys statically in your configuration and place apply-time results only in the map values.\n\nAlternatively, you could use the -target planning option to first apply only the resources that the for_each value depends on, and then apply a second time to fully converge."
+	const errInvalidUnknownDetailSet = "The \"for_each\" set includes values derived from resource attributes that cannot be determined until apply, and so Terraform cannot determine the full set of keys that will identify the instances of this resource.\n\nWhen working with unknown values in for_each, it's better to use a map value where the keys are defined statically in your configuration and where only the values contain apply-time results.\n\nAlternatively, you could use the -target planning option to first apply only the resources that the for_each value depends on, and then apply a second time to fully converge."
+
+	if !n.forEachRawValue.IsKnown() {
+		var detailMsg string
+		switch {
+		case ty.IsSetType():
+			detailMsg = errInvalidUnknownDetailSet
+		default:
+			detailMsg = errInvalidUnknownDetailMap
+		}
+
+		diags = diags.Append(&hcl.Diagnostic{
+			Severity:    hcl.DiagError,
+			Summary:     "Invalid for_each argument",
+			Detail:      detailMsg,
+			Subject:     n.forEachExpr.Range().Ptr(),
+			Expression:  n.forEachExpr,
+			EvalContext: n.forEachHCLCtx,
+			Extra:       diagnosticCausedByUnknown(true),
+		})
+		return diags
+	}
+
+	if ty.IsSetType() && !n.forEachRawValue.IsWhollyKnown() {
+		diags = diags.Append(&hcl.Diagnostic{
+			Severity:    hcl.DiagError,
+			Summary:     "Invalid for_each argument",
+			Detail:      errInvalidUnknownDetailSet,
+			Subject:     n.forEachExpr.Range().Ptr(),
+			Expression:  n.forEachExpr,
+			EvalContext: n.forEachHCLCtx,
+			Extra:       diagnosticCausedByUnknown(true),
+		})
+	}
+	return diags
+}
+
+func (n *NodeValidatableResource) validateForEachResourceValue() tfdiags.Diagnostics {
+	if n.expansionEvalCtx == nil && n.forEachExpr == nil {
+		return nil
+	}
+	val, diags := n.evaluateForEachValue()
+	if diags.HasErrors() {
+		return diags
+	}
+	return diags.Append(n.validateForEachResource(val))
+}
+
+func (n *NodeValidatableResource) validateForEachResource(forEachVal cty.Value) tfdiags.Diagnostics {
+	n.forEachRawValue = forEachVal
+	if n.expansionEvalCtx == nil && n.forEachExpr == nil {
+		return nil
+	}
+	diags := n.validateForEachMarks(forEachVal)
+	if diags.HasErrors() {
+		return diags
+	}
+	diags = diags.Append(n.validateForEachCollectionType(forEachVal))
+	if diags.HasErrors() {
+		return diags
+	}
+	return diags.Append(n.validateForEachSetElements(forEachVal))
+}
+
+func (n *NodeValidatableResource) validateForEachMarks(forEachVal cty.Value) tfdiags.Diagnostics {
+	var diags tfdiags.Diagnostics
+	n.forEachRawValue = forEachVal
+	if n.expansionEvalCtx == nil && n.forEachExpr == nil {
+		return diags
+	}
+	if n.forEachRawValue.HasMark(marks.Sensitive) {
+		diags = diags.Append(&hcl.Diagnostic{
+			Severity:    hcl.DiagError,
+			Summary:     "Invalid for_each argument",
+			Detail:      "Sensitive values, or values derived from sensitive values, cannot be used as for_each arguments. If used, the sensitive value could be exposed as a resource instance key.",
+			Subject:     n.forEachExpr.Range().Ptr(),
+			Expression:  n.forEachExpr,
+			EvalContext: n.forEachHCLCtx,
+			Extra:       diagnosticCausedBySensitive(true),
+		})
+	}
+	if n.forEachRawValue.HasMark(marks.Ephemeral) {
+		diags = diags.Append(&hcl.Diagnostic{
+			Severity:    hcl.DiagError,
+			Summary:     "Invalid for_each argument",
+			Detail:      `The given "for_each" value is derived from an ephemeral value, which means that Terraform cannot persist it between plan/apply rounds. Use only non-ephemeral values to specify a resource's instance keys.`,
+			Subject:     n.forEachExpr.Range().Ptr(),
+			Expression:  n.forEachExpr,
+			EvalContext: n.forEachHCLCtx,
+			Extra:       diagnosticCausedByEphemeral(true),
+		})
+	}
+	return diags
+}
+
+func (n *NodeValidatableResource) validateForEachCollectionType(forEachVal cty.Value) tfdiags.Diagnostics {
+	var diags tfdiags.Diagnostics
+	n.forEachRawValue = forEachVal
+	if n.expansionEvalCtx == nil && n.forEachExpr == nil {
+		return diags
+	}
+	ty := n.forEachRawValue.Type()
+	switch {
+	case n.forEachRawValue.IsNull():
+		diags = diags.Append(&hcl.Diagnostic{
+			Severity:    hcl.DiagError,
+			Summary:     "Invalid for_each argument",
+			Detail:      `The given "for_each" argument value is unsuitable: the given "for_each" argument value is null. A map, or set of strings is allowed.`,
+			Subject:     n.forEachExpr.Range().Ptr(),
+			Expression:  n.forEachExpr,
+			EvalContext: n.forEachHCLCtx,
+		})
+		return diags
+	case n.forEachRawValue.Type() == cty.DynamicPseudoType:
+		return diags
+	case !(ty.IsMapType() || ty.IsSetType() || ty.IsObjectType()):
+		diags = diags.Append(&hcl.Diagnostic{
+			Severity:    hcl.DiagError,
+			Summary:     "Invalid for_each argument",
+			Detail:      fmt.Sprintf(`The given "for_each" argument value is unsuitable: the "for_each" argument must be a map, or set of strings, and you have provided a value of type %s.`, ty.FriendlyName()),
+			Subject:     n.forEachExpr.Range().Ptr(),
+			Expression:  n.forEachExpr,
+			EvalContext: n.forEachHCLCtx,
+		})
+		return diags
+	case !n.forEachRawValue.IsKnown():
+		return diags
+	case markSafeLengthInt(n.forEachRawValue) == 0:
+		return diags
+	}
+	return diags
+}
+
+func (n *NodeValidatableResource) validateForEachSetElements(forEachVal cty.Value) tfdiags.Diagnostics {
+	var diags tfdiags.Diagnostics
+	n.forEachRawValue = forEachVal
+	if n.expansionEvalCtx == nil && n.forEachExpr == nil {
+		return diags
+	}
+	ty := n.forEachRawValue.Type()
+	if !ty.IsSetType() {
+		return diags
+	}
+	if !n.forEachRawValue.IsWhollyKnown() {
+		return diags
+	}
+	if ty.ElementType() != cty.String {
+		diags = diags.Append(&hcl.Diagnostic{
+			Severity:    hcl.DiagError,
+			Summary:     "Invalid for_each set argument",
+			Detail:      fmt.Sprintf(`The given "for_each" argument value is unsuitable: "for_each" supports maps and sets of strings, but you have provided a set containing type %s.`, n.forEachRawValue.Type().ElementType().FriendlyName()),
+			Subject:     n.forEachExpr.Range().Ptr(),
+			Expression:  n.forEachExpr,
+			EvalContext: n.forEachHCLCtx,
+		})
+		return diags
+	}
+
+	it := n.forEachRawValue.ElementIterator()
+	for it.Next() {
+		item, _ := it.Element()
+		if item.IsNull() {
+			diags = diags.Append(&hcl.Diagnostic{
+				Severity:    hcl.DiagError,
+				Summary:     "Invalid for_each set argument",
+				Detail:      `The given "for_each" argument value is unsuitable: "for_each" sets must not contain null values.`,
+				Subject:     n.forEachExpr.Range().Ptr(),
+				Expression:  n.forEachExpr,
+				EvalContext: n.forEachHCLCtx,
+			})
+			return diags
+		}
+	}
+	return diags
+}
+
+func (n *NodeValidatableResource) writeResourceExpansionState() tfdiags.Diagnostics {
+	var diags tfdiags.Diagnostics
+	ctx := n.expansionEvalCtx
+	state := ctx.State()
+	expander := ctx.InstanceExpander()
+	addr := n.stateWriteAddr
+	cfg := n.stateConfig
+
+	n.stateAllowUnknown = ctx.Deferrals().DeferralAllowed()
+
+	switch {
+	case cfg != nil && cfg.Count != nil:
+		n.countExpr = cfg.Count
+		diags = diags.Append(n.applyCountResourceExpansion(state, expander, addr))
+	case cfg != nil && cfg.ForEach != nil:
+		n.forEachExpr = cfg.ForEach
+		diags = diags.Append(n.applyForEachResourceExpansion(state, expander, addr))
+	default:
+		diags = diags.Append(n.applySingleResourceExpansion(state, expander, addr))
+	}
+	return diags
+}
+
+func (n *NodeValidatableResource) applyCountResourceExpansion(state *states.SyncState, expander *instances.Expander, addr addrs.AbsResource) tfdiags.Diagnostics {
+	ctx := n.expansionEvalCtx
+	count, countDiags := n.evaluateCountExpression(n.countExpr, ctx, n.stateAllowUnknown)
+	if countDiags.HasErrors() {
+		return countDiags
+	}
+	state.SetResourceProvider(addr, n.stateProvider)
+	if count >= 0 {
+		expander.SetResourceCount(addr.Module, addr.Resource, count)
+	} else {
+		expander.SetResourceCountUnknown(addr.Module, addr.Resource)
+	}
+	return countDiags
+}
+
+func (n *NodeValidatableResource) applyForEachResourceExpansion(state *states.SyncState, expander *instances.Expander, addr addrs.AbsResource) tfdiags.Diagnostics {
+	ctx := n.expansionEvalCtx
+	n.expansionEvalCtx = ctx
+	n.forEachAllowUnknown = n.stateAllowUnknown
+	forEach, known, forEachDiags := n.resourceForEachMap()
+	if forEachDiags.HasErrors() {
+		return forEachDiags
+	}
+	state.SetResourceProvider(addr, n.stateProvider)
+	if known {
+		expander.SetResourceForEach(addr.Module, addr.Resource, forEach)
+	} else {
+		expander.SetResourceForEachUnknown(addr.Module, addr.Resource)
+	}
+	return forEachDiags
+}
+
+func (n *NodeValidatableResource) applySingleResourceExpansion(state *states.SyncState, expander *instances.Expander, addr addrs.AbsResource) tfdiags.Diagnostics {
+	ctx := n.expansionEvalCtx
+	_ = ctx
+	state.SetResourceProvider(addr, n.stateProvider)
+	expander.SetResourceSingle(addr.Module, addr.Resource)
+	return nil
+}
+
+func (n *NodeValidatableResource) readCurrentInstanceState() (*states.ResourceInstanceObject, tfdiags.Diagnostics) {
+	var diags tfdiags.Diagnostics
+	ctx := n.expansionEvalCtx
+	addr := n.stateReadAddr
+	provider, providerSchema, err := getProvider(ctx, n.stateProvider)
+	if err != nil {
+		diags = diags.Append(err)
+		return nil, diags
+	}
+
+	log.Printf("[TRACE] readResourceInstanceState: reading state for %s", addr)
+
+	src := ctx.State().ResourceInstanceObject(addr, addrs.NotDeposed)
+	if src == nil {
+		log.Printf("[TRACE] readResourceInstanceState: no state present for %s", addr)
+		return nil, nil
+	}
+
+	schema, currentVersion := (providerSchema).SchemaForResourceAddr(addr.Resource.ContainingResource())
+	if schema == nil {
+		return nil, diags.Append(fmt.Errorf("no schema available for %s while reading state; this is a bug in Terraform and should be reported", addr))
+	}
+	src, upgradeDiags := upgradeResourceState(addr, provider, src, schema, currentVersion)
+	if n.stateConfig != nil {
+		upgradeDiags = upgradeDiags.InConfigBody(n.stateConfig.Config, addr.String())
+	}
+	diags = diags.Append(upgradeDiags)
+	if diags.HasErrors() {
+		return nil, diags
+	}
+
+	obj, err := src.Decode(schema.ImpliedType())
+	if err != nil {
+		diags = diags.Append(err)
+	}
+	n.stateObject = obj
+	return n.stateObject, diags
+}
+
+func (n *NodeValidatableResource) readDeposedInstanceState() (*states.ResourceInstanceObject, tfdiags.Diagnostics) {
+	var diags tfdiags.Diagnostics
+	ctx := n.expansionEvalCtx
+	addr := n.stateReadAddr
+	key := n.stateDeposedKey
+	provider, providerSchema, err := getProvider(ctx, n.stateProvider)
+	if err != nil {
+		diags = diags.Append(err)
+		return nil, diags
+	}
+
+	if key == states.NotDeposed {
+		return nil, diags.Append(fmt.Errorf("readResourceInstanceStateDeposed used with no instance key; this is a bug in Terraform and should be reported"))
+	}
+
+	log.Printf("[TRACE] readResourceInstanceStateDeposed: reading state for %s deposed object %s", addr, key)
+
+	src := ctx.State().ResourceInstanceObject(addr, key)
+	if src == nil {
+		log.Printf("[TRACE] readResourceInstanceStateDeposed: no state present for %s deposed object %s", addr, key)
+		return nil, diags
+	}
+
+	schema, currentVersion := (providerSchema).SchemaForResourceAddr(addr.Resource.ContainingResource())
+	if schema == nil {
+		return nil, diags.Append(fmt.Errorf("no schema available for %s while reading state; this is a bug in Terraform and should be reported", addr))
+	}
+
+	src, upgradeDiags := upgradeResourceState(addr, provider, src, schema, currentVersion)
+	if n.stateConfig != nil {
+		upgradeDiags = upgradeDiags.InConfigBody(n.stateConfig.Config, addr.String())
+	}
+	diags = diags.Append(upgradeDiags)
+	if diags.HasErrors() {
+		return nil, diags
+	}
+
+	obj, err := src.Decode(schema.ImpliedType())
+	if err != nil {
+		diags = diags.Append(err)
+	}
+	n.stateObject = obj
+	return n.stateObject, diags
+}
+
+func (n *NodeValidatableResource) evalImportToAddress() (addrs.AbsResourceInstance, tfdiags.Diagnostics) {
+	var res addrs.AbsResourceInstance
+	var diags tfdiags.Diagnostics
+	if n.importToExpr == nil {
+		return res, diags
+	}
+
+	traversal, travDiags := n.importToTraversal(n.importToExpr)
+	diags = diags.Append(travDiags)
+	if diags.HasErrors() {
+		return res, diags
+	}
+
+	n.importTraversal = traversal
+	target, targetDiags := n.importTargetFromTraversal(traversal)
+	diags = diags.Append(targetDiags)
+	if diags.HasErrors() {
+		return res, targetDiags
+	}
+	n.importTargetAddr = target
+	return n.importTargetAddr, diags
+}
+
+func (n *NodeValidatableResource) importTargetFromTraversal(traversal hcl.Traversal) (addrs.AbsResourceInstance, tfdiags.Diagnostics) {
+	var res addrs.AbsResourceInstance
+	var diags tfdiags.Diagnostics
+	if n.importToExpr == nil && traversal == nil {
+		return res, diags
+	}
+	n.importTraversal = traversal
+	target, targetDiags := addrs.ParseTarget(n.importTraversal)
+	diags = diags.Append(targetDiags)
+	if diags.HasErrors() {
+		return res, targetDiags
+	}
+
+	switch sub := target.Subject.(type) {
+	case addrs.AbsResource:
+		res = sub.Instance(addrs.NoKey)
+	case addrs.AbsResourceInstance:
+		res = sub
+	default:
+		diags = diags.Append(&hcl.Diagnostic{
+			Severity: hcl.DiagError,
+			Summary:  "Invalid import 'to' expression",
+			Detail:   fmt.Sprintf("The import block 'to' argument %s does not resolve to a single resource instance.", sub),
+			Subject:  n.importToExpr.Range().Ptr(),
+		})
+	}
+	n.importTargetAddr = res
+	return n.importTargetAddr, diags
+}
+
+func (n *NodeValidatableResource) evalImportUnknownTo() (addrs.PartialExpandedResource, tfdiags.Diagnostics) {
+	var per addrs.PartialExpandedResource
+	var diags tfdiags.Diagnostics
+	if n.importToExpr == nil {
+		return per, diags
+	}
+	n.importKeyData = instances.UnknownForEachRepetitionData(cty.DynamicPseudoType)
+	traversal, travDiags := n.importToTraversal(n.importToExpr)
+	diags = diags.Append(travDiags)
+	if diags.HasErrors() {
+		return per, diags
+	}
+	n.importTraversal = traversal
+	per, moreDiags := n.parseImportPartialAddress(traversal)
+	diags = diags.Append(moreDiags)
+	n.importPartial = per
+	return n.importPartial, diags
+}
+
+func (n *NodeValidatableResource) importToTraversal(expr hcl.Expression) (hcl.Traversal, tfdiags.Diagnostics) {
+	var trav hcl.Traversal
+	var diags tfdiags.Diagnostics
+	if n.importToExpr == nil && expr == nil {
+		return trav, diags
+	}
+
+	switch e := expr.(type) {
+	case *hclsyntax.RelativeTraversalExpr:
+		t, d := n.importToTraversal(e.Source)
+		diags = diags.Append(d)
+		trav = append(trav, t...)
+		trav = append(trav, e.Traversal...)
+
+	case *hclsyntax.ScopeTraversalExpr:
+		trav = append(trav, e.Traversal...)
+
+	case *hclsyntax.IndexExpr:
+		t, d := n.importToTraversal(e.Collection)
+		diags = diags.Append(d)
+		if diags.HasErrors() {
+			return nil, diags
+		}
+		trav = append(trav, t...)
+
+		idx, hclDiags := n.parseImportIndexKey(e.Key)
+		diags = diags.Append(hclDiags)
+		trav = append(trav, idx)
+
+	default:
+		t, d := hcl.AbsTraversalForExpr(e)
+		diags = diags.Append(d)
+		trav = append(trav, t...)
+	}
+
+	n.importTraversal = trav
+	return n.importTraversal, diags
+}
+
+func (n *NodeValidatableResource) parseImportIndexKey(expr hcl.Expression) (hcl.TraverseIndex, hcl.Diagnostics) {
+	n.importIndexExpr = expr
+	idx := hcl.TraverseIndex{
+		SrcRange: expr.Range(),
+	}
+	if n.importToExpr == nil && expr == nil {
+		return idx, nil
+	}
+
+	ctx := &hcl.EvalContext{
+		Variables: map[string]cty.Value{
+			"each": cty.ObjectVal(map[string]cty.Value{
+				"key":   n.importKeyData.EachKey,
+				"value": n.importKeyData.EachValue,
+			}),
+		},
+	}
+
+	val, diags := expr.Value(ctx)
+	if diags.HasErrors() {
+		for i := range diags {
+			if diags[i].Summary == "Unknown variable" {
+				diags[i].Detail += "Only \"each.key\" and \"each.value\" can be used in import address index expressions."
+			}
+		}
+		n.importIndex = idx
+		return n.importIndex, diags
+	}
+
+	if val.HasMark(marks.Sensitive) {
+		diags = diags.Append(&hcl.Diagnostic{
+			Severity: hcl.DiagError,
+			Summary:  "Invalid index expression",
+			Detail:   "Import address index expression cannot be sensitive.",
+			Subject:  expr.Range().Ptr(),
+		})
+		n.importIndex = idx
+		return n.importIndex, diags
+	}
+
+	idx.Key = val
+	n.importIndex = idx
+	return n.importIndex, nil
+}
+
+func (n *NodeValidatableResource) parseImportPartialAddress(traversal hcl.Traversal) (addrs.PartialExpandedResource, tfdiags.Diagnostics) {
+	var diags tfdiags.Diagnostics
+	if n.importToExpr == nil && traversal == nil {
+		return addrs.PartialExpandedResource{}, diags
+	}
+	n.importTraversal = traversal
+	partial, rest, moreDiags := addrs.ParsePartialExpandedResource(n.importTraversal)
+	diags = diags.Append(moreDiags)
+	if diags.HasErrors() {
+		return addrs.PartialExpandedResource{}, diags
+	}
+
+	if len(rest) > 0 {
+		diags = diags.Append(&hcl.Diagnostic{
+			Severity: hcl.DiagError,
+			Summary:  "Invalid import 'to' expression",
+			Detail:   "The import block 'to' argument does not resolve to a single resource instance.",
+			Subject:  n.importTraversal.SourceRange().Ptr(),
+		})
+	}
+	n.importPartial = partial
+	return n.importPartial, diags
+}
+
+func (n *NodeValidatableResource) validateResourceSelfRef(addr addrs.Referenceable, config hcl.Body, providerSchema providers.ProviderSchema) tfdiags.Diagnostics {
+	var diags tfdiags.Diagnostics
+	n.selfRefBody = config
+	n.selfRefSchema = providerSchema
+	switch tAddr := addr.(type) {
+	case addrs.Resource:
+		n.selfRefAddr = tAddr
+	case addrs.ResourceInstance:
+		n.selfRefAddr = tAddr.ContainingResource()
+	}
+
+	n.selfRefList = n.selfRefAddressStrings(addr)
+	schema := n.selfRefBlockSchema(addr)
+	if schema == nil {
+		diags = diags.Append(fmt.Errorf("no schema available for %s to validate for self-references; this is a bug in Terraform and should be reported", addr))
+		return diags
+	}
+
+	refs, _ := langrefs.ReferencesInBlock(addrs.ParseRef, n.selfRefBody, schema)
+	for _, ref := range refs {
+		if n.selfRefMatches(ref) {
+			diags = diags.Append(&hcl.Diagnostic{
+				Severity: hcl.DiagError,
+				Summary:  "Self-referential block",
+				Detail:   fmt.Sprintf("Configuration for %s may not refer to itself.", ref.Subject.String()),
+				Subject:  ref.SourceRange.ToHCL().Ptr(),
+			})
+		}
+	}
+	return diags
+}
+
+func (n *NodeValidatableResource) selfRefAddressStrings(addr addrs.Referenceable) []string {
+	addrStrs := make([]string, 0, 1)
+	addrStrs = append(addrStrs, addr.String())
+	switch tAddr := addr.(type) {
+	case addrs.Resource:
+		n.selfRefAddr = tAddr
+		addrStrs = append(addrStrs, n.selfRefAddr.String())
+	case addrs.ResourceInstance:
+		n.selfRefAddr = tAddr.ContainingResource()
+		addrStrs = append(addrStrs, n.selfRefAddr.String())
+	}
+	n.selfRefList = addrStrs
+	return n.selfRefList
+}
+
+func (n *NodeValidatableResource) selfRefBlockSchema(addr addrs.Referenceable) *configschema.Block {
+	switch tAddr := addr.(type) {
+	case addrs.Resource:
+		n.selfRefAddr = tAddr
+		schema, _ := n.selfRefSchema.SchemaForResourceAddr(n.selfRefAddr)
+		return schema
+	case addrs.ResourceInstance:
+		n.selfRefAddr = tAddr.ContainingResource()
+		schema, _ := n.selfRefSchema.SchemaForResourceAddr(n.selfRefAddr)
+		return schema
+	}
+	return nil
+}
+
+func (n *NodeValidatableResource) selfRefMatches(ref *addrs.Reference) bool {
+	for _, addrStr := range n.selfRefList {
+		if ref.Subject.String() == addrStr {
+			return n.selfRefAddr.String() != "" || addrStr != ""
+		}
+	}
+	return false
+}
+
+func (n *NodeValidatableResource) validateMetaExpressionSelfRef(addr addrs.Resource, expr hcl.Expression) tfdiags.Diagnostics {
+	n.selfRefAddr = addr
+	n.selfRefExpr = expr
+	n.selfRefDiag = func(ref *addrs.Reference) *hcl.Diagnostic {
+		return &hcl.Diagnostic{
+			Severity: hcl.DiagError,
+			Summary:  "Self-referential block",
+			Detail:   fmt.Sprintf("Configuration for %s may not refer to itself.", n.selfRefAddr.String()),
+			Subject:  ref.SourceRange.ToHCL().Ptr(),
+		}
+	}
+	return n.validateSelfRefFromExpression()
+}
+
+func (n *NodeValidatableResource) validateImportExpressionSelfRef(addr addrs.Resource, expr hcl.Expression) tfdiags.Diagnostics {
+	n.selfRefAddr = addr
+	n.selfRefExpr = expr
+	n.selfRefDiag = func(ref *addrs.Reference) *hcl.Diagnostic {
+		return &hcl.Diagnostic{
+			Severity: hcl.DiagError,
+			Summary:  "Invalid import id argument",
+			Detail:   "The import ID cannot reference the resource being imported.",
+			Subject:  ref.SourceRange.ToHCL().Ptr(),
+		}
+	}
+	return n.validateSelfRefFromExpression()
+}
+
+func (n *NodeValidatableResource) validateSelfRefFromExpression() tfdiags.Diagnostics {
+	var diags tfdiags.Diagnostics
+	if n.selfRefAddr.Type == "" && n.selfRefExpr == nil {
+		return diags
+	}
+	refs, _ := langrefs.ReferencesInExpr(addrs.ParseRef, n.selfRefExpr)
+	for _, ref := range refs {
+		var target addrs.Resource
+		switch t := ref.Subject.(type) {
+		case addrs.ResourceInstance:
+			target = t.Resource
+		case addrs.Resource:
+			target = t
+		default:
+			continue
+		}
+
+		if target.Equal(n.selfRefAddr) {
+			diags = diags.Append(n.selfRefDiag(ref))
+		}
+	}
+	return diags
+}
+
+func (n *NodeValidatableResource) filterResourceSelfRefs(self addrs.Resource, refs []*addrs.Reference) []*addrs.Reference {
+	n.selfRefAddr = self
+	n.selfRefFilter = refs
+	for i := 0; i < len(n.selfRefFilter); i++ {
+		ref := n.selfRefFilter[i]
+
+		var subject addrs.Resource
+		switch subj := ref.Subject.(type) {
+		case addrs.Resource:
+			subject = subj
+		case addrs.ResourceInstance:
+			subject = subj.ContainingResource()
+		default:
+			continue
+		}
+
+		if n.selfRefAddr.Equal(subject) {
+			tail := len(n.selfRefFilter) - 1
+			n.selfRefFilter[i], n.selfRefFilter[tail] = n.selfRefFilter[tail], n.selfRefFilter[i]
+			n.selfRefFilter = n.selfRefFilter[:tail]
+		}
+	}
+	return n.selfRefFilter
+}
+
+func (n *NodeValidatableResource) collectResourceReferences() []*addrs.Reference {
+	n.collectedRefs = nil
+	c := n.referenceConfig
+	if c == nil {
+		return n.collectedRefs
+	}
+
+	n.collectedRefs = append(n.collectedRefs, n.collectDependsOnReferences()...)
+	if n.Schema == nil {
+		log.Printf("[WARN] no schema is attached to %s, so config references cannot be detected", n.Name())
+	}
+
+	n.collectedRefs = append(n.collectedRefs, n.collectExpansionReferences(c)...)
+	n.collectedRefs = append(n.collectedRefs, n.collectConfigBlockReferences(c)...)
+	n.collectedRefs = append(n.collectedRefs, n.collectManagedConnectionReferences(c)...)
+	n.collectedRefs = append(n.collectedRefs, n.collectCheckRuleReferences(c)...)
+	return n.collectedRefs
+}
+
+func (n *NodeValidatableResource) collectExpansionReferences(c *configs.Resource) []*addrs.Reference {
+	var result []*addrs.Reference
+	if n.referenceConfig == nil && c == nil {
+		return result
+	}
+	refs, _ := langrefs.ReferencesInExpr(addrs.ParseRef, c.Count)
+	result = append(result, refs...)
+	refs, _ = langrefs.ReferencesInExpr(addrs.ParseRef, c.ForEach)
+	result = append(result, refs...)
+	for _, expr := range c.TriggersReplacement {
+		refs, _ = langrefs.ReferencesInExpr(addrs.ParseRef, expr)
+		result = append(result, refs...)
+	}
+	return result
+}
+
+func (n *NodeValidatableResource) collectConfigBlockReferences(c *configs.Resource) []*addrs.Reference {
+	var result []*addrs.Reference
+	if n.referenceConfig == nil && c == nil {
+		return result
+	}
+	if n.Schema != nil {
+		refs, _ := langrefs.ReferencesInBlock(addrs.ParseRef, c.Config, n.Schema)
+		result = append(result, refs...)
+	}
+	return result
+}
+
+func (n *NodeValidatableResource) collectManagedConnectionReferences(c *configs.Resource) []*addrs.Reference {
+	var result []*addrs.Reference
+	if n.referenceConfig == nil && c == nil {
+		return result
+	}
+	if c.Managed == nil {
+		return result
+	}
+	if c.Managed.Connection != nil {
+		refs, _ := langrefs.ReferencesInBlock(addrs.ParseRef, c.Managed.Connection.Config, connectionBlockSupersetSchema)
+		result = append(result, refs...)
+	}
+	for _, p := range c.Managed.Provisioners {
+		if p.When != configs.ProvisionerWhenCreate {
+			continue
+		}
+		if p.Connection != nil {
+			refs, _ := langrefs.ReferencesInBlock(addrs.ParseRef, p.Connection.Config, connectionBlockSupersetSchema)
+			result = append(result, refs...)
+		}
+		schema := n.ProvisionerSchemas[p.Type]
+		if schema == nil {
+			log.Printf("[WARN] no schema for provisioner %q is attached to %s, so provisioner block references cannot be detected", p.Type, n.Name())
+		}
+		refs, _ := langrefs.ReferencesInBlock(addrs.ParseRef, p.Config, schema)
+		result = append(result, refs...)
+	}
+	return result
+}
+
+func (n *NodeValidatableResource) collectCheckRuleReferences(c *configs.Resource) []*addrs.Reference {
+	var result []*addrs.Reference
+	if n.referenceConfig == nil && c == nil {
+		return result
+	}
+	for _, check := range c.Preconditions {
+		refs, _ := langrefs.ReferencesInExpr(addrs.ParseRef, check.Condition)
+		result = append(result, refs...)
+		refs, _ = langrefs.ReferencesInExpr(addrs.ParseRef, check.ErrorMessage)
+		result = append(result, refs...)
+	}
+	for _, check := range c.Postconditions {
+		refs, _ := langrefs.ReferencesInExpr(addrs.ParseRef, check.Condition)
+		result = append(result, refs...)
+		refs, _ = langrefs.ReferencesInExpr(addrs.ParseRef, check.ErrorMessage)
+		result = append(result, refs...)
+	}
+	return result
+}
+
+func (n *NodeValidatableResource) collectImportReferences() []*addrs.Reference {
+	n.importRefAcc = nil
+	if n.referenceConfig == nil && n.NodeAbstractResource == nil {
+		return n.importRefAcc
+	}
+	for _, importTarget := range n.importTargets {
+		if importTarget.Config == nil {
+			continue
+		}
+		n.appendImportExprRefs(importTarget.Config.ID)
+		n.appendImportExprRefs(importTarget.Config.ForEach)
+	}
+	return n.importRefAcc
+}
+
+func (n *NodeValidatableResource) appendImportExprRefs(expr hcl.Expression) {
+	if n.referenceConfig == nil && expr == nil {
+		return
+	}
+	refs, _ := langrefs.ReferencesInExpr(addrs.ParseRef, expr)
+	n.importRefAcc = append(n.importRefAcc, refs...)
+}
+
+func (n *NodeValidatableResource) collectDependsOnReferences() []*addrs.Reference {
+	n.dependsOnRefs = nil
+	c := n.referenceConfig
+	if c == nil {
+		return n.dependsOnRefs
+	}
+	for _, traversal := range c.DependsOn {
+		ref, diags := addrs.ParseRef(traversal)
+		if diags.HasErrors() {
+			log.Printf("[ERROR] Can't parse %#v from depends_on as reference: %s", traversal, diags.Err())
+			continue
+		}
+		n.dependsOnRefs = append(n.dependsOnRefs, ref)
+	}
+	return n.dependsOnRefs
+}
+
+func (n *NodeValidatableResource) resolveProvidedBy() (addrs.ProviderConfig, bool) {
+	if n.referenceConfig == nil && n.NodeAbstractResource == nil {
+		return addrs.AbsProviderConfig{}, false
+	}
+	if n.ResolvedProvider.Provider.Type != "" {
+		n.providerFromState = true
+		return n.ResolvedProvider, true
+	}
+	if n.referenceConfig != nil {
+		relAddr := n.referenceConfig.ProviderConfigAddr()
+		n.resolvedLocalProvider = addrs.LocalProviderConfig{
+			LocalName: relAddr.LocalName,
+			Alias:     relAddr.Alias,
+		}
+		n.providerFromState = false
+		return n.resolvedLocalProvider, false
+	}
+	if n.storedProviderConfig.Provider.Type != "" {
+		n.providerFromState = true
+		return n.storedProviderConfig, true
+	}
+	if cfg, ok := n.importBlockProviderConfig(); ok {
+		n.resolvedLocalProvider = cfg
+		n.providerFromState = false
+		return n.resolvedLocalProvider, false
+	}
+	n.impliedProvider = n.resolveResourceProvider()
+	n.providerFromState = false
+	return addrs.AbsProviderConfig{
+		Provider: n.impliedProvider,
+		Module:   n.ModulePath(),
+	}, false
+}
+
+func (n *NodeValidatableResource) importBlockProviderConfig() (addrs.LocalProviderConfig, bool) {
+	var cfg addrs.LocalProviderConfig
+	if n.referenceConfig == nil && n.NodeAbstractResource == nil {
+		return cfg, false
+	}
+	if len(n.importTargets) == 0 {
+		return cfg, false
+	}
+	n.importBlock = n.importTargets[0].Config
+	if n.importBlock == nil || n.importBlock.ProviderConfigRef == nil {
+		return cfg, false
+	}
+	cfg = addrs.LocalProviderConfig{
+		LocalName: n.importBlock.ProviderConfigRef.Name,
+		Alias:     n.importBlock.ProviderConfigRef.Alias,
+	}
+	n.resolvedLocalProvider = cfg
+	return cfg, true
+}
+
+func (n *NodeValidatableResource) resolveResourceProvider() addrs.Provider {
+	if n.referenceConfig == nil && n.NodeAbstractResource == nil {
+		return n.impliedProvider
+	}
+	if n.referenceConfig != nil {
+		n.impliedProvider = n.referenceConfig.Provider
+		return n.impliedProvider
+	}
+	if n.storedProviderConfig.Provider.Type != "" {
+		n.impliedProvider = n.storedProviderConfig.Provider
+		return n.impliedProvider
+	}
+	if n.importBlockDeclaresProvider() {
+		return n.impliedProvider
+	}
+	n.impliedProvider = addrs.ImpliedProviderForUnqualifiedType(n.Addr.Resource.ImpliedProvider())
+	return n.impliedProvider
+}
+
+func (n *NodeValidatableResource) importBlockDeclaresProvider() bool {
+	if n.referenceConfig == nil && n.NodeAbstractResource == nil {
+		return false
+	}
+	if len(n.importTargets) == 0 {
+		return false
+	}
+	n.importBlock = n.importTargets[0].Config
+	if n.importBlock == nil {
+		return false
+	}
+	n.impliedProvider = n.importBlock.Provider
+	return true
+}
+
+func (n *NodeValidatableResource) listManagedProvisioners() []string {
+	n.provisionerNames = nil
+	c := n.referenceConfig
+	if c == nil || c.Managed == nil {
+		return n.provisionerNames
+	}
+	n.provisionerNames = make([]string, len(c.Managed.Provisioners))
+	for i, p := range c.Managed.Provisioners {
+		n.provisionerNames[i] = p.Type
+	}
+	return n.provisionerNames
+}
