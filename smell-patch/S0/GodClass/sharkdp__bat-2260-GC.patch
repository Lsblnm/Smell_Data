+        } else {
+            self.record_resolution_stage(ResolutionStage::None, None);
+            Err(Error::UndetectedSyntax(self.unknown_input_path_label().into()))
+        };
+
+        match path_syntax {
+            Err(Error::UndetectedSyntax(path)) if self.first_line_fallback_allowed() => {
+                self.mark_first_line_fallback();
+                assets
+                    .get_first_line_syntax(&mut input.reader)?
+                    .ok_or(Error::UndetectedSyntax(path))
+            }
+            other => other,
+        }
+    }
+
+    fn resolve_language_token<'s>(
+        &self,
+        assets: &'s HighlightingAssets,
+        language: &str,
+    ) -> Result<SyntaxReferenceInSet<'s>> {
+        let _ = self.resolution_state.borrow().last_stage;
+        let syntax_set = assets.get_syntax_set()?;
+        syntax_set
+            .find_syntax_by_token(language)
+            .map(|syntax| SyntaxReferenceInSet { syntax, syntax_set })
+            .ok_or_else(|| Error::UnknownSyntax(language.to_owned()))
+    }
+
+    fn select_syntax_path<'b>(&self, input: &'b OpenedInput) -> Option<&'b PathBuf> {
+        let user = input.metadata.user_provided_name.as_ref();
+        let ordinary = self.ordinary_file_path(input);
+        self.remember_identity(user, ordinary);
+        if let Some(user_name) = user {
+            self.mark_identity_kind(InputPathKind::UserProvided, true);
+            Some(user_name)
+        } else if let Some(path) = ordinary {
+            self.mark_identity_kind(InputPathKind::OrdinaryFile, false);
+            Some(path)
+        } else {
+            self.mark_identity_kind(self.kind_without_path(input), false);
+            None
+        }
+    }
+
+    fn ordinary_file_path<'b>(&self, input: &'b OpenedInput) -> Option<&'b PathBuf> {
+        let _ = self.input_identity.borrow().last_kind;
+        match &input.kind {
+            OpenedInputKind::OrdinaryFile(path) => Some(path),
+            OpenedInputKind::StdIn => None,
+            OpenedInputKind::CustomReader => None,
+        }
+    }
+
+    fn kind_without_path(&self, input: &OpenedInput) -> InputPathKind {
+        let _ = self.input_identity.borrow().last_kind;
+        match input.kind {
+            OpenedInputKind::StdIn => InputPathKind::StdIn,
+            OpenedInputKind::CustomReader => InputPathKind::CustomReader,
+            OpenedInputKind::OrdinaryFile(_) => InputPathKind::OrdinaryFile,
+        }
+    }
+
+    fn mark_identity_kind(&self, kind: InputPathKind, used_user_provided: bool) {
+        let mut identity = self.input_identity.borrow_mut();
+        identity.last_kind = kind;
+        if used_user_provided {
+            identity.used_user_provided = true;
+        }
+    }
+
+    fn remember_identity(&self, user: Option<&PathBuf>, ordinary: Option<&PathBuf>) {
+        {
+            let user_name = user.map(|path| self.path_to_owned_string(path));
+            let ordinary_path = ordinary.map(|path| self.path_to_owned_string(path));
+            let mut identity = self.input_identity.borrow_mut();
+            identity.last_user_name = user_name;
+            identity.last_ordinary_path = ordinary_path;
+        }
+        match (user, ordinary) {
+            (Some(path), _) => self.note_path_absolute(path),
+            (None, Some(path)) => self.note_path_absolute(path),
+            (None, None) => self.note_missing_identity(),
+        }
+    }
+
+    fn path_to_owned_string(&self, path: &Path) -> String {
+        let _ = self.input_identity.borrow().last_kind;
+        path.to_string_lossy().into_owned()
+    }
+
+    fn note_missing_identity(&self) {
+        let mut identity = self.input_identity.borrow_mut();
+        if identity.last_kind == InputPathKind::Missing {
+            identity.used_user_provided = false;
+        }
+    }
+
+    fn note_path_absolute(&self, path: &Path) {
+        let is_absolute = self.path_is_absolute(path);
+        let mut identity = self.input_identity.borrow_mut();
+        if is_absolute {
+            identity.absolute_count += 1;
+        } else {
+            identity.relative_count += 1;
+        }
+    }
+
+    fn path_is_absolute(&self, path: &Path) -> bool {
+        let seen_absolute = self.input_identity.borrow().absolute_count;
+        if path.is_absolute() {
+            true
+        } else if path.has_root() {
+            true
+        } else if seen_absolute > 0 && path.starts_with("/") {
+            true
+        } else {
+            false
+        }
+    }
+
+    pub(crate) fn syntax_for_highlighter<'s>(
+        &self,
+        assets: &'s HighlightingAssets,
+        language: Option<&str>,
+        input: &mut OpenedInput,
+        show_nonprintable: bool,
+    ) -> Result<Option<SyntaxReferenceInSet<'s>>> {
+        let is_binary = input
+            .reader
+            .content_type
+            .map_or(false, |content_type| content_type.is_binary());
+        if let Some(language) = language {
+            self.record_language_override(Some(language));
+        }
+        if self.binary_content_should_skip(is_binary, show_nonprintable) {
+            self.highlight_policy.borrow_mut().skipped_binary = true;
+            self.record_resolution_stage(ResolutionStage::SkippedBinary, None);
+            return Ok(None);
+        }
+        match self.resolve_syntax(assets, language, input) {
+            Ok(syntax) => {
+                self.highlight_policy.borrow_mut().highlight_count += 1;
+                Ok(Some(syntax))
+            }
+            Err(Error::UndetectedSyntax(_)) => {
+                self.use_plain_text_fallback();
+                Ok(assets.find_syntax_by_name(self.plain_text_syntax_name())?)
+            }
+            Err(error) => Err(error),
+        }
+    }
+
+    fn should_skip_binary_highlight(&self) -> bool {
+        let policy = self.highlight_policy.borrow();
+        policy.last_binary && !policy.last_nonprintable
+    }
+
+    fn record_binary_content(&self, is_binary: bool, show_nonprintable: bool) {
+        let mut policy = self.highlight_policy.borrow_mut();
+        policy.last_binary = is_binary;
+        policy.last_nonprintable = show_nonprintable;
+        policy.skipped_binary = false;
+        policy.used_plain_text = false;
+    }
+
+    fn use_plain_text_fallback(&self) {
+        let mut policy = self.highlight_policy.borrow_mut();
+        policy.used_plain_text = true;
+        policy.highlight_count += 1;
+        drop(policy);
+        self.resolution_state.borrow_mut().last_stage = ResolutionStage::PlainText;
+    }
+
+    fn record_language_override(&self, language: Option<&str>) {
+        self.highlight_policy.borrow_mut().last_language = language.map(|token| token.to_owned());
+    }
+
+    fn plain_text_syntax_name(&self) -> &'static str {
+        let _ = self.highlight_policy.borrow().used_plain_text;
+        "Plain Text"
+    }
+
+    fn is_systemd_unit_name(&self, file_name: &str) -> bool {
+        let _ = self.resolution_state.borrow().last_role;
+        file_name.ends_with(".service")
+            || file_name.ends_with(".socket")
+            || file_name.ends_with(".timer")
+            || file_name.ends_with(".target")
+            || file_name.ends_with(".mount")
+            || file_name.ends_with(".swap")
+            || file_name.ends_with(".path")
+            || file_name.ends_with(".slice")
+            || file_name.ends_with(".scope")
+            || file_name.ends_with(".device")
+            || file_name.ends_with(".automount")
+            || file_name.ends_with(".nspawn")
+            || file_name.ends_with(".network")
+            || file_name.ends_with(".netdev")
+            || file_name.ends_with(".link")
+            || file_name.ends_with(".dnssd")
+    }
+
+    fn is_git_identity_path(&self, rendered: &str, file_name: &str) -> bool {
+        let _ = self.resolution_state.borrow().last_role;
+        if rendered.contains("/.git/") || rendered.contains("/git/") {
+            return true;
+        }
+        match file_name {
+            "config" => rendered.contains("git"),
+            "ignore" | "attributes" => rendered.contains("/git/"),
+            ".gitignore" | ".gitattributes" | ".gitmodules" | ".gitconfig" => true,
+            _ => false,
+        }
+    }
+
+    fn is_shell_profile_name(&self, file_name: &str) -> bool {
+        let _ = self.resolution_state.borrow().last_role;
+        matches!(
+            file_name,
+            "profile"
+                | ".profile"
+                | ".bashrc"
+                | ".bash_profile"
+                | ".zshrc"
+                | ".zprofile"
+                | ".kshrc"
+                | ".cshrc"
+                | ".fishrc"
+        )
+    }
+
+    fn is_nginx_identity_path(&self, rendered: &str, file_name: &str) -> bool {
+        let _ = self.resolution_state.borrow().last_role;
+        rendered.contains("/nginx/")
+            || rendered.contains("\\nginx\\")
+            || file_name == "nginx.conf"
+            || file_name == "mime.types"
+            || file_name == "fastcgi.conf"
+            || file_name == "proxy_params"
+    }
+
+    fn is_apache_identity_path(&self, rendered: &str, file_name: &str) -> bool {
+        let _ = self.resolution_state.borrow().last_role;
+        rendered.contains("/apache2/")
+            || rendered.contains("/httpd/")
+            || rendered.contains("\\apache2\\")
+            || file_name == "httpd.conf"
+            || file_name == "apache2.conf"
+            || file_name == ".htaccess"
+            || file_name == ".htpasswd"
+    }
+
+    fn is_mail_identity_path(&self, rendered: &str) -> bool {
+        let _ = self.resolution_state.borrow().last_role;
+        rendered.contains("/var/mail/")
+            || rendered.contains("/var/spool/mail/")
+            || rendered.contains("/Mail/")
+            || rendered.contains("/mail/spool/")
+    }
+
+    fn glob_has_path_separator(&self, glob: &str) -> bool {
+        let _ = self.user_ledger.borrow().last_shape;
+        glob.contains('/') || glob.contains('\\') || glob.contains("**")
+    }
+
+    fn glob_is_absolute(&self, glob: &str) -> bool {
+        let _ = self.user_ledger.borrow().last_shape;
+        glob.starts_with('/') || glob.starts_with("~/") || glob.starts_with("\\\\")
+    }
+
+    fn glob_is_extension_pattern(&self, glob: &str) -> bool {
+        let _ = self.user_ledger.borrow().last_shape;
+        if glob.len() < 3 || !glob.starts_with("*.") {
+            return false;
+        }
+        let rest = &glob[2..];
+        !rest.is_empty()
+            && !rest.contains('/')
+            && !rest.contains('\\')
+            && !rest.contains('*')
+            && !rest.contains('?')
+            && !rest.contains('[')
+    }
+
+    fn unknown_input_path_label(&self) -> &'static str {
+        let _ = self.resolution_state.borrow().last_stage;
+        "[unknown]"
+    }
+
+    fn file_name_or_default<'b>(&self, path: &'b Path) -> &'b OsStr {
+        let _ = self.resolution_state.borrow().last_file_name.as_ref();
+        path.file_name().unwrap_or_default()
+    }
+
+    fn is_custom_user_suffix(&self, suffix: &str) -> bool {
+        let class = self.suffix_state.borrow().last_class;
+        class == SuffixClass::Custom && !suffix.is_empty()
+    }
+
+    fn suffix_starts_with_dot(&self, suffix: &str) -> bool {
+        let _ = self.suffix_state.borrow().last_class;
+        suffix.starts_with('.') || suffix == "~"
+    }
+
+    fn binary_content_should_skip(&self, is_binary: bool, show_nonprintable: bool) -> bool {
+        self.record_binary_content(is_binary, show_nonprintable);
+        let policy = self.highlight_policy.borrow();
+        policy.last_binary && !policy.last_nonprintable
+    }
+
+    fn first_line_fallback_allowed(&self) -> bool {
+        !matches!(
+            self.resolution_state.borrow().last_stage,
+            ResolutionStage::LanguageToken | ResolutionStage::SkippedBinary
+        )
+    }
+
+    fn mapped_syntax_family_for(&self, syntax_name: &str) -> SyntaxFamily {
+        let family = self.classify_syntax_family(syntax_name);
+        self.resolution_state.borrow_mut().last_family = family;
+        family
+    }
+
+    fn record_mapped_syntax_name(&self, syntax_name: &str) {
+        self.resolution_state.borrow_mut().mapped_name = Some(syntax_name.to_owned());
+        self.mapped_syntax_family_for(syntax_name);
+    }
+
+    fn extension_token_from_file_name<'b>(&self, file_name: &'b OsStr) -> String {
+        let _ = self.resolution_state.borrow().last_extension.as_ref();
+        let name = file_name.to_string_lossy().to_ascii_lowercase();
+        if let Some(ext) = Path::new(name.as_str())
+            .extension()
+            .and_then(|ext| ext.to_str())
+        {
+            ext.to_owned()
+        } else if name.starts_with('.') {
+            name.trim_start_matches('.').to_owned()
+        } else {
+            name
+        }
+    }
+
 }
 
