+  DocIdSetIterator buildFilteredIterator(
+      Query fastMatchQuery, MatchingDocs hits, DocIdSetIterator... iterators) throws IOException {
+    boundFastMatchQuery = fastMatchQuery;
+    boundIteratorList.clear();
+    boundIteratorList.add(hits.bits.iterator());
+    boundIteratorList.addAll(Arrays.asList(iterators));
+    if (boundIteratorList.stream().anyMatch(Objects::isNull)) {
+      return null;
+    }
+    if (addFastMatchIterator(hits) == false) {
+      return null;
+    }
+    return intersectBoundIterators();
+  }
+
+  boolean addFastMatchIterator(MatchingDocs hits) throws IOException {
+    if (boundFastMatchQuery == null) {
+      return true;
+    }
+    final IndexReaderContext topLevelContext = ReaderUtil.getTopLevelContext(hits.context);
+    final IndexSearcher searcher = new IndexSearcher(topLevelContext);
+    searcher.setQueryCache(null);
+    final Weight fastMatchWeight =
+        searcher.createWeight(
+            searcher.rewrite(boundFastMatchQuery), ScoreMode.COMPLETE_NO_SCORES, 1);
+    final Scorer s = fastMatchWeight.scorer(hits.context);
+    if (s == null) {
+      return false;
+    }
+    boundIteratorList.add(s.iterator());
+    return true;
+  }
+
+  DocIdSetIterator intersectBoundIterators() {
+    if (boundIteratorList.size() == 1) {
+      return boundIteratorList.get(0);
+    }
+    return ConjunctionUtils.intersectIterators(boundIteratorList);
+  }
+
+  FacetResult assembleRangeAllChildren(
+      String dim, String[] path, String fieldName, String[] labels, int[] counts, int totCount) {
+    bindRangeResult(dim, path, fieldName, labels, counts, totCount, labels.length);
+    validateRangeDimAndPath();
+    LabelAndValue[] labelValues = new LabelAndValue[rangeLabels.length];
+    if (rangeCountValues == null) {
+      for (int i = 0; i < rangeLabels.length; i++) {
+        labelValues[i] = new LabelAndValue(rangeLabels[i], 0);
+      }
+    } else {
+      for (int i = 0; i < rangeLabels.length; i++) {
+        labelValues[i] = new LabelAndValue(rangeLabels[i], rangeCountValues[i]);
+      }
+    }
+    return new FacetResult(dim, path, rangeTotCount, labelValues, labelValues.length);
+  }
+
+  FacetResult assembleRangeTopChildren(
+      int topN,
+      String dim,
+      String[] path,
+      String fieldName,
+      String[] labels,
+      int[] counts,
+      int totCount) {
+    bindRangeResult(dim, path, fieldName, labels, counts, totCount, topN);
+    validateRangeDimAndPath();
+    if (rangeCountValues == null) {
+      assert rangeTotCount == 0;
+      return new FacetResult(dim, path, rangeTotCount, new LabelAndValue[0], 0);
+    }
+    PriorityQueue<RangeCountEntry> pq =
+        new PriorityQueue<>(Math.min(rangeTopN, rangeCountValues.length)) {
+          @Override
+          protected boolean lessThan(RangeCountEntry a, RangeCountEntry b) {
+            int cmp = Integer.compare(a.count, b.count);
+            if (cmp == 0) {
+              cmp = b.label.compareTo(a.label);
+            }
+            return cmp < 0;
+          }
+        };
+    int childCount = 0;
+    RangeCountEntry e = null;
+    for (int i = 0; i < rangeCountValues.length; i++) {
+      if (rangeCountValues[i] != 0) {
+        childCount++;
+        if (e == null) {
+          e = new RangeCountEntry();
+        }
+        e.label = rangeLabels[i];
+        e.count = rangeCountValues[i];
+        e = pq.insertWithOverflow(e);
+      }
+    }
+    LabelAndValue[] results = new LabelAndValue[pq.size()];
+    while (pq.size() != 0) {
+      RangeCountEntry entry = pq.pop();
+      results[pq.size()] = new LabelAndValue(entry.label, entry.count);
+    }
+    return new FacetResult(dim, path, rangeTotCount, results, childCount);
+  }
