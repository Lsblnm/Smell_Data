+  FacetResult longGetAllChildren(String dim, String... path) {
+    validateLongDimAndPath(dim, path);
+    if (longInitialized == false) {
+      assert longTotCount == 0;
+      return new FacetResult(longField, new String[0], longTotCount, new LabelAndValue[0], 0);
+    }
+    List<LabelAndValue> labelValues = new ArrayList<>();
+    for (int i = 0; i < longCounts.length; i++) {
+      if (longCounts[i] != 0) {
+        labelValues.add(new LabelAndValue(Long.toString(i), longCounts[i]));
+      }
+    }
+    if (longHashCounts.size() != 0) {
+      for (LongIntHashMap.LongIntCursor c : longHashCounts) {
+        int count = c.value;
+        if (count != 0) {
+          labelValues.add(new LabelAndValue(Long.toString(c.key), c.value));
+        }
+      }
+    }
+    return new FacetResult(
+        longField,
+        new String[0],
+        longTotCount,
+        labelValues.toArray(new LabelAndValue[0]),
+        labelValues.size());
+  }
+
+  FacetResult longGetTopChildren(int topN, String dim, String... path) {
+    validateTopN(topN);
+    validateLongDimAndPath(dim, path);
+    if (longInitialized == false) {
+      assert longTotCount == 0;
+      return new FacetResult(longField, new String[0], longTotCount, new LabelAndValue[0], 0);
+    }
+    PriorityQueue<LongCountEntry> pq =
+        new PriorityQueue<>(Math.min(topN, longCounts.length + longHashCounts.size())) {
+          @Override
+          protected boolean lessThan(LongCountEntry a, LongCountEntry b) {
+            return a.count < b.count || (a.count == b.count && a.value > b.value);
+          }
+        };
+    int childCount = 0;
+    LongCountEntry e = null;
+    for (int i = 0; i < longCounts.length; i++) {
+      if (longCounts[i] != 0) {
+        childCount++;
+        if (e == null) {
+          e = new LongCountEntry();
+        }
+        e.value = i;
+        e.count = longCounts[i];
+        e = pq.insertWithOverflow(e);
+      }
+    }
+    if (longHashCounts.size() != 0) {
+      childCount += longHashCounts.size();
+      for (LongIntHashMap.LongIntCursor c : longHashCounts) {
+        int count = c.value;
+        if (count != 0) {
+          if (e == null) {
+            e = new LongCountEntry();
+          }
+          e.value = c.key;
+          e.count = count;
+          e = pq.insertWithOverflow(e);
+        }
+      }
+    }
+    LabelAndValue[] results = new LabelAndValue[pq.size()];
+    while (pq.size() != 0) {
+      LongCountEntry entry = pq.pop();
+      results[pq.size()] = new LabelAndValue(Long.toString(entry.value), entry.count);
+    }
+    return new FacetResult(longField, new String[0], longTotCount, results, childCount);
+  }
