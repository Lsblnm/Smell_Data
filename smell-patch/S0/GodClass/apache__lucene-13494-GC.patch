+  FacetResult longGetAllChildrenSortByValue() {
+    if (longInitialized == false) {
+      assert longTotCount == 0;
+      return new FacetResult(longField, new String[0], longTotCount, new LabelAndValue[0], 0);
+    }
+    List<LabelAndValue> labelValues = new ArrayList<>();
+    int[] sortedHashCounts = new int[longHashCounts.size()];
+    long[] sortedHashValues = new long[longHashCounts.size()];
+    int upto = 0;
+    for (LongIntHashMap.LongIntCursor c : longHashCounts) {
+      if (c.value != 0) {
+        sortedHashCounts[upto] = c.value;
+        sortedHashValues[upto] = c.key;
+        upto++;
+      }
+    }
+    assert upto == longHashCounts.size()
+        : "upto=" + upto + " hashCounts.size=" + longHashCounts.size();
+    new InPlaceMergeSorter() {
+      @Override
+      public int compare(int i, int j) {
+        return Long.compare(sortedHashValues[i], sortedHashValues[j]);
+      }
+
+      @Override
+      public void swap(int i, int j) {
+        int x = sortedHashCounts[i];
+        sortedHashCounts[i] = sortedHashCounts[j];
+        sortedHashCounts[j] = x;
+        long y = sortedHashValues[j];
+        sortedHashValues[j] = sortedHashValues[i];
+        sortedHashValues[i] = y;
+      }
+    }.sort(0, upto);
+    boolean countsAdded = false;
+    for (int i = 0; i < upto; i++) {
+      if (countsAdded == false && sortedHashValues[i] >= longCounts.length) {
+        countsAdded = true;
+        appendLongCounts(labelValues);
+      }
+      labelValues.add(new LabelAndValue(Long.toString(sortedHashValues[i]), sortedHashCounts[i]));
+    }
+    if (countsAdded == false) {
+      appendLongCounts(labelValues);
+    }
+    return new FacetResult(
+        longField,
+        new String[0],
+        longTotCount,
+        labelValues.toArray(new LabelAndValue[0]),
+        labelValues.size());
+  }
