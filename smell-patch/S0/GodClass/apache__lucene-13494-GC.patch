+  void bindRangeResult(
+      String dim,
+      String[] path,
+      String fieldName,
+      String[] labels,
+      int[] counts,
+      int totCount,
+      int topN) {
+    rangeFieldName = fieldName;
+    rangeRequestDim = dim;
+    rangeRequestPath = path;
+    rangeLabels = labels;
+    rangeCountValues = counts;
+    rangeTotCount = totCount;
+    rangeTopN = topN;
+  }
+
+  void validateRangeDimAndPath() {
+    if (rangeRequestDim.equals(rangeFieldName) == false) {
+      throw new IllegalArgumentException(
+          "invalid dim \"" + rangeRequestDim + "\"; should be \"" + rangeFieldName + "\"");
+    }
+    if (rangeRequestPath.length != 0) {
+      throw new IllegalArgumentException("path.length should be 0");
+    }
+  }
+
+  String describeBoundRanges(String fieldName, String[] labels, int[] counts, int totCount) {
+    bindRangeResult(fieldName, new String[0], fieldName, labels, counts, totCount, 0);
