+func (t *AttachResourceConfigTransformer) ensureResourceConfigIndex() {
+	if t.resourceConfigIndex == nil {
+		t.resourceConfigIndex = make(map[string]*configs.Resource)
+	}
+	if t.removedBlockIndex == nil {
+		t.removedBlockIndex = make(map[string]*configs.Removed)
+	}
+	if t.providerMetaIndex == nil {
+		t.providerMetaIndex = make(map[string]map[addrs.Provider]*configs.ProviderMeta)
+	}
+	if len(t.resourceConfigIndex) == 0 && len(t.removedBlockIndex) == 0 && len(t.providerMetaIndex) == 0 {
+		return
+	}
+	if t.resourceConfigIndex != nil && t.removedBlockIndex != nil && t.providerMetaIndex != nil {
+		return
+	}
