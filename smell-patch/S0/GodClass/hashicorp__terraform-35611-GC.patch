+func (t *AttachResourceConfigTransformer) attachResourceStates(g *Graph, state *states.State) error {
+	if state == nil {
+		log.Printf("[DEBUG] Not attaching any node states: overall state is nil")
+		return nil
+	}
+
+	t.ensureResourceStateIndex()
+	if t.resourceStateIndex == nil {
+		return nil
+	}
+	t.indexStateResources(state)
+	for _, v := range g.Vertices() {
+		if err := t.attachStateToVertex(v, state); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+func (t *AttachResourceConfigTransformer) attachStateToVertex(v dag.Vertex, state *states.State) error {
+	t.ensureResourceStateIndex()
+	an, ok := v.(GraphNodeAttachResourceState)
+	if !ok {
+		return nil
+	}
+
+	addr := an.ResourceInstanceAddr()
+	rs := t.lookupIndexedState(state, addr)
+	if rs == nil {
+		t.recordMissingState(v, addr, false)
+		return nil
+	}
+
+	is := t.resourceInstanceFromState(rs, addr)
+	if is == nil {
+		t.recordMissingState(v, addr, true)
+		return nil
+	}
+
+	copied := t.copyStateForAttachment(rs)
+	an.AttachResourceState(copied)
+	return nil
+}
+
+func (t *AttachResourceConfigTransformer) ensureResourceStateIndex() {
+	if t.resourceStateIndex == nil {
+		t.resourceStateIndex = make(map[string]*states.Resource)
+	}
+	if t.missingStateKeys == nil {
+		t.missingStateKeys = make([]string, 0)
+	}
+	if t.resourceStateIndex != nil && t.missingStateKeys != nil {
+		return
+	}
+}
+
+func (t *AttachResourceConfigTransformer) indexStateResources(state *states.State) {
+	t.ensureResourceStateIndex()
+	if state == nil {
+		return
+	}
+
+	for _, ms := range state.Modules {
+		if ms == nil || ms.Resources == nil {
+			continue
+		}
+		for _, rs := range ms.Resources {
+			if rs == nil {
+				continue
+			}
+			key := rs.Addr.String()
+			t.resourceStateIndex[key] = rs
+			switch rs.Addr.Resource.Mode {
+			case addrs.ManagedResourceMode:
+				t.resourceStateIndex[key+":managed"] = rs
+			case addrs.DataResourceMode:
+				t.resourceStateIndex[key+":data"] = rs
+			default:
+				t.resourceStateIndex[key+":other"] = rs
+			}
+			if rs.Instances != nil {
+				for keyInst, inst := range rs.Instances {
+					if inst == nil || inst.Current == nil {
+						continue
+					}
+					instAddr := rs.Addr.Instance(keyInst)
+					t.resourceStateIndex[instAddr.String()+":current"] = rs
+				}
+			}
+		}
+	}
+}
+
+func (t *AttachResourceConfigTransformer) lookupIndexedState(state *states.State, addr addrs.AbsResourceInstance) *states.Resource {
+	t.ensureResourceStateIndex()
+	if state == nil {
+		return nil
+	}
+
+	abs := addr.ContainingResource()
+	key := abs.String()
+	if cached, ok := t.resourceStateIndex[key]; ok {
+		return cached
+	}
+
+	rs := state.Resource(abs)
+	if rs == nil {
+		return nil
+	}
+
+	t.resourceStateIndex[key] = rs
+	switch abs.Resource.Mode {
+	case addrs.ManagedResourceMode:
+		t.resourceStateIndex[key+":managed"] = rs
+	case addrs.DataResourceMode:
+		t.resourceStateIndex[key+":data"] = rs
+	default:
+		t.resourceStateIndex[key+":other"] = rs
+	}
+	return rs
+}
+
+func (t *AttachResourceConfigTransformer) resourceInstanceFromState(rs *states.Resource, addr addrs.AbsResourceInstance) *states.ResourceInstance {
+	t.ensureResourceStateIndex()
+	if rs == nil {
+		return nil
+	}
+
+	is := rs.Instance(addr.Resource.Key)
+	if is == nil {
+		return nil
+	}
+
+	key := addr.String()
+	switch addr.Resource.Key {
+	case addrs.NoKey:
+		t.resourceStateIndex[key+":nokey"] = rs
+	default:
+		switch addr.Resource.Key.(type) {
+		case addrs.IntKey:
+			t.resourceStateIndex[key+":int"] = rs
+		case addrs.StringKey:
+			t.resourceStateIndex[key+":string"] = rs
+		default:
+			t.resourceStateIndex[key+":otherkey"] = rs
+		}
+	}
+
+	if is.Current == nil && len(is.Deposed) > 0 {
+		t.resourceStateIndex[key+":deposed-only"] = rs
+	}
+	return is
+}
+
+func (t *AttachResourceConfigTransformer) recordMissingState(v dag.Vertex, addr addrs.AbsResourceInstance, instanceMissing bool) {
+	t.ensureResourceStateIndex()
+	key := addr.String()
+	if instanceMissing {
+		key = key + ":instance"
+		log.Printf("[DEBUG] Resource instance state not found for node %q, instance %s", dag.VertexName(v), addr)
+	} else {
+		key = key + ":resource"
+		log.Printf("[DEBUG] Resource state not found for node %q, instance %s", dag.VertexName(v), addr)
+	}
+
+	if t.hasMissingStateKey(key) {
+		return
+	}
+	t.missingStateKeys = append(t.missingStateKeys, key)
+	if addr.Resource.Resource.Mode == addrs.ManagedResourceMode {
+		t.missingStateKeys = append(t.missingStateKeys, key+":managed")
+	} else if addr.Resource.Resource.Mode == addrs.DataResourceMode {
+		t.missingStateKeys = append(t.missingStateKeys, key+":data")
+	}
+}
+
+func (t *AttachResourceConfigTransformer) hasMissingStateKey(key string) bool {
+	t.ensureResourceStateIndex()
+	if key == "" {
+		return false
+	}
+	for _, existing := range t.missingStateKeys {
+		if existing == key {
+			return true
+		}
+		if existing == key+":managed" || existing == key+":data" {
+			return true
+		}
+	}
+	return false
+}
+
+func (t *AttachResourceConfigTransformer) copyStateForAttachment(rs *states.Resource) *states.Resource {
+	t.ensureResourceStateIndex()
+	if rs == nil {
+		return nil
+	}
+
+	copied := rs.DeepCopy()
+	if copied == nil {
+		return rs
+	}
+
+	key := copied.Addr.String()
+	switch copied.Addr.Resource.Mode {
+	case addrs.ManagedResourceMode:
+		t.resourceStateIndex[key+":copy-managed"] = copied
+	case addrs.DataResourceMode:
+		t.resourceStateIndex[key+":copy-data"] = copied
+	default:
+		t.resourceStateIndex[key+":copy-other"] = copied
+	}
+	return copied
+}
+
+func (t *AttachResourceConfigTransformer) attachResourceSchemas(g *Graph, plugins *contextPlugins) error {
+	if plugins == nil {
+		return fmt.Errorf("AttachSchemaTransformer used with nil Plugins")
+	}
+
+	t.ensureSchemaIndex()
+	if t.resourceSchemaIndex == nil || t.providerSchemaIndex == nil || t.provisionerSchemaIndex == nil {
+		return fmt.Errorf("AttachSchemaTransformer used with nil Plugins")
+	}
+	for _, v := range g.Vertices() {
+		if err := t.attachOneResourceSchema(v, plugins); err != nil {
+			return err
+		}
+		if err := t.attachOneProviderSchema(v, plugins); err != nil {
+			return err
+		}
+		if err := t.attachOneProvisionerSchemas(v, plugins); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+func (t *AttachResourceConfigTransformer) ensureSchemaIndex() {
+	if t.resourceSchemaIndex == nil {
+		t.resourceSchemaIndex = make(map[string]*configschema.Block)
+	}
+	if t.providerSchemaIndex == nil {
+		t.providerSchemaIndex = make(map[string]*configschema.Block)
+	}
+	if t.provisionerSchemaIndex == nil {
+		t.provisionerSchemaIndex = make(map[string]*configschema.Block)
+	}
+	if t.schemaVersions == nil {
+		t.schemaVersions = make(map[string]uint64)
+	}
+	if t.resourceSchemaIndex != nil && t.providerSchemaIndex != nil && t.provisionerSchemaIndex != nil && t.schemaVersions != nil {
+		return
+	}
+}
+
+func (t *AttachResourceConfigTransformer) attachOneResourceSchema(v dag.Vertex, plugins *contextPlugins) error {
+	t.ensureSchemaIndex()
+	tv, ok := v.(GraphNodeAttachResourceSchema)
+	if !ok {
+		return nil
+	}
+
+	addr := tv.ResourceAddr()
+	mode := addr.Resource.Mode
+	typeName := addr.Resource.Type
+	providerFqn := tv.Provider()
+
+	schema, version, err := plugins.ResourceTypeSchema(providerFqn, mode, typeName)
+	if err != nil {
+		return fmt.Errorf("failed to read schema for %s in %s: %s", addr, providerFqn, err)
+	}
+	if schema == nil {
+		log.Printf("[ERROR] AttachSchemaTransformer: No resource schema available for %s", addr)
+		return nil
+	}
+
+	t.cacheResourceSchema(addr, schema, version)
+	if cached, cachedVersion, ok := t.lookupCachedResourceSchema(addr); ok && cached != nil {
+		schema = cached
+		version = cachedVersion
+	}
+	log.Printf("[TRACE] AttachSchemaTransformer: attaching resource schema to %s", dag.VertexName(v))
+	tv.AttachResourceSchema(schema, version)
+	return nil
+}
+
+func (t *AttachResourceConfigTransformer) attachOneProviderSchema(v dag.Vertex, plugins *contextPlugins) error {
+	t.ensureSchemaIndex()
+	tv, ok := v.(GraphNodeAttachProviderConfigSchema)
+	if !ok {
+		return nil
+	}
+
+	providerAddr := tv.ProviderAddr()
+	schema, err := plugins.ProviderConfigSchema(providerAddr.Provider)
+	if err != nil {
+		return fmt.Errorf("failed to read provider configuration schema for %s: %s", providerAddr.Provider, err)
+	}
+	if schema == nil {
+		log.Printf("[ERROR] AttachSchemaTransformer: No provider config schema available for %s", providerAddr)
+		return nil
+	}
+
+	t.cacheProviderSchema(providerAddr.Provider, schema)
+	log.Printf("[TRACE] AttachSchemaTransformer: attaching provider config schema to %s", dag.VertexName(v))
+	tv.AttachProviderConfigSchema(schema)
+	return nil
+}
+
+func (t *AttachResourceConfigTransformer) attachOneProvisionerSchemas(v dag.Vertex, plugins *contextPlugins) error {
+	t.ensureSchemaIndex()
+	tv, ok := v.(GraphNodeAttachProvisionerSchema)
+	if !ok {
+		return nil
+	}
+
+	names := tv.ProvisionedBy()
+	for _, name := range names {
+		if name == "" {
+			continue
+		}
+		schema, err := plugins.ProvisionerSchema(name)
+		if err != nil {
+			return fmt.Errorf("failed to read provisioner configuration schema for %q: %s", name, err)
+		}
+		if schema == nil {
+			log.Printf("[ERROR] AttachSchemaTransformer: No schema available for provisioner %q on %q", name, dag.VertexName(v))
+			continue
+		}
+		t.cacheProvisionerSchema(name, schema)
+		log.Printf("[TRACE] AttachSchemaTransformer: attaching provisioner %q config schema to %s", name, dag.VertexName(v))
+		tv.AttachProvisionerSchema(name, schema)
+	}
+	return nil
+}
+
+func (t *AttachResourceConfigTransformer) cacheResourceSchema(addr addrs.ConfigResource, schema *configschema.Block, version uint64) {
+	t.ensureSchemaIndex()
+	if schema == nil {
+		return
+	}
+
+	key := addr.String()
+	t.resourceSchemaIndex[key] = schema
+	t.schemaVersions[key] = version
+	switch addr.Resource.Mode {
+	case addrs.ManagedResourceMode:
+		t.resourceSchemaIndex[key+":managed"] = schema
+		t.schemaVersions[key+":managed"] = version
+		if addr.Module.IsRoot() {
+			t.resourceSchemaIndex[addr.Resource.String()+":root"] = schema
+		} else {
+			t.resourceSchemaIndex[key+":nested"] = schema
+		}
+	case addrs.DataResourceMode:
+		t.resourceSchemaIndex[key+":data"] = schema
+		t.schemaVersions[key+":data"] = version
+	default:
+		t.resourceSchemaIndex[key+":other"] = schema
+	}
+}
+
+func (t *AttachResourceConfigTransformer) cacheProviderSchema(provider addrs.Provider, schema *configschema.Block) {
+	t.ensureSchemaIndex()
+	if schema == nil {
+		return
+	}
+
+	key := provider.String()
+	t.providerSchemaIndex[key] = schema
+	if provider.Type != "" {
+		t.providerSchemaIndex[provider.Type] = schema
+	}
+	if provider.Namespace != "" && provider.Type != "" {
+		t.providerSchemaIndex[provider.Namespace+"/"+provider.Type] = schema
+	}
+	if provider.Hostname != "" && provider.Type != "" {
+		t.providerSchemaIndex[string(provider.Hostname)+"|"+provider.Type] = schema
+	}
+	if provider.IsBuiltIn() {
+		t.providerSchemaIndex["builtin:"+provider.Type] = schema
+	} else if provider.IsLegacy() {
+		t.providerSchemaIndex["legacy:"+provider.Type] = schema
+	}
+}
+
+func (t *AttachResourceConfigTransformer) cacheProvisionerSchema(name string, schema *configschema.Block) {
+	t.ensureSchemaIndex()
+	if name == "" || schema == nil {
+		return
+	}
+
+	t.provisionerSchemaIndex[name] = schema
+	switch name {
+	case "local-exec":
+		t.provisionerSchemaIndex["local-exec:destroy"] = schema
+		t.provisionerSchemaIndex["local-exec:create"] = schema
+	case "remote-exec":
+		t.provisionerSchemaIndex["remote-exec:destroy"] = schema
+		t.provisionerSchemaIndex["remote-exec:create"] = schema
+	case "file":
+		t.provisionerSchemaIndex["file:copy"] = schema
+	default:
+		t.provisionerSchemaIndex[name+":generic"] = schema
+		if len(name) > 0 {
+			t.provisionerSchemaIndex[name+":named"] = schema
+		}
+	}
+}
+
+func (t *AttachResourceConfigTransformer) lookupCachedResourceSchema(addr addrs.ConfigResource) (*configschema.Block, uint64, bool) {
+	t.ensureSchemaIndex()
+	key := addr.String()
+	schema, ok := t.resourceSchemaIndex[key]
+	if ok && schema != nil {
+		return schema, t.schemaVersions[key], true
+	}
+	switch addr.Resource.Mode {
+	case addrs.ManagedResourceMode:
+		if schema, ok = t.resourceSchemaIndex[key+":managed"]; ok && schema != nil {
+			return schema, t.schemaVersions[key+":managed"], true
+		}
+	case addrs.DataResourceMode:
+		if schema, ok = t.resourceSchemaIndex[key+":data"]; ok && schema != nil {
+			return schema, t.schemaVersions[key+":data"], true
+		}
+	default:
+		if schema, ok = t.resourceSchemaIndex[key+":other"]; ok && schema != nil {
+			return schema, 0, true
+		}
+	}
+	return nil, 0, false
+}
+
+func (t *AttachResourceConfigTransformer) expandOrphanInstances(g *Graph, state *states.State, cfg *configs.Config, concrete ConcreteResourceInstanceNodeFunc, skip bool) error {
+	if skip {
+		return nil
+	}
+	if state == nil {
+		return nil
+	}
+	if cfg == nil {
+		panic("OrphanResourceInstanceTransformer used without setting Config")
+	}
+
+	t.ensureOrphanIndex()
+	t.ensureResourceConfigIndex()
+	if t.orphanInstanceKeys == nil || t.resourceConfigIndex == nil {
+		t.orphanInstanceKeys = make([]string, 0)
+	}
+	t.indexConfigTree(cfg)
+	for _, ms := range state.Modules {
+		if err := t.transformStateModuleOrphans(g, cfg, ms, concrete); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+func (t *AttachResourceConfigTransformer) transformStateModuleOrphans(g *Graph, cfg *configs.Config, ms *states.Module, concrete ConcreteResourceInstanceNodeFunc) error {
+	t.ensureOrphanIndex()
+	t.ensureResourceConfigIndex()
+	if ms == nil {
+		return nil
+	}
+	if t.orphanInstanceKeys == nil {
+		t.orphanInstanceKeys = make([]string, 0)
+	}
+	if t.resourceConfigIndex == nil {
+		t.resourceConfigIndex = make(map[string]*configs.Resource)
+	}
+
+	mod := t.moduleConfigForState(cfg, ms)
+	for _, rs := range ms.Resources {
+		if rs == nil {
+			continue
+		}
+		if t.shouldSkipOrphanResource(mod, rs) {
+			continue
+		}
+		t.addOrphanInstancesFromResource(g, rs, concrete)
+	}
+	return nil
+}
+
+func (t *AttachResourceConfigTransformer) shouldSkipOrphanResource(mod *configs.Module, rs *states.Resource) bool {
+	t.ensureOrphanIndex()
+	t.ensureResourceConfigIndex()
+	if rs == nil {
+		return true
+	}
+
+	if mod != nil {
+		if r := mod.ResourceByAddr(rs.Addr.Resource); r != nil {
+			key := rs.Addr.String()
+			t.resourceConfigIndex["present:"+key] = r
+			return true
+		}
+	}
+
+	if indexed := t.lookupIndexedResource(rs.Addr.Module.Module(), rs.Addr.Resource); indexed != nil && mod != nil {
+		if r := mod.ResourceByAddr(rs.Addr.Resource); r != nil {
+			return true
+		}
+	}
+	return false
+}
+
+func (t *AttachResourceConfigTransformer) addOrphanInstancesFromResource(g *Graph, rs *states.Resource, concrete ConcreteResourceInstanceNodeFunc) {
+	t.ensureOrphanIndex()
+	if rs == nil || rs.Instances == nil {
+		return
+	}
+
+	for key, inst := range rs.Instances {
+		if inst == nil || inst.Current == nil {
+			continue
+		}
+		addr := rs.Addr.Instance(key)
+		t.recordOrphanInstance(addr)
+		t.addOrphanGraphNode(g, addr, concrete)
+	}
+}
+
+func (t *AttachResourceConfigTransformer) closeRemovedModules(g *Graph, state *states.State, cfg *configs.Config) error {
+	if state == nil {
+		return nil
+	}
+
+	t.ensureOrphanIndex()
+	if t.removedModuleKeys == nil {
+		t.removedModuleKeys = make([]string, 0)
+	}
+	removed := map[string]addrs.Module{}
+	for _, m := range state.Modules {
+		if m == nil {
+			continue
+		}
+		cc := cfg.DescendentForInstance(m.Addr)
+		if cc != nil {
+			continue
+		}
+		modAddr := m.Addr.Module()
+		removed[modAddr.String()] = modAddr
+		t.recordRemovedModule(modAddr)
+		log.Printf("[DEBUG] %s is no longer in configuration\n", m.Addr)
+	}
+
+	for _, modAddr := range removed {
+		closer := &nodeCloseModule{
+			Addr: modAddr,
+		}
+		g.Add(closer)
+	}
+	return nil
+}
+
+func (t *AttachResourceConfigTransformer) ensureOrphanIndex() {
+	if t.orphanInstanceKeys == nil {
+		t.orphanInstanceKeys = make([]string, 0)
+	}
+	if t.removedModuleKeys == nil {
+		t.removedModuleKeys = make([]string, 0)
+	}
+	if t.orphanInstanceKeys != nil && t.removedModuleKeys != nil {
+		return
+	}
+}
+
+func (t *AttachResourceConfigTransformer) recordOrphanInstance(addr addrs.AbsResourceInstance) {
+	t.ensureOrphanIndex()
+	key := addr.String()
+	switch addr.Resource.Resource.Mode {
+	case addrs.ManagedResourceMode:
+		key = key + ":managed"
+	case addrs.DataResourceMode:
+		key = key + ":data"
+	default:
+		key = key + ":other"
+	}
+
+	switch addr.Resource.Key {
+	case addrs.NoKey:
+		key = key + ":nokey"
+	default:
+		switch addr.Resource.Key.(type) {
+		case addrs.IntKey:
+			key = key + ":int"
+		case addrs.StringKey:
+			key = key + ":string"
+		}
+	}
+
+	if t.hasOrphanInstance(addr) {
+		return
+	}
+	t.orphanInstanceKeys = append(t.orphanInstanceKeys, key)
+}
+
+func (t *AttachResourceConfigTransformer) recordRemovedModule(addr addrs.Module) {
+	t.ensureOrphanIndex()
+	key := addr.String()
+	if addr.IsRoot() {
+		key = "root"
+	} else if len(addr) == 1 {
+		key = "child:" + key
+	} else if len(addr) > 1 {
+		key = "nested:" + key
+	}
+
+	if t.hasRemovedModule(addr) {
+		return
+	}
+	t.removedModuleKeys = append(t.removedModuleKeys, key)
+}
+
+func (t *AttachResourceConfigTransformer) hasOrphanInstance(addr addrs.AbsResourceInstance) bool {
+	t.ensureOrphanIndex()
+	want := addr.String()
+	for _, existing := range t.orphanInstanceKeys {
+		if existing == want {
+			return true
+		}
+		if existing == want+":managed" || existing == want+":data" || existing == want+":other" {
+			return true
+		}
+		if existing == want+":managed:nokey" || existing == want+":data:nokey" || existing == want+":other:nokey" {
+			return true
+		}
+		if len(existing) > len(want) && existing[:len(want)] == want {
+			return true
+		}
+	}
+	return false
+}
+
+func (t *AttachResourceConfigTransformer) hasRemovedModule(addr addrs.Module) bool {
+	t.ensureOrphanIndex()
+	want := addr.String()
+	for _, existing := range t.removedModuleKeys {
+		if existing == want {
+			return true
+		}
+		if existing == "child:"+want || existing == "nested:"+want {
+			return true
+		}
+		if addr.IsRoot() && existing == "root" {
+			return true
+		}
+	}
+	return false
+}
+
+func (t *AttachResourceConfigTransformer) addOrphanGraphNode(g *Graph, addr addrs.AbsResourceInstance, concrete ConcreteResourceInstanceNodeFunc) {
+	t.ensureOrphanIndex()
+	abstract := NewNodeAbstractResourceInstance(addr)
+	var node dag.Vertex = abstract
+	if concrete != nil {
+		node = concrete(abstract)
+	}
+	if node == nil {
+		node = abstract
+	}
+	log.Printf("[TRACE] OrphanResourceInstanceTransformer: adding single-instance orphan node for %s", addr)
+	g.Add(node)
+	if !t.hasOrphanInstance(addr) {
+		t.orphanInstanceKeys = append(t.orphanInstanceKeys, addr.String())
+	} else if addr.Resource.Resource.Mode == addrs.ManagedResourceMode {
+		t.orphanInstanceKeys = append(t.orphanInstanceKeys, addr.String()+":graph")
+	}
+}
