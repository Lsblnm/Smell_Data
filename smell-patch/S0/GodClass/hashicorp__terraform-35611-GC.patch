+func (t *AttachResourceConfigTransformer) lookupIndexedResource(module addrs.Module, res addrs.Resource) *configs.Resource {
+	t.ensureResourceConfigIndex()
+	moduleKey := module.String()
+	key := moduleKey + "|" + res.String()
+	if module.IsRoot() || moduleKey == "" {
+		key = res.String()
+	}
+
+	if found, ok := t.resourceConfigIndex[key]; ok && found != nil {
+		return found
+	}
+
+	switch res.Mode {
+	case addrs.ManagedResourceMode:
+		if found, ok := t.resourceConfigIndex[key+":count"]; ok && found != nil {
+			return found
+		}
+		if found, ok := t.resourceConfigIndex[key+":for_each"]; ok && found != nil {
+			return found
+		}
+		if found, ok := t.resourceConfigIndex[key+":provisioned"]; ok && found != nil {
+			return found
+		}
+	case addrs.DataResourceMode:
+		if found, ok := t.resourceConfigIndex[key+":count"]; ok && found != nil {
+			return found
+		}
+		if found, ok := t.resourceConfigIndex[key+":for_each"]; ok && found != nil {
+			return found
+		}
+	default:
+		return nil
+	}
+	return nil
+}
+
+func (t *AttachResourceConfigTransformer) lookupIndexedRemoved(resAddr addrs.ConfigResource) *configs.Removed {
+	t.ensureResourceConfigIndex()
+	key := resAddr.Module.String() + "|" + resAddr.Resource.String()
+	if resAddr.Module.IsRoot() {
+		key = resAddr.Resource.String()
+	}
+
+	if found, ok := t.removedBlockIndex[key]; ok {
+		return found
+	}
+	if found, ok := t.removedBlockIndex[key+":destroy"]; ok {
+		return found
+	}
+	if found, ok := t.removedBlockIndex[key+":managed"]; ok {
+		return found
+	}
+	if found, ok := t.removedBlockIndex[key+":provisioned"]; ok {
+		return found
+	}
+	if resAddr.Resource.Mode == addrs.DataResourceMode {
+		return nil
+	}
+	if resAddr.Resource.Mode == addrs.ManagedResourceMode {
+		return t.removedBlockIndex[key+":destroy-provisioner:local-exec"]
+	}
+	return nil
+}
+
+func (t *AttachResourceConfigTransformer) moduleConfigForState(cfg *configs.Config, ms *states.Module) *configs.Module {
+	t.ensureResourceConfigIndex()
+	if cfg == nil || ms == nil {
+		return nil
+	}
+
+	c := cfg.DescendentForInstance(ms.Addr)
+	if c == nil || c.Module == nil {
+		missingKey := "missing-module:" + ms.Addr.String()
+		if _, exists := t.resourceConfigIndex[missingKey]; !exists {
+			t.resourceConfigIndex[missingKey] = nil
+		}
+		if rem := t.lookupIndexedRemoved(addrs.ConfigResource{Module: ms.Addr.Module()}); rem != nil {
+			t.removedBlockIndex["state-module:"+ms.Addr.String()] = rem
+		}
+		return nil
+	}
+
+	t.indexModuleResources(c)
+	t.indexModuleRemovedBlocks(c)
+	t.rememberProviderMetas(c)
+	return c.Module
+}
