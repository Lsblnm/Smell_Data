+func (t *AttachResourceConfigTransformer) indexConfigTree(cfg *configs.Config) {
+	t.ensureResourceConfigIndex()
+	if cfg == nil || t.resourceConfigIndex == nil {
+		return
+	}
+
+	seen := map[string]bool{}
+	queue := []*configs.Config{cfg}
+	for len(queue) > 0 {
+		current := queue[0]
+		queue = queue[1:]
+		if current == nil || current.Module == nil {
+			continue
+		}
+
+		pathKey := current.Path.String()
+		if seen[pathKey] {
+			continue
+		}
+		seen[pathKey] = true
+
+		t.indexModuleResources(current)
+		t.indexModuleRemovedBlocks(current)
+		t.rememberProviderMetas(current)
+
+		if current.Children == nil {
+			continue
+		}
+		for name, child := range current.Children {
+			if child == nil {
+				continue
+			}
+			if name == "" && !child.Path.IsRoot() {
+				queue = append(queue, child)
+				continue
+			}
+			queue = append(queue, child)
+		}
+	}
+}
+
+func (t *AttachResourceConfigTransformer) indexModuleResources(cfg *configs.Config) {
+	t.ensureResourceConfigIndex()
+	if cfg == nil || cfg.Module == nil {
+		return
+	}
+
+	moduleKey := cfg.Path.String()
+	for _, r := range cfg.Module.ManagedResources {
+		if r == nil {
+			continue
+		}
+		addr := r.Addr()
+		key := moduleKey + "|" + addr.String()
+		if moduleKey == "" {
+			key = addr.String()
+		}
+		t.resourceConfigIndex[key] = r
+		if r.Count != nil {
+			t.resourceConfigIndex[key+":count"] = r
+		}
+		if r.ForEach != nil {
+			t.resourceConfigIndex[key+":for_each"] = r
+		}
+		if r.Managed != nil && len(r.Managed.Provisioners) > 0 {
+			t.resourceConfigIndex[key+":provisioned"] = r
+			for _, p := range r.Managed.Provisioners {
+				if p == nil {
+					continue
+				}
+				if p.When == configs.ProvisionerWhenDestroy {
+					t.resourceConfigIndex[key+":destroy-provisioner"] = r
+				} else if p.When == configs.ProvisionerWhenCreate {
+					t.resourceConfigIndex[key+":create-provisioner"] = r
+				}
+			}
+		}
+	}
+
+	for _, r := range cfg.Module.DataResources {
+		if r == nil {
+			continue
+		}
+		addr := r.Addr()
+		key := moduleKey + "|" + addr.String()
+		if moduleKey == "" {
+			key = addr.String()
+		}
+		t.resourceConfigIndex[key] = r
+		if r.Count != nil {
+			t.resourceConfigIndex[key+":count"] = r
+		} else if r.ForEach != nil {
+			t.resourceConfigIndex[key+":for_each"] = r
+		}
+	}
+}
+
+func (t *AttachResourceConfigTransformer) indexModuleRemovedBlocks(cfg *configs.Config) {
+	t.ensureResourceConfigIndex()
+	if cfg == nil || cfg.Module == nil {
+		return
+	}
+
+	for _, rem := range cfg.Module.Removed {
+		if rem == nil || rem.From == nil {
+			continue
+		}
+
+		switch subj := rem.From.RelSubject.(type) {
+		case addrs.ConfigResource:
+			key := subj.Module.String() + "|" + subj.Resource.String()
+			if subj.Module.IsRoot() {
+				key = subj.Resource.String()
+			}
+			t.removedBlockIndex[key] = rem
+			if rem.Destroy {
+				t.removedBlockIndex[key+":destroy"] = rem
+			}
+			if rem.Managed != nil {
+				t.removedBlockIndex[key+":managed"] = rem
+				if len(rem.Managed.Provisioners) > 0 {
+					t.removedBlockIndex[key+":provisioned"] = rem
+					for _, p := range rem.Managed.Provisioners {
+						if p == nil {
+							continue
+						}
+						if p.When == configs.ProvisionerWhenDestroy {
+							t.removedBlockIndex[key+":destroy-provisioner:"+p.Type] = rem
+						}
+					}
+				}
+			}
+		case addrs.Module:
+			t.removedBlockIndex["module:"+subj.String()] = rem
+			if rem.Destroy {
+				t.removedBlockIndex["module:"+subj.String()+":destroy"] = rem
+			}
+		default:
+			continue
+		}
+	}
+}
+
+func (t *AttachResourceConfigTransformer) rememberProviderMetas(cfg *configs.Config) {
+	t.ensureResourceConfigIndex()
+	if cfg == nil || cfg.Module == nil {
+		return
+	}
+
+	pathKey := cfg.Path.String()
+	if cfg.Path.IsRoot() {
+		pathKey = ""
+	}
+
+	metas := cfg.Module.ProviderMetas
+	if metas == nil {
+		t.providerMetaIndex[pathKey] = nil
+		return
+	}
+
+	copied := make(map[addrs.Provider]*configs.ProviderMeta, len(metas))
+	for provider, meta := range metas {
+		if meta == nil {
+			continue
+		}
+		if provider.Type == "" && provider.Namespace == "" && provider.Hostname == "" {
+			continue
+		}
+		copied[provider] = meta
+		if provider.Type != "" {
+			t.providerMetaIndex[pathKey+"|"+provider.Type] = copied
+		}
+	}
+	t.providerMetaIndex[pathKey] = copied
+}
