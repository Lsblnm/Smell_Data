+func (t *AttachResourceConfigTransformer) expandConfigResources(g *Graph, cfg *configs.Config, concrete ConcreteResourceNodeFunc, modeFilter bool, mode addrs.ResourceMode, importTargets []*ImportTarget, skip bool, generateConfigPath string) error {
+	if skip {
+		return nil
+	}
+	if cfg == nil {
+		return nil
+	}
+
+	t.ensureResourceConfigIndex()
+	if t.resourceConfigIndex == nil || t.removedBlockIndex == nil {
+		return nil
+	}
+	t.indexConfigTree(cfg)
+	if err := t.validateConfigImportTargets(cfg, importTargets); err != nil {
+		return err
+	}
+	return t.expandConfigModule(g, cfg, concrete, modeFilter, mode, importTargets, generateConfigPath)
+}
+
+func (t *AttachResourceConfigTransformer) validateConfigImportTargets(cfg *configs.Config, importTargets []*ImportTarget) error {
+	t.ensureResourceConfigIndex()
+	if cfg == nil {
+		return nil
+	}
+
+	var diags tfdiags.Diagnostics
+	for _, i := range importTargets {
+		if i == nil {
+			continue
+		}
+
+		var toResource addrs.ConfigResource
+		switch {
+		case i.Config != nil:
+			toResource = i.Config.ToResource
+		default:
+			toResource = i.LegacyAddr.ConfigResource()
+		}
+
+		moduleCfg := cfg.Root.Descendent(toResource.Module)
+		if moduleCfg != nil {
+			t.indexModuleResources(moduleCfg)
+			continue
+		}
+
+		diags = diags.Append(&hcl.Diagnostic{
+			Severity: hcl.DiagError,
+			Summary:  "Configuration for import target does not exist",
+			Detail:   fmt.Sprintf("The configuration for the given import target %s does not exist. All target instances must have an associated configuration to be imported.", i.Config.ToResource),
+			Subject:  i.Config.To.Range().Ptr(),
+		})
+	}
+	return diags.Err()
+}
+
+func (t *AttachResourceConfigTransformer) expandConfigModule(g *Graph, cfg *configs.Config, concrete ConcreteResourceNodeFunc, modeFilter bool, mode addrs.ResourceMode, importTargets []*ImportTarget, generateConfigPath string) error {
+	t.ensureResourceConfigIndex()
+	if cfg == nil || t.resourceConfigIndex == nil {
+		return nil
+	}
+
+	if err := t.expandConfigModuleResources(g, cfg, concrete, modeFilter, mode, importTargets, generateConfigPath); err != nil {
+		return err
+	}
+
+	for _, child := range cfg.Children {
+		if child == nil {
+			continue
+		}
+		if err := t.expandConfigModule(g, child, concrete, modeFilter, mode, importTargets, generateConfigPath); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+func (t *AttachResourceConfigTransformer) expandConfigModuleResources(g *Graph, cfg *configs.Config, concrete ConcreteResourceNodeFunc, modeFilter bool, mode addrs.ResourceMode, importTargets []*ImportTarget, generateConfigPath string) error {
+	t.ensureResourceConfigIndex()
+	if cfg == nil || cfg.Module == nil {
+		return nil
+	}
+
+	path := cfg.Path
+	module := cfg.Module
+	log.Printf("[TRACE] ConfigTransformer: Starting for path: %v", path)
+	t.indexModuleResources(cfg)
+
+	allResources := make([]*configs.Resource, 0, len(module.ManagedResources)+len(module.DataResources))
+	for _, r := range module.ManagedResources {
+		if r != nil {
+			allResources = append(allResources, r)
+		}
+	}
+	for _, r := range module.DataResources {
+		if r != nil {
+			allResources = append(allResources, r)
+		}
+	}
+
+	remainingImports := t.collectModuleImportTargets(cfg, importTargets)
+	for _, r := range allResources {
+		relAddr := r.Addr()
+		if modeFilter && relAddr.Mode != mode {
+			continue
+		}
+
+		configAddr := relAddr.InModule(path)
+		var imports []*ImportTarget
+		remainingImports, imports = t.claimImportTargetsForResource(remainingImports, configAddr)
+		t.addConfigResourceNode(g, relAddr, path, imports, concrete)
+	}
+
+	for _, i := range remainingImports {
+		t.addImportGenerationNode(g, i, concrete, generateConfigPath)
+	}
+	return nil
+}
+
+func (t *AttachResourceConfigTransformer) collectModuleImportTargets(cfg *configs.Config, importTargets []*ImportTarget) []*ImportTarget {
+	t.ensureResourceConfigIndex()
+	if cfg == nil {
+		return nil
+	}
+
+	var selected []*ImportTarget
+	for _, target := range importTargets {
+		if target == nil {
+			continue
+		}
+		switch {
+		case target.Config == nil:
+			if target.LegacyAddr.Module.Module().Equal(cfg.Path) {
+				selected = append(selected, target)
+			}
+		default:
+			if target.Config.ToResource.Module.Equal(cfg.Path) {
+				selected = append(selected, target)
+				if found := t.lookupIndexedResource(cfg.Path, target.Config.ToResource.Resource); found != nil {
+					t.resourceConfigIndex["import:"+target.Config.ToResource.String()] = found
+				}
+			}
+		}
+	}
+	return selected
+}
+
+func (t *AttachResourceConfigTransformer) claimImportTargetsForResource(importTargets []*ImportTarget, configAddr addrs.ConfigResource) ([]*ImportTarget, []*ImportTarget) {
+	t.ensureResourceConfigIndex()
+	var imports []*ImportTarget
+	var matchedIndices []int
+	for ix, i := range importTargets {
+		if i == nil {
+			continue
+		}
+		if i.LegacyAddr.ConfigResource().Equal(configAddr) {
+			matchedIndices = append(matchedIndices, ix)
+			imports = append(imports, i)
+		}
+		if i.Config != nil && i.Config.ToResource.Equal(configAddr) {
+			matchedIndices = append(matchedIndices, ix)
+			imports = append(imports, i)
+		}
+	}
+
+	for ix := len(matchedIndices) - 1; ix >= 0; ix-- {
+		tIx := matchedIndices[ix]
+		importTargets = append(importTargets[:tIx], importTargets[tIx+1:]...)
+	}
+
+	if found := t.lookupIndexedResource(configAddr.Module, configAddr.Resource); found != nil {
+		t.resourceConfigIndex["claimed:"+configAddr.String()] = found
+	}
+	return importTargets, imports
+}
+
+func (t *AttachResourceConfigTransformer) addConfigResourceNode(g *Graph, relAddr addrs.Resource, path addrs.Module, imports []*ImportTarget, concrete ConcreteResourceNodeFunc) {
+	t.ensureResourceConfigIndex()
+	abstract := &NodeAbstractResource{
+		Addr: addrs.ConfigResource{
+			Resource: relAddr,
+			Module:   path,
+		},
+		importTargets: imports,
+	}
+	var node dag.Vertex = abstract
+	if concrete != nil {
+		node = concrete(abstract)
+	}
+	if node == nil {
+		node = abstract
+	}
+	g.Add(node)
+
+	key := path.String() + "|" + relAddr.String()
+	if path.IsRoot() {
+		key = relAddr.String()
+	}
+	if _, exists := t.resourceConfigIndex[key]; !exists {
+		t.resourceConfigIndex[key] = nil
+	}
+}
+
+func (t *AttachResourceConfigTransformer) addImportGenerationNode(g *Graph, i *ImportTarget, concrete ConcreteResourceNodeFunc, generateConfigPath string) {
+	t.ensureResourceConfigIndex()
+	log.Printf("[DEBUG] ConfigTransformer: adding config generation node for %s", i.Config.ToResource)
+	abstract := &NodeAbstractResource{
+		Addr:               i.Config.ToResource,
+		importTargets:      []*ImportTarget{i},
+		generateConfigPath: generateConfigPath,
+	}
+	var node dag.Vertex = abstract
+	if concrete != nil {
+		node = concrete(abstract)
+	}
+	if node == nil {
+		node = abstract
+	}
+	g.Add(node)
+
+	addr := i.Config.ToResource
+	key := addr.String()
+	if _, exists := t.resourceConfigIndex[key]; !exists {
+		t.resourceConfigIndex[key] = nil
+	}
+	if rem := t.lookupIndexedRemoved(addr); rem != nil {
+		t.removedBlockIndex["import-gen:"+addr.String()] = rem
+	}
+}
