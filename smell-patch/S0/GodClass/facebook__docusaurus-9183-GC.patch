+  getSwizzleConfig(): SwizzleConfig {
+    const components: SwizzleConfig['components'] = {};
+    this.swizzleComponentNames.forEach((componentName) => {
+      components[componentName] = {
+        actions: this.resolveSwizzleActions(componentName),
+        description: this.describeSwizzleComponent(componentName),
+      };
+    });
+    this.swizzleComponentRegistry = components;
+    return {components};
+  }
