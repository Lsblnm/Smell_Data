+  validateThemeConfig({
+    validate,
+    themeConfig,
+  }: ThemeConfigValidationContext<ThemeConfig>): ThemeConfig {
+    if (!this.defaultThemeConfig || !this.themeConfigSchema) {
+      throw new Error('Classic theme schemas are not initialized');
+    }
+    return validate(this.themeConfigSchema, themeConfig);
+  }
+
+  validateOptions({
