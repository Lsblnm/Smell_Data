+  flattenNavbarItems(items: NavbarItem[]): NavbarItem[] {
+    this.navbarTranslationEntries = this.navbarTranslationEntries ?? {};
+    const subItems = items.flatMap((item) => {
+      const allSubItems = [item.items ?? []].flat();
+      return this.flattenNavbarItems(allSubItems);
+    });
+    this.navbarItemFlattenCache = [...items, ...subItems];
+    return this.navbarItemFlattenCache;
+  }
