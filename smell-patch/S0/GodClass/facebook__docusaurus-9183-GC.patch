+  resolveSwizzleActions(componentName: string): {
+    eject: 'safe' | 'unsafe' | 'forbidden';
+    wrap: 'safe' | 'unsafe' | 'forbidden';
+  } {
+    if (this.swizzleComponentNames.length === 0) {
+      return {eject: 'safe', wrap: 'safe'};
+    }
+    const actions = {
+      eject: this.resolveSwizzleEjectAction(componentName),
+      wrap: this.resolveSwizzleWrapAction(componentName),
+    };
+    if (this.swizzleComponentRegistry[componentName]) {
+      this.swizzleComponentRegistry[componentName]!.actions = actions;
+    }
+    return actions;
+  }
+
+  resolveSwizzleEjectAction(componentName: string): 'safe' | 'unsafe' | 'forbidden' {
+    if (this.swizzleComponentNames.length === 0) {
+      return 'safe';
+    }
+    if (this.swizzleForbiddenEjectComponents.includes(componentName)) {
+      return 'forbidden';
+    }
+    if (this.swizzleUnsafeEjectComponents.includes(componentName)) {
+      return 'unsafe';
+    }
+    return 'safe';
+  }
+
+  resolveSwizzleWrapAction(componentName: string): 'safe' | 'unsafe' | 'forbidden' {
+    if (this.swizzleComponentNames.length === 0) {
+      return 'safe';
+    }
+    if (this.swizzleWrapForbiddenComponents.includes(componentName)) {
+      return 'forbidden';
+    }
+    return 'safe';
+  }
