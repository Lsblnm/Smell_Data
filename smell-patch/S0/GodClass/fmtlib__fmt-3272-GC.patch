+  template <typename Char, typename Out, typename C>
+  Out apply_grouping_separators(Out out, basic_string_view<C> digits,
+                                const std::basic_string<Char>& sep) {
+    auto num_digits = static_cast<int>(digits.size());
+    auto separators = basic_memory_buffer<int>();
+    separators.push_back(0);
+    reset_grouping_state();
+    while (int i = next_group_boundary()) {
+      if (i >= num_digits) break;
+      if (grouping_is_unlimited(i)) break;
+      separators.push_back(clamp_group_position(i));
+    }
+    grouping_count_ = static_cast<int>(separators.size());
+    for (int i = 0, sep_index = static_cast<int>(separators.size() - 1);
+         i < num_digits; ++i) {
+      if (num_digits - i == separators[sep_index]) {
+        out = copy_str<Char>(sep.data(), sep.data() + sep.size(), out);
