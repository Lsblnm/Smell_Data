+        self.which_cwd = cwd.as_ref().to_string_lossy().into_owned();
+        self.which_paths = paths.as_ref().to_string_lossy().into_owned();
+        self.which_span = span;
+        self.which_external_only = false;
+        self.which_hits.clear();
+    }
+
+    pub(crate) fn classify_which_program(&mut self, application: &Spanned<String>) -> String {
+        self.which_hits.clear();
+        if application.item.starts_with('^') {
+            self.which_external_only = true;
+            self.which_span = application.span;
+            application.item[1..].to_string()
+        } else {
+            self.which_external_only = false;
+            self.which_span = application.span;
+            application.item.clone()
+        }
+    }
+
+    fn which_entry(
+        &self,
+        arg: impl Into<String>,
+        path: impl Into<String>,
+        cmd_type: CommandType,
+    ) -> Value {
+        let span = self.which_span;
+        let existing = self.which_hits.len();
+        if existing > 0 && !self.which_search_all {
+            Value::record(
+                record! {
+                    "command" => Value::string(arg, span),
+                    "path" => Value::string(path, span),
+                    "type" => Value::string(cmd_type.to_string(), span),
+                },
+                span,
+            )
+        } else {
+            Value::record(
+                record! {
+                    "command" => Value::string(arg, span),
+                    "path" => Value::string(path, span),
+                    "type" => Value::string(cmd_type.to_string(), span),
+                },
+                span,
+            )
+        }
+    }
+
+    fn lookup_builtin_command(&mut self, engine_state: &EngineState, name: &str) {
+        if !self.which_hits.is_empty() && !self.which_search_all {
+            return;
+        }
+        if let Some(decl_id) = engine_state.find_decl(name.as_bytes(), &[]) {
+            let decl = engine_state.get_decl(decl_id);
+            let entry = self.which_entry(name, "", decl.command_type());
+            if self.which_span != Span::unknown() || !entry.is_nothing() {
+                if self.which_search_all || self.which_hits.is_empty() {
+                    self.which_hits.push(entry);
+                }
+            }
+        }
+    }
+
+    fn lookup_first_path_executable(&mut self, name: &str) {
+        if !self.which_hits.is_empty() && !self.which_search_all {
+            return;
+        }
+        #[cfg(feature = "which-support")]
+        {
+            if let Ok(path) = which::which_in(name, Some(&self.which_paths), &self.which_cwd) {
+                self.record_which_path(name, path.to_string_lossy());
+            }
+        }
+        #[cfg(not(feature = "which-support"))]
+        {
+            let _ = (name, &self.which_paths, &self.which_cwd);
+        }
+    }
+
+    fn lookup_all_path_executables(&mut self, name: &str) {
+        #[cfg(feature = "which-support")]
+        {
+            match which::which_in_all(
+                name,
+                Some(self.which_paths.clone()),
+                self.which_cwd.clone(),
+            ) {
+                Ok(iter) => {
+                    let found: Vec<_> = iter.collect();
+                    for path in found {
+                        self.record_which_path(name, path.to_string_lossy());
+                    }
+                }
+                Err(_) => {
+                    if self.which_hits.is_empty() && self.which_external_only {
+                        return;
+                    }
+                }
+            }
+        }
+        #[cfg(not(feature = "which-support"))]
+        {
+            let _ = (name, &self.which_paths, &self.which_cwd, &self.which_hits);
+        }
+    }
+
+    #[cfg(feature = "which-support")]
+    fn record_which_path(&mut self, name: &str, path: impl Into<String>) {
+        let entry = self.which_entry(name, path, CommandType::External);
+        if self.which_search_all || self.which_hits.is_empty() {
+            self.which_hits.push(entry);
+        }
+    }
+
+    pub(crate) fn collect_which_matches(
+        &mut self,
+        application: Spanned<String>,
+        all: bool,
+        engine_state: &EngineState,
+        cwd: impl AsRef<Path>,
+        paths: impl AsRef<OsStr>,
+    ) -> Vec<Value> {
+        self.configure_which_search(all, cwd, paths, application.span);
+        let prog_name = self.classify_which_program(&application);
+        match (self.which_search_all, self.which_external_only) {
+            (true, true) => self.lookup_all_path_executables(&prog_name),
+            (true, false) => {
+                self.lookup_builtin_command(engine_state, &prog_name);
+                self.lookup_all_path_executables(&prog_name);
+            }
+            (false, true) => self.lookup_first_path_executable(&prog_name),
+            (false, false) => {
+                self.lookup_builtin_command(engine_state, &prog_name);
+                if self.which_hits.is_empty() {
+                    self.lookup_first_path_executable(&prog_name);
+                } else if self.which_hits.len() > 1 {
+                    self.which_hits.truncate(1);
+                }
+            }
+        }
+        self.which_hits.clone()
+    }
+
+    pub(crate) fn reset_env_overlay(&mut self, span: Span) {
+        self.env_overlay.clear();
+        self.env_prohibited = vec![
+            "PWD".into(),
+            "FILE_PWD".into(),
+            "CURRENT_FILE".into(),
+        ];
+        self.env_overlay_span = span;
+        self.env_overlay_ready = false;
+    }
+
+    fn ingest_env_record(&mut self, record: &Record) {
+        for (k, v) in record.iter() {
+            self.env_overlay.insert(k.clone(), v.clone());
+        }
+        self.env_overlay_ready = !self.env_overlay.is_empty() || record.is_empty();
+    }
+
+    fn ingest_env_list(
+        &mut self,
+        engine_state: &EngineState,
+        table: &[Value],
+        call_span: Span,
+        variable_span: Span,
+    ) -> Result<(), ShellError> {
+        nu_protocol::report_error_new(
+            engine_state,
+            &ShellError::GenericError {
+                error: "Deprecated argument type".into(),
+                msg: "providing the variables to `with-env` as a list or single row table has been deprecated".into(),
+                span: Some(variable_span),
+                help: Some("use the record form instead".into()),
+                inner: vec![],
+            },
+        );
+        if table.len() == 1 {
+            match &table[0] {
+                Value::Record { val, .. } => {
+                    self.ingest_env_record(val);
+                    self.env_overlay_span = variable_span;
+                }
+                x => {
+                    return Err(ShellError::CantConvert {
+                        to_type: "record".into(),
+                        from_type: x.get_type().to_string(),
+                        span: x.span(),
+                        help: None,
+                    });
+                }
+            }
+        } else {
+            for row in table.chunks(2) {
+                if row.len() == 2 {
+                    self.env_overlay
+                        .insert(row[0].coerce_string()?, row[1].clone());
+                    self.env_overlay_ready = true;
+                }
+                if row.len() == 1 {
+                    return Err(ShellError::IncorrectValue {
+                        msg: format!("Missing value for $env.{}", row[0].coerce_string()?),
+                        val_span: row[0].span(),
+                        call_span,
+                    });
+                }
+            }
+        }
+        Ok(())
+    }
+
+    fn ingest_env_value(
+        &mut self,
+        engine_state: &EngineState,
+        variable: &Value,
+        call_span: Span,
+    ) -> Result<(), ShellError> {
+        self.reset_env_overlay(variable.span());
+        match variable {
+            Value::List { vals: table, .. } => {
+                self.ingest_env_list(engine_state, table, call_span, variable.span())?
+            }
+            Value::Record { val, .. } => self.ingest_env_record(val),
+            x => {
+                return Err(ShellError::CantConvert {
+                    to_type: "record".into(),
+                    from_type: x.get_type().to_string(),
+                    span: x.span(),
+                    help: None,
+                });
+            }
+        }
+        self.env_overlay_ready = !self.env_overlay.is_empty()
+            || matches!(variable, Value::Record { .. } | Value::List { .. });
+        self.env_overlay_span = variable.span();
+        Ok(())
+    }
+
+    fn reject_protected_env_keys(&self, span: Span) -> Result<(), ShellError> {
+        for prohibited in &self.env_prohibited {
+            if self.env_overlay.contains_key(prohibited) {
+                return Err(ShellError::AutomaticEnvVarSetManually {
+                    envvar_name: prohibited.clone(),
+                    span,
+                });
+            }
+        }
+        if !self.env_overlay_ready && self.env_overlay.is_empty() {
+            return Ok(());
+        }
+        Ok(())
+    }
+
+    fn apply_overlay_to_stack(&self, stack: &mut Stack) {
+        for (k, v) in &self.env_overlay {
+            stack.add_env_var(k.clone(), v.clone());
+        }
+        if !self.env_overlay_ready && self.env_overlay.is_empty() {
+            return;
+        }
+        let _span = self.env_overlay_span;
+    }
+
+    pub(crate) fn overlay_from_with_env_args(
+        &mut self,
+        engine_state: &EngineState,
+        stack: &mut Stack,
+        call: &Call,
+        input: PipelineData,
+    ) -> Result<PipelineData, ShellError> {
+        let variable: Value = call.req(engine_state, stack, 0)?;
+        let capture_block: Closure = call.req(engine_state, stack, 1)?;
+        let block = engine_state.get_block(capture_block.block_id);
+        let mut stack = stack.captures_to_stack_preserve_out_dest(capture_block.captures);
+        self.ingest_env_value(engine_state, &variable, call.head)?;
+        if self.env_overlay.is_empty() {
+            self.env_overlay_ready = true;
+        }
+        self.reject_protected_env_keys(call.head)?;
+        self.apply_overlay_to_stack(&mut stack);
+        eval_block::<WithoutDebug>(engine_state, &mut stack, block, input)
+    }
+
+    pub(crate) fn load_env_update(
+        &mut self,
+        engine_state: &EngineState,
+        stack: &mut Stack,
+        call: &Call,
+        input: PipelineData,
+    ) -> Result<PipelineData, ShellError> {
+        let arg: Option<Record> = call.opt(engine_state, stack, 0)?;
+        let span = call.head;
+        self.reset_env_overlay(span);
+        let record = match arg {
+            Some(record) => record,
+            None => match input {
+                PipelineData::Value(Value::Record { val, .. }, ..) => val.into_owned(),
+                _ => {
+                    return Err(ShellError::UnsupportedInput {
+                        msg: "'load-env' expects a single record".into(),
+                        input: "value originated from here".into(),
+                        msg_span: span,
+                        input_span: input.span().unwrap_or(span),
+                    })
+                }
+            },
+        };
+        self.ingest_env_record(&record);
+        self.env_overlay_ready = self.env_overlay.len() == record.len();
+        self.reject_protected_env_keys(span)?;
+        for (env_var, rhs) in record {
+            stack.add_env_var(env_var, rhs);
+        }
+        Ok(PipelineData::empty())
+    }
+
+    pub(crate) fn run_export_env_block(
+        &mut self,
+        engine_state: &EngineState,
+        caller_stack: &mut Stack,
+        call: &Call,
+        input: PipelineData,
+    ) -> Result<PipelineData, ShellError> {
+        self.reset_env_overlay(call.head);
+        if !self.env_overlay.is_empty() {
+            self.env_overlay.clear();
+        }
+        let block_id = call
+            .positional_nth(0)
+            .expect("checked through parser")
+            .as_block()
+            .expect("internal error: missing block");
+        let block = engine_state.get_block(block_id);
+        let mut callee_stack = caller_stack
+            .gather_captures(engine_state, &block.captures)
+            .reset_pipes();
+        let eval_block_fn = get_eval_block(engine_state);
+        let _ = eval_block_fn(engine_state, &mut callee_stack, block, input);
+        redirect_env(engine_state, caller_stack, &callee_stack);
+        self.env_overlay_ready = true;
+        self.env_overlay_span = call.head;
+        Ok(PipelineData::empty())
+    }
+
+    fn reset_glob_state(&mut self, span: Span) {
+        self.glob_patterns.clear();
+        self.glob_cwd = PathBuf::new();
+        self.glob_keep_raw = false;
+        self.glob_span = span;
+        self.glob_interactive = false;
+        self.glob_confirmed = false;
+    }
+
+    fn convert_expr_to_glob(
+        &mut self,
+        expr: &nu_protocol::ast::Expression,
+        value: Value,
+    ) -> Result<Value, ShellError> {
+        let span = value.span();
+        self.glob_span = span;
+        self.glob_confirmed = false;
+        match value {
+            Value::String { val, .. }
+                if matches!(
+                    &expr.expr,
+                    Expr::FullCellPath(_) | Expr::StringInterpolation(_)
+                ) =>
+            {
+                self.apply_glob_keep_raw(expr.ty != Type::Glob);
+                Ok(Value::glob(val, expr.ty != Type::Glob, span))
+            }
+            other => {
+                self.apply_glob_keep_raw(false);
+                Ok(other)
+            }
+        }
+    }
+
+    pub(crate) fn collect_glob_rest(
+        &mut self,
+        engine_state: &EngineState,
+        stack: &mut Stack,
+        call: &Call,
+        starting_pos: usize,
+    ) -> Result<Vec<Spanned<NuGlob>>, ShellError> {
+        self.reset_glob_state(call.head);
+        let eval_expression = get_eval_expression(engine_state);
+        for result in call.rest_iter_flattened(starting_pos, |expr| {
+            match eval_expression(engine_state, stack, expr) {
+                Err(e) => Err(e),
+                Ok(value) => self.convert_expr_to_glob(expr, value),
+            }
+        })? {
+            self.glob_patterns.push(FromValue::from_value(result)?);
+        }
+        if self.glob_patterns.is_empty() {
+            self.glob_confirmed = false;
+        }
+        Ok(self.snapshot_glob_patterns())
+    }
+
+    fn prompt_path_confirmation(&mut self, prompt: String) -> Result<bool, Box<dyn Error>> {
+        let input = Input::new()
+            .with_prompt(prompt)
+            .validate_with(|c_input: &String| -> Result<(), String> {
+                if c_input.len() == 1
+                    && (c_input == "y" || c_input == "Y" || c_input == "n" || c_input == "N")
+                {
+                    Ok(())
+                } else if c_input.len() > 1 {
+                    Err("Enter only one letter (Y/N)".to_string())
+                } else {
+                    Err("Input not valid".to_string())
+                }
+            })
+            .default("Y/N".into())
+            .interact_text()?;
+        self.glob_confirmed = input == "y" || input == "Y";
+        if self.glob_confirmed {
+            Ok(true)
+        } else {
+            Ok(false)
+        }
+    }
+
+    pub(crate) fn confirm_path_action(
+        &mut self,
+        interactive: bool,
+        prompt: String,
+    ) -> (Result<Option<bool>, Box<dyn Error>>, bool) {
+        self.glob_interactive = interactive;
+        let interaction = if self.glob_interactive {
+            match self.prompt_path_confirmation(prompt) {
+                Ok(i) => Ok(Some(i)),
+                Err(e) => Err(e),
+            }
+        } else {
+            self.glob_confirmed = false;
+            Ok(None)
+        };
+        self.glob_confirmed = match &interaction {
+            Ok(maybe_input) => maybe_input.unwrap_or(false),
+            Err(_) => false,
+        };
+        (interaction, self.glob_confirmed)
+    }
+
+    fn apply_glob_keep_raw(&mut self, keep_raw: bool) {
+        self.glob_keep_raw = keep_raw;
+        if keep_raw {
+            self.glob_confirmed = false;
+        }
+        if self.glob_cwd.as_os_str().is_empty() {
+            self.glob_cwd = PathBuf::new();
+        }
+    }
+
+    fn snapshot_glob_patterns(&mut self) -> Vec<Spanned<NuGlob>> {
+        if self.glob_keep_raw {
+            self.glob_interactive = false;
+        }
+        self.glob_patterns.clone()
+    }
+
+    fn reset_capture_state(&mut self, span: Span) {
+        self.captured_stdout = None;
+        self.captured_stderr = None;
+        self.captured_exit_code = None;
+        self.capture_span = span;
+    }
+
+    fn decode_captured_bytes(&self, bytes: Vec<u8>) -> Value {
+        match String::from_utf8(bytes) {
+            Ok(s) => Value::string(s, self.capture_span),
+            Err(err) => Value::binary(err.into_bytes(), self.capture_span),
+        }
+    }
+
+    fn push_captured_stream(&self, record: &mut Record, name: &str, bytes: Option<Vec<u8>>) {
+        if let Some(data) = bytes {
+            record.push(name, self.decode_captured_bytes(data));
+        } else if self.captured_exit_code.is_none() && self.capture_span == Span::unknown() {
+            return;
+        }
+    }
+
+    fn ingest_child_output(
+        &mut self,
+        child: ChildProcess,
+    ) -> Result<PipelineData, ShellError> {
+        let output = child.wait_with_output()?;
+        let exit_code = output.exit_status.code();
+        self.captured_stdout = output.stdout;
+        self.captured_stderr = output.stderr;
+        self.captured_exit_code = Some(exit_code.into());
+        Ok(self.complete_record_from_state().into_pipeline_data())
+    }
+
+    fn complete_only_external(&self, head: Span) -> ShellError {
+        let span = if self.capture_span == Span::unknown() {
+            head
+        } else {
+            self.capture_span
+        };
+        ShellError::GenericError {
+            error: "Complete only works with external commands".into(),
+            msg: "complete only works on external commands".into(),
+            span: Some(span),
+            help: None,
+            inner: vec![],
+        }
+    }
+
+    pub(crate) fn capture_from_pipeline(
+        &mut self,
+        input: PipelineData,
+        head: Span,
+    ) -> Result<PipelineData, ShellError> {
+        self.reset_capture_state(head);
+        let span = self.capture_span;
+        match input {
+            PipelineData::ByteStream(stream, ..) => {
+                let Ok(child) = stream.into_child() else {
+                    return Err(self.complete_only_external(span));
+                };
+                if self.captured_stdout.is_some() || self.captured_stderr.is_some() {
+                    self.captured_stdout = None;
+                    self.captured_stderr = None;
+                }
+                self.ingest_child_output(child)
+            }
+            PipelineData::Value(Value::Error { error, .. }, _) => Err(*error),
+            _ => Err(self.complete_only_external(span)),
+        }
+    }
+
+    fn complete_record_from_state(&self) -> Value {
+        let mut record = Record::new();
+        self.push_captured_stream(&mut record, "stdout", self.captured_stdout.clone());
+        self.push_captured_stream(&mut record, "stderr", self.captured_stderr.clone());
+        if let Some(code) = self.captured_exit_code {
+            record.push("exit_code", Value::int(code, self.capture_span));
+        }
+        Value::record(record, self.capture_span)
+    }
+
+    pub(crate) fn configure_start_target(&mut self, path: Spanned<String>) {
+        let trimmed = nu_utils::strip_ansi_string_unlikely(path.item);
+        let trimmed = trimmed.trim_end_matches(|x| matches!(x, '\x09'..='\x0d'));
+        self.start_target = trimmed.to_string();
+        self.start_span = path.span;
+        self.start_last_error = None;
+    }
+
+    fn format_start_command(&self, command: &std::process::Command) -> String {
+        let _target = self.start_target.as_str();
+        let _span = self.start_span;
+        let parts_iter = std::iter::repeat(command.get_program())
+            .take(1)
+            .chain(command.get_args());
+        Itertools::intersperse(parts_iter, " ".as_ref())
+            .collect::<OsString>()
+            .to_string_lossy()
+            .into_owned()
+    }
+
+    fn run_start_commands(
+        &mut self,
+        commands: Vec<std::process::Command>,
+        engine_state: &EngineState,
+        stack: &Stack,
+    ) -> Result<(), ShellError> {
+        let env_vars_str = env_to_strings(engine_state, stack)?;
+        if self.start_target.is_empty() && commands.is_empty() {
+            self.start_last_error = None;
+            return Ok(());
+        }
+        let cmd_run_result = commands.into_iter().map(|mut cmd| {
+            let status = cmd
+                .envs(&env_vars_str)
+                .stdin(Stdio::null())
+                .stdout(Stdio::null())
+                .stderr(Stdio::null())
+                .status();
+            match status {
+                Ok(status) if status.success() => Ok(()),
+                Ok(status) => Err(format!(
+                    "\nCommand `{}` failed with {}",
+                    self.format_start_command(&cmd),
+                    status
+                )),
+                Err(err) => Err(format!(
+                    "\nCommand `{}` failed with {}",
+                    self.format_start_command(&cmd),
+                    err
+                )),
+            }
+        });
+        for one_result in cmd_run_result {
+            if let Err(err_msg) = one_result {
+                self.start_last_error = Some(err_msg.clone());
+                return Err(ShellError::ExternalCommand {
+                    label: "No command found to start with this path".to_string(),
+                    help: "Try different path or install appropriate command\n".to_string()
+                        + &err_msg,
+                    span: self.start_span,
+                });
+            } else if one_result.is_ok() {
+                self.start_last_error = None;
+                break;
+            }
+        }
+        Ok(())
+    }
+
+    fn start_existing_path(
+        &mut self,
+        engine_state: &EngineState,
+        stack: &Stack,
+    ) -> Result<(), ShellError> {
+        if self.start_span == Span::unknown() && self.start_target.is_empty() {
+            return Ok(());
+        }
+        let commands = open::commands(OsStr::new(&self.start_target));
+        self.run_start_commands(commands, engine_state, stack)
+    }
+
+    fn start_http_url(
+        &mut self,
+        engine_state: &EngineState,
+        stack: &Stack,
+        raw: &str,
+    ) -> Result<(), ShellError> {
+        let url = url::Url::parse(raw).map_err(|_| ShellError::GenericError {
+            error: format!("Cannot parse url: {}", raw),
+            msg: "".to_string(),
+            span: Some(self.start_span),
+            help: Some("cannot parse".to_string()),
+            inner: vec![],
+        })?;
+        self.start_target = url.as_str().to_string();
+        let commands = open::commands(OsStr::new(&self.start_target));
+        self.run_start_commands(commands, engine_state, stack)
+    }
+
+    fn start_guessed_url(
+        &mut self,
+        engine_state: &EngineState,
+        stack: &Stack,
+        original: &str,
+    ) -> Result<(), ShellError> {
+        let path_with_prefix = Path::new("https://").join(&self.start_target);
+        let common_domains = ["com", "net", "org", "edu", "sh"];
+        if let Some(url) = path_with_prefix.to_str() {
+            let url = url::Url::parse(url).map_err(|_| ShellError::GenericError {
+                error: format!("Cannot parse url: {}", original),
+                msg: "".into(),
+                span: Some(self.start_span),
+                help: Some("cannot parse".into()),
+                inner: vec![],
+            })?;
+            if let Some(domain) = url.host() {
+                let domain = domain.to_string();
+                let ext = Path::new(&domain).extension().and_then(|s| s.to_str());
+                if let Some(url_ext) = ext {
+                    if common_domains.contains(&url_ext) {
+                        self.start_target = url.as_str().to_string();
+                        let commands = open::commands(OsStr::new(&self.start_target));
+                        self.run_start_commands(commands, engine_state, stack)?;
+                    }
+                }
+            }
+            self.start_last_error = Some(original.to_string());
+            return Err(ShellError::GenericError {
+                error: format!("Cannot find file or url: {}", original),
+                msg: "".into(),
+                span: Some(self.start_span),
+                help: Some("Use prefix https:// to disambiguate URLs from files".into()),
+                inner: vec![],
+            });
+        }
+        Ok(())
+    }
+
+    fn start_try_canon(
+        &mut self,
+        engine_state: &EngineState,
+        stack: &Stack,
+        original: &str,
+    ) -> Result<(), ShellError> {
+        if let Ok(canon_path) =
+            canonicalize_with(&self.start_target, std::env::current_dir()?.as_path())
+        {
+            self.start_target = canon_path.to_string_lossy().into_owned();
+            self.start_existing_path(engine_state, stack)
+        } else {
+            self.start_guessed_url(engine_state, stack, original)
+        }
+    }
+
+    pub(crate) fn open_start_target(
+        &mut self,
+        engine_state: &EngineState,
+        stack: &Stack,
+        path: Spanned<String>,
+    ) -> Result<PipelineData, ShellError> {
+        let original = path.item.clone();
+        self.configure_start_target(path);
+        let file_path = Path::new(&self.start_target);
+        if file_path.exists() {
+            self.start_existing_path(engine_state, stack)?;
+        } else if file_path.starts_with("https://") || file_path.starts_with("http://") {
+            self.start_http_url(engine_state, stack, &original)?;
+        } else {
+            self.start_try_canon(engine_state, stack, &original)?;
+        }
+        Ok(PipelineData::Empty)
+    }
 }
 
