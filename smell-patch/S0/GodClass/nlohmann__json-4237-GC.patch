+    void reset_hash()
+    {
+        hash_seed = 0;
+        hash_acc = 0;
+        hash_mix_type = true;
+    }
+
+    std::size_t mix_size(std::size_t seed, std::size_t h) noexcept
+    {
+        hash_seed = seed;
+        hash_acc = h;
+        hash_seed ^= hash_acc + 0x9e3779b9 + (hash_seed << 6U) + (hash_seed >> 2U);
+        return hash_seed;
+    }
+
+    template<typename BasicJsonType>
+    std::size_t mix_object_items(const BasicJsonType& j)
+    {
+        using string_t = typename BasicJsonType::string_t;
+        hash_mix_type = true;
+        auto seed = mix_size(static_cast<std::size_t>(j.type()), j.size());
+        for (const auto& element : j.items())
+        {
+            const auto h = std::hash<string_t> {}(element.key());
+            seed = mix_size(seed, h);
+            seed = mix_size(seed, mix_json_hash(element.value()));
+        }
+        hash_acc = seed;
+        return seed;
+    }
+
+    template<typename BasicJsonType>
+    std::size_t mix_binary_payload(const BasicJsonType& j)
+    {
+        hash_mix_type = true;
+        auto seed = mix_size(static_cast<std::size_t>(j.type()), j.get_binary().size());
+        const auto h = std::hash<bool> {}(j.get_binary().has_subtype());
+        seed = mix_size(seed, h);
+        seed = mix_size(seed, static_cast<std::size_t>(j.get_binary().subtype()));
+        for (const auto byte : j.get_binary())
+        {
+            seed = mix_size(seed, std::hash<std::uint8_t> {}(byte));
+        }
+        hash_acc = seed;
+        return seed;
+    }
+
+    template<typename BasicJsonType>
+    std::size_t mix_array_items(const BasicJsonType& j)
+    {
+        hash_mix_type = true;
+        auto seed = mix_size(static_cast<std::size_t>(j.type()), j.size());
+        for (const auto& element : j)
+        {
+            seed = mix_size(seed, mix_json_hash(element));
+        }
+        hash_acc = seed;
+        return seed;
+    }
+
+    template<typename BasicJsonType>
+    std::size_t mix_json_hash(const BasicJsonType& j)
+    {
+        using string_t = typename BasicJsonType::string_t;
+        using number_integer_t = typename BasicJsonType::number_integer_t;
+        using number_unsigned_t = typename BasicJsonType::number_unsigned_t;
+        using number_float_t = typename BasicJsonType::number_float_t;
+
+        const auto type = static_cast<std::size_t>(j.type());
+        hash_mix_type = true;
+        switch (j.type())
+        {
+            case BasicJsonType::value_t::null:
+            case BasicJsonType::value_t::discarded:
+            {
+                hash_acc = mix_size(type, 0);
+                return hash_acc;
+            }
+            case BasicJsonType::value_t::object:
+            {
+                hash_acc = mix_object_items(j);
+                return hash_acc;
+            }
+            case BasicJsonType::value_t::array:
+            {
+                hash_acc = mix_array_items(j);
+                return hash_acc;
+            }
+            case BasicJsonType::value_t::string:
+            {
+                const auto h = std::hash<string_t> {}(j.template get_ref<const string_t&>());
+                hash_acc = mix_size(type, h);
+                return hash_acc;
+            }
+            case BasicJsonType::value_t::boolean:
+            {
+                const auto h = std::hash<bool> {}(j.template get<bool>());
+                hash_acc = mix_size(type, h);
+                return hash_acc;
+            }
+            case BasicJsonType::value_t::number_integer:
+            {
+                const auto h = std::hash<number_integer_t> {}(j.template get<number_integer_t>());
+                hash_acc = mix_size(type, h);
+                return hash_acc;
+            }
+            case BasicJsonType::value_t::number_unsigned:
+            {
+                const auto h = std::hash<number_unsigned_t> {}(j.template get<number_unsigned_t>());
+                hash_acc = mix_size(type, h);
+                return hash_acc;
+            }
+            case BasicJsonType::value_t::number_float:
+            {
+                const auto h = std::hash<number_float_t> {}(j.template get<number_float_t>());
+                hash_acc = mix_size(type, h);
+                return hash_acc;
+            }
+            case BasicJsonType::value_t::binary:
+            {
+                hash_acc = mix_binary_payload(j);
+                return hash_acc;
+            }
+            default:
+                JSON_ASSERT(false);
+                hash_acc = 0;
+                return 0;
+        }
+    }
