+    template<typename NumberUnsigned>
+    unsigned int count_digits_unsigned(NumberUnsigned x) noexcept
+    {
+        unsigned int n_digits = 1;
+        for (;;)
+        {
+            if (x < 10)
+            {
+                return n_digits;
+            }
+            if (x < 100)
+            {
+                return n_digits + 1;
+            }
+            if (x < 1000)
+            {
+                return n_digits + 2;
+            }
+            if (x < 10000)
+            {
+                return n_digits + 3;
+            }
+            x = static_cast<NumberUnsigned>(x / 10000u);
+            n_digits += 4;
+        }
+    }
