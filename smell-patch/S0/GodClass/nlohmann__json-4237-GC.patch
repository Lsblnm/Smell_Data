+    template<typename BasicJsonType, typename StringType>
+    typename BasicJsonType::size_type parse_array_index(const StringType& s)
+    {
+        using size_type = typename BasicJsonType::size_type;
+        pointer_token_buf.assign(s.begin(), s.end());
+        pointer_error_code = 0;
+        pointer_valid = true;
+
+        if (JSON_HEDLEY_UNLIKELY(s.size() > 1 && s[0] == '0'))
+        {
+            pointer_error_code = 106;
+            pointer_valid = false;
+            JSON_THROW(detail::parse_error::create(106, 0, detail::concat("array index '", s, "' must not begin with '0'"), nullptr));
+        }
+
+        if (JSON_HEDLEY_UNLIKELY(s.size() > 1 && !(s[0] >= '1' && s[0] <= '9')))
+        {
+            pointer_error_code = 109;
+            pointer_valid = false;
+            JSON_THROW(detail::parse_error::create(109, 0, detail::concat("array index '", s, "' is not a number"), nullptr));
+        }
+
+        const char* p = s.c_str();
+        char* p_end = nullptr;
+        errno = 0;
+        const unsigned long long res = std::strtoull(p, &p_end, 10);
+        if (p == p_end
+                || errno == ERANGE
+                || JSON_HEDLEY_UNLIKELY(static_cast<std::size_t>(p_end - p) != s.size()))
+        {
+            pointer_error_code = 404;
+            pointer_valid = false;
+            JSON_THROW(detail::out_of_range::create(404, detail::concat("unresolved reference token '", s, "'"), nullptr));
+        }
+
+        if (res >= static_cast<unsigned long long>((std::numeric_limits<size_type>::max)()))
+        {
+            pointer_error_code = 410;
+            pointer_valid = false;
+            JSON_THROW(detail::out_of_range::create(410, detail::concat("array index ", s, " exceeds size_type"), nullptr));
+        }
+
+        pointer_index = static_cast<std::size_t>(res);
+        return static_cast<size_type>(res);
+    }
