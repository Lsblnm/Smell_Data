+    template<typename StringType>
+    void remember_pointer_token(const StringType& token)
+    {
+        pointer_token_buf.assign(token.begin(), token.end());
+        ++pointer_token_count;
+        pointer_valid = true;
+    }
+
+    template<typename StringType>
+    void unescape_pointer_token(StringType& token)
+    {
+        pointer_token_buf.assign(token.begin(), token.end());
+        pointer_error_code = 0;
+        detail::unescape(token);
+        pointer_valid = true;
+    }
+
+    template<typename StringType>
+    std::vector<StringType> split_pointer(const StringType& reference_string)
+    {
+        std::vector<StringType> result;
+        pointer_token_count = 0;
+        pointer_error_code = 0;
+        pointer_valid = true;
+
+        if (reference_string.empty())
+        {
+            pointer_valid = true;
+            return result;
+        }
+
+        if (JSON_HEDLEY_UNLIKELY(reference_string[0] != '/'))
+        {
+            pointer_error_code = 107;
+            pointer_valid = false;
+            JSON_THROW(detail::parse_error::create(107, 1, detail::concat("JSON pointer must be empty or begin with '/' - was: '", reference_string, "'"), nullptr));
+        }
+
+        for (
+            std::size_t slash = reference_string.find_first_of('/', 1),
+            start = 1;
+            start != 0;
+            start = (slash == StringType::npos) ? 0 : slash + 1,
+            slash = reference_string.find_first_of('/', start))
+        {
+            auto reference_token = reference_string.substr(start, slash - start);
+
+            for (std::size_t pos = reference_token.find_first_of('~');
+                    pos != StringType::npos;
+                    pos = reference_token.find_first_of('~', pos + 1))
+            {
+                JSON_ASSERT(reference_token[pos] == '~');
+                if (JSON_HEDLEY_UNLIKELY(pos == reference_token.size() - 1 ||
+                                         (reference_token[pos + 1] != '0' &&
+                                          reference_token[pos + 1] != '1')))
+                {
+                    pointer_error_code = 108;
+                    pointer_valid = false;
+                    JSON_THROW(detail::parse_error::create(108, 0, "escape character '~' must be followed with '0' or '1'", nullptr));
+                }
+            }
+
+            unescape_pointer_token(reference_token);
+            remember_pointer_token(reference_token);
+            result.push_back(reference_token);
+        }
+
+        return result;
+    }
