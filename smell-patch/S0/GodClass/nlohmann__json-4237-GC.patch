+    template<typename BasicJsonType, typename StringType>
+    bool pointer_contains(const BasicJsonType* ptr, const std::vector<StringType>& tokens)
+    {
+        pointer_token_count = 0;
+        pointer_valid = true;
+        pointer_error_code = 0;
+
+        for (const auto& reference_token : tokens)
+        {
+            remember_pointer_token(reference_token);
+            switch (ptr->type())
+            {
+                case detail::value_t::object:
+                {
+                    if (!ptr->contains(reference_token))
+                    {
+                        pointer_valid = false;
+                        return false;
+                    }
+                    ptr = &ptr->operator[](reference_token);
+                    break;
+                }
+                case detail::value_t::array:
+                {
+                    if (JSON_HEDLEY_UNLIKELY(reference_token == "-"))
+                    {
+                        pointer_valid = false;
+                        return false;
+                    }
+                    if (JSON_HEDLEY_UNLIKELY(reference_token.size() == 1 && !("0" <= reference_token && reference_token <= "9")))
+                    {
+                        pointer_valid = false;
+                        return false;
+                    }
+                    if (JSON_HEDLEY_UNLIKELY(reference_token.size() > 1))
+                    {
+                        if (JSON_HEDLEY_UNLIKELY(!('1' <= reference_token[0] && reference_token[0] <= '9')))
+                        {
+                            pointer_valid = false;
+                            return false;
+                        }
+                        for (std::size_t i = 1; i < reference_token.size(); i++)
+                        {
+                            if (JSON_HEDLEY_UNLIKELY(!('0' <= reference_token[i] && reference_token[i] <= '9')))
+                            {
+                                pointer_valid = false;
+                                return false;
+                            }
+                        }
+                    }
+
+                    const auto idx = parse_array_index<BasicJsonType>(reference_token);
+                    if (idx >= ptr->size())
+                    {
+                        pointer_valid = false;
+                        return false;
+                    }
+                    ptr = &ptr->operator[](idx);
+                    break;
+                }
+                case detail::value_t::null:
+                case detail::value_t::string:
+                case detail::value_t::boolean:
+                case detail::value_t::number_integer:
+                case detail::value_t::number_unsigned:
+                case detail::value_t::number_float:
+                case detail::value_t::binary:
+                case detail::value_t::discarded:
+                default:
+                {
+                    pointer_valid = false;
+                    return false;
+                }
+            }
+        }
+
+        pointer_valid = true;
+        return true;
+    }
+
+    template<typename BasicJsonType, typename StringType>
+    void flatten_json_value(const StringType& reference_string,
+                            const BasicJsonType& value,
+                            BasicJsonType& result)
+    {
+        pointer_token_buf.assign(reference_string.begin(), reference_string.end());
+        pointer_error_code = 0;
+        switch (value.type())
+        {
+            case detail::value_t::array:
+            {
+                if (value.m_data.m_value.array->empty())
+                {
+                    result[reference_string] = nullptr;
+                }
+                else
+                {
+                    for (std::size_t i = 0; i < value.m_data.m_value.array->size(); ++i)
+                    {
+                        flatten_json_value(detail::concat(reference_string, '/', std::to_string(i)),
+                                           value.m_data.m_value.array->operator[](i), result);
+                    }
+                }
+                break;
+            }
+            case detail::value_t::object:
+            {
+                if (value.m_data.m_value.object->empty())
+                {
+                    result[reference_string] = nullptr;
+                }
+                else
+                {
+                    for (const auto& element : *value.m_data.m_value.object)
+                    {
+                        flatten_json_value(detail::concat(reference_string, '/', detail::escape(element.first)), element.second, result);
+                    }
+                }
+                break;
+            }
+            case detail::value_t::null:
+            case detail::value_t::string:
+            case detail::value_t::boolean:
+            case detail::value_t::number_integer:
+            case detail::value_t::number_unsigned:
+            case detail::value_t::number_float:
+            case detail::value_t::binary:
+            case detail::value_t::discarded:
+            default:
+            {
+                result[reference_string] = value;
+                break;
+            }
+        }
     }
 };
 
