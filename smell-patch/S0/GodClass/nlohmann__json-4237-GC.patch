+    template<typename NumberFloat>
+    void write_float_generic(NumberFloat x)
+    {
+        static constexpr auto d = std::numeric_limits<NumberFloat>::max_digits10;
+        std::ptrdiff_t len = (std::snprintf)(number_buffer.data(), number_buffer.size(), "%.*g", d, x);
+        JSON_ASSERT(len > 0);
+        JSON_ASSERT(static_cast<std::size_t>(len) < number_buffer.size());
+
+        if (thousands_sep != '\0')
+        {
+            const auto end = std::remove(number_buffer.begin(), number_buffer.begin() + len, thousands_sep);
+            std::fill(end, number_buffer.end(), '\0');
+            JSON_ASSERT((end - number_buffer.begin()) <= len);
+            len = (end - number_buffer.begin());
+        }
+
+        if (decimal_point != '\0' && decimal_point != '.')
+        {
+            const auto dec_pos = std::find(number_buffer.begin(), number_buffer.end(), decimal_point);
+            if (dec_pos != number_buffer.end())
+            {
+                *dec_pos = '.';
+            }
+        }
+
+        dump_adapter->write_characters(number_buffer.data(), static_cast<std::size_t>(len));
+
+        const bool value_is_int_like =
+            std::none_of(number_buffer.begin(), number_buffer.begin() + len + 1,
+                         [](char c)
+        {
+            return c == '.' || c == 'e';
+        });
+
+        if (value_is_int_like)
+        {
+            dump_adapter->write_characters(".0", 2);
+        }
+    }
