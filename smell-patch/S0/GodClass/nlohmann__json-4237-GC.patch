+            = (std::numeric_limits<NumberFloat>::is_iec559 && std::numeric_limits<NumberFloat>::digits == 24 && std::numeric_limits<NumberFloat>::max_exponent == 128) ||
+              (std::numeric_limits<NumberFloat>::is_iec559 && std::numeric_limits<NumberFloat>::digits == 53 && std::numeric_limits<NumberFloat>::max_exponent == 1024);
