+            $resultVector = array_pop($this->lookupArray);
+            $this->lookupArray = array_shift($this->lookupArray);
+        }
+
+        if ($lookupColumns !== 2) {
+            $this->lookupArray = $this->verifyLookupValues($this->lookupArray, $resultVector);
+        }
+
+        return self::lookup($this->lookupValue, $this->lookupArray, 2);
+    }
+
+    private function verifyLookupValues(array $lookupVector, array $resultVector): array
+    {
+        $this->lookupArray = $lookupVector;
+        foreach ($this->lookupArray as &$value) {
+            if (is_array($value)) {
+                $k = array_keys($value);
+                $key1 = $key2 = array_shift($k);
+                ++$key2;
+                $dataValue1 = $value[$key1];
+            } else {
+                $key1 = 0;
+                $key2 = 1;
+                $dataValue1 = $value;
+            }
+
+            $dataValue2 = array_shift($resultVector);
+            if (is_array($dataValue2)) {
+                $dataValue2 = array_shift($dataValue2);
+            }
+            $value = [$key1 => $dataValue1, $key2 => $dataValue2];
+        }
+        unset($value);
+
+        return $this->lookupArray;
+    }
+
+    private function verifyResultVector(array $resultVector): array
+    {
+        $previous = $this->lookupArray;
+        $this->lookupArray = $resultVector;
+        $resultRows = $this->rowCount($this->lookupArray);
+        $resultColumns = $this->columnCount($this->lookupArray);
+
+        if ($resultRows === 1 && $resultColumns > 1) {
+            $this->lookupArray = $this->transposeMatrix($this->lookupArray);
+        }
+        $verified = $this->lookupArray;
+        $this->lookupArray = $previous;
+
+        return $verified;
+    }
+
+    private function rowCount(array $dataArray): int
+    {
+        $previous = $this->lookupArray;
+        $this->lookupArray = $dataArray;
+        $count = count($this->lookupArray);
+        $this->lookupArray = $previous;
+
+        return $count;
+    }
+
+    private function columnCount(array $dataArray): int
+    {
+        $previous = $this->lookupArray;
+        $this->lookupArray = $dataArray;
+        $rowKeys = array_keys($this->lookupArray);
+        $row = array_shift($rowKeys);
+        $count = count($this->lookupArray[$row]);
+        $this->lookupArray = $previous;
+
+        return $count;
+    }
+
+    /**
+     * @param mixed $matrix
+     * @param mixed $rowNum
+     * @param mixed $columnNum
+     *
+     * @return mixed
+     */
+    private function extractMatrixIndex($matrix, $rowNum = 0, $columnNum = null)
+    {
+        $this->lookupArray = is_array($matrix) ? $matrix : [];
+        $this->indexNumber = $rowNum ?? 0;
+        $originalColumnNum = $columnNum;
+        $columnNum = $columnNum ?? 0;
+
+        try {
+            $rowNum = LookupRefValidations::validatePositiveInt($this->indexNumber);
+            $columnNum = LookupRefValidations::validatePositiveInt($columnNum);
+        } catch (Exception $e) {
+            return $e->getMessage();
+        }
+
+        if (!is_array($matrix) || ($rowNum > count($this->lookupArray))) {
+            return ExcelError::REF();
+        }
+
+        $rowKeys = array_keys($this->lookupArray);
+        $columnKeys = @array_keys($this->lookupArray[$rowKeys[0]]);
+
+        if ($columnNum > count($columnKeys)) {
+            return ExcelError::REF();
+        }
+        if ($originalColumnNum === null && 1 < count($columnKeys)) {
+            return ExcelError::REF();
+        }
+
+        if ($columnNum === 0) {
+            return $this->extractMatrixRow($this->lookupArray, $rowKeys, $rowNum);
+        }
+
+        $columnNum = $columnKeys[--$columnNum];
+        if ($rowNum === 0) {
+            return array_map(
+                function ($value) {
+                    return [$value];
+                },
+                array_column($this->lookupArray, $columnNum)
+            );
+        }
+        $rowNum = $rowKeys[--$rowNum];
+
+        return $this->lookupArray[$rowNum][$columnNum];
+    }
+
+    /** @return mixed */
+    private function extractMatrixRow(array $matrix, array $rowKeys, int $rowNum)
+    {
+        $this->lookupArray = $matrix;
+        if ($rowNum === 0) {
+            return $this->lookupArray;
+        }
+
+        $rowNum = $rowKeys[--$rowNum];
+        $row = $this->lookupArray[$rowNum];
+        if (is_array($row)) {
+            return [$rowNum => $row];
+        }
+
+        return $row;
+    }
+
+    /**
+     * @param array|mixed $matrixData
+     *
+     * @return array
+     */
+    private function transposeMatrix($matrixData)
+    {
+        $returnMatrix = [];
+        if (!is_array($matrixData)) {
+            $matrixData = [[$matrixData]];
+        }
+        $this->lookupArray = $matrixData;
+
+        $column = 0;
+        foreach ($this->lookupArray as $matrixRow) {
+            $row = 0;
+            foreach ($matrixRow as $matrixCell) {
+                $returnMatrix[$row][$column] = $matrixCell;
+                ++$row;
+            }
+            ++$column;
+        }
+
+        return $returnMatrix;
+    }
+
+
+    /**
+     * @param mixed $lookupValue
+     * @param mixed $lookupArray
+     * @param mixed $matchType
+     *
+     * @return array|int|string
+     */
+    private function performMatch($lookupValue, $lookupArray, $matchType = ExcelMatch::MATCHTYPE_LARGEST_VALUE)
+    {
+        $this->matchValue = $lookupValue;
+        $this->matchArray = is_array($lookupArray) ? $lookupArray : [];
+        $this->matchType = ExcelMatch::MATCHTYPE_LARGEST_VALUE;
+        $this->matchKeys = [];
+        $this->matchWildcard = '';
+
+        $this->matchArray = Functions::flattenArray($this->matchArray);
+
+        try {
+            $this->validateMatchValue($this->matchValue);
+            $this->matchType = $this->validateMatchType($matchType);
+            $this->validateMatchVector($this->matchArray);
+
+            $this->matchKeys = array_keys($this->matchArray);
+            if ($this->matchType == ExcelMatch::MATCHTYPE_LARGEST_VALUE) {
+                $this->matchArray = array_reverse($this->matchArray);
+                $this->matchKeys = array_reverse($this->matchKeys);
+            }
+
+            $this->matchArray = $this->prepareMatchVector($this->matchArray, $this->matchType);
+        } catch (Exception $e) {
+            return $e->getMessage();
+        }
+
+        if (is_string($this->matchValue)) {
+            $this->matchValue = StringHelper::strToLower($this->matchValue);
+        }
+
+        $valueKey = null;
+        switch ($this->matchType) {
+            case ExcelMatch::MATCHTYPE_LARGEST_VALUE:
+                $valueKey = $this->matchLargestValue($this->matchArray, $this->matchValue, $this->matchKeys);
+
+                break;
+            case ExcelMatch::MATCHTYPE_FIRST_VALUE:
+                $valueKey = $this->matchFirstValue($this->matchArray, $this->matchValue);
+
+                break;
+            case ExcelMatch::MATCHTYPE_SMALLEST_VALUE:
+            default:
+                $valueKey = $this->matchSmallestValue($this->matchArray, $this->matchValue);
+        }
+
+        if ($valueKey !== null) {
+            return ++$valueKey;
+        }
+
+        return ExcelError::NA();
+    }
+
+    /**
+     * @param mixed $lookupValue
+     *
+     * @return mixed
+     */
+    private function matchFirstValue(array $lookupArray, $lookupValue)
+    {
+        $this->matchArray = $lookupArray;
+        $this->matchValue = $lookupValue;
+        if (is_string($this->matchValue)) {
+            $valueIsString = true;
+            $this->matchWildcard = WildcardMatch::wildcard($this->matchValue);
+        } else {
+            $valueIsString = false;
+            $this->matchWildcard = '';
+        }
+
+        $valueIsNumeric = is_int($this->matchValue) || is_float($this->matchValue);
+        foreach ($this->matchArray as $i => $lookupArrayValue) {
+            if (
+                $valueIsString
+                && is_string($lookupArrayValue)
+            ) {
+                if (WildcardMatch::compare($lookupArrayValue, $this->matchWildcard)) {
+                    return $i;
+                }
+            } else {
+                if ($lookupArrayValue === $this->matchValue) {
+                    return $i;
+                }
+                if (
+                    $valueIsNumeric
+                    && (is_float($lookupArrayValue) || is_int($lookupArrayValue))
+                    && $lookupArrayValue == $this->matchValue
+                ) {
+                    return $i;
+                }
+            }
+        }
+
+        return null;
+    }
+
+    /**
+     * @param mixed $lookupValue
+     *
+     * @return mixed
+     */
+    private function matchLargestValue(array $lookupArray, $lookupValue, array $keySet)
+    {
+        $this->matchArray = $lookupArray;
+        $this->matchValue = $lookupValue;
+        $this->matchKeys = $keySet;
+        if (is_string($this->matchValue)) {
+            if (Functions::getCompatibilityMode() === Functions::COMPATIBILITY_OPENOFFICE) {
+                $this->matchWildcard = WildcardMatch::wildcard($this->matchValue);
+                foreach (array_reverse($this->matchArray) as $i => $lookupArrayValue) {
+                    if (is_string($lookupArrayValue) && WildcardMatch::compare($lookupArrayValue, $this->matchWildcard)) {
+                        return $i;
+                    }
+                }
+            } else {
+                foreach ($this->matchArray as $i => $lookupArrayValue) {
+                    if ($lookupArrayValue === $this->matchValue) {
+                        return $this->matchKeys[$i];
+                    }
+                }
+            }
+        }
+        $valueIsNumeric = is_int($this->matchValue) || is_float($this->matchValue);
+        foreach ($this->matchArray as $i => $lookupArrayValue) {
+            if ($valueIsNumeric && (is_int($lookupArrayValue) || is_float($lookupArrayValue))) {
+                if ($lookupArrayValue <= $this->matchValue) {
+                    return array_search($i, $this->matchKeys);
+                }
+            }
+            $typeMatch = gettype($this->matchValue) === gettype($lookupArrayValue);
+            if ($typeMatch && ($lookupArrayValue <= $this->matchValue)) {
+                return array_search($i, $this->matchKeys);
+            }
+        }
+
+        return null;
+    }
+
+    /**
+     * @param mixed $lookupValue
+     *
+     * @return mixed
+     */
+    private function matchSmallestValue(array $lookupArray, $lookupValue)
+    {
+        $this->matchArray = $lookupArray;
+        $this->matchValue = $lookupValue;
+        $valueKey = null;
+        if (is_string($this->matchValue)) {
+            if (Functions::getCompatibilityMode() === Functions::COMPATIBILITY_OPENOFFICE) {
+                $this->matchWildcard = WildcardMatch::wildcard($this->matchValue);
+                foreach ($this->matchArray as $i => $lookupArrayValue) {
+                    if (is_string($lookupArrayValue) && WildcardMatch::compare($lookupArrayValue, $this->matchWildcard)) {
+                        return $i;
+                    }
+                }
+            }
+        }
+
+        $valueIsNumeric = is_int($this->matchValue) || is_float($this->matchValue);
+        foreach ($this->matchArray as $i => $lookupArrayValue) {
+            $typeMatch = gettype($this->matchValue) === gettype($lookupArrayValue);
+            $bothNumeric = $valueIsNumeric && (is_int($lookupArrayValue) || is_float($lookupArrayValue));
+
+            if ($lookupArrayValue === $this->matchValue) {
+                return $i;
+            }
+            if ($bothNumeric && $this->matchValue == $lookupArrayValue) {
+                return $i;
+            }
+            if (($typeMatch || $bothNumeric) && $lookupArrayValue >= $this->matchValue) {
+                $valueKey = $i;
+            } elseif ($typeMatch && $lookupArrayValue < $this->matchValue) {
+                break;
+            }
+        }
+
+        return $valueKey;
+    }
+
+    /**
+     * @param mixed $lookupValue
+     */
+    private function validateMatchValue($lookupValue): void
+    {
+        $this->matchArray = is_array($this->matchArray) ? $this->matchArray : [];
+        $this->matchValue = $lookupValue;
+        if ((!is_numeric($this->matchValue)) && (!is_string($this->matchValue)) && (!is_bool($this->matchValue))) {
+            throw new Exception(ExcelError::NA());
+        }
+    }
+
+    /**
+     * @param mixed $matchType
+     */
+    private function validateMatchType($matchType): int
+    {
+        $this->matchArray = is_array($this->matchArray) ? $this->matchArray : [];
+        $this->matchType = ExcelMatch::MATCHTYPE_FIRST_VALUE;
+        if (!is_numeric($matchType)) {
+            throw new Exception(ExcelError::Value());
+        }
+        if ($matchType > 0) {
+            $this->matchType = ExcelMatch::MATCHTYPE_LARGEST_VALUE;
+
+            return $this->matchType;
+        }
+        if ($matchType < 0) {
+            $this->matchType = ExcelMatch::MATCHTYPE_SMALLEST_VALUE;
+
+            return $this->matchType;
+        }
+
+        return $this->matchType;
+    }
+
+    private function validateMatchVector(array $lookupArray): void
+    {
+        $this->matchArray = $lookupArray;
+        $lookupArraySize = count($this->matchArray);
+        if ($lookupArraySize <= 0) {
+            throw new Exception(ExcelError::NA());
+        }
+    }
+
+    /**
+     * @param mixed $matchType
+     */
+    private function prepareMatchVector(array $lookupArray, $matchType): array
+    {
+        $this->matchArray = $lookupArray;
+        $this->matchType = (int) $matchType;
+        foreach ($this->matchArray as $i => $value) {
+            if ((!is_numeric($value)) && (!is_string($value)) && (!is_bool($value)) && ($value !== null)) {
+                throw new Exception(ExcelError::NA());
+            }
+            if (is_string($value)) {
+                $this->matchArray[$i] = StringHelper::strToLower($value);
+            }
+            if (
+                ($value === null) &&
+                (($this->matchType == ExcelMatch::MATCHTYPE_LARGEST_VALUE) || ($this->matchType == ExcelMatch::MATCHTYPE_SMALLEST_VALUE))
+            ) {
+                unset($this->matchArray[$i]);
+            }
+        }
+
+        return $this->matchArray;
+    }
+
+
+    /**
+     * @param mixed $row
+     * @param mixed $column
+     * @param mixed $relativity
+     * @param mixed $referenceStyle
+     * @param mixed $sheetName
+     *
+     * @return array|string
+     */
+    private function performAddress($row, $column, $relativity = 1, $referenceStyle = true, $sheetName = '')
+    {
+        $this->addressRow = $row;
+        $this->addressColumn = $column;
+        $this->addressRelativity = $relativity ?? 1;
+        $this->addressStyle = $referenceStyle ?? true;
+        $this->addressSheet = $sheetName;
+
+        if (($this->addressRow < 1) || ($this->addressColumn < 1)) {
+            return ExcelError::VALUE();
+        }
+
+        $this->addressSheet = $this->formatSheetName((string) $this->addressSheet);
+
+        if (is_int($this->addressStyle)) {
+            $this->addressStyle = (bool) $this->addressStyle;
+        }
+        if ((!is_bool($this->addressStyle)) || $this->addressStyle === Address::REFERENCE_STYLE_A1) {
+            return $this->formatAsA1((int) $this->addressRow, (int) $this->addressColumn, (int) $this->addressRelativity, (string) $this->addressSheet);
+        }
+
+        return $this->formatAsR1C1((int) $this->addressRow, (int) $this->addressColumn, (int) $this->addressRelativity, (string) $this->addressSheet);
+    }
+
+    private function formatSheetName(string $sheetName): string
+    {
+        $this->addressRow = $this->addressRow ?? 1;
+        $this->addressSheet = $sheetName;
+        if ($this->addressSheet > '') {
+            if (strpos((string) $this->addressSheet, ' ') !== false || strpos((string) $this->addressSheet, '[') !== false) {
+                $this->addressSheet = "'{$this->addressSheet}'";
+            }
+            $this->addressSheet .= '!';
+        }
+
+        return (string) $this->addressSheet;
+    }
+
+    private function formatAsA1(int $row, int $column, int $relativity, string $sheetName): string
+    {
+        $this->addressRow = $row;
+        $this->addressColumn = $column;
+        $this->addressRelativity = $relativity;
+        $this->addressSheet = $sheetName;
+        $rowRelative = $columnRelative = '$';
+        if (($this->addressRelativity == Address::ADDRESS_COLUMN_RELATIVE) || ($this->addressRelativity == Address::ADDRESS_RELATIVE)) {
+            $columnRelative = '';
+        }
+        if (($this->addressRelativity == Address::ADDRESS_ROW_RELATIVE) || ($this->addressRelativity == Address::ADDRESS_RELATIVE)) {
+            $rowRelative = '';
+        }
+        $columnName = Coordinate::stringFromColumnIndex((int) $this->addressColumn);
+
+        return "{$this->addressSheet}{$columnRelative}{$columnName}{$rowRelative}{$this->addressRow}";
+    }
+
+    private function formatAsR1C1(int $row, int $column, int $relativity, string $sheetName): string
+    {
+        $this->addressRow = $row;
+        $this->addressColumn = $column;
+        $this->addressRelativity = $relativity;
+        $this->addressSheet = $sheetName;
+        $formattedColumn = $this->addressColumn;
+        $formattedRow = $this->addressRow;
+        if (($this->addressRelativity == Address::ADDRESS_COLUMN_RELATIVE) || ($this->addressRelativity == Address::ADDRESS_RELATIVE)) {
+            $formattedColumn = "[{$formattedColumn}]";
+        }
+        if (($this->addressRelativity == Address::ADDRESS_ROW_RELATIVE) || ($this->addressRelativity == Address::ADDRESS_RELATIVE)) {
+            $formattedRow = "[{$formattedRow}]";
+        }
+        [$rowChar, $colChar] = AddressHelper::getRowAndColumnChars();
+
+        return "{$this->addressSheet}$rowChar{$formattedRow}$colChar{$formattedColumn}";
+    }
+
+    /**
+     * @param null|string $cellAddress
+     * @param mixed $rows
+     * @param mixed $columns
+     * @param mixed $height
+     * @param mixed $width
+     *
+     * @return array|int|string
+     */
+    private function performOffset($cellAddress = null, $rows = 0, $columns = 0, $height = null, $width = null, ?Cell $cell = null)
+    {
+        $offsetRows = Functions::flattenSingleValue($rows);
+        $offsetColumns = Functions::flattenSingleValue($columns);
+        $this->addressRow = $offsetRows;
+        $this->addressColumn = $offsetColumns;
+        $this->offsetHeight = Functions::flattenSingleValue($height);
+        $this->offsetWidth = Functions::flattenSingleValue($width);
+
+        if ($cellAddress === null || $cellAddress === '') {
+            return ExcelError::VALUE();
+        }
+
+        if (!is_object($cell)) {
+            return ExcelError::REF();
+        }
+
+        [$cellAddress, $worksheet] = $this->extractOffsetWorksheet($cellAddress, $cell);
+
+        $startCell = $endCell = $cellAddress;
+        if (strpos($cellAddress, ':')) {
+            [$startCell, $endCell] = explode(':', $cellAddress);
+        }
+        [$startCellColumn, $startCellRow] = Coordinate::coordinateFromString($startCell);
+        [$endCellColumn, $endCellRow] = Coordinate::coordinateFromString($endCell);
+
+        $startCellRow += $offsetRows;
+        $this->addressRow = $startCellRow;
+        $startCellColumn = Coordinate::columnIndexFromString($startCellColumn) - 1;
+        $startCellColumn += $offsetColumns;
+        $this->addressColumn = $startCellColumn;
+
+        if (($startCellRow <= 0) || ($startCellColumn < 0)) {
+            return ExcelError::REF();
+        }
+
+        $endCellColumn = $this->adjustEndCellColumnForWidth($endCellColumn, $this->offsetWidth, $startCellColumn, $offsetColumns);
+        $startCellColumn = Coordinate::stringFromColumnIndex($startCellColumn + 1);
+
+        $endCellRow = $this->adjustEndCellRowForHeight($this->offsetHeight, (int) $startCellRow, $offsetRows, $endCellRow);
+
+        if (($endCellRow <= 0) || ($endCellColumn < 0)) {
+            return ExcelError::REF();
+        }
+        $endCellColumn = Coordinate::stringFromColumnIndex($endCellColumn + 1);
+
+        $cellAddress = "{$startCellColumn}{$startCellRow}";
+        if (($startCellColumn != $endCellColumn) || ($startCellRow != $endCellRow)) {
+            $cellAddress .= ":{$endCellColumn}{$endCellRow}";
+        }
+
+        return $this->extractRequiredCells($worksheet, $cellAddress);
+    }
+
+    /** @return mixed */
+    private function extractRequiredCells(?Worksheet $worksheet, string $cellAddress)
+    {
+        $this->addressRow = $this->addressRow ?? 1;
+        $this->addressSheet = $cellAddress;
+        $range = (string) $this->addressSheet;
+
+        return Calculation::getInstance($worksheet !== null ? $worksheet->getParent() : null)
+            ->extractCellRange($range, $worksheet, false);
+    }
+
+    private function extractOffsetWorksheet(?string $cellAddress, Cell $cell): array
+    {
+        $this->addressRow = $this->addressRow ?? 1;
+        $cellAddress = $this->assessCellAddress($cellAddress ?? '', $cell);
+        $this->addressSheet = '';
+        if (strpos($cellAddress, '!') !== false) {
+            [$sheetName, $cellAddress] = Worksheet::extractSheetTitle($cellAddress, true);
+            $this->addressSheet = trim($sheetName, "'");
+        }
+
+        $worksheet = ($this->addressSheet !== '')
+            ? $cell->getWorksheet()->getParentOrThrow()->getSheetByName((string) $this->addressSheet)
+            : $cell->getWorksheet();
+
+        return [$cellAddress, $worksheet];
+    }
+
+    private function assessCellAddress(string $cellAddress, Cell $cell): string
+    {
+        $this->addressRow = $this->addressRow ?? 1;
+        $this->addressSheet = $cellAddress;
+        if (preg_match('/^' . Calculation::CALCULATION_REGEXP_DEFINEDNAME . '$/mui', (string) $this->addressSheet) !== false) {
+            $this->addressSheet = Functions::expandDefinedName((string) $this->addressSheet, $cell);
+        }
+
+        return (string) $this->addressSheet;
+    }
+
+    /**
+     * @param mixed $width
+     * @param mixed $columns
+     */
+    private function adjustEndCellColumnForWidth(string $endCellColumn, $width, int $startCellColumn, $columns): int
+    {
+        $this->addressRow = $this->addressRow ?? 1;
+        $this->addressColumn = Coordinate::columnIndexFromString($endCellColumn) - 1;
+        $this->offsetWidth = $width;
+        if (($this->offsetWidth !== null) && (!is_object($this->offsetWidth))) {
+            $this->addressColumn = $startCellColumn + (int) $this->offsetWidth - 1;
+        } else {
+            $this->addressColumn += (int) $columns;
+        }
+
+        return (int) $this->addressColumn;
+    }
+
+    /**
+     * @param mixed $height
+     * @param mixed $rows
+     * @param mixed $endCellRow
+     */
+    private function adjustEndCellRowForHeight($height, int $startCellRow, $rows, $endCellRow): int
+    {
+        $this->addressRow = $endCellRow;
+        $this->offsetHeight = $height;
+        if (($this->offsetHeight !== null) && (!is_object($this->offsetHeight))) {
+            $this->addressRow = $startCellRow + (int) $this->offsetHeight - 1;
+        } else {
+            $this->addressRow += (int) $rows;
+        }
+
+        return (int) $this->addressRow;
+    }
+
+    /**
+     * @param null|array|string $cellAddress
+     */
+    private function cellAddressNullOrWhitespace($cellAddress): bool
+    {
+        $this->addressRow = $this->addressRow ?? 1;
+        $this->addressSheet = is_array($cellAddress) ? '' : ($cellAddress ?? '');
+
+        return $cellAddress === null || (!is_array($cellAddress) && trim((string) $this->addressSheet) === '');
+    }
+
+    private function cellColumn(?Cell $cell): int
+    {
+        $this->addressRow = $this->addressRow ?? 1;
+        $this->addressColumn = ($cell !== null) ? (int) Coordinate::columnIndexFromString($cell->getColumn()) : 1;
+
+        return (int) $this->addressColumn;
+    }
+
+    /**
+     * @param null|array|string $cellAddress
+     *
+     * @return int|int[]
+     */
+    private function columnOf($cellAddress = null, ?Cell $cell = null)
+    {
+        $this->addressColumn = 1;
+        if ($this->cellAddressNullOrWhitespace($cellAddress)) {
+            return $this->cellColumn($cell);
+        }
+
+        if (is_array($cellAddress)) {
+            foreach ($cellAddress as $columnKey => $value) {
+                $columnKey = (string) preg_replace('/[^a-z]/i', '', $columnKey);
+                $this->addressColumn = (int) Coordinate::columnIndexFromString($columnKey);
+
+                return (int) $this->addressColumn;
+            }
+
+            return $this->cellColumn($cell);
+        }
+
+        $cellAddress = $cellAddress ?? '';
+        if ($cell != null) {
+            [,, $sheetName] = Helpers::extractWorksheet($cellAddress, $cell);
+            [,, $cellAddress] = Helpers::extractCellAddresses($cellAddress, true, $cell->getWorksheet(), $sheetName);
+            $this->addressSheet = $sheetName;
+        }
+        [, $cellAddress] = Worksheet::extractSheetTitle($cellAddress, true);
+        if (strpos($cellAddress, ':') !== false) {
+            [$startAddress, $endAddress] = explode(':', $cellAddress);
+            $startAddress = (string) preg_replace('/[^a-z]/i', '', $startAddress);
+            $endAddress = (string) preg_replace('/[^a-z]/i', '', $endAddress);
+
+            return range(
+                (int) Coordinate::columnIndexFromString($startAddress),
+                (int) Coordinate::columnIndexFromString($endAddress)
+            );
+        }
+
+        $cellAddress = (string) preg_replace('/[^a-z]/i', '', $cellAddress);
+        $this->addressColumn = (int) Coordinate::columnIndexFromString($cellAddress);
+
+        return (int) $this->addressColumn;
+    }
+
+    /**
+     * @param null|array|string $cellAddress
+     *
+     * @return int|string
+     */
+    private function columnsOf($cellAddress = null)
+    {
+        $this->addressRow = $this->addressRow ?? 1;
+        $this->addressColumn = 1;
+        if ($this->cellAddressNullOrWhitespace($cellAddress)) {
+            return (int) $this->addressColumn;
+        }
+        if (!is_array($cellAddress)) {
+            return ExcelError::VALUE();
+        }
+
+        reset($cellAddress);
+        $isMatrix = (is_numeric(key($cellAddress)));
+        [$columns, $rows] = Calculation::getMatrixDimensions($cellAddress);
+        $this->addressColumn = $isMatrix ? $rows : $columns;
+
+        return (int) $this->addressColumn;
+    }
+
+    private function cellRow(?Cell $cell): int
+    {
+        $this->addressRow = ($cell !== null) ? $cell->getRow() : 1;
+
+        return (int) $this->addressRow;
+    }
+
+    /**
+     * @param null|array|string $cellAddress
+     *
+     * @return int|mixed[]|string
+     */
+    private function rowOf($cellAddress = null, ?Cell $cell = null)
+    {
+        $this->addressRow = 1;
+        if ($this->cellAddressNullOrWhitespace($cellAddress)) {
+            return $this->cellRow($cell);
+        }
+
+        if (is_array($cellAddress)) {
+            foreach ($cellAddress as $rowKey => $rowValue) {
+                foreach ($rowValue as $columnKey => $cellValue) {
+                    $this->addressRow = (int) preg_replace('/\D/', '', $rowKey);
+
+                    return (int) $this->addressRow;
+                }
+            }
+
+            return $this->cellRow($cell);
+        }
+
+        $cellAddress = $cellAddress ?? '';
+        if ($cell !== null) {
+            [,, $sheetName] = Helpers::extractWorksheet($cellAddress, $cell);
+            [,, $cellAddress] = Helpers::extractCellAddresses($cellAddress, true, $cell->getWorksheet(), $sheetName);
+            $this->addressSheet = $sheetName;
+        }
+        [, $cellAddress] = Worksheet::extractSheetTitle($cellAddress, true);
+        if (strpos($cellAddress, ':') !== false) {
+            [$startAddress, $endAddress] = explode(':', $cellAddress);
+            $startAddress = (string) preg_replace('/\D/', '', $startAddress);
+            $endAddress = (string) preg_replace('/\D/', '', $endAddress);
+
+            return array_map(
+                function ($value) {
+                    return [$value];
+                },
+                range($startAddress, $endAddress)
+            );
+        }
+        [$cellAddress] = explode(':', $cellAddress);
+        $this->addressRow = (int) preg_replace('/\D/', '', $cellAddress);
+
+        return (int) $this->addressRow;
+    }
+
+    /**
+     * @param null|array|string $cellAddress
+     *
+     * @return int|string
+     */
+    private function rowsOf($cellAddress = null)
+    {
+        $this->addressRow = 1;
+        if ($this->cellAddressNullOrWhitespace($cellAddress)) {
+            return (int) $this->addressRow;
+        }
+        if (!is_array($cellAddress)) {
+            return ExcelError::VALUE();
+        }
+
+        reset($cellAddress);
+        $isMatrix = (is_numeric(key($cellAddress)));
+        [$columns, $rows] = Calculation::getMatrixDimensions($cellAddress);
+        $this->addressRow = $isMatrix ? $columns : $rows;
+
+        return (int) $this->addressRow;
+    }
+
+
+    /**
+     * @param mixed $sortArray
+     * @param mixed $sortIndex
+     * @param mixed $sortOrder
+     * @param mixed $byColumn
+     *
+     * @return mixed
+     */
+    private function performSort($sortArray, $sortIndex = 1, $sortOrder = Sort::ORDER_ASCENDING, $byColumn = false)
+    {
+        $this->sortIndex = $sortIndex;
+        $this->sortOrder = $sortOrder;
+        $this->sortByColumn = (bool) $byColumn;
+        $this->dataset = is_array($sortArray) ? $sortArray : [];
+        if (!is_array($sortArray)) {
+            return $sortArray;
+        }
+
+        $this->dataset = $this->enumerateDatasetKeys($this->dataset);
+        $lookupIndexSize = $this->sortByColumn ? count($this->dataset) : count($this->dataset[0]);
+
+        try {
+            if (is_scalar($this->sortIndex)) {
+                $this->sortIndex = [$this->sortIndex];
+                $this->sortOrder = is_scalar($this->sortOrder) ? [$this->sortOrder] : $this->sortOrder;
+            }
+            $this->sortOrder = (empty($this->sortOrder) ? [Sort::ORDER_ASCENDING] : $this->sortOrder);
+            $this->validateArrayArgumentsForSort($this->sortIndex, $this->sortOrder, $lookupIndexSize);
+        } catch (Exception $e) {
+            return $e->getMessage();
+        }
+
+        $this->dataset = array_values(array_map('array_values', $this->dataset));
+
+        return ($this->sortByColumn === true)
+            ? $this->sortDatasetByColumn($this->dataset, $this->sortIndex, $this->sortOrder)
+            : $this->sortDatasetByRow($this->dataset, $this->sortIndex, $this->sortOrder);
+    }
+
+    /**
+     * @param mixed $sortArray
+     * @param mixed $args
+     *
+     * @return mixed
+     */
+    private function performSortBy($sortArray, ...$args)
+    {
+        $this->dataset = is_array($sortArray) ? $sortArray : [];
+        $this->sortIndex = [];
+        $this->sortOrder = [];
+        if (!is_array($sortArray)) {
+            return $sortArray;
+        }
+
+        $this->dataset = $this->enumerateDatasetKeys($this->dataset);
+        $lookupArraySize = count($this->dataset);
+        $argumentCount = count($args);
+
+        try {
+            $sortBy = $sortOrder = [];
+            for ($i = 0; $i < $argumentCount; $i += 2) {
+                $sortBy[] = $this->validateSortVector($args[$i], $lookupArraySize);
+                $sortOrder[] = $this->validateSortOrder($args[$i + 1] ?? Sort::ORDER_ASCENDING);
+            }
+            $this->sortIndex = $sortBy;
+            $this->sortOrder = $sortOrder;
+        } catch (Exception $e) {
+            return $e->getMessage();
+        }
+
+        return $this->processSortBy($this->dataset, $this->sortIndex, $this->sortOrder);
+    }
+
+    private function enumerateDatasetKeys(array $sortArray): array
+    {
+        $previous = $this->dataset;
+        $this->dataset = $sortArray;
+        array_walk(
+            $this->dataset,
+            function (&$columns): void {
+                if (is_array($columns)) {
+                    $columns = array_values($columns);
+                }
+            }
+        );
+
+        $enumerated = array_values($this->dataset);
+        $this->dataset = $previous;
+
+        return $enumerated;
+    }
+
+    /**
+     * @param mixed $sortIndex
+     * @param mixed $sortOrder
+     */
+    private function validateScalarArgumentsForSort(&$sortIndex, &$sortOrder, int $sortArraySize): void
+    {
+        $this->exactlyOnce = is_array($this->dataset);
+        if (is_array($sortIndex) || is_array($sortOrder)) {
+            throw new Exception(ExcelError::VALUE());
+        }
+
+        $sortIndex = LookupRefValidations::validatePositiveInt($sortIndex, false);
+
+        if ($sortIndex > $sortArraySize) {
+            throw new Exception(ExcelError::VALUE());
+        }
+
+        $sortOrder = $this->validateSortOrder($sortOrder);
+    }
+
+    /**
+     * @param mixed $sortVector
+     */
+    private function validateSortVector($sortVector, int $sortArraySize): array
+    {
+        $previous = $this->dataset;
+        $this->dataset = is_array($sortVector) ? $sortVector : [];
+        if (!is_array($sortVector)) {
+            $this->dataset = $previous;
+            throw new Exception(ExcelError::VALUE());
+        }
+
+        $flattened = Functions::flattenArray($this->dataset);
+        $this->dataset = $previous;
+        if (count($flattened) !== $sortArraySize) {
+            throw new Exception(ExcelError::VALUE());
+        }
+
+        return $flattened;
+    }
+
+    /**
+     * @param mixed $sortOrder
+     */
+    private function validateSortOrder($sortOrder): int
+    {
+        $previous = $this->sortOrder;
+        $validated = LookupRefValidations::validateInt($sortOrder);
+        if (($validated == Sort::ORDER_ASCENDING || $validated === Sort::ORDER_DESCENDING) === false) {
+            throw new Exception(ExcelError::VALUE());
+        }
+        $this->sortOrder = $previous;
+        $this->exactlyOnce = is_array($this->dataset);
+
+        return $validated;
+    }
+
+    /**
+     * @param array $sortIndex
+     * @param mixed $sortOrder
+     */
+    private function validateArrayArgumentsForSort(&$sortIndex, &$sortOrder, int $sortArraySize): void
+    {
+        $this->dataset = is_array($this->dataset) ? $this->dataset : [];
+        $this->sortIndex = Functions::flattenArray($sortIndex);
+        $this->sortOrder = Functions::flattenArray($sortOrder);
+
+        if (
+            count($this->sortOrder) === 0 || count($this->sortOrder) > $sortArraySize ||
+            (count($this->sortOrder) > count($this->sortIndex))
+        ) {
+            throw new Exception(ExcelError::VALUE());
+        }
+
+        if (count($this->sortIndex) > count($this->sortOrder)) {
+            $this->sortOrder = array_merge(
+                $this->sortOrder,
+                array_fill(0, count($this->sortIndex) - count($this->sortOrder), array_pop($this->sortOrder))
+            );
+        }
+
+        foreach ($this->sortIndex as $key => &$value) {
+            $this->validateScalarArgumentsForSort($value, $this->sortOrder[$key], $sortArraySize);
+        }
+        $sortIndex = $this->sortIndex;
+        $sortOrder = $this->sortOrder;
+    }
+
+    private function prepareSortVectorValues(array $sortVector): array
+    {
+        $previous = $this->dataset;
+        $this->dataset = $sortVector;
+        $prepared = array_map(
+            function ($value) {
+                if (is_bool($value)) {
+                    return ($value) ? Calculation::getTRUE() : Calculation::getFALSE();
+                } elseif (is_string($value)) {
+                    return StringHelper::strToLower($value);
+                }
+
+                return $value;
+            },
+            $this->dataset
+        );
+        $this->dataset = $previous;
+
+        return $prepared;
+    }
+
+    /**
+     * @param array[] $sortIndex
+     * @param int[] $sortOrder
+     */
+    private function processSortBy(array $sortArray, array $sortIndex, $sortOrder): array
+    {
+        $this->dataset = $sortArray;
+        $this->sortIndex = $sortIndex;
+        $this->sortOrder = $sortOrder;
+        $sortArguments = [];
+        $sortData = [];
+        foreach ($this->sortIndex as $index => $sortValues) {
+            $sortData[] = $sortValues;
+            $sortArguments[] = $this->prepareSortVectorValues($sortValues);
+            $sortArguments[] = $this->sortOrder[$index] === Sort::ORDER_ASCENDING ? SORT_ASC : SORT_DESC;
+        }
+        $sortArguments = $this->applyPHP7Patch($this->dataset, $sortArguments);
+
+        $sortVector = $this->executeVectorSortQuery($sortData, $sortArguments);
+
+        return $this->sortLookupArrayFromVector($this->dataset, $sortVector);
+    }
+
+    /**
+     * @param int[] $sortIndex
+     * @param int[] $sortOrder
+     */
+    private function sortDatasetByRow(array $sortArray, array $sortIndex, array $sortOrder): array
+    {
+        $this->dataset = $sortArray;
+        $this->sortIndex = $sortIndex;
+        $this->sortOrder = $sortOrder;
+        $sortVector = $this->buildVectorForSort($this->dataset, $this->sortIndex, $this->sortOrder);
+
+        return $this->sortLookupArrayFromVector($this->dataset, $sortVector);
+    }
+
+    /**
+     * @param int[] $sortIndex
+     * @param int[] $sortOrder
+     */
+    private function sortDatasetByColumn(array $sortArray, array $sortIndex, array $sortOrder): array
+    {
+        $this->dataset = $sortArray;
+        $this->sortIndex = $sortIndex;
+        $this->sortOrder = $sortOrder;
+        $this->dataset = $this->transposeMatrix($this->dataset);
+        $result = $this->sortDatasetByRow($this->dataset, $this->sortIndex, $this->sortOrder);
+
+        return $this->transposeMatrix($result);
+    }
+
+    /**
+     * @param int[] $sortIndex
+     * @param int[] $sortOrder
+     */
+    private function buildVectorForSort(array $sortArray, array $sortIndex, array $sortOrder): array
+    {
+        $this->dataset = $sortArray;
+        $this->sortIndex = $sortIndex;
+        $this->sortOrder = $sortOrder;
+        $sortArguments = [];
+        $sortData = [];
+        foreach ($this->sortIndex as $index => $sortIndexValue) {
+            $sortValues = array_column($this->dataset, $sortIndexValue - 1);
+            $sortData[] = $sortValues;
+            $sortArguments[] = $this->prepareSortVectorValues($sortValues);
+            $sortArguments[] = $this->sortOrder[$index] === Sort::ORDER_ASCENDING ? SORT_ASC : SORT_DESC;
+        }
+        $sortArguments = $this->applyPHP7Patch($this->dataset, $sortArguments);
+
+        return $this->executeVectorSortQuery($sortData, $sortArguments);
+    }
+
+    private function executeVectorSortQuery(array $sortData, array $sortArguments): array
+    {
+        $previous = $this->dataset;
+        $this->dataset = $this->transposeMatrix($sortData);
+
+        $sortDataIndexed = [];
+        foreach ($this->dataset as $key => $value) {
+            $sortDataIndexed[Coordinate::stringFromColumnIndex($key + 1)] = $value;
+        }
+        $this->dataset = $previous;
+
+        $sortArguments[] = &$sortDataIndexed;
+
+        array_multisort(...$sortArguments);
+
+        $sortedData = [];
+        foreach (array_keys($sortDataIndexed) as $key) {
+            $sortedData[] = Coordinate::columnIndexFromString($key) - 1;
+        }
+
+        return $sortedData;
+    }
+
+    private function sortLookupArrayFromVector(array $sortArray, array $sortVector): array
+    {
+        $this->dataset = $sortArray;
+        $sortedArray = [];
+        foreach ($sortVector as $index) {
+            $sortedArray[] = $this->dataset[$index];
+        }
+
+        return $sortedArray;
+    }
+
+    private function applyPHP7Patch(array $sortArray, array $sortArguments): array
+    {
+        $previous = $this->dataset;
+        $this->dataset = $sortArray;
+        if (PHP_VERSION_ID < 80000) {
+            $sortArguments[] = range(1, count($this->dataset));
+            $sortArguments[] = SORT_ASC;
+        }
+        $this->dataset = $previous;
+
+        return $sortArguments;
+    }
+
+    /**
+     * @param mixed $lookupVector
+     * @param mixed $byColumn
+     * @param mixed $exactlyOnce
+     *
+     * @return mixed
+     */
+    private function performUnique($lookupVector, $byColumn = false, $exactlyOnce = false)
+    {
+        $this->dataset = is_array($lookupVector) ? $lookupVector : [];
+        $this->sortByColumn = (bool) $byColumn;
+        $this->exactlyOnce = (bool) $exactlyOnce;
+        if (!is_array($lookupVector)) {
+            return $lookupVector;
+        }
+
+        return ($this->sortByColumn === true)
+            ? $this->uniqueByColumn($this->dataset, $this->exactlyOnce)
+            : $this->uniqueByRow($this->dataset, $this->exactlyOnce);
+    }
+
+    /**
+     * @return mixed
+     */
+    private function uniqueByRow(array $lookupVector, bool $exactlyOnce)
+    {
+        $this->dataset = $lookupVector;
+        $this->exactlyOnce = $exactlyOnce;
+        array_walk(
+            $this->dataset,
+            function (array &$value): void {
+                $value = implode(chr(0x00), $value);
+            }
+        );
+
+        $result = $this->countValuesCaseInsensitive($this->dataset);
+
+        if ($this->exactlyOnce === true) {
+            $result = $this->exactlyOnceFilter($result);
+        }
+
+        if (count($result) === 0) {
+            return ExcelError::CALC();
+        }
+
+        $result = array_keys($result);
+
+        array_walk(
+            $result,
+            function (string &$value): void {
+                $value = explode(chr(0x00), $value);
+            }
+        );
+
+        return (count($result) === 1) ? array_pop($result) : $result;
+    }
+
+    /**
+     * @return mixed
+     */
+    private function uniqueByColumn(array $lookupVector, bool $exactlyOnce)
+    {
+        $this->dataset = $lookupVector;
+        $this->exactlyOnce = $exactlyOnce;
+        $flattenedLookupVector = Functions::flattenArray($this->dataset);
+
+        if (count($this->dataset, COUNT_RECURSIVE) > count($flattenedLookupVector, COUNT_RECURSIVE) + 1) {
+            $transpose = $this->transposeMatrix($this->dataset);
+            $result = $this->uniqueByRow($transpose, $this->exactlyOnce);
+
+            return (is_array($result)) ? $this->transposeMatrix($result) : $result;
+        }
+
+        $result = $this->countValuesCaseInsensitive($flattenedLookupVector);
+
+        if ($this->exactlyOnce === true) {
+            $result = $this->exactlyOnceFilter($result);
+        }
+
+        if (count($result) === 0) {
+            return ExcelError::CALC();
+        }
+
+        return array_keys($result);
+    }
+
+    private function countValuesCaseInsensitive(array $caseSensitiveLookupValues): array
+    {
+        $previous = $this->dataset;
+        $this->dataset = $caseSensitiveLookupValues;
+        $caseInsensitiveCounts = array_count_values(
+            array_map(
+                function (string $value) {
+                    return StringHelper::strToUpper($value);
+                },
+                $this->dataset
+            )
+        );
+
+        $caseSensitiveCounts = [];
+        foreach ($caseInsensitiveCounts as $caseInsensitiveKey => $count) {
+            if (is_numeric($caseInsensitiveKey)) {
+                $caseSensitiveCounts[$caseInsensitiveKey] = $count;
+            } else {
+                foreach ($this->dataset as $caseSensitiveValue) {
+                    if ($caseInsensitiveKey === StringHelper::strToUpper($caseSensitiveValue)) {
+                        $caseSensitiveCounts[$caseSensitiveValue] = $count;
+
+                        break;
+                    }
+                }
+            }
+        }
+        $this->dataset = $previous;
+
+        return $caseSensitiveCounts;
+    }
+
+    private function exactlyOnceFilter(array $values): array
+    {
+        $previous = $this->dataset;
+        $this->dataset = $values;
+        $filtered = array_filter(
+            $this->dataset,
+            function ($value) {
+                return $value === 1;
+            }
+        );
+        $this->dataset = $previous;
+
+        return $filtered;
+    }
+
+    /**
+     * @param mixed $lookupArray
+     * @param mixed $matchArray
+     * @param mixed $ifEmpty
+     *
+     * @return mixed
+     */
+    private function performFilter($lookupArray, $matchArray, $ifEmpty = null)
+    {
+        $this->dataset = is_array($lookupArray) ? $lookupArray : [];
+        $this->sortIndex = is_array($matchArray) ? $matchArray : [];
+        if (!is_array($matchArray)) {
+            return ExcelError::VALUE();
+        }
+
+        $lookup = $this->dataset;
+        $this->sortIndex = $this->enumerateDatasetKeys($this->sortIndex);
+        $this->dataset = $lookup;
+
+        $result = (self::isColumnVector($this->sortIndex))
+            ? $this->filterByRow($this->dataset, $this->sortIndex)
+            : $this->filterByColumn($this->dataset, $this->sortIndex);
+
+        if (empty($result)) {
+            return $ifEmpty ?? ExcelError::CALC();
+        }
+
+        return array_values(array_map('array_values', $result));
+    }
+
+    private function filterByRow(array $lookupArray, array $matchArray): array
+    {
+        $this->dataset = $lookupArray;
+        $this->sortIndex = array_values(array_column($matchArray, 0));
+
+        return array_filter(
+            array_values($this->dataset),
+            function ($index) {
+                return (bool) $this->sortIndex[$index];
+            },
+            ARRAY_FILTER_USE_KEY
+        );
+    }
+
+    private function filterByColumn(array $lookupArray, array $matchArray): array
+    {
+        $this->dataset = $this->transposeMatrix($lookupArray);
+        $this->sortIndex = $matchArray;
+
+        if (count($this->sortIndex) === 1) {
+            $this->sortIndex = array_pop($this->sortIndex);
+        }
+
+        array_walk(
+            $this->sortIndex,
+            function (&$value): void {
+                $value = [$value];
+            }
+        );
+
+        $result = $this->filterByRow($this->dataset, $this->sortIndex);
+
+        return $this->transposeMatrix($result);
     }
 }
