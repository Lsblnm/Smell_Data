+func (r *Replacer) lookupHTTPTLS(key string) (any, bool) {
+	req := r.httpReq
+	if req == nil || req.TLS == nil {
+		return nil, false
+	}
+	if len(key) < len(httpTLSPrefix) {
+		return nil, false
+	}
+
+	field := strings.ToLower(key[len(httpTLSPrefix):])
+	if strings.HasPrefix(field, "client.") {
+		return r.lookupHTTPTLSClient(field)
+	}
+
+	switch field {
+	case "version":
+		return r.tlsProtocolName(req.TLS.Version), true
+	case "cipher_suite":
+		return tls.CipherSuiteName(req.TLS.CipherSuite), true
+	case "resumed":
+		return req.TLS.DidResume, true
+	case "proto":
+		return req.TLS.NegotiatedProtocol, true
+	case "proto_mutual":
+		return true, true
+	case "server_name":
+		return req.TLS.ServerName, true
+	}
+	return nil, false
+}
