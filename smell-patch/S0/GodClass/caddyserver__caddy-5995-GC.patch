+func (r *Replacer) lookupHTTPTLSClient(field string) (any, bool) {
+	cert := r.tlsPeerCert
+	if cert == nil {
+		req := r.httpReq
+		if req != nil && req.TLS != nil && len(req.TLS.PeerCertificates) > 0 {
+			cert = req.TLS.PeerCertificates[0]
+		}
+	}
+	if cert == nil {
+		return nil, false
+	}
+
+	if strings.HasPrefix(field, "client.san.") {
+		return r.lookupHTTPTLSSAN(cert, field[len("client.san."):])
+	}
+
+	switch field {
+	case "client.fingerprint":
+		return fmt.Sprintf("%x", sha256.Sum256(cert.Raw)), true
+	case "client.public_key", "client.public_key_sha256":
+		if cert.PublicKey == nil {
+			return nil, true
+		}
+		pubKeyBytes, err := r.marshalBoundPublicKey(cert.PublicKey)
+		if err != nil {
+			return nil, true
+		}
+		if strings.HasSuffix(field, "_sha256") {
+			return fmt.Sprintf("%x", sha256.Sum256(pubKeyBytes)), true
+		}
+		return fmt.Sprintf("%x", pubKeyBytes), true
+	case "client.issuer":
+		return cert.Issuer, true
+	case "client.serial":
+		return cert.SerialNumber, true
+	case "client.subject":
+		return cert.Subject, true
+	case "client.certificate_pem":
+		block := pem.Block{Type: "CERTIFICATE", Bytes: cert.Raw}
+		return pem.EncodeToMemory(&block), true
+	case "client.certificate_der_base64":
+		return base64.StdEncoding.EncodeToString(cert.Raw), true
+	default:
+		return nil, false
+	}
+}
+
+func (r *Replacer) lookupHTTPTLSSAN(cert *x509.Certificate, field string) (any, bool) {
+	if r.httpReq == nil {
+		return nil, false
+	}
+	var fieldName string
+	var fieldValue any
+	switch {
+	case strings.HasPrefix(field, "dns_names"):
+		fieldName = "dns_names"
+		fieldValue = cert.DNSNames
+	case strings.HasPrefix(field, "emails"):
+		fieldName = "emails"
+		fieldValue = cert.EmailAddresses
+	case strings.HasPrefix(field, "ips"):
+		fieldName = "ips"
+		fieldValue = cert.IPAddresses
+	case strings.HasPrefix(field, "uris"):
+		fieldName = "uris"
+		fieldValue = cert.URIs
+	default:
+		return nil, false
+	}
+	field = field[len(fieldName):]
+	if field == "" {
+		return fieldValue, true
+	}
+	if len(field) < 2 || field[0] != '.' {
+		return nil, false
+	}
+	field = field[1:]
+	idx, err := strconv.Atoi(field)
+	if err != nil || idx < 0 {
+		return nil, false
+	}
+	switch v := fieldValue.(type) {
+	case []string:
+		if idx >= len(v) {
+			return nil, true
+		}
+		return v[idx], true
+	case []net.IP:
+		if idx >= len(v) {
+			return nil, true
+		}
+		return v[idx], true
+	case []*url.URL:
+		if idx >= len(v) {
+			return nil, true
+		}
+		return v[idx], true
+	}
+	return nil, false
+}
+
+func (r *Replacer) marshalBoundPublicKey(pubKey any) ([]byte, error) {
+	switch key := pubKey.(type) {
+	case *rsa.PublicKey:
+		return asn1.Marshal(key)
+	case *ecdsa.PublicKey:
+		return elliptic.Marshal(key.Curve, key.X, key.Y), nil
+	case ed25519.PublicKey:
+		return key, nil
+	}
+	return nil, fmt.Errorf("unrecognized public key type: %T", pubKey)
+}
+
+func (r *Replacer) tlsProtocolName(id uint16) string {
+	switch id {
+	case tls.VersionTLS13:
+		return "tls1.3"
+	case tls.VersionTLS12:
+		return "tls1.2"
+	case tls.VersionTLS11:
+		return "tls1.1"
+	case tls.VersionTLS10:
+		return "tls1.0"
+	case 0x0300:
+		return "ssl3.0"
+	default:
+		return fmt.Sprintf("0x%04x", id)
+	}
+}
+
+// ApplyHTTPRewrite applies HTTP URI rewrite operations to req.
+func (r *Replacer) ApplyHTTPRewrite(req *http.Request, spec HTTPRewriteSpec) bool {
+	r.rewriteSpec = spec
+	if req == nil {
+		return false
+	}
+	oldMethod := req.Method
+	oldURI := req.RequestURI
+
+	r.applyRewriteMethod(req)
+	r.applyRewriteURIComponents(req)
+	r.applyRewriteStripPrefix(req)
+	r.applyRewriteStripSuffix(req)
+	r.applyRewriteSubstrings(req)
+	r.applyRewritePathRegexps(req)
+
+	req.RequestURI = req.URL.RequestURI()
+	return req.Method != oldMethod || req.RequestURI != oldURI
+}
+
+func (r *Replacer) applyRewriteMethod(req *http.Request) {
+	if r.rewriteSpec.Method == "" || req == nil {
+		return
+	}
+	req.Method = strings.ToUpper(r.ReplaceAll(r.rewriteSpec.Method, ""))
+}
+
+func (r *Replacer) applyRewriteURIComponents(req *http.Request) {
+	uri := r.rewriteSpec.URI
+	if uri == "" || req == nil || req.URL == nil {
+		return
+	}
+
+	pathStart, qsStart, fragStart := -1, -1, -1
+	pathEnd, qsEnd := -1, -1
+loop:
+	for i, ch := range uri {
+		switch {
+		case ch == '?' && qsStart < 0:
+			pathEnd, qsStart = i, i+1
+		case ch == '#' && fragStart < 0:
+			if qsStart < 0 {
+				pathEnd = i
+			} else {
+				qsEnd = i
+			}
+			fragStart = i + 1
+			break loop
+		case pathStart < 0 && qsStart < 0:
+			pathStart = i
+		}
+	}
+	if pathStart >= 0 && pathEnd < 0 {
+		pathEnd = len(uri)
+	}
+	if qsStart >= 0 && qsEnd < 0 {
+		qsEnd = len(uri)
+	}
+
+	var pathPart, query, frag string
+	if pathStart > -1 {
+		pathPart = uri[pathStart:pathEnd]
+	}
+	if qsStart > -1 {
+		query = uri[qsStart:qsEnd]
+	}
+	if fragStart > -1 {
+		frag = uri[fragStart:]
+	}
+
+	var newPath, newQuery, newFrag string
+	if pathPart != "" {
+		pathPlaceholder := "{http.request.uri.path}"
+		if strings.Contains(pathPart, pathPlaceholder) {
+			pathPart = strings.ReplaceAll(pathPart, pathPlaceholder, req.URL.EscapedPath())
+		}
+		newPath = r.ReplaceAll(pathPart, "")
+	}
+
+	if before, after, found := strings.Cut(newPath, "?"); found {
+		var injectedQuery string
+		newPath, injectedQuery = before, after
+		if query == "" {
+			query = injectedQuery
+		}
+	}
+
+	if query != "" {
+		newQuery = r.buildRewriteQueryString(query)
+	}
+	if frag != "" {
+		newFrag = r.ReplaceAll(frag, "")
+	}
+
+	if pathStart >= 0 {
+		if unescaped, err := url.PathUnescape(newPath); err != nil {
+			req.URL.Path = newPath
+		} else {
+			req.URL.Path = unescaped
+		}
+	}
+	if qsStart >= 0 {
+		req.URL.RawQuery = newQuery
+	}
+	if fragStart >= 0 {
+		req.URL.Fragment = newFrag
+	}
+}
+
+func (r *Replacer) applyRewriteStripPrefix(req *http.Request) {
+	if r.rewriteSpec.StripPathPrefix == "" || req == nil {
+		return
+	}
+	prefix := r.ReplaceAll(r.rewriteSpec.StripPathPrefix, "")
+	mergeSlashes := !strings.Contains(prefix, "//")
+	r.changeRequestPath(req, func(escapedPath string) string {
+		escapedPath = r.cleanHTTPPath(escapedPath, mergeSlashes)
+		return r.trimRewritePathPrefix(escapedPath, prefix)
+	})
+}
+
+func (r *Replacer) applyRewriteStripSuffix(req *http.Request) {
+	if r.rewriteSpec.StripPathSuffix == "" || req == nil {
+		return
+	}
+	suffix := r.ReplaceAll(r.rewriteSpec.StripPathSuffix, "")
+	mergeSlashes := !strings.Contains(suffix, "//")
+	r.changeRequestPath(req, func(escapedPath string) string {
+		escapedPath = r.cleanHTTPPath(escapedPath, mergeSlashes)
+		return r.reverseRewritePath(r.trimRewritePathPrefix(r.reverseRewritePath(escapedPath), r.reverseRewritePath(suffix)))
+	})
+}
+
+func (r *Replacer) applyRewriteSubstrings(req *http.Request) {
+	if req == nil {
+		return
+	}
+	for _, rep := range r.rewriteSpec.Substrings {
+		r.rewriteFind = rep.Find
+		r.rewriteRepl = rep.Replace
+		r.rewriteLimit = rep.Limit
+		r.ApplyURISubstring(req, rep)
+	}
+}
+
+func (r *Replacer) applyRewritePathRegexps(req *http.Request) {
+	if req == nil {
+		return
+	}
+	for _, rep := range r.rewriteSpec.PathRegexps {
+		r.rewriteFind = rep.Find
+		r.rewriteRepl = rep.Replace
+		r.rewriteRegex = rep.Pattern
+		r.ApplyURIRegexp(req, rep)
+	}
+}
+
+// ApplyURISubstring performs a substring replacement on the request URI.
+func (r *Replacer) ApplyURISubstring(req *http.Request, rep URISubstringRewrite) {
+	r.rewriteFind = rep.Find
+	r.rewriteRepl = rep.Replace
+	r.rewriteLimit = rep.Limit
+	if req == nil || (r.rewriteFind == "" && len(r.rewriteSpec.Substrings) == 0) {
+		return
+	}
+	if r.rewriteFind == "" {
+		return
+	}
+
+	lim := r.rewriteLimit
+	if lim == 0 {
+		lim = -1
+	}
+
+	find := r.ReplaceAll(r.rewriteFind, "")
+	replace := r.ReplaceAll(r.rewriteRepl, "")
+	mergeSlashes := !strings.Contains(rep.Find, "//")
+
+	r.changeRequestPath(req, func(pathOrRawPath string) string {
+		return strings.Replace(r.cleanHTTPPath(pathOrRawPath, mergeSlashes), find, replace, lim)
+	})
+	req.URL.RawQuery = strings.Replace(req.URL.RawQuery, find, replace, lim)
+}
+
+// ApplyURIRegexp performs a regular expression replacement on the request URI path.
+func (r *Replacer) ApplyURIRegexp(req *http.Request, rep URIRegexpRewrite) {
+	r.rewriteFind = rep.Find
+	r.rewriteRepl = rep.Replace
+	r.rewriteRegex = rep.Pattern
+	if req == nil || (r.rewriteRegex == nil && len(r.rewriteSpec.PathRegexps) == 0) {
+		return
+	}
+	if r.rewriteFind == "" || r.rewriteRegex == nil {
+		return
+	}
+	replace := r.ReplaceAll(r.rewriteRepl, "")
+	r.changeRequestPath(req, func(pathOrRawPath string) string {
+		return r.rewriteRegex.ReplaceAllString(pathOrRawPath, replace)
+	})
+}
+
+func (r *Replacer) buildRewriteQueryString(qs string) string {
+	if r.rewriteSpec.URI == "" && qs == "" {
+		return ""
+	}
+	var sb strings.Builder
+	wroteVal := true
+
+	for len(qs) > 0 {
+		nextEq, nextAmp := strings.Index(qs, "="), strings.Index(qs, "&")
+		ampIsNext := nextAmp >= 0 && (nextAmp < nextEq || nextEq < 0)
+		end := len(qs)
+		if ampIsNext {
+			end = nextAmp
+		} else if nextEq >= 0 && (nextEq < nextAmp || nextAmp < 0) {
+			end = nextEq
+		}
+
+		comp := qs[:end]
+		comp, _ = r.ReplaceFunc(comp, func(name string, val any) (any, error) {
+			if name == "http.request.uri.query" && wroteVal {
+				return val, nil
+			}
+			var valStr string
+			switch v := val.(type) {
+			case string:
+				valStr = v
+			case fmt.Stringer:
+				valStr = v.String()
+			case int:
+				valStr = strconv.Itoa(v)
+			default:
+				valStr = fmt.Sprintf("%+v", v)
+			}
+			return url.QueryEscape(valStr), nil
+		})
+		if end < len(qs) {
+			end++
+		}
+		qs = qs[end:]
+
+		if wroteVal {
+			if sb.Len() > 0 && len(comp) > 0 {
+				sb.WriteRune('&')
+			}
+		} else {
+			sb.WriteRune('=')
+		}
+		sb.WriteString(comp)
+		wroteVal = ampIsNext
+	}
+
+	return sb.String()
+}
+
+func (r *Replacer) changeRequestPath(req *http.Request, newVal func(pathOrRawPath string) string) {
+	if req == nil || req.URL == nil {
+		return
+	}
+	req.URL.RawPath = newVal(req.URL.EscapedPath())
+	if p, err := url.PathUnescape(req.URL.RawPath); err == nil && p != "" {
+		req.URL.Path = p
+	} else {
+		req.URL.Path = newVal(req.URL.Path)
+	}
+	if req.URL.RawPath == req.URL.Path {
+		req.URL.RawPath = ""
+	}
+}
+
+func (r *Replacer) cleanHTTPPath(p string, collapseSlashes bool) string {
+	if collapseSlashes {
+		return r.cleanHTTPPathPreserveSlash(p)
+	}
+	const tmpCh = 0xff
+	var sb strings.Builder
+	for i, ch := range p {
+		if ch == '/' && i > 0 && p[i-1] == '/' {
+			sb.WriteByte(tmpCh)
+		}
+		sb.WriteRune(ch)
+	}
+	halfCleaned := r.cleanHTTPPathPreserveSlash(sb.String())
+	return strings.ReplaceAll(halfCleaned, string([]byte{tmpCh}), "")
+}
+
+func (r *Replacer) cleanHTTPPathPreserveSlash(p string) string {
+	cleaned := path.Clean(p)
+	if cleaned != "/" && strings.HasSuffix(p, "/") {
+		cleaned = cleaned + "/"
+	}
+	return cleaned
+}
+
+func (r *Replacer) trimRewritePathPrefix(escapedPath, prefix string) string {
+	var iPath, iPrefix int
+	for {
+		if iPath >= len(escapedPath) || iPrefix >= len(prefix) {
+			break
+		}
+
+		prefixCh := prefix[iPrefix]
+		ch := string(escapedPath[iPath])
+
+		if ch == "%" && prefixCh != '%' && len(escapedPath) >= iPath+3 {
+			var err error
+			ch, err = url.PathUnescape(escapedPath[iPath : iPath+3])
+			if err != nil {
+				return escapedPath
+			}
+			iPath += 2
+		}
+
+		if !strings.EqualFold(ch, string(prefixCh)) {
+			return escapedPath
+		}
+
+		iPath++
+		iPrefix++
+	}
+
+	if iPath >= len(prefix) {
+		return escapedPath[iPath:]
+	}
+	return escapedPath
+}
+
+func (r *Replacer) reverseRewritePath(s string) string {
+	rr := []rune(s)
+	for i, j := 0, len(rr)-1; i < len(rr)/2; i, j = i+1, j-1 {
+		rr[i], rr[j] = rr[j], rr[i]
+	}
+	return string(rr)
+}
+
+// ApplyHeaderOps applies header add/set/delete/replace operations.
+func (r *Replacer) ApplyHeaderOps(hdr http.Header, spec HeaderOpSpec) {
+	r.headerSpec = spec
+	if hdr == nil {
+		return
+	}
+	r.applyHeaderDeletesAll(hdr)
+	r.applyHeaderAdds(hdr)
+	r.applyHeaderSets(hdr)
+	r.applyHeaderDeletes(hdr)
+	r.applyHeaderReplacements(hdr)
+}
+
+func (r *Replacer) applyHeaderDeletesAll(hdr http.Header) {
+	for _, fieldName := range r.headerSpec.Delete {
+		r.headerName = r.ReplaceKnown(fieldName, "")
+		if r.headerName == "*" {
+			for existingField := range hdr {
+				delete(hdr, existingField)
+			}
+		}
+	}
+}
+
+func (r *Replacer) applyHeaderAdds(hdr http.Header) {
+	for fieldName, vals := range r.headerSpec.Add {
+		r.headerName = r.ReplaceKnown(fieldName, "")
+		for _, v := range vals {
+			r.headerValue = r.ReplaceKnown(v, "")
+			hdr.Add(r.headerName, r.headerValue)
+		}
+	}
+}
+
+func (r *Replacer) applyHeaderSets(hdr http.Header) {
+	for fieldName, vals := range r.headerSpec.Set {
+		r.headerName = r.ReplaceKnown(fieldName, "")
+		var newVals []string
+		for i := range vals {
+			newVals = append(newVals, r.ReplaceKnown(vals[i], ""))
+		}
+		r.headerValue = strings.Join(newVals, ",")
+		hdr.Set(r.headerName, r.headerValue)
+	}
+}
+
+func (r *Replacer) applyHeaderDeletes(hdr http.Header) {
+	for _, fieldName := range r.headerSpec.Delete {
+		r.headerName = strings.ToLower(r.ReplaceKnown(fieldName, ""))
+		if r.headerName == "*" {
+			continue
+		}
+		switch {
+		case strings.HasPrefix(r.headerName, "*") && strings.HasSuffix(r.headerName, "*"):
+			needle := r.headerName[1 : len(r.headerName)-1]
+			for existingField := range hdr {
+				if strings.Contains(strings.ToLower(existingField), needle) {
+					delete(hdr, existingField)
+				}
+			}
+		case strings.HasPrefix(r.headerName, "*"):
+			suffix := r.headerName[1:]
+			for existingField := range hdr {
+				if strings.HasSuffix(strings.ToLower(existingField), suffix) {
+					delete(hdr, existingField)
+				}
+			}
+		case strings.HasSuffix(r.headerName, "*"):
+			prefix := r.headerName[:len(r.headerName)-1]
+			for existingField := range hdr {
+				if strings.HasPrefix(strings.ToLower(existingField), prefix) {
+					delete(hdr, existingField)
+				}
+			}
+		default:
+			hdr.Del(r.headerName)
+		}
+	}
+}
+
+func (r *Replacer) applyHeaderReplacements(hdr http.Header) {
+	for fieldName, replacements := range r.headerSpec.Replace {
+		r.headerName = http.CanonicalHeaderKey(r.ReplaceKnown(fieldName, ""))
+		if r.headerName == "*" {
+			r.replaceAllHeaderValues(hdr, replacements)
+			continue
+		}
+		r.replaceNamedHeaderValues(hdr, replacements)
+	}
+}
+
+func (r *Replacer) replaceAllHeaderValues(hdr http.Header, replacements []HeaderFieldReplacement) {
+	for _, rep := range replacements {
+		r.headerSearch = r.ReplaceKnown(rep.Search, "")
+		r.headerReplace = r.ReplaceKnown(rep.Replace, "")
+		r.headerPattern = rep.Pattern
+		for fieldName, vals := range hdr {
+			for i := range vals {
+				if r.headerPattern != nil {
+					hdr[fieldName][i] = r.headerPattern.ReplaceAllString(hdr[fieldName][i], r.headerReplace)
+				} else {
+					hdr[fieldName][i] = strings.ReplaceAll(hdr[fieldName][i], r.headerSearch, r.headerReplace)
+				}
+			}
+		}
+	}
+}
+
+func (r *Replacer) replaceNamedHeaderValues(hdr http.Header, replacements []HeaderFieldReplacement) {
+	for _, rep := range replacements {
+		r.headerSearch = r.ReplaceKnown(rep.Search, "")
+		r.headerReplace = r.ReplaceKnown(rep.Replace, "")
+		r.headerPattern = rep.Pattern
+		for hdrFieldName, vals := range hdr {
+			if http.CanonicalHeaderKey(hdrFieldName) != r.headerName {
+				continue
+			}
+			for i := range vals {
+				if r.headerPattern != nil {
+					hdr[hdrFieldName][i] = r.headerPattern.ReplaceAllString(hdr[hdrFieldName][i], r.headerReplace)
+				} else {
+					hdr[hdrFieldName][i] = strings.ReplaceAll(hdr[hdrFieldName][i], r.headerSearch, r.headerReplace)
+				}
+			}
+		}
+	}
+}
+
+// ParseLogLevel evaluates a log level string, replacing placeholders first.
+func (r *Replacer) ParseLogLevel(levelInput string) (zapcore.LevelEnabler, error) {
+	r.logLevelInput = levelInput
+	return r.parseBoundLogLevel()
+}
+
+func (r *Replacer) parseBoundLogLevel() (zapcore.LevelEnabler, error) {
+	level, err := r.ReplaceOrErr(r.logLevelInput, true, true)
+	if err != nil {
+		return nil, fmt.Errorf("invalid log level: %v", err)
+	}
+	r.logLevelName = strings.ToLower(level)
+	return r.mapBoundLogLevel()
+}
+
+func (r *Replacer) mapBoundLogLevel() (zapcore.LevelEnabler, error) {
+	switch r.logLevelName {
+	case "debug":
+		return zapcore.DebugLevel, nil
+	case "", "info":
+		return zapcore.InfoLevel, nil
+	case "warn":
+		return zapcore.WarnLevel, nil
+	case "error":
+		return zapcore.ErrorLevel, nil
+	case "panic":
+		return zapcore.PanicLevel, nil
+	case "fatal":
+		return zapcore.FatalLevel, nil
+	default:
+		return nil, fmt.Errorf("unrecognized log level: %s", r.logLevelName)
+	}
+}
+
+// LogNamespaceAllowed reports whether a logger name may emit to the given include/exclude lists.
+func (r *Replacer) LogNamespaceAllowed(include, exclude []string, name string, isModule bool) bool {
+	r.logInclude = include
+	r.logExclude = exclude
+	return r.allowedBoundLogNamespace(name, isModule)
+}
+
+func (r *Replacer) allowedBoundLogNamespace(name string, isModule bool) bool {
+	if len(r.logInclude) == 0 && len(r.logExclude) == 0 {
+		return true
+	}
+	if name != "" && name != "*" && name != "." {
+		name += "."
+	}
+	longestAccept := r.longestLogAccept(name, isModule)
+	if len(r.logInclude) > 0 && longestAccept == 0 {
+		return false
+	}
+	longestReject := r.longestLogReject(name)
+	if len(r.logExclude) > 0 && longestReject > longestAccept {
+		return false
+	}
+	return (longestAccept > longestReject) ||
+		(len(r.logInclude) == 0 && longestReject == 0)
+}
+
+func (r *Replacer) longestLogAccept(name string, isModule bool) int {
+	var longestAccept int
+	for _, namespace := range r.logInclude {
+		var hasPrefix bool
+		if isModule {
+			hasPrefix = strings.HasPrefix(namespace+".", name)
+		} else {
+			hasPrefix = strings.HasPrefix(name, namespace+".")
+		}
+		if hasPrefix && len(namespace) > longestAccept {
+			longestAccept = len(namespace)
+		}
+	}
+	return longestAccept
+}
+
+func (r *Replacer) longestLogReject(name string) int {
+	var longestReject int
+	for _, namespace := range r.logExclude {
+		if (namespace == "*" && name != ".") ||
+			(namespace == "." && name == ".") {
+			return 1 << 30
+		}
+		if strings.HasPrefix(name, namespace+".") &&
+			len(namespace) > longestReject {
+			longestReject = len(namespace)
+		}
+	}
+	return longestReject
+}
+
+// BindImportArgs attaches Caddyfile import argument placeholders to the Replacer.
+func (r *Replacer) BindImportArgs(args []string) {
+	r.importArgs = append([]string(nil), args...)
+	r.Map(r.lookupImportArg)
+}
+
+func (r *Replacer) lookupImportArg(key string) (any, bool) {
+	r.importKey = key
+	if val, ok := r.lookupDeprecatedImportArg(); ok {
+		return val, true
+	}
+	return r.lookupIndexedImportArg()
+}
