+func (r *Replacer) lookupHTTPRemotePrefix(key string) (any, bool) {
+	req := r.httpReq
+	if req == nil {
+		return "", true
+	}
+	host, _, err := net.SplitHostPort(req.RemoteAddr)
+	if err != nil {
+		host = req.RemoteAddr
+	}
+	addr, err := netip.ParseAddr(host)
+	if err != nil {
+		return host, true
+	}
+	bitsBoth := key[strings.Index(key, "/")+1:]
+	ipv4BitsStr, ipv6BitsStr, cutOK := strings.Cut(bitsBoth, ",")
+	bitsStr := ipv4BitsStr
+	if addr.Is6() && cutOK {
+		bitsStr = ipv6BitsStr
+	}
+	bits, err := strconv.Atoi(bitsStr)
+	if err != nil {
+		return "", true
+	}
+	prefix, err := addr.Prefix(bits)
+	if err != nil {
+		return "", true
+	}
+	return prefix.String(), true
+}
+
+func (r *Replacer) lookupHTTPHostLabels(key string) (any, bool) {
+	req := r.httpReq
+	if req == nil {
+		return "", false
+	}
+	idxStr := key[len(httpHostLabelsPrefix):]
+	idx, err := strconv.Atoi(idxStr)
+	if err != nil || idx < 0 {
+		return "", false
+	}
+	reqHost, _, err := net.SplitHostPort(req.Host)
+	if err != nil {
+		reqHost = req.Host
+	}
+	hostLabels := strings.Split(reqHost, ".")
+	if idx >= len(hostLabels) {
+		return "", true
+	}
+	return hostLabels[len(hostLabels)-idx-1], true
+}
