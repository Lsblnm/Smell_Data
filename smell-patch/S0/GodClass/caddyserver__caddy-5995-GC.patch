+func (r *Replacer) lookupDeprecatedImportArg() (any, bool) {
+	key := r.importKey
+	matches := importArgsIndexDeprecated.FindStringSubmatch(key)
+	if len(matches) == 0 {
+		return nil, false
+	}
+	if matches[0] != key {
+		return nil, false
+	}
+	value, err := strconv.Atoi(matches[1])
+	if err != nil {
+		Log().Named("caddyfile").Warn(
+			"Placeholder {args." + matches[1] + "} has an invalid index")
+		return nil, false
+	}
+	if value >= len(r.importArgs) {
+		Log().Named("caddyfile").Warn(
+			"Placeholder {args." + matches[1] + "} index is out of bounds, only " + strconv.Itoa(len(r.importArgs)) + " argument(s) exist")
+		return nil, false
+	}
+	Log().Named("caddyfile").Warn(
+		"Placeholder {args." + matches[1] + "} deprecated, use {args[" + matches[1] + "]} instead")
+	return r.importArgs[value], true
+}
+
+func (r *Replacer) lookupIndexedImportArg() (any, bool) {
+	key := r.importKey
+	matches := importArgsIndex.FindStringSubmatch(key)
+	if len(matches) == 0 {
+		return nil, false
+	}
+	if matches[0] != key {
+		return nil, false
+	}
+	if strings.Contains(matches[1], ":") {
+		Log().Named("caddyfile").Warn(
+			"Variadic placeholder {args[" + matches[1] + "]} must be a token on its own")
+		return nil, false
+	}
+	value, err := strconv.Atoi(matches[1])
+	if err != nil {
+		Log().Named("caddyfile").Warn(
+			"Placeholder {args[" + matches[1] + "]} has an invalid index")
