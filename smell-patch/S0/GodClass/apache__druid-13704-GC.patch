+    this.selectorExpressionSupplier = fieldExpression;
+    return Suppliers.memoize(() -> {
+      byte[] fieldNameBytes = StringUtils.toUtf8WithNullToEmpty(selectorFieldName);
+      byte[] expressionBytes = Optional.ofNullable(selectorExpressionSupplier.get())
+                                       .map(Expr::getCacheKey)
+                                       .orElse(StringUtils.EMPTY_BYTES);
