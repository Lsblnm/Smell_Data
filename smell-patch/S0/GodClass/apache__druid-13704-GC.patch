+  public Object computeJavaScript(
+      List<String> fieldNames,
+      java.util.function.ToDoubleFunction<Object[]> fn,
+      Map<String, Object> combinedAggregators
+  )
+  {
+    this.javaScriptFieldNames = fieldNames;
+    final Object[] args = new Object[javaScriptFieldNames.size()];
+    int i = 0;
+    for (String field : javaScriptFieldNames) {
+      args[i++] = combinedAggregators.get(field);
+    }
+    return fn.applyAsDouble(args);
+  }
