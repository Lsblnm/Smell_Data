+jv jq_get_home(jq_state *jq) {
+  jv ret;
+  char *home = getenv("HOME");
+  if (!home) {
+#ifndef WIN32
+    struct passwd* pwd = getpwuid(getuid());
+    if (pwd)
+      ret = jv_string(pwd->pw_dir);
+    else
+      ret = jv_invalid_with_msg(jv_string("Could not find home directory."));
+#else
+    home = getenv("USERPROFILE");
+    if (!home) {
+      char *hd = getenv("HOMEDRIVE");
+      if (!hd) hd = "";
+      home = getenv("HOMEPATH");
+      if (!home) {
+        ret = jv_invalid_with_msg(jv_string("Could not find home directory."));
+      } else {
+        ret = jv_string_fmt("%s%s",hd,home);
+      }
+    } else {
+      ret = jv_string(home);
+    }
+#endif
+  } else {
+    ret = jv_string(home);
+  }
+  if (jq != NULL) {
+    jv_free(jq->home_dir);
+    jq->home_dir = jv_copy(ret);
+  }
+  return ret;
+}
+
+jv jq_expand_path(jq_state *jq, jv path) {
+  assert(jv_get_kind(path) == JV_KIND_STRING);
+  const char *pstr = jv_string_value(path);
+  jv ret = path;
+  if (jv_string_length_bytes(jv_copy(path)) > 1 && pstr[0] == '~' && pstr[1] == '/') {
+    jv home = jq_get_home(jq);
+    if (jv_is_valid(home)) {
+      ret = jv_string_fmt("%s/%s",jv_string_value(home),pstr+2);
+      jv_free(home);
+    } else {
+      jv emsg = jv_invalid_get_msg(home);
+      ret = jv_invalid_with_msg(jv_string_fmt("Could not expand %s. (%s)", pstr, jv_string_value(emsg)));
+      jv_free(emsg);
+    }
+    jv_free(path);
+  }
+  jq_remember_path(jq, jv_copy(ret));
+  return ret;
+}
+
+jv jq_state_realpath(jq_state *jq, jv path) {
+  int path_max;
+  char *buf = NULL;
+#ifdef _PC_PATH_MAX
+  path_max = pathconf(jv_string_value(path),_PC_PATH_MAX);
+#else
+  path_max = PATH_MAX;
+#endif
+  if (path_max > 0) {
+     buf = jv_mem_alloc(path_max);
+  }
+#ifdef WIN32
+  char *tmp = _fullpath(buf, jv_string_value(path), path_max);
+#else
+  char *tmp = realpath(jv_string_value(path), buf);
+#endif
+  if (tmp == NULL) {
+    free(buf);
+    jq_remember_realpath(jq, jv_copy(path));
+    return path;
+  }
+  jv_free(path);
+  path = jv_string(tmp);
+  free(tmp);
+  jq_remember_realpath(jq, jv_copy(path));
+  return path;
+}
+
+int jq_path_is_relative(jq_state *jq, jv p) {
+  const char *s = jv_string_value(p);
+#ifdef WIN32
+  int res = PathIsRelativeA(s);
+#else
+  int res = *s != '/';
+#endif
+  if (jq != NULL) {
+    jv_free(jq->last_path);
+    jq->last_path = jv_copy(p);
+  }
+  jv_free(p);
+  return res;
+}
+
+jv jq_path_basename(jq_state *jq, jv name) {
+  const char *s = jv_string_value(name);
+  const char *p = strrchr(s, '/');
+  if (!p) {
+    jq_remember_path(jq, jv_copy(name));
+    return name;
+  }
+  jv res = jv_string_fmt("%s", p);
+  jv_free(name);
+  jq_remember_path(jq, jv_copy(res));
+  return res;
+}
+
+jv jq_path_join(jq_state *jq, jv prefix, jv suffix) {
+  jv joined;
+  if (jv_get_kind(prefix) != JV_KIND_STRING || jv_get_kind(suffix) != JV_KIND_STRING) {
+    jv_free(prefix);
+    jv_free(suffix);
+    joined = jv_invalid_with_msg(jv_string("path join requires string components"));
+  } else if (strcmp(jv_string_value(suffix), ".") == 0) {
+    joined = jv_copy(prefix);
+    jv_free(prefix);
+    jv_free(suffix);
+  } else if (jv_string_value(prefix)[0] == '\0') {
+    joined = suffix;
+    jv_free(prefix);
+  } else {
+    joined = jv_string_fmt("%s/%s", jv_string_value(prefix), jv_string_value(suffix));
+    jv_free(prefix);
+    jv_free(suffix);
+  }
+  jq_remember_path(jq, jv_copy(joined));
+  return joined;
+}
+
+jv jq_expand_origin_path(jq_state *jq, jv origin, jv path) {
+  jv expanded;
+  const char *pstr;
+  if (jv_get_kind(path) != JV_KIND_STRING) {
+    jv_free(origin);
+    jv_free(path);
+    return jv_invalid_with_msg(jv_string("origin path must be a string"));
+  }
+  pstr = jv_string_value(path);
+  if (strncmp("$ORIGIN/", pstr, sizeof("$ORIGIN/") - 1) == 0) {
+    expanded = jv_string_fmt("%s/%s",
+                             jv_string_value(origin),
+                             pstr + sizeof("$ORIGIN/") - 1);
+    jv_free(path);
+  } else {
+    expanded = path;
+  }
+  jv_free(origin);
+  jq_remember_path(jq, jv_copy(expanded));
+  return expanded;
+}
+
+jv jq_build_lib_search_chain(jq_state *jq, jv search_path, jv jq_origin, jv lib_origin) {
+  assert(jv_get_kind(search_path) == JV_KIND_ARRAY);
+  jv expanded = jv_array();
+  jv expanded_elt;
+  jv err = jv_null();
+  jv_array_foreach(search_path, i, path) {
+    if (jv_get_kind(path) != JV_KIND_STRING) {
+      jv_free(path);
+      continue;
+    }
+    path = jq_expand_path(jq, path);
+    if (!jv_is_valid(path)) {
+      err = path;
+      path = jv_null();
+      continue;
+    }
+    if (strcmp(".",jv_string_value(path)) == 0) {
+      expanded_elt = jv_copy(path);
+    } else if (strncmp("$ORIGIN/",jv_string_value(path),sizeof("$ORIGIN/") - 1) == 0) {
+      expanded_elt = jq_expand_origin_path(jq, jv_copy(jq_origin), jv_copy(path));
+    } else if (jv_get_kind(lib_origin) == JV_KIND_STRING &&
+               jq_path_is_relative(jq, jv_copy(path))) {
+      expanded_elt = jq_path_join(jq, jv_copy(lib_origin), jv_copy(path));
+    } else {
+      expanded_elt = path;
+      path = jv_invalid();
+    }
+    expanded = jv_array_append(expanded, expanded_elt);
+    jv_free(path);
+  }
+  jv_free(jq_origin);
+  jv_free(lib_origin);
+  jv_free(search_path);
+  if (jq != NULL) {
+    jv_free(jq->lib_search_paths);
+    jq->lib_search_paths = jv_copy(expanded);
+    jv_free(jq->last_search_err);
+    jq->last_search_err = jv_copy(err);
+  }
+  return JV_ARRAY(expanded, err);
+}
+
+jv jq_validate_relpath(jq_state *jq, jv name) {
+  const char *s = jv_string_value(name);
+  if (strchr(s, '\\')) {
+    jv res = jv_invalid_with_msg(jv_string_fmt("Modules must be named by relative paths using '/', not '\\' (%s)", s));
+    jv_free(name);
+    jq_remember_path(jq, jv_copy(res));
+    return res;
+  }
+  jv components = jv_string_split(jv_copy(name), jv_string("/"));
+  jv_array_foreach(components, i, x) {
+    if (!strcmp(jv_string_value(x), "..")) {
+      jv_free(x);
+      jv_free(components);
+      jv res = jv_invalid_with_msg(jv_string_fmt("Relative paths to modules may not traverse to parent directories (%s)", s));
+      jv_free(name);
+      jq_remember_path(jq, jv_copy(res));
+      return res;
+    }
+    if (i > 0 && jv_equal(jv_copy(x), jv_array_get(jv_copy(components), i - 1))) {
+      jv_free(x);
+      jv_free(components);
+      jv res = jv_invalid_with_msg(jv_string_fmt("module names must not have equal consecutive components: %s",
+                                                 jv_string_value(name)));
+      jv_free(name);
+      jq_remember_path(jq, jv_copy(res));
+      return res;
+    }
+    jv_free(x);
+  }
+  jv_free(components);
+  jq_remember_path(jq, jv_copy(name));
+  return name;
+}
+
+jv jq_probe_module_path(jq_state *jq, jv spath, jv rel_path, jv bname, const char *suffix) {
+  struct stat st;
+  int ret;
+  jv testpath;
+
+  if (jv_get_kind(spath) != JV_KIND_STRING ||
+      strcmp(jv_string_value(spath), "") == 0) {
+    jv_free(spath);
+    jv_free(rel_path);
+    jv_free(bname);
+    return jv_invalid();
+  }
+
+  testpath = jq_state_realpath(jq, jv_string_fmt("%s/%s%s",
+                                            jv_string_value(spath),
+                                            jv_string_value(rel_path),
+                                            suffix));
+  ret = stat(jv_string_value(testpath), &st);
+  if (ret == -1 && errno == ENOENT) {
+    jv_free(testpath);
+    testpath = jq_state_realpath(jq, jv_string_fmt("%s/%s/%s%s",
+                                           jv_string_value(spath),
+                                           jv_string_value(rel_path),
+                                           "jq/main",
+                                           suffix));
+    ret = stat(jv_string_value(testpath), &st);
+  }
+  if (ret == -1 && errno == ENOENT) {
+    jv_free(testpath);
+    testpath = jq_state_realpath(jq, jv_string_fmt("%s/%s/%s%s",
+                                           jv_string_value(spath),
+                                           jv_string_value(rel_path),
+                                           jv_string_value(bname),
+                                           suffix));
+    ret = stat(jv_string_value(testpath), &st);
+  }
+  jv_free(spath);
+  jv_free(rel_path);
+  jv_free(bname);
+  if (ret == 0) {
+    jq_remember_path(jq, jv_copy(testpath));
+    return testpath;
+  }
+  jv_free(testpath);
+  return jv_invalid();
+}
