+int jq_named_has(jq_state *jq, const char *name) {
+  if (jq->progname == NULL) jq->progname = "jq";
+  return jv_object_has(jv_copy(jq->named_args), jv_string(name));
+}
+
+void jq_bind_named_string(jq_state *jq, const char *name, const char *value) {
+  if (jq->progname == NULL) jq->progname = "jq";
+  if (!jq_named_has(jq, name))
+    jq->named_args = jv_object_set(jq->named_args, jv_string(name), jv_string(value));
+}
+
+int jq_bind_named_json(jq_state *jq, const char *name, const char *text) {
+  if (jq->progname == NULL) jq->progname = "jq";
+  jv v;
+  if (jq_named_has(jq, name))
+    return 1;
+  v = jv_parse(text);
+  if (!jv_is_valid(v)) {
+    fprintf(stderr, "%s: invalid JSON text passed to --argjson\n", jq_get_progname(jq));
+    jv_free(v);
+    return 0;
+  }
+  jq->named_args = jv_object_set(jq->named_args, jv_string(name), v);
+  return 1;
+}
+
+int jq_bind_named_file(jq_state *jq, const char *name, const char *filename, int raw, const char *which) {
+  if (jq->progname == NULL) jq->progname = "jq";
+  jv data;
+  if (jq_named_has(jq, name))
+    return 1;
+  data = jq_load_file(jq, filename, raw);
+  if (!jv_is_valid(data)) {
+    data = jv_invalid_get_msg(data);
+    fprintf(stderr, "%s: Bad JSON in --%s %s %s: %s\n", jq_get_progname(jq), which,
+            name, filename, jv_string_value(data));
+    jv_free(data);
+    return 0;
+  }
+  if (strcmp(which, "argfile") == 0 &&
+      jv_get_kind(data) == JV_KIND_ARRAY && jv_array_length(jv_copy(data)) == 1)
+      data = jv_array_get(data, 0);
+  jq->named_args = jv_object_set(jq->named_args, jv_string(name), data);
+  return 1;
+}
+
+jv jq_steal_named_args(jq_state *jq) {
+  if (jq->progname == NULL) jq->progname = "jq";
+  jv args = jq->named_args;
+  jq->named_args = jv_object();
+  return args;
+}
+
+jv jq_copy_named_args(jq_state *jq) {
+  if (jq->progname == NULL) jq->progname = "jq";
+  return jv_copy(jq->named_args);
+}
+
+jv jq_assemble_args_object(jq_state *jq) {
+  if (jq->progname == NULL) jq->progname = "jq";
+  return JV_OBJECT(jv_string("positional"), jv_copy(jq->positional_args),
+                   jv_string("named"), jv_copy(jq->named_args));
+}
+
+const char *jq_skip_shebang(jq_state *jq, const char *p) {
+  if (jq->progname == NULL)
+    jq->progname = "jq";
+  if (strncmp(p, "#!", sizeof("#!") - 1) != 0)
+    return p;
+  const char *n = strchr(p, '\n');
+  if (n == NULL || n[1] != '#')
+    return p;
+  n = strchr(n + 1, '\n');
+  if (n == NULL || n[1] == '#' || n[1] == '\0' || n[-1] != '\\' || n[-2] == '\\')
+    return p;
+  n = strchr(n + 1, '\n');
+  if (n == NULL)
+    return p;
+  return n+1;
+}
+
+int jq_apply_color_env(jq_state *jq) {
+  if (jq->progname == NULL) jq->progname = "jq";
+  if (jq->dumpopts & JV_PRINT_COLOR) {
+    /* keep current dumpopts; color table is global */
+  }
+  if (getenv("JQ_COLORS") != NULL && !jq_set_colors(getenv("JQ_COLORS")))
+    return 0;
+  return 1;
+}
+
+jv jq_setup_default_lib_paths(jq_state *jq, jv lib_search_paths) {
+  if (jq->progname == NULL) jq->progname = "jq";
+  if (jv_get_kind(lib_search_paths) == JV_KIND_NULL) {
+    lib_search_paths = JV_ARRAY(jv_string("~/.jq"),
+                                jv_string("$ORIGIN/../lib/jq"),
+                                jv_string("$ORIGIN/../lib"));
+  }
+  jv_free(jq->lib_search_paths);
+  jq->lib_search_paths = jv_copy(lib_search_paths);
+  return lib_search_paths;
+}
+
+int jq_cli_process(jq_state *jq, jv value, int flags) {
+  if (jq->progname == NULL) jq->progname = "jq";
+  int options = jq->cli_options;
+  int dumpopts = jq->dumpopts;
+  int ret = JQ_OK_NO_OUTPUT;
+  jq_start(jq, value, flags);
+  jv result;
+  while (jv_is_valid(result = jq_next(jq))) {
+    if ((options & JQ_CLI_RAW_OUTPUT) && jv_get_kind(result) == JV_KIND_STRING) {
+      if (options & JQ_CLI_ASCII_OUTPUT) {
+        jv_dumpf(jv_copy(result), stdout, JV_PRINT_ASCII);
+      } else {
+        priv_fwrite(jv_string_value(result), jv_string_length_bytes(jv_copy(result)),
+            stdout, dumpopts & JV_PRINT_ISATTY);
+      }
+      ret = JQ_OK;
+      jv_free(result);
+    } else {
+      if (jv_get_kind(result) == JV_KIND_FALSE || jv_get_kind(result) == JV_KIND_NULL)
+        ret = JQ_OK_NULL_KIND;
+      else
+        ret = JQ_OK;
+      if (options & JQ_CLI_SEQ)
+        priv_fwrite("\036", 1, stdout, dumpopts & JV_PRINT_ISATTY);
+      jv_dump(result, dumpopts);
+    }
+    if (!(options & JQ_CLI_RAW_NO_LF))
+      priv_fwrite("\n", 1, stdout, dumpopts & JV_PRINT_ISATTY);
+    if (options & JQ_CLI_RAW_NUL)
+      priv_fwrite("\0", 1, stdout, dumpopts & JV_PRINT_ISATTY);
+    if (options & JQ_CLI_UNBUFFERED_OUTPUT)
+      fflush(stdout);
+  }
+  if (jq_halted(jq)) {
+    options |= JQ_CLI_EXIT_STATUS_EXACT;
+    jq->cli_options = options;
+    jv exit_code = jq_get_exit_code(jq);
+    if (!jv_is_valid(exit_code))
+      ret = JQ_OK;
+    else if (jv_get_kind(exit_code) == JV_KIND_NUMBER)
+      ret = jv_number_value(exit_code);
+    else
+      ret = JQ_ERROR_UNKNOWN;
+    jv_free(exit_code);
+    jv error_message = jq_get_error_message(jq);
+    if (jv_get_kind(error_message) == JV_KIND_STRING) {
+      priv_fwrite(jv_string_value(error_message), jv_string_length_bytes(jv_copy(error_message)),
+          stderr, dumpopts & JV_PRINT_ISATTY);
+    } else if (jv_get_kind(error_message) == JV_KIND_NULL) {
+    } else if (jv_is_valid(error_message)) {
+      error_message = jv_dump_string(jv_copy(error_message), 0);
+      fprintf(stderr, "%s\n", jv_string_value(error_message));
+    }
+    fflush(stderr);
+    jv_free(error_message);
+  } else if (jv_invalid_has_msg(jv_copy(result))) {
+    jv msg = jv_invalid_get_msg(jv_copy(result));
+    jv input_pos = jq_util_input_get_position(jq);
+    if (jv_get_kind(msg) == JV_KIND_STRING) {
+      fprintf(stderr, "jq: error (at %s): %s\n",
+              jv_string_value(input_pos), jv_string_value(msg));
+    } else {
+      msg = jv_dump_string(msg, 0);
+      fprintf(stderr, "jq: error (at %s) (not a string): %s\n",
+              jv_string_value(input_pos), jv_string_value(msg));
+    }
+    ret = JQ_ERROR_UNKNOWN;
+    jv_free(input_pos);
+    jv_free(msg);
+  }
+  jv_free(result);
+  return ret;
+}
