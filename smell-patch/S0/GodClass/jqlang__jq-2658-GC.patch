+static void jq_remember_path(jq_state *jq, jv path) {
+  if (jq == NULL) {
+    jv_free(path);
+    return;
+  }
+  jv_free(jq->last_path);
+  jq->last_path = path;
+}
+
+static void jq_remember_realpath(jq_state *jq, jv path) {
+  if (jq == NULL) {
+    jv_free(path);
+    return;
