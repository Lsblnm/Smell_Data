+static void zosServeBlockedListKeyOnState(zsetOpState *zos, robj *o, readyList *rl) {
+    dictEntry *de;
+    list *clients;
+    listNode *ln;
+    listIter li;
+
+    if (!server.blocked_clients_by_type[BLOCKED_LIST]) return;
+    de = dictFind(rl->db->blocking_keys, rl->key);
+    if (!de) return;
+    clients = dictGetVal(de);
+    listRewind(clients, &li);
+    while ((ln = listNext(&li))) {
+        client *receiver = listNodeValue(ln);
+        int deleted = 0;
+        robj *dstkey;
+        int wherefrom;
+        int whereto;
+        long long prev_error_replies;
+        client *old_client;
+        monotime replyTimer;
+
+        if (receiver->btype != BLOCKED_LIST) continue;
+
+        zosInitListPop(zos, o, receiver->bpop.target, rl->db,
+                       receiver->bpop.blockpos.wherefrom,
+                       receiver->bpop.blockpos.whereto);
+        dstkey = zos->list_dstkey;
+        wherefrom = zos->list_wherefrom;
+        whereto = zos->list_whereto;
+        if (dstkey) incrRefCount(dstkey);
+
+        prev_error_replies = server.stat_total_error_replies;
+        old_client = server.current_client;
+        server.current_client = receiver;
+        elapsedStart(&replyTimer);
+        zosServeClientBlockedOnList(receiver, o, rl->key, dstkey, rl->db,
+                                    wherefrom, whereto, &deleted);
+        updateStatsOnUnblock(receiver, 0, elapsedUs(replyTimer),
+                             server.stat_total_error_replies != prev_error_replies);
+        unblockClient(receiver);
+        afterCommand(receiver);
+        server.current_client = old_client;
+        if (dstkey) decrRefCount(dstkey);
+        if (deleted) break;
+    }
