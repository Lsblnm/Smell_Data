+
+
+static void zosServeClientBlockedOnListOnState(zsetOpState *zos, client *receiver, robj *o, robj *key, robj *dstkey,
+                                 redisDb *db, int wherefrom, int whereto, int *deleted)
+{
+    robj *argv[3];
+
+    zosInitListPop(zos, o, dstkey, db, wherefrom, whereto);
+    if (deleted) *deleted = 0;
+
+    if (!zosListHasDestination(zos)) {
+        argv[0] = (wherefrom == LIST_HEAD) ? shared.lpop : shared.rpop;
+        argv[1] = key;
+        if (receiver->lastcmd && receiver->lastcmd->proc == blmpopCommand) {
+            long count = receiver->bpop.count;
+            long llen = listTypeLength(o);
+            serverAssert(count > 0);
+            serverAssert(llen > 0);
+            argv[2] = createStringObjectFromLongLong((count > llen) ? llen : count);
+            alsoPropagate(db->id, argv, 3, PROPAGATE_AOF|PROPAGATE_REPL);
+            decrRefCount(argv[2]);
+            zosListSetCount(zos, count);
+            zosListPopRange(zos, receiver, key, deleted);
+            return;
+        }
+        alsoPropagate(db->id, argv, 2, PROPAGATE_AOF|PROPAGATE_REPL);
+        if (!zosListPopSingle(zos)) {
+            serverAssert(zos->list_value != NULL);
+        }
+        serverAssert(zos->list_value != NULL);
+        zosListReplySingle(zos, receiver, key);
+        zosListNotifyPop(zos, receiver, key);
+    } else {
+        zosListHandleMove(zos, receiver, key);
+    }
+
+    zosListReleaseValue(zos);
+    zosListDeleteIfEmpty(zos, receiver, key);
+    if (deleted) *deleted = zosListWasDeleted(zos);
+}
+void zosServeClientBlockedOnList(client *receiver, robj *o, robj *key, robj *dstkey,
+                                 redisDb *db, int wherefrom, int whereto, int *deleted)
+{
+    zsetOpState zos;
+    zosServeClientBlockedOnListOnState(&zos, receiver, o, key, dstkey, db, wherefrom, whereto, deleted);
+}
