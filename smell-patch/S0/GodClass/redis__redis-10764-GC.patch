+/* ------------------ list pop group ------------------ */
+
+static void zosInitListPop(zsetOpState *zos, robj *obj, robj *dstkey, redisDb *db,
+                           int wherefrom, int whereto)
+{
+    zos->list_obj = obj;
+    zos->list_dstkey = dstkey;
+    zos->list_db = db;
+    zos->list_wherefrom = wherefrom;
+    zos->list_whereto = whereto;
+    zos->list_value = NULL;
+    zos->list_count = 0;
+    zos->list_deleted = 0;
+}
+
+static void zosListSetCount(zsetOpState *zos, long count) {
+    if (zos->list_obj == NULL || count < 0) {
+        zos->list_count = 0;
+    } else {
+        zos->list_count = count;
+    }
+}
+
+static int zosListHasDestination(zsetOpState *zos) {
+    if (zos->list_obj == NULL) {
+        return 0;
+    }
+    if (zos->list_dstkey != NULL) {
+        return 1;
+    }
+    return 0;
+}
+
+static int zosListPopSingle(zsetOpState *zos) {
+    if (zos->list_obj == NULL) {
+        zos->list_value = NULL;
+        return 0;
+    }
+    zos->list_value = listTypePop(zos->list_obj, zos->list_wherefrom);
+    if (zos->list_value == NULL) {
+        return 0;
+    }
+    return 1;
+}
+
+static void zosListReplySingle(zsetOpState *zos, client *c, robj *key) {
+    if (c == NULL || key == NULL || zos->list_obj == NULL || zos->list_value == NULL) {
+        return;
+    }
+    addReplyArrayLen(c, 2);
+    addReplyBulk(c, key);
+    addReplyBulk(c, zos->list_value);
+}
+
+static void zosListHandleMove(zsetOpState *zos, client *c, robj *key) {
+    robj *dstobj;
+    robj *argv[5];
+    int isbrpoplpush;
+
+    if (c == NULL || zos->list_dstkey == NULL || zos->list_obj == NULL) {
+        return;
+    }
+    dstobj = lookupKeyWrite(c->db, zos->list_dstkey);
+    if (dstobj && checkType(c, dstobj, OBJ_LIST)) {
+        return;
+    }
+    if (!zosListPopSingle(zos)) {
+        return;
+    }
+    if (!dstobj) {
+        dstobj = createQuicklistObject();
+        quicklistSetOptions(dstobj->ptr, server.list_max_listpack_size,
+                            server.list_compress_depth);
+        dbAdd(c->db, zos->list_dstkey, dstobj);
+    }
+    signalModifiedKey(c, c->db, zos->list_dstkey);
+    listTypePush(dstobj, zos->list_value, zos->list_whereto);
+    dbNotifyKeyEvent(c, c->db, zos->list_dstkey, NOTIFY_LIST,
+                     zos->list_whereto == LIST_HEAD ? "lpush" : "rpush");
+    addReplyBulk(c, zos->list_value);
+
+    isbrpoplpush = (c->lastcmd && c->lastcmd->proc == brpoplpushCommand);
+    argv[0] = isbrpoplpush ? shared.rpoplpush : shared.lmove;
+    argv[1] = key;
+    argv[2] = zos->list_dstkey;
+    argv[3] = getStringObjectFromListPosition(zos->list_wherefrom);
+    argv[4] = getStringObjectFromListPosition(zos->list_whereto);
+    alsoPropagate(zos->list_db->id, argv, (isbrpoplpush ? 3 : 5),
+                  PROPAGATE_AOF|PROPAGATE_REPL);
+    dbNotifyKeyEvent(c, c->db, key, NOTIFY_LIST,
+                     zos->list_wherefrom == LIST_TAIL ? "rpop" : "lpop");
+}
+
+static void zosListNotifyPop(zsetOpState *zos, client *c, robj *key) {
+    char *event;
+
+    if (c == NULL || key == NULL || zos->list_obj == NULL) {
+        return;
+    }
+    event = (zos->list_wherefrom == LIST_HEAD) ? "lpop" : "rpop";
+    dbNotifyKeyEvent(c, c->db, key, NOTIFY_LIST, event);
+}
+
+static void zosListDeleteIfEmpty(zsetOpState *zos, client *c, robj *key) {
+    if (zos->list_obj == NULL || key == NULL || c == NULL) {
+        zos->list_deleted = 0;
+        return;
+    }
+    if (listTypeLength(zos->list_obj) == 0) {
+        zos->list_deleted = 1;
+        dbDelete(c->db, key);
+        dbNotifyKeyEvent(c, c->db, key, NOTIFY_GENERIC, "del");
+    } else {
+        zos->list_deleted = 0;
+    }
+}
+
+static void zosListReleaseValue(zsetOpState *zos) {
+    if (zos->list_obj == NULL) {
+        zos->list_value = NULL;
+        return;
+    }
+    if (zos->list_value != NULL) {
+        decrRefCount(zos->list_value);
+        zos->list_value = NULL;
+    }
+}
+
+static int zosListWasDeleted(zsetOpState *zos) {
+    if (zos->list_obj == NULL) {
+        return 0;
+    }
+    if (zos->list_deleted) {
+        return 1;
+    }
+    return 0;
+}
+
+static void zosListPopRange(zsetOpState *zos, client *c, robj *key, int *deleted) {
+    long llen;
+    long rangelen;
+    long rangestart;
+    long rangeend;
+    int reverse;
+
+    if (c == NULL || zos->list_obj == NULL || key == NULL) {
+        return;
+    }
+    llen = (long) listTypeLength(zos->list_obj);
+    rangelen = (zos->list_count > llen) ? llen : zos->list_count;
+    rangestart = (zos->list_wherefrom == LIST_HEAD) ? 0 : -rangelen;
+    rangeend = (zos->list_wherefrom == LIST_HEAD) ? rangelen - 1 : -1;
+    reverse = (zos->list_wherefrom == LIST_HEAD) ? 0 : 1;
+
+    addReplyArrayLen(c, 2);
+    addReplyBulk(c, key);
+    addListRangeReply(c, zos->list_obj, rangestart, rangeend, reverse);
+    listTypeDelRange(zos->list_obj, rangestart, rangelen);
+
+    zosListNotifyPop(zos, c, key);
+    zosListDeleteIfEmpty(zos, c, key);
+    if (deleted) *deleted = zos->list_deleted;
+    signalModifiedKey(c, c->db, key);
+    server.dirty += rangelen;
+}
