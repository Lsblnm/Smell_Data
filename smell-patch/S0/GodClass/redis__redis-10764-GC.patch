+
+static void zosNotifyAndTouch(client *c, redisDb *db, robj *key, int type, char *event) {
+    dbNotifyKeyEvent(c, db, key, type, event);
+    if (c != NULL) {
+        signalModifiedKey(c, db, key);
+    }
+}
+
+static void zosPropagateZpop(client *receiver, robj *key, int where, long count, long llen) {
+    int argc = 2;
+    robj *argv[3];
+
+    argv[0] = where == ZSET_MIN ? shared.zpopmin : shared.zpopmax;
+    argv[1] = key;
+    incrRefCount(key);
+    if (count != -1) {
+        robj *count_obj = createStringObjectFromLongLong((count > llen) ? llen : count);
+        argv[2] = count_obj;
+        argc++;
+    }
+    alsoPropagate(receiver->db->id, argv, argc, PROPAGATE_AOF|PROPAGATE_REPL);
+    decrRefCount(argv[1]);
+    if (count != -1) decrRefCount(argv[2]);
+}
+
+static int zosTryServeExistingZset(zsetOpState *zos) {
+    int selected;
+    client *c = zos->pop_client;
+    long llen;
+
+    selected = zosSelectCandidate(zos, zos->pop_keys, zos->pop_numkeys, c, OBJ_ZSET, 1);
+    if (selected < 0) {
+        return 1; /* type error already replied */
+    }
+    if (!selected || !zosScanHasCandidate(zos)) {
+        return 0;
+    }
+    llen = zos->scan_len;
+    genericZpopCommand(c, &zos->scan_key, 1, zos->pop_where, 1, zos->pop_count,
+                       zos->pop_nested, zos->pop_reply_nil, NULL);
+    zosRewritePopAsZpop(zos, zos->scan_key, llen);
+    return 1;
+}
