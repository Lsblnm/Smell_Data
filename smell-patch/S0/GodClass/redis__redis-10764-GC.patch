+static void zosBlockingPopGenericCommandOnState(zsetOpState *zos, client *c, robj **keys, int numkeys, int where,
+                                  int timeout_idx, long count)
+{
+    int selected;
+    mstime_t timeout;
+
+    zosInitPopRequest(zos, c, keys, numkeys, where, timeout_idx, count, 1, 0, 0);
+    if (zosParsePopTimeout(zos) != C_OK) return;
+    timeout = zos->pop_timeout;
+
+    selected = zosSelectCandidate(zos, keys, numkeys, c, OBJ_LIST, 1);
+    if (selected < 0) return;
+    if (selected) {
+        zosInitListPop(zos, zos->scan_obj, NULL, c->db, where, 0);
+        if (count != -1) {
+            zosListSetCount(zos, count);
+            zosListPopRange(zos, c, zos->scan_key, NULL);
+            {
+                long llen = zos->scan_len;
+                robj *count_obj = createStringObjectFromLongLong((count > llen) ? llen : count);
+                rewriteClientCommandVector(c, 3,
+                                           (where == LIST_HEAD) ? shared.lpop : shared.rpop,
+                                           zos->scan_key, count_obj);
+                decrRefCount(count_obj);
+            }
+            return;
+        }
+        if (!zosListPopSingle(zos)) {
+            serverAssert(zos->list_value != NULL);
+        }
+        serverAssert(zos->list_value != NULL);
+        zosListReplySingle(zos, c, zos->scan_key);
+        zosListReleaseValue(zos);
+        listElementsRemoved(c, zos->scan_key, where, zos->scan_obj, 1, NULL);
+        rewriteClientCommandVector(c, 2,
+            (where == LIST_HEAD) ? shared.lpop : shared.rpop,
+            zos->scan_key);
+        return;
+    }
+
+    if (zosClientDeniesBlocking(zos)) {
+        addReplyNullArray(c);
+        return;
+    }
+    {
+        struct blockPos pos = {where};
+        blockForKeys(c, BLOCKED_LIST, keys, numkeys, count, timeout, NULL, &pos, NULL);
+    }
+}
+
+void zosBlockingPopGenericCommand(client *c, robj **keys, int numkeys, int where,
+                                  int timeout_idx, long count)
+{
+    zsetOpState zos;
+    zosBlockingPopGenericCommandOnState(&zos, c, keys, numkeys, where, timeout_idx, count);
+}
