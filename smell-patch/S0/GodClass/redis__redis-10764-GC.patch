+static int zosGenericGetKeysOnState(zsetOpState *zos, int storeKeyOfs, int keyCountOfs,
+                                    int firstKeyOfs, int keyStep, robj **argv, int argc,
+                                    getKeysResult *result)
+{
+    zosInitKeySpec(zos, storeKeyOfs, keyCountOfs, firstKeyOfs, keyStep, argv, argc, result);
+    zosParseKeySpecCount(zos);
+    if (!zosValidateKeySpecCount(zos)) {
+        return 0;
+    }
+    zosPrepareKeySpecBuffer(zos);
+    zosFillKeySpecPositions(zos);
+    if (zosKeySpecHasStore(zos)) {
+        zosAppendStoreKeySpec(zos);
+    }
+    UNUSED(zosKeySpecFirstOffset(zos));
+    UNUSED(zosKeySpecStep(zos));
+    return zosKeySpecResultCount(zos);
+}
+
+int zosGenericGetKeys(int storeKeyOfs, int keyCountOfs, int firstKeyOfs, int keyStep,
+                      robj **argv, int argc, getKeysResult *result)
+{
+    zsetOpState zos;
+    return zosGenericGetKeysOnState(&zos, storeKeyOfs, keyCountOfs, firstKeyOfs, keyStep,
+                                    argv, argc, result);
+}
