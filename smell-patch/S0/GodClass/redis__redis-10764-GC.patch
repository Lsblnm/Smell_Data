+static void zosServeBlockedZsetKeyOnState(zsetOpState *zos, robj *o, readyList *rl) {
+    dictEntry *de;
+    list *clients;
+    listNode *ln;
+    listIter li;
+
+    if (!server.blocked_clients_by_type[BLOCKED_ZSET]) return;
+    de = dictFind(rl->db->blocking_keys, rl->key);
+    if (!de) return;
+    clients = dictGetVal(de);
+    listRewind(clients, &li);
+    while ((ln = listNext(&li))) {
+        client *receiver = listNodeValue(ln);
+        memset(zos, 0, sizeof(*zos));
+        int deleted = 0;
+        long llen;
+        long count;
+        int where;
+        int use_nested_array;
+        int reply_nil_when_empty;
+        long long prev_error_replies;
+        client *old_client;
+        monotime replyTimer;
+
+        if (receiver->btype != BLOCKED_ZSET) continue;
+
+        llen = zsetLength(o);
+        count = receiver->bpop.count;
+        where = receiver->bpop.blockpos.wherefrom;
+        use_nested_array = (receiver->lastcmd &&
+                            receiver->lastcmd->proc == bzmpopCommand) ? 1 : 0;
+        reply_nil_when_empty = use_nested_array;
+
+        zosInitPopRequest(zos, receiver, &rl->key, 1, where, 0, count, 1,
+                          use_nested_array, reply_nil_when_empty);
+        zosResetScan(zos);
+        zosScanSetKey(zos, rl->key);
+        zos->scan_obj = o;
+        zosScanMeasureZsetLength(zos);
+
+        prev_error_replies = server.stat_total_error_replies;
+        old_client = server.current_client;
+        server.current_client = receiver;
+        elapsedStart(&replyTimer);
+        genericZpopCommand(receiver, &rl->key, 1, where, 1, count,
+                           use_nested_array, reply_nil_when_empty, &deleted);
+        zosPropagateZpop(receiver, rl->key, where, count, llen);
+        updateStatsOnUnblock(receiver, 0, elapsedUs(replyTimer),
+                             server.stat_total_error_replies != prev_error_replies);
+        unblockClient(receiver);
+        afterCommand(receiver);
+        server.current_client = old_client;
+        if (deleted) break;
+    }
+}
+void zosServeClientsBlockedOnSortedSetKey(robj *o, readyList *rl) {
+    zsetOpState zos;
+    zosServeBlockedZsetKeyOnState(&zos, o, rl);
+}
