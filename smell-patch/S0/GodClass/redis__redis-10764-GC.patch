+/* ------------------ candidate scan group ------------------ */
+
+static void zosResetScan(zsetOpState *zos) {
+    zos->scan_idx = 0;
+    zos->scan_key = NULL;
+    zos->scan_obj = NULL;
+    zos->scan_len = 0;
+    zos->scan_status = 0;
+}
+
+static void zosScanSetKey(zsetOpState *zos, robj *key) {
+    zos->scan_key = key;
+    zos->scan_obj = NULL;
+    zos->scan_len = 0;
+    if (key == NULL) {
+        zos->scan_status = 0;
+    } else {
+        zos->scan_status = 1;
+    }
+}
+
+static void zosScanLookupWrite(zsetOpState *zos, redisDb *db) {
+    if (zos->scan_key == NULL || db == NULL) {
+        zos->scan_obj = NULL;
+        zos->scan_status = 0;
+        return;
+    }
+    zos->scan_obj = lookupKeyWrite(db, zos->scan_key);
+    if (zos->scan_obj == NULL) {
+        zos->scan_status = 0;
+    } else {
+        zos->scan_status = 1;
+    }
+}
+
+static int zosScanCheckType(zsetOpState *zos, client *c, int type) {
+    if (zos->scan_obj == NULL) {
+        zos->scan_status = 0;
+        return 0;
+    }
+    if (checkType(c, zos->scan_obj, type)) {
+        zos->scan_status = -1;
+        return -1;
+    }
+    zos->scan_status = 1;
+    return 1;
+}
+
+static void zosScanMeasureZsetLength(zsetOpState *zos) {
+    if (zos->scan_obj == NULL) {
+        zos->scan_len = 0;
+        zos->scan_status = 0;
+        return;
+    }
+    zos->scan_len = (long) zsetLength(zos->scan_obj);
+    if (zos->scan_len < 0) {
+        zos->scan_len = 0;
+        zos->scan_status = 0;
+    } else {
+        zos->scan_status = 1;
+    }
+}
+
+static void zosScanMeasureListLength(zsetOpState *zos) {
+    if (zos->scan_obj == NULL) {
+        zos->scan_len = 0;
+        zos->scan_status = 0;
+        return;
+    }
+    zos->scan_len = (long) listTypeLength(zos->scan_obj);
+    if (zos->scan_len < 0) {
+        zos->scan_len = 0;
+        zos->scan_status = 0;
+    } else {
+        zos->scan_status = 1;
+    }
+}
+
+static int zosScanSkipIfEmpty(zsetOpState *zos) {
+    if (zos->scan_obj == NULL) {
+        return 1;
+    }
+    if (zos->scan_len == 0) {
+        zos->scan_status = 0;
+        return 1;
+    }
+    return 0;
+}
+
+static int zosScanAdvance(zsetOpState *zos, int limit) {
+    zos->scan_idx++;
+    if (zos->scan_idx >= limit) {
+        zos->scan_status = 0;
+        return 0;
+    }
+    zos->scan_status = 1;
+    return 1;
+}
+
+static int zosScanHasCandidate(zsetOpState *zos) {
+    if (zos->scan_obj != NULL && zos->scan_status > 0 && zos->scan_len > 0) {
+        return 1;
+    }
+    return 0;
+}
+
+static robj *zosScanKeyPtr(zsetOpState *zos) {
+    if (zos->scan_status <= 0) {
+        return NULL;
+    }
+    return zos->scan_key;
+}
+
+static int zosSelectCandidate(zsetOpState *zos, robj **keys, int numkeys,
+                              client *c, int type, int skip_empty)
+{
+    zosResetScan(zos);
+    if (keys == NULL || numkeys <= 0 || c == NULL) {
+        zos->scan_status = 0;
+        return 0;
+    }
+    while (zos->scan_idx < numkeys) {
+        zosScanSetKey(zos, keys[zos->scan_idx]);
+        zosScanLookupWrite(zos, c->db);
+        if (zos->scan_obj == NULL) {
+            if (!zosScanAdvance(zos, numkeys)) break;
+            continue;
+        }
+        if (zosScanCheckType(zos, c, type) < 0) {
+            return -1;
+        }
+        if (type == OBJ_ZSET) {
+            zosScanMeasureZsetLength(zos);
+        } else if (type == OBJ_LIST) {
+            zosScanMeasureListLength(zos);
+        } else {
+            zos->scan_len = 1;
+        }
+        if (skip_empty && zosScanSkipIfEmpty(zos)) {
+            if (!zosScanAdvance(zos, numkeys)) break;
+            continue;
+        }
+        return 1;
+    }
+    zos->scan_status = 0;
+    return 0;
+}
+
+/* ------------------ element extraction group ------------------ */
+
+static void zosResetElem(zsetOpState *zos) {
+    zos->elem_value = NULL;
+    zos->elem_score = 0;
+    zos->elem_emitted = 0;
+    zos->elem_remaining = 0;
+    zos->elem_lp = NULL;
+    zos->elem_node = NULL;
+}
+
+static int zosExtractListpackElem(zsetOpState *zos, robj *zobj, int where, client *c) {
+    unsigned char *zl, *eptr, *sptr, *vstr;
+    unsigned int vlen;
+    long long vlong;
+
+    if (zobj == NULL || zobj->encoding != OBJ_ENCODING_LISTPACK) {
+        return 0;
+    }
+    zl = zobj->ptr;
+    eptr = lpSeek(zl, where == ZSET_MAX ? -2 : 0);
+    serverAssertWithInfo(c, zobj, eptr != NULL);
+    vstr = lpGetValue(eptr, &vlen, &vlong);
+    if (vstr == NULL) {
+        zos->elem_value = sdsfromlonglong(vlong);
+    } else {
+        zos->elem_value = sdsnewlen(vstr, vlen);
+    }
+    sptr = lpNext(zl, eptr);
+    serverAssertWithInfo(c, zobj, sptr != NULL);
+    zos->elem_score = zzlGetScore(sptr);
+    zos->elem_lp = eptr;
+    zos->elem_node = NULL;
+    return 1;
+}
+
+static int zosExtractSkiplistElem(zsetOpState *zos, robj *zobj, int where, client *c) {
+    zset *zs;
+    zskiplist *zsl;
+    zskiplistNode *zln;
+
+    if (zobj == NULL || zobj->encoding != OBJ_ENCODING_SKIPLIST) {
+        return 0;
+    }
+    zs = zobj->ptr;
+    zsl = zs->zsl;
+    zln = (where == ZSET_MAX ? zsl->tail : zsl->header->level[0].forward);
+    serverAssertWithInfo(c, zobj, zln != NULL);
+    zos->elem_value = sdsdup(zln->ele);
+    zos->elem_score = zln->score;
+    zos->elem_node = zln;
+    zos->elem_lp = NULL;
+    return 1;
+}
+
+static int zosExtractPopElement(zsetOpState *zos, robj *zobj, int where, client *c) {
+    if (zobj == NULL) {
+        zos->elem_value = NULL;
+        return 0;
+    }
+    if (zobj->encoding == OBJ_ENCODING_LISTPACK) {
+        return zosExtractListpackElem(zos, zobj, where, c);
+    } else if (zobj->encoding == OBJ_ENCODING_SKIPLIST) {
+        return zosExtractSkiplistElem(zos, zobj, where, c);
+    }
+    serverPanic("Unknown sorted set encoding");
+    return 0;
+}
+
+static void zosRemovePopElement(zsetOpState *zos, robj *zobj, client *c) {
+    if (zos->elem_value == NULL || zobj == NULL) {
+        return;
+    }
+    serverAssertWithInfo(c, zobj, zsetDel(zobj, zos->elem_value));
+    server.dirty++;
+}
+
+static void zosComputeElemRange(zsetOpState *zos, robj *zobj) {
+    long llen;
+    long count;
+
+    zos->elem_emitted = 0;
+    zos->elem_value = NULL;
+    if (zobj == NULL) {
+        zos->elem_remaining = 0;
+        return;
+    }
+    llen = (long) zsetLength(zobj);
+    count = zos->pop_count;
+    if (count <= 0) {
+        count = 1;
+    }
+    zos->elem_remaining = (count > llen) ? llen : count;
+}
+
+static void zosEmitPopHeader(zsetOpState *zos, robj *key) {
+    client *c = zos->pop_client;
+    long rangelen = zos->elem_remaining;
+    int nested;
+    int emitkey;
+
+    zos->elem_value = NULL;
+    if (c == NULL) {
+        return;
+    }
+    nested = zosShouldUseNestedReply(zos);
+    emitkey = zosShouldEmitKey(zos);
+    if (!nested && !emitkey) {
+        addReplyArrayLen(c, rangelen * 2);
+    } else if (nested && !emitkey) {
+        addReplyArrayLen(c, rangelen);
+    } else if (!nested && emitkey) {
+        addReplyArrayLen(c, rangelen * 2 + 1);
+        addReplyBulk(c, key);
+    } else {
+        addReplyArrayLen(c, 2);
+        addReplyBulk(c, key);
+        addReplyArrayLen(c, rangelen);
+    }
+}
+
+static void zosReplyPopElement(zsetOpState *zos, client *c) {
+    if (zos->elem_value == NULL || c == NULL) {
+        return;
+    }
+    addReplyBulkCBuffer(c, zos->elem_value, sdslen(zos->elem_value));
+    addReplyDouble(c, zos->elem_score);
+}
+
+static int zosConsumeElemRange(zsetOpState *zos) {
+    zos->elem_value = NULL;
+    if (zos->elem_remaining > 0) {
+        zos->elem_remaining--;
+    }
+    zos->elem_emitted++;
+    if (zos->elem_remaining > 0) {
+        return 1;
+    }
+    return 0;
+}
+
+static void zosFreeElemValue(zsetOpState *zos) {
+    if (zos->elem_value != NULL) {
+        sdsfree(zos->elem_value);
+        zos->elem_value = NULL;
+    }
+    zos->elem_lp = NULL;
+    zos->elem_node = NULL;
+}
+
+/* ------------------ blocking registry group ------------------ */
+
+static void zosInitBlocking(zsetOpState *zos, int btype, robj *target,
+                            struct blockPos *blockpos, streamID *ids)
+{
+    zos->blk_type = btype;
+    zos->blk_target = target;
+    zos->blk_ids = ids;
+    zos->blk_index = 0;
+    zos->blk_de = NULL;
+    zos->blk_list = NULL;
+    if (blockpos != NULL) {
+        zos->blk_pos = *blockpos;
+    } else {
+        zos->blk_pos.wherefrom = 0;
+        zos->blk_pos.whereto = 0;
+    }
+}
+
+static void zosStoreBlockingMeta(zsetOpState *zos, client *c, long count, mstime_t timeout) {
+    if (c == NULL || zos->blk_type == BLOCKED_NONE) {
+        return;
+    }
+    c->bpop.count = count;
+    c->bpop.timeout = timeout;
+    c->bpop.target = zos->blk_target;
+    c->bpop.blockpos = zos->blk_pos;
+    if (zos->blk_target != NULL) {
+        incrRefCount(zos->blk_target);
+    }
+}
+
+static int zosBlockingKeyDuplicate(zsetOpState *zos, client *c, robj *key, bkinfo *bki) {
+    if (c == NULL || key == NULL || bki == NULL || zos->blk_type == BLOCKED_NONE) {
+        zos->blk_de = NULL;
+        return 1;
+    }
+    if (dictAdd(c->bpop.keys, key, bki) != DICT_OK) {
+        zos->blk_de = NULL;
+        return 1;
+    }
+    zos->blk_de = dictFind(c->bpop.keys, key);
+    return 0;
+}
+
+static void zosAttachBlockingClientList(zsetOpState *zos, client *c, robj *key, bkinfo *bki) {
+    dictEntry *de;
+
+    if (c == NULL || key == NULL || bki == NULL || zos->blk_type == BLOCKED_NONE) {
+        zos->blk_list = NULL;
+        return;
+    }
+    de = dictFind(c->db->blocking_keys, key);
+    zos->blk_de = de;
+    if (de == NULL) {
+        int retval;
+        zos->blk_list = listCreate();
+        retval = dictAdd(c->db->blocking_keys, key, zos->blk_list);
+        incrRefCount(key);
+        serverAssertWithInfo(c, key, retval == DICT_OK);
+    } else {
+        zos->blk_list = dictGetVal(de);
+    }
+    listAddNodeTail(zos->blk_list, c);
+    bki->listnode = listLast(zos->blk_list);
+}
+
+static int zosRegisterOneBlockingKey(zsetOpState *zos, client *c, robj *key) {
+    bkinfo *bki;
+
+    if (c == NULL || key == NULL) {
+        return 0;
+    }
+    bki = zmalloc(sizeof(*bki));
+    if (zos->blk_type == BLOCKED_STREAM && zos->blk_ids != NULL) {
+        bki->stream_id = zos->blk_ids[zos->blk_index];
+    }
+    if (zosBlockingKeyDuplicate(zos, c, key, bki)) {
+        zfree(bki);
+        return 0;
+    }
+    incrRefCount(key);
+    zosAttachBlockingClientList(zos, c, key, bki);
+    return 1;
+}
+
+static void zosFinishBlockingClient(zsetOpState *zos, client *c) {
+    if (c == NULL) {
+        return;
+    }
+    blockClient(c, zos->blk_type);
+}
+
+static int zosBlockingHasTarget(zsetOpState *zos) {
+    if (zos->blk_type == BLOCKED_NONE) {
+        return 0;
+    }
+    if (zos->blk_target != NULL) {
+        return 1;
+    }
+    return 0;
+}
+
+static int zosBlockingHasStreamIds(zsetOpState *zos) {
+    if (zos->blk_type == BLOCKED_STREAM && zos->blk_ids != NULL) {
+        return 1;
+    }
+    return 0;
+}
+
+static void zosBlockingSetIndex(zsetOpState *zos, int index) {
+    if (zos->blk_type == BLOCKED_NONE) {
+        zos->blk_index = 0;
+        return;
+    }
+    if (index < 0) {
+        zos->blk_index = 0;
+    } else {
+        zos->blk_index = index;
+    }
+}
+
+static int zosBlockingIndex(zsetOpState *zos) {
+    if (zos->blk_type == BLOCKED_NONE) {
+        return 0;
+    }
+    if (zos->blk_index < 0) {
+        return 0;
+    }
+    return zos->blk_index;
+}
