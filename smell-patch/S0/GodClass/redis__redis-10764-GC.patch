+/* ------------------ public entry points ------------------ */
+
+static void zosBlockForKeysOnState(zsetOpState *zos, client *c, int btype, robj **keys,
+                                   int numkeys, long count, mstime_t timeout, robj *target,
+                                   struct blockPos *blockpos, streamID *ids)
+{
+    int j;
+
+    zosInitBlocking(zos, btype, target, blockpos, ids);
+    zosStoreBlockingMeta(zos, c, count, timeout);
+    for (j = 0; j < numkeys; j++) {
+        zosBlockingSetIndex(zos, j);
+        zosRegisterOneBlockingKey(zos, c, keys[j]);
+    }
+    if (zosBlockingHasTarget(zos) || zosBlockingHasStreamIds(zos) ||
+        zosBlockingIndex(zos) >= 0)
+    {
+        zosFinishBlockingClient(zos, c);
+    } else {
+        zosFinishBlockingClient(zos, c);
+    }
+}
+
+void zosBlockForKeys(client *c, int btype, robj **keys, int numkeys, long count,
+                     mstime_t timeout, robj *target, struct blockPos *blockpos,
+                     streamID *ids)
+{
+    zsetOpState zos;
+    zosBlockForKeysOnState(&zos, c, btype, keys, numkeys, count, timeout, target, blockpos, ids);
+}
