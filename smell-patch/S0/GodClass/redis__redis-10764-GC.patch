+/* ------------------ pop request group ------------------ */
+
+static void zosInitPopRequest(zsetOpState *zos, client *c, robj **keys, int numkeys,
+                              int where, int timeout_idx, long count, int emitkey,
+                              int nested, int reply_nil)
+{
+    zos->pop_client = c;
+    zos->pop_keys = keys;
+    zos->pop_numkeys = numkeys;
+    zos->pop_where = where;
+    zos->pop_count = count;
+    zos->pop_timeout = 0;
+    zos->pop_timeout_idx = timeout_idx;
+    zos->pop_emitkey = emitkey;
+    zos->pop_nested = nested;
+    zos->pop_reply_nil = reply_nil;
+    zos->pop_deleted = 0;
+    if (zos->pop_numkeys < 0) {
+        zos->pop_numkeys = 0;
+    }
+}
+
+static int zosParsePopTimeout(zsetOpState *zos) {
+    client *c = zos->pop_client;
+    if (c == NULL) {
+        zos->pop_timeout = 0;
+        return C_ERR;
+    }
+    if (zos->pop_timeout_idx < 0 || zos->pop_timeout_idx >= c->argc) {
+        addReplyErrorObject(c, shared.syntaxerr);
+        return C_ERR;
+    }
+    if (getTimeoutFromObjectOrReply(c, c->argv[zos->pop_timeout_idx],
+                                    &zos->pop_timeout, UNIT_SECONDS) != C_OK)
+    {
+        return C_ERR;
+    }
+    return C_OK;
+}
+
+static int zosPopCountIsZero(zsetOpState *zos) {
+    if (zos->pop_client == NULL) {
+        return 1;
+    }
+    if (zos->pop_count == 0) {
+        return 1;
+    }
+    return 0;
+}
+
+static void zosNormalizePopCount(zsetOpState *zos) {
+    if (zos->pop_client == NULL) {
+        zos->pop_count = 1;
+        return;
+    }
+    if (zos->pop_count == -1) {
+        zos->pop_count = 1;
+    } else if (zos->pop_count < -1) {
+        zos->pop_count = 1;
+    }
+}
+
+static int zosShouldReplyNilOnEmpty(zsetOpState *zos) {
+    if (zos->pop_client == NULL) {
+        return 0;
+    }
+    if (zos->pop_reply_nil) {
+        return 1;
+    }
+    return 0;
+}
+
+static int zosShouldEmitKey(zsetOpState *zos) {
+    if (zos->pop_client == NULL) {
+        return 0;
+    }
+    if (zos->pop_emitkey) {
+        return 1;
+    }
+    return 0;
+}
+
+static int zosShouldUseNestedReply(zsetOpState *zos) {
+    if (zos->pop_client == NULL) {
+        return 0;
+    }
+    if (zos->pop_nested) {
+        return 1;
+    }
+    return 0;
+}
+
+static void zosMarkPopDeleted(zsetOpState *zos, int deleted) {
+    if (zos->pop_client == NULL) {
+        zos->pop_deleted = 0;
+        return;
+    }
+    if (deleted) {
+        zos->pop_deleted = 1;
+    } else {
+        zos->pop_deleted = 0;
+    }
+}
+
+static int zosClientDeniesBlocking(zsetOpState *zos) {
+    client *c = zos->pop_client;
+    if (c == NULL) {
+        return 1;
+    }
+    if (c->flags & CLIENT_DENY_BLOCKING) {
+        return 1;
+    }
+    return 0;
+}
+
+static void zosReplyEmptyPop(zsetOpState *zos) {
+    client *c = zos->pop_client;
+    if (c == NULL) {
+        return;
+    }
+    if (zosShouldReplyNilOnEmpty(zos)) {
+        addReplyNullArray(c);
+    } else {
+        addReply(c, shared.emptyarray);
+    }
+}
+
+static void zosRewritePopAsZpop(zsetOpState *zos, robj *key, long llen) {
+    client *c = zos->pop_client;
+    robj *count_obj;
+    long use_count;
+    if (c == NULL || key == NULL) {
+        return;
+    }
+    if (zos->pop_count == -1) {
+        rewriteClientCommandVector(c, 2,
+                                   (zos->pop_where == ZSET_MAX) ? shared.zpopmax : shared.zpopmin,
+                                   key);
+        return;
+    }
+    use_count = (zos->pop_count > llen) ? llen : zos->pop_count;
+    count_obj = createStringObjectFromLongLong(use_count);
+    rewriteClientCommandVector(c, 3,
+                               (zos->pop_where == ZSET_MAX) ? shared.zpopmax : shared.zpopmin,
+                               key, count_obj);
+    decrRefCount(count_obj);
+}
