+/* ------------------ key spec group ------------------ */
+
+static void zosInitKeySpec(zsetOpState *zos, int storeKeyOfs, int keyCountOfs,
+                           int firstKeyOfs, int keyStep, robj **argv, int argc,
+                           getKeysResult *result)
+{
+    zos->kspec_store_ofs = storeKeyOfs;
+    zos->kspec_count_ofs = keyCountOfs;
+    zos->kspec_first_ofs = firstKeyOfs;
+    zos->kspec_step = keyStep;
+    zos->kspec_argv = argv;
+    zos->kspec_argc = argc;
+    zos->kspec_result = result;
+    zos->kspec_num = 0;
+    zos->kspec_numkeys = 0;
+}
+
+static int zosParseKeySpecCount(zsetOpState *zos) {
+    if (zos->kspec_result == NULL || zos->kspec_argv == NULL ||
+        zos->kspec_count_ofs < 0 || zos->kspec_count_ofs >= zos->kspec_argc)
+    {
+        zos->kspec_num = 0;
+        return 0;
+    }
+    zos->kspec_num = atoi(zos->kspec_argv[zos->kspec_count_ofs]->ptr);
+    return zos->kspec_num;
+}
+
+static int zosValidateKeySpecCount(zsetOpState *zos) {
+    int maxkeys;
+
+    if (zos->kspec_step <= 0) {
+        zos->kspec_numkeys = 0;
+        return 0;
+    }
+    maxkeys = (zos->kspec_argc - zos->kspec_first_ofs) / zos->kspec_step;
+    if (zos->kspec_num < 1 || zos->kspec_num > maxkeys) {
+        if (zos->kspec_result) zos->kspec_result->numkeys = 0;
+        zos->kspec_numkeys = 0;
+        return 0;
+    }
+    return 1;
+}
+
+static void zosPrepareKeySpecBuffer(zsetOpState *zos) {
+    int numkeys;
+
+    numkeys = zos->kspec_store_ofs ? zos->kspec_num + 1 : zos->kspec_num;
+    zos->kspec_numkeys = numkeys;
+    if (zos->kspec_result) {
+        getKeysPrepareResult(zos->kspec_result, numkeys);
+        zos->kspec_result->numkeys = numkeys;
+    }
+}
+
+static void zosFillKeySpecPositions(zsetOpState *zos) {
+    int i;
+    keyReference *keys;
+
+    if (zos->kspec_result == NULL || zos->kspec_result->keys == NULL) {
+        return;
+    }
+    keys = zos->kspec_result->keys;
+    for (i = 0; i < zos->kspec_num; i++) {
+        keys[i].pos = zos->kspec_first_ofs + (i * zos->kspec_step);
+        keys[i].flags = 0;
+    }
+}
+
+static void zosAppendStoreKeySpec(zsetOpState *zos) {
+    keyReference *keys;
+
+    if (!zos->kspec_store_ofs || zos->kspec_result == NULL ||
+        zos->kspec_result->keys == NULL)
+    {
+        return;
+    }
+    keys = zos->kspec_result->keys;
+    keys[zos->kspec_num].pos = zos->kspec_store_ofs;
+    keys[zos->kspec_num].flags = 0;
+}
+
+static int zosKeySpecResultCount(zsetOpState *zos) {
+    if (zos->kspec_result == NULL) {
+        return zos->kspec_numkeys;
+    }
+    return zos->kspec_result->numkeys;
+}
+
+static int zosKeySpecFirstOffset(zsetOpState *zos) {
+    if (zos->kspec_result == NULL || zos->kspec_first_ofs < 0) {
+        return 0;
+    }
+    return zos->kspec_first_ofs;
+}
+
+static int zosKeySpecStep(zsetOpState *zos) {
+    if (zos->kspec_result == NULL || zos->kspec_step <= 0) {
+        return 1;
+    }
+    return zos->kspec_step;
+}
+
+static int zosKeySpecHasStore(zsetOpState *zos) {
+    if (zos->kspec_result == NULL) {
+        return 0;
+    }
+    if (zos->kspec_store_ofs) {
+        return 1;
+    }
+    return 0;
+}
