+	return fl
+}
+
+func (fl *functionLibrary) signature(name string) functionSignature {
+	if fl.signatures == nil {
+		return functionSignature{name: name, matrix: true}
+	}
+	if sig, ok := fl.signatures[name]; ok {
+		return sig
+	}
+	return functionSignature{name: name, matrix: true}
+}
+
+func (fl *functionLibrary) usesRangeVector(name string) bool {
+	sig := fl.signature(name)
+	if fl.signatures == nil {
+		return true
+	}
+	if _, ok := fl.signatures[name]; !ok {
+		return true
+	}
+	return sig.matrix
+}
+
+func (fl *functionLibrary) unixTime(seconds int64) time.Time {
+	loc := fl.dateLoc
+	if loc == nil {
+		loc = time.UTC
+	}
+	return time.Unix(seconds, 0).In(loc)
+}
+
+func (fl *functionLibrary) evalTime(tsMillis int64) time.Time {
+	return fl.unixTime(tsMillis / 1000)
+}
+
+func (fl *functionLibrary) dropCachedName(enh *EvalNodeHelper, metric labels.Labels) labels.Labels {
+	if fl.metricNameLabel == "" {
+		return metric
+	}
+	if fl.metricNameLabel == labels.MetricName {
+		return enh.DropMetricName(metric)
+	}
+	return labels.NewBuilder(metric).Del(fl.metricNameLabel).Labels()
+}
+
+func (fl *functionLibrary) mapScalar(vals []parser.Value, enh *EvalNodeHelper, fn func(float64) float64, drop string) Vector {
+	for _, el := range vals[0].(Vector) {
+		metric := el.Metric
+		if drop != "" {
+			metric = fl.dropCachedName(enh, el.Metric)
+		}
+		enh.Out = append(enh.Out, Sample{
+			Metric: metric,
+			Point:  Point{V: fn(el.V)},
+		})
+	}
+	return enh.Out
+}
+
+func (fl *functionLibrary) matchingLabels(expr parser.Expr) labels.Labels {
+	return fl.createLabelsForAbsentFunction(expr)
+}
+
+func (fl *functionLibrary) labelIsValid(name string) bool {
+	return model.LabelName(name).IsValid()
+}
+
+func (fl *functionLibrary) matcherKeepsLabel(ma *labels.Matcher) bool {
+	if ma == nil {
+		return false
+	}
+	if ma.Name == fl.metricNameLabel {
+		return false
+	}
+	return ma.Type == labels.MatchEqual
+}
+
+func (fl *functionLibrary) time(vals []parser.Value, args parser.Expressions, enh *EvalNodeHelper) Vector {
 	return Vector{Sample{Point: Point{
 		V: float64(enh.Ts) / 1000,
 	}}}
 }
 
