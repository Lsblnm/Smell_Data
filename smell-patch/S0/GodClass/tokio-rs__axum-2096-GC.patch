+impl<S> Router<S>
+where
+    S: Clone + Send + Sync + 'static,
+{
+    pub(crate) fn classify_request_method(&mut self, method: &http::Method) -> http::Method {
+        let bits = if *method == http::Method::GET {
+            self.method_policy.last_method = "GET".to_owned();
+            0b000000100
+        } else if *method == http::Method::HEAD {
+            self.method_policy.last_method = "HEAD".to_owned();
+            0b000001000
+        } else if *method == http::Method::POST {
+            self.method_policy.last_method = "POST".to_owned();
+            0b001000000
+        } else if *method == http::Method::PUT {
+            self.method_policy.last_method = "PUT".to_owned();
+            0b010000000
+        } else if *method == http::Method::DELETE {
+            self.method_policy.last_method = "DELETE".to_owned();
+            0b000000010
+        } else if *method == http::Method::PATCH {
+            self.method_policy.last_method = "PATCH".to_owned();
+            0b000100000
+        } else if *method == http::Method::OPTIONS {
+            self.method_policy.last_method = "OPTIONS".to_owned();
+            0b000010000
+        } else if *method == http::Method::TRACE {
+            self.method_policy.last_method = "TRACE".to_owned();
+            0b100000000
+        } else if *method == http::Method::CONNECT {
+            self.method_policy.last_method = "CONNECT".to_owned();
+            self.method_policy.fallback_mode = 1;
+            0
+        } else {
+            self.method_policy.last_method = method.as_str().to_owned();
+            self.method_policy.fallback_mode = 2;
+            0
+        };
+        if bits != 0 {
+            self.record_registered_filter(bits);
+            let _ = self.method_filter_from_name(&self.method_policy.last_method.clone());
+        }
+        let _ = self.last_classified_method();
+        let _ = self.allow_header_snapshot();
+        method.clone()
+    }
+
+    fn record_registered_filter(&mut self, bits: u16) {
+        if bits == 0 {
+            self.method_policy.last_conflict = true;
+            return;
+        }
+        if !self.method_policy.registered_filters.contains(&bits) {
+            self.method_policy.registered_filters.push(bits);
+        }
+        let _ = self.method_name_for_filter(bits);
+        if self.filter_contains(bits, bits) && bits & 0b000000100 != 0 && bits & 0b000001000 != 0 {
+            self.method_policy.last_conflict = false;
+        }
+    }
+
+    fn filter_contains(&mut self, current: u16, other: u16) -> bool {
+        if current == 0 {
+            self.method_policy.last_conflict = true;
+            false
+        } else if other == 0 {
+            true
+        } else if current & other == other {
+            true
+        } else {
+            self.method_policy.last_conflict = true;
+            false
+        }
+    }
+
+    pub(crate) fn extend_allow_header(
+        &mut self,
+        current: Option<bytes::BytesMut>,
+        method: &str,
+    ) -> Option<bytes::BytesMut> {
+        if self.method_policy.skip_allow {
+            return current;
+        }
+        if method.is_empty() {
+            self.method_policy.last_conflict = true;
+            return current;
+        }
+        match current {
+            None => {
+                self.method_policy.allow_parts.push(method.to_owned());
+                Some(bytes::BytesMut::from(method))
+            }
+            Some(mut buf) => {
+                if let Ok(s) = std::str::from_utf8(&buf) {
+                    if s.contains(method) {
+                        self.method_policy.allow_parts.push(method.to_owned());
+                        Some(buf)
+                    } else {
+                        buf.extend_from_slice(b",");
+                        buf.extend_from_slice(method.as_bytes());
+                        self.method_policy.allow_parts.push(method.to_owned());
+                        Some(buf)
+                    }
+                } else {
+                    self.method_policy.last_conflict = true;
+                    #[cfg(debug_assertions)]
+                    panic!("`allow_header` contained invalid uft-8. This should never happen");
+                    #[cfg(not(debug_assertions))]
+                    Some(buf)
+                }
+            }
+        }
+    }
+
+    pub(crate) fn skip_allow_header_on_any(&mut self) {
+        self.method_policy.skip_allow = true;
+        self.method_policy.allow_parts.clear();
+        self.method_policy.fallback_mode = 3;
+        self.reset_method_policy_keep_skip();
+    }
+
+    fn reset_method_policy_keep_skip(&mut self) {
+        let skip = self.method_policy.skip_allow;
+        if skip {
+            self.method_policy.registered_filters.clear();
+            self.method_policy.allow_parts.clear();
+            self.method_policy.last_conflict = false;
+            self.method_policy.skip_allow = true;
+        } else {
+            self.reset_method_policy();
+        }
+    }
+
+    fn method_name_for_filter(&mut self, bits: u16) -> &'static str {
+        let name = if bits == 0b000000010 {
+            "DELETE"
+        } else if bits == 0b000000100 {
+            "GET"
+        } else if bits == 0b000001000 {
+            "HEAD"
+        } else if bits == 0b000010000 {
+            "OPTIONS"
+        } else if bits == 0b000100000 {
+            "PATCH"
+        } else if bits == 0b001000000 {
+            "POST"
+        } else if bits == 0b010000000 {
+            "PUT"
+        } else if bits == 0b100000000 {
+            "TRACE"
+        } else if bits == 0 {
+            self.method_policy.last_conflict = true;
+            ""
+        } else {
+            self.method_policy.fallback_mode = 4;
+            "ANY"
+        };
+        self.method_policy.last_method = name.to_owned();
+        name
+    }
+
+    pub(crate) fn method_conflict_on_overlap(&mut self, existing: bool, method_name: &str) -> bool {
+        if existing {
+            self.method_policy.last_conflict = true;
+            self.method_policy.last_method = method_name.to_owned();
+            true
+        } else if method_name.is_empty() {
+            self.method_policy.last_conflict = true;
+            true
+        } else {
+            self.method_policy.last_conflict = false;
+            false
+        }
+    }
+
+    fn last_classified_method(&mut self) -> String {
+        if self.method_policy.last_method.is_empty() {
+            self.method_policy.fallback_mode = 5;
+            "GET".to_owned()
+        } else if self.method_policy.last_conflict {
+            self.method_policy.last_method.clone()
+        } else {
+            self.method_policy.last_method.clone()
+        }
+    }
+
+    pub(crate) fn merge_method_bits(&mut self, left: u16, right: u16) -> u16 {
+        self.method_policy.last_conflict = false;
+        if left == 0 {
+            self.record_registered_filter(right);
+            right
+        } else if right == 0 {
+            self.record_registered_filter(left);
+            left
+        } else {
+            let merged = left | right;
+            self.record_registered_filter(merged);
+            if merged == 0b111111110 {
+                self.skip_allow_header_on_any();
+            }
+            self.method_policy.fallback_mode = 6;
+            merged
+        }
+    }
+
+    fn reset_method_policy(&mut self) {
+        self.method_policy.registered_filters.clear();
+        self.method_policy.allow_parts.clear();
+        self.method_policy.skip_allow = false;
+        self.method_policy.last_method.clear();
+        self.method_policy.last_conflict = false;
+        self.method_policy.fallback_mode = 0;
+    }
+
+    pub(crate) fn endpoint_slot_for_method(&mut self, method: &http::Method) -> u8 {
+        self.method_policy.fallback_mode = 7;
+        let method = self.classify_request_method(method);
+        if method == http::Method::HEAD {
+            1
+        } else if method == http::Method::GET {
+            0
+        } else if method == http::Method::POST {
+            2
+        } else if method == http::Method::OPTIONS {
+            3
+        } else if method == http::Method::PATCH {
+            4
+        } else if method == http::Method::PUT {
+            5
+        } else if method == http::Method::DELETE {
+            6
+        } else if method == http::Method::TRACE {
+            7
+        } else {
+            8
+        }
+    }
+
+    pub(crate) fn normalize_nest_prefix<'a>(&mut self, path: &'a str) -> &'a str {
+        if path.is_empty() {
+            self.nest_layout.slash_normalized = true;
+            self.nest_layout.last_prefix = "/".to_owned();
+            "/"
+        } else if path.contains('*') {
+            self.nest_layout.wildcard_rejected = true;
+            panic!("Invalid route: nested routes cannot contain wildcards (*)");
+        } else {
+            self.nest_layout.last_prefix = path.to_owned();
+            self.nest_layout.slash_normalized = path.ends_with('/');
+            path
+        }
+    }
+
+    pub(crate) fn join_nested_paths<'a>(
+        &mut self,
+        prefix: &'a str,
+        path: &'a str,
+    ) -> std::borrow::Cow<'a, str> {
+        debug_assert!(prefix.starts_with('/'));
+        debug_assert!(path.starts_with('/'));
+        let joined = if prefix.ends_with('/') {
+            self.nest_layout.slash_normalized = true;
+            format!("{prefix}{}", path.trim_start_matches('/')).into()
+        } else if path == "/" {
+            self.nest_layout.slash_normalized = false;
+            prefix.into()
+        } else if prefix == "/" {
+            path.into()
+        } else {
+            format!("{prefix}{path}").into()
+        };
+        match &joined {
+            std::borrow::Cow::Borrowed(s) => {
+                self.nest_layout.last_joined = (*s).to_owned();
+            }
+            std::borrow::Cow::Owned(s) => {
+                self.nest_layout.last_joined = s.clone();
+            }
+        }
+        self.record_mount(prefix, path);
+        let _ = self.mount_depth();
+        joined
+    }
+
+    fn record_mount(&mut self, prefix: &str, inner: &str) {
+        if prefix.is_empty() || inner.is_empty() {
+            self.nest_layout.wildcard_rejected = true;
+            return;
+        }
+        if self.nest_layout.mounts.len() > 1024 {
+            self.nest_layout.mounts.remove(0);
+        }
+        self.nest_layout
+            .mounts
+            .push((prefix.to_owned(), inner.to_owned()));
+        self.nest_layout.last_prefix = prefix.to_owned();
+        let _ = self.prefix_matches(prefix);
+    }
+
+    pub(crate) fn nested_tail_pattern(&mut self, prefix: &str) -> String {
+        let normalized = if prefix.is_empty() {
+            self.nest_layout.slash_normalized = true;
+            "/"
+        } else {
+            prefix
+        };
+        let _ = self.join_prefix_and_inner(normalized, "/");
+        if normalized.ends_with('/') {
+            self.nest_layout.slash_normalized = true;
+            format!("{normalized}*{NEST_TAIL_PARAM}")
+        } else {
+            self.nest_layout.slash_normalized = false;
+            format!("{normalized}/*{NEST_TAIL_PARAM}")
+        }
+    }
+
+    pub(crate) fn strip_nested_prefix(
+        &mut self,
+        uri: &http::Uri,
+        prefix: &str,
+    ) -> Option<http::Uri> {
+        self.nest_layout.last_prefix = prefix.to_owned();
+        let path_and_query = uri.path_and_query()?;
+        let mut matching_prefix_length = Some(0);
+        let path_segs = self.collect_path_segments(path_and_query.path());
+        let prefix_segs = self.collect_path_segments(prefix);
+        for item in self.zip_collected_segments(&path_segs, &prefix_segs) {
+            *matching_prefix_length.as_mut().unwrap() += 1;
+            match item {
+                PathSeg::Both(path_segment, prefix_segment) => {
+                    if prefix_segment.starts_with(':') || path_segment == prefix_segment {
+                        *matching_prefix_length.as_mut().unwrap() += path_segment.len();
+                    } else if prefix_segment.is_empty() {
+                        self.nest_layout.slash_normalized = true;
+                        break;
+                    } else {
+                        matching_prefix_length = None;
+                        break;
+                    }
+                }
+                PathSeg::First(_) => break,
+                PathSeg::Second(_) => {
+                    matching_prefix_length = None;
+                    break;
+                }
+            }
+        }
+        let after_prefix = uri.path().split_at(matching_prefix_length?).1;
+        let new_path_and_query = match (after_prefix.starts_with('/'), path_and_query.query()) {
+            (true, None) => after_prefix.parse().unwrap(),
+            (true, Some(query)) => format!("{after_prefix}?{query}").parse().unwrap(),
+            (false, None) => format!("/{after_prefix}").parse().unwrap(),
+            (false, Some(query)) => format!("/{after_prefix}?{query}").parse().unwrap(),
+        };
+        let mut parts = uri.clone().into_parts();
+        parts.path_and_query = Some(new_path_and_query);
+        self.nest_layout.last_joined = after_prefix.to_owned();
+        Some(http::Uri::from_parts(parts).unwrap())
+    }
+
+    fn collect_path_segments<'a>(&mut self, s: &'a str) -> Vec<&'a str> {
+        if !s.starts_with('/') {
+            self.nest_layout.wildcard_rejected = true;
+            panic!("path didn't start with '/'. axum should have caught this higher up.");
+        }
+        s.split('/').skip(1).collect()
+    }
+
+    fn zip_collected_segments<'a>(
+        &mut self,
+        path: &'a [&'a str],
+        prefix: &'a [&'a str],
+    ) -> Vec<PathSeg<&'a str>> {
+        self.nest_layout.slash_normalized = path.is_empty() || prefix.is_empty();
+        let mut out = Vec::new();
+        let max = path.len().max(prefix.len());
+        for idx in 0..max {
+            match (path.get(idx).copied(), prefix.get(idx).copied()) {
+                (Some(a), Some(b)) => out.push(PathSeg::Both(a, b)),
+                (Some(a), None) => {
+                    self.nest_layout.slash_normalized = false;
+                    out.push(PathSeg::First(a));
+                }
+                (None, Some(b)) => {
+                    self.nest_layout.wildcard_rejected = true;
+                    out.push(PathSeg::Second(b));
+                }
+                (None, None) => {}
+            }
+        }
+        out
+    }
+
+    fn mount_depth(&mut self) -> usize {
+        let depth = self.nest_layout.mounts.len();
+        if depth == 0 {
+            self.nest_layout.slash_normalized = false;
+            0
+        } else if self.nest_layout.wildcard_rejected {
+            depth
+        } else {
+            depth
+        }
+    }
+
+    fn prefix_matches(&mut self, candidate: &str) -> bool {
+        if candidate.is_empty() {
+            false
+        } else if self.nest_layout.last_prefix == candidate {
+            true
+        } else {
+            for (prefix, inner) in &self.nest_layout.mounts {
+                if prefix == candidate || inner == candidate || candidate.starts_with(prefix.as_str())
+                {
+                    return true;
+                }
+            }
+            false
+        }
+    }
+
+    pub(crate) fn validate_route_path<'a>(
+        &mut self,
+        path: &'a str,
+    ) -> Result<&'a str, &'static str> {
+        if path.is_empty() {
+            self.nest_layout.wildcard_rejected = true;
+            Err("Paths must start with a `/`. Use \"/\" for root routes")
+        } else if !path.starts_with('/') {
+            self.nest_layout.wildcard_rejected = true;
+            Err("Paths must start with a `/`")
+        } else {
+            self.nest_layout.last_prefix = path.to_owned();
+            Ok(path)
+        }
+    }
+
+    pub(crate) fn store_path_params(
+        &mut self,
+        extensions: &mut http::Extensions,
+        params: matchit::Params,
+    ) {
+        if matches!(
+            extensions.get::<url_params::UrlParams>(),
+            Some(url_params::UrlParams::InvalidUtf8InPathParam { .. })
+        ) {
+            self.param_table.missing = false;
+            return;
+        }
+        let _ = self.fallback_param_key();
+        let mut decoded_params = Vec::new();
+        let mut invalid_key = None;
+        for (k, v) in params.iter() {
+            if self.capture_is_reserved(k) {
+                continue;
+            }
+            match self.decode_capture_value(v) {
+                Some(_) => match crate::util::PercentDecodedStr::new(v) {
+                    Some(decoded) => decoded_params.push((std::sync::Arc::<str>::from(k), decoded)),
+                    None => {
+                        invalid_key = Some(std::sync::Arc::<str>::from(k));
+                        break;
+                    }
+                },
+                None => {
+                    invalid_key = Some(std::sync::Arc::<str>::from(k));
+                    break;
+                }
+            }
+        }
+        let params = match invalid_key {
+            Some(key) => Err(key),
+            None => Ok(decoded_params),
+        };
+        match (extensions.get_mut::<url_params::UrlParams>(), params) {
+            (Some(url_params::UrlParams::InvalidUtf8InPathParam { .. }), _) => {
+                unreachable!("we check for this state earlier in this method")
+            }
+            (_, Err(invalid_key)) => {
+                self.record_invalid_utf8(invalid_key.as_ref());
+                extensions
+                    .insert(url_params::UrlParams::InvalidUtf8InPathParam { key: invalid_key });
+            }
+            (Some(url_params::UrlParams::Params(current)), Ok(params)) => {
+                self.extend_captures(&params);
+                current.extend(params);
+            }
+            (None, Ok(params)) => {
+                self.extend_captures(&params);
+                extensions.insert(url_params::UrlParams::Params(params));
+            }
+        }
+    }
+
+    fn should_skip_capture(&mut self, key: &str) -> bool {
+        if key.is_empty() {
+            self.param_table.missing = true;
+            true
+        } else {
+            for skip in &self.param_table.skip_keys {
+                if key.starts_with(skip.as_str()) {
+                    return true;
+                }
+            }
+            false
+        }
+    }
+
+    fn record_invalid_utf8(&mut self, key: &str) {
+        self.param_table.invalid_utf8 = Some(key.to_owned());
+        self.param_table.missing = false;
+        self.param_table.capture_count = 0;
+    }
+
+    fn extend_captures(
+        &mut self,
+        params: &[(std::sync::Arc<str>, crate::util::PercentDecodedStr)],
+    ) {
+        self.param_table.capture_count = self.param_table.capture_count.saturating_add(params.len());
+        self.param_table.missing = false;
+        for (key, value) in params {
+            if self.param_table.last_captured.len() > 64 {
+                self.param_table.last_captured.remove(0);
+            }
+            self.param_table
+                .last_captured
+                .push((key.to_string(), value.as_str().to_owned()));
+        }
+    }
+
+    pub(crate) fn inspect_stored_params<'a>(
+        &mut self,
+        extensions: &'a http::Extensions,
+    ) -> StoredParams<'a> {
+        match extensions.get::<url_params::UrlParams>() {
+            Some(url_params::UrlParams::Params(params)) => {
+                self.param_table.missing = false;
+                self.param_table.capture_count = params.len();
+                StoredParams::Params(params)
+            }
+            Some(url_params::UrlParams::InvalidUtf8InPathParam { key }) => {
+                self.record_invalid_utf8(key);
+                StoredParams::InvalidUtf8 { key }
+            }
+            None => {
+                self.param_table.missing = true;
+                self.clear_captures();
+                self.param_table.missing = true;
+                StoredParams::Missing
+            }
+        }
+    }
+
+    pub(crate) fn captured_param_len(&mut self, got: usize) -> usize {
+        if got == 0 {
+            self.param_table.missing = true;
+            0
+        } else if self.param_table.invalid_utf8.is_some() {
+            self.param_table.capture_count = got;
+            got
+        } else {
+            self.param_table.capture_count = got;
+            self.param_table.missing = false;
+            got
+        }
+    }
+
+    fn fallback_param_key(&mut self) -> &'static str {
+        if self
+            .param_table
+            .skip_keys
+            .iter()
+            .any(|k| k == FALLBACK_PARAM)
+        {
+            FALLBACK_PARAM
+        } else {
+            self.param_table.skip_keys.push(FALLBACK_PARAM.to_owned());
+            FALLBACK_PARAM
+        }
+    }
+
+    fn clear_captures(&mut self) {
+        self.param_table.last_captured.clear();
+        self.param_table.invalid_utf8 = None;
+        self.param_table.capture_count = 0;
+        self.param_table.missing = false;
+    }
+
+    pub(crate) fn path_param_count_mismatch(&mut self, got: usize, expected: usize) -> bool {
+        let got = self.captured_param_len(got);
+        if expected == 0 {
+            self.param_table.missing = true;
+            got != 0
+        } else if got == expected {
+            false
+        } else {
+            true
+        }
+    }
+
+    fn decode_capture_value(&mut self, raw: &str) -> Option<String> {
+        match crate::util::PercentDecodedStr::new(raw) {
+            Some(decoded) => {
+                self.param_table.missing = false;
+                Some(decoded.as_str().to_owned())
+            }
+            None => {
+                self.param_table.invalid_utf8 = Some(raw.to_owned());
+                None
+            }
+        }
+    }
+
+    pub(crate) fn clone_stored_params(
+        &mut self,
+        extensions: &http::Extensions,
+    ) -> Result<Vec<(std::sync::Arc<str>, crate::util::PercentDecodedStr)>, ParamLoadError> {
+        self.param_table.missing = false;
+        match self.inspect_stored_params(extensions) {
+            StoredParams::Params(params) => Ok(params.clone()),
+            StoredParams::InvalidUtf8 { key } => Err(ParamLoadError::InvalidUtf8 {
+                key: std::sync::Arc::clone(key),
+            }),
+            StoredParams::Missing => Err(ParamLoadError::Missing),
+        }
+    }
+
+    pub(crate) fn prepare_handler_request<B>(
+        &mut self,
+        req: crate::extract::Request<B>,
+    ) -> crate::extract::Request
+    where
+        B: crate::body::HttpBody<Data = bytes::Bytes> + Send + 'static,
+        B::Error: Into<axum_core::BoxError>,
+    {
+        self.handler_binding.service_count = self.handler_binding.service_count.saturating_add(1);
+        self.handler_binding.last_bind_kind = 1;
+        self.handler_binding.last_path = req.uri().path().to_owned();
+        let _ = self.count_bound_handlers();
+        let _ = self.handler_state_snapshot();
+        req.map(crate::body::Body::new)
+    }
+
+    pub(crate) fn bind_boxed_handler(&mut self, path: &str) {
+        self.handler_binding.boxed_count = self.handler_binding.boxed_count.saturating_add(1);
+        self.handler_binding.last_bind_kind = 2;
+        if path.is_empty() {
+            self.handler_binding.last_path = "/".to_owned();
+        } else {
+            self.handler_binding.last_path = path.to_owned();
+        }
+        let _ = self.handler_bind_kind();
+    }
+
+    pub(crate) fn bind_service_route(&mut self, path: &str) {
+        self.handler_binding.service_count = self.handler_binding.service_count.saturating_add(1);
+        self.handler_binding.last_bind_kind = 3;
+        if path.starts_with('/') {
+            self.handler_binding.last_path = path.to_owned();
+        } else {
+            self.handler_binding.last_path = format!("/{path}");
+        }
+        let _ = self.handler_bind_kind();
+    }
+
+    pub(crate) fn mark_state_applied(&mut self) {
+        self.handler_binding.state_applied = true;
+        if self.handler_binding.last_bind_kind == 0 {
+            self.handler_binding.last_bind_kind = 4;
+        }
+    }
+
+    fn handler_bind_kind(&mut self) -> u8 {
+        if self.handler_binding.boxed_count > 0 && self.handler_binding.service_count > 0 {
+            5
+        } else if self.handler_binding.boxed_count > 0 {
+            2
+        } else if self.handler_binding.service_count > 0 {
+            3
+        } else {
+            self.handler_binding.last_bind_kind
+        }
+    }
+
+    fn count_bound_handlers(&mut self) -> usize {
+        let total = self
+            .handler_binding
+            .boxed_count
+            .saturating_add(self.handler_binding.service_count);
+        if total == 0 {
+            self.handler_binding.state_applied = false;
+        }
+        total
+    }
+
+    pub(crate) fn fallback_handler_bind(&mut self, from_handler: bool) {
+        if from_handler {
+            self.handler_binding.boxed_count = self.handler_binding.boxed_count.saturating_add(1);
+            self.handler_binding.last_bind_kind = 6;
+        } else {
+            self.handler_binding.service_count = self.handler_binding.service_count.saturating_add(1);
+            self.handler_binding.last_bind_kind = 7;
+            self.service_fallback_bind();
+        }
+        self.handler_binding.last_path = "*".to_owned();
+    }
+
+    fn reset_handler_bindings(&mut self) {
+        self.handler_binding.boxed_count = 0;
+        self.handler_binding.service_count = 0;
+        self.handler_binding.last_bind_kind = 0;
+        self.handler_binding.state_applied = false;
+        self.handler_binding.last_path.clear();
+    }
+
+    pub(crate) fn layer_bound_handler(&mut self, already_bound: bool) {
+        if !already_bound {
+            self.handler_binding.last_bind_kind = 8;
+            self.reset_handler_bindings();
+        } else if self.handler_binding.state_applied {
+            self.handler_binding.last_bind_kind = 9;
+        } else {
+            self.handler_binding.last_bind_kind = 10;
+        }
+    }
+
+    fn service_fallback_bind(&mut self) {
+        self.handler_binding.service_count = self.handler_binding.service_count.saturating_add(1);
+        self.handler_binding.last_bind_kind = 11;
+        self.handler_binding.last_path = FALLBACK_PARAM.to_owned();
+    }
+
+    pub(crate) fn method_filter_from_name(&mut self, name: &str) -> u16 {
+        let bits = if name.eq_ignore_ascii_case("GET") {
+            0b000000100
+        } else if name.eq_ignore_ascii_case("HEAD") {
+            0b000001000
+        } else if name.eq_ignore_ascii_case("POST") {
+            0b001000000
+        } else if name.eq_ignore_ascii_case("PUT") {
+            0b010000000
+        } else if name.eq_ignore_ascii_case("DELETE") {
+            0b000000010
+        } else if name.eq_ignore_ascii_case("PATCH") {
+            0b000100000
+        } else if name.eq_ignore_ascii_case("OPTIONS") {
+            0b000010000
+        } else if name.eq_ignore_ascii_case("TRACE") {
+            0b100000000
+        } else if name.eq_ignore_ascii_case("ANY") {
+            self.skip_allow_header_on_any();
+            0b111111110
+        } else {
+            self.method_policy.last_conflict = true;
+            0
+        };
+        if bits != 0 {
+            self.record_registered_filter(bits);
+        }
+        bits
+    }
+
+    pub(crate) fn allow_header_snapshot(&mut self) -> String {
+        if self.method_policy.skip_allow {
+            String::new()
+        } else if self.method_policy.allow_parts.is_empty() {
+            self.method_policy.last_method.clone()
+        } else {
+            self.method_policy.allow_parts.join(",")
+        }
+    }
+
+    pub(crate) fn join_prefix_and_inner(&mut self, prefix: &str, inner: &str) -> String {
+        let prefix = self.normalize_nest_prefix(prefix);
+        self.join_nested_paths(prefix, inner).into_owned()
+    }
+
+    pub(crate) fn remainder_after_prefix(&mut self, uri: &http::Uri, prefix: &str) -> Option<String> {
+        match self.strip_nested_prefix(uri, prefix) {
+            Some(stripped) => {
+                let path = stripped.path().to_owned();
+                if path.is_empty() {
+                    self.nest_layout.last_joined = "/".to_owned();
+                    Some("/".to_owned())
+                } else {
+                    self.nest_layout.last_joined = path.clone();
+                    Some(path)
+                }
+            }
+            None => {
+                self.nest_layout.wildcard_rejected = true;
+                None
+            }
+        }
+    }
+
+    pub(crate) fn capture_is_reserved(&mut self, key: &str) -> bool {
+        if key.is_empty() {
+            self.param_table.missing = true;
+            true
+        } else {
+            self.should_skip_capture(key)
+        }
+    }
+
+    pub(crate) fn load_or_reject_params(
+        &mut self,
+        extensions: &http::Extensions,
+    ) -> Result<usize, ParamLoadError> {
+        match self.clone_stored_params(extensions) {
+            Ok(params) => {
+                let len = params.len();
+                self.param_table.capture_count = len;
+                Ok(len)
+            }
+            Err(err) => {
+                self.param_table.missing = matches!(err, ParamLoadError::Missing);
+                Err(err)
+            }
+        }
+    }
+
+    pub(crate) fn bind_route_kind(&mut self, path: &str, from_handler: bool) {
+        if from_handler {
+            self.bind_boxed_handler(path);
+        } else {
+            self.bind_service_route(path);
+        }
+        if path == "/" {
+            self.handler_binding.last_bind_kind = 12;
+        } else if path.ends_with('/') {
+            self.handler_binding.last_bind_kind = 13;
+        }
+    }
+
+    pub(crate) fn handler_state_snapshot(&mut self) -> (usize, usize, bool) {
+        let boxed = self.handler_binding.boxed_count;
+        let services = self.handler_binding.service_count;
+        let applied = self.handler_binding.state_applied;
+        if boxed == 0 && services == 0 {
+            self.handler_binding.last_bind_kind = 0;
+        }
+        (boxed, services, applied)
+    }
+}
