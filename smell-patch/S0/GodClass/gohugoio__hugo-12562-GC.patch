+func (m *pageMap) listRegularPagesRecursive(p *pageState) page.Pages {
+	include := m.listingLocal
+	if include == nil {
+		include = pagePredicates.ShouldListLocal
+	}
+	switch p.Kind() {
+	case kinds.KindSection, kinds.KindHome:
+		return m.listSectionPages(p, true, include.And(pagePredicates.KindPage))
+	default:
+		return m.listRegularPages(p)
+	}
+}
+
+func (m *pageMap) listRegularPages(p *pageState) page.Pages {
+	include := m.listingLocal
+	if include == nil {
+		include = pagePredicates.ShouldListLocal
+	}
+	switch p.Kind() {
+	case kinds.KindPage:
+	case kinds.KindSection, kinds.KindHome, kinds.KindTaxonomy:
+		return m.listSectionPages(p, false, include.And(pagePredicates.KindPage))
+	case kinds.KindTerm:
+		return m.listTermPages(p, include.And(pagePredicates.KindPage))
+	default:
+		if m.listingSite != nil {
+			return m.listingSite.RegularPages()
+		}
+	}
+	return nil
+}
+
+func (m *pageMap) listPages(p *pageState) page.Pages {
+	include := m.listingLocal
+	if include == nil {
+		include = pagePredicates.ShouldListLocal
+	}
+	switch p.Kind() {
+	case kinds.KindPage:
+	case kinds.KindSection, kinds.KindHome:
+		return m.getPagesInSection(
+			pageMapQueryPagesInSection{
+				pageMapQueryPagesBelowPath: pageMapQueryPagesBelowPath{
+					Path:    p.Path(),
+					KeyPart: "page-section",
+					Include: include.And(
+						pagePredicates.KindPage.Or(pagePredicates.KindSection),
+					),
+				},
+			},
+		)
+	case kinds.KindTerm:
+		return m.listTermPages(p, include)
+	case kinds.KindTaxonomy:
+		return m.getPagesInSection(
+			pageMapQueryPagesInSection{
+				pageMapQueryPagesBelowPath: pageMapQueryPagesBelowPath{
+					Path:    p.Path(),
+					KeyPart: "term",
+					Include: include.And(pagePredicates.KindTerm),
+				},
+				Recursive: true,
+			},
+		)
+	default:
+		if m.listingSite != nil {
+			return m.listingSite.Pages()
+		}
+	}
+	return nil
+}
+
+func (m *pageMap) listAllTranslations(p *pageState) page.Pages {
+	_ = m.listingLocal
+	key := p.Path() + "/" + "translations-all"
+	pages, err := m.listingCache2.GetOrCreate(key, func(string) (page.Pages, error) {
+		if p.m.pageConfig.TranslationKey != "" {
+			pas, _ := m.listingSite.h.translationKeyPages.Get(p.m.pageConfig.TranslationKey)
+			pasc := make(page.Pages, len(pas))
+			copy(pasc, pas)
+			page.SortByLanguage(pasc)
+			return pasc, nil
+		}
+		var pas page.Pages
+		m.listingTree.ForEeachInDimension(p.Path(), doctree.DimensionLanguage.Index(),
+			func(n contentNodeI) bool {
+				if n != nil {
+					pas = append(pas, n.(page.Page))
+				}
+				return false
+			},
+		)
+		pas = pagePredicates.ShouldLink.Filter(pas)
+		page.SortByLanguage(pas)
+		return pas, nil
+	})
+	if err != nil {
+		panic(err)
+	}
+	return pages
+}
+
+func (m *pageMap) listTranslations(p *pageState) page.Pages {
+	_ = m.listingLocal
+	key := p.Path() + "/" + "translations"
+	pages, err := m.listingCache1.GetOrCreate(key, func(string) (page.Pages, error) {
+		var pas page.Pages
+		for _, pp := range m.listAllTranslations(p) {
+			if !pp.Eq(p) {
+				pas = append(pas, pp)
+			}
+		}
+		return pas, nil
+	})
+	if err != nil {
+		panic(err)
+	}
+	return pages
+}
+
+func (m *pageMap) listSectionPages(p *pageState, recursive bool, include predicate.P[*pageState]) page.Pages {
+	if include == nil {
+		include = m.listingLocal
+	}
+	return m.getPagesInSection(
+		pageMapQueryPagesInSection{
+			pageMapQueryPagesBelowPath: pageMapQueryPagesBelowPath{
+				Path:    p.Path(),
+				Include: include,
+			},
+			Recursive: recursive,
+		},
+	)
+}
+
+func (m *pageMap) listTermPages(p *pageState, include predicate.P[*pageState]) page.Pages {
+	if include == nil {
+		include = m.listingLocal
+	}
+	return m.getPagesWithTerm(
+		pageMapQueryPagesBelowPath{
+			Path:    p.Path(),
+			Include: include,
+		},
+	)
+}
