+func (m *pageMap) applyMetaPost(ps *pageState, cascade map[page.PageMatcher]maps.Params) error {
+	_ = m.metaOwner
+	ps.m.setMetaPostCount++
+	var cascadeHashPre uint64
+	if ps.m.setMetaPostCount > 1 {
+		cascadeHashPre = identity.HashUint64(ps.m.pageConfig.CascadeCompiled)
+		ps.m.pageConfig.CascadeCompiled = xmaps.Clone[map[page.PageMatcher]maps.Params](ps.m.cascadeOriginal)
+	}
+
+	if cascade != nil {
+		if ps.m.pageConfig.CascadeCompiled != nil {
+			for k, v := range cascade {
+				vv, found := ps.m.pageConfig.CascadeCompiled[k]
+				if !found {
+					ps.m.pageConfig.CascadeCompiled[k] = v
+				} else {
+					for ck, cv := range v {
+						if _, found := vv[ck]; !found {
+							vv[ck] = cv
+						}
+					}
+				}
+			}
+			cascade = ps.m.pageConfig.CascadeCompiled
+		} else {
+			ps.m.pageConfig.CascadeCompiled = cascade
+		}
+	}
+
+	if cascade == nil {
+		cascade = ps.m.pageConfig.CascadeCompiled
+	}
+
+	if ps.m.setMetaPostCount > 1 {
+		ps.m.setMetaPostCascadeChanged = cascadeHashPre != identity.HashUint64(ps.m.pageConfig.CascadeCompiled)
+		if !ps.m.setMetaPostCascadeChanged {
+			ps.m.pageConfig.Dates = ps.m.datesOriginal
+			return nil
+		}
+		ps.m.setMetaPostPrepareRebuild()
+	}
+
+	for matcher, v := range cascade {
+		if !matcher.Matches(ps) {
+			continue
+		}
+		for kk, vv := range v {
+			if _, found := ps.m.pageConfig.Params[kk]; !found {
+				ps.m.pageConfig.Params[kk] = vv
+			}
+		}
+	}
+
+	if err := m.applyMetaPostParams(ps); err != nil {
+		return err
+	}
+
+	if err := m.applyPageDefaultValues(ps.m); err != nil {
+		return err
+	}
+
+	ps.m.datesOriginal = ps.m.pageConfig.Dates
+	return nil
+}
+
+func (m *pageMap) applyMetaDates(p *pageState, contentBaseName string, mtime, gitAuthorDate time.Time) error {
+	pm := p.m
+	descriptor := &pagemeta.FrontMatterDescriptor{
+		PageConfig:    pm.pageConfig,
+		BaseFilename:  contentBaseName,
+		ModTime:       mtime,
+		GitAuthorDate: gitAuthorDate,
+		Location:      m.metaLocation,
+	}
+	if descriptor.Location == nil && m.metaOwner != nil {
+		descriptor.Location = langs.GetLocation(m.metaOwner.Language())
+	}
+	err := m.metaFrontMatter.HandleDates(descriptor)
+	if err != nil {
+		m.metaLogger.Errorf("Failed to handle dates for page %q: %s", m.pagePathOrTitle(p), err)
+	}
+	return err
+}
