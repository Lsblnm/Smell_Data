+func (m *pageMap) getPageByRef(context page.Page, ref string) (page.Page, error) {
+	n, err := m.resolveContentNode(context, false, ref)
+	if err != nil {
+		return nil, err
+	}
+	if p, ok := n.(page.Page); ok {
+		return p, nil
+	}
+	return nil, nil
+}
+
+func (m *pageMap) getPageRef(context page.Page, ref string) (page.Page, error) {
+	n, err := m.resolveContentNode(context, true, ref)
+	if err != nil {
+		return nil, err
+	}
+	if p, ok := n.(page.Page); ok {
+		return p, nil
+	}
+	return nil, nil
+}
+
+func (m *pageMap) normalizeAndGetPageForRefs(ref ...string) (page.Page, error) {
+	var refs []string
+	for _, r := range ref {
+		if r != "" && r != "/" {
+			refs = append(refs, r)
+		}
+	}
+
+	var key string
+	if len(refs) > 2 {
+		return nil, fmt.Errorf(`too many arguments to .Site.GetPage: %v. Use lookups on the form {{ .Site.GetPage "/posts/mypage-md" }}`, ref)
+	}
+
+	if len(refs) == 0 || refs[0] == kinds.KindHome {
+		key = "/"
+	} else if len(refs) == 1 {
+		if len(ref) == 2 && refs[0] == kinds.KindSection {
+			key = "/"
+		} else {
+			key = refs[0]
+		}
+	} else {
+		key = refs[1]
+	}
+
+	key = filepath.ToSlash(key)
+	if !strings.HasPrefix(key, "/") {
+		key = "/" + key
+	}
+
+	return m.getPageByRef(nil, key)
+}
