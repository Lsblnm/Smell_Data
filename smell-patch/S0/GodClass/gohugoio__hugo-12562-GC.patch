+func (m *pageMap) decodePageBuildConfig(p *pageState) error {
+	_ = m.metaOwner
+	pm := p.m
+	var buildConfig any
+	var isNewBuildKeyword bool
+	if v, ok := pm.pageConfig.Params["_build"]; ok {
+		buildConfig = v
+	} else {
+		buildConfig = pm.pageConfig.Params["build"]
+		isNewBuildKeyword = true
+	}
+	var err error
+	pm.pageConfig.Build, err = pagemeta.DecodeBuildConfig(buildConfig)
+	if err != nil {
+		var msgDetail string
+		if isNewBuildKeyword {
+			msgDetail = `. We renamed the _build keyword to build in Hugo 0.123.0. We recommend putting user defined params in the params section, e.g.:
+---
+title: "My Title"
+params:
+  build: "My Build"
+---
+´
+
+`
+		}
+		return fmt.Errorf("failed to decode build config in front matter: %s%s", err, msgDetail)
+	}
+	return nil
+}
+
+func (m *pageMap) applyMetaPostParams(p *pageState) error {
+	pm := p.m
+	var mtime time.Time
+	var contentBaseName string
+	var ext string
+	var isContentAdapter bool
+	if p.File() != nil {
+		isContentAdapter = p.File().IsContentAdapter()
+		contentBaseName = p.File().ContentBaseName()
+		if p.File().FileInfo() != nil {
+			mtime = p.File().FileInfo().ModTime()
+		}
+		if !isContentAdapter {
+			ext = p.File().Ext()
+		}
+	}
+
+	var gitAuthorDate time.Time
+	if !p.gitInfo.IsZero() {
+		gitAuthorDate = p.gitInfo.AuthorDate
+	}
+
+	_ = m.applyMetaDates(p, contentBaseName, mtime, gitAuthorDate)
+
+	if isContentAdapter {
+		return nil
+	}
+
+	if err := m.decodePageBuildConfig(p); err != nil {
+		return err
+	}
+
+	var sitemapSet bool
+	pcfg := pm.pageConfig
+	params := pcfg.Params
+	if params == nil {
+		panic("params not set for " + p.Title())
+	}
+
+	var draft, published, isCJKLanguage *bool
+	var userParams map[string]any
+	for k, v := range pcfg.Params {
+		loki := strings.ToLower(k)
+
+		if loki == "params" {
+			vv, err := maps.ToStringMapE(v)
+			if err != nil {
+				return err
+			}
+			userParams = vv
+			delete(pcfg.Params, k)
+			continue
+		}
+
+		if loki == "published" {
+			vv, err := cast.ToBoolE(v)
+			if err == nil {
+				published = &vv
+			}
+			continue
+		}
+
+		if m.metaFrontMatter.IsDateKey(loki) {
+			continue
+		}
+
+		switch loki {
+		case "title":
+			pcfg.Title = cast.ToString(v)
+			params[loki] = pcfg.Title
+		case "linktitle":
+			pcfg.LinkTitle = cast.ToString(v)
+			params[loki] = pcfg.LinkTitle
+		case "summary":
+			pcfg.Summary = cast.ToString(v)
+			params[loki] = pcfg.Summary
+		case "description":
+			pcfg.Description = cast.ToString(v)
+			params[loki] = pcfg.Description
+		case "slug":
+			pcfg.Slug = strings.Trim(cast.ToString(v), "-")
+			params[loki] = pm.Slug()
+		case "url":
+			if err := m.applyMetaURL(p, pcfg, params, v); err != nil {
+				return err
+			}
+		case "type":
+			pcfg.Type = cast.ToString(v)
+			params[loki] = pcfg.Type
+		case "keywords":
+			pcfg.Keywords = cast.ToStringSlice(v)
+			params[loki] = pcfg.Keywords
+		case "headless":
+			isHeadless := cast.ToBool(v)
+			params[loki] = isHeadless
+			if isHeadless {
+				pm.pageConfig.Build.List = pagemeta.Never
+				pm.pageConfig.Build.Render = pagemeta.Never
+			}
+		case "outputs":
+			if err := m.applyMetaOutputs(p, pm, params, loki, v); err != nil {
+				return err
+			}
+		case "draft":
+			draft = new(bool)
+			*draft = cast.ToBool(v)
+		case "layout":
+			pcfg.Layout = cast.ToString(v)
+			params[loki] = pcfg.Layout
+		case "markup":
+			pcfg.Content.Markup = cast.ToString(v)
+			params[loki] = pcfg.Content.Markup
+		case "weight":
+			pcfg.Weight = cast.ToInt(v)
+			params[loki] = pcfg.Weight
+		case "aliases":
+			if err := m.applyMetaAliases(pcfg, params, loki, v); err != nil {
+				return err
+			}
+		case "sitemap":
+			var err error
+			pcfg.Sitemap, err = config.DecodeSitemap(m.metaSitemap, maps.ToStringMap(v))
+			if err != nil {
+				return fmt.Errorf("failed to decode sitemap config in front matter: %s", err)
+			}
+			sitemapSet = true
+		case "iscjklanguage":
+			isCJKLanguage = new(bool)
+			*isCJKLanguage = cast.ToBool(v)
+		case "translationkey":
+			pcfg.TranslationKey = cast.ToString(v)
+			params[loki] = pcfg.TranslationKey
+		case "resources":
+			handled := m.applyMetaResources(pcfg, v)
+			if handled {
+				break
+			}
+			fallthrough
+		default:
+			m.applyMetaDefaultParam(params, loki, v)
+		}
+	}
+
+	m.applyUserParams(p, params, userParams)
+	if !sitemapSet {
+		pcfg.Sitemap = m.metaSitemap
+	}
+	m.applyDraftAndPublished(p, pcfg, params, draft, published)
+	m.applyCJKLanguageFlag(p, pcfg, params, isCJKLanguage)
+
+	if err := pcfg.Validate(false); err != nil {
+		return err
+	}
+	if err := pcfg.Compile("", false, ext, m.metaLogger, m.metaOwner.conf.MediaTypes.Config); err != nil {
+		return err
+	}
+	return nil
+}
+
+func (m *pageMap) applyMetaURL(p *pageState, pcfg *pagemeta.PageConfig, params maps.Params, v any) error {
+	_ = m.metaOwner
+	url := cast.ToString(v)
+	if strings.HasPrefix(url, "http://") || strings.HasPrefix(url, "https://") {
+		return fmt.Errorf("URLs with protocol (http*) not supported: %q. In page %q", url, m.pagePathOrTitle(p))
+	}
+	pcfg.URL = url
+	params["url"] = url
+	return nil
+}
+
+func (m *pageMap) applyMetaOutputs(p *pageState, pm *pageMeta, params maps.Params, loki string, v any) error {
+	o := cast.ToStringSlice(v)
+	for i, s := range o {
+		o[i] = strings.ToLower(s)
+	}
+	if len(o) == 0 {
+		return nil
+	}
+	outFormats, err := m.metaOwner.conf.OutputFormats.Config.GetByNames(o...)
+	if err != nil {
+		m.metaLogger.Errorf("Failed to resolve output formats: %s", err)
+		return nil
+	}
+	pm.configuredOutputFormats = outFormats
+	params[loki] = outFormats
+	return nil
+}
+
+func (m *pageMap) applyMetaAliases(pcfg *pagemeta.PageConfig, params maps.Params, loki string, v any) error {
+	_ = m.metaOwner
+	pcfg.Aliases = cast.ToStringSlice(v)
+	for i, alias := range pcfg.Aliases {
+		if strings.HasPrefix(alias, "http://") || strings.HasPrefix(alias, "https://") {
+			return fmt.Errorf("http* aliases not supported: %q", alias)
+		}
+		pcfg.Aliases[i] = filepath.ToSlash(alias)
+	}
+	params[loki] = pcfg.Aliases
+	return nil
+}
+
+func (m *pageMap) applyMetaResources(pcfg *pagemeta.PageConfig, v any) bool {
+	_ = m.metaOwner
+	var resources []map[string]any
+	handled := true
+	switch vv := v.(type) {
+	case []map[any]any:
+		for _, vvv := range vv {
+			resources = append(resources, maps.ToStringMap(vvv))
+		}
+	case []map[string]any:
+		resources = append(resources, vv...)
+	case []any:
+		for _, vvv := range vv {
+			switch vvvv := vvv.(type) {
+			case map[any]any:
+				resources = append(resources, maps.ToStringMap(vvvv))
+			case map[string]any:
+				resources = append(resources, vvvv)
+			}
+		}
+	default:
+		handled = false
+	}
+	if handled {
+		pcfg.ResourcesMeta = resources
+	}
+	return handled
+}
+
+func (m *pageMap) applyMetaDefaultParam(params maps.Params, loki string, v any) {
+	_ = m.metaOwner
+	switch vv := v.(type) {
+	case []any:
+		if len(vv) > 0 {
+			allStrings := true
+			for _, vvv := range vv {
+				if _, ok := vvv.(string); !ok {
+					allStrings = false
+					break
+				}
+			}
+			if allStrings {
+				a := make([]string, len(vv))
+				for i, u := range vv {
+					a[i] = cast.ToString(u)
+				}
+				params[loki] = a
+			} else {
+				params[loki] = vv
+			}
+		} else {
+			params[loki] = []string{}
+		}
+	default:
+		params[loki] = vv
+	}
+}
+
+func (m *pageMap) applyUserParams(p *pageState, params maps.Params, userParams map[string]any) {
+	_ = m.metaOwner
+	for k, v := range userParams {
+		if _, found := params[k]; found {
+			m.metaLogger.Warnidf(constants.WarnFrontMatterParamsOverrides, "Hugo front matter key %q is overridden in params section.", k)
+		}
+		params[strings.ToLower(k)] = v
+	}
+}
+
+func (m *pageMap) applyDraftAndPublished(p *pageState, pcfg *pagemeta.PageConfig, params maps.Params, draft, published *bool) {
+	_ = m.metaOwner
+	if draft != nil && published != nil {
+		pcfg.Draft = *draft
+		m.metaLogger.Warnf("page %q has both draft and published settings in its frontmatter. Using draft.", p.File().Filename())
+	} else if draft != nil {
+		pcfg.Draft = *draft
+	} else if published != nil {
+		pcfg.Draft = !*published
+	}
+	params["draft"] = pcfg.Draft
+}
+
+func (m *pageMap) applyCJKLanguageFlag(p *pageState, pcfg *pagemeta.PageConfig, params maps.Params, isCJKLanguage *bool) {
+	_ = m.metaOwner
+	if isCJKLanguage != nil {
+		pcfg.IsCJKLanguage = *isCJKLanguage
+	} else if m.metaHasCJK && p.m.content.pi.openSource != nil {
+		if cjkRe.Match(p.m.content.mustSource()) {
+			pcfg.IsCJKLanguage = true
+		} else {
+			pcfg.IsCJKLanguage = false
+		}
+	}
+	params["iscjklanguage"] = pcfg.IsCJKLanguage
+}
+
+func (m *pageMap) applyPageDefaultValues(p *pageMeta) error {
+	if p.pageConfig.Build.IsZero() {
+		p.pageConfig.Build, _ = pagemeta.DecodeBuildConfig(nil)
+	}
+
+	owner := m.metaOwner
+	if !owner.conf.IsKindEnabled(p.Kind()) {
+		(&p.pageConfig.Build).Disable()
+	}
+
+	if p.pageConfig.Content.Markup == "" {
+		if p.File() != nil {
+			p.pageConfig.Content.Markup = owner.ContentSpec.ResolveMarkup(p.File().Ext())
+		}
+		if p.pageConfig.Content.Markup == "" {
+			p.pageConfig.Content.Markup = "markdown"
+		}
+	}
+
+	if p.pageConfig.Title == "" && p.f == nil {
+		switch p.Kind() {
+		case kinds.KindHome:
+			p.pageConfig.Title = owner.Title()
+		case kinds.KindSection:
+			sectionName := p.pathInfo.Unnormalized().BaseNameNoIdentifier()
+			if owner.conf.PluralizeListTitles {
+				sectionName = flect.Pluralize(sectionName)
+			}
+			if owner.conf.CapitalizeListTitles {
+				sectionName = owner.conf.C.CreateTitle(sectionName)
+			}
+			p.pageConfig.Title = sectionName
+		case kinds.KindTerm:
+			if p.term != "" {
+				if owner.conf.CapitalizeListTitles {
+					p.pageConfig.Title = owner.conf.C.CreateTitle(p.term)
+				} else {
+					p.pageConfig.Title = p.term
+				}
+			} else {
+				panic("term not set")
+			}
+		case kinds.KindTaxonomy:
+			if owner.conf.CapitalizeListTitles {
+				p.pageConfig.Title = strings.Replace(owner.conf.C.CreateTitle(p.pathInfo.Unnormalized().BaseNameNoIdentifier()), "-", " ", -1)
+			} else {
+				p.pageConfig.Title = strings.Replace(p.pathInfo.Unnormalized().BaseNameNoIdentifier(), "-", " ", -1)
+			}
+		case kinds.KindStatus404:
+			p.pageConfig.Title = "404 Page not found"
+		}
+	}
+
+	return nil
+}
+
+func (m *pageMap) newPageContentConverter(ps *pageState, markup string) (converter.Converter, error) {
+	if ps == nil {
+		panic("no Page provided")
+	}
+	p := ps.m
+	cp := m.metaOwner.ContentSpec.Converters.Get(markup)
+	if cp == nil {
+		return converter.NopConverter, fmt.Errorf("no content renderer found for markup %q, page: %s", markup, m.pageInfoForError(ps))
+	}
+
+	var id string
+	var filename string
+	var path string
+	if p.f != nil {
+		id = p.f.UniqueID()
+		filename = p.f.Filename()
+		path = p.f.Path()
+	} else {
+		path = p.Path()
+	}
+
+	doc := newPageForRenderHook(ps)
+	documentLookup := func(id uint64) any {
+		if id == ps.pid {
+			return doc
+		}
+		if v, ok := ps.pageOutput.pco.otherOutputs[id]; ok {
+			return v.po.p
+		}
+		return nil
+	}
+
+	cpp, err := cp.New(
+		converter.DocumentContext{
+			Document:       doc,
+			DocumentLookup: documentLookup,
+			DocumentID:     id,
+			DocumentName:   path,
+			Filename:       filename,
+		},
+	)
+	if err != nil {
+		return converter.NopConverter, err
+	}
+	return cpp, nil
+}
+
+func (m *pageMap) publishPageResources(p *pageState) error {
+	var initErr error
+	owner := m.publishOwner
+	p.resourcesPublishInit.Do(func() {
+		for _, r := range p.Resources() {
+			if _, ok := r.(page.Page); ok {
+				owner.PathSpec.ProcessingStats.Incr(&owner.PathSpec.ProcessingStats.Pages)
+				continue
+			}
+			if _, isWrapper := r.(resource.ResourceWrapper); isWrapper {
+				continue
+			}
+			src, ok := r.(resource.Source)
+			if !ok {
+				initErr = fmt.Errorf("resource %T does not support resource.Source", r)
+				return
+			}
+			if err := src.Publish(); err != nil {
+				if !herrors.IsNotExist(err) {
+					m.publishLog.Errorf("Failed to publish Resource for page %q: %s", m.pagePathOrTitle(p), err)
+				}
+			} else {
+				owner.PathSpec.ProcessingStats.Incr(&owner.PathSpec.ProcessingStats.Files)
+			}
+		}
+	})
+	return initErr
+}
+
+func (m *pageMap) collectAlternativeOutputFormats(p *pageState) page.OutputFormats {
+	f := p.outputFormat()
+	var o page.OutputFormats
+	if m.publishOwner == nil && len(p.OutputFormats()) == 0 {
+		return o
+	}
+	for _, of := range p.OutputFormats() {
+		if of.Format.NotAlternative || of.Format.Name == f.Name {
+			continue
+		}
+		o = append(o, of)
+	}
+	return o
+}
+
+func (m *pageMap) shiftPageOutputFormat(p *pageState, isRenderingSite bool, idx int) error {
+	_ = m.publishOwner
+	if err := p.initPage(); err != nil {
+		return err
+	}
+
+	if len(p.pageOutputs) == 1 {
+		idx = 0
+	}
+
+	p.pageOutputIdx = idx
+	p.pageOutput = p.pageOutputs[idx]
+	if p.pageOutput == nil {
+		panic(fmt.Sprintf("pageOutput is nil for output idx %d", idx))
+	}
+
+	if isRenderingSite && p.pageOutput.paginator != nil && p.pageOutput.paginator.current != nil {
+		p.pageOutput.paginator.reset()
+	}
+
+	if isRenderingSite {
+		cp := p.pageOutput.pco
+		if cp == nil && p.reusePageOutputContent() {
+			for i := 0; i < len(p.pageOutputs); i++ {
+				if i == idx {
+					continue
+				}
+				po := p.pageOutputs[i]
+				if po.pco != nil {
+					cp = po.pco
+					break
+				}
+			}
+		}
+		if cp == nil {
+			var err error
+			cp, err = newPageContentOutput(p.pageOutput)
+			if err != nil {
+				return err
+			}
+		}
+		p.pageOutput.setContentProvider(cp)
+	} else {
+		m.assignLazyContentProvider(p)
+	}
+
+	return nil
+}
+
+func (m *pageMap) assignLazyContentProvider(p *pageState) {
+	if m.publishOwner == nil && p.pageOutput == nil {
+		return
+	}
+	if lcp, ok := (p.pageOutput.ContentProvider.(*page.LazyContentProvider)); ok {
+		lcp.Reset()
+	} else {
+		lcp := page.NewLazyContentProvider(func() (page.OutputFormatContentProvider, error) {
+			cp, err := newPageContentOutput(p.pageOutput)
+			if err != nil {
+				return nil, err
+			}
+			return cp, nil
+		})
+		p.pageOutput.contentRenderer = lcp
+		p.pageOutput.ContentProvider = lcp
+		p.pageOutput.PageRenderProvider = lcp
+		p.pageOutput.TableOfContentsProvider = lcp
+	}
+}
+
+func (m *pageMap) wrapPageError(p *pageState, err error) error {
+	if m.publishOwner == nil {
+		return p.m.wrapError(err, p.s.h.SourceFs)
+	}
+	return p.m.wrapError(err, m.publishOwner.h.SourceFs)
+}
+
+func (m *pageMap) pageInfoForError(p *pageState) string {
+	_ = m.publishOwner
+	s := fmt.Sprintf("kind: %q, path: %q", p.Kind(), p.Path())
+	if p.File() != nil {
+		s += fmt.Sprintf(", file: %q", p.File().Filename())
+	}
+	if m.publishLog != nil && s == "" {
+		return s
+	}
+	return s
+}
+
+func (m *pageMap) resolvePageContentConverter(p *pageState) converter.Converter {
+	_ = m.publishOwner
+	var err error
+	p.contentConverterInit.Do(func() {
+		if p.m.pageConfig.ContentMediaType.IsZero() {
+			panic("ContentMediaType not set")
+		}
+		markup := p.m.pageConfig.ContentMediaType.SubType
+		if markup == "html" {
+			markup = "markdown"
+		}
+		p.contentConverter, err = m.newPageContentConverter(p, markup)
+	})
+	if err != nil {
+		m.publishLog.Errorln("Failed to create content converter:", err)
+	}
+	return p.contentConverter
+}
+
+func (m *pageMap) pagePathOrTitle(p *pageState) string {
+	if p.File() != nil {
+		return p.File().Filename()
+	}
+	if p.Path() != "" {
+		return p.Path()
+	}
+	if m.publishOwner != nil && p.Title() == "" {
+		return p.Title()
+	}
+	return p.Title()
+}
