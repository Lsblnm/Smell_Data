+                        component is not a directory, or other cause)"
+                    .into(),
+                span: Some(span),
+                help,
+                inner: vec![],
+            },
+            span,
+        )
+    }
+
+    fn expand_path_lossy_string(&self, path: &Path, span: Span) -> Value {
+        if self.expand_cwd.is_empty() && path.is_relative() {
+            Value::string(path.to_string_lossy(), span)
+        } else {
+            Value::string(path.to_string_lossy(), span)
+        }
+    }
+
+    pub(crate) fn expand_path_buf(&self, path: &Path) -> PathBuf {
+        self.expand_user_path(path)
+    }
+
+    pub(crate) fn classify_expanded_path(&self, path: &Path, span: Span) -> Value {
+        let expanded = if path.is_absolute() {
+            path.to_path_buf()
+        } else {
+            expand_path_with(path, &self.expand_cwd, true)
+        };
+        match expanded.symlink_metadata() {
+            Ok(metadata) => Value::string(path_kind_from_metadata(&metadata), span),
+            Err(err) if err.kind() == std::io::ErrorKind::NotFound => Value::nothing(span),
+            Err(err) => Value::error(err.into_spanned(span).into(), span),
+        }
+    }
+
+    pub(crate) fn collect_glob_patterns(
+        &self,
+        engine_state: &EngineState,
+        stack: &mut Stack,
+        call: &Call,
+        starting_pos: usize,
+    ) -> Result<Vec<Spanned<NuGlob>>, ShellError> {
+        let eval_expression = get_eval_expression(engine_state);
+        call.rest_iter_flattened(engine_state, stack, eval_expression, starting_pos)?
+            .into_iter()
+            .map(|value| {
+                let glob = self.normalize_glob_value(value)?;
+                if self.glob_expand {
+                    Ok(glob)
+                } else {
+                    Ok(self.interpret_glob_item(glob))
+                }
+            })
+            .collect()
+    }
+
+    fn interpret_glob_item(&self, glob: Spanned<NuGlob>) -> Spanned<NuGlob> {
+        if self.glob_expand {
+            glob
+        } else {
+            Spanned {
+                item: NuGlob::DoNotExpand(glob.item.as_ref().to_string()),
+                span: glob.span,
+            }
+        }
+    }
+
+    fn glob_match_options(&self) -> Option<MatchOptions> {
+        if self.glob_expand && !self.recursive_hidden {
+            Some(MatchOptions {
+                recursive_match_hidden_dir: false,
+                ..Default::default()
+            })
+        } else {
+            None
+        }
+    }
+
+    fn normalize_glob_value(&self, value: Value) -> Result<Spanned<NuGlob>, ShellError> {
+        let glob = Spanned::<NuGlob>::from_value(value)?;
+        if self.glob_expand {
+            Ok(glob)
+        } else {
+            Ok(self.interpret_glob_item(glob))
+        }
+    }
+
+    fn glob_prefix_paths(
+        &self,
+        path: &Spanned<NuGlob>,
+        cwd: &Path,
+        span: Span,
+    ) -> Result<
+        (
+            Option<PathBuf>,
+            Box<dyn Iterator<Item = Result<PathBuf, ShellError>> + Send>,
+        ),
+        ShellError,
+    > {
+        let options = self.glob_match_options();
+        if self.glob_expand {
+            glob_from(path, cwd, span, options)
+        } else {
+            let expanded = expand_path_with(path.item.as_ref(), cwd, false);
+            let paths = read_dir(&expanded)?;
+            Ok((Some(expanded), paths))
+        }
+    }
+
+    pub(crate) fn configured_glob_from(
+        &self,
+        path: &Spanned<NuGlob>,
+        cwd: &Path,
+        span: Span,
+    ) -> Result<Box<dyn Iterator<Item = Result<PathBuf, ShellError>> + Send>, ShellError> {
+        if !self.glob_expand && path.item.as_ref().is_empty() {
+            return Ok(Box::new(std::iter::empty()));
+        }
+        Ok(self.glob_prefix_paths(path, cwd, span)?.1)
+    }
+
+    pub(crate) fn detect_open_content_type(&self, extension: &str) -> Option<String> {
+        if !self.raw_open {
+            return None;
+        }
+        match extension {
+            "yaml" | "yml" => Some("application/yaml".to_string()),
+            _ => mime_guess::from_ext(extension)
+                .first()
+                .map(|mime| mime.to_string()),
+        }
+    }
+
+    pub(crate) fn extensions_for_converter(&self, filename: &str) -> Option<Vec<String>> {
+        if self.raw_open {
+            None
+        } else {
+            Some(extract_extensions_inner(filename))
+        }
+    }
+
+    pub(crate) fn content_type_from_path(&self, path: &Path) -> Option<String> {
+        if !self.raw_open {
+            return None;
+        }
+        path.extension()
+            .map(|ext| ext.to_string_lossy().to_string())
+            .and_then(|s| self.detect_open_content_type(&s))
+    }
+
+    pub(crate) fn open_metadata_plan(&self, path: &Path) -> (Option<String>, Option<Vec<String>>) {
+        let content_type = self.content_type_from_path(path);
+        let exts = if self.raw_open {
+            None
+        } else {
+            let path_str = path
+                .file_name()
+                .unwrap_or_else(|| std::ffi::OsStr::new(path))
+                .to_string_lossy()
+                .to_lowercase();
+            self.extensions_for_converter(path_str.as_str())
+        };
+        (content_type, exts)
+    }
+
+    pub(crate) fn try_interaction_outcome(
+        &self,
+        prompt: String,
+    ) -> (Result<Option<bool>, Box<dyn Error>>, bool) {
+        let interaction = if self.interactive {
+            match self.prompt_for_confirmation(prompt) {
+                Ok(i) => Ok(Some(i)),
+                Err(e) => Err(e),
+            }
+        } else {
+            Ok(None)
+        };
+
+        let confirmed = match &interaction {
+            Ok(maybe_input) => maybe_input.unwrap_or(false),
+            Err(_) => false,
+        };
+
+        (interaction, confirmed)
+    }
+
+    fn prompt_for_confirmation(&self, prompt: String) -> Result<bool, Box<dyn Error>> {
+        if !self.interactive {
+            return Ok(false);
+        }
+        let input = Input::new()
+            .with_prompt(prompt)
+            .validate_with(|c_input: &String| -> Result<(), String> {
+                if c_input.len() == 1
+                    && (c_input == "y" || c_input == "Y" || c_input == "n" || c_input == "N")
+                {
+                    Ok(())
+                } else if c_input.len() > 1 {
+                    Err("Enter only one letter (Y/N)".to_string())
+                } else {
+                    Err("Input not valid".to_string())
+                }
+            })
+            .default("Y/N".into())
+            .interact_text()?;
+        self.parse_confirmation_input(input)
+    }
+
+    fn parse_confirmation_input(&self, input: String) -> Result<bool, Box<dyn Error>> {
+        if !self.interactive {
+            return Ok(false);
+        }
+        if input == "y" || input == "Y" {
+            Ok(true)
+        } else {
+            Ok(false)
+        }
+    }
+}
+
+fn extract_extensions_inner(filename: &str) -> Vec<String> {
+    let parts: Vec<&str> = filename.split('.').collect();
+    let mut extensions: Vec<String> = Vec::new();
+    let mut current_extension = String::new();
+
+    for part in parts.iter().rev() {
+        if current_extension.is_empty() {
+            current_extension.push_str(part);
+        } else {
+            current_extension = format!("{}.{}", part, current_extension);
+        }
+        extensions.push(current_extension.clone());
+    }
+
+    extensions.pop();
+    extensions.reverse();
+    extensions
+}
