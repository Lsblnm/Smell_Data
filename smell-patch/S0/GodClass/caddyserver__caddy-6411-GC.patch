+func (f *fileReplacementProvider) httpScheme(req *http.Request) (any, bool) {
+	if f.httpValSep == "" {
+		f.httpValSep = ","
+	}
+
+	if req.TLS != nil {
+		return "https", true
+	}
+	return "http", true
+}
+
+func (f *fileReplacementProvider) httpHostPort(req *http.Request, which string) (any, bool) {
+	if f.httpValSep == "" {
+		f.httpValSep = ","
+	}
+
+	switch which {
+	case "host":
+		host, _, ok := f.httpSplitHost(req.Host)
+		if !ok {
+			return req.Host, true
+		}
+		return host, true
+	case "port":
+		_, port, _ := net.SplitHostPort(req.Host)
+		if portNum, err := strconv.Atoi(port); err == nil {
+			return portNum, true
+		}
+		return port, true
+	case "hostport":
+		return req.Host, true
+	}
+	return nil, false
+}
+
+func (f *fileReplacementProvider) httpLocalAddr(req *http.Request, which string) (any, bool) {
+	if f.httpValSep == "" {
+		f.httpValSep = ","
+	}
+
+	localAddr, _ := req.Context().Value(http.LocalAddrContextKey).(net.Addr)
+	if localAddr == nil {
+		return nil, true
+	}
+	switch which {
+	case "full":
+		return localAddr.String(), true
+	case "host":
+		host, _, err := net.SplitHostPort(localAddr.String())
+		if err != nil {
+			return localAddr, true
+		}
+		return host, true
+	case "port":
+		_, port, _ := net.SplitHostPort(localAddr.String())
+		if portNum, err := strconv.Atoi(port); err == nil {
+			return portNum, true
+		}
+		return port, true
+	}
+	return nil, false
+}
+
+func (f *fileReplacementProvider) httpRemoteAddr(req *http.Request, which string) (any, bool) {
+	if f.httpValSep == "" {
+		f.httpValSep = ","
+	}
+
+	if which != "port" && req.TLS != nil && !req.TLS.HandshakeComplete {
+		return nil, true
+	}
+	switch which {
+	case "full":
+		return req.RemoteAddr, true
+	case "host":
+		host, _, err := net.SplitHostPort(req.RemoteAddr)
+		if err != nil {
+			return req.RemoteAddr, true
+		}
+		return host, true
+	case "port":
+		_, port, _ := net.SplitHostPort(req.RemoteAddr)
+		if portNum, err := strconv.Atoi(port); err == nil {
+			return portNum, true
+		}
+		return port, true
+	}
+	return nil, false
+}
+
+func (f *fileReplacementProvider) httpURIParts(req *http.Request, which string) (any, bool) {
+	if f.httpValSep == "" {
+		f.httpValSep = ","
+	}
+
+	switch which {
+	case "uri":
+		return req.URL.RequestURI(), true
+	case "path":
+		return req.URL.Path, true
+	case "file":
+		_, file := path.Split(req.URL.Path)
+		return file, true
+	case "dir":
+		dir, _ := path.Split(req.URL.Path)
+		return dir, true
+	case "base":
+		return strings.TrimSuffix(path.Base(req.URL.Path), path.Ext(req.URL.Path)), true
+	case "ext":
+		return path.Ext(req.URL.Path), true
+	case "query":
+		return req.URL.RawQuery, true
+	}
+	return nil, false
+}
+
+func (f *fileReplacementProvider) httpBody(req *http.Request) (any, bool) {
+	if f.httpValSep == "" {
+		f.httpValSep = ","
+	}
+
+	if req.Body == nil {
+		return "", true
+	}
+	defer req.Body.Close()
+	buf := new(bytes.Buffer)
+	_, _ = io.Copy(buf, req.Body)
+	req.Body = io.NopCloser(buf)
+	return buf.String(), true
+}
+
+func (f *fileReplacementProvider) httpRemotePrefix(req *http.Request, key string) (any, bool) {
+	if f.httpValSep == "" {
+		f.httpValSep = ","
+	}
+
+	if !strings.HasPrefix(key, "http.request.remote.host/") {
+		return nil, false
+	}
+	host, _, err := net.SplitHostPort(req.RemoteAddr)
+	if err != nil {
+		host = req.RemoteAddr
+	}
+	addr, err := netip.ParseAddr(host)
+	if err != nil {
+		return host, true
+	}
+	bitsBoth := key[strings.Index(key, "/")+1:]
+	ipv4BitsStr, ipv6BitsStr, cutOK := strings.Cut(bitsBoth, ",")
+	bitsStr := ipv4BitsStr
+	if addr.Is6() && cutOK {
+		bitsStr = ipv6BitsStr
+	}
+	bits, err := strconv.Atoi(bitsStr)
+	if err != nil {
+		return "", true
+	}
+	prefix, err := addr.Prefix(bits)
+	if err != nil {
+		return "", true
+	}
+	return prefix.String(), true
+}
+
+func (f *fileReplacementProvider) httpHostLabels(req *http.Request, key, prefix string) (any, bool) {
+	if f.httpValSep == "" {
+		f.httpValSep = ","
+	}
+
+	if !strings.HasPrefix(key, prefix) {
+		return nil, false
+	}
+	idxStr := key[len(prefix):]
+	idx, err := strconv.Atoi(idxStr)
+	if err != nil || idx < 0 {
+		return "", false
+	}
+	reqHost, _, err := net.SplitHostPort(req.Host)
+	if err != nil {
+		reqHost = req.Host
+	}
+	hostLabels := strings.Split(reqHost, ".")
+	if idx >= len(hostLabels) {
+		return "", true
+	}
+	return hostLabels[len(hostLabels)-idx-1], true
+}
+
+func (f *fileReplacementProvider) httpPathIndex(uriPath, key, prefix string) (any, bool) {
+	if f.httpValSep == "" {
+		f.httpValSep = ","
+	}
+
+	if !strings.HasPrefix(key, prefix) {
+		return nil, false
+	}
+	idxStr := key[len(prefix):]
+	idx, err := strconv.Atoi(idxStr)
+	if err != nil {
+		return "", false
+	}
+	pathParts := strings.Split(uriPath, "/")
+	if len(pathParts) > 0 && pathParts[0] == "" {
+		pathParts = pathParts[1:]
+	}
+	if idx < 0 {
+		return "", false
+	}
+	if idx >= len(pathParts) {
+		return "", true
+	}
+	return pathParts[idx], true
+}
+
+func (f *fileReplacementProvider) HTTPRequestValue(req *http.Request, key string) (any, bool) {
+	if f.httpValSep == "" {
+		f.httpValSep = ","
+	}
+
+	if req == nil {
+		return nil, false
+	}
+	if val, ok := f.httpQuery(req, key, "http.request.uri.query."); ok {
+		return val, true
+	}
+	if val, ok := f.httpHeader(req.Header, key, "http.request.header."); ok {
+		return val, true
+	}
+	if val, ok := f.httpCookie(req, key, "http.request.cookie."); ok {
+		return val, true
+	}
+	if strings.HasPrefix(key, "http.request.tls.") {
+		return nil, false
+	}
+	switch key {
+	case "http.request.method":
+		return req.Method, true
+	case "http.request.scheme":
+		return f.httpScheme(req)
+	case "http.request.proto":
+		return req.Proto, true
+	case "http.request.host":
+		return f.httpHostPort(req, "host")
+	case "http.request.port":
+		return f.httpHostPort(req, "port")
+	case "http.request.hostport":
+		return f.httpHostPort(req, "hostport")
+	case "http.request.local":
+		return f.httpLocalAddr(req, "full")
+	case "http.request.local.host":
+		return f.httpLocalAddr(req, "host")
+	case "http.request.local.port":
+		return f.httpLocalAddr(req, "port")
+	case "http.request.remote":
+		return f.httpRemoteAddr(req, "full")
+	case "http.request.remote.host":
+		return f.httpRemoteAddr(req, "host")
+	case "http.request.remote.port":
+		return f.httpRemoteAddr(req, "port")
+	case "http.request.uri":
+		return f.httpURIParts(req, "uri")
+	case "http.request.uri.path":
+		return f.httpURIParts(req, "path")
+	case "http.request.uri.path.file":
+		return f.httpURIParts(req, "file")
+	case "http.request.uri.path.dir":
+		return f.httpURIParts(req, "dir")
+	case "http.request.uri.path.file.base":
+		return f.httpURIParts(req, "base")
+	case "http.request.uri.path.file.ext":
+		return f.httpURIParts(req, "ext")
+	case "http.request.uri.query":
+		return f.httpURIParts(req, "query")
+	case "http.request.body":
+		return f.httpBody(req)
+	}
+	if val, ok := f.httpRemotePrefix(req, key); ok {
+		return val, true
+	}
+	if val, ok := f.httpHostLabels(req, key, "http.request.host.labels."); ok {
+		return val, true
+	}
+	if val, ok := f.httpPathIndex(req.URL.Path, key, "http.request.uri.path."); ok {
+		return val, true
+	}
+	return nil, false
+}
