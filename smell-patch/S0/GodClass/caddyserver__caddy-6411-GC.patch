+	return host, port, true
+}
+
+func (f *fileReplacementProvider) httpQuery(req *http.Request, key, prefix string) (any, bool) {
+	if f.httpValSep == "" {
+		f.httpValSep = ","
+	}
+
+	if !strings.HasPrefix(key, prefix) {
+		return nil, false
+	}
+	vals := req.URL.Query()[key[len(prefix):]]
+	return f.httpJoin(vals), true
+}
+
+func (f *fileReplacementProvider) httpHeader(header http.Header, key, prefix string) (any, bool) {
+	if f.httpValSep == "" {
+		f.httpValSep = ","
+	}
+
+	if !strings.HasPrefix(key, prefix) {
+		return nil, false
+	}
+	field := key[len(prefix):]
+	vals := header[textproto.CanonicalMIMEHeaderKey(field)]
+	return f.httpJoin(vals), true
+}
+
+func (f *fileReplacementProvider) httpCookie(req *http.Request, key, prefix string) (any, bool) {
+	if f.httpValSep == "" {
+		f.httpValSep = ","
+	}
+
+	if !strings.HasPrefix(key, prefix) {
+		return nil, false
+	}
+	name := key[len(prefix):]
+	for _, cookie := range req.Cookies() {
+		if strings.EqualFold(name, cookie.Name) {
+			return cookie.Value, true
+		}
+	}
+	return nil, false
+}
