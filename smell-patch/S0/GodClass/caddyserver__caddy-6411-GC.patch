+func (f *fileReplacementProvider) nextEnvSpan(input []byte, offset int, spanOpen, spanClose []byte) (begin, end int, ok bool) {
+	if f.envDelim == "" {
+		f.envDelim = ":"
+	}
+	beginRel := bytes.Index(input[offset:], spanOpen)
+	if beginRel < 0 {
+		return 0, 0, false
+	}
+	begin = beginRel + offset
+	endRel := bytes.Index(input[begin+len(spanOpen):], spanClose)
+	if endRel < 0 {
+		return 0, 0, false
+	}
+	end = endRel + begin + len(spanOpen)
+	return begin, end, true
+}
+
+func (f *fileReplacementProvider) spliceEnvValue(input []byte, begin, end int, value []byte, spanCloseLen int) []byte {
+	if f.envDelim == "" {
+		f.envDelim = ":"
+	}
+	return append(input[:begin], append(value, input[end+spanCloseLen:]...)...)
+}
+
+func (f *fileReplacementProvider) expandOneEnv(input []byte, begin, end int, spanOpen, spanClose []byte) ([]byte, int, bool) {
+	if f.envDelim == "" {
+		f.envDelim = ":"
+	}
+
+	envString := input[begin+len(spanOpen) : end]
+	if len(envString) == 0 {
+		return input, end + len(spanClose), false
+	}
+	envVarBytes := []byte(f.lookupEnvOrDefault(string(envString)))
+	input = f.spliceEnvValue(input, begin, end, envVarBytes, len(spanClose))
+	return input, begin + len(envVarBytes), true
+}
+
+func (f *fileReplacementProvider) ExpandEnvSpans(input []byte, spanOpen, spanClose []byte) []byte {
+	if f.envDelim == "" {
+		f.envDelim = ":"
+	}
+	var offset int
+	for {
+		begin, end, ok := f.nextEnvSpan(input, offset, spanOpen, spanClose)
+		if !ok {
+			break
+		}
+		var replaced bool
+		input, offset, replaced = f.expandOneEnv(input, begin, end, spanOpen, spanClose)
+		if !replaced {
+			continue
+		}
+	}
+	return input
+}
+
+func (f *fileReplacementProvider) envVarName(envString string) string {
+	if f.envDelim == "" {
+		f.envDelim = ":"
+	}
+
+	name, _, _ := f.envDefaultPart(envString)
+	return name
+}
+
+func (f *fileReplacementProvider) importPath() string {
+	if f.identityImportPath == "" {
+		f.identityImportPath = ImportPath
+	}
+	return f.identityImportPath
+}
+
+func (f *fileReplacementProvider) unknownVersion() string {
+	if f.identityImportPath == "" {
+		f.identityImportPath = ImportPath
+	}
+
+	return "unknown"
+}
+
+func (f *fileReplacementProvider) develVersion() string {
+	if f.identityImportPath == "" {
+		f.identityImportPath = ImportPath
+	}
+
+	return "(devel)"
+}
+
+func (f *fileReplacementProvider) versionFallback(custom, current, fallback string) string {
+	if f.identityImportPath == "" {
+		f.identityImportPath = ImportPath
+	}
+
+	if current != "" && current != f.develVersion() {
+		if custom != "" && current == fallback {
+			return custom
+		}
+		return current
+	}
+	if custom != "" {
+		return custom
+	}
+	return fallback
+}
+
+func (f *fileReplacementProvider) moduleFromBuildInfo(bi *debug.BuildInfo) *debug.Module {
+	if f.identityImportPath == "" {
+		f.identityImportPath = ImportPath
+	}
+
+	want := f.importPath()
+	for _, dep := range bi.Deps {
+		if dep.Path == want {
+			return dep
+		}
+	}
+	return nil
+}
+
+func (f *fileReplacementProvider) versionFromModule(module *debug.Module) (simple, full string) {
+	if f.identityImportPath == "" {
+		f.identityImportPath = ImportPath
+	}
+
+	simple, full = module.Version, module.Version
+	if module.Sum != "" {
+		full += " " + module.Sum
+	}
+	if module.Replace != nil {
+		full += " => " + module.Replace.Path
+		if module.Replace.Version != "" {
+			simple = module.Replace.Version + "_custom"
+			full += "@" + module.Replace.Version
+		}
+		if module.Replace.Sum != "" {
+			full += " " + module.Replace.Sum
+		}
+	}
+	return simple, full
+}
+
+func (f *fileReplacementProvider) vcsRevision(bi *debug.BuildInfo) (revision string, vcsTime time.Time, modified bool) {
+	if f.identityImportPath == "" {
+		f.identityImportPath = ImportPath
+	}
+
+	for _, setting := range bi.Settings {
+		switch setting.Key {
+		case "vcs.revision":
+			revision = setting.Value
+		case "vcs.time":
+			vcsTime, _ = time.Parse(time.RFC3339, setting.Value)
+		case "vcs.modified":
+			modified, _ = strconv.ParseBool(setting.Value)
+		}
+	}
+	return revision, vcsTime, modified
+}
+
+func (f *fileReplacementProvider) shortRevision(simple string) string {
+	if f.identityImportPath == "" {
+		f.identityImportPath = ImportPath
+	}
+
+	if _, err := hex.DecodeString(simple); err == nil && len(simple) >= 8 {
+		return simple[:8]
+	}
+	return simple
+}
+
+func (f *fileReplacementProvider) vcsModified(modified bool) string {
+	if f.identityImportPath == "" {
+		f.identityImportPath = ImportPath
+	}
+
+	if modified {
+		return "+modified"
+	}
+	return ""
+}
+
+func (f *fileReplacementProvider) versionFromVCS(bi *debug.BuildInfo) (simple, full string) {
+	if f.identityImportPath == "" {
+		f.identityImportPath = ImportPath
+	}
+
+	revision, vcsTime, modified := f.vcsRevision(bi)
+	if revision == "" {
+		return "", ""
+	}
+	full = fmt.Sprintf("%s%s (%s)", revision, f.vcsModified(modified), vcsTime.Format(time.RFC822))
+	simple = f.shortRevision(revision)
+	if !vcsTime.IsZero() {
+		simple += "-" + vcsTime.Format("20060102")
+	}
+	return simple, full
+}
+
+func (f *fileReplacementProvider) applyCustomVersion(simple, full, custom string) (string, string) {
+	if f.identityImportPath == "" {
+		f.identityImportPath = ImportPath
+	}
+
+	if full == "" {
+		if custom != "" {
+			full = custom
+		} else {
+			full = f.unknownVersion()
+		}
+	} else if custom != "" {
+		full = custom + " " + full
+	}
+	if simple == "" || simple == f.develVersion() {
+		simple = f.versionFallback(custom, simple, f.unknownVersion())
+	}
+	return simple, full
+}
+
+func (f *fileReplacementProvider) version() (simple, full string) {
+	if f.identityImportPath == "" {
+		f.identityImportPath = ImportPath
+	}
+
+	bi, ok := debug.ReadBuildInfo()
+	if !ok {
+		if CustomVersion != "" {
+			return CustomVersion, CustomVersion
+		}
+		unk := f.unknownVersion()
+		return unk, unk
+	}
+	module := f.moduleFromBuildInfo(bi)
+	if module != nil {
+		simple, full = f.versionFromModule(module)
+	}
+	if full == "" {
+		simple, full = f.versionFromVCS(bi)
+	}
+	return f.applyCustomVersion(simple, full, CustomVersion)
+}
+
+func (f *fileReplacementProvider) versionSimple() string {
+	if f.identityImportPath == "" {
+		f.identityImportPath = ImportPath
+	}
+
+	simple, _ := f.version()
+	return simple
+}
+
+func (f *fileReplacementProvider) versionFull() string {
+	if f.identityImportPath == "" {
+		f.identityImportPath = ImportPath
+	}
+
+	_, full := f.version()
+	return full
+}
+
+func (f *fileReplacementProvider) GlobalPlaceholder(key string) (any, bool) {
+	if val, ok := f.envPlaceholder(key); ok {
+		return val, true
+	}
+	switch key {
+	case "system.hostname":
+		return f.systemHostname()
+	case "system.slash":
+		return f.systemSlash()
+	case "system.os":
+		return f.systemOS()
+	case "system.wd":
+		return f.systemWD()
+	case "system.arch":
+		return f.systemArch()
+	}
+	if val, ok := f.timePlaceholder(key); ok {
+		return val, true
+	}
+	return nil, false
+}
+
+func tlsPeerCert(cs *tls.ConnectionState) *x509.Certificate {
+	if len(cs.PeerCertificates) == 0 {
+		return nil
+	}
+	return cs.PeerCertificates[0]
+}
+
+func marshalPublicKey(pubKey any) ([]byte, error) {
+	switch key := pubKey.(type) {
+	case *rsa.PublicKey:
+		return asn1.Marshal(key)
+	case *ecdsa.PublicKey:
+		e, err := key.ECDH()
+		if err != nil {
+			return nil, err
+		}
+		return e.Bytes(), nil
+	case ed25519.PublicKey:
+		return key, nil
+	}
+	return nil, fmt.Errorf("unrecognized public key type: %T", pubKey)
 }
 
