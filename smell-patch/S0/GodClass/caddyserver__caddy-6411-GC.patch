+func (f *fileReplacementProvider) lookupEnvOrDefault(envString string) string {
+	if f.envDelim == "" {
+		f.envDelim = ":"
+	}
+
+	name := f.envVarName(envString)
+	_, def, hasDef := f.envDefaultPart(envString)
+	val, found := os.LookupEnv(name)
+	if !found && hasDef {
+		return def
+	}
+	return val
+}
