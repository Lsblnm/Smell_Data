+func (f *fileReplacementProvider) HTTPRequestTLS(cs *tls.ConnectionState, key, prefix, protocolName string) (any, bool) {
+	if f.httpValSep == "" {
+		f.httpValSep = ","
+	}
+
+	if cs == nil {
+		return nil, false
+	}
+	if len(key) < len(prefix) {
+		return nil, false
+	}
+	field := strings.ToLower(key[len(prefix):])
+	if strings.HasPrefix(field, "client.") {
+		cert := tlsPeerCert(cs)
+		if cert == nil {
+			return nil, false
+		}
+		if strings.HasPrefix(field, "client.san.") {
+			return f.tlsClientSAN(cert, field)
+		}
+		switch field {
+		case "client.fingerprint":
+			return fmt.Sprintf("%x", sha256.Sum256(cert.Raw)), true
+		case "client.public_key", "client.public_key_sha256":
+			if cert.PublicKey == nil {
+				return nil, true
+			}
+			pubKeyBytes, err := marshalPublicKey(cert.PublicKey)
+			if err != nil {
+				return nil, true
+			}
+			if strings.HasSuffix(field, "_sha256") {
+				return fmt.Sprintf("%x", sha256.Sum256(pubKeyBytes)), true
+			}
+			return fmt.Sprintf("%x", pubKeyBytes), true
+		case "client.issuer":
+			return cert.Issuer, true
+		case "client.serial":
+			return cert.SerialNumber, true
+		case "client.subject":
+			return cert.Subject, true
+		case "client.certificate_pem":
+			block := pem.Block{Type: "CERTIFICATE", Bytes: cert.Raw}
+			return pem.EncodeToMemory(&block), true
+		case "client.certificate_der_base64":
+			return base64.StdEncoding.EncodeToString(cert.Raw), true
+		default:
+			return nil, false
+		}
+	}
+	switch field {
+	case "version":
+		return protocolName, true
+	case "cipher_suite":
+		return tls.CipherSuiteName(cs.CipherSuite), true
+	case "resumed":
+		return cs.DidResume, true
+	case "proto":
+		return cs.NegotiatedProtocol, true
+	case "proto_mutual":
+		return true, true
+	case "server_name":
+		return cs.ServerName, true
+	}
+	return nil, false
+}
+
+func (f *fileReplacementProvider) tlsClientSAN(cert *x509.Certificate, field string) (any, bool) {
+	if f.httpValSep == "" {
+		f.httpValSep = ","
+	}
+
+	field = field[len("client.san."):]
+	var fieldName string
+	var fieldValue any
+	switch {
+	case strings.HasPrefix(field, "dns_names"):
+		fieldName = "dns_names"
+		fieldValue = cert.DNSNames
+	case strings.HasPrefix(field, "emails"):
+		fieldName = "emails"
+		fieldValue = cert.EmailAddresses
+	case strings.HasPrefix(field, "ips"):
+		fieldName = "ips"
+		fieldValue = cert.IPAddresses
+	case strings.HasPrefix(field, "uris"):
+		fieldName = "uris"
+		fieldValue = cert.URIs
+	default:
+		return nil, false
+	}
+	field = field[len(fieldName):]
+	if field == "" {
+		return fieldValue, true
+	}
+	if len(field) < 2 || field[0] != '.' {
+		return nil, false
+	}
+	field = field[1:]
+	idx, err := strconv.Atoi(field)
+	if err != nil || idx < 0 {
+		return nil, false
+	}
+	switch v := fieldValue.(type) {
+	case []string:
+		if idx >= len(v) {
+			return nil, true
+		}
+		return v[idx], true
+	case []net.IP:
+		if idx >= len(v) {
+			return nil, true
+		}
+		return v[idx], true
+	case []*url.URL:
+		if idx >= len(v) {
+			return nil, true
+		}
+		return v[idx], true
+	}
+	return nil, false
+}
