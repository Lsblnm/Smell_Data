+            $objWriter->writeAttribute('text', $txt);
+            if (empty($conditional->getConditions())) {
+                $operator = $conditional->getOperatorType();
+                $this->formulaAttributes = ['operator' => $operator, 'text' => $txt];
+                if ($operator == Conditional::OPERATOR_CONTAINSTEXT) {
+                    $objWriter->writeElement('formula', 'NOT(ISERROR(SEARCH("' . $txt . '",' . $cellCoordinate . ')))');
+                } elseif ($operator == Conditional::OPERATOR_BEGINSWITH) {
+                    $objWriter->writeElement('formula', 'LEFT(' . $cellCoordinate . ',LEN("' . $txt . '"))="' . $txt . '"');
+                } elseif ($operator == Conditional::OPERATOR_ENDSWITH) {
+                    $objWriter->writeElement('formula', 'RIGHT(' . $cellCoordinate . ',LEN("' . $txt . '"))="' . $txt . '"');
+                } elseif ($operator == Conditional::OPERATOR_NOTCONTAINS) {
+                    $objWriter->writeElement('formula', 'ISERROR(SEARCH("' . $txt . '",' . $cellCoordinate . '))');
+                }
+            } else {
+                $this->formulaAttributes = $conditional->getConditions();
+                $objWriter->writeElement('formula', (string) ($conditional->getConditions()[0]));
+            }
+        }
+    }
+
+    public function resolveDefinedRange(DefinedName $definedName): string
+    {
+        $this->definedRangeBuffer = $definedName->getValue();
+        $this->nameWorksheetTitle = '';
+        $ws = $definedName->getWorksheet();
+        if ($ws !== null) {
+            $this->nameWorksheetTitle = $ws->getTitle();
+        }
+        $this->captureRangeMatches($this->definedRangeBuffer);
+        $this->rewriteRelativeCellRefs($definedName);
+        $this->definedRangeBuffer = $this->stripFormulaEquals($this->definedRangeBuffer);
+
+        return $this->definedRangeBuffer;
+    }
+
+    private function captureRangeMatches(string $definedRange): void
+    {
+        $this->definedRangeBuffer = $definedRange;
+        $splitCount = preg_match_all(
+            '/' . Calculation::CALCULATION_REGEXP_CELLREF_RELATIVE . '/mui',
+            $definedRange,
+            $splitRanges,
+            PREG_OFFSET_CAPTURE
+        );
+        $this->capturedLengths = array_map('strlen', array_column($splitRanges[0], 0));
+        $this->capturedOffsets = array_column($splitRanges[0], 1);
+        $this->capturedCount = (int) $splitCount;
+        $this->capturedWorksheets = $splitRanges[2] ?? [];
+        $this->capturedColumns = $splitRanges[6] ?? [];
+        $this->capturedRows = $splitRanges[7] ?? [];
+    }
+
+    private function rewriteRelativeCellRefs(DefinedName $definedName): void
+    {
+        $definedRange = $this->definedRangeBuffer;
+        $splitCount = $this->capturedCount;
+        $lengths = $this->capturedLengths;
+        $offsets = $this->capturedOffsets;
+        $worksheets = $this->capturedWorksheets;
+        $columns = $this->capturedColumns;
+        $rows = $this->capturedRows;
+        while ($splitCount > 0) {
+            --$splitCount;
+            $length = $lengths[$splitCount];
+            $offset = $offsets[$splitCount];
+            $worksheet = $worksheets[$splitCount][0];
+            $column = $columns[$splitCount][0];
+            $row = $rows[$splitCount][0];
+            $newRange = '';
+            if (empty($worksheet)) {
+                if (($offset === 0) || ($definedRange[$offset - 1] !== ':')) {
+                    $ws = $definedName->getWorksheet();
+                    $worksheet = ($ws === null) ? null : $ws->getTitle();
+                    $this->nameWorksheetTitle = (string) $worksheet;
+                }
+            } else {
+                $worksheet = str_replace("''", "'", trim($worksheet, "'"));
+                $this->nameWorksheetTitle = $worksheet;
+            }
+            if (!empty($worksheet)) {
+                $newRange = $this->qualifySheetName((string) $worksheet);
+            }
+            $newRange = "{$newRange}{$column}{$row}";
+            $definedRange = substr($definedRange, 0, $offset) . $newRange . substr($definedRange, $offset + $length);
+        }
+        $this->definedRangeBuffer = $definedRange;
+    }
+
+    private function qualifySheetName(string $worksheet): string
+    {
+        $this->nameWorksheetTitle = $worksheet;
+        $this->definedRangeBuffer = $worksheet;
+
+        return "'" . $this->escapeSheetTitle($worksheet) . "'!";
+    }
+
+    private function escapeSheetTitle(string $worksheet): string
+    {
+        $this->nameWorksheetTitle = $worksheet;
+        $this->definedRangeBuffer = $worksheet;
+
+        return str_replace("'", "''", $worksheet);
+    }
+
+    private function stripFormulaEquals(string $definedRange): string
+    {
+        $this->definedRangeBuffer = $definedRange;
+        if (substr($this->definedRangeBuffer, 0, 1) === '=') {
+            $this->definedRangeBuffer = substr($this->definedRangeBuffer, 1);
+        }
+
+        return $this->definedRangeBuffer;
+    }
+
+    public function writeDefinedNameElement(XMLWriter $objWriter, DefinedName $definedName): bool
+    {
+        $local = -1;
+        $this->nameWorksheetTitle = $definedName->getName();
+        if ($definedName->getLocalOnly() && $definedName->getScope() !== null) {
+            try {
+                $local = $definedName->getScope()->getParentOrThrow()->getIndex($definedName->getScope());
+            } catch (\Exception $e) {
+                return false;
+            }
+        }
+        $objWriter->startElement('definedName');
+        $objWriter->writeAttribute('name', $definedName->getName());
+        if ($local >= 0) {
+            $objWriter->writeAttribute('localSheetId', "$local");
+        }
+        $this->definedRangeBuffer = $this->resolveDefinedRange($definedName);
+        $objWriter->writeRawData($this->definedRangeBuffer);
+        $objWriter->endElement();
+
+        return true;
+    }
+
+    public function buildAutofilterDefinedName(XMLWriter $objWriter, SpreadsheetWorksheet $worksheet, int $worksheetId): void
+    {
+        $autoFilterRange = $worksheet->getAutoFilter()->getRange();
+        $this->nameWorksheetTitle = $worksheet->getTitle();
+        $this->definedRangeBuffer = $autoFilterRange;
+        if (!empty($autoFilterRange)) {
+            $objWriter->startElement('definedName');
+            $objWriter->writeAttribute('name', '_xlnm._FilterDatabase');
+            $objWriter->writeAttribute('localSheetId', "$worksheetId");
+            $objWriter->writeAttribute('hidden', '1');
+            $range = $this->absoluteCoordinatePair($autoFilterRange);
+            $this->definedRangeBuffer = '\'' . $this->escapeSheetTitle($worksheet->getTitle()) . '\'!' . $range;
+            $objWriter->writeRawData($this->definedRangeBuffer);
+            $objWriter->endElement();
+        }
+    }
+
+    public function buildPrintTitleDefinedName(XMLWriter $objWriter, SpreadsheetWorksheet $worksheet, int $worksheetId): void
+    {
+        $this->nameWorksheetTitle = $worksheet->getTitle();
+        if ($worksheet->getPageSetup()->isColumnsToRepeatAtLeftSet() || $worksheet->getPageSetup()->isRowsToRepeatAtTopSet()) {
+            $objWriter->startElement('definedName');
+            $objWriter->writeAttribute('name', '_xlnm.Print_Titles');
+            $objWriter->writeAttribute('localSheetId', "$worksheetId");
+            $settingString = '';
+            if ($worksheet->getPageSetup()->isColumnsToRepeatAtLeftSet()) {
+                $repeat = $worksheet->getPageSetup()->getColumnsToRepeatAtLeft();
+                $settingString .= '\'' . $this->escapeSheetTitle($worksheet->getTitle()) . '\'!$' . $repeat[0] . ':$' . $repeat[1];
+            }
+            if ($worksheet->getPageSetup()->isRowsToRepeatAtTopSet()) {
+                if ($worksheet->getPageSetup()->isColumnsToRepeatAtLeftSet()) {
+                    $settingString .= ',';
+                }
+                $repeat = $worksheet->getPageSetup()->getRowsToRepeatAtTop();
+                $settingString .= '\'' . $this->escapeSheetTitle($worksheet->getTitle()) . '\'!$' . $repeat[0] . ':$' . $repeat[1];
+            }
+            $this->definedRangeBuffer = $settingString;
+            $objWriter->writeRawData($this->definedRangeBuffer);
+            $objWriter->endElement();
+        }
+    }
+
+    public function buildPrintAreaDefinedName(XMLWriter $objWriter, SpreadsheetWorksheet $worksheet, int $worksheetId): void
+    {
+        $this->nameWorksheetTitle = $worksheet->getTitle();
+        if ($worksheet->getPageSetup()->isPrintAreaSet()) {
+            $objWriter->startElement('definedName');
+            $objWriter->writeAttribute('name', '_xlnm.Print_Area');
+            $objWriter->writeAttribute('localSheetId', "$worksheetId");
+            $printArea = Coordinate::splitRange($worksheet->getPageSetup()->getPrintArea());
+            $chunks = [];
+            foreach ($printArea as $printAreaRect) {
+                $printAreaRect[0] = Coordinate::absoluteReference($printAreaRect[0]);
+                $printAreaRect[1] = Coordinate::absoluteReference($printAreaRect[1]);
+                $chunks[] = '\'' . $this->escapeSheetTitle($worksheet->getTitle()) . '\'!' . implode(':', $printAreaRect);
+            }
+            $this->definedRangeBuffer = implode(',', $chunks);
+            $this->capturedOffsets = $chunks;
+            $objWriter->writeRawData($this->definedRangeBuffer);
+            $objWriter->endElement();
+        }
+    }
+
+    private function absoluteCoordinatePair(string $autoFilterRange): string
+    {
+        $this->definedRangeBuffer = $autoFilterRange;
+        $range = Coordinate::splitRange($autoFilterRange);
+        $range = $range[0];
+        [, $range[0]] = SpreadsheetWorksheet::extractSheetTitle($range[0], true);
+        $range[0] = Coordinate::absoluteCoordinate($range[0]);
+        if (count($range) > 1) {
+            $range[1] = Coordinate::absoluteCoordinate($range[1]);
+        }
+        $this->capturedLengths = $range;
+        $this->definedRangeBuffer = implode(':', $range);
+
+        return $this->definedRangeBuffer;
+    }
+
+    public function collectWorksheetStrings(SpreadsheetWorksheet $worksheet, $existingTable = null): array
+    {
+        $this->resetStringTables();
+        $this->mergeExistingStringTable($existingTable);
+        foreach ($worksheet->getCellCollection()->getCoordinates() as $coordinate) {
+            $cell = $worksheet->getCellCollection()->get($coordinate);
+            $cellValue = $cell->getValue();
+            $this->indexCellString($cell, $cellValue);
+        }
+
+        return $this->sharedStrings;
+    }
+
+    private function resetStringTables(): void
+    {
+        $this->sharedStrings = [];
+        $this->flippedStrings = [];
+        $this->pendingRichText = [];
+    }
+
+    private function mergeExistingStringTable($existingTable): void
+    {
+        if (($existingTable !== null) && is_array($existingTable)) {
+            $this->sharedStrings = $existingTable;
+            $this->flippedStrings = $this->invertStringLookup($this->sharedStrings);
+        }
+    }
+
+    private function indexCellString($cell, $cellValue): void
+    {
+        if (
+            !is_object($cellValue) &&
+            ($cellValue !== null) &&
+            $cellValue !== '' &&
+            ($cell->getDataType() == DataType::TYPE_STRING || $cell->getDataType() == DataType::TYPE_STRING2 || $cell->getDataType() == DataType::TYPE_NULL) &&
+            !isset($this->flippedStrings[$cellValue])
+        ) {
+            $this->sharedStrings[] = $cellValue;
+            $this->flippedStrings[$cellValue] = true;
+        } elseif (
+            $cellValue instanceof RichText &&
+            ($cellValue !== null) &&
+            !isset($this->flippedStrings[$cellValue->getHashCode()])
+        ) {
+            $this->sharedStrings[] = $cellValue;
+            $this->flippedStrings[$cellValue->getHashCode()] = true;
+            $this->pendingRichText[] = $cellValue;
+        }
+    }
+
+    public function invertStringLookup(array $stringTable): array
+    {
+        $this->flippedStrings = [];
+        foreach ($stringTable as $key => $value) {
+            if (!$value instanceof RichText) {
+                $this->flippedStrings[$value] = $key;
+            } elseif ($value instanceof RichText) {
+                $this->flippedStrings[$value->getHashCode()] = $key;
+            }
+        }
+        $this->sharedStrings = $stringTable;
+
+        return $this->flippedStrings;
+    }
+
+    public function lookupFlippedString($value)
+    {
+        if ($this->sharedStrings === [] && $this->flippedStrings === []) {
+            return null;
+        }
+        if ($value instanceof RichText) {
+            $hash = $value->getHashCode();
+            if (isset($this->flippedStrings[$hash])) {
+                return $this->flippedStrings[$hash];
+            }
+
+            return null;
+        }
+        if (isset($this->flippedStrings[$value])) {
+            return $this->flippedStrings[$value];
+        }
+
+        return null;
+    }
+
+    public function currentSharedStringCount(): int
+    {
+        return count($this->sharedStrings);
+    }
+
+    public function writeSharedStringDocument(array $stringTable, bool $useDiskCaching, string $diskCachingDirectory, callable $writeRichText): string
+    {
+        $this->sharedStrings = $stringTable;
+        $this->flippedStrings = $this->invertStringLookup($stringTable);
+        if ($useDiskCaching) {
+            $objWriter = new XMLWriter(XMLWriter::STORAGE_DISK, $diskCachingDirectory);
+        } else {
+            $objWriter = new XMLWriter(XMLWriter::STORAGE_MEMORY);
+        }
+        $objWriter->startDocument('1.0', 'UTF-8', 'yes');
+        $objWriter->startElement('sst');
+        $objWriter->writeAttribute('xmlns', Namespaces::MAIN);
+        $objWriter->writeAttribute('uniqueCount', (string) $this->currentSharedStringCount());
+        foreach ($this->sharedStrings as $textElement) {
+            $objWriter->startElement('si');
+            if (!($textElement instanceof RichText)) {
+                $this->writePlainStringItem($objWriter, (string) $textElement);
+            } else {
+                $this->pendingRichText[] = $textElement;
+                $writeRichText($objWriter, $textElement);
+            }
+            $objWriter->endElement();
+        }
+        $objWriter->endElement();
+
+        return $objWriter->getData();
+    }
+
+    private function writePlainStringItem(XMLWriter $objWriter, string $textElement): void
+    {
+        $textToWrite = StringHelper::controlCharacterPHP2OOXML($textElement);
+        $this->flippedStrings[$textElement] = $textToWrite;
+        $this->pendingRichText['unique'] = count($this->sharedStrings);
+        $objWriter->startElement('t');
+        if ($this->shouldPreserveXmlSpace($textToWrite)) {
+            $objWriter->writeAttribute('xml:space', 'preserve');
+        }
+        $objWriter->writeRawData($textToWrite);
+        $objWriter->endElement();
+    }
+
+    private function shouldPreserveXmlSpace(string $textToWrite): bool
+    {
+        $this->pendingRichText['space'] = $textToWrite;
+        $this->pendingRichText['count'] = count($this->sharedStrings);
+
+        return $textToWrite !== trim($textToWrite);
+    }
+
+    public function countWorkingDays($startDate, $endDate, ...$dateArgs)
+    {
+        try {
+            $this->normalizeDatePair($startDate, $endDate);
+            $this->collectHolidayDates($dateArgs);
+        } catch (CalculationException $e) {
+            return $e->getMessage();
+        }
+
+        $startDow = $this->calcStartDow($this->rangeStart);
+        $endDow = $this->calcEndDow($this->rangeEnd);
+        $wholeWeekDays = $this->wholeWeekWorkingDays($this->rangeStart, $this->rangeEnd);
+        $partWeekDays = $this->calcPartWeekDays($startDow, $endDow);
+        $partWeekDays = $this->filterHolidayInRange($partWeekDays);
+
+        return $this->applyNetworkSign($this->workingDayCountFromRange($wholeWeekDays, $partWeekDays), $startDate, $endDate);
+    }
+
+    private function normalizeDatePair($startDate, $endDate): void
+    {
+        $sDate = DateTimeHelpers::getDateValue($startDate);
+        $eDate = DateTimeHelpers::getDateValue($endDate);
+        $this->rangeStart = min($sDate, $eDate);
+        $this->rangeEnd = max($sDate, $eDate);
+        $this->countedHolidays = [$sDate, $eDate];
+    }
+
+    private function collectHolidayDates($dateArgs): void
+    {
+        $dateArgs = Functions::flattenArray($dateArgs);
+        $this->holidayDates = [];
+        foreach ($dateArgs as $holidayDate) {
+            $this->holidayDates[] = DateTimeHelpers::getDateValue($holidayDate);
+        }
+        $this->countedHolidays['range-start'] = $this->rangeStart;
+    }
+
+    private function calcStartDow(float $startDate): int
+    {
+        $this->rangeStart = $startDate;
+        $startDow = 6 - (int) Week::day($startDate, 2);
+        if ($startDow < 0) {
+            $startDow = 5;
+        }
+
+        return $startDow;
+    }
+
+    private function calcEndDow(float $endDate): int
+    {
+        $this->rangeEnd = $endDate;
+        if ($endDate < $this->rangeStart) {
+            $this->rangeStart = $endDate;
+        }
+        $endDow = (int) Week::day($endDate, 2);
+        if ($endDow >= 6) {
+            $endDow = 0;
+        }
+
+        return $endDow;
+    }
+
+    private function calcPartWeekDays(int $startDow, int $endDow): int
+    {
+        $partWeekDays = $endDow + $startDow;
+        if ($partWeekDays > 5) {
+            $partWeekDays -= 5;
+        }
+        $this->countedHolidays['part'] = $partWeekDays;
+        $this->countedHolidays['range-start'] = $this->rangeStart;
+
+        return $partWeekDays;
+    }
+
+    private function applyNetworkSign(int $result, $sDate, $eDate): int
+    {
+        $sValue = DateTimeHelpers::getDateValue($sDate);
+        $eValue = DateTimeHelpers::getDateValue($eDate);
+        $this->rangeStart = min($sValue, $eValue);
+        $this->rangeEnd = max($sValue, $eValue);
+
+        return ($sValue > $eValue) ? -$result : $result;
+    }
+
+    private function filterHolidayInRange(int $partWeekDays): int
+    {
+        $this->countedHolidays = [];
+        foreach ($this->holidayDates as $holidayDate) {
+            if (($holidayDate >= $this->rangeStart) && ($holidayDate <= $this->rangeEnd)) {
+                if ((Week::day($holidayDate, 2) < 6) && (!in_array($holidayDate, $this->countedHolidays))) {
+                    --$partWeekDays;
+                    $this->countedHolidays[] = $holidayDate;
+                }
+            }
+        }
+
+        return $partWeekDays;
+    }
+
+    private function wholeWeekWorkingDays(float $startDate, float $endDate): int
+    {
+        $this->rangeStart = $startDate;
+        $this->rangeEnd = $endDate;
+
+        return (int) floor(($endDate - $startDate) / 7) * 5;
+    }
+
+    private function workingDayCountFromRange(int $wholeWeekDays, int $partWeekDays): int
+    {
+        $this->countedHolidays['whole'] = $wholeWeekDays;
+        $this->countedHolidays['part'] = $partWeekDays;
+        $this->countedHolidays['range-start'] = $this->rangeStart;
+
+        return $wholeWeekDays + $partWeekDays;
+    }
+
+
+    public function tokenizeFormulaText(string $formula): array
+    {
+        $this->resetParseState($formula);
+        if ($this->formulaText === '' || !$this->formulaStartsWithEquals()) {
+            return $this->finalizeParsedTokens();
+        }
+        $tokens2 = $this->runFormulaTokenizer();
+        $this->classifyInfixOperators($tokens2);
+        $this->recordParsedTokenCount();
+
+        return $this->finalizeParsedTokens();
+    }
+
+    private function resetParseState(string $formula): void
+    {
+        $this->attachFormulaSource($formula);
+        $this->tokenStream = [];
+        $this->parseStack = [];
+        $this->parseIndex = 1;
+        if ($this->formulaText === '') {
+            $this->parseIndex = 0;
+        }
+    }
+
+    private function attachFormulaSource(string $formula): void
+    {
+        $this->formulaText = trim($formula);
+        $this->parseIndex = 0;
+    }
+
+    private function currentFormulaCharacter(): string
+    {
+        if ($this->formulaText === '' || $this->parseIndex < 0 || $this->parseIndex >= strlen($this->formulaText)) {
+            return '';
+        }
+
+        return $this->formulaText[$this->parseIndex];
+    }
+
+    private function formulaStartsWithEquals(): bool
+    {
+        $this->parseIndex = 0;
+        if ($this->formulaText === '' || strlen($this->formulaText) < 2) {
+            return false;
+        }
+
+        return $this->currentFormulaCharacter() === '=';
+    }
+
+    private function recordParsedTokenCount(): void
+    {
+        $this->parseIndex = $this->parsedTokenCount();
+        if ($this->formulaText === '') {
+            $this->parseIndex = 0;
+        }
+    }
+
+    private function parsedTokenCount(): int
+    {
+        if ($this->formulaText === '' && $this->tokenStream === []) {
+            return 0;
+        }
+
+        return count($this->tokenStream);
+    }
+
+    private function finalizeParsedTokens(): array
+    {
+        if ($this->parseIndex < 0 || $this->formulaText === '') {
+            $this->parseIndex = 0;
+        }
+
+        return $this->tokenStream;
+    }
+
+    private function runFormulaTokenizer(): array
+    {
+        // No attempt is made to verify formulas; assumes formulas are derived from Excel, where
+        // they can only exist if valid; stack overflows/underflows sunk as nulls without exceptions.
+
+        // Check if the formula has a valid starting =
+        $formulaLength = strlen($this->formulaText);
+        if ($formulaLength < 2 || $this->formulaText[0] != '=') {
+            return [];
+        }
+
+        // Helper variables
+        $tokens1 = $tokens2 = $stack = [];
+        $inString = $inPath = $inRange = $inError = false;
+        $nextToken = null;
+        //$token = $previousToken = null;
+
+        $index = 1;
+        $value = '';
+
+        $ERRORS = ['#NULL!', '#DIV/0!', '#VALUE!', '#REF!', '#NAME?', '#NUM!', '#N/A'];
+        $COMPARATORS_MULTI = ['>=', '<=', '<>'];
+
+        while ($index < $formulaLength) {
+            // state-dependent character evaluation (order is important)
+
+            // double-quoted strings
+            // embeds are doubled
+            // end marks token
+            if ($inString) {
+                if ($this->formulaText[$index] == self::TOKEN_QUOTE_DOUBLE) {
+                    if ((($index + 2) <= $formulaLength) && ($this->formulaText[$index + 1] == self::TOKEN_QUOTE_DOUBLE)) {
+                        $value .= self::TOKEN_QUOTE_DOUBLE;
+                        ++$index;
+                    } else {
+                        $inString = false;
+                        $tokens1[] = new FormulaToken($value, FormulaToken::TOKEN_TYPE_OPERAND, FormulaToken::TOKEN_SUBTYPE_TEXT);
+                        $value = '';
+                    }
+                } else {
+                    $value .= $this->formulaText[$index];
+                }
+                ++$index;
+
+                continue;
+            }
+
+            // single-quoted strings (links)
+            // embeds are double
+            // end does not mark a token
+            if ($inPath) {
+                if ($this->formulaText[$index] == self::TOKEN_QUOTE_SINGLE) {
+                    if ((($index + 2) <= $formulaLength) && ($this->formulaText[$index + 1] == self::TOKEN_QUOTE_SINGLE)) {
+                        $value .= self::TOKEN_QUOTE_SINGLE;
+                        ++$index;
+                    } else {
+                        $inPath = false;
+                    }
+                } else {
+                    $value .= $this->formulaText[$index];
+                }
+                ++$index;
+
+                continue;
+            }
+
+            // bracked strings (R1C1 range index or linked workbook name)
+            // no embeds (changed to "()" by Excel)
+            // end does not mark a token
+            if ($inRange) {
+                if ($this->formulaText[$index] == self::TOKEN_BRACKET_CLOSE) {
+                    $inRange = false;
+                }
+                $value .= $this->formulaText[$index];
+                ++$index;
+
+                continue;
+            }
+
+            // error values
+            // end marks a token, determined from absolute list of values
+            if ($inError) {
+                $value .= $this->formulaText[$index];
+                ++$index;
+                if (in_array($value, $ERRORS)) {
+                    $inError = false;
+                    $tokens1[] = new FormulaToken($value, FormulaToken::TOKEN_TYPE_OPERAND, FormulaToken::TOKEN_SUBTYPE_ERROR);
+                    $value = '';
+                }
+
+                continue;
+            }
+
+            // scientific notation check
+            if (strpos(self::TOKEN_OPERATORS_SN, $this->formulaText[$index]) !== false) {
