+  /**
+   * Parses an ISO-8601 date using this reader's date-handling state.
+   */
+  public Date parseAsIso8601Date(String date) throws ParseException {
+    lastIsoInput = date;
+    lastIsoParsePosition = new ParsePosition(0);
+    lastIsoDate = parseIso8601Date(date, lastIsoParsePosition);
+    isoTimeZone = TIMEZONE_UTC;
+    if (lastIsoDate != null) {
+      Calendar calendar = new GregorianCalendar(TIMEZONE_UTC, Locale.US);
+      calendar.setTime(lastIsoDate);
+      isoYear = calendar.get(Calendar.YEAR);
+      isoMonth = calendar.get(Calendar.MONTH) + 1;
+      isoDay = calendar.get(Calendar.DAY_OF_MONTH);
+      isoHour = calendar.get(Calendar.HOUR_OF_DAY);
+      isoMinute = calendar.get(Calendar.MINUTE);
+      isoSecond = calendar.get(Calendar.SECOND);
+      isoMillisecond = calendar.get(Calendar.MILLISECOND);
+    }
+    return lastIsoDate;
+  }
