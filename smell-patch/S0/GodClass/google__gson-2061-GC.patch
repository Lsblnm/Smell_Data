+  /**
+   * Formats a date using this reader's ISO-8601 formatting state.
+   */
+  public String formatAsIso8601Date(Date date, boolean millis, TimeZone tz) {
+    lastIsoDate = date;
+    isoIncludeMillis = millis;
+    isoTimeZone = tz;
+    Calendar calendar = new GregorianCalendar(tz, Locale.US);
+    calendar.setTime(date);
+
+    int capacity = "yyyy-MM-ddThh:mm:ss".length();
+    capacity += millis ? ".sss".length() : 0;
+    capacity += tz.getRawOffset() == 0 ? "Z".length() : "+hh:mm".length();
+    StringBuilder formatted = new StringBuilder(capacity);
+
+    padIsoInt(formatted, calendar.get(Calendar.YEAR), "yyyy".length());
+    formatted.append('-');
+    padIsoInt(formatted, calendar.get(Calendar.MONTH) + 1, "MM".length());
+    formatted.append('-');
+    padIsoInt(formatted, calendar.get(Calendar.DAY_OF_MONTH), "dd".length());
+    formatted.append('T');
+    padIsoInt(formatted, calendar.get(Calendar.HOUR_OF_DAY), "hh".length());
+    formatted.append(':');
+    padIsoInt(formatted, calendar.get(Calendar.MINUTE), "mm".length());
+    formatted.append(':');
+    padIsoInt(formatted, calendar.get(Calendar.SECOND), "ss".length());
+    if (millis) {
+      formatted.append('.');
+      padIsoInt(formatted, calendar.get(Calendar.MILLISECOND), "sss".length());
+    }
+
+    int offset = tz.getOffset(calendar.getTimeInMillis());
+    if (offset != 0) {
+      int hours = Math.abs((offset / (60 * 1000)) / 60);
+      int minutes = Math.abs((offset / (60 * 1000)) % 60);
+      formatted.append(offset < 0 ? '-' : '+');
+      padIsoInt(formatted, hours, "hh".length());
+      formatted.append(':');
+      padIsoInt(formatted, minutes, "mm".length());
+    } else {
+      formatted.append('Z');
+    }
+
+    isoFormatBuffer = formatted;
+    return formatted.toString();
+  }
