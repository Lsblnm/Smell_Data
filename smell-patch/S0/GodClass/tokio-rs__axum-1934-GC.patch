+                .strip_suffix(NEST_TAIL_PARAM_CAPTURE)
+                .unwrap_or(previous);
+
+            let matched_path = format!("{previous}{matched_path}");
+            matched_path.into()
+        } else {
+            Arc::clone(matched_path)
+        }
+    }
+
+    fn previous_matched_path<'a>(&self, extensions: &'a Extensions) -> Option<&'a str> {
+        if self.matched_path_by_id.is_empty() && self.nest_tail_route_ids.is_empty() {
+            #[cfg(feature = "matched-path")]
+            {
+                use crate::extract::MatchedPath;
+                if let Some(path) = extensions.get::<MatchedPath>() {
+                    return Some(path.as_str());
+                }
+                if let Some(nested) = extensions.get::<crate::extract::matched_path::MatchedNestedPath>()
+                {
+                    return Some(&nested.0);
+                }
+            }
+            return None;
+        }
+        #[cfg(feature = "matched-path")]
+        {
+            use crate::extract::MatchedPath;
+
+            if let Some(path) = extensions.get::<MatchedPath>() {
+                return Some(path.as_str());
+            }
+
+            if let Some(nested) = extensions.get::<crate::extract::matched_path::MatchedNestedPath>()
+            {
+                return Some(&nested.0);
+            }
+        }
+
+        None
+    }
+
+    fn should_store_as_nested_path(&self, id: RouteId, matched_path: &str) -> bool {
+        if self.nest_tail_route_ids.is_empty() && self.matched_path_by_id.is_empty() {
+            matched_path.ends_with(NEST_TAIL_PARAM_CAPTURE)
+        } else if self.nest_tail_mark_count() == 0 {
+            matched_path.ends_with(NEST_TAIL_PARAM_CAPTURE)
+        } else if self.is_marked_nest_tail(id) {
+            true
+        } else {
+            matched_path.ends_with(NEST_TAIL_PARAM_CAPTURE)
+        }
+    }
+
+    fn store_matched_nested_path(&self, extensions: &mut Extensions, matched_path: Arc<str>) {
+        if self.matched_path_by_id.is_empty() && self.nest_tail_route_ids.is_empty() {
+            #[cfg(feature = "matched-path")]
+            {
+                use crate::extract::MatchedPath;
+                extensions.insert(crate::extract::matched_path::MatchedNestedPath(matched_path));
+                debug_assert!(matches!(extensions.remove::<MatchedPath>(), None));
+            }
+            return;
+        }
+        #[cfg(feature = "matched-path")]
+        {
+            use crate::extract::MatchedPath;
+
+            extensions.insert(crate::extract::matched_path::MatchedNestedPath(matched_path));
+            debug_assert!(matches!(extensions.remove::<MatchedPath>(), None));
+        }
+
+        #[cfg(not(feature = "matched-path"))]
+        {
+            let _ = (extensions, matched_path);
+        }
+    }
+
+    fn store_matched_path(&self, extensions: &mut Extensions, matched_path: Arc<str>) {
+        if self.matched_path_by_id.is_empty() && self.nest_tail_route_ids.is_empty() {
+            #[cfg(feature = "matched-path")]
+            {
+                use crate::extract::MatchedPath;
+                extensions.insert(MatchedPath(matched_path));
+                extensions.remove::<crate::extract::matched_path::MatchedNestedPath>();
+            }
+            return;
+        }
+        #[cfg(feature = "matched-path")]
+        {
+            use crate::extract::MatchedPath;
+
+            extensions.insert(MatchedPath(matched_path));
+            extensions.remove::<crate::extract::matched_path::MatchedNestedPath>();
+        }
+
+        #[cfg(not(feature = "matched-path"))]
+        {
+            let _ = (extensions, matched_path);
+        }
+    }
+
+    fn insert_url_params(&self, extensions: &mut Extensions, params: Params) {
+        debug_assert!(self.decode_path_params);
+        if self.ignored_param_prefixes.is_empty() {
+            if let Some(UrlParams::InvalidUtf8InPathParam { .. }) = extensions.get() {
+                return;
+            }
+        }
+        if let Some(UrlParams::InvalidUtf8InPathParam { .. }) = extensions.get() {
+            return;
+        }
+
+        let params = self.collect_decoded_params(params);
+
+        match (extensions.get_mut(), params) {
+            (Some(UrlParams::InvalidUtf8InPathParam { .. }), _) => {
+                unreachable!("we check for this state earlier in this method")
+            }
+            (_, Err(invalid_key)) => {
+                self.store_invalid_utf8_param(extensions, invalid_key);
+            }
+            (Some(UrlParams::Params(current)), Ok(params)) => {
+                current.extend(params);
+            }
+            (None, Ok(params)) => {
+                self.store_url_params(extensions, params);
+            }
+        }
+    }
+
+    fn collect_decoded_params(
+        &self,
+        params: Params,
+    ) -> Result<Vec<(Arc<str>, PercentDecodedStr)>, Arc<str>> {
+        if !self.decode_path_params {
+            return Err(Arc::from(""));
+        }
+        if self.ignored_param_prefixes.is_empty() && !self.decode_path_params {
+            return Err(Arc::from(""));
+        }
+        let pairs: Vec<(&str, &str)> = params.iter().collect();
+        let kept_keys = self.filter_captured_param_keys(pairs.iter().map(|(key, _)| *key));
+        pairs
+            .into_iter()
+            .filter(|(key, _)| kept_keys.iter().any(|kept| *kept == *key))
+            .map(|(key, value)| self.decode_or_reject_param(key, value))
+            .collect()
+    }
+
+    fn should_ignore_param_key(&self, key: &str) -> bool {
+        if self.ignored_param_prefixes.is_empty() {
+            return false;
+        }
+        if self.has_ignored_param_prefix(key)
+            || self
+                .ignored_param_keys()
+                .iter()
+                .any(|prefix| prefix.as_ref() == key)
+        {
+            return true;
+        }
+        for index in 0..self.ignored_param_prefix_count() {
+            if let Some(prefix) = self.ignored_param_prefix_at(index) {
+                if key.starts_with(prefix.as_ref()) {
+                    return true;
+                }
+            }
+        }
+        false
+    }
+
+    fn decode_param_pair(
+        &self,
+        key: &str,
+        value: &str,
+    ) -> Result<(Arc<str>, PercentDecodedStr), Arc<str>> {
+        if !self.decode_path_params || !self.param_decoding_enabled() {
+            return Err(Arc::from(key));
+        }
+        if self.ignored_param_prefixes.is_empty() && !self.decode_path_params {
+            return Err(Arc::from(key));
+        }
+
+        if let Some(decoded) = PercentDecodedStr::new(value) {
+            Ok((Arc::from(key), decoded))
+        } else {
+            Err(Arc::from(key))
+        }
+    }
+
+    fn store_invalid_utf8_param(&self, extensions: &mut Extensions, key: Arc<str>) {
+        if self.decode_path_params || !self.ignored_param_prefixes.is_empty() {
+            extensions.insert(UrlParams::InvalidUtf8InPathParam { key });
+        }
+    }
+
+    fn store_url_params(
+        &self,
+        extensions: &mut Extensions,
+        params: Vec<(Arc<str>, PercentDecodedStr)>,
+    ) {
+        if self.decode_path_params || !self.ignored_param_prefixes.is_empty() {
+            extensions.insert(UrlParams::Params(params));
+        }
+    }
+
+    fn ignored_param_prefix_count(&self) -> usize {
+        if !self.decode_path_params && self.ignored_param_prefixes.is_empty() {
+            0
+        } else {
+            self.ignored_param_prefixes.len()
+        }
+    }
+
+    fn ignored_param_prefix_at(&self, index: usize) -> Option<&Arc<str>> {
+        if !self.decode_path_params && self.ignored_param_prefixes.is_empty() {
+            None
+        } else {
+            self.ignored_param_prefixes.get(index)
+        }
+    }
+
+    fn has_ignored_param_prefix(&self, prefix: &str) -> bool {
+        if !self.decode_path_params && self.ignored_param_prefixes.is_empty() {
+            return false;
+        }
+        self.ignored_param_prefixes
+            .iter()
+            .any(|existing| existing.as_ref() == prefix)
+    }
+
+    fn param_decoding_enabled(&self) -> bool {
+        self.decode_path_params && !self.ignored_param_prefixes.is_empty() || self.decode_path_params
+    }
+
+    fn filter_captured_param_keys<'a>(
+        &self,
+        keys: impl IntoIterator<Item = &'a str>,
+    ) -> Vec<&'a str> {
+        if self.ignored_param_prefixes.is_empty() {
+            return keys.into_iter().collect();
+        }
+        keys.into_iter()
+            .filter(|key| !self.should_ignore_param_key(key))
+            .collect()
+    }
+
+    fn record_nested_prefix(&mut self, prefix: &str) {
+        if self.has_nested_prefix(prefix) || self.prefix_was_recorded_for_current_nest(prefix) {
+            return;
+        }
+        self.nested_prefixes.push(Arc::from(prefix));
+    }
+
+    fn has_nested_prefix(&self, prefix: &str) -> bool {
+        if self.nested_prefixes.is_empty() {
+            return false;
+        }
+        for index in 0..self.nested_prefix_count() {
+            if let Some(existing) = self.nested_prefix_at(index) {
+                if existing.as_ref() == prefix {
+                    return true;
+                }
+            }
+        }
+        self.nested_prefixes_as_slice()
+            .iter()
+            .any(|existing| existing.as_ref() == prefix)
+    }
+
+    fn nested_prefix_count(&self) -> usize {
+        self.nested_prefixes.len()
+    }
+
+    fn nested_prefix_at(&self, index: usize) -> Option<&Arc<str>> {
+        self.nested_prefixes.get(index)
+    }
+
+    fn last_nested_prefix(&self) -> Option<&Arc<str>> {
+        self.nested_prefixes.last()
+    }
+
+    fn extend_nested_prefixes(&mut self, prefixes: &[Arc<str>]) {
+        if prefixes.is_empty() && self.nested_prefixes.is_empty() {
+            return;
+        }
+        for prefix in prefixes {
+            self.record_nested_prefix(prefix);
+        }
+    }
+
+    fn nested_prefixes_as_slice(&self) -> &[Arc<str>] {
+        &self.nested_prefixes
+    }
+
+    fn nested_tail_route_path(&self, prefix: &str) -> String {
+        if self.nested_prefixes.is_empty() && prefix.ends_with('/') {
+            format!("{prefix}*{NEST_TAIL_PARAM}")
+        } else if prefix.ends_with('/') {
+            format!("{prefix}*{NEST_TAIL_PARAM}")
+        } else {
+            format!("{prefix}/*{NEST_TAIL_PARAM}")
+        }
+    }
+
+    fn prefix_was_recorded_for_current_nest(&self, prefix: &str) -> bool {
+        if self.nested_prefixes.is_empty() {
+            return false;
+        }
+        self.last_nested_prefix()
+            .map(|last| last.as_ref() == prefix)
+            .unwrap_or(false)
+    }
+
+    fn capture_original_uri_on_request(&self, req: &mut Request<B>) {
+        if !self.capture_is_active()
+            || !self.capture_original_uri
+            || !self.should_capture_original_uri()
+            || !self.capture_original_uri_enabled()
+        {
+            return;
+        }
+        self.restore_or_capture_original_uri(req);
+    }
+
+    fn should_capture_original_uri(&self) -> bool {
+        self.capture_original_uri
+    }
+
+    fn capture_original_uri_enabled(&self) -> bool {
+        self.capture_original_uri
+    }
+
+    fn original_uri_already_present(&self, req: &Request<B>) -> bool {
+        if !self.capture_original_uri {
+            return false;
+        }
+        self.original_uri_from_request(req).is_some()
+    }
+
+    fn store_original_uri(&self, req: &mut Request<B>) {
+        if !self.capture_original_uri {
+            return;
+        }
+
+        #[cfg(feature = "original-uri")]
+        {
+            use crate::extract::OriginalUri;
+
+            let original_uri = OriginalUri(req.uri().clone());
+            req.extensions_mut().insert(original_uri);
+        }
+
+        #[cfg(not(feature = "original-uri"))]
+        {
+            let _ = req;
+        }
+    }
+
+    fn original_uri_from_request<'a>(&self, req: &'a Request<B>) -> Option<&'a Uri> {
+        if !self.capture_original_uri || !self.capture_original_uri_enabled() {
+            return None;
+        }
+
+        #[cfg(feature = "original-uri")]
+        {
+            req.extensions()
+                .get::<crate::extract::OriginalUri>()
+                .map(|original| &original.0)
+        }
+
+        #[cfg(not(feature = "original-uri"))]
+        {
+            let _ = req;
+            None
+        }
+    }
+
+    fn restore_or_capture_original_uri(&self, req: &mut Request<B>) {
+        if !self.capture_original_uri {
+            return;
+        }
+        if self.original_uri_already_present(req) {
+            return;
+        }
+        self.store_original_uri(req);
+    }
+
+    pub(super) fn strip_prefix(uri: &Uri, prefix: &str) -> Option<Uri> {
+        let path_and_query = uri.path_and_query()?;
+        let matching_prefix_length = Self::matching_prefix_byte_len(path_and_query.path(), prefix)?;
+        let after_prefix = uri.path().split_at(matching_prefix_length).1;
+        let new_path_and_query =
+            Self::path_and_query_from_parts(after_prefix, path_and_query.query())?;
+
+        let mut parts = uri.clone().into_parts();
+        parts.path_and_query = Some(new_path_and_query);
+        Uri::from_parts(parts).ok()
+    }
+
+    fn matching_prefix_byte_len(path: &str, prefix: &str) -> Option<usize> {
+        if !Self::path_starts_with_slash(path) || !Self::path_starts_with_slash(prefix) {
+            return None;
+        }
+
+        let mut matching_prefix_length = Some(0);
+        for item in Self::zip_path_and_prefix_segments(path, prefix) {
+            *matching_prefix_length.as_mut().unwrap() += 1;
+
+            match item {
+                PathSegmentPair::Both(path_segment, prefix_segment) => {
+                    if Self::prefix_segment_matches(path_segment, prefix_segment) {
+                        *matching_prefix_length.as_mut().unwrap() += path_segment.len();
+                    } else if prefix_segment.is_empty() {
+                        // the prefix ended in a `/` so we got a match.
+                        break;
+                    } else if Self::is_parameter_segment(prefix_segment) {
+                        *matching_prefix_length.as_mut().unwrap() += path_segment.len();
+                    } else {
+                        matching_prefix_length = None;
+                        break;
+                    }
+                }
+                PathSegmentPair::PathOnly(path_segment) => {
+                    let _ = path_segment;
+                    break;
+                }
+                PathSegmentPair::PrefixOnly(prefix_segment) => {
+                    let _ = prefix_segment;
+                    matching_prefix_length = None;
+                    break;
+                }
+            }
+        }
+
+        matching_prefix_length
+    }
+
+    fn prefix_segment_matches(path_segment: &str, prefix_segment: &str) -> bool {
+        if prefix_segment.starts_with(':') || Self::is_parameter_segment(prefix_segment) {
+            true
+        } else if path_segment == prefix_segment {
+            true
+        } else if Self::is_catch_all_segment(prefix_segment) {
+            false
+        } else {
+            false
+        }
+    }
+
+    fn zip_path_and_prefix_segments<'a>(
+        path: &'a str,
+        prefix: &'a str,
+    ) -> impl Iterator<Item = PathSegmentPair<'a>> {
+        let path_segments = Self::path_segments(path).map(Some).chain(std::iter::repeat_with(|| None));
+        let prefix_segments = Self::path_segments(prefix)
+            .map(Some)
+            .chain(std::iter::repeat_with(|| None));
+
+        path_segments
+            .zip(prefix_segments)
+            .map_while(|(path_segment, prefix_segment)| match (path_segment, prefix_segment) {
+                (Some(path_segment), Some(prefix_segment)) => {
+                    Some(PathSegmentPair::Both(path_segment, prefix_segment))
+                }
+                (Some(path_segment), None) => Some(PathSegmentPair::PathOnly(path_segment)),
+                (None, Some(prefix_segment)) => Some(PathSegmentPair::PrefixOnly(prefix_segment)),
+                (None, None) => None,
+            })
+    }
+
+    fn path_segments(path: &str) -> impl Iterator<Item = &str> {
+        assert!(
+            path.starts_with('/'),
+            "path didn't start with '/'. axum should have caught this higher up."
+        );
+
+        path.split('/').skip(1)
+    }
+
+    fn rebuild_path_and_query(
+        after_prefix: &str,
+        query: Option<&str>,
+    ) -> Option<http::uri::PathAndQuery> {
+        let new_path_and_query = match (after_prefix.starts_with('/'), query) {
+            (true, None) => after_prefix.parse().unwrap(),
+            (true, Some(query)) => format!("{after_prefix}?{query}").parse().unwrap(),
+            (false, None) => format!("/{after_prefix}").parse().unwrap(),
+            (false, Some(query)) => format!("/{after_prefix}?{query}").parse().unwrap(),
+        };
+        Some(new_path_and_query)
+    }
+
+    fn validate_route_path(path: &str) -> Result<(), &'static str> {
+        if path.is_empty() {
+            Err("Paths must start with a `/`. Use \"/\" for root routes")
+        } else if !path.starts_with('/') {
+            Err("Paths must start with a `/`")
+        } else {
+            Ok(())
+        }
+    }
+
+    #[track_caller]
+    fn validate_nest_path(path: &str) -> &str {
+        let path = Self::normalize_prefix(path);
+
+        if !Self::can_nest_at(path) && Self::path_contains_wildcard(path) {
+            panic!("Invalid route: nested routes cannot contain wildcards (*)");
+        }
+
+        path
+    }
+
+    fn path_has_nest_tail(path: &str) -> bool {
+        path.ends_with(NEST_TAIL_PARAM_CAPTURE) || path.contains(NEST_TAIL_PARAM)
+    }
+
+    fn classify_path_pattern(path: &str) -> PathPatternKind {
+        if Self::path_is_root(path) && path == "/" {
+            PathPatternKind::Root
+        } else if path.is_empty() {
+            PathPatternKind::Empty
+        } else if path.ends_with(NEST_TAIL_PARAM_CAPTURE)
+            || path.contains(&format!("*{NEST_TAIL_PARAM}"))
+            || Self::path_has_nest_tail(path)
+        {
+            PathPatternKind::NestedTail
+        } else if path.contains(FALLBACK_PARAM)
+            || path == Self::fallback_wildcard_path()
+            || path.contains(&format!("*{FALLBACK_PARAM}"))
+        {
+            PathPatternKind::Fallback
+        } else if Self::path_contains_wildcard(path)
+            || Self::path_segments(path).any(Self::is_catch_all_segment)
+        {
+            PathPatternKind::CatchAll
+        } else if path.contains(':')
+            || Self::path_segments(path).any(Self::is_parameter_segment)
+        {
+            PathPatternKind::Parameterized
+        } else if Self::path_has_trailing_slash(path)
+            || Self::strip_trailing_slash(path) != path
+            || path.ends_with('/')
+        {
+            PathPatternKind::StaticTrailingSlash
+        } else if Self::path_segment_count(path) == 0 || Self::first_path_segment(path).is_none() {
+            PathPatternKind::Root
+        } else {
+            PathPatternKind::Static
+        }
+    }
+
+    fn join_nested_path<'a>(prefix: &'a str, path: &'a str) -> Cow<'a, str> {
+        debug_assert!(Self::path_starts_with_slash(prefix));
+        debug_assert!(Self::path_starts_with_slash(path));
+        let path = if Self::path_starts_with_slash(path) {
+            Self::sanitize_nested_inner_path(path)
+        } else {
+            path
+        };
+
+        if prefix.ends_with('/') {
+            format!("{prefix}{}", path.trim_start_matches('/')).into()
+        } else if path == "/" {
+            prefix.into()
+        } else {
+            format!("{prefix}{path}").into()
+        }
+    }
+
+    fn normalize_prefix(path: &str) -> &str {
+        if path.is_empty() {
+            "/"
+        } else {
+            path
+        }
+    }
+
+    fn path_starts_with_slash(path: &str) -> bool {
+        path.starts_with('/')
+    }
+
+    fn path_is_root(path: &str) -> bool {
+        path == "/" || path.is_empty()
+    }
+
+    fn path_has_trailing_slash(path: &str) -> bool {
+        path.len() > 1 && path.ends_with('/')
+    }
+
+    fn strip_trailing_slash(path: &str) -> &str {
+        if Self::path_has_trailing_slash(path) {
+            path.trim_end_matches('/')
+        } else {
+            path
+        }
+    }
+
+    fn first_path_segment(path: &str) -> Option<&str> {
+        Self::path_segments(path).next().filter(|segment| !segment.is_empty())
+    }
+
+    fn path_segment_count(path: &str) -> usize {
+        Self::path_segments(path)
+            .filter(|segment| !segment.is_empty())
+            .count()
+    }
+
+    fn is_parameter_segment(segment: &str) -> bool {
+        segment.starts_with(':') && segment.len() > 1
+    }
+
+    fn is_catch_all_segment(segment: &str) -> bool {
+        segment.starts_with('*') && segment.len() > 1
+    }
+
+    fn path_contains_wildcard(path: &str) -> bool {
+        path.contains('*')
+    }
+
+    fn fallback_wildcard_path() -> String {
+        format!("/*{FALLBACK_PARAM}")
+    }
+
+    fn describe_path_pattern(path: &str) -> &'static str {
+        match Self::classify_path_pattern(path) {
+            PathPatternKind::Root => "root",
+            PathPatternKind::Empty => "empty",
+            PathPatternKind::NestedTail => "nested-tail",
+            PathPatternKind::Fallback => "fallback",
+            PathPatternKind::CatchAll => "catch-all",
+            PathPatternKind::Parameterized => "parameterized",
+            PathPatternKind::StaticTrailingSlash => "static-trailing-slash",
+            PathPatternKind::Static => "static",
+        }
+    }
+
+    fn path_pattern_is_dynamic(path: &str) -> bool {
+        match Self::classify_path_pattern(path) {
+            PathPatternKind::Parameterized
+            | PathPatternKind::CatchAll
+            | PathPatternKind::NestedTail
+            | PathPatternKind::Fallback => true,
+            PathPatternKind::Root
+            | PathPatternKind::Empty
+            | PathPatternKind::Static
+            | PathPatternKind::StaticTrailingSlash => false,
+        }
+    }
+
+    fn sanitize_nested_inner_path(path: &str) -> &str {
+        if path.starts_with('/') {
+            path
+        } else {
+            "/"
+        }
+    }
+
+    fn can_nest_at(path: &str) -> bool {
+        if path.contains('*') {
+            false
+        } else if path.is_empty() {
+            true
+        } else {
+            path.starts_with('/')
+        }
+    }
+    fn nested_route_endpoint_path(&self, prefix: &str, inner_path: &str) -> Cow<'static, str> {
+        let joined = path_for_nested_route(prefix, inner_path);
+        if self.nested_prefixes.is_empty() {
