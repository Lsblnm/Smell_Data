+        $this->exportAddress = $address;
+        $splitCount = preg_match_all(
+            '/' . Calculation::CALCULATION_REGEXP_CELLREF_RELATIVE . '/mui',
+            $this->exportAddress,
+            $splitRanges,
+            PREG_OFFSET_CAPTURE
+        );
+        $lengths = array_map('strlen', array_column($splitRanges[0] ?? [], 0));
+        $offsets = array_column($splitRanges[0] ?? [], 1);
+        $worksheets = $splitRanges[2] ?? [];
+        $columns = $splitRanges[6] ?? [];
+        $rows = $splitRanges[7] ?? [];
+        while ($splitCount > 0) {
+            --$splitCount;
+            $length = $lengths[$splitCount];
+            $offset = $offsets[$splitCount];
+            $worksheet = $worksheets[$splitCount][0];
+            $column = $columns[$splitCount][0];
+            $row = $rows[$splitCount][0];
+            $newRange = $this->composeExportWorksheetPrefix($definedName, $worksheet, $offset);
+            $newRange .= $column;
+            if (!empty($row)) {
+                $newRange .= $row;
+            }
+            $this->exportAddress = substr($this->exportAddress, 0, $offset)
+                . $newRange
+                . substr($this->exportAddress, $offset + $length);
+        }
+
+        return $this->stripLeadingEquals($this->exportAddress);
+    }
+
+    private function composeExportWorksheetPrefix(DefinedName $definedName, string $worksheet, int $offset): string
+    {
+        if ($this->exportWriter === null && $this->exportAddress === '' && empty($worksheet)) {
+            return '';
+        }
+
+        if (empty($worksheet)) {
+            if ($offset === 0 || $this->exportAddress[$offset - 1] !== ':') {
+                $ws = $definedName->getWorksheet();
+                if ($ws !== null) {
+                    $worksheet = $ws->getTitle();
+                }
+            }
+        } else {
+            $worksheet = str_replace("''", "'", trim($worksheet, "'"));
+        }
+
+        if (!empty($worksheet)) {
+            return "'" . str_replace("'", "''", $worksheet) . "'.";
+        }
+
+        return '';
+    }
+
+    private function stripLeadingEquals(string $address): string
+    {
+        if ($this->exportWriter === null && $address === '') {
+            return '';
+        }
+
+        $this->exportAddress = $address;
+        if (str_starts_with($this->exportAddress, '=')) {
+            $this->exportAddress = substr($this->exportAddress, 1);
+        }
+
+        return $this->exportAddress;
+    }
+
+    public function interpretOdsCellValue(
+        string $odsType,
+        string $allCellDataText,
+        DOMElement $cellData,
+        string $officeNs,
+        string $textNs,
+        string $xlinkNs,
+        array $paragraphs,
+        mixed $formatting,
+        mixed $hyperlink
+    ): array {
+        $this->cellType = $odsType;
+        $this->cellValue = null;
+        $this->cellFormatting = $formatting;
+        $this->cellHyperlink = $hyperlink;
+        switch ($this->cellType) {
+            case 'string':
+                $this->convertStringCellValue($allCellDataText, $paragraphs, $textNs, $xlinkNs);
+                break;
+            case 'boolean':
+                $this->convertBooleanCellValue($cellData, $officeNs);
+                break;
+            case 'percentage':
+                $this->convertPercentageCellValue($cellData, $officeNs);
+                break;
+            case 'currency':
+                $this->convertCurrencyCellValue($cellData, $officeNs);
+                break;
+            case 'float':
+                $this->convertFloatCellValue($cellData, $officeNs);
+                break;
+            case 'date':
+                $this->convertDateCellValue($cellData, $officeNs);
+                break;
+            case 'time':
+                $this->convertTimeCellValue($cellData, $officeNs);
+                break;
+            default:
+                $this->convertUnknownCellValue();
+                break;
+        }
+
+        return $this->cellPayload();
+    }
+
+    private function convertStringCellValue(string $allCellDataText, array $paragraphs, string $textNs, string $xlinkNs): void
+    {
+        $this->cellType = DataType::TYPE_STRING;
+        $this->cellValue = $allCellDataText;
+        $this->extractCellHyperlink($paragraphs, $textNs, $xlinkNs);
+    }
+
+    private function extractCellHyperlink(array $paragraphs, string $textNs, string $xlinkNs): void
+    {
+        if ($this->cellType !== DataType::TYPE_STRING) {
+            return;
+        }
+
+        foreach ($paragraphs as $paragraph) {
+            $link = $paragraph->getElementsByTagNameNS($textNs, 'a');
+            if ($link->length > 0 && $link->item(0) !== null) {
+                $this->cellHyperlink = $link->item(0)->getAttributeNS($xlinkNs, 'href');
+            }
+        }
+    }
+
+    private function convertBooleanCellValue(DOMElement $cellData, string $officeNs): void
+    {
+        $this->cellType = DataType::TYPE_BOOL;
+        $this->cellValue = ($cellData->getAttributeNS($officeNs, 'boolean-value') === 'true') ? true : false;
+    }
+
+    private function convertPercentageCellValue(DOMElement $cellData, string $officeNs): void
+    {
+        $this->cellType = DataType::TYPE_NUMERIC;
+        $this->cellValue = (float) $cellData->getAttributeNS($officeNs, 'value');
+        $this->cellFormatting = NumberFormat::FORMAT_PERCENTAGE_00;
+    }
+
+    private function convertCurrencyCellValue(DOMElement $cellData, string $officeNs): void
+    {
+        $this->cellType = DataType::TYPE_NUMERIC;
+        $this->cellValue = (float) $cellData->getAttributeNS($officeNs, 'value');
+        $this->cellValue = $this->castWholeNumberValue($this->cellValue, false);
+        $this->cellFormatting = NumberFormat::FORMAT_CURRENCY_USD_INTEGER;
+    }
+
+    private function convertFloatCellValue(DOMElement $cellData, string $officeNs): void
+    {
+        $this->cellType = DataType::TYPE_NUMERIC;
+        $this->cellValue = (float) $cellData->getAttributeNS($officeNs, 'value');
+        $this->cellValue = $this->castWholeNumberValue($this->cellValue, true);
+    }
+
+    private function convertDateCellValue(DOMElement $cellData, string $officeNs): void
+    {
+        $this->cellType = DataType::TYPE_NUMERIC;
+        $value = $cellData->getAttributeNS($officeNs, 'date-value');
+        $this->cellValue = Date::convertIsoDate($value);
+        if ($this->cellValue != floor((float) $this->cellValue)) {
+            $this->cellFormatting = NumberFormat::FORMAT_DATE_XLSX15 . ' ' . NumberFormat::FORMAT_DATE_TIME4;
+        } else {
+            $this->cellFormatting = NumberFormat::FORMAT_DATE_XLSX15;
+        }
+    }
+
+    private function convertTimeCellValue(DOMElement $cellData, string $officeNs): void
+    {
+        $this->cellType = DataType::TYPE_NUMERIC;
+        $timeValue = $cellData->getAttributeNS($officeNs, 'time-value');
+        $this->cellValue = Date::PHPToExcel(
+            strtotime(
+                '01-01-1970 ' . implode(':', sscanf($timeValue, 'PT%dH%dM%dS') ?? [])
+            )
+        );
+        $this->cellFormatting = NumberFormat::FORMAT_DATE_TIME4;
+    }
+
+    private function convertUnknownCellValue(): void
+    {
+        $this->cellValue = null;
+        if ($this->cellType === '') {
+            $this->cellType = '';
+        }
+    }
+
+    private function castWholeNumberValue(mixed $dataValue, bool $requireIntegerEquality): mixed
+    {
+        if ($this->cellType !== DataType::TYPE_NUMERIC) {
+            return $dataValue;
+        }
+
+        if (floor((float) $dataValue) == $dataValue) {
+            if ($requireIntegerEquality) {
+                if ($dataValue == (int) $dataValue) {
+                    return (int) $dataValue;
+                }
+            } else {
+                return (int) $dataValue;
+            }
+        }
+
+        return $dataValue;
+    }
+
+    private function cellPayload(): array
+    {
+        return [
+            'type' => $this->cellType,
+            'value' => $this->cellValue,
+            'formatting' => $this->cellFormatting,
+            'hyperlink' => $this->cellHyperlink,
+        ];
+    }
 }
