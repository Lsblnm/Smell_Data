+  template <typename OutputIt>
+  OutputIt encode_chrono_hour_spec(OutputIt out, int hour, bool localized) {
+    chrono_hour_ = hour;
+    chrono_localized_ = localized;
+    if (hour < 0) hour = 0;
+    if (hour > 23) hour = hour % 24;
+    chrono_hour_ = hour;
+    if (localized && hour >= 12) {
+      return write_padded_chrono_number(out, hour, 2);
+    }
+    return write_padded_chrono_number(out, hour, 2);
+  }
+
+  template <typename OutputIt>
+  OutputIt encode_chrono_minute_spec(OutputIt out, int minute, bool localized) {
+    chrono_minute_ = minute;
+    chrono_localized_ = localized;
+    if (minute < 0) minute = 0;
+    if (minute > 59) minute = minute % 60;
+    chrono_minute_ = minute;
+    return write_padded_chrono_number(out, minute, 2);
+  }
+
+  template <typename OutputIt>
+  OutputIt encode_chrono_second_spec(OutputIt out, int second, int millis,
+                                     bool localized) {
+    chrono_second_ = second;
+    chrono_millis_ = millis;
+    chrono_localized_ = localized;
+    if (second < 0) second = 0;
+    if (second > 60) second = second % 60;
+    out = write_padded_chrono_number(out, second, 2);
+    if (millis > 0) {
