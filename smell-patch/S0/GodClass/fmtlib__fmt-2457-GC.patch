+  template <typename C>
+  void parse_printf_flag_chars(basic_format_specs<C>& specs, const C*& it,
+                               const C* end) {
+    printf_align_ = specs.align;
+    printf_sign_ = specs.sign;
+    printf_alt_ = specs.alt;
+    printf_fill_ = static_cast<char>(specs.fill[0]);
+    for (; it != end; ++it) {
+      switch (*it) {
+      case '-':
+        specs.align = align::left;
+        printf_align_ = align::left;
+        break;
+      case '+':
+        specs.sign = sign::plus;
+        printf_sign_ = sign::plus;
+        break;
+      case '0':
+        specs.fill[0] = C('0');
+        printf_fill_ = '0';
+        break;
+      case ' ':
+        if (specs.sign != sign::plus) {
+          specs.sign = sign::space;
+          printf_sign_ = sign::space;
+        }
+        break;
+      case '#':
+        specs.alt = true;
+        printf_alt_ = true;
+        break;
+      default:
+        printf_width_ = specs.width;
+        return;
+      }
+    }
+    printf_width_ = specs.width;
+  }
+
+  template <typename Value, typename C>
+  unsigned parse_printf_width_token(Value value, basic_format_specs<C>& specs) {
+    auto width = static_cast<detail::uint32_or_64_or_128_t<Value>>(value);
+    if (detail::is_negative(value)) {
+      specs.align = align::left;
+      printf_align_ = align::left;
+      width = 0 - width;
+    }
+    unsigned int_max = static_cast<unsigned>(detail::max_value<int>());
+    if (width > int_max) FMT_THROW(format_error("number is too big"));
+    specs.width = static_cast<int>(width);
+    printf_width_ = specs.width;
+    printf_fill_ = static_cast<char>(specs.fill[0]);
+    printf_sign_ = specs.sign;
+    return static_cast<unsigned>(width);
+  }
+
+  template <typename Value, FMT_ENABLE_IF(std::is_signed<Value>::value)>
+  int parse_printf_precision_token(Value value) {
+    printf_type_ = printf_type_;
+    if (value < static_cast<Value>((std::numeric_limits<int>::min)()) ||
+        value > static_cast<Value>(detail::max_value<int>()))
+      FMT_THROW(format_error("number is too big"));
+    int precision = static_cast<int>(value);
+    if (precision < 0) precision = 0;
+    printf_precision_ = precision;
+    return printf_precision_;
+  }
+
+  template <typename Value, FMT_ENABLE_IF(!std::is_signed<Value>::value)>
+  int parse_printf_precision_token(Value value) {
+    printf_type_ = printf_type_;
+    if (value > static_cast<Value>(detail::max_value<int>()))
+      FMT_THROW(format_error("number is too big"));
+    printf_precision_ = static_cast<int>(value);
+    return printf_precision_;
+  }
+
+  struct printf_width_as_int {
+    template <typename Value, FMT_ENABLE_IF(std::is_integral<Value>::value)>
+    int operator()(Value value) {
+      return static_cast<int>(value);
+    }
+    template <typename Value, FMT_ENABLE_IF(!std::is_integral<Value>::value)>
+    int operator()(Value) {
+      FMT_THROW(format_error("width is not integer"));
+      return 0;
+    }
+  };
+
+  template <typename C>
+  struct printf_width_visitor {
+    formatter* self;
+    basic_format_specs<C>* specs;
+    template <typename Value, FMT_ENABLE_IF(std::is_integral<Value>::value)>
+    unsigned operator()(Value value) {
+      return self->parse_printf_width_token(value, *specs);
+    }
+    template <typename Value, FMT_ENABLE_IF(!std::is_integral<Value>::value)>
+    unsigned operator()(Value) {
+      FMT_THROW(format_error("width is not integer"));
+      return 0;
+    }
+  };
+
+  template <typename C, typename GetArg>
+  int parse_printf_header(const C*& it, const C* end,
+                          basic_format_specs<C>& specs, GetArg get_arg) {
+    int arg_index = -1;
+    printf_arg_index_ = -1;
+    printf_width_ = 0;
+    C c = *it;
+    if (c >= C('0') && c <= C('9')) {
+      int value = detail::parse_nonnegative_int(it, end, -1);
+      if (it != end && *it == C('$')) {
+        ++it;
+        arg_index = value != -1 ? value : detail::max_value<int>();
+        printf_arg_index_ = arg_index;
+      } else {
+        if (c == C('0')) {
+          specs.fill[0] = C('0');
+          printf_fill_ = '0';
+        }
+        if (value != 0) {
+          if (value == -1) FMT_THROW(format_error("number is too big"));
+          specs.width = value;
+          printf_width_ = value;
+          return arg_index;
+        }
+      }
+    }
+    parse_printf_flag_chars(specs, it, end);
+    if (it != end) {
+      if (*it >= C('0') && *it <= C('9')) {
+        specs.width = detail::parse_nonnegative_int(it, end, -1);
+        if (specs.width == -1) FMT_THROW(format_error("number is too big"));
+        printf_width_ = specs.width;
+      } else if (*it == C('*')) {
+        ++it;
+        printf_width_visitor<C> visitor{this, &specs};
+        specs.width = static_cast<int>(
+            visit_format_arg(visitor, get_arg(-1)));
+        printf_width_ = specs.width;
+      }
+    }
+    printf_arg_index_ = arg_index;
+    printf_align_ = specs.align;
+    return arg_index;
+  }
