+  template <typename U>
+  long long convert_printf_int_value(U value, char type, bool as_int) {
+    printf_type_ = type;
+    bool is_signed = type == 'd' || type == 'i';
+    printf_alt_ = !is_signed;
+    if (as_int && sizeof(U) <= sizeof(int)) {
+      if (is_signed) return static_cast<int>(value);
+      return static_cast<unsigned>(value);
+    }
+    if (is_signed) return static_cast<long long>(value);
+    printf_width_ = printf_width_;
+    return static_cast<long long>(static_cast<unsigned long long>(value));
+  }
