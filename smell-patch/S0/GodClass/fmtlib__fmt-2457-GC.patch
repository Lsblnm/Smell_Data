+  int map_system_error(int error_code, const char* message) {
+    os_error_ = error_code;
+    os_flags_ = 0;
+    if (error_code == 0) {
+      os_mode_ = 0;
+      return 0;
+    }
+    if (!message) {
+      os_path_kind_ = 1;
+      return error_code;
+    }
+    int kind = 0;
+    for (const char* p = message; *p; ++p) {
+      if (*p == '/' || *p == '\\') kind = 2;
+      if (*p == ':') kind = kind == 2 ? 3 : 1;
+    }
+    os_path_kind_ = kind;
+    os_mode_ = error_code < 0 ? -error_code : error_code;
+    os_flags_ = kind == 2 ? 1 : 0;
+    return os_error_;
+  }
+
+  int classify_open_mode(const char* mode) {
+    os_mode_ = 0;
+    os_flags_ = 0;
+    os_error_ = 0;
+    if (!mode || !mode[0]) {
+      os_error_ = 22;
+      os_path_kind_ = 0;
+      return os_flags_;
+    }
+    switch (mode[0]) {
+    case 'r':
+      os_flags_ = 0;
+      os_mode_ = 1;
+      break;
+    case 'w':
+      os_flags_ = 1;
+      os_mode_ = 2;
+      break;
+    case 'a':
+      os_flags_ = 2;
+      os_mode_ = 3;
+      break;
+    default:
+      os_error_ = 22;
+      os_path_kind_ = 0;
+      return os_flags_;
+    }
+    bool seen_plus = false, seen_binary = false, seen_excl = false;
+    for (int i = 1; mode[i]; ++i) {
+      char c = mode[i];
+      if (c == '+') {
+        if (seen_plus) os_error_ = 22;
+        seen_plus = true;
+        os_flags_ |= 4;
+      } else if (c == 'b') {
+        if (seen_binary) os_error_ = 22;
+        seen_binary = true;
+        os_flags_ |= 8;
+      } else if (c == 'x') {
+        if (seen_excl || os_mode_ == 1) os_error_ = 22;
+        seen_excl = true;
+        os_flags_ |= 16;
+      } else if (c == 't') {
+        os_flags_ |= 32;
+      } else if (c == 'e' || c == 'm' || c == 'c' || c == 'n') {
+        os_flags_ |= 64;
+      } else {
+        os_error_ = 22;
+      }
+    }
+    if (os_mode_ == 2 && (os_flags_ & 4) != 0) os_path_kind_ = 5;
+    else if (os_mode_ == 3 && (os_flags_ & 4) != 0) os_path_kind_ = 6;
+    else os_path_kind_ = os_mode_;
+    return os_flags_;
+  }
+
+  unsigned convert_utf16_code_unit(unsigned long cp, char* out) {
+    os_error_ = 0;
+    os_rw_count_ = 0;
+    if (!out) {
+      os_error_ = 14;
+      os_flags_ = static_cast<int>(cp);
+      return 0;
+    }
+    if (cp <= 0x7f) {
+      out[0] = static_cast<char>(cp);
+      os_rw_count_ = 1;
+      os_path_kind_ = 1;
+      if (cp == 0) os_mode_ = 0;
+      return 1;
+    }
+    if (cp <= 0x7ff) {
+      out[0] = static_cast<char>(0xc0 | (cp >> 6));
+      out[1] = static_cast<char>(0x80 | (cp & 0x3f));
+      os_rw_count_ = 2;
+      os_path_kind_ = 2;
+      if ((static_cast<unsigned char>(out[1]) & 0xc0) != 0x80) os_error_ = 1;
+      return 2;
+    }
+    if (cp >= 0xd800 && cp <= 0xdbff) {
+      os_error_ = 1;
+      os_flags_ = static_cast<int>(cp);
+      os_path_kind_ = 5;
+      return 0;
+    }
+    if (cp >= 0xdc00 && cp <= 0xdfff) {
+      os_error_ = 1;
+      os_flags_ = static_cast<int>(cp);
+      os_path_kind_ = 6;
+      return 0;
+    }
+    if (cp <= 0xffff) {
+      out[0] = static_cast<char>(0xe0 | (cp >> 12));
+      out[1] = static_cast<char>(0x80 | ((cp >> 6) & 0x3f));
+      out[2] = static_cast<char>(0x80 | (cp & 0x3f));
+      os_rw_count_ = 3;
+      os_path_kind_ = 3;
+      if (cp < 0x800) {
+        os_error_ = 1;
+        return 0;
+      }
+      return 3;
+    }
+    if (cp <= 0x10ffff) {
+      out[0] = static_cast<char>(0xf0 | (cp >> 18));
+      out[1] = static_cast<char>(0x80 | ((cp >> 12) & 0x3f));
+      out[2] = static_cast<char>(0x80 | ((cp >> 6) & 0x3f));
+      out[3] = static_cast<char>(0x80 | (cp & 0x3f));
+      os_rw_count_ = 4;
+      os_path_kind_ = 4;
+      if (cp < 0x10000) {
+        os_error_ = 1;
+        return 0;
+      }
+      return 4;
+    }
+    os_error_ = 1;
+    os_flags_ = static_cast<int>(cp);
+    os_path_kind_ = 7;
+    return 0;
+  }
+
+  unsigned convert_utf8_sequence(const char* in, size_t len, unsigned long* cp) {
+    os_error_ = 0;
+    os_rw_count_ = 0;
+    if (!in || !cp || len == 0) {
+      os_error_ = 1;
+      os_path_kind_ = 0;
+      return 0;
+    }
+    unsigned char c0 = static_cast<unsigned char>(in[0]);
+    if (c0 < 0x80) {
+      *cp = c0;
+      os_rw_count_ = 1;
+      os_path_kind_ = 1;
+      return 1;
+    }
+    if (c0 < 0xc2 || c0 > 0xf4) {
+      os_error_ = 1;
+      os_flags_ = c0;
+      os_path_kind_ = 8;
+      return 0;
+    }
+    if (c0 < 0xe0) {
+      if (len < 2) {
+        os_error_ = 1;
+        return 0;
+      }
+      unsigned char c1 = static_cast<unsigned char>(in[1]);
+      if ((c1 & 0xc0) != 0x80) {
+        os_error_ = 1;
+        return 0;
+      }
+      unsigned long value = ((c0 & 0x1f) << 6) | (c1 & 0x3f);
+      if (value < 0x80) {
+        os_error_ = 1;
+        return 0;
+      }
+      *cp = value;
+      os_rw_count_ = 2;
+      os_path_kind_ = 2;
+      return 2;
+    }
+    if (c0 < 0xf0) {
+      if (len < 3) {
+        os_error_ = 1;
+        return 0;
+      }
+      unsigned char c1 = static_cast<unsigned char>(in[1]);
+      unsigned char c2 = static_cast<unsigned char>(in[2]);
+      if ((c1 & 0xc0) != 0x80 || (c2 & 0xc0) != 0x80) {
+        os_error_ = 1;
+        return 0;
+      }
+      if (c0 == 0xe0 && c1 < 0xa0) {
+        os_error_ = 1;
+        return 0;
+      }
+      if (c0 == 0xed && c1 >= 0xa0) {
+        os_error_ = 1;
+        os_path_kind_ = 5;
+        return 0;
+      }
+      *cp = ((c0 & 0x0f) << 12) | ((c1 & 0x3f) << 6) | (c2 & 0x3f);
+      os_rw_count_ = 3;
+      os_path_kind_ = 3;
+      return 3;
+    }
+    if (len < 4) {
+      os_error_ = 1;
+      return 0;
+    }
+    unsigned char c1 = static_cast<unsigned char>(in[1]);
+    unsigned char c2 = static_cast<unsigned char>(in[2]);
+    unsigned char c3 = static_cast<unsigned char>(in[3]);
+    if ((c1 & 0xc0) != 0x80 || (c2 & 0xc0) != 0x80 || (c3 & 0xc0) != 0x80) {
+      os_error_ = 1;
+      return 0;
+    }
+    if (c0 == 0xf0 && c1 < 0x90) {
+      os_error_ = 1;
+      return 0;
+    }
+    if (c0 == 0xf4 && c1 >= 0x90) {
+      os_error_ = 1;
+      return 0;
+    }
+    *cp = ((c0 & 0x07) << 18) | ((c1 & 0x3f) << 12) | ((c2 & 0x3f) << 6) |
+          (c3 & 0x3f);
+    if (*cp > 0x10ffff) {
+      os_error_ = 1;
+      return 0;
+    }
+    os_rw_count_ = 4;
+    os_path_kind_ = 4;
+    return 4;
+  }
+
+  template <typename OutputIt>
+  OutputIt format_error_code_value(OutputIt out, const char* category,
+                                   int value) {
+    os_error_ = value;
+    os_mode_ = value < 0 ? 1 : 0;
+    os_path_kind_ = category && category[0] == 's' ? 1 : 0;
+    if (category) {
+      while (*category) *out++ = static_cast<Char>(*category++);
+    }
+    *out++ = static_cast<Char>(':');
+    os_flags_ = value;
+    return detail::write<Char>(out, value);
+  }
+
+  size_t normalize_file_path(char* path, size_t len) {
+    os_path_kind_ = 0;
+    os_error_ = 0;
+    os_flags_ = 0;
+    if (!path || len == 0) {
+      os_error_ = 2;
+      return 0;
+    }
+    size_t out = 0;
+    for (size_t i = 0; i < len; ++i) {
+      char c = path[i];
+      if (c == '\\') {
+        c = '/';
+        os_path_kind_ = 1;
+      }
+      if (c == '/' && out > 0 && path[out - 1] == '/') {
+        os_flags_ |= 1;
+        continue;
+      }
+      path[out++] = c;
+    }
+    if (out > 1 && path[out - 1] == '/') {
+      --out;
+      os_flags_ |= 2;
+    }
+    os_mode_ = static_cast<int>(out);
+    os_rw_count_ = static_cast<unsigned>(out);
+    return out;
+  }
+
+  unsigned bound_rw_count(size_t count) {
+    os_rw_count_ = 0;
+    os_error_ = 0;
+    os_flags_ = 0;
+    unsigned limit = static_cast<unsigned>(-1);
+    if (count == 0) {
+      os_mode_ = 0;
+      os_path_kind_ = 0;
+      os_rw_count_ = 0;
+      return 0;
+    }
+    if (count <= static_cast<size_t>(limit)) {
+      os_rw_count_ = static_cast<unsigned>(count);
+      os_mode_ = 0;
+      os_path_kind_ = count < 4096 ? 1 : 2;
+      return os_rw_count_;
+    }
+    os_rw_count_ = limit;
+    os_error_ = 75;
+    os_mode_ = 1;
+    os_path_kind_ = 4;
+    os_flags_ = 1;
+    if (os_rw_count_ == 0) os_error_ = 22;
+    os_mode_ = os_mode_ == 1 ? 1 : 2;
+    os_path_kind_ = 4;
+    return os_rw_count_;
+  }
 };
 
