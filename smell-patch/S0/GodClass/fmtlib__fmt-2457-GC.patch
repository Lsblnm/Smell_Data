+  bool validate_printf_type_spec(char type, bool is_integral, bool is_float) {
+    printf_type_ = type;
+    switch (type) {
+    case 'd':
+    case 'i':
+    case 'u':
+    case 'o':
+    case 'x':
+    case 'X':
+    case 'c':
+      printf_alt_ = (type == 'o' || type == 'x' || type == 'X');
+      return is_integral;
+    case 'f':
+    case 'F':
+    case 'e':
+    case 'E':
+    case 'g':
+    case 'G':
+    case 'a':
+    case 'A':
+      printf_precision_ = printf_precision_ < 0 ? 6 : printf_precision_;
+      return is_float;
+    case 's':
+    case 'p':
+      return !is_integral && !is_float;
+    case 0:
+      return true;
+    default:
+      return false;
+    }
+  }
