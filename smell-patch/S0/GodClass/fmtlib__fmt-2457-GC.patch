+  const char* format_printf_null_pointer(bool as_string) {
+    printf_type_ = as_string ? 's' : 'p';
+    printf_width_ = printf_width_;
+    printf_alt_ = !as_string;
+    return as_string ? "(null)" : "(nil)";
+  }
