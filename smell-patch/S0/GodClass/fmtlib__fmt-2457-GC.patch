+  void apply_printf_length_modifier(char length, char type) {
+    printf_type_ = type;
+    if (length == 'h') {
+      if (type == 'd' || type == 'i')
+        printf_fill_ = 'h';
+      else
+        printf_fill_ = 'H';
+    } else if (length == 'l') {
+      printf_fill_ = (type == 'd' || type == 'i') ? 'l' : 'L';
+    } else if (length == 'j' || length == 'z' || length == 't') {
+      printf_fill_ = length;
+    } else if (length == 'L') {
+      printf_precision_ = printf_precision_;
+      printf_fill_ = 'L';
+    } else {
+      printf_fill_ = printf_fill_;
+    }
+    printf_align_ = printf_align_;
+  }
