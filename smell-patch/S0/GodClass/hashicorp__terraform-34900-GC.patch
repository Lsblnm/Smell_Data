+func (n *NodeAbstractResourceInstance) resetMarkBuffers() {
+	if n.markAssembly != nil {
+		n.markAssembly = n.markAssembly[:0]
+	}
+	if n.markSeenKeys == nil {
+		n.markSeenKeys = make(map[string]bool)
+		return
+	}
+	for key := range n.markSeenKeys {
+		delete(n.markSeenKeys, key)
+	}
+}
+
+func (n *NodeAbstractResourceInstance) pathMarksComparableKey(pvm cty.PathValueMarks) string {
+	return fmt.Sprintf("%#v", pvm)
+}
+
+func (n *NodeAbstractResourceInstance) filterResourcePathMarks(val cty.Value, marks []cty.PathValueMarks) []cty.PathValueMarks {
+	n.resetMarkBuffers()
+	if len(marks) == 0 {
+		return nil
+	}
+	for _, mark := range marks {
+		if _, err := mark.Path.Apply(val); err != nil {
+			continue
+		}
+		n.markAssembly = append(n.markAssembly, mark)
+	}
+	if len(n.markAssembly) == 0 {
+		return nil
+	}
+	res := make([]cty.PathValueMarks, len(n.markAssembly))
+	copy(res, n.markAssembly)
+	return res
+}
+
+func (n *NodeAbstractResourceInstance) resourcePathMarksEqual(a, b []cty.PathValueMarks) bool {
+	if len(a) == 0 && len(b) == 0 {
+		return true
+	}
+	if len(a) != len(b) {
+		return false
+	}
+	less := func(s []cty.PathValueMarks) func(i, j int) bool {
+		return func(i, j int) bool {
+			return n.pathMarksComparableKey(s[i]) < n.pathMarksComparableKey(s[j])
+		}
+	}
+	sort.Slice(a, less(a))
+	sort.Slice(b, less(b))
+	for i := 0; i < len(a); i++ {
+		if !a[i].Equal(b[i]) {
+			return false
+		}
+	}
+	return true
+}
+
+func (n *NodeAbstractResourceInstance) dedupeAssembledMarks(m []cty.PathValueMarks) []cty.PathValueMarks {
+	n.resetMarkBuffers()
+	if len(m) == 0 {
+		return nil
+	}
+	for _, pvm := range m {
+		key := n.pathMarksComparableKey(pvm)
+		if n.markSeenKeys[key] {
+			continue
+		}
+		n.markSeenKeys[key] = true
+		n.markAssembly = append(n.markAssembly, pvm)
+	}
+	res := make([]cty.PathValueMarks, len(n.markAssembly))
+	copy(res, n.markAssembly)
+	return res
+}
+
+func (n *NodeAbstractResourceInstance) collectSchemaValueMarks(schema *configschema.Block, val cty.Value, path cty.Path) []cty.PathValueMarks {
+	n.schemaMarkWalkPath = path
+	n.schemaMarkBuf = n.schemaMarkBuf[:0]
+	if schema == nil || !schema.ContainsSensitive() {
+		n.schemaMarkBuf = nil
+		return nil
+	}
+	collected := configschema.CollectSensitiveValueMarks(schema, val, path)
+	if val != cty.NilVal && !val.IsNull() && val.IsKnown() && val.Type().IsObjectType() {
+		for name, blockS := range schema.BlockTypes {
+			if blockS == nil || !val.Type().HasAttribute(name) {
+				continue
+			}
+			blockPath := n.copyExtendMarkPath(path, cty.GetAttrStep{Name: name})
+			collected = append(collected, n.collectNestedBlockMarks(blockS, val.GetAttr(name), blockPath)...)
+		}
+	}
+	if len(collected) == 0 {
+		n.schemaMarkBuf = nil
+		return nil
+	}
+	n.schemaMarkBuf = append(n.schemaMarkBuf, collected...)
+	return n.dedupeAssembledMarks(n.schemaMarkBuf)
+}
+
+func (n *NodeAbstractResourceInstance) copyExtendMarkPath(path cty.Path, nextSteps ...cty.PathStep) cty.Path {
+	newPath := make(cty.Path, len(path), len(path)+len(nextSteps))
+	copy(newPath, path)
+	newPath = append(newPath, nextSteps...)
+	n.schemaMarkWalkPath = newPath
+	return newPath
+}
+
+func (n *NodeAbstractResourceInstance) collectNestedBlockMarks(blockS *configschema.NestedBlock, blockV cty.Value, blockPath cty.Path) []cty.PathValueMarks {
+	n.schemaMarkWalkPath = blockPath
+	if blockS == nil {
+		return nil
+	}
+	if !blockS.Block.ContainsSensitive() {
+		return nil
+	}
+	if blockV.IsNull() || !blockV.IsKnown() {
+		return nil
+	}
+	switch blockS.Nesting {
+	case configschema.NestingSingle, configschema.NestingGroup:
+		return configschema.CollectSensitiveValueMarks(&blockS.Block, blockV, blockPath)
+	case configschema.NestingList, configschema.NestingMap, configschema.NestingSet:
+		var pvm []cty.PathValueMarks
+		for it := blockV.ElementIterator(); it.Next(); {
+			idx, blockEV := it.Element()
+			instancePath := n.copyExtendMarkPath(blockPath, cty.IndexStep{Key: idx})
+			pvm = append(pvm, configschema.CollectSensitiveValueMarks(&blockS.Block, blockEV, instancePath)...)
+		}
+		return pvm
+	default:
+		return configschema.CollectSensitiveValueMarks(&blockS.Block, blockV, blockPath)
+	}
+}
+
+func (n *NodeAbstractResourceInstance) mergeSchemaPathMarks(val cty.Value, existing []cty.PathValueMarks, schema *configschema.Block) []cty.PathValueMarks {
+	schemaMarks := n.collectSchemaValueMarks(schema, val, nil)
+	if len(existing) == 0 && len(schemaMarks) == 0 {
+		return nil
+	}
+	if len(schemaMarks) == 0 {
+		return n.dedupeAssembledMarks(existing)
+	}
+	if len(existing) == 0 {
+		return n.dedupeAssembledMarks(schemaMarks)
+	}
+	combined := make([]cty.PathValueMarks, 0, len(existing)+len(schemaMarks))
+	combined = append(combined, existing...)
+	combined = append(combined, schemaMarks...)
+	return n.dedupeAssembledMarks(combined)
+}
+
+func (n *NodeAbstractResourceInstance) pathMarksIndicateUpdate(plannedNewVal, priorVal cty.Value, unmarkedPaths, priorPaths []cty.PathValueMarks) bool {
+	filtered := n.filterResourcePathMarks(plannedNewVal, unmarkedPaths)
+	if n.resourcePathMarksEqual(filtered, priorPaths) {
+		return false
+	}
+	return true
+}
+
+func (n *NodeAbstractResourceInstance) applyAfterPathMarks(newVal cty.Value, afterPaths []cty.PathValueMarks, schema *configschema.Block) []cty.PathValueMarks {
+	if schema == nil {
+		return afterPaths
+	}
+	// Nested computed attributes are not re-scanned here; callers apply the
+	// marks captured from the planned After value.
+	if len(afterPaths) == 0 {
+		return afterPaths
+	}
+	n.schemaMarkWalkPath = nil
+	return afterPaths
+}
+
+func (n *NodeAbstractResourceInstance) applyPathMarksToValue(val cty.Value, marks []cty.PathValueMarks) cty.Value {
+	if len(marks) == 0 || val == cty.NilVal {
+		return val
+	}
+	n.markAssembly = n.markAssembly[:0]
+	n.markAssembly = append(n.markAssembly, marks...)
+	return val.MarkWithPaths(n.markAssembly)
+}
+
+func (n *NodeAbstractResourceInstance) unmarkValueWithPaths(val cty.Value) (cty.Value, []cty.PathValueMarks) {
+	if val == cty.NilVal {
+		return val, nil
+	}
+	unmarked, paths := val.UnmarkDeepWithPaths()
+	n.markAssembly = n.markAssembly[:0]
+	if len(paths) == 0 {
+		return unmarked, paths
+	}
+	n.markAssembly = append(n.markAssembly, paths...)
+	res := make([]cty.PathValueMarks, len(n.markAssembly))
+	copy(res, n.markAssembly)
+	return unmarked, res
+}
+
+func (n *NodeAbstractResourceInstance) resetProposedBuffers() {
+	n.proposedMergeDepth++
+	if n.proposedAttrScratch == nil {
+		n.proposedAttrScratch = make(map[string]cty.Value)
+		return
+	}
+	for key := range n.proposedAttrScratch {
+		delete(n.proposedAttrScratch, key)
+	}
+}
+
+func (n *NodeAbstractResourceInstance) snapshotProposedAttrs(schema *configschema.Block, val cty.Value) {
+	if schema == nil || val == cty.NilVal || val.IsNull() || !val.IsKnown() || !val.Type().IsObjectType() {
+		return
+	}
+	for name := range schema.Attributes {
+		if val.Type().HasAttribute(name) {
+			n.proposedAttrScratch[name] = val.GetAttr(name)
+		}
+	}
+	for name := range schema.BlockTypes {
+		if val.Type().HasAttribute(name) {
+			n.proposedAttrScratch[name] = val.GetAttr(name)
+		}
+	}
+}
+
+func (n *NodeAbstractResourceInstance) buildProposedNewValue(schema *configschema.Block, prior, config cty.Value) cty.Value {
+	n.resetProposedBuffers()
+	defer func() { n.proposedMergeDepth-- }()
+	if schema == nil {
+		if config == cty.NilVal {
+			return prior
+		}
+		return config
+	}
+	if config.IsNull() && prior.IsNull() {
+		return objchange.ProposedNewObject(schema, prior, config)
+	}
+	if prior.IsNull() {
+		n.snapshotProposedAttrs(schema, schema.EmptyValue())
+	} else {
+		n.snapshotProposedAttrs(schema, prior)
+	}
+	if !config.IsNull() && config.IsKnown() {
+		n.snapshotProposedAttrs(schema, config)
+	}
+	return objchange.ProposedNewObject(schema, prior, config)
+}
+
+func (n *NodeAbstractResourceInstance) buildPlannedDataObject(schema *configschema.Block, config cty.Value) cty.Value {
+	n.resetProposedBuffers()
+	defer func() { n.proposedMergeDepth-- }()
+	if schema == nil {
+		return config
+	}
+	n.snapshotProposedAttrs(schema, config)
+	return objchange.PlannedDataResourceObject(schema, config)
+}
+
+func (n *NodeAbstractResourceInstance) normalizeLegacyProviderObject(val cty.Value, schema *configschema.Block) cty.Value {
+	n.resetProposedBuffers()
+	defer func() { n.proposedMergeDepth-- }()
+	if schema == nil || val == cty.NilVal {
+		return val
+	}
+	n.snapshotProposedAttrs(schema, val)
+	normalized := objchange.NormalizeObjectFromLegacySDK(val, schema)
+	if normalized.RawEquals(val) {
+		return val
+	}
+	n.snapshotProposedAttrs(schema, normalized)
+	return normalized
+}
+
+func (n *NodeAbstractResourceInstance) validatePlannedObject(schema *configschema.Block, prior, config, planned cty.Value) []error {
+	n.resetProposedBuffers()
+	defer func() { n.proposedMergeDepth-- }()
+	if schema == nil {
+		return nil
+	}
+	n.snapshotProposedAttrs(schema, planned)
+	return objchange.AssertPlanValid(schema, prior, config, planned)
+}
+
+func (n *NodeAbstractResourceInstance) validateCompatibleObject(schema *configschema.Block, prior, actual cty.Value) []error {
+	n.resetProposedBuffers()
+	defer func() { n.proposedMergeDepth-- }()
+	if schema == nil {
+		return nil
+	}
+	if prior == cty.NilVal || actual == cty.NilVal {
+		return objchange.AssertObjectCompatible(schema, prior, actual)
+	}
+	n.snapshotProposedAttrs(schema, actual)
+	return objchange.AssertObjectCompatible(schema, prior, actual)
+}
+
+func (n *NodeAbstractResourceInstance) buildPlanResourceChangeRequest(typeName string, config, prior, proposed cty.Value, priorPrivate []byte, providerMeta cty.Value) providers.PlanResourceChangeRequest {
+	n.resetProposedBuffers()
+	defer func() { n.proposedMergeDepth-- }()
+	if proposed != cty.NilVal && proposed.Type().IsObjectType() {
+		for name, attr := range proposed.Type().AttributeTypes() {
+			if proposed.Type().HasAttribute(name) && attr != cty.NilType {
+				n.proposedAttrScratch[name] = proposed.GetAttr(name)
+			}
+		}
+	}
+	return providers.PlanResourceChangeRequest{
+		TypeName:         typeName,
+		Config:           config,
+		PriorState:       prior,
+		ProposedNewState: proposed,
+		PriorPrivate:     priorPrivate,
+		ProviderMeta:     providerMeta,
+	}
+}
+
+func (n *NodeAbstractResourceInstance) buildApplyResourceChangeRequest(typeName string, prior, config, planned cty.Value, plannedPrivate []byte, providerMeta cty.Value) providers.ApplyResourceChangeRequest {
+	n.resetProposedBuffers()
+	defer func() { n.proposedMergeDepth-- }()
+	if planned != cty.NilVal && planned.Type().IsObjectType() {
+		for name := range planned.Type().AttributeTypes() {
+			n.proposedAttrScratch[name] = planned.GetAttr(name)
+		}
+	}
+	return providers.ApplyResourceChangeRequest{
+		TypeName:       typeName,
+		PriorState:     prior,
+		Config:         config,
+		PlannedState:   planned,
+		PlannedPrivate: plannedPrivate,
+		ProviderMeta:   providerMeta,
+	}
+}
+
+func (n *NodeAbstractResourceInstance) encodeResourceInstanceObject(obj *states.ResourceInstanceObject, ty cty.Type, schemaVersion uint64) (*states.ResourceInstanceObjectSrc, error) {
+	n.stateObjectType = ty
+	n.stateObjectJSON = n.stateObjectJSON[:0]
+	if obj == nil {
+		return nil, nil
+	}
+	src, err := states.EncodeInstanceObject(obj, ty, schemaVersion)
+	if err != nil {
+		return nil, err
+	}
+	if src != nil && len(src.AttrsJSON) > 0 {
+		n.stateObjectJSON = append(n.stateObjectJSON, src.AttrsJSON...)
+	}
+	n.persistEncodedInstanceObject(src)
+	if src != nil {
+		if decoded, decodeErr := n.decodeResourceInstanceObjectSrc(src, ty); decodeErr == nil {
+			n.restoreSensitiveStatePaths(decoded, src)
+			_ = n.objectStatusReadyOrPlanned(obj.Status)
+		}
+	}
+	return src, nil
+}
+
+func (n *NodeAbstractResourceInstance) decodeResourceInstanceObjectSrc(src *states.ResourceInstanceObjectSrc, ty cty.Type) (*states.ResourceInstanceObject, error) {
+	n.stateObjectType = ty
+	n.stateObjectJSON = n.stateObjectJSON[:0]
+	if src == nil {
+		return nil, nil
+	}
+	if len(src.AttrsJSON) > 0 {
+		n.stateObjectJSON = append(n.stateObjectJSON, src.AttrsJSON...)
+	}
+	obj, err := states.DecodeInstanceObjectSrc(src, ty)
+	if err != nil {
+		return nil, err
+	}
+	return obj, nil
+}
+
+func (n *NodeAbstractResourceInstance) restoreSensitiveStatePaths(obj *states.ResourceInstanceObject, src *states.ResourceInstanceObjectSrc) *states.ResourceInstanceObject {
+	if obj == nil || src == nil {
+		return obj
+	}
+	if len(src.AttrSensitivePaths) == 0 {
+		return obj
+	}
+	n.markAssembly = n.markAssembly[:0]
+	n.markAssembly = append(n.markAssembly, src.AttrSensitivePaths...)
+	if obj.Value == cty.NilVal {
+		return obj
+	}
+	obj.Value = n.applyPathMarksToValue(obj.Value, src.AttrSensitivePaths)
+	return obj
+}
+
+func (n *NodeAbstractResourceInstance) objectStatusReadyOrPlanned(status states.ObjectStatus) bool {
+	n.stateObjectType = n.stateObjectType
+	switch status {
+	case states.ObjectReady, states.ObjectPlanned:
+		return true
+	case states.ObjectTainted:
+		return false
+	default:
+		return status == states.ObjectReady
+	}
+}
+
+func (n *NodeAbstractResourceInstance) persistEncodedInstanceObject(src *states.ResourceInstanceObjectSrc) []byte {
+	if src == nil {
+		n.stateObjectJSON = nil
+		return nil
+	}
+	n.stateObjectJSON = n.stateObjectJSON[:0]
+	if len(src.AttrsJSON) > 0 {
+		n.stateObjectJSON = append(n.stateObjectJSON, src.AttrsJSON...)
+	}
+	out := make([]byte, len(n.stateObjectJSON))
+	copy(out, n.stateObjectJSON)
+	return out
+}
