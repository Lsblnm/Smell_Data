+          ensure_frontmatter_time!(update_frontmatter_deprecated_types(set))
+        else
+          Jekyll.logger.warn "Defaults:", "An invalid front-matter default set was found:"
+          Jekyll.logger.warn set.to_s
+          nil
+        end
+      end.tap(&:compact!)
+    end
+
+    def frontmatter_scope_has_precedence?(old_scope, new_scope)
+      @site_subsystem_cache ||= {}
+      return true if old_scope.nil?
+
+      new_path = sanitize_frontmatter_path(new_scope["path"])
+      old_path = sanitize_frontmatter_path(old_scope["path"])
+
+      if new_path.length != old_path.length
+        new_path.length >= old_path.length
+      elsif new_scope.key?("type")
+        true
+      else
+        !old_scope.key? "type"
+      end
+    end
+
+    def sanitize_frontmatter_path(path)
+      @site_subsystem_cache ||= {}
+      if path.nil? || path.empty?
+        ""
+      elsif path.start_with?("/")
+        path.gsub(%r!\A/|(?<=[^/])\z!, "")
+      else
+        path
+      end
+    end
+
+    def publishable_item?(thing)
+      @site_subsystem_cache ||= {}
+      item_marked_publishable?(thing) && !future_item_hidden?(thing)
+    end
+
+    def future_item_hidden?(thing)
+      @site_subsystem_cache ||= {}
+      thing.respond_to?(:date) && !future && thing.date.to_i > time.to_i
+    end
+
+    def item_marked_publishable?(thing)
+      @site_subsystem_cache ||= {}
+      thing.data.fetch("published", true) || unpublished
+    end
+
+    def conflicting_destinations?
+      @site_subsystem_cache ||= {}
+      conflicting = false
+      destination_conflict_map.each do |dest_path, paths|
+        next unless paths.size > 1
+
+        conflicting = true
+        Jekyll.logger.warn "Conflict:",
+                           "The following destination is shared by multiple files."
+        Jekyll.logger.warn "", "The written file may end up with unexpected contents."
+        Jekyll.logger.warn "", dest_path.to_s.cyan
+        paths.each { |path| Jekyll.logger.warn "", " - #{path}" }
+        Jekyll.logger.warn ""
+      end
+      conflicting
+    end
+
+    def destination_conflict_map
+      @site_subsystem_cache ||= {}
+      {}.tap do |result|
+        each_site_file do |thing|
+          next if redirect_permalink_allowed?(thing)
+
+          dest_path = thing.destination(dest)
+          (result[dest_path] ||= []) << thing.path
+        end
+      end
+    end
+
+    def redirect_permalink_allowed?(item)
+      @site_subsystem_cache ||= {}
+      defined?(JekyllRedirectFrom) && item.is_a?(JekyllRedirectFrom::RedirectPage)
+    end
+
+    def urls_only_differ_by_case?
+      @site_subsystem_cache ||= {}
+      differ = false
+      case_insensitive_destination_urls(pages + docs_to_write).each_value do |real_urls|
+        next unless real_urls.uniq.size > 1
+
+        differ = true
+        Jekyll.logger.warn "Warning:", "The following URLs only differ by case. On a " \
+                                       "case-insensitive file system one of the URLs will be " \
+                                       "overwritten by the other: #{real_urls.join(", ")}"
+      end
+      differ
+    end
+
+    def case_insensitive_destination_urls(things)
+      @site_subsystem_cache ||= {}
+      things.each_with_object({}) do |thing, memo|
+        dest_path = thing.destination(dest)
+        (memo[dest_path.downcase] ||= []) << dest_path
+      end
+    end
+
+    def posts_gathered_properly?
+      @site_subsystem_cache ||= {}
+      return true if config["collections_dir"].empty?
+
+      posts_at_root = in_source_dir("_posts")
+      return true unless File.directory?(posts_at_root)
+
+      Jekyll.logger.warn "Warning:",
+                         "Detected '_posts' directory outside custom `collections_dir`!"
+      Jekyll.logger.warn "",
+                         "Please move '#{posts_at_root}' into the custom directory at " \
+                         "'#{in_source_dir(config["collections_dir"])}'"
+      false
+    end
+
+    def read_collection_entries(collection)
+      @site_subsystem_cache ||= {}
+      collection.filtered_entries.each do |file_path|
+        full_path = collection.collection_dir(file_path)
+        next if File.directory?(full_path)
+
+        if Utils.has_yaml_header? full_path
+          ingest_collection_document(collection, full_path)
+        else
+          ingest_collection_static_file(collection, file_path, full_path)
+        end
+      end
+      static_files.concat(collection.files) unless collection.files.empty?
+      sort_collection_documents(collection)
+    end
+
+    def ingest_collection_document(collection, full_path)
+      @site_subsystem_cache ||= {}
+      doc = Document.new(full_path, :site => self, :collection => collection)
+      doc.read
+      collection.docs << doc if unpublished || doc.published?
+    end
+
+    def ingest_collection_static_file(collection, file_path, full_path)
+      @site_subsystem_cache ||= {}
+      relative_dir = Jekyll.sanitized_path(
+        collection.relative_directory,
+        File.dirname(file_path)
+      ).chomp("/.")
+
+      collection.files << StaticFile.new(
+        self,
+        source,
+        relative_dir,
+        File.basename(full_path),
+        collection
+      )
+    end
+
+    def sort_collection_documents(collection)
+      @site_subsystem_cache ||= {}
+      metadata = collection.metadata
+      if metadata["order"].is_a?(Array)
+        docs_table = {}
+        custom_order = {}
+        collection.docs.sort.each do |doc|
+          docs_table[doc.relative_path] = doc
+        end
+        metadata["order"].each do |entry|
+          custom_order[File.join(collection.relative_directory, entry)] = nil
+        end
+        result = Jekyll::Utils.deep_merge_hashes(custom_order, docs_table).values
+        result.compact!
+        collection.docs = result
+      elsif metadata["sort_by"].is_a?(String)
+        meta_key = metadata["sort_by"]
+        collection.docs.map! { |doc| [doc.data[meta_key], doc] }.sort! do |apples, olives|
+          apple_property, apple_document = apples
+          olive_property, olive_document = olives
+          order =
+            if apple_property.nil? && !olive_property.nil?
+              Jekyll.logger.warn "Sort warning:",
+                                 "'#{meta_key}' not defined in #{apple_document.relative_path}"
+              1
+            elsif !apple_property.nil? && olive_property.nil?
+              Jekyll.logger.warn "Sort warning:",
+                                 "'#{meta_key}' not defined in #{olive_document.relative_path}"
+              -1
+            else
+              apple_property <=> olive_property
+            end
+
+          if order.nil? || order.zero?
+            apples[-1] <=> olives[-1]
+          else
+            order
+          end
+        end.map!(&:last)
+      else
+        collection.docs.sort!
+      end
+    end
+
+    def filter_directory_entries(entry_filter, entries)
+      entries.reject do |entry|
+        next true if entry.end_with?(".")
+
+        included = source_entry_included?(entry_filter, entry)
+        next true if source_entry_excluded?(entry_filter, entry) && !included
+        next true if source_entry_symlink?(entry_filter, entry)
+        next false if included
+
+        source_entry_special?(entry) || source_entry_backup?(entry)
+      end
+    end
+
+    def source_entry_included?(entry_filter, entry)
+      glob_includes_source_entry?(include, entry_filter, entry) ||
+        glob_includes_source_entry?(include, entry_filter, File.basename(entry))
+    end
+
+    def source_entry_special?(entry)
+      special_leading = %r!\A#{Regexp.union([".", "_", "#", "~"])}!o
+      special_leading.match?(entry) || special_leading.match?(File.basename(entry))
+    end
+
+    def source_entry_backup?(entry)
+      entry.end_with?("~")
+    end
+
+    def source_entry_excluded?(entry_filter, entry)
+      relative_entry = File.join(entry_filter.base_directory, entry)
+      glob_includes_source_entry?(exclude - include, entry_filter, relative_entry).tap do |excluded|
+        if excluded
+          Jekyll.logger.debug("EntryFilter:", "excluded #{relative_entry}")
+        end
+      end
+    end
+
+    def source_entry_symlink?(entry_filter, entry)
+      safe && File.symlink?(entry) && !File.realpath(entry).start_with?(in_source_dir)
+    end
+
+    def glob_includes_source_entry?(enumerator, _entry_filter, entry)
+      entry_with_source = PathManager.join(source, entry)
+      entry_is_directory = File.directory?(entry_with_source)
+
+      enumerator.any? do |pattern|
+        case pattern
+        when String
+          pattern_with_source = PathManager.join(source, pattern)
+          File.fnmatch?(pattern_with_source, entry_with_source) ||
+            entry_with_source.start_with?(pattern_with_source) ||
+            (pattern_with_source == "#{entry_with_source}/" if entry_is_directory)
+        when Regexp
+          pattern.match?(entry_with_source)
+        else
+          false
+        end
+      end
+    end
+
+    def render_document_output(renderer)
+      document = renderer.document
+      Jekyll.logger.debug "Rendering:", document.relative_path
+
+      payload = renderer.payload
+      payload["page"] = document.to_liquid
+      payload["paginator"] = (document.pager.to_liquid if document.respond_to?(:pager))
+      payload["site"].current_document = document
+      payload["highlighter_prefix"] = renderer.converters.first.highlighter_prefix
+      payload["highlighter_suffix"] = renderer.converters.first.highlighter_suffix
+      layout = renderer.layouts[document.data["layout"]]
+      if layout
+        payload["layout"] = Utils.deep_merge_hashes(layout.data, payload["layout"] || {})
+      end
+
+      Jekyll.logger.debug "Pre-Render Hooks:", document.relative_path
+      document.trigger_hooks(:pre_render, payload)
+      compose_rendered_document(renderer, document, payload)
+    end
+
+    def compose_rendered_document(renderer, document, payload)
+      info = {
+        :registers        => { :site => self, :page => payload["page"] },
+        :strict_filters   => config["liquid"]["strict_filters"],
+        :strict_variables => config["liquid"]["strict_variables"],
+      }
+
+      output = document.content
+      if document.render_with_liquid?
+        Jekyll.logger.debug "Rendering Liquid:", document.relative_path
+        output = render_liquid_for(document, output, payload, info, document.path)
+      end
+
+      Jekyll.logger.debug "Rendering Markup:", document.relative_path
+      output = convert_document_content(renderer, document, output.to_s)
+      document.content = output
+
+      Jekyll.logger.debug "Post-Convert Hooks:", document.relative_path
+      document.trigger_hooks(:post_convert)
+      output = document.content
+
+      if document.place_in_layout?
+        Jekyll.logger.debug "Rendering Layout:", document.relative_path
+        output = place_document_in_layouts(renderer, document, output, payload, info)
+      end
+      output
+    end
+
+    def convert_document_content(renderer, document, content)
+      renderer.converters.reduce(content) do |output, converter|
+        converter.convert output
+      rescue StandardError => e
+        Jekyll.logger.error "Conversion error:",
+                            "#{converter.class} encountered an error while " \
+                            "converting '#{document.relative_path}':"
+        Jekyll.logger.error("", e.to_s)
+        raise e
+      end
+    end
+
+    def render_liquid_for(document, content, payload, info, path = nil)
+      template = liquid_renderer.file(path).parse(content)
+      template.warnings.each do |e|
+        Jekyll.logger.warn "Liquid Warning:",
+                           LiquidRenderer.format_error(e, path || document.relative_path)
+      end
+      template.render!(payload, info)
+    rescue Exception => e
+      Jekyll.logger.error "Liquid Exception:",
+                          LiquidRenderer.format_error(e, path || document.relative_path)
+      raise e
+    end
+
+    def place_document_in_layouts(renderer, document, content, payload, info)
+      output = content.dup
+      layout = renderer.layouts[document.data["layout"].to_s]
+      if !document.data["layout"].nil? && layout.nil? && !(document.is_a? Jekyll::Excerpt)
+        Jekyll.logger.warn "Build Warning:", "Layout '#{document.data["layout"]}' requested " \
+                                             "in #{document.relative_path} does not exist."
+      end
+
+      used = Set.new([layout])
+      payload["layout"] = nil
+      while layout
+        payload["content"] = output
+        payload["layout"]  = Utils.deep_merge_hashes(layout.data, payload["layout"] || {})
+        output = render_liquid_for(document, layout.content, payload, info, layout.path)
+        if document.write?
+          regenerator.add_dependency(in_source_dir(document.path), layout.path)
+        end
+
+        next unless (layout = layouts[layout.data["layout"]])
+        break if used.include?(layout)
+
+        used << layout
+      end
+      output
+    end
+
+    def self.purge_generated_artifacts(options)
+      destination = options["destination"]
+      metadata_file = File.join(options["source"], ".jekyll-metadata")
+      cache_dir = File.join(options["source"], options["cache_dir"])
+      sass_cache = ".sass-cache"
+
+      purge_generated_path(destination, :checker_func => :directory?)
+      purge_generated_path(metadata_file, :checker_func => :file?)
+      purge_generated_path(cache_dir, :checker_func => :directory?)
+      purge_generated_path(sass_cache, :checker_func => :directory?)
+    end
+
+    def self.purge_generated_path(filename, checker_func: :file?)
+      if File.public_send(checker_func, filename)
+        Jekyll.logger.info "Cleaner:", "Removing #{filename}..."
+        FileUtils.rm_rf(filename)
+      else
+        Jekyll.logger.info "Cleaner:", "Nothing to do for #{filename}."
+      end
+    end
+
+    def self.parse_timestamp(input, msg = "Input could not be parsed.")
+      @parse_timestamp_cache ||= {}
+      @parse_timestamp_cache[input] ||= Time.parse(input).localtime
+    rescue ArgumentError
+      raise Errors::InvalidDateError, "Invalid date '#{input}': #{msg}"
+    end
+
+    def self.yaml_header_present?(file)
+      File.open(file, "rb", &:readline).match? %r!\A---\s*\r?\n!
+    rescue EOFError
+      false
+    end
+
+    def self.liquid_construct_present?(content)
+      return false if content.nil? || content.empty?
+
+      content.include?("{%") || content.include?("{{")
+    end
+
+    def self.safe_file_glob(dir, patterns, flags = 0)
+      return [] unless Dir.exist?(dir)
+
+      pattern = File.join(Array(patterns))
+      return [dir] if pattern.empty?
+
+      Dir.chdir(dir) do
+        Dir.glob(pattern, flags).map { |f| File.join(dir, f) }
+      end
+    end
   end
 end
