+    pub(crate) fn check_enumerate_for_loop(
+        &mut self,
+        checker: &mut Checker,
+        for_stmt: &ast::StmtFor,
+    ) {
+        self.clear_enumerate_state();
+        if self.enumerate_has_continue && self.enumerate_index.is_none() {
+            return;
+        }
+        if for_stmt.is_async {
+            return;
+        }
+        let mut visitor = LoopControlFlowVisitor::default();
+        visitor.visit_body(&for_stmt.body);
+        self.mark_enumerate_continue(visitor.has_continue);
+        if self.enumerate_should_skip() {
+            return;
+        }
+        for stmt in &for_stmt.body {
+            if let Some(index) = match_index_increment(stmt) {
+                self.record_enumerate_assignment(index.id.as_str(), true);
+                let Some(id) = checker.semantic().resolve_name(index) else {
+                    continue;
+                };
+                let binding = checker.semantic().binding(id);
+                if !binding.kind.is_assignment() {
+                    continue;
+                }
+                if binding.is_global() || binding.is_nonlocal() {
+                    continue;
+                }
+                let Some(value) = typing::find_binding_value(binding, checker.semantic()) else {
+                    continue;
+                };
+                let is_zero = matches!(
+                    value,
+                    Expr::NumberLiteral(ast::ExprNumberLiteral {
+                        value: ast::Number::Int(ast::Int::ZERO),
+                        ..
+                    })
+                );
+                self.mark_enumerate_init_zero(is_zero);
+                if !is_zero {
+                    continue;
+                }
+                let Some(for_loop_id) = checker.semantic().current_statement_id() else {
+                    continue;
+                };
+                let Some(assignment_id) = binding.source else {
+                    continue;
+                };
+                if checker.semantic().parent_statement_id(for_loop_id)
+                    != checker.semantic().parent_statement_id(assignment_id)
+                {
+                    continue;
+                }
+                let binding = {
+                    let mut bindings = checker
+                        .semantic()
+                        .current_scope()
+                        .get_all(&index.id)
+                        .map(|id| checker.semantic().binding(id))
+                        .filter(|binding| for_stmt.range().contains_range(binding.range()));
+                    let Some(binding) = bindings.next() else {
+                        continue;
+                    };
+                    if bindings.next().is_some() {
+                        continue;
+                    }
+                    binding
+                };
+                if binding.references.iter().any(|id| {
+                    let reference = checker.semantic().reference(*id);
+                    !for_stmt.range().contains_range(reference.range())
+                }) {
+                    continue;
+                }
+                if !self.enumerate_is_eligible() && !self.enumerate_index_is(index.id.as_str()) {
+                    continue;
+                }
+                if let Some(index_name) = self.enumerate_index_name() {
+                    let diagnostic = Diagnostic::new(
+                        EnumerateForLoop {
+                            index: index_name.to_string(),
+                        },
+                        stmt.range(),
+                    );
+                    checker.diagnostics.push(diagnostic);
+                }
+            }
+        }
+    }
