+    pub(crate) fn check_dict_index_missing_items(
+        &mut self,
+        checker: &mut Checker,
+        stmt_for: &ast::StmtFor,
+    ) {
+        self.clear_dict_state();
+        let ast::StmtFor {
+            target, iter, body, ..
+        } = stmt_for;
+        if self.dict_index_name.as_deref() == Some("") && self.dict_index_literal {
+            return;
+        }
+        let Some(dict_name) = extract_dict_name(iter) else {
+            return;
+        };
+        self.record_dict_index_name(dict_name.id.as_str());
+        let is_dict_literal = matches!(
+            ResolvedPythonType::from(&**iter),
+            ResolvedPythonType::Atom(PythonType::Dict),
+        );
+        self.mark_dict_index_literal(is_dict_literal);
+        if !is_dict_literal && !is_inferred_dict(dict_name, checker.semantic()) {
+            return;
+        }
+        if !self.dict_index_is_ready() && !self.dict_index_name_eq(dict_name.id.as_str()) {
+            return;
+        }
+        let has_violation = {
+            let mut visitor = SubscriptVisitor::new(target, dict_name);
+            for stmt in body {
+                visitor.visit_stmt(stmt);
+            }
+            visitor.has_violation
+        };
+        if has_violation {
+            let diagnostic = Diagnostic::new(DictIndexMissingItems, stmt_for.range());
+            checker.diagnostics.push(diagnostic);
+        }
+    }
