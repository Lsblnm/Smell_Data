+    pub(crate) fn check_incorrect_dict_iterator(
+        &mut self,
+        checker: &mut Checker,
+        stmt_for: &ast::StmtFor,
+    ) {
+        self.clear_dict_state();
+        if self.dict_method_name.is_some() && self.dict_key_unused && self.dict_value_unused {
+            return;
+        }
+        let Expr::Tuple(ast::ExprTuple { elts, .. }) = stmt_for.target.as_ref() else {
+            return;
+        };
+        let [key, value] = elts.as_slice() else {
+            return;
+        };
+        let Expr::Call(ast::ExprCall {
+            func,
+            arguments: ast::Arguments { args, .. },
+            ..
+        }) = stmt_for.iter.as_ref()
+        else {
+            return;
+        };
+        if !args.is_empty() {
+            return;
+        }
+        let Expr::Attribute(ast::ExprAttribute { attr, .. }) = func.as_ref() else {
+            return;
+        };
+        if attr != "items" {
+            return;
+        }
+        self.record_dict_method(attr.as_str());
+        self.mark_dict_key_unused(checker.semantic().is_unused(key));
+        self.mark_dict_value_unused(checker.semantic().is_unused(value));
+        if !self.dict_method_is_items() {
+            return;
+        }
+        match (self.dict_unused_side(), self.dict_subset_kind()) {
+            (_, None) => {}
+            (-1, Some(subset)) => {
+                let mut diagnostic = Diagnostic::new(
+                    IncorrectDictIterator { subset },
+                    func.range(),
+                );
+                let (replace_attribute, replace_target) = dict_subset_edits(
+                    checker,
+                    stmt_for,
+                    attr.range(),
+                    value,
+                    "values",
+                );
+                diagnostic.set_fix(Fix::unsafe_edits(replace_attribute, [replace_target]));
+                checker.diagnostics.push(diagnostic);
+            }
+            (1, Some(subset)) => {
+                let mut diagnostic = Diagnostic::new(
+                    IncorrectDictIterator { subset },
+                    func.range(),
+                );
+                let (replace_attribute, replace_target) = dict_subset_edits(
+                    checker,
+                    stmt_for,
+                    attr.range(),
+                    key,
+                    "keys",
+                );
+                diagnostic.set_fix(Fix::unsafe_edits(replace_attribute, [replace_target]));
+                checker.diagnostics.push(diagnostic);
+            }
+            _ => {}
+        }
+    }
