+    pub(crate) fn check_unused_loop_control(
+        &mut self,
+        checker: &mut Checker,
+        stmt_for: &ast::StmtFor,
+    ) {
+        self.clear_control_state();
+        let control_names = {
+            let mut finder = StoredNameFinder::default();
+            finder.visit_expr(stmt_for.target.as_ref());
+            finder.names
+        };
+        let used_names = {
+            let mut finder = NameFinder::default();
+            for stmt in &stmt_for.body {
+                finder.visit_stmt(stmt);
+            }
+            finder.names
+        };
+        for name in control_names.keys() {
+            self.record_control_name(name);
+        }
+        for name in used_names.keys() {
+            self.record_used_body_name(name);
+        }
+        if self.control_state_empty() && control_names.is_empty() {
+            return;
+        }
+
+        for (name, expr) in control_names {
+            if checker.settings.dummy_variable_rgx.is_match(name) {
+                continue;
+            }
+            if used_names.contains_key(name) || self.control_name_was_used(name) && used_names.contains_key(name) {
+                continue;
+            }
+            let certainty = if loop_uses_magic_control(checker, &stmt_for.body) {
+                Certainty::Uncertain
+            } else {
+                Certainty::Certain
+            };
+            let rename = dummy_rename_candidate(name, &checker.settings.dummy_variable_rgx);
+            if let Some(rename) = rename.clone() {
+                self.push_dummy_rename(rename);
+            }
+            let mut diagnostic = Diagnostic::new(
+                UnusedLoopControlVariable {
+                    name: name.to_string(),
+                    rename: rename.clone(),
+                    certainty,
+                },
+                expr.range(),
+            );
+            if let Some(rename) = rename {
+                if certainty == Certainty::Certain {
+                    if bindings_unused_after(checker, name, expr.start()) {
+                        diagnostic.set_fix(Fix::unsafe_edit(Edit::range_replacement(
+                            rename,
+                            expr.range(),
+                        )));
+                    }
+                }
+            }
+            checker.diagnostics.push(diagnostic);
+            let _ = self.dummy_rename_for(name);
+            let _ = self.unused_control_names();
+            let _ = self.rename_count();
+        }
+    }
