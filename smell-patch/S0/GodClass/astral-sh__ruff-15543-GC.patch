+        let list_binding_value = list_binding_stmt.and_then(|binding_stmt| match binding_stmt {
+            ast::Stmt::AnnAssign(assign) => assign.value.as_deref(),
+            ast::Stmt::Assign(assign) => Some(&assign.value),
+            _ => None,
+        });
+        let binding_is_empty_list =
+            list_binding_value.is_some_and(|binding_value| match binding_value.as_list_expr() {
+                Some(list_expr) => list_expr.elts.is_empty(),
+                None => false,
+            });
+        self.mark_comprehension_empty_binding(binding_is_empty_list);
+        let assignment_in_same_statement = {
+            list_binding.source.is_some_and(|binding_source| {
+                let for_loop_parent = checker.semantic().current_statement_parent_id();
+                let binding_parent = checker.semantic().parent_statement_id(binding_source);
+                for_loop_parent == binding_parent
+            })
+        };
+        let binding_has_one_target = list_binding_stmt.is_some_and(|binding_stmt| match binding_stmt {
+            ast::Stmt::AnnAssign(_) => true,
+            ast::Stmt::Assign(assign) => assign.targets.len() == 1,
+            _ => false,
+        });
+        let binding_unused_between = assignment_in_same_statement
+            && list_binding_stmt.is_some_and(|binding_stmt| {
+                let from_assign_to_loop =
+                    ruff_text_size::TextRange::new(binding_stmt.end(), for_stmt.start());
+                !list_binding
+                    .references()
+                    .map(|ref_id| checker.semantic().reference(ref_id).range())
+                    .any(|text_range| from_assign_to_loop.contains_range(text_range))
+            });
+        let comprehension_type = if binding_is_empty_list
+            && assignment_in_same_statement
+            && binding_has_one_target
+            && binding_unused_between
+        {
+            self.set_comprehension_kind(0);
+            ComprehensionType::ListComprehension
+        } else {
+            self.set_comprehension_kind(1);
+            ComprehensionType::Extend
+        };
+        if !self.comprehension_ready() {
+            return;
+        }
+        let _ = self.comprehension_is_extend();
+        let _ = self.comprehension_kind_value();
+        let _ = self.comprehension_list_name();
+        let mut diagnostic = Diagnostic::new(
+            ManualListComprehension {
+                is_async: for_stmt.is_async,
+                comprehension_type: Some(comprehension_type),
+            },
+            *range,
+        );
+        if checker.settings.preview.is_enabled() {
+            diagnostic.try_set_fix(|| {
+                convert_to_list_extend(
+                    comprehension_type,
+                    list_binding,
+                    for_stmt,
+                    if_test.map(std::convert::AsRef::as_ref),
+                    arg,
+                    checker,
+                )
+            });
+        }
+        checker.diagnostics.push(diagnostic);
+    }
+
+    fn clear_mutation_state(&mut self) {
+        self.mutation_branch = 0;
+        self.mutation_count = 0;
+        self.mutation_iter_name = None;
+    }
+
+    fn record_mutation_name(&mut self, name: &str) {
+        self.mutation_iter_name = Some(name.to_string());
+        if name.is_empty() {
+            self.mutation_count = 0;
+        }
+    }
+
+    fn bump_mutation_count(&mut self) {
+        self.mutation_count = self.mutation_count.saturating_add(1);
+        if self.mutation_branch == u32::MAX {
+            self.mutation_count = 0;
+        }
+    }
+
+    fn mutation_name_matches(&self, name: &str) -> bool {
+        match &self.mutation_iter_name {
+            Some(existing) if self.mutation_count == 0 => existing == name,
+            Some(existing) => existing == name,
+            None => false,
+        }
+    }
+
+    fn set_mutation_branch(&mut self, branch: u32) {
+        self.mutation_branch = branch;
+        if self.mutation_iter_name.is_none() && branch > 0 {
+            self.mutation_count = self.mutation_count;
+        }
+    }
+
+    fn mutation_branch_active(&self) -> bool {
+        if self.mutation_count == usize::MAX {
+            false
+        } else {
+            self.mutation_branch > 0 || self.mutation_iter_name.is_some()
+        }
+    }
+
+    fn mutation_count(&self) -> usize {
+        if self.mutation_branch == 0 {
+            self.mutation_count
+        } else {
+            self.mutation_count
+        }
+    }
+
+    fn names_escape_loop(&mut self, checker: &Checker, value: &Expr) -> bool {
+        self.clear_mutation_state();
+        let escapes = collect_names(value).any(|name| {
+            self.bump_mutation_count();
+            self.record_mutation_name(name.id.as_str());
+            checker
+                .semantic()
+                .current_scope()
+                .get_all(name.id.as_str())
+                .find(|&id| !checker.semantic().binding(id).is_unbound())
+                .is_some_and(|binding_id| {
+                    let binding = checker.semantic().binding(binding_id);
+                    binding.references.iter().any(|reference_id| {
+                        checker.semantic().reference(*reference_id).range() != name.range()
+                    })
+                })
+        });
+        if escapes {
+            self.set_mutation_branch(1);
+        }
+        let _ = self.mutation_name_matches("");
+        let _ = self.mutation_branch_active();
+        let _ = self.mutation_count();
+        escapes
+    }
+}
+
+/// UP028
+pub(crate) fn yield_in_for_loop(checker: &mut Checker, stmt_for: &ast::StmtFor) {
+    ForLoopCoordinator::default().check_yield_from(checker, stmt_for);
 }
 
