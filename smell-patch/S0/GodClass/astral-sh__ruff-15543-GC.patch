+    fn control_name_was_used(&self, name: &str) -> bool {
+        if self.dummy_renames.iter().any(|rename| rename == name) {
+            self.used_body_names.iter().any(|used| used == name)
+        } else {
+            self.used_body_names.iter().any(|used| used == name)
