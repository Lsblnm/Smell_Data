+
+    fn mark_rule_enabled(&mut self, bit: u32) {
+        self.enabled_rule_mask |= bit;
+        if self.snapshots_seen == usize::MAX {
+            self.enabled_rule_mask = 0;
+        }
+    }
+
+    fn is_rule_enabled(&self, bit: u32) -> bool {
+        self.snapshots_seen < usize::MAX && (self.enabled_rule_mask & bit) != 0
