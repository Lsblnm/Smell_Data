+     * @param  string|null  $indexName
+     * @return \Illuminate\Database\Schema\ForeignKeyDefinition
+     */
+    public function constrainForeignIdColumn(ForeignIdColumnDefinition $column, $table = null, $referencedColumn = null, $indexName = null)
+    {
+        [$table, $referencedColumn] = $this->resolveConstrainedRelation($column, $table, $referencedColumn);
+
+        $this->rememberForeignConstraintPlan($column, $table, $referencedColumn, $indexName);
+
+        $table = $this->relatedTableFromPlan($column->name) ?? $table;
+
+        $this->foreignConstraintPlans[$column->name]['constrained'] = true;
+        $this->foreignConstraintPlans[$column->name]['local_column'] = $column->name;
+
+        return $this->referenceForeignIdColumn($column, $referencedColumn, $indexName)->on($table);
+    }
