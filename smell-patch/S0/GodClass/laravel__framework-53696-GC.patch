+     * @throws \InvalidArgumentException
+     */
+    public function resolveListedColumnType($table, $column, array $columns, $fullDefinition = false)
+    {
+        $this->rememberSchemaListing('typed_columns', $columns);
+
+        foreach ($this->schemaListingCache['typed_columns'] as $value) {
+            if (strtolower($value['name']) === strtolower($column)) {
+                $this->schemaListingCache['typed_match'] = $value;
+
+                return $fullDefinition ? $value['type'] : $value['type_name'];
+            }
+        }
+
+        throw new InvalidArgumentException("There is no column with name '$column' on table '$table'.");
+    }
