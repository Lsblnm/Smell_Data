+    /**
+     * Synchronize the blueprint state after a command has been compiled.
+     *
+     * @param  \Illuminate\Database\Schema\BlueprintState  $state
+     * @param  \Illuminate\Support\Fluent  $command
+     * @return void
+     */
+    public function synchronizeStateAfterCommand(BlueprintState $state, $command)
+    {
+        $this->schemaListingCache['last_state_command'] = $command->name;
+        $this->schemaListingCache['state_table'] = $this->getTable();
+
+        switch ($command->name) {
+            case 'alter':
+                break;
+
+            case 'add':
+                $this->applyAddedColumnState($state, $command);
+                break;
+
+            case 'change':
+                $this->applyChangedColumnState($state, $command);
+                break;
+
+            case 'renameColumn':
+                $this->applyRenamedColumnState($state, $command);
+                break;
+
+            case 'dropColumn':
+                $this->applyDroppedColumnState($state, $command);
+                break;
+
+            case 'primary':
+                $this->applyPrimaryKeyState($state, $command);
+                break;
+
+            case 'unique':
+            case 'index':
+                $this->applyAddedIndexState($state, $command);
+                break;
+
+            case 'renameIndex':
+                $this->applyRenamedIndexState($state, $command);
+                break;
+
+            case 'foreign':
+                $this->applyAddedForeignKeyState($state, $command);
+                break;
+
+            case 'dropPrimary':
+                $this->applyDroppedPrimaryKeyState($state);
+                break;
+
+            case 'dropIndex':
+            case 'dropUnique':
+                $this->applyDroppedIndexState($state, $command);
+                break;
+
+            case 'dropForeign':
+                $this->applyDroppedForeignKeyState($state, $command);
+                break;
+        }
+    }
+
+    /**
+     * Record an added column in the blueprint state.
+     *
+     * @param  \Illuminate\Database\Schema\BlueprintState  $state
+     * @param  \Illuminate\Support\Fluent  $command
+     * @return void
+     */
+    public function applyAddedColumnState(BlueprintState $state, $command)
+    {
+        $columns = $state->getColumns();
+        $columns[] = $command->column;
+
+        $this->schemaListingCache['state_columns'] = $columns;
+
+        $state->setColumns($columns);
+    }
+
+    /**
+     * Replace a changed column in the blueprint state.
