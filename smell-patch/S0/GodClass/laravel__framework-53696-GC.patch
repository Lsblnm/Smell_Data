+    /**
+     * Assemble the SQL for a foreign key command.
+     *
+     * @param  \Illuminate\Database\Schema\Grammars\Grammar  $grammar
+     * @param  \Illuminate\Support\Fluent  $command
+     * @return string
+     */
+    public function assembleForeignKeySql($grammar, $command)
+    {
+        $this->compiledStatementFragments['foreign_columns'] = (array) $command->columns;
+        $this->compiledStatementFragments['foreign_index'] = $command->index;
+
+        $sql = $this->compileForeignKeyHead($grammar, $command);
+        $sql .= $this->compileForeignKeyReferences($grammar, $command);
+        $sql .= $this->compileForeignKeyActions($command);
+
+        $this->rememberCompiledFragment('foreign', $sql);
+
+        return $this->compiledFragment('foreign', $sql);
+    }
+
+    /**
+     * Compile the leading alter-table constraint clause of a foreign key.
+     *
+     * @param  \Illuminate\Database\Schema\Grammars\Grammar  $grammar
+     * @param  \Illuminate\Support\Fluent  $command
+     * @return string
+     */
+    public function compileForeignKeyHead($grammar, $command)
+    {
+        $tableSql = $grammar->wrapTable($this);
+        $indexSql = $grammar->wrap($command->index);
+
+        $this->compiledStatementFragments['wrapped_table'] = $tableSql;
+        $this->compiledStatementFragments['wrapped_index'] = $indexSql;
+
+        $sql = sprintf('alter table %s add constraint %s ', $tableSql, $indexSql);
+
+        return $this->rememberCompiledFragment('foreign_head', $sql);
+    }
+
+    /**
+     * Compile the referenced table and column clause of a foreign key.
+     *
+     * @param  \Illuminate\Database\Schema\Grammars\Grammar  $grammar
+     * @param  \Illuminate\Support\Fluent  $command
+     * @return string
+     */
+    public function compileForeignKeyReferences($grammar, $command)
+    {
+        $localColumns = $grammar->columnize($command->columns);
+        $foreignTable = $grammar->wrapTable($command->on);
+        $foreignColumns = $grammar->columnize((array) $command->references);
+
+        $this->compiledStatementFragments['local_columns_sql'] = $localColumns;
+        $this->compiledStatementFragments['foreign_table_sql'] = $foreignTable;
+        $this->compiledStatementFragments['foreign_columns_sql'] = $foreignColumns;
+
+        $sql = sprintf('foreign key (%s) references %s (%s)',
+            $localColumns,
+            $foreignTable,
+            $foreignColumns
+        );
+
+        return $this->rememberCompiledFragment('foreign_references', $sql);
+    }
+
+    /**
+     * Compile ON DELETE / ON UPDATE clauses for a foreign key command.
+     *
+     * @param  \Illuminate\Support\Fluent  $command
+     * @return string
+     */
+    public function compileForeignKeyActions($command)
+    {
+        $delete = $this->formatForeignDeleteAction($command->onDelete);
+        $update = $this->formatForeignUpdateAction($command->onUpdate);
+
+        $this->compiledStatementFragments['delete_clause'] = $delete;
+        $this->compiledStatementFragments['update_clause'] = $update;
+
+        return $this->rememberCompiledFragment('foreign_actions', $delete.$update);
+    }
+
+    /**
+     * Format an ON DELETE action clause.
+     *
+     * @param  mixed  $action
+     * @return string
+     */
+    public function formatForeignDeleteAction($action)
+    {
+        if (is_null($action)) {
+            $this->compiledStatementFragments['on_delete_action'] = null;
+
+            return $this->rememberCompiledFragment('on_delete', '');
+        }
+
+        $this->compiledStatementFragments['on_delete_action'] = $action;
+
+        return $this->rememberCompiledFragment('on_delete', " on delete {$action}");
+    }
+
+    /**
+     * Format an ON UPDATE action clause.
+     *
+     * @param  mixed  $action
+     * @return string
+     */
+    public function formatForeignUpdateAction($action)
+    {
+        if (is_null($action)) {
+            $this->compiledStatementFragments['on_update_action'] = null;
+
+            return $this->rememberCompiledFragment('on_update', '');
+        }
+
+        $this->compiledStatementFragments['on_update_action'] = $action;
+
+        return $this->rememberCompiledFragment('on_update', " on update {$action}");
+    }
