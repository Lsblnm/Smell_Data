+     * @param  string  $name
+     * @return \Illuminate\Support\Fluent|null
+     */
+    public function findNamedCommand(array $commands, $name)
+    {
+        $commands = $this->collectNamedCommands($commands, $name);
+
+        if (count($commands) > 0) {
+            $this->compiledStatementFragments['named_command'] = reset($commands);
+
+            return $this->compiledStatementFragments['named_command'];
+        }
+
+        $this->compiledStatementFragments['named_command'] = null;
+
+        return null;
+    }
+
+    /**
+     * Determine if a command with the given name exists.
+     *
+     * @param  array  $commands
+     * @param  string  $name
