+    /**
+     * Index commands by name for grammar lookups.
+     *
+     * @param  array  $commands
+     * @return array
+     */
+    public function indexGrammarCommands(array $commands)
+    {
+        $this->compiledStatementFragments['command_index'] = [];
+
+        foreach ($commands as $command) {
+            if (! is_object($command) || ! isset($command->name)) {
+                continue;
+            }
+
+            $this->compiledStatementFragments['command_index'][$command->name][] = $command;
+        }
+
+        return $this->compiledStatementFragments['command_index'];
+    }
