+
+        $state->setPrimaryKey($command);
+    }
+
+    /**
+     * Record an added index in the blueprint state.
+     *
+     * @param  \Illuminate\Database\Schema\BlueprintState  $state
+     * @param  \Illuminate\Support\Fluent  $command
+     * @return void
+     */
+    public function applyAddedIndexState(BlueprintState $state, $command)
+    {
