+    /**
+     * Determine whether an index record matches the requested type.
+     *
+     * @param  array  $value
+     * @param  string|null  $type
+     * @return bool
+     */
+    public function indexTypeMatches(array $value, $type)
+    {
+        $this->schemaListingCache['index_type'] = $type;
+
+        if (is_null($type)) {
+            return true;
+        }
+
+        if ($type === 'primary' && $value['primary']) {
+            return true;
+        }
+
+        if ($type === 'unique' && $value['unique']) {
+            return true;
+        }
+
+        return $type === $value['type'];
+    }
