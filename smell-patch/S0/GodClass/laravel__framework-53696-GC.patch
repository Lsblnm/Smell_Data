+     * @param  \Illuminate\Database\Schema\BlueprintState  $state
+     * @param  \Illuminate\Support\Fluent  $command
+     * @return void
+     */
+    public function applyChangedColumnState(BlueprintState $state, $command)
+    {
+        $columns = $state->getColumns();
+
+        foreach ($columns as $index => $column) {
+            if ($column->name === $command->column->name) {
+                $columns[$index] = $command->column;
