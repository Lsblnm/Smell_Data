+    {
+        $this->rememberSchemaListing('entries', $listing);
+        $this->schemaListingCache['needle'] = $name;
+
+        foreach ($this->schemaListingCache['entries'] as $value) {
+            if (! isset($value['name'])) {
+                continue;
+            }
+
+            if (strtolower($name) === strtolower($value['name'])) {
+                $this->schemaListingCache['match'] = $value;
+
+                return true;
+            }
+        }
+
+        $this->schemaListingCache['match'] = null;
+
+        return false;
