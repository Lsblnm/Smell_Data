+
+        foreach ($commands as $command) {
+            if ($command->name === $name) {
+                $this->compiledStatementFragments['has_command'] = true;
+
+                return true;
+            }
+        }
+
+        $this->compiledStatementFragments['has_command'] = false;
+
+        return false;
