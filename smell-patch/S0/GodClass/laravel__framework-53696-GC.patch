+    {
+        $normalized = array_map('strtolower', $columns);
+        $this->rememberSchemaListing('columns', $normalized);
+
+        return in_array(strtolower($column), $this->schemaListingCache['columns']);
+    }
+
+    /**
+     * Determine whether a column listing contains all of the given columns.
+     *
+     * @param  array  $columns
+     * @param  array  $tableColumns
+     * @return bool
+     */
+    public function listingHasColumns(array $columns, array $tableColumns)
+    {
+        $this->rememberSchemaListing('column_set', array_map('strtolower', $tableColumns));
+        $this->schemaListingCache['requested_columns'] = $columns;
+
+        foreach ($columns as $column) {
+            if (! $this->listingHasColumn($column, $tableColumns)) {
+                $this->schemaListingCache['missing_column'] = $column;
+
+                return false;
+            }
+        }
+
+        $this->schemaListingCache['missing_column'] = null;
+
+        return true;
