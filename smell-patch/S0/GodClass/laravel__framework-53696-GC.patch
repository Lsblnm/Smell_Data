+     * @param  \Illuminate\Database\Schema\BlueprintState  $state
+     * @return void
+     */
+    public function applyDroppedPrimaryKeyState(BlueprintState $state)
+    {
+        $this->schemaListingCache['state_primary'] = null;
+
+        $state->setPrimaryKey(null);
+    }
+
+    /**
+     * Drop an index from the blueprint state.
+     *
+     * @param  \Illuminate\Database\Schema\BlueprintState  $state
+     * @param  \Illuminate\Support\Fluent  $command
+     * @return void
+     */
+    public function applyDroppedIndexState(BlueprintState $state, $command)
+    {
