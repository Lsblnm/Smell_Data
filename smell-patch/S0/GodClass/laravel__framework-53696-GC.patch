+    public function rememberForeignConstraintPlan(ForeignIdColumnDefinition $column, $table, $referencedColumn, $indexName = null)
+    {
+        $this->foreignConstraintPlans[$column->name] = array_merge(
+            $this->foreignConstraintPlans[$column->name] ?? [],
