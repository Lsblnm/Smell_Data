+     */
+    public function referenceForeignIdColumn(ForeignIdColumnDefinition $column, $referencedColumn, $indexName = null)
+    {
+        $indexName = $this->qualifyConstrainedIndexName($column, $indexName);
+
+        $this->foreignConstraintPlans[$column->name]['references'] = $referencedColumn;
+        $this->foreignConstraintPlans[$column->name]['index'] = $indexName;
+
+        $this->foreignPlanForColumn($column->name);
+
+        return $this->foreign($column->name, $indexName)->references($referencedColumn);
