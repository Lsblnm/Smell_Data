+            $this->foreignConstraintPlans[$column->name]['qualified_index'] = $indexName;
+
+            return $indexName;
+        }
+
+        $this->foreignConstraintPlans[$column->name]['qualified_index'] = $indexName;
+
+        return $indexName;
