+    /**
+     * Resolve the related table and referenced column for a foreign ID.
+     *
+     * @param  \Illuminate\Database\Schema\ForeignIdColumnDefinition  $column
+     * @param  string|null  $table
+     * @param  string|null  $referencedColumn
+     * @return array
+     */
+    public function resolveConstrainedRelation(ForeignIdColumnDefinition $column, $table = null, $referencedColumn = null)
+    {
+        $table ??= $column->table;
+        $referencedColumn = $this->resolveForeignReferenceColumn($column, $referencedColumn);
+
+        if (is_null($table)) {
+            $table = $this->inferRelatedTableName($column->name, $referencedColumn);
+        }
+
+        $this->foreignConstraintPlans[$column->name]['table'] = $table;
+        $this->foreignConstraintPlans[$column->name]['references'] = $referencedColumn;
+
+        return [$table, $referencedColumn];
+    }
