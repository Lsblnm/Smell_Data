+
+        foreach ($indexes as $index) {
+            if ($index->index === $command->from) {
+                $index->index = $command->to;
+                break;
+            }
+        }
+
+        $this->schemaListingCache['state_indexes'] = $indexes;
+
+        $state->setIndexes($indexes);
+    }
+
+    /**
+     * Record an added foreign key in the blueprint state.
+     *
+     * @param  \Illuminate\Database\Schema\BlueprintState  $state
+     * @param  \Illuminate\Support\Fluent  $command
+     * @return void
+     */
+    public function applyAddedForeignKeyState(BlueprintState $state, $command)
+    {
+        $foreignKeys = $state->getForeignKeys();
+        $foreignKeys[] = $command;
+
+        $this->schemaListingCache['state_foreign_keys'] = $foreignKeys;
+
+        $state->setForeignKeys($foreignKeys);
+    }
+
+    /**
+     * Drop the primary key from the blueprint state.
