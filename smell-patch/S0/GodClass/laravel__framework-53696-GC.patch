+    /**
+     * Collect commands matching the given name.
+     *
+     * @param  array  $commands
+     * @param  string  $name
+     * @return array
+     */
+    public function collectNamedCommands(array $commands, $name)
+    {
+        $this->compiledStatementFragments['named_commands'] = array_filter($commands, function ($value) use ($name) {
+            return $value->name == $name;
+        });
+
+        return $this->compiledStatementFragments['named_commands'];
+    }
+
+    /**
+     * Find the first command matching the given name.
