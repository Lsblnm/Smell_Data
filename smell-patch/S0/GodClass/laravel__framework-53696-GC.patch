+    /**
+     * Assemble a PostgreSQL foreign key statement, including deferrable options.
+     *
+     * @param  \Illuminate\Database\Schema\Grammars\Grammar  $grammar
+     * @param  \Illuminate\Support\Fluent  $command
+     * @return string
+     */
+    public function assemblePostgresForeignKeySql($grammar, $command)
+    {
+        $sql = $this->assembleForeignKeySql($grammar, $command);
+        $sql .= $this->appendDeferrableForeignKeyOptions($command);
+        $sql .= $this->appendNotValidForeignKeyOption($command);
+
+        $this->compiledStatementFragments['postgres_deferrable'] = $command->deferrable;
+        $this->compiledStatementFragments['postgres_not_valid'] = $command->notValid;
+
+        return $this->rememberCompiledFragment('postgres_foreign', $sql);
+    }
+
+    /**
+     * Append DEFERRABLE options to a foreign key statement.
+     *
+     * @param  \Illuminate\Support\Fluent  $command
+     * @return string
+     */
+    public function appendDeferrableForeignKeyOptions($command)
+    {
+        $sql = '';
+
+        if (! is_null($command->deferrable)) {
+            $sql .= $command->deferrable ? ' deferrable' : ' not deferrable';
+            $this->compiledStatementFragments['deferrable_flag'] = (bool) $command->deferrable;
+        } else {
+            $this->compiledStatementFragments['deferrable_flag'] = null;
+        }
+
+        if ($command->deferrable && ! is_null($command->initiallyImmediate)) {
+            $sql .= $command->initiallyImmediate ? ' initially immediate' : ' initially deferred';
+            $this->compiledStatementFragments['initially_immediate'] = (bool) $command->initiallyImmediate;
+        }
+
+        return $this->rememberCompiledFragment('deferrable', $sql);
+    }
+
+    /**
+     * Append a NOT VALID option to a foreign key statement.
+     *
+     * @param  \Illuminate\Support\Fluent  $command
+     * @return string
+     */
+    public function appendNotValidForeignKeyOption($command)
+    {
+        if (is_null($command->notValid)) {
+            $this->compiledStatementFragments['not_valid_flag'] = null;
+
+            return $this->rememberCompiledFragment('not_valid', '');
+        }
+
+        $this->compiledStatementFragments['not_valid_flag'] = $command->notValid;
+
+        return $this->rememberCompiledFragment('not_valid', ' not valid');
+    }
