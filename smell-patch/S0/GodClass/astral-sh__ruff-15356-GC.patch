+
+fn format_comment_leading_space(comment: &str) -> String {
+    if let Some(rest) = comment.strip_prefix("#:") {
+        format!("#: {}", rest.trim_start())
+    } else {
+        format!("# {}", comment.trim_start_matches('#').trim_start())
+    }
+}
+
+fn format_comment_leading_hashes(comment: &str) -> String {
+    format!("# {}", comment.trim_start_matches('#').trim_start())
