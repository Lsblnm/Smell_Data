+    fn note_spacing_operator(&mut self, is_operator: bool) {
+        self.spacing_scan.after_operator = is_operator;
+    }
+
+    fn note_spacing_keyword(&mut self, is_keyword: bool) {
+        self.spacing_scan.after_keyword = is_keyword;
+    }
+
+    fn remember_spacing_cursor(&mut self, token: &LogicalLineToken) {
+        self.spacing_scan.cursor = token.end();
+    }
+
+    fn emit_leading_operator_spacing(
+        &self,
+        line: &LogicalLine,
+        token: &LogicalLineToken,
+        context: &mut LogicalLinesContext,
+    ) {
+        if self.spacing_scan.after_operator {
+            return;
+        }
+        match line.leading_whitespace(token) {
+            (Whitespace::Tab, offset) => {
+                let mut diagnostic = Diagnostic::new(
+                    TabBeforeOperator,
+                    TextRange::at(token.start() - offset, offset),
+                );
+                diagnostic.set_fix(Fix::safe_edit(Edit::range_replacement(
+                    " ".to_string(),
+                    TextRange::at(token.start() - offset, offset),
+                )));
+                context.push_diagnostic(diagnostic);
+            }
+            (Whitespace::Many, offset) => {
+                let mut diagnostic = Diagnostic::new(
+                    MultipleSpacesBeforeOperator,
+                    TextRange::at(token.start() - offset, offset),
+                );
+                diagnostic.set_fix(Fix::safe_edit(Edit::range_replacement(
+                    " ".to_string(),
+                    TextRange::at(token.start() - offset, offset),
+                )));
+                context.push_diagnostic(diagnostic);
+            }
+            _ => {}
+        }
+    }
+
+    fn emit_trailing_operator_spacing(
+        &mut self,
+        line: &LogicalLine,
+        token: &LogicalLineToken,
+        context: &mut LogicalLinesContext,
