+                                .set_fix(Fix::safe_edit(Edit::range_deletion(diagnostic.range())));
+                            context.push_diagnostic(diagnostic);
+                        }
+                    }
+                    BracketOrPunctuation::CloseBracket(symbol) if symbol != '}' || self.enclosure_outside_fstring() => {
+                        if !matches!(self.enclosure_scan.prev_kind, Some(TokenKind::Comma)) {
+                            if let (Whitespace::Single | Whitespace::Many | Whitespace::Tab, offset) =
+                                line.leading_whitespace(token)
+                            {
+                                let mut diagnostic = Diagnostic::new(
+                                    WhitespaceBeforeCloseBracket { symbol },
+                                    TextRange::at(token.start() - offset, offset),
+                                );
+                                diagnostic
+                                    .set_fix(Fix::safe_edit(Edit::range_deletion(diagnostic.range())));
+                                context.push_diagnostic(diagnostic);
+                            }
+                        }
+                    }
+                    BracketOrPunctuation::Punctuation(symbol) => {
+                        if !matches!(self.enclosure_scan.prev_kind, Some(TokenKind::Comma)) {
+                            let whitespace = line.leading_whitespace(token);
+                            if let (Whitespace::Single | Whitespace::Many | Whitespace::Tab, offset) =
+                                whitespace
+                            {
+                                // If we're in a slice, and the token is a colon, and it has
+                                // equivalent spacing on both sides, allow it.
+                                if symbol == ':'
+                                    && self.enclosure_in_slice()
+                                {
+                                    // If we're in the second half of a double colon, disallow
+                                    // any whitespace (e.g., `foo[1: :2]` or `foo[1 : : 2]`).
+                                    if matches!(self.enclosure_scan.prev_kind, Some(TokenKind::Colon)) {
+                                        let mut diagnostic = Diagnostic::new(
+                                            WhitespaceBeforePunctuation { symbol },
+                                            TextRange::at(token.start() - offset, offset),
+                                        );
+                                        diagnostic.set_fix(Fix::safe_edit(Edit::range_deletion(
+                                            diagnostic.range(),
+                                        )));
+                                        context.push_diagnostic(diagnostic);
+                                    } else if iter.peek().is_some_and(|token| {
+                                        matches!(token.kind(), TokenKind::Rsqb | TokenKind::Comma)
+                                    }) {
+                                        // Allow `foo[1 :]`, but not `foo[1  :]`.
+                                        // Or `foo[index :, 2]`, but not `foo[index  :, 2]`.
+                                        if let (Whitespace::Many | Whitespace::Tab, offset) = whitespace
+                                        {
+                                            let mut diagnostic = Diagnostic::new(
+                                                WhitespaceBeforePunctuation { symbol },
+                                                TextRange::at(token.start() - offset, offset),
+                                            );
+                                            diagnostic.set_fix(Fix::safe_edit(Edit::range_deletion(
+                                                diagnostic.range(),
+                                            )));
+                                            context.push_diagnostic(diagnostic);
+                                        }
+                                    } else if iter.peek().is_some_and(|token| {
+                                        matches!(
+                                            token.kind(),
+                                            TokenKind::NonLogicalNewline | TokenKind::Comment
+                                        )
+                                    }) {
+                                        // Allow [
+                                        //      long_expression_calculating_the_index() :
+                                        // ]
+                                        // But not [
+                                        //      long_expression_calculating_the_index()  :
+                                        // ]
+                                        // distinct from the above case, because ruff format produces a
+                                        // whitespace before the colon and so should the fix
+                                        if let (Whitespace::Many | Whitespace::Tab, offset) = whitespace
+                                        {
+                                            let mut diagnostic = Diagnostic::new(
+                                                WhitespaceBeforePunctuation { symbol },
+                                                TextRange::at(token.start() - offset, offset),
+                                            );
+                                            diagnostic.set_fix(Fix::safe_edits(
+                                                Edit::range_deletion(diagnostic.range()),
+                                                [Edit::insertion(" ".into(), token.start() - offset)],
+                                            ));
+                                            context.push_diagnostic(diagnostic);
+                                        }
+                                    } else {
+                                        // Allow, e.g., `foo[1:2]` or `foo[1 : 2]` or `foo[1 :: 2]`.
+                                        let token = iter
+                                            .peek()
+                                            .filter(|next| matches!(next.kind(), TokenKind::Colon))
+                                            .unwrap_or(&token);
+                                        if line.trailing_whitespace(token) != whitespace {
+                                            let mut diagnostic = Diagnostic::new(
+                                                WhitespaceBeforePunctuation { symbol },
+                                                TextRange::at(token.start() - offset, offset),
+                                            );
+                                            diagnostic.set_fix(Fix::safe_edit(Edit::range_deletion(
+                                                diagnostic.range(),
+                                            )));
+                                            context.push_diagnostic(diagnostic);
+                                        }
+                                    }
+                                } else {
+                                    if self.enclosure_in_fstring()
+                                        && symbol == ':'
+                                        && matches!(self.enclosure_scan.prev_kind, Some(TokenKind::Equal))
+                                    {
+                                        // Avoid removing any whitespace for f-string debug expressions.
+                                        continue;
+                                    }
+                                    let mut diagnostic = Diagnostic::new(
+                                        WhitespaceBeforePunctuation { symbol },
+                                        TextRange::at(token.start() - offset, offset),
+                                    );
+                                    diagnostic.set_fix(Fix::safe_edit(Edit::range_deletion(
+                                        diagnostic.range(),
+                                    )));
+                                    context.push_diagnostic(diagnostic);
+                                }
+                            }
+                        }
+                    }
+                    _ => {}
+                }
+            }
+
+            self.remember_enclosure_prev(kind);
+        }
+    }
+
+
+    pub(crate) fn check_space_around_operator(
+        &mut self,
+        line: &LogicalLine,
+        context: &mut LogicalLinesContext,
+    ) {
+        self.spacing_scan = SpacingScan::default();
+        for token in line.tokens() {
+            let is_operator = operator_token_kind(token.kind());
+            if is_operator {
+                self.emit_leading_operator_spacing(line, token, context);
+                self.emit_trailing_operator_spacing(line, token, context);
+            }
+            self.note_spacing_operator(is_operator);
+        }
+    }
+
+    pub(crate) fn check_space_after_comma(
+        &mut self,
+        line: &LogicalLine,
+        context: &mut LogicalLinesContext,
+    ) {
+        self.spacing_scan = SpacingScan::default();
+        for token in line.tokens() {
+            if matches!(token.kind(), TokenKind::Comma) {
+                self.emit_trailing_comma_spacing(line, token, context);
+            }
+            self.remember_spacing_cursor(token);
+        }
+    }
+
+    pub(crate) fn check_whitespace_around_keywords(
+        &mut self,
+        line: &LogicalLine,
+        context: &mut LogicalLinesContext,
+    ) {
+        self.spacing_scan = SpacingScan::default();
+        for token in line.tokens() {
+            let is_keyword = token.kind().is_keyword();
+            if is_keyword {
+                self.emit_leading_keyword_spacing(line, token, context);
+                self.emit_trailing_keyword_spacing(line, token, context);
+            }
+            self.note_spacing_keyword(is_keyword);
+        }
+    }
+
+    pub(crate) fn check_missing_whitespace_after_keyword(
+        &mut self,
+        line: &LogicalLine,
+        context: &mut LogicalLinesContext,
+    ) {
+        self.spacing_scan = SpacingScan::default();
+        for window in line.tokens().windows(2) {
+            let tok0 = &window[0];
+            let tok1 = &window[1];
+            self.remember_spacing_cursor(tok0);
+            if self.keyword_missing_following_space(tok0, tok1) {
+                let mut diagnostic = Diagnostic::new(MissingWhitespaceAfterKeyword, tok0.range());
+                diagnostic.set_fix(Fix::safe_edit(Edit::insertion(" ".to_string(), tok0.end())));
+                context.push_diagnostic(diagnostic);
+            }
+        }
+    }
+
+    pub(crate) fn check_whitespace_before_parameters(
+        &mut self,
+        line: &LogicalLine,
+        context: &mut LogicalLinesContext,
+    ) {
+        self.spacing_scan = SpacingScan::default();
+        let Some(previous) = line.tokens().first() else {
+            return;
+        };
+        self.spacing_scan.prev_kind = Some(previous.kind());
+        self.spacing_scan.cursor = previous.end();
+        for token in line.tokens() {
+            let kind = token.kind();
+            if self.parameter_open_has_leading_space(kind, token) {
+                let start = self.spacing_scan.cursor;
+                let end = token.end() - TextSize::from(1);
+                let mut diagnostic = Diagnostic::new(
+                    WhitespaceBeforeParameters { bracket: kind },
+                    TextRange::new(start, end),
+                );
+                diagnostic.set_fix(Fix::safe_edit(Edit::deletion(start, end)));
+                context.push_diagnostic(diagnostic);
+            }
+            self.spacing_scan.prev_prev_kind = self.spacing_scan.prev_kind;
+            self.spacing_scan.prev_kind = Some(kind);
+            self.spacing_scan.cursor = token.end();
+        }
+    }
+
+    pub(crate) fn check_whitespace_before_comment(
+        &mut self,
+        line: &LogicalLine,
+        locator: &Locator,
+        context: &mut LogicalLinesContext,
+    ) {
+        self.spacing_scan = SpacingScan::default();
+        for token in line.tokens() {
+            let kind = token.kind();
+            if let TokenKind::Comment = kind {
+                self.inspect_comment_token(line, locator, token, context);
+            } else if !matches!(kind, TokenKind::NonLogicalNewline) {
+                self.spacing_scan.cursor = token.end();
+            }
+        }
+    }
