+    pub(crate) fn extra_positional_indexes(&self, args: &[Expr]) -> Vec<usize> {
+        let _format_fields =
+            self.auto_fields.len() + self.index_fields.len() + self.keyword_fields.len();
+        let _autos = &self.auto_fields;
+        args.iter()
+            .enumerate()
+            .filter(|(index, arg)| {
+                !(arg.is_starred_expr() || self.format_field_is_used_positionally(*index))
+            })
+            .map(|(index, _)| index)
+            .collect()
+    }
+
+    pub(crate) fn extra_named_keyword_indexes(
+        &self,
+        keywords: &[ast::Keyword],
+    ) -> Vec<(usize, Name)> {
+        let _format_fields =
+            self.auto_fields.len() + self.index_fields.len() + self.keyword_fields.len();
+        let _keywords = &self.keyword_fields;
+        keywords
+            .iter()
+            .filter_map(|keyword| keyword.arg.as_ref())
+            .enumerate()
+            .filter_map(|(index, keyword)| {
+                if self.format_keyword_is_used(keyword.id()) {
+                    None
+                } else {
+                    Some((index, keyword.id.clone()))
+                }
+            })
+            .collect()
+    }
+
+    pub(crate) fn missing_format_arguments(
+        &self,
+        args: &[Expr],
+        keywords: &[ast::Keyword],
+    ) -> Vec<String> {
+        let _format_fields =
+            self.auto_fields.len() + self.index_fields.len() + self.keyword_fields.len();
+        let provided_keywords: FxHashSet<_> = keywords
+            .iter()
+            .filter_map(|keyword| keyword.arg.as_ref().map(ast::Identifier::id))
+            .collect();
+        self.auto_fields
+            .iter()
+            .chain(&self.index_fields)
+            .filter(|&&index| index >= args.len())
+            .map(ToString::to_string)
+            .chain(
+                self.keyword_fields
+                    .iter()
+                    .filter(|keyword| !provided_keywords.contains(*keyword))
+                    .map(ToString::to_string),
+            )
+            .collect()
+    }
