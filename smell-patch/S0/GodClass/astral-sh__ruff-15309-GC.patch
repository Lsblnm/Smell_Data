+pub(crate) fn check_string_dot_format(
+    checker: &mut Checker,
+    call: &ast::ExprCall,
+    literal: &str,
+    args: &[Expr],
+    keywords: &[Keyword],
+    location: TextRange,
+) {
+    match FormatSummary::try_from(literal) {
+        Err(error) => {
+            if checker.enabled(Rule::StringDotFormatInvalidFormat) {
+                checker.diagnostics.push(Diagnostic::new(
+                    StringDotFormatInvalidFormat {
+                        message: super::super::format::error_to_string(&error),
+                    },
+                    location,
+                ));
+            }
+        }
+        Ok(summary) => {
+            if checker.enabled(Rule::StringDotFormatExtraNamedArguments) {
+                string_dot_format_extra_named_arguments(checker, call, &summary, keywords);
+            }
+            if checker.enabled(Rule::StringDotFormatExtraPositionalArguments) {
+                string_dot_format_extra_positional_arguments(checker, call, &summary, args);
+            }
+            if checker.enabled(Rule::StringDotFormatMissingArguments) {
+                string_dot_format_missing_argument(checker, call, &summary, args, keywords);
+            }
+            if checker.enabled(Rule::StringDotFormatMixingAutomatic) {
+                string_dot_format_mixing_automatic(checker, call, &summary);
+            }
+            if checker.enabled(Rule::FormatLiterals) {
+                pyupgrade::rules::format_literals(checker, call, &summary);
+            }
+            if checker.enabled(Rule::FString) {
+                pyupgrade::rules::f_strings(checker, call, &summary);
+            }
+        }
+    }
+}
+
+pub(crate) fn check_percent_format(
+    checker: &mut Checker,
+    literal: &str,
+    right: &Expr,
+    location: TextRange,
+) {
+    match CFormatSummary::try_from(literal) {
+        Err(ruff_python_literal::cformat::CFormatError {
+            typ: ruff_python_literal::cformat::CFormatErrorType::UnsupportedFormatChar(ch),
+            ..
+        }) => {
+            if checker.enabled(Rule::PercentFormatUnsupportedFormatCharacter) {
+                checker.diagnostics.push(Diagnostic::new(
+                    PercentFormatUnsupportedFormatCharacter { char: ch },
+                    location,
+                ));
+            }
+        }
+        Err(error) => {
+            if checker.enabled(Rule::PercentFormatInvalidFormat) {
+                checker.diagnostics.push(Diagnostic::new(
+                    PercentFormatInvalidFormat {
+                        message: error.to_string(),
+                    },
+                    location,
+                ));
+            }
+        }
+        Ok(summary) => {
+            if checker.enabled(Rule::PercentFormatExpectedMapping) {
+                percent_format_expected_mapping(checker, &summary, right, location);
+            }
+            if checker.enabled(Rule::PercentFormatExpectedSequence) {
+                percent_format_expected_sequence(checker, &summary, right, location);
+            }
+            if checker.enabled(Rule::PercentFormatExtraNamedArguments) {
+                percent_format_extra_named_arguments(checker, &summary, right, location);
+            }
+            if checker.enabled(Rule::PercentFormatMissingArgument) {
+                percent_format_missing_arguments(checker, &summary, right, location);
+            }
+            if checker.enabled(Rule::PercentFormatMixedPositionalAndNamed) {
+                percent_format_mixed_positional_and_named(checker, &summary, location);
+            }
+            if checker.enabled(Rule::PercentFormatPositionalCountMismatch) {
+                percent_format_positional_count_mismatch(checker, &summary, right, location);
+            }
+            if checker.enabled(Rule::PercentFormatStarRequiresSequence) {
+                percent_format_star_requires_sequence(checker, &summary, right, location);
+            }
+        }
+    }
+}
