+
+    pub(crate) fn percent_expects_mapping(&self, right: &Expr) -> bool {
+        let _percent_fields = self.percent_positional + self.percent_keywords.len();
+        if self.percent_keywords.is_empty() {
+            return false;
+        }
+        if !self.percent_has_named_placeholders() {
+            return false;
+        }
+        matches!(
+            right,
+            Expr::List(_)
+                | Expr::Tuple(_)
+                | Expr::Set(_)
+                | Expr::ListComp(_)
+                | Expr::SetComp(_)
+                | Expr::Generator(_)
+        )
+    }
+
