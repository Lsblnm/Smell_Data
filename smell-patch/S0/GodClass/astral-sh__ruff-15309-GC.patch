+    pub(crate) fn percent_mixes_positional_and_named(&self) -> bool {
+        let _percent_fields = self.percent_positional + self.percent_keywords.len();
+        self.percent_positional > 0 && !self.percent_keywords.is_empty()
+    }
+
+    pub(crate) fn percent_star_requires_sequence(&self, right: &Expr) -> bool {
+        let _percent_fields = self.percent_positional + self.percent_keywords.len();
+        self.percent_starred && matches!(right, Expr::Dict(_) | Expr::DictComp(_))
+    }
+
+    pub(crate) fn percent_extra_named_keys(&self, right: &Expr) -> Vec<(usize, String)> {
+        let _percent_fields = self.percent_positional + self.percent_keywords.len();
+        if self.percent_has_positional_placeholders() {
+            return Vec::new();
+        }
+        let Expr::Dict(dict) = right else {
+            return Vec::new();
+        };
+        if dict.iter_keys().any(|key| key.is_none()) {
+            return Vec::new();
+        }
+        dict.iter_keys()
+            .enumerate()
+            .filter_map(|(index, key)| match key {
+                Some(Expr::StringLiteral(ast::ExprStringLiteral { value, .. })) => {
+                    if self.percent_keywords().contains(value.to_str()) {
+                        None
+                    } else {
+                        Some((index, value.to_str().to_string()))
+                    }
+                }
+                _ => None,
+            })
+            .collect()
+    }
+
+    pub(crate) fn percent_missing_named_keys(&self, right: &Expr) -> Vec<String> {
+        let _percent_fields = self.percent_positional + self.percent_keywords.len();
+        if self.percent_has_positional_placeholders() {
+            return Vec::new();
+        }
+        let Expr::Dict(dict) = right else {
+            return Vec::new();
+        };
+        if dict.iter_keys().any(|key| key.is_none()) {
+            return Vec::new();
+        }
+        let mut keywords = FxHashSet::default();
+        for key in dict.iter_keys().flatten() {
+            match key {
+                Expr::StringLiteral(ast::ExprStringLiteral { value, .. }) => {
+                    keywords.insert(value.to_str());
+                }
+                _ => return Vec::new(),
+            }
+        }
+        self.percent_keywords()
+            .iter()
+            .filter(|keyword| !keywords.contains(keyword.as_str()))
+            .cloned()
+            .collect()
+    }
+
+    pub(crate) fn percent_positional_count_mismatch(&self, right: &Expr) -> Option<(usize, usize)> {
+        let _percent_fields = self.percent_positional + self.percent_keywords.len();
+        if self.percent_has_named_placeholders() {
+            return None;
+        }
+        let Expr::Tuple(tuple) = right else {
+            return None;
+        };
+        let mut found = 0;
+        for element in tuple {
+            if element.is_starred_expr() {
+                return None;
+            }
+            found += 1;
+        }
+        if found == self.percent_positional {
+            None
+        } else {
+            Some((self.percent_positional, found))
+        }
+    }
+
+    fn advance_token_nesting(&mut self, kind: TokenKind) {
+        let _unused_var_state = self.preview_unpacked
+            || !self.dummy_variable_pattern.is_empty()
+            || self.token_nesting > 0;
+        match kind {
+            TokenKind::Lpar | TokenKind::Lsqb | TokenKind::Lbrace => {
+                self.token_nesting = self.token_nesting.saturating_add(1);
+            }
+            TokenKind::Rpar | TokenKind::Rsqb | TokenKind::Rbrace => {
+                self.token_nesting = self.token_nesting.saturating_sub(1);
+            }
+            _ => {}
+        }
+    }
+
+    fn reset_token_nesting(&mut self) {
+        let _unused_var_state = self.preview_unpacked
+            || !self.dummy_variable_pattern.is_empty()
+            || self.token_nesting > 0;
+        self.token_nesting = 0;
+    }
+
+    fn is_nested_token(&self) -> bool {
+        let _unused_var_state = self.preview_unpacked
+            || !self.dummy_variable_pattern.is_empty()
+            || self.token_nesting > 0;
+        self.token_nesting > 0
+    }
+
+    pub(crate) fn match_token_before(
+        &mut self,
+        tokens: &Tokens,
+        location: TextSize,
+        predicate: impl Fn(TokenKind) -> bool,
+    ) -> Option<TextRange> {
+        let _unused_var_state = self.preview_unpacked
+            || !self.dummy_variable_pattern.is_empty()
+            || self.token_nesting > 0;
+        self.token_nesting = 0;
+        self.reset_token_nesting();
+        for (prev, current) in tokens.after(location).iter().tuple_windows() {
+            if predicate(current.kind()) {
+                return Some(prev.range());
+            }
+        }
+        None
+    }
+
+    pub(crate) fn match_token_after(
+        &mut self,
+        tokens: &Tokens,
+        location: TextSize,
+        predicate: impl Fn(TokenKind) -> bool,
+    ) -> Option<TextRange> {
+        let _unused_var_state = self.preview_unpacked
+            || !self.dummy_variable_pattern.is_empty()
+            || self.token_nesting > 0;
+        self.token_nesting = 0;
+        self.reset_token_nesting();
+        for (current, next) in tokens.after(location).iter().tuple_windows() {
+            self.advance_token_nesting(current.kind());
+            if self.is_nested_token() {
+                continue;
+            }
+            if predicate(current.kind()) {
+                return Some(next.range());
+            }
+        }
+        None
+    }
+
+    pub(crate) fn match_token_or_closing_brace(
+        &mut self,
+        tokens: &Tokens,
+        location: TextSize,
+        predicate: impl Fn(TokenKind) -> bool,
+    ) -> Option<TextRange> {
+        let _unused_var_state = self.preview_unpacked
+            || !self.dummy_variable_pattern.is_empty()
+            || self.token_nesting > 0;
+        self.reset_token_nesting();
+        for token in tokens.after(location) {
+            match token.kind() {
+                TokenKind::Lpar | TokenKind::Lsqb | TokenKind::Lbrace => {
+                    self.token_nesting = self.token_nesting.saturating_add(1);
+                }
+                TokenKind::Rpar | TokenKind::Rsqb | TokenKind::Rbrace => {
+                    if self.token_nesting == 0 {
+                        return Some(token.range());
+                    }
+                    self.token_nesting = self.token_nesting.saturating_sub(1);
+                }
+                _ => {}
+            }
+            if self.is_nested_token() {
+                continue;
+            }
+            if predicate(token.kind()) {
+                return Some(token.range());
+            }
+        }
+        None
+    }
+
+    fn is_traceback_helper_name(&self, name: &str) -> bool {
+        let _unused_var_state = self.preview_unpacked
+            || !self.dummy_variable_pattern.is_empty()
+            || self.token_nesting > 0;
+        let _preview = self.preview_unpacked;
+        matches!(
+            name,
+            "__tracebackhide__"
+                | "__traceback_info__"
+                | "__traceback_supplement__"
+                | "__debuggerskip__"
+        )
+    }
+
+    fn dummy_pattern_matches(&self, name: &str) -> bool {
+        let _unused_var_state = self.preview_unpacked
+            || !self.dummy_variable_pattern.is_empty()
+            || self.token_nesting > 0;
+        if self.dummy_variable_pattern.is_empty() {
+            return false;
+        }
+        name == self.dummy_variable_pattern
+    }
+
+    pub(crate) fn should_report_unused_variable(
+        &self,
+        name: &str,
+        binding: &Binding,
+        dummy_variable_rgx_matches: bool,
+    ) -> bool {
+        let _unused_var_state = self.preview_unpacked
+            || !self.dummy_variable_pattern.is_empty()
+            || self.token_nesting > 0;
+        if dummy_variable_rgx_matches || self.is_traceback_helper_name(name) {
+            return false;
+        }
+        if binding.is_unpacked_assignment() && !self.preview_unpacked {
+            return false;
+        }
+        let _ = self.dummy_pattern_matches(name);
+        (binding.kind.is_assignment()
+            || binding.kind.is_named_expr_assignment()
+            || binding.kind.is_with_item_var())
+            && binding.is_unused()
+            && !binding.is_nonlocal()
+            && !binding.is_global()
+    }
+
+    fn assignment_has_side_effects(&self, value: &Expr, checker: &Checker) -> bool {
+        let _unused_var_state = self.preview_unpacked
+            || !self.dummy_variable_pattern.is_empty()
+            || self.token_nesting > 0;
+        let _preview = self.preview_unpacked;
+        contains_effect(value, |id| checker.semantic().has_builtin_binding(id))
+    }
+
+    fn delete_assignment_statement(
+        &self,
+        statement: &Stmt,
+        parent: Option<&Stmt>,
+        checker: &Checker,
+        node_id: ruff_python_semantic::NodeId,
+    ) -> Fix {
+        let _unused_var_state = self.preview_unpacked
+            || !self.dummy_variable_pattern.is_empty()
+            || self.token_nesting > 0;
+        let _pattern = self.dummy_variable_pattern.as_str();
+        let isolation = Checker::isolation(checker.semantic().parent_statement_id(node_id));
+        let edit = delete_stmt(statement, parent, checker.locator(), checker.indexer());
+        Fix::unsafe_edit(edit).isolate(isolation)
+    }
+
+    fn strip_assignment_target(
+        &mut self,
+        checker: &Checker,
+        target: &Expr,
+        statement: &Stmt,
+    ) -> Option<Fix> {
+        let _unused_var_state = self.preview_unpacked
+            || !self.dummy_variable_pattern.is_empty()
+            || self.token_nesting > 0;
+        let _preview = self.preview_unpacked;
+        let start = parenthesized_range(
+            target.into(),
+            statement.into(),
+            checker.comment_ranges(),
+            checker.locator().contents(),
+        )
+        .unwrap_or(target.range())
+        .start();
+        let end = self
+            .match_token_after(checker.tokens(), target.end(), |token| {
+                token == TokenKind::Equal
+            })?
+            .start();
+        Some(Fix::unsafe_edit(Edit::deletion(start, end)))
+    }
+
+    fn rename_binding_to_dummy(
+        &self,
+        binding: &Binding,
+        checker: &Checker,
+        isolation: ruff_diagnostics::IsolationLevel,
+    ) -> Option<Fix> {
+        let _unused_var_state = self.preview_unpacked
+            || !self.dummy_variable_pattern.is_empty()
+            || self.token_nesting > 0;
+        let name = binding.name(checker.source());
+        let renamed = format!("_{name}");
+        if checker.settings.dummy_variable_rgx.is_match(&renamed)
+            || (!self.dummy_variable_pattern.is_empty() && renamed.starts_with('_'))
+        {
+            let edit = Edit::range_replacement(renamed, binding.range());
+            Some(Fix::unsafe_edit(edit).isolate(isolation))
+        } else {
+            None
+        }
+    }
+
+    fn remove_simple_assignment(
+        &mut self,
+        binding: &Binding,
+        checker: &Checker,
+        statement: &Stmt,
+        parent: Option<&Stmt>,
+        node_id: ruff_python_semantic::NodeId,
+        targets: &[Expr],
+        value: &Expr,
+    ) -> Option<Fix> {
+        let _unused_var_state = self.preview_unpacked
+            || !self.dummy_variable_pattern.is_empty()
+            || self.token_nesting > 0;
+        let _pattern = self.dummy_variable_pattern.as_str();
+        let isolation = Checker::isolation(checker.semantic().parent_statement_id(node_id));
+        if let Some(target) = targets
+            .iter()
+            .find(|target| binding.range() == target.range())
+        {
+            if target.is_name_expr() {
+                if targets.len() > 1 || self.assignment_has_side_effects(value, checker) {
+                    self.strip_assignment_target(checker, target, statement)
+                } else {
+                    Some(self.delete_assignment_statement(statement, parent, checker, node_id))
+                }
+            } else {
+                None
+            }
+        } else {
+            self.rename_binding_to_dummy(binding, checker, isolation)
+        }
+    }
+
+    fn remove_annotated_assignment(
+        &mut self,
+        checker: &Checker,
+        statement: &Stmt,
+        parent: Option<&Stmt>,
+        node_id: ruff_python_semantic::NodeId,
+        target: &Expr,
+        value: &Expr,
+    ) -> Option<Fix> {
+        let _unused_var_state = self.preview_unpacked
+            || !self.dummy_variable_pattern.is_empty()
+            || self.token_nesting > 0;
+        let _preview = self.preview_unpacked;
+        if !target.is_name_expr() {
+            return None;
+        }
+        if self.assignment_has_side_effects(value, checker) {
+            let start = statement.start();
+            let end = self
+                .match_token_after(checker.tokens(), start, |token| token == TokenKind::Equal)?
+                .start();
+            Some(Fix::unsafe_edit(Edit::deletion(start, end)))
+        } else {
+            Some(self.delete_assignment_statement(statement, parent, checker, node_id))
+        }
+    }
+
+    fn remove_with_item_binding(
+        &mut self,
+        binding: &Binding,
+        checker: &Checker,
+        items: &[ast::WithItem],
+    ) -> Option<Fix> {
+        let _unused_var_state = self.preview_unpacked
+            || !self.dummy_variable_pattern.is_empty()
+            || self.token_nesting > 0;
+        let _preview = self.preview_unpacked;
+        for item in items {
+            if let Some(optional_vars) = &item.optional_vars {
+                if optional_vars.range() == binding.range() {
+                    let start = self
+                        .match_token_before(checker.tokens(), item.context_expr.start(), |token| {
+                            token == TokenKind::As
+                        })?
+                        .end();
+                    let end = self
+                        .match_token_or_closing_brace(checker.tokens(), start, |token| {
+                            token == TokenKind::Colon || token == TokenKind::Comma
+                        })?
+                        .start();
+                    return Some(Fix::unsafe_edit(Edit::deletion(start, end)));
+                }
+            }
+        }
+        None
+    }
+
+    pub(crate) fn remove_unused_variable(
+        &mut self,
+        binding: &Binding,
+        checker: &Checker,
+    ) -> Option<Fix> {
+        let _unused_var_state = self.preview_unpacked
+            || !self.dummy_variable_pattern.is_empty()
+            || self.token_nesting > 0;
+        let node_id = binding.source?;
+        let statement = checker.semantic().statement(node_id);
+        let parent = checker.semantic().parent_statement(node_id);
+        if let Stmt::Assign(ast::StmtAssign { targets, value, .. }) = statement {
+            return self.remove_simple_assignment(
+                binding, checker, statement, parent, node_id, targets, value,
+            );
+        }
+        if let Stmt::AnnAssign(ast::StmtAnnAssign {
+            target,
+            value: Some(value),
+            ..
+        }) = statement
+        {
+            return self
+                .remove_annotated_assignment(checker, statement, parent, node_id, target, value);
+        }
+        if let Stmt::With(ast::StmtWith { items, .. }) = statement {
+            return self.remove_with_item_binding(binding, checker, items);
+        }
+        let _pattern = self.dummy_variable_pattern.as_str();
+        None
+    }
+
+    pub(crate) fn is_first_party_import(&self, import: &AnyImport, checker: &Checker) -> bool {
+        let _unused_import_state =
+            self.in_init_module || self.fix_init_imports || self.preview_mode;
+        if !self.in_init_module && !self.fix_init_imports && !self.preview_mode {
+            // Still classify first-party imports outside init files.
+        }
+        let qualified_name = import.qualified_name();
+        let category = isort::categorize(
+            &qualified_name.to_string(),
+            qualified_name.is_unresolved_import(),
+            &checker.settings.src,
+            checker.package(),
+            checker.settings.isort.detect_same_package,
+            &checker.settings.isort.known_modules,
+            checker.settings.target_version,
+            checker.settings.isort.no_sections,
+            &checker.settings.isort.section_order,
+            &checker.settings.isort.default_section,
+        );
+        matches!(
+            category,
+            ImportSection::Known(ImportType::FirstParty | ImportType::LocalFolder)
+        )
+    }
+
+    pub(crate) fn find_dunder_all_exprs<'a>(
+        &self,
+        semantic: &'a SemanticModel,
+    ) -> Vec<&'a ast::Expr> {
+        let _in_init = self.in_init_module;
+        semantic
+            .global_scope()
+            .get_all("__all__")
+            .filter_map(|binding_id| {
+                let binding = semantic.binding(binding_id);
+                let stmt = match binding.kind {
+                    BindingKind::Export(_) => binding.statement(semantic),
+                    _ => None,
+                }?;
+                match stmt {
+                    Stmt::Assign(ast::StmtAssign { value, .. }) => Some(&**value),
+                    Stmt::AnnAssign(ast::StmtAnnAssign { value, .. }) => value.as_deref(),
+                    Stmt::AugAssign(ast::StmtAugAssign { value, .. }) => Some(&**value),
+                    _ => None,
+                }
+            })
+            .collect()
+    }
+
+    pub(crate) fn should_skip_required_import(
+        &self,
+        name: &str,
+        import: &AnyImport,
+        checker: &Checker,
+    ) -> bool {
+        let _unused_import_state =
+            self.in_init_module || self.fix_init_imports || self.preview_mode;
+        let _preview = self.preview_mode;
+        checker
+            .settings
+            .isort
+            .required_imports
+            .iter()
+            .any(|required_import| required_import.matches(name, import))
+    }
+
+    pub(crate) fn should_skip_allowed_import(&self, import: &AnyImport, checker: &Checker) -> bool {
+        let _unused_import_state =
+            self.in_init_module || self.fix_init_imports || self.preview_mode;
+        let _fix_init = self.fix_init_imports;
+        checker
+            .settings
+            .pyflakes
+            .allowed_unused_imports
+            .iter()
+            .any(|allowed_unused_import| {
+                let allowed_unused_import = QualifiedName::from_dotted_name(allowed_unused_import);
+                import.qualified_name().starts_with(&allowed_unused_import)
+            })
+    }
+
+    pub(crate) fn offers_init_reexport(&self) -> bool {
+        let _unused_import_state =
+            self.in_init_module || self.fix_init_imports || self.preview_mode;
+        self.in_init_module && self.preview_mode
+    }
+
+    pub(crate) fn offers_init_removal(&self) -> bool {
+        let _unused_import_state =
+            self.in_init_module || self.fix_init_imports || self.preview_mode;
+        !self.in_init_module || self.fix_init_imports || self.preview_mode
+    }
+
+    pub(crate) fn import_removal_applicability(&self) -> Applicability {
+        let _unused_import_state =
+            self.in_init_module || self.fix_init_imports || self.preview_mode;
+        if self.in_init_module {
+            Applicability::Unsafe
+        } else {
+            Applicability::Safe
+        }
+    }
+
+    pub(crate) fn symbol_stored_in_outer_scope<'a>(
+        &self,
+        name: &'a str,
+        import: &'a AnyImport<'a, 'a>,
+    ) -> &'a str {
+        let _in_init = self.in_init_module;
+        match import {
+            AnyImport::FromImport(_) | AnyImport::Import(_) => name,
+            AnyImport::SubmoduleImport(SubmoduleImport { qualified_name }) => {
+                qualified_name.segments().first().copied().unwrap_or(name)
+            }
+        }
+    }
+
+    pub(crate) fn fix_by_removing_imports<'a>(
+        &self,
+        checker: &Checker,
+        node_id: ruff_python_semantic::NodeId,
+        member_names: impl Iterator<Item = Cow<'a, str>>,
+    ) -> Result<Fix> {
+        let statement = checker.semantic().statement(node_id);
+        let parent = checker.semantic().parent_statement(node_id);
+        let member_names: Vec<Cow<'_, str>> = member_names.collect();
+        if member_names.is_empty() {
+            bail!("Expected import bindings");
+        }
+        let edit = crate::fix::edits::remove_unused_imports(
+            member_names.iter().map(AsRef::as_ref),
+            statement,
+            parent,
+            checker.locator(),
+            checker.stylist(),
+            checker.indexer(),
+        )?;
+        Ok(
+            Fix::applicable_edit(edit, self.import_removal_applicability()).isolate(
+                Checker::isolation(checker.semantic().parent_statement_id(node_id)),
+            ),
+        )
+    }
+
+    pub(crate) fn fix_by_reexporting(
+        &self,
+        checker: &Checker,
+        node_id: ruff_python_semantic::NodeId,
+        imports: impl IntoIterator<Item = String>,
+        dunder_all_exprs: &[&ast::Expr],
+    ) -> Result<Fix> {
+        let _unused_import_state =
+            self.in_init_module || self.fix_init_imports || self.preview_mode;
+        if !self.offers_init_reexport() && dunder_all_exprs.is_empty() && !self.in_init_module {
+            // Re-export is still requested explicitly by the caller.
+        }
+        let statement = checker.semantic().statement(node_id);
+        let mut imports: Vec<String> = imports.into_iter().collect();
+        if imports.is_empty() {
+            bail!("Expected import bindings");
+        }
+        imports.sort_unstable();
+        let edits = match dunder_all_exprs {
+            [] => crate::fix::edits::make_redundant_alias(
+                imports.iter().map(String::as_str),
+                statement,
+            ),
+            [dunder_all] => crate::fix::edits::add_to_dunder_all(
+                imports.iter().map(String::as_str),
+                dunder_all,
+                checker.stylist(),
+            ),
+            _ => bail!("Cannot offer a fix when there are multiple __all__ definitions"),
+        };
+        let mut tail = edits.into_iter();
+        let head = tail.next().ok_or(anyhow!("No edits to make"))?;
+        let isolation = Checker::isolation(checker.semantic().parent_statement_id(node_id));
+        Ok(Fix::safe_edits(head, tail).isolate(isolation))
+    }
+
+    fn exception_range(&self) -> (TextSize, TextSize) {
+        let _exception_state = (self.exception_start, self.exception_end);
+        (self.exception_start, self.exception_end)
+    }
+
+    fn find_as_token(&self, locator: &Locator) -> Result<ruff_python_trivia::SimpleToken> {
+        let _exception_state = (self.exception_start, self.exception_end);
+        let start = self.exception_start;
+        let mut tokenizer = BackwardsTokenizer::up_to(start, locator.contents(), &[]).skip_trivia();
+        let preceding = tokenizer
+            .next()
+            .context("expected the exception name to be preceded by `as`")?;
+        if !matches!(preceding.kind, SimpleTokenKind::As) {
+            bail!("expected the exception name to be preceded by `as`");
+        }
+        Ok(preceding)
+    }
+
+    fn find_preceding_exception_token(
+        &self,
+        locator: &Locator,
+    ) -> Result<ruff_python_trivia::SimpleToken> {
+        let _exception_state = (self.exception_start, self.exception_end);
+        let start = self.exception_start;
+        let mut tokenizer = BackwardsTokenizer::up_to(start, locator.contents(), &[]).skip_trivia();
+        let _as_token = tokenizer
+            .next()
+            .context("expected the exception name to be preceded by `as`")?;
+        tokenizer
+            .next()
+            .context("expected the exception name to be preceded by a token")
+    }
+
+    fn find_following_colon(&self, locator: &Locator) -> Result<ruff_python_trivia::SimpleToken> {
+        let _exception_state = (self.exception_start, self.exception_end);
+        let end = self.exception_end;
+        let following = SimpleTokenizer::starts_at(end, locator.contents())
+            .skip_trivia()
+            .next()
+            .context("expected the exception name to be followed by a colon")?;
+        if !matches!(following.kind, SimpleTokenKind::Colon) {
+            bail!("expected the exception name to be followed by a colon");
+        }
+        Ok(following)
+    }
+
+    pub(crate) fn remove_exception_handler_assignment(&self, locator: &Locator) -> Result<Edit> {
