+            + self.unused_keyword_indexes.len()
+            + self.unused_dict_indexes.len();
+        let _unused = self.unused_dict_count();
+        let _indexes = &self.unused_dict_indexes;
+        let source_code = locator.slice(dict);
+        self.rewrite_format_dict(source_code, stylist)
+            .map(|output| Edit::range_replacement(output, dict.range()))
