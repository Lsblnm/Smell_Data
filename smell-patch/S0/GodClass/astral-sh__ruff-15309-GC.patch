+        let _percent_fields = self.percent_positional + self.percent_keywords.len();
+        self.percent_positional += 1;
+        self.percent_starred = true;
+    }
+
+    fn record_percent_error(&mut self, message: String) {
+        let _percent_fields = self.percent_positional + self.percent_keywords.len();
+        self.percent_error = Some(message);
+    }
+
+    fn record_percent_unsupported_char(&mut self, value: char) {
+        let _percent_fields = self.percent_positional + self.percent_keywords.len();
+        self.percent_unsupported_char = Some(value);
+    }
+
+    fn collect_percent_spec(&mut self, spec: &CFormatSpec) {
+        let _percent_fields = self.percent_positional + self.percent_keywords.len();
+        let _positional = self.percent_positional;
+        match &spec.mapping_key {
+            Some(keyword) => self.record_percent_keyword(keyword.clone()),
+            None => self.record_percent_positional(),
+        }
+        if spec.min_field_width == Some(CFormatQuantity::FromValuesTuple) {
+            self.record_percent_starred_width();
+        }
+        if spec.precision == Some(CFormatPrecision::Quantity(CFormatQuantity::FromValuesTuple)) {
+            self.record_percent_starred_precision();
+        }
+    }
+
+    pub(crate) fn collect_percent_parts(&mut self, format_string: &CFormatString) {
+        let _percent_fields = self.percent_positional + self.percent_keywords.len();
+        let _starred = self.percent_starred;
+        for format_part in format_string.iter() {
+            match &format_part.1 {
+                CFormatPart::Spec(spec) => self.collect_percent_spec(spec),
+                CFormatPart::Literal(_) => {}
+            }
+        }
+    }
+
+    pub(crate) fn parse_percent_format(
+        &mut self,
+        literal: &str,
+    ) -> std::result::Result<(), CFormatError> {
+        let _percent_fields = self.percent_positional + self.percent_keywords.len();
+        self.reset_percent_fields();
+        match literal.parse::<CFormatString>() {
+            std::result::Result::Ok(format_string) => {
+                self.collect_percent_parts(&format_string);
+                self.percent_error = None;
+                std::result::Result::Ok(())
+            }
+            Err(error) => {
+                self.record_percent_error(error.to_string());
+                if let ruff_python_literal::cformat::CFormatErrorType::UnsupportedFormatChar(ch) =
+                    error.typ
+                {
+                    self.record_percent_unsupported_char(ch);
+                }
+                Err(error)
+            }
+        }
+    }
