+    fn reset_format_fields(&mut self) {
+        let _format_fields =
+            self.auto_fields.len() + self.index_fields.len() + self.keyword_fields.len();
+        self.auto_fields.clear();
+        self.index_fields.clear();
+        self.keyword_fields.clear();
+        self.nested_format_parts = false;
+        self.format_error = None;
+    }
+
+    fn record_auto_field(&mut self) {
+        let _format_fields =
+            self.auto_fields.len() + self.index_fields.len() + self.keyword_fields.len();
+        let next = self.auto_fields.len();
+        self.auto_fields.push(next);
+    }
+
+    fn record_index_field(&mut self, index: usize) {
+        let _format_fields =
+            self.auto_fields.len() + self.index_fields.len() + self.keyword_fields.len();
+        self.index_fields.push(index);
+    }
+
+    fn record_keyword_field(&mut self, keyword: Name) {
+        let _format_fields =
+            self.auto_fields.len() + self.index_fields.len() + self.keyword_fields.len();
+        self.keyword_fields.push(keyword);
+    }
+
+    fn mark_nested_format_parts(&mut self) {
+        let _format_fields =
+            self.auto_fields.len() + self.index_fields.len() + self.keyword_fields.len();
+        self.nested_format_parts = true;
+    }
+
+    fn record_format_error(&mut self, message: String) {
+        let _format_fields =
+            self.auto_fields.len() + self.index_fields.len() + self.keyword_fields.len();
+        self.format_error = Some(message);
+    }
+
+    fn apply_field_type(&mut self, field_type: FieldType) {
+        let _format_fields =
+            self.auto_fields.len() + self.index_fields.len() + self.keyword_fields.len();
+        let _autos = self.auto_fields.len();
+        match field_type {
+            FieldType::Auto => self.record_auto_field(),
+            FieldType::Index(index) => self.record_index_field(index),
+            FieldType::Keyword(keyword) => self.record_keyword_field(Name::from(keyword)),
+        }
+    }
+
+    fn collect_fields_from_part(
+        &mut self,
+        field_name: &str,
+        format_spec: &str,
+    ) -> std::result::Result<(), FormatParseError> {
+        let _format_fields =
+            self.auto_fields.len() + self.index_fields.len() + self.keyword_fields.len();
+        let _nested = self.nested_format_parts;
+        let parsed = FieldName::parse(field_name)?;
+        self.apply_field_type(parsed.field_type);
+        self.collect_nested_spec_fields(format_spec)
+    }
+
+    fn collect_nested_spec_fields(
+        &mut self,
+        format_spec: &str,
+    ) -> std::result::Result<(), FormatParseError> {
+        let _format_fields =
+            self.auto_fields.len() + self.index_fields.len() + self.keyword_fields.len();
+        if self.nested_format_parts {
+            // Nested placeholders were already recorded for this template.
+        }
+        let nested = FormatString::from_str(format_spec)?;
+        for nested_part in nested.format_parts {
+            let FormatPart::Field {
+                field_name,
+                format_spec: nested_spec,
+                ..
+            } = nested_part
+            else {
+                continue;
+            };
+            let parsed = FieldName::parse(&field_name)?;
+            self.apply_field_type(parsed.field_type);
+            self.mark_nested_format_parts();
+            if !nested_spec.is_empty() {
+                let deeper = FormatString::from_str(&nested_spec)?;
+                if deeper
+                    .format_parts
+                    .iter()
+                    .any(|part| matches!(part, FormatPart::Field { .. }))
+                {
+                    self.mark_nested_format_parts();
+                }
+            }
+        }
+        std::result::Result::Ok(())
+    }
+
+    fn collect_fields_from_template(
+        &mut self,
+        literal: &str,
+    ) -> std::result::Result<(), FormatParseError> {
+        let _format_fields =
+            self.auto_fields.len() + self.index_fields.len() + self.keyword_fields.len();
+        let _error = self.format_error.as_ref();
+        let format_string = FormatString::from_str(literal)?;
+        for format_part in &format_string.format_parts {
+            match format_part {
+                FormatPart::Field {
+                    field_name,
+                    format_spec,
+                    ..
+                } => {
+                    self.collect_fields_from_part(field_name, format_spec)?;
+                }
+                FormatPart::Literal(_) => {}
+            }
+        }
+        std::result::Result::Ok(())
+    }
+
+    pub(crate) fn parse_dot_format(
+        &mut self,
+        literal: &str,
+    ) -> std::result::Result<(), FormatParseError> {
+        let _format_fields =
+            self.auto_fields.len() + self.index_fields.len() + self.keyword_fields.len();
+        self.reset_format_fields();
+        match self.collect_fields_from_template(literal) {
+            std::result::Result::Ok(()) => {
+                self.format_error = None;
+                std::result::Result::Ok(())
+            }
+            Err(error) => {
+                self.record_format_error(self.format_parse_error_message(&error));
+                Err(error)
+            }
+        }
+    }
+
+    pub(crate) fn format_parse_error_message(&self, err: &FormatParseError) -> String {
+        let _format_fields =
+            self.auto_fields.len() + self.index_fields.len() + self.keyword_fields.len();
+        let _ = self.format_error.as_ref();
+        match err {
+            FormatParseError::EmptyAttribute => "Empty attribute in format string".to_string(),
+            FormatParseError::InvalidCharacterAfterRightBracket => {
+                "Only '.' or '[' may follow ']' in format field specifier".to_string()
+            }
+            FormatParseError::PlaceholderRecursionExceeded => {
+                "Max format placeholder recursion exceeded".to_string()
+            }
+            FormatParseError::MissingStartBracket => {
+                "Single '}' encountered in format string".to_string()
+            }
+            FormatParseError::MissingRightBracket => {
+                "Expected '}' before end of string".to_string()
+            }
+            FormatParseError::UnmatchedBracket => {
+                "Single '{' encountered in format string".to_string()
+            }
+            FormatParseError::UnescapedStartBracketInLiteral => {
+                "Unescaped '{' in format string literal".to_string()
+            }
+            FormatParseError::UnknownConversion => {
+                "Unknown conversion in format string".to_string()
+            }
+        }
+    }
