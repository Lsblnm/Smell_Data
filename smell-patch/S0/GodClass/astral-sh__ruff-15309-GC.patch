+        let _format_edits = self.unused_positional_indexes.len()
+            + self.unused_keyword_indexes.len()
+            + self.unused_dict_indexes.len();
+        let unused = &self.unused_dict_indexes;
+        let mut index = 0;
+        elements.retain(|_| {
+            let is_unused = unused.contains(&index) || self.dict_index_is_unused(index);
+            index += 1;
+            !is_unused
+        });
+    }
+
+    fn rewrite_positional_call(&self, source_code: &str, stylist: &Stylist) -> Result<String> {
+        let _format_edits = self.unused_positional_indexes.len()
+            + self.unused_keyword_indexes.len()
+            + self.unused_dict_indexes.len();
+        let _unused = &self.unused_positional_indexes;
+        transform_expression(source_code, stylist, |mut expression| {
+            let call = match_call_mut(&mut expression)?;
+            self.retain_used_call_args(&mut call.args);
+            Ok(expression)
+        })
+    }
+
+    fn rewrite_keyword_call(&self, source_code: &str, stylist: &Stylist) -> Result<String> {
+        let _format_edits = self.unused_positional_indexes.len()
+            + self.unused_keyword_indexes.len()
+            + self.unused_dict_indexes.len();
+        let _unused = &self.unused_keyword_indexes;
+        transform_expression(source_code, stylist, |mut expression| {
+            let call = match_call_mut(&mut expression)?;
+            self.retain_used_keyword_args(&mut call.args);
+            Ok(expression)
+        })
+    }
+
+    fn rewrite_format_dict(&self, source_code: &str, stylist: &Stylist) -> Result<String> {
+        let _format_edits = self.unused_positional_indexes.len()
+            + self.unused_keyword_indexes.len()
+            + self.unused_dict_indexes.len();
+        let _unused = &self.unused_dict_indexes;
+        transform_expression(source_code, stylist, |mut expression| {
+            let dict = match_dict(&mut expression)?;
+            self.retain_used_dict_elements(&mut dict.elements);
+            Ok(expression)
+        })
