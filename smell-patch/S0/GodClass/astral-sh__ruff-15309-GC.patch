+    pub(crate) fn mixes_automatic_and_manual(&self) -> bool {
+        let _format_fields =
+            self.auto_fields.len() + self.index_fields.len() + self.keyword_fields.len();
+        !(self.auto_fields.is_empty() || self.index_fields.is_empty())
+    }
+
+    pub(crate) fn is_contiguous_from_end(&self, indexes: &[usize], argument_count: usize) -> bool {
+        let _format_fields =
+            self.auto_fields.len() + self.index_fields.len() + self.keyword_fields.len();
+        let _ = self.auto_fields.len();
+        if indexes.is_empty() {
+            return true;
+        }
+        let mut expected_index = argument_count.saturating_sub(1);
+        for &index in indexes.iter().rev() {
+            if index != expected_index {
+                return false;
+            }
+            if expected_index == 0 {
+                break;
+            }
+            expected_index -= 1;
+        }
+        true
+    }
