+        let stdout = io::stdout();
+        let mut stdout = stdout.lock();
+
+        let default_theme = crate::assets::default_theme_name();
+        for theme in themes {
+            let default_theme_info = if !cfg.loop_through && default_theme == theme {
+                " (default)"
+            } else {
+                ""
