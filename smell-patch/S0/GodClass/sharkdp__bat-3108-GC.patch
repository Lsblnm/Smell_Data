 use bat::assets::HighlightingAssets;
 use bat::assets_metadata::AssetsMetadata;
+use bat::config::Config;
+use bat::controller::Controller;
 use bat::error::*;
+use bat::input::Input;
+use bat::style::{StyleComponent, StyleComponents};
+use bat::{MappingTarget, SyntaxMapping};
+
+const THEME_PREVIEW_DATA: &[u8] = include_bytes!("../../../assets/theme_preview.rs");
 
 pub fn clear_assets(cache_dir: &Path) {
     clear_asset(cache_dir.join("themes.bin"), "theme set cache");
@@ -55,3 +65,124 @@ fn clear_asset(path: PathBuf, description: &str) {
         Ok(_) => println!("okay"),
     }
 }
+
+pub fn default_theme_name() -> &'static str {
+    HighlightingAssets::default_theme()
+}
+
+pub fn acknowledgements_text() -> String {
+    bat::assets::get_acknowledgements()
+}
+
+#[cfg(feature = "build-assets")]
+pub fn build_custom_assets(
+    source_dir: &Path,
+    include_defaults: bool,
+    acknowledgements: bool,
+    cache_dir: &Path,
+) -> Result<()> {
+    bat::assets::build(
+        source_dir,
+        include_defaults,
+        acknowledgements,
+        cache_dir,
+        crate_version!(),
+    )
+}
+
+pub fn execute_with_assets(config: &Config, cache_dir: &Path, inputs: Vec<Input>) -> Result<bool> {
+    let assets = assets_from_cache_or_binary(config.use_custom_assets, cache_dir)?;
+    Controller::new(config, &assets).run(inputs, None)
+}
+
+pub fn available_theme_names(use_custom_assets: bool, cache_dir: &Path) -> Result<Vec<String>> {
+    let assets = assets_from_cache_or_binary(use_custom_assets, cache_dir)?;
+    Ok(assets.themes().map(|theme| theme.to_owned()).collect())
+}
+
+pub fn print_theme_preview(cfg: &Config, cache_dir: &Path, theme: &str) -> Result<()> {
+    let assets = assets_from_cache_or_binary(cfg.use_custom_assets, cache_dir)?;
+    let mut config = cfg.clone();
+    let mut style = std::collections::HashSet::new();
+    style.insert(StyleComponent::Plain);
+    config.language = Some("Rust");
+    config.style_components = StyleComponents(style);
+    config.theme = theme.to_string();
+    let input = Input::from_reader(Box::new(BufReader::new(THEME_PREVIEW_DATA)));
+    Controller::new(&config, &assets)
+        .run(vec![input], None)
+        .ok();
+    Ok(())
+}
+
+pub struct LanguageRecord {
+    pub name: String,
+    pub file_extensions: Vec<String>,
+}
+
+pub fn language_records(
+    use_custom_assets: bool,
+    cache_dir: &Path,
+    mapping: &SyntaxMapping,
+) -> Result<Vec<LanguageRecord>> {
+    let assets = assets_from_cache_or_binary(use_custom_assets, cache_dir)?;
+    let mut languages = assets
+        .get_syntaxes()?
+        .iter()
+        .filter(|syntax| !syntax.hidden && !syntax.file_extensions.is_empty())
+        .cloned()
+        .collect::<Vec<_>>();
+
+    // Handling of file-extension conflicts, see issue #1076
+    for lang in &mut languages {
+        let lang_name = lang.name.clone();
+        lang.file_extensions.retain(|extension| {
+            // The 'extension' variable is not certainly a real extension.
+            //
+            // Skip if 'extension' starts with '.', likely a hidden file like '.vimrc'
+            // Also skip if the 'extension' contains another real extension, likely
+            // that is a full match file name like 'CMakeLists.txt' and 'Cargo.lock'
+            if extension.starts_with('.') || Path::new(extension).extension().is_some() {
+                return true;
+            }
+
+            let test_file = Path::new("test").with_extension(extension);
+            let syntax_in_set = assets.get_syntax_for_path(test_file, mapping);
+            matches!(syntax_in_set, Ok(syntax_in_set) if syntax_in_set.syntax.name == lang_name)
+        });
+    }
+
+    languages.sort_by_key(|lang| lang.name.to_uppercase());
+
+    let configured_languages = syntax_mapping_to_paths(mapping.all_mappings());
+
+    for lang in &mut languages {
+        if let Some(additional_paths) = configured_languages.get(lang.name.as_str()) {
+            lang.file_extensions
+                .extend(additional_paths.iter().cloned());
+        }
+    }
+
+    Ok(languages
+        .into_iter()
+        .map(|lang| LanguageRecord {
+            name: lang.name,
+            file_extensions: lang.file_extensions,
+        })
+        .collect())
+}
+
+fn syntax_mapping_to_paths<'r, 't, I>(mappings: I) -> HashMap<&'t str, Vec<String>>
+where
+    I: IntoIterator<Item = (&'r GlobMatcher, &'r MappingTarget<'t>)>,
+    't: 'r,
+{
+    let mut map = HashMap::new();
+    for mapping in mappings {
+        if let (matcher, MappingTarget::MapTo(s)) = mapping {
+            let globs = map.entry(*s).or_insert_with(Vec::new);
+            globs.push(matcher.glob().glob().into());
+        }
+    }
+    map
+}
