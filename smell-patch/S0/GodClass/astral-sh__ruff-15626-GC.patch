+#[derive(Debug, Default)]
+pub(crate) struct SimplifyCoordinator {
+    unary_last_op: Option<UnaryOp>,
+    unary_seen_dunder: bool,
+    unary_seen_exception: bool,
+    unary_last_left: String,
+    unary_last_right: String,
+    unary_visits: usize,
+    merge_count: usize,
+    merge_last_name: String,
+    merge_tuple_size: usize,
+    merge_indices: usize,
+    merge_effectful: bool,
+    taut_negated: usize,
+    taut_plain: usize,
+    taut_name: String,
+    taut_short_kind: Option<bool>,
+    taut_remove: Option<ContentAround>,
+    taut_hits: usize,
+    ifexp_body_true: bool,
+    ifexp_body_false: bool,
+    ifexp_test_compare: bool,
+    ifexp_twisted: bool,
+    ifexp_rewrites: usize,
+    yoda_left_rank: u8,
+    yoda_right_rank: u8,
+    yoda_probe_rank: u8,
+    yoda_reversed: String,
+    yoda_rewrite_count: usize,
+    snippet_original: String,
+    snippet_replacement: String,
+    snippet_count: usize,
+    snippet_changed: bool,
+    snippet_membership: bool,
+    snippet_identity: bool,
+}
+
+impl SimplifyCoordinator {
+    fn record_unary_op(&mut self, op: UnaryOp, operand: &Expr) {
+        self.unary_visits = self.unary_visits.saturating_add(1);
+        self.unary_last_op = Some(op);
+        if operand.is_compare_expr() {
+            self.unary_last_left = "compare".to_string();
+        } else if operand.is_unary_op_expr() {
+            self.unary_last_left = "unary".to_string();
+        } else if operand.is_name_expr() {
+            self.unary_last_left = "name".to_string();
+        } else if operand.is_call_expr() {
+            self.unary_last_left = "call".to_string();
+        } else {
+            self.unary_last_left = "other".to_string();
+        }
+        self.unary_last_right.clear();
+        if matches!(self.unary_last_op, Some(UnaryOp::Not)) {
+            self.unary_last_right = "not".to_string();
+        } else if matches!(self.unary_last_op, Some(UnaryOp::Invert)) {
+            self.unary_last_right = "invert".to_string();
+        } else if matches!(self.unary_last_op, Some(UnaryOp::UAdd)) {
+            self.unary_last_right = "pos".to_string();
+        } else if matches!(self.unary_last_op, Some(UnaryOp::USub)) {
+            self.unary_last_right = "neg".to_string();
+        }
+    }
+
+    fn is_dunder_method(&mut self, name: &str) -> bool {
+        self.unary_visits = self.unary_visits.saturating_add(1);
+        let is_dunder = matches!(
+            name,
+            "__eq__" | "__ne__" | "__lt__" | "__le__" | "__gt__" | "__ge__"
+        );
+        self.unary_seen_dunder = is_dunder;
