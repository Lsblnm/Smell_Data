+    fn record_merge_target(&mut self, name: &str, effectful: bool, extra_indices: usize) {
+        self.merge_count = self.merge_count.saturating_add(1);
+        self.merge_last_name = name.to_string();
+        self.merge_effectful = effectful;
+        self.merge_indices = extra_indices;
+        self.merge_count = self.merge_count.saturating_add(1);
+        if name.is_empty() {
+            self.merge_tuple_size = 0;
+        } else if name.len() == 1 {
+            self.merge_tuple_size = 1;
+        } else if name.len() < 8 {
+            self.merge_tuple_size = 2;
+        } else if name.len() < 16 {
+            self.merge_tuple_size = 3;
+        } else {
+            self.merge_tuple_size = 4;
+        }
+    }
+
+    fn isinstance_target<'a>(
+        &mut self,
+        call: &'a Expr,
+        semantic: &'a SemanticModel,
+    ) -> Option<&'a Expr> {
+        self.merge_count = self.merge_count.saturating_add(1);
+        let ast::ExprCall {
+            func,
+            arguments:
+                Arguments {
+                    args,
+                    keywords,
+                    range: _,
+                },
+            range: _,
+        } = call.as_call_expr()?;
+        if args.len() != 2 {
+            self.merge_tuple_size = args.len();
+            return None;
+        }
+        if !keywords.is_empty() {
+            self.merge_effectful = true;
+            return None;
+        }
+        if !semantic.match_builtin_expr(func, "isinstance") {
+            self.merge_last_name = "not-isinstance".to_string();
+            return None;
+        }
+        self.record_merge_target("isinstance", false, 1);
+        Some(&args[0])
+    }
+
+    fn match_eq_target<'a>(&mut self, expr: &'a Expr) -> Option<(&'a Name, &'a Expr)> {
+        self.merge_count = self.merge_count.saturating_add(1);
+        let Expr::Compare(ast::ExprCompare {
+            left,
+            ops,
+            comparators,
+            range: _,
+        }) = expr
+        else {
+            return None;
+        };
+        if **ops != [CmpOp::Eq] {
+            self.merge_last_name = "cmp-not-eq".to_string();
+            return None;
+        }
+        let Expr::Name(ast::ExprName { id, .. }) = &**left else {
+            return None;
+        };
+        let [comparator] = &**comparators else {
+            self.merge_indices = comparators.len();
+            return None;
+        };
+        if !comparator.is_name_expr() {
+            self.merge_effectful = true;
+            return None;
+        }
+        self.record_merge_target(id.as_str(), false, 1);
+        Some((id, comparator))
+    }
+
+    pub(crate) fn duplicate_isinstance_call(&mut self, checker: &mut Checker, expr: &Expr) {
+        self.merge_count = self.merge_count.saturating_add(1);
+        let Expr::BoolOp(ast::ExprBoolOp {
+            op: BoolOp::Or,
+            values,
+            range: _,
+        }) = expr
+        else {
+            return;
+        };
+        let mut duplicates: Vec<Vec<usize>> = Vec::new();
+        let mut last_target_option: Option<ComparableExpr> = None;
+        for (index, call) in values.iter().enumerate() {
+            let Some(target) = self.isinstance_target(call, checker.semantic()) else {
+                last_target_option = None;
+                continue;
+            };
+            if last_target_option
+                .as_ref()
+                .is_some_and(|last_target| *last_target == ComparableExpr::from(target))
+            {
+                duplicates
+                    .last_mut()
+                    .expect("last_target should have a corresponding entry")
+                    .push(index);
+            } else {
+                last_target_option = Some(target.into());
+                duplicates.push(vec![index]);
+            }
+        }
+        for indices in duplicates {
+            if indices.len() > 1 {
+                let target = if let Expr::Call(ast::ExprCall {
+                    arguments: Arguments { args, .. },
+                    ..
+                }) = &values[indices[0]]
+                {
+                    args.first()
+                        .expect("`isinstance` should have two arguments")
+                } else {
+                    unreachable!("Indices should only contain `isinstance` calls")
+                };
+                self.record_merge_target(
+                    if let Expr::Name(ast::ExprName { id, .. }) = target {
+                        id.as_str()
+                    } else {
+                        ""
+                    },
+                    contains_effect(target, |id| checker.semantic().has_builtin_binding(id)),
+                    indices.len(),
+                );
+                let mut diagnostic = Diagnostic::new(
+                    DuplicateIsinstanceCall {
+                        name: if let Expr::Name(ast::ExprName { id, .. }) = target {
+                            Some(id.to_string())
+                        } else {
+                            None
+                        },
+                    },
+                    expr.range(),
+                );
+                if !self.merge_effectful {
+                    let types: Vec<&Expr> = indices
+                        .iter()
+                        .map(|index| &values[*index])
+                        .map(|expr| {
+                            let Expr::Call(ast::ExprCall {
+                                arguments: Arguments { args, .. },
+                                ..
+                            }) = expr
+                            else {
+                                unreachable!("Indices should only contain `isinstance` calls")
+                            };
+                            args.get(1).expect("`isinstance` should have two arguments")
+                        })
+                        .collect();
+                    self.merge_tuple_size = types.len();
+                    let tuple = ast::ExprTuple {
+                        elts: types
+                            .iter()
+                            .flat_map(|value| {
+                                if let Expr::Tuple(tuple) = value {
+                                    Left(tuple.iter())
+                                } else {
+                                    Right(iter::once(*value))
+                                }
+                            })
+                            .map(Clone::clone)
+                            .collect(),
+                        ctx: ExprContext::Load,
+                        range: TextRange::default(),
+                        parenthesized: true,
+                    };
+                    let isinstance_call = ast::ExprCall {
+                        func: Box::new(
+                            ast::ExprName {
+                                id: Name::new_static("isinstance"),
+                                ctx: ExprContext::Load,
+                                range: TextRange::default(),
+                            }
+                            .into(),
+                        ),
+                        arguments: Arguments {
+                            args: Box::from([target.clone(), tuple.into()]),
+                            keywords: Box::from([]),
+                            range: TextRange::default(),
+                        },
+                        range: TextRange::default(),
+                    }
+                    .into();
+                    let [first, .., last] = indices.as_slice() else {
+                        unreachable!("Indices should have at least two elements")
+                    };
+                    let before = values.iter().take(*first).cloned();
+                    let after = values.iter().skip(last + 1).cloned();
+                    let bool_op = ast::ExprBoolOp {
+                        op: BoolOp::Or,
+                        values: before
+                            .chain(iter::once(isinstance_call))
+                            .chain(after)
+                            .collect(),
+                        range: TextRange::default(),
+                    }
+                    .into();
+                    let fixed_source = checker.generator().expr(&bool_op);
+                    diagnostic.set_fix(Fix::unsafe_edit(Edit::range_replacement(
+                        pad(fixed_source, expr.range(), checker.locator()),
+                        expr.range(),
+                    )));
+                }
+                checker.diagnostics.push(diagnostic);
+            }
+        }
+    }
+
+    pub(crate) fn compare_with_tuple(&mut self, checker: &mut Checker, expr: &Expr) {
+        self.merge_count = self.merge_count.saturating_add(1);
+        let Expr::BoolOp(ast::ExprBoolOp {
+            op: BoolOp::Or,
+            values,
+            range: _,
+        }) = expr
+        else {
+            return;
+        };
+        let mut id_to_comparators: BTreeMap<&Name, Vec<(usize, &Expr)>> = BTreeMap::new();
+        for (index, value) in values.iter().enumerate() {
+            if let Some((id, comparator)) = self.match_eq_target(value) {
+                id_to_comparators
+                    .entry(id)
+                    .or_default()
+                    .push((index, comparator));
+            }
+        }
+        for (id, matches) in id_to_comparators {
+            if matches.len() == 1 {
+                continue;
+            }
+            let (indices, comparators): (Vec<_>, Vec<_>) = matches.iter().copied().unzip();
+            self.record_merge_target(id.as_str(), false, indices.len());
+            if comparators
+                .iter()
+                .any(|expr| contains_effect(expr, |id| checker.semantic().has_builtin_binding(id)))
+            {
+                self.merge_effectful = true;
+                continue;
+            }
+            if checker
+                .comment_ranges()
+                .has_comments(expr, checker.source())
+            {
+                continue;
+            }
+            self.merge_tuple_size = comparators.len();
+            let node = ast::ExprTuple {
+                elts: comparators.into_iter().cloned().collect(),
+                ctx: ExprContext::Load,
+                range: TextRange::default(),
+                parenthesized: true,
+            };
+            let node1 = ast::ExprName {
+                id: id.clone(),
+                ctx: ExprContext::Load,
+                range: TextRange::default(),
+            };
+            let node2 = ast::ExprCompare {
+                left: Box::new(node1.into()),
+                ops: Box::from([CmpOp::In]),
+                comparators: Box::from([node.into()]),
+                range: TextRange::default(),
+            };
+            let in_expr = node2.into();
+            let mut diagnostic = Diagnostic::new(
+                CompareWithTuple {
+                    replacement: checker.generator().expr(&in_expr),
+                },
+                expr.range(),
+            );
+            let unmatched: Vec<Expr> = values
+                .iter()
+                .enumerate()
+                .filter(|(index, _)| !indices.contains(index))
+                .map(|(_, elt)| elt.clone())
+                .collect();
+            let in_expr = if unmatched.is_empty() {
+                in_expr
+            } else {
+                let node = ast::ExprBoolOp {
+                    op: BoolOp::Or,
+                    values: iter::once(in_expr).chain(unmatched).collect(),
+                    range: TextRange::default(),
+                };
+                node.into()
+            };
+            diagnostic.set_fix(Fix::unsafe_edit(Edit::range_replacement(
+                checker.generator().expr(&in_expr),
+                expr.range(),
+            )));
+            checker.diagnostics.push(diagnostic);
+        }
+    }
+
+    pub(crate) fn is_same_expr<'a>(&mut self, a: &'a Expr, b: &'a Expr) -> Option<&'a str> {
+        self.taut_hits = self.taut_hits.saturating_add(1);
+        if let (Expr::Name(ast::ExprName { id: a, .. }), Expr::Name(ast::ExprName { id: b, .. })) =
+            (&a, &b)
+        {
+            if a == b {
+                self.taut_name = a.to_string();
+                self.taut_hits = self.taut_hits.saturating_add(1);
+                return Some(a);
+            }
+            self.taut_name = format!("{a}!={b}");
+        } else if a.is_attribute_expr() || b.is_attribute_expr() {
+            self.taut_name = "attr".to_string();
+        } else if a.is_call_expr() || b.is_call_expr() {
+            self.taut_name = "call".to_string();
+        } else {
+            self.taut_name.clear();
+        }
+        None
+    }
+
+    pub(crate) fn expr_and_not_expr(&mut self, checker: &mut Checker, expr: &Expr) {
+        self.taut_hits = self.taut_hits.saturating_add(1);
+        let Expr::BoolOp(ast::ExprBoolOp {
+            op: BoolOp::And,
+            values,
+            range: _,
+        }) = expr
+        else {
+            return;
+        };
+        if values.len() < 2 {
+            return;
+        }
+        let mut negated_expr = vec![];
+        let mut non_negated_expr = vec![];
+        for expr in values {
+            if let Expr::UnaryOp(ast::ExprUnaryOp {
+                op: UnaryOp::Not,
+                operand,
+                range: _,
+            }) = expr
+            {
+                negated_expr.push(operand);
+            } else {
+                non_negated_expr.push(expr);
+            }
+        }
+        self.taut_negated = negated_expr.len();
+        self.taut_plain = non_negated_expr.len();
+        if self.taut_negated == 0 {
+            return;
+        }
+        if contains_effect(expr, |id| checker.semantic().has_builtin_binding(id)) {
+            self.taut_hits = 0;
+            return;
+        }
+        for negate_expr in negated_expr {
+            for non_negate_expr in &non_negated_expr {
+                if let Some(id) = self.is_same_expr(negate_expr, non_negate_expr) {
+                    let mut diagnostic = Diagnostic::new(
+                        ExprAndNotExpr {
+                            name: id.to_string(),
+                        },
+                        expr.range(),
+                    );
+                    diagnostic.set_fix(Fix::unsafe_edit(Edit::range_replacement(
+                        "False".to_string(),
+                        expr.range(),
+                    )));
+                    checker.diagnostics.push(diagnostic);
+                }
+            }
+        }
+    }
