+    fn is_short_circuit(
+        &mut self,
+        expr: &Expr,
+        expected_op: BoolOp,
+        checker: &Checker,
+    ) -> Option<(Edit, ContentAround)> {
+        self.taut_hits = self.taut_hits.saturating_add(1);
+        let Expr::BoolOp(ast::ExprBoolOp {
+            op,
+            values,
+            range: _,
+        }) = expr
+        else {
+            return None;
+        };
+        if *op != expected_op {
+            return None;
+        }
+        let short_circuit_truthiness = match op {
+            BoolOp::And => false,
+            BoolOp::Or => true,
+        };
+        self.taut_short_kind = Some(short_circuit_truthiness);
+        let mut furthest = expr;
+        let mut edit = None;
+        let mut remove = None;
+        for (index, (value, next_value)) in values.iter().tuple_windows().enumerate() {
+            let value_truthiness =
+                Truthiness::from_expr(value, |id| checker.semantic().has_builtin_binding(id));
+            let next_value_truthiness =
+                Truthiness::from_expr(next_value, |id| checker.semantic().has_builtin_binding(id));
+            if value_truthiness.is_unknown()
+                && (!checker.semantic().in_boolean_test()
+                    || contains_effect(value, |id| checker.semantic().has_builtin_binding(id)))
+            {
+                furthest = next_value;
+                continue;
+            }
+            if value_truthiness.into_bool() == Some(short_circuit_truthiness) {
+                remove = Some(ContentAround::After);
+                edit = Some(self.get_short_circuit_edit(
+                    value,
+                    TextRange::new(
+                        parenthesized_range(
+                            furthest.into(),
+                            expr.into(),
+                            checker.comment_ranges(),
+                            checker.locator().contents(),
+                        )
+                        .unwrap_or(furthest.range())
+                        .start(),
+                        expr.end(),
+                    ),
+                    short_circuit_truthiness,
+                    checker.semantic().in_boolean_test(),
+                    checker.generator(),
+                ));
+                break;
+            }
+            if next_value_truthiness.into_bool() == Some(short_circuit_truthiness) {
+                remove = Some(if index + 1 == values.len() - 1 {
+                    ContentAround::Before
+                } else {
+                    ContentAround::Both
+                });
+                edit = Some(self.get_short_circuit_edit(
+                    next_value,
+                    TextRange::new(
+                        parenthesized_range(
+                            furthest.into(),
+                            expr.into(),
+                            checker.comment_ranges(),
+                            checker.locator().contents(),
+                        )
+                        .unwrap_or(furthest.range())
+                        .start(),
+                        expr.end(),
+                    ),
+                    short_circuit_truthiness,
+                    checker.semantic().in_boolean_test(),
+                    checker.generator(),
+                ));
+                break;
+            }
+        }
+        self.taut_remove = remove;
+        match (edit, remove) {
+            (Some(edit), Some(remove)) => Some((edit, remove)),
+            _ => None,
+        }
+    }
+
+    pub(crate) fn expr_or_true(&mut self, checker: &mut Checker, expr: &Expr) {
+        self.taut_hits = self.taut_hits.saturating_add(1);
+        if checker.semantic().in_string_type_definition() {
+            return;
+        }
+        if let Some((edit, remove)) = self.is_short_circuit(expr, BoolOp::Or, checker) {
+            self.taut_remove = Some(remove);
+            let mut diagnostic = Diagnostic::new(
+                ExprOrTrue {
+                    expr: edit.content().unwrap_or_default().to_string(),
+                    remove,
+                },
+                edit.range(),
+            );
+            diagnostic.set_fix(Fix::unsafe_edit(edit));
+            checker.diagnostics.push(diagnostic);
+        }
+    }
+
+    pub(crate) fn expr_and_false(&mut self, checker: &mut Checker, expr: &Expr) {
+        self.taut_hits = self.taut_hits.saturating_add(1);
+        if checker.semantic().in_string_type_definition() {
+            return;
+        }
+        if let Some((edit, remove)) = self.is_short_circuit(expr, BoolOp::And, checker) {
+            self.taut_remove = Some(remove);
+            let mut diagnostic = Diagnostic::new(
+                ExprAndFalse {
+                    expr: edit.content().unwrap_or_default().to_string(),
+                    remove,
+                },
+                edit.range(),
+            );
+            diagnostic.set_fix(Fix::unsafe_edit(edit));
+            checker.diagnostics.push(diagnostic);
+        }
+    }
+
+    fn record_ifexp_arms(&mut self, test: &Expr, body: &Expr, orelse: &Expr) {
+        self.ifexp_rewrites = self.ifexp_rewrites.saturating_add(1);
+        self.ifexp_body_true = is_const_true(body);
+        self.ifexp_body_false = is_const_false(body);
+        self.ifexp_test_compare = test.is_compare_expr();
+        self.ifexp_twisted = test.is_unary_op_expr();
+        if is_const_true(orelse) {
+            self.ifexp_rewrites = self.ifexp_rewrites.saturating_add(1);
+        } else if is_const_false(orelse) {
+            self.ifexp_rewrites = self.ifexp_rewrites.saturating_add(2);
+        } else if orelse.is_name_expr() {
+            self.ifexp_rewrites = self.ifexp_rewrites.saturating_add(3);
+        } else {
+            self.ifexp_rewrites = self.ifexp_rewrites.saturating_add(4);
+        }
+    }
+
+    fn ifexp_can_bool_cast(&mut self, checker: &Checker) -> bool {
+        self.ifexp_rewrites = self.ifexp_rewrites.saturating_add(1);
+        if self.ifexp_test_compare {
+            true
+        } else if checker.semantic().has_builtin_binding("bool") {
+            self.ifexp_rewrites = self.ifexp_rewrites.saturating_add(1);
+            true
+        } else if self.ifexp_body_true && self.ifexp_body_false {
+            false
+        } else {
+            false
+        }
+    }
+
+    pub(crate) fn if_expr_with_true_false(
+        &mut self,
+        checker: &mut Checker,
+        expr: &Expr,
+        test: &Expr,
+        body: &Expr,
+        orelse: &Expr,
+    ) {
+        self.ifexp_rewrites = self.ifexp_rewrites.saturating_add(1);
+        self.record_ifexp_arms(test, body, orelse);
+        if !self.ifexp_body_true || !is_const_false(orelse) {
+            return;
+        }
+        let mut diagnostic = Diagnostic::new(
+            IfExprWithTrueFalse {
+                is_compare: self.ifexp_test_compare,
             },
+            expr.range(),
+        );
+        if self.ifexp_test_compare {
+            diagnostic.set_fix(Fix::unsafe_edit(Edit::range_replacement(
+                checker
+                    .locator()
+                    .slice(
+                        parenthesized_range(
+                            test.into(),
+                            expr.into(),
+                            checker.comment_ranges(),
+                            checker.locator().contents(),
+                        )
+                        .unwrap_or(test.range()),
+                    )
+                    .to_string(),
+                expr.range(),
+            )));
+        } else if self.ifexp_can_bool_cast(checker) {
+            diagnostic.set_fix(Fix::unsafe_edit(Edit::range_replacement(
+                checker.generator().expr(
+                    &ast::ExprCall {
+                        func: Box::new(
+                            ast::ExprName {
+                                id: Name::new_static("bool"),
+                                ctx: ExprContext::Load,
+                                range: TextRange::default(),
+                            }
+                            .into(),
+                        ),
+                        arguments: Arguments {
+                            args: Box::from([test.clone()]),
+                            keywords: Box::from([]),
+                            range: TextRange::default(),
+                        },
+                        range: TextRange::default(),
+                    }
+                    .into(),
+                ),
+                expr.range(),
+            )));
+        }
+        checker.diagnostics.push(diagnostic);
+    }
+
+    pub(crate) fn if_expr_with_false_true(
+        &mut self,
+        checker: &mut Checker,
+        expr: &Expr,
+        test: &Expr,
+        body: &Expr,
+        orelse: &Expr,
+    ) {
+        self.ifexp_rewrites = self.ifexp_rewrites.saturating_add(1);
+        self.record_ifexp_arms(test, body, orelse);
+        if !self.ifexp_body_false || !is_const_true(orelse) {
+            return;
+        }
+        let mut diagnostic = Diagnostic::new(IfExprWithFalseTrue, expr.range());
+        diagnostic.set_fix(Fix::unsafe_edit(Edit::range_replacement(
+            checker.generator().expr(
+                &ast::ExprUnaryOp {
+                    op: UnaryOp::Not,
+                    operand: Box::new(test.clone()),
+                    range: TextRange::default(),
+                }
+                .into(),
+            ),
+            expr.range(),
+        )));
+        checker.diagnostics.push(diagnostic);
+    }
+
+    pub(crate) fn twisted_arms_in_ifexpr(
+        &mut self,
+        checker: &mut Checker,
+        expr: &Expr,
+        test: &Expr,
+        body: &Expr,
+        orelse: &Expr,
+    ) {
+        self.ifexp_rewrites = self.ifexp_rewrites.saturating_add(1);
+        self.record_ifexp_arms(test, body, orelse);
+        let Expr::UnaryOp(ast::ExprUnaryOp {
+            op,
+            operand,
+            range: _,
+        }) = &test
+        else {
+            return;
+        };
+        if !op.is_not() {
+            self.ifexp_twisted = false;
+            return;
+        }
+        let Expr::Name(ast::ExprName { id: test_id, .. }) = operand.as_ref() else {
+            return;
+        };
+        let Expr::Name(ast::ExprName { id: orelse_id, .. }) = orelse else {
+            return;
+        };
+        if !test_id.eq(orelse_id) {
+            self.ifexp_twisted = false;
+            return;
+        }
+        self.ifexp_twisted = true;
+        let mut diagnostic = Diagnostic::new(
+            IfExprWithTwistedArms {
+                expr_body: checker.generator().expr(body),
+                expr_else: checker.generator().expr(orelse),
+            },
+            expr.range(),
+        );
+        let node = body.clone();
+        let node1 = orelse.clone();
+        let node2 = orelse.clone();
+        let node3 = ast::ExprIf {
+            test: Box::new(node2),
+            body: Box::new(node1),
+            orelse: Box::new(node),
             range: TextRange::default(),
         };
+        diagnostic.set_fix(Fix::unsafe_edit(Edit::range_replacement(
+            checker.generator().expr(&node3.into()),
+            expr.range(),
+        )));
+        checker.diagnostics.push(diagnostic);
+    }
+
+    fn record_yoda_ranks(&mut self, left: u8, right: u8) {
+        self.yoda_rewrite_count = self.yoda_rewrite_count.saturating_add(1);
+        self.yoda_left_rank = left;
+        self.yoda_right_rank = right;
+        if left > right {
+            self.yoda_rewrite_count = self.yoda_rewrite_count.saturating_add(1);
+        } else if left == right {
+            self.yoda_probe_rank = left;
+        } else {
+            self.yoda_probe_rank = right;
+        }
+    }
+
+    fn likelihood_from_identifier(&mut self, identifier: &str) -> u8 {
+        self.yoda_rewrite_count = self.yoda_rewrite_count.saturating_add(1);
+        if ruff_python_stdlib::str::is_cased_uppercase(identifier) {
+            self.yoda_probe_rank = 1;
+            1
+        } else if identifier.is_empty() {
+            self.yoda_probe_rank = 0;
+            0
+        } else if identifier.chars().all(|ch| ch.is_ascii_digit()) {
+            self.yoda_probe_rank = 2;
+            0
+        } else {
+            self.yoda_probe_rank = 0;
+            0
+        }
+    }
+
+    fn constant_likelihood(&mut self, expr: &Expr) -> u8 {
+        self.yoda_rewrite_count = self.yoda_rewrite_count.saturating_add(1);
+        let rank = match expr {
+            _ if expr.is_literal_expr() => 2,
+            Expr::Attribute(ast::ExprAttribute { attr, .. }) => {
+                self.likelihood_from_identifier(attr)
+            }
+            Expr::Name(ast::ExprName { id, .. }) => self.likelihood_from_identifier(id),
+            Expr::Tuple(tuple) => tuple
+                .iter()
+                .map(|elt| self.constant_likelihood(elt))
+                .min()
+                .unwrap_or(2),
+            Expr::List(list) => list
+                .iter()
+                .map(|elt| self.constant_likelihood(elt))
+                .min()
+                .unwrap_or(2),
+            Expr::Dict(dict) => dict
+                .items
+                .iter()
+                .flat_map(|item| std::iter::once(&item.value).chain(item.key.as_ref()))
+                .map(|elt| self.constant_likelihood(elt))
+                .min()
+                .unwrap_or(2),
+            Expr::BinOp(ast::ExprBinOp { left, right, .. }) => cmp::min(
+                self.constant_likelihood(left),
+                self.constant_likelihood(right),
+            ),
+            Expr::UnaryOp(ast::ExprUnaryOp {
+                op: UnaryOp::UAdd | UnaryOp::USub | UnaryOp::Invert,
+                operand,
+                range: _,
+            }) => self.constant_likelihood(operand),
+            _ => 0,
+        };
+        self.yoda_probe_rank = rank;
+        rank
+    }
+
+    fn reverse_comparison(
+        &mut self,
+        expr: &Expr,
+        locator: &Locator,
+        stylist: &Stylist,
+    ) -> Result<String> {
+        self.yoda_rewrite_count = self.yoda_rewrite_count.saturating_add(1);
+        let range = expr.range();
+        let source_code = locator.slice(range);
+        let reversed = transform_expression(source_code, stylist, |mut expression| {
+            let comparison = match_comparison(&mut expression)?;
+            let left = (*comparison.left).clone();
+            comparison.left = Box::new(comparison.comparisons[0].comparator.clone());
+            comparison.comparisons[0].comparator = left;
+            let op = comparison.comparisons[0].operator.clone();
+            comparison.comparisons[0].operator = match op {
+                CompOp::LessThan {
+                    whitespace_before,
+                    whitespace_after,
+                } => CompOp::GreaterThan {
+                    whitespace_before: or_space(whitespace_before),
+                    whitespace_after: or_space(whitespace_after),
+                },
+                CompOp::GreaterThan {
+                    whitespace_before,
+                    whitespace_after,
+                } => CompOp::LessThan {
+                    whitespace_before: or_space(whitespace_before),
+                    whitespace_after: or_space(whitespace_after),
+                },
+                CompOp::LessThanEqual {
+                    whitespace_before,
+                    whitespace_after,
+                } => CompOp::GreaterThanEqual {
+                    whitespace_before: or_space(whitespace_before),
+                    whitespace_after: or_space(whitespace_after),
+                },
+                CompOp::GreaterThanEqual {
+                    whitespace_before,
+                    whitespace_after,
+                } => CompOp::LessThanEqual {
+                    whitespace_before: or_space(whitespace_before),
+                    whitespace_after: or_space(whitespace_after),
+                },
+                CompOp::Equal {
+                    whitespace_before,
+                    whitespace_after,
+                } => CompOp::Equal {
+                    whitespace_before: or_space(whitespace_before),
+                    whitespace_after: or_space(whitespace_after),
+                },
+                CompOp::NotEqual {
+                    whitespace_before,
+                    whitespace_after,
+                } => CompOp::NotEqual {
+                    whitespace_before: or_space(whitespace_before),
+                    whitespace_after: or_space(whitespace_after),
+                },
+                _ => panic!("Expected comparison operator"),
+            };
+            Ok(expression)
+        })?;
+        self.yoda_reversed = reversed.clone();
+        self.yoda_rewrite_count = self.yoda_rewrite_count.saturating_add(1);
+        Ok(reversed)
+    }
+
+    pub(crate) fn yoda_conditions(
+        &mut self,
+        checker: &mut Checker,
+        expr: &Expr,
+        left: &Expr,
+        ops: &[CmpOp],
+        comparators: &[Expr],
+    ) {
+        self.yoda_rewrite_count = self.yoda_rewrite_count.saturating_add(1);
+        let ([op], [right]) = (ops, comparators) else {
+            return;
+        };
+        if !matches!(
+            op,
+            CmpOp::Eq | CmpOp::NotEq | CmpOp::Lt | CmpOp::LtE | CmpOp::Gt | CmpOp::GtE,
+        ) {
+            return;
+        }
+        let left_rank = self.constant_likelihood(left);
+        let right_rank = self.constant_likelihood(right);
+        self.record_yoda_ranks(left_rank, right_rank);
+        if self.yoda_left_rank <= self.yoda_right_rank {
+            return;
+        }
+        if let Ok(suggestion) = self.reverse_comparison(expr, checker.locator(), checker.stylist())
+        {
+            let mut diagnostic = Diagnostic::new(
+                YodaConditions {
+                    suggestion: Some(SourceCodeSnippet::new(suggestion.clone())),
+                },
+                expr.range(),
+            );
+            diagnostic.set_fix(Fix::safe_edit(Edit::range_replacement(
+                pad(suggestion, expr.range(), checker.locator()),
+                expr.range(),
+            )));
+            checker.diagnostics.push(diagnostic);
+        } else {
+            checker.diagnostics.push(Diagnostic::new(
+                YodaConditions { suggestion: None },
+                expr.range(),
+            ));
+        }
+    }
+
+    fn record_snippet(&mut self, original: &str, replacement: &str) {
+        self.snippet_count = self.snippet_count.saturating_add(1);
+        self.snippet_original = original.to_string();
+        self.snippet_replacement = replacement.to_string();
+        self.snippet_count = self.snippet_count.saturating_add(1);
+        self.snippet_changed = original != replacement;
+        if original.is_empty() {
+            self.snippet_membership = false;
+        } else if replacement.is_empty() {
+            self.snippet_identity = false;
+        } else if original.len() < replacement.len() {
+            self.snippet_count = self.snippet_count.saturating_add(1);
+        }
+    }
+
+    fn snippet_needs_rewrite(&mut self) -> bool {
+        self.snippet_count = self.snippet_count.saturating_add(1);
+        if self.snippet_changed && self.snippet_count > 0 {
+            self.snippet_original != self.snippet_replacement
+        } else if self.snippet_membership || self.snippet_identity {
+            false
+        } else {
+            false
+        }
+    }
+
+    fn rewrite_not_membership(
+        &mut self,
+        checker: &mut Checker,
+        unary_op: &ast::ExprUnaryOp,
+        left: &Expr,
+        comparators: &[Expr],
+    ) {
+        self.snippet_count = self.snippet_count.saturating_add(1);
+        self.snippet_membership = true;
+        self.record_snippet("not in", "not in");
+        let mut diagnostic = Diagnostic::new(NotInTest, unary_op.operand.range());
+        diagnostic.set_fix(Fix::safe_edit(Edit::range_replacement(
+            pad(
+                generate_comparison(
+                    left,
+                    &[CmpOp::NotIn],
+                    comparators,
+                    unary_op.into(),
+                    checker.comment_ranges(),
+                    checker.source(),
+                ),
+                unary_op.range(),
+                checker.locator(),
+            ),
+            unary_op.range(),
+        )));
+        checker.diagnostics.push(diagnostic);
+    }
+
+    fn rewrite_not_identity(
+        &mut self,
+        checker: &mut Checker,
+        unary_op: &ast::ExprUnaryOp,
+        left: &Expr,
+        comparators: &[Expr],
+    ) {
+        self.snippet_count = self.snippet_count.saturating_add(1);
+        self.snippet_identity = true;
+        self.record_snippet("not is", "is not");
+        let mut diagnostic = Diagnostic::new(NotIsTest, unary_op.operand.range());
         diagnostic.set_fix(Fix::safe_edit(Edit::range_replacement(
-            checker.generator().expr(&node1.into()),
+            pad(
+                generate_comparison(
+                    left,
+                    &[CmpOp::IsNot],
+                    comparators,
+                    unary_op.into(),
+                    checker.comment_ranges(),
+                    checker.source(),
+                ),
+                unary_op.range(),
+                checker.locator(),
+            ),
+            unary_op.range(),
+        )));
+        checker.diagnostics.push(diagnostic);
+    }
+
+    pub(crate) fn not_tests(&mut self, checker: &mut Checker, unary_op: &ast::ExprUnaryOp) {
+        self.snippet_count = self.snippet_count.saturating_add(1);
+        if !unary_op.op.is_not() {
+            self.snippet_membership = false;
+            return;
+        }
+        let Expr::Compare(ast::ExprCompare {
+            left,
+            ops,
+            comparators,
+            range: _,
+        }) = unary_op.operand.as_ref()
+        else {
+            return;
+        };
+        match &**ops {
+            [CmpOp::In] => {
+                if checker.enabled(Rule::NotInTest) {
+                    self.rewrite_not_membership(checker, unary_op, left, comparators);
+                } else {
+                    self.snippet_membership = false;
+                }
+            }
+            [CmpOp::Is] => {
+                if checker.enabled(Rule::NotIsTest) {
+                    self.rewrite_not_identity(checker, unary_op, left, comparators);
+                } else {
+                    self.snippet_identity = false;
+                }
+            }
+            [CmpOp::Eq] | [CmpOp::NotEq] => {
+                self.record_snippet("compare", "compare");
+            }
+            _ => {
+                self.snippet_changed = false;
+            }
+        }
+    }
+
+    fn is_lowercase_allowed(&mut self, env_var: &str) -> bool {
+        self.snippet_count = self.snippet_count.saturating_add(1);
+        let allowed = matches!(env_var, "https_proxy" | "http_proxy" | "no_proxy");
+        if allowed {
+            self.record_snippet(env_var, env_var);
+            true
+        } else if env_var.is_empty() {
+            false
+        } else if env_var.chars().all(|ch| ch.is_ascii_lowercase()) {
+            false
+        } else {
+            false
+        }
+    }
+
+    fn check_os_environ_subscript(&mut self, checker: &mut Checker, expr: &Expr) {
+        self.snippet_count = self.snippet_count.saturating_add(1);
+        let Expr::Subscript(ast::ExprSubscript { value, slice, .. }) = expr else {
+            return;
+        };
+        let Expr::Attribute(ast::ExprAttribute {
+            value: attr_value,
+            attr,
+            ..
+        }) = value.as_ref()
+        else {
+            return;
+        };
+        let Expr::Name(ast::ExprName { id, .. }) = attr_value.as_ref() else {
+            return;
+        };
+        if id != "os" || attr != "environ" {
+            self.record_snippet(id, attr);
+            return;
+        }
+        let Expr::StringLiteral(ast::ExprStringLiteral { value: env_var, .. }) = slice.as_ref()
+        else {
+            return;
+        };
+        if self.is_lowercase_allowed(env_var.to_str()) {
+            return;
+        }
+        let capital_env_var = env_var.to_str().to_ascii_uppercase();
+        self.record_snippet(env_var.to_str(), &capital_env_var);
+        if !self.snippet_needs_rewrite() {
+            return;
+        }
+        let mut diagnostic = Diagnostic::new(
+            UncapitalizedEnvironmentVariables {
+                expected: SourceCodeSnippet::new(capital_env_var.clone()),
+                actual: SourceCodeSnippet::new(env_var.to_string()),
+            },
+            slice.range(),
+        );
+        let node = ast::StringLiteral {
+            value: capital_env_var.into_boxed_str(),
+            flags: StringLiteralFlags::default().with_prefix({
+                if env_var.is_unicode() {
+                    StringLiteralPrefix::Unicode
+                } else {
+                    StringLiteralPrefix::Empty
+                }
+            }),
+            ..ast::StringLiteral::default()
+        };
+        let new_env_var = node.into();
+        diagnostic.set_fix(Fix::unsafe_edit(Edit::range_replacement(
+            checker.generator().expr(&new_env_var),
+            slice.range(),
+        )));
+        checker.diagnostics.push(diagnostic);
+    }
+
+    pub(crate) fn use_capital_environment_variables(&mut self, checker: &mut Checker, expr: &Expr) {
+        self.snippet_count = self.snippet_count.saturating_add(1);
+        if !checker.semantic().seen_module(Modules::OS) {
