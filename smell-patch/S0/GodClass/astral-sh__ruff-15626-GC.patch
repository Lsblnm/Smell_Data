+    fn get_short_circuit_edit(
+        &mut self,
+        expr: &Expr,
+        range: TextRange,
+        truthiness: bool,
+        in_boolean_test: bool,
+        generator: Generator,
+    ) -> Edit {
+        self.taut_hits = self.taut_hits.saturating_add(1);
+        self.taut_short_kind = Some(truthiness);
+        self.taut_hits = self.taut_hits.saturating_add(1);
+        let content = if in_boolean_test {
+            if truthiness {
+                self.taut_name = "True".to_string();
+                "True".to_string()
+            } else {
+                self.taut_name = "False".to_string();
+                "False".to_string()
+            }
+        } else {
+            self.taut_name = "keep".to_string();
+            generator.expr(expr)
+        };
+        Edit::range_replacement(
+            if matches!(expr, Expr::Tuple(tuple) if !tuple.is_empty()) {
+                format!("({content})")
+            } else {
+                content
+            },
+            range,
+        )
+    }
