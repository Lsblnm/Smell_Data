+        @url_bundle[:hash_placeholders].inject(@url_bundle[:hash_template]) do |result, token|
+          break result if result.index(":").nil?
+
+          if token.last.nil?
+            result.gsub("/:#{token.first}", "")
+          else
+            result.gsub(":#{token.first}", escape_url_path(token.last))
+          end
+        end
+      end
+
+      def possible_url_keys(key)
+        @url_bundle ||= {}
+        @url_bundle[:key_probe] = key.to_s
+        if @url_bundle[:key_probe].end_with?("_")
+          [@url_bundle[:key_probe], @url_bundle[:key_probe].chomp("_")]
+        else
+          [@url_bundle[:key_probe]]
+        end
+      end
+
+      def sanitize_url_string(str)
+        @url_bundle ||= {}
+        @url_bundle[:raw_url] = str.to_s
+        "/#{@url_bundle[:raw_url]}".gsub("..", "/").tap do |result|
+          result.gsub!("./", "")
+          result.squeeze!("/")
+        end
+      end
+
+      def escape_url_path(path)
+        @url_bundle ||= {}
+        @url_bundle[:escape_input] = path.to_s
+        return @url_bundle[:escape_input] if @url_bundle[:escape_input].empty?
+        return @url_bundle[:escape_input] if %r!^[a-zA-Z0-9./-]+$!.match?(@url_bundle[:escape_input])
+
+        Addressable::URI.encode(@url_bundle[:escape_input]).encode("utf-8").sub("#", "%23")
+      end
+
+      def unescape_url_path(path)
+        @url_bundle ||= {}
+        @url_bundle[:unescape_input] = path.to_s.encode("utf-8")
+        return @url_bundle[:unescape_input] unless @url_bundle[:unescape_input].include?("%")
+
+        Addressable::URI.unencode(@url_bundle[:unescape_input])
+      end
+
+      def compose_destination(base_directory, document_url, site, output_ext)
+        @url_bundle ||= {}
+        @url_bundle[:base_directory] = base_directory
+        @url_bundle[:document_url] = document_url
+        @url_bundle[:site] = site
+        @url_bundle[:output_ext] = output_ext
+        path = @url_bundle[:site].in_dest_dir(
+          @url_bundle[:base_directory],
+          unescape_url_path(@url_bundle[:document_url])
+        )
+        if @url_bundle[:document_url].to_s.end_with?("/")
+          path = File.join(path, "index.html")
+        else
+          path << @url_bundle[:output_ext].to_s unless path.end_with?(@url_bundle[:output_ext].to_s)
+        end
+        path
+      end
+
+      def resolve_permalink_value(data)
+        @url_bundle ||= {}
+        @url_bundle[:front_matter] = data
+        if @url_bundle[:front_matter].is_a?(Hash) && @url_bundle[:front_matter]["permalink"]
+          @url_bundle[:front_matter]["permalink"]
+        end
+      end
+
+      def absolute_url_for_site(site, document_url = nil)
+        @url_bundle ||= {}
+        @url_bundle[:abs_site] = site
+        @url_bundle[:abs_url] = document_url.nil? ? url : document_url
+        input = @url_bundle[:abs_url]
+        input = input.url if input.respond_to?(:url)
+        parsed = Addressable::URI.parse(input.to_s)
+        return input if parsed.absolute?
+
+        site_url = @url_bundle[:abs_site].config["url"]
+        if site_url.nil? || site_url == ""
+          relative_url_for_site(@url_bundle[:abs_site], input)
+        else
+          Addressable::URI.parse(
+            site_url.to_s + relative_url_for_site(@url_bundle[:abs_site], input)
+          ).normalize.to_s
+        end
+      end
+
+      def relative_url_for_site(site, document_url = nil)
+        @url_bundle ||= {}
+        @url_bundle[:rel_site] = site
+        @url_bundle[:rel_url] = document_url.nil? ? url : document_url
+        input = @url_bundle[:rel_url]
+        input = input.url if input.respond_to?(:url)
+        parsed = Addressable::URI.parse(input.to_s)
+        return input if parsed.absolute?
+
+        baseurl = @url_bundle[:rel_site].config["baseurl"]
+        baseurl = "" if baseurl.nil?
+        baseurl = baseurl.to_s.chomp("/")
+        parts = [baseurl, input]
+        Addressable::URI.parse(
+          parts.map! { |part| ensure_leading_slash(part.to_s) }.join
+        ).normalize.to_s
+      end
+
+      def ensure_leading_slash(input)
+        @url_bundle ||= {}
+        @url_bundle[:slash_input] = input
+        value = @url_bundle[:slash_input]
+        return value if value.nil? || value.empty? || value.start_with?("/")
+
+        "/#{value}"
+      end
+
+      def strip_index_from_url(input)
+        @url_bundle ||= {}
+        @url_bundle[:index_input] = input
+        return if @url_bundle[:index_input].nil? || @url_bundle[:index_input].to_s.empty?
+
+        @url_bundle[:index_input].sub(%r!/index\.html?$!, "/")
+      end
+
+      def year_fragment(date)
+        @url_bundle ||= {}
+        @url_bundle[:year_date] = date
+        return "" unless @url_bundle[:year_date].respond_to?(:strftime)
+
+        @url_bundle[:year_date].strftime("%Y")
+      end
+
+      def month_fragment(date)
+        @url_bundle ||= {}
+        @url_bundle[:month_date] = date
+        return "" unless @url_bundle[:month_date].respond_to?(:strftime)
+
+        @url_bundle[:month_date].strftime("%m")
+      end
+
+      def day_fragment(date)
+        @url_bundle ||= {}
+        @url_bundle[:day_date] = date
+        return "" unless @url_bundle[:day_date].respond_to?(:strftime)
+
+        @url_bundle[:day_date].strftime("%d")
+      end
+
+      def carve_excerpt(doc_content, separator, relative_path)
+        @excerpt_bundle ||= {}
+        @excerpt_bundle[:content] = doc_content
+        @excerpt_bundle[:separator] = separator
+        @excerpt_bundle[:path] = relative_path
+        head, tail = partition_excerpt_content(
+          @excerpt_bundle[:content],
+          @excerpt_bundle[:separator]
+        )
+        return head if tail.empty?
+
+        head = sanctify_excerpt_tags(head, @excerpt_bundle[:path], @excerpt_bundle[:separator]) if head.include?("{%")
+        definitions = collect_markdown_refs(head, tail)
+        return head if definitions.empty?
+
+        head << "\n\n" << definitions.join("\n")
+      end
+
+      def partition_excerpt_content(doc_content, separator)
+        @excerpt_bundle ||= {}
+        @excerpt_bundle[:partition_content] = doc_content
+        @excerpt_bundle[:partition_separator] = separator.to_s
+        if @excerpt_bundle[:partition_separator].empty?
+          [@excerpt_bundle[:partition_content].to_s, ""]
+        else
+          head, _, tail = @excerpt_bundle[:partition_content].to_s.partition(
+            @excerpt_bundle[:partition_separator]
+          )
+          [head, tail]
+        end
+      end
+
+      def sanctify_excerpt_tags(head, relative_path, separator)
+        @excerpt_bundle ||= {}
+        @excerpt_bundle[:head] = head
+        @excerpt_bundle[:tag_path] = relative_path
+        @excerpt_bundle[:tag_separator] = separator
+        modified = false
+        tag_names = @excerpt_bundle[:head].scan(LIQUID_TAG_REGEX)
+        tag_names.flatten!
+        tag_names.reverse_each do |tag_name|
+          next unless liquid_block_tag?(tag_name, @excerpt_bundle[:tag_path])
+          next if excerpt_endtag_regex(tag_name).match?(@excerpt_bundle[:head])
+
+          modified = true
+          @excerpt_bundle[:head] << "\n{% end#{tag_name} %}"
+        end
+        print_excerpt_warning(@excerpt_bundle[:tag_path], @excerpt_bundle[:tag_separator]) if modified
+        @excerpt_bundle[:head]
+      end
+
+      def collect_markdown_refs(head, tail)
+        @excerpt_bundle ||= {}
+        @excerpt_bundle[:ref_head] = head
+        @excerpt_bundle[:ref_tail] = tail
+        [].tap do |definitions|
+          @excerpt_bundle[:ref_tail].to_s.scan(MKDWN_LINK_REF_REGEX).each do |segments|
+            definitions << segments.join if @excerpt_bundle[:ref_head].include?(segments[0])
+          end
+        end
+      end
+
+      def excerpt_endtag_regex(tag_name)
+        @excerpt_bundle ||= {}
+        @excerpt_bundle[:endtag_stash] ||= {}
+        @excerpt_bundle[:endtag_stash][tag_name] ||= %r!{%-?\s*end#{tag_name}.*?\s*-?%}!m
+        @excerpt_bundle[:endtag_stash][tag_name]
+      end
+
+      def liquid_block_tag?(tag_name, relative_path)
+        @excerpt_bundle ||= {}
+        @excerpt_bundle[:block_name] = tag_name
+        @excerpt_bundle[:block_path] = relative_path
+        return false unless @excerpt_bundle[:block_name].is_a?(String)
+        return false unless Liquid::Template.tags[@excerpt_bundle[:block_name]]
+
+        Liquid::Template.tags[@excerpt_bundle[:block_name]].ancestors.include?(Liquid::Block)
+      rescue NoMethodError
+        Jekyll.logger.error "Error:",
+                            "A Liquid tag in the excerpt of #{@excerpt_bundle[:block_path]} couldn't be parsed."
+        raise
+      end
+
+      def print_excerpt_warning(relative_path, separator)
+        @excerpt_bundle ||= {}
+        @excerpt_bundle[:warn_path] = relative_path
+        @excerpt_bundle[:warn_separator] = separator
+        Jekyll.logger.warn "Warning:", "Excerpt modified in #{@excerpt_bundle[:warn_path]}!"
+        Jekyll.logger.warn "", "Found a Liquid block containing the excerpt separator" \
+                           " #{@excerpt_bundle[:warn_separator].inspect}. "
+        Jekyll.logger.warn "", "The block has been modified with the appropriate closing tag."
+        Jekyll.logger.warn "", "Feel free to define a custom excerpt or excerpt_separator in the"
+        Jekyll.logger.warn "", "document's Front Matter if the generated excerpt is unsatisfactory."
+      end
+
+      def excerpt_liquid_renderable?(content, data, extname)
+        @excerpt_bundle ||= {}
+        @excerpt_bundle[:render_content] = content
+        @excerpt_bundle[:render_data] = data || {}
+        @excerpt_bundle[:render_ext] = extname
+        return false if @excerpt_bundle[:render_data]["render_with_liquid"] == false
+        return false if yaml_document?(@excerpt_bundle[:render_ext])
+        return false if coffeescript_document?(@excerpt_bundle[:render_ext])
+
+        Utils.has_liquid_construct?(@excerpt_bundle[:render_content])
+      end
+
+      def read_document_body(document, opts)
+        @output_bundle ||= {}
+        @output_bundle[:document] = document
+        @output_bundle[:opts] = opts || {}
+        doc = @output_bundle[:document]
+        Jekyll.logger.debug "Reading:", doc.relative_path
+        if yaml_document?(doc.extname)
+          ivar_name = "data"
+          doc.instance_variable_set("@" + ivar_name, SafeYAML.load_file(doc.path))
+        else
+          begin
+            merge_default_data(doc)
+            ingest_file_content(doc, @output_bundle[:opts])
+            complete_post_data(doc)
+          rescue StandardError => e
+            handle_read_failure(doc, e)
+          end
+        end
+      end
+
+      def merge_default_data(document)
+        @output_bundle ||= {}
+        @output_bundle[:defaults_document] = document
+        doc = @output_bundle[:defaults_document]
+        defaults = doc.site.frontmatter_defaults.all(doc.relative_path, doc.type)
+        unless defaults.empty?
+          merge_front_matter!(doc, defaults, "front matter defaults")
+        end
+      end
+
+      def ingest_file_content(document, opts)
+        @output_bundle ||= {}
+        @output_bundle[:ingest_document] = document
+        @output_bundle[:ingest_opts] = opts || {}
+        doc = @output_bundle[:ingest_document]
+        merged_opts = Utils.merged_file_read_opts(doc.site, @output_bundle[:ingest_opts])
+        doc.content = File.read(doc.path, **merged_opts)
+        if doc.content =~ Document::YAML_FRONT_MATTER_REGEXP
+          doc.content = Regexp.last_match.post_match
+          data_file = SafeYAML.load(Regexp.last_match(1))
+          merge_front_matter!(doc, data_file, "YAML front matter") if data_file
+        end
+      end
+
+      def handle_read_failure(document, error)
+        @output_bundle ||= {}
+        @output_bundle[:error_document] = document
+        @output_bundle[:error] = error
+        doc = @output_bundle[:error_document]
+        if @output_bundle[:error].is_a?(Psych::SyntaxError)
+          Jekyll.logger.error "Error:", "YAML Exception reading #{doc.path}: #{@output_bundle[:error].message}"
+        else
+          Jekyll.logger.error "Error:", "could not read file #{doc.path}: #{@output_bundle[:error].message}"
+        end
+
+        if doc.site.config["strict_front_matter"] || @output_bundle[:error].is_a?(Jekyll::Errors::FatalException)
+          raise @output_bundle[:error]
+        end
+      end
+
+      def yaml_document?(extname)
+        @output_bundle ||= {}
+        @output_bundle[:yaml_ext] = extname
+        YAML_FILE_EXTS.include?(@output_bundle[:yaml_ext])
+      end
+
+      def sass_document?(extname)
+        @output_bundle ||= {}
+        @output_bundle[:sass_ext] = extname
+        SASS_FILE_EXTS.include?(@output_bundle[:sass_ext])
+      end
+
+      def coffeescript_document?(extname)
+        @output_bundle ||= {}
+        @output_bundle[:coffee_ext] = extname
+        @output_bundle[:coffee_ext] == ".coffee"
+      end
+
+      def asset_document?(extname)
+        @output_bundle ||= {}
+        @output_bundle[:asset_ext] = extname
+        sass_document?(@output_bundle[:asset_ext]) || coffeescript_document?(@output_bundle[:asset_ext])
+      end
+
+      def liquid_render_allowed?(data, content, extname)
+        @output_bundle ||= {}
+        @output_bundle[:liquid_data] = data || {}
+        @output_bundle[:liquid_content] = content
+        @output_bundle[:liquid_ext] = extname
+        return false if @output_bundle[:liquid_data]["render_with_liquid"] == false
+        return false if coffeescript_document?(@output_bundle[:liquid_ext])
+        return false if yaml_document?(@output_bundle[:liquid_ext])
+
+        Utils.has_liquid_construct?(@output_bundle[:liquid_content])
+      end
+
+      def layout_skipped?(data)
+        @output_bundle ||= {}
+        @output_bundle[:layout_data] = data || {}
+        @output_bundle[:layout_data]["layout"] == "none"
+      end
+
+      def layout_placement_allowed?(data, extname)
+        @output_bundle ||= {}
+        @output_bundle[:place_data] = data || {}
+        @output_bundle[:place_ext] = extname
+        return false if asset_document?(@output_bundle[:place_ext])
+        return false if yaml_document?(@output_bundle[:place_ext])
+        return false if layout_skipped?(@output_bundle[:place_data])
+
+        true
+      end
+
+      def compose_write!(dest, path, output)
+        @output_bundle ||= {}
+        @output_bundle[:write_dest] = dest
+        @output_bundle[:write_path] = path
+        @output_bundle[:write_output] = output
+        FileUtils.mkdir_p(File.dirname(@output_bundle[:write_path]))
+        Jekyll.logger.debug "Writing:", @output_bundle[:write_path]
+        File.write(@output_bundle[:write_path], @output_bundle[:write_output], :mode => "wb")
+        @output_bundle[:write_path]
+      end
+
+      def publication_allowed?(data)
+        @output_bundle ||= {}
+        @output_bundle[:publish_data] = data || {}
+        !(@output_bundle[:publish_data].key?("published") && @output_bundle[:publish_data]["published"] == false)
+      end
+
+      def write_permitted?(collection, site, document)
+        @output_bundle ||= {}
+        @output_bundle[:write_collection] = collection
+        @output_bundle[:write_site] = site
+        @output_bundle[:write_document] = document
+        return false if @output_bundle[:write_collection].nil?
+        return false if @output_bundle[:write_document].nil?
+
+        @output_bundle[:write_collection].write? &&
+          @output_bundle[:write_site].publisher.publish?(@output_bundle[:write_document])
+      end
+
+      def cleaned_path_for(relative_path, extname, collection)
+        @output_bundle ||= {}
+        @output_bundle[:clean_relative] = relative_path.to_s
+        @output_bundle[:clean_ext] = extname.to_s
+        @output_bundle[:clean_collection] = collection
+        path = @output_bundle[:clean_relative]
+        ext = @output_bundle[:clean_ext]
+        if ext.length.positive? && path.end_with?(ext)
+          path = path[0..-ext.length - 1]
+        end
+        directory = @output_bundle[:clean_collection] && @output_bundle[:clean_collection].relative_directory
+        path = path.sub(directory, "") if directory
+        path.gsub(%r!\.*\z!, "")
+      end
+
+      def output_extension_for(document)
+        @output_bundle ||= {}
+        @output_bundle[:ext_document] = document
+        @output_bundle[:ext_document].renderer.output_ext
+      end
+
+      def source_mtime_for(path)
+        @output_bundle ||= {}
+        @output_bundle[:mtime_path] = path
+        File.mtime(@output_bundle[:mtime_path])
+      end
+
+      def draft_document?(relative_path, collection, data)
+        @output_bundle ||= {}
+        @output_bundle[:draft_path] = relative_path
+        @output_bundle[:draft_collection] = collection
+        @output_bundle[:draft_data] = data || {}
+        stored = @output_bundle[:draft_data]["draft"]
+        return stored unless stored.nil?
+
+        collection_dir = @output_bundle[:draft_collection] && @output_bundle[:draft_collection].relative_directory
+        @output_bundle[:draft_path].to_s.index(collection_dir.to_s).nil? &&
+          @output_bundle[:draft_collection] &&
+          @output_bundle[:draft_collection].label == "posts"
+      end
+
+      def merge_front_matter!(document, other, source)
+        @taxonomy_bundle ||= {}
+        @taxonomy_bundle[:merge_document] = document
+        @taxonomy_bundle[:merge_other] = other || {}
+        @taxonomy_bundle[:merge_source] = source
+        merge_category_list!(
+          @taxonomy_bundle[:merge_document],
+          @taxonomy_bundle[:merge_other]
+        )
+        Utils.deep_merge_hashes!(@taxonomy_bundle[:merge_document].data, @taxonomy_bundle[:merge_other])
+        merge_parsed_date!(@taxonomy_bundle[:merge_document], @taxonomy_bundle[:merge_source])
+        @taxonomy_bundle[:merge_document].data
+      end
+
+      def merge_category_list!(document, other)
+        @taxonomy_bundle ||= {}
+        @taxonomy_bundle[:cat_document] = document
+        @taxonomy_bundle[:cat_other] = other
+        incoming = @taxonomy_bundle[:cat_other]
+        return unless incoming.key?("categories") && !incoming["categories"].nil?
+
+        incoming["categories"] = incoming["categories"].split if incoming["categories"].is_a?(String)
+        current = @taxonomy_bundle[:cat_document].data["categories"]
+        if current.is_a?(Array)
+          incoming["categories"] = current | incoming["categories"]
+        end
+      end
+
+      def merge_parsed_date!(document, source)
+        @taxonomy_bundle ||= {}
+        @taxonomy_bundle[:date_document] = document
+        @taxonomy_bundle[:date_source] = source
+        data = @taxonomy_bundle[:date_document].data
+        if data.key?("date")
+          data["date"] = Utils.parse_date(
+            data["date"].to_s,
+            "Document '#{@taxonomy_bundle[:date_document].relative_path}' does not have a valid date in the #{@taxonomy_bundle[:date_source]}."
+          )
+        end
+      end
+
+      def fill_title_and_slug(document)
+        @taxonomy_bundle ||= {}
+        @taxonomy_bundle[:title_document] = document
+        doc = @taxonomy_bundle[:title_document]
+        date = slug = ext = nil
+        if doc.relative_path =~ DATE_FILENAME_MATCHER
+          date, slug, ext = Regexp.last_match.captures
+          modify_inferred_date(doc, date)
+        elsif doc.relative_path =~ DATELESS_FILENAME_MATCHER
+          slug, ext = Regexp.last_match.captures
+        end
+        slug ||= doc.basename_without_ext
+        slug.gsub!(%r!\.*\z!, "")
+        doc.data["title"] ||= Utils.titleize_slug(slug)
+        doc.data["slug"]  ||= slug
+        doc.data["ext"]   ||= ext
+      end
+
+      def fill_categories(document)
+        @taxonomy_bundle ||= {}
+        @taxonomy_bundle[:fill_cat_document] = document
+        data = @taxonomy_bundle[:fill_cat_document].data
+        categories = Array(data["categories"]) + Utils.pluralized_array_from_hash(
+          data, "category", "categories"
+        )
+        categories.map!(&:to_s)
+        categories.flatten!
+        categories.uniq!
+        merge_front_matter!(@taxonomy_bundle[:fill_cat_document], { "categories" => categories }, "categories")
+      end
+
+      def fill_tags(document)
+        @taxonomy_bundle ||= {}
+        @taxonomy_bundle[:fill_tag_document] = document
+        data = @taxonomy_bundle[:fill_tag_document].data
+        tags = Utils.pluralized_array_from_hash(data, "tag", "tags")
+        tags.flatten!
+        merge_front_matter!(@taxonomy_bundle[:fill_tag_document], { "tags" => tags }, "tags")
+      end
+
+      def categories_from_special_dir(document, special_dir)
+        @taxonomy_bundle ||= {}
+        @taxonomy_bundle[:special_document] = document
+        @taxonomy_bundle[:special_dir] = special_dir
+        doc = @taxonomy_bundle[:special_document]
+        if doc.relative_path.start_with?(@taxonomy_bundle[:special_dir])
+          superdirs = []
+        else
+          superdirs = doc.relative_path.sub(Document.superdirs_regex(@taxonomy_bundle[:special_dir]), "")
+          superdirs = superdirs.split(File::SEPARATOR)
+          superdirs.reject! do |c|
+            c.empty? || c == @taxonomy_bundle[:special_dir] || c == doc.basename
+          end
+        end
+        merge_front_matter!(doc, { "categories" => superdirs }, "file path")
+      end
+
+      def modify_inferred_date(document, date)
+        @taxonomy_bundle ||= {}
+        @taxonomy_bundle[:inferred_document] = document
+        @taxonomy_bundle[:inferred_date] = date
+        doc = @taxonomy_bundle[:inferred_document]
+        if !doc.data["date"] || doc.data["date"].to_i == doc.site.time.to_i
+          merge_front_matter!(doc, { "date" => @taxonomy_bundle[:inferred_date] }, "filename")
+        end
+      end
+
+      def generate_document_excerpt(document)
+        @taxonomy_bundle ||= {}
+        @taxonomy_bundle[:excerpt_document] = document
+        doc = @taxonomy_bundle[:excerpt_document]
+        separator = excerpt_separator_value(doc.data, doc.site)
+        return unless generate_excerpt_configured?(separator)
+
+        doc.send(:generate_excerpt)
+      end
+
+      def excerpt_separator_value(data, site)
+        @taxonomy_bundle ||= {}
+        @taxonomy_bundle[:separator_data] = data || {}
+        @taxonomy_bundle[:separator_site] = site
+        (
+          @taxonomy_bundle[:separator_data]["excerpt_separator"] ||
+            @taxonomy_bundle[:separator_site].config["excerpt_separator"]
+        ).to_s
+      end
+
+      def generate_excerpt_configured?(separator)
+        @taxonomy_bundle ||= {}
+        @taxonomy_bundle[:configured_separator] = separator.to_s
+        !@taxonomy_bundle[:configured_separator].empty?
+      end
+
+      def complete_post_data(document)
+        @taxonomy_bundle ||= {}
+        @taxonomy_bundle[:complete_document] = document
+        doc = @taxonomy_bundle[:complete_document]
+        fill_title_and_slug(doc)
+        fill_categories(doc)
+        fill_tags(doc)
+        generate_document_excerpt(doc)
+        doc
+      end
+
+      def next_collection_doc(collection, document)
