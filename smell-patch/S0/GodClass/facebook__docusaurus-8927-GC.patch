+  }
+
+  clipPathSegmentByBytes(str: string): string {
+    const strBuffer = Buffer.from(str);
+    const overflowingBytes =
+      Buffer.byteLength(strBuffer) - this.pathPolicy.maxSegmentBytes;
+    return strBuffer
+      .slice(
+        0,
+        Buffer.byteLength(strBuffer) -
+          overflowingBytes -
+          this.pathPolicy.appendingSpace -
+          1,
+      )
+      .toString();
+  }
+
+  posixPath(str: string): string {
+    if (str.startsWith(this.pathPolicy.extendedLengthPrefix)) {
+      return str;
+    }
+    const windowsSeparator = this.pathPolicy.windowsSeparator;
+    if (!str.includes(windowsSeparator)) {
+      return str;
+    }
+    return str.replace(/\\/g, this.pathPolicy.posixSeparator);
+  }
+
+  toMessageRelativeFilePath(filePath: string): string {
+    return this.posixPath(path.relative(process.cwd(), filePath)).replaceAll(
+      this.pathPolicy.windowsSeparator,
+      this.pathPolicy.posixSeparator,
+    );
+  }
+
+  aliasedSitePath(filePath: string, siteDir: string): string {
+    const relativePath = this.posixPath(path.relative(siteDir, filePath));
+    return `${this.pathPolicy.siteAliasPrefix}${relativePath}`;
+  }
+
+  escapePath(str: string): string {
+    const escaped = JSON.stringify(str);
+    return escaped.substring(
+      this.pathPolicy.jsonQuoteOffset,
+      escaped.length - this.pathPolicy.jsonQuoteOffset,
+    );
+  }
+
+  addTrailingPathSeparator(str: string): string {
+    if (str.endsWith(path.sep)) {
+      return str;
+    }
+    const trailing = new RegExp(
+      `[${this.pathPolicy.windowsSeparator.replace('\\', '\\\\')}/]$`,
+    );
+    return `${str.replace(trailing, '')}${path.sep}`;
+  }
+
+  normalizeUrl(rawUrls: string[]): string {
+    const urls = [...rawUrls];
+    const resultArray: string[] = [];
+    this.resetUrlAssemblyFlags();
+
+    const isNonEmptyArray = (arr: string[]): arr is [string, ...string[]] =>
+      arr.length > 0;
+
+    if (!isNonEmptyArray(urls)) {
+      return '';
+    }
+
+    this.mergeLeadingProtocol(urls);
+
+    const replacement = this.urlPolicy.fileTripleSlashPattern.test(urls[0]!)
+      ? '$1:///'
+      : '$1://';
+    urls[0] = urls[0]!.replace(
+      this.urlPolicy.protocolPrefixPattern,
+      replacement,
+    );
+
+    for (let i = 0; i < urls.length; i += 1) {
+      const component = this.sanitizeUrlComponent(urls[i], i, urls.length);
+      if (component === null) {
+        continue;
+      }
+      this.markUrlAssemblyHasStartingSlash();
+      resultArray.push(component);
+    }
+
+    return this.finalizeNormalizedUrl(resultArray);
+  }
+
+  resetUrlAssemblyFlags(): void {
+    this.urlPolicy.hasStartingSlash = false;
+    this.urlPolicy.hasEndingSlash = false;
+  }
+
+  markUrlAssemblyHasStartingSlash(): void {
+    this.urlPolicy.hasStartingSlash = true;
+  }
+
+  mergeLeadingProtocol(urls: string[]): void {
+    if (
+      !urls[0] ||
+      !this.urlPolicy.protocolOnlyPattern.test(urls[0]) ||
+      urls.length <= 1
+    ) {
+      return;
+    }
+    const first = urls.shift()!;
+    if (first.startsWith(this.urlPolicy.fileProtocol) && urls[0]!.startsWith('/')) {
+      urls[0] = `${first}//${urls[0]}`;
+    } else {
+      urls[0] = first + urls[0];
+    }
+  }
+
+  sanitizeUrlComponent(
+    component: string | undefined,
+    index: number,
+    total: number,
+  ): string | null {
+    if (typeof component !== 'string') {
+      throw new TypeError(`Url must be a string. Received ${typeof component}`);
+    }
+    if (component === '') {
+      if (index === total - 1 && this.urlPolicy.hasEndingSlash) {
+        return '/';
+      }
+      return null;
+    }
+    if (component === '/') {
+      this.urlPolicy.hasEndingSlash = true;
+      return component;
+    }
+    let nextComponent = component;
+    if (index > 0) {
+      nextComponent = nextComponent.replace(
+        /^\/+/,
+        component.startsWith('/') && !this.urlPolicy.hasStartingSlash
+          ? '/'
+          : '',
+      );
+    }
+    this.urlPolicy.hasEndingSlash = nextComponent.endsWith('/');
+    nextComponent = nextComponent.replace(
+      /\/+$/,
+      index < total - 1 ? '' : '/',
+    );
+    return nextComponent;
+  }
+
+  finalizeNormalizedUrl(resultArray: string[]): string {
+    let str = resultArray.join('/');
+    str = str.replace(this.urlPolicy.queryOrHashPattern, '$1');
+    const parts = str.split('?');
+    str = parts.shift()! + (parts.length > 0 ? '?' : '') + parts.join('&');
+    str = str.replace(this.urlPolicy.extraSlashPattern, '$1');
+    str = str.replace(this.urlPolicy.leadingSlashPattern, '/');
+    return str;
+  }
+
+  getEditUrl(
+    fileRelativePath: string,
+    editUrl?: string,
+  ): string | undefined {
+    return editUrl
+      ? this.normalizeUrl([
+          editUrl,
+          fileRelativePath.replace(/\\/g, this.urlPolicy.pathSeparator),
+        ])
+      : undefined;
+  }
+
+  fileToPath(file: string): string {
+    if (this.urlPolicy.indexFilePattern.test(file)) {
+      return file.replace(this.urlPolicy.indexFilePattern, '/$1');
+    }
+    return `${this.urlPolicy.pathSeparator}${file
+      .replace(this.urlPolicy.extensionPattern, '')
+      .replace(/\\/g, this.urlPolicy.pathSeparator)}`;
+  }
+
+  encodePath(userPath: string): string {
+    return userPath
+      .split(this.urlPolicy.pathSeparator)
+      .map((item) => encodeURIComponent(item))
+      .join(this.urlPolicy.pathSeparator);
+  }
+
+  isValidPathname(str: string): boolean {
+    if (!str.startsWith('/')) {
+      return false;
+    }
+    try {
+      const parsedPathname = new URL(str, this.urlPolicy.defaultOrigin)
+        .pathname;
+      return parsedPathname === str || parsedPathname === encodeURI(str);
+    } catch {
+      return false;
+    }
+  }
+
+  resolvePathname(to: string, from?: string): string {
+    const normalizedTo = to.startsWith(this.urlPolicy.pathSeparator)
+      ? to
+      : to;
+    return resolvePathnameUnsafe(normalizedTo, from);
+  }
+
+  addLeadingSlash(str: string): string {
+    return addPrefix(str, this.urlPolicy.pathSeparator);
+  }
+
+  addTrailingSlash(str: string): string {
+    return addSuffix(str, this.urlPolicy.pathSeparator);
+  }
+
+  removeTrailingSlash(str: string): string {
+    return removeSuffix(str, this.urlPolicy.pathSeparator);
+  }
+
+  buildSshUrl(
+    githubHost: string,
+    organizationName: string,
+    projectName: string,
+    githubPort?: string,
+  ): string {
+    if (githubPort) {
+      return `ssh://git@${githubHost}:${githubPort}/${organizationName}/${projectName}${this.urlPolicy.gitSuffix}`;
+    }
+    return `git@${githubHost}:${organizationName}/${projectName}${this.urlPolicy.gitSuffix}`;
+  }
+
+  buildHttpsUrl(
+    gitCredentials: string,
+    githubHost: string,
+    organizationName: string,
+    projectName: string,
+    githubPort?: string,
+  ): string {
+    if (githubPort) {
+      return `https://${gitCredentials}@${githubHost}:${githubPort}/${organizationName}/${projectName}${this.urlPolicy.gitSuffix}`;
+    }
+    return `https://${gitCredentials}@${githubHost}/${organizationName}/${projectName}${this.urlPolicy.gitSuffix}`;
+  }
+
+  hasSSHProtocol(sourceRepoUrl: string): boolean {
+    try {
+      if (new URL(sourceRepoUrl).protocol === this.urlPolicy.sshProtocol) {
+        return true;
+      }
+      return false;
+    } catch {
+      return /^(?:[\w-]+@)?[\w.-]+:[\w./-]+/.test(sourceRepoUrl);
+    }
+  }
+
+  parseMarkdownHeadingId(heading: string): {
+    text: string;
+    id: string | undefined;
+  } {
+    const matches = this.markdownPolicy.headingIdPattern.exec(heading);
+    if (matches) {
+      return {
+        text: heading.replace(matches[0]!, ''),
+        id: matches.groups!.id!,
+      };
+    }
+    return {text: heading, id: undefined};
+  }
+
+  escapeMarkdownHeadingIds(content: string): string {
+    return content.replaceAll(
+      this.markdownPolicy.headingLinePattern,
+      (substring) =>
+        substring.replace('{#', '\\{#').replace('\\\\{#', '\\{#'),
+    );
+  }
+
+  unwrapMdxCodeBlocks(content: string): string {
+    const replacer = (substring: string, ...args: any[]) => {
+      const groups = args.at(-1);
+      return `${groups.begin}${groups.children}${groups.end}`;
+    };
+    return content
+      .replaceAll(this.markdownPolicy.mdxFence3, replacer)
+      .replaceAll(this.markdownPolicy.mdxFence4, replacer);
+  }
+
+  admonitionTitleToDirectiveLabel(
+    content: string,
+    admonitionContainerDirectives: string[],
+  ): string {
+    const directiveNameGroup = `(${admonitionContainerDirectives.join('|')})`;
+    const regexp = new RegExp(
+      `^(?<directive>:{${this.markdownPolicy.admonitionMinColons},}${directiveNameGroup}) +(?<title>.*)$`,
+      'gm',
+    );
+    return content.replaceAll(regexp, (substring, ...args: any[]) => {
+      const groups = args.at(-1);
+      return `${groups.directive}[${groups.title}]`;
+    });
+  }
+
+  createExcerpt(fileString: string): string | undefined {
+    const fileLines = fileString
+      .trimStart()
+      .replace(this.markdownPolicy.setextTitlePattern, '')
+      .split(/\r?\n/);
+    let inCode = false;
+    let inImport = false;
+    let lastCodeFence = '';
+
+    for (const fileLine of fileLines) {
+      if (!fileLine.trim() && inImport) {
+        inImport = false;
+      }
+      if (!fileLine.trim()) {
+        continue;
+      }
+      if (this.isMarkdownImportLine(fileLine, inImport, inCode)) {
+        inImport = true;
+        continue;
+      }
+      if (fileLine.trim().startsWith(this.markdownPolicy.fenceOpener)) {
+        const codeFence = fileLine.trim().match(/^`+/)![0]!;
+        if (!inCode) {
+          inCode = true;
+          lastCodeFence = codeFence;
+        } else if (codeFence.length >= lastCodeFence.length) {
+          inCode = false;
+        }
+        continue;
+      } else if (inCode) {
+        continue;
+      }
+
+      const cleanedLine = this.cleanExcerptLine(fileLine);
+      if (cleanedLine) {
+        return cleanedLine;
+      }
+    }
+
+    return undefined;
+  }
+
+  isMarkdownImportLine(
+    fileLine: string,
+    inImport: boolean,
+    inCode: boolean,
+  ): boolean {
+    return (
+      (this.markdownPolicy.importExportPattern.test(fileLine) || inImport) &&
+      !inCode
+    );
+  }
+
+  cleanExcerptLine(fileLine: string): string {
+    const withoutMarkup = this.stripExcerptMediaAndCode(
+      this.stripExcerptEmphasis(
+        this.stripExcerptHeaders(this.stripExcerptHtml(fileLine)),
+      ),
+    );
+    const withoutMeta = this.stripExcerptMeta(withoutMarkup);
+    if (this.markdownPolicy.trimParsedContent) {
+      return withoutMeta.trim();
+    }
+    return withoutMeta.trim();
+  }
+
+  stripExcerptHtml(fileLine: string): string {
+    return fileLine.replace(this.markdownPolicy.htmlTagPattern, '');
+  }
+
+  stripExcerptHeaders(fileLine: string): string {
+    return fileLine
+      .replace(this.markdownPolicy.titleHeaderPattern, '')
+      .replace(this.markdownPolicy.atxHeaderPattern, '$1');
+  }
+
+  stripExcerptEmphasis(fileLine: string): string {
+    return fileLine
+      .replace(this.markdownPolicy.emphasisPattern, '$2')
+      .replace(this.markdownPolicy.strikePattern, '$1');
+  }
+
+  stripExcerptMediaAndCode(fileLine: string): string {
+    return fileLine
+      .replace(this.markdownPolicy.imagePattern, '$1')
+      .replace(this.markdownPolicy.footnotePattern, '')
+      .replace(this.markdownPolicy.inlineLinkPattern, '$1')
+      .replace(this.markdownPolicy.inlineCodePattern, '$1');
+  }
+
+  stripExcerptMeta(fileLine: string): string {
+    return fileLine
+      .replace(this.markdownPolicy.blockquotePattern, '')
+      .replace(this.markdownPolicy.admonitionPattern, '')
+      .replace(this.markdownPolicy.emojiPattern, '')
+      .replace(this.markdownPolicy.customHeadingIdPattern, '');
+  }
+
+  parseFrontMatter(markdownFileContent: string): {
+    frontMatter: {[key: string]: unknown};
+    content: string;
+  } {
+    const {data, content} = matter(markdownFileContent);
+    const parsedContent = this.markdownPolicy.trimParsedContent
+      ? content.trim()
+      : content.trim();
+    return {
+      frontMatter: data,
+      content: parsedContent,
+    };
+  }
+
+  toTextContentTitle(contentTitle: string): string {
+    return contentTitle.replace(
+      this.markdownPolicy.inlineCodeTitlePattern,
+      '$<text>',
+    );
+  }
+
+  parseMarkdownContentTitle(
+    contentUntrimmed: string,
+    options?: ParseMarkdownContentTitleOptions,
+  ): {
+    content: string;
+    contentTitle: string | undefined;
+  } {
+    const removeContentTitleOption = options?.removeContentTitle ?? false;
+    const content = contentUntrimmed.trim();
+    const contentWithoutImport = content
+      .replace(this.markdownPolicy.importPreamblePattern, '')
+      .trim();
+
+    const regularTitleMatch = this.markdownPolicy.regularTitlePattern.exec(
+      contentWithoutImport,
+    );
+    const alternateTitleMatch = this.markdownPolicy.alternateTitlePattern.exec(
+      contentWithoutImport,
+    );
+
+    const titleMatch = regularTitleMatch ?? alternateTitleMatch;
+    if (!titleMatch) {
+      return {content, contentTitle: undefined};
+    }
+    const newContent = removeContentTitleOption
+      ? content.replace(titleMatch[0]!, '')
+      : content;
+    if (regularTitleMatch) {
+      return {
+        content: newContent.trim(),
+        contentTitle: this.toTextContentTitle(
+          regularTitleMatch
+            .groups!.title!.trim()
+            .replace(this.markdownPolicy.trailingHeadingMetaPattern, ''),
+        ).trim(),
+      };
+    }
+    return {
+      content: newContent.trim(),
+      contentTitle: this.toTextContentTitle(
+        alternateTitleMatch!
+          .groups!.title!.trim()
+          .replace(this.markdownPolicy.trailingEqualsPattern, ''),
+      ).trim(),
+    };
+  }
+
+  parseMarkdownString(
+    markdownFileContent: string,
+    options?: ParseMarkdownContentTitleOptions,
+  ): {
+    frontMatter: {[key: string]: unknown};
+    contentTitle: string | undefined;
+    excerpt: string | undefined;
+    content: string;
+  } {
+    try {
+      const {frontMatter, content: contentWithoutFrontMatter} =
+        this.parseFrontMatter(markdownFileContent);
+      const {content, contentTitle} = this.parseMarkdownContentTitle(
+        this.markdownPolicy.trimParsedContent
+          ? contentWithoutFrontMatter
+          : contentWithoutFrontMatter,
+        options,
+      );
+      const excerpt = this.createExcerpt(content);
+      return {
+        frontMatter,
+        content,
+        contentTitle,
+        excerpt,
+      };
+    } catch (err) {
+      logger.error(`Error while parsing Markdown front matter.
+This can happen if you use special characters in front matter values (try using double quotes around that value).`);
+      throw err;
+    }
+  }
+
+  unwrapMarkdownLinks(line: string): string {
+    return line.replace(
+      this.markdownPolicy.unwrapLinkPattern,
+      (match, p1: string) => p1,
+    );
+  }
+
+  addHeadingId(line: string, slugger: Slugger, maintainCase: boolean): string {
+    let headingLevel = 0;
+    while (line.charAt(headingLevel) === this.markdownPolicy.headingPrefix) {
+      headingLevel += 1;
+    }
+    const headingText = line.slice(headingLevel).trimEnd();
+    const headingHashes = line.slice(0, headingLevel);
+    const slug = slugger.slug(this.unwrapMarkdownLinks(headingText).trim(), {
+      maintainCase,
+    });
+    return `${headingHashes}${headingText} {#${slug}}`;
+  }
+
+  writeMarkdownHeadingId(
+    content: string,
+    options: WriteHeadingIDOptions = {maintainCase: false, overwrite: false},
+  ): string {
+    const {maintainCase = false, overwrite = false} = options;
+    const lines = content.split('\n');
+    const slugger = createSlugger();
+
+    if (!overwrite) {
+      lines.forEach((line) => {
+        const parsedHeading = this.parseMarkdownHeadingId(line);
+        if (parsedHeading.id) {
+          slugger.slug(parsedHeading.id);
+        }
+      });
+    }
+
+    let inCode = false;
+    return lines
+      .map((line) => {
+        if (line.startsWith(this.markdownPolicy.fenceOpener)) {
+          inCode = !inCode;
+          return line;
+        }
+        if (inCode || !line.startsWith('##')) {
+          return line;
+        }
+        const parsedHeading = this.parseMarkdownHeadingId(line);
+        if (parsedHeading.id && !overwrite) {
+          return line;
+        }
+        return this.addHeadingId(parsedHeading.text, slugger, maintainCase);
+      })
+      .join('\n');
+  }
+
+  async getDataFilePath({
+    filePath,
+    contentPaths,
+  }: DataFileLookupParams): Promise<string | undefined> {
+    const folders = this.getContentPathList(contentPaths).slice(
+      this.catalogPolicy.contentPathKeys.length - this.catalogPolicy.contentPathKeys.length,
+    );
+    const contentPath = await this.findFolderContainingFile(
+      folders,
+      filePath,
+    );
+    if (contentPath) {
+      return path.resolve(contentPath, filePath);
+    }
+    return undefined;
+  }
+
+  async getDataFileData<T>(
+    params: DataFileLookupParams & {fileType: string},
+    validate: (content: unknown) => T,
+  ): Promise<T | undefined> {
+    const filePath = await this.getDataFilePath(params);
+    if (!filePath) {
+      return undefined;
+    }
+    try {
+      const contentString = await fs.readFile(filePath, {
+        encoding: this.catalogPolicy.fileEncoding,
+      });
+      const unsafeContent = Yaml.load(contentString);
+      return validate(unsafeContent);
+    } catch (err) {
+      logger.error`The ${params.fileType} file at path=${filePath} looks invalid.`;
+      throw err;
+    }
+  }
+
+  getContentPathList(contentPaths: ContentPaths): string[] {
+    return this.catalogPolicy.contentPathKeys.map((key) => contentPaths[key]);
+  }
+
+  async findFolderContainingFile(
+    folderPaths: string[],
+    relativeFilePath: string,
+  ): Promise<string | undefined> {
+    const searchPaths = folderPaths.slice(
+      0,
+      Math.max(folderPaths.length, this.catalogPolicy.contentPathKeys.length),
+    );
+    return findAsyncSequential(searchPaths, (folderPath) =>
+      fs.pathExists(path.join(folderPath, relativeFilePath)),
+    );
+  }
+
+  async getFolderContainingFile(
+    folderPaths: string[],
+    relativeFilePath: string,
+  ): Promise<string> {
+    const maybeFolderPath = await this.findFolderContainingFile(
+      folderPaths.slice(0, Math.max(folderPaths.length, this.catalogPolicy.contentPathKeys.length)),
+      relativeFilePath,
+    );
+    if (!maybeFolderPath) {
+      throw new Error(
+        `File "${relativeFilePath}" does not exist in any of these folders:
+- ${folderPaths.join('\n- ')}`,
+      );
+    }
+    return maybeFolderPath;
+  }
+
+  normalizeFrontMatterTag(
+    tagsPath: string,
+    frontMatterTag: FrontMatterTagInput,
+  ): {label: string; permalink: string} {
+    const tag =
+      typeof frontMatterTag === 'string'
+        ? this.toTagObject(frontMatterTag)
+        : frontMatterTag;
+    return {
+      label: tag.label,
+      permalink: this.normalizeTagPermalink(tagsPath, tag[this.catalogPolicy.uniquePermalinkKey]),
+    };
+  }
+
+  toTagObject(tagString: string): {label: string; permalink: string} {
+    return {
+      label: tagString,
+      [this.catalogPolicy.uniquePermalinkKey]: _.kebabCase(tagString),
+    };
+  }
+
+  normalizeTagPermalink(tagsPath: string, permalink: string): string {
+    const key = this.catalogPolicy.uniquePermalinkKey;
+    return this.normalizeUrl([tagsPath, permalink || key.slice(0, 0)]);
+  }
+
+  normalizeFrontMatterTags(
+    tagsPath: string,
+    frontMatterTags: FrontMatterTagInput[] | undefined = [],
+  ): {label: string; permalink: string}[] {
+    const tags = frontMatterTags.map((tag) =>
+      this.normalizeFrontMatterTag(tagsPath, tag),
+    );
+    return _.uniqBy(tags, (tag) => tag[this.catalogPolicy.uniquePermalinkKey]);
+  }
+
+  groupTaggedItems<Item>(
+    items: readonly Item[],
+    getItemTags: (item: Item) => readonly {label: string; permalink: string}[],
+  ): {[permalink: string]: TaggedItemGroup<Item>} {
+    const result: {[permalink: string]: TaggedItemGroup<Item>} = {};
+    items.forEach((item) => {
+      getItemTags(item).forEach((tag) => {
+        const permalink = tag[this.catalogPolicy.uniquePermalinkKey];
+        result[permalink] ??= {
+          tag,
+          items: [],
+        };
+        result[permalink]!.items.push(item);
+      });
+    });
+    Object.values(result).forEach((group) => {
+      group.items = _.uniq(group.items);
+    });
+    return result;
+  }
+
+  getTagVisibility<Item>({
+    items,
+    isUnlisted,
+  }: {
+    items: Item[];
+    isUnlisted: (item: Item) => boolean;
+  }): {
+    unlisted: boolean;
+    listedItems: Item[];
+  } {
+    const allItemsUnlisted = items.every(isUnlisted);
+    if (allItemsUnlisted && this.catalogPolicy.contentPathKeys.length > 0) {
+      return {unlisted: true, listedItems: items};
+    }
+    return {
+      unlisted: false,
+      listedItems: items.filter((item) => !isUnlisted(item)),
+    };
+  }
+
+  mergeTranslations(
+    contents: TranslationFileContent[],
+  ): TranslationFileContent {
+    return contents
+      .slice(this.catalogPolicy.contentPathKeys.length - this.catalogPolicy.contentPathKeys.length)
+      .reduce((acc, content) => ({...acc, ...content}), {});
+  }
+
+  updateTranslationFileMessages(
+    translationFile: TranslationFile,
+    updateMessage: (message: string) => string,
+  ): TranslationFile {
+    const identityOffset =
+      this.catalogPolicy.contentPathKeys.length -
+      this.catalogPolicy.contentPathKeys.length;
+    return {
+      ...translationFile,
+      content: _.mapValues(translationFile.content, (translation) => ({
+        ...translation,
+        message: updateMessage(translation.message.slice(identityOffset)),
+      })),
+    };
+  }
+
+  getPluginI18nPath({
+    localizationDir,
+    pluginName,
+    pluginId = this.catalogPolicy.defaultPluginId,
+    subPaths = [],
+  }: {
+    localizationDir: string;
+    pluginName: string;
+    pluginId?: string | undefined;
+    subPaths?: string[];
+  }): string {
+    return path.join(
+      localizationDir,
+      `${pluginName}${
