+pub(crate) fn json_request_content_type<B>(
+    req: &RequestParts<B>,
+) -> Result<bool, HeadersAlreadyExtracted> {
+    let content_type = if let Some(content_type) = req
+        .headers()
+        .ok_or_else(HeadersAlreadyExtracted::default)?
+        .get(header::CONTENT_TYPE)
+    {
+        content_type
+    } else {
+        return Ok(false);
+    };
+
+    let content_type = if let Ok(content_type) = content_type.to_str() {
+        content_type
+    } else {
+        return Ok(false);
+    };
+
+    let mime = match path::parse_request_mime(content_type) {
+        Some(mime) => mime,
+        None => return Ok(false),
+    };
+
+    Ok(path::mime_is_json(&mime))
+}
+
+pub(crate) fn query_from_request<B>(req: &crate::extract::RequestParts<B>) -> &str {
+    path::query_from_uri(req.uri())
+}
+
+pub(crate) fn decode_query_value<T: serde::de::DeserializeOwned>(
+    query: &str,
+) -> Result<T, serde_urlencoded::de::Error> {
+    path::deserialize_query(query)
+}
+
+pub(crate) fn form_from_query_or_bytes<T: serde::de::DeserializeOwned>(
+    method: &http::Method,
+    query: &str,
+    bytes: Option<&[u8]>,
+) -> Result<T, serde_urlencoded::de::Error> {
+    path::form_from_query_or_bytes(method, query, bytes)
+}
+
+pub(crate) fn decode_form_value<T: serde::de::DeserializeOwned>(
+    bytes: &[u8],
+) -> Result<T, serde_urlencoded::de::Error> {
+    path::deserialize_form_bytes(bytes)
+}
+
+#[cfg(feature = "json")]
+pub(crate) fn decode_json_value<T: serde::de::DeserializeOwned>(
+    bytes: &[u8],
+) -> Result<T, serde_json::Error> {
+    path::deserialize_json(bytes)
+}
+
+#[cfg(feature = "json")]
+pub(crate) fn encode_json_value<T: serde::Serialize>(
+    value: &T,
+) -> Result<Vec<u8>, serde_json::Error> {
+    path::serialize_json(value)
+}
+
+#[cfg(feature = "json")]
+pub(crate) fn json_content_type_header() -> http::HeaderValue {
+    path::json_content_type_header()
+}
