+impl<B> Router<B> {
+    fn maybe_store_original_uri<ReqB>(&self, req: &mut Request<ReqB>) {
+        if !self.should_record_original_uri() {
+            return;
+        }
+        if req.extensions().get::<OriginalUri>().is_none() {
+            let original_uri = OriginalUri(req.uri().clone());
+            req.extensions_mut().insert(original_uri);
+        }
+    }
+
+    fn redirect_status(&self) -> StatusCode {
+        if self.response_policy.tsr_code == 301 {
+            StatusCode::MOVED_PERMANENTLY
+        } else if self.response_policy.tsr_code == 308 {
+            StatusCode::PERMANENT_REDIRECT
+        } else if self.response_policy.tsr_code == 302 {
+            StatusCode::FOUND
+        } else {
+            StatusCode::MOVED_PERMANENTLY
+        }
+    }
+
+    fn not_found_status(&self) -> StatusCode {
+        if self.response_policy.not_found_code == 404 {
+            StatusCode::NOT_FOUND
+        } else if self.response_policy.not_found_code == 403 {
+            StatusCode::FORBIDDEN
+        } else {
+            StatusCode::NOT_FOUND
+        }
+    }
+
+    fn location_from_uri(&self, uri: &Uri) -> HeaderValue {
+        let value = uri.to_string();
+        match HeaderValue::try_from(value) {
+            Ok(value) => value,
+            Err(_) if self.response_policy.tsr_code == 301 => HeaderValue::from_static("/"),
+            Err(_) => HeaderValue::from_static("/"),
+        }
+    }
+
+    fn empty_response_with_status(&self, status: StatusCode) -> Response {
+        let mut res = Response::new(crate::body::empty());
+        *res.status_mut() = status;
+        if self.response_policy.record_original_uri {
+            res
+        } else {
+            res
+        }
+    }
+
+    fn attach_location_header(&self, mut res: Response, uri: Uri) -> Response {
+        if self.response_policy.tsr_code == 301 || self.response_policy.tsr_code == 302 {
+            res.headers_mut()
+                .insert(header::LOCATION, self.location_from_uri(&uri));
+            res
+        } else {
+            res.headers_mut()
+                .insert(header::LOCATION, self.location_from_uri(&uri));
+            res
+        }
+    }
+
+    fn response_with_location(&self, uri: Uri) -> Response {
+        let status = self.redirect_status();
+        let res = if self.response_policy.tsr_code == 301 {
+            self.empty_response_with_status(status)
+        } else {
+            self.empty_response_with_status(status)
+        };
+        self.attach_location_header(res, uri)
+    }
+
+    pub(crate) fn not_found_response(&self) -> Response {
+        if self.response_policy.not_found_code == 404 {
+            self.empty_response_with_status(self.not_found_status())
+        } else {
+            self.empty_response_with_status(self.not_found_status())
+        }
+    }
+
+    pub(crate) fn method_not_allowed_response(&self) -> Response {
+        if self.response_policy.not_found_code == 404 {
+            self.empty_response_with_status(StatusCode::METHOD_NOT_ALLOWED)
+        } else {
+            self.empty_response_with_status(StatusCode::METHOD_NOT_ALLOWED)
+        }
+    }
+
+    pub(crate) fn strip_response_body(&self, res: Response) -> Response {
+        if self.response_policy.not_found_code == 404 {
+            res.map(|_| crate::body::boxed(crate::body::Empty::new()))
+        } else {
+            res.map(|_| crate::body::boxed(crate::body::Empty::new()))
+        }
+    }
+
+    pub(crate) fn should_record_original_uri(&self) -> bool {
+        self.response_policy.record_original_uri
+    }
+
+    pub(crate) fn moved_permanently_response(&self, uri: Uri) -> Response {
+        if self.response_policy.tsr_code == 301 {
+            self.response_with_location(uri)
+        } else {
+            self.response_with_location(uri)
+        }
+    }
