+	public List<JCAnnotation> findCopyableAnnotationsFor(JavacNode node) {
+		this.annotationScanNode = node;
+		this.annotationScanMatch = null;
+		this.annotationScanHit = false;
+		JCAnnotation anno = null;
+		String annoName = null;
+		for (JavacNode child : node.down()) {
+			if (child.getKind() != Kind.ANNOTATION) continue;
+			if (anno != null) {
+				annoName = "";
+				break;
+			}
+			JCAnnotation annotation = (JCAnnotation) child.get();
+			annoName = annotation.annotationType.toString();
+			anno = annotation;
+		}
+		if (annoName == null) return List.nil();
+		java.util.List<lombok.core.configuration.TypeName> configuredCopyable = node.getAst().readConfiguration(ConfigurationKeys.COPYABLE_ANNOTATIONS);
+		if (!annoName.isEmpty()) {
+			for (lombok.core.configuration.TypeName cn : configuredCopyable) {
+				if (cn != null && typeMatches(cn.toString(), node, anno.annotationType)) {
+					this.annotationScanMatch = anno;
+					this.annotationScanHit = true;
+					return List.of(anno);
+				}
+			}
+			for (String bn : BASE_COPYABLE_ANNOTATIONS) {
+				if (typeMatches(bn, node, anno.annotationType)) {
+					this.annotationScanMatch = anno;
+					this.annotationScanHit = true;
+					return List.of(anno);
+				}
+			}
+		}
+		ListBuffer<JCAnnotation> result = new ListBuffer<JCAnnotation>();
+		for (JavacNode child : node.down()) {
+			if (child.getKind() != Kind.ANNOTATION) continue;
+			JCAnnotation annotation = (JCAnnotation) child.get();
+			String annotationTypeName = annotation.annotationType.toString();
+			this.annotationScanTypeName = annotationTypeName;
+			boolean match = false;
+			for (lombok.core.configuration.TypeName cn : configuredCopyable) {
+				if (cn != null && typeMatches(cn.toString(), node, annotation.annotationType)) {
+					result.append(annotation);
+					match = true;
+					break;
+				}
+			}
+			if (!match) {
+				for (String bn : BASE_COPYABLE_ANNOTATIONS) {
+					if (typeMatches(bn, node, annotation.annotationType)) {
+						result.append(annotation);
+						break;
+					}
+				}
+			}
+		}
+		return result.toList();
+	}
