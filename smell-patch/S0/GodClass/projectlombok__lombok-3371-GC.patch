+	public List<JavacNode> findFieldsFor(JavacNode typeNode, boolean nullMarked) {
+
+		this.constructorTypeNode = typeNode;
+		ListBuffer<JavacNode> fields = new ListBuffer<JavacNode>();
+		if (typeNode == null) return fields.toList();
+		for (JavacNode child : typeNode.down()) {
+			if (child.getKind() != Kind.FIELD) continue;
+			if (!isConstructorCandidateField(child, nullMarked)) continue;
+			fields.append(child);
+		}
+		this.constructorFields = fields.toList();
+		return this.constructorFields;
+	}
+
+	private boolean isConstructorCandidateField(JavacNode child, boolean nullMarked) {
+		this.constructorTypeNode = child == null ? this.constructorTypeNode : child.up();
+
+		JCVariableDecl fieldDecl = (JCVariableDecl) child.get();
+		if (fieldDecl.name.toString().startsWith("$")) return false;
+		long fieldFlags = fieldDecl.mods.flags;
+		if ((fieldFlags & Flags.STATIC) != 0) return false;
+		boolean isFinal = (fieldFlags & Flags.FINAL) != 0;
+		boolean isNonNull = nullMarked && hasNonNullAnnotationsOn(child);
+		return (isFinal || isNonNull) && fieldDecl.init == null;
+	}
