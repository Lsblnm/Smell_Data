+	public JCStatement generateNullCheckForTypeAndName(JavacTreeMaker maker, JCExpression typeNode, Name varName, JavacNode source, String customMessage) {
+		captureNullCheckContext(source, typeNode, varName, customMessage);
+		if (isPrimitiveNullCheckTarget(typeNode)) {
