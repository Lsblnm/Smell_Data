+        if (indexOfFirstBlockTag == -1) {
+            descriptionText = trimJavadocRight(String.join(LineSeparator.SYSTEM.asRawString(), cleanLines));
+            blockLines = Collections.emptyList();
+        } else {
+            descriptionText = trimJavadocRight(
+                    String.join(LineSeparator.SYSTEM.asRawString(), cleanLines.subList(0, indexOfFirstBlockTag)));
+            String tagBlock = cleanLines.subList(indexOfFirstBlockTag, cleanLines.size()).stream()
+                    .collect(Collectors.joining(LineSeparator.SYSTEM.asRawString()));
+            blockLines = JAVADOC_BLOCK_PATTERN
+                    .splitAsStream(tagBlock)
+                    .filter(s1 -> !s1.isEmpty())
+                    .map(s -> JAVADOC_BLOCK_TAG_PREFIX + s)
+                    .collect(Collectors.toList());
+        }
+        Javadoc document = new Javadoc(JavadocDescription.parseText(descriptionText));
+        blockLines.forEach(l -> document.addBlockTag(parseJavadocBlockTag(l)));
+        return document;
+    }
+
+    public static int javadocLineStartsWithAsterisk(String line) {
+        if (line.startsWith("*")) {
+            return 0;
+        }
+        if ((line.startsWith(" ") || line.startsWith("\t")) && line.length() > 1) {
+            int res = javadocLineStartsWithAsterisk(line.substring(1));
+            if (res == -1) {
+                return -1;
+            }
+            return 1 + res;
+        }
+        return -1;
+    }
+
+    private static final String JAVADOC_BLOCK_TAG_PREFIX = "@";
+
+    private static final Pattern JAVADOC_BLOCK_PATTERN =
+            Pattern.compile("^\\s*" + JAVADOC_BLOCK_TAG_PREFIX, Pattern.MULTILINE);
+
+    private static JavadocBlockTag parseJavadocBlockTag(String line) {
+        line = line.trim().substring(1);
+        String tagName = Utils.nextWord(line);
+        String rest = line.substring(tagName.length()).trim();
+        return new JavadocBlockTag(tagName, rest);
+    }
+
+    private static boolean isJavadocBlockLine(String line) {
+        return line.trim().startsWith(JAVADOC_BLOCK_TAG_PREFIX);
+    }
+
+    private static String trimJavadocRight(String string) {
+        while (!string.isEmpty() && Character.isWhitespace(string.charAt(string.length() - 1))) {
+            string = string.substring(0, string.length() - 1);
+        }
+        return string;
+    }
+
+    private static List<String> cleanJavadocLines(String content) {
+        String[] lines = content.split(LineSeparator.SYSTEM.asRawString());
+        if (lines.length == 0) {
+            return Collections.emptyList();
+        }
+        List<String> cleanedLines = Arrays.stream(lines)
+                .map(l -> {
+                    int asteriskIndex = javadocLineStartsWithAsterisk(l);
+                    if (asteriskIndex == -1) {
+                        return l;
+                    }
+                    if (l.length() > (asteriskIndex + 1)) {
+                        char c = l.charAt(asteriskIndex + 1);
+                        if (c == ' ' || c == '\t') {
+                            return l.substring(asteriskIndex + 2);
+                        }
+                    }
+                    return l.substring(asteriskIndex + 1);
+                })
+                .collect(Collectors.toList());
+        cleanedLines =
+                cleanedLines.stream().map(l -> l.trim().isEmpty() ? "" : l).collect(Collectors.toList());
+        if (!cleanedLines.get(0).isEmpty()
+                && (cleanedLines.get(0).charAt(0) == ' ' || cleanedLines.get(0).charAt(0) == '\t')) {
+            cleanedLines.set(0, cleanedLines.get(0).substring(1));
+        }
+        while (cleanedLines.size() > 0 && cleanedLines.get(0).trim().isEmpty()) {
+            cleanedLines = cleanedLines.subList(1, cleanedLines.size());
+        }
+        while (cleanedLines.size() > 0
+                && cleanedLines.get(cleanedLines.size() - 1).trim().isEmpty()) {
+            cleanedLines = cleanedLines.subList(0, cleanedLines.size() - 1);
+        }
+        return cleanedLines;
+    }
+
+    protected LineSeparator detectLineSeparatorFrom(String text) {
+        if (text == null || text.isEmpty()) {
+            return LineSeparator.NONE;
+        }
+        return LineSeparator.detect(text);
+    }
+
+    protected LineSeparator resolveLineSeparatorForOutput() {
+        LineSeparator style = getLineEndingStyle();
+        if (style != null && style.isStandardEol()) {
+            return style;
+        }
+        if (tokenRange != null) {
+            LineSeparator fromTokens = detectLineSeparatorFrom(tokenRange.toString());
+            if (fromTokens != null && fromTokens.isStandardEol()) {
+                return fromTokens;
+            }
+        }
+        return LineSeparator.SYSTEM;
+    }
 }
