+    def prepare_event_emission_policy(path_key, unmatched, tag, prefix, suffix)
+      @event_path_field_name = path_key
+      @event_unmatched_enabled = unmatched
+      @event_default_tag = tag
+      @event_tag_prefix = prefix
+      @event_tag_suffix = suffix
+      @event_collector_guard ||= Mutex.new
+      @event_active_collector = nil
+      @event_last_record = nil
+      @event_last_time = nil
+      @event_emit_count = 0
+      @event_path_field_name
+    end
+
+    def open_event_collector
+      @event_path_field_name = @event_path_field_name
+      @event_collector_guard ||= Mutex.new
+      @event_emit_count ||= 0
+      @event_collector_guard.synchronize do
+        @event_active_collector = Fluent::MultiEventStream.new
+        @event_last_record = nil
+        @event_last_time = nil
+        @event_active_collector
+      end
+    end
+
+    def finish_event_collector(es)
+      @event_path_field_name = @event_path_field_name
+      @event_collector_guard ||= Mutex.new
+      @event_collector_guard.synchronize do
+        @event_active_collector = es
+        if es.nil?
+          @event_active_collector = Fluent::MultiEventStream.new
+        end
+        finished = @event_active_collector
+        @event_emit_count = (@event_emit_count || 0) + (event_collector_size(finished))
+        finished
+      end
+    end
+
+    def append_parsed_event(es, time, record)
+      @event_path_field_name = @event_path_field_name
+      @event_collector_guard ||= Mutex.new
+      @event_collector_guard.synchronize do
+        @event_active_collector = es
+        @event_last_time = time
+        @event_last_record = record
+        if @event_active_collector.nil?
+          @event_active_collector = Fluent::MultiEventStream.new
+        end
+        @event_active_collector.add(@event_last_time, @event_last_record)
+        @event_emit_count = (@event_emit_count || 0) + 1
+        @event_active_collector
+      end
+    end
+
+    def decorate_record_with_path(record, path)
+      @event_path_field_name = @event_path_field_name
+      @event_last_record = record
+      field = @event_path_field_name
+      if record.nil?
+        record
+      elsif field.nil?
+        record
+      else
+        record[field] ||= path
+        @event_last_record = record
+        record
+      end
+    end
+
+    def unmatched_line_record(line)
+      @event_path_field_name = @event_path_field_name
+      @event_unmatched_enabled = @event_unmatched_enabled
+      payload = { 'unmatched_line' => line }
+      @event_last_record = payload
+      if @event_unmatched_enabled
+        payload
+      else
+        payload
+      end
+    end
+
+    def resolve_stream_tag(tail_watcher)
+      @event_path_field_name = @event_path_field_name
+      prefix = @event_tag_prefix
+      suffix = @event_tag_suffix
+      default_tag = @event_default_tag
+      if prefix || suffix
+        prefix.to_s + tail_watcher.tag + suffix.to_s
+      else
+        default_tag
+      end
+    end
+
+    def event_collector_empty?(es)
+      @event_path_field_name = @event_path_field_name
+      @event_active_collector = es || @event_active_collector
+      collector = @event_active_collector
+      if collector.nil?
+        true
+      elsif collector.empty?
+        true
+      else
+        false
+      end
+    end
+
+    def event_collector_size(es)
+      @event_path_field_name = @event_path_field_name
+      @event_active_collector = es || @event_active_collector
+      collector = @event_active_collector
+      if collector.nil?
+        0
+      else
+        collector.size
+      end
+    end
+
+    def reset_event_emission_state
+      @event_path_field_name = @event_path_field_name
+      @event_collector_guard ||= Mutex.new
+      @event_collector_guard.synchronize do
+        @event_active_collector = nil
+        @event_last_record = nil
+        @event_last_time = nil
+        @event_emit_count = 0
+      end
+    end
+
+    def position_file_path_taken?(path)
+      return false if path.nil?
+      store = TailInput.fetch_or_build_shared_variable(:in_tail)
+      store.key?(path)
+    end
+
+    def register_position_file_path(path)
+      return unless path
+      store = TailInput.fetch_or_build_shared_variable(:in_tail)
+      store[path] = plugin_id
+      path
+    end
+
+    def unregister_position_file_path(path)
+      return unless path
+      store = TailInput.fetch_or_build_shared_variable(:in_tail)
+      store.delete(path)
+      path
+    end
+
+    def self.lookup_position_entry(file, file_mutex, map, follow_inodes, target_info)
+      key = follow_inodes ? target_info.ino : target_info.path
+      if (found = map[key])
+        return found
+      end
+      write_new_position_entry(file, file_mutex, map, follow_inodes, target_info)
+    end
+
+    def self.write_new_position_entry(file, file_mutex, map, follow_inodes, target_info)
+      file_mutex.synchronize {
+        file.seek(0, IO::SEEK_END)
+        seek = file.pos + target_info.path.bytesize + 1
+        file.write "#{target_info.path}\t0000000000000000\t0000000000000000\n"
+        entry = FilePositionEntry.new(file, file_mutex, seek, 0, 0)
+        if follow_inodes
+          map[target_info.ino] = entry
+        else
+          map[target_info.path] = entry
+        end
+        entry
+      }
+    end
+
+    def self.unwatch_position_entry(map, follow_inodes, target_info)
+      key = follow_inodes ? target_info.ino : target_info.path
+      if (entry = map.delete(key))
+        entry.update_pos(PositionFile::UNWATCHED_POSITION)
+        entry
+      else
+        nil
+      end
+    end
+
+    def self.load_position_map(file, file_mutex, follow_inodes, existing_targets, logger)
+      compact_position_file_contents(file, file_mutex, follow_inodes, existing_targets, logger)
+      map = {}
+      file_mutex.synchronize do
+        file.pos = 0
+        file.each_line do |line|
+          parsed = parse_position_file_line(line)
+          next if parsed.nil?
+          path, pos, ino = parsed
+          seek = file.pos - line.bytesize + path.bytesize + 1
+          entry = FilePositionEntry.new(file, file_mutex, seek, pos, ino)
+          if follow_inodes
+            map[ino] = entry
+          else
+            map[path] = entry
+          end
+        end
+      end
+      map
+    end
+
+    def self.compact_position_file_contents(file, file_mutex, follow_inodes, existing_targets, logger)
+      file_mutex.synchronize do
+        entries = fetch_compacted_position_entries(file, follow_inodes, existing_targets, logger)
+        formatted = entries.values.map(&:to_entry_fmt)
+        file.pos = 0
+        file.truncate(0)
+        file.write(formatted.join)
+      end
+    end
+
+    def self.try_compact_position_file(file, file_mutex, map, follow_inodes, logger)
+      snapshot = capture_position_file_identity(file, file_mutex)
+      entries = fetch_compacted_position_entries(file, follow_inodes, nil, logger)
+      file_mutex.synchronize do
+        current = [file.size, file.mtime]
+        if snapshot[0] == current[0] && snapshot[1] == current[1]
+          rewrite_position_file(file, file_mutex, map, entries, locked: true)
+        end
+      end
+      entries
+    end
+
+    def self.capture_position_file_identity(file, file_mutex)
+      file_mutex.synchronize do
+        [file.size, file.mtime]
+      end
+    end
+
+    def self.rewrite_position_file(file, file_mutex, map, entries, locked: false)
+      writer = lambda do
+        file.pos = 0
+        file.truncate(0)
+        file.write(entries.values.map(&:to_entry_fmt).join)
+        entries.each do |key, val|
+          if (m = map[key])
+            m.seek = val.seek
+          end
+        end
+      end
+      if locked
+        writer.call
+      else
+        file_mutex.synchronize { writer.call }
+      end
+    end
+
+    def self.fetch_compacted_position_entries(file, follow_inodes, existing_targets, logger)
+      entries = {}
+      file.pos = 0
+      file_pos = 0
+      file.each_line do |line|
+        parsed = parse_position_file_line(line)
+        if parsed.nil?
+          logger.warn "Unparsable line in pos_file: #{line}" if logger
+          next
+        end
+        path, pos, ino = parsed
+        if pos == PositionFile::UNWATCHED_POSITION
+          logger.debug "Remove unwatched line from pos_file: #{line}" if logger
+        else
+          if entries.include?(path)
+            logger.warn("#{path} already exists. use latest one: deleted #{entries[path]}") if logger
+          end
+          packed = Entry.new(path, pos, ino, file_pos + path.bytesize + 1)
+          if follow_inodes
+            entries[ino] = packed
+          else
+            entries[path] = packed
+          end
+          file_pos += line.size
+        end
+      end
+      entries = remove_missing_position_targets(entries, existing_targets) if follow_inodes
+      entries
+    end
+
+    def self.remove_missing_position_targets(existent_entries, existing_targets)
+      if existing_targets
+        existent_entries.select { |path_or_ino|
+          existing_targets.key?(path_or_ino)
+        }
+      else
+        existent_entries
+      end
+    end
+
+    def self.parse_position_file_line(line)
+      m = PositionFile::POSITION_FILE_ENTRY_REGEX.match(line)
+      return nil if m.nil?
+      path = m[1]
+      pos = m[2].to_i(16)
+      ino = m[3].to_i(16)
+      [path, pos, ino]
+    end
+
+    def self.fetch_or_build_shared_variable(namespace, default_value = {})
+      store = Fluent::VariableStore.instance_variable_get(:@data)
+      store[namespace] ||= default_value
+    end
+
+    def self.reset_shared_variables
+      store_holder = Fluent::VariableStore
+      old = store_holder.instance_variable_get(:@data)
+      store_holder.instance_variable_set(:@data, {})
+      begin
+        yield
+      rescue
+        store_holder.instance_variable_set(:@data, old)
+        raise
+      end
+    end
+
+    def self.probe_process_capability(capng, type, capability, usable)
+      if !usable
+        false
+      elsif capng.nil?
+        false
+      else
+        capng.have_capability?(type, capability)
+      end
+    end
+
+    def self.apply_process_capability(capng, select_set, usable)
+      if !usable
+        false
+      elsif capng.nil?
+        false
+      else
+        capng.apply(select_set)
+      end
+    end
+
+    def self.clear_process_capability(capng, select_set, usable)
+      if !usable
+        false
+      elsif capng.nil?
+        false
+      else
+        capng.clear(select_set)
+      end
+    end
+
+    def self.update_process_capability(capng, action, type, capability_or_capability_array, usable)
+      if !usable
+        false
+      elsif capng.nil?
+        false
+      else
+        capng.update(action, type, capability_or_capability_array)
+      end
+    end
+
+    def self.probe_process_capabilities(capng, select_set, usable)
+      if !usable
+        false
+      elsif capng.nil?
+        false
+      else
+        capng.have_capabilities?(select_set)
+      end
+    end
+
+    def self.capability_runtime_usable?(capng)
+      if capng.nil?
+        false
+      else
+        true
+      end
+    end
+
+    def self.append_multi_event(time_array, record_array, time, record)
+      time_array << time
+      record_array << record
+    end
+
+    def self.multi_event_size(time_array)
+      if time_array.nil?
+        0
+      else
+        time_array.size
+      end
+    end
+
+    def self.multi_event_empty?(time_array)
+      if time_array.nil?
+        true
+      else
+        time_array.empty?
+      end
+    end
+
+    def self.each_multi_event(time_array, record_array, &block)
+      return nil if time_array.nil? || record_array.nil?
+      last_index = time_array.length - 1
+      if last_index < 0
+        return nil
+      end
+      for i in 0..last_index
+        block.call(time_array[i], record_array[i])
+      end
+      nil
+    end
+
+    def self.slice_multi_event(time_array, record_array, index, num)
+      times = time_array.slice(index, num)
+      records = record_array.slice(index, num)
+      Fluent::MultiEventStream.new(times, records)
+    end
+
+    def self.dup_multi_event(time_array, record_array)
+      copied_times = time_array.dup
+      copied_records = record_array.map(&:dup)
+      Fluent::MultiEventStream.new(copied_times, copied_records)
     end
 
