+    def position_storage_key(target_info, follow = nil)
+      @position_catalog ||= {}
+      follow_flag = follow.nil? ? @position_follow_flag : follow
+      if target_info.nil?
+        return nil
+      end
+      if follow_flag
+        target_info.ino
+      else
+        target_info.path
+      end
