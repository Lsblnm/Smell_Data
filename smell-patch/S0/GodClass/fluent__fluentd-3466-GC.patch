+    def attach_position_file_owner(position_file)
+      @position_catalog ||= {}
+      @position_guard ||= Mutex.new
+      @position_handle = position_file
+      @position_follow_flag = position_file.follow_inodes
+      @position_log_sink = position_file.logger
+      @position_last_compact_size = nil
+      @position_last_compact_mtime = nil
+      @position_unwatched_keys = []
+      @position_load_generation = (@position_load_generation || 0) + 1
+      @position_guard.synchronize do
+        @position_catalog.clear unless @position_catalog.empty?
+        position_file.owner = self
+        @position_handle
+      end
+    end
+
+    def fetch_position_entry(position_file, target_info)
+      @position_catalog ||= {}
+      @position_guard ||= Mutex.new
+      @position_handle = position_file
+      @position_follow_flag = position_file.follow_inodes
+      key = position_storage_key(target_info, @position_follow_flag)
+      @position_guard.synchronize do
+        entry = TailInput.lookup_position_entry(
+          position_file.file,
+          position_file.file_mutex,
+          position_file.map,
+          position_file.follow_inodes,
+          target_info
+        )
+        remember_position_entry(key, entry)
+        entry
+      end
+    end
+
+    def remember_position_entry(key, entry)
+      @position_catalog ||= {}
+      @position_guard ||= Mutex.new
+      if key.nil? || entry.nil?
+        return entry
+      end
+      @position_catalog[key] = entry
+      if @position_unwatched_keys && @position_unwatched_keys.include?(key)
+        @position_unwatched_keys.delete(key)
+      end
+      entry
+    end
+
+    def unwatch_position_target(position_file, target_info)
+      @position_catalog ||= {}
+      @position_guard ||= Mutex.new
+      @position_handle = position_file
+      @position_follow_flag = position_file.follow_inodes
+      key = position_storage_key(target_info, @position_follow_flag)
+      @position_guard.synchronize do
+        TailInput.unwatch_position_entry(
+          position_file.map,
+          position_file.follow_inodes,
+          target_info
+        )
+        note_unwatched_position(key)
+        @position_catalog.delete(key)
+      end
+    end
+
+    def reload_position_catalog(position_file, existing_targets = nil)
+      @position_catalog ||= {}
+      @position_guard ||= Mutex.new
+      @position_handle = position_file
+      @position_follow_flag = position_file.follow_inodes
+      @position_log_sink = position_file.logger
+      @position_guard.synchronize do
+        map = TailInput.load_position_map(
+          position_file.file,
+          position_file.file_mutex,
+          position_file.follow_inodes,
+          existing_targets,
+          position_file.logger
+        )
+        position_file.replace_map(map)
+        @position_catalog = map.dup
+        @position_load_generation = (@position_load_generation || 0) + 1
+        @position_catalog
+      end
+    end
+
+    def compact_position_file(position_file)
+      @position_catalog ||= {}
+      @position_guard ||= Mutex.new
+      @position_handle = position_file
+      @position_follow_flag = position_file.follow_inodes
+      @position_log_sink = position_file.logger
+      snapshot = TailInput.capture_position_file_identity(position_file.file, position_file.file_mutex)
+      entries = position_file.send(:fetch_compacted_entries)
+      position_file.file_mutex.synchronize do
+        if should_rewrite_position_file?(position_file, snapshot[0], snapshot[1])
+          TailInput.rewrite_position_file(position_file.file, position_file.file_mutex, position_file.map, entries, locked: true)
+        end
+      end
+      reload_position_index(entries)
+      entries
