+    def note_unwatched_position(key)
+      @position_catalog ||= {}
+      @position_unwatched_keys ||= []
+      @position_load_generation ||= 0
+      if key.nil?
+        return @position_unwatched_keys
+      end
+      unless @position_unwatched_keys.include?(key)
+        @position_unwatched_keys << key
+      end
+      @position_catalog.delete(key)
+      @position_unwatched_keys
