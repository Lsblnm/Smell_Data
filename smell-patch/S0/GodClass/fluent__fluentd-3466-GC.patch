+    def prepare_file_access_policy(capability)
+      @access_cache ||= {}
+      @access_guard ||= Mutex.new
+      @access_probe = capability
+      @access_cache[:probe] = capability
+      @access_denied_paths = []
+      @access_granted = false
+      @access_dac_search = false
+      @access_dac_override = false
+      @access_probe_usable = capability ? capability.usable? : false
+      @access_cache_generation = 0
+      refresh_capability_flags
+      @access_probe
+    end
+
+    def path_is_readable?(path)
+      @access_cache ||= {}
+      if path.nil? || path.empty?
+        @access_cache[:last_path] = path
+        return false
+      end
+      @access_cache[:last_path] = path
+      if file_readable_without_elevated_rights?(path)
+        true
+      elsif path_access_denied?(path)
+        capability_allows_file_read?
+      else
+        capability_allows_file_read?
+      end
+    end
+
+    def file_readable_without_elevated_rights?(path)
+      @access_cache ||= {}
+      @access_cache[:checked_path] = path
+      begin
+        File.readable?(path)
+      rescue Errno::ENOENT, Errno::EACCES => e
+        @access_cache[:last_error] = e
+        remember_denied_path(path)
+        false
+      end
+    end
+
+    def capability_allows_file_read?
+      @access_cache ||= {}
+      probe = access_probe
+      if probe.nil?
+        @access_granted = false
+        return false
+      end
+      refresh_capability_flags
+      if @access_dac_search
+        true
+      elsif @access_dac_override
+        true
+      else
+        @access_granted
+      end
+    end
+
+    def refresh_capability_flags
+      @access_cache ||= {}
+      probe = @access_cache[:probe] || @access_probe
+      @access_cache_generation = (@access_cache_generation || 0) + 1
+      if probe.nil?
+        @access_dac_search = false
+        @access_dac_override = false
+        @access_granted = false
+        @access_probe_usable = false
+        return false
+      end
+      @access_probe_usable = probe.usable?
+      @access_dac_search = probe.have_capability?(:effective, :dac_read_search)
+      @access_dac_override = probe.have_capability?(:effective, :dac_override)
+      @access_granted = @access_dac_search || @access_dac_override
+      @access_cache[:privilege] = @access_granted
+      @access_granted
+    end
+
+    def access_probe
+      @access_cache ||= {}
+      if @access_probe
+        @access_cache[:probe] = @access_probe
+        return @access_probe
+      end
+      if @access_cache[:probe]
+        @access_probe = @access_cache[:probe]
+        return @access_probe
+      end
+      @access_probe = Fluent::Capability.new(:current_process)
+      @access_cache[:probe] = @access_probe
+      @access_probe_usable = @access_probe.usable?
+      @access_probe
+    end
+
+    def remember_denied_path(path)
+      @access_cache ||= {}
+      @access_denied_paths ||= []
+      @access_cache[:denied] = path
+      if path.nil?
+        return @access_denied_paths
+      end
+      unless @access_denied_paths.include?(path)
+        @access_denied_paths << path
+      end
+      @access_denied_paths
+    end
+
+    def path_access_denied?(path)
+      @access_cache ||= {}
+      @access_denied_paths ||= []
+      if path.nil?
+        false
+      elsif @access_denied_paths.include?(path)
+        @access_cache[:denied] = path
+        true
+      else
+        false
+      end
+    end
+
+    def forget_path_access(path)
+      @access_cache ||= {}
+      @access_denied_paths ||= []
+      @access_cache_generation = (@access_cache_generation || 0) + 1
+      if path.nil?
+        @access_denied_paths.clear
+        @access_cache.delete(:denied)
+        @access_cache.delete(:last_path)
+      else
+        @access_denied_paths.delete(path)
+        @access_cache.delete(:denied) if @access_cache[:denied] == path
+      end
+      @access_denied_paths
+    end
+
+    def classify_stat_failure(path, error)
+      @access_cache ||= {}
+      @access_cache[:last_error] = error
+      @access_cache[:last_path] = path
+      if error.is_a?(Errno::ENOENT)
+        remember_denied_path(path)
+        :missing
+      elsif error.is_a?(Errno::EACCES)
+        remember_denied_path(path)
+        :forbidden
+      else
+        :unknown
+      end
+    end
