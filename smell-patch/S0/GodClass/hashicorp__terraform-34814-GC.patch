+func (p *provisioner) applyLocalCommand(ctx context.Context, req provisioners.ProvisionResourceRequest) (resp provisioners.ProvisionResourceResponse) {
+	if err := p.validateLocalCommand(req.Config); err != nil {
+		resp.Diagnostics = resp.Diagnostics.Append(tfdiags.WholeContainingBody(
+			tfdiags.Error,
+			"Invalid local-exec provisioner command",
+			err.Error(),
+		))
+		return resp
+	}
+	p.collectEnvironment(req.Config)
+	p.buildInterpreter(req.Config)
+	p.resolveWorkingDir(req.Config)
+	p.applyQuietFlag(req.Config)
+	p.assembleCommand()
+
+	pr, pw, err := os.Pipe()
+	if err != nil {
+		resp.Diagnostics = resp.Diagnostics.Append(tfdiags.WholeContainingBody(
+			tfdiags.Error,
+			"local-exec provisioner error",
+			fmt.Sprintf("Failed to initialize pipe for output: %s", err),
+		))
+		return resp
+	}
+
+	p.local.env = os.Environ()
+	p.local.env = append(p.local.env, p.local.extraEnv...)
+
+	cmd := exec.CommandContext(ctx, p.local.cmdArgs[0], p.local.cmdArgs[1:]...)
+	cmd.Stderr = pw
+	cmd.Stdout = pw
+	cmd.Dir = p.local.workingDir
+	cmd.Env = p.local.env
+
+	p.local.output = newLimitedBuffer(localOutputLimit)
+	tee := io.TeeReader(pr, p.local.output)
+	copyDoneCh := make(chan struct{})
+	go p.copyLocalOutput(req.UIOutput, tee, copyDoneCh)
+
+	if p.local.quiet {
+		req.UIOutput.Output("local-exec: Executing: Suppressed by quiet=true")
+	} else {
+		req.UIOutput.Output(fmt.Sprintf("Executing: %q", p.local.cmdArgs))
+	}
+
+	err = p.startLocalCommand(cmd)
+	if err == nil {
+		err = p.waitLocalCommand(cmd)
+	}
+	pw.Close()
+
+	select {
+	case <-copyDoneCh:
+	case <-ctx.Done():
+	}
+
+	if err != nil {
+		resp.Diagnostics = resp.Diagnostics.Append(tfdiags.WholeContainingBody(
+			tfdiags.Error,
+			"local-exec provisioner error",
+			p.localCommandError(err),
+		))
+		return resp
+	}
+	return resp
+}
+
+func (p *provisioner) validateLocalCommand(cfg cty.Value) error {
