+func (p *provisioner) validateFileConfig(cfg cty.Value) error {
+	p.files.mode = ""
+	p.files.source = ""
+	p.files.content = ""
+	p.files.dest = ""
+	if cfg.IsNull() {
+		p.files.err = errors.New("Must provide one of 'source' or 'content'")
+		return p.files.err
+	}
+	if !cfg.Type().IsObjectType() {
+		p.files.err = errors.New("Must provide one of 'source' or 'content'")
+		return p.files.err
+	}
+
+	attrs := cfg.Type().AttributeTypes()
+	var source, content cty.Value
+	if _, ok := attrs["source"]; ok {
+		source = cfg.GetAttr("source")
+	} else {
+		source = cty.NullVal(cty.String)
+	}
+	if _, ok := attrs["content"]; ok {
+		content = cfg.GetAttr("content")
+	} else {
+		content = cty.NullVal(cty.String)
+	}
+
+	switch {
+	case !source.IsNull() && !content.IsNull():
+		p.files.err = errors.New("Cannot set both 'source' and 'content'")
+		return p.files.err
+	case source.IsNull() && content.IsNull():
+		p.files.err = errors.New("Must provide one of 'source' or 'content'")
+		return p.files.err
+	case !content.IsNull():
+		p.files.mode = "content"
+	default:
+		p.files.mode = "source"
+	}
+	return nil
+}
