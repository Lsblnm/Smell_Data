+func (p *provisioner) retryConnect(ctx context.Context, comm communicator.Communicator, o provisioners.UIOutput) error {
+	p.conn.retryDelay = 0
+	p.conn.retryAttempts = 0
+	p.conn.lastErr = nil
+	p.conn.connected = false
+
+	type errWrap struct {
+		E error
+	}
+	var errVal atomic.Value
+	doneCh := make(chan struct{})
+	go func() {
+		defer close(doneCh)
+		delay := time.Duration(0)
+		for {
+			select {
+			case <-ctx.Done():
+				return
+			case <-time.After(delay):
+			}
+
+			err := comm.Connect(o)
+			done := false
+			switch e := err.(type) {
+			case nil:
+				done = true
+			case communicator.Fatal:
+				err = e.FatalError()
+				done = true
+			}
+
+			p.conn.retryAttempts++
+			p.conn.lastErr = err
+			p.conn.retryDelay = delay
+			errVal.Store(errWrap{err})
+			if done {
+				if err == nil {
+					p.markConnected()
+				} else {
+					p.markDisconnected()
+				}
+				return
+			}
+
+			log.Printf("[WARN] retryable error: %v", err)
+			delay = p.nextRetryDelay(delay)
+			log.Printf("[INFO] sleeping for %s", delay)
+		}
+	}()
+
+	select {
+	case <-ctx.Done():
+	case <-doneCh:
+	}
+
+	var lastErr error
+	if ev, ok := errVal.Load().(errWrap); ok {
+		lastErr = ev.E
+	}
+	p.conn.lastErr = lastErr
+
+	switch ctx.Err() {
+	case context.Canceled:
+		p.conn.connected = false
+		return fmt.Errorf("interrupted - last error: %v", lastErr)
+	case context.DeadlineExceeded:
+		p.conn.connected = false
+		return fmt.Errorf("timeout - last error: %v", lastErr)
+	}
+
+	if lastErr != nil {
+		p.markDisconnected()
+		return p.classifyConnError(lastErr)
+	}
+	if p.connectionReady() {
+		p.markConnected()
+		return nil
+	}
+	p.markConnected()
+	return nil
+}
+
+func (p *provisioner) nextRetryDelay(current time.Duration) time.Duration {
+	if current == 0 {
+		p.conn.retryDelay = defaultRetryDelay
+		return p.conn.retryDelay
+	}
+	next := current * 2
+	if next > maxRetryDelay {
+		next = maxRetryDelay
+	}
+	p.conn.retryDelay = next
+	return next
+}
+
+func (p *provisioner) markConnected() {
+	p.conn.connected = true
+	p.conn.lastErr = nil
+}
+
+func (p *provisioner) markDisconnected() {
+	p.conn.connected = false
+}
+
+func (p *provisioner) connectionReady() bool {
+	if !p.conn.connected || p.conn.comm == nil {
+		return false
+	}
+	if p.conn.lastErr != nil {
+		return false
+	}
+	return true
+}
+
+func (p *provisioner) classifyConnError(err error) error {
+	if err == nil {
+		p.conn.lastErr = nil
+		return nil
+	}
+	msg := err.Error()
+	switch {
+	case strings.Contains(msg, "timeout"):
+		p.conn.lastErr = fmt.Errorf("timeout - last error: %v", err)
+	case strings.Contains(msg, "interrupt"):
+		p.conn.lastErr = fmt.Errorf("interrupted - last error: %v", err)
+	case strings.Contains(msg, "auth"):
+		p.conn.lastErr = fmt.Errorf("authentication failed: %v", err)
+	default:
+		p.conn.lastErr = err
+	}
+	return p.conn.lastErr
+}
