+func (p *provisioner) copyFiles(ctx context.Context, comm communicator.Communicator, src, dst string) error {
+	p.files.source = src
+	p.files.dest = dst
+	retryCtx, cancel := context.WithTimeout(ctx, comm.Timeout())
+	defer cancel()
+
+	err := p.retryConnect(retryCtx, comm, nil)
+	if err != nil {
+		p.files.err = err
+		return err
+	}
+
+	go func() {
+		<-ctx.Done()
+		comm.Disconnect()
+	}()
+
+	if err := p.statFileSource(); err != nil {
+		return err
+	}
+	if p.files.isDir {
+		return p.uploadDirectory(comm)
+	}
+	return p.uploadSingleFile(comm)
+}
