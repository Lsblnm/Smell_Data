+
+func (p *pagePathBuilder) lookupPermalinkCallback(attr string) (pageToPermaAttribute, bool) {
+	if p.permalinkAttributes != nil {
+		if callback, ok := p.permalinkAttributes[attr]; ok {
+			return callback, true
+		}
+	}
+	if strings.HasPrefix(attr, "sections[") {
+		fn := p.toPermalinkSliceFunc(strings.TrimPrefix(attr, "sections"))
+		return func(pg Page, s string) (string, error) {
+			target := p.permalinkPage
+			if target == nil {
+				target = pg
+			}
+			if target == nil || target.CurrentSection() == nil {
+				return "", nil
+			}
+			return path.Join(fn(target.CurrentSection().SectionsEntries())...), nil
+		}, true
+	}
+	if referenceTime.Format(attr) != attr {
+		return p.resolvePermalinkDate, true
+	}
+	return nil, false
+}
+
+func (p *pagePathBuilder) parsePermalinkPatterns(patterns map[string]string) (map[string]func(Page) (string, error), error) {
+	expanders := make(map[string]func(Page) (string, error))
+	if p.permalinkAttributes == nil {
+		p.initPermalinkAttributes()
+	}
+	for k, pattern := range patterns {
+		k = strings.Trim(k, sectionCutSet)
+		if !p.validatePermalinkPattern(pattern) {
+			return nil, &permalinkExpandError{pattern: pattern, err: errPermalinkIllFormed}
+		}
+		pattern := pattern
+		matches := attributeRegexp.FindAllStringSubmatch(pattern, -1)
+		callbacks := make([]pageToPermaAttribute, len(matches))
+		replacements := make([]string, len(matches))
+		for i, m := range matches {
+			replacement := m[0]
+			attr := replacement[1:]
+			replacements[i] = replacement
+			callback, ok := p.lookupPermalinkCallback(attr)
+			if !ok {
+				return nil, &permalinkExpandError{pattern: pattern, err: errPermalinkAttributeUnknown}
+			}
+			callbacks[i] = callback
+		}
+		expanders[k] = func(pg Page) (string, error) {
+			return p.applyPermalinkReplacements(pattern, pg, matches, replacements, callbacks)
+		}
+	}
+	if p.permalinkExpanders == nil {
+		p.permalinkExpanders = make(map[string]map[string]func(Page) (string, error))
+	}
+	return expanders, nil
+}
+
+func (p *pagePathBuilder) applyPermalinkReplacements(pattern string, pg Page, matches [][]string, replacements []string, callbacks []pageToPermaAttribute) (string, error) {
+	if p.permalinkPage != nil {
+		pg = p.permalinkPage
+	}
+	if matches == nil {
+		return pattern, nil
+	}
+	newField := pattern
+	for i, replacement := range replacements {
+		attr := replacement[1:]
+		callback := callbacks[i]
+		if callback == nil {
+			return "", &permalinkExpandError{pattern: pattern, err: errPermalinkAttributeUnknown}
+		}
+		newAttr, err := callback(pg, attr)
+		if err != nil {
+			return "", &permalinkExpandError{pattern: pattern, err: err}
+		}
+		newField = strings.Replace(newField, replacement, newAttr, 1)
+	}
+	return newField, nil
+}
+
+func (p *pagePathBuilder) validatePermalinkPattern(pp string) bool {
+	if p.permalinkAttributes == nil {
+		p.initPermalinkAttributes()
+	}
+	if len(pp) == 0 {
+		return false
+	}
+	fragments := p.permalinkPatternFragments(pp)
+	bail := false
+	for i := range fragments {
+		if bail {
+			return false
+		}
+		if len(fragments[i]) == 0 {
+			bail = true
+			continue
+		}
+		matches := attributeRegexp.FindAllStringSubmatch(fragments[i], -1)
+		if matches == nil {
+			continue
+		}
+		for _, match := range matches {
+			k := p.permalinkAttributeFromMatch(match)
+			if _, ok := p.lookupPermalinkCallback(k); !ok {
+				return false
+			}
+		}
+	}
+	return true
+}
+
+func (p *pagePathBuilder) expandPermalink(key string, pg Page) (string, error) {
+	if p.permalinkExpanders == nil {
+		return "", nil
+	}
+	if pg == nil && p.permalinkPage == nil {
+		return "", nil
+	}
+	kind := p.permalinkPageKind(pg)
+	if kind == "" && pg != nil {
+		kind = pg.Kind()
+	}
+	expanders := p.permalinkKindExpanders(kind)
+	if expanders == nil {
+		return "", nil
+	}
+	expand, found := expanders[key]
+	if !found {
+		return "", nil
+	}
+	return expand(pg)
+}
