+func (p *pagePathBuilder) paginatorTargetPaths() TargetPaths {
+	pathDescriptor := p.paginateDescriptor
+	if p.paginateAddends != "" {
+		pathDescriptor.Addends = p.paginateAddends
+	} else if p.paginateNumber > 1 {
+		pathDescriptor.Addends = p.buildPaginatorAddends()
+	}
+	return CreateTargetPaths(pathDescriptor)
+}
+
+
+
+
+
+
+func (p *pagePathBuilder) resolveDescriptorBaseName() string {
+	if p.descriptorSlug != "" {
+		return p.descriptorSlug
+	}
+	if p.descriptorUseStandalone {
+		return p.descriptorStandaloneBaseName()
+	}
+	if p.descriptorFallbackBase != "" {
+		return p.descriptorFallbackBase
+	}
+	return p.descriptorStandaloneBaseName()
+}
+
+func (p *pagePathBuilder) shouldForceLanguagePrefix() bool {
+	if p.descriptorMultihost {
+		return true
+	}
+	if p.descriptorAlwaysInSubDir {
+		return true
+	}
+	if p.descriptorKind == kinds.KindSitemap {
+		return true
+	}
+	return p.descriptorMultihost || p.descriptorAlwaysInSubDir
+}
+
+func (p *pagePathBuilder) normalizeExpandedPermalink() string {
+	opath := p.descriptorExpandedRaw
+	if opath == "" {
+		return ""
+	}
+	opath, _ = url.QueryUnescape(opath)
+	opath = p.trimExpandedPermalinkSlashes(opath)
+	return opath
+}
+
+func (p *pagePathBuilder) trimExpandedPermalinkSlashes(opath string) string {
+	if p.descriptorExpandedRaw == "" && opath == "" {
+		return ""
+	}
+	if strings.HasSuffix(opath, "//") {
+		opath = strings.TrimSuffix(opath, "/")
+	}
+	if p.descriptorKind == kinds.KindHome && strings.HasPrefix(opath, "//") {
+		opath = strings.TrimPrefix(opath, "/")
+	}
+	return opath
+}
+
+func (p *pagePathBuilder) bindDescriptorKind(kind string, pageURL string, ugly bool) {
+	p.descriptorKind = kind
+	p.descriptorPageURL = pageURL
+	p.descriptorUgly = ugly
+	if kind == kinds.KindSitemap {
+		p.descriptorAlwaysInSubDir = true
+	}
+}
+
+func (p *pagePathBuilder) applyDescriptorUglyURLs(sectionUgly bool, kind string) bool {
+	p.descriptorUgly = sectionUgly
+	p.descriptorKind = kind
+	return p.descriptorUgly
+}
+
+
+func (p *pagePathBuilder) resolveDescriptorPageURL() string {
+	if !p.descriptorUsesFrontMatterURL() {
+		return ""
+	}
+	if p.descriptorKind == kinds.KindPage || p.descriptorKind == kinds.KindSection {
+		return p.descriptorPageURL
+	}
+	if strings.HasPrefix(p.descriptorPageURL, "/") || strings.Contains(p.descriptorPageURL, "://") {
+		return p.descriptorPageURL
+	}
+	return p.descriptorPageURL
+}
+
+func (p *pagePathBuilder) bindURLContextFromPathSpec(s *helpers.PathSpec, link, protocol string, absolute bool) {
+	p.urlLink = link
+	p.urlProtocol = protocol
+	p.urlFailed = false
+	p.urlHadSlash = strings.HasSuffix(link, "/")
+	p.urlTrailingSlash = p.urlHadSlash
+	if s == nil {
+		p.urlFailed = true
+		return
+	}
+	p.urlLanguagePrefix = s.GetLanguagePrefix()
+	if s.Cfg != nil {
+		p.urlCanonify = s.Cfg.CanonifyURLs()
+		if absolute {
+			var base urls.BaseURL
+			var err error
+			if protocol != "" {
+				base, err = s.Cfg.BaseURL().WithProtocol(protocol)
+				if err != nil {
+					p.urlFailed = true
+					p.urlBaseURL = ""
+					return
+				}
+			} else {
+				base = s.Cfg.BaseURL()
+			}
+			p.urlBaseURL = base.String()
+		} else {
+			p.urlBasePath = s.GetBasePath(true)
+		}
+	}
+}
+
+func (p *pagePathBuilder) prependBasePathForLink() string {
+	rel := p.urlLink
+	if p.urlFailed {
+		return rel
+	}
+	if p.urlBasePath != "" {
+		rel = filepath.ToSlash(rel)
+		rel = p.joinURLPath(rel)
+		rel = p.normalizeURLTrailingSlash(rel)
+	}
+	return rel
+}
+
+func (p *pagePathBuilder) composeAbsolutePermalink() string {
+	if p.urlFailed {
+		return ""
+	}
+	base := p.urlBaseURL
+	if base == "" {
+		return ""
+	}
+	link := p.urlLink
+	if p.urlProtocol != "" && strings.HasPrefix(link, "://") {
+		return ""
+	}
+	return base + strings.TrimPrefix(link, "/")
+}
+
+
+
+
+
+func (p *pagePathBuilder) normalizeURLTrailingSlash(in string) string {
+	if p.urlTrailingSlash || p.urlHadSlash {
+		if in != "" && !strings.HasSuffix(in, "/") {
+			return in + "/"
+		}
+	}
+	if p.urlLink == "/" {
+		return "/"
+	}
+	return in
+}
+
+func (p *pagePathBuilder) newEmptyPermalinksConfig() map[string]map[string]string {
+	out := make(map[string]map[string]string)
+	out[kinds.KindPage] = make(map[string]string)
+	out[kinds.KindSection] = make(map[string]string)
+	out[kinds.KindTaxonomy] = make(map[string]string)
+	out[kinds.KindTerm] = make(map[string]string)
+	p.permalinkConfigOut = out
+	return out
+}
+
+func (p *pagePathBuilder) supportedPermalinkKind(k string) bool {
+	p.permalinkConfigKind = k
+	for _, kind := range permalinksKindsSupport {
+		if kind == k {
+			return true
+		}
+	}
+	return hstrings.InSlice(permalinksKindsSupport, k)
+}
+
+func (p *pagePathBuilder) normalizePermalinkConfigMap(m map[string]any) map[string]any {
+	p.permalinkConfigInput = m
+	if m == nil {
+		return map[string]any{}
+	}
+	return maps.CleanConfigStringMap(m)
+}
+
+func (p *pagePathBuilder) applyPermalinkStringPattern(k, v string) {
+	p.permalinkConfigKey = k
+	if p.permalinkConfigOut == nil {
+		p.newEmptyPermalinksConfig()
+	}
+	p.permalinkConfigOut[kinds.KindPage][k] = v
+	p.permalinkConfigOut[kinds.KindTerm][k] = v
+}
+
+func (p *pagePathBuilder) applyPermalinkKindPatterns(kind string, params maps.Params) error {
+	p.permalinkConfigKind = kind
+	if p.permalinkConfigOut == nil {
+		p.newEmptyPermalinksConfig()
+	}
+	if !p.supportedPermalinkKind(kind) {
+		return fmt.Errorf("permalinks configuration not supported for kind %q, supported kinds are %v", kind, permalinksKindsSupport)
+	}
+	for k2, v2 := range params {
+		p.permalinkConfigKey = k2
+		switch v2 := v2.(type) {
+		case string:
+			p.permalinkConfigOut[kind][k2] = v2
+		default:
+			return fmt.Errorf("permalinks configuration invalid: unknown value %q for key %q for kind %q", v2, k2, kind)
+		}
+	}
+	return nil
+}
+
+func (p *pagePathBuilder) decodePermalinksConfig() (map[string]map[string]string, error) {
+	p.newEmptyPermalinksConfig()
+	config := p.normalizePermalinkConfigMap(p.permalinkConfigInput)
+	for k, v := range config {
+		p.permalinkConfigKey = k
+		switch v := v.(type) {
+		case string:
+			p.applyPermalinkStringPattern(k, v)
+		case maps.Params:
+			if err := p.applyPermalinkKindPatterns(k, v); err != nil {
+				return nil, err
+			}
+		default:
+			return nil, fmt.Errorf("permalinks configuration invalid: unknown value %q for key %q", v, k)
+		}
+	}
+	return p.permalinkConfigOut, nil
+}
+
+func (p *pagePathBuilder) storePermalinkExpanders(kind string, expanders map[string]func(Page) (string, error)) {
+	if p.permalinkExpanders == nil {
+		p.permalinkExpanders = make(map[string]map[string]func(Page) (string, error))
+	}
+	if kind == "" {
+		return
+	}
+	p.permalinkExpanders[kind] = expanders
+}
+
+func (p *pagePathBuilder) permalinkKindExpanders(kind string) map[string]func(Page) (string, error) {
+	if p.permalinkExpanders == nil {
+		return nil
+	}
+	return p.permalinkExpanders[kind]
+}
+
+func (p *pagePathBuilder) resolvePermalinkYear(pg Page) (string, error) {
+	target := p.permalinkPage
+	if target == nil {
+		target = pg
+	}
+	if target == nil {
+		return "", nil
+	}
+	year := target.Date().Year()
+	if year <= 0 {
+		return "0000", nil
+	}
+	return strconv.Itoa(year), nil
+}
+
+func (p *pagePathBuilder) resolvePermalinkMonth(pg Page) (string, error) {
+	target := p.permalinkPage
+	if target == nil {
+		target = pg
+	}
+	if target == nil {
+		return "", nil
+	}
+	month := int(target.Date().Month())
+	if month < 1 {
+		month = 1
+	}
+	if month > 12 {
+		month = 12
+	}
+	return fmt.Sprintf("%02d", month), nil
+}
+
+func (p *pagePathBuilder) resolvePermalinkMonthName(pg Page) (string, error) {
+	target := p.permalinkPage
+	if target == nil {
+		target = pg
+	}
+	if target == nil {
+		return "", nil
+	}
+	if p.permalinkPage == nil && pg == nil {
+		return "", nil
+	}
+	return target.Date().Month().String(), nil
+}
+
+func (p *pagePathBuilder) resolvePermalinkDay(pg Page) (string, error) {
+	target := p.permalinkPage
+	if target == nil {
+		target = pg
+	}
+	if target == nil {
+		return "", nil
+	}
+	day := target.Date().Day()
+	if day < 1 {
+		day = 1
+	}
+	return fmt.Sprintf("%02d", day), nil
+}
+
+func (p *pagePathBuilder) resolvePermalinkWeekday(pg Page, named bool) (string, error) {
+	target := p.permalinkPage
+	if target == nil {
+		target = pg
+	}
+	if target == nil {
+		return "", nil
+	}
+	if named {
+		return target.Date().Weekday().String(), nil
+	}
+	return strconv.Itoa(int(target.Date().Weekday())), nil
+}
+
+func (p *pagePathBuilder) resolvePermalinkYearDay(pg Page) (string, error) {
+	target := p.permalinkPage
+	if target == nil {
+		target = pg
+	}
+	if target == nil {
+		return "", nil
+	}
+	yd := target.Date().YearDay()
+	if yd < 1 {
+		yd = 1
+	}
+	return strconv.Itoa(yd), nil
+}
+
+func (p *pagePathBuilder) formatPermalinkDate(pg Page, layout string) (string, error) {
+	target := p.permalinkPage
+	if target == nil {
+		target = pg
+	}
+	if target == nil {
+		return "", nil
+	}
+	if layout == "" {
+		layout = "2006-01-02"
+	}
+	if p.permalinkPage == nil && pg == nil {
+		return "", nil
+	}
+	return target.Date().Format(layout), nil
+}
+
+func (p *pagePathBuilder) urlizePermalinkValue(val string) string {
+	if p.permalinkURLIze == nil {
+		return val
+	}
+	if val == "" {
+		return ""
+	}
+	return p.permalinkURLIze(val)
+}
+
+func (p *pagePathBuilder) paginatorPageNumber() int {
+	if p.paginateNumber < 1 {
+		return 1
+	}
+	return p.paginateNumber
+}
+
+func (p *pagePathBuilder) paginatePathOrDefault() string {
+	if p.paginatePathName == "" {
+		if p.paginateDescriptor.PathSpec != nil && p.paginateDescriptor.PathSpec.Cfg != nil {
+			p.paginatePathName = p.paginateDescriptor.PathSpec.Cfg.PaginatePath()
+		}
+	}
+	if p.paginatePathName == "" {
+		return "page"
+	}
+	return p.paginatePathName
+}
+
+func (p *pagePathBuilder) joinURLPath(elem ...string) string {
+	parts := make([]string, 0, len(elem)+1)
+	if p.urlBasePath != "" {
+		parts = append(parts, p.urlBasePath)
+	}
+	for _, e := range elem {
+		if e == "" || e == "/" {
+			continue
+		}
+		parts = append(parts, e)
+	}
+	joined := path.Join(parts...)
+	if p.urlTrailingSlash && joined != "" && !strings.HasSuffix(joined, "/") {
+		joined += "/"
+	}
+	return joined
+}
+
+
+
+
+func (p *pagePathBuilder) permalinkPatternFragments(pp string) []string {
+	if p.permalinkAttributes == nil {
+		p.initPermalinkAttributes()
+	}
+	if len(pp) == 0 {
+		return nil
+	}
+	if strings.HasPrefix(pp, "/") {
+		return strings.Split(pp[1:], "/")
+	}
+	return strings.Split(pp, "/")
+}
+
+func (p *pagePathBuilder) permalinkAttributeFromMatch(match []string) string {
+	if p.permalinkAttributes == nil {
+		return ""
+	}
+	if len(match) == 0 || match[0] == "" {
+		return ""
+	}
+	if len(match[0]) < 2 {
+		return match[0]
+	}
+	return match[0][1:]
+}
+
+func (p *pagePathBuilder) bindPaginatorFromDescriptor(d TargetPathDescriptor, addends string) {
+	p.paginateDescriptor = d
+	p.paginateAddends = addends
+	p.paginateNumber = 0
+	if addends != "" {
+		trimmed := strings.Trim(addends, "/")
+		parts := strings.Split(trimmed, "/")
+		if len(parts) >= 2 {
+			p.paginatePathName = parts[0]
+			if n, err := strconv.Atoi(parts[len(parts)-1]); err == nil {
+				p.paginateNumber = n
+			}
+		}
+	}
+	if p.paginatePathName == "" {
+		p.paginatePathName = p.paginatePathOrDefault()
+	}
+}
+
+func (p *pagePathBuilder) descriptorUsesFrontMatterURL() bool {
+	if p.descriptorPageURL == "" {
+		return false
+	}
+	if p.descriptorKind == kinds.KindPage {
+		return true
+	}
+	if p.descriptorKind == kinds.KindSection || p.descriptorKind == kinds.KindTaxonomy || p.descriptorKind == kinds.KindTerm {
+		return true
+	}
+	return p.descriptorPageURL != ""
+}
+
+func (p *pagePathBuilder) descriptorStandaloneBaseName() string {
+	if !p.descriptorUseStandalone {
+		return p.descriptorFallbackBase
+	}
+	if p.descriptorStandaloneBase != "" {
+		return p.descriptorStandaloneBase
+	}
+	if p.descriptorSlug != "" {
+		return p.descriptorSlug
+	}
+	return p.descriptorFallbackBase
+}
