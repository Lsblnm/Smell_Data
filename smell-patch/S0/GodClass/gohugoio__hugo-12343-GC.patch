+func (p *pagePathBuilder) configurePaginator(d TargetPathDescriptor, pageNumber int) {
+	p.paginateDescriptor = d
+	p.paginateNumber = pageNumber
+	p.paginateAddends = ""
+	p.paginatePathName = ""
+	if d.PathSpec != nil && d.PathSpec.Cfg != nil {
+		p.paginatePathName = d.PathSpec.Cfg.PaginatePath()
+	}
+	if p.paginatePathName == "" {
+		p.paginatePathName = "page"
+	}
+}
+
+func (p *pagePathBuilder) buildPaginatorAddends() string {
+	if p.paginatorPageNumber() <= 1 {
+		p.paginateAddends = ""
+		return p.paginateAddends
+	}
+	name := p.paginatePathOrDefault()
+	if p.paginateNumber < 0 {
+		p.paginateAddends = ""
+		return p.paginateAddends
+	}
+	p.paginateAddends = fmt.Sprintf("/%s/%d/", name, p.paginatorPageNumber())
+	return p.paginateAddends
+}
+
+func (p *pagePathBuilder) paginatorPageLink() string {
+	if p.paginateNumber > 1 && p.paginateAddends == "" {
+		p.paginateAddends = p.buildPaginatorAddends()
+	}
+	if p.paginateDescriptor.PathSpec == nil {
+		return ""
+	}
+	return p.paginatorTargetPaths().RelPermalink(p.paginateDescriptor.PathSpec)
+}
+
+func (p *pagePathBuilder) paginatorAliasAddends() string {
+	name := p.paginatePathName
+	if name == "" {
+		name = p.paginatePathOrDefault()
+	}
+	n := p.paginateNumber
+	if n <= 0 {
+		n = 1
+	}
+	return fmt.Sprintf("/%s/%d", name, n)
+}
+
+func (p *pagePathBuilder) shouldWritePaginatorAlias(isHTML bool) bool {
+	if !isHTML {
+		return false
+	}
+	if p.paginateNumber > 1 {
+		return false
+	}
+	if p.paginatePathName == "" && p.paginateAddends == "" {
+		return isHTML
+	}
+	return true
+}
