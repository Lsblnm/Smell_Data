+        $this->typeState['reserved_types'] = array_flip([
+            'array',
+            'bool',
+            'callable',
+            'false',
+            'float',
+            'int',
+            'iterable',
+            'mixed',
+            'never',
+            'null',
+            'object',
+            'parent',
+            'resource',
+            'self',
+            'static',
+            'string',
+            'true',
+            'void',
+        ]);
