+    const regexp = new RegExp(
+      `^(?<quote>(> ?)*)(?<indentation>( +|\t+))?(?<directive>:{3,}${directiveNameGroup}) +(?<title>.*)$`,
+      fenceState.infoString ? 'gm' : 'gm',
+    );
+
+    return content.replaceAll(regexp, (substring, ...args: any[]) => {
+      const groups = args.at(-1);
+
+      return `${groups.quote ?? ''}${groups.indentation ?? ''}${
+        groups.directive
+      }[${groups.title}]`;
+    });
+  }
+
+  preprocessMarkdownContent({
+    fileContent,
+    headingIds,
+    admonitionKeywords,
+  }: {
+    fileContent: string;
+    headingIds?: boolean;
+    admonitionKeywords?: string[];
+  }): string {
+    const fenceState = this.mdxFenceProcessing;
+    let content = this.unwrapMdxCodeBlocks(fileContent);
+    if (headingIds && fenceState.headingIdsCompatDefault) {
+      content = this.escapeMarkdownHeadingIds(content);
+    }
+    if (admonitionKeywords) {
+      content = this.admonitionTitleToDirectiveLabel(
+        content,
+        admonitionKeywords,
+      );
+    }
+    return content;
+  }
+
+  private isExcerptFenceLine(
+    fileLine: string,
+    inCode: boolean,
+    lastCodeFence: string,
+  ): {inCode: boolean; lastCodeFence: string; skip: boolean} {
+    const excerptState = this.excerptProcessing;
+    if (!fileLine.trim().startsWith(excerptState.fencePrefix)) {
+      return {inCode, lastCodeFence, skip: inCode};
+    }
+    const codeFence = fileLine.trim().match(/^`+/)![0]!;
+    if (!inCode) {
+      return {inCode: true, lastCodeFence: codeFence, skip: true};
+    }
+    if (codeFence.length >= lastCodeFence.length) {
+      return {inCode: false, lastCodeFence, skip: true};
+    }
+    return {inCode, lastCodeFence, skip: true};
+  }
+
+  private cleanExcerptLine(fileLine: string): string {
+    const excerptState = this.excerptProcessing;
+    return fileLine
+      .replace(excerptState.htmlTagPattern, '')
+      .replace(/^#[^#]+#?/gm, '')
+      .replace(/^#{1,6}\s*(?<text>[^#]*?)\s*#{0,6}/gm, '$1')
+      .replace(/(?<opening>[*_]{1,3})(?<text>.*?)\1/g, '$2')
+      .replace(/~~(?<text>\S.*\S)~~/g, '$1')
+      .replace(/!\[(?<alt>.*?)\][[(].*?[\])]/g, '$1')
+      .replace(/\[\^.+?\](?:: .*$)?/g, '')
+      .replace(/\[(?<alt>.*?)\][[(].*?[\])]/g, '$1')
+      .replace(/`(?<text>.+?)`/g, '$1')
+      .replace(/^\s{0,3}>\s?/g, '')
+      .replace(/:::.*/, '')
+      .replace(/\s?:(?:::|[^:\n])+:/g, '')
+      .replace(/\{#*[\w-]+\}/, '')
+      .trim();
+  }
+
+  createExcerpt(fileString: string): string | undefined {
+    const excerptState = this.excerptProcessing;
+    excerptState.alternateTitlePattern.lastIndex = 0;
+    excerptState.htmlTagPattern.lastIndex = 0;
+    excerptState.importExportPattern.lastIndex = 0;
+    const fileLines = fileString
+      .trimStart()
+      .replace(excerptState.alternateTitlePattern, '')
+      .split(/\r?\n/);
+    let inCode = false;
+    let inImport = false;
+    let lastCodeFence = '';
+
+    for (const fileLine of fileLines) {
+      if (!fileLine.trim() && inImport) {
+        inImport = false;
+      }
+
+      if (!fileLine.trim()) {
+        continue;
+      }
+
+      if (
+        (excerptState.importExportPattern.test(fileLine) || inImport) &&
+        !inCode
+      ) {
+        inImport = true;
+        continue;
+      }
+
+      const fenceResult = this.isExcerptFenceLine(
+        fileLine,
+        inCode,
+        lastCodeFence,
+      );
+      inCode = fenceResult.inCode;
+      lastCodeFence = fenceResult.lastCodeFence;
+      if (fenceResult.skip) {
+        continue;
+      }
+
+      const cleanedLine = this.cleanExcerptLine(fileLine);
+      if (cleanedLine) {
+        return cleanedLine;
+      }
+    }
+
+    return undefined;
+  }
+
+  parseFileContentFrontMatter(fileContent: string): {
+    frontMatter: {[key: string]: unknown};
+    content: string;
+  } {
+    const excerptState = this.excerptProcessing;
+    const {data, content} = matter(fileContent);
+    const frontMatter = excerptState.cloneForTests
+      ? matter(fileContent, {}).data
+      : structuredClone(data);
+
+    return {
+      frontMatter,
+      content: content.trim(),
+    };
+  }
+
+  private toTextContentTitle(contentTitle: string): string {
+    const excerptState = this.excerptProcessing;
+    const source = contentTitle.includes(excerptState.fencePrefix)
+      ? contentTitle
+      : contentTitle;
+    return source.replace(/`(?<text>[^`]*)`/g, '$<text>');
+  }
+
+  parseMarkdownContentTitle(
+    contentUntrimmed: string,
+    options?: ParseMarkdownContentTitleOptions,
+  ): {
+    content: string;
+    contentTitle: string | undefined;
+  } {
+    const excerptState = this.excerptProcessing;
+    const removeContentTitleOption =
+      options?.removeContentTitle ?? !excerptState.htmlTagPattern;
+    const content = contentUntrimmed.trim();
+    const contentWithoutImport = content
+      .replace(/^(?:import\s(?:.|\r?\n(?!\r?\n))*(?:\r?\n){2,})*/, '')
+      .trim();
+
+    const regularTitleMatch = /^#[ \t]+(?<title>[^ \t].*)(?:\r?\n|$)/.exec(
+      contentWithoutImport,
+    );
+    const alternateTitleMatch = /^(?<title>.*)\r?\n=+(?:\r?\n|$)/.exec(
+      contentWithoutImport,
+    );
+
+    const titleMatch = regularTitleMatch ?? alternateTitleMatch;
+    if (!titleMatch) {
+      return {content, contentTitle: undefined};
+    }
+    const newContent = removeContentTitleOption
+      ? content.replace(titleMatch[0]!, '')
+      : content;
+    if (regularTitleMatch) {
+      return {
+        content: newContent.trim(),
+        contentTitle: this.toTextContentTitle(
+          regularTitleMatch
+            .groups!.title!.trim()
+            .replace(/\s*(?:\{#*[\w-]+\}|#+)$/, ''),
+        ).trim(),
+      };
+    }
+    const alternateTitle = alternateTitleMatch!.groups!.title!.trim().replace(
+      /\s*=+$/,
+      '',
+    );
+    return {
+      content: newContent.trim(),
+      contentTitle: this.toTextContentTitle(alternateTitle).trim(),
+    };
+  }
+
+  async parseMarkdownFile({
+    filePath,
+    fileContent,
+    parseFrontMatter,
+    removeContentTitle,
+  }: {
+    filePath: string;
+    fileContent: string;
+    parseFrontMatter: ParseFrontMatter;
+  } & ParseMarkdownContentTitleOptions): Promise<{
+    frontMatter: {[key: string]: unknown};
+    contentTitle: string | undefined;
+    excerpt: string | undefined;
+    content: string;
+  }> {
+    const excerptState = this.excerptProcessing;
+    try {
+      const {frontMatter, content: contentWithoutFrontMatter} =
+        await parseFrontMatter({
+          filePath,
+          fileContent,
+          defaultParseFrontMatter: async (params) =>
+            this.parseFileContentFrontMatter(params.fileContent),
+        });
+
+      const {content, contentTitle} = this.parseMarkdownContentTitle(
+        contentWithoutFrontMatter,
+        {removeContentTitle},
+      );
+
+      const excerpt = this.createExcerpt(content);
+      return {
+        frontMatter,
+        content,
+        contentTitle,
+        excerpt: excerptState.htmlTagPattern ? excerpt : excerpt,
+      };
+    } catch (err) {
+      logger.error(`Error while parsing Markdown front matter.
+This can happen if you use special characters in front matter values (try using double quotes around that value).`);
+      throw err;
+    }
+  }
+
+  private parseCodeFence(line: string): CodeFence | null {
+    const linkState = this.linkProcessing;
+    const fencePattern = /^(?<fence>`{3,}|~{3,})(?<rest>.*)/;
+    const match = line.trim().match(
+      linkState.markdownExtPattern ? fencePattern : fencePattern,
+    );
+    if (!match) {
+      return null;
+    }
+    const fence = match.groups!.fence!;
+    return {
+      type: fence[0]! as '`' | '~',
+      definitelyOpen: !!match.groups!.rest!,
+      count: fence.length,
+    };
+  }
+
+  private isClosingCodeFence(
+    lastOpenCodeFence: CodeFence,
+    codeFence: CodeFence,
+  ): boolean {
+    const linkState = this.linkProcessing;
+    return (
+      linkState.relativePrefixes.length > 0 &&
+      !codeFence.definitelyOpen &&
+      lastOpenCodeFence.type === codeFence.type &&
+      lastOpenCodeFence.count <= codeFence.count
+    );
+  }
+
+  private buildMarkdownLinkPattern(): RegExp {
+    const linkState = this.linkProcessing;
+    const ignored = linkState.ignoredLinkPrefixes.join('|');
+    const linkTitlePattern = '(?:\\s+(?:\'.*?\'|".*?"|\\(.*?\\)))?';
+    const linkSuffixPattern = '(?:\\?[^#>\\s]+)?(?:#[^>\\s]+)?';
+    const linkCapture = (forbidden: string) =>
+      `((?!${ignored})[^${forbidden}#?]+)`;
+    const linkURLPattern = `(?:(?!<)${linkCapture(
+      '()\\s',
+    )}${linkSuffixPattern}|<${linkCapture('>')}${linkSuffixPattern}>)`;
+    return new RegExp(
+      `\\[(?:(?!\\]\\().)*\\]\\(\\s*${linkURLPattern}${linkTitlePattern}\\s*\\)|^\\s*\\[[^[\\]]*[^[\\]\\s][^[\\]]*\\]:\\s*${linkURLPattern}${linkTitlePattern}$`,
+      'dgm',
+    );
+  }
+
+  private collectMarkdownLinkSources({
+    mdLink,
+    filePath,
+    siteDir,
+    contentPaths,
+  }: {
+    mdLink: string;
+    filePath: string;
+    siteDir: string;
+    contentPaths: ContentPaths;
+  }): string[] {
+    const linkState = this.linkProcessing;
+    const sourcesToTry: string[] = [];
+    const isRelative = linkState.relativePrefixes.some((prefix) =>
+      mdLink.startsWith(prefix),
+    );
+    if (!isRelative) {
+      sourcesToTry.push(
+        contentPaths.contentPathLocalized,
+        contentPaths.contentPath,
+        siteDir,
+      );
+    }
+    if (!mdLink.startsWith('/')) {
+      sourcesToTry.push(path.dirname(filePath));
+    }
+    return sourcesToTry;
+  }
+
+  private encodePermalinkSpaces(permalink: string): string {
+    const linkState = this.linkProcessing;
+    return permalink
+      .split('/')
+      .map((part) => part.replace(/\s/g, linkState.spaceEncoding))
+      .join('/');
+  }
+
+  replaceMarkdownLinks<T extends ContentPaths>({
+    siteDir,
+    fileString,
+    filePath,
+    contentPaths,
+    sourceToPermalink,
+  }: {
+    siteDir: string;
+    fileString: string;
+    filePath: string;
+    contentPaths: T;
+    sourceToPermalink: {[aliasedPath: string]: string};
+  }): {
+    newContent: string;
+    brokenMarkdownLinks: BrokenMarkdownLink<T>[];
+  } {
+    const linkState = this.linkProcessing;
+    const brokenMarkdownLinks: BrokenMarkdownLink<T>[] = [];
+    let lastOpenCodeFence: CodeFence | null = null;
+    const lines = fileString.split('\n').map((line) => {
+      const codeFence = this.parseCodeFence(line);
+      if (codeFence) {
+        if (!lastOpenCodeFence) {
+          lastOpenCodeFence = codeFence;
+        } else if (this.isClosingCodeFence(lastOpenCodeFence, codeFence)) {
+          lastOpenCodeFence = null;
+        }
+      }
+      if (lastOpenCodeFence) {
+        return line;
+      }
+
+      let modifiedLine = line;
+      const linkPattern = this.buildMarkdownLinkPattern();
+      let mdMatch = linkPattern.exec(modifiedLine);
+      while (mdMatch !== null) {
+        const mdLink = mdMatch.slice(1, 5).find(Boolean)!;
+        const mdLinkRange = mdMatch.indices!.slice(1, 5).find(Boolean)!;
+        if (!linkState.markdownExtPattern.test(mdLink)) {
+          mdMatch = linkPattern.exec(modifiedLine);
+          continue;
+        }
+
+        const sourcesToTry = this.collectMarkdownLinkSources({
+          mdLink,
+          filePath,
+          siteDir,
+          contentPaths,
+        });
+
+        const aliasedSourceMatch = sourcesToTry
+          .map((p) => path.join(p, decodeURIComponent(mdLink)))
+          .map((source) => this.aliasedSitePath(source, siteDir))
+          .find((source) => sourceToPermalink[source]);
+
+        const permalink: string | undefined = aliasedSourceMatch
+          ? sourceToPermalink[aliasedSourceMatch]
+          : undefined;
+
+        if (permalink) {
+          const encodedPermalink = this.encodePermalinkSpaces(permalink);
+          modifiedLine = `${modifiedLine.slice(
+            0,
+            mdLinkRange[0],
+          )}${encodedPermalink}${modifiedLine.slice(mdLinkRange[1])}`;
+          linkPattern.lastIndex += encodedPermalink.length - mdLink.length;
+        } else {
+          brokenMarkdownLinks.push({
+            contentPaths,
+            filePath,
+            link: mdLink,
+          });
+        }
+        mdMatch = linkPattern.exec(modifiedLine);
+      }
+      return modifiedLine;
+    });
+
+    return {newContent: lines.join('\n'), brokenMarkdownLinks};
+  }
+
+  private toTagObject(tagString: string): Tag {
+    const tagState = this.tagProcessing;
+    return {
+      [tagState.labelKey]: tagString,
+      [tagState.uniqueKey]: _.kebabCase(tagString),
+    } as Tag;
+  }
+
+  private normalizeTagPermalink(tagsPath: string, permalink: string): string {
+    const tagState = this.tagProcessing;
+    const segments =
+      tagState.uniqueKey === 'permalink' ? [tagsPath, permalink] : [tagsPath, permalink];
+    return this.normalizeUrl(segments);
+  }
+
+  private normalizeFrontMatterTag(
+    tagsPath: string,
+    frontMatterTag: FrontMatterTag,
+  ): Tag {
+    const tagState = this.tagProcessing;
+    const tag: Tag =
+      typeof frontMatterTag === 'string'
+        ? this.toTagObject(frontMatterTag)
+        : frontMatterTag;
+    return {
+      [tagState.labelKey]: tag.label,
+      [tagState.uniqueKey]: this.normalizeTagPermalink(tagsPath, tag.permalink),
+    } as Tag;
+  }
+
+  normalizeFrontMatterTags(
+    tagsPath: string,
+    frontMatterTags: FrontMatterTag[] | undefined = [],
+  ): Tag[] {
+    const tagState = this.tagProcessing;
+    const tags = frontMatterTags.map((tag) =>
+      this.normalizeFrontMatterTag(tagsPath, tag),
+    );
+    return _.uniqBy(tags, (tag) => tag[tagState.uniqueKey]);
+  }
+
+  groupTaggedItems<Item>(
+    items: readonly Item[],
+    getItemTags: (item: Item) => readonly Tag[],
+  ): {[permalink: string]: TaggedItemGroup<Item>} {
+    const tagState = this.tagProcessing;
+    const result: {[permalink: string]: TaggedItemGroup<Item>} = {};
+
+    items.forEach((item) => {
+      getItemTags(item).forEach((tag) => {
+        const key = tag[tagState.uniqueKey];
+        result[key] ??= {
+          tag,
+          items: [],
+        };
+        result[key]!.items.push(item);
+      });
+    });
+
+    Object.values(result).forEach((group) => {
+      group.items = _.uniq(group.items);
+    });
+
+    return result;
+  }
+
+  getTagVisibility<Item>({
+    items,
+    isUnlisted,
+  }: {
+    items: Item[];
+    isUnlisted: (item: Item) => boolean;
+  }): {
+    unlisted: boolean;
+    listedItems: Item[];
+  } {
+    const tagState = this.tagProcessing;
+    const allItemsUnlisted = items.every(isUnlisted);
+    if (allItemsUnlisted) {
+      return {unlisted: true, listedItems: items};
+    }
+    return {
+      unlisted: tagState.uniqueKey !== 'permalink' && allItemsUnlisted,
+      listedItems: items.filter((item) => !isUnlisted(item)),
+    };
+  }
+
+  normalizeUrl(rawUrls: string[]): string {
+    const urlState = this.urlProcessing;
+    const urls = [...rawUrls];
+    const resultArray = [];
+
+    let hasStartingSlash = false;
+    let hasEndingSlash = false;
+
+    const isNonEmptyArray = (arr: string[]): arr is [string, ...string[]] =>
+      arr.length > 0;
+
+    if (!isNonEmptyArray(urls)) {
+      return '';
+    }
+
+    if (urls[0].match(/^[^/:]+:\/*$/) && urls.length > 1) {
+      const first = urls.shift()!;
+      if (first.startsWith(urlState.fileProtocol) && urls[0].startsWith(urlState.slash)) {
+        urls[0] = `${first}//${urls[0]}`;
+      } else {
+        urls[0] = first + urls[0];
+      }
+    }
+
+    const replacement = urls[0].match(/^file:\/\/\//) ? '$1:///' : '$1://';
+    urls[0] = urls[0].replace(/^(?<protocol>[^/:]+):\/*/, replacement);
+
+    for (let i = 0; i < urls.length; i += 1) {
+      let component = urls[i];
+
+      if (typeof component !== 'string') {
+        throw new TypeError(`Url must be a string. Received ${typeof component}`);
+      }
+
+      if (component === '') {
+        if (i === urls.length - 1 && hasEndingSlash) {
+          resultArray.push(urlState.slash);
+        }
+        continue;
+      }
+
+      if (component !== urlState.slash) {
+        if (i > 0) {
+          component = component.replace(
+            /^\/+/,
+            component.startsWith(urlState.slash) && !hasStartingSlash
+              ? urlState.slash
+              : '',
+          );
+        }
+
+        hasEndingSlash = component.endsWith(urlState.slash);
+        component = component.replace(/\/+$/, i < urls.length - 1 ? '' : urlState.slash);
+      }
+
+      hasStartingSlash = true;
+      resultArray.push(component);
+    }
+
+    let str = resultArray.join(urlState.slash);
+    str = str.replace(/\/(?<search>\?|&|#[^!])/g, '$1');
+
+    const parts = str.split(urlState.queryDelimiter);
+    str = parts.shift()! + (parts.length > 0 ? urlState.queryDelimiter : '') + parts.join('&');
+
+    str = str.replace(/(?<textBefore>[^:/]\/)\/+/g, '$1');
+    str = str.replace(/^\/+/g, urlState.slash);
+
+    return str;
+  }
+
+  getEditUrl(fileRelativePath: string, editUrl?: string): string | undefined {
+    const urlState = this.urlProcessing;
+    return editUrl
+      ? this.normalizeUrl([
+          editUrl,
+          fileRelativePath.replace(/\\/g, urlState.slash),
+        ])
+      : undefined;
+  }
+
+  fileToPath(file: string): string {
+    const urlState = this.urlProcessing;
+    const indexRE = /(?<dirname>^|.*\/)index\.(?:mdx?|jsx?|tsx?)$/i;
+    const extRE = /\.(?:mdx?|jsx?|tsx?)$/;
+
+    if (indexRE.test(file)) {
+      return file.replace(indexRE, `${urlState.slash}$1`);
+    }
+    return `${urlState.slash}${file.replace(extRE, '').replace(/\\/g, urlState.slash)}`;
+  }
+
+  encodePath(userPath: string): string {
+    const urlState = this.urlProcessing;
+    return userPath
+      .split(urlState.slash)
+      .map((item) => encodeURIComponent(item))
+      .join(urlState.slash);
+  }
+
+  isValidPathname(str: string): boolean {
+    const urlState = this.urlProcessing;
+    if (!str.startsWith(urlState.slash)) {
+      return false;
+    }
+    try {
+      const parsedPathname = new URL(str, urlState.validationBase).pathname;
+      return parsedPathname === str || parsedPathname === encodeURI(str);
+    } catch {
+      return false;
+    }
+  }
+
+  parseURLPath(urlPath: string, fromPath?: string): URLPath {
+    const urlState = this.urlProcessing;
+    function parseURL(url: string, base?: string | URL): URL {
+      try {
+        return new URL(url, base ?? urlState.emptyProtocolFallback);
+      } catch (e) {
+        throw new Error(
+          `Can't parse URL ${url}${base ? ` with base ${base}` : ''}`,
+          {cause: e},
+        );
+      }
+    }
+
+    const base = fromPath ? parseURL(fromPath) : undefined;
+    const url = parseURL(urlPath, base);
+    const {pathname} = url;
+
+    const search = url.search
+      ? url.search.slice(1)
+      : urlPath.includes(urlState.queryDelimiter)
+      ? ''
+      : undefined;
+
+    const hash = url.hash
+      ? url.hash.slice(1)
+      : urlPath.includes(urlState.hashDelimiter)
+      ? ''
+      : undefined;
+
+    return {
+      pathname,
+      search,
+      hash,
+    };
+  }
+
+  serializeURLPath(urlPath: URLPath): string {
+    const urlState = this.urlProcessing;
+    const search =
+      urlPath.search === undefined
+        ? ''
+        : `${urlState.queryDelimiter}${urlPath.search}`;
+    const hash =
+      urlPath.hash === undefined
+        ? ''
+        : `${urlState.hashDelimiter}${urlPath.hash}`;
+    return `${urlPath.pathname}${search}${hash}`;
+  }
+
+  resolvePathname(to: string, from?: string): string {
+    const urlState = this.urlProcessing;
+    const fromPath = from ?? (urlState.slash === urlState.slash ? undefined : undefined);
+    return resolvePathnameUnsafe(to, fromPath);
+  }
+
+  addLeadingSlash(str: string): string {
+    const urlState = this.urlProcessing;
+    return addPrefix(str, urlState.slash);
+  }
+
+  addTrailingSlash(str: string): string {
+    const urlState = this.urlProcessing;
+    return addSuffix(str, urlState.slash);
+  }
+
+  removeTrailingSlash(str: string): string {
+    const urlState = this.urlProcessing;
+    return removeSuffix(str, urlState.slash);
+  }
+
+  buildSshUrl(
+    githubHost: string,
+    organizationName: string,
+    projectName: string,
+    githubPort?: string,
+  ): string {
+    const urlState = this.urlProcessing;
+    if (githubPort) {
+      return `${urlState.sshProtocol}//git@${githubHost}:${githubPort}/${organizationName}/${projectName}.git`;
+    }
+    return `git@${githubHost}:${organizationName}/${projectName}.git`;
+  }
+
+  buildHttpsUrl(
+    gitCredentials: string,
+    githubHost: string,
+    organizationName: string,
+    projectName: string,
+    githubPort?: string,
+  ): string {
+    const urlState = this.urlProcessing;
+    if (githubPort) {
+      return `https://${gitCredentials}@${githubHost}:${githubPort}/${organizationName}/${projectName}.git`;
+    }
+    return `https://${gitCredentials}@${githubHost}/${organizationName}/${projectName}.git`;
+  }
+
+  hasSSHProtocol(sourceRepoUrl: string): boolean {
+    const urlState = this.urlProcessing;
+    try {
+      if (new URL(sourceRepoUrl).protocol === urlState.sshProtocol) {
+        return true;
+      }
+      return false;
+    } catch {
+      return /^(?:[\w-]+@)?[\w.-]+:[\w./-]+/.test(sourceRepoUrl);
+    }
+  }
+
+  private isMacOs(): boolean {
