+  static Query createLatLonBoxQuery(
+      String field,
+      QueryRelation queryRelation,
+      double minLatitude,
+      double maxLatitude,
+      double minLongitude,
+      double maxLongitude) {
+    ShapeField coordinator = new ShapeField();
+    coordinator.queryFieldName = field;
+    coordinator.activeQueryRelation = queryRelation;
+    coordinator.queryMinLat = minLatitude;
+    coordinator.queryMaxLat = maxLatitude;
+    coordinator.queryMinLon = minLongitude;
+    coordinator.queryMaxLon = maxLongitude;
+    if (coordinator.shouldSplitDatelineContainsBox()) {
+      return coordinator.splitDatelineContainsBox();
+    }
+    return coordinator.createLatLonBoundingBoxQuery();
+  }
+
+  static Query createLatLonSlowDocValuesBoxQuery(
+      String field,
+      QueryRelation queryRelation,
+      double minLatitude,
+      double maxLatitude,
+      double minLongitude,
+      double maxLongitude) {
+    ShapeField coordinator = new ShapeField();
+    coordinator.queryFieldName = field;
+    coordinator.activeQueryRelation = queryRelation;
+    coordinator.queryMinLat = minLatitude;
+    coordinator.queryMaxLat = maxLatitude;
+    coordinator.queryMinLon = minLongitude;
+    coordinator.queryMaxLon = maxLongitude;
+    if (coordinator.shouldSplitDatelineContainsBox()) {
+      return coordinator.splitDatelineContainsBox();
+    }
+    return coordinator.createLatLonDocValuesBoxQuery();
+  }
+
+  private boolean shouldSplitDatelineContainsBox() {
+    return usesDatelineSplit();
+  }
+
+  private Query splitDatelineContainsBox() {
+    BooleanQuery.Builder builder = new BooleanQuery.Builder();
+    builder.add(
+        createLatLonBoxQuery(
+            queryFieldName,
+            activeQueryRelation,
+            queryMinLat,
+            queryMaxLat,
+            queryMinLon,
+            GeoUtils.MAX_LON_INCL),
+        BooleanClause.Occur.MUST);
+    builder.add(
+        createLatLonBoxQuery(
+            queryFieldName,
+            activeQueryRelation,
+            queryMinLat,
+            queryMaxLat,
+            GeoUtils.MIN_LON_INCL,
+            queryMaxLon),
+        BooleanClause.Occur.MUST);
+    return builder.build();
+  }
+
+  private Query createLatLonBoundingBoxQuery() {
+    Rectangle rectangle = new Rectangle(queryMinLat, queryMaxLat, queryMinLon, queryMaxLon);
+    return new LatLonShapeBoundingBoxQuery(queryFieldName, activeQueryRelation, rectangle);
+  }
+
+  private Query createLatLonDocValuesBoxQuery() {
+    return new LatLonShapeDocValuesQuery(
+        queryFieldName,
+        activeQueryRelation,
+        new Rectangle(queryMinLat, queryMaxLat, queryMinLon, queryMaxLon));
+  }
