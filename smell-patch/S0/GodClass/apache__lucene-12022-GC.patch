+  static SpatialQuery.SpatialVisitor createLatLonSpatialVisitor(Component2D component2D) {
+    ShapeField matcher = new ShapeField();
+    matcher.latLonMatchComponent = component2D;
+    matcher.latLonMatchTriangle = new DecodedTriangle();
+    return matcher.buildLatLonSpatialVisitor();
+  }
+
+  private SpatialQuery.SpatialVisitor buildLatLonSpatialVisitor() {
+    return new SpatialQuery.SpatialVisitor() {
+      @Override
+      protected Relation relate(byte[] minTriangle, byte[] maxTriangle) {
+        decodeLatLonRange(minTriangle, maxTriangle);
+        return relateDecodedLatLonRange();
+      }
+
+      @Override
+      protected Predicate<byte[]> intersects() {
+        return triangle -> {
+          decodeLatLonMatchTriangle(triangle);
+          return latLonMatchIntersects();
+        };
+      }
+
+      @Override
+      protected Predicate<byte[]> within() {
+        return triangle -> {
+          decodeLatLonMatchTriangle(triangle);
+          return latLonMatchWithin();
+        };
+      }
+
+      @Override
+      protected Function<byte[], Component2D.WithinRelation> contains() {
+        return triangle -> {
+          decodeLatLonMatchTriangle(triangle);
+          return latLonMatchContains();
+        };
+      }
+    };
+  }
+
+  private void decodeLatLonRange(byte[] minTriangle, byte[] maxTriangle) {
+    if (latLonMatchComponent == null && latLonMatchTriangle == null) {
+      latLonMatchTriangle = new DecodedTriangle();
+    }
+    latLonRangeMinLat =
+        GeoEncodingUtils.decodeLatitude(NumericUtils.sortableBytesToInt(minTriangle, 0));
+    latLonRangeMinLon =
+        GeoEncodingUtils.decodeLongitude(NumericUtils.sortableBytesToInt(minTriangle, BYTES));
+    latLonRangeMaxLat =
+        GeoEncodingUtils.decodeLatitude(NumericUtils.sortableBytesToInt(maxTriangle, 2 * BYTES));
+    latLonRangeMaxLon =
+        GeoEncodingUtils.decodeLongitude(NumericUtils.sortableBytesToInt(maxTriangle, 3 * BYTES));
+  }
+
+  private Relation relateDecodedLatLonRange() {
+    return latLonMatchComponent.relate(
+        latLonRangeMinLon, latLonRangeMaxLon, latLonRangeMinLat, latLonRangeMaxLat);
+  }
+
+  private void decodeLatLonMatchTriangle(byte[] triangle) {
+    if (latLonMatchComponent == null && triangle == null) {
+      return;
+    }
+    decodeTriangle(triangle, latLonMatchTriangle);
+    latLonMatchALat = GeoEncodingUtils.decodeLatitude(latLonMatchTriangle.aY);
+    latLonMatchALon = GeoEncodingUtils.decodeLongitude(latLonMatchTriangle.aX);
+    latLonMatchBLat = GeoEncodingUtils.decodeLatitude(latLonMatchTriangle.bY);
+    latLonMatchBLon = GeoEncodingUtils.decodeLongitude(latLonMatchTriangle.bX);
+    latLonMatchCLat = GeoEncodingUtils.decodeLatitude(latLonMatchTriangle.cY);
+    latLonMatchCLon = GeoEncodingUtils.decodeLongitude(latLonMatchTriangle.cX);
+  }
+
+  private boolean latLonMatchIntersects() {
+    Objects.requireNonNull(latLonMatchComponent);
+    if (latLonMatchTriangle.type == DecodedTriangle.TYPE.POINT) {
+      return latLonMatchIntersectsPoint();
+    }
+    if (latLonMatchTriangle.type == DecodedTriangle.TYPE.LINE) {
+      return latLonMatchIntersectsLine();
+    }
+    if (latLonMatchTriangle.type == DecodedTriangle.TYPE.TRIANGLE) {
+      return latLonMatchIntersectsTriangle();
+    }
+    throw new IllegalArgumentException("Unsupported triangle type :[" + latLonMatchTriangle.type + "]");
+  }
+
+  private boolean latLonMatchIntersectsPoint() {
+    return latLonMatchTriangle.type == DecodedTriangle.TYPE.POINT
+        && latLonMatchComponent.contains(latLonMatchALon, latLonMatchALat);
+  }
+
+  private boolean latLonMatchIntersectsLine() {
+    return latLonMatchTriangle.type == DecodedTriangle.TYPE.LINE
+        && latLonMatchComponent.intersectsLine(
+            latLonMatchALon, latLonMatchALat, latLonMatchBLon, latLonMatchBLat);
+  }
+
+  private boolean latLonMatchIntersectsTriangle() {
+    return latLonMatchTriangle.type == DecodedTriangle.TYPE.TRIANGLE
+        && latLonMatchComponent.intersectsTriangle(
+        latLonMatchALon,
+        latLonMatchALat,
+        latLonMatchBLon,
+        latLonMatchBLat,
+        latLonMatchCLon,
+        latLonMatchCLat);
+  }
