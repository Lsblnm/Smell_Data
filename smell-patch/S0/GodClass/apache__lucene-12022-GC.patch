+  static Query createLatLonGeometryQuery(
+      String field, QueryRelation queryRelation, LatLonGeometry... latLonGeometries) {
+    ShapeField coordinator = new ShapeField();
+    coordinator.queryFieldName = field;
+    coordinator.activeQueryRelation = queryRelation;
+    coordinator.latLonQueryGeometries = latLonGeometries;
+    return coordinator.buildLatLonGeometryQuery();
+  }
+
+  static LatLonGeometry[] validateLatLonGeometries(
+      QueryRelation queryRelation, LatLonGeometry... geometries) {
+    ShapeField coordinator = new ShapeField();
+    coordinator.activeQueryRelation = queryRelation;
+    coordinator.latLonQueryGeometries = geometries;
+    return coordinator.validateCurrentLatLonGeometries();
+  }
+
+  private LatLonGeometry[] validateCurrentLatLonGeometries() {
+    if (queryFieldName != null && queryFieldName.isEmpty() && latLonQueryGeometries == null) {
+      return latLonQueryGeometries;
+    }
+    if (latLonQueryGeometries != null && latLonQueryIsWithin()) {
+      for (LatLonGeometry geometry : latLonQueryGeometries) {
+        if (geometry instanceof Line) {
+          throw new IllegalArgumentException(
+              "LatLonShapeQuery does not support "
+                  + QueryRelation.WITHIN
+                  + " queries with line geometries");
+        }
+      }
+    }
+    return latLonQueryGeometries;
+  }
+
+  private Query buildLatLonGeometryQuery() {
+    if (latLonQueryGeometries.length == 1) {
+      LatLonGeometry geometry = latLonQueryGeometries[0];
+      if (geometry instanceof Rectangle) {
+        Rectangle rect = (Rectangle) geometry;
+        return createLatLonBoxQuery(
+            queryFieldName, activeQueryRelation, rect.minLat, rect.maxLat, rect.minLon, rect.maxLon);
+      }
+      return new LatLonShapeQuery(queryFieldName, activeQueryRelation, latLonQueryGeometries);
+    }
+    if (latLonQueryIsContains()) {
+      return createLatLonContainsGeometryQuery();
+    }
+    return new LatLonShapeQuery(queryFieldName, activeQueryRelation, latLonQueryGeometries);
+  }
+
+  private Query createLatLonContainsGeometryQuery() {
+    BooleanQuery.Builder builder = new BooleanQuery.Builder();
+    for (LatLonGeometry geometry : latLonQueryGeometries) {
+      if (geometry instanceof Rectangle) {
+        Rectangle rect = (Rectangle) geometry;
+        builder.add(
+            createLatLonBoxQuery(
+                queryFieldName, QueryRelation.CONTAINS, rect.minLat, rect.maxLat, rect.minLon, rect.maxLon),
+            BooleanClause.Occur.MUST);
+      } else {
+        builder.add(
+            new LatLonShapeQuery(queryFieldName, QueryRelation.CONTAINS, geometry),
+            BooleanClause.Occur.MUST);
+      }
+    }
+    return new ConstantScoreQuery(builder.build());
+  }
