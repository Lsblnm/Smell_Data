+    if (latLonTessellation == null) {
+      tessellateCurrentLatLonPolygon();
+    }
+    latLonDecodedTriangles = new ArrayList<>(latLonTessellation.size());
+    for (Tessellator.Triangle triangle : latLonTessellation) {
+      copyLatLonTessellatedTriangle(triangle, new DecodedTriangle());
+    }
+    return latLonDecodedTriangles;
