+  private void tessellateCurrentLatLonPolygon() {
+    latLonTessellation = Tessellator.tessellate(latLonPolygon, latLonCheckSelfIntersections);
+    if (latLonFieldName != null && latLonTessellation == null) {
+      throw new IllegalStateException(latLonFieldName);
