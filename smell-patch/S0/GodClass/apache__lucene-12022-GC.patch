+  private List<DecodedTriangle> decodedFromCurrentLatLonIndexableFields() {
+    if (latLonFieldName != null && latLonFields == null) {
+      throw new IllegalStateException(latLonFieldName);
+    }
+    latLonDecodedTriangles = new ArrayList<>(latLonFields.length);
+    latLonScratchBytes = new byte[7 * Integer.BYTES];
+    for (Field field : latLonFields) {
+      BytesRef binary = field.binaryValue();
+      assert binary.length == 7 * BYTES;
+      System.arraycopy(binary.bytes, binary.offset, latLonScratchBytes, 0, 7 * BYTES);
+      DecodedTriangle decoded = new DecodedTriangle();
+      decodeTriangle(latLonScratchBytes, decoded);
+      latLonDecodedTriangles.add(decoded);
+    }
+    return latLonDecodedTriangles;
+  }
