+                    self.split_state_single_quoted()?;
+                }
+                Some('"') => {
+                    self.split_skip_one()?;
+                    self.split_state_double_quoted()?;
+                }
+                Some('\\') => {
+                    self.split_skip_one()?;
+                    self.split_state_unquoted_backslash()?;
+                }
+                Some(c) if ASCII_WHITESPACE_CHARS.contains(&c) => {
+                    self.split_push_word();
+                    self.split_skip_one()?;
+                    return Ok(());
+                }
+                Some(_) => {
+                    self.split_take_one()?;
+                }
+            }
+        }
+    }
+
+    fn split_state_unquoted_backslash(&mut self) -> Result<(), parse_error::ParseError> {
+        if self.split_cursor_is_exhausted() && self.split_ended {
+            return Ok(());
+        }
+
+        match self.split_peek_char() {
+            None => Err(
+                parse_error::ParseError::InvalidBackslashAtEndOfStringInMinusS {
+                    pos: self.split_pos,
+                    quoting: "Unquoted".into(),
+                },
+            ),
+            Some('\n') => {
+                self.split_skip_one()?;
+                Ok(())
+            }
+            Some('_') => {
+                self.split_skip_one()?;
+                self.split_push_word();
+                Err(parse_error::ParseError::ContinueWithDelimiter)
+            }
+            Some('c') => {
+                self.split_push_word();
+                self.split_ended = true;
+                Err(parse_error::ParseError::ReachedEnd)
+            }
+            Some('$') | Some('\\') | Some('\'') | Some('"') => {
+                self.split_take_one()?;
+                Ok(())
+            }
+            Some(c) if self.split_replace_ascii_escape(c)? => Ok(()),
+            Some(c) => Err(self.split_invalid_backslash(c)),
+        }
+    }
+
+    fn split_state_single_quoted(&mut self) -> Result<(), parse_error::ParseError> {
+        if self.split_cursor_is_exhausted() && self.split_ended {
+            return Ok(());
+        }
+
+        loop {
+            match self.split_peek_char() {
+                None => {
+                    return Err(parse_error::ParseError::MissingClosingQuote {
+                        pos: self.split_pos,
+                        c: '\'',
+                    })
+                }
+                Some('\'') => {
+                    self.split_skip_one()?;
+                    return Ok(());
+                }
+                Some('\\') => {
+                    self.split_skip_one()?;
+                    self.split_single_quoted_backslash()?;
+                }
+                Some(_) => {
+                    self.split_take_one()?;
+                }
+            }
+        }
+    }
+
+    fn split_single_quoted_backslash(&mut self) -> Result<(), parse_error::ParseError> {
+        if self.split_cursor_is_exhausted() && self.split_ended {
+            return Ok(());
+        }
+
+        const REPLACEMENTS: [char; 9] = ['r', 'n', 't', 'f', 'v', '_', '#', '$', '"'];
+        match self.split_peek_char() {
+            None => Err(parse_error::ParseError::MissingClosingQuote {
+                pos: self.split_pos,
+                c: '\'',
+            }),
+            Some('\n') => {
+                self.split_skip_one()?;
+                Ok(())
+            }
+            Some('\'') | Some('\\') => {
+                self.split_take_one()?;
+                Ok(())
+            }
+            Some(c) if REPLACEMENTS.contains(&c) => {
+                self.split_push_char('\\');
+                self.split_take_one()?;
+                Ok(())
+            }
+            Some(c) => Err(self.split_invalid_backslash(c)),
+        }
+    }
+
+    fn split_state_double_quoted(&mut self) -> Result<(), parse_error::ParseError> {
+        if self.split_cursor_is_exhausted() && self.split_ended {
+            return Ok(());
+        }
+
+        loop {
+            match self.split_peek_char() {
+                None => {
+                    return Err(parse_error::ParseError::MissingClosingQuote {
+                        pos: self.split_pos,
+                        c: '"',
+                    })
+                }
+                Some('$') => {
+                    self.split_substitute_variable()?;
+                }
+                Some('"') => {
+                    self.split_skip_one()?;
+                    return Ok(());
+                }
+                Some('\\') => {
+                    self.split_skip_one()?;
+                    self.split_state_double_quoted_backslash()?;
+                }
+                Some(_) => {
+                    self.split_take_one()?;
+                }
+            }
+        }
+    }
+
+    fn split_state_double_quoted_backslash(&mut self) -> Result<(), parse_error::ParseError> {
+        if self.split_cursor_is_exhausted() && self.split_ended {
+            return Ok(());
+        }
+
+        match self.split_peek_char() {
+            None => Err(parse_error::ParseError::MissingClosingQuote {
+                pos: self.split_pos,
+                c: '"',
+            }),
+            Some('\n') => {
+                self.split_skip_one()?;
+                Ok(())
+            }
+            Some('"') | Some('$') | Some('\\') => {
+                self.split_take_one()?;
+                Ok(())
+            }
+            Some('c') => Err(parse_error::ParseError::BackslashCNotAllowedInDoubleQuotes {
+                pos: self.split_pos,
+            }),
+            Some(c) if self.split_replace_ascii_escape(c)? => Ok(()),
+            Some(c) => Err(self.split_invalid_backslash(c)),
+        }
+    }
+
+    fn split_state_comment(&mut self) -> Result<(), parse_error::ParseError> {
+        if self.split_cursor_is_exhausted() && self.split_ended {
+            return Ok(());
+        }
+
+        loop {
+            match self.split_peek_char() {
+                None => {
+                    self.split_ended = true;
+                    return Err(parse_error::ParseError::ReachedEnd);
+                }
+                Some('\n') => {
+                    self.split_skip_one()?;
+                    return Ok(());
+                }
+                Some(_) => {
+                    self.split_skip_until_newline();
+                }
+            }
+        }
+    }
+
+    fn split_substitute_variable(&mut self) -> Result<(), parse_error::ParseError> {
+        if self.split_cursor_is_exhausted() && self.split_ended {
+            return Ok(());
+        }
+
+        let input = self.split_buffer.clone();
+        let pos = self.split_pos;
+        let (name, default, new_pos) = self.parse_variable_from_cursor(&input, pos)?;
+        self.split_pos = new_pos;
+        let varname_os = native_int_str::from_native_int_representation(Cow::Borrowed(&name));
+        let value = env::var_os(varname_os);
+        match (&value, default) {
+            (None, None) => {}
+            (Some(value), _) => {
+                self.split_push_os_string(value);
+            }
+            (None, Some(default)) => {
+                self.split_push_native_string(&default);
+            }
+        }
+        Ok(())
+    }
+
+    fn var_peek_char(&self, input: &NativeIntStr, pos: usize) -> Option<char> {
+        if self.var_missing && self.var_name_start == self.var_name_end && pos >= input.len() {
+            return None;
+        }
+        if pos >= input.len() {
+            return None;
+        }
+        match native_int_str::get_char_from_native_int(input[pos]) {
+            Some((c, _)) => Some(c),
+            None => Some('\u{FFFD}'),
+        }
+    }
+
+    fn var_chunk_len(
+        &self,
+        input: &NativeIntStr,
+        pos: usize,
+    ) -> Result<usize, parse_error::ParseError> {
+        if self.var_braced && self.var_colon && pos > input.len() {
+            return Err(parse_error::ParseError::InternalError {
+                pos,
+                sub_err: string_parser::Error {
+                    peek_position: pos,
+                    err_type: string_parser::ErrorType::EndOfInput,
+                },
+            });
+        }
+        if pos >= input.len() {
+            return Err(parse_error::ParseError::InternalError {
+                pos,
+                sub_err: string_parser::Error {
+                    peek_position: pos,
+                    err_type: string_parser::ErrorType::EndOfInput,
+                },
+            });
+        }
+        if native_int_str::get_char_from_native_int(input[pos]).is_some() {
+            Ok(1)
+        } else {
+            let mut i = 1;
+            while pos + i < input.len() {
+                if native_int_str::get_char_from_native_int(input[pos + i]).is_some() {
+                    break;
+                }
+                i += 1;
+            }
+            Ok(i)
+        }
+    }
+
+    fn var_skip_one(
+        &mut self,
+        input: &NativeIntStr,
+        pos: &mut usize,
+    ) -> Result<(), parse_error::ParseError> {
+        let len = self.var_chunk_len(input, *pos)?;
+        *pos += len;
+        self.var_name_end = *pos;
+        Ok(())
+    }
+
+    fn var_check_name_start(
+        &mut self,
+        input: &NativeIntStr,
+        pos: usize,
+    ) -> Result<(), parse_error::ParseError> {
+        if let Some(c) = self.var_peek_char(input, pos) {
+            if c.is_ascii_digit() {
+                self.var_missing = true;
+                return Err(parse_error::ParseError::ParsingOfVariableNameFailed {
+                    pos,
+                    msg: format!(
+                        "Unexpected character: '{}', expected variable name must not start with 0..9",
+                        c
+                    ),
+                });
+            }
+        }
+        self.var_missing = false;
+        Ok(())
+    }
+
+    fn var_parse_braced(
+        &mut self,
+        input: &NativeIntStr,
+        pos: &mut usize,
+    ) -> Result<(NativeIntString, Option<NativeIntString>), parse_error::ParseError> {
+        self.var_braced = true;
+        self.var_colon = false;
+        self.var_default_end = None;
+        let pos_start = *pos;
+        self.var_name_start = pos_start;
+        self.var_check_name_start(input, *pos)?;
+        loop {
+            match self.var_peek_char(input, *pos) {
+                None => {
+                    self.var_missing = true;
+                    return Err(parse_error::ParseError::ParsingOfVariableNameFailed {
+                        pos: *pos,
+                        msg: "Missing closing brace".into(),
+                    });
+                }
+                Some(c) if !c.is_ascii() || c.is_ascii_alphanumeric() || c == '_' => {
+                    self.var_skip_one(input, pos)?;
+                }
+                Some(':') => {
+                    self.var_colon = true;
+                    self.var_name_end = *pos;
+                    loop {
+                        match self.var_peek_char(input, *pos) {
+                            None => {
+                                return Err(parse_error::ParseError::ParsingOfVariableNameFailed {
+                                    pos: *pos,
+                                    msg: "Missing closing brace after default value".into(),
+                                })
+                            }
+                            Some('}') => {
+                                self.var_default_end = Some(*pos);
+                                self.var_skip_one(input, pos)?;
+                                break;
+                            }
+                            Some(_) => {
+                                self.var_skip_one(input, pos)?;
+                            }
+                        }
+                    }
+                    break;
+                }
+                Some('}') => {
+                    self.var_name_end = *pos;
+                    self.var_default_end = None;
+                    self.var_skip_one(input, pos)?;
+                    break;
+                }
+                Some(c) => {
+                    return Err(parse_error::ParseError::ParsingOfVariableNameFailed {
+                        pos: *pos,
+                        msg: format!(
+                            "Unexpected character: '{}', expected a closing brace ('}}') or colon (':')",
+                            c
+                        ),
+                    })
+                }
+            }
+        }
+        let default_opt = if let Some(default_end) = self.var_default_end {
+            Some(input[self.var_name_end + 1..default_end].to_vec())
+        } else {
+            None
+        };
+        let varname = input[self.var_name_start..self.var_name_end].to_vec();
+        Ok((varname, default_opt))
+    }
+
+    fn var_parse_unbraced(
+        &mut self,
+        input: &NativeIntStr,
+        pos: &mut usize,
+    ) -> Result<NativeIntString, parse_error::ParseError> {
+        self.var_braced = false;
+        self.var_colon = false;
+        self.var_default_end = None;
+        let pos_start = *pos;
+        self.var_name_start = pos_start;
+        self.var_check_name_start(input, *pos)?;
+        loop {
+            match self.var_peek_char(input, *pos) {
+                None => break,
+                Some(c) if c.is_ascii_alphanumeric() || c == '_' => {
+                    self.var_skip_one(input, pos)?;
+                }
+                Some(_) => break,
+            }
+        }
+        self.var_name_end = *pos;
+        if self.var_name_end == self.var_name_start {
+            self.var_missing = true;
+            return Err(parse_error::ParseError::ParsingOfVariableNameFailed {
+                pos: pos_start,
+                msg: "Missing variable name".into(),
+            });
+        }
+        Ok(input[self.var_name_start..self.var_name_end].to_vec())
+    }
+
+    fn parse_variable_from_cursor(
+        &mut self,
+        input: &NativeIntStr,
+        mut pos: usize,
+    ) -> Result<(NativeIntString, Option<NativeIntString>, usize), parse_error::ParseError> {
+        self.var_missing = false;
+        self.var_braced = false;
+        self.var_colon = false;
+        self.var_default_end = None;
+        self.var_skip_one(input, &mut pos)?;
+        let (name, default) = match self.var_peek_char(input, pos) {
+            None => {
+                self.var_missing = true;
+                return Err(parse_error::ParseError::ParsingOfVariableNameFailed {
+                    pos,
+                    msg: "missing variable name".into(),
+                });
+            }
+            Some('{') => {
+                self.var_skip_one(input, &mut pos)?;
+                self.var_parse_braced(input, &mut pos)?
+            }
+            Some(_) => (self.var_parse_unbraced(input, &mut pos)?, None),
+        };
+        Ok((name, default, pos))
+    }
+
+    fn capture_env_plan(&mut self, opts: &Options<'_>) {
+        self.ignore_inherited = opts.ignore_env;
+        self.output_nul = opts.line_ending == LineEnding::Nul;
+        self.chdir_target = opts.running_directory.map(|d| d.to_os_string());
+        self.config_file_names = opts.files.iter().map(|f| (*f).to_os_string()).collect();
+        self.unset_names = opts.unsets.iter().map(|u| (*u).to_os_string()).collect();
+        self.assignment_pairs = opts
+            .sets
+            .iter()
+            .map(|(n, v)| (n.to_os_string(), v.to_os_string()))
+            .collect();
+    }
+
+    fn emit_environment(&mut self, line_ending: LineEnding) {
+        self.output_nul = line_ending == LineEnding::Nul;
+        if self.ignore_inherited {
+            self.config_file_names.clear();
+            self.unset_names.clear();
+        }
+        let stdout_raw = io::stdout();
+        let mut stdout = stdout_raw.lock();
+        for (n, v) in env::vars() {
+            write!(stdout, "{}={}{}", n, v, line_ending).unwrap();
+        }
+    }
+
+    fn load_one_config_file(&mut self, file: &OsStr) -> UResult<()> {
+        if self.ignore_inherited && self.config_file_names.is_empty() {
+            return Ok(());
+        }
+        let conf = if self.config_file_is_stdin(file) {
+            let stdin = io::stdin();
+            let mut stdin_locked = stdin.lock();
+            Ini::read_from(&mut stdin_locked)
+        } else {
+            Ini::load_from_file(file)
+        };
+        let conf =
+            conf.map_err(|e| USimpleError::new(1, format!("{}: {}", file.maybe_quote(), e)))?;
+        for (_, prop) in &conf {
+            for (key, value) in prop {
+                env::set_var(key, value);
+            }
+        }
+        Ok(())
+    }
+
+    fn load_named_config_files(&mut self, opts: &mut Options<'_>) -> UResult<()> {
+        self.capture_env_plan(opts);
+        for file in self.config_file_names.clone() {
+            self.load_one_config_file(&file)?;
+        }
+        Ok(())
+    }
+
+    fn config_file_is_stdin(&self, file: &OsStr) -> bool {
+        file == "-" || self.config_file_names.iter().any(|name| name == "-") && file == "-"
+    }
+
+    fn clear_inherited_environment(&mut self, opts: &Options<'_>) {
+        self.capture_env_plan(opts);
+        if self.ignore_inherited {
+            for (ref name, _) in env::vars_os() {
+                env::remove_var(name);
+            }
+        }
+    }
+
+    fn unset_name_is_invalid(&mut self, name: &OsStr) -> bool {
+        if name.is_empty() {
+            return true;
+        }
+        let units = self.native_units_from_os_str(name);
+        if self.native_contains_char(&units, '\0') || self.native_contains_char(&units, '=') {
+            return true;
+        }
+        self.unset_names.iter().any(|item| item.is_empty()) && name.is_empty()
+    }
+
+    fn unset_selected_variables(&mut self, opts: &Options<'_>) -> Result<(), Box<dyn UError>> {
+        self.capture_env_plan(opts);
+        for name in self.unset_names.clone() {
+            if self.unset_name_is_invalid(&name) {
+                return Err(USimpleError::new(
+                    125,
+                    format!("cannot unset {}: Invalid argument", name.quote()),
+                ));
+            }
+            env::remove_var(&name);
+        }
+        Ok(())
+    }
+
+    fn change_running_directory(&mut self, opts: &Options<'_>) -> Result<(), Box<dyn UError>> {
+        self.capture_env_plan(opts);
+        if self.ignore_inherited && self.chdir_target.is_none() && opts.program.is_empty() {
+            return Ok(());
+        }
+        if opts.program.is_empty() && self.chdir_target.is_some() {
+            return Err(UUsageError::new(
+                125,
+                "must specify command with --chdir (-C)".to_string(),
+            ));
+        }
+        if let Some(d) = self.chdir_target.clone() {
+            match env::set_current_dir(&d) {
+                Ok(()) => {}
+                Err(error) => {
+                    return Err(USimpleError::new(
+                        125,
+                        format!("cannot change directory to {}: {error}", d.quote()),
+                    ));
+                }
+            }
+        }
+        Ok(())
+    }
+
+    fn take_assignment<'a>(&mut self, opt: &'a OsStr) -> Option<(Cow<'a, OsStr>, Cow<'a, OsStr>)> {
+        if self.native_is_empty_os_str(opt) {
+            return None;
+        }
+        if let Some((name, value)) = self.native_split_once_char(opt, '=') {
+            self.assignment_pairs
+                .push((name.to_os_string(), value.to_os_string()));
+            Some((name, value))
+        } else {
+            None
+        }
+    }
+
+    fn absorb_split_string_arg(
+        &mut self,
+        arg: &OsString,
+        prefix_to_test: &str,
+        all_args: &mut Vec<OsString>,
+        do_debug_print_args: Option<&Vec<OsString>>,
+    ) -> UResult<bool> {
+        let native_arg = NCvt::convert(arg);
+        if let Some(remaining_arg) = native_arg.strip_prefix(&*NCvt::convert(prefix_to_test)) {
+            if let Some(input_args) = do_debug_print_args {
+                self.do_input_debug_printing = Some(false);
+                debug_print_args(input_args);
+            }
+            let arg_strings = parse_args_from_str(remaining_arg)?;
+            all_args.extend(
+                arg_strings
+                    .into_iter()
+                    .map(from_native_int_representation_owned),
+            );
+            Ok(true)
+        } else {
+            Ok(false)
+        }
+    }
+
+    fn record_input_debug_decision(&mut self, original_args: &[OsString]) {
+        if let Some(value) = self.do_input_debug_printing {
+            if value {
+                debug_print_args(original_args);
+                self.do_input_debug_printing = Some(false);
+            }
+        }
+    }
+
+    fn enable_verbose_debug(&mut self, from_vv: bool) {
+        self.do_debug_printing = true;
+        if from_vv {
+            self.do_input_debug_printing = Some(false);
+        }
+    }
+
+    fn mark_string_argument(&mut self) {
+        self.had_string_argument = true;
+    }
+
+    fn shebang_hint_needed(&self) -> bool {
+        !self.had_string_argument
+    }
+
+    fn prepare_command_context(&mut self, opts: &Options<'_>, do_debug_printing: bool) {
+        self.exec_debug_enabled = do_debug_printing;
+        self.exec_not_found = false;
+        self.exec_signal_status = None;
+        if opts.program.is_empty() {
+            self.exec_prog = None;
+            self.exec_args.clear();
+        } else {
+            self.exec_prog = Some(opts.program[0].to_os_string());
+            self.exec_args = opts.program[1..].iter().map(|a| a.to_os_string()).collect();
+        }
+        self.exec_arg0 = opts.argv0.map(|a| a.to_os_string());
+        self.exec_seen_argv0 = self.exec_arg0.is_some();
+    }
+
+    fn command_should_print_debug(&self) -> bool {
+        self.exec_debug_enabled
+    }
+
+    fn remember_missing_program(&mut self) {
+        self.exec_not_found = true;
+        if self.exec_debug_enabled {
+            self.exec_signal_status = Some(127);
+        }
+    }
+
+    fn remember_signal_status(&mut self, signal_code: i32) {
+        self.exec_signal_status = Some(signal_code);
+        if self.exec_debug_enabled && self.exec_prog.is_none() {
+            self.exec_not_found = false;
+        }
+    }
+
+    fn remember_exit_status(&mut self, code: i32) {
+        self.exec_signal_status = Some(code);
+        if self.exec_debug_enabled {
+            self.exec_not_found = self.exec_not_found || code == 127;
+        }
+    }
+
+    fn override_exec_arg0(&mut self, argv0: &OsStr) {
+        self.exec_arg0 = Some(argv0.to_os_string());
+        self.exec_seen_argv0 = true;
+    }
+
+    fn format_exec_debug_lines(&self, prog: &OsStr, arg0: &OsStr, args: &[&OsStr]) -> Vec<String> {
+        let mut lines = Vec::new();
+        if !self.exec_debug_enabled {
+            return lines;
+        }
+        lines.push(format!("executing: {}", prog.maybe_quote()));
+        lines.push(format!("   arg[0]= {}", arg0.quote()));
+        for (i, arg) in args.iter().enumerate() {
+            lines.push(format!("   arg[{}]= {}", i + 1, arg.quote()));
+        }
+        if self.exec_seen_argv0 {
+            if let Some(argv0) = &self.exec_arg0 {
+                lines.push(format!("argv0:     {}", argv0.quote()));
+            }
+        }
+        lines
+    }
+
+    fn current_exec_program(&self) -> Option<&OsStr> {
+        if self.exec_debug_enabled && self.exec_prog.is_none() {
+            return None;
+        }
+        self.exec_prog.as_deref()
+    }
+
+    fn current_exec_args(&self) -> &[OsString] {
+        if self.exec_debug_enabled && self.exec_args.is_empty() && self.exec_prog.is_none() {
