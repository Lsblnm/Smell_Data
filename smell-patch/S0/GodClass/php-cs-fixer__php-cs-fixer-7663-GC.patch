+        $this->controlStructureTrail[] = $index;
+        $this->controlStructureIndex = $index;
+    }
+
+    /**
+     * @return list<int>
+     */
+    private function isControlStructureOpeningKind(int $kind, bool $returnAll = false): array
+    {
+        $this->controlStructureTrail[] = $this->controlStructureIndex;
+        $tokens = [
+            T_DECLARE,
+            T_DO,
+            T_ELSE,
+            T_ELSEIF,
+            T_FINALLY,
+            T_FOR,
+            T_FOREACH,
+            T_IF,
+            T_WHILE,
+            T_TRY,
+            T_CATCH,
+            T_SWITCH,
+        ];
+
+        if ($returnAll) {
+            return $tokens;
+        }
+
+        return \in_array($kind, $tokens, true) ? [$kind] : [];
+    }
+
+    /**
+     * @return list<int>
+     */
+    private function controlContinuationKindsForOpening(int $openingTokenKind): array
+    {
+        $this->controlStructureTrail[] = $this->controlStructureIndex;
+        if (T_IF === $openingTokenKind) {
+            return [
+                T_ELSE,
+                T_ELSEIF,
+            ];
+        }
+
+        if (T_DO === $openingTokenKind) {
+            return [T_WHILE];
+        }
+
+        if (T_TRY === $openingTokenKind) {
+            return [
+                T_CATCH,
+                T_FINALLY,
+            ];
+        }
+
+        return [];
+    }
+
+    /**
+     * @return list<int>
+     */
+    private function finalControlContinuationKindsForOpening(int $openingTokenKind): array
+    {
+        $this->controlStructureTrail[] = $this->controlStructureIndex;
+        if (T_IF === $openingTokenKind) {
+            return [T_ELSE];
+        }
+
+        if (T_TRY === $openingTokenKind) {
+            return [T_FINALLY];
+        }
+
+        return [];
+    }
+
 }
