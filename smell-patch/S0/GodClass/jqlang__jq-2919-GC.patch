+void jq_session_cli_init(jq_session *s, int argc, char **argv) {
+  memset(s, 0, sizeof(*s));
+  s->argc = argc;
+  s->argv = argv;
+  s->progname = (argc && argv && argv[0]) ? argv[0] : "jq";
+  s->program = 0;
+  s->options = 0;
+  s->args_done = 0;
+  s->further_args_are_strings = 0;
+  s->further_args_are_json = 0;
+  s->short_opts = 0;
+  s->jq_flags = 0;
+  s->parser_flags = 0;
+  s->arg_index = 1;
+  s->cli_dumpopts = JV_PRINT_INDENT_FLAGS(2);
+  s->cli_nfiles = 0;
+  s->cli_abort = 0;
+  s->cli_exit_code = JQ_OK_NO_OUTPUT;
+  s->cli_consumed = 0;
+  s->cli_lib_paths = jv_null();
+  s->cli_named = jv_object();
+  s->cli_positional = jv_array();
+}
