+void jq_session_cli_die(jq_session *s) {
+  fprintf(stderr, "Use %s --help for help with command-line options,\n", s->progname);
+  fprintf(stderr, "or see the jq manpage, or online docs  at https://jqlang.github.io/jq\n");
+  exit(2);
+}
+
+void jq_session_cli_add_positional(jq_session *s, const char *text) {
+  if (!s->progname)
+    s->progname = "jq";
+  if (s->further_args_are_strings) {
+    s->cli_positional = jv_array_append(s->cli_positional, jv_string(text));
+  } else if (s->further_args_are_json) {
+    jv v = jv_parse(text);
+    if (!jv_is_valid(v)) {
+      fprintf(stderr, "%s: invalid JSON text passed to --jsonargs\n", s->progname);
+      jq_session_cli_die(s);
+    }
+    s->cli_positional = jv_array_append(s->cli_positional, v);
+  } else {
+    s->cli_nfiles++;
+    if (s->input_state) {
+      jq_util_input_add_input(s->input_state, text);
+      s->nfiles = s->cli_nfiles;
+    }
+  }
+}
+
+void jq_session_cli_add_named(jq_session *s, const char *name, const char *value) {
+  if (!s->progname)
+    s->progname = "jq";
+  if (!name || !value) {
+    fprintf(stderr, "%s: --arg takes two parameters (e.g. --arg varname value)\n", s->progname);
+    jq_session_cli_die(s);
+  }
+  if (!jv_object_has(jv_copy(s->cli_named), jv_string(name)))
+    s->cli_named = jv_object_set(s->cli_named, jv_string(name), jv_string(value));
+}
+
+void jq_session_cli_add_argjson(jq_session *s, const char *name, const char *text) {
+  if (!s->progname)
+    s->progname = "jq";
+  if (!name || !text) {
+    fprintf(stderr, "%s: --argjson takes two parameters (e.g. --argjson varname text)\n", s->progname);
+    jq_session_cli_die(s);
+  }
+  if (!jv_object_has(jv_copy(s->cli_named), jv_string(name))) {
+    jv v = jv_parse(text);
+    if (!jv_is_valid(v)) {
+      fprintf(stderr, "%s: invalid JSON text passed to --argjson\n", s->progname);
+      jq_session_cli_die(s);
+    }
+    s->cli_named = jv_object_set(s->cli_named, jv_string(name), v);
+  }
+}
+
+int jq_session_cli_add_file_arg(jq_session *s, const char *name, const char *filename, int raw, const char *which) {
+  if (!s->progname)
+    s->progname = "jq";
+  if (!name || !filename) {
+    fprintf(stderr, "%s: --%s takes two parameters (e.g. --%s varname filename)\n", s->progname, which, which);
+    jq_session_cli_die(s);
+  }
+  if (!jv_object_has(jv_copy(s->cli_named), jv_string(name))) {
+    jv data = jv_load_file(filename, raw);
+    if (!jv_is_valid(data)) {
+      data = jv_invalid_get_msg(data);
