+              name, filename, jv_string_value(data));
+      jv_free(data);
+      s->cli_abort = 1;
+      s->cli_exit_code = JQ_ERROR_SYSTEM;
+      return 0;
+    }
+    s->cli_named = jv_object_set(s->cli_named, jv_string(name), data);
+  }
+  return 1;
+}
+
+void jq_session_cli_add_lib_path(jq_session *s, const char *path) {
+  if (!s->progname)
+    s->progname = "jq";
+  if (!path) {
+    fprintf(stderr, "-L takes a parameter: (e.g. -L /search/path or -L/search/path)\n");
+    jq_session_cli_die(s);
+  }
+  if (jv_get_kind(s->cli_lib_paths) == JV_KIND_NULL)
+    s->cli_lib_paths = jv_array();
+  s->cli_lib_paths = jv_array_append(s->cli_lib_paths, jq_realpath(jv_string(path)));
+}
+
+void jq_session_cli_set_indent(jq_session *s, const char *text) {
+  if (!s->progname)
+    s->progname = "jq";
+  if (!text) {
+    fprintf(stderr, "%s: --indent takes one parameter\n", s->progname);
+    jq_session_cli_die(s);
+  }
+  s->cli_dumpopts &= ~(JV_PRINT_TAB | JV_PRINT_INDENT_FLAGS(7));
+  int indent = atoi(text);
+  if (indent < -1 || indent > 7) {
+    fprintf(stderr, "%s: --indent takes a number between -1 and 7\n", s->progname);
+    jq_session_cli_die(s);
+  }
+  s->cli_dumpopts |= JV_PRINT_INDENT_FLAGS(indent);
+}
+
+int jq_session_cli_parse_args(jq_session *s) {
+  if (!s->progname)
+    s->progname = "jq";
+  for (s->arg_index = 1; s->arg_index < s->argc; s->arg_index++, s->short_opts = 0) {
+    if (s->args_done) {
+      if (s->further_args_are_strings) {
+        s->cli_positional = jv_array_append(s->cli_positional, jv_string(s->argv[s->arg_index]));
+      } else if (s->further_args_are_json) {
+        jv v = jv_parse(s->argv[s->arg_index]);
+        if (!jv_is_valid(v)) {
+          fprintf(stderr, "%s: invalid JSON text passed to --jsonargs\n", s->progname);
+          jq_session_cli_die(s);
+        }
+        s->cli_positional = jv_array_append(s->cli_positional, v);
+      } else {
+        jq_session_cli_add_positional(s, s->argv[s->arg_index]);
+      }
+    } else if (!strcmp(s->argv[s->arg_index], "--")) {
+      if (!s->program) jq_session_cli_usage(s, 2, 1);
+      s->args_done = 1;
+    } else if (!session_isoptish(s->argv[s->arg_index])) {
+      if (s->program) {
+        if (s->further_args_are_strings) {
+          s->cli_positional = jv_array_append(s->cli_positional, jv_string(s->argv[s->arg_index]));
+        } else if (s->further_args_are_json) {
+          jv v = jv_parse(s->argv[s->arg_index]);
+          if (!jv_is_valid(v)) {
+            fprintf(stderr, "%s: invalid JSON text passed to --jsonargs\n", s->progname);
+            jq_session_cli_die(s);
+          }
+          s->cli_positional = jv_array_append(s->cli_positional, v);
+        } else {
+          jq_session_cli_add_positional(s, s->argv[s->arg_index]);
+        }
+      } else {
+        s->program = s->argv[s->arg_index];
+      }
+    } else {
+      if (s->argv[s->arg_index][1] == 'L') {
+        if (s->argv[s->arg_index][2] != 0) {
+          jq_session_cli_add_lib_path(s, s->argv[s->arg_index]+2);
+        } else if (s->arg_index >= s->argc - 1) {
+          jq_session_cli_add_lib_path(s, NULL);
+        } else {
+          jq_session_cli_add_lib_path(s, s->argv[s->arg_index+1]);
+          s->arg_index++;
+        }
+        continue;
+      }
+
+      if (session_isoption(s->argv[s->arg_index], 's', "slurp", &s->short_opts)) {
+        s->options |= SLURP;
+        if (!s->short_opts) continue;
+      }
+      if (session_isoption(s->argv[s->arg_index], 'r', "raw-output", &s->short_opts)) {
+        s->options |= RAW_OUTPUT;
+        if (!s->short_opts) continue;
+      }
+      if (session_isoption(s->argv[s->arg_index], 0, "raw-output0", &s->short_opts)) {
+        s->options |= RAW_OUTPUT | RAW_NO_LF | RAW_OUTPUT0;
+        if (!s->short_opts) continue;
+      }
+      if (session_isoption(s->argv[s->arg_index], 'j', "join-output", &s->short_opts)) {
+        s->options |= RAW_OUTPUT | RAW_NO_LF;
+        if (!s->short_opts) continue;
+      }
+      if (session_isoption(s->argv[s->arg_index], 'c', "compact-output", &s->short_opts)) {
+        s->cli_dumpopts &= ~(JV_PRINT_TAB | JV_PRINT_INDENT_FLAGS(7));
+        if (!s->short_opts) continue;
+      }
+      if (session_isoption(s->argv[s->arg_index], 'C', "color-output", &s->short_opts)) {
+        s->options |= COLOR_OUTPUT;
+        if (!s->short_opts) continue;
+      }
+      if (session_isoption(s->argv[s->arg_index], 'M', "monochrome-output", &s->short_opts)) {
+        s->options |= NO_COLOR_OUTPUT;
+        if (!s->short_opts) continue;
+      }
+      if (session_isoption(s->argv[s->arg_index], 'a', "ascii-output", &s->short_opts)) {
+        s->options |= ASCII_OUTPUT;
+        if (!s->short_opts) continue;
+      }
+      if (session_isoption(s->argv[s->arg_index], 0, "unbuffered", &s->short_opts)) {
+        s->options |= UNBUFFERED_OUTPUT;
+        continue;
+      }
+      if (session_isoption(s->argv[s->arg_index], 'S', "sort-keys", &s->short_opts)) {
+        s->options |= SORTED_OUTPUT;
+        if (!s->short_opts) continue;
+      }
+      if (session_isoption(s->argv[s->arg_index], 'R', "raw-input", &s->short_opts)) {
+        s->options |= RAW_INPUT;
+        if (!s->short_opts) continue;
+      }
+      if (session_isoption(s->argv[s->arg_index], 'n', "null-input", &s->short_opts)) {
+        s->options |= PROVIDE_NULL;
+        if (!s->short_opts) continue;
+      }
+      if (session_isoption(s->argv[s->arg_index], 'f', "from-file", &s->short_opts)) {
+        s->options |= FROM_FILE;
+        if (!s->short_opts) continue;
+      }
+      if (session_isoption(s->argv[s->arg_index], 'b', "binary", &s->short_opts)) {
+#ifdef WIN32
+        fflush(stdout);
+        fflush(stderr);
+        _setmode(fileno(stdin),  _O_BINARY);
+        _setmode(fileno(stdout), _O_BINARY);
+        _setmode(fileno(stderr), _O_BINARY);
+        if (!s->short_opts) continue;
+#endif
+      }
+      if (session_isoption(s->argv[s->arg_index], 0, "tab", &s->short_opts)) {
+        s->cli_dumpopts &= ~JV_PRINT_INDENT_FLAGS(7);
+        s->cli_dumpopts |= JV_PRINT_TAB | JV_PRINT_PRETTY;
+        continue;
+      }
+      if (session_isoption(s->argv[s->arg_index], 0, "indent", &s->short_opts)) {
+        if (s->arg_index >= s->argc - 1)
+          jq_session_cli_set_indent(s, NULL);
+        else {
+          jq_session_cli_set_indent(s, s->argv[s->arg_index+1]);
+          s->arg_index++;
+        }
+        continue;
+      }
+      if (session_isoption(s->argv[s->arg_index], 0, "seq", &s->short_opts)) {
+        s->options |= SEQ;
+        continue;
+      }
+      if (session_isoption(s->argv[s->arg_index], 0, "stream", &s->short_opts)) {
+        s->parser_flags |= JV_PARSE_STREAMING;
+        continue;
+      }
+      if (session_isoption(s->argv[s->arg_index], 0, "stream-errors", &s->short_opts)) {
+        s->parser_flags |= JV_PARSE_STREAMING | JV_PARSE_STREAM_ERRORS;
+        continue;
+      }
+      if (session_isoption(s->argv[s->arg_index], 'e', "exit-status", &s->short_opts)) {
+        s->options |= EXIT_STATUS;
+        if (!s->short_opts) continue;
+      }
+      if (session_isoption(s->argv[s->arg_index], 0, "args", &s->short_opts)) {
+        s->further_args_are_strings = 1;
+        s->further_args_are_json = 0;
+        continue;
+      }
+      if (session_isoption(s->argv[s->arg_index], 0, "jsonargs", &s->short_opts)) {
+        s->further_args_are_strings = 0;
+        s->further_args_are_json = 1;
+        continue;
+      }
+      if (session_isoption(s->argv[s->arg_index], 0, "arg", &s->short_opts)) {
+        if (s->arg_index >= s->argc - 2) {
+          jq_session_cli_add_named(s, NULL, NULL);
+        } else {
+          jq_session_cli_add_named(s, s->argv[s->arg_index+1], s->argv[s->arg_index+2]);
+          s->arg_index += 2;
+        }
+        continue;
+      }
+      if (session_isoption(s->argv[s->arg_index], 0, "argjson", &s->short_opts)) {
+        if (s->arg_index >= s->argc - 2) {
+          jq_session_cli_add_argjson(s, NULL, NULL);
+        } else {
+          jq_session_cli_add_argjson(s, s->argv[s->arg_index+1], s->argv[s->arg_index+2]);
+          s->arg_index += 2;
+        }
+        continue;
+      }
+      if (session_isoption(s->argv[s->arg_index], 0, "rawfile", &s->short_opts) ||
+          session_isoption(s->argv[s->arg_index], 0, "slurpfile", &s->short_opts)) {
+        int raw = session_isoption(s->argv[s->arg_index], 0, "rawfile", &s->short_opts);
+        const char *which = raw ? "rawfile" : "slurpfile";
+        if (s->arg_index >= s->argc - 2) {
+          jq_session_cli_add_file_arg(s, NULL, NULL, raw, which);
+        } else {
+          if (!jq_session_cli_add_file_arg(s, s->argv[s->arg_index+1], s->argv[s->arg_index+2], raw, which))
+            return 0;
+          s->arg_index += 2;
+        }
+        continue;
+      }
+      if (session_isoption(s->argv[s->arg_index],  0,  "debug-dump-disasm", &s->short_opts)) {
+        s->options |= DUMP_DISASM;
+        continue;
+      }
+      if (session_isoption(s->argv[s->arg_index],  0,  "debug-trace=all", &s->short_opts)) {
+        s->jq_flags |= JQ_DEBUG_TRACE_ALL;
+        if (!s->short_opts) continue;
+      }
+      if (session_isoption(s->argv[s->arg_index],  0,  "debug-trace", &s->short_opts)) {
+        s->jq_flags |= JQ_DEBUG_TRACE;
+        continue;
+      }
+      if (session_isoption(s->argv[s->arg_index], 'h', "help", &s->short_opts)) {
+        jq_session_cli_usage(s, 0, 0);
+        if (!s->short_opts) continue;
+      }
+      if (session_isoption(s->argv[s->arg_index], 'V', "version", &s->short_opts)) {
+        printf("jq-%s\n", JQ_VERSION);
+        s->cli_abort = 1;
+        s->cli_exit_code = JQ_OK;
+        s->cli_consumed = 1;
+        return 0;
+      }
+      if (session_isoption(s->argv[s->arg_index], 0, "build-configuration", &s->short_opts)) {
+        printf("%s\n", JQ_CONFIG);
+        s->cli_abort = 1;
+        s->cli_exit_code = JQ_OK;
+        s->cli_consumed = 1;
+        return 0;
+      }
+      if (session_isoption(s->argv[s->arg_index], 0, "run-tests", &s->short_opts)) {
+        s->arg_index++;
+        s->cli_exit_code = jq_testsuite(s->cli_lib_paths,
+                           (s->options & DUMP_DISASM) || (s->jq_flags & JQ_DEBUG_TRACE),
+                           s->argc - s->arg_index, s->argv + s->arg_index);
+        s->cli_lib_paths = jv_invalid();
+        s->cli_abort = 1;
+        s->cli_consumed = 1;
+        return 0;
+      }
+
+      if (strlen(s->argv[s->arg_index]) != s->short_opts + 1) {
+        fprintf(stderr, "%s: Unknown option %s\n", s->progname, s->argv[s->arg_index]);
+        jq_session_cli_die(s);
+      }
+    }
+  }
+  return 1;
+}
+
+int jq_session_engine_init(jq_session *s) {
+  s->jq = jq_init();
+  s->compiled = 0;
+  s->engine_ready = 0;
+  s->engine_trace = 0;
+  s->engine_halted = 0;
+  if (s->jq == NULL)
+    return 0;
+  s->engine_ready = 1;
+  return 1;
+}
+
+void jq_session_engine_set_library_path(jq_session *s, jv paths) {
+  if (!s->jq) {
+    jv_free(paths);
+    return;
+  }
+  if (jv_get_kind(paths) == JV_KIND_NULL) {
+    paths = JV_ARRAY(jv_string("~/.jq"),
+                     jv_string("$ORIGIN/../lib/jq"),
+                     jv_string("$ORIGIN/../lib"));
+  }
+  jq_set_attr(s->jq, jv_string("JQ_LIBRARY_PATH"), paths);
+}
+
+void jq_session_engine_set_origin(jq_session *s, const char *exe_path) {
+  if (!s->jq || !exe_path)
+    return;
+  char *origin = strdup(exe_path);
+  if (origin == NULL) {
+    fprintf(stderr, "jq: error: out of memory\n");
+    exit(1);
+  }
+  jv_free(s->engine_origin);
+  s->engine_origin = jv_string(dirname(origin));
+  jq_set_attr(s->jq, jv_string("JQ_ORIGIN"), jv_copy(s->engine_origin));
+  free(origin);
+}
+
+void jq_session_engine_set_prog_origin(jq_session *s, jv origin) {
+  if (!s->jq) {
+    jv_free(origin);
+    return;
+  }
+  jv_free(s->engine_prog_origin);
+  s->engine_prog_origin = jv_copy(origin);
+  jq_set_attr(s->jq, jv_string("PROGRAM_ORIGIN"), origin);
+}
+
+void jq_session_engine_set_version_dir(jq_session *s, const char *version) {
+  if (!s->jq || !version)
+    return;
+  if (strchr(version, '-') == NULL)
+    jq_set_attr(s->jq, jv_string("VERSION_DIR"), jv_string(version));
+  else
+    jq_set_attr(s->jq, jv_string("VERSION_DIR"), jv_string_fmt("%.*s-master", (int)(strchr(version, '-') - version), version));
+}
+
+int jq_session_engine_compile(jq_session *s, const char *program, jv args) {
+  if (!s->jq) {
+    jv_free(args);
+    s->compiled = 0;
+    return 0;
+  }
+  s->compiled = jq_compile_args(s->jq, program, args);
+  return s->compiled;
+}
+
+void jq_session_engine_dump_disasm(jq_session *s) {
+  if (!s->jq)
+    return;
+  jq_dump_disassembly(s->jq, 0);
+  printf("\n");
+}
+
+void jq_session_engine_bind_callbacks(jq_session *s) {
+  if (!s->jq)
+    return;
+  jq_set_debug_cb(s->jq, jq_session_output_debug_cb, s);
+  jq_set_stderr_cb(s->jq, jq_session_output_stderr_cb, s);
+  s->engine_trace = s->engine_ready;
+}
+
+void jq_session_engine_teardown(jq_session *s) {
+  if (s->jq)
+    jq_teardown(&s->jq);
+  s->jq = NULL;
+  s->compiled = 0;
+  s->engine_ready = 0;
+  s->engine_trace = 0;
+  s->engine_halted = 0;
+  jv_free(s->engine_attrs);
+  jv_free(s->engine_origin);
+  jv_free(s->engine_prog_origin);
+  s->engine_attrs = jv_invalid();
+  s->engine_origin = jv_invalid();
+  s->engine_prog_origin = jv_invalid();
+}
+
+void jq_session_input_init(jq_session *s) {
+  s->input_state = jq_util_input_init(NULL, NULL);
+  s->nfiles = 0;
+  s->last_result = -1;
+  s->input_slurp = 0;
+  s->input_raw = 0;
+  s->input_failures = 0;
+  jv_free(s->input_current);
+  jv_free(s->input_position);
+  s->input_current = jv_invalid();
+  s->input_position = jv_invalid();
+}
+
+void jq_session_input_add(jq_session *s, const char *fname) {
+  if (!s->input_state || !fname)
+    return;
+  jq_util_input_add_input(s->input_state, fname);
+  s->nfiles++;
+}
+
+void jq_session_input_set_parser(jq_session *s, int parser_flags, int slurp, int raw) {
+  if (!s->input_state)
+    return;
+  s->input_slurp = slurp;
+  s->input_raw = raw;
+  if (raw)
+    jq_util_input_set_parser(s->input_state, NULL, slurp);
+  else
+    jq_util_input_set_parser(s->input_state, jv_parser_new(parser_flags), slurp);
+}
+
+jv jq_session_input_next(jq_session *s) {
+  if (!s->input_state)
+    return jv_invalid();
+  jv_free(s->input_current);
+  s->input_current = jv_invalid();
+  return jq_util_input_next_input(s->input_state);
+}
+
+int jq_session_input_errors(jq_session *s) {
+  if (!s->input_state)
+    return s->input_failures;
+  s->input_failures = jq_util_input_errors(s->input_state);
+  return s->input_failures;
+}
+
+void jq_session_input_ensure_stdin(jq_session *s) {
+  if (!s->input_state)
+    return;
+  if (s->nfiles == 0) {
+    jq_util_input_add_input(s->input_state, "-");
+    s->nfiles++;
+  }
+}
+
+jv jq_session_input_get_position(jq_session *s) {
+  jq_util_input_state *st = s->input_state;
+  if (!st || jv_get_kind(st->current_filename) != JV_KIND_STRING)
+    return jv_string("<unknown>");
+  jv_free(s->input_position);
+  s->input_position = jv_string_fmt("%s:%lu", jv_string_value(st->current_filename),
+                                    (unsigned long)st->current_line);
+  return jv_copy(s->input_position);
+}
+
+void jq_session_input_free(jq_session *s) {
+  if (s->input_state)
+    jq_util_input_free(&s->input_state);
+  s->input_state = NULL;
+  s->nfiles = 0;
+  s->input_failures = 0;
+  s->input_slurp = 0;
+  s->input_raw = 0;
+  jv_free(s->input_current);
+  jv_free(s->input_position);
+  s->input_current = jv_invalid();
+  s->input_position = jv_invalid();
+}
+
+jv jq_session_input_current_filename(jq_session *s) {
+  if (!s->input_state)
+    return jv_invalid();
+  return jv_copy(s->input_state->current_filename);
+}
+
+void jq_session_output_init(jq_session *s, int dumpopts) {
+  s->dumpopts = dumpopts;
+  s->ret = JQ_OK_NO_OUTPUT;
+  s->out_isatty = 0;
+  s->out_color = 0;
+  s->out_seq = 0;
+  s->halt_status = 0;
+  s->out_fp = stdout;
+  s->err_fp = stderr;
+  jv_free(s->last_error);
+  s->last_error = jv_invalid();
+}
+
+void jq_session_output_write_raw(jq_session *s, const char *buf, size_t len) {
+  FILE *fp = s->out_fp ? s->out_fp : stdout;
+  priv_fwrite(buf, len, fp, s->dumpopts & JV_PRINT_ISATTY);
+}
+
+void jq_session_output_write_json(jq_session *s, jv value) {
+  jv_dump(value, s->dumpopts);
+}
+
+void jq_session_output_apply_flags(jq_session *s, int options) {
+#ifdef USE_ISATTY
+  if (isatty(STDOUT_FILENO)) {
+#ifndef WIN32
+    s->dumpopts |= JV_PRINT_ISATTY | JV_PRINT_COLOR;
+    s->out_isatty = 1;
+    s->out_color = 1;
+#else
+    DWORD mode;
+    HANDLE con = GetStdHandle(STD_OUTPUT_HANDLE);
+    if (GetConsoleMode(con, &mode)) {
+      s->dumpopts |= JV_PRINT_ISATTY;
+      s->out_isatty = 1;
+      if (getenv("ANSICON") != NULL ||
+          SetConsoleMode(con, mode | 4)) {
+        s->dumpopts |= JV_PRINT_COLOR;
+        s->out_color = 1;
+      }
+    }
+#endif
+    if (s->dumpopts & JV_PRINT_COLOR) {
+      char *no_color = getenv("NO_COLOR");
+      if (no_color != NULL && no_color[0] != '\0') {
+        s->dumpopts &= ~JV_PRINT_COLOR;
+        s->out_color = 0;
+      }
+    }
+  }
+#endif
+  if (options & SORTED_OUTPUT) s->dumpopts |= JV_PRINT_SORTED;
+  if (options & ASCII_OUTPUT) s->dumpopts |= JV_PRINT_ASCII;
+  if (options & COLOR_OUTPUT) s->dumpopts |= JV_PRINT_COLOR;
+  if (options & NO_COLOR_OUTPUT) s->dumpopts &= ~JV_PRINT_COLOR;
+  if (options & SEQ) s->out_seq = 1;
+}
+
+void jq_session_output_handle_halt(jq_session *s, jq_state *jq) {
+  if (!jq || !jq_halted(jq))
+    return;
+  s->halt_status = 1;
+  jv exit_code = jq_get_exit_code(jq);
+  if (!jv_is_valid(exit_code))
+    s->ret = JQ_OK;
+  else if (jv_get_kind(exit_code) == JV_KIND_NUMBER)
+    s->ret = jv_number_value(exit_code);
+  else
+    s->ret = JQ_ERROR_UNKNOWN;
+  jv_free(exit_code);
+  jv error_message = jq_get_error_message(jq);
+  if (jv_get_kind(error_message) == JV_KIND_STRING) {
+    priv_fwrite(jv_string_value(error_message), jv_string_length_bytes(jv_copy(error_message)),
+        s->err_fp ? s->err_fp : stderr, s->dumpopts & JV_PRINT_ISATTY);
+  } else if (jv_get_kind(error_message) == JV_KIND_NULL) {
+    /* Halt with no output */
+  } else if (jv_is_valid(error_message)) {
+    error_message = jv_dump_string(error_message, 0);
+    fprintf(s->err_fp ? s->err_fp : stderr, "%s\n", jv_string_value(error_message));
+  }
+  fflush(s->err_fp ? s->err_fp : stderr);
+  jv_free(s->last_error);
+  s->last_error = jv_copy(error_message);
+  jv_free(error_message);
+}
+
+void jq_session_output_handle_exception(jq_session *s, jq_state *jq, jv result) {
+  jv msg = jv_invalid_get_msg(jv_copy(result));
+  jv input_pos = jq ? jq_util_input_get_position(jq) : jv_string("<unknown>");
+  if (jv_get_kind(msg) == JV_KIND_STRING) {
+    fprintf(s->err_fp ? s->err_fp : stderr, "jq: error (at %s): %s\n",
+            jv_string_value(input_pos), jv_string_value(msg));
+  } else {
+    msg = jv_dump_string(msg, 0);
+    fprintf(s->err_fp ? s->err_fp : stderr, "jq: error (at %s) (not a string): %s\n",
+            jv_string_value(input_pos), jv_string_value(msg));
+  }
+  s->ret = JQ_ERROR_UNKNOWN;
+  jv_free(s->last_error);
+  s->last_error = jv_copy(msg);
+  jv_free(input_pos);
+  jv_free(msg);
+}
+
+void jq_session_output_flush_err(jq_session *s) {
+  if (s->err_fp)
+    fflush(s->err_fp);
+  else
+    fflush(stderr);
+}
+
+int jq_session_output_process(jq_session *s, jq_state *jq, jv value, int flags, int options) {
+  int ret = JQ_OK_NO_OUTPUT;
+  if (!jq) {
+    jv_free(value);
+    s->ret = JQ_ERROR_SYSTEM;
+    return s->ret;
+  }
+  jq_start(jq, value, flags);
+  jv result;
+  while (jv_is_valid(result = jq_next(jq))) {
+    if ((options & RAW_OUTPUT) && jv_get_kind(result) == JV_KIND_STRING) {
+      if (options & ASCII_OUTPUT) {
+        jv_dumpf(jv_copy(result), stdout, JV_PRINT_ASCII);
+      } else if ((options & RAW_OUTPUT0) && strlen(jv_string_value(result)) != (unsigned long)jv_string_length_bytes(jv_copy(result))) {
+        jv_free(result);
+        result = jv_invalid_with_msg(jv_string(
+              "Cannot dump a string containing NUL with --raw-output0 option"));
+        break;
+      } else {
+        jq_session_output_write_raw(s, jv_string_value(result),
+            jv_string_length_bytes(jv_copy(result)));
+      }
+      ret = JQ_OK;
+      jv_free(result);
+    } else {
+      if (jv_get_kind(result) == JV_KIND_FALSE || jv_get_kind(result) == JV_KIND_NULL)
+        ret = JQ_OK_NULL_KIND;
+      else
+        ret = JQ_OK;
+      if (options & SEQ)
+        jq_session_output_write_raw(s, "\036", 1);
+      jq_session_output_write_json(s, result);
+    }
+    if (!(options & RAW_NO_LF))
+      jq_session_output_write_raw(s, "\n", 1);
+    if (options & RAW_OUTPUT0)
+      jq_session_output_write_raw(s, "\0", 1);
+    if (options & UNBUFFERED_OUTPUT)
+      fflush(s->out_fp ? s->out_fp : stdout);
+  }
+  if (jq_halted(jq)) {
+    jq_session_output_handle_halt(s, jq);
+    ret = s->ret;
+  } else if (jv_invalid_has_msg(jv_copy(result))) {
+    jq_session_output_handle_exception(s, jq, result);
+    ret = s->ret;
+  }
+  jv_free(result);
+  s->ret = ret;
+  return ret;
+}
+
+void jq_session_output_debug_cb(void *data, jv input) {
+  jq_session *s = data;
+  int dumpopts = s ? s->dumpopts : 0;
+  jv_dumpf(JV_ARRAY(jv_string("DEBUG:"), input), stderr, dumpopts & ~(JV_PRINT_PRETTY));
+  fprintf(stderr, "\n");
+}
+
+void jq_session_output_stderr_cb(void *data, jv input) {
+  jq_session *s = data;
+  if (jv_get_kind(input) == JV_KIND_STRING) {
+    int dumpopts = s ? s->dumpopts : 0;
+    priv_fwrite(jv_string_value(input), jv_string_length_bytes(jv_copy(input)),
+        stderr, dumpopts & JV_PRINT_ISATTY);
+  } else {
+    input = jv_dump_string(input, 0);
+    fprintf(stderr, "%s", jv_string_value(input));
+  }
+  jv_free(input);
+}
+
+void jq_session_path_scratch(jq_session *s) {
+  memset(s, 0, sizeof(*s));
+  s->last_path = jv_invalid();
+  s->home_cache = jv_invalid();
+  s->loaded_data = jv_invalid();
+  s->path_error = jv_invalid();
+  s->search_acc = jv_invalid();
+  s->loc_active = NULL;
+  s->loc_line_hint = 0;
+  s->file_raw_mode = 0;
+  s->path_status = 0;
+}
+
+jv jq_session_path_expand(jq_session *s, jv path) {
+  assert(jv_get_kind(path) == JV_KIND_STRING);
+  const char *pstr = jv_string_value(path);
+  jv ret = path;
+  jv_free(s->last_path);
+  s->last_path = jv_copy(path);
+  if (jv_string_length_bytes(jv_copy(path)) > 1 && pstr[0] == '~' && pstr[1] == '/') {
+    jv home = jq_session_path_home(s);
+    if (jv_is_valid(home)) {
+      ret = jv_string_fmt("%s/%s",jv_string_value(home),pstr+2);
+      jv_free(home);
+    } else {
+      jv emsg = jv_invalid_get_msg(home);
+      ret = jv_invalid_with_msg(jv_string_fmt("Could not expand %s. (%s)", pstr, jv_string_value(emsg)));
+      jv_free(emsg);
+    }
+    jv_free(path);
+  }
+  return ret;
+}
+
+jv jq_session_path_home(jq_session *s) {
+  jv ret;
+  char *home = getenv("HOME");
+  if (!home) {
+#ifndef WIN32
+    ret = jv_invalid_with_msg(jv_string("Could not find home directory."));
+#else
+    home = getenv("USERPROFILE");
+    if (!home) {
+      char *hd = getenv("HOMEDRIVE");
+      if (!hd) hd = "";
+      home = getenv("HOMEPATH");
+      if (!home) {
+        ret = jv_invalid_with_msg(jv_string("Could not find home directory."));
+      } else {
+        ret = jv_string_fmt("%s%s",hd,home);
+      }
+    } else {
+      ret = jv_string(home);
+    }
+#endif
+  } else {
+    ret = jv_string(home);
+  }
+  jv_free(s->home_cache);
+  s->home_cache = jv_copy(ret);
+  jv_free(s->last_path);
+  s->last_path = jv_copy(ret);
+  return ret;
+}
+
+jv jq_session_path_realpath(jq_session *s, jv path) {
+  int path_max;
+  char *buf = NULL;
+#ifdef _PC_PATH_MAX
+  path_max = pathconf(jv_string_value(path),_PC_PATH_MAX);
+#else
+  path_max = PATH_MAX;
+#endif
+  if (path_max > 0) {
+     buf = jv_mem_alloc(path_max);
+  }
+#ifdef WIN32
+  char *tmp = _fullpath(buf, jv_string_value(path), path_max);
+#else
+  char *tmp = realpath(jv_string_value(path), buf);
+#endif
+  jv_free(s->last_path);
+  s->last_path = jv_copy(path);
+  if (tmp == NULL) {
+    free(buf);
+    return path;
+  }
+  jv_free(path);
+  path = jv_string(tmp);
+  free(tmp);
+  jv_free(s->last_path);
+  s->last_path = jv_copy(path);
+  return path;
+}
+
+int jq_session_path_is_relative(jq_session *s, jv p) {
+  const char *str = jv_string_value(p);
+  jv_free(s->last_path);
+  s->last_path = jv_copy(p);
+#ifdef WIN32
+  int res = PathIsRelativeA(str);
+#else
+  int res = *str != '/';
+#endif
+  jv_free(p);
+  s->path_status = res;
+  return res;
+}
+
+jv jq_session_path_validate_rel(jq_session *s, jv name) {
+  const char *str = jv_string_value(name);
+  jv_free(s->last_path);
+  s->last_path = jv_copy(name);
+  if (strchr(str, '\\')) {
+    jv res = jv_invalid_with_msg(jv_string_fmt("Modules must be named by relative paths using '/', not '\\' (%s)", str));
+    jv_free(name);
+    s->path_error = jv_copy(res);
+    return res;
+  }
+  jv components = jv_string_split(jv_copy(name), jv_string("/"));
+  jv_array_foreach(components, i, x) {
+    if (!strcmp(jv_string_value(x), "..")) {
+      jv_free(x);
+      jv_free(components);
+      jv res = jv_invalid_with_msg(jv_string_fmt("Relative paths to modules may not traverse to parent directories (%s)", str));
+      jv_free(name);
+      s->path_error = jv_copy(res);
+      return res;
+    }
+    if (i > 0 && jv_equal(jv_copy(x), jv_array_get(jv_copy(components), i - 1))) {
+      jv_free(x);
+      jv_free(components);
+      jv res = jv_invalid_with_msg(jv_string_fmt("module names must not have equal consecutive components: %s",
+                                                 jv_string_value(name)));
+      jv_free(name);
+      s->path_error = jv_copy(res);
+      return res;
+    }
+    jv_free(x);
+  }
+  jv_free(components);
+  return name;
+}
+
+jv jq_session_path_basename(jq_session *s, jv name) {
+  const char *str = jv_string_value(name);
+  jv_free(s->last_path);
+  s->last_path = jv_copy(name);
+  const char *p = strrchr(str, '/');
+  if (!p)
+    return name;
+  jv res = jv_string_fmt("%s", p);
+  jv_free(name);
+  return res;
+}
+
+jv jq_session_path_search_chain(jq_session *s, jq_state *jq, jv search_path, jv jq_origin, jv lib_origin) {
+  (void)jq;
+  assert(jv_get_kind(search_path) == JV_KIND_ARRAY);
+  jv expanded = jv_array();
+  jv expanded_elt;
+  jv err = jv_null();
+  jv_array_foreach(search_path, i, path) {
+    if (jv_get_kind(path) != JV_KIND_STRING) {
+      jv_free(path);
+      continue;
+    }
+    jv_free(s->last_path);
+    s->last_path = jv_copy(path);
+    path = jq_session_path_expand(s, path);
+    if (!jv_is_valid(path)) {
+      err = path;
+      path = jv_null();
+      continue;
+    }
+    if (strcmp(".",jv_string_value(path)) == 0) {
+      expanded_elt = jv_copy(path);
+    } else if (strncmp("$ORIGIN/",jv_string_value(path),sizeof("$ORIGIN/") - 1) == 0) {
+      expanded_elt = jv_string_fmt("%s/%s",
+                               jv_string_value(jq_origin),
+                               jv_string_value(path) + sizeof ("$ORIGIN/") - 1);
+    } else if (jv_get_kind(lib_origin) == JV_KIND_STRING &&
+               jq_session_path_is_relative(s, jv_copy(path))) {
+      expanded_elt = jv_string_fmt("%s/%s",
+                               jv_string_value(lib_origin),
+                               jv_string_value(path));
+    } else {
+      expanded_elt = path;
+      path = jv_invalid();
+    }
+    expanded = jv_array_append(expanded, expanded_elt);
+    jv_free(path);
+  }
+  jv_free(jq_origin);
+  jv_free(lib_origin);
+  jv_free(search_path);
+  jv_free(s->search_acc);
+  s->search_acc = jv_copy(expanded);
+  return JV_ARRAY(expanded, err);
+}
+
+jv jq_session_path_find_lib(jq_session *s, jq_state *jq, jv rel_path, jv search, const char *suffix, jv jq_origin, jv lib_origin) {
+  if (!jv_is_valid(rel_path)) {
+    jv_free(search);
+    jv_free(jq_origin);
+    jv_free(lib_origin);
+    jv_free(s->last_path);
+    s->last_path = jv_copy(rel_path);
+    return rel_path;
+  }
+  if (jv_get_kind(rel_path) != JV_KIND_STRING) {
+    jv_free(rel_path);
+    jv_free(search);
+    jv_free(jq_origin);
+    jv_free(lib_origin);
+    return jv_invalid_with_msg(jv_string_fmt("Module path must be a string"));
+  }
+  if (jv_get_kind(search) != JV_KIND_ARRAY) {
+    jv_free(rel_path);
+    jv_free(search);
+    jv_free(jq_origin);
+    jv_free(lib_origin);
+    return jv_invalid_with_msg(jv_string_fmt("Module search path must be an array"));
+  }
+
+  struct stat st;
+  int ret;
+  jv_free(s->last_path);
+  s->last_path = jv_copy(rel_path);
+
+  search = jq_session_path_search_chain(s, jq, search, jq_origin, lib_origin);
+  jv err = jv_array_get(jv_copy(search), 1);
+  search = jv_array_get(search, 0);
+
+  jv bname = jq_session_path_basename(s, jv_copy(rel_path));
+
+  jv_array_foreach(search, i, spath) {
+    if (jv_get_kind(spath) == JV_KIND_NULL) {
+      jv_free(spath);
+      break;
+    }
+    if (jv_get_kind(spath) != JV_KIND_STRING ||
+        strcmp(jv_string_value(spath), "") == 0) {
+      jv_free(spath);
+      continue;
+    }
+    jv testpath = jq_session_path_realpath(s, jv_string_fmt("%s/%s%s",
+                                            jv_string_value(spath),
+                                            jv_string_value(rel_path),
+                                            suffix));
+    ret = stat(jv_string_value(testpath),&st);
+    if (ret == -1 && errno == ENOENT) {
+      jv_free(testpath);
+      testpath = jq_session_path_realpath(s, jv_string_fmt("%s/%s/%s%s",
+                                           jv_string_value(spath),
+                                           jv_string_value(rel_path),
+                                           "jq/main",
+                                           suffix));
+      ret = stat(jv_string_value(testpath),&st);
+    }
+    if (ret == -1 && errno == ENOENT) {
+      jv_free(testpath);
+      testpath = jq_session_path_realpath(s, jv_string_fmt("%s/%s/%s%s",
+                                           jv_string_value(spath),
+                                           jv_string_value(rel_path),
+                                           jv_string_value(bname),
+                                           suffix));
+      ret = stat(jv_string_value(testpath),&st);
+    }
+    if (ret == 0) {
+      jv_free(err);
+      jv_free(rel_path);
+      jv_free(search);
+      jv_free(bname);
+      jv_free(spath);
+      jv_free(s->last_path);
+      s->last_path = jv_copy(testpath);
+      return testpath;
+    }
+    jv_free(testpath);
+    jv_free(spath);
+  }
+  jv output;
+  if (!jv_is_valid(err)) {
+    err = jv_invalid_get_msg(err);
+    output = jv_invalid_with_msg(jv_string_fmt("module not found: %s (%s)",
+                                               jv_string_value(rel_path),
+                                               jv_string_value(err)));
+  } else {
+    output = jv_invalid_with_msg(jv_string_fmt("module not found: %s",
+                                               jv_string_value(rel_path)));
+  }
+  jv_free(err);
+  jv_free(rel_path);
+  jv_free(search);
+  jv_free(bname);
+  s->path_error = jv_copy(output);
+  return output;
+}
+
+jv jq_session_path_default_search(jq_session *s, jq_state *jq, jv value) {
+  jv_free(s->last_path);
+  s->last_path = jv_copy(value);
+  if (!jv_is_valid(value)) {
+    jv_free(value);
+    return jv_array_concat(JV_ARRAY(jv_string(".")), jq_get_lib_dirs(jq));
+  }
+  if (jv_get_kind(value) != JV_KIND_ARRAY)
+    return JV_ARRAY(value);
+  return value;
+}
+
+jv jq_session_file_load(jq_session *s, const char* filename, int raw) {
+  struct stat sb;
+  s->file_raw_mode = raw;
+  jv_free(s->last_path);
+  s->last_path = jv_string(filename);
+  int fd = open(filename, O_RDONLY);
+  if (fd == -1) {
+    return jv_invalid_with_msg(jv_string_fmt("Could not open %s: %s",
+                                             filename,
+                                             strerror(errno)));
+  }
+  if (fstat(fd, &sb) == -1 || S_ISDIR(sb.st_mode)) {
+    close(fd);
+    return jv_invalid_with_msg(jv_string_fmt("Could not open %s: %s",
+                                             filename,
+                                             "It's a directory"));
+  }
+  FILE* file = fdopen(fd, "r");
+  struct jv_parser* parser = NULL;
+  jv data;
+  if (!file) {
+    close(fd);
+    return jv_invalid_with_msg(jv_string_fmt("Could not open %s: %s",
+                                             filename,
+                                             strerror(errno)));
+  }
+  if (raw) {
+    data = jv_string("");
+  } else {
+    data = jv_array();
+    parser = jv_parser_new(0);
+  }
+
+  const int max_utf8_len = 4;
+  char buf[4096+max_utf8_len];
+  while (!feof(file) && !ferror(file)) {
+    size_t n = fread(buf, 1, sizeof(buf)-max_utf8_len, file);
+    int len = 0;
+
+    if (n == 0)
+      continue;
+    if (jvp_utf8_backtrack(buf+(n-1), buf, &len) && len > 0 &&
+        !feof(file) && !ferror(file)) {
+      n += fread(buf+n, 1, len, file);
+    }
+
+    if (raw) {
+      data = jv_string_append_buf(data, buf, n);
+    } else {
+      jv_parser_set_buf(parser, buf, n, !feof(file));
+      jv value;
+      while (jv_is_valid((value = jv_parser_next(parser))))
+        data = jv_array_append(data, value);
+      if (jv_invalid_has_msg(jv_copy(value))) {
+        jv_free(data);
+        data = value;
+        break;
+      }
+    }
+  }
+  if (!raw)
+      jv_parser_free(parser);
+  int badread = ferror(file);
+  if (fclose(file) != 0 || badread) {
+    jv_free(data);
+    return jv_invalid_with_msg(jv_string_fmt("Error reading from %s",
+                                             filename));
+  }
+  jv_free(s->loaded_data);
+  s->loaded_data = jv_copy(data);
+  return data;
+}
+
+void *jq_session_loc_open(jq_session *s, jq_state *jq, const char *fname, const char* data, int length) {
+  struct locfile* l = jv_mem_alloc(sizeof(struct locfile));
+  l->jq = jq;
+  l->fname = jv_string(fname);
+  l->data = jv_mem_alloc(length);
+  memcpy((char*)l->data,data,length);
+  l->length = length;
+  l->nlines = 1;
+  l->refct = 1;
+  for (int i=0; i<length; i++) {
+    if (data[i] == '\n') l->nlines++;
+  }
+  l->linemap = jv_mem_calloc(sizeof(int), (l->nlines + 1));
+  l->linemap[0] = 0;
+  int line = 1;
+  for (int i=0; i<length; i++) {
+    if (data[i] == '\n') {
+      l->linemap[line] = i+1;
+      line++;
+    }
+  }
+  l->linemap[l->nlines] = length+1;
+  s->loc_active = l;
+  s->loc_line_hint = l->nlines;
+  jv_free(s->last_path);
+  s->last_path = jv_string(fname);
+  return l;
+}
+
+int jq_session_loc_get_line(jq_session *s, int pos) {
+  struct locfile* l = s->loc_active;
+  assert(l);
+  assert(pos < l->length);
+  int line = 1;
+  while (l->linemap[line] <= pos) line++;
+  assert(line-1 < l->nlines);
+  s->loc_line_hint = line-1;
+  jv_free(s->last_path);
+  s->last_path = jv_copy(l->fname);
+  return line-1;
+}
+
+static int session_loc_line_length(struct locfile* l, int line) {
+  assert(line < l->nlines);
+  return l->linemap[line+1] - l->linemap[line] -1;
+}
+
+void jq_session_loc_locate(jq_session *s, int start, int end, const char* fmt, ...) {
+  struct locfile* l = s->loc_active;
+  va_list fmtargs;
+  va_start(fmtargs, fmt);
+  int startline;
+  int offset = 0;
+  location loc;
+  loc.start = start;
+  loc.end = end;
+  jv_free(s->last_path);
+  if (l)
+    s->last_path = jv_copy(l->fname);
+  else
+    s->last_path = jv_string("<unknown>");
+
+  if (loc.start != -1 && l) {
+    startline = jq_session_loc_get_line(s, loc.start);
+    offset = l->linemap[startline];
+  }
+
+  jv m1 = jv_string_vfmt(fmt, fmtargs);
+  va_end(fmtargs);
+  if (!jv_is_valid(m1)) {
+    if (l) jq_report_error(l->jq, m1);
+    return;
+  }
+  if (loc.start == -1 || !l) {
+    if (l)
+      jq_report_error(l->jq, jv_string_fmt("jq: error: %s\n<unknown location>", jv_string_value(m1)));
+    jv_free(m1);
+    return;
+  }
+  jv m2 = jv_string_fmt("%s at %s, line %d:\n%.*s%*s", jv_string_value(m1),
+                        jv_string_value(l->fname), startline + 1,
+                        session_loc_line_length(l, startline), l->data + offset,
+                        loc.start - offset, "");
+  jv_free(m1);
+  jq_report_error(l->jq, m2);
+  return;
+}
