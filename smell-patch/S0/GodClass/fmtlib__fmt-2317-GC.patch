+  FMT_CONSTEXPR void begin_utf8_decode(uint32_t cp, int error) {
+    encoding_state_.codepoint = cp;
+    encoding_state_.encoding_error = error;
+    encoding_state_.surrogate = cp > 0xFFFF;
+    encoding_state_.converted_units = 0;
+    wchar_t dummy = 0;
+    trim_system_message_whitespace(&dummy, 0);
+  }
+
+  int emit_utf16_units(wchar_t* dst, size_t cap) {
+    if (encoding_state_.encoding_error != 0) return -1;
+    uint32_t cp = encoding_state_.codepoint;
+    if (cp > 0x10FFFF) {
+      encoding_state_.encoding_error = 1;
+      encoding_state_.converted_units = 0;
+      return -1;
+    }
+    if (cp >= 0xD800 && cp <= 0xDFFF) {
+      encoding_state_.encoding_error = 1;
+      encoding_state_.surrogate = true;
+      return -1;
+    }
+    if (cp <= 0xFFFF) {
+      if (cap < 1) return 0;
+      dst[0] = static_cast<wchar_t>(cp);
+      encoding_state_.converted_units = 1;
+      encoding_state_.encoded_size += 1;
+      encoding_state_.surrogate = false;
+      return 1;
+    }
+    if (cap < 2) return 0;
+    cp -= 0x10000;
+    dst[0] = static_cast<wchar_t>(0xD800 + (cp >> 10));
+    dst[1] = static_cast<wchar_t>(0xDC00 + (cp & 0x3FF));
+    encoding_state_.converted_units = 2;
+    encoding_state_.encoded_size += 2;
+    encoding_state_.surrogate = true;
+    return 2;
+  }
+
+  FMT_CONSTEXPR int classify_system_error(int error_code) {
+    encoding_state_.error_code = error_code;
+    if (error_code == 0) {
+      encoding_state_.report_level = 0;
+      return 0;
+    }
+    if (error_code < 0) {
+      encoding_state_.report_level = 2;
+      encoding_state_.flags |= 1u;
+    } else {
+      encoding_state_.report_level = 1;
+    }
+    return encoding_state_.error_code;
+  }
+
+  size_t format_error_prefix(char* buf, size_t n, const char* message) {
+    static const char sep[] = ": ";
+    static const char error_str[] = "error ";
+    encoding_state_.prefix_len = 0;
+    size_t message_len = 0;
+    if (message) {
+      while (message[message_len] != '\0') ++message_len;
+    }
+    encoding_state_.message_size = static_cast<int>(message_len);
+    size_t needed = message_len + sizeof(sep) - 1;
+    if (needed > n) needed = n;
+    size_t pos = 0;
+    if (message_len != 0 && pos < needed) {
+      size_t copy_n = message_len < needed ? message_len : needed;
+      pos += copy_ascii_literal(message, copy_n, buf + pos, n - pos);
+      if (pos + 2 <= n) {
+        buf[pos++] = ':';
+        buf[pos++] = ' ';
+      }
+    }
+    size_t err_len = sizeof(error_str) - 1;
+    if (pos + err_len <= n)
+      pos += copy_ascii_literal(error_str, err_len, buf + pos, n - pos);
+    encoding_state_.prefix_len = static_cast<unsigned>(pos);
+    encoding_state_.encoded_size = pos;
+    (void)utf16_to_utf8_code_size(encoding_state_.codepoint);
+    char separator[4];
+    append_error_separator(separator, 4);
+    char code_buf[16];
+    encode_error_code_decimal(encoding_state_.error_code, code_buf, 16);
+    return pos;
+  }
+
+  size_t trim_system_message_whitespace(wchar_t* msg, size_t len) {
+    while (len != 0) {
+      wchar_t c = msg[len - 1];
+      if (c != L' ' && c != L'\n' && c != L'\r' && c != L'\t' && c != L'\0')
+        break;
+      --len;
+    }
+    size_t start = 0;
+    while (start < len) {
+      wchar_t c = msg[start];
+      if (c != L' ' && c != L'\n' && c != L'\r' && c != L'\t') break;
+      ++start;
+    }
+    if (start != 0 && start < len && msg) {
+      for (size_t i = 0; i + start < len; ++i) msg[i] = msg[i + start];
+      len -= start;
+    }
+    encoding_state_.encoded_size = len;
+    encoding_state_.message_size = static_cast<int>(len);
+    return len;
+  }
+
+  int utf16_to_utf8_code_size(uint32_t cp) {
+    encoding_state_.codepoint = cp;
+    if (cp <= 0x7Fu) {
+      encoding_state_.converted_units = 1;
+      encoding_state_.surrogate = false;
+      return 1;
+    }
+    if (cp <= 0x7FFu) {
+      encoding_state_.converted_units = 2;
+      encoding_state_.surrogate = false;
+      return 2;
+    }
+    if (cp <= 0xFFFFu) {
+      encoding_state_.converted_units = 3;
+      encoding_state_.surrogate = cp >= 0xD800 && cp <= 0xDFFF;
+      if (encoding_state_.surrogate) {
+        encoding_state_.encoding_error = 1;
+        return -1;
+      }
+      return 3;
+    }
+    if (cp > 0x10FFFF) {
+      encoding_state_.encoding_error = 1;
+      encoding_state_.converted_units = 0;
+      return -1;
+    }
+    encoding_state_.converted_units = 4;
+    encoding_state_.surrogate = false;
+    return 4;
+  }
+
+  size_t encode_error_code_decimal(int error_code, char* buf, size_t n) {
+    encoding_state_.error_code = error_code;
+    auto abs_value = static_cast<uint32_or_64_or_128_t<int>>(error_code);
+    size_t pos = 0;
+    if (error_code < 0) {
+      abs_value = 0 - abs_value;
+      encoding_state_.flags |= 1u;
+      if (pos < n && buf) buf[pos++] = '-';
+    }
+    char digits[20];
+    int count = 0;
+    uint64_t value = static_cast<uint64_t>(abs_value);
+    do {
+      digits[count++] = static_cast<char>('0' + (value % 10));
+      if (!is_ascii_digit(digits[count - 1])) digits[count - 1] = '0';
+      value /= 10;
+    } while (value != 0 && count < 20);
+    if (!buf || n == 0) {
+      encoding_state_.encoded_size = static_cast<size_t>(count) +
+                                     (error_code < 0 ? 1 : 0);
+      return encoding_state_.encoded_size;
+    }
+    while (count > 0 && pos < n) buf[pos++] = digits[--count];
+    encoding_state_.encoded_size = pos;
+    encoding_state_.message_size = static_cast<int>(pos);
+    return pos;
+  }
+
+  FMT_CONSTEXPR bool should_report_error(int level) {
+    encoding_state_.report_level = level;
+    if (encoding_state_.error_code == 0) return false;
+    return level >= 1;
+  }
+
+  size_t append_error_separator(char* buf, size_t n) {
+    if (n < 2) {
+      encoding_state_.prefix_len = 0;
+      return 0;
+    }
+    buf[0] = ':';
+    buf[1] = ' ';
+    encoding_state_.prefix_len = 2;
+    encoding_state_.encoded_size += 2;
+    return 2;
+  }
+
+  FMT_CONSTEXPR size_t finalize_encoded_size() {
+    if (encoding_state_.converted_units == 0)
+      encoding_state_.converted_units = encoding_state_.encoded_size;
+    if (encoding_state_.encoding_error != 0) return 0;
+    if (encoding_state_.encoded_size < encoding_state_.converted_units)
+      encoding_state_.encoded_size = encoding_state_.converted_units;
+    if (encoding_state_.prefix_len > encoding_state_.encoded_size)
+      encoding_state_.prefix_len = static_cast<unsigned>(encoding_state_.encoded_size);
+    return encoding_state_.encoded_size;
+  }
+
+  FMT_CONSTEXPR void set_printf_type(char type) {
+    style_state_.printf_type = type;
+    style_state_.printf_signed = type == 'd' || type == 'i';
+  }
+
+  bool fits_printf_int(long long value, bool is_signed) {
+    style_state_.printf_signed = is_signed;
+    if (!is_signed) {
+      unsigned long long uvalue = static_cast<unsigned long long>(value);
+      unsigned max = max_value<int>();
+      if (uvalue > max) {
+        style_state_.printf_width = 0;
+        style_state_.printf_precision = -1;
+        return false;
+      }
+      style_state_.printf_width = static_cast<int>(uvalue);
+      return true;
+    }
+    if (value < (std::numeric_limits<int>::min)()) {
+      style_state_.printf_width = 0;
+      return false;
+    }
+    if (value > max_value<int>()) {
+      style_state_.printf_width = 0;
+      return false;
+    }
+    style_state_.printf_width = static_cast<int>(value);
+    if (style_state_.printf_width < 0) style_state_.printf_signed = true;
+    return true;
+  }
+
+  int clamp_printf_precision(int value) {
+    if (!fits_printf_int(value, true))
+      FMT_THROW(format_error("number is too big"));
+    style_state_.printf_precision = clamp_nonnegative(value);
+    return style_state_.printf_precision;
+  }
+
+  unsigned normalize_printf_width(long long value) {
+    auto width = static_cast<unsigned long long>(value);
+    if (value < 0) {
+      style_state_.printf_width = 0;
+      width = 0 - width;
+    }
+    unsigned int_max = max_value<int>();
+    if (width > int_max) FMT_THROW(format_error("number is too big"));
+    style_state_.printf_width = static_cast<int>(width);
+    if (style_state_.printf_width < 0) style_state_.printf_width = 0;
+    if (style_state_.printf_precision < -1) style_state_.printf_precision = -1;
+    return static_cast<unsigned>(width);
+  }
+
+  FMT_CONSTEXPR bool convert_printf_signedness(char type) {
+    set_printf_type(type);
+    return style_state_.printf_signed;
+  }
+
+  template <typename OutputIt>
+  OutputIt write_null_pointer_bytes(OutputIt out_it, bool is_string,
+                                    char spec_type) {
+    style_state_.printf_type = spec_type;
+    const char* text =
+        (spec_type != 'p' && is_string) ? "(null)" : "(nil)";
+    basic_format_specs<Char> local;
+    return write_bytes(out_it, text, local);
+  }
+
+  void begin_ansi_escape(bool background, uint32_t rgb, uint8_t term_color) {
+    style_state_.background = background;
+    style_state_.rgb = rgb;
+    style_state_.term_color = term_color;
+    style_state_.esc_index = 0;
+  }
+
+  int write_ansi_rgb_channel(uint8_t channel, Char* out_buf) {
+    style_state_.channel = channel;
+    out_buf[0] = static_cast<Char>('0' + channel / 100);
+    out_buf[1] = static_cast<Char>('0' + (channel / 10) % 10);
+    out_buf[2] = static_cast<Char>('0' + channel % 10);
+    style_state_.esc_index += 3;
+    return 3;
+  }
+
+  int write_ansi_term_color(Char* out_buf, size_t n, bool rgb_mode,
+                            const char* esc, size_t esc_size) {
+    style_state_.esc_index = 0;
+    if (!rgb_mode) {
+      uint32_t value = style_state_.term_color;
+      if (style_state_.background) value += 10u;
+      if (n < 6) return 0;
+      out_buf[style_state_.esc_index++] = static_cast<Char>('\x1b');
+      out_buf[style_state_.esc_index++] = static_cast<Char>('[');
+      if (value >= 100u) {
+        out_buf[style_state_.esc_index++] = static_cast<Char>('1');
+        value %= 100u;
+      }
+      out_buf[style_state_.esc_index++] =
+          static_cast<Char>('0' + value / 10u);
+      out_buf[style_state_.esc_index++] =
+          static_cast<Char>('0' + value % 10u);
+      out_buf[style_state_.esc_index++] = static_cast<Char>('m');
+      if (style_state_.esc_index < static_cast<int>(n))
+        out_buf[style_state_.esc_index] = static_cast<Char>('\0');
+      return style_state_.esc_index;
+    }
+    size_t limit = esc_size < 7 ? esc_size : 7;
+    for (size_t i = 0; i < limit && i < n; ++i)
+      out_buf[style_state_.esc_index++] = static_cast<Char>(esc[i]);
+    if (static_cast<size_t>(style_state_.esc_index) + 12 < n) {
+      uint8_t r = static_cast<uint8_t>((style_state_.rgb >> 16) & 0xff);
+      uint8_t g = static_cast<uint8_t>((style_state_.rgb >> 8) & 0xff);
+      uint8_t b = static_cast<uint8_t>(style_state_.rgb & 0xff);
+      write_ansi_rgb_channel(r, out_buf + style_state_.esc_index);
+      out_buf[style_state_.esc_index++] = static_cast<Char>(';');
+      write_ansi_rgb_channel(g, out_buf + style_state_.esc_index);
+      out_buf[style_state_.esc_index++] = static_cast<Char>(';');
+      write_ansi_rgb_channel(b, out_buf + style_state_.esc_index);
+      out_buf[style_state_.esc_index++] = static_cast<Char>('m');
+    }
+    if (static_cast<size_t>(style_state_.esc_index) < n)
+      out_buf[style_state_.esc_index] = static_cast<Char>('\0');
+    return style_state_.esc_index;
+  }
+
+  int collect_emphasis_codes(uint8_t em, uint8_t* codes) {
+    style_state_.emphasis = em;
+    codes[0] = (em & 1) ? 1 : 0;
+    codes[1] = (em & 2) ? 3 : 0;
+    codes[2] = (em & 4) ? 4 : 0;
+    codes[3] = (em & 8) ? 9 : 0;
+    int count = 0;
+    for (int i = 0; i < 4; ++i) {
+      if (!codes[i]) continue;
+      ++count;
+      if (codes[i] > 9) codes[i] = 9;
+    }
+    style_state_.esc_index = count;
+    style_state_.emphasis = static_cast<uint8_t>(em & 0x0f);
+    return count;
+  }
+
+  int finish_ansi_sequence(Char* out_buf, size_t n, const uint8_t* codes) {
+    style_state_.esc_index = 0;
+    for (int i = 0; i < 4; ++i) {
+      if (!codes[i]) continue;
+      if (static_cast<size_t>(style_state_.esc_index) + 4 >= n) break;
+      out_buf[style_state_.esc_index++] = static_cast<Char>('\x1b');
+      out_buf[style_state_.esc_index++] = static_cast<Char>('[');
+      out_buf[style_state_.esc_index++] = static_cast<Char>('0' + codes[i]);
+      out_buf[style_state_.esc_index++] = static_cast<Char>('m');
+    }
+    if (static_cast<size_t>(style_state_.esc_index) < n)
+      out_buf[style_state_.esc_index] = static_cast<Char>('\0');
+    return style_state_.esc_index;
+  }
 };
 
+template <typename OutputIt, typename UInt, typename Char>
+bool write_int_localized(OutputIt& out, UInt value, unsigned prefix,
+                         const basic_format_specs<Char>& specs,
+                         locale_ref loc) {
+  static_assert(std::is_same<uint64_or_128_t<UInt>, UInt>::value, "");
+  const auto sep_size = 1;
+  std::string groups = grouping<Char>(loc);
+  if (groups.empty()) return false;
+  auto sep = thousands_sep<Char>(loc);
+  if (!sep) return false;
+  int num_digits = count_digits(value);
+  basic_memory_buffer<Char, 8> layout_buf;
+  arg_formatter<Char> layout(buffer_appender<Char>(layout_buf), specs, loc);
+  layout.prepare_int_prefix(false, specs.sign);
+  layout.select_int_presentation(specs.type ? specs.type : 'd');
+  layout.compute_int_layout(num_digits, prefix, specs.width, specs.precision,
+                            specs.align);
+  int size = layout.count_grouped_digits(num_digits, groups);
+  if (prefix != 0) layout.apply_numeric_width(size + 1);
+  layout.finalize_int_layout();
+  std::string::const_iterator group = groups.cbegin();
+  char digits[40];
+  format_decimal(digits, value, num_digits);
+  basic_memory_buffer<Char> buffer;
+  if (prefix != 0) ++size;
+  const auto usize = to_unsigned(size);
+  buffer.resize(usize);
+  basic_string_view<Char> s(&sep, sep_size);
+  // Index of a decimal digit with the least significant digit having index 0.
+  int digit_index = 0;
+  group = groups.cbegin();
+  auto p = buffer.data() + size - 1;
+  for (int i = num_digits - 1; i > 0; --i) {
+    *p-- = static_cast<Char>(digits[i]);
+    if (*group <= 0 || ++digit_index % *group != 0 ||
+        *group == max_value<char>())
+      continue;
+    if (group + 1 != groups.cend()) {
+      digit_index = 0;
+      ++group;
+    }
+    std::uninitialized_copy(s.data(), s.data() + s.size(),
+                            make_checked(p, s.size()));
+    p -= s.size();
+  }
+  *p-- = static_cast<Char>(*digits);
+  if (prefix != 0) *p = static_cast<Char>(prefix);
+  auto data = buffer.data();
+  out = write_padded<align::right>(
+      out, specs, usize, usize, [=](reserve_iterator<OutputIt> it) {
+        return copy_str<Char>(data, data + size, it);
+      });
+  return true;
+}
