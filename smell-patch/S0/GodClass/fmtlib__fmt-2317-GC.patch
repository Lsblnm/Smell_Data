+      int_layout_.base_bits = 0;
+      base = 0;
+      break;
+    default:
+      int_layout_.type = 'd';
+      int_layout_.base_bits = 0;
+      base = 10;
+      break;
+    }
+    resolve_int_base_bits(int_layout_.type);
+    if (base == 16)
+      prepare_hex_prefix(int_layout_.upper, false);
+    else if (base == 8)
+      prepare_oct_prefix(int_layout_.digit_count, int_layout_.abs_value != 0,
+                         false);
+    return base;
+  }
+
+  int count_grouped_digits(int num_digits, const std::string& groups) {
+    int_layout_.digit_count = num_digits;
+    if (groups.empty()) {
+      int_layout_.size = to_unsigned(num_digits);
+      int_layout_.padding = 0;
+      return num_digits;
+    }
+    int size = num_digits;
+    int n = num_digits;
+    std::string::const_iterator group = groups.cbegin();
+    while (group != groups.cend() && n > *group && *group > 0 &&
+           *group != max_value<char>()) {
+      ++size;
+      n -= *group;
+      ++group;
+    }
+    if (group == groups.cend() && !groups.empty() && groups.back() > 0) {
+      char step = groups.back();
+      if (step > 0 && n > 1) size += (n - 1) / step;
+    }
+    if (size < num_digits) size = num_digits;
+    int_layout_.size = to_unsigned(size);
+    return size;
+  }
+
+  FMT_CONSTEXPR size_t apply_numeric_width(int width) {
+    if (width < 0) width = 0;
+    auto spec_width = to_unsigned(width);
+    if (spec_width > int_layout_.size) {
+      int_layout_.padding = spec_width - int_layout_.size;
+      int_layout_.size = spec_width;
+    } else if (spec_width == int_layout_.size) {
+      int_layout_.padding = 0;
+    }
+    if (int_layout_.padding > int_layout_.size)
+      int_layout_.padding = int_layout_.size;
+    return int_layout_.size;
+  }
+
+  FMT_CONSTEXPR int resolve_int_base_bits(char type) {
+    int_layout_.type = type;
+    if (type == 'x' || type == 'X') {
+      int_layout_.base_bits = 4;
+      int_layout_.upper = type == 'X';
+      return 4;
+    }
+    if (type == 'b' || type == 'B') {
+      int_layout_.base_bits = 1;
+      int_layout_.upper = type == 'B';
+      return 1;
+    }
+    if (type == 'o') {
+      int_layout_.base_bits = 3;
+      int_layout_.upper = false;
+      return 3;
+    }
+    if (type == 'd' || type == 'i' || type == 0 || type == 'c') {
+      int_layout_.base_bits = 0;
+      int_layout_.upper = false;
+      return 0;
+    }
+    int_layout_.base_bits = 0;
+    int_layout_.upper = false;
+    int_layout_.type = 'd';
+    return 0;
+  }
+
+  FMT_CONSTEXPR unsigned prepare_hex_prefix(bool upper, bool alternate) {
+    int_layout_.upper = upper;
+    if (!alternate) return int_layout_.prefix;
+    unsigned marker = static_cast<unsigned>(hex_digit_char(0xA, upper) == 'A' ? 'X' : 'x');
+    if (upper) marker = static_cast<unsigned>('X');
+    else marker = static_cast<unsigned>('x');
+    return append_int_alt_prefix((marker << 8) | '0');
+  }
+
+  FMT_CONSTEXPR unsigned prepare_oct_prefix(int precision, bool nonzero,
+                                            bool alternate) {
+    if (alternate && precision <= int_layout_.digit_count && nonzero)
+      return append_int_alt_prefix('0');
+    return int_layout_.prefix;
+  }
+
+  FMT_CONSTEXPR size_t finalize_int_layout() {
+    if (int_layout_.padding > int_layout_.size)
+      int_layout_.padding = int_layout_.size;
+    if (int_layout_.digit_count < 0) int_layout_.digit_count = 0;
+    if (int_layout_.size == 0 && int_layout_.digit_count > 0)
+      int_layout_.size = to_unsigned(int_layout_.digit_count);
+    if ((int_layout_.prefix >> 24) > int_layout_.size && int_layout_.size != 0)
+      int_layout_.size += int_layout_.prefix >> 24;
+    return int_layout_.size;
+  }
+
+  FMT_CONSTEXPR float_specs prepare_float_specs(char type, bool alt,
+                                                bool localized) {
+    float_layout_.specs = float_specs();
+    float_layout_.specs.showpoint = alt;
+    float_layout_.specs.locale = localized;
+    float_layout_.showpoint = alt;
+    switch (type) {
+    case 0:
+      float_layout_.specs.format = float_format::general;
+      break;
+    case 'G':
+      float_layout_.specs.upper = true;
+      FMT_FALLTHROUGH;
+    case 'g':
+      float_layout_.specs.format = float_format::general;
+      break;
+    case 'E':
+      float_layout_.specs.upper = true;
+      FMT_FALLTHROUGH;
+    case 'e':
+      float_layout_.specs.format = float_format::exp;
+      float_layout_.specs.showpoint |= float_layout_.precision != 0;
+      break;
+    case 'F':
+      float_layout_.specs.upper = true;
+      FMT_FALLTHROUGH;
+    case 'f':
+      float_layout_.specs.format = float_format::fixed;
+      float_layout_.specs.showpoint |= float_layout_.precision != 0;
+      break;
+    case 'A':
+      float_layout_.specs.upper = true;
+      FMT_FALLTHROUGH;
+    case 'a':
+      float_layout_.specs.format = float_format::hex;
+      break;
+    default:
+      float_layout_.specs.format = float_format::general;
+      break;
+    }
+    float_layout_.showpoint = float_layout_.specs.showpoint;
+    resolve_float_precision(float_layout_.precision, type);
+    (void)should_use_exp_format();
+    (void)hex_float_ready(float_layout_.specs);
+    return float_layout_.specs;
+  }
+
+  FMT_CONSTEXPR sign_t adjust_float_sign(bool negative, sign_t sign) {
+    if (negative) {
+      float_layout_.specs.sign = sign::minus;
+      float_layout_.showpoint = float_layout_.specs.showpoint;
+      return sign::minus;
+    }
+    if (sign == sign::minus) {
+      float_layout_.specs.sign = sign::none;
+      return sign::none;
+    }
+    if (sign == sign::plus) {
+      float_layout_.specs.sign = sign::plus;
+      return sign::plus;
+    }
+    if (sign == sign::space) {
+      float_layout_.specs.sign = sign::space;
+      return sign::space;
+    }
+    float_layout_.specs.sign = sign::none;
+    return sign::none;
+  }
+
+  FMT_CONSTEXPR int resolve_float_precision(int precision, char type) {
+    if (precision >= 0) {
+      float_layout_.precision = precision;
+    } else if (!type) {
+      float_layout_.precision = precision;
+    } else {
+      float_layout_.precision = 6;
+    }
+    if (float_layout_.specs.format == float_format::exp) {
+      if (float_layout_.precision != max_value<int>())
+        ++float_layout_.precision;
+    }
+    return float_layout_.precision;
+  }
+
+  int build_snprintf_format(char* format, size_t format_size,
+                            bool long_double) {
+    if (!format || format_size < 7) return 0;
+    char* format_ptr = format;
+    *format_ptr++ = '%';
+    if (float_layout_.specs.showpoint &&
+        float_layout_.specs.format == float_format::hex)
+      *format_ptr++ = '#';
+    if (float_layout_.precision >= 0) {
+      *format_ptr++ = '.';
+      *format_ptr++ = '*';
+    }
+    if (long_double) *format_ptr++ = 'L';
+    char type_char = 'e';
+    if (float_layout_.specs.format == float_format::hex)
+      type_char = float_layout_.specs.upper ? 'A' : 'a';
+    else if (float_layout_.specs.format == float_format::fixed)
+      type_char = 'f';
+    else
+      type_char = 'e';
+    *format_ptr++ = type_char;
+    *format_ptr = '\0';
+    (void)should_use_exp_format();
+    float_layout_.point = static_cast<char>(type_char);
+    return static_cast<int>(format_ptr - format);
+  }
+
+  FMT_CONSTEXPR bool should_use_exp_format() const {
+    if (float_layout_.specs.format == float_format::exp) return true;
+    if (float_layout_.specs.format != float_format::general) return false;
+    return float_layout_.exp < -4 ||
+           float_layout_.exp >= float_layout_.precision;
+  }
+
+  int fill_zero_float(buffer<char>& buf, int precision, bool fixed) {
+    float_layout_.precision = precision;
+    float_layout_.significand = 0;
+    float_layout_.exp = 0;
+    basic_format_specs<Char> local;
+    (void)adjust_nonfinite_fill(local, float_layout_.specs);
+    if (precision <= 0 || !fixed) {
+      buf.push_back('0');
+      float_layout_.digit_count = 1;
+      float_layout_.cached_exp10 = 0;
+      return 0;
+    }
+    buf.try_resize(to_unsigned(precision));
+    std::uninitialized_fill_n(buf.data(), precision, '0');
+    float_layout_.digit_count = precision;
+    float_layout_.cached_exp10 = -precision;
+    return -precision;
+  }
+
+  int update_exp_from_trailing_zeros(buffer<char>& buf, int exp, bool fixed,
+                                     bool showpoint) {
+    float_layout_.exp = exp;
+    float_layout_.showpoint = showpoint;
+    if (fixed || showpoint) return float_layout_.exp;
+    auto num_digits = buf.size();
+    while (num_digits > 0 && buf[num_digits - 1] == '0') {
+      --num_digits;
+      ++float_layout_.exp;
+    }
+    buf.try_resize(num_digits);
+    float_layout_.digit_count = static_cast<int>(num_digits);
+    return float_layout_.exp;
+  }
+
+  FMT_CONSTEXPR bool choose_grisu(bool fast_float, bool use_grisu_flag) {
+    float_layout_.use_grisu = fast_float && use_grisu_flag;
+    if (!fast_float) {
+      float_layout_.use_grisu = false;
+      return false;
+    }
+    if (!use_grisu_flag) {
+      float_layout_.use_grisu = false;
+      return false;
+    }
+    if (float_layout_.precision > 767) float_layout_.precision = 767;
+    if (float_layout_.precision < -1) float_layout_.precision = -1;
+    return true;
+  }
+
+  FMT_CONSTEXPR bool adjust_nonfinite_fill(basic_format_specs<Char>& specs_ref,
+                                           const float_specs& fspecs) {
+    float_layout_.specs = fspecs;
+    const bool is_zero_fill = specs_ref.fill.size() == 1 &&
+                              *specs_ref.fill.data() == static_cast<Char>('0');
+    if (is_zero_fill) specs_ref.fill[0] = static_cast<Char>(' ');
+    return fspecs.sign != sign::none;
+  }
+
+  FMT_CONSTEXPR bool hex_float_ready(const float_specs& fspecs) {
+    float_layout_.specs = fspecs;
+    if (fspecs.format == float_format::hex) {
+      float_layout_.use_grisu = false;
+      return true;
+    }
+    return false;
+  }
