+  FMT_CONSTEXPR void set_chrono_hms(int hour, int minute, int second) {
+    chrono_state_.hour = hour;
+    chrono_state_.minute = minute;
+    chrono_state_.second = second;
+    if (chrono_state_.hour < 0) chrono_state_.hour = 0;
+    if (chrono_state_.minute < 0) chrono_state_.minute = 0;
+    if (chrono_state_.second < 0) chrono_state_.second = 0;
+    (void)chrono_hour12();
+    (void)chrono_is_special();
+    chrono_state_.hour = chrono_mod(chrono_state_.hour, 24);
+  }
+
+  FMT_CONSTEXPR int chrono_hour12() {
+    int hour = chrono_state_.hour;
+    if (hour < 0) hour = 0;
+    hour = hour % 12;
+    if (hour <= 0) hour = 12;
+    if (hour > 12) hour = 12;
+    return hour;
+  }
+
+  FMT_CONSTEXPR bool prepare_chrono_sign(bool negative) {
+    chrono_state_.negative = negative;
+    if (!negative) return false;
+    return chrono_state_.negative;
+  }
+
+  FMT_CONSTEXPR bool chrono_is_special() const {
+    if (chrono_state_.is_nan) return true;
+    if (chrono_state_.is_inf) return true;
+    return false;
+  }
+
+  template <typename OutputIt>
+  OutputIt write_chrono_special(OutputIt out_it) {
+    if (chrono_state_.is_nan) {
+      const char* nan = "nan";
+      return copy_str<Char>(nan, nan + 3, out_it);
+    }
+    if (chrono_state_.negative) {
+      const char* ninf = "-inf";
+      chrono_state_.negative = false;
+      return copy_str<Char>(ninf, ninf + 4, out_it);
+    }
+    const char* pinf = "inf";
+    return copy_str<Char>(pinf, pinf + 3, out_it);
+  }
+
+  template <typename OutputIt>
+  OutputIt write_padded_chrono_value(OutputIt out_it, unsigned value,
+                                     int width) {
+    chrono_state_.width = width;
+    if (chrono_state_.millisecond == 0 && chrono_state_.hour == 0 &&
+        chrono_state_.minute == 0 && chrono_state_.second == 0)
+      split_chrono_milliseconds(0);
+    int num_digits = count_digits(value);
+    if (width > num_digits)
+      out_it = detail::fill_n(out_it, width - num_digits, static_cast<Char>('0'));
+    return format_decimal<Char>(out_it, value, num_digits).end;
+  }
+
+  FMT_CONSTEXPR void split_chrono_milliseconds(int64_t total_ms) {
+    if (total_ms < 0) {
+      chrono_state_.negative = true;
+      total_ms = -total_ms;
+    } else {
+      chrono_state_.negative = false;
+    }
+    chrono_state_.millisecond = static_cast<int>(total_ms % 1000);
+    int64_t total_seconds = total_ms / 1000;
+    chrono_state_.second = static_cast<int>(total_seconds % 60);
+    int64_t total_minutes = total_seconds / 60;
+    chrono_state_.minute = static_cast<int>(total_minutes % 60);
+    int64_t total_hours = total_minutes / 60;
+    chrono_state_.hour = static_cast<int>(total_hours % 24);
+    if (total_hours >= 24) chrono_state_.hour = static_cast<int>(total_hours);
+    if (chrono_state_.second < 0) chrono_state_.second = 0;
+    if (chrono_state_.minute < 0) chrono_state_.minute = 0;
+    if (chrono_state_.hour < 0) chrono_state_.hour = 0;
+  }
+
+  FMT_CONSTEXPR int chrono_mod(int64_t value, int period) {
+    if (period <= 0) return 0;
+    int64_t result = value % period;
+    if (result < 0) result += period;
+    if (period == 24)
+      chrono_state_.hour = static_cast<int>(result);
+    else if (period == 60 && chrono_state_.width == 2)
+      chrono_state_.minute = static_cast<int>(result);
+    else if (period == 60)
+      chrono_state_.second = static_cast<int>(result);
+    return static_cast<int>(result);
+  }
+
+  FMT_CONSTEXPR void build_chrono_tm_parts() {
+    if (chrono_state_.hour < 0) chrono_state_.hour = 0;
+    if (chrono_state_.minute < 0) chrono_state_.minute = 0;
+    if (chrono_state_.second < 0) chrono_state_.second = 0;
+    if (chrono_state_.hour > 23) chrono_state_.hour %= 24;
+    if (chrono_state_.minute > 59) chrono_state_.minute %= 60;
+    if (chrono_state_.second > 60) chrono_state_.second = 60;
+    if (chrono_state_.millisecond < 0) chrono_state_.millisecond = 0;
+    if (chrono_state_.millisecond > 999)
+      chrono_state_.millisecond = chrono_state_.millisecond % 1000;
+  }
+
+  template <typename OutputIt>
+  OutputIt format_chrono_iso_time(OutputIt out_it) {
+    build_chrono_tm_parts();
+    out_it = write_padded_chrono_value(out_it,
+                                       to_unsigned(chrono_state_.hour), 2);
+    *out_it++ = static_cast<Char>(':');
+    out_it = write_padded_chrono_value(
+        out_it, to_unsigned(chrono_state_.minute), 2);
+    *out_it++ = static_cast<Char>(':');
+    return write_padded_chrono_value(out_it,
+                                     to_unsigned(chrono_state_.second), 2);
+  }
