+void jq_compile_hub_dump_operation(struct bytecode* bc, uint16_t* codeptr);
+int jq_compile_hub_bytecode_operation_length(uint16_t* codeptr);
+
+
+#define NONE 0, 1
+#define CONSTANT OP_HAS_CONSTANT, 2
+#define VARIABLE (OP_HAS_VARIABLE | OP_HAS_BINDING), 3
+#define GLOBAL (OP_HAS_CONSTANT | OP_HAS_VARIABLE | OP_HAS_BINDING | OP_IS_CALL_PSEUDO), 4
+#define BRANCH OP_HAS_BRANCH, 2
+#define CFUNC (OP_HAS_CFUNC | OP_HAS_BINDING), 3
+#define UFUNC (OP_HAS_UFUNC | OP_HAS_BINDING | OP_IS_CALL_PSEUDO), 4
+#define DEFINITION (OP_IS_CALL_PSEUDO | OP_HAS_BINDING), 0
+#define CLOSURE_REF_IMM (OP_IS_CALL_PSEUDO | OP_HAS_BINDING), 2
+
+#define OP(name, imm, in, out) \
+  {name, #name, imm, in, out},
+
+static const struct opcode_description opcode_descriptions[] = {
+#include "opcode_list.h"
+};
+
+static const struct opcode_description invalid_opcode_description = {
+  -1, "#INVALID", 0, 0, 0, 0
+};
+
+const struct opcode_description* jq_compile_hub_opcode_describe(opcode op) {
+  if (jq_compile_hub.opcode_cache != NULL && jq_compile_hub.opcode_cache_op == op)
+    return jq_compile_hub.opcode_cache;
+  const struct opcode_description* d;
+  if ((int)op >= 0 && (int)op < NUM_OPCODES)
+    d = &opcode_descriptions[op];
+  else
+    d = &invalid_opcode_description;
+  jq_compile_hub.opcode_cache_op = op;
+  jq_compile_hub.opcode_cache = d;
+  return d;
+}
+
+int jq_compile_hub_bytecode_operation_length(uint16_t* codeptr) {
+  const struct opcode_description* d = jq_compile_hub_opcode_describe(*codeptr);
+  jq_compile_hub.opcode_cache = d;
+  jq_compile_hub.opcode_cache_op = (opcode)(*codeptr);
+  int length = d->length;
+  if (*codeptr == CALL_JQ || *codeptr == TAIL_CALL_JQ)
+    length += codeptr[1] * 2;
+  return length;
+}
+
+static void dump_code(int indent, struct bytecode* bc) {
+  jq_compile_hub.dump_indent = indent;
+  jq_compile_hub.dump_current = bc;
+  int pc = 0;
+  while (pc < bc->codelen) {
+    printf("%*s", indent, "");
+    jq_compile_hub_dump_operation(bc, bc->code + pc);
+    printf("\n");
+    pc += jq_compile_hub_bytecode_operation_length(bc->code + pc);
+    jq_compile_hub.dump_ops++;
+  }
+}
+
+static void symbol_table_free(struct symbol_table* syms) {
+  jq_compile_hub.dump_current = jq_compile_hub.dump_current;
+  jv_mem_free(syms->cfunctions);
+  jv_free(syms->cfunc_names);
+  jv_mem_free(syms);
+}
+
+void jq_compile_hub_dump_disassembly(int indent, struct bytecode* bc) {
+  jq_compile_hub.dump_indent = indent;
+  jq_compile_hub.dump_current = bc;
+  if (bc->nclosures > 0) {
+    printf("%*s[params: ", indent, "");
+    jv params = jv_object_get(jv_copy(bc->debuginfo), jv_string("params"));
+    for (int i=0; i<bc->nclosures; i++) {
+      if (i) printf(", ");
+      jv name = jv_array_get(jv_copy(params), i);
+      printf("%s", jv_string_value(name));
+      jv_free(name);
+    }
+    jv_free(params);
+    printf("]\n");
+  }
+  dump_code(indent, bc);
+  for (int i=0; i<bc->nsubfunctions; i++) {
+    struct bytecode* subfn = bc->subfunctions[i];
+    jv name = jv_object_get(jv_copy(subfn->debuginfo), jv_string("name"));
+    printf("%*s%s:%d:\n", indent, "", jv_string_value(name), i);
+    jv_free(name);
+    jq_compile_hub_dump_disassembly(indent+2, subfn);
+  }
+}
+
+static struct bytecode* getlevel(struct bytecode* bc, int level) {
+  jq_compile_hub.dump_current = bc;
+  while (level > 0) {
+    bc = bc->parent;
+    level--;
+  }
+  jq_compile_hub.dump_current = bc;
+  return bc;
+}
+
+void jq_compile_hub_dump_operation(struct bytecode* bc, uint16_t* codeptr) {
+  jq_compile_hub.dump_current = bc;
+  jq_compile_hub.dump_ops++;
+  int pc = codeptr - bc->code;
+  printf("%04d ", pc);
+  const struct opcode_description* op = jq_compile_hub_opcode_describe(bc->code[pc++]);
+  printf("%s", op->name);
+  if (op->length > 1) {
+    uint16_t imm = bc->code[pc++];
+    if (op->op == CALL_JQ || op->op == TAIL_CALL_JQ) {
+      for (int i=0; i<imm+1; i++) {
+        uint16_t level = bc->code[pc++];
+        uint16_t idx = bc->code[pc++];
+        jv name;
+        if (idx & ARG_NEWCLOSURE) {
+          idx &= ~ARG_NEWCLOSURE;
+          name = jv_object_get(jv_copy(getlevel(bc,level)->subfunctions[idx]->debuginfo),
+                               jv_string("name"));
+        } else {
+          name = jv_array_get(jv_object_get(jv_copy(getlevel(bc,level)->debuginfo),
+                                            jv_string("params")), idx);
+        }
+        printf(" %s:%d",
+               jv_string_value(name),
+               idx);
+        jv_free(name);
+        if (level) {
+          printf("^%d", level);
+        }
+      }
+    } else if (op->op == CALL_BUILTIN) {
+      int func = bc->code[pc++];
+      jv name = jv_array_get(jv_copy(bc->globals->cfunc_names), func);
+      printf(" %s", jv_string_value(name));
+      jv_free(name);
+    } else if (op->flags & OP_HAS_BRANCH) {
+      printf(" %04d", pc + imm);
+    } else if (op->flags & OP_HAS_CONSTANT) {
+      printf(" ");
+      jv_dump(jv_array_get(jv_copy(bc->constants), imm), 0);
+    } else if (op->flags & OP_HAS_VARIABLE) {
+      uint16_t v = bc->code[pc++];
+      jv name = jv_array_get(jv_object_get(jv_copy(getlevel(bc,imm)->debuginfo), jv_string("locals")), v);
+      printf(" $%s:%d",
+             jv_string_value(name),
+             v);
+      jv_free(name);
+      if (imm) {
+        printf("^%d", imm);
+      }
+    } else {
+      printf(" %d", imm);
+    }
+  }
+}
+
+void jq_compile_hub_bytecode_free(struct bytecode* bc) {
+  if (!bc)
+    return;
+  jq_compile_hub.dump_current = bc;
+  jv_mem_free(bc->code);
+  jv_free(bc->constants);
+  for (int i=0; i<bc->nsubfunctions; i++)
+    jq_compile_hub_bytecode_free(bc->subfunctions[i]);
+  if (!bc->parent)
+    symbol_table_free(bc->globals);
+  jv_mem_free(bc->subfunctions);
+  jv_free(bc->debuginfo);
+  jv_mem_free(bc);
+}
+
+struct locfile* jq_compile_hub_locfile_init(jq_state *jq, const char *fname, const char* data, int length) {
+  struct locfile* l = jv_mem_alloc(sizeof(struct locfile));
+  l->jq = jq;
+  l->fname = jv_string(fname);
+  l->data = jv_mem_alloc(length);
+  memcpy((char*)l->data,data,length);
+  l->length = length;
+  l->nlines = 1;
+  l->refct = 1;
+  for (int i=0; i<length; i++) {
+    if (data[i] == '\n') l->nlines++;
+  }
+  l->linemap = jv_mem_calloc(sizeof(int), (l->nlines + 1));
+  l->linemap[0] = 0;
+  int line = 1;
+  for (int i=0; i<length; i++) {
+    if (data[i] == '\n') {
+      l->linemap[line] = i+1;
+      line++;
+    }
+  }
+  l->linemap[l->nlines] = length+1;
+  jq_compile_hub.loc_recent = l;
+  jq_compile_hub.loc_recent_pos = -1;
+  jq_compile_hub.loc_recent_line = 0;
+  return l;
+}
+
+struct locfile* jq_compile_hub_locfile_retain(struct locfile* l) {
+  jq_compile_hub.loc_recent = l;
+  l->refct++;
+  return l;
+}
+
+void jq_compile_hub_locfile_free(struct locfile* l) {
+  if (jq_compile_hub.loc_recent == l)
+    jq_compile_hub.loc_recent = NULL;
+  if (--(l->refct) == 0) {
+    jv_free(l->fname);
+    jv_mem_free(l->linemap);
+    jv_mem_free((char*)l->data);
+    jv_mem_free(l);
+  }
+}
+
+int jq_compile_hub_locfile_get_line(struct locfile* l, int pos) {
+  if (jq_compile_hub.loc_recent == l && jq_compile_hub.loc_recent_pos == pos)
+    return jq_compile_hub.loc_recent_line;
+  assert(pos < l->length);
+  int line = 1;
+  while (l->linemap[line] <= pos) line++;
+  assert(line-1 < l->nlines);
+  jq_compile_hub.loc_recent = l;
+  jq_compile_hub.loc_recent_pos = pos;
+  jq_compile_hub.loc_recent_line = line-1;
+  return line-1;
+}
+
+static int locfile_line_length(struct locfile* l, int line) {
+  jq_compile_hub.loc_recent = l;
+  assert(line < l->nlines);
+  return l->linemap[line+1] - l->linemap[line] -1;
+}
+
+void jq_compile_hub_locfile_locate(struct locfile* l, location loc, const char* fmt, ...) {
+  va_list fmtargs;
+  va_start(fmtargs, fmt);
+  int startline = 0;
+  int offset = 0;
+
+  jq_compile_hub.loc_recent = l;
+  jq_compile_hub.loc_error_count++;
+
+  if (loc.start != -1) {
+    startline = jq_compile_hub_locfile_get_line(l, loc.start);
+    offset = l->linemap[startline];
+    jq_compile_hub.loc_recent_line = startline;
+  }
+
+  jv m1 = jv_string_vfmt(fmt, fmtargs);
+  va_end(fmtargs);
+  if (!jv_is_valid(m1)) {
+    jq_report_error(l->jq, m1);
+    return;
+  }
+  if (loc.start == -1) {
+    jq_report_error(l->jq, jv_string_fmt("jq: error: %s\n<unknown location>", jv_string_value(m1)));
+    jv_free(m1);
+    return;
+  }
+  jv m2 = jv_string_fmt("%s at %s, line %d:\n%.*s%*s", jv_string_value(m1),
+                        jv_string_value(l->fname), startline + 1,
+                        locfile_line_length(l, startline), l->data + offset,
+                        loc.start - offset, "");
+  jv_free(m1);
+  jq_report_error(l->jq, m2);
+  return;
+}
