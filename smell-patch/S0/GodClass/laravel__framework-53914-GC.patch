+    /**
+     * Stage pending transactions for the given owner.
+     *
+     * @param  object  $owner
+     * @param  string  $connection
+     * @param  int  $levelBeingCommitted
+     * @return void
+     */
+    public function stageManagedTransactions($owner, $connection, $levelBeingCommitted)
