+            $this->pendingTransactions = $this->pendingTransactions->reject(
+                fn ($transaction) => $transaction->connection === $connection &&
+                                     $transaction->level >= $levelBeingCommitted
+            );
+        }, $owner, get_class($owner));
+
+        $apply($connection, $levelBeingCommitted);
+
+        $this->rememberManagedTransactionOwner($owner);
+    }
+
+    /**
+     * Roll back a managed transaction for the given owner.
+     *
+     * @param  object  $owner
+     * @param  string  $connection
+     * @param  int  $newTransactionLevel
+     * @return void
+     */
+    public function rollbackManagedTransaction($owner, $connection, $newTransactionLevel)
+    {
+        $apply = Closure::bind(function ($connection, $newTransactionLevel) {
+            if ($newTransactionLevel === 0) {
+                $this->removeAllTransactionsForConnection($connection);
+            } else {
+                $this->pendingTransactions = $this->pendingTransactions->reject(
+                    fn ($transaction) => $transaction->connection == $connection &&
+                                         $transaction->level > $newTransactionLevel
+                )->values();
+
+                if ($this->currentTransaction) {
+                    do {
+                        $this->removeCommittedTransactionsThatAreChildrenOf($this->currentTransaction[$connection]);
+
+                        $this->currentTransaction[$connection] = $this->currentTransaction[$connection]->parent;
+                    } while (
+                        isset($this->currentTransaction[$connection]) &&
+                        $this->currentTransaction[$connection]->level > $newTransactionLevel
+                    );
+                }
+            }
+        }, $owner, get_class($owner));
+
+        $apply($connection, $newTransactionLevel);
+
+        $this->rememberManagedTransactionOwner($owner);
+    }
+
+    /**
+     * Register an after-commit callback for the given owner.
+     *
+     * @param  object  $owner
+     * @param  callable  $callback
+     * @return mixed
+     */
+    public function addManagedTransactionCallback($owner, $callback)
+    {
+        $apply = Closure::bind(function ($callback) {
+            if ($current = $this->callbackApplicableTransactions()->last()) {
+                return $current->addCallback($callback);
+            }
+
+            $callback();
+        }, $owner, get_class($owner));
+
+        $result = $apply($callback);
+
+        $this->rememberManagedTransactionOwner($owner);
+
+        return $result;
+    }
+
+    /**
+     * Remember the latest transaction collections for the given owner.
+     *
+     * @param  object  $owner
+     * @return void
+     */
+    public function rememberManagedTransactionOwner($owner)
+    {
+        $this->transactionOwners[spl_object_id($owner)] = $owner;
+
+        if (method_exists($owner, 'getPendingTransactions')) {
+            $this->managedPendingTransactions = $owner->getPendingTransactions();
+        }
+
+        if (method_exists($owner, 'getCommittedTransactions')) {
+            $this->managedCommittedTransactions = $owner->getCommittedTransactions();
+        }
+
+        $current = Closure::bind(function () {
+            return $this->currentTransaction;
+        }, $owner, get_class($owner));
+
+        $this->managedCurrentTransactions = $current() ?: [];
+    }
+
+
