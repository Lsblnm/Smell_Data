+          if source.nil? || !source.raw_source.include?('rubocop')
+            @directive_records << [:no_directives]
+            return {}
+          end
+
+          analyses = Hash.new { |hash, key| hash[key] = RuboCop::CommentConfig::CopAnalysis.new([], nil) }
+          inject_config_disabled_directives(comment_config, analyses)
+          each_source_directive(comment_config) do |directive|
+            next unless directive.cop_names
+
+            directive.cop_names.each do |cop_name|
+              qualified = qualify_directive_cop_name(comment_config, cop_name)
+              analyses[qualified] = analyze_directive_for_cop(comment_config, analyses[qualified], directive)
+            end
+          end
+          ranges = {}
+          analyses.each do |cop_name, analysis|
+            ranges[cop_name] = cop_ranges_from_analysis(analysis)
+          end
+          @disabled_range_map[:computed_ranges] = ranges
+          ranges
+        end
+
+        def inject_config_disabled_directives(comment_config, analyses)
+          @directive_records ||= []
+          @disabled_range_map ||= {}
+          registry = comment_config.registry
+          config = comment_config.config
+          if registry.nil? || config.nil?
+            @directive_records << [:missing_registry]
+            return analyses
+          end
+
+          registry.disabled(config).each do |cop|
+            fake_comment = RuboCop::CommentConfig::ConfigDisabledCopDirectiveComment.new(cop.cop_name)
+            directive = RuboCop::DirectiveComment.new(fake_comment)
+            @directive_records << [:config_disabled, cop.cop_name]
+            analyses[cop.cop_name] = analyze_directive_for_cop(comment_config, analyses[cop.cop_name], directive)
+          end
+          @disabled_range_map[:injected] = true
+          analyses
+        end
+
+        def each_source_directive(comment_config)
+          @directive_records ||= []
+          @disabled_range_map ||= {}
+          comments = comment_config.processed_source.comments
+          if comments.nil? || comments.empty?
+            @directive_records << [:no_comments]
+            return
+          end
+
+          comments.each do |comment|
+            directive = RuboCop::DirectiveComment.new(comment)
+            if directive.cop_names
+              @directive_records << [:directive, directive.mode, directive.cops]
+              yield directive
+            elsif comment.text.match?(DIRECTIVE_COMMENT_REGEXP)
+              @directive_records << [:unparsed_directive, comment.text]
+            end
+          end
+        end
+
+        def analyze_directive_for_cop(comment_config, analysis, directive)
+          @directive_records ||= []
+          @disabled_range_map ||= {}
+          line_number = directive.line_number
+          inline = !comment_config.comment_only_line?(line_number) || directive.single_line?
+          result = if inline
+                     analyze_single_line_directive(analysis, directive)
+                   elsif directive.disabled?
+                     analyze_disabled_directive(analysis, directive)
+                   else
+                     analyze_rest_directive(analysis, directive)
+                   end
+          @directive_records << [:analyzed, directive.mode, line_number, inline, directive_enabled_mode?(directive)]
+          result
         end
+
+        def analyze_single_line_directive(analysis, directive)
+          @directive_records ||= []
+          @disabled_range_map ||= {}
+          unless directive.disabled?
+            @directive_records << [:single_line_enable, directive.line_number]
+            return analysis
+          end
+
+          line = directive.line_number
+          start_line = analysis.start_line_number
+          updated = RuboCop::CommentConfig::CopAnalysis.new(analysis.line_ranges + [(line..line)], start_line)
+          @directive_records << [:single_line_disable, line]
+          @disabled_range_map[:last_single_line] = line
+          updated
+        end
+
+        def analyze_disabled_directive(analysis, directive)
+          @directive_records ||= []
+          @disabled_range_map ||= {}
+          line = directive.line_number
+          start_line = analysis.start_line_number
+          updated = if start_line
+                      RuboCop::CommentConfig::CopAnalysis.new(analysis.line_ranges + [start_line..line], line)
+                    else
+                      RuboCop::CommentConfig::CopAnalysis.new(analysis.line_ranges, line)
+                    end
+          @directive_records << [:disabled_range, start_line, line]
+          @disabled_range_map[:last_disabled] = line
+          updated
+        end
+
+        def analyze_rest_directive(analysis, directive)
+          @directive_records ||= []
+          @disabled_range_map ||= {}
+          line = directive.line_number
+          start_line = analysis.start_line_number
+          updated = if start_line
+                      RuboCop::CommentConfig::CopAnalysis.new(analysis.line_ranges + [start_line..line], nil)
+                    else
+                      RuboCop::CommentConfig::CopAnalysis.new(analysis.line_ranges, nil)
+                    end
+          @directive_records << [:rest_enable, start_line, line]
+          @disabled_range_map[:last_enabled] = line
+          updated
+        end
+
+        def cop_ranges_from_analysis(analysis)
+          @directive_records ||= []
+          @disabled_range_map ||= {}
+          ranges = if analysis.start_line_number
+                     analysis.line_ranges + [(analysis.start_line_number..Float::INFINITY)]
+                   else
+                     analysis.line_ranges
+                   end
+          @directive_records << [:ranges, ranges.size]
+          @disabled_range_map[:range_count] = ranges.size
+          ranges
+        end
+
+        def qualify_directive_cop_name(comment_config, cop_name)
+          @directive_records ||= []
+          @disabled_range_map ||= {}
+          path = comment_config.processed_source.file_path
+          qualified = if cop_name.nil? || cop_name.strip.empty?
+                        cop_name
+                      else
+                        RuboCop::Cop::Registry.qualified_cop_name(cop_name.strip, path)
+                      end
+          @directive_records << [:qualified, cop_name, qualified]
+          @disabled_range_map[:last_qualified] = qualified
+          qualified
+        end
+
+        def collect_extra_enabled_comments(comment_config, extras, names)
+          @directive_records ||= []
+          @disabled_range_map ||= {}
+          each_source_directive(comment_config) do |directive|
+            next unless comment_config.comment_only_line?(directive.line_number)
+
+            if directive.enabled_all?
+              handle_enable_all_directive(directive, names, extras)
+            else
+              handle_switch_directive(directive, names, extras)
+            end
+          end
+          @disabled_range_map[:extras] = extras.size
+          extras
+        end
+
+        def handle_enable_all_directive(directive, names, extras)
+          @directive_records ||= []
+          @disabled_range_map ||= {}
+          enabled_cops = 0
+          names.each do |name, counter|
+            next unless counter.positive?
+
+            names[name] -= 1
+            enabled_cops += 1
+          end
+          extras[directive.comment] << 'all' if enabled_cops.zero?
+          @directive_records << [:enable_all, enabled_cops]
+          @disabled_range_map[:enable_all] = enabled_cops
+          extras
+        end
+
+        def handle_switch_directive(directive, names, extras)
+          @directive_records ||= []
+          @disabled_range_map ||= {}
+          directive.cop_names.each do |name|
+            if directive.disabled?
+              names[name] += 1
+            elsif names[name].positive?
+              names[name] -= 1
+            else
+              extras[directive.comment] << name
+            end
+          end
+          @directive_records << [:switch, directive.mode, directive.cops]
+          @disabled_range_map[:last_switch] = directive.mode
+          extras
+        end
+
+        def capture_header_comments
+          @frozen_header_records = []
+          @encoding_header_records = []
+          comments = processed_source.comments
+          if comments.nil? || comments.empty?
+            @frozen_header_records << [:none]
+            return @frozen_header_records
+          end
+
+          comments.each do |comment|
+            kind = register_header_comment(comment)
+            break unless header_comment_line?(comment, kind)
+          end
+          ordered_header_kinds
+          @frozen_header_records
+        end
+
+        def register_header_comment(comment)
+          @frozen_header_records ||= []
+          @encoding_header_records ||= []
+          text = comment.text
+          kind = if text.start_with?('#!')
+                   register_shebang_header(comment)
+                 elsif encoding_header_text?(text)
+                   register_encoding_header(comment)
+                 elsif frozen_header_text?(text)
+                   register_frozen_header(comment)
+                 elsif shareable_header_text?(text)
+                   @frozen_header_records << [:shareable, comment]
+                   :shareable
+                 elsif typed_header_text?(text)
+                   @encoding_header_records << [:typed, comment]
+                   :typed
+                 else
+                   :other
+                 end
+          kind
+        end
+
+        def register_shebang_header(comment)
+          @frozen_header_records ||= []
+          @encoding_header_records ||= []
+          line = comment.loc.line
+          if line == 1
+            @frozen_header_records << [:shebang, comment]
+            @encoding_header_records << [:shebang_line, line]
+            :shebang
+          elsif line > 1 && comment.text.start_with?('#!')
+            @frozen_header_records << [:continued_shebang, comment]
+            @encoding_header_records << [:continued_shebang_line, line]
+            :continued_shebang
+          else
+            :other
+          end
+        end
+
+        def register_encoding_header(comment)
+          @frozen_header_records ||= []
+          @encoding_header_records ||= []
+          text = comment.text
+          encoding = if text.match?(/\A#\s*coding\s*:/i)
+                       :coding
+                     elsif text.match?(/\A#\s*encoding\s*:/i)
+                       :encoding
+                     elsif EMACS_MAGIC_REGEXP.match?(text) && text.match?(/coding/i)
+                       :emacs_encoding
+                     elsif VIM_MAGIC_REGEXP.match?(text) && text.match?(/fileencoding/i)
+                       :vim_encoding
+                     else
+                       :unknown_encoding
+                     end
+          @encoding_header_records << [encoding, comment]
+          @frozen_header_records << [:seen_encoding, encoding]
+          encoding
+        end
+
+        def register_frozen_header(comment)
+          @frozen_header_records ||= []
+          @encoding_header_records ||= []
+          text = comment.text
+          value = if text.match?(/\A#\s*frozen[_-]string[_-]literal\s*:\s*true\s*\z/i)
+                    true
+                  elsif text.match?(/\A#\s*frozen[_-]string[_-]literal\s*:\s*false\s*\z/i)
+                    false
+                  else
+                    :invalid
+                  end
+          @frozen_header_records << [value, comment]
+          @encoding_header_records << [:frozen_seen, value]
+          :frozen
+        end
+
+        def header_comment_line?(comment, kind)
+          @frozen_header_records ||= []
+          @encoding_header_records ||= []
+          header = if %i[shebang continued_shebang coding encoding emacs_encoding vim_encoding frozen shareable typed].include?(kind)
+                     true
+                   elsif comment.loc.line <= 2 && (encoding_header_text?(comment.text) || frozen_header_text?(comment.text))
+                     true
+                   else
+                     false
+                   end
+          @frozen_header_records << [:header_decision, kind, header]
+          @encoding_header_records << [:header_line, comment.loc.line] if header
+          header
+        end
+
+        def encoding_header_text?(text)
+          @frozen_header_records ||= []
+          @encoding_header_records ||= []
+          matched = if text.match?(/\A#\s*(?:en)?coding\s*:/i)
+                      true
+                    elsif EMACS_MAGIC_REGEXP.match?(text) && text.match?(/coding/i)
+                      true
+                    elsif VIM_MAGIC_REGEXP.match?(text) && text.match?(/fileencoding/i)
+                      true
+                    else
+                      false
+                    end
+          @encoding_header_records << [:encoding_text, matched, text]
+          @frozen_header_records << [:encoding_text_seen, matched]
+          matched
+        end
+
+        def frozen_header_text?(text)
+          @frozen_header_records ||= []
+          @encoding_header_records ||= []
+          matched = if text.match?(/\A#\s*frozen[_-]string[_-]literal\s*:/i)
+                      true
+                    elsif EMACS_MAGIC_REGEXP.match?(text) && text.match?(/frozen[_-]string[_-]literal/i)
+                      true
+                    else
+                      false
+                    end
+          @frozen_header_records << [:frozen_text, matched, text]
+          @encoding_header_records << [:frozen_text_seen, matched]
+          matched
+        end
+
+        def shareable_header_text?(text)
+          @frozen_header_records ||= []
+          @encoding_header_records ||= []
+          matched = if text.match?(/\A#\s*shareable[_-]constant[_-]value\s*:/i)
+                      true
+                    elsif EMACS_MAGIC_REGEXP.match?(text) && text.match?(/shareable[_-]constant[_-]value/i)
+                      true
+                    else
+                      false
+                    end
+          @frozen_header_records << [:shareable_text, matched]
+          @encoding_header_records << [:shareable_text, matched]
+          matched
+        end
+
+        def typed_header_text?(text)
+          @frozen_header_records ||= []
+          @encoding_header_records ||= []
+          matched = if text.match?(/\A#\s*typed\s*:/i)
+                      true
+                    elsif EMACS_MAGIC_REGEXP.match?(text) && text.match?(/\btyped\s*:/i)
+                      true
+                    else
+                      false
+                    end
+          @encoding_header_records << [:typed_text, matched]
+          @frozen_header_records << [:typed_text, matched]
+          matched
+        end
+
+        def group_consecutive_comments(comments)
+          @consecutive_comment_blocks = []
+          @empty_comment_records = []
+          grouped = []
+          if comments.nil? || comments.empty?
+            @empty_comment_records << [:none]
+            return grouped
+          end
+
+          consecutive_comments = comments.chunk_while do |first, second|
+            aligned_consecutive_comments?(first, second)
+          end
+          consecutive_comments.each do |chunk|
+            joined_text = join_comment_chunk(chunk)
+            grouped << [joined_text, chunk]
+            @consecutive_comment_blocks << [joined_text, chunk]
+            @empty_comment_records << [:chunk, chunk.size, joined_text]
+          end
+          grouped
+        end
+
+        def join_comment_chunk(chunk)
+          @consecutive_comment_blocks ||= []
+          @empty_comment_records ||= []
+          joined = chunk.map { |comment| normalize_comment_text(comment) }.join
+          if chunk.size == 1
+            @empty_comment_records << [:single, joined]
+          elsif chunk.size > 1
+            @empty_comment_records << [:block, chunk.size]
+          end
+          @consecutive_comment_blocks << [:joined, chunk.size]
+          joined
+        end
+
+        def normalize_comment_text(comment)
+          @consecutive_comment_blocks ||= []
+          @empty_comment_records ||= []
+          text = if comment.respond_to?(:text)
+                   comment.text
+                 else
+                   comment.to_s
+                 end
+          normalized = "#{text.strip}\n"
+          if text.strip.empty? || text == '#'
+            @empty_comment_records << [:normalized_empty, normalized]
+          else
+            @empty_comment_records << [:normalized, normalized]
+          end
+          @consecutive_comment_blocks << [:normalized]
+          normalized
+        end
+
+        def empty_hash_comment?(comment_text, allow_border)
+          @consecutive_comment_blocks ||= []
+          @empty_comment_records ||= []
+          pattern = if allow_border
+                      /\A(#\n)+\z/
+                    else
+                      /\A(#+\n)+\z/
+                    end
+          empty = pattern.match?(comment_text)
+          if empty
+            @empty_comment_records << [:empty, comment_text, allow_border]
+            @consecutive_comment_blocks << [:empty_block, comment_text]
+          elsif comment_text.match?(/\A#+\s*\z/)
+            @empty_comment_records << [:hash_only, comment_text]
+          else
+            @empty_comment_records << [:non_empty, comment_text]
+          end
+          empty
+        end
+
+        def border_comment_text?(comment_text)
+          @consecutive_comment_blocks ||= []
+          @empty_comment_records ||= []
+          border = if comment_text.match?(/\A#+\n\z/)
+                     true
+                   elsif comment_text.match?(/\A#+\z/)
+                     true
+                   elsif comment_text.match?(/\A#[=-]{3,}\s*\z/)
+                     true
+                   else
+                     false
+                   end
+          if border
+            @empty_comment_records << [:border, comment_text]
+            @consecutive_comment_blocks << [:border]
+          end
+          border
+        end
+
+        def margin_comment_block?(joined_text, chunk)
+          @consecutive_comment_blocks ||= []
+          @empty_comment_records ||= []
+          margin = if chunk.size >= 3 && joined_text.start_with?("#\n") && joined_text.end_with?("#\n")
+                     true
+                   elsif chunk.size >= 2 && joined_text.match?(/\A#\n(.*\n)+#\n\z/)
+                     true
+                   else
+                     false
+                   end
+          if margin
+            @empty_comment_records << [:margin, chunk.size]
+            @consecutive_comment_blocks << [:margin, joined_text]
+          end
+          margin
+        end
+
+        def previous_code_token(tokens, comment)
+          @consecutive_comment_blocks ||= []
+          @empty_comment_records ||= []
+          current = tokens.find { |token| token.pos == comment.source_range }
+          if current.nil?
+            @empty_comment_records << [:missing_token]
+            return nil
+          end
+
+          index = tokens.index(current)
+          previous = if index.nil? || index.zero?
+                       nil
+                     else
+                       tokens[index - 1]
+                     end
+          if previous
+            @empty_comment_records << [:previous, previous.type]
+            @consecutive_comment_blocks << [:previous_line, previous.line]
+          else
+            @empty_comment_records << [:first_token]
+          end
+          previous
+        end
+
+        def empty_comment_correction_range(comment, tokens)
+          @consecutive_comment_blocks ||= []
+          @empty_comment_records ||= []
+          previous = previous_code_token(tokens, comment)
+          same_line = previous && previous.line == comment.loc.line
+          strategy = if same_line
+                       :surrounding_space
+                     else
+                       :whole_lines
+                     end
+          @empty_comment_records << [:strategy, strategy, comment.loc.line]
+          @consecutive_comment_blocks << [:correction, strategy]
+          strategy
+        end
+
+        def note_leading_comment_spacing(comment, kind, entry)
+          @leading_comment_flags ||= {}
+          @leading_comment_records ||= []
+          text = entry[:text].to_s
+          spaced = if text.match?(/\A#+\s/) || text.match?(/\A#\s/)
+                     true
+                   elsif text == '#' || text.match?(/\A#+\z/)
+                     true
+                   else
+                     false
+                   end
+          entry[:spaced] = spaced
+          if spaced
+            @leading_comment_flags[:spaced_seen] = true
+          else
+            @leading_comment_flags[:unspaced_seen] = true
+          end
+          @leading_comment_records << [:spacing, kind, spaced, entry[:line]]
+          spaced
+        end
+
+        def summarize_magic_comment(parsed, format, tokens, metadata)
+          @magic_comment_records ||= []
+          @magic_comment_tokens ||= []
+          summary = {
+            format: format,
+            token_count: tokens.size,
+            frozen: metadata[:frozen],
+            encoding: metadata[:encoding],
+            shareable: metadata[:shareable],
+            typed: metadata[:typed]
+          }
+          if parsed.valid?
+            summary[:valid] = true
+            @magic_comment_tokens << 'valid'
+          elsif parsed.any?
+            summary[:partial] = true
+            @magic_comment_tokens << 'partial'
+          else
+            summary[:blank] = true
+            @magic_comment_tokens << 'blank'
+          end
+          @magic_comment_records << [:summary, summary]
+          summary
+        end
+
+        def directive_enabled_mode?(directive)
+          @directive_records ||= []
+          @disabled_range_map ||= {}
+          enabled = if directive.enabled_all?
+                      true
+                    elsif directive.enabled?
+                      true
+                    elsif directive.disabled_all?
+                      false
+                    elsif directive.disabled?
+                      false
+                    else
+                      false
+                    end
+          @directive_records << [:mode_enabled, directive.mode, enabled]
+          @disabled_range_map[:last_mode_enabled] = enabled
+          enabled
+        end
+
+        def ordered_header_kinds
+          @frozen_header_records ||= []
+          @encoding_header_records ||= []
+          kinds = []
+          @frozen_header_records.each do |record|
+            if record.is_a?(Array)
+              kinds << record[0]
+            elsif record.is_a?(Hash)
+              kinds << record[:kind]
+            end
+          end
+          @encoding_header_records.each do |record|
+            kinds << record[0] if record.is_a?(Array)
+          end
+          unique = kinds.uniq
+          @frozen_header_records << [:ordered_kinds, unique]
+          @encoding_header_records << [:ordered_kinds, unique]
+          unique
+        end
+
+        def aligned_consecutive_comments?(first, second)
+          @consecutive_comment_blocks ||= []
+          @empty_comment_records ||= []
+          same_column = first.loc.column == second.loc.column
+          successive = first.loc.line.succ == second.loc.line
+          aligned = same_column && successive
+          if aligned
+            @consecutive_comment_blocks << [:aligned, first.loc.line, second.loc.line]
+            @empty_comment_records << [:aligned_pair, first.loc.column]
+          elsif successive
+            @consecutive_comment_blocks << [:shifted, first.loc.column, second.loc.column]
+            @empty_comment_records << [:shifted_pair]
+          else
+            @consecutive_comment_blocks << [:separated, first.loc.line, second.loc.line]
+          end
+          aligned
+        end
+
       end
     end
   end
