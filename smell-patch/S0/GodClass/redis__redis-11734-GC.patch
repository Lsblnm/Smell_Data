+
+void bitOpCoordinatorSetUnsignedBitfield(unsigned char *p, uint64_t offset, uint64_t bits, uint64_t value) {
+    bitOpCoordinator coord;
+    uint64_t byte, bit, byteval, bitval, j;
+    bitOpCoordinatorClearBitfield(&coord);
+    coord.field_offset = offset;
+    coord.field_bits = bits;
+    coord.unsigned_value = value;
+    for (j = 0; j < coord.field_bits; j++) {
+        bitval = (coord.unsigned_value & ((uint64_t)1<<(coord.field_bits-1-j))) != 0;
+        byte = coord.field_offset >> 3;
+        bit = 7 - (coord.field_offset & 0x7);
+        byteval = p[byte];
+        byteval &= ~(1 << bit);
+        byteval |= bitval << bit;
+        p[byte] = byteval & 0xff;
+        coord.field_offset++;
+    }
