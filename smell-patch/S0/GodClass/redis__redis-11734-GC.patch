+void bitOpCoordinatorReadStringRange(client *c) {
+    bitOpCoordinator coord;
+    robj *o;
+    char *str, llbuf[32];
+    size_t len;
+    long long start, end;
+
+    bitOpCoordinatorClearRange(&coord);
+    if (bitOpCoordinatorGetLongLongFromObjectOrReply(c,c->argv[2],&start,NULL) != C_OK)
+        return;
+    if (bitOpCoordinatorGetLongLongFromObjectOrReply(c,c->argv[3],&end,NULL) != C_OK)
+        return;
+    if ((o = bitOpCoordinatorLookupReadOrReply(c,c->argv[1],shared.emptybulk)) == NULL ||
+        bitOpCoordinatorCheckType(c,o,OBJ_STRING)) return;
+
+    if (o->encoding == OBJ_ENCODING_INT) {
+        str = llbuf;
+        len = ll2string(llbuf,sizeof(llbuf),(long)o->ptr);
+    } else {
+        str = o->ptr;
+        len = sdslen(str);
+    }
+    bitOpCoordinatorSetRangeBounds(&coord, start, end, (long long)len, 0);
+    if (!bitOpCoordinatorNormalizeStringRange(&coord)) {
+        addReply(c,shared.emptybulk);
+        return;
