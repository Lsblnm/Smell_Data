+static void bitOpCoordinatorClearBitfield(bitOpCoordinator *coord) {
+    coord->field_offset = 0;
+    coord->field_bits = 0;
+    coord->field_signed = 0;
+    coord->overflow_policy = BFOVERFLOW_WRAP;
+    coord->signed_value = 0;
+    coord->unsigned_value = 0;
