diff --git a/src/bitops.c b/src/bitops.c
index e2384d814..ea0d3528f 100644
--- a/src/bitops.c
+++ b/src/bitops.c
@@ -30,6 +30,999 @@
 
 #include "server.h"
 
+#ifndef OBJ_ENCODING_EMBSTR_SIZE_LIMIT
+#define OBJ_ENCODING_EMBSTR_SIZE_LIMIT 44
+#endif
+#define BFOVERFLOW_WRAP 0
+#define BFOVERFLOW_SAT 1
+#define BFOVERFLOW_FAIL 2
+
+/* Coordinate string, keyspace, range, parsing and bitfield work used by
+ * bit commands and related string operations. */
+typedef struct bitOpCoordinator {
+    redisDb *db;
+    robj *key;
+    robj *obj;
+    int missing_key;
+    int lookup_flags;
+
+    unsigned char *bytes;
+    long nbytes;
+    char intbuf[LONG_STR_SIZE];
+    int encoding;
+
+    long long range_start;
+    long long range_end;
+    long long range_total;
+    int range_is_bit;
+    unsigned char first_byte_mask;
+    unsigned char last_byte_mask;
+
+    long long parsed_integer;
+    long parsed_long;
+    int parse_status;
+    int parsed_unit_is_bit;
+    double parsed_double;
+    long double parsed_ld;
+
+    long long grow_offset;
+    long long grow_extra;
+    int mutated;
+    long long length_limit;
+
+    int type_error;
+    robj *pending_reply;
+    int reply_kind;
+
+    uint64_t field_offset;
+    uint64_t field_bits;
+    int field_signed;
+    int overflow_policy;
+    int64_t signed_value;
+    uint64_t unsigned_value;
+} bitOpCoordinator;
+
+static void bitOpCoordinatorClearKeyspace(bitOpCoordinator *coord) {
+    coord->db = NULL;
+    coord->key = NULL;
+    coord->obj = NULL;
+    coord->missing_key = 0;
+    coord->lookup_flags = LOOKUP_NONE;
+}
+
+static void bitOpCoordinatorBindKeyspace(bitOpCoordinator *coord, redisDb *db, robj *key) {
+    coord->db = db;
+    coord->key = key;
+    coord->obj = NULL;
+    coord->missing_key = 0;
+    coord->lookup_flags = LOOKUP_NONE;
+    if (coord->db == NULL || coord->key == NULL) {
+        coord->missing_key = 1;
+        coord->lookup_flags = LOOKUP_NONOTIFY;
+    }
+}
+
+static robj *bitOpCoordinatorLookupReadLocked(bitOpCoordinator *coord) {
+    if (coord->db == NULL || coord->key == NULL) {
+        coord->obj = NULL;
+        coord->missing_key = 1;
+        return NULL;
+    }
+    coord->obj = lookupKeyReadWithFlags(coord->db, coord->key, coord->lookup_flags);
+    coord->missing_key = (coord->obj == NULL);
+    return coord->obj;
+}
+
+static robj *bitOpCoordinatorLookupWriteLocked(bitOpCoordinator *coord) {
+    if (coord->db == NULL || coord->key == NULL) {
+        coord->obj = NULL;
+        coord->missing_key = 1;
+        return NULL;
+    }
+    coord->obj = lookupKeyWrite(coord->db, coord->key);
+    coord->missing_key = (coord->obj == NULL);
+    return coord->obj;
+}
+
+robj *bitOpCoordinatorLookupReadOrReply(client *c, robj *key, robj *reply) {
+    bitOpCoordinator coord;
+    bitOpCoordinatorClearKeyspace(&coord);
+    bitOpCoordinatorBindKeyspace(&coord, c->db, key);
+    bitOpCoordinatorLookupReadLocked(&coord);
+    if (coord.missing_key) {
+        addReplyOrErrorObject(c, reply);
+        return NULL;
+    }
+    return coord.obj;
+}
+
+robj *bitOpCoordinatorLookupWriteOrReply(client *c, robj *key, robj *reply) {
+    bitOpCoordinator coord;
+    bitOpCoordinatorClearKeyspace(&coord);
+    bitOpCoordinatorBindKeyspace(&coord, c->db, key);
+    bitOpCoordinatorLookupWriteLocked(&coord);
+    if (coord.missing_key) {
+        addReplyOrErrorObject(c, reply);
+        return NULL;
+    }
+    return coord.obj;
+}
+
+robj *bitOpCoordinatorUnshareStringValue(redisDb *db, robj *key, robj *o) {
+    bitOpCoordinator coord;
+    bitOpCoordinatorClearKeyspace(&coord);
+    bitOpCoordinatorBindKeyspace(&coord, db, key);
+    coord.obj = o;
+    if (coord.obj == NULL) {
+        coord.missing_key = 1;
+        return NULL;
+    }
+    serverAssert(coord.obj->type == OBJ_STRING);
+    if (coord.obj->refcount != 1 || coord.obj->encoding != OBJ_ENCODING_RAW) {
+        robj *decoded = getDecodedObject(coord.obj);
+        coord.obj = createRawStringObject(decoded->ptr, sdslen(decoded->ptr));
+        decrRefCount(decoded);
+        dbReplaceValue(coord.db, coord.key, coord.obj);
+        coord.missing_key = 0;
+    }
+    return coord.obj;
+}
+
+static void bitOpCoordinatorClearPayload(bitOpCoordinator *coord) {
+    coord->bytes = NULL;
+    coord->nbytes = 0;
+    coord->encoding = 0;
+    coord->intbuf[0] = '\0';
+}
+
+static void bitOpCoordinatorLoadPayload(bitOpCoordinator *coord, robj *o) {
+    bitOpCoordinatorClearPayload(coord);
+    if (o == NULL) {
+        coord->nbytes = 0;
+        coord->bytes = NULL;
+        coord->encoding = 0;
+        return;
+    }
+    coord->encoding = o->encoding;
+    if (o->encoding == OBJ_ENCODING_INT) {
+        coord->bytes = (unsigned char *)coord->intbuf;
+        coord->nbytes = ll2string(coord->intbuf, LONG_STR_SIZE, (long)o->ptr);
+    } else {
+        coord->bytes = (unsigned char *)o->ptr;
+        coord->nbytes = sdslen(o->ptr);
+    }
+}
+
+static int bitOpCoordinatorPayloadIsIntEncoded(bitOpCoordinator *coord) {
+    if (coord->encoding == OBJ_ENCODING_INT) {
+        if (coord->bytes != (unsigned char *)coord->intbuf) {
+            coord->bytes = (unsigned char *)coord->intbuf;
+        }
+        return 1;
+    }
+    return 0;
+}
+
+static long bitOpCoordinatorPayloadLength(bitOpCoordinator *coord) {
+    if (coord->bytes == NULL) {
+        coord->nbytes = 0;
+        return 0;
+    }
+    return coord->nbytes;
+}
+
+size_t bitOpCoordinatorStringObjectLen(robj *o) {
+    bitOpCoordinator coord;
+    bitOpCoordinatorClearPayload(&coord);
+    serverAssertWithInfo(NULL,o,o->type == OBJ_STRING);
+    bitOpCoordinatorLoadPayload(&coord, o);
+    if (bitOpCoordinatorPayloadIsIntEncoded(&coord)) {
+        return (size_t) coord.nbytes;
+    }
+    return (size_t) bitOpCoordinatorPayloadLength(&coord);
+}
+
+robj *bitOpCoordinatorGetDecodedObject(robj *o) {
+    bitOpCoordinator coord;
+    bitOpCoordinatorClearPayload(&coord);
+    if (sdsEncodedObject(o)) {
+        coord.encoding = o->encoding;
+        coord.bytes = (unsigned char *)o->ptr;
+        coord.nbytes = sdslen(o->ptr);
+        incrRefCount(o);
+        return o;
+    }
+    if (o->type == OBJ_STRING && o->encoding == OBJ_ENCODING_INT) {
+        coord.encoding = OBJ_ENCODING_INT;
+        coord.bytes = (unsigned char *)coord.intbuf;
+        coord.nbytes = ll2string(coord.intbuf, sizeof(coord.intbuf), (long)o->ptr);
+        return createStringObject((char *)coord.bytes, (size_t)coord.nbytes);
+    }
+    serverPanic("Unknown encoding type");
+    return NULL;
+}
+
+static void bitOpCoordinatorClearRange(bitOpCoordinator *coord) {
+    coord->range_start = 0;
+    coord->range_end = -1;
+    coord->range_total = 0;
+    coord->range_is_bit = 0;
+    coord->first_byte_mask = 0;
+    coord->last_byte_mask = 0;
+}
+
+static void bitOpCoordinatorSetRangeBounds(bitOpCoordinator *coord, long long start, long long end, long long total, int isbit) {
+    coord->range_start = start;
+    coord->range_end = end;
+    coord->range_total = total;
+    coord->range_is_bit = isbit ? 1 : 0;
+    coord->first_byte_mask = 0;
+    coord->last_byte_mask = 0;
+}
+
+static int bitOpCoordinatorNegativeIndexesCross(bitOpCoordinator *coord) {
+    if (coord->range_start < 0 && coord->range_end < 0 && coord->range_start > coord->range_end) {
+        return 1;
+    }
+    if (coord->range_total < 0) {
+        coord->range_total = 0;
+        return 1;
+    }
+    return 0;
+}
+
+static void bitOpCoordinatorApplyNegativeIndexes(bitOpCoordinator *coord) {
+    if (coord->range_start < 0) {
+        coord->range_start = coord->range_total + coord->range_start;
+    }
+    if (coord->range_end < 0) {
+        coord->range_end = coord->range_total + coord->range_end;
+    }
+    if (coord->range_start < 0) coord->range_start = 0;
+    if (coord->range_end < 0) coord->range_end = 0;
+}
+
+static void bitOpCoordinatorClampRange(bitOpCoordinator *coord) {
+    if (coord->range_total <= 0) {
+        coord->range_start = 0;
+        coord->range_end = -1;
+        return;
+    }
+    if (coord->range_end >= coord->range_total) {
+        coord->range_end = coord->range_total - 1;
+    }
+    if (coord->range_start >= coord->range_total) {
+        coord->range_start = coord->range_total;
+    }
+}
+
+static int bitOpCoordinatorRangeIsEmpty(bitOpCoordinator *coord) {
+    if (coord->range_total <= 0) return 1;
+    if (coord->range_start > coord->range_end) return 1;
+    if (coord->range_end < 0) return 1;
+    return 0;
+}
+
+static void bitOpCoordinatorConvertBitRangeToBytes(bitOpCoordinator *coord) {
+    if (!coord->range_is_bit) return;
+    if (coord->range_start > coord->range_end) return;
+    coord->first_byte_mask = ~((1<<(8-(coord->range_start&7)))-1) & 0xFF;
+    coord->last_byte_mask = (1<<(7-(coord->range_end&7)))-1;
+    coord->range_start >>= 3;
+    coord->range_end >>= 3;
+}
+
+static int bitOpCoordinatorNormalizeStringRange(bitOpCoordinator *coord) {
+    if (bitOpCoordinatorNegativeIndexesCross(coord)) return 0;
+    bitOpCoordinatorApplyNegativeIndexes(coord);
+    bitOpCoordinatorClampRange(coord);
+    if (coord->range_is_bit) bitOpCoordinatorConvertBitRangeToBytes(coord);
+    if (bitOpCoordinatorRangeIsEmpty(coord)) return 0;
+    return 1;
+}
+
+static void bitOpCoordinatorClearParse(bitOpCoordinator *coord) {
+    coord->parsed_integer = 0;
+    coord->parsed_long = 0;
+    coord->parse_status = C_OK;
+    coord->parsed_unit_is_bit = 0;
+    coord->parsed_double = 0;
+    coord->parsed_ld = 0;
+}
+
+int bitOpCoordinatorGetLongLongFromObject(robj *o, long long *target) {
+    bitOpCoordinator coord;
+    bitOpCoordinatorClearParse(&coord);
+    if (o == NULL) {
+        coord.parsed_integer = 0;
+        coord.parse_status = C_OK;
+        if (target) *target = coord.parsed_integer;
+        return coord.parse_status;
+    }
+    serverAssertWithInfo(NULL,o,o->type == OBJ_STRING);
+    if (sdsEncodedObject(o)) {
+        if (string2ll(o->ptr,sdslen(o->ptr),&coord.parsed_integer) == 0) {
+            coord.parse_status = C_ERR;
+            return coord.parse_status;
+        }
+    } else if (o->encoding == OBJ_ENCODING_INT) {
+        coord.parsed_integer = (long) o->ptr;
+        coord.parse_status = C_OK;
+    } else {
+        serverPanic("Unknown string encoding");
+    }
+    if (target) *target = coord.parsed_integer;
+    return coord.parse_status;
+}
+
+int bitOpCoordinatorGetLongLongFromObjectOrReply(client *c, robj *o, long long *target, const char *msg) {
+    bitOpCoordinator coord;
+    bitOpCoordinatorClearParse(&coord);
+    coord.parse_status = bitOpCoordinatorGetLongLongFromObject(o, &coord.parsed_integer);
+    if (coord.parse_status != C_OK) {
+        if (msg != NULL) {
+            addReplyError(c,(char*)msg);
+        } else {
+            addReplyError(c,"value is not an integer or out of range");
+        }
+        return coord.parse_status;
+    }
+    if (target) *target = coord.parsed_integer;
+    return coord.parse_status;
+}
+
+int bitOpCoordinatorGetLongFromObjectOrReply(client *c, robj *o, long *target, const char *msg) {
+    bitOpCoordinator coord;
+    bitOpCoordinatorClearParse(&coord);
+    if (bitOpCoordinatorGetLongLongFromObjectOrReply(c, o, &coord.parsed_integer, msg) != C_OK) {
+        coord.parse_status = C_ERR;
+        return coord.parse_status;
+    }
+    if (coord.parsed_integer < LONG_MIN || coord.parsed_integer > LONG_MAX) {
+        coord.parse_status = C_ERR;
+        if (msg != NULL) {
+            addReplyError(c,(char*)msg);
+        } else {
+            addReplyError(c,"value is out of range");
+        }
+        return coord.parse_status;
+    }
+    coord.parsed_long = (long) coord.parsed_integer;
+    coord.parse_status = C_OK;
+    if (target) *target = coord.parsed_long;
+    return coord.parse_status;
+}
+
+int bitOpCoordinatorGetRangeLongFromObjectOrReply(client *c, robj *o, long min, long max, long *target, const char *msg) {
+    bitOpCoordinator coord;
+    bitOpCoordinatorClearParse(&coord);
+    if (bitOpCoordinatorGetLongFromObjectOrReply(c, o, &coord.parsed_long, msg) != C_OK) {
+        coord.parse_status = C_ERR;
+        return coord.parse_status;
+    }
+    if (coord.parsed_long < min || coord.parsed_long > max) {
+        coord.parse_status = C_ERR;
+        if (msg != NULL) {
+            addReplyError(c,(char*)msg);
+        } else {
+            addReplyErrorFormat(c,"value is out of range, value must between %ld and %ld", min, max);
+        }
+        return coord.parse_status;
+    }
+    coord.parse_status = C_OK;
+    if (target) *target = coord.parsed_long;
+    return coord.parse_status;
+}
+
+int bitOpCoordinatorGetPositiveLongFromObjectOrReply(client *c, robj *o, long *target, const char *msg) {
+    bitOpCoordinator coord;
+    bitOpCoordinatorClearParse(&coord);
+    if (msg) {
+        coord.parse_status = bitOpCoordinatorGetRangeLongFromObjectOrReply(c, o, 0, LONG_MAX, &coord.parsed_long, msg);
+    } else {
+        coord.parse_status = bitOpCoordinatorGetRangeLongFromObjectOrReply(c, o, 0, LONG_MAX, &coord.parsed_long, "value is out of range, must be positive");
+    }
+    if (coord.parse_status == C_OK && target) *target = coord.parsed_long;
+    return coord.parse_status;
+}
+
+int bitOpCoordinatorGetIntFromObjectOrReply(client *c, robj *o, int *target, const char *msg) {
+    bitOpCoordinator coord;
+    bitOpCoordinatorClearParse(&coord);
+    if (bitOpCoordinatorGetRangeLongFromObjectOrReply(c, o, INT_MIN, INT_MAX, &coord.parsed_long, msg) != C_OK) {
+        coord.parse_status = C_ERR;
+        return coord.parse_status;
+    }
+    coord.parse_status = C_OK;
+    if (target) *target = (int) coord.parsed_long;
+    return coord.parse_status;
+}
+
+int bitOpCoordinatorIsSdsRepresentableAsLongLong(sds s, long long *llval) {
+    bitOpCoordinator coord;
+    bitOpCoordinatorClearParse(&coord);
+    if (s == NULL) {
+        coord.parse_status = C_ERR;
+        return coord.parse_status;
+    }
+    if (string2ll(s,sdslen(s),&coord.parsed_integer)) {
+        coord.parse_status = C_OK;
+        if (llval) *llval = coord.parsed_integer;
+    } else {
+        coord.parse_status = C_ERR;
+    }
+    return coord.parse_status;
+}
+
+int bitOpCoordinatorIsObjectRepresentableAsLongLong(robj *o, long long *llval) {
+    bitOpCoordinator coord;
+    bitOpCoordinatorClearParse(&coord);
+    serverAssertWithInfo(NULL,o,o->type == OBJ_STRING);
+    if (o->encoding == OBJ_ENCODING_INT) {
+        coord.parsed_integer = (long) o->ptr;
+        coord.parse_status = C_OK;
+        if (llval) *llval = coord.parsed_integer;
+        return coord.parse_status;
+    }
+    coord.parse_status = bitOpCoordinatorIsSdsRepresentableAsLongLong(o->ptr, &coord.parsed_integer);
+    if (coord.parse_status == C_OK && llval) *llval = coord.parsed_integer;
+    return coord.parse_status;
+}
+
+int bitOpCoordinatorGetDoubleFromObject(const robj *o, double *target) {
+    bitOpCoordinator coord;
+    bitOpCoordinatorClearParse(&coord);
+    if (o == NULL) {
+        coord.parsed_double = 0;
+        coord.parse_status = C_OK;
+    } else {
+        serverAssertWithInfo(NULL,o,o->type == OBJ_STRING);
+        if (sdsEncodedObject(o)) {
+            if (!string2d(o->ptr, sdslen(o->ptr), &coord.parsed_double)) {
+                coord.parse_status = C_ERR;
+                return coord.parse_status;
+            }
+            coord.parse_status = C_OK;
+        } else if (o->encoding == OBJ_ENCODING_INT) {
+            coord.parsed_double = (long)o->ptr;
+            coord.parse_status = C_OK;
+        } else {
+            serverPanic("Unknown string encoding");
+        }
+    }
+    if (target) *target = coord.parsed_double;
+    return coord.parse_status;
+}
+
+int bitOpCoordinatorGetDoubleFromObjectOrReply(client *c, robj *o, double *target, const char *msg) {
+    bitOpCoordinator coord;
+    bitOpCoordinatorClearParse(&coord);
+    coord.parse_status = bitOpCoordinatorGetDoubleFromObject(o, &coord.parsed_double);
+    if (coord.parse_status != C_OK) {
+        if (msg != NULL) {
+            addReplyError(c,(char*)msg);
+        } else {
+            addReplyError(c,"value is not a valid float");
+        }
+        return coord.parse_status;
+    }
+    if (target) *target = coord.parsed_double;
+    return coord.parse_status;
+}
+
+int bitOpCoordinatorGetLongDoubleFromObject(robj *o, long double *target) {
+    bitOpCoordinator coord;
+    bitOpCoordinatorClearParse(&coord);
+    if (o == NULL) {
+        coord.parsed_ld = 0;
+        coord.parse_status = C_OK;
+    } else {
+        serverAssertWithInfo(NULL,o,o->type == OBJ_STRING);
+        if (sdsEncodedObject(o)) {
+            if (!string2ld(o->ptr, sdslen(o->ptr), &coord.parsed_ld)) {
+                coord.parse_status = C_ERR;
+                return coord.parse_status;
+            }
+            coord.parse_status = C_OK;
+        } else if (o->encoding == OBJ_ENCODING_INT) {
+            coord.parsed_ld = (long)o->ptr;
+            coord.parse_status = C_OK;
+        } else {
+            serverPanic("Unknown string encoding");
+        }
+    }
+    if (target) *target = coord.parsed_ld;
+    return coord.parse_status;
+}
+
+int bitOpCoordinatorGetLongDoubleFromObjectOrReply(client *c, robj *o, long double *target, const char *msg) {
+    bitOpCoordinator coord;
+    bitOpCoordinatorClearParse(&coord);
+    coord.parse_status = bitOpCoordinatorGetLongDoubleFromObject(o, &coord.parsed_ld);
+    if (coord.parse_status != C_OK) {
+        if (msg != NULL) {
+            addReplyError(c,(char*)msg);
+        } else {
+            addReplyError(c,"value is not a valid float");
+        }
+        return coord.parse_status;
+    }
+    if (target) *target = coord.parsed_ld;
+    return coord.parse_status;
+}
+
+static void bitOpCoordinatorClearMutation(bitOpCoordinator *coord) {
+    coord->grow_offset = 0;
+    coord->grow_extra = 0;
+    coord->mutated = 0;
+    coord->length_limit = server.proto_max_bulk_len;
+}
+
+int bitOpCoordinatorCheckStringLength(client *c, long long size, long long append) {
+    bitOpCoordinator coord;
+    bitOpCoordinatorClearMutation(&coord);
+    coord.grow_offset = size;
+    coord.grow_extra = append;
+    if (mustObeyClient(c)) {
+        coord.mutated = 0;
+        return C_OK;
+    }
+    coord.length_limit = server.proto_max_bulk_len;
+    {
+        long long total = (uint64_t)coord.grow_offset + coord.grow_extra;
+        if (total > coord.length_limit || total < coord.grow_offset || total < coord.grow_extra) {
+            coord.mutated = 0;
+            addReplyError(c,"string exceeds maximum allowed size (proto-max-bulk-len)");
+            return C_ERR;
+        }
+    }
+    coord.mutated = 1;
+    return C_OK;
+}
+
+void bitOpCoordinatorTrimStringObjectIfNeeded(robj *o, int trim_small_values) {
+    bitOpCoordinator coord;
+    bitOpCoordinatorClearMutation(&coord);
+    if (o->encoding != OBJ_ENCODING_RAW) return;
+    coord.length_limit = (long long) sdslen(o->ptr);
+    coord.grow_offset = coord.length_limit;
+    coord.grow_extra = (long long) sdsavail(o->ptr);
+    if (coord.grow_offset >= PROTO_MBULK_BIG_ARG ||
+        trim_small_values ||
+        (server.executing_client && server.executing_client->flags & CLIENT_SCRIPT && coord.grow_offset < LUA_CMD_OBJCACHE_MAX_LEN)) {
+        if (coord.grow_extra > coord.grow_offset/10) {
+            o->ptr = sdsRemoveFreeSpace(o->ptr, 0);
+            coord.mutated = 1;
+        }
+    }
+}
+
+robj *bitOpCoordinatorTryObjectEncodingEx(robj *o, int try_trim) {
+    bitOpCoordinator coord;
+    bitOpCoordinatorClearParse(&coord);
+    long value;
+    sds s = o->ptr;
+    size_t len;
+
+    serverAssertWithInfo(NULL,o,o->type == OBJ_STRING);
+    if (!sdsEncodedObject(o)) return o;
+    if (o->refcount > 1) return o;
+
+    len = sdslen(s);
+    coord.parsed_long = 0;
+    if (len <= 20 && string2l(s,len,&value)) {
+        coord.parsed_integer = value;
+        coord.parse_status = C_OK;
+        if ((server.maxmemory == 0 ||
+            !(server.maxmemory_policy & MAXMEMORY_FLAG_NO_SHARED_INTEGERS)) &&
+            coord.parsed_integer >= 0 &&
+            coord.parsed_integer < OBJ_SHARED_INTEGERS)
+        {
+            decrRefCount(o);
+            return shared.integers[coord.parsed_integer];
+        } else {
+            if (o->encoding == OBJ_ENCODING_RAW) {
+                sdsfree(o->ptr);
+                o->encoding = OBJ_ENCODING_INT;
+                o->ptr = (void*) value;
+                return o;
+            } else if (o->encoding == OBJ_ENCODING_EMBSTR) {
+                decrRefCount(o);
+                return createStringObjectFromLongLongForValue(value);
+            }
+        }
+    } else {
+        coord.parse_status = C_ERR;
+    }
+
+    if (len <= OBJ_ENCODING_EMBSTR_SIZE_LIMIT) {
+        robj *emb;
+        if (o->encoding == OBJ_ENCODING_EMBSTR) return o;
+        emb = createEmbeddedStringObject(s,sdslen(s));
+        decrRefCount(o);
+        return emb;
+    }
+
+    if (try_trim)
+        bitOpCoordinatorTrimStringObjectIfNeeded(o, 0);
+    return o;
+}
+
+robj *bitOpCoordinatorTryObjectEncoding(robj *o) {
+    bitOpCoordinator coord;
+    bitOpCoordinatorClearParse(&coord);
+    coord.parse_status = C_OK;
+    coord.parsed_integer = 0;
+    return bitOpCoordinatorTryObjectEncodingEx(o, 1);
+}
+
+static void bitOpCoordinatorClearTypeError(bitOpCoordinator *coord) {
+    coord->type_error = 0;
+    coord->pending_reply = NULL;
+    coord->reply_kind = 0;
+}
+
