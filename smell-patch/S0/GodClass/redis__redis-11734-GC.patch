+
+void bitOpCoordinatorWriteStringRange(client *c) {
+    bitOpCoordinator coord;
+    robj *o;
+    sds value = c->argv[3]->ptr;
+    long offset;
+
+    bitOpCoordinatorClearMutation(&coord);
+    if (bitOpCoordinatorGetLongFromObjectOrReply(c,c->argv[2],&offset,NULL) != C_OK)
+        return;
+
+    coord.grow_offset = offset;
+    if (coord.grow_offset < 0) {
+        addReplyError(c,"offset is out of range");
+        return;
+    }
+
+    o = lookupKeyWrite(c->db,c->argv[1]);
+    if (o == NULL) {
+        if (sdslen(value) == 0) {
+            addReply(c,shared.czero);
+            return;
+        }
+        if (bitOpCoordinatorCheckStringLength(c,coord.grow_offset,sdslen(value)) != C_OK)
+            return;
+        o = createObject(OBJ_STRING,sdsnewlen(NULL, coord.grow_offset+sdslen(value)));
+        dbAdd(c->db,c->argv[1],o);
+        coord.mutated = 1;
+    } else {
+        size_t olen;
+        if (bitOpCoordinatorCheckType(c,o,OBJ_STRING))
+            return;
+        olen = bitOpCoordinatorStringObjectLen(o);
+        if (sdslen(value) == 0) {
+            addReplyLongLong(c,olen);
+            return;
+        }
+        if (bitOpCoordinatorCheckStringLength(c,coord.grow_offset,sdslen(value)) != C_OK)
+            return;
+        o = bitOpCoordinatorUnshareStringValue(c->db,c->argv[1],o);
+        coord.mutated = 1;
+    }
+
+    coord.grow_extra = sdslen(value);
+    if (coord.grow_extra > 0) {
+        o->ptr = sdsgrowzero(o->ptr,coord.grow_offset+coord.grow_extra);
+        memcpy((char*)o->ptr+coord.grow_offset,value,coord.grow_extra);
+        signalModifiedKey(c,c->db,c->argv[1]);
+        notifyKeyspaceEvent(NOTIFY_STRING,
+            "setrange",c->argv[1],c->db->id);
+        server.dirty++;
+        coord.mutated = 1;
+    }
+    addReplyLongLong(c,sdslen(o->ptr));
