+
+void bitOpCoordinatorSetSignedBitfield(unsigned char *p, uint64_t offset, uint64_t bits, int64_t value) {
+    bitOpCoordinator coord;
+    bitOpCoordinatorClearBitfield(&coord);
+    coord.field_offset = offset;
+    coord.field_bits = bits;
+    coord.signed_value = value;
+    coord.unsigned_value = (uint64_t) value;
+    coord.field_signed = 1;
+    bitOpCoordinatorSetUnsignedBitfield(p, coord.field_offset, coord.field_bits, coord.unsigned_value);
