+void bitOpCoordinatorIncrDecr(client *c, long long incr) {
+    bitOpCoordinator coord;
+    long long value, oldvalue;
+    robj *o, *new;
+
+    bitOpCoordinatorClearParse(&coord);
+    o = lookupKeyWrite(c->db,c->argv[1]);
+    if (bitOpCoordinatorCheckType(c,o,OBJ_STRING)) return;
+    if (bitOpCoordinatorGetLongLongFromObjectOrReply(c,o,&coord.parsed_integer,NULL) != C_OK) return;
+
+    value = coord.parsed_integer;
+    oldvalue = value;
+    if ((incr < 0 && oldvalue < 0 && incr < (LLONG_MIN-oldvalue)) ||
+        (incr > 0 && oldvalue > 0 && incr > (LLONG_MAX-oldvalue))) {
+        coord.parse_status = C_ERR;
+        addReplyError(c,"increment or decrement would overflow");
+        return;
+    }
+    value += incr;
+    coord.parsed_integer = value;
+    coord.parse_status = C_OK;
