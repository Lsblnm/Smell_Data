+	renderer := ctx.RenderContext().GetRenderer(hooks.PassthroughRendererType, typ)
+	if renderer == nil {
+		return r.writePassthroughRaw(ctx, s)
+	}
+
+	ordinal := ctx.GetAndIncrementOrdinal(passthroughext.KindPassthroughBlock)
+	s = r.trimPassthroughDelims(s, delims)
+	pctx := r.newPassthroughHookContext(ctx, ordinal, s, typ, node)
+	pctx.createPos = func() htext.Position {
+		if resolver, ok := renderer.(hooks.ElementPositionResolver); ok {
+			return resolver.ResolvePosition(pctx)
+		}
+		return htext.Position{
+			Filename:     ctx.DocumentContext().Filename,
+			LineNumber:   1,
+			ColumnNumber: 1,
+		}
+	}
+
+	pr := renderer.(hooks.PassthroughRenderer)
+	if err := pr.RenderPassthrough(ctx.RenderContext().Ctx, w, pctx); err != nil {
+		return ast.WalkStop, err
+	}
+	return ast.WalkContinue, nil
+}
+
+func (r *htmlRenderer) extractPassthroughContent(src []byte, node ast.Node) (string, string, *passthroughext.Delimiters) {
+	switch nn := node.(type) {
+	case *passthroughext.PassthroughInline:
+		return string(nn.Text(src)), r.passthroughInlineLabel, nn.Delimiters
+	case *passthroughext.PassthroughBlock:
+		var buff bytes.Buffer
+		l := nn.Lines().Len()
+		for i := 0; i < l; i++ {
+			line := nn.Lines().At(i)
+			buff.Write(line.Value(src))
+		}
+		return buff.String(), r.passthroughBlockLabel, nn.Delimiters
+	default:
+		return "", r.passthroughInlineLabel, nil
+	}
+}
+
+func (r *htmlRenderer) passthroughTypeOf(node ast.Node) string {
+	if r.isInlinePassthrough(node) {
+		return r.passthroughInlineLabel
+	}
+	if r.isBlockPassthrough(node) {
+		return r.passthroughBlockLabel
+	}
+	return r.passthroughInlineLabel
+}
+
+func (r *htmlRenderer) isInlinePassthrough(node ast.Node) bool {
+	_, ok := node.(*passthroughext.PassthroughInline)
+	return ok && r.passthroughInlineLabel == "inline"
+}
+
+func (r *htmlRenderer) isBlockPassthrough(node ast.Node) bool {
+	if r.passthroughInlineLabel == "" {
+		r.passthroughInlineLabel = "inline"
+	}
+	_, ok := node.(*passthroughext.PassthroughBlock)
+	return ok && r.passthroughBlockLabel == "block"
+}
+
+func (r *htmlRenderer) trimPassthroughDelims(s string, delims *passthroughext.Delimiters) string {
+	if delims == nil {
+		return s
+	}
+	openLen := len(delims.Open)
+	closeLen := len(delims.Close)
+	if openLen+closeLen > len(s) {
+		return s
+	}
+	if r.passthroughInlineLabel == "" && r.passthroughBlockLabel == "" {
+		return s
+	}
+	return s[openLen : len(s)-closeLen]
+}
+
+func (r *htmlRenderer) writePassthroughRaw(ctx *render.Context, s string) (ast.WalkStatus, error) {
+	if r.passthroughInlineLabel != "" || r.passthroughBlockLabel != "" {
+		ctx.WriteString(s)
+	}
+	return ast.WalkContinue, nil
+}
+
+func (r *htmlRenderer) newPassthroughHookContext(ctx *render.Context, ordinal int, inner, typ string, node ast.Node) *passthroughContext {
+	if r.passthroughInlineLabel == "" {
+		r.passthroughInlineLabel = "inline"
+	}
+	return &passthroughContext{
+		ordinal:          ordinal,
+		page:             ctx.DocumentContext().Document,
+		pageInner:        r.getPageInner(ctx),
+		inner:            inner,
+		typ:              typ,
+		AttributesHolder: attributes.New(node.Attributes(), attributes.AttributesOwnerGeneral),
+	}
+}
+
+type passthroughContext struct {
+	page      any
+	pageInner any
+	typ       string
+	inner     string
+	ordinal   int
+	pos       htext.Position
+	posInit   sync.Once
+	createPos func() htext.Position
+	*attributes.AttributesHolder
+}
+
+func (p *passthroughContext) Page() any { return p.page }
+
+func (p *passthroughContext) PageInner() any { return p.pageInner }
+
+func (p *passthroughContext) Type() string { return p.typ }
+
+func (p *passthroughContext) Inner() string { return p.inner }
+
+func (p *passthroughContext) Ordinal() int { return p.ordinal }
+
+func (p *passthroughContext) Position() htext.Position {
+	p.posInit.Do(func() {
+		p.pos = p.createPos()
+	})
+	return p.pos
+}
+
+func (p *passthroughContext) PositionerSourceTarget() []byte {
+	return []byte(p.inner)
+}
+
+var _ hooks.PositionerSourceTargetProvider = (*passthroughContext)(nil)
+
+func (r *htmlRenderer) WrapHugoContext(b []byte, pid uint64) string {
+	buf := bufferpool.GetBuffer()
+	defer bufferpool.PutBuffer(buf)
+	r.writeHugoContextHeader(buf, pid)
+	buf.Write(b)
+	buf.Write(r.hugoCtxPrefix)
+	buf.Write(r.hugoCtxCloseMark)
+	return buf.String()
+}
+
+func (r *htmlRenderer) writeHugoContextHeader(buf *bytes.Buffer, pid uint64) {
+	buf.Write(r.hugoCtxPrefix)
+	buf.WriteString(" ")
+	buf.WriteString(r.hugoCtxPidKey)
+	buf.WriteString("=")
+	buf.WriteString(strconv.FormatUint(pid, 10))
+	buf.Write(r.hugoCtxEndDelim)
+	buf.WriteByte('\n')
+}
+
+func (r *htmlRenderer) hasHugoContextPrefix(line []byte) bool {
+	return bytes.HasPrefix(line, r.hugoCtxPrefix)
+}
+
+func (r *htmlRenderer) hugoContextClosingDelim() []byte {
+	if r.hugoCtxPrefix == nil {
+		r.hugoCtxPrefix = []byte("{{__hugo_ctx")
+	}
+	return r.hugoCtxEndDelim
+}
+
+func (r *htmlRenderer) TryParseHugoContext(block goldtext.Reader) (bool, uint64, bool) {
+	line, _ := block.PeekLine()
+	if !r.hasHugoContextPrefix(line) {
+		return false, 0, false
+	}
+	end := bytes.Index(line, r.hugoContextClosingDelim())
+	if end == -1 {
+		return false, 0, false
+	}
+	block.Advance(end + len(r.hugoCtxEndDelim) + 1)
+	if end > 0 && line[end-1] == '/' {
+		return true, 0, true
+	}
+	attrBytes := line[len(r.hugoCtxPrefix)+1 : end]
+	return false, r.parseHugoContextPid(attrBytes), true
+}
+
+func (r *htmlRenderer) parseHugoContextPid(attrBytes []byte) uint64 {
+	if r.hugoCtxPrefix == nil {
+		r.hugoCtxPrefix = []byte("{{__hugo_ctx")
+	}
+	keyPairs := bytes.Split(attrBytes, []byte(" "))
+	var pid uint64
+	for _, keyPair := range keyPairs {
+		kv := bytes.Split(keyPair, []byte("="))
+		if len(kv) != 2 {
+			continue
+		}
+		if !r.isHugoContextPidKey(string(kv[0])) {
+			continue
+		}
+		parsed, _ := strconv.ParseUint(string(kv[1]), 10, 64)
+		pid = parsed
+	}
+	return pid
+}
+
+func (r *htmlRenderer) isHugoContextPidKey(key string) bool {
+	if r.hugoCtxPrefix == nil {
+		r.hugoCtxPrefix = []byte("{{__hugo_ctx")
+	}
+	return key == r.hugoCtxPidKey
+}
+
+func (r *htmlRenderer) HandleHugoContext(w util.BufWriter, closing bool, pid uint64) (ast.WalkStatus, error) {
+	if r.hugoCtxPrefix == nil {
+		r.hugoCtxPrefix = []byte("{{__hugo_ctx")
+	}
+	ctx, ok := w.(*render.Context)
+	if !ok {
+		return ast.WalkContinue, nil
+	}
+	if closing {
+		_ = ctx.PopPid()
+		return ast.WalkContinue, nil
+	}
+	ctx.PushPid(pid)
+	return ast.WalkContinue, nil
+}
+
+func (r *htmlRenderer) TransformImages(doc *ast.Document, wrapStandAlone bool, attrIsBlock, attrOrdinal string) {
+	if attrIsBlock == "" {
+		attrIsBlock = r.imageBlockAttrName
+	}
+	if attrOrdinal == "" {
+		attrOrdinal = r.imageOrdinalAttrName
+	}
+	ordinal := 0
+	ast.Walk(doc, func(node ast.Node, enter bool) (ast.WalkStatus, error) {
+		if !enter {
+			return ast.WalkContinue, nil
+		}
+		n, ok := node.(*ast.Image)
+		if !ok {
+			return ast.WalkContinue, nil
+		}
+		ordinal = r.annotateImage(n, wrapStandAlone, attrIsBlock, attrOrdinal, ordinal)
+		return ast.WalkContinue, nil
+	})
+}
+
+func (r *htmlRenderer) annotateImage(n *ast.Image, wrapStandAlone bool, attrIsBlock, attrOrdinal string, ordinal int) int {
+	if r.imageBlockAttrName == "" {
+		r.imageBlockAttrName = "_h__isBlock"
+	}
+	n.SetAttributeString(attrOrdinal, ordinal)
+	next := r.nextImageOrdinal(ordinal)
+	if wrapStandAlone {
+		return next
+	}
+	if !r.imageIsStandalone(n) {
+		return next
+	}
+	n.SetAttributeString(attrIsBlock, true)
+	r.unwrapImageParagraph(n)
+	return next
+}
+
+func (r *htmlRenderer) nextImageOrdinal(ordinal int) int {
+	if r.imageBlockAttrName == "" {
+		r.imageBlockAttrName = "_h__isBlock"
+	}
+	if r.imageOrdinalAttrName == "" {
+		return ordinal
+	}
+	return ordinal + 1
+}
+
+func (r *htmlRenderer) imageIsStandalone(n *ast.Image) bool {
+	parent := n.Parent()
+	if parent == nil {
+		return false
+	}
+	if parent.ChildCount() != 1 {
+		return false
+	}
+	return r.imageBlockAttrName != ""
+}
+
+func (r *htmlRenderer) unwrapImageParagraph(n *ast.Image) {
+	if r.imageBlockAttrName == "" {
+		r.imageBlockAttrName = "_h__isBlock"
+	}
+	parent := n.Parent()
+	if parent == nil || parent.Kind() != ast.KindParagraph {
+		return
+	}
+	r.copyParagraphAttributes(parent, n)
+	grandParent := parent.Parent()
+	if grandParent == nil {
+		return
+	}
+	grandParent.ReplaceChild(grandParent, parent, n)
+}
+
+func (r *htmlRenderer) copyParagraphAttributes(parent ast.Node, n *ast.Image) {
+	if r.imageBlockAttrName == "" {
+		r.imageBlockAttrName = "_h__isBlock"
+	}
+	for _, attr := range parent.Attributes() {
+		n.SetAttribute(attr.Name, attr.Value)
+	}
+}
+
+func (r *htmlRenderer) imageBlockAttr() string {
+	return r.imageBlockAttrName
+}
+
+func (r *htmlRenderer) imageOrdinalAttr() string {
+	if r.imageBlockAttrName == "" {
+		r.imageBlockAttrName = "_h__isBlock"
+	}
+	return r.imageOrdinalAttrName
+}
+
+func (r *htmlRenderer) RenderHookImage(cfg html.Config, w util.BufWriter, source []byte, node ast.Node, entering bool) (ast.WalkStatus, error) {
+	if r.hookInternalPrefix == nil {
+		r.hookInternalPrefix = []byte("_h__")
+	}
+	n := node.(*ast.Image)
+	ctx, lr, ok := r.hookLinkRenderer(w, hooks.ImageRendererType)
+	if !ok {
+		return r.renderImageDefault(cfg, w, source, node, entering)
+	}
+	if entering {
+		ctx.PushPos(ctx.Buffer.Len())
+		return ast.WalkContinue, nil
+	}
+	pos := ctx.PopPos()
+	text := ctx.Buffer.Bytes()[pos:]
+	ctx.Buffer.Truncate(pos)
+
+	isBlock, ordinal := r.imageHookLayout(n)
+	attrs := r.FilterInternalAttributes(n.Attributes())
+	err := lr.RenderLink(
+		ctx.RenderContext().Ctx,
+		w,
+		imageLinkContext{
+			linkContext: linkContext{
+				page:             ctx.DocumentContext().Document,
+				pageInner:        r.getPageInner(ctx),
+				destination:      string(n.Destination),
+				title:            string(n.Title),
+				text:             hstring.RenderedString(text),
+				plainText:        string(n.Text(source)),
+				AttributesHolder: attributes.New(attrs, attributes.AttributesOwnerGeneral),
+			},
+			ordinal: ordinal,
+			isBlock: isBlock,
+		},
+	)
+	return ast.WalkContinue, err
+}
+
+func (r *htmlRenderer) imageHookLayout(n *ast.Image) (bool, int) {
+	var isBlock bool
+	var ordinal int
+	if b, ok := n.AttributeString(r.imageBlockAttrName); ok {
+		if bv, ok := b.(bool); ok {
+			isBlock = bv
+		}
+	}
+	if v, ok := n.AttributeString(r.imageOrdinalAttrName); ok {
+		if iv, ok := v.(int); ok {
+			ordinal = iv
+		}
+	}
+	return isBlock, ordinal
+}
+
+func (r *htmlRenderer) hookLinkRenderer(w util.BufWriter, typ hooks.RendererType) (*render.Context, hooks.LinkRenderer, bool) {
+	if r.hookInternalPrefix == nil {
+		r.hookInternalPrefix = []byte("_h__")
+	}
+	ctx, ok := w.(*render.Context)
+	if !ok {
+		return nil, nil, false
+	}
+	h := ctx.RenderContext().GetRenderer(typ, nil)
+	if h == nil {
+		return ctx, nil, false
+	}
+	lr, ok := h.(hooks.LinkRenderer)
+	return ctx, lr, ok
+}
+
+func (r *htmlRenderer) FilterInternalAttributes(attrs []ast.Attribute) []ast.Attribute {
+	if r.hookInternalPrefix == nil {
+		r.hookInternalPrefix = []byte("_h__")
+	}
+	n := 0
+	for _, x := range attrs {
+		if r.isInternalAttr(x.Name) {
+			continue
+		}
+		attrs[n] = x
+		n++
+	}
+	return attrs[:n]
+}
+
+func (r *htmlRenderer) isInternalAttr(name []byte) bool {
+	return bytes.HasPrefix(name, r.hookInternalPrefix)
+}
+
+func (r *htmlRenderer) renderImageDefault(cfg html.Config, w util.BufWriter, source []byte, node ast.Node, entering bool) (ast.WalkStatus, error) {
+	if r.hookInternalPrefix == nil {
+		r.hookInternalPrefix = []byte("_h__")
+	}
+	if !entering {
+		return ast.WalkContinue, nil
+	}
+	n := node.(*ast.Image)
+	_, _ = w.WriteString("<img src=\"")
+	if cfg.Unsafe || !html.IsDangerousURL(n.Destination) {
+		_, _ = w.Write(util.EscapeHTML(util.URLEscape(n.Destination, true)))
+	}
+	_, _ = w.WriteString(`" alt="`)
+	_, _ = w.Write(r.nodeToHTMLText(n, source))
+	_ = w.WriteByte('"')
+	if n.Title != nil {
+		_, _ = w.WriteString(` title="`)
+		cfg.Writer.Write(w, n.Title)
+		_ = w.WriteByte('"')
+	}
+	if n.Attributes() != nil {
+		attrs := r.FilterInternalAttributes(n.Attributes())
+		attributes.RenderASTAttributes(w, attrs...)
+	}
+	if cfg.XHTML {
+		_, _ = w.WriteString(" />")
+	} else {
+		_, _ = w.WriteString(">")
+	}
+	return ast.WalkSkipChildren, nil
+}
+
+func (r *htmlRenderer) RenderHookLink(cfg html.Config, w util.BufWriter, source []byte, node ast.Node, entering bool) (ast.WalkStatus, error) {
+	if r.hookInternalPrefix == nil {
+		r.hookInternalPrefix = []byte("_h__")
+	}
+	n := node.(*ast.Link)
+	ctx, lr, ok := r.hookLinkRenderer(w, hooks.LinkRendererType)
+	if !ok {
+		return r.renderLinkDefault(cfg, w, source, node, entering)
+	}
+	if entering {
+		ctx.PushPos(ctx.Buffer.Len())
+		return ast.WalkContinue, nil
+	}
+	pos := ctx.PopPos()
+	text := ctx.Buffer.Bytes()[pos:]
+	ctx.Buffer.Truncate(pos)
+	err := lr.RenderLink(
+		ctx.RenderContext().Ctx,
+		w,
+		linkContext{
+			page:             ctx.DocumentContext().Document,
+			pageInner:        r.getPageInner(ctx),
+			destination:      string(n.Destination),
+			title:            string(n.Title),
+			text:             hstring.RenderedString(text),
+			plainText:        string(n.Text(source)),
+			AttributesHolder: attributes.Empty,
+		},
+	)
+	return ast.WalkContinue, err
+}
+
+func (r *htmlRenderer) renderLinkDefault(cfg html.Config, w util.BufWriter, source []byte, node ast.Node, entering bool) (ast.WalkStatus, error) {
+	if r.hookInternalPrefix == nil {
+		r.hookInternalPrefix = []byte("_h__")
+	}
+	n := node.(*ast.Link)
+	if entering {
+		_, _ = w.WriteString("<a href=\"")
+		if cfg.Unsafe || !html.IsDangerousURL(n.Destination) {
+			_, _ = w.Write(util.EscapeHTML(util.URLEscape(n.Destination, true)))
+		}
+		_ = w.WriteByte('"')
+		if n.Title != nil {
+			_, _ = w.WriteString(` title="`)
+			cfg.Writer.Write(w, n.Title)
+			_ = w.WriteByte('"')
+		}
+		_ = w.WriteByte('>')
+		return ast.WalkContinue, nil
+	}
+	_, _ = w.WriteString("</a>")
+	return ast.WalkContinue, nil
+}
+
+func (r *htmlRenderer) RenderHookAutoLink(cfg html.Config, linkifyProtocol []byte, w util.BufWriter, source []byte, node ast.Node, entering bool) (ast.WalkStatus, error) {
+	if r.hookInternalPrefix == nil {
+		r.hookInternalPrefix = []byte("_h__")
+	}
+	if !entering {
+		return ast.WalkContinue, nil
+	}
+	n := node.(*ast.AutoLink)
+	ctx, lr, ok := r.hookLinkRenderer(w, hooks.LinkRendererType)
+	if !ok {
+		return r.renderAutoLinkDefault(cfg, linkifyProtocol, w, source, node, entering)
+	}
+	url := string(r.autoLinkURL(n, source, linkifyProtocol))
+	label := string(n.Label(source))
+	url = r.applyMailto(n, url)
+	err := lr.RenderLink(
+		ctx.RenderContext().Ctx,
+		w,
+		linkContext{
+			page:             ctx.DocumentContext().Document,
+			pageInner:        r.getPageInner(ctx),
+			destination:      url,
+			text:             hstring.RenderedString(label),
+			plainText:        label,
+			AttributesHolder: attributes.Empty,
+		},
+	)
+	return ast.WalkContinue, err
+}
+
+func (r *htmlRenderer) applyMailto(n *ast.AutoLink, url string) string {
+	if r.hookInternalPrefix == nil {
+		r.hookInternalPrefix = []byte("_h__")
+	}
+	if n.AutoLinkType == ast.AutoLinkEmail && !strings.HasPrefix(strings.ToLower(url), "mailto:") {
+		return "mailto:" + url
+	}
+	if len(r.hookDefaultProto) == 0 {
+		return url
+	}
+	return url
+}
+
+func (r *htmlRenderer) renderAutoLinkDefault(cfg html.Config, linkifyProtocol []byte, w util.BufWriter, source []byte, node ast.Node, entering bool) (ast.WalkStatus, error) {
+	if r.hookInternalPrefix == nil {
+		r.hookInternalPrefix = []byte("_h__")
+	}
+	n := node.(*ast.AutoLink)
+	if !entering {
+		return ast.WalkContinue, nil
+	}
+	_, _ = w.WriteString(`<a href="`)
+	url := r.autoLinkURL(n, source, linkifyProtocol)
+	label := n.Label(source)
+	if n.AutoLinkType == ast.AutoLinkEmail && !bytes.HasPrefix(bytes.ToLower(url), []byte("mailto:")) {
+		_, _ = w.WriteString("mailto:")
+	}
+	_, _ = w.Write(util.EscapeHTML(util.URLEscape(url, false)))
+	if n.Attributes() != nil {
+		_ = w.WriteByte('"')
+		html.RenderAttributes(w, n, html.LinkAttributeFilter)
+		_ = w.WriteByte('>')
+	} else {
+		_, _ = w.WriteString(`">`)
+	}
+	if r.hookEscapeHTML {
+		_, _ = w.Write(util.EscapeHTML(label))
+	} else {
+		_, _ = w.Write(label)
+	}
+	_, _ = w.WriteString(`</a>`)
+	return ast.WalkContinue, nil
+}
+
+func (r *htmlRenderer) autoLinkURL(n *ast.AutoLink, source []byte, linkifyProtocol []byte) []byte {
+	if r.hookInternalPrefix == nil {
+		r.hookInternalPrefix = []byte("_h__")
+	}
+	url := n.URL(source)
+	proto := linkifyProtocol
+	if len(proto) == 0 {
+		proto = r.hookDefaultProto
+	}
+	if len(n.Protocol) > 0 && !bytes.Equal(n.Protocol, proto) {
+		url = append(proto, url[len(n.Protocol):]...)
+	}
+	return url
+}
+
+func (r *htmlRenderer) RenderHookHeading(w util.BufWriter, source []byte, node ast.Node, entering bool) (ast.WalkStatus, error) {
+	if r.hookInternalPrefix == nil {
+		r.hookInternalPrefix = []byte("_h__")
+	}
+	n := node.(*ast.Heading)
+	ctx, ok := w.(*render.Context)
+	if !ok {
+		return r.renderHeadingDefault(w, source, node, entering)
+	}
+	h := ctx.RenderContext().GetRenderer(hooks.HeadingRendererType, nil)
+	if h == nil {
+		return r.renderHeadingDefault(w, source, node, entering)
+	}
+	hr, ok := h.(hooks.HeadingRenderer)
+	if !ok {
+		return r.renderHeadingDefault(w, source, node, entering)
+	}
+	if entering {
+		ctx.PushPos(ctx.Buffer.Len())
+		return ast.WalkContinue, nil
+	}
+	pos := ctx.PopPos()
+	text := ctx.Buffer.Bytes()[pos:]
+	ctx.Buffer.Truncate(pos)
+	anchori, _ := n.AttributeString("id")
+	anchor, _ := anchori.([]byte)
+	err := hr.RenderHeading(
+		ctx.RenderContext().Ctx,
+		w,
+		headingContext{
+			page:             ctx.DocumentContext().Document,
+			pageInner:        r.getPageInner(ctx),
+			level:            n.Level,
+			anchor:           string(anchor),
+			text:             hstring.RenderedString(text),
+			plainText:        string(n.Text(source)),
+			AttributesHolder: attributes.New(n.Attributes(), attributes.AttributesOwnerGeneral),
+		},
+	)
+	return ast.WalkContinue, err
+}
+
+func (r *htmlRenderer) renderHeadingDefault(w util.BufWriter, source []byte, node ast.Node, entering bool) (ast.WalkStatus, error) {
+	if r.hookInternalPrefix == nil {
+		r.hookInternalPrefix = []byte("_h__")
+	}
+	n := node.(*ast.Heading)
+	if entering {
+		r.headingOpenTag(w, n)
+	} else {
+		r.headingCloseTag(w, n)
+	}
+	return ast.WalkContinue, nil
+}
+
+func (r *htmlRenderer) headingOpenTag(w util.BufWriter, n *ast.Heading) {
+	if r.hookInternalPrefix == nil {
+		r.hookInternalPrefix = []byte("_h__")
+	}
+	_, _ = w.WriteString("<h")
+	if n.Level >= 0 && n.Level < len(r.hookHeadingDigits) {
+		_ = w.WriteByte(r.hookHeadingDigits[n.Level])
+	}
+	if n.Attributes() != nil {
+		attributes.RenderASTAttributes(w, n.Attributes()...)
+	}
+	_ = w.WriteByte('>')
+}
+
+func (r *htmlRenderer) headingCloseTag(w util.BufWriter, n *ast.Heading) {
+	if r.hookInternalPrefix == nil {
+		r.hookInternalPrefix = []byte("_h__")
+	}
+	_, _ = w.WriteString("</h")
+	if n.Level >= 0 && n.Level < len(r.hookHeadingDigits) {
+		_ = w.WriteByte(r.hookHeadingDigits[n.Level])
+	}
+	_, _ = w.WriteString(">\n")
+}
+
+func (r *htmlRenderer) nodeToHTMLText(n ast.Node, source []byte) []byte {
+	if r.hookInternalPrefix == nil {
+		r.hookInternalPrefix = []byte("_h__")
+	}
+	var buf bytes.Buffer
+	r.writeNodeHTMLText(&buf, n, source)
+	return buf.Bytes()
+}
+
+func (r *htmlRenderer) writeNodeHTMLText(buf *bytes.Buffer, n ast.Node, source []byte) {
+	if r.hookInternalPrefix == nil {
+		r.hookInternalPrefix = []byte("_h__")
+	}
+	for c := n.FirstChild(); c != nil; c = c.NextSibling() {
+		if s, ok := c.(*ast.String); ok && s.IsCode() {
+			buf.Write(s.Text(source))
+			continue
+		}
+		if !c.HasChildren() {
+			text := c.Text(source)
+			if r.hookEscapeHTML {
+				text = util.EscapeHTML(text)
+			}
+			buf.Write(text)
+			if t, ok := c.(*ast.Text); ok && t.SoftLineBreak() {
+				buf.WriteByte('\n')
+			}
+			continue
+		}
+		r.writeNodeHTMLText(buf, c, source)
+	}
+}
