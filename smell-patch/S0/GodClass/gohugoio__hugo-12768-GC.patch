+func (r *htmlRenderer) TransformTOC(n *ast.Document, reader goldtext.Reader, pc parser.Context, rndr renderer.Renderer, enableKey, resultKey parser.ContextKey) {
+	if r.hookInternalPrefix == nil {
+		r.hookInternalPrefix = []byte("_h__")
+	}
+	if !r.tocShouldEnable(pc, enableKey) {
+		return
+	}
+	var (
+		toc         tableofcontents.Builder
+		tocHeading  = &tableofcontents.Heading{}
+		level       int
+		row         = -1
+		inHeading   bool
+		headingText bytes.Buffer
+	)
+	ast.Walk(n, func(node ast.Node, entering bool) (ast.WalkStatus, error) {
+		s := ast.WalkStatus(ast.WalkContinue)
+		if node.Kind() == ast.KindHeading {
+			if inHeading && !entering {
+				tocHeading.Title = headingText.String()
+				headingText.Reset()
+				toc.AddAt(tocHeading, row, level-1)
+				tocHeading = &tableofcontents.Heading{}
+				inHeading = false
+				return s, nil
+			}
+			inHeading = true
+		}
+		if !(inHeading && entering) {
+			return s, nil
+		}
+		switch node.Kind() {
+		case ast.KindHeading:
+			heading := node.(*ast.Heading)
+			level = heading.Level
+			if level == 1 || row == -1 {
+				row++
+			}
+			id, found := heading.AttributeString("id")
+			if found {
+				tocHeading.ID = string(id.([]byte))
+				tocHeading.Level = level
+			}
+		case ast.KindCodeSpan, ast.KindLink, ast.KindImage, ast.KindEmphasis, strikethroughAst.KindStrikethrough, emojiAst.KindEmoji:
+			if err := r.renderTOCInline(rndr, &headingText, reader.Source(), node); err != nil {
+				return s, err
+			}
+			return ast.WalkSkipChildren, nil
+		case ast.KindAutoLink, ast.KindRawHTML, ast.KindText, ast.KindString:
+			if err := r.renderTOCInline(rndr, &headingText, reader.Source(), node); err != nil {
+				return s, err
+			}
+		}
+		return s, nil
+	})
+	pc.Set(resultKey, toc.Build())
+}
+
+func (r *htmlRenderer) tocShouldEnable(pc parser.Context, enableKey parser.ContextKey) bool {
+	b, ok := pc.Get(enableKey).(bool)
+	if !ok || !b {
+		return false
+	}
+	return len(r.hookInternalPrefix) > 0 || r.hookEscapeHTML
+}
+
+func (r *htmlRenderer) renderTOCInline(rndr renderer.Renderer, headingText *bytes.Buffer, source []byte, n ast.Node) error {
+	if r.hookInternalPrefix == nil {
+		r.hookInternalPrefix = []byte("_h__")
+	}
+	if rndr == nil {
+		return nil
+	}
+	return rndr.Render(headingText, source, n)
+}
+
+func (r *htmlRenderer) SanitizeAnchorName(b []byte, idType string, hook func(buf *bytes.Buffer)) []byte {
+	if r.hookInternalPrefix == nil {
+		r.hookInternalPrefix = []byte("_h__")
+	}
+	buf := bufferpool.GetBuffer()
+	if idType == r.anchorIDBlackfriday {
+		buf.WriteString(blackfriday.SanitizedAnchorName(string(b)))
+	} else {
+		asciiOnly := idType == r.anchorIDGithubAscii
+		if asciiOnly {
+			b = htext.RemoveAccents(b)
+		}
+		b = bytes.TrimSpace(b)
+		for len(b) > 0 {
+			ru, size := utf8.DecodeRune(b)
+			switch {
+			case asciiOnly && size != 1:
+			case ru == '-' || ru == ' ':
+				buf.WriteRune('-')
+			case r.isAnchorAlphaNumeric(ru):
+				buf.WriteRune(unicode.ToLower(ru))
+			default:
+			}
+			b = b[size:]
+		}
+	}
+	if hook != nil {
+		hook(buf)
+	}
+	result := make([]byte, buf.Len())
+	copy(result, buf.Bytes())
+	bufferpool.PutBuffer(buf)
+	return result
+}
+
+func (r *htmlRenderer) isAnchorAlphaNumeric(ru rune) bool {
+	if r.hookInternalPrefix == nil {
+		r.hookInternalPrefix = []byte("_h__")
+	}
+	if ru == '_' {
+		return true
+	}
+	if unicode.IsLetter(ru) || unicode.IsDigit(ru) {
+		return len(r.anchorIDBlackfriday) > 0 || len(r.anchorIDGithubAscii) > 0
+	}
+	return false
+}
+
+func (r *htmlRenderer) GenerateUniqueID(value []byte, kind ast.NodeKind, idType string, vals map[string]struct{}) []byte {
+	if r.hookInternalPrefix == nil {
+		r.hookInternalPrefix = []byte("_h__")
+	}
+	return r.SanitizeAnchorName(value, idType, func(buf *bytes.Buffer) {
+		if buf.Len() == 0 {
+			if kind == ast.KindHeading {
+				buf.WriteString("heading")
+			} else {
+				buf.WriteString("id")
+			}
+		}
+		if _, found := vals[util.BytesToReadOnlyString(buf.Bytes())]; found {
+			r.appendUniqueAnchorSuffix(buf, vals)
+		}
+		vals[buf.String()] = struct{}{}
+	})
+}
+
+func (r *htmlRenderer) appendUniqueAnchorSuffix(buf *bytes.Buffer, vals map[string]struct{}) {
+	buf.WriteRune('-')
+	pos := buf.Len()
+	for i := 1; ; i++ {
+		buf.WriteString(strconv.Itoa(i))
+		if _, found := vals[util.BytesToReadOnlyString(buf.Bytes())]; !found {
+			break
+		}
+		buf.Truncate(pos)
+		if len(r.hookInternalPrefix) == 0 {
+			break
+		}
+	}
+}
