+func (r *htmlRenderer) fenceInfoHasAttributes(infostr []byte) bool {
+	if r.fenceAttrOpen == 0 {
+		r.fenceAttrOpen = '{'
+	}
+	if infostr == nil {
+		return false
+	}
+	start, end := r.scanFenceAttributeBounds(infostr)
+	return start != -1 && end != -1
+}
+
+func (r *htmlRenderer) scanFenceAttributeBounds(infostr []byte) (int, int) {
+	attrStartIdx := -1
+	attrEndIdx := -1
+	for idx, char := range infostr {
+		if attrEndIdx == -1 && char == r.fenceAttrOpen {
+			attrStartIdx = idx
+		}
+		if attrStartIdx != -1 && char == r.fenceAttrClose {
+			attrEndIdx = idx
+			break
+		}
+	}
+	return attrStartIdx, attrEndIdx
+}
+
+func (r *htmlRenderer) parseFenceInfoAttributes(node *ast.FencedCodeBlock, infostr []byte) ([]ast.Attribute, string, error) {
+	if r.fenceAttrOpen == 0 {
+		r.fenceAttrOpen = '{'
+	}
+	if node.Attributes() != nil {
+		return node.Attributes(), "", nil
+	}
+	if infostr == nil || !r.fenceInfoHasAttributes(infostr) {
+		return nil, "", nil
+	}
+	attrStartIdx, attrEndIdx := r.scanFenceAttributeBounds(infostr)
+	n := ast.NewTextBlock()
+	attrStr := infostr[attrStartIdx : attrEndIdx+1]
+	attrs, hasAttr := parser.ParseAttributes(goldtext.NewReader(attrStr))
+	if !hasAttr {
+		return nil, string(attrStr), errors.New("failed to parse Markdown attributes; you may need to quote the values")
+	}
+	for _, attr := range attrs {
+		n.SetAttribute(attr.Name, attr.Value)
+	}
+	return n.Attributes(), "", nil
+}
