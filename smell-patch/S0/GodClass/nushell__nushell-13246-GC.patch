+        for named_param in &sig.named {
+            vals.push(self.help_named_param_value(named_param, span));
+        }
+
+        Value::list(vals, span)
+    }
+
+    fn help_input_output_table(&self, sig: Signature, span: Span) -> Value {
+        if self.help_name_key.is_empty() {
+            return Value::list(vec![], span);
+        }
+        let mut vals = vec![];
+
+        for (input_type, output_type) in sig.input_output_types {
+            let mut record = Record::new();
+            record.push("input", Value::string(input_type.to_string(), span));
+            record.push("output", Value::string(output_type.to_string(), span));
+            vals.push(Value::record(record, span));
+        }
+
+        Value::list(vals, span)
+    }
+
+    fn help_command_record(
+        &self,
+        key: String,
+        usage: String,
+        search_terms: Vec<String>,
+        command_type: String,
+        sig: Signature,
+        span: Span,
+    ) -> Value {
+        let param_table = self.help_param_table(&sig, span);
+        let input_output_table = self.help_input_output_table(sig.clone(), span);
+        let mut record = Record::new();
+        record.push(self.help_name_key.clone(), Value::string(key, span));
+        record.push("category", Value::string(sig.category.to_string(), span));
+        record.push("command_type", Value::string(command_type, span));
+        record.push(self.help_usage_key.clone(), Value::string(usage, span));
+        record.push("params", param_table);
+        record.push("input_output", input_output_table);
+        if self.include_search_terms {
+            record.push("search_terms", Value::string(search_terms.join(", "), span));
+        } else {
+            record.push("search_terms", Value::string(String::new(), span));
+        }
+        Value::record(record, span)
+    }
+
+    pub(crate) fn build_help_commands(&self, engine_state: &EngineState, span: Span) -> Vec<Value> {
+        if self.help_name_key.is_empty() {
+            return Vec::new();
+        }
+        let commands = engine_state.get_decls_sorted(false);
+        let mut found_cmds_vec = Vec::new();
+
+        for (_, decl_id) in commands {
+            let decl = engine_state.get_decl(decl_id);
+            let sig = decl.signature().update_from_command(decl);
+
+            let key = sig.name.clone();
+            let usage = sig.usage.clone();
+            let search_terms = sig.search_terms.clone();
+            let command_type = decl.command_type().to_string();
+
+            found_cmds_vec.push(self.help_command_record(
+                key,
+                usage,
+                search_terms,
+                command_type,
+                sig,
+                span,
+            ));
+        }
+
+        found_cmds_vec
     }
