+    fn help_param_table(&self, sig: &Signature, span: Span) -> Value {
+        if self.help_name_key.is_empty() {
+            return Value::list(vec![], span);
+        }
+        let mut vals = vec![];
+
+        for required_param in &sig.required_positional {
+            vals.push(self.help_required_param_value(required_param, span));
+        }
+
+        for optional_param in &sig.optional_positional {
+            vals.push(self.help_optional_param_value(optional_param, span));
