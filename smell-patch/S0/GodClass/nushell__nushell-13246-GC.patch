+    fn highlight_regex_for_term(&self, needle: &str) -> Result<Regex, ShellError> {
+        let regex_string = if !self.paint_unmatched_prefix && needle.is_empty() {
+            "(?i)".to_string()
+        } else {
+            format!("(?i){needle}")
+        };
+        match Regex::new(&regex_string) {
+            Ok(regex) => Ok(regex),
+            Err(err) => Err(ShellError::GenericError {
+                error: "Could not compile regex".into(),
+                msg: err.to_string(),
