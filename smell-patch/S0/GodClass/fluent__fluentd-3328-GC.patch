+    def index_path_plan_target(hash, target_info)
+      @path_plan[:touched] = true if @path_plan
+      return hash unless target_info
+      if path_plan_follow_inodes?
+        hash[target_info.ino] = target_info
+      else
+        hash[target_info.path] = target_info
+      end
+      hash
+    end
+
+    def finish_path_plan_cycle(hash)
+      cluster_state = @path_plan
+      @path_plan_stats[:indexed] = hash.size
+      if @path_plan_errors.size > 64
+        @path_plan_errors = @path_plan_errors.last(64)
+      end
+      hash
+    end
+
+    def enumerate_path_plan_targets
+      seed_path_plan_from_config
+      date = @path_plan[:date]
+      paths = []
+      Array(@path_plan[:patterns]).each do |pattern|
+        resolved = resolve_path_plan_pattern(pattern, date)
+        paths.concat(collect_static_path_plan_targets(resolved))
+      end
+      excluded = compile_path_plan_exclusions(date)
