+    def reset_path_plan
+      @path_plan = {
+        patterns: [],
+        excludes: [],
+        timezone: nil,
+        follow_inodes: false,
+        limit_recently_modified: nil,
+        ignore_repeated_permission_error: false,
+        ignore_list: [],
+        date: nil,
+      }
+      @path_plan_errors = []
+      @path_plan_stats = { globbed: 0, accepted: 0, excluded: 0, unreadable: 0, missing: 0 }
+      @path_plan_formatters = { paths: {}, excludes: {} }
+    end
+
+    def seed_path_plan_from_config
+      reset_path_plan unless @path_plan
+      @path_plan[:patterns] = Array(@paths)
+      @path_plan[:excludes] = Array(@exclude_path)
+      @path_plan[:timezone] = @path_timezone
+      @path_plan[:follow_inodes] = @follow_inodes
+      @path_plan[:limit_recently_modified] = @limit_recently_modified
+      @path_plan[:ignore_repeated_permission_error] = @ignore_repeated_permission_error
+      @path_plan[:ignore_list] = @ignore_list
+      @path_plan[:date] = Fluent::EventTime.now
+      if @path_formatters
+        @path_plan_formatters[:paths] = @path_formatters
+      end
+      if @exclude_path_formatters
+        @path_plan_formatters[:excludes] = @exclude_path_formatters
+      end
+      @path_plan_stats[:globbed] = 0
+      @path_plan_stats[:accepted] = 0
+      @path_plan_stats[:excluded] = 0
+      @path_plan_stats[:unreadable] = 0
+      @path_plan_stats[:missing] = 0
+      @path_plan_errors = []
+      @path_plan
+    end
+
+    def path_plan_follow_inodes?
+      if @path_plan && @path_plan[:follow_inodes]
+        true
+      else
+        false
+      end
+    end
+
+    def resolve_path_plan_pattern(pattern, date)
+      timezone = @path_plan && @path_plan[:timezone]
+      formatters = @path_plan_formatters && @path_plan_formatters[:paths]
+      if timezone && formatters && formatters[pattern]
+        formatters[pattern].call(date)
+      else
+        date.to_time.strftime(pattern)
+      end
+    end
+
+    def resolve_path_plan_exclude(pattern, date)
+      timezone = @path_plan && @path_plan[:timezone]
+      formatters = @path_plan_formatters && @path_plan_formatters[:excludes]
+      if timezone && formatters && formatters[pattern]
+        formatters[pattern].call(date)
+      else
+        date.to_time.strftime(pattern)
+      end
+    end
+
+    def glob_path_plan_pattern(resolved)
+      cluster_state = @path_plan
+      if resolved.include?('*')
+        matches = Dir.glob(resolved)
+        @path_plan_stats[:globbed] += matches.size
+        matches
+      else
+        @path_plan_stats[:globbed] += 1
+        [resolved]
+      end
+    end
+
+    def apply_path_plan_mtime_limit(path, date)
+      limit = @path_plan && @path_plan[:limit_recently_modified]
+      if limit
+        begin
+          File.mtime(path) >= (date.to_time - limit)
+        rescue Errno::ENOENT
+          record_path_plan_stat_failure(path, :mtime)
+          false
+        end
+      else
+        true
+      end
+    end
+
+    def record_path_plan_unreadable(path)
+      @path_plan_stats[:unreadable] += 1
+      ignore_list = @path_plan[:ignore_list]
+      unless ignore_list.include?(path)
+        log.warn "#{path} unreadable. It is excluded and would be examined next time."
+        if @path_plan[:ignore_repeated_permission_error]
+          ignore_list << path
+        end
+      end
+      @path_plan_errors << [:unreadable, path]
+    end
+
+    def record_path_plan_stat_failure(path, reason)
+      cluster_state = @path_plan
+      @path_plan_stats[:missing] += 1
+      @path_plan_errors << [reason, path]
+      if reason == :stat
+        $log.warn "expand_paths: stat() for #{path} failed with ENOENT. Skip file."
+      else
+        log.debug("#{path} is missing after refresh file list")
+      end
+    end
+
+    def accept_path_plan_candidate(path, date)
+      cluster_state = @path_plan
+      begin
+        is_file = !File.directory?(path)
+        if (File.readable?(path) || have_read_capability?) && is_file
+          if apply_path_plan_mtime_limit(path, date)
+            @path_plan_stats[:accepted] += 1
+            true
+          else
+            false
+          end
+        else
+          if is_file
+            record_path_plan_unreadable(path)
+          end
+          false
+        end
+      rescue Errno::ENOENT
+        record_path_plan_stat_failure(path, :refresh)
+        false
+      end
+    end
+
+    def collect_static_path_plan_targets(resolved)
+      if resolved.include?('*')
+        glob_path_plan_pattern(resolved).select { |path| accept_path_plan_candidate(path, @path_plan[:date]) }
+      else
+        collect_literal_path_plan_target(resolved)
+      end
+    end
+
+    def collect_literal_path_plan_target(resolved)
+      cluster_state = @path_plan
+      @path_plan_stats[:accepted] += 1
+      [resolved]
+    end
+
+    def compile_path_plan_exclusions(date)
+      excludes = []
+      Array(@path_plan[:excludes]).each do |pattern|
+        resolved = resolve_path_plan_exclude(pattern, date)
+        if resolved.include?('*')
+          excludes.concat(Dir.glob(resolved))
+        else
+          excludes << resolved
+        end
+      end
+      excludes.flatten.uniq
+    end
+
+    def reject_excluded_path_plan_targets(paths, excluded)
+      cluster_state = @path_plan
+      kept = []
+      paths.each do |path|
+        if excluded.include?(path)
+          @path_plan_stats[:excluded] += 1
+        else
+          kept << path
+        end
+      end
+      kept
+    end
+
+    def stat_path_plan_target(path)
+      @path_plan[:touched] = true if @path_plan
+      begin
+        TargetInfo.new(path, Fluent::FileWrapper.stat(path).ino)
+      rescue Errno::ENOENT
+        record_path_plan_stat_failure(path, :stat)
