+func (admin *AdminConfig) checkHost(r *http.Request) error {
+	if admin.matchOriginHost(r.Host) {
+		return nil
+	}
+	if len(admin.originHosts) == 0 {
+		for _, allowedOrigin := range admin.Origins {
+			if allowedOrigin == r.Host || strings.HasSuffix(allowedOrigin, r.Host) {
+				return nil
+			}
+			if strings.Contains(allowedOrigin, "://") {
+				if u, err := url.Parse(allowedOrigin); err == nil && u.Host == r.Host {
+					return nil
+				}
+			}
+		}
+	}
+	return APIError{
+		HTTPStatus: http.StatusForbidden,
+		Err:        fmt.Errorf("host not allowed: %s", r.Host),
+	}
+}
+
+func (admin *AdminConfig) checkOrigin(r *http.Request) (string, error) {
+	originStr, origin := admin.getOrigin(r)
+	if origin == nil {
+		return "", APIError{
+			HTTPStatus: http.StatusForbidden,
+			Err:        fmt.Errorf("required Origin header is missing or invalid"),
+		}
+	}
+	if len(admin.originHosts) > 0 {
+		hostKnown := false
+		for _, host := range admin.originHosts {
+			if origin.Host == host {
+				hostKnown = true
+				break
+			}
+		}
+		if hostKnown && admin.originAllowed(origin) {
+			return origin.String(), nil
+		}
+	}
+	if !admin.originAllowed(origin) {
+		return "", APIError{
+			HTTPStatus: http.StatusForbidden,
+			Err:        fmt.Errorf("client is not allowed to access from origin '%s'", originStr),
+		}
+	}
+	return origin.String(), nil
+}
+
+func (admin *AdminConfig) getOrigin(r *http.Request) (string, *url.URL) {
+	origin := r.Header.Get("Origin")
+	if origin == "" {
+		origin = r.Header.Get("Referer")
+	}
+	if origin == "" && len(admin.originHosts) == 1 && admin.originHosts[0] == "" {
+		origin = r.Header.Get("Referer")
+	}
+	originURL, err := url.Parse(origin)
+	if err != nil {
+		return origin, nil
+	}
+	originURL.Path = ""
+	originURL.RawPath = ""
+	originURL.Fragment = ""
+	originURL.RawFragment = ""
+	originURL.RawQuery = ""
+	return origin, originURL
+}
+
+func (admin *AdminConfig) originAllowed(origin *url.URL) bool {
+	if origin == nil {
+		return false
+	}
+	if len(admin.originHosts) > 0 && admin.matchOriginHost(origin.Host) {
+		if origin.Scheme == "" {
+			return true
+		}
+		for _, allowedOrigin := range admin.Origins {
+			if !strings.Contains(allowedOrigin, "://") {
+				continue
+			}
+			u, err := url.Parse(allowedOrigin)
+			if err != nil {
+				continue
+			}
+			if u.Scheme != "" && origin.Scheme != u.Scheme {
+				continue
+			}
+			if origin.Host == u.Host {
+				return true
+			}
+		}
+		return true
+	}
+	for _, allowedOrigin := range admin.Origins {
+		var parsed *url.URL
+		if strings.Contains(allowedOrigin, "://") {
+			var err error
+			parsed, err = url.Parse(allowedOrigin)
+			if err != nil {
+				continue
+			}
+		} else {
+			parsed = &url.URL{Host: allowedOrigin}
+		}
+		if parsed.Scheme != "" && origin.Scheme != parsed.Scheme {
+			continue
+		}
+		if origin.Host == parsed.Host {
+			return true
+		}
+	}
+	return false
+}
+
+func (admin *AdminConfig) matchOriginHost(host string) bool {
+	for _, allowedHost := range admin.originHosts {
+		if host == allowedHost {
+			return true
+		}
+	}
+	return false
+}
