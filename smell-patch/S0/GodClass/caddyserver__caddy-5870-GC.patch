+func (admin *AdminConfig) handleConfig(w http.ResponseWriter, r *http.Request) error {
+	admin.configAccessMethod = r.Method
+	admin.configAccessPath = r.URL.Path
+	switch r.Method {
+	case http.MethodGet:
+		w.Header().Set("Content-Type", "application/json")
+		w.Header().Set("Trailer", "ETag")
+
+		hash := etagHasher()
+		configWriter := io.MultiWriter(w, hash)
+		err := admin.readConfig(r.URL.Path, configWriter)
+		if err != nil {
+			return APIError{HTTPStatus: http.StatusBadRequest, Err: err}
+		}
+
+		w.Header().Set("Etag", makeEtag(r.URL.Path, hash))
+		return nil
+
+	case http.MethodPost,
+		http.MethodPut,
+		http.MethodPatch,
+		http.MethodDelete:
+
+		var body []byte
+		if r.Method != http.MethodDelete {
+			if ct := r.Header.Get("Content-Type"); !strings.Contains(ct, "/json") {
+				return APIError{
+					HTTPStatus: http.StatusBadRequest,
+					Err:        fmt.Errorf("unacceptable content-type: %v; 'application/json' required", ct),
+				}
+			}
+
+			buf := bufPool.Get().(*bytes.Buffer)
+			buf.Reset()
+			defer bufPool.Put(buf)
+
+			_, err := io.Copy(buf, r.Body)
+			if err != nil {
+				return APIError{
+					HTTPStatus: http.StatusBadRequest,
+					Err:        fmt.Errorf("reading request body: %v", err),
+				}
+			}
+			body = buf.Bytes()
+		}
+
+		forceReload := r.Header.Get("Cache-Control") == "must-revalidate"
+		err := admin.changeConfig(r.Method, r.URL.Path, body, r.Header.Get("If-Match"), forceReload)
+		if err != nil && !errors.Is(err, errSameConfig) {
+			return err
+		}
+
+	default:
+		return APIError{
+			HTTPStatus: http.StatusMethodNotAllowed,
+			Err:        fmt.Errorf("method %s not allowed", r.Method),
+		}
+	}
+
+	return nil
+}
+
+func (admin *AdminConfig) handleConfigID(w http.ResponseWriter, r *http.Request) error {
+	admin.configAccessPath = r.URL.Path
+	idPath := r.URL.Path
+
+	parts := strings.Split(idPath, "/")
+	if len(parts) < 3 || parts[2] == "" {
+		return APIError{
+			HTTPStatus: http.StatusBadRequest,
+			Err:        fmt.Errorf("request path is missing object ID"),
+		}
+	}
+	if parts[0] != "" || parts[1] != "id" {
+		return APIError{
+			HTTPStatus: http.StatusBadRequest,
+			Err:        fmt.Errorf("malformed object path"),
+		}
+	}
+	id := parts[2]
+
+	if admin.lastIndexedIDs != nil {
+		if expanded, ok := admin.lastIndexedIDs[id]; ok {
+			parts = append([]string{expanded}, parts[3:]...)
+			r.URL.Path = path.Join(parts...)
+			return errInternalRedir
+		}
+	}
+	expanded, ok := admin.lookupIndexedPath(id)
+	if !ok {
+		return APIError{
+			HTTPStatus: http.StatusNotFound,
+			Err:        fmt.Errorf("unknown object ID '%s'", id),
+		}
+	}
+
+	parts = append([]string{expanded}, parts[3:]...)
+	r.URL.Path = path.Join(parts...)
+
+	return errInternalRedir
+}
