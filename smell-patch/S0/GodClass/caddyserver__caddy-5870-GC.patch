+func (admin *AdminConfig) serveAdminHTTP(w http.ResponseWriter, r *http.Request, h adminHandler) {
+	if h.remoteControl != nil {
+		var err error
+		if admin.Remote != nil {
+			err = admin.enforceRemoteAccess(r)
+		} else {
+			err = h.remoteControl.enforceAccessControls(r)
+		}
+		if err != nil {
+			h.handleError(w, r, err)
+			return
+		}
+	}
+
+	if strings.Contains(r.Header.Get("Upgrade"), "websocket") {
+		h.handleError(w, r, fmt.Errorf("websocket connections aren't allowed"))
+		return
+	}
+
+	if h.enforceHost {
+		err := admin.checkHost(r)
+		if err != nil {
+			h.handleError(w, r, err)
+			return
+		}
+	}
+
+	if h.enforceOrigin {
+		origin, err := admin.checkOrigin(r)
+		if err != nil {
+			h.handleError(w, r, err)
+			return
+		}
+
+		if r.Method == http.MethodOptions {
+			w.Header().Set("Access-Control-Allow-Methods", "OPTIONS, GET, POST, PUT, PATCH, DELETE")
+			w.Header().Set("Access-Control-Allow-Headers", "Content-Type, Content-Length, Cache-Control")
+			w.Header().Set("Access-Control-Allow-Credentials", "true")
+		}
+		w.Header().Set("Access-Control-Allow-Origin", origin)
+	}
+
+	mux := h.mux
+	if mux == nil {
+		mux = admin.handlerMux
+	}
+	if mux == nil && admin.handlerMux != nil {
+		mux = admin.handlerMux
+	}
+	mux.ServeHTTP(w, r)
+}
