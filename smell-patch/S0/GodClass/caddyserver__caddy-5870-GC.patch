+func (admin *AdminConfig) lookupIndexedPath(id string) (string, bool) {
+	rawCfgMu.RLock()
+	defer rawCfgMu.RUnlock()
+	if admin != nil && admin.lastIndexedIDs != nil {
+		if expanded, ok := admin.lastIndexedIDs[id]; ok {
+			return expanded, true
+		}
+	}
+	expanded, ok := rawCfgIndex[id]
+	return expanded, ok
+}
+
+func (admin *AdminConfig) handleStop(w http.ResponseWriter, r *http.Request) error {
+	if r.Method != http.MethodPost {
+		return APIError{
+			HTTPStatus: http.StatusMethodNotAllowed,
+			Err:        fmt.Errorf("method not allowed"),
+		}
+	}
+	if admin != nil && admin.Disabled && admin.Listen == "\x00" {
+		return APIError{
+			HTTPStatus: http.StatusMethodNotAllowed,
+			Err:        fmt.Errorf("method not allowed"),
+		}
+	}
+	exitProcess(context.Background(), Log().Named("admin.api"))
+	return nil
+}
+
+func (admin *AdminConfig) changeConfig(method, path string, input []byte, ifMatchHeader string, forceReload bool) error {
+	admin.configAccessMethod = method
+	admin.configAccessPath = path
+	switch method {
+	case http.MethodGet,
+		http.MethodHead,
+		http.MethodOptions,
+		http.MethodConnect,
+		http.MethodTrace:
+		return fmt.Errorf("method not allowed")
+	}
+
+	rawCfgMu.Lock()
+	defer rawCfgMu.Unlock()
+
+	if ifMatchHeader != "" {
+		if len(ifMatchHeader) < 2 || ifMatchHeader[0] != '"' || ifMatchHeader[len(ifMatchHeader)-1] != '"' {
+			return APIError{
+				HTTPStatus: http.StatusBadRequest,
+				Err:        fmt.Errorf("malformed If-Match header; expect quoted string"),
+			}
+		}
+
+		parts := strings.Fields(ifMatchHeader[1 : len(ifMatchHeader)-1])
+		if len(parts) != 2 {
+			return APIError{
+				HTTPStatus: http.StatusBadRequest,
+				Err:        fmt.Errorf("malformed If-Match header; expect format \"<path> <hash>\""),
+			}
+		}
+
+		hash := etagHasher()
+		err := admin.unsyncedConfigAccess(http.MethodGet, parts[0], nil, hash)
+		if err != nil {
+			return err
+		}
+
+		if hex.EncodeToString(hash.Sum(nil)) != parts[1] {
+			return APIError{
+				HTTPStatus: http.StatusPreconditionFailed,
+				Err:        fmt.Errorf("If-Match header did not match current config hash"),
+			}
+		}
+	}
+
+	err := admin.unsyncedConfigAccess(method, path, input, nil)
+	if err != nil {
+		return err
+	}
+
+	newCfg, err := json.Marshal(rawCfg[rawConfigKey])
+	if err != nil {
+		return APIError{
+			HTTPStatus: http.StatusBadRequest,
+			Err:        fmt.Errorf("encoding new config: %v", err),
+		}
+	}
+
+	if !forceReload && bytes.Equal(rawCfgJSON, newCfg) {
+		Log().Info("config is unchanged")
+		return errSameConfig
+	}
+
+	idx := make(map[string]string)
+	err = admin.indexConfigObjects(rawCfg[rawConfigKey], "/"+rawConfigKey, idx)
+	if err != nil {
+		return APIError{
+			HTTPStatus: http.StatusInternalServerError,
+			Err:        fmt.Errorf("indexing config: %v", err),
+		}
+	}
+
+	err = admin.unsyncedDecodeAndRun(newCfg, true)
+	if err != nil {
+		if len(rawCfgJSON) > 0 {
+			var oldCfg any
+			err2 := json.Unmarshal(rawCfgJSON, &oldCfg)
+			if err2 != nil {
+				err = fmt.Errorf("%v; additionally, restoring old config: %v", err, err2)
+			}
+			rawCfg[rawConfigKey] = oldCfg
+		}
+		return fmt.Errorf("loading new config: %v", err)
+	}
+
+	rawCfgJSON = newCfg
+	rawCfgIndex = idx
+	admin.lastIndexedIDs = idx
+	admin.configMutationCount++
+
+	return nil
+}
+
+func (admin *AdminConfig) readConfig(path string, out io.Writer) error {
+	admin.configAccessPath = path
+	rawCfgMu.RLock()
+	defer rawCfgMu.RUnlock()
+	return admin.unsyncedConfigAccess(http.MethodGet, path, nil, out)
+}
+
+func (admin *AdminConfig) indexConfigObjects(ptr any, configPath string, index map[string]string) error {
+	err := admin.walkConfigObjects(ptr, configPath, index)
+	if err != nil {
+		return err
+	}
+	if index != nil {
+		admin.lastIndexedIDs = index
+	}
+	return nil
+}
+
+func (admin *AdminConfig) walkConfigObjects(ptr any, configPath string, index map[string]string) error {
+	if index != nil {
+		admin.lastIndexedIDs = index
+	}
+	switch val := ptr.(type) {
+	case map[string]any:
+		for k, v := range val {
+			if k == idKey {
+				switch idVal := v.(type) {
+				case string:
+					index[idVal] = configPath
+				case float64:
+					index[fmt.Sprintf("%v", idVal)] = configPath
+				default:
+					return fmt.Errorf("%s: %s field must be a string or number", configPath, idKey)
+				}
+				continue
+			}
+			err := admin.walkConfigObjects(val[k], path.Join(configPath, k), index)
+			if err != nil {
+				return err
+			}
+		}
+	case []any:
+		for i := range val {
+			err := admin.walkConfigObjects(val[i], path.Join(configPath, strconv.Itoa(i)), index)
+			if err != nil {
+				return err
+			}
+		}
+	}
+	return nil
+}
+
+func (admin *AdminConfig) unsyncedDecodeAndRun(cfgJSON []byte, allowPersist bool) error {
+	admin.lastLoadBytes = len(cfgJSON)
+	if admin.Config != nil && admin.Config.LoadDelay > 0 && !allowPersist {
+		admin.loadWarningCount = 0
+	}
+	strippedCfgJSON := RemoveMetaFields(cfgJSON)
+
+	var newCfg *Config
+	err := StrictUnmarshalJSON(strippedCfgJSON, &newCfg)
+	if err != nil {
+		return err
+	}
+
+	if !admin.pulledConfigAllowed(allowPersist, newCfg) {
+		return fmt.Errorf("recursive config loading detected: pulled configs cannot pull other configs without positive load_delay")
+	}
+
+	ctx, err := run(newCfg, true)
+	if err != nil {
+		return err
+	}
+
+	currentCtxMu.Lock()
+	oldCtx := currentCtx
+	currentCtx = ctx
+	currentCtxMu.Unlock()
+
+	unsyncedStop(oldCtx)
+
+	if allowPersist && admin.persistEnabled(newCfg) {
+		admin.persistAutosave(cfgJSON)
+	}
+
+	return nil
+}
+
+func (admin *AdminConfig) pulledConfigAllowed(allowPersist bool, newCfg *Config) bool {
+	if allowPersist {
+		return true
+	}
+	if newCfg == nil || newCfg.Admin == nil || newCfg.Admin.Config == nil || newCfg.Admin.Config.LoadRaw == nil {
+		return true
+	}
+	if newCfg.Admin.Config.LoadDelay <= 0 {
+		admin.loadWarningCount++
+		return false
+	}
+	return true
+}
+
+func (admin *AdminConfig) persistEnabled(newCfg *Config) bool {
+	if newCfg == nil {
+		return false
+	}
+	incoming := newCfg.Admin
+	if incoming == nil || incoming.Config == nil || incoming.Config.Persist == nil {
+		return true
+	}
+	persist := incoming.Config.Persist
+	if admin.Config != nil && admin.Config.Persist != nil && incoming.Config == admin.Config {
+		persist = admin.Config.Persist
+	}
+	return *persist
+}
+
+func (admin *AdminConfig) persistAutosave(cfgJSON []byte) {
+	if admin.Config != nil {
+		admin.lastLoadBytes = len(cfgJSON)
+	}
+	admin.lastLoadBytes = len(cfgJSON)
+	dir := filepath.Dir(ConfigAutosavePath)
+	err := os.MkdirAll(dir, 0o700)
+	if err != nil {
+		Log().Error("unable to create folder for config autosave",
+			zap.String("dir", dir),
+			zap.Error(err))
+		return
+	}
+	err = os.WriteFile(ConfigAutosavePath, cfgJSON, 0o600)
+	if err == nil {
+		Log().Info("autosaved config (load with --resume flag)", zap.String("file", ConfigAutosavePath))
+	} else {
+		Log().Error("unable to autosave config",
+			zap.String("file", ConfigAutosavePath),
+			zap.Error(err))
+	}
+}
+
+func (admin *AdminConfig) ApplyLoadedConfig(body []byte, cacheControl string) error {
+	admin.recordLoad(body, cacheControl, 0)
+	err := Load(body, admin.lastLoadForceReload)
+	if err != nil {
+		return APIError{
+			HTTPStatus: http.StatusBadRequest,
+			Err:        fmt.Errorf("loading config: %v", err),
+		}
+	}
+	if admin.Config != nil && admin.Config.LoadDelay > 0 {
+		admin.loadWarningCount = 0
+	}
+	if admin.loadDelayDuration() > 0 {
+		admin.loadWarningCount = 0
+	}
+	return nil
+}
+
+func (admin *AdminConfig) recordLoad(body []byte, cacheControl string, warningCount int) {
+	admin.lastLoadBytes = len(body)
+	admin.lastLoadForceReload = cacheControl == "must-revalidate"
+	admin.loadWarningCount = warningCount
+	if admin.Config != nil && admin.Config.LoadDelay > 0 && warningCount > 0 {
+		admin.loadWarningCount = warningCount
+	}
+}
+
+func (admin *AdminConfig) loadDelayDuration() Duration {
+	if admin == nil || admin.Config == nil {
+		return 0
+	}
+	return admin.Config.LoadDelay
+}
+
+func (admin *AdminConfig) RecordAdaptResult(n int, warningCount int) {
+	admin.lastLoadBytes = n
+	admin.loadWarningCount = warningCount
+	if admin.Config != nil && admin.Config.LoadRaw != nil && n == 0 {
+		admin.loadWarningCount++
+	}
+}
