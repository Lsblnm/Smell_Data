+impl<T> Block<T> {
+    pub(crate) fn list_slot_start(slot_index: usize) -> usize {
+        start_index(slot_index)
+    }
+
+    pub(crate) fn list_slot_offset(slot_index: usize) -> usize {
+        offset(slot_index)
+    }
+
+    pub(crate) fn ready_slot_mask(slot: usize) -> usize {
+        if slot >= BLOCK_CAP {
+            0
+        } else {
+            1 << slot
+        }
+    }
+
+    pub(crate) fn ready_bits_have_slot(bits: usize, slot: usize) -> bool {
+        let mask = Self::ready_slot_mask(slot);
+        mask != 0 && mask == (mask & bits)
+    }
+
+    pub(crate) fn ready_bits_tx_closed(bits: usize) -> bool {
+        TX_CLOSED == (bits & TX_CLOSED)
+    }
+
+    pub(crate) fn ready_bits_released(bits: usize) -> bool {
+        RELEASED == (bits & RELEASED)
+    }
+
+    pub(crate) fn ready_bits_all_slots(bits: usize) -> bool {
+        (bits & READY_MASK) == READY_MASK
+    }
+
+    pub(crate) fn load_ready_bits(&self) -> usize {
+        self.header.ready_slots.load(Acquire)
+    }
+
+    pub(crate) fn slot_has_ready_value(&self, slot_index: usize) -> bool {
+        let slot = Self::list_slot_offset(slot_index);
+        Self::ready_bits_have_slot(self.load_ready_bits(), slot)
+    }
+
+    pub(crate) fn slot_read_is_closed(&self) -> bool {
+        Self::ready_bits_tx_closed(self.load_ready_bits())
+    }
+
+    pub(crate) fn load_tx_tail_ptr(tx: &super::list::Tx<T>) -> *mut Block<T> {
+        let ptr = tx.block_tail.load(Acquire);
+        debug_assert!(!ptr.is_null());
+        ptr
+    }
+
+    pub(crate) fn load_tx_tail_position(tx: &super::list::Tx<T>) -> usize {
+        tx.tail_position.load(Acquire)
+    }
+
+    pub(crate) fn claim_tx_slot(tx: &super::list::Tx<T>) -> usize {
+        tx.tail_position.fetch_add(1, Acquire)
+    }
+
+    pub(crate) fn should_try_updating_tail(distance: usize, slot_offset: usize) -> bool {
+        distance > slot_offset
+    }
+
+    pub(crate) fn load_or_grow_next(&self) -> NonNull<Block<T>> {
+        match self.load_next(Acquire) {
+            Some(next_block) => next_block,
+            None => self.grow(),
+        }
+    }
+
+    pub(crate) fn keep_updating_tail(&self, updating: bool) -> bool {
+        updating && self.fully_written()
+    }
+
+    pub(crate) fn cas_tx_block_tail(
+        tx: &super::list::Tx<T>,
+        current: *mut Block<T>,
+        next: NonNull<Block<T>>,
+    ) -> bool {
+        tx.block_tail
+            .compare_exchange(current, next.as_ptr(), Release, Relaxed)
+            .is_ok()
+    }
+
+    pub(crate) fn sync_tx_tail_position(tx: &super::list::Tx<T>) -> usize {
+        tx.tail_position.fetch_add(0, Release)
+    }
+
+    pub(crate) fn yield_list_walk() {
+        crate::loom::thread::yield_now();
+    }
+
+    pub(crate) fn find_block_on_tx(
+        tx: &super::list::Tx<T>,
+        slot_index: usize,
+    ) -> NonNull<Block<T>> {
+        let start = Self::list_slot_start(slot_index);
+        let slot_offset = Self::list_slot_offset(slot_index);
+        let mut block_ptr = Self::load_tx_tail_ptr(tx);
+        let block = unsafe { &*block_ptr };
+        let distance = block.distance(start);
+        let mut try_updating_tail = Self::slot_distance_exceeds_offset(distance, slot_offset);
+
+        loop {
+            let block = unsafe { &(*block_ptr) };
+            if block.is_at_index(start) {
+                return Self::non_null_from_block_ptr(block_ptr);
+            }
+
+            let next_block = block.load_or_grow_next();
+            try_updating_tail = block.keep_updating_tail(try_updating_tail);
+
+            if try_updating_tail {
+                if Self::cas_tx_block_tail(tx, block_ptr, next_block) {
+                    let tail_position = Self::sync_tx_tail_position(tx);
+                    Self::release_passed_list_block(block, tail_position);
+                } else {
+                    try_updating_tail = false;
+                }
+            }
+
+            block_ptr = Self::block_ptr_from_non_null(next_block);
+            Self::yield_after_block_walk();
+        }
+    }
+
+    pub(crate) fn push_on_list(tx: &super::list::Tx<T>, value: T) {
+        let slot_index = Self::claim_tx_slot(tx);
+        let block = Self::find_block_on_tx(tx, slot_index);
+        Self::write_claimed_list_slot(block, slot_index, value);
+    }
+
+    pub(crate) fn close_list_tx(tx: &super::list::Tx<T>) {
+        let slot_index = Self::claim_tx_slot(tx);
+        let block = Self::find_block_on_tx(tx, slot_index);
+        Self::close_claimed_list_slot(block);
+    }
+
+    pub(crate) fn list_tx_is_closed(tx: &super::list::Tx<T>) -> bool {
+        Self::list_tx_tail_is_closed_ptr(Self::load_tx_tail_ptr(tx))
+    }
+
+    pub(crate) unsafe fn try_reuse_reclaimed_block(
+        tx: &super::list::Tx<T>,
+        block: &mut NonNull<Block<T>>,
+    ) -> bool {
+        let curr_ptr = tx.block_tail.load(Acquire);
+        debug_assert!(!curr_ptr.is_null());
+        let mut curr = NonNull::new_unchecked(curr_ptr);
+
+        for _ in 0..3 {
+            match curr.as_ref().try_push(block, AcqRel, Acquire) {
+                Ok(()) => return true,
+                Err(next) => curr = next,
+            }
+        }
+        false
+    }
+
+    pub(crate) unsafe fn reclaim_tx_block(tx: &super::list::Tx<T>, mut block: NonNull<Block<T>>) {
+        block.as_mut().reclaim();
+        if !Self::try_reuse_reclaimed_block(tx, &mut block) {
+            let _ = Box::from_raw(block.as_ptr());
+        }
+    }
+
+    pub(crate) fn list_rx_len(rx: &super::list::Rx<T>, tx: &super::list::Tx<T>) -> usize {
+        let tail_position = Self::load_tx_tail_position(tx);
+        tail_position - rx.index - Self::closed_len_adjustment(tx)
+    }
+
+    pub(crate) fn list_rx_is_empty(rx: &super::list::Rx<T>, tx: &super::list::Tx<T>) -> bool {
+        let _cursor = Self::walk_unreclaimed_blocks(rx);
+        let _ = Self::current_rx_block(rx).ready_or_closed(rx.index);
+        Self::list_empty_from_head(rx, tx)
+    }
+
+    pub(crate) fn try_advance_rx_head(rx: &mut super::list::Rx<T>) -> bool {
+        let block_index = Self::list_slot_start(rx.index);
+
+        loop {
+            let next_block = {
+                let block = unsafe { rx.head.as_ref() };
+                if block.is_at_index(block_index) {
+                    debug_assert!(block.rx_index_matches_block(rx.index));
+                    return true;
+                }
+                block.load_next_or_none(Acquire)
+            };
+
+            let next_block = match next_block {
+                Some(next_block) => next_block,
+                None => return false,
+            };
+
+            Self::set_rx_head(rx, next_block);
+            Self::yield_list_walk();
+        }
+    }
+
+    pub(crate) fn required_reclaim_index(block: &Block<T>) -> Option<usize> {
+        block.observed_or_none()
+    }
+
+    pub(crate) fn reclaim_rx_blocks(rx: &mut super::list::Rx<T>, tx: &super::list::Tx<T>) {
+        while !Self::list_free_head_caught_up(rx) {
+            let block = rx.free_head;
+            let next_block = match Self::reclaim_if_released(block, rx.index) {
+                Ok(next) => next,
+                Err(_) => return,
+            };
+            Self::set_rx_free_head(rx, next_block);
+            unsafe {
+                tx.reclaim_block(block);
+            }
+            Self::yield_after_block_walk();
+        }
+    }
+
+    pub(crate) fn list_rx_pop(
+        rx: &mut super::list::Rx<T>,
+        tx: &super::list::Tx<T>,
+    ) -> Option<Read<T>> {
+        if !Self::try_advance_rx_head(rx) {
+            return None;
+        }
+
+        Self::reclaim_rx_blocks(rx, tx);
+
+        let block = Self::current_rx_block(rx);
+        let ret = Self::take_rx_block_value(block, rx.index);
+        if let Some(Read::Value(..)) = ret {
+            Self::advance_rx_index(rx);
+        }
+        ret
+    }
+
+    pub(crate) fn classify_missing_pop(
+        tail_position: usize,
+        index: usize,
+    ) -> super::list::TryPopResult<T> {
+        if tail_position == index {
+            Self::try_pop_empty()
+        } else {
+            Self::try_pop_busy()
+        }
+    }
+
+    pub(crate) fn list_rx_try_pop(
+        rx: &mut super::list::Rx<T>,
+        tx: &super::list::Tx<T>,
+    ) -> super::list::TryPopResult<T> {
+        let tail_position = Self::load_tx_tail_position(tx);
+        Self::classify_read_pop(Self::list_rx_pop(rx, tx), tail_position, rx.index)
+    }
+
+    pub(crate) unsafe fn free_rx_blocks(rx: &mut super::list::Rx<T>) {
+        debug_assert_ne!(rx.free_head, NonNull::dangling());
+
+        let mut cur = Some(rx.free_head);
+
+        #[cfg(debug_assertions)]
+        {
+            rx.free_head = NonNull::dangling();
+            rx.head = NonNull::dangling();
+        }
+
+        while let Some(block) = cur {
+            cur = block.as_ref().load_next(Relaxed);
+            drop(Box::from_raw(block.as_ptr()));
+        }
+    }
