+    pub(crate) fn push_recv_many_value(buffer: &mut Vec<T>, value: T, remaining: &mut usize) {
+        *remaining -= 1;
+        buffer.push(value);
+    }
+
+    pub(crate) fn recv_many_added_count(buffer_len: usize, initial_length: usize) -> usize {
+        buffer_len - initial_length
+    }
+
+    pub(crate) fn try_fill_recv_many<S: super::chan::Semaphore>(
+        rx: &super::chan::Rx<T, S>,
+        rx_fields: &mut super::chan::RxFields<T>,
+        buffer: &mut Vec<T>,
+        remaining: &mut usize,
+        initial_length: usize,
+        coop: &crate::runtime::coop::RestoreOnPending,
+    ) -> Option<Poll<usize>> {
+        while *remaining > 0 {
+            match Self::pop_ready_chan_value(rx, rx_fields) {
+                Some(Read::Value(value)) => {
+                    Self::push_recv_many_value(buffer, value, remaining);
+                }
+                Some(Read::Closed) => {
+                    let number_added = Self::recv_many_added_count(buffer.len(), initial_length);
+                    Self::add_many_permits(rx, number_added);
+                    assert!(rx.inner.semaphore.is_idle());
+                    coop.made_progress();
+                    return Some(Ready(number_added));
+                }
+                None => break,
+            }
+        }
+
+        let number_added = Self::recv_many_added_count(buffer.len(), initial_length);
+        if number_added > 0 {
+            Self::add_many_permits(rx, number_added);
+            coop.made_progress();
+            Some(Ready(number_added))
+        } else {
+            None
+        }
+    }
+
+    pub(crate) fn chan_recv_many<S: super::chan::Semaphore>(
+        rx: &mut super::chan::Rx<T, S>,
+        cx: &mut Context<'_>,
+        buffer: &mut Vec<T>,
+        limit: usize,
+    ) -> Poll<usize> {
+        ready!(crate::trace::trace_leaf(cx));
+        let coop = ready!(crate::runtime::coop::poll_proceed(cx));
+
+        if Self::recv_many_limit_zero(limit) {
+            coop.made_progress();
+            return Self::poll_many_ready(0usize);
+        }
+
+        let mut remaining = limit;
+        let initial_length = buffer.len();
+
+        rx.inner.rx_fields.with_mut(|rx_fields_ptr| {
+            let rx_fields = unsafe { &mut *rx_fields_ptr };
+
+            if let Some(ready) = Self::try_fill_recv_many(
+                rx,
+                rx_fields,
+                buffer,
+                &mut remaining,
+                initial_length,
+                &coop,
+            ) {
+                return ready;
+            }
+
+            Self::register_chan_waker(rx, cx);
+
+            if let Some(ready) = Self::try_fill_recv_many(
+                rx,
+                rx_fields,
+                buffer,
+                &mut remaining,
+                initial_length,
+                &coop,
+            ) {
+                return ready;
+            }
+
+            Self::finish_recv_many_after_wait(rx, rx_fields, buffer, &coop)
+        })
+    }
+
+    pub(crate) fn map_try_pop_result<S: super::chan::Semaphore>(
+        rx: &super::chan::Rx<T, S>,
+        result: super::list::TryPopResult<T>,
+    ) -> Result<Option<T>, TryRecvError> {
+        match result {
+            super::list::TryPopResult::Ok(value) => {
+                Self::add_single_permit(rx);
+                Ok(Some(value))
+            }
+            super::list::TryPopResult::Closed => Err(Self::try_recv_disconnected()),
+            super::list::TryPopResult::Empty => Err(Self::try_recv_empty()),
+            super::list::TryPopResult::Busy => Ok(None),
+        }
+    }
+
+    pub(crate) fn try_pop_chan_once<S: super::chan::Semaphore>(
+        rx: &super::chan::Rx<T, S>,
+        rx_fields: &mut super::chan::RxFields<T>,
+    ) -> Result<Option<T>, TryRecvError> {
+        let result = rx_fields.list.try_pop(&rx.inner.tx);
+        Self::try_recv_from_pop(rx, result)
+    }
+
+    pub(crate) fn park_chan_until_ready<S: super::chan::Semaphore>(
+        rx: &super::chan::Rx<T, S>,
+        rx_fields: &mut super::chan::RxFields<T>,
+    ) -> Result<T, TryRecvError> {
+        Self::wake_rx_waker(&rx.inner);
+        let mut park = Self::new_cached_park_thread();
+        loop {
+            Self::register_park_waker(rx, &park);
+            match Self::try_pop_chan_once(rx, rx_fields) {
+                Ok(Some(value)) => return Ok(value),
+                Err(err) => return Err(err),
+                Ok(None) => Self::park_thread(&mut park),
+            }
+        }
+    }
+
+    pub(crate) fn chan_try_recv<S: super::chan::Semaphore>(
+        rx: &mut super::chan::Rx<T, S>,
+    ) -> Result<T, TryRecvError> {
+        rx.inner.rx_fields.with_mut(|rx_fields_ptr| {
+            let rx_fields = unsafe { &mut *rx_fields_ptr };
+
+            match Self::try_pop_chan_once(rx, rx_fields) {
+                Ok(Some(value)) => return Ok(value),
+                Err(err) => return Err(err),
+                Ok(None) => {}
+            }
+
+            Self::park_chan_until_ready(rx, rx_fields)
+        })
+    }
+
+    pub(crate) fn drain_chan_rx<S: super::chan::Semaphore>(rx: &mut super::chan::Rx<T, S>) {
+        rx.inner.rx_fields.with_mut(|rx_fields_ptr| {
+            let rx_fields = unsafe { &mut *rx_fields_ptr };
+            while let Some(Read::Value(_)) = rx_fields.list.pop(&rx.inner.tx) {
+                Self::add_single_permit(rx);
+            }
+        });
+    }
