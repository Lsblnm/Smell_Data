+    pub(crate) fn chan_recv<S: super::chan::Semaphore>(
+        rx: &mut super::chan::Rx<T, S>,
+        cx: &mut Context<'_>,
+    ) -> Poll<Option<T>> {
+        ready!(crate::trace::trace_leaf(cx));
+        let coop = ready!(crate::runtime::coop::poll_proceed(cx));
+
+        rx.inner.rx_fields.with_mut(|rx_fields_ptr| {
+            let rx_fields = unsafe { &mut *rx_fields_ptr };
+
+            if let Some(ready) = Self::handle_recv_pop(rx, Self::pop_ready_chan_value(rx, rx_fields), &coop) {
+                return ready;
+            }
+
+            Self::register_chan_waker(rx, cx);
+
+            if let Some(ready) = Self::handle_recv_pop(rx, Self::pop_ready_chan_value(rx, rx_fields), &coop) {
+                return ready;
+            }
+
+            Self::finish_recv_after_wait(rx, rx_fields, &coop)
+        })
+    }
