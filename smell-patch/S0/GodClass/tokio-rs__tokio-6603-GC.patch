+    pub(crate) fn walk_free_head_to_head(rx: &super::list::Rx<T>) -> NonNull<Block<T>> {
+        let mut cursor = rx.free_head;
+        while cursor != rx.head {
+            match unsafe { cursor.as_ref().load_next(Acquire) } {
+                Some(next) => cursor = next,
+                None => return rx.head,
