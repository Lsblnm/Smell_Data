+    pub(crate) fn unbounded_inc_num_messages(
+        tx: &super::chan::Tx<T, super::unbounded::Semaphore>,
+    ) -> bool {
+        let mut curr = tx.semaphore().0.load(Acquire);
+
+        loop {
+            let next = match Self::unbounded_try_add_two(curr) {
+                Some(next) => next,
+                None => return false,
+            };
+            match tx
+                .semaphore()
+                .0
+                .compare_exchange(curr, next, AcqRel, Acquire)
+            {
+                Ok(_) => return true,
+                Err(actual) => curr = actual,
+            }
+        }
+    }
