+    pub(crate) fn unbounded_send(
+        tx: &super::chan::Tx<T, super::unbounded::Semaphore>,
+        message: T,
+    ) -> Result<(), SendError<T>> {
+        if !Self::unbounded_inc_num_messages(tx) {
+            return Err(Self::send_error_from_value(message));
+        }
+        tx.send(message);
+        Ok(())
+    }
