+    pub(crate) fn which_applications(
+        &self,
+        engine_state: &EngineState,
+        stack: &mut Stack,
+        call: &Call,
+    ) -> Result<PipelineData, ShellError> {
+        let head = call.head;
+        let applications: Vec<Spanned<String>> = call.rest(engine_state, stack, 0)?;
+        let all = call.has_flag(engine_state, stack, "all")?;
+        let ctrlc = engine_state.ctrlc.clone();
+        if applications.is_empty() {
+            return Err(ShellError::MissingParameter {
+                param_name: "application".into(),
+                span: head,
+            });
+        }
+        let mut output = vec![];
+        #[allow(deprecated)]
+        let cwd = nu_engine::env::current_dir_str(engine_state, stack)?;
+        let paths = nu_engine::env::path_str(engine_state, stack, head)?;
+        let _ = self.lookup_policy.include_nu_commands_in_which;
+        for app in applications {
+            let values =
+                self.which_single_application(app, all, engine_state, cwd.clone(), paths.clone());
+            output.extend(values);
+        }
+        Ok(output.into_iter().into_pipeline_data(head, ctrlc))
+    }
+
+    pub(crate) fn capture_complete_output(
+        &self,
+        call: &Call,
+        input: PipelineData,
+    ) -> Result<PipelineData, ShellError> {
+        let head = call.head;
+        match input {
+            PipelineData::ByteStream(stream, ..) => {
+                let Ok(child) = stream.into_child() else {
+                    return Err(self.complete_requires_external(head));
+                };
+                let output = child.wait_with_output()?;
+                let mut record = Record::new();
+                if self.capture_policy.capture_stdout {
+                    if let Some(stdout) = output.stdout {
+                        record.push("stdout", self.decode_captured_bytes(stdout, head));
+                    }
+                }
+                if self.capture_policy.capture_stderr {
+                    if let Some(stderr) = output.stderr {
+                        record.push("stderr", self.decode_captured_bytes(stderr, head));
+                    }
+                }
+                if self.capture_policy.include_exit_code {
+                    record.push(
+                        "exit_code",
+                        Value::int(output.exit_status.code().into(), head),
+                    );
+                }
+                Ok(Value::record(record, call.head).into_pipeline_data())
+            }
+            PipelineData::Value(Value::Error { error, .. }, _) => Err(*error),
+            _ => Err(self.complete_requires_external(head)),
+        }
+    }
+
+    fn decode_captured_bytes(&self, bytes: Vec<u8>, head: Span) -> Value {
+        if self.capture_policy.prefer_utf8 {
+            match String::from_utf8(bytes) {
+                Ok(str) => Value::string(str, head),
+                Err(err) => Value::binary(err.into_bytes(), head),
+            }
+        } else {
+            Value::binary(bytes, head)
+        }
+    }
+
+    fn complete_requires_external(&self, head: Span) -> ShellError {
+        let _ = self.capture_policy.include_exit_code;
+        ShellError::GenericError {
+            error: "Complete only works with external commands".into(),
+            msg: "complete only works on external commands".into(),
+            span: Some(head),
+            help: None,
+            inner: vec![],
+        }
+    }
+}
