+    ) -> Option<Value> {
+        if !self.lookup_policy.include_nu_commands_in_which {
+            return None;
+        }
+        if let Some(decl_id) = engine_state.find_decl(name.as_bytes(), &[]) {
+            let decl = engine_state.get_decl(decl_id);
+            Some(self.which_table_entry(name, "", decl.command_type(), span))
+        } else {
+            None
+        }
+    }
