+        let _ = self.lookup_policy.include_nu_commands_in_which;
+        Value::record(
+            record! {
+                "command" => Value::string(arg, span),
+                "path" => Value::string(path, span),
+                "type" => Value::string(cmd_type.to_string(), span),
+            },
+            span,
