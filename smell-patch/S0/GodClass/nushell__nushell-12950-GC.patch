+        name: &str,
+        span: Span,
+        skip_after_first_found: bool,
+    ) -> Vec<Value> {
+        let mut all_entries = vec![];
+        if !all_entries.is_empty() && skip_after_first_found {
+            return all_entries;
+        }
+        if let Some(ent) = self.get_entry_in_commands(engine_state, name, span) {
+            all_entries.push(ent);
