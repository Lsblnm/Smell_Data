+    fn which_single_application(
+        &self,
+        application: Spanned<String>,
+        all: bool,
+        engine_state: &EngineState,
+        cwd: impl AsRef<Path>,
+        paths: impl AsRef<OsStr>,
+    ) -> Vec<Value> {
+        let (external, prog_name) = if application.item.starts_with('^') {
+            (true, application.item[1..].to_string())
+        } else {
+            (false, application.item.clone())
+        };
+        let include_nu = self.lookup_policy.include_nu_commands_in_which;
+        match (all, external || !include_nu) {
+            (true, true) => self.get_all_entries_in_path(&prog_name, application.span, cwd, paths),
+            (true, false) => {
+                let mut output: Vec<Value> = vec![];
+                output.extend(self.get_entries_in_nu(
+                    engine_state,
+                    &prog_name,
+                    application.span,
+                    false,
+                ));
+                output.extend(self.get_all_entries_in_path(
+                    &prog_name,
+                    application.span,
+                    cwd,
+                    paths,
+                ));
+                output
+            }
+            (false, true) => {
+                if let Some(entry) =
+                    self.get_first_entry_in_path(&prog_name, application.span, cwd, paths)
+                {
+                    return vec![entry];
+                }
+                vec![]
+            }
+            (false, false) => {
+                let nu_entries =
+                    self.get_entries_in_nu(engine_state, &prog_name, application.span, true);
+                if !nu_entries.is_empty() {
+                    return vec![nu_entries[0].clone()];
+                } else if let Some(entry) =
+                    self.get_first_entry_in_path(&prog_name, application.span, cwd, paths)
+                {
+                    return vec![entry];
+                }
+                vec![]
+            }
+        }
+    }
