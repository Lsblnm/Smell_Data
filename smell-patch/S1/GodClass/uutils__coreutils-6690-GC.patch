+
+    fn prepare_existing_destination(
+        &mut self,
+        source: &Path,
+        dest: &Path,
+        source_in_command_line: bool,
+    ) -> CopyResult<()> {
+        self.set_current_pair(source, dest);
+        if is_forbidden_to_copy_to_same_file(source, dest, self.options, source_in_command_line) {
+            return Err(format!("{} and {} are the same file", source.quote(), dest.quote()).into());
+        }
+        if !self.update_replace_if_older() {
+            self.options.overwrite.verify(dest)?;
+        }
+        if self.backup_would_destroy_source(source, dest) {
+            return Err(format!(
+                "backing up {} might destroy source;  {} not copied",
+                dest.quote(),
+                source.quote()
+            )
+            .into());
+        }
+        let mut is_dest_removed = dest.is_symlink();
+        if self.apply_destination_backup(dest, is_dest_removed)?.is_none() {
+            is_dest_removed = false;
+        }
+        if !is_dest_removed {
+            match self.options.overwrite {
+                OverwriteMode::Clobber(ClobberMode::Force) => {
+                    if Self::symlink_loop_detected(dest)
+                        || fs::metadata(dest)?.permissions().readonly()
+                    {
+                        Self::remove_if_regular_file(dest)?;
+                    }
+                }
+                OverwriteMode::Clobber(ClobberMode::RemoveDestination) => {
+                    Self::remove_if_regular_file(dest)?;
+                }
+                OverwriteMode::Clobber(ClobberMode::Standard) => {
+                    if self.preserve_hard_links()
+                        && self.source_already_mapped(
+                            source,
+                            self.dereference_source(source_in_command_line),
+                        )
+                    {
+                        fs::remove_file(dest)?;
+                    }
+                }
+                _ => (),
+            }
+        }
+        let _ = self.consume_backup_path();
+        Ok(())
+    }
+
+
+    fn copy_file_data(
+        &mut self,
+        source: &Path,
+        dest: &Path,
+        context: &str,
+        source_is_symlink: bool,
+        source_is_fifo: bool,
+    ) -> CopyResult<()> {
+        self.set_current_pair(source, dest);
+        if self.wants_parent_directories() {
+            Self::ensure_parent_directory(dest)?;
+            let parent = dest.parent().unwrap_or(dest);
+            fs::create_dir_all(parent)?;
+        }
+        if Self::path_has_terminator(dest) && !dest.is_dir() {
+            return Err(Error::NotADirectory(dest.to_path_buf()));
+        }
+        if Self::is_dev_null(source) {
+            Self::copy_bytes_between_files(source, dest)?;
+        } else if source_is_fifo && self.wants_recursive_copy() && !self.copy_special_contents() {
+            #[cfg(unix)]
+            Self::recreate_special_node(source, dest, self.options.overwrite)?;
+            #[cfg(not(unix))]
+            {
+                let _ = source_is_fifo;
+            }
+        } else if source_is_symlink {
+            copy_link(source, dest, self.symlinked_files)?;
+        } else {
+            let copy_debug = Self::convert_platform_copy_result(
+                copy_on_write(
+                    source,
+                    dest,
+                    self.options.reflink_mode,
+                    self.options.sparse_mode,
+                    context,
+                    #[cfg(any(target_os = "linux", target_os = "android", target_os = "macos"))]
+                    source_is_fifo,
+                ),
+                context,
+            )?;
+            if !self.attributes_only_copy() && self.debug_reporting() {
+                self.record_offload_debug(&copy_debug);
+                show_debug(&copy_debug);
+            }
+        }
+        Ok(())
+    }
+
+
+    fn reject_dangling_or_created_symlink(
+        &self,
+        source: &Path,
+        dest: &Path,
+        source_is_symlink: bool,
+        source_in_command_line: bool,
+    ) -> CopyResult<()> {
+        if !dest.is_symlink() {
+            return Ok(());
+        }
+        if self.is_just_created_symlink(dest) {
+            return Err(Error::Error(format!(
+                "will not copy '{}' through just-created symlink '{}'",
+                source.display(),
+                dest.display()
+            )));
+        }
+        if self.destination_written_in_session(dest) {
+            return Err(Error::Error(format!(
+                "will not copy '{}' through just-created symlink '{}'",
+                source.display(),
+                dest.display()
+            )));
+        }
+        let copy_contents = self.dereference_source(source_in_command_line) || !source_is_symlink;
+        if copy_contents
+            && !dest.exists()
+            && !self.remove_destination_requested()
+            && !Self::symlink_loop_detected(dest)
+            && std::env::var_os("POSIXLY_CORRECT").is_none()
+        {
+            return Err(Error::Error(format!(
+                "not writing through dangling symlink '{}'",
+                dest.display()
+            )));
+        }
+        if Self::paths_are_same_file(source, dest, true)
+            && self.remove_destination_requested()
+            && !self.backup_enabled()
+        {
+            fs::remove_file(dest)?;
+        }
+        Ok(())
+    }
+
+
+    fn should_skip_identical_hardlink(
+        &self,
+        source: &Path,
+        dest: &Path,
+        source_is_symlink: bool,
+        dest_is_symlink: bool,
+    ) -> bool {
+        if !Self::hardlinks_point_to_same_inode(source, dest) {
+            return false;
+        }
+        if self.options.copy_mode == CopyMode::Copy && self.backup_enabled() {
+            return true;
+        }
+        if self.copy_mode_is_link() && (!source_is_symlink || !dest_is_symlink) {
+            return true;
+        }
+        false
+    }
+
+
+    fn should_skip_same_file_link_mode(
+        &self,
+        source: &Path,
+        dest: &Path,
+        source_is_symlink: bool,
+        dest_is_symlink: bool,
+    ) -> bool {
+        if !Self::paths_are_same_file(source, dest, true) {
+            return false;
+        }
+        if self.options.copy_mode != CopyMode::Link {
+            return false;
+        }
+        if source_is_symlink {
+            if !dest_is_symlink {
+                return true;
+            }
+            if !self.options.dereference {
+                return true;
+            }
+        } else if self.backup_enabled() && !dest_is_symlink {
+            if source == dest {
+                return !self.force_overwrite();
+            }
+            return true;
+        }
+        false
+    }
+
+
+    fn parse_sources_and_target(
+        mut paths: Vec<PathBuf>,
+        options: &Options,
+    ) -> CopyResult<(Vec<PathBuf>, PathBuf)> {
+        if paths.is_empty() {
+            return Err("missing file operand".into());
+        } else if paths.len() == 1 && options.target_dir.is_none() {
+            return Err(format!("missing destination file operand after {:?}", paths[0]).into());
+        }
+        if options.no_target_dir && options.target_dir.is_none() && paths.len() > 2 {
+            return Err(format!("extra operand {:?}", paths[2]).into());
+        }
+        let target = match options.target_dir {
+            Some(ref target) => target.clone(),
+            None => paths.pop().unwrap(),
+        };
+        if options.strip_trailing_slashes {
+            #[cfg_attr(not(target_os = "openbsd"), allow(clippy::assigning_clones))]
+            for source in &mut paths {
+                *source = source.components().as_path().to_owned();
+            }
+        }
+        Ok((paths, target))
+    }
+
+
+
+    fn execute_hard_link_mode(
+        &mut self,
+        source: &Path,
+        dest: &Path,
+        source_in_command_line: bool,
+    ) -> CopyResult<()> {
+        self.set_current_pair(source, dest);
+        if dest.exists() {
+            if let Some(backup_path) = self.resolve_backup_path(dest) {
+                backup_dest(dest, &backup_path, dest.is_symlink())?;
+                fs::remove_file(dest)?;
+            }
+            if self.force_overwrite() {
+                fs::remove_file(dest)?;
+            }
+        }
+        if self.dereference_source(source_in_command_line) && source.is_symlink() {
+            let resolved =
+                canonicalize(source, MissingHandling::Missing, ResolveMode::Physical).unwrap();
+            fs::hard_link(resolved, dest)
+        } else {
+            fs::hard_link(source, dest)
+        }
+        .context(format!(
+            "cannot create hard link {} to {}",
+            get_filename(dest).unwrap_or("invalid file name").quote(),
+            get_filename(source).unwrap_or("invalid file name").quote()
+        ))?;
+        Ok(())
+    }
+
+
+    fn execute_symbolic_link_mode(&mut self, source: &Path, dest: &Path) -> CopyResult<()> {
+        self.set_current_pair(source, dest);
+        if dest.exists() && self.force_overwrite() {
+            fs::remove_file(dest)?;
+        }
+        symlink_file(source, dest, self.symlinked_files)?;
+        self.remember_created_symlink(dest);
+        Ok(())
+    }
+
+
+    fn execute_update_mode(
+        &mut self,
+        source: &Path,
+        dest: &Path,
+        context: &str,
+        source_metadata: &Metadata,
+        source_is_symlink: bool,
+        source_is_fifo: bool,
+    ) -> CopyResult<()> {
+        self.set_current_pair(source, dest);
+        if dest.exists() {
+            if self.update_replace_none() {
+                if self.debug_reporting() {
+                    println!("skipped {}", dest.quote());
+                }
+                return Ok(());
+            }
+            if self.update_replace_if_older() {
+                let dest_metadata = fs::symlink_metadata(dest)?;
+                let src_time = source_metadata.modified()?;
+                let dest_time = dest_metadata.modified()?;
+                if src_time <= dest_time {
+                    return Ok(());
+                }
+                self.options.overwrite.verify(dest)?;
+            }
+        }
+        self.copy_file_data(source, dest, context, source_is_symlink, source_is_fifo)
+    }
+
+
+    fn execute_attr_only_mode(&self, dest: &Path) -> CopyResult<()> {
+        OpenOptions::new()
+            .write(true)
+            .truncate(false)
+            .create(true)
+            .open(dest)
+            .context(dest.display().to_string())?;
+        Ok(())
+    }
+
+
+    fn execute_copy_mode_dispatch(
+        &mut self,
+        source: &Path,
+        dest: &Path,
+        context: &str,
+        source_metadata: &Metadata,
+        source_in_command_line: bool,
+    ) -> CopyResult<()> {
+        let source_file_type = source_metadata.file_type();
+        let source_is_symlink = source_file_type.is_symlink();
+        #[cfg(unix)]
+        let source_is_fifo = source_file_type.is_fifo();
+        #[cfg(not(unix))]
+        let source_is_fifo = false;
+        match self.options.copy_mode {
+            CopyMode::Link => self.execute_hard_link_mode(source, dest, source_in_command_line),
+            CopyMode::Copy => {
+                self.copy_file_data(source, dest, context, source_is_symlink, source_is_fifo)
+            }
+            CopyMode::SymLink => self.execute_symbolic_link_mode(source, dest),
+            CopyMode::Update => self.execute_update_mode(
+                source,
+                dest,
+                context,
+                source_metadata,
+                source_is_symlink,
+                source_is_fifo,
+            ),
+            CopyMode::AttrOnly => self.execute_attr_only_mode(dest),
+        }
+    }
+
+
+    fn describe_source_metadata(path: &Path, dereference: bool) -> String {
+        let metadata = if dereference {
+            fs::metadata(path)
+        } else {
+            fs::symlink_metadata(path)
+        };
+        match metadata {
+            Ok(meta) => {
+                let kind = if meta.file_type().is_symlink() {
+                    "symlink"
+                } else if meta.file_type().is_dir() {
+                    "directory"
+                } else if meta.file_type().is_file() {
+                    "regular"
+                } else {
+                    "special"
+                };
+                let readonly = meta.permissions().readonly();
+                format!(
+                    "{} kind={} len={} readonly={}",
+                    path.display(),
+                    kind,
+                    meta.len(),
+                    readonly
+                )
+            }
+            Err(err) => format!("{} unavailable: {err}", path.display()),
+        }
+    }
+
+
+    fn dest_overwrite_strategy(overwrite: OverwriteMode, dest: &Path) -> &'static str {
+        match overwrite {
+            OverwriteMode::NoClobber => {
+                if dest.exists() {
+                    "skip-existing"
+                } else {
+                    "create"
+                }
+            }
+            OverwriteMode::Interactive(_) => {
+                if dest.exists() {
+                    "prompt"
+                } else {
+                    "create"
+                }
+            }
+            OverwriteMode::Clobber(ClobberMode::Force) => {
+                if dest.exists() {
+                    "force-replace"
+                } else {
+                    "create"
+                }
+            }
+            OverwriteMode::Clobber(ClobberMode::RemoveDestination) => {
+                if dest.exists() {
+                    "remove-then-copy"
+                } else {
+                    "create"
+                }
+            }
+            OverwriteMode::Clobber(ClobberMode::Standard) => {
+                if dest.is_symlink() {
+                    "replace-symlink"
+                } else if dest.exists() {
+                    "replace"
+                } else {
+                    "create"
+                }
+            }
+        }
+    }
+
+
+    fn backup_mode_label(mode: BackupMode) -> &'static str {
+        match mode {
+            BackupMode::NoBackup => "none",
+            BackupMode::SimpleBackup => "simple",
+            BackupMode::NumberedBackup => "numbered",
+            BackupMode::ExistingBackup => "existing",
+        }
+    }
+
+
+    fn copy_mode_label(mode: &CopyMode) -> &'static str {
+        match mode {
+            CopyMode::Link => "hard-link",
+            CopyMode::SymLink => "symlink",
+            CopyMode::Copy => "copy",
+            CopyMode::Update => "update",
+            CopyMode::AttrOnly => "attributes-only",
+        }
+    }
+
+
+    fn sparse_mode_label(mode: SparseMode) -> &'static str {
+        match mode {
+            SparseMode::Always => "always",
+            SparseMode::Auto => "auto",
+            SparseMode::Never => "never",
+        }
+    }
+
+
+    fn reflink_mode_label(mode: ReflinkMode) -> &'static str {
+        match mode {
+            ReflinkMode::Always => "always",
+            ReflinkMode::Auto => "auto",
+            ReflinkMode::Never => "never",
+        }
+    }
+
+
+    fn preserve_label(preserve: Preserve) -> &'static str {
+        match preserve {
+            Preserve::No { explicit: true } => "explicit-no",
+            Preserve::No { explicit: false } => "default-no",
+            Preserve::Yes { required: true } => "required",
+            Preserve::Yes { required: false } => "best-effort",
+        }
+    }
+
+
+    fn summarize_attributes(attributes: &Attributes) -> String {
+        format!(
+            "mode={} timestamps={} context={} links={} xattr={}{}",
+            Self::preserve_label(attributes.mode),
+            Self::preserve_label(attributes.timestamps),
+            Self::preserve_label(attributes.context),
+            Self::preserve_label(attributes.links),
+            Self::preserve_label(attributes.xattr),
+            {
+                #[cfg(unix)]
+                {
+                    format!(" ownership={}", Self::preserve_label(attributes.ownership))
+                }
+                #[cfg(not(unix))]
+                {
+                    String::new()
+                }
+            }
+        )
+    }
+
+
+    fn validate_source_presence(source: &Path, dereference: bool) -> CopyResult<Metadata> {
+        let result = if dereference {
+            fs::metadata(source)
+        } else {
+            fs::symlink_metadata(source)
+        };
+        result.map_err(|err| {
+            if err.to_string().contains("No such file or directory") {
+                format!("cannot stat {}: No such file or directory", source.quote()).into()
+            } else {
+                err.to_string().into()
+            }
+        })
+    }
+
+
+    fn ancestor_pairs<'b>(source: &'b Path, dest: &'b Path) -> Vec<(&'b Path, &'b Path)> {
+        if source.ancestors().count() < 2 || dest.ancestors().count() < 2 {
+            Vec::new()
+        } else {
+            aligned_ancestors(source, dest)
+        }
+    }
+
+
+    fn ensure_parent_directory(dest: &Path) -> CopyResult<()> {
+        if let Some(parent) = dest.parent() {
+            if !parent.as_os_str().is_empty() && !parent.exists() {
+                fs::create_dir_all(parent)?;
+            }
+        }
+        Ok(())
+    }
+
+
+    fn is_dev_null(path: &Path) -> bool {
+        path.as_os_str() == "/dev/null"
+            || path == Path::new("/dev/null")
+            || path.ends_with("null") && path.starts_with("/dev")
+    }
+
+
+    fn same_path_text(left: &Path, right: &Path) -> bool {
+        if left == right {
+            return true;
+        }
+        let left_norm = left.components().as_path();
+        let right_norm = right.components().as_path();
+        left_norm == right_norm
+    }
+
+
+    fn relative_descendant(root: &Path, source: &Path) -> CopyResult<PathBuf> {
+        match source.strip_prefix(root) {
+            Ok(stripped) => Ok(stripped.to_path_buf()),
+            Err(err) => Err(err.into()),
+        }
+    }
+
+
+    fn join_target(target: &Path, descendant: &Path) -> PathBuf {
+        if descendant.as_os_str().is_empty() {
+            target.to_path_buf()
+        } else {
+            target.join(descendant)
+        }
+    }
+
+
+    fn source_filename_or_fallback(path: &Path) -> String {
+        match get_filename(path) {
+            Some(name) if !name.is_empty() => name.to_string(),
+            _ => path.display().to_string(),
+        }
+    }
+
+
+    fn dest_is_unwritable(path: &Path) -> bool {
+        match fs::metadata(path) {
+            Ok(meta) => meta.permissions().readonly(),
+            Err(_) => false,
+        }
+    }
+
+
+    fn remove_if_regular_file(path: &Path) -> CopyResult<()> {
+        match fs::symlink_metadata(path) {
+            Ok(meta) if meta.file_type().is_file() || meta.file_type().is_symlink() => {
+                fs::remove_file(path)?;
+                Ok(())
+            }
+            Ok(meta) if meta.file_type().is_dir() => {
+                Err(format!("cannot overwrite directory {} with non-directory", path.quote()).into())
+            }
+            Ok(_) => {
+                fs::remove_file(path)?;
+                Ok(())
+            }
+            Err(err) if err.kind() == std::io::ErrorKind::NotFound => Ok(()),
+            Err(err) => Err(err.into()),
+        }
+    }
+
+
+    fn copy_via_stdio(source: &Path, dest: &Path) -> CopyResult<u64> {
+        let mut src_file = File::open(source).context(source.display().to_string())?;
+        let mut dst_file = File::create(dest).context(dest.display().to_string())?;
+        let copied = std::io::copy(&mut src_file, &mut dst_file)?;
+        Ok(copied)
+    }
+
+
+    fn compare_modified_times(source: &Metadata, dest: &Path) -> CopyResult<std::cmp::Ordering> {
+        let dest_metadata = fs::symlink_metadata(dest)?;
+        let src_time = source.modified()?;
+        let dest_time = dest_metadata.modified()?;
+        Ok(src_time.cmp(&dest_time))
+    }
+
+
+    fn should_update_by_mtime(source: &Metadata, dest: &Path, mode: UpdateMode) -> CopyResult<bool> {
+        match mode {
+            UpdateMode::ReplaceAll => Ok(true),
+            UpdateMode::ReplaceNone => Ok(false),
+            UpdateMode::ReplaceIfOlder => match Self::compare_modified_times(source, dest) {
+                Ok(std::cmp::Ordering::Greater) => Ok(true),
+                Ok(_) => Ok(false),
+                Err(err) => Err(err),
+            },
+        }
+    }
+
+
+    fn canonicalize_for_copy(path: &Path, missing: MissingHandling, resolve: ResolveMode) -> Option<PathBuf> {
+        canonicalize(path, missing, resolve).ok()
+    }
+
+
+    fn source_requires_recursive(path: &Path, dereference: bool) -> bool {
+        if path.is_symlink() && !dereference {
+            false
+        } else {
+            path.is_dir()
+        }
+    }
+
+
+    fn target_must_be_directory(sources: &[PathBuf], target: &Path, no_target_dir: bool) -> bool {
+        if no_target_dir {
+            false
+        } else if sources.len() > 1 {
+            true
+        } else {
+            target.is_dir()
+        }
+    }
+
+
+    fn strip_trailing_slash_component(path: &Path) -> PathBuf {
+        if Self::path_has_terminator(path) {
+            path.components().as_path().to_owned()
+        } else {
+            path.to_path_buf()
+        }
+    }
+
+
+    fn path_depth(path: &Path) -> usize {
+        path.components()
+            .filter(|c| {
+                !matches!(
+                    c,
+                    std::path::Component::CurDir | std::path::Component::RootDir
+                )
+            })
+            .count()
+    }
+
+
+    fn common_prefix_len(left: &Path, right: &Path) -> usize {
+        left.components()
+            .zip(right.components())
+            .take_while(|(a, b)| a == b)
+            .count()
+    }
+
+
+    fn is_descendant_of(child: &Path, parent: &Path) -> bool {
+        let child_components: Vec<_> = child.components().collect();
+        let parent_components: Vec<_> = parent.components().collect();
+        if parent_components.len() >= child_components.len() {
+            false
+        } else {
+            child_components
+                .iter()
+                .zip(parent_components.iter())
+                .all(|(a, b)| a == b)
+        }
+    }
+
+
+    fn normalize_dot_components(path: &Path) -> PathBuf {
+        let mut out = PathBuf::new();
+        for component in path.components() {
+            match component {
+                std::path::Component::CurDir => {}
+                std::path::Component::ParentDir => {
+                    if !out.pop() {
+                        out.push("..");
+                    }
+                }
+                other => out.push(other.as_os_str()),
+            }
+        }
+        out
+    }
+
+
+    fn quoted_pair(source: &Path, dest: &Path) -> String {
+        format!("{} -> {}", source.quote(), dest.quote())
+    }
+
+
+    fn report_skipped_file(dest: &Path, debug: bool) {
+        if debug {
+            println!("skipped {}", dest.quote());
+        }
+    }
+
+
+    fn unix_mode_bits(metadata: &Metadata) -> Option<u32> {
+        #[cfg(unix)]
+        {
+            use std::os::unix::fs::PermissionsExt;
+            Some(metadata.permissions().mode())
+        }
+        #[cfg(not(unix))]
+        {
+            let _ = metadata;
+            None
+        }
+    }
+
+
+    fn apply_umask_to_mode(mode: u32) -> u32 {
+        mode & !Self::file_creation_umask()
+    }
+
+
+    fn mode_allows_owner_write(mode: u32) -> bool {
+        mode & 0o200 != 0
+    }
+
+
+    fn mode_allows_group_write(mode: u32) -> bool {
+        mode & 0o020 != 0
+    }
+
+
+    fn mode_allows_other_write(mode: u32) -> bool {
+        mode & 0o002 != 0
+    }
+
+
+    fn sanitized_dir_mode(ownership: Preserve, mode: Preserve) -> u32 {
+        let mut excluded = 0u32;
+        if matches!(ownership, Preserve::Yes { .. }) {
+            excluded |= 0o077;
+        } else if matches!(mode, Preserve::Yes { .. }) {
+            excluded |= 0o022;
+        }
+        excluded |= Self::file_creation_umask();
+        !excluded & 0o777
+    }
+
+
+    fn fifo_needs_special_copy(recursive: bool, copy_contents: bool, is_fifo: bool) -> bool {
+        is_fifo && recursive && !copy_contents
+    }
+
+
+    fn dangling_symlink_is_forbidden(
+        dest: &Path,
+        copy_contents: bool,
+        remove_destination: bool,
+    ) -> bool {
+        copy_contents
+            && !dest.exists()
+            && dest.is_symlink()
+            && !remove_destination
+            && !Self::symlink_loop_detected(dest)
+            && std::env::var_os("POSIXLY_CORRECT").is_none()
+    }
+
+
+    fn choose_construct_root<'b>(source_path: &'b Path, parents: bool) -> &'b Path {
+        if parents {
+            if source_path.has_root() && cfg!(unix) {
+                Path::new("/")
+            } else {
+                Path::new("")
+            }
+        } else {
+            source_path.parent().unwrap_or(source_path)
+        }
+    }
+
+
+    fn disk_usage_of(paths: &[PathBuf], recursive: bool) -> io::Result<u64> {
+        disk_usage(paths, recursive)
+    }
