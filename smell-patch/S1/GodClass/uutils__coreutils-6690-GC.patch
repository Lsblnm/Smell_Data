+            Some("never") => Ok(SparseMode::Never),
+            Some(other) => Err(Error::InvalidArgument(format!(
+                "invalid argument {other} for 'sparse'"
+            ))),
+            None => Ok(SparseMode::Auto),
+        }
+    }
