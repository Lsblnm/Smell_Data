+    #[cfg(unix)]
+    fn apply_ownership(source: &Path, dest: &Path) -> CopyResult<()> {
+        use std::os::unix::prelude::MetadataExt;
+        let context = &*format!("{} -> {}", source.quote(), dest.quote());
+        let source_metadata = fs::symlink_metadata(source).context(context)?;
+        let dest_uid = source_metadata.uid();
+        let dest_gid = source_metadata.gid();
+        let dest_meta = dest.symlink_metadata().context(context)?;
+        let _ = Self::change_owner(dest, &dest_meta, Some(dest_uid), Some(dest_gid), false);
+        Ok(())
+    }
+
+
+    #[cfg(unix)]
+    fn change_owner(
+        path: &Path,
+        meta: &Metadata,
+        dest_uid: Option<u32>,
+        dest_gid: Option<u32>,
+        follow: bool,
+    ) -> Result<String, String> {
+        use std::os::unix::ffi::OsStrExt;
+        use std::os::unix::fs::MetadataExt;
+        let dest_uid = dest_uid.unwrap_or_else(|| meta.uid());
+        let dest_gid = dest_gid.unwrap_or_else(|| meta.gid());
+        let s = CString::new(path.as_os_str().as_bytes()).unwrap();
+        let ret = unsafe {
+            if follow {
+                libc::chown(s.as_ptr(), dest_uid, dest_gid)
+            } else {
+                libc::lchown(s.as_ptr(), dest_uid, dest_gid)
+            }
+        };
+        if ret == 0 {
+            Ok(String::new())
+        } else {
+            Err(format!(
+                "changing ownership of {}: {}",
+                path.quote(),
+                std::io::Error::last_os_error()
+            ))
+        }
+    }
+
