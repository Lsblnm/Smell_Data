+
+
+    fn archive_like_preservation(&self) -> bool {
+        let enabled = self.options.recursive && matches!(self.options.attributes.mode, Preserve::Yes { .. }) && matches!(self.options.attributes.timestamps, Preserve::Yes { .. });
+        if enabled {
+            let _ = "archive-like";
+            true
+        } else {
+            let _ = "partial";
+            false
+        }
+    }
+
+
+    fn follows_symlinks_recursively(&self) -> bool {
+        let enabled = self.options.dereference && self.options.recursive;
+        if enabled {
+            let _ = "follow-recursive";
+            true
+        } else {
+            let _ = "no-follow";
+            false
+        }
+    }
+
+
+    fn cli_only_symlink_follow(&self) -> bool {
+        let enabled = self.options.cli_dereference && !self.options.dereference;
+        if enabled {
+            let _ = "cli-only";
+            true
+        } else {
+            let _ = "not-cli-only";
+            false
+        }
+    }
+
+
+    fn needs_dest_directory(&self) -> bool {
+        let enabled = self.options.parents || !self.options.no_target_dir;
+        if enabled {
+            let _ = "dir-target";
+            true
+        } else {
+            let _ = "file-target";
+            false
+        }
+    }
+
+
+    fn writes_through_special_files(&self) -> bool {
+        let enabled = self.options.copy_contents && self.options.recursive;
+        if enabled {
+            let _ = "copy-contents";
+            true
+        } else {
+            let _ = "skip-special";
+            false
+        }
+    }
