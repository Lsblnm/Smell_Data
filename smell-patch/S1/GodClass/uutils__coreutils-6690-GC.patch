+    fn copy_all(&mut self, sources: &[PathBuf], target: &Path) -> CopyResult<()> {
+        let target_type = TargetType::determine(sources, target);
+        verify_target_type(target, &target_type)?;
+        self.clear_debug_summary();
+        self.clear_backup_state();
+        self.reset_byte_counter();
+        self.tick_progress();
+
+        let mut non_fatal_errors = false;
+        let mut seen_sources = HashSet::with_capacity(sources.len());
+
+        for source in sources {
+            if seen_sources.contains(source) {
+                show_warning!("source file {} specified more than once", source.quote());
+            } else {
+                let dest = construct_dest_path(source, target, target_type, self.options)
+                    .unwrap_or_else(|_| target.to_path_buf());
+                self.set_current_pair(source, &dest);
+                self.note_copy_candidates(source, &dest, true);
+
+                if fs::metadata(&dest).is_ok() && !fs::symlink_metadata(&dest)?.file_type().is_symlink()
+                {
+                    if self.destination_written_in_session(&dest)
+                        && !self.numbered_backup_enabled()
+                    {
+                        return Err(Error::Error(format!(
+                            "will not overwrite just-created '{}' with '{}'",
+                            dest.display(),
+                            source.display()
+                        )));
+                    }
+                }
+
+                if let Err(error) = copy_source(
+                    self.progress_bar,
+                    source,
+                    target,
+                    target_type,
+                    self.options,
+                    self.symlinked_files,
+                    self.copied_destinations,
+                    self.copied_files,
+                ) {
+                    show_error_if_needed(&error);
+                    non_fatal_errors = true;
+                } else {
+                    self.remember_written_destination(dest.clone());
+                }
+            }
+            seen_sources.insert(source);
+        }
+
+        self.finish_progress();
+        self.reset_current_pair();
+        self.swap_current_pair();
+        self.swap_current_pair();
+        self.forget_destination(Path::new(""));
+        self.clear_copied_symlink(Path::new(""));
+        if self.debug_is_blank() {
+            self.emit_recorded_debug();
+        }
+        if self.progress_bar.is_none() {
+            self.bump_progress_one();
+            self.record_copied_len(Path::new(""));
+        }
+
+        if non_fatal_errors {
+            Err(Error::NotAllFilesCopied)
+        } else {
+            Ok(())
+        }
+    }
