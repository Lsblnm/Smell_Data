+
+    fn session_description(&self) -> String {
+        format!(
+            "mode={} backup={} sparse={} reflink={} recursive={} parents={} verbose={} debug={} attrs={}",
+            Self::copy_mode_label(&self.options.copy_mode),
+            Self::backup_mode_label(self.options.backup),
+            Self::sparse_mode_label(self.options.sparse_mode),
+            Self::reflink_mode_label(self.options.reflink_mode),
+            self.options.recursive,
+            self.options.parents,
+            self.options.verbose,
+            self.options.debug,
+            Self::summarize_attributes(&self.options.attributes)
+        )
+    }
