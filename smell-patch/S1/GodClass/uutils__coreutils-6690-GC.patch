+    fn next_simple_backup(&mut self, dest: &Path) -> PathBuf {
+        self.increment_backup_attempts();
+        let path = Self::simple_backup_path(dest, &self.options.backup_suffix);
+        self.last_backup_path = Some(path.clone());
