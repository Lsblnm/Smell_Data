+/// Coordinates option parsing, copying, backups, attributes, and directory traversal.
+pub(crate) struct CopyEngine<'a> {
+    pub(crate) options: &'a Options,
+    pub(crate) copied_files: &'a mut HashMap<FileInformation, PathBuf>,
+    pub(crate) copied_destinations: &'a mut HashSet<PathBuf>,
+    pub(crate) symlinked_files: &'a mut HashSet<FileInformation>,
+    pub(crate) progress_bar: &'a Option<ProgressBar>,
+    pub(crate) last_backup_path: Option<PathBuf>,
+    pub(crate) backup_attempts: usize,
+    pub(crate) current_source: PathBuf,
+    pub(crate) current_dest: PathBuf,
+    pub(crate) bytes_copied: u64,
+    pub(crate) debug_summary: String,
+}
+
+impl<'a> CopyEngine<'a> {
+    pub(crate) fn command() -> Command {
+        const MODE_ARGS: &[&str] = &[
+            options::LINK,
+            options::REFLINK,
+            options::SYMBOLIC_LINK,
+            options::ATTRIBUTES_ONLY,
+            options::COPY_CONTENTS,
+        ];
+        Command::new(uucore::util_name())
+            .version(crate_version!())
+            .about(ABOUT)
+            .override_usage(format_usage(USAGE))
+            .after_help(format!(
+                "{AFTER_HELP}\n\n{}",
+                backup_control::BACKUP_CONTROL_LONG_HELP
+            ))
+            .infer_long_args(true)
+            .args_override_self(true)
+            .arg(Self::target_directory_arg())
+            .arg(Self::no_target_directory_arg())
+            .arg(Self::interactive_arg())
+            .arg(Self::link_arg(MODE_ARGS))
+            .arg(Self::no_clobber_arg())
+            .arg(Self::recursive_arg())
+            .arg(Self::strip_trailing_slashes_arg())
+            .arg(Self::debug_arg())
+            .arg(Self::verbose_arg())
+            .arg(Self::symbolic_link_arg(MODE_ARGS))
+            .arg(Self::force_arg())
+            .arg(Self::remove_destination_arg())
+            .arg(backup_control::arguments::backup())
+            .arg(backup_control::arguments::backup_no_args())
+            .arg(backup_control::arguments::suffix())
+            .arg(update_control::arguments::update())
+            .arg(update_control::arguments::update_no_args())
+            .arg(Self::reflink_arg(MODE_ARGS))
+            .arg(Self::attributes_only_arg(MODE_ARGS))
+            .arg(Self::preserve_arg())
+            .arg(Self::preserve_default_attributes_arg())
+            .arg(Self::no_preserve_arg())
+            .arg(Self::parents_arg())
+            .arg(Self::no_dereference_arg())
+            .arg(Self::dereference_arg())
+            .arg(Self::cli_symbolic_links_arg())
+            .arg(Self::archive_arg())
+            .arg(Self::no_dereference_preserve_links_arg())
+            .arg(Self::one_file_system_arg())
+            .arg(Self::sparse_arg())
+            .arg(Self::copy_contents_arg())
+            .arg(Self::context_arg())
+            .arg(Self::progress_bar_arg())
+            .arg(
+                Arg::new(options::PATHS)
+                    .action(ArgAction::Append)
+                    .value_hint(clap::ValueHint::AnyPath)
+                    .value_parser(ValueParser::os_string()),
+            )
+    }
+
+
+    fn target_directory_arg() -> Arg {
+        Arg::new(options::TARGET_DIRECTORY)
+            .short('t')
+            .conflicts_with(options::NO_TARGET_DIRECTORY)
+            .long(options::TARGET_DIRECTORY)
+            .value_name(options::TARGET_DIRECTORY)
+            .value_hint(clap::ValueHint::DirPath)
+            .value_parser(ValueParser::path_buf())
+            .help("copy all SOURCE arguments into target-directory")
+    }
+
+    fn no_target_directory_arg() -> Arg {
+        Arg::new(options::NO_TARGET_DIRECTORY)
+            .short('T')
+            .long(options::NO_TARGET_DIRECTORY)
+            .conflicts_with(options::TARGET_DIRECTORY)
+            .help("Treat DEST as a regular file and not a directory")
+            .action(ArgAction::SetTrue)
+    }
+
+    fn interactive_arg() -> Arg {
+        Arg::new(options::INTERACTIVE)
+            .short('i')
+            .long(options::INTERACTIVE)
+            .overrides_with(options::NO_CLOBBER)
+            .help("ask before overwriting files")
+            .action(ArgAction::SetTrue)
+    }
+
+    fn link_arg(mode_args: &[&'static str]) -> Arg {
+        Arg::new(options::LINK)
+            .short('l')
+            .long(options::LINK)
+            .overrides_with_all(mode_args)
+            .help("hard-link files instead of copying")
+            .action(ArgAction::SetTrue)
+    }
+
+    fn no_clobber_arg() -> Arg {
+        Arg::new(options::NO_CLOBBER)
+            .short('n')
+            .long(options::NO_CLOBBER)
+            .overrides_with(options::INTERACTIVE)
+            .help("don't overwrite a file that already exists")
+            .action(ArgAction::SetTrue)
+    }
+
+    fn recursive_arg() -> Arg {
+        Arg::new(options::RECURSIVE)
+            .short('R')
+            .visible_short_alias('r')
+            .long(options::RECURSIVE)
+            .help("copy directories recursively")
+            .action(ArgAction::SetTrue)
+    }
+
+    fn strip_trailing_slashes_arg() -> Arg {
+        Arg::new(options::STRIP_TRAILING_SLASHES)
+            .long(options::STRIP_TRAILING_SLASHES)
+            .help("remove any trailing slashes from each SOURCE argument")
+            .action(ArgAction::SetTrue)
+    }
+
+    fn debug_arg() -> Arg {
+        Arg::new(options::DEBUG)
+            .long(options::DEBUG)
+            .help("explain how a file is copied. Implies -v")
+            .action(ArgAction::SetTrue)
+    }
+
+    fn verbose_arg() -> Arg {
+        Arg::new(options::VERBOSE)
+            .short('v')
+            .long(options::VERBOSE)
+            .help("explicitly state what is being done")
+            .action(ArgAction::SetTrue)
+    }
+
+    fn symbolic_link_arg(mode_args: &[&'static str]) -> Arg {
+        Arg::new(options::SYMBOLIC_LINK)
+            .short('s')
+            .long(options::SYMBOLIC_LINK)
+            .overrides_with_all(mode_args)
+            .help("make symbolic links instead of copying")
+            .action(ArgAction::SetTrue)
+    }
+
+    fn force_arg() -> Arg {
+        Arg::new(options::FORCE)
+            .short('f')
+            .long(options::FORCE)
+            .help(
+                "if an existing destination file cannot be opened, remove it and \
+                try again (this option is ignored when the -n option is also used). \
+                Currently not implemented for Windows.",
+            )
+            .action(ArgAction::SetTrue)
+    }
+
+    fn remove_destination_arg() -> Arg {
+        Arg::new(options::REMOVE_DESTINATION)
+            .long(options::REMOVE_DESTINATION)
+            .overrides_with(options::FORCE)
+            .help(
+                "remove each existing destination file before attempting to open it \
+                (contrast with --force). On Windows, currently only works for \
+                writeable files.",
+            )
+            .action(ArgAction::SetTrue)
+    }
+
+    fn reflink_arg(mode_args: &[&'static str]) -> Arg {
+        Arg::new(options::REFLINK)
+            .long(options::REFLINK)
+            .value_name("WHEN")
+            .overrides_with_all(mode_args)
+            .require_equals(true)
+            .default_missing_value("always")
+            .value_parser(ShortcutValueParser::new(["auto", "always", "never"]))
+            .num_args(0..=1)
+            .help("control clone/CoW copies. See below")
+    }
+
+    fn attributes_only_arg(mode_args: &[&'static str]) -> Arg {
+        Arg::new(options::ATTRIBUTES_ONLY)
+            .long(options::ATTRIBUTES_ONLY)
+            .overrides_with_all(mode_args)
+            .help("Don't copy the file data, just the attributes")
+            .action(ArgAction::SetTrue)
+    }
+
+    fn preserve_arg() -> Arg {
+        Arg::new(options::PRESERVE)
+            .long(options::PRESERVE)
+            .action(ArgAction::Append)
+            .use_value_delimiter(true)
+            .value_parser(ShortcutValueParser::new(PRESERVABLE_ATTRIBUTES))
+            .num_args(0..)
+            .require_equals(true)
+            .value_name("ATTR_LIST")
+            .default_missing_value(PRESERVE_DEFAULT_VALUES)
+            .help(
+                "Preserve the specified attributes (default: mode, ownership (unix only), \
+                 timestamps), if possible additional attributes: context, links, xattr, all",
+            )
+    }
+
+    fn preserve_default_attributes_arg() -> Arg {
+        Arg::new(options::PRESERVE_DEFAULT_ATTRIBUTES)
+            .short('p')
+            .long(options::PRESERVE_DEFAULT_ATTRIBUTES)
+            .help("same as --preserve=mode,ownership(unix only),timestamps")
+            .action(ArgAction::SetTrue)
+    }
+
+    fn no_preserve_arg() -> Arg {
+        Arg::new(options::NO_PRESERVE)
+            .long(options::NO_PRESERVE)
+            .action(ArgAction::Append)
+            .use_value_delimiter(true)
+            .value_parser(ShortcutValueParser::new(PRESERVABLE_ATTRIBUTES))
+            .num_args(0..)
+            .require_equals(true)
+            .value_name("ATTR_LIST")
+            .help("don't preserve the specified attributes")
+    }
+
+    fn parents_arg() -> Arg {
+        Arg::new(options::PARENTS)
+            .long(options::PARENTS)
+            .alias(options::PARENT)
+            .help("use full source file name under DIRECTORY")
+            .action(ArgAction::SetTrue)
+    }
+
+    fn no_dereference_arg() -> Arg {
+        Arg::new(options::NO_DEREFERENCE)
+            .short('P')
+            .long(options::NO_DEREFERENCE)
+            .overrides_with(options::DEREFERENCE)
+            .help("never follow symbolic links in SOURCE")
+            .action(ArgAction::SetTrue)
+    }
+
+    fn dereference_arg() -> Arg {
+        Arg::new(options::DEREFERENCE)
+            .short('L')
+            .long(options::DEREFERENCE)
+            .overrides_with(options::NO_DEREFERENCE)
+            .help("always follow symbolic links in SOURCE")
+            .action(ArgAction::SetTrue)
+    }
+
+    fn cli_symbolic_links_arg() -> Arg {
+        Arg::new(options::CLI_SYMBOLIC_LINKS)
+            .short('H')
+            .help("follow command-line symbolic links in SOURCE")
+            .action(ArgAction::SetTrue)
+    }
+
+    fn archive_arg() -> Arg {
+        Arg::new(options::ARCHIVE)
+            .short('a')
+            .long(options::ARCHIVE)
+            .help("Same as -dR --preserve=all")
+            .action(ArgAction::SetTrue)
+    }
+
+    fn no_dereference_preserve_links_arg() -> Arg {
+        Arg::new(options::NO_DEREFERENCE_PRESERVE_LINKS)
+            .short('d')
+            .help("same as --no-dereference --preserve=links")
+            .action(ArgAction::SetTrue)
+    }
+
+    fn one_file_system_arg() -> Arg {
+        Arg::new(options::ONE_FILE_SYSTEM)
+            .short('x')
+            .long(options::ONE_FILE_SYSTEM)
+            .help("stay on this file system")
+            .action(ArgAction::SetTrue)
+    }
+
+    fn sparse_arg() -> Arg {
+        Arg::new(options::SPARSE)
+            .long(options::SPARSE)
+            .value_name("WHEN")
+            .value_parser(ShortcutValueParser::new(["never", "auto", "always"]))
+            .help("control creation of sparse files. See below")
+    }
+
+    fn copy_contents_arg() -> Arg {
+        Arg::new(options::COPY_CONTENTS)
+            .long(options::COPY_CONTENTS)
+            .overrides_with(options::ATTRIBUTES_ONLY)
+            .help("NotImplemented: copy contents of special files when recursive")
+            .action(ArgAction::SetTrue)
+    }
+
+    fn context_arg() -> Arg {
+        Arg::new(options::CONTEXT)
+            .long(options::CONTEXT)
+            .value_name("CTX")
+            .help(
+                "NotImplemented: set SELinux security context of destination file to \
+                default type",
+            )
+    }
+
+    fn progress_bar_arg() -> Arg {
+        Arg::new(options::PROGRESS_BAR)
+            .long(options::PROGRESS_BAR)
+            .short('g')
+            .action(clap::ArgAction::SetTrue)
+            .help(
+                "Display a progress bar. \n\
+            Note: this feature is not supported by GNU coreutils.",
+            )
+    }
+
+
+
+    fn dereference_source(&self, in_command_line: bool) -> bool {
+        self.options.dereference || (in_command_line && self.options.cli_dereference)
+    }
+
+
+    fn preserve_hard_links(&self) -> bool {
+        match self.options.attributes.links {
+            Preserve::No { .. } => false,
+            Preserve::Yes { .. } => true,
+        }
+    }
+
+
+    #[cfg(unix)]
+    fn preserve_mode_flags(&self) -> (bool, bool) {
+        match self.options.attributes.mode {
+            Preserve::No { explicit } => {
+                if explicit {
+                    (false, true)
+                } else {
+                    (false, false)
+                }
+            }
+            Preserve::Yes { .. } => (true, false),
+        }
+    }
+
+
+    fn force_overwrite(&self) -> bool {
+        matches!(
+            self.options.overwrite,
+            OverwriteMode::Clobber(ClobberMode::Force)
+        )
+    }
+
+
+    fn remove_destination_requested(&self) -> bool {
+        matches!(
+            self.options.overwrite,
+            OverwriteMode::Clobber(ClobberMode::RemoveDestination)
+        )
+    }
+
+
+    fn interactive_overwrite(&self) -> bool {
+        matches!(self.options.overwrite, OverwriteMode::Interactive(_))
+    }
+
+
+    fn no_clobber(&self) -> bool {
+        matches!(self.options.overwrite, OverwriteMode::NoClobber)
+    }
+
+
+    fn wants_recursive_copy(&self) -> bool {
+        self.options.recursive
+    }
+
+
+    fn wants_parent_directories(&self) -> bool {
+        self.options.parents
+    }
+
+
+    fn strip_source_slashes(&self) -> bool {
+        self.options.strip_trailing_slashes
+    }
+
+
+    fn attributes_only_copy(&self) -> bool {
+        self.options.attributes_only
+    }
+
+
+    fn copy_special_contents(&self) -> bool {
+        self.options.copy_contents
+    }
+
+
+    fn stay_on_file_system(&self) -> bool {
+        self.options.one_file_system
+    }
+
+
+    fn verbose_reporting(&self) -> bool {
+        self.options.verbose
+    }
+
+
+    fn debug_reporting(&self) -> bool {
+        self.options.debug
+    }
+
+
+    fn backup_enabled(&self) -> bool {
+        self.options.backup != BackupMode::NoBackup
+    }
+
+
+    fn numbered_backup_enabled(&self) -> bool {
+        self.options.backup == BackupMode::NumberedBackup
+    }
+
+
+    fn copy_mode_is_link(&self) -> bool {
+        self.options.copy_mode == CopyMode::Link
+    }
+
+
+    fn copy_mode_is_symlink(&self) -> bool {
+        self.options.copy_mode == CopyMode::SymLink
+    }
+
+
+    fn copy_mode_is_update(&self) -> bool {
+        self.options.copy_mode == CopyMode::Update
+    }
+
+
+    fn copy_mode_is_attr_only(&self) -> bool {
+        self.options.copy_mode == CopyMode::AttrOnly
+    }
+
+
+    fn should_copy_symlink_object(&self, source: &Path) -> bool {
+        source.is_symlink() && !self.options.dereference
+    }
+
+
+    fn should_follow_command_line_symlink(&self, source_in_command_line: bool) -> bool {
+        if source_in_command_line {
+            self.options.dereference || self.options.cli_dereference
+        } else {
+            self.options.dereference
+        }
+    }
+
+
+    fn backup_conflicts_with_no_clobber(&self) -> bool {
+        self.options.overwrite == OverwriteMode::NoClobber
+            && self.options.backup != BackupMode::NoBackup
+    }
+
+
+    fn reflink_never(&self) -> bool {
+        self.options.reflink_mode == ReflinkMode::Never
+    }
