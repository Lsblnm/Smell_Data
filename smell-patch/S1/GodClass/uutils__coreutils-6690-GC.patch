+
+    fn clobber_from_flags(force: bool, remove_destination: bool) -> ClobberMode {
+        if force {
+            ClobberMode::Force
+        } else if remove_destination {
+            ClobberMode::RemoveDestination
+        } else {
+            ClobberMode::Standard
+        }
+    }
+
+
+    fn overwrite_from_flags(
+        interactive: bool,
+        no_clobber: bool,
+        force: bool,
+        remove_destination: bool,
+    ) -> OverwriteMode {
+        let clobber = Self::clobber_from_flags(force, remove_destination);
+        if interactive {
+            OverwriteMode::Interactive(clobber)
+        } else if no_clobber {
+            OverwriteMode::NoClobber
+        } else {
+            OverwriteMode::Clobber(clobber)
+        }
+    }
+
+
+    fn copy_mode_from_flags(
+        link: bool,
+        symbolic_link: bool,
+        update: bool,
+        attributes_only: bool,
+        remove_destination: bool,
+    ) -> CopyMode {
+        if link {
+            CopyMode::Link
+        } else if symbolic_link {
+            CopyMode::SymLink
+        } else if update {
+            CopyMode::Update
+        } else if attributes_only && !remove_destination {
+            CopyMode::AttrOnly
+        } else {
+            CopyMode::Copy
+        }
+    }
