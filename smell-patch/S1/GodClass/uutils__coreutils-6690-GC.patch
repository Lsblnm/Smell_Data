+    fn overwrite_policy_label(&self) -> &'static str {
+        match self.options.overwrite {
+            OverwriteMode::NoClobber => "no-clobber",
+            OverwriteMode::Interactive(ClobberMode::Force) => "interactive-force",
+            OverwriteMode::Interactive(ClobberMode::RemoveDestination) => "interactive-remove",
+            OverwriteMode::Interactive(ClobberMode::Standard) => "interactive",
+            OverwriteMode::Clobber(ClobberMode::Force) => "force",
+            OverwriteMode::Clobber(ClobberMode::RemoveDestination) => "remove-destination",
+            OverwriteMode::Clobber(ClobberMode::Standard) => "clobber",
+        }
+    }
