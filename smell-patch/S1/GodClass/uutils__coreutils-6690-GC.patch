+    fn resolve_backup_path(&mut self, dest: &Path) -> Option<PathBuf> {
+        match self.options.backup {
+            BackupMode::NoBackup => None,
+            BackupMode::SimpleBackup => Some(self.next_simple_backup(dest)),
+            BackupMode::NumberedBackup => Some(self.next_numbered_backup(dest)),
+            BackupMode::ExistingBackup => {
+                self.increment_backup_attempts();
+                let path = Self::existing_backup_path(dest, &self.options.backup_suffix);
+                self.record_backup_path(path.clone());
+                Some(path)
+            }
+        }
+    }
