+
+    fn inspect_and_prepare_source(
+        &mut self,
+        source: &Path,
+        dest: &Path,
+        source_in_command_line: bool,
+    ) -> CopyResult<&'static str> {
+        self.set_current_pair(source, dest);
+        if self.debug_reporting() {
+            self.append_debug_pair(source, dest);
+            self.append_debug_mode(Self::copy_mode_label(&self.options.copy_mode));
+            self.append_debug(Self::backup_mode_label(self.options.backup));
+            self.append_debug(self.overwrite_policy_label());
+        }
+        let action = Self::plan_copy_action(source, dest, self.options, source_in_command_line);
+        if let Some(reason) = Self::explain_skip_reason(source, dest, self.options, source_in_command_line)
+        {
+            if self.debug_reporting() {
+                self.append_debug(reason);
+            }
+            return Ok(reason);
+        }
+        Ok(action)
+    }
+
+
+    fn apply_verbose_output(&self, source: &Path, dest: &Path) {
+        if self.verbose_reporting() {
+            self.progress_or_print_verbose(self.wants_parent_directories(), source, dest);
+        }
+    }
+
+
+    fn maybe_hardlink_instead(&self, source: &Path, dest: &Path, source_in_command_line: bool) -> CopyResult<bool> {
+        if !self.preserve_hard_links() {
+            return Ok(false);
+        }
+        if let Some(origin) = self.copied_hardlink_origin(source, self.dereference_source(source_in_command_line))
+        {
+            std::fs::hard_link(origin, dest)?;
+            return Ok(true);
+        }
+        Ok(false)
+    }
+
+
+    fn finalize_copied_file(
+        &mut self,
+        source: &Path,
+        dest: &Path,
+        source_in_command_line: bool,
+        dest_is_symlink: bool,
+        dest_permissions: Permissions,
+    ) -> CopyResult<()> {
+        if !dest_is_symlink {
+            fs::set_permissions(dest, dest_permissions).ok();
+        }
+        if self.dereference_source(source_in_command_line) {
+            if let Ok(src) = canonicalize(source, MissingHandling::Normal, ResolveMode::Physical) {
+                self.preserve_selected_attributes(&src, dest)?;
+            }
+        } else {
+            self.preserve_selected_attributes(source, dest)?;
+        }
+        self.remember_copied_mapping(source, dest, self.dereference_source(source_in_command_line))?;
+        self.remember_pair_if_possible(source, dest, self.dereference_source(source_in_command_line));
+        if let Ok(meta) = fs::metadata(source) {
+            self.add_progress_from_metadata(&meta);
+        }
+        Ok(())
+    }
+
+
+    fn copy_regular_file_entry(
+        &mut self,
+        source: &Path,
+        dest: &Path,
+        source_in_command_line: bool,
+    ) -> CopyResult<()> {
+        self.set_current_pair(source, dest);
+        let _ = self.inspect_and_prepare_source(source, dest, source_in_command_line)?;
+        let source_is_symlink = source.is_symlink();
+        let dest_is_symlink = dest.is_symlink();
+        self.reject_dangling_or_created_symlink(source, dest, source_is_symlink, source_in_command_line)?;
+        if Self::hardlinks_point_to_same_inode(source, dest)
+            && source != dest
+            && self.remove_destination_requested()
+        {
+            fs::remove_file(dest)?;
+        }
+        if Self::file_or_symlink_exists(dest)
+            && (!self.attributes_only_copy() || self.remove_destination_requested())
+        {
+            if self.should_skip_same_file_link_mode(source, dest, source_is_symlink, dest_is_symlink)
+            {
+                return Ok(());
+            }
+            self.prepare_existing_destination(source, dest, source_in_command_line)?;
+            if self.should_skip_identical_hardlink(source, dest, source_is_symlink, dest_is_symlink)
+            {
+                return Ok(());
+            }
+        }
+        if self.attributes_only_copy()
+            && source_is_symlink
+            && !self.remove_destination_requested()
+        {
+            return Err(format!(
+                "cannot change attribute {}: Source file is a non regular file",
+                dest.quote()
+            )
+            .into());
+        }
+        self.apply_verbose_output(source, dest);
+        if self.maybe_hardlink_instead(source, dest, source_in_command_line)? {
+            return Ok(());
+        }
+        let context = context_for(source, dest);
+        let source_metadata = Self::validate_source_presence(source, self.dereference_source(source_in_command_line))?;
+        let dest_permissions = Self::destination_permissions(dest, &source_metadata, self.options, context.as_str())?;
+        self.execute_copy_mode_dispatch(
+            source,
+            dest,
+            context.as_str(),
+            &source_metadata,
+            source_in_command_line,
+        )?;
+        self.finalize_copied_file(
+            source,
+            dest,
+            source_in_command_line,
+            dest_is_symlink,
+            dest_permissions,
+        )
+    }
+
+
+    fn dereference_for_stat(&self, source_in_command_line: bool) -> bool {
+        match (self.options.dereference, self.options.cli_dereference, source_in_command_line) {
+            (true, _, _) => true,
+            (false, true, true) => true,
+            (false, true, false) => false,
+            (false, false, _) => false,
+        }
+    }
+
+
+    fn skip_directory_without_recursive(&self, source: &Path, source_in_command_line: bool) -> bool {
+        Self::path_is_directory_source(source, self.dereference_for_stat(source_in_command_line))
+            && !self.wants_recursive_copy()
+    }
+
+
+    fn parents_require_directory_target(&self, target: &Path) -> CopyResult<()> {
+        if self.wants_parent_directories() && !target.is_dir() {
+            Err("with --parents, the destination must be a directory".into())
+        } else {
+            Ok(())
+        }
+    }
+
+
+    fn refuse_directory_as_file_target(&self, target: &Path) -> CopyResult<()> {
+        if self.no_target_dir_mode() && target.is_dir() {
+            Err(format!(
+                "cannot overwrite directory {} with non-directory",
+                target.quote()
+            )
+            .into())
+        } else {
+            Ok(())
+        }
+    }
+
+
+    fn construct_destination(
+        &self,
+        source_path: &Path,
+        target: &Path,
+        target_type: TargetType,
+    ) -> CopyResult<PathBuf> {
+        self.refuse_directory_as_file_target(target)?;
+        self.parents_require_directory_target(target)?;
+        Ok(match target_type {
+            TargetType::Directory => {
+                let root = Self::choose_construct_root(source_path, self.wants_parent_directories());
+                localize_to_target(root, source_path, target)?
+            }
+            TargetType::File => target.to_path_buf(),
+        })
+    }
+
+
+    fn copy_single_source(
+        &mut self,
+        source: &Path,
+        target: &Path,
+        target_type: TargetType,
+    ) -> CopyResult<()> {
+        let source_path = Path::new(&source);
+        if source_path.is_dir() {
+            crate::copydir::copy_directory(
+                self.progress_bar,
+                source,
+                target,
+                self.options,
+                self.symlinked_files,
+                self.copied_destinations,
+                self.copied_files,
+                true,
+            )
+        } else {
+            let dest = self.construct_destination(source_path, target, target_type)?;
+            let res = self.copy_regular_file_entry(source_path, dest.as_path(), true);
+            if self.wants_parent_directories() {
+                for (x, y) in aligned_ancestors(source, dest.as_path()) {
+                    if let Ok(src) = canonicalize(x, MissingHandling::Normal, ResolveMode::Physical) {
+                        copy_attributes(&src, y, &self.options.attributes)?;
+                    }
+                }
+            }
+            res
+        }
+    }
+
+
+    fn attribute_should_run(preserve: Preserve) -> bool {
+        match preserve {
+            Preserve::No { .. } => false,
+            Preserve::Yes { .. } => true,
+        }
+    }
+
+
+    fn attribute_must_succeed(preserve: Preserve) -> bool {
+        match preserve {
+            Preserve::Yes { required } => required,
+            Preserve::No { .. } => false,
+        }
+    }
+
+
+    fn handle_optional_preserve(preserve: Preserve, result: CopyResult<()>) -> CopyResult<()> {
+        match preserve {
+            Preserve::No { .. } => Ok(()),
+            Preserve::Yes { required } => {
+                if required {
+                    result
+                } else if let Err(error) = result {
+                    show_error_if_needed(&error);
+                    Ok(())
+                } else {
+                    Ok(())
+                }
+            }
+        }
+    }
+
+
+    fn source_stat_error_message(source: &Path, err: &std::io::Error) -> String {
+        if err.to_string().contains("No such file or directory") {
+            format!("cannot stat {}: No such file or directory", source.quote())
+        } else if err.kind() == std::io::ErrorKind::PermissionDenied {
+            format!("cannot stat {}: Permission denied", source.quote())
+        } else {
+            err.to_string()
+        }
+    }
+
+
+    fn dest_open_error_message(dest: &Path, err: &std::io::Error) -> String {
+        match err.kind() {
+            std::io::ErrorKind::PermissionDenied => {
+                format!("cannot create regular file {}: Permission denied", dest.quote())
+            }
+            std::io::ErrorKind::AlreadyExists => {
+                format!("cannot create regular file {}: File exists", dest.quote())
+            }
+            std::io::ErrorKind::NotFound => {
+                format!("cannot create regular file {}: No such file or directory", dest.quote())
+            }
+            _ => format!("{}: {err}", dest.quote()),
+        }
+    }
+
+
+    fn is_special_unix_file(path: &Path) -> bool {
+        #[cfg(unix)]
+        {
+            use std::os::unix::fs::FileTypeExt;
+            match path.symlink_metadata() {
+                Ok(meta) => {
+                    let ft = meta.file_type();
+                    ft.is_fifo() || ft.is_socket() || ft.is_block_device() || ft.is_char_device()
+                }
+                Err(_) => false,
+            }
+        }
+        #[cfg(not(unix))]
+        {
+            let _ = path;
+            false
+        }
+    }
+
+
+    fn recreate_special_node(source: &Path, dest: &Path, overwrite: OverwriteMode) -> CopyResult<()> {
+        #[cfg(unix)]
+        {
+            use std::os::unix::fs::FileTypeExt;
+            let meta = fs::symlink_metadata(source)?;
+            let ft = meta.file_type();
+            if ft.is_fifo() {
+                copy_fifo(dest, overwrite)
+            } else if ft.is_socket() || ft.is_block_device() || ft.is_char_device() {
+                Err(format!(
+                    "omitting special file {}",
+                    source.quote()
+                )
+                .into())
+            } else {
+                Ok(())
+            }
+        }
+        #[cfg(not(unix))]
+        {
+            let _ = (source, dest, overwrite);
+            Ok(())
+        }
+    }
+
+
+    fn safe_create_file(dest: &Path) -> CopyResult<File> {
+        Ok(OpenOptions::new()
+            .write(true)
+            .create(true)
+            .truncate(true)
+            .open(dest)
+            .context(dest.display().to_string())?)
+    }
+
+
+    fn copy_bytes_between_files(source: &Path, dest: &Path) -> CopyResult<u64> {
+        if Self::is_dev_null(source) {
+            let _ = Self::safe_create_file(dest)?;
+            Ok(0)
+        } else {
+            Self::copy_via_stdio(source, dest)
+        }
+    }
+
+
+    fn restore_timestamps_from_metadata(dest: &Path, metadata: &Metadata) -> CopyResult<()> {
+        let atime = FileTime::from_last_access_time(metadata);
+        let mtime = FileTime::from_last_modification_time(metadata);
+        if dest.is_symlink() {
+            filetime::set_symlink_file_times(dest, atime, mtime)?;
+        } else {
+            filetime::set_file_times(dest, atime, mtime)?;
+        }
+        Ok(())
+    }
+
+
+    fn same_device_and_inode(source: &Path, dest: &Path, dereference: bool) -> bool {
+        match (
+            FileInformation::from_path(source, dereference),
+            FileInformation::from_path(dest, dereference),
+        ) {
+            (Ok(a), Ok(b)) => a == b,
+            _ => false,
+        }
+    }
+
+
+    fn can_hardlink_after_copy(options: &Options, source: &Path) -> bool {
+        match options.attributes.links {
+            Preserve::Yes { .. } => !source.is_dir(),
+            Preserve::No { .. } => false,
+        }
+    }
+
+
+    fn verbose_line(parents: bool, source: &Path, dest: &Path) -> String {
+        if parents {
+            let mut out = String::new();
+            for (x, y) in aligned_ancestors(source, dest) {
+                out.push_str(&format!("{} -> {}\n", x.display(), y.display()));
+            }
+            out.push_str(&context_for(source, dest));
+            out
+        } else {
+            context_for(source, dest)
+        }
+    }
+
+
+    fn backup_name_candidates(path: &Path, suffix: &str, limit: u32) -> Vec<PathBuf> {
+        let mut names = Vec::new();
+        names.push(Self::simple_backup_path(path, suffix));
+        for i in 1..=limit {
+            names.push(PathBuf::from(format!("{}.~{}~", path.to_string_lossy(), i)));
+        }
+        names
+    }
+
+
+    fn first_available_backup_name(path: &Path, suffix: &str, limit: u32) -> PathBuf {
+        for candidate in Self::backup_name_candidates(path, suffix, limit) {
+            if !candidate.exists() {
+                return candidate;
+            }
+        }
+        Self::simple_backup_path(path, suffix)
+    }
+
+
+    fn path_is_dot_or_dotdot(path: &Path) -> bool {
+        matches!(path.file_name().and_then(|n| n.to_str()), Some(".") | Some(".."))
+            || path == Path::new(".")
+            || path == Path::new("..")
+    }
+
+
+    fn skip_dot_entry(path: &Path) -> bool {
+        Self::path_is_dot_or_dotdot(path) || Self::ends_with_slash_dot(path)
+    }
+
+
+    fn walk_should_follow(options: &Options) -> bool {
+        options.dereference && options.recursive
+    }
+
+
+    fn walk_stays_on_device(options: &Options) -> bool {
+        options.one_file_system
+    }
+
+
+    fn directory_omission_message(root: &Path) -> String {
+        format!("-r not specified; omitting directory {}", root.quote())
+    }
+
+
+    fn self_copy_message(root: &Path, target: &Path) -> String {
+        format!(
+            "cannot copy a directory, {}, into itself, {}",
+            root.quote(),
+            target.join(root.file_name().unwrap_or_default()).quote()
+        )
+    }
+
+
+    fn non_directory_overwrite_message() -> &'static str {
+        "cannot overwrite non-directory with directory"
+    }
+
+
+    fn missing_operand_message() -> &'static str {
+        "missing file operand"
+    }
+
+
+    fn missing_destination_message(path: &Path) -> String {
+        format!("missing destination file operand after {:?}", path)
+    }
+
+
+    fn extra_operand_message(path: &Path) -> String {
+        format!("extra operand {:?}", path)
+    }
+
+}
