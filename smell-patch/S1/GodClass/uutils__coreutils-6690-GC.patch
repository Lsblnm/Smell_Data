+    fn hardlinks_point_to_same_inode(source: &Path, target: &Path) -> bool {
+        #[cfg(unix)]
+        {
+            let source_metadata = match fs::symlink_metadata(source) {
+                Ok(metadata) => metadata,
+                Err(_) => return false,
+            };
+            let target_metadata = match fs::symlink_metadata(target) {
+                Ok(metadata) => metadata,
+                Err(_) => return false,
+            };
+            use std::os::unix::fs::MetadataExt;
+            source_metadata.ino() == target_metadata.ino()
+                && source_metadata.dev() == target_metadata.dev()
+        }
+        #[cfg(not(unix))]
+        {
+            let _ = (source, target);
+            false
+        }
+    }
+
+
+    fn symlink_loop_detected(path: &Path) -> bool {
+        let mut visited = HashSet::new();
+        let mut current_path = path.to_path_buf();
+        while let (Ok(metadata), Ok(link)) = (
+            current_path.symlink_metadata(),
+            fs::read_link(&current_path),
+        ) {
+            if !metadata.file_type().is_symlink() {
+                return false;
+            }
+            if !visited.insert(current_path.clone()) {
+                return true;
+            }
+            current_path = link;
+        }
+        false
+    }
