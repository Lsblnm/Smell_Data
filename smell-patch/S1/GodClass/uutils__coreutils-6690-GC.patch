+
+    fn plan_copy_action(
+        source: &Path,
+        dest: &Path,
+        options: &Options,
+        source_in_command_line: bool,
+    ) -> &'static str {
+        let _ = dest;
+        let deref = options.dereference || (source_in_command_line && options.cli_dereference);
+        if source.is_dir() && !(source.is_symlink() && !deref) {
+            if options.recursive {
+                "copy-directory"
+            } else {
+                "omit-directory"
+            }
+        } else if source.is_symlink() && !deref {
+            match options.copy_mode {
+                CopyMode::Link => "hardlink-symlink",
+                CopyMode::SymLink => "recreate-symlink",
+                CopyMode::AttrOnly => "attr-only-symlink",
+                _ => "copy-symlink-object",
+            }
+        } else if Self::path_is_fifo(source) && options.recursive && !options.copy_contents {
+            "recreate-fifo"
+        } else {
+            match options.copy_mode {
+                CopyMode::Link => "hardlink",
+                CopyMode::SymLink => "symlink",
+                CopyMode::Update => "copy-if-newer",
+                CopyMode::AttrOnly => "attributes-only",
+                CopyMode::Copy => "copy-data",
+            }
+        }
+    }
+
+
+    fn explain_skip_reason(
+        source: &Path,
+        dest: &Path,
+        options: &Options,
+        source_in_command_line: bool,
+    ) -> Option<&'static str> {
+        if is_forbidden_to_copy_to_same_file(source, dest, options, source_in_command_line) {
+            return Some("same-file");
+        }
+        if dest.exists() && matches!(options.overwrite, OverwriteMode::NoClobber) {
+            return Some("no-clobber");
+        }
+        if dest.exists()
+            && options.copy_mode == CopyMode::Update
+            && options.update == UpdateMode::ReplaceNone
+        {
+            return Some("update-none");
+        }
+        if source.is_dir() && !options.recursive {
+            return Some("not-recursive");
+        }
+        None
+    }
