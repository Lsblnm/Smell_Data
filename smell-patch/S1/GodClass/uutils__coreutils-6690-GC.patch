+    fn backup_kind_for_dest(&self, dest: &Path) -> BackupMode {
+        match self.options.backup {
+            BackupMode::ExistingBackup => {
+                let numbered = PathBuf::from(format!("{}.~1~", dest.to_string_lossy()));
+                if numbered.exists() {
+                    BackupMode::NumberedBackup
+                } else {
+                    BackupMode::SimpleBackup
+                }
+            }
+            other => other,
+        }
