+    fn backup_path_for(backup_mode: BackupMode, backup_path: &Path, suffix: &str) -> Option<PathBuf> {
+        match backup_mode {
+            BackupMode::NoBackup => None,
+            BackupMode::SimpleBackup => Some(Self::simple_backup_path(backup_path, suffix)),
+            BackupMode::NumberedBackup => Some(Self::numbered_backup_path(backup_path)),
+            BackupMode::ExistingBackup => Some(Self::existing_backup_path(backup_path, suffix)),
+        }
+    }
+
+
+    fn simple_backup_path(path: &Path, suffix: &str) -> PathBuf {
+        let mut p = path.to_string_lossy().into_owned();
+        p.push_str(suffix);
+        PathBuf::from(p)
+    }
+
+
+    fn numbered_backup_path(path: &Path) -> PathBuf {
+        for i in 1_u64.. {
+            let path_str = format!("{}.~{}~", path.to_string_lossy(), i);
+            let candidate = Path::new(&path_str);
+            if !candidate.exists() {
+                return candidate.to_path_buf();
+            }
+        }
+        PathBuf::from(format!("{}.~1~", path.to_string_lossy()))
+    }
+
+
+    fn existing_backup_path(path: &Path, suffix: &str) -> PathBuf {
+        let test_path_str = format!("{}.~1~", path.to_string_lossy());
+        let test_path = Path::new(&test_path_str);
+        if test_path.exists() {
+            Self::numbered_backup_path(path)
+        } else {
+            Self::simple_backup_path(path, suffix)
+        }
+    }
+
+
+    fn source_is_simple_backup(source: &Path, target: &Path, suffix: &str) -> bool {
+        let Some(source_name) = source.file_name().and_then(|n| n.to_str()) else {
+            return false;
+        };
+        let Some(target_name) = target.file_name().and_then(|n| n.to_str()) else {
+            return false;
+        };
+        if !source_name.ends_with(suffix) {
+            return false;
+        }
+        let stripped = &source_name[..source_name.len().saturating_sub(suffix.len())];
+        stripped == target_name
+    }
