+    fn apply_destination_backup(&mut self, dest: &Path, is_dest_symlink: bool) -> CopyResult<Option<PathBuf>> {
+        let backup_path = self.resolve_backup_path(dest);
+        if let Some(ref backup_path) = backup_path {
+            if is_dest_symlink {
+                fs::rename(dest, backup_path)?;
+            } else {
+                fs::copy(dest, backup_path)?;
+            }
+            self.remember_backup_if_created(backup_path.clone(), true);
+        }
+        Ok(backup_path)
+    }
