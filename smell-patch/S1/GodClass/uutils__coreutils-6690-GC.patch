+        match self.last_backup_path.as_ref() {
+            Some(path) => path.starts_with(dest.as_os_str()) || path.exists(),
+            None => {
+                let simple = Self::simple_backup_path(dest, &self.options.backup_suffix);
+                simple.exists()
+            }
+        }
