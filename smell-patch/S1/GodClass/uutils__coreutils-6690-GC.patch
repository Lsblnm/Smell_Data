+
+    pub(crate) fn copy_directory_tree(
+        &mut self,
+        root: &Path,
+        target: &Path,
+        source_in_command_line: bool,
+    ) -> CopyResult<()> {
+        if !self.dereference_source(source_in_command_line) && root.is_symlink() {
+            return self.copy_file_entry(root, target, source_in_command_line);
+        }
+
+        if !self.wants_recursive_copy() {
+            return Err(format!("-r not specified; omitting directory {}", root.quote()).into());
+        }
+
+        if crate::copydir::path_has_prefix(target, root)? {
+            return Err(format!(
+                "cannot copy a directory, {}, into itself, {}",
+                root.quote(),
+                target.join(root.file_name().unwrap()).quote()
+            )
+            .into());
+        }
+
+        let tmp = if self.wants_parent_directories() {
+            if target.is_file() {
+                return Err("with --parents, the destination must be a directory".into());
+            }
+            let mut new_target = target.to_path_buf();
+            let source_path = Path::new(root);
+            let relative = if source_path.has_root() && cfg!(unix) {
+                source_path.strip_prefix("/").unwrap_or(source_path)
+            } else {
+                source_path
+            };
+            new_target.push(relative);
+            if let Some(parent) = new_target.parent() {
+                if self.verbose_reporting() {
+                    for (x, y) in aligned_ancestors(root, new_target.as_path()) {
+                        println!("{} -> {}", x.display(), y.display());
+                    }
+                }
+                self.build_owned_directory(&parent.to_path_buf(), true)?;
+            }
+            new_target
+        } else {
+            target.to_path_buf()
+        };
+        let target = tmp.as_path();
+        self.set_current_pair(root, target);
+        self.note_copy_candidates(root, target, source_in_command_line);
+
+        let preserve_hard_links = self.preserve_hard_links();
+        let context = match crate::copydir::Context::new(root, target) {
+            Ok(c) => c,
+            Err(e) => return Err(format!("failed to get current directory {e}").into()),
+        };
+
+        for direntry_result in walkdir::WalkDir::new(root)
+            .same_file_system(self.stay_on_file_system())
+            .follow_links(self.options.dereference)
+        {
+            match direntry_result {
+                Ok(direntry) => {
+                    let entry = crate::copydir::Entry::new(&context, &direntry, self.no_target_dir_mode())?;
+                    self.copy_directory_entry(entry, preserve_hard_links)?;
+                }
+                Err(e) => show_error!("{}", e),
+            }
+        }
+
+        if self.wants_parent_directories() {
+            let dest = target.join(root.file_name().unwrap());
+            copy_attributes(root, dest.as_path(), &self.options.attributes)?;
+            for (x, y) in aligned_ancestors(root, dest.as_path()) {
+                if let Ok(src) = canonicalize(x, MissingHandling::Normal, ResolveMode::Physical) {
+                    copy_attributes(&src, y, &self.options.attributes)?;
+                }
+            }
+        } else {
+            copy_attributes(root, target, &self.options.attributes)?;
+        }
+
+        Ok(())
+    }
+
+
+    fn copy_directory_entry(
+        &mut self,
+        entry: crate::copydir::Entry,
+        preserve_hard_links: bool,
+    ) -> CopyResult<()> {
+        let crate::copydir::Entry {
+            source_absolute,
+            source_relative,
+            local_to_target,
+            target_is_file,
+        } = entry;
+        self.set_current_pair(&source_absolute, &local_to_target);
+
+        if self.should_copy_symlink_object(&source_absolute) {
+            return copy_link(&source_absolute, &local_to_target, self.symlinked_files);
+        }
+
+        if source_absolute.is_dir()
+            && !Self::ends_with_slash_dot(&source_absolute)
+            && !local_to_target.exists()
+        {
+            if target_is_file {
+                return Err("cannot overwrite non-directory with directory".into());
+            } else {
+                self.build_owned_directory(&local_to_target, false)?;
+                if self.verbose_reporting() {
+                    println!("{}", context_for(&source_relative, &local_to_target));
+                }
+                return Ok(());
+            }
+        }
+
+        if !source_absolute.is_dir() {
+            if preserve_hard_links {
+                match self.copy_regular_file_entry(
+                    &source_absolute,
+                    local_to_target.as_path(),
+                    false,
+                ) {
+                    Ok(_) => Ok(()),
+                    Err(err) => {
+                        if source_absolute.is_symlink() {
+                            Ok(())
+                        } else {
+                            Err(err)
+                        }
+                    }
+                }?;
+            } else {
+                match self.copy_regular_file_entry(
+                    &source_absolute,
+                    local_to_target.as_path(),
+                    false,
+                ) {
+                    Ok(_) => {}
+                    Err(Error::IoErrContext(e, _))
+                        if e.kind() == std::io::ErrorKind::PermissionDenied =>
+                    {
+                        show!(uio_error!(
+                            e,
+                            "cannot open {} for reading",
+                            source_relative.quote(),
+                        ));
+                    }
+                    Err(e) => return Err(e),
+                }
+            }
+        }
+        Ok(())
+    }
+
+
+    fn build_owned_directory(&self, path: &PathBuf, recursive: bool) -> CopyResult<()> {
+        let mut builder = fs::DirBuilder::new();
+        builder.recursive(recursive);
+        #[cfg(unix)]
+        {
+            #[allow(clippy::unnecessary_cast)]
+            let mut excluded_perms =
+                if matches!(self.options.attributes.ownership, Preserve::Yes { .. }) {
+                    libc::S_IRWXG | libc::S_IRWXO
+                } else if matches!(self.options.attributes.mode, Preserve::Yes { .. }) {
+                    libc::S_IWGRP | libc::S_IWOTH
+                } else {
+                    0
+                } as u32;
+            excluded_perms |= Self::file_creation_umask();
+            let mode = !excluded_perms & 0o777;
+            std::os::unix::fs::DirBuilderExt::mode(&mut builder, mode);
+        }
+        builder.create(path)?;
+        Ok(())
+    }
+
+
+    fn copy_file_entry(
+        &mut self,
+        source: &Path,
+        dest: &Path,
+        source_in_command_line: bool,
+    ) -> CopyResult<()> {
+        self.set_current_pair(source, dest);
+        self.copy_regular_file_entry(source, dest, source_in_command_line)
+    }
