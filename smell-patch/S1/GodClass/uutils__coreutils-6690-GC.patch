+
+/// Possible arguments for `--reflink`.
+#[derive(Copy, Clone, Eq, PartialEq)]
+pub enum ReflinkMode {
+    Always,
+    Auto,
+    Never,
+}
+
+/// Possible arguments for `--sparse`.
+#[derive(Copy, Clone, Eq, PartialEq)]
+pub enum SparseMode {
+    Always,
+    Auto,
+    Never,
+}
+
+/// Enum representing various debug states of the offload and reflink actions.
+#[derive(Debug)]
+#[allow(dead_code)] // All of them are used on Linux
+pub(crate) enum OffloadReflinkDebug {
+    Unknown,
+    No,
+    Yes,
+    Avoided,
+    Unsupported,
+}
+
+/// Enum representing various debug states of the sparse detection.
+#[derive(Debug)]
+#[allow(dead_code)] // silent for now until we use them
+pub(crate) enum SparseDebug {
+    Unknown,
+    No,
+    Zeros,
+    SeekHole,
+    SeekHoleZeros,
+    Unsupported,
+}
+
+/// Struct that contains the debug state for each action in a file copy operation.
+#[derive(Debug)]
+pub(crate) struct CopyDebug {
+    pub offload: OffloadReflinkDebug,
+    pub reflink: OffloadReflinkDebug,
+    pub sparse_detection: SparseDebug,
+}
+
+impl OffloadReflinkDebug {
+    pub(crate) fn to_string(&self) -> &'static str {
+        match self {
+            Self::No => "no",
+            Self::Yes => "yes",
+            Self::Avoided => "avoided",
+            Self::Unsupported => "unsupported",
+            Self::Unknown => "unknown",
+        }
+    }
+}
+
+impl SparseDebug {
+    pub(crate) fn to_string(&self) -> &'static str {
+        match self {
+            Self::No => "no",
+            Self::Zeros => "zeros",
+            Self::SeekHole => "SEEK_HOLE",
+            Self::SeekHoleZeros => "SEEK_HOLE + zeros",
+            Self::Unsupported => "unsupported",
+            Self::Unknown => "unknown",
+        }
+    }
+}
+
+/// Error raised while copying file contents with platform-specific strategies.
+pub(crate) enum CopyOnWriteError {
+    Io(io::Error),
+    Message(String),
+}
+
+impl From<io::Error> for CopyOnWriteError {
+    fn from(err: io::Error) -> Self {
+        Self::Io(err)
+    }
+}
+
+impl From<String> for CopyOnWriteError {
+    fn from(message: String) -> Self {
+        Self::Message(message)
+    }
+}
+
+impl From<&str> for CopyOnWriteError {
+    fn from(message: &str) -> Self {
+        Self::Message(message.to_string())
+    }
+}
+
+/// Current process umask, restored immediately after being read.
+pub(crate) fn file_creation_umask() -> u32 {
+    #[cfg(unix)]
+    {
+        let mask = unsafe { libc::umask(0) };
+        unsafe { libc::umask(mask) };
+        mask as u32
+    }
+    #[cfg(not(unix))]
+    {
+        0
+    }
+}
