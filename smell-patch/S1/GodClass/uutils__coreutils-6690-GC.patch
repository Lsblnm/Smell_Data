+
+    fn should_unlink_before_open(&self, dest: &Path) -> bool {
+        if !Self::file_or_symlink_exists(dest) {
+            return false;
+        }
+        match self.options.overwrite {
+            OverwriteMode::Clobber(ClobberMode::RemoveDestination) => true,
+            OverwriteMode::Clobber(ClobberMode::Force) => {
+                Self::dest_is_unwritable(dest) || dest.is_symlink()
+            }
+            OverwriteMode::Interactive(ClobberMode::RemoveDestination) => true,
+            _ => false,
+        }
+    }
