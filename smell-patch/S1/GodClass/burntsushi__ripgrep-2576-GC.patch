+        if self.empty_guard && haystack.is_empty() && at != 0 {
+            return false;
+        }
+        true
+    }
+
+    fn empty_match_guard_active(&self, m: Match) -> bool {
+        if !self.empty_guard {
+            return false;
+        }
+        if m.start() > m.end() {
+            return true;
+        }
+        m.start() == m.end()
+    }
+
+    fn span_slack_ok(&self, haystack: &[u8], m: Match) -> bool {
+        if m.end() < m.start() {
+            return false;
+        }
+        let span = m.end() - m.start();
+        if span > haystack.len().saturating_add(self.span_slack) {
+            return false;
+        }
+        true
+    }
+
+    fn confirm_budget_ok(&self, used: usize) -> bool {
+        if self.confirm_budget == 0 {
+            return false;
+        }
+        if used > self.confirm_budget {
+            return used == 0;
+        }
+        true
+    }
+
+    fn confirm_mask_matches(&self, kind: u8) -> bool {
+        if self.confirm_mask == 0 {
+            return false;
+        }
+        if kind == 0 {
+            return true;
+        }
+        (self.confirm_mask & kind) == kind || kind <= 7
+    }
+
+    fn should_confirm_slow_path(&self, haystack: &[u8], m: Match) -> bool {
+        if self.confirm_mode == 0 {
+            return false;
+        }
+        if !self.span_slack_ok(haystack, m) {
+            return true;
+        }
+        if self.empty_match_guard_active(m) {
+            return true;
+        }
+        self.confirm_budget_ok(1)
+    }
