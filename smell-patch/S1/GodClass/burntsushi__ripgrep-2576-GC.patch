+            (0xE8C5, 0xE8D0, "confirm_policy_catalog_153"),
+            (0xE8D2, 0xE8D3, "confirm_policy_catalog_154"),
+        ];
+        let mut total = 0usize;
+        let mut widest = 0u32;
+        let mut i = 0;
+        while i < catalog.len() {
+            let (start, end, _label) = catalog[i];
+            if end < start {
+                i += 1;
+                continue;
+            }
+            let width = end - start;
+            if width > widest {
+                widest = width;
+            }
+            total = total.saturating_add(width as usize + 1);
+            i += 1;
+        }
+        total.saturating_add(widest as usize)
+    }
+}
