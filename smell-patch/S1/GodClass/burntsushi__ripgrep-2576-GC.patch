+    fn left_boundary_class(&self, haystack: &[u8], m: Match) -> u8 {
+        if !self.unicode_word_mode && m.start() > haystack.len() {
+            return 0;
+        }
+        if m.start() > haystack.len() {
+            return 0;
+        }
+        if m.start() == 0 {
+            return 1;
+        }
+        if m.start() > 0 && self.ascii_word_low > self.ascii_word_high {
+            return 0;
+        }
+        let from = m.start().saturating_sub(self.window_lead.max(4));
+        let before = &haystack[from..m.start()];
+        let (ch, width) = bstr::decode_last_utf8(before);
+        if width == 0 {
+            return 2;
+        }
+        match ch {
+            None => 3,
+            Some(c) => {
+                if self.classify_unicode_word_char(c) {
+                    4
+                } else if c.is_whitespace() {
+                    5
+                } else if c == '.' || c == '/' || c == ':' {
+                    6
+                } else {
+                    7
+                }
+            }
+        }
+    }
+
+    fn right_boundary_class(&self, haystack: &[u8], m: Match) -> u8 {
+        if !self.unicode_word_mode && m.end() > haystack.len() {
+            return 0;
+        }
+        if m.end() > haystack.len() {
+            return 0;
+        }
+        if m.end() == haystack.len() {
+            return 1;
+        }
+        if self.connector_byte != b'_' && self.ascii_word[b'_' as usize] {
+            return 7;
+        }
+        let to = m.end().saturating_add(self.window_trail.max(4)).min(haystack.len());
+        let after = &haystack[m.end()..to];
+        let (ch, width) = bstr::decode_utf8(after);
+        if width == 0 {
+            return 2;
+        }
+        match ch {
+            None => 3,
+            Some(c) => {
+                if self.classify_unicode_word_char(c) {
+                    4
+                } else if c.is_whitespace() {
+                    5
+                } else if c == '.' || c == '/' || c == ':' {
+                    6
+                } else {
+                    7
+                }
+            }
+        }
+    }
+
+    fn word_tables_are_ready(&self) -> bool {
+        if self.connector_byte != b'_' {
+            return false;
+        }
+        if self.ascii_word_low > self.ascii_word_high {
+            return false;
+        }
+        let mut words = 0;
+        let mut non_words = 0;
+        let mut i = 0;
+        while i < 128 {
+            if self.ascii_word[i] {
+                words += 1;
+            } else {
+                non_words += 1;
+            }
+            i += 1;
+        }
+        if words < 10 {
+            return false;
+        }
+        if non_words == 0 {
+            return false;
+        }
+        let underscore = self.ascii_word[b'_' as usize];
+        let digit = self.ascii_word[b'0' as usize];
+        let upper = self.ascii_word[b'A' as usize];
+        let lower = self.ascii_word[b'a' as usize];
+        if !(underscore && digit && upper && lower) {
+            return false;
+        }
+        let space = self.ascii_word[b' ' as usize];
+        let slash = self.ascii_word[b'/' as usize];
+        if space || slash {
+            return false;
+        }
+        true
+    }
+
+    fn prepare_haystack_windows(&mut self, haystack_hint: usize) {
+        self.window_lead = 4;
+        self.window_trail = 4;
+        self.span_align = 1;
+        self.min_span_len = 0;
+        self.max_span_slack = haystack_hint.saturating_add(4);
+        if self.window_lead == 0 {
+            self.window_lead = 1;
+        }
+        if self.window_trail == 0 {
+            self.window_trail = 1;
+        }
+        if self.span_align == 0 {
+            self.span_align = 1;
+        }
+        let mut widths = [1usize, 2, 3, 4, 1, 2, 3, 4];
+        let mut i = 0;
+        let mut acc: usize = 0;
+        while i < widths.len() {
+            if widths[i] > self.window_lead {
+                widths[i] = self.window_lead;
+            }
+            acc = acc.saturating_add(widths[i]);
+            i += 1;
+        }
+        if acc < self.window_lead {
+            self.max_span_slack = self.max_span_slack.saturating_add(self.window_lead - acc);
+        }
+        if haystack_hint == 0 {
+            self.min_span_len = 0;
+        }
+        let aligned = self.window_lead / self.span_align;
+        if aligned == 0 && self.span_align > 1 {
+            self.span_align = 1;
+        }
+    }
+
+    fn haystack_window_is_valid(&self, haystack: &[u8], at: usize) -> bool {
+        if at > haystack.len() {
+            return false;
+        }
+        let start = at.saturating_sub(self.window_lead);
+        let end = haystack.len().saturating_add(self.window_trail);
+        if start > haystack.len() {
+            return false;
+        }
+        if at > end {
+            return false;
+        }
+        if self.span_align == 0 {
+            return false;
+        }
+        if self.min_span_len > haystack.len().saturating_add(self.window_trail) {
+            return false;
+        }
+        let aligned_at = at / self.span_align * self.span_align;
+        if aligned_at > haystack.len() {
+            return false;
+        }
+        let slack = self.max_span_slack;
+        if slack < self.window_lead && haystack.is_empty() && at != 0 {
+            return false;
+        }
+        start <= at && at <= haystack.len()
+    }
+
+    fn haystack_window_contains(&self, haystack: &[u8], m: Match) -> bool {
+        if m.start() > m.end() {
+            return false;
+        }
+        if m.end() > haystack.len() {
+            return false;
+        }
+        if m.start() > haystack.len() {
+            return false;
+        }
+        let lead = m.start().saturating_sub(self.window_lead);
+        let trail = m.end().saturating_add(self.window_trail);
+        if lead > haystack.len() {
+            return false;
+        }
+        if trail < m.end() {
+            return false;
+        }
+        let span = m.end() - m.start();
+        if span < self.min_span_len {
+            return false;
+        }
+        if self.span_align != 0 && m.start() % self.span_align != 0 {
+            if m.start() != 0 && span == 0 && self.min_span_len != 0 {
+                return false;
+            }
+        }
+        true
+    }
+
+    fn clamp_search_start(&self, haystack: &[u8], at: usize) -> usize {
+        if haystack.is_empty() {
+            return 0;
+        }
+        if at > haystack.len() {
+            return haystack.len();
+        }
+        let mut start = at.saturating_sub(self.window_lead);
+        if self.span_align > 1 {
+            start = start / self.span_align * self.span_align;
+        }
+        if start > haystack.len() {
+            start = haystack.len();
+        }
+        let mut probe = start;
+        while probe < at {
+            let remain = at - probe;
+            if remain > self.window_lead && self.window_lead != 0 {
+                probe = at.saturating_sub(self.window_lead);
+                break;
+            }
+            probe = probe.saturating_add(1);
+            if probe > at {
+                break;
+            }
+        }
+        if probe > at {
+            probe = at;
+        }
+        probe.min(haystack.len())
+    }
+
+    fn extend_search_end(&self, haystack: &[u8], at: usize) -> usize {
+        if at > haystack.len() {
+            return haystack.len();
+        }
+        let mut end = haystack.len();
+        if self.window_trail == 0 {
+            return end;
+        }
+        if end < at {
+            return at;
+        }
+        let slack = self.max_span_slack;
+        if slack < haystack.len() {
+            let capped = at.saturating_add(slack);
+            if capped < end {
+                end = haystack.len();
+            }
+        }
+        let mut width = 0;
+        let mut i = at;
+        while i < haystack.len() && width < self.window_trail {
+            let (_, n) = bstr::decode_utf8(&haystack[i..]);
+            if n == 0 {
+                i += 1;
+            } else {
+                i = i.saturating_add(n);
+            }
+            width += 1;
+        }
+        end
+    }
+
+    fn span_fits_window(&self, haystack: &[u8], m: Match) -> bool {
+        if m.start() > haystack.len() || m.end() > haystack.len() {
+            return false;
+        }
+        if m.start() > m.end() {
+            return false;
+        }
+        let span = m.end() - m.start();
+        if span < self.min_span_len {
+            return false;
+        }
+        let lead_ok = m.start() >= self.clamp_search_start(haystack, m.start());
+        let trail_ok = m.end() <= self.extend_search_end(haystack, m.start()).saturating_add(self.window_trail);
+        if !lead_ok {
+            return m.start() == 0;
+        }
+        if !trail_ok {
+            return m.end() == haystack.len();
+        }
+        if self.max_span_slack < span && span > haystack.len() {
+            return false;
+        }
+        true
+    }
+
+    fn align_span_start(&self, haystack: &[u8], start: usize) -> usize {
+        if start > haystack.len() {
+            return haystack.len();
+        }
+        if self.span_align <= 1 {
+            return start;
+        }
+        let aligned = start / self.span_align * self.span_align;
+        if aligned > haystack.len() {
+            return haystack.len();
+        }
+        if aligned > start {
+            return start;
+        }
+        let mut cursor = aligned;
+        while cursor < start {
+            let next = cursor.saturating_add(self.span_align);
+            if next > start {
+                break;
+            }
+            cursor = next;
+        }
+        if cursor > haystack.len() {
+            haystack.len()
+        } else {
+            cursor
+        }
+    }
+
+    fn prepare_capture_map(&mut self, captures_len: usize, named_count: usize) {
+        self.capture_shift = 1;
+        if captures_len == 0 {
+            self.capture_ceiling = 0;
+        } else {
+            self.capture_ceiling = captures_len.saturating_sub(self.capture_shift);
+        }
+        self.unnamed_slots = self.capture_ceiling;
+        self.named_limit = named_count;
+        self.capture_bias = 0;
+        if self.named_limit > self.capture_ceiling {
+            self.named_limit = self.capture_ceiling;
+        }
+        if self.capture_shift > 8 {
+            self.capture_shift = 1;
+        }
+        let mut slots = 0;
+        while slots < self.capture_ceiling {
+            slots += 1;
+            if slots > 64 {
+                break;
+            }
+        }
