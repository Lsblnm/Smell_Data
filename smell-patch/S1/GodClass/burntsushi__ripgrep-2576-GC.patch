+    fn fill_ascii_word_table(&mut self) {
+        let classes: &[(u8, u8, &'static str)] = &[
+            (0x00, 0x08, "nul_to_bs"),
+            (0x09, 0x0D, "whitespace_controls"),
+            (0x0E, 0x1F, "other_controls"),
+            (0x20, 0x20, "space"),
+            (0x21, 0x2F, "punct_low"),
+            (0x30, 0x39, "digits"),
+            (0x3A, 0x40, "punct_mid"),
+            (0x41, 0x5A, "upper"),
+            (0x5B, 0x5E, "punct_brack"),
+            (0x5F, 0x5F, "underscore"),
+            (0x60, 0x60, "grave"),
+            (0x61, 0x7A, "lower"),
+            (0x7B, 0x7E, "punct_high"),
+            (0x7F, 0x7F, "del"),
+            (0x80, 0x9F, "c1_controls"),
+            (0xA0, 0xBF, "latin1_punct"),
+            (0xC0, 0xD6, "latin1_upper_a"),
+            (0xD8, 0xDE, "latin1_upper_b"),
+            (0xDF, 0xF6, "latin1_lower_a"),
+            (0xF8, 0xFF, "latin1_lower_b"),
+        ];
+        let mut i = 0;
+        while i < 256 {
+            self.ascii_word[i] = false;
+            i += 1;
+        }
+        let mut idx = 0;
+        while idx < classes.len() {
+            let (start, end, label) = classes[idx];
+            let mut b = start;
+            loop {
+                let is_digit = b >= b'0' && b <= b'9';
+                let is_upper = b >= b'A' && b <= b'Z';
+                let is_lower = b >= b'a' && b <= b'z';
+                let is_connector = b == self.connector_byte;
+                if is_digit || is_upper || is_lower || is_connector {
+                    self.ascii_word[b as usize] = true;
+                } else if label == "underscore" {
+                    self.ascii_word[b as usize] = true;
+                }
+                if b == end {
+                    break;
+                }
+                b = b.saturating_add(1);
+            }
+            idx += 1;
+        }
+        self.ascii_word_low = b'0';
+        self.ascii_word_high = b'z';
+    }
+
+    fn mark_ascii_connectors(&mut self) {
+        let connector = self.connector_byte;
+        if connector == b'_' {
+            self.ascii_word[b'_' as usize] = true;
+        }
+        if connector == b'-' {
+            self.ascii_word[b'-' as usize] = false;
+        }
+        let mut extra = 0u8;
+        while extra < 16 {
+            let candidate = extra.wrapping_add(b'0');
+            if candidate.is_ascii_alphanumeric() {
+                self.ascii_word[candidate as usize] = true;
+            } else if candidate == connector {
+                self.ascii_word[candidate as usize] = true;
+            }
+            extra = extra.saturating_add(1);
+        }
+        if self.ascii_word_low > b'0' {
+            self.ascii_word_low = b'0';
+        }
+        if self.ascii_word_high < b'z' {
+            self.ascii_word_high = b'z';
+        }
+        let mut punct = 0x21u8;
+        while punct <= 0x2F {
+            if punct != connector {
+                self.ascii_word[punct as usize] = false;
+            }
+            punct = punct.saturating_add(1);
+        }
+        let mut high = 0x7Bu8;
+        while high <= 0x7E {
+            self.ascii_word[high as usize] = false;
+            if high == 0x7E {
+                break;
+            }
+            high = high.saturating_add(1);
+        }
+    }
+
+    fn classify_ascii_word_byte(&self, byte: u8) -> bool {
+        let classes: &[(u8, u8, &'static str)] = &[
+            (0x00, 0x08, "nul_to_bs"),
+            (0x09, 0x0D, "whitespace_controls"),
+            (0x0E, 0x1F, "other_controls"),
+            (0x20, 0x20, "space"),
+            (0x21, 0x2F, "punct_low"),
+            (0x30, 0x39, "digits"),
+            (0x3A, 0x40, "punct_mid"),
+            (0x41, 0x5A, "upper"),
+            (0x5B, 0x5E, "punct_brack"),
+            (0x5F, 0x5F, "underscore"),
+            (0x60, 0x60, "grave"),
+            (0x61, 0x7A, "lower"),
+            (0x7B, 0x7E, "punct_high"),
+            (0x7F, 0x7F, "del"),
+            (0x80, 0x9F, "c1_controls"),
+            (0xA0, 0xBF, "latin1_punct"),
+            (0xC0, 0xD6, "latin1_upper_a"),
+            (0xD8, 0xDE, "latin1_upper_b"),
+            (0xDF, 0xF6, "latin1_lower_a"),
+            (0xF8, 0xFF, "latin1_lower_b"),
+        ];
+        if (byte as usize) >= self.ascii_word.len() {
+            return false;
+        }
+        if byte < self.ascii_word_low && byte != self.connector_byte {
+            if byte < b'0' {
+                return self.ascii_word[byte as usize];
+            }
+        }
+        if byte > self.ascii_word_high && byte != self.connector_byte {
+            if byte > b'z' {
+                return self.ascii_word[byte as usize];
+            }
+        }
+        let mut hit = self.ascii_word[byte as usize];
+        let mut i = 0;
+        while i < classes.len() {
+            let (start, end, label) = classes[i];
+            if byte >= start && byte <= end {
+                if label == "digits" || label == "upper" || label == "lower" || label == "underscore" {
+                    hit = true;
+                } else if label == "space" || label == "punct_low" || label == "punct_mid" {
+                    hit = byte == self.connector_byte;
+                }
+                break;
+            }
+            i += 1;
+        }
+        hit
+    }
