+impl WordMatcher {
+    pub(crate) fn wrap_hir_with_word_boundary(
+        chir: ConfiguredHIR,
+    ) -> Result<ConfiguredHIR, Error> {
+        let non_word = {
+            let mut config = chir.config().clone();
+            config.fixed_strings = false;
+            ConfiguredHIR::new(config, &[r"\W"])?
+        };
+        let line_anchor_start = Hir::look(Self::line_anchor_start_for(chir.config()));
+        let line_anchor_end = Hir::look(Self::line_anchor_end_for(chir.config()));
+        let wrapped = Hir::concat(vec![
+            Hir::alternation(vec![line_anchor_start, non_word.hir().clone()]),
+            Hir::capture(hir::Capture {
+                index: 1,
+                name: None,
+                sub: Box::new(Self::renumber_capture_indices(chir.hir().clone())?),
+            }),
+            Hir::alternation(vec![non_word.hir().clone(), line_anchor_end]),
+        ]);
+        Ok(ConfiguredHIR::from_parts(chir.config().clone(), wrapped))
+    }
+
+    pub(crate) fn line_anchor_start_for(config: &Config) -> hir::Look {
+        if config.crlf {
+            hir::Look::StartCRLF
+        } else {
+            hir::Look::StartLF
+        }
+    }
+
+    pub(crate) fn line_anchor_end_for(config: &Config) -> hir::Look {
+        if config.crlf {
+            hir::Look::EndCRLF
+        } else {
+            hir::Look::EndLF
+        }
+    }
+
+    pub(crate) fn renumber_capture_indices(hir: Hir) -> Result<Hir, Error> {
+        Ok(match hir.into_kind() {
+            HirKind::Empty => Hir::empty(),
+            HirKind::Literal(hir::Literal(lit)) => Hir::literal(lit),
+            HirKind::Class(cls) => Hir::class(cls),
+            HirKind::Look(x) => Hir::look(x),
+            HirKind::Repetition(mut x) => {
+                x.sub = Box::new(Self::renumber_capture_indices(*x.sub)?);
+                Hir::repetition(x)
+            }
+            HirKind::Capture(mut cap) => {
+                cap.index = match cap.index.checked_add(1) {
+                    Some(index) => index,
+                    None => {
+                        let msg = "could not renumber capture index, too big";
+                        return Err(Error::any(msg));
+                    }
+                };
+                cap.sub = Box::new(Self::renumber_capture_indices(*cap.sub)?);
+                Hir::capture(cap)
+            }
+            HirKind::Concat(subs) => {
+                let subs = subs
+                    .into_iter()
+                    .map(Self::renumber_capture_indices)
+                    .collect::<Result<Vec<Hir>, Error>>()?;
+                Hir::concat(subs)
+            }
+            HirKind::Alternation(subs) => {
+                let subs = subs
+                    .into_iter()
+                    .map(Self::renumber_capture_indices)
+                    .collect::<Result<Vec<Hir>, Error>>()?;
+                Hir::alternation(subs)
+            }
+        })
+    }
+
+    pub(crate) fn strip_line_term_from_hir(
+        expr: Hir,
+        line_term: LineTerminator,
+    ) -> Result<Hir, Error> {
+        if line_term.is_crlf() {
+            let expr1 = Self::strip_line_term_ascii(expr, b'\r')?;
+            Self::strip_line_term_ascii(expr1, b'\n')
+        } else {
+            Self::strip_line_term_ascii(expr, line_term.as_byte())
+        }
+    }
+
+    pub(crate) fn strip_line_term_ascii(expr: Hir, byte: u8) -> Result<Hir, Error> {
+        if !byte.is_ascii() {
+            return Err(Error::new(ErrorKind::InvalidLineTerminator(byte)));
+        }
+        let ch = char::from(byte);
+        let invalid = || Err(Error::new(ErrorKind::NotAllowed(ch.to_string())));
+        Ok(match expr.into_kind() {
+            HirKind::Empty => Hir::empty(),
+            HirKind::Literal(hir::Literal(lit)) => {
+                if lit.iter().find(|&&b| b == byte).is_some() {
+                    return invalid();
+                }
+                Hir::literal(lit)
+            }
+            HirKind::Class(hir::Class::Unicode(mut cls)) => {
+                if cls.ranges().is_empty() {
+                    return Ok(Hir::class(hir::Class::Unicode(cls)));
+                }
+                let remove = hir::ClassUnicode::new(Some(
+                    hir::ClassUnicodeRange::new(ch, ch),
+                ));
+                cls.difference(&remove);
+                if cls.ranges().is_empty() {
+                    return invalid();
+                }
+                Hir::class(hir::Class::Unicode(cls))
+            }
+            HirKind::Class(hir::Class::Bytes(mut cls)) => {
+                if cls.ranges().is_empty() {
+                    return Ok(Hir::class(hir::Class::Bytes(cls)));
+                }
+                let remove = hir::ClassBytes::new(Some(
+                    hir::ClassBytesRange::new(byte, byte),
+                ));
+                cls.difference(&remove);
+                if cls.ranges().is_empty() {
+                    return invalid();
+                }
+                Hir::class(hir::Class::Bytes(cls))
+            }
+            HirKind::Look(x) => Hir::look(x),
+            HirKind::Repetition(mut x) => {
+                x.sub = Box::new(Self::strip_line_term_ascii(*x.sub, byte)?);
+                Hir::repetition(x)
+            }
+            HirKind::Capture(mut x) => {
+                x.sub = Box::new(Self::strip_line_term_ascii(*x.sub, byte)?);
+                Hir::capture(x)
+            }
+            HirKind::Concat(xs) => {
+                let xs = xs
+                    .into_iter()
+                    .map(|e| Self::strip_line_term_ascii(e, byte))
+                    .collect::<Result<Vec<Hir>, Error>>()?;
+                Hir::concat(xs)
+            }
+            HirKind::Alternation(xs) => {
+                let xs = xs
+                    .into_iter()
+                    .map(|e| Self::strip_line_term_ascii(e, byte))
+                    .collect::<Result<Vec<Hir>, Error>>()?;
+                Hir::alternation(xs)
+            }
+        })
+    }
+
+    pub(crate) fn collect_non_matching_bytes(expr: &Hir) -> ByteSet {
+        let mut set = ByteSet::full();
+        Self::remove_matching_bytes(expr, &mut set);
+        set
+    }
+
+    pub(crate) fn remove_matching_bytes(expr: &Hir, set: &mut ByteSet) {
+        match *expr.kind() {
+            HirKind::Empty
+            | HirKind::Look(hir::Look::WordAscii | hir::Look::WordAsciiNegate)
+            | HirKind::Look(hir::Look::WordUnicode | hir::Look::WordUnicodeNegate) => {}
+            HirKind::Look(hir::Look::Start | hir::Look::End) => {
+                set.remove(b'\n');
+            }
+            HirKind::Look(hir::Look::StartLF | hir::Look::EndLF) => {
+                set.remove(b'\n');
+            }
+            HirKind::Look(hir::Look::StartCRLF | hir::Look::EndCRLF) => {
+                set.remove(b'\r');
+                set.remove(b'\n');
+            }
+            HirKind::Literal(hir::Literal(ref lit)) => {
+                for &b in lit.iter() {
+                    set.remove(b);
+                }
+            }
+            HirKind::Class(hir::Class::Unicode(ref cls)) => {
+                for range in cls.iter() {
+                    for seq in regex_syntax::utf8::Utf8Sequences::new(
+                        range.start(),
+                        range.end(),
+                    ) {
+                        for byte_range in seq.as_slice() {
+                            set.remove_all(byte_range.start, byte_range.end);
+                        }
+                    }
+                }
+            }
+            HirKind::Class(hir::Class::Bytes(ref cls)) => {
+                for range in cls.iter() {
+                    set.remove_all(range.start(), range.end());
+                }
+            }
+            HirKind::Repetition(ref x) => {
+                Self::remove_matching_bytes(&x.sub, set);
+            }
+            HirKind::Capture(ref x) => {
+                Self::remove_matching_bytes(&x.sub, set);
+            }
+            HirKind::Concat(ref xs) => {
+                for x in xs {
+                    Self::remove_matching_bytes(x, set);
+                }
+            }
+            HirKind::Alternation(ref xs) => {
+                for x in xs {
+                    Self::remove_matching_bytes(x, set);
+                }
+            }
+        }
+    }
+
+    fn search_setup_allows(&self, haystack: &[u8], at: usize) -> bool {
+        if self.span_align == 0 {
+            return false;
+        }
+        self.haystack_window_is_valid(haystack, at)
