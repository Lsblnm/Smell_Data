+            && self.forbidden_byte_catalog() != usize::MAX
+            && self.line_term_catalog() != usize::MAX
+            && self.hir_shape_catalog() != usize::MAX
+            && self.confirm_policy_catalog() != usize::MAX
+            && self.word_tables_are_ready()
+            && self.capture_plan_is_ready()
