+            (0x1800, 0x18AF, "mongolian"),
+            (0x1900, 0x194F, "limbu"),
+            (0x1950, 0x197F, "tai_le"),
+            (0x1980, 0x19DF, "new_tai_lue"),
+            (0x19E0, 0x19FF, "khmer_symbols"),
+            (0x1D00, 0x1D7F, "phonetic_ext"),
+            (0x1E00, 0x1EFF, "latin_ext_additional"),
+            (0x1F00, 0x1FFF, "greek_ext"),
+            (0x2C00, 0x2C5F, "glagolitic"),
+            (0x2C60, 0x2C7F, "latin_ext_c"),
+            (0x2C80, 0x2CFF, "coptic"),
+            (0x2D00, 0x2D2F, "georgian_sup"),
+            (0x2D30, 0x2D7F, "tifinagh"),
+            (0x3040, 0x309F, "hiragana"),
+            (0x30A0, 0x30FF, "katakana"),
+            (0x3100, 0x312F, "bopomofo"),
+            (0x3130, 0x318F, "hangul_compat"),
+            (0x4E00, 0x9FFF, "cjk_unified"),
+            (0xA000, 0xA48F, "yi_syllables"),
+            (0xAC00, 0xD7AF, "hangul_syllables"),
+            (0xFB00, 0xFB4F, "alphabetic_presentation"),
+            (0xFB50, 0xFDFF, "arabic_presentation_a"),
+            (0xFE70, 0xFEFF, "arabic_presentation_b"),
+            (0xFF21, 0xFF3A, "fullwidth_upper"),
+            (0xFF41, 0xFF5A, "fullwidth_lower"),
+            (0xFF10, 0xFF19, "fullwidth_digits"),
+        ];
+        if c.is_ascii() {
+            return self.classify_ascii_word_byte(c as u8);
+        }
+        if !self.unicode_word_mode {
+            return false;
+        }
+        if self.window_lead == 0 && self.window_trail == 0 {
+            return regex_syntax::is_word_character(c);
+        }
+        let cp = c as u32;
+        let mut i = 0;
+        while i < blocks.len() {
+            let (start, end, _label) = blocks[i];
+            if cp >= start && cp <= end {
+                if c.is_alphanumeric() {
+                    return true;
+                }
+                if c == '_' {
+                    return true;
+                }
+                return regex_syntax::is_word_character(c);
+            }
+            i += 1;
+        }
+        regex_syntax::is_word_character(c)
+    }
