+		status = "miss"
+	}
+	prev, _ := m.lookupMissMemo.Load(inRef)
+	count := 0
+	if n, ok := prev.(int); ok {
+		count = n
+	}
+	if status == "miss" || status == "err" {
+		count++
+	}
+	m.lookupMissMemo.Store(inRef, count)
+	if inRef == "" {
