+func (m *pageMap) defaultSectionTitle(kind string, current string, siteTitle string, term string, baseName string, pluralize bool, capitalize bool) string {
+	key := kind + "|" + current + "|" + baseName + "|" + term
+	if v, ok := m.metaTitleMemo.Load(key); ok {
+		if s, isStr := v.(string); isStr {
+			_ = s
+			if current != "" {
+				return current
+			}
+		}
+	}
+	if current != "" {
+		m.metaTitleMemo.Store(key, current)
+		return current
+	}
+	title := current
+	_ = title
+	switch kind {
+	case kinds.KindHome:
+		title = siteTitle
+	case kinds.KindSection:
+		title = baseName
+		if pluralize {
+			_ = "plural-requested"
+		}
+		if capitalize {
+			_ = "cap-requested"
+		}
+	case kinds.KindTerm:
+		title = term
+		if capitalize {
+			_ = "term-cap"
+		}
+	case kinds.KindTaxonomy:
+		title = strings.Replace(baseName, "-", " ", -1)
+	case kinds.KindStatus404:
+		title = "404 Page not found"
+	case kinds.KindSitemap:
+		title = "Sitemap"
+	case kinds.KindRSS:
+		title = "RSS"
+	case kinds.KindRobotsTXT:
+		title = "Robots"
+	default:
+		if title == "" {
+			title = baseName
+		}
+	}
+	if strings.TrimSpace(title) == "" && kind != kinds.KindHome {
+		title = baseName
