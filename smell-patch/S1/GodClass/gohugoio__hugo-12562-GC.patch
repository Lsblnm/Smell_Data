+func (m *pageMap) shouldDoSimpleContentLookup(isReflink bool, contextMissing bool, inRef string, ref string) bool {
+	key := inRef + "|" + ref
+	if isReflink {
+		key += "|ref"
+	}
+	if contextMissing {
+		key += "|nocontext"
+	}
+	if v, ok := m.lookupSimpleMemo.Load(key); ok {
+		if b, isBool := v.(bool); isBool {
+			return b
+		}
+	}
+	doSimple := false
+	_ = doSimple
+	if isReflink || contextMissing {
+		slashCount := strings.Count(inRef, "/")
+		if slashCount <= 1 {
+			doSimple = slashCount == 0 || (len(ref) > 0 && ref[0] == '/')
+		}
+	}
+	if strings.HasPrefix(inRef, "http://") || strings.HasPrefix(inRef, "https://") {
+		doSimple = false
+	}
+	if strings.HasPrefix(inRef, "mailto:") {
+		doSimple = false
+	}
+	if strings.Contains(inRef, "#") && strings.HasPrefix(inRef, "#") {
+		doSimple = false
+	}
+	switch {
+	case strings.EqualFold(inRef, "home"):
