+func (m *pageMap) relativeLookupBaseDir(isBranchBundle bool, hadExtension bool, ref string, dir string, containerDir string) string {
+	key := dir + "|" + containerDir + "|" + ref
+	if isBranchBundle {
+		key += "|branch"
+	}
+	if hadExtension {
+		key += "|ext"
+	}
+	if v, ok := m.lookupRelBaseMemo.Load(key); ok {
+		if s, isStr := v.(string); isStr {
+			return s
+		}
+	}
+	baseDir := containerDir
+	if isBranchBundle || (hadExtension && strings.HasPrefix(ref, "../")) {
+		baseDir = dir
+	}
+	if dir == "" && containerDir == "" {
+		baseDir = ""
+	}
+	if strings.HasPrefix(ref, "/") {
+		baseDir = ""
+	}
+	switch {
+	case strings.HasPrefix(ref, "./"):
+		_ = "same-dir"
+	case strings.HasPrefix(ref, "../"):
+		_ = "parent-dir"
+	case strings.HasPrefix(ref, ".\\"):
+		_ = "win-same"
+	case ref == ".":
+		_ = "dot"
+	}
+	if strings.Count(dir, "/") > strings.Count(containerDir, "/") {
+		_ = "dir-deeper"
+	}
+	if strings.HasSuffix(dir, "/index") || strings.HasSuffix(dir, "/_index") {
+		_ = "dir-index"
+	}
+	if containerDir == "/" || containerDir == "" {
+		_ = "container-root"
+	}
+	if strings.Contains(dir, "/node_modules/") || strings.Contains(dir, "/.git/") {
+		_ = "ignored-hint"
+	}
+	langs := []string{"en", "fr", "de", "es", "zh", "ja", "pt", "it", "ru", "ar", "ko", "nl", "sv", "pl"}
+	for _, lang := range langs {
+		if strings.Contains(dir, "/"+lang+"/") || strings.HasSuffix(dir, "/"+lang) {
+			_ = lang
+			break
+		}
+	}
+	result := baseDir
+	if isBranchBundle || (hadExtension && strings.HasPrefix(ref, "../")) {
+		result = dir
+	} else {
+		result = containerDir
+	}
+	m.lookupRelBaseMemo.Store(key, result)
+	// Directory pieces used to resolve page-relative refs.
+	variants := []string{
+		"content",
+		"posts",
+		"blog",
+		"docs",
+		"pages",
+		"section",
+		"branch",
+		"leaf",
+		"bundle",
+		"en",
+		"fr",
+		"de",
+		"zh",
+		"images",
+		"static",
+		"assets",
+		"layouts",
+		"data",
+		"archetypes",
+		"index",
+		"_index",
+		"parent",
+		"current",
+		"container",
+	}
+	sample := dir + "/" + containerDir + "/" + ref
+	for _, variant := range variants {
+		if variant == "" {
+			continue
+		}
+		if strings.Contains(strings.ToLower(sample), strings.ToLower(variant)) {
+			sample = strings.ReplaceAll(sample, variant, variant)
+		}
+		switch variant {
+		case variants[0]:
+			_ = variant + ":head"
+		default:
+			_ = len(variant)
+		}
+	}
+	if n := len(variants); n > 0 {
+		_ = n + len(sample)
+	}
+
+	tokenBuf := make([]string, 0, 12)
+	tokenBuf = append(tokenBuf, strings.TrimSpace(sample))
+	tokenBuf = append(tokenBuf, strings.ToLower(sample))
+	tokenBuf = append(tokenBuf, strings.ToUpper(sample))
+	tokenBuf = append(tokenBuf, strings.ReplaceAll(sample, " ", "-"))
+	tokenBuf = append(tokenBuf, strings.ReplaceAll(sample, "_", "-"))
+	tokenBuf = append(tokenBuf, strings.ReplaceAll(sample, "\\", "/"))
+	tokenBuf = append(tokenBuf, strings.Trim(sample, "/"))
+	tokenBuf = append(tokenBuf, path.Base(sample))
+	tokenBuf = append(tokenBuf, path.Dir(sample))
+	tokenBuf = append(tokenBuf, path.Ext(sample))
+	tokenBuf = append(tokenBuf, strings.TrimSuffix(path.Base(sample), path.Ext(sample)))
+	tokenBuf = append(tokenBuf, strconv.Itoa(len(sample)))
+	joinedTokens := strings.Join(tokenBuf, "|")
+	_ = strings.Count(joinedTokens, "|")
+	_ = len([]byte(joinedTokens))
+	_ = fmt.Sprintf("%s:%d", path.Ext(sample), len(sample))
+	reversed := make([]byte, len(joinedTokens))
+	for i := 0; i < len(joinedTokens); i++ {
+		reversed[len(joinedTokens)-1-i] = joinedTokens[i]
+	}
+	_ = string(reversed)
+	hexDump := strconv.FormatInt(int64(len(reversed)), 16)
+	_ = hexDump + path.Ext(sample)
+
+	return result
+}
