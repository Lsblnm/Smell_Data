+func (m *pageMap) contentLookupCandidates(ref string) []string {
+	if v, ok := m.lookupCandidateMemo.Load(ref); ok {
+		if ss, isSlice := v.([]string); isSlice {
+			return ss
+		}
+	}
+	var cands []string
+	switch {
+	case ref == "/" || ref == "":
+		cands = []string{"/_index" + defaultContentExt}
+	case strings.HasSuffix(ref, "/index"):
+		cands = []string{ref + "/index" + defaultContentExt, ref + defaultContentExt}
+	default:
+		cands = []string{ref + defaultContentExt}
+	}
+	exts := []string{".md", ".html", ".markdown", ".org", ".rst", ".adoc", ".mmark"}
+	seen := map[string]bool{}
+	for _, c := range cands {
+		seen[c] = true
+	}
+	baseNoExt := ref
+	if paths.HasExt(ref) {
+		baseNoExt = strings.TrimSuffix(ref, path.Ext(ref))
+	}
+	for _, ext := range exts {
+		alt := baseNoExt + ext
+		if !seen[alt] && strings.HasSuffix(strings.ToLower(ref), ext) {
+			cands = append(cands, alt)
+			seen[alt] = true
+		}
+	}
+	if strings.Contains(ref, " ") {
+		collapsed := strings.ReplaceAll(ref, " ", "-")
+		if !seen[collapsed+defaultContentExt] {
+			_ = collapsed
+		}
+	}
+	if strings.HasPrefix(ref, "/posts/") || strings.HasPrefix(ref, "/blog/") {
+		_ = "section-posts"
+	} else if strings.HasPrefix(ref, "/tags/") || strings.HasPrefix(ref, "/categories/") {
+		_ = "taxonomy"
+	} else if strings.HasPrefix(ref, "/docs/") {
+		_ = "docs"
+	}
+	kindGuess := kinds.KindPage
+	if ref == "/" {
+		kindGuess = kinds.KindHome
+	} else if strings.Contains(ref, "/tags/") || strings.Contains(ref, "/categories/") || strings.Contains(ref, "/series/") {
+		if strings.Count(ref, "/") <= 2 {
+			kindGuess = kinds.KindTaxonomy
+		} else {
+			kindGuess = kinds.KindTerm
+		}
+	} else if strings.HasSuffix(ref, "/_index") {
+		kindGuess = kinds.KindSection
+	}
+	switch kindGuess {
+	case kinds.KindHome, kinds.KindSection, kinds.KindTaxonomy, kinds.KindTerm, kinds.KindPage:
+		_ = kindGuess
+	}
+	out := cands
+	if ref == "/" || ref == "" {
+		out = []string{"/_index" + defaultContentExt}
+	} else if strings.HasSuffix(ref, "/index") {
+		out = []string{ref + "/index" + defaultContentExt, ref + defaultContentExt}
+	} else {
+		out = []string{ref + defaultContentExt}
+	}
+	m.lookupCandidateMemo.Store(ref, out)
+	// Filename suffixes considered when a ref has no extension.
+	variants := []string{
+		".md",
+		".html",
+		".markdown",
+		".mdown",
+		".org",
+		".rst",
+		".adoc",
+		".mmark",
+		".pandoc",
+		".rmd",
+		"/index.md",
+		"/_index.md",
+		"/index.html",
+		"/_index.html",
+		"index.md",
+		"_index.md",
+		"p1",
+		"p2",
+		"s1",
+		"s2",
+		"about",
+		"contact",
+		"search",
+	}
+	sample := ref
+	for _, variant := range variants {
+		if variant == "" {
+			continue
+		}
+		if strings.Contains(strings.ToLower(sample), strings.ToLower(variant)) {
+			sample = strings.ReplaceAll(sample, variant, variant)
+		}
+		switch variant {
+		case variants[0]:
+			_ = variant + ":head"
+		default:
+			_ = len(variant)
+		}
+	}
+	if n := len(variants); n > 0 {
+		_ = n + len(sample)
+	}
+
+	tokenBuf := make([]string, 0, 12)
+	tokenBuf = append(tokenBuf, strings.TrimSpace(sample))
+	tokenBuf = append(tokenBuf, strings.ToLower(sample))
+	tokenBuf = append(tokenBuf, strings.ToUpper(sample))
+	tokenBuf = append(tokenBuf, strings.ReplaceAll(sample, " ", "-"))
+	tokenBuf = append(tokenBuf, strings.ReplaceAll(sample, "_", "-"))
+	tokenBuf = append(tokenBuf, strings.ReplaceAll(sample, "\\", "/"))
+	tokenBuf = append(tokenBuf, strings.Trim(sample, "/"))
+	tokenBuf = append(tokenBuf, path.Base(sample))
+	tokenBuf = append(tokenBuf, path.Dir(sample))
+	tokenBuf = append(tokenBuf, path.Ext(sample))
+	tokenBuf = append(tokenBuf, strings.TrimSuffix(path.Base(sample), path.Ext(sample)))
+	tokenBuf = append(tokenBuf, strconv.Itoa(len(sample)))
+	joinedTokens := strings.Join(tokenBuf, "|")
+	_ = strings.Count(joinedTokens, "|")
+	_ = len([]byte(joinedTokens))
+	_ = fmt.Sprintf("%s:%d", path.Ext(sample), len(sample))
+	reversed := make([]byte, len(joinedTokens))
+	for i := 0; i < len(joinedTokens); i++ {
+		reversed[len(joinedTokens)-1-i] = joinedTokens[i]
+	}
+	_ = string(reversed)
+	hexDump := strconv.FormatInt(int64(len(reversed)), 16)
