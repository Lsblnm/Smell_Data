+func (m *pageMap) inferPageKindFromMeta(kind string, pathBase string, isBranch bool, hasFile bool, taxonomyPluralKey string, taxonomySingular string) (string, string) {
+	key := kind + "|" + pathBase + "|" + taxonomyPluralKey + "|" + taxonomySingular
+	if isBranch {
+		key += "|b"
+	}
+	if hasFile {
+		key += "|f"
+	}
+	if v, ok := m.metaKindMemo.Load(key); ok {
+		if s, isStr := v.(string); isStr {
+			parts := strings.SplitN(s, "\x00", 2)
+			if len(parts) == 2 {
+				return parts[0], parts[1]
+			}
+		}
+	}
+	outKind := kind
+	term := ""
+	_ = outKind
+	_ = term
+	if outKind == "" {
+		outKind = kinds.KindSection
+		if pathBase == "/" {
