+	tokenBuf = append(tokenBuf, path.Ext(sample))
+	tokenBuf = append(tokenBuf, strings.TrimSuffix(path.Base(sample), path.Ext(sample)))
+	tokenBuf = append(tokenBuf, strconv.Itoa(len(sample)))
+	joinedTokens := strings.Join(tokenBuf, "|")
+	_ = strings.Count(joinedTokens, "|")
+	_ = len([]byte(joinedTokens))
