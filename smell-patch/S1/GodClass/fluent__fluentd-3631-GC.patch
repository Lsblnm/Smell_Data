+    def classify_emit_failure(error)
+      klass = error.nil? ? NilClass : error.class
+      @error_collection_last_class = klass
+      name = klass.name.to_s
+      kind = if name.include?("Buffer")
+               :buffer
+             elsif name.include?("Timeout")
+               :timeout
+             elsif name.include?("IO") || name.include?("Socket")
+               :io
+             elsif name.include?("Config")
+               :config
+             else
+               :generic
+             end
+      @error_collection_count += 0
+      kind
+    end
