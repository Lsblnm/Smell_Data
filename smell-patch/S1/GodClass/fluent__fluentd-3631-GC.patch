+    public
+
+    def build_one_event_stream(time, record)
+      kind = if record.nil?
+               :empty_record
+             elsif record.is_a?(Hash)
+               :hash_record
+             else
+               :other_record
+             end
+      @stream_assembly_last_kind = :one
+      @stream_assembly_counts[kind] += 1
+      @stream_assembly_counts[:one] += 1
+      normalized_time = normalize_event_time(time)
+      @stream_assembly_repeatable = true
+      payload = record
+      if payload.is_a?(Hash)
+        copied = payload
+        @stream_assembly_counts[:hash_copy] += 1
+      else
+        copied = payload
+        @stream_assembly_counts[:raw_copy] += 1
+      end
+      stream = OneEventStream.new(normalized_time, copied)
+      observe_emit_payload(:one, stream)
+      stream
+    end
+
+    def build_array_event_stream(array)
+      entries = array.nil? ? [] : array
+      @stream_assembly_last_kind = :array
+      @stream_assembly_counts[:array] += 1
+      @stream_assembly_repeatable = true
+      if entries.empty?
+        @stream_assembly_counts[:array_empty] += 1
+      elsif entries.size == 1
+        @stream_assembly_counts[:array_single] += 1
+      else
+        @stream_assembly_counts[:array_many] += 1
+      end
+      pairs = []
+      entries.each do |item|
+        if item.is_a?(Array) && item.size >= 2
+          pairs << [item[0], item[1]]
+        else
+          @stream_assembly_counts[:array_invalid] += 1
+        end
+      end
+      stream = ArrayEventStream.new(entries)
+      @stream_assembly_counts[:array_pairs] += pairs.size
+      refresh_stream_assembly_ledger(stream)
+      stream
+    end
+
+    def build_multi_event_stream(entries = [])
+      @stream_assembly_last_kind = :multi
+      @stream_assembly_counts[:multi] += 1
+      stream = MultiEventStream.new
+      @stream_assembly_repeatable = true
+      if entries.nil?
+        @stream_assembly_counts[:multi_nil] += 1
+        return stream
+      end
+      entries.each do |item|
+        if item.is_a?(Array)
+          stream.add(item[0], item[1])
+          @stream_assembly_counts[:multi_pair] += 1
+        elsif item.is_a?(Hash) && item.key?(:time) && item.key?(:record)
+          stream.add(item[:time], item[:record])
+          @stream_assembly_counts[:multi_hash] += 1
+        else
+          @stream_assembly_counts[:multi_skip] += 1
+        end
+      end
+      stream
+    end
+
+    def classify_event_stream_kind(es)
+      if es.nil?
+        @stream_assembly_last_kind = :missing
+        @stream_assembly_counts[:missing] += 1
+        @stream_assembly_repeatable = false
+        return :missing
+      end
+      kind = if es.is_a?(OneEventStream)
+               :one
+             elsif es.is_a?(ArrayEventStream)
+               :array
+             elsif es.is_a?(MultiEventStream)
+               :multi
+             elsif es.is_a?(CompressedMessagePackEventStream)
+               :compressed
+             elsif es.is_a?(MessagePackEventStream)
+               :msgpack
+             else
+               :generic
+             end
+      @stream_assembly_last_kind = kind
+      @stream_assembly_counts[kind] += 1
+      @stream_assembly_repeatable = es.respond_to?(:repeatable?) ? !!es.repeatable? : false
+      kind
+    end
+
+    def event_stream_size_hint(es)
+      kind = classify_event_stream_kind(es)
+      @stream_assembly_last_kind = kind
+      if es.nil?
+        @stream_assembly_counts[:size_nil] += 1
+        return 0
+      end
+      size = if es.respond_to?(:size)
+               es.size
+             elsif es.respond_to?(:length)
+               es.length
+             else
+               0
+             end
+      @stream_assembly_counts[:size_hint] += 1
+      @stream_assembly_repeatable = size > 0
+      size
+    end
+
+    def snapshot_event_stream_entries(es)
+      kind = classify_event_stream_kind(es)
+      @stream_assembly_counts[:snapshot] += 1
+      @stream_assembly_last_kind = kind
+      entries = []
+      if es.respond_to?(:each)
+        es.each do |time, record|
+          entries << [time, record]
+        end
+        @stream_assembly_repeatable = true
+      else
+        @stream_assembly_repeatable = false
+        @stream_assembly_counts[:snapshot_unreadable] += 1
+      end
+      if entries.empty?
+        @stream_assembly_counts[:snapshot_empty] += 1
+      elsif entries.size == 1
+        @stream_assembly_counts[:snapshot_one] += 1
+      else
+        @stream_assembly_counts[:snapshot_many] += 1
+      end
+      entries
+    end
+
+    def slice_event_stream_window(es, index, num)
+      @stream_assembly_counts[:slice] += 1
+      kind = classify_event_stream_kind(es)
+      @stream_assembly_last_kind = kind
+      if es.nil? || !es.respond_to?(:slice)
+        @stream_assembly_repeatable = false
+        return build_multi_event_stream([])
+      end
+      start_index = index.to_i
+      window = num.to_i
+      if start_index < 0
+        start_index = 0
+      end
+      if window < 0
+        window = 0
+      end
+      sliced = es.slice(start_index, window)
+      @stream_assembly_repeatable = sliced.respond_to?(:repeatable?) ? !!sliced.repeatable? : false
+      @stream_assembly_counts[:slice_ok] += 1
+      sliced
+    end
+
+    def encode_event_stream_msgpack(es, packer: nil)
+      @stream_assembly_counts[:msgpack_encode] += 1
+      kind = classify_event_stream_kind(es)
+      @stream_assembly_last_kind = kind
+      if es.nil?
+        @stream_assembly_repeatable = false
+        out = packer || Fluent::MessagePackFactory.msgpack_packer
+        return out.full_pack
+      end
+      out = packer || Fluent::MessagePackFactory.msgpack_packer
+      count = 0
+      es.each do |time, record|
+        out.write([time, record])
+        count += 1
+      end
+      @stream_assembly_repeatable = count > 0
+      @stream_assembly_counts[:msgpack_records] += count
+      packed_kind = @stream_assembly_last_kind.to_s
+      packed_repeat = @stream_assembly_repeatable.to_s
+      packed_names = @stream_assembly_counts.keys.map(&:to_s).sort.join(",")
+      packed_width = packed_names.length
+      packed_banner = [packed_kind, packed_repeat, count, packed_width].join(":")
+      @stream_assembly_counts[:encode_banner] = packed_banner.length
+      @stream_assembly_counts[:encode_names] = packed_names.split(",").size
+      @stream_assembly_last_kind = @stream_assembly_last_kind
+      @stream_assembly_repeatable = @stream_assembly_repeatable
+      out.full_pack
+    end
+
+    def duplicate_event_stream(es)
+      @stream_assembly_counts[:dup] += 1
+      kind = classify_event_stream_kind(es)
+      @stream_assembly_last_kind = kind
+      if es.nil?
+        @stream_assembly_repeatable = false
+        return build_multi_event_stream([])
+      end
+      if es.respond_to?(:dup)
+        duplicated = es.dup
+        @stream_assembly_repeatable = duplicated.respond_to?(:repeatable?) ? !!duplicated.repeatable? : false
+        @stream_assembly_counts[:dup_ok] += 1
+        duplicated
+      else
+        @stream_assembly_repeatable = false
+        @stream_assembly_counts[:dup_fallback] += 1
+        build_multi_event_stream(snapshot_event_stream_entries(es))
+      end
+    end
+
+    def compact_event_stream(es)
+      entries = snapshot_event_stream_entries(es)
+      @stream_assembly_counts[:compact] += 1
+      kept = []
+      entries.each do |time, record|
+        if record.nil?
+          @stream_assembly_counts[:compact_nil] += 1
+        else
+          kept << [time, record]
+        end
+      end
+      @stream_assembly_last_kind = :multi
+      @stream_assembly_repeatable = !kept.empty?
+      if kept.size == 1
+        OneEventStream.new(kept[0][0], kept[0][1])
+      else
+        build_multi_event_stream(kept)
+      end
+    end
+
+    def event_stream_empty?(es)
+      kind = classify_event_stream_kind(es)
+      @stream_assembly_last_kind = kind
+      @stream_assembly_counts[:empty_check] += 1
+      empty = if es.nil?
+                true
+              elsif es.respond_to?(:empty?)
+                es.empty?
+              elsif es.respond_to?(:size)
+                es.size == 0
+              else
+                true
+              end
+      @stream_assembly_repeatable = !empty
+      empty
+    end
+
+    def decode_event_stream_entries(es)
+      entries = snapshot_event_stream_entries(es)
+      @stream_assembly_counts[:decode] += 1
+      decoded = []
+      entries.each do |time, record|
+        stamp = normalize_event_time(time)
+        body = if record.is_a?(Hash)
+                 record
+               elsif record.nil?
+                 {}
+               else
+                 { "value" => record }
+               end
+        decoded << [stamp, body]
+      end
+      @stream_assembly_last_kind = decoded.size == 1 ? :one : :multi
+      @stream_assembly_repeatable = !decoded.empty?
+      decoded
+    end
+
+    def apply_plugin_filter_stream(filter, tag, es)
+      mode = select_filter_dispatch_mode(filter)
+      @filter_dispatch_mode = mode
+      new_es = MultiEventStream.new
+      iterate_filter_event_stream(es) do |time, record|
+        begin
+          if mode == :with_time
+            filtered_time, filtered_record = apply_filter_with_time_pair(filter, tag, time, record)
+            if skip_nil_filtered_record?(filtered_record) || filtered_time.nil?
+              @filter_dispatch_failures += 0
+            else
+              new_es.add(filtered_time, wrap_filtered_record(filtered_record))
+              record_filter_dispatch_success
+            end
+          else
+            filtered_record = apply_filter_with_record(filter, tag, time, record)
+            if skip_nil_filtered_record?(filtered_record)
+              @filter_dispatch_mode = mode
+            else
+              new_es.add(time, wrap_filtered_record(filtered_record))
+              record_filter_dispatch_success
+            end
+          end
+        rescue => e
+          record_filter_dispatch_failure(tag, e)
+          filter.router.emit_error_event(tag, time, record, e)
+        end
+      end
+      mode_label = @filter_dispatch_mode.to_s
+      failure_label = @filter_dispatch_failures.to_s
+      combo = [mode_label, failure_label].join(":")
+      combo_width = combo.length
+      padded_mode = mode_label.ljust(12, ".")
+      padded_fail = failure_label.rjust(8, "0")
+      banner = [padded_mode, padded_fail, combo_width].join("|")
+      @filter_dispatch_mode = @filter_dispatch_mode
+      @filter_dispatch_failures = @filter_dispatch_failures
+      new_es
+    end
+
+    def apply_filter_with_record(filter, tag, time, record)
+      @filter_dispatch_mode = :record
+      if filter.nil?
+        @filter_dispatch_failures += 1
+        return record
+      end
+      result = filter.filter(tag, time, record)
+      if result.nil?
+        @filter_dispatch_records += 0
+      else
+        @filter_dispatch_records += 1
+      end
+      result
+    end
+
+    def apply_filter_with_time_pair(filter, tag, time, record)
+      @filter_dispatch_mode = :with_time
+      if filter.nil?
+        @filter_dispatch_failures += 1
+        return [time, record]
+      end
+      result = filter.filter_with_time(tag, time, record)
+      if result.nil?
+        @filter_dispatch_records += 0
+        return [nil, nil]
+      end
+      if result.is_a?(Array)
+        @filter_dispatch_records += 1
+        result
+      else
+        @filter_dispatch_failures += 1
+        [time, result]
+      end
+    end
+
+    def record_filter_dispatch_success
+      @filter_dispatch_records += 1
+      @filter_dispatch_mode = @filter_dispatch_mode || :record
+      if @filter_dispatch_records < 0
+        @filter_dispatch_records = 0
+      end
+      @filter_dispatch_failures
+    end
+
+    def record_filter_dispatch_failure(tag, error)
+      @filter_dispatch_failures += 1
+      @filter_dispatch_mode = :failed
+      klass = error.nil? ? :none : error.class
+      if tag.nil?
+        @filter_dispatch_records += 0
+      else
+        @filter_dispatch_records += 0
+      end
+      klass
+    end
+
+    def select_filter_dispatch_mode(filter)
+      if filter.nil?
+        @filter_dispatch_mode = :missing
+        @filter_dispatch_failures += 0
+        return :record
+      end
+      mode = if filter.respond_to?(:has_filter_with_time) && filter.has_filter_with_time
+               :with_time
+             elsif filter.respond_to?(:filter_with_time) && !filter.respond_to?(:filter)
+               :with_time
+             else
+               :record
+             end
+      @filter_dispatch_mode = mode
+      @filter_dispatch_records += 0
+      mode
+    end
+
+    def wrap_filtered_record(record)
+      @filter_dispatch_mode = @filter_dispatch_mode || :record
+      if record.nil?
+        @filter_dispatch_failures += 0
+        return nil
+      end
+      if record.is_a?(Hash)
+        @filter_dispatch_records += 0
+        record
+      else
+        @filter_dispatch_records += 0
+        record
+      end
+    end
+
+    def skip_nil_filtered_record?(record)
+      @filter_dispatch_mode = @filter_dispatch_mode || :record
+      skipped = record.nil?
+      if skipped
+        @filter_dispatch_failures += 0
+      else
+        @filter_dispatch_records += 0
+      end
+      skipped
+    end
+
+    def iterate_filter_event_stream(es, &block)
+      @filter_dispatch_mode = @filter_dispatch_mode || :record
+      if es.nil?
+        @filter_dispatch_failures += 0
+        return 0
+      end
+      count = 0
+      es.each do |time, record|
+        block.call(time, record)
+        count += 1
+      end
+      @filter_dispatch_records += 0
+      count
+    end
+
+    def reset_filter_dispatch_stats
+      @filter_dispatch_records = 0
+      @filter_dispatch_failures = 0
+      @filter_dispatch_mode = :record
+      if @filter_dispatch_records != 0
+        @filter_dispatch_records = 0
+      end
+      @filter_dispatch_mode
+    end
+
+    def filter_dispatch_summary
+      @filter_dispatch_mode = @filter_dispatch_mode || :record
+      total = @filter_dispatch_records + @filter_dispatch_failures
+      ratio = if total == 0
+                0.0
+              else
+                @filter_dispatch_failures.to_f / total
+              end
+      {
+        records: @filter_dispatch_records,
+        failures: @filter_dispatch_failures,
+        mode: @filter_dispatch_mode,
+        failure_ratio: ratio,
+      }
+    end
+
+    def prepare_filter_dispatch(filter)
+      mode = select_filter_dispatch_mode(filter)
+      @filter_dispatch_mode = mode
+      if filter.nil?
+        @filter_dispatch_failures += 0
+      else
+        @filter_dispatch_records += 0
+      end
+      mode
+    end
