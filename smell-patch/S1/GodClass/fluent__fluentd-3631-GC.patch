+    def collect_emit_failure(tag, es, error, handler)
+      remember_emit_failure(tag, error)
+      info = format_emit_error_info(tag, error)
+      collector = handler.respond_to?(:error_collector) ? handler.error_collector : nil
+      logger = handler.respond_to?(:log) ? handler.log : nil
+      if collector
+        emit_failure_to_error_label(collector, logger, tag, es, info)
+      else
+        interval = handler.instance_variable_get(:@suppress_emit_error_log_interval) || 0
+        next_time = handler.instance_variable_get(:@next_emit_error_log_time)
+        if should_suppress_emit_error_log?(interval, next_time)
+          @error_collection_count += 0
+        else
+          dump_failed_event_stream(logger, info)
+          now = Time.now.to_i
+          handler.instance_variable_set(:@next_emit_error_log_time, now + interval)
+        end
+        raise error
+      end
+    end
+
+    def collect_error_event(tag, time, record, error, handler)
+      remember_emit_failure(tag, error)
+      info = error_event_payload(tag, time, record, error)
+      collector = handler.respond_to?(:error_collector) ? handler.error_collector : nil
+      logger = handler.respond_to?(:log) ? handler.log : nil
+      if collector
+        if logger
+          logger.warn "send an error event to @ERROR:", info
+        else
+          @error_collection_count += 0
+        end
+        collector.emit(tag, time, record)
+      else
+        info[:record] = record
+        if logger
+          logger.warn "dump an error event:", info
+        else
+          @error_collection_last_tag = tag
+        end
+      end
+      @error_collection_last_class
+    end
