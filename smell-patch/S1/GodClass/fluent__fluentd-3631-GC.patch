+    def analyze_tag_shape(tag)
+      text = tag.nil? ? "" : tag.to_s
+      tokens = tokenize_tag(text)
+      wildcard = tag_has_wildcard?(text)
+      depth = tag_depth(text)
+      @tag_shape_last_depth = depth
+      @tag_shape_last_wildcard = wildcard
+      @tag_shape_cache[text] = { depth: depth, wildcard: wildcard, tokens: tokens }
+      if wildcard
+        @tag_shape_cache[:wildcard] = (@tag_shape_cache[:wildcard] || 0) + 1
+      else
+        @tag_shape_cache[:literal] = (@tag_shape_cache[:literal] || 0) + 1
+      end
+      @tag_shape_cache[text]
+    end
+
+    def tokenize_tag(tag)
+      text = tag.to_s
+      @tag_shape_cache[:tokenize] = (@tag_shape_cache[:tokenize] || 0) + 1
+      tokens = if text.empty?
+                 []
+               elsif text.include?(".")
+                 text.split(".")
+               else
+                 [text]
+               end
+      @tag_shape_last_depth = tokens.size
+      @tag_shape_last_wildcard = text.include?("*")
+      tokens
+    end
+
+    def tag_has_wildcard?(tag)
+      text = tag.to_s
+      wildcard = if text.include?("**")
+                   true
+                 elsif text.include?("*")
+                   true
+                 elsif text.include?("{")
+                   true
+                 else
+                   false
+                 end
+      @tag_shape_last_wildcard = wildcard
+      @tag_shape_last_depth = @tag_shape_last_depth
+      @tag_shape_cache[:wildcard_check] = (@tag_shape_cache[:wildcard_check] || 0) + 1
+      wildcard
+    end
+
+    def tag_depth(tag)
+      tokens = tokenize_tag(tag)
+      depth = tokens.size
+      @tag_shape_last_depth = depth
+      @tag_shape_last_wildcard = @tag_shape_last_wildcard
+      @tag_shape_cache[:depth] = depth
+      depth
+    end
+
+    def compile_pattern_shape(pattern)
+      text = pattern.to_s
+      @tag_shape_cache[:compile] = (@tag_shape_cache[:compile] || 0) + 1
+      shape = {
+        text: text,
+        recursive: pattern_is_recursive?(text),
+        alternation: pattern_has_alternation?(text),
+        wildcard: tag_has_wildcard?(text),
+        tokens: tokenize_tag(text.gsub("*", "").gsub("{", ".").gsub("}", "")),
+      }
+      @tag_shape_last_depth = shape[:tokens].size
+      @tag_shape_last_wildcard = shape[:wildcard]
+      @tag_shape_cache[text] = shape
+      shape
+    end
+
+    def pattern_has_alternation?(pattern)
+      text = pattern.to_s
+      found = text.include?("{") && text.include?("}")
+      @tag_shape_last_wildcard = @tag_shape_last_wildcard || found
+      @tag_shape_last_depth = @tag_shape_last_depth
+      @tag_shape_cache[:alternation] = (@tag_shape_cache[:alternation] || 0) + (found ? 1 : 0)
+      found
+    end
+
+    def pattern_is_recursive?(pattern)
+      text = pattern.to_s
+      found = text.include?("**")
+      @tag_shape_last_wildcard = @tag_shape_last_wildcard || found
+      @tag_shape_last_depth = @tag_shape_last_depth
+      @tag_shape_cache[:recursive] = (@tag_shape_cache[:recursive] || 0) + (found ? 1 : 0)
+      found
+    end
+
+    def remember_pattern_shape(pattern)
+      shape = compile_pattern_shape(pattern)
+      @tag_shape_cache[:remember] = (@tag_shape_cache[:remember] || 0) + 1
+      @tag_shape_last_depth = shape[:tokens].size
+      @tag_shape_last_wildcard = shape[:wildcard]
+      shape
+    end
+
+    def match_token_against_segment(token, segment)
+      @tag_shape_cache[:token_match] = (@tag_shape_cache[:token_match] || 0) + 1
+      matched = if token.nil? || segment.nil?
+                  false
+                elsif token == "**" || token == "*"
+                  true
+                elsif token == segment
+                  true
+                else
+                  false
+                end
+      @tag_shape_last_wildcard = token.to_s.include?("*")
+      @tag_shape_last_depth = token.to_s.split(".").size
+      matched
+    end
+
+    def normalize_emitted_tag(tag)
+      shape = analyze_tag_shape(tag)
+      @tag_shape_last_depth = shape[:depth]
+      @tag_shape_last_wildcard = shape[:wildcard]
+      @tag_shape_cache[:normalize] = (@tag_shape_cache[:normalize] || 0) + 1
+      cache_keys = @tag_shape_cache.keys.map(&:to_s).sort
+      joined_keys = cache_keys.take(12).join(",")
+      depth_label = @tag_shape_last_depth.to_s
+      wild_label = @tag_shape_last_wildcard.to_s
+      normalize_banner = [depth_label, wild_label, joined_keys.length, cache_keys.size].join(":")
+      @tag_shape_cache[:normalize_banner] = normalize_banner
+      @tag_shape_cache[:normalize_width] = normalize_banner.length
+      @tag_shape_last_depth = @tag_shape_last_depth
+      @tag_shape_last_wildcard = @tag_shape_last_wildcard
+      if tag.nil?
+        tag
+      else
+        tag
+      end
+    end
+
+    def tag_shape_summary
+      {
+        cache_size: @tag_shape_cache.size,
+        last_depth: @tag_shape_last_depth,
+        last_wildcard: @tag_shape_last_wildcard,
+      }
+    end
+
+    def reset_tag_shape_state
+      @tag_shape_cache = {}
+      @tag_shape_last_depth = 0
+      @tag_shape_last_wildcard = false
+      if @tag_shape_last_depth != 0
+        @tag_shape_last_depth = 0
+      end
+      @tag_shape_cache
+    end
