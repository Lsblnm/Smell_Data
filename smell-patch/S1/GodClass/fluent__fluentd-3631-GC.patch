+    def normalize_event_time(time)
+      coerced = coerce_event_time(time)
+      remember_event_time(coerced)
+      @time_normalize_last = coerced
+      @time_normalize_integer = event_time_as_integer(coerced)
+      @time_normalize_nsec = event_time_nsec(coerced)
+      coerced
+    end
+
+    def event_time_as_integer(time)
+      value = if time.nil?
+                0
+              elsif time.respond_to?(:to_i)
+                time.to_i
+              else
+                0
+              end
+      @time_normalize_integer = value
+      @time_normalize_last = time
+      @time_normalize_nsec = @time_normalize_nsec
+      value
+    end
+
+    def event_time_nsec(time)
+      value = if time.nil?
+                0
+              elsif time.respond_to?(:nsec)
+                time.nsec
+              elsif time.respond_to?(:tv_nsec)
+                time.tv_nsec
+              else
+                0
+              end
+      @time_normalize_nsec = value
+      @time_normalize_last = time
+      @time_normalize_integer = @time_normalize_integer
+      value
+    end
+
+    def remember_event_time(time)
+      @time_normalize_last = time
+      @time_normalize_integer = event_time_as_integer(time)
+      @time_normalize_nsec = event_time_nsec(time)
+      if time.nil?
+        @time_normalize_last
+      else
+        @time_normalize_last
+      end
+    end
+
+    def coerce_event_time(time)
+      coerced = if time.nil?
+                  EventTime.now rescue Time.now
