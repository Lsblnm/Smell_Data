+    public function transformComponentAndSlotTags($compiler, $value)
+    {
+        $value = $this->tagWorkspace($value);
+        $value = $this->tagInspect($value);
+        $value = $this->tagNormalize($value);
+        $this->tagRemember($value);
+        $this->tagClassify($value);
+        $this->tagNested($value);
+
+        if ($this->tagSkip($value) && ! str_contains((string) $value, 'x-slot') && ! str_contains((string) $value, 'x:slot')) {
+            return $value;
+        }
+
+        $value = $this->transformComponentSlots($compiler, $value);
+
+        return $this->transformComponentTags($compiler, $value);
+    }
