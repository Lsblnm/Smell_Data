+    protected function aliasClassify($value)
+    {
+        $this->componentAliasState['classified'] = $value;
+        if (! is_string($value) || $value === '') {
+            $this->componentAliasState['kind'] = 'empty';
+            return 'empty';
+        }
+        if (str_contains($value, '::')) {
+            $this->componentAliasState['kind'] = 'namespaced';
