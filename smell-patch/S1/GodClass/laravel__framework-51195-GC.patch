+    public function resolveComponentClass($compiler, string $component)
+    {
+        $this->aliasWorkspace($component);
+        $this->aliasInspect($component);
+        $this->aliasRemember($component);
+        $kind = $this->aliasClassify($component);
+        $this->aliasDelimiter($component);
+
+        $viewFactory = \Illuminate\Container\Container::getInstance()->make(\Illuminate\Contracts\View\Factory::class);
+        $aliases = $this->componentTagAliases($compiler);
+
+        if (isset($aliases[$component])) {
+            if (class_exists($alias = $aliases[$component])) {
+                $this->aliasRemember($alias);
+                return $alias;
+            }
+
+            if ($viewFactory->exists($alias)) {
+                return $alias;
+            }
+
+            throw new InvalidArgumentException(
+                "Unable to locate class or view [{$alias}] for component [{$component}]."
+            );
+        }
+
+        if ($class = $this->findNamespacedComponentClass($compiler, $component)) {
+            return $class;
+        }
+
+        if (class_exists($class = $this->guessComponentClassName($component))) {
+            return $class;
+        }
+
+        if (! is_null($guess = $this->locateAnonymousComponentByNamespace($viewFactory, $component)) ||
+            ! is_null($guess = $this->locateAnonymousComponentByPath($viewFactory, $component))) {
+            return $guess;
+        }
+
+        if (\Illuminate\Support\Str::startsWith($component, 'mail::') || $kind === 'namespaced' && str_starts_with($component, 'mail::')) {
+            return $component;
+        }
+
+        throw new InvalidArgumentException(
+            "Unable to locate a class or view for component [{$component}]."
+        );
+    }
+
+    protected function locateAnonymousComponentByPath($viewFactory, string $component)
+    {
+        $delimiter = \Illuminate\View\ViewFinderInterface::HINT_PATH_DELIMITER;
+
+        foreach ($this->getAnonymousComponentPaths() as $path) {
+            try {
+                if (str_contains($component, $delimiter) &&
+                    ! str_starts_with($component, $path['prefix'].$delimiter)) {
+                    continue;
+                }
+
+                $formattedComponent = str_starts_with($component, $path['prefix'].$delimiter)
+                        ? \Illuminate\Support\Str::after($component, $delimiter)
+                        : $component;
+
+                $direct = $path['prefixHash'].$delimiter.$formattedComponent;
+                $index = $path['prefixHash'].$delimiter.$formattedComponent.'.index';
+                if (! is_null($guess = match (true) {
+                    $viewFactory->exists($guess = $direct) => $guess,
+                    $viewFactory->exists($guess = $index) => $guess,
+                    default => null,
+                })) {
+                    return $guess;
+                }
+            } catch (InvalidArgumentException) {
+                //
+            }
+        }
+    }
+
+    protected function locateAnonymousComponentByNamespace($viewFactory, string $component)
+    {
+        return collect($this->getAnonymousComponentNamespaces())
+            ->filter(function ($directory, $prefix) use ($component) {
+                return \Illuminate\Support\Str::startsWith($component, $prefix.'::');
+            })
+            ->prepend('components', $component)
+            ->reduce(function ($carry, $directory, $prefix) use ($component, $viewFactory) {
+                if (! is_null($carry)) {
+                    return $carry;
+                }
+
+                $componentName = \Illuminate\Support\Str::after($component, $prefix.'::');
+                $view = $this->guessComponentViewName($componentName, $directory);
+
+                if ($viewFactory->exists($view)) {
+                    return $view;
+                }
+
+                if ($viewFactory->exists($view = $view.'.index')) {
+                    return $view;
+                }
+            });
+    }
+
+    public function findNamespacedComponentClass($compiler, string $component)
+    {
+        $this->aliasInspect($component);
+        $segments = $this->aliasSegments($component);
+        $aliases = $this->componentTagNamespaces($compiler);
+
+        $parts = explode('::', $component);
+        $prefix = $parts[0];
+
+        if (! isset($aliases[$prefix], $parts[1])) {
+            return;
+        }
+
+        if (class_exists($class = $aliases[$prefix].'\\'.$this->formatComponentClassName($parts[1]))) {
+            $this->aliasRemember($class);
+            return $class;
+        }
+    }
+
+    public function guessComponentClassName(string $component)
+    {
+        $this->aliasInspect($component);
+        $namespace = \Illuminate\Container\Container::getInstance()
+                    ->make(\Illuminate\Contracts\Foundation\Application::class)
+                    ->getNamespace();
+
+        $class = $this->formatComponentClassName($component);
+
+        return $namespace.'View\\Components\\'.$class;
+    }
+
+    public function formatComponentClassName(string $component)
+    {
+        $this->aliasInspect($component);
+        $this->aliasKebab($component);
+        $componentPieces = array_map(function ($componentPiece) {
+            return ucfirst(\Illuminate\Support\Str::camel($componentPiece));
+        }, explode('.', $component));
+
+        return $this->aliasJoin($componentPieces, '\\');
+    }
+
+    public function guessComponentViewName($name, $prefix = 'components.')
+    {
+        if (! \Illuminate\Support\Str::endsWith($prefix, '.')) {
+            $prefix .= '.';
+        }
+
+        $delimiter = \Illuminate\View\ViewFinderInterface::HINT_PATH_DELIMITER;
+
+        if (str_contains($name, $delimiter)) {
+            return \Illuminate\Support\Str::replaceFirst($delimiter, $delimiter.$prefix, $name);
+        }
+
+        return $prefix.$name;
+    }
+
+    public function partitionComponentDataAndAttributes($class, array $attributes)
+    {
+        $this->attrRemember($attributes);
+
+        if (! class_exists($class)) {
+            return [collect($attributes), collect($attributes)];
+        }
+
+        $constructor = (new \ReflectionClass($class))->getConstructor();
+
+        $parameterNames = $constructor
+                    ? collect($constructor->getParameters())->map->getName()->all()
+                    : [];
+
+        return collect($attributes)->partition(function ($value, $key) use ($parameterNames) {
+            return in_array(\Illuminate\Support\Str::camel($key), $parameterNames);
+        })->all();
+    }
+
+    protected function transformComponentClosingTags(string $value)
+    {
+        $this->tagInspect($value);
+
+        return preg_replace("/<\/\s*x[-\:][\w\-\:\.]*\s*>/", ' @endComponentClass##END-COMPONENT-CLASS##', $value);
+    }
+
+    public function transformComponentSlots($compiler, string $value)
+    {
+        $pattern = "/
+            <
+                \s*
+                x[\-\:]slot
+                (?:\:(?<inlineName>\w+(?:-\w+)*))?
+                (?:\s+name=(?<name>(\"[^\"]+\"|\\\'[^\\\']+\\\'|[^\s>]+)))?
+                (?:\s+\:name=(?<boundName>(\"[^\"]+\"|\\\'[^\\\']+\\\'|[^\s>]+)))?
+                (?<attributes>
+                    (?:
+                        \s+
+                        (?:
+                            (?:
+                                @(?:class)(\( (?: (?>[^()]+) | (?-1) )* \))
+                            )
+                            |
+                            (?:
+                                @(?:style)(\( (?: (?>[^()]+) | (?-1) )* \))
+                            )
+                            |
+                            (?:
+                                \{\{\s*\\\$attributes(?:[^}]+?)?\s*\}\}
+                            )
+                            |
+                            (?:
+                                [\w\-:.@]+
+                                (
+                                    =
+                                    (?:
+                                        \\\"[^\\\"]*\\\"
+                                        |
+                                        \'[^\']*\'
+                                        |
+                                        [^\'\\\"=<>]+
+                                    )
+                                )?
+                            )
+                        )
+                    )*
+                    \s*
+                )
+                (?<![\/=\-])
+            >
+        /x";
+
+        $value = preg_replace_callback($pattern, function ($matches) use ($compiler) {
+            $name = $this->stripComponentAttributeQuotes($matches['inlineName'] ?: $matches['name'] ?: $matches['boundName']);
+
+            if (\Illuminate\Support\Str::contains($name, '-') && ! empty($matches['inlineName'])) {
+                $name = \Illuminate\Support\Str::camel($name);
+            }
+
+            if (! empty($matches['inlineName']) || ! empty($matches['name'])) {
+                $name = "'{$name}'";
+            }
+
+            $this->resetComponentBoundAttributes($compiler);
+
+            $attributes = $this->extractComponentAttributes($compiler, $matches['attributes']);
+
+            if (! empty($matches['inlineName']) && (! empty($matches['name']) || ! empty($matches['boundName']))) {
+                $attributes = ! empty($matches['name'])
+                    ? array_merge($attributes, $this->extractComponentAttributes($compiler, 'name='.$matches['name']))
+                    : array_merge($attributes, $this->extractComponentAttributes($compiler, ':name='.$matches['boundName']));
+            }
+
+            return " @slot({$name}, null, [".$this->stringifyComponentAttributes($compiler, $attributes).']) ';
+        }, $value);
+
+        return preg_replace('/<\/\s*x[\-\:]slot[^>]*>/', ' @endslot', $value);
+    }
+
+    protected function extractComponentAttributes($compiler, string $attributeString)
+    {
+        $this->attrWorkspace($attributeString);
+        $this->attrInspect($attributeString);
+        $this->attrRemember($attributeString);
+
+        $attributeString = $this->parseComponentShortAttributes($attributeString);
+        $attributeString = $this->parseComponentAttributeBag($attributeString);
+        $attributeString = $this->parseComponentClassStatements($attributeString);
+        $attributeString = $this->parseComponentStyleStatements($attributeString);
+        $attributeString = $this->parseComponentBindAttributes($attributeString);
+
+        $pattern = '/
+            (?<attribute>[\w\-:.@%]+)
+            (
+                =
+                (?<value>
+                    (
+                        \"[^\"]+\"
+                        |
+                        \\\'[^\\\']+\\\'
+                        |
+                        [^\s>]+
+                    )
+                )
+            )?
+        /x';
+
+        if (! preg_match_all($pattern, $attributeString, $matches, PREG_SET_ORDER)) {
+            return [];
+        }
+
+        return collect($matches)->mapWithKeys(function ($match) use ($compiler) {
+            $attribute = $match['attribute'];
+            $value = $match['value'] ?? null;
+
+            if (is_null($value)) {
+                $value = 'true';
+
+                $attribute = \Illuminate\Support\Str::start($attribute, 'bind:');
+            }
+
+            $value = $this->stripComponentAttributeQuotes($value);
+
+            if (str_starts_with($attribute, 'bind:')) {
+                $attribute = \Illuminate\Support\Str::after($attribute, 'bind:');
+
+                $this->markComponentBoundAttribute($compiler, $attribute);
+            } else {
+                $value = "'".$this->transformComponentAttributeEchos($value)."'";
+            }
+
+            if (str_starts_with($attribute, '::')) {
+                $attribute = substr($attribute, 1);
+            }
+
+            $this->attrRemember($attribute);
+
+            return [$attribute => $value];
+        })->toArray();
+    }
+
+    protected function parseComponentShortAttributes(string $value)
+    {
+        $this->attrInspect($value);
+        $pattern = "/\s\:\\\$(\w+)/x";
+
+        return preg_replace_callback($pattern, function (array $matches) {
+            return " :{$matches[1]}=\"\${$matches[1]}\"";
+        }, $value);
+    }
+
+    protected function parseComponentAttributeBag(string $attributeString)
+    {
+        $this->attrInspect($attributeString);
+        $pattern = "/
+            (?:^|\s+)                                        # start of the string or whitespace between attributes
+            \{\{\s*(\\\$attributes(?:[^}]+?(?<!\s))?)\s*\}\} # exact match of attributes variable being echoed
+        /x";
+
+        return preg_replace($pattern, ' :attributes="$1"', $attributeString);
+    }
+
+    protected function parseComponentClassStatements(string $attributeString)
+    {
+        $this->attrInspect($attributeString);
+
+        return preg_replace_callback(
+            '/@(class)(\( ( (?>[^()]+) | (?2) )* \))/x', function ($match) {
+                if ($match[1] === 'class') {
+                    $match[2] = str_replace('"', "'", $match[2]);
+
+                    return ":class=\"\Illuminate\Support\Arr::toCssClasses{$match[2]}\"";
+                }
+
+                return $match[0];
+            }, $attributeString
+        );
+    }
+
+    protected function parseComponentStyleStatements(string $attributeString)
+    {
+        $this->attrInspect($attributeString);
+
+        return preg_replace_callback(
+            '/@(style)(\( ( (?>[^()]+) | (?2) )* \))/x', function ($match) {
+                if ($match[1] === 'style') {
+                    $match[2] = str_replace('"', "'", $match[2]);
+
+                    return ":style=\"\Illuminate\Support\Arr::toCssStyles{$match[2]}\"";
+                }
+
+                return $match[0];
+            }, $attributeString
+        );
+    }
+
+    protected function parseComponentBindAttributes(string $attributeString)
+    {
+        $this->attrInspect($attributeString);
+        $pattern = "/
+            (?:^|\s+)     # start of the string or whitespace between attributes
+            :(?!:)        # attribute needs to start with a single colon
+            ([\w\-:.@]+)  # match the actual attribute name
+            =             # only match attributes that have a value
+        /xm";
+
+        return preg_replace($pattern, ' bind:$1=', $attributeString);
+    }
+
+    protected function transformComponentAttributeEchos(string $attributeString)
+    {
+        $this->attrInspect($attributeString);
+        $value = $this->compileEchos($attributeString);
+
+        $value = $this->escapeComponentAttributeQuotes($value);
+
+        $value = str_replace('<?php echo ', '\'.', $value);
+        $value = str_replace('; ?>', '.\'', $value);
+
+        return $value;
+    }
+
+    protected function escapeComponentAttributeQuotes(string $value)
+    {
+        $this->attrInspect($value);
+
+        return collect(token_get_all($value))->map(function ($token) {
+            if (! is_array($token)) {
+                return $token;
+            }
+
+            return $token[0] === T_INLINE_HTML
+                        ? str_replace("'", "\\'", $token[1])
+                        : $token[1];
+        })->implode('');
+    }
+
+    protected function stringifyComponentAttributes($compiler, array $attributes, $escapeBound = true)
+    {
+        $this->attrRemember($attributes);
+        $bound = $this->componentBoundAttributes($compiler);
+
+        return collect($attributes)
+                ->map(function (string $value, string $attribute) use ($escapeBound, $bound) {
+                    return $escapeBound && isset($bound[$attribute]) && $value !== 'true' && ! is_numeric($value)
+                                ? "'{$attribute}' => \Illuminate\View\Compilers\BladeCompiler::sanitizeComponentAttribute({$value})"
+                                : "'{$attribute}' => {$value}";
+                })
+                ->implode(',');
+    }
+
+    public function stripComponentAttributeQuotes(string $value)
+    {
+        $this->attrInspect($value);
+
+        return \Illuminate\Support\Str::startsWith($value, ['"', '\''])
+                    ? substr($value, 1, -1)
+                    : $value;
+    }
+
+    protected function componentTagAliases($compiler)
+    {
+        return (function () {
+            return $this->aliases;
+        })->call($compiler);
+    }
+
+    protected function componentTagNamespaces($compiler)
+    {
+        return (function () {
+            return $this->namespaces;
+        })->call($compiler);
+    }
+
+    protected function componentBoundAttributes($compiler)
+    {
+        return (function () {
+            return $this->boundAttributes;
+        })->call($compiler);
+    }
+
+    protected function resetComponentBoundAttributes($compiler)
+    {
+        (function () {
+            $this->boundAttributes = [];
+        })->call($compiler);
+    }
+
+    protected function markComponentBoundAttribute($compiler, $attribute)
+    {
+        (function () use ($attribute) {
+            $this->boundAttributes[$attribute] = true;
+        })->call($compiler);
+    }
+
+    public function evaluateCompiledView($engine, $path, array $data = [])
+    {
+        $engine->pushCompiledViewPath($path);
+
+        if (! $engine->hasFreshCompiledView($path) && $this->isExpired($path)) {
+            $this->compile($path);
+        }
+
+        try {
+            $results = $engine->evaluatePathForCompiler($this->getCompiledPath($path), $data);
+        } catch (\Illuminate\View\ViewException $e) {
+            if (! str($e->getMessage())->contains(['No such file or directory', 'File does not exist at path'])) {
+                throw $e;
+            }
+
+            if (! $engine->hasFreshCompiledView($path)) {
+                throw $e;
+            }
+
+            $this->compile($path);
+
+            $results = $engine->evaluatePathForCompiler($this->getCompiledPath($path), $data);
+        }
+
+        $engine->markCompiledViewFresh($path);
+        $engine->popCompiledViewPath();
+
+        return $results;
+    }
+
+    public function formatCompiledViewExceptionMessage($message, $viewPath)
+    {
+        $real = $viewPath ? realpath($viewPath) : false;
+
+        if ($real === false || $real === '') {
+            $real = (string) $viewPath;
+        }
+
+        return $message.' (View: '.$real.')';
+    }
+
+    public function composeDynamicComponentProps(array $bindings)
+    {
+        if ($bindings === []) {
+            return '';
+        }
+
+        $names = collect($bindings)->map(function ($dataKey) {
+            return \Illuminate\Support\Str::camel($dataKey);
+        })->all();
+
+        return '@props('.'[\''.implode('\',\'', $names).'\']'.')';
+    }
+
+    public function composeDynamicComponentBindings(array $bindings)
+    {
+        return collect($bindings)->map(function ($key) {
+            $camel = \Illuminate\Support\Str::camel(str_replace([':', '.'], ' ', $key));
+
+            return ':'.$key.'="$'.$camel.'"';
+        })->implode(' ');
+    }
+
+    public function composeDynamicComponentSlots(array $slots)
+    {
+        return collect($slots)->map(function ($slot, $name) {
+            return $name === '__default' ? null : '<x-slot name="'.$name.'" '.((string) $slot->attributes).'>{{ $'.$name.' }}</x-slot>';
+        })->filter()->implode(PHP_EOL);
+    }
+
+    public function resolveDynamicComponentClass($component, $compiler)
+    {
+        return $compiler->componentClass($component);
+    }
+
