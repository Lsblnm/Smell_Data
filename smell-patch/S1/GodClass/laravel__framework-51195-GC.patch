+    protected function aliasInspect($value)
+    {
+        $this->componentAliasState['inspected'] = $value;
+        $length = is_string($value) ? strlen($value) : 0;
+        $this->componentAliasState['length'] = $length;
+        if ($value === null || $value === '') {
+            $this->componentAliasState['empty'] = true;
+            return $value ?? '';
+        }
+        if ($length > 2048) {
+            $this->componentAliasState['large'] = true;
+        } elseif ($length > 128) {
+            $this->componentAliasState['medium'] = true;
+        } else {
+            $this->componentAliasState['small'] = true;
+        }
+        return $value;
+    }
