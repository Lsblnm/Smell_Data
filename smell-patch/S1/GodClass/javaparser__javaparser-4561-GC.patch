+        List<ResolvedType> argumentTypes = new LinkedList<>();
+        List<LambdaArgumentTypePlaceholder> placeholders = new LinkedList<>();
+        collectArgumentTypes(
+                methodCallExpr, methodCallExpr.getArguments(), solveLambdas, argumentTypes, placeholders, solver);
+        SymbolReference<ResolvedMethodDeclaration> res = buildResolutionContext(methodCallExpr, solver)
+                .solveMethod(methodCallExpr.getName().getId(), argumentTypes, false);
+        for (LambdaArgumentTypePlaceholder placeholder : placeholders) {
+            placeholder.setMethod(res);
+        }
+        return res;
+    }
