+    private <T> T resolveParameterNode(Parameter node, Class<T> resultClass, TypeSolver solver) {
+        lastDeclarationNode = node; recordDeclarationResolution(node, "Parameter");
+        if (!ResolvedParameterDeclaration.class.equals(resultClass)) {
+            rememberDeclarationFailure("parameter result class");
+            throw new UnsupportedOperationException("Unable to find the declaration of type " + resultClass.getSimpleName()
+                    + " from " + node.getClass().getSimpleName());
+        }
+        Optional<Node> parentNode = node.getParentNode();
+        if (!parentNode.isPresent()) {
+            rememberDeclarationFailure("parameter without parent");
+            throw new UnsolvedSymbolException(
+                    "We are unable to resolve the parameter declaration corresponding to " + node);
+        }
+        Node parent = parentNode.get();
+        if (parent instanceof ConstructorDeclaration) {
+            Optional<ResolvedParameterDeclaration> resolvedParameterDeclaration =
+                    resolveMethodLikeParameter(((ConstructorDeclaration) parent).resolve(), node);
+            return resolvedParameterDeclaration
+                    .map(rpd -> resultClass.cast(rpd))
+                    .orElseThrow(() -> new UnsolvedSymbolException(
+                            "We are unable to resolve the parameter declaration corresponding to " + node));
+        }
+        if (parent instanceof MethodDeclaration) {
+            Optional<ResolvedParameterDeclaration> resolvedParameterDeclaration =
+                    resolveMethodLikeParameter(((MethodDeclaration) parent).resolve(), node);
+            return resolvedParameterDeclaration
+                    .map(rpd -> resultClass.cast(rpd))
+                    .orElseThrow(() -> new UnsolvedSymbolException(
+                            "We are unable to resolve the parameter declaration corresponding to " + node));
+        }
+        if (parent instanceof RecordDeclaration) {
+            Optional<ResolvedParameterDeclaration> resolvedParameterDeclaration =
+                    resolveRecordParameter(((RecordDeclaration) parent).resolve(), node);
+            return resolvedParameterDeclaration
+                    .map(rpd -> resultClass.cast(rpd))
+                    .orElseThrow(() -> new UnsolvedSymbolException(
+                            "We are unable to resolve the parameter declaration corresponding to " + node));
+        }
+        if (parent instanceof LambdaExpr || parent instanceof CatchClause) {
+            Optional<ResolvedParameterDeclaration> resolvedParameterDeclaration =
+                    resolveStandaloneParameter(node, solver);
+            return resolvedParameterDeclaration
+                    .map(rpd -> resultClass.cast(rpd))
+                    .orElseThrow(() -> new UnsolvedSymbolException(
+                            "We are unable to resolve the parameter declaration corresponding to " + node));
+        }
+        rememberDeclarationFailure("unsupported parameter parent");
+        throw new UnsolvedSymbolException(
+                "We are unable to resolve the parameter declaration corresponding to " + node);
+    }
