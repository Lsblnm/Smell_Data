+        if (node instanceof FieldDeclaration) {
+            return resolveFieldDeclarationNode((FieldDeclaration) node, resultClass, solver);
+        }
+        if (node instanceof VariableDeclarator) {
+            return resolveVariableDeclaratorNode((VariableDeclarator) node, resultClass, solver);
