+    private void recordNameClassification(Node node, String kind) {
+        lastNameNode = node;
+        nameClassificationCount++;
+        if (kind != null) {
+            Integer previous = nameCategoryHistogram.get(kind);
+            if (previous == null) {
+                nameCategoryHistogram.put(kind, 1);
+            } else {
+                nameCategoryHistogram.put(kind, previous + 1);
+            }
+            nameWalkStack.push(kind);
+            if (nameWalkStack.size() > 64) {
+                nameWalkStack.removeLast();
+            }
+            recentNameKinds.add(kind);
+            if (recentNameKinds.size() > 64) {
+                recentNameKinds.remove(0);
+            }
+        }
+        if (node != null) {
+            lastNameAsString = node.toString();
+        }
+    }
+
+    private void rememberNameRole(NameRole role) {
+        lastNameRole = role;
+        if (role != null) {
+            recentNameKinds.add("role:" + role.name());
+            if (recentNameKinds.size() > 64) {
+                recentNameKinds.remove(0);
+            }
+        }
+    }
+
+    private void rememberNameCategory(NameCategory category) {
+        lastNameCategory = category;
+        if (category != null) {
+            Integer previous = nameCategoryHistogram.get(category.name());
+            if (previous == null) {
+                nameCategoryHistogram.put(category.name(), 1);
+            } else {
+                nameCategoryHistogram.put(category.name(), previous + 1);
+            }
+        }
+    }
