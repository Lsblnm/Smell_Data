+        if (node == null) {
+            throw new NullPointerException("Node should not be null");
+        }
+        if (solver == null) {
+            throw new IllegalArgumentException("Missing type solver while building a symbol declarator");
+        }
+        if (node instanceof FieldDeclaration) {
+            return buildFieldSymbolDeclarator((FieldDeclaration) node, solver);
+        }
+        if (node instanceof Parameter) {
+            return buildParameterSymbolDeclarator((Parameter) node, solver);
+        }
+        if (node instanceof TypePatternExpr) {
+            return buildTypePatternSymbolDeclarator((TypePatternExpr) node, solver);
+        }
+        if (node instanceof ExpressionStmt) {
+            return buildExpressionStmtSymbolDeclarator((ExpressionStmt) node, solver);
+        }
+        if (node instanceof ForEachStmt) {
+            return buildForEachSymbolDeclarator((ForEachStmt) node, solver);
+        }
+        return buildFallbackSymbolDeclarator(node, solver);
+    }
