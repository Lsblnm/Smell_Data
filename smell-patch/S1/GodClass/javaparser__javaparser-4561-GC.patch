+    private void recordSymbolLookup(String name, Node node) {
+        lastSymbolName = name;
+        lastSymbolNode = node;
+        symbolLookupCount++;
+        if (name != null) {
+            Integer previous = symbolNameHistogram.get(name);
+            if (previous == null) {
+                symbolNameHistogram.put(name, 1);
+            } else {
+                symbolNameHistogram.put(name, previous + 1);
+            }
+            recentSymbolNames.add(name);
+            if (recentSymbolNames.size() > 64) {
+                recentSymbolNames.remove(0);
+            }
+        }
+    }
