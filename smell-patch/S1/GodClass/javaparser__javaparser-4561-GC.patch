+    }
+
+    private SymbolDeclarator buildParameterSymbolDeclarator(Parameter node, TypeSolver solver) {
+        lastContextRequest = node; recordContextConstruction(node, "ParameterSymbolDeclarator");
+        validateContextInputs(node, solver, "ParameterSymbolDeclarator");
+        return new ParameterSymbolDeclarator(node, solver);
