+    public SymbolReference<ResolvedConstructorDeclaration> solveObjectCreation(
+            ObjectCreationExpr objectCreationExpr, boolean solveLambdas, TypeSolver solver) {
+        lastObjectCreation = objectCreationExpr;
+        methodSolveCount++; recordMethodSolve(objectCreationExpr.getType().asString(), objectCreationExpr.getArguments().size());
+        List<ResolvedType> argumentTypes = new LinkedList<>();
+        List<LambdaArgumentTypePlaceholder> placeholders = new LinkedList<>();
+        collectArgumentTypes(
+                objectCreationExpr,
+                objectCreationExpr.getArguments(),
+                solveLambdas,
+                argumentTypes,
+                placeholders,
+                solver);
+        ResolvedReferenceTypeDeclaration typeDecl = null;
+        if (objectCreationExpr.getAnonymousClassBody().isPresent()) {
+            typeDecl = new JavaParserAnonymousClassDeclaration(objectCreationExpr, solver);
+        } else {
+            ResolvedType classDecl = JavaParserFacade.get(solver).convert(objectCreationExpr.getType(), objectCreationExpr);
+            if (classDecl.isReferenceType()
+                    && classDecl.asReferenceType().getTypeDeclaration().isPresent()) {
+                typeDecl = classDecl.asReferenceType().getTypeDeclaration().get();
+            }
+        }
+        if (typeDecl == null) {
+            return SymbolReference.unsolved();
+        }
+        SymbolReference<ResolvedConstructorDeclaration> res =
+                ConstructorResolutionLogic.findMostApplicable(typeDecl.getConstructors(), argumentTypes, solver);
+        for (LambdaArgumentTypePlaceholder placeholder : placeholders) {
+            placeholder.setMethod(res);
+        }
+        return res;
+    }
+
+    public MethodUsage solveMethodCallAsUsage(MethodCallExpr call, TypeSolver solver) {
+        lastMethodCall = call;
+        methodSolveCount++; recordMethodSolve(call.getNameAsString(), call.getArguments() == null ? 0 : call.getArguments().size());
+        List<ResolvedType> params = new ArrayList<>();
+        if (call.getArguments() != null) {
+            for (Expression param : call.getArguments()) {
+                try {
+                    params.add(JavaParserFacade.get(solver).getType(param, false));
+                } catch (Exception e) {
+                    throw wrapResolutionFailure(
+                            e,
+                            String.format("Error calculating the type of parameter %s of method call %s", param, call));
+                }
+            }
+        }
+        Context context = buildResolutionContext(call, solver);
+        Optional<MethodUsage> methodUsage = context.solveMethodAsUsage(call.getName().getId(), params);
+        if (!methodUsage.isPresent()) {
+            throw new UnsolvedSymbolException("Method '" + call.getName() + "' cannot be resolved in context " + call
+                    + " (line: " + call.getRange().map(r -> "" + r.begin.line).orElse("??") + ") " + context
+                    + ". Parameter types: " + params);
+        }
+        return methodUsage.get();
+    }
+
+
+    private static RuntimeException wrapResolutionFailure(Throwable th, String message) {
+        Throwable root = th;
+        while (root != null) {
+            if (root.getCause() == null) {
+                break;
+            }
+            root = root.getCause();
+        }
+        if (root instanceof UnsolvedSymbolException) {
+            return (RuntimeException) th;
+        }
+        if (RuntimeException.class.isAssignableFrom(th.getClass())) {
+            return (RuntimeException) th;
+        }
+        if (message == null || message.isEmpty()) {
+            return new RuntimeException(root);
+        }
+        return new RuntimeException(message, root);
+    }
+
 }
