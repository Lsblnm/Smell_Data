+    public ResolvedReferenceTypeDeclaration astToTypeDeclaration(Node node, TypeSolver solver) {
+        lastDeclarationNode = node; recordDeclarationResolution(node, "astToTypeDeclaration");
+        if (node instanceof ClassOrInterfaceDeclaration) {
+            if (((ClassOrInterfaceDeclaration) node).isInterface()) {
+                return new JavaParserInterfaceDeclaration((ClassOrInterfaceDeclaration) node, solver);
+            }
+            return new JavaParserClassDeclaration((ClassOrInterfaceDeclaration) node, solver);
+        }
+        if (node instanceof TypeParameter) {
+            return new JavaParserTypeParameter((TypeParameter) node, solver);
+        }
+        if (node instanceof EnumDeclaration) {
+            return new JavaParserEnumDeclaration((EnumDeclaration) node, solver);
+        }
+        if (node instanceof AnnotationDeclaration) {
+            return new JavaParserAnnotationDeclaration((AnnotationDeclaration) node, solver);
+        }
+        if (node instanceof EnumConstantDeclaration) {
+            return new JavaParserEnumDeclaration((EnumDeclaration) demandParentNode(node), solver);
+        }
+        if (node instanceof RecordDeclaration) {
+            return new JavaParserRecordDeclaration((RecordDeclaration) node, solver);
+        }
+        rememberDeclarationFailure("unknown type declaration node");
+        throw new IllegalArgumentException("Cannot get a reference type declaration from "
+                + node.getClass().getCanonicalName());
+    }
