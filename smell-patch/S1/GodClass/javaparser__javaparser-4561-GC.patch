+        validateContextInputs(node, solver, "FieldSymbolDeclarator");
+        FieldSymbolDeclarator declarator = new FieldSymbolDeclarator(node, solver);
+        rememberContextResult("FieldSymbolDeclarator", lastBuiltContext);
