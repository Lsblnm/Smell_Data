+        validateContextInputs(node, solver, "TypePatternSymbolDeclarator");
+        return new TypePatternSymbolDeclarator(node, solver);
+    }
+
+    private SymbolDeclarator buildExpressionStmtSymbolDeclarator(ExpressionStmt node, TypeSolver solver) {
+        lastContextRequest = node; recordContextConstruction(node, "ExpressionStmtSymbolDeclarator");
+        validateContextInputs(node, solver, "ExpressionStmtSymbolDeclarator");
