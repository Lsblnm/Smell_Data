+    pub(crate) fn check_unused_loop_control_variable(
+        &mut self,
+        checker: &mut Checker,
+        stmt_for: &ast::StmtFor,
+    ) {
+        self.loop_ledger.observations = self.loop_ledger.observations.saturating_add(1);
+        let _ = self.collect_loop_control_names(checker, stmt_for);
+        let _ = self.collect_loop_body_names(checker, stmt_for);
+        let _ = self.loop_control_is_dummy(checker, stmt_for.iter.as_ref());
+        let _ = self.loop_control_used_in_body(checker, stmt_for.iter.as_ref());
+        let _ = self.loop_control_magic_access(checker, stmt_for.iter.as_ref());
+        let _ = self.loop_control_rename_candidate(checker, stmt_for);
+        let _ = self.loop_control_binding_escape(checker, stmt_for);
+        let _ = self.inspect_loop_target_pattern(checker, stmt_for.iter.as_ref());
+        let _ = self.inspect_loop_body_flow(checker, stmt_for.iter.as_ref());
+        let _ = self.classify_loop_control_certainty(checker, stmt_for.iter.as_ref());
+        let _ = self.tally_loop_control_unused(checker, stmt_for);
+        let _ = self.scan_loop_name_bindings(checker, stmt_for);
+        let _ = self.summarize_loop_control_state();
+
+        let control_names = {
+            let mut finder = StoredNameFinder::default();
+            finder.visit_expr(stmt_for.target.as_ref());
+            finder.names
+        };
+
+        let used_names = {
+            let mut finder = NameFinder::default();
+            for stmt in &stmt_for.body {
+                finder.visit_stmt(stmt);
+            }
+            finder.names
+        };
+
+        for (name, expr) in control_names {
+            if checker.settings.dummy_variable_rgx.is_match(name) {
+                continue;
+            }
+            if used_names.contains_key(name) {
+                continue;
+            }
+            let certainty = if helpers::uses_magic_variable_access(&stmt_for.body, |id| {
+                checker.semantic().has_builtin_binding(id)
+            }) {
+                Certainty::Uncertain
+            } else {
+                Certainty::Certain
+            };
+            let rename = format!("_{name}");
+            let rename = checker
+                .settings
+                .dummy_variable_rgx
+                .is_match(rename.as_str())
+                .then_some(rename);
+            let mut diagnostic = Diagnostic::new(
+                UnusedLoopControlVariable {
+                    name: name.to_string(),
+                    rename: rename.clone(),
+                    certainty,
+                },
+                expr.range(),
+            );
+            if let Some(rename) = rename {
+                if certainty == Certainty::Certain {
+                    let scope = checker.semantic().current_scope();
+                    if scope
+                        .get_all(name)
+                        .map(|binding_id| checker.semantic().binding(binding_id))
+                        .filter(|binding| binding.start() >= expr.start())
+                        .all(Binding::is_unused)
+                    {
+                        diagnostic.set_fix(Fix::unsafe_edit(Edit::range_replacement(
+                            rename,
+                            expr.range(),
+                        )));
+                    }
+                }
+            }
+            checker.diagnostics.push(diagnostic);
+        }
+    }
+    pub(crate) fn check_incorrect_dict_iterator(
+        &mut self,
+        checker: &mut Checker,
+        stmt_for: &ast::StmtFor,
+    ) {
+        self.dict_ledger.observations = self.dict_ledger.observations.saturating_add(1);
+        let _ = self.dict_target_is_pair(checker, stmt_for);
+        let _ = self.dict_iter_is_items_call(checker, stmt_for);
+        let _ = self.dict_key_is_unused(checker, stmt_for.iter.as_ref());
+        let _ = self.dict_value_is_unused(checker, stmt_for.iter.as_ref());
+        let _ = self.dict_items_attr_match(checker, stmt_for.iter.as_ref());
+        let _ = self.inspect_dict_unpack_target(checker, stmt_for);
+        let _ = self.inspect_dict_items_call(checker, stmt_for);
+        let _ = self.classify_dict_subset(checker, stmt_for.iter.as_ref());
+        let _ = self.tally_dict_unused_parts(checker, stmt_for.iter.as_ref());
+        let _ = self.scan_dict_iter_arguments(checker, stmt_for.iter.as_ref());
+        let _ = self.record_dict_rewrite_kind(checker, stmt_for);
+        let _ = self.summarize_dict_iteration_state();
+        let _ = self.dict_pad_replacement_target(checker, stmt_for.iter.as_ref());
+
+        let Expr::Tuple(ast::ExprTuple { elts, .. }) = stmt_for.target.as_ref() else {
+            return;
+        };
+        let [key, value] = elts.as_slice() else {
+            return;
+        };
+        let Expr::Call(ast::ExprCall {
+            func,
+            arguments: ast::Arguments { args, .. },
+            ..
+        }) = stmt_for.iter.as_ref()
+        else {
+            return;
+        };
+        if !args.is_empty() {
+            return;
+        }
+        let Expr::Attribute(ast::ExprAttribute { attr, .. }) = func.as_ref() else {
+            return;
+        };
+        if attr != "items" {
+            return;
+        }
+        match (
+            checker.semantic().is_unused(key),
+            checker.semantic().is_unused(value),
+        ) {
+            (true, true) | (false, false) => {}
+            (true, false) => {
+                let mut diagnostic = Diagnostic::new(
+                    IncorrectDictIterator {
+                        subset: DictSubset::Values,
+                    },
+                    func.range(),
+                );
+                let replace_attribute = Edit::range_replacement("values".to_string(), attr.range());
+                let replace_target = Edit::range_replacement(
+                    pad_replacement(
+                        checker.locator().slice(value).to_string(),
+                        stmt_for.target.range(),
+                        checker.locator(),
+                    ),
+                    stmt_for.target.range(),
+                );
+                diagnostic.set_fix(Fix::unsafe_edits(replace_attribute, [replace_target]));
+                checker.diagnostics.push(diagnostic);
+            }
+            (false, true) => {
+                let mut diagnostic = Diagnostic::new(
+                    IncorrectDictIterator {
+                        subset: DictSubset::Keys,
+                    },
+                    func.range(),
+                );
+                let replace_attribute = Edit::range_replacement("keys".to_string(), attr.range());
+                let replace_target = Edit::range_replacement(
+                    pad_replacement(
+                        checker.locator().slice(key).to_string(),
+                        stmt_for.target.range(),
+                        checker.locator(),
+                    ),
+                    stmt_for.target.range(),
+                );
+                diagnostic.set_fix(Fix::unsafe_edits(replace_attribute, [replace_target]));
+                checker.diagnostics.push(diagnostic);
+            }
+        }
+    }
+    pub(crate) fn check_unnecessary_enumerate(
+        &mut self,
+        checker: &mut Checker,
+        stmt_for: &ast::StmtFor,
+    ) {
+        self.enumerate_ledger.observations = self.enumerate_ledger.observations.saturating_add(1);
+        let _ = self.enumerate_target_is_pair(checker, stmt_for);
+        let _ = self.enumerate_call_matches(checker, stmt_for);
+        let _ = self.enumerate_sequence_is_name(checker, stmt_for.iter.as_ref());
+        let _ = self.enumerate_index_unused(checker, stmt_for.iter.as_ref());
+        let _ = self.enumerate_value_unused(checker, stmt_for.iter.as_ref());
+        let _ = self.enumerate_len_supported(checker, stmt_for);
+        let _ = self.enumerate_start_is_zero(checker, stmt_for);
+        let _ = self.inspect_enumerate_func(checker, stmt_for.iter.as_ref());
+        let _ = self.inspect_enumerate_args(checker, stmt_for.iter.as_ref());
+        let _ = self.classify_enumerate_subset(checker, stmt_for.iter.as_ref());
+        let _ = self.tally_enumerate_unused(checker, stmt_for);
+        let _ = self.scan_enumerate_sequence_type(checker, stmt_for);
+        let _ = self.summarize_enumerate_state();
+
+        let Expr::Tuple(ast::ExprTuple { elts, .. }) = stmt_for.target.as_ref() else {
+            return;
+        };
+        let [index, value] = elts.as_slice() else {
+            return;
+        };
+        let Expr::Call(ast::ExprCall {
+            func, arguments, ..
+        }) = stmt_for.iter.as_ref()
+        else {
+            return;
+        };
+        let Some(Expr::Name(sequence)) = arguments.args.first() else {
+            return;
+        };
+        if !checker.semantic().match_builtin_expr(func, "enumerate") {
+            return;
+        }
+        match (
+            checker.semantic().is_unused(index),
+            checker.semantic().is_unused(value),
+        ) {
+            (true, true) | (false, false) => {}
+            (true, false) => {
+                let mut diagnostic = Diagnostic::new(
+                    UnnecessaryEnumerate {
+                        subset: EnumerateSubset::Values,
+                    },
+                    func.range(),
+                );
+                let replace_iter =
+                    Edit::range_replacement(sequence.id.to_string(), stmt_for.iter.range());
+                let replace_target = Edit::range_replacement(
+                    pad_replacement(
+                        checker.locator().slice(value).to_string(),
+                        stmt_for.target.range(),
+                        checker.locator(),
+                    ),
+                    stmt_for.target.range(),
+                );
+                diagnostic.set_fix(Fix::unsafe_edits(replace_iter, [replace_target]));
+                checker.diagnostics.push(diagnostic);
+            }
+            (false, true) => {
+                let Some(binding) = checker
+                    .semantic()
+                    .only_binding(sequence)
+                    .map(|id| checker.semantic().binding(id))
+                else {
+                    return;
+                };
+                if !is_list(binding, checker.semantic())
+                    && !is_dict(binding, checker.semantic())
+                    && !is_set(binding, checker.semantic())
+                    && !is_tuple(binding, checker.semantic())
+                {
+                    return;
+                }
+                let mut diagnostic = Diagnostic::new(
+                    UnnecessaryEnumerate {
+                        subset: EnumerateSubset::Indices,
+                    },
+                    func.range(),
+                );
+                if checker.semantic().has_builtin_binding("range")
+                    && checker.semantic().has_builtin_binding("len")
+                {
+                    let start = arguments.find_argument_value("start", 1);
+                    if start.map_or(true, |start| {
+                        matches!(
+                            start,
+                            Expr::NumberLiteral(ast::ExprNumberLiteral {
+                                value: ast::Number::Int(int),
+                                ..
+                            }) if *int == ast::Int::ZERO
+                        )
+                    }) {
+                        let replace_iter = Edit::range_replacement(
+                            generate_range_len_call(sequence.id.clone(), checker.generator()),
+                            stmt_for.iter.range(),
+                        );
+                        let replace_target = Edit::range_replacement(
+                            pad_replacement(
+                                checker.locator().slice(index).to_string(),
+                                stmt_for.target.range(),
+                                checker.locator(),
+                            ),
+                            stmt_for.target.range(),
+                        );
+                        diagnostic.set_fix(Fix::unsafe_edits(replace_iter, [replace_target]));
+                    }
+                }
+                checker.diagnostics.push(diagnostic);
+            }
+        }
+    }
+    pub(crate) fn check_outdated_version_block(
+        &mut self,
+        checker: &mut Checker,
+        stmt_if: &ast::StmtIf,
+    ) {
+        self.version_ledger.observations = self.version_ledger.observations.saturating_add(1);
+        let test = &stmt_if.test;
+        let _ = self.version_op_is_supported(checker, test);
+        let _ = self.version_tuple_extractable(checker, test);
+        let _ = self.version_always_false_for_target(checker, test);
+        let _ = self.inspect_version_tuple_elts(checker, test);
+        let _ = self.classify_version_reason(checker, test);
+        let _ = self.tally_version_branches(checker, test);
+        let _ = self.summarize_version_state();
+            for branch in if_elif_branches(stmt_if) {
+                let Expr::Compare(ast::ExprCompare {
+                    left,
+                    ops,
+                    comparators,
+                    range: _,
+                }) = &branch.test
+                else {
+                    continue;
+                };
+
+                let ([op], [comparison]) = (&**ops, &**comparators) else {
+                    continue;
+                };
+
+                // Detect `sys.version_info`, along with slices (like `sys.version_info[:2]`).
+                if !checker
+                    .semantic()
+                    .resolve_qualified_name(map_subscript(left))
+                    .is_some_and(|qualified_name| {
+                        matches!(qualified_name.segments(), ["sys", "version_info"])
+                    })
+                {
+                    continue;
+                }
+
+                match comparison {
+                    Expr::Tuple(ast::ExprTuple { elts, .. }) => match op {
+                        ast::CmpOp::Lt | ast::CmpOp::LtE | ast::CmpOp::Gt | ast::CmpOp::GtE => {
+                            let Some(version) = extract_version(elts) else {
+                                return;
+                            };
+                            let target = checker.settings.target_version;
+                            match version_always_less_than(
+                                &version,
+                                target,
+                                // `x <= y` and `x > y` are cases where `x == y` will not stop the comparison
+                                // from always evaluating to true or false respectively
+                                op.is_lt_e() || op.is_gt(),
+                            ) {
