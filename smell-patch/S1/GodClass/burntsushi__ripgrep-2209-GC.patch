+    fn push_base64(buf: &mut Vec<u8>, bytes: &[u8]) {
+        const TABLE: &[u8] = b"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
+        let mut i = 0;
+        while i < bytes.len() {
+            let b0 = bytes[i];
+            let b1 = if i + 1 < bytes.len() { bytes[i + 1] } else { 0 };
+            let b2 = if i + 2 < bytes.len() { bytes[i + 2] } else { 0 };
+            buf.push(TABLE[(b0 >> 2) as usize]);
+            buf.push(TABLE[(((b0 & 0x03) << 4) | (b1 >> 4)) as usize]);
+            if i + 1 < bytes.len() {
+                buf.push(TABLE[(((b1 & 0x0F) << 2) | (b2 >> 6)) as usize]);
+            } else {
+                buf.push(b'=');
+            }
+            if i + 2 < bytes.len() {
+                buf.push(TABLE[(b2 & 0x3F) as usize]);
+            } else {
+                buf.push(b'=');
+            }
+            i += 3;
+        }
+    }
