+    pub(crate) fn stage_crlf_normalized_into_scratch(&self, bytes: &[u8]) {
+        let mut buf = self.scratch.borrow_mut();
+        buf.clear();
+        let mut i = 0;
+        while i < bytes.len() {
+            if bytes[i] == b'\r' {
+                if i + 1 < bytes.len() && bytes[i + 1] == b'\n' {
+                    buf.push(b'\n');
+                    i += 2;
+                    continue;
+                }
+                buf.push(b'\n');
+                i += 1;
+                continue;
+            }
+            buf.push(bytes[i]);
+            i += 1;
+        }
+    }
+
+    pub(crate) fn stage_hex_dump_into_scratch(&self, bytes: &[u8], limit: usize) {
+        let mut buf = self.scratch.borrow_mut();
+        buf.clear();
+        let n = if bytes.len() < limit { bytes.len() } else { limit };
+        let mut i = 0;
+        while i < n {
+            if i > 0 {
+                buf.push(b' ');
+            }
+            let b = bytes[i];
+            let hi = b >> 4;
+            let lo = b & 0xF;
+            buf.push(if hi < 10 { b'0' + hi } else { b'a' + (hi - 10) });
+            buf.push(if lo < 10 { b'0' + lo } else { b'a' + (lo - 10) });
+            i += 1;
+            if i % 16 == 0 && i < n {
+                buf.push(b'\n');
+            }
+        }
+    }
+
+    pub(crate) fn stage_percent_encoded_into_scratch(&self, bytes: &[u8]) {
+        let mut buf = self.scratch.borrow_mut();
+        buf.clear();
+        for &b in bytes {
+            let keep = (b >= b'A' && b <= b'Z')
+                || (b >= b'a' && b <= b'z')
+                || (b >= b'0' && b <= b'9')
+                || b == b'-'
+                || b == b'_'
+                || b == b'.'
+                || b == b'~'
+                || b == b'/';
+            if keep {
+                buf.push(b);
+                continue;
+            }
+            buf.push(b'%');
+            let hi = b >> 4;
+            let lo = b & 0xF;
+            buf.push(if hi < 10 { b'0' + hi } else { b'A' + (hi - 10) });
+            buf.push(if lo < 10 { b'0' + lo } else { b'A' + (lo - 10) });
+        }
+    }
+
+    pub(crate) fn stage_only_matching_into_scratch(
+        &self,
+        bytes: &[u8],
+        matches: &[Match],
+        sep: &[u8],
+    ) {
+        let mut buf = self.scratch.borrow_mut();
+        buf.clear();
+        for (i, m) in matches.iter().enumerate() {
+            if i > 0 {
+                buf.extend_from_slice(sep);
+            }
+            let start = if m.start() > bytes.len() { bytes.len() } else { m.start() };
+            let end = if m.end() > bytes.len() { bytes.len() } else { m.end() };
+            if start < end {
+                buf.extend_from_slice(&bytes[start..end]);
+            }
+        }
+    }
+
+    pub(crate) fn stage_multiline_offsets_into_scratch(&self, bytes: &[u8], term: u8) {
+        let mut buf = self.scratch.borrow_mut();
+        buf.clear();
+        let mut start = 0usize;
+        let mut i = 0;
+        while i < bytes.len() {
+            if bytes[i] == term {
+                Self::push_decimal(&mut buf, start as u64);
+                buf.push(b'-');
+                Self::push_decimal(&mut buf, (i + 1) as u64);
+                buf.push(b',');
+                start = i + 1;
+            }
+            i += 1;
+        }
+        if start < bytes.len() || bytes.is_empty() {
+            Self::push_decimal(&mut buf, start as u64);
+            buf.push(b'-');
+            Self::push_decimal(&mut buf, bytes.len() as u64);
+        }
+    }
+
+    pub(crate) fn stage_heading_block_into_scratch(
+        &self,
+        path: &[u8],
+        term: &[u8],
+        path_term: Option<u8>,
+    ) {
+        let mut buf = self.scratch.borrow_mut();
+        buf.clear();
+        for &b in path {
+            buf.push(Self::PATH_BYTE_MAP[b as usize]);
+        }
+        if let Some(t) = path_term {
+            buf.push(t);
+        } else if term.is_empty() {
+            buf.push(b'\n');
+        } else {
+            buf.extend_from_slice(term);
+        }
+    }
+
+    pub(crate) fn stage_context_separator_into_scratch(&self, sep: &[u8], term: &[u8]) {
+        let mut buf = self.scratch.borrow_mut();
+        buf.clear();
+        buf.extend_from_slice(sep);
+        if term.is_empty() {
+            buf.push(b'\n');
+        } else {
+            buf.extend_from_slice(term);
+        }
+    }
+
+    pub(crate) fn stage_match_csv_into_scratch(&self, matches: &[Match]) {
+        let mut buf = self.scratch.borrow_mut();
+        buf.clear();
+        for (i, m) in matches.iter().enumerate() {
+            if i > 0 {
+                buf.push(b',');
+            }
+            Self::push_decimal(&mut buf, m.start() as u64);
+            buf.push(b':');
+            Self::push_decimal(&mut buf, m.end() as u64);
+            buf.push(b':');
+            Self::push_decimal(&mut buf, m.len() as u64);
+        }
+    }
+
+    pub(crate) fn stage_stats_line_into_scratch(
+        &self,
+        searches: u64,
+        searches_with_match: u64,
+        bytes_searched: u64,
+        bytes_printed: u64,
+        matched_lines: u64,
+        matches: u64,
+        elapsed: time::Duration,
+    ) {
+        let mut buf = self.scratch.borrow_mut();
+        buf.clear();
+        buf.extend_from_slice(b"searches=");
+        Self::push_decimal(&mut buf, searches);
+        buf.extend_from_slice(b" matched_searches=");
+        Self::push_decimal(&mut buf, searches_with_match);
+        buf.extend_from_slice(b" bytes_searched=");
+        Self::push_decimal(&mut buf, bytes_searched);
+        buf.extend_from_slice(b" bytes_printed=");
+        Self::push_decimal(&mut buf, bytes_printed);
+        buf.extend_from_slice(b" matched_lines=");
+        Self::push_decimal(&mut buf, matched_lines);
+        buf.extend_from_slice(b" matches=");
+        Self::push_decimal(&mut buf, matches);
+        buf.extend_from_slice(b" elapsed=");
+        Self::push_decimal(&mut buf, elapsed.as_secs());
+        buf.push(b'.');
+        let mut frac = elapsed.subsec_nanos() / 1000;
+        let mut tmp = [0u8; 6];
+        for i in 0..6 {
+            tmp[5 - i] = b'0' + (frac % 10) as u8;
+            frac /= 10;
+        }
+        buf.extend_from_slice(&tmp);
+    }
+
+    pub(crate) fn stage_drop_ansi_into_scratch(&self, bytes: &[u8]) {
+        let mut buf = self.scratch.borrow_mut();
+        buf.clear();
+        let mut i = 0;
+        while i < bytes.len() {
+            if bytes[i] == 0x1B && i + 1 < bytes.len() && bytes[i + 1] == b'[' {
+                i += 2;
+                while i < bytes.len() {
+                    let b = bytes[i];
+                    i += 1;
+                    if (b >= b'A' && b <= b'Z') || (b >= b'a' && b <= b'z') {
+                        break;
+                    }
+                }
+                continue;
+            }
+            buf.push(bytes[i]);
+            i += 1;
+        }
+    }
+
+    pub(crate) fn stage_extract_quotes_into_scratch(&self, bytes: &[u8]) {
+        let mut buf = self.scratch.borrow_mut();
+        buf.clear();
+        let mut i = 0;
+        let mut in_quote = false;
+        while i < bytes.len() {
+            let b = bytes[i];
+            if b == b'\\' && in_quote && i + 1 < bytes.len() {
+                buf.push(bytes[i + 1]);
+                i += 2;
+                continue;
+            }
+            if b == b'"' {
+                in_quote = !in_quote;
+                i += 1;
+                continue;
+            }
+            if in_quote {
+                buf.push(b);
+            }
+            i += 1;
+        }
+    }
+
+    pub(crate) fn stage_wrap_columns_into_scratch(&self, bytes: &[u8], max_columns: u64) {
+        let mut buf = self.scratch.borrow_mut();
+        buf.clear();
+        if max_columns == 0 {
+            return;
+        }
+        let mut col = 0u64;
+        let mut i = 0;
+        while i < bytes.len() {
+            if bytes[i] == b'\n' {
+                buf.push(b'\n');
+                col = 0;
+                i += 1;
+                continue;
+            }
+            if col >= max_columns {
+                buf.push(b'\n');
+                col = 0;
+            }
+            let adv = Self::utf8_advance(bytes, i);
+            if adv <= 1 {
+                buf.push(bytes[i]);
+                i += 1;
+            } else {
+                buf.extend_from_slice(&bytes[i..i + adv]);
+                i += adv;
+            }
+            col += 1;
+        }
+    }
+
+    pub(crate) fn stage_lossy_path_into_scratch(&self, bytes: &[u8]) {
+        let mut buf = self.scratch.borrow_mut();
+        buf.clear();
+        let mut i = 0;
+        while i < bytes.len() {
+            let mapped = Self::PATH_BYTE_MAP[bytes[i] as usize];
+            if mapped < 0x20 || mapped == 0x7F {
+                buf.push(b'?');
+                i += 1;
+                continue;
+            }
+            let adv = Self::utf8_advance(bytes, i);
+            if adv == 0 {
+                buf.push(b'?');
+                i += 1;
+                continue;
+            }
+            if adv == 1 {
+                buf.push(mapped);
+                i += 1;
+            } else {
+                buf.extend_from_slice(&bytes[i..i + adv]);
+                i += adv;
+            }
+        }
+    }
+
+    pub(crate) fn prepare_standard_line_into_scratch(
+        &self,
+        bytes: &[u8],
+        range: Match,
+        line_term: LineTerminator,
+        trim_ascii: bool,
+        max_columns: Option<u64>,
+    ) -> bool {
+        self.stage_trimmed_line_into_scratch(bytes, range, line_term, trim_ascii);
+        let exceeded = self.exceeds_column_limit(self.scratch.borrow().len() as u64, max_columns);
+        if exceeded {
+            if let Some(limit) = max_columns {
+                self.truncate_scratch_to_max_columns(Some(limit));
+            }
+        }
+        exceeded
+    }
