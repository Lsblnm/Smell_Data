+    pub(crate) fn match_line_span(&self, bytes: &[u8], m: Match, term: u8) -> Match {
+        let start = if m.start() > bytes.len() { bytes.len() } else { m.start() };
+        let mut line_start = start;
+        while line_start > 0 {
+            let prev = bytes[line_start - 1];
+            if prev == term {
+                break;
+            }
+            if term == b'\n' && prev == b'\r' {
+                break;
+            }
+            line_start -= 1;
+        }
+        let mut line_end = if m.end() > bytes.len() { bytes.len() } else { m.end() };
+        while line_end < bytes.len() {
+            if bytes[line_end] == term {
+                line_end += 1;
+                break;
+            }
+            if term == b'\n' && bytes[line_end] == b'\r' {
+                line_end += 1;
+                if line_end < bytes.len() && bytes[line_end] == b'\n' {
+                    line_end += 1;
+                }
+                break;
+            }
+            line_end += 1;
+        }
+        Match::new(line_start, line_end)
+    }
