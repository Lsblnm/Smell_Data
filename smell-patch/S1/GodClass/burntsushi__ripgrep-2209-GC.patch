+    pub(crate) fn leading_width(&self, bytes: &[u8], tabw: usize) -> usize {
+        let mut i = 0usize;
+        let mut col = 0usize;
+        let width = if tabw == 0 { 8 } else { tabw };
+        while i < bytes.len() {
+            let b = bytes[i];
+            if b == b' ' {
+                col += 1;
+                i += 1;
+                continue;
+            }
+            if b == b'\t' {
+                let n = width - (col % width);
+                col += if n == 0 { width } else { n };
+                i += 1;
+                continue;
+            }
+            break;
+        }
+        col
+    }
