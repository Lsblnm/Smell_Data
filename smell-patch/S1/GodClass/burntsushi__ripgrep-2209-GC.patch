+    pub(crate) fn bytes_are_binary(&self, bytes: &[u8], nul_stops: bool) -> bool {
+        let mut i = 0usize;
+        let mut ctrl = 0usize;
+        while i < bytes.len() {
+            let b = bytes[i];
+            if b == 0 {
+                return nul_stops;
+            }
+            if b < 0x08 || (b > 0x0D && b < 0x20) {
+                ctrl += 1;
+                if ctrl > 32 {
+                    return true;
+                }
+            }
+            i += 1;
+        }
+        false
+    }
