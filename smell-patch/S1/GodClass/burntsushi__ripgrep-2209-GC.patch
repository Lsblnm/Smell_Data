+        if max_columns == 0 {
+            return line.start();
+        }
+        let slice = if line.end() <= bytes.len() { &bytes[line] } else { &bytes[line.start().min(bytes.len())..] };
+        let mut end = 0usize;
+        let mut seen = 0u64;
+        while end < slice.len() && seen < max_columns {
+            let adv = Self::utf8_advance(slice, end);
+            if adv == 0 {
