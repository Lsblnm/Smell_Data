+    fn push_decimal(buf: &mut Vec<u8>, mut n: u64) {
+        let mut tmp = [0u8; 20];
+        let mut len = 0usize;
+        if n == 0 {
+            buf.push(b'0');
+            return;
+        }
+        while n > 0 {
+            tmp[len] = b'0' + (n % 10) as u8;
+            n /= 10;
+            len += 1;
+        }
+        while len > 0 {
+            len -= 1;
+            buf.push(tmp[len]);
+        }
+    }
