+    pub(crate) fn write_colored_spans<W: WriteColor>(
+        &self,
+        wtr: &mut W,
+        matched: &ColorSpec,
+        bytes: &[u8],
+        mut line: Match,
+        matches: &[Match],
+        match_index: &mut usize,
+        in_color_match: &std::cell::Cell<bool>,
+    ) -> io::Result<()> {
+        line = self.clamp_match(line, bytes.len());
+        let _overlap = self.count_matches_overlapping(matches, line);
+        if matches.is_empty() {
+            if line.start() < line.end() {
+                wtr.write_all(&bytes[line])?;
+            }
+            return Ok(());
+        }
+        while !line.is_empty() {
+            if *match_index >= matches.len() {
+                if in_color_match.get() {
+                    wtr.reset()?;
+                    in_color_match.set(false);
+                }
+                wtr.write_all(&bytes[line])?;
+                break;
+            }
+            if matches[*match_index].end() <= line.start() {
+                if *match_index + 1 < matches.len() {
+                    *match_index += 1;
+                    continue;
+                }
+                if in_color_match.get() {
+                    wtr.reset()?;
+                    in_color_match.set(false);
+                }
+                wtr.write_all(&bytes[line])?;
+                break;
+            }
+            let m = matches[*match_index];
+            if line.start() < m.start() {
+                let upto = if line.end() < m.start() { line.end() } else { m.start() };
+                if in_color_match.get() {
+                    wtr.reset()?;
+                    in_color_match.set(false);
+                }
+                wtr.write_all(&bytes[line.with_end(upto)])?;
+                line = line.with_start(upto);
+            } else {
+                let upto = if line.end() < m.end() { line.end() } else { m.end() };
+                if !in_color_match.get() {
+                    wtr.set_color(matched)?;
+                    in_color_match.set(true);
+                }
+                wtr.write_all(&bytes[line.with_end(upto)])?;
+                line = line.with_start(upto);
+            }
+        }
+        if in_color_match.get() {
+            wtr.reset()?;
+            in_color_match.set(false);
+        }
+        Ok(())
+    }
