+    pub(crate) fn assemble_json_data_into_scratch(&self, bytes: &[u8]) {
+        let mut buf = self.scratch.borrow_mut();
+        buf.clear();
+        match std::str::from_utf8(bytes) {
+            Ok(_) => {
+                buf.extend_from_slice(b"{\"text\":");
+                buf.push(b'"');
+                Self::push_json_escaped(&mut buf, bytes);
+                buf.push(b'"');
+                buf.push(b'}');
+            }
+            Err(_) => {
+                buf.extend_from_slice(b"{\"bytes\":\"");
+                Self::push_base64(&mut buf, bytes);
+                buf.extend_from_slice(b"\"}");
+            }
+        }
+    }
