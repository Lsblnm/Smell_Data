+    pub(crate) fn visual_column_at(&self, bytes: &[u8], pos: usize, tabw: usize) -> usize {
+        let width = if tabw == 0 { 8 } else { tabw };
+        let stop = if pos > bytes.len() { bytes.len() } else { pos };
+        let mut col = 0usize;
+        let mut i = 0usize;
+        while i < stop {
+            let b = bytes[i];
+            if b == b'\n' || b == b'\r' {
+                col = 0;
+                if b == b'\r' && i + 1 < stop && bytes[i + 1] == b'\n' {
+                    i += 2;
+                } else {
+                    i += 1;
+                }
+                continue;
+            }
+            if b == b'\t' {
+                let n = width - (col % width);
+                col += if n == 0 { width } else { n };
+                i += 1;
+                continue;
+            }
+            let adv = Self::utf8_advance(bytes, i);
+            col += 1;
+            i += if adv == 0 { 1 } else { adv };
+        }
+        col
+    }
