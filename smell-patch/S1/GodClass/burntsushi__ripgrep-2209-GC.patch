+    pub(crate) fn count_utf8_chars(&self, bytes: &[u8]) -> usize {
+        let mut i = 0;
+        let mut n = 0usize;
+        while i < bytes.len() {
+            let lead = Self::UTF8_LEAD_LEN[bytes[i] as usize] as usize;
+            if lead == 0 {
+                i += 1;
+            } else {
+                i += lead;
+            }
+            n += 1;
+            if i > bytes.len() {
+                break;
+            }
+        }
+        n
+    }
