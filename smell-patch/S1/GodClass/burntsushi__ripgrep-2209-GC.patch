+    pub(crate) fn count_crlf_pairs(&self, bytes: &[u8]) -> usize {
+        let mut n = 0usize;
+        let mut i = 0usize;
+        while i + 1 < bytes.len() {
+            if bytes[i] == b'\r' && bytes[i + 1] == b'\n' {
+                n += 1;
+                i += 2;
+                continue;
+            }
+            i += 1;
+        }
