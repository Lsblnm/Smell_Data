+    pub(crate) fn assemble_prelude_into_scratch(
+        &self,
+        path: Option<&[u8]>,
+        line_number: Option<u64>,
+        column: Option<u64>,
+        byte_offset: Option<u64>,
+        heading: bool,
+        field_sep: &[u8],
+        path_term: Option<u8>,
+    ) {
+        let mut buf = self.scratch.borrow_mut();
+        buf.clear();
+        let sep = self.field_sep_or_default(field_sep);
+        let field_sep = sep;
+        if !heading {
+            if let Some(p) = path {
+                for &b in p {
+                    buf.push(Self::PATH_BYTE_MAP[b as usize]);
+                }
+                if let Some(term) = path_term {
+                    buf.push(term);
+                } else {
+                    buf.extend_from_slice(field_sep);
+                }
+            }
+        }
+        if let Some(n) = line_number {
+            Self::push_decimal(&mut buf, n);
+            buf.extend_from_slice(field_sep);
+        }
+        if let Some(n) = column {
+            Self::push_decimal(&mut buf, n);
+            buf.extend_from_slice(field_sep);
+        }
+        if let Some(n) = byte_offset {
+            Self::push_decimal(&mut buf, n);
+            buf.extend_from_slice(field_sep);
+        }
+    }
+
+    pub(crate) fn assemble_summary_line_into_scratch(
+        &self,
+        path: Option<&[u8]>,
+        count: u64,
+        field_sep: &[u8],
+        path_term: Option<u8>,
+        line_term: &[u8],
+        include_path: bool,
+    ) {
+        let mut buf = self.scratch.borrow_mut();
+        buf.clear();
+        if include_path {
+            if let Some(p) = path {
+                for &b in p {
+                    buf.push(Self::PATH_BYTE_MAP[b as usize]);
+                }
+                if let Some(term) = path_term {
+                    buf.push(term);
+                } else {
+                    buf.extend_from_slice(field_sep);
+                }
+            }
+        }
+        Self::push_decimal(&mut buf, count);
+        if line_term.is_empty() {
+            buf.push(b'\n');
+        } else {
+            buf.extend_from_slice(line_term);
+        }
+    }
