+    pub(crate) fn last_non_empty_match<'a>(&self, matches: &'a [Match]) -> Option<&'a Match> {
+        let mut i = matches.len();
+        while i > 0 {
+            i -= 1;
+            if !matches[i].is_empty() {
+                return Some(&matches[i]);
+            }
+        }
+        None
+    }
