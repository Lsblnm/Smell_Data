+    pub(crate) fn collect_line_ranges(&self, bytes: &[u8], term: u8) -> Vec<Match> {
+        self.stage_multiline_offsets_into_scratch(bytes, term);
+        let mut out = Vec::new();
+        if bytes.is_empty() {
+            return out;
+        }
+        let mut start = 0usize;
+        let mut i = 0usize;
+        while i < bytes.len() {
+            if bytes[i] == term {
+                out.push(Match::new(start, i + 1));
+                start = i + 1;
+                i += 1;
+                continue;
+            }
+            if term == b'\n' && bytes[i] == b'\r' {
+                let end = if i + 1 < bytes.len() && bytes[i + 1] == b'\n' {
+                    i + 2
+                } else {
+                    i + 1
+                };
+                out.push(Match::new(start, end));
+                start = end;
+                i = end;
+                continue;
+            }
+            i += 1;
+        }
+        if start < bytes.len() {
+            out.push(Match::new(start, bytes.len()));
+        }
+        out
+    }
