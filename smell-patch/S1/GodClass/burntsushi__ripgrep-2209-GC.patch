+    pub(crate) fn format_padded_decimal_into_scratch(&self, n: u64, width: usize) {
+        let mut buf = self.scratch.borrow_mut();
+        buf.clear();
+        let mut tmp = [0u8; 20];
+        let mut x = n;
+        let mut len = 0usize;
+        if x == 0 {
+            tmp[0] = b'0';
+            len = 1;
+        } else {
+            while x > 0 {
+                tmp[len] = b'0' + (x % 10) as u8;
+                x /= 10;
+                len += 1;
+            }
+        }
+        if width > len {
+            for _ in 0..(width - len) {
+                buf.push(b'0');
+            }
+        }
+        while len > 0 {
+            len -= 1;
+            buf.push(tmp[len]);
+        }
+    }
