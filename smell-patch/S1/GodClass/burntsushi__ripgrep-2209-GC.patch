+    pub(crate) fn saturate_range(&self, start: usize, end: usize, len: usize) -> Match {
+        let s = if start > len { len } else { start };
+        let e = if end > len { len } else { end };
+        if s <= e {
+            Match::new(s, e)
+        } else {
+            Match::new(e, s)
+        }
+    }
