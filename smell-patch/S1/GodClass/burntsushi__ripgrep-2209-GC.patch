+    pub(crate) fn decimal_digit_count(&self, mut n: u64) -> usize {
+        if n == 0 {
+            return 1;
+        }
+        let mut digits = 0usize;
+        while n > 0 {
+            digits += 1;
+            n /= 10;
+        }
+        digits
+    }
