+    pub(crate) fn format_hex_into_scratch(&self, n: u64, prefixed: bool) {
+        let mut buf = self.scratch.borrow_mut();
+        buf.clear();
+        if prefixed {
+            buf.extend_from_slice(b"0x");
+        }
+        let mut tmp = [0u8; 16];
+        let mut x = n;
+        let mut len = 0usize;
+        if x == 0 {
+            buf.push(b'0');
+            return;
+        }
+        while x > 0 {
+            let d = (x & 0xF) as u8;
+            tmp[len] = if d < 10 { b'0' + d } else { b'a' + (d - 10) };
+            x >>= 4;
+            len += 1;
+        }
+        while len > 0 {
+            len -= 1;
+            buf.push(tmp[len]);
+        }
+    }
