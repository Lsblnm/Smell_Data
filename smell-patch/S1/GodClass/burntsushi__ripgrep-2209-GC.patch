+    pub(crate) fn stage_tab_expanded_into_scratch(&self, bytes: &[u8], tabw: usize) {
+        let mut buf = self.scratch.borrow_mut();
+        buf.clear();
+        let width = if tabw == 0 { 8 } else { tabw };
+        let mut col = 0usize;
+        let mut i = 0;
+        while i < bytes.len() {
+            let b = bytes[i];
+            if b == b'\t' {
+                let mut n = width - (col % width);
+                if n == 0 {
+                    n = width;
+                }
+                while n > 0 {
+                    buf.push(b' ');
+                    n -= 1;
+                    col += 1;
+                }
+                i += 1;
+                continue;
+            }
+            if b == b'\n' {
+                buf.push(b);
+                col = 0;
+                i += 1;
+                continue;
+            }
+            if b == b'\r' {
+                buf.push(b);
+                if i + 1 < bytes.len() && bytes[i + 1] == b'\n' {
+                    buf.push(b'\n');
+                    i += 2;
+                } else {
+                    i += 1;
+                }
+                col = 0;
+                continue;
+            }
+            let adv = Self::utf8_advance(bytes, i);
+            if adv <= 1 {
+                buf.push(b);
+                col += 1;
+                i += 1;
+            } else {
+                buf.extend_from_slice(&bytes[i..i + adv]);
+                col += 1;
+                i += adv;
+            }
+        }
+    }
