+    pub(crate) fn count_matches_overlapping(&self, matches: &[Match], line: Match) -> usize {
+        let mut n = 0usize;
+        for m in matches {
+            if m.end() <= line.start() {
+                continue;
+            }
+            if m.start() >= line.end() {
+                continue;
+            }
+            n += 1;
+        }
+        n
+    }
