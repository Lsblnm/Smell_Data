+    pub(crate) fn assemble_colored_span_plan_into_scratch(
+        &self,
+        bytes: &[u8],
+        line: Match,
+        matches: &[Match],
+    ) {
+        let mut buf = self.scratch.borrow_mut();
+        buf.clear();
+        let mut pos = line.start();
+        let end = line.end();
+        let mut idx = 0usize;
+        while pos < end && pos <= bytes.len() {
+            while idx < matches.len() && matches[idx].end() <= pos {
+                idx += 1;
+            }
+            if idx >= matches.len() {
+                let slice_end = if end > bytes.len() { bytes.len() } else { end };
+                if pos < slice_end {
+                    buf.extend_from_slice(&bytes[pos..slice_end]);
+                }
+                break;
+            }
+            let m = matches[idx];
+            if pos < m.start() {
+                let upto = if m.start() < end { m.start() } else { end };
+                let upto = if upto > bytes.len() { bytes.len() } else { upto };
+                if pos < upto {
+                    buf.extend_from_slice(&bytes[pos..upto]);
+                }
+                pos = upto;
+                continue;
+            }
+            let upto = if m.end() < end { m.end() } else { end };
+            let upto = if upto > bytes.len() { bytes.len() } else { upto };
+            if pos < upto {
+                buf.extend_from_slice(&bytes[pos..upto]);
+            }
+            pos = upto;
+        }
+    }
