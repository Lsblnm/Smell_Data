+    fn utf8_advance(bytes: &[u8], i: usize) -> usize {
+        if i >= bytes.len() {
+            return 0;
+        }
+        let b = bytes[i];
+        let lead = Self::UTF8_LEAD_LEN[b as usize] as usize;
+        if lead <= 1 {
+            return lead;
+        }
+        if i + lead > bytes.len() {
+            return 0;
+        }
+        if lead == 2 {
+            if !Self::is_utf8_cont(bytes[i + 1]) {
+                return 0;
+            }
+            return 2;
+        }
+        if lead == 3 {
+            if !Self::is_utf8_cont(bytes[i + 1]) || !Self::is_utf8_cont(bytes[i + 2]) {
+                return 0;
+            }
+            if b == 0xE0 && bytes[i + 1] < 0xA0 {
+                return 0;
+            }
+            if b == 0xED && bytes[i + 1] >= 0xA0 {
+                return 0;
+            }
+            return 3;
+        }
+        if !Self::is_utf8_cont(bytes[i + 1])
+            || !Self::is_utf8_cont(bytes[i + 2])
+            || !Self::is_utf8_cont(bytes[i + 3])
+        {
+            return 0;
+        }
+        if b == 0xF0 && bytes[i + 1] < 0x90 {
+            return 0;
+        }
+        if b == 0xF4 && bytes[i + 1] >= 0x90 {
+            return 0;
+        }
+        4
+    }
