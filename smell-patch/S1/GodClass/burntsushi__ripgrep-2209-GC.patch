+    pub(crate) fn clamp_match(&self, m: Match, len: usize) -> Match {
+        let start = if m.start() > len { len } else { m.start() };
+        let end = if m.end() > len { len } else { m.end() };
+        if start <= end {
+            Match::new(start, end)
+        } else {
+            Match::new(end, start)
+        }
