+    pub(crate) fn omitted_message_kind(
+        &self,
+        max_columns_preview: bool,
+        original_matches_empty: bool,
+        is_context: bool,
+        only_matching: bool,
+        remaining: usize,
+    ) -> u8 {
+        if max_columns_preview {
+            if original_matches_empty || remaining == 0 {
+                0
+            } else {
+                1
+            }
+        } else if original_matches_empty {
+            if is_context { 2 } else { 3 }
+        } else if only_matching {
+            if is_context { 2 } else { 3 }
+        } else {
+            4
+        }
+    }
