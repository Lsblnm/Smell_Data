+    pub(crate) fn trim_space_prefix_offset(&self, bytes: &[u8], start: usize, end: usize) -> usize {
+        let mut i = start;
+        let stop = if end > bytes.len() { bytes.len() } else { end };
+        while i < stop {
+            match Self::SPACE_BYTE_KIND[bytes[i] as usize] {
+                1 | 2 | 5 => i += 1,
+                3 | 4 => break,
+                _ => break,
+            }
+        }
+        i
+    }
+    pub(crate) fn stage_trimmed_line_into_scratch(
+        &self,
+        bytes: &[u8],
+        mut range: Match,
+        line_term: LineTerminator,
+        trim_ascii: bool,
+    ) {
+        let mut buf = self.scratch.borrow_mut();
+        buf.clear();
+        if trim_ascii {
+            range = trim_ascii_prefix(line_term, bytes, range);
+        }
+        if range.end() > bytes.len() {
+            range = range.with_end(bytes.len());
+        }
+        if range.start() >= range.end() {
+            return;
+        }
+        let slice = &bytes[range];
+        let mut i = 0;
+        while i < slice.len() {
+            let kind = Self::SPACE_BYTE_KIND[slice[i] as usize];
+            if i == 0 && trim_ascii && (kind == 1 || kind == 2 || kind == 5) {
+                i += 1;
+                continue;
+            }
+            buf.push(slice[i]);
+            i += 1;
+        }
+    }
