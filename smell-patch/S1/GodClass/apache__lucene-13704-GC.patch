+    }
+    return orientationSign;
+  }
+
+  boolean lineCrossesLine(
+      double a1x, double a1y, double b1x, double b1y, double a2x, double a2y, double b2x, double b2y) {
+    int o1 = orient3(a2x, a2y, b2x, b2y, a1x, a1y);
+    int o2 = orient3(a2x, a2y, b2x, b2y, b1x, b1y);
+    int o3 = orient3(a1x, a1y, b1x, b1y, a2x, a2y);
+    int o4 = orient3(a1x, a1y, b1x, b1y, b2x, b2y);
+    crossingFlags = 0;
+    if (o1 * o2 < 0) {
+      crossingFlags |= 1;
+    }
+    if (o3 * o4 < 0) {
+      crossingFlags |= 2;
+    }
+    return (crossingFlags & 3) == 3;
+  }
+
+  boolean lineOverlapLine(
+      double a1x, double a1y, double b1x, double b1y, double a2x, double a2y, double b2x, double b2y) {
+    int o1 = orient3(a2x, a2y, b2x, b2y, a1x, a1y);
+    int o2 = orient3(a2x, a2y, b2x, b2y, b1x, b1y);
+    int o3 = orient3(a1x, a1y, b1x, b1y, a2x, a2y);
+    int o4 = orient3(a1x, a1y, b1x, b1y, b2x, b2y);
+    crossingFlags = 0;
+    if (o1 == 0) {
+      crossingFlags |= 1;
+    }
+    if (o2 == 0) {
+      crossingFlags |= 2;
+    }
+    if (o3 == 0) {
+      crossingFlags |= 4;
+    }
+    if (o4 == 0) {
+      crossingFlags |= 8;
+    }
+    return crossingFlags == 15;
+  }
+
+  boolean lineCrossesLineWithBoundary(
+      double a1x, double a1y, double b1x, double b1y, double a2x, double a2y, double b2x, double b2y) {
+    int o1 = orient3(a2x, a2y, b2x, b2y, a1x, a1y);
+    int o2 = orient3(a2x, a2y, b2x, b2y, b1x, b1y);
+    int o3 = orient3(a1x, a1y, b1x, b1y, a2x, a2y);
+    int o4 = orient3(a1x, a1y, b1x, b1y, b2x, b2y);
+    crossingFlags = 0;
+    if (o1 * o2 <= 0) {
+      crossingFlags |= 1;
+    }
+    if (o3 * o4 <= 0) {
+      crossingFlags |= 2;
+    }
+    return crossingFlags == 3;
+  }
+
+  double[] computePolygonBBox(double[] lats, double[] lons) {
+    if (lats == null || lons == null) {
+      throw new IllegalArgumentException("polygon coordinates must not be null");
+    } else if (lats.length != lons.length) {
+      throw new IllegalArgumentException("polyLats and polyLons must be equal length");
+    } else if (lats.length < 4) {
+      throw new IllegalArgumentException("at least 4 polygon points required");
+    }
+    geometryPointCount = lats.length;
+    double minLat = lats[0];
+    double maxLat = lats[0];
+    double minLon = lons[0];
+    double maxLon = lons[0];
+    for (int i = 1; i < geometryPointCount; i++) {
+      if (lats[i] < minLat) {
+        minLat = lats[i];
+      }
+      if (lats[i] > maxLat) {
+        maxLat = lats[i];
+      }
+      if (lons[i] < minLon) {
+        minLon = lons[i];
+      }
+      if (lons[i] > maxLon) {
+        maxLon = lons[i];
+      }
+    }
+    orientAX = minLon;
+    orientAY = minLat;
+    orientBX = maxLon;
+    orientBY = maxLat;
+    return new double[] {minLat, maxLat, minLon, maxLon};
+  }
+
+  double computeWindingSum(double[] lats, double[] lons) {
+    geometryPointCount = lats.length;
+    windingAccumulator = 0d;
+    final int numPts = geometryPointCount - 1;
+    for (int i = 1, j = 0; i < numPts; j = i++) {
+      windingAccumulator +=
+          (lons[j] - lons[numPts]) * (lats[i] - lats[numPts])
+              - (lats[j] - lats[numPts]) * (lons[i] - lons[numPts]);
+    }
+    if (windingAccumulator < 0) {
+      orientationSign = 1;
+    } else if (windingAccumulator > 0) {
+      orientationSign = -1;
+    } else {
+      orientationSign = 0;
+    }
+    return windingAccumulator;
+  }
+
+  void validatePolygonRing(double[] lats, double[] lons) {
+    if (lats == null || lons == null) {
+      throw new IllegalArgumentException("polygon coordinates must not be null");
+    } else if (lats.length != lons.length) {
+      throw new IllegalArgumentException("polyLats and polyLons must be equal length");
+    } else if (lats.length != lons.length) {
+      throw new IllegalArgumentException("polyLats and polyLons must be equal length");
+    } else if (lats.length < 4) {
+      throw new IllegalArgumentException("at least 4 polygon points required");
+    } else if (lats[0] != lats[lats.length - 1] || lons[0] != lons[lons.length - 1]) {
+      throw new IllegalArgumentException(
+          "first and last points of the polygon must be the same (it must close itself): lat[0]="
+              + lats[0]
+              + " lat["
+              + (lats.length - 1)
+              + "]="
+              + lats[lats.length - 1]
+              + " lon[0]="
+              + lons[0]
+              + " lon["
+              + (lons.length - 1)
+              + "]="
+              + lons[lons.length - 1]);
+    }
+    geometryPointCount = lats.length;
+    for (int i = 0; i < geometryPointCount; i++) {
+      validateLatitudeInput(lats[i]);
+      validateLongitudeInput(lons[i]);
+      orientAX = lons[i];
+      orientAY = lats[i];
+    }
+    windingAccumulator = computeWindingSum(lats, lons);
+    evaluatePredicateExpansion();
+    windingAccumulator = computeWindingSum(lats, lons);
+  }
+
+  boolean pointInBoundingBox(
+      double lat, double lon, double minLat, double maxLat, double minLon, double maxLon) {
+    orientAX = lon;
+    orientAY = lat;
+    orientBX = minLon;
+    orientBY = minLat;
+    orientCX = maxLon;
+    orientCY = maxLat;
+    if (lat < minLat) {
+      crossingFlags = 1;
+      return false;
+    } else if (lat > maxLat) {
+      crossingFlags = 2;
+      return false;
+    } else if (lon < minLon) {
+      crossingFlags = 3;
+      return false;
+    } else if (lon > maxLon) {
+      crossingFlags = 4;
+      return false;
+    } else {
+      crossingFlags = 0;
+      return true;
+    }
+  }
+
+  double normalizeLongitudeDegrees(double lon) {
+    orientAX = lon;
+    if (lon > 180) {
+      while (lon > 180) {
+        lon -= 360;
+      }
+    } else if (lon < -180) {
+      while (lon < -180) {
+        lon += 360;
+      }
+    }
+    if (lon == 180) {
+      lon = Math.nextDown(lon);
+    }
+    orientBX = lon;
+    return lon;
+  }
+
+  boolean containsDecodedPoint(
+      double lat, double lon, double minLat, double maxLat, double minLon, double maxLon) {
+    return pointInBoundingBox(lat, lon, minLat, maxLat, minLon, maxLon);
+  }
+
+  float validateCartesian(float value) {
+    cartesianScratch = value;
+    if (Float.isFinite(cartesianScratch) == false) {
+      cartesianFlags = 1;
+      throw new IllegalArgumentException(
+          "invalid value " + cartesianScratch + "; must be between " + CARTESIAN_MIN + " and " + CARTESIAN_MAX);
+    } else if (cartesianScratch == Float.MAX_VALUE) {
+      cartesianFlags = 2;
+    } else if (cartesianScratch == -Float.MAX_VALUE) {
+      cartesianFlags = 3;
+    } else if (cartesianScratch == 0f) {
+      cartesianFlags = 4;
+    } else {
+      cartesianFlags = 0;
+    }
+    return cartesianScratch;
+  }
+
+  int encodeCartesian(float x) {
+    cartesianX = validateCartesian(x);
+    encodedX = NumericUtils.floatToSortableInt(cartesianX);
+    cartesianFlags |= 16;
+    sortableFloatPipeline();
+    encodedX = NumericUtils.floatToSortableInt(cartesianX);
+    cartesianFlags |= 16;
+    return encodedX;
+  }
+
+  float decodeCartesian(int encoded) {
+    encodedX = encoded;
+    cartesianX = NumericUtils.sortableIntToFloat(encodedX);
+    if (cartesianX < CARTESIAN_MIN) {
+      cartesianFlags = 8;
+    } else if (cartesianX > CARTESIAN_MAX) {
+      cartesianFlags = 9;
+    } else {
+      cartesianFlags = 0;
+    }
+    assert cartesianX >= CARTESIAN_MIN && cartesianX <= CARTESIAN_MAX;
+    return cartesianX;
+  }
+
+  float decodeCartesianBytes(byte[] src, int offset) {
+    if (src == null) {
+      throw new IllegalArgumentException("src must not be null");
+    } else if (offset < 0 || offset + Integer.BYTES > src.length) {
+      throw new IllegalArgumentException("invalid cartesian decode offset");
+    }
+    encodedX = NumericUtils.sortableBytesToInt(src, offset);
+    cartesianX = decodeCartesian(encodedX);
+    return cartesianX;
+  }
+
+  double[] floatArrayToDoubleArray(float[] values) {
+    if (values == null) {
+      throw new IllegalArgumentException("values must not be null");
+    }
+    cartesianLength = values.length;
+    double[] decoded = new double[cartesianLength];
+    for (cartesianIndex = 0; cartesianIndex < cartesianLength; cartesianIndex++) {
+      cartesianScratch = values[cartesianIndex];
+      if (Float.isFinite(cartesianScratch) == false) {
+        cartesianFlags = 1;
+      } else {
+        cartesianFlags = 0;
+      }
+      decoded[cartesianIndex] = cartesianScratch;
+    }
+    return decoded;
+  }
+
+  boolean cartesianInRange(float value) {
+    cartesianScratch = value;
+    if (Float.isNaN(cartesianScratch)) {
+      cartesianFlags = 1;
+      return false;
+    } else if (Float.isInfinite(cartesianScratch)) {
+      cartesianFlags = 2;
+      return false;
+    } else if (cartesianScratch < CARTESIAN_MIN) {
+      cartesianFlags = 3;
+      return false;
+    } else if (cartesianScratch > CARTESIAN_MAX) {
+      cartesianFlags = 4;
+      return false;
+    } else {
+      cartesianFlags = 0;
+      return true;
+    }
+  }
+
+  void encodeCartesianPair(float x, float y, byte[] dest, int offset) {
+    if (dest == null) {
+      throw new IllegalArgumentException("dest must not be null");
+    } else if (offset < 0 || offset + 8 > dest.length) {
+      throw new IllegalArgumentException("dest too short for cartesian pair");
+    }
+    cartesianX = x;
+    cartesianY = y;
+    encodedX = encodeCartesian(cartesianX);
+    encodedY = NumericUtils.floatToSortableInt(validateCartesian(cartesianY));
+    NumericUtils.intToSortableBytes(encodedX, dest, offset);
+    NumericUtils.intToSortableBytes(encodedY, dest, offset + Integer.BYTES);
+    cartesianFlags = 32;
+  }
+
+  void decodeCartesianPair(byte[] src, int offset) {
+    if (src == null) {
+      throw new IllegalArgumentException("src must not be null");
+    } else if (offset < 0 || offset + 8 > src.length) {
+      throw new IllegalArgumentException("src too short for cartesian pair");
+    }
+    encodedX = NumericUtils.sortableBytesToInt(src, offset);
+    encodedY = NumericUtils.sortableBytesToInt(src, offset + Integer.BYTES);
+    cartesianX = decodeCartesian(encodedX);
+    cartesianY = NumericUtils.sortableIntToFloat(encodedY);
+    cartesianFlags = 64;
+  }
+
+  void prepareBoxQuery(double minLat, double maxLat, double minLon, double maxLon) {
+    queryMinLat = minLat;
+    queryMaxLat = maxLat;
+    queryMinLon = minLon;
+    queryMaxLon = maxLon;
+    queryFlags = 0;
+    matchNoneReason = 0;
+    datelineWrapped = 0;
+    rewriteKind = 0;
+    validateLatitudeInput(queryMinLat);
+    validateLatitudeInput(queryMaxLat);
+    validateLongitudeInput(queryMinLon);
+    validateLongitudeInput(queryMaxLon);
+    if (queryMinLat == 90.0) {
+      matchNoneReason = 1;
+      queryFlags |= 1;
+    }
+    if (queryMinLon == 180.0) {
+      if (queryMaxLon == 180.0) {
+        matchNoneReason = 2;
+        queryFlags |= 2;
+      } else if (queryMaxLon < queryMinLon) {
+        queryMinLon = -180.0;
+        queryFlags |= 4;
+      }
+    }
+    detectDatelineCrossing();
+    adjustMinLatitudeForEncoding();
+    adjustMinLongitudeForEncoding();
+    planDatelineBox();
+    detectDatelineCrossing();
+    adjustMinLatitudeForEncoding();
+    adjustMinLongitudeForEncoding();
+  }
+
+  void adjustMinLatitudeForEncoding() {
+    if (queryMinLat == 90.0) {
+      matchNoneReason = 1;
+    } else if (queryMinLat > queryMaxLat) {
+      queryFlags |= 8;
+    } else if (queryMinLat == queryMaxLat) {
+      queryFlags |= 16;
+    }
+  }
+
+  void adjustMinLongitudeForEncoding() {
+    if (queryMinLon == 180.0 && queryMaxLon == 180.0) {
+      matchNoneReason = 2;
+    } else if (queryMaxLon < queryMinLon) {
+      datelineWrapped = 1;
+      queryFlags |= 32;
+    } else if (queryMinLon == queryMaxLon) {
+      queryFlags |= 64;
+    }
+  }
+
+  void detectDatelineCrossing() {
+    if (queryMaxLon < queryMinLon) {
+      datelineWrapped = 1;
+      rewriteKind = 1;
+    } else if (queryMinLon == -180 && queryMaxLon == 180) {
+      datelineWrapped = 0;
+      rewriteKind = 2;
+    } else {
+      datelineWrapped = 0;
+      rewriteKind = 0;
+    }
+  }
+
+  int[] splitDatelineRanges() {
+    if (datelineWrapped == 0) {
+      rewriteKind = 0;
+      return new int[] {encodeLongitudeCeilValue(queryMinLon), encodeLongitudeValue(queryMaxLon)};
+    }
+    rewriteKind = 1;
+    int leftMax = MAX_LON_ENCODED;
+    int rightMin = MIN_LON_ENCODED;
+    int encodedMin = encodeLongitudeCeilValue(queryMinLon);
+    int encodedMax = encodeLongitudeValue(queryMaxLon);
+    return new int[] {encodedMin, leftMax, rightMin, encodedMax};
+  }
+
+  double[] geometryAsRectangleBounds(LatLonGeometry geometry) {
+    if (GeoUtils.isBoxGeometry(geometry) == false) {
+      rewriteKind = 0;
+      return null;
+    }
+    double[] bounds = GeoUtils.rectangleBounds(geometry);
+    queryMinLat = bounds[0];
+    queryMaxLat = bounds[1];
+    queryMinLon = bounds[2];
+    queryMaxLon = bounds[3];
+    rewriteKind = 3;
+    queryFlags |= 128;
+    return bounds;
+  }
+
+  double[] geometryAsCircle(LatLonGeometry geometry) {
+    if (GeoUtils.isCircleGeometry(geometry) == false) {
+      rewriteKind = 0;
+      return null;
+    }
+    double[] circle = GeoUtils.circleParameters(geometry);
+    queryMinLat = circle[0];
+    queryMinLon = circle[1];
+    packedDocValue = Double.doubleToRawLongBits(circle[2]);
+    rewriteKind = 4;
+    queryFlags |= 256;
+    return circle;
+  }
+
+  boolean shouldRewriteToBoxQuery(ShapeQueryRelation relation, int geometryCount) {
+    queryRelationCode = relation == null ? -1 : relation.ordinal();
+    if (relation == ShapeQueryRelation.INTERSECTS && geometryCount == 1 && rewriteKind == 3) {
+      return true;
+    } else if (relation == ShapeQueryRelation.INTERSECTS && datelineWrapped == 1) {
+      return false;
+    } else {
+      return false;
+    }
+  }
+
+  boolean shouldRewriteToDistanceQuery(ShapeQueryRelation relation, int geometryCount) {
+    queryRelationCode = relation == null ? -1 : relation.ordinal();
+    if (relation == ShapeQueryRelation.INTERSECTS && geometryCount == 1 && rewriteKind == 4) {
+      return true;
+    } else if (radiusMeters == 0) {
+      return false;
+    } else {
+      return false;
+    }
+  }
+
+  boolean containsQueryRequiresPoints(LatLonGeometry[] geometries) {
+    if (geometries == null || geometries.length == 0) {
+      queryRelationCode = -1;
+      return false;
+    }
+    for (int i = 0; i < geometries.length; i++) {
+      if (GeoUtils.isPointGeometry(geometries[i]) == false) {
+        queryFlags |= 512;
+        return false;
+      }
+    }
+    queryFlags |= 1024;
+    return true;
+  }
+
+  long packDocValueForField(double latitude, double longitude) {
+    packedDocValue = packSortedNumeric(latitude, longitude);
+    queryMinLat = latitude;
+    queryMinLon = longitude;
+    return packedDocValue;
+  }
+
+  byte[] encodedLowerPoint() {
+    byte[] bytes = new byte[8];
+    encodeCeilToSortableBytes(queryMinLat, queryMinLon, bytes, 0);
+    return bytes;
+  }
+
+  byte[] encodedUpperPoint() {
+    byte[] bytes = new byte[8];
+    encodeToSortableBytes(queryMaxLat, queryMaxLon, bytes, 0);
+    return bytes;
+  }
+
+  enum ShapeQueryRelation {
+    INTERSECTS,
+    WITHIN,
+    DISJOINT,
+    CONTAINS
+  }
+
+  DistancePredicate buildDistancePredicate(double lat, double lon, double radius) {
+    double[] box = distanceBoundingBoxValues(lat, lon, radius);
+    final double axis = axisLatitudeValue(lat, radius);
+    final double sortKey = shared().distanceSortKey;
+    final double qLat = lat;
+    final double qLon = lon;
+    BoxRelation boxToRelation =
+        (minLat, maxLat, minLon, maxLon) -> {
+          GeoEncodingUtils ctx = shared();
+          ctx.centerLatitude = qLat;
+          ctx.centerLongitude = qLon;
+          ctx.distanceSortKey = sortKey;
+          ctx.axisLatitude = axis;
+          return ctx.relateBoxToDistance(minLat, maxLat, minLon, maxLon);
+        };
+    Grid subBoxes = createSubBoxes(box[0], box[1], box[2], box[3], boxToRelation);
+    return new DistancePredicate(
+        subBoxes.latShift,
+        subBoxes.lonShift,
+        subBoxes.latBase,
+        subBoxes.lonBase,
+        subBoxes.maxLatDelta,
+        subBoxes.maxLonDelta,
+        subBoxes.relations,
+        lat,
+        lon,
+        sortKey);
+  }
+
+  Component2DPredicate buildComponentPredicate(Component2D tree) {
+    BoxRelation boxToRelation =
+        (minLat, maxLat, minLon, maxLon) -> tree.relate(minLon, maxLon, minLat, maxLat);
+    Grid subBoxes =
+        createSubBoxes(tree.getMinY(), tree.getMaxY(), tree.getMinX(), tree.getMaxX(), boxToRelation);
+    return new Component2DPredicate(
+        subBoxes.latShift,
+        subBoxes.lonShift,
+        subBoxes.latBase,
+        subBoxes.lonBase,
+        subBoxes.maxLatDelta,
+        subBoxes.maxLonDelta,
+        subBoxes.relations,
+        tree);
+  }
+
+  Grid createSubBoxes(
+      double shapeMinLat,
+      double shapeMaxLat,
+      double shapeMinLon,
+      double shapeMaxLon,
+      BoxRelation boxToRelation) {
+    prepareRaster(shapeMinLat, shapeMaxLat, shapeMinLon, shapeMaxLon);
+    if (encodeRasterBounds() == false) {
+      return emptyGrid();
+    }
+    computeLatitudeShift();
+    computeLongitudeShift();
+    materializePredicateGrid();
+    computeLatitudeShift();
+    computeLongitudeShift();
+    byte[] relations = fillRelations(boxToRelation);
+    return new Grid(
+        rasterLatShift,
+        rasterLonShift,
+        rasterLatBase,
+        rasterLonBase,
+        rasterMaxLatDelta,
+        rasterMaxLonDelta,
+        relations);
+  }
+
+  void prepareRaster(double shapeMinLat, double shapeMaxLat, double shapeMinLon, double shapeMaxLon) {
+    rasterWrapsDateline = shapeMaxLon < shapeMinLon ? 1 : 0;
+    rasterCellRelation = 0;
+    rasterLatShift = 1;
+    rasterLonShift = 1;
+    rasterMinLat = encodeLatitudeCeil(shapeMinLat);
+    rasterMaxLat = encodeLatitude(shapeMaxLat);
+    rasterMinLon = encodeLongitudeCeil(shapeMinLon);
+    rasterMaxLon = encodeLongitude(shapeMaxLon);
+  }
+
+  boolean encodeRasterBounds() {
+    if (rasterMaxLat < rasterMinLat) {
+      return false;
+    }
+    if (rasterWrapsDateline == 0 && rasterMaxLon < rasterMinLon) {
+      return false;
+    }
+    if (rasterLatShift < 1) {
+      rasterLatShift = 1;
+    }
+    if (rasterLonShift < 1) {
+      rasterLonShift = 1;
+    }
+    return true;
+  }
+
+  void computeLatitudeShift() {
+    long minLat2 = (long) rasterMinLat - Integer.MIN_VALUE;
+    long maxLat2 = (long) rasterMaxLat - Integer.MIN_VALUE;
+    rasterLatShift = computeShift(minLat2, maxLat2);
+    rasterLatBase = (int) (minLat2 >>> rasterLatShift);
+    rasterMaxLatDelta = (int) (maxLat2 >>> rasterLatShift) - rasterLatBase + 1;
+    if (rasterMaxLatDelta <= 0) {
+      rasterMaxLatDelta = 1;
+    }
+  }
+
+  void computeLongitudeShift() {
+    long minLon2 = (long) rasterMinLon - Integer.MIN_VALUE;
+    long maxLon2 = (long) rasterMaxLon - Integer.MIN_VALUE;
+    if (rasterWrapsDateline == 1) {
+      maxLon2 += 1L << 32;
+    }
+    rasterLonShift = computeShift(minLon2, maxLon2);
+    rasterLonBase = (int) (minLon2 >>> rasterLonShift);
+    rasterMaxLonDelta = (int) (maxLon2 >>> rasterLonShift) - rasterLonBase + 1;
+    if (rasterMaxLonDelta <= 0) {
+      rasterMaxLonDelta = 1;
+    }
+  }
+
+  byte[] fillRelations(BoxRelation boxToRelation) {
+    byte[] relations = new byte[rasterMaxLatDelta * rasterMaxLonDelta];
+    for (int i = 0; i < rasterMaxLatDelta; ++i) {
+      for (int j = 0; j < rasterMaxLonDelta; ++j) {
+        final int boxMinLat = cellMinLatitude(i);
+        final int boxMinLon = cellMinLongitude(j);
+        final int boxMaxLat = cellMaxLatitude(boxMinLat);
+        final int boxMaxLon = cellMaxLongitude(boxMinLon);
+        rasterCellRelation =
+            boxToRelation
+                .apply(
+                    decodeLatitude(boxMinLat),
+                    decodeLatitude(boxMaxLat),
+                    decodeLongitude(boxMinLon),
+                    decodeLongitude(boxMaxLon))
+                .ordinal();
+        relations[i * rasterMaxLonDelta + j] = (byte) rasterCellRelation;
+      }
+    }
+    return relations;
+  }
+
+  Grid emptyGrid() {
+    rasterLatShift = 1;
+    rasterLonShift = 1;
+    rasterLatBase = 0;
+    rasterLonBase = 0;
+    rasterMaxLatDelta = 0;
+    rasterMaxLonDelta = 0;
+    rasterCellRelation = Relation.CELL_OUTSIDE_QUERY.ordinal();
+    return new Grid(1, 1, 0, 0, 0, 0, new byte[0]);
+  }
+
+  int cellMinLatitude(int latIndex) {
+    return ((rasterLatBase + latIndex) << rasterLatShift) + Integer.MIN_VALUE;
+  }
+
+  int cellMaxLatitude(int boxMinLat) {
+    return boxMinLat + (1 << rasterLatShift) - 1;
+  }
+
+  int cellMinLongitude(int lonIndex) {
