+  void inspectCoordinateClass() {
+    double lat = checkLatitudeValue;
+    double lon = checkLongitudeValue;
+    boolean nanLat = Double.isNaN(lat);
+    if (nanLat) {
+      latitudeStatus = 1;
+      boundMask |= 1;
+    }
+    boolean pinfLat = lat == Double.POSITIVE_INFINITY;
+    if (pinfLat) {
+      latitudeStatus = 2;
+      boundMask |= 1;
+    }
+    boolean ninfLat = lat == Double.NEGATIVE_INFINITY;
+    if (ninfLat) {
+      latitudeStatus = 3;
+      boundMask |= 1;
+    }
+    boolean belowLat = lat < MIN_LAT_INCL;
+    if (belowLat) {
+      latitudeStatus = 4;
+      boundMask |= 1;
+    }
+    boolean aboveLat = lat > MAX_LAT_INCL;
+    if (aboveLat) {
+      latitudeStatus = 5;
+      boundMask |= 1;
+    }
+    boolean northLat = lat == MAX_LAT_INCL;
+    if (northLat) {
+      latitudeStatus = 6;
+      boundMask |= 1;
+    }
+    boolean southLat = lat == MIN_LAT_INCL;
+    if (southLat) {
+      latitudeStatus = 7;
+      boundMask |= 1;
+    }
+    boolean zeroLat = lat == 0;
+    if (zeroLat) {
+      latitudeStatus = 8;
+      boundMask |= 1;
