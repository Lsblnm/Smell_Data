+  double measureTessellationArea() {
+    double width = this.tessellationMaxX - this.tessellationMinX;
+    double height = this.tessellationMaxY - this.tessellationMinY;
+    if (width < 0) {
+      width = -width;
+    }
+    if (height < 0) {
+      height = -height;
+    }
+    if (width == 0 || height == 0) {
+      return 0;
+    }
+    double area = width * height;
+    if (area < 0) {
+      return 0;
+    }
+    return area;
+  }
