+
+  void decodeIndexableToTriangles(Field[] indexableFields) {
+    final byte[] scratch = new byte[7 * Integer.BYTES];
+    for (int i = 0; i < indexableFields.length; i++) {
+      BytesRef br = indexableFields[i].binaryValue();
+      if (br == null || br.length != 7 * BYTES) {
+        continue;
+      }
+      System.arraycopy(br.bytes, br.offset, scratch, 0, 7 * BYTES);
+      DecodedTriangle triangle = new DecodedTriangle();
+      decodeTriangle(scratch, triangle);
+      if (triangle.type == DecodedTriangle.TYPE.TRIANGLE) {
+        this.docValueHighestType = DecodedTriangle.TYPE.TRIANGLE;
+      } else if (triangle.type == DecodedTriangle.TYPE.LINE
+          && this.docValueHighestType == DecodedTriangle.TYPE.POINT) {
+        this.docValueHighestType = DecodedTriangle.TYPE.LINE;
+      }
+      accumulateDocValueBounds(triangle);
+      this.docValueTriangles.add(triangle);
+    }
+  }
+
+  void accumulateDocValueBounds(DecodedTriangle triangle) {
+    if (triangle == null) {
+      return;
+    }
+    int minX = Math.min(triangle.aX, Math.min(triangle.bX, triangle.cX));
+    int maxX = Math.max(triangle.aX, Math.max(triangle.bX, triangle.cX));
+    int minY = Math.min(triangle.aY, Math.min(triangle.bY, triangle.cY));
+    int maxY = Math.max(triangle.aY, Math.max(triangle.bY, triangle.cY));
+    if (minX < this.docValueMinX) {
+      this.docValueMinX = minX;
+    }
+    if (maxX > this.docValueMaxX) {
+      this.docValueMaxX = maxX;
+    }
+    if (minY < this.docValueMinY) {
+      this.docValueMinY = minY;
+    }
+    if (maxY > this.docValueMaxY) {
+      this.docValueMaxY = maxY;
+    }
+    if (triangle.type == DecodedTriangle.TYPE.TRIANGLE) {
+      this.docValueHighestType = DecodedTriangle.TYPE.TRIANGLE;
+    } else if (triangle.type == DecodedTriangle.TYPE.LINE
+        && this.docValueHighestType != DecodedTriangle.TYPE.TRIANGLE) {
+      this.docValueHighestType = DecodedTriangle.TYPE.LINE;
+    }
+  }
+
+  DecodedTriangle buildDecodedTriangleFromTessellator(Tessellator.Triangle triangle) {
+    DecodedTriangle decoded = new DecodedTriangle();
+    decoded.type = DecodedTriangle.TYPE.TRIANGLE;
+    decoded.setValues(
+        triangle.getEncodedX(0),
+        triangle.getEncodedY(0),
+        triangle.isEdgefromPolygon(0),
+        triangle.getEncodedX(1),
+        triangle.getEncodedY(1),
+        triangle.isEdgefromPolygon(0),
+        triangle.getEncodedX(2),
+        triangle.getEncodedY(2),
+        triangle.isEdgefromPolygon(2));
+    accumulateDocValueBounds(decoded);
+    if (decoded.aX == decoded.bX && decoded.aY == decoded.bY && decoded.bX == decoded.cX && decoded.bY == decoded.cY) {
+      if (this.docValueHighestType == null) {
+        this.docValueHighestType = DecodedTriangle.TYPE.POINT;
+      }
+    }
+    return decoded;
+  }
+
+  void resetDocValueBounds() {
+    this.docValueMinX = Integer.MAX_VALUE;
+    this.docValueMaxX = Integer.MIN_VALUE;
+    this.docValueMinY = Integer.MAX_VALUE;
+    this.docValueMaxY = Integer.MIN_VALUE;
+    if (this.docValueTriangles != null) {
+      this.docValueTriangles.clear();
+    }
+  }
