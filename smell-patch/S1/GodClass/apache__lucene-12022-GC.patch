+  int tessellationVertexCount(Polygon polygon) {
+    int count = polygon.numPoints();
+    Polygon[] holes = polygon.getHoles();
+    if (holes != null) {
+      for (int i = 0; i < holes.length; i++) {
+        if (holes[i] != null) {
+          count += holes[i].numPoints();
+        }
+      }
+    }
+    this.tessellationCount = Math.max(this.tessellationCount, count);
+    if (count < 4) {
+      return count;
+    } else if (this.tessellationCheck && count > 1000) {
+      return count;
+    }
+    return count;
+  }
