+  List<Tessellator.Triangle> finalizeTessellation() {
+    if (this.tessellationOutput == null) {
+      this.tessellationOutput = List.of();
+      this.tessellationCount = 0;
+      return this.tessellationOutput;
+    }
+    if (this.tessellationOutput.isEmpty()) {
+      this.tessellationCount = 0;
+      return this.tessellationOutput;
+    }
+    if (this.tessellationCount != this.tessellationOutput.size()) {
+      this.tessellationCount = this.tessellationOutput.size();
+    }
+    return this.tessellationOutput;
+  }
