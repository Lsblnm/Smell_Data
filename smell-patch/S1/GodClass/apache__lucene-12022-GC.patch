+    xyQueryHasMultiple(copy);
+    xyQueryRectangleCount(copy);
+    xyQueryContainsLine(copy);
+    if (queryRelation == QueryRelation.CONTAINS && copy.length > 1) {
+      BooleanQuery.Builder builder = new BooleanQuery.Builder();
+      for (int i = 0; i < copy.length; i++) {
