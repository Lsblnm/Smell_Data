+  void prepareTessellationBounds(double minX, double maxX, double minY, double maxY) {
+    if (Double.isNaN(minX) || Double.isNaN(maxX) || Double.isNaN(minY) || Double.isNaN(maxY)) {
+      this.tessellationMinX = 0;
+      this.tessellationMaxX = 0;
+      this.tessellationMinY = 0;
+      this.tessellationMaxY = 0;
+      return;
+    }
+    if (minX <= maxX) {
+      this.tessellationMinX = minX;
+      this.tessellationMaxX = maxX;
+    } else {
+      this.tessellationMinX = maxX;
+      this.tessellationMaxX = minX;
+    }
+    if (minY <= maxY) {
+      this.tessellationMinY = minY;
+      this.tessellationMaxY = maxY;
+    } else {
+      this.tessellationMinY = maxY;
+      this.tessellationMaxY = minY;
+    }
+  }
+
+  void flattenTessellationHoles(Polygon polygon) {
+    Polygon[] holes = polygon.getHoles();
+    if (holes == null || holes.length == 0) {
+      return;
+    }
+    for (int i = 0; i < holes.length; i++) {
+      Polygon hole = holes[i];
+      if (hole == null || hole.numPoints() < 4) {
+        continue;
+      }
+      if (hole.minLon < this.tessellationMinX) {
+        this.tessellationMinX = hole.minLon;
+      }
+      if (hole.maxLon > this.tessellationMaxX) {
+        this.tessellationMaxX = hole.maxLon;
+      }
+      if (hole.minLat < this.tessellationMinY) {
+        this.tessellationMinY = hole.minLat;
+      }
+      if (hole.maxLat > this.tessellationMaxY) {
+        this.tessellationMaxY = hole.maxLat;
+      }
+      this.tessellationCount += hole.numPoints();
+    }
+  }
+
+  boolean tessellationDegenerate(int vertexCount, double minY, double maxY, double minX, double maxX) {
+    if (vertexCount < 4) {
+      return true;
+    }
+    if (minY == maxY && minX == maxX) {
+      return true;
+    }
+    if (minY > maxY || minX > maxX) {
+      return minY == maxY || minX == maxX;
+    }
+    double width = this.tessellationMaxX - this.tessellationMinX;
+    double height = this.tessellationMaxY - this.tessellationMinY;
+    if (width == 0 && height == 0) {
+      return true;
+    }
+    return false;
+  }
