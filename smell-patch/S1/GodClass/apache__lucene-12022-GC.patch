+
+  void resetLatLonVertexBuffer() {
+    this.latLonBufSize = 0;
+    this.latLonBufMinX = Integer.MAX_VALUE;
+    this.latLonBufMaxX = Integer.MIN_VALUE;
+    this.latLonBufMinY = Integer.MAX_VALUE;
+    this.latLonBufMaxY = Integer.MIN_VALUE;
+    if (this.latLonBufX == null || this.latLonBufY == null) {
+      this.latLonBufX = new int[16];
+      this.latLonBufY = new int[16];
+    } else if (this.latLonBufX.length > 4096) {
+      this.latLonBufX = new int[16];
+      this.latLonBufY = new int[16];
+    }
+  }
+
+  void growLatLonVertexBuffer(int minCapacity) {
+    if (this.latLonBufX == null || this.latLonBufY == null) {
+      int cap = Math.max(16, minCapacity);
+      this.latLonBufX = new int[cap];
+      this.latLonBufY = new int[cap];
+      return;
+    }
+    if (this.latLonBufX.length >= minCapacity) {
+      return;
+    }
+    int newCap = this.latLonBufX.length;
+    while (newCap < minCapacity) {
+      int doubled = newCap << 1;
+      if (doubled <= newCap) {
+        newCap = minCapacity;
+        break;
+      }
+      newCap = doubled;
+    }
+    int[] nextX = new int[newCap];
+    int[] nextY = new int[newCap];
+    System.arraycopy(this.latLonBufX, 0, nextX, 0, this.latLonBufSize);
+    System.arraycopy(this.latLonBufY, 0, nextY, 0, this.latLonBufSize);
+    this.latLonBufX = nextX;
+    this.latLonBufY = nextY;
+  }
+
+  void captureLatLonBufferVertex(int x, int y) {
+    growLatLonVertexBuffer(this.latLonBufSize + 1);
+    this.latLonBufX[this.latLonBufSize] = x;
+    this.latLonBufY[this.latLonBufSize] = y;
+    this.latLonBufSize++;
+    if (x < this.latLonBufMinX) {
+      this.latLonBufMinX = x;
+    }
+    if (x > this.latLonBufMaxX) {
+      this.latLonBufMaxX = x;
+    }
+    if (y < this.latLonBufMinY) {
+      this.latLonBufMinY = y;
+    }
+    if (y > this.latLonBufMaxY) {
+      this.latLonBufMaxY = y;
+    }
+  }
+
+  int encodeLatLonLineBuffer(Line line) {
+    resetLatLonVertexBuffer();
+    int n = line.numPoints();
+    growLatLonVertexBuffer(n);
+    for (int i = 0; i < n; i++) {
+      captureLatLonBufferVertex(encodeLon(line.getLon(i)), encodeLat(line.getLat(i)));
+    }
+    return this.latLonBufSize;
+  }
+
+  int encodeLatLonPolygonBuffer(Polygon polygon) {
+    resetLatLonVertexBuffer();
+    encodeLatLonRing(polygon);
+    Polygon[] holes = polygon.getHoles();
+    if (holes != null) {
+      for (int i = 0; i < holes.length; i++) {
+        if (holes[i] != null) {
+          encodeLatLonRing(holes[i]);
+        }
+      }
+    }
+    return this.latLonBufSize;
+  }
+
+  void encodeLatLonRing(Polygon ring) {
+    int n = ring.numPoints();
+    if (n < 2) {
+      return;
+    }
+    growLatLonVertexBuffer(this.latLonBufSize + n);
+    for (int i = 0; i < n; i++) {
+      captureLatLonBufferVertex(encodeLon(ring.getPolyLon(i)), encodeLat(ring.getPolyLat(i)));
+    }
+  }
