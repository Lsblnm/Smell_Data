+  LatLonShapeDocValuesField latLonPolygonDocValues(
+      String fieldName, Polygon polygon, boolean checkSelfIntersections) {
+    List<Tessellator.Triangle> tessellation =
+        tessellateLatLonPolygon(polygon, checkSelfIntersections);
+    this.docValueTriangles = new ArrayList<>(tessellation.size());
+    this.docValueHighestType = DecodedTriangle.TYPE.TRIANGLE;
+    resetDocValueBounds();
+    for (int i = 0; i < tessellation.size(); i++) {
+      this.docValueTriangles.add(buildDecodedTriangleFromTessellator(tessellation.get(i)));
+    }
+    return new LatLonShapeDocValuesField(fieldName, this.docValueTriangles);
+  }
