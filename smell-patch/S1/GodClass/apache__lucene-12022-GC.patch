+  LatLonShapeDocValuesField latLonLineDocValues(String fieldName, Line line) {
+    int numPoints = line.numPoints();
+    this.docValueTriangles = new ArrayList<>(Math.max(0, numPoints - 1));
+    this.docValueHighestType = DecodedTriangle.TYPE.LINE;
+    resetDocValueBounds();
+    for (int i = 0, j = 1; j < numPoints; ++i, ++j) {
+      DecodedTriangle triangle = new DecodedTriangle();
+      triangle.type = DecodedTriangle.TYPE.LINE;
+      int ax = encodeLon(line.getLon(i));
+      int ay = encodeLat(line.getLat(i));
+      int bx = encodeLon(line.getLon(j));
+      int by = encodeLat(line.getLat(j));
+      triangle.setValues(ax, ay, true, bx, by, true, ax, ay, true);
+      accumulateDocValueBounds(triangle);
+      this.docValueTriangles.add(triangle);
+    }
+    return new LatLonShapeDocValuesField(fieldName, this.docValueTriangles);
+  }
