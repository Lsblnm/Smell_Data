+  private static int orientEncoded(int ax, int ay, int bx, int by, int cx, int cy) {
+    long v1 = (long) bx - (long) ax;
+    long v2 = (long) cy - (long) ay;
+    long v3 = (long) cx - (long) ax;
+    long v4 = (long) by - (long) ay;
+    long prod1 = v1 * v2;
+    long prod2 = v3 * v4;
+    if (prod1 > prod2) {
+      return 1;
+    } else if (prod1 < prod2) {
+      return -1;
+    } else {
+      return 0;
+    }
+  }
