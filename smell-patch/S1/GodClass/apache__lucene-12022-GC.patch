+  void collectTessellationBounds() {
+    if (this.tessellationOutput == null || this.tessellationOutput.isEmpty()) {
+      this.tessellationCount = 0;
+      return;
+    }
+    this.tessellationCount = this.tessellationOutput.size();
+    for (int i = 0; i < this.tessellationOutput.size(); i++) {
+      inspectTessellationTriangle(this.tessellationOutput.get(i));
+    }
+  }
+
+  void inspectTessellationTriangle(Tessellator.Triangle triangle) {
+    if (triangle == null) {
+      return;
+    }
+    for (int v = 0; v < 3; v++) {
+      double dx = triangle.getEncodedX(v);
+      double dy = triangle.getEncodedY(v);
+      if (v == 0) {
+        this.tessellationMinX = Math.min(this.tessellationMinX, dx);
+        this.tessellationMinY = Math.min(this.tessellationMinY, dy);
+      } else if (v == 1) {
+        this.tessellationMaxX = Math.max(this.tessellationMaxX, dx);
+        this.tessellationMaxY = Math.max(this.tessellationMaxY, dy);
+      } else {
+        this.tessellationMinX = Math.min(this.tessellationMinX, dx);
+        this.tessellationMaxX = Math.max(this.tessellationMaxX, dx);
+        this.tessellationMinY = Math.min(this.tessellationMinY, dy);
+        this.tessellationMaxY = Math.max(this.tessellationMaxY, dy);
+      }
+    }
+  }
