+      this.tessellationMaxX = Math.max(this.tessellationMaxX, polygon.maxX);
+      this.tessellationMinY = Math.min(this.tessellationMinY, polygon.minY);
+      this.tessellationMaxY = Math.max(this.tessellationMaxY, polygon.maxY);
