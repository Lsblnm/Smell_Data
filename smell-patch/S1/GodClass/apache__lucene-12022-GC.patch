+    double maxY = decodeXY(NumericUtils.sortableBytesToInt(maxTriangle, 2 * BYTES));
+    double maxX = decodeXY(NumericUtils.sortableBytesToInt(maxTriangle, 3 * BYTES));
+    if (this.xyQueryComponent == null) {
+      throw new IllegalArgumentException("query component must not be null");
+    }
