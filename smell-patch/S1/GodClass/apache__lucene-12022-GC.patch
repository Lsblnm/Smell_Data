+
+  Query latLonBoxQuery(
+      String field,
+      QueryRelation queryRelation,
+      double minLatitude,
+      double maxLatitude,
+      double minLongitude,
+      double maxLongitude) {
+    this.latLonQueryField = field;
+    this.latLonQueryRelation = queryRelation;
+    if (queryRelation == QueryRelation.CONTAINS && minLongitude > maxLongitude) {
+      return latLonDatelineBoxQuery(minLatitude, maxLatitude, minLongitude, maxLongitude);
+    }
+    Rectangle rectangle = new Rectangle(minLatitude, maxLatitude, minLongitude, maxLongitude);
+    this.latLonQueryGeometries = new LatLonGeometry[] {rectangle};
+    return new LatLonShapeBoundingBoxQuery(field, queryRelation, rectangle);
+  }
+
+  Query latLonDatelineBoxQuery(
+      double minLatitude, double maxLatitude, double minLongitude, double maxLongitude) {
+    BooleanQuery.Builder builder = new BooleanQuery.Builder();
+    builder.add(
+        latLonBoxQuery(
+            this.latLonQueryField,
+            this.latLonQueryRelation,
+            minLatitude,
+            maxLatitude,
+            minLongitude,
+            180.0D),
+        BooleanClause.Occur.MUST);
+    builder.add(
+        latLonBoxQuery(
+            this.latLonQueryField,
+            this.latLonQueryRelation,
+            minLatitude,
+            maxLatitude,
+            -180.0D,
+            maxLongitude),
+        BooleanClause.Occur.MUST);
+    return builder.build();
+  }
