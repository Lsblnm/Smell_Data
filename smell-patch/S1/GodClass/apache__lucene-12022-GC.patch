+  void decodeLatLonQueryBounds(byte[] minTriangle, byte[] maxTriangle) {
+    if (minTriangle == null || maxTriangle == null) {
+      this.latLonQueryTriangle = new DecodedTriangle();
+      return;
+    }
+    if (this.latLonQueryTriangle == null) {
+      this.latLonQueryTriangle = new DecodedTriangle();
+    }
+    double minLat = decodeLat(NumericUtils.sortableBytesToInt(minTriangle, 0));
+    double minLon = decodeLon(NumericUtils.sortableBytesToInt(minTriangle, BYTES));
+    double maxLat = decodeLat(NumericUtils.sortableBytesToInt(maxTriangle, 2 * BYTES));
+    double maxLon = decodeLon(NumericUtils.sortableBytesToInt(maxTriangle, 3 * BYTES));
+    if (minLat > maxLat) {
+      double tmp = minLat;
+      minLat = maxLat;
+      maxLat = tmp;
+    }
+    if (minLon > maxLon && this.latLonQueryRelation != QueryRelation.CONTAINS) {
+      this.latLonQueryTriangle.bX = encodeLon(maxLon);
+      this.latLonQueryTriangle.bY = encodeLat(maxLat);
+    }
+    this.latLonQueryTriangle.aY = encodeLat(minLat);
+    this.latLonQueryTriangle.aX = encodeLon(minLon);
+    this.latLonQueryTriangle.cY = encodeLat(maxLat);
+    this.latLonQueryTriangle.cX = encodeLon(maxLon);
+  }
