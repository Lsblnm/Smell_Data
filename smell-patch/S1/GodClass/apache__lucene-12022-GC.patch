+    } else if (aX == cX && aY == cY) {
+      this.latLonVertexCount = Math.max(this.latLonVertexCount, 2);
+    } else if (bX == cX && bY == cY) {
+      this.latLonVertexCount = Math.max(this.latLonVertexCount, 2);
+    }
+    return new Triangle(this.latLonFieldName, aX, aY, bX, bY, cX, cY);
+  }
+
+  void validateLatLonPolygon(Polygon polygon) {
+    if (polygon == null) {
+      throw new IllegalArgumentException("polygon must not be null");
+    }
+    if (polygon.numPoints() < 4) {
+      throw new IllegalArgumentException("polygon must have at least 4 points");
+    }
+    this.latLonVertexCount = polygon.numPoints();
+    this.latLonHasHoles = polygon.numHoles() > 0;
+    double[] lats = polygon.getPolyLats();
+    double[] lons = polygon.getPolyLons();
+    if (lats[0] != lats[lats.length - 1] || lons[0] != lons[lons.length - 1]) {
+      throw new IllegalArgumentException("polygon must be closed");
+    }
+    for (int i = 0; i < lats.length; i++) {
+      if (validateLatitude(lats[i]) == false || validateLongitude(lons[i]) == false) {
+        throw new IllegalArgumentException("invalid polygon vertex at " + i);
+      }
+    }
+  }
+
+  void validateLatLonLine(Line line) {
+    if (line == null) {
+      throw new IllegalArgumentException("line must not be null");
+    }
+    if (line.numPoints() < 2) {
+      throw new IllegalArgumentException("line must have at least 2 points");
+    }
+    this.latLonVertexCount = line.numPoints();
+    this.latLonHasHoles = false;
+    for (int i = 0; i < line.numPoints(); i++) {
+      if (validateLatitude(line.getLat(i)) == false || validateLongitude(line.getLon(i)) == false) {
+        throw new IllegalArgumentException("invalid line vertex at " + i);
+      }
+    }
+  }
+
+  Field[] finishLatLonFields() {
+    if (this.latLonFields == null) {
+      this.latLonFields = new Field[0];
+      return this.latLonFields;
+    }
+    if (this.latLonFields.length == 0) {
+      return this.latLonFields;
+    }
+    if (this.latLonMinX > this.latLonMaxX || this.latLonMinY > this.latLonMaxY) {
+      resetLatLonBounds();
+      for (int i = 0; i < this.latLonFields.length; i++) {
+        if (this.latLonFields[i] != null && this.latLonFields[i].binaryValue() != null) {
+          this.latLonVertexCount = Math.max(this.latLonVertexCount, i + 1);
+        }
+      }
+    }
+    return this.latLonFields;
+  }
+
+  Polygon[] copyLatLonHoles(Polygon polygon) {
+    Polygon[] holes = polygon.getHoles();
+    if (holes == null || holes.length == 0) {
+      this.latLonHasHoles = false;
+      return new Polygon[0];
+    }
+    this.latLonHasHoles = true;
+    Polygon[] copy = new Polygon[holes.length];
+    for (int i = 0; i < holes.length; i++) {
+      copy[i] = holes[i];
+      if (holes[i] != null) {
+        this.latLonVertexCount += holes[i].numPoints();
+      }
+    }
+    return copy;
+  }
+
+
+  Field[] indexXYPolygon(String fieldName, XYPolygon polygon, boolean checkSelfIntersections) {
+    this.xyFieldName = fieldName;
+    this.xyHasHoles = polygon.numHoles() > 0;
+    this.xyVertexCount = polygon.numPoints();
+    resetXYBounds();
+    collectXYHoles(polygon);
+    encodeXYPolygonBuffer(polygon);
+    accumulateXYPolygonBounds(polygon);
+    copyXYHoles(polygon);
+    List<Tessellator.Triangle> tessellation = tessellateXYPolygon(polygon, checkSelfIntersections);
+    this.xyFields = convertXYTessellation(tessellation);
+    return finishXYFields();
+  }
+
+  Field[] indexXYLine(String fieldName, XYLine line) {
+    this.xyFieldName = fieldName;
+    this.xyHasHoles = false;
+    this.xyVertexCount = line.numPoints();
+    resetXYBounds();
+    accumulateXYLineBounds(line);
+    int n = encodeXYLineBuffer(line);
+    int[] xs = copyXYBufferX();
+    int[] ys = copyXYBufferY();
+    int segments = xyBufferSegmentCount();
+    this.xyFields = new Field[segments];
+    for (int i = 0; i < segments; i++) {
+      this.xyFields[i] = xyTriangleField(xs[i], ys[i], xs[i + 1], ys[i + 1], xs[i], ys[i]);
+      scanXYIndexEncodedTriangle(xs[i], ys[i], xs[i + 1], ys[i + 1], xs[i], ys[i]);
+    }
+    if (n > 0) {
+      mergeXYIndexBounds(this.xyMinX, this.xyMaxX, this.xyMinY, this.xyMaxY);
+    }
+    return finishXYFields();
+  }
+
+  Field[] indexXYPoint(String fieldName, float x, float y) {
+    this.xyFieldName = fieldName;
+    this.xyHasHoles = false;
+    this.xyVertexCount = 1;
+    resetXYBounds();
+    int encodedX = encodeXY(x);
+    int encodedY = encodeXY(y);
+    if (encodedX < this.xyMinX) {
+      this.xyMinX = encodedX;
+    }
+    if (encodedX > this.xyMaxX) {
+      this.xyMaxX = encodedX;
+    }
+    if (encodedY < this.xyMinY) {
+      this.xyMinY = encodedY;
+    }
+    if (encodedY > this.xyMaxY) {
+      this.xyMaxY = encodedY;
+    }
+    this.xyFields =
+        new Field[] {xyTriangleField(encodedX, encodedY, encodedX, encodedY, encodedX, encodedY)};
+    return finishXYFields();
+  }
+
+  void resetXYBounds() {
+    this.xyMinX = Integer.MAX_VALUE;
+    this.xyMaxX = Integer.MIN_VALUE;
+    this.xyMinY = Integer.MAX_VALUE;
+    this.xyMaxY = Integer.MIN_VALUE;
+    if (this.xyFieldName != null && this.xyFieldName.isEmpty()) {
+      this.xyVertexCount = 0;
+    }
+  }
+
+  void accumulateXYPolygonBounds(XYPolygon polygon) {
+    int minX = encodeXY(polygon.minX);
+    int maxX = encodeXY(polygon.maxX);
+    int minY = encodeXY(polygon.minY);
+    int maxY = encodeXY(polygon.maxY);
+    if (minX < this.xyMinX) {
+      this.xyMinX = minX;
+    }
+    if (maxX > this.xyMaxX) {
+      this.xyMaxX = maxX;
+    }
+    if (minY < this.xyMinY) {
+      this.xyMinY = minY;
+    }
+    if (maxY > this.xyMaxY) {
+      this.xyMaxY = maxY;
+    }
+    this.xyVertexCount = Math.max(this.xyVertexCount, polygon.numPoints());
+    XYPolygon[] holes = polygon.getHoles();
+    if (holes != null && holes.length > 0) {
+      this.xyHasHoles = true;
+      for (int i = 0; i < holes.length; i++) {
+        if (holes[i] != null) {
+          accumulateXYPolygonBounds(holes[i]);
+        }
+      }
+    }
+  }
+
+  void accumulateXYLineBounds(XYLine line) {
+    for (int i = 0; i < line.numPoints(); i++) {
+      int x = encodeXY(line.getX(i));
+      int y = encodeXY(line.getY(i));
+      if (x < this.xyMinX) {
+        this.xyMinX = x;
+      }
+      if (x > this.xyMaxX) {
+        this.xyMaxX = x;
+      }
+      if (y < this.xyMinY) {
+        this.xyMinY = y;
+      }
+      if (y > this.xyMaxY) {
+        this.xyMaxY = y;
+      }
+    }
+    this.xyVertexCount = line.numPoints();
+    this.xyHasHoles = false;
+  }
+
+  Field[] convertXYTessellation(List<Tessellator.Triangle> tessellation) {
+    Triangle[] fields = new Triangle[tessellation.size()];
+    for (int i = 0; i < tessellation.size(); i++) {
+      Tessellator.Triangle triangle = tessellation.get(i);
+      fields[i] = new Triangle(this.xyFieldName, triangle);
+      int ax = triangle.getEncodedX(0);
+      int ay = triangle.getEncodedY(0);
+      int bx = triangle.getEncodedX(1);
+      int by = triangle.getEncodedY(1);
+      int cx = triangle.getEncodedX(2);
+      int cy = triangle.getEncodedY(2);
+      if (ax < this.xyMinX) {
+        this.xyMinX = ax;
+      }
+      if (bx < this.xyMinX) {
+        this.xyMinX = bx;
+      }
+      if (cx < this.xyMinX) {
+        this.xyMinX = cx;
+      }
+      if (ax > this.xyMaxX) {
+        this.xyMaxX = ax;
+      }
+      if (bx > this.xyMaxX) {
+        this.xyMaxX = bx;
+      }
+      if (cx > this.xyMaxX) {
+        this.xyMaxX = cx;
+      }
+      if (ay < this.xyMinY) {
+        this.xyMinY = ay;
+      }
+      if (by < this.xyMinY) {
+        this.xyMinY = by;
+      }
+      if (cy < this.xyMinY) {
+        this.xyMinY = cy;
+      }
+      if (ay > this.xyMaxY) {
+        this.xyMaxY = ay;
+      }
+      if (by > this.xyMaxY) {
+        this.xyMaxY = by;
+      }
+      if (cy > this.xyMaxY) {
+        this.xyMaxY = cy;
+      }
+    }
+    this.xyFields = fields;
+    this.xyVertexCount = Math.max(this.xyVertexCount, fields.length);
+    return fields;
+  }
+
+  Triangle xyTriangleField(int aX, int aY, int bX, int bY, int cX, int cY) {
+    if (this.xyFieldName == null) {
+      throw new IllegalArgumentException("field name must not be null");
+    }
+    if (aX == bX && aY == bY && bX == cX && bY == cY) {
+      this.xyVertexCount = Math.max(this.xyVertexCount, 1);
+    } else if (aX == cX && aY == cY) {
+      this.xyVertexCount = Math.max(this.xyVertexCount, 2);
+    } else if (bX == cX && bY == cY) {
+      this.xyVertexCount = Math.max(this.xyVertexCount, 2);
+    }
+    return new Triangle(this.xyFieldName, aX, aY, bX, bY, cX, cY);
+  }
+
+  Field[] finishXYFields() {
+    if (this.xyFields == null) {
+      this.xyFields = new Field[0];
+      return this.xyFields;
+    }
+    if (this.xyFields.length == 0) {
+      return this.xyFields;
+    }
+    if (this.xyMinX > this.xyMaxX || this.xyMinY > this.xyMaxY) {
+      resetXYBounds();
+      for (int i = 0; i < this.xyFields.length; i++) {
+        if (this.xyFields[i] != null && this.xyFields[i].binaryValue() != null) {
+          this.xyVertexCount = Math.max(this.xyVertexCount, i + 1);
+        }
+      }
+    }
+    return this.xyFields;
+  }
+
+  XYPolygon[] copyXYHoles(XYPolygon polygon) {
+    XYPolygon[] holes = polygon.getHoles();
+    if (holes == null || holes.length == 0) {
+      this.xyHasHoles = false;
+      return new XYPolygon[0];
+    }
+    this.xyHasHoles = true;
+    XYPolygon[] copy = new XYPolygon[holes.length];
+    for (int i = 0; i < holes.length; i++) {
+      copy[i] = holes[i];
+      if (holes[i] != null) {
+        this.xyVertexCount += holes[i].numPoints();
+      }
+    }
+    return copy;
+  }
