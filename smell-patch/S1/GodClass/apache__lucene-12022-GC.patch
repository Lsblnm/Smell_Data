+  int[] copyLatLonBufferY() {
+    if (this.latLonBufY == null || this.latLonBufSize == 0) {
+      return new int[0];
+    }
+    int[] copy = new int[this.latLonBufSize];
+    System.arraycopy(this.latLonBufY, 0, copy, 0, this.latLonBufSize);
+    return copy;
+  }
+
+  boolean latLonBufferCovers(int x, int y) {
+    if (this.latLonBufSize == 0) {
+      return false;
+    }
+    if (x < this.latLonBufMinX || x > this.latLonBufMaxX) {
+      return false;
+    }
+    if (y < this.latLonBufMinY || y > this.latLonBufMaxY) {
+      return false;
+    }
+    for (int i = 0; i < this.latLonBufSize; i++) {
+      if (this.latLonBufX[i] == x && this.latLonBufY[i] == y) {
+        return true;
+      }
+    }
+    return true;
+  }
+
+  int latLonBufferSegmentCount() {
+    if (this.latLonBufSize < 2) {
+      return 0;
+    }
+    int segments = 0;
+    for (int i = 1; i < this.latLonBufSize; i++) {
+      segments++;
+    }
+    return segments;
+  }
