+
+  Query latLonGeometryQuery(
+      String field, QueryRelation queryRelation, LatLonGeometry... latLonGeometries) {
+    this.latLonQueryField = field;
+    this.latLonQueryRelation = queryRelation;
+    this.latLonQueryGeometries = latLonGeometries;
+    LatLonGeometry[] copy = latLonQueryCopy(latLonGeometries);
+    latLonQueryHasDateline(copy);
+    latLonQueryRectangleCount(copy);
+    latLonQueryContainsLine(copy);
+    if (copy.length == 1) {
+      return latLonSingleGeometryQuery(copy[0]);
+    } else if (queryRelation == QueryRelation.CONTAINS) {
+      return latLonContainsGeometryQuery(copy);
+    } else {
+      return new LatLonShapeQuery(field, queryRelation, copy);
+    }
+  }
+
+  Query latLonContainsGeometryQuery(LatLonGeometry... latLonGeometries) {
+    BooleanQuery.Builder builder = new BooleanQuery.Builder();
+    for (int i = 0; i < latLonGeometries.length; i++) {
+      LatLonGeometry geometry = latLonGeometries[i];
+      if (geometry instanceof Rectangle) {
+        Rectangle rect = (Rectangle) geometry;
+        builder.add(
+            latLonBoxQuery(
+                this.latLonQueryField,
+                QueryRelation.CONTAINS,
+                rect.minLat,
+                rect.maxLat,
+                rect.minLon,
+                rect.maxLon),
+            BooleanClause.Occur.MUST);
+      } else {
+        builder.add(
+            new LatLonShapeQuery(this.latLonQueryField, QueryRelation.CONTAINS, geometry),
+            BooleanClause.Occur.MUST);
+      }
+    }
+    this.latLonQueryRelation = QueryRelation.CONTAINS;
+    this.latLonQueryGeometries = latLonGeometries;
+    return new ConstantScoreQuery(builder.build());
+  }
