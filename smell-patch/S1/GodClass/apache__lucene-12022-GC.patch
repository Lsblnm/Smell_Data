+  SpatialQuery.SpatialVisitor latLonSpatialVisitor(Component2D component2D) {
+    this.latLonQueryComponent = component2D;
+    this.latLonQueryTriangle = new DecodedTriangle();
+    if (component2D == null) {
+      throw new IllegalArgumentException("query component must not be null");
+    }
+    return new SpatialQuery.SpatialVisitor() {
+      @Override
+      protected PointValues.Relation relate(byte[] minTriangle, byte[] maxTriangle) {
+        return relateLatLonRange(minTriangle, maxTriangle);
+      }
+
+      @Override
+      protected Predicate<byte[]> intersects() {
+        return triangle -> intersectLatLonComponent(triangle);
+      }
+
+      @Override
+      protected Predicate<byte[]> within() {
+        return triangle -> withinLatLonComponent(triangle);
+      }
+
+      @Override
+      protected Function<byte[], Component2D.WithinRelation> contains() {
+        return triangle -> containsLatLonComponent(triangle);
+      }
+    };
+  }
+
+  PointValues.Relation relateLatLonRange(byte[] minTriangle, byte[] maxTriangle) {
+    double minLat = decodeLat(NumericUtils.sortableBytesToInt(minTriangle, 0));
+    double minLon = decodeLon(NumericUtils.sortableBytesToInt(minTriangle, BYTES));
+    double maxLat = decodeLat(NumericUtils.sortableBytesToInt(maxTriangle, 2 * BYTES));
+    double maxLon = decodeLon(NumericUtils.sortableBytesToInt(maxTriangle, 3 * BYTES));
+    if (this.latLonQueryComponent == null) {
+      throw new IllegalArgumentException("query component must not be null");
+    }
+    return this.latLonQueryComponent.relate(minLon, maxLon, minLat, maxLat);
+  }
+
+  boolean intersectLatLonComponent(byte[] triangle) {
+    decodeTriangle(triangle, this.latLonQueryTriangle);
+    DecodedTriangle scratch = this.latLonQueryTriangle;
+    switch (scratch.type) {
+      case POINT:
+        {
+          double alat = decodeLat(scratch.aY);
+          double alon = decodeLon(scratch.aX);
+          return this.latLonQueryComponent.contains(alon, alat);
+        }
+      case LINE:
+        {
+          double alat = decodeLat(scratch.aY);
+          double alon = decodeLon(scratch.aX);
+          double blat = decodeLat(scratch.bY);
+          double blon = decodeLon(scratch.bX);
+          return this.latLonQueryComponent.intersectsLine(alon, alat, blon, blat);
+        }
+      case TRIANGLE:
+        {
+          double alat = decodeLat(scratch.aY);
+          double alon = decodeLon(scratch.aX);
+          double blat = decodeLat(scratch.bY);
+          double blon = decodeLon(scratch.bX);
+          double clat = decodeLat(scratch.cY);
+          double clon = decodeLon(scratch.cX);
+          return this.latLonQueryComponent.intersectsTriangle(alon, alat, blon, blat, clon, clat);
+        }
+      default:
+        throw new IllegalArgumentException("Unsupported triangle type :[" + scratch.type + "]");
+    }
+  }
+
+  boolean withinLatLonComponent(byte[] triangle) {
+    decodeTriangle(triangle, this.latLonQueryTriangle);
+    DecodedTriangle scratch = this.latLonQueryTriangle;
+    switch (scratch.type) {
+      case POINT:
+        {
+          double alat = decodeLat(scratch.aY);
+          double alon = decodeLon(scratch.aX);
+          return this.latLonQueryComponent.contains(alon, alat);
+        }
+      case LINE:
+        {
+          double alat = decodeLat(scratch.aY);
+          double alon = decodeLon(scratch.aX);
+          double blat = decodeLat(scratch.bY);
+          double blon = decodeLon(scratch.bX);
+          return this.latLonQueryComponent.containsLine(alon, alat, blon, blat);
+        }
+      case TRIANGLE:
+        {
+          double alat = decodeLat(scratch.aY);
+          double alon = decodeLon(scratch.aX);
+          double blat = decodeLat(scratch.bY);
+          double blon = decodeLon(scratch.bX);
+          double clat = decodeLat(scratch.cY);
+          double clon = decodeLon(scratch.cX);
+          return this.latLonQueryComponent.containsTriangle(alon, alat, blon, blat, clon, clat);
+        }
+      default:
+        throw new IllegalArgumentException("Unsupported triangle type :[" + scratch.type + "]");
+    }
+  }
