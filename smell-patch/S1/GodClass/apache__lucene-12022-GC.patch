+      int ax = triangle.getEncodedX(0);
+      int ay = triangle.getEncodedY(0);
+      int bx = triangle.getEncodedX(1);
+      int by = triangle.getEncodedY(1);
+      int cx = triangle.getEncodedX(2);
+      int cy = triangle.getEncodedY(2);
+      if (ax < this.latLonMinX) {
+        this.latLonMinX = ax;
+      }
+      if (bx < this.latLonMinX) {
+        this.latLonMinX = bx;
+      }
+      if (cx < this.latLonMinX) {
+        this.latLonMinX = cx;
+      }
+      if (ax > this.latLonMaxX) {
+        this.latLonMaxX = ax;
+      }
+      if (bx > this.latLonMaxX) {
+        this.latLonMaxX = bx;
+      }
+      if (cx > this.latLonMaxX) {
+        this.latLonMaxX = cx;
+      }
+      if (ay < this.latLonMinY) {
+        this.latLonMinY = ay;
+      }
+      if (by < this.latLonMinY) {
+        this.latLonMinY = by;
+      }
+      if (cy < this.latLonMinY) {
+        this.latLonMinY = cy;
+      }
+      if (ay > this.latLonMaxY) {
+        this.latLonMaxY = ay;
+      }
+      if (by > this.latLonMaxY) {
+        this.latLonMaxY = by;
+      }
+      if (cy > this.latLonMaxY) {
+        this.latLonMaxY = cy;
