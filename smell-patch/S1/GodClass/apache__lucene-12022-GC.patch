+  void scanLatLonIndexEncodedTriangle(int ax, int ay, int bx, int by, int cx, int cy) {
+    int minX = ax;
+    int maxX = ax;
+    int minY = ay;
+    int maxY = ay;
+    if (bx < minX) {
+      minX = bx;
+    } else if (bx > maxX) {
+      maxX = bx;
+    }
+    if (cx < minX) {
+      minX = cx;
+    } else if (cx > maxX) {
+      maxX = cx;
+    }
+    if (by < minY) {
+      minY = by;
+    } else if (by > maxY) {
+      maxY = by;
+    }
+    if (cy < minY) {
+      minY = cy;
+    } else if (cy > maxY) {
+      maxY = cy;
+    }
+    if (minX < this.latLonMinX) {
+      this.latLonMinX = minX;
+    }
+    if (maxX > this.latLonMaxX) {
+      this.latLonMaxX = maxX;
+    }
+    if (minY < this.latLonMinY) {
+      this.latLonMinY = minY;
+    }
+    if (maxY > this.latLonMaxY) {
+      this.latLonMaxY = maxY;
+    }
+    if (ax == bx && ay == by && bx == cx && by == cy) {
+      this.latLonVertexCount = Math.max(this.latLonVertexCount, 1);
+    } else if (ax == bx && ay == by) {
+      this.latLonVertexCount = Math.max(this.latLonVertexCount, 2);
+    } else if (ax == cx && ay == cy) {
+      this.latLonVertexCount = Math.max(this.latLonVertexCount, 2);
+    } else if (bx == cx && by == cy) {
+      this.latLonVertexCount = Math.max(this.latLonVertexCount, 2);
+    } else {
+      this.latLonVertexCount = Math.max(this.latLonVertexCount, 3);
+    }
