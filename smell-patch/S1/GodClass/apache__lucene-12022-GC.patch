+  SpatialQuery.SpatialVisitor xySpatialVisitor(Component2D component2D) {
+    this.xyQueryComponent = component2D;
+    this.xyQueryTriangle = new DecodedTriangle();
+    if (component2D == null) {
+      throw new IllegalArgumentException("query component must not be null");
+    }
+    return new SpatialQuery.SpatialVisitor() {
+      @Override
+      protected PointValues.Relation relate(byte[] minTriangle, byte[] maxTriangle) {
+        return relateXYRange(minTriangle, maxTriangle);
+      }
+
+      @Override
+      protected Predicate<byte[]> intersects() {
+        return triangle -> intersectXYComponent(triangle);
+      }
+
+      @Override
+      protected Predicate<byte[]> within() {
+        return triangle -> withinXYComponent(triangle);
+      }
+
+      @Override
+      protected Function<byte[], Component2D.WithinRelation> contains() {
+        return triangle -> containsXYComponent(triangle);
+      }
+    };
+  }
