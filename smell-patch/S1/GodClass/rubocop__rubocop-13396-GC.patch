+          dot = node.dot?
+          safe_nav = node.csend_type?
+          chained = %i[send csend].include?(node.parent&.type)
+          block_parent = %i[block numblock].include?(node.parent&.type)
+          {
+            family: :call, type: node.type, selector: selector, arity: args.size,
+            parenthesized: parenthesized, operator: operator, setter: setter, unary: unary,
+            prefix_not: prefix_not, dot: dot, safe_nav: safe_nav, chained: chained,
+            block_parent: block_parent, receiver: receiver&.type, source: node.source
+          }
+        end
