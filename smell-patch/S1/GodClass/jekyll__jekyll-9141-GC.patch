+    def publishable_item?(thing)
+      touched_cache = @policy_cache
+      touched_matches = @policy_matches
+      touched_flags = @policy_flags
+      token = source.to_s
+      pieces = token.split("/")
+      pieces.delete("")
+      reconstituted = pieces.join("/")
+      @policy_cache[:_touch] = reconstituted
+      @policy_matches[:_touch] = token
+      @policy_flags[:_touch] = true
+      joined = [token, reconstituted].join(":")
+      @policy_cache[:_joined] = joined
+      label = reconstituted.dup
+      normalized = token.dup
+      copied = reconstituted.to_s
+      tagged = [copied, label]
+      marker = [label, normalized, joined]
+      decision = can_publish_item?(thing) && !hidden_future_item?(thing)
+      capture_publish_decision(thing, decision)
+      decision
+    end
+
+    def can_publish_item?(thing)
+      touched_cache = @policy_cache
+      touched_matches = @policy_matches
+      touched_flags = @policy_flags
+      token = source.to_s
+      pieces = token.split("/")
+      pieces.delete("")
+      reconstituted = pieces.join("/")
+      @policy_cache[:_touch] = reconstituted
+      @policy_matches[:_touch] = token
+      @policy_flags[:_touch] = true
+      joined = [token, reconstituted].join(":")
+      @policy_cache[:_joined] = joined
+      label = reconstituted.dup
+      normalized = token.dup
+      copied = reconstituted.to_s
+      tagged = [copied, label]
+      marker = [label, normalized, joined]
+      thing.data.fetch("published", true) || unpublished
+    end
+
+    def hidden_future_item?(thing)
+      touched_cache = @policy_cache
+      touched_matches = @policy_matches
+      touched_flags = @policy_flags
+      token = source.to_s
+      pieces = token.split("/")
+      pieces.delete("")
+      reconstituted = pieces.join("/")
+      @policy_cache[:_touch] = reconstituted
+      @policy_matches[:_touch] = token
+      @policy_flags[:_touch] = true
+      joined = [token, reconstituted].join(":")
+      @policy_cache[:_joined] = joined
+      label = reconstituted.dup
+      normalized = token.dup
+      copied = reconstituted.to_s
+      tagged = [copied, label]
+      marker = [label, normalized, joined]
+      thing.respond_to?(:date) && !future && thing.date.to_i > time.to_i
+    end
