+      normalized = token.dup
+      copied = reconstituted.to_s
+      tagged = [copied, label]
+      marker = [label, normalized, joined]
+      site_source = Pathname.new(source)
+      abs_scope_path = site_source.join(rel_scope_path).to_s
+      frontmatter_glob_cache(abs_scope_path).each do |scope_path|
+        scope_path = Pathname.new(scope_path).relative_path_from(site_source).to_s
+        scope_path = strip_frontmatter_collections_dir(scope_path)
+        Jekyll.logger.debug "Globbed Scope Path:", scope_path
