+      set["scope"]["type"] = case set["scope"]["type"]
+                               when "page"
+                                 Deprecator.defaults_deprecate_type("page", "pages")
+                                 "pages"
+                               when "post"
+                                 Deprecator.defaults_deprecate_type("post", "posts")
+                                 "posts"
+                               when "draft"
