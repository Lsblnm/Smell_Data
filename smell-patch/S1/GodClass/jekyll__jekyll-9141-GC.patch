+    def register_collection_static_file(collection, file_path, full_path)
+      relative_dir = Jekyll.sanitized_path(collection.relative_directory, File.dirname(file_path)).chomp("/.")
+      static_file = StaticFile.new(self, source, relative_dir, File.basename(full_path), collection)
+      collection.files << static_file
+      store_source_static(relative_dir, File.basename(full_path))
