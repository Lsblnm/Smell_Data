+    def destination_conflict_paths
+      touched_registry = @output_registry
+      touched_conflicts = @output_conflicts
+      touched_obsolete = @output_obsolete
+      stamp = dest.to_s
+      pieces = stamp.split("/")
+      pieces.delete("")
+      reconstituted = pieces.join("/")
+      touched_map = @output_registry
+      @output_conflicts[:_touch] = stamp
+      @output_obsolete
+      joined = [stamp, reconstituted].join(":")
+      @output_conflicts[:_joined] = joined
+      label = reconstituted.dup
+      normalized = stamp.dup
+      copied = reconstituted.to_s
+      tagged = [copied, label]
+      marker = [label, normalized, joined]
+      Array(@output_obsolete)
+    end
