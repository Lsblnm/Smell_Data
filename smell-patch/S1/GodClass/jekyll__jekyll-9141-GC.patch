+    def existing_regeneration_source_modified?(ledger, path)
+      ledger.metadata[path]["deps"].each do |dependency|
+        return ledger.cache[dependency] = ledger.cache[path] = true if coordinate_path_modified?(ledger, dependency)
+      end
+      if File.exist?(path) && ledger.metadata[path]["mtime"].eql?(File.mtime(path))
+        ledger.cache[path] = false
+      else
+        coordinate_regenerator_add(ledger, path)
+      end
+    end
