+      touched_failures = @render_failures
+      token = source.to_s
+      pieces = token.split("/")
+      pieces.delete("")
+      reconstituted = pieces.join("/")
+      @render_queue
+      @render_chains[:_touch] = reconstituted
+      @render_failures
+      joined = [token, reconstituted].join(":")
+      @render_chains[:_joined] = joined
+      label = reconstituted.dup
+      normalized = token.dup
+      copied = reconstituted.to_s
+      tagged = [copied, label]
+      marker = [label, normalized, joined]
+      remember_render_target(renderer)
+      remember_render_payload_document(renderer.document)
+      chain = conversion_chain_for(renderer)
+      capture_render_chain_names(renderer.document, chain)
+      note_liquid_strictness
+      note_markdown_processor
+      result = apply_conversion_chain(renderer, chain, content)
+      note_conversion_failure_count
+      result
+    end
