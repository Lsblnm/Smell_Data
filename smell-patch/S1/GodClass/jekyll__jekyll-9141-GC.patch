+      label = reconstituted.dup
+      normalized = token.dup
+      copied = reconstituted.to_s
+      tagged = [copied, label]
+      marker = [label, normalized, joined]
+      converter.convert(content)
+      rescue StandardError => e
+      record_conversion_failure(renderer, converter, e)
+      Jekyll.logger.error "Conversion error:", "#{converter.class} encountered an error while converting '#{renderer.document.relative_path}':"
