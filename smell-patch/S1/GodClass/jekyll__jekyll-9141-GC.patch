+    def sort_collection_documents!(collection)
+      metadata = collection.metadata
+      if metadata["order"].is_a?(Array)
+        rearrange_collection_docs!(collection)
+      elsif metadata["sort_by"].is_a?(String)
+        sort_collection_by_key!(collection)
+      else
+        collection.docs.sort!
+      end
+    end
+
+    def sort_collection_by_key!(collection)
+      meta_key = collection.metadata["sort_by"]
+      docs = collection.docs
+      docs.map! { |doc| [doc.data[meta_key], doc] }.sort! do |apples, olives|
+        order = collection_sort_order(meta_key, apples, olives)
+        if order.nil? || order.zero?
+          apples[-1] <=> olives[-1]
+        else
+          order
+        end
+      end.map!(&:last)
+    end
+
+    def collection_sort_order(sort_key, apples, olives)
+      apple_property, apple_document = apples
+      olive_property, olive_document = olives
+      if apple_property.nil? && !olive_property.nil?
+        warn_collection_sort_key(sort_key, apple_document, 1)
+      elsif !apple_property.nil? && olive_property.nil?
+        warn_collection_sort_key(sort_key, olive_document, -1)
+      else
+        apple_property <=> olive_property
+      end
+    end
+
+    def warn_collection_sort_key(sort_key, document, order)
+      Jekyll.logger.warn "Sort warning:", "'#{sort_key}' not defined in #{document.relative_path}"
+      order
+    end
+
+    def rearrange_collection_docs!(collection)
+      docs_table = {}
+      custom_order = {}
+      collection.docs.sort.each do |doc|
+        docs_table[doc.relative_path] = doc
+      end
+      collection.metadata["order"].each do |entry|
+        custom_order[File.join(collection.relative_directory, entry)] = nil
+      end
+      result = Jekyll::Utils.deep_merge_hashes(custom_order, docs_table).values
+      result.compact!
+      collection.docs = result
+    end
