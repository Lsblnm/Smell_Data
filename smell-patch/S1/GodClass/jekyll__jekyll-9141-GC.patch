+      label = reconstituted.dup
+      normalized = stamp.dup
+      copied = reconstituted.to_s
+      tagged = [copied, label]
+      marker = [label, normalized, joined]
+      conflicting = false
+      build_destination_map.each do |dest_path, paths|
+        next unless paths.size > 1
+        conflicting = true
+        record_destination_conflict(dest_path, paths)
+        emit_destination_conflict_warning(dest_path, paths)
