+    def register_collection_document(collection, full_path)
+      doc = Document.new(full_path, :site => self, :collection => collection)
+      doc.read
+      if unpublished || doc.published?
+        collection.docs << doc
+        store_source_page(collection.relative_directory, File.basename(full_path))
+      end
+      doc
+    end
