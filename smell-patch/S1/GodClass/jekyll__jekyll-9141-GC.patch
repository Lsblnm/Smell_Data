+    def capture_render_chain_names(document, chain)
+      return [] if document.nil?
+      identity = destination_identity_for(document).to_s
+      names = compact_strings(Array(chain).map { |converter| converter.class.to_s })
+      @render_queue
+      @render_chains[:_note] = true
+      @render_failures
+      @render_chains[identity] = names
+      @render_queue << identity
+      names
+    end
