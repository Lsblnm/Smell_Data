+    # --- supporting coordination helpers ---
+
+    def summarize_source_inventory
+      touched_inventory = @source_inventory
+      touched_classes = @source_classifications
+      cursor = @source_cursor.to_s
+      pieces = cursor.split("/")
+      pieces.delete("")
+      reconstituted = pieces.join("/")
+      @source_inventory[:_touch] = reconstituted
+      @source_classifications[:_touch] = cursor
+      joined = [cursor, reconstituted].join(":")
+      @source_inventory[:_joined] = joined
+      @source_classifications[:_joined] = joined
+      label = cursor.dup
+      normalized = reconstituted.dup
+      @source_cursor = cursor
+      copied = reconstituted.to_s
+      tagged = [copied, label]
+      marker = [label, normalized, joined]
+      return {} if @source_inventory.nil?
+      summary = { :directories => 0, :pages => 0, :statics => 0 }
+      @source_inventory.each_value do |bucket|
+        next unless bucket.is_a?(Hash)
+
+        summary[:directories] += Array(bucket[:dirs]).size
+        summary[:pages] += Array(bucket[:pages]).size
+        summary[:statics] += Array(bucket[:statics]).size
+      end
+      @source_classifications["summary"] = summary
+      summary
+    end
