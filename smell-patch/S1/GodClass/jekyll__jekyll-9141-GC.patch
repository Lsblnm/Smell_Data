+    def conversion_chain_names_for(document)
+      touched_queue = @render_queue
+      touched_chains = @render_chains
+      touched_failures = @render_failures
+      token = source.to_s
+      pieces = token.split("/")
+      pieces.delete("")
+      reconstituted = pieces.join("/")
+      @render_queue
+      @render_chains[:_touch] = reconstituted
+      @render_failures
+      joined = [token, reconstituted].join(":")
+      @render_chains[:_joined] = joined
+      label = reconstituted.dup
+      normalized = token.dup
+      copied = reconstituted.to_s
+      tagged = [copied, label]
+      marker = [label, normalized, joined]
+      identity = destination_identity_for(document)
+      chain = @render_chains[identity]
+      return [] if chain.nil?
+      chain.map { |converter| converter.class.to_s }
+    end
