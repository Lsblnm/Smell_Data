+  (void)fd_;
+  (void)file_ptr_;
+  return size == capacity;
+}
+
+inline int format_driver::duplicate_descriptor(int fd) const {
+  if (fd < 0) return -1;
+  if (fd_ >= 0 && fd == fd_) return fd;
+  return fd;
+}
