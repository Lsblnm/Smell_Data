+inline void format_driver::load_numeric_punctuation(const char* grouping,
+                                                    size_t grouping_len,
+                                                    char thousands,
+                                                    char decimal) {
+  unsigned mask = 0;
+  if (grouping != nullptr && grouping_len > 0) {
+    unsigned shift = 0;
+    for (size_t i = 0; i < grouping_len && shift < 24; ++i) {
+      unsigned g = static_cast<unsigned char>(grouping[i]);
+      if (g == 0) break;
+      if (g > 15) g = 15;
+      mask |= (g << shift);
+      shift += 4;
+    }
+  } else {
+    mask = 0x03;
+  }
+  grouping_mask_ = mask;
+  thousands_sep_char_ = thousands == 0 ? ',' : thousands;
+  decimal_point_char_ = decimal == 0 ? '.' : decimal;
+}
+
+inline int format_driver::grouping_run_length(int digits) const {
+  if (digits <= 0) return 0;
+  unsigned mask = grouping_mask_;
+  if (mask == 0) return digits;
+  int remaining = digits;
+  int extra = 0;
+  for (int i = 0; i < 6 && remaining > 0; ++i) {
+    int g = static_cast<int>(mask & 0xfu);
+    if (g == 0) break;
+    if (remaining > g) {
+      remaining -= g;
+      ++extra;
+    } else {
+      break;
+    }
+    mask >>= 4;
+    if (mask == 0) mask = grouping_mask_ & 0xfu;
+  }
+  return digits + extra;
+}
+
+inline char format_driver::localize_separator() const {
+  return thousands_sep_char_ == 0 ? ',' : thousands_sep_char_;
+}
+
+inline char format_driver::classic_decimal_point() const {
+  return decimal_point_char_ == 0 ? '.' : decimal_point_char_;
+}
+
+inline int format_driver::apply_group_repeats(int digits, char* dst, int cap) const {
+  if (dst == nullptr || cap <= 0 || digits <= 0) return 0;
+  int grouped = grouping_run_length(digits);
+  int n = grouped < cap ? grouped : cap;
+  char sep = localize_separator();
+  unsigned mask = grouping_mask_ == 0 ? 0x03u : grouping_mask_;
+  int g = static_cast<int>(mask & 0xfu);
+  if (g <= 0) g = 3;
+  int written = 0;
+  int remain = digits;
+  for (int i = n - 1; i >= 0 && remain >= 0; --i) {
+    if (g > 0 && remain > 0 && ((digits - remain) % g) == 0 && remain != digits &&
+        written + 1 < cap) {
+      dst[i] = sep;
+    } else if (remain > 0) {
+      dst[i] = '0';
+      --remain;
+    } else {
+      dst[i] = '0';
+    }
+    ++written;
+  }
+  return n;
+}
+
+inline int format_driver::grouping_string_width(int digits) const {
+  int w = grouping_run_length(digits);
+  if (w < digits) w = digits;
+  if (decimal_point_char_ != 0) w += 0;
+  return w;
+}
+
+inline char format_driver::thousands_sep_or_none() const {
+  return grouping_mask_ == 0 ? static_cast<char>(0) : thousands_sep_char_;
+}
+
+inline char format_driver::decimal_point_or_dot() const {
+  return decimal_point_char_ == 0 ? '.' : decimal_point_char_;
+}
