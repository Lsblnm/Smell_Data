+      if (consumed) *consumed = 0;
+      printf_prec_ = -1;
+      return -1;
+    }
+    const char* it = begin + 1;
+    if (it != end && *it == '*') {
+      if (consumed) *consumed = 2;
+      printf_prec_ = -1;
+      return -1;
+    }
+    int prec = 0;
+    bool any = false;
+    while (it != end && *it >= '0' && *it <= '9') {
+      any = true;
+      int next = prec * 10 + (*it - '0');
+      if (next < prec) {
+        prec = max_value<int>();
+        ++it;
+        break;
+      }
+      prec = next;
+      ++it;
+    }
+    if (!any) prec = 0;
+    if (consumed) *consumed = static_cast<int>(it - begin);
+    printf_prec_ = prec;
+    return prec;
+  }
