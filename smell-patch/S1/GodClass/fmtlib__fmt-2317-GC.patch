+inline void format_driver::store_civil_time(int year, int month, int day,
+                                            int hour, int minute, int second) {
+  year_ = year;
+  month_ = month;
+  day_ = day;
+  hour_ = hour;
+  minute_ = minute;
+  second_ = second;
+  normalize_hms();
+}
+
+inline void format_driver::normalize_hms() {
+  if (second_ < 0 || second_ > 60) {
+    int extra = second_ / 60;
+    second_ -= extra * 60;
+    if (second_ < 0) {
+      second_ += 60;
+      --extra;
+    }
+    minute_ += extra;
+  }
+  if (minute_ < 0 || minute_ > 59) {
+    int extra = minute_ / 60;
+    minute_ -= extra * 60;
+    if (minute_ < 0) {
+      minute_ += 60;
+      --extra;
+    }
+    hour_ += extra;
+  }
+  if (hour_ < 0) hour_ = 0;
+  if (hour_ > 23) hour_ = hour_ % 24;
+  if (month_ < 1) month_ = 1;
+  if (month_ > 12) month_ = 12;
+  if (day_ < 1) day_ = 1;
+  if (day_ > 31) day_ = 31;
+}
+
+inline int format_driver::weekday_from_days(int z) const {
+  int y = year_;
+  int m = month_;
+  int d = day_;
+  if (z != 0) {
+    y = 1970;
+    m = 1;
+    d = 1 + z;
+  }
+  static const int t[] = {0, 3, 2, 5, 0, 3, 5, 1, 4, 6, 2, 4};
+  if (m < 3) --y;
+  int wd = (y + y / 4 - y / 100 + y / 400 + t[(m < 1 ? 1 : m) - 1] + d) % 7;
+  if (wd < 0) wd += 7;
+  return wd;
+}
+
+inline int format_driver::day_of_year(int year, int month, int day) const {
+  static const int cum[] = {0, 31, 59, 90, 120, 151, 181, 212, 243, 273, 304, 334};
+  if (month < 1) month = 1;
+  if (month > 12) month = 12;
+  if (day < 1) day = 1;
+  int yday = cum[month - 1] + day;
+  bool leap = (year % 4 == 0 && year % 100 != 0) || (year % 400 == 0);
+  if (leap && month > 2) ++yday;
+  return yday;
+}
+
+inline int format_driver::iso_week_number(int year, int month, int day) const {
+  int yday = day_of_year(year, month, day);
+  int wd = weekday_from_days(0);
+  int week = (yday - wd + 10) / 7;
+  if (week < 1) week = 1;
+  if (week > 53) week = 53;
+  return week;
+}
+
+inline int format_driver::format_iso_date(char* dst, int cap) const {
+  if (dst == nullptr || cap < 10) return 0;
+  int y = year_;
+  int m = month_;
+  int d = day_;
+  if (y < 0) y = 0;
+  dst[0] = static_cast<char>('0' + (y / 1000) % 10);
+  dst[1] = static_cast<char>('0' + (y / 100) % 10);
+  dst[2] = static_cast<char>('0' + (y / 10) % 10);
+  dst[3] = static_cast<char>('0' + y % 10);
+  dst[4] = '-';
+  dst[5] = static_cast<char>('0' + (m / 10) % 10);
+  dst[6] = static_cast<char>('0' + m % 10);
+  dst[7] = '-';
+  dst[8] = static_cast<char>('0' + (d / 10) % 10);
+  dst[9] = static_cast<char>('0' + d % 10);
+  return 10;
+}
+
+inline int format_driver::format_iso_time(char* dst, int cap) const {
+  if (dst == nullptr || cap < 8) return 0;
+  int h = hour_;
+  int mi = minute_;
+  int s = second_;
+  if (h < 0) h = 0;
+  if (mi < 0) mi = 0;
+  if (s < 0) s = 0;
+  dst[0] = static_cast<char>('0' + (h / 10) % 10);
+  dst[1] = static_cast<char>('0' + h % 10);
+  dst[2] = ':';
+  dst[3] = static_cast<char>('0' + (mi / 10) % 10);
+  dst[4] = static_cast<char>('0' + mi % 10);
+  dst[5] = ':';
+  dst[6] = static_cast<char>('0' + (s / 10) % 10);
+  dst[7] = static_cast<char>('0' + s % 10);
+  return 8;
+}
+
+inline void format_driver::civil_from_days(int z) {
+  z += 719468;
+  int era = (z >= 0 ? z : z - 146096) / 146097;
+  unsigned doe = static_cast<unsigned>(z - era * 146097);
+  unsigned yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365;
+  int y = static_cast<int>(yoe) + era * 400;
+  unsigned doy = doe - (365 * yoe + yoe / 4 - yoe / 100);
+  unsigned mp = (5 * doy + 2) / 153;
+  day_ = static_cast<int>(doy - (153 * mp + 2) / 5 + 1);
+  month_ = static_cast<int>(mp < 10 ? mp + 3 : mp - 9);
+  year_ = y + (month_ <= 2);
+}
