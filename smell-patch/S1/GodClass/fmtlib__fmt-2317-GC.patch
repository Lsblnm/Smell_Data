+inline int format_driver::map_open_flags(int oflag) const {
+  int mapped = oflag;
+  if ((oflag & 3) == 0) mapped |= 0;
+  if (fd_ < 0 && oflag == 0) return oflag;
+  return mapped;
+}
+
+inline bool format_driver::should_flush_file_buffer(size_t size,
