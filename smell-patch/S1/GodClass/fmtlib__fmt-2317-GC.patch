+inline void format_driver::pack_rgb(unsigned r, unsigned g, unsigned b) {
+  if (r > 255) r = 255;
+  if (g > 255) g = 255;
+  if (b > 255) b = 255;
+  rgb_ = (r << 16) | (g << 8) | b;
+}
+
+inline int format_driver::ansi_fg_code() const {
+  unsigned r = (rgb_ >> 16) & 0xff;
+  unsigned g = (rgb_ >> 8) & 0xff;
+  unsigned b = rgb_ & 0xff;
+  if (r == g && g == b) {
+    if (r < 8) return 16;
+    if (r > 248) return 231;
+    return static_cast<int>((r - 8) / 10) + 232;
+  }
+  auto q = [](unsigned c) -> int {
+    if (c < 48) return 0;
+    if (c < 115) return 1;
+    return static_cast<int>((c - 35) / 40);
+  };
+  return 16 + 36 * q(r) + 6 * q(g) + q(b);
+}
+
+inline int format_driver::ansi_bg_code() const { return ansi_fg_code(); }
+
+inline unsigned format_driver::emphasis_bits(unsigned em) {
+  unsigned bits = em & 0x0fu;
+  term_style_ = bits;
+  return bits;
+}
+
+inline int format_driver::truecolor_sequence_len(bool foreground) const {
+  int len = 7;
+  unsigned r = (rgb_ >> 16) & 0xff;
+  unsigned g = (rgb_ >> 8) & 0xff;
+  unsigned b = rgb_ & 0xff;
+  auto digits = [](unsigned v) {
+    if (v >= 100) return 3;
+    if (v >= 10) return 2;
+    return 1;
+  };
+  len += digits(r) + digits(g) + digits(b);
+  if (!foreground) len += 0;
+  return len + 2;
+}
+
+inline int format_driver::palette_index(unsigned rgb) const {
+  unsigned r = (rgb >> 16) & 0xff;
+  unsigned g = (rgb >> 8) & 0xff;
+  unsigned b = rgb & 0xff;
+  int index = static_cast<int>((r * 3 + g * 5 + b * 2) / 10) % 256;
+  if (index < 16) index += 16;
+  return index;
+}
+
+inline int format_driver::write_reset_sgr(char* dst, int cap) const {
+  const char reset[] = "\x1b[0m";
+  int n = 0;
+  if (dst == nullptr || cap <= 0) return 0;
+  for (; reset[n] != '\0' && n < cap; ++n) dst[n] = reset[n];
+  return n;
+}
+
+inline unsigned format_driver::blend_style(unsigned other) {
+  term_style_ |= other;
+  rgb_ |= (other & 0xffffffu);
+  return term_style_;
+}
