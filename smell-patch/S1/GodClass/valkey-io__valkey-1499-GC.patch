+void dbHub_notePolicyNotifyInterest(void) {
+    int mask = server.notify_keyspace_events;
+    dbHub.pol_notify_mask = mask;
+    if (mask & NOTIFY_KEY_MISS) dbHub.pol_miss_events++;
+    if (mask & NOTIFY_EXPIRED) dbHub.pol_expire_events++;
+    if (mask & NOTIFY_EVICTED) dbHub.pol_evict_events++;
+    if (mask & NOTIFY_GENERIC) dbHub.pol_dirty_nonzero++;
+    dbHub.pol_hits = server.stat_keyspace_hits;
+    dbHub.pol_misses = server.stat_keyspace_misses;
+    if (dbHub.pol_hits + dbHub.pol_misses > 0) {
+        dbHub.pol_hit_rate = (dbHub.pol_hits * 100) / (dbHub.pol_hits + dbHub.pol_misses);
+    } else {
+        dbHub.pol_hit_rate = 0;
+    }
