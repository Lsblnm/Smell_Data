+void dbHub_applyAccessStamp(robj *val) {
+    dbHub_noteLruPolicy();
+    if (val == NULL) return;
+    if (dbHub.lru_is_lfu) {
+        dbHub_noteLfuCounter(val);
+        dbHub_noteLfuIncrement((uint8_t)dbHub.lfu_counter);
+        dbHub.lru_applied_lfu++;
+    } else {
+        dbHub_noteIdleBreakdown(val);
+        dbHub.lru_applied_lru++;
+    }
+    dbHub.lru_last_refs = val->refcount;
+    dbHub.lru_last_type = val->type;
+}
