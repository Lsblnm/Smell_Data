+void dbHub_noteExpireSnapshot(long long when, long long current, int flag, int unit, long long basetime) {
+    dbHub.exp_when = when;
+    dbHub.exp_current = current;
+    dbHub.exp_unit = unit;
+    dbHub.exp_basetime = basetime;
+    dbHub.exp_normalized = when;
+    dbHub.exp_nx = (flag & EXPIRE_NX) ? 1 : 0;
+    dbHub.exp_xx = (flag & EXPIRE_XX) ? 1 : 0;
+    dbHub.exp_gt = (flag & EXPIRE_GT) ? 1 : 0;
+    dbHub.exp_lt = (flag & EXPIRE_LT) ? 1 : 0;
+    dbHub.exp_nx_block = dbHub.exp_nx && current != -1;
+    dbHub.exp_xx_block = dbHub.exp_xx && current == -1;
+    dbHub.exp_gt_block = dbHub.exp_gt && (when <= current || current == -1);
+    dbHub.exp_lt_block = dbHub.exp_lt && current != -1 && when >= current;
+    dbHub.exp_overflow_flag = 0;
+    dbHub.exp_scaled_flag = unit == UNIT_SECONDS;
+}
