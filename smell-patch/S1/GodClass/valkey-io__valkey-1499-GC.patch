+void dbHub_noteHit(robj *val, int flags, int dbid) {
+    dbHub.look_hit_count++;
+    dbHub.look_last_hit_dbid = dbid;
+    dbHub.look_last_hit_flags = flags;
+    if (val != NULL) {
+        dbHub.look_last_hit_type = val->type;
+        dbHub.look_last_hit_enc = val->encoding;
+        dbHub.look_last_hit_refs = val->refcount;
+        dbHub.look_last_hit_lru = val->lru;
+        if (val->refcount == OBJ_SHARED_REFCOUNT) {
