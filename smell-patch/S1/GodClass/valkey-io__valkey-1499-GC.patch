+void dbHub_inspectLookupFlags(int flags) {
+    int notouch = 0;
+    int nonotify = 0;
+    int nostats = 0;
+    int writef = 0;
+    int noexpire = 0;
+    int none = 0;
+    if (flags & LOOKUP_NOTOUCH) {
+        notouch = 1;
+        dbHub.look_notouch_count++;
+    }
+    if (flags & LOOKUP_NONOTIFY) {
+        nonotify = 1;
+        dbHub.look_nonotify_count++;
+    }
+    if (flags & LOOKUP_NOSTATS) {
+        nostats = 1;
+        dbHub.look_nostats_count++;
+    }
+    if (flags & LOOKUP_WRITE) {
+        writef = 1;
+        dbHub.look_write_count++;
+    }
+    if (flags & LOOKUP_NOEXPIRE) {
+        noexpire = 1;
+        dbHub.look_noexpire_count++;
+    }
+    if (flags == LOOKUP_NONE) {
+        none = 1;
+        dbHub.look_none_count++;
+    }
+    dbHub.look_flags = flags;
+    dbHub.look_notouch = notouch;
+    dbHub.look_nonotify = nonotify;
+    dbHub.look_nostats = nostats;
+    dbHub.look_write = writef;
+    dbHub.look_noexpire = noexpire;
+    dbHub.look_none = none;
+}
+
+void dbHub_inspectClientTouchPolicy(void) {
+    int client_present = 0;
+    int no_touch = 0;
+    int cmd_is_touch = 0;
+    int exec_present = 0;
+    client *cur = server.current_client;
+    client *exec = server.executing_client;
+    if (cur != NULL) {
+        client_present = 1;
+        if (cur->flag.no_touch) no_touch = 1;
+        if (cur->cmd != NULL && cur->cmd->proc == touchCommand) cmd_is_touch = 1;
+        dbHub.look_client_id = cur->id;
+        dbHub.look_client_db = cur->db ? cur->db->id : -1;
+    } else {
+        dbHub.look_client_id = 0;
+        dbHub.look_client_db = -1;
+    }
+    if (exec != NULL) {
+        exec_present = 1;
+        dbHub.look_exec_id = exec->id;
+        if (exec->cmd != NULL && exec->cmd->proc == touchCommand) {
+            dbHub.look_exec_is_touch = 1;
+        } else {
+            dbHub.look_exec_is_touch = 0;
+        }
+    } else {
+        dbHub.look_exec_id = 0;
+        dbHub.look_exec_is_touch = 0;
+    }
+    dbHub.look_client_present = client_present;
+    dbHub.look_client_notouch = no_touch;
+    dbHub.look_cmd_is_touch = cmd_is_touch;
+    dbHub.look_exec_present = exec_present;
+}
+
+void dbHub_inspectReplicaExpirePolicy(serverDb *db) {
+    int ro_replica = 0;
+    int has_primary = 0;
+    int import_mode = 0;
+    int loading = 0;
+    int dbid = -1;
+    if (server.primary_host != NULL) {
+        has_primary = 1;
+        if (server.repl_replica_ro) ro_replica = 1;
+    }
+    if (server.import_mode) import_mode = 1;
+    if (server.loading) loading = 1;
+    if (db != NULL) {
+        dbid = db->id;
+        dbHub.look_db_avg_ttl = db->avg_ttl;
+        dbHub.look_db_expires_cursor = (long long)db->expires_cursor;
+    } else {
+        dbHub.look_db_avg_ttl = 0;
+        dbHub.look_db_expires_cursor = 0;
+    }
+    dbHub.look_ro_replica = ro_replica;
+    dbHub.look_has_primary = has_primary;
+    dbHub.look_import_mode = import_mode;
+    dbHub.look_loading = loading;
+    dbHub.look_dbid = dbid;
+}
+
+void dbHub_inspectChildCowPolicy(void) {
+    int child = 0;
+    int cow_block = 0;
+    if (hasActiveChildProcess()) {
+        child = 1;
+        cow_block = 1;
+        dbHub.look_child_blocked++;
+    } else {
+        dbHub.look_child_clear++;
+    }
+    dbHub.look_has_child = child;
+    dbHub.look_cow_block = cow_block;
+}
