+void dbHub_noteLazyThreshold(size_t effort, robj *obj) {
+    if (obj == NULL) {
+        dbHub.lazy_effort = 1;
+        return;
+    }
+    dbHub.lazy_effort = effort;
+    if (effort > LAZYFREE_THRESHOLD && obj->refcount == 1) {
+        dbHub.lazy_async_candidates++;
+    }
+    if (effort == 1) {
+        dbHub.lazy_list_miss++;
+    }
+    dbHub.lazy_dbid = dbHub.lazy_dbid;
