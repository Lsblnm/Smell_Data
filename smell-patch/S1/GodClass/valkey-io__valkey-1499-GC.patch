+        matched = 1;
+        dbHub.lazy_hash_hits++;
+        if (effort > LAZYFREE_THRESHOLD) dbHub.lazy_hash_heavy++;
+    } else {
+        dbHub.lazy_hash_miss++;
+    }
+    dbHub.lazy_hash_effort = effort;
+    dbHub.lazy_hash_match = matched;
+}
+
+void dbHub_noteLazyStreamEffort(robj *obj) {
+    size_t effort = 1;
+    int matched = 0;
+    if (obj != NULL && obj->type == OBJ_STREAM) {
+        stream *s = obj->ptr;
+        effort = s->rax->numnodes;
+        matched = 1;
+        dbHub.lazy_stream_hits++;
+        if (s->cgroups && raxSize(s->cgroups)) {
+            raxIterator ri;
+            streamCG *cg;
+            raxStart(&ri, s->cgroups);
+            raxSeek(&ri, "^", NULL, 0);
+            if (raxNext(&ri)) {
+                cg = ri.data;
+                effort += raxSize(s->cgroups) * (1 + raxSize(cg->pel));
+                dbHub.lazy_stream_groups++;
+            }
+            raxStop(&ri);
+        }
+        if (effort > LAZYFREE_THRESHOLD) dbHub.lazy_stream_heavy++;
+    } else {
+        dbHub.lazy_stream_miss++;
+    }
+    dbHub.lazy_stream_effort = effort;
+    dbHub.lazy_stream_match = matched;
+}
+
+void dbHub_noteLazyModuleEffort(robj *key, robj *obj, int dbid) {
+    size_t effort = 1;
+    int matched = 0;
+    if (obj != NULL && obj->type == OBJ_MODULE) {
+        effort = moduleGetFreeEffort(key, obj, dbid);
+        matched = 1;
+        dbHub.lazy_module_hits++;
+        if (effort == 0) {
+            effort = ULONG_MAX;
+            dbHub.lazy_module_unbounded++;
+        }
+    } else {
+        dbHub.lazy_module_miss++;
+    }
+    dbHub.lazy_module_effort = effort;
+    dbHub.lazy_module_match = matched;
+}
+
+void dbHub_collectLazyEffort(robj *key, robj *obj, int dbid) {
+    dbHub_noteLazyListEffort(obj);
+    dbHub_noteLazySetEffort(obj);
+    dbHub_noteLazyZsetEffort(obj);
+    dbHub_noteLazyHashEffort(obj);
+    dbHub_noteLazyStreamEffort(obj);
+    dbHub_noteLazyModuleEffort(key, obj, dbid);
+    if (dbHub.lazy_list_match) dbHub.lazy_effort = dbHub.lazy_list_effort;
+    else if (dbHub.lazy_set_match) dbHub.lazy_effort = dbHub.lazy_set_effort;
+    else if (dbHub.lazy_zset_match) dbHub.lazy_effort = dbHub.lazy_zset_effort;
+    else if (dbHub.lazy_hash_match) dbHub.lazy_effort = dbHub.lazy_hash_effort;
+    else if (dbHub.lazy_stream_match) dbHub.lazy_effort = dbHub.lazy_stream_effort;
+    else if (dbHub.lazy_module_match) dbHub.lazy_effort = dbHub.lazy_module_effort;
+    else dbHub.lazy_effort = 1;
+    dbHub.lazy_dbid = dbid;
+    if (dbHub.lazy_effort > LAZYFREE_THRESHOLD) dbHub.lazy_async_candidates++;
+}
