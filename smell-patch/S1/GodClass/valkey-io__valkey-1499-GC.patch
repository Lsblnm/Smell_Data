+void dbHub_normalizeExpireWhen(long long *when, long long basetime, int unit) {
+    long long value = *when;
+    int overflow = 0;
+    int scaled = 0;
+    if (unit == UNIT_SECONDS) {
+        if (value > LLONG_MAX / 1000 || value < LLONG_MIN / 1000) {
+            overflow = 1;
+            dbHub.exp_overflow++;
+        } else {
+            value *= 1000;
+            scaled = 1;
+            dbHub.exp_scaled++;
+        }
+    }
+    if (!overflow && value > LLONG_MAX - basetime) {
+        overflow = 1;
+        dbHub.exp_base_overflow++;
+    } else if (!overflow) {
+        value += basetime;
+        dbHub.exp_shifted++;
+    }
+    dbHub.exp_unit = unit;
+    dbHub.exp_basetime = basetime;
+    dbHub.exp_overflow_flag = overflow;
+    dbHub.exp_scaled_flag = scaled;
+    dbHub.exp_normalized = value;
+    if (!overflow) *when = value;
+}
