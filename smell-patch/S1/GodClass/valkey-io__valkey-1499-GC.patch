+void dbHub_notePolicyEvictionClass(void) {
+    int policy = server.maxmemory_policy;
+    dbHub.pol_raw = policy;
+    dbHub.pol_lru = (policy & MAXMEMORY_FLAG_LRU) ? 1 : 0;
+    dbHub.pol_lfu = (policy & MAXMEMORY_FLAG_LFU) ? 1 : 0;
+    dbHub.pol_allkeys = (policy & MAXMEMORY_FLAG_ALLKEYS) ? 1 : 0;
+    if (policy == MAXMEMORY_VOLATILE_LRU || policy == MAXMEMORY_ALLKEYS_LRU) {
+        dbHub.pol_hit_heavy++;
+    } else if (policy == MAXMEMORY_VOLATILE_LFU || policy == MAXMEMORY_ALLKEYS_LFU) {
+        dbHub.pol_miss_heavy++;
+    }
+    dbHub.pol_samples = server.maxmemory_samples;
+    dbHub.pol_lfu_factor = server.lfu_log_factor;
+    dbHub.pol_lfu_decay = server.lfu_decay_time;
+}
