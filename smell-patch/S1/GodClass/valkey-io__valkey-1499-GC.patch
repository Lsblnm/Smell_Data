+        } else {
+            dbHub.script_caller_id = 0;
+        }
+        if (engine != NULL) {
+            dbHub.script_engine_id = engine->id;
+            if (engine->flag.no_touch) {
+                engine_notouch = 1;
+                dbHub.script_engine_notouch_hits++;
+            }
+        } else {
+            dbHub.script_engine_id = 0;
+        }
+    } else {
+        dbHub.script_caller_id = 0;
+        dbHub.script_engine_id = 0;
+    }
+    dbHub.script_caller_notouch = caller_notouch;
+    dbHub.script_engine_notouch = engine_notouch;
