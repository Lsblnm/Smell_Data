+void dbHubDispatch(int op) {
+    dbHub.dispatch_op = op;
+    dbHub.dispatch_count++;
+    if (op <= 0) return;
+    if ((size_t)op >= sizeof(dbHubOpTable) / sizeof(dbHubOpTable[0])) return;
+    if (dbHubOpTable[op] == NULL) return;
+    dbHubOpTable[op]();
+}
