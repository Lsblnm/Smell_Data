+void dbHub_noteLookupSnapshot(serverDb *db, robj *key, robj *val, int flags) {
+    dbHub.look_flags = flags;
+    dbHub.look_dbid = -1;
+    dbHub.look_key_len = 0;
+    dbHub.look_key_enc = 0;
+    dbHub.look_val_type = -1;
+    dbHub.look_val_enc = -1;
+    dbHub.look_val_refs = 0;
+    dbHub.look_val_lru = 0;
+    dbHub.look_hit_pending = 0;
+    dbHub.look_db_avg_ttl = 0;
+    dbHub.look_db_expires_cursor = 0;
+    if (db != NULL) {
+        dbHub.look_dbid = db->id;
+        dbHub.look_db_avg_ttl = db->avg_ttl;
+        dbHub.look_db_expires_cursor = (long long)db->expires_cursor;
+    }
+    if (key != NULL) {
+        dbHub.look_key_len = sdslen(key->ptr);
+        dbHub.look_key_enc = key->encoding;
+    }
+    if (val != NULL) {
+        dbHub.look_val_type = val->type;
+        dbHub.look_val_enc = val->encoding;
+        dbHub.look_val_refs = val->refcount;
+        dbHub.look_val_lru = val->lru;
+        dbHub.look_hit_pending = 1;
+    }
+    dbHub.look_bind_count++;
+    dbHub.look_last_hit_dbid = dbHub.look_dbid;
+    dbHub.look_last_miss_dbid = dbHub.look_dbid;
+    dbHub.look_client_db = dbHub.look_dbid;
+}
