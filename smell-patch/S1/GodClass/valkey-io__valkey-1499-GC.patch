+void dbHub_noteTtlProjection(long long expire, int output_ms, int output_abs) {
+    long long ttl = -1;
+    int missing = 0;
+    int persistent = 0;
+    int clamped = 0;
+    if (expire == -1) {
+        persistent = 1;
+        dbHub.exp_ttl_persistent++;
+    } else {
+        ttl = output_abs ? expire : expire - commandTimeSnapshot();
+        if (ttl < 0) {
+            ttl = 0;
+            clamped = 1;
+            dbHub.exp_ttl_clamped++;
+        }
+        dbHub.exp_ttl_live++;
+    }
+    if (output_ms) {
+        dbHub.exp_ttl_ms++;
+    } else {
+        dbHub.exp_ttl_sec++;
+        if (ttl >= 0) ttl = (ttl + 500) / 1000;
+    }
+    if (output_abs) dbHub.exp_ttl_abs++;
+    dbHub.exp_ttl_missing = missing;
+    dbHub.exp_ttl_persistent_flag = persistent;
+    dbHub.exp_ttl_clamped_flag = clamped;
+    dbHub.exp_ttl_value = ttl;
+}
