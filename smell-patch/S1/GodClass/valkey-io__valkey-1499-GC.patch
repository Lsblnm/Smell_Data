+void dbHub_noteLookupWritePath(int flags) {
+    int writef = (flags & LOOKUP_WRITE) ? 1 : 0;
+    int expire_avoid = 0;
+    if (writef && !dbHub.look_ro_replica) {
+        dbHub.look_write_count++;
+    }
+    if (flags & LOOKUP_NOEXPIRE) {
+        expire_avoid = 1;
+        dbHub.look_noexpire_count++;
+    }
+    if (writef && expire_avoid) {
+        dbHub.look_silent_hits++;
+    }
+    if (!writef && (flags & LOOKUP_NOTOUCH)) {
+        dbHub.look_notouch_count++;
+    }
+    dbHub.look_write = writef;
+    dbHub.look_noexpire = expire_avoid;
+    dbHub.look_flags = flags | dbHub.look_flags;
+}
+
+void dbHub_noteLookupStatsPath(int flags, int hit) {
+    if (hit) {
+        if (!(flags & (LOOKUP_NOSTATS | LOOKUP_WRITE))) {
+            dbHub.look_stats_hits++;
+        } else {
+            dbHub.look_silent_hits++;
+        }
+        dbHub.look_hit_count++;
+    } else {
+        if (!(flags & (LOOKUP_NOSTATS | LOOKUP_WRITE))) {
+            dbHub.look_stats_misses++;
+        }
+        if (!(flags & (LOOKUP_NONOTIFY | LOOKUP_WRITE))) {
+            dbHub.look_notified_misses++;
+        } else {
+            dbHub.look_silent_misses++;
+        }
+        dbHub.look_miss_count++;
+    }
+}
