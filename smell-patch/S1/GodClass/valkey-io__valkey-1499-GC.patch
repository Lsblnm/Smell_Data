+void dbHub_noteLruClockSource(void) {
+    int hz = server.hz;
+    unsigned int clock;
+    if (hz > 0 && 1000 / hz <= LRU_CLOCK_RESOLUTION) {
+        clock = server.lruclock;
+        dbHub.lru_clock_cached++;
+    } else {
+        clock = (mstime() / LRU_CLOCK_RESOLUTION) & LRU_CLOCK_MAX;
+        dbHub.lru_clock_fresh++;
+    }
+    dbHub.lru_clock = clock;
+    dbHub.lru_policy = server.maxmemory_policy;
+    if (server.maxmemory_policy & MAXMEMORY_FLAG_LRU) dbHub.lru_is_lru = 1;
+    if (server.maxmemory_policy & MAXMEMORY_FLAG_LFU) dbHub.lru_is_lfu = 1;
+}
