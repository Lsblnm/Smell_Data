+void dbHub_captureAccessContext(serverDb *db, robj *key, robj *val, int flags) {
+    dbHub_noteLookupSnapshot(db, key, val, flags);
+    dbHub_noteObjectSnapshot(val);
+    dbHub_noteLruSnapshot(val);
+    dbHub_notePolicySnapshotValues();
+    dbHub_noteScriptSnapshot();
+    dbHub_noteNotifySnapshot(flags, db ? db->id : -1);
+    dbHub_noteLazySnapshot(val, db ? db->id : -1, 1);
+    dbHub_noteExpireSnapshot(0, -1, 0, UNIT_MILLISECONDS, 0);
+}
