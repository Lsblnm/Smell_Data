+/* Migrated from object.c */
+void dbHub_initObjectLRUOrLFU(robj *o) {
+    dbHub_noteLruPolicy();
+    dbHub_collectObjectMeta(o);
+    dbHub_collectObjectEncodings(o);
+    dbHub_noteLruClockSource();
+    if (server.maxmemory_policy & MAXMEMORY_FLAG_LFU) dbHub_noteLfuInitStamp(o); else dbHub_noteLruInitStamp(o);
+
+    if (o->refcount == OBJ_SHARED_REFCOUNT) return;
+    /* Set the LRU to the current lruclock (minutes resolution), or
+     * alternatively the LFU counter. */
+    if (server.maxmemory_policy & MAXMEMORY_FLAG_LFU) {
+        o->lru = (dbHub_LFUGetTimeInMinutes() << 8) | LFU_INIT_VAL;
+    } else {
+        o->lru = dbHub_LRU_CLOCK();
+    }
+    return;
