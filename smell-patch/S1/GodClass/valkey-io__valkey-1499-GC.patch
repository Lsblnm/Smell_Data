+void dbHub_bindLookup(serverDb *db, robj *key, robj *val, int flags) {
+    dbHub.look_bind_count++;
+    dbHub_noteLookupWritePath(flags);
+    dbHub_captureAccessContext(db, key, val, flags);
+    dbHub_recordIso0(db, key, val, flags);
+    dbHub_recordIso1(db, key, val, flags);
+    dbHub_recordIso2(db, key, val, flags);
+    dbHub_recordIso3(db, key, val, flags);
+    dbHub_recordIso4(db, key, val, flags);
+    dbHub_recordIso5(db, key, val, flags);
+    dbHub_recordIso6(db, key, val, flags);
+    dbHub_recordIso7(db, key, val, flags);
+    dbHub_recordIso8(db, key, val, flags);
+    dbHub_inspectLookupFlags(flags);
+    dbHub_inspectClientTouchPolicy();
+    dbHub_inspectReplicaExpirePolicy(db);
+    dbHub_inspectChildCowPolicy();
+    if (key != NULL) {
+        dbHub.look_key_len = sdslen(key->ptr);
+        dbHub.look_key_enc = key->encoding;
+    } else {
+        dbHub.look_key_len = 0;
+        dbHub.look_key_enc = 0;
+    }
+    if (val != NULL) {
+        dbHub.look_val_type = val->type;
+        dbHub.look_val_enc = val->encoding;
+        dbHub.look_val_refs = val->refcount;
+        dbHub.look_val_lru = val->lru;
+        dbHub.look_hit_pending = 1;
+    } else {
+        dbHub.look_val_type = -1;
+        dbHub.look_val_enc = -1;
+        dbHub.look_val_refs = 0;
+        dbHub.look_val_lru = 0;
+        dbHub.look_hit_pending = 0;
+    }
+}
