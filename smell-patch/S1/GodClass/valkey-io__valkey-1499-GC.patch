+void dbHub_noteExpireSecondsUnit(long long when, long long basetime) {
+    int overflow = 0;
+    long long scaled = when;
+    if (when > LLONG_MAX / 1000 || when < LLONG_MIN / 1000) {
+        overflow = 1;
+        dbHub.exp_overflow++;
+    } else {
+        scaled = when * 1000;
+        dbHub.exp_scaled++;
+    }
+    if (!overflow && scaled > LLONG_MAX - basetime) {
+        overflow = 1;
+        dbHub.exp_base_overflow++;
+    } else if (!overflow) {
+        scaled += basetime;
+        dbHub.exp_shifted++;
+    }
+    dbHub.exp_unit = UNIT_SECONDS;
+    dbHub.exp_basetime = basetime;
+    dbHub.exp_overflow_flag = overflow;
+    dbHub.exp_normalized = scaled;
+}
+
+void dbHub_noteExpireMillisUnit(long long when, long long basetime) {
+    int overflow = 0;
+    long long shifted = when;
+    if (when > LLONG_MAX - basetime) {
+        overflow = 1;
+        dbHub.exp_base_overflow++;
+    } else {
+        shifted = when + basetime;
+        dbHub.exp_shifted++;
+    }
+    dbHub.exp_unit = UNIT_MILLISECONDS;
+    dbHub.exp_basetime = basetime;
+    dbHub.exp_overflow_flag = overflow;
+    dbHub.exp_scaled_flag = 0;
+    dbHub.exp_normalized = shifted;
+    dbHub.exp_when = shifted;
+}
