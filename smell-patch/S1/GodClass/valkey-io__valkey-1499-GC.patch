+    if (dbHub.notify_evicted_configured) life |= NOTIFY_EVICTED;
+    if (dbHub.notify_new_configured) life |= NOTIFY_NEW;
+    if (dbHub.notify_keymiss_configured) life |= NOTIFY_KEY_MISS;
+    if (dbHub.notify_module_configured) life |= NOTIFY_MODULE;
+    hits += dbHub.notify_generic_hits;
+    hits += dbHub.notify_expired_hits;
+    hits += dbHub.notify_evicted_hits;
+    hits += dbHub.notify_new_hits;
+    hits += dbHub.notify_keymiss_hits;
+    hits += dbHub.notify_module_hits;
+    if (life) dbHub.notify_enabled_mask |= life;
+    if (hits > 0) dbHub.notify_generic_mix += hits;
+    dbHub.notify_expired_mix += (life & NOTIFY_EXPIRED) ? 1 : 0;
+    dbHub.notify_evicted_mix += (life & NOTIFY_EVICTED) ? 1 : 0;
+    dbHub.notify_new_mix += (life & NOTIFY_NEW) ? 1 : 0;
