+void dbHub_noteLfuInitStamp(robj *o) {
+    unsigned long minutes = dbHub_LFUGetTimeInMinutes();
+    unsigned int stamp = (minutes << 8) | LFU_INIT_VAL;
+    dbHub.lfu_ldt = minutes;
+    dbHub.lfu_counter = LFU_INIT_VAL;
+    dbHub.lru_applied_lfu++;
+    if (o != NULL && o->refcount != OBJ_SHARED_REFCOUNT) {
+        dbHub.lru_last_refs = o->refcount;
+        dbHub.lru_last_type = o->type;
+        dbHub.lru_obj_lru = stamp;
+    }
+}
+
+void dbHub_noteLruInitStamp(robj *o) {
+    unsigned int clock = dbHub_LRU_CLOCK();
+    dbHub.lru_clock = clock;
+    dbHub.lru_applied_lru++;
+    if (o != NULL) {
+        dbHub.lru_obj_lru = clock;
+        dbHub.lru_last_refs = o->refcount;
+        dbHub.lru_last_type = o->type;
+        if (clock >= o->lru) {
+            dbHub.lru_idle_ms = (unsigned long long)(clock - o->lru) * LRU_CLOCK_RESOLUTION;
+            dbHub.lru_idle_wrapped = 0;
+        } else {
+            dbHub.lru_idle_ms = (unsigned long long)(clock + (LRU_CLOCK_MAX - o->lru)) * LRU_CLOCK_RESOLUTION;
+            dbHub.lru_idle_wrapped = 1;
+            dbHub.lru_wrap_count++;
+        }
+        dbHub.lru_idle_seconds = dbHub.lru_idle_ms / 1000;
+    }
+}
