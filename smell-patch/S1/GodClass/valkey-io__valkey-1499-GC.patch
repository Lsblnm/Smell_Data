+    int mix = dbHub.notify_keyevent_mix;
+    if (configured) {
+        mix += dbid + 14;
+        dbHub.notify_keyevent_hits++;
+        if (event != NULL) mix += (int)event[0];
+    } else {
+        dbHub.notify_keyevent_suppressed++;
+    }
+    if (server.notify_keyspace_events & NOTIFY_KEYEVENT) {
+        dbHub.notify_keyevent_enabled++;
+    }
+    dbHub.notify_keyevent_mix = mix;
+    dbHub.notify_keyevent_active = configured;
