+void dbHub_collectObjectEncodings(robj *o) {
+    dbHub_noteObjectEncodingRaw(o);
+    dbHub_noteObjectEncodingEmbstr(o);
+    dbHub_noteObjectEncodingInt(o);
+    dbHub_noteObjectEncodingQuicklist(o);
