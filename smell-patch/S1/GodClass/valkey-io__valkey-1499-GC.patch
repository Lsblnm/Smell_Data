+    }
+    if (removed) {
+        dbHub.exp_ttl_live++;
+        dbHub.exp_ttl_persistent_flag = 0;
+    } else {
+        dbHub.exp_ttl_persistent++;
+        dbHub.exp_ttl_persistent_flag = 1;
+    }
+    dbHub.exp_touch_hit = existed;
+}
