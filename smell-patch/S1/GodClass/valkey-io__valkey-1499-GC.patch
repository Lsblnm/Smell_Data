+    dbHub.notify_generic_mix = type & 0xff;
+    dbHub.notify_string_mix = dbid;
+    dbHub.notify_list_mix = dbHub.notify_enabled_mask & 0xff;
+    dbHub.notify_set_mix = dbHub.notify_generic_mix ^ dbid;
+    dbHub.notify_hash_mix = dbHub.notify_list_mix + dbid;
+    dbHub.notify_zset_mix = type >> 1;
+    dbHub.notify_expired_mix = type >> 2;
+    dbHub.notify_evicted_mix = type >> 3;
+    dbHub.notify_keyspace_mix = dbid + 11;
+    dbHub.notify_keyevent_mix = dbid + 14;
+}
