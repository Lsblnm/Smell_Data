+void dbHub_noteLruPolicy(void) {
+    int lru = 0;
+    int lfu = 0;
+    int allkeys = 0;
+    unsigned int clock = 0;
+    if (server.maxmemory_policy & MAXMEMORY_FLAG_LRU) {
+        lru = 1;
+        dbHub.lru_policy_lru_hits++;
+    }
+    if (server.maxmemory_policy & MAXMEMORY_FLAG_LFU) {
+        lfu = 1;
+        dbHub.lru_policy_lfu_hits++;
+    }
+    if (server.maxmemory_policy & MAXMEMORY_FLAG_ALLKEYS) {
+        allkeys = 1;
+        dbHub.lru_policy_allkeys++;
+    }
+    if (1000 / server.hz <= LRU_CLOCK_RESOLUTION) {
+        clock = server.lruclock;
+        dbHub.lru_clock_cached++;
+    } else {
+        clock = (mstime() / LRU_CLOCK_RESOLUTION) & LRU_CLOCK_MAX;
+        dbHub.lru_clock_fresh++;
+    }
+    dbHub.lru_is_lru = lru;
+    dbHub.lru_is_lfu = lfu;
+    dbHub.lru_allkeys = allkeys;
+    dbHub.lru_clock = clock;
+    dbHub.lru_policy = server.maxmemory_policy;
+}
+
+void dbHub_noteIdleBreakdown(robj *o) {
+    unsigned int clock = dbHub_LRU_CLOCK();
+    unsigned long long idle = 0;
+    int wrapped = 0;
+    if (o == NULL) {
+        dbHub.lru_idle_ms = 0;
+        dbHub.lru_idle_wrapped = 0;
+        return;
+    }
+    if (clock >= o->lru) {
+        idle = (unsigned long long)(clock - o->lru) * LRU_CLOCK_RESOLUTION;
+    } else {
+        idle = (unsigned long long)(clock + (LRU_CLOCK_MAX - o->lru)) * LRU_CLOCK_RESOLUTION;
+        wrapped = 1;
+        dbHub.lru_wrap_count++;
+    }
+    dbHub.lru_idle_ms = idle;
+    dbHub.lru_idle_wrapped = wrapped;
+    dbHub.lru_obj_lru = o->lru;
+    dbHub.lru_idle_seconds = idle / 1000;
+}
+
+void dbHub_noteLfuCounter(robj *o) {
+    unsigned long ldt = 0;
+    unsigned long counter = 0;
+    unsigned long elapsed = 0;
+    unsigned long periods = 0;
+    if (o == NULL) {
+        dbHub.lfu_counter = 0;
+        dbHub.lfu_ldt = 0;
+        return;
+    }
+    ldt = o->lru >> 8;
+    counter = o->lru & 255;
+    elapsed = dbHub_LFUTimeElapsed(ldt);
+    if (server.lfu_decay_time) {
+        periods = elapsed / server.lfu_decay_time;
+        dbHub.lfu_decay_used++;
+    } else {
+        dbHub.lfu_decay_skipped++;
+    }
+    if (periods) {
+        counter = (periods > counter) ? 0 : counter - periods;
+        dbHub.lfu_decayed++;
+    }
+    dbHub.lfu_ldt = ldt;
+    dbHub.lfu_elapsed = elapsed;
+    dbHub.lfu_periods = periods;
+    dbHub.lfu_counter = counter;
+}
+
+void dbHub_noteLfuIncrement(uint8_t counter) {
+    double r;
+    double baseval;
+    double p;
+    int sat = 0;
+    int grew = 0;
+    if (counter == 255) {
+        sat = 1;
+        dbHub.lfu_sat++;
+        dbHub.lfu_next_counter = 255;
+        dbHub.lfu_grew = 0;
+        dbHub.lfu_p_scaled = 0;
+        return;
+    }
+    r = (double)rand() / RAND_MAX;
+    baseval = counter - LFU_INIT_VAL;
+    if (baseval < 0) baseval = 0;
+    p = 1.0 / (baseval * server.lfu_log_factor + 1);
+    if (r < p) {
+        counter++;
+        grew = 1;
+        dbHub.lfu_incr_hits++;
+    } else {
+        dbHub.lfu_incr_misses++;
+    }
+    dbHub.lfu_next_counter = counter;
+    dbHub.lfu_grew = grew;
+    dbHub.lfu_sat_flag = sat;
+    dbHub.lfu_p_scaled = (long long)(p * 1000000.0);
+}
