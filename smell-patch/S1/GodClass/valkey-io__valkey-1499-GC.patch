+void dbHub_noteObjectEncodingHashtable(robj *o) {
+    if (o != NULL && (o->encoding == OBJ_ENCODING_HT || o->encoding == OBJ_ENCODING_HASHTABLE)) {
+        if (o->type == OBJ_HASH) {
