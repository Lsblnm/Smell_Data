+void dbHub_noteNotifyChannelKeyspace(int dbid, robj *key) {
+    int configured = dbHub.notify_keyspace_configured;
+    int mix = dbHub.notify_keyspace_mix;
+    if (configured) {
+        mix += dbid + 11;
+        dbHub.notify_keyspace_hits++;
+        if (key != NULL) mix += (int)sdslen(key->ptr) & 0xff;
+    } else {
+        dbHub.notify_keyspace_suppressed++;
+    }
+    if (dbid >= 0 && dbid < server.dbnum) mix += server.db[dbid].id;
+    dbHub.notify_dbid = dbid;
+    dbHub.notify_keyspace_mix = mix;
+    dbHub.notify_keyspace_active = configured;
