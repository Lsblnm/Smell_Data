+void dbHub_noteScriptEvalCompat(void) {
+    scriptRunCtx *ctx = scriptCurrentRunCtx();
+    if (ctx == NULL) {
+        dbHub.script_idle++;
+        dbHub.script_running = 0;
+        return;
+    }
+    dbHub.script_running = 1;
+    dbHub.script_flags = ctx->flags;
+    if (ctx->flags & SCRIPT_EVAL_MODE) {
+        dbHub.script_is_eval = 1;
+        dbHub.script_eval_mode++;
+    } else {
+        dbHub.script_is_eval = 0;
+    }
+    if (ctx->flags & SCRIPT_TIMEDOUT) {
+        dbHub.script_is_timedout = 1;
+        dbHub.script_timedout++;
+    }
+    dbHub.script_start = ctx->start_time;
+    dbHub.script_repl = ctx->repl_flags;
+}
+
+void dbHub_noteScriptNoTouchDivergence(void) {
+    client *exec = server.executing_client;
+    client *cur = server.current_client;
+    int diverge = (exec != cur);
+    dbHub.script_clients_diverge = diverge;
+    if (diverge) dbHub.script_client_diverge++;
+    dbHub.script_exec_id = exec ? exec->id : 0;
+    dbHub.script_cur_id = cur ? cur->id : 0;
+    dbHub.script_exec_touch = (exec && exec->cmd && exec->cmd->proc == touchCommand);
+    dbHub.script_cur_touch = (cur && cur->cmd && cur->cmd->proc == touchCommand);
+    if (dbHub.script_exec_touch || (!dbHub.script_running && dbHub.script_cur_touch)) {
+        dbHub.script_touch_allowed = 1;
+        dbHub.script_allow_touch++;
+    } else {
+        dbHub.script_touch_allowed = 0;
+        dbHub.script_deny_touch++;
+    }
+}
