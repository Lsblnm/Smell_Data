+    } else if (!strcasecmp(c->argv[1]->ptr, "refcount")) {
+        kind = 2;
+        dbHub.obj_cmd_refcount++;
+    } else if (!strcasecmp(c->argv[1]->ptr, "encoding")) {
+        kind = 3;
+        dbHub.obj_cmd_encoding++;
+    } else if (!strcasecmp(c->argv[1]->ptr, "idletime")) {
+        kind = 4;
