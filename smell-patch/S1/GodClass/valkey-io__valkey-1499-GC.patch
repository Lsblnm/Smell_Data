+    dbHub.notify_keyspace_mix = mix;
+    dbHub.notify_keyevent_mix = mix ^ ks;
+    dbHub.notify_type |= (ks ? NOTIFY_KEYSPACE : 0) | (ke ? NOTIFY_KEYEVENT : 0);
