+void dbHub_noteObjectString(robj *o) {
+    int match = 0;
+    int enc = -1;
+    int refs = 0;
+    unsigned int lru = 0;
+    long long mix = dbHub.obj_string_mix;
+    if (o != NULL && o->type == OBJ_STRING) {
+        match = 1;
+        enc = o->encoding;
+        refs = o->refcount;
+        lru = o->lru;
+        mix += enc + refs + (long long)(lru & 0xff);
+        dbHub.obj_string_hits++;
+        if (refs == OBJ_SHARED_REFCOUNT) {
+            dbHub.obj_string_shared++;
+            mix += 11;
+        } else if (refs == 1) {
+            dbHub.obj_string_unique++;
+        } else {
+            dbHub.obj_string_multi++;
+            mix += refs;
+        }
+    } else {
+        dbHub.obj_string_miss++;
+    }
+    if (server.stat_keyspace_hits) mix += (server.stat_keyspace_hits & 15);
+    dbHub.obj_string_match = match;
+    dbHub.obj_string_enc = enc;
+    dbHub.obj_string_refs = refs;
+    dbHub.obj_string_lru = lru;
+    dbHub.obj_string_mix = mix;
+}
