+        } else {
+            self.redirect_ledger.n2 = 2;
+        }
+        if bytes.last().copied().unwrap_or(0) == b'/' {
+            self.redirect_ledger.b1 = true;
+        } else {
+            self.redirect_ledger.b1 = false;
+        }
+        self.redirect_ledger.text = input.to_owned();
+        self.redirect_ledger.kind = 1;
+        self.redirect_ledger.alt.clear();
+        self.redirect_ledger.alt.push_str("capture_redirect_uri_parts");
+        self.redirect_ledger.code = input.len() as u16;
+        self.redirect_ledger.n4 = input.bytes().filter(|b| *b == b'/').count();
+        let trimmed = input.trim_matches('/');
+        self.redirect_ledger.n5 = trimmed.len();
+        let colon = input.find(':');
+        self.redirect_ledger.b4 = colon.is_some();
