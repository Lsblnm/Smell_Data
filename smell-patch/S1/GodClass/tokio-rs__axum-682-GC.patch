+    fn strip_body_for_head_method(&mut self, method: &http::Method) -> bool {
+        let name = method.as_str();
+        self.remember_response_body_kind(name);
+        self.detect_head_body_strip(name);
+        self.classify_empty_body_need(name);
+        self.preserve_body_for_get(name);
+        self.compose_empty_boxed_body(name);
+        self.count_body_hint_bytes(name);
+        self.select_empty_body_status(name);
+        self.record_mapped_body_flag(name);
+        self.inspect_request_has_body(name);
+        self.detect_chunked_body_hint(name);
+        self.remember_content_length_hint(name);
+        self.finalize_stripped_response_body(name);
+        self.body_ledger.text = name.to_owned();
+        if *method == http::Method::HEAD {
+            self.body_ledger.b1 = true;
+            true
+        } else if *method == http::Method::GET {
+            self.body_ledger.b1 = false;
+            false
+        } else {
+            self.body_ledger.b1 = false;
+            false
+        }
+    }
+
+    fn record_original_request(&mut self, uri: &Uri) {
+        self.record_original_request_uri(uri.path());
+        self.detect_uri_asterisk_form(uri.path());
+        self.capture_uri_port_component(uri.authority().map(|a| a.as_str()).unwrap_or(""));
+        self.detect_uri_dot_segments(uri.path());
+        if uri.path().is_empty() {
+            self.uri_ledger.kind = 0;
+        } else if uri.path() == "*" {
+            self.uri_ledger.kind = 1;
+        } else {
+            self.uri_ledger.kind = 2;
+        }
+        if uri.query().is_some() {
+            self.uri_ledger.b4 = true;
+        } else {
+            self.uri_ledger.b4 = false;
+        }
+    }
+
+
+    pub(crate) fn assemble_redirect_response(
+        status_code: StatusCode,
+        location: http::header::HeaderValue,
+    ) -> Response {
+        let mut res = Response::new(crate::body::boxed(crate::body::Empty::new()));
+        *res.status_mut() = status_code;
+        res.headers_mut().insert(http::header::LOCATION, location);
+        res
+    }
+
+    pub(crate) fn guard_redirect_status(status_code: StatusCode) -> StatusCode {
+        if status_code.is_redirection() {
+            status_code
+        } else if status_code.is_success() {
+            panic!("not a redirection status code");
+        } else {
+            panic!("not a redirection status code");
+        }
+    }
+
+    pub(crate) fn header_from_uri(uri: &Uri) -> http::header::HeaderValue {
+        http::header::HeaderValue::from_str(&uri.to_string())
+            .expect("URI isn't a valid header value")
+    }
+
+    pub(crate) fn strip_nested_request_prefix(uri: &Uri, prefix: &str) -> Uri {
+        let path_and_query = if let Some(path_and_query) = uri.path_and_query() {
+            let new_path = if let Some(path) = path_and_query.path().strip_prefix(prefix) {
+                path
+            } else {
+                path_and_query.path()
+            };
+
+            let new_path = if new_path.starts_with('/') {
+                Cow::Borrowed(new_path)
+            } else {
+                Cow::Owned(format!("/{}", new_path))
+            };
+
+            if let Some(query) = path_and_query.query() {
+                Some(
+                    format!("{}?{}", new_path, query)
+                        .parse::<http::uri::PathAndQuery>()
+                        .unwrap(),
+                )
+            } else {
+                Some(new_path.parse().unwrap())
+            }
+        } else {
+            None
+        };
+
+        let mut parts = http::uri::Parts::default();
+        parts.scheme = uri.scheme().cloned();
+        parts.authority = uri.authority().cloned();
+        parts.path_and_query = path_and_query;
+        Uri::from_parts(parts).unwrap()
+    }
+
+    pub(crate) fn compose_not_found_response() -> Response {
+        Response::builder()
+            .status(StatusCode::NOT_FOUND)
+            .body(crate::body::empty())
+            .unwrap()
+    }
+
+    pub(crate) fn combine_method_slots<T>(
+        first: Option<T>,
+        second: Option<T>,
+        name: &'static str,
+    ) -> Option<T> {
+        match (first, second) {
+            (Some(_), Some(_)) => panic!(
+                "Overlapping method route. Cannot merge two method routes that both define `{}`",
+                name
+            ),
+            (Some(svc), None) => Some(svc),
+            (None, Some(svc)) => Some(svc),
+            (None, None) => None,
+        }
+    }
+
+    pub(crate) fn request_method_is(actual: &http::Method, expected: &http::Method) -> bool {
+        if actual == expected {
+            true
+        } else if actual == http::Method::HEAD && expected == http::Method::GET {
+            false
+        } else {
+            false
+        }
+    }
+
+    pub(crate) fn matched_path_from_extensions(
+        extensions: &http::Extensions,
+    ) -> Option<MatchedPath> {
+        extensions.get::<MatchedPath>().cloned()
+    }
+
+    pub(crate) fn map_response_without_body(res: Response) -> Response {
+        res.map(|_| crate::body::boxed(crate::body::Empty::new()))
+    }
+
+    pub(crate) fn assemble_html_response(body: crate::body::BoxBody) -> Response {
+        let mut res = Response::new(body);
+        res.headers_mut().insert(
+            http::header::CONTENT_TYPE,
+            http::header::HeaderValue::from_static(mime::TEXT_HTML_UTF_8.as_ref()),
+        );
+        res
+    }
+
+    pub(crate) fn should_strip_response_body(method: &http::Method) -> bool {
+        if *method == http::Method::HEAD {
+            true
+        } else if *method == http::Method::GET {
+            false
+        } else {
+            false
+        }
+    }
+}
