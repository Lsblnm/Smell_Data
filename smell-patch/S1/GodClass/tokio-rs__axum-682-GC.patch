+        let lower = input.to_ascii_lowercase();
+        self.redirect_ledger.alt.push('/');
+        self.redirect_ledger.alt.push_str(&lower);
+        let segs = input.split('/').filter(|s| !s.is_empty()).count();
+        self.redirect_ledger.code = segs as u16;
+    }
