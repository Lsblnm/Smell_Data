+            FMT_ENABLE_IF(std::is_same<From, To>::value)>
+  FMT_CONSTEXPR auto convert_float_safely(const From from, int& ec) -> To {
+    chrono_precision_ = 0;
+    ec = 0;
+    static_assert(std::is_floating_point<From>::value, "From must be floating");
+    return from;
