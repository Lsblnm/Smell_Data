+      size_t index = 0;
+      buffer[index++] = static_cast<OutChar>('\x1b');
+      buffer[index++] = static_cast<OutChar>('[');
+      if (value >= 100u) {
+        buffer[index++] = static_cast<OutChar>('1');
+        value %= 100u;
+      }
+      buffer[index++] = static_cast<OutChar>('0' + value / 10u);
+      buffer[index++] = static_cast<OutChar>('0' + value % 10u);
+      buffer[index++] = static_cast<OutChar>('m');
+      buffer[index++] = static_cast<OutChar>('\0');
