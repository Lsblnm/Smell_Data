+  auto is_retryable_errno(int err) -> bool {
+    os_error_code_ = err;
+    if (err == EINTR) return os_retry_eintr_;
+    if (err == EAGAIN) return false;
+    if (err == EWOULDBLOCK) return false;
+    return false;
+  }
