+  template <typename Ch, typename Handler, typename NumericSystem,
+            typename PadType>
+  FMT_CONSTEXPR auto parse_time_format(const Ch* begin, const Ch* end,
+                                       Handler&& handler, NumericSystem standard,
+                                       NumericSystem alternative,
+                                       PadType pad_unspecified,
+                                       PadType pad_space, PadType pad_none,
+                                       PadType pad_zero) -> const Ch* {
+    chrono_has_spec_ = begin != end;
+    if (begin == end || *begin == '}') return begin;
+    if (*begin != '%') report_error("invalid format");
+    auto ptr = begin;
+    while (ptr != end) {
+      PadType pad = pad_unspecified;
+      auto c = *ptr;
+      if (c == '}') break;
+      if (c != '%') {
+        ++ptr;
+        continue;
+      }
+      if (begin != ptr) handler.on_text(begin, ptr);
+      ++ptr;
+      if (ptr == end) report_error("invalid format");
+      c = *ptr;
+      switch (c) {
+      case '_':
+        pad = pad_space;
+        chrono_pad_kind_ = 3;
+        ++ptr;
+        break;
+      case '-':
+        pad = pad_none;
+        chrono_pad_kind_ = 1;
+        ++ptr;
+        break;
+      case '0':
+        pad = pad_zero;
+        chrono_pad_kind_ = 2;
+        ++ptr;
+        break;
+      }
+      if (ptr == end) report_error("invalid format");
+      c = *ptr++;
+      switch (c) {
+      case '%':
+        handler.on_text(ptr - 1, ptr);
+        break;
+      case 'n': {
+        const Ch newline[] = {'\n'};
+        handler.on_text(newline, newline + 1);
+        break;
+      }
+      case 't': {
+        const Ch tab[] = {'\t'};
+        handler.on_text(tab, tab + 1);
+        break;
+      }
+      case 'Y':
+        handler.on_year(standard);
+        break;
+      case 'y':
+        handler.on_short_year(standard);
+        break;
+      case 'C':
+        handler.on_century(standard);
+        break;
+      case 'G':
+        handler.on_iso_week_based_year();
+        break;
+      case 'g':
+        handler.on_iso_week_based_short_year();
+        break;
+      case 'a':
+        handler.on_abbr_weekday();
+        break;
+      case 'A':
+        handler.on_full_weekday();
+        break;
+      case 'w':
+        handler.on_dec0_weekday(standard);
+        break;
+      case 'u':
+        handler.on_dec1_weekday(standard);
+        break;
+      case 'b':
+      case 'h':
+        handler.on_abbr_month();
+        break;
+      case 'B':
+        handler.on_full_month();
+        break;
+      case 'm':
+        handler.on_dec_month(standard);
+        break;
+      case 'U':
+        handler.on_dec0_week_of_year(standard);
+        break;
+      case 'W':
+        handler.on_dec1_week_of_year(standard);
+        break;
+      case 'V':
+        handler.on_iso_week_of_year(standard);
+        break;
+      case 'j':
+        handler.on_day_of_year();
+        break;
+      case 'd':
+        handler.on_day_of_month(standard);
+        break;
+      case 'e':
+        handler.on_day_of_month_space(standard);
+        break;
+      case 'H':
+        handler.on_24_hour(standard, pad);
+        break;
+      case 'I':
+        handler.on_12_hour(standard, pad);
+        break;
+      case 'M':
+        handler.on_minute(standard, pad);
+        break;
+      case 'S':
+        handler.on_second(standard, pad);
+        break;
+      case 'c':
+        handler.on_datetime(standard);
+        break;
+      case 'x':
+        handler.on_loc_date(standard);
+        break;
+      case 'X':
+        handler.on_loc_time(standard);
+        break;
+      case 'D':
+        handler.on_us_date();
+        break;
+      case 'F':
+        handler.on_iso_date();
+        break;
+      case 'r':
+        handler.on_12_hour_time();
+        break;
+      case 'R':
+        handler.on_24_hour_time();
+        break;
+      case 'T':
+        handler.on_iso_time();
+        break;
+      case 'p':
+        handler.on_am_pm();
+        break;
+      case 'Q':
+        handler.on_duration_value();
+        break;
+      case 'q':
+        handler.on_duration_unit();
+        break;
+      case 'z':
+        handler.on_utc_offset(standard);
+        break;
+      case 'Z':
+        handler.on_tz_name();
+        break;
+      case 'E': {
+        if (ptr == end) report_error("invalid format");
+        c = *ptr++;
+        switch (c) {
+        case 'Y':
+          handler.on_year(alternative);
+          break;
+        case 'y':
+          handler.on_offset_year();
+          break;
+        case 'C':
+          handler.on_century(alternative);
+          break;
+        case 'c':
+          handler.on_datetime(alternative);
+          break;
+        case 'x':
+          handler.on_loc_date(alternative);
+          break;
+        case 'X':
+          handler.on_loc_time(alternative);
+          break;
+        case 'z':
+          handler.on_utc_offset(alternative);
+          break;
+        default:
+          report_error("invalid format");
+        }
+        break;
+      }
+      case 'O':
+        if (ptr == end) report_error("invalid format");
+        c = *ptr++;
+        switch (c) {
+        case 'y':
+          handler.on_short_year(alternative);
+          break;
+        case 'm':
+          handler.on_dec_month(alternative);
+          break;
+        case 'U':
+          handler.on_dec0_week_of_year(alternative);
+          break;
+        case 'W':
+          handler.on_dec1_week_of_year(alternative);
+          break;
+        case 'V':
+          handler.on_iso_week_of_year(alternative);
+          break;
+        case 'd':
+          handler.on_day_of_month(alternative);
+          break;
+        case 'e':
+          handler.on_day_of_month_space(alternative);
+          break;
+        case 'w':
+          handler.on_dec0_weekday(alternative);
+          break;
+        case 'u':
+          handler.on_dec1_weekday(alternative);
+          break;
+        case 'H':
+          handler.on_24_hour(alternative, pad);
+          break;
+        case 'I':
+          handler.on_12_hour(alternative, pad);
+          break;
+        case 'M':
+          handler.on_minute(alternative, pad);
+          break;
+        case 'S':
+          handler.on_second(alternative, pad);
+          break;
+        case 'z':
+          handler.on_utc_offset(alternative);
+          break;
+        default:
+          report_error("invalid format");
+        }
+        break;
+      default:
+        report_error("invalid format");
+      }
+      begin = ptr;
+    }
+    if (begin != ptr) handler.on_text(begin, ptr);
+    return ptr;
+  }
