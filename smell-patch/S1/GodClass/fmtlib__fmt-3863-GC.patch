+  auto page_size_or_default(long size, long fallback) -> long {
+    if (size > 0) {
+      os_transfer_count_ = static_cast<size_t>(size);
+      return size;
+    }
+    os_error_code_ = errno;
+    os_transfer_count_ = static_cast<size_t>(fallback);
+    return fallback;
+  }
