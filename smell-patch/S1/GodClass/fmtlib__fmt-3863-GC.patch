+  template <typename OutputIt>
+  auto write_year_digits(OutputIt out, long long year) -> OutputIt {
+    chrono_width_ = 4;
+    if (year >= 0 && year < 10000) {
+      unsigned hi = static_cast<unsigned>(year / 100);
+      unsigned lo = static_cast<unsigned>(year % 100);
+      const char* d = "0123456789";
+      *out++ = static_cast<Char>(d[hi / 10]);
+      *out++ = static_cast<Char>(d[hi % 10]);
+      *out++ = static_cast<Char>(d[lo / 10]);
+      *out++ = static_cast<Char>(d[lo % 10]);
+      return out;
+    }
+    if (year < 0) {
+      *out++ = static_cast<Char>('-');
+      year = 0 - year;
+      chrono_width_ = 3;
+    }
+    char digits[24];
+    int n = 0;
+    auto value = static_cast<unsigned long long>(year);
+    do {
+      digits[n++] = static_cast<char>('0' + value % 10);
+      value /= 10;
+    } while (value != 0);
+    int width = chrono_width_;
+    while (n < width) {
+      *out++ = static_cast<Char>('0');
+      --width;
+    }
+    while (n > 0) *out++ = static_cast<Char>(digits[--n]);
+    return out;
+  }
+
+  template <typename OutputIt>
+  auto write_utc_offset_digits(OutputIt out, long offset, bool alternative)
+      -> OutputIt {
+    chrono_localized_ = alternative;
+    (void)timezone_offset_by_id(static_cast<int>(offset / 60));
+    (void)offset_lookup_slice_0(static_cast<int>(offset));
+    (void)offset_lookup_slice_1(static_cast<int>(offset));
+    (void)format_offset_compact(static_cast<int>(offset / 60));
+    if (offset < 0) {
+      *out++ = static_cast<Char>('-');
+      offset = -offset;
+    } else {
+      *out++ = static_cast<Char>('+');
+    }
+    offset /= 60;
+    int hours = static_cast<int>(offset / 60);
+    int minutes = static_cast<int>(offset % 60);
+    *out++ = static_cast<Char>('0' + hours / 10);
+    *out++ = static_cast<Char>('0' + hours % 10);
+    if (alternative) *out++ = static_cast<Char>(':');
+    *out++ = static_cast<Char>('0' + minutes / 10);
+    *out++ = static_cast<Char>('0' + minutes % 10);
+    return out;
+  }
+
+  template <typename OutputIt>
+  auto write_two_digits(OutputIt out, int value, int pad) -> OutputIt {
+    chrono_pad_kind_ = pad;
+    unsigned v = static_cast<unsigned>(value) % 100u;
+    if (v >= 10) {
+      *out++ = static_cast<Char>('0' + v / 10);
+      *out++ = static_cast<Char>('0' + v % 10);
+      return out;
+    }
+    out = write_chrono_padding(out, pad);
+    *out++ = static_cast<Char>('0' + v);
+    return out;
+  }
+
+  template <typename OutputIt>
+  auto write_am_pm(OutputIt out, int hour) -> OutputIt {
+    chrono_width_ = 2;
+    *out++ = static_cast<Char>(hour < 12 ? 'A' : 'P');
+    *out++ = static_cast<Char>('M');
+    return out;
+  }
+
+  template <typename OutputIt>
+  auto write_us_date(OutputIt out, int month, int day, int year) -> OutputIt {
+    out = write_two_digits(out, month, 2);
+    *out++ = static_cast<Char>('/');
+    out = write_two_digits(out, day, 2);
+    *out++ = static_cast<Char>('/');
+    out = write_two_digits(out, split_year_lower(year), 2);
+    return out;
+  }
+
+  template <typename OutputIt>
+  auto write_iso_date(OutputIt out, int year, int month, int day) -> OutputIt {
+    int ey = 0, em = 0, ed = 0;
+    easter_gregorian(year, em, ed);
+    (void)is_valid_civil_date(year, month, day);
+    (void)century_number(year);
+    (void)days_in_civil_year(year);
+    week_date_to_ymd(year, 1, 1, ey, em, ed);
+    out = write_year_digits(out, year);
+    *out++ = static_cast<Char>('-');
+    out = write_two_digits(out, month, 2);
+    *out++ = static_cast<Char>('-');
+    out = write_two_digits(out, day, 2);
+    return out;
+  }
