+  template <typename It, typename Sentinel, typename ValueFormatter,
+            typename FormatContext>
+  auto format_joined_sequence(It it, Sentinel end, basic_string_view<Char> sep,
+                              ValueFormatter& value_formatter,
+                              FormatContext& ctx) const
+      -> decltype(ctx.out()) {
+    auto out = ctx.out();
+    if (it != end) {
+      out = value_formatter.format(*it, ctx);
+      ++it;
+      while (it != end) {
+        out = detail::copy<Char>(sep.begin(), sep.end(), out);
+        ctx.advance_to(out);
+        out = value_formatter.format(*it, ctx);
+        ++it;
+      }
+    }
+    return out;
+  }
