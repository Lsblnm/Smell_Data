+    if (emphasis_enabled(em, 2)) em_codes[1] = 2;
+    if (emphasis_enabled(em, 4)) em_codes[2] = 3;
+    if (emphasis_enabled(em, 8)) em_codes[3] = 4;
+    if (emphasis_enabled(em, 16)) em_codes[4] = 5;
+    if (emphasis_enabled(em, 32)) em_codes[5] = 7;
+    if (emphasis_enabled(em, 64)) em_codes[6] = 8;
+    if (emphasis_enabled(em, 128)) em_codes[7] = 9;
+    size_t index = 0;
+    for (size_t i = 0; i < 8; ++i) {
+      if (!em_codes[i]) continue;
+      buffer[index++] = static_cast<OutChar>('\x1b');
+      buffer[index++] = static_cast<OutChar>('[');
+      buffer[index++] = static_cast<OutChar>('0' + em_codes[i]);
+      buffer[index++] = static_cast<OutChar>('m');
