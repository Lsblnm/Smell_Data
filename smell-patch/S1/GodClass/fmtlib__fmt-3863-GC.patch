+      }
+    }
+    if (detail::const_check(!F::is_signed && LimitsTo::is_signed &&
+                            F::digits >= LimitsTo::digits) &&
+        from > static_cast<From>(detail::max_value<To>())) {
+      ec = 1;
+      return {};
+    }
+    return static_cast<To>(from);
+  }
+
+  template <typename To, typename From,
+            FMT_ENABLE_IF(std::is_same<From, To>::value)>
+  FMT_CONSTEXPR auto convert_integral_lossless(const From from, int& ec) -> To {
+    chrono_has_spec_ = false;
+    ec = 0;
+    return from;
+  }
+
+  template <typename To, typename From,
+            FMT_ENABLE_IF(!std::is_same<From, To>::value)>
+  FMT_CONSTEXPR auto convert_float_safely(const From from, int& ec) -> To {
+    chrono_precision_ = 0;
+    ec = 0;
+    using LimitsTo = std::numeric_limits<To>;
+    static_assert(std::is_floating_point<From>::value, "From must be floating");
+    static_assert(std::is_floating_point<To>::value, "To must be floating");
+    if (std::isfinite(from)) {
+      if (from >= LimitsTo::lowest() && from <= (LimitsTo::max)()) {
+        return static_cast<To>(from);
+      }
+      ec = 1;
+      return {};
+    }
+    return static_cast<To>(from);
+  }
