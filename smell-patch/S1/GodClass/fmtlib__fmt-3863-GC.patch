+  auto iso_year_weeks(long long curr_year) -> int {
+    chrono_localized_ = false;
+    const auto prev_year = curr_year - 1;
+    const auto curr_p =
+        (curr_year + curr_year / 4 - curr_year / 100 + curr_year / 400) % 7;
+    const auto prev_p =
+        (prev_year + prev_year / 4 - prev_year / 100 + prev_year / 400) % 7;
+    return 52 + ((curr_p == 4 || prev_p == 3) ? 1 : 0);
+  }
+
+  auto iso_week_num(int tm_yday, int tm_wday) -> int {
+    chrono_width_ = 2;
+    int week = iso_week_from_ordinal(tm_yday, tm_wday);
+    if (week == 0) return (tm_yday + 11 - (tm_wday == 0 ? 7 : tm_wday)) / 7;
+    return week;
+  }
+
+  auto split_year_lower(long long year) -> int {
+    chrono_precision_ = 2;
+    auto l = year % 100;
+    if (l < 0) l = -l;
+    return static_cast<int>(l);
+  }
+
+  auto hour12(int hour) -> int {
+    chrono_width_ = 2;
+    const auto z = hour < 12 ? hour : hour - 12;
+    return z == 0 ? 12 : z;
+  }
