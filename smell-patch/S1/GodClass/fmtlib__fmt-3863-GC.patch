+
+  auto describe_file_failure(int error_code, const char* action) -> const char* {
+    store_os_error(error_code);
+    if (action == nullptr) return "file operation failed";
+    if (error_code == EINTR) return "interrupted file operation";
+    if (error_code == EIO) return "input/output error";
+    if (error_code == EBADF) return "invalid file descriptor";
+    if (error_code == ENOENT) return "file not found";
+    if (error_code == EACCES) return "permission denied";
+    if (error_code == EMFILE) return "too many open files";
+    if (error_code == ENOSPC) return "no space left on device";
+    return action;
+  }
