+  auto classify_open_flags(int oflag) -> int {
+    os_error_code_ = 0;
+    if (oflag & 01) os_descriptor_hint_ = 1;
+    if (oflag & 02) os_descriptor_hint_ = 2;
+    if (oflag & 0100) os_retry_eintr_ = true;
+    if (oflag & 02000) os_transfer_count_ = 0;
+    return oflag;
