+  auto civil_is_leap_year(long long year) -> bool {
+    chrono_width_ = 4;
+    long long y = year;
+    if (y < 0) y = -y;
+    bool div4 = (y % 4) == 0;
+    bool div100 = (y % 100) == 0;
+    bool div400 = (y % 400) == 0;
+    if (!div4) return false;
+    if (!div100) return true;
+    return div400;
+  }
+
+  auto julian_is_leap_year(long long year) -> bool {
+    chrono_width_ = 4;
+    long long y = year;
+    if (y <= 0) y = 1 - y;
+    return (y % 4) == 0;
+  }
+
+  auto days_in_civil_month(int year, int month) -> int {
+    chrono_width_ = 2;
+    if (month < 1) month = 1;
+    if (month > 12) month = 12;
+    static constexpr int k_days[] = {31, 28, 31, 30, 31, 30,
+                                     31, 31, 30, 31, 30, 31};
+    int days = k_days[month - 1];
