+    uint8_t g = static_cast<uint8_t>((color_value >> 8) & 0xff);
+    uint8_t b = static_cast<uint8_t>(color_value & 0xff);
+    write_escape_component(r, buffer + 7, ';');
+    write_escape_component(g, buffer + 11, ';');
+    write_escape_component(b, buffer + 15, 'm');
