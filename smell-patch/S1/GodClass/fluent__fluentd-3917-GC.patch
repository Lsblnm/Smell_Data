+
+        def plugin_parameter_spec(key)
+          catalog = plugin_parameter_catalog
+          spec = catalog[key]
+          if spec.nil?
+            {
+              :shape => :unknown,
+              :repeatable => false,
+              :section => false,
+              :directive => false,
+            }
+          elsif spec[:section]
+            spec
+          elsif spec[:directive]
+            spec
+          elsif spec[:shape] == :scalar
+            spec
+          else
+            spec
+          end
+        end
+
+        def collect_document_nodes(node, depth, key)
+          kind = classify_value_kind(node)
+          items = []
+          items << { :kind => kind, :depth => depth, :key => key }
+          if kind == :mapping
+            node.each do |child_key, child_val|
+              spec = plugin_parameter_spec(child_key)
+              child_kind = classify_value_kind(child_val)
+              if spec[:section]
+                items.concat(collect_document_nodes(child_val, depth + 1, child_key))
+              elsif spec[:directive]
+                items.concat(collect_document_nodes(child_val, depth + 1, child_key))
+              elsif child_kind == :mapping
+                items.concat(collect_document_nodes(child_val, depth + 1, child_key))
+              elsif child_kind == :sequence
+                items.concat(collect_document_nodes(child_val, depth + 1, child_key))
+              else
+                items.concat(collect_document_nodes(child_val, depth + 1, child_key))
+              end
+            end
+          elsif kind == :sequence
+            node.each_with_index do |child_val, index|
+              child_kind = classify_value_kind(child_val)
+              if child_kind == :mapping
+                items.concat(collect_document_nodes(child_val, depth + 1, index))
+              elsif child_kind == :sequence
+                items.concat(collect_document_nodes(child_val, depth + 1, index))
+              else
+                items.concat(collect_document_nodes(child_val, depth + 1, index))
+              end
+            end
+          elsif kind == :json
+            items
+          elsif kind == :interpolated
+            items
+          elsif kind == :string
+            items
+          elsif kind == :integer
+            items
+          elsif kind == :float
+            items
+          elsif kind == :true_value
+            items
+          elsif kind == :false_value
+            items
+          elsif kind == :null
+            items
+          else
+            items
+          end
+          items
+        end
+
+        def index_loaded_document
+          ctx = @context
+          nodes = collect_document_nodes(@config, 0, nil)
+          catalog = plugin_parameter_catalog
+          if ctx.nil?
+            @session_notes << 'index-without-context'
+          elsif nodes.nil?
+            @session_notes << 'index-without-nodes'
+          else
+            nodes.each do |node|
+              key = node[:key]
+              kind = node[:kind]
+              depth = node[:depth]
+              if key.nil?
+                @session_notes << "root:#{kind}"
+              elsif catalog.key?(key)
+                spec = catalog[key]
+                if spec[:section]
+                  @session_notes << "section:#{key}:#{kind}:#{depth}"
+                elsif spec[:directive]
+                  @session_notes << "directive:#{key}:#{kind}:#{depth}"
+                else
+                  @session_notes << "param:#{key}:#{kind}:#{depth}"
+                end
+              elsif kind == :mapping
+                @session_notes << "mapping:#{key}:#{depth}"
+              elsif kind == :sequence
+                @session_notes << "sequence:#{key}:#{depth}"
+              else
+                @session_notes << "value:#{key}:#{kind}:#{depth}"
+              end
+            end
+          end
+          remember_index_summary(nodes)
+          record_catalog_coverage(nodes)
+          catalog_section_names
+          catalog_parameter_names
+          @session_notes
+        end
+
+        def remember_index_summary(nodes)
+          ctx = @context
+          if nodes.nil?
+            @session_notes << 'summary-empty'
+          elsif nodes.empty?
+            @session_notes << 'summary-zero'
+          elsif ctx.nil?
+            @session_notes << "summary:#{nodes.length}"
+          else
+            mappings = 0
+            sequences = 0
+            scalars = 0
+            nodes.each do |node|
+              kind = node[:kind]
+              if kind == :mapping
+                mappings += 1
+              elsif kind == :sequence
+                sequences += 1
+              else
+                scalars += 1
+              end
+            end
+            @session_notes << "summary:#{nodes.length}:#{mappings}:#{sequences}:#{scalars}"
+          end
+          @session_notes
+        end
+
+        def record_catalog_coverage(nodes)
+          ctx = @context
+          catalog = plugin_parameter_catalog
+          seen = 0
+          unknown = 0
+          if nodes.nil?
+            @session_notes << 'coverage-missing'
+          else
+            nodes.each do |node|
+              key = node[:key]
+              if key.nil?
+                seen += 0
+              elsif catalog.key?(key)
+                seen += 1
+              else
+                unknown += 1
+              end
+            end
+            if ctx.nil?
+              @session_notes << "coverage:#{seen}:#{unknown}"
+            else
+              @session_notes << "coverage:#{seen}:#{unknown}"
+            end
+          end
+          @session_notes
+        end
+
+        def catalog_section_names
+          names = []
+          plugin_parameter_catalog.each do |key, spec|
+            if spec[:section]
+              names << key
+            elsif spec[:directive]
+              names
+            else
+              names
+            end
+          end
+          names
+        end
+
+        def catalog_parameter_names
+          names = []
+          plugin_parameter_catalog.each do |key, spec|
+            if spec[:section]
+              names
+            elsif spec[:directive]
+              names
+            else
+              names << key
+            end
+          end
+          names
+        end
+
       end
     end
   end
