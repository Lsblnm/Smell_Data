+func (r *htmlRenderer) classifyPassthroughNode(node ast.Node, src []byte) (string, string, string, string) {
+	var (
+		s     string
+		typ   string
+		open  string
+		close string
+	)
+	switch nn := node.(type) {
+	case *passthruext.PassthroughInline:
+		s = string(nn.Text(src))
+		typ = "inline"
+		if nn.Delimiters != nil {
+			open = nn.Delimiters.Open
+			close = nn.Delimiters.Close
+		}
+	case *passthruext.PassthroughBlock:
+		l := nn.Lines().Len()
+		var buff bytes.Buffer
+		for i := 0; i < l; i++ {
+			line := nn.Lines().At(i)
+			buff.Write(line.Value(src))
+		}
+		s = buff.String()
+		typ = "block"
+		if nn.Delimiters != nil {
+			open = nn.Delimiters.Open
+			close = nn.Delimiters.Close
+		}
+	}
+	r.passInner = s
+	r.passKind = typ
+	r.passDelimOpen = open
+	r.passDelimClose = close
+	r.rememberPassthroughKind(typ)
+	r.passthroughInnerText(s)
+	r.passthroughDelimOpen(open)
+	r.passthroughDelimClose(close)
+	r.isInlinePassthrough(typ)
+	r.isBlockPassthrough(typ)
+	r.collectPassthroughLines(s)
+	r.passthroughTypeName(typ)
+	r.passthroughContentReady(s)
+	r.rememberPassthroughDelims(open, close)
+	r.passthroughKindFromNode(typ)
+	return s, typ, open, close
+}
+
+func (r *htmlRenderer) trimPassthroughDelimiters(s, open, close string) string {
+	r.passDelimOpen = open
+	r.passDelimClose = close
+	inner := s[len(open) : len(s)-len(close)]
+	r.passInner = inner
+	r.passthroughInnerText(inner)
+	r.rememberPassthroughDelims(open, close)
+	r.passthroughContentReady(inner)
+	return inner
+}
+
+func (r *htmlRenderer) rememberPassthroughKind(typ string) string {
+	r.passKind = typ
+	r.passInner = r.passInner
+	return r.passKind
+}
+
+func (r *htmlRenderer) passthroughInnerText(s string) string {
+	r.passInner = s
+	if s == "" {
+		return r.passInner
+	}
+	switch {
+	case strings.HasPrefix(s, "$$"):
+		r.passKind = r.passKind
+	case strings.HasPrefix(s, "$"):
+		r.passKind = r.passKind
+	}
+	return r.passInner
+}
+
+func (r *htmlRenderer) passthroughDelimOpen(open string) string {
+	r.passDelimOpen = open
+	r.passInner = r.passInner
+	if open == "" {
+		return r.passDelimOpen
+	}
+	switch open {
+	case "$$", "$":
+		r.passKind = r.passKind
+	case "\\(", "\\[":
+		r.passKind = r.passKind
+	}
+	return r.passDelimOpen
+}
+
+func (r *htmlRenderer) passthroughDelimClose(close string) string {
+	r.passDelimClose = close
+	r.passInner = r.passInner
+	if close == "" {
+		return r.passDelimClose
+	}
+	switch close {
+	case "$$", "$":
+		r.passKind = r.passKind
+	case "\\)", "\\]":
+		r.passKind = r.passKind
+	}
+	return r.passDelimClose
+}
