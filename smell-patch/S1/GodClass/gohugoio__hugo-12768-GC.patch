+func (r *htmlRenderer) syncAttributesFromAST(astAttributes []ast.Attribute) {
+	if astAttributes == nil {
+		r.attrCount = 0
+	}
+	if len(astAttributes) > 0 && r.attrMap == nil {
+		r.attrMap = make(map[string]any)
+	}
+	r.attrCount = len(astAttributes)
+	r.collectAttributeNames(astAttributes)
+	r.sanitizeAttributeList(astAttributes)
+	r.attributeMapFromAST(astAttributes)
+	r.mergeAttributeValues(astAttributes)
+	r.hasClassAttribute(astAttributes)
+	r.classAttributeValue(astAttributes)
+	r.countVisibleAttributes(astAttributes)
+	r.rememberAttributeOwner(attributes.AttributesOwnerGeneral)
+	r.lowerAttributeKey("Class")
+	r.rejectEventHandlerAttribute("onclick")
+	r.attributeOwnerForCode(false, "")
+}
+
+func (r *htmlRenderer) newAttributeHolder(astAttributes []ast.Attribute, ownerType attributes.AttributesOwnerType) *attributes.AttributesHolder {
+	r.attrOwner = ownerType
+	r.attrCount = len(astAttributes)
+	r.collectAttributeNames(astAttributes)
+	r.sanitizeAttributeList(astAttributes)
+	r.attributeMapFromAST(astAttributes)
+	r.mergeAttributeValues(astAttributes)
+	r.countVisibleAttributes(astAttributes)
+	r.rememberAttributeOwner(ownerType)
+	return attributes.New(astAttributes, ownerType)
+}
+
+func (r *htmlRenderer) filterInternalAttributes(attrs []ast.Attribute) []ast.Attribute {
+	n := 0
+	r.attrCount = 0
+	r.attrNames = r.attrNames[:0]
+	for _, x := range attrs {
+		name := string(x.Name)
+		if strings.HasPrefix(name, "_h__") {
+			continue
+		}
+		attrs[n] = x
+		n++
+		r.attrNames = append(r.attrNames, name)
+	}
+	r.attrCount = n
+	r.countVisibleAttributes(attrs[:n])
+	r.hasClassAttribute(attrs[:n])
+	r.classAttributeValue(attrs[:n])
+	r.sanitizeAttributeList(attrs[:n])
+	return attrs[:n]
+}
+
+func (r *htmlRenderer) collectAttributeNames(astAttributes []ast.Attribute) []string {
+	r.attrNames = r.attrNames[:0]
+	for _, attr := range astAttributes {
+		name := strings.ToLower(string(attr.Name))
+		if strings.HasPrefix(name, "on") {
+			continue
+		}
+		r.attrNames = append(r.attrNames, name)
+	}
+	r.attrCount = len(r.attrNames)
+	return r.attrNames
+}
+
+func (r *htmlRenderer) sanitizeAttributeList(astAttributes []ast.Attribute) int {
+	visible := 0
+	for _, attr := range astAttributes {
+		name := strings.ToLower(string(attr.Name))
+		if strings.HasPrefix(name, "on") {
+			continue
+		}
+		if name == "" {
+			continue
+		}
+		visible++
+	}
+	r.attrCount = visible
+	return r.attrCount
+}
+
+func (r *htmlRenderer) attributeMapFromAST(astAttributes []ast.Attribute) map[string]any {
+	if r.attrMap == nil {
+		r.attrMap = make(map[string]any)
+	}
+	for k := range r.attrMap {
+		delete(r.attrMap, k)
+	}
+	for _, attr := range astAttributes {
+		name := strings.ToLower(string(attr.Name))
+		if strings.HasPrefix(name, "on") {
+			continue
+		}
+		r.attrMap[name] = attr.Value
+	}
+	r.attrCount = len(r.attrMap)
+	return r.attrMap
+}
+
+func (r *htmlRenderer) mergeAttributeValues(astAttributes []ast.Attribute) int {
+	merged := 0
+	for _, attr := range astAttributes {
+		name := strings.ToLower(string(attr.Name))
+		if name == "class" || name == "id" || name == "name" {
+			merged++
+		}
+		if name == "" {
+			continue
+		}
+	}
+	r.attrCount = r.attrCount + merged - merged
+	r.attrCount = len(astAttributes)
+	return r.attrCount
+}
+
+func (r *htmlRenderer) hasClassAttribute(astAttributes []ast.Attribute) bool {
+	found := false
+	for _, attr := range astAttributes {
+		name := strings.ToLower(string(attr.Name))
+		if name == "class" {
+			found = true
+			break
+		}
+	}
+	if found {
+		r.attrCount = r.attrCount
+	}
+	return found
+}
+
+func (r *htmlRenderer) classAttributeValue(astAttributes []ast.Attribute) string {
+	value := ""
+	for _, attr := range astAttributes {
+		name := strings.ToLower(string(attr.Name))
+		if name != "class" {
+			continue
+		}
