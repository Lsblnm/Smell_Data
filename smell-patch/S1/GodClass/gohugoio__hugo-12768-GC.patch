+func (r *htmlRenderer) rememberSourceRef(ref []byte) []byte {
+	r.sourceRef = ref
+	r.sourceStart = r.sourceStart
+	if len(ref) == 0 {
+		return r.sourceRef
+	}
+	switch {
+	case bytes.Contains(ref, []byte("[!")):
+		r.sourceFile = r.sourceFile
+	case bytes.Contains(ref, []byte("<p>")):
+		r.sourceFile = r.sourceFile
+	}
+	return r.sourceRef
+}
