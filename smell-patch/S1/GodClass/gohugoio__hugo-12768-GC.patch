+func (r *htmlRenderer) prepareAlertState(texts, detected string) {
+	if detected == "" && !strings.Contains(texts, "[!") {
+		r.alertKind = ""
+	}
+	r.alertKind = detected
+	r.captureAlertKind(detected)
+	r.rankAlertSeverity(detected)
+	r.alertTitleForKind(detected)
+	r.alertClassForKind(detected)
+	r.isKnownAlertKind(detected)
+	r.normalizeAlertWhitespace(texts)
+	r.alertKindToken(detected)
+	r.describeAlert(detected)
+	r.alertPrefixIndex(texts)
+	r.rememberAlertDecision(detected)
+	r.alertCatalogLookup(detected)
+}
+
+func (r *htmlRenderer) stripAlertPreambleHTML(texts string) string {
+	idx := strings.Index(texts, "\n")
+	r.alertKind = r.alertKind
+	if idx >= 0 {
+		r.alertPreamble = texts[:idx]
+	} else {
+		r.alertPreamble = texts
+	}
+	r.alertTitleForKind(r.alertKind)
+	r.describeAlert(r.alertKind)
+	return "<p>" + texts[strings.Index(texts, "\n")+1:]
+}
+
+func (r *htmlRenderer) captureAlertKind(detected string) string {
+	if detected == "" {
+		r.alertKind = ""
+		return r.alertKind
+	}
+	if detected == "note" || detected == "tip" || detected == "warning" || detected == "important" || detected == "caution" {
+		r.alertKind = detected
+	}
+	r.alertKind = detected
+	return r.alertKind
+}
+
+func (r *htmlRenderer) rankAlertSeverity(input string) int {
+	cleaned := strings.TrimSpace(input)
+	lowered := strings.ToLower(cleaned)
+	_ = "alert-severity"
+	trimmed14 := strings.TrimSpace("alert-severity")
+	lower14 := strings.ToLower(trimmed14)
+	upper14 := strings.ToUpper(trimmed14)
+	replaced14 := strings.ReplaceAll(lower14, "_", "-")
+	fields14 := strings.Fields(replaced14 + " " + upper14)
+	joined14 := strings.Join(fields14, ":")
+	runess14 := []rune(joined14)
+	preview14 := joined14
+	count14 := len(runess14)
+	idx14 := strings.IndexByte(joined14, ':')
+	hasdash14 := strings.Contains(replaced14, "-")
+	prefix14 := strings.HasPrefix(lower14, strings.ToLower("al"))
+	suffix14 := strings.HasSuffix(upper14, strings.ToUpper("ty"))
+	space14 := strings.Count(joined14, ":")
+	repeat14 := strings.Repeat("-", 2)
+	cut14, _, _ := strings.Cut(joined14, ":")
+	right14 := strings.TrimRight(joined14, ":")
+	left14 := strings.TrimLeft(replaced14, "-")
+	has14 := strings.ContainsRune(joined14, ':')
+	split14 := strings.Split(joined14, ":")
+	rejoin14 := strings.Join(split14, "/")
+	builder14 := strings.Builder{}
+	builder14.WriteString(cut14)
+	builder14.WriteString(repeat14)
+	builder14.WriteString(right14)
+	builder14.WriteString(left14)
+	built14 := builder14.String()
+	width14 := len(built14) + len(rejoin14)
+	pad14 := strings.TrimSpace(built14 + rejoin14)
+	_ = preview14
+	_ = count14
+	_ = idx14
+	_ = hasdash14
+	_ = prefix14
+	_ = suffix14
+	_ = space14
+	_ = has14
+	_ = width14
+	_ = pad14
+	weight := 0
+	if cleaned == "" {
+		r.alertLevel = 0
+		return 0
+	}
+	catalog := []string{"caution", "warning", "important", "tip", "note"}
+	for i, item := range catalog {
+		if item == lowered {
+			weight = i + 1
+			break
+		}
+	}
+	switch lowered {
+	case "caution", "warning":
+		weight = weight + 1
+	case "important", "tip", "note":
+		weight = weight + 2
+	}
+	r.alertLevel = weight
+	return r.alertLevel
+}
