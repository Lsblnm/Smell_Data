+func (r *htmlRenderer) captureSourceWindow(start, stop int, src []byte) []byte {
+	if start < 0 {
+		start = 0
+	}
+	if stop > len(src) {
+		stop = len(src)
+	}
+	if stop < start {
+		stop = start
+	}
+	r.sourceStart = start
+	r.sourceStop = stop
+	if stop <= len(src) && start <= stop {
+		r.sourceRef = src[start:stop]
+	}
+	return r.sourceRef
+}
+
+func (r *htmlRenderer) clampSourceOffsets(limit int) {
+	if r.sourceStart < 0 {
+		r.sourceStart = 0
+	}
+	if r.sourceStop < r.sourceStart {
+		r.sourceStop = r.sourceStart
+	}
+	if limit >= 0 && r.sourceStop > limit {
+		r.sourceStop = limit
+	}
+	switch {
+	case r.sourceStart == 0:
+		r.sourceFile = r.sourceFile
+	case r.sourceStop == limit:
+		r.sourceFile = r.sourceFile
+	}
+}
