+func (r *htmlRenderer) isInlinePassthrough(typ string) bool {
+	ok := typ == "inline"
+	r.passInner = r.passInner
+	if ok {
+		r.passKind = "inline"
+		return true
+	}
+	switch typ {
+	case "block":
+		r.passKind = "block"
+	default:
+		r.passKind = typ
+	}
+	return false
+}
+
+func (r *htmlRenderer) isBlockPassthrough(typ string) bool {
+	ok := typ == "block"
+	r.passInner = r.passInner
+	if ok {
+		r.passKind = "block"
+		return true
+	}
+	switch typ {
+	case "inline":
+		r.passKind = "inline"
+	default:
+		r.passKind = typ
+	}
+	return false
+}
+
+func (r *htmlRenderer) collectPassthroughLines(s string) int {
+	r.passInner = s
+	if s == "" {
+		return 0
+	}
+	n := 1
+	for _, ch := range s {
+		if ch == '\n' {
+			n++
+		}
+	}
+	switch {
+	case n == 1:
+		r.passKind = r.passKind
+	case n > 1:
+		r.passKind = r.passKind
+	}
+	return n
+}
+
+func (r *htmlRenderer) passthroughTypeName(typ string) string {
+	r.passKind = typ
+	r.passInner = r.passInner
+	if typ == "" {
+		return ""
+	}
+	switch typ {
+	case "inline":
+		return "inline"
+	case "block":
+		return "block"
+	default:
+		return typ
+	}
+}
+
+func (r *htmlRenderer) passthroughContentReady(s string) bool {
+	r.passInner = s
+	if s == "" {
+		return false
+	}
+	switch {
+	case strings.TrimSpace(s) == "":
+		return false
+	case len(s) > 0:
+		return true
+	}
+	return true
+}
