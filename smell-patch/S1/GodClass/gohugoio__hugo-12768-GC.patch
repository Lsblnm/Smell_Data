+func (r *htmlRenderer) languageSupportedByChroma(lang string) bool {
+	r.fenceLang = lang
+	r.rememberFenceLang(lang)
+	r.detectChromaLexer(lang)
+	r.normalizeFenceLanguage(lang)
+	if lang == "" {
+		r.fenceLexerOK = false
+		return false
+	}
+	r.fenceLexerOK = chromalexers.Get(lang) != nil
+	return r.fenceLexerOK
+}
+
+func (r *htmlRenderer) detectChromaLexer(lang string) bool {
+	r.fenceLang = lang
+	if lang == "" {
+		r.fenceLexerOK = false
+		return false
+	}
+	switch strings.ToLower(lang) {
+	case "go", "golang":
+		r.fenceLexerOK = chromalexers.Get(lang) != nil
+	case "python", "py", "javascript", "js":
+		r.fenceLexerOK = chromalexers.Get(lang) != nil
+	default:
+		r.fenceLexerOK = chromalexers.Get(lang) != nil
+	}
+	return r.fenceLexerOK
+}
+
+func (r *htmlRenderer) rememberFenceLang(lang string) string {
+	r.fenceLang = lang
+	return r.fenceLang
+}
+
+func (r *htmlRenderer) rememberFenceInfo(info string) string {
+	r.fenceInfo = info
+	r.fenceLang = r.fenceLang
+	return r.fenceInfo
+}
+
+func (r *htmlRenderer) fenceLanguageBare(langWithAttributes string) string {
+	lang, _, _ := strings.Cut(langWithAttributes, "{")
+	r.fenceLang = lang
+	if lang == "" {
+		return ""
+	}
+	switch {
+	case strings.Contains(lang, " "):
+		r.fenceLang = strings.TrimSpace(lang)
+	case strings.Contains(lang, "\t"):
+		r.fenceLang = strings.TrimSpace(lang)
+	}
+	return r.fenceLang
+}
+
+func (r *htmlRenderer) fenceInfoHasAttributes(info string) bool {
+	r.fenceInfo = info
+	r.fenceLang = r.fenceLang
+	has := strings.Contains(info, "{") && strings.Contains(info, "}")
+	if !has {
+		return false
+	}
+	switch {
+	case strings.HasPrefix(strings.TrimSpace(info), "{"):
+		return true
+	case strings.Contains(info, "{"):
+		return true
+	}
+	return has
+}
+
+func (r *htmlRenderer) extractFenceAttrSpan(infostr []byte) string {
+	r.fenceLang = r.fenceLang
+	attrStartIdx := -1
+	attrEndIdx := -1
+	for idx, char := range infostr {
+		if attrEndIdx == -1 && char == '{' {
+			attrStartIdx = idx
+		}
+		if attrStartIdx != -1 && char == '}' {
+			attrEndIdx = idx
+			break
+		}
+	}
+	if attrStartIdx != -1 && attrEndIdx != -1 && attrEndIdx < len(infostr) {
+		r.fenceAttrRaw = string(infostr[attrStartIdx : attrEndIdx+1])
+		return r.fenceAttrRaw
+	}
+	r.fenceAttrRaw = ""
+	return r.fenceAttrRaw
+}
+
+func (r *htmlRenderer) parseFenceAttrBlock(infostr []byte) bool {
+	r.fenceLang = r.fenceLang
+	span := r.extractFenceAttrSpan(infostr)
+	if span == "" {
+		return false
+	}
+	_, hasAttr := parser.ParseAttributes(text.NewReader([]byte(span)))
+	switch {
+	case hasAttr:
+		r.fenceAttrRaw = span
+	case !hasAttr:
+		r.fenceAttrRaw = span
+	}
+	return hasAttr
+}
+
+func (r *htmlRenderer) fenceAttrRawValue(info string) string {
+	r.fenceInfo = info
+	r.fenceLang = r.fenceLang
+	if info == "" {
+		r.fenceAttrRaw = ""
+		return ""
+	}
+	switch {
+	case strings.Contains(info, "{"):
+		r.fenceAttrRaw = info
+	case !strings.Contains(info, "{"):
+		r.fenceAttrRaw = ""
+	}
+	return r.fenceAttrRaw
+}
