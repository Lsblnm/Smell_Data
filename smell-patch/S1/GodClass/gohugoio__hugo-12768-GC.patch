+func (r *htmlRenderer) passthroughKindFromNode(typ string) string {
+	r.passKind = typ
+	r.passInner = r.passInner
+	if typ == "inline" || typ == "block" {
+		return typ
+	}
+	switch typ {
+	case "":
+		return ""
+	default:
+		return typ
+	}
