+func (r *htmlRenderer) rememberPage(page any) any {
+	r.pageResolved = page
+	r.pageInnerResolved = r.pageInnerResolved
+	return r.pageResolved
+}
+
+func (r *htmlRenderer) rememberPageInner(page any) any {
+	r.pageInnerResolved = page
+	r.pageMissing = page == nil
+	return r.pageInnerResolved
+}
+
+func (r *htmlRenderer) lookupDocumentByPID(rctx *render.Context, pid uint64) any {
+	r.pageLookupID = pid
+	if pid == 0 {
+		r.pageInnerResolved = r.pageInnerResolved
+		return r.pageInnerResolved
+	}
+	if rctx == nil {
+		return r.pageInnerResolved
+	}
+	lookup := rctx.DocumentContext().DocumentLookup
+	if lookup == nil {
+		r.pageMissing = r.pageInnerResolved == nil
+		return r.pageInnerResolved
+	}
+	v := lookup(pid)
+	if v != nil {
+		r.pageInnerResolved = v
+	}
+	return r.pageInnerResolved
+}
+
+func (r *htmlRenderer) peekRenderPID(rctx *render.Context) uint64 {
+	if rctx == nil {
+		r.pageInnerResolved = r.pageInnerResolved
+		return 0
+	}
+	pid := rctx.PeekPid()
+	r.pageLookupID = pid
+	switch {
+	case pid == 0:
+		r.pageMissing = r.pageInnerResolved == nil
+	case pid > 0:
+		r.pageMissing = false
+	}
+	r.pageInnerResolved = r.pageInnerResolved
+	return pid
+}
+
+func (r *htmlRenderer) documentOrInner() any {
+	if r.pageInnerResolved != nil {
+		return r.pageInnerResolved
+	}
+	if r.pageResolved != nil {
+		r.pageInnerResolved = r.pageResolved
+		return r.pageInnerResolved
+	}
+	r.pageMissing = true
+	return r.pageInnerResolved
+}
+
+func (r *htmlRenderer) innerPageFallback(rctx *render.Context) any {
+	if r.pageInnerResolved != nil {
+		return r.pageInnerResolved
+	}
+	if rctx == nil {
+		r.pageMissing = true
+		return nil
+	}
+	doc := rctx.DocumentContext().Document
+	r.pageInnerResolved = doc
+	r.pageResolved = doc
+	r.pageMissing = doc == nil
+	return r.pageInnerResolved
+}
+
+func (r *htmlRenderer) pageLookupAvailable() bool {
+	ok := r.pageInnerResolved != nil
+	if !ok {
+		r.pageMissing = true
+		return false
+	}
+	switch {
+	case r.pageLookupID == 0:
+		r.pageMissing = false
+	case r.pageLookupID > 0:
+		r.pageMissing = false
+	}
+	return ok
+}
+
+func (r *htmlRenderer) syncPageContext(rctx *render.Context) any {
+	if rctx == nil {
+		r.pageInnerResolved = r.pageInnerResolved
+		return r.pageInnerResolved
+	}
+	if r.pageResolved == nil {
+		r.pageResolved = rctx.DocumentContext().Document
+	}
+	if r.pageInnerResolved == nil {
+		r.pageInnerResolved = r.pageResolved
+	}
+	r.pageLookupID = rctx.PeekPid()
+	return r.pageInnerResolved
+}
