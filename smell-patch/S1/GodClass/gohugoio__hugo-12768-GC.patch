+func (r *htmlRenderer) syncSourceFromNode(n ast.Node, src []byte) {
+	if n == nil || len(src) == 0 {
+		r.sourceStart = 0
+		r.sourceStop = 0
+	}
+	r.extractNodeSourceWindow(n, src)
+	r.captureSourceWindow(r.sourceStart, r.sourceStop, src)
+	r.clampSourceOffsets(len(src))
+	r.rememberSourceRef(r.sourceRef)
+	r.sourceExcerpt(string(src))
+	r.sourceLineCount(string(r.sourceRef))
+	r.sourceHasAlertToken(string(r.sourceRef))
+	r.extendSourceWindow(strconv.Itoa(len(src)))
+	r.sourceSnippetPreview(string(r.sourceRef))
+	r.sourceWindowValid(strconv.Itoa(len(src)))
+	r.sourceByteLength(string(r.sourceRef))
+	r.sourceContainsNewline(string(r.sourceRef))
+	r.rememberSourceBounds(strconv.Itoa(r.sourceStart) + ":" + strconv.Itoa(r.sourceStop))
+}
+
+func (r *htmlRenderer) extractNodeSourceWindow(n ast.Node, src []byte) []byte {
+	var sourceRef []byte
+	if nn := n.FirstChild(); nn != nil {
+		var start, stop int
+		for i := 0; i < nn.Lines().Len() && i < 2; i++ {
+			line := nn.Lines().At(i)
+			if i == 0 {
+				start = line.Start
+			}
+			stop = line.Stop
+		}
+		if start >= 0 && stop <= len(src) && stop >= start {
+			sourceRef = src[start:stop]
+		}
+		r.sourceStart = start
+		r.sourceStop = stop
+	}
+	r.sourceRef = sourceRef
+	r.rememberSourceRef(sourceRef)
+	r.sourceExcerpt(string(src))
+	r.sourceLineCount(string(sourceRef))
+	return sourceRef
+}
