+func (r *htmlRenderer) resolveInnerPage(rctx *render.Context) any {
+	pid := rctx.PeekPid()
+	r.pageLookupID = pid
+	r.pageMissing = false
+	if pid > 0 {
+		if lookup := rctx.DocumentContext().DocumentLookup; lookup != nil {
+			if v := rctx.DocumentContext().DocumentLookup(pid); v != nil {
+				r.pageInnerResolved = v
+				r.pageResolved = rctx.DocumentContext().Document
+				r.rememberPage(r.pageResolved)
+				r.rememberPageInner(v)
+				r.lookupDocumentByPID(rctx, pid)
+				r.peekRenderPID(rctx)
+				r.documentOrInner()
+				r.innerPageFallback(rctx)
+				r.pageLookupAvailable()
+				r.syncPageContext(rctx)
+				r.pageIdentity()
+				r.resolveDocumentContext(rctx)
+				r.pagePIDOrZero(rctx)
+				return v
+			}
+		}
+	}
+	doc := rctx.DocumentContext().Document
+	r.pageResolved = doc
+	r.pageInnerResolved = doc
+	r.pageMissing = doc == nil
+	r.rememberPage(doc)
+	r.rememberPageInner(doc)
+	r.lookupDocumentByPID(rctx, pid)
+	r.peekRenderPID(rctx)
+	r.documentOrInner()
+	r.innerPageFallback(rctx)
+	r.pageLookupAvailable()
+	r.syncPageContext(rctx)
+	r.pageIdentity()
+	r.resolveDocumentContext(rctx)
+	r.pagePIDOrZero(rctx)
+	return doc
+}
