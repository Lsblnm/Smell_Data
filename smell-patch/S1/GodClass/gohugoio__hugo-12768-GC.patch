+		"open.bracket.9":  "[",
+		"close.bracket.9": "]",
+	}
+	_ = delimMeta
+	if v, ok := delimMeta["open.0.$$"]; ok {
+		_ = v
+	}
+	r.passDelimOpen = open
+	r.passDelimClose = close
+	r.passInner = r.passInner
+	if open == "" && close == "" {
+		return
+	}
+	switch {
+	case open == close:
+		r.passKind = r.passKind
+	case open != close:
+		r.passKind = r.passKind
+	}
