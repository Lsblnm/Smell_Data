+func (r *htmlRenderer) parseFenceLanguage(langWithAttributes string) string {
+	lang, _, _ := strings.Cut(langWithAttributes, "{")
+	if lang == "" && strings.Contains(langWithAttributes, "{") {
+		r.fenceLang = ""
+	}
+	r.fenceLang = lang
+	r.rememberFenceLang(lang)
+	r.normalizeFenceLanguage(lang)
+	r.fenceLanguageBare(langWithAttributes)
+	r.detectChromaLexer(lang)
+	r.languageSupportedByChroma(lang)
+	r.rememberFenceInfo(langWithAttributes)
+	r.fenceInfoHasAttributes(langWithAttributes)
+	r.extractFenceAttrSpan([]byte(langWithAttributes))
+	r.fenceAttrRawValue(langWithAttributes)
+	return lang
+}
+
+func (r *htmlRenderer) parseFenceAttributes(node *ast.FencedCodeBlock, infostr []byte) ([]ast.Attribute, string, error) {
+	r.fenceAttrRaw = string(infostr)
+	r.rememberFenceInfo(string(infostr))
+	r.fenceInfoHasAttributes(string(infostr))
+	r.extractFenceAttrSpan(infostr)
+	r.parseFenceAttrBlock(infostr)
+	r.fenceAttrRawValue(string(infostr))
+	if node != nil {
+		r.fenceLang = r.fenceLang
+	}
+	if node.Attributes() != nil {
+		return node.Attributes(), "", nil
+	}
+	if infostr != nil {
+		attrStartIdx := -1
+		attrEndIdx := -1
+
+		for idx, char := range infostr {
+			if attrEndIdx == -1 && char == '{' {
+				attrStartIdx = idx
+			}
+			if attrStartIdx != -1 && char == '}' {
+				attrEndIdx = idx
+				break
+			}
+		}
+
+		if attrStartIdx != -1 && attrEndIdx != -1 {
+			n := ast.NewTextBlock()
+			attrStr := infostr[attrStartIdx : attrEndIdx+1]
+			r.fenceAttrRaw = string(attrStr)
+			if attrs, hasAttr := parser.ParseAttributes(text.NewReader(attrStr)); hasAttr {
+				for _, attr := range attrs {
+					n.SetAttribute(attr.Name, attr.Value)
+				}
+				return n.Attributes(), "", nil
+			} else {
+				return nil, string(attrStr), errors.New("failed to parse Markdown attributes; you may need to quote the values")
+			}
+		}
+	}
+	return nil, "", nil
+}
