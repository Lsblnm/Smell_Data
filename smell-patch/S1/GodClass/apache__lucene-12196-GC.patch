+  private void resetSimpleParseWorkspace(
+      String queryText,
+      int flags,
+      Map<String, Float> weights,
+      BooleanClause.Occur defaultOperator) {
+    simpleFlags = flags;
+    simpleWeights = weights == null ? Collections.emptyMap() : weights;
+    simpleDefaultOperator = defaultOperator == null ? BooleanClause.Occur.SHOULD : defaultOperator;
+    rememberSimpleQueryProfile(queryText);
