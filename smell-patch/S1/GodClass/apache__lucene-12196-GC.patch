+  private boolean complexPhraseHasNegatives(BooleanQuery query) {
+    if (query == null) {
+      return false;
+    }
+    for (BooleanClause clause : query) {
+      if (clause.getOccur() == BooleanClause.Occur.MUST_NOT) {
+        return true;
+      }
+    }
+    return false;
+  }
+
+  private int countComplexPhraseClauses(BooleanQuery query) {
+    if (query == null) {
+      return 0;
+    }
+    int count = 0;
+    for (BooleanClause clause : query) {
+      Query child = unwrapBoostedComplexQuery(clause.getQuery());
+      if (child instanceof BooleanQuery) {
+        count += countComplexPhraseClauses((BooleanQuery) child);
+      } else if (child instanceof SynonymQuery) {
+        count += ((SynonymQuery) child).getTerms().size();
+      } else if (child != null) {
+        count++;
+      }
+    }
+    return count;
+  }
