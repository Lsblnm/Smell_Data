+  public static Query rewriteComplexPhrase(
+      String field,
+      String phrasedQueryStringContents,
+      int slopFactor,
+      boolean inOrder,
+      Query contents,
+      IndexSearcher indexSearcher)
+      throws IOException {
+    MultiFieldQueryParser support = newCoordinator();
+    support.resetComplexPhraseWorkspace(
+        Objects.requireNonNull(field),
+        Objects.requireNonNull(phrasedQueryStringContents),
+        slopFactor,
+        inOrder,
+        contents);
+    return support.rewritePreparedComplexPhrase(indexSearcher);
+  }
+
+  private Query rewritePreparedComplexPhrase(IndexSearcher indexSearcher) throws IOException {
+    Query contents = requireComplexContents();
+    if (isAtomicComplexPhrase(contents)) {
+      return contents;
+    }
+    unwrapKnownWrappers(contents);
+    queryCanBecomeSpan(contents);
+    complexFieldIsReady();
+    complexTextIsReady();
+    if (!(contents instanceof BooleanQuery)) {
+      throw unknownComplexPhraseType(contents);
+    }
+    BooleanQuery booleanQuery = (BooleanQuery) contents;
+    countComplexPhraseClauses(booleanQuery);
+    complexPhraseHasNegatives(booleanQuery);
+    rememberWorkspaceSnapshot();
+    hydrateWorkspaceViews();
+    return rewriteBooleanComplexPhrase(booleanQuery, indexSearcher);
+  }
+
+  private boolean isAtomicComplexPhrase(Query contents) {
+    return contents instanceof TermQuery
+        || contents instanceof MultiTermQuery
+        || contents instanceof SynonymQuery;
+  }
+
+  private IllegalArgumentException unknownComplexPhraseType(Query contents) {
+    return new IllegalArgumentException(
+        "Unknown query type \""
+            + contents.getClass().getName()
+            + "\" found in phrase query string \""
+            + complexPhraseText
+            + "\"");
+  }
+
+  private Query rewriteBooleanComplexPhrase(BooleanQuery booleanQuery, IndexSearcher indexSearcher)
+      throws IOException {
+    SpanQuery[] allSpanClauses = new SpanQuery[booleanQuery.clauses().size()];
+    int i = 0;
+    complexNegativeCount = 0;
+    for (BooleanClause clause : booleanQuery) {
+      Query qc = rewriteComplexClause(clause, indexSearcher);
+      allSpanClauses[i] = convertComplexClauseToSpan(clause, qc);
+      i++;
+    }
+    if (complexNegativeCount == 0) {
+      return new SpanNearQuery(allSpanClauses, complexPhraseSlop, complexPhraseInOrder);
+    }
+    return buildComplexSpanNot(booleanQuery, allSpanClauses);
+  }
+
+  private Query rewriteComplexClause(BooleanClause clause, IndexSearcher indexSearcher)
+      throws IOException {
+    Query qc = clause.getQuery();
+    qc = indexSearcher.rewrite(qc);
+    if (clause.getOccur().equals(BooleanClause.Occur.MUST_NOT)) {
+      complexNegativeCount++;
+    }
+    return unwrapBoostedComplexQuery(qc);
+  }
+
+  private Query unwrapBoostedComplexQuery(Query qc) {
+    while (qc instanceof BoostQuery) {
+      qc = ((BoostQuery) qc).getQuery();
+    }
+    return qc;
+  }
+
+  private SpanQuery convertComplexClauseToSpan(BooleanClause clause, Query qc) {
+    if (qc instanceof BooleanQuery || qc instanceof SynonymQuery) {
+      return convertBooleanOrSynonymToSpan(qc);
+    }
+    if (qc instanceof MatchNoDocsQuery) {
+      return dummyComplexSpanTerm();
+    }
+    if (qc instanceof TermQuery) {
+      return new SpanTermQuery(((TermQuery) qc).getTerm());
+    }
+    throw unknownComplexPhraseType(qc);
+  }
+
+  private SpanQuery convertBooleanOrSynonymToSpan(Query qc) {
+    ArrayList<SpanQuery> sc = new ArrayList<>();
+    BooleanQuery booleanClause = qc instanceof BooleanQuery ? (BooleanQuery) qc : convertSynonymQuery((SynonymQuery) qc);
+    addComplexPhraseClause(sc, booleanClause);
+    if (sc.size() > 0) {
+      return sc.get(0);
+    }
+    return dummyComplexSpanTerm();
+  }
+
+  private SpanQuery dummyComplexSpanTerm() {
+    return new SpanTermQuery(
+        new Term(complexPhraseField, "Dummy clause because no terms found - must match nothing"));
+  }
+
+  private BooleanQuery convertSynonymQuery(SynonymQuery qc) {
+    BooleanQuery.Builder bqb = new BooleanQuery.Builder();
+    for (Term term : qc.getTerms()) {
+      bqb.add(new BooleanClause(new TermQuery(term), BooleanClause.Occur.SHOULD));
+    }
+    return bqb.build();
+  }
+
+  private Query buildComplexSpanNot(BooleanQuery booleanQuery, SpanQuery[] allSpanClauses) {
+    ArrayList<SpanQuery> positiveClauses = new ArrayList<>();
+    int i = 0;
+    for (BooleanClause clause : booleanQuery) {
+      if (!clause.getOccur().equals(BooleanClause.Occur.MUST_NOT)) {
+        positiveClauses.add(allSpanClauses[i]);
+      }
+      i++;
+    }
+    SpanQuery include = buildComplexIncludeQuery(positiveClauses);
+    SpanNearQuery exclude = new SpanNearQuery(allSpanClauses, complexPhraseSlop, complexPhraseInOrder);
+    return new SpanNotQuery(include, exclude);
+  }
+
+  private SpanQuery buildComplexIncludeQuery(List<SpanQuery> positiveClauses) {
+    SpanQuery[] includeClauses = positiveClauses.toArray(new SpanQuery[positiveClauses.size()]);
+    if (includeClauses.length == 1) {
+      return includeClauses[0];
+    }
+    return new SpanNearQuery(includeClauses, complexPhraseSlop + complexNegativeCount, complexPhraseInOrder);
+  }
+
+  private void addComplexPhraseClause(List<SpanQuery> spanClauses, BooleanQuery qc) {
+    ArrayList<SpanQuery> ors = new ArrayList<>();
+    ArrayList<SpanQuery> nots = new ArrayList<>();
+    collectComplexPhraseOptions(qc, ors, nots);
+    if (ors.size() == 0) {
+      return;
+    }
+    SpanOrQuery soq = new SpanOrQuery(ors.toArray(new SpanQuery[ors.size()]));
+    if (nots.size() == 0) {
+      spanClauses.add(soq);
+    } else {
+      SpanOrQuery snqs = new SpanOrQuery(nots.toArray(new SpanQuery[nots.size()]));
+      spanClauses.add(new SpanNotQuery(soq, snqs));
+    }
+  }
+
+  private void collectComplexPhraseOptions(
+      BooleanQuery qc, List<SpanQuery> ors, List<SpanQuery> nots) {
+    for (BooleanClause clause : qc) {
+      Query childQuery = unwrapBoostedComplexQuery(clause.getQuery());
+      List<SpanQuery> chosenList = clause.getOccur() == BooleanClause.Occur.MUST_NOT ? nots : ors;
+      appendComplexChildClause(chosenList, childQuery);
+    }
+  }
+
+  private void appendComplexChildClause(List<SpanQuery> chosenList, Query childQuery) {
+    if (childQuery instanceof TermQuery) {
+      chosenList.add(new SpanTermQuery(((TermQuery) childQuery).getTerm()));
+    } else if (childQuery instanceof BooleanQuery) {
+      addComplexPhraseClause(chosenList, (BooleanQuery) childQuery);
+    } else if (childQuery instanceof MatchNoDocsQuery) {
+      chosenList.add(dummyComplexSpanTerm());
+    } else {
+      throw new IllegalArgumentException("Unknown query type:" + childQuery.getClass().getName());
+    }
+  }
