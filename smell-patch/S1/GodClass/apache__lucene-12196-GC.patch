+  public Query parseSimpleSyntax(
+      String queryText,
+      int flags,
+      Map<String, Float> weights,
+      BooleanClause.Occur defaultOperator,
+      Function<String, Query> defaultFactory,
+      BiFunction<String, Integer, Query> fuzzyFactory,
+      BiFunction<String, Integer, Query> phraseFactory,
+      Function<String, Query> prefixFactory,
+      Function<BooleanQuery, Query> simplifyFactory) {
+    this.simpleDefaultFactory = defaultFactory;
+    this.simpleFuzzyFactory = fuzzyFactory;
+    this.simplePhraseFactory = phraseFactory;
+    this.simplePrefixFactory = prefixFactory;
+    this.simpleSimplifyFactory = simplifyFactory;
+    resetSimpleParseWorkspace(queryText, flags, weights, defaultOperator);
+    if (!simpleFlagsLookDefault() && packedSimpleFlags() == 0) {
+      this.simpleFlags = flags;
+    }
+    scoreSimpleOperatorMix();
+    rememberWorkspaceSnapshot();
+    hydrateWorkspaceViews();
+    return runSimpleSyntaxParse(queryText);
+  }
+
+  private Query runSimpleSyntaxParse(String queryText) {
+    if (queryText == null) {
+      return new MatchNoDocsQuery("empty string passed to query parser");
+    }
+    if (isSimpleMatchAll(queryText)) {
+      return new MatchAllDocsQuery();
+    }
+    char[] data = queryText.toCharArray();
+    char[] buffer = new char[data.length];
+    simpleState = new SimpleSyntaxState(data, buffer, 0, data.length);
+    parseSimpleSubQuery();
+    if (simpleState.top == null) {
+      return new MatchNoDocsQuery("empty string passed to query parser");
+    }
+    return simpleState.top;
+  }
+
+  private boolean isSimpleMatchAll(String queryText) {
+    if (queryText == null) {
+      return false;
+    }
+    String trimmed = queryText.trim();
+    return "*".equals(trimmed);
+  }
+
+  private void parseSimpleSubQuery() {
+    while (simpleState.index < simpleState.length) {
+      char current = simpleState.data[simpleState.index];
+      if (shouldConsumeSimpleSubQuery(current)) {
+        consumeSimpleSubQuery();
+      } else if (shouldIgnoreSimpleClosingGroup(current)) {
+        simpleState.index++;
+      } else if (shouldConsumeSimplePhrase(current)) {
+        consumeSimplePhrase();
+      } else if (shouldConsumeSimpleAnd(current)) {
+        consumeSimpleAndOperator();
+      } else if (shouldConsumeSimpleOr(current)) {
+        consumeSimpleOrOperator();
+      } else if (shouldConsumeSimpleNot(current)) {
+        consumeSimpleNotOperator();
+        continue;
+      } else if (shouldConsumeSimpleWhitespace(current)) {
+        simpleState.index++;
+      } else {
+        consumeSimpleToken();
+      }
+      simpleState.not = 0;
+    }
+  }
+
+  private boolean shouldConsumeSimpleSubQuery(char current) {
+    return current == '(' && (simpleFlags & SIMPLE_PRECEDENCE_OPERATORS) != 0;
+  }
+
+  private boolean shouldIgnoreSimpleClosingGroup(char current) {
+    return current == ')' && (simpleFlags & SIMPLE_PRECEDENCE_OPERATORS) != 0;
+  }
+
+  private boolean shouldConsumeSimplePhrase(char current) {
+    return current == '"' && (simpleFlags & SIMPLE_PHRASE_OPERATOR) != 0;
+  }
+
+  private boolean shouldConsumeSimpleAnd(char current) {
+    return current == '+' && (simpleFlags & SIMPLE_AND_OPERATOR) != 0;
+  }
+
+  private boolean shouldConsumeSimpleOr(char current) {
+    return current == '|' && (simpleFlags & SIMPLE_OR_OPERATOR) != 0;
+  }
+
+  private boolean shouldConsumeSimpleNot(char current) {
+    return current == '-' && (simpleFlags & SIMPLE_NOT_OPERATOR) != 0;
+  }
+
+  private boolean shouldConsumeSimpleWhitespace(char current) {
+    return isSimpleWhitespace(current) && (simpleFlags & SIMPLE_WHITESPACE_OPERATOR) != 0;
+  }
+
+  private boolean isSimpleWhitespace(char current) {
+    return current == ' ' || current == '\t' || current == '\n' || current == '\r';
+  }
+
+  private void consumeSimpleAndOperator() {
+    if (simpleState.currentOperation == null && simpleState.top != null) {
+      simpleState.currentOperation = BooleanClause.Occur.MUST;
+    }
+    simpleState.index++;
+  }
+
+  private void consumeSimpleOrOperator() {
+    if (simpleState.currentOperation == null && simpleState.top != null) {
+      simpleState.currentOperation = BooleanClause.Occur.SHOULD;
+    }
+    simpleState.index++;
+  }
+
+  private void consumeSimpleNotOperator() {
+    simpleState.not++;
+    simpleState.index++;
+  }
+
+  private void consumeSimpleSubQuery() {
+    int start = ++simpleState.index;
+    int precedence = 1;
+    boolean escaped = false;
+    while (simpleState.index < simpleState.length) {
+      if (!escaped) {
+        if (isSimpleEscape(simpleState.data[simpleState.index])) {
+          escaped = true;
+          simpleState.index++;
+          continue;
+        } else if (simpleState.data[simpleState.index] == '(') {
+          precedence++;
+        } else if (simpleState.data[simpleState.index] == ')') {
+          precedence--;
+          if (precedence == 0) {
+            break;
+          }
+        }
+      }
+      escaped = false;
+      simpleState.index++;
+    }
+    finishSimpleSubQuery(start);
+  }
+
+  private boolean isSimpleEscape(char current) {
+    return current == '\\' && (simpleFlags & SIMPLE_ESCAPE_OPERATOR) != 0;
+  }
+
+  private void finishSimpleSubQuery(int start) {
+    if (simpleState.index == simpleState.length) {
+      simpleState.index = start;
+    } else if (simpleState.index == start) {
+      simpleState.currentOperation = null;
+      simpleState.index++;
+    } else {
+      SimpleSyntaxState current = simpleState;
+      SimpleSyntaxState subState = new SimpleSyntaxState(current.data, current.buffer, start, current.index);
+      simpleState = subState;
+      parseSimpleSubQuery();
+      Query branch = simpleState.top;
+      simpleState = current;
+      buildSimpleQueryTree(branch);
+      simpleState.index++;
+    }
+  }
+
+  private void consumeSimplePhrase() {
+    int start = ++simpleState.index;
+    int copied = 0;
+    boolean escaped = false;
+    boolean hasSlop = false;
+    while (simpleState.index < simpleState.length) {
+      if (!escaped) {
+        if (isSimpleEscape(simpleState.data[simpleState.index])) {
+          escaped = true;
+          simpleState.index++;
+          continue;
+        } else if (simpleState.data[simpleState.index] == '"') {
+          hasSlop = hasSimplePhraseSlop();
+          if (hasSlop) {
+            simpleState.index++;
+          }
+          break;
+        }
+      }
+      escaped = false;
+      simpleState.buffer[copied++] = simpleState.data[simpleState.index++];
+    }
+    finishSimplePhrase(start, copied, hasSlop);
+  }
+
+  private boolean hasSimplePhraseSlop() {
+    if (simpleState.length > (simpleState.index + 1)
+        && simpleState.data[simpleState.index + 1] == '~'
+        && (simpleFlags & SIMPLE_NEAR_OPERATOR) != 0) {
+      return simpleState.length > (simpleState.index + 2);
+    }
+    return false;
+  }
+
+  private void finishSimplePhrase(int start, int copied, boolean hasSlop) {
+    if (simpleState.index == simpleState.length) {
+      simpleState.index = start;
+    } else if (simpleState.index == start) {
+      simpleState.currentOperation = null;
+      simpleState.index++;
+    } else {
+      String phrase = new String(simpleState.buffer, 0, copied);
+      Query branch;
+      if (hasSlop) {
+        branch = simplePhraseFactory.apply(phrase, parseSimpleFuzziness());
+      } else {
+        branch = simplePhraseFactory.apply(phrase, 0);
+      }
+      buildSimpleQueryTree(branch);
+      simpleState.index++;
+    }
+  }
+
+  private void consumeSimpleToken() {
+    int copied = 0;
+    boolean escaped = false;
+    boolean prefix = false;
+    boolean fuzzy = false;
+    while (simpleState.index < simpleState.length) {
+      if (!escaped) {
+        if (isSimpleEscape(simpleState.data[simpleState.index])) {
+          escaped = true;
+          prefix = false;
+          simpleState.index++;
+          continue;
+        } else if (simpleTokenFinished()) {
+          break;
+        } else if (copied > 0
+            && simpleState.data[simpleState.index] == '~'
+            && (simpleFlags & SIMPLE_FUZZY_OPERATOR) != 0) {
+          fuzzy = true;
+          break;
+        }
+        prefix =
+            copied > 0
+                && simpleState.data[simpleState.index] == '*'
+                && (simpleFlags & SIMPLE_PREFIX_OPERATOR) != 0;
+      }
+      escaped = false;
+      simpleState.buffer[copied++] = simpleState.data[simpleState.index++];
+    }
+    if (copied > 0) {
+      buildSimpleQueryTree(buildSimpleTokenQuery(copied, prefix, fuzzy));
+    }
+  }
+
+  private Query buildSimpleTokenQuery(int copied, boolean prefix, boolean fuzzy) {
+    if (fuzzy && (simpleFlags & SIMPLE_FUZZY_OPERATOR) != 0) {
+      String token = new String(simpleState.buffer, 0, copied);
+      int fuzziness = parseSimpleFuzziness();
+      fuzziness = Math.min(fuzziness, LevenshteinAutomata.MAXIMUM_SUPPORTED_DISTANCE);
+      if (fuzziness == 0) {
+        return simpleDefaultFactory.apply(token);
+      }
+      return simpleFuzzyFactory.apply(token, fuzziness);
+    }
+    if (prefix) {
+      String token = new String(simpleState.buffer, 0, copied - 1);
+      return simplePrefixFactory.apply(token);
+    }
+    String token = new String(simpleState.buffer, 0, copied);
+    return simpleDefaultFactory.apply(token);
+  }
+
+  private BooleanQuery addSimpleClause(BooleanQuery bq, Query query, BooleanClause.Occur occur) {
+    BooleanQuery.Builder newBq = new BooleanQuery.Builder();
+    newBq.setMinimumNumberShouldMatch(bq.getMinimumNumberShouldMatch());
+    for (BooleanClause clause : bq) {
+      newBq.add(clause);
+    }
+    newBq.add(query, occur);
+    return newBq.build();
+  }
+
+  private void buildSimpleQueryTree(Query branch) {
+    if (branch == null) {
+      return;
+    }
+    branch = applySimpleNot(branch);
+    if (simpleState.top == null) {
+      simpleState.top = branch;
+    } else {
+      if (simpleState.currentOperation == null) {
+        simpleState.currentOperation = simpleDefaultOperator;
+      }
+      if (simpleState.previousOperation != simpleState.currentOperation) {
+        BooleanQuery.Builder bq = new BooleanQuery.Builder();
+        bq.add(simpleState.top, simpleState.currentOperation);
+        simpleState.top = bq.build();
+      }
+      simpleState.top = addSimpleClause((BooleanQuery) simpleState.top, branch, simpleState.currentOperation);
+      simpleState.previousOperation = simpleState.currentOperation;
+    }
+    simpleState.currentOperation = null;
+  }
+
+  private Query applySimpleNot(Query branch) {
+    if (simpleState.not % 2 == 1) {
+      BooleanQuery.Builder nq = new BooleanQuery.Builder();
+      nq.add(branch, BooleanClause.Occur.MUST_NOT);
+      nq.add(new MatchAllDocsQuery(), BooleanClause.Occur.SHOULD);
+      return nq.build();
+    }
+    return branch;
+  }
+
+  private int parseSimpleFuzziness() {
+    char[] slopText = new char[simpleState.length];
+    int slopLength = 0;
+    if (simpleState.data[simpleState.index] != '~') {
+      return 0;
+    }
+    while (simpleState.index < simpleState.length) {
+      simpleState.index++;
+      if (simpleState.index < simpleState.length) {
+        if (simpleTokenFinished()) {
+          break;
+        }
+        slopText[slopLength] = simpleState.data[simpleState.index];
+        slopLength++;
+      }
+    }
+    return decodeSimpleFuzziness(new String(slopText, 0, slopLength));
+  }
+
+  private int decodeSimpleFuzziness(String fuzzyString) {
+    int fuzziness = 0;
+    try {
+      if ("".equals(fuzzyString)) {
+        fuzziness = 2;
+      } else {
+        fuzziness = Integer.parseInt(fuzzyString);
+      }
+    } catch (
+        @SuppressWarnings("unused")
+        NumberFormatException e) {
+      fuzziness = 0;
+    }
+    if (fuzziness < 0) {
+      fuzziness = 0;
+    }
+    return fuzziness;
+  }
+
+  private boolean simpleTokenFinished() {
+    char current = simpleState.data[simpleState.index];
+    if (current == '"' && (simpleFlags & SIMPLE_PHRASE_OPERATOR) != 0) {
+      return true;
+    }
+    if (current == '|' && (simpleFlags & SIMPLE_OR_OPERATOR) != 0) {
+      return true;
+    }
+    if (current == '+' && (simpleFlags & SIMPLE_AND_OPERATOR) != 0) {
+      return true;
+    }
+    if (current == '(' && (simpleFlags & SIMPLE_PRECEDENCE_OPERATORS) != 0) {
+      return true;
+    }
+    if (current == ')' && (simpleFlags & SIMPLE_PRECEDENCE_OPERATORS) != 0) {
+      return true;
+    }
+    if (isSimpleWhitespace(current) && (simpleFlags & SIMPLE_WHITESPACE_OPERATOR) != 0) {
+      return true;
+    }
+    return false;
+  }
+
+  static final class SimpleSyntaxState {
+    final char[] data;
+    final char[] buffer;
+    int index;
+    int length;
+    BooleanClause.Occur currentOperation;
+    BooleanClause.Occur previousOperation;
+    int not;
+    Query top;
+
+    SimpleSyntaxState(char[] data, char[] buffer, int index, int length) {
+      this.data = data;
+      this.buffer = buffer;
+      this.index = index;
+      this.length = length;
+    }
+  }
