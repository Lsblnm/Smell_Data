+  private static final int SIMPLE_AND_OPERATOR = 1 << 0;
+  private static final int SIMPLE_NOT_OPERATOR = 1 << 1;
+  private static final int SIMPLE_OR_OPERATOR = 1 << 2;
+  private static final int SIMPLE_PREFIX_OPERATOR = 1 << 3;
+  private static final int SIMPLE_PHRASE_OPERATOR = 1 << 4;
+  private static final int SIMPLE_PRECEDENCE_OPERATORS = 1 << 5;
+  private static final int SIMPLE_ESCAPE_OPERATOR = 1 << 6;
+  private static final int SIMPLE_WHITESPACE_OPERATOR = 1 << 7;
+  private static final int SIMPLE_FUZZY_OPERATOR = 1 << 8;
+  private static final int SIMPLE_NEAR_OPERATOR = 1 << 9;
