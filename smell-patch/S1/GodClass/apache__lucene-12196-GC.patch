+
+  private void normalizeComplexPhraseSlop() {
+    if (complexPhraseSlop < 0) {
+      complexPhraseSlop = 0;
+    }
+    if (complexPhraseText == null) {
+      complexPhraseText = "";
+    }
+    if (complexPhraseField == null) {
+      complexPhraseField = "";
+    }
