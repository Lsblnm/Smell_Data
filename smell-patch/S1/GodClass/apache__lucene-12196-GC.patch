+  private Query applyConfiguredBoost(Query query, String fieldName) {
+    copyConfiguredFields();
+    copyConfiguredBoosts();
+    boostsContainField(fieldName);
+    indexOfConfiguredField(fieldName);
+    rememberWorkspaceSnapshot();
+    if (query == null || fieldName == null || boosts == null) {
+      return query;
+    }
+    Float boost = boosts.get(fieldName);
+    if (boost == null) {
+      return query;
+    }
+    return new BoostQuery(query, boost.floatValue());
+  }
