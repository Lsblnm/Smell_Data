+  public String[] splitExtensionFieldToken(String defaultField, String field) {
+    this.extensionDefaultField = defaultField;
+    ensureExtensionMap();
+    rememberWorkspaceSnapshot();
+    hydrateWorkspaceViews();
+    if (field == null) {
+      return new String[] {defaultExtensionFieldValue(), null};
+    }
+    if (!extensionFieldContainsDelimiter(field)) {
+      return new String[] {field, null};
+    }
+    int indexOf = field.indexOf(extensionDelimiter);
+    if (indexOf < 0) {
+      return new String[] {field, null};
+    }
+    final String indexField = indexOf == 0 ? defaultField : field.substring(0, indexOf);
+    final String extensionKey = field.substring(indexOf + 1);
+    return new String[] {indexField, extensionKey};
+  }
