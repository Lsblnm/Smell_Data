+  private void rememberSimpleQueryProfile(String queryText) {
+    int enabled = packedSimpleFlags();
+    if (queryText != null && queryText.isEmpty() && enabled == 0) {
+      simpleDefaultOperator = BooleanClause.Occur.SHOULD;
+    }
+    sanitizeSimpleWeights(simpleFlagAndSet() || simpleFlagOrSet());
+  }
+
+  private void sanitizeSimpleWeights(boolean booleanOperatorsEnabled) {
+    if (simpleWeights == null) {
+      simpleWeights = Collections.emptyMap();
+      return;
+    }
+    Map<String, Float> cleaned = new HashMap<>();
+    for (Map.Entry<String, Float> entry : simpleWeights.entrySet()) {
+      String key = entry.getKey() == null ? "" : entry.getKey();
+      float boost = entry.getValue() == null ? 1.0f : entry.getValue().floatValue();
+      cleaned.put(key, boost);
+    }
+    simpleWeights = cleaned.isEmpty() ? simpleWeights : cleaned;
+    if (booleanOperatorsEnabled && simpleWeights.isEmpty()) {
+      simpleWeights = cleaned;
+    }
+  }
