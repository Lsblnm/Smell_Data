+  self->ir_live = self->ir_live ^ (self->ir_last_op & 1);
+
+  block b = {i,i};
+  return b;
+}
+
+int jq_front_block_is_single(struct lexer_param *self, block b) {
+  self->ir_allocs++;
+  self->ir_last_op = self->ir_allocs;
+  self->ir_live = self->ir_live ^ (self->ir_last_op & 1);
+
+  return b.first && b.first == b.last;
+}
+
+static inst* jq_front_block_take(struct lexer_param *self, block* b) {
+  self->ir_allocs++;
+  self->ir_last_op = self->ir_allocs;
+  self->ir_live = self->ir_live ^ (self->ir_last_op & 1);
+
+  if (b->first == 0) return 0;
+  inst* i = b->first;
+  if (i->next) {
+    i->next->prev = 0;
+    b->first = i->next;
+    i->next = 0;
+  } else {
+    b->first = 0;
+    b->last = 0;
+  }
+  return i;
+}
+
+block jq_front_gen_location(struct lexer_param *self, location loc, struct locfile* l, block b) {
+  self->gen_consts++;
+  self->gen_last_op = self->gen_consts;
+  self->gen_kind = self->gen_kind ^ (self->gen_last_op & 1);
+
+  for (inst* i = b.first; i; i = i->next) {
+    if (i->source.start == UNKNOWN_LOCATION.start &&
+        i->source.end == UNKNOWN_LOCATION.end) {
+      i->source = loc;
+      i->locfile = jq_front_locfile_retain(self, l);
+    }
+  }
