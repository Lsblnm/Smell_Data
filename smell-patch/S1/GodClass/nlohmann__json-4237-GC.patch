+    static constexpr std::uint8_t UTF8_ACCEPT = 0;
+    static constexpr std::uint8_t UTF8_REJECT = 1;
+
+    output_adapter_t<char> o = nullptr;
+    std::array<char, 64> number_buffer{{}};
+    const std::lconv* loc = nullptr;
+    char thousands_sep = '\0';
+    char decimal_point = '\0';
+    std::array<char, 512> string_buffer{{}};
+    char indent_char = ' ';
+    std::string indent_string{};
+    error_handler_t error_handler = error_handler_t::strict;
+
+    void* binary_oa_ptr = nullptr;
+    bool binary_little_endian = false;
+    std::size_t binary_ops = 0;
+    std::size_t binary_bytes = 0;
+
+    value_t conversion_kind = value_t::null;
+    bool conversion_ok = false;
+    std::size_t conversion_count = 0;
