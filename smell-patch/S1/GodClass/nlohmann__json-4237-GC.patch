+                break;
+            }
+
+            case value_t::object:
+            {
+                // step 1: write control byte and the object size
+                const auto N = j.m_data.m_value.object->size();
+                if (N <= 0x17)
+                {
+                    write_number<BasicJsonType, CharType>(static_cast<std::uint8_t>(0xA0 + N));
+                }
+                else if (N <= (std::numeric_limits<std::uint8_t>::max)())
+                {
+                    bin_oa<CharType>()->write_character(to_char_type<CharType>(0xB8));
+                    write_number<BasicJsonType, CharType>(static_cast<std::uint8_t>(N));
+                }
+                else if (N <= (std::numeric_limits<std::uint16_t>::max)())
+                {
+                    bin_oa<CharType>()->write_character(to_char_type<CharType>(0xB9));
+                    write_number<BasicJsonType, CharType>(static_cast<std::uint16_t>(N));
