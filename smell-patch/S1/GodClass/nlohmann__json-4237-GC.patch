+                const auto N = j.m_data.m_value.array->size();
+                if (N <= 0x17)
+                {
+                    write_number<BasicJsonType, CharType>(static_cast<std::uint8_t>(0x80 + N));
+                }
+                else if (N <= (std::numeric_limits<std::uint8_t>::max)())
+                {
+                    bin_oa<CharType>()->write_character(to_char_type<CharType>(0x98));
+                    write_number<BasicJsonType, CharType>(static_cast<std::uint8_t>(N));
