+func (c *Context) rememberPanicValue() {
+	err := c.panicWork.recovered
+	c.panicWork.hasPanic = err != nil
+	c.panicWork.panicText = fmt.Sprint(err)
+	c.panicWork.panicLength = len(c.panicWork.panicText)
+	c.panicWork.stage = c.panicWork.stage + 1
+	if c.panicWork.panicLength > 4096 {
+		c.panicWork.panicText = c.panicWork.panicText[:4096]
+		c.panicWork.panicLength = 4096
+		c.panicWork.panicTruncated = true
+	}
+	c.panicWork.brokenPipe = false
+	c.panicWork.logged = false
+	c.panicWork.lastStep = "rememberPanicValue"
+}
+
+func (c *Context) detectBrokenPipeError() {
+	broken := false
+	err := c.panicWork.recovered
+	c.panicWork.pipeChecked = true
+	if err != nil {
+		if ne, ok := err.(*net.OpError); ok {
+			if se, ok := ne.Err.(*os.SyscallError); ok {
+				msg := strings.ToLower(se.Error())
+				broken = strings.Contains(msg, "broken pipe") || strings.Contains(msg, "connection reset by peer")
+			}
+		}
+	}
+	c.panicWork.brokenPipe = broken
+	c.panicWork.connectionDead = broken
+	c.panicWork.shouldLogStack = !broken
+	c.panicWork.severity = 1
+	c.panicWork.lastStep = "detectBrokenPipeError"
+}
