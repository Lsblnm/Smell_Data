+func (c *Context) computeLogLatencyValue() {
+	latency := c.logWork.end.Sub(c.logWork.start)
+	c.logWork.latency = latency
+	if latency < 0 {
+		c.logWork.latency = 0
+		latency = 0
+	}
+	c.logWork.latencyNanos = latency.Nanoseconds()
+	c.logWork.latencyMillis = latency.Milliseconds()
+	c.logWork.slowRequest = latency >= time.Second
+	c.logWork.verySlowRequest = latency >= 5*time.Second
+}
+
+func (c *Context) truncateLogLatencyIfNeeded() {
+	latency := c.logWork.latency
+	truncated := false
+	if latency > time.Minute {
+		latency = latency - latency%time.Second
+		truncated = true
+	}
+	c.logWork.latency = latency
+	c.logWork.latencyTruncated = truncated
+	c.logWork.latencySeconds = latency.Seconds()
+	c.logWork.latencyOverMinute = truncated
+	c.logWork.latencyLabel = latency.String()
+}
