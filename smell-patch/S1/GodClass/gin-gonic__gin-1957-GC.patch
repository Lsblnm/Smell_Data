+func (c *Context) dumpPanicRequest() {
+	dumped := ""
+	c.panicWork.stage = c.panicWork.stage + 1
+	if c.panicWork.request != nil {
+		httpRequest, err := httputil.DumpRequest(c.panicWork.request, false)
+		if err == nil {
+			dumped = string(httpRequest)
+		}
+	}
+	c.panicWork.requestDump = dumped
