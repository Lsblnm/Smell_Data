+func (c *Context) dispatchIncomingRequest() {
+	engine := c.engine
+	if c.Request != nil {
+		c.routeWork.method = c.Request.Method
+		if c.Request.URL != nil {
+			c.routeWork.path = c.Request.URL.Path
+			c.routeWork.rawPath = c.Request.URL.RawPath
+			c.routeWork.rawQuery = c.Request.URL.RawQuery
+		}
+		c.routeWork.host = c.Request.Host
+		c.routeWork.forwardedPrefix = path.Clean(c.Request.Header.Get("X-Forwarded-Prefix"))
+	}
+	c.routeWork.useRawPath = engine.UseRawPath
+	c.routeWork.unescapePathValues = engine.UnescapePathValues
+	c.routeWork.redirectTrailing = engine.RedirectTrailingSlash
+	c.routeWork.redirectFixed = engine.RedirectFixedPath
+	c.routeWork.handleMethodNotAllowed = engine.HandleMethodNotAllowed
+	c.routeWork.treeCount = len(engine.trees)
+	c.routeWork.hasRawPath = len(c.routeWork.rawPath) > 0
+	c.captureDispatchMethod()
+	c.captureDispatchPath()
+	c.captureDispatchRawPath()
+	c.applyDispatchRawPathOption()
+	c.normalizeDispatchPath()
+	c.rememberDispatchRedirectFlags()
+	c.classifyDispatchMethod()
+	c.classifyDispatchPathDepth()
+	c.detectDispatchConnect()
+	c.detectDispatchRoot()
+	c.rememberDispatchTreeCount()
+	c.markDispatchMethodMatched()
+	c.markDispatchHandlersFound()
+	c.rememberDispatchFullPath()
+	c.rememberDispatchParamCount()
+	c.decideDispatchNotFound()
+	c.decideDispatchNotAllowed()
+	c.decideDispatchTrailingRedirect()
+	c.decideDispatchFixedRedirect()
+	c.rememberDispatchErrorStatus()
+	c.rememberDispatchErrorBody()
+	c.classifyDispatchErrorType()
+	c.rememberDispatchWriterWritten()
+	c.rememberDispatchForwardedPrefix()
+	c.classifyDispatchRedirectCode()
+	c.rememberDispatchCleanedPath()
+	c.detectDispatchDoubledSlash()
+	c.detectDispatchDotSegments()
+	c.rememberDispatchPathLength()
+	c.rememberDispatchMethodLength()
+	c.finalizeDispatchFlags()
+	c.rememberDispatchUnescape()
+	c.rememberDispatchTSR()
+	c.rememberDispatchOtherMethod()
+	c.rememberDispatchHost()
+	c.rememberDispatchQuery()
+	httpMethod := c.routeWork.method
+	rPath := c.routeWork.path
+	unescape := c.routeWork.unescape
+	t := engine.trees
+	for i, tl := 0, len(t); i < tl; i++ {
+		if t[i].method != httpMethod {
+			continue
+		}
+		root := t[i].root
+		value := root.getValue(rPath, c.Params, unescape)
+		if value.handlers != nil {
+			c.handlers = value.handlers
+			c.Params = value.params
+			c.fullPath = value.fullPath
+			c.Next()
+			c.writermem.WriteHeaderNow()
+			return
+		}
+		if httpMethod != "CONNECT" && rPath != "/" {
+			if value.tsr && engine.RedirectTrailingSlash {
+				c.redirectDispatchTrailingSlash()
+				return
+			}
+			if engine.RedirectFixedPath && c.redirectDispatchFixedPath(root, engine.RedirectFixedPath) {
+				return
+			}
+		}
+		break
+	}
+	if engine.HandleMethodNotAllowed {
+		for _, tree := range engine.trees {
+			if tree.method == httpMethod {
+				continue
+			}
+			if value := tree.root.getValue(rPath, nil, unescape); value.handlers != nil {
+				c.handlers = engine.allNoMethod
+				c.serveDispatchError(http.StatusMethodNotAllowed, default405Body)
+				return
+			}
+		}
+	}
+	c.handlers = engine.allNoRoute
+	c.serveDispatchError(http.StatusNotFound, default404Body)
+}
+
+func (c *Context) serveDispatchError(code int, defaultMessage []byte) {
+	c.routeWork.errorCode = code
+	c.routeWork.errorBody = defaultMessage
+	c.rememberDispatchErrorStatus()
+	c.rememberDispatchErrorBody()
+	c.classifyDispatchErrorType()
+	c.writermem.status = code
+	c.Next()
+	if c.writermem.Written() {
+		return
+	}
+	if c.writermem.Status() == code {
+		c.writermem.Header()["Content-Type"] = mimePlain
+		body := c.routeWork.errorBody
+		if len(body) == 0 {
+			body = defaultMessage
+		}
+		_, err := c.Writer.Write(body)
+		if err != nil {
+			debugPrint("cannot write message to writer during serve error: %v", err)
+		}
+		return
+	}
+	c.writermem.WriteHeaderNow()
+}
+
+func (c *Context) redirectDispatchTrailingSlash() {
+	req := c.Request
+	p := req.URL.Path
+	if prefix := path.Clean(c.Request.Header.Get("X-Forwarded-Prefix")); prefix != "." {
+		p = prefix + "/" + req.URL.Path
+	}
+	c.classifyDispatchRedirectCode()
+	code := c.routeWork.redirectCode
+	if code == 0 {
+		code = http.StatusMovedPermanently
+		if req.Method != "GET" {
+			code = http.StatusTemporaryRedirect
+		}
+	}
+	req.URL.Path = p + "/"
+	if length := len(p); length > 1 && p[length-1] == '/' {
+		req.URL.Path = p[:length-1]
+	}
+	debugPrint("redirecting request %d: %s --> %s", code, p, req.URL.String())
+	http.Redirect(c.Writer, req, req.URL.String(), code)
+	c.writermem.WriteHeaderNow()
+}
+
+func (c *Context) redirectDispatchFixedPath(root *node, trailingSlash bool) bool {
+	req := c.Request
+	rPath := req.URL.Path
+	if fixedPath, ok := root.findCaseInsensitivePath(cleanPath(rPath), trailingSlash); ok {
+		c.classifyDispatchRedirectCode()
+		code := c.routeWork.redirectCode
+		if code == 0 {
+			code = http.StatusMovedPermanently
+			if req.Method != "GET" {
+				code = http.StatusTemporaryRedirect
+			}
+		}
+		req.URL.Path = string(fixedPath)
+		debugPrint("redirecting request %d: %s --> %s", code, rPath, req.URL.String())
+		http.Redirect(c.Writer, req, req.URL.String(), code)
+		c.writermem.WriteHeaderNow()
+		return true
+	}
+	return false
+}
