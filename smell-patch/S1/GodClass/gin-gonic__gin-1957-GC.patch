+func (c *Context) captureLogStartClock() {
+	c.logWork.start = time.Now()
+	c.logWork.prepared = true
+	c.logWork.startUnix = c.logWork.start.Unix()
+	c.logWork.startHour = c.logWork.start.Hour()
+	c.logWork.startMinute = c.logWork.start.Minute()
+	c.logWork.startNano = c.logWork.start.UnixNano()
+	if c.logWork.path == "" {
+		c.logWork.path = "/"
+		c.logWork.pathLength = 1
+		c.logWork.rootPath = true
+	}
+	c.logWork.pathLength = len(c.logWork.path)
+	c.logWork.queryLength = len(c.logWork.rawQuery)
+	c.logWork.queryPresent = c.logWork.rawQuery != ""
+	c.logWork.absolutePath = strings.HasPrefix(c.logWork.path, "/")
+}
+
+func (c *Context) normalizeLogPathValue() {
+	path := c.logWork.path
+	c.logWork.pathSegments = strings.Count(path, "/")
+	c.logWork.pathLength = len(path)
+	if path == "" {
+		path = "/"
+		c.logWork.rootPath = true
+	}
+	c.logWork.path = path
+	c.logWork.pathLength = len(path)
+	c.logWork.absolutePath = len(path) > 0 && path[0] == '/'
+	c.logWork.trailingPathSlash = len(path) > 1 && path[len(path)-1] == '/'
+	c.logWork.rootPath = path == "/"
+}
+
+func (c *Context) normalizeLogRawQuery() {
+	raw := c.logWork.rawQuery
+	c.logWork.rawQuery = raw
+	c.logWork.queryLength = len(raw)
+	if raw != "" {
+		c.logWork.queryPairs = strings.Count(raw, "&") + 1
+		c.logWork.queryPresent = true
+	}
+	c.logWork.queryEncoded = strings.Contains(raw, "%")
+	c.logWork.queryHasAssign = strings.Contains(raw, "=")
+	c.logWork.queryHasAmp = strings.Contains(raw, "&")
+	c.logWork.queryPresent = raw != ""
+}
+
+func (c *Context) rememberLogSkipSet() {
+	skip := c.logWork.skip
+	c.logWork.skipCount = len(skip)
+	c.logWork.hasSkipList = skip != nil && len(skip) > 0
+	matched := false
+	if c.logWork.hasSkipList {
+		_, matched = skip[c.logWork.path]
+	}
+	c.logWork.skipMatched = matched
+	c.logWork.skipped = matched
+	c.logWork.skipPath = c.logWork.path
+	c.logWork.skipEmpty = !c.logWork.hasSkipList
+}
+
+func (c *Context) captureLogTerminalFlag() {
+	term := c.logWork.isTerm
+	c.logWork.colorForced = consoleColorMode == forceColor
+	c.logWork.colorDisabled = consoleColorMode == disableColor
+	if c.logWork.colorDisabled {
+		c.logWork.useColor = false
+	}
+	c.logWork.isTerm = term
+	c.logWork.colorModeValue = int(consoleColorMode)
+	c.logWork.colorReady = c.logWork.useColor
+}
