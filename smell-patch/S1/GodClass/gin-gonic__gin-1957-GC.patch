+func (c *Context) recoverRequestPanic(logger *log.Logger) {
+	err := recover()
+	if err == nil {
+		return
+	}
+	c.panicWork.recovered = err
+	c.panicWork.logger = logger
+	c.panicWork.request = c.Request
+	c.panicWork.skip = 3
+	c.rememberPanicValue()
+	c.detectBrokenPipeError()
+	c.dumpPanicRequest()
+	c.sanitizePanicHeaders()
+	c.collectPanicStack()
+	c.formatPanicTime()
+	c.classifyPanicSeverity()
+	c.preparePanicLogMessage()
+	c.selectPanicLogTemplate()
+	c.rememberPanicSkipFrames()
+	c.trimPanicStack()
+	c.markPanicLogged()
+	c.decidePanicResponse()
+	c.rememberPanicRequestMethod()
+	c.rememberPanicRequestPath()
+	c.countPanicHeaderLines()
+	c.classifyPanicErrorType()
+	c.preparePanicAbortFlags()
+	c.rememberPanicLoggerPrefix()
+	c.finalizePanicStackState()
+	c.normalizePanicText()
+	c.rememberPanicTimeZone()
+	c.markPanicHeadersReady()
+	c.decidePanicStackInclusion()
+	c.rememberPanicConnectionState()
+	c.countPanicStackLines()
+	c.preparePanicPublicMessage()
+	c.finalizePanicLogKind()
+	c.rememberPanicRequestHost()
+	c.rememberPanicContentType()
+	c.rememberPanicUserAgent()
+	c.classifyPanicHTTPVersion()
+	c.rememberPanicRemoteAddr()
+	c.rememberPanicReferer()
+	c.finalizePanicFlags()
+	c.rememberPanicQuery()
+	if logger != nil {
+		stackBytes := c.panicWork.stack
+		if c.panicWork.brokenPipe {
+			logger.Printf("%s\n%s%s", err, c.panicWork.requestDump, reset)
+		} else if c.panicWork.debugMode {
+			logger.Printf("[Recovery] %s panic recovered:\n%s\n%s\n%s%s",
+				c.panicWork.timeLabel, c.panicWork.sanitizedHeaders, err, stackBytes, reset)
+		} else {
+			logger.Printf("[Recovery] %s panic recovered:\n%s\n%s%s",
+				c.panicWork.timeLabel, err, stackBytes, reset)
+		}
+	}
+	if c.panicWork.brokenPipe {
+		c.Error(err.(error))
+		c.Abort()
+		return
+	}
+	c.AbortWithStatus(http.StatusInternalServerError)
