+func (c *Context) clampLogStatusValue() {
+	code := c.logWork.status
+	if code <= 0 {
+		code = 200
+	}
+	c.logWork.status = code
+	c.logWork.statusClass = code / 100
+	c.logWork.statusRemainder = code % 100
+	c.logWork.statusText = http.StatusText(code)
