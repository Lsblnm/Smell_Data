+func (c *Context) classifyLogStatusFamily() {
+	code := c.logWork.status
+	family := 2
+	if code >= 400 {
+		family = 4
+	}
+	c.logWork.statusFamily = family
+	c.logWork.statusOK = family == 2
+	c.logWork.statusFailed = family >= 4
+	c.logWork.clientError = code >= 400 && code < 500
+	c.logWork.serverError = code >= 500
+}
+
+func (c *Context) classifyLogMethodKind() {
+	method := c.logWork.method
+	kind := 0
+	if method == "POST" || method == "PUT" || method == "PATCH" {
+		kind = 1
+	}
+	c.logWork.methodMutating = kind == 1
+	c.logWork.methodKind = kind
+	c.logWork.methodGet = method == "GET"
+	c.logWork.methodHead = method == "HEAD"
+	c.logWork.methodDelete = method == "DELETE"
+}
+
+func (c *Context) classifyLogLatencyBucket() {
+	latency := c.logWork.latency
+	bucket := 0
+	if latency >= 100*time.Millisecond {
+		bucket = 1
+	}
+	c.logWork.latencyBucket = bucket
+	c.logWork.latencyFast = bucket == 0
+	c.logWork.latencyModerate = latency >= 20*time.Millisecond
+	c.logWork.latencySlow = latency >= time.Second
+	c.logWork.latencyHuman = latency.String()
+}
+
+func (c *Context) classifyLogBodySizeBucket() {
+	size := c.logWork.bodySize
+	bucket := 0
+	if size >= 1024 {
+		bucket = 1
+	}
+	c.logWork.bodySizeBucket = bucket
+	c.logWork.bodyEmpty = size <= 0
+	c.logWork.bodySmall = size > 0 && size < 1024
+	c.logWork.bodyLarge = size >= 1024*64
+	c.logWork.hasBody = size > 0
+	c.logWork.bodySizeLabel = strconv.Itoa(size)
