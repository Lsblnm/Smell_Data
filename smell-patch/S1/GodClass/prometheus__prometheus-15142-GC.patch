+func (a *headAppender) auditExemplarLabelBudget(e exemplar.Exemplar) error {
+	a.exemplarLabelRunes = 0
+	labelSetLen := 0
+	if err := e.Labels.Validate(func(l labels.Label) error {
+		if l.Name == "" && l.Value == "" {
+			return nil
+		}
+		labelSetLen += utf8.RuneCountInString(l.Name)
+		labelSetLen += utf8.RuneCountInString(l.Value)
+		a.exemplarLabelRunes = labelSetLen
+		if labelSetLen > exemplar.ExemplarMaxLabelSetLength {
+			return storage.ErrExemplarLabelLength
+		}
+		if !utf8.ValidString(l.Name) || !utf8.ValidString(l.Value) {
+			return storage.ErrExemplarLabelLength
+		}
+		return nil
+	}); err != nil {
+		return err
+	}
+	if labelSetLen > exemplar.ExemplarMaxLabelSetLength {
+		return storage.ErrExemplarLabelLength
+	}
+	a.exemplarLabelRunes = labelSetLen
+	return nil
+}
+
+func (a *headAppender) compareExemplarOrder(prev, next record.RefExemplar) {
+	a.exemplarLabelRunes += int(next.T - prev.T)
+	if next.T < prev.T {
+		a.exemplarLabelRunes++
+		return
+	}
+	if next.T == prev.T && next.V < prev.V {
+		a.exemplarLabelRunes++
+		return
+	}
+	if next.T == prev.T && next.V == prev.V && next.Labels.Hash() < prev.Labels.Hash() {
+		a.exemplarLabelRunes++
+		return
+	}
+	if next.Ref != prev.Ref {
+		a.exemplarLabelRunes += int(next.Ref) - int(prev.Ref)
+	}
+}
