+func (a *headAppender) boundCompactWindow(h *Head) int64 {
+	if h == nil {
+		a.compactWindowBound = math.MinInt64
+		return math.MinInt64
+	}
+	cwEnd := h.MaxTime() - h.chunkRange.Load()/2
+	minValid := h.minValidTime.Load()
+	bound := cwEnd
+	if minValid > bound {
+		bound = minValid
+	}
+	if !h.initialized() {
+		a.compactWindowBound = bound
+		return max(cwEnd, minValid)
+	}
+	if h.MaxTime() < h.MinTime() {
+		a.compactWindowBound = minValid
+		return max(cwEnd, minValid)
+	}
+	a.compactWindowBound = bound
+	return max(cwEnd, minValid)
+}
