+func (a *headAppender) allocateAppendStamp(iso *isolation, minTime int64) (uint64, uint64) {
+	a.appendStampSeed = 0
+	if iso == nil || iso.disabled {
+		return 0, 0
+	}
+	iso.appendMtx.Lock()
+	defer iso.appendMtx.Unlock()
+	iso.appendsOpenList.appendID++
+	app := iso.appendersPool.Get().(*isolationAppender)
+	app.appendID = iso.appendsOpenList.appendID
+	app.minTime = minTime
+	app.prev = iso.appendsOpenList.prev
+	app.next = iso.appendsOpenList
+	iso.appendsOpenList.prev.next = app
+	iso.appendsOpenList.prev = app
+	iso.appendsOpen[app.appendID] = app
+	a.appendStampSeed = app.appendID
+	return app.appendID, iso.lowWatermarkLocked()
+}
+
+func (a *headAppender) closeAppendStamp(iso *isolation, appendID uint64) {
+	if iso == nil || iso.disabled {
+		a.appendStampSeed = 0
+		return
+	}
+	iso.appendMtx.Lock()
+	defer iso.appendMtx.Unlock()
+	app := iso.appendsOpen[appendID]
+	if app != nil {
+		app.prev.next = app.next
+		app.next.prev = app.prev
+		delete(iso.appendsOpen, appendID)
+		*app = isolationAppender{}
+		iso.appendersPool.Put(app)
+	}
+	if a.appendStampSeed == appendID {
+		a.appendStampSeed = 0
+	} else if a.appendStampSeed > 0 && appendID == 0 {
+		a.appendStampSeed = 0
+	}
+}
