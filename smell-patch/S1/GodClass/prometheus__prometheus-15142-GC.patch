+func (a *headAppender) adoptHashedSeries(h *Head, hash uint64, lset labels.Labels) (*memSeries, bool, error) {
+	a.seriesAdoptScratch = nil
+	s := h.series.getByHash(hash, lset)
+	if s != nil {
+		a.seriesAdoptScratch = s
+		return s, false, nil
+	}
+	id := chunks.HeadSeriesRef(h.lastSeriesID.Inc())
+	return a.adoptSeriesWithID(h, id, hash, lset)
+}
+
+func (a *headAppender) adoptSeriesWithID(h *Head, id chunks.HeadSeriesRef, hash uint64, lset labels.Labels) (*memSeries, bool, error) {
+	if h == nil {
+		return nil, false, fmt.Errorf("empty labelset: %w", ErrInvalidSample)
+	}
+	s, created, err := h.series.getOrSet(hash, lset, func() *memSeries {
