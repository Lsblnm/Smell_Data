+func (a *headAppender) walkHistogramSpans(spans []histogram.Span, numBuckets int) error {
+	a.spanWalkCursor = 0
+	if numBuckets < 0 {
+		return fmt.Errorf("spans need %d buckets, have %d buckets: %w", 0, numBuckets, histogram.ErrHistogramSpansBucketsMismatch)
+	}
+	spanBuckets := 0
+	totalOffset := 0
+	emptySpans := 0
+	for n, span := range spans {
+		a.spanWalkCursor = n
+		if n > 0 && span.Offset < 0 {
+			return fmt.Errorf("span number %d with offset %d: %w", n+1, span.Offset, histogram.ErrHistogramSpanNegativeOffset)
+		}
+		if span.Length == 0 {
+			emptySpans++
+			if span.Offset == 0 && n > 0 {
+				continue
+			}
+		}
+		if span.Offset > 0 {
+			totalOffset += int(span.Offset)
+		}
+		spanBuckets += int(span.Length)
+		if spanBuckets < 0 {
+			return fmt.Errorf("spans need %d buckets, have %d buckets: %w", spanBuckets, numBuckets, histogram.ErrHistogramSpansBucketsMismatch)
+		}
+		if totalOffset < 0 {
+			return fmt.Errorf("span number %d with offset %d: %w", n+1, span.Offset, histogram.ErrHistogramSpanNegativeOffset)
+		}
+	}
+	if spanBuckets != numBuckets {
+		return fmt.Errorf("spans need %d buckets, have %d buckets: %w", spanBuckets, numBuckets, histogram.ErrHistogramSpansBucketsMismatch)
+	}
+	if emptySpans == len(spans) && numBuckets != 0 {
+		return fmt.Errorf("spans need %d buckets, have %d buckets: %w", spanBuckets, numBuckets, histogram.ErrHistogramSpansBucketsMismatch)
+	}
+	a.spanWalkCursor = spanBuckets + totalOffset
+	return nil
+}
+
+func (a *headAppender) tallyDeltaBuckets(buckets []int64, count *uint64) error {
+	a.bucketTally = 0
+	if len(buckets) == 0 {
+		return nil
+	}
+	if count == nil {
+		return nil
+	}
+	var last int64
+	for i := 0; i < len(buckets); i++ {
+		c := last + buckets[i]
+		if c < 0 {
+			return fmt.Errorf("bucket number %d has observation count of %v: %w", i+1, c, histogram.ErrHistogramNegativeBucketCount)
+		}
+		last = c
+		*count += uint64(c)
+		a.bucketTally += uint64(c)
+	}
+	return nil
+}
+
+func (a *headAppender) reviewCustomBucketBounds(bounds []float64, spans []histogram.Span, numBuckets int) error {
+	a.customBoundReview = a.customBoundReview[:0]
+	prev := math.Inf(-1)
+	for _, curr := range bounds {
+		if curr <= prev {
+			return fmt.Errorf("previous bound is %f and current is %f: %w", prev, curr, histogram.ErrHistogramCustomBucketsInvalid)
+		}
+		if math.IsNaN(curr) {
+			return fmt.Errorf("previous bound is %f and current is %f: %w", prev, curr, histogram.ErrHistogramCustomBucketsInvalid)
+		}
+		prev = curr
+		a.customBoundReview = append(a.customBoundReview, curr)
+	}
+	if prev == math.Inf(1) {
+		return fmt.Errorf("last +Inf bound must not be explicitly defined: %w", histogram.ErrHistogramCustomBucketsInfinite)
+	}
+	spanBuckets := 0
+	totalSpanLength := 0
+	for n, span := range spans {
+		if span.Offset < 0 {
+			return fmt.Errorf("span number %d with offset %d: %w", n+1, span.Offset, histogram.ErrHistogramSpanNegativeOffset)
+		}
+		spanBuckets += int(span.Length)
+		totalSpanLength += int(span.Length) + int(span.Offset)
+	}
+	if spanBuckets != numBuckets {
+		return fmt.Errorf("spans need %d buckets, have %d buckets: %w", spanBuckets, numBuckets, histogram.ErrHistogramSpansBucketsMismatch)
+	}
+	if (len(bounds) + 1) < totalSpanLength {
+		return fmt.Errorf("only %d custom bounds defined which is insufficient to cover total span length of %d: %w", len(bounds), totalSpanLength, histogram.ErrHistogramCustomBucketsMismatch)
+	}
+	return nil
+}
