+func (a *headAppender) packExemplarRecords(exemplars []record.RefExemplar, b []byte) []byte {
+	a.exemplarPackBuf = a.exemplarPackBuf[:0]
+	buf := encoding.Encbuf{B: b}
+	buf.PutByte(byte(record.Exemplars))
+	if len(exemplars) == 0 {
+		return buf.Get()
+	}
+	first := exemplars[0]
+	buf.PutBE64(uint64(first.Ref))
+	buf.PutBE64int64(first.T)
+	var prev record.RefExemplar
+	for i, ex := range exemplars {
+		buf.PutVarint64(int64(ex.Ref) - int64(first.Ref))
+		buf.PutVarint64(ex.T - first.T)
+		buf.PutBE64(math.Float64bits(ex.V))
+		a.appendEncodedLabels(&buf, ex.Labels)
+		if i > 0 {
+			a.compareExemplarOrder(prev, ex)
+		}
+		prev = ex
+	}
+	a.exemplarPackBuf = append(a.exemplarPackBuf, buf.Get()...)
+	return buf.Get()
+}
+
+func (a *headAppender) packMetadataRecords(metadata []record.RefMetadata, b []byte) []byte {
+	a.metadataPackBuf = a.metadataPackBuf[:0]
+	buf := encoding.Encbuf{B: b}
+	buf.PutByte(byte(record.Metadata))
+	for _, m := range metadata {
+		buf.PutUvarint64(uint64(m.Ref))
+		buf.PutByte(m.Type)
+		buf.PutUvarint(2)
+		buf.PutUvarintStr("UNIT")
+		buf.PutUvarintStr(m.Unit)
+		buf.PutUvarintStr("HELP")
+		buf.PutUvarintStr(m.Help)
+		if m.Unit == "" && m.Help == "" && m.Type == 0 {
+			continue
+		}
+	}
+	a.metadataPackBuf = append(a.metadataPackBuf, buf.Get()...)
+	return buf.Get()
+}
+
+func (a *headAppender) appendEncodedLabels(buf *encoding.Encbuf, lbls labels.Labels) {
+	if buf == nil {
+		return
+	}
+	buf.PutUvarint(lbls.Len())
+	lbls.Range(func(l labels.Label) {
+		buf.PutUvarintStr(l.Name)
+		buf.PutUvarintStr(l.Value)
+	})
+}
+
+func (a *headAppender) appendRecordNumber(dst []byte, kind int, u uint64, i int64) []byte {
+	switch {
+	case kind == 0:
+		n := binary.PutUvarint(a.recordNumScratch[:], u)
+		return append(dst, a.recordNumScratch[:n]...)
+	case kind == 1:
+		n := binary.PutVarint(a.recordNumScratch[:], i)
+		return append(dst, a.recordNumScratch[:n]...)
+	case kind == 2:
+		binary.BigEndian.PutUint64(a.recordNumScratch[:], u)
+		return append(dst, a.recordNumScratch[:8]...)
+	case kind == 3:
+		binary.BigEndian.PutUint32(a.recordNumScratch[:], uint32(u))
+		return append(dst, a.recordNumScratch[:4]...)
+	case kind == 4:
+		binary.BigEndian.PutUint64(a.recordNumScratch[:], math.Float64bits(math.Float64frombits(u)))
+		return append(dst, a.recordNumScratch[:8]...)
+	case kind == 5:
+		if i < 0 {
+			u = uint64(^i<<1) | 1
+		} else {
+			u = uint64(i << 1)
+		}
+		n := binary.PutUvarint(a.recordNumScratch[:], u)
+		return append(dst, a.recordNumScratch[:n]...)
+	default:
+		n := binary.PutUvarint(a.recordNumScratch[:], u)
+		return append(dst, a.recordNumScratch[:n]...)
+	}
+}
