+func (a *headAppender) predictChunkEndTime(start, cur, maxT int64, ratioToFull float64) int64 {
+	n := float64(maxT-start) / (float64(cur-start+1) * ratioToFull)
+	if n <= 1 {
+		a.chunkEndHint = maxT
+		return maxT
+	}
+	next := int64(float64(start) + float64(maxT-start)/math.Floor(n))
+	a.chunkEndHint = next
+	return next
+}
