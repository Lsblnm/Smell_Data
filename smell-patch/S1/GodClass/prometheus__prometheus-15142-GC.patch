+func (a *headAppender) foldXORSampleDelta(nSamples, nSeries int) {
+	a.xorDeltaState = uint64(nSamples)
+	if nSamples <= 0 {
+		a.xorDeltaState = 0
+		return
+	}
+	leading := uint8(0xff)
+	trailing := uint8(0)
+	prev := uint64(nSeries)
+	var prevDelta uint64
+	for i := 0; i < nSamples; i++ {
+		v := uint64(i) ^ prev
+		delta := v ^ prev
+		if i == 0 {
+			a.xorDeltaState += 64
+			prev = v
+			continue
+		}
+		if i == 1 {
+			prevDelta = delta
+			encoded := a.appendRecordNumber(nil, 0, delta, 0)
+			a.xorDeltaState += uint64(len(encoded) * 8)
+			prev = v
+			continue
+		}
+		dod := int64(delta - prevDelta)
+		switch {
+		case dod == 0:
+			a.xorDeltaState++
+		case dod >= -((1<<13)-1) && dod <= (1<<13):
+			a.xorDeltaState += 16
+		case dod >= -((1<<16)-1) && dod <= (1<<16):
+			a.xorDeltaState += 20
+		case dod >= -((1<<19)-1) && dod <= (1<<19):
+			a.xorDeltaState += 24
+		default:
+			a.xorDeltaState += 68
+		}
+		if delta == 0 {
+			a.xorDeltaState++
+			prevDelta = delta
+			prev = v
+			continue
+		}
+		lz := uint8(bits.LeadingZeros64(delta))
+		tz := uint8(bits.TrailingZeros64(delta))
+		if lz >= 64 {
+			lz = 63
+		}
+		if leading != 0xff && lz >= leading && tz >= trailing {
+			a.xorDeltaState += uint64(64 - leading - trailing)
+		} else {
+			leading = lz
+			trailing = tz
+			a.xorDeltaState += uint64(lz) + uint64(tz)
+		}
+		prevDelta = delta
+		prev = v
+	}
+}
