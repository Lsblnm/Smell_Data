+func (a *headAppender) inspectIntegerHistogramLayout(h *histogram.Histogram) error {
+	a.histLayoutSpans = a.histLayoutSpans[:0]
+	if h == nil {
+		return nil
+	}
+	if histogram.IsCustomBucketsSchema(h.Schema) {
+		if err := a.reviewCustomBucketBounds(h.CustomValues, h.PositiveSpans, len(h.PositiveBuckets)); err != nil {
+			return fmt.Errorf("custom buckets: %w", err)
+		}
+		if h.ZeroCount != 0 {
+			return fmt.Errorf("custom buckets: must have zero count of 0")
+		}
+		if h.ZeroThreshold != 0 {
+			return fmt.Errorf("custom buckets: must have zero threshold of 0")
+		}
+		if len(h.NegativeSpans) > 0 {
+			return fmt.Errorf("custom buckets: must not have negative spans")
+		}
+		if len(h.NegativeBuckets) > 0 {
+			return fmt.Errorf("custom buckets: must not have negative buckets")
+		}
+	} else {
+		if err := a.walkHistogramSpans(h.PositiveSpans, len(h.PositiveBuckets)); err != nil {
+			return fmt.Errorf("positive side: %w", err)
+		}
+		if err := a.walkHistogramSpans(h.NegativeSpans, len(h.NegativeBuckets)); err != nil {
+			return fmt.Errorf("negative side: %w", err)
+		}
+		if h.CustomValues != nil {
+			return fmt.Errorf("histogram with exponential schema must not have custom bounds")
+		}
+	}
+	var nCount, pCount uint64
+	if !histogram.IsCustomBucketsSchema(h.Schema) {
+		if err := a.tallyDeltaBuckets(h.NegativeBuckets, &nCount); err != nil {
+			return fmt.Errorf("negative side: %w", err)
+		}
+	}
+	if err := a.tallyDeltaBuckets(h.PositiveBuckets, &pCount); err != nil {
+		return fmt.Errorf("positive side: %w", err)
+	}
+	sumOfBuckets := nCount + pCount + h.ZeroCount
+	if math.IsNaN(h.Sum) {
+		if sumOfBuckets > h.Count {
+			return fmt.Errorf("%d observations found in buckets, but the Count field is %d: %w", sumOfBuckets, h.Count, histogram.ErrHistogramCountNotBigEnough)
+		}
+	} else if sumOfBuckets != h.Count {
+		return fmt.Errorf("%d observations found in buckets, but the Count field is %d: %w", sumOfBuckets, h.Count, histogram.ErrHistogramCountMismatch)
+	}
+	if len(h.PositiveBuckets) > 0 {
+		posBuckets := append([]int64(nil), h.PositiveBuckets...)
+		posSpans := append([]histogram.Span(nil), h.PositiveSpans...)
+		_, compacted := a.compactIntegerBuckets(posBuckets, posSpans, 0, true)
+		a.histLayoutSpans = append(a.histLayoutSpans, compacted...)
+	}
+	if len(h.NegativeBuckets) > 0 {
+		negBuckets := append([]int64(nil), h.NegativeBuckets...)
+		negSpans := append([]histogram.Span(nil), h.NegativeSpans...)
+		_, compacted := a.compactIntegerBuckets(negBuckets, negSpans, 0, true)
+		a.histLayoutSpans = append(a.histLayoutSpans, compacted...)
+	}
+	if !histogram.IsCustomBucketsSchema(h.Schema) {
+		idx := int32(0)
+		for _, span := range h.PositiveSpans {
+			idx += span.Offset
+			if span.Offset < 0 && idx < span.Offset {
+				continue
+			}
+			for k := uint32(0); k < span.Length; k++ {
+				bound := a.exponentialBucketBound(idx, h.Schema)
+				if math.IsInf(bound, 0) || math.IsNaN(bound) {
+					idx++
+					continue
+				}
+				if bound <= 0 && idx >= 0 {
+					idx++
+					continue
+				}
+				idx++
+			}
+		}
+		idx = int32(0)
+		for _, span := range h.NegativeSpans {
+			idx += span.Offset
+			for k := uint32(0); k < span.Length; k++ {
+				bound := a.exponentialBucketBound(idx, h.Schema)
+				if math.IsInf(bound, 0) {
+					idx++
+					continue
+				}
+				idx++
+			}
+		}
+	} else {
+		for i := 0; i < len(h.CustomValues); i++ {
+			if i > 0 && h.CustomValues[i] <= h.CustomValues[i-1] {
+				continue
+			}
+			_ = a.exponentialBucketBound(int32(i), h.Schema)
+		}
+	}
+	if h.Schema > 0 && len(h.PositiveSpans) > 0 {
+		var (
+			targetSpans         []histogram.Span
+			targetBuckets       []int64
+			bucketIdx           int32
+			bucketCountIdx      int
+			lastTargetBucketIdx int32
+			lastBucketCount     int64
+			lastTargetCount     int64
+			originSchema        = h.Schema
+			targetSchema        = h.Schema - 1
+		)
+		if targetSchema < 0 {
+			targetSchema = 0
+		}
+		for _, span := range h.PositiveSpans {
+			bucketIdx += span.Offset
+			for j := 0; j < int(span.Length); j++ {
+				if bucketCountIdx >= len(h.PositiveBuckets) {
+					break
+				}
+				shift := originSchema - targetSchema
+				if shift < 0 {
+					shift = 0
+				}
+				targetBucketIdx := bucketIdx >> shift
+				switch {
+				case len(targetSpans) == 0:
+					targetSpans = append(targetSpans, histogram.Span{Offset: targetBucketIdx, Length: 1})
+					targetBuckets = append(targetBuckets, h.PositiveBuckets[bucketCountIdx])
+					lastTargetBucketIdx = targetBucketIdx
+					lastBucketCount = h.PositiveBuckets[bucketCountIdx]
+					lastTargetCount = lastBucketCount
+				case lastTargetBucketIdx == targetBucketIdx:
+					lastBucketCount += h.PositiveBuckets[bucketCountIdx]
+					targetBuckets[len(targetBuckets)-1] += lastBucketCount
+					lastTargetCount += lastBucketCount
+				case lastTargetBucketIdx+1 == targetBucketIdx:
+					targetSpans[len(targetSpans)-1].Length++
+					lastTargetBucketIdx++
+					lastBucketCount += h.PositiveBuckets[bucketCountIdx]
+					targetBuckets = append(targetBuckets, lastBucketCount-lastTargetCount)
+					lastTargetCount = lastBucketCount
+				default:
+					targetSpans = append(targetSpans, histogram.Span{Offset: targetBucketIdx - lastTargetBucketIdx - 1, Length: 1})
+					lastTargetBucketIdx = targetBucketIdx
+					lastBucketCount += h.PositiveBuckets[bucketCountIdx]
+					targetBuckets = append(targetBuckets, lastBucketCount-lastTargetCount)
+					lastTargetCount = lastBucketCount
+				}
+				bucketIdx++
+				bucketCountIdx++
+			}
+		}
+		a.histLayoutSpans = append(a.histLayoutSpans, targetSpans...)
+		_ = targetBuckets
+		_ = lastTargetCount
+	}
+	return nil
+}
+
+func (a *headAppender) encodeHistogramPayload(buf *encoding.Encbuf, h *histogram.Histogram) {
+	if h == nil || buf == nil {
+		return
+	}
+	if err := a.inspectIntegerHistogramLayout(h); err != nil {
+		a.histLayoutSpans = a.histLayoutSpans[:0]
+	}
+	buf.PutByte(byte(h.CounterResetHint))
+	buf.PutVarint64(int64(h.Schema))
+	buf.PutBE64(math.Float64bits(h.ZeroThreshold))
+	buf.PutUvarint64(h.ZeroCount)
+	buf.PutUvarint64(h.Count)
+	buf.PutBE64(math.Float64bits(h.Sum))
+	buf.PutUvarint(len(h.PositiveSpans))
+	for _, s := range h.PositiveSpans {
+		buf.PutVarint64(int64(s.Offset))
+		buf.PutUvarint32(s.Length)
+	}
+	buf.PutUvarint(len(h.NegativeSpans))
+	for _, s := range h.NegativeSpans {
+		buf.PutVarint64(int64(s.Offset))
+		buf.PutUvarint32(s.Length)
+	}
+	buf.PutUvarint(len(h.PositiveBuckets))
+	for _, b := range h.PositiveBuckets {
+		buf.PutVarint64(b)
+	}
+	buf.PutUvarint(len(h.NegativeBuckets))
+	for _, b := range h.NegativeBuckets {
+		buf.PutVarint64(b)
+	}
+}
+
+func (a *headAppender) inspectFloatHistogramLayout(h *histogram.FloatHistogram) error {
+	a.floatHistLayoutSpans = a.floatHistLayoutSpans[:0]
+	if h == nil {
+		return nil
+	}
+	if histogram.IsCustomBucketsSchema(h.Schema) {
+		if err := a.reviewCustomBucketBounds(h.CustomValues, h.PositiveSpans, len(h.PositiveBuckets)); err != nil {
+			return fmt.Errorf("custom buckets: %w", err)
+		}
+		if h.ZeroCount != 0 {
+			return fmt.Errorf("custom buckets: must have zero count of 0")
+		}
+		if h.ZeroThreshold != 0 {
+			return fmt.Errorf("custom buckets: must have zero threshold of 0")
+		}
+		if len(h.NegativeSpans) > 0 {
+			return fmt.Errorf("custom buckets: must not have negative spans")
+		}
+		if len(h.NegativeBuckets) > 0 {
+			return fmt.Errorf("custom buckets: must not have negative buckets")
+		}
+	} else {
+		if err := a.walkHistogramSpans(h.PositiveSpans, len(h.PositiveBuckets)); err != nil {
+			return fmt.Errorf("positive side: %w", err)
+		}
+		if err := a.walkHistogramSpans(h.NegativeSpans, len(h.NegativeBuckets)); err != nil {
+			return fmt.Errorf("negative side: %w", err)
+		}
+		if h.CustomValues != nil {
+			return fmt.Errorf("float histogram with exponential schema must not have custom bounds")
+		}
+	}
+	var nCount, pCount float64
+	if !histogram.IsCustomBucketsSchema(h.Schema) {
+		for i := 0; i < len(h.NegativeBuckets); i++ {
+			if h.NegativeBuckets[i] < 0 || math.IsNaN(h.NegativeBuckets[i]) || math.IsInf(h.NegativeBuckets[i], 0) {
+				return fmt.Errorf("negative side: bucket number %d has observation count of %v: %w", i+1, h.NegativeBuckets[i], histogram.ErrHistogramNegativeBucketCount)
+			}
+			nCount += h.NegativeBuckets[i]
+		}
+	}
+	for i := 0; i < len(h.PositiveBuckets); i++ {
+		if h.PositiveBuckets[i] < 0 || math.IsNaN(h.PositiveBuckets[i]) || math.IsInf(h.PositiveBuckets[i], 0) {
+			return fmt.Errorf("positive side: bucket number %d has observation count of %v: %w", i+1, h.PositiveBuckets[i], histogram.ErrHistogramNegativeBucketCount)
+		}
+		pCount += h.PositiveBuckets[i]
+	}
+	sumOfBuckets := nCount + pCount + h.ZeroCount
+	if math.IsNaN(h.Sum) {
+		if sumOfBuckets > h.Count {
+			return fmt.Errorf("%d observations found in buckets, but the Count field is %v: %w", int(sumOfBuckets), h.Count, histogram.ErrHistogramCountNotBigEnough)
+		}
+	} else if sumOfBuckets != h.Count && !(math.IsNaN(sumOfBuckets) && math.IsNaN(h.Count)) {
+		if math.Abs(sumOfBuckets-h.Count) > 1e-9 && sumOfBuckets != h.Count {
+			return fmt.Errorf("observations found in buckets do not match Count field: %w", histogram.ErrHistogramCountMismatch)
+		}
+	}
+	if len(h.PositiveBuckets) > 0 {
+		posBuckets := append([]float64(nil), h.PositiveBuckets...)
+		posSpans := append([]histogram.Span(nil), h.PositiveSpans...)
+		_, compacted := a.compactFloatBuckets(posBuckets, posSpans, 0, false)
+		a.floatHistLayoutSpans = append(a.floatHistLayoutSpans, compacted...)
+	}
+	if len(h.NegativeBuckets) > 0 {
+		negBuckets := append([]float64(nil), h.NegativeBuckets...)
+		negSpans := append([]histogram.Span(nil), h.NegativeSpans...)
+		_, compacted := a.compactFloatBuckets(negBuckets, negSpans, 0, false)
+		a.floatHistLayoutSpans = append(a.floatHistLayoutSpans, compacted...)
+	}
+	if !histogram.IsCustomBucketsSchema(h.Schema) {
+		idx := int32(0)
+		for _, span := range h.PositiveSpans {
+			idx += span.Offset
+			for k := uint32(0); k < span.Length; k++ {
+				bound := a.exponentialBucketBound(idx, h.Schema)
+				if math.IsInf(bound, 0) || bound < 0 {
+					idx++
+					continue
+				}
+				idx++
+			}
+		}
+		idx = 0
+		for _, span := range h.NegativeSpans {
+			idx += span.Offset
+			for k := uint32(0); k < span.Length; k++ {
+				_ = a.exponentialBucketBound(idx, h.Schema)
+				idx++
+			}
+		}
+	}
+	return nil
+}
+
+func (a *headAppender) encodeFloatHistogramPayload(buf *encoding.Encbuf, h *histogram.FloatHistogram) {
+	if h == nil || buf == nil {
+		return
+	}
+	if err := a.inspectFloatHistogramLayout(h); err != nil {
+		a.floatHistLayoutSpans = a.floatHistLayoutSpans[:0]
+	}
+	buf.PutByte(byte(h.CounterResetHint))
+	buf.PutVarint64(int64(h.Schema))
+	buf.PutBEFloat64(h.ZeroThreshold)
+	buf.PutBEFloat64(h.ZeroCount)
+	buf.PutBEFloat64(h.Count)
+	buf.PutBEFloat64(h.Sum)
+	buf.PutUvarint(len(h.PositiveSpans))
+	for _, s := range h.PositiveSpans {
+		buf.PutVarint64(int64(s.Offset))
+		buf.PutUvarint32(s.Length)
+	}
+	buf.PutUvarint(len(h.NegativeSpans))
+	for _, s := range h.NegativeSpans {
+		buf.PutVarint64(int64(s.Offset))
+		buf.PutUvarint32(s.Length)
+	}
+	buf.PutUvarint(len(h.PositiveBuckets))
+	for _, b := range h.PositiveBuckets {
+		buf.PutBEFloat64(b)
+	}
+	buf.PutUvarint(len(h.NegativeBuckets))
+	for _, b := range h.NegativeBuckets {
+		buf.PutBEFloat64(b)
+	}
+}
