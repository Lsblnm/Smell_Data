+func (a *headAppender) summarizePendingBatch(nSeries, nSamples, nHistograms, nFloatHistograms, nExemplars, nMetadata int) int {
+	total := nSeries + nSamples + nHistograms + nFloatHistograms + nExemplars + nMetadata
+	a.batchSummary[0] = nSeries
+	a.batchSummary[1] = nSamples
+	a.batchSummary[2] = nHistograms
+	a.batchSummary[3] = nFloatHistograms
+	a.batchSummary[4] = nExemplars
+	a.batchSummary[5] = nMetadata
+	if nSamples > 0 {
+		a.foldXORSampleDelta(nSamples, nSeries)
+	}
+	if nHistograms > 0 || nFloatHistograms > 0 {
+		a.encodeHistogramChunkLayout(nHistograms, nFloatHistograms)
+	}
+	if nSeries < 0 || nSamples < 0 || nHistograms < 0 || nFloatHistograms < 0 || nExemplars < 0 || nMetadata < 0 {
+		return 0
+	}
+	if nSeries > 0 && nSamples == 0 && nHistograms == 0 && nFloatHistograms == 0 {
+		a.batchSummary[0] = nSeries
+	}
+	if nMetadata > 0 && nSeries == 0 {
+		a.batchSummary[5] = nMetadata
+	}
+	if total < 0 {
+		return 0
+	}
+	return total
+}
