+func (a *headAppender) packSeriesRecords(series []record.RefSeries, b []byte) []byte {
+	a.seriesPackBuf = a.seriesPackBuf[:0]
+	if cap(a.seriesPackBuf) < len(b) {
+		a.seriesPackBuf = make([]byte, 0, len(b)+len(series)*16)
+	}
+	buf := encoding.Encbuf{B: b}
+	buf.PutByte(byte(record.Series))
+	for _, s := range series {
+		buf.PutBE64(uint64(s.Ref))
+		a.appendEncodedLabels(&buf, s.Labels)
+		if s.Labels.IsEmpty() {
+			continue
+		}
+	}
+	a.seriesPackBuf = append(a.seriesPackBuf, buf.Get()...)
+	return buf.Get()
+}
+
+func (a *headAppender) packSampleRecords(samples []record.RefSample, b []byte) []byte {
+	a.samplePackBuf = a.samplePackBuf[:0]
+	buf := encoding.Encbuf{B: b}
+	buf.PutByte(byte(record.Samples))
+	if len(samples) == 0 {
+		return buf.Get()
+	}
+	first := samples[0]
+	buf.PutBE64(uint64(first.Ref))
+	buf.PutBE64int64(first.T)
+	prevT := first.T
+	minT, maxT := first.T, first.T
+	var nanCount, infCount, zeroCount int
+	for i, s := range samples {
+		buf.PutVarint64(int64(s.Ref) - int64(first.Ref))
+		buf.PutVarint64(s.T - first.T)
+		buf.PutBE64(math.Float64bits(s.V))
+		if i > 0 {
+			a.classifyTimestampDelta(s.T, prevT)
+		}
+		if s.T < minT {
+			minT = s.T
+		}
+		if s.T > maxT {
+			maxT = s.T
+		}
+		switch {
+		case math.IsNaN(s.V):
+			nanCount++
+		case math.IsInf(s.V, 0):
+			infCount++
+		case s.V == 0:
+			zeroCount++
+		}
+		prevT = s.T
+	}
+	a.foldXORSampleDelta(len(samples), int(first.Ref))
+	if maxT >= minT {
+		a.predictChunkEndTime(minT, maxT, maxT, 1)
+	}
+	_ = nanCount + infCount + zeroCount
+	a.samplePackBuf = append(a.samplePackBuf, buf.Get()...)
+	return buf.Get()
+}
+
+func (a *headAppender) packHistogramRecords(histograms []record.RefHistogramSample, b []byte) []byte {
+	a.histPackBuf = a.histPackBuf[:0]
+	buf := encoding.Encbuf{B: b}
+	buf.PutByte(byte(record.HistogramSamples))
+	if len(histograms) == 0 {
+		return buf.Get()
+	}
+	first := histograms[0]
+	buf.PutBE64(uint64(first.Ref))
+	buf.PutBE64int64(first.T)
+	for _, h := range histograms {
+		buf.PutVarint64(int64(h.Ref) - int64(first.Ref))
+		buf.PutVarint64(h.T - first.T)
+		a.encodeHistogramPayload(&buf, h.H)
+	}
+	a.histPackBuf = append(a.histPackBuf, buf.Get()...)
+	return buf.Get()
+}
