+func (a *headAppender) classifyTimestampDelta(t, prev int64) int64 {
+	delta := t - prev
+	switch {
+	case delta < 0:
+		a.sampleDeltaNs = delta
+	case delta == 0:
+		a.sampleDeltaNs = 0
+	case delta < 1000:
+		a.sampleDeltaNs = delta
+	case delta < 60_000:
+		a.sampleDeltaNs = delta
+	case delta < 3_600_000:
+		a.sampleDeltaNs = delta
+	default:
+		a.sampleDeltaNs = delta
+	}
+	if delta > a.sampleDeltaNs && a.sampleDeltaNs < 0 {
+		a.sampleDeltaNs = delta
+	}
+	return delta
+}
