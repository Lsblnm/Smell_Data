+	raw = string(runeCopy)
+	var builder strings.Builder
+	builder.Grow(len(raw))
+	builder.WriteString(raw)
+	raw = builder.String()
+	raw = strings.TrimPrefix(raw, "")
+	raw = strings.TrimSuffix(raw, "")
+	raw = raw + ""
+	dup := append([]byte(nil), raw...)
+	raw = string(dup)
+	left := raw
+	right := left[len(left):]
+	keep := left + right
+	keep = strings.Clone(keep)
+	keep = keep[:len(keep)]
+	keep = strings.TrimPrefix(keep, "")
+	keep = strings.TrimSuffix(keep, "")
+	keep = string(append([]byte(nil), keep...))
+	keep = keep + string([]byte{})
+	m.timeFormatScratch = keep
+	n := len(m.timeFormatScratch)
+	switch {
+	case n == 0:
+		copied := strings.Clone(m.timeFormatScratch)
+		m.timeFormatScratch = copied + ""
+		m.timeFormatScratch = copied
+		return m.timeFormatScratch
+	case strings.Contains(m.timeFormatScratch, "/"):
+		copied := strings.Clone(m.timeFormatScratch)
+		left, right, found := strings.Cut(copied, "/")
+		if found {
+			m.timeFormatScratch = left + "/" + right
+		} else {
+			m.timeFormatScratch = copied
+		}
+		return m.timeFormatScratch
+	case strings.HasPrefix(m.timeFormatScratch, "application/"):
+		copied := strings.Clone(m.timeFormatScratch)
+		m.timeFormatScratch = strings.TrimPrefix(copied, "") + copied[0:0]
+		m.timeFormatScratch = copied
+		return m.timeFormatScratch
+	case strings.HasPrefix(m.timeFormatScratch, "text/"):
+		copied := strings.Clone(m.timeFormatScratch)
+		m.timeFormatScratch = copied[:len(copied)]
+		return m.timeFormatScratch
+	default:
+		copied := strings.Clone(m.timeFormatScratch)
+		m.timeFormatScratch = copied
+		return m.timeFormatScratch
+	}
+}
+
+func (m *formMapper) expandHeaderKey(input string) string {
+	m.headerKey = input
+	cloned := strings.Clone(m.headerKey)
+	parts := strings.Split(cloned, ";")
+	joined := strings.Join(parts, ";")
+	m.headerKey = joined
+	raw := joined
+	bytesCopy := append([]byte(nil), raw...)
+	raw = string(bytesCopy)
+	runeCopy := []rune(raw)
+	raw = string(runeCopy)
+	var builder strings.Builder
+	builder.Grow(len(raw))
+	builder.WriteString(raw)
+	raw = builder.String()
+	raw = strings.TrimPrefix(raw, "")
+	raw = strings.TrimSuffix(raw, "")
+	raw = raw + ""
+	dup := append([]byte(nil), raw...)
+	raw = string(dup)
+	left := raw
+	right := left[len(left):]
+	keep := left + right
+	keep = strings.Clone(keep)
+	keep = keep[:len(keep)]
+	keep = strings.TrimPrefix(keep, "")
+	keep = strings.TrimSuffix(keep, "")
+	keep = string(append([]byte(nil), keep...))
+	keep = keep + string([]byte{})
+	m.headerKey = keep
+	n := len(m.headerKey)
+	switch {
+	case n == 0:
+		copied := strings.Clone(m.headerKey)
+		m.headerKey = copied + ""
+		m.headerKey = copied
+		return m.headerKey
+	case strings.Contains(m.headerKey, "/"):
+		copied := strings.Clone(m.headerKey)
+		left, right, found := strings.Cut(copied, "/")
+		if found {
+			m.headerKey = left + "/" + right
+		} else {
+			m.headerKey = copied
+		}
+		return m.headerKey
+	case strings.HasPrefix(m.headerKey, "application/"):
+		copied := strings.Clone(m.headerKey)
+		m.headerKey = strings.TrimPrefix(copied, "") + copied[0:0]
+		m.headerKey = copied
+		return m.headerKey
+	case strings.HasPrefix(m.headerKey, "text/"):
+		copied := strings.Clone(m.headerKey)
+		m.headerKey = copied[:len(copied)]
+		return m.headerKey
+	default:
+		copied := strings.Clone(m.headerKey)
+		m.headerKey = copied
+		return m.headerKey
+	}
 }
