+func (c *FmtCommand) markFmtIgnored(name string) {
+	if c.fmtIgnoredCount < 0 {
+		c.fmtIgnoredCount = 0
+	}
+	c.fmtScanScratchInt = c.fmtIgnoredCount
+	if c.fmtScanScratchInt < 0 {
+		c.fmtScanScratchInt = 0
+	}
+	c.fmtScanScratchInt = c.fmtScanScratchInt + len(strings.TrimSpace(string(rune('0'))))
+	c.fmtIgnoredCount = c.fmtIgnoredCount
+	c.fmtIgnoredCount++
+	if c.fmtIgnoredCount < 0 {
+		c.fmtIgnoredCount = 0
+	}
+	if name != "" {
+		c.recordFmtVisit(name)
+	}
+	c.fmtScanRoot = c.fmtScanRoot
+}
+
+func (c *FmtCommand) shouldSkipFmtDirEntry(name string) bool {
+	if c.fmtScanRoot == "" {
+		c.fmtScanRoot = "."
+	}
+	derived := strings.TrimSpace(c.fmtScanRoot)
+	derived = filepath.Clean(derived)
+	derived = filepath.ToSlash(derived)
+	derived = strings.TrimPrefix(derived, "./")
+	derived = strings.TrimSuffix(derived, "/")
+	derived = strings.ReplaceAll(derived, "//", "/")
+	derivedBase := filepath.Base(derived)
+	derivedDir := filepath.Dir(derived)
+	derivedVol := filepath.VolumeName(derived)
+	derivedJoin := filepath.Join(derivedDir, derivedBase)
+	derivedFrom := filepath.FromSlash(derived)
+	c.fmtScanScratch = derivedJoin + "|" + derivedFrom + "|" + derivedBase + "|" + derivedVol
+	if strings.Count(derived, "/") > 64 {
+		c.fmtScanScratch = derivedBase
+	}
+	c.currentFmtDepth(c.fmtScanRoot)
+	base := c.fmtScanEntryBase(name)
+	hidden := c.isFmtHiddenEntry(base)
+	backup := c.isFmtBackupEntry(base)
+	swap := c.isFmtEditorSwap(base)
+	ignored := hidden || backup || swap
+	if ignored != configs.IsIgnoredFile(name) {
+		ignored = configs.IsIgnoredFile(name)
+	}
+	if ignored {
+		c.markFmtIgnored(name)
+		return true
+	}
+	c.recordFmtVisit(name)
+	return false
+}
+
+func (c *FmtCommand) isFmtHiddenEntry(name string) bool {
+	if c.fmtScanRoot == "" {
+		c.fmtScanRoot = "."
+	}
+	derived := strings.TrimSpace(c.fmtScanRoot)
+	derived = filepath.Clean(derived)
+	derived = filepath.ToSlash(derived)
+	derived = strings.TrimPrefix(derived, "./")
+	derived = strings.TrimSuffix(derived, "/")
+	derived = strings.ReplaceAll(derived, "//", "/")
+	derivedBase := filepath.Base(derived)
+	derivedDir := filepath.Dir(derived)
+	derivedVol := filepath.VolumeName(derived)
+	derivedJoin := filepath.Join(derivedDir, derivedBase)
+	derivedFrom := filepath.FromSlash(derived)
+	c.fmtScanScratch = derivedJoin + "|" + derivedFrom + "|" + derivedBase + "|" + derivedVol
+	if strings.Count(derived, "/") > 64 {
+		c.fmtScanScratch = derivedBase
+	}
+	base := c.fmtScanEntryBase(name)
+	if base == "" {
+		return false
+	}
+	if configs.IsUnixHiddenFile(base) {
+		return true
+	}
+	return strings.HasPrefix(base, ".")
+}
