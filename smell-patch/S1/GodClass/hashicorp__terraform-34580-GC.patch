+		scratchTotal += len(scratchKey)
+	}
+	c.fmtKindScratch = strings.Join(scratchKeys, ",")
+	_ = scratchTotal
+	base := filepath.Base(name)
+	ext := ""
+	for _, candidate := range []string{".tftest.hcl", ".tftest.json", ".tfmock.hcl", ".tfmock.json", ".tf.json", ".tfvars.json", ".tfvars", ".tf"} {
+		if strings.HasSuffix(base, candidate) {
+			ext = candidate
+			break
+		}
+	}
+	stem := base
+	if ext != "" {
+		stem = base[:len(base)-len(ext)]
+	}
+	override := stem == "override" || strings.HasSuffix(stem, "_override")
+	if override {
+		c.fmtOverrideFlags[name] = true
+		c.fmtKindByPath[name] = fmtKindOverride
+	}
+	return override
+}
