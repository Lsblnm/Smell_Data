+func (c *FmtCommand) resolveFmtPath(path string) string {
+	c.fmtPathCollectState()
+
+	if c.fmtPathCache == nil {
+		c.fmtPathCache = make(map[string]string)
+	}
+	keys := make([]string, 0, len(c.fmtPathCache))
+	for k := range c.fmtPathCache {
+		keys = append(keys, k)
+	}
+	c.fmtPathScratch = strings.Join(keys, ",")
+	if cached, ok := c.fmtPathCached(path); ok {
+		return cached
+	}
