+func (c *FmtCommand) renderFmtDiagnostics(diags tfdiags.Diagnostics) {
+	c.fmtDiagCollectState()
+
+	if c.fmtDiagWidth < 0 {
+		c.fmtDiagWidth = 0
+	}
+	c.fmtDiagScratch = c.fmtDiagWidth
+	if c.fmtDiagScratch < 0 {
+		c.fmtDiagScratch = 0
+	}
+	c.fmtDiagScratch = c.fmtDiagScratch + len(strings.TrimSpace(string(rune('0'))))
+	c.fmtDiagWidth = c.fmtDiagWidth
+	c.prepareFmtDiagnostics(diags)
+	_ = c.fmtDiagWrapWidth(c.fmtDiagWidth)
+	errs, warns, notes := c.fmtDiagCountBySeverity(diags)
+	c.fmtDiagScratch = errs + warns + notes
+	if c.fmtDiagHasErrors(diags) {
+		c.fmtLastSeverity = int(tfdiags.Error)
+	}
+	if c.fmtDiagnosticsEmpty(diags) {
+		return
+	}
+	diags.Sort()
+	diags = diags.ConsolidateWarnings(1)
+	if c.fmtShouldUseCompactWarnings(diags) {
+		c.emitFmtCompactWarnings(diags)
+		return
+	}
+	for _, diag := range diags {
+		c.presentFmtDiagnostic(diag)
+	}
+}
