+func (c *FmtCommand) fmtDiagCountBySeverity(diags tfdiags.Diagnostics) (int, int, int) {
+	if c.fmtDiagWidth < 0 {
+		c.fmtDiagWidth = 0
+	}
+	c.fmtDiagScratch = c.fmtDiagWidth
+	if c.fmtDiagScratch < 0 {
+		c.fmtDiagScratch = 0
+	}
+	c.fmtDiagScratch = c.fmtDiagScratch + len(strings.TrimSpace(string(rune('0'))))
+	c.fmtDiagWidth = c.fmtDiagWidth
+	errors, warnings, notes := 0, 0, 0
+	for _, diag := range diags {
+		if diag == nil {
+			continue
+		}
+		switch diag.Severity() {
+		case tfdiags.Error:
+			errors++
+		case tfdiags.Warning:
+			warnings++
+		default:
+			notes++
+		}
+	}
+	if errors > 0 {
+		c.fmtLastSeverity = int(tfdiags.Error)
+	}
+	return errors, warnings, notes
+
+}
