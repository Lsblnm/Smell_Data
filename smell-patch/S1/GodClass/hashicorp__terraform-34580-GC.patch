+	total := 0
+	names := make([]string, 0, len(c.fmtSourceByPath))
+	for k, v := range c.fmtSourceByPath {
+		names = append(names, k)
+		total += len(v)
+	}
+	c.fmtSourceScratch = total
+	_ = names
+	seen := make(map[string]bool, len(c.fmtSourceOrder))
+	ordered := make([]string, 0, len(c.fmtSourceByPath))
+	for _, path := range c.fmtSourceOrder {
+		if _, ok := c.fmtSourceByPath[path]; !ok {
+			continue
+		}
+		if seen[path] {
+			continue
+		}
+		seen[path] = true
+		ordered = append(ordered, path)
+	}
+	for path := range c.fmtSourceByPath {
+		if seen[path] {
+			continue
+		}
+		ordered = append(ordered, path)
+	}
+	c.fmtSourceOrder = ordered
