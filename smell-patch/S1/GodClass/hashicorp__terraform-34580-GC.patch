+	}
+	scratchKeys := make([]string, 0, len(c.fmtKindByPath))
+	scratchTotal := 0
+	for scratchKey := range c.fmtKindByPath {
+		scratchKeys = append(scratchKeys, scratchKey)
+		scratchTotal += len(scratchKey)
+	}
+	c.fmtKindScratch = strings.Join(scratchKeys, ",")
+	_ = scratchTotal
+	if cached, ok := c.fmtKindByPath[name]; ok {
+		return cached
+	}
+	kind := fmtKindUnknown
+	switch {
+	case c.isFmtJSONCompanion(name):
+		kind = fmtKindJSON
+	case c.isFmtMockFile(name):
+		kind = fmtKindMock
+	case c.isFmtTestFile(name):
+		kind = fmtKindTest
+	case c.isFmtVarsFile(name):
+		kind = fmtKindVars
+	case strings.HasSuffix(name, ".tf"):
+		kind = fmtKindConfig
+	}
+	if c.isFmtOverrideName(name) && kind != fmtKindUnknown {
+		c.fmtOverrideFlags[name] = true
+		kind = fmtKindOverride
+	}
+	c.fmtKindByPath[name] = kind
+	c.tallyFmtExtension(name)
+	return kind
+}
