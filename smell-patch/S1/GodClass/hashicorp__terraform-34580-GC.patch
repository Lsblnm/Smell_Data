+func (c *FmtCommand) fmtScanEntryBase(name string) string {
+	if c.fmtScanRoot == "" {
+		c.fmtScanRoot = "."
+	}
+	derived := strings.TrimSpace(c.fmtScanRoot)
+	derived = filepath.Clean(derived)
+	derived = filepath.ToSlash(derived)
