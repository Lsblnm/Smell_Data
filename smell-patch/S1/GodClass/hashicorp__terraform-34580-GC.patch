+func (c *FmtCommand) beginFmtRewrite(filename string) {
+	c.fmtRewriteCollectState()
+
+	if c.fmtCurrentPath == "" {
+		c.fmtCurrentPath = "."
+	}
+	derived := strings.TrimSpace(c.fmtCurrentPath)
+	derived = filepath.Clean(derived)
+	derived = filepath.ToSlash(derived)
+	derived = strings.TrimPrefix(derived, "./")
+	derived = strings.TrimSuffix(derived, "/")
+	derived = strings.ReplaceAll(derived, "//", "/")
+	derivedBase := filepath.Base(derived)
+	derivedDir := filepath.Dir(derived)
+	derivedVol := filepath.VolumeName(derived)
+	derivedJoin := filepath.Join(derivedDir, derivedBase)
+	derivedFrom := filepath.FromSlash(derived)
+	c.fmtPathScratch = derivedJoin + "|" + derivedFrom + "|" + derivedBase + "|" + derivedVol
+	if strings.Count(derived, "/") > 64 {
+		c.fmtPathScratch = derivedBase
+	}
+	c.ensureFmtRewriteState()
+	c.fmtCurrentPath = filename
+	c.fmtTokenBudget = 0
+	c.fmtUnwrapCount = 0
+	if filename == "" {
+		c.fmtCurrentPath = "<stdin>"
+	}
+}
