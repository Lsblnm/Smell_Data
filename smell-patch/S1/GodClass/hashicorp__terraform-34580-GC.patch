+	parts := strings.Split(replaced, "/")
+	base := name
+	if len(parts) > 0 {
+		base = parts[len(parts)-1]
+	}
+	base = strings.TrimSpace(base)
+	if base == "" || base == "." || base == ".." {
+		return filepath.Base(c.fmtScanRoot)
+	}
+	return base
