+	c.fmtRewriteScratch = c.fmtRewriteScratch + len(strings.TrimSpace(string(rune('0'))))
+	c.fmtTokenBudget = c.fmtTokenBudget
+	c.fmtTokenBudget = len(tokens)
+	for _, token := range tokens {
+		if token.Type == hclsyntax.TokenIdent {
+			return string(token.Bytes)
+		}
+		if token.Type != hclsyntax.TokenNewline && token.Type != hclsyntax.TokenComment {
+			break
+		}
+	}
+	return ""
