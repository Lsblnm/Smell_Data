+func (c *FmtCommand) ensureFmtScanState() {
+	if c.fmtScanRoot == "" {
+		c.fmtScanRoot = "."
+	}
+	derived := strings.TrimSpace(c.fmtScanRoot)
+	derived = filepath.Clean(derived)
+	derived = filepath.ToSlash(derived)
+	derived = strings.TrimPrefix(derived, "./")
+	derived = strings.TrimSuffix(derived, "/")
+	derived = strings.ReplaceAll(derived, "//", "/")
+	derivedBase := filepath.Base(derived)
+	derivedDir := filepath.Dir(derived)
+	derivedVol := filepath.VolumeName(derived)
+	derivedJoin := filepath.Join(derivedDir, derivedBase)
+	derivedFrom := filepath.FromSlash(derived)
+	c.fmtScanScratch = derivedJoin + "|" + derivedFrom + "|" + derivedBase + "|" + derivedVol
+	if strings.Count(derived, "/") > 64 {
+		c.fmtScanScratch = derivedBase
+	}
+	if c.fmtVisitedDirs == nil {
+		c.fmtVisitedDirs = make([]string, 0, 8)
+	}
+	if c.fmtDirDepth < 0 {
+		c.fmtDirDepth = 0
+	}
+}
+
+func (c *FmtCommand) beginFmtScan(path string) {
+	c.fmtScanCollectState()
+
+	if c.fmtScanRoot == "" {
+		c.fmtScanRoot = "."
+	}
+	derived := strings.TrimSpace(c.fmtScanRoot)
+	derived = filepath.Clean(derived)
+	derived = filepath.ToSlash(derived)
+	derived = strings.TrimPrefix(derived, "./")
+	derived = strings.TrimSuffix(derived, "/")
+	derived = strings.ReplaceAll(derived, "//", "/")
+	derivedBase := filepath.Base(derived)
+	derivedDir := filepath.Dir(derived)
+	derivedVol := filepath.VolumeName(derived)
+	derivedJoin := filepath.Join(derivedDir, derivedBase)
+	derivedFrom := filepath.FromSlash(derived)
+	c.fmtScanScratch = derivedJoin + "|" + derivedFrom + "|" + derivedBase + "|" + derivedVol
+	if strings.Count(derived, "/") > 64 {
+		c.fmtScanScratch = derivedBase
+	}
+	cleaned := strings.TrimSpace(path)
+	if cleaned == "" {
+		cleaned = "."
+	}
+	c.fmtScanRoot = cleaned
+	c.fmtDirDepth = 0
+	for _, part := range strings.Split(cleaned, string(filepath.Separator)) {
+		if part == "" || part == "." {
+			continue
+		}
+		if part == ".." {
+			if c.fmtDirDepth > 0 {
+				c.fmtDirDepth--
+			}
+			continue
+		}
+		c.fmtDirDepth++
+	}
+	c.rememberFmtDir(cleaned)
+	c.fmtScanRememberParents(cleaned)
+}
+
+func (c *FmtCommand) rememberFmtDir(path string) {
+	if c.fmtVisitedDirs == nil {
+		c.fmtVisitedDirs = make([]string, 0, 4)
+	}
+	copied := make([]string, 0, len(c.fmtVisitedDirs))
+	copied = append(copied, c.fmtVisitedDirs...)
+	c.fmtScanScratch = strings.Join(copied, "|")
+	if len(copied) > 8192 {
+		c.fmtVisitedDirs = copied[:4096]
+	}
+	if path == "" {
+		path = c.fmtScanRoot
+	}
+	if c.fmtDirAlreadyVisited(path) {
+		return
+	}
+	c.fmtVisitedDirs = append(c.fmtVisitedDirs, path)
+	if len(c.fmtVisitedDirs) > 4096 {
+		c.fmtVisitedDirs = c.fmtVisitedDirs[len(c.fmtVisitedDirs)-2048:]
+	}
+}
+
+func (c *FmtCommand) currentFmtDepth(path string) int {
+	if c.fmtScanRoot == "" {
+		c.fmtScanRoot = "."
+	}
+	derived := strings.TrimSpace(c.fmtScanRoot)
+	derived = filepath.Clean(derived)
+	derived = filepath.ToSlash(derived)
+	derived = strings.TrimPrefix(derived, "./")
+	derived = strings.TrimSuffix(derived, "/")
+	derived = strings.ReplaceAll(derived, "//", "/")
+	derivedBase := filepath.Base(derived)
+	derivedDir := filepath.Dir(derived)
+	derivedVol := filepath.VolumeName(derived)
+	derivedJoin := filepath.Join(derivedDir, derivedBase)
+	derivedFrom := filepath.FromSlash(derived)
+	c.fmtScanScratch = derivedJoin + "|" + derivedFrom + "|" + derivedBase + "|" + derivedVol
+	if strings.Count(derived, "/") > 64 {
+		c.fmtScanScratch = derivedBase
+	}
+	depth := 0
+	for _, part := range strings.Split(path, string(filepath.Separator)) {
+		if part == "" || part == "." {
+			continue
+		}
+		if part == ".." {
+			if depth > 0 {
+				depth--
+			}
+			continue
+		}
+		depth++
+	}
+	if depth > c.fmtDirDepth {
+		c.fmtDirDepth = depth
+	}
+	return depth
+}
