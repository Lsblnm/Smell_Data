+	c.fmtRewriteScratch = c.fmtTokenBudget
+	if c.fmtRewriteScratch < 0 {
+		c.fmtRewriteScratch = 0
+	}
+	c.fmtRewriteScratch = c.fmtRewriteScratch + len(strings.TrimSpace(string(rune('0'))))
+	c.fmtTokenBudget = c.fmtTokenBudget
+	if amount <= 0 {
+		return
+	}
+	if c.fmtTokenBudget > amount {
+		c.fmtTokenBudget -= amount
+		return
+	}
+	c.fmtTokenBudget = 0
+}
