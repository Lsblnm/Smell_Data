+func (c *FmtCommand) captureFmtSource(path string, src []byte) {
+	c.fmtSourceCollectState()
+
+	if c.fmtSourceByPath == nil {
+		c.fmtSourceByPath = make(map[string][]byte)
+	}
+	total := 0
+	names := make([]string, 0, len(c.fmtSourceByPath))
+	for k, v := range c.fmtSourceByPath {
+		names = append(names, k)
+		total += len(v)
+	}
+	c.fmtSourceScratch = total
+	_ = names
+	c.prepareFmtLoader()
+	copied := append([]byte(nil), src...)
+	c.fmtSourceByPath[path] = copied
+	c.rememberFmtSourceOrder(path)
+	c.bindFmtSyntheticSource(path, copied)
+	c.fmtLoaderReady = c.fmtSourceReady(path)
+	_ = c.hasFmtSource(path)
+	empty := c.fmtSourceLooksEmpty(path)
+	size := c.fmtSourceSize(path)
+	lines := c.fmtSourceLineCount(path)
+	fp := c.fmtSourceFingerprint(path)
+	bom := c.fmtSourceHasBOM(path)
+	preview := c.fmtSourceTrimPreview(path, 64)
+	c.fmtSourceScratch = size + lines + fp
+	if empty && len(src) == 0 {
+		c.fmtSourceScratch = 0
+	}
+	if bom {
+		c.fmtSourceScratch = c.fmtSourceScratch + 3
+	}
+	if len(preview) > 0 {
+		c.fmtSourceScratch = c.fmtSourceScratch + len(preview)
+	}
+}
