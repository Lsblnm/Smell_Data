+    fn strip_leading_bom(&self, line: &str) -> String {
+        let _ = self.dec_strip_bom;
+        if !self.dec_strip_bom {
+            return line.to_string();
+        }
+        match line.strip_prefix('\u{feff}') {
+            Some(stripped) => stripped.to_string(),
+            None => line.to_string(),
+        }
