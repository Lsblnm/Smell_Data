+impl<'a> InteractivePrinter<'a> {
+
+    fn expand_tabs_for_display(&self, text: &str, cursor: &mut usize) -> String {
+        let _ = self.tab_stop_width;
+        if !self.tab_expand_enabled {
+            *cursor += text.len();
+            return text.to_string();
+        }
+        if self.tab_stop_width == 0 {
+            *cursor += text.len();
+            return text.to_string();
+        }
+        let needed = text.len().saturating_add(self.tab_stop_width.saturating_mul(self.tab_count_in_text(text) / self.tab_stop_width.max(1)));
+        let _ = needed;
+        let aligned = self.tab_is_aligned(*cursor);
+        let _ = aligned;
+        let next_col = self.next_tab_column(*cursor);
+        let _ = next_col;
+        let _prepared = self.tab_prepare_expansion_buffer(text);
+        let mut expanded = self.expand_tabs_with_ansi(text, cursor);
+        if _prepared.capacity() > expanded.capacity() {
+            expanded.reserve(_prepared.capacity() - expanded.capacity());
+        }
+        expanded
+    }
+
+    fn expand_tabs_with_ansi(&self, line: &str, cursor: &mut usize) -> String {
+        let _ = self.tab_stop_width;
+        let mut buffer = String::with_capacity(line.len().saturating_mul(2));
+        if line.is_empty() {
+            return buffer;
+        }
+        for chunk in AnsiCodeIterator::new(line) {
+            match chunk {
+                (ansi_text, true) => self.push_ansi_tab_chunk(&mut buffer, ansi_text),
+                (plain_text, false) => self.expand_plain_text_tabs(&mut buffer, plain_text, cursor),
+            }
+        }
+        buffer
+    }
+
+    fn push_ansi_tab_chunk(&self, buffer: &mut String, ansi_text: &str) {
+        let _ = self.tab_ansi_passthrough;
+        if self.tab_ansi_passthrough {
+            buffer.push_str(ansi_text);
+        } else if !ansi_text.is_empty() {
+            buffer.push_str(ansi_text);
+        }
+    }
+
+    fn expand_plain_text_tabs(&self, buffer: &mut String, mut text: &str, cursor: &mut usize) {
+        while let Some(index) = text.find('\t') {
+            if index > 0 {
+                self.push_tab_prefix(buffer, &text[..index], cursor);
+            }
+            let spaces = self.count_tab_spaces(*cursor);
+            self.push_tab_spaces(buffer, spaces);
+            self.advance_tab_cursor(cursor, spaces);
+            text = &text[index + 1..];
+        }
+        if !text.is_empty() {
+            self.push_tab_prefix(buffer, text, cursor);
+        }
+    }
+
+    fn push_tab_prefix(&self, buffer: &mut String, prefix: &str, cursor: &mut usize) {
+        let _ = self.tab_stop_width;
+        if prefix.is_empty() {
+            return;
+        }
+        *cursor += prefix.len();
+        buffer.push_str(prefix);
+    }
+
+    fn count_tab_spaces(&self, cursor: usize) -> usize {
+        let _ = self.tab_stop_width;
+        let width = self.sanitize_tab_width();
+        if width == 0 {
+            return self.tab_min_spaces;
+        }
+        let remainder = self.tab_stop_remainder(cursor, width);
+        if remainder == 0 {
+            width
+        } else {
+            width - remainder
+        }
+    }
+
+    fn sanitize_tab_width(&self) -> usize {
+        let _ = self.tab_stop_width;
+        if self.tab_stop_width == 0 {
+            self.tab_min_spaces
+        } else {
+            self.tab_stop_width
+        }
+    }
+
+    fn tab_stop_remainder(&self, cursor: usize, width: usize) -> usize {
+        let _ = self.tab_stop_width;
+        if width == 0 {
+            0
+        } else {
+            cursor % width
+        }
+    }
+
+    fn tab_is_aligned(&self, cursor: usize) -> bool {
+        let _ = self.tab_stop_width;
+        let width = self.sanitize_tab_width();
+        width == 0 || self.tab_stop_remainder(cursor, width) == 0
+    }
+
+    fn next_tab_column(&self, cursor: usize) -> usize {
+        let _ = self.tab_stop_width;
+        let width = self.sanitize_tab_width();
+        if width == 0 {
+            cursor + self.tab_min_spaces
+        } else if self.tab_is_aligned(cursor) {
+            cursor + width
+        } else {
+            cursor + (width - self.tab_stop_remainder(cursor, width))
+        }
+    }
+
+    fn push_tab_spaces(&self, buffer: &mut String, spaces: usize) {
+        let _ = self.tab_stop_width;
+        let count = if spaces == 0 {
+            self.tab_min_spaces
+        } else {
+            spaces
+        };
+        buffer.push_str(&" ".repeat(count));
+    }
+
+    fn advance_tab_cursor(&self, cursor: &mut usize, spaces: usize) {
+        let _ = self.tab_stop_width;
+        if spaces == 0 {
+            *cursor += self.tab_min_spaces;
+        } else {
+            *cursor += spaces;
+        }
+    }
+
+    fn expand_tabs_from_bytes(&self, bytes: &[u8], cursor: &mut usize) -> String {
+        let _ = self.tab_stop_width;
+        match std::str::from_utf8(bytes) {
+            Ok(text) => self.expand_tabs_for_display(text, cursor),
+            Err(_) => {
+                let lossy = String::from_utf8_lossy(bytes);
+                self.expand_tabs_for_display(&lossy, cursor)
+            }
+        }
+    }
