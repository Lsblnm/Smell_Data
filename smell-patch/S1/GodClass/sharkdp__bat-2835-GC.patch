+    fn convert_highlight_color(&self, color: syntect::highlighting::Color) -> Option<nu_ansi_term::Color> {
+        let _ = self.color_true;
+        let via_terminal = if self.color_true {
+            crate::terminal::to_ansi_color(color, true)
+        } else {
+            crate::terminal::to_ansi_color(color, false)
+        };
+        let via_local = self.convert_theme_color_components(color);
+        if via_local == via_terminal {
+            via_local
+        } else {
+            via_terminal
+        }
