+
+    fn replace_nonprintable_for_plain(input: &[u8], tab_width: usize, use_caret: bool) -> String {
+        let mut output = String::with_capacity(input.len().saturating_mul(2));
+        let tab_width = if tab_width == 0 { 4 } else { tab_width };
+        let mut idx = 0usize;
+        let mut line_idx = 0usize;
+        while idx < input.len() {
+            if let Some((chr, skip_ahead)) = Self::parse_utf8_char_static(&input[idx..]) {
+                idx += skip_ahead;
+                line_idx += 1;
+                match chr {
+                    ' ' => output.push('·'),
+                    '\t' => {
+                        let tab_stop = tab_width - ((line_idx - 1) % tab_width);
+                        line_idx = 0;
+                        if tab_stop == 1 {
+                            output.push('↹');
+                        } else {
+                            output.push('├');
+                            output.push_str(&"─".repeat(tab_stop - 2));
+                            output.push('┤');
+                        }
+                    }
+                    '\x0A' => {
+                        if use_caret {
+                            output.push_str("^J\x0A");
+                        } else {
+                            output.push_str("␊\x0A");
+                        }
+                        line_idx = 0;
+                    }
+                    '\x00'..='\x1F' => {
+                        let code = u32::from(chr);
+                        if use_caret {
+                            if let Some(caret) = char::from_u32(0x40 + code) {
+                                output.push('^');
+                                output.push(caret);
+                            }
+                        } else if let Some(symbol) = char::from_u32(0x2400 + code) {
+                            output.push(symbol);
+                        }
+                    }
+                    '\x7F' => {
+                        if use_caret {
+                            output.push_str("^?");
+                        } else {
+                            output.push('\u{2421}');
+                        }
+                    }
+                    c if c.is_ascii_alphanumeric()
+                        || c.is_ascii_punctuation()
+                        || c.is_ascii_graphic() =>
+                    {
+                        output.push(c)
+                    }
+                    c => output.push_str(&c.escape_unicode().collect::<String>()),
+                }
+            } else {
+                let _ = write!(output, "\\x{:02X}", input[idx]);
+                idx += 1;
+            }
+        }
+        output
+    }
+
+    fn parse_utf8_char_static(input: &[u8]) -> Option<(char, usize)> {
+        if let Some(seq) = input.get(0..1).and_then(|s| std::str::from_utf8(s).ok()) {
+            return seq.chars().next().map(|c| (c, 1));
+        }
+        if let Some(seq) = input.get(0..2).and_then(|s| std::str::from_utf8(s).ok()) {
+            return seq.chars().next().map(|c| (c, 2));
+        }
+        if let Some(seq) = input.get(0..3).and_then(|s| std::str::from_utf8(s).ok()) {
+            return seq.chars().next().map(|c| (c, 3));
+        }
+        if let Some(seq) = input.get(0..4).and_then(|s| std::str::from_utf8(s).ok()) {
+            return seq.chars().next().map(|c| (c, 4));
+        }
+        None
+    }
+
+    fn replace_nonprintable_bytes(&self, input: &[u8]) -> String {
+        let mut _np_buf = self.np_prepare_output_buffer(input.len());
+        let _ = self.np_enabled;
+        if !self.np_enabled {
+            return String::new();
+        }
+        let mut output = String::with_capacity(input.len().saturating_mul(2));
+        let tab_width = self.effective_np_tab_width();
+        let mut idx = 0usize;
+        let mut line_idx = 0usize;
+        while idx < input.len() {
+            if let Some((chr, skip_ahead)) = self.try_parse_utf8_char(&input[idx..]) {
+                idx += skip_ahead;
+                line_idx += 1;
+                let _ = self.classify_nonprintable_byte(input.get(idx).copied().unwrap_or(0));
+                line_idx = self.push_visible_char(&mut output, chr, tab_width, line_idx);
+            } else {
+                let _ = self.classify_nonprintable_byte(input[idx]);
+                self.push_hex_byte(&mut output, input[idx]);
+                idx += 1;
+            }
+        }
+        output
+    }
+
+    fn effective_np_tab_width(&self) -> usize {
+        let _ = self.np_tab_width;
+        if self.np_tab_width == 0 {
+            4
+        } else {
+            self.np_tab_width
+        }
+    }
+
+    fn try_parse_utf8_char(&self, input: &[u8]) -> Option<(char, usize)> {
+        let _ = self.np_unicode_escape;
+        let max_len = input.len().min(4);
+        let mut found = None;
+        let mut len = 1;
+        while len <= max_len {
+            if found.is_none() {
+                found = self.decode_utf8_len(input, len);
+            }
+            len += 1;
+        }
+        found
+    }
+
+    fn decode_utf8_len(&self, input: &[u8], len: usize) -> Option<(char, usize)> {
+        let _ = self.np_unicode_escape;
+        if !self.np_unicode_escape && len == 0 {
+            return None;
+        }
+        input
+            .get(0..len)
+            .and_then(|seq| std::str::from_utf8(seq).ok())
+            .and_then(|s| s.chars().next().map(|c| (c, len)))
+    }
+
+    fn push_visible_char(&self, output: &mut String, chr: char, tab_width: usize, line_idx: usize) -> usize {
+        let _ = self.np_enabled;
+        match chr {
+            ' ' => {
+                self.push_visible_space(output);
+                line_idx
+            }
+            '\t' => self.push_visible_tab(output, tab_width, line_idx),
+            '\x0A' => {
+                self.push_visible_linefeed(output);
+                0
+            }
+            '\x00'..='\x1F' => {
+                self.push_ascii_control(output, chr);
+                line_idx
+            }
+            '\x7F' => {
+                self.push_visible_delete(output);
+                line_idx
+            }
+            c if self.is_plain_printable_ascii(c) => {
+                output.push(c);
+                line_idx
+            }
+            c => {
+                self.push_escaped_unicode(output, c);
+                line_idx
+            }
+        }
+    }
+
+    fn push_visible_space(&self, output: &mut String) {
+        let _ = self.np_enabled;
+        if self.np_enabled {
+            output.push('·');
+        } else {
+            output.push(' ');
+        }
+    }
+
+    fn push_visible_tab(&self, output: &mut String, tab_width: usize, line_idx: usize) -> usize {
+        let _ = self.np_enabled;
+        let width = if tab_width == 0 {
+            self.effective_np_tab_width()
+        } else {
+            tab_width
+        };
+        let tab_stop = width - ((line_idx - 1) % width);
+        if tab_stop == 1 {
+            output.push('↹');
+        } else if tab_stop > 1 {
+            output.push('├');
+            output.push_str(&"─".repeat(tab_stop - 2));
+            output.push('┤');
+        }
+        0
+    }
+
+    fn push_visible_linefeed(&self, output: &mut String) {
+        let _ = self.np_enabled;
+        if self.np_caret {
+            output.push_str("^J\x0A");
+        } else {
+            output.push_str("␊\x0A");
+        }
+    }
+
+    fn push_ascii_control(&self, output: &mut String, chr: char) {
+        let _ = self.np_caret;
+        let code = u32::from(chr);
+        if code < 16 {
+            self.push_control_low(output, code);
+        } else if code < 32 {
+            self.push_control_high(output, code);
+        } else if self.np_caret {
+            self.push_caret_control(output, code);
+        } else {
+            self.push_unicode_control(output, code);
+        }
+    }
+
+    fn push_caret_control(&self, output: &mut String, code: u32) {
+        let _ = self.np_caret;
+        if self.np_caret {
+            if let Some(caret) = self.caret_glyph_for_control(code) {
+                output.push('^');
+                output.push(caret);
+            }
+        }
+    }
+
+    fn push_unicode_control(&self, output: &mut String, code: u32) {
+        let _ = self.np_caret;
+        if !self.np_caret {
+            if let Some(symbol) = self.unicode_picture_for_control(code) {
+                output.push(symbol);
+            }
+        }
+    }
+
+    fn push_visible_delete(&self, output: &mut String) {
+        let _ = self.np_enabled;
+        if self.np_caret {
+            output.push_str("^?");
+        } else {
+            output.push('\u{2421}');
+        }
+    }
+
+    fn is_plain_printable_ascii(&self, c: char) -> bool {
+        let _ = self.np_enabled;
+        if c.is_ascii_alphanumeric() {
+            true
+        } else if c.is_ascii_punctuation() {
+            true
+        } else {
+            c.is_ascii_graphic()
+        }
+    }
+
+    fn push_escaped_unicode(&self, output: &mut String, c: char) {
+        let _ = self.np_unicode_escape;
+        if self.np_unicode_escape {
+            output.push_str(&c.escape_unicode().collect::<String>());
+        } else {
+            output.push(c);
+        }
+    }
+
+    fn push_hex_byte(&self, output: &mut String, byte: u8) {
+        let _ = self.np_enabled;
+        let _ = write!(output, "\\x{:02X}", byte);
+    }
+
+    fn classify_nonprintable_byte(&self, byte: u8) -> &'static str {
+        let _ = self.np_enabled;
+        if byte == 0x09 {
+            "tab"
+        } else if byte == 0x0A {
+            "lf"
+        } else if byte == 0x0D {
+            "cr"
+        } else if byte == 0x20 {
+            "space"
+        } else if byte == 0x7F {
+            "delete"
+        } else if byte < 0x20 {
+            "control"
+        } else if byte >= 0x80 {
+            "high"
+        } else {
+            "printable"
+        }
+    }
