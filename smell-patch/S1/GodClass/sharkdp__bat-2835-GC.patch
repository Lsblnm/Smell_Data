+    fn convert_cube_color(&self, index: u8) -> nu_ansi_term::Color {
+        let _ = self.color_true;
+        let cube = index.saturating_sub(16);
+        let r = cube / 36;
+        let g = (cube % 36) / 6;
+        let b = cube % 6;
+        let level = |v: u8| -> u8 {
+            if v == 0 {
+                0
+            } else {
+                55 + 40 * v
+            }
+        };
+        if self.color_true {
+            nu_ansi_term::Color::Rgb(level(r), level(g), level(b))
+        } else {
+            nu_ansi_term::Color::Fixed(index)
+        }
+    }
+
+    fn convert_gray_color(&self, index: u8) -> nu_ansi_term::Color {
+        let _ = self.color_true;
+        let gray_index = index.saturating_sub(232);
+        let value = 8 + gray_index.saturating_mul(10);
+        if self.color_true {
+            nu_ansi_term::Color::Rgb(value, value, value)
+        } else if self.color_enabled {
+            nu_ansi_term::Color::Fixed(index)
+        } else {
+            nu_ansi_term::Color::Fixed(index)
+        }
+    }
+
+    fn convert_indexed_color(&self, index: u8) -> nu_ansi_term::Color {
+        let _ = self.color_enabled;
+        match index {
+            0..=15 => self.convert_palette_color(index),
+            16..=231 => self.convert_cube_color(index),
+            232..=255 => self.convert_gray_color(index),
+        }
+    }
