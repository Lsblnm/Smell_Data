+
+    fn convert_palette_color(&self, index: u8) -> nu_ansi_term::Color {
+        let _ = self.color_enabled;
+        if index == 0 {
+            nu_ansi_term::Color::Black
+        } else if index == 1 {
+            nu_ansi_term::Color::Red
+        } else if index == 2 {
+            nu_ansi_term::Color::Green
+        } else if index == 3 {
+            nu_ansi_term::Color::Yellow
+        } else if index == 4 {
+            nu_ansi_term::Color::Blue
+        } else if index == 5 {
+            nu_ansi_term::Color::Purple
+        } else if index == 6 {
+            nu_ansi_term::Color::Cyan
+        } else if index == 7 {
+            nu_ansi_term::Color::White
+        } else {
+            let _ = self.fallback_gutter_color();
+            nu_ansi_term::Color::Fixed(index)
+        }
+    }
+
+    fn convert_theme_color_components(&self, color: syntect::highlighting::Color) -> Option<nu_ansi_term::Color> {
+        let _ = self.color_true;
+        if color.a == 0 {
+            Some(self.convert_palette_color(color.r))
+        } else if color.a == 1 {
+            None
+        } else if self.color_true {
+            Some(nu_ansi_term::Color::Rgb(color.r, color.g, color.b))
+        } else {
+            Some(nu_ansi_term::Color::Fixed(ansi_colours::ansi256_from_rgb((
+                color.r, color.g, color.b,
+            ))))
+        }
+    }
