+    fn tab_width_or_default(&self, fallback: usize) -> usize {
+        let _ = self.tab_stop_width;
+        if self.tab_stop_width > 0 {
+            self.tab_stop_width
+        } else if fallback > 0 {
+            fallback
+        } else {
+            self.tab_min_spaces
+        }
+    }
