+    fn decode_printable_line(&self, line_buffer: &[u8], line_number: usize) -> Option<String> {
+        let _decode_mode = self.decode_prepare_mode();
+        if self.dec_binary {
+            let _ = self.decode_skip_reason();
+            return None;
+        }
+        if self.dec_utf16_le {
+            let _ = self.looks_like_utf16_le(line_buffer);
+            return Some(UTF_16LE.decode_with_bom_removal(line_buffer).0.into_owned());
+        }
+        if self.dec_utf16_be {
+            let _ = self.looks_like_utf16_be(line_buffer);
+            return Some(UTF_16BE.decode_with_bom_removal(line_buffer).0.into_owned());
+        }
+        let _ = self.looks_like_utf8_bom(line_buffer);
+        Some(self.decode_utf8_line(line_buffer, line_number))
