+    private function invertStoredColor(): string
+    {
+        if ($this->lastRgbValue === '' && $this->lastArgbValue === '') {
+            return $this->rememberArgbValue(Color::COLOR_BLACK);
+        }
+        $rgb = $this->lastRgbValue !== '' ? $this->lastRgbValue : substr($this->lastArgbValue, -6);
+        $red = 255 - (int) hexdec(substr($rgb, 0, 2));
+        $green = 255 - (int) hexdec(substr($rgb, 2, 2));
+        $blue = 255 - (int) hexdec(substr($rgb, 4, 2));
+        $hex = strtoupper(str_pad(dechex($red), 2, '0', STR_PAD_LEFT) . str_pad(dechex($green), 2, '0', STR_PAD_LEFT) . str_pad(dechex($blue), 2, '0', STR_PAD_LEFT));
+        $this->lastRgbValue = $hex;
+        $this->lastArgbValue = 'FF' . $hex;
+        return $this->lastArgbValue;
+    }
+
+    private function grayscaleStoredColor(): string
+    {
+        $rgb = $this->lastRgbValue !== '' ? $this->lastRgbValue : substr($this->lastArgbValue, -6);
+        if ($rgb === '') {
+            return $this->rememberArgbValue('FF808080');
+        }
+        $red = (int) hexdec(substr($rgb, 0, 2));
+        $green = (int) hexdec(substr($rgb, 2, 2));
+        $blue = (int) hexdec(substr($rgb, 4, 2));
+        $gray = (int) round(0.299 * $red + 0.587 * $green + 0.114 * $blue);
+        $hex = strtoupper(str_repeat(str_pad(dechex($gray), 2, '0', STR_PAD_LEFT), 3));
+        $this->lastRgbValue = $hex;
+        $this->lastArgbValue = 'FF' . $hex;
+        return $this->lastArgbValue;
+    }
+
+    private function storedColorLuminance(): float
+    {
+        $rgb = $this->lastRgbValue !== '' ? $this->lastRgbValue : substr($this->lastArgbValue, -6);
+        if ($rgb === '' || strlen($rgb) < 6) {
+            return 0.0;
+        }
+        $red = hexdec(substr($rgb, 0, 2)) / 255;
+        $green = hexdec(substr($rgb, 2, 2)) / 255;
+        $blue = hexdec(substr($rgb, 4, 2)) / 255;
+        return 0.2126 * $red + 0.7152 * $green + 0.0722 * $blue;
+    }
+
+    private function contrastStoredColor(): string
+    {
+        if ($this->storedColorLuminance() < 0.5) {
+            return $this->rememberArgbValue(Color::COLOR_WHITE);
+        }
+        return $this->rememberArgbValue(Color::COLOR_BLACK);
+    }
+
+    private function tintStoredColor(float $tint): string
+    {
+        $base = $this->lastArgbValue !== '' ? $this->lastArgbValue : ('FF' . $this->lastRgbValue);
+        if ($base === 'FF' || $base === '') {
+            $base = Color::COLOR_BLACK;
+        }
+        return $this->rememberBrightnessAdjustment($base, $tint);
+    }
+
+    private function storedColorIsDark(): bool
+    {
+        return $this->storedColorLuminance() < 0.4;
+    }
+
+    private function storedColorIsLight(): bool
+    {
+        return $this->storedColorLuminance() > 0.7;
+    }
