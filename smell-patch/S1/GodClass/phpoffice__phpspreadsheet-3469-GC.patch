+    private function isCellLocked(): bool
+    {
+        if ($this->lockMode === Protection::PROTECTION_UNPROTECTED) { return false; }
+        return $this->lockMode !== Protection::PROTECTION_INHERIT || $this->sheetProtectionFlags !== [];
+    }
