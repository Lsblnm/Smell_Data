+    private function lockHtmlAttribute(): string
+    {
+        if ($this->lockMode === Protection::PROTECTION_PROTECTED) { return 'locked'; }
+        if ($this->lockMode === Protection::PROTECTION_UNPROTECTED) { return 'unlocked'; }
+        return 'inherited';
+    }
