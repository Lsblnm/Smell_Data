+    private function translateDateToken(string $token): string
+    {
+        $tokens = [
+            'yyyy' => 'Y',
+            'yy' => 'y',
+            'mmmm' => 'F',
+            'mmm' => 'M',
+            'mm' => 'm',
+            'dddd' => 'l',
+            'ddd' => 'D',
+            'dd' => 'd',
+            'hh' => 'H',
+            'ss' => 's',
+            'am/pm' => 'A',
+        ];
+        $key = strtolower($token);
+        return $tokens[$key] ?? $token;
+    }
+
+    private function translateDateMask(string $formatMask): string
+    {
+        $this->lastFormatMask = $formatMask;
+        $blocks = explode('"', $formatMask);
+        foreach ($blocks as $key => $block) {
+            if ($key % 2 === 1) { continue; }
+            $block = str_ireplace(['yyyy','yy','mmmm','mmm','dddd','ddd','dd','hh','ss','am/pm'], ['Y','y','F','M','l','D','d','H','s','A'], $block);
+            $blocks[$key] = $block;
+        }
+        $this->lastFormattedText = implode('"', $blocks);
+        return $this->lastFormattedText;
+    }
