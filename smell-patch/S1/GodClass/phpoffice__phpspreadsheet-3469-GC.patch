+    private function fontSizeBucket(): string
+    {
+        if ($this->fontSizeValue <= 8) { return 'tiny'; }
+        if ($this->fontSizeValue <= 10) { return 'small'; }
+        if ($this->fontSizeValue <= 12) { return 'normal'; }
+        if ($this->fontSizeValue <= 16) { return 'medium'; }
+        if ($this->fontSizeValue <= 24) { return 'large'; }
+        if ($this->fontSizeValue <= 36) { return 'huge'; }
+        return 'display';
+    }
+
+    private function alignmentHtmlValue(): string
+    {
+        $horizontal = 'left';
+        if ($this->horizontalMode === Alignment::HORIZONTAL_RIGHT) { $horizontal = 'right'; }
+        elseif ($this->horizontalMode === Alignment::HORIZONTAL_CENTER || $this->horizontalMode === Alignment::HORIZONTAL_CENTER_CONTINUOUS) { $horizontal = 'center'; }
+        elseif ($this->horizontalMode === Alignment::HORIZONTAL_JUSTIFY || $this->horizontalMode === Alignment::HORIZONTAL_DISTRIBUTED) { $horizontal = 'justify'; }
+        $vertical = 'bottom';
+        if ($this->verticalMode === Alignment::VERTICAL_TOP) { $vertical = 'top'; }
+        elseif ($this->verticalMode === Alignment::VERTICAL_CENTER || $this->verticalMode === Alignment::VERTICAL_JUSTIFY || $this->verticalMode === Alignment::VERTICAL_DISTRIBUTED) { $vertical = 'middle'; }
+        return 'align="' . $horizontal . '" valign="' . $vertical . '"';
+    }
+
+    private function underlineCssValue(): string
+    {
+        switch ($this->underlineMode) {
+            case Font::UNDERLINE_DOUBLE:
+            case Font::UNDERLINE_DOUBLEACCOUNTING:
+                return 'underline double';
+            case Font::UNDERLINE_SINGLE:
+            case Font::UNDERLINE_SINGLEACCOUNTING:
+                return 'underline';
+            case Font::UNDERLINE_NONE:
+            case '':
+                return 'none';
+            default:
+                return 'underline';
+        }
+    }
