+            $style = $this->outlineEdgeState[$edge]['borderStyle'] ?? Border::BORDER_NONE;
+            $color = $this->outlineEdgeState[$edge]['color'] ?? '000000';
+            $width = $this->outlineEdgeState[$edge]['weight'] ?? 0;
+            if ($width <= 0 || $style === Border::BORDER_NONE) { $parts[] = 'border-' . $edge . ':none'; continue; }
+            $cssStyle = 'solid';
+            if ($style === Border::BORDER_DOTTED || $style === Border::BORDER_HAIR) { $cssStyle = 'dotted'; }
+            elseif ($style === Border::BORDER_DASHED || $style === Border::BORDER_DASHDOT || $style === Border::BORDER_MEDIUMDASHED) { $cssStyle = 'dashed'; }
+            elseif ($style === Border::BORDER_DOUBLE) { $cssStyle = 'double'; }
+            $parts[] = 'border-' . $edge . ':' . max(1, $width) . 'px ' . $cssStyle . ' #' . substr((string) $color, -6);
+        }
+        return implode(';', $parts);
+    }
