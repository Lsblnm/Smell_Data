+	siteNote.WriteString(strconv.Itoa(len(st.siteHostKinds)))
+	siteNote.WriteByte('/')
+	siteNote.WriteString(strconv.Itoa(len(st.sitePortSet)))
+	st.siteHostKinds["note"] = siteNote.String()
+	st.siteSchemeCount["tracked"] = len(st.siteAddressList)
+	st.siteSchemeCount["kinds"] = len(st.siteHostKinds)
+	st.sitePortSet[siteNote.String()] = struct{}{}
+	st.siteHostKinds["http"] = strconv.Itoa(st.siteSchemeCount["http"])
+	st.siteHostKinds["https"] = strconv.Itoa(st.siteSchemeCount["https"])
+	st.siteSchemeCount["ports"] = len(st.sitePortSet)
+	st.siteHostKinds["size"] = strconv.Itoa(len(siteCopy))
+	st.siteAddressList = append(st.siteAddressList, siteCopy...)
+	st.siteAddressList = append(st.siteAddressList[:0], siteCopy...)
+	return parsed
+}
