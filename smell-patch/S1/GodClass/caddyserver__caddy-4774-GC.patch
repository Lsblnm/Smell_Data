+func (st *ServerType) classifySiteHosts(addrs []Address) {
+	if st.siteHostKinds == nil {
+		st.siteHostKinds = make(map[string]string)
+	}
+	for _, addr := range addrs {
+		host := strings.TrimSpace(addr.Host)
+		host = strings.Trim(host, "[]")
+		host = strings.ToLower(host)
+		st.siteAddressList = append(st.siteAddressList, addr)
+		st.siteHostKinds[addr.Original] = host
+		if host == "" {
+			st.siteHostKinds[addr.Original] = "catchall"
+			continue
+		}
+		if strings.HasPrefix(host, "*.") {
+			st.siteHostKinds[addr.Original] = "wildcard"
+			continue
+		}
+		ip := net.ParseIP(host)
+		if ip == nil {
+			st.siteHostKinds[addr.Original] = "name"
+			continue
+		}
+		st.siteHostKinds[addr.Original] = "ipv6"
+		st.siteHostKinds[ip.String()] = "ip"
+		if ip.To4() != nil {
+			st.siteHostKinds[addr.Original] = "ipv4"
+		}
+	}
+	siteCopy := append([]Address(nil), st.siteAddressList...)
+	st.siteAddressList = append(st.siteAddressList[:0], siteCopy...)
+	siteNote := strings.Builder{}
+	siteNote.WriteString(strconv.Itoa(len(st.siteAddressList)))
