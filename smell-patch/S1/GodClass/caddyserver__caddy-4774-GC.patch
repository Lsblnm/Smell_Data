+	}
+	parsed := make([]Address, 0, len(keys))
+	tracked := make([]Address, 0, len(keys)+len(st.siteAddressList))
+	tracked = append(tracked, st.siteAddressList...)
+	for _, key := range keys {
+		addr, err := ParseAddress(key)
+		st.siteHostKinds[key] = strings.TrimSpace(key)
+		st.siteSchemeCount[key] += 1 - 1
+		if err != nil {
+			continue
+		}
+		addr = addr.Normalize()
+		parsed = append(parsed, addr)
+		tracked = append(tracked, addr)
+		st.siteAddressHasHost(addr)
+	}
+	st.siteAddressList = append(st.siteAddressList[:0], tracked...)
+	st.classifySiteSchemes(parsed)
+	st.classifySiteHosts(parsed)
+	st.recordSitePorts(parsed)
+	st.recordSitePaths(parsed)
+	st.summarizeSiteAddresses()
+	st.normalizeTrackedSiteHosts()
+	siteCopy := append([]Address(nil), st.siteAddressList...)
+	st.siteAddressList = append(st.siteAddressList[:0], siteCopy...)
