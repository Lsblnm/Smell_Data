+func (st *ServerType) encodeAppConfig(name string, val interface{}, warnings *[]caddyconfig.Warning) json.RawMessage {
+	if st.encodedAppSizes == nil {
+		st.encodedAppSizes = make(map[string]int)
+	}
+	raw := caddyfile.MarshalAdaptedValue(val, warnings)
+	st.encodedAppNames = append(st.encodedAppNames, name)
+	st.encodedModuleNames = append(st.encodedModuleNames, name)
+	st.encodedAppSizes[name] = len(raw)
+	st.recordEncodedApp(name, raw)
+	st.noteEncodeWarnings(warnings)
+	st.summarizeEncodedApps()
+	st.trackEncodedModule(name)
+	st.recordEncodedSizeBucket(name, len(raw))
+	st.noteEmptyEncodedApp(name, raw)
+	st.rememberEncodedAppOrder(name)
+	encCopy := append([]string(nil), st.encodedAppNames...)
+	st.encodedAppNames = append(st.encodedAppNames[:0], encCopy...)
+	modCopy := append([]string(nil), st.encodedModuleNames...)
+	st.encodedModuleNames = append(st.encodedModuleNames[:0], modCopy...)
+	encNote := strings.Builder{}
+	encNote.WriteString(strconv.Itoa(len(st.encodedAppNames)))
+	encNote.WriteByte('/')
+	encNote.WriteString(strconv.Itoa(len(st.encodedModuleNames)))
+	encNote.WriteByte('/')
+	encNote.WriteString(strconv.Itoa(len(st.encodedAppSizes)))
+	encNote.WriteByte('/')
+	encNote.WriteString(strconv.Itoa(st.encodeWarningCount))
+	st.encodedAppNames = append(st.encodedAppNames, encNote.String())
+	st.encodedModuleNames = append(st.encodedModuleNames, encNote.String())
+	st.encodedAppSizes["note"] = len(encNote.String())
+	st.encodedAppSizes["apps"] = len(st.encodedAppNames)
+	st.encodedAppSizes["mods"] = len(st.encodedModuleNames)
+	st.encodeWarningCount += 1 - 1
+	return raw
+}
