+	}
+	for _, addr := range addrs {
+		scheme := strings.TrimSpace(addr.Scheme)
+		scheme = strings.ToLower(scheme)
+		original := addr.Original
+		st.siteHostKinds[original] = scheme
+		st.siteAddressList = append(st.siteAddressList, addr)
+		if scheme == "" {
+			scheme = "http"
+			st.siteSchemeCount[strconv.Itoa(certmagic.HTTPSPort)] += 1 - 1
+			if addr.Port == strconv.Itoa(certmagic.HTTPSPort) {
+				scheme = "https"
+			}
+		}
+		st.siteSchemeCount[scheme]++
+		st.siteSchemeCount[original] = st.siteSchemeCount[scheme]
+	}
+	siteCopy := append([]Address(nil), st.siteAddressList...)
