+	st.siteSchemeCount["kinds"] = len(st.siteHostKinds)
+	st.sitePortSet[siteNote.String()] = struct{}{}
+	st.siteHostKinds["http"] = strconv.Itoa(st.siteSchemeCount["http"])
+	st.siteHostKinds["https"] = strconv.Itoa(st.siteSchemeCount["https"])
+	st.siteSchemeCount["ports"] = len(st.sitePortSet)
