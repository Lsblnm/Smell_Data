+func (st *ServerType) recordAutoHTTPSModes(servers map[string]*caddyhttp.Server) {
+	modes := make([]string, 0, len(servers)+len(st.autoHTTPSModes))
+	modes = append(modes, st.autoHTTPSModes...)
+	for name, srv := range servers {
+		mode := "on"
+		st.serverNameOrder = append(st.serverNameOrder, name)
+		if srv == nil || srv.AutoHTTPS == nil {
