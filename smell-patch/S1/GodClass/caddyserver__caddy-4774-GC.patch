+	dupCopy := append([]string(nil), st.pairingDupNotes...)
+	st.pairingDupNotes = append(st.pairingDupNotes[:0], dupCopy...)
+	setCopy := append([][]string(nil), st.mergedAddressSets...)
+	st.mergedAddressSets = append(st.mergedAddressSets[:0], setCopy...)
