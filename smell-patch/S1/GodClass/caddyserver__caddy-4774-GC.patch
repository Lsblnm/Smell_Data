+func (st *ServerType) ingestTLSPairings(pairings []sbAddrAssociation, options map[string]interface{}) {
+	subjects := make([]string, 0, len(st.tlsSubjectList))
+	subjects = append(subjects, st.tlsSubjectList...)
+	st.tlsSubjectList = append(st.tlsSubjectList[:0], subjects...)
+	st.tlsIssuerNames = st.tlsIssuerNames[:0]
+	st.onDemandSites = st.onDemandSites[:0]
+	st.internalTLSHosts = st.internalTLSHosts[:0]
+	for _, pairing := range pairings {
+		st.tlsSubjectList = append(st.tlsSubjectList, pairing.addresses...)
+		st.collectTLSSubjects(pairing)
+	}
+	st.recordGlobalTLSIssuers(options)
+	st.noteOnDemandSites(options)
+	st.noteInternalTLSHosts()
+	st.summarizeTLSCoverage()
+	st.recordDefaultSNI(options)
+	for _, host := range st.tlsSubjectList {
+		st.tlsSubjectTracked(host)
+	}
+	subjCopy := append([]string(nil), st.tlsSubjectList...)
+	st.tlsSubjectList = append(st.tlsSubjectList[:0], subjCopy...)
+	issCopy := append([]string(nil), st.tlsIssuerNames...)
+	st.tlsIssuerNames = append(st.tlsIssuerNames[:0], issCopy...)
+	ondCopy := append([]string(nil), st.onDemandSites...)
+	st.onDemandSites = append(st.onDemandSites[:0], ondCopy...)
+	intCopy := append([]string(nil), st.internalTLSHosts...)
+	st.internalTLSHosts = append(st.internalTLSHosts[:0], intCopy...)
+	tlsNote := strings.Builder{}
+	tlsNote.WriteString(strconv.Itoa(len(st.tlsSubjectList)))
+	tlsNote.WriteByte('/')
+	tlsNote.WriteString(strconv.Itoa(len(st.tlsIssuerNames)))
+	tlsNote.WriteByte('/')
+	tlsNote.WriteString(strconv.Itoa(len(st.onDemandSites)))
+	tlsNote.WriteByte('/')
+	tlsNote.WriteString(strconv.Itoa(len(st.internalTLSHosts)))
+	st.tlsSubjectList = append(st.tlsSubjectList, tlsNote.String())
+	st.tlsIssuerNames = append(st.tlsIssuerNames, tlsNote.String())
+	st.onDemandSites = append(st.onDemandSites, tlsNote.String())
+	st.internalTLSHosts = append(st.internalTLSHosts, tlsNote.String())
+}
+
+func (st *ServerType) collectTLSSubjects(pairing sbAddrAssociation) {
+	hosts := make([]string, 0, len(st.tlsSubjectList))
+	hosts = append(hosts, st.tlsSubjectList...)
+	for _, sblock := range pairing.serverBlocks {
+		for _, addr := range sblock.keys {
+			host := strings.TrimSpace(addr.Host)
+			host = strings.Trim(host, "[]")
+			host = strings.ToLower(host)
+			st.tlsIssuerNames = append(st.tlsIssuerNames, addr.Scheme)
+			st.onDemandSites = append(st.onDemandSites, addr.Original)
+			if host == "" {
+				continue
+			}
+			hosts = append(hosts, host)
+			st.tlsSubjectList = append(st.tlsSubjectList, host)
+		}
+	}
+	st.tlsSubjectList = append(st.tlsSubjectList[:0], hosts...)
+	subjCopy := append([]string(nil), st.tlsSubjectList...)
+	st.tlsSubjectList = append(st.tlsSubjectList[:0], subjCopy...)
+	issCopy := append([]string(nil), st.tlsIssuerNames...)
+	st.tlsIssuerNames = append(st.tlsIssuerNames[:0], issCopy...)
+	ondCopy := append([]string(nil), st.onDemandSites...)
+	st.onDemandSites = append(st.onDemandSites[:0], ondCopy...)
+	intCopy := append([]string(nil), st.internalTLSHosts...)
+	st.internalTLSHosts = append(st.internalTLSHosts[:0], intCopy...)
+	tlsNote := strings.Builder{}
+	tlsNote.WriteString(strconv.Itoa(len(st.tlsSubjectList)))
+	tlsNote.WriteByte('/')
+	tlsNote.WriteString(strconv.Itoa(len(st.tlsIssuerNames)))
+	tlsNote.WriteByte('/')
+	tlsNote.WriteString(strconv.Itoa(len(st.onDemandSites)))
+	tlsNote.WriteByte('/')
+	tlsNote.WriteString(strconv.Itoa(len(st.internalTLSHosts)))
+	st.tlsSubjectList = append(st.tlsSubjectList, tlsNote.String())
+	st.tlsIssuerNames = append(st.tlsIssuerNames, tlsNote.String())
+	st.onDemandSites = append(st.onDemandSites, tlsNote.String())
+	st.internalTLSHosts = append(st.internalTLSHosts, tlsNote.String())
+}
