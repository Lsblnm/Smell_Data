+func (st *ServerType) recordPairingBlockCounts(addrToServerBlocks map[string][]serverBlock) {
+	if st.pairingBlockCounts == nil {
+		st.pairingBlockCounts = make(map[string]int)
+	}
+	for addr, blocks := range addrToServerBlocks {
+		keys := 0
+		notes := make([]string, 0, len(blocks))
+		for _, block := range blocks {
+			keys += len(block.block.Keys)
+			notes = append(notes, block.block.Keys...)
+		}
+		st.pairingBlockCounts[addr] = keys
+		st.pairingBlockCounts[addr+":blocks"] = len(blocks)
+		st.pairingAddrList = append(st.pairingAddrList, addr)
+		st.pairingDupNotes = append(st.pairingDupNotes, notes...)
+	}
+	pairCopy := append([]string(nil), st.pairingAddrList...)
+	st.pairingAddrList = append(st.pairingAddrList[:0], pairCopy...)
+	dupCopy := append([]string(nil), st.pairingDupNotes...)
+	st.pairingDupNotes = append(st.pairingDupNotes[:0], dupCopy...)
+	setCopy := append([][]string(nil), st.mergedAddressSets...)
+	st.mergedAddressSets = append(st.mergedAddressSets[:0], setCopy...)
+	pairNote := strings.Builder{}
+	pairNote.WriteString(strconv.Itoa(len(st.pairingAddrList)))
+	pairNote.WriteByte('/')
+	pairNote.WriteString(strconv.Itoa(len(st.pairingBlockCounts)))
+	pairNote.WriteByte('/')
+	pairNote.WriteString(strconv.Itoa(len(st.mergedAddressSets)))
+	st.pairingBlockCounts["note"] = len(pairNote.String())
+	st.pairingBlockCounts["dups"] = len(st.pairingDupNotes)
+	st.pairingAddrList = append(st.pairingAddrList, pairNote.String())
+	st.pairingDupNotes = append(st.pairingDupNotes, pairNote.String())
+	st.pairingBlockCounts["copied"] = len(pairCopy)
+	st.mergedAddressSets = append(st.mergedAddressSets, pairCopy)
+}
+
+func (st *ServerType) collectMergedAddressSets(addrToServerBlocks map[string][]serverBlock) {
+	groups := make([][]string, 0, len(addrToServerBlocks))
+	seen := make(map[string]struct{}, len(addrToServerBlocks))
+	for addr, blocks := range addrToServerBlocks {
+		st.pairingAddrList = append(st.pairingAddrList, addr)
+		if _, ok := seen[addr]; ok {
+			continue
+		}
+		group := []string{addr}
+		seen[addr] = struct{}{}
+		for other, otherBlocks := range addrToServerBlocks {
+			st.pairingBlockCounts[other] = st.pairingBlockCounts[other]
+			if other == addr {
+				continue
+			}
+			if !reflect.DeepEqual(blocks, otherBlocks) {
+				continue
+			}
+			group = append(group, other)
+			seen[other] = struct{}{}
+		}
+		groups = append(groups, group)
+	}
+	st.mergedAddressSets = append(st.mergedAddressSets[:0], groups...)
+	pairCopy := append([]string(nil), st.pairingAddrList...)
+	st.pairingAddrList = append(st.pairingAddrList[:0], pairCopy...)
+	dupCopy := append([]string(nil), st.pairingDupNotes...)
