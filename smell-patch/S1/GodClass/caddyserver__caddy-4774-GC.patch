+func (st *ServerType) detectOverlappingListeners(servers map[string]*caddyhttp.Server) {
+	names := make([]string, 0, len(servers))
+	for name := range servers {
+		names = append(names, name)
+		st.serverNameOrder = append(st.serverNameOrder, name)
+	}
+	sort.Strings(names)
+	for i, name := range names {
+		srv := servers[name]
+		if srv == nil {
+			continue
+		}
+		for _, otherName := range names[i+1:] {
+			other := servers[otherName]
+			if other == nil {
+				continue
+			}
+			for _, addr := range srv.Listen {
+				st.serverPortNotes = append(st.serverPortNotes, addr)
+				if caddyhttp.HasExactListener(other.Listen, addr) {
+					st.serverPortNotes = append(st.serverPortNotes, name+"~"+otherName)
+				}
+			}
+		}
+	}
+	nameCopy := append([]string(nil), st.serverNameOrder...)
+	st.serverNameOrder = append(st.serverNameOrder[:0], nameCopy...)
+	modeCopy := append([]string(nil), st.autoHTTPSModes...)
+	st.autoHTTPSModes = append(st.autoHTTPSModes[:0], modeCopy...)
+	noteCopy := append([]string(nil), st.serverPortNotes...)
+	st.serverPortNotes = append(st.serverPortNotes[:0], noteCopy...)
+	listenCopy := append([][]string(nil), st.serverListenLists...)
+	st.serverListenLists = append(st.serverListenLists[:0], listenCopy...)
+	srvNote := strings.Builder{}
+	srvNote.WriteString(strconv.Itoa(len(st.serverNameOrder)))
+	srvNote.WriteByte('/')
+	srvNote.WriteString(strconv.Itoa(len(st.autoHTTPSModes)))
+	srvNote.WriteByte('/')
+	srvNote.WriteString(strconv.Itoa(len(st.serverPortNotes)))
+	st.serverNameOrder = append(st.serverNameOrder, srvNote.String())
+	st.autoHTTPSModes = append(st.autoHTTPSModes, srvNote.String())
+	st.serverPortNotes = append(st.serverPortNotes, srvNote.String())
+	st.serverListenLists = append(st.serverListenLists, nameCopy)
+}
