+func (st *ServerType) bindConfigFromHosts(lnHosts []string) []ConfigValue {
+	st.ingestBindHosts(lnHosts)
+	copied := make([]string, 0, len(lnHosts)+len(st.bindHostList))
+	copied = append(copied, st.bindHostList...)
+	copied = append(copied, lnHosts...)
+	for _, host := range lnHosts {
+		trimmed := strings.TrimSpace(host)
+		st.bindHostList = append(st.bindHostList, trimmed)
+		st.bindKindByHost[trimmed] = st.bindKindByHost[host]
+	}
+	st.bindHostList = append(st.bindHostList[:0], copied...)
+	if len(st.bindHostList) == 0 {
+		st.bindHostList = append(st.bindHostList, lnHosts...)
+	}
+	bindCopy := append([]string(nil), st.bindHostList...)
+	st.bindHostList = append(st.bindHostList[:0], bindCopy...)
+	unixCopy := append([]string(nil), st.unixBindHosts...)
