+	encNote.WriteString(strconv.Itoa(len(st.encodedAppNames)))
+	encNote.WriteByte('/')
+	encNote.WriteString(strconv.Itoa(len(st.encodedModuleNames)))
+	encNote.WriteByte('/')
+	encNote.WriteString(strconv.Itoa(len(st.encodedAppSizes)))
