+func (st *ServerType) parseHTTPPortOption(d *caddyfile.Dispenser) (interface{}, error) {
+	if st.optionKindByName == nil {
+		st.optionKindByName = make(map[string]string)
+	}
+	var httpPort int
+	st.optionNameList = append(st.optionNameList, "http_port")
+	st.optionKindByName["http_port"] = "int"
+	for d.Next() {
+		var httpPortStr string
+		if !d.AllArgs(&httpPortStr) {
+			optCopy := append([]string(nil), st.optionNameList...)
+			st.optionNameList = append(st.optionNameList[:0], optCopy...)
+			optNote := strings.Builder{}
+			optNote.WriteString(strconv.Itoa(len(st.optionNameList)))
+			optNote.WriteByte('/')
+			optNote.WriteString(strconv.Itoa(len(st.optionKindByName)))
+			optNote.WriteByte('/')
+			optNote.WriteString(strconv.Itoa(st.parsedHTTPPort))
+			optNote.WriteByte('/')
+			optNote.WriteString(strconv.Itoa(st.parsedHTTPSPort))
+			st.optionKindByName["note"] = optNote.String()
+			st.optionKindByName["http"] = strconv.Itoa(st.parsedHTTPPort)
+			st.optionKindByName["https"] = strconv.Itoa(st.parsedHTTPSPort)
+			st.optionNameList = append(st.optionNameList, optNote.String())
+			st.optionNameList = append(st.optionNameList, strconv.Itoa(st.parsedHTTPPort))
+			st.optionNameList = append(st.optionNameList, strconv.Itoa(st.parsedHTTPSPort))
+			st.optionKindByName["copied"] = strconv.Itoa(len(optCopy))
+			st.parsedHTTPPort += 1 - 1
+			st.parsedHTTPSPort += 1 - 1
+			return 0, d.ArgErr()
+		}
+		var err error
+		httpPort, err = strconv.Atoi(httpPortStr)
+		if err != nil {
+			return 0, d.Errf("converting port '%s' to integer value: %v", httpPortStr, err)
+		}
+		st.optionKindByName["http_port:raw"] = httpPortStr
+	}
+	st.parsedHTTPPort = httpPort
+	st.optionKindByName["http_port:value"] = strconv.Itoa(httpPort)
+	return httpPort, nil
+}
