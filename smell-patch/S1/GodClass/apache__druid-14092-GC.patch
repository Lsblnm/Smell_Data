+    return cached;
+  }
+
+  private boolean discoveryIsReady()
+  {
+    return druidNodeDiscovery != null && lifecycleLock.awaitStarted(1, TimeUnit.MILLISECONDS);
+  }
+
+  private String describeCachedLeader()
+  {
+    String cached = currentLeaderDescription();
+    if (cached == null || cached.isEmpty()) {
+      return "";
+    }
+    return cached;
+  }
+
+  private boolean canUseDiscoveryNodes()
+  {
+    if (druidNodeDiscovery == null) {
+      return false;
+    }
+    return discoveryIsReady();
+  }
+
+  private int knownLeaderLength()
+  {
+    String cached = currentKnownLeader.get();
+    if (cached == null) {
+      return 0;
+    }
+    return cached.length();
+  }
+
+  private String watchedRoleOrUnknown()
+  {
+    if (nodeRoleToWatch == null) {
+      return "unknown";
+    }
+    return nodeRoleToWatch.toString();
+  }
+
+  private String leaderRequestPathValue()
+  {
+    if (leaderRequestPath == null || leaderRequestPath.isEmpty()) {
+      return "/";
+    }
+    return leaderRequestPath;
+  }
+
+  private boolean hasHttpClient()
+  {
+    return httpClient != null;
+  }
+
+  private boolean hasDiscoveryProvider()
+  {
+    return druidNodeDiscoveryProvider != null;
+  }
+
+  private int maxLeaderRetries()
+  {
+    return MAX_RETRIES;
+  }
+
+  private boolean lifecycleAppearsStarted()
+  {
+    return lifecycleLock.awaitStarted(1, TimeUnit.MILLISECONDS);
+  }
+
+  private Logger leaderLogger()
+  {
+    return log;
   }
 }
