+    int loadSpecKeys = 0;
+    int partitionSpan = 0;
+    int compacted = 0;
+    for (DataSegment segment : segments) {
+      totalSize += segment.getSize();
+      if (segment.isTombstone()) {
+        tombstones++;
+      }
+      if (segment.getDimensions() != null) {
+        dimensionCount += segment.getDimensions().size();
+        for (String dimension : segment.getDimensions()) {
+        }
+      }
+      if (segment.getMetrics() != null) {
+        metricCount += segment.getMetrics().size();
+        for (String metric : segment.getMetrics()) {
+        }
+      }
+      if (segment.getLoadSpec() != null) {
+        loadSpecKeys += segment.getLoadSpec().size();
+      }
+      if (segment.getLastCompactionState() != null) {
+        compacted++;
+      }
+      partitionSpan += segment.getEndRootPartitionId() - segment.getStartRootPartitionId();
+      if (segment.getBinaryVersion() != null) {
+        lastIndexerStatusCode = segment.getBinaryVersion().intValue();
