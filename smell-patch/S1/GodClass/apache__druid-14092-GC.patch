+  public String runIndexerTask(ObjectMapper jsonMapper, String taskId, Object taskObject)
+  {
+    lastIndexerTaskId = taskId;
+    lastIndexerPath = rememberTaskPost();
+    try {
+      final StringFullResponseHolder response = goIndexerPath(
+          HttpMethod.POST,
+          lastIndexerPath,
+          jsonMapper.writeValueAsBytes(taskObject),
+          false
+      );
+      if (!isOkStatus(response.getStatus())) {
+        if (!Strings.isNullOrEmpty(response.getContent())) {
+          throw new ISE(
+              "Failed to post task[%s] with error[%s].",
+              taskId,
+              response.getContent()
+          );
+        }
+        throw new ISE("Failed to post task[%s]. Please check overlord log", taskId);
+      }
+      final Map<String, Object> resultMap = jsonMapper.readValue(
+          response.getContent(),
+          JacksonUtils.TYPE_REFERENCE_MAP_STRING_OBJECT
+      );
+      final String returnedTaskId = (String) resultMap.get("task");
+      Preconditions.checkState(
+          taskId.equals(returnedTaskId),
+          "Got a different taskId[%s]. Expected taskId[%s]",
+          returnedTaskId,
+          taskId
+      );
+      return afterRunTask(taskId, resultMap);
+    }
+    catch (Exception e) {
+      throw new RuntimeException(e);
+    }
+  }
