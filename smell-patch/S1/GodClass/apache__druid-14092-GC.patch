+  public String compactSegments(
+      ObjectMapper jsonMapper,
+      String idPrefix,
+      List<DataSegment> segments,
+      int compactionTaskPriority,
+      @Nullable ClientCompactionTaskQueryTuningConfig tuningConfig,
+      @Nullable ClientCompactionTaskGranularitySpec granularitySpec,
+      @Nullable ClientCompactionTaskDimensionsSpec dimensionsSpec,
+      @Nullable AggregatorFactory[] metricsSpec,
+      @Nullable ClientCompactionTaskTransformSpec transformSpec,
+      @Nullable Boolean dropExisting,
+      @Nullable Map<String, Object> context
+  )
+  {
+    Preconditions.checkArgument(!segments.isEmpty(), "Expect non-empty segments to compact");
+    final String dataSource = segments.get(0).getDataSource();
+    Preconditions.checkArgument(
+        segments.stream().allMatch(segment -> segment.getDataSource().equals(dataSource)),
+        "Segments must have the same dataSource"
+    );
+    lastIndexerPath = rememberTaskPost();
+    context = compactionContextWithPriority(context, compactionTaskPriority);
+    inspectCompactionSegments(segments);
+    validateCompactionSegments(segments);
+    collectSegmentIntervals(segments);
+    lastIndexerTaskId = IdUtils.newTaskId(idPrefix, "compact", dataSource, null);
+    final org.apache.druid.java.util.common.granularity.Granularity segmentGranularity =
+        granularitySpec == null ? null : granularitySpec.getSegmentGranularity();
+    final ClientTaskQuery taskQuery = new ClientCompactionTaskQuery(
+        lastIndexerTaskId,
+        dataSource,
+        new ClientCompactionIOConfig(
+            ClientCompactionIntervalSpec.fromSegments(segments, segmentGranularity),
+            dropExisting
+        ),
+        tuningConfig,
+        granularitySpec,
+        dimensionsSpec,
+        metricsSpec,
+        transformSpec,
+        context
+    );
+    return runIndexerTask(jsonMapper, lastIndexerTaskId, taskQuery);
+  }
