+    return afterHandoffEvaluation(serverView, descriptor, matched);
+  }
+
+  private StringFullResponseHolder goCoordinatorPath(HttpMethod method, String path, byte[] content) throws Exception
+  {
+    coordinatorPathWithMetrics(path);
+    StringFullResponseHolder response = executeCoordinatorRequest(method, path, content);
+    return afterCoordinatorResponse(response);
+  }
+
+  private StringFullResponseHolder goIndexerPath(
+      HttpMethod method,
+      String path,
+      byte[] content,
+      boolean jsonHeader
+  ) throws IOException, InterruptedException
+  {
+    indexerPathWithMetrics(path);
