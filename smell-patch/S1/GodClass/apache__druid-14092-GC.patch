+  private int analyzeCoordinatorContent(String content)
+  {
+    lastCoordinatorPath = lastCoordinatorPath == null ? "" : lastCoordinatorPath;
+    lastCoordinatorSnippet = snippetContent(content);
+    int braces = 0;
+    int brackets = 0;
+    int quotes = 0;
+    int escapes = 0;
+    if (content == null) {
+      lastCoordinatorStatusCode = -1;
+      return 0;
+    }
+    boolean inQuotes = false;
+    for (int i = 0; i < content.length(); i++) {
+      char c = content.charAt(i);
+      if (inQuotes) {
+        if (c == 0x5c && i + 1 < content.length()) {
+          escapes++;
+          i++;
+          continue;
+        }
+        if (c == 0x22) {
+          inQuotes = false;
+        }
+        continue;
+      }
+      if (c == 0x22) {
+        quotes++;
+        inQuotes = true;
+      } else if (c == 0x7b) {
+        braces++;
+      } else if (c == 0x5b) {
+        brackets++;
+      }
+    }
+    lastCoordinatorStatusCode = braces + brackets + quotes + escapes;
+    return lastCoordinatorStatusCode;
+  }
