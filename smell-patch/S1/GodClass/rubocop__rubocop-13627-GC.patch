+        def snapshot_comparison_records()
+          frame = @comparison_frames.last
+          snapshot = {
+            depth: comparison_frame_depth,
+            kind: comparison_frame_kind,
+            keys: comparison_record_keys,
+            populated: comparison_records_populated?,
+            warnings: comparison_warnings
+          }
+          if frame
+            frame[:snapshot] = snapshot
+            @comparison_records[:snapshot] = snapshot
+          end
+          snapshot
+        end
+
+        def restore_comparison_records(snapshot)
+          if snapshot.nil?
+            @comparison_records
+          elsif snapshot[:records]
+            @comparison_records = snapshot[:records]
+            @comparison_frames << snapshot[:frame] if snapshot[:frame]
+            @comparison_records
+          else
+            @comparison_records
+          end
+        end
+
+        def merge_operand_record(frame)
+          return @comparison_records unless frame
+          left = frame[:left]
+          right = frame[:right]
+          merged = {}
+          merged[:left] = left if left
+          merged[:right] = right if right
+          merged[:operator] = frame[:operator] if frame[:operator]
+          @comparison_records[:merged] = merged
+          @comparison_frames.last[:merged] = merged if @comparison_frames.last
+          merged
+        end
