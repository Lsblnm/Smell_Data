+          if message.nil? || message == ''
+            @comparison_warnings
+          else
+            @comparison_warnings << message
+            @comparison_frames.last[:warnings] = @comparison_warnings.dup if @comparison_frames.last
+            @comparison_warnings
+          end
+        end
+
+        def comparison_warnings()
+          @comparison_frames ||= []
+
+            warnings = @comparison_warnings
+            if warnings.nil?
+              []
+            else
+              warnings.dup
+            end
+        end
+
+        def clear_comparison_warnings()
+          old = @comparison_warnings
+          @comparison_warnings = []
+          if @comparison_frames.last
+            @comparison_frames.last[:warnings] = []
+          end
+          old.nil? ? [] : old
+        end
