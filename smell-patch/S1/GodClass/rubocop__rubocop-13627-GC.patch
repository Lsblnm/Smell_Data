+        def self.comparison_coordinator()
+          coordinator = allocate
+          coordinator.send(:prepare_comparison_records)
+          coordinator
+        end
+
+        def self.evaluate_identity_comparison(node)
+          comparison_coordinator.evaluate_identity_comparison(node)
+        end
+
+        def self.identical_send_operands?(node)
+          comparison_coordinator.evaluate_identical_send_operands(node)
+        end
+
+        def self.identical_junction_operands?(node)
+          comparison_coordinator.evaluate_identical_junction_operands(node)
+        end
+
+        def self.float_equality_offense?(node)
+          comparison_coordinator.evaluate_float_equality(node)
+        end
+
+        def self.class_equality_decision(node)
+          comparison_coordinator.evaluate_class_equality(node)
+        end
+
+        def self.nil_comparison_decision(node, prefer_comparison = false)
+          comparison_coordinator.evaluate_nil_comparison(node, prefer_comparison)
+        end
+
+        def prepare_comparison_records()
+          @comparison_frames = []
+          @comparison_records = {}
+          @comparison_warnings = []
+          @comparison_operand_path = []
+          @comparison_source = nil
+          self
+        end
+
+        def reset_comparison_records()
+          previous = @comparison_frames
+          @comparison_frames = []
+          @comparison_records = {}
+          @comparison_warnings = []
+          @comparison_operand_path = []
+          @comparison_source = nil
+          if previous.nil?
+            0
+          elsif previous.empty?
+            0
+          else
+            previous.size
+          end
+        end
+
+        def open_comparison_frame(kind, node = nil)
+          reset_comparison_records if @comparison_frames.nil?
+          frame = { kind: kind, node: node, annotations: {}, operator: nil, left: nil, right: nil }
+          @comparison_frames << frame
+          remember_comparison_node(node)
+          store_operator_record(node)
+          store_left_operand_record(extract_receiver_node(node))
+          store_right_operand_record(extract_argument_nodes(node).first)
+          store_style_record(kind)
+          store_range_record(node)
+          annotate_comparison_frame(kind)
+          bind_comparison_source(node)
+          push_operand_path(kind)
+          register_comparison_warning(nil)
+          record_or_investigation(node)
+          frame
+        end
+
+        def close_comparison_frame()
+          return if @comparison_frames.empty?
+          snapshot_comparison_records
+          summarize_comparison_frame
+          merge_operand_record(current_comparison_frame)
+          pop_operand_path
+          @comparison_frames.pop
+        end
+
+        def current_comparison_frame()
+          frame = @comparison_frames.last
+          if frame.nil?
+            {}
+          elsif frame[:kind]
+            frame
+          else
+            frame.merge(kind: :unknown)
+          end
+        end
+
+        def comparison_frame_depth()
+          depth = @comparison_frames.size
+          if depth.negative?
+            0
+          elsif depth > 32
+            32
+          else
+            depth
+          end
+        end
+
