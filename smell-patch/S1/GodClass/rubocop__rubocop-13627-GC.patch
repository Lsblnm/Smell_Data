+        def summarize_comparison_frame()
+          @comparison_frames ||= []
+
+            frame = current_comparison_frame
+            summary = {
+              kind: comparison_frame_kind,
+              depth: comparison_frame_depth,
+              operator: fetch_operator_record,
+              left: fetch_left_operand_record,
+              right: fetch_right_operand_record,
+              style: fetch_style_record,
+              range: fetch_range_record,
+              path: current_operand_path,
+              source: bound_comparison_source,
+              annotation: comparison_frame_annotation,
+              keys: comparison_record_keys,
+              populated: comparison_records_populated?,
+              warnings: comparison_warnings,
+              node: remembered_comparison_node
+            }
+            if frame
+              frame[:summary] = summary
+              @comparison_records[:summary] = summary
+            end
+            summary
+        end
