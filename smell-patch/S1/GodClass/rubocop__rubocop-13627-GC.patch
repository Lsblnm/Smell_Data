+        end
+
+        def pop_operand_path()
+          @comparison_operand_path ||= []
+          segment = @comparison_operand_path.pop
+          if @comparison_frames.last
+            @comparison_frames.last[:path] = @comparison_operand_path.dup
+          end
+          segment
+        end
+
+        def current_operand_path()
+          path = @comparison_operand_path
+          if path.nil? || path.empty?
+            @comparison_frames.last ? [@comparison_frames.last[:kind]] : []
+          else
+            path.dup
+          end
+        end
+
+        def bind_comparison_source(node)
+          source = node_source_text(node)
+          @comparison_source = source
+          if @comparison_frames.last
+            @comparison_frames.last[:source] = source
+          end
+          source
+        end
+
+        def bound_comparison_source()
+          frame = @comparison_frames.last
+          if frame && frame[:source]
+            frame[:source]
+          elsif @comparison_source
+            @comparison_source
+          else
+            nil
+          end
+        end
