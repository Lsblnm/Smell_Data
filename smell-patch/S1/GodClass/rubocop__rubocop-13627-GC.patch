+        def record_or_investigation(node)
+          @comparison_frames ||= []
+          walk_comparison_tree(node)
+          record_send_investigation(node) if node.respond_to?(:send_type?) && node.send_type?
+          record_and_investigation(node) if node.respond_to?(:and_type?) && node.and_type?
