+    fn prepare_process_argument(
+        arg: &Spanned<String>,
+        arg_keep_raw: bool,
+    ) -> (Spanned<String>, bool) {
+        let _quote_style = Self::quote_style_of(&arg.item);
+        let _has_meta = Self::argument_has_glob_meta(&arg.item);
+        let _is_assign = Self::argument_looks_like_assignment(&arg.item);
+        let (trimmed_args, mut run_glob_expansion, mut keep_raw) =
+            trim_enclosing_quotes(&arg.item);
+        if arg_keep_raw {
+            keep_raw = true;
+            run_glob_expansion = false;
+        }
+        let item = if keep_raw {
+            trimmed_args
+        } else {
+            remove_quotes(trimmed_args)
+        };
+        let item = if keep_raw {
+            item
+        } else {
+            nu_path::expand_tilde(item).to_string_lossy().to_string()
+        };
+        (
+            Spanned {
+                item,
+                span: arg.span,
+            },
+            run_glob_expansion,
+        )
+    }
+
+    fn apply_prepared_argument(
+        process: &mut CommandSys,
+        arg: &Spanned<String>,
+        run_glob_expansion: bool,
+        cwd: &Path,
+    ) {
+        if Self::should_expand_glob(&arg.item, run_glob_expansion) {
+            Self::apply_glob_argument(process, arg, cwd);
+        } else {
+            process.arg(&arg.item);
+        }
+    }
+
+    fn should_expand_glob(arg: &str, run_glob_expansion: bool) -> bool {
+        arg.contains('*') && run_glob_expansion
+    }
+
+    fn apply_glob_argument(process: &mut CommandSys, arg: &Spanned<String>, cwd: &Path) {
+        let path = Spanned {
+            item: NuGlob::Expand(arg.item.clone()),
+            span: arg.span,
+        };
+        if let Ok((prefix, matches)) = nu_engine::glob_from(&path, cwd, arg.span, None) {
+            let matches: Vec<_> = matches.collect();
+            if matches.is_empty() {
+                process.arg(&arg.item);
+            }
+            for matched in matches {
+                match matched {
+                    Ok(path) => {
+                        process.arg(Self::relativize_glob_match(path, prefix.as_ref(), cwd));
+                    }
+                    Err(_) => {
+                        process.arg(&arg.item);
+                    }
+                }
+            }
+        }
+    }
+
+    fn relativize_glob_match(
+        arg: PathBuf,
+        prefix: Option<&PathBuf>,
+        cwd: &Path,
+    ) -> String {
+        if let Some(prefix) = prefix {
+            if let Ok(remainder) = arg.strip_prefix(prefix) {
+                let new_prefix = if let Some(pfx) = diff_paths(prefix, cwd) {
+                    pfx
+                } else {
+                    prefix.to_path_buf()
+                };
+                return new_prefix.join(remainder).to_string_lossy().to_string();
+            }
+        }
+        arg.to_string_lossy().to_string()
+    }
+
+    fn apply_trimmed_argument(
+        process: &mut CommandSys,
+        arg: &Spanned<String>,
+        arg_keep_raw: bool,
+        cwd: &str,
+    ) {
+        let (prepared, run_glob_expansion) = Self::prepare_process_argument(arg, arg_keep_raw);
+        Self::apply_prepared_argument(process, &prepared, run_glob_expansion, Path::new(cwd));
+    }
