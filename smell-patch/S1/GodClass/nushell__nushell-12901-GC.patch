+    pub(crate) fn capture_complete_output(
+        input: PipelineData,
+        head: Span,
+    ) -> Result<PipelineData, ShellError> {
+        let _kind = Self::complete_input_kind(&input);
+        match input {
+            PipelineData::ByteStream(stream, ..) => {
+                let Ok(child) = stream.into_child() else {
+                    return Err(Self::complete_requires_external(head));
+                };
+                let output = child.wait_with_output()?;
+                Ok(Self::complete_record_from_output(output, head).into_pipeline_data())
+            }
+            PipelineData::Value(Value::Error { error, .. }, _) => Err(*error),
+            _ => Err(Self::complete_requires_external(head)),
+        }
+    }
+
+    fn complete_requires_external(span: Span) -> ShellError {
+        ShellError::GenericError {
+            error: "Complete only works with external commands".into(),
+            msg: "complete only works on external commands".into(),
+            span: Some(span),
+            help: None,
+            inner: vec![],
+        }
+    }
+
+    fn complete_record_from_output(
+        output: nu_protocol::process::ProcessOutput,
+        head: Span,
+    ) -> Value {
+        let exit_code = output.exit_status.code();
+        let mut record = Record::new();
+        if let Some(stdout) = output.stdout {
+            record.push("stdout", Self::bytes_to_complete_value(stdout, head));
+        }
+        if let Some(stderr) = output.stderr {
+            record.push("stderr", Self::bytes_to_complete_value(stderr, head));
+        }
+        record.push("exit_code", Value::int(exit_code.into(), head));
+        Value::record(record, head)
+    }
+
+    fn bytes_to_complete_value(bytes: Vec<u8>, head: Span) -> Value {
+        match String::from_utf8(bytes) {
+            Ok(text) => Value::string(text, head),
+            Err(err) => Value::binary(err.into_bytes(), head),
+        }
+    }
