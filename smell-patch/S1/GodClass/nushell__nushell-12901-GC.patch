+    fn classify_overlay_value(value: &Value) -> &'static str {
+        match value {
+            Value::Bool { val, .. } => {
+                if *val {
+                    "bool-true"
+                } else {
+                    "bool-false"
+                }
+            }
+            Value::Int { val, .. } => {
+                if *val < 0 {
+                    "int-negative"
+                } else if *val == 0 {
+                    "int-zero"
+                } else {
+                    "int-positive"
+                }
+            }
+            Value::Float { val, .. } => {
+                if val.is_nan() {
+                    "float-nan"
+                } else if val.is_infinite() {
+                    "float-inf"
+                } else {
+                    "float"
+                }
+            }
+            Value::Filesize { val, .. } => {
+                if *val < 0 {
+                    "filesize-negative"
+                } else {
+                    "filesize"
+                }
+            }
+            Value::Duration { val, .. } => {
+                if *val < 0 {
+                    "duration-negative"
+                } else {
+                    "duration"
+                }
+            }
+            Value::Date { .. } => "date",
+            Value::Range { .. } => "range",
+            Value::String { val, .. } => {
+                if val.is_empty() {
+                    "string-empty"
+                } else {
+                    "string"
+                }
+            }
+            Value::Glob { no_expand, .. } => {
+                if *no_expand {
+                    "glob-raw"
+                } else {
+                    "glob"
+                }
+            }
+            Value::Record { val, .. } => {
+                if val.is_empty() {
+                    "record-empty"
+                } else {
+                    "record"
+                }
+            }
+            Value::List { vals, .. } => {
+                if vals.is_empty() {
+                    "list-empty"
+                } else {
+                    "list"
+                }
+            }
+            Value::Closure { .. } => "closure",
+            Value::Nothing { .. } => "nothing",
+            Value::Error { .. } => "error",
+            Value::Binary { val, .. } => {
+                if val.is_empty() {
+                    "binary-empty"
+                } else {
+                    "binary"
+                }
+            }
+            Value::CellPath { .. } => "cell-path",
+            Value::Custom { .. } => "custom",
+        }
+    }
