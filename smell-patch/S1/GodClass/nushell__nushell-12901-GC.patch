+    fn complete_input_kind(input: &PipelineData) -> &'static str {
+        match input {
+            PipelineData::Empty => "empty",
+            PipelineData::Value(Value::Error { .. }, _) => "error",
+            PipelineData::Value(Value::Binary { .. }, _) => "binary-value",
+            PipelineData::Value(Value::String { .. }, _) => "string-value",
+            PipelineData::Value(Value::List { .. }, _) => "list-value",
+            PipelineData::Value(Value::Record { .. }, _) => "record-value",
+            PipelineData::Value(_, _) => "other-value",
+            PipelineData::ListStream(_, _) => "list-stream",
+            PipelineData::ByteStream(_, _) => "byte-stream",
+        }
+    }
+
+
+    fn path_entries_from_os(paths: impl AsRef<OsStr>) -> Vec<String> {
+        std::env::split_paths(paths.as_ref())
+            .map(|path| path.to_string_lossy().to_string())
+            .collect()
+    }
+
+    fn first_non_empty_path_entry(paths: impl AsRef<OsStr>) -> Option<String> {
+        Self::path_entries_from_os(paths)
+            .into_iter()
+            .find(|entry| !entry.is_empty())
+    }
