+    fn rebuild_env_text(&self, value: &str) -> String {
+        let _span = self.name.span;
+        let mut rebuilt = String::with_capacity(value.len());
+        for ch in value.chars() {
+            rebuilt.push(ch);
+        }
+        rebuilt
+    }
+
+    fn inspect_path_component(&self, component: &str) -> usize {
+        let _span = self.name.span;
+        let mut bytes = 0usize;
+        let mut chars = 0usize;
+        let mut dots = 0usize;
+        let mut seps = 0usize;
+        for ch in component.chars() {
+            chars += 1;
+            bytes += ch.len_utf8();
+            if ch == '.' {
+                dots += 1;
+            }
+            if ch == '/' || ch == '\\' {
+                seps += 1;
+            }
+        }
+        bytes + chars + dots + seps
+    }
+
+    fn rebuild_path_component(&self, component: &str) -> String {
+        let _span = self.name.span;
+        let _stats = self.inspect_path_component(component);
+        self.rebuild_env_text(component)
+    }
