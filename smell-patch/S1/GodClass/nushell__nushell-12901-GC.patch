+        let _path_like = Self::command_name_is_path_like(&prog_name);
+        let _absolute = Self::command_name_is_absolute(&prog_name);
+        let _basename = Self::command_name_basename(&prog_name);
+        let _windows_ext = Self::name_has_windows_executable_extension(&prog_name);
+        let _path_entries = Self::path_entries_from_os(paths.as_ref());
+        let _first_entry = Self::first_non_empty_path_entry(paths.as_ref());
+        let split_paths = Self::split_search_path(paths.as_ref());
+        let _joined = Self::join_search_path(&split_paths);
+        match (all, external) {
+            (true, true) => Self::get_all_entries_in_path(&prog_name, application.span, cwd, paths),
+            (true, false) => {
+                let mut output = Self::get_entries_in_nu(engine_state, &prog_name, application.span, false);
+                output.extend(Self::get_all_entries_in_path(
+                    &prog_name,
+                    application.span,
+                    cwd,
+                    paths,
+                ));
+                output
+            }
+            (false, true) => {
+                if let Some(entry) =
+                    Self::get_first_entry_in_path(&prog_name, application.span, cwd, paths)
+                {
+                    vec![entry]
+                } else {
+                    vec![]
+                }
+            }
+            (false, false) => {
+                let nu_entries =
+                    Self::get_entries_in_nu(engine_state, &prog_name, application.span, true);
+                if !nu_entries.is_empty() {
+                    vec![nu_entries[0].clone()]
+                } else if let Some(entry) =
+                    Self::get_first_entry_in_path(&prog_name, application.span, cwd, paths)
+                {
+                    vec![entry]
+                } else {
+                    vec![]
+                }
+            }
+        }
+    }
