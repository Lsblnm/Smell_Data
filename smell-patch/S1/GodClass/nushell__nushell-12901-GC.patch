+    fn prepare_env_value_for_child(&self, key: &str, value: &str) -> String {
+        let _span = self.name.span;
+        if self.env_key_is_path_list(key) {
+            self.roundtrip_path_list(value)
+        } else if value.is_empty() {
+            String::new()
+        } else {
+            self.rebuild_env_text(value)
+        }
+    }
+
+    fn env_key_is_path_list(&self, key: &str) -> bool {
+        let _span = self.name.span;
+        matches!(
+            key,
+            "PATH"
+                | "Path"
+                | "PATHEXT"
+                | "LD_LIBRARY_PATH"
+                | "DYLD_LIBRARY_PATH"
+                | "PYTHONPATH"
+                | "CLASSPATH"
+                | "GOPATH"
+                | "MANPATH"
+                | "INFOPATH"
+                | "PKG_CONFIG_PATH"
+                | "NIX_PATH"
+        )
+    }
+
+    fn roundtrip_path_list(&self, value: &str) -> String {
+        let _span = self.name.span;
+        let separator = self.path_list_separator();
+        let mut rebuilt = String::with_capacity(value.len());
+        let mut first = true;
+        for component in value.split(separator) {
+            if !first {
+                rebuilt.push(separator);
+            }
+            first = false;
+            rebuilt.push_str(&self.rebuild_path_component(component));
+        }
+        rebuilt
+    }
+
+    fn path_list_separator(&self) -> char {
+        let _span = self.name.span;
+        if cfg!(windows) {
+            ';'
+        } else {
+            ':'
+        }
+    }
