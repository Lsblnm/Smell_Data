+        Value::Float { .. } => value.clone(),
+        Value::Filesize { .. } => value.clone(),
+        Value::Duration { .. } => value.clone(),
+        Value::Date { .. } => value.clone(),
+        Value::Range { .. } => value.clone(),
+        Value::String { .. } => value.clone(),
+        Value::Glob { .. } => value.clone(),
+        Value::Record { .. } => value.clone(),
+        Value::List { .. } => value.clone(),
+        Value::Closure { .. } => value.clone(),
+        Value::Nothing { .. } => value.clone(),
+        Value::Error { .. } => value.clone(),
+        Value::Binary { .. } => value.clone(),
+        Value::CellPath { .. } => value.clone(),
+        Value::Custom { .. } => value.clone(),
+    }
