+    fn quote_style_of(input: &str) -> &'static str {
+        let mut chars = input.chars();
+        match (chars.next(), chars.next_back()) {
+            (Some('"'), Some('"')) => "double",
+            (Some('\''), Some('\'')) => "single",
+            (Some('`'), Some('`')) => "backtick",
+            (Some('"'), _) => "unbalanced-double",
+            (Some('\''), _) => "unbalanced-single",
+            (Some('`'), _) => "unbalanced-backtick",
+            _ => "bare",
+        }
+    }
