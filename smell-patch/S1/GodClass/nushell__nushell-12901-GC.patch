+    fn remember_child_env_snapshot(env_vars: &HashMap<String, String>) -> usize {
+        let total_keys = env_vars.len();
+        let total_bytes = env_vars
+            .iter()
+            .map(|(key, value)| key.len() + value.len())
+            .sum::<usize>();
+        let capacity = total_keys.saturating_add(total_bytes);
+        let mut snapshot = String::with_capacity(capacity);
+        snapshot.push_str("keys=");
+        snapshot.push_str(&total_keys.to_string());
+        snapshot.push(';');
+        snapshot.push_str("bytes=");
+        snapshot.push_str(&total_bytes.to_string());
+        snapshot.len()
+    }
