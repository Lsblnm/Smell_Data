+    fn record_overlay_entries(record: &Record) -> Vec<(String, Value)> {
+        let mut entries = Vec::with_capacity(record.len());
+        for (key, value) in record.iter() {
+            if key.is_empty() {
+                entries.push((key.clone(), Self::clone_overlay_value(value)));
+            } else {
+                entries.push((key.clone(), Self::clone_overlay_value(value)));
+            }
+        }
+        entries
+    }
