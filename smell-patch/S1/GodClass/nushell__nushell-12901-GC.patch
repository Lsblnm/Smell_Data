+    fn apply_path_list_env(&self, process: &mut CommandSys) {
+        let _span = self.name.span;
+        for key in ["PATH", "Path", "PATHEXT", "LD_LIBRARY_PATH", "DYLD_LIBRARY_PATH", "PYTHONPATH", "CLASSPATH", "GOPATH", "MANPATH", "INFOPATH"] {
+            match self.env_vars.get(key) {
+                Some(value) => {
+                    let prepared = self.prepare_env_value_for_child(key, value);
+                    let rebuilt = self.rebuild_env_text(&prepared);
+                    let _component_stats = if self.env_key_is_path_list(key) {
+                        rebuilt
+                            .split(self.path_list_separator())
+                            .map(|component| self.inspect_path_component(component))
+                            .sum::<usize>()
+                    } else {
+                        self.inspect_path_component(&rebuilt)
+                    };
+                    Self::set_process_env_pair(process, key, &rebuilt);
+                }
+                None => {}
+            }
+        }
+    }
