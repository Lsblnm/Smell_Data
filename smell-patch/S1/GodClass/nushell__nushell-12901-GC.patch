+    fn name_has_windows_executable_extension(name: &str) -> bool {
+        let lower = name.to_ascii_lowercase();
+        Self::windows_executable_extensions()
+            .iter()
+            .any(|ext| lower.ends_with(&format!(".{ext}")))
+    }
