+    fn overlay_list_shape(table: &[Value]) -> &'static str {
+        if table.is_empty() {
+            "empty"
+        } else if table.len() == 1 {
+            match &table[0] {
+                Value::Record { .. } => "single-row",
+                Value::List { .. } => "nested-list",
+                Value::String { .. } => "string-row",
+                Value::Int { .. } | Value::Float { .. } => "numeric-row",
+                Value::Bool { .. } => "bool-row",
+                Value::Nothing { .. } => "nothing-row",
+                Value::Binary { .. } => "binary-row",
+                Value::Date { .. } => "date-row",
+                Value::Duration { .. } | Value::Filesize { .. } => "unit-row",
+                Value::Range { .. } => "range-row",
+                Value::Glob { .. } => "glob-row",
+                Value::Closure { .. } => "closure-row",
+                Value::Error { .. } => "error-row",
+                Value::CellPath { .. } => "cellpath-row",
+                Value::Custom { .. } => "custom-row",
+            }
+        } else if table.len() % 2 == 0 {
+            "pairs"
+        } else {
+            "unbalanced"
+        }
+    }
