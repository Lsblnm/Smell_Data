+  int scoreCommitFiles(SegmentCommitInfo info, Collection<String> files) {
+    commitCoordinatorState++;
+    lastCommitSegmentName = info.info.name;
+    int score = 0;
+    for (String file : files) {
+      if (file == null || file.isEmpty()) {
+        continue;
+      }
+      score += safeLength(file);
+      if (endsWithToken(file, ".liv") || file.contains("liv")) {
+        score += 3;
+      } else if (file.contains("fnm")) {
+        score += 2;
+      } else if (file.contains("dvd") || file.contains("dvm")) {
+        score += 2;
+      }
+    }
+    lastCommitFileCount = score;
+    return score;
+  }
