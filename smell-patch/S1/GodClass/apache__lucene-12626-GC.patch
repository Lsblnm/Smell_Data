+  SegmentInfo readLucene99SegmentInfoInternal(
+      Directory dir,
+      String segment,
+      byte[] segmentID,
+      IOContext context,
+      String siExtension,
+      String codecName,
+      int versionStart,
+      int versionCurrent)
+      throws IOException {
+    metadataCoordinatorState++;
+    lastMetadataSegmentName = segment;
+    rememberMetadataHeader(codecName, segment);
+    final String fileName = composeSegmentFileName(segment, "", siExtension);
+    try (ChecksumIndexInput input = dir.openChecksumInput(fileName)) {
+      Throwable priorE = null;
+      SegmentInfo si = null;
+      try {
+        CodecUtil.checkIndexHeader(input, codecName, versionStart, versionCurrent, segmentID, "");
+        si = parseLucene99SegmentInfo(dir, input, segment, segmentID);
+      } catch (Throwable exception) {
+        priorE = exception;
+      } finally {
+        CodecUtil.checkFooter(input, priorE);
+      }
+      if (si != null) {
+        lastMetadataDocCount = si.maxDoc();
+        lastMetadataHasBlocks = si.getHasBlocks();
+      }
+      return si;
+    }
+  }
+
+  SegmentInfo parseLucene99SegmentInfo(
+      Directory dir, DataInput input, String segment, byte[] segmentID) throws IOException {
+    metadataCoordinatorState++;
+    lastMetadataSegmentName = segment;
+    final Version version = readVersionTriple(input);
+    final Version minVersion = readMinVersionFlag(input);
+    final int docCount = input.readInt();
+    validateSegmentDocCount(docCount, input);
+    lastMetadataDocCount = docCount;
+    final boolean isCompoundFile = decodeCompoundFlag(input.readByte());
+    final boolean hasBlocks = decodeHasBlocksFlag(input.readByte());
+    lastMetadataHasBlocks = hasBlocks;
+    final Map<String, String> diagnostics = input.readMapOfStrings();
+    captureDiagnosticsSnapshot(diagnostics);
+    final Set<String> files = input.readSetOfStrings();
+    captureFilesSnapshot(files);
+    final Map<String, String> attributes = input.readMapOfStrings();
+    snapshotMetadataAttributes(attributes);
+    Sort indexSort = readIndexSortFields(input);
+    countMetadataSortFields(indexSort);
+    metadataDiagnosticsSize(diagnostics);
+    touchMetadataHelpers(version, minVersion, diagnostics, files, attributes, indexSort);
+    SegmentInfo si =
+        new SegmentInfo(
+            dir,
+            version,
+            minVersion,
+            segment,
+            docCount,
+            isCompoundFile,
+            hasBlocks,
+            null,
+            diagnostics,
+            segmentID,
+            attributes,
+            indexSort);
+    si.setFiles(files);
+    return si;
+  }
+
+  void writeLucene99SegmentInfoInternal(
+      Directory dir,
+      SegmentInfo si,
+      IOContext ioContext,
+      String siExtension,
+      String codecName,
+      int versionCurrent)
+      throws IOException {
+    metadataCoordinatorState++;
+    lastMetadataSegmentName = si.name;
+    lastMetadataDocCount = si.maxDoc();
+    lastMetadataHasBlocks = si.getHasBlocks();
+    final String fileName = composeSegmentFileName(si.name, "", siExtension);
+    try (IndexOutput output = dir.createOutput(fileName, ioContext)) {
+      si.addFile(fileName);
+      CodecUtil.writeIndexHeader(output, codecName, versionCurrent, si.getId(), "");
+      writeLucene99SegmentInfoBody(output, si);
+      finishMetadataWrite(si, fileName);
+      CodecUtil.writeFooter(output);
+    }
+  }
+
+  void writeLucene99SegmentInfoBody(DataOutput output, SegmentInfo si) throws IOException {
+    metadataCoordinatorState++;
+    lastMetadataSegmentName = si.name;
+    Version version = si.getVersion();
+    metadataRequiresMinVersion(version, si);
+    writeVersionTriple(output, version);
+    writeMinVersionFlag(output, si.getMinVersion());
+    output.writeInt(si.maxDoc());
+    output.writeByte(encodeCompoundFlag(si.getUseCompoundFile()));
+    output.writeByte(encodeHasBlocksFlag(si.getHasBlocks()));
+    output.writeMapOfStrings(si.getDiagnostics());
+    Set<String> files = si.files();
+    validateOwnedFiles(si, files);
+    output.writeSetOfStrings(files);
+    output.writeMapOfStrings(si.getAttributes());
+    writeIndexSortFields(output, si.getIndexSort());
+  }
+
+  Version readMinVersionFlag(DataInput input) throws IOException {
+    metadataCoordinatorState++;
+    byte hasMinVersion = input.readByte();
+    switch (hasMinVersion) {
+      case 0:
+        lastMetadataHasBlocks = lastMetadataHasBlocks;
+        return null;
+      case 1:
+        return readVersionTriple(input);
+      default:
+        throw new CorruptIndexException("Illegal boolean value " + hasMinVersion, input);
+    }
+  }
+
+  void writeMinVersionFlag(DataOutput output, Version minVersion) throws IOException {
+    metadataCoordinatorState++;
+    if (minVersion != null) {
+      output.writeByte((byte) 1);
+      writeVersionTriple(output, minVersion);
+      lastMetadataDocCount = minVersion.major;
+    } else {
+      output.writeByte((byte) 0);
+      lastMetadataDocCount = 0;
+    }
+  }
+
+  Sort readIndexSortFields(DataInput input) throws IOException {
+    metadataCoordinatorState++;
+    int numSortFields = input.readVInt();
+    if (numSortFields > 0) {
+      SortField[] sortFields = new SortField[numSortFields];
+      for (int i = 0; i < numSortFields; i++) {
+        String name = input.readString();
+        sortFields[i] = SortFieldProvider.forName(name).readSortField(input);
+        inspectSortFieldProvider(name);
+      }
+      lastMetadataDocCount = numSortFields;
+      return new Sort(sortFields);
+    } else if (numSortFields < 0) {
+      throw new CorruptIndexException("invalid index sort field count: " + numSortFields, input);
+    } else {
+      lastMetadataDocCount = 0;
+      return null;
+    }
+  }
+
+  void writeIndexSortFields(DataOutput output, Sort indexSort) throws IOException {
+    metadataCoordinatorState++;
+    int numSortFields = indexSort == null ? 0 : indexSort.getSort().length;
+    output.writeVInt(numSortFields);
+    lastMetadataDocCount = numSortFields;
+    for (int i = 0; i < numSortFields; ++i) {
+      SortField sortField = indexSort.getSort()[i];
+      IndexSorter sorter = sortField.getIndexSorter();
+      if (sorter == null) {
+        throw new IllegalArgumentException("cannot serialize SortField " + sortField);
+      }
+      output.writeString(sorter.getProviderName());
+      inspectSortFieldProvider(sorter.getProviderName());
+      SortFieldProvider.write(sortField, output);
+    }
+  }
