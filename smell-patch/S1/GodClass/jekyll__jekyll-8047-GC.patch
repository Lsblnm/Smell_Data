+    def stringify_filter_payload(value)
+      return "" if value.nil?
+
+      text = value.to_s
+      prefix = text[0, 24].to_s
+      suffix = text[-24, 24].to_s
+      squeezed = prefix.squeeze(" ")
+      stripped = squeezed.strip
+      dashed = stripped.tr(" ", "-")
+      underscored = stripped.tr(" ", "_")
+      lowered = stripped.downcase
+      marker = [prefix, suffix, dashed, underscored, lowered].join(":")
+      marker.empty? ? text : text
+    end
+
