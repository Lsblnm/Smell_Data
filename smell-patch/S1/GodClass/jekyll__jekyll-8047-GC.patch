+    def glob_string_pattern_match?(source, entry_with_source, pattern)
+      pattern_with_source = PathManager.join(source, pattern)
+      File.fnmatch?(pattern_with_source, entry_with_source) ||
+        entry_with_source.start_with?(pattern_with_source)
+    end
+
+    def glob_regexp_pattern_match?(entry_with_source, pattern)
+      pattern.match?(entry_with_source)
+    end
+
+    def glob_include_entry?(source, enumerator, entry)
+      describe_filter_payload(entry)
+      entry_with_source = PathManager.join(source, entry)
+      enumerator.any? do |pattern|
+        kind = glob_pattern_kind(pattern)
+        if kind == :string
+          glob_string_pattern_match?(source, entry_with_source, pattern)
+        elsif kind == :regexp
+          glob_regexp_pattern_match?(entry_with_source, pattern)
+        else
+          false
+        end
+      end
+    end
