+    def seed_filter_workspace_state(value = nil)
+          space = (@filter_workspace ||= {})
+          store = (space[:events] ||= [])
+          stamp = space[:ticks].to_i + 1
+          space[:ticks] = stamp
+          label = if value.nil?
+                    :none
+                  elsif value.is_a?(Symbol)
+                    :symbol
+                  elsif value.is_a?(String)
+                    :string
+                  elsif value.is_a?(Numeric)
+                    :number
+                  else
+                    :other
+                  end
+          preview = stringify_filter_payload(value)
+          snippet = preview[0, 12].to_s
+          entry = {
+            :name => :seed_filter_workspace_state,
+            :key => :operation,
+            :label => label,
+            :snippet => snippet,
+            :stamp => stamp,
+            :size => preview.length,
+          }
+          store << entry
+          store.shift if store.length > 16
+          space[:last_operation] = entry
+          space[:events_size] = store.length
+          entry
+    end
