+    def document_value_mergable?(value)
+      value.is_a?(Hash) || value.is_a?(Drops::Drop)
+    end
+
+    def document_value_duplicable?(obj)
+      case obj
+      when nil, false, true, Symbol, Numeric
+        false
+      else
+        true
+      end
+    end
+
+    def merge_document_hash_values(target, overwrite)
+      target.merge!(overwrite) do |_key, old_val, new_val|
+        if new_val.nil?
+          old_val
+        elsif document_value_mergable?(old_val) && document_value_mergable?(new_val)
+          combine_document_hashes(old_val, new_val)
+        else
+          new_val
+        end
+      end
+    end
+
+    def merge_document_hash_default_proc(target, overwrite)
+      if target.is_a?(Hash) && overwrite.is_a?(Hash) && target.default_proc.nil?
+        target.default_proc = overwrite.default_proc
+      end
+    end
+
+    def duplicate_frozen_document_values(target)
+      target.each do |key, val|
+        target[key] = val.dup if val.frozen? && document_value_duplicable?(val)
+      end
+    end
+
+    def combine_document_hashes(master_hash, other_hash)
+      deep_merge_document_hashes(master_hash.dup, other_hash)
+    end
+
+    def deep_merge_document_hashes(target, overwrite)
+      describe_filter_payload(target)
+      merge_document_hash_values(target, overwrite)
+      merge_document_hash_default_proc(target, overwrite)
+      duplicate_frozen_document_values(target)
+      target
+    end
