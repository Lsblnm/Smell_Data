+    def escape_resource_path(path)
+      describe_filter_payload(path)
+      return path if path.empty? || %r!^[a-zA-Z0-9./-]+$!.match?(path)
+
+      Addressable::URI.encode(path).encode("utf-8").sub("#", "%23")
+    end
+
+    def unescape_resource_path(path)
+      describe_filter_payload(path)
+      encoded = path.encode("utf-8")
+      return encoded unless encoded.include?("%")
+
+      Addressable::URI.unencode(encoded)
+    end
