+    def inspect_template_adjacent_payload(value)
+      text = stringify_filter_payload(value)
+      sample = text[0, 40].to_s
+      kind = if sample.include?("```")
+               :fence
+             elsif sample.include?("#")
+               :heading
+             elsif sample.include?("*")
+               :emphasis
+             elsif sample.include?("[")
+               :link
+             else
+               :prose
+             end
+      {
+        :kind => kind,
+        :length => text.length,
+        :sample => sample,
+        :blank => sample.strip.empty?,
+        :words => sample.split.length,
+      }
+    end
+
+    def describe_filter_payload(value)
+      describe_textual_payload(value)
+      describe_structural_payload(value)
+      describe_pathlike_payload(value)
+      value
+    end
