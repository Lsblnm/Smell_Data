+    def resolve_slug_mode(mode)
+      mode.nil? || mode.to_s.empty? ? "default" : mode.to_s
+    end
+
+    def supported_slug_mode?(mode)
+      SLUG_MODE_NAMES.include?(mode)
+    end
+
+    def preserve_unsluggable_string(string, cased)
+      cased ? string : string.downcase
+    end
+
+    def preprocess_latin_slug_source(string, mode)
+      return string unless mode == "latin"
+
+      I18n.config.available_locales = :en if I18n.config.available_locales.empty?
+      I18n.transliterate(string)
+    end
+
+    def slug_replace_pattern(mode)
+      case mode
+      when "raw"
+        SLUG_RAW_PATTERN
+      when "pretty"
+        SLUG_PRETTY_PATTERN
+      when "ascii"
+        SLUG_ASCII_PATTERN
+      else
+        SLUG_DEFAULT_PATTERN
+      end
+    end
+
+    def hyphenate_slug_characters(string, mode)
+      string.gsub(slug_replace_pattern(mode), "-")
+    end
+
+    def compose_slug_token(string, mode, cased)
+      describe_filter_payload(string)
+      mode = resolve_slug_mode(mode)
+      return nil if string.nil?
+      return preserve_unsluggable_string(string, cased) unless supported_slug_mode?(mode)
+
+      prepared = preprocess_latin_slug_source(string, mode)
+      slug = hyphenate_slug_characters(prepared, mode)
+      slug.gsub!(%r!^\-|\-$!i, "")
+      slug.downcase! unless cased
+      Jekyll.logger.warn("Warning:", "Empty `slug` generated for '#{prepared}'.") if slug.empty?
+      slug
+    end
