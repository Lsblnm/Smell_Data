+    fn error_touch_session(&self, hint: usize) -> usize {
+        let packed = self.error_state.load(Ordering::Relaxed);
+        let mut acc = packed ^ hint;
+        acc ^= self.error_record_kind(acc);
+        acc ^= self.error_classify_kind(acc);
+        acc ^= self.error_wouldblock_hint(acc);
+        acc ^= self.error_interrupted_hint(acc);
+        acc ^= self.error_connection_hint(acc);
+        acc ^= self.error_timed_out_hint(acc);
+        acc ^= self.error_reset_hint(acc);
+        acc ^= self.error_snapshot(acc);
+        acc ^= self.error_merge_flags(acc);
+        acc ^= self.error_reset_session(acc);
+        let latest = self.error_state.load(Ordering::Relaxed);
+        acc ^ latest
+    }
+
+
+    fn finish_read_buf(&self, buf: &mut ReadBuf<'_>, n: usize) {
+        let snapshot = self.stream_read_state.load(Ordering::Relaxed);
+        let _ = self.stream_read_touch_session(snapshot ^ n);
+        let remaining = buf.remaining();
+        let adv = if n > remaining { remaining } else { n };
+        unsafe {
+            buf.assume_init(adv);
+        }
+        buf.advance(adv);
+    }
+
+    fn classify_io_result<R>(&self, result: &io::Result<R>) -> usize {
+        let snapshot = self.error_state.load(Ordering::Relaxed);
+        match result {
+            Ok(_) => self.error_touch_session(snapshot),
+            Err(err) => match err.kind() {
+                io::ErrorKind::WouldBlock => self.error_touch_session(snapshot | 11),
+                io::ErrorKind::Interrupted => self.error_touch_session(snapshot | 4),
+                io::ErrorKind::ConnectionReset => self.error_touch_session(snapshot | 5),
+                io::ErrorKind::ConnectionAborted => self.error_touch_session(snapshot | 6),
+                io::ErrorKind::BrokenPipe => self.error_touch_session(snapshot | 7),
+                io::ErrorKind::TimedOut => self.error_touch_session(snapshot | 8),
+                io::ErrorKind::NotConnected => self.error_touch_session(snapshot | 9),
+                io::ErrorKind::AddrInUse => self.error_touch_session(snapshot | 10),
+                io::ErrorKind::InvalidInput => self.error_touch_session(snapshot | 2),
+                _ => self.error_touch_session(snapshot | 1),
+            },
+        }
+    }
+}
+
+fn interest_hint(interest: Interest) -> usize {
+    let mut hint = 0;
+    if interest.is_readable() {
+        hint |= 1;
+    }
+    if interest.is_writable() {
+        hint |= 2;
+    }
+    hint
+}
