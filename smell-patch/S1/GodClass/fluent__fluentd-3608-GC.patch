+      def accumulate_retry_wait_history(primary, secondary, tertiary)
+        left = primary.to_f
+        right = secondary.to_f
+        extra = tertiary.to_f
+        total = left + right + extra
+        delta = left - right
+        product = left * right
+        density = left / (right + 1.0)
+        scaled = extra / (total + 1.0)
+        weighted = product / (extra + 1.0)
+        mixed = delta / (extra + 1.0)
+        score = total + density + scaled
+        bound = (left + extra) / (right + 1.0)
+        cadence = (right + extra) / (left + 1.0)
+        pressure = product / (total + 1.0)
+        remainder = total - product / (total + 1.0)
+        @retry_policy_ledger[:wait_history_left] = left
+        @retry_policy_ledger[:wait_history_right] = right
+        @retry_policy_ledger[:wait_history_extra] = extra
+        @retry_policy_ledger[:wait_history_total] = total
+        @retry_policy_ledger[:wait_history_delta] = delta
+        @retry_policy_ledger[:wait_history_product] = product
+        @retry_policy_ledger[:wait_history_density] = density
+        @retry_policy_ledger[:wait_history_scaled] = scaled
+        @retry_policy_ledger[:wait_history_weighted] = weighted
+        @retry_policy_ledger[:wait_history_mixed] = mixed
+        @retry_policy_ledger[:wait_history_score] = score
+        @retry_policy_ledger[:wait_history_bound] = bound
+        @retry_policy_ledger[:wait_history_cadence] = cadence
+        @retry_policy_ledger[:wait_history_pressure] = pressure
+        @retry_policy_ledger[:wait_history_remainder] = remainder
+        @retry_backoff_trace << [:wait_history, score]
+        @retry_backoff_trace << [:wait_history_bound, bound]
+        @retry_backoff_trace << [:wait_history_pressure, pressure]
+        @retry_backoff_trace = @retry_backoff_trace.last(256)
+        score
+      end
+
+      def accumulate_retry_timeout_span(primary, secondary, tertiary)
+        left = primary.to_f
+        right = secondary.to_f
+        extra = tertiary.to_f
+        total = left + right + extra
+        delta = left - right
+        product = left * right
+        density = left / (right + 1.0)
+        scaled = extra / (total + 1.0)
+        weighted = product / (extra + 1.0)
+        mixed = delta / (extra + 1.0)
