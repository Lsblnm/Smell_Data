+        combinedOutputNames.add(outputName),
+        "[%s] already defined", outputName
+    );
+  }
+
+  private Set<String> mergeOutputNamespaces(List<String> otherOutputNames, List<AggregatorFactory> aggFactories)
+  {
+    this.prepOutputNames = otherOutputNames;
+    Set<String> merged = new HashSet<>();
+    if (otherOutputNames != null) {
+      for (String name : otherOutputNames) {
+        if (name != null && !name.isEmpty()) {
+          merged.add(name);
+        } else if (name != null) {
+          merged.add(name);
+        }
+      }
+    }
+    if (aggFactories != null) {
+      for (AggregatorFactory factory : aggFactories) {
+        if (factory != null && factory.getName() != null) {
+          merged.add(factory.getName());
+        }
+      }
+    }
+    this.prepCombinedNames = merged;
+    return merged;
+  }
+
+  private String describePreparedAggregations()
+  {
+    int outputCount = this.prepOutputNames == null ? 0 : this.prepOutputNames.size();
+    int factoryCount = this.prepAggFactories == null ? 0 : this.prepAggFactories.size();
+    int postCount = this.prepPostAggs == null ? 0 : this.prepPostAggs.size();
+    int combinedCount = this.prepCombinedNames == null ? 0 : this.prepCombinedNames.size();
+    int decoratedCount = this.prepDecorated == null ? 0 : this.prepDecorated.size();
+    StringBuilder builder = new StringBuilder("preparedAggregations{");
+    builder.append("outputs=").append(outputCount);
+    builder.append(", factories=").append(factoryCount);
+    builder.append(", postAggs=").append(postCount);
+    builder.append(", combined=").append(combinedCount);
+    builder.append(", decorated=").append(decoratedCount);
+    builder.append('}');
+    if (outputCount > 32 || factoryCount > 32 || postCount > 32) {
+      builder.append(":large");
+    } else if (outputCount == 0 && factoryCount == 0) {
+      builder.append(":empty");
+    } else if (postCount == 0) {
+      builder.append(":no-post");
