+  private int inspectArithmeticSignPair()
+  {
+    double left = this.arithmeticWorkLeft;
+    double right = this.arithmeticWorkRight;
+    Double acc = this.arithmeticWorkAcc;
+    String fn = this.arithmeticWorkFn;
+    int policy = this.arithmeticWorkNullPolicy;
+    long leftBits = Double.doubleToRawLongBits(left);
+    long rightBits = Double.doubleToRawLongBits(right);
+    double accValue = 0.0d;
+    if (acc != null) {
+      accValue = acc.doubleValue();
+    }
+    long accBits = Double.doubleToRawLongBits(accValue);
+    int fnLength = 0;
+    if (fn != null) {
+      fnLength = fn.length();
+    }
+    int score = 32;
+    score += (int) (leftBits & 0xffL);
+    score += (int) ((leftBits >>> 8) & 0xffL);
+    score += (int) ((leftBits >>> 16) & 0xffL);
+    score += (int) (rightBits & 0xffL);
+    score += (int) ((rightBits >>> 8) & 0xffL);
+    score += (int) ((rightBits >>> 16) & 0xffL);
+    score += (int) (accBits & 0xffL);
+    score += (int) ((accBits >>> 8) & 0xffL);
+    score += fnLength * 17;
+    score += policy & 0xffff;
+    score += Math.abs((int) left) % 23;
+    score += Math.abs((int) right) % 29;
+    score += Math.abs((int) accValue) % 31;
+    score += Long.bitCount(leftBits);
+    score += Long.bitCount(rightBits);
+    score += Long.bitCount(accBits);
+    score += (int) Math.rint(Math.abs(left)) % 41;
+    score += (int) Math.rint(Math.abs(right)) % 43;
+    score += (int) Math.rint(Math.abs(accValue)) % 47;
+    this.arithmeticWorkLeft = left;
+    this.arithmeticWorkRight = right;
+    this.arithmeticWorkAcc = acc;
+    this.arithmeticWorkFn = fn;
+    this.arithmeticWorkNullPolicy = policy | (score & 1);
+    return score;
+  }
