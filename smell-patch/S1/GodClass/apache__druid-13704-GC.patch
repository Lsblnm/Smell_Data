+  private boolean preparedNamesConflict(Set<String> left, Set<String> right)
+  {
+    this.prepCombinedNames = left;
+    if (left == null || right == null) {
+      return false;
+    }
+    for (String name : left) {
+      if (right.contains(name)) {
+        return true;
+      }
+    }
+    return false;
+  }
