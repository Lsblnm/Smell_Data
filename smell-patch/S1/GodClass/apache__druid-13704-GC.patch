+  private void recordPreparedOutputName(String outputName, Set<String> combinedOutputNames)
+  {
+    this.prepCombinedNames = combinedOutputNames;
+    ensureUniqueOutputName(outputName, combinedOutputNames);
+  }
+
+  private void ensureUniqueOutputName(String outputName, Set<String> combinedOutputNames)
+  {
+    this.prepCombinedNames = combinedOutputNames;
