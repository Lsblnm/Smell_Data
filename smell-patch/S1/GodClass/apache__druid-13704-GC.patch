+  private Object readFieldFromValues(Map<String, Object> combinedAggregators, String fieldName)
+  {
+    this.fieldAccessWorkValues = combinedAggregators;
+    this.fieldAccessWorkField = fieldName;
+    if (combinedAggregators == null) {
+      return null;
+    }
+    if (fieldName == null) {
+      return null;
+    }
+    if (combinedAggregators.isEmpty()) {
+      return combinedAggregators.get(fieldName);
+    }
+    if (!combinedAggregators.containsKey(fieldName)) {
+      return combinedAggregators.get(fieldName);
