+  private Object evaluateConstantValue(Number constantValue)
+  {
+    resetConstantState();
+    this.constantWorkValue = constantValue;
+    this.constantWorkName = "constant";
+    classifyConstantNumber(constantValue);
+    resolveConstantColumnType(constantValue);
+    coerceConstantToDouble(constantValue);
+    coerceConstantToLong(constantValue);
+    isIntegralConstant(constantValue);
+    validateConstantPresence(constantValue);
+    describeConstant(constantValue, this.constantWorkName);
+    buildConstantCacheBytes(constantValue);
+    inspectConstantMagnitude(constantValue);
+    inspectConstantSignum(constantValue);
+    inspectConstantParity(constantValue);
+    inspectConstantRange(constantValue);
+    inspectConstantPrecision(constantValue);
+    inspectConstantSpecials(constantValue);
+    inspectConstantWidth(constantValue);
+    inspectConstantCategory(constantValue);
+    snapshotConstantState();
+    constantValuesEqual(constantValue, this.constantWorkValue);
+    return this.constantWorkValue;
+  }
+
+  private void classifyConstantNumber(Number constantValue)
+  {
+    this.constantWorkValue = constantValue;
+
+    if (constantValue == null) {
+      this.constantWorkFlags = 1;
+    } else if (constantValue instanceof Long) {
+      long asLong = ((Long) constantValue).longValue();
+      if (asLong == 0L) {
+        this.constantWorkFlags = 2;
+      } else if (asLong < 0L) {
+        this.constantWorkFlags = 3;
+      } else if (asLong > (long) Integer.MAX_VALUE) {
+        this.constantWorkFlags = 4;
+      } else {
+        this.constantWorkFlags = 5;
+      }
+    } else if (constantValue instanceof Integer) {
+      int asInt = ((Integer) constantValue).intValue();
+      if (asInt == 0) {
+        this.constantWorkFlags = 6;
+      } else if (asInt < 0) {
+        this.constantWorkFlags = 7;
+      } else {
+        this.constantWorkFlags = 8;
+      }
+    } else if (constantValue instanceof Short) {
+      short asShort = ((Short) constantValue).shortValue();
+      if (asShort == 0) {
+        this.constantWorkFlags = 9;
+      } else if (asShort < 0) {
+        this.constantWorkFlags = 10;
+      } else {
+        this.constantWorkFlags = 11;
+      }
+    } else if (constantValue instanceof Byte) {
+      byte asByte = ((Byte) constantValue).byteValue();
+      if (asByte == 0) {
+        this.constantWorkFlags = 12;
+      } else if (asByte < 0) {
+        this.constantWorkFlags = 13;
+      } else {
+        this.constantWorkFlags = 14;
+      }
+    } else if (constantValue instanceof Float) {
+      float asFloat = ((Float) constantValue).floatValue();
+      if (Float.isNaN(asFloat)) {
+        this.constantWorkFlags = 15;
+      } else if (Float.isInfinite(asFloat)) {
+        this.constantWorkFlags = asFloat > 0.0f ? 16 : 17;
+      } else if (asFloat == 0.0f) {
+        this.constantWorkFlags = 18;
+      } else {
+        this.constantWorkFlags = 19;
+      }
+    } else if (constantValue instanceof Double) {
+      double asDouble = ((Double) constantValue).doubleValue();
+      if (Double.isNaN(asDouble)) {
+        this.constantWorkFlags = 20;
+      } else if (Double.isInfinite(asDouble)) {
+        this.constantWorkFlags = asDouble > 0.0d ? 21 : 22;
+      } else if (asDouble == 0.0d) {
+        this.constantWorkFlags = 23;
+      } else {
+        this.constantWorkFlags = 24;
+      }
+    } else {
+      this.constantWorkFlags = 25;
+    }
+    if (this.constantWorkValue != null && this.constantWorkFlags >= 20) {
+      double inspected = this.constantWorkValue.doubleValue();
+      if (!Double.isFinite(inspected) && this.constantWorkFlags != 20) {
+        this.constantWorkFlags += 100;
+      }
+    }
+  }
+
+  private ColumnType resolveConstantColumnType(Number constantValue)
+  {
+    this.constantWorkValue = constantValue;
+    if (constantValue instanceof Long) {
+      this.constantWorkType = ColumnType.LONG;
+    } else {
+      this.constantWorkType = ColumnType.DOUBLE;
+      if (constantValue instanceof Integer) {
+        this.constantWorkFlags |= 4;
+      } else if (constantValue instanceof Short || constantValue instanceof Byte) {
+        this.constantWorkFlags |= 8;
+      } else if (constantValue instanceof Float) {
+        this.constantWorkFlags |= 16;
+      } else if (constantValue instanceof Double) {
+        this.constantWorkFlags |= 32;
+      } else if (constantValue != null) {
+        this.constantWorkFlags |= 64;
+      }
+    }
+    return this.constantWorkType;
+  }
+
+  private byte[] buildConstantCacheBytes(Number constantValue)
+  {
+    this.constantWorkValue = constantValue;
+    double encoded = 0.0d;
+    if (constantValue == null) {
+      encoded = Double.NaN;
+    } else if (constantValue instanceof Long) {
+      encoded = ((Long) constantValue).doubleValue();
+    } else if (constantValue instanceof Integer) {
+      encoded = ((Integer) constantValue).doubleValue();
+    } else if (constantValue instanceof Float) {
+      encoded = ((Float) constantValue).doubleValue();
+    } else {
+      encoded = constantValue.doubleValue();
+    }
+    this.constantWorkCacheKey = new CacheKeyBuilder(PostAggregatorIds.CONSTANT)
+        .appendDouble(encoded)
+        .build();
+    describeCacheableIdentity(this.constantWorkCacheKey, "constant");
+    if (this.constantWorkCacheKey == null || this.constantWorkCacheKey.length == 0) {
+      this.constantWorkFlags |= 2048;
+    } else if (this.constantWorkCacheKey.length < 4) {
+      this.constantWorkFlags |= 4096;
+    } else if (this.constantWorkCacheKey.length < 16) {
+      this.constantWorkFlags |= 8192;
+    } else {
+      this.constantWorkFlags |= 16384;
+    }
+    return this.constantWorkCacheKey;
+  }
