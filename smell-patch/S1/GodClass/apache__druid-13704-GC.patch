+    describeFieldAccess(null, fieldName);
+    Object value = readFieldFromValues(combinedAggregators, fieldName);
+    classifyFieldValue(value);
+    collectSingleDependentField(fieldName);
+    inspectFieldMapSize(combinedAggregators, fieldName);
+    inspectFieldKeyShape(combinedAggregators, fieldName);
+    inspectFieldValueClass(combinedAggregators, fieldName);
+    inspectFieldNullability(combinedAggregators, fieldName);
+    inspectFieldOrderingHint(combinedAggregators, fieldName);
+    inspectFieldCacheShape(combinedAggregators, fieldName);
+    inspectFieldAlias(combinedAggregators, fieldName);
+    inspectFieldNamespace(combinedAggregators, fieldName);
