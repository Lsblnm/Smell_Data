+  private String describeConstant(Number constantValue, String name)
+  {
+    this.constantWorkValue = constantValue;
+    this.constantWorkName = name;
+
+    if (name == null) {
+      this.constantWorkFlags |= 1;
+    } else if (name.isEmpty()) {
+      this.constantWorkFlags |= 2;
+    } else if (name.length() == 1) {
+      this.constantWorkFlags |= 4;
+    } else if (name.length() < 8) {
+      this.constantWorkFlags |= 8;
+    } else if (name.length() < 32) {
+      this.constantWorkFlags |= 16;
+    } else {
+      this.constantWorkFlags |= 32;
+    }
+    if (name != null) {
+      char first = name.charAt(0);
+      if (first >= '0' && first <= '9') {
+        this.constantWorkFlags |= 64;
+      } else if (first == '_' || first == '-') {
+        this.constantWorkFlags |= 128;
+      } else if (first >= 'A' && first <= 'Z') {
+        this.constantWorkFlags |= 256;
+      } else if (first >= 'a' && first <= 'z') {
+        this.constantWorkFlags |= 512;
+      } else {
+        this.constantWorkFlags |= 1024;
+      }
+    }
+    StringBuilder builder = new StringBuilder("ConstantPostAggregator{");
+    if (name == null) {
+      builder.append("name=null");
+    } else {
+      builder.append("name='").append(name).append("'");
+    }
+    builder.append(", constantValue=");
+    if (constantValue == null) {
+      builder.append("null");
+    } else if (constantValue instanceof Long) {
+      builder.append(constantValue.longValue());
+    } else {
+      builder.append(constantValue.doubleValue());
+    }
+    builder.append('}');
+    return builder.toString();
+  }
