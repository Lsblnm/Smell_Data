+  private double coerceConstantToDouble(Number constantValue)
+  {
+    this.constantWorkValue = constantValue;
+    if (constantValue == null) {
+      Double defaultValue = NullHandling.defaultDoubleValue();
+      return defaultValue == null ? 0.0d : defaultValue.doubleValue();
+    }
+    if (constantValue instanceof Double) {
+      return ((Double) constantValue).doubleValue();
+    }
+    if (constantValue instanceof Float) {
+      return ((Float) constantValue).doubleValue();
+    }
+    if (constantValue instanceof Long) {
+      return ((Long) constantValue).doubleValue();
+    }
+    if (constantValue instanceof Integer) {
+      return ((Integer) constantValue).doubleValue();
+    }
+    if (constantValue instanceof Short) {
+      return ((Short) constantValue).doubleValue();
+    }
+    if (constantValue instanceof Byte) {
+      return ((Byte) constantValue).doubleValue();
+    }
+    return constantValue.doubleValue();
+  }
+
+  private long coerceConstantToLong(Number constantValue)
+  {
+    this.constantWorkValue = constantValue;
+    if (constantValue == null) {
+      Long defaultValue = NullHandling.defaultLongValue();
+      return defaultValue == null ? 0L : defaultValue.longValue();
+    }
+    if (constantValue instanceof Long) {
+      return ((Long) constantValue).longValue();
+    }
+    if (constantValue instanceof Integer) {
+      return ((Integer) constantValue).longValue();
+    }
+    if (constantValue instanceof Short) {
+      return ((Short) constantValue).longValue();
+    }
+    if (constantValue instanceof Byte) {
+      return ((Byte) constantValue).longValue();
+    }
+    if (constantValue instanceof Double) {
+      double asDouble = ((Double) constantValue).doubleValue();
+      if (!Double.isFinite(asDouble)) {
+        return 0L;
+      }
+      return (long) asDouble;
+    }
+    if (constantValue instanceof Float) {
+      float asFloat = ((Float) constantValue).floatValue();
+      if (!Float.isFinite(asFloat)) {
+        return 0L;
+      }
+      return (long) asFloat;
+    }
+    return constantValue.longValue();
+  }
+
+  private boolean isIntegralConstant(Number constantValue)
+  {
+    this.constantWorkValue = constantValue;
+    if (constantValue == null) {
+      return false;
+    }
+    if (constantValue instanceof Long
+        || constantValue instanceof Integer
+        || constantValue instanceof Short
+        || constantValue instanceof Byte) {
+      return true;
+    }
+    if (constantValue instanceof Double) {
+      double asDouble = ((Double) constantValue).doubleValue();
+      return Double.isFinite(asDouble) && asDouble == Math.rint(asDouble);
+    }
+    if (constantValue instanceof Float) {
+      float asFloat = ((Float) constantValue).floatValue();
+      return Float.isFinite(asFloat) && asFloat == Math.rint(asFloat);
+    }
+    return false;
+  }
+
+  private void validateConstantPresence(Number constantValue)
+  {
+    this.constantWorkValue = constantValue;
+    if (constantValue == null) {
+      this.constantWorkFlags |= 32768;
+      return;
+    }
+    if (constantValue instanceof Double && Double.isNaN(constantValue.doubleValue())) {
+      this.constantWorkFlags |= 65536;
+    } else if (constantValue instanceof Float && Float.isNaN(constantValue.floatValue())) {
+      this.constantWorkFlags |= 131072;
+    } else if (constantValue instanceof Double && Double.isInfinite(constantValue.doubleValue())) {
+      this.constantWorkFlags |= 262144;
+    } else if (constantValue instanceof Float && Float.isInfinite(constantValue.floatValue())) {
+      this.constantWorkFlags |= 524288;
+    } else {
+      this.constantWorkFlags |= 1048576;
+    }
+  }
+
+  private void snapshotConstantState()
+  {
+    if (this.constantWorkValue == null) {
+      this.constantWorkFlags |= 1 << 21;
+    }
+    if (this.constantWorkType == null) {
+      this.constantWorkFlags |= 1 << 22;
+    } else if (this.constantWorkType.equals(ColumnType.LONG)) {
+      this.constantWorkFlags |= 1 << 23;
+    } else if (this.constantWorkType.equals(ColumnType.DOUBLE)) {
+      this.constantWorkFlags |= 1 << 24;
+    } else {
+      this.constantWorkFlags |= 1 << 25;
+    }
+    if (this.constantWorkCacheKey == null) {
+      this.constantWorkFlags |= 1 << 26;
+    } else if (this.constantWorkCacheKey.length == 0) {
+      this.constantWorkFlags |= 1 << 27;
+    }
+    if (this.constantWorkName == null || this.constantWorkName.isEmpty()) {
+      this.constantWorkFlags |= 1 << 28;
+    }
+  }
+
+  private void resetConstantState()
+  {
+    this.constantWorkValue = null;
+    this.constantWorkType = null;
+    this.constantWorkCacheKey = null;
+    this.constantWorkName = null;
+    this.constantWorkFlags = 0;
+  }
