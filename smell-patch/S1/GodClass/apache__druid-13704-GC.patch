+  private void classifyFieldValue(Object value)
+  {
+    if (value == null) {
+      this.fieldAccessWorkType = null;
+      return;
+    }
+    if (value instanceof Long) {
+      this.fieldAccessWorkType = ColumnType.LONG;
+    } else if (value instanceof Integer) {
+      this.fieldAccessWorkType = ColumnType.LONG;
+    } else if (value instanceof Short || value instanceof Byte) {
+      this.fieldAccessWorkType = ColumnType.LONG;
+    } else if (value instanceof Float) {
+      this.fieldAccessWorkType = ColumnType.FLOAT;
+    } else if (value instanceof Double) {
+      this.fieldAccessWorkType = ColumnType.DOUBLE;
+    } else if (value instanceof String) {
+      this.fieldAccessWorkType = ColumnType.STRING;
+    } else if (value instanceof Number) {
+      this.fieldAccessWorkType = ColumnType.DOUBLE;
+    } else {
+      this.fieldAccessWorkType = ColumnType.UNKNOWN_COMPLEX;
+    }
+  }
