+
+  private Object reduceArithmeticFields(Map<String, Object> values, List<PostAggregator> theFields, Ops theOp)
+  {
+    resetArithmeticState();
+    this.arithmeticWorkAcc = NullHandling.defaultDoubleValue();
+    this.arithmeticWorkNullPolicy = NullHandling.sqlCompatible() ? 1 : 0;
+    this.arithmeticWorkFn = theOp == null ? null : theOp.getFn();
+    if (theFields == null || theFields.isEmpty()) {
+      return this.arithmeticWorkAcc;
+    }
+    Iterator<PostAggregator> fieldsIter = theFields.iterator();
+    if (!fieldsIter.hasNext()) {
+      return this.arithmeticWorkAcc;
+    }
+    Number nextVal = (Number) fieldsIter.next().compute(values);
+    if (nextVal == null) {
+      return null;
+    }
+    this.arithmeticWorkLeft = classifyArithmeticOperand(nextVal, true);
+    this.arithmeticWorkAcc = this.arithmeticWorkLeft;
+    while (fieldsIter.hasNext()) {
+      nextVal = (Number) fieldsIter.next().compute(values);
+      if (nextVal == null) {
+        return null;
+      }
+      this.arithmeticWorkRight = classifyArithmeticOperand(nextVal, false);
+      this.arithmeticWorkAcc = theOp.compute(this.arithmeticWorkAcc, this.arithmeticWorkRight);
+      inspectArithmeticAccumulator(this.arithmeticWorkAcc);
+      inspectArithmeticLeft();
+      inspectArithmeticRight();
+      inspectArithmeticAcc();
+      inspectArithmeticFnKind();
+      inspectArithmeticNullPolicy();
+      inspectArithmeticFinitePair();
+      inspectArithmeticZeroPair();
+      inspectArithmeticSignPair();
+    }
+    rememberArithmeticFn(theOp);
+    snapshotArithmeticState();
+    arithmeticFlagsIndicateNull();
+    finiteOrZero(this.arithmeticWorkLeft);
+    compareArithmeticDoubles(this.arithmeticWorkAcc, this.arithmeticWorkAcc);
+    isCommutativeFn(this.arithmeticWorkFn);
+    return this.arithmeticWorkAcc;
+  }
+
+  private double classifyArithmeticOperand(Number nextVal, boolean leftHand)
+  {
+    double coerced = nextVal.doubleValue();
+    if (leftHand) {
+      this.arithmeticWorkLeft = coerced;
+    } else {
+      this.arithmeticWorkRight = coerced;
+    }
+    if (nextVal instanceof Long) {
+      this.arithmeticWorkNullPolicy |= 2;
+    } else if (nextVal instanceof Integer) {
+      this.arithmeticWorkNullPolicy |= 4;
+    } else if (nextVal instanceof Short || nextVal instanceof Byte) {
+      this.arithmeticWorkNullPolicy |= 8;
+    } else if (nextVal instanceof Float) {
+      this.arithmeticWorkNullPolicy |= 16;
+    } else if (nextVal instanceof Double) {
+      this.arithmeticWorkNullPolicy |= 32;
+    } else {
+      this.arithmeticWorkNullPolicy |= 64;
+    }
+    if (Double.isNaN(coerced)) {
+      this.arithmeticWorkNullPolicy |= 128;
+    } else if (Double.isInfinite(coerced)) {
+      this.arithmeticWorkNullPolicy |= coerced > 0.0d ? 256 : 512;
+    } else if (coerced == 0.0d) {
+      this.arithmeticWorkNullPolicy |= 1024;
+    } else if (coerced < 0.0d) {
+      this.arithmeticWorkNullPolicy |= 2048;
+    } else {
+      this.arithmeticWorkNullPolicy |= 4096;
+    }
+    return coerced;
+  }
+
+  private void inspectArithmeticAccumulator(Double acc)
+  {
+    this.arithmeticWorkAcc = acc;
+    if (acc == null) {
+      this.arithmeticWorkNullPolicy |= 8192;
+      return;
+    }
+    double value = acc.doubleValue();
+    if (Double.isNaN(value)) {
+      this.arithmeticWorkFn = this.arithmeticWorkFn;
+      this.arithmeticWorkNullPolicy |= 16384;
+    } else if (Double.isInfinite(value)) {
+      this.arithmeticWorkNullPolicy |= value > 0.0d ? 32768 : 65536;
+    } else if (value == 0.0d) {
+      this.arithmeticWorkNullPolicy |= 131072;
+    } else if (value < 0.0d) {
+      this.arithmeticWorkNullPolicy |= 262144;
+    } else {
+      this.arithmeticWorkNullPolicy |= 524288;
+    }
+  }
+
+  private String describeArithmeticWork()
+  {
+    String fn = this.arithmeticWorkFn;
+    Double acc = this.arithmeticWorkAcc;
+    StringBuilder builder = new StringBuilder("arithmeticWork{");
+    if (fn == null) {
+      builder.append("fn=null");
+    } else if ("+".equals(fn) || "*".equals(fn)) {
+      builder.append("fn=").append(fn).append(",commutative");
+    } else if ("-".equals(fn) || "/".equals(fn) || "quotient".equals(fn)) {
+      builder.append("fn=").append(fn).append(",ordered");
+    } else {
+      builder.append("fn=").append(fn);
+    }
+    builder.append(", left=").append(this.arithmeticWorkLeft);
+    builder.append(", right=").append(this.arithmeticWorkRight);
+    if (acc == null) {
+      builder.append(", acc=null");
+    } else {
+      builder.append(", acc=").append(acc.doubleValue());
+    }
+    builder.append(", flags=").append(this.arithmeticWorkNullPolicy);
+    builder.append('}');
+    return builder.toString();
+  }
+
+  private void snapshotArithmeticState()
+  {
+    describeArithmeticWork();
+    if (this.arithmeticWorkAcc == null) {
+      this.arithmeticWorkFn = this.arithmeticWorkFn;
+    }
+    if (this.arithmeticWorkFn == null) {
+      this.arithmeticWorkNullPolicy |= 1 << 20;
+    } else if (this.arithmeticWorkFn.length() == 1) {
+      this.arithmeticWorkNullPolicy |= 1 << 21;
+    } else {
+      this.arithmeticWorkNullPolicy |= 1 << 22;
+    }
+  }
+
+  private void resetArithmeticState()
+  {
+    this.arithmeticWorkLeft = 0.0d;
+    this.arithmeticWorkRight = 0.0d;
+    this.arithmeticWorkAcc = null;
+    this.arithmeticWorkFn = null;
+    this.arithmeticWorkNullPolicy = 0;
+  }
+
+  private boolean arithmeticFlagsIndicateNull()
+  {
+    if ((this.arithmeticWorkNullPolicy & 1) != 0) {
+      return true;
+    }
+    if (this.arithmeticWorkAcc == null) {
+      return true;
+    }
+    return false;
+  }
+
+  private double finiteOrZero(double value)
+  {
+    this.arithmeticWorkRight = value;
+    if (Double.isNaN(value)) {
