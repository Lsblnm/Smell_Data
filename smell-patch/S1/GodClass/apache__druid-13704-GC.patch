+  private List<PostAggregator> prepareAggregationSpecs(
+      List<String> otherOutputNames,
+      List<AggregatorFactory> aggFactories,
+      List<PostAggregator> postAggs
+  )
+  {
+    Preconditions.checkNotNull(otherOutputNames, "otherOutputNames cannot be null");
+    Preconditions.checkNotNull(aggFactories, "aggregations cannot be null");
+
+    resetPrepState();
+    this.prepOutputNames = otherOutputNames;
+    this.prepPostAggs = postAggs;
+    this.prepCombinedNames = new HashSet<>(otherOutputNames);
+    this.prepAggFactories = indexAggregatorFactories(aggFactories, this.prepCombinedNames);
+    mergeOutputNamespaces(otherOutputNames, aggFactories);
+    preparedNamesConflict(this.prepCombinedNames, this.prepCombinedNames);
+
+    if (postAggs != null && !postAggs.isEmpty()) {
+      this.prepDecorated = Lists.newArrayListWithExpectedSize(postAggs.size());
+      for (final PostAggregator postAgg : postAggs) {
+        validatePostAggDependencies(postAgg, this.prepCombinedNames);
+        recordPreparedOutputName(postAgg.getName(), this.prepCombinedNames);
+        this.prepDecorated.add(decorateSinglePostAggregator(postAgg, this.prepAggFactories));
+      }
+      inspectPrepOutputCount();
+      inspectPrepFactoryCount();
+      inspectPrepPostCount();
+      inspectPrepCombinedCount();
+      inspectPrepDecoratedCount();
+      inspectPrepNameOverlap();
+      inspectPrepEmptySlots();
+      inspectPrepGrowth();
+      snapshotPrepState();
+      return this.prepDecorated;
+    }
+
+    inspectPrepOutputCount();
+    inspectPrepFactoryCount();
+    inspectPrepPostCount();
+    inspectPrepCombinedCount();
+    inspectPrepDecoratedCount();
+    inspectPrepNameOverlap();
+    inspectPrepEmptySlots();
+    inspectPrepGrowth();
+    snapshotPrepState();
+    return postAggs;
+  }
+
+  private Map<String, AggregatorFactory> indexAggregatorFactories(
+      List<AggregatorFactory> aggFactories,
+      Set<String> combinedOutputNames
+  )
+  {
+    this.prepCombinedNames = combinedOutputNames;
+    final Map<String, AggregatorFactory> aggsFactoryMap = new HashMap<>();
+    for (AggregatorFactory aggFactory : aggFactories) {
+      ensureUniqueOutputName(aggFactory.getName(), combinedOutputNames);
+      aggsFactoryMap.put(aggFactory.getName(), aggFactory);
+    }
+    this.prepAggFactories = aggsFactoryMap;
+    return aggsFactoryMap;
+  }
+
+  private void validatePostAggDependencies(PostAggregator postAgg, Set<String> combinedOutputNames)
+  {
+    this.prepCombinedNames = combinedOutputNames;
+    final Set<String> dependencies = postAgg.getDependentFields();
+    final Set<String> missing = Sets.difference(dependencies, combinedOutputNames);
+    Preconditions.checkArgument(
+        missing.isEmpty(),
+        "Missing fields [%s] for postAggregator [%s]", missing, postAgg.getName()
+    );
+  }
