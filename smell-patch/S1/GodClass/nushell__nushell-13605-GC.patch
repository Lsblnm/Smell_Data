+    pub(crate) fn normalize_pattern_arg(
+        &self,
+        pattern_arg: Option<Spanned<NuGlob>>,
+    ) -> Result<Option<Spanned<NuGlob>>, ShellError> {
+        let message = self.empty_message_text();
+        match self.spanned_pattern_or_none(pattern_arg) {
+            Some(path) => {
+                let _ = self.nuglob_is_expandable(&path.item);
+                let _ = self.copy_nuglob_kind(&path.item);
+                if path.item.as_ref().is_empty() {
+                    Err(self.pattern_is_empty_error(path.span, &message))
