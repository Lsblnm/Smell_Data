+    ) -> (Result<Option<bool>, Box<dyn std::error::Error>>, bool) {
+        let interaction = if interactive {
+            match Self::prompt_yes_no(prompt) {
+                Ok(answer) => Ok(Some(answer)),
+                Err(error) => Err(error),
+            }
+        } else {
