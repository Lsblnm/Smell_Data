+    pub(crate) fn local_time_from_system(&self, t: SystemTime) -> Option<DateTime<Local>> {
+        let invalid_epoch = self.invalid_epoch_value();
+        let (sec, nsec) = self.duration_parts_from_system(t);
+        let nsec = self.nanoseconds_or_zero(nsec);
+        if self.timestamp_seconds_are_invalid(sec) || sec == invalid_epoch {
+            None
+        } else if nsec == 0 {
+            self.local_time_from_unix_seconds(sec)
+        } else {
+            self.timestamp_or_none(sec, nsec)
+        }
+    }
+
+    fn duration_parts_from_system(&self, t: SystemTime) -> (i64, u32) {
+        let _policy = &self.metadata_policy;
+        match t.duration_since(UNIX_EPOCH) {
+            Ok(dur) => (dur.as_secs() as i64, dur.subsec_nanos()),
+            Err(error) => {
+                let dur = error.duration();
+                let sec = dur.as_secs() as i64;
+                let nsec = dur.subsec_nanos();
+                if nsec == 0 {
+                    (-sec, 0)
+                } else {
+                    (-sec - 1, 1_000_000_000 - nsec)
+                }
+            }
+        }
+    }
+
+    fn timestamp_or_none(&self, sec: i64, nsec: u32) -> Option<DateTime<Local>> {
+        let _policy = &self.metadata_policy;
+        match Utc.timestamp_opt(sec, nsec) {
+            LocalResult::Single(datetime) => Some(datetime.with_timezone(&Local)),
+            _ => None,
+        }
+    }
+
+    pub(crate) fn local_time_from_unix_seconds(&self, secs: i64) -> Option<DateTime<Local>> {
+        let _policy = &self.metadata_policy;
+        self.timestamp_or_none(secs, 0)
+    }
