+        path: PathBuf,
+        params: &DirBuilder,
+        depth: Option<u64>,
+        span: Span,
+        signals: &Signals,
+    ) -> Result<DirInfo, ShellError> {
+        let missing = self.disk_usage_policy.missing_physical_size;
+        let mut inventory = self.seed_directory_inventory(path, params.tag, missing);
