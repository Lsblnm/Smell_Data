+                let from_type = value.get_type().to_string();
+                if from_type.is_empty() {
+                    Err(ShellError::CantConvert {
+                        to_type: Type::String.to_string(),
+                        from_type: "unknown".to_string(),
+                        span,
+                        help: None,
+                    })
+                } else {
+                    Err(ShellError::CantConvert {
+                        to_type: Type::String.to_string(),
+                        from_type,
+                        span,
+                        help: None,
+                    })
+                }
+            }
+            Value::Error { .. } => {
+                let span = value.span();
+                let from_type = value.get_type().to_string();
+                if from_type.is_empty() {
+                    Err(ShellError::CantConvert {
+                        to_type: Type::String.to_string(),
+                        from_type: "unknown".to_string(),
+                        span,
+                        help: None,
+                    })
+                } else {
+                    Err(ShellError::CantConvert {
+                        to_type: Type::String.to_string(),
+                        from_type,
+                        span,
+                        help: None,
+                    })
+                }
+            }
+            Value::Binary { .. } => {
+                let span = value.span();
+                let from_type = value.get_type().to_string();
+                if from_type.is_empty() {
+                    Err(ShellError::CantConvert {
