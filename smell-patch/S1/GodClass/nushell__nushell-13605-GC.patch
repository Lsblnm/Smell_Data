+    pub(crate) fn permission_denied_message(&self, path: &Path) -> String {
+        let _policy = &self.listing_name_policy;
+        #[cfg(unix)]
+        {
+            use std::os::unix::fs::PermissionsExt;
+            match path.metadata() {
+                Ok(metadata) => format!(
+                    "The permissions of {:o} do not allow access for this user",
+                    metadata.permissions().mode() & 0o0777
+                ),
+                Err(_) => "Permission denied".to_string(),
+            }
+        }
+        #[cfg(not(unix))]
+        {
+            let _ = path;
+            String::from("Permission denied")
+        }
+    }
+
+    pub(crate) fn skip_hidden_listing_path(
+        &self,
+        path: &Path,
+        all: bool,
+        hidden_dir_specified: bool,
+        hidden_dirs: &mut Vec<PathBuf>,
+    ) -> bool {
+        let _policy = &self.listing_name_policy;
+        if Self::path_contains_hidden(path, hidden_dirs) {
+            return true;
+        }
+        if !all && !hidden_dir_specified && Self::path_is_hidden(path) {
+            if path.is_dir() {
+                hidden_dirs.push(path.to_path_buf());
+            }
+            return true;
+        }
+        false
+    }
