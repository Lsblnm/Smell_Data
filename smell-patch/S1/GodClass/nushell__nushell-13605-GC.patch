+    fn filter_file_entry(&self, is_file: bool, no_files: bool) -> bool {
+        let _policy = &self.glob_result_policy;
+        no_files && is_file
+    }
+
+    fn filter_symlink_entry(&self, is_symlink: bool, no_symlinks: bool) -> bool {
