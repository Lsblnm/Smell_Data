+    fn nuglob_from_glob(&self, val: String, no_expand: bool) -> Result<NuGlob, ShellError> {
+        let _policy = &self.glob_arg_policy;
+        if no_expand {
+            Ok(NuGlob::DoNotExpand(val))
+        } else {
+            Ok(NuGlob::Expand(val))
+        }
+    }
