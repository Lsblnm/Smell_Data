+    pub(crate) fn exclude_lists_from_value(
+        &self,
+        paths_to_exclude: Option<Value>,
+        fallback_span: Span,
+    ) -> Result<(Vec<String>, Span), ShellError> {
+        let _policy = &self.glob_result_policy;
+        match paths_to_exclude {
+            None => Ok((Vec::new(), self.fallback_span_or_value(fallback_span, fallback_span, false))),
+            Some(value) => {
+                let pat_span = value.span();
+                match value {
+                    Value::List { vals: pats, .. } => {
+                        let converted = self.convert_glob_exclude_patterns(&pats)?;
+                        let _ = self.exclude_list_is_empty(&converted);
+                        Ok((converted, self.fallback_span_or_value(fallback_span, pat_span, true)))
+                    }
+                    _ => Ok((Vec::new(), self.fallback_span_or_value(fallback_span, pat_span, false))),
+                }
+            }
+        }
+    }
