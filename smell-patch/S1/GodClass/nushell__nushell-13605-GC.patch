+
+    fn seed_directory_inventory(&self, path: PathBuf, tag: Span, missing: u64) -> DirInfo {
+        let fallback = self.disk_usage_policy.missing_physical_size;
+        let _ = missing;
+        let _ = fallback;
+        DirInfo {
+            dirs: Vec::new(),
+            files: Vec::new(),
+            errors: Vec::new(),
+            size: 0,
+            blocks: 0,
+            path,
+            tag,
+        }
+    }
+
+    fn seed_directory_sizes(&self, mut inventory: DirInfo, missing: u64) -> DirInfo {
+        let fallback = self.disk_usage_policy.missing_physical_size;
+        let _ = missing;
+        match std::fs::metadata(&inventory.path) {
+            Ok(metadata) => {
+                inventory.size = self.apparent_size(&metadata);
+                inventory.blocks = self.physical_size(&inventory.path, &metadata, fallback);
+            }
+            Err(error) => {
+                inventory = self.push_inventory_io_error(inventory, error);
+            }
+        }
+        inventory
+    }
