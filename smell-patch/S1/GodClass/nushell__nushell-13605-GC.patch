+    pub(crate) fn file_kind_label(
+        &self,
+        md: &std::fs::Metadata,
+        display_name: &str,
+        use_mime_type: bool,
+    ) -> String {
+        let unknown = self.unknown_kind_label();
+        let file_type = self.file_kind_from_file_type(md.file_type(), &unknown);
+        if self.prefer_mime_for_file(use_mime_type, &file_type) && self.kind_is_file_label(&file_type) {
+            self.mime_kind_label(display_name, &file_type)
+        } else if self.kind_is_directory_label(&file_type) || self.kind_is_symlink_label(&file_type) {
+            file_type
+        } else {
+            file_type
+        }
+    }
+
+    fn file_kind_from_file_type(&self, ft: std::fs::FileType, unknown: &str) -> String {
+        let _policy = &self.metadata_policy;
+        if ft.is_dir() {
+            self.file_type_from_dir_flag(true, false, false)
+        } else if ft.is_file() {
+            self.file_type_from_dir_flag(false, true, false)
+        } else if ft.is_symlink() {
+            self.file_type_from_dir_flag(false, false, true)
+        } else if let Some(special) = self.unix_special_kind(&ft) {
+            special.to_string()
+        } else if unknown.is_empty() {
+            unknown.to_string()
+        } else {
+            unknown.to_string()
+        }
+    }
+
+    fn unix_special_kind(&self, ft: &std::fs::FileType) -> Option<&'static str> {
+        let _policy = &self.metadata_policy;
+        #[cfg(unix)]
+        {
+            use std::os::unix::fs::FileTypeExt;
+            if ft.is_block_device() {
+                Some("block device")
+            } else if ft.is_char_device() {
+                Some("char device")
+            } else if ft.is_fifo() {
+                Some("pipe")
+            } else if ft.is_socket() {
+                Some("socket")
+            } else {
+                None
+            }
+        }
+        #[cfg(not(unix))]
+        {
+            let _ = ft;
+            None
+        }
+    }
+
+    fn prefer_mime_for_file(&self, use_mime_type: bool, file_type: &str) -> bool {
+        let _policy = &self.metadata_policy;
+        use_mime_type && file_type == "file"
+    }
+
+    fn mime_kind_label(&self, display_name: &str, file_type: &str) -> String {
+        if file_type != "file" {
+            return file_type.to_string();
+        }
+        match mime_guess::from_path(display_name).first() {
+            Some(mime_type) => mime_type.essence_str().to_string(),
+            None => self.mime_unknown_label(),
+        }
+    }
