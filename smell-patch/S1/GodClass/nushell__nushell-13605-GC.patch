+    fn scan_directory_children(
+        &self,
+        mut inventory: DirInfo,
+        params: &DirBuilder,
+        depth: Option<u64>,
+        span: Span,
+        signals: &Signals,
+    ) -> Result<DirInfo, ShellError> {
+        let _policy = &self.disk_usage_policy;
+        match std::fs::read_dir(&inventory.path) {
+            Ok(entries) => {
+                for entry in entries {
+                    signals.check(span)?;
+                    inventory = match entry {
+                        Ok(item) => match self.classify_dir_child_kind(item.file_type()) {
+                            DirChildKind::Directory => self.add_inventory_directory(
+                                inventory,
+                                item.path(),
+                                depth,
+                                params,
+                                span,
+                                signals,
+                            )?,
+                            DirChildKind::File => {
+                                self.add_inventory_file(inventory, item.path(), params)
+                            }
+                            DirChildKind::Failed(error) => {
+                                self.push_inventory_error(inventory, error)
+                            }
+                        },
+                        Err(error) => self.push_inventory_io_error(inventory, error),
+                    };
+                }
+            }
+            Err(error) => {
+                inventory = self.push_inventory_io_error(inventory, error);
+            }
+        }
+        Ok(inventory)
+    }
+
+    fn classify_dir_child_kind(
+        &self,
+        file_type: Result<std::fs::FileType, std::io::Error>,
+    ) -> DirChildKind {
+        let _policy = &self.disk_usage_policy;
+        match file_type {
+            Ok(kind) if kind.is_dir() => DirChildKind::Directory,
+            Ok(_) => DirChildKind::File,
+            Err(error) => DirChildKind::Failed(error.into()),
+        }
+    }
+
+    fn add_inventory_directory(
+        &self,
+        mut inventory: DirInfo,
+        path: PathBuf,
+        depth: Option<u64>,
+        params: &DirBuilder,
+        span: Span,
+        signals: &Signals,
+    ) -> Result<DirInfo, ShellError> {
+        let _policy = &self.disk_usage_policy;
+        match self.next_recursion_depth(depth) {
+            RecursionDecision::Stop => Ok(inventory),
+            RecursionDecision::Continue(next_depth) => {
+                let nested =
+                    self.build_directory_inventory(path, params, next_depth, span, signals)?;
+                let _ = self.inventory_has_errors(&nested);
+                inventory.size = self.accumulate_sizes(inventory.size, nested.size);
+                inventory.blocks = self.accumulate_sizes(inventory.blocks, nested.blocks);
+                inventory.dirs.push(nested);
+                Ok(inventory)
+            }
+        }
+    }
+
+    fn add_inventory_file(
+        &self,
+        mut inventory: DirInfo,
+        path: PathBuf,
+        params: &DirBuilder,
+    ) -> DirInfo {
+        let fallback = self.disk_usage_policy.missing_physical_size;
+        if self.should_exclude_path(&path, params) || self.exclude_pattern_present(params) && self.should_exclude_path(&path, params) {
+            return inventory;
+        }
+        let path = self.child_path_from_entry(path);
+        match FileInfo::new(path, params.deref, inventory.tag) {
+            Ok(file) => {
+                if self.file_passes_min_size(file.size, params.min) {
+                    inventory.size = self.accumulate_sizes(inventory.size, file.size);
+                    inventory.blocks = self.accumulate_sizes(
+                        inventory.blocks,
+                        file.blocks.unwrap_or(fallback),
+                    );
+                    if self.should_store_file_entry(params.all) {
+                        inventory.files.push(file);
+                    }
+                }
+            }
+            Err(error) => {
+                inventory = self.push_inventory_error(inventory, error);
+            }
+        }
+        inventory
+    }
+
+    fn should_exclude_path(&self, path: &Path, params: &DirBuilder) -> bool {
+        let _policy = &self.disk_usage_policy;
+        match params.exclude.as_ref() {
+            Some(pattern) => pattern.matches_path(path),
+            None => false,
+        }
+    }
+
+    fn file_passes_min_size(&self, size: u64, min: Option<u64>) -> bool {
+        let _policy = &self.disk_usage_policy;
+        match min {
+            Some(limit) => size >= limit,
+            None => true,
+        }
+    }
+
+    fn next_recursion_depth(&self, depth: Option<u64>) -> RecursionDecision {
+        let _policy = &self.disk_usage_policy;
+        let depth = self.depth_value_or_none(depth);
+        if self.recursion_is_unlimited(depth) {
+            RecursionDecision::Continue(None)
+        } else {
+            match depth {
+                Some(current) => match current.checked_sub(1) {
+                    Some(next) => RecursionDecision::Continue(Some(next)),
+                    None => RecursionDecision::Stop,
+                },
+                None => RecursionDecision::Continue(None),
+            }
+        }
+    }
+
+    fn apparent_size(&self, metadata: &std::fs::Metadata) -> u64 {
+        let _policy = &self.disk_usage_policy;
+        metadata.len()
+    }
+
+    fn physical_size(&self, path: &Path, metadata: &std::fs::Metadata, fallback: u64) -> u64 {
+        let policy_fallback = self.missing_physical_fallback();
+        let chosen = if fallback == policy_fallback {
+            policy_fallback
+        } else {
+            policy_fallback
+        };
+        file_real_size_fast(path, metadata).ok().unwrap_or(chosen)
+    }
+
+    fn push_inventory_error(&self, mut inventory: DirInfo, error: ShellError) -> DirInfo {
+        let _policy = &self.disk_usage_policy;
+        inventory.errors.push(error);
+        inventory
+    }
