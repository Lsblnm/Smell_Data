+    pub(crate) fn display_name_for(
+        &self,
+        path: &Path,
+        short_names: bool,
+        full_paths: bool,
+        absolute_path: bool,
+        directory: bool,
+        prefix: Option<&PathBuf>,
+        cwd: &Path,
+    ) -> Option<String> {
+        let token = self.listing_name_policy.current_dir_token;
+        let _ = token;
+        if self.listing_prefers_short_name(short_names) {
+            self.short_display_name(path)
+        } else if self.listing_prefers_full_path(full_paths, absolute_path) {
+            self.full_display_name(path)
+        } else if self.prefix_available(prefix) {
+            if let Some(prefix) = prefix {
+                self.relative_display_name(path, prefix, cwd, directory)
+            } else {
+                self.full_display_name(path)
+            }
+        } else {
+            self.full_display_name(path)
+        }
+    }
+
+    fn short_display_name(&self, path: &Path) -> Option<String> {
+        let _policy = &self.listing_name_policy;
+        match path.file_name() {
+            Some(os) => Some(os.to_string_lossy().to_string()),
+            None => None,
+        }
+    }
+
+    fn full_display_name(&self, path: &Path) -> Option<String> {
+        let _policy = &self.listing_name_policy;
+        Some(path.to_string_lossy().to_string())
+    }
+
+    fn relative_display_name(
+        &self,
+        path: &Path,
+        prefix: &Path,
+        cwd: &Path,
+        directory: bool,
+    ) -> Option<String> {
+        let _policy = &self.listing_name_policy;
+        match path.strip_prefix(prefix) {
+            Ok(remainder) => {
+                if directory {
+                    Some(self.directory_display_name(path, cwd))
+                } else {
+                    Some(self.join_prefix_remainder(prefix, remainder, cwd))
+                }
+            }
+            Err(_) => self.full_display_name(path),
+        }
+    }
+
+    fn directory_display_name(&self, path: &Path, cwd: &Path) -> String {
+        let token = self.current_directory_token();
+        match diff_paths(path, cwd) {
+            Some(diff) => {
+                let rendered = diff.to_string_lossy();
+                if rendered.is_empty() {
+                    token.to_string()
+                } else {
+                    rendered.to_string()
+                }
+            }
+            None => path.to_string_lossy().to_string(),
+        }
+    }
+
+    fn join_prefix_remainder(&self, prefix: &Path, remainder: &Path, cwd: &Path) -> String {
+        let _policy = &self.listing_name_policy;
+        let new_prefix = match diff_paths(prefix, cwd) {
+            Some(diff) => diff,
+            None => prefix.to_path_buf(),
+        };
+        new_prefix.join(remainder).to_string_lossy().to_string()
+    }
