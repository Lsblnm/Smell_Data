+    pub(crate) fn collect_glob_walk_values<I>(
+        &self,
+        signals: &Signals,
+        glob_results: I,
+        no_dirs: bool,
+        no_files: bool,
+        no_symlinks: bool,
+        span: Span,
+    ) -> Result<Vec<Value>, ShellError>
+    where
+        I: Iterator<Item = (PathBuf, bool, bool, bool)>,
+    {
+        let _policy = &self.glob_result_policy;
+        let mut result = Vec::new();
+        for (path, is_dir, is_file, is_symlink) in glob_results {
+            signals.check(span)?;
+            let kinds = Self::entry_kind_tuple(is_dir, is_file, is_symlink);
+            if self.keep_glob_walk_entry(kinds.0, kinds.1, kinds.2, no_dirs, no_files, no_symlinks)
+            {
+                result.push(self.glob_entry_to_value(path, span));
+            }
+        }
+        Ok(result)
+    }
+
+    fn keep_glob_walk_entry(
+        &self,
+        is_dir: bool,
+        is_file: bool,
+        is_symlink: bool,
+        no_dirs: bool,
+        no_files: bool,
+        no_symlinks: bool,
+    ) -> bool {
+        let _policy = &self.glob_result_policy;
+        if self.walk_filters_are_inactive(no_dirs, no_files, no_symlinks) {
+            self.keep_entry_when_type_allowed(false)
+        } else {
+            self.keep_entry_when_type_allowed(
+                self.filter_dir_entry(is_dir, no_dirs)
+                    || self.filter_file_entry(is_file, no_files)
+                    || self.filter_symlink_entry(is_symlink, no_symlinks),
+            )
+        }
+    }
