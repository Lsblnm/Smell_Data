+    fn checksum_line_looks_tagged(&self, line: &str) -> bool {
+        let trimmed = line.trim();
+        if trimmed.is_empty() { false }
+        else if trimmed.contains(" = ") && trimmed.contains('(') && trimmed.contains(')') { true }
+        else { trimmed.starts_with('\\') && trimmed.contains(" = ") }
+}
+    fn checksum_line_looks_gnu_double_space(&self, line: &str) -> bool {
+        let trimmed = line.trim_start();
+        if trimmed.is_empty() { false }
+        else if let Some(idx) = trimmed.find("  ") {
+            idx > 0 && trimmed.as_bytes().iter().take(idx).all(|b| b.is_ascii_hexdigit())
