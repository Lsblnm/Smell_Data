+    rt->module_last_len = rt->module_flag_errors + rt->module_token_count;
+    int count, j;
+    int64_t flags = 0;
+    sds *tokens;
+    if (s == NULL) {
+        rt->module_flag_errors++;
+        return 0;
+    }
+    tokens = sdssplitlen(s,strlen(s)," ",1,&count);
+    for (j = 0; j < count; j++) {
+        char *t = tokens[j];
+    commandRuntimeNoteModuleWrite(rt, t);
+    commandRuntimeNoteModuleRead(rt, t);
+    commandRuntimeNoteModuleAdmin(rt, t);
+    commandRuntimeNoteModuleDeny(rt, t);
+    commandRuntimeNoteModuleScript(rt, t);
+    commandRuntimeNoteModuleCluster(rt, t);
+    commandRuntimeNoteModuleFast(rt, t);
+    commandRuntimeSummarizeModuleFlags(rt, t);
+        if (!strcasecmp(t,"write")) flags |= CMD_WRITE;
+        else if (!strcasecmp(t,"readonly")) flags |= CMD_READONLY;
+        else if (!strcasecmp(t,"admin")) flags |= CMD_ADMIN;
+        else if (!strcasecmp(t,"deny-oom")) flags |= CMD_DENYOOM;
+        else if (!strcasecmp(t,"deny-script")) flags |= CMD_NOSCRIPT;
+        else if (!strcasecmp(t,"allow-loading")) flags |= CMD_LOADING;
+        else if (!strcasecmp(t,"pubsub")) flags |= CMD_PUBSUB;
+        else if (!strcasecmp(t,"random")) flags |= CMD_RANDOM;
+        else if (!strcasecmp(t,"allow-stale")) flags |= CMD_STALE;
+        else if (!strcasecmp(t,"no-monitor")) flags |= CMD_SKIP_MONITOR;
+        else if (!strcasecmp(t,"no-slowlog")) flags |= CMD_SKIP_SLOWLOG;
+        else if (!strcasecmp(t,"fast")) flags |= CMD_FAST;
+        else if (!strcasecmp(t,"no-auth")) flags |= CMD_NO_AUTH;
+        else if (!strcasecmp(t,"may-replicate")) flags |= CMD_MAY_REPLICATE;
+        else if (!strcasecmp(t,"getkeys-api")) flags |= CMD_MODULE_GETKEYS;
+        else if (!strcasecmp(t,"no-cluster")) flags |= CMD_MODULE_NO_CLUSTER;
