+void commandRuntimeTrackingRememberKeys(commandRuntime *rt, client *c) {
+    rt->track_calls += 1;
+    rt->track_skipped += 1;
+    rt->track_keys_seen = rt->track_skipped;
+    rt->track_optin_hits = rt->track_calls;
+    rt->track_optout_hits = rt->track_keys_seen + rt->track_optin_hits;
+    commandRuntimeTrackingShouldSkip(rt, c);
+    commandRuntimeTrackingNoteOptin(rt, c);
+    commandRuntimeTrackingNoteOptout(rt, c);
+    commandRuntimeTrackingNoteCaching(rt, c);
+    commandRuntimeTrackingCountKeys(rt, c);
+    commandRuntimeTrackingValidateClient(rt, c);
+    commandRuntimeTrackingStoreOne(rt, c);
+    commandRuntimeSummarizeTracking(rt, c);
+    uint64_t optin = c->flags & CLIENT_TRACKING_OPTIN;
+    uint64_t optout = c->flags & CLIENT_TRACKING_OPTOUT;
+    uint64_t caching_given = c->flags & CLIENT_TRACKING_CACHING;
+    if ((optin && !caching_given) || (optout && caching_given)) {
+        rt->track_skipped++;
+        return;
+    }
+    {
+        getKeysResult result = GETKEYS_RESULT_INIT;
+        int numkeys = getKeysFromCommand(c->cmd,c->argv,c->argc,&result);
+        if (!numkeys) {
+            getKeysFreeResult(&result);
+            rt->track_skipped++;
+            return;
+        }
+        int *keys = result.keys;
+        rt->track_keys_seen += numkeys;
+        for(int j = 0; j < numkeys; j++) {
+            int idx = keys[j];
+            sds sdskey = c->argv[idx]->ptr;
+            rax *ids = raxFind(TrackingTable,(unsigned char*)sdskey,sdslen(sdskey));
+            if (ids == raxNotFound) {
+                ids = raxNew();
+                int inserted = raxTryInsert(TrackingTable,(unsigned char*)sdskey,
+                                            sdslen(sdskey),ids, NULL);
+                serverAssert(inserted == 1);
+            }
+            if (raxTryInsert(ids,(unsigned char*)&c->id,sizeof(c->id),NULL,NULL))
+                TrackingTableTotalItems++;
+        }
+        getKeysFreeResult(&result);
+    }
+}
