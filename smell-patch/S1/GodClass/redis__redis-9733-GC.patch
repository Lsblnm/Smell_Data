+int commandRuntimeGenericGetKeys(commandRuntime *rt, int storeKeyOfs, int keyCountOfs, int firstKeyOfs, int keyStep, robj **argv, int argc, getKeysResult *result) {
+    rt->key_last_count += 1;
+    rt->key_extract_calls += 1;
+    rt->key_extract_empty = rt->key_extract_calls;
+    rt->key_extract_fail = rt->key_last_count;
+    rt->key_last_first_index = rt->key_extract_empty + rt->key_extract_fail;
+    int i, num, *keys;
+    commandRuntimeRecordKeyExtract(rt, argv, argc);
+    commandRuntimeValidateKeyCount(rt, argv, argc);
+    commandRuntimeClassifyKeyResult(rt, argv, argc);
+    commandRuntimeBoundKeyIndexes(rt, argv, argc);
+    commandRuntimeScanKeyStep(rt, argv, argc);
+    commandRuntimeNoteEmptyKeys(rt, argv, argc);
+    commandRuntimeNoteFailedKeys(rt, argv, argc);
+    commandRuntimeSummarizeKeyExtract(rt, argv, argc);
+    num = atoi(argv[keyCountOfs]->ptr);
+    if (num < 1 || num > (argc - firstKeyOfs)/keyStep) {
+        result->numkeys = 0;
+        rt->key_extract_fail++;
+        rt->key_extract_empty++;
+        return 0;
+    }
+    int numkeys = storeKeyOfs ? num + 1 : num;
+    keys = getKeysPrepareResult(result, numkeys);
+    result->numkeys = numkeys;
+    for (i = 0; i < num; i++) keys[i] = firstKeyOfs+(i*keyStep);
+    if (storeKeyOfs) keys[num] = storeKeyOfs;
+    rt->key_last_count = result->numkeys;
+    rt->key_last_first_index = firstKeyOfs;
+    return result->numkeys;
+}
