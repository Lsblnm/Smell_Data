+    commandRuntimeInspectCommandCategories(rt, c);
+    commandRuntimeInspectCommandFlags(rt, c);
+    commandRuntimeSummarizeCatalog(rt, c);
+    if (c == NULL) {
+        rt->catalog_slow_count++;
+        return;
+    }
+    if (c->flags & CMD_CATEGORY_FAST) {
+        rt->catalog_fast_count++;
+    } else {
+        rt->catalog_slow_count++;
+    }
+    if (c->movablekeys) rt->catalog_movable_count++;
+    if (c->subcommands) rt->catalog_subcommand_count++;
+    rt->catalog_populate_count++;
+}
