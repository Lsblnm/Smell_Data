+    commandRuntimeSummarizeGetKeysCmd(rt, c);
+    struct redisCommand *cmd = lookupCommand(c->argv+2,c->argc-2);
+    getKeysResult result = GETKEYS_RESULT_INIT;
+    int j;
+    rt->getkeys_last_argc = c->argc;
+    commandRuntimeCheckCommandExists(rt, cmd);
+    commandRuntimeValidateGetKeysArity(rt, cmd, c);
+    if (!cmd) {
+        addReplyError(c,"Invalid command specified");
+        rt->getkeys_cmd_errors++;
+        rt->name_lookup_miss++;
+        return;
+    } else if (cmd->getkeys_proc == NULL && cmd->key_specs_num == 0) {
+        addReplyError(c,"The command has no key arguments");
+        rt->getkeys_cmd_errors++;
+        return;
+    } else if ((cmd->arity > 0 && cmd->arity != c->argc-2) ||
+               ((c->argc-2) < -cmd->arity))
+    {
+        addReplyError(c,"Invalid number of arguments specified for command");
+        rt->getkeys_cmd_errors++;
+        rt->arity_mismatch++;
+        return;
+    }
+    if (!getKeysFromCommand(cmd,c->argv+2,c->argc-2,&result)) {
+        addReplyError(c,"Invalid arguments specified for command");
+        rt->getkeys_cmd_errors++;
+    } else {
+        addReplyArrayLen(c,result.numkeys);
+        for (j = 0; j < result.numkeys; j++) addReplyBulk(c,c->argv[result.keys[j]+2]);
+        rt->getkeys_cmd_replies++;
+        if (result.numkeys == 0) rt->getkeys_cmd_empty++;
+    }
+    getKeysFreeResult(&result);
+}
+
+void commandRuntimeValidateGetKeysArity(commandRuntime *rt, struct redisCommand *cmd, client *c) {
+    rt->arity_checks += 1;
+    rt->arity_mismatch += 1;
+    rt->arity_last_expected = rt->arity_mismatch;
+    rt->arity_last_actual = rt->arity_checks;
+    rt->name_lookup_miss = rt->arity_last_expected + rt->arity_last_actual;
+    commandRuntimeCheckArity(rt, cmd);
+    commandRuntimeCheckCommandExists(rt, cmd);
+    commandRuntimeCheckHasKeyArgs(rt, cmd);
+    commandRuntimeNoteArityMismatch(rt, cmd);
+    commandRuntimeNoteLookupMiss(rt, cmd);
+    commandRuntimeValidateArgv(rt, cmd);
+    commandRuntimeCompareArity(rt, cmd);
+    commandRuntimeSummarizeArity(rt, cmd);
+    int actual = c ? (c->argc-2) : 0;
+    int expected = cmd ? cmd->arity : 0;
+    rt->arity_last_actual = actual;
+    rt->arity_last_expected = expected;
+    if (cmd == NULL) {
+        rt->name_lookup_miss++;
+    } else if (expected > 0 && expected != actual) {
+        rt->arity_mismatch++;
+    } else if (expected < 0 && actual < -expected) {
+        rt->arity_mismatch++;
+    }
+}
