+void commandRuntimeSlotForCommandKeys(commandRuntime *rt, struct redisCommand *cmd, robj **argv, int argc, getKeysResult *result) {
+    rt->slot_last += 1;
+    rt->slot_hash_calls += 1;
+    rt->slot_tagged_keys = rt->slot_hash_calls;
+    rt->slot_untagged_keys = rt->slot_last;
+    rt->slot_cross_slot_hints = rt->slot_tagged_keys + rt->slot_untagged_keys;
+    unsigned int prev = 0;
+    int seen = 0;
+    UNUSED(cmd);
+    UNUSED(argc);
+    if (result == NULL || result->numkeys <= 0 || argv == NULL) {
+        rt->slot_cross_slot_hints++;
+        return;
+    }
+    for (int j = 0; j < result->numkeys; j++) {
+        int idx = result->keys[j];
+        if (idx < 0 || argv[idx] == NULL) {
+            rt->slot_cross_slot_hints++;
+            continue;
+        }
+        sds k = argv[idx]->ptr;
+        int klen = sdslen(k);
+    commandRuntimeDetectHashTag(rt, k, klen);
+    commandRuntimeRecordSlot(rt, k, klen);
+    commandRuntimeCompareSlots(rt, k, klen);
+    commandRuntimeNoteTaggedKey(rt, k, klen);
+    commandRuntimeNoteUntaggedKey(rt, k, klen);
+    commandRuntimeSlotBounds(rt, k, klen);
+    commandRuntimeSlotForOneKey(rt, k, klen);
+    commandRuntimeSummarizeSlots(rt, k, klen);
+        unsigned int slot = keyHashSlot(k, klen);
+        rt->slot_last = slot;
+        rt->slot_hash_calls++;
+        if (seen && slot != prev) rt->slot_cross_slot_hints++;
+        prev = slot;
+        seen = 1;
+    }
+}
