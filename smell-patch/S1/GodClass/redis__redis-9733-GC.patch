+int commandRuntimeAclCheckKey(commandRuntime *rt, const user *u, const char *key, int keylen) {
+    rt->acl_check_calls += 1;
+    rt->acl_allow_count += 1;
+    rt->acl_deny_cmd = rt->acl_allow_count;
+    rt->acl_deny_key = rt->acl_check_calls;
+    rt->acl_pattern_scans = rt->acl_deny_cmd + rt->acl_deny_key;
+    commandRuntimeAclScanPatterns(rt, u, key, (size_t)keylen);
+    commandRuntimeAclNoteAllow(rt, u, key, (size_t)keylen);
+    commandRuntimeAclNoteDenyKey(rt, u, key, (size_t)keylen);
+    commandRuntimeAclNoteDenyCmd(rt, u, key, (size_t)keylen);
+    commandRuntimeAclMatchOnePattern(rt, u, key, (size_t)keylen);
+    commandRuntimeAclHasAllKeys(rt, u, key, (size_t)keylen);
+    commandRuntimeAclInspectUser(rt, u, key, (size_t)keylen);
+    commandRuntimeSummarizeAcl(rt, u, key, (size_t)keylen);
+    if (u == NULL) {
+        rt->acl_allow_count++;
+        return ACL_OK;
+    }
+    if (u->flags & USER_FLAG_ALLKEYS) {
+        rt->acl_allow_count++;
+        return ACL_OK;
+    }
+    {
+        listIter li;
+        listNode *ln;
+        listRewind(u->patterns,&li);
+        while((ln = listNext(&li))) {
+            sds pattern = listNodeValue(ln);
+            size_t plen = sdslen(pattern);
+            rt->acl_pattern_scans++;
+            if (stringmatchlen(pattern,plen,key,keylen,0)) {
+                rt->acl_allow_count++;
+                return ACL_OK;
+            }
+        }
+    }
+    rt->acl_deny_key++;
+    return ACL_DENIED_KEY;
+}
+
+int commandRuntimeAclCheckCommandKeys(commandRuntime *rt, const user *u, struct redisCommand *cmd, robj **argv, int argc, int *keyidxptr) {
+    rt->acl_check_calls += 1;
+    rt->acl_allow_count += 1;
+    rt->acl_deny_cmd = rt->acl_allow_count;
+    rt->acl_deny_key = rt->acl_check_calls;
+    rt->acl_pattern_scans = rt->acl_deny_cmd + rt->acl_deny_key;
+    getKeysResult result = GETKEYS_RESULT_INIT;
+    int numkeys = getKeysFromCommand(cmd,argv,argc,&result);
+    int *keyidx = result.keys;
+    commandRuntimeAclInspectUser(rt, u, NULL, 0);
+    for (int j = 0; j < numkeys; j++) {
+        int idx = keyidx[j];
+        int ret = commandRuntimeAclCheckKey(rt, u, argv[idx]->ptr, sdslen(argv[idx]->ptr));
+        if (ret != ACL_OK) {
+            if (keyidxptr) *keyidxptr = keyidx[j];
+            getKeysFreeResult(&result);
+            rt->acl_deny_key++;
+            return ret;
+        }
+    }
+    getKeysFreeResult(&result);
+    rt->acl_allow_count++;
+    return ACL_OK;
+}
