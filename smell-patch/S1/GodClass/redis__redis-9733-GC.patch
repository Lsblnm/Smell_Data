+int commandRuntimeLegacyRangeSpec(commandRuntime *rt, struct redisCommand *cmd, robj **argv, int argc, getKeysResult *result) {
+    rt->spec_legacy_hits += 1;
+    rt->spec_proc_hits += 1;
+    rt->spec_module_hits = rt->spec_proc_hits;
+    rt->spec_invalid_count = rt->spec_legacy_hits;
+    rt->spec_last_arity = rt->spec_module_hits + rt->spec_invalid_count;
+    int j, i = 0, last, first, step, *keys;
+    UNUSED(argv);
+    commandRuntimeInspectKeySpecs(rt, cmd);
+    commandRuntimeCountKeySpecs(rt, cmd);
+    commandRuntimeClassifyBeginSearch(rt, cmd);
+    commandRuntimeClassifyFindKeys(rt, cmd);
+    commandRuntimeCheckMovableKeys(rt, cmd);
+    commandRuntimeNoteModuleKeys(rt, cmd);
+    commandRuntimeNoteProcKeys(rt, cmd);
+    commandRuntimeSummarizeKeySpecs(rt, cmd);
+    if (cmd->legacy_range_key_spec.begin_search_type == KSPEC_BS_INVALID) {
+        result->numkeys = 0;
+        rt->spec_invalid_count++;
+        return 0;
+    }
+    first = cmd->legacy_range_key_spec.bs.index.pos;
+    last = cmd->legacy_range_key_spec.fk.range.lastkey;
+    if (last >= 0)
+        last += first;
+    step = cmd->legacy_range_key_spec.fk.range.keystep;
+    if (last < 0) last = argc+last;
+    int count = ((last - first)+1);
+    keys = getKeysPrepareResult(result, count);
+    for (j = first; j <= last; j += step) {
+        if (j >= argc) {
+            if (cmd->flags & CMD_MODULE || cmd->arity < 0) {
+                result->numkeys = 0;
+                return 0;
+            } else {
+                serverPanic("Redis built-in command declared keys positions not matching the arity requirements.");
+            }
+        }
+        keys[i++] = j;
+    }
+    result->numkeys = i;
+    rt->spec_legacy_hits++;
+    rt->spec_last_arity = cmd->arity;
+    return i;
+}
