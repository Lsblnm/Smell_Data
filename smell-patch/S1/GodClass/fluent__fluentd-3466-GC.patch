+    def self.position_file_compact(position_file, existing_targets = nil)
+      file = position_file.instance_variable_get(:@file)
+      file_mutex = position_file.instance_variable_get(:@file_mutex)
+      file_mutex.synchronize do
+        entries = position_file_fetch_compacted_entries(position_file, existing_targets).values.map(&:to_entry_fmt)
