+      if format && format[0] == '/' && format[-1] == '/'
+        begin
+          Regexp.new(format[1..-2], Regexp::MULTILINE)
+        rescue => e
+          raise Fluent::ConfigError, "Invalid regexp in #{key}: #{e}"
+        end
+      else
+        raise Fluent::ConfigError, "format should be Regexp, need //, in #{key}: '#{format}'"
+      end
+    end
+
+    def self.collect_multiline_formats(conf, max_num)
+      if defined?(Fluent::Plugin::TailInput) && Fluent::Plugin::TailInput.respond_to?(:collect_multiline_formats)
+        return Fluent::Plugin::TailInput.collect_multiline_formats(conf, max_num)
+      end
+      invalid_formats = conf.keys.select { |k|
+        m = k.match(/^format(\d+)$/)
+        m ? !((1..max_num).include?(m[1].to_i)) : false
+      }
+      unless invalid_formats.empty?
+        raise Fluent::ConfigError, "Invalid formatN found. N should be 1 - #{max_num}: " + invalid_formats.join(",")
+      end
+      prev_format = nil
+      (1..max_num).map { |i|
+        format = conf["format#{i}"]
+        if (i > 1) && prev_format.nil? && !format.nil?
+          raise Fluent::ConfigError, "Jump of format index found. format#{i - 1} is missing."
+        end
+        prev_format = format
+        next if format.nil?
+        check_multiline_format_regexp(format, "format#{i}")
+        format
+      }
+    end
   end
 end
