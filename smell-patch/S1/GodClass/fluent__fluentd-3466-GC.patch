+    def self.position_file_fetch_compacted_entries(position_file, existing_targets = nil)
+      entries = {}
+      file = position_file.instance_variable_get(:@file)
+      logger = position_file.instance_variable_get(:@logger)
+      follow_inodes = position_file.instance_variable_get(:@follow_inodes)
+      file.pos = 0
+      file_pos = 0
+      file.each_line do |line|
+        m = PositionFile::POSITION_FILE_ENTRY_REGEX.match(line)
+        if m.nil?
+          logger.warn "Unparsable line in pos_file: #{line}" if logger
+          next
+        end
+        path = m[1]
+        pos = m[2].to_i(16)
+        ino = m[3].to_i(16)
+        if pos == PositionFile::UNWATCHED_POSITION
+          logger.debug "Remove unwatched line from pos_file: #{line}" if logger
+        else
+          if entries.include?(path)
+            logger.warn("#{path} already exists. use latest one: deleted #{entries[path]}") if logger
+          end
+          if follow_inodes
+            entries[ino] = Entry.new(path, pos, ino, file_pos + path.bytesize + 1)
+          else
+            entries[path] = Entry.new(path, pos, ino, file_pos + path.bytesize + 1)
+          end
+          file_pos += line.size
+        end
+      end
+      entries = position_file_remove_deleted_entries(entries, existing_targets) if follow_inodes
+      entries
+    end
