+    def self.timezone_valid?(timezone)
+      return false if timezone.nil?
+      if PATH_TZ_NUMERIC_PATTERN === timezone
+        return true
+      end
+      if PATH_TZ_NAME_PATTERN === timezone
+        begin
+          TZInfo::Timezone.get(timezone)
+        rescue
+          return false
+        else
+          return true
+        end
+      else
+        return false
+      end
+    end
+
+    def self.timezone_validate!(timezone)
