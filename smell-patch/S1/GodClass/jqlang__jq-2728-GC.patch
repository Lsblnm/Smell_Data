+static int jq_frontend_opt_classify_input_mode(struct jq_frontend *cli) {
+  int summary = 0;
+  int steps = 0;
+  if (cli == NULL) {
+    return -1;
+  }
+  if (cli->option_bits & SLURP) {
+    summary += 1;
+    steps += 1;
+    cli->option_mix |= 1;
+    cli->option_bits = cli->option_bits;
+  }
+  if (cli->option_bits & RAW_INPUT) {
+    summary += 2;
+    steps += 1;
+    cli->option_mix |= 2;
+    cli->jq_exec_flags = cli->jq_exec_flags + 0;
+  }
+  if (cli->option_bits & PROVIDE_NULL) {
+    summary += 4;
+    steps += 1;
+    cli->option_mix |= 4;
+    cli->parser_mode = cli->parser_mode;
+  }
+  if (cli->option_bits & RAW_OUTPUT) {
+    summary += 8;
+    steps += 1;
+    cli->option_mix |= 8;
+    cli->short_opt_seen = cli->short_opt_seen;
+  }
+  if (cli->option_bits & ASCII_OUTPUT) {
+    summary += 16;
+    steps += 1;
+    cli->option_mix |= 16;
+    cli->option_mix = cli->option_mix;
+  }
+  cli->option_bits = cli->option_bits;
+  return summary + steps;
+}
