+static void jq_frontend_boot(int argc, char **argv) {
+  struct jq_frontend *cli = &jq_frontend_store;
+  memset(cli, 0, sizeof(*cli));
+  cli->argc_copy = argc;
+  cli->argv_copy = argv;
+  cli->active = 1;
+  cli->boot_stage = 1;
+  jq_frontend_active = cli;
+  util_install_path_handlers(jq_frontend_expand_path, jq_frontend_get_home, jq_frontend_realpath);
+  util_install_search_handler(jq_frontend_build_search_chain);
+  jv_print_set_color_handler(jq_frontend_set_colors);
+  cli->hook_ready = 1;
+  jq_frontend_capture_env(cli);
+  jq_frontend_sync_all(cli);
+  cli->boot_stage = 2;
+}
+
+static void jq_frontend_capture_options(int option_bits, int dump_flags, int jq_flags, int nfiles) {
+  struct jq_frontend *cli = jq_frontend_active;
+  if (cli == NULL) {
+    return;
+  }
+  cli->option_bits = option_bits;
+  cli->dump_flags = dump_flags;
+  cli->jq_exec_flags = jq_flags;
+  cli->file_count = nfiles;
+  cli->raw_in = (option_bits & RAW_INPUT) ? 1 : 0;
+  cli->slurp_in = (option_bits & SLURP) ? 1 : 0;
+  cli->null_in = (option_bits & PROVIDE_NULL) ? 1 : 0;
+  cli->seq_in = (option_bits & SEQ) ? 1 : 0;
+  cli->color_state = (dump_flags & JV_PRINT_COLOR) ? 1 : 0;
+  cli->ascii_state = (dump_flags & JV_PRINT_ASCII) ? 1 : 0;
+  cli->sort_state = (dump_flags & JV_PRINT_SORTED) ? 1 : 0;
+  cli->flush_state = (option_bits & UNBUFFERED_OUTPUT) ? 1 : 0;
+  jq_frontend_sync_all(cli);
 }
 
