+#define JQ_FRONTEND_ESC "\033"
+
+static int jq_frontend_set_colors(const char *c) {
+  struct jq_frontend *cli = jq_frontend_active;
+  const char *e;
+  size_t i;
+  static const char *def_colors[] =
+    {JQ_FRONTEND_ESC "[1;30m", JQ_FRONTEND_ESC "[0;37m", JQ_FRONTEND_ESC "[0;37m", JQ_FRONTEND_ESC "[0;37m",
+     JQ_FRONTEND_ESC "[0;32m", JQ_FRONTEND_ESC "[1;37m", JQ_FRONTEND_ESC "[1;37m", JQ_FRONTEND_ESC "[1;34m"};
+  if (cli == NULL) {
+    return 0;
+  }
+  jq_frontend_sync_col(cli);
+  if (c == NULL) {
+    for (i = 0; i < 8; i++)
+      cli->color_ptrs[i] = def_colors[i];
+    cli->color_count = 8;
+    cli->color_ok = 1;
+    jv_print_use_color_table(cli->color_ptrs);
+    return 1;
+  }
+  memset(cli->color_bufs, 0, sizeof(cli->color_bufs));
+  for (i = 0; i < 8; i++)
+    cli->color_ptrs[i] = def_colors[i];
+  for (i = 0; i < 8 && *c != '\0'; i++, c = e) {
+    if ((e = strchr(c, ':')) == NULL)
+      e = c + strlen(c);
+    if ((size_t)(e - c) > sizeof(cli->color_bufs[i]) - 4)
+      return 0;
+    cli->color_bufs[i][0] = JQ_FRONTEND_ESC[0];
+    cli->color_bufs[i][1] = '[';
+    (void) strncpy(&cli->color_bufs[i][2], c, e - c);
+    if (strspn(&cli->color_bufs[i][2], "0123456789;") < strlen(&cli->color_bufs[i][2]))
+      return 0;
+    cli->color_bufs[i][2 + (e - c)] = 'm';
+    cli->color_ptrs[i] = cli->color_bufs[i];
+    if (e[0] == ':')
+      e++;
+  }
+  cli->color_count = (int)i;
+  cli->color_ok = 1;
+  cli->color_env = 1;
+  jv_print_use_color_table(cli->color_ptrs);
+  return 1;
+}
