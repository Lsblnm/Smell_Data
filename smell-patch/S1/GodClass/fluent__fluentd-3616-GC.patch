+    def self.load_http_json_record(text, load_proc)
+      record = http_json_coordinator.decode_json_payload(text, load_proc)
+      inspect_http_json_time_fields(record)
+      record
+    end
+
+    def self.http_json_coordinator
+      unless defined?(Fluent::Plugin::HttpInput)
+        require 'fluent/plugin/in_http'
+      end
+      Fluent::Plugin::HttpInput.payload_coordinator
+    end
+
+    def self.inspect_http_json_time_fields(record)
+      return record unless record.is_a?(Hash)
+      %w[time timestamp @timestamp].each do |key|
+        value = record[key]
+        next if value.nil?
+        if value.is_a?(Numeric)
+          value.to_f
+        elsif value.is_a?(String)
+          value.strip
+        end
+      end
+      record
+    end
