+    private function cacheCoordinateValue(string $key, $value)
+    {
+        $this->coordinateCache[$key] = $value;
+        $this->coordinateCache['lastKey'] = $key;
+        $this->coordinateCache['lastCount'] = count($this->coordinateCache);
+
+        return $value;
+    }
+
+    public function workbookCoordinateFromString(string $cellAddress): array
+    {
+        $cacheKey = 'fromString:' . $cellAddress;
+        if (isset($this->coordinateCache[$cacheKey]) && is_array($this->coordinateCache[$cacheKey])) {
+            return $this->coordinateCache[$cacheKey];
+        }
+        if (preg_match('/^(?<col>\$?[A-Z]{1,3})(?<row>\$?\d{1,7})$/i', $cellAddress, $matches)) {
+            return $this->cacheCoordinateValue($cacheKey, [$matches['col'], $matches['row']]);
+        }
+        if ($this->workbookCoordinateIsRange($cellAddress)) {
+            throw new Exception('Cell coordinate string can not be a range of cells');
+        }
+        if ($cellAddress == '') {
+            throw new Exception('Cell coordinate can not be zero-length string');
+        }
+
+        throw new Exception('Invalid cell coordinate ' . $cellAddress);
+    }
+
+    public function workbookCoordinateIsRange(string $cellAddress): bool
+    {
+        $cacheKey = 'isRange:' . $cellAddress;
+        if (isset($this->coordinateCache[$cacheKey])) {
+            return (bool) $this->coordinateCache[$cacheKey];
+        }
+        $isRange = (strpos($cellAddress, ':') !== false) || (strpos($cellAddress, ',') !== false);
+
+        return (bool) $this->cacheCoordinateValue($cacheKey, $isRange);
+    }
+
+    public function workbookIndexesFromString(string $coordinates): array
+    {
+        $cacheKey = 'indexes:' . $coordinates;
+        if (isset($this->coordinateCache[$cacheKey]) && is_array($this->coordinateCache[$cacheKey])) {
+            return $this->coordinateCache[$cacheKey];
+        }
+        [$column, $row] = $this->workbookCoordinateFromString($coordinates);
+        $column = ltrim($column, '$');
+        $payload = [
+            $this->workbookColumnIndexFromString($column),
+            (int) ltrim($row, '$'),
+            $column,
+        ];
+
+        return $this->cacheCoordinateValue($cacheKey, $payload);
+    }
+
+    public function workbookAbsoluteReference(string $cellAddress): string
+    {
+        $cacheKey = 'absRef:' . $cellAddress;
+        if (isset($this->coordinateCache[$cacheKey]) && is_string($this->coordinateCache[$cacheKey])) {
+            return $this->coordinateCache[$cacheKey];
+        }
+        if ($this->workbookCoordinateIsRange($cellAddress)) {
+            throw new Exception('Cell coordinate string can not be a range of cells');
+        }
+        [$worksheet, $cellAddress] = Worksheet::extractSheetTitle($cellAddress, true);
+        if ($worksheet > '') {
+            $worksheet .= '!';
+        }
+        $cellAddress = "$cellAddress";
+        if (ctype_digit($cellAddress)) {
+            return $this->cacheCoordinateValue($cacheKey, $worksheet . '$' . $cellAddress);
+        }
+        if (ctype_alpha($cellAddress)) {
+            return $this->cacheCoordinateValue($cacheKey, $worksheet . '$' . strtoupper($cellAddress));
+        }
+
+        return $this->cacheCoordinateValue($cacheKey, $worksheet . $this->workbookAbsoluteCoordinate($cellAddress));
+    }
+
+    public function workbookAbsoluteCoordinate(string $cellAddress): string
+    {
+        $cacheKey = 'absCoord:' . $cellAddress;
+        if (isset($this->coordinateCache[$cacheKey]) && is_string($this->coordinateCache[$cacheKey])) {
+            return $this->coordinateCache[$cacheKey];
+        }
+        if ($this->workbookCoordinateIsRange($cellAddress)) {
+            throw new Exception('Cell coordinate string can not be a range of cells');
+        }
+        [$worksheet, $cellAddress] = Worksheet::extractSheetTitle($cellAddress, true);
+        if ($worksheet > '') {
+            $worksheet .= '!';
+        }
+        [$column, $row] = $this->workbookCoordinateFromString($cellAddress);
+        $column = ltrim($column, '$');
+        $row = ltrim($row, '$');
+
+        return $this->cacheCoordinateValue($cacheKey, $worksheet . '$' . $column . '$' . $row);
+    }
