+    {
+        $map = [
+            'i' => 'i', 'i1' => 'i', 'i2' => 'i', 'i4' => 'i', 'i8' => 'i', 'int' => 'i',
+            'ui1' => 'i', 'ui2' => 'i', 'ui4' => 'i', 'ui8' => 'i', 'uint' => 'i',
+            'f' => 'f', 'r4' => 'f', 'r8' => 'f', 'decimal' => 'f',
+            's' => 's', 'empty' => 's', 'null' => 's', 'lpstr' => 's', 'lpwstr' => 's', 'bstr' => 's',
+            'd' => 'd', 'date' => 'd', 'filetime' => 'd',
+            'b' => 'b', 'bool' => 'b',
+        ];
+
+        return $map[$propertyType] ?? 'u';
