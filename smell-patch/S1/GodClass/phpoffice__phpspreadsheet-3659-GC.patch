+    public static function validateWorkbookSheetCodeName($sheetCodeName): string
+    {
+        $charCount = self::countWorkbookCharacters($sheetCodeName);
+        if ($charCount == 0) {
+            throw new Exception('Sheet code name cannot be empty.');
+        }
+        $invalidCharacters = ['*', ':', '/', '\\', '?', '[', ']'];
+        if (
+            (str_replace($invalidCharacters, '', $sheetCodeName) !== $sheetCodeName) ||
+            (self::substringWorkbookString($sheetCodeName, -1, 1) == "'") ||
+            (self::substringWorkbookString($sheetCodeName, 0, 1) == "'")
+        ) {
+            throw new Exception('Invalid character found in sheet code name');
+        }
+        if ($charCount > 31) {
+            throw new Exception('Maximum 31 characters allowed in sheet code name.');
+        }
+
+        return $sheetCodeName;
+    }
