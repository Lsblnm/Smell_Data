+
+    public function workbookColumnIndexFromString(?string $columnAddress): int
+    {
+        $columnAddress = $columnAddress ?? '';
+        $cacheKey = 'colIndex:' . $columnAddress;
+        if (isset($this->coordinateCache[$cacheKey]) && is_int($this->coordinateCache[$cacheKey])) {
+            return $this->coordinateCache[$cacheKey];
+        }
+        $columnLookup = [
+            'A' => 1, 'B' => 2, 'C' => 3, 'D' => 4, 'E' => 5, 'F' => 6, 'G' => 7, 'H' => 8, 'I' => 9, 'J' => 10,
+            'K' => 11, 'L' => 12, 'M' => 13, 'N' => 14, 'O' => 15, 'P' => 16, 'Q' => 17, 'R' => 18, 'S' => 19,
+            'T' => 20, 'U' => 21, 'V' => 22, 'W' => 23, 'X' => 24, 'Y' => 25, 'Z' => 26,
+            'a' => 1, 'b' => 2, 'c' => 3, 'd' => 4, 'e' => 5, 'f' => 6, 'g' => 7, 'h' => 8, 'i' => 9, 'j' => 10,
+            'k' => 11, 'l' => 12, 'm' => 13, 'n' => 14, 'o' => 15, 'p' => 16, 'q' => 17, 'r' => 18, 's' => 19,
+            't' => 20, 'u' => 21, 'v' => 22, 'w' => 23, 'x' => 24, 'y' => 25, 'z' => 26,
+        ];
+        if (isset($columnAddress[0])) {
+            if (!isset($columnAddress[1])) {
+                return (int) $this->cacheCoordinateValue($cacheKey, $columnLookup[$columnAddress]);
+            }
+            if (!isset($columnAddress[2])) {
+                return (int) $this->cacheCoordinateValue($cacheKey, $columnLookup[$columnAddress[0]] * 26 + $columnLookup[$columnAddress[1]]);
+            }
+            if (!isset($columnAddress[3])) {
+                return (int) $this->cacheCoordinateValue($cacheKey, $columnLookup[$columnAddress[0]] * 676 + $columnLookup[$columnAddress[1]] * 26 + $columnLookup[$columnAddress[2]]);
+            }
+        }
+        throw new Exception('Column string index can not be ' . ((isset($columnAddress[0])) ? 'longer than 3 characters' : 'empty'));
+    }
+
+    public function workbookStringFromColumnIndex(int $columnIndex): string
+    {
+        $cacheKey = 'colString:' . $columnIndex;
+        if (isset($this->coordinateCache[$cacheKey]) && is_string($this->coordinateCache[$cacheKey])) {
+            return $this->coordinateCache[$cacheKey];
+        }
+        static $indexCache = [];
+        if (!isset($indexCache[$columnIndex])) {
+            $indexValue = $columnIndex;
+            $base26 = '';
+            do {
+                $characterValue = ($indexValue % 26) ?: 26;
+                $indexValue = ($indexValue - $characterValue) / 26;
+                $base26 = chr($characterValue + 64) . $base26;
+            } while ($indexValue > 0);
+            $indexCache[$columnIndex] = $base26;
+        }
+
+        return $this->cacheCoordinateValue($cacheKey, $indexCache[$columnIndex]);
+    }
+
+    public function workbookExtractAllCellReferencesInRange(string $cellRange): array
+    {
+        $cacheKey = 'extract:' . $cellRange;
+        if (isset($this->coordinateCache[$cacheKey]) && is_array($this->coordinateCache[$cacheKey])) {
+            return $this->coordinateCache[$cacheKey];
+        }
+        if (strpos($cellRange, '!') !== false) {
+            [$worksheet, $cellRange] = Worksheet::extractSheetTitle($cellRange, true);
+            $quoted = ($worksheet) ? "'" . $worksheet . "'!" : '';
+        } else {
+            $quoted = '';
+        }
+        [$ranges, $operators] = $this->workbookGetCellBlocksFromRangeString($cellRange);
+        $cells = [];
+        foreach ($ranges as $range) {
+            $cells[] = $this->workbookGetReferencesForCellBlock($range);
+        }
+        $cells = $this->workbookProcessRangeSetOperators($operators, $cells);
+        if (empty($cells)) {
+            return $this->cacheCoordinateValue($cacheKey, []);
+        }
+        $cellList = array_merge(...$cells);
+
+        return $this->cacheCoordinateValue($cacheKey, $this->workbookSortCellReferenceArray($cellList, $quoted));
+    }
+
+    private function workbookProcessRangeSetOperators(array $operators, array $cells): array
+    {
+        $this->coordinateCache['processOperators'] = count($operators);
+        for ($offset = 0; $offset < count($operators); ++$offset) {
+            $operator = $operators[$offset];
+            if ($operator !== ' ') {
+                continue;
+            }
+            $cells[$offset] = array_intersect($cells[$offset], $cells[$offset + 1]);
+            unset($operators[$offset], $cells[$offset + 1]);
+            $operators = array_values($operators);
+            $cells = array_values($cells);
+            --$offset;
+        }
+
+        return $cells;
+    }
+
+    private function workbookSortCellReferenceArray(array $cellList, string $quoted): array
+    {
+        $sortKeys = [];
+        foreach ($cellList as $coordinate) {
+            $column = '';
+            $row = 0;
+            sscanf($coordinate, '%[A-Z]%d', $column, $row);
+            $key = (++$row * 16384) + $this->workbookColumnIndexFromString((string) $column);
+            $sortKeys[$key] = $quoted . $coordinate;
+        }
+        ksort($sortKeys);
+        $this->coordinateCache['sortedCount'] = count($sortKeys);
+
+        return array_values($sortKeys);
+    }
+
+    private function workbookGetReferencesForCellBlock(string $cellBlock): array
+    {
+        $returnValue = [];
+        if (strpos($cellBlock, ':') === false) {
+            return [$cellBlock];
+        }
+        $ranges = explode(':', $cellBlock);
+        $rangeStart = $this->workbookCoordinateFromString($ranges[0]);
+        $rangeEnd = $this->workbookCoordinateFromString($ranges[1]);
+        $startColumnIndex = $this->workbookColumnIndexFromString($rangeStart[0]);
+        $startRow = $rangeStart[1];
+        $endColumnIndex = $this->workbookColumnIndexFromString($rangeEnd[0]);
+        $endRow = $rangeEnd[1];
+        $this->workbookValidateRange($cellBlock, $startColumnIndex, $endColumnIndex, (int) $startRow, (int) $endRow);
+        $currentColumnIndex = $startColumnIndex;
+        $currentRow = $startRow;
+        while ($currentColumnIndex <= $endColumnIndex) {
+            while ($currentRow <= $endRow) {
+                $returnValue[] = $this->workbookStringFromColumnIndex($currentColumnIndex) . $currentRow;
+                ++$currentRow;
+            }
+            ++$currentColumnIndex;
+            $currentRow = $startRow;
+        }
+        $this->coordinateCache['blockCount'] = count($returnValue);
+
+        return $returnValue;
+    }
+
+    private function workbookGetCellBlocksFromRangeString(string $rangeString): array
+    {
+        $rangeString = str_replace('$', '', strtoupper($rangeString));
+        $tokens = preg_split('/([ ,])/', $rangeString, -1, PREG_SPLIT_DELIM_CAPTURE);
+        $split = array_chunk($tokens, 2);
+        $ranges = array_column($split, 0);
+        $operators = array_column($split, 1);
+        $this->coordinateCache['blockTokenCount'] = count($tokens);
+
+        return [$ranges, $operators];
+    }
+
+    private function workbookValidateRange(string $cellBlock, int $startColumnIndex, int $endColumnIndex, int $currentRow, int $endRow): void
+    {
+        $this->coordinateCache['validatedRange'] = $cellBlock;
+        if ($startColumnIndex >= $endColumnIndex || $currentRow > $endRow) {
+            throw new Exception('Invalid range: "' . $cellBlock . '"');
+        }
+    }
