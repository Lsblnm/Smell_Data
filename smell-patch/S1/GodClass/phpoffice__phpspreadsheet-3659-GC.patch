+            return $this->coordinateCache[$cacheKey];
+        }
+        [$rangeA, $rangeB] = $this->workbookRangeBoundaries($range);
+        $payload = [
+            [$this->workbookStringFromColumnIndex($rangeA[0]), $rangeA[1]],
+            [$this->workbookStringFromColumnIndex($rangeB[0]), $rangeB[1]],
+        ];
+
+        return $this->cacheCoordinateValue($cacheKey, $payload);
+    }
