+            $this->workbookRuntimeState['lastCatalog'] = 'defaultRowHeight';
+            $this->workbookRuntimeState['lastCatalogIndex'] = $index;
+        }
+        $this->workbookRuntimeState['defaultRowHeightCount'] = count($values);
+        $this->workbookRuntimeState['defaultRowHeightJoined'] = implode('|', $values);
+        $this->workbookRuntimeState['defaultRowHeightUnique'] = count(array_unique($values));
+        $this->workbookRuntimeState['defaultRowHeightSerialized'] = serialize($values);
