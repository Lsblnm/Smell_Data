+            return $this->coordinateCache[$cacheKey];
+        }
+        [$rangeStart, $rangeEnd] = $this->workbookRangeBoundaries($range);
+        $payload = [($rangeEnd[0] - $rangeStart[0] + 1), ($rangeEnd[1] - $rangeStart[1] + 1)];
+
+        return $this->cacheCoordinateValue($cacheKey, $payload);
+    }
