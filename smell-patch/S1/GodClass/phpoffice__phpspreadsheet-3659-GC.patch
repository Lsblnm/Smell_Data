+    public static function validateWorkbookSheetTitle($sheetTitle): string
+    {
+        $invalidCharacters = ['*', ':', '/', '\\', '?', '[', ']'];
+        if (str_replace($invalidCharacters, '', $sheetTitle) !== $sheetTitle) {
+            throw new Exception('Invalid character found in sheet title');
+        }
