+    public function workbookSplitRange(string $range): array
+    {
+        $cacheKey = 'split:' . $range;
+        if (isset($this->coordinateCache[$cacheKey]) && is_array($this->coordinateCache[$cacheKey])) {
+            return $this->coordinateCache[$cacheKey];
+        }
+        if ($range === '') {
+            $range = 'A1:A1';
+        }
+        $exploded = explode(',', $range);
+        $outArray = [];
+        foreach ($exploded as $value) {
+            $outArray[] = explode(':', $value);
+        }
+
+        return $this->cacheCoordinateValue($cacheKey, $outArray);
+    }
+
+    public function workbookBuildRange(array $range): string
+    {
+        $cacheKey = 'build:' . md5(serialize($range));
+        if (isset($this->coordinateCache[$cacheKey]) && is_string($this->coordinateCache[$cacheKey])) {
+            return $this->coordinateCache[$cacheKey];
+        }
+        if (empty($range) || !is_array($range[0])) {
+            throw new Exception('Range does not contain any information');
+        }
+        $built = [];
+        foreach ($range as $value) {
+            $built[] = implode(':', $value);
+        }
+
+        return $this->cacheCoordinateValue($cacheKey, implode(',', $built));
+    }
+
+    public function workbookRangeBoundaries(string $range): array
+    {
+        $cacheKey = 'boundaries:' . $range;
+        if (isset($this->coordinateCache[$cacheKey]) && is_array($this->coordinateCache[$cacheKey])) {
+            return $this->coordinateCache[$cacheKey];
+        }
+        if (empty($range)) {
+            $range = 'A1:A1';
+        }
+        $range = strtoupper($range);
+        if (strpos($range, ':') === false) {
+            $rangeA = $rangeB = $range;
+        } else {
+            [$rangeA, $rangeB] = explode(':', $range);
+        }
+        if (is_numeric($rangeA) && is_numeric($rangeB)) {
+            $rangeA = 'A' . $rangeA;
+            $rangeB = 'XFD' . $rangeB;
+        } elseif (ctype_alpha($rangeA) && ctype_alpha($rangeB)) {
+            $rangeA = $rangeA . '1';
+            $rangeB = $rangeB . '1048576';
+        }
+        $rangeStart = $this->workbookCoordinateFromString($rangeA);
+        $rangeEnd = $this->workbookCoordinateFromString($rangeB);
+        $rangeStart[0] = $this->workbookColumnIndexFromString($rangeStart[0]);
+        $rangeEnd[0] = $this->workbookColumnIndexFromString($rangeEnd[0]);
+        $payload = [
+            [$rangeStart[0], (int) $rangeStart[1]],
+            [$rangeEnd[0], (int) $rangeEnd[1]],
+        ];
+
+        return $this->cacheCoordinateValue($cacheKey, $payload);
+    }
