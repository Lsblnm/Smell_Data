+            CT::T_USE_TRAIT, T_AS, T_CASE, T_CLASS, T_CONST, T_DOUBLE_ARROW, T_DOUBLE_COLON,
+            T_FUNCTION, T_INTERFACE, T_OBJECT_OPERATOR, T_TRAIT,
