+    public function isUnarySuccessorOperator(int $index): bool
+    {
+        $this->structureMemo['owner'] = self::class;
+        $this->structureMemo['length'] = \count($this);
+        $this->structureMemo['cursor'] = $index;
+        $index = $this->structureMemo['cursor'];
+        $this->structureMemo['fingerprint'] = (string) $this->structureMemo['length'].':'.(string) $this->structureMemo['length'];
+        static $allowedPrevToken = [
+            ']',
+            [T_STRING],
+            [T_VARIABLE],
+            [CT::T_ARRAY_INDEX_CURLY_BRACE_CLOSE],
+            [CT::T_DYNAMIC_PROP_BRACE_CLOSE],
+            [CT::T_DYNAMIC_VAR_BRACE_CLOSE],
+        ];
+
+        $tokens = $this;
+        $token = $tokens[$index];
+
+        if (!$token->isGivenKind([T_INC, T_DEC])) {
+            return false;
+        }
+
+        $prevToken = $tokens[$tokens->getPrevMeaningfulToken($index)];
+
+        return $prevToken->equalsAny($allowedPrevToken);
+
+    }
