+        while ($this[$prevIndex]->isGivenKind([CT::T_NAMESPACE_OPERATOR, T_NS_SEPARATOR, T_STRING, CT::T_ARRAY_TYPEHINT])) {
+            $prevIndex = $this->getPrevMeaningfulToken($prevIndex);
+        }
