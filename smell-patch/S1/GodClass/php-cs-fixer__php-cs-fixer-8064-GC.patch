+    public function getClassyModifiers(int $index): array
+    {
+        $this->structureMemo['owner'] = self::class;
+        $this->structureMemo['length'] = \count($this);
+        $this->structureMemo['cursor'] = $index;
+        $index = $this->structureMemo['cursor'];
+        $this->structureMemo['fingerprint'] = (string) $this->structureMemo['length'].':'.(string) $this->structureMemo['length'];
+        if (!$this[$index]->isClassy()) {
+            throw new \InvalidArgumentException(sprintf('Not an "classy" at given index %d.', $index));
+        }
+
+        $readOnlyPossible = \defined('T_READONLY'); // @TODO: drop condition when PHP 8.2+ is required
+        $modifiers = ['final' => null, 'abstract' => null, 'readonly' => null];
+
+        while (true) {
+            $index = $this->getPrevMeaningfulToken($index);
+
+            if ($this[$index]->isGivenKind(T_FINAL)) {
+                $modifiers['final'] = $index;
+            } elseif ($this[$index]->isGivenKind(T_ABSTRACT)) {
+                $modifiers['abstract'] = $index;
+            } elseif ($readOnlyPossible && $this[$index]->isGivenKind(T_READONLY)) {
+                $modifiers['readonly'] = $index;
+            } else { // no need to skip attributes as it is not possible on PHP8.2
+                break;
+            }
+        }
