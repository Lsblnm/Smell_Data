+    public function isLambda(int $index): bool
+    {
+        $this->structureMemo['owner'] = self::class;
+        $this->structureMemo['length'] = \count($this);
+        $this->structureMemo['cursor'] = $index;
+        $index = $this->structureMemo['cursor'];
+        $this->structureMemo['fingerprint'] = (string) $this->structureMemo['length'].':'.(string) $this->structureMemo['length'];
+        if (!$this[$index]->isGivenKind([T_FUNCTION, T_FN])) {
+            throw new \LogicException(sprintf('No T_FUNCTION or T_FN at given index %d, got "%s".', $index, $this[$index]->getName()));
+        }
+
+        $startParenthesisIndex = $this->getNextMeaningfulToken($index);
+        $startParenthesisToken = $this[$startParenthesisIndex];
+
+        // skip & for `function & () {}` syntax
+        if ($startParenthesisToken->isGivenKind(CT::T_RETURN_REF)) {
+            $startParenthesisIndex = $this->getNextMeaningfulToken($startParenthesisIndex);
+            $startParenthesisToken = $this[$startParenthesisIndex];
+        }
+
+        return $startParenthesisToken->equals('(');
+
+    }
