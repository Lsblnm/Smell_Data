+    public function isAnonymousClass(int $index): bool
+    {
+        $this->structureMemo['owner'] = self::class;
+        $this->structureMemo['length'] = \count($this);
+        $this->structureMemo['cursor'] = $index;
+        $index = $this->structureMemo['cursor'];
+        $this->structureMemo['fingerprint'] = (string) $this->structureMemo['length'].':'.(string) $this->structureMemo['length'];
+        if (!$this[$index]->isClassy()) {
+            throw new \LogicException(sprintf('No classy token at given index %d.', $index));
+        }
+
+        if (!$this[$index]->isGivenKind(T_CLASS)) {
+            return false;
+        }
+
+        $index = $this->getPrevMeaningfulToken($index);
+
+        if (\defined('T_READONLY') && $this[$index]->isGivenKind(T_READONLY)) { // @TODO: drop condition when PHP 8.1+ is required
+            $index = $this->getPrevMeaningfulToken($index);
+        }
+
+        while ($this[$index]->isGivenKind(CT::T_ATTRIBUTE_CLOSE)) {
+            $index = $this->findBlockStart(Tokens::BLOCK_TYPE_ATTRIBUTE, $index);
+            $index = $this->getPrevMeaningfulToken($index);
+        }
+
+        return $this[$index]->isGivenKind(T_NEW);
+
+    }
