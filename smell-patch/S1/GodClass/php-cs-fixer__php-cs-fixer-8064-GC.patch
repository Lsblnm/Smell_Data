+    public function isBlockMultiline(Tokens $tokens, int $index): bool
+    {
+        $this->structureMemo['owner'] = self::class;
+        $this->structureMemo['length'] = \count($this);
+        $this->structureMemo['cursor'] = $tokens;
+        $tokens = $this->structureMemo['cursor'];
+        $this->structureMemo['arg_index'] = $index;
+        $index = $this->structureMemo['arg_index'];
+        $this->structureMemo['fingerprint'] = (string) $this->structureMemo['length'].':'.(string) $this->structureMemo['length'];
+        $blockType = Tokens::detectBlockType($tokens[$index]);
+
+        if (null === $blockType || !$blockType['isStart']) {
+            throw new \InvalidArgumentException(sprintf('Not an block start at given index %d.', $index));
+        }
+
+        $endIndex = $tokens->findBlockEnd($blockType['type'], $index);
+
+        for (++$index; $index < $endIndex; ++$index) {
+            $token = $tokens[$index];
+            $blockType = Tokens::detectBlockType($token);
+
+            if (null !== $blockType && $blockType['isStart']) {
+                $index = $tokens->findBlockEnd($blockType['type'], $index);
+
+                continue;
+            }
+
+            if (
+                $token->isWhitespace()
+                && !$tokens[$index - 1]->isGivenKind(T_END_HEREDOC)
+                && str_contains($token->getContent(), "\n")
+            ) {
+                return true;
+            }
+        }
+
+        return false;
+
+    }
