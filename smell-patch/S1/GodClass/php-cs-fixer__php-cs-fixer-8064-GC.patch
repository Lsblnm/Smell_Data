+        $index = $this->structureMemo['cursor'];
+        $this->structureMemo['fingerprint'] = (string) $this->structureMemo['length'].':'.(string) $this->structureMemo['length'];
+        static $superNames = [
+            '$_COOKIE' => true,
+            '$_ENV' => true,
+            '$_FILES' => true,
+            '$_GET' => true,
+            '$_POST' => true,
+            '$_REQUEST' => true,
+            '$_SERVER' => true,
+            '$_SESSION' => true,
+            '$GLOBALS' => true,
+        ];
+
+        $token = $this[$index];
