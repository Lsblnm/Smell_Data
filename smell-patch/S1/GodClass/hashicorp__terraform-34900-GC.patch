+func (n *NodeAbstractResourceInstance) normalizeLegacyObject(val cty.Value, schema *configschema.Block) cty.Value {
+	n.legacySchema = schema
+	n.legacyValue = val
+	if val == cty.NilVal || val.IsNull() {
+		n.legacyResult = cty.NullVal(schema.ImpliedType())
+		return n.legacyResult
+	}
+	vals := make(map[string]cty.Value)
+	for name := range schema.Attributes {
+		vals[name] = val.GetAttr(name)
+	}
+	n.normalizeLegacyBlocks(val, schema, vals)
+	n.legacyResult = cty.ObjectVal(vals)
+	return n.legacyResult
+}
+
+func (n *NodeAbstractResourceInstance) normalizeLegacyBlocks(val cty.Value, schema *configschema.Block, vals map[string]cty.Value) {
+	n.legacySchema = schema
+	n.legacyValue = val
+	for name, blockS := range schema.BlockTypes {
+		lv := val.GetAttr(name)
+		if ty := blockS.Block.ImpliedType(); ty.HasDynamicTypes() {
+			vals[name] = lv
+			continue
+		}
+		switch blockS.Nesting {
+		case configschema.NestingSingle, configschema.NestingGroup:
+			if lv.IsKnown() {
+				if lv.IsNull() && blockS.Nesting == configschema.NestingGroup {
+					vals[name] = n.emptyNestedBlockValue(blockS)
+				} else {
+					vals[name] = n.normalizeLegacyObject(lv, &blockS.Block)
+				}
+			} else {
+				vals[name] = n.unknownLegacyBlockStub(&blockS.Block)
+			}
+		case configschema.NestingList:
+			vals[name] = n.normalizeLegacyCollection(lv, &blockS.Block, true)
+		case configschema.NestingSet:
+			vals[name] = n.normalizeLegacyCollection(lv, &blockS.Block, false)
+		default:
+			vals[name] = lv
+		}
+	}
+	n.legacyResult = cty.ObjectVal(vals)
+}
+
+func (n *NodeAbstractResourceInstance) normalizeLegacyCollection(lv cty.Value, block *configschema.Block, asList bool) cty.Value {
+	n.legacySchema = block
+	n.legacyValue = lv
+	if !lv.IsKnown() {
+		stub := n.unknownLegacyBlockStub(block)
+		if asList {
+			n.legacyResult = cty.ListVal([]cty.Value{stub})
+		} else {
+			n.legacyResult = cty.SetVal([]cty.Value{stub})
+		}
+		return n.legacyResult
+	}
+	if lv.IsNull() || lv.LengthInt() == 0 {
+		if asList {
+			n.legacyResult = cty.ListValEmpty(block.ImpliedType())
+		} else {
+			n.legacyResult = cty.SetValEmpty(block.ImpliedType())
+		}
+		return n.legacyResult
+	}
+	subVals := make([]cty.Value, 0, lv.LengthInt())
+	for it := lv.ElementIterator(); it.Next(); {
+		_, subVal := it.Element()
+		subVals = append(subVals, n.normalizeLegacyObject(subVal, block))
+	}
+	if asList {
+		n.legacyResult = cty.ListVal(subVals)
+	} else {
+		n.legacyResult = cty.SetVal(subVals)
+	}
+	return n.legacyResult
+}
+
+func (n *NodeAbstractResourceInstance) unknownLegacyBlockStub(schema *configschema.Block) cty.Value {
+	n.legacySchema = schema
+	vals := make(map[string]cty.Value)
+	for name, attrS := range schema.Attributes {
+		vals[name] = cty.UnknownVal(attrS.Type)
+	}
+	for name, blockS := range schema.BlockTypes {
+		switch blockS.Nesting {
+		case configschema.NestingSingle, configschema.NestingGroup:
+			vals[name] = n.unknownLegacyBlockStub(&blockS.Block)
+		case configschema.NestingList:
+			vals[name] = cty.ListVal([]cty.Value{n.unknownLegacyBlockStub(&blockS.Block)})
+		case configschema.NestingSet:
+			vals[name] = cty.SetVal([]cty.Value{n.unknownLegacyBlockStub(&blockS.Block)})
+		case configschema.NestingMap:
+			vals[name] = cty.MapValEmpty(blockS.Block.ImpliedType())
+		}
+	}
+	n.legacyResult = cty.ObjectVal(vals)
+	n.legacyValue = n.legacyResult
+	return n.legacyResult
+}
