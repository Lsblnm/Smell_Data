+var resourceInstanceHelpers = &NodeAbstractResourceInstance{}
+
+func init() {
+	configschema.RegisterValueMarkCollector(
+		func(b *configschema.Block, val cty.Value, path cty.Path) []cty.PathValueMarks {
+			return resourceInstanceHelpers.collectBlockValueMarks(b, val, path)
+		},
+		func(o *configschema.Object, val cty.Value, path cty.Path) []cty.PathValueMarks {
+			return resourceInstanceHelpers.collectObjectValueMarks(o, val, path)
+		},
+	)
+	states.RegisterInstanceObjectEncoder(func(o *states.ResourceInstanceObject, ty cty.Type, schemaVersion uint64) (*states.ResourceInstanceObjectSrc, error) {
+		return resourceInstanceHelpers.encodeInstanceObject(o, ty, schemaVersion)
+	})
+}
+
+func (n *NodeAbstractResourceInstance) collectBlockValueMarks(b *configschema.Block, val cty.Value, path cty.Path) []cty.PathValueMarks {
+	n.markBlock = b
+	n.markValue = val
+	if val.IsNull() {
+		n.markResults = n.blockMarksForNullValue(b, path)
+		return n.markResults
+	}
+	attrMarks := n.collectBlockAttrMarks(b, val, path)
+	nestedMarks := n.collectBlockNestedMarks(b, val, path)
+	n.markResults = n.mergeValueMarks(attrMarks, nestedMarks)
+	return n.markResults
+}
+
+func (n *NodeAbstractResourceInstance) collectBlockAttrMarks(b *configschema.Block, val cty.Value, path cty.Path) []cty.PathValueMarks {
+	n.markBlock = b
+	n.markValue = val
+	var pvm []cty.PathValueMarks
+	if b == nil {
+		n.markResults = pvm
+		return pvm
+	}
+	pvm = append(pvm, n.collectSensitiveAttrMarks(b.Attributes, path)...)
+	if val.IsNull() {
+		n.markResults = pvm
+		return pvm
+	}
+	pvm = append(pvm, n.collectNestedAttributeMarks(b, val, path)...)
+	n.markResults = pvm
+	return pvm
+}
+
+func (n *NodeAbstractResourceInstance) collectBlockNestedMarks(b *configschema.Block, val cty.Value, path cty.Path) []cty.PathValueMarks {
+	n.markBlock = b
+	n.markValue = val
+	var pvm []cty.PathValueMarks
+	if b == nil || val.IsNull() {
+		n.markResults = pvm
+		return pvm
+	}
+	for name, blockS := range b.BlockTypes {
+		if blockS == nil || !blockS.Block.ContainsSensitive() {
+			continue
+		}
+		blockV := val.GetAttr(name)
+		if blockV.IsNull() || !blockV.IsKnown() {
+			continue
+		}
+		blockPath := n.extendMarkPath(path, cty.GetAttrStep{Name: name})
+		pvm = append(pvm, n.collectNestedBlockValueMarks(blockS, blockV, blockPath)...)
+	}
+	n.markResults = pvm
+	return pvm
+}
+
+func (n *NodeAbstractResourceInstance) collectObjectValueMarks(o *configschema.Object, val cty.Value, path cty.Path) []cty.PathValueMarks {
+	n.markObject = o
+	n.markObjVal = val
+	var pvm []cty.PathValueMarks
+	if o == nil || !n.objectValueKnown() {
+		n.markObjResults = pvm
+		return pvm
+	}
+	for name, attrS := range o.Attributes {
+		if attrS == nil {
+			continue
+		}
+		if !attrS.Sensitive && (attrS.NestedType == nil || !attrS.NestedType.ContainsSensitive()) {
+			continue
+		}
+		switch o.Nesting {
+		case configschema.NestingSingle, configschema.NestingGroup:
+			pvm = append(pvm, n.collectObjectSingleMarks(attrS, val.GetAttr(name), n.extendMarkPath(path, cty.GetAttrStep{Name: name}))...)
+		case configschema.NestingList:
+			pvm = append(pvm, n.collectObjectCollectionMarks(name, attrS, val, path)...)
+		case configschema.NestingMap:
+			pvm = append(pvm, n.collectObjectMapMarks(name, attrS, val, path)...)
+		case configschema.NestingSet:
+			pvm = append(pvm, n.collectObjectSetMarks(name, attrS, val, path)...)
+		default:
+			panic(fmt.Sprintf("unsupported nesting mode %s", o.Nesting))
+		}
+	}
+	n.markObjResults = pvm
+	return pvm
+}
+
+func (n *NodeAbstractResourceInstance) collectObjectSingleMarks(attrS *configschema.Attribute, attrVal cty.Value, attrPath cty.Path) []cty.PathValueMarks {
+	n.markObjVal = attrVal
+	var pvm []cty.PathValueMarks
+	if attrS == nil {
+		n.markObjResults = pvm
+		return pvm
+	}
+	if attrS.Sensitive {
+		n.markObjResults = pvm
+		n.appendObjectMark(attrPath)
+		pvm = n.markObjResults
+		return pvm
+	}
+	if attrS.NestedType != nil && attrS.NestedType.ContainsSensitive() {
+		pvm = append(pvm, n.collectObjectValueMarks(attrS.NestedType, attrVal, attrPath)...)
+	}
+	n.markObjResults = pvm
+	return pvm
+}
+
+func (n *NodeAbstractResourceInstance) collectObjectCollectionMarks(name string, attrS *configschema.Attribute, val cty.Value, path cty.Path) []cty.PathValueMarks {
+	n.markObjVal = val
+	var pvm []cty.PathValueMarks
+	if attrS == nil || val.IsNull() || !val.IsKnown() {
+		n.markObjResults = pvm
+		return pvm
+	}
+	for it := val.ElementIterator(); it.Next(); {
+		idx, attrEV := it.Element()
+		attrV := attrEV.GetAttr(name)
+		attrPath := n.extendMarkPath(path, cty.IndexStep{Key: idx}, cty.GetAttrStep{Name: name})
+		if attrS.Sensitive {
+			pvm = append(pvm, newSensitivePathMarks(attrPath))
+			continue
+		}
+		if attrS.NestedType != nil && attrS.NestedType.ContainsSensitive() {
+			pvm = append(pvm, n.collectObjectValueMarks(attrS.NestedType, attrV, attrPath)...)
+		}
+	}
+	n.markObjResults = pvm
+	return pvm
+}
+
+func (n *NodeAbstractResourceInstance) encodeInstanceObject(o *states.ResourceInstanceObject, ty cty.Type, schemaVersion uint64) (*states.ResourceInstanceObjectSrc, error) {
+	n.encodeObj = o
+	n.encodeType = ty
+	src, err := n.marshalInstanceObject(o, ty, schemaVersion)
+	n.encodeSrc = src
+	return src, err
+}
+
+func (n *NodeAbstractResourceInstance) marshalInstanceObject(o *states.ResourceInstanceObject, ty cty.Type, schemaVersion uint64) (*states.ResourceInstanceObjectSrc, error) {
+	n.encodeObj = o
+	n.encodeType = ty
+	val, pvm := n.encodeUnmarkValue(o)
+	src, err := n.encodeMarshalAttrs(val, ty)
+	if err != nil {
+		n.encodeSrc = nil
+		return nil, err
+	}
+	dependencies := n.encodeCopyDependencies(o.Dependencies)
+	encoded := &states.ResourceInstanceObjectSrc{
+		SchemaVersion:       schemaVersion,
+		AttrsJSON:           src,
+		AttrSensitivePaths:  n.encodeSensitivePaths(pvm),
+		Private:             n.encodePrivateCopy(),
+		Status:              n.encodeStatusReady(o),
+		Dependencies:        dependencies,
+		CreateBeforeDestroy: o.CreateBeforeDestroy,
+	}
+	n.encodeSrc = encoded
+	return encoded, nil
+}
+
+func (n *NodeAbstractResourceInstance) encodeCopyDependencies(deps []addrs.ConfigResource) []addrs.ConfigResource {
+	if n.encodeObj != nil {
+		n.encodeType = n.encodeType
+	}
+	dependencies := make([]addrs.ConfigResource, len(deps))
+	copy(dependencies, deps)
+	sort.Slice(dependencies, func(i, j int) bool {
+		return dependencies[i].String() < dependencies[j].String()
+	})
+	if n.encodeSrc != nil {
+		n.encodeSrc.Dependencies = dependencies
+	}
+	return dependencies
+}
+
+func (n *NodeAbstractResourceInstance) captureCheckRules(typ addrs.CheckRuleType, rules []*configs.CheckRule, ctx EvalContext, self addrs.Checkable, keyData instances.RepetitionData, diagSeverity tfdiags.Severity) tfdiags.Diagnostics {
+	n.checkRuleType = typ
+	n.checkRuleList = rules
+	n.checkResults = n.runCheckRules(typ, rules, ctx, self, keyData, diagSeverity)
+	return n.checkResults
+}
+
+func (n *NodeAbstractResourceInstance) runCheckRules(typ addrs.CheckRuleType, rules []*configs.CheckRule, ctx EvalContext, self addrs.Checkable, keyData instances.RepetitionData, diagSeverity tfdiags.Severity) tfdiags.Diagnostics {
+	n.checkRuleType = typ
+	n.checkRuleList = rules
+	var diags tfdiags.Diagnostics
+	checkState := ctx.Checks()
+	if !checkState.ConfigHasChecks(self.ConfigCheckable()) {
+		if ct := len(rules); ct != 0 {
+			panic(fmt.Sprintf("check state says that %s should have no rules, but it has %d", self, ct))
+		}
+		n.checkResults = diags
+		return diags
+	}
+	n.checkRuleList = rules
+	if n.checkRulesEmpty(rules) || !n.checkHasRules() {
+		n.checkResults = nil
+		return nil
+	}
+	severity := diagSeverity.ToHCL()
+	for i, rule := range rules {
+		result, ruleDiags := n.evalCheckRule(addrs.NewCheckRule(self, typ, i), rule, ctx, keyData, severity)
+		diags = diags.Append(ruleDiags)
+		log.Printf("[TRACE] evalCheckRules: %s status is now %s", self, result.Status)
+		if result.Status == checks.StatusFail {
+			checkState.ReportCheckFailure(self, typ, i, result.FailureMessage)
+		} else {
+			checkState.ReportCheckResult(self, typ, i, result.Status)
+		}
+	}
+	n.checkResults = diags
+	return diags
+}
+
+func (n *NodeAbstractResourceInstance) checkRulesEmpty(rules []*configs.CheckRule) bool {
+	n.checkRuleList = rules
+	if len(rules) == 0 {
+		n.checkResults = nil
+		return true
+	}
+	return false
+}
+
+func (n *NodeAbstractResourceInstance) validateCheckRule(addr addrs.CheckRule, rule *configs.CheckRule, ctx EvalContext, keyData instances.RepetitionData) (string, *hcl.EvalContext, tfdiags.Diagnostics) {
+	n.checkRuleAddr = addr
+	n.checkRuleCfg = rule
+	var diags tfdiags.Diagnostics
+	refs, moreDiags := langrefs.ReferencesInExpr(addrs.ParseRef, rule.Condition)
+	diags = diags.Append(moreDiags)
+	moreRefs, moreDiags := langrefs.ReferencesInExpr(addrs.ParseRef, rule.ErrorMessage)
+	diags = diags.Append(moreDiags)
+	refs = append(refs, moreRefs...)
+
+	var selfReference, sourceReference addrs.Referenceable
+	switch addr.Type {
+	case addrs.ResourcePostcondition:
+		switch s := addr.Container.(type) {
+		case addrs.AbsResourceInstance:
+			selfReference = s.Resource
+		default:
+			panic(fmt.Sprintf("Invalid self reference type %t", addr.Container))
+		}
+	case addrs.CheckAssertion:
+		switch s := addr.Container.(type) {
+		case addrs.AbsCheck:
+			sourceReference = s.Check
+		default:
+			panic(fmt.Sprintf("Invalid source reference type %t", addr.Container))
+		}
+	}
+	scope := ctx.EvaluationScope(selfReference, sourceReference, keyData)
+	hclCtx, moreDiags := scope.EvalContext(refs)
+	diags = diags.Append(moreDiags)
+	errorMessage, moreDiags := lang.EvalCheckErrorMessage(rule.ErrorMessage, hclCtx)
+	diags = diags.Append(moreDiags)
+	n.checkMessage = errorMessage
+	return errorMessage, hclCtx, diags
+}
+
+func (n *NodeAbstractResourceInstance) evalCheckRule(addr addrs.CheckRule, rule *configs.CheckRule, ctx EvalContext, keyData instances.RepetitionData, severity hcl.DiagnosticSeverity) (checkResult, tfdiags.Diagnostics) {
+	n.checkRuleAddr = addr
+	n.checkRuleCfg = rule
+	if !n.checkRuleHasCondition() {
+		return checkResult{Status: checks.StatusError}, tfdiags.Diagnostics{}
+	}
+	errorMessage, hclCtx, diags := n.validateCheckRule(addr, rule, ctx, keyData)
+	n.captureCheckMessage(errorMessage)
+	const errInvalidCondition = "Invalid condition result"
+	resultVal, hclDiags := rule.Condition.Value(hclCtx)
+	diags = diags.Append(hclDiags)
+	if diags.HasErrors() {
+		log.Printf("[TRACE] evalCheckRule: %s: %s", addr.Type, diags.Err().Error())
+		return checkResult{Status: checks.StatusError}, diags
+	}
+	if !resultVal.IsKnown() {
+		diags = diags.Append(n.checkUnknownConditionDiag(addr, rule, hclCtx))
+		return checkResult{Status: checks.StatusUnknown}, diags
+	}
+	if resultVal.IsNull() {
+		diags = diags.Append(n.checkNullConditionDiag(rule, hclCtx, errInvalidCondition))
+		return checkResult{Status: checks.StatusError}, diags
+	}
+	var err error
+	resultVal, err = convert.Convert(resultVal, cty.Bool)
+	if err != nil {
+		diags = diags.Append(n.checkInvalidConditionDiag(rule, hclCtx, errInvalidCondition, err))
+		return checkResult{Status: checks.StatusError}, diags
+	}
+	resultVal, _ = resultVal.Unmark()
+	status := n.checkRuleStatus(resultVal)
+	if status != checks.StatusFail {
+		return checkResult{Status: status}, diags
+	}
+	errorMessageForDiags := errorMessage
+	if errorMessageForDiags == "" {
+		errorMessageForDiags = "This check failed, but has an invalid error message as described in the other accompanying messages."
+	}
+	diags = diags.Append(n.checkFailureDiag(addr, rule, hclCtx, severity, errorMessageForDiags))
+	return checkResult{Status: status, FailureMessage: errorMessage}, diags
+}
+
+func (n *NodeAbstractResourceInstance) checkRuleStatus(resultVal cty.Value) checks.Status {
+	n.checkMessage = n.checkMessage
+	if !resultVal.IsKnown() {
+		return checks.StatusUnknown
+	}
+	unmarked, _ := resultVal.Unmark()
+	return checks.StatusForCtyValue(unmarked)
+}
+
+func (n *NodeAbstractResourceInstance) upgradeStoredState(addr addrs.AbsResourceInstance, provider providers.Interface, src *states.ResourceInstanceObjectSrc, currentSchema *configschema.Block, currentVersion uint64) (*states.ResourceInstanceObjectSrc, tfdiags.Diagnostics) {
+	n.upgradeSrc = src
+	n.upgradeSchema = currentSchema
+	if src != nil {
+		n.upgradeJSON = src.AttrsJSON
+	}
+	if !n.upgradeIsManaged(addr) {
+		log.Printf("[ERROR] data resource %s should not require state upgrade", addr)
+		return src, nil
+	}
+	return n.applyStoredStateUpgrade(addr, provider, src, currentSchema, currentVersion)
+}
+
+func (n *NodeAbstractResourceInstance) upgradeIsManaged(addr addrs.AbsResourceInstance) bool {
+	if n.upgradeSrc != nil {
+		n.upgradeJSON = n.upgradeSrc.AttrsJSON
+	}
+	return addr.Resource.Resource.Mode == addrs.ManagedResourceMode
+}
+
+func (n *NodeAbstractResourceInstance) applyStoredStateUpgrade(addr addrs.AbsResourceInstance, provider providers.Interface, src *states.ResourceInstanceObjectSrc, currentSchema *configschema.Block, currentVersion uint64) (*states.ResourceInstanceObjectSrc, tfdiags.Diagnostics) {
+	n.upgradeSrc = src
+	n.upgradeSchema = currentSchema
+	if src != nil {
+		n.upgradeJSON = src.AttrsJSON
+	}
+	if n.upgradeNeedsStrip(src, currentVersion) {
+		src.AttrsJSON = n.upgradeCopyJSON(n.stripRemovedStateAttributes(src.AttrsJSON, currentSchema.ImpliedType()))
+		n.upgradeJSON = src.AttrsJSON
+	}
+
+	stateIsFlatmap := n.upgradeUsesFlatmap(src)
+	providerType := addr.Resource.Resource.ImpliedProvider()
+	if src.SchemaVersion > currentVersion {
+		log.Printf("[TRACE] upgradeResourceState: can't downgrade state for %s from version %d to %d", addr, src.SchemaVersion, currentVersion)
+		var diags tfdiags.Diagnostics
+		diags = diags.Append(tfdiags.Sourceless(
+			tfdiags.Error,
+			"Resource instance managed by newer provider version",
+			fmt.Sprintf("The current state of %s was created by a newer provider version than is currently selected. Upgrade the %s provider to work with this state.", addr, providerType),
+		))
+		return nil, diags
+	}
+
+	if src.SchemaVersion != currentVersion {
+		log.Printf("[TRACE] upgradeResourceState: upgrading state for %s from version %d to %d using provider %q", addr, src.SchemaVersion, currentVersion, providerType)
+	} else {
+		log.Printf("[TRACE] upgradeResourceState: schema version of %s is still %d; calling provider %q for any other minor fixups", addr, currentVersion, providerType)
+	}
+
+	req := n.buildUpgradeRequest(addr, src, stateIsFlatmap)
+	resp := provider.UpgradeResourceState(req)
+	diags := resp.Diagnostics
+	if diags.HasErrors() {
+		return nil, diags
+	}
+	if !resp.UpgradedState.IsWhollyKnown() {
+		diags = diags.Append(n.upgradeUnknownStateDiag(providerType, addr))
+	}
+	newValue := resp.UpgradedState
+	if errs := newValue.Type().TestConformance(currentSchema.ImpliedType()); len(errs) > 0 {
+		diags = diags.Append(n.upgradeConformanceDiags(providerType, addr, errs))
+		return nil, diags
+	}
+	newObj, err := src.CompleteUpgrade(newValue, currentSchema.ImpliedType(), uint64(currentVersion))
+	if err != nil {
+		diags = diags.Append(n.upgradeEncodeFailureDiag(addr, err))
+	}
+	n.upgradeSrc = newObj
+	if newObj != nil {
+		n.upgradeJSON = newObj.AttrsJSON
+	}
+	return newObj, diags
+}
+
+func (n *NodeAbstractResourceInstance) stripRemovedStateAttributes(state []byte, ty cty.Type) []byte {
+	n.upgradeJSON = state
+	n.upgradeType = ty
+	jsonMap := map[string]interface{}{}
+	err := json.Unmarshal(state, &jsonMap)
+	if err != nil {
+		log.Printf("[ERROR] UpgradeResourceState: stripRemovedStateAttributes: %s", err)
+		return state
+	}
+	if !n.removeRemovedAttrs(jsonMap, ty) {
+		return state
+	}
+	js, err := json.Marshal(jsonMap)
+	if err != nil {
+		panic(err)
+	}
+	n.upgradeJSON = js
+	n.upgradeChanged = true
+	return js
+}
+
+func (n *NodeAbstractResourceInstance) removeRemovedAttrs(v interface{}, ty cty.Type) bool {
+	n.upgradeRaw = v
+	n.upgradeType = ty
+	modified := false
+	switch v := v.(type) {
+	case []interface{}:
+		switch {
+		case ty.IsListType() || ty.IsSetType():
+			eTy := ty.ElementType()
+			for _, eV := range v {
+				modified = n.removeRemovedAttrs(eV, eTy) || modified
+			}
+		}
+		n.upgradeChanged = modified
+		return modified
+	case map[string]interface{}:
+		switch {
+		case ty.IsMapType():
+			eTy := ty.ElementType()
+			for _, eV := range v {
+				modified = n.removeRemovedAttrs(eV, eTy) || modified
+			}
+			n.upgradeChanged = modified
+			return modified
+		case ty == cty.DynamicPseudoType:
+			log.Printf("[DEBUG] UpgradeResourceState: ignoring dynamic block: %#v\n", v)
+			n.upgradeChanged = false
+			return false
+		case ty.IsObjectType():
+			attrTypes := ty.AttributeTypes()
+			for attr, attrV := range v {
+				attrTy, ok := attrTypes[attr]
+				if !ok {
+					log.Printf("[DEBUG] UpgradeResourceState: attribute %q no longer present in schema", attr)
+					delete(v, attr)
+					modified = true
+					continue
+				}
+				modified = n.removeRemovedAttrs(attrV, attrTy) || modified
+			}
+			n.upgradeChanged = modified
+			return modified
+		default:
+			log.Printf("[WARN] UpgradeResourceState: unexpected type %#v for map in json state", ty)
+			n.upgradeChanged = false
+			return false
+		}
+	}
+	n.upgradeChanged = modified
+	return modified
+}
+
+func (n *NodeAbstractResourceInstance) upgradeNeedsStrip(src *states.ResourceInstanceObjectSrc, currentVersion uint64) bool {
+	n.upgradeSrc = src
+	if src == nil {
+		n.upgradeChanged = false
+		return false
+	}
+	n.upgradeJSON = src.AttrsJSON
+	return len(src.AttrsJSON) > 0 && src.SchemaVersion == currentVersion
+}
