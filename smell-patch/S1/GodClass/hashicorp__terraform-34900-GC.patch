+func (n *NodeAbstractResourceInstance) proposeNewObject(schema *configschema.Block, prior, config cty.Value) cty.Value {
+	n.captureProposedInputs(schema, prior, config)
+	if n.proposedInputsAreNull(prior, config) || n.proposedConfigMissing(config) {
+		n.changeResult = prior
+		return n.changeResult
+	}
+	if n.changeUsesPrior(prior, config) {
+		n.changeResult = objchange.ProposedNew(schema, prior, config)
+		return n.changeResult
+	}
+	n.changeResult = objchange.ProposedNew(schema, prior, config)
+	return n.changeResult
+}
