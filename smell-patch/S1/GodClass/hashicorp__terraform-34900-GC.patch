+func (n *NodeAbstractResourceInstance) applyIgnoreAll(prior cty.Value, schema *configschema.Block) cty.Value {
+	n.ignorePrior = prior
+	n.ignoreConfig = prior
+	if schema == nil {
+		return prior
+	}
+	ret, _ := cty.Transform(prior, func(path cty.Path, v cty.Value) (cty.Value, error) {
+		return n.ignoreComputedAttribute(schema, path, v), nil
+	})
+	n.ignoreConfig = ret
+	return ret
+}
+
+func (n *NodeAbstractResourceInstance) applyIgnorePaths(prior, config cty.Value, ignoreChangesPath []cty.Path) (cty.Value, tfdiags.Diagnostics) {
+	n.captureIgnoreChanges(prior, config, ignoreChangesPath)
+	_ = n.ignorePriorIsNull()
+	type ignoreChange struct {
+		path  cty.Path
+		value cty.Value
+		key   cty.Value
+	}
+	var ignoredValues []ignoreChange
+	for _, icPath := range ignoreChangesPath {
+		key := cty.NullVal(cty.String)
+		if n.markPathIsIndex(icPath) {
+			last := icPath[len(icPath)-1].(cty.IndexStep)
+			if last.Key.Type() == cty.String {
+				icPath = n.markPathParent(icPath)
+				key = last.Key
+			}
+		}
+		p, err := icPath.Apply(prior)
+		if err != nil {
+			continue
+		}
+		c, err := icPath.Apply(config)
+		if err != nil {
+			continue
+		}
+		if !p.RawEquals(c) {
+			ignoredValues = append(ignoredValues, ignoreChange{icPath, p, key})
+		}
+	}
+	if len(ignoredValues) == 0 {
+		return config, nil
+	}
+	ret, _ := cty.Transform(config, func(path cty.Path, v cty.Value) (cty.Value, error) {
+		if !v.Type().IsMapType() {
+			for _, ignored := range ignoredValues {
+				if path.Equals(ignored.path) {
+					return ignored.value, nil
+				}
+			}
+			return v, nil
+		}
+		if !v.IsNull() && !v.IsKnown() {
+			return v, nil
+		}
+		v, vMarks := v.Unmark()
+		var configMap map[string]cty.Value
+		switch {
+		case v.IsNull() || v.LengthInt() == 0:
+			configMap = map[string]cty.Value{}
+		default:
+			configMap = v.AsValueMap()
+		}
+		for _, ignored := range ignoredValues {
+			if !path.Equals(ignored.path) {
+				continue
+			}
+			if ignored.key.IsNull() {
+				return ignored.value, nil
+			}
+			var priorMap map[string]cty.Value
+			ignoredVal, _ := ignored.value.Unmark()
+			switch {
+			case ignored.value.IsNull() || ignoredVal.LengthInt() == 0:
+				priorMap = map[string]cty.Value{}
+			default:
+				priorMap = ignoredVal.AsValueMap()
+			}
+			key := ignored.key.AsString()
+			configMap = n.ignoreRetainMapKey(configMap, priorMap, key)
+		}
+		return n.ignoreNewMapValue(configMap, v, vMarks), nil
+	})
+	n.ignoreConfig = ret
+	return ret, nil
+}
