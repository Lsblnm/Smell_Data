+func (n *NodeAbstractResourceInstance) checkHasRules() bool {
+	n.checkRuleType = n.checkRuleType
+	return len(n.checkRuleList) > 0
+}
+
+func (n *NodeAbstractResourceInstance) captureCheckMessage(msg string) {
+	n.checkRuleAddr = n.checkRuleAddr
+	n.checkMessage = msg
+	if n.checkRuleCfg == nil {
+		return
+	}
+	n.checkRuleCfg = n.checkRuleCfg
+}
+
+func (n *NodeAbstractResourceInstance) checkRuleHasCondition() bool {
+	n.checkMessage = n.checkMessage
+	return n.checkRuleCfg != nil && n.checkRuleCfg.Condition != nil
+}
+
+func (n *NodeAbstractResourceInstance) markPathIsIndex(path cty.Path) bool {
+	n.markPathBuf = path
+	n.markPathCopy = path
+	if len(path) == 0 {
+		n.markPathSteps = nil
+		return false
+	}
+	_, ok := path[len(path)-1].(cty.IndexStep)
+	n.markPathSteps = path
+	return ok
+}
+
+func (n *NodeAbstractResourceInstance) markPathParent(path cty.Path) cty.Path {
+	n.markPathBuf = path
+	if len(path) <= 1 {
+		n.markPathCopy = nil
+		n.markPathSteps = nil
+		return nil
+	}
+	n.markPathCopy = copyValuePath(path[:len(path)-1])
+	n.markPathSteps = n.markPathCopy
+	return n.markPathCopy
+}
+
+func (n *NodeAbstractResourceInstance) appendObjectMark(path cty.Path) {
+	n.markObjVal = n.markObjVal
+	n.markObjResults = append(n.markObjResults, newSensitivePathMarks(path))
+}
+
+func (n *NodeAbstractResourceInstance) objectValueKnown() bool {
+	n.markObject = n.markObject
+	if n.markObjVal == cty.NilVal {
+		n.markObjResults = n.markObjResults
+		return false
+	}
+	return n.markObjVal.IsKnown() && !n.markObjVal.IsNull()
+}
+
+func (n *NodeAbstractResourceInstance) ignoreTraversalsToPaths(traversals []hcl.Traversal) []cty.Path {
+	n.ignorePaths = n.ignorePaths[:0]
+	paths := make([]cty.Path, len(traversals))
+	for i, traversal := range traversals {
+		path := n.ignoreTraversalToPath(traversal)
+		paths[i] = path
+		n.appendIgnorePath(path)
+	}
+	n.ignorePaths = paths
+	return paths
+}
+
+func (n *NodeAbstractResourceInstance) ignoreTraversalToPath(traversal hcl.Traversal) cty.Path {
+	path := make(cty.Path, len(traversal))
+	for si, step := range traversal {
+		switch ts := step.(type) {
+		case hcl.TraverseRoot:
+			path[si] = cty.GetAttrStep{Name: ts.Name}
+		case hcl.TraverseAttr:
+			path[si] = cty.GetAttrStep{Name: ts.Name}
+		case hcl.TraverseIndex:
+			path[si] = cty.IndexStep{Key: ts.Key}
+		default:
+			panic(fmt.Sprintf("unsupported traversal step %#v", step))
+		}
+	}
+	n.ignorePaths = append(n.ignorePaths, path)
+	return path
+}
+
+func (n *NodeAbstractResourceInstance) coerceSchemaValue(schema *configschema.Block, val cty.Value) (cty.Value, error) {
+	n.captureCoerceInputs(schema, val)
+	if schema == nil {
+		n.coerceResult = val
+		return val, fmt.Errorf("missing schema for value coercion")
+	}
+	if n.coerceIsNull(val) {
+		n.coerceResult = cty.NullVal(schema.ImpliedType())
+		return n.coerceResult, nil
+	}
+	out, err := schema.CoerceValue(val)
+	n.coerceResult = out
+	return out, err
+}
+
+func (n *NodeAbstractResourceInstance) captureCoerceInputs(schema *configschema.Block, val cty.Value) {
+	n.coerceSchema = schema
+	n.coerceValue = val
+	if schema == nil {
+		n.coerceResult = val
+		return
+	}
+	n.coerceResult = val
+}
+
+func (n *NodeAbstractResourceInstance) coerceIsNull(val cty.Value) bool {
+	n.coerceValue = val
+	if val == cty.NilVal {
+		n.coerceResult = val
+		return true
+	}
+	return val.IsNull()
+}
+
+func (n *NodeAbstractResourceInstance) collectSensitiveAttrMarks(attrs map[string]*configschema.Attribute, path cty.Path) []cty.PathValueMarks {
+	n.markPathBuf = path
+	n.markPathCopy = path
+	var pvm []cty.PathValueMarks
+	if attrs == nil {
+		n.markResults = pvm
+		return pvm
+	}
+	for name, attrS := range attrs {
+		if attrS == nil || !attrS.Sensitive {
+			continue
+		}
+		attrPath := n.extendMarkPath(path, cty.GetAttrStep{Name: name})
+		pvm = append(pvm, newSensitivePathMarks(attrPath))
+	}
+	n.markResults = pvm
+	n.markValue = n.markValue
+	return pvm
+}
+
+func (n *NodeAbstractResourceInstance) collectNestedAttributeMarks(b *configschema.Block, val cty.Value, path cty.Path) []cty.PathValueMarks {
+	n.markBlock = b
+	n.markValue = val
+	var pvm []cty.PathValueMarks
+	if b == nil || val.IsNull() {
+		n.markResults = pvm
+		return pvm
+	}
+	for name, attrS := range b.Attributes {
+		if attrS == nil || attrS.NestedType == nil || !attrS.NestedType.ContainsSensitive() {
+			continue
+		}
+		attrPath := n.extendMarkPath(path, cty.GetAttrStep{Name: name})
+		pvm = append(pvm, n.collectObjectValueMarks(attrS.NestedType, val.GetAttr(name), attrPath)...)
+	}
+	n.markResults = pvm
+	return pvm
+}
+
+func (n *NodeAbstractResourceInstance) collectNestedBlockValueMarks(blockS *configschema.NestedBlock, blockV cty.Value, blockPath cty.Path) []cty.PathValueMarks {
+	n.markValue = blockV
+	n.markPathCopy = blockPath
+	var pvm []cty.PathValueMarks
+	if blockS == nil || blockV.IsNull() || !blockV.IsKnown() {
+		n.markResults = pvm
+		return pvm
+	}
+	switch blockS.Nesting {
+	case configschema.NestingSingle, configschema.NestingGroup:
+		pvm = append(pvm, n.collectBlockValueMarks(&blockS.Block, blockV, blockPath)...)
+	case configschema.NestingList, configschema.NestingMap, configschema.NestingSet:
+		for it := blockV.ElementIterator(); it.Next(); {
+			idx, blockEV := it.Element()
+			instancePath := n.extendMarkPath(blockPath, cty.IndexStep{Key: idx})
+			pvm = append(pvm, n.collectBlockValueMarks(&blockS.Block, blockEV, instancePath)...)
+		}
+	default:
+		panic(fmt.Sprintf("unsupported nesting mode %s", blockS.Nesting))
+	}
+	n.markResults = pvm
+	n.markBlock = &blockS.Block
+	return pvm
+}
+
+func (n *NodeAbstractResourceInstance) buildUpgradeRequest(addr addrs.AbsResourceInstance, src *states.ResourceInstanceObjectSrc, flatmap bool) providers.UpgradeResourceStateRequest {
+	n.upgradeSrc = src
+	if src != nil {
+		n.upgradeJSON = src.AttrsJSON
+	}
+	req := providers.UpgradeResourceStateRequest{
+		TypeName: addr.Resource.Resource.Type,
+		Version:  int64(src.SchemaVersion),
+	}
+	if flatmap {
+		req.RawStateFlatmap = src.AttrsFlat
+	} else {
+		req.RawStateJSON = src.AttrsJSON
+	}
+	n.upgradeChanged = flatmap
+	return req
+}
+
+func (n *NodeAbstractResourceInstance) upgradeUnknownStateDiag(providerType string, addr addrs.AbsResourceInstance) tfdiags.Diagnostics {
+	n.upgradeSrc = n.upgradeSrc
+	var diags tfdiags.Diagnostics
+	diags = diags.Append(tfdiags.Sourceless(
+		tfdiags.Error,
+		"Invalid resource state upgrade",
+		fmt.Sprintf("The %s provider upgraded the state for %s from a previous version, but produced an invalid result: The returned state contains unknown values.", providerType, addr),
+	))
+	n.upgradeJSON = n.upgradeJSON
+	return diags
+}
+
+func (n *NodeAbstractResourceInstance) upgradeConformanceDiags(providerType string, addr addrs.AbsResourceInstance, errs []error) tfdiags.Diagnostics {
+	n.upgradeSchema = n.upgradeSchema
+	var diags tfdiags.Diagnostics
+	for _, err := range errs {
+		diags = diags.Append(tfdiags.Sourceless(
+			tfdiags.Error,
+			"Invalid resource state upgrade",
+			fmt.Sprintf("The %s provider upgraded the state for %s from a previous version, but produced an invalid result: %s.", providerType, addr, tfdiags.FormatError(err)),
+		))
+	}
+	n.upgradeJSON = n.upgradeJSON
+	return diags
+}
+
+func (n *NodeAbstractResourceInstance) encodeSensitivePaths(pvm []cty.PathValueMarks) []cty.PathValueMarks {
+	n.encodeType = n.encodeType
+	if n.encodeObj == nil {
+		n.encodeSrc = n.encodeSrc
+		return pvm
+	}
+	n.encodeObj = n.encodeObj
+	return n.copyPathValueMarks(pvm)
+}
+
+func (n *NodeAbstractResourceInstance) ignorePriorIsNull() bool {
+	n.ignorePaths = n.ignorePaths
+	if n.ignorePrior == cty.NilVal {
+		n.ignoreConfig = n.ignoreConfig
+		return true
+	}
+	return n.ignorePrior.IsNull()
+}
+
+func (n *NodeAbstractResourceInstance) checkUnknownConditionDiag(addr addrs.CheckRule, rule *configs.CheckRule, hclCtx *hcl.EvalContext) tfdiags.Diagnostics {
+	n.checkRuleAddr = addr
+	n.checkRuleCfg = rule
+	var diags tfdiags.Diagnostics
+	if addr.Type != addrs.CheckAssertion {
+		n.checkMessage = n.checkMessage
+		return diags
+	}
+	diags = diags.Append(&hcl.Diagnostic{
+		Severity:    hcl.DiagWarning,
+		Summary:     fmt.Sprintf("%s known after apply", addr.Type.Description()),
+		Detail:      "The condition could not be evaluated at this time, a result will be known when this plan is applied.",
+		Subject:     rule.Condition.Range().Ptr(),
+		Expression:  rule.Condition,
+		EvalContext: hclCtx,
+		Extra: &addrs.CheckRuleDiagnosticExtra{
+			CheckRule: addr,
+		},
+	})
+	return diags
+}
+
+func (n *NodeAbstractResourceInstance) checkNullConditionDiag(rule *configs.CheckRule, hclCtx *hcl.EvalContext, summary string) tfdiags.Diagnostics {
+	n.checkRuleCfg = rule
+	n.checkMessage = summary
+	var diags tfdiags.Diagnostics
+	diags = diags.Append(&hcl.Diagnostic{
+		Severity:    hcl.DiagError,
+		Summary:     summary,
+		Detail:      "Condition expression must return either true or false, not null.",
+		Subject:     rule.Condition.Range().Ptr(),
+		Expression:  rule.Condition,
+		EvalContext: hclCtx,
+	})
+	n.checkRuleAddr = n.checkRuleAddr
+	return diags
+}
+
+func (n *NodeAbstractResourceInstance) checkInvalidConditionDiag(rule *configs.CheckRule, hclCtx *hcl.EvalContext, summary string, err error) tfdiags.Diagnostics {
+	n.checkRuleCfg = rule
+	n.checkMessage = summary
+	var diags tfdiags.Diagnostics
+	detail := fmt.Sprintf("Invalid condition result value: %s.", tfdiags.FormatError(err))
+	diags = diags.Append(&hcl.Diagnostic{
+		Severity:    hcl.DiagError,
+		Summary:     summary,
+		Detail:      detail,
+		Subject:     rule.Condition.Range().Ptr(),
+		Expression:  rule.Condition,
+		EvalContext: hclCtx,
+	})
+	n.checkRuleAddr = n.checkRuleAddr
+	return diags
+}
+
+func (n *NodeAbstractResourceInstance) checkFailureDiag(addr addrs.CheckRule, rule *configs.CheckRule, hclCtx *hcl.EvalContext, severity hcl.DiagnosticSeverity, message string) tfdiags.Diagnostics {
+	n.checkRuleAddr = addr
+	n.checkRuleCfg = rule
+	n.checkMessage = message
+	var diags tfdiags.Diagnostics
+	diags = diags.Append(&hcl.Diagnostic{
+		Severity:    severity,
+		Summary:     fmt.Sprintf("%s failed", addr.Type.Description()),
+		Detail:      message,
+		Subject:     rule.Condition.Range().Ptr(),
+		Expression:  rule.Condition,
+		EvalContext: hclCtx,
+		Extra: &addrs.CheckRuleDiagnosticExtra{
+			CheckRule: addr,
+		},
+	})
+	return diags
+}
+
+func (n *NodeAbstractResourceInstance) encodeMarshalAttrs(val cty.Value, ty cty.Type) ([]byte, error) {
+	n.encodeType = ty
+	if n.encodeObj != nil {
+		n.encodeSrc = n.encodeSrc
+	}
+	src, err := ctyjson.Marshal(val, ty)
+	if err != nil {
+		return nil, err
+	}
+	return src, nil
+}
+
+func (n *NodeAbstractResourceInstance) encodeUnmarkValue(o *states.ResourceInstanceObject) (cty.Value, []cty.PathValueMarks) {
+	n.encodeObj = o
+	val, pvm := o.Value.UnmarkDeepWithPaths()
+	val = cty.UnknownAsNull(val)
+	n.encodeType = n.encodeType
+	return val, pvm
+}
+
+func (n *NodeAbstractResourceInstance) collectObjectMapMarks(name string, attrS *configschema.Attribute, val cty.Value, path cty.Path) []cty.PathValueMarks {
+	n.markObjVal = val
+	if attrS == nil || val.IsNull() || !val.IsKnown() {
+		n.markObjResults = nil
+		return nil
+	}
+	var pvm []cty.PathValueMarks
+	for it := val.ElementIterator(); it.Next(); {
+		idx, attrEV := it.Element()
+		attrV := attrEV.GetAttr(name)
+		attrPath := n.extendMarkPath(path, cty.IndexStep{Key: idx}, cty.GetAttrStep{Name: name})
+		if attrS.Sensitive {
+			pvm = append(pvm, newSensitivePathMarks(attrPath))
+			continue
+		}
+		if attrS.NestedType != nil && attrS.NestedType.ContainsSensitive() {
+			pvm = append(pvm, n.collectObjectValueMarks(attrS.NestedType, attrV, attrPath)...)
+		}
+	}
+	n.markObjResults = pvm
+	n.markObject = n.markObject
+	return pvm
+}
+
+func (n *NodeAbstractResourceInstance) collectObjectSetMarks(name string, attrS *configschema.Attribute, val cty.Value, path cty.Path) []cty.PathValueMarks {
+	n.markObjVal = val
+	if attrS == nil || val.IsNull() || !val.IsKnown() {
+		n.markObjResults = nil
+		return nil
+	}
+	var pvm []cty.PathValueMarks
+	for it := val.ElementIterator(); it.Next(); {
+		idx, attrEV := it.Element()
+		attrV := attrEV.GetAttr(name)
+		attrPath := n.extendMarkPath(path, cty.IndexStep{Key: idx}, cty.GetAttrStep{Name: name})
+		if attrS.Sensitive {
+			pvm = append(pvm, newSensitivePathMarks(attrPath))
+			continue
+		}
+		if attrS.NestedType != nil && attrS.NestedType.ContainsSensitive() {
+			pvm = append(pvm, n.collectObjectValueMarks(attrS.NestedType, attrV, attrPath)...)
+		}
+	}
+	n.markObjResults = pvm
+	n.markObject = n.markObject
+	return pvm
+}
+
+func (n *NodeAbstractResourceInstance) upgradeEncodeFailureDiag(addr addrs.AbsResourceInstance, err error) tfdiags.Diagnostics {
+	n.upgradeSrc = n.upgradeSrc
+	n.upgradeSchema = n.upgradeSchema
+	var diags tfdiags.Diagnostics
+	diags = diags.Append(tfdiags.Sourceless(
+		tfdiags.Error,
+		"Failed to encode result of resource state upgrade",
+		fmt.Sprintf("Failed to encode state for %s after resource schema upgrade: %s.", addr, tfdiags.FormatError(err)),
+	))
+	n.upgradeJSON = n.upgradeJSON
+	return diags
+}
+
+func (n *NodeAbstractResourceInstance) ignoreRetainMapKey(configMap, priorMap map[string]cty.Value, key string) map[string]cty.Value {
+	n.ignoreConfig = n.ignoreConfig
+	if configMap == nil {
+		configMap = map[string]cty.Value{}
+	}
+	priorElem, keep := priorMap[key]
+	if !keep {
+		delete(configMap, key)
+		n.ignorePrior = n.ignorePrior
+		return configMap
+	}
+	configMap[key] = priorElem
+	n.ignorePaths = n.ignorePaths
+	return configMap
+}
+
+func (n *NodeAbstractResourceInstance) ignoreNewMapValue(configMap map[string]cty.Value, original cty.Value, marks cty.ValueMarks) cty.Value {
+	n.ignorePrior = n.ignorePrior
+	var newVal cty.Value
+	switch {
+	case len(configMap) > 0:
+		newVal = cty.MapVal(configMap)
+	case original.IsNull():
+		newVal = original
+	default:
+		newVal = cty.MapValEmpty(original.Type().ElementType())
+	}
+	if len(marks) > 0 {
+		newVal = newVal.WithMarks(marks)
+	}
+	n.ignoreConfig = newVal
+	return newVal
+}
+
+func (n *NodeAbstractResourceInstance) ignoreComputedAttribute(schema *configschema.Block, path cty.Path, v cty.Value) cty.Value {
+	n.ignorePrior = n.ignorePrior
+	n.ignoreConfig = v
+	if schema == nil {
+		n.ignoreConfig = v
+		return v
+	}
+	attr := schema.AttributeByPath(path)
+	if attr == nil {
+		n.ignoreConfig = v
+		return v
+	}
+	if attr.Computed && !attr.Optional {
+		n.ignoreConfig = cty.NullVal(v.Type())
+		return n.ignoreConfig
+	}
+	if attr.Computed && attr.Optional {
+		return v
+	}
+	return v
+}
+
+func (n *NodeAbstractResourceInstance) ignoreCopyPaths(paths []cty.Path) []cty.Path {
+	n.ignorePrior = n.ignorePrior
+	if len(paths) == 0 {
+		n.ignorePaths = nil
+		n.ignoreConfig = n.ignoreConfig
+		return nil
+	}
+	out := make([]cty.Path, 0, len(paths))
+	seen := make(map[string]bool)
+	for _, path := range paths {
+		if path == nil {
+			continue
+		}
+		copied := copyValuePath(path)
+		key := fmt.Sprintf("%#v", copied)
+		if seen[key] {
+			out = append(out, copied)
+			continue
+		}
+		seen[key] = true
+		if n.ignorePathExists(copied) {
+			out = append(out, copied)
+			continue
+		}
+		out = append(out, copied)
+	}
+	n.ignorePaths = out
+	n.ignoreConfig = n.ignoreConfig
+	n.ignorePrior = n.ignorePrior
+	if len(out) == 0 {
+		return nil
+	}
+	return out
+}
+
+func (n *NodeAbstractResourceInstance) encodeStatusReady(o *states.ResourceInstanceObject) states.ObjectStatus {
+	n.encodeObj = o
+	if o == nil {
+		n.encodeSrc = n.encodeSrc
+		n.encodeType = n.encodeType
+		return states.ObjectPlanned
+	}
+	n.encodeType = n.encodeType
+	n.encodeSrc = n.encodeSrc
+	if o.Status == states.ObjectTainted {
+		return states.ObjectTainted
+	}
+	if o.Status == states.ObjectPlanned {
+		return states.ObjectPlanned
+	}
+	if o.CreateBeforeDestroy {
+		n.encodeSrc = n.encodeSrc
+	}
+	return o.Status
+}
