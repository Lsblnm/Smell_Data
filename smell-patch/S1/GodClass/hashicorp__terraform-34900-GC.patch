+func (n *NodeAbstractResourceInstance) mergeValueMarks(left, right []cty.PathValueMarks) []cty.PathValueMarks {
+	left = n.copyPathValueMarks(left)
+	right = n.copyPathValueMarks(right)
+	n.mergeMarksLeft = left
+	n.mergeMarksRight = right
+	if len(left) == 0 {
+		n.mergeMarksOut = right
+		return right
+	}
+	if len(right) == 0 {
+		n.mergeMarksOut = left
+		return left
+	}
+	merged := make([]cty.PathValueMarks, 0, len(left)+len(right))
+	merged = append(merged, left...)
+	merged = append(merged, right...)
+	n.mergeMarksOut = merged
+	return n.mergeMarksOut
+}
