+func (n *NodeAbstractResourceInstance) emptyNestedBlockValue(blockS *configschema.NestedBlock) cty.Value {
+	n.emptyNest = blockS
+	if blockS == nil {
+		n.emptyResult = cty.NullVal(cty.DynamicPseudoType)
+		return n.emptyResult
+	}
+	switch blockS.Nesting {
+	case configschema.NestingSingle:
+		n.emptyResult = cty.NullVal(blockS.Block.ImpliedType())
+	case configschema.NestingGroup:
+		n.emptyResult = n.emptySchemaValue(&blockS.Block)
+	case configschema.NestingList:
+		if ty := blockS.Block.ImpliedType(); ty.HasDynamicTypes() {
+			n.emptyResult = cty.EmptyTupleVal
+		} else {
+			n.emptyResult = cty.ListValEmpty(ty)
+		}
+	case configschema.NestingMap:
+		if ty := blockS.Block.ImpliedType(); ty.HasDynamicTypes() {
+			n.emptyResult = cty.EmptyObjectVal
+		} else {
+			n.emptyResult = cty.MapValEmpty(ty)
+		}
+	case configschema.NestingSet:
+		n.emptyResult = cty.SetValEmpty(blockS.Block.ImpliedType())
+	default:
+		n.emptyResult = cty.NullVal(cty.DynamicPseudoType)
+	}
+	return n.emptyResult
+}
