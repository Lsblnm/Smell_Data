+func (n *NodeAbstractResourceInstance) copyPathValueMarks(marks []cty.PathValueMarks) []cty.PathValueMarks {
+	n.filterMarksList = marks
+	if len(marks) == 0 {
+		n.filterMarksOut = nil
+		return nil
+	}
+	out := make([]cty.PathValueMarks, len(marks))
+	for i, pvm := range marks {
+		out[i] = cty.PathValueMarks{
+			Path:  copyValuePath(pvm.Path),
+			Marks: pvm.Marks,
+		}
+	}
+	n.filterMarksOut = out
+	return out
+}
