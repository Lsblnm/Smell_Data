+fn qualified_segments_match(segments: &[String], patterns: &[&[&str]]) -> bool {
+    patterns.iter().any(|pattern| {
+        segments.len() == pattern.len()
+            && segments
+                .iter()
+                .zip(pattern.iter().copied())
+                .all(|(segment, expected)| segment == expected)
+    })
+}
+
+impl<'a> Checker<'a> {
+    pub(crate) fn pickle_deserialize_call(&self, segments: &[String]) -> bool {
+        let key = if segments.is_empty() {
+            String::new()
+        } else if segments.len() == 1 {
+            segments[0].clone()
+        } else {
+            segments.join(".")
+        };
+        if let Some(cached) = self.pickle_deserialize_cache.borrow().get(&key).copied() {
+            return cached;
+        }
+        let mut matched = qualified_segments_match(
+            segments,
+            &[
+            &["pickle", "load"],
+            &["pickle", "loads"],
+            &["pickle", "Unpickler"],
+            &["dill", "load"],
+            &["dill", "loads"],
+            &["dill", "Unpickler"],
+            &["shelve", "open"],
+            &["shelve", "DbfilenameShelf"],
+            &["jsonpickle", "decode"],
+            &["pandas", "read_pickle"],
+            &["jsonpickle", "unpickler", "decode"]
+            ],
+        );
+        if matched {
+            let first = segments[0].as_str();
+            let excluded = [
+                self.module_name_is_private(first),
+                self.class_name_is_private(first),
+                self.function_name_is_private(first),
+                self.function_name_is_test(first),
+                self.pathlib_os_function_name(segments),
+                self.stdlib_generic_qualified_name(segments),
+                self.mutable_constructor_qualified_name(segments),
+                self.immutable_constructor_qualified_name(segments),
+                self.pep585_generic_rewrite_pair(segments),
+                self.typed_dict_qualified_name(segments),
+                self.staticmethod_decorator_name(segments),
+                self.classmethod_decorator_name(segments),
+                self.abstract_decorator_name(segments),
+                self.immutable_nongeneric_qualified_name(segments),
+                self.immutable_generic_qualified_name(segments),
+            ];
+            if excluded.iter().any(|value| *value) {
+                matched = false;
+            }
+        }
+        self.pickle_deserialize_cache.borrow_mut().insert(key, matched);
+        matched
+    }
