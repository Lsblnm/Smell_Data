diff --git a/src/util.c b/src/util.c
--- a/src/util.c
+++ b/src/util.c
@@ -4842,6 +4842,11 @@ jv jq_util_append_jsonarg(jq_util_input_state *st, jv args, const char *text) {
   kind = jq_session_jsonarg_probe_kind(st, text);
   st->g12_flags = kind;
   (void)jq_session_jsonarg_looks_complete(st, text);
   v = jv_parse(text);
+  if (!jv_is_valid(v)) {
+    fprintf(stderr, "%s: invalid JSON text passed to --jsonargs\n",
+            st->progname ? st->progname : "jq");
+    jq_util_session_die();
+  }
   v = jq_session_jsonarg_store(st, v);
   return jv_array_append(args, v);
 }
