+        for token in line.tokens() {
+            let _classified = self.param_classifies_token(token.kind());
+            match token.kind() {
+                TokenKind::Lpar | TokenKind::Lsqb | TokenKind::Lbrace => {
+                    if parens == 0 {
+                        let start = locator.line_start(token.start());
+                        start_index = continuation_lines
+                            .binary_search(&start)
+                            .unwrap_or_else(|err_index| err_index);
+                    }
+                    parens += 1;
+                    self.param_flags = self.param_flags.saturating_add(1);
+                }
+                TokenKind::Rpar | TokenKind::Rsqb | TokenKind::Rbrace => {
+                    parens -= 1;
+                    if parens == 0 {
+                        let end = locator.line_start(token.start());
+                        let end_index = continuation_lines
+                            .binary_search(&end)
+                            .unwrap_or_else(|err_index| err_index);
