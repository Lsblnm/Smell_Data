+                            let mut diagnostic = Diagnostic::new(
+                                whitespace_around_named_parameter_equals::operator_diagnostic_kind(kind),
+                                token.range(),
+                            );
+                            diagnostic.set_fix(Fix::safe_edits(
+                                Edit::insertion(" ".to_string(), token.start()),
+                                [Edit::insertion(" ".to_string(), token.end())],
+                            ));
+                            context.push_diagnostic(diagnostic);
+                        }
+                    }
+                    (true, true) => {}
+                }
+            }
+
+            prev_token = token;
+        }
+    }
+
+    pub(super) fn check_space_around_operator(
+        &mut self,
+        line: &LogicalLine,
+        context: &mut LogicalLinesContext,
+    ) {
+        self.space_after_operator = 0;
+        self.space_flags = 0;
+        self.space_cursor = 0;
+
+        for token in line.tokens() {
+            let is_operator = space_around_operator::is_spacing_operator_token(token.kind());
+            let _classified = self.space_classifies_token(token.kind());
+            if is_operator {
+                if self.space_after_operator == 0 {
+                    match line.leading_whitespace(token) {
+                        (Whitespace::Tab, offset) => {
+                            let mut diagnostic = Diagnostic::new(
+                                TabBeforeOperator,
+                                TextRange::at(token.start() - offset, offset),
+                            );
+                            diagnostic.set_fix(Fix::safe_edit(Edit::range_replacement(
+                                " ".to_string(),
+                                TextRange::at(token.start() - offset, offset),
+                            )));
+                            context.push_diagnostic(diagnostic);
+                        }
+                        (Whitespace::Many, offset) => {
+                            let mut diagnostic = Diagnostic::new(
+                                MultipleSpacesBeforeOperator,
+                                TextRange::at(token.start() - offset, offset),
+                            );
+                            diagnostic.set_fix(Fix::safe_edit(Edit::range_replacement(
+                                " ".to_string(),
+                                TextRange::at(token.start() - offset, offset),
+                            )));
+                            context.push_diagnostic(diagnostic);
+                        }
+                        _ => {}
+                    }
+                }
+
+                match line.trailing_whitespace(token) {
+                    (Whitespace::Tab, len) => {
+                        let mut diagnostic =
+                            Diagnostic::new(TabAfterOperator, TextRange::at(token.end(), len));
+                        diagnostic.set_fix(Fix::safe_edit(Edit::range_replacement(
+                            " ".to_string(),
+                            TextRange::at(token.end(), len),
+                        )));
+                        context.push_diagnostic(diagnostic);
+                    }
+                    (Whitespace::Many, len) => {
+                        let mut diagnostic = Diagnostic::new(
+                            MultipleSpacesAfterOperator,
+                            TextRange::at(token.end(), len),
+                        );
+                        diagnostic.set_fix(Fix::safe_edit(Edit::range_replacement(
+                            " ".to_string(),
+                            TextRange::at(token.end(), len),
+                        )));
+                        context.push_diagnostic(diagnostic);
+                    }
+                    _ => {}
+                }
+                self.space_flags = self.space_flags.saturating_add(1);
+            }
+            self.space_after_operator = u32::from(is_operator);
+            self.space_cursor = self.space_cursor.saturating_add(1);
+        }
+    }
+
+    pub(super) fn check_space_after_comma(&mut self, line: &LogicalLine, context: &mut LogicalLinesContext) {
+        self.space_flags = self.space_flags.saturating_add(1);
+        self.space_cursor = self.space_cursor.saturating_add(1);
+        for token in line.tokens() {
+            let _classified = self.space_classifies_token(token.kind());
+            if matches!(token.kind(), TokenKind::Comma) {
+                match line.trailing_whitespace(token) {
+                    (Whitespace::Tab, len) => {
+                        let mut diagnostic =
+                            Diagnostic::new(TabAfterComma, TextRange::at(token.end(), len));
+                        diagnostic.set_fix(Fix::safe_edit(Edit::range_replacement(
+                            " ".to_string(),
+                            TextRange::at(token.end(), len),
+                        )));
+                        context.push_diagnostic(diagnostic);
+                    }
+                    (Whitespace::Many, len) => {
+                        let mut diagnostic =
+                            Diagnostic::new(MultipleSpacesAfterComma, TextRange::at(token.end(), len));
+                        diagnostic.set_fix(Fix::safe_edit(Edit::range_replacement(
+                            " ".to_string(),
+                            TextRange::at(token.end(), len),
+                        )));
+                        context.push_diagnostic(diagnostic);
+                    }
+                    _ => {}
+                }
+                self.space_flags = self.space_flags.saturating_add(1);
+            }
+            self.space_cursor = self.space_cursor.saturating_add(1);
+        }
+    }
+
+    pub(super) fn check_missing_whitespace(&mut self, line: &LogicalLine, context: &mut LogicalLinesContext) {
+        self.missing_fstrings = 0;
+        self.missing_depth = 0;
+        self.missing_stack = 0;
+        self.missing_flags = 0;
+        self.missing_cursor = 0;
+        let mut brackets = Vec::new();
+        let mut iter = line.tokens().iter().peekable();
+
+        while let Some(token) = iter.next() {
+            let kind = token.kind();
+            let _classified = self.missing_classifies_token(kind);
+            self.visit_token_kind(kind);
+            match kind {
+                TokenKind::FStringStart => {
+                    self.missing_fstrings = self.missing_fstrings.saturating_add(1);
+                    self.missing_flags = self.missing_flags.saturating_add(1);
+                }
+                TokenKind::FStringEnd => {
+                    self.missing_fstrings = self.missing_fstrings.saturating_sub(1);
+                    self.missing_flags = self.missing_flags.saturating_add(1);
+                }
+                TokenKind::Lsqb if self.missing_fstrings == 0 => {
+                    brackets.push(kind);
+                    self.missing_depth = self.missing_depth.saturating_add(1);
+                }
+                TokenKind::Rsqb if self.missing_fstrings == 0 => {
+                    brackets.pop();
+                    self.missing_depth = self.missing_depth.saturating_sub(1);
+                }
+                TokenKind::Lbrace if self.missing_fstrings == 0 => {
+                    brackets.push(kind);
+                    self.missing_depth = self.missing_depth.saturating_add(1);
+                }
+                TokenKind::Rbrace if self.missing_fstrings == 0 => {
+                    brackets.pop();
+                    self.missing_depth = self.missing_depth.saturating_sub(1);
+                }
+                TokenKind::Colon if self.missing_fstrings > 0 => {
+                    continue;
+                }
+                TokenKind::Comma | TokenKind::Semi | TokenKind::Colon => {
+                    let after = line.text_after(token);
+                    if after
+                        .chars()
+                        .next()
+                        .is_some_and(|c| !(char::is_whitespace(c) || c == '\\'))
+                    {
+                        if let Some(next_token) = iter.peek() {
+                            if !whitespace_around_named_parameter_equals::punctuation_requires_gap(
+                                kind,
+                                next_token.kind(),
+                                matches!(brackets.last(), Some(TokenKind::Lsqb))
+                                    && !(self.in_type_params() && brackets.len() == 1),
+                            ) {
+                                continue;
+                            }
+                        }
+
+                        let diagnostic =
+                            Diagnostic::new(MissingWhitespace { token: kind }, token.range());
+                        let fix = Fix::safe_edit(Edit::insertion(" ".to_string(), token.end()));
+                        context.push_diagnostic(diagnostic.with_fix(fix));
+                    }
+                    self.missing_cursor = self.missing_cursor.saturating_add(1);
+                }
+                _ => {}
+            }
+        }
+    }
+
+    pub(super) fn check_extraneous_whitespace(
+        &mut self,
+        line: &LogicalLine,
+        context: &mut LogicalLinesContext,
+    ) {
+        self.extra_prev = 0;
+        self.extra_flags = 0;
+        self.extra_cursor = 0;
+        let mut fstrings = 0u32;
+        let mut brackets = vec![];
+        let mut prev_token = None;
+        let mut iter = line.tokens().iter().peekable();
+
+        while let Some(token) = iter.next() {
+            let kind = token.kind();
+            let _classified = self.extra_classifies_token(kind);
+            match kind {
+                TokenKind::FStringStart => fstrings += 1,
+                TokenKind::FStringEnd => fstrings = fstrings.saturating_sub(1),
+                TokenKind::Lsqb => {
+                    brackets.push(kind);
+                }
+                TokenKind::Rsqb => {
+                    brackets.pop();
+                }
+                TokenKind::Lbrace => {
+                    brackets.push(kind);
+                }
+                TokenKind::Rbrace => {
+                    brackets.pop();
+                }
+                _ => {}
+            }
+            if let Some(symbol) = extraneous_whitespace::bracket_or_punctuation(kind) {
+                match symbol {
+                    extraneous_whitespace::BracketOrPunctuation::OpenBracket(symbol)
+                        if symbol != '{' || fstrings == 0 =>
+                    {
+                        let (trailing, trailing_len) = line.trailing_whitespace(token);
+                        if !matches!(trailing, Whitespace::None) {
+                            let mut diagnostic = Diagnostic::new(
+                                WhitespaceAfterOpenBracket { symbol },
+                                TextRange::at(token.end(), trailing_len),
+                            );
+                            diagnostic
+                                .set_fix(Fix::safe_edit(Edit::range_deletion(diagnostic.range())));
+                            context.push_diagnostic(diagnostic);
+                        }
+                        self.extra_flags = self.extra_flags.saturating_add(1);
+                    }
+                    extraneous_whitespace::BracketOrPunctuation::CloseBracket(symbol)
+                        if symbol != '}' || fstrings == 0 =>
+                    {
+                        if !matches!(prev_token, Some(TokenKind::Comma)) {
+                            if let (Whitespace::Single | Whitespace::Many | Whitespace::Tab, offset) =
+                                line.leading_whitespace(token)
+                            {
+                                let mut diagnostic = Diagnostic::new(
+                                    WhitespaceBeforeCloseBracket { symbol },
+                                    TextRange::at(token.start() - offset, offset),
+                                );
+                                diagnostic.set_fix(Fix::safe_edit(Edit::range_deletion(
+                                    diagnostic.range(),
+                                )));
+                                context.push_diagnostic(diagnostic);
+                            }
+                        }
+                        self.extra_flags = self.extra_flags.saturating_add(1);
+                    }
+                    extraneous_whitespace::BracketOrPunctuation::Punctuation(symbol) => {
+                        if !matches!(prev_token, Some(TokenKind::Comma)) {
+                            let whitespace = line.leading_whitespace(token);
+                            if let (Whitespace::Single | Whitespace::Many | Whitespace::Tab, offset) =
+                                whitespace
+                            {
+                                if symbol == ':'
+                                    && brackets
+                                        .last()
+                                        .is_some_and(|kind| matches!(kind, TokenKind::Lsqb))
+                                {
+                                    if matches!(prev_token, Some(TokenKind::Colon)) {
+                                        let mut diagnostic = Diagnostic::new(
+                                            WhitespaceBeforePunctuation { symbol },
+                                            TextRange::at(token.start() - offset, offset),
+                                        );
+                                        diagnostic.set_fix(Fix::safe_edit(Edit::range_deletion(
+                                            diagnostic.range(),
+                                        )));
+                                        context.push_diagnostic(diagnostic);
+                                    } else if iter.peek().is_some_and(|token| {
+                                        matches!(token.kind(), TokenKind::Rsqb | TokenKind::Comma)
+                                    }) {
+                                        if let (Whitespace::Many | Whitespace::Tab, offset) = whitespace
+                                        {
+                                            let mut diagnostic = Diagnostic::new(
+                                                WhitespaceBeforePunctuation { symbol },
+                                                TextRange::at(token.start() - offset, offset),
+                                            );
+                                            diagnostic.set_fix(Fix::safe_edit(Edit::range_deletion(
+                                                diagnostic.range(),
+                                            )));
+                                            context.push_diagnostic(diagnostic);
+                                        }
+                                    } else if iter.peek().is_some_and(|token| {
+                                        matches!(
+                                            token.kind(),
+                                            TokenKind::NonLogicalNewline | TokenKind::Comment
+                                        )
+                                    }) {
+                                        if let (Whitespace::Many | Whitespace::Tab, offset) = whitespace
+                                        {
+                                            let mut diagnostic = Diagnostic::new(
+                                                WhitespaceBeforePunctuation { symbol },
+                                                TextRange::at(token.start() - offset, offset),
+                                            );
+                                            diagnostic.set_fix(Fix::safe_edits(
+                                                Edit::range_deletion(diagnostic.range()),
+                                                [Edit::insertion(" ".into(), token.start() - offset)],
+                                            ));
+                                            context.push_diagnostic(diagnostic);
+                                        }
+                                    } else {
+                                        let token = iter
+                                            .peek()
+                                            .filter(|next| matches!(next.kind(), TokenKind::Colon))
+                                            .unwrap_or(&token);
+                                        if line.trailing_whitespace(token) != whitespace {
+                                            let mut diagnostic = Diagnostic::new(
+                                                WhitespaceBeforePunctuation { symbol },
+                                                TextRange::at(token.start() - offset, offset),
+                                            );
+                                            diagnostic.set_fix(Fix::safe_edit(Edit::range_deletion(
+                                                diagnostic.range(),
+                                            )));
+                                            context.push_diagnostic(diagnostic);
+                                        }
+                                    }
+                                } else {
+                                    if fstrings > 0
+                                        && symbol == ':'
+                                        && matches!(prev_token, Some(TokenKind::Equal))
+                                    {
+                                        continue;
+                                    }
+                                    let mut diagnostic = Diagnostic::new(
+                                        WhitespaceBeforePunctuation { symbol },
+                                        TextRange::at(token.start() - offset, offset),
+                                    );
+                                    diagnostic.set_fix(Fix::safe_edit(Edit::range_deletion(
+                                        diagnostic.range(),
+                                    )));
+                                    context.push_diagnostic(diagnostic);
+                                }
+                            }
+                        }
+                        self.extra_flags = self.extra_flags.saturating_add(1);
+                    }
+                    _ => {}
+                }
+            }
+
+            prev_token = Some(kind);
+            self.extra_cursor = self.extra_cursor.saturating_add(1);
+            self.extra_prev = u32::from(token.end());
+        }
+    }
+
+    pub(super) fn check_whitespace_around_keywords(
+        &mut self,
+        line: &LogicalLine,
+        context: &mut LogicalLinesContext,
+    ) {
+        self.keyword_flags = 0;
+        self.keyword_cursor = 0;
+        let mut after_keyword = false;
+
+        for token in line.tokens() {
+            let is_keyword = token.kind().is_keyword();
+            let _classified = self.keyword_classifies_token(token.kind());
+            if is_keyword {
+                if !after_keyword {
+                    match line.leading_whitespace(token) {
+                        (Whitespace::Tab, offset) => {
+                            let start = token.start();
+                            let mut diagnostic = Diagnostic::new(
+                                TabBeforeKeyword,
+                                TextRange::at(start - offset, offset),
+                            );
+                            diagnostic.set_fix(Fix::safe_edit(Edit::range_replacement(
+                                " ".to_string(),
+                                TextRange::at(start - offset, offset),
+                            )));
+                            context.push_diagnostic(diagnostic);
+                        }
+                        (Whitespace::Many, offset) => {
+                            let start = token.start();
+                            let mut diagnostic = Diagnostic::new(
+                                MultipleSpacesBeforeKeyword,
+                                TextRange::at(start - offset, offset),
+                            );
+                            diagnostic.set_fix(Fix::safe_edit(Edit::range_replacement(
+                                " ".to_string(),
+                                TextRange::at(start - offset, offset),
+                            )));
+                            context.push_diagnostic(diagnostic);
+                        }
+                        _ => {}
+                    }
+                }
+
+                match line.trailing_whitespace(token) {
+                    (Whitespace::Tab, len) => {
+                        let mut diagnostic =
+                            Diagnostic::new(TabAfterKeyword, TextRange::at(token.end(), len));
+                        diagnostic.set_fix(Fix::safe_edit(Edit::range_replacement(
+                            " ".to_string(),
+                            TextRange::at(token.end(), len),
+                        )));
+                        context.push_diagnostic(diagnostic);
+                    }
+                    (Whitespace::Many, len) => {
+                        let mut diagnostic = Diagnostic::new(
+                            MultipleSpacesAfterKeyword,
+                            TextRange::at(token.end(), len),
+                        );
+                        diagnostic.set_fix(Fix::safe_edit(Edit::range_replacement(
+                            " ".to_string(),
+                            TextRange::at(token.end(), len),
+                        )));
+                        context.push_diagnostic(diagnostic);
+                    }
+                    _ => {}
+                }
+                self.keyword_flags = self.keyword_flags.saturating_add(1);
+            }
+
+            after_keyword = is_keyword;
+            self.keyword_cursor = self.keyword_cursor.saturating_add(1);
+        }
+    }
+
+    pub(super) fn check_missing_whitespace_after_keyword(
+        &mut self,
+        line: &LogicalLine,
+        context: &mut LogicalLinesContext,
+    ) {
+        self.keyword_cursor = self.keyword_cursor.saturating_add(1);
+        for window in line.tokens().windows(2) {
+            let tok0 = &window[0];
+            let tok1 = &window[1];
+            let tok0_kind = tok0.kind();
+            let tok1_kind = tok1.kind();
+            let _classified = self.keyword_classifies_token(tok0_kind);
+            if tok0_kind.is_keyword()
+                && !(tok0_kind.is_singleton()
+                    || matches!(tok0_kind, TokenKind::Async | TokenKind::Await)
+                    || tok0_kind == TokenKind::Except && tok1_kind == TokenKind::Star
+                    || tok0_kind == TokenKind::Yield
+                        && matches!(tok1_kind, TokenKind::Rpar | TokenKind::Comma)
+                    || matches!(
+                        tok1_kind,
+                        TokenKind::Colon
+                            | TokenKind::Semi
+                            | TokenKind::Newline
+                            | TokenKind::NonLogicalNewline
+                            | TokenKind::Rpar
+                            | TokenKind::Rsqb
+                            | TokenKind::Rbrace
+                    ))
+                && tok0.end() == tok1.start()
+            {
+                let mut diagnostic = Diagnostic::new(MissingWhitespaceAfterKeyword, tok0.range());
+                diagnostic.set_fix(Fix::safe_edit(Edit::insertion(" ".to_string(), tok0.end())));
+                context.push_diagnostic(diagnostic);
+                self.keyword_flags = self.keyword_flags.saturating_add(1);
+            }
+        }
+    }
+
+    pub(super) fn check_whitespace_before_comment(
+        &mut self,
+        line: &LogicalLine,
+        locator: &Locator,
+        context: &mut LogicalLinesContext,
+    ) {
+        self.comment_prev = 0;
+        self.comment_flags = 0;
+        self.comment_cursor = 0;
+        let mut prev_end = TextSize::default();
+        for token in line.tokens() {
+            let kind = token.kind();
+            let _classified = self.comment_classifies_token(kind);
+            if let TokenKind::Comment = kind {
+                let range = token.range();
+                let line_text = locator.slice(TextRange::new(
+                    locator.line_start(range.start()),
+                    range.start(),
+                ));
+                let token_text = locator.slice(range);
+                let is_inline_comment = !line_text.trim_whitespace().is_empty();
+                if is_inline_comment {
+                    if range.start() - prev_end < "  ".text_len() {
+                        let mut diagnostic = Diagnostic::new(
+                            TooFewSpacesBeforeInlineComment,
+                            TextRange::new(prev_end, range.start()),
+                        );
+                        diagnostic.set_fix(Fix::safe_edit(Edit::range_replacement(
+                            "  ".to_string(),
+                            TextRange::new(prev_end, range.start()),
+                        )));
+                        context.push_diagnostic(diagnostic);
+                    }
+                }
+
+                let mut parts = token_text.splitn(2, ' ');
+                let symbol = parts.next().unwrap_or("");
+                let comment = parts.next().unwrap_or("");
+                let bad_prefix = if symbol != "#" && symbol != "#:" {
+                    Some(symbol.trim_start_matches('#').chars().next().unwrap_or('#'))
+                } else {
+                    None
+                };
+
+                if is_inline_comment {
+                    if bad_prefix.is_some() || comment.chars().next().is_some_and(char::is_whitespace)
+                    {
+                        let mut diagnostic = Diagnostic::new(NoSpaceAfterInlineComment, range);
+                        diagnostic.set_fix(Fix::safe_edit(Edit::range_replacement(
+                            whitespace_before_comment::leading_space(token_text),
+                            range,
+                        )));
+                        context.push_diagnostic(diagnostic);
+                    }
+                } else if let Some(bad_prefix) = bad_prefix {
+                    if bad_prefix != '!' || !line.is_start_of_file() {
+                        if bad_prefix != '#' {
+                            let mut diagnostic = Diagnostic::new(NoSpaceAfterBlockComment, range);
+                            diagnostic.set_fix(Fix::safe_edit(Edit::range_replacement(
+                                whitespace_before_comment::leading_space(token_text),
+                                range,
+                            )));
+                            context.push_diagnostic(diagnostic);
+                        } else if !comment.is_empty() {
+                            let mut diagnostic =
+                                Diagnostic::new(MultipleLeadingHashesForBlockComment, range);
+                            diagnostic.set_fix(Fix::safe_edit(Edit::range_replacement(
+                                whitespace_before_comment::leading_hashes(token_text),
+                                range,
+                            )));
+                            context.push_diagnostic(diagnostic);
+                        }
+                    }
+                }
+                self.comment_flags = self.comment_flags.saturating_add(1);
+            } else if !matches!(kind, TokenKind::NonLogicalNewline) {
+                prev_end = token.end();
+                self.comment_prev = u32::from(prev_end);
+            }
+            self.comment_cursor = self.comment_cursor.saturating_add(1);
+        }
+    }
+
+    pub(super) fn check_indentation(
+        &mut self,
+        logical_line: &LogicalLine,
+        prev_logical_line: Option<&LogicalLine>,
+        indent_char: char,
+        indent_level: usize,
+        prev_indent_level: Option<usize>,
+        indent_size: usize,
+    ) -> Vec<DiagnosticKind> {
+        self.indent_flags = 0;
+        self.indent_cursor = 0;
+        let mut diagnostics = vec![];
+        let _ = logical_line
+            .first_token()
+            .map(|token| self.indent_classifies_token(token.kind()));
+
+        if indent_level % indent_size != 0 {
+            diagnostics.push(if logical_line.is_comment_only() {
+                DiagnosticKind::from(IndentationWithInvalidMultipleComment {
+                    indent_width: indent_size,
+                })
+            } else {
+                DiagnosticKind::from(IndentationWithInvalidMultiple {
+                    indent_width: indent_size,
+                })
+            });
+            self.indent_flags = self.indent_flags.saturating_add(1);
+        }
+        let indent_expect = prev_logical_line
+            .and_then(|prev_logical_line| prev_logical_line.tokens_trimmed().last())
+            .is_some_and(|t| t.kind() == TokenKind::Colon);
+
+        if indent_expect && indent_level <= prev_indent_level.unwrap_or(0) {
+            diagnostics.push(if logical_line.is_comment_only() {
+                DiagnosticKind::from(NoIndentedBlockComment)
+            } else {
+                DiagnosticKind::from(NoIndentedBlock)
+            });
+            self.indent_flags = self.indent_flags.saturating_add(1);
+        } else if !indent_expect
+            && prev_indent_level.is_some_and(|prev_indent_level| indent_level > prev_indent_level)
+        {
+            diagnostics.push(if logical_line.is_comment_only() {
+                DiagnosticKind::from(UnexpectedIndentationComment)
+            } else {
+                DiagnosticKind::from(UnexpectedIndentation)
+            });
+            self.indent_flags = self.indent_flags.saturating_add(1);
+        }
+        if indent_expect {
+            let expected_indent_amount = if indent_char == '\t' { 8 } else { 4 };
+            let expected_indent_level = prev_indent_level.unwrap_or(0) + expected_indent_amount;
+            if indent_level > expected_indent_level {
+                diagnostics.push(
+                    OverIndented {
+                        is_comment: logical_line.is_comment_only(),
+                    }
+                    .into(),
+                );
+                self.indent_flags = self.indent_flags.saturating_add(1);
+            }
+        }
+        self.indent_cursor = self.indent_cursor.saturating_add(1);
+        diagnostics
+    }
+
+    pub(super) fn check_whitespace_before_parameters(
+        &mut self,
+        line: &LogicalLine,
+        context: &mut LogicalLinesContext,
+    ) {
+        self.param_prev = 0;
+        self.param_flags = 0;
+        self.param_cursor = 0;
+        let previous = line.tokens().first().unwrap();
