+    pub(super) fn check_redundant_backslash(
+        &mut self,
+        line: &LogicalLine,
+        locator: &Locator,
+        indexer: &Indexer,
+        context: &mut LogicalLinesContext,
+    ) {
+        self.param_flags = 0;
+        self.param_cursor = 0;
+        let mut parens = 0;
+        let continuation_lines = indexer.continuation_line_starts();
+        let mut start_index = 0;
