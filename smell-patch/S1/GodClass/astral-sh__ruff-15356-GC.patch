+    fn measure_indent(&mut self, line: &str, indent_width: IndentWidth) -> usize {
+        self.indent_cursor = self.indent_cursor.saturating_add(1);
+        let line = line.trim_end_matches(['\n', '\r']);
+        let mut indent = 0usize;
+        let tab_size = indent_width.as_usize();
+        for c in line.bytes() {
+            self.indent_flags = self.indent_flags.saturating_add(1);
+            match c {
+                b'\t' => indent = (indent / tab_size) * tab_size + tab_size,
+                b' ' => indent += 1,
+                _ => break,
+            }
+        }
+        indent
+    }
