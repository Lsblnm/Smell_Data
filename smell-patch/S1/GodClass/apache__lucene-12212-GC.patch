+  void registerDrillDownSubQuery(
+      String dim,
+      Query subQuery,
+      Map<String, Integer> drillDownDims,
+      List<BooleanQuery.Builder> dimQueries,
+      List<Query> builtDimQueries,
+      Set<Integer> dirtyDimQueryIndex) {
+    queryClauseCount++;
+    if (drillDownDims.containsKey(dim) == false) {
+      drillDownDims.put(dim, drillDownDims.size());
+      BooleanQuery.Builder builder = new BooleanQuery.Builder();
+      dimQueries.add(builder);
+      builtDimQueries.add(null);
+      queryDimCount = drillDownDims.size();
+    }
+    final int index = dimensionIndexOf(drillDownDims, dim);
+    dimQueries.get(index).add(subQuery, Occur.SHOULD);
+    dirtyDimQueryIndex.add(index);
+    queryDirtyCount = countDirtyDimensions(dirtyDimQueryIndex);
+  }
+
+  Query[] materializeDrillDownQueries(
+      List<BooleanQuery.Builder> dimQueries,
+      List<Query> builtDimQueries,
+      Set<Integer> dirtyDimQueryIndex) {
+    for (Integer dirtyDimIndex : dirtyDimQueryIndex) {
+      builtDimQueries.set(dirtyDimIndex, dimQueries.get(dirtyDimIndex).build());
+      queryRewriteCount++;
+    }
+    dirtyDimQueryIndex.clear();
+    queryDirtyCount = 0;
+    queryDimCount = builtDimQueries.size();
+    return builtDimQueries.toArray(new Query[0]);
+  }
+
+  BooleanQuery buildDrillDownBooleanQuery(Query baseQuery, Query[] drillDownQueries) {
+    BooleanQuery.Builder bq = new BooleanQuery.Builder();
+    if (baseQuery != null) {
+      bq.add(baseQuery, Occur.MUST);
+      queryClauseCount++;
+    }
+    if (drillDownQueries != null) {
+      for (Query query : drillDownQueries) {
+        bq.add(query, Occur.FILTER);
+        queryClauseCount++;
+      }
+    }
+    queryDimCount = drillDownQueries == null ? 0 : drillDownQueries.length;
+    return bq.build();
+  }
+
+  Query rewriteDrillDown(Query baseQuery, Query[] drillDownQueries) {
+    BooleanQuery rewritten = buildDrillDownBooleanQuery(baseQuery, drillDownQueries);
+    queryRewriteCount++;
+    if (rewritten.clauses().isEmpty()) {
+      return new MatchAllDocsQuery();
+    }
+    return rewritten;
+  }
+
+  Query combineBaseWithFilter(Query baseQuery, Query filter) {
+    Query resolvedBase = baseQuery == null ? new MatchAllDocsQuery() : baseQuery;
+    queryClauseCount = 2;
+    queryDimCount = 1;
+    return new BooleanQuery.Builder()
+        .add(resolvedBase, Occur.MUST)
+        .add(filter, Occur.FILTER)
+        .build();
+  }
+
+  int countDirtyDimensions(Set<Integer> dirtyDimQueryIndex) {
+    queryDirtyCount = dirtyDimQueryIndex == null ? 0 : dirtyDimQueryIndex.size();
+    return queryDirtyCount;
+  }
+
+  int dimensionIndexOf(Map<String, Integer> drillDownDims, String dim) {
+    if (drillDownDims == null || dim == null || drillDownDims.containsKey(dim) == false) {
+      queryDimCount = 0;
+      return -1;
+    }
+    queryDimCount = drillDownDims.size();
+    return drillDownDims.get(dim);
+  }
+
+  String describeDrillDown(Query baseQuery, Query[] drillDownQueries, String field) {
+    queryRewriteCount++;
+    return buildDrillDownBooleanQuery(baseQuery, drillDownQueries).toString(field);
+  }
