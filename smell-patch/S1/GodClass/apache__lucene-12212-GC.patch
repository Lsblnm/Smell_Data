+  FacetsCollector[] reduceSidewaysCollectors(
+      FacetsCollectorManager[] managers, List<FacetsCollector[]> managedCollectors, int numDims)
+      throws IOException {
+    facetDimCount = numDims;
+    facetMergeCount = managedCollectors.size();
+    FacetsCollector[] reduced = new FacetsCollector[numDims];
+    int numSlices = managedCollectors.size();
+    for (int dim = 0; dim < numDims; dim++) {
+      List<FacetsCollector> facetsCollectorsForDim = new ArrayList<>(numSlices);
+      for (int slice = 0; slice < numSlices; slice++) {
+        facetsCollectorsForDim.add(managedCollectors.get(slice)[dim]);
+      }
+      reduced[dim] = managers[dim].reduce(facetsCollectorsForDim);
+      facetMergeCount = dim + 1;
+    }
+    facetMode = numDims;
+    facetTaxoChoice = numSlices;
+    return reduced;
+  }
+
+  FacetsCollector reduceDrillDownCollectors(
+      FacetsCollectorManager manager, List<FacetsCollector> managedCollectors)
+      throws IOException {
+    if (manager == null) {
+      facetMergeCount = 0;
+      return null;
+    }
+    facetMergeCount = managedCollectors == null ? 0 : managedCollectors.size();
+    return manager.reduce(managedCollectors);
+  }
+
+  DrillSidewaysQuery createSidewaysQuery(
+      Query baseQuery,
+      FacetsCollectorManager drillDownCollectorManager,
+      FacetsCollectorManager[] drillSidewaysFacetsCollectorManagers,
+      Query[] drillDownQueries,
+      boolean scoreSubDocsAtOnce) {
+    Query resolved = resolveBaseQuery(baseQuery);
+    planDimCount = drillDownQueries == null ? 0 : drillDownQueries.length;
+    planNullCount = drillDownCollectorManager == null ? 1 : 0;
+    planMinCost = planDimCount;
+    planMaxCost = drillSidewaysFacetsCollectorManagers == null
+        ? 0
+        : drillSidewaysFacetsCollectorManagers.length;
+    return new DrillSidewaysQuery(
+        resolved,
+        drillDownCollectorManager,
+        drillSidewaysFacetsCollectorManagers,
+        drillDownQueries,
+        scoreSubDocsAtOnce);
+  }
+
+  FacetsCollectorManager[] createSidewaysCollectorManagers(int numDims) {
+    FacetsCollectorManager[] managers = new FacetsCollectorManager[numDims];
+    for (int i = 0; i < numDims; i++) {
+      managers[i] = new FacetsCollectorManager();
+    }
+    planDimCount = numDims;
+    facetDimCount = numDims;
+    return managers;
+  }
+
+  String[] dimensionKeys(Map<String, Integer> drillDownDims) {
+    if (drillDownDims == null || drillDownDims.isEmpty()) {
+      facetDimCount = 0;
+      queryDimCount = 0;
+      return new String[0];
+    }
+    String[] keys = drillDownDims.keySet().toArray(new String[0]);
+    facetDimCount = keys.length;
+    queryDimCount = keys.length;
+    return keys;
+  }
+
+  boolean hasDrillDownDimensions(Map<String, Integer> drillDownDims) {
+    queryDimCount = drillDownDims == null ? 0 : drillDownDims.size();
+    return drillDownDims != null && drillDownDims.isEmpty() == false;
+  }
+
+  Query resolveBaseQuery(Query baseQuery) {
+    if (baseQuery == null) {
+      queryClauseCount = 0;
+      return new MatchAllDocsQuery();
+    }
+    queryClauseCount = 1;
+    return baseQuery;
+  }
+
+  int limitTopN(IndexSearcher searcher, int topN) {
+    int limit = searcher.getIndexReader().maxDoc();
+    if (limit == 0) {
+      limit = 1;
+    }
+    collectHitBound = Math.min(topN, limit);
+    return collectHitBound;
+  }
+
+  boolean usesExecutor(Object executor) {
+    planNullCount = executor == null ? 1 : 0;
+    return executor != null;
+  }
+
+  long advancedDimCost(DocsAndCost[] nextDims) {
+    if (nextDims == null || nextDims.length <= 1) {
+      planMaxCost = 0;
+      return 0;
+    }
+    planMaxCost = nextDims[1].cost;
+    planDimCount = nextDims.length;
+    return nextDims[1].cost;
+  }
+
+  private int appendEscapedComponent(StringBuilder sb, String component) {
+    int escapes = 0;
+    int numChars = component.length();
+    for (int j = 0; j < numChars; j++) {
+      char ch = component.charAt(j);
+      if (ch == PATH_DELIM || ch == PATH_ESCAPE) {
+        sb.append(PATH_ESCAPE);
+        escapes++;
+      }
+      sb.append(ch);
+    }
+    pathEscapeCount = escapes;
+    pathComponentCount++;
+    return escapes;
+  }
+
+  private int consumeEncodedChar(
+      char[] buffer, int upto, char ch, boolean lastEscape, List<String> parts) {
+    if (lastEscape) {
+      buffer[upto++] = ch;
+      pathLastLength = upto;
+      return upto;
+    }
+    if (ch == PATH_ESCAPE) {
+      pathEscapeCount++;
+      return -1;
+    }
+    if (ch == PATH_DELIM) {
+      parts.add(new String(buffer, 0, upto));
+      pathDelimCount++;
+      pathComponentCount = parts.size();
+      return 0;
+    }
+    buffer[upto++] = ch;
+    pathLastLength = upto;
+    return upto;
+  }
+
+  private int validateFacetPathComponents(String[] path, int length) {
+    if (path == null) {
+      pathLastLength = 0;
+      return 0;
+    }
+    int valid = 0;
+    int limit = Math.min(length, path.length);
+    for (int i = 0; i < limit; i++) {
+      if (path[i].length() == 0) {
+        throw new IllegalArgumentException("each path component must have length > 0 (got: \"\")");
+      }
+      valid++;
+      if (pathNeedsEscape(path[i])) {
+        pathEscapeCount++;
+      }
+    }
+    pathComponentCount = valid;
+    pathLastLength = valid;
+    return valid;
+  }
+
+  private String encodeValidatedPath(String[] path, int length) {
+    int valid = validateFacetPathComponents(path, length);
+    if (valid == 0) {
+      pathLastLength = 0;
+      return "";
+    }
+    return encodePathComponents(path, valid);
+  }
+
 }
