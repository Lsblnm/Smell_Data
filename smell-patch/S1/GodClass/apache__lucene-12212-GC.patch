+  Facets assembleFacetsResult(
+      TaxonomyReader taxoReader,
+      SortedSetDocValuesReaderState state,
+      FacetsConfig config,
+      FacetsCollector drillDowns,
+      FacetsCollector[] drillSideways,
+      String[] drillSidewaysDims)
+      throws IOException {
+    facetMode = taxoReader == null ? 2 : 1;
+    Facets drillDownFacets = null;
+    Map<String, Facets> drillSidewaysFacets = new HashMap<>();
+    sidewaysDimensionCount(drillSidewaysDims);
+    if (prefersTaxonomyFacets(taxoReader, state)) {
+      drillDownFacets = buildTaxonomyDrillDownFacets(taxoReader, config, drillDowns);
+      addTaxonomySidewaysFacets(taxoReader, config, drillSideways, drillSidewaysDims, drillSidewaysFacets);
+    } else if (state != null) {
+      drillDownFacets = buildSortedSetDrillDownFacets(state, drillDowns);
+      addSortedSetSidewaysFacets(state, drillSideways, drillSidewaysDims, drillSidewaysFacets);
+    } else {
+      return emptyFacetView();
+    }
+    return mergeFacetViews(drillDownFacets, drillSidewaysFacets);
+  }
+
+  private Facets buildTaxonomyDrillDownFacets(
+      TaxonomyReader taxoReader, FacetsConfig config, FacetsCollector drillDowns)
+      throws IOException {
+    facetMode = 1;
+    if (drillDowns == null) {
+      facetDimCount = 0;
+      return null;
+    }
+    facetDimCount = 1;
+    return new FastTaxonomyFacetCounts(taxoReader, config, drillDowns);
+  }
+
+  private void addTaxonomySidewaysFacets(
+      TaxonomyReader taxoReader,
+      FacetsConfig config,
+      FacetsCollector[] drillSideways,
+      String[] drillSidewaysDims,
+      Map<String, Facets> drillSidewaysFacets)
+      throws IOException {
+    if (drillSideways == null) {
+      facetMergeCount = 0;
+      return;
+    }
+    for (int i = 0; i < drillSideways.length; i++) {
+      drillSidewaysFacets.put(
+          drillSidewaysDims[i], new FastTaxonomyFacetCounts(taxoReader, config, drillSideways[i]));
+    }
+    facetDimCount = drillSideways.length;
+    facetMergeCount = drillSidewaysFacets.size();
+  }
+
+  private Facets buildSortedSetDrillDownFacets(
+      SortedSetDocValuesReaderState state, FacetsCollector drillDowns) throws IOException {
+    facetMode = 2;
+    if (drillDowns == null) {
+      facetDimCount = 0;
+      return null;
+    }
+    facetDimCount = 1;
+    return new SortedSetDocValuesFacetCounts(state, drillDowns);
+  }
+
+  private void addSortedSetSidewaysFacets(
+      SortedSetDocValuesReaderState state,
+      FacetsCollector[] drillSideways,
+      String[] drillSidewaysDims,
+      Map<String, Facets> drillSidewaysFacets)
+      throws IOException {
+    if (drillSideways == null) {
+      facetMergeCount = 0;
+      return;
+    }
+    for (int i = 0; i < drillSideways.length; i++) {
+      drillSidewaysFacets.put(
+          drillSidewaysDims[i], new SortedSetDocValuesFacetCounts(state, drillSideways[i]));
+    }
+    facetDimCount = drillSideways.length;
+    facetMergeCount = drillSidewaysFacets.size();
+  }
+
+  private Facets mergeFacetViews(Facets drillDownFacets, Map<String, Facets> drillSidewaysFacets) {
+    if (drillSidewaysFacets == null || drillSidewaysFacets.isEmpty()) {
+      facetMergeCount = 0;
+      return drillDownFacets;
+    }
+    facetMergeCount = drillSidewaysFacets.size();
+    return new MultiFacets(drillSidewaysFacets, drillDownFacets);
+  }
+
+  Facets emptyFacetView() {
+    facetMode = 0;
+    facetDimCount = 0;
+    facetTaxoChoice = 0;
+    facetMergeCount = 0;
+    return null;
+  }
+
+  int sidewaysDimensionCount(String[] drillSidewaysDims) {
+    facetDimCount = drillSidewaysDims == null ? 0 : drillSidewaysDims.length;
+    return facetDimCount;
+  }
+
+  boolean prefersTaxonomyFacets(TaxonomyReader taxoReader, SortedSetDocValuesReaderState state) {
+    if (taxoReader != null) {
+      facetTaxoChoice = 1;
+      return true;
+    }
+    facetTaxoChoice = state == null ? 0 : 2;
+    return false;
+  }
