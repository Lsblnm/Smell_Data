+  BulkScorer openSidewaysScorer(
+      LeafReaderContext leafContext,
+      Scorer baseScorer,
+      Weight[] drillDowns,
+      ScoreMode scoreMode,
+      FacetsCollectorManager drillDownCollectorManager,
+      FacetsCollectorManager[] drillSidewaysCollectorManagers,
+      List<FacetsCollector> managedDrillDownCollectors,
+      List<FacetsCollector[]> managedDrillSidewaysCollectors,
+      boolean scoreSubDocsAtOnce)
+      throws IOException {
+    if (baseScorer == null) {
+      planDimCount = 0;
+      return null;
+    }
+    int drillDownCount = drillDowns.length;
+    FacetsCollector[] sidewaysCollectors = new FacetsCollector[drillDownCount];
+    managedDrillSidewaysCollectors.add(sidewaysCollectors);
+    DocsAndCost[] nextDims = new DocsAndCost[drillDownCount];
+    int nullCount = materializeDocsAndCosts(
+        leafContext, drillDowns, scoreMode, drillSidewaysCollectorManagers, sidewaysCollectors, nextDims);
+    if (shouldSkipSideways(nullCount, nextDims.length)) {
+      return null;
+    }
+    sortDimsByCost(nextDims);
+    long drillCost = accumulateDimCosts(nextDims);
+    long advanced = advancedDimCost(nextDims);
+    countTwoPhaseDims(nextDims);
+    classifyScoringPlan(planMinCost, drillCost, advanced, nextDims.length, scoreSubDocsAtOnce);
+    estimatePlanSpread(planMinCost, drillCost, advanced);
+    FacetsCollector drillDownCollector = null;
+    if (drillDownCollectorManager != null) {
+      drillDownCollector = drillDownCollectorManager.newCollector();
+      managedDrillDownCollectors.add(drillDownCollector);
+    }
+    return new DrillSidewaysScorer(
+        leafContext, baseScorer, drillDownCollector, nextDims, scoreSubDocsAtOnce);
+  }
+
+  private int materializeDocsAndCosts(
+      LeafReaderContext leafContext,
+      Weight[] drillDowns,
+      ScoreMode scoreMode,
+      FacetsCollectorManager[] drillSidewaysCollectorManagers,
+      FacetsCollector[] sidewaysCollectors,
+      DocsAndCost[] nextDims)
+      throws IOException {
+    int nullCount = 0;
+    long minCost = Long.MAX_VALUE;
+    long maxCost = 0;
+    for (int dim = 0; dim < nextDims.length; dim++) {
+      Scorer scorer = drillDowns[dim].scorer(leafContext);
+      if (scorer == null) {
+        nullCount++;
+        scorer =
+            new ConstantScoreScorer(drillDowns[dim], 0f, scoreMode, DocIdSetIterator.empty());
+      }
+      FacetsCollector sidewaysCollector = drillSidewaysCollectorManagers[dim].newCollector();
+      sidewaysCollectors[dim] = sidewaysCollector;
+      nextDims[dim] = new DocsAndCost(scorer, sidewaysCollector);
+      long cost = nextDims[dim].cost;
+      if (cost < minCost) {
+        minCost = cost;
+      }
+      if (cost > maxCost) {
+        maxCost = cost;
+      }
+    }
+    planMinCost = minCost == Long.MAX_VALUE ? 0 : minCost;
+    planMaxCost = maxCost;
+    planNullCount = nullCount;
+    return nullCount;
+  }
+
+  private void sortDimsByCost(DocsAndCost[] nextDims) {
+    Arrays.sort(
+        nextDims,
+        new Comparator<DocsAndCost>() {
+          @Override
+          public int compare(DocsAndCost o1, DocsAndCost o2) {
+            return Long.compare(o1.approximation.cost(), o2.approximation.cost());
+          }
+        });
+    if (nextDims.length > 0) {
+      planMinCost = nextDims[0].cost;
+      planMaxCost = nextDims[nextDims.length - 1].cost;
+    }
+    planDimCount = nextDims.length;
+  }
+
+  boolean shouldSkipSideways(int nullCount, int dimCount) {
+    planNullCount = nullCount;
+    planDimCount = dimCount;
+    if (nullCount > 1) {
+      return true;
+    }
+    return false;
+  }
+
+  long estimatePlanSpread(long baseCost, long drillDownCost, long advancedCost) {
+    planMinCost = Math.min(baseCost, Math.min(drillDownCost, advancedCost));
+    planMaxCost = Math.max(baseCost, Math.max(drillDownCost, advancedCost));
+    if (drillDownCost == 0) {
+      return baseCost;
+    }
+    if (baseCost < drillDownCost / 10) {
+      return baseCost;
+    }
+    if (advancedCost > 0 && advancedCost < baseCost / 10) {
+      return advancedCost;
+    }
+    return drillDownCost;
+  }
+
+  int classifyScoringPlan(long baseCost, long drillDownCost, long advancedCost, int numDims, boolean scoreAtOnce) {
+    planDimCount = numDims;
+    planMinCost = baseCost;
+    planMaxCost = drillDownCost;
+    if (scoreAtOnce || (drillDownCost > 0 && baseCost < drillDownCost / 10)) {
+      return 1;
+    }
+    if (numDims > 1 && advancedCost > 0 && advancedCost < baseCost / 10) {
+      return 2;
+    }
+    return 3;
+  }
+
+  long accumulateDimCosts(DocsAndCost[] nextDims) {
+    long total = 0;
+    long min = Long.MAX_VALUE;
+    long max = 0;
+    if (nextDims != null) {
+      for (DocsAndCost dim : nextDims) {
+        total += dim.cost;
+        if (dim.cost < min) {
+          min = dim.cost;
+        }
+        if (dim.cost > max) {
+          max = dim.cost;
+        }
+      }
+    }
+    planMinCost = min == Long.MAX_VALUE ? 0 : min;
+    planMaxCost = max;
+    planDimCount = nextDims == null ? 0 : nextDims.length;
+    return total;
+  }
+
+  int countTwoPhaseDims(DocsAndCost[] nextDims) {
+    int count = 0;
+    if (nextDims != null) {
+      for (DocsAndCost dim : nextDims) {
+        if (dim.twoPhase != null) {
+          count++;
+        }
+      }
+    }
+    planDimCount = count;
+    return count;
+  }
