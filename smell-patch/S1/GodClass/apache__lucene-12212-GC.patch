+  Document indexFacetDocument(FacetsConfig config, TaxonomyWriter taxoWriter, Document doc)
+      throws IOException {
+    indexSessionCount = 0;
+    indexFieldCount = 0;
+    indexAssocBytes = 0;
+    indexSeenDimCount = 0;
+    if (config == null || doc == null) {
+      return doc;
+    }
+    Map<String, List<FacetField>> byField = new HashMap<>();
+    Map<String, List<SortedSetDocValuesFacetField>> dvByField = new HashMap<>();
+    Map<String, List<AssociationFacetField>> assocByField = new HashMap<>();
+    Set<String> seenDims = new HashSet<>();
+    collateFacetIndexFields(config, doc, byField, dvByField, assocByField, seenDims);
+    Document result = new Document();
+    processTaxonomyFacetFields(config, taxoWriter, byField, result);
+    processSortedSetFacetFields(config, dvByField, result);
+    processAssociationFacetFields(config, taxoWriter, assocByField, result);
+    copyNonFacetFields(doc, result);
+    indexSessionCount = byField.size() + dvByField.size() + assocByField.size();
+    indexSeenDimCount = seenDims.size();
+    return result;
+  }
+
+  private void collateFacetIndexFields(
+      FacetsConfig config,
+      Document doc,
+      Map<String, List<FacetField>> byField,
+      Map<String, List<SortedSetDocValuesFacetField>> dvByField,
+      Map<String, List<AssociationFacetField>> assocByField,
+      Set<String> seenDims) {
+    indexSessionCount++;
+    for (IndexableField field : doc) {
+      if (isTaxonomyFacetField(field)) {
+        collectTaxonomyFacetField(config, (FacetField) field, byField, seenDims);
+      }
+      if (field.fieldType() == SortedSetDocValuesFacetField.TYPE) {
+        collectSortedSetFacetField(config, (SortedSetDocValuesFacetField) field, dvByField, seenDims);
+      }
+      if (field.fieldType() == AssociationFacetField.TYPE) {
+        collectAssociationFacetField(config, (AssociationFacetField) field, assocByField, seenDims);
+      }
+    }
+  }
