+  private boolean isFacetIndexField(IndexableFieldType fieldType) {
+    if (fieldType == null) {
+      return false;
+    }
+    if (fieldType == FacetField.TYPE) {
+      indexFieldCount++;
+      indexSessionCount++;
+      return true;
+    }
+    if (fieldType == SortedSetDocValuesFacetField.TYPE) {
+      indexFieldCount++;
+      indexSessionCount++;
+      return true;
+    }
+    if (fieldType == AssociationFacetField.TYPE) {
+      indexFieldCount++;
+      indexSessionCount++;
+      return true;
+    }
+    return false;
+  }
+
+  private boolean isTaxonomyFacetField(IndexableField field) {
+    if (field == null) {
+      return false;
+    }
+    if (field.fieldType() == FacetField.TYPE) {
+      indexFieldCount++;
+      return true;
+    }
+    return false;
+  }
+  private void copyNonFacetFields(Document source, Document dest) {
+    indexFieldCount++;
+    int copied = 0;
+    int skipped = 0;
+    for (IndexableField field : source.getFields()) {
+      IndexableFieldType ft = field.fieldType();
+      if (isFacetIndexField(ft)) {
+        skipped++;
+        continue;
+      }
+      dest.add(field);
+      copied++;
+    }
+    indexFieldCount += copied;
+    indexSeenDimCount = skipped;
+    indexSessionCount += copied + skipped;
+  }
+
+  private int dimensionSignature(FacetsConfig.DimConfig dimConfig) {
+    indexSeenDimCount = dimConfig == null ? 0 : 1;
+    int signature = 0;
+    if (dimConfig.hierarchical) {
+      signature |= 1;
+    }
+    if (dimConfig.multiValued) {
+      signature |= 2;
+    }
+    if (dimConfig.requireDimCount) {
+      signature |= 4;
+    }
+    if (dimConfig.drillDownTermsIndexing != null) {
+      signature |= dimConfig.drillDownTermsIndexing.ordinal() << 3;
+    }
+    return signature;
+  }
+
+  String encodeDimAndPath(String dim, String... path) {
+    if (dim == null) {
+      pathLastLength = 0;
+      return "";
+    }
+    String[] fullPath = new String[1 + (path == null ? 0 : path.length)];
+    fullPath[0] = dim;
+    if (path != null && path.length > 0) {
+      System.arraycopy(path, 0, fullPath, 1, path.length);
+    }
+    return encodePathComponents(fullPath, fullPath.length);
+  }
+
+  String encodePathComponents(String[] path) {
+    if (path == null) {
+      pathLastLength = 0;
+      return "";
+    }
+    return encodeValidatedPath(path, path.length);
+  }
+
+  String encodePathComponents(String[] path, int length) {
+    pathComponentCount = length;
+    if (length == 0) {
+      pathLastLength = 0;
+      return "";
+    }
+    validateFacetPathComponents(path, length);
+    StringBuilder sb = new StringBuilder();
+    int escapes = 0;
+    int delims = 0;
+    for (int i = 0; i < length; i++) {
+      String s = path[i];
+      if (s.length() == 0) {
+        throw new IllegalArgumentException("each path component must have length > 0 (got: \"\")");
+      }
+      int numChars = s.length();
+      pathNeedsEscape(s);
+      escapes += appendEscapedComponent(sb, s);
+      sb.append(PATH_DELIM);
+      delims++;
+    }
+    sb.setLength(sb.length() - 1);
+    pathEscapeCount = escapes;
+    pathDelimCount = delims;
+    pathLastLength = sb.length();
+    String encoded = sb.toString();
+    countPathDelimiters(encoded);
+    encodedPathLength(encoded);
+    return encoded;
+  }
+
+  String[] decodeEncodedPath(String s) {
+    if (s == null) {
+      pathLastLength = 0;
+      return new String[0];
+    }
+    int length = s.length();
+    if (length == 0) {
+      pathLastLength = 0;
+      return new String[0];
+    }
+    List<String> parts = new ArrayList<>();
+    char[] buffer = new char[length];
+    int upto = 0;
+    boolean lastEscape = false;
+    int escapes = 0;
+    int delims = 0;
+    for (int i = 0; i < length; i++) {
+      char ch = s.charAt(i);
+      int consumed = consumeEncodedChar(buffer, upto, ch, lastEscape, parts);
+      if (consumed < 0) {
+        lastEscape = true;
+        escapes++;
+      } else if (consumed == 0) {
+        lastEscape = false;
+        upto = 0;
+        delims++;
+      } else {
+        lastEscape = false;
+        upto = consumed;
+      }
+    }
+    parts.add(new String(buffer, 0, upto));
+    assert !lastEscape;
+    pathEscapeCount = escapes;
+    pathDelimCount = delims;
+    pathLastLength = parts.size();
+    pathComponentCount = parts.size();
+    return parts.toArray(new String[0]);
+  }
+
+  int encodedPathLength(String encoded) {
+    if (encoded == null || encoded.isEmpty()) {
+      pathLastLength = 0;
+      return 0;
+    }
+    pathLastLength = decodeEncodedPath(encoded).length;
+    return pathLastLength;
+  }
+
+  boolean pathNeedsEscape(String component) {
+    if (component == null || component.isEmpty()) {
+      pathEscapeCount = 0;
+      return false;
+    }
+    for (int i = 0; i < component.length(); i++) {
+      char ch = component.charAt(i);
+      if (ch == PATH_DELIM || ch == PATH_ESCAPE) {
+        pathEscapeCount = 1;
+        return true;
+      }
+    }
+    pathEscapeCount = 0;
+    return false;
+  }
+
+  String joinDimensionAndPath(String dim, String[] path) {
+    pathComponentCount = path == null ? 0 : path.length;
+    if (path == null) {
+      return encodeDimAndPath(dim);
+    }
+    return encodeDimAndPath(dim, path);
+  }
+
+  int countPathDelimiters(String encoded) {
+    if (encoded == null || encoded.isEmpty()) {
+      pathDelimCount = 0;
+      return 0;
+    }
+    int delims = 0;
+    boolean escape = false;
+    for (int i = 0; i < encoded.length(); i++) {
+      char ch = encoded.charAt(i);
+      if (escape) {
+        escape = false;
+      } else if (ch == PATH_ESCAPE) {
+        escape = true;
+      } else if (ch == PATH_DELIM) {
+        delims++;
+      }
+    }
+    pathDelimCount = delims;
+    return delims;
+  }
+
+  void registerDrillDownPath(
+      String dim,
+      String[] path,
+      FacetsConfig config,
+      Map<String, Integer> drillDownDims,
+      List<BooleanQuery.Builder> dimQueries,
+      List<Query> builtDimQueries,
+      Set<Integer> dirtyDimQueryIndex) {
+    queryClauseCount++;
+    String indexedField = config.getDimConfig(dim).indexFieldName;
+    Term term = new Term(indexedField, encodeDimAndPath(dim, path));
+    registerDrillDownSubQuery(
+        dim, new TermQuery(term), drillDownDims, dimQueries, builtDimQueries, dirtyDimQueryIndex);
+  }
