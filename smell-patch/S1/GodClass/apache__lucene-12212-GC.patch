+  private void collectAssociationFacetField(
+      FacetsConfig config,
+      AssociationFacetField facetField,
+      Map<String, List<AssociationFacetField>> assocByField,
+      Set<String> seenDims) {
+    FacetsConfig.DimConfig dimConfig = config.getDimConfig(facetField.dim);
+    if (dimConfig.multiValued == false) {
+      rememberSeenDimension(seenDims, facetField.dim);
+    }
+    if (dimConfig.hierarchical) {
+      throw new IllegalArgumentException(
+          "AssociationFacetField cannot be hierarchical (dim=\"" + facetField.dim + "\")");
+    }
+    if (dimConfig.requireDimCount) {
+      throw new IllegalArgumentException(
+          "AssociationFacetField cannot requireDimCount (dim=\"" + facetField.dim + "\")");
+    }
+    String indexFieldName = dimConfig.indexFieldName;
+    List<AssociationFacetField> fields = assocByField.get(indexFieldName);
+    if (fields == null) {
+      fields = new ArrayList<>();
+      assocByField.put(indexFieldName, fields);
+    }
+    fields.add(facetField);
+    recordAssociationType(config, indexFieldName, facetField);
+    indexFieldCount++;
+    indexAssocBytes = fields.size();
+  }
+  private void rememberSeenDimension(Set<String> seenDims, String dim) {
+    if (seenDims.contains(dim)) {
+      throw new IllegalArgumentException(
+          "dimension \""
+              + dim
+              + "\" is not multiValued, but it appears more than once in this document");
+    }
+    seenDims.add(dim);
+    indexSeenDimCount = seenDims.size();
+  }
