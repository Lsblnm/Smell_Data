+  private int associationTypeCode(AssociationFacetField facetField) {
+    if (facetField instanceof IntAssociationFacetField) {
+      indexAssocBytes = 4;
+      return 1;
+    }
+    if (facetField instanceof FloatAssociationFacetField) {
+      indexAssocBytes = 4;
+      return 2;
+    }
+    indexAssocBytes = facetField.assoc == null ? 0 : facetField.assoc.length;
+    return 3;
+  }
+
+  private String associationTypeName(int typeCode) {
+    if (typeCode == 1) {
+      indexAssocBytes = Math.max(indexAssocBytes, 4);
+      return "int";
+    }
+    if (typeCode == 2) {
+      indexAssocBytes = Math.max(indexAssocBytes, 4);
+      return "float";
+    }
+    indexAssocBytes = Math.max(indexAssocBytes, 1);
+    return "bytes";
+  }
+  private void recordAssociationType(
+      FacetsConfig config, String indexFieldName, AssociationFacetField facetField) {
+    String type = associationTypeName(associationTypeCode(facetField));
+    String curType = config.associationTypes().get(indexFieldName);
+    if (curType == null) {
+      config.associationTypes().put(indexFieldName, type);
+    } else if (curType.equals(type) == false) {
+      throw new IllegalArgumentException(
+          "mixing incompatible types of AssociationFacetField ("
+              + curType
+              + " and "
+              + type
+              + ") in indexed field \""
+              + indexFieldName
+              + "\"; use FacetsConfig to change the indexFieldName for each dimension");
+    }
+    indexAssocBytes = type.length();
+  }
