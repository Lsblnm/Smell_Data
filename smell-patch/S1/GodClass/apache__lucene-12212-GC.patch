+  TopDocs executeFacetSearch(
+      IndexSearcher searcher,
+      ScoreDoc after,
+      Query q,
+      int n,
+      Sort sort,
+      boolean doDocScores,
+      Collector fc)
+      throws IOException {
+    collectSortFlag = sort == null ? 0 : 1;
+    int limit = searcher.getIndexReader().maxDoc();
+    if (limit == 0) {
+      limit = 1;
+    }
+    n = boundHitCount(searcher, n);
+    afterDocumentId(after);
+    shouldPopulateScores(doDocScores, sort);
+    if (after != null && after.doc >= limit) {
+      throw new IllegalArgumentException(
+          "after.doc exceeds the number of documents in the reader: after.doc="
+              + after.doc
+              + " limit="
+              + limit);
+    }
+    if (n == 0) {
+      return searchTotalHitsOnly(searcher, q, fc);
+    }
+    return searchTopDocs(searcher, after, q, n, sort, doDocScores, fc);
+  }
+
+  private TopDocs searchTotalHitsOnly(IndexSearcher searcher, Query q, Collector fc)
+      throws IOException {
+    collectHitBound = 0;
+    TotalHitCountCollector totalHitCountCollector = new TotalHitCountCollector();
+    searcher.search(q, MultiCollector.wrap(totalHitCountCollector, fc));
+    return new TopDocs(
+        new TotalHits(totalHitCountCollector.getTotalHits(), TotalHits.Relation.EQUAL_TO),
+        new ScoreDoc[0]);
+  }
+
+  private TopDocs searchTopDocs(
+      IndexSearcher searcher,
+      ScoreDoc after,
+      Query q,
+      int n,
+      Sort sort,
+      boolean doDocScores,
+      Collector fc)
+      throws IOException {
+    TopDocsCollector<?> hitsCollector;
+    if (sort != null) {
+      collectSortFlag = 1;
+      if (after != null && (after instanceof FieldDoc) == false) {
+        throw new IllegalArgumentException("after must be a FieldDoc; got " + after);
+      }
+      hitsCollector = TopFieldCollector.create(sort, n, (FieldDoc) after, Integer.MAX_VALUE);
+    } else {
+      collectSortFlag = 0;
+      hitsCollector = TopScoreDocCollector.create(n, after, Integer.MAX_VALUE);
+    }
+    searcher.search(q, MultiCollector.wrap(hitsCollector, fc));
+    TopDocs topDocs = hitsCollector.topDocs();
+    if (doDocScores) {
+      collectScoreFlag = 1;
+      TopFieldCollector.populateScores(topDocs.scoreDocs, searcher, q);
+    }
+    collectHitBound = topDocs.scoreDocs.length;
+    return topDocs;
+  }
+
+  int boundHitCount(IndexSearcher searcher, int n) {
+    int limit = searcher.getIndexReader().maxDoc();
+    if (limit == 0) {
+      limit = 1;
+    }
+    collectHitBound = Math.min(n, limit);
+    return collectHitBound;
+  }
+
+  void validateSort(Sort sort) {
+    if (sort == null) {
+      collectSortFlag = 0;
+      throw new IllegalArgumentException("sort must not be null");
+    }
+    collectSortFlag = 1;
+  }
+
+  int afterDocumentId(ScoreDoc after) {
+    collectAfterDoc = after == null ? -1 : after.doc;
+    return collectAfterDoc;
+  }
+
+  boolean shouldPopulateScores(boolean doDocScores, Sort sort) {
+    collectScoreFlag = doDocScores ? 1 : 0;
+    collectSortFlag = sort == null ? 0 : 1;
+    return doDocScores;
+  }
+
+  DrillDownQuery buildExcludedDimensionQuery(
+      FacetsConfig config, DrillDownQuery query, Query[] queries, String excludedDimension) {
+    DrillDownQuery ddl = new DrillDownQuery(config, query.getBaseQuery());
+    query
+        .getDims()
+        .forEach(
+            (dim, pos) -> {
+              if (dim.equals(excludedDimension) == false) {
+                ddl.add(dim, queries[pos]);
+              }
+            });
+    queryDimCount = ddl.getDims().size();
+    queryClauseCount = queries.length;
+    return queryDimCount == queries.length ? null : ddl;
+  }
