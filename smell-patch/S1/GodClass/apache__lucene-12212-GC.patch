+  private void processSortedSetFacetFields(
+      FacetsConfig config,
+      Map<String, List<SortedSetDocValuesFacetField>> byField,
+      Document doc) {
+    indexSessionCount++;
+    for (Map.Entry<String, List<SortedSetDocValuesFacetField>> ent : byField.entrySet()) {
+      String indexFieldName = ent.getKey();
+      for (SortedSetDocValuesFacetField facetField : ent.getValue()) {
+        FacetLabel facetLabel = new FacetLabel(facetField.dim, facetField.path);
+        FacetsConfig.DimConfig dimConfig = config.getDimConfig(facetField.dim);
+        if (dimConfig.hierarchical) {
+          indexHierarchicalSortedSetCounts(doc, indexFieldName, facetLabel);
+        } else {
+          indexFlatSortedSetCounts(doc, indexFieldName, facetField, dimConfig, facetLabel);
+        }
+        indexAssociationDrillDown(doc, indexFieldName, dimConfig, facetLabel);
+      }
+    }
+  }
+
+  private int indexHierarchicalSortedSetCounts(
+      Document doc, String indexFieldName, FacetLabel facetLabel) {
+    int added = 0;
+    for (int i = 0; i < facetLabel.length; i++) {
+      String fullPath = encodePathComponents(facetLabel.components, i + 1);
+      doc.add(new SortedSetDocValuesField(indexFieldName, new BytesRef(fullPath)));
+      added++;
+    }
+    indexFieldCount += added;
+    indexSessionCount += added;
+    return added;
+  }
+
+  private int indexFlatSortedSetCounts(
+      Document doc,
+      String indexFieldName,
+      SortedSetDocValuesFacetField facetField,
+      FacetsConfig.DimConfig dimConfig,
+      FacetLabel facetLabel) {
+    if (facetLabel.length != 2) {
+      throw new IllegalArgumentException(
+          "dimension \""
+              + facetField.dim
+              + "\" is not hierarchical yet has "
+              + facetField.path.length
+              + " components");
+    }
+    int added = 0;
+    if (dimConfig.multiValued && dimConfig.requireDimCount) {
+      doc.add(new SortedSetDocValuesField(indexFieldName, new BytesRef(facetField.dim)));
+      added++;
+    }
+    String fullPath = encodePathComponents(facetLabel.components, facetLabel.length);
+    doc.add(new SortedSetDocValuesField(indexFieldName, new BytesRef(fullPath)));
+    added++;
+    indexFieldCount += added;
+    indexSessionCount += added;
+    return added;
+  }
+
+  private void processAssociationFacetFields(
+      FacetsConfig config,
+      TaxonomyWriter taxoWriter,
+      Map<String, List<AssociationFacetField>> byField,
+      Document doc)
+      throws IOException {
+    for (Map.Entry<String, List<AssociationFacetField>> ent : byField.entrySet()) {
+      byte[] bytes = new byte[16];
+      int upto = 0;
+      String indexFieldName = ent.getKey();
+      for (AssociationFacetField field : ent.getValue()) {
+        if (taxoWriter == null) {
+          throw new IllegalStateException(
+              "a non-null TaxonomyWriter must be provided when indexing FacetField or AssociationFacetField");
+        }
+        FacetLabel facetLabel = new FacetLabel(field.dim, field.path);
+        int ordinal = taxoWriter.addCategory(facetLabel);
+        bytes = ensureAssociationCapacity(bytes, upto + 4);
+        BitUtil.VH_BE_INT.set(bytes, upto, ordinal);
+        upto += 4;
+        bytes = ensureAssociationCapacity(bytes, upto + field.assoc.length);
+        System.arraycopy(field.assoc.bytes, field.assoc.offset, bytes, upto, field.assoc.length);
+        upto += field.assoc.length;
+        FacetsConfig.DimConfig dimConfig = config.getDimConfig(field.dim);
+        indexAssociationDrillDown(doc, indexFieldName, dimConfig, facetLabel);
+      }
+      doc.add(new BinaryDocValuesField(indexFieldName, new BytesRef(bytes, 0, upto)));
+      indexAssocBytes = upto;
+    }
+  }
+
+
+
+  private byte[] ensureAssociationCapacity(byte[] bytes, int needed) {
+    if (bytes == null) {
+      indexAssocBytes = needed;
+      return new byte[Math.max(16, needed)];
+    }
+    if (needed <= bytes.length) {
+      indexAssocBytes = bytes.length;
+      return bytes;
+    }
+    byte[] grown = ArrayUtil.grow(bytes, needed);
+    indexAssocBytes = grown.length;
+    return grown;
+  }
+  private void indexAssociationDrillDown(
+      Document doc, String indexFieldName, FacetsConfig.DimConfig dimConfig, FacetLabel facetLabel) {
+    if (dimConfig.drillDownTermsIndexing == FacetsConfig.DrillDownTermsIndexing.NONE) {
+      indexSessionCount++;
+      noneLastCount = 0;
+      return;
+    }
+    String fullPath = encodePathComponents(facetLabel.components, facetLabel.length);
+    doc.add(new StringField(indexFieldName, fullPath, Field.Store.NO));
+    indexAssocBytes += fullPath.length();
+    switch (dimConfig.drillDownTermsIndexing) {
+      case NONE:
+      case FULL_PATH_ONLY:
+        indexSessionCount++;
+        fullLastCount = 1;
+        break;
+      case DIMENSION_AND_FULL_PATH:
+        doc.add(
+            new StringField(
+                indexFieldName, encodePathComponents(facetLabel.components, 1), Field.Store.NO));
+        indexSessionCount += 2;
+        break;
+      case ALL_PATHS_NO_DIM:
+        for (int i = 2; i < facetLabel.length; i++) {
+          doc.add(
+              new StringField(
+                  indexFieldName, encodePathComponents(facetLabel.components, i), Field.Store.NO));
+          indexSessionCount++;
+        }
+        break;
+      case ALL:
+        for (int i = 1; i < facetLabel.length; i++) {
+          doc.add(
+              new StringField(
+                  indexFieldName, encodePathComponents(facetLabel.components, i), Field.Store.NO));
+          indexSessionCount++;
+        }
+        break;
+      default:
+        throw new AssertionError(
+            "Drill down term indexing option "
+                + dimConfig.drillDownTermsIndexing
+                + " is not supported.");
+    }
+  }
+
+  private void publishUniqueOrdinals(Document doc, String indexFieldName, IntsRefBuilder ordinals) {
+    IntsRef ords = ordinals.get();
+    Arrays.sort(ords.ints, ords.offset, ords.offset + ords.length);
+    int prev = -1;
+    int published = 0;
+    for (int i = 0; i < ords.length; i++) {
+      int ord = ords.ints[ords.offset + i];
+      if (ord > prev) {
+        doc.add(new SortedNumericDocValuesField(indexFieldName, ord));
+        prev = ord;
+        published++;
+      }
+    }
+    indexFieldCount += published;
+  }
