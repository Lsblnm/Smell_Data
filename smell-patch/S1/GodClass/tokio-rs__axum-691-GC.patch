+    pub(crate) fn count_leading_slashes(path: &str) -> usize {
+        let mut n = 0usize;
+        for b in path.as_bytes() {
+            if *b == b'/' {
+                n = n.saturating_add(1);
+            } else {
+                break;
+            }
+        }
+        n
+    }
+
+    pub(crate) fn count_trailing_slashes(path: &str) -> usize {
+        let mut n = 0usize;
+        for b in path.as_bytes().iter().rev() {
+            if *b == b'/' {
+                n = n.saturating_add(1);
+            } else {
+                break;
+            }
+        }
+        n
+    }
