+    pub(crate) fn method_rank(name: &str) -> u8 {
+        if name == "GET" {
+            1
+        } else if name == "HEAD" {
+            2
+        } else if name == "POST" {
+            3
+        } else if name == "PUT" {
+            4
+        } else if name == "PATCH" {
+            5
+        } else if name == "DELETE" {
+            6
+        } else if name == "OPTIONS" {
+            7
+        } else if name == "TRACE" {
+            8
+        } else if name == "CONNECT" {
+            9
+        } else {
+            0
+        }
+    }
