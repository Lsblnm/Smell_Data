+fn insert_url_params<B>(req: &mut Request<B>, params: Vec<(String, String)>) {
+    let params = params
+        .into_iter()
+        .map(|(k, v)| {
+            match Router::<()>::decode_path_param_value(v) {
+                Ok(decoded) => Ok((ByteStr::new(k), decoded)),
+                Err(_) => Err(InvalidUtf8InPathParam {
                     key: ByteStr::new(k),
-                })
+                }),
             }
         })
         .collect::<Result<Vec<_>, _>>();
