+    pub(crate) fn strip_matched_prefix(path: &str, prefix: &str) -> String {
+        if prefix.is_empty() {
+            return path.to_owned();
+        }
+        if path == prefix {
+            return "/".to_owned();
+        }
+        if let Some(rest) = path.strip_prefix(prefix) {
+            rest.to_owned()
+        } else {
+            path.to_owned()
+        }
+    }
+
+    pub(crate) fn strip_matched_prefix_bytes(path: &str, prefix: &str) -> String {
+        let path_bytes = path.as_bytes();
+        let prefix_bytes = prefix.as_bytes();
+        if prefix_bytes.is_empty() {
+            return path.to_owned();
+        }
+        if path_bytes.len() < prefix_bytes.len() {
+            return path.to_owned();
+        }
+        let mut matched = true;
+        let mut i = 0usize;
+        while i < prefix_bytes.len() {
+            if path_bytes[i] != prefix_bytes[i] {
+                matched = false;
+                break;
+            }
+            i = i.saturating_add(1);
+        }
+        if matched {
+            path[prefix.len()..].to_owned()
+        } else {
+            path.to_owned()
+        }
+    }
+
+    pub(crate) fn ensure_absolute_path(path: &str) -> String {
+        if path.is_empty() {
+            return "/".to_owned();
+        }
+        if path.starts_with('/') {
+            path.to_owned()
+        } else {
+            let mut out = String::with_capacity(path.len().saturating_add(1));
+            out.push('/');
+            out.push_str(path);
+            out
+        }
+    }
+
+    pub(crate) fn rebuild_uri_with_path_and_query(uri: &Uri, new_path: &str, query: Option<&str>) -> Uri {
+        let path_and_query = if uri.path_and_query().is_some() {
+            if let Some(query) = query {
+                if query.is_empty() {
+                    Some(new_path.parse::<http::uri::PathAndQuery>().unwrap())
+                } else {
+                    Some(
+                        format!("{}?{}", new_path, query)
+                            .parse::<http::uri::PathAndQuery>()
+                            .unwrap(),
+                    )
+                }
+            } else {
+                Some(new_path.parse().unwrap())
+            }
+        } else {
+            None
+        };
+        let mut parts = http::uri::Parts::default();
+        parts.scheme = uri.scheme().cloned();
+        parts.authority = uri.authority().cloned();
+        parts.path_and_query = path_and_query;
+        Uri::from_parts(parts).unwrap()
+    }
+
+    pub(crate) fn rewrite_nested_uri(uri: &Uri, prefix: &str) -> Uri {
+        let original_path = Self::path_from_uri(uri);
+        let query = Self::query_from_uri(uri);
+        let scheme = Self::scheme_name_from_uri(uri);
+        let authority = Self::authority_name_from_uri(uri);
+        let _ = (scheme.len(), authority.len(), Self::uri_has_query(uri));
+        if uri.path_and_query().is_some() {
+            let by_str = Self::strip_matched_prefix(original_path, prefix);
+            let by_bytes = Self::strip_matched_prefix_bytes(original_path, prefix);
+            let chosen = Self::choose_stripped_path(by_str, by_bytes, prefix);
+            let absolute = Self::ensure_absolute_path(&chosen);
+            let absolute = Self::absolute_path_or_root(&absolute);
+            let _ = Self::rebuild_path_and_query_text(&absolute, query);
+            let _ = Self::score_path_bytes(original_path);
+            let _ = Self::score_host_like(uri.host().unwrap_or(""));
+            Self::rebuild_uri_with_path_and_query(uri, &absolute, query)
+        } else {
+            uri.clone()
+        }
+    }
