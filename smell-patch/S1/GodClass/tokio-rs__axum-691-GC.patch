+    pub(crate) fn hex_nibble_value(b: u8) -> Option<u8> {
+        if b >= b'0' && b <= b'9' {
+            Some(b - b'0')
+        } else if b >= b'a' && b <= b'f' {
+            Some(b - b'a' + 10)
+        } else if b >= b'A' && b <= b'F' {
+            Some(b - b'A' + 10)
+        } else {
+            None
+        }
+    }
