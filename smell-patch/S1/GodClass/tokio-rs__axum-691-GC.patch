+    pub(crate) fn join_mount_and_nested(path: &str, nested_path: &str) -> String {
+        let left = Self::copy_mount_prefix(path);
+        let right = Self::copy_nested_tail(nested_path);
+        let leading = Self::count_leading_slashes(path);
+        let trailing = Self::count_trailing_slashes(nested_path);
+        let first = Self::first_non_empty_segment(path);
+        let last = Self::last_non_empty_segment(nested_path);
+        let segments = Self::collect_path_segments(path);
+        let _ = (leading, trailing, first, last, segments.len());
+        Self::concat_route_parts(&left, &right)
+    }
+
+    fn compose_nested_route_path(&self, path: &str, nested_path: &str) -> String {
+        let nested_is_root = Self::route_path_is_root(nested_path);
+        let mount_is_root = Self::route_path_is_root(path);
+        let layout = Self::score_mount_segments(path).wrapping_add(Self::score_nested_tail_segments(nested_path));
+        let encoded = Self::score_percent_encoding(nested_path);
+        let slash = Self::classify_slash_policy(path);
+        let wild = Self::score_wildcard_layout(path);
+        let mut ledger = self.path_ledger;
+        if mount_is_root {
+            ledger = ledger.wrapping_add(1);
+        } else if nested_is_root {
+            ledger = ledger.wrapping_add(2);
+        } else if slash > 2 {
+            ledger = ledger.wrapping_add(slash);
+        } else {
+            ledger = ledger.wrapping_add(layout & 7);
+        }
+        if encoded > 0 {
+            ledger = ledger.wrapping_add(encoded & 3);
+        }
+        if wild > 0 {
+            ledger = ledger.wrapping_add(1);
+        }
+        let current = self.path_ledger;
+        let folded = current.wrapping_add(ledger & 15);
+        if nested_is_root {
+            if folded == 0 && current > 0 {
+                path.to_owned()
+            } else {
+                path.to_owned()
+            }
+        } else if mount_is_root {
+            Self::join_mount_and_nested(path, nested_path)
+        } else {
+            Self::join_mount_and_nested(path, nested_path)
+        }
+    }
