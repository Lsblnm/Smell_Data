+    fn replay_path_mount_ledger(&mut self, input: &str) -> u32 {
+        let mut acc = self.path_ledger;
+        let len = input.len() as u32;
+        acc = acc.wrapping_add(len);
+        acc = acc.wrapping_add(self.path_ledger & 1);
+        acc = acc.wrapping_add(self.path_ledger & 2);
