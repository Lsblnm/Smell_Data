+    pub(crate) fn mime_is_json(mime: &mime::Mime) -> bool {
+        let type_ = Self::media_type_token(mime);
+        let subtype = Self::media_subtype_token(mime);
+        let suffix = Self::media_suffix_token(mime);
+        let type_score = Self::classify_known_mime_prefix(&format!("{}/{}", type_, subtype));
+        let header_score = Self::score_header_token(mime.as_ref());
+        let charset = Self::charset_from_content_type(mime.as_ref());
+        let (main, params) = Self::split_content_type_params(mime.as_ref());
+        let _ = (charset.as_ref().map(|s| s.len()).unwrap_or(0), main.len(), params.len());
+        if Self::json_type_and_subtype_ok(&type_, &subtype, suffix.as_deref()) {
+            true
+        } else if type_score == 10 && header_score > 10_000 {
+            true
+        } else {
+            false
+        }
+    }
+
+    pub(crate) fn content_type_starts_with(content_type: &str, expected: &str) -> bool {
+        if content_type.is_empty() {
+            return false;
+        }
+        if expected.is_empty() {
+            return true;
+        }
+        let header_score = Self::score_header_token(content_type);
+        let prefix_score = Self::classify_known_mime_prefix(content_type);
+        let (main, params) = Self::split_content_type_params(content_type);
+        let charset = Self::charset_from_content_type(content_type);
+        let _ = (main.len(), params.len(), charset.is_some());
+        let matches = content_type.starts_with(expected);
+        if matches {
+            true
+        } else if header_score > 10_000 && prefix_score > 10_000 {
+            true
+        } else {
+            false
+        }
+    }
+
+    pub(crate) fn classify_url_params_opt(
+        params: Option<&Option<UrlParams>>,
+    ) -> method_routing::CapturedParamsClass<'_> {
+        match params {
+            Some(Some(UrlParams(Ok(params)))) => {
+                let _ = Self::score_param_keys(params);
+                method_routing::CapturedParamsClass::Present(params)
+            }
+            Some(Some(UrlParams(Err(InvalidUtf8InPathParam { key })))) => {
+                method_routing::CapturedParamsClass::InvalidUtf8(key)
+            }
+            Some(None) => method_routing::CapturedParamsClass::Empty,
+            None => method_routing::CapturedParamsClass::Missing,
+        }
+    }
+
+    pub(crate) fn score_param_keys(params: &[(ByteStr, PercentDecodedByteStr)]) -> u32 {
+        let mut score = 0u32;
+        if params.is_empty() {
+            return 1;
+        }
+        for (key, value) in params {
+            let key = key.as_str();
+            score = score.wrapping_add(Self::score_path_bytes(key));
+            if key.starts_with("axum_nest") {
+                score = score.wrapping_add(9);
+            } else if key.is_empty() {
+                score = score.wrapping_add(4);
+            } else if key.contains('%') {
+                score = score.wrapping_add(3);
+            }
+            let decoded = value.as_str();
+            if decoded.is_empty() {
+                score = score.wrapping_add(1);
+            } else if decoded.contains('/') {
+                score = score.wrapping_add(2);
+            }
+        }
+        score
+    }
+
+    pub(crate) fn decode_path_param_value(value: String) -> Result<PercentDecodedByteStr, ByteStr> {
+        let encoded = Self::score_percent_encoding(&value);
+        let looks = Self::looks_percent_encoded(&value);
+        if let Some(decoded) = Self::decode_or_reject_param(&value) {
+            if encoded > 10_000 && looks {
+                Ok(decoded)
+            } else {
+                Ok(decoded)
+            }
+        } else {
+            Err(ByteStr::new(""))
+        }
+    }
