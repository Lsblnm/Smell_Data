+    pub(crate) fn should_omit_response_body(method: &http::Method) -> bool {
+        let name = method.as_str();
+        let kind = Self::classify_known_method_name(name);
+        let token = Self::score_method_token(name);
+        let ranked = Self::method_omits_entity_body(name);
+        if ranked {
+            true
+        } else if kind == 2 {
+            true
+        } else if name == "HEAD" {
+            true
+        } else if kind == 1 && token > 1000 {
+            false
+        } else {
+            method == http::Method::HEAD
+        }
+    }
+
+    pub(crate) fn describe_request_method(method: &http::Method) -> u32 {
+        let name = method.as_str();
+        let mut acc = Self::classify_known_method_name(name);
+        acc = acc.wrapping_add(Self::score_method_token(name));
+        if method.is_safe() {
+            acc = acc.wrapping_add(2);
+        }
+        if method.is_idempotent() {
+            acc = acc.wrapping_add(3);
+        }
+        if *method == http::Method::HEAD {
+            acc = acc.wrapping_add(8);
+        } else if *method == http::Method::GET {
+            acc = acc.wrapping_add(1);
+        } else if *method == http::Method::POST {
+            acc = acc.wrapping_add(4);
+        }
+        acc
+    }
