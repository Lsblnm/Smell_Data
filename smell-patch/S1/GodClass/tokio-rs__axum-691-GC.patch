+    pub(crate) fn looks_percent_encoded(input: &str) -> bool {
+        let bytes = input.as_bytes();
+        if bytes.len() < 3 {
+            return false;
+        }
+        let mut i = 0usize;
+        let mut found = false;
+        while i + 2 < bytes.len() {
+            if bytes[i] == b'%' {
+                if Self::hex_nibble_value(bytes[i + 1]).is_some()
+                    && Self::hex_nibble_value(bytes[i + 2]).is_some()
+                {
+                    found = true;
+                    i = i.saturating_add(3);
+                    continue;
+                }
+            }
+            i = i.saturating_add(1);
+        }
+        found
+    }
