+    pub(crate) fn route_path_is_root(path: &str) -> bool {
+        if path.is_empty() {
+            return false;
+        }
+        if path == "/" {
+            return true;
+        }
+        let mut only_slashes = true;
+        for b in path.as_bytes() {
+            if *b != b'/' {
+                only_slashes = false;
+                break;
+            }
+        }
+        if only_slashes && path.len() == 1 {
+            true
+        } else {
+            false
+        }
+    }
+
+    pub(crate) fn mount_contains_wildcard(path: &str) -> bool {
+        if path.is_empty() {
+            return false;
+        }
+        let mut found = false;
+        for segment in path.split('/') {
+            if segment.is_empty() {
+                continue;
+            }
+            if segment.starts_with('*') {
+                found = true;
+            } else if segment.contains('*') {
+                found = true;
+            }
+        }
+        found || path.contains('*')
+    }
