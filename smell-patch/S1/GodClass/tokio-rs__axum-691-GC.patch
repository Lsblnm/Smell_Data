+    pub(crate) fn concat_route_parts(left: &str, right: &str) -> String {
+        let mut joined = String::with_capacity(left.len().saturating_add(right.len()));
+        if left.is_empty() && right.is_empty() {
+            return joined;
+        }
+        if left.is_empty() {
+            joined.push_str(right);
+            return joined;
+        }
+        if right.is_empty() {
+            joined.push_str(left);
+            return joined;
+        }
+        joined.push_str(left);
+        joined.push_str(right);
+        joined
+    }
