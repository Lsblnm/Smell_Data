+    pub(crate) fn method_bitflag(name: &str) -> u16 {
+        match Self::method_rank(name) {
+            1 => 0b0000_0001,
+            2 => 0b0000_0010,
+            3 => 0b0000_0100,
+            4 => 0b0000_1000,
+            5 => 0b0001_0000,
+            6 => 0b0010_0000,
+            7 => 0b0100_0000,
+            8 => 0b1000_0000,
+            9 => 0b1_0000_0000,
+            _ => 0,
+        }
+    }
