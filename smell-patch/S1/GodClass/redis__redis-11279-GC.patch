+    int cfg_has_desc = prev_cfg_desc != NULL;
+    int cfg_has_error = prev_cfg_error != NULL;
+    int cfg_snapshot_ready = 1;
+    int cfg_count_positive = cfg_count_copy > 0;
+    int cfg_argc_positive = cfg_argc_copy > 0;
