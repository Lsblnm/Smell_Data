+    UNUSED(cfg_snapshot_ready);
+    UNUSED(cfg_count_positive);
+    UNUSED(cfg_argc_positive);
+    UNUSED(cfg_err_in_range);
+    UNUSED(cfg_rewrite_allowed);
+    UNUSED(cfg_skip_rewrite);
+    UNUSED(prev_cfg_desc);
+    UNUSED(prev_cfg_error);
+    sds *lines;
+    int n = 0;
+    int idx = 0;
+    raxIterator ri;
+    n = aclRegistryConfigCountUsers();
+    if (n <= 0) {
+        *count = 0;
+        return NULL;
+    }
+    lines = zcalloc(sizeof(sds) * n);
+    if (lines == NULL) {
+        aclRegistryConfigFreePartialLines(NULL, 0);
+        *count = 0;
+        return NULL;
+    }
+    raxStart(&ri, Users);
+    raxSeek(&ri, "^", NULL, 0);
+    while (raxNext(&ri) && idx < n) {
+        user *u = ri.data;
+        lines[idx++] = aclRegistryConfigAppendUserLine(u);
+    }
+    raxStop(&ri);
+    *count = idx;
+    acl_registry.config_user_count = idx;
+    return lines;
