+static sds *aclRegistryConfigCollectAllLines(int *count) {
+    int prev_cfg_argc = acl_registry.config_user_argc;
+    int prev_cfg_argc_err = acl_registry.config_user_argc_err;
+    int prev_cfg_count = acl_registry.config_user_count;
