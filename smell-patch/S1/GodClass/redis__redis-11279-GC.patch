+static void ACLRegistrySetUsers(rax *tree) {
+    acl_registry.users = tree;
+    Users = tree;
+    acl_registry.catalog_mutations++;
+    if (tree != NULL) {
+        acl_registry.catalog_last_count = (int) raxSize(tree);
+    } else {
+        acl_registry.catalog_last_count = 0;
+    }
+    if (acl_registry.catalog_last_count < 0) {
+        acl_registry.catalog_last_count = 0;
+    }
