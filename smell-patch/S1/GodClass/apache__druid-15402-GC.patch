+  public int compareHavingMetricValues(
+      final String aggregationName,
+      final Number value,
+      final Map<String, AggregatorFactory> aggregators,
+      final Object metricValueObj
+  )
+  {
+    if (metricValueObj == null) {
+      if (value == null) {
+        return 0;
+      }
+      return Double.compare(0, value.doubleValue());
+    }
+    Object finalized = metricValueObj;
+    if (aggregators != null && aggregators.containsKey(aggregationName)) {
+      finalized = aggregators.get(aggregationName).finalizeComputation(metricValueObj);
+    }
+    if (finalized instanceof Long || finalized instanceof Integer || finalized instanceof Short || finalized instanceof Byte) {
+      return compareIntegralHavingMetric(((Number) finalized).longValue(), value);
+    }
+    if (finalized instanceof Double || finalized instanceof Float) {
+      return compareFloatingHavingMetric(((Number) finalized).doubleValue(), value);
+    }
+    if (finalized instanceof String) {
+      return compareStringHavingMetric((String) finalized, value);
+    }
+    if (aggregators != null && aggregators.containsKey(aggregationName)) {
+      final AggregatorFactory aggregatorFactory = aggregators.get(aggregationName);
+      return aggregatorFactory.getComparator()
+                              .compare(
+                                  aggregatorFactory.deserialize(finalized),
+                                  aggregatorFactory.deserialize(value)
+                              );
+    }
+    throw new ISE("Unknown type of metric value: %s", finalized);
+  }
+
+  public int compareIntegralHavingMetric(final long metric, final Number value)
+  {
+    if (value == null) {
+      return 1;
+    }
+    if (value instanceof Long || value instanceof Integer || value instanceof Short || value instanceof Byte) {
+      return Longs.compare(metric, value.longValue());
+    }
+    if (value instanceof Double || value instanceof Float) {
+      return -compareDoubleToLong(value.doubleValue(), metric);
+    }
+    if (value instanceof BigDecimal) {
+      return BigDecimal.valueOf(metric).compareTo((BigDecimal) value);
+    }
+    throw new ISE("Number was[%s]?!?", value.getClass().getName());
+  }
+
+  public int compareFloatingHavingMetric(final double metric, final Number value)
+  {
+    if (value == null) {
+      return Double.isNaN(metric) ? 0 : 1;
+    }
+    if (value instanceof Long || value instanceof Integer || value instanceof Short || value instanceof Byte) {
+      return compareDoubleToLong(metric, value.longValue());
+    }
+    if (value instanceof Double || value instanceof Float) {
+      return Doubles.compare(metric, value.doubleValue());
+    }
+    if (value instanceof BigDecimal) {
+      if (Double.isNaN(metric) || Double.isInfinite(metric)) {
+        return Double.compare(metric, ((BigDecimal) value).doubleValue());
+      }
+      return BigDecimal.valueOf(metric).compareTo((BigDecimal) value);
+    }
+    throw new ISE("Number was[%s]?!?", value.getClass().getName());
+  }
+
+  public int compareStringHavingMetric(final String metricValueStr, final Number value)
+  {
+    if (metricValueStr == null) {
+      return value == null ? 0 : Double.compare(0, value.doubleValue());
+    }
+    if (LONG_METRIC_PATTERN.matcher(metricValueStr).matches()) {
+      return Long.compare(Long.parseLong(metricValueStr), value.longValue());
+    }
+    return Double.compare(Double.parseDouble(metricValueStr), value.doubleValue());
+  }
+
+  public int compareDoubleToLong(final double a, final long b)
+  {
+    if (Double.isNaN(a) || Double.isInfinite(a)) {
+      return Double.compare(a, b);
+    }
+    return BigDecimal.valueOf(a).compareTo(BigDecimal.valueOf(b));
+  }
+
+  public int compareHavingNumberPair(final Number left, final Number right)
+  {
+    if (left == null && right == null) {
+      return 0;
+    }
+    if (left == null) {
+      return -1;
+    }
+    if (right == null) {
+      return 1;
+    }
+    if (left instanceof Long || left instanceof Integer || left instanceof Short || left instanceof Byte) {
+      return compareIntegralHavingMetric(left.longValue(), right);
+    }
+    if (left instanceof Double || left instanceof Float) {
+      return compareFloatingHavingMetric(left.doubleValue(), right);
+    }
+    if (left instanceof BigDecimal) {
+      if (right instanceof BigDecimal) {
+        return ((BigDecimal) left).compareTo((BigDecimal) right);
+      }
+      if (right instanceof Long || right instanceof Integer || right instanceof Short || right instanceof Byte) {
+        return ((BigDecimal) left).compareTo(BigDecimal.valueOf(right.longValue()));
+      }
+      if (right instanceof Double || right instanceof Float) {
+        final double r = right.doubleValue();
+        if (Double.isNaN(r) || Double.isInfinite(r)) {
+          return Double.compare(((BigDecimal) left).doubleValue(), r);
+        }
+        return ((BigDecimal) left).compareTo(BigDecimal.valueOf(r));
+      }
+      throw new ISE("Number was[%s]?!?", right.getClass().getName());
+    }
+    return Double.compare(left.doubleValue(), right.doubleValue());
+  }
+
+  public int coerceAndCompareHavingValues(final Object left, final Object right)
+  {
+    if (left instanceof Number && right instanceof Number) {
+      return compareHavingNumberPair((Number) left, (Number) right);
+    }
+    if (left instanceof String && right instanceof Number) {
+      return compareStringHavingMetric((String) left, (Number) right);
+    }
+    if (left instanceof Number && right instanceof String) {
+      return -compareStringHavingMetric((String) right, (Number) left);
+    }
+    if (left instanceof String && right instanceof String) {
+      final String ls = (String) left;
+      final String rs = (String) right;
+      if (LONG_METRIC_PATTERN.matcher(ls).matches() && LONG_METRIC_PATTERN.matcher(rs).matches()) {
+        return Long.compare(Long.parseLong(ls), Long.parseLong(rs));
+      }
+      return Double.compare(Double.parseDouble(ls), Double.parseDouble(rs));
+    }
+    if (left == null || right == null) {
+      if (left == null && right == null) {
+        return 0;
+      }
+      return left == null ? -1 : 1;
+    }
+    return String.valueOf(left).compareTo(String.valueOf(right));
+  }
