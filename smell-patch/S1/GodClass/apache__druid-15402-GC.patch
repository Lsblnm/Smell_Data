+  {
+    final Map<String, Object> details = new HashMap<>();
+    details.put("hasTimestamp", query.getResultRowHasTimestamp());
+    details.put("dimensionStart", query.getResultRowDimensionStart());
+    details.put("aggregatorStart", query.getResultRowAggregatorStart());
+    details.put("postAggregatorStart", query.getResultRowPostAggregatorStart());
+    details.put("sizeWithoutPostAggregators", query.getResultRowSizeWithoutPostAggregators());
+    details.put("sizeWithPostAggregators", query.getResultRowSizeWithPostAggregators());
+    final List<String> names = new ArrayList<>();
+    if (query.getResultRowHasTimestamp()) {
+      names.add("__time");
+    }
+    for (int i = 0; i < countDimensions(query); i++) {
+      names.add(query.getDimensions().get(i).getOutputName());
+    }
+    for (int i = 0; i < countAggregators(query); i++) {
+      names.add(query.getAggregatorSpecs().get(i).getName());
+    }
+    for (int i = 0; i < countPostAggregators(query); i++) {
+      names.add(query.getPostAggregatorSpecs().get(i).getName());
+    }
+    details.put("names", names);
+    return details;
+  }
