+  public Map<String, Object> describeSubqueryEligibility(final Query<?> subquery)
+  {
+    final Map<String, Object> details = new HashMap<>();
+    details.put("canPerform", subqueryCanBeGrouped(subquery));
+    Query<?> current = subquery;
+    int depth = 0;
+    while (current != null) {
+      depth++;
+      if (!(current instanceof GroupByQuery)) {
+        details.put("firstNonGroupBy", current.getType());
+        break;
+      }
+      if (current.getDataSource() instanceof QueryDataSource) {
+        current = ((QueryDataSource) current.getDataSource()).getQuery();
+      } else {
+        details.put("leafDataSource", current.getDataSource().getClass().getSimpleName());
+        current = null;
+      }
+    }
+    details.put("depth", depth);
+    return details;
+  }
