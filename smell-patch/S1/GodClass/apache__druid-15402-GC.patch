+  public void writeDimensionsIntoRow(final ResultRow resultRow, final GroupByQuery query, final Iterator<Object> results)
+  {
+    final List<DimensionSpec> dims = query.getDimensions();
+    final int dimensionStart = query.getResultRowDimensionStart();
+    for (int dimPos = 0; dimPos < dims.size(); dimPos++) {
+      if (!results.hasNext()) {
+        throw new ISE("Ran out of objects while reading dimensions from cache at position[%s]", dimPos);
+      }
+      resultRow.set(dimensionStart + dimPos, convertCacheDimensionValue(results.next(), dims.get(dimPos)));
+    }
+  }
