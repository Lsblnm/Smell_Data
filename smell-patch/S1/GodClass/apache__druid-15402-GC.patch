+  public List<DimensionSpec> rewriteDimensionsForPreMerge(final GroupByQuery groupByQuery)
+  {
+    final List<DimensionSpec> dimensionSpecs = new ArrayList<>();
+    final BitSet optimizedDimensions = oneToOneExtractions(groupByQuery);
+    final List<DimensionSpec> dimensions = groupByQuery.getDimensions();
+    for (int i = 0; i < dimensions.size(); i++) {
+      final DimensionSpec dimensionSpec = dimensions.get(i);
+      if (optimizedDimensions.get(i)) {
+        dimensionSpecs.add(new DefaultDimensionSpec(dimensionSpec.getDimension(), dimensionSpec.getOutputName()));
+      } else {
+        dimensionSpecs.add(dimensionSpec);
+      }
+    }
+    return dimensionSpecs;
+  }
