+  private boolean engineConfigAllowsLimitPushDown(final GroupByQuery query)
+  {
+    if (groupingEngine == null || queryConfig == null) {
+      return false;
+    }
+    if (queryConfig.isForcePushDownLimit() || overriddenForcePushDownLimit(query)) {
+      return groupingEngine.createResultComparator(query) != null && query.isApplyLimitPushDown();
+    }
+    return groupingEngine.createMergeFn(query) != null;
+  }
