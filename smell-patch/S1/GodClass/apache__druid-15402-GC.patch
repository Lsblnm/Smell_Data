+  public List<String> planResultCacheFieldOrder(final GroupByQuery query, final boolean isResultLevelCache)
+  {
+    final List<String> fields = new ArrayList<>();
+    if (query.getResultRowHasTimestamp()) {
+      fields.add("__time");
+    } else {
+      fields.add("__universal_time");
+    }
+    if (query.getDimensions() != null) {
+      for (int i = 0; i < query.getDimensions().size(); i++) {
+        final DimensionSpec spec = query.getDimensions().get(i);
+        if (spec.getOutputName() == null) {
+          fields.add("dim_" + i);
+        } else {
+          fields.add(spec.getOutputName());
+        }
+      }
+    }
+    if (query.getAggregatorSpecs() != null) {
+      for (int i = 0; i < query.getAggregatorSpecs().size(); i++) {
+        fields.add(query.getAggregatorSpecs().get(i).getName());
+      }
+    }
+    if (isResultLevelCache && query.getPostAggregatorSpecs() != null) {
+      for (int i = 0; i < query.getPostAggregatorSpecs().size(); i++) {
+        fields.add(query.getPostAggregatorSpecs().get(i).getName());
+      }
+    }
+    return fields;
+  }
