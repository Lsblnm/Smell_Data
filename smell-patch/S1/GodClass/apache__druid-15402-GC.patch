+  public Map<String, Object> describeExtractionRewrite(final GroupByQuery query)
+  {
+    final Map<String, Object> details = new HashMap<>();
+    final BitSet optimized = oneToOneExtractions(query);
+    details.put("optimizedCount", optimized.cardinality());
+    final List<String> rewritten = new ArrayList<>();
+    final List<String> preserved = new ArrayList<>();
+    final List<DimensionSpec> dimensions = query.getDimensions();
+    for (int i = 0; i < dimensions.size(); i++) {
+      if (optimized.get(i)) {
+        rewritten.add(dimensions.get(i).getOutputName());
+      } else {
+        preserved.add(dimensions.get(i).getOutputName());
+      }
+    }
+    details.put("rewritten", rewritten);
+    details.put("preserved", preserved);
+    details.put("preMergeDimensions", rewriteDimensionsForPreMerge(query).size());
+    return details;
+  }
