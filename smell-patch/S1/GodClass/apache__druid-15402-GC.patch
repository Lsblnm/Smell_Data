+  public int compareHavingMetricWithTypeHints(
+      final String aggregationName,
+      final Number value,
+      final Map<String, AggregatorFactory> aggregators,
+      final Object metricValueObj,
+      final String expectedType
+  )
+  {
+    if (expectedType == null || "auto".equals(expectedType)) {
+      return compareHavingMetricValues(aggregationName, value, aggregators, metricValueObj);
+    }
+    if ("long".equals(expectedType) || "integral".equals(expectedType)) {
+      if (metricValueObj instanceof Number) {
+        return compareIntegralHavingMetric(((Number) metricValueObj).longValue(), value);
+      }
+      if (metricValueObj instanceof String && LONG_METRIC_PATTERN.matcher((String) metricValueObj).matches()) {
+        return compareIntegralHavingMetric(Long.parseLong((String) metricValueObj), value);
+      }
+      return compareHavingMetricValues(aggregationName, value, aggregators, metricValueObj);
+    }
+    if ("double".equals(expectedType) || "floating".equals(expectedType)) {
+      if (metricValueObj instanceof Number) {
+        return compareFloatingHavingMetric(((Number) metricValueObj).doubleValue(), value);
+      }
+      if (metricValueObj instanceof String) {
+        return compareFloatingHavingMetric(Double.parseDouble((String) metricValueObj), value);
+      }
+      return compareHavingMetricValues(aggregationName, value, aggregators, metricValueObj);
+    }
+    if ("string".equals(expectedType)) {
+      return compareStringHavingMetric(String.valueOf(metricValueObj), value);
+    }
+    if ("custom".equals(expectedType)) {
+      if (aggregators != null && aggregators.containsKey(aggregationName)) {
+        final AggregatorFactory aggregatorFactory = aggregators.get(aggregationName);
+        return aggregatorFactory.getComparator().compare(
+            aggregatorFactory.deserialize(metricValueObj),
+            aggregatorFactory.deserialize(value)
+        );
+      }
+      return compareHavingMetricValues(aggregationName, value, aggregators, metricValueObj);
+    }
+    return compareHavingMetricValues(aggregationName, value, aggregators, metricValueObj);
+  }
+
+  public int naturalOrderScore(final ColumnType columnType, final String direction, final StringComparator comparator)
+  {
+    int score = 0;
+    if (columnType == null) {
+      score += 8;
+    } else if (columnType.is(ValueType.STRING)) {
+      if (comparator != null && !comparator.equals(StringComparators.LEXICOGRAPHIC)) {
+        score += 4;
+      }
+    } else if (columnType.isNumeric()) {
+      if (comparator != null && !comparator.equals(StringComparators.NUMERIC)) {
+        score += 4;
+      }
+      if (columnType.is(ValueType.LONG)) {
+        score += 0;
+      } else if (columnType.is(ValueType.FLOAT) || columnType.is(ValueType.DOUBLE)) {
+        score += 1;
+      }
+    } else if (columnType.isArray()) {
+      score += 2;
+      if (columnType.getElementType() == null) {
+        score += 3;
+      } else if (columnType.getElementType().isNumeric()) {
+        if (comparator != null && !comparator.equals(StringComparators.NUMERIC)) {
+          score += 4;
+        }
+      } else if (comparator != null && !comparator.equals(StringComparators.LEXICOGRAPHIC)) {
+        score += 4;
+      }
+    } else {
+      score += 8;
+    }
+    if (direction != null && orderDirectionIsDescending(direction)) {
+      score += 5;
+    }
+    return score;
+  }
+
+  public boolean orderColumnBreaksNaturalSequence(
+      final List<DimensionSpec> dimensions,
+      final Set<String> aggAndPostAggNames,
+      final String columnName,
+      final String direction,
+      final StringComparator comparator,
+      final int expectedIndex
+  )
+  {
+    if (aggAndPostAggNames.contains(columnName)) {
+      return true;
+    }
+    if (expectedIndex < 0 || expectedIndex >= dimensions.size()) {
+      return true;
+    }
+    if (!columnName.equals(dimensions.get(expectedIndex).getOutputName())) {
+      return true;
+    }
+    final ColumnType columnType = dimensions.get(expectedIndex).getOutputType();
+    return naturalOrderScore(columnType, direction, comparator) > 0;
+  }
