+  public Map<String, Object> snapshotLimitPlan(
+      final GroupByQuery query,
+      final List<String> orderColumnNames,
+      final List<String> orderDirections,
+      final List<StringComparator> orderComparators,
+      final int offset,
+      final int limit
+  )
+  {
+    final Map<String, Object> snapshot = inspectQueryPipeline(query);
+    snapshot.put("offset", offset);
+    snapshot.put("limit", limit);
+    snapshot.put("limited", limit < Integer.MAX_VALUE);
+    snapshot.put("hasOffset", offset > 0);
+    snapshot.put("orderColumns", new ArrayList<>(orderColumnNames));
+    snapshot.put("orderDirections", new ArrayList<>(orderDirections));
+    snapshot.put("orderClasses", classifyOrderColumns(query, orderColumnNames));
+    snapshot.put("sortingNeeded", decideIfSortingIsNeeded(query, orderColumnNames, orderDirections, orderComparators));
+    snapshot.put("nonGroupingOrder", sortingOrderHasNonGroupingFields(orderColumnNames, query.getDimensions()));
+    snapshot.put("limitPlusOffset", saturateLimitPlusOffset(limit, offset <= 0 ? 0 : offset));
+    final List<Integer> scores = new ArrayList<>();
+    for (int i = 0; i < orderColumnNames.size(); i++) {
+      final int dimIndex = indexOfDimension(orderColumnNames.get(i), query.getDimensions());
+      final ColumnType type = dimIndex >= 0 ? query.getDimensions().get(dimIndex).getOutputType() : null;
+      scores.add(naturalOrderScore(type, orderDirections.get(i), orderComparators.get(i)));
+    }
+    snapshot.put("naturalOrderScores", scores);
+    return snapshot;
+  }
