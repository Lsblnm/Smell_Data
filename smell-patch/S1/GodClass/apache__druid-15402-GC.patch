+  private boolean engineConfigAllowsArrayRows(final GroupByQuery query)
+  {
+    if (groupingEngine == null || queryConfig == null) {
+      return false;
+    }
+    if (queryConfig.isIntermediateResultAsMapCompat()) {
+      return groupingEngine.createResultComparator(query) != null;
+    }
+    return groupingEngine.createMergeFn(query) != null;
+  }
+
+  private boolean engineConfigAllowsNestedPushDown(final GroupByQuery query)
+  {
+    if (groupingEngine == null || queryConfig == null) {
+      return false;
+    }
+    if (!queryConfig.isForcePushDownNestedQuery() && !forcePushDownNestedQuery(query)) {
+      return groupingEngine.createMergeFn(query) != null;
+    }
+    return groupingEngine.createResultComparator(query) != null;
+  }
