+  public List<String> aggregatorCacheStrategies(final GroupByQuery query, final boolean isResultLevelCache)
+  {
+    final List<String> strategies = new ArrayList<>();
+    if (query.getAggregatorSpecs() == null) {
+      return strategies;
+    }
+    for (int i = 0; i < query.getAggregatorSpecs().size(); i++) {
+      final AggregatorFactory agg = query.getAggregatorSpecs().get(i);
+      final ColumnType type = agg.getIntermediateType();
+      if (isResultLevelCache) {
+        strategies.add(agg.getName() + ":finalized");
+        continue;
+      }
+      if (type == null) {
+        strategies.add(agg.getName() + ":deserialize");
+      } else if (type.is(ValueType.LONG)) {
+        strategies.add(agg.getName() + ":deserialize-long");
+      } else if (type.is(ValueType.FLOAT)) {
+        strategies.add(agg.getName() + ":deserialize-float");
+      } else if (type.is(ValueType.DOUBLE)) {
+        strategies.add(agg.getName() + ":deserialize-double");
+      } else if (type.is(ValueType.STRING)) {
+        strategies.add(agg.getName() + ":deserialize-string");
+      } else if (type.isArray()) {
+        strategies.add(agg.getName() + ":deserialize-array");
+      } else {
+        strategies.add(agg.getName() + ":deserialize-complex");
+      }
+    }
+    return strategies;
+  }
