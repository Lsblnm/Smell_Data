+  public void writePostAggregatorsIntoRow(final ResultRow resultRow, final GroupByQuery query, final Iterator<Object> results)
+  {
+    final int postAggregatorStart = query.getResultRowPostAggregatorStart();
+    final int postAggregatorCount = countPostAggregators(query);
+    for (int postPos = 0; postPos < postAggregatorCount; postPos++) {
+      if (!results.hasNext()) {
+        throw new ISE("Ran out of objects while reading post aggregators from cache at position[%s]", postPos);
+      }
+      resultRow.set(postAggregatorStart + postPos, results.next());
+    }
+  }
