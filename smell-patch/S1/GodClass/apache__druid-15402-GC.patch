+  public List<String> describeHavingMetricPath(final Object metricValueObj, final Number value)
+  {
+    final List<String> path = new ArrayList<>();
+    if (metricValueObj == null) {
+      path.add("null-metric");
+      path.add(value == null ? "null-threshold" : "numeric-threshold");
+      return path;
+    }
+    path.add(describeMetricValue(metricValueObj));
+    if (metricValueObj instanceof Long || metricValueObj instanceof Integer || metricValueObj instanceof Short || metricValueObj instanceof Byte) {
+      path.add("integral-metric");
+      if (value instanceof Long || value instanceof Integer || value instanceof Short || value instanceof Byte) {
+        path.add("integral-threshold");
+      } else if (value instanceof Double || value instanceof Float) {
+        path.add("floating-threshold");
+      } else if (value instanceof BigDecimal) {
+        path.add("decimal-threshold");
+      } else {
+        path.add("other-threshold");
+      }
+    } else if (metricValueObj instanceof Double || metricValueObj instanceof Float) {
+      path.add("floating-metric");
+      if (value instanceof Long || value instanceof Integer) {
+        path.add("integral-threshold");
+      } else if (value instanceof Double || value instanceof Float) {
+        path.add("floating-threshold");
+      } else {
+        path.add("other-threshold");
+      }
+    } else if (metricValueObj instanceof String) {
+      path.add("string-metric");
+      if (LONG_METRIC_PATTERN.matcher((String) metricValueObj).matches()) {
+        path.add("string-long");
+      } else {
+        path.add("string-double");
+      }
+    } else {
+      path.add("custom-metric");
+    }
+    return path;
+  }
