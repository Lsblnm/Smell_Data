+  public Map<String, Object> describeResultCacheLayout(final GroupByQuery query, final boolean isResultLevelCache)
+  {
+    final Map<String, Object> layout = new HashMap<>();
+    layout.put("hasTimestamp", query.getResultRowHasTimestamp());
+    layout.put("dimensionStart", query.getResultRowDimensionStart());
+    layout.put("aggregatorStart", query.getResultRowAggregatorStart());
+    layout.put("postAggregatorStart", query.getResultRowPostAggregatorStart());
+    layout.put("rowSize", isResultLevelCache ? query.getResultRowSizeWithPostAggregators() : query.getResultRowSizeWithoutPostAggregators());
+    layout.put("dimensionCount", countDimensions(query));
+    layout.put("aggregatorCount", countAggregators(query));
+    layout.put("postAggregatorCount", isResultLevelCache ? countPostAggregators(query) : 0);
+    layout.put("fieldOrder", planResultCacheFieldOrder(query, isResultLevelCache));
+    layout.put("aggregatorStrategies", aggregatorCacheStrategies(query, isResultLevelCache));
+    layout.put("multiplePostAggregators", postAggregatorsRequireIndependentCacheSlots(query));
+    layout.put("postAggregatorReadCount", postAggregatorCacheReadCount(query, isResultLevelCache));
+    layout.put("cachedRowParts", estimateCachedRowParts(query, isResultLevelCache));
+    if (query.getUniversalTimestamp() == null) {
+      layout.put("universalTimestamp", null);
+    } else {
+      layout.put("universalTimestamp", query.getUniversalTimestamp().getMillis());
+    }
+    layout.put("dimensionSlots", planDimensionCacheSlots(query));
+    layout.put("aggregatorSlots", planAggregatorCacheSlots(query, isResultLevelCache));
+    if (isResultLevelCache) {
+      layout.put("postAggregatorSlots", planPostAggregatorCacheSlots(query));
+    }
+    return layout;
+  }
