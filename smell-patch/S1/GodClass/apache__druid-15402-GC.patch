+  public List<Object> prepareRowForCache(final ResultRow resultRow, final GroupByQuery query, final boolean isResultLevelCache)
+  {
+    final List<Object> retVal = new ArrayList<>(
+        1 + countDimensions(query) + countAggregators(query) + (isResultLevelCache ? countPostAggregators(query) : 0)
+    );
+    int inPos = 0;
+    if (query.getResultRowHasTimestamp()) {
+      retVal.add(resultRow.getLong(inPos++));
+    } else {
+      retVal.add(query.getUniversalTimestamp().getMillis());
+    }
+    for (int i = 0; i < countDimensions(query); i++) {
+      retVal.add(resultRow.get(inPos++));
+    }
+    for (int i = 0; i < countAggregators(query); i++) {
+      retVal.add(resultRow.get(inPos++));
+    }
+    if (isResultLevelCache) {
+      for (int i = 0; i < countPostAggregators(query); i++) {
+        retVal.add(resultRow.get(inPos++));
+      }
+    }
+    return retVal;
+  }
