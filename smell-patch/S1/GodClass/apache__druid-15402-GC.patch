+  public String describeMetricValue(final Object metricValueObj)
+  {
+    if (metricValueObj == null) {
+      return "null";
+    }
+    if (metricValueObj instanceof Long) {
+      return "long:" + metricValueObj;
+    }
+    if (metricValueObj instanceof Integer) {
+      return "int:" + metricValueObj;
+    }
+    if (metricValueObj instanceof Short) {
+      return "short:" + metricValueObj;
+    }
+    if (metricValueObj instanceof Byte) {
+      return "byte:" + metricValueObj;
+    }
+    if (metricValueObj instanceof Double) {
+      final double d = (Double) metricValueObj;
+      if (Double.isNaN(d)) {
+        return "double:NaN";
+      }
+      if (Double.isInfinite(d)) {
+        return d > 0 ? "double:+Inf" : "double:-Inf";
+      }
+      return "double:" + d;
+    }
+    if (metricValueObj instanceof Float) {
+      final float f = (Float) metricValueObj;
+      if (Float.isNaN(f)) {
+        return "float:NaN";
+      }
+      if (Float.isInfinite(f)) {
+        return f > 0 ? "float:+Inf" : "float:-Inf";
+      }
+      return "float:" + f;
+    }
+    if (metricValueObj instanceof BigDecimal) {
+      return "decimal:" + metricValueObj;
+    }
+    if (metricValueObj instanceof String) {
+      final String s = (String) metricValueObj;
+      if (LONG_METRIC_PATTERN.matcher(s).matches()) {
+        return "string-long:" + s;
+      }
+      return "string:" + s;
+    }
+    return metricValueObj.getClass().getName();
+  }
