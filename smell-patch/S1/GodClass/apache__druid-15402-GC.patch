+  public Function<Sequence<ResultRow>, Sequence<ResultRow>> planLimitAndOffset(
+      final GroupByQuery query,
+      final List<String> orderColumnNames,
+      final List<String> orderDirections,
+      final List<StringComparator> orderComparators,
+      final int offset,
+      final int limit
+  )
+  {
+    validateOffsetAndLimit(offset, limit);
+    final boolean sortingNeeded = decideIfSortingIsNeeded(query, orderColumnNames, orderDirections, orderComparators);
+    final Function<Sequence<ResultRow>, Sequence<ResultRow>> sortAndLimitFn;
+    if (sortingNeeded) {
+      final Ordering<ResultRow> ordering = makeResultRowOrdering(
+          query,
+          orderColumnNames,
+          orderDirections,
+          orderComparators
+      );
+      if (limit < Integer.MAX_VALUE) {
+        sortAndLimitFn = results -> new TopNSequence<>(results, ordering, saturateLimitPlusOffset(limit, offset));
+      } else {
+        sortAndLimitFn = results -> Sequences.sort(results, ordering).limit(saturateLimitPlusOffset(limit, offset));
+      }
+    } else if (limit < Integer.MAX_VALUE) {
+      sortAndLimitFn = results -> results.limit(saturateLimitPlusOffset(limit, offset));
+    } else {
+      sortAndLimitFn = Functions.identity();
+    }
+    if (offset > 0) {
+      return results -> sortAndLimitFn.apply(results).skip(offset);
+    }
+    return sortAndLimitFn;
+  }
+
+  public boolean decideIfSortingIsNeeded(
+      final GroupByQuery query,
+      final List<String> orderColumnNames,
+      final List<String> orderDirections,
+      final List<StringComparator> orderComparators
+  )
+  {
+    final List<DimensionSpec> dimensions = query.getDimensions();
+    if (dimensions.size() < orderColumnNames.size()) {
+      return true;
+    }
+    final Set<String> aggAndPostAggNames = collectAggregatorAndPostAggregatorNames(query);
+    for (int i = 0; i < orderColumnNames.size(); i++) {
+      final String columnName = orderColumnNames.get(i);
+      if (aggAndPostAggNames.contains(columnName)) {
+        return true;
+      }
+      final ColumnType columnType = resolveOrderByDimensionType(columnName, dimensions);
+      final StringComparator naturalComparator = naturalComparatorForColumnType(columnType);
+      if (naturalComparator == null) {
+        return true;
+      }
+      if (!"ASCENDING".equals(orderDirections.get(i))) {
+        return true;
+      }
+      if (!orderComparators.get(i).equals(naturalComparator)) {
+        return true;
+      }
+      if (!columnName.equals(dimensions.get(i).getOutputName())) {
+        return true;
+      }
+    }
+    if (query.getGranularity() != null
+        && !query.getGranularity().equals(Granularities.ALL)
+        && query.getContextSortByDimsFirst()) {
+      return true;
+    }
+    final QueryContext queryContext = query.context();
+    final String timestampField = queryContext.getString(GroupByQuery.CTX_TIMESTAMP_RESULT_FIELD);
+    if (timestampField != null && !timestampField.isEmpty()) {
+      final int timestampResultFieldIndex = queryContext.getInt(GroupByQuery.CTX_TIMESTAMP_RESULT_FIELD_INDEX);
+      if (query.getContextSortByDimsFirst()) {
+        return timestampResultFieldIndex != query.getDimensions().size() - 1;
+      }
+      return timestampResultFieldIndex != 0;
+    }
+    return false;
+  }
+
+  public Set<String> collectAggregatorAndPostAggregatorNames(final GroupByQuery query)
+  {
+    final Set<String> names = new HashSet<>();
+    if (query.getAggregatorSpecs() != null) {
+      for (int i = 0; i < query.getAggregatorSpecs().size(); i++) {
+        names.add(query.getAggregatorSpecs().get(i).getName());
+      }
+    }
+    if (query.getPostAggregatorSpecs() != null) {
+      for (int i = 0; i < query.getPostAggregatorSpecs().size(); i++) {
+        names.add(query.getPostAggregatorSpecs().get(i).getName());
+      }
+    }
+    return names;
+  }
+
+  public ColumnType resolveOrderByDimensionType(final String columnName, final List<DimensionSpec> dimensions)
+  {
+    for (int i = 0; i < dimensions.size(); i++) {
+      final DimensionSpec dimSpec = dimensions.get(i);
+      if (columnName.equals(dimSpec.getOutputName())) {
+        return dimSpec.getOutputType();
+      }
+    }
+    throw new ISE("Unknown column in order clause[%s]", columnName);
+  }
+
+  public StringComparator naturalComparatorForColumnType(final ColumnType columnType)
+  {
+    if (columnType == null) {
+      return null;
+    }
+    if (columnType.is(ValueType.STRING)) {
+      return StringComparators.LEXICOGRAPHIC;
+    }
+    if (columnType.isNumeric()) {
+      return StringComparators.NUMERIC;
+    }
+    if (columnType.isArray()) {
+      if (columnType.getElementType() != null && columnType.getElementType().isNumeric()) {
+        return StringComparators.NUMERIC;
+      }
+      return StringComparators.LEXICOGRAPHIC;
+    }
+    return null;
+  }
+
+  public int saturateLimitPlusOffset(final int limit, final int offset)
+  {
+    if (limit == Integer.MAX_VALUE) {
+      return Integer.MAX_VALUE;
+    }
+    if (offset <= 0) {
+      return limit;
+    }
+    if (limit > Integer.MAX_VALUE - offset) {
+      throw new ISE("Cannot apply limit[%d] with offset[%d] due to overflow", limit, offset);
+    }
+    return limit + offset;
+  }
+
+  public void validateOffsetAndLimit(final int offset, final int limit)
+  {
+    if (offset < 0) {
+      throw new ISE("offset[%s] must be >= 0", offset);
+    }
+    if (limit <= 0) {
+      throw new ISE("limit[%s] must be > 0", limit);
+    }
+  }
