+    details.put("applyLimitPushDown", query.isApplyLimitPushDown());
+    details.put("nestedPushDown", isNestedQueryPushDown(query));
+    details.put("limitPushDownApplies", limitPushDownApplies(query));
+    if (query.getGranularity() == null) {
+      details.put("granularity", "missing");
+    } else if (query.getGranularity().equals(Granularities.ALL)) {
+      details.put("granularity", "all");
+    } else {
+      details.put("granularity", query.getGranularity().toString());
+    }
+    if (query.getUniversalTimestamp() == null) {
+      details.put("universalTimestamp", null);
+    } else {
+      details.put("universalTimestamp", query.getUniversalTimestamp().getMillis());
+    }
+    return details;
