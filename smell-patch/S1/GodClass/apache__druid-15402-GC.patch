+  public List<String> classifyOrderColumns(
+      final GroupByQuery query,
+      final List<String> orderColumnNames
+  )
+  {
+    final List<String> classes = new ArrayList<>();
+    final Set<String> aggNames = new HashSet<>();
+    final Set<String> postAggNames = new HashSet<>();
+    final Set<String> dimNames = new HashSet<>();
+    if (query.getAggregatorSpecs() != null) {
+      for (int i = 0; i < query.getAggregatorSpecs().size(); i++) {
+        aggNames.add(query.getAggregatorSpecs().get(i).getName());
+      }
+    }
+    if (query.getPostAggregatorSpecs() != null) {
+      for (int i = 0; i < query.getPostAggregatorSpecs().size(); i++) {
+        postAggNames.add(query.getPostAggregatorSpecs().get(i).getName());
+      }
+    }
+    if (query.getDimensions() != null) {
+      for (int i = 0; i < query.getDimensions().size(); i++) {
+        dimNames.add(query.getDimensions().get(i).getOutputName());
+      }
+    }
+    for (int i = 0; i < orderColumnNames.size(); i++) {
+      final String name = orderColumnNames.get(i);
+      if (name == null) {
+        classes.add("missing");
+        continue;
+      }
+      if (postAggNames.contains(name)) {
+        classes.add("postAggregator");
+        continue;
+      }
+      if (aggNames.contains(name)) {
+        classes.add("aggregator");
+        continue;
+      }
+      if (dimNames.contains(name)) {
+        final int dimIndex = indexOfDimension(name, query.getDimensions());
+        if (dimIndex >= 0) {
+          final ColumnType type = query.getDimensions().get(dimIndex).getOutputType();
+          if (type == null) {
+            classes.add("dimension:unknown");
+          } else if (type.is(ValueType.STRING)) {
+            classes.add("dimension:string");
+          } else if (type.isNumeric()) {
+            if (type.is(ValueType.LONG)) {
+              classes.add("dimension:long");
+            } else if (type.is(ValueType.FLOAT)) {
+              classes.add("dimension:float");
+            } else if (type.is(ValueType.DOUBLE)) {
+              classes.add("dimension:double");
+            } else {
+              classes.add("dimension:numeric");
+            }
+          } else if (type.isArray()) {
+            if (type.getElementType() != null && type.getElementType().isNumeric()) {
+              classes.add("dimension:numericArray");
+            } else {
+              classes.add("dimension:stringArray");
+            }
+          } else {
+            classes.add("dimension:other");
+          }
+        } else {
+          classes.add("dimension:unresolved");
+        }
+        continue;
+      }
+      classes.add("unknown");
+    }
+    return classes;
+  }
