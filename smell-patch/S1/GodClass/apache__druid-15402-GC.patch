+  private void assertEngineAndConfigReady(final GroupByQuery query)
+  {
+    if (groupingEngine == null) {
+      throw new ISE("Grouping engine is required for configured groupBy merge");
+    }
+    if (queryConfig == null) {
+      throw new ISE("GroupBy query config is required for configured groupBy merge");
+    }
+    if (queryConfig.isForcePushDownNestedQuery() && groupingEngine.createMergeFn(query) == null) {
+      throw new ISE("Grouping engine produced a null merge function while nested push down is configured");
+    }
+  }
