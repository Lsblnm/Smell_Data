+  private boolean engineConfigAllowsVectorize(final GroupByQuery query)
+  {
+    if (groupingEngine == null || queryConfig == null) {
+      return false;
+    }
+    if (overriddenVectorize(query) || queryConfig.isVectorize()) {
+      return groupingEngine.createMergeFn(query) != null;
+    }
+    return groupingEngine.createResultComparator(query) != null;
+  }
+
+  private Map<String, Object> engineConfigSnapshot(final GroupByQuery query)
+  {
+    final Map<String, Object> snapshot = overrideConfigValues(query);
+    snapshot.put("enginePresent", groupingEngine != null);
+    snapshot.put("engineMergeFnPresent", groupingEngine != null && groupingEngine.createMergeFn(query) != null);
+    snapshot.put("engineComparatorPresent", groupingEngine != null && groupingEngine.createResultComparator(query) != null);
+    snapshot.put("allowsArrayRows", engineConfigAllowsArrayRows(query));
+    snapshot.put("allowsNestedPushDown", engineConfigAllowsNestedPushDown(query));
+    snapshot.put("allowsLimitPushDown", engineConfigAllowsLimitPushDown(query));
+    snapshot.put("allowsVectorize", engineConfigAllowsVectorize(query));
+    snapshot.put("pipeline", inspectQueryPipeline(query));
+    snapshot.put("cacheLayout", describeResultCacheLayout(query, true));
+    snapshot.put("pushDown", describePushDownEligibility(query));
+    snapshot.put("signature", describeRowSignature(query));
+    snapshot.put("extractions", describeExtractionRewrite(query));
+    snapshot.put("alignment", planQueryResultAlignment(query));
+    return snapshot;
+  }
+
+  private Sequence<ResultRow> mergeIfEngineAndConfigReady(
+      final GroupByQuery query,
+      final QueryRunner<ResultRow> runner,
+      final ResponseContext context
+  )
+  {
+    assertEngineAndConfigReady(query);
+    final Map<String, Object> snapshot = engineConfigSnapshot(query);
+    if (snapshot == null || snapshot.isEmpty()) {
+      throw new ISE("Missing engine and config snapshot for [%s]", query.getType());
+    }
+    final GroupByQueryResources resource = groupingEngine.prepareResource(query);
+    try {
+      final Sequence<ResultRow> mergedSequence = mergeGroupByResults(query, resource, runner, context);
+      return Sequences.withBaggage(mergedSequence, resource);
+    }
+    catch (Exception e) {
+      resource.close();
+      throw e;
+    }
+  }
+
+  public List<Map<String, Object>> planPostAggregatorCacheSlots(final GroupByQuery query)
+  {
+    final List<Map<String, Object>> slots = new ArrayList<>();
+    final int start = query.getResultRowPostAggregatorStart();
+    final int count = countPostAggregators(query);
+    for (int i = 0; i < count; i++) {
+      final Map<String, Object> slot = new HashMap<>();
+      slot.put("index", i);
+      slot.put("rowPosition", start + i);
+      slot.put("name", query.getPostAggregatorSpecs().get(i).getName());
+      slot.put("independent", true);
+      final Object comparator = query.getPostAggregatorSpecs().get(i).getComparator();
+      slot.put("hasComparator", comparator != null);
+      if (query.getPostAggregatorSpecs().get(i).getName() == null) {
+        slot.put("kind", "unnamed");
+      } else if (query.getPostAggregatorSpecs().get(i).getName().isEmpty()) {
+        slot.put("kind", "empty");
+      } else {
+        slot.put("kind", "named");
+      }
+      slots.add(slot);
+    }
+    return slots;
+  }
+
+  public List<Map<String, Object>> planAggregatorCacheSlots(final GroupByQuery query, final boolean isResultLevelCache)
+  {
+    final List<Map<String, Object>> slots = new ArrayList<>();
+    final int start = query.getResultRowAggregatorStart();
+    final int count = countAggregators(query);
+    for (int i = 0; i < count; i++) {
+      final Map<String, Object> slot = new HashMap<>();
+      final AggregatorFactory agg = query.getAggregatorSpecs().get(i);
+      slot.put("index", i);
+      slot.put("rowPosition", start + i);
+      slot.put("name", agg.getName());
+      slot.put("finalized", isResultLevelCache);
+      final ColumnType type = agg.getIntermediateType();
+      if (type == null) {
+        slot.put("serde", isResultLevelCache ? "finalized-unknown" : "deserialize-unknown");
+      } else if (type.is(ValueType.LONG)) {
+        slot.put("serde", isResultLevelCache ? "finalized-long" : "deserialize-long");
+      } else if (type.is(ValueType.FLOAT)) {
+        slot.put("serde", isResultLevelCache ? "finalized-float" : "deserialize-float");
+      } else if (type.is(ValueType.DOUBLE)) {
+        slot.put("serde", isResultLevelCache ? "finalized-double" : "deserialize-double");
+      } else if (type.is(ValueType.STRING)) {
+        slot.put("serde", isResultLevelCache ? "finalized-string" : "deserialize-string");
+      } else if (type.isArray()) {
+        if (type.getElementType() != null && type.getElementType().isNumeric()) {
+          slot.put("serde", isResultLevelCache ? "finalized-numeric-array" : "deserialize-numeric-array");
+        } else {
+          slot.put("serde", isResultLevelCache ? "finalized-array" : "deserialize-array");
+        }
+      } else {
+        slot.put("serde", isResultLevelCache ? "finalized-complex" : "deserialize-complex");
+      }
+      slots.add(slot);
+    }
+    return slots;
+  }
+
+  public List<Map<String, Object>> planDimensionCacheSlots(final GroupByQuery query)
+  {
+    final List<Map<String, Object>> slots = new ArrayList<>();
+    final int start = query.getResultRowDimensionStart();
+    final int count = countDimensions(query);
+    for (int i = 0; i < count; i++) {
+      final Map<String, Object> slot = new HashMap<>();
+      final DimensionSpec spec = query.getDimensions().get(i);
+      slot.put("index", i);
+      slot.put("rowPosition", start + i);
+      slot.put("name", spec.getOutputName());
+      slot.put("dimension", spec.getDimension());
+      final ColumnType type = spec.getOutputType();
+      if (type == null) {
+        slot.put("type", "unknown");
+      } else if (type.is(ValueType.STRING)) {
+        slot.put("type", "string");
+      } else if (type.is(ValueType.LONG)) {
+        slot.put("type", "long");
+      } else if (type.is(ValueType.FLOAT)) {
+        slot.put("type", "float");
+      } else if (type.is(ValueType.DOUBLE)) {
+        slot.put("type", "double");
+      } else if (type.isArray()) {
+        slot.put("type", "array");
+      } else {
+        slot.put("type", type.toString());
+      }
+      slot.put("hasExtraction", spec.getExtractionFn() != null);
+      slot.put("oneToOneExtraction", spec.getExtractionFn() != null
+                                    && ExtractionFn.ExtractionType.ONE_TO_ONE.equals(spec.getExtractionFn().getExtractionType()));
+      slots.add(slot);
+    }
+    return slots;
+  }
+
+  public Map<String, Object> planFullCacheLayout(final GroupByQuery query, final boolean isResultLevelCache)
+  {
+    final Map<String, Object> layout = describeResultCacheLayout(query, isResultLevelCache);
+    layout.put("timestampSlot", query.getResultRowHasTimestamp() ? 0 : -1);
+    layout.put("dimensionSlots", planDimensionCacheSlots(query));
+    layout.put("aggregatorSlots", planAggregatorCacheSlots(query, isResultLevelCache));
+    layout.put("postAggregatorSlots", isResultLevelCache ? planPostAggregatorCacheSlots(query) : Collections.emptyList());
+    layout.put("totalSlots", resultCacheFieldCount(query, isResultLevelCache));
+    layout.put("requiresIndependentPostAggregatorSlots", postAggregatorsRequireIndependentCacheSlots(query));
+    return layout;
+  }
+
+  public Map<String, Object> planQueryResultAlignment(final GroupByQuery query)
+  {
+    final Map<String, Object> alignment = new HashMap<>();
+    alignment.put("rowSignature", describeRowSignature(query));
+    alignment.put("cacheLayoutWithoutPostAggregators", planFullCacheLayout(query, false));
+    alignment.put("cacheLayoutWithPostAggregators", planFullCacheLayout(query, true));
+    alignment.put("pipeline", inspectQueryPipeline(query));
+    alignment.put("pushDown", describePushDownEligibility(query));
+    alignment.put("extractions", describeExtractionRewrite(query));
+    alignment.put("multiplePostAggregators", hasMultiplePostAggregators(query));
+    alignment.put("fieldIndexes", indexResultRowFields(query));
+    alignment.put("postAggregatorCount", countPostAggregators(query));
+    alignment.put("aggregatorCount", countAggregators(query));
+    alignment.put("dimensionCount", countDimensions(query));
+    if (query.getLimitSpec() == null) {
+      alignment.put("limitSpec", "missing");
+    } else {
+      alignment.put("limitSpec", query.getLimitSpec().getClass().getSimpleName());
+    }
+    if (query.getHavingSpec() == null) {
+      alignment.put("havingSpec", "missing");
+    } else {
+      alignment.put("havingSpec", query.getHavingSpec().getClass().getSimpleName());
+    }
+    if (query.getSubtotalsSpec() == null) {
+      alignment.put("subtotals", 0);
+    } else {
+      alignment.put("subtotals", query.getSubtotalsSpec().size());
+    }
+    alignment.put("canCache", canUseResultLevelCache(query));
+    alignment.put("nestedPushDown", isNestedQueryPushDown(query));
+    alignment.put("limitPushDown", limitPushDownApplies(query));
+    alignment.put("fieldIndexes", indexResultRowFields(query));
+    alignment.put("dimensionSlots", planDimensionCacheSlots(query));
+    alignment.put("aggregatorSlots", planAggregatorCacheSlots(query, true));
+    alignment.put("postAggregatorSlots", planPostAggregatorCacheSlots(query));
+    alignment.put("orderNaturalScores", classifyOrderColumns(query, new ArrayList<>()));
+    if (query.getVirtualColumns() == null) {
+      alignment.put("virtualColumns", 0);
+    } else {
+      alignment.put("virtualColumns", query.getVirtualColumns().getColumnNames().size());
+    }
+    alignment.put("hasUniversalTimestamp", query.getUniversalTimestamp() != null);
+    alignment.put("resultRowHasTimestamp", query.getResultRowHasTimestamp());
+    alignment.put("arrayRows", contextRequestsArrayRows(query));
+    alignment.put("finalizeSubquery", query.context().isFinalize(false));
+    alignment.put("bySegment", query.context().isBySegment());
+    alignment.put("queryType", query.getType());
+    alignment.put("queryId", query.getId());
+    alignment.put("intervals", query.getIntervals() == null ? 0 : query.getIntervals().size());
+    alignment.put("dataSource", query.getDataSource() == null ? "missing" : query.getDataSource().getClass().getSimpleName());
+    alignment.put("subqueryEligible", subqueryCanBeGrouped(query));
+    alignment.put("cacheablePostAggregators", countPostAggregators(query) > 0);
+    alignment.put("cachedResultRowSize", query.getResultRowSizeWithPostAggregators());
+    alignment.put("segmentCacheKeyBytes", buildSegmentLevelCacheKey(query).length);
+    alignment.put("resultCacheKeyBytes", buildResultLevelCacheKey(query).length);
+    return alignment;
+  }
+
+  public boolean hasMultiplePostAggregators(final GroupByQuery query)
+  {
+    return countPostAggregators(query) > 1;
+  }
+
+  public Map<String, Integer> indexResultRowFields(final GroupByQuery query)
+  {
+    final Map<String, Integer> indexes = new HashMap<>();
+    int position = 0;
+    if (query.getResultRowHasTimestamp()) {
+      indexes.put("__time", position++);
+    }
+    for (int i = 0; i < countDimensions(query); i++) {
+      indexes.put(query.getDimensions().get(i).getOutputName(), position++);
+    }
+    for (int i = 0; i < countAggregators(query); i++) {
+      indexes.put(query.getAggregatorSpecs().get(i).getName(), position++);
+    }
+    for (int i = 0; i < countPostAggregators(query); i++) {
+      indexes.put(query.getPostAggregatorSpecs().get(i).getName(), position++);
+    }
+    return indexes;
+  }
 }
