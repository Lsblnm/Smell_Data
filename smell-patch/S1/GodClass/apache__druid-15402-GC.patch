+  public int compareDimsForLimitPushDown(
+      final List<Integer> fields,
+      final List<Boolean> needsReverseList,
+      final List<ColumnType> dimensionTypes,
+      final List<StringComparator> comparators,
+      final ResultRow lhs,
+      final ResultRow rhs
+  )
+  {
+    for (int i = 0; i < fields.size(); i++) {
+      final int dimCompare = compareDimensionValues(
+          lhs.get(fields.get(i)),
+          rhs.get(fields.get(i)),
+          dimensionTypes.get(i),
+          comparators.get(i)
+      );
+      if (dimCompare != 0) {
+        return needsReverseList.get(i) ? -dimCompare : dimCompare;
+      }
+    }
+    return 0;
+  }
