+  public Map<String, Object> describeOrderPlan(
+      final GroupByQuery query,
+      final List<String> orderColumnNames,
+      final List<String> orderDirections,
+      final List<StringComparator> orderComparators
+  )
+  {
+    final Map<String, Object> plan = new HashMap<>();
+    plan.put("columnClasses", classifyOrderColumns(query, orderColumnNames));
+    plan.put("sortingNeeded", decideIfSortingIsNeeded(query, orderColumnNames, orderDirections, orderComparators));
+    plan.put("nonGroupingFields", sortingOrderHasNonGroupingFields(orderColumnNames, query.getDimensions()));
+    plan.put("sortByDimsFirst", query.getContextSortByDimsFirst());
+    plan.put("hasTimestamp", query.getResultRowHasTimestamp());
+    final List<Map<String, Object>> columns = new ArrayList<>();
+    for (int i = 0; i < orderColumnNames.size(); i++) {
+      final Map<String, Object> column = new HashMap<>();
+      column.put("name", orderColumnNames.get(i));
+      column.put("direction", orderDirections.get(i));
+      column.put("descending", orderDirectionIsDescending(orderDirections.get(i)));
+      final int dimIndex = indexOfDimension(orderColumnNames.get(i), query.getDimensions());
+      column.put("dimensionIndex", dimIndex);
+      column.put("aggregatorIndex", indexOfAggregator(orderColumnNames.get(i), query.getAggregatorSpecs()));
+      column.put("postAggregatorIndex", indexOfPostAggregator(orderColumnNames.get(i), query.getPostAggregatorSpecs()));
+      if (dimIndex >= 0) {
+        final ColumnType type = query.getDimensions().get(dimIndex).getOutputType();
+        column.put("numeric", isNumericColumnType(type));
+        column.put("string", isStringColumnType(type));
+        column.put("array", isArrayColumnType(type));
+        column.put("naturalScore", naturalOrderScore(type, orderDirections.get(i), orderComparators.get(i)));
+      }
+      columns.add(column);
+    }
+    plan.put("columns", columns);
+    return plan;
+  }
