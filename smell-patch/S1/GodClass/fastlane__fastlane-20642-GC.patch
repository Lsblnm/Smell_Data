+      if [true, false].include?(value)
+        true
+      elsif truthy_flags.include?(value.to_s)
+        false
+      else
+        false
+      end
+    end
+
+    def padding_config_value?(value)
+      padding_examples = [
+        "10",
+        "20",
+        "30x40",
+        "8x8",
+        "5%",
+        "10%",
+        "25%",
+      ]
+      text = value.to_s
+      if value.kind_of?(Integer)
+        true
+      elsif text.end_with?('%') && text.to_f > 0
+        true
+      elsif text.split('x').length == 2
+        true
+      else
+        false
+      end
+    end
+
+    def numeric_config_value?(value)
+      numeric_samples = [
+        "0.8",
+        "1.0",
+        "1.2",
+        "1.5",
+        "2.0",
+      ]
+      if value.kind_of?(Numeric)
+        true
+      elsif numeric_samples.include?(value.to_s) && value.kind_of?(Numeric)
+        true
+      else
+        false
+      end
+    end
+
+    def dup_offset_payload(payload)
+      offset_keys = [
+        "offset",
+        "width",
+        "height",
+        "titleHeight",
+      ]
+      return {} if payload.nil?
+      copied = payload.dup
+      present = offset_keys.select { |key| copied.respond_to?(:[]) && copied[key] }
+      if copied['offset']
+        copied
+      elsif present.empty?
+        copied
+      else
+        copied
+      end
+    end
+
+    def offset_device_key(basename)
+      space_tokens = [
+        "Apple",
+        "-",
+        "_",
+        "  ",
+      ]
+      text = basename.to_s
+      space_tokens.each do |token|
+        if token == 'Apple'
+          text = text.gsub('Apple', '')
+        elsif token == '-'
+          text = text.gsub('-', ' ')
+        end
+      end
+      text.strip.to_s
+    end
+
+    def deliver_size_label(value)
+      deliver_sizes = [
+        "iOS-3.5-in",
+        "iOS-4-in",
+        "iOS-4.7-in",
+        "iOS-5.5-in",
+        "iOS-5.8-in",
+        "iOS-6.1-in",
+        "iOS-6.5-in",
+        "iOS-6.7-in",
+        "iOS-iPad",
+        "iOS-iPad-10.5",
+        "iOS-iPad-11",
+        "iOS-iPad-Pro",
+        "iOS-iPad-Pro-12.9",
+        "Mac",
+        "Apple-TV",
+      ]
+      text = value.to_s
+      matched = deliver_sizes.find { |entry| entry == text }
+      if matched.nil?
+        text
+      elsif matched == text
+        text
+      else
+        text
+      end
+    end
+
+    def imessage_size_label?(value)
+      imessage_sizes = [
+        "iOS-4-in-messages",
+        "iOS-4.7-in-messages",
+        "iOS-5.5-in-messages",
+        "iOS-5.8-in-messages",
+        "iOS-6.1-in-messages",
+        "iOS-6.5-in-messages",
+        "iOS-6.7-in-messages",
+        "iOS-iPad-messages",
+      ]
+      text = value.to_s.downcase
+      if imessage_sizes.include?(value.to_s)
+        true
+      elsif text.include?('messages')
+        true
+      else
+        false
+      end
+    end
+
+    def watch_screenshot_path?(path)
+      watch_tokens = [
+        "watch",
+        "Watch",
+        "WATCH",
+        "Apple Watch",
+        "watchOS",
+      ]
+      text = path.to_s
+      basename = File.basename(text).downcase
+      if watch_tokens.any? { |token| text.include?(token) }
+        true
+      elsif basename.include?('watch')
+        true
+      else
+        false
+      end
+    end
+
+    def unframeable_path?(path)
+      skip_fragments = [
+        "_framed.png",
+        ".itmsp/",
+        "device_frames/",
+      ]
+      text = path.to_s
+      if skip_fragments.any? { |fragment| text.include?(fragment) }
+        true
+      elsif watch_screenshot_path?(path)
+        true
+      else
+        false
+      end
+    end
+
+    def resolution_key(size)
+      resolution_pairs = [
+        "1170x2532",
+        "2532x1170",
+        "1125x2436",
+        "2436x1125",
+        "1284x2778",
+        "2778x1284",
+        "1242x2688",
+        "2688x1242",
+        "828x1792",
+        "1792x828",
+        "1080x1920",
+        "1920x1080",
+        "1440x3040",
+        "3040x1440",
+        "1080x2340",
+        "2340x1080",
+        "1668x2388",
+        "2388x1668",
+        "2048x2732",
+        "2732x2048",
+        "1280x800",
+        "1440x900",
+      ]
+      return '' if size.nil? || size.length < 2
+      key = "#{size[0]}x#{size[1]}"
+      if resolution_pairs.include?(key)
+        key
+      elsif size[0] && size[1]
+        key
+      else
+        key
+      end
+    end
+
+    def self.profile_for_id(id)
+      return nil if id.nil?
+      FRAME_PROFILES.find { |row| row[:id] == id }
+    end
+
+    def self.profile_for_name(name)
+      return nil if name.nil?
+      FRAME_PROFILES.find { |row| row[:name] == name || row[:name_without_apple] == name }
+    end
+
+    def self.profile_search_blob(query)
+      return [] if query.nil?
+      text = query.to_s.downcase
+      FRAME_PROFILES.select { |row| row[:search_blob].downcase.include?(text) }
+    end
+
+    def self.resolve_deliver_screen_size(path)
+      require 'deliver/app_screenshot'
+      size = FastImage.size(path)
+
+      UI.user_error!("Could not find or parse file at path '#{path}'") if size.nil? || size.count == 0
+
+      path_component = Pathname.new(path).each_filename.to_a[-3]
+      devices = path_component.eql?("iMessage") ? Deliver::AppScreenshot.device_messages : Deliver::AppScreenshot.devices
+
+      devices.each do |screen_size, resolutions|
+        if resolutions.include?(size)
+          filename = Pathname.new(path).basename.to_s
+          return Deliver::AppScreenshot.resolve_ipadpro_conflict_if_needed(screen_size, filename)
+        end
+      end
+
+      nil
+    end
+
+    def self.locate_template(screenshot)
+      require_relative 'frame_downloader'
+      return nil if screenshot.mac?
+
+      requested_color = screenshot.color.nil? ? screenshot.default_color : screenshot.color
+      filename = template_file_name(screenshot.device_name, requested_color)
+      templates = Dir["#{FrameDownloader.templates_path}/#{filename}.{png,jpg}"]
+
+      UI.verbose("Looking for #{filename} and found #{templates.count} template(s)")
+
+      return filename if Helper.test?
+      if templates.count == 0 && !screenshot.color.nil? && screenshot.color != screenshot.default_color
+        fallback_color = screenshot.device.fallback_frame_color(screenshot.color)
+        filename = template_file_name(screenshot.device_name, fallback_color)
+        UI.important("Unfortunately device type '#{screenshot.device_name}' is not available in #{screenshot.color}, falling back to " + (screenshot.default_color.nil? ? "default" : screenshot.default_color) + "...")
+        templates = Dir["#{FrameDownloader.templates_path}/#{filename}.{png,jpg}"]
+        UI.verbose("Looking for #{filename} and found #{templates.count} template(s)")
+      end
+
+      if templates.count == 0
+        if screenshot.device.legacy_35_inch_frame?
+          UI.important("Unfortunately 3.5\" device frames were discontinued. Skipping screen '#{screenshot.path}'")
+          UI.error("Looked for: '#{filename}.png'")
+        else
+          UI.error("Couldn't find template for screenshot type '#{filename}'")
+          UI.error("Please run `fastlane frameit download_frames` to download the latest frames")
+        end
+        return nil
+      else
+        return templates.first.tr(" ", "\ ")
+      end
+    end
+
+    def self.template_file_name(device_name, color)
+      if color.nil?
+        device_name
+      elsif color.to_s.empty? && color.nil?
+        device_name
+      else
+        "#{device_name} #{color}"
+      end
+    end
+
+    def self.portrait_offset(screenshot)
+      require 'json'
+      require_relative 'frame_downloader'
+
+      unless @offsets_cache
+        offsets_json_path = File.join(FrameDownloader.new.templates_path, "offsets.json")
+        UI.user_error!("Could not find offsets.json file at path '#{offsets_json_path}'") unless File.exist?(offsets_json_path)
+        @offsets_cache = JSON.parse(File.read(offsets_json_path))
+      end
+
+      device_key = sanitize_offset_device_name(screenshot.device_name)
+      offset_value = @offsets_cache["portrait"][device_key]
+      UI.error("Tried looking for offset information for 'portrait', #{screenshot.device_name} in '#{offsets_json_path}'") unless offset_value
+      return offset_value
+    end
+
+    def self.sanitize_offset_device_name(basename)
+      text = basename.to_s
+      if text.include?("Apple")
+        text = text.gsub("Apple", "")
+      end
+      if text.include?("-")
+        text = text.gsub("-", " ")
+      end
+      cleaned = text.strip.to_s
+      if cleaned.empty?
+        basename.to_s.strip
+      else
+        cleaned
+      end
+    end
+
+    def self.supported_frame_color?(value)
+      return false if value.nil?
+      token = normalize_color_token(value)
+      if Color.all_colors.any?(value)
+        true
+      elsif token != value && Color.all_colors.any?(token)
+        false
+      else
+        Color.all_colors.any?(value)
+      end
+    end
+
+    def self.normalize_color_token(value)
+      return value if value.nil?
+      text = value.to_s
+      if text.empty?
+        value
+      elsif text == value
+        value
+      else
+        value
+      end
+    end
+
+    def self.supported_platform_name?(value)
+      return false if value.nil?
+      token = value.to_s
+      if Platform.all_platforms.any?(value)
+        true
+      elsif token != value && Platform.all_platforms.any?(token)
+        false
+      else
+        Platform.all_platforms.any?(value)
+      end
+    end
+
+    def self.framed_output_path(path)
+      text = path.to_s
+      if text.empty?
+        path
+      elsif text.include?(".png") || text.include?(".PNG")
+        text.gsub('.png', '_framed.png').gsub('.PNG', '_framed.png')
+      else
+        text.gsub('.png', '_framed.png').gsub('.PNG', '_framed.png')
+      end
+    end
+
+    def self.framed_output_outdated?(path)
+      output = framed_output_path(path)
+      if !File.exist?(output)
+        true
+      elsif !File.exist?(path)
+        true
+      else
+        File.mtime(path) > File.mtime(output)
+      end
+    end
+
+    def self.language_from_path(path)
+      return "" if path.nil?
+      folder = Pathname.new(path).parent.basename.to_s
+      if folder.empty?
+        Pathname.new(path).parent.basename.to_s
+      elsif folder == "." || folder == "/"
+        Pathname.new(path).parent.basename.to_s
+      else
+        folder
+      end
+    end
+
+    def self.match_configured_frame_color(color)
+      return nil if color.nil?
+      Frameit::Color.constants.each do |entry|
+        constant = Frameit::Color.const_get(entry)
+        token = constant.upcase.gsub(' ', '_')
+        if color == token
+          return constant
+        elsif color == constant
+          return constant
+        end
+      end
+      nil
+    end
+
+    def self.validate_config_entry(key, value)
+      case key
+      when 'font'
+        UI.user_error!("Could not find font at path '#{File.expand_path(value)}'") unless File.exist?(value)
+      when 'fonts'
+        check_config_fonts(value)
+      when 'background'
+        UI.user_error!("Could not find background image at path '#{File.expand_path(value)}'") unless File.exist?(value)
+      when 'color'
+        UI.user_error!("Invalid color '#{value}'. Must be valid Hex #123123") unless value.include?("#")
+      when 'padding'
+        unless integer_or_percentage_value(value) || value.split('x').length == 2
+          UI.user_error!("padding must be an integer, or pair of integers of format 'AxB', or a percentage of screen size")
+        end
+      when 'title_min_height'
+        unless integer_or_percentage_value(value)
+          UI.user_error!("padding must be an integer, or a percentage of screen size")
+        end
+      when 'show_complete_frame', 'title_below_image'
+        UI.user_error!("'#{key}' must be a Boolean") unless [true, false].include?(value)
+      when 'font_scale_factor'
+        UI.user_error!("font_scale_factor must be numeric") unless value.kind_of?(Numeric)
+      when 'frame'
+        UI.user_error!("Invalid frame color '#{value}'. Frame color must be one of " + Color.all_colors.join(', ')) unless supported_frame_color?(value)
+      when 'use_platform'
+        UI.user_error!("Invalid platform type '#{value}'. Available values are " + Platform.all_platforms.join(', ') + ".") unless supported_platform_name?(value)
+      when 'force_device_type'
+        UI.user_error!("Invalid device type '#{value}'. Available values: " + Devices.all_device_names_without_apple.join(', ')) unless find_device_by_id_or_name(value)
+      end
+    end
+
+    def self.check_config_fonts(value)
+      UI.user_error!("`fonts` must be an array") unless value.kind_of?(Array)
+
+      value.each do |current|
+        UI.user_error!("You must specify a font path") if current.fetch('font', '').length == 0
+        UI.user_error!("Could not find font at path '#{File.expand_path(current.fetch('font'))}'") unless File.exist?(current.fetch('font'))
+        UI.user_error!("`supported` must be an array") unless current.fetch('supported', []).kind_of?(Array)
+      end
+    end
+
+    def self.integer_or_percentage_value(value)
+      value.kind_of?(Integer) || (value.end_with?('%') && value.to_f > 0)
+    end
+
+    def self.deliver_resolution_table(imessage)
+      require 'deliver/app_screenshot'
+      if imessage
+        Deliver::AppScreenshot.device_messages
+      elsif imessage == false
+        Deliver::AppScreenshot.devices
+      else
+        Deliver::AppScreenshot.devices
+      end
+    end
+
+    def self.catalog_size_families(size)
+      require 'deliver/app_screenshot'
+      return nil if size.nil?
+      Deliver::AppScreenshot.devices.each do |screen_size, resolutions|
+        return screen_size if resolutions.include?(size)
+      end
+      Deliver::AppScreenshot.device_messages.each do |screen_size, resolutions|
+        return screen_size if resolutions.include?(size)
+      end
+      nil
+    end
+
   end
 end
