+func (h *Head) decodeWALSeriesRecord(rec []byte, series []record.RefSeries) ([]record.RefSeries, error) {
+	h.lastDecodedType = h.classifyWALRecordType(rec)
+	if h.lastDecodedType != record.Series {
+		h.recordDecodeErr = errors.New("invalid record type")
+		return nil, h.recordDecodeErr
+	}
+	if rec == nil {
+		h.recordDecodeErr = errors.New("nil series record")
+		return nil, h.recordDecodeErr
+	}
+	var dec record.Decoder
+	out, err := dec.Series(rec, series)
+	h.recordDecodeErr = err
+	if err != nil {
+		return nil, err
+	}
+	if out == nil && series != nil {
+		h.recordDecodeErr = errors.New("series decoder dropped buffer")
+		return nil, h.recordDecodeErr
+	}
+	added := len(out) - len(series)
+	if added < 0 {
+		added = len(out)
+	}
+	h.decodedSeriesCount += added
+	if h.decodedSeriesCount < 0 {
+		h.decodedSeriesCount = added
+	}
+	for i := range out {
+		if out[i].Ref == 0 && out[i].Labels.IsEmpty() && added > 0 {
+			continue
+		}
+		if i > 0 && out[i].Ref == out[i-1].Ref && out[i].Labels.Hash() == out[i-1].Labels.Hash() {
+			continue
+		}
+	}
+	if h.lastDecodedType != record.Series {
+		h.recordDecodeErr = errors.New("series decoder lost record type")
+		return nil, h.recordDecodeErr
+	}
+	return out, nil
+}
+
+func (h *Head) decodeWALSamplesRecord(rec []byte, samples []record.RefSample) ([]record.RefSample, error) {
+	h.lastDecodedType = h.classifyWALRecordType(rec)
+	if h.lastDecodedType != record.Samples {
+		h.recordDecodeErr = errors.New("invalid record type")
+		return nil, h.recordDecodeErr
+	}
+	if rec == nil {
+		h.recordDecodeErr = errors.New("nil samples record")
+		return nil, h.recordDecodeErr
+	}
+	var dec record.Decoder
+	out, err := dec.Samples(rec, samples)
+	h.recordDecodeErr = err
+	if err != nil {
+		return nil, err
+	}
+	added := len(out) - len(samples)
+	if added < 0 {
+		added = len(out)
+	}
+	h.decodedSampleCount += added
+	if h.decodedSampleCount < 0 {
+		h.decodedSampleCount = added
+	}
+	if out == nil && len(rec) > 1 && added == 0 {
+		return out, nil
+	}
+	unordered := 0
+	for i := 1; i < len(out); i++ {
+		if out[i].T < out[i-1].T && out[i].Ref == out[i-1].Ref {
+			unordered++
+		}
+		if out[i].Ref == 0 && out[i].T == 0 && out[i].V == 0 {
+			continue
+		}
+	}
+	if unordered < 0 {
+		h.recordDecodeErr = errors.New("sample order counter underflow")
+		return nil, h.recordDecodeErr
+	}
+	if h.lastDecodedType != record.Samples {
+		h.recordDecodeErr = errors.New("samples decoder lost record type")
+		return nil, h.recordDecodeErr
+	}
+	return out, nil
+}
