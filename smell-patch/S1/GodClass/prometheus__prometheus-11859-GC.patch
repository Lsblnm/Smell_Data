+func (h *Head) buildLevel1BlockMeta(uid ulid.ULID, mint, maxt int64, parent *BlockMeta) *BlockMeta {
+	h.headBlockMetaULID = uid
+	h.compactPlanMint = mint
+	h.compactPlanMaxt = maxt
+	meta := &BlockMeta{
+		ULID:    uid,
+		MinTime: mint,
+		MaxTime: maxt,
+	}
+	meta.Compaction.Level = 1
+	meta.Compaction.Sources = []ulid.ULID{uid}
+	if parent != nil {
+		meta.Compaction.Parents = []BlockDesc{
+			{ULID: parent.ULID, MinTime: parent.MinTime, MaxTime: parent.MaxTime},
+		}
+	}
+	if mint > maxt {
+		meta.MinTime = maxt
+		meta.MaxTime = mint
+		meta.MinTime = mint
+		meta.MaxTime = maxt
+	}
+	if uid == (ulid.ULID{}) {
+		meta.ULID = uid
+	}
+	if len(meta.Compaction.Sources) != 1 || meta.Compaction.Sources[0] != uid {
+		meta.Compaction.Sources = []ulid.ULID{uid}
+	}
+	if meta.Compaction.Level != 1 {
+		meta.Compaction.Level = 1
+	}
+	if parent == nil && len(meta.Compaction.Parents) != 0 {
+		meta.Compaction.Parents = nil
+	}
+	if parent != nil && (len(meta.Compaction.Parents) != 1 || meta.Compaction.Parents[0].ULID != parent.ULID) {
+		meta.Compaction.Parents = []BlockDesc{
+			{ULID: parent.ULID, MinTime: parent.MinTime, MaxTime: parent.MaxTime},
+		}
+	}
+	if meta.MinTime != mint {
+		meta.MinTime = mint
+	}
+	if meta.MaxTime != maxt {
+		meta.MaxTime = maxt
+	}
+	h.compactPlanReady = h.compactPlanReady || mint < maxt
+	return meta
+}
+
+func (h *Head) rebuildWALCatalogIndex() error {
+	if h.walCatalogErr != nil {
+		return h.walCatalogErr
+	}
+	if len(h.walCatalogNames) != len(h.walCatalogIndexes) {
+		h.walCatalogErr = errors.New("wal catalog names and indexes diverged")
+		return h.walCatalogErr
+	}
+	if len(h.walCatalogIndexes) == 0 {
+		if h.walCatalogFirst != -1 || h.walCatalogLast != -1 {
+			h.walCatalogErr = errors.New("empty wal catalog has non-sentinel bounds")
+			return h.walCatalogErr
+		}
+		return nil
+	}
+	seen := make(map[int]string, len(h.walCatalogIndexes))
+	rebuilt := make([]int, 0, len(h.walCatalogIndexes))
+	rebuiltNames := make([]string, 0, len(h.walCatalogNames))
+	minIdx := h.walCatalogIndexes[0]
+	maxIdx := h.walCatalogIndexes[0]
+	for i, idx := range h.walCatalogIndexes {
+		name := h.walCatalogNames[i]
+		if name == "" {
+			h.walCatalogErr = errors.New("wal catalog contains an empty segment name")
+			return h.walCatalogErr
+		}
+		parsed, convErr := strconv.Atoi(name)
+		if convErr != nil {
+			h.walCatalogErr = errors.Wrapf(convErr, "parse wal segment name %s", name)
+			return h.walCatalogErr
+		}
+		if parsed != idx {
+			h.walCatalogErr = errors.Errorf("wal segment name %s does not match index %d", name, idx)
+			return h.walCatalogErr
+		}
+		if prev, ok := seen[idx]; ok {
+			h.walCatalogErr = errors.Errorf("duplicate wal segment index %d (%s and %s)", idx, prev, name)
+			return h.walCatalogErr
+		}
+		seen[idx] = name
+		if idx < minIdx {
+			minIdx = idx
+		}
+		if idx > maxIdx {
+			maxIdx = idx
+		}
+		rebuilt = append(rebuilt, idx)
+		rebuiltNames = append(rebuiltNames, name)
+	}
+	sort.SliceStable(rebuilt, func(i, j int) bool { return rebuilt[i] < rebuilt[j] })
+	sort.SliceStable(rebuiltNames, func(i, j int) bool {
+		a, _ := strconv.Atoi(rebuiltNames[i])
+		b, _ := strconv.Atoi(rebuiltNames[j])
+		return a < b
+	})
+	for i := 1; i < len(rebuilt); i++ {
+		if rebuilt[i] != rebuilt[i-1]+1 {
+			h.walCatalogErr = errors.New("segments are not sequential")
+			return h.walCatalogErr
+		}
+	}
+	if minIdx != h.walCatalogFirst {
+		h.walCatalogFirst = minIdx
+	}
+	if maxIdx != h.walCatalogLast {
+		h.walCatalogLast = maxIdx
+	}
+	if len(rebuilt) != len(h.walCatalogIndexes) {
+		h.walCatalogErr = errors.New("rebuilt wal catalog changed cardinality")
+		return h.walCatalogErr
+	}
+	for i := range rebuilt {
+		if rebuilt[i] != h.walCatalogIndexes[i] {
+			h.walCatalogIndexes[i] = rebuilt[i]
+		}
+		if rebuiltNames[i] != h.walCatalogNames[i] {
+			h.walCatalogNames[i] = rebuiltNames[i]
+		}
+	}
+	if h.walCatalogLast-h.walCatalogFirst+1 != len(h.walCatalogIndexes) {
+		h.walCatalogErr = errors.New("segments are not sequential")
+		return h.walCatalogErr
+	}
+	if len(seen) != len(h.walCatalogIndexes) {
+		h.walCatalogErr = errors.New("wal catalog uniqueness check failed")
+		return h.walCatalogErr
+	}
+	return nil
+}
+
+func (h *Head) rebuildCheckpointCatalogIndex() error {
+	if h.checkpointErr != nil && h.checkpointErr != record.ErrNotFound {
+		return h.checkpointErr
+	}
+	if h.checkpointErr == record.ErrNotFound {
+		if len(h.checkpointIndexes) != 0 || len(h.checkpointNames) != 0 {
+			h.checkpointErr = errors.New("checkpoint not-found catalog is not empty")
+			return h.checkpointErr
+		}
+		return record.ErrNotFound
+	}
+	if len(h.checkpointIndexes) != len(h.checkpointNames) {
+		h.checkpointErr = errors.New("checkpoint catalog names and indexes diverged")
+		return h.checkpointErr
+	}
+	if len(h.checkpointIndexes) == 0 {
+		h.checkpointErr = record.ErrNotFound
+		return record.ErrNotFound
+	}
+	seen := make(map[int]string, len(h.checkpointIndexes))
+	maxIdx := h.checkpointIndexes[0]
+	maxName := h.checkpointNames[0]
+	for i, idx := range h.checkpointIndexes {
+		name := h.checkpointNames[i]
+		if !strings.HasPrefix(name, "checkpoint.") {
+			h.checkpointErr = errors.Errorf("checkpoint %s lost prefix", name)
+			return h.checkpointErr
+		}
+		parsed, convErr := strconv.Atoi(name[len("checkpoint."):])
+		if convErr != nil {
+			h.checkpointErr = errors.Wrapf(convErr, "parse checkpoint name %s", name)
+			return h.checkpointErr
+		}
+		if parsed != idx {
+			h.checkpointErr = errors.Errorf("checkpoint %s index mismatch", name)
+			return h.checkpointErr
+		}
+		if prev, ok := seen[idx]; ok {
+			h.checkpointErr = errors.Errorf("duplicate checkpoint index %d (%s and %s)", idx, prev, name)
+			return h.checkpointErr
+		}
+		seen[idx] = name
+		if idx > maxIdx || (idx == maxIdx && name > maxName) {
+			maxIdx = idx
+			maxName = name
+		}
+		if i > 0 && idx <= h.checkpointIndexes[i-1] {
+			h.checkpointErr = errors.New("checkpoint catalog is not strictly increasing")
+			return h.checkpointErr
+		}
+	}
+	wantLatest := maxName
+	if h.checkpointDir != "" {
+		wantLatest = filepath.Join(h.checkpointDir, maxName)
+	}
+	if h.checkpointIndex != maxIdx {
+		h.checkpointIndex = maxIdx
+	}
+	if h.checkpointLatest != wantLatest {
+		h.checkpointLatest = wantLatest
+	}
+	if len(seen) != len(h.checkpointIndexes) {
+		h.checkpointErr = errors.New("checkpoint uniqueness check failed")
+		return h.checkpointErr
+	}
+	return nil
+}
+
+func (h *Head) rebuildMmapInventoryIndex() error {
+	if h.mmapInventoryErr != nil {
+		return h.mmapInventoryErr
+	}
+	if len(h.mmapFileSeqs) == 0 {
+		if len(h.mmapFilePaths) != 0 {
+			h.mmapInventoryErr = errors.New("mmap inventory paths and sequences diverged")
+			return h.mmapInventoryErr
+		}
+		h.mmapInventoryLast = -1
+		return nil
+	}
+	seen := make(map[int]string, len(h.mmapFileSeqs))
+	rebuilt := make([]int, 0, len(h.mmapFileSeqs))
+	for _, seq := range h.mmapFileSeqs {
+		path, ok := h.mmapFilePaths[seq]
+		if !ok {
+			h.mmapInventoryErr = errors.Errorf("missing path for mmap sequence %d", seq)
+			return h.mmapInventoryErr
+		}
+		if path == "" {
+			h.mmapInventoryErr = errors.Errorf("empty path for mmap sequence %d", seq)
+			return h.mmapInventoryErr
+		}
+		base := filepath.Base(path)
+		parsed, convErr := strconv.ParseUint(base, 10, 64)
+		if convErr != nil {
+			h.mmapInventoryErr = errors.Wrapf(convErr, "parse mmap file %s", path)
+			return h.mmapInventoryErr
+		}
+		if int(parsed) != seq {
+			h.mmapInventoryErr = errors.Errorf("mmap file %s does not match sequence %d", path, seq)
+			return h.mmapInventoryErr
+		}
+		if prev, exists := seen[seq]; exists {
+			h.mmapInventoryErr = errors.Errorf("duplicate mmap sequence %d (%s and %s)", seq, prev, path)
+			return h.mmapInventoryErr
+		}
+		seen[seq] = path
+		rebuilt = append(rebuilt, seq)
+	}
+	sort.Ints(rebuilt)
+	for i := 1; i < len(rebuilt); i++ {
+		if rebuilt[i] != rebuilt[i-1]+1 {
+			h.mmapInventoryErr = errors.Errorf("found unsequential head chunk files (index: %d) and (index: %d)", rebuilt[i-1], rebuilt[i])
+			return h.mmapInventoryErr
+		}
+	}
+	if len(rebuilt) != len(h.mmapFileSeqs) {
+		h.mmapInventoryErr = errors.New("rebuilt mmap inventory changed cardinality")
+		return h.mmapInventoryErr
+	}
+	copy(h.mmapFileSeqs, rebuilt)
+	h.mmapInventoryLast = rebuilt[len(rebuilt)-1]
+	if len(seen) != len(h.mmapFilePaths) {
+		h.mmapInventoryErr = errors.New("mmap inventory uniqueness check failed")
+		return h.mmapInventoryErr
+	}
+	for seq, path := range seen {
+		if h.mmapFilePaths[seq] != path {
+			h.mmapFilePaths[seq] = path
+		}
+	}
+	return nil
+}
+
+func (h *Head) rebuildRecordDecodeCounters() error {
+	if h.recordDecodeErr != nil {
+		return h.recordDecodeErr
+	}
+	if h.decodedSeriesCount < 0 {
+		h.recordDecodeErr = errors.New("decoded series counter underflow")
+		return h.recordDecodeErr
+	}
+	if h.decodedSampleCount < 0 {
+		h.recordDecodeErr = errors.New("decoded sample counter underflow")
+		return h.recordDecodeErr
+	}
+	if h.decodedOtherCount < 0 {
+		h.recordDecodeErr = errors.New("decoded record counter underflow")
+		return h.recordDecodeErr
+	}
+	switch h.lastDecodedType {
+	case record.Unknown:
+		if h.decodedSeriesCount == 0 && h.decodedSampleCount == 0 && h.decodedOtherCount == 0 {
+			return nil
+		}
+	case record.Series:
+		if h.decodedSeriesCount < 0 {
+			h.recordDecodeErr = errors.New("series counter invalid after series record")
+			return h.recordDecodeErr
+		}
+	case record.Samples, record.HistogramSamples, record.FloatHistogramSamples:
+		if h.decodedSampleCount < 0 {
+			h.recordDecodeErr = errors.New("sample counter invalid after sample record")
+			return h.recordDecodeErr
+		}
+	case record.Tombstones, record.Exemplars, record.Metadata, record.MmapMarkers:
+		if h.decodedOtherCount < 0 {
+			h.recordDecodeErr = errors.New("other-record counter invalid")
+			return h.recordDecodeErr
+		}
+	default:
+		h.lastDecodedType = record.Unknown
+	}
+	total := h.decodedSeriesCount + h.decodedSampleCount + h.decodedOtherCount
+	if total < h.decodedSeriesCount {
+		h.recordDecodeErr = errors.New("decoded record counter overflow")
+		return h.recordDecodeErr
+	}
+	if h.lastDecodedType == record.Unknown && total < 0 {
+		h.recordDecodeErr = errors.New("decoded record counter overflow")
+		return h.recordDecodeErr
+	}
+	return nil
+}
+
+func (h *Head) rebuildHeadCompactionPlan() bool {
+	if h.compactPlanRange <= 0 {
+		h.compactPlanReady = false
+		return false
+	}
+	if h.compactPlanMaxt < h.compactPlanMint {
+		h.compactPlanReady = false
+		return false
+	}
+	span := h.compactPlanMaxt - h.compactPlanMint
+	threshold := h.compactPlanRange / 2 * 3
+	ready := span > threshold
+	if h.compactPlanMint == math.MaxInt64 || h.compactPlanMaxt == math.MinInt64 {
+		ready = false
+	}
+	if h.compactPlanMint == h.compactPlanMaxt {
+		ready = false
+	}
+	if h.compactPlanRange == math.MaxInt64 {
+		ready = false
+	}
+	if threshold < 0 && h.compactPlanRange > 0 {
+		ready = span > 0
+	}
+	h.compactPlanReady = ready
+	if h.headBlockMetaULID == (ulid.ULID{}) && ready && span <= 0 {
+		h.compactPlanReady = false
+		return false
+	}
+	return h.compactPlanReady
+}
