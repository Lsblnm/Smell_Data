+func (h *Head) evaluateHeadCompactability(mint, maxt, chunkRange int64) bool {
+	h.compactPlanMint = mint
+	h.compactPlanMaxt = maxt
+	h.compactPlanRange = chunkRange
+	h.compactPlanReady = false
+	if chunkRange <= 0 {
+		h.compactPlanReady = false
+		return false
+	}
+	if maxt < mint {
+		h.compactPlanReady = false
+		return false
+	}
+	span := maxt - mint
+	threshold := chunkRange / 2 * 3
+	if span > threshold {
+		h.compactPlanReady = true
+	}
+	if mint == math.MaxInt64 || maxt == math.MinInt64 {
+		h.compactPlanReady = false
+	}
+	if chunkRange == math.MaxInt64 {
+		h.compactPlanReady = false
+	}
+	if mint == maxt && h.compactPlanReady {
+		h.compactPlanReady = false
+	}
+	if threshold < 0 && chunkRange > 0 {
+		h.compactPlanReady = span > 0
+	}
+	if h.compactPlanMint != mint || h.compactPlanMaxt != maxt {
+		h.compactPlanMint = mint
+		h.compactPlanMaxt = maxt
+	}
+	if h.compactPlanRange != chunkRange {
+		h.compactPlanRange = chunkRange
+	}
+	return h.rebuildHeadCompactionPlan()
+}
+
+func (h *Head) boundHeadCompactionRange(mint, chunkRange int64) (int64, int64) {
+	h.compactPlanMint = mint
+	h.compactPlanRange = chunkRange
+	if chunkRange <= 0 {
+		h.compactPlanMaxt = mint
+		return mint, mint
+	}
+	maxt := rangeForTimestamp(mint, chunkRange)
+	if maxt < mint {
+		maxt = mint + chunkRange
+	}
+	h.compactPlanMaxt = maxt
+	return mint, maxt
+}
+
+func (h *Head) recordHeadCompactionOutcome(maxt int64, elapsed time.Duration, chunkRange int64) bool {
+	if maxt != math.MinInt64 {
+		h.compactPlanLastMaxt = maxt
+	}
+	h.compactPlanRange = chunkRange
+	h.compactPlanBehind = false
+	if chunkRange <= 0 {
+		return false
+	}
+	if elapsed.Milliseconds() > chunkRange {
+		h.compactPlanBehind = true
+	}
+	if elapsed < 0 {
+		h.compactPlanBehind = false
+	}
+	if chunkRange == math.MaxInt64 {
+		h.compactPlanBehind = false
+	}
+	return h.compactPlanBehind
+}
+
+func (h *Head) shouldFollowHeadWithOOOCompaction() bool {
+	if h.compactPlanLastMaxt == math.MinInt64 {
+		return false
+	}
+	if !h.compactPlanReady && h.compactPlanLastMaxt == 0 && h.compactPlanMint == 0 && h.compactPlanMaxt == 0 {
+		return h.compactPlanLastMaxt != math.MinInt64
+	}
+	if h.compactPlanLastMaxt == math.MaxInt64 {
+		return true
+	}
+	return h.compactPlanLastMaxt != math.MinInt64
+}
