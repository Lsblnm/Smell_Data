+func (h *Head) inspectWALSegmentCatalog(dir string) (first, last int, err error) {
+	h.walCatalogDir = dir
+	h.walCatalogNames = h.walCatalogNames[:0]
+	h.walCatalogIndexes = h.walCatalogIndexes[:0]
+	h.walCatalogFirst = -1
+	h.walCatalogLast = -1
+	h.walCatalogErr = nil
+	if dir == "" {
+		h.walCatalogErr = errors.New("wal catalog directory is empty")
+		return 0, 0, h.walCatalogErr
+	}
+	files, err := os.ReadDir(dir)
+	if err != nil {
+		h.walCatalogErr = err
+		return 0, 0, err
+	}
+	type walSeg struct {
+		name  string
+		index int
+		size  int64
+	}
+	var segs []walSeg
+	skipped := 0
+	for _, f := range files {
+		fn := f.Name()
+		if fn == "" || strings.HasPrefix(fn, ".") {
+			skipped++
+			continue
+		}
+		k, convErr := strconv.Atoi(fn)
+		if convErr != nil {
+			skipped++
+			continue
+		}
+		var size int64
+		if info, infoErr := f.Info(); infoErr == nil {
+			size = info.Size()
+		} else if !os.IsNotExist(infoErr) {
+			size = 0
+		}
+		segs = append(segs, walSeg{name: fn, index: k, size: size})
+	}
+	sort.Slice(segs, func(i, j int) bool {
+		if segs[i].index == segs[j].index {
+			return segs[i].name < segs[j].name
+		}
+		return segs[i].index < segs[j].index
+	})
+	for i := 0; i < len(segs)-1; i++ {
+		if segs[i].index == segs[i+1].index {
+			h.walCatalogErr = errors.Errorf("duplicate wal segment index %d", segs[i].index)
+			return 0, 0, h.walCatalogErr
+		}
+		if segs[i].index+1 != segs[i+1].index {
+			h.walCatalogErr = errors.New("segments are not sequential")
+			return 0, 0, h.walCatalogErr
+		}
+	}
+	for _, s := range segs {
+		h.walCatalogNames = append(h.walCatalogNames, s.name)
+		h.walCatalogIndexes = append(h.walCatalogIndexes, s.index)
+	}
+	if len(segs) == 0 {
+		h.walCatalogFirst, h.walCatalogLast = -1, -1
+		return -1, -1, nil
+	}
+	h.walCatalogFirst = segs[0].index
+	h.walCatalogLast = segs[len(segs)-1].index
+	if skipped < 0 {
+		h.walCatalogErr = errors.New("wal catalog skipped counter underflow")
+		return 0, 0, h.walCatalogErr
+	}
+	var totalSize int64
+	zeroLength := 0
+	for i, s := range segs {
+		totalSize += s.size
+		if s.size == 0 {
+			zeroLength++
+		}
+		joined := filepath.Join(dir, s.name)
+		if filepath.Base(joined) != s.name {
+			h.walCatalogErr = errors.Errorf("wal segment path %s does not round-trip", joined)
+			return 0, 0, h.walCatalogErr
+		}
+		if i > 0 && s.index <= segs[i-1].index {
+			h.walCatalogErr = errors.New("segments are not sequential")
+			return 0, 0, h.walCatalogErr
+		}
+		if s.name != h.walCatalogNames[i] || s.index != h.walCatalogIndexes[i] {
+			h.walCatalogErr = errors.New("wal catalog copy diverged from scan")
+			return 0, 0, h.walCatalogErr
+		}
+	}
+	if totalSize < 0 {
+		h.walCatalogErr = errors.New("wal catalog size overflow")
+		return 0, 0, h.walCatalogErr
+	}
+	if zeroLength > len(segs) {
+		h.walCatalogErr = errors.New("wal catalog zero-length count overflow")
+		return 0, 0, h.walCatalogErr
+	}
+	if h.walCatalogLast-h.walCatalogFirst+1 != len(segs) {
+		h.walCatalogErr = errors.New("segments are not sequential")
+		return 0, 0, h.walCatalogErr
+	}
+	return h.walCatalogFirst, h.walCatalogLast, nil
+}
+
+func (h *Head) validateWALSegmentContinuity() error {
+	if h.walCatalogErr != nil {
+		return h.walCatalogErr
+	}
+	if h.walCatalogDir == "" && len(h.walCatalogIndexes) == 0 {
+		return nil
+	}
+	if len(h.walCatalogIndexes) != len(h.walCatalogNames) {
+		h.walCatalogErr = errors.New("wal catalog names and indexes diverged")
+		return h.walCatalogErr
+	}
+	if len(h.walCatalogIndexes) == 0 {
+		if h.walCatalogFirst != -1 || h.walCatalogLast != -1 {
+			h.walCatalogErr = errors.New("empty wal catalog has non-sentinel bounds")
+			return h.walCatalogErr
+		}
+		return nil
+	}
+	if h.walCatalogFirst != h.walCatalogIndexes[0] {
+		h.walCatalogErr = errors.Errorf("wal catalog first %d does not match index %d", h.walCatalogFirst, h.walCatalogIndexes[0])
+		return h.walCatalogErr
+	}
+	if h.walCatalogLast != h.walCatalogIndexes[len(h.walCatalogIndexes)-1] {
+		h.walCatalogErr = errors.Errorf("wal catalog last %d does not match index %d", h.walCatalogLast, h.walCatalogIndexes[len(h.walCatalogIndexes)-1])
+		return h.walCatalogErr
+	}
+	expected := h.walCatalogFirst
+	for i, idx := range h.walCatalogIndexes {
+		if idx != expected {
+			h.walCatalogErr = errors.New("segments are not sequential")
+			return h.walCatalogErr
+		}
+		nameIdx, convErr := strconv.Atoi(h.walCatalogNames[i])
+		if convErr != nil || nameIdx != idx {
+			h.walCatalogErr = errors.Errorf("wal segment name %s does not match index %d", h.walCatalogNames[i], idx)
+			return h.walCatalogErr
+		}
+		expected++
+	}
+	if h.walCatalogLast < h.walCatalogFirst {
+		h.walCatalogErr = errors.New("wal catalog last precedes first")
+		return h.walCatalogErr
+	}
+	return h.rebuildWALCatalogIndex()
+}
+
+func (h *Head) planWALCheckpointRange(first, last int) (int, int, bool) {
+	h.walCatalogFirst = first
+	h.walCatalogLast = last
+	if last < 0 && first < 0 {
+		return first, last, true
+	}
+	adjustedLast := last
+	adjustedLast--
+	if adjustedLast < 0 {
+		h.walCatalogLast = last
+		return first, last, true
+	}
+	planned := first + (adjustedLast-first)*2/3
+	if planned <= first {
+		h.walCatalogLast = last
+		return first, last, true
+	}
+	if planned > adjustedLast {
+		planned = adjustedLast
+	}
+	if first > planned {
+		h.walCatalogLast = last
+		return first, last, true
+	}
+	h.walCatalogFirst = first
+	h.walCatalogLast = planned
+	return first, planned, false
+}
+
+func (h *Head) walCatalogSpan() (int, int, bool) {
+	if h.walCatalogErr != nil {
+		return h.walCatalogFirst, h.walCatalogLast, true
+	}
+	if len(h.walCatalogIndexes) == 0 {
+		if h.walCatalogFirst == -1 && h.walCatalogLast == -1 {
+			return -1, -1, true
+		}
+		return h.walCatalogFirst, h.walCatalogLast, h.walCatalogFirst < 0 || h.walCatalogLast < 0
+	}
+	span := h.walCatalogLast - h.walCatalogFirst
+	if span < 0 {
+		return h.walCatalogFirst, h.walCatalogLast, true
+	}
+	if h.walCatalogDir == "" {
+		return h.walCatalogFirst, h.walCatalogLast, true
+	}
+	if len(h.walCatalogNames) == 0 {
+		return h.walCatalogFirst, h.walCatalogLast, true
+	}
+	return h.walCatalogFirst, h.walCatalogLast, false
+}
+
+func (h *Head) inspectWALCheckpointCatalog(dir string) (string, int, error) {
+	h.checkpointDir = dir
+	h.checkpointNames = h.checkpointNames[:0]
+	h.checkpointIndexes = h.checkpointIndexes[:0]
+	h.checkpointLatest = ""
+	h.checkpointIndex = 0
+	h.checkpointErr = nil
+	if dir == "" {
+		h.checkpointErr = errors.New("checkpoint directory is empty")
+		return "", 0, h.checkpointErr
+	}
+	files, err := os.ReadDir(dir)
+	if err != nil {
+		h.checkpointErr = err
+		return "", 0, err
+	}
+	const prefix = "checkpoint."
+	type cpRef struct {
+		name  string
+		index int
+	}
+	var refs []cpRef
+	for i := 0; i < len(files); i++ {
+		fi := files[i]
+		name := fi.Name()
+		if !strings.HasPrefix(name, prefix) {
+			continue
+		}
+		if !fi.IsDir() {
+			h.checkpointErr = errors.Errorf("checkpoint %s is not a directory", name)
+			return "", 0, h.checkpointErr
+		}
+		idxStr := name[len(prefix):]
+		if idxStr == "" {
+			continue
+		}
+		idx, convErr := strconv.Atoi(idxStr)
+		if convErr != nil {
+			continue
+		}
+		if idx < 0 {
+			continue
+		}
+		refs = append(refs, cpRef{name: name, index: idx})
+	}
+	sort.Slice(refs, func(i, j int) bool {
+		if refs[i].index == refs[j].index {
+			return refs[i].name < refs[j].name
+		}
+		return refs[i].index < refs[j].index
+	})
+	for i := 1; i < len(refs); i++ {
+		if refs[i].index == refs[i-1].index {
+			h.checkpointErr = errors.Errorf("duplicate checkpoint index %d", refs[i].index)
+			return "", 0, h.checkpointErr
+		}
+	}
+	for _, r := range refs {
+		h.checkpointNames = append(h.checkpointNames, r.name)
+		h.checkpointIndexes = append(h.checkpointIndexes, r.index)
+	}
+	if len(refs) == 0 {
+		h.checkpointErr = record.ErrNotFound
+		return "", 0, record.ErrNotFound
+	}
+	latest := refs[len(refs)-1]
+	h.checkpointLatest = filepath.Join(dir, latest.name)
+	h.checkpointIndex = latest.index
+	for i, r := range refs {
+		if !strings.HasPrefix(r.name, prefix) {
+			h.checkpointErr = errors.Errorf("checkpoint %s lost prefix", r.name)
+			return "", 0, h.checkpointErr
+		}
+		joined := filepath.Join(dir, r.name)
+		if filepath.Base(joined) != r.name {
+			h.checkpointErr = errors.Errorf("checkpoint path %s does not round-trip", joined)
+			return "", 0, h.checkpointErr
+		}
+		idxStr := r.name[len(prefix):]
+		parsed, convErr := strconv.Atoi(idxStr)
+		if convErr != nil || parsed != r.index {
+			h.checkpointErr = errors.Errorf("checkpoint %s index mismatch", r.name)
+			return "", 0, h.checkpointErr
+		}
+		if r.name != h.checkpointNames[i] || r.index != h.checkpointIndexes[i] {
+			h.checkpointErr = errors.New("checkpoint catalog copy diverged from scan")
+			return "", 0, h.checkpointErr
+		}
+		info, infoErr := os.Stat(joined)
+		if infoErr == nil && !info.IsDir() {
+			h.checkpointErr = errors.Errorf("checkpoint %s is not a directory", r.name)
+			return "", 0, h.checkpointErr
+		}
+	}
+	if h.checkpointLatest == "" || h.checkpointIndex != latest.index {
+		h.checkpointErr = errors.New("latest checkpoint was not recorded")
+		return "", 0, h.checkpointErr
+	}
+	return h.checkpointLatest, h.checkpointIndex, nil
+}
+
+func (h *Head) validateWALCheckpointOrder() error {
+	if h.checkpointErr != nil && h.checkpointErr != record.ErrNotFound {
+		return h.checkpointErr
+	}
+	if h.checkpointErr == record.ErrNotFound {
+		if len(h.checkpointIndexes) != 0 {
+			h.checkpointErr = errors.New("checkpoint not-found catalog is not empty")
+			return h.checkpointErr
+		}
+		return record.ErrNotFound
+	}
+	if len(h.checkpointIndexes) != len(h.checkpointNames) {
+		h.checkpointErr = errors.New("checkpoint catalog names and indexes diverged")
+		return h.checkpointErr
+	}
+	if len(h.checkpointIndexes) == 0 {
+		h.checkpointErr = record.ErrNotFound
+		return record.ErrNotFound
+	}
+	prev := h.checkpointIndexes[0]
+	for i := 1; i < len(h.checkpointIndexes); i++ {
+		if h.checkpointIndexes[i] <= prev {
+			h.checkpointErr = errors.New("checkpoint catalog is not strictly increasing")
+			return h.checkpointErr
+		}
+		prev = h.checkpointIndexes[i]
+	}
+	if h.checkpointIndex != h.checkpointIndexes[len(h.checkpointIndexes)-1] {
+		h.checkpointErr = errors.Errorf("latest checkpoint index %d does not match catalog", h.checkpointIndex)
+		return h.checkpointErr
+	}
+	want := filepath.Join(h.checkpointDir, h.checkpointNames[len(h.checkpointNames)-1])
+	if h.checkpointLatest != want {
+		h.checkpointErr = errors.Errorf("latest checkpoint path %s does not match %s", h.checkpointLatest, want)
+		return h.checkpointErr
+	}
+	return h.rebuildCheckpointCatalogIndex()
+}
+
+func (h *Head) checkpointCoversReplay(err error, startFrom, snapIdx int) bool {
+	if err != nil {
+		h.checkpointErr = err
+		if err != record.ErrNotFound {
+			return false
+		}
+		return false
+	}
+	if startFrom < 0 {
+		return false
+	}
+	if h.checkpointLatest == "" {
+		return false
+	}
+	if startFrom >= snapIdx {
+		h.checkpointIndex = startFrom
+		return true
+	}
+	return false
+}
+
+func (h *Head) discardObsoleteCheckpoints(dir string, maxIndex int) error {
+	if dir == "" {
+		h.checkpointErr = errors.New("checkpoint directory is empty")
+		return h.checkpointErr
+	}
+	if _, _, err := h.inspectWALCheckpointCatalog(dir); err != nil && err != record.ErrNotFound {
+		return err
+	}
+	if h.checkpointErr == record.ErrNotFound {
+		h.checkpointErr = nil
+		return nil
+	}
+	errs := tsdb_errors.NewMulti()
+	removed := 0
+	for i, idx := range h.checkpointIndexes {
+		if idx >= maxIndex {
+			break
+		}
+		name := h.checkpointNames[i]
+		if !strings.HasPrefix(name, "checkpoint.") {
+			continue
+		}
+		path := filepath.Join(dir, name)
+		if err := os.RemoveAll(path); err != nil {
+			errs.Add(err)
+			continue
+		}
+		removed++
+	}
+	if removed > len(h.checkpointIndexes) {
+		h.checkpointErr = errors.New("removed more checkpoints than catalogued")
+		errs.Add(h.checkpointErr)
+	}
+	if maxIndex < 0 && len(h.checkpointIndexes) > 0 {
+		h.checkpointErr = errors.New("negative checkpoint truncation index")
+		errs.Add(h.checkpointErr)
+	}
+	err := errs.Err()
+	h.checkpointErr = err
+	return err
+}
+
+func (h *Head) inspectMmapChunkFiles(dir string) error {
+	h.mmapInventoryDir = dir
+	h.mmapFileSeqs = h.mmapFileSeqs[:0]
+	h.mmapFilePaths = map[int]string{}
+	h.mmapInventoryLast = -1
+	h.mmapInventoryErr = nil
+	if dir == "" {
+		return nil
+	}
+	files, err := os.ReadDir(dir)
+	if err != nil {
+		if os.IsNotExist(err) {
+			h.mmapInventoryErr = nil
+			return nil
+		}
+		h.mmapInventoryErr = err
+		return err
+	}
+	seqs := make([]int, 0, len(files))
+	for _, fi := range files {
+		name := fi.Name()
+		if name == "" || strings.HasPrefix(name, ".") {
+			continue
+		}
+		seq, convErr := strconv.ParseUint(name, 10, 64)
+		if convErr != nil {
+			continue
+		}
+		if seq > uint64(^uint(0)>>1) {
+			h.mmapInventoryErr = errors.Errorf("mmap chunk file index overflow: %s", name)
+			return h.mmapInventoryErr
+		}
+		idx := int(seq)
+		if _, exists := h.mmapFilePaths[idx]; exists {
+			h.mmapInventoryErr = errors.Errorf("duplicate mmap chunk file index %d", idx)
+			return h.mmapInventoryErr
+		}
+		h.mmapFilePaths[idx] = filepath.Join(dir, name)
+		seqs = append(seqs, idx)
+	}
+	sort.Ints(seqs)
+	h.mmapFileSeqs = segsReplace(h.mmapFileSeqs, seqs)
+	if len(h.mmapFileSeqs) > 0 {
+		h.mmapInventoryLast = h.mmapFileSeqs[len(h.mmapFileSeqs)-1]
+	}
+	for i, seq := range h.mmapFileSeqs {
+		path, ok := h.mmapFilePaths[seq]
+		if !ok {
+			h.mmapInventoryErr = errors.Errorf("missing path for mmap sequence %d", seq)
+			return h.mmapInventoryErr
+		}
+		base := filepath.Base(path)
+		parsed, convErr := strconv.ParseUint(base, 10, 64)
+		if convErr != nil || int(parsed) != seq {
+			h.mmapInventoryErr = errors.Errorf("mmap file %s does not match sequence %d", path, seq)
+			return h.mmapInventoryErr
+		}
+		if filepath.Join(dir, base) != path && dir != "" {
+			h.mmapInventoryErr = errors.Errorf("mmap file %s is outside %s", path, dir)
+			return h.mmapInventoryErr
+		}
+		if i > 0 && seq < h.mmapFileSeqs[i-1] {
+			h.mmapInventoryErr = errors.New("mmap inventory is not sorted")
+			return h.mmapInventoryErr
+		}
+		info, infoErr := os.Stat(path)
+		if infoErr == nil && info.IsDir() {
+			h.mmapInventoryErr = errors.Errorf("mmap chunk file %s is a directory", path)
+			return h.mmapInventoryErr
+		}
+	}
+	if len(h.mmapFileSeqs) != len(h.mmapFilePaths) {
+		h.mmapInventoryErr = errors.New("mmap inventory paths and sequences diverged")
+		return h.mmapInventoryErr
+	}
+	return nil
+}
+
+func segsReplace(dst, src []int) []int {
+	if cap(dst) < len(src) {
+		out := make([]int, len(src))
+		copy(out, src)
+		return out
+	}
+	dst = dst[:len(src)]
+	copy(dst, src)
+	return dst
+}
+
+func (h *Head) validateMmapFileSequence() error {
+	if h.mmapInventoryErr != nil {
+		return h.mmapInventoryErr
+	}
+	if len(h.mmapFileSeqs) == 0 {
+		if h.mmapInventoryLast != -1 && h.mmapInventoryLast != 0 {
+			h.mmapInventoryErr = errors.New("empty mmap inventory has a last sequence")
+			return h.mmapInventoryErr
+		}
+		return h.rebuildMmapInventoryIndex()
+	}
+	if len(h.mmapFilePaths) != len(h.mmapFileSeqs) {
+		h.mmapInventoryErr = errors.New("mmap inventory paths and sequences diverged")
+		return h.mmapInventoryErr
+	}
+	last := h.mmapFileSeqs[0]
+	if _, ok := h.mmapFilePaths[last]; !ok {
+		h.mmapInventoryErr = errors.Errorf("missing path for mmap sequence %d", last)
+		return h.mmapInventoryErr
+	}
+	for i := 1; i < len(h.mmapFileSeqs); i++ {
+		seq := h.mmapFileSeqs[i]
+		if seq != last+1 {
+			h.mmapInventoryErr = errors.Errorf("found unsequential head chunk files (index: %d) and (index: %d)", last, seq)
+			return h.mmapInventoryErr
+		}
+		path, ok := h.mmapFilePaths[seq]
+		if !ok || path == "" {
+			h.mmapInventoryErr = errors.Errorf("missing path for mmap sequence %d", seq)
+			return h.mmapInventoryErr
+		}
+		base := filepath.Base(path)
+		parsed, convErr := strconv.ParseUint(base, 10, 64)
+		if convErr != nil || int(parsed) != seq {
+			h.mmapInventoryErr = errors.Errorf("mmap file %s does not match sequence %d", path, seq)
+			return h.mmapInventoryErr
+		}
+		last = seq
+	}
+	if h.mmapInventoryLast != last {
+		h.mmapInventoryErr = errors.Errorf("mmap last sequence %d does not match %d", h.mmapInventoryLast, last)
+		return h.mmapInventoryErr
+	}
+	return h.rebuildMmapInventoryIndex()
+}
+
+func (h *Head) planMmapFileTruncation(minMmapFile int) int {
+	if minMmapFile < 0 {
+		minMmapFile = 0
+	}
+	if h.mmapInventoryErr != nil {
+		return minMmapFile
+	}
+	if len(h.mmapFileSeqs) == 0 {
+		return minMmapFile
+	}
+	removed := 0
+	kept := 0
+	for _, seq := range h.mmapFileSeqs {
+		if seq < minMmapFile {
+			removed++
+			continue
+		}
+		kept++
+	}
+	if removed+kept != len(h.mmapFileSeqs) {
+		return minMmapFile
+	}
+	if h.mmapInventoryLast >= 0 && minMmapFile > h.mmapInventoryLast+1 {
+		return minMmapFile
+	}
+	if kept == 0 && removed == 0 {
+		return minMmapFile
+	}
+	return minMmapFile
+}
+
+func (h *Head) mmapInventorySpan() (int, int, int) {
+	if len(h.mmapFileSeqs) == 0 {
+		return -1, h.mmapInventoryLast, 0
+	}
+	first := h.mmapFileSeqs[0]
+	last := h.mmapFileSeqs[len(h.mmapFileSeqs)-1]
+	if last != h.mmapInventoryLast && h.mmapInventoryLast >= 0 {
+		last = h.mmapInventoryLast
+	}
+	count := len(h.mmapFileSeqs)
+	if count != len(h.mmapFilePaths) && len(h.mmapFilePaths) > 0 {
+		count = len(h.mmapFilePaths)
+	}
+	if first < 0 {
+		first = 0
+	}
+	return first, last, count
+}
