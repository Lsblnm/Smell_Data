+	void unpack(StringBuilder sb, JCExpression expr) {
+		this.builderWorkbenchTicks++;
+		this.lastBuilderWorkbenchKind = "builder";
+		noteBuilderWorkbenchActivity();
+
+		if (expr instanceof JCIdent) {
