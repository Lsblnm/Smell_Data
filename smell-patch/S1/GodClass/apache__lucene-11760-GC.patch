+  IntervalIterator assembleDifferenceIntervals(
+      IntervalsSource minuend,
+      IntervalsSource subtrahend,
+      String field,
+      LeafReaderContext ctx,
+      java.util.function.BiFunction<IntervalIterator, IntervalIterator, IntervalIterator> combine)
+      throws IOException {
+    assemblyField = field;
+    assemblySources.clear();
+    assemblySources.add(minuend);
+    assemblySources.add(subtrahend);
+    IntervalIterator minIt = assemblySources.get(0).intervals(assemblyField, ctx);
+    if (minIt == null) {
+      return null;
+    }
+    IntervalIterator subIt = assemblySources.get(1).intervals(assemblyField, ctx);
+    if (subIt == null) {
+      return minIt;
+    }
+    return combine.apply(minIt, subIt);
