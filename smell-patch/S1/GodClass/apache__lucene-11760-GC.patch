+  static int conjunctionStartOffset(List<? extends MatchesIterator> subs) throws IOException {
+    return new IntervalBuilder().assembleConjunctionStartOffset(subs);
+  }
+
+  int assembleConjunctionStartOffset(List<? extends MatchesIterator> subs) throws IOException {
+    assemblySources.clear();
+    int start = Integer.MAX_VALUE;
+    for (MatchesIterator s : subs) {
+      int v = s.startOffset();
+      if (v == -1) {
+        return -1;
+      }
+      start = Math.min(start, v);
+    }
+    return start;
+  }
