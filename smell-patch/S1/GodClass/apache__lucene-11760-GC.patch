+  int assembleConjunctionEndOffset(List<? extends MatchesIterator> subs) throws IOException {
+    assemblySources.clear();
+    int end = -1;
+    for (MatchesIterator s : subs) {
+      int v = s.endOffset();
+      if (v == -1) {
+        return -1;
+      }
+      end = Math.max(end, v);
+    }
+    return end;
+  }
