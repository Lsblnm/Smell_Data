+  IntervalIterator assembleWrappedMatches(IntervalMatchesIterator mi, int doc) {
+    assemblySources.clear();
+    return new IntervalIterator() {
+
+      MatchWrapState state = MatchWrapState.UNPOSITIONED;
+
+      @Override
+      public int start() {
+        if (state == MatchWrapState.NO_MORE_INTERVALS) {
+          return NO_MORE_INTERVALS;
+        }
+        assert state == MatchWrapState.ITERATING;
+        return mi.startPosition();
+      }
+
+      @Override
+      public int end() {
+        if (state == MatchWrapState.NO_MORE_INTERVALS) {
+          return NO_MORE_INTERVALS;
+        }
+        assert state == MatchWrapState.ITERATING;
+        return mi.endPosition();
+      }
+
+      @Override
+      public int gaps() {
+        assert state == MatchWrapState.ITERATING;
+        return mi.gaps();
+      }
+
+      @Override
+      public int width() {
+        assert state == MatchWrapState.ITERATING;
+        return mi.width();
+      }
+
+      @Override
+      public int nextInterval() throws IOException {
+        assert state == MatchWrapState.ITERATING;
+        if (mi.next()) {
+          return mi.startPosition();
+        }
+        state = MatchWrapState.NO_MORE_INTERVALS;
+        return NO_MORE_INTERVALS;
+      }
+
+      @Override
+      public float matchCost() {
+        return 1;
+      }
+
+      @Override
+      public int docID() {
+        switch (state) {
+          case UNPOSITIONED:
+            return -1;
+          case ITERATING:
+          case NO_MORE_INTERVALS:
+            return doc;
+          case EXHAUSTED:
+        }
+        return NO_MORE_DOCS;
+      }
+
+      @Override
+      public int nextDoc() {
+        switch (state) {
+          case UNPOSITIONED:
+            state = MatchWrapState.ITERATING;
+            return doc;
+          case ITERATING:
+          case NO_MORE_INTERVALS:
+            state = MatchWrapState.EXHAUSTED;
+            break;
+          case EXHAUSTED:
+        }
+        return NO_MORE_DOCS;
+      }
+
+      @Override
+      public int advance(int target) {
+        if (target == doc) {
+          state = MatchWrapState.ITERATING;
+          return doc;
+        }
+        state = MatchWrapState.EXHAUSTED;
+        return NO_MORE_DOCS;
+      }
+
+      @Override
+      public long cost() {
+        return 1;
+      }
+    };
+  }
