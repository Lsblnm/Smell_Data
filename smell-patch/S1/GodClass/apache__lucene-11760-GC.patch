+  static void cacheIntervalMatches(CachingMatchesIterator cached) throws IOException {
+    new IntervalBuilder().assembleCachedMatches(cached);
+  }
+
+  void assembleCachedMatches(CachingMatchesIterator cached) throws IOException {
+    assemblySources.clear();
+    cached.count = 0;
+    MatchesIterator mi = cached.innerMatches().getSubMatches();
+    if (mi == null) {
+      cached.count = 1;
+      cached.posAndOffsets[0] = cached.innerMatches().startPosition();
+      cached.posAndOffsets[1] = cached.innerMatches().endPosition();
+      cached.posAndOffsets[2] = cached.innerMatches().startOffset();
+      cached.posAndOffsets[3] = cached.innerMatches().endOffset();
+      cached.matchingQueries[0] = cached.innerMatches().getQuery();
+    } else {
+      while (mi.next()) {
+        if (cached.count * 4 >= cached.posAndOffsets.length) {
+          cached.posAndOffsets = ArrayUtil.grow(cached.posAndOffsets, (cached.count + 1) * 4);
+          cached.matchingQueries = ArrayUtil.grow(cached.matchingQueries, (cached.count + 1));
+        }
+        cached.posAndOffsets[cached.count * 4] = mi.startPosition();
+        cached.posAndOffsets[cached.count * 4 + 1] = mi.endPosition();
+        cached.posAndOffsets[cached.count * 4 + 2] = mi.startOffset();
+        cached.posAndOffsets[cached.count * 4 + 3] = mi.endOffset();
+        cached.matchingQueries[cached.count] = mi.getQuery();
+        cached.count++;
+      }
+    }
+  }
