+  static IntervalsSource buildRepeatingSource(IntervalsSource in, int childCount) {
+    if (childCount == 1) {
+      return in;
+    }
+    assert childCount > 0;
+    return RepeatingIntervalsSource.instantiate(in, childCount);
+  }
