+  static org.apache.lucene.search.Matches matchesForIntervalQuery(
+      String field, IntervalsSource intervalsSource, LeafReaderContext context, int doc)
+      throws IOException {
+    return org.apache.lucene.search.MatchesUtils.forField(
+        field,
+        () -> {
+          org.apache.lucene.search.MatchesIterator mi =
+              intervalsSource.matches(field, context, doc);
+          if (mi == null) {
+            return null;
+          }
+          return new org.apache.lucene.search.FilterMatchesIterator(mi) {
+            @Override
+            public Query getQuery() {
+              return new IntervalQuery(field, intervalsSource);
+            }
+          };
+        });
+  }
