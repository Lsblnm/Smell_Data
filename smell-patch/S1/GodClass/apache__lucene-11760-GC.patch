+  static IntervalsSource buildBlockSource(List<IntervalsSource> sources) {
+    List<IntervalsSource> flattened = flattenBlockSources(sources);
+    if (flattened.size() == 1) {
+      return flattened.get(0);
+    }
+    return Intervals.or(Disjunctions.pullUp(flattened, BlockIntervalsSource::instantiate));
+  }
