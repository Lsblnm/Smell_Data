+  static IntervalIterator minimizingIntervals(
+      List<IntervalsSource> subSources, String field, LeafReaderContext ctx,
+      java.util.function.BiFunction<List<IntervalIterator>, MinimizingConjunctionIntervalsSource.MatchCallback, IntervalIterator> combine)
+      throws IOException {
+    List<IntervalIterator> subIntervals = new ArrayList<>();
+    for (IntervalsSource source : subSources) {
+      IntervalIterator it = source.intervals(field, ctx);
+      if (it == null) {
+        return null;
+      }
+      subIntervals.add(it);
+    }
+    return combine.apply(subIntervals, MinimizingConjunctionIntervalsSource.MatchCallback.NO_OP);
+  }
