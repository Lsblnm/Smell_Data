+  static IntervalMatchesIterator minimizingMatches(
+      List<IntervalsSource> subSources,
+      String field,
+      LeafReaderContext ctx,
+      int doc,
+      java.util.function.BiFunction<List<IntervalIterator>, MinimizingConjunctionIntervalsSource.MatchCallback, IntervalIterator> combine)
+      throws IOException {
+    List<CachingMatchesIterator> subs = new ArrayList<>();
+    for (IntervalsSource source : subSources) {
+      IntervalMatchesIterator mi = source.matches(field, ctx, doc);
+      if (mi == null) {
+        return null;
+      }
+      subs.add(new CachingMatchesIterator(mi));
+    }
+    IntervalIterator it =
+        combine.apply(
+            subs.stream()
+                .map(m -> IntervalMatches.wrapMatches(m, doc))
+                .collect(java.util.stream.Collectors.toList()),
+            MinimizingConjunctionIntervalsSource.cacheIterators(subs));
+    if (it.advance(doc) != doc) {
+      return null;
+    }
+    if (it.nextInterval() == IntervalIterator.NO_MORE_INTERVALS) {
+      return null;
+    }
+    return new ConjunctionMatchesIterator(it, subs);
+  }
