+  static int nextMinimumShouldMatchInterval(
+      org.apache.lucene.util.PriorityQueue<IntervalIterator> proximityQueue,
+      org.apache.lucene.util.PriorityQueue<IntervalIterator> backgroundQueue,
+      int minShouldMatch,
+      int[] startEndQueueEndSlop,
+      IntervalIterator[] leadHolder,
+      MinimizingConjunctionIntervalsSource.MatchCallback onMatch)
+      throws IOException {
+    leadHolder[0] = null;
+    while (proximityQueue.size() == minShouldMatch
+        && proximityQueue.top().start() == startEndQueueEndSlop[0]) {
+      IntervalIterator it = proximityQueue.pop();
+      if (it != null && it.nextInterval() != IntervalIterator.NO_MORE_INTERVALS) {
+        backgroundQueue.add(it);
+        IntervalIterator next = backgroundQueue.pop();
+        assert next != null;
+        proximityQueue.add(next);
+        if (next.end() > startEndQueueEndSlop[2]) {
+          startEndQueueEndSlop[2] = next.end();
+        }
+      }
+    }
+    if (proximityQueue.size() < minShouldMatch) {
+      return startEndQueueEndSlop[0] = startEndQueueEndSlop[1] = IntervalIterator.NO_MORE_INTERVALS;
+    }
+    do {
+      onMatch.onMatch();
+      startEndQueueEndSlop[0] = proximityQueue.top().start();
+      startEndQueueEndSlop[1] = startEndQueueEndSlop[2];
+      int slop = startEndQueueEndSlop[1] - startEndQueueEndSlop[0] + 1;
+      for (IntervalIterator it : proximityQueue) {
+        slop -= it.width();
+      }
+      startEndQueueEndSlop[3] = slop;
+      if (proximityQueue.top().end() == startEndQueueEndSlop[1]) {
+        return startEndQueueEndSlop[0];
+      }
+      leadHolder[0] = proximityQueue.pop();
+      if (leadHolder[0] != null) {
+        if (leadHolder[0].nextInterval() != IntervalIterator.NO_MORE_INTERVALS) {
+          backgroundQueue.add(leadHolder[0]);
+        }
+        IntervalIterator next = backgroundQueue.pop();
+        if (next != null) {
+          proximityQueue.add(next);
+          if (next.end() > startEndQueueEndSlop[2]) {
+            startEndQueueEndSlop[2] = next.end();
+          }
+        }
+      }
+    } while (proximityQueue.size() == minShouldMatch
+        && startEndQueueEndSlop[1] == startEndQueueEndSlop[2]);
+    return startEndQueueEndSlop[0];
+  }
+
+  static void resetMinimumShouldMatchQueues(
+      org.apache.lucene.util.PriorityQueue<IntervalIterator> proximityQueue,
+      org.apache.lucene.util.PriorityQueue<IntervalIterator> backgroundQueue,
+      DisiPriorityQueue disiQueue,
+      int minShouldMatch,
+      int[] startEndQueueEnd)
+      throws IOException {
+    proximityQueue.clear();
+    backgroundQueue.clear();
+    for (DisiWrapper dw = disiQueue.topList(); dw != null; dw = dw.next) {
+      if (dw.intervals.nextInterval() != IntervalIterator.NO_MORE_INTERVALS) {
+        backgroundQueue.add(dw.intervals);
+      }
+    }
+    startEndQueueEnd[2] = -1;
+    for (int i = 0; i < minShouldMatch; i++) {
+      IntervalIterator it = backgroundQueue.pop();
+      if (it == null) {
+        break;
+      }
+      proximityQueue.add(it);
+      if (it.end() > startEndQueueEnd[2]) {
+        startEndQueueEnd[2] = it.end();
+      }
+    }
+    startEndQueueEnd[0] = startEndQueueEnd[1] = -1;
+  }
