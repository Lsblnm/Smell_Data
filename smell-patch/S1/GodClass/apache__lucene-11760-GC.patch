+  static IntervalMatchesIterator createRepeatingMatches(List<IntervalMatchesIterator> subs)
+      throws IOException {
+    int count = subs.size();
+    while (count > 0) {
+      for (int i = 0; i < count; i++) {
+        if (subs.get(count - 1).next() == false) {
+          return null;
+        }
+      }
+      count--;
+    }
+    return new IntervalMatchesIterator() {
+      boolean cached = false;
+      final List<IntervalMatchesIterator> inner = subs;
+
+      @Override
+      public boolean next() throws IOException {
+        if (cached == false) {
+          return cached = true;
+        }
+        if (inner.get(inner.size() - 1).next() == false) {
+          return false;
+        }
+        for (int i = 0; i < inner.size() - 1; i++) {
+          inner.get(i).next();
+        }
+        return true;
+      }
+
+      @Override
+      public int startPosition() {
+        return inner.get(0).startPosition();
+      }
+
+      @Override
+      public int endPosition() {
+        return inner.get(inner.size() - 1).endPosition();
+      }
+
+      @Override
+      public int startOffset() throws IOException {
+        return inner.get(0).startOffset();
+      }
+
+      @Override
+      public int endOffset() throws IOException {
+        return inner.get(inner.size() - 1).endOffset();
+      }
+
+      @Override
+      public MatchesIterator getSubMatches() throws IOException {
+        List<MatchesIterator> subMatches = new ArrayList<>();
+        for (IntervalMatchesIterator mi : inner) {
+          MatchesIterator sub = mi.getSubMatches();
+          if (sub == null) {
+            sub = new ConjunctionMatchesIterator.SingletonMatchesIterator(mi);
+          }
+          subMatches.add(sub);
+        }
+        return org.apache.lucene.search.MatchesUtils.disjunction(subMatches);
+      }
+
+      @Override
+      public Query getQuery() {
+        throw new UnsupportedOperationException();
+      }
+
+      @Override
+      public int gaps() {
+        int width = endPosition() - startPosition() + 1;
+        for (org.apache.lucene.search.MatchesIterator mi : inner) {
+          width = width - (mi.endPosition() - mi.startPosition() + 1);
+        }
+        return width;
+      }
+
+      @Override
+      public int width() {
+        int width = 0;
+        for (org.apache.lucene.search.MatchesIterator mi : inner) {
+          width += (mi.endPosition() - mi.startPosition() + 1);
+        }
+        return width;
+      }
+    };
+  }
