+  static Collection<IntervalsSource> simplifyDisjunction(Collection<IntervalsSource> sources) {
+    Set<IntervalsSource> simplified = new HashSet<>();
+    for (IntervalsSource source : sources) {
+      if (source instanceof DisjunctionIntervalsSource) {
+        simplified.addAll(source.pullUpDisjunctions());
+      } else {
+        simplified.add(source);
+      }
+    }
+    return simplified;
+  }
+
+  static IntervalsSource createDisjunctionSource(
+      Collection<IntervalsSource> subSources, boolean pullUpDisjunctions) {
+    Collection<IntervalsSource> simplified = simplifyDisjunction(subSources);
+    if (simplified.size() == 1) {
+      return simplified.iterator().next();
+    }
+    return DisjunctionIntervalsSource.instantiate(simplified, pullUpDisjunctions);
+  }
