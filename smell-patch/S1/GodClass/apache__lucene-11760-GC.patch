+  static int nextOrderedInterval(
+      List<IntervalIterator> subIterators,
+      int[] startEndSlopI,
+      MinimizingConjunctionIntervalsSource.MatchCallback onMatch)
+      throws IOException {
+    startEndSlopI[0] = startEndSlopI[1] = startEndSlopI[2] = IntervalIterator.NO_MORE_INTERVALS;
+    int lastStart = Integer.MAX_VALUE;
+    boolean minimizing = false;
+    startEndSlopI[3] = 1;
+    while (true) {
+      while (true) {
+        if (subIterators.get(startEndSlopI[3] - 1).end() >= lastStart) {
+          return startEndSlopI[0];
+        }
+        if (startEndSlopI[3] == subIterators.size()
+            || (minimizing
+                && subIterators.get(startEndSlopI[3]).start()
+                    > subIterators.get(startEndSlopI[3] - 1).end())) {
+          break;
+        }
+        do {
+          if (subIterators.get(startEndSlopI[3]).end() >= lastStart
+              || subIterators.get(startEndSlopI[3]).nextInterval()
+                  == IntervalIterator.NO_MORE_INTERVALS) {
+            return startEndSlopI[0];
+          }
+        } while (subIterators.get(startEndSlopI[3]).start()
+            <= subIterators.get(startEndSlopI[3] - 1).end());
+        startEndSlopI[3]++;
+      }
+      startEndSlopI[0] = subIterators.get(0).start();
+      if (startEndSlopI[0] == IntervalIterator.NO_MORE_INTERVALS) {
+        return startEndSlopI[1] = IntervalIterator.NO_MORE_INTERVALS;
+      }
+      startEndSlopI[1] = subIterators.get(subIterators.size() - 1).end();
+      startEndSlopI[2] = startEndSlopI[1] - startEndSlopI[0] + 1;
+      for (IntervalIterator subIterator : subIterators) {
+        startEndSlopI[2] -= subIterator.width();
+      }
+      onMatch.onMatch();
+      lastStart = subIterators.get(subIterators.size() - 1).start();
+      startEndSlopI[3] = 1;
+      if (subIterators.get(0).nextInterval() == IntervalIterator.NO_MORE_INTERVALS) {
+        return startEndSlopI[0];
+      }
+      minimizing = true;
+    }
+  }
+
+  static void resetOrderedInterval(List<IntervalIterator> subIterators, int[] startEndSlopI)
+      throws IOException {
+    subIterators.get(0).nextInterval();
+    startEndSlopI[3] = 1;
+    startEndSlopI[0] = startEndSlopI[1] = startEndSlopI[2] = -1;
+  }
