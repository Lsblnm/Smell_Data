+  static int nextUnorderedInterval(
+      org.apache.lucene.util.PriorityQueue<IntervalIterator> queue,
+      IntervalIterator[] subIterators,
+      int[] startEndSlopQueueEnd,
+      MinimizingConjunctionIntervalsSource.MatchCallback onMatch)
+      throws IOException {
+    int start = startEndSlopQueueEnd[0];
+    while (queue.size() == subIterators.length && queue.top().start() == start) {
+      IntervalIterator it = queue.pop();
+      if (it != null && it.nextInterval() != IntervalIterator.NO_MORE_INTERVALS) {
+        queue.add(it);
+        if (it.end() > startEndSlopQueueEnd[3]) {
+          startEndSlopQueueEnd[3] = it.end();
+        }
+      }
+    }
+    if (queue.size() < subIterators.length) {
+      startEndSlopQueueEnd[0] = startEndSlopQueueEnd[1] = IntervalIterator.NO_MORE_INTERVALS;
+      return startEndSlopQueueEnd[0];
+    }
+    do {
+      startEndSlopQueueEnd[0] = queue.top().start();
+      startEndSlopQueueEnd[1] = startEndSlopQueueEnd[3];
+      startEndSlopQueueEnd[2] = startEndSlopQueueEnd[1] - startEndSlopQueueEnd[0] + 1;
+      for (IntervalIterator it : subIterators) {
+        startEndSlopQueueEnd[2] -= it.width();
+      }
+      onMatch.onMatch();
+      if (queue.top().end() == startEndSlopQueueEnd[1]) {
+        return startEndSlopQueueEnd[0];
+      }
+      IntervalIterator it = queue.pop();
+      if (it != null && it.nextInterval() != IntervalIterator.NO_MORE_INTERVALS) {
+        queue.add(it);
+        if (it.end() > startEndSlopQueueEnd[3]) {
+          startEndSlopQueueEnd[3] = it.end();
+        }
+      }
+    } while (queue.size() == subIterators.length && startEndSlopQueueEnd[1] == startEndSlopQueueEnd[3]);
+    return startEndSlopQueueEnd[0];
+  }
+
+  static void resetUnorderedInterval(
+      org.apache.lucene.util.PriorityQueue<IntervalIterator> queue,
+      IntervalIterator[] subIterators,
+      int[] startEndSlopQueueEnd)
+      throws IOException {
+    startEndSlopQueueEnd[3] = startEndSlopQueueEnd[0] = startEndSlopQueueEnd[1] = -1;
+    queue.clear();
+    for (IntervalIterator it : subIterators) {
+      if (it.nextInterval() == IntervalIterator.NO_MORE_INTERVALS) {
+        break;
+      }
+      queue.add(it);
+      if (it.end() > startEndSlopQueueEnd[3]) {
+        startEndSlopQueueEnd[3] = it.end();
+      }
+    }
+  }
