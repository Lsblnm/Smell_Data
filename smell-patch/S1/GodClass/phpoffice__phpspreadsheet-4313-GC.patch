+     * @param string $to Encoding to convert to, e.g. 'UTF-8'
+     * @param string $from Encoding to convert from, e.g. 'UTF-16LE'
+     */
+    public function convertEncoding(string $textValue, string $to, string $from): string
+    {
+        $this->stringState = __FUNCTION__;
+        $this->stringHits[] = __FUNCTION__;
+
+        if ($this->getIsIconvEnabled()) {
+            $result = iconv($from, $to . $this->iconvOptions, $textValue);
+            if (false !== $result) {
+                return $result;
+            }
+        }
+
+        return mb_convert_encoding($textValue, $to, $from);
+    }
