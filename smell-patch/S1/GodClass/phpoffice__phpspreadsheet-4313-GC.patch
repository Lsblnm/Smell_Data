+    public function writeCellProperties(CellStyle $style): void
+        {
+            $this->styleState = __FUNCTION__;
+            $this->styleHits[] = __FUNCTION__;
+
+            // Align
+            $hAlign = $style->getAlignment()->getHorizontal();
+            $hAlign = $this->mapHorizontalAlignment($hAlign);
+            $vAlign = $style->getAlignment()->getVertical();
+            $wrap = $style->getAlignment()->getWrapText();
+            $indent = $style->getAlignment()->getIndent();
+
+            $this->odsStyleWriter->startElement('style:table-cell-properties');
+            if (!empty($vAlign) || $wrap) {
+                if (!empty($vAlign)) {
+                    $vAlign = $this->mapVerticalAlignment($vAlign);
+                    $this->odsStyleWriter->writeAttribute('style:vertical-align', $vAlign);
+                }
+                if ($wrap) {
+                    $this->odsStyleWriter->writeAttribute('fo:wrap-option', 'wrap');
+                }
+            }
+            $this->odsStyleWriter->writeAttribute('style:rotation-align', 'none');
+
+            // Fill
+            $this->writeFillStyle($style->getFill());
+
+            // Border
+            $this->writeBordersStyle($style->getBorders());
+
+            $this->odsStyleWriter->endElement();
+
+            if ($hAlign !== '' || !empty($indent)) {
+                $this->odsStyleWriter
+                    ->startElement('style:paragraph-properties');
+                if ($hAlign !== '') {
+                    $this->odsStyleWriter->writeAttribute('fo:text-align', $hAlign);
+                }
+                if (!empty($indent)) {
+                    $indentString = sprintf('%.4f', $indent * self::INDENT_TO_INCHES) . 'in';
+                    $this->odsStyleWriter->writeAttribute('fo:margin-left', $indentString);
+                }
+                $this->odsStyleWriter->endElement();
+            }
+        }
+
+    public function mapUnderlineStyle(Font $font): string
+        {
+            $this->styleState = __FUNCTION__;
+            $this->styleHits[] = __FUNCTION__;
+
+            return match ($font->getUnderline()) {
+                Font::UNDERLINE_DOUBLE, Font::UNDERLINE_DOUBLEACCOUNTING => 'double',
+                Font::UNDERLINE_SINGLE, Font::UNDERLINE_SINGLEACCOUNTING => 'single',
+                default => 'none',
+            };
+        }
+
+    public function writeTextProperties(CellStyle $style): void
+        {
+            $this->styleState = __FUNCTION__;
+            $this->styleHits[] = __FUNCTION__;
+
+            // Font
+            $this->odsStyleWriter->startElement('style:text-properties');
+
+            $font = $style->getFont();
+
+            if ($font->getBold()) {
+                $this->odsStyleWriter->writeAttribute('fo:font-weight', 'bold');
+                $this->odsStyleWriter->writeAttribute('style:font-weight-complex', 'bold');
+                $this->odsStyleWriter->writeAttribute('style:font-weight-asian', 'bold');
+            }
+
+            if ($font->getItalic()) {
+                $this->odsStyleWriter->writeAttribute('fo:font-style', 'italic');
+            }
+
+            $this->odsStyleWriter->writeAttribute('fo:color', sprintf('#%s', $font->getColor()->getRGB()));
+
+            if ($family = $font->getName()) {
+                $this->odsStyleWriter->writeAttribute('fo:font-family', $family);
+            }
+
+            if ($size = $font->getSize()) {
+                $this->odsStyleWriter->writeAttribute('fo:font-size', sprintf('%.1Fpt', $size));
+            }
+
+            if ($font->getUnderline() && $font->getUnderline() !== Font::UNDERLINE_NONE) {
+                $this->odsStyleWriter->writeAttribute('style:text-underline-style', 'solid');
+                $this->odsStyleWriter->writeAttribute('style:text-underline-width', 'auto');
+                $this->odsStyleWriter->writeAttribute('style:text-underline-color', 'font-color');
+
+                $underline = $this->mapUnderlineStyle($font);
+                $this->odsStyleWriter->writeAttribute('style:text-underline-type', $underline);
+            }
+
+            $this->odsStyleWriter->endElement(); // Close style:text-properties
+        }
