+    public function writeAllWorksheetSettings(XMLWriter $objWriter, Spreadsheet $spreadsheet): void
+        {
+            $this->writerState = __FUNCTION__;
+            $this->writerHits[] = __FUNCTION__;
+
+            $objWriter->writeAttribute('config:name', 'Tables');
+
+            foreach ($spreadsheet->getWorksheetIterator() as $worksheet) {
+                $this->writeWorksheetSettings($objWriter, $worksheet);
+            }
+
+            $objWriter->endElement(); // config:config-item-map-entry Tables
+        }
