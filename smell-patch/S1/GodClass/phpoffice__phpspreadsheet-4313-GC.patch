+    public function cellRefBeforeCellAddressName(): string
+        {
+            $this->cellRefState = __FUNCTION__;
+            $this->cellRefHits[] = __FUNCTION__;
+
+            return $this->cellRefBeforeCellAddress;
+        }
+
+    public function refreshRequired(string $beforeCellAddress, int $numberOfColumns, int $numberOfRows): bool
+        {
+            $this->cellRefState = __FUNCTION__;
+            $this->cellRefHits[] = __FUNCTION__;
+
+            return $this->cellRefBeforeCellAddress !== $beforeCellAddress
+                || $this->cellRefNumberOfColumns !== $numberOfColumns
+                || $this->cellRefNumberOfRows !== $numberOfRows;
+        }
+
+    public function updateCellReference(string $cellReference = 'A1', bool $includeAbsoluteReferences = false, bool $onlyAbsoluteReferences = false): string
+        {
+            $this->cellRefState = __FUNCTION__;
+            $this->cellRefHits[] = __FUNCTION__;
+
+            if ($this->coordinateIsRange($cellReference)) {
+                throw new Exception('Only single cell references may be passed to this method.');
+            }
+
+            // Get coordinate of $cellReference
+            [$newColumn, $newRow] = $this->coordinateFromString($cellReference);
+            $newColumnIndex = $this->columnIndexFromString(str_replace('$', '', $newColumn));
+            $newRowIndex = (int) str_replace('$', '', $newRow);
+
+            $absoluteColumn = $newColumn[0] === '$' ? '$' : '';
+            $absoluteRow = $newRow[0] === '$' ? '$' : '';
+            // Verify which parts should be updated
+            if ($onlyAbsoluteReferences === true) {
+                $updateColumn = (($absoluteColumn === '$') && $newColumnIndex >= $this->cellRefBeforeColumn);
+                $updateRow = (($absoluteRow === '$') && $newRowIndex >= $this->cellRefBeforeRow);
+            } elseif ($includeAbsoluteReferences === false) {
+                $updateColumn = (($absoluteColumn !== '$') && $newColumnIndex >= $this->cellRefBeforeColumn);
+                $updateRow = (($absoluteRow !== '$') && $newRowIndex >= $this->cellRefBeforeRow);
+            } else {
+                $updateColumn = ($newColumnIndex >= $this->cellRefBeforeColumn);
+                $updateRow = ($newRowIndex >= $this->cellRefBeforeRow);
+            }
+
+            // Create new column reference
+            if ($updateColumn) {
+                $newColumn = $this->updateColumnReference($newColumnIndex, $absoluteColumn);
+            }
+
+            // Create new row reference
+            if ($updateRow) {
+                $newRow = $this->updateRowReference($newRowIndex, $absoluteRow);
+            }
+
+            // Return new reference
+            return "{$newColumn}{$newRow}";
+        }
+
+    public function cellAddressInDeleteRange(string $cellAddress): bool
+        {
+            $this->cellRefState = __FUNCTION__;
+            $this->cellRefHits[] = __FUNCTION__;
+
+            [$cellColumn, $cellRow] = $this->coordinateFromString($cellAddress);
+            $cellColumnIndex = $this->columnIndexFromString($cellColumn);
+            //    Is cell within the range of rows/columns if we're deleting
+            if (
+                $this->cellRefNumberOfRows < 0
+                && ($cellRow >= ($this->cellRefBeforeRow + $this->cellRefNumberOfRows))
+                && ($cellRow < $this->cellRefBeforeRow)
+            ) {
+                return true;
+            } elseif (
+                $this->cellRefNumberOfColumns < 0
+                && ($cellColumnIndex >= ($this->cellRefBeforeColumn + $this->cellRefNumberOfColumns))
+                && ($cellColumnIndex < $this->cellRefBeforeColumn)
+            ) {
+                return true;
+            }
+
+            return false;
+        }
+
+    public function updateColumnReference(int $newColumnIndex, string $absoluteColumn): string
+        {
+            $this->cellRefState = __FUNCTION__;
+            $this->cellRefHits[] = __FUNCTION__;
+
+            $newColumn = $this->stringFromColumnIndex(min($newColumnIndex + $this->cellRefNumberOfColumns, AddressRange::MAX_COLUMN_INT));
+
+            return "{$absoluteColumn}{$newColumn}";
+        }
+
+    public function updateRowReference(int $newRowIndex, string $absoluteRow): string
+        {
+            $this->cellRefState = __FUNCTION__;
+            $this->cellRefHits[] = __FUNCTION__;
+
+            $newRow = $newRowIndex + $this->cellRefNumberOfRows;
+            $newRow = ($newRow > AddressRange::MAX_ROW) ? AddressRange::MAX_ROW : $newRow;
+
+            return "{$absoluteRow}{$newRow}";
+        }
