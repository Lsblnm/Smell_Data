+        // Deactivate iconv default options if they fail (as seen on IMB i)
+        if ($this->isIconvEnabled && !@iconv('UTF-8', 'UTF-16LE' . $this->iconvOptions, 'x')) {
+            $this->iconvOptions = '';
+        }
+
+        return $this->isIconvEnabled;
+    }
