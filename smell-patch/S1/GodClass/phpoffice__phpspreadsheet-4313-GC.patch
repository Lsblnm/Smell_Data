+    public function readAutoFilters(DOMElement $workbookData): void
+        {
+            $this->filterState = __FUNCTION__;
+            $this->filterHits[] = __FUNCTION__;
+
+            $databases = $workbookData->getElementsByTagNameNS($this->filterTableNs, 'database-ranges');
+
+            foreach ($databases as $autofilters) {
+                foreach ($autofilters->childNodes as $autofilter) {
+                    $autofilterRange = $this->getAutoFilterAttributeValue($autofilter, 'target-range-address');
+                    if ($autofilterRange !== null) {
+                        $baseAddress = $this->convertToExcelAddressValue($autofilterRange);
+                        $this->filterSpreadsheet->getActiveSheet()->setAutoFilter($baseAddress);
+                    }
+                }
+            }
+        }
+
+    public function getAutoFilterAttributeValue(?DOMNode $node, string $attributeName): ?string
+        {
+            $this->filterState = __FUNCTION__;
+            $this->filterHits[] = __FUNCTION__;
+
+            if ($node !== null && $node->attributes !== null) {
+                $attribute = $node->attributes->getNamedItemNS(
+                    $this->filterTableNs,
+                    $attributeName
+                );
+
+                if ($attribute !== null) {
+                    return $attribute->nodeValue;
+                }
+            }
+
+            return null;
+        }
