+    public function ifCondition(mixed $condition): string
+        {
+            $this->calcState = __FUNCTION__;
+            $this->calcHits[] = __FUNCTION__;
+
+            $condition = $this->flattenSingleValue($condition);
+
+            if ($condition === '' || $condition === null) {
+                return '=""';
+            }
+            if (!is_string($condition) || !in_array($condition[0], ['>', '<', '='], true)) {
+                $condition = $this->operandSpecialHandling($condition);
+                if (is_bool($condition)) {
+                    return '=' . ($condition ? 'TRUE' : 'FALSE');
+                } elseif (!is_numeric($condition)) {
+                    if ($condition !== '""') { // Not an empty string
+                        // Escape any quotes in the string value
+                        $condition = (string) preg_replace('/"/ui', '""', $condition);
+                    }
+                    $condition = Calculation::wrapResult(strtoupper($condition));
+                }
+
+                return str_replace('""""', '""', '=' . $condition);
+            }
+            $operator = $operand = '';
+            if (1 === preg_match('/(=|<[>=]?|>=?)(.*)/', $condition, $matches)) {
+                [, $operator, $operand] = $matches;
+            }
+
+            $operand = $this->operandSpecialHandling($operand);
+            if (is_numeric(trim($operand, '"'))) {
+                $operand = trim($operand, '"');
+            } elseif (!is_numeric($operand) && $operand !== 'FALSE' && $operand !== 'TRUE') {
+                $operand = str_replace('"', '""', $operand);
+                $operand = Calculation::wrapResult(strtoupper($operand));
+            }
+
+            return str_replace('""""', '""', $operator . $operand);
+        }
