+    /**
+     * Build control characters array.
+     */
+    public function buildControlCharacters(): void
+    {
+        $this->stringState = __FUNCTION__;
+        $this->stringHits[] = __FUNCTION__;
+
+        for ($i = 0; $i <= 31; ++$i) {
+            if ($i != 9 && $i != 10 && $i != 13) {
+                $find = '_x' . sprintf('%04s', strtoupper(dechex($i))) . '_';
+                $replace = chr($i);
+                $this->controlCharacters[$find] = $replace;
+            }
+        }
+    }
