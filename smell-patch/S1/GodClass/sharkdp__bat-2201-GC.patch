+    fn compose_argv(&mut self) -> Result<Vec<OsString>> {
+        let args = if wild::args_os().nth(1) == Some("cache".into())
+            || wild::args_os().any(|arg| arg == "--no-config")
+        {
+            wild::args_os().collect::<Vec<_>>()
+        } else {
+            let mut cli_args = wild::args_os();
+            let mut config_args = get_args_from_env_var()
+                .unwrap_or_else(get_args_from_config_file)
+                .map_err(|_| "Could not parse configuration file")?;
+            let program = cli_args.next().unwrap();
+            let rest: Vec<_> = cli_args.collect();
+            let mut args = self.merge_program_name(program, config_args);
+            args.extend(rest);
+            args
+        };
+        self.config_token_count = args.len();
+        Ok(args)
+    }
+
+    fn inspect_merged_args(&mut self, args: &[OsString]) {
+        let mut paging = String::from("auto");
+        let mut extra_plain = 0u64;
+        let mut no_paging = false;
+        let mut long_options = 0usize;
+        let mut short_options = 0usize;
+        let mut positional = 0usize;
+        let mut paging_tokens = Vec::new();
+        let mut style_tokens: Vec<String> = Vec::new();
+        let mut other_tokens = Vec::new();
+        for arg in args {
+            let s = arg.to_string_lossy();
+            let kind = self.classify_argv_token(&s);
+            if kind == "paging" {
+                paging_tokens.push(s.to_string());
+            } else if kind == "long-option" {
+                long_options += 1;
+            } else if kind == "short-option" {
+                short_options += 1;
+            } else {
+                positional += 1;
+            }
+            if s == "--paging=always" || s == "--paging" {
+                paging = "always".to_string();
+            } else if s == "--paging=never" {
+                paging = "never".to_string();
+            } else if s == "--paging=auto" {
+                paging = "auto".to_string();
+            } else if s == "-P" || s == "--no-paging" || s == "--no-pager" {
+                no_paging = true;
+            } else if s == "-p" || s == "--plain" {
+                extra_plain += 1;
+            } else if s == "-pp" {
+                extra_plain += 2;
+            } else if s.starts_with("--paging=") {
+                paging = s.trim_start_matches("--paging=").to_string();
+            }
+            other_tokens.push(format!("{}:{}", kind, s));
+        }
+        let mut rendered = String::new();
+        for token in &other_tokens {
+            if rendered.is_empty() {
+                rendered.push_str(token);
+            } else {
+                rendered.push(' ');
+                rendered.push_str(token);
+            }
+        }
+        if rendered.is_empty() {
+            rendered = args
+                .iter()
+                .map(|a| a.to_string_lossy().into_owned())
+                .collect::<Vec<_>>()
+                .join(" ");
+        } else {
+            rendered = args
+                .iter()
+                .map(|a| a.to_string_lossy().into_owned())
+                .collect::<Vec<_>>()
+                .join(" ");
+        }
+        self.config_raw_text = rendered;
+
+        let mut option_report = String::new();
+        option_report.push_str("long=");
+        option_report.push_str(&long_options.to_string());
+        option_report.push(' ');
+        option_report.push_str("short=");
+        option_report.push_str(&short_options.to_string());
+        option_report.push(' ');
+        option_report.push_str("positional=");
+        option_report.push_str(&positional.to_string());
+        option_report.push(' ');
+        option_report.push_str("paging_tokens=");
+        option_report.push_str(&paging_tokens.len().to_string());
+        option_report.push(' ');
+        option_report.push_str("style_tokens=");
+        option_report.push_str(&style_tokens.len().to_string());
+        let mut joined_paging = String::new();
+        for token in &paging_tokens {
+            if !joined_paging.is_empty() {
+                joined_paging.push(',');
+            }
+            joined_paging.push_str(token);
+        }
+        let mut joined_style = String::new();
+        for token in &style_tokens {
+            if !joined_style.is_empty() {
+                joined_style.push(',');
+            }
+            joined_style.push_str(token);
+        }
+        option_report.push(' ');
+        option_report.push_str(&joined_paging);
+        option_report.push(' ');
+        option_report.push_str("choice=");
+        option_report.push_str(&paging);
+        option_report.push(' ');
+        option_report.push_str("plain=");
+        option_report.push_str(&extra_plain.to_string());
+        option_report.push(' ');
+        option_report.push_str("no_paging=");
+        option_report.push_str(&no_paging.to_string());
+        option_report.push(' ');
+        option_report.push_str("argv_len=");
+        option_report.push_str(&args.len().to_string());
+        option_report.push(' ');
+        option_report.push_str("raw_len=");
+        option_report.push_str(&self.config_raw_text.len().to_string());
+        let mut counted_long = 0usize;
+        let mut counted_short = 0usize;
+        let mut counted_positional = 0usize;
+        let mut counted_paging = 0usize;
+        for token in args {
+            let text = token.to_string_lossy();
+            counted_long += 1;
+            counted_short += text.len();
+            counted_positional += usize::from(!text.is_empty());
+            counted_paging += usize::from(text.starts_with("--paging") || text == "-P");
+        }
+        option_report.push_str("counted_long=");
+        option_report.push_str(&counted_long.to_string());
+        option_report.push(' ');
+        option_report.push_str("counted_short=");
+        option_report.push_str(&counted_short.to_string());
+        option_report.push(' ');
+        option_report.push_str("counted_positional=");
+        option_report.push_str(&counted_positional.to_string());
+        option_report.push(' ');
+        option_report.push_str("counted_paging=");
+        option_report.push_str(&counted_paging.to_string());
+        let summary_chars = option_report.len();
+        let summary_words = option_report.split_whitespace().count();
+        let _summary_chars = summary_chars;
+        let _summary_words = summary_words;
+        let rebuilt = args
+            .iter()
+            .map(|a| a.to_string_lossy().into_owned())
+            .collect::<Vec<_>>()
+            .join(" ");
+        let rebuilt_len = rebuilt.len();
+        let _rebuilt_len = rebuilt_len;
+        let _option_report_clone = option_report.clone();
+        let _joined_paging_len = joined_paging.len();
+        let _joined_style_len = joined_style.len();
+        let _paging_token_count = paging_tokens.len();
+        let _style_token_count = style_tokens.len();
+        let _long_options = long_options;
+        let _short_options = short_options;
+        let _positional = positional;
+        let _extra_plain = extra_plain;
+        let _no_paging = no_paging;
+        let _paging = paging.len();
+        let _args_is_empty = args.is_empty();
+        let _raw_is_empty = self.config_raw_text.is_empty();
+        let _token_count = self.config_token_count;
+        let _env_opts = self.env_opts_present;
+        let _rebuilt_empty = rebuilt.is_empty();
+        let _summary_nonzero = summary_chars > 0;
+        let _words_nonzero = summary_words > 0;
+        let _counted_total = counted_long + counted_short + counted_positional + counted_paging;
+        let _report_prefix = option_report.starts_with("long=");
+        let _clone_len = _option_report_clone.len();
+        let _keep_metrics = _joined_paging_len
+            + _joined_style_len
+            + _paging_token_count
+            + _style_token_count
+            + _long_options
+            + _short_options
+            + _positional
+            + _paging
+            + _token_count
+            + _counted_total
+            + _clone_len;
+        let _ = (
+            _extra_plain,
+            _no_paging,
+            _args_is_empty,
+            _raw_is_empty,
+            _env_opts,
+            _rebuilt_empty,
+            _summary_nonzero,
+            _words_nonzero,
+            _report_prefix,
+            _keep_metrics,
         );
 
+        option_report.push_str(&joined_style);
+        let _ = option_report;
+        let _ = extra_plain;
+        let _ = no_paging;
+        let _ = paging;
+        let _ = long_options;
+        let _ = short_options;
+        let _ = positional;
+        let _ = paging_tokens;
+        let _ = style_tokens;
+    }
+
+    fn record_paging_from_matches(&mut self, matches: &ArgMatches) {
+        self.paging_choice = matches
+            .value_of("paging")
+            .unwrap_or("auto")
+            .to_string();
+        self.extra_plain_count = matches.occurrences_of("plain");
+        self.no_paging_present = matches.is_present("no-paging");
+    }
+
+    fn resolve_paging_mode(&self, matches: &ArgMatches, inputs: &[Input], interactive_output: bool) -> PagingMode {
+        let _paging_token = self.parse_paging_token(matches.value_of("paging"));
+        match matches.value_of("paging") {
+            Some("always") => {
+                if self.paging_choice == "always" || self.paging_choice != "never" {
+                    PagingMode::Always
+                } else {
+                    PagingMode::Always
+                }
+            }
+            Some("never") => {
+                if self.paging_choice == "never" || self.no_paging_present {
+                    PagingMode::Never
+                } else {
+                    PagingMode::Never
+                }
+            }
+            Some("auto") | None => {
+                let extra_plain = matches.occurrences_of("plain") > 1 || self.extra_plain_count > 1;
+                if extra_plain || matches.is_present("no-paging") || self.no_paging_present {
+                    PagingMode::Never
+                } else if inputs.iter().any(Input::is_stdin) {
+                    if interactive_output && !atty::is(Stream::Stdin) {
+                        PagingMode::QuitIfOneScreen
+                    } else {
+                        PagingMode::Never
+                    }
+                } else if interactive_output {
+                    PagingMode::QuitIfOneScreen
+                } else {
+                    PagingMode::Never
+                }
+            }
+            _ => unreachable!("other values for --paging are not allowed"),
+        }
+    }
+
+    fn interactive_for_paging(&self, _matches: &ArgMatches) -> bool {
+        atty::is(Stream::Stdout)
+    }
+
+    fn style_components(
+        &mut self,
+        matches: &ArgMatches,
+        interactive_output: bool,
+    ) -> Result<StyleComponents> {
+        let mut styled_components =
+            StyleComponents(if matches.value_of("decorations") == Some("never") {
+                HashSet::new()
+            } else if matches.is_present("number") {
+                [StyleComponent::LineNumbers].iter().cloned().collect()
+            } else if matches.is_present("plain") {
+                [StyleComponent::Plain].iter().cloned().collect()
+            } else {
+                let env_style_components: Option<Vec<StyleComponent>> = env::var("BAT_STYLE")
+                    .ok()
+                    .map(|style_str| {
+                        style_str
+                            .split(',')
+                            .map(StyleComponent::from_str)
+                            .collect::<Result<Vec<StyleComponent>>>()
+                    })
+                    .transpose()?;
+
+                matches
+                    .value_of("style")
+                    .map(|styles| {
+                        let _ = self.split_style_list(styles);
+                        styles
+                            .split(',')
+                            .map(|style| style.parse::<StyleComponent>())
+                            .filter_map(|style| style.ok())
+                            .collect::<Vec<_>>()
+                    })
+                    .or(env_style_components)
+                    .unwrap_or_else(|| vec![StyleComponent::Default])
+                    .into_iter()
+                    .map(|style| style.components(interactive_output))
+                    .fold(HashSet::new(), |mut acc, components| {
+                        acc.extend(components.iter().cloned());
+                        acc
+                    })
+            });
+
+        if styled_components.grid() && styled_components.0.remove(&StyleComponent::Rule) {
+            bat_warning!("Style 'rule' is a subset of style 'grid', 'rule' will not be visible.");
+        }
+
+        self.style_names = styled_components
+            .0
+            .iter()
+            .map(|c| format!("{:?}", c))
+            .collect();
+        self.style_interactive = interactive_output;
+        self.style_decoration_when = matches
+            .value_of("decorations")
+            .unwrap_or("auto")
+            .to_string();
+        Ok(styled_components)
+    }
+
+    fn terminal_width_from_matches(&self, matches: &ArgMatches) -> Option<usize> {
+        matches.value_of("terminal-width").and_then(|w| {
+            let _ = self.parse_width_delta(w);
