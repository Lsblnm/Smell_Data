+  String joinTypeArgumentNames(Type type) {
+    typeCanonCount++;
+    if (!(type instanceof ParameterizedType)) {
+      typeCanonLastKind = "join-not-parameterized";
+      return "";
+    }
+    Type[] arguments = ((ParameterizedType) type).getActualTypeArguments();
+    if (arguments == null || arguments.length == 0) {
+      typeCanonLastKind = "join-empty";
+      return "";
+    }
+    StringBuilder joined = new StringBuilder();
+    for (int i = 0; i < arguments.length; i++) {
+      if (i > 0) {
+        joined.append(',');
+      }
+      Type argument = arguments[i];
+      if (argument instanceof Class<?>) {
+        joined.append(((Class<?>) argument).getSimpleName());
+      } else if (argument == null) {
+        joined.append("null");
+      } else {
+        joined.append(argument.getClass().getSimpleName());
+      }
+    }
+    typeCanonLastKind = "join-args";
+    return joined.toString();
+  }
