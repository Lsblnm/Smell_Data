+  boolean shouldSkipByCombinedChecks(
+      Field field,
+      boolean serialize,
+      double version,
+      int modifiers,
+      boolean serializeInnerClasses,
+      boolean requireExpose) {
+    fieldExclCount++;
+    fieldExclLastField = field;
+    if (field == null) {
+      fieldExclLastReason = "combined-null";
+      return true;
+    }
+    if (hasDisallowedModifiers(field, modifiers)) {
+      return true;
+    }
+    if (isSyntheticField(field)) {
+      return true;
+    }
+    if (failsVersionConstraint(field.getAnnotation(Since.class), field.getAnnotation(Until.class), version)) {
+      return true;
+    }
+    if (failsExposeRequirement(field, serialize, requireExpose)) {
+      return true;
+    }
+    Class<?> type = field.getType();
+    if (!serializeInnerClasses && isNonStaticInnerClass(type)) {
+      return true;
+    }
+    if (isAnonymousOrNonStaticLocalClass(type)) {
+      return true;
+    }
+    fieldExclLastReason = "combined-allowed";
+    return false;
+  }
