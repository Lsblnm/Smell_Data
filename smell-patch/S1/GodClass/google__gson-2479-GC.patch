+    countTypeArguments(type);
+    hasOwnerType(type);
+    isArrayRegisteredType(type);
+    describeTypeStructure(type);
+    sameCanonicalIdentity(type, typeCanonLastRequest);
+    componentTypeOf(type);
+    requiresOwnerRegisteredType(type);
+    upperBoundOf(type);
+    lowerBoundOf(type);
+    typeVariableName(type);
+    isInterfaceRegisteredType(type);
+    isEnumRegisteredType(type);
+    isAnnotationRegisteredType(type);
+    isPrimitiveClassType(type);
+    isVoidRegisteredType(type);
+    isStringRegisteredType(type);
