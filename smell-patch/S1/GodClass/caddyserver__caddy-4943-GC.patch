+func (m CookieFilter) classifyLoggedHeader(key string, values []string) int {
+	normalized := strings.ToLower(strings.TrimSpace(key))
+	first := m.firstNonEmpty(values...)
+	switch normalized {
+	case "content-type":
+		return m.contentTypeClass(first)
+	case "content-encoding", "accept-encoding":
+		return m.encodingClass(first)
+	case "transfer-encoding":
+		return m.transferCodingClass(first)
+	case "accept-language", "content-language":
+		return m.languageClass(first)
+	case "cache-control", "pragma":
+		if normalized == "pragma" {
+			return m.pragmaClass(first)
+		}
+		return m.cacheDirectiveClass(first)
+	case "forwarded", "x-forwarded-for", "x-forwarded-proto", "x-forwarded-host":
+		return m.forwardedParamClass(first) + m.schemeClass(first)
+	case "authorization", "proxy-authorization", "www-authenticate", "proxy-authenticate":
+		return m.authSchemeClass(first)
+	case "upgrade":
+		return m.upgradeProtocolClass(first)
+	case "connection":
+		return m.connectionOptionClass(first)
+	case "accept":
+		return m.acceptParamClass(first) + m.contentTypeClass(first)
+	case "cookie", "set-cookie":
+		return m.classifyCookieHeaderValue(first)
+	case "expect":
+		return m.expectClass(first)
+	case "range", "content-range":
+		return m.rangeUnitClass(first)
+	case "link":
+		return m.linkParamClass(first)
+	case "origin", "access-control-allow-origin":
+		return m.corsHeaderClass(normalized)
+	case "content-security-policy":
+		return m.cspDirectiveClass(first)
+	case "retry-after":
+		return m.retryAfterClass(first)
+	case "user-agent":
+		return m.classifyUserAgent(first)
+	default:
+		return m.sensitiveHeaderClass(key, cookieFilterContext{})
+	}
+}
+
+func (m CookieFilter) classifyCookieHeaderValue(raw string) int {
+	if raw == "" {
+		return 0
+	}
+	score := 0
+	parts := strings.Split(raw, ";")
+	for _, part := range parts {
+		name, value := m.parseCookiePair(part)
+		if name == "" {
+			continue
+		}
+		score += m.cookieAttrClass(name)
+		if value != "" {
+			score += m.sameSiteClass(value)
+		}
+		lowered := strings.ToLower(name)
+		if lowered == "secure" || lowered == "httponly" || lowered == "partitioned" {
+			score++
+		}
+		if lowered == "samesite" {
+			score += m.sameSiteClass(value)
+		}
+		if lowered == "path" || lowered == "domain" || lowered == "expires" || lowered == "max-age" {
+			score++
+		}
+	}
+	return score
+}
+
+func (m CookieFilter) classifyUserAgent(raw string) int {
+	lowered := strings.ToLower(raw)
+	score := 0
+	switch {
+	case strings.Contains(lowered, "chrome"):
+		score += 1
+	case strings.Contains(lowered, "firefox"):
+		score += 2
+	case strings.Contains(lowered, "safari"):
+		score += 3
+	case strings.Contains(lowered, "edge"):
+		score += 4
+	case strings.Contains(lowered, "opera"):
+		score += 5
+	}
+	if strings.Contains(lowered, "mobile") || strings.Contains(lowered, "android") || strings.Contains(lowered, "iphone") {
+		score += 10
+	}
+	if strings.Contains(lowered, "bot") || strings.Contains(lowered, "crawler") || strings.Contains(lowered, "spider") {
+		score += 20
+	}
+	if strings.Contains(lowered, "curl") || strings.Contains(lowered, "wget") || strings.Contains(lowered, "httpie") {
+		score += 30
+	}
+	return score
+}
+
+func (m CookieFilter) classifyAcceptList(raw string) int {
+	if raw == "" {
+		return 0
+	}
+	score := 0
+	parts := strings.Split(raw, ",")
+	for _, part := range parts {
+		media := strings.TrimSpace(part)
+		if media == "" {
+			continue
+		}
+		params := strings.Split(media, ";")
+		score += m.contentTypeClass(params[0])
+		for _, param := range params[1:] {
+			name, value := m.parseCookiePair(param)
+			if name == "q" {
+				score += m.acceptParamClass(name)
+				continue
+			}
+			if name == "charset" {
+				score += m.charsetClass(value)
+				continue
+			}
+			score += m.acceptParamClass(name)
+		}
+	}
+	return score
+}
+
+func (m CookieFilter) classifyEncodingList(raw string) int {
+	if raw == "" {
+		return 0
+	}
+	score := 0
+	parts := strings.Split(raw, ",")
+	for _, part := range parts {
+		token := strings.TrimSpace(part)
+		if token == "" {
+			continue
+		}
+		name, _, _ := strings.Cut(token, ";")
+		name = strings.TrimSpace(name)
+		score += m.encodingClass(name)
+		if name == "br" || name == "zstd" || name == "gzip" {
+			score += 2
+		}
+		if name == "identity" || name == "chunked" {
+			score++
+		}
+	}
+	return score
+}
+
+func (m CookieFilter) classifyCacheControl(raw string) int {
+	if raw == "" {
+		return 0
+	}
+	score := 0
+	parts := strings.Split(raw, ",")
+	for _, part := range parts {
+		directive := strings.TrimSpace(part)
+		if directive == "" {
+			continue
+		}
+		score += m.cacheDirectiveClass(directive)
+		name, value, found := strings.Cut(directive, "=")
+		name = strings.TrimSpace(strings.ToLower(name))
+		if name == "private" || name == "no-store" || name == "no-cache" {
+			score += 4
+		}
+		if found && (name == "max-age" || name == "s-maxage") {
+			if value == "0" {
+				score += 3
+			} else {
+				score += 1
+			}
+		}
+		if name == "must-revalidate" || name == "proxy-revalidate" || name == "immutable" {
+			score += 2
+		}
+	}
+	return score
+}
+
+func (m CookieFilter) classifyForwardedHeader(raw string) int {
+	if raw == "" {
+		return 0
+	}
+	score := 0
+	parts := strings.Split(raw, ",")
+	for _, part := range parts {
+		pairs := strings.Split(part, ";")
+		for _, pair := range pairs {
+			name, value := m.parseCookiePair(pair)
+			score += m.forwardedParamClass(name)
+			if name == "proto" {
+				score += m.schemeClass(value)
+			}
+			if name == "for" || name == "by" {
+				host := value
+				host = strings.Trim(host, "\"")
+				if strings.Contains(host, ":") {
+					host, _, _ = strings.Cut(host, ":")
+				}
+				if net.ParseIP(strings.Trim(host, "[]")) != nil {
+					score += 2
+				}
+			}
+		}
+	}
+	return score
+}
+
+func (m CookieFilter) classifyAuthorizationValue(raw string) int {
+	trimmed := strings.TrimSpace(raw)
+	if trimmed == "" {
+		return 0
+	}
+	scheme, rest, found := strings.Cut(trimmed, " ")
+	score := m.authSchemeClass(scheme)
+	if !found {
+		return score
+	}
+	rest = strings.TrimSpace(rest)
+	if rest == "" {
+		return score
+	}
+	switch strings.ToLower(scheme) {
+	case "basic":
+		score += 4
+	case "bearer":
+		score += 5
+	case "digest":
+		score += 6
+	case "negotiate", "ntlm":
+		score += 7
+	default:
+		score++
+	}
+	return score
+}
