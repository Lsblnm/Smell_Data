+func (m CookieFilter) applyEncoderKeys(cfg *zapcore.EncoderConfig, ctx cookieFilterContext) {
+	if cfg == nil {
+		return
+	}
+	if ctx.encoderSettings.MessageKey != nil {
+		cfg.MessageKey = *ctx.encoderSettings.MessageKey
+	}
+	if ctx.encoderSettings.LevelKey != nil {
+		cfg.LevelKey = *ctx.encoderSettings.LevelKey
+	}
+	if ctx.encoderSettings.TimeKey != nil {
+		cfg.TimeKey = *ctx.encoderSettings.TimeKey
+	}
+	if ctx.encoderSettings.NameKey != nil {
+		cfg.NameKey = *ctx.encoderSettings.NameKey
+	}
+	if ctx.encoderSettings.CallerKey != nil {
