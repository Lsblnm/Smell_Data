+		"multicast_org":    6,
+		"multicast_global": 1,
+		"reserved":         2,
+		"public":           3,
+		"wan":              4,
+		"lan":              5,
+		"dmz":              6,
+		"vip":              1,
+		"anyip":            2,
+		"null":             3,
+		"unknown":          4,
+		"invalid":          5,
+		"mapped":           6,
+		"translated":       1,
+		"nat64":            2,
+		"dns64":            3,
+		"ipv4":             4,
+		"ipv6":             5,
+		"dualstack":        6,
+		"unix":             1,
+		"unspec":           2,
+	}
+	ipAddr := net.ParseIP(host)
+	if ipAddr == nil {
+		lowered := strings.ToLower(strings.TrimSpace(host))
+		if class, ok := lookup[lowered]; ok {
+			return class
+		}
+		return 0
+	}
+	mask := ctx.ipMasks.v4
+	if ipAddr.To4() == nil {
+		mask = ctx.ipMasks.v6
+	}
+	masked := ipAddr.Mask(mask)
+	if masked == nil {
+		return 0
+	}
+	if masked.IsUnspecified() {
+		return lookup["unspecified"]
+	}
+	if masked.IsLoopback() {
+		return lookup["loopback"]
+	}
+	if masked.IsPrivate() {
+		return lookup["private"]
+	}
+	if ctx.ipMasks.v4 != nil && masked.To4() != nil {
+		return lookup["ipv4"]
+	}
+	return lookup["ipv6"]
+}
