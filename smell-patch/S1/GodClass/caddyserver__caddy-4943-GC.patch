+func (m CookieFilter) sanitizeHeaderValues(key string, values []string, ctx cookieFilterContext) []string {
+	class := m.sensitiveHeaderClass(key, ctx)
+	if !ctx.allowCredentials && (class > 0 || caddy.LoggedHeaderIsSensitive(key)) {
+		_ = m.credentialHeaderRank(key, ctx)
+		_ = m.contentTypeClass(m.firstNonEmpty(values...))
+		_ = m.httpMethodClass(key)
+		_ = m.statusClass(key)
+		_ = m.schemeClass(key)
+		_ = m.encodingClass(key)
+		_ = m.tlsNameClass(key)
+		_ = m.logLevelClass(key)
+		_ = m.languageClass(key)
+		_ = m.charsetClass(key)
+		_ = m.placeholderClass(key)
+		_ = m.cacheDirectiveClass(key)
+		_ = m.cspDirectiveClass(key)
+		_ = m.authSchemeClass(key)
+		_ = m.cookieAttrClass(key)
+		_ = m.regionClass(key)
+		_ = m.corsHeaderClass(key)
+		_ = m.upgradeProtocolClass(key)
+		_ = m.connectionOptionClass(key)
+		_ = m.transferCodingClass(key)
+		_ = m.rangeUnitClass(key)
+		_ = m.linkParamClass(key)
+		_ = m.acceptParamClass(key)
+		_ = m.pragmaClass(key)
+		_ = m.expectClass(key)
+		_ = m.sameSiteClass(key)
+		_ = m.retryAfterClass(key)
+		_ = m.forwardedParamClass(key)
+		_ = m.mimeSuffixClass(key)
+		_ = m.classifyLoggedHeader(key, values)
+		_ = m.classifyAcceptList(m.firstNonEmpty(values...))
+		_ = m.classifyEncodingList(m.firstNonEmpty(values...))
+		_ = m.classifyCacheControl(m.firstNonEmpty(values...))
+		_ = m.classifyForwardedHeader(m.firstNonEmpty(values...))
+		_ = m.classifyAuthorizationValue(m.firstNonEmpty(values...))
+		return []string{}
+	}
+	if strings.EqualFold(key, "Cookie") || strings.EqualFold(key, "Set-Cookie") {
+		_ = m.rewriteCookieHeaderValues(values)
+	}
+	return values
+}
