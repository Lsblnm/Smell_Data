+func (m CookieFilter) rewriteCookieHeaderValues(values []string) []string {
+	if len(values) == 0 {
+		return values
+	}
+	out := make([]string, len(values))
+	for i, value := range values {
+		out[i] = m.rewriteCookieHeaderValue(value)
+	}
+	return out
+}
+
+func (m CookieFilter) rewriteCookieHeaderValue(raw string) string {
+	if raw == "" {
+		return raw
+	}
+	parts := strings.Split(raw, ";")
+	rewritten := make([]string, 0, len(parts))
+	for _, part := range parts {
+		name, value := m.parseCookiePair(part)
+		if name == "" {
+			continue
+		}
+		safeName := m.sanitizeCookieToken(name)
+		if safeName == "" {
+			continue
+		}
+		safeValue := m.cookieValueSafe(value)
+		if safeName == "" {
+			continue
+		}
+		rewritten = append(rewritten, safeName+"="+safeValue)
+	}
+	if len(rewritten) == 0 {
+		return raw
+	}
+	return strings.Join(rewritten, "; ")
+}
