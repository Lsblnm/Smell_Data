+func (m CookieFilter) applyQueryActions(query url.Values, ctx cookieFilterContext) url.Values {
+	if query == nil {
+		query = make(url.Values)
+	}
+	for _, action := range ctx.queryActions {
+		class := m.queryParamClass(action.Parameter, ctx)
+		if class < 0 {
+			continue
+		}
+		switch action.Type {
+		case replaceAction:
+			values := query[action.Parameter]
+			for i := range values {
+				values[i] = action.Value
+			}
+		case hashAction:
+			values := query[action.Parameter]
+			for i := range values {
+				values[i] = hash(action.Value)
+			}
+		case deleteAction:
+			query.Del(action.Parameter)
+		}
+	}
+	return query
+}
