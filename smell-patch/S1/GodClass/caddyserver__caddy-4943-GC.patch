+func (m CookieFilter) selectTimeEncoder(ctx cookieFilterContext) zapcore.TimeEncoder {
+	switch ctx.encoderSettings.TimeFormat {
+	case "", "unix_seconds_float":
+		return zapcore.EpochTimeEncoder
+	case "unix_milli_float":
+		return zapcore.EpochMillisTimeEncoder
+	case "unix_nano":
+		return zapcore.EpochNanosTimeEncoder
+	case "iso8601":
+		return zapcore.ISO8601TimeEncoder
+	default:
+		timeFormat := ctx.encoderSettings.TimeFormat
+		switch ctx.encoderSettings.TimeFormat {
+		case "rfc3339":
+			timeFormat = time.RFC3339
+		case "rfc3339_nano":
+			timeFormat = time.RFC3339Nano
+		case "wall":
+			timeFormat = "2006/01/02 15:04:05"
+		case "wall_milli":
+			timeFormat = "2006/01/02 15:04:05.000"
+		case "wall_nano":
+			timeFormat = "2006/01/02 15:04:05.000000000"
+		case "common_log":
+			timeFormat = "02/Jan/2006:15:04:05 -0700"
+		}
+		return func(ts time.Time, encoder zapcore.PrimitiveArrayEncoder) {
+			encoder.AppendString(ts.UTC().Format(timeFormat))
+		}
+	}
+}
