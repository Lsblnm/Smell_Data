+func (m CookieFilter) parseCookiePair(raw string) (string, string) {
+	trimmed := strings.TrimSpace(raw)
+	if trimmed == "" {
+		return "", ""
+	}
+	name, value, found := strings.Cut(trimmed, "=")
+	if !found {
+		return trimmed, ""
+	}
+	return strings.TrimSpace(name), strings.TrimSpace(value)
+}
+
+func (m CookieFilter) sanitizeCookieToken(name string) string {
+	trimmed := strings.TrimSpace(name)
+	if trimmed == "" {
+		return trimmed
+	}
+	buf := make([]rune, 0, len(trimmed))
+	for _, r := range trimmed {
+		if r <= 32 || r >= 127 {
+			continue
+		}
+		switch r {
+		case '(', ')', '<', '>', '@', ',', ';', ':', '\\', '"', '/', '[', ']', '?', '=', '{', '}':
+			continue
+		default:
+			buf = append(buf, r)
+		}
+	}
+	return string(buf)
+}
+
+func (m CookieFilter) cookieValueSafe(value string) string {
+	if value == "" {
+		return value
+	}
+	buf := make([]rune, 0, len(value))
+	for _, r := range value {
+		if r < 0x20 || r == 0x7f || r == ';' {
+			continue
+		}
+		buf = append(buf, r)
+	}
+	return string(buf)
+}
