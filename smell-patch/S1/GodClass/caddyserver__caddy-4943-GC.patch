+func (m CookieFilter) describeIPMasks(ctx cookieFilterContext) string {
+	parts := make([]string, 0, 2)
+	if ctx.ipMasks.v4CIDR > 0 {
+		parts = append(parts, fmt.Sprintf("v4/%d", ctx.ipMasks.v4CIDR))
+	}
+	if ctx.ipMasks.v6CIDR > 0 {
+		parts = append(parts, fmt.Sprintf("v6/%d", ctx.ipMasks.v6CIDR))
+	}
+	if len(parts) == 0 {
+		return "none"
+	}
+	return strings.Join(parts, ",")
+}
