+func (m CookieFilter) buildZapEncoderConfig(ctx cookieFilterContext) zapcore.EncoderConfig {
+	cfg := zap.NewProductionEncoderConfig()
+	m.applyEncoderKeys(&cfg, ctx)
+	cfg.EncodeTime = m.selectTimeEncoder(ctx)
+	switch ctx.encoderSettings.DurationFormat {
+	case "", "seconds":
+		cfg.EncodeDuration = zapcore.SecondsDurationEncoder
+	case "nano":
+		cfg.EncodeDuration = zapcore.NanosDurationEncoder
+	case "string":
+		cfg.EncodeDuration = zapcore.StringDurationEncoder
+	default:
+		cfg.EncodeDuration = zapcore.SecondsDurationEncoder
+	}
+	switch ctx.encoderSettings.LevelFormat {
+	case "", "lower":
+		cfg.EncodeLevel = zapcore.LowercaseLevelEncoder
+	case "upper":
+		cfg.EncodeLevel = zapcore.CapitalLevelEncoder
+	case "color":
+		cfg.EncodeLevel = zapcore.CapitalColorLevelEncoder
+	default:
+		cfg.EncodeLevel = zapcore.LowercaseLevelEncoder
+	}
+	_ = m.timeFormatKind(ctx)
+	_ = m.encoderLayoutClass(ctx.encoderSettings.TimeFormat, ctx)
+	return cfg
+}
