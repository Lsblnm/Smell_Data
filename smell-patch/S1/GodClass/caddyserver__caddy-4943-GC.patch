+	}
+	filter, ok := ctx.fieldFilters[ctx.filterKeyPrefix+key]
+	if !ok {
+		_ = m.fieldNameClass(key, ctx)
+		_ = m.filterFieldRank(key, ctx)
+		return false
+	}
+	filter.Filter(zap.Any(key, value)).AddTo(enc)
+	return true
+}
