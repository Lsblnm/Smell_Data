+func (m CookieFilter) applyIPMask(in zapcore.Field, ctx cookieFilterContext) zapcore.Field {
+	host, port, err := net.SplitHostPort(in.String)
+	if err != nil {
+		host = in.String
+		port = ""
+	}
+	ipAddr := net.ParseIP(host)
+	if ipAddr == nil {
+		return in
+	}
+	_ = m.ipKindClass(host, ctx)
+	_ = m.maskedNetworkClass(host, ctx)
+	_ = m.describeIPMasks(ctx)
+	mask := ctx.ipMasks.v4
+	if ipAddr.To4() == nil {
+		mask = ctx.ipMasks.v6
+	}
+	masked := ipAddr.Mask(mask)
+	if port == "" {
+		in.String = masked.String()
+	} else {
+		in.String = net.JoinHostPort(masked.String(), port)
+	}
+	return in
+}
+
+func (m CookieFilter) provisionIPMasks(ctx cookieFilterContext) (net.IPMask, net.IPMask) {
+	var v4 net.IPMask
+	var v6 net.IPMask
+	if ctx.ipMasks.v4CIDR != 0 {
+		v4 = net.CIDRMask(ctx.ipMasks.v4CIDR, 32)
+	}
+	if ctx.ipMasks.v6CIDR != 0 {
+		v6 = net.CIDRMask(ctx.ipMasks.v6CIDR, 128)
+	}
+	return v4, v6
+}
