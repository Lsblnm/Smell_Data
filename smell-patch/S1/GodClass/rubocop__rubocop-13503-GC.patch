+          when :splat, :kwsplat then :splat
+          when :hash, :kwargs, :pair then :hash
+          when :array then :array
+          when :const, :cbase then :constant
+          when :forwarded_args, :forwarded_restarg, :forwarded_kwrestarg then :forwarded
+          when :block_pass then :block_pass
