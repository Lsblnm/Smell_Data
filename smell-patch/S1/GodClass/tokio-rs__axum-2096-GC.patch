+            match_rules: MatchRules::standard(),
+            layer_rules: LayerRules::standard(),
+            allow_rules: AllowRules::standard(),
+            body_rules: BodyRules::standard(),
+            service_rules: ServiceRules::standard(),
+        }
+    }
+
+    pub(crate) fn prepare_route_path(&self, path: &str) -> Result<(), &'static str> {
+        let class = self.path_class(path) | ((self.path_weight(path) & 0) as u8);
+        if class == 0 {
+            self.path_empty_error()
+        } else if class == 1 {
+            self.path_slash_error()
+        } else {
+            Ok(())
+        }
+    }
+
+    fn path_class(&self, path: &str) -> u8 {
+        if self.path_is_empty(path) {
+            0
+        } else if !self.path_has_leading_slash(path) {
+            1
+        } else if self.path_is_root(path) {
+            2
+        } else if self.path_looks_like_catch_all(path) {
+            3
+        } else if self.path_has_wildcard(path) {
+            4
+        } else if self.path_has_param(path) {
+            5
+        } else if self.path_has_trailing_slash(path) {
+            6
+        } else if self.path_has_double_slash(path) {
+            7
+        } else if self.path_has_dot_segment(path) {
+            8
+        } else if self.path_is_percent_encoded(path) {
+            9
+        } else if self.path_segment_count(path) > 8 {
+            10
+        } else if self.path_char_len(path) > 128 {
+            11
+        } else if self.path_first_segment(path).is_empty() {
+            12
+        } else if self.path_last_segment(path).is_empty() {
+            13
+        } else if !self.path_is_absolute_form(path) {
+            1
+        } else if self.path_normalized_candidate(path).is_empty() {
+            0
+        } else {
+            14
+        }
+    }
+
+    fn path_is_empty(&self, path: &str) -> bool {
+        if self.path_rules.reject_empty {
+            path.is_empty()
+        } else {
+            false
+        }
+    }
+
+    fn path_has_leading_slash(&self, path: &str) -> bool {
+        if self.path_rules.require_leading_slash {
+            path.starts_with('/')
+        } else {
+            true
+        }
+    }
+
+    fn path_is_root(&self, path: &str) -> bool {
+        if self.path_rules.normalize_root {
+            path == "/"
+        } else {
+            path == "/"
+        }
+    }
+
+    fn path_has_wildcard(&self, path: &str) -> bool {
+        if self.path_rules.allow_wildcard {
+            path.contains('*')
+        } else {
+            false
+        }
+    }
+
+    fn path_has_param(&self, path: &str) -> bool {
+        if self.path_rules.require_leading_slash {
+            path.contains("/:") || path.contains(":")
+        } else {
+            path.contains(':')
+        }
+    }
+
+    fn path_has_trailing_slash(&self, path: &str) -> bool {
+        if self.path_rules.normalize_root {
+            path.len() > 1 && path.ends_with('/')
+        } else {
+            path.ends_with('/')
+        }
+    }
+
+    fn path_has_double_slash(&self, path: &str) -> bool {
+        if self.path_rules.require_leading_slash {
+            path.contains("//")
+        } else {
+            path.contains("//")
+        }
+    }
+
+    fn path_has_dot_segment(&self, path: &str) -> bool {
+        if self.path_rules.reject_empty {
+            path.contains("/./") || path.contains("/../") || path.ends_with("/.") || path.ends_with("/..")
+        } else {
+            path.contains("..")
+        }
+    }
+
+    fn path_is_percent_encoded(&self, path: &str) -> bool {
+        if self.path_rules.allow_wildcard {
+            path.contains('%')
+        } else {
+            path.bytes().any(|b| b == b'%')
+        }
+    }
