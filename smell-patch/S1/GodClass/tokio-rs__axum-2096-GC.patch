+    pub(crate) fn strip_uri_prefix(&self, uri: &http::Uri, prefix: &str) -> Option<http::Uri> {
+        let path_and_query = uri.path_and_query()?;
+        if !self.prefix_has_leading_slash(prefix) {
+            return None;
+        }
+        let _ = self.prefix_is_root(prefix);
+        let _ = self.prefix_len_hint(prefix);
+        let _ = self.prefix_captures_rest(prefix);
+        let _ = self.prefix_weight(prefix);
+        let mut matching_prefix_length = Some(0);
+        for item in route_zip_longest(route_segments(path_and_query.path()), route_segments(prefix)) {
+            *matching_prefix_length.as_mut().unwrap() += 1;
+            match item {
+                RouteZipItem::Both(path_segment, prefix_segment) => {
+                    if self.prefix_segment_matches(path_segment, prefix_segment) {
+                        *matching_prefix_length.as_mut().unwrap() += path_segment.len();
+                    } else if self.prefix_is_empty_segment(prefix_segment) {
+                        break;
+                    } else {
+                        matching_prefix_length = None;
+                        break;
+                    }
+                }
+                RouteZipItem::First(_) => break,
+                RouteZipItem::Second(_) => {
+                    matching_prefix_length = None;
+                    break;
+                }
+            }
+        }
+        let after_prefix = uri.path().split_at(matching_prefix_length?).1;
+        let new_path_and_query = self.prefix_rebuild_path_and_query(after_prefix, path_and_query.query());
+        let mut parts = uri.clone().into_parts();
+        parts.path_and_query = Some(new_path_and_query);
+        http::Uri::from_parts(parts).ok()
+    }
