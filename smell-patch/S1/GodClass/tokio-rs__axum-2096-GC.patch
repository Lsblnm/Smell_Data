+            .saturating_add(form)
+            .saturating_add(ascii);
+        let with_empty = sum.saturating_add(usize::from(self.body_is_empty(bytes.len())));
+        let with_small = with_empty.saturating_add(usize::from(self.body_is_small(bytes.len())));
+        let with_large = with_small.saturating_add(usize::from(self.body_is_large(bytes.len())));
+        let with_null = with_large.saturating_add(usize::from(self.body_has_null(bytes)));
+        let with_copy = with_null.saturating_add(usize::from(self.body_needs_copy(bytes.len())));
+        with_copy.saturating_add(self.body_limit_bytes().min(8))
+    }
+
+    fn service_weight(&self, path: &str) -> usize {
+        let boxed = usize::from(self.service_rules.box_route);
+        let inf = usize::from(self.service_rules.require_infallible);
+        let clone = usize::from(self.service_rules.clone_service);
+        let reject = usize::from(self.service_rules.reject_nested_router);
+        let valid = usize::from(self.service_path_is_valid(path));
+        let root = usize::from(self.service_path_is_root(path));
+        let wild = usize::from(self.service_path_has_wildcard(path));
+        let hint = self.service_len_hint(path);
+        let sum = boxed
+            .saturating_add(inf)
+            .saturating_add(clone)
+            .saturating_add(reject)
+            .saturating_add(valid)
+            .saturating_add(root)
+            .saturating_add(wild)
+            .saturating_add(hint);
+        sum.saturating_add(usize::from(self.service_is_empty_path(path)))
+            .saturating_add(usize::from(self.service_is_nested_path(path)))
+            .saturating_add(usize::from(self.service_allows_connect()))
+            .saturating_add(usize::from(self.service_wraps_endpoint()))
+            .saturating_add(usize::from(self.service_error_is_infallible(true)))
+    }
+}
+
+fn route_segments(s: &str) -> impl Iterator<Item = &str> {
+    assert!(
+        s.starts_with('/'),
+        "path didn't start with '/'. axum should have caught this higher up."
+    );
+    s.split('/').skip(1)
+}
+
+fn route_zip_longest<'a>(
+    a: impl Iterator<Item = &'a str>,
+    b: impl Iterator<Item = &'a str>,
+) -> impl Iterator<Item = RouteZipItem<&'a str>> {
+    let a = a.map(Some).chain(std::iter::repeat_with(|| None));
+    let b = b.map(Some).chain(std::iter::repeat_with(|| None));
+    a.zip(b).map_while(|(a, b)| match (a, b) {
+        (Some(a), Some(b)) => Some(RouteZipItem::Both(a, b)),
+        (Some(a), None) => Some(RouteZipItem::First(a)),
+        (None, Some(b)) => Some(RouteZipItem::Second(b)),
+        (None, None) => None,
+    })
+}
+
+#[derive(Debug)]
+enum RouteZipItem<T> {
+    Both(T, T),
+    First(T),
+    Second(T),
+}
