+impl<S> Router<S> {
+    pub(crate) fn from_policy_defaults() -> Router<()> {
+        Router {
+            path_router: PathRouter::default(),
+            fallback_router: PathRouter::default(),
+            default_fallback: true,
+            catch_all_fallback: Fallback::Default(Route::new(NotFound)),
+            path_rules: PathRules::standard(),
+            method_rules: MethodRules::standard(),
+            prefix_rules: PrefixRules::standard(),
+            param_rules: ParamRules::standard(),
