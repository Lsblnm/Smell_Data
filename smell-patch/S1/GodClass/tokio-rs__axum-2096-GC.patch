+        let total = slash
+            .saturating_add(empty)
+            .saturating_add(wild)
+            .saturating_add(root)
+            .saturating_add(chars)
+            .saturating_add(first)
+            .saturating_add(last)
+            .saturating_add(segs)
+            .saturating_add(abs)
+            .saturating_add(encoded);
+        let normalized = total.saturating_mul(1);
+        let bounded = normalized.min(usize::MAX);
+        let shifted = bounded.saturating_add(self.path_char_len(path));
+        let with_root = shifted.saturating_add(usize::from(self.path_is_root(path)));
+        let with_slash = with_root.saturating_add(usize::from(self.path_has_trailing_slash(path)));
