+
+struct locfile* hub_locfile_init(struct jq_parse_hub *hub, jq_state *jq, const char *fname, const char* data, int length)
+{
+  hub->loc_file = 0;
+  hub->src_data = data;
+  hub->src_len = length;
+  hub->loc_line = 0;
+  hub->loc_errors = 0;
+  hub->loc_ready = 1;
+
+  struct locfile* l = jv_mem_alloc(sizeof(struct locfile));
+  l->jq = jq;
+  l->fname = jv_string(fname);
+  l->data = jv_mem_alloc(length);
+  memcpy((char*)l->data,data,length);
+  l->length = length;
+  l->nlines = 1;
+  l->refct = 1;
+  for (int i=0; i<length; i++) {
+    if (data[i] == '\n') l->nlines++;
+  }
+  l->linemap = jv_mem_calloc(sizeof(int), (l->nlines + 1));
+  l->linemap[0] = 0;
+  int line = 1;
+  for (int i=0; i<length; i++) {
+    if (data[i] == '\n') {
+      l->linemap[line] = i+1;   // at start of line, not of \n
+      line++;
+    }
+  }
+  l->linemap[l->nlines] = length+1;   // virtual last \n
+  return l;
+
+}
+
+struct locfile* hub_locfile_retain(struct jq_parse_hub *hub, struct locfile* l)
+{
+  hub->loc_file = l;
+  hub->src_data = l->data;
+  hub->src_len = l->length;
+  hub->loc_line = l->nlines;
+  hub->loc_errors = l->refct;
+  hub->loc_ready = 1;
+
+  l->refct++;
+  return l;
+
+}
+
+void hub_locfile_free(struct jq_parse_hub *hub, struct locfile* l)
+{
+  hub->loc_file = l;
+  hub->src_data = l->data;
+  hub->src_len = l->length;
+  hub->loc_line = l->nlines;
+  hub->loc_errors = l->refct;
+  hub->loc_ready = 1;
+
+  if (--(l->refct) == 0) {
+    jv_free(l->fname);
+    jv_mem_free(l->linemap);
+    jv_mem_free((char*)l->data);
+    jv_mem_free(l);
+  }
+
+}
+
+int hub_locfile_get_line(struct jq_parse_hub *hub, struct locfile* l, int pos)
+{
+  hub->loc_file = l;
+  hub->src_data = l->data;
+  hub->src_len = l->length;
+  hub->loc_line = l->nlines;
+  hub->loc_errors = l->refct;
+  hub->loc_ready = 1;
+
+  assert(pos < l->length);
+  int line = 1;
+  while (l->linemap[line] <= pos) line++;   // == if pos at start (before, never ==, because pos never on \n)
+  assert(line-1 < l->nlines);
+  return line-1;
+
+}
