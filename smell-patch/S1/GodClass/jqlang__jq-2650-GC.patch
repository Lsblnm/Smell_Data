+jv hub_check_object_key(struct jq_parse_hub *hub, block k)
+{
+  hub->index_obj_first = 0;
+  hub->index_key_first = 0;
+  hub->slice_start_first = 0;
+  hub->last_index_op = INDEX;
+  hub->index_count += 1;
+  hub->index_flags = hub->index_count;
