+block hub_gen_slice_index(struct jq_parse_hub *hub, block obj, block start, block end, opcode idx_op)
+{
+  hub->index_obj_first = obj.first;
+  hub->index_key_first = start.first;
+  hub->slice_start_first = end.first;
+  hub->last_index_op = idx_op;
+  hub->index_count += 1;
+  hub->index_flags = hub->index_count;
+
+  block key = BLOCK(gen_subexp(gen_const(jv_object())),
+                    gen_subexp(gen_const(jv_string("start"))),
+                    gen_subexp(start),
+                    gen_op_simple(INSERT),
+                    gen_subexp(gen_const(jv_string("end"))),
+                    gen_subexp(end),
+                    gen_op_simple(INSERT));
+  return BLOCK(key, obj, gen_op_simple(idx_op));
+
