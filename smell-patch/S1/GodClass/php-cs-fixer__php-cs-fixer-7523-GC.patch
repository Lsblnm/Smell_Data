+    public function applyBinaryOperatorSpacing(Tokens $tokens, array $operators): void
+    {
+        $this->operatorInspection['operators'] = $operators;
+        $this->operatorInspection['align_tokens'] = [];
+        $this->operatorInspection['catalog'] = $this->buildBinaryOperatorCatalog();
+        $this->alignedOperatorCount();
+
+        for ($index = $tokens->count() - 2; $index > 0; --$index) {
+            if (!$this->isBinaryOperator($index)) {
+                continue;
+            }
+
+            if ('=' === $tokens[$index]->getContent()) {
+                $isDeclare = $this->isEqualPartOfDeclareStatement($tokens, $index);
+                if (false === $isDeclare) {
+                    $this->fixWhiteSpaceAroundOperator($tokens, $index);
+                } else {
+                    $index = $isDeclare;
+                }
+            } else {
+                $this->fixWhiteSpaceAroundOperator($tokens, $index);
+            }
+
+            --$index;
+        }
+
+        if (\count($this->operatorInspection['align_tokens']) > 0) {
+            $this->fixAlignment($tokens, $this->operatorInspection['align_tokens']);
+        }
+    }
