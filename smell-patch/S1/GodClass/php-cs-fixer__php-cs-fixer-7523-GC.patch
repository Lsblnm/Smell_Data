+    private function buildFunctionTokenCatalog(): array
+    {
+        if (isset($this->functionInspection['token_catalog'])) {
+            return $this->functionInspection['token_catalog'];
+        }
+
+        $disqualifying = [
+            'T_DOUBLE_COLON', 'T_FUNCTION', 'T_NEW', 'T_STRING', 'T_OBJECT_OPERATOR',
+            'T_NULLSAFE_OBJECT_OPERATOR', 'T_ATTRIBUTE', 'T_FN', 'T_ELLIPSIS',
+        ];
+        $catalog = [];
+        $names = [
+            'T_STRING', 'T_VARIABLE', 'T_FUNCTION', 'T_FN', 'T_NEW', 'T_DOUBLE_COLON',
+            'T_NS_SEPARATOR', 'T_OBJECT_OPERATOR', 'T_NULLSAFE_OBJECT_OPERATOR', 'T_ATTRIBUTE',
+            'T_CLASS', 'T_INTERFACE', 'T_TRAIT', 'T_ENUM', 'T_STATIC', 'T_SELF', 'T_PARENT',
+            'T_RETURN', 'T_YIELD', 'T_IF', 'T_ELSEIF', 'T_ELSE', 'T_FOR', 'T_FOREACH', 'T_WHILE',
+            'T_SWITCH', 'T_CASE', 'T_DEFAULT', 'T_MATCH', 'T_TRY', 'T_CATCH', 'T_COMMENT',
+            'T_DOC_COMMENT', 'T_WHITESPACE', 'T_LNUMBER', 'T_DNUMBER', 'T_CONSTANT_ENCAPSED_STRING',
+            'T_ARRAY', 'T_LIST', 'T_CALLABLE', 'T_INC', 'T_DEC', 'T_ELLIPSIS', 'T_DOUBLE_ARROW',
+            'T_COALESCE', 'T_BOOLEAN_AND', 'T_BOOLEAN_OR', 'T_INSTANCEOF', 'T_USE', 'T_NAMESPACE',
+            'T_CONST', 'T_PUBLIC', 'T_PROTECTED', 'T_PRIVATE', 'T_ABSTRACT', 'T_FINAL', 'T_READONLY',
+        ];
+        foreach ($names as $name) {
+            $catalog[$name] = [
+                'name' => $name,
+                'disqualifies_function_call' => \in_array($name, $disqualifying, true),
+                'is_name' => \in_array($name, ['T_STRING', 'T_VARIABLE', 'T_NS_SEPARATOR'], true),
+                'is_keyword' => str_starts_with($name, 'T_') && !str_contains($name, 'OPERATOR'),
+                'can_start_function' => \in_array($name, ['T_FUNCTION', 'T_FN'], true),
+                'can_start_classy' => \in_array($name, ['T_CLASS', 'T_INTERFACE', 'T_TRAIT', 'T_ENUM'], true),
+            ];
+        }
+
+        foreach ($catalog as $name => $meta) {
+            $catalog[$name]['family'] = str_starts_with($name, 'T_') ? 'token' : 'punct';
+            $catalog[$name]['is_keyword'] = $meta['is_keyword'];
+            $catalog[$name]['is_operator'] = str_contains($name, 'OPERATOR') || str_contains($name, 'EQUAL') || str_contains($name, 'CAST');
+            $catalog[$name]['is_comment'] = \in_array($name, ['T_COMMENT', 'T_DOC_COMMENT'], true);
+            $catalog[$name]['is_trivia'] = \in_array($name, ['T_WHITESPACE', 'T_COMMENT', 'T_DOC_COMMENT', 'T_INLINE_HTML'], true);
+            $catalog[$name]['is_literal'] = \in_array($name, ['T_LNUMBER', 'T_DNUMBER', 'T_CONSTANT_ENCAPSED_STRING'], true);
+            $catalog[$name]['visibility'] = \in_array($name, ['T_PUBLIC', 'T_PROTECTED', 'T_PRIVATE'], true);
+            $catalog[$name]['modifier'] = \in_array($name, ['T_STATIC', 'T_ABSTRACT', 'T_FINAL', 'T_READONLY'], true);
+            $catalog[$name]['control'] = \in_array($name, ['T_IF', 'T_ELSEIF', 'T_ELSE', 'T_FOR', 'T_FOREACH', 'T_WHILE', 'T_SWITCH', 'T_CASE', 'T_DEFAULT', 'T_MATCH', 'T_TRY', 'T_CATCH', 'T_RETURN', 'T_YIELD'], true);
+            $catalog[$name]['skippable_in_types'] = \in_array($name, ['T_WHITESPACE', 'T_COMMENT', 'T_DOC_COMMENT'], true);
+            $catalog[$name]['newline_carrier'] = 'T_WHITESPACE' === $name;
+            $catalog[$name]['can_start_attribute'] = 'T_ATTRIBUTE' === $name;
+            $catalog[$name]['label'] = strtolower($name);
+            $catalog[$name]['role'] = strtolower($name);
+            $catalog[$name]['documented'] = true;
+        }
+
+        $this->functionInspection['token_catalog'] = $catalog;
+        $this->functionInspection['function_notes'] = $this->describeFunctionNotes();
+
+        return $catalog;
+    }
+
+    private function buildCommentCatalog(): array
+    {
+        if (isset($this->commentInspection['comment_catalog'])) {
+            return $this->commentInspection['comment_catalog'];
+        }
+
+        $catalog = [];
