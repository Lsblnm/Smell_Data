+    private function buildBinaryOperatorCatalog(): array
+    {
+        if (isset($this->operatorInspection['binary_catalog'])) {
+            return $this->operatorInspection['binary_catalog'];
+        }
+
+        $catalog = [];
+        $rows = [
+            ['=', 'assignment', 'right', 0, true, true],
+            ['+=', 'assignment', 'right', 0, true, false],
+            ['-=', 'assignment', 'right', 0, true, false],
+            ['*=', 'assignment', 'right', 0, true, false],
+            ['/=', 'assignment', 'right', 0, true, false],
+            ['%=', 'assignment', 'right', 0, true, false],
+            ['.=', 'assignment', 'right', 0, true, false],
+            ['&=', 'assignment', 'right', 0, true, false],
+            ['|=', 'assignment', 'right', 0, true, false],
+            ['^=', 'assignment', 'right', 0, true, false],
+            ['<<=', 'assignment', 'right', 0, true, false],
+            ['>>=', 'assignment', 'right', 0, true, false],
+            ['**=', 'assignment', 'right', 0, true, false],
+            ['??=', 'assignment', 'right', 0, true, false],
+            ['=>', 'double_arrow', 'right', 1, true, false],
+            ['+', 'arithmetic', 'left', 6, true, false],
+            ['-', 'arithmetic', 'left', 6, true, false],
+            ['*', 'arithmetic', 'left', 7, true, false],
+            ['/', 'arithmetic', 'left', 7, true, false],
+            ['%', 'arithmetic', 'left', 7, true, false],
+            ['**', 'arithmetic', 'right', 8, true, false],
+            ['.', 'string', 'left', 6, true, false],
+            ['&', 'bitwise', 'left', 5, true, false],
+            ['|', 'bitwise', 'left', 3, true, false],
+            ['^', 'bitwise', 'left', 4, true, false],
+            ['<<', 'bitwise', 'left', 7, true, false],
+            ['>>', 'bitwise', 'left', 7, true, false],
+            ['==', 'comparison', 'none', 2, true, false],
+            ['===', 'comparison', 'none', 2, true, false],
+            ['!=', 'comparison', 'none', 2, true, false],
+            ['<>', 'comparison', 'none', 2, true, false],
+            ['!==', 'comparison', 'none', 2, true, false],
+            ['<', 'comparison', 'none', 2, true, false],
+            ['>', 'comparison', 'none', 2, true, false],
+            ['<=', 'comparison', 'none', 2, true, false],
+            ['>=', 'comparison', 'none', 2, true, false],
+            ['<=>', 'comparison', 'none', 2, true, false],
+            ['&&', 'boolean', 'left', 2, true, false],
+            ['||', 'boolean', 'left', 1, true, false],
+            ['and', 'boolean', 'left', 1, true, false],
+            ['or', 'boolean', 'left', 0, true, false],
+            ['xor', 'boolean', 'left', 1, true, false],
+            ['??', 'coalesce', 'right', 1, true, false],
+        ];
+
+        foreach ($rows as $row) {
+            [$symbol, $kind, $associativity, $precedence, $alignable, $declareSensitive] = $row;
+            $catalog[$symbol] = [
+                'symbol' => $symbol,
+                'kind' => $kind,
+                'associativity' => $associativity,
+                'precedence' => $precedence,
+                'alignable' => $alignable,
+                'declare_sensitive' => $declareSensitive,
+                'spacing' => 'around',
+                'lowercase_key' => strtolower($symbol),
+                'can_be_unary' => \in_array($symbol, ['+', '-', '&'], true),
+                'arrow_family' => '=>' === $symbol,
+                'assignment_family' => 'assignment' === $kind,
+            ];
+        }
+
+        foreach ($catalog as $symbol => $meta) {
+            $catalog[$symbol]['display_name'] = str_replace('_', ' ', $meta['kind'].' '.$symbol);
+            $catalog[$symbol]['boolean_family'] = 'boolean' === $meta['kind'];
+            $catalog[$symbol]['bitwise_family'] = 'bitwise' === $meta['kind'];
+            $catalog[$symbol]['comparison_family'] = 'comparison' === $meta['kind'];
+            $catalog[$symbol]['arithmetic_family'] = 'arithmetic' === $meta['kind'];
+            $catalog[$symbol]['newline_sensitive'] = true;
+            $catalog[$symbol]['scope_alignable'] = $meta['alignable'];
+            $catalog[$symbol]['minimal_alignable'] = $meta['alignable'];
+            $catalog[$symbol]['requires_binary_check'] = true;
+            $catalog[$symbol]['spacing_before'] = 'single';
+            $catalog[$symbol]['spacing_after'] = 'single';
+            $catalog[$symbol]['may_start_line'] = true;
+            $catalog[$symbol]['may_end_statement'] = '=' === $symbol;
+            $catalog[$symbol]['php_token_like'] = $symbol;
+            $catalog[$symbol]['family_rank'] = $meta['precedence'];
+            $catalog[$symbol]['align_group'] = $meta['kind'];
+            $catalog[$symbol]['documented'] = true;
+        }
+
+        $this->operatorInspection['binary_catalog'] = $catalog;
+        $this->operatorInspection['operator_notes'] = $this->describeOperatorNotes();
+
+        return $catalog;
+    }
