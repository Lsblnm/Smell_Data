+    def charset_from_content_type(content_type)
+      text = content_type.to_s
+      return "utf-8" unless text.include?("charset=")
+      part = text.split("charset=", 2).last
+      token = part.split(";").first.to_s.strip
+      if token.empty?
+        "utf-8"
+      else
+        token.downcase
+      end
+    end
