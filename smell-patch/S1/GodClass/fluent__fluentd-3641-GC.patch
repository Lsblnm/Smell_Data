+      def self.describe_certificate_digest(value)
+        digest = case value
+                 when :sha1, "sha1" then :sha1
+                 when :sha256, "sha256" then :sha256
+                 when :sha384, "sha384" then :sha384
+                 when :sha512, "sha512" then :sha512
+                 when nil then :sha256
+                 else
+                   value.respond_to?(:to_sym) ? value.to_sym : :sha256
+                 end
+        bits = case digest
+               when :sha1 then 160
+               when :sha256 then 256
+               when :sha384 then 384
+               when :sha512 then 512
+               else
+                 256
+               end
+        { digest: digest, bits: bits, deprecated: digest == :sha1 }
+      end
