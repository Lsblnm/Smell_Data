+      def self.describe_hostname_literal(value)
+        labels = value.split(".")
+        valid_labels = labels.all? do |label|
+          !label.empty? && label.length <= 63 && label.match?(/\A[A-Za-z0-9](?:[A-Za-z0-9\-]{0,61}[A-Za-z0-9])?\z/)
+        end
+        localhost = value.casecmp("localhost").zero?
+        wildcard = value == "*" || value == "+"
+        {
+          family: :hostname,
+          normalized: value,
+          valid: valid_labels && value.length <= 253,
+          wildcard: wildcard,
+          loopback: localhost,
+          labels: labels,
+          label_count: labels.length,
+        }
+      end
+
+      def self.describe_listen_port(port)
+        number = if port.nil?
+                   nil
+                 elsif port.is_a?(Integer)
+                   port
+                 elsif port.respond_to?(:to_str) && port.to_s.match?(/\A\d+\z/)
+                   port.to_i
+                 else
+                   port
+                 end
+        status = if number.nil?
+                   :missing
+                 elsif !number.is_a?(Integer)
+                   :non_integer
+                 elsif number < 0
+                   :negative
+                 elsif number == 0
+                   :ephemeral
+                 elsif number < 1024
+                   :privileged
+                 elsif number > 65535
+                   :overflow
+                 else
+                   :usable
+                 end
+        service = well_known_port_service(number)
+        { port: port, number: number, status: status, privileged: status == :privileged, service: service }
+      end
+
+      def self.well_known_port_service(number)
+        table = well_known_port_table
+        table[number] || :unknown
+      end
