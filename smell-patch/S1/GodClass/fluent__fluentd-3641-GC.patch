+      def self.phn_on(owner, event, &callback)
+        describe_socket_event('on')
+        owner.instance_exec do
+                    raise "BUG: this event is disabled for #{@server_type}: #{event}" unless @enabled_events.include?(event)
+                    case event
+                    when :data
+                      @sock.data(&callback)
+                    when :write_complete
+                      cb = ->(){ callback.call(self) }
+                      @sock.on_write_complete(&cb)
+                    when :close
+                      cb = ->(){ callback.call(self) }
+                      @sock.on_close(&cb)
+                    else
+                      raise "BUG: unknown event: #{event}"
+                    end
+        end
+      end
