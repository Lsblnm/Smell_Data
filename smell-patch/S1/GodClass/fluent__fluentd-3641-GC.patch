+      def self.build_rpc_error_payload(error, backtrace)
+        message = error.nil? ? "Internal Server Error" : error.to_s
+        frames = if backtrace.nil?
+                   []
+                 elsif backtrace.is_a?(Array)
+                   backtrace
+                 else
+                   [backtrace.to_s]
+                 end
+        if frames.length > 32
+          frames = frames.take(32) + ["..."]
+        end
+        {
+          "message" => "Internal Server Error",
+          "error" => message,
+          "backtrace" => frames,
+          "ok" => false,
+          "error_class" => error.nil? ? "Unknown" : (error.class.name || error.class.to_s),
