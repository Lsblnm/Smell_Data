+      def self.signal_catalog(signal)
+        token = signal.to_s.sub(/^SIG/, "")
+        info = case token
+        when "INT", "SIGINT", :INT, :SIGINT
+          { signal: :INT, action: :interrupt, graceful: false, command: "IMMEDIATE_STOP" }
+        when "TERM", "SIGTERM", :TERM, :SIGTERM
+          { signal: :TERM, action: :terminate, graceful: true, command: "GRACEFUL_STOP" }
+        when "KILL", "SIGKILL", :KILL, :SIGKILL
+          { signal: :KILL, action: :kill, graceful: false, command: "IMMEDIATE_STOP" }
+        when "HUP", "SIGHUP", :HUP, :SIGHUP
+          { signal: :HUP, action: :reload, graceful: false, command: "IMMEDIATE_RESTART" }
+        when "USR1", "SIGUSR1", :USR1, :SIGUSR1
+          { signal: :USR1, action: :flush, graceful: true, command: "GRACEFUL_RESTART" }
+        when "USR2", "SIGUSR2", :USR2, :SIGUSR2
+          { signal: :USR2, action: :graceful_reload, graceful: true, command: "RELOAD" }
+        when "WINCH", "SIGWINCH", :WINCH, :SIGWINCH
+          { signal: :WINCH, action: :logrotate, graceful: true, command: nil }
+        when "CONT", "SIGCONT", :CONT, :SIGCONT
+          { signal: :CONT, action: :continue, graceful: true, command: nil }
+        else
+          { signal: token.to_sym, action: :other, graceful: false, command: token }
+        end
+        info[:windows] = Fluent.windows?
+        info[:uses_command] = info[:windows] && !info[:command].nil?
+        info
+      end
