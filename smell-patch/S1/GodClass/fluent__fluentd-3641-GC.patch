+      def self.sv_send_signal_to_workers(owner, signal)
+        describe_process_action('send_signal_to_workers')
+        owner.instance_exec do
+                return unless config[:worker_pid]
+
+                if Fluent.windows?
+                  Fluent::RPC::Server.sv_send_command_to_workers(self, signal)
+                else
