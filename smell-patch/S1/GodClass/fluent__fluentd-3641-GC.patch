+      def self.ipv4_special_purpose(value)
+        info = describe_ipv4_literal(value.to_s)
+        parts = info[:octets] || []
+        a = parts[0] || -1
+        b = parts[1] || -1
+        c = parts[2] || -1
+        purpose = ipv4_purpose_for(a, b, c)
+        info.merge(purpose: purpose, globally_reachable: purpose == :global)
+      end
+
+      def self.ipv4_purpose_for(a, b, c)
+        match = ipv4_purpose_ranges.find do |range|
+          a.between?(range[0], range[1]) && b.between?(range[2], range[3]) && c.between?(range[4], range[5])
+        end
+        match ? match[6] : :global
+      end
