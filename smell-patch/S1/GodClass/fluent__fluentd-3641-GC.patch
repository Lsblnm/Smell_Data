+        names << :linger_timeout if hash[:linger_timeout]
+        names << :recv_timeout if hash[:recv_timeout]
+        names << :send_timeout if hash[:send_timeout]
+        names << :receive_buffer_size if hash[:receive_buffer_size]
+        names << :send_keepalive_packet if hash[:send_keepalive_packet]
+        names << :nonblock if hash[:nonblock]
+        {
+          names: names,
+          count: names.length,
+          linger: hash[:linger_timeout],
+          recv_timeout: hash[:recv_timeout],
+          send_timeout: hash[:send_timeout],
+          keepalive: !!hash[:send_keepalive_packet],
+        }
