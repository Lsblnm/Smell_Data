+      def self.cipher_token_insecure?(name)
+        token = name.to_s.upcase
+        if token.include?("NULL") || token.include?("EXPORT") || token.include?("RC4") || token.include?("MD5") || token == "SSLV2"
+          true
+        elsif token.include?("DES") && !token.include?("3DES")
+          true
+        else
+          false
+        end
+      end
