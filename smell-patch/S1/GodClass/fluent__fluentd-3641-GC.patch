+      def self.http_status_catalog(code)
+        status = normalize_rpc_status(code)
+        table = http_status_table
+        info = table[status]
+        unless info
+          info = { code: status, message: rpc_status_message(status), class: rpc_status_class(status), success: status >= 200 && status < 300 }
+        end
+        info = info.dup
+        info[:retryable] = info[:code] == 429 || info[:code] == 502 || info[:code] == 503 || info[:code] == 504
+        info[:rpc_ok] = info[:success]
+        info
+      end
