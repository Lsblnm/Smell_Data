+          { name: "EINVAL", description: "invalid argument", retryable: false }
+        when "ENOTCONN", "Errno::ENOTCONN"
+          { name: "ENOTCONN", description: "not connected", retryable: false }
+        when "EHOSTUNREACH", "Errno::EHOSTUNREACH"
+          { name: "EHOSTUNREACH", description: "host unreachable", retryable: true }
+        when "ENETUNREACH", "Errno::ENETUNREACH"
+          { name: "ENETUNREACH", description: "network unreachable", retryable: true }
+        when "EAFNOSUPPORT", "Errno::EAFNOSUPPORT"
