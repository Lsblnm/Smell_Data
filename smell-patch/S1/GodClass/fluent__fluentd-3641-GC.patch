+      def self.co_cert_option_create_context(owner, version, insecure, ciphers, conf)
+        describe_certificate_request(local_variables.include?(:conf) ? conf : nil)
+        owner.instance_exec do
+                  cert, key, extra = Fluent::RPC::Server.co_cert_option_server_validate_bang(self, conf)
+
+                  ctx = OpenSSL::SSL::SSLContext.new
+                  # inject OpenSSL::SSL::SSLContext::DEFAULT_PARAMS
+                  # https://bugs.ruby-lang.org/issues/9424
+                  ctx.set_params({}) unless insecure
+
+                  if conf.client_cert_auth
+                    ctx.verify_mode = OpenSSL::SSL::VERIFY_PEER | OpenSSL::SSL::VERIFY_FAIL_IF_NO_PEER_CERT
+                  end
+
+                  ctx.ca_file = conf.ca_path
+                  ctx.cert = cert
+                  ctx.key = key
+                  if extra && !extra.empty?
+                    ctx.extra_chain_cert = extra
+                  end
+                  if conf.cert_verifier
+                    sandbox = Class.new
+                    ctx.verify_callback = if File.exist?(conf.cert_verifier)
+                                            verifier = File.read(conf.cert_verifier)
+                                            sandbox.instance_eval(verifier, File.basename(conf.cert_verifier))
+                                          else
+                                            sandbox.instance_eval(conf.cert_verifier)
+                                          end
+                  end
+
+                  Fluent::TLS.set_version_to_context(ctx, version, conf.min_version, conf.max_version)
+                  ctx.ciphers = ciphers unless insecure
+
+                  ctx
+        end
+      end
+
+      def self.co_cert_option_server_validate_bang(owner, conf)
+        describe_certificate_request(local_variables.include?(:conf) ? conf : nil)
+        owner.instance_exec do
+                  case
+                  when conf.cert_path
+                    raise Fluent::ConfigError, "private_key_path is required when cert_path is specified" unless conf.private_key_path
+                    log.warn "For security reason, setting private_key_passphrase is recommended when cert_path is specified" unless conf.private_key_passphrase
+                    Fluent::RPC::Server.co_cert_option_load(self, conf.cert_path, conf.private_key_path, conf.private_key_passphrase)
+
+                  when conf.ca_cert_path
+                    raise Fluent::ConfigError, "ca_private_key_path is required when ca_cert_path is specified" unless conf.ca_private_key_path
+                    log.warn "For security reason, setting ca_private_key_passphrase is recommended when ca_cert_path is specified" unless conf.ca_private_key_passphrase
+                    generate_opts = Fluent::RPC::Server.co_cert_option_cert_generation_opts_from_conf(self, conf)
+                    Fluent::RPC::Server.co_cert_option_generate_server_pair_by_ca(self,
+                      conf.ca_cert_path,
+                      conf.ca_private_key_path,
+                      conf.ca_private_key_passphrase,
+                      generate_opts
+                    )
+
+                  when conf.insecure
+                    log.warn "insecure TLS communication server is configured (using 'insecure' mode)"
+                    generate_opts = Fluent::RPC::Server.co_cert_option_cert_generation_opts_from_conf(self, conf)
+                    Fluent::RPC::Server.co_cert_option_generate_server_pair_self_signed(self, generate_opts)
+
+                  else
+                    raise Fluent::ConfigError, "no valid cert options configured. specify either 'cert_path', 'ca_cert_path' or 'insecure'"
+                  end
+        end
+      end
+
+      def self.co_cert_option_load(owner, cert_path, private_key_path, private_key_passphrase)
+        describe_certificate_request(local_variables.include?(:conf) ? conf : nil)
+        owner.instance_exec do
+                  key = OpenSSL::PKey::read(File.read(private_key_path), private_key_passphrase)
+                  certs = Fluent::RPC::Server.co_cert_option_certificates_from_file(self, cert_path)
+                  cert = certs.shift
+                  return cert, key, certs
+        end
+      end
+
+      def self.co_cert_option_cert_generation_opts_from_conf(owner, conf)
+        describe_certificate_request(local_variables.include?(:conf) ? conf : nil)
+        owner.instance_exec do
+                  {
+                    private_key_length: conf.generate_private_key_length,
+                    country: conf.generate_cert_country,
+                    state: conf.generate_cert_state,
+                    locality: conf.generate_cert_locality,
+                    common_name: conf.generate_cert_common_name || ::Socket.gethostname,
+                    expiration: conf.generate_cert_expiration,
+                    digest: conf.generate_cert_digest,
+                  }
+        end
+      end
+
+      def self.co_cert_option_generate_pair(owner, opts, issuer = nil)
+        describe_certificate_request(local_variables.include?(:conf) ? conf : nil)
+        owner.instance_exec do
+                  key = OpenSSL::PKey::RSA.generate(opts[:private_key_length])
+
+                  subject = OpenSSL::X509::Name.new
+                  subject.add_entry('C', opts[:country])
+                  subject.add_entry('ST', opts[:state])
+                  subject.add_entry('L', opts[:locality])
+                  subject.add_entry('CN', opts[:common_name])
+
+                  issuer ||= subject
+
+                  cert = OpenSSL::X509::Certificate.new
+                  cert.not_before = Time.at(0)
+                  cert.not_after = Time.now + opts[:expiration]
+                  cert.public_key = key
+                  cert.version = 2
+                  cert.serial = rand(2**(8*10))
+                  cert.issuer = issuer
+                  cert.subject  = subject
+
+                  return cert, key
+        end
+      end
+
+      def self.co_cert_option_add_extensions(owner, cert, extensions)
+        describe_certificate_request(local_variables.include?(:conf) ? conf : nil)
+        owner.instance_exec do
+                  ef = OpenSSL::X509::ExtensionFactory.new
+                  extensions.each do |ext|
+                    oid, value = ext
+                    cert.add_extension ef.create_extension(oid, value)
+                  end
+        end
+      end
+
+      def self.co_cert_option_generate_ca_pair_self_signed(owner, generate_opts)
+        describe_certificate_request(local_variables.include?(:conf) ? conf : nil)
+        owner.instance_exec do
+                  cert, key = Fluent::RPC::Server.co_cert_option_generate_pair(self, generate_opts)
+
+                  Fluent::RPC::Server.co_cert_option_add_extensions(self, cert, [
+                    ['basicConstraints', 'CA:TRUE']
+                  ])
+
+                  cert.sign(key, generate_opts[:digest].to_s)
+                  return cert, key
+        end
+      end
+
+      def self.co_cert_option_generate_server_pair_by_ca(owner, ca_cert_path, ca_key_path, ca_key_passphrase, generate_opts)
+        describe_certificate_request(local_variables.include?(:conf) ? conf : nil)
+        owner.instance_exec do
+                  ca_key = OpenSSL::PKey::read(File.read(ca_key_path), ca_key_passphrase)
+                  ca_cert = OpenSSL::X509::Certificate.new(File.read(ca_cert_path))
+                  cert, key = Fluent::RPC::Server.co_cert_option_generate_pair(self, generate_opts, ca_cert.subject)
+                  raise "BUG: certificate digest algorithm not set" unless generate_opts[:digest]
+
+                  Fluent::RPC::Server.co_cert_option_add_extensions(self, cert, [
+                    ['basicConstraints', 'CA:FALSE'],
+                    ['nsCertType', 'server'],
+                    ['keyUsage', 'digitalSignature,keyEncipherment'],
+                    ['extendedKeyUsage', 'serverAuth']
+                  ])
+
+                  cert.sign(ca_key, generate_opts[:digest].to_s)
+                  return cert, key, nil
+        end
+      end
+
+      def self.co_cert_option_generate_server_pair_self_signed(owner, generate_opts)
+        describe_certificate_request(local_variables.include?(:conf) ? conf : nil)
+        owner.instance_exec do
+                  cert, key = Fluent::RPC::Server.co_cert_option_generate_pair(self, generate_opts)
+                  raise "BUG: certificate digest algorithm not set" unless generate_opts[:digest]
+
+                  Fluent::RPC::Server.co_cert_option_add_extensions(self, cert, [
+                    ['basicConstraints', 'CA:FALSE'],
+                    ['nsCertType', 'server']
+                  ])
+
+                  cert.sign(key, generate_opts[:digest].to_s)
+                  return cert, key, nil
+        end
+      end
+
+      def self.co_cert_option_certificates_from_file(owner, path)
+        describe_certificate_request(local_variables.include?(:conf) ? conf : nil)
+        owner.instance_exec do
+                  data = File.read(path)
+                  pattern = Regexp.compile('-+BEGIN CERTIFICATE-+\r?\n(?:[^-]*\r?\n)+-+END CERTIFICATE-+\r?\n?', Regexp::MULTILINE)
+                  list = []
+                  data.scan(pattern){|match| list << OpenSSL::X509::Certificate.new(match) }
+                  if list.length == 0
+                    raise Fluent::ConfigError, "cert_path does not contain a valid certificate"
+                  end
+                  list
+        end
+      end
+
+      def self.tls_set_version_to_context(owner, ctx, version, min_version, max_version)
+        describe_tls_versions(version, min_version, max_version)
+        owner.instance_exec do
+                if Fluent::TLS::MIN_MAX_AVAILABLE
+                  case
+                  when min_version.nil? && max_version.nil?
+                    min_version = Fluent::TLS::METHODS_MAP[version] || version
+                    max_version = Fluent::TLS::METHODS_MAP[version] || version
+                  when min_version.nil? && max_version
+                    raise Fluent::ConfigError, "When you set max_version, must set min_version together"
+                  when min_version && max_version.nil?
+                    raise Fluent::ConfigError, "When you set min_version, must set max_version together"
+                  else
+                    min_version = Fluent::TLS::METHODS_MAP[min_version] || min_version
+                    max_version = Fluent::TLS::METHODS_MAP[max_version] || max_version
+                  end
+                  ctx.min_version = min_version
+                  ctx.max_version = max_version
+                else
+                  ctx.ssl_version = Fluent::TLS::METHODS_MAP[version] || version
+                end
+
+                ctx
+        end
+      end
