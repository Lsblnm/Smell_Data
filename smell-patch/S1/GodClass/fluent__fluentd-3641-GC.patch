+          { name: "EADDRINUSE", description: "address in use", retryable: true }
+        when "EADDRNOTAVAIL", "Errno::EADDRNOTAVAIL"
+          { name: "EADDRNOTAVAIL", description: "address not available", retryable: true }
+        when "ECONNRESET", "Errno::ECONNRESET"
+          { name: "ECONNRESET", description: "connection reset", retryable: false }
