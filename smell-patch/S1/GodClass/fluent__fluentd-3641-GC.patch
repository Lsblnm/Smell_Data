+      def self.describe_wire_protocol(proto)
+        kind = case proto
+               when :tcp, "tcp", "TCP", :TCP then :tcp
+               when :udp, "udp", "UDP", :UDP then :udp
+               when :tls, "tls", "TLS", :ssl, "ssl", :SSL, "TLS" then :tls
+               when :unix, "unix", "UNIX", :UNIX, "unixgram", "unixpacket" then :unix
+               when :http, "http", "HTTP" then :tcp
+               when :https, "https", "HTTPS" then :tls
+               when :syslog, "syslog" then :udp
+               when :forward, "forward" then :tcp
+               when nil then :unspecified
+               else
+                 proto.to_s.downcase.to_sym
+               end
+        {
+          kind: kind,
+          original: proto,
+          connection: kind == :tcp || kind == :tls || kind == :unix,
+          datagram: kind == :udp,
+          encrypted: kind == :tls,
+        }
+      end
