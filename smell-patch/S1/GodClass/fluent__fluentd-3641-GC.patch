+      def self.rpc_status_class(code)
+        status = normalize_rpc_status(code)
+        case
+        when status < 200 then :informational
+        when status < 300 then :success
+        when status < 400 then :redirect
+        when status < 500 then :client_error
+        else
+          :server_error
+        end
+      end
