+      def self.describe_http_exchange(path, code, header, body)
+        status = normalize_rpc_status(code)
+        headers = merge_rpc_headers(header)
+        kind = rpc_path_kind(path)
+        payload = body.nil? ? nil : body.to_s
+        json = headers["Content-Type"].to_s.include?("json")
+        bytes = payload.nil? ? 0 : payload.bytesize
+        empty = payload.nil? || payload.empty?
+        {
+          path: sanitize_rpc_path(path),
+          kind: kind,
+          status: status,
+          class: rpc_status_class(status),
+          message: rpc_status_message(status),
+          headers: headers,
+          json: json,
+          bytes: bytes,
+          empty: empty,
+          success: status >= 200 && status < 300,
+        }
+      end
