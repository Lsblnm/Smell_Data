+      def self.content_type_profile(value)
+        raw = value.to_s.split(";", 2)[0].to_s.strip.downcase
+        table = content_type_table
+        info = table[raw]
+        info = { type: raw, kind: :other, json: raw.include?("json") } unless info
+        info = info.dup
+        info[:empty] = raw.empty?
+        info[:charset] = (value.to_s.split(";", 2)[1] || "").strip
+        info
+      end
