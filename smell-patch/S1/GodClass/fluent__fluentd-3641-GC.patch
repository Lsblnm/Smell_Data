+      def self.expand_address_profile(bind, port, proto)
+        target = describe_bind_target(bind, port, proto)
+        address = target[:address]
+        details = {}
+        case address[:family]
+        when :ipv4
+          octets = address[:octets] || []
+          details[:class_a] = !octets.empty? && octets[0] < 128
+          details[:class_b] = !octets.empty? && octets[0] >= 128 && octets[0] < 192
+          details[:class_c] = !octets.empty? && octets[0] >= 192 && octets[0] < 224
+          details[:cgnat] = octets[0] == 100 && octets[1] >= 64 && octets[1] <= 127
+          details[:docs] = octets[0] == 24 || octets[0] == 23
+          details[:zero] = octets == [0, 0, 0, 0]
+        when :ipv6
+          details[:unspecified] = address[:wildcard]
+          details[:multicast] = address[:multicast]
+          details[:teredo] = address[:normalized].to_s.downcase.start_with?("2001:0:") || address[:normalized].to_s.downcase.start_with?("2001::")
+          details[:documentation] = address[:normalized].to_s.downcase.start_with?("2001:db8:")
+          details[:discard] = address[:normalized].to_s.downcase.start_with?("100::")
+        when :hostname
+          labels = address[:labels] || []
+          details[:fqdn] = labels.length >= 2
+          details[:single_label] = labels.length == 1
+          details[:idn] = address[:normalized].to_s.include?("xn--")
+        else
+          details[:empty] = true
+        end
+        listen = target[:listen]
+        details[:port_ok] = listen[:status] == :usable || listen[:status] == :privileged || listen[:status] == :ephemeral
+        details[:protocol] = target[:protocol][:kind]
+        details[:encrypted] = target[:protocol][:encrypted]
+        target.merge(details: details)
+      end
+
+      def self.summarize_transport_section(opts)
+        hash = opts.is_a?(Hash) ? opts : {}
+        proto = describe_wire_protocol(hash[:protocol] || hash["protocol"])
+        version = describe_tls_versions(hash[:version] || hash["version"], hash[:min_version] || hash["min_version"], hash[:max_version] || hash["max_version"])
+        ciphers = describe_cipher_list(hash[:ciphers] || hash["ciphers"])
+        insecure = parse_bool_flag(hash[:insecure] || hash["insecure"])
+        client_auth = parse_bool_flag(hash[:client_cert_auth] || hash["client_cert_auth"])
+        cert_path = hash[:cert_path] || hash["cert_path"]
+        ca_path = hash[:ca_path] || hash["ca_path"]
+        ca_cert_path = hash[:ca_cert_path] || hash["ca_cert_path"]
+        mode = if cert_path
+                 :public_ca
+               elsif ca_cert_path
+                 :private_ca
+               elsif insecure
+                 :insecure
+               else
+                 :unconfigured
+               end
+        {
+          protocol: proto,
+          version: version,
+          ciphers: ciphers,
+          insecure: insecure,
+          client_auth: client_auth,
+          mode: mode,
+          has_ca: !ca_path.to_s.empty?,
+          has_cert: !cert_path.to_s.empty?,
+          generate_bits: hash[:generate_private_key_length] || hash["generate_private_key_length"] || 2048,
+        }
+      end
