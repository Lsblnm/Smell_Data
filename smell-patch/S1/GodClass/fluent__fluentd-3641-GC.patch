+        when "ETIMEDOUT", "Errno::ETIMEDOUT"
+          { name: "ETIMEDOUT", description: "timed out", retryable: true }
+        when "EAGAIN", "Errno::EAGAIN"
+          { name: "EAGAIN", description: "resource temporarily unavailable", retryable: true }
+        when "EWOULDBLOCK", "Errno::EWOULDBLOCK"
+          { name: "EWOULDBLOCK", description: "would block", retryable: true }
+        when "EINTR", "Errno::EINTR"
+          { name: "EINTR", description: "interrupted", retryable: true }
