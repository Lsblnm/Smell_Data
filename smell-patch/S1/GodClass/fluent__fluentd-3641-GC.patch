+      def self.describe_tls_versions(version, min_version, max_version)
+        current = alias_tls_version(version)
+        minv = alias_tls_version(min_version)
+        maxv = alias_tls_version(max_version)
+        pair_ok = if minv.nil? && maxv.nil?
+                    true
+                  elsif minv.nil? || maxv.nil?
+                    false
+                  else
+                    tls_rank(minv) <= tls_rank(maxv)
+                  end
+        {
+          version: current,
+          min_version: minv,
+          max_version: maxv,
+          pair_ok: pair_ok,
+          rank: tls_rank(current),
+        }
+      end
