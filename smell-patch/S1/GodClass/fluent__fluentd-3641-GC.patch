+      def self.describe_cipher_list(ciphers)
+        text = ciphers.nil? ? "" : ciphers.to_s
+        items = text.split(":").map(&:strip).reject(&:empty?)
+        insecure = items.select { |item| cipher_token_insecure?(item) }
+        {
+          count: items.length,
+          items: items,
+          insecure: insecure,
+          empty: items.empty?,
+        }
+      end
