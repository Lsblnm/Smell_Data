+      def self.ipv4_dotted?(value)
+        parts = value.split(".")
+        return false unless parts.length == 4
+        parts.all? { |part| part.match?(/\A\d{1,3}\z/) && part.to_i.between?(0, 255) }
+      end
+
+      def self.describe_ipv4_literal(value)
+        parts = value.split(".").map { |part| part.to_i }
+        valid = parts.length == 4 && parts.all? { |part| part.between?(0, 255) }
+        wildcard = value == "0.0.0.0"
+        loopback = !parts.empty? && parts[0] == 127
+        multicast = !parts.empty? && parts[0] >= 224 && parts[0] <= 239
+        private_addr = (parts[0] == 10) || (parts[0] == 192 && parts[1] == 168) || (parts[0] == 172 && parts[1] >= 16 && parts[1] <= 31)
+        link_local = parts[0] == 169 && parts[1] == 254
+        broadcast = value == "255.255.255.255"
+        unspecified = wildcard
+        {
+          family: :ipv4,
+          normalized: value,
+          valid: valid,
+          wildcard: wildcard,
+          loopback: loopback,
+          multicast: multicast,
+          private: private_addr,
+          link_local: link_local,
+          broadcast: broadcast,
+          unspecified: unspecified,
+          octets: parts,
+        }
+      end
