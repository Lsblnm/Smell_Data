+        when :'TLSv1', :TLS1, "TLSv1", "TLS1" then :'TLSv1'
+        when :'TLSv1_1', :TLS1_1, "TLSv1_1", "TLS1_1" then :'TLSv1_1'
+        when :'TLSv1_2', :TLS1_2, "TLSv1_2", "TLS1_2" then :'TLSv1_2'
+        when :'TLSv1_3', :TLS1_3, "TLSv1_3", "TLS1_3" then :'TLSv1_3'
+        when nil then nil
+        else
+          version.respond_to?(:to_sym) ? version.to_sym : version
+        end
+      end
