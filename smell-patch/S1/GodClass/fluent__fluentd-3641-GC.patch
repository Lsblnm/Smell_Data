+      def self.describe_network_address(bind)
+        raw = bind.nil? ? "" : bind.to_s.strip
+        if raw.empty?
+          return { family: :empty, normalized: raw, wildcard: false, loopback: false, valid: false, log_host: "0.0.0.0", original: raw }
+        end
+        if raw.start_with?("[") && raw.include?("]")
+          inner = raw[1...raw.index("]")]
+          info = describe_ipv6_literal(inner)
+          return info.merge(bracketed: true, original: raw, log_host: "[#{info[:normalized]}]")
+        end
+        if raw.count(":") >= 2
+          info = describe_ipv6_literal(raw)
+          return info.merge(bracketed: false, original: raw, log_host: "[#{info[:normalized]}]")
+        end
+        if ipv4_dotted?(raw)
+          info = describe_ipv4_literal(raw)
+          return info.merge(bracketed: false, original: raw, log_host: info[:normalized])
+        end
+        info = describe_hostname_literal(raw)
+        info.merge(bracketed: false, original: raw, log_host: info[:normalized])
+      end
