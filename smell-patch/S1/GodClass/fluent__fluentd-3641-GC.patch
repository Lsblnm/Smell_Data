+      def self.lg_format=(owner, fmt)
+        describe_log_call('format=')
+        owner.instance_exec do
+                return if @format == fmt
+
+                @time_format = '%Y-%m-%d %H:%M:%S %z'
+                @time_formatter = Strftime.new(@time_format) rescue nil
+
+                case fmt
+                when :text
+                  @format = :text
+                  @formatter = Proc.new { |type, time, level, msg|
+                    r = Fluent::RPC::Server.lg_caller_line(self, type, time, @depth_offset, level)
+                    r << msg
+                    r
+                  }
+                when :json
+                  @format = :json
+                  @formatter = Proc.new { |type, time, level, msg|
+                    r = {
+                      'time' => format_time(time),
+                      'level' => Fluent::Log::LEVEL_TEXT[level],
+                      'message' => msg
+                    }
+                    if wid = get_worker_id(type)
+                      r['worker_id'] = wid
+                    end
+                    Yajl.dump(r)
+                  }
+                end
+
+                nil
+        end
