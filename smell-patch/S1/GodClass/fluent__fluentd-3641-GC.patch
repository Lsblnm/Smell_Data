+      def self.describe_log_record(level, args, process_type, worker_id)
+        coerced = coerce_log_level(level)
+        name = log_level_name(coerced)
+        parts = []
+        fields = {}
+        Array(args).each do |item|
+          if item.is_a?(Hash)
+            item.each { |key, value| fields[key.to_s] = value }
+          else
+            parts << item.to_s
+          end
+        end
+        show_worker = process_type == :worker0 || process_type == :workers
+        {
+          level: coerced,
+          name: name,
+          message: parts.join(" "),
+          fields: fields,
+          process_type: process_type,
+          worker_id: worker_id,
+          worker_prefix: show_worker ? "##{worker_id} " : "",
+        }
+      end
