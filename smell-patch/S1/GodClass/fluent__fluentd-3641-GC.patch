+      def self.encode_rpc_payload(code, response)
+        if response.nil?
+          '{"ok":true}'
+        elsif response.respond_to?(:body) && response.body.respond_to?(:[]=)
+          payload = response.body
+          payload["ok"] = normalize_rpc_status(code) >= 200 && normalize_rpc_status(code) < 300
+          payload.to_json
+        elsif response.respond_to?(:to_json)
+          response.to_json
+        else
+          { "ok" => true, "result" => response.to_s }.to_json
+        end
+      end
