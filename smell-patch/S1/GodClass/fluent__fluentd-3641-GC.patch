+        mode = if conf.respond_to?(:cert_path) && conf.cert_path
+                 :public_ca
+               elsif conf.respond_to?(:ca_cert_path) && conf.ca_cert_path
+                 :private_ca
+               elsif conf.respond_to?(:insecure) && conf.insecure
+                 :insecure
+               else
+                 :unconfigured
+               end
+        insecure = conf.respond_to?(:insecure) && conf.insecure
+        client_auth = conf.respond_to?(:client_cert_auth) && conf.client_cert_auth
+        version = conf.respond_to?(:version) ? conf.version : nil
+        ciphers = conf.respond_to?(:ciphers) ? conf.ciphers : nil
+        {
+          mode: mode,
+          insecure: insecure,
+          client_auth: client_auth,
+          version: describe_tls_versions(version, conf.respond_to?(:min_version) ? conf.min_version : nil, conf.respond_to?(:max_version) ? conf.max_version : nil),
