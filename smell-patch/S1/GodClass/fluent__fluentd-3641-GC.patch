+      def self.http_status_table
+        @http_status_table ||= begin
+          h = {}
+          [
+            [100, "Continue", :informational, false],
+            [101, "Switching Protocols", :informational, false],
+            [103, "Early Hints", :informational, false],
+            [110, "Response is Stale", :informational, false],
+            [111, "Revalidation Failed", :informational, false],
