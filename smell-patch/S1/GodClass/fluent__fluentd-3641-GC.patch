+      def self.ipv6_special_purpose(value)
+        info = describe_ipv6_literal(value.to_s)
+        text = value.to_s.downcase
+        purpose = ipv6_purpose_for(text)
+        info.merge(purpose: purpose, globally_reachable: purpose == :global)
