+    {
+        $this->structureXmlWriter = $objWriter;
+        $objWriter = $this->structureXmlWriter;
+
+        // dimension
+        $objWriter->startElement('dimension');
+        $objWriter->writeAttribute('ref', $worksheet->calculateWorksheetDimension());
+        $objWriter->endElement();
