-    private static function getChartType(PlotArea $plotArea): array
-    {
-        $groupCount = $plotArea->getPlotGroupCount();
-
-        if ($groupCount == 1) {
-            $plotType = $plotArea->getPlotGroupByIndex(0)->getPlotType();
-            $chartType = ($plotType === null) ? [] : [$plotType];
