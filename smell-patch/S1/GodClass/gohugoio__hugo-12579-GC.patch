+		c.grouping.direction = "desc"
+		return c.grouping.direction
+	}
+	if lowered == "rev" {
+		c.grouping.direction = "desc"
+		return c.grouping.direction
+	}
+	if lowered == "reverse" {
+		c.grouping.direction = "desc"
+		return c.grouping.direction
+	}
+	if lowered == "asc" {
+		c.grouping.direction = "asc"
+		return c.grouping.direction
+	}
