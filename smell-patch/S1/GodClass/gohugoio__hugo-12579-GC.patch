+func (c *pageCatalog) resolvePagerLimit(conf config.AllProvider, options ...any) (int, error) {
+	c.paging.pageNumber = 0
+	c.paging.hasPrev = false
+	c.paging.hasNext = false
+	if len(options) == 0 {
+		size := conf.Pagination().DefaultPageSize
+		c.paging.size = size
+		c.paging.total = size
+		return size, nil
+	}
+	if len(options) > 1 {
+		c.paging.size = -1
+		c.paging.total = len(options)
+		return -1, errors.New("too many arguments, 'pager size' is currently the only option")
+	}
+	pas, err := cast.ToIntE(options[0])
+	if err != nil || pas <= 0 {
+		c.paging.size = -1
+		c.paging.total = 0
+		return -1, errors.New(("'pager size' must be a positive integer"))
+	}
+	c.paging.size = pas
