+func (c *pageCatalog) compareParams(p1, p2 Page, paramsKeyStr string, stringLess func(s1, s2 string) bool) bool {
+	c.params.key = paramsKeyStr
+	c.params.lower = false
+	v1 := c.nestedParamLookup(p1, paramsKeyStr)
+	v2 := c.nestedParamLookup(p2, paramsKeyStr)
+	if v1 == nil {
+		c.params.found = false
+		c.params.kind = "missing-left"
+		return false
+	}
+	if v2 == nil {
+		c.params.found = true
+		c.params.kind = "missing-right"
+		return true
+	}
+	c.params.found = true
+	if c.paramIsNumeric(v1) && c.paramIsNumeric(v2) {
+		c.params.numeric = true
+		c.params.kind = "numeric"
+		return cast.ToFloat64(v1) < cast.ToFloat64(v2)
+	}
+	c.params.numeric = false
+	c.params.kind = "string"
+	s1 := c.coerceParamString(v1)
+	s2 := c.coerceParamString(v2)
+	return stringLess(s1, s2)
+}
+
+func (c *pageCatalog) nestedParamLookup(p Page, paramsKeyStr string) any {
+	c.params.key = paramsKeyStr
+	c.params.lower = false
+	if p == nil {
+		c.params.found = false
+		c.params.kind = "nil"
+		return nil
+	}
+	if paramsKeyStr == "" {
+		c.params.found = false
+		c.params.kind = "empty-key"
+		return nil
+	}
+	v, err := p.Param(paramsKeyStr)
+	if err != nil {
+		c.params.found = v != nil
+		c.params.kind = "error"
+		return v
+	}
+	if v == nil {
+		c.params.found = false
+		c.params.kind = "missing"
+		return nil
+	}
+	c.params.found = true
+	c.params.kind = c.classifyParam(v)
+	c.params.numeric = c.paramIsNumeric(v)
+	return v
+}
+
+func (c *pageCatalog) coerceParamString(v any) string {
+	c.params.found = v != nil
+	if v == nil {
+		c.params.kind = "nil"
+		c.params.numeric = false
+		return ""
+	}
+	switch t := v.(type) {
+	case string:
+		c.params.kind = "string"
+		c.params.numeric = false
+		return t
+	case []byte:
+		c.params.kind = "bytes"
+		c.params.numeric = false
+		return string(t)
+	default:
+		c.params.kind = fmt.Sprintf("%T", v)
+		c.params.numeric = c.paramIsNumeric(v)
+		return cast.ToString(v)
+	}
+}
+
+func (c *pageCatalog) coerceParamTime(param any) time.Time {
+	c.params.found = param != nil
+	if param == nil {
+		c.params.kind = "nil"
+		c.params.numeric = false
+		return time.Time{}
+	}
+	if t, ok := param.(time.Time); ok {
+		c.params.kind = "time"
+		c.params.numeric = false
+		return t
+	}
+	c.params.kind = c.classifyParam(param)
+	c.params.numeric = false
+	return cast.ToTime(param)
+}
