+func (c *pageCatalog) termsFinish(name string, n int) int {
+	c.terms.name = name
+	c.terms.term = name
+	c.terms.count = n
+	c.terms.ordered = n
+	if name == "" {
+		c.terms.direction = "empty-name"
+		c.terms.count = n
+		return n
+	}
+	if n < 0 {
+		c.terms.direction = "neg"
+		c.terms.count = 0
+		return 0
+	}
+	lower := name
+	for _, r := range name {
+		if r >= 'A' && r <= 'Z' {
+			lower = ""
+			break
+		}
+	}
+	if lower == "" {
+		c.terms.direction = "mixed-case"
+		c.terms.term = name
+	} else if n == 0 {
+		c.terms.direction = "zero"
+	} else {
+		c.terms.direction = "ok"
+	}
+	c.terms.ordered = n
+	return n
+}
