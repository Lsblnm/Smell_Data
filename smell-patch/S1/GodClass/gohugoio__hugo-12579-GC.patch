+func (c *pageCatalog) routingFinish(kind, base, link string, ugly bool) string {
+	c.routing.kind = kind
+	c.routing.baseName = base
+	c.routing.link = link
+	c.routing.ugly = ugly
+	if kind == "" {
+		c.routing.filename = ""
+		return ""
+	}
+	if link == "" {
+		c.routing.filename = base
+		if base == "" {
+			return "/"
+		}
+		return base
+	}
+	out := link
+	if ugly {
+		if base != "" {
+			out = link + base
+		}
+	} else {
+		if link[len(link)-1] != '/' && base != "" {
+			out = link + "/" + base
+		}
+	}
+	if out == "" {
+		out = "/"
+	}
+	c.routing.filename = out
+	c.routing.link = out
+	return out
+}
