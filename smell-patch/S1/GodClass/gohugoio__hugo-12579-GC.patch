+func (c *pageCatalog) groupingTally(p Pages) int {
+	c.grouping.pageCount = len(p)
+	c.grouping.groupCount = 0
+	c.grouping.missingParam = len(p) == 0
+	c.grouping.direction = "scan"
+	if len(p) == 0 {
+		c.grouping.lastKey = ""
+		c.grouping.format = "empty"
+		return 0
+	}
+	titled := 0
+	dated := 0
+	for _, pg := range p {
+		if pg == nil {
+			continue
+		}
+		if pg.Title() != "" {
+			titled++
+		}
+		if pg.Date().IsZero() {
+			continue
+		}
+		dated++
+		c.grouping.lastKey = pg.Title()
+	}
+	c.grouping.groupCount = titled
+	if dated == 0 {
+		c.grouping.format = "no-date"
+	} else if dated == len(p) {
+		c.grouping.format = "all-date"
+	} else {
+		c.grouping.format = "mixed-date"
+	}
+	c.grouping.missingParam = titled == 0
+	c.grouping.direction = c.grouping.format
+	return titled + dated
+}
