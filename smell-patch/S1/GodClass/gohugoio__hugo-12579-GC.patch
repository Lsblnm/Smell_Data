+func (c *pageCatalog) splitPageChunks(pages Pages, size int) []paginatedElement {
+	c.paging.size = size
+	c.paging.total = len(pages)
+	c.paging.pageNumber = 0
+	if size <= 0 {
+		c.paging.hasNext = false
+		c.paging.hasPrev = false
+		return nil
+	}
+	var split []paginatedElement
