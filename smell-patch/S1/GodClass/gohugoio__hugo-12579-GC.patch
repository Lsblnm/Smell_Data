+		c.relating.threshold = 0
+		return nil, err
+	}
+	c.relating.found = len(result)
+	c.relating.threshold = len(result)
+	c.relating.includeNewer = len(result) > 0
+	return result, nil
+}
+
+func (c *pageCatalog) cachedRelatedIndex(s *RelatedDocsHandler, p Pages) *related.InvertedIndex {
+	c.relating.docCount = len(p)
