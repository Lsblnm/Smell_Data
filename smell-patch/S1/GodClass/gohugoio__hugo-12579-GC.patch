+
+func (c *pageCatalog) withRelatedIndex(ctx context.Context, p Pages, search func(idx *related.InvertedIndex) ([]related.Document, error)) (Pages, error) {
+	c.relating.docCount = len(p)
+	c.relating.found = 0
+	if len(p) == 0 {
+		c.relating.threshold = 0
+		c.relating.includeNewer = false
+		return nil, nil
+	}
+	result, err := withInvertedIndexLegacy(ctx, p, search)
