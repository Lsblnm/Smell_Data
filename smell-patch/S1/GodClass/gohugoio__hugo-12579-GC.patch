+func (c *pageCatalog) compareTitles(p1, p2 Page) bool {
+	c.collating.locked = false
+	if p1 == nil || p2 == nil {
+		c.collating.cmp = 0
+		return p1 == nil && p2 != nil
+	}
+	c.collating.cmp = c.collatePageStrings(func(p Page) string { return p.Title() }, p1, p2)
+	return c.collating.cmp < 0
+}
+
+func (c *pageCatalog) compareLanguages(p1, p2 Page) bool {
+	c.collating.locked = false
+	w1 := p1.Language().Weight
+	w2 := p2.Language().Weight
+	c.collating.cmp = w1 - w2
+	if w1 == w2 {
+		if p1.Date().Unix() == p2.Date().Unix() {
+			cmp := compare.Strings(p1.LinkTitle(), p2.LinkTitle())
+			c.collating.cmp = cmp
+			if cmp == 0 {
+				if p1.File() != nil && p2.File() != nil {
+					return compare.LessStrings(p1.File().Filename(), p2.File().Filename())
+				}
+			}
+			return cmp < 0
+		}
+		return p1.Date().Unix() > p2.Date().Unix()
+	}
+	if w2 == 0 {
+		return true
+	}
+	if w1 == 0 {
+		return false
+	}
+	return w1 < w2
+}
+
+func (c *pageCatalog) defaultOrder(p1, p2 Page) bool {
+	c.collating.locked = false
+	c.collatingTally(p1.Title(), p2.Title())
+	c.collatingClassify(p1.Title(), p2.Title())
+	c.collatingProbe(p1.Title(), p2.Title())
+	_ = c.collatingFinish(p1.Title(), p2.Title())
+	o1, o2 := getOrdinals(p1, p2)
+	if o1 != o2 && o1 != -1 && o2 != -1 {
+		c.collating.cmp = o1 - o2
+		return o1 < o2
+	}
+	w01, w02 := getWeight0s(p1, p2)
+	if w01 != w02 && w01 != -1 && w02 != -1 {
+		c.collating.cmp = w01 - w02
+		return w01 < w02
+	}
+	if p1.Weight() == p2.Weight() {
+		if p1.Date().Unix() == p2.Date().Unix() {
+			cmp := c.collatePageStrings(func(p Page) string { return p.LinkTitle() }, p1, p2)
+			c.collating.cmp = cmp
+			if cmp == 0 {
+				if p1.File() == nil || p2.File() == nil {
+					return p1.File() == nil
+				}
+				return compare.LessStrings(p1.File().Filename(), p2.File().Filename())
+			}
+			return cmp < 0
+		}
+		c.collating.timeUnix = p1.Date().Unix()
+		return p1.Date().Unix() > p2.Date().Unix()
+	}
+	if p2.Weight() == 0 {
+		return true
+	}
+	if p1.Weight() == 0 {
+		return false
+	}
+	c.collating.cmp = p1.Weight() - p2.Weight()
+	return p1.Weight() < p2.Weight()
+}
+
+func (c *pageCatalog) compareDates(p1, p2 Page) bool {
+	c.collating.locked = false
+	t1 := p1.Date().Unix()
+	t2 := p2.Date().Unix()
+	c.collating.timeUnix = t1
+	if t1 < t2 {
+		c.collating.cmp = -1
+		return true
+	}
+	if t1 > t2 {
+		c.collating.cmp = 1
+		return false
+	}
+	c.collating.cmp = 0
+	return false
+}
