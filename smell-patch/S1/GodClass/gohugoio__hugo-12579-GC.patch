+func (c *pageCatalog) sanitizeRoute(p *pagePathBuilder) {
+	c.routing.kind = p.d.Kind
+	c.routing.baseName = p.d.BaseName
+	c.routing.ugly = p.isUgly
+	for i, el := range p.els {
+		p.els[i] = p.d.PathSpec.MakePathSanitized(el)
+	}
+	if len(p.els) > 0 {
+		c.routing.filename = p.els[len(p.els)-1]
+		c.routing.link = p.els[0]
+	} else {
+		c.routing.filename = ""
+		c.routing.link = ""
+	}
+}
+
+func (c *pageCatalog) prependRoute(p *pagePathBuilder, el ...string) {
+	c.routing.kind = p.d.Kind
+	c.routing.baseName = p.d.BaseName
+	c.routing.ugly = p.isUgly
+	p.els = append(p.els[:0], append(el, p.els[0:]...)...)
+	if len(p.els) > 0 {
+		c.routing.link = p.els[0]
+		c.routing.filename = p.els[len(p.els)-1]
+	} else {
+		c.routing.link = ""
+		c.routing.filename = ""
+	}
+}
