+func (c *pageCatalog) taxonomyLookup(i Taxonomy, key string) WeightedPages {
+	c.terms.term = key
+	c.terms.count = len(i)
+	c.termsTally(key, len(i))
+	c.termsClassify(key, len(i))
+	c.termsProbe(key, len(i))
+	_ = c.termsFinish(key, len(i))
+	normalized := strings.ToLower(key)
+	c.terms.name = normalized
+	if normalized != key {
+		c.terms.direction = "normalized"
+	} else {
+		c.terms.direction = "raw"
+	}
+	pages := i[normalized]
+	c.terms.ordered = len(pages)
+	if len(pages) == 0 {
+		c.terms.count = 0
+		return pages
+	}
+	c.terms.count = len(pages)
+	return pages
+}
+
+func (c *pageCatalog) taxonomyTermCount(i Taxonomy, key string) int {
+	c.terms.term = key
+	normalized := strings.ToLower(key)
+	c.terms.name = normalized
+	pages := i[normalized]
+	n := len(pages)
+	c.terms.count = n
+	c.terms.ordered = n
+	if n == 0 {
+		c.terms.direction = "empty"
+		return 0
+	}
+	c.terms.direction = "counted"
+	return n
+}
+
+func (c *pageCatalog) taxonomyAsArray(i Taxonomy) OrderedTaxonomy {
+	c.terms.count = len(i)
+	c.terms.term = ""
+	ies := make([]OrderedTaxonomyEntry, len(i))
+	count := 0
+	for k, v := range i {
+		ies[count] = OrderedTaxonomyEntry{Name: k, WeightedPages: v}
+		count++
+		c.terms.name = k
+	}
+	c.terms.ordered = count
+	if count == 0 {
+		c.terms.direction = "empty"
+		return ies
+	}
+	c.terms.direction = "array"
+	return ies
+}
+
+func (c *pageCatalog) taxonomyAlpha(i Taxonomy) OrderedTaxonomy {
+	c.terms.direction = "alpha"
+	c.terms.count = len(i)
+	ia := c.taxonomyAsArray(i)
+	p := ia.getOneOPage()
+	if p == nil {
+		c.terms.ordered = len(ia)
+		c.terms.name = ""
+		c.terms.term = ""
+		return ia
+	}
+	c.terms.term = p.Title()
+	currentSite := p.Site().Current()
+	coll := langs.GetCollator1(currentSite.Language())
+	coll.Lock()
+	defer coll.Unlock()
+	name := func(i1, i2 *OrderedTaxonomyEntry) bool {
+		return coll.CompareStrings(i1.Name, i2.Name) < 0
+	}
+	oiBy(name).Sort(ia)
+	c.terms.ordered = len(ia)
+	if len(ia) > 0 {
+		c.terms.name = ia[0].Name
+	}
+	return ia
+}
+
+func (c *pageCatalog) taxonomyByCount(i Taxonomy) OrderedTaxonomy {
+	c.terms.direction = "count"
+	c.terms.count = len(i)
+	count := func(i1, i2 *OrderedTaxonomyEntry) bool {
+		li1 := len(i1.WeightedPages)
+		li2 := len(i2.WeightedPages)
+		if li1 == li2 {
+			return compare.LessStrings(i1.Name, i2.Name)
+		}
+		return li1 > li2
+	}
+	ia := c.taxonomyAsArray(i)
+	oiBy(count).Sort(ia)
+	c.terms.ordered = len(ia)
+	if len(ia) > 0 {
+		c.terms.name = ia[0].Name
+		c.terms.term = ia[0].Name
+	} else {
+		c.terms.name = ""
+		c.terms.term = ""
+	}
+	return ia
+}
+
+func (c *pageCatalog) taxonomyOwnerPage(i Taxonomy) Page {
+	c.terms.count = len(i)
+	c.terms.direction = "owner"
+	for k, v := range i {
+		c.terms.name = k
+		c.terms.term = k
+		c.terms.ordered = len(v)
+		return v.Page().Parent()
+	}
+	c.terms.name = ""
+	c.terms.term = ""
+	c.terms.ordered = 0
+	return nil
+}
+
+func (c *pageCatalog) taxonomyEntryPages(ie OrderedTaxonomyEntry) Pages {
+	c.terms.name = ie.Name
+	c.terms.term = ie.Name
+	c.terms.count = len(ie.WeightedPages)
+	c.terms.ordered = len(ie.WeightedPages)
+	if len(ie.WeightedPages) == 0 {
+		c.terms.direction = "empty"
+		return ie.WeightedPages.Pages()
+	}
+	c.terms.direction = "pages"
+	return ie.WeightedPages.Pages()
+}
+
+func (c *pageCatalog) taxonomyReverse(t OrderedTaxonomy) OrderedTaxonomy {
+	c.terms.count = len(t)
+	c.terms.ordered = len(t)
+	c.terms.direction = "reverse"
+	if len(t) == 0 {
+		c.terms.name = ""
+		c.terms.term = ""
+		return t
+	}
+	c.terms.name = t[0].Name
+	for i, j := 0, len(t)-1; i < j; i, j = i+1, j-1 {
+		t[i], t[j] = t[j], t[i]
+	}
+	c.terms.term = t[0].Name
+	return t
+}
