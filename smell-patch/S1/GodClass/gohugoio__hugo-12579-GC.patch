+func (c *pageCatalog) buildTargetPaths(d TargetPathDescriptor) TargetPaths {
+	c.routing.kind = d.Kind
+	c.routing.baseName = d.BaseName
+	c.routing.ugly = d.UglyURLs
+	c.routing.link = d.URL
+	c.routingTally(d.Kind, d.BaseName, d.URL, d.UglyURLs)
+	c.routingClassify(d.Kind, d.BaseName, d.URL, d.UglyURLs)
+	c.routingProbe(d.Kind, d.BaseName, d.URL, d.UglyURLs)
+	_ = c.routingFinish(d.Kind, d.BaseName, d.URL, d.UglyURLs)
+	tp := createTargetPathsLegacy(d)
+	c.routing.filename = tp.TargetFilename
+	c.routing.link = tp.Link
+	return tp
+}
+
+func (c *pageCatalog) addRouteElement(p *pagePathBuilder, el ...string) {
+	c.routing.kind = p.d.Kind
+	c.routing.baseName = p.d.BaseName
+	c.routing.ugly = p.isUgly
+	n := 0
+	for _, e := range el {
+		if e != "" && e != slash {
+			el[n] = e
+			n++
+		}
+	}
+	el = el[:n]
+	p.els = append(p.els, el...)
+	if len(p.els) > 0 {
+		c.routing.filename = p.els[len(p.els)-1]
+		c.routing.link = p.els[0]
+	} else {
+		c.routing.filename = ""
+		c.routing.link = ""
+	}
+}
+
+func (c *pageCatalog) concatRouteLast(p *pagePathBuilder, s string) {
+	c.routing.kind = p.d.Kind
+	c.routing.baseName = s
+	c.routing.ugly = p.isUgly
+	if len(p.els) == 0 {
+		p.Add(s)
+		c.routing.filename = s
+		c.routing.link = s
+		return
+	}
+	old := p.els[len(p.els)-1]
+	if old == "" {
+		p.els[len(p.els)-1] = s
+		c.routing.filename = s
+		c.routing.link = s
+		return
+	}
+	if old[len(old)-1] == '/' {
+		old = old[:len(old)-1]
+	}
+	p.els[len(p.els)-1] = old + s
+	c.routing.filename = p.els[len(p.els)-1]
+	c.routing.link = p.els[0]
+}
+
+func (c *pageCatalog) routeLink(p *pagePathBuilder) string {
+	c.routing.kind = p.d.Kind
+	c.routing.baseName = p.d.BaseName
+	c.routing.ugly = p.isUgly
+	link := p.Path(p.linkUpperOffset)
+	if p.baseNameSameAsType {
+		link = strings.TrimSuffix(link, p.d.BaseName)
+	}
+	if p.prefixLink != "" {
+		link = "/" + p.prefixLink + link
+	}
+	if p.linkUpperOffset > 0 && !strings.HasSuffix(link, "/") {
+		link += "/"
+	}
+	c.routing.link = link
+	c.routing.filename = p.Last()
+	return link
+}
+
+func (c *pageCatalog) routeDir(p *pagePathBuilder) string {
+	c.routing.kind = p.d.Kind
+	c.routing.baseName = p.d.BaseName
+	c.routing.ugly = p.isUgly
+	dir := p.PathDirBase()
+	if p.prefixPath != "" {
+		dir = "/" + p.prefixPath + dir
+	}
+	c.routing.link = dir
+	c.routing.filename = dir
+	return dir
+}
+
+func (c *pageCatalog) routeFile(p *pagePathBuilder) string {
