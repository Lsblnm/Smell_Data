+
+func (c *pageCatalog) searchRelated(ctx context.Context, p Pages, opts related.SearchOpts) (Pages, error) {
+	c.relating.docCount = len(p)
+	c.relating.includeNewer = opts.Document != nil
+	if len(opts.Indices) > 0 {
+		c.relating.indexName = opts.Indices[0]
+	} else {
+		c.relating.indexName = ""
+	}
+	result, err := c.withRelatedIndex(ctx, p, func(idx *related.InvertedIndex) ([]related.Document, error) {
