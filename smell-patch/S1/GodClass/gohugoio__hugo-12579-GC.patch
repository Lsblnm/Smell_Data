+func (c *pageCatalog) collateStringLess(p Page) (less func(s1, s2 string) bool, close func()) {
+	c.collating.locked = true
+	currentSite := p.Site().Current()
+	lang := currentSite.Language()
+	c.collating.lang = lang.Lang
+	coll := langs.GetCollator2(lang)
+	coll.Lock()
+	return func(s1, s2 string) bool {
+			c.collating.cmp = coll.CompareStrings(s1, s2)
+			return c.collating.cmp < 1
+		},
+		func() {
+			coll.Unlock()
+			c.collating.locked = false
+		}
+}
