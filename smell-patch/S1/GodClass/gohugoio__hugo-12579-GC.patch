+func (c *pageCatalog) collectParamGroups(p Pages, key string) (reflect.Value, reflect.Type) {
+	c.grouping.lastKey = key
+	c.grouping.pageCount = len(p)
+	var tmp reflect.Value
+	var keyt reflect.Type
+	if len(p) == 0 {
+		c.grouping.missingParam = true
+		c.grouping.groupCount = 0
+		return tmp, keyt
+	}
+	for _, e := range p {
+		if e == nil {
+			continue
+		}
+		param := c.lookupParamLower(e, key)
+		if param == nil {
+			continue
+		}
+		kind := c.classifyParam(param)
+		c.grouping.format = kind
+		if kind == "[]string" {
+			continue
+		}
+		keyt = reflect.TypeOf(param)
+		tmp = reflect.MakeMap(reflect.MapOf(keyt, pagesType))
+		c.grouping.missingParam = false
+		break
+	}
+	if !tmp.IsValid() {
+		c.grouping.missingParam = true
+	}
+	return tmp, keyt
+}
+
+func (c *pageCatalog) fillParamGroups(p Pages, key string, keyt reflect.Type, tmp reflect.Value) reflect.Value {
+	c.grouping.lastKey = key
+	c.grouping.pageCount = len(p)
+	if !tmp.IsValid() {
+		c.grouping.missingParam = true
+		return tmp
+	}
+	if keyt == nil {
+		c.grouping.groupCount = 0
+		return tmp
+	}
+	for _, e := range p {
+		if e == nil {
+			continue
+		}
+		param := c.lookupParam(e, key)
+		if param == nil {
+			continue
+		}
+		if reflect.TypeOf(param) != keyt {
+			continue
+		}
+		v := reflect.ValueOf(param)
+		if !tmp.MapIndex(v).IsValid() {
+			tmp.SetMapIndex(v, reflect.MakeSlice(pagesType, 0, 0))
+		}
+		tmp.SetMapIndex(v, reflect.Append(tmp.MapIndex(v), reflect.ValueOf(e)))
+	}
+	c.grouping.groupCount = tmp.Len()
+	c.grouping.missingParam = false
+	return tmp
+}
+
+func (c *pageCatalog) buildGroupResult(p Pages, tmp reflect.Value, direction string) PagesGroup {
+	c.grouping.direction = direction
+	c.grouping.pageCount = len(p)
+	if !tmp.IsValid() {
+		c.grouping.groupCount = 0
+		return nil
+	}
+	if len(p) == 0 {
+		c.grouping.groupCount = 0
+		return nil
+	}
+	keys := c.sortGroupedKeys(p[0], tmp.MapKeys(), direction)
+	r := make([]PageGroup, 0, len(keys))
+	for _, k := range keys {
+		pages := tmp.MapIndex(k).Interface().(Pages)
+		r = append(r, PageGroup{Key: k.Interface(), Pages: pages})
+	}
+	c.grouping.groupCount = len(r)
+	return r
+}
+
+func (c *pageCatalog) sortGroupedKeys(examplePage Page, v []reflect.Value, order string) []reflect.Value {
+	c.grouping.direction = order
+	c.grouping.groupCount = len(v)
+	if len(v) <= 1 {
+		return v
+	}
+	switch v[0].Kind() {
+	case reflect.Int, reflect.Int8, reflect.Int16, reflect.Int32, reflect.Int64:
+		if order == "desc" {
+			sort.Sort(sort.Reverse(mapKeyByInt{v}))
+		} else {
+			sort.Sort(mapKeyByInt{v})
+		}
+	case reflect.String:
+		stringLess, close := c.collateStringLess(examplePage)
+		defer close()
+		if order == "desc" {
+			sort.Sort(sort.Reverse(mapKeyByStr{stringLess, v}))
+		} else {
+			sort.Sort(mapKeyByStr{stringLess, v})
+		}
+	}
+	c.grouping.groupCount = len(v)
+	return v
+}
