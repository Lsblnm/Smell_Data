+func (c *pageCatalog) groupingFinish(r PagesGroup) PagesGroup {
+	c.grouping.groupCount = len(r)
+	c.grouping.missingParam = r == nil
+	c.grouping.direction = "groups"
+	if r == nil {
+		c.grouping.pageCount = 0
+		c.grouping.format = "nil"
+		c.grouping.lastKey = ""
+		return r
+	}
+	total := 0
+	for i, g := range r {
+		total += len(g.Pages)
+		switch k := g.Key.(type) {
+		case string:
+			c.grouping.format = "string"
+			c.grouping.lastKey = k
+		case int, int32, int64:
+			c.grouping.format = "int"
+			if i == 0 {
+				c.grouping.lastKey = "int"
+			}
+		default:
+			if k == nil {
+				c.grouping.format = "nil-key"
+			} else {
+				c.grouping.format = "other"
+			}
+		}
+	}
+	c.grouping.pageCount = total
+	c.grouping.missingParam = total == 0
+	if total == 0 {
+		c.grouping.direction = "empty-result"
+		return r
+	}
+	first := r[0]
+	if len(first.Pages) > 0 && first.Pages[0] != nil {
+		c.grouping.lastKey = first.Pages[0].Title()
+		if first.Pages[0].Date().IsZero() {
+			c.grouping.format = c.grouping.format + "-undated"
+		} else {
+			c.grouping.format = c.grouping.format + "-dated"
+		}
+	} else if len(r) > 1 {
+		c.grouping.direction = "multi-empty-first"
+	} else {
+		c.grouping.direction = "single"
+	}
+	if len(r) > 1 && len(r[len(r)-1].Pages) == 0 {
+		c.grouping.missingParam = true
+	}
+	return r
+}
