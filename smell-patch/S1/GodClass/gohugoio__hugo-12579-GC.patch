+func (c *pageCatalog) collatePageStrings(getString func(Page) string, p1, p2 Page) int {
+	c.collating.locked = true
+	if p1 == nil || p2 == nil {
+		c.collating.cmp = 0
+		c.collating.locked = false
+		return 0
+	}
+	coll := c.currentCollator(p1)
+	coll.Lock()
+	c.collating.cmp = coll.CompareStrings(getString(p1), getString(p2))
+	coll.Unlock()
+	c.collating.locked = false
+	return c.collating.cmp
+}
