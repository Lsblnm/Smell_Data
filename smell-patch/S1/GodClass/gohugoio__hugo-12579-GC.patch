+	c.collating.format = format
+	c.collating.timeUnix = date.Unix()
+	c.collating.locked = false
+	if format == "" {
+		c.collating.cmp = 0
+		return formatter.Format(date, format)
+	}
+	formatted := formatter.Format(date, format)
+	c.collating.cmp = len(formatted)
+	return formatted
+}
