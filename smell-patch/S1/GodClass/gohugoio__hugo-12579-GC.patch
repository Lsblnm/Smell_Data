+	c.pagingTally(pagerSize, pagerSize)
+	c.pagingClassify(pagerSize, pagerSize)
+	c.pagingProbe(pagerSize, pagerSize)
+	_ = c.pagingFinish(pagerSize, pagerSize)
+	if pagerSize <= 0 {
+		c.paging.total = 0
+		c.paging.hasNext = false
+		return nil, errors.New("'paginate' configuration setting must be positive to paginate")
+	}
+	urlFactory := newPaginationURLFactory(td)
+	groups, ok, err := ToPagesGroup(seq)
+	if err != nil {
+		c.paging.total = 0
+		return nil, err
+	}
+	if ok {
+		c.paging.total = groups.Len()
+		c.paging.hasNext = groups.Len() > pagerSize
+		paginator, _ := newPaginatorFromPageGroups(groups, pagerSize, urlFactory)
+		return paginator, nil
+	}
+	pages, err := ToPages(seq)
+	if err != nil {
+		c.paging.total = 0
+		return nil, err
+	}
+	c.paging.total = len(pages)
+	c.paging.hasNext = len(pages) > pagerSize
+	paginator, _ := newPaginatorFromPages(pages, pagerSize, urlFactory)
+	return paginator, nil
