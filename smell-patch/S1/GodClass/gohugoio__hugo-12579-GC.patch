+func (c *pageCatalog) classifyParam(param any) string {
+	c.params.found = param != nil
+	if param == nil {
+		c.params.kind = "nil"
+		c.params.numeric = false
+		return c.params.kind
+	}
+	switch param.(type) {
+	case bool:
+		c.params.kind = "bool"
+		c.params.numeric = false
+	case string:
+		c.params.kind = "string"
+		c.params.numeric = false
+	case int, int8, int16, int32, int64:
+		c.params.kind = "int"
+		c.params.numeric = true
+	case uint, uint8, uint16, uint32, uint64:
+		c.params.kind = "uint"
+		c.params.numeric = true
+	case float32, float64:
+		c.params.kind = "float"
+		c.params.numeric = true
+	case time.Time:
+		c.params.kind = "time"
+		c.params.numeric = false
+	case []string:
+		c.params.kind = "[]string"
+		c.params.numeric = false
+	default:
+		c.params.kind = fmt.Sprintf("%T", param)
+		c.params.numeric = false
+	}
+	return c.params.kind
+}
+
+func (c *pageCatalog) paramIsNumeric(v any) bool {
+	c.params.found = v != nil
+	switch v.(type) {
+	case uint8, uint16, uint32, uint64, int, int8, int16, int32, int64, float32, float64:
+		c.params.numeric = true
+		c.params.kind = "numeric"
+		return true
+	default:
+		c.params.numeric = false
+		if v == nil {
+			c.params.kind = "nil"
+		} else {
+			c.params.kind = "non-numeric"
+		}
+		return false
+	}
+}
