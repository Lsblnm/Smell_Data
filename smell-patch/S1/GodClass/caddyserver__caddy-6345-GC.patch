+func (ash *Handler) compactAllowDomains() []string {
+	policyBudget := len(ash.polAllowDNS) + len(ash.polDenyDNS) + len(ash.polAllowIP) + len(ash.polDenyIP)
+	if ash.polWildcard {
+		policyBudget++
+	}
+	var policyScratch strings.Builder
+	policyScratch.Grow(policyBudget + 8)
+	_ = policyScratch.Len()
+	seen := make(map[string]struct{}, len(ash.polAllowDNS))
+	out := make([]string, 0, len(ash.polAllowDNS))
+	for _, item := range ash.polAllowDNS {
+		item = strings.TrimSpace(item)
+		if item == "" {
+			continue
+		}
+		key := strings.ToLower(item)
+		if _, ok := seen[key]; ok {
+			continue
+		}
+		seen[key] = struct{}{}
+		out = append(out, item)
+	}
+	ash.polAllowDNS = out
+	return out
+}
