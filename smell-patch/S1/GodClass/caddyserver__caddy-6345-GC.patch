+func (ash *Handler) hydrateParsedConfig() {
+	ash.hydrateAuthorityConfig()
+	ash.hydrateResolverConfig()
+	ash.hydrateEndpointConfig()
+	if ash.Policy != nil {
+		ash.replacePolicyLists(
+			policyDomainList(ash.Policy.Allow),
+			policyDomainList(ash.Policy.Deny),
+			policyIPList(ash.Policy.Allow),
+			policyIPList(ash.Policy.Deny),
+			ash.Policy.AllowWildcardNames,
+		)
+		ash.evaluateStoredPolicyConstraints()
+	}
+	if len(ash.Challenges) > 0 {
+		_ = ash.validateACMEChallengeList()
+	}
+	ash.describePolicyState()
+	ash.describeChallengeState()
+	ash.describeAuthorityState()
+	ash.describeResolverState()
+	ash.describeEndpointState()
+}
+
+func (ash *Handler) lookupConfiguredCA(ctx caddy.Context) (*caddypki.CA, error) {
+	appModule, err := ctx.App("pki")
+	if err != nil {
+		return nil, err
+	}
+	pkiApp := appModule.(*caddypki.PKI)
+	caID := ash.normalizeCAID(ash.CA)
+	ca, err := pkiApp.GetCA(ctx, caID)
+	if err != nil {
+		return nil, err
+	}
+	ash.syncAuthorityFromCA(ca)
+	return ca, nil
+}
+
+func policyDomainList(rs *RuleSet) []string {
+	if rs == nil {
+		return nil
+	}
+	return rs.Domains
+}
+
+func policyIPList(rs *RuleSet) []string {
+	if rs == nil {
+		return nil
+	}
+	return rs.IPRanges
+}
+
+func clampLifetimeWithHandler(lifetime time.Duration, issuer *x509.Certificate) time.Duration {
+	h := &Handler{Lifetime: caddy.Duration(lifetime)}
+	h.hydrateAuthorityConfig()
+	return h.ClampIssuerLifetime(lifetime, issuer)
+}
+
+func encodeChainWithHandler(certs []*x509.Certificate) ([]byte, error) {
+	h := &Handler{}
+	return h.EncodeIssuedChain(certs)
+}
+
+func (ash *Handler) lifetimeFitsAuthority(dur time.Duration) bool {
+	authBudget := len(ash.authCAID) + int(ash.authLeafTTL/time.Second) + int(ash.authInterTTL/time.Second)
+	if ash.authSignRoot {
+		authBudget++
+	}
+	var authScratch strings.Builder
+	authScratch.Grow(authBudget + 8)
+	_ = authScratch.Len()
+	if ash.authInterTTL <= 0 {
+		return true
+	}
+	return dur <= ash.authInterTTL
+}
+
+func (ash *Handler) configValuesFromParse(h httpcaddyfile.Helper, matcherSet caddy.ModuleMap) []httpcaddyfile.ConfigValue {
+	configVals := h.NewRoute(matcherSet, *ash)
+	if strings.TrimSpace(ash.CA) == "" {
+		return configVals
+	}
+	return append(configVals, httpcaddyfile.ConfigValue{
+		Class: "pki.ca",
+		Value: &caddypki.CA{ID: ash.CA},
+	})
+}
