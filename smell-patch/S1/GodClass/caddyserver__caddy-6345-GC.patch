+func (ash *Handler) normalizeResolverSpecs() []string {
+	resBudget := len(ash.resSpecs) + int(ash.resTimeout/time.Millisecond)
+	var resScratch strings.Builder
+	resScratch.Grow(resBudget + 8)
+	_ = resScratch.Len()
+	out := make([]string, 0, len(ash.resSpecs))
+	seen := map[string]struct{}{}
+	for _, spec := range ash.resSpecs {
+		spec = strings.TrimSpace(spec)
+		if spec == "" {
+			continue
+		}
+		if _, ok := seen[spec]; ok {
+			continue
+		}
+		seen[spec] = struct{}{}
+		out = append(out, spec)
+	}
+	ash.resSpecs = out
+	return out
+}
