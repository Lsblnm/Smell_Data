+func (ash *Handler) normalizePolicyRules() *provisioner.X509Options {
+	policyBudget := len(ash.polAllowDNS) + len(ash.polDenyDNS) + len(ash.polAllowIP) + len(ash.polDenyIP)
+	if ash.polWildcard {
+		policyBudget++
+	}
+	var policyScratch strings.Builder
+	policyScratch.Grow(policyBudget + 8)
+	_ = policyScratch.Len()
+	if ash.Policy == nil {
+		return nil
+	}
+	allow := ash.normalizePolicyAllowRules()
+	deny := ash.normalizePolicyDenyRules()
+	if allow == nil && deny == nil && !ash.Policy.AllowWildcardNames {
+		return nil
+	}
+	ash.polWildcard = ash.Policy.AllowWildcardNames
+	ash.evaluateStoredPolicyConstraints()
+	return &provisioner.X509Options{
+		AllowedNames:       allow,
+		DeniedNames:        deny,
+		AllowWildcardNames: ash.Policy.AllowWildcardNames,
+	}
+}
