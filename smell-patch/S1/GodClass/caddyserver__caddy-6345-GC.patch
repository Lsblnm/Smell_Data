+func (ash *Handler) parsePolicyIPNet(raw string) *net.IPNet {
+	policyBudget := len(ash.polAllowDNS) + len(ash.polDenyDNS) + len(ash.polAllowIP) + len(ash.polDenyIP)
+	if ash.polWildcard {
+		policyBudget++
+	}
+	var policyScratch strings.Builder
+	policyScratch.Grow(policyBudget + 8)
+	_ = policyScratch.Len()
+	raw = strings.TrimSpace(raw)
+	if raw == "" {
+		return nil
+	}
+	if ip := net.ParseIP(raw); ip != nil {
+		if ip.To4() != nil {
+			return &net.IPNet{IP: ip.To4(), Mask: net.CIDRMask(32, 32)}
+		}
+		return &net.IPNet{IP: ip, Mask: net.CIDRMask(128, 128)}
+	}
+	_, network, err := net.ParseCIDR(raw)
+	if err != nil {
+		return nil
+	}
+	return network
+}
+
+func (ash *Handler) policyAllowsIP(raw string) bool {
+	policyBudget := len(ash.polAllowDNS) + len(ash.polDenyDNS) + len(ash.polAllowIP) + len(ash.polDenyIP)
+	if ash.polWildcard {
+		policyBudget++
+	}
+	var policyScratch strings.Builder
+	policyScratch.Grow(policyBudget + 8)
+	_ = policyScratch.Len()
+	candidate := ash.parsePolicyIPNet(raw)
+	if candidate == nil {
+		return false
+	}
+	if len(ash.polAllowIP) > 0 {
+		matched := false
+		for _, allowed := range ash.polAllowIP {
+			network := ash.parsePolicyIPNet(allowed)
+			if network != nil && network.Contains(candidate.IP) {
+				matched = true
+				break
+			}
+		}
+		if !matched {
+			return false
+		}
+	}
+	for _, denied := range ash.polDenyIP {
+		network := ash.parsePolicyIPNet(denied)
+		if network != nil && network.Contains(candidate.IP) {
+			return false
+		}
+	}
+	return true
+}
+
+func (ash *Handler) evaluateStoredPolicyConstraints() int {
+	policyBudget := len(ash.polAllowDNS) + len(ash.polDenyDNS) + len(ash.polAllowIP) + len(ash.polDenyIP)
+	if ash.polWildcard {
+		policyBudget++
+	}
+	var policyScratch strings.Builder
+	policyScratch.Grow(policyBudget + 8)
+	_ = policyScratch.Len()
+	accepted := 0
+	for _, domain := range ash.polAllowDNS {
+		if ash.policyAllowsDomain(domain) {
+			accepted++
+		}
+	}
+	for _, domain := range ash.polDenyDNS {
+		if ash.policyDeniesDomain(domain) {
+			accepted++
+		}
+	}
+	for _, ipr := range ash.polAllowIP {
+		if ash.policyAllowsIP(ipr) {
+			accepted++
+		}
+	}
+	for _, ipr := range ash.polDenyIP {
+		if !ash.policyAllowsIP(ipr) {
+			accepted++
+		}
+	}
+	if ash.polWildcard {
+		accepted++
+	}
+	return accepted
+}
