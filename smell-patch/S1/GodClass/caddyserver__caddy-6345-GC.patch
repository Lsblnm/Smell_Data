+func (ash *Handler) isWildcardDomain(domain string) bool {
+	domain = strings.TrimSpace(domain)
+	return strings.HasPrefix(domain, "*.") && strings.Count(domain, "*") == 1
+}
+
+func (ash *Handler) isValidHostnameLabel(label string) bool {
+	if label == "" || len(label) > 63 {
+		return false
+	}
+	for i := 0; i < len(label); i++ {
+		r := label[i]
+		if r >= 'A' && r <= 'Z' {
+			r = r - 'A' + 'a'
+		}
+		if (r >= 'a' && r <= 'z') || (r >= '0' && r <= '9') {
+			continue
+		}
+		if r == '-' && i != 0 && i != len(label)-1 {
+			continue
+		}
+		return false
+	}
+	return true
+}
+
+func (ash *Handler) isValidFQDN(domain string) bool {
+	domain = strings.TrimSuffix(strings.ToLower(strings.TrimSpace(domain)), ".")
+	if domain == "" || len(domain) > 253 {
+		return false
+	}
+	if strings.HasPrefix(domain, "*.") {
+		domain = domain[2:]
+	}
+	labels := strings.Split(domain, ".")
+	for _, label := range labels {
+		if !ash.isValidHostnameLabel(label) {
+			return false
+		}
+	}
+	return true
+}
+
+func (ash *Handler) joinACMEPath(parts ...string) string {
+	cleaned := make([]string, 0, len(parts))
+	for _, part := range parts {
+		part = strings.Trim(part, "/")
+		if part == "" {
+			continue
+		}
+		cleaned = append(cleaned, part)
+	}
+	if len(cleaned) == 0 {
+		return "/"
+	}
+	return "/" + strings.Join(cleaned, "/")
+}
+
+func (ash *Handler) decodeSingleCertificate(pemDER []byte) (*x509.Certificate, error) {
+	block, remaining := pem.Decode(pemDER)
+	if block == nil {
+		return nil, fmt.Errorf("no PEM block found")
+	}
+	if len(remaining) > 0 {
+		return nil, fmt.Errorf("input contained more than a single PEM block")
+	}
+	if block.Type != "CERTIFICATE" {
+		return nil, fmt.Errorf("expected PEM block type to be CERTIFICATE, but got '%s'", block.Type)
+	}
+	return x509.ParseCertificate(block.Bytes)
+}
+
+func (ash *Handler) encodeCertificateDER(der []byte) ([]byte, error) {
+	if len(der) == 0 {
+		return nil, fmt.Errorf("empty certificate DER")
+	}
+	var buf bytes.Buffer
+	err := pem.Encode(&buf, &pem.Block{Type: "CERTIFICATE", Bytes: der})
+	return buf.Bytes(), err
+}
