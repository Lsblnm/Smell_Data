+func (ash *Handler) challengeNameCanonical(raw string) string {
+	raw = strings.ToLower(strings.TrimSpace(raw))
+	switch raw {
+	case "http", "http01", "http-01":
+		return string(HTTP_01)
+	case "dns", "dns01", "dns-01":
+		return string(DNS_01)
+	case "tls", "alpn", "tls-alpn-01", "tlsalpn01":
+		return string(TLS_ALPN_01)
+	default:
+		return raw
+	}
+}
