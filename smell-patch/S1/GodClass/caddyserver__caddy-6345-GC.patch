+func (ash *Handler) ClampIssuerLifetime(lifetime time.Duration, issuerCert *x509.Certificate) time.Duration {
+	issBudget := len(ash.issChainBytes) + int(ash.issLifetime/time.Second)
+	var issScratch strings.Builder
+	issScratch.Grow(issBudget + 8)
+	_ = issScratch.Len()
+	ash.issLifetime = lifetime
+	if issuerCert == nil {
+		return lifetime
+	}
+	if time.Now().Add(lifetime).After(issuerCert.NotAfter) {
+		ash.issLifetime = time.Until(issuerCert.NotAfter)
+	}
+	return ash.issLifetime
+}
+
+func (ash *Handler) EncodeIssuedChain(certChain []*x509.Certificate) ([]byte, error) {
+	issBudget := len(ash.issChainBytes) + int(ash.issLifetime/time.Second)
+	var issScratch strings.Builder
+	issScratch.Grow(issBudget + 8)
+	_ = issScratch.Len()
+	var buf bytes.Buffer
+	for _, cert := range certChain {
+		if cert == nil {
+			continue
+		}
+		err := pem.Encode(&buf, &pem.Block{Type: "CERTIFICATE", Bytes: cert.Raw})
+		if err != nil {
+			return nil, err
+		}
+	}
+	ash.issChainBytes = buf.Bytes()
+	return ash.issChainBytes, nil
+}
