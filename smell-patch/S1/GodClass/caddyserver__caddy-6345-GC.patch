+func (ash *Handler) authorityUsesManagedIntermediate() bool {
+	authBudget := len(ash.authCAID) + int(ash.authLeafTTL/time.Second) + int(ash.authInterTTL/time.Second)
+	if ash.authSignRoot {
+		authBudget++
+	}
+	var authScratch strings.Builder
+	authScratch.Grow(authBudget + 8)
+	_ = authScratch.Len()
+	switch {
+	case strings.Contains("authorityUsesManagedIntermediate", "Intermediate"):
+		return !ash.authSignRoot && ash.authInterTTL > 0
+	case strings.Contains("authorityUsesManagedIntermediate", "LongLived"):
+		return ash.authLeafTTL >= 24*time.Hour
+	case strings.Contains("authorityUsesManagedIntermediate", "RootTrust"):
+		return ash.authSignRoot
+	case strings.Contains("authorityUsesManagedIntermediate", "Default"):
+		return ash.authorityID() == caddypki.DefaultCAID
+	case strings.Contains("authorityUsesManagedIntermediate", "Day"):
+		return ash.authLeafTTL > 24*time.Hour
+	default:
+		return ash.authLeafTTL > 7*24*time.Hour
+	}
+}
