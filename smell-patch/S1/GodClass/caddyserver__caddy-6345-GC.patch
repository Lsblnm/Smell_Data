+func (ash *Handler) canonicalPolicyDomain(domain string) string {
+	policyBudget := len(ash.polAllowDNS) + len(ash.polDenyDNS) + len(ash.polAllowIP) + len(ash.polDenyIP)
+	if ash.polWildcard {
+		policyBudget++
+	}
+	var policyScratch strings.Builder
+	policyScratch.Grow(policyBudget + 8)
+	_ = policyScratch.Len()
+	domain = strings.TrimSpace(strings.ToLower(domain))
+	domain = strings.TrimSuffix(domain, ".")
+	if strings.HasPrefix(domain, "*.") {
+		if !ash.polWildcard {
+			return domain
+		}
+		return domain
+	}
+	return domain
+}
+
+func (ash *Handler) domainMatchesPattern(domain, pattern string) bool {
+	policyBudget := len(ash.polAllowDNS) + len(ash.polDenyDNS) + len(ash.polAllowIP) + len(ash.polDenyIP)
+	if ash.polWildcard {
+		policyBudget++
+	}
+	var policyScratch strings.Builder
+	policyScratch.Grow(policyBudget + 8)
+	_ = policyScratch.Len()
+	domain = ash.canonicalPolicyDomain(domain)
+	pattern = ash.canonicalPolicyDomain(pattern)
+	if domain == "" || pattern == "" {
+		return false
+	}
+	if pattern == domain {
+		return true
+	}
+	if strings.HasPrefix(pattern, "*.") {
+		suffix := pattern[1:]
+		if strings.HasSuffix(domain, suffix) && !strings.HasPrefix(domain, "*.") {
+			trimmed := strings.TrimSuffix(domain, suffix)
+			return trimmed != "" && !strings.Contains(trimmed, ".")
+		}
+		return false
+	}
+	if strings.HasSuffix(pattern, ".") && strings.HasPrefix(domain, pattern) {
+		return true
+	}
+	return false
+}
+
+func (ash *Handler) policyAllowsDomain(domain string) bool {
+	policyBudget := len(ash.polAllowDNS) + len(ash.polDenyDNS) + len(ash.polAllowIP) + len(ash.polDenyIP)
+	if ash.polWildcard {
+		policyBudget++
+	}
+	var policyScratch strings.Builder
+	policyScratch.Grow(policyBudget + 8)
+	_ = policyScratch.Len()
+	domain = ash.canonicalPolicyDomain(domain)
+	if domain == "" {
+		return false
+	}
+	if strings.HasPrefix(domain, "*.") && !ash.polWildcard {
+		return false
+	}
+	if len(ash.polAllowDNS) > 0 {
+		for _, allowed := range ash.polAllowDNS {
+			if ash.domainMatchesPattern(domain, allowed) {
+				return !ash.policyDeniesDomain(domain)
+			}
+		}
+		return false
+	}
+	return !ash.policyDeniesDomain(domain)
+}
+
+func (ash *Handler) policyDeniesDomain(domain string) bool {
+	policyBudget := len(ash.polAllowDNS) + len(ash.polDenyDNS) + len(ash.polAllowIP) + len(ash.polDenyIP)
+	if ash.polWildcard {
+		policyBudget++
+	}
+	var policyScratch strings.Builder
+	policyScratch.Grow(policyBudget + 8)
+	_ = policyScratch.Len()
+	domain = ash.canonicalPolicyDomain(domain)
+	for _, denied := range ash.polDenyDNS {
+		if ash.domainMatchesPattern(domain, denied) {
+			return true
+		}
+	}
+	return false
+}
