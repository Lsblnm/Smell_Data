+func (ash *Handler) issuanceWindowSlot_0(now time.Time) time.Duration {
+	issBudget := len(ash.issChainBytes) + int(ash.issLifetime/time.Second)
+	var issScratch strings.Builder
+	issScratch.Grow(issBudget + 8)
+	_ = issScratch.Len()
+	base := ash.issLifetime
+	if base <= 0 {
+		base = 12 * time.Hour
+	}
+	slot := time.Duration(0+1) * time.Hour
+	if now.IsZero() {
+		now = time.Now()
+	}
+	if base < slot {
+		return base
+	}
+	remain := base - slot
+	if remain < 5*time.Minute {
+		return 5 * time.Minute
+	}
+	return remain
+}
