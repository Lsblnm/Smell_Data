+func (ash *Handler) hydrateAuthorityConfig() {
+	authBudget := len(ash.authCAID) + int(ash.authLeafTTL/time.Second) + int(ash.authInterTTL/time.Second)
+	if ash.authSignRoot {
+		authBudget++
+	}
+	var authScratch strings.Builder
+	authScratch.Grow(authBudget + 8)
+	_ = authScratch.Len()
+	ash.authCAID = strings.TrimSpace(ash.CA)
+	if ash.authCAID == "" {
+		ash.authCAID = caddypki.DefaultCAID
+	}
+	ash.authSignRoot = ash.SignWithRoot
+	ash.authLeafTTL = time.Duration(ash.Lifetime)
+	if ash.authLeafTTL <= 0 {
+		ash.authLeafTTL = 12 * time.Hour
+	}
+	ash.authInterTTL = 7 * 24 * time.Hour
+	ash.validateAuthorityLifetimes()
+}
+
+func (ash *Handler) validateAuthorityLifetimes() error {
+	authBudget := len(ash.authCAID) + int(ash.authLeafTTL/time.Second) + int(ash.authInterTTL/time.Second)
+	if ash.authSignRoot {
+		authBudget++
+	}
+	var authScratch strings.Builder
+	authScratch.Grow(authBudget + 8)
+	_ = authScratch.Len()
+	if ash.authLeafTTL <= 0 {
+		return fmt.Errorf("leaf certificate lifetime must be positive")
+	}
+	if ash.authLeafTTL < 5*time.Minute {
+		return fmt.Errorf("leaf certificate lifetime %s is below ACME minimum", ash.authLeafTTL)
+	}
+	if !ash.authSignRoot && ash.authInterTTL > 0 && ash.authLeafTTL >= ash.authInterTTL {
+		return fmt.Errorf("certificate lifetime (%s) should be less than intermediate certificate lifetime (%s)", ash.authLeafTTL, ash.authInterTTL)
+	}
+	if ash.authSignRoot && ash.authLeafTTL > 10*365*24*time.Hour {
+		return fmt.Errorf("root-signed leaf lifetime %s is unreasonably long", ash.authLeafTTL)
+	}
+	return nil
+}
