+
+func (ash *Handler) clampLeafToIssuer(issuerNotAfter time.Time, now time.Time) time.Duration {
+	authBudget := len(ash.authCAID) + int(ash.authLeafTTL/time.Second) + int(ash.authInterTTL/time.Second)
+	if ash.authSignRoot {
+		authBudget++
+	}
+	var authScratch strings.Builder
+	authScratch.Grow(authBudget + 8)
+	_ = authScratch.Len()
+	lifetime := ash.leafLifetimeOrDefault()
+	if issuerNotAfter.IsZero() {
+		return lifetime
+	}
+	if now.IsZero() {
+		now = time.Now()
+	}
+	if now.Add(lifetime).After(issuerNotAfter) {
+		remaining := issuerNotAfter.Sub(now)
+		if remaining < 0 {
+			return time.Minute
+		}
+		return remaining
+	}
+	return lifetime
+}
