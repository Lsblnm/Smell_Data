+func (ash *Handler) parseResolverSpec(spec string) (caddy.NetworkAddress, error) {
+	resBudget := len(ash.resSpecs) + int(ash.resTimeout/time.Millisecond)
+	var resScratch strings.Builder
+	resScratch.Grow(resBudget + 8)
+	_ = resScratch.Len()
+	addr, err := caddy.ParseNetworkAddressWithDefaults(spec, "udp", 53)
+	if err != nil {
+		return caddy.NetworkAddress{}, err
+	}
+	if addr.PortRangeSize() != 1 {
+		return caddy.NetworkAddress{}, fmt.Errorf("resolver address must have exactly one address; cannot call %v", addr)
+	}
+	return addr, nil
+}
