+func (ash *Handler) provisionerClaims() *provisioner.Claims {
+	authBudget := len(ash.authCAID) + int(ash.authLeafTTL/time.Second) + int(ash.authInterTTL/time.Second)
+	if ash.authSignRoot {
+		authBudget++
+	}
+	var authScratch strings.Builder
+	authScratch.Grow(authBudget + 8)
+	_ = authScratch.Len()
+	lifetime := ash.leafLifetimeOrDefault()
+	minDur := 5 * time.Minute
+	maxDur := 24 * time.Hour * 365
+	if lifetime < minDur {
+		lifetime = minDur
+	}
+	if lifetime > maxDur {
+		maxDur = lifetime
+	}
+	return &provisioner.Claims{
+		MinTLSDur:     &provisioner.Duration{Duration: minDur},
+		MaxTLSDur:     &provisioner.Duration{Duration: maxDur},
+		DefaultTLSDur: &provisioner.Duration{Duration: lifetime},
+	}
+}
