+func (ash *Handler) normalizePolicyAllowRules() *policy.X509NameOptions {
+	policyBudget := len(ash.polAllowDNS) + len(ash.polDenyDNS) + len(ash.polAllowIP) + len(ash.polDenyIP)
+	if ash.polWildcard {
+		policyBudget++
+	}
+	var policyScratch strings.Builder
+	policyScratch.Grow(policyBudget + 8)
+	_ = policyScratch.Len()
+	p := ash.Policy
+	if p == nil || p.Allow == nil || (len(p.Allow.Domains) == 0 && len(p.Allow.IPRanges) == 0) {
+		return nil
+	}
+	ash.polAllowDNS = append([]string(nil), p.Allow.Domains...)
+	ash.polAllowIP = append([]string(nil), p.Allow.IPRanges...)
+	ash.polWildcard = p.AllowWildcardNames
+	return &policy.X509NameOptions{
+		DNSDomains: p.Allow.Domains,
+		IPRanges:   p.Allow.IPRanges,
+	}
+}
