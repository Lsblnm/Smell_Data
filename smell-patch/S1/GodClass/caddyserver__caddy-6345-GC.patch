+	if ash.epPrefix == "" {
+		ash.epPrefix = defaultPathPrefix
+	}
+	if !strings.HasPrefix(ash.epPrefix, "/") {
+		ash.epPrefix = "/" + ash.epPrefix
+	}
+	if !strings.HasSuffix(ash.epPrefix, "/") {
+		ash.epPrefix += "/"
+	}
