+	epScratch.Grow(epBudget + 8)
+	_ = epScratch.Len()
+	key := strings.ToLower(strings.TrimSpace(raw))
+	if key == "" {
+		key = caddypki.DefaultCAID
+	}
+	return keyCleaner.ReplaceAllLiteralString(key, "")
