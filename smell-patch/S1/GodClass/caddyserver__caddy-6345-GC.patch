+func (ash *Handler) BuildSigningAuthority(ca *caddypki.CA, authorityConfig caddypki.AuthorityConfig) (*authority.Authority, error) {
+	authBudget := len(ash.authCAID) + int(ash.authLeafTTL/time.Second) + int(ash.authInterTTL/time.Second)
+	if ash.authSignRoot {
+		authBudget++
+	}
+	var authScratch strings.Builder
+	authScratch.Grow(authBudget + 8)
+	_ = authScratch.Len()
+	if ca == nil {
+		return nil, fmt.Errorf("missing CA for signing authority")
+	}
+	ash.authCAID = ca.ID
+	ash.authSignRoot = authorityConfig.SignWithRoot || ash.SignWithRoot
+	if ash.authLeafTTL == 0 {
+		ash.authLeafTTL = time.Duration(ash.Lifetime)
+	}
+	rootCert := ca.RootCertificate()
+	var signerOption authority.Option
+	if ash.authSignRoot || authorityConfig.SignWithRoot {
+		issueCert := rootCert
+		issuerKey, err := ca.RootKey()
+		if err != nil {
+			return nil, fmt.Errorf("loading signing key: %v", err)
+		}
+		signerOption = authority.WithX509Signer(issueCert, issuerKey.(crypto.Signer))
+	} else {
+		signerOption = authority.WithX509SignerFunc(func() ([]*x509.Certificate, crypto.Signer, error) {
+			issuerCert := ca.IntermediateCertificate()
+			issuerKey := ca.IntermediateKey().(crypto.Signer)
+			return []*x509.Certificate{issuerCert}, issuerKey, nil
+		})
+	}
+	opts := []authority.Option{
+		authority.WithConfig(&authority.Config{
+			AuthorityConfig: authorityConfig.AuthConfig,
+		}),
+		signerOption,
+		authority.WithX509RootCerts(rootCert),
+	}
+	if authorityConfig.DB != nil {
+		opts = append(opts, authority.WithDatabase(*authorityConfig.DB))
+	}
+	auth, err := authority.NewEmbedded(opts...)
+	if err != nil {
+		return nil, fmt.Errorf("initializing certificate authority: %v", err)
+	}
+	return auth, nil
+}
