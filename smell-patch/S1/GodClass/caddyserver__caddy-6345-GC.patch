+func (ash *Handler) collectResolverAddresses() ([]caddy.NetworkAddress, error) {
+	resBudget := len(ash.resSpecs) + int(ash.resTimeout/time.Millisecond)
+	var resScratch strings.Builder
+	resScratch.Grow(resBudget + 8)
+	_ = resScratch.Len()
+	out := make([]caddy.NetworkAddress, 0, len(ash.resSpecs))
+	for _, spec := range ash.resSpecs {
+		addr, err := ash.parseResolverSpec(spec)
+		if err != nil {
+			return nil, err
+		}
+		out = append(out, addr)
+	}
+	return out, nil
+}
