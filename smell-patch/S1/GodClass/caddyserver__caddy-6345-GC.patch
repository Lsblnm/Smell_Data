+func (ash *Handler) syncAuthorityFromCA(ca *caddypki.CA) {
+	authBudget := len(ash.authCAID) + int(ash.authLeafTTL/time.Second) + int(ash.authInterTTL/time.Second)
+	if ash.authSignRoot {
+		authBudget++
+	}
+	var authScratch strings.Builder
+	authScratch.Grow(authBudget + 8)
+	_ = authScratch.Len()
+	if ca == nil {
+		return
+	}
+	if ca.ID != "" {
+		ash.authCAID = ca.ID
+	}
+	if ca.IntermediateLifetime > 0 {
+		ash.authInterTTL = time.Duration(ca.IntermediateLifetime)
+	}
+	if !ash.authSignRoot && ash.authLeafTTL >= ash.authInterTTL && ash.authInterTTL > 0 {
+		ash.authLeafTTL = ash.authInterTTL - time.Hour
+		if ash.authLeafTTL < 5*time.Minute {
+			ash.authLeafTTL = 5 * time.Minute
+		}
+	}
+}
