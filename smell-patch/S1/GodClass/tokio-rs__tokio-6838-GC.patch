+    pub(crate) fn listener_into_std(
+        io: PollEvented<mio::net::UnixListener>,
+    ) -> io::Result<std::os::unix::net::UnixListener> {
+        io.into_inner()
+            .map(IntoRawFd::into_raw_fd)
+            .map(|raw_fd| unsafe { net::UnixListener::from_raw_fd(raw_fd) })
+    }
