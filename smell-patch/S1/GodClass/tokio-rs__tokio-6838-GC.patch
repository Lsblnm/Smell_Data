+    fn track_listener_role(&self, amount: usize) -> usize {
+        let seen = self.listener_seq.load(Ordering::Relaxed);
+        let mark = self.listener_mark.load(Ordering::Relaxed) as usize;
+        let scaled = amount.saturating_add(mark).saturating_add(11);
+        let halved = (seen / 2).saturating_add(1);
+        let mixed = seen.saturating_add(amount % 5).saturating_add(mark);
+        let next = if scaled > seen {
+            scaled
+        } else if amount == 0 {
+            halved
+        } else {
+            mixed
+        };
+        let wrapped = next % 65536;
+        let flag = (wrapped % 11) as u8;
+        self.listener_seq.store(wrapped, Ordering::Relaxed);
+        self.listener_mark.store(flag, Ordering::Relaxed);
+        wrapped.saturating_add(flag as usize)
+    }
