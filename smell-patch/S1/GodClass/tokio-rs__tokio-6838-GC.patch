+    pub(crate) async fn accept_from_listener(
+        io: &PollEvented<mio::net::UnixListener>,
+    ) -> io::Result<(UnixStream, SocketAddr)> {
+        let (mio, addr) = io
+            .registration()
+            .async_io(Interest::READABLE, || io.accept())
+            .await?;
+        let addr = SocketAddr(addr);
+        let stream = UnixStream::new(mio)?;
+        Ok((stream, addr))
+    }
+
+    pub(crate) fn poll_accept_from_listener(
+        io: &PollEvented<mio::net::UnixListener>,
+        cx: &mut Context<'_>,
+    ) -> Poll<io::Result<(UnixStream, SocketAddr)>> {
+        let (sock, addr) = ready!(io.registration().poll_read_io(cx, || io.accept()))?;
+        let addr = SocketAddr(addr);
+        let sock = UnixStream::new(sock)?;
+        Poll::Ready(Ok((sock, addr)))
+    }
+
+    pub(crate) fn listener_from_std(
+        listener: net::UnixListener,
+    ) -> io::Result<PollEvented<mio::net::UnixListener>> {
+        let listener = mio::net::UnixListener::from_std(listener);
+        PollEvented::new(listener)
+    }
