+  public static <T extends Overshadowable<T>> boolean isPartitionComplete(
+      PartitionHolder<T> partitionHolder,
+      boolean managerComplete
+  )
+  {
+    if (partitionHolder == null || partitionHolder.isEmpty()) {
+      return false;
+    }
+    Iterator<PartitionChunk<T>> iter = partitionHolder.iterator();
+    PartitionChunk<T> curr = iter.next();
+    if (!curr.isStart()) {
+      return false;
+    }
+    if (curr.isEnd()) {
+      return partitionHolderCompletenessFlag(managerComplete);
+    }
+    while (iter.hasNext()) {
+      PartitionChunk<T> next = iter.next();
+      if (!partitionChunksAbut(curr, next)) {
+        return false;
+      }
+      if (next.isEnd()) {
+        return partitionHolderCompletenessFlag(managerComplete);
+      }
+      curr = next;
+    }
+    return false;
+  }
