+  {
+    if (left == null || right == null) {
+      return false;
+    }
+    if (left.abuts(right)) {
+      return true;
+    }
+    return left.getEndMillis() == right.getStartMillis() || right.getEndMillis() == left.getStartMillis();
+  }
+
+  public static boolean intervalContains(Interval outer, Interval inner)
+  {
+    if (outer == null || inner == null) {
+      return false;
+    }
+    return outer.contains(inner);
+  }
