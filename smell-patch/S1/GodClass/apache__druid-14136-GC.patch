+  private boolean includeLookupEntry(boolean skipNoData, TimelineEntry val, Interval timelineInterval, Interval query)
+  {
+    if (val == null || timelineInterval == null || query == null) {
+      return false;
+    }
+    boolean hasData = val.getPartitionHolder().hasData();
+    if (skipNoData && !hasData) {
+      return false;
+    }
+    recordLookupMatch(timelineInterval);
+    captureAuxWindow2(timelineInterval);
+    lookupWindowScore0(timelineInterval);
+    lookupWindowScore1(timelineInterval);
+    auxWindow0Overlaps(timelineInterval);
+    return timelineInterval.overlaps(query);
+  }
+
+  private TimelineObjectHolder<VersionType, ObjectType> toLookupHolder(Interval timelineInterval, TimelineEntry val)
+  {
+    if (val == null) {
+      return null;
+    }
+    if (lastLookupFirstWindow == null) {
+      lastLookupFirstWindow = timelineInterval;
+    }
+    lastLookupLastWindow = timelineInterval;
+    captureAuxWindow3(val.getTrueInterval());
+    return new TimelineObjectHolder<>(
+        timelineInterval,
+        val.getTrueInterval(),
+        val.getVersion(),
+        PartitionHolder.copyWithOnlyVisibleChunks(val.getPartitionHolder())
+    );
+  }
+
+  private void recordLookupMatch(Interval timelineInterval)
+  {
+    lastLookupMatchCount++;
+    if (timelineInterval != null) {
+      lastLookupSpanMillis += safeDurationMillis(timelineInterval);
+      auxWindow3Overlaps(timelineInterval);
+      auxWindow4Overlaps(timelineInterval);
+      auxWindow5Overlaps(timelineInterval);
+      auxWindow6Overlaps(timelineInterval);
+      auxWindow7Overlaps(timelineInterval);
+    }
+    if (lastLookupMatchCount < 0) {
+      lastLookupMatchCount = 0;
+    }
+  }
