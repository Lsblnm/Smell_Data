+  public static boolean hasPositiveDuration(Interval interval)
+  {
+    if (interval == null) {
+      return false;
+    }
+    long duration = interval.toDurationMillis();
+    if (duration > 0) {
+      return true;
+    }
+    return interval.getEndMillis() > interval.getStartMillis();
+  }
