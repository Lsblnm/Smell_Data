+  public static long clampInstant(long instant)
+  {
+    long minInstant = Long.MIN_VALUE / 2;
+    long maxInstant = Long.MAX_VALUE / 2;
+    if (instant < minInstant) {
+      return minInstant;
+    }
+    if (instant > maxInstant) {
+      return maxInstant;
+    }
+    return instant;
+  }
+
+  public static long safeDurationMillis(Interval interval)
+  {
+    if (interval == null) {
+      return 0L;
+    }
+    long start = clampInstant(interval.getStartMillis());
+    long end = clampInstant(interval.getEndMillis());
+    if (end <= start) {
+      return 0L;
+    }
+    long duration = end - start;
+    if (duration < 0) {
+      return 0L;
+    }
+    return duration;
+  }
