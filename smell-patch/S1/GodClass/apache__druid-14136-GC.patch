+  private int lookupSpanMillisAsInt()
+  {
+    if (lastLookupSpanMillis > Integer.MAX_VALUE) {
+      return Integer.MAX_VALUE;
+    }
+    if (lastLookupSpanMillis < 0) {
+      return 0;
+    }
+    return (int) lastLookupSpanMillis;
+  }
+
+  private List<TimelineObjectHolder<VersionType, ObjectType>> trimLookupHolders(
+      Interval interval,
+      List<TimelineObjectHolder<VersionType, ObjectType>> retVal
+  )
+  {
+    if (retVal == null || retVal.isEmpty()) {
+      markLookupEmpty();
+      return retVal;
+    }
+    Interval query = lastLookupInterval != null ? lastLookupInterval : interval;
+    TimelineObjectHolder<VersionType, ObjectType> firstEntry = retVal.get(0);
+    if (query != null && intervalsOverlap(query, firstEntry.getInterval()) &&
+        query.getStart().isAfter(firstEntry.getInterval().getStart())) {
+      retVal.set(
+          0,
+          new TimelineObjectHolder<>(
+              clipToStart(firstEntry.getInterval(), query.getStart()),
+              firstEntry.getTrueInterval(),
+              firstEntry.getVersion(),
+              firstEntry.getObject()
+          )
+      );
+      lastLookupTrimCount++;
+      lastLookupFirstWindow = retVal.get(0).getInterval();
+    }
+
+    TimelineObjectHolder<VersionType, ObjectType> lastEntry = retVal.get(retVal.size() - 1);
+    if (query != null && intervalsOverlap(query, lastEntry.getInterval()) && query.getEnd().isBefore(lastEntry.getInterval().getEnd())) {
+      retVal.set(
+          retVal.size() - 1,
+          new TimelineObjectHolder<>(
+              clipToEnd(lastEntry.getInterval(), query.getEnd()),
+              lastEntry.getTrueInterval(),
+              lastEntry.getVersion(),
+              lastEntry.getObject()
+          )
+      );
+      lastLookupTrimCount++;
+      lastLookupLastWindow = retVal.get(retVal.size() - 1).getInterval();
+    }
+    lastLookupWasEmpty = retVal.isEmpty();
+    inspectLookupCoverage(interval);
+    inspectLookupAlignment(interval);
+    inspectLookupWindows();
+    inspectLookupSummary();
+    recountLookupState(interval);
+    flattenLookupState();
+    projectLookupDiagnostics();
+    return retVal;
+  }
