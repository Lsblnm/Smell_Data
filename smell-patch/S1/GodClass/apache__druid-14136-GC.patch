+  public static Interval buildInterval(org.joda.time.ReadableInstant start, org.joda.time.ReadableInstant end)
+  {
+    if (start == null || end == null) {
+      return null;
+    }
+    if (end.isBefore(start)) {
+      return new Interval(end, start);
+    }
+    return new Interval(start, end);
+  }
