+    for (PartitionChunk<T> chunk : partitionHolder) {
+      if (chunk == null) {
+        continue;
+      }
+      T payload = chunk.getObject();
+      if (payload != null && payload.hasData()) {
+        return true;
+      }
+    }
+    return false;
+  }
