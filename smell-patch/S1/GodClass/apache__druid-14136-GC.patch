+  public static <T extends Overshadowable<T>> boolean partitionChunksAbut(PartitionChunk<T> current, PartitionChunk<T> next)
+  {
+    if (current == null || next == null) {
+      return false;
+    }
+    return current.abuts(next);
+  }
