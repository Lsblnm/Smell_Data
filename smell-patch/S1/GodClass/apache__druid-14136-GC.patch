+  public static int compareIntervalsByStartThenEnd(Interval left, Interval right)
+  {
+    if (left == null && right == null) {
+      return 0;
+    }
+    if (left == null) {
+      return -1;
+    }
+    if (right == null) {
+      return 1;
+    }
+    long startDelta = left.getStartMillis() - right.getStartMillis();
+    if (startDelta < 0) {
+      return -1;
+    }
+    if (startDelta > 0) {
+      return 1;
+    }
+    long endDelta = left.getEndMillis() - right.getEndMillis();
+    if (endDelta < 0) {
+      return -1;
+    }
+    if (endDelta > 0) {
+      return 1;
+    }
+    return 0;
+  }
+
+  public static int classifyIntervalRelation(Interval left, Interval right)
+  {
+    if (left == null || right == null) {
+      return -1;
+    }
+    if (left.equals(right)) {
+      return 0;
+    }
+    if (intervalContains(left, right)) {
+      return 1;
+    }
+    if (intervalContains(right, left)) {
+      return 2;
+    }
+    if (intervalsOverlap(left, right)) {
+      if (left.getStartMillis() <= right.getStartMillis()) {
+        return 3;
+      }
+      return 4;
+    }
+    if (intervalsAbut(left, right)) {
+      if (left.getEndMillis() == right.getStartMillis()) {
+        return 5;
+      }
+      return 6;
+    }
+    if (left.getEndMillis() < right.getStartMillis()) {
+      return 7;
+    }
+    return 8;
+  }
+
+  public static Interval mergeIntervalsIfAdjacent(Interval left, Interval right)
+  {
+    if (left == null) {
+      return right;
+    }
+    if (right == null) {
+      return left;
+    }
+    int relation = classifyIntervalRelation(left, right);
+    if (relation == 0 || relation == 1) {
+      return left;
+    }
+    if (relation == 2) {
+      return right;
+    }
+    if (relation == 3 || relation == 4 || relation == 5 || relation == 6) {
+      DateTime start = earlierDateTime(left.getStart(), right.getStart());
+      DateTime end = laterDateTime(left.getEnd(), right.getEnd());
+      return new Interval(start, end);
+    }
+    return null;
+  }
+
+  public static Interval intersectIntervals(Interval left, Interval right)
+  {
+    if (left == null || right == null) {
+      return null;
+    }
+    if (!intervalsOverlap(left, right) && !intervalsAbut(left, right)) {
+      return null;
+    }
+    DateTime start = laterDateTime(left.getStart(), right.getStart());
+    DateTime end = earlierDateTime(left.getEnd(), right.getEnd());
+    if (start == null || end == null) {
+      return null;
+    }
+    if (end.isBefore(start)) {
+      return null;
+    }
+    return new Interval(start, end);
+  }
+
+  public static long intervalGapMillis(Interval left, Interval right)
+  {
+    if (left == null || right == null) {
+      return 0L;
+    }
+    if (intervalsOverlap(left, right) || intervalsAbut(left, right)) {
+      return 0L;
+    }
+    if (left.getEndMillis() < right.getStartMillis()) {
+      return right.getStartMillis() - left.getEndMillis();
+    }
+    if (right.getEndMillis() < left.getStartMillis()) {
+      return left.getStartMillis() - right.getEndMillis();
+    }
+    return 0L;
+  }
