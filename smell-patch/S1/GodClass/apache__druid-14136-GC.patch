+  private void bindLookupRequest(Interval interval, Partitions completeness)
+  {
+    lastLookupInterval = interval;
+    lastLookupCompleteness = completeness;
+    lastLookupMatchCount = 0;
+    lastLookupTrimCount = 0;
+    lastLookupWasEmpty = interval == null || isEmptyInterval(interval);
+    lastLookupSpanMillis = safeDurationMillis(interval);
+    lastLookupFirstWindow = null;
+    lastLookupLastWindow = null;
+    captureAuxWindow0(interval);
+    captureAuxWindow1(interval);
+    captureAuxWindow8(interval);
+    captureAuxWindow9(interval);
+    auxWindow1Overlaps(interval);
+    auxWindow8Overlaps(interval);
+    auxWindow9Overlaps(interval);
+    lookupWindowScore2(interval);
+    lookupWindowScore3(interval);
+    snapshotIsolatedMetric0(interval == null ? 0 : 1);
+    snapshotIsolatedMetric5(lastLookupMatchCount);
+    snapshotIsolatedMetric6(lastLookupTrimCount);
+    snapshotIsolatedMetric7(lastLookupWasEmpty ? 0 : 1);
+    if (completeness == Partitions.INCOMPLETE_OK) {
+      snapshotIsolatedMetric1(2);
+    } else if (completeness == Partitions.ONLY_COMPLETE) {
+      snapshotIsolatedMetric1(1);
+    } else {
+      snapshotIsolatedMetric1(0);
+    }
