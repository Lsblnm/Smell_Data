+  public static Interval clipToStart(Interval interval, org.joda.time.ReadableInstant newStart)
+  {
+    if (interval == null) {
+      return null;
+    }
+    if (newStart == null) {
+      return interval;
+    }
+    return new Interval(newStart, interval.getEnd());
+  }
+
+  public static Interval clipToEnd(Interval interval, org.joda.time.ReadableInstant newEnd)
+  {
+    if (interval == null) {
+      return null;
+    }
+    if (newEnd == null) {
+      return interval;
+    }
+    return new Interval(interval.getStart(), newEnd);
+  }
