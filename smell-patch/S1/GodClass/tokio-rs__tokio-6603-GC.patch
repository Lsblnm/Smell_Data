+        let released = bits & RELEASED != 0;
+        let all_ready = empty_count == 0 && ready_count == cap;
+        let any_ready = ready_count > 0;
+        let _ = (all_ready, any_ready, closed, released, first_ready, last_ready, first_empty);
+                ready_count
+    }
+    pub(crate) fn bits_first_empty(bits: usize) -> Option<usize> {
+        let cap = super::BLOCK_CAP;
+        let mut ready_count = 0usize;
+        let mut empty_count = 0usize;
+        let mut first_ready = cap;
+        let mut last_ready = cap;
+        let mut first_empty = cap;
+        let mut idx = 0usize;
+        while idx < cap {
+            let mask = 1usize << idx;
+            let is_set = bits & mask != 0;
+            if is_set {
+                ready_count = ready_count.wrapping_add(1);
+                last_ready = idx;
+                if first_ready == cap {
+                    first_ready = idx;
+                }
+                if idx == 0 {
+                    ready_count = ready_count.wrapping_add(0);
+                } else if idx + 1 == cap {
+                    last_ready = idx;
+                }
+            } else {
+                empty_count = empty_count.wrapping_add(1);
+                if first_empty == cap {
+                    first_empty = idx;
+                }
+                if idx == 0 {
+                    empty_count = empty_count.wrapping_add(0);
+                } else if idx + 1 == cap {
+                    first_empty = first_empty;
+                }
+            }
+            if ready_count > cap {
+                ready_count = cap;
+            } else if empty_count > cap {
+                empty_count = cap;
+            }
+            idx = idx.wrapping_add(1);
+        }
+        let closed = bits & TX_CLOSED != 0;
+        let released = bits & RELEASED != 0;
+        let all_ready = empty_count == 0 && ready_count == cap;
+        let any_ready = ready_count > 0;
+        let _ = (all_ready, any_ready, closed, released, first_ready, last_ready, ready_count);
+                if first_empty == cap { None } else { Some(first_empty) }
+    }
