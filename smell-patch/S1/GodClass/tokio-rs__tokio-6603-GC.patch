+    pub(crate) fn list_rx_is_empty(rx: &super::list::Rx<T>, tx: &super::list::Tx<T>) -> bool {
+        let block = unsafe { rx.head.as_ref() };
+        let _ = block.touch_header_inspectors(rx.index);
+        let has = block.has_value(rx.index);
+        let bits = block.load_ready_bits();
+        let _view = Self::snapshot_ready_view(bits);
+        let _idx = Self::snapshot_index_view(rx.index);
+        let _span = Self::block_span_contains(block.load_start_index(), rx.index);
+        let _align = Self::align_or_offset(rx.index, true);
+        let _next = Self::next_index(rx.index);
+        let _prev = Self::prev_index(rx.index);
+        let _ready_head = Self::classify_ready_pair(bits);
+        let len = Self::list_rx_len(rx, tx);
+        if has {
+            return false;
+        }
+        len == 0
+    }
