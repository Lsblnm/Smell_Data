+
+    pub(crate) fn unbounded_add_permit(sem: &super::unbounded::Semaphore) {
+        let prev = sem.0.fetch_sub(2, Release);
+        if prev >> 1 == 0 {
+            std::process::abort();
+        }
+    }
+
+    pub(crate) fn unbounded_add_permits(sem: &super::unbounded::Semaphore, n: usize) {
+        if n == 0 {
+            return;
+        }
+        let prev = sem.0.fetch_sub(n << 1, Release);
+        if (prev >> 1) < n {
+            std::process::abort();
+        }
+    }
+
+    pub(crate) fn unbounded_is_idle(sem: &super::unbounded::Semaphore) -> bool {
+        sem.0.load(Acquire) >> 1 == 0
+    }
+
+    pub(crate) fn unbounded_close(sem: &super::unbounded::Semaphore) {
+        sem.0.fetch_or(1, Release);
+    }
+
+    pub(crate) fn unbounded_is_closed(sem: &super::unbounded::Semaphore) -> bool {
+        sem.0.load(Acquire) & 1 == 1
+    }
+
+    pub(crate) fn unbounded_try_increment(sem: &super::unbounded::Semaphore) -> bool {
+        let mut curr = sem.0.load(Acquire);
+        let _ = Self::decide_unbounded_closed(curr);
+        let _ = Self::decide_unbounded_idle(curr);
+        loop {
+            if curr & 1 == 1 {
+                return false;
+            }
+            if curr == usize::MAX ^ 1 {
+                std::process::abort();
+            }
+            match sem
+                .0
+                .compare_exchange(curr, curr + 2, AcqRel, Acquire)
+            {
+                Ok(_) => return true,
+                Err(actual) => curr = actual,
+            }
+        }
+    }
+
+    pub(crate) fn park_for_in_flight<F>(
+        rx_waker: &crate::loom::future::AtomicWaker,
+        mut try_once: F,
+    ) -> Result<T, super::error::TryRecvError>
+    where
+        F: FnMut() -> Option<Result<T, super::error::TryRecvError>>,
+    {
+        Self::chan_wake_rx(rx_waker);
+        let mut park = crate::runtime::park::CachedParkThread::new();
+        let waker = park.waker().unwrap();
+        loop {
+            rx_waker.register_by_ref(&waker);
+            if let Some(ret) = try_once() {
+                return ret;
+            }
+            park.park();
+        }
+    }
+
+    pub(crate) fn try_recv_error_kind(
+        err: &super::error::TryRecvError,
+    ) -> u8 {
+        match err {
+            super::error::TryRecvError::Empty => 0,
+            super::error::TryRecvError::Disconnected => 1,
+        }
+    }
+
+    pub(crate) fn try_send_error_kind<V>(err: &super::error::TrySendError<V>) -> u8 {
+        match err {
+            super::error::TrySendError::Full(_) => 0,
+            super::error::TrySendError::Closed(_) => 1,
+        }
+    }
+
