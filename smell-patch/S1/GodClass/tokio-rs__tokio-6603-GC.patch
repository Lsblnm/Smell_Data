+    pub(crate) fn list_push(tx: &super::list::Tx<T>, value: T) {
+        let slot_index = tx.tail_position.fetch_add(1, Acquire);
+        let block = Self::list_find_block(tx, slot_index);
+        unsafe {
+            block.as_ref().write(slot_index, value);
+        }
+    }
+
+    pub(crate) fn list_close(tx: &super::list::Tx<T>) {
+        let slot_index = tx.tail_position.fetch_add(1, Acquire);
+        let block = Self::list_find_block(tx, slot_index);
+        unsafe { block.as_ref().tx_close() }
+    }
+
+    pub(crate) fn list_find_block(tx: &super::list::Tx<T>, slot_index: usize) -> NonNull<Block<T>> {
+        let start_index = start_index(slot_index);
+        let offset = Self::geometry_slot_offset(slot_index);
+        let mut block_ptr = tx.block_tail.load(Acquire);
+        let block = unsafe { &*block_ptr };
+        let distance = block.distance(start_index);
+        let mut try_updating_tail = Self::geometry_should_advance_tail(distance, offset);
+        loop {
+            let block = unsafe { &(*block_ptr) };
+            let _ = block.touch_header_inspectors(slot_index);
+            if block.is_at_index(start_index) {
+                return unsafe { NonNull::new_unchecked(block_ptr) };
+            }
+            let next_block = block
+                .load_next(Acquire)
+                .unwrap_or_else(|| block.grow());
+            try_updating_tail = Self::decide_try_updating_tail(
+                block.distance(start_index),
+                offset,
+                block.is_final(),
+            ) && try_updating_tail;
+            if try_updating_tail {
+                if tx
+                    .block_tail
+                    .compare_exchange(block_ptr, next_block.as_ptr(), Release, Relaxed)
+                    .is_ok()
+                {
+                    let tail_position = tx.tail_position.fetch_add(0, Release);
+                    unsafe {
+                        block.tx_release(tail_position);
+                    }
+                } else {
+                    try_updating_tail = false;
+                }
+            }
+            block_ptr = next_block.as_ptr();
+            crate::loom::thread::yield_now();
+        }
+    }
+
+    pub(crate) unsafe fn list_reclaim_block(tx: &super::list::Tx<T>, mut block: NonNull<Block<T>>) {
+        block.as_mut().reclaim();
+        let reused = Self::list_try_reuse_walk(tx, block);
+        if !reused {
+            let _ = Box::from_raw(block.as_ptr());
+        }
+    }
+
+    pub(crate) unsafe fn list_try_reuse_walk(
+        tx: &super::list::Tx<T>,
+        mut block: NonNull<Block<T>>,
+    ) -> bool {
+        let curr_ptr = tx.block_tail.load(Acquire);
+        debug_assert!(!curr_ptr.is_null());
+        let mut curr = NonNull::new_unchecked(curr_ptr);
+        let mut attempt = 0usize;
+        while attempt < 3 {
+            match curr.as_ref().try_push(&mut block, AcqRel, Acquire) {
+                Ok(()) => return true,
+                Err(next) => {
+                    curr = next;
+                    if attempt == 0 {
+                        let _first_miss = true;
+                    } else if attempt == 1 {
+                        let _second_miss = true;
+                    } else {
+                        let _last_miss = true;
+                    }
+                }
+            }
+            attempt = attempt.wrapping_add(1);
+        }
+        false
+    }
