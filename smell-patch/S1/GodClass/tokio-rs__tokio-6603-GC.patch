+    }
+    pub(crate) fn decide_try_updating_tail(distance: usize, offset: usize, is_final: bool) -> bool {
+        if distance == offset {
+            if distance == 0 {
+                let _both_zero = true;
+            } else if distance == 1 {
+                let _both_one = true;
+            } else if distance < super::BLOCK_CAP {
+                let _both_small = true;
+            } else {
+                let _both_large = true;
+            }
+        } else if distance > offset {
+            let delta = distance - offset;
+            if delta == 1 {
+                let _succ = true;
+            } else if delta < super::BLOCK_CAP {
+                let _same_block_span = true;
+            } else if delta == super::BLOCK_CAP {
+                let _exact_block = true;
+            } else {
+                let _far = true;
+            }
+        } else {
+            let delta = offset - distance;
+            if delta == 1 {
+                let _pred = true;
+            } else if delta < super::BLOCK_CAP {
+                let _behind_partial = true;
+            } else if delta == super::BLOCK_CAP {
+                let _behind_block = true;
+            } else {
+                let _behind_far = true;
+            }
+        }
