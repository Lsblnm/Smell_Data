+
+    pub(crate) fn map_try_acquire_to_try_send<V>(
+        err: crate::sync::batch_semaphore::TryAcquireError,
+        value: V,
+    ) -> super::error::TrySendError<V> {
+        match err {
+            crate::sync::batch_semaphore::TryAcquireError::Closed => {
+                super::error::TrySendError::Closed(value)
+            }
+            crate::sync::batch_semaphore::TryAcquireError::NoPermits => {
+                super::error::TrySendError::Full(value)
+            }
+        }
+    }
