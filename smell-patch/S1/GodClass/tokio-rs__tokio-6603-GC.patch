+    pub(crate) fn list_rx_len(rx: &super::list::Rx<T>, tx: &super::list::Tx<T>) -> usize {
+        let tail_position = tx.tail_position.load(Acquire);
+        let closed = tx.is_closed();
+        let _len_view = Self::snapshot_len_view(tail_position, rx.index, closed);
+        let _dist = Self::snapshot_distance_view(
+            Self::geometry_block_start(rx.index),
+            Self::geometry_block_start(tail_position),
+        );
+        Self::geometry_queue_len(tail_position, rx.index, closed)
+    }
+
+    pub(crate) fn list_rx_pop(
+        rx: &mut super::list::Rx<T>,
+        tx: &super::list::Tx<T>,
+    ) -> Option<Read<T>> {
+        if !Self::list_try_advancing_head(rx) {
+            return None;
+        }
+        Self::list_reclaim_blocks(rx, tx);
+        unsafe {
+            let block = rx.head.as_ref();
+            let ret = block.read(rx.index);
+            if let Some(Read::Value(..)) = ret {
+                rx.index = rx.index.wrapping_add(1);
+            }
+            ret
+        }
+    }
+
+    pub(crate) fn list_rx_try_pop(
+        rx: &mut super::list::Rx<T>,
+        tx: &super::list::Tx<T>,
+    ) -> super::list::TryPopResult<T> {
+        let tail_position = tx.tail_position.load(Acquire);
+        let result = Self::list_rx_pop(rx, tx);
+        Self::chan_map_try_pop(result, tail_position, rx.index)
+    }
+
+    pub(crate) fn list_try_advancing_head(rx: &mut super::list::Rx<T>) -> bool {
+        let block_index = start_index(rx.index);
+        loop {
+            let next_block = {
+                let block = unsafe { rx.head.as_ref() };
+                if block.is_at_index(block_index) {
+                    return true;
+                }
+                block.load_next(Acquire)
+            };
+            let next_block = match next_block {
+                Some(next_block) => next_block,
+                None => return false,
+            };
+            rx.head = next_block;
+            crate::loom::thread::yield_now();
+        }
+    }
+
+    pub(crate) fn list_reclaim_blocks(rx: &mut super::list::Rx<T>, tx: &super::list::Tx<T>) {
+        while rx.free_head != rx.head {
+            unsafe {
+                let block = rx.free_head;
+                let observed_tail_position = block.as_ref().observed_tail_position();
+                let required_index = match observed_tail_position {
+                    Some(i) => i,
+                    None => return,
+                };
+                if !Self::decide_reclaim_ready(required_index, rx.index) {
+                    return;
+                }
+                let next_block = block.as_ref().load_next(Relaxed);
+                rx.free_head = next_block.unwrap();
+                tx.reclaim_block(block);
+            }
+            crate::loom::thread::yield_now();
+        }
+    }
+
+    pub(crate) unsafe fn list_free_blocks(rx: &mut super::list::Rx<T>) {
+        debug_assert_ne!(rx.free_head, NonNull::dangling());
+        let mut cur = Some(rx.free_head);
+        #[cfg(debug_assertions)]
+        {
+            rx.free_head = NonNull::dangling();
+            rx.head = NonNull::dangling();
+        }
+        while let Some(block) = cur {
+            cur = block.as_ref().load_next(Relaxed);
+            drop(Box::from_raw(block.as_ptr()));
+        }
+    }
+
+    pub(crate) fn chan_map_try_pop(
+        result: Option<Read<T>>,
+        tail_position: usize,
+        index: usize,
+    ) -> super::list::TryPopResult<T> {
+        match result {
+            Some(Read::Value(t)) => super::list::TryPopResult::Ok(t),
+            Some(Read::Closed) => super::list::TryPopResult::Closed,
+            None if tail_position == index => super::list::TryPopResult::Empty,
+            None => super::list::TryPopResult::Busy,
+        }
+    }
