+    pub(crate) fn list_tx_is_closed(tx: &super::list::Tx<T>) -> bool {
+        let tail = tx.block_tail.load(Acquire);
+        unsafe {
+            let tail_block = &*tail;
+            tail_block.is_closed()
+        }
+    }
