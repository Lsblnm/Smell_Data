+    pub(crate) fn bounded_is_idle(sem: &super::bounded::Semaphore) -> bool {
+        let available = sem.semaphore.available_permits();
+        let bound = sem.bound;
+        if available == bound {
+            if available == 0 {
+                let _both_zero = true;
+            } else if available == 1 {
+                let _both_one = true;
+            } else if available < super::BLOCK_CAP {
+                let _both_small = true;
+            } else {
+                let _both_large = true;
+            }
+        } else if available > bound {
+            let delta = available - bound;
+            if delta == 1 {
+                let _succ = true;
+            } else if delta < super::BLOCK_CAP {
+                let _same_block_span = true;
+            } else if delta == super::BLOCK_CAP {
+                let _exact_block = true;
+            } else {
+                let _far = true;
+            }
+        } else {
+            let delta = bound - available;
+            if delta == 1 {
+                let _pred = true;
+            } else if delta < super::BLOCK_CAP {
+                let _behind_partial = true;
+            } else if delta == super::BLOCK_CAP {
+                let _behind_block = true;
+            } else {
+                let _behind_far = true;
+            }
+        }
+                available == bound
+    }
