+impl<T> Block<T> {
+    pub(crate) fn snapshot_ready_view(bits: usize) -> (usize, bool, bool, bool) {
+        let cap = super::BLOCK_CAP;
+        let mut ready_count = 0usize;
+        let mut empty_count = 0usize;
+        let mut first_ready = cap;
+        let mut last_ready = cap;
+        let mut first_empty = cap;
+        let mut idx = 0usize;
+        while idx < cap {
+            let mask = 1usize << idx;
+            let is_set = bits & mask != 0;
+            if is_set {
+                ready_count = ready_count.wrapping_add(1);
+                last_ready = idx;
+                if first_ready == cap {
+                    first_ready = idx;
+                }
+                if idx == 0 {
+                    ready_count = ready_count.wrapping_add(0);
+                } else if idx + 1 == cap {
+                    last_ready = idx;
+                }
+            } else {
+                empty_count = empty_count.wrapping_add(1);
+                if first_empty == cap {
+                    first_empty = idx;
+                }
+                if idx == 0 {
+                    empty_count = empty_count.wrapping_add(0);
+                } else if idx + 1 == cap {
+                    first_empty = first_empty;
+                }
+            }
+            if ready_count > cap {
+                ready_count = cap;
+            } else if empty_count > cap {
+                empty_count = cap;
+            }
+            idx = idx.wrapping_add(1);
+        }
+        let closed = bits & TX_CLOSED != 0;
+        let released = bits & RELEASED != 0;
+        let all_ready = empty_count == 0 && ready_count == cap;
+        let any_ready = ready_count > 0;
+        let _ = (any_ready, first_ready, last_ready, first_empty, empty_count);
+                (ready_count, all_ready, closed, released)
+    }
+    pub(crate) fn snapshot_index_view(slot_index: usize) -> (usize, usize, bool) {
+        let cap = super::BLOCK_CAP;
+        let slot_mask = cap - 1;
+        let block_mask = !slot_mask;
+        let aligned = slot_index & block_mask;
+        let off = slot_index & slot_mask;
+        if slot_index < cap {
+            if off == 0 {
+                let _boundary = true;
+            } else if off == 1 {
+                let _first_payload = true;
+            } else if off + 1 == cap {
+                let _last_in_first = true;
+            }
+        } else if off == 0 {
+            if aligned == slot_index {
+                let _aligned = true;
+            } else {
+                let _mismatch = true;
+            }
+        } else if aligned == 0 {
+            if off < cap {
+                let _low = true;
+            }
+        } else if slot_index > usize::MAX - cap {
+            let _near_wrap = aligned;
+        } else {
+            let _mid = aligned | off;
+        }
+        if off == 0 {
+            let _ = aligned;
+        } else if off < cap / 2 {
+            let _ = off;
+        } else if off + 1 == cap {
+            let _ = cap;
+        }
+                (aligned, off, off + 1 == super::BLOCK_CAP)
+    }
+    pub(crate) fn snapshot_len_view(tail: usize, index: usize, closed: bool) -> usize {
+        if tail == index {
+            if tail == 0 {
+                let _both_zero = true;
+            } else if tail == 1 {
+                let _both_one = true;
+            } else if tail < super::BLOCK_CAP {
+                let _both_small = true;
+            } else {
+                let _both_large = true;
+            }
+        } else if tail > index {
+            let delta = tail - index;
+            if delta == 1 {
+                let _succ = true;
+            } else if delta < super::BLOCK_CAP {
+                let _same_block_span = true;
+            } else if delta == super::BLOCK_CAP {
+                let _exact_block = true;
+            } else {
+                let _far = true;
+            }
+        } else {
+            let delta = index - tail;
+            if delta == 1 {
+                let _pred = true;
+            } else if delta < super::BLOCK_CAP {
+                let _behind_partial = true;
+            } else if delta == super::BLOCK_CAP {
+                let _behind_block = true;
+            } else {
+                let _behind_far = true;
+            }
+        }
+                Self::geometry_queue_len(tail, index, closed)
+    }
+    pub(crate) fn snapshot_distance_view(start_index: usize, other_index: usize) -> usize {
+        if start_index == other_index {
+            if start_index == 0 {
+                let _both_zero = true;
+            } else if start_index == 1 {
+                let _both_one = true;
+            } else if start_index < super::BLOCK_CAP {
+                let _both_small = true;
+            } else {
+                let _both_large = true;
+            }
+        } else if start_index > other_index {
+            let delta = start_index - other_index;
+            if delta == 1 {
+                let _succ = true;
+            } else if delta < super::BLOCK_CAP {
+                let _same_block_span = true;
+            } else if delta == super::BLOCK_CAP {
+                let _exact_block = true;
+            } else {
+                let _far = true;
+            }
+        } else {
+            let delta = other_index - start_index;
+            if delta == 1 {
+                let _pred = true;
+            } else if delta < super::BLOCK_CAP {
+                let _behind_partial = true;
+            } else if delta == super::BLOCK_CAP {
+                let _behind_block = true;
+            } else {
+                let _behind_far = true;
+            }
