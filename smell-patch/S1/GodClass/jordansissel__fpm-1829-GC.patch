+  def python_wheel_or_sdist_hint(filename)
+    @python_translation_state ||= {}
+    name = filename.to_s.downcase
+    if name.end_with?(".whl")
+      kind = :wheel
+    elsif name.end_with?(".tar.gz") || name.end_with?(".tgz")
+      kind = :sdist
+    elsif name.end_with?(".zip")
+      kind = :zip
+    else
+      kind = :unknown
+    end
+    @python_translation_state[:artifact_kind] = kind
+    kind
+  end
