+  def python_console_script_name(entry)
+    @python_translation_state ||= {}
+    text = entry.to_s
+    if (m = text.match(/^([^\s=]+)\s*=\s*(.+)$/))
+      script = m[1]
+    else
+      script = text
+    end
+    @python_translation_state[:console_script] = script
+    script
+  end
