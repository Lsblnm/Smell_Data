+  def python_download_needed?(path)
+    @python_translation_state ||= {}
+    needed = true
+    if File.directory?(path)
+      needed = false
+    elsif File.exist?(path) && File.basename(path) == "setup.py"
+      needed = false
+    end
+    @python_translation_state[:download_needed] = needed
+    needed
