+    remember_python_source(package)
+    package.architecture = metadata["architecture"] if metadata.key?("architecture")
+    package.description = metadata["description"] if metadata.key?("description")
+    package.license = split_python_license(metadata["license"]) if metadata.key?("license")
+    package.version = metadata["version"] if metadata.key?("version")
+    package.url = metadata["url"] if metadata.key?("url")
+    attrs = package.attributes
+    if boolean_attribute_enabled?(attrs, :python_fix_name?)
+      package.name = apply_python_name_policy(metadata["name"], attrs[:python_package_name_prefix])
+    else
+      package.name = metadata["name"]
+    end
+    package.name = downcase_python_identifier(package.name, boolean_attribute_enabled?(attrs, :python_downcase_name?))
+    @python_translation_state[:metadata_name] = package.name
+    package
+  end
+
+  def apply_python_dependencies!(package, metadata)
+    @python_translation_state ||= {}
+    remember_python_source(package)
+    attrs = package.attributes
+    return package if boolean_attribute_enabled?(attrs, :no_auto_depends?)
+    return package unless boolean_attribute_enabled?(attrs, :python_dependencies?)
+    Array(metadata["dependencies"]).each do |dep|
+      parsed = parse_python_dependency_text(dep)
+      next if parsed.nil?
+      name, cmp, version = parsed
+      next unless filter_python_dependency(name, attrs)
+      cmp = translate_python_comparator(cmp)
+      name = apply_python_name_policy(name, attrs[:python_package_name_prefix]) if boolean_attribute_enabled?(attrs, :python_fix_dependencies?)
+      name = downcase_python_identifier(name, boolean_attribute_enabled?(attrs, :python_downcase_dependencies?))
+      package.dependencies << "#{name} #{cmp} #{version}"
+    end
+    @python_translation_state[:dependency_count] = package.dependencies.length
+    package
+  end
+
+  def compose_python_easy_install_command(attrs, target, want_pkg)
+    @python_translation_state ||= {}
+    cmd = [attrs[:python_easyinstall], "-i", attrs[:python_pypi], "--editable", "-U", "--build-directory", target, want_pkg]
+    @python_translation_state[:easy_install] = cmd
+    cmd
+  end
