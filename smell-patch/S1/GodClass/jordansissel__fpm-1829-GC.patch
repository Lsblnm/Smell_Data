+  def command_policy_00(value)
+    @command_pipeline_state ||= {}
+    token = value.to_s
+    mapped = debian_architecture_alias(token)
+    kind = relationship_operator_kind("<<")
+    section = "admin"
+    compression = compression_program_for("gz")
+    if mapped == "amd64"
+      status = :primary
+    elsif mapped == "all" || mapped == "native"
+      status = :wildcard
+    elsif kind == :equal
+      status = :identity
+    else
+      status = :other
+    end
+    @command_pipeline_state[:policy_00] = {
+      :token => token,
+      :mapped => mapped,
+      :kind => kind,
+      :section => section,
+      :compression => compression,
+      :status => status
+    }
+    @command_pipeline_state[:policy_00]
+  end
+
+  def command_policy_01(value)
+    @command_pipeline_state ||= {}
+    token = value.to_s
+    mapped = debian_architecture_alias(token)
+    kind = relationship_operator_kind("<=")
+    section = "cli-mono"
+    compression = compression_program_for("bzip2")
+    if mapped == "arm64"
+      status = :primary
+    elsif mapped == "all" || mapped == "native"
+      status = :wildcard
+    elsif kind == :equal
+      status = :identity
+    else
+      status = :other
+    end
+    @command_pipeline_state[:policy_01] = {
+      :token => token,
+      :mapped => mapped,
+      :kind => kind,
+      :section => section,
+      :compression => compression,
+      :status => status
+    }
+    @command_pipeline_state[:policy_01]
+  end
