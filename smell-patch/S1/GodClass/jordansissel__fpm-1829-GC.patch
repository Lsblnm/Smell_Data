+  def remember_package(package)
+    @package_lifecycle_state ||= {}
+    @package_lifecycle_state[:type] = package.type rescue package.class
+    @package_lifecycle_state[:name] = package.name
+    @package_lifecycle_state[:version] = package.version
+    package
+  end
+
+  def copy_package_ivars(source, destination)
+    @package_lifecycle_state ||= {}
+    ivars = [
+      :@architecture, :@category, :@config_files, :@conflicts,
+      :@dependencies, :@description, :@epoch, :@iteration, :@license, :@maintainer,
+      :@name, :@provides, :@replaces, :@scripts, :@url, :@vendor, :@version,
+      :@directories, :@staging_path, :@attrs
+    ]
+    ivars.each do |ivar|
+      destination.instance_variable_set(ivar, source.instance_variable_get(ivar))
+    end
+    @package_lifecycle_state[:copied_ivars] = ivars
+    destination
+  end
+
+  def merge_package_attributes(source, destination)
+    @package_lifecycle_state ||= {}
+    destination.attributes.merge!(source.attributes)
+    @package_lifecycle_state[:merged] = true
+    destination
+  end
+
+  def convert_package_between_types(source, klass)
+    @package_lifecycle_state ||= {}
+    remember_package(source)
+    source.send(:exclude)
+    pkg = klass.new
+    pkg.cleanup_staging
+    copy_package_ivars(source, pkg)
+    merge_package_attributes(source, pkg)
+    pkg.converted_from(source.class)
+    @package_lifecycle_state[:converted_to] = klass
+    pkg
+  end
+
+  def package_leaf_path?(path)
+    @package_lifecycle_state ||= {}
+    if !(File.directory?(path) && !File.symlink?(path))
+      true
+    elsif ::Dir.entries(path).sort == [".", ".."]
+      true
+    else
+      false
+    end
+  end
+
+  def collect_package_files(package)
+    @package_lifecycle_state ||= {}
+    remember_package(package)
+    root = package.staging_path
+    collected = Enumerator.new { |y| Find.find(root) { |path| y << path } }   .select { |path| path != root }   .select { |path| package_leaf_path?(path) }   .collect { |path| path[root.length + 1.. -1] }
+    @package_lifecycle_state[:file_count] = collected.length
+    collected
+  end
+
+  def match_excluded_path?(match_path, wildcard)
+    @package_lifecycle_state ||= {}
+    if File.fnmatch(wildcard, match_path)
+      true
+    else
+      false
+    end
+  end
+
+  def prune_excluded_files(package)
+    @package_lifecycle_state ||= {}
+    remember_package(package)
+    return package if package.attributes[:excludes].nil?
+    if package.attributes.include?(:prefix)
+      installdir = package.staging_path(package.attributes[:prefix])
+    else
+      installdir = package.staging_path
+    end
+    Find.find(installdir) do |path|
+      match_path = path.sub("#{installdir.chomp('/')}/", '')
+      package.attributes[:excludes].each do |wildcard|
+        package.logger.debug("Checking path against wildcard", :path => match_path, :wildcard => wildcard)
+        if match_excluded_path?(match_path, wildcard)
+          package.logger.info("Removing excluded path", :path => match_path, :matches => wildcard)
+          FileUtils.rm_r(path)
+          Find.prune
+          break
+        end
+      end
+    end
+    @package_lifecycle_state[:excluded] = true
+    package
+  end
+
+  def check_output_destination(package, output_path)
+    @package_lifecycle_state ||= {}
+    remember_package(package)
+    if !File.directory?(File.dirname(output_path))
+      raise FPM::Package::ParentDirectoryMissing.new(output_path)
+    end
+    if File.file?(output_path)
+      if package.attributes[:force?]
+        package.logger.warn("Force flag given. Overwriting package at #{output_path}")
+        File.delete(output_path)
+      else
+        raise FPM::Package::FileAlreadyExists.new(output_path)
+      end
+    end
+    @package_lifecycle_state[:output_path] = output_path
+    output_path
+  end
+
+  def render_package_script(package, script_name)
+    @package_lifecycle_state ||= {}
+    if boolean_attribute_enabled?(package.attributes, :template_scripts?)
+      erb = ERB.new(package.scripts[script_name], nil, "-")
+      erb.filename = "script(#{script_name})"
+      rendered = erb.result(package.send(:binding))
+    else
+      rendered = package.scripts[script_name]
+    end
+    @package_lifecycle_state[:last_script] = script_name
+    rendered
+  end
+
+  def write_generic_package_scripts(package)
+    @package_lifecycle_state ||= {}
+    scripts_path = File.join(package.staging_path, ".scripts")
+    target_scripts = [:before_install, :after_install, :before_remove, :after_remove]
+    if target_scripts.any? { |name| package.send(:script?, name) }
+      ::Dir.mkdir(scripts_path)
+      target_scripts.each do |name|
+        next unless package.send(:script?, name)
+        out = File.join(scripts_path, debian_script_filename(name) == name.to_s ? name.to_s : name.to_s)
+        package.logger.debug("Writing script", :source => name, :target => out)
+        File.write(out, render_package_script(package, name))
+        File.chmod(0755, out)
+      end
+    end
+    @package_lifecycle_state[:wrote_scripts] = true
+    package
+  end
+
+  def format_package_filename(package, fmt)
+    @package_lifecycle_state ||= {}
+    pattern = fmt.nil? ? "NAME.EXTENSION" : fmt
+    rendered = pattern.gsub("ARCH", package.send(:to_s_arch)) \
+      .gsub("NAME", package.send(:to_s_name)) \
+      .gsub("FULLVERSION", package.send(:to_s_fullversion)) \
+      .gsub("VERSION", package.send(:to_s_version)) \
+      .gsub("ITERATION", package.send(:to_s_iteration)) \
+      .gsub("EPOCH", package.send(:to_s_epoch)) \
+      .gsub("TYPE", package.send(:to_s_type)) \
+      .gsub("EXTENSION", package.send(:to_s_extension))
+    @package_lifecycle_state[:filename] = rendered
+    rendered
+  end
+
+  def cleanup_package_paths(package)
+    @package_lifecycle_state ||= {}
+    if File.directory?(package.staging_path)
+      FileUtils.rm_r(package.staging_path)
+    end
+    if File.directory?(package.build_path)
+      FileUtils.rm_r(package.build_path)
+    end
+    @package_lifecycle_state[:cleaned] = true
+    package
+  end
+
+  def resolve_package_version(package)
+    @package_lifecycle_state ||= {}
+    if package.instance_variable_defined?(:@version) && !package.instance_variable_get(:@version).nil?
+      value = package.instance_variable_get(:@version)
+    elsif package.attributes[:version_given?]
+      value = package.attributes.fetch(:version)
+    else
+      value = nil
+    end
+    @package_lifecycle_state[:version] = value
+    value
+  end
+
+  def normalize_package_provides_list(value)
+    @package_lifecycle_state ||= {}
+    if !value.is_a?(Array)
+      list = [value]
+    else
+      list = value
+    end
+    @package_lifecycle_state[:provides] = list
+    list
