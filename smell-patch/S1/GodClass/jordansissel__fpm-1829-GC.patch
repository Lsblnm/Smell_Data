+  def python_metadata_command(setup_py, attrs, pylib, tmp)
+    @python_translation_state ||= {}
+    setup_dir = File.dirname(setup_py)
+    cmd = "env PYTHONPATH=#{pylib}:$PYTHONPATH #{attrs[:python_bin]} setup.py --command-packages=pyfpm get_metadata --output=#{tmp}"
+    if boolean_attribute_enabled?(attrs, :python_obey_requirements_txt?)
+      cmd += " --load-requirements-txt"
