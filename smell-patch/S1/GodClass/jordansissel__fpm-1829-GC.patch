+  def relationship_operator_kind(op)
+    table = {
+      "<<" => :strictly_earlier,
+      "<" => :strictly_earlier,
+      "<=" => :earlier_or_equal,
+      "=" => :equal,
+      "==" => :equal,
+      ">=" => :later_or_equal,
+      ">>" => :strictly_later,
+      ">" => :strictly_later,
+      "!=" => :not_equal,
+      "~>" => :pessimistic
+    }
+    table.fetch(op.to_s.strip, :unknown)
+  end
+
+  def canonicalize_relationship_operator(op)
+    table = {
+      :strictly_earlier => "<<",
+      :earlier_or_equal => "<=",
+      :equal => "=",
+      :later_or_equal => ">=",
+      :strictly_later => ">>",
+      :not_equal => "!=",
+      :pessimistic => "~>"
+    }
+    table.fetch(relationship_operator_kind(op), op.to_s)
+  end
