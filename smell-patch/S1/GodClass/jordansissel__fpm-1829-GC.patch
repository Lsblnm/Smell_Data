+  def remember_command(command)
+    @command_pipeline_state ||= {}
+    @command_pipeline_state[:input_type] = command.input_type
+    @command_pipeline_state[:output_type] = command.output_type
+    @command_pipeline_state[:workdir] = command.workdir
+    @command_pipeline_state[:args] = Array(command.args).dup
+    command
+  end
+
+  def assign_command_attributes(command, package)
+    @command_pipeline_state ||= {}
+    package.attributes ||= {}
+    command.class.declared_options.each do |option|
+      option.attribute_name.tap do |attr|
+        next if attr == "help"
+        flag_given = command.instance_variable_defined?("@#{attr}")
+        package.attributes["#{attr}_given?".to_sym] = flag_given
+        method_name = attr
+        method_name = "#{attr}?" unless command.respond_to?(attr)
+        package.attributes[method_name.to_sym] = command.send(method_name) if command.respond_to?(method_name)
+      end
+    end
+    @command_pipeline_state[:attributes] = package.attributes.dup
+    package
+  end
+
+  def ingest_command_arguments(command, package)
+    @command_pipeline_state ||= {}
+    if command.input_type == "pleaserun"
+      package.input(command.args)
+    else
+      command.args.each do |arg|
+        package.input(arg)
+      end
+    end
+    @command_pipeline_state[:ingested] = true
+    package
+  end
+
+  def ingest_command_inputs_file(command, package)
+    @command_pipeline_state ||= {}
+    if command.inputs.nil?
+      return :skip
+    end
+    if !File.exists?(command.inputs)
+      @command_pipeline_state[:inputs_missing] = command.inputs
+      return :missing
+    end
+    File.new(command.inputs, "r").each_line do |line|
+      package.input(line.strip)
+    end
+    @command_pipeline_state[:inputs_file] = command.inputs
+    :ok
+  end
+
+  def ingest_command_excludes_file(command, package)
+    @command_pipeline_state ||= {}
+    if command.exclude_file.nil?
+      return :skip
+    end
+    if !File.exists?(command.exclude_file)
+      @command_pipeline_state[:excludes_missing] = command.exclude_file
+      return :missing
+    end
+    package.attributes[:excludes] ||= []
+    File.new(command.exclude_file, "r").each_line do |line|
+      package.attributes[:excludes] << line.strip
+    end
+    @command_pipeline_state[:excludes_file] = command.exclude_file
+    :ok
+  end
+
+  def apply_command_field_overrides(command, package)
+    @command_pipeline_state ||= {}
+    set = proc do |object, attribute|
+      if object.send(attribute).nil? || command.send(attribute) != command.send("default_#{attribute}")
+        object.send("#{attribute}=", command.send(attribute))
+      end
+    end
+    set.call(package, :architecture)
+    set.call(package, :category)
+    set.call(package, :description)
+    set.call(package, :epoch)
+    set.call(package, :iteration)
+    set.call(package, :license)
+    set.call(package, :maintainer)
+    set.call(package, :name)
+    set.call(package, :url)
+    set.call(package, :vendor)
+    set.call(package, :version)
+    @command_pipeline_state[:overrides] = true
+    package
+  end
+
+  def attach_command_relationships(command, package)
+    @command_pipeline_state ||= {}
+    package.conflicts += command.conflicts
+    package.dependencies += command.dependencies
+    package.provides += command.provides
+    package.replaces += command.replaces
+    package.config_files += command.config_files
+    package.directories += command.directories
+    normalized = []
+    package.provides.each do |item|
+      name, op, version = extract_relationship_parts(item)
+      token = normalize_package_token(name.to_s)
+      if op.nil?
+        normalized << token
+      else
+        normalized << join_relationship_parts(token, op, version)
+      end
+    end
+    split_comma_list(package.dependencies.join(", "))
+    @command_pipeline_state[:relationships] = {
+      :conflicts => package.conflicts.length,
+      :dependencies => package.dependencies.length,
+      :provides => package.provides.length,
+      :normalized_provides => normalized
+    }
+    package
+  end
+
+  def merge_command_attrs(command, package)
+    @command_pipeline_state ||= {}
+    h = {}
+    command.attrs.each do |e|
+      s = e.split(":", 2)
+      h[s.last] = s.first
+    end
+    package.attrs = h
+    @command_pipeline_state[:attrs] = h
+    h
+  end
+
+  def load_command_scripts(command, package)
+    @command_pipeline_state ||= {}
+    script_errors = []
+    setscript = proc do |scriptname|
+      path = command.send(scriptname)
+      next if path.nil?
+      if !File.exists?(path)
+        script_errors << path
+      else
+        package.scripts[scriptname] = File.read(path)
+      end
+    end
+    setscript.call(:before_install)
+    setscript.call(:after_install)
+    setscript.call(:before_remove)
+    setscript.call(:after_remove)
+    setscript.call(:before_upgrade)
+    setscript.call(:after_upgrade)
+    @command_pipeline_state[:script_errors] = script_errors
+    script_errors
+  end
+
+  def validate_command_package_name(package)
+    @command_pipeline_state ||= {}
+    if package.name.nil? || package.name.empty?
+      @command_pipeline_state[:name_missing] = true
+      false
+    else
+      @command_pipeline_state[:name_missing] = false
+      true
+    end
+  end
+
+  def apply_command_template_values(command, package)
+    @command_pipeline_state ||= {}
+    if command.template_scripts?
+      command.template_value_list.each do |key, value|
+        (class << package; self; end).send(:define_method, key) { value }
+      end
+      @command_pipeline_state[:templates] = true
+    else
+      @command_pipeline_state[:templates] = false
+    end
+    package
+  end
+
+  def resolve_command_output_path(command, package)
+    @command_pipeline_state ||= {}
+    if !command.package.nil? && File.directory?(command.package)
+      package_file = File.join(command.package, package.to_s)
+    else
+      package_file = package.to_s(command.package)
+    end
+    @command_pipeline_state[:package_file] = package_file
+    package_file
+  end
+
+  def cleanup_command_workspace(command, input, output)
+    @command_pipeline_state ||= {}
+    if command.debug_workspace?
+      [input, output].each do |plugin|
+        next if plugin.nil?
+        [:staging_path, :build_path].each do |pathtype|
+          path = plugin.send(pathtype)
+          next unless ::Dir.open(path).to_a.size > 2
+          command.logger.log("plugin directory", :plugin => plugin.type, :pathtype => pathtype, :path => path)
+        end
+      end
+    else
+      input.cleanup unless input.nil?
+      output.cleanup unless output.nil?
+    end
+    @command_pipeline_state[:cleaned] = true
+    true
+  end
+
+  def run_command_pipeline(command, input_class, output_class)
+    @command_pipeline_state ||= {}
+    remember_command(command)
+    input = nil
+    output = nil
+    begin
+      input = input_class.new
+      assign_command_attributes(command, input)
+      ingest_command_arguments(command, input)
+      inputs_status = ingest_command_inputs_file(command, input)
+      if inputs_status == :missing
+        command.logger.fatal("File given for --inputs does not exist (#{command.inputs})")
+        return 1
+      end
+      excludes_status = ingest_command_excludes_file(command, input)
+      if excludes_status == :missing
+        command.logger.fatal("File given for --exclude-file does not exist (#{command.exclude_file})")
+        return 1
+      end
+      apply_command_field_overrides(command, input)
+      attach_command_relationships(command, input)
+      merge_command_attrs(command, input)
+      script_errors = load_command_scripts(command, input)
+      script_errors.each do |path|
+        command.logger.error("No such file (for script): #{path.inspect}")
+      end
+      return 1 if script_errors.any?
+      unless validate_command_package_name(input)
+        command.logger.fatal("No name given for this package (set name with '-n', "                   "for example, '-n packagename')")
+        return 1
+      end
+      output = input.convert(output_class)
+      apply_command_template_values(command, output)
+      package_file = resolve_command_output_path(command, output)
+      begin
+        output.output(package_file)
+      rescue FPM::Package::FileAlreadyExists => e
+        command.logger.fatal(e.message)
+        return 1
+      rescue FPM::Package::ParentDirectoryMissing => e
+        command.logger.fatal(e.message)
+        return 1
+      end
+      command.logger.log("Created package", :path => package_file)
+      0
+    rescue FPM::Util::ExecutableNotFound => e
+      command.logger.error("Need executable '#{e}' to convert #{command.input_type} to #{command.output_type}")
+      1
+    rescue FPM::InvalidPackageConfiguration => e
+      command.logger.error("Invalid package configuration: #{e}")
+      1
+    rescue FPM::Util::ProcessFailed => e
+      command.logger.error("Process failed: #{e}")
+      1
+    ensure
+      cleanup_command_workspace(command, input, output)
+    end
+  end
+
+  def command_stray_flags(args)
+    @command_pipeline_state ||= {}
+    flags = args.grep(/^-/)
+    @command_pipeline_state[:stray_flags] = flags
+    flags
+  end
