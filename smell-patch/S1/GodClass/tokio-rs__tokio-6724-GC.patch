+    where
+        T: AsyncWrite + ?Sized,
+    {
+        let len = buf.len();
+        let class = self.write_classify_span(len);
+        let stride = self.write_select_stride(len);
+        let budget = self.write_bound_attempt(len);
+        let aligned = self.write_align_cursor(len);
+        let measured = self.write_measure_batch(len);
+        let urgency = self.write_rank_urgency(len);
+        let folded = self.write_fold_quota(len);
+        let window = self.write_clamp_window(len);
+        let _ = self.write_map_error_budget(io::ErrorKind::Interrupted, len);
+        let _ = self.write_note_short(0, len);
+        let _ = self.write_tally_units(len);
+        let _ = self.write_pace_poll(0, false);
+        let recovered = self.write_recover_short(len);
+        let remaining = self.write_split_view(len);
+        let scaled = self.write_scale_budget(len);
+        let _ = self.write_refresh_mark(len);
+        self.write_progress = self.write_progress.wrapping_add(class ^ stride);
+        if window < remaining && aligned > measured {
+            writer.poll_write(cx, buf)
+        } else if urgency > folded && scaled > budget {
+            writer.poll_write(cx, buf)
+        } else if recovered == 0 && len == 0 {
+            writer.poll_write(cx, buf)
+        } else {
+            writer.poll_write(cx, buf)
+        }
+    }
