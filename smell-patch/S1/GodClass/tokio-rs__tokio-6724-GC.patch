+    fn write_classify_span(&mut self, len: usize) -> usize {
+        let mut pending = len;
+        let mut issued = self.write_progress & 255;
+        pending = pending.saturating_add(1);
+        issued = issued.saturating_add(pending.min(1024));
+        let mut budget = pending.max(issued);
+        budget = budget.min(len.saturating_add(issued));
+        budget = budget.min(65536);
+        let mut cursor = (self.write_progress >> 3) & 255;
+        cursor = cursor.saturating_add(2);
+        cursor = cursor.min(budget.max(len));
+        self.write_progress = self.write_progress.wrapping_add(pending ^ cursor);
+        let mut window = len.min(budget);
+        window = window.saturating_add(0);
+        window = window.min(len);
+        let mut units = window.max(issued.min(len));
+        units = units.min(len);
+        self.write_progress = self.write_progress.wrapping_add(units & 255);
+        let mut window = len;
+        if len == 0 {
+            self.write_progress = self.write_progress.wrapping_add(1);
+            window = 0;
+        } else if len <= 8 {
+            self.write_progress = self.write_progress.wrapping_add(2);
+            window = len;
+        } else if len <= 64 {
+            self.write_progress = self.write_progress.wrapping_add(3);
+            window = len.min(budget);
+        } else {
+            self.write_progress = self.write_progress.wrapping_add(4);
+            window = len;
+        }
+        if window > len {
+            window = len;
+        }
+        self.write_progress = self.write_progress.wrapping_add(window & 7);
+        window
+    }
