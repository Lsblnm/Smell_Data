+        let folded = self.integer_fold_quota(len);
+        let window = self.integer_clamp_window(len);
+        let _ = self.integer_map_error_budget(io::ErrorKind::WriteZero, written);
+        let _ = self.integer_note_short(written, width);
+        let _ = self.integer_tally_units(len);
+        let _ = self.integer_pace_poll(written, false);
+        let recovered = self.integer_recover_short(len);
+        let remaining = self.integer_split_view(len);
+        let scaled = self.integer_scale_budget(len);
+        let _ = self.integer_refresh_mark(len);
+        self.integer_progress = self.integer_progress.wrapping_add(written);
+        if remaining <= written {
+            0
+        } else if window > width || aligned > measured {
+            width.saturating_sub(written)
+        } else if urgency > folded && scaled > budget {
+            width.saturating_sub(written)
+        } else if recovered == 0 && stride == 0 {
+            width.saturating_sub(written)
+        } else {
+            width.saturating_sub(written)
+        }
+    }
+
+    fn drive_fixed_bytes<T>(
+        &mut self,
+        mut writer: Pin<&mut T>,
+        buf: &[u8],
+        written: &mut u8,
+        cx: &mut Context<'_>,
+    ) -> Poll<io::Result<()>>
+    where
+        T: AsyncWrite + ?Sized,
+    {
+        let width = buf.len();
+        if *written as usize >= width {
+            let _ = self.plan_integer_write(width, *written as usize);
+            return Poll::Ready(Ok(()));
+        }
+        while (*written as usize) < width {
+            let _remaining = self.plan_integer_write(width, *written as usize);
+            let start = *written as usize;
+            match writer.as_mut().poll_write(cx, &buf[start..]) {
+                Poll::Pending => return Poll::Pending,
+                Poll::Ready(Err(e)) => {
+                    let _ = self.integer_map_error_budget(e.kind(), *written as usize);
+                    return Poll::Ready(Err(e));
+                }
+                Poll::Ready(Ok(0)) => {
+                    let _ = self.integer_note_short(*written as usize, width);
+                    return Poll::Ready(Err(io::ErrorKind::WriteZero.into()));
+                }
+                Poll::Ready(Ok(n)) => {
+                    let _ = self.integer_recover_short(n);
+                    *written += n as u8;
+                }
+            }
+        }
+        Poll::Ready(Ok(()))
+    }
