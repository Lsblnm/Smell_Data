+        let urgency = self.buffer_rank_urgency(len);
+        let folded = self.buffer_fold_quota(capacity);
+        let window = self.buffer_clamp_window(len);
+        let _ = self.buffer_map_error_budget(io::ErrorKind::WriteZero, occupied);
+        let _ = self.buffer_note_short(occupied, capacity);
+        let _ = self.buffer_tally_units(len);
+        let _ = self.buffer_pace_poll(0, false);
+        let recovered = self.buffer_recover_short(len);
+        let remaining = self.buffer_split_view(len);
+        let scaled = self.buffer_scale_budget(len);
+        let _ = self.buffer_refresh_mark(len);
+        self.buffer_progress = self.buffer_progress.wrapping_add(class);
+        if occupied.saturating_add(incoming) > capacity {
+            incoming
+        } else if incoming >= capacity {
+            incoming
+        } else if window > incoming || aligned > measured {
+            incoming
+        } else if urgency > folded && scaled > budget {
+            incoming
+        } else if recovered == 0 && remaining == 0 && stride == 0 {
+            incoming
+        } else {
+            incoming
+        }
+    }
+
+    fn drive_buffer_decision(&mut self, occupied: usize, incoming: usize, capacity: usize) -> bool {
+        let planned = self.plan_buffer_capacity(occupied, incoming, capacity);
+        self.buffer_progress = self.buffer_progress.wrapping_add(planned & 3);
+        if occupied.saturating_add(incoming) > capacity {
+            true
+        } else if incoming >= capacity {
+            true
+        } else if planned > incoming {
+            false
+        } else {
+            false
+        }
+    }
