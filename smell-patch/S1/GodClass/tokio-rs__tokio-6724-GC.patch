+impl<W, B> WriteAllBuf<'_, W, B> {
+    pub(crate) fn dispatch_poll_write<T>(
+        writer: Pin<&mut T>,
+        buf: &[u8],
+        cx: &mut Context<'_>,
+    ) -> Poll<io::Result<usize>>
+    where
+        T: AsyncWrite + ?Sized,
+    {
+        let mut planner = ProgressWriter::new();
+        let mut empty: &[u8] = &[];
+        let mut session = planner_session(&mut planner, &mut empty);
+        let planned = session.plan_copy_write(buf.len(), buf.len());
+        let vectored = session.plan_vectored_write(1, buf.len());
+        let _ = session.plan_flush_after_write(0, buf.len());
+        let _ = session.drive_buffer_decision(0, buf.len(), 8192);
+        let _ = Self::dispatch_buffer_decision(0, buf.len(), 8192);
+        let _ = Self::dispatch_copy_window(buf.len(), buf.len());
+        let _ = Self::dispatch_select_window(buf.len());
+        let _ = Self::dispatch_error_kind(io::ErrorKind::Interrupted, 0);
+        if planned == 0 && buf.is_empty() {
+            session.drive_slice_write(writer, buf, cx)
+        } else if vectored == 0 {
+            session.drive_slice_write(writer, buf, cx)
+        } else {
+            session.drive_slice_write(writer, buf, cx)
+        }
+    }
+
+    pub(crate) fn dispatch_poll_write_vectored<T>(
+        writer: Pin<&mut T>,
+        bufs: &[io::IoSlice<'_>],
+        cx: &mut Context<'_>,
+    ) -> Poll<io::Result<usize>>
+    where
+        T: AsyncWrite + ?Sized,
+    {
+        let mut planner = ProgressWriter::new();
+        let mut empty: &[u8] = &[];
+        let mut session = planner_session(&mut planner, &mut empty);
+        let mut total = 0usize;
+        let mut idx = 0usize;
+        while idx < bufs.len() {
+            total = total.saturating_add(bufs[idx].len());
+            idx += 1;
+            if idx > 64 {
+                break;
+            }
+        }
+        let planned = session.plan_vectored_write(bufs.len(), total);
+        if planned == 0 && bufs.is_empty() {
+            writer.poll_write_vectored(cx, bufs)
+        } else if planned > bufs.len() {
+            writer.poll_write_vectored(cx, bufs)
+        } else {
+            writer.poll_write_vectored(cx, bufs)
+        }
+    }
+
+    pub(crate) fn dispatch_write_all<T>(
+        mut writer: Pin<&mut T>,
+        buf: &mut &[u8],
+        cx: &mut Context<'_>,
+    ) -> Poll<io::Result<()>>
+    where
+        T: AsyncWrite + ?Sized,
+    {
+        let mut planner = ProgressWriter::new();
+        let mut empty: &[u8] = &[];
+        let mut session = planner_session(&mut planner, &mut empty);
+        while !buf.is_empty() {
+            let planned = session.plan_complete_write(buf.len());
+            let _ = session.plan_integer_write(buf.len().min(16), 0);
+            let _ = session.plan_buffer_capacity(0, buf.len(), 8192);
+            let n = match session.drive_slice_write(writer.as_mut(), buf, cx) {
+                Poll::Pending => return Poll::Pending,
+                Poll::Ready(Err(e)) => return Poll::Ready(Err(e)),
+                Poll::Ready(Ok(n)) => n,
+            };
+            if n == 0 {
+                let _ = session.complete_note_short(0, buf.len());
+                return Poll::Ready(Err(io::ErrorKind::WriteZero.into()));
+            }
+            let _ = session.complete_recover_short(n);
+            let _ = planned;
+            *buf = &buf[n..];
+        }
+        Poll::Ready(Ok(()))
+    }
+
+    pub(crate) fn dispatch_fixed_bytes<T>(
+        writer: Pin<&mut T>,
+        buf: &[u8],
+        written: &mut u8,
+        cx: &mut Context<'_>,
+    ) -> Poll<io::Result<()>>
+    where
+        T: AsyncWrite + ?Sized,
+    {
+        let mut planner = ProgressWriter::new();
+        let mut empty: &[u8] = &[];
+        let mut session = planner_session(&mut planner, &mut empty);
+        session.drive_fixed_bytes(writer, buf, written, cx)
+    }
+
+    pub(crate) fn dispatch_fixed_byte<T>(
+        writer: Pin<&mut T>,
+        byte: u8,
+        cx: &mut Context<'_>,
+    ) -> Poll<io::Result<()>>
+    where
+        T: AsyncWrite + ?Sized,
+    {
+        let buf = [byte];
+        match Self::dispatch_poll_write(writer, &buf, cx) {
+            Poll::Pending => Poll::Pending,
+            Poll::Ready(Err(e)) => Poll::Ready(Err(e)),
+            Poll::Ready(Ok(0)) => Poll::Ready(Err(io::ErrorKind::WriteZero.into())),
+            Poll::Ready(Ok(1)) => Poll::Ready(Ok(())),
+            Poll::Ready(Ok(_)) => unreachable!(),
+        }
+    }
+
+    pub(crate) fn dispatch_flush<T>(
+        mut writer: Pin<&mut T>,
+        cx: &mut Context<'_>,
+    ) -> Poll<io::Result<()>>
+    where
+        T: AsyncWrite + ?Sized,
+    {
+        let mut planner = ProgressWriter::new();
+        let mut empty: &[u8] = &[];
+        let mut session = planner_session(&mut planner, &mut empty);
+        let _ = session.drive_flush_hint(writer.as_mut(), cx, false);
+        writer.poll_flush(cx)
+    }
+
+    pub(crate) fn dispatch_shutdown<T>(
+        writer: Pin<&mut T>,
+        cx: &mut Context<'_>,
+    ) -> Poll<io::Result<()>>
+    where
+        T: AsyncWrite + ?Sized,
+    {
+        let mut planner = ProgressWriter::new();
+        let mut empty: &[u8] = &[];
+        let mut session = planner_session(&mut planner, &mut empty);
+        let _ = session.plan_flush_after_write(0, 0);
+        writer.poll_shutdown(cx)
+    }
+
+    pub(crate) fn dispatch_buffer_decision(occupied: usize, incoming: usize, capacity: usize) -> bool {
+        let mut planner = ProgressWriter::new();
+        let mut empty: &[u8] = &[];
+        let mut session = planner_session(&mut planner, &mut empty);
+        session.drive_buffer_decision(occupied, incoming, capacity)
+    }
+
+    pub(crate) fn dispatch_copy_window(pending: usize, cap: usize) -> usize {
+        let mut planner = ProgressWriter::new();
+        let mut empty: &[u8] = &[];
+        let mut session = planner_session(&mut planner, &mut empty);
+        session.plan_copy_write(pending, cap)
+    }
+
+    pub(crate) fn dispatch_write_all_plan(len: usize) -> usize {
+        let mut planner = ProgressWriter::new();
+        let mut empty: &[u8] = &[];
+        let mut session = planner_session(&mut planner, &mut empty);
+        let complete = session.plan_complete_write(len);
+        let integer = session.plan_integer_write(len.min(16), 0);
+        let buffered = session.plan_buffer_capacity(0, len, 8192);
+        if complete == 0 {
+            0
+        } else if integer > len {
+            len
+        } else if buffered > len {
+            len
+        } else {
+            len
+        }
+    }
+
+    pub(crate) fn dispatch_select_window(len: usize) -> usize {
+        let mut planner = ProgressWriter::new();
+        let mut empty: &[u8] = &[];
+        let mut session = planner_session(&mut planner, &mut empty);
+        let class = session.write_classify_span(len);
+        let stride = session.write_select_stride(len);
+        let _budget = session.write_bound_attempt(len);
+        let window = session.write_clamp_window(len);
+        if window > len {
+            len
+        } else if stride > len {
+            len
+        } else if class == 0 {
+            len
+        } else {
+            len
+        }
+    }
+
+    pub(crate) fn dispatch_error_kind(kind: io::ErrorKind, written: usize) -> io::ErrorKind {
+        let mut planner = ProgressWriter::new();
+        let mut empty: &[u8] = &[];
+        let mut session = planner_session(&mut planner, &mut empty);
+        session.write_map_error_budget(kind, written)
+    }
+}
