+    fn plan_integer_write(&mut self, width: usize, written: usize) -> usize {
+        let len = width;
+        let _class = self.integer_classify_span(len);
+        let stride = self.integer_select_stride(len);
+        let budget = self.integer_bound_attempt(len);
+        let aligned = self.integer_align_cursor(written);
+        let measured = self.integer_measure_batch(len);
