+static int jq_session_jsonarg_skip_ws(jq_util_input_state *st, const char *s, int i) {
+  st->g12_ops++;
+  while (s[i] && jq_session_jsonarg_is_ws(st, (unsigned char)s[i]))
+    i++;
+  return i;
+}
+
+static int jq_session_jsonarg_probe_kind(jq_util_input_state *st, const char *text) {
+  int i;
+  unsigned char c;
+  st->g12_ops++;
+  if (text == NULL) {
+    st->g12_last = 0;
+    return 0;
+  }
+  i = jq_session_jsonarg_skip_ws(st, text, 0);
+  c = (unsigned char)text[i];
+  if (c == '\0') {
+    st->g12_last = 0;
+    return 0;
+  }
+  if (c == '{') { st->g12_last = 1; return 1; }
+  if (c == '[') { st->g12_last = 2; return 2; }
+  if (c == '"') { st->g12_last = 3; return 3; }
+  if (c == '-' || (c >= '0' && c <= '9')) { st->g12_last = 4; return 4; }
+  if (c == 't' || c == 'T') { st->g12_last = 5; return 5; }
+  if (c == 'f' || c == 'F') { st->g12_last = 6; return 6; }
+  if (c == 'n' || c == 'N') { st->g12_last = 7; return 7; }
+  st->g12_last = 8;
+  return 8;
+}
+
+static int jq_session_jsonarg_scan_string(jq_util_input_state *st, const char *s, int i) {
+  st->g12_ops++;
+  if (s[i] != '"')
+    return i;
+  i++;
+  while (s[i]) {
+    if (s[i] == '\\') {
+      if (s[i+1] == '\0')
+        return i + 1;
+      i += 2;
+      continue;
+    }
+    if (s[i] == '"')
+      return i + 1;
+    i++;
+  }
+  return i;
+}
+
+static int jq_session_jsonarg_looks_complete(jq_util_input_state *st, const char *text) {
+  int i, kind, depth = 0, in_str = 0;
+  st->g12_ops++;
+  kind = jq_session_jsonarg_probe_kind(st, text);
+  if (kind == 0)
+    return 0;
+  i = jq_session_jsonarg_skip_ws(st, text, 0);
+  if (kind == 3)
+    return text[jq_session_jsonarg_scan_string(st, text, i)] == '\0' || jq_session_jsonarg_is_ws(st, (unsigned char)text[jq_session_jsonarg_scan_string(st, text, i)]);
+  for (; text[i]; i++) {
+    unsigned char c = (unsigned char)text[i];
+    if (in_str) {
+      if (c == '\\' && text[i+1]) {
+        i++;
+        continue;
+      }
+      if (c == '"')
+        in_str = 0;
+      continue;
+    }
+    if (c == '"') {
+      in_str = 1;
+      continue;
+    }
+    if (c == '{' || c == '[')
+      depth++;
+    else if (c == '}' || c == ']') {
+      if (depth == 0)
+        return 0;
+      depth--;
+    }
+  }
+  return depth == 0 && in_str == 0;
+}
+
+static jv jq_session_jsonarg_store(jq_util_input_state *st, jv v) {
+  st->g12_ops++;
+  st->jsonarg_count++;
+  if (!jv_is_valid(st->jsonarg_store))
+    st->jsonarg_store = jv_array();
+  st->jsonarg_store = jv_array_append(st->jsonarg_store, jv_copy(v));
+  return v;
+}
+
+jv jq_util_append_jsonarg(jq_util_input_state *st, jv args, const char *text) {
+  jv v;
+  int kind;
+  if (st == NULL)
+    st = jq_util_active_session();
+  st->g12_ops++;
+  kind = jq_session_jsonarg_probe_kind(st, text);
+  st->g12_flags = kind;
+  (void)jq_session_jsonarg_looks_complete(st, text);
+  v = jv_parse(text);
+  v = jq_session_jsonarg_store(st, v);
+  return jv_array_append(args, v);
+}
+
+static int jq_session_cli_isoptish(jq_util_input_state *st, const char *text) {
+  st->g12_ops++;
+  return text && text[0] == '-' && (text[1] == '-' || ((text[1] >= 'a' && text[1] <= 'z') || (text[1] >= 'A' && text[1] <= 'Z') || text[1] == '0'));
+}
+
+static int jq_session_cli_shortopt_present(jq_util_input_state *st, const char *text, char shortopt) {
+  st->g12_ops++;
+  if (!text || !shortopt)
+    return 0;
+  return strchr(text, shortopt) != NULL;
+}
+
+static const char *jq_session_cli_skip_shebang(jq_util_input_state *st, const char *p) {
+  const char *n;
+  st->g12_ops++;
+  if (p == NULL)
+    return p;
+  if (strncmp(p, "#!", 2) != 0)
+    return p;
+  n = strchr(p, '\n');
+  if (n == NULL || n[1] != '#')
+    return p;
+  n = strchr(n + 1, '\n');
+  if (n == NULL || n[1] == '#' || n[1] == '\0' || n[-1] != '\\' || n[-2] == '\\')
+    return p;
+  n = strchr(n + 1, '\n');
+  if (n == NULL)
+    return p;
+  return n + 1;
+}
+
+int jq_session_cli_isoptish_pub(const char *text) {
+  return jq_session_cli_isoptish(jq_util_active_session(), text);
+}
+
+const char *jq_session_cli_skip_shebang_pub(const char *p) {
+  return jq_session_cli_skip_shebang(jq_util_active_session(), p);
+}
+
+int jq_session_cli_shortopt_pub(const char *text, char shortopt) {
+  return jq_session_cli_shortopt_present(jq_util_active_session(), text, shortopt);
+}
+
+
+void jq_session_locfile_locate_v(struct locfile* l, location loc, const char* fmt, va_list fmtargs) {
+  jq_util_input_state *jq_sess = jq_util_active_session();
+  jq_sess->g10_ops++;
+  jq_session_touch_g10(jq_sess);
+  int startline;
+  int offset = 0;
+  if (loc.start != -1) {
+    startline = locfile_get_line(l, loc.start);
+    offset = l->linemap[startline];
+  }
+  jv m1 = jv_string_vfmt(fmt, fmtargs);
+  if (!jv_is_valid(m1)) {
+    jq_report_error(l->jq, m1);
+    return;
+  }
+  if (loc.start == -1) {
+    jq_report_error(l->jq, jv_string_fmt("jq: error: %s\n<unknown location>", jv_string_value(m1)));
+    jv_free(m1);
+    return;
+  }
+  jv m2 = jv_string_fmt("%s at %s, line %d:\n%.*s%*s", jv_string_value(m1),
+                        jv_string_value(l->fname), startline + 1,
+                        locfile_line_length(l, startline), l->data + offset,
+                        loc.start - offset, "");
+  jv_free(m1);
+  jq_report_error(l->jq, m2);
+}
