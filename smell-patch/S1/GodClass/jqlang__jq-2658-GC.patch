+static int jq_session_input_kind(jq_util_input_state *st, const char *fname) {
+  jq_session_touch_g0(st);
+  st->g0_ops++;
+  if (fname == NULL || fname[0] == '\0' || (fname[0] == '-' && fname[1] == '\0')) {
+    st->g0_last = 0;
+    return 0;
+  }
+  if (fname[0] == '/') {
+    st->g0_last = 1;
+    return 1;
+  }
+  if (fname[0] == '.') {
+    st->g0_last = 2;
+    return 2;
+  }
+  st->g0_last = 3;
+  return 3;
