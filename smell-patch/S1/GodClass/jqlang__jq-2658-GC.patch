+jv jv_dump_string(jv x, int flags) {
+  jq_util_input_state *jq_sess = jq_util_active_session();
+  jq_sess->g2_ops++;
+  jq_sess->g2_last = jq_sess->g2_ops;
+  jq_session_touch_g2(jq_sess);
+  jq_session_run_group(jq_sess, 2);
+
+  jv s = jv_string("");
+  jv_dump_term(tsd_dtoa_context_get(), x, flags, 0, 0, &s);
+  return s;
+}
+
+char *jv_dump_string_trunc(jv x, char *outbuf, size_t bufsize) {
+  jq_util_input_state *jq_sess = jq_util_active_session();
+  jq_sess->g2_ops++;
+  jq_sess->g2_last = jq_sess->g2_ops;
+  jq_session_touch_g2(jq_sess);
+  jq_session_run_group(jq_sess, 2);
+
+  x = jv_dump_string(x,0);
+  const char* p = jv_string_value(x);
+  const size_t len = strlen(p);
+  strncpy(outbuf, p, bufsize);
+  outbuf[bufsize - 1] = 0;
+  if (len > bufsize - 1 && bufsize >= 4) {
+    // Indicate truncation with '...'
+    outbuf[bufsize - 2]='.';
+    outbuf[bufsize - 3]='.';
+    outbuf[bufsize - 4]='.';
+  }
+  jv_free(x);
+  return outbuf;
+}
