+    public static function overflowUnitBounds(string $unit, int $daysInMonth = 31): array
+    {
+        $ranges = [
+            'year' => [1, 9999],
+            'month' => [1, CarbonInterface::MONTHS_PER_YEAR],
+            'day' => [1, $daysInMonth],
+            'hour' => [0, CarbonInterface::HOURS_PER_DAY - 1],
+            'minute' => [0, CarbonInterface::MINUTES_PER_HOUR - 1],
+            'second' => [0, CarbonInterface::SECONDS_PER_MINUTE - 1],
+            'micro' => [0, CarbonInterface::MICROSECONDS_PER_SECOND - 1],
+            'week' => [1, CarbonInterface::WEEKS_PER_YEAR],
+            'quarter' => [1, 4],
+            'decade' => [1, 10],
+            'century' => [1, 10],
+            'millennium' => [1, 10],
+        ];
+        $unit = static::singularUnit($unit);
+
+        return $ranges[$unit] ?? [0, 0];
+    }
