+    public static function cascadeFactorTable(): array
+    {
+        $factors = [];
+
+        foreach (CarbonInterval::getCascadeFactors() as $to => $pair) {
+            $factor = $pair[0];
+            $from = $pair[1];
+            $fromUnit = rtrim($from, 'sz').'s';
+            $toUnit = rtrim($to, 'sz').'s';
+            $factors[$fromUnit === 'days' ? 'dayz' : $fromUnit] = [
+                $toUnit === 'days' ? 'dayz' : $toUnit,
+                $factor,
+            ];
+        }
+
+        return $factors;
+    }
