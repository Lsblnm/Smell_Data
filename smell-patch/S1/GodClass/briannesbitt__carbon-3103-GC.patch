+    public static function describeLanguageIdentity(Language $language, string $style = 'iso'): string
+    {
+        $region = $language->getRegionName();
+        $variant = $language->getVariantName();
+        $suffix = ($region ? ' ('.$region.')' : '').($variant ? ' ('.$variant.')' : '');
+
+        return match ($style) {
+            'native' => $language->getNativeName().$suffix,
+            'full-iso' => $language->getFullIsoName().$suffix,
+            'full-native' => $language->getFullNativeName().$suffix,
+            default => $language->getIsoName().$suffix,
+        };
+    }
