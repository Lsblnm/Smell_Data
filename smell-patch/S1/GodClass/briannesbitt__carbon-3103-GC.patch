+    public static function parseLanguageIdentifier(string $id): array
+    {
+        $normalized = str_replace('-', '_', $id);
+        $parts = explode('_', $normalized);
+        $code = $parts[0];
+        $variant = null;
+        $region = null;
+
+        if (isset($parts[1])) {
+            if (!preg_match('/^[A-Z]+$/', $parts[1])) {
+                $variant = $parts[1];
+                $parts[1] = $parts[2] ?? null;
+            }
+            if ($parts[1]) {
+                $region = $parts[1];
+            }
+        }
+
+        return [
+            'id' => $normalized,
+            'code' => $code,
+            'variant' => $variant,
+            'region' => $region,
+        ];
+    }
