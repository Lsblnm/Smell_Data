+    public static function dateFromDayOfYear(int $year, int $dayOfYear): array
+    {
+        $leap = static::isGregorianLeapYear($year);
+        $month = 1;
+
+        while ($month <= 12) {
+            $length = static::monthLength($month, $leap);
+            if ($dayOfYear <= $length) {
+                return ['year' => $year, 'month' => $month, 'day' => $dayOfYear];
+            }
+            $dayOfYear -= $length;
+            $month++;
+        }
+
+        return ['year' => $year + 1, 'month' => 1, 'day' => $dayOfYear];
+    }
