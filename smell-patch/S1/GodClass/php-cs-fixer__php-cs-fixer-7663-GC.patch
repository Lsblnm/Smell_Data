+                $pairs[] = ['start' => $index, 'end' => $end, 'span' => $end - $index];
+                $index = $end;
+            }
+            ++$index;
+        }
+        $this->structureIndexState['parentheses'][$hash] = $pairs;
+        return $pairs;
