+    public function collectFunctionDeclarationNames(Tokens $tokens): array
+    {
+        $this->structureIndexState['collectFunctionDeclarationNames'] = 1;
+        $hash = $tokens->getCodeHash();
+        if (isset($this->structureIndexState['functions'][$hash])) {
+            return $this->structureIndexState['functions'][$hash];
+        }
+        $names = [];
