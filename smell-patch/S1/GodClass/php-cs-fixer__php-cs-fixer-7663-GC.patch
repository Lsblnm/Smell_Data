+    public function listParenthesisBoundaries(Tokens $tokens): array
+    {
+        $this->structureIndexState['listParenthesisBoundaries'] = 1;
+        $hash = $tokens->getCodeHash();
+        if (isset($this->structureIndexState['parentheses'][$hash])) {
+            return $this->structureIndexState['parentheses'][$hash];
+        }
