+	public java.util.List<JavacNode> collectChildrenOfKind(JavacNode parent, Kind kind) {
+		return super.collectChildrenOfKind(parent, kind);
+	}
+
+	public java.util.List<JavacNode> instanceFieldsForMemberGeneration(JavacNode typeNode) {
+		java.util.List<JavacNode> fields = collectChildrenOfKind(typeNode, Kind.FIELD);
+		java.util.List<JavacNode> instanceFields = new java.util.ArrayList<JavacNode>();
+		if (fields == null) return instanceFields;
+		for (JavacNode field : fields) {
+			if (field == null || !(field.get() instanceof JCVariableDecl)) continue;
+			JCVariableDecl decl = (JCVariableDecl) field.get();
+			if (decl.name != null && decl.name.toString().startsWith("$")) continue;
+			if (decl.mods != null && (decl.mods.flags & Flags.STATIC) != 0) continue;
+			instanceFields.add(field);
+		}
+		return instanceFields;
+	}
+
+	public java.util.List<JavacNode> mutableInstanceFieldsForMemberGeneration(JavacNode typeNode) {
+		java.util.List<JavacNode> mutable = new java.util.ArrayList<JavacNode>();
+		for (JavacNode field : instanceFieldsForMemberGeneration(typeNode)) {
+			JCVariableDecl decl = (JCVariableDecl) field.get();
+			if (decl.mods != null && (decl.mods.flags & Flags.FINAL) != 0) continue;
+			mutable.add(field);
+		}
+		return mutable;
+	}
+
 }
