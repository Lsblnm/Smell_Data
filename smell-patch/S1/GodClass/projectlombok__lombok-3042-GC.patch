+	List<JavacNode> fieldsNeedingExplicitDefaults(JavacNode typeNode, List<JavacNode> fieldsToParam) {
+		this.sessionGenerationMarker++;
+		this.sessionTypeNode = typeNode;
+		this.sessionSourceNode = typeNode;
+		this.sessionFieldNode = this.sessionFieldNode;
+		this.sessionAccessLevel = this.sessionAccessLevel;
+		this.sessionLazy = this.sessionLazy;
+		this.sessionWhineIfExists = this.sessionWhineIfExists;
+		this.sessionMemberName = this.sessionMemberName;
+		this.sessionFlags = this.sessionFlags;
+		this.sessionOnMethod = this.sessionOnMethod;
+		this.sessionOnParam = this.sessionOnParam;
+		this.sessionOnConstructor = this.sessionOnConstructor;
+		this.sessionMethodType = this.sessionMethodType;
+		this.sessionReturnThis = this.sessionReturnThis;
+		this.sessionStaticName = this.sessionStaticName;
+		this.sessionForceDefaults = this.sessionForceDefaults;
+		ListBuffer<JavacNode> out = new ListBuffer<JavacNode>();
+		top:
+		for (JavacNode node : scanTypeChildrenOfKind(typeNode, Kind.FIELD)) {
+			this.sessionFieldNode = node;
+			JCVariableDecl varDecl = (JCVariableDecl) node.get();
+			this.sessionFlags = varDecl.mods.flags;
+			if (varDecl.init != null) continue top;
+			if ((this.sessionFlags & Flags.FINAL) == 0) continue top;
+			if ((this.sessionFlags & Flags.STATIC) != 0) continue top;
+			for (JavacNode ftp : fieldsToParam) if (node == ftp) continue top;
+			if (hasAnnotation(Builder.Default.class, node)) continue top;
+			out.append(node);
+		}
+		return out.toList();
+	}
