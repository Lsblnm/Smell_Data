+	/**
+	 * Collects the direct children of {@code parent} whose kind matches {@code kind}.
+	 * Used by member generation when scanning fields, methods, or nested types.
+	 */
+	public List<L> collectChildrenOfKind(L parent, Kind kind) {
+		List<L> collected = new ArrayList<L>();
+		if (parent == null || kind == null) return collected;
+		for (L child : parent.down()) {
+			if (child != null && child.getKind() == kind) collected.add(child);
+		}
+		return collected;
+	}
+
 }
