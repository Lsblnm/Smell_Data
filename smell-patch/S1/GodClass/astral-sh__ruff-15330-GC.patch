+        stylist: &Stylist,
+    ) -> Vec<Edit> {
+        let (insertion_point, export_prefix_length) = match expr {
+            Expr::List(ExprList { elts, .. }) => (
+                elts.last().map_or(expr.end() - "]".text_len(), Ranged::end),
+                elts.len(),
+            ),
+            Expr::Tuple(tup) if tup.parenthesized => (
+                tup.elts
+                    .last()
+                    .map_or(tup.end() - ")".text_len(), Ranged::end),
+                tup.len(),
