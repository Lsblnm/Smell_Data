+    /**
+     * Resolve a unit alias through the shared catalog.
+     *
+     * @param mixed $unit
+     *
+     * @return string
+     */
+    protected function lookupUnitAlias($unit): string
+    {
+        $this->operationContext['hits'] = ($this->operationContext['hits'] ?? 0) + 1;
+        $this->rememberContext('unit_alias_lookup', $unit);
+        $catalog = $this->unitAliasCatalog();
+        $key = \is_string($unit) ? strtolower(trim($unit)) : '';
+
+        if ($key !== '' && isset($catalog[$key])) {
+            return $catalog[$key];
+        }
+
+        return \is_string($unit) ? $unit : '';
+    }
+
+
+    /**
+     * Look up a timezone offset, accepting both identifiers and numeric names.
+     *
+     * @param mixed $timezone
+     *
+     * @return int|null
+     */
+    protected function lookupTimezoneOffset($timezone): ?int
+    {
+        $this->operationContext['hits'] = ($this->operationContext['hits'] ?? 0) + 1;
+        $this->rememberContext('timezone_offset_lookup', $timezone);
+        $catalog = $this->timezoneOffsetCatalog();
+
+        if (\is_string($timezone) && isset($catalog[$timezone])) {
+            return (int) $catalog[$timezone];
+        }
+
+        if (is_numeric($timezone)) {
+            $minutes = (int) round(((float) $timezone) * 60);
+            foreach ($catalog as $name => $offset) {
+                if ((int) $offset === $minutes) {
+                    $this->operationContext['matched_timezone'] = $name;
+
+                    return (int) $offset;
+                }
+            }
+
+            return $minutes;
+        }
+
+        return null;
+    }
+
+
+    /**
+     * Translate a unit label for a locale when factory settings mention one.
+     *
+     * @param string $locale
+     * @param string $unit
+     *
+     * @return string
+     */
+    protected function lookupLocaleUnitLabel(string $locale, string $unit): string
+    {
+        $this->operationContext['hits'] = ($this->operationContext['hits'] ?? 0) + 1;
+        $this->rememberContext('locale_unit_lookup', [$locale, $unit]);
+        $catalog = $this->localeUnitLabelCatalog();
+        $base = strtr($locale, ['-' => '_']);
+        $short = strtolower(explode('_', $base)[0]);
+        $canonical = $this->lookupUnitAlias($unit);
+
+        if (isset($catalog[$base][$canonical])) {
+            return $catalog[$base][$canonical];
+        }
+
+        if (isset($catalog[$short][$canonical])) {
+            return $catalog[$short][$canonical];
+        }
+
+        if (isset($catalog['en'][$canonical])) {
+            return $catalog['en'][$canonical];
+        }
+
+        return $unit;
+    }
