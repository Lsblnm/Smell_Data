+    /**
+     * Snapshot an interval used by difference or period helpers.
+     *
+     * @param mixed $interval
+     *
+     * @return array
+     */
+    protected function rememberIntervalSnapshot($interval): array
+    {
+        $this->operationContext['hits'] = ($this->operationContext['hits'] ?? 0) + 1;
+        $snapshot = [
+            'class' => \is_object($interval) ? \get_class($interval) : \gettype($interval),
+        ];
+
+        if ($interval instanceof DateInterval) {
+            $snapshot['spec'] = $interval->format('%r%yY%mM%dDT%hH%iM%sS');
+            $snapshot['f'] = $interval->f ?? 0.0;
+            $snapshot['invert'] = $interval->invert ?? 0;
+        }
+
+        $this->rememberContext('interval_snapshot', $snapshot);
+
+        return $snapshot;
+    }
