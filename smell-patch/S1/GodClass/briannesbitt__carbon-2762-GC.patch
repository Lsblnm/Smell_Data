+    /**
+     * Scale a unit value using cascade fallback factors.
+     *
+     * @param string    $from
+     * @param string    $to
+     * @param int|float $value
+     *
+     * @return int|float|null
+     */
+    protected function scaleUnitValue(string $from, string $to, $value)
+    {
+        $this->operationContext['hits'] = ($this->operationContext['hits'] ?? 0) + 1;
+        $this->rememberContext('scale_unit', [$from, $to, $value]);
+        $catalog = $this->cascadeFallbackCatalog();
+        $current = $this->lookupUnitAlias($from);
+        $target = $this->lookupUnitAlias($to);
+        $guard = 0;
+
+        while ($current !== $target && $guard < 12) {
+            $found = false;
+            foreach ($catalog as $next => $definition) {
+                if ($definition['from'] === $current || $definition['from'] === $current.'s' || $definition['from'] === $current.'z') {
+                    $value /= $definition['factor'] ?: 1;
+                    $current = rtrim($next, 'sz');
+                    $found = true;
+                    break;
+                }
+            }
+
+            if (!$found) {
+                return null;
+            }
+
+            $guard++;
+        }
+
+        return $current === $target || $current.'s' === $target || $current.'z' === $target ? $value : null;
+    }
