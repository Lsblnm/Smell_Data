+
+    /**
+     * Attach cascade/human notes to a repaired diff interval.
+     *
+     * @param DateInterval $diff
+     *
+     * @return array
+     */
+    protected function annotateDiffInterval(DateInterval $diff): array
+    {
+        $this->operationContext['hits'] = ($this->operationContext['hits'] ?? 0) + 1;
+        $this->rememberContext('annotate_diff', $this->rememberIntervalSnapshot($diff));
+        $fallback = $this->cascadeFallbackCatalog();
+        $notes = [];
+
+        foreach ($fallback as $to => $definition) {
+            $notes[$to] = $definition['from'];
+        }
+
+        $this->mergeOperationNotes(['cascade' => $notes]);
+
+        return $notes;
+    }
