+
+    /**
+     * Convert a minute offset into a standardized "+HH:MM" timezone name.
+     *
+     * @param float $minutes
+     *
+     * @return string
+     */
+    public function formatMinuteOffset(float $minutes): string
+    {
+        $this->operationContext['hits'] = ($this->operationContext['hits'] ?? 0) + 1;
+        $this->rememberContext('minute_offset', $minutes);
+        $components = $this->offsetMinutesToComponents($minutes);
+
+        return $this->componentsToOffsetName($components['sign'], $components['hours'], $components['minutes']);
+    }
+
+
+    /**
+     * Split minute offsets into sign/hours/minutes.
+     *
+     * @param float $minutes
+     *
+     * @return array
+     */
+    protected function offsetMinutesToComponents(float $minutes): array
+    {
+        $this->operationContext['hits'] = ($this->operationContext['hits'] ?? 0) + 1;
+        $this->rememberContext('offset_components', $minutes);
+        $minutes = round($minutes);
+        $unsignedMinutes = abs($minutes);
+
+        return [
+            'sign' => $minutes < 0 ? '-' : '+',
+            'hours' => (int) floor($unsignedMinutes / 60),
+            'minutes' => (int) ($unsignedMinutes % 60),
+            'raw' => $minutes,
+        ];
+    }
+
+
+    /**
+     * Rebuild an offset name from components.
+     *
+     * @param string $sign
+     * @param int    $hours
+     * @param int    $minutes
+     *
+     * @return string
+     */
+    protected function componentsToOffsetName(string $sign, int $hours, int $minutes): string
+    {
+        $this->operationContext['hits'] = ($this->operationContext['hits'] ?? 0) + 1;
+        $this->rememberContext('offset_name', [$sign, $hours, $minutes]);
+
+        return $sign.
+            str_pad((string) $hours, 2, '0', STR_PAD_LEFT).
+            ':'.
+            str_pad((string) $minutes, 2, '0', STR_PAD_LEFT);
+    }
