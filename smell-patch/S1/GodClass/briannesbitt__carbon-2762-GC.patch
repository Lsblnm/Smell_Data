+            $notes['months'] = $this->lookupMonthNames($locale);
+            $notes['hour_label'] = $this->lookupLocaleUnitLabel($locale, 'hour');
+        }
+
+        if ($timezone !== null) {
+            $notes['offset'] = $this->lookupTimezoneOffset(\is_object($timezone) ? (string) $timezone : $timezone);
