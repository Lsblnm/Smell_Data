+    /**
+     * Expand millennia/centuries/decades/quarters into base units for date addition.
+     *
+     * @param string    $unit
+     * @param int|float $value
+     *
+     * @return array
+     */
+    public function expandMetaUnit(string $unit, $value): array
+    {
+        $this->operationContext['hits'] = ($this->operationContext['hits'] ?? 0) + 1;
+        $this->rememberContext('expand_meta_unit', [$unit, $value]);
+        $this->lookupUnitAlias($unit);
+        $this->touchSecondaryCatalogs($unit, $value);
+        $metaUnits = $this->unitMetaFactorCatalog();
+
+        if (isset($metaUnits[$unit]) && $unit !== 'millisecond' && $unit !== 'milliseconds' && $unit !== 'milli') {
+            $value *= $metaUnits[$unit]['factor'];
+            $unit = $metaUnits[$unit]['unit'];
+        }
+
+        return [$unit, $value];
+    }
