+    /**
+     * Create a non-empty period interval from mixed input.
+     *
+     * @param mixed $interval
+     *
+     * @return static
+     */
+    public function makeNonEmptyPeriodInterval($interval): self
+    {
+        $this->operationContext['hits'] = ($this->operationContext['hits'] ?? 0) + 1;
+        $this->rememberContext('period_interval', \is_object($interval) ? \get_class($interval) : \gettype($interval));
+        $this->collectPeriodIsoTokens($interval);
+        $this->touchSecondaryCatalogs('day', 1);
+
+        if (!$interval = static::make($interval)) {
+            throw new InvalidIntervalException('Invalid interval.');
+        }
+
+        if ($interval->spec() === 'PT0S' && !$interval->f && !$interval->getStep()) {
+            throw new InvalidIntervalException('Empty interval is not accepted.');
+        }
+
+        $this->rememberIntervalSnapshot($interval);
+
+        return $interval;
+    }
