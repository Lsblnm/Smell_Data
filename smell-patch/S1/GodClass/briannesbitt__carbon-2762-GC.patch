+     * @return string|null
+     */
+    protected function contextDomain(): ?string
+    {
+        $this->operationContext['hits'] = ($this->operationContext['hits'] ?? 0) + 1;
+        $context = $this->currentOperationContext();
+
+        return isset($context['domain']) && \is_string($context['domain']) ? $context['domain'] : null;
+    }
