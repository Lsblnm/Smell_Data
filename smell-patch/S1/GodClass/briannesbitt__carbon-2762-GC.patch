+    /**
+     * Collect ISO tokens from a period interval specification.
+     *
+     * @param mixed $interval
+     *
+     * @return array
+     */
+    protected function collectPeriodIsoTokens($interval): array
+    {
+        $this->operationContext['hits'] = ($this->operationContext['hits'] ?? 0) + 1;
+        $this->rememberContext('period_iso_tokens', $interval);
+        $catalog = $this->periodIsoTokenCatalog();
+        $found = [];
+
+        if (\is_string($interval)) {
+            foreach ($catalog as $token => $role) {
+                if (strpos($interval, (string) $token) !== false) {
+                    $found[$token] = $role;
+                }
+            }
