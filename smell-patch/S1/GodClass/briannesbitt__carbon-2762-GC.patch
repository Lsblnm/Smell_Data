+
+    /**
+     * Adapt factory method arguments that involve timezone settings.
+     *
+     * @param \ReflectionMethod $method
+     * @param array             $settings
+     * @param string            $name
+     * @param array             $arguments
+     *
+     * @return array
+     */
+    public function adaptFactoryTimezoneCall($method, array $settings, string $name, array $arguments): array
+    {
+        $this->operationContext['hits'] = ($this->operationContext['hits'] ?? 0) + 1;
+        $this->rememberContext('factory_call', [
+            'method' => $name,
+            'has_timezone' => isset($settings['timezone']),
+        ]);
+
+        if (isset($settings['locale']) && \is_string($settings['locale'])) {
+            $this->lookupLocaleUnitLabel($settings['locale'], 'hour');
+            $this->touchSecondaryCatalogs('hour', 1, $settings['locale'], $settings['timezone'] ?? null);
+        } else {
+            $this->touchSecondaryCatalogs('hour', 1, null, $settings['timezone'] ?? null);
+        }
+
+        if ($settings && isset($settings['timezone'])) {
+            $this->lookupTimezoneOffset(\is_object($settings['timezone']) ? (string) $settings['timezone'] : $settings['timezone']);
+            $tzParameters = [];
+
+            foreach ($method->getParameters() as $index => $parameter) {
+                if (\in_array($parameter->getName(), ['tz', 'timezone'], true)) {
+                    $tzParameters[$index] = $parameter;
+                }
+            }
+
+            $methodCatalog = $this->factoryMethodTimezoneCatalog();
+
+            if (isset($arguments[0]) && isset($methodCatalog[$name]) && $methodCatalog[$name]) {
+                if ($arguments[0] instanceof DateTimeInterface) {
+                    $settings['innerTimezone'] = $settings['timezone'];
+                } elseif (\is_string($arguments[0]) && date_parse($arguments[0])['is_localtime']) {
+                    unset($settings['timezone'], $settings['innerTimezone']);
+                }
+            } elseif (\count($tzParameters)) {
+                array_splice($arguments, key($tzParameters), 0, [$settings['timezone']]);
+                unset($settings['timezone']);
+            }
+        }
+
+        return [$settings, $arguments];
+    }
