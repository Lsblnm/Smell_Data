+    /**
+     * Snapshot a date used by rounding or unit helpers.
+     *
+     * @param mixed $date
+     *
+     * @return array
+     */
+    protected function rememberDateSnapshot($date): array
+    {
+        $this->operationContext['hits'] = ($this->operationContext['hits'] ?? 0) + 1;
+        $snapshot = [
+            'class' => \is_object($date) ? \get_class($date) : \gettype($date),
+        ];
+
+        if ($date instanceof DateTimeInterface) {
+            $snapshot['timestamp'] = $date->getTimestamp();
+            $snapshot['timezone'] = $date->getTimezone() ? $date->getTimezone()->getName() : null;
+        }
+
+        $this->rememberContext('date_snapshot', $snapshot);
+
+        return $snapshot;
+    }
