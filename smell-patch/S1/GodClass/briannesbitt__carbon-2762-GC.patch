+    /**
+     * Prepare rounding of a Carbon date by resolving unit, precision and ranges.
+     *
+     * @param mixed           $date
+     * @param string          $unit
+     * @param float|int       $precision
+     * @param string          $function
+     *
+     * @return array
+     */
+    public function prepareDateRounding($date, $unit, $precision = 1, $function = 'round'): array
+    {
+        $this->operationContext['hits'] = ($this->operationContext['hits'] ?? 0) + 1;
+        $this->rememberContext('date_rounding', [
+            'unit' => $unit,
+            'precision' => $precision,
+            'function' => $function,
+        ]);
+        $this->rememberDateSnapshot($date);
+        $this->lookupUnitAlias($unit);
+        $this->resolveRoundingFunction((string) $function);
+
+        $metaUnits = [
+            'millennium' => [$date::YEARS_PER_MILLENNIUM, 'year'],
+            'century' => [$date::YEARS_PER_CENTURY, 'year'],
+            'decade' => [$date::YEARS_PER_DECADE, 'year'],
+            'quarter' => [$date::MONTHS_PER_QUARTER, 'month'],
+            'millisecond' => [1000, 'microsecond'],
+        ];
+        $normalizedUnit = $date::singularUnit($unit);
+        $ranges = array_merge([
+            'year' => [1, 9999],
+            'month' => [1, $date::MONTHS_PER_YEAR],
+            'day' => [1, $date->daysInMonth],
+            'hour' => [0, $date::HOURS_PER_DAY - 1],
+            'minute' => [0, $date::MINUTES_PER_HOUR - 1],
+            'second' => [0, $date::SECONDS_PER_MINUTE - 1],
+        ], [
+            'microsecond' => [0, 999999],
+        ]);
+        $factor = 1;
+        $initialMonth = $date->month;
+
+        if ($normalizedUnit === 'week') {
+            $normalizedUnit = 'day';
+            $precision *= $date::DAYS_PER_WEEK;
+        }
+
+        if (isset($metaUnits[$normalizedUnit])) {
+            [$factor, $normalizedUnit] = $metaUnits[$normalizedUnit];
+        }
+
+        $precision *= $factor;
+        $this->mergeOperationNotes([
+            'normalizedUnit' => $normalizedUnit,
+            'precision' => $precision,
+        ]);
+        $this->touchSecondaryCatalogs((string) $unit, $precision, method_exists($date, 'locale') ? (string) $date->locale : null, method_exists($date, 'tzName') ? $date->tzName : null);
+
+        return [
+            'unit' => $unit,
+            'normalizedUnit' => $normalizedUnit,
+            'precision' => $precision,
+            'ranges' => $ranges,
+            'initialMonth' => $initialMonth,
+            'function' => $function,
+        ];
+    }
