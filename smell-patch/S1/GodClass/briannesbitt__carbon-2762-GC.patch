+    /**
+     * Normalize a precision value used by rounding helpers.
+     *
+     * @param mixed $precision
+     *
+     * @return float|int
+     */
+    protected function normalizePrecisionValue($precision)
+    {
+        $this->operationContext['hits'] = ($this->operationContext['hits'] ?? 0) + 1;
+        $this->rememberContext('precision', $precision);
+
+        if (is_numeric($precision)) {
+            $value = $precision + 0;
+
+            return $value == 0 ? 1 : $value;
+        }
+
+        return 1;
+    }
