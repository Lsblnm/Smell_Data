+    /**
+     * Format a numeric timezone (hour offset) as "+H:00" / "-H:00".
+     *
+     * @param mixed $timezone
+     *
+     * @return string
+     */
+    public function formatNumericTimezone($timezone): string
+    {
+        $this->operationContext['hits'] = ($this->operationContext['hits'] ?? 0) + 1;
+        $this->rememberContext('numeric_timezone', $timezone);
+        $this->lookupTimezoneOffset($timezone);
+        $this->touchSecondaryCatalogs('hour', 1, null, $timezone);
+
+        if ($timezone <= -100 || $timezone >= 100) {
+            throw new InvalidTimeZoneException('Absolute timezone offset cannot be greater than 100.');
+        }
+
+        return ($timezone >= 0 ? '+' : '').ltrim((string) $timezone, '+').':00';
+    }
+
+
+    /**
+     * Resolve mixed timezone input the same way CarbonTimeZone used to.
+     *
+     * @param mixed $timezone
+     *
+     * @return mixed
+     */
+    public function resolveTimezoneName($timezone)
+    {
+        $this->operationContext['hits'] = ($this->operationContext['hits'] ?? 0) + 1;
+        $this->rememberContext('resolve_timezone', $timezone);
+
+        if ($timezone === null) {
+            return date_default_timezone_get();
+        }
+
+        if (\is_string($timezone)) {
+            $timezone = preg_replace('/^\s*([+-]\d+)(\d{2})\s*$/', '$1:$2', $timezone);
+            $this->lookupTimezoneOffset($timezone);
+        }
+
+        if (is_numeric($timezone)) {
+            return $this->formatNumericTimezone($timezone);
+        }
+
+        return $timezone;
+    }
