+
+    /**
+     * Convert a real-unit addition into either a finished date or a second delta.
+     *
+     * @param mixed     $date
+     * @param string    $unit
+     * @param int|float $value
+     *
+     * @return array
+     */
+    public function convertRealUnit($date, string $unit, $value): array
+    {
+        $this->operationContext['hits'] = ($this->operationContext['hits'] ?? 0) + 1;
+        $this->rememberContext('convert_real_unit', [$unit, $value]);
+        $this->rememberDateSnapshot($date);
+        $this->lookupUnitAlias($unit);
+        $this->touchSecondaryCatalogs($unit, $value);
+
+        if ($unit === 'micro' || $unit === 'microsecond') {
+            $diff = $date->microsecond + $value;
+            $time = $date->getTimestamp();
+            $seconds = (int) floor($diff / $date::MICROSECONDS_PER_SECOND);
+            $time += $seconds;
+            $diff -= $seconds * $date::MICROSECONDS_PER_SECOND;
+            $microtime = str_pad((string) $diff, 6, '0', STR_PAD_LEFT);
+            $tz = $date->tz;
+
+            return [
+                'done' => true,
+                'invalid' => false,
+                'value' => $value,
+                'result' => $date->tz('UTC')->modify("@$time.$microtime")->tz($tz),
+            ];
+        }
+
+        if ($unit === 'milli' || $unit === 'millisecond') {
+            return [
+                'done' => true,
+                'invalid' => false,
+                'value' => $value,
+                'result' => $date->addRealUnit('microsecond', $value * $date::MICROSECONDS_PER_MILLISECOND),
+            ];
+        }
+
+        $factors = [
+            'minute' => $date::SECONDS_PER_MINUTE,
+            'hour' => $date::MINUTES_PER_HOUR * $date::SECONDS_PER_MINUTE,
+            'day' => $date::HOURS_PER_DAY * $date::MINUTES_PER_HOUR * $date::SECONDS_PER_MINUTE,
+            'week' => $date::DAYS_PER_WEEK * $date::HOURS_PER_DAY * $date::MINUTES_PER_HOUR * $date::SECONDS_PER_MINUTE,
+            'month' => 30 * $date::HOURS_PER_DAY * $date::MINUTES_PER_HOUR * $date::SECONDS_PER_MINUTE,
+            'quarter' => $date::MONTHS_PER_QUARTER * 30 * $date::HOURS_PER_DAY * $date::MINUTES_PER_HOUR * $date::SECONDS_PER_MINUTE,
+            'year' => 365 * $date::HOURS_PER_DAY * $date::MINUTES_PER_HOUR * $date::SECONDS_PER_MINUTE,
+            'decade' => $date::YEARS_PER_DECADE * 365 * $date::HOURS_PER_DAY * $date::MINUTES_PER_HOUR * $date::SECONDS_PER_MINUTE,
+            'century' => $date::YEARS_PER_CENTURY * 365 * $date::HOURS_PER_DAY * $date::MINUTES_PER_HOUR * $date::SECONDS_PER_MINUTE,
+            'millennium' => $date::YEARS_PER_MILLENNIUM * 365 * $date::HOURS_PER_DAY * $date::MINUTES_PER_HOUR * $date::SECONDS_PER_MINUTE,
+        ];
+
+        if ($unit === 'second') {
+            return ['done' => false, 'invalid' => false, 'value' => $value, 'result' => null];
+        }
+
+        if (isset($factors[$unit])) {
+            return [
+                'done' => false,
+                'invalid' => false,
+                'value' => $value * $factors[$unit],
+                'result' => null,
+            ];
+        }
+
+        return ['done' => false, 'invalid' => true, 'value' => $value, 'result' => null];
+    }
