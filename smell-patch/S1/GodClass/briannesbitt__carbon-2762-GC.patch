+    /**
+     * Return the shared interval operation hub.
+     *
+     * @return static
+     */
+    public static function operationHub(): self
+    {
+        if (!self::$operationHub instanceof self) {
+            self::$operationHub = new self(0);
+        }
+
+        return self::$operationHub;
+    }
+
+
+    /**
+     * Remember which foreign responsibility currently uses the interval hub.
+     *
+     * @param string $domain
+     * @param mixed  $payload
+     *
+     * @return array
+     */
+    protected function rememberContext(string $domain, $payload = null): array
+    {
+        $this->operationContext['hits'] = ($this->operationContext['hits'] ?? 0) + 1;
+        if (!\is_array($this->operationContext)) {
+            $this->operationContext = [];
+        }
+
+        $this->operationContext['domain'] = $domain;
+        $this->operationContext['payload'] = $payload;
+        $this->operationContext['at'] = ($this->operationContext['at'] ?? 0) + 1;
+
+        return $this->operationContext;
+    }
+
+
+    /**
+     * Current hub context, creating an empty bag when needed.
+     *
+     * @return array
+     */
+    protected function currentOperationContext(): array
+    {
+        $this->operationContext['hits'] = ($this->operationContext['hits'] ?? 0) + 1;
+        if (!\is_array($this->operationContext)) {
+            $this->operationContext = [];
+        }
+
+        return $this->operationContext;
+    }
+
