+
+    /**
+     * Repair negative microseconds on a diff interval.
+     *
+     * @param CarbonInterval $diff
+     */
+    public function repairNegativeMicroseconds(self $diff): void
+    {
+        $this->operationContext['hits'] = ($this->operationContext['hits'] ?? 0) + 1;
+        $this->rememberContext('repair_negative_microseconds', $this->rememberIntervalSnapshot($diff));
+
+        if ($diff->s !== 0 || $diff->i !== 0 || $diff->h !== 0 || $diff->d !== 0 || $diff->m !== 0 || $diff->y !== 0) {
+            $diff->f = (round($diff->f * 1000000) + 1000000) / 1000000;
+            $diff->s--;
+
+            if ($diff->s < 0) {
+                $diff->s += 60;
+                $diff->i--;
+
+                if ($diff->i < 0) {
+                    $diff->i += 60;
+                    $diff->h--;
+
+                    if ($diff->h < 0) {
+                        $diff->h += 24;
+                        $diff->d--;
+
+                        if ($diff->d < 0) {
+                            $diff->d += 30;
+                            $diff->m--;
+
+                            if ($diff->m < 0) {
+                                $diff->m += 12;
+                                $diff->y--;
+                            }
+                        }
+                    }
+                }
+            }
+
+            return;
+        }
+
+        $diff->f *= -1;
+        $diff->invert();
+    }
+
+
+    /**
+     * Normalize a raw DateInterval produced by DateTime::diff into a CarbonInterval.
+     *
+     * @param DateInterval $diff
+     * @param bool         $absolute
+     * @param array        $skip
+     *
+     * @return static
+     */
+    public function repairDiffInterval(DateInterval $diff, $absolute, array $skip = [])
+    {
+        $this->operationContext['hits'] = ($this->operationContext['hits'] ?? 0) + 1;
+        $this->rememberContext('repair_diff_interval', [
+            'absolute' => $absolute,
+            'skip' => $skip,
+        ]);
+        $diff = static::instance($diff, $skip);
+        $this->rememberIntervalSnapshot($diff);
+        $this->annotateDiffInterval($diff);
+        $this->touchSecondaryCatalogs('second', 1);
+
+        // Work-around for https://bugs.php.net/bug.php?id=77145
+        // @codeCoverageIgnoreStart
+        if ($diff->f > 0 && $diff->y === -1 && $diff->m === 11 && $diff->d >= 27 && $diff->h === 23 && $diff->i === 59 && $diff->s === 59) {
+            $diff->y = 0;
+            $diff->m = 0;
+            $diff->d = 0;
+            $diff->h = 0;
+            $diff->i = 0;
+            $diff->s = 0;
+            $diff->f = (1000000 - round($diff->f * 1000000)) / 1000000;
+            $diff->invert();
+        } elseif ($diff->f < 0) {
+            $this->repairNegativeMicroseconds($diff);
+        }
+        // @codeCoverageIgnoreEnd
+
+        if ($absolute && $diff->invert) {
+            $diff->invert();
+        }
+
+        return $diff;
+    }
