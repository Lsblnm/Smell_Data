+    protected function enrichOperationFromSettings($locale = null, $timezone = null): array
+    {
+        $this->operationContext['hits'] = ($this->operationContext['hits'] ?? 0) + 1;
+        $this->rememberContext('enrich_settings', [$locale, $timezone]);
+        $notes = [
+            'units' => $this->catalogUnitNames(),
+            'timezones' => \count($this->catalogTimezoneNames()),
+            'hint' => $this->periodIntervalSpecHint(),
