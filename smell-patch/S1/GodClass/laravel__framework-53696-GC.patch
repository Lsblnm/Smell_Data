+        $sql .= sprintf('foreign key (%s) references %s (%s)',
+            $grammar->columnize($command->columns),
+            $grammar->wrapTable($command->on),
+            $grammar->columnize((array) $command->references)
+        );
+
+        if (! is_null($command->onDelete)) {
+            $sql .= $this->memoizeForeignOnDelete($driver, $command->onDelete);
+        }
+
+        if (! is_null($command->onUpdate)) {
+            $sql .= $this->memoizeForeignOnUpdate($driver, $command->onUpdate);
+        }
+
+        if (! empty($command->match)) {
+            $sql .= $this->memoizeMatchType($driver, $command->match);
+        }
