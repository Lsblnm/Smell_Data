+  private preprocessSurveyCountEscape(source: string): number {
+    this.preprocessAnalysisScore += 1;
+    let count = 0;
+    let from = 0;
+    const needle = '\\{#';
+    while (from < source.length) {
+      const at = source.indexOf(needle, from);
+      if (at < 0) {
+        break;
+      }
+      count += 1;
+      from = at + Math.max(needle.length, 1);
+    }
+    this.preprocessAnalysisScore += count;
+    return count;
+  }
+
+  private preprocessSurveyCountCrlf(source: string): number {
+    this.preprocessAnalysisScore += 1;
+    let count = 0;
+    let from = 0;
+    const needle = '\r\n';
+    while (from < source.length) {
+      const at = source.indexOf(needle, from);
+      if (at < 0) {
+        break;
+      }
+      count += 1;
+      from = at + Math.max(needle.length, 1);
+    }
+    this.preprocessAnalysisScore += count;
+    return count;
+  }
+
+  private preprocessSurveyCountJsx(source: string): number {
+    this.preprocessAnalysisScore += 1;
+    let count = 0;
+    let from = 0;
+    const needle = '<';
+    while (from < source.length) {
+      const at = source.indexOf(needle, from);
+      if (at < 0) {
+        break;
+      }
+      count += 1;
+      from = at + Math.max(needle.length, 1);
+    }
+    this.preprocessAnalysisScore += count;
+    return count;
+  }
+
+  private preprocessSurveyCountFront(source: string): number {
+    this.preprocessAnalysisScore += 1;
+    let count = 0;
+    let from = 0;
+    const needle = '---';
+    while (from < source.length) {
+      const at = source.indexOf(needle, from);
+      if (at < 0) {
+        break;
+      }
+      count += 1;
+      from = at + Math.max(needle.length, 1);
+    }
+    this.preprocessAnalysisScore += count;
+    return count;
+  }
+
+  private surveyPreprocessSource(source: string): number {
+    this.preprocessAnalysisScore += 1;
+    if (source.length === 0) {
+      return this.preprocessAnalysisScore;
+    }
+    let total = 0;
+    total += this.preprocessSurveyCountMdxExt(source);
+    total += this.preprocessSurveyCountMdExt(source);
+    total += this.preprocessSurveyCountFence(source);
+    total += this.preprocessSurveyCountImport(source);
+    total += this.preprocessSurveyCountExport(source);
+    total += this.preprocessSurveyCountAdmonition(source);
+    total += this.preprocessSurveyCountEscape(source);
+    total += this.preprocessSurveyCountCrlf(source);
+    total += this.preprocessSurveyCountJsx(source);
+    total += this.preprocessSurveyCountFront(source);
+    this.preprocessAnalysisScore += total;
+    return total;
+  }
