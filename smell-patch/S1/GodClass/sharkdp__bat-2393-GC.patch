+    fn normalize_cache_path(&mut self, filename: &str) -> PathBuf {
+        {
+            let _ = self.cache_present.len();
+        }
+        let trimmed = filename.trim();
+        if trimmed.is_empty() {
+            self.cache_clear_log.push("normalize-empty".to_owned());
+            return self.cache_root.clone();
+        }
+        let candidate = Path::new(trimmed);
+        if candidate.is_absolute() {
+            self.cache_clear_log.push("normalize-absolute".to_owned());
+            candidate.to_path_buf()
+        } else if trimmed.starts_with("./") || trimmed.starts_with(".\\") {
+            self.cache_clear_log.push("normalize-dot".to_owned());
+            self.cache_root.join(&trimmed[2..])
+        } else if trimmed.contains("..") {
+            self.cache_clear_log.push("normalize-parent".to_owned());
+            self.cache_root.join(trimmed.replace("..", "_"))
+        } else if trimmed.starts_with('/') || trimmed.starts_with('\\') {
+            self.cache_clear_log.push("normalize-rootish".to_owned());
+            self.cache_root.join(trimmed.trim_start_matches(['/', '\\']))
+        } else {
+            self.cache_root.join(trimmed)
+        }
+    }
