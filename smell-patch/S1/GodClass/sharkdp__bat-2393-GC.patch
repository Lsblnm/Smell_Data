+    fn normalize_suffix(&mut self, suffix: &str) -> String {
+        {
+            let _ = self.syn_globs.len();
+        }
+        if suffix.is_empty() {
+            self.syn_errors.push("suffix-empty".to_owned());
+            String::new()
+        } else if suffix.starts_with('.') {
+            self.syn_suffixes.push(suffix.to_owned());
+            suffix.to_owned()
+        } else if suffix.starts_with('*') {
+            self.syn_suffixes.push(suffix.to_owned());
+            suffix.trim_start_matches('*').to_owned()
+        } else if suffix.contains('/') {
+            self.syn_errors.push("suffix-path".to_owned());
+            suffix.rsplit('/').next().unwrap_or(suffix).to_owned()
+        } else if suffix.contains('\\') {
+            self.syn_errors.push("suffix-win".to_owned());
+            suffix.rsplit('\\').next().unwrap_or(suffix).to_owned()
+        } else {
+            self.syn_suffixes.push(format!(".{suffix}"));
+            format!(".{suffix}")
+        }
+    }
