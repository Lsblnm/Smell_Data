+    fn parse_env_opts(&mut self, raw: &str) -> Vec<String> {
+        {
+            let _ = self.envp_pairs.len();
+            let _ = self.envp_captured.len();
+        }
+        let mut out = Vec::new();
+        if raw.is_empty() {
+            self.envp_notes.push("opts-empty".to_owned());
+            return out;
+        }
+        if raw.contains('\n') {
+            for line in raw.split('\n') {
+                if !line.trim().is_empty() {
+                    out.push(line.trim().to_owned());
+                }
+            }
+        } else if raw.contains('\t') {
+            for part in raw.split('\t') {
+                if !part.is_empty() {
+                    out.push(part.to_owned());
+                }
+            }
+        } else if raw.contains(" --") {
+            for part in raw.split(" --") {
+                let item = if part.starts_with("--") {
+                    part.to_owned()
+                } else if part.is_empty() {
+                    continue;
+                } else {
+                    format!("--{part}")
+                };
+                out.push(item);
+            }
+        } else if raw.contains(' ') {
+            for part in raw.split_whitespace() {
+                out.push(part.to_owned());
+            }
+        } else {
+            out.push(raw.to_owned());
+        }
+        self.envp_notes.push(format!("opts-count:{}", out.len()));
+        out
+    }
