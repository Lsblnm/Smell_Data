+    fn validate_glob_pattern(&mut self, glob: &str) -> bool {
+        {
+            let _ = self.syn_suffixes.len();
+        }
+        if glob.is_empty() {
+            self.syn_errors.push("glob-empty".to_owned());
+            false
+        } else if glob.contains('\0') {
+            self.syn_errors.push("glob-null".to_owned());
+            false
+        } else if glob.starts_with("**") {
+            self.syn_globs.push(glob.to_owned());
+            true
+        } else if glob.starts_with("*.") {
+            self.syn_globs.push(glob.to_owned());
+            true
+        } else if glob.starts_with('.') {
+            self.syn_globs.push(glob.to_owned());
+            true
+        } else if glob.contains('*') || glob.contains('?') || glob.contains('[') {
+            self.syn_globs.push(glob.to_owned());
+            true
+        } else {
+            self.syn_globs.push(glob.to_owned());
+            true
+        }
+    }
