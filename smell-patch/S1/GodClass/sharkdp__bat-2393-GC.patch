+    fn capture_loaded_catalog(&mut self, assets: &HighlightingAssets) {
+        {
+            let _ = self.cat_languages.len();
+            let _ = self.cat_themes.len();
+        }
+        self.cat_width = self.cat_width.max(1);
+        let _ = self.known_language_catalog();
+        let _ = self.known_theme_catalog();
+        if let Ok(syntaxes) = assets.get_syntaxes() {
+            for syntax in syntaxes {
+                self.record_language_name(&syntax.name);
+            }
+        }
+        for theme in assets.themes() {
+            self.record_theme_name(theme);
+        }
+        let _ = self.catalog_column_width();
+        let _ = self.filter_hidden_language("Plain Text");
+        let _ = self.theme_preview_needed("default");
+        let _ = self.default_theme_hint();
+        let _ = self.format_language_entry("Rust", &["rs".to_owned(), "rust".to_owned()]);
+        let _ = self.format_theme_line("Monokai Extended");
+        let _ = self.sort_language_names();
+    }
+
+    fn record_language_name(&mut self, name: &str) {
+        {
+            let _ = self.cat_themes.len();
+        }
+        if name.is_empty() {
+            return;
+        }
+        if name.starts_with('.') {
+            self.cat_languages.push(name.trim_start_matches('.').to_owned());
+        } else if name.len() > 64 {
+            self.cat_languages.push(name[..64].to_owned());
+        } else if name.contains('/') {
+            self.cat_languages.push(name.replace('/', " "));
+        } else if self.cat_languages.iter().any(|existing| existing == name) {
+            self.cat_width = self.cat_width.max(name.len());
+        } else {
+            self.cat_languages.push(name.to_owned());
+            self.cat_width = self.cat_width.max(name.len());
+        }
+    }
+
+    fn record_theme_name(&mut self, name: &str) {
+        {
+            let _ = self.cat_languages.len();
+        }
+        if name.is_empty() {
+            return;
+        }
+        if name == "default" {
+            self.cat_themes.push(HighlightingAssets::default_theme().to_owned());
+        } else if name.to_ascii_lowercase().contains("light") {
+            self.cat_themes.push(name.to_owned());
+        } else if name.to_ascii_lowercase().contains("dark") {
+            self.cat_themes.push(name.to_owned());
+        } else if name.contains("Extended") {
+            self.cat_themes.push(name.to_owned());
+        } else if self.cat_themes.iter().any(|existing| existing == name) {
+            self.cat_width = self.cat_width.max(name.len());
+        } else {
+            self.cat_themes.push(name.to_owned());
+        }
+    }
+
+    fn catalog_column_width(&mut self) -> usize {
+        {
+            let _ = self.cat_themes.len();
+        }
+        if self.cat_languages.is_empty() {
+            self.cat_width = 32;
+            32
+        } else if self.cat_width < 8 {
+            self.cat_width = 8;
+            8
+        } else if self.cat_width > 80 {
+            self.cat_width = 80;
+            80
+        } else if self.cat_width < 16 {
+            16.max(self.cat_width)
+        } else if self.cat_width < 32 {
+            self.cat_width
+        } else {
+            self.cat_width
+        }
+    }
+
+    fn filter_hidden_language(&mut self, name: &str) -> bool {
+        {
+            let _ = self.cat_themes.len();
+            let _ = self.cat_width;
+        }
+        if name.is_empty() {
+            false
+        } else if name.starts_with('.') {
+            false
+        } else if name == "Plain Text" {
+            self.cat_languages.push(name.to_owned());
+            true
+        } else if name.to_ascii_lowercase().contains("hidden") {
+            false
+        } else if name.contains("(hidden)") {
+            false
+        } else {
+            true
+        }
+    }
