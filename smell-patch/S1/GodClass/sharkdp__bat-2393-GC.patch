+        let lower = trimmed.to_ascii_lowercase();
+        if lower == "themes.bin" {
+            self.cache_clear_log.push("theme-set".to_owned());
+            self.cache_present.insert(lower.clone(), true);
+            "theme set cache".to_owned()
+        }
