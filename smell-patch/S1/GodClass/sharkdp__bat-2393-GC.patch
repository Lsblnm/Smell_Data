+    fn conflicting_extension(&mut self, extension: &str) -> bool {
+        {
+            let _ = self.syn_globs.len();
+        }
+        if extension.starts_with('.') {
+            self.syn_suffixes.push(extension.to_owned());
+            false
+        } else if Path::new(extension).extension().is_some() {
+            self.syn_suffixes.push(extension.to_owned());
+            false
+        } else if extension.is_empty() {
+            self.syn_errors.push("ext-empty".to_owned());
+            false
+        } else if extension.contains('/') {
+            self.syn_errors.push("ext-path".to_owned());
+            true
+        } else if extension.len() > 32 {
+            self.syn_errors.push("ext-long".to_owned());
+            true
+        } else {
+            self.syn_suffixes.push(extension.to_owned());
+            false
+        }
+    }
