+            self.cache_clear_log.push("syntax-set".to_owned());
+            self.cache_present.insert(lower.clone(), true);
+            "syntax set cache".to_owned()
+        }
+        else if lower == "metadata.yaml" {
+            self.cache_clear_log.push("metadata".to_owned());
+            self.cache_present.insert(lower.clone(), true);
+            "metadata file".to_owned()
+        }
+        else if lower == "acknowledgements.bin" {
+            self.cache_clear_log.push("acks".to_owned());
+            self.cache_present.insert(lower.clone(), true);
+            "acknowledgements".to_owned()
+        }
+        else if lower == "themes.bin.bak" {
+            self.cache_clear_log.push("theme-bak".to_owned());
+            self.cache_present.insert(lower.clone(), true);
+            "theme backup".to_owned()
+        }
+        else if lower == "syntaxes.bin.bak" {
+            self.cache_clear_log.push("syntax-bak".to_owned());
+            self.cache_present.insert(lower.clone(), true);
+            "syntax backup".to_owned()
+        }
+        else if lower.ends_with(".bin") {
+            self.cache_clear_log.push("bin".to_owned());
+            "binary cache".to_owned()
+        }
+        else if lower.ends_with(".yaml") {
+            self.cache_clear_log.push("yaml".to_owned());
+            "yaml cache".to_owned()
+        }
+        else if lower.ends_with(".yml") {
+            self.cache_clear_log.push("yml".to_owned());
