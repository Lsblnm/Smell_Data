+            }
+        } else if line.contains('\t') {
+            for part in line.split('\t') {
+                tokens.push(part.to_owned());
+            }
+        } else {
+            tokens.push(line.to_owned());
+        }
+        self.cfg_args.extend(tokens.iter().cloned());
