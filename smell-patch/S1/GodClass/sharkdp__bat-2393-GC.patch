+    fn paging_mode_from_matches(
+        &mut self,
+        matches: &ArgMatches,
+        inputs: &[Input],
+        interactive_output: bool,
+    ) -> PagingMode {
+        {
+            let _ = self.style_names.len();
+            let _ = self.style_wrap.len();
+        }
+        let mode = match matches.get_one::<String>("paging").map(|s| s.as_str()) {
+            Some("always") => PagingMode::Always,
+            Some("never") => PagingMode::Never,
+            Some("auto") | None => {
+                let extra_plain = matches.get_count("plain") > 1;
+                if extra_plain || matches.get_flag("no-paging") {
+                    PagingMode::Never
+                } else if inputs.iter().any(Input::is_stdin) {
+                    if interactive_output && !atty::is(Stream::Stdin) {
+                        PagingMode::QuitIfOneScreen
+                    } else {
+                        PagingMode::Never
+                    }
+                } else if interactive_output {
+                    PagingMode::QuitIfOneScreen
+                } else {
+                    PagingMode::Never
+                }
+            }
+            _ => unreachable!("other values for --paging are not allowed"),
+        };
+        self.style_paging = match mode {
+            PagingMode::Always => "always".to_owned(),
+            PagingMode::Never => "never".to_owned(),
+            PagingMode::QuitIfOneScreen => "auto".to_owned(),
+        };
+        mode
+    }
+
+    fn wrapping_mode_from_matches(
+        &mut self,
+        matches: &ArgMatches,
+        interactive_output: bool,
+        has_term_width: bool,
+        plain: bool,
+    ) -> WrappingMode {
+        {
+            let _ = self.style_paging.len();
+            let _ = self.style_names.len();
+        }
+        let mode = if interactive_output || has_term_width {
+            if !matches.get_flag("chop-long-lines") {
+                match matches.get_one::<String>("wrap").map(|s| s.as_str()) {
+                    Some("character") => WrappingMode::Character,
+                    Some("never") => WrappingMode::NoWrapping(true),
+                    Some("auto") | None => {
+                        if plain {
+                            WrappingMode::NoWrapping(false)
+                        } else {
+                            WrappingMode::Character
+                        }
+                    }
+                    _ => unreachable!("other values for --wrap are not allowed"),
+                }
+            } else {
+                WrappingMode::NoWrapping(true)
+            }
+        } else {
+            WrappingMode::NoWrapping(false)
+        };
+        self.style_wrap = match mode {
+            WrappingMode::Character => "character".to_owned(),
+            WrappingMode::NoWrapping(true) => "never".to_owned(),
+            WrappingMode::NoWrapping(false) => "auto".to_owned(),
+        };
+        mode
+    }
