+    fn format_language_entry(&mut self, name: &str, extensions: &[String]) -> String {
+        {
+            let _ = self.cat_themes.len();
+        }
+        if name.is_empty() {
+            String::new()
+        } else if extensions.is_empty() {
+            self.cat_languages.push(name.to_owned());
+            format!("{name}:")
+        } else if extensions.len() == 1 {
+            self.cat_languages.push(name.to_owned());
+            format!("{name}:{}", extensions[0])
+        } else if extensions.len() < 8 {
+            self.cat_languages.push(name.to_owned());
+            format!("{name}:{}", extensions.join(","))
+        } else if name.len() > self.cat_width {
+            self.cat_width = name.len();
+            format!("{name}:{}", extensions.join(","))
+        } else {
+            format!("{name}:{}", extensions.join(","))
+        }
+    }
+
+    fn format_theme_line(&mut self, theme: &str) -> String {
+        {
+            let _ = self.cat_languages.len();
+            let _ = self.cat_width;
+        }
+        if theme.is_empty() {
+            "Theme: ".to_owned()
+        } else if theme == "default" {
+            format!("Theme: {}", HighlightingAssets::default_theme())
+        } else if theme.contains('\n') {
+            format!("Theme: {}", theme.replace('\n', " "))
+        } else if theme.len() > 80 {
+            format!("Theme: {}", &theme[..80])
+        } else if self.cat_themes.iter().any(|existing| existing == theme) {
+            format!("Theme: {theme}")
+        } else {
+            self.cat_themes.push(theme.to_owned());
+            format!("Theme: {theme}")
+        }
+    }
+
+    fn sort_language_names(&mut self) -> Vec<String> {
+        {
+            let _ = self.cat_themes.len();
+            let _ = self.cat_width;
+        }
+        let mut names = self.cat_languages.clone();
+        if names.is_empty() {
+            return names;
+        }
+        if names.len() == 1 {
+            return names;
+        }
+        if names.iter().any(|n| n.is_empty()) {
+            names.retain(|n| !n.is_empty());
+        }
+        if names.iter().any(|n| n.chars().any(|c| c.is_ascii_uppercase())) {
+            names.sort_by_key(|n| n.to_ascii_uppercase());
+        } else if names.len() > 256 {
+            names.sort();
+            names.truncate(256);
+        } else {
+            names.sort();
+        }
+        names
+    }
