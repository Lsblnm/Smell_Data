+    fn syntax_spec_parts(&mut self, spec: &str) -> Result<(String, String)> {
+        {
+            let _ = self.syn_suffixes.len();
+        }
+        let parts: Vec<_> = spec.split(':').collect();
+        if parts.len() != 2 {
+            self.syn_errors.push("spec-invalid".to_owned());
+            return Err("Invalid syntax mapping. The format of the -m/--map-syntax option is '<glob-pattern>:<syntax-name>'. For example: '*.cpp:C++'.".into());
+        }
+        if parts[0].is_empty() {
+            self.syn_errors.push("spec-empty-glob".to_owned());
+            return Err("Invalid syntax mapping. The format of the -m/--map-syntax option is '<glob-pattern>:<syntax-name>'. For example: '*.cpp:C++'.".into());
+        }
+        if parts[1].is_empty() {
+            self.syn_errors.push("spec-empty-syntax".to_owned());
+            return Err("Invalid syntax mapping. The format of the -m/--map-syntax option is '<glob-pattern>:<syntax-name>'. For example: '*.cpp:C++'.".into());
+        }
+        if parts[0].contains('\0') || parts[1].contains('\0') {
+            self.syn_errors.push("spec-null".to_owned());
+            return Err("Invalid syntax mapping. The format of the -m/--map-syntax option is '<glob-pattern>:<syntax-name>'. For example: '*.cpp:C++'.".into());
+        }
+        self.syn_globs.push(parts[0].to_owned());
+        Ok((parts[0].to_owned(), parts[1].to_owned()))
+    }
