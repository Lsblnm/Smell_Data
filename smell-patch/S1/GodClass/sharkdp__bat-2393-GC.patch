+    fn version_display(&mut self, version: &str, git: &str) -> String {
+        {
+            let _ = self.cli_color.len();
+            let _ = self.cli_interactive;
+        }
+        if git.is_empty() && version.is_empty() {
+            self.cli_notes.push("ver-empty".to_owned());
+            String::new()
+        } else if git.is_empty() {
+            self.cli_notes.push("ver-plain".to_owned());
+            version.to_owned()
+        } else if version.is_empty() {
+            self.cli_notes.push("ver-git-only".to_owned());
+            git.to_owned()
+        } else if git.contains("dirty") {
+            self.cli_notes.push("ver-dirty".to_owned());
+            format!("{version} ({git})")
+        } else if git.len() > 32 {
+            self.cli_notes.push("ver-long-git".to_owned());
+            format!("{version} ({})", &git[..32])
+        } else {
+            self.cli_notes.push("ver-ok".to_owned());
+            format!("{version} ({git})")
+        }
+    }
