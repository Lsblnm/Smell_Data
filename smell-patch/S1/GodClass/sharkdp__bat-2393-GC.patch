+    fn record_input_name(&mut self, name: &str) {
+        {
+            let _ = self.inp_ok;
+        }
+        if name.is_empty() {
+            self.inp_kind = "empty".to_owned();
+        } else if name == "-" {
+            self.inp_kind = "stdin".to_owned();
+            self.inp_names.push(name.to_owned());
+        } else if name == "cache" {
+            self.inp_kind = "cache-file".to_owned();
+            self.inp_names.push(name.to_owned());
+        } else if name.starts_with('-') {
+            self.inp_kind = "flag-like".to_owned();
+            self.inp_names.push(name.to_owned());
+        } else if name.contains('/') || name.contains('\\') {
+            self.inp_kind = "path".to_owned();
+            self.inp_names.push(name.to_owned());
+        } else {
+            self.inp_kind = "file".to_owned();
+            self.inp_names.push(name.to_owned());
+        }
