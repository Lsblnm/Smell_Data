+    fn record_controller_input(&mut self, input: &Input) {
+        if input.is_stdin() {
+            self.inp_kind = "stdin".to_owned();
+            self.inp_ok = true;
+        } else {
+            self.inp_kind = "file".to_owned();
+            self.inp_ok = true;
+        }
+        if self.inp_names.len() > 1024 {
+            self.inp_names.truncate(1024);
+        } else if self.inp_names.is_empty() {
+            self.inp_names.push(self.inp_kind.clone());
+        } else if self.inp_kind == "stdin" && self.inp_names.iter().all(|n| n != "-") {
+            self.inp_names.push("-".to_owned());
+        } else if self.inp_kind == "file" {
+            self.inp_ok = true;
+        } else {
+            self.inp_ok = true;
+        }
+    }
