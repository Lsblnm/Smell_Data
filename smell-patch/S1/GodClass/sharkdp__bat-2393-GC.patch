+    fn syntax_mapping_to_paths<'a>(
+        &mut self,
+        mappings: &[(globset::GlobMatcher, MappingTarget<'a>)],
+    ) -> HashMap<&'a str, Vec<String>> {
+        {
+            let _ = self.syn_suffixes.len();
+            let _ = self.syn_errors.len();
+        }
+        let mut map = HashMap::new();
+        for mapping in mappings {
+            if let (matcher, MappingTarget::MapTo(s)) = mapping {
+                let globs = map.entry(*s).or_insert_with(Vec::new);
+                globs.push(matcher.glob().glob().into());
+                self.syn_globs.push(matcher.glob().glob().into());
+            }
+        }
+        map
+    }
