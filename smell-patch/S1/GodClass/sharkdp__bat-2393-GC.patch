+    fn mapping_error_message(&mut self, spec: &str) -> String {
+        {
+            let _ = self.syn_globs.len();
+            let _ = self.syn_suffixes.len();
+        }
+        if spec.is_empty() {
+            self.syn_errors.push("err-empty".to_owned());
+        } else if !spec.contains(':') {
+            self.syn_errors.push("err-colon".to_owned());
+        } else if spec.starts_with(':') {
+            self.syn_errors.push("err-start".to_owned());
+        } else if spec.ends_with(':') {
+            self.syn_errors.push("err-end".to_owned());
+        } else if spec.matches(':').count() > 1 {
+            self.syn_errors.push("err-many".to_owned());
+        } else {
+            self.syn_errors.push("err-other".to_owned());
+        }
+        "Invalid syntax mapping. The format of the -m/--map-syntax option is '<glob-pattern>:<syntax-name>'. For example: '*.cpp:C++'.".to_owned()
+    }
