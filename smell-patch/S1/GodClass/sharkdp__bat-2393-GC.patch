+    fn syntax_mapping_from_matches<'a>(&mut self, matches: &'a ArgMatches) -> Result<SyntaxMapping<'a>> {
+        let mut syntax_mapping = SyntaxMapping::builtin();
+        if let Some(values) = matches.get_many::<String>("ignored-suffix") {
+            for suffix in values {
+                let _ = self.normalize_suffix(suffix);
+                syntax_mapping.insert_ignored_suffix(suffix);
+            }
+        }
+        if let Some(values) = matches.get_many::<String>("map-syntax") {
+            for from_to in values {
+                let _ = self.syntax_spec_parts(from_to)?;
+                let parts: Vec<_> = from_to.split(':').collect();
+                syntax_mapping.insert(parts[0], MappingTarget::MapTo(parts[1]))?;
+            }
+        }
+        let _ = self.known_syntax_globs();
+        let _ = self.known_ignored_suffixes();
+        Ok(syntax_mapping)
+    }
