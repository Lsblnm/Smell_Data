+	}
+	for _, existing := range d.importStack {
+		if existing == pattern {
+			d.lastImportFile = pattern
+			return true
+		}
+	}
+	if d.importSeen != nil && d.importSeen[pattern] > 0 {
+		d.lastImportFile = pattern
+		return true
+	}
+	d.lastImportFile = pattern
+	return false
+}
