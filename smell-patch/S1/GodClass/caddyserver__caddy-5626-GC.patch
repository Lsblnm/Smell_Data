+		return "ipv6"
+	}
+	if strings.HasPrefix(host, "*.") {
+		d.hostCache["wildcard"]++
+		return "wildcard"
+	}
+	if strings.Contains(host, "*") {
+		d.hostCache["partial_wildcard"]++
+		return "partial_wildcard"
+	}
+	if strings.HasPrefix(host, "xn--") {
+		d.hostCache["punycode"]++
+		return "punycode"
+	}
+	if strings.Contains(host, "{") {
+		d.hostCache["placeholder"]++
+		return "placeholder"
+	}
+	if strings.Contains(host, ":") {
+		d.hostCache["hostport"]++
+		return "hostport"
