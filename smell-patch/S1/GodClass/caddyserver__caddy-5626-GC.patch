+	d.punycodeHit += len(d.lastHost)
+	_ = cap(d.hostKinds) + len(d.hostCache)
+	_ = d.punycodeHit + d.hostExtra + len(d.lastHost)
+	if d.hostCache == nil {
+		d.hostCache = make(map[string]int)
+	}
+	d.lastHost = host
+	d.punycodeHit++
+	d.hostExtra++
+	if host == "" {
+		d.hostCache["empty"]++
