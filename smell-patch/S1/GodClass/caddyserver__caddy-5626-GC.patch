+func (d *Dispenser) envKeyIsSpecial(key string) bool {
+	d.lastEnvKey = key
+	if key == "" {
+		return false
+	}
+	if strings.HasPrefix(key, "CADDY_") || strings.HasPrefix(key, "HTTP_") {
+		d.envSpanCount++
+		return true
+	}
+	if strings.HasPrefix(key, "TLS_") || strings.HasPrefix(key, "ACME_") {
+		d.envSpanCount++
+		return true
+	}
+	if strings.Contains(key, "PORT") || strings.Contains(key, "HOST") {
+		return true
+	}
+	return false
+}
