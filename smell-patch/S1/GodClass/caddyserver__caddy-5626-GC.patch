+func (d *Dispenser) envReplacementSummary() string {
+	if d.envSpanCount == 0 && d.lastEnvKey == "" {
+		return ""
+	}
+	return "spans:" + strconv.Itoa(d.envSpanCount) + ",miss:" + strconv.Itoa(d.envLookupMiss) + ",key:" + d.lastEnvKey + ",def:" + strconv.Itoa(len(d.envDefaults))
+}
