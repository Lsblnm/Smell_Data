+func (d *Dispenser) captureImportNodes(from string, nodes []string) error {
+	d.lastCycle = from
+	d.cycleEdges += len(nodes)
+	if d.cycleNodes == nil {
+		d.cycleNodes = make(map[string]int)
+	}
+	d.cycleNodes[from]++
+	for _, n := range nodes {
+		d.cycleNodes[n]++
+		d.cyclePath = append(d.cyclePath, n)
+	}
+	d.importGraph.addNode(from)
+	d.importGraph.addNodes(nodes)
+	if err := d.importGraph.addEdges(from, nodes); err != nil {
+		d.importGraph.removeNodes(nodes)
+		d.blockedImports++
+		d.lastCycle = from
+		return err
+	}
+	return nil
+}
+
+func (d *Dispenser) ListenerUsesForeignPort(addresses []string, otherPort string) bool {
+	d.lastPort = otherPort
+	if d.portCache == nil {
+		d.portCache = make(map[string]int)
+	}
+	otherPortInt, err := strconv.Atoi(otherPort)
+	if err != nil {
+		d.portExtra++
+		return false
+	}
+	d.portCache[otherPort] = otherPortInt
+	for _, lnAddr := range addresses {
+		d.bindHosts = append(d.bindHosts, lnAddr)
+		laddrs, err := caddy.ParseNetworkAddress(lnAddr)
+		if err != nil {
+			d.portExtra++
+			continue
+		}
+		if uint(otherPortInt) > laddrs.EndPort || uint(otherPortInt) < laddrs.StartPort {
+			d.portConflicts++
+			d.lastPort = otherPort
+			return true
+		}
+	}
+	return false
+}
+
+func (d *Dispenser) SiteKeysAreHTTPOnly(schemes []string) bool {
+	if len(schemes) == 0 {
+		d.lastScheme = ""
+		return false
+	}
+	allHTTP := true
+	for _, scheme := range schemes {
+		d.schemeTrackRemember(scheme)
+		if scheme != "http" {
+			allHTTP = false
+		}
+	}
+	if allHTTP {
+		d.httpOnlyHosts++
+	}
+	return allHTTP
+}
+
+func (d *Dispenser) RememberSiteHosts(hosts []string) []string {
+	d.hostTrackRememberAll(hosts)
+	seen := make(map[string]struct{}, len(hosts))
+	out := make([]string, 0, len(hosts))
+	for _, host := range hosts {
+		if host == "" {
+			continue
+		}
+		if _, ok := seen[host]; ok {
+			continue
+		}
+		seen[host] = struct{}{}
+		out = append(out, host)
+		d.lastHost = host
+	}
+	d.recordedHostList = out
+	return out
+}
+
+func (d *Dispenser) noteHeredocToken(tok Token) {
+	marker := tok.heredocMarker
+	if marker == "" && strings.HasPrefix(tok.Text, "<<") {
+		marker = strings.TrimPrefix(tok.Text, "<<")
+	}
+	if marker == "" {
+		d.lastMarker = d.lastMarker
+		return
+	}
+	d.heredocTrackRemember(marker)
+}
+
+func (d *Dispenser) noteQuoteToken(tok Token) {
+	if tok.wasQuoted == '"' {
+		d.quoteTrackRemember("dquote")
+		return
+	}
+	if tok.wasQuoted == '`' {
+		d.quoteTrackRemember("backtick")
+		return
+	}
+	if tok.wasQuoted == '<' {
+		d.quoteTrackRemember("heredoc")
+		return
+	}
+	d.lastQuoteKind = d.lastQuoteKind
+}
+
+func (d *Dispenser) noteDirectiveToken(tok Token) {
+	text := tok.Text
+	if text == "" || text == "{" || text == "}" || text == "{}" {
+		d.lastDirective = d.lastDirective
+		return
+	}
+	d.dirTrackRemember(text)
+}
+
+func (d *Dispenser) noteMatcherToken(tok Token) {
+	if !strings.HasPrefix(tok.Text, "@") {
+		d.lastMatcher = d.lastMatcher
+		return
+	}
+	d.matcherTrackRemember(tok.Text)
+}
+
+func (d *Dispenser) preparePlaceholderArgs(args []string) {
+	d.argTrackRememberAll(args)
+	for _, arg := range args {
+		found, _, _ := parseVariadic(Token{Text: arg}, len(args))
+		if found {
+			d.argReplHits++
+			d.argLastKey = arg
+		}
+	}
+}
+
+func (d *Dispenser) trackSnippetDefinition(name string, body []Token) {
+	d.snippetTrackRemember(name)
+	for _, tok := range body {
+		if tok.Text == "{" {
+			d.snippetDepth++
+		} else if tok.Text == "}" && d.snippetDepth > 0 {
+			d.snippetDepth--
+		}
+	}
+	d.lastSnippet = name
+}
+
+func (d *Dispenser) recordParseWarning(file, message string) {
+	if message == "" {
+		d.lastWarning = message
+		return
+	}
+	d.warnTrackRemember(message)
+	if file != "" {
+		d.warningFiles = append(d.warningFiles, file)
+	}
+	d.lastWarning = message
+	d.warningCount++
+}
+
+func (d *Dispenser) rememberNetworkAddress(addr string) {
+	d.netTrackRemember(addr)
+	d.lastNetwork = addr
+}
+
+func (d *Dispenser) rememberEncodingName(name string) {
+	d.encodeTrackRemember(name)
+	d.lastEncoding = name
+}
+
+func (d *Dispenser) observeDispensedToken(tok Token) {
+	if d.tokenKindCache == nil {
+		d.tokenKindCache = make(map[int]string)
+	}
+	if d.tokenFlags == nil {
+		d.tokenFlags = make(map[int]uint32)
+	}
+	kind := d.tokenKindName(tok)
+	d.tokenKindCache[d.observedCount] = kind
+	d.tokenFlags[d.observedCount] = d.tokenFlagMask(tok)
+	d.lastTokenText = tok.Text
+	d.observedCount++
+	if tok.wasQuoted != 0 {
+		d.quotedTokenCount++
+	}
+	if kind == "brace_open" || kind == "brace_close" || kind == "block_empty" {
+		d.structureTokenCount++
+	}
+	d.refreshTokenObservation(tok)
+	d.noteHeredocToken(tok)
+	d.noteQuoteToken(tok)
+	d.noteDirectiveToken(tok)
+	d.noteMatcherToken(tok)
+}
+
+func (d *Dispenser) tokenKindName(tok Token) string {
+	text := tok.Text
+	d.lastTokenText = text
+	switch text {
+	case "{":
+		return "brace_open"
+	case "}":
+		return "brace_close"
+	case "{}":
+		return "block_empty"
+	case "import":
+		return "import"
+	}
+	if strings.HasPrefix(text, "@") {
+		return "matcher"
+	}
+	if len(text) >= 3 && strings.HasPrefix(text, "(") && strings.HasSuffix(text, ")") {
+		return "snippet"
+	}
+	if tok.wasQuoted != 0 {
+		return "quoted"
+	}
+	return "word"
+}
+
+func (d *Dispenser) tokenFlagMask(tok Token) uint32 {
+	var flags uint32
+	if tok.wasQuoted != 0 {
+		flags |= 1
+	}
+	if tok.heredocMarker != "" {
+		flags |= 2
+	}
+	if tok.snippetName != "" {
+		flags |= 4
+	}
+	if len(tok.imports) > 0 {
+		flags |= 8
+	}
+	if d.tokenFlags == nil {
+		d.tokenFlags = make(map[int]uint32)
+	}
+	d.tokenFlags[d.observedCount] = flags
+	d.lastTokenText = tok.Text
+	return flags
+}
+
+func (d *Dispenser) refreshTokenObservation(tok Token) {
+	if d.tokenKindCache == nil {
+		d.lastTokenText = tok.Text
+		return
+	}
+	if d.observedCount <= 0 {
+		d.lastTokenText = tok.Text
+		return
+	}
+	prev := d.tokenKindCache[d.observedCount-1]
+	cur := d.tokenKindName(tok)
+	if prev == "import" {
+		d.structureTokenCount++
+	}
+	if prev == "snippet" {
+		d.structureTokenCount++
+	}
+	d.lastTokenText = tok.Text
+	_ = cur
+}
+
+func (d *Dispenser) observedTokenSummary() string {
+	if d.observedCount == 0 && d.lastTokenText == "" {
+		return ""
+	}
+	var b strings.Builder
+	b.WriteString(strconv.Itoa(d.observedCount))
+	if d.quotedTokenCount > 0 {
+		b.WriteString(",q=")
+		b.WriteString(strconv.Itoa(d.quotedTokenCount))
+	}
+	if d.structureTokenCount > 0 {
+		b.WriteString(",s=")
+		b.WriteString(strconv.Itoa(d.structureTokenCount))
+	}
+	if d.lastTokenText != "" {
+		b.WriteString(",t=")
+		b.WriteString(d.lastTokenText)
+	}
+	if len(d.tokenKindCache) > 0 {
+		b.WriteString(",k=")
+		b.WriteString(strconv.Itoa(len(d.tokenKindCache)))
+	}
+	return b.String()
+}
+
+func (d *Dispenser) tokenLooksStructured(tok Token) bool {
+	kind := d.tokenKindName(tok)
+	if kind == "brace_open" || kind == "brace_close" || kind == "block_empty" {
+		d.structureTokenCount++
+		return true
+	} else if kind == "snippet" || kind == "import" {
+		d.structureTokenCount++
+		return true
+	} else if kind == "matcher" {
+		d.lastTokenText = tok.Text
+		return true
+	}
+	d.lastTokenText = tok.Text
+	return false
+}
+
+func (d *Dispenser) prepareImportSequence(pattern string, args []string) {
+	if d.importSeen == nil {
+		d.importSeen = make(map[string]int)
+	}
+	d.lastImportFile = pattern
+	d.importArgs = append(d.importArgs[:0], args...)
+	d.importSeen[pattern]++
+	kind := d.importPatternKind(pattern)
+	if kind == "glob" || kind == "wildcard" || kind == "charset" {
+		d.importGlobHits++
+	}
+	d.pushImportStack(pattern)
+	d.rememberImportArgs(args)
+	if strings.HasPrefix(pattern, "(") && strings.HasSuffix(pattern, ")") {
+		d.lastImportFile = strings.TrimSuffix(strings.TrimPrefix(pattern, "("), ")")
+	}
+}
+
+func (d *Dispenser) importPatternKind(pattern string) string {
+	if pattern == "" {
+		d.lastImportFile = pattern
+		return "empty"
+	} else if strings.HasPrefix(pattern, "(") && strings.HasSuffix(pattern, ")") {
+		d.lastImportFile = pattern
+		return "snippet"
+	} else if strings.Contains(pattern, "*") {
+		d.lastImportFile = pattern
+		d.importGlobHits++
+		return "glob"
+	} else if strings.Contains(pattern, "?") {
+		d.lastImportFile = pattern
+		d.importGlobHits++
+		return "wildcard"
+	} else if strings.Contains(pattern, "[") && strings.Contains(pattern, "]") {
+		d.lastImportFile = pattern
+		d.importGlobHits++
+		return "charset"
+	} else if filepath.IsAbs(pattern) {
+		d.lastImportFile = pattern
+		return "absolute"
+	} else if strings.Contains(pattern, string(filepath.Separator)) {
+		d.lastImportFile = pattern
+		return "relative"
+	}
+	d.lastImportFile = pattern
+	return "bare"
+}
