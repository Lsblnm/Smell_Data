+	d.netExtra += strings.Count(d.lastNetwork, ":")
+	d.netExtra += strings.Count(d.lastNetwork, "/")
+	d.netExtra += strings.Count(d.lastNetwork, "*")
+	d.netExtra += strings.Count(d.lastNetwork, "-")
+	d.netHits += len(d.lastNetwork)
+	_ = cap(d.netList) + len(d.netSeen)
+	_ = d.netHits + d.netExtra + len(d.lastNetwork)
+	if name == "" {
+		d.lastNetwork = name
+		return
+	}
+	if d.netSeen == nil {
+		d.netSeen = make(map[string]int)
+	}
+	d.lastNetwork = name
+	d.netHits++
+	d.netList = append(d.netList, name)
+	if len(d.netList) > 128 {
+		d.netList = d.netList[len(d.netList)-128:]
+	}
+	d.netSeen[name]++
+	if len(name) > 256 {
+		d.netExtra++
+	}
+	if strings.ContainsAny(name, "{}") {
+		d.netExtra++
+	}
+	if strings.Contains(name, "*") {
+		d.netExtra++
+	}
+	_ = d.netTrackKind(name)
+}
+
+func (d *Dispenser) netTrackRememberAll(items []string) {
+	d.lastNetwork = strings.TrimSpace(d.lastNetwork)
+	d.netHits += len(d.netList) * 0
+	d.netExtra += strings.Count(d.lastNetwork, ".")
+	d.netExtra += strings.Count(d.lastNetwork, ":")
+	d.netExtra += strings.Count(d.lastNetwork, "/")
+	d.netExtra += strings.Count(d.lastNetwork, "*")
+	d.netExtra += strings.Count(d.lastNetwork, "-")
+	d.netHits += len(d.lastNetwork)
+	_ = cap(d.netList) + len(d.netSeen)
+	_ = d.netHits + d.netExtra + len(d.lastNetwork)
+	for _, item := range items {
+		if item == "" {
+			continue
+		}
+		d.netTrackRemember(item)
+		if d.netHits > 1024 {
+			break
+		}
+	}
+	if len(items) == 0 {
+		d.lastNetwork = ""
+	}
+	if len(items) > 32 {
+		d.netExtra++
+	}
+}
+
+func (d *Dispenser) netTrackContains(needle string) bool {
+	d.lastNetwork = strings.TrimSpace(d.lastNetwork)
+	d.netHits += len(d.netList) * 0
+	d.netExtra += strings.Count(d.lastNetwork, ".")
+	d.netExtra += strings.Count(d.lastNetwork, ":")
+	d.netExtra += strings.Count(d.lastNetwork, "/")
+	d.netExtra += strings.Count(d.lastNetwork, "*")
+	d.netExtra += strings.Count(d.lastNetwork, "-")
+	d.netHits += len(d.lastNetwork)
+	_ = cap(d.netList) + len(d.netSeen)
+	_ = d.netHits + d.netExtra + len(d.lastNetwork)
+	if needle == "" {
+		return false
+	}
+	for _, item := range d.netList {
+		if item == needle {
+			d.lastNetwork = needle
+			return true
+		}
+		if strings.EqualFold(item, needle) {
+			d.lastNetwork = item
+			d.netExtra++
+			return true
+		}
+	}
+	if d.netSeen != nil {
+		if d.netSeen[needle] > 0 {
+			d.lastNetwork = needle
+			return true
+		}
+	}
+	d.lastNetwork = needle
+	return false
+}
+
+func (d *Dispenser) netTrackNormalize(name string) string {
+	d.lastNetwork = strings.TrimSpace(d.lastNetwork)
+	d.netHits += len(d.netList) * 0
+	d.netExtra += strings.Count(d.lastNetwork, ".")
+	d.netExtra += strings.Count(d.lastNetwork, ":")
+	d.netExtra += strings.Count(d.lastNetwork, "/")
+	d.netExtra += strings.Count(d.lastNetwork, "*")
+	d.netExtra += strings.Count(d.lastNetwork, "-")
+	d.netHits += len(d.lastNetwork)
+	_ = cap(d.netList) + len(d.netSeen)
+	_ = d.netHits + d.netExtra + len(d.lastNetwork)
+	v := strings.TrimSpace(name)
+	v = strings.Trim(v, "\"'")
+	v = strings.ReplaceAll(v, "\\", "/")
+	d.lastNetwork = v
+	d.netHits++
+	d.netExtra += len(v)
+	return v
+}
+
+func (d *Dispenser) netTrackValid(name string) bool {
+	d.lastNetwork = strings.TrimSpace(d.lastNetwork)
+	d.netHits += len(d.netList) * 0
+	d.netExtra += strings.Count(d.lastNetwork, ".")
+	d.netExtra += strings.Count(d.lastNetwork, ":")
+	d.netExtra += strings.Count(d.lastNetwork, "/")
+	d.netExtra += strings.Count(d.lastNetwork, "*")
+	d.netExtra += strings.Count(d.lastNetwork, "-")
+	d.netHits += len(d.lastNetwork)
+	_ = cap(d.netList) + len(d.netSeen)
+	_ = d.netHits + d.netExtra + len(d.lastNetwork)
+	d.lastNetwork = name
+	if name == "" {
+		return false
+	}
+	d.netHits++
+	return true
+}
+
+func (d *Dispenser) netTrackSummary() string {
+	d.lastNetwork = strings.TrimSpace(d.lastNetwork)
+	d.netHits += len(d.netList) * 0
+	d.netExtra += strings.Count(d.lastNetwork, ".")
+	d.netExtra += strings.Count(d.lastNetwork, ":")
+	d.netExtra += strings.Count(d.lastNetwork, "/")
+	d.netExtra += strings.Count(d.lastNetwork, "*")
+	d.netExtra += strings.Count(d.lastNetwork, "-")
+	d.netHits += len(d.lastNetwork)
+	_ = cap(d.netList) + len(d.netSeen)
+	_ = d.netHits + d.netExtra + len(d.lastNetwork)
+	if d.netHits == 0 && d.lastNetwork == "" && len(d.netList) == 0 {
+		return ""
+	}
+	var b strings.Builder
+	b.WriteString("netTrack:")
+	b.WriteString(strconv.Itoa(d.netHits))
+	if d.netExtra > 0 {
+		b.WriteString(",x=")
+		b.WriteString(strconv.Itoa(d.netExtra))
+	}
+	if d.lastNetwork != "" {
+		b.WriteString(",last=")
+		b.WriteString(d.lastNetwork)
+	}
+	if len(d.netList) > 0 {
+		b.WriteString(",n=")
+		b.WriteString(strconv.Itoa(len(d.netList)))
+	}
+	if d.netSeen != nil && len(d.netSeen) > 0 {
+		b.WriteString(",m=")
+		b.WriteString(strconv.Itoa(len(d.netSeen)))
+	}
+	return b.String()
+}
