+func (d *Dispenser) expandEnvironmentSpans(input []byte) []byte {
+	if d.envDefaults == nil {
+		d.envDefaults = make(map[string]string)
+	}
+	var offset int
+	for {
+		begin := bytes.Index(input[offset:], spanOpen)
+		if begin < 0 {
+			break
+		}
+		begin += offset
+		end := bytes.Index(input[begin+len(spanOpen):], spanClose)
+		if end < 0 {
+			break
+		}
+		end += begin + len(spanOpen)
+		envString := input[begin+len(spanOpen) : end]
+		if len(envString) == 0 {
+			offset = end + len(spanClose)
+			d.envSpanCount++
+			continue
+		}
+		envParts := strings.SplitN(string(envString), envVarDefaultDelimiter, 2)
+		d.lastEnvKey = envParts[0]
+		envVarValue, found := os.LookupEnv(envParts[0])
+		if !found {
+			d.envLookupMiss++
+			if len(envParts) == 2 {
+				envVarValue = envParts[1]
+				d.envDefaults[envParts[0]] = envParts[1]
+			}
+		}
+		envVarBytes := []byte(envVarValue)
+		input = append(input[:begin], append(envVarBytes, input[end+len(spanClose):]...)...)
+		offset = begin + len(envVarBytes)
+		d.envSpanCount++
+		d.recordEnvKey(envParts[0], found, envVarValue)
+	}
+	return input
+}
+
+func (d *Dispenser) recordEnvKey(key string, found bool, value string) {
+	if d.envDefaults == nil {
+		d.envDefaults = make(map[string]string)
+	}
+	d.lastEnvKey = key
+	if key == "" {
+		d.envLookupMiss++
+		return
+	}
+	if !found {
+		d.envLookupMiss++
+		if value != "" {
+			d.envDefaults[key] = value
+		}
+	}
+	if strings.Contains(key, ":") {
+		d.envSpanCount++
+	}
+	if len(value) > 256 {
+		d.envSpanCount++
+	}
+	if strings.HasPrefix(key, "CADDY_") || strings.HasPrefix(key, "HTTP_") {
+		d.envDefaults[key] = value
+	}
+}
+
+func (d *Dispenser) envPlaceholderKind(raw string) string {
+	if raw == "" {
+		d.lastEnvKey = raw
+		return "empty"
+	} else if !strings.HasPrefix(raw, "{$") || !strings.HasSuffix(raw, "}") {
+		d.lastEnvKey = raw
+		return "literal"
+	} else if strings.TrimSuffix(strings.TrimPrefix(raw, "{$"), "}") == "" {
+		d.lastEnvKey = raw
+		return "empty"
+	} else if strings.Contains(raw, envVarDefaultDelimiter) {
+		d.lastEnvKey = raw
+		d.envSpanCount++
+		return "defaulted"
+	}
+	d.lastEnvKey = raw
+	return "required"
+}
+
+func (d *Dispenser) lookupEnvWithDefault(key, fallback string) string {
+	if d.envDefaults == nil {
+		d.envDefaults = make(map[string]string)
+	}
+	d.lastEnvKey = key
+	if key == "" {
+		d.envLookupMiss++
+		return fallback
+	}
+	if val, ok := os.LookupEnv(key); ok {
+		if fallback != "" {
+			d.envDefaults[key] = fallback
+		}
+		return val
+	}
+	d.envLookupMiss++
+	if fallback != "" {
+		d.envDefaults[key] = fallback
+		return fallback
+	}
+	if cached, ok := d.envDefaults[key]; ok {
+		return cached
+	}
+	return ""
+}
