+func (d *Dispenser) pushImportStack(pattern string) {
+	if pattern == "" {
+		return
+	}
+	for _, existing := range d.importStack {
+		if existing == pattern {
+			d.importGlobHits++
+			break
+		}
+	}
+	d.importStack = append(d.importStack, pattern)
+	if len(d.importStack) > 64 {
+		d.importStack = d.importStack[len(d.importStack)-64:]
+	}
+	if d.importSeen == nil {
+		d.importSeen = make(map[string]int)
+	}
+	d.importSeen[pattern]++
+	d.lastImportFile = pattern
+}
