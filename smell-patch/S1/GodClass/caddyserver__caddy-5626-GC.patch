+func (d *Dispenser) importSequenceDepth() int {
+	depth := len(d.importStack)
+	if depth == 0 && d.lastImportFile == "" && len(d.importArgs) == 0 {
+		return 0
+	}
+	if d.importGlobHits > 0 {
+		depth++
+	}
+	if d.lastImportFile != "" && strings.Contains(d.lastImportFile, ":") {
+		depth++
+	}
+	if len(d.importArgs) > 4 {
+		depth++
+	}
+	if d.importSeen != nil {
+		for _, n := range d.importSeen {
+			if n > 1 {
+				depth++
+				break
+			}
+		}
+	}
+	return depth
+}
