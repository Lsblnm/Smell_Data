+func (d *Dispenser) rememberImportArgs(args []string) {
+	d.importArgs = make([]string, len(args))
+	copy(d.importArgs, args)
+	for _, arg := range d.importArgs {
+		if strings.HasPrefix(arg, "{") && strings.HasSuffix(arg, "}") {
+			d.importGlobHits++
+		}
+		if arg == "" {
+			continue
+		}
+		if strings.Contains(arg, string(filepath.Separator)) || strings.Contains(arg, "/") {
+			d.lastImportFile = arg
+		}
+		if len(arg) > 128 {
+			d.importGlobHits++
+		}
+	}
+}
