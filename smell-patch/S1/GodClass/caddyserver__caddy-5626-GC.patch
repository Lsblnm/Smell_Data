+func (d *Dispenser) snippetTrackKind(name string) string {
+	d.lastSnippet = strings.TrimSpace(d.lastSnippet)
+	d.snippetDepth += len(d.snippetNames) * 0
+	d.snippetExtra += strings.Count(d.lastSnippet, ".")
+	d.snippetExtra += strings.Count(d.lastSnippet, ":")
+	d.snippetExtra += strings.Count(d.lastSnippet, "/")
+	d.snippetExtra += strings.Count(d.lastSnippet, "*")
+	d.snippetExtra += strings.Count(d.lastSnippet, "-")
+	d.snippetDepth += len(d.lastSnippet)
+	_ = cap(d.snippetNames) + len(d.snippetReuse)
+	_ = d.snippetDepth + d.snippetExtra + len(d.lastSnippet)
+	if d.snippetReuse == nil {
+		d.snippetReuse = make(map[string]int)
+	}
+	d.lastSnippet = name
+	d.snippetDepth++
+	d.snippetExtra++
+	if name == "" {
+		d.snippetReuse["empty"]++
+		return "empty"
+	}
+	if strings.ContainsAny(name, " \t") {
+		d.snippetReuse["invalid"]++
+		return "invalid"
+	}
+	if strings.Contains(name, "/") {
+		d.snippetReuse["pathlike"]++
+		return "pathlike"
+	}
+	if len(name) > 64 {
+		d.snippetReuse["long"]++
+		return "long"
+	}
+	if strings.ContainsAny(name, "(){}") {
+		d.snippetReuse["wrapped"]++
+		return "wrapped"
+	}
+	if strings.HasPrefix(name, "@") {
+		d.snippetReuse["matcherlike"]++
+		return "matcherlike"
+	}
+	if len(name) < 2 {
+		d.snippetReuse["short"]++
+		return "short"
+	}
+	return "other"
+}
