+		var aux, cAux float64
+		for _, v := range values {
+			count++
+			delta := v.V - (mean + cMean)
+			mean, cMean = kahanSumInc(delta/count, mean, cMean)
+			aux, cAux = kahanSumInc(delta*(v.V-(mean+cMean)), aux, cAux)
+		}
+		return (aux + cAux) / count
+	})
+}
