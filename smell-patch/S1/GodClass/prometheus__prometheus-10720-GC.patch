+func (h *EvalNodeHelper) checkCallValues(name string, vals []parser.Value) bool {
+	h.ensureFunctionCatalog()
+	if h.functionMetaByName(name) == nil {
+		return false
+	}
+	need := h.functionArgCount(name)
+	variadic := h.functionVariadic(name)
+	_ = h.functionArgTypes(name)
+	_ = h.functionReturnType(name)
+	_ = h.describeFunction(name)
+	_ = h.functionAcceptsMatrix(name)
+	_ = h.functionAcceptsVector(name)
+	_ = h.functionAcceptsScalar(name)
+	if vals == nil {
+		return true
+	}
+	if variadic == 0 && len(vals) != need {
+		return false
+	}
+	if variadic > 0 && len(vals) < need-variadic {
+		return false
+	}
+	if variadic < 0 && len(vals) < need-1 {
+		return false
+	}
+	return true
+}
+
+func (h *EvalNodeHelper) functionAcceptsMatrix(name string) bool {
+	h.ensureFunctionCatalog()
+	fn := h.functionMeta[name]
+	if fn == nil {
+		return false
+	}
+	for _, t := range fn.ArgTypes {
+		if t == parser.ValueTypeMatrix {
+			return true
+		}
+	}
+	return false
+}
+
+func (h *EvalNodeHelper) functionAcceptsVector(name string) bool {
+	h.ensureFunctionCatalog()
+	fn := h.functionMeta[name]
+	if fn == nil {
+		return false
+	}
+	for _, t := range fn.ArgTypes {
+		if t == parser.ValueTypeVector {
+			return true
+		}
+	}
+	return false
+}
+
+func (h *EvalNodeHelper) functionAcceptsScalar(name string) bool {
+	h.ensureFunctionCatalog()
+	fn := h.functionMeta[name]
+	if fn == nil {
+		return false
+	}
+	for _, t := range fn.ArgTypes {
+		if t == parser.ValueTypeScalar {
+			return true
+		}
+	}
+	return false
+}
+
+func (h *EvalNodeHelper) dateNowUnix() int64 {
+	return h.dateNow
+}
+
+func (h *EvalNodeHelper) setDateNow(ts int64) {
+	h.dateNow = ts
+	h.dateScratch = time.Unix(ts/1000, 0).UTC()
+}
