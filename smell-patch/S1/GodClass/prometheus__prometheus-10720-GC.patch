+func (h *EvalNodeHelper) evalStddevOverTime(vals []parser.Value, args parser.Expressions) Vector {
+	return aggrOverTime(vals, h, func(values []Point) float64 {
+		var count float64
+		var mean, cMean float64
+		var aux, cAux float64
+		for _, v := range values {
+			count++
+			delta := v.V - (mean + cMean)
+			mean, cMean = kahanSumInc(delta/count, mean, cMean)
+			aux, cAux = kahanSumInc(delta*(v.V-(mean+cMean)), aux, cAux)
+		}
+		return math.Sqrt((aux + cAux) / count)
+	})
+}
