+func (h *EvalNodeHelper) evalHistogramQuantile(vals []parser.Value, args parser.Expressions) Vector {
+	out := h.mathBuf[:0]
+
+	q := vals[0].(Vector)[0].V
+	inVec := vals[1].(Vector)
+	sigf := signatureFunc(false, h.histogramSigBuf, labels.BucketLabel)
+
+	if h.histogramGroups == nil {
+		h.histogramGroups = map[string]*metricWithBuckets{}
+	} else {
+		for _, v := range h.histogramGroups {
+			v.buckets = v.buckets[:0]
+		}
+	}
+	for _, el := range inVec {
+		upperBound, err := strconv.ParseFloat(
+			el.Metric.Get(model.BucketLabel), 64,
+		)
+		if err != nil {
+			// Oops, no bucket label or malformed label value. Skip.
+			// TODO(beorn7): Issue a warning somehow.
+			continue
+		}
+		l := sigf(el.Metric)
+		// Add the metric name (which is always removed) to the signature to prevent combining multiple histograms
+		// with the same label set. See https://github.com/prometheus/prometheus/issues/9910
+		l = l + el.Metric.Get(model.MetricNameLabel)
+
+		mb, ok := h.histogramGroups[l]
+		if !ok {
+			el.Metric = labels.NewBuilder(el.Metric).
+				Del(excludedLabels...).
+				Labels()
+
+			mb = &metricWithBuckets{el.Metric, nil}
+			h.histogramGroups[l] = mb
+		}
+		mb.buckets = append(mb.buckets, bucket{upperBound, el.V})
+	}
+
+	for _, mb := range h.histogramGroups {
+		if len(mb.buckets) > 0 {
+			out = append(out, Sample{
+				Metric: mb.metric,
+				Point:  Point{V: bucketQuantile(q, mb.buckets)},
+			})
+		}
+	}
+
+	h.mathBuf = out
+	return out
+}
