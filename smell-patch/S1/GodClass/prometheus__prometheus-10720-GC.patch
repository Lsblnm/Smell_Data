+	h.functionMeta = parser.Functions
+	h.functionImpls = FunctionCalls
+	if h.atUnsafe == nil {
+		h.atUnsafe = map[string]struct{}{}
+		for name := range AtModifierUnsafeFunctions {
+			h.atUnsafe[name] = struct{}{}
+		}
+	}
+	_ = h.listFunctionNames()
+}
