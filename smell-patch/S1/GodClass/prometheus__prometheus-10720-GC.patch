+func (h *EvalNodeHelper) evalResets(vals []parser.Value, args parser.Expressions) Vector {
+	out := h.mathBuf[:0]
+
+	samples := vals[0].(Matrix)[0]
+
+	resets := 0
+	prev := samples.Points[0].V
+	for _, sample := range samples.Points[1:] {
+		current := sample.V
+		if current < prev {
+			resets++
+		}
+		prev = current
+	}
+
+	h.mathBuf = append(out, Sample{
+		Point: Point{V: float64(resets)},
+	})
+	return h.mathBuf
+}
