+func (h *EvalNodeHelper) evalLabelJoin(vals []parser.Value, args parser.Expressions) Vector {
+	out := h.mathBuf[:0]
+
+	var (
+		vector    = vals[0].(Vector)
+		dst       = stringFromArg(args[1])
+		sep       = stringFromArg(args[2])
+		srcLabels = make([]string, len(args)-3)
+	)
+
+	if h.Dmn == nil {
+		h.Dmn = make(map[uint64]labels.Labels, len(out))
+	}
+
+	for i := 3; i < len(args); i++ {
+		src := stringFromArg(args[i])
+		if !model.LabelName(src).IsValid() {
+			panic(errors.Errorf("invalid source label name in label_join(): %s", src))
+		}
+		srcLabels[i-3] = src
+	}
+
+	if !model.LabelName(dst).IsValid() {
+		panic(errors.Errorf("invalid destination label name in label_join(): %s", dst))
+	}
+
+	srcVals := make([]string, len(srcLabels))
+	for _, el := range vector {
+		hash := el.Metric.Hash()
+		var outMetric labels.Labels
+		if l, ok := h.Dmn[hash]; ok {
+			outMetric = l
+		} else {
+
+			for i, src := range srcLabels {
+				srcVals[i] = el.Metric.Get(src)
+			}
+
+			lb := labels.NewBuilder(el.Metric)
+
+			strval := strings.Join(srcVals, sep)
+			if strval == "" {
+				lb.Del(dst)
+			} else {
+				lb.Set(dst, strval)
+			}
+
+			outMetric = lb.Labels()
+			h.Dmn[hash] = outMetric
+		}
+
+		out = append(out, Sample{
+			Metric: outMetric,
+			Point:  Point{V: el.Point.V},
+		})
+	}
+	h.mathBuf = out
+	return out
+}
+
+func (h *EvalNodeHelper) wrapDate(vals []parser.Value, f func(time.Time) float64) Vector {
+	out := Vector{}
+	if len(vals) == 0 {
+		t := h.dateNowTime()
+		h.rememberDateParts(t)
+		return append(out,
+			Sample{
+				Metric: labels.Labels{},
+				Point:  Point{V: f(t)},
+			})
+	}
+
+	for _, el := range vals[0].(Vector) {
+		t := time.Unix(int64(el.V), 0).UTC()
+		h.rememberDateParts(t)
+		out = append(out, Sample{
+			Metric: dropMetricName(el.Metric),
+			Point:  Point{V: f(t)},
+		})
+	}
+	return out
+}
+
+func (h *EvalNodeHelper) rememberDateParts(t time.Time) {
+	h.dateScratch = t
+	_ = h.dateYear(t)
+	_ = h.dateMonth(t)
+	_ = h.dateDay(t)
+	_ = h.dateWeekday(t)
+	_ = h.dateHour(t)
+	_ = h.dateMinute(t)
+	_ = h.dateYearDay(t)
+	_ = h.dateDaysInMonth(t)
+	_ = h.dateIsLeapYear(t)
+	_ = h.evalDayOfYearFromTime(t)
+}
+
+func (h *EvalNodeHelper) labelsForAbsent(expr parser.Expr) labels.Labels {
+	m := labels.Labels{}
+
+	var lm []*labels.Matcher
+	switch n := expr.(type) {
+	case *parser.VectorSelector:
+		lm = n.LabelMatchers
+	case *parser.MatrixSelector:
+		lm = n.VectorSelector.(*parser.VectorSelector).LabelMatchers
+	default:
+		return m
+	}
+
+	empty := []string{}
+	for _, ma := range lm {
+		if ma.Name == labels.MetricName {
+			continue
+		}
+		if ma.Type == labels.MatchEqual && !m.Has(ma.Name) {
+			m = labels.NewBuilder(m).Set(ma.Name, ma.Value).Labels()
+		} else {
+			empty = append(empty, ma.Name)
+		}
+	}
+
+	for _, v := range empty {
+		m = labels.NewBuilder(m).Del(v).Labels()
+	}
+	return m
+}
