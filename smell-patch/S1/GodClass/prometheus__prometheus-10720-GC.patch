+	if len(v) != 1 {
+		h.mathBuf = append(out, Sample{
+			Point: Point{V: math.NaN()},
+		})
+		return h.mathBuf
+	}
+	h.mathBuf = append(out, Sample{
+		Point: Point{V: v[0].V},
+	})
+	return h.mathBuf
+}
