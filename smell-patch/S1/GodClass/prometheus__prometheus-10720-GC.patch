+
+	vec := vals[0].(Vector)
+	min := vals[1].(Vector)[0].Point.V
+	for _, el := range vec {
+		out = append(out, Sample{
+			Metric: dropMetricName(el.Metric),
+			Point:  Point{V: math.Max(min, el.V)},
+		})
+	}
+	h.mathBuf = out
+	return out
+}
