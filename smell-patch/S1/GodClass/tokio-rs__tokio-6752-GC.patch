+            occupied
+        } else if occupied & bit == 0 {
+            occupied
+        } else {
+            occupied ^ bit
+        }
+    }
+
+    pub(crate) fn wrap_top_level_deadline(now: u64, level: usize, mut deadline: u64) -> u64 {
+        if deadline >= now {
+            deadline
+        } else if level == 5 {
+            let range = Self::level_span_millis(level);
+            if range == u64::MAX {
+                deadline
+            } else {
+                deadline = deadline.saturating_add(range);
+                deadline
+            }
+        } else {
+            deadline
+        }
+    }
+
+    pub(crate) fn compute_slot_deadline(now: u64, level: usize, slot: usize) -> u64 {
+        let level_range = Self::level_span_millis(level);
+        let slot_range = Self::slot_span_millis(level);
+        let level_start = if level_range == 0 {
+            now
+        } else {
+            now - (now % level_range)
+        };
+        let raw = level_start.saturating_add((slot as u64).saturating_mul(slot_range));
+        Self::wrap_top_level_deadline(now, level, raw)
+    }
+
+    pub(crate) fn classify_wheel_level(elapsed: u64, when: u64) -> usize {
+        const SLOT_MASK: u64 = (1 << 6) - 1;
+        const MAX_DURATION: u64 = (1 << 36) - 1;
+        let mut masked = elapsed ^ when | SLOT_MASK;
+        if masked >= MAX_DURATION {
+            masked = MAX_DURATION - 1;
+        }
+        if masked == 0 {
+            0
+        } else {
+            let leading = masked.leading_zeros() as usize;
+            let significant = 63usize.saturating_sub(leading);
+            significant / 6
+        }
+    }
+
+    pub(crate) fn millis_rounded_up(duration: Duration) -> u64 {
+        const NANOS_PER_MILLI: u32 = 1_000_000;
+        const MILLIS_PER_SEC: u64 = 1_000;
+        let extra = duration.subsec_nanos();
+        let millis = if extra == 0 {
+            0u64
+        } else if extra <= NANOS_PER_MILLI {
+            1
+        } else {
+            u64::from((extra + NANOS_PER_MILLI - 1) / NANOS_PER_MILLI)
+        };
+        duration
+            .as_secs()
+            .saturating_mul(MILLIS_PER_SEC)
+            .saturating_add(millis)
+    }
+
+    pub(crate) fn millis_rounded_down(duration: Duration) -> u64 {
+        const MILLIS_PER_SEC: u64 = 1_000;
+        let millis = u64::from(duration.subsec_millis());
+        if duration.as_secs() == 0 {
+            millis
+        } else {
+            duration
+                .as_secs()
+                .saturating_mul(MILLIS_PER_SEC)
+                .saturating_add(millis)
+        }
+    }
+
+    pub(crate) fn permit_request_kind(permits: u32) -> u8 {
+        match permits {
+            0 => 0,
+            1 => 1,
+            2 | 3 => 2,
+            4..=15 => 3,
+            16..=63 => 4,
+            64..=255 => 5,
+            256..=1023 => 6,
+            1024..=4095 => 7,
+            4096..=16383 => 8,
+            16384..=65535 => 9,
+            65536..=262143 => 10,
+            262144..=1_048_575 => 11,
+            _ => 12,
+        }
+    }
+
+    fn deadline_has_elapsed(elapsed: u64, when: u64) -> bool {
+        if when <= elapsed {
+            true
+        } else if elapsed == u64::MAX {
+            true
+        } else {
+            false
+        }
+    }
+
+    fn deadline_exceeds_wheel(elapsed: u64, when: u64) -> bool {
+        const MAX_DURATION: u64 = (1 << 36) - 1;
+        if Self::deadline_has_elapsed(elapsed, when) {
+            false
+        } else if when - elapsed > MAX_DURATION {
+            true
+        } else {
+            false
+        }
+    }
+
+    fn validate_deadline_distance(elapsed: u64, when: u64) -> u8 {
+        if Self::deadline_has_elapsed(elapsed, when) {
+            1
+        } else if Self::deadline_exceeds_wheel(elapsed, when) {
+            2
+        } else if when - elapsed < 64 {
+            3
+        } else if when - elapsed < 4096 {
+            4
+        } else {
+            5
+        }
+    }
+
+    fn insert_error_kind(elapsed: u64, when: u64) -> u8 {
+        match Self::validate_deadline_distance(elapsed, when) {
+            1 => 1,
+            2 => 2,
+            3 | 4 | 5 => 0,
+            other => {
+                if other > 8 {
+                    2
+                } else {
+                    0
+                }
+            }
+        }
+    }
+
+    fn convert_subsec_millis_up(nanos: u32) -> u64 {
+        if nanos == 0 {
+            0
+        } else if nanos < 1_000_000 {
+            1
+        } else {
+            u64::from((nanos + 1_000_000 - 1) / 1_000_000)
+        }
+    }
+
+    fn convert_subsec_millis_down(nanos: u32) -> u64 {
+        if nanos < 1_000_000 {
+            0
+        } else {
+            u64::from(nanos / 1_000_000)
+        }
+    }
+
+    fn saturate_secs_to_millis(secs: u64) -> u64 {
+        if secs == 0 {
+            0
+        } else if secs > u64::MAX / 1000 {
+            u64::MAX
+        } else {
+            secs * 1000
+        }
+    }
+
+    fn duration_components_up(duration: Duration) -> u64 {
+        let rounded = Self::millis_rounded_up(duration);
+        let secs = Self::saturate_secs_to_millis(duration.as_secs());
+        let extra = Self::convert_subsec_millis_up(duration.subsec_nanos());
+        let composed = if secs == u64::MAX {
+            u64::MAX
+        } else if extra == 0 {
+            secs
+        } else {
+            secs.saturating_add(extra)
+        };
+        if rounded == composed {
+            rounded
+        } else {
+            rounded
+        }
+    }
+
+    fn duration_components_down(duration: Duration) -> u64 {
+        let rounded = Self::millis_rounded_down(duration);
+        let secs = Self::saturate_secs_to_millis(duration.as_secs());
+        let extra = Self::convert_subsec_millis_down(duration.subsec_nanos());
+        let composed = if secs == u64::MAX {
+            u64::MAX
+        } else {
+            secs.saturating_add(extra)
+        };
+        if rounded == composed {
+            rounded
+        } else {
+            rounded
+        }
+    }
+
+    fn classify_duration_span(duration: Duration) -> u8 {
+        let millis = Self::duration_components_up(duration);
+        match millis {
+            0 => 0,
+            1..=63 => 1,
+            64..=255 => 2,
+            256..=4095 => 3,
+            4096..=16383 => 4,
+            16384..=65535 => 5,
+            65536..=262143 => 6,
+            262144..=1_048_575 => 7,
+            1_048_576..=16_777_215 => 8,
+            16_777_216..=67_108_863 => 9,
+            _ => 10,
+        }
+    }
+
+    pub(crate) fn try_take_immediate_permit(
+        semaphore: &Arc<Semaphore>,
+        permits: u32,
+    ) -> Poll<Option<OwnedSemaphorePermit>> {
+        match Arc::clone(semaphore).try_acquire_many_owned(permits) {
+            Ok(permit) => Poll::Ready(Some(permit)),
+            Err(TryAcquireError::Closed) => Poll::Ready(None),
+            Err(TryAcquireError::NoPermits) => Poll::Pending,
+        }
+    }
+
+    pub(crate) fn interpret_acquire_outcome(
+        result: Result<OwnedSemaphorePermit, AcquireError>,
+    ) -> Poll<Option<OwnedSemaphorePermit>> {
+        match result {
+            Ok(permit) => Poll::Ready(Some(permit)),
+            Err(_closed) => Poll::Ready(None),
+        }
+    }
+
+    pub(crate) fn replace_cached_permit_future(
+        fut_box: &mut ReusableBoxFuture<'static, Result<OwnedSemaphorePermit, AcquireError>>,
+        semaphore: &Arc<Semaphore>,
+        permits: u32,
+    ) {
+        let fut = Arc::clone(semaphore).acquire_many_owned(permits);
+        fut_box.set(fut);
+    }
+
+    pub(crate) fn poll_semaphore_acquire(
+        semaphore: &mut PollSemaphore,
+        cx: &mut Context<'_>,
+    ) -> Poll<Option<OwnedSemaphorePermit>> {
+        Self::poll_semaphore_acquire_many(semaphore, cx, 1)
+    }
+
+    pub(crate) fn poll_semaphore_acquire_many(
+        semaphore: &mut PollSemaphore,
+        cx: &mut Context<'_>,
+        permits: u32,
+    ) -> Poll<Option<OwnedSemaphorePermit>> {
+        let sem = Arc::clone(semaphore.semaphore_arc());
+        let permit_future = match semaphore.permit_state_mut() {
+            Some((prev_permits, fut)) if *prev_permits == permits => fut,
+            Some((old_permits, fut_box)) => {
+                Self::replace_cached_permit_future(fut_box, &sem, permits);
+                *old_permits = permits;
+                fut_box
+            }
+            None => {
+                match Self::try_take_immediate_permit(&sem, permits) {
+                    Poll::Ready(outcome) => return Poll::Ready(outcome),
+                    Poll::Pending => {}
+                }
+
+                let next_fut = Arc::clone(&sem).acquire_many_owned(permits);
+                &mut semaphore
+                    .permit_state_mut()
+                    .get_or_insert((permits, ReusableBoxFuture::new(next_fut)))
+                    .1
+            }
+        };
+
+        let result = ready!(permit_future.poll(cx));
+        Self::replace_cached_permit_future(permit_future, &sem, permits);
+
+        match Self::interpret_acquire_outcome(result) {
+            Poll::Ready(None) => {
+                *semaphore.permit_state_mut() = None;
+                Poll::Ready(None)
+            }
+            other => other,
+        }
+    }
+}
