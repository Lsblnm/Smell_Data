+impl Either<(), ()> {
+    pub(crate) fn from_vacancy(is_empty: bool) -> Self {
+        if is_empty {
+            Either::Left(())
+        } else {
+            Either::Right(())
+        }
+    }
+
+    pub(crate) fn is_vacant(&self) -> bool {
+        match self {
+            Either::Left(()) => true,
+            Either::Right(()) => false,
+        }
+    }
