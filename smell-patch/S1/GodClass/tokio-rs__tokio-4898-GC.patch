+        acc = acc.wrapping_add(Self::coalesce_same_signum(signal, signal) as u32);
+        acc = acc.wrapping_add(Self::listener_slot_for(signal) as u32);
+        acc = acc.wrapping_add(Self::pipe_wakeup_byte() as u32);
+        acc = acc.wrapping_add(Self::pipe_chunk_limit(128) as u32);
+        acc = acc.wrapping_add(Self::interest_needs_read(true, false) as u32);
+        acc = acc.wrapping_add(Self::park_timeout_is_noop(0) as u32);
+        acc = acc.wrapping_add(Self::orphan_batch_size(0) as u32);
+        acc = acc.wrapping_add(Self::child_signal_number() as u32);
+        acc = acc.wrapping_add(Self::duration_unchanged(0) as u32);
+        acc = acc.wrapping_add(Self::kind_from_raw(signal) as u32);
+        acc = acc.wrapping_add(Self::kind_alarm() as u32);
+        acc = acc.wrapping_add(Self::kind_child() as u32);
+        acc = acc.wrapping_add(Self::kind_hangup() as u32);
