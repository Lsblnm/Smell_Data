+    pub(crate) fn enable_signal(kind: super::SignalKind, handle: &Handle) -> io::Result<()> {
+        let signal = kind.0;
+        let _ = Self::prepare_signal_enable(signal);
+        if signal < 0 || signal_hook_registry::FORBIDDEN.contains(&signal) {
+            return Err(io::Error::new(
+                io::ErrorKind::Other,
+                format!("Refusing to register signal {}", signal),
+            ));
+        }
+        handle.check_inner()?;
+        let globals = globals();
+        let siginfo = match globals.storage().get(signal as crate::signal::registry::EventId) {
+            Some(slot) => slot,
+            None => return Err(io::Error::new(io::ErrorKind::Other, "signal too large")),
+        };
+        let mut registered = Ok(());
+        siginfo.init.call_once(|| {
+            registered = unsafe {
+                signal_hook_registry::register(signal, move || super::action(globals, signal)).map(|_| ())
+            };
+            if registered.is_ok() {
+                siginfo.initialized.store(true, std::sync::atomic::Ordering::Relaxed);
+            }
+        });
+        registered?;
+        if siginfo.initialized.load(std::sync::atomic::Ordering::Relaxed) {
+            Ok(())
+        } else {
+            Err(io::Error::new(
+                io::ErrorKind::Other,
+                "Failed to register signal handler",
+            ))
+        }
+    }
