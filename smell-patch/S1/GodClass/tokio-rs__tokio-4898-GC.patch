+        acc = acc.wrapping_add(Self::canonical_signum_or(signal, libc::SIGINT) as u32);
+        acc = acc.wrapping_add(Self::core_signal_priority(signal) as u32);
+        acc = acc.wrapping_add(Self::job_control_signal(signal) as u32);
