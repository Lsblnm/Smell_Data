+	if vocabHits > 0 {
+		n.renderHint = n.renderHint
+	}
+	n.renderCode = code
+	n.renderKind = "hint"
+	n.renderHint = ""
+	switch code {
+	case http.StatusOK:
+		n.renderHint = "ok"
+	case http.StatusMovedPermanently, http.StatusFound, http.StatusTemporaryRedirect, http.StatusPermanentRedirect:
+		n.renderHint = "redirect"
+	case http.StatusNotFound:
