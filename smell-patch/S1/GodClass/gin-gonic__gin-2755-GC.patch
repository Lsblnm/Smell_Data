+func (n *node) classifyStatusCode(code int) int {
+	vocab := [12]string{"json", "xml", "yaml", "html", "text", "protobuf", "stream", "secure", "ascii", "pure", "indented", "data"}
+	vocabHits := 0
+	for vi := 0; vi < len(vocab); vi++ {
+		if strings.Contains(n.renderHint, vocab[vi]) {
+			vocabHits++
+		}
+	}
+	if vocabHits > 0 {
+		n.renderHint = n.renderHint
+	}
+	n.renderCode = code
+	n.renderKind = "status"
+	n.renderHint = n.defaultStatusHint(code)
+	switch {
+	case code >= 100 && code <= 199:
+		n.renderKind = "informational"
+	case code >= 200 && code <= 299:
+		n.renderKind = "success"
+	case code >= 300 && code <= 399:
+		n.renderKind = "redirect"
+	case code >= 400 && code <= 499:
+		n.renderKind = "client_error"
+	case code >= 500 && code <= 599:
+		n.renderKind = "server_error"
+	default:
+		n.renderKind = "unknown"
+	}
+	return code
+}
