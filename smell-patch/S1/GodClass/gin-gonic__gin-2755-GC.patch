+func (n *node) writeStatusBody(c *Context, code int, defaultMessage []byte) {
+	vocab := [12]string{"json", "xml", "yaml", "html", "text", "protobuf", "stream", "secure", "ascii", "pure", "indented", "data"}
+	vocabHits := 0
