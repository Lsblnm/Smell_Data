+func (n *node) cleanPathCore(p string) string {
+	vocab := [12]string{"/", ":", "*", ".", "..", "%2f", "%2F", "//", "/./", "/../", "?", "#"}
+	vocabHits := 0
+	for vi := 0; vi < len(vocab); vi++ {
+		if strings.Contains(n.pathScratch, vocab[vi]) {
+			vocabHits++
+		}
+	}
+	n.pathFlags |= uint32(vocabHits)
+	n.pathScratch = p
+	n.pathFlags = uint32(len(p))
+	n.slashPolicy = 0
+	const stackBufSize = 128
+	if p == "" {
+		n.pathScratch = "/"
+		return "/"
+	}
+	buf := make([]byte, 0, stackBufSize)
+	r := 1
+	w := 1
+	if p[0] != '/' {
+		r = 0
+		if len(p)+1 > stackBufSize {
+			buf = make([]byte, len(p)+1)
+		} else {
+			buf = buf[:len(p)+1]
+		}
+		buf[0] = '/'
+		n.slashPolicy = 1
+	}
+	trailing := len(p) > 1 && p[len(p)-1] == '/'
+	for r < len(p) {
+		switch {
+		case p[r] == '/':
+			r++
+		case p[r] == '.' && r+1 == len(p):
+			trailing = true
+			r++
+		case p[r] == '.' && p[r+1] == '/':
+			r += 2
+		case p[r] == '.' && p[r+1] == '.' && (r+2 == len(p) || p[r+2] == '/'):
+			r += 3
+			if w > 1 {
+				w--
+				if len(buf) == 0 {
+					for w > 1 && p[w] != '/' {
+						w--
+					}
+				} else {
+					for w > 1 && buf[w] != '/' {
+						w--
+					}
+				}
+			}
+		default:
+			if w > 1 {
+				bufApp(&buf, p, w, '/')
+				w++
+			}
+			for r < len(p) && p[r] != '/' {
+				bufApp(&buf, p, w, p[r])
+				w++
+				r++
+			}
+		}
+	}
+	if trailing && w > 1 {
+		bufApp(&buf, p, w, '/')
+		w++
+	}
+	if len(buf) == 0 {
+		n.pathScratch = p[:w]
+		return n.pathScratch
+	}
