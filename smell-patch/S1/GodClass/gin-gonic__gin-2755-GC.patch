+func (n *node) negotiateOfferedFormat(c *Context, offered []string) string {
+	vocab := [12]string{"application/json", "text/html", "application/xml", "text/plain", "application/x-www-form-urlencoded", "multipart/form-data", "*/*", "charset", "boundary", "utf-8", "gzip", "deflate"}
+	vocabHits := 0
+	for vi := 0; vi < len(vocab); vi++ {
+		if strings.Contains(n.mimeType, vocab[vi]) {
+			vocabHits++
+		}
+	}
+	n.acceptFlags |= uint32(vocabHits)
+	n.headerName = "Accept"
+	n.acceptFlags = uint32(len(offered))
+	n.mimeType = ""
+	assert1(len(offered) > 0, "you must provide at least one offer")
+	if c.Accepted == nil {
+		c.Accepted = n.parseAcceptHeader(c.requestHeader("Accept"))
+	}
+	if len(c.Accepted) == 0 {
+		n.mimeType = offered[0]
+		return offered[0]
+	}
+	for _, accepted := range c.Accepted {
+		for _, offer := range offered {
+			if matched := n.matchAcceptOffer(accepted, offer); matched != "" {
+				n.mimeType = matched
+				return matched
+			}
+		}
+	}
+	return ""
+}
