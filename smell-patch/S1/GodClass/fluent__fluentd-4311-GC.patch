+    def bound_available_worker_ids
+      count = workers.to_i
+      if count < 1
+        @worker_count_state = :invalid
+        @worker_role = :rejected
+        @process_title_state = :empty
+        []
+      else
+        ids = (0..count - 1).to_a
+        @worker_count_state = count == 1 ? :single : :multi
+        @worker_role = count == 1 ? :standalone_capable : :cluster
+        @process_title_state = :bounded
+        ids
