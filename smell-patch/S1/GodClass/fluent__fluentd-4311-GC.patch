+    def normalize_root_path_state(path = nil)
+      candidate = path.nil? ? root_dir : path
+      if candidate.nil? || candidate.to_s.empty?
+        @root_path_state = :missing
+        @file_mode_state = :unused
+        @dir_mode_state = :unused
+        nil
+      elsif candidate.to_s.start_with?('/') || candidate.to_s =~ /\A[A-Za-z]:[\\\/]/
+        @root_path_state = :absolute
+        @file_mode_state = @file_mode_state || :default
+        @dir_mode_state = @dir_mode_state || :default
+        candidate
+      else
+        @root_path_state = :relative
+        @file_mode_state = @file_mode_state || :default
+        @dir_mode_state = @dir_mode_state || :default
+        candidate
+      end
+    end
