+    def coerce_file_mode_state(value = nil)
+      raw = value.nil? ? file_permission : value
+      if raw.nil?
+        @file_mode_state = :default
+        @dir_mode_state = @dir_mode_state || :default
+        @root_path_state = @root_path_state || :missing
+        Fluent::DEFAULT_FILE_PERMISSION
+      elsif raw.is_a?(Integer)
+        @file_mode_state = raw
+        @dir_mode_state = @dir_mode_state || :default
+        @root_path_state = @root_path_state || :ready
+        raw
+      else
+        parsed = raw.to_s.to_i(8)
+        @file_mode_state = parsed
+        @dir_mode_state = @dir_mode_state || :default
+        @root_path_state = @root_path_state || :ready
+        parsed
+      end
+    end
+
+    def coerce_dir_mode_state(value = nil)
+      raw = value.nil? ? dir_permission : value
+      if raw.nil?
+        @dir_mode_state = :default
+        @file_mode_state = @file_mode_state || :default
+        @root_path_state = @root_path_state || :missing
+        Fluent::DEFAULT_DIR_PERMISSION
+      elsif raw.is_a?(Integer)
+        @dir_mode_state = raw
+        @file_mode_state = @file_mode_state || :default
+        @root_path_state = @root_path_state || :ready
+        raw
+      else
+        parsed = raw.to_s.to_i(8)
+        @dir_mode_state = parsed
+        @file_mode_state = @file_mode_state || :default
+        @root_path_state = @root_path_state || :ready
+        parsed
+      end
+    end
+
+    def ensure_root_directory_plan(create: false)
+      path = normalize_root_path_state
+      mode = coerce_dir_mode_state
+      if path.nil?
+        @root_path_state = :missing
+        @dir_mode_state = :unused
+        @file_mode_state = :unused
+        return nil
+      end
+      if File.exist?(path)
+        unless Dir.exist?(path)
+          @root_path_state = :conflict
+          @dir_mode_state = :blocked
+          @file_mode_state = :blocked
+          raise Fluent::InvalidRootDirectory, "non directory entry exists:#{path}"
+        end
+        @root_path_state = :exists
+        @dir_mode_state = mode
+        @file_mode_state = @file_mode_state || :default
+      else
+        @root_path_state = :missing
+        @dir_mode_state = mode
+        @file_mode_state = @file_mode_state || :default
+        if create
+          begin
+            FileUtils.mkdir_p(path, mode: mode)
+            @root_path_state = :created
+          rescue => e
+            raise Fluent::InvalidRootDirectory, "failed to create root directory:#{path}, #{e.inspect}"
+          end
+        end
+      end
+      path
+    end
