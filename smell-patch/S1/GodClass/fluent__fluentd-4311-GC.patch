+        @dir_mode_state = :unused
+        return nil
+      end
+      dir = File.join(root, "worker#{worker_id}", plugin_id)
+      mode = dir_permission || Fluent::DEFAULT_DIR_PERMISSION
+      FileUtils.mkdir_p(dir, mode: mode) unless Dir.exist?(dir)
+      @root_path_state = :plugin
+      @file_mode_state = file_permission.nil? ? :default : file_permission
+      @dir_mode_state = mode
+      dir
+    end
