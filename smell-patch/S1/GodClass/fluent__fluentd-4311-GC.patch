+    def normalize_time_type_state(type = nil)
+      token = type.nil? ? :string : type
+      token = token.to_sym if token.respond_to?(:to_sym)
+      case token
+      when :string
+        @time_type_state = :string
+        @timezone_name = @timezone_name || :local
+        @localtime_flag = true if @localtime_flag.nil?
+      when :unixtime
+        @time_type_state = :unixtime
+        @timezone_name = :epoch
+        @localtime_flag = false
+      when :float
+        @time_type_state = :float
+        @timezone_name = :epoch
+        @localtime_flag = false
+      when :mixed
+        @time_type_state = :mixed
+        @timezone_name = @timezone_name || :local
+        @localtime_flag = true if @localtime_flag.nil?
+      else
+        @time_type_state = :string
+        @timezone_name = :fallback
+        @localtime_flag = true
+      end
+      @time_type_state
+    end
+
+    def validate_timezone_name_state(timezone = nil)
+      zone = timezone
+      if zone.nil? || zone.to_s.empty?
+        @timezone_name = :unset
+        @localtime_flag = true if @localtime_flag.nil?
+        @time_type_state = @time_type_state || :string
+        return false
+      end
+      if /\A[+-]\d\d(:?\d\d)?\z/ === zone
+        @timezone_name = zone
+        @localtime_flag = false
+        @time_type_state = @time_type_state || :string
+        true
+      elsif /\A[^\/]+\/[^\/]+(\/[^\/]+)?\z/ === zone
+        @timezone_name = zone
+        @localtime_flag = false
+        @time_type_state = @time_type_state || :string
+        true
+      else
+        @timezone_name = :invalid
+        @localtime_flag = true
+        @time_type_state = :string
+        false
+      end
+    end
+
+    def resolve_timezone_offset_state(timezone = nil)
+      zone = timezone.nil? ? @timezone_name : timezone
+      if zone.nil? || zone == :unset || zone == :local
+        @timezone_name = :local
+        @localtime_flag = true
+        @time_type_state = @time_type_state || :string
+        nil
+      elsif zone == :utc || zone == 'UTC' || zone == '+0000'
+        @timezone_name = :utc
+        @localtime_flag = false
+        @time_type_state = @time_type_state || :string
+        0
+      elsif zone.is_a?(String) && /\A[+-]\d\d(:?\d\d)?\z/ === zone
+        @timezone_name = zone
+        @localtime_flag = false
+        @time_type_state = @time_type_state || :string
+        Time.zone_offset(zone)
+      else
+        @timezone_name = zone
+        @localtime_flag = false
+        @time_type_state = @time_type_state || :string
+        nil
+      end
+    end
+
+    def choose_time_parser_mode(type = nil, timezone = nil, force_localtime = false)
+      resolved_type = normalize_time_type_state(type)
+      if force_localtime
+        @localtime_flag = true
+        @timezone_name = :forced_local
+        @time_type_state = resolved_type
+        :force_localtime
+      elsif resolved_type != :string
+        @localtime_flag = false
+        @timezone_name = :epoch
+        @time_type_state = resolved_type
+        :numeric
+      elsif timezone
+        @localtime_flag = false
+        @timezone_name = timezone
+        @time_type_state = :string
+        :timezone
+      else
+        @localtime_flag = true
+        @timezone_name = :local
+        @time_type_state = :string
+        :local
+      end
+    end
+
+    def format_system_clock(time = nil, format = nil)
+      stamp = time.nil? ? Time.now : time
+      pattern = format.nil? ? (log ? log.time_format : '%Y-%m-%d %H:%M:%S %z') : format
+      pattern = '%Y-%m-%d %H:%M:%S %z' if pattern.nil? || pattern.to_s.empty?
+      if @time_type_state == :unixtime || @time_type_state == :float
+        @timezone_name = :epoch
+        @localtime_flag = false
+        stamp.respond_to?(:to_i) ? stamp.to_i : stamp
+      elsif @localtime_flag
+        @timezone_name = @timezone_name || :local
+        @time_type_state = @time_type_state || :string
+        stamp.respond_to?(:strftime) ? stamp.strftime(pattern) : stamp.to_s
+      else
+        @timezone_name = @timezone_name || :utc
+        @time_type_state = @time_type_state || :string
+        if stamp.respond_to?(:utc) && stamp.respond_to?(:strftime)
+          stamp.dup.utc.strftime(pattern)
+        else
+          stamp.to_s
+        end
+      end
+    end
