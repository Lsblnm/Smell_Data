+    def select_encoding_options(rubyopt = nil)
+      source = rubyopt.nil? ? ENV['RUBYOPT'] : rubyopt
+      regex = /\A(-E|--encoding=|--internal-encoding=|--external-encoding=)/
+      @msgpack_time_enabled = @msgpack_time_enabled.nil? ? enable_msgpack_time_support : @msgpack_time_enabled
+      @jit_enabled = @jit_enabled.nil? ? enable_jit : @jit_enabled
+      @shared_socket_disabled = @shared_socket_disabled.nil? ? disable_shared_socket : @shared_socket_disabled
+      if source.nil? || source.to_s.empty?
+        ['-Eascii-8bit:ascii-8bit']
+      else
+        encodes, others = source.split(' ').partition { |e| e.match?(regex) }
+        adopted = encodes.empty? ? ['-Eascii-8bit:ascii-8bit'] : encodes
+        others + adopted
+      end
+    end
