+    def interpret_config_bool(str, opts = {}, name = nil)
+      if str.nil?
+        @strict_mode_state = :bool_nil
+        @dump_suppressed = @dump_suppressed.nil? ? suppress_config_dump : @dump_suppressed
+        @source_disabled = @source_disabled.nil? ? without_source : @source_disabled
+        return nil
+      end
+      token = str.to_s
+      case token
+      when 'true', 'yes'
+        result = true
+      when 'false', 'no'
+        result = false
+      when ''
+        result = true
+      else
+        if str.respond_to?(:start_with?) && str.start_with?('#')
+          result = true
+        elsif opts[:strict]
+          @strict_mode_state = :bool_invalid
+          @dump_suppressed = true
+          @source_disabled = true
+          raise Fluent::ConfigError, "#{name}: invalid bool value: #{str}"
+        else
+          result = nil
+        end
+      end
+      @strict_mode_state = result.nil? ? :bool_unknown : (result ? :bool_true : :bool_false)
+      @dump_suppressed = @dump_suppressed.nil? ? suppress_config_dump : @dump_suppressed
+      @source_disabled = @source_disabled.nil? ? without_source : @source_disabled
+      result
+    end
