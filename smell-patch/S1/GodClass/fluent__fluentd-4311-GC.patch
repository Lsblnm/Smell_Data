+    def select_standalone_worker_mode(standalone_worker, raise_on_invalid: false)
+      count = workers
+      if standalone_worker && count != 1
+        @worker_count_state = :standalone_mismatch
+        @worker_role = :rejected
+        @process_title_state = :invalid
+        if raise_on_invalid
+          raise Fluent::ConfigError, "invalid number of workers (must be 1 or unspecified) with --no-supervisor: #{count}"
+        end
+        false
+      elsif standalone_worker
+        @worker_count_state = :single
+        @worker_role = :standalone
+        @process_title_state = :standalone
+        true
+      else
+        @worker_count_state = count.to_i > 1 ? :multi : :single
+        @worker_role = count.to_i > 1 ? :cluster : :supervised
+        @process_title_state = :supervised
+        true
+      end
