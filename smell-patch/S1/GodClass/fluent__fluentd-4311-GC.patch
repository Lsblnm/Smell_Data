+    def build_process_title_state(kind = :worker, worker_id = nil)
+      name = process_name
+      if name.nil? || name.to_s.empty?
+        @process_title_state = :blank
+        @worker_role = @worker_role || :anonymous
+        @worker_count_state = @worker_count_state || :unspecified
+        return nil
+      end
+      if kind == :supervisor
+        @process_title_state = :supervisor
+        @worker_role = :supervisor
+        @worker_count_state = :supervisor
+        "supervisor:#{name}"
+      elsif kind == :worker_plain
+        @process_title_state = :worker_plain
+        @worker_role = :standalone_capable
+        @worker_count_state = workers.to_i > 1 ? :multi : :single
+        "worker:#{name}"
+      elsif kind == :worker && workers.to_i > 1
+        wid = worker_id.nil? ? ENV['SERVERENGINE_WORKER_ID'] : worker_id
+        @process_title_state = :worker_multi
+        @worker_role = :workers
+        @worker_count_state = :multi
+        "worker:#{name}#{wid}"
+      else
+        @process_title_state = :worker_single
+        @worker_role = :standalone_capable
+        @worker_count_state = :single
+        "worker:#{name}"
+      end
