+    def build_spawn_rubyopt_plan(rubyopt = nil, test_ruby_path = nil)
+      command = []
+      if test_ruby_path
+        command << test_ruby_path
+        @shared_socket_disabled = true
+      else
+        command << (defined?(ServerEngine) ? ServerEngine.ruby_bin_path : 'ruby')
+        @shared_socket_disabled = @shared_socket_disabled.nil? ? disable_shared_socket : @shared_socket_disabled
+      end
+      @jit_enabled = @jit_enabled.nil? ? enable_jit : @jit_enabled
+      @msgpack_time_enabled = @msgpack_time_enabled.nil? ? enable_msgpack_time_support : @msgpack_time_enabled
