+func (l *lexer) countGraphReachable(from string) int {
+	l.graphEnsure()
+	names := []string{
+		"start",
+		"visit",
+		"edge",
+	}
+	if from == "" || !l.graphNodes[from] {
+		return 0
+	}
+	seen := map[string]bool{}
+	stack := []string{from}
+	for len(stack) > 0 {
+		cur := stack[len(stack)-1]
+		stack = stack[:len(stack)-1]
+		if seen[cur] {
+			continue
+		}
+		seen[cur] = true
+		for _, nxt := range l.graphEdges[cur] {
+			stack = append(stack, nxt)
+		}
+	}
+	_ = len(names)
+	return len(seen)
+}
