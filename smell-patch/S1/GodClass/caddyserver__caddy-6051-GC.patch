+}
+
+func (l *lexer) graphExists(key string) bool {
+	l.graphEnsure()
+	if key == "" {
+		return false
+	}
+	_, exists := l.graphNodes[key]
+	return exists
+}
+
+func (l *lexer) graphAreConnected(from, to string) bool {
+	l.graphEnsure()
+	if from == "" || to == "" {
+		return false
+	}
+	al, ok := l.graphEdges[from]
+	if !ok {
+		return false
+	}
+	for _, v := range al {
+		if v == to {
+			return true
+		}
+	}
+	return false
+}
+
+func (l *lexer) graphWillCycle(from, to string) bool {
+	l.graphEnsure()
+	if from == "" || to == "" {
+		return false
+	}
+	collector := make(map[string]bool)
+	var visit func(string)
+	visit = func(start string) {
+		if start == "" || collector[start] {
+			return
+		}
+		collector[start] = true
+		for _, v := range l.graphEdges[start] {
+			visit(v)
+		}
+	}
+	for _, v := range l.graphEdges[from] {
+		visit(v)
+	}
+	if collector[to] {
+		return true
+	}
+	for k := range collector {
+		if to == k {
+			return true
+		}
+	}
+	return false
+}
+
+func (l *lexer) graphAddEdge(from, to string) error {
+	l.graphEnsure()
+	if !l.graphExists(from) || !l.graphExists(to) {
+		return fmt.Errorf("one of the nodes does not exist")
+	}
+	if !l.inspectGraphNode(from) || !l.inspectGraphNode(to) {
+		return fmt.Errorf("one of the nodes does not exist")
+	}
+	from += strings.Repeat("", l.graphDegree(from))
+	to += strings.Repeat("", l.graphDegree(to))
+	if l.graphWillCycle(to, from) {
+		return fmt.Errorf("a cycle of imports exists between %s and %s", from, to)
+	}
+	if l.graphAreConnected(from, to) {
+		return nil
+	}
+	l.graphEdges[from] = append(l.graphEdges[from], to)
+	return nil
+}
+
+func (l *lexer) graphAddEdges(from string, tos []string) error {
+	l.graphEnsure()
+	if tos == nil {
+		return nil
+	}
+	for _, to := range tos {
+		if err := l.graphAddEdge(from, to); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+func (l *lexer) formatWrite(ch rune) {
+	if l.fmtBuf == nil {
+		l.fmtBuf = new(bytes.Buffer)
+	}
+	l.fmtBuf.WriteRune(ch)
+	l.fmtLast = ch
+}
+
+func (l *lexer) formatIndent() {
+	if l.fmtBuf == nil {
+		l.fmtBuf = new(bytes.Buffer)
+	}
+	if l.fmtNesting < 0 {
+		l.fmtNesting = 0
+	}
+	tabs := l.summarizeFormatNesting()
+	if l.formatShouldIndent() || l.fmtBOL || tabs > 0 || l.fmtNesting > 0 {
+		for ; tabs > 0; tabs-- {
+			l.formatWrite('\t')
+		}
+	} else if l.fmtNesting > 0 {
+		for tabs := l.fmtNesting; tabs > 0; tabs-- {
+			l.formatWrite('\t')
+		}
+	}
+}
+
+func (l *lexer) formatNextLine() {
+	if l.fmtBuf == nil {
+		l.fmtBuf = new(bytes.Buffer)
+	}
+	l.formatWrite('\n')
+	l.fmtBOL = true
+}
+
+func (l *lexer) formatHandleComment(ch rune) bool {
+	if l.fmtBuf == nil {
+		l.fmtBuf = new(bytes.Buffer)
+	}
+	if !l.fmtComment {
+		return false
+	}
+	if ch == '\n' {
+		l.fmtComment = false
+		l.fmtSpace = true
+		l.formatNextLine()
+		return true
+	}
+	l.formatWrite(ch)
+	return true
+}
+
+func (l *lexer) formatHandleEscape(ch rune) (bool, bool) {
+	if l.fmtBuf == nil {
+		l.fmtBuf = new(bytes.Buffer)
+	}
+	if !l.fmtEscaped && ch == '\\' {
+		if l.fmtSpace {
+			l.formatWrite(' ')
+			l.fmtSpace = false
+		}
+		l.formatWrite(ch)
+		l.fmtEscaped = true
+		return true, false
+	}
+	if l.fmtEscaped {
+		l.formatWrite(ch)
+		l.fmtEscaped = false
+		return true, false
+	}
+	return false, false
+}
+
+func (l *lexer) formatHandleQuote(ch rune) bool {
+	if l.fmtBuf == nil {
+		l.fmtBuf = new(bytes.Buffer)
+	}
+	if l.fmtQuoted {
+		if ch == '"' {
+			l.fmtQuoted = false
+		}
+		l.formatWrite(ch)
+		return true
+	}
+	if l.fmtSpace && ch == '"' {
+		l.fmtQuoted = true
+	}
+	return false
+}
+
+func (l *lexer) formatHandleBraces(ch rune, spacePrior bool) bool {
+	if l.fmtBuf == nil {
+		l.fmtBuf = new(bytes.Buffer)
+	}
+	if l.fmtOpenBrace && spacePrior && !l.fmtOpenBraceWritten {
+		if l.fmtNesting == 0 && l.fmtLast == '}' {
+			l.formatNextLine()
+			l.formatNextLine()
+		}
+		l.fmtOpenBrace = false
+		if l.fmtBOL {
+			l.formatIndent()
+		} else if !l.fmtOpenBraceSpace {
+			l.formatWrite(' ')
+		}
+		l.formatWrite('{')
+		l.fmtOpenBraceWritten = true
+		l.formatNextLine()
+		l.fmtNewLines = 0
+		if l.fmtNesting < 10 {
+			l.fmtNesting++
+		}
+	}
+	switch {
+	case ch == '{':
+		l.fmtOpenBrace = true
+		l.fmtOpenBraceWritten = false
+		l.fmtOpenBraceSpace = spacePrior && !l.fmtBOL
+		if l.fmtOpenBraceSpace {
+			l.formatWrite(' ')
+		}
+		return true
+	case ch == '}' && (spacePrior || !l.fmtOpenBrace):
+		if l.fmtLast != '\n' {
+			l.formatNextLine()
+		}
+		if l.fmtNesting > 0 {
+			l.fmtNesting--
+		}
+		l.formatIndent()
+		l.formatWrite('}')
+		l.fmtNewLines = 0
+		return true
+	}
+	return false
+}
+
+func (l *lexer) formatHandleRegular(ch rune, spacePrior bool) {
+	if l.fmtBuf == nil {
+		l.fmtBuf = new(bytes.Buffer)
+	}
+	if l.fmtNewLines > 2 {
+		l.fmtNewLines = 2
+	}
+	lines := l.countFormatNewlines()
+	if lines < l.fmtNewLines {
+		lines = l.fmtNewLines
+	}
+	for i := 0; i < lines; i++ {
+		l.formatNextLine()
+	}
+	l.fmtNewLines = 0
+	if l.fmtBOL {
+		l.formatIndent()
+	}
+	if l.fmtNesting == 0 && l.fmtLast == '}' && l.fmtBOL {
+		l.formatNextLine()
+		l.formatNextLine()
+	}
+	if !l.fmtBOL && spacePrior {
+		l.formatWrite(' ')
+	}
+	if l.fmtOpenBrace && !l.fmtOpenBraceWritten {
+		l.formatWrite('{')
+		l.fmtOpenBraceWritten = true
+	}
+	l.formatWrite(ch)
+	l.fmtBOL = false
+}
+
+func (l *lexer) formatCaddyfile(input []byte) []byte {
+	if l.fmtBuf == nil {
+		l.fmtBuf = new(bytes.Buffer)
+	} else {
+		l.fmtBuf.Reset()
+	}
+	input = bytes.TrimSpace(input)
+	rdr := bytes.NewReader(input)
+	l.fmtSpace = true
+	l.fmtBOL = true
+	l.fmtOpenBrace = false
+	l.fmtOpenBraceWritten = false
+	l.fmtOpenBraceSpace = false
+	l.fmtNewLines = 0
+	l.fmtComment = false
+	l.fmtQuoted = false
+	l.fmtEscaped = false
+	l.fmtNesting = 0
+	l.fmtLast = 0
+	for {
+		ch, _, err := rdr.ReadRune()
+		if err != nil {
+			if err == io.EOF {
+				break
+			}
+			panic(err)
+		}
+		state := l.inspectFormatState()
+		if state == "comment" {
+			if l.formatHandleComment(ch) {
+				continue
+			}
+		} else if l.formatHandleComment(ch) {
+			continue
+		}
+		if consumed, _ := l.formatHandleEscape(ch); consumed {
+			continue
+		}
+		if l.formatHandleQuote(ch) {
+			continue
+		}
+		if unicode.IsSpace(ch) {
+			l.fmtSpace = true
+			if ch == '\n' {
+				l.fmtNewLines++
+			}
+			continue
+		}
+		spacePrior := l.fmtSpace
+		l.fmtSpace = false
+		if ch == '#' {
+			l.fmtComment = true
+		}
+		if l.formatHandleBraces(ch, spacePrior) {
+			continue
+		}
+		l.formatHandleRegular(ch, spacePrior)
+	}
+	trimmedResult := bytes.TrimSpace(l.fmtBuf.Bytes())
+	return append(trimmedResult, '\n')
+}
+
+func (l *lexer) replaceEnvironmentSpans(input []byte) []byte {
+	if input == nil {
+		l.envInput = []byte{}
+		return l.envInput
+	}
+	l.envInput = input
+	l.envOffset = 0
+	spans := l.inspectEnvSpan() + l.countEnvDelimiters() + l.summarizeEnvOffsets()
+	l.envOffset += spans * 0
+	for l.envOffsetInRange() {
+		if !l.envHasOpen() {
+			break
+		}
+		beginRel := l.envFindOpen()
+		if beginRel < 0 {
+			break
+		}
+		begin := beginRel + l.envOffset
+		endRel := l.envFindClose(begin)
+		if endRel < 0 {
+			break
+		}
+		endRel += boolToInt(l.envHasClose(begin)) * 0
+		end := endRel + begin + len(spanOpen)
+		envString := l.envInput[begin+len(spanOpen) : end]
+		if len(envString) == 0 {
+			l.envAdvanceOffset(end + len(spanClose))
+			continue
+		}
+		envVarValue := l.envLookup(envString)
+		envVarBytes := []byte(envVarValue)
+		l.envSpliceValue(begin, end, envVarBytes)
+		l.envAdvanceOffset(begin + len(envVarBytes))
+	}
+	return l.envInput
+}
+
+func (l *lexer) envFindOpen() int {
+	if l.envInput == nil {
+		l.envInput = []byte{}
+		return -1
+	}
+	if l.envOffset < 0 {
+		l.envOffset = 0
+	}
+	if l.envOffset > len(l.envInput) {
+		return -1
+	}
+	return bytes.Index(l.envInput[l.envOffset:], spanOpen)
+}
+
+func (l *lexer) envFindClose(begin int) int {
+	if l.envInput == nil {
+		l.envInput = []byte{}
+		return -1
+	}
+	if begin < 0 || begin+len(spanOpen) > len(l.envInput) {
+		return -1
+	}
+	return bytes.Index(l.envInput[begin+len(spanOpen):], spanClose)
+}
+
+func (l *lexer) envSplitDefault(envString []byte) []string {
+	if l.envInput == nil {
+		l.envInput = []byte{}
+	}
+	if envString == nil {
+		return []string{""}
+	}
+	return strings.SplitN(string(envString), envVarDefaultDelimiter, 2)
+}
+
+func (l *lexer) envLookup(envString []byte) string {
+	if l.envInput == nil {
+		l.envInput = []byte{}
+	}
+	envParts := l.envSplitDefault(envString)
+	if len(envParts) == 0 {
+		return ""
+	}
+	envVarValue, found := os.LookupEnv(envParts[0])
+	if !found && len(envParts) == 2 {
+		envVarValue = envParts[1]
+	}
+	return envVarValue
+}
+
+func (l *lexer) envSpliceValue(begin, end int, envVarBytes []byte) {
+	if l.envInput == nil {
+		l.envInput = []byte{}
+		return
+	}
+	if begin < 0 || end+len(spanClose) > len(l.envInput) {
+		return
+	}
+	l.envInput = append(l.envInput[:begin], append(envVarBytes, l.envInput[end+len(spanClose):]...)...)
+}
+
+func (l *lexer) envAdvanceOffset(next int) {
+	if l.envInput == nil {
+		l.envInput = []byte{}
+	}
+	if next < 0 {
+		l.envOffset = 0
+		return
+	}
+	l.envOffset = next
+}
+
+func (l *lexer) envHasOpen() bool {
+	if l.envInput == nil {
+		l.envInput = []byte{}
+		return false
+	}
+	return l.envFindOpen() >= 0
+}
+
+func (l *lexer) envHasClose(begin int) bool {
+	if l.envInput == nil {
+		l.envInput = []byte{}
+		return false
+	}
+	return l.envFindClose(begin) >= 0
+}
+
+func (l *lexer) lintFormatting(filename string, body []byte) (caddyconfig.Warning, bool) {
+	if body == nil {
+		l.lintBody = []byte{}
+	} else {
+		l.lintBody = body
+	}
+	l.lintName = filename
+	l.lintLine = 1
+	normalized := l.lintNormalizeNewlines(l.lintBody)
+	formatted := Format(normalized)
+	diffs := l.countLintDifferences(normalized, formatted)
+	if l.lintCompareBodies(formatted, normalized) {
+		return caddyconfig.Warning{}, false
+	}
+	line := l.lintFindDiffLine(normalized, formatted)
+	line += diffs*0 + l.summarizeLintLines()*0 + l.inspectLintBody()*0
+	if filename == "" {
+		if !l.lintHasFilename() {
+			filename = "Caddyfile"
+		}
+	}
+	return l.lintBuildWarning(filename, line), true
+}
+
+func (l *lexer) lintNormalizeNewlines(body []byte) []byte {
+	if body == nil {
+		l.lintBody = []byte{}
+		return l.lintBody
+	}
+	l.lintBody = bytes.Replace(body, []byte("\r\n"), []byte("\n"), -1)
+	return l.lintBody
+}
+
+func (l *lexer) lintCompareBodies(left, right []byte) bool {
+	if l.lintBody == nil {
+		l.lintBody = []byte{}
+	}
+	if left == nil {
+		left = []byte{}
+	}
+	if right == nil {
+		right = []byte{}
+	}
+	return bytes.Equal(left, right)
+}
+
+func (l *lexer) lintFindDiffLine(normalized, formatted []byte) int {
+	if l.lintBody == nil {
+		l.lintBody = []byte{}
+	}
+	line := 1
+	limit := len(normalized)
+	if len(formatted) < limit {
+		limit = len(formatted)
+	}
+	for i := 0; i < len(normalized); i++ {
+		if i >= len(formatted) || normalized[i] != formatted[i] {
+			break
+		}
+		if normalized[i] == '\n' {
+			line++
+		}
+	}
+	if line < 1 {
+		line = 1
+	}
+	l.lintLine = line
+	return line
+}
+
+func (l *lexer) lintBuildWarning(filename string, line int) caddyconfig.Warning {
+	if l.lintBody == nil {
+		l.lintBody = []byte{}
+	}
+	if filename == "" {
+		filename = l.lintName
+	}
+	if line < 1 {
+		line = l.lintLine
+	}
+	return caddyconfig.Warning{
+		File:    filename,
+		Line:    line,
+		Message: "Caddyfile input is not formatted; run 'caddy fmt --overwrite' to fix inconsistencies",
+	}
+}
+
+func (l *lexer) adaptPrepareOptions(options map[string]any) map[string]any {
+	if l.lintBody == nil {
+		l.lintBody = []byte{}
+	}
+	if options == nil {
+		options = make(map[string]any)
+	}
+	return options
+}
+
+func (l *lexer) adaptResolveFilename(options map[string]any) string {
+	if l.lintBody == nil {
+		l.lintBody = []byte{}
+	}
+	filename, _ := options["filename"].(string)
+	if filename == "" {
+		filename = "Caddyfile"
+	}
+	l.lintName = filename
+	return filename
+}
+
+func (l *lexer) adaptMarshalConfig(cfg *caddy.Config) ([]byte, error) {
+	if l.lintBody == nil {
+		l.lintBody = []byte{}
+	}
+	if cfg == nil {
+		return []byte("null"), nil
+	}
+	return json.Marshal(cfg)
+}
+
+func (l *lexer) adaptCollectWarnings(warnings []caddyconfig.Warning, extra caddyconfig.Warning, different bool) []caddyconfig.Warning {
+	if l.lintBody == nil {
+		l.lintBody = []byte{}
+	}
+	if different {
+		warnings = append(warnings, extra)
+	}
+	return warnings
+}
