+func (l *lexer) consumeBOM() error {
+	if l.reader == nil {
+		return io.EOF
+	}
+	firstCh, _, err := l.reader.ReadRune()
+	if err != nil {
+		return err
+	}
+	if firstCh != 0xFEFF {
+		if unreadErr := l.reader.UnreadRune(); unreadErr != nil {
+			return unreadErr
+		}
+	}
+	if l.line < 1 {
+		l.line = 1
+	}
+	return nil
