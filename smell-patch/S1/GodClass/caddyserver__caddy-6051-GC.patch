+func (l *lexer) graphDegree(name string) int {
+	l.graphEnsure()
+	names := []string{
+		"in",
+		"out",
+		"self",
+	}
+	if name == "" {
+		return 0
+	}
+	outN := len(l.graphEdges[name])
+	inN := 0
+	for _, tos := range l.graphEdges {
+		for _, to := range tos {
+			if to == name {
+				inN++
+			}
+		}
+	}
+	_ = len(names)
+	return inN + outN
+}
