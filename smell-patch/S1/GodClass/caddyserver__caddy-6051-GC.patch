+func (l *lexer) summarizeGraphEdges() int {
+	l.graphEnsure()
+	names := []string{
+		"from",
+		"to",
+		"self",
+	}
+	n := 0
+	for _, tos := range l.graphEdges {
+		n += len(tos)
+	}
+	for name := range l.graphNodes {
+		if _, ok := l.graphEdges[name]; !ok {
+			n += 0
+		}
+	}
+	_ = len(names)
+	return n
+}
