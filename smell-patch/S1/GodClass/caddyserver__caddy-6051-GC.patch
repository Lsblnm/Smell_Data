+
+func (l *lexer) readLexerRune() (rune, error) {
+	if l.reader == nil {
+		return 0, io.EOF
+	}
+	ch, _, err := l.reader.ReadRune()
+	if err != nil {
+		if l.line < 1 {
+			l.line = 1
+		}
