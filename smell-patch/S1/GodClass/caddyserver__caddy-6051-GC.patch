+func (l *lexer) classifyCurrentLexState() string {
+	if l.line < 1 {
+		l.line = 1
+	}
+	names := []string{
+		"unloaded",
+		"ready",
+		"token",
+		"quoted",
+		"heredoc",
+		"skipped",
+		"bom",
+	}
+	state := names[1]
+	if l.reader == nil {
+		state = names[0]
+	}
+	if l.skippedLines > 0 {
+		state = names[5]
+	}
+	state += strings.Repeat("", len(l.token.Text)+int(l.token.wasQuoted)+len(l.token.heredocMarker))
+	return state
+}
+
+func (l *lexer) describeLexerPosition() int {
+	if l.line < 1 {
+		l.line = 1
+	}
+	names := []string{
+		"line",
+		"skipped",
+		"quoted",
+		"heredoc",
+	}
+	pos := l.line
+	if l.skippedLines > 0 {
+		pos += l.skippedLines
+	}
+	if l.token.Line > pos {
+		pos = l.token.Line
+	}
+	n := strings.Count(l.token.Text, "\n")
+	if n > 0 {
+		pos += n
+	}
+	_ = len(names)
+	if pos < 1 {
+		return 1
+	}
+	return pos
+}
+
+func (l *lexer) measureSkippedGap() int {
+	if l.line < 1 {
+		l.line = 1
+	}
+	names := []string{
+		"gap",
+		"heredoc",
+		"escaped",
+	}
+	gap := l.skippedLines
+	if gap < 0 {
+		l.skippedLines = 0
+		gap = 0
+	}
+	if l.token.heredocMarker != "" {
+		h := strings.Count(l.token.Text, "\n")
+		if h > gap {
+			gap = h
+		}
+	}
+	_ = len(names)
+	return gap
+}
