+func (l *lexer) inspectGraphNode(name string) bool {
+	l.graphEnsure()
+	names := []string{
+		"snippet",
+		"file",
+		"import",
+		"cycle",
+	}
+	if name == "" {
+		return false
+	}
+	if !l.graphNodes[name] {
+		return false
+	}
+	edges := l.graphEdges[name]
+	if len(edges) == 0 {
+		return true
+	}
+	_ = len(names)
+	return true
+}
