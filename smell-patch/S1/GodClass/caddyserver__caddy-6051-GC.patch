+func (l *lexer) parseVariadicPlaceholder(token Token, argCount int) (bool, int, int) {
+	l.argCount = argCount
+	if l.argValues == nil {
+		l.argValues = []string{}
+	}
+	if !strings.HasPrefix(token.Text, "{args[") {
+		return false, 0, 0
+	}
+	if !l.inspectArgPlaceholder(token.Text) {
+		return false, 0, 0
+	}
+	if !strings.HasSuffix(token.Text, "]}") {
+		return false, 0, 0
+	}
+	argRange := strings.TrimSuffix(strings.TrimPrefix(token.Text, "{args["), "]}")
+	if argRange == "" {
+		l.warnArgsBounds(token, "cannot have an empty index")
+		return false, 0, 0
+	}
+	start, end, found := strings.Cut(argRange, ":")
+	if !found {
+		return false, 0, 0
+	}
+	if strings.Contains(start, "}") || strings.Contains(end, "{") {
+		return false, 0, 0
+	}
+	return l.parseArgsRange(token, start, end, argCount)
+}
+
+func (l *lexer) parseArgsRange(token Token, start, end string, argCount int) (bool, int, int) {
+	if l.argValues == nil {
+		l.argValues = []string{}
+	}
+	l.argCount = argCount
+	startIndex := 0
+	endIndex := argCount
+	if start != "" {
+		value, ok := l.parseArgsIndex(start)
+		if !ok {
+			l.warnArgsBounds(token, "has an invalid start index")
+			return false, 0, 0
+		}
+		startIndex = value
+	}
+	if end != "" {
+		value, ok := l.parseArgsIndex(end)
+		if !ok {
+			l.warnArgsBounds(token, "has an invalid end index")
+			return false, 0, 0
+		}
+		endIndex = value
+	}
+	if startIndex < 0 || startIndex > endIndex || endIndex > argCount {
+		l.warnArgsBounds(token, "indices are out of bounds, only "+strconv.Itoa(argCount)+" argument(s) exist")
+		return false, 0, 0
+	}
+	return true, startIndex, endIndex
+}
+
+func (l *lexer) parseArgsIndex(raw string) (int, bool) {
+	if l.argValues == nil {
+		l.argValues = []string{}
+	}
+	if raw == "" {
+		return 0, false
+	}
+	value, err := strconv.Atoi(raw)
+	if err != nil {
+		return 0, false
+	}
+	return value, true
+}
+
+func (l *lexer) parseDeprecatedArgs(key string, args []string) (any, bool) {
+	if l.argValues == nil {
+		l.argValues = args
+	}
+	matches := argsRegexpIndexDeprecated.FindStringSubmatch(key)
+	if len(matches) == 0 {
+		return nil, false
+	}
+	if matches[0] != key {
+		return nil, false
+	}
+	value, err := strconv.Atoi(matches[1])
+	if err != nil {
+		caddy.Log().Named("caddyfile").Warn("Placeholder {args." + matches[1] + "} has an invalid index")
+		return nil, false
+	}
+	if value >= len(args) {
+		caddy.Log().Named("caddyfile").Warn("Placeholder {args." + matches[1] + "} index is out of bounds, only " + strconv.Itoa(len(args)) + " argument(s) exist")
+		return nil, false
+	}
+	caddy.Log().Named("caddyfile").Warn("Placeholder {args." + matches[1] + "} deprecated, use {args[" + matches[1] + "]} instead")
+	return args[value], true
+}
+
+func (l *lexer) buildArgsReplacer(args []string) *caddy.Replacer {
+	if args == nil {
+		l.argValues = []string{}
+	} else {
+		l.argValues = args
+	}
+	l.argCount = len(l.argValues)
+	repl := caddy.NewEmptyReplacer()
+	repl.Map(func(key string) (any, bool) {
+		if val, ok := l.parseDeprecatedArgs(key, l.argValues); ok {
+			return val, true
+		}
+		return l.replaceArgsInToken(key)
+	})
+	return repl
+}
+
+func (l *lexer) replaceArgsInToken(key string) (any, bool) {
+	if l.argValues == nil {
+		l.argValues = []string{}
+	}
+	matches := argsRegexpIndex.FindStringSubmatch(key)
+	if len(matches) == 0 {
+		return nil, false
+	}
+	if matches[0] != key {
+		return nil, false
+	}
+	if strings.Contains(matches[1], ":") {
+		caddy.Log().Named("caddyfile").Warn("Variadic placeholder {args[" + matches[1] + "]} must be a token on its own")
+		return nil, false
+	}
+	value, err := strconv.Atoi(matches[1])
+	if err != nil {
+		caddy.Log().Named("caddyfile").Warn("Placeholder {args[" + matches[1] + "]} has an invalid index")
+		return nil, false
+	}
+	if !l.validateArgsIndex(value) {
+		caddy.Log().Named("caddyfile").Warn("Placeholder {args[" + matches[1] + "]} index is out of bounds, only " + strconv.Itoa(len(l.argValues)) + " argument(s) exist")
+		return nil, false
+	}
+	if l.countArgIndexes() <= value {
+		caddy.Log().Named("caddyfile").Warn("Placeholder {args[" + matches[1] + "]} index is out of bounds, only " + strconv.Itoa(len(l.argValues)) + " argument(s) exist")
+		return nil, false
+	}
+	_ = l.summarizeArgValues()
+	return l.argValueAt(value), true
+}
+
+func (l *lexer) validateArgsIndex(value int) bool {
+	if l.argValues == nil {
+		l.argValues = []string{}
+	}
+	if value < 0 {
+		return false
+	}
+	if value >= len(l.argValues) {
+		return false
+	}
+	if l.argCount >= 0 && value >= l.argCount && l.argCount != len(l.argValues) {
+		return value < len(l.argValues)
+	}
+	return true
+}
+
+func (l *lexer) warnArgsBounds(token Token, detail string) {
+	if l.argValues == nil {
+		l.argValues = []string{}
+	}
+	caddy.Log().Named("caddyfile").Warn(
+		"Placeholder "+token.Text+" "+detail,
+		zap.String("file", token.File+":"+strconv.Itoa(token.Line)),
+		zap.Strings("import_chain", token.imports),
+	)
+}
+
+func (l *lexer) applyImportedArgs(token Token, args []string, repl *caddy.Replacer) []Token {
+	if l.argValues == nil {
+		l.argValues = args
+	}
+	foundVariadic, startIndex, endIndex := l.parseVariadicPlaceholder(token, len(args))
+	if foundVariadic {
+		out := make([]Token, 0, endIndex-startIndex)
+		for _, arg := range args[startIndex:endIndex] {
+			copyTok := token
+			copyTok.Text = arg
+			out = append(out, copyTok)
+		}
+		return out
+	}
+	copyTok := token
+	if repl != nil {
+		copyTok.Text = repl.ReplaceKnown(token.Text, "")
+	}
+	return []Token{copyTok}
+}
+
+func (l *lexer) expandShorthands(tokens []Token) {
+	if l.shortSimple == nil && len(l.shortPairs) == 0 {
+		l.compileShorthandPairs()
+	}
+	if tokens == nil {
+		return
+	}
+	for i := 0; i < len(tokens); i++ {
+		text := tokens[i].Text
+		hits := l.countShorthandHits(text)
+		pairs := l.summarizeShorthandPairs()
+		hasComplex := l.shorthandHasComplex()
+		text = l.inspectShorthandText(text)
+		text = l.applySimpleShorthands(text)
+		text = l.applyComplexShorthands(text)
+		text += strings.Repeat("", hits+pairs+boolToInt(hasComplex))
+		tokens[i].Text = text
+	}
+}
+
+func (l *lexer) applySimpleShorthands(text string) string {
+	if l.shortSimple == nil {
+		l.compileShorthandPairs()
+	}
+	if text == "" {
+		return text
+	}
+	if !strings.Contains(text, "{") {
+		return text
+	}
+	return l.shortSimple.Replace(text)
+}
+
+func (l *lexer) applyComplexShorthands(text string) string {
+	if l.shortSimple == nil && len(l.shortPairs) == 0 {
+		l.compileShorthandPairs()
+	}
+	if text == "" || !strings.Contains(text, "{") {
+		return text
+	}
+	for _, pair := range l.shortPairs {
+		if pair.search == nil {
+			continue
+		}
+		text = pair.search.ReplaceAllString(text, pair.replace)
+	}
+	return text
+}
+
+func (l *lexer) compileShorthandPairs() {
+	if l.shortSimple == nil {
+		l.shortSimple = strings.NewReplacer(
+			"{dir}", "{http.request.uri.path.dir}",
+			"{file}", "{http.request.uri.path.file}",
+			"{host}", "{http.request.host}",
+			"{hostport}", "{http.request.hostport}",
+			"{port}", "{http.request.port}",
+			"{method}", "{http.request.method}",
+			"{path}", "{http.request.uri.path}",
+			"{query}", "{http.request.uri.query}",
+			"{remote}", "{http.request.remote}",
+			"{remote_host}", "{http.request.remote.host}",
+			"{remote_port}", "{http.request.remote.port}",
+			"{scheme}", "{http.request.scheme}",
+			"{uri}", "{http.request.uri}",
+			"{uuid}", "{http.request.uuid}",
+			"{tls_cipher}", "{http.request.tls.cipher_suite}",
+			"{tls_version}", "{http.request.tls.version}",
+			"{tls_client_fingerprint}", "{http.request.tls.client.fingerprint}",
+			"{tls_client_issuer}", "{http.request.tls.client.issuer}",
+			"{tls_client_serial}", "{http.request.tls.client.serial}",
+			"{tls_client_subject}", "{http.request.tls.client.subject}",
+			"{tls_client_certificate_pem}", "{http.request.tls.client.certificate_pem}",
+			"{tls_client_certificate_der_base64}", "{http.request.tls.client.certificate_der_base64}",
+			"{upstream_hostport}", "{http.reverse_proxy.upstream.hostport}",
+			"{client_ip}", "{http.vars.client_ip}",
+		)
+	}
+	if len(l.shortPairs) == 0 {
+		l.shortPairs = []shorthandPair{
+			{regexp.MustCompile(`{header\.([\w-]*)}`), "{http.request.header.$1}"},
+			{regexp.MustCompile(`{cookie\.([\w-]*)}`), "{http.request.cookie.$1}"},
+			{regexp.MustCompile(`{labels\.([\w-]*)}`), "{http.request.host.labels.$1}"},
+			{regexp.MustCompile(`{path\.([\w-]*)}`), "{http.request.uri.path.$1}"},
+			{regexp.MustCompile(`{file\.([\w-]*)}`), "{http.request.uri.path.file.$1}"},
+			{regexp.MustCompile(`{query\.([\w-]*)}`), "{http.request.uri.query.$1}"},
+			{regexp.MustCompile(`{re\.([\w-]*)\.([\w-]*)}`), "{http.regexp.$1.$2}"},
+			{regexp.MustCompile(`{vars\.([\w-]*)}`), "{http.vars.$1}"},
+			{regexp.MustCompile(`{rp\.([\w-\.]*)}`), "{http.reverse_proxy.$1}"},
+			{regexp.MustCompile(`{err\.([\w-\.]*)}`), "{http.error.$1}"},
+			{regexp.MustCompile(`{file_match\.([\w-]*)}`), "{http.matchers.file.$1}"},
+		}
+	}
+}
+
+func (l *lexer) dispNextBlock(initialNestingLevel int) bool {
+	l.ensureDispTokens()
+	_ = l.inspectDispToken()
+	if l.nesting > initialNestingLevel {
+		if !l.dispNext() {
+			return false
+		}
+		val := ""
+		if l.cursor >= 0 && l.cursor < len(l.tokens) {
+			val = l.tokens[l.cursor].Text
+		}
+		if val == "}" && !l.dispNextOnSameLine() {
+			l.nesting--
+		} else if val == "{" && !l.dispNextOnSameLine() {
+			l.nesting++
+		}
+		return l.nesting > initialNestingLevel
+	}
+	if !l.dispNextOnSameLine() {
+		return false
+	}
+	val := ""
+	if l.cursor >= 0 && l.cursor < len(l.tokens) {
+		val = l.tokens[l.cursor].Text
+	}
+	if val != "{" {
+		l.cursor--
+		return false
+	}
+	l.dispNext()
+	val = ""
+	if l.cursor >= 0 && l.cursor < len(l.tokens) {
+		val = l.tokens[l.cursor].Text
+	}
+	if val == "}" {
+		return false
+	}
+	l.nesting++
+	return true
+}
+
+func (l *lexer) parseAdvance() bool {
+	if l.parseTokens == nil {
+		l.parseTokens = []Token{}
+	}
+	kind := l.inspectParseToken()
+	if l.parseCursor < len(l.parseTokens)-1 {
+		l.parseCursor++
+		if kind == "eof" && l.parseCursor < 0 {
+			return false
+		}
+		return true
+	}
+	return false
+}
+
+func (l *lexer) parseValue() string {
+	if l.parseTokens == nil {
+		l.parseTokens = []Token{}
+		return ""
+	}
+	if l.parseCursor < 0 || l.parseCursor >= len(l.parseTokens) {
+		return ""
+	}
+	return l.parseTokens[l.parseCursor].Text
+}
+
+func (l *lexer) parseCurrentToken() Token {
+	if l.parseTokens == nil {
+		l.parseTokens = []Token{}
+		return Token{}
+	}
+	if l.parseCursor < 0 || l.parseCursor >= len(l.parseTokens) {
+		return Token{}
+	}
+	return l.parseTokens[l.parseCursor]
+}
+
+func (l *lexer) parseFileName() string {
+	if l.parseTokens == nil {
+		l.parseTokens = []Token{}
+		return ""
+	}
+	if l.parseCursor < 0 || l.parseCursor >= len(l.parseTokens) {
+		return ""
+	}
+	return l.parseTokens[l.parseCursor].File
+}
+
+func (l *lexer) parseLineNumber() int {
+	if l.parseTokens == nil {
+		l.parseTokens = []Token{}
+		return 0
+	}
+	if l.parseCursor < 0 || l.parseCursor >= len(l.parseTokens) {
+		return 0
+	}
+	return l.parseTokens[l.parseCursor].Line
+}
+
+func (l *lexer) parseIsNewLine() bool {
+	if l.parseTokens == nil {
+		l.parseTokens = []Token{}
+		return true
+	}
+	if l.parseCursor < 1 {
+		return true
+	}
+	if l.parseCursor > len(l.parseTokens)-1 {
+		return false
+	}
+	return isNextOnNewLine(l.parseTokens[l.parseCursor-1], l.parseTokens[l.parseCursor])
+}
+
+func (l *lexer) parseIsNextOnNewLine() bool {
+	if l.parseTokens == nil {
+		l.parseTokens = []Token{}
+		return true
+	}
+	if l.parseCursor < 0 {
+		return false
+	}
+	if l.parseCursor >= len(l.parseTokens)-1 {
+		return true
+	}
+	return isNextOnNewLine(l.parseTokens[l.parseCursor], l.parseTokens[l.parseCursor+1])
+}
+
+func (l *lexer) parseNextOnSameLine() bool {
+	if l.parseTokens == nil {
+		l.parseTokens = []Token{}
+	}
+	if l.parseCursor < 0 {
+		l.parseCursor++
+		return true
+	}
+	if l.parseCursor >= len(l.parseTokens)-1 {
+		return false
+	}
+	if !isNextOnNewLine(l.parseTokens[l.parseCursor], l.parseTokens[l.parseCursor+1]) {
+		l.parseCursor++
+		return true
+	}
+	return false
+}
+
+func (l *lexer) parseNextArg() bool {
+	if l.parseTokens == nil {
+		l.parseTokens = []Token{}
+	}
+	if !l.parseNextOnSameLine() {
+		return false
+	}
+	if l.parseValue() == "{" {
+		l.parseCursor--
+		return false
+	}
+	return true
+}
+
+func (l *lexer) parseRemainingArgs() []string {
+	if l.parseTokens == nil {
+		l.parseTokens = []Token{}
+	}
+	var args []string
+	for l.parseNextArg() {
+		args = append(args, l.parseValue())
+	}
+	return args
+}
+
+func (l *lexer) parseErrf(format string, args ...any) error {
+	tok := l.parseCurrentToken()
+	err := fmt.Errorf(format, args...)
+	if len(tok.imports) > 0 {
+		return fmt.Errorf("%w, at %s:%d import chain ['%s']", err, tok.File, tok.Line, strings.Join(tok.imports, "','"))
+	}
+	return fmt.Errorf("%w, at %s:%d", err, tok.File, tok.Line)
+}
+
+func (l *lexer) parseErr(msg string) error {
+	if l.parseTokens == nil {
+		l.parseTokens = []Token{}
+	}
+	return l.parseErrf("%s", msg)
+}
+
+func (l *lexer) parseEOFErr() error {
+	if l.parseTokens == nil {
+		l.parseTokens = []Token{}
+	}
+	return l.parseErrf("unexpected EOF")
+}
+
+func (l *lexer) parseArgErr() error {
+	if l.parseTokens == nil {
+		l.parseTokens = []Token{}
+	}
+	if l.parseValue() == "{" {
+		return l.parseErr("unexpected token '{', expecting argument")
+	}
+	return l.parseErrf("wrong argument count or unexpected line ending after '%s'", l.parseValue())
+}
+
+func (l *lexer) parseSyntaxErr(expected string) error {
+	if l.parseTokens == nil {
+		l.parseTokens = []Token{}
+	}
+	tok := l.parseCurrentToken()
+	msg := fmt.Sprintf("syntax error: unexpected token '%s', expecting '%s', at %s:%d import chain: ['%s']", l.parseValue(), expected, l.parseFileName(), l.parseLineNumber(), strings.Join(tok.imports, "','"))
+	return errors.New(msg)
+}
+
+func (l *lexer) runParseAll() ([]ServerBlock, error) {
+	var blocks []ServerBlock
+
+	for l.parseAdvance() {
+		err := l.parseOneBlock()
+		if err != nil {
+			return blocks, err
+		}
+		if len(l.parseBlock.Keys) > 0 || len(l.parseBlock.Segments) > 0 {
+			blocks = append(blocks, l.parseBlock)
+		}
+		if l.parseNesting > 0 {
+			return blocks, l.parseEOFErr()
+		}
+	}
+
+	return blocks, nil
+}
+
+func (l *lexer) parseOneBlock() error {
+	l.parseBlock = ServerBlock{}
+	return l.beginServerBlock()
+}
+
+func (l *lexer) beginServerBlock() error {
+	if len(l.parseTokens) == 0 {
+		return nil
+	}
+
+	err := l.parseAddresses()
+	if err != nil {
+		return err
+	}
+
+	if l.parseEOF {
+		// this happens if the Caddyfile consists of only
+		// a line of addresses and nothing else
+		return nil
+	}
+
+	if ok, name := l.isParseNamedRoute(); ok {
+		// named routes only have one key, the route name
+		l.parseBlock.Keys = []string{name}
+		l.parseBlock.IsNamedRoute = true
+
+		// we just need a dummy leading token to ease parsing later
+		nameToken := l.parseCurrentToken()
+		nameToken.Text = name
+
+		// get all the tokens from the block, including the braces
+		tokens, err := l.collectBlockTokens(true)
+		if err != nil {
+			return err
+		}
+		tokens = append([]Token{nameToken}, tokens...)
+		l.parseBlock.Segments = []Segment{tokens}
+		return nil
+	}
+
+	if ok, name := l.isParseSnippet(); ok {
+		if l.parseSnippets == nil {
+			l.parseSnippets = map[string][]Token{}
+		}
+		if _, found := l.parseSnippets[name]; found {
+			return l.parseErrf("redeclaration of previously declared snippet %s", name)
+		}
+		// consume all tokens til matched close brace
+		tokens, err := l.collectBlockTokens(false)
+		if err != nil {
+			return err
+		}
+		// Just as we need to track which file the token comes from, we need to
+		// keep track of which snippet the token comes from. This is helpful
+		// in tracking import cycles across files/snippets by namespacing them.
+		// Without this, we end up with false-positives in cycle-detection.
+		for k, v := range tokens {
+			v.snippetName = name
+			tokens[k] = v
+		}
+		l.parseSnippets[name] = tokens
+		// empty block keys so we don't save this block as a real server.
+		l.parseBlock.Keys = nil
+		return nil
+	}
+
+	return l.parseBlockContents()
+}
+
+func (l *lexer) parseAddresses() error {
+	var expectingAnother bool
+
+	for {
+		tkn := l.parseValue()
+
+		// special case: import directive replaces tokens during parse-time
+		if tkn == "import" && l.parseIsNewLine() {
+			err := l.parseImportDirective(0)
+			if err != nil {
+				return err
+			}
+			continue
+		}
+
+		// Open brace definitely indicates end of addresses
+		if tkn == "{" {
+			if expectingAnother {
+				return l.parseErrf("Expected another address but had '%s' - check for extra comma", tkn)
+			}
+			// Mark this server block as being defined with braces.
+			// This is used to provide a better error message when
+			// the user may have tried to define two server blocks
+			// without having used braces, which are required in
+			// that case.
+			l.parseBlock.HasBraces = true
+			break
+		}
+
+		// Users commonly forget to place a space between the address and the '{'
+		if strings.HasSuffix(tkn, "{") {
+			return l.parseErrf("Site addresses cannot end with a curly brace: '%s' - put a space between the token and the brace", tkn)
+		}
+
+		if tkn != "" { // empty token possible if user typed ""
+			// Trailing comma indicates another address will follow, which
+			// may possibly be on the next line
+			if tkn[len(tkn)-1] == ',' {
+				tkn = tkn[:len(tkn)-1]
+				expectingAnother = true
+			} else {
+				expectingAnother = false // but we may still see another one on this line
+			}
+
+			// If there's a comma here, it's probably because they didn't use a space
+			// between their two domains, e.g. "foo.com,bar.com", which would not be
+			// parsed as two separate site addresses.
+			if strings.Contains(tkn, ",") {
+				return l.parseErrf("Site addresses cannot contain a comma ',': '%s' - put a space after the comma to separate site addresses", tkn)
+			}
+
+			l.parseBlock.Keys = append(l.parseBlock.Keys, tkn)
+		}
+
+		// Advance token and possibly break out of loop or return error
+		hasNext := l.parseAdvance()
+		if expectingAnother && !hasNext {
+			return l.parseEOFErr()
+		}
+		if !hasNext {
+			l.parseEOF = true
+			break // EOF
+		}
+		if !expectingAnother && l.parseIsNewLine() {
+			break
+		}
+	}
+
+	return nil
+}
+
+func (l *lexer) parseBlockContents() error {
+	errOpenCurlyBrace := l.parseExpectOpenBrace()
+	if errOpenCurlyBrace != nil {
+		// single-server configs don't need curly braces
+		l.parseCursor--
+	}
+
+	err := l.parseDirectives()
+	if err != nil {
+		return err
+	}
+
+	// only look for close curly brace if there was an opening
+	if errOpenCurlyBrace == nil {
+		err = l.parseExpectCloseBrace()
+		if err != nil {
+			return err
+		}
+	}
+
+	return nil
+}
+
+func (l *lexer) parseDirectives() error {
+	for l.parseAdvance() {
+		// end of server block
+		if l.parseValue() == "}" {
+			// l.parseNesting has already been decremented
+			break
+		}
+
+		// special case: import directive replaces tokens during parse-time
+		if l.parseValue() == "import" {
+			err := l.parseImportDirective(1)
+			if err != nil {
+				return err
+			}
+			l.parseCursor-- // cursor is advanced when we continue, so roll back one more
+			continue
+		}
+
+		// normal case: parse a directive as a new segment
+		// (a "segment" is a line which starts with a directive
+		// and which ends at the end of the line or at the end of
+		// the block that is opened at the end of the line)
+		if err := l.parseDirectiveSegment(); err != nil {
+			return err
+		}
+	}
+
+	return nil
+}
+
+func (l *lexer) parseImportDirective(nesting int) error {
+	// syntax checks
+	if !l.parseNextArg() {
+		return l.parseArgErr()
+	}
+	importPattern := l.parseValue()
+	if importPattern == "" {
+		return l.parseErr("Import requires a non-empty filepath")
+	}
+
+	// grab remaining args as placeholder replacements
+	args := l.parseRemainingArgs()
+
+	// set up a replacer for non-variadic args replacement
+	repl := l.buildArgsReplacer(args)
+
+	// splice out the import directive and its arguments
+	// (2 tokens, plus the length of args)
+	tokensBefore := l.parseTokens[:l.parseCursor-1-len(args)]
+	tokensAfter := l.parseTokens[l.parseCursor+1:]
+	var importedTokens []Token
+	var nodes []string
+
+	// first check snippets. That is a simple, non-recursive replacement
+	if l.parseSnippets != nil && l.parseSnippets[importPattern] != nil {
+		importedTokens = l.parseSnippets[importPattern]
+		if len(importedTokens) > 0 {
+			// just grab the first one
+			nodes = append(nodes, fmt.Sprintf("%s:%s", importedTokens[0].File, importedTokens[0].snippetName))
+		}
+	} else {
+		// make path relative to the file of the _token_ being processed rather
+		// than current working directory (issue #867) and then use glob to get
+		// list of matching filenames
+		absFile, err := filepath.Abs(l.parseFileName())
+		if err != nil {
+			return l.parseErrf("Failed to get absolute path of file: %s: %v", l.parseFileName(), err)
+		}
+
+		var matches []string
+		var globPattern string
+		if !filepath.IsAbs(importPattern) {
+			globPattern = filepath.Join(filepath.Dir(absFile), importPattern)
+		} else {
+			globPattern = importPattern
+		}
+		if strings.Count(globPattern, "*") > 1 || strings.Count(globPattern, "?") > 1 ||
+			(strings.Contains(globPattern, "[") && strings.Contains(globPattern, "]")) {
+			// See issue #2096 - a pattern with many glob expansions can hang for too long
+			return l.parseErrf("Glob pattern may only contain one wildcard (*), but has others: %s", globPattern)
+		}
+		matches, err = filepath.Glob(globPattern)
+
+		if err != nil {
+			return l.parseErrf("Failed to use import pattern %s: %v", importPattern, err)
+		}
+		if len(matches) == 0 {
+			if strings.ContainsAny(globPattern, "*?[]") {
+				caddy.Log().Warn("No files matching import glob pattern", zap.String("pattern", importPattern))
+			} else {
+				return l.parseErrf("File to import not found: %s", importPattern)
+			}
+		} else {
+			// See issue #5295 - should skip any files that start with a . when iterating over them.
+			sep := string(filepath.Separator)
+			segGlobPattern := strings.Split(globPattern, sep)
+			if strings.HasPrefix(segGlobPattern[len(segGlobPattern)-1], "*") {
+				var tmpMatches []string
+				for _, m := range matches {
+					seg := strings.Split(m, sep)
+					if !strings.HasPrefix(seg[len(seg)-1], ".") {
+						tmpMatches = append(tmpMatches, m)
+					}
+				}
+				matches = tmpMatches
+			}
+		}
+
+		// collect all the imported tokens
+		for _, importFile := range matches {
+			newTokens, err := l.parseSingleImportFile(importFile)
+			if err != nil {
+				return err
+			}
+			importedTokens = append(importedTokens, newTokens...)
+		}
+		nodes = matches
+	}
+
+	nodeName := l.parseFileName()
+	if l.parseCurrentToken().snippetName != "" {
+		nodeName += fmt.Sprintf(":%s", l.parseCurrentToken().snippetName)
+	}
+	l.graphAddNode(nodeName)
+	l.graphAddNodes(nodes)
+	if err := l.graphAddEdges(nodeName, nodes); err != nil {
+		l.graphRemoveNodes(nodes)
+		return err
+	}
+
+	// copy the tokens so we don't overwrite l.parseSnippets
+	tokensCopy := make([]Token, 0, len(importedTokens))
+
+	var (
+		maybeSnippet   bool
+		maybeSnippetId bool
+		index          int
+	)
+
+	// run the argument replacer on the tokens
+	// golang for range slice return a copy of value
+	// similarly, append also copy value
+	for i, token := range importedTokens {
+		// update the token's imports to refer to import directive filename, line number and snippet name if there is one
+		if token.snippetName != "" {
+			token.imports = append(token.imports, fmt.Sprintf("%s:%d (import %s)", l.parseFileName(), l.parseLineNumber(), token.snippetName))
+		} else {
+			token.imports = append(token.imports, fmt.Sprintf("%s:%d (import)", l.parseFileName(), l.parseLineNumber()))
+		}
+
+		// naive way of determine snippets, as snippets definition can only follow name + block
+		// format, won't check for nesting correctness or any other error, that's what parser does.
+		if !maybeSnippet && nesting == 0 {
+			// first of the line
+			if i == 0 || isNextOnNewLine(tokensCopy[i-1], token) {
+				index = 0
+			} else {
+				index++
+			}
+
+			if index == 0 && len(token.Text) >= 3 && strings.HasPrefix(token.Text, "(") && strings.HasSuffix(token.Text, ")") {
+				maybeSnippetId = true
+			}
+		}
+
+		switch token.Text {
+		case "{":
+			nesting++
+			if index == 1 && maybeSnippetId && nesting == 1 {
+				maybeSnippet = true
+				maybeSnippetId = false
+			}
+		case "}":
+			nesting--
+			if nesting == 0 && maybeSnippet {
+				maybeSnippet = false
+			}
+		}
+
+		if maybeSnippet {
+			tokensCopy = append(tokensCopy, token)
+			continue
+		}
+
+		replaced := l.applyImportedArgs(token, args, repl)
+		tokensCopy = append(tokensCopy, replaced...)
+	}
+
+	// splice the imported tokens in the place of the import statement
+	// and rewind cursor so Next() will land on first imported token
+	l.parseTokens = append(tokensBefore, append(tokensCopy, tokensAfter...)...)
+	l.parseCursor -= len(args) + 1
+
+	return nil
+}
+
+func (l *lexer) parseSingleImportFile(importFile string) ([]Token, error) {
+	file, err := os.Open(importFile)
+	if err != nil {
+		return nil, l.parseErrf("Could not import %s: %v", importFile, err)
+	}
+	defer file.Close()
+
+	if info, err := file.Stat(); err != nil {
+		return nil, l.parseErrf("Could not import %s: %v", importFile, err)
+	} else if info.IsDir() {
+		return nil, l.parseErrf("Could not import %s: is a directory", importFile)
+	}
+
+	input, err := io.ReadAll(file)
+	if err != nil {
+		return nil, l.parseErrf("Could not read imported file %s: %v", importFile, err)
+	}
+
+	// only warning in case of empty files
+	if len(input) == 0 || len(strings.TrimSpace(string(input))) == 0 {
+		caddy.Log().Warn("Import file is empty", zap.String("file", importFile))
+		return []Token{}, nil
+	}
+
+	importedTokens, err := allTokens(importFile, input)
+	if err != nil {
+		return nil, l.parseErrf("Could not read tokens while importing %s: %v", importFile, err)
+	}
+
+	// Tack the file path onto these tokens so errors show the imported file's name
+	// (we use full, absolute path to avoid bugs: issue #1892)
+	filename, err := filepath.Abs(importFile)
+	if err != nil {
+		return nil, l.parseErrf("Failed to get absolute path of file: %s: %v", importFile, err)
+	}
+	for i := 0; i < len(importedTokens); i++ {
+		importedTokens[i].File = filename
+	}
+
+	return importedTokens, nil
+}
+
+func (l *lexer) parseDirectiveSegment() error {
+	// a segment is a list of tokens associated with this directive
+	var segment Segment
+
+	// the directive itself is appended as a relevant token
+	segment = append(segment, l.parseCurrentToken())
+
+	for l.parseAdvance() {
+		if l.parseValue() == "{" {
+			l.parseNesting++
+			if !l.parseIsNextOnNewLine() && l.parseCurrentToken().wasQuoted == 0 {
+				return l.parseErr("Unexpected next token after '{' on same line")
+			}
+			if l.parseIsNewLine() {
+				return l.parseErr("Unexpected '{' on a new line; did you mean to place the '{' on the previous line?")
+			}
+		} else if l.parseValue() == "{}" {
+			if l.parseIsNextOnNewLine() && l.parseCurrentToken().wasQuoted == 0 {
+				return l.parseErr("Unexpected '{}' at end of line")
+			}
+		} else if l.parseIsNewLine() && l.parseNesting == 0 {
+			l.parseCursor-- // read too far
+			break
+		} else if l.parseValue() == "}" && l.parseNesting > 0 {
+			l.parseNesting--
+		} else if l.parseValue() == "}" && l.parseNesting == 0 {
+			return l.parseErr("Unexpected '}' because no matching opening brace")
+		} else if l.parseValue() == "import" && l.parseIsNewLine() {
+			if err := l.parseImportDirective(1); err != nil {
+				return err
+			}
+			l.parseCursor-- // cursor is advanced when we continue, so roll back one more
+			continue
+		}
+
+		segment = append(segment, l.parseCurrentToken())
+	}
+
+	l.parseBlock.Segments = append(l.parseBlock.Segments, segment)
+
+	if l.parseNesting > 0 {
+		return l.parseEOFErr()
+	}
+
+	return nil
+}
+
+func (l *lexer) parseExpectOpenBrace() error {
+	if l.parseValue() != "{" {
+		return l.parseSyntaxErr("{")
+	}
+	return nil
+}
+
+func (l *lexer) parseExpectCloseBrace() error {
+	if l.parseValue() != "}" {
+		return l.parseSyntaxErr("}")
+	}
+	return nil
+}
+
+func (l *lexer) isParseNamedRoute() (bool, string) {
+	keys := l.parseBlock.Keys
+	// A named route block is a single key with parens, prefixed with &.
+	if len(keys) == 1 && strings.HasPrefix(keys[0], "&(") && strings.HasSuffix(keys[0], ")") {
+		return true, strings.TrimSuffix(keys[0][2:], ")")
+	}
+	return false, ""
+}
+
+func (l *lexer) isParseSnippet() (bool, string) {
+	keys := l.parseBlock.Keys
+	// A snippet block is a single key with parens. Nothing else qualifies.
+	if len(keys) == 1 && strings.HasPrefix(keys[0], "(") && strings.HasSuffix(keys[0], ")") {
+		return true, strings.TrimSuffix(keys[0][1:], ")")
+	}
+	return false, ""
+}
+
+func (l *lexer) collectBlockTokens(retainCurlies bool) ([]Token, error) {
+	// block must have curlies.
+	err := l.parseExpectOpenBrace()
+	if err != nil {
+		return nil, err
+	}
+	nesting := 1 // count our own nesting
+	tokens := []Token{}
+	if retainCurlies {
+		tokens = append(tokens, l.parseCurrentToken())
+	}
+	for l.parseAdvance() {
+		if l.parseValue() == "}" {
+			nesting--
+			if nesting == 0 {
+				if retainCurlies {
+					tokens = append(tokens, l.parseCurrentToken())
+				}
+				break
+			}
+		}
+		if l.parseValue() == "{" {
+			nesting++
+		}
+		tokens = append(tokens, l.parseTokens[l.parseCursor])
+	}
+	// make sure we're matched up
+	if nesting != 0 {
+		return nil, l.parseSyntaxErr("}")
+	}
+	return tokens, nil
+}
