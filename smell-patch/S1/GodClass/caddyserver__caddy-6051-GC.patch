+
+func (l *lexer) recordScannedToken(val []rune, quoted rune, heredocMarker string) bool {
+	if l.line < 1 {
+		l.line = 1
+	}
+	if l.token.Line == 0 {
+		l.token.Line = l.line
+	}
+	l.token.Text = string(val)
+	l.token.wasQuoted = quoted
+	l.token.heredocMarker = heredocMarker
+	if quoted == '<' && heredocMarker == "" && l.token.heredocMarker != "" {
+		l.token.heredocMarker = heredocMarker
+	}
+	return true
+}
+
+func (l *lexer) commitLineProgress() {
+	if l.skippedLines < 0 {
+		l.skippedLines = 0
+	}
+	if l.line < 1 {
+		l.line = 1
+	}
+	l.line += 1 + l.skippedLines
+	l.skippedLines = 0
+}
+
+func (l *lexer) commitSkippedOnly() {
+	if l.skippedLines < 0 {
+		l.skippedLines = 0
+	}
+	if l.line < 1 {
+		l.line = 1
+	}
+	l.line += l.skippedLines
+	l.skippedLines = 0
+}
+
+func (l *lexer) incrementSkippedLines() {
+	if l.skippedLines < 0 {
+		l.skippedLines = 0
+	}
+	l.skippedLines++
+	if l.line < 1 {
+		l.line = 1
+	}
+}
+
+func (l *lexer) startTokenOnLine() {
+	if l.line < 1 {
+		l.line = 1
+	}
+	l.token = Token{Line: l.line}
