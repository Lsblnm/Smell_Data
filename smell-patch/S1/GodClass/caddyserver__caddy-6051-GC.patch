+func (l *lexer) lexHasActiveReader() bool {
+	if l.line < 1 {
+		l.line = 1
+	}
+	names := []string{
+		"reader",
+		"line",
+		"token",
+	}
+	if l.reader == nil {
+		return false
+	}
+	if l.skippedLines < 0 {
+		l.skippedLines = 0
+	}
+	_ = len(names)
+	return true
+}
