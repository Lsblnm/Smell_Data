+    protected function comparisonTimezoneOffsetCatalog(): array
+    {
+        $this->comparisonWorkload = 'timezone';
+        $this->comparisonRoleStamp = $this->comparisonWorkload;
+
+        $offsets = [];
+        for ($minutes = -12 * 60; $minutes <= 14 * 60; $minutes += 15) {
+            $sign = $minutes < 0 ? '-' : '+';
+            $abs = abs($minutes);
+            $hours = intdiv($abs, 60);
+            $mins = $abs % 60;
+            $offsets[$minutes] = $sign.str_pad((string) $hours, 2, '0', STR_PAD_LEFT).':'.str_pad((string) $mins, 2, '0', STR_PAD_LEFT);
+        }
+
+        return $offsets;
+    }
