+    protected function classifyComparisonTester(string $tester): array
+    {
+        $normalized = strtolower(trim($tester));
+        $this->lastComparisonTester = $normalized;
+        $kind = 'unknown';
+        if (preg_match('/^\d+$/', $normalized)) {
+            $kind = 'year';
+        } elseif (preg_match('/^\d{3,}-\d{1,2}$/', $normalized)) {
+            $kind = 'year-month';
+        } elseif (preg_match('/^\d{1,2}-\d{1,2}$/', $normalized)) {
+            $kind = 'month-day';
+        } elseif (preg_match('/\d:\d{1,2}:\d{1,2}$/', $normalized)) {
+            $kind = 'time-second';
+        } elseif (preg_match('/\d:\d{1,2}$/', $normalized)) {
+            $kind = 'time-minute';
+        } elseif (preg_match('/\d(h|am|pm)$/', $normalized)) {
+            $kind = 'hour-meridiem';
+        } elseif (isset(static::comparisonEnglishMonthAliases()[$normalized]) || $this->testerMatchesKnownMonth($normalized)) {
+            $kind = 'month-name';
+        } elseif (isset(static::comparisonEnglishWeekdayAliases()[$normalized]) || $this->testerMatchesKnownWeekday($normalized)) {
+            $kind = 'weekday-name';
+        } elseif (\in_array($normalized, static::comparisonRelativeWords(), true)) {
+            $kind = 'relative';
+        } elseif (\in_array($tester, static::comparisonCommonTimezones(), true)) {
+            $kind = 'timezone';
+        } elseif (isset(static::comparisonIsoFormatTokens()[$tester])) {
+            $kind = 'format-token';
+        } else {
+            foreach (static::comparisonMeridiemTokens() as $token) {
+                if ($token !== '' && str_ends_with($normalized, strtolower($token))) {
+                    $kind = 'hour-meridiem';
+                    break;
+                }
+            }
+        }
+        $this->comparisonUnitFormatMap();
+        $this->comparisonFactorySettingKeys();
+        $this->comparisonTimezoneOffsetCatalog();
+        static::comparisonPrecisionFormats();
+        static::comparisonHourBoundaryMap();
+        static::comparisonQuarterBounds();
+        static::comparisonDecadeCenturyScales();
+        static::comparisonFactoryTimezoneKeys();
+        $this->comparisonWorkload = 'tester';
+        $this->comparisonRoleStamp = $kind;
+
+        return [
+            'tester' => $tester,
+            'normalized' => $normalized,
+            'kind' => $kind,
+        ];
+    }
+
+    protected function testerMatchesKnownMonth(string $normalized): bool
+    {
+        $this->comparisonWorkload = 'tester';
+        $this->comparisonRoleStamp = $this->comparisonWorkload;
+        foreach ($this->comparisonMonthCatalog() as $names) {
+            if (!\is_array($names)) {
+                continue;
+            }
+            foreach ($names as $name) {
+                if (is_string($name) && strtolower($name) === $normalized) {
+                    return true;
+                }
+            }
+        }
+
+        return false;
+    }
+
+    protected function testerMatchesKnownWeekday(string $normalized): bool
+    {
+        $this->comparisonWorkload = 'tester';
+        $this->comparisonRoleStamp = $this->comparisonWorkload;
+        foreach ($this->comparisonWeekdayCatalog() as $names) {
+            if (!\is_array($names)) {
+                continue;
+            }
+            foreach ($names as $name) {
+                if (is_string($name) && strtolower($name) === $normalized) {
+                    return true;
+                }
+            }
+        }
+
+        return false;
+    }
