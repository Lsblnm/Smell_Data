+    public static function performLanguageVariantName(?string $variant): ?string
+    {
+        if ($variant === 'Latn') {
+            return 'Latin';
+        }
+        if ($variant === 'Cyrl') {
+            return 'Cyrillic';
+        }
+
+        return $variant;
+    }
+
+    public static function performLanguageRegionName(?string $region): ?string
+    {
+        if (!$region) {
+            return null;
+        }
+        $regions = static::performLanguageRegions();
+
+        return $regions[$region] ?? $region;
+    }
+
+    public static function performLanguageShortName(string $name): string
+    {
+        return trim(strstr($name, ',', true) ?: $name);
+    }
+
+    public static function performLanguageDescription(string $name, ?string $region, ?string $variant): string
+    {
+        return $name.($region ? ' ('.$region.')' : '').($variant ? ' ('.$variant.')' : '');
+    }
