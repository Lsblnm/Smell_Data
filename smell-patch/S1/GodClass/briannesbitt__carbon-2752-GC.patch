+    protected function comparisonFactorySettingKeys(): array
+    {
+        $this->comparisonWorkload = 'creation';
+        $this->comparisonRoleStamp = $this->comparisonWorkload;
+
+        return [
+            'timezone',
+            'innerTimezone',
