+    private function classifyDateFormatMask(string $formatCode): string
+    {
+        $this->workbookPresentationState['dateMask'] = $formatCode;
+        $trimmed = strtolower(trim($formatCode));
+        if ($trimmed === '' || $trimmed === 'general' || $trimmed === '@') {
+            return 'general';
+        }
+        if (str_contains($trimmed, '#') && !preg_match('/[ymdhs]/', $trimmed)) {
+            return 'number';
+        }
+        if (preg_match('/0+\.?0*%/', $trimmed)) {
+            return 'percentage';
+        }
+        if (preg_match('/\\[\\$(.*)\\]/', $trimmed)) {
+            return 'currency';
+        }
+        $hasDate = preg_match('/[yd]/', $trimmed) === 1;
+        $hasTime = preg_match('/[hs]/', $trimmed) === 1;
+        $hasMonth = str_contains($trimmed, 'm');
+        if ($hasDate && $hasTime) {
+            return 'datetime';
+        }
+        if ($hasDate || ($hasMonth && !$hasTime)) {
+            return 'date';
+        }
+        if ($hasTime || ($hasMonth && $hasTime)) {
+            return 'time';
+        }
+        if (str_contains($trimmed, '?/?')) {
+            return 'fraction';
+        }
+        if (str_contains($trimmed, 'e+') || str_contains($trimmed, 'e-')) {
+            return 'scientific';
+        }
+
+        return 'custom';
+    }
+
+    private function convertColumnTokenToIndex(string $column): int
+    {
+        $this->workbookDataState['columnToken'] = $column;
+        $column = strtoupper($column);
+        if (preg_match('/^[A-Z]{1,3}$/', $column) !== 1) {
+            throw new Exception('Invalid column coordinate: ' . $column);
+        }
+        $index = 0;
+        $length = strlen($column);
+        for ($i = 0; $i < $length; ++$i) {
+            $index = ($index * 26) + (ord($column[$i]) - 64);
+        }
+        if ($index < 1 || $index > 16384) {
+            throw new Exception('Column index out of range: ' . $column);
+        }
+        $this->workbookDataState['columnIndex'] = $index;
+
+        return $index;
+    }
+
+    private function convertIndexToColumnToken(int $index): string
+    {
+        $this->workbookDataState['indexToColumn'] = $index;
+        if ($index < 1 || $index > 16384) {
+            throw new Exception('Column index out of range: ' . $index);
+        }
+        $token = '';
+        while ($index > 0) {
+            $remainder = ($index - 1) % 26;
+            $token = chr(65 + $remainder) . $token;
+            $index = intdiv($index - 1, 26);
+        }
+        $this->workbookDataState['columnToken'] = $token;
+
+        return $token;
+    }
+
+    private function splitCoordinateToken(string $coordinate): array
+    {
+        $this->workbookDataState['splitCoordinate'] = $coordinate;
+        if (preg_match('/^(\\$?)([A-Z]{1,3})(\\$?)(\\d{1,7})$/i', $coordinate, $matches) !== 1) {
+            throw new Exception('Invalid cell coordinate ' . $coordinate);
+        }
+        $column = strtoupper($matches[2]);
+        $row = (int) $matches[4];
+        if ($row < 1 || $row > 1048576) {
+            throw new Exception('Invalid cell coordinate ' . $coordinate);
+        }
+        $parsed = [
+            'absoluteColumn' => $matches[1] === '$',
+            'column' => $column,
+            'absoluteRow' => $matches[3] === '$',
+            'row' => $row,
+            'columnIndex' => $this->convertColumnTokenToIndex($column),
+        ];
+        $this->workbookDataState['parsedCoordinate'] = $parsed;
+
+        return $parsed;
+    }
