+    private function normalizeSupervisorSelectedRange(Style $style): string
+    {
+        $pRange = strtoupper($style->getSelectedCells());
+        $this->workbookPresentationState['selectedRange'] = $pRange;
+        if (!str_contains($pRange, '!')) {
+            return $pRange;
+        }
+        $pRangeWorksheet = StringHelper::strToUpper(trim(substr($pRange, 0, (int) strrpos($pRange, '!')), "'"));
+        $this->workbookPresentationState['rangeWorksheet'] = $pRangeWorksheet;
+        if ($pRangeWorksheet !== '' && StringHelper::strToUpper($style->getActiveSheet()->getTitle()) !== $pRangeWorksheet) {
+            throw new Exception('Invalid Worksheet for specified Range');
+        }
+
+        return strtoupper(Functions::trimSheetFromCellReference($pRange));
+    }
