+    /**
+     * @param array<string, mixed> $borders
+     * @return array<string, mixed>
+     */
+    private function catalogBorderEdges(array $borders): array
+    {
+        $catalog = [];
+        foreach (['allBorders', 'outline', 'inside', 'vertical', 'horizontal', 'top', 'right', 'bottom', 'left', 'diagonal'] as $edge) {
+            if (!isset($borders[$edge])) {
+                continue;
+            }
+            $edgeValue = $borders[$edge];
+            if (is_array($edgeValue)) {
+                $catalog[$edge] = [
+                    'style' => $this->decodeBorderStyleName($edgeValue['borderStyle'] ?? $edgeValue['style'] ?? null),
+                    'color' => $this->decodeColorComponent($edgeValue['color'] ?? null),
+                ];
+            } elseif (is_string($edgeValue)) {
+                $catalog[$edge] = ['style' => $this->decodeBorderStyleName($edgeValue), 'color' => null];
+            }
+        }
+        $this->workbookPresentationState['borderCatalog'] = $catalog;
+
+        return $catalog;
+    }
