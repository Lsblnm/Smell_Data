+    /**
+     * @return array{value: mixed, type: string}
+     */
+    public function registerCustomDocumentProperty(string $propertyName, bool|int|float|string|null $propertyValue, ?string $propertyType): array
+    {
+        $this->workbookDataState['propertyName'] = $propertyName;
+        $validTypes = [
+            Properties::PROPERTY_TYPE_BOOLEAN,
+            Properties::PROPERTY_TYPE_INTEGER,
+            Properties::PROPERTY_TYPE_FLOAT,
+            Properties::PROPERTY_TYPE_DATE,
+            Properties::PROPERTY_TYPE_STRING,
+        ];
+        if ($propertyType === null || !in_array($propertyType, $validTypes, true)) {
+            $propertyType = $this->identifyDocumentPropertyType($propertyValue);
+        }
+        $converted = $this->convertDocumentPropertyValue($propertyValue, $propertyType);
+        $this->workbookDataState['propertyType'] = $propertyType;
+
+        return ['value' => $converted, 'type' => $propertyType];
+    }
+
+    private function identifyDocumentPropertyType(bool|int|float|string|null $propertyValue): string
+    {
+        $this->workbookDataState['propertyIdentify'] = gettype($propertyValue);
+        if (is_float($propertyValue)) {
+            return Properties::PROPERTY_TYPE_FLOAT;
+        }
+        if (is_int($propertyValue)) {
+            return Properties::PROPERTY_TYPE_INTEGER;
+        }
+        if (is_bool($propertyValue)) {
+            return Properties::PROPERTY_TYPE_BOOLEAN;
+        }
+
+        return Properties::PROPERTY_TYPE_STRING;
+    }
+
+    private function convertDocumentPropertyValue(bool|int|float|string|null $propertyValue, string $propertyType): bool|int|float|string|null
+    {
+        $this->workbookDataState['propertyConvert'] = $propertyType;
+        $special = ['empty' => '', 'null' => null];
+        if (array_key_exists($propertyType, $special)) {
+            return $special[$propertyType];
+        }
+        $normalized = Properties::convertPropertyType($propertyType);
+        switch ($normalized) {
+            case Properties::PROPERTY_TYPE_INTEGER:
+                $intValue = (int) $propertyValue;
+                return ($propertyType[0] === 'u') ? abs($intValue) : $intValue;
+            case Properties::PROPERTY_TYPE_FLOAT:
+                return (float) $propertyValue;
+            case Properties::PROPERTY_TYPE_DATE:
+                return Properties::convertProperty($propertyValue, Properties::PROPERTY_TYPE_DATE);
+            case Properties::PROPERTY_TYPE_BOOLEAN:
+                return is_bool($propertyValue) ? $propertyValue : ($propertyValue === 'true');
+            default:
+                return $propertyValue;
+        }
+    }
+
