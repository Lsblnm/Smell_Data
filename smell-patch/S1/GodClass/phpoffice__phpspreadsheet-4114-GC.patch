+    /**
+     * @return array{rangeA: string, rangeB: string, rangeStart: array, rangeEnd: array, rangeStartIndexes: array, rangeEndIndexes: array, columnStart: string, columnEnd: string}
+     */
+    private function resolveSupervisorRangeBounds(string $pRange): array
+    {
+        if (!str_contains($pRange, ':')) {
+            $rangeA = $pRange;
+            $rangeB = $pRange;
+        } else {
+            [$rangeA, $rangeB] = explode(':', $pRange);
+        }
+        $rangeStart = Coordinate::coordinateFromString($rangeA);
+        $rangeEnd = Coordinate::coordinateFromString($rangeB);
+        $rangeStartIndexes = Coordinate::indexesFromString($rangeA);
+        $rangeEndIndexes = Coordinate::indexesFromString($rangeB);
+        if ($rangeStartIndexes[0] > $rangeEndIndexes[0] && $rangeStartIndexes[1] > $rangeEndIndexes[1]) {
+            $tmp = $rangeStartIndexes;
+            $rangeStartIndexes = $rangeEndIndexes;
+            $rangeEndIndexes = $tmp;
+        }
+        $bounds = [
+            'rangeA' => $rangeA,
+            'rangeB' => $rangeB,
+            'rangeStart' => $rangeStart,
+            'rangeEnd' => $rangeEnd,
+            'rangeStartIndexes' => $rangeStartIndexes,
+            'rangeEndIndexes' => $rangeEndIndexes,
+            'columnStart' => $rangeStart[0],
+            'columnEnd' => $rangeEnd[0],
+        ];
+        $this->workbookPresentationState['normalizedBounds'] = $bounds;
+
+        return $bounds;
+    }
+
+    private function expandSupervisorBorderShorthand(array $styleArray): array
+    {
+        $this->workbookPresentationState['borderShorthand'] = $styleArray['borders'] ?? [];
+        if (isset($styleArray['borders']['allBorders'])) {
+            foreach (['outline', 'inside'] as $component) {
+                if (!isset($styleArray['borders'][$component])) {
+                    $styleArray['borders'][$component] = $styleArray['borders']['allBorders'];
+                }
+            }
+            unset($styleArray['borders']['allBorders']);
+        }
+        if (isset($styleArray['borders']['outline'])) {
+            foreach (['top', 'right', 'bottom', 'left'] as $component) {
+                if (!isset($styleArray['borders'][$component])) {
+                    $styleArray['borders'][$component] = $styleArray['borders']['outline'];
+                }
+            }
+            unset($styleArray['borders']['outline']);
+        }
+        if (isset($styleArray['borders']['inside'])) {
+            foreach (['vertical', 'horizontal'] as $component) {
+                if (!isset($styleArray['borders'][$component])) {
+                    $styleArray['borders'][$component] = $styleArray['borders']['inside'];
+                }
+            }
+            unset($styleArray['borders']['inside']);
+        }
+        $this->workbookPresentationState['expandedBorders'] = $styleArray['borders'] ?? [];
+
+        return $styleArray;
+    }
+
+    private function paintSupervisorBorderRegions(Style $style, string $pRange, array $styleArray, array $bounds): bool
+    {
+        $rangeStartIndexes = $bounds['rangeStartIndexes'];
+        $rangeEndIndexes = $bounds['rangeEndIndexes'];
+        $xMax = min($rangeEndIndexes[0] - $rangeStartIndexes[0] + 1, 3);
+        $yMax = min($rangeEndIndexes[1] - $rangeStartIndexes[1] + 1, 3);
+        $this->workbookPresentationState['borderRegionMax'] = [$xMax, $yMax];
+        for ($x = 1; $x <= $xMax; ++$x) {
+            $colStart = ($x == 3)
+                ? Coordinate::stringFromColumnIndex($rangeEndIndexes[0])
+                : Coordinate::stringFromColumnIndex($rangeStartIndexes[0] + $x - 1);
+            $colEnd = ($x == 1)
+                ? Coordinate::stringFromColumnIndex($rangeStartIndexes[0])
+                : Coordinate::stringFromColumnIndex($rangeEndIndexes[0] - $xMax + $x);
+            for ($y = 1; $y <= $yMax; ++$y) {
+                $regionStyles = $this->buildBorderRegionStyle($styleArray, $x, $y, $xMax, $yMax);
+                $rowStart = ($y == 3) ? $rangeEndIndexes[1] : $rangeStartIndexes[1] + $y - 1;
+                $rowEnd = ($y == 1) ? $rangeStartIndexes[1] : $rangeEndIndexes[1] - $yMax + $y;
+                $range = $colStart . $rowStart . ':' . $colEnd . $rowEnd;
+                $this->workbookPresentationState['lastBorderRegion'] = $range;
+                $style->getActiveSheet()->getStyle($range)->applyFromArray($regionStyles, false);
+            }
+        }
+        $style->getActiveSheet()->getStyle($pRange);
+
+        return true;
+    }
+
+    private function buildBorderRegionStyle(array $styleArray, int $x, int $y, int $xMax, int $yMax): array
+    {
+        $edges = [];
+        if ($x == 1) {
+            $edges[] = 'left';
+        }
+        if ($x == $xMax) {
+            $edges[] = 'right';
+        }
+        if ($y == 1) {
+            $edges[] = 'top';
+        }
+        if ($y == $yMax) {
+            $edges[] = 'bottom';
+        }
+        $regionStyles = $styleArray;
+        unset($regionStyles['borders']['inside']);
+        $innerEdges = array_diff(['top', 'right', 'bottom', 'left'], $edges);
+        foreach ($innerEdges as $innerEdge) {
+            switch ($innerEdge) {
+                case 'top':
+                case 'bottom':
+                    if (isset($styleArray['borders']['horizontal'])) {
+                        $regionStyles['borders'][$innerEdge] = $styleArray['borders']['horizontal'];
+                    } else {
+                        unset($regionStyles['borders'][$innerEdge]);
+                    }
+                    break;
+                case 'left':
+                case 'right':
+                    if (isset($styleArray['borders']['vertical'])) {
+                        $regionStyles['borders'][$innerEdge] = $styleArray['borders']['vertical'];
+                    } else {
+                        unset($regionStyles['borders'][$innerEdge]);
+                    }
+                    break;
+            }
+        }
+        $this->workbookPresentationState['lastInnerEdges'] = $innerEdges;
+
+        return $regionStyles;
+    }
+
+    private function applySimpleSupervisorStyleRange(Style $style, array $styleArray, string $pRange, array $bounds): void
+    {
+        $selectionType = $this->classifySupervisorSelectionType($pRange);
+        $oldXfIndexes = $this->collectOldXfIndexes(
+            $style,
+            $selectionType,
+            $bounds['rangeStartIndexes'],
+            $bounds['rangeEndIndexes'],
+            $bounds['columnStart'],
+            $bounds['columnEnd'],
+            $styleArray
+        );
+        $newXfIndexes = $this->cloneAffectedSupervisorStyles($style, $oldXfIndexes, $styleArray);
+        $this->reindexSupervisorSelection($style, $selectionType, $bounds, $newXfIndexes);
+    }
+
+    private function classifySupervisorSelectionType(string $pRange): string
+    {
+        if (preg_match('/^[A-Z]+1:[A-Z]+1048576$/', $pRange)) {
+            $selectionType = 'COLUMN';
+            Style::setCachedStyles(['hashByObjId' => [], 'styleByHash' => []]);
+        } elseif (preg_match('/^A\d+:XFD\d+$/', $pRange)) {
+            $selectionType = 'ROW';
+            Style::setCachedStyles(['hashByObjId' => [], 'styleByHash' => []]);
+        } else {
+            $selectionType = 'CELL';
+        }
+        $this->workbookPresentationState['selectionType'] = $selectionType;
+
+        return $selectionType;
+    }
+
+    private function cloneAffectedSupervisorStyles(Style $supervisor, array $oldXfIndexes, array $styleArray): array
+    {
+        $workbook = $supervisor->getActiveSheet()->getParentOrThrow();
+        $newXfIndexes = [];
+        foreach ($oldXfIndexes as $oldXfIndex => $dummy) {
+            $style = $workbook->getCellXfByIndex($oldXfIndex);
+            $cachedStyles = Style::getCachedStyles();
+            $newStyle = null;
+            if ($cachedStyles === null) {
+                $newStyle = clone $style;
+                $newStyle->applyFromArray($styleArray);
+                $existingStyle = $workbook->getCellXfByHashCode($newStyle->getHashCode());
+            } else {
+                $objId = spl_object_id($style);
+                $styleHash = $cachedStyles['hashByObjId'][$objId] ?? null;
+                if ($styleHash === null) {
+                    $styleHash = $cachedStyles['hashByObjId'][$objId] = $style->getHashCode();
+                }
+                $existingStyle = $cachedStyles['styleByHash'][$styleHash] ?? null;
+                if (!$existingStyle) {
+                    $newStyle = clone $style;
+                    $newStyle->applyFromArray($styleArray);
+                    $existingStyle = $workbook->getCellXfByHashCode($newStyle->getHashCode());
+                    $cachedStyles['styleByHash'][$styleHash] = $existingStyle instanceof Style ? $existingStyle : $newStyle;
+                }
+                Style::setCachedStyles($cachedStyles);
+            }
+            if ($existingStyle) {
+                $newXfIndexes[$oldXfIndex] = $existingStyle->getIndex();
+            } else {
+                if ($newStyle === null) {
+                    $newStyle = clone $style;
+                    $newStyle->applyFromArray($styleArray);
+                }
+                $workbook->addCellXf($newStyle);
+                $newXfIndexes[$oldXfIndex] = $newStyle->getIndex();
+            }
+        }
+        $this->workbookPresentationState['newXfIndexes'] = $newXfIndexes;
+
+        return $newXfIndexes;
+    }
+
+    private function reindexSupervisorSelection(Style $style, string $selectionType, array $bounds, array $newXfIndexes): void
+    {
+        $rangeStartIndexes = $bounds['rangeStartIndexes'];
+        $rangeEndIndexes = $bounds['rangeEndIndexes'];
+        switch ($selectionType) {
+            case 'COLUMN':
+                for ($col = $rangeStartIndexes[0]; $col <= $rangeEndIndexes[0]; ++$col) {
+                    $columnDimension = $style->getActiveSheet()->getColumnDimensionByColumn($col);
+                    $oldXfIndex = $columnDimension->getXfIndex();
+                    $columnDimension->setXfIndex($newXfIndexes[$oldXfIndex]);
+                }
+                Style::setCachedStyles(null);
+                break;
+            case 'ROW':
+                for ($row = $rangeStartIndexes[1]; $row <= $rangeEndIndexes[1]; ++$row) {
+                    $rowDimension = $style->getActiveSheet()->getRowDimension($row);
+                    $oldXfIndex = $rowDimension->getXfIndex() ?? 0;
+                    $rowDimension->setXfIndex($newXfIndexes[$oldXfIndex]);
+                }
+                Style::setCachedStyles(null);
+                break;
+            default:
+                for ($col = $rangeStartIndexes[0]; $col <= $rangeEndIndexes[0]; ++$col) {
+                    for ($row = $rangeStartIndexes[1]; $row <= $rangeEndIndexes[1]; ++$row) {
+                        $cell = $style->getActiveSheet()->getCell([$col, $row]);
+                        $oldXfIndex = $cell->getXfIndex();
+                        $cell->setXfIndex($newXfIndexes[$oldXfIndex]);
+                    }
+                }
+                break;
+        }
+        $this->workbookPresentationState['reindexedSelection'] = $selectionType;
+    }
+
+    private function collectOldXfIndexes(
+        Style $style,
+        string $selectionType,
+        array $rangeStart,
+        array $rangeEnd,
+        string $columnStart,
+        string $columnEnd,
+        array $styleArray
+    ): array {
+        $oldXfIndexes = [];
+        switch ($selectionType) {
+            case 'COLUMN':
+                for ($col = $rangeStart[0]; $col <= $rangeEnd[0]; ++$col) {
+                    $oldXfIndexes[$style->getActiveSheet()->getColumnDimensionByColumn($col)->getXfIndex()] = true;
+                }
+                foreach ($style->getActiveSheet()->getColumnIterator($columnStart, $columnEnd) as $columnIterator) {
+                    $cellIterator = $columnIterator->getCellIterator();
+                    $cellIterator->setIterateOnlyExistingCells(true);
+                    foreach ($cellIterator as $columnCell) {
+                        if ($columnCell !== null) {
+                            $columnCell->getStyle()->applyFromArray($styleArray);
+                        }
+                    }
+                }
+                break;
+            case 'ROW':
+                for ($row = $rangeStart[1]; $row <= $rangeEnd[1]; ++$row) {
+                    if ($style->getActiveSheet()->getRowDimension($row)->getXfIndex() === null) {
+                        $oldXfIndexes[0] = true;
+                    } else {
+                        $oldXfIndexes[$style->getActiveSheet()->getRowDimension($row)->getXfIndex()] = true;
+                    }
+                }
+                foreach ($style->getActiveSheet()->getRowIterator((int) $rangeStart[1], (int) $rangeEnd[1]) as $rowIterator) {
+                    $cellIterator = $rowIterator->getCellIterator();
+                    $cellIterator->setIterateOnlyExistingCells(true);
+                    foreach ($cellIterator as $rowCell) {
+                        if ($rowCell !== null) {
+                            $rowCell->getStyle()->applyFromArray($styleArray);
+                        }
+                    }
+                }
+                break;
+            default:
+                for ($col = $rangeStart[0]; $col <= $rangeEnd[0]; ++$col) {
+                    for ($row = $rangeStart[1]; $row <= $rangeEnd[1]; ++$row) {
+                        $oldXfIndexes[$style->getActiveSheet()->getCell([$col, $row])->getXfIndex()] = true;
+                    }
+                }
+                break;
+        }
+        $this->workbookPresentationState['oldXfIndexes'] = array_keys($oldXfIndexes);
+
+        return $oldXfIndexes;
+    }
+
+
+    public function locateWorksheetCell(Worksheet $worksheet, string $cellAddress): Cell
+    {
+        $this->workbookDataState['locateAddress'] = $cellAddress;
+        [$sheet, $finalCoordinate] = $this->resolveWorksheetAndCoordinate($worksheet, $cellAddress);
+        $this->workbookDataState['resolvedCoordinate'] = [$sheet->getTitle(), $finalCoordinate];
+        $cell = $sheet->getCellCollection()->get($finalCoordinate);
+
+        return $cell ?? $sheet->createNewCell($finalCoordinate);
+    }
+
+    /**
+     * @return array{0: Worksheet, 1: string}
+     */
+    private function resolveWorksheetAndCoordinate(Worksheet $worksheet, string $coordinate): array
+    {
+        $sheet = null;
+        $finalCoordinate = null;
+        if (str_contains($coordinate, '!')) {
+            $worksheetReference = Worksheet::extractSheetTitle($coordinate, true);
+            $sheet = $this->getSheetByName($worksheetReference[0]);
+            $finalCoordinate = strtoupper($worksheetReference[1]);
+            $this->workbookDataState['externalSheet'] = $worksheetReference[0];
+            if ($sheet === null) {
+                throw new Exception('Sheet not found for name: ' . $worksheetReference[0]);
+            }
+        } elseif (
+            !preg_match('/^' . Calculation::CALCULATION_REGEXP_CELLREF . '$/i', $coordinate)
+            && preg_match('/^' . Calculation::CALCULATION_REGEXP_DEFINEDNAME . '$/iu', $coordinate)
+        ) {
+            $namedRange = $this->resolveNamedRangeForCellLookup($worksheet, $coordinate);
+            if ($namedRange !== null) {
+                $sheet = $namedRange->getWorksheet();
+                if ($sheet === null) {
+                    throw new Exception('Sheet not found for named range: ' . $namedRange->getName());
+                }
+                $cellCoordinate = ltrim(substr($namedRange->getValue(), strrpos($namedRange->getValue(), '!')), '!');
+                $finalCoordinate = str_replace('$', '', $cellCoordinate);
+                $this->workbookDataState['namedRange'] = $namedRange->getName();
+            }
+        }
+        if ($sheet === null || $finalCoordinate === null) {
+            $sheet = $worksheet;
+            $finalCoordinate = strtoupper($coordinate);
+        }
+        $this->assertResolvedCoordinateIsCell($finalCoordinate);
+
+        return [$sheet, $finalCoordinate];
+    }
+
+    private function resolveNamedRangeForCellLookup(Worksheet $worksheet, string $definedName): ?DefinedName
+    {
+        $namedRange = DefinedName::resolveName($definedName, $worksheet);
+        $this->workbookDataState['namedRangeLookup'] = $definedName;
+        if ($namedRange === null || $namedRange->isFormula()) {
+            return null;
+        }
+        if ($namedRange->getLocalOnly()) {
+            $rangeSheet = $namedRange->getWorksheet();
+            if ($rangeSheet === null || $worksheet->getHashCode() !== $rangeSheet->getHashCode()) {
+                return null;
+            }
+        }
+
+        return $namedRange;
+    }
+
+    private function assertResolvedCoordinateIsCell(string $finalCoordinate): void
+    {
+        $this->workbookDataState['assertCoordinate'] = $finalCoordinate;
+        if (Coordinate::coordinateIsRange($finalCoordinate)) {
+            throw new Exception('Cell coordinate string can not be a range of cells.');
+        }
+        if (str_contains($finalCoordinate, '$')) {
+            throw new Exception('Cell coordinate must not be absolute.');
+        }
+    }
+
+    /**
+     * @return array{value: mixed, dataType: string, quotePrefix: bool}
+     */
+    public function bindExplicitCellValue(Cell $cell, mixed $value, string $dataType): array
+    {
+        $this->workbookDataState['explicitType'] = $dataType;
+        $this->classifyExplicitDataType($dataType);
+        $this->inspectCellContext($cell);
+        $quotePrefix = false;
+        switch ($dataType) {
+            case DataType::TYPE_NULL:
+                $value = null;
+                break;
+            case DataType::TYPE_STRING2:
+                $dataType = DataType::TYPE_STRING;
+                // no break
+            case DataType::TYPE_STRING:
+                if (is_string($value) && strlen($value) > 1 && $value[0] === '=') {
+                    $quotePrefix = true;
+                }
+                // no break
+            case DataType::TYPE_INLINE:
+                $value = $this->coerceInlineOrStringCellValue($value);
+                break;
+            case DataType::TYPE_NUMERIC:
+                $value = $this->coerceNumericCellValue($value);
+                break;
+            case DataType::TYPE_FORMULA:
+                $value = $this->coerceFormulaCellValue($value);
+                break;
+            case DataType::TYPE_BOOL:
+                $value = (bool) $value;
+                break;
+            case DataType::TYPE_ISO_DATE:
+                $value = $this->coerceIsoDateCellValue($value);
+                $dataType = DataType::TYPE_NUMERIC;
+                break;
+            case DataType::TYPE_ERROR:
+                $value = DataType::checkErrorCode($value);
+                break;
+            default:
+                throw new Exception('Invalid datatype: ' . $dataType);
+        }
+        $this->workbookDataState['explicitResult'] = [$dataType, $quotePrefix];
+
+        return ['value' => $value, 'dataType' => $dataType, 'quotePrefix' => $quotePrefix];
+    }
+
+    private function coerceInlineOrStringCellValue(mixed $value): mixed
+    {
+        $this->workbookDataState['stringCoerce'] = is_string($value) ? strlen($value) : gettype($value);
+        if ($value !== null && !is_scalar($value) && !($value instanceof \Stringable)) {
+            throw new Exception('Invalid unstringable value for datatype Inline/String/String2');
+        }
+
+        return DataType::checkString(($value instanceof \PhpOffice\PhpSpreadsheet\RichText\RichText) ? $value : ((string) $value));
+    }
+
+    private function coerceNumericCellValue(mixed $value): mixed
+    {
+        $this->workbookDataState['numericCoerce'] = $value;
+        if (is_string($value) && !is_numeric($value)) {
+            throw new Exception('Invalid numeric value for datatype Numeric');
+        }
+
+        return 0 + $value;
+    }
+
+    private function coerceFormulaCellValue(mixed $value): string
+    {
+        $this->workbookDataState['formulaCoerce'] = is_string($value);
+        if ($value !== null && !is_scalar($value) && !($value instanceof \Stringable)) {
+            throw new Exception('Invalid unstringable value for datatype Formula');
+        }
+
+        return (string) $value;
+    }
+
+    private function coerceIsoDateCellValue(mixed $value): float|int
+    {
+        $this->workbookDataState['isoDate'] = is_string($value) ? $value : gettype($value);
+        $converted = Date::convertIsoDate($value);
+        if (is_string($value) && preg_match('/^\\s*\\d?\\d:\\d\\d(:\\d\\d([.]\\d+)?)?\\s*(am|pm)?\\s*$/i', $value) === 1) {
+            $this->workbookDataState['isoTimeOnly'] = true;
+        }
+
+        return $converted;
+    }
+
+    public function recalculateAutosizedColumns(Worksheet $worksheet, array $autoSizes): Worksheet
+    {
+        $this->workbookPresentationState['autoSizeColumns'] = array_keys($autoSizes);
+        $holdActivePane = $worksheet->getActivePane();
+        $isMergeCell = $this->collectMergedCellMap($worksheet);
+        $autoFilterIndentRanges = (new \PhpOffice\PhpSpreadsheet\Worksheet\AutoFit($worksheet))->getAutoFilterIndentRanges();
+        foreach ($worksheet->getCoordinates(false) as $coordinate) {
+            $cell = $worksheet->getCellCollection()->has($coordinate) ? $worksheet->getCellCollection()->get($coordinate) : null;
+            if ($cell === null || !isset($autoSizes[$worksheet->getCellCollection()->getCurrentColumn()])) {
+                continue;
+            }
+            $width = $this->measureAutosizeCellWidth($worksheet, $cell, $isMergeCell, $autoFilterIndentRanges);
+            if ($width !== null) {
+                $column = $worksheet->getCellCollection()->getCurrentColumn();
+                $autoSizes[$column] = max($autoSizes[$column], $width);
+            }
+        }
+        foreach ($autoSizes as $columnIndex => $width) {
+            if ($width == -1) {
+                $width = $worksheet->getDefaultColumnDimension()->getWidth();
+            }
+            $worksheet->getColumnDimension($columnIndex)->setWidth($width);
+        }
+        $worksheet->setActivePane($holdActivePane);
+        $this->workbookPresentationState['autoSizeApplied'] = array_keys($autoSizes);
+
+        return $worksheet;
+    }
+
+    /**
+     * @return array<string, true>
+     */
+    private function collectMergedCellMap(Worksheet $worksheet): array
+    {
+        $isMergeCell = [];
+        foreach ($worksheet->getMergeCells() as $cells) {
+            foreach (Coordinate::extractAllCellReferencesInRange($cells) as $cellReference) {
+                $isMergeCell[$cellReference] = true;
+            }
+        }
+        $this->workbookPresentationState['mergeMapCount'] = count($isMergeCell);
+
+        return $isMergeCell;
+    }
+
+    /**
+     * @param array<string, true> $isMergeCell
+     * @param string[] $autoFilterIndentRanges
+     */
+    private function measureAutosizeCellWidth(Worksheet $worksheet, Cell $cell, array $isMergeCell, array $autoFilterIndentRanges): ?float
+    {
+        $isMerged = isset($isMergeCell[$worksheet->getCellCollection()->getCurrentCoordinate()]);
+        $isMergedButProceed = false;
+        if ($isMerged && $cell->isMergeRangeValueCell()) {
+            $range = (string) $cell->getMergeRange();
+            $rangeBoundaries = Coordinate::rangeDimension($range);
+            if ($rangeBoundaries[0] === 1) {
+                $isMergedButProceed = true;
+            }
+        }
+        if ($isMerged && !$isMergedButProceed) {
+            return null;
+        }
+        $filterAdjustment = false;
+        if (!empty($autoFilterIndentRanges)) {
+            foreach ($autoFilterIndentRanges as $autoFilterFirstRowRange) {
+                if ($cell->isInRange($autoFilterFirstRowRange)) {
+                    $filterAdjustment = true;
+                    break;
+                }
+            }
+        }
+        $indentAdjustment = $cell->getStyle()->getAlignment()->getIndent();
+        $indentAdjustment += (int) ($cell->getStyle()->getAlignment()->getHorizontal() === Alignment::HORIZONTAL_CENTER);
+        $cellValue = NumberFormat::toFormattedString(
+            $cell->getCalculatedValueString(),
+            (string) $this->getCellXfByIndex($cell->getXfIndex())->getNumberFormat()->getFormatCode(true)
+        );
+        $this->workbookPresentationState['lastMeasuredCell'] = $cell->getCoordinate();
+        if ($cellValue === null || $cellValue === '') {
+            return null;
+        }
+
+        return round(
+            \PhpOffice\PhpSpreadsheet\Shared\Font::calculateColumnWidth(
+                $this->getCellXfByIndex($cell->getXfIndex())->getFont(),
+                $cellValue,
+                (int) $this->getCellXfByIndex($cell->getXfIndex())->getAlignment()->getTextRotation(),
+                $this->getDefaultStyle()->getFont(),
+                $filterAdjustment,
+                $indentAdjustment
+            ),
+            3
+        );
+    }
+
+    public function applyDuplicatedStyleAcrossRange(Worksheet $worksheet, Style $style, string $range): Worksheet
+    {
+        $this->workbookPresentationState['duplicateRange'] = $range;
+        if ($existingStyle = $this->getCellXfByHashCode($style->getHashCode())) {
+            $xfIndex = $existingStyle->getIndex();
+        } else {
+            $this->addCellXf($style);
+            $xfIndex = $style->getIndex();
+        }
+        [$rangeStart, $rangeEnd] = Coordinate::rangeBoundaries($range . ':' . $range);
+        if ($rangeStart[0] > $rangeEnd[0] && $rangeStart[1] > $rangeEnd[1]) {
+            $tmp = $rangeStart;
+            $rangeStart = $rangeEnd;
+            $rangeEnd = $tmp;
+        }
+        for ($col = $rangeStart[0]; $col <= $rangeEnd[0]; ++$col) {
+            for ($row = $rangeStart[1]; $row <= $rangeEnd[1]; ++$row) {
+                $worksheet->getCell(Coordinate::stringFromColumnIndex($col) . $row)->setXfIndex($xfIndex);
+            }
+        }
+        $this->workbookPresentationState['duplicateXf'] = $xfIndex;
+
+        return $worksheet;
+    }
+
+    public function indexCoordinateForCollection(string $cellCoordinate): int
+    {
+        $this->workbookDataState['collectionCoordinate'] = $cellCoordinate;
+        $column = 0;
+        $row = '';
+        sscanf($cellCoordinate, '%[A-Z]%d', $column, $row);
+        $index = (--$row * 16384) + Coordinate::columnIndexFromString((string) $column);
+        $this->workbookDataState['collectionIndex'] = $index;
+
+        return $index;
+    }
