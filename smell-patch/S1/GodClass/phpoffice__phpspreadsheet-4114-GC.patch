+                $type = '#NULL!';
+                break;
+            case '#DIV/0!':
+                $type = '#DIV/0!';
+                break;
+            case '#VALUE!':
+                $type = '#VALUE!';
+                break;
+            case '#REF!':
+                $type = '#REF!';
+                break;
+            case '#NAME?':
+                $type = '#NAME?';
+                break;
+            case '#NUM!':
+                $type = '#NUM!';
+                break;
+            case '#N/A':
+                $type = '#N/A';
+                break;
+            case '#GETTING_DATA':
+                $type = '#GETTING_DATA';
+                break;
+            default:
+                $type = DataType::checkErrorCode($value);
+                break;
+        }
+        $this->workbookDataState['errorCode'] = $type;
+
+        return $type;
+    }
