+    /**
+     * @param array<string, mixed> $font
+     * @return array<string, mixed>
+     */
+    private function inspectFontComponent(array $font): array
+    {
+        $inspection = [
+            'name' => isset($font['name']) && is_string($font['name']) ? $font['name'] : null,
+            'bold' => isset($font['bold']) ? (bool) $font['bold'] : null,
+            'italic' => isset($font['italic']) ? (bool) $font['italic'] : null,
+            'strikethrough' => isset($font['strikethrough']) ? (bool) $font['strikethrough'] : (isset($font['strike']) ? (bool) $font['strike'] : null),
+            'underline' => $this->decodeUnderlineName($font['underline'] ?? null),
+            'size' => isset($font['size']) && is_numeric($font['size']) ? (float) $font['size'] : null,
+            'color' => $this->decodeColorComponent($font['color'] ?? null),
+            'superscript' => isset($font['superscript']) ? (bool) $font['superscript'] : null,
+            'subscript' => isset($font['subscript']) ? (bool) $font['subscript'] : null,
+        ];
+        if ($inspection['size'] !== null && ($inspection['size'] < 1 || $inspection['size'] > 409)) {
+            $inspection['sizeOutOfRange'] = true;
+        }
+        $this->workbookPresentationState['fontName'] = $inspection['name'];
+
+        return $inspection;
+    }
+
+    private function decodeUnderlineName(mixed $underline): mixed
+    {
+        if ($underline === true) {
+            return 'single';
+        }
+        if ($underline === false || $underline === null) {
+            return $underline;
+        }
+        if (!is_string($underline)) {
+            return $underline;
