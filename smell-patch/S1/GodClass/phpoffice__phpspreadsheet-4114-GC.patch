+            case 'dot':
+                $decoded = 'dotted';
+                break;
+            case 'double':
+                $decoded = 'double';
+                break;
+            case 'hair':
+                $decoded = 'hair';
+                break;
+            case 'medium':
+                $decoded = 'medium';
+                break;
+            case 'mediumdashdot':
