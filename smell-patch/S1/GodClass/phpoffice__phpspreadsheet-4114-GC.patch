+    private function decodeColorComponent(mixed $color): ?array
+    {
+        if (!is_array($color)) {
+            if (is_string($color) && preg_match('/^[0-9A-Fa-f]{6}$/', $color) === 1) {
+                $this->workbookPresentationState['lastColor'] = $color;
+                return ['rgb' => strtoupper($color)];
+            }
+            return null;
+        }
+        $decoded = [];
+        if (isset($color['rgb']) && is_string($color['rgb'])) {
+            $decoded['rgb'] = strtoupper($color['rgb']);
+        } elseif (isset($color['argb']) && is_string($color['argb'])) {
+            $decoded['argb'] = strtoupper($color['argb']);
+        } elseif (isset($color['theme'])) {
+            $decoded['theme'] = (int) $color['theme'];
+            if (isset($color['tint'])) {
+                $decoded['tint'] = (float) $color['tint'];
+            }
+        } elseif (isset($color['indexed'])) {
+            $decoded['indexed'] = (int) $color['indexed'];
+        }
+        $this->workbookPresentationState['lastColor'] = $decoded;
+
+        return $decoded === [] ? null : $decoded;
