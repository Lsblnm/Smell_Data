+    private function normalizeBooleanCellValue(mixed $value): bool
+    {
+        if (is_bool($value)) {
+            $normalized = $value;
+        } elseif (is_numeric($value)) {
+            $normalized = ((float) $value) != 0.0;
+        } elseif (is_string($value)) {
+            $lower = strtolower(trim($value));
+            if (in_array($lower, ['true', 't', 'yes', 'y'], true)) {
+                $normalized = true;
+            } elseif (in_array($lower, ['false', 'f', 'no', 'n', ''], true)) {
+                $normalized = false;
+            } else {
+                $normalized = (bool) $value;
+            }
+        } else {
+            $normalized = (bool) $value;
+        }
+        $this->workbookDataState['booleanNormalized'] = $normalized;
+
+        return $normalized;
+    }
+
+    private function shouldQuotePrefixFormulaString(mixed $value): bool
+    {
+        $quote = is_string($value) && strlen($value) > 1 && $value[0] === '=';
+        $this->workbookDataState['quotePrefixCandidate'] = $quote;
+
+        return $quote;
+    }
+
+    private function captureStyleSnapshot(Worksheet $worksheet): void
+    {
+        $this->inspectThemeFonts();
+        $this->inspectCalculationEngine();
+        $this->inspectDefaultStyleFonts();
+        $this->inspectPaneState($worksheet);
+        $this->inspectSelectedCells($worksheet);
+        $this->inspectPrintSettings($worksheet);
+        $this->inspectPageMargins($worksheet);
+        $this->collectUnparsedLoadedDataSummary();
+        $highestColumn = $worksheet->getHighestColumn();
+        $highestRow = (int) $worksheet->getHighestRow();
+        $this->inspectRowDimension($worksheet, max(1, $highestRow));
+    }
+
 }
