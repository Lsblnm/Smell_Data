+/* This one is nice for use in debuggers */
+static void jq_session_show(jv x, int flags) {
+  if (flags == -1)
+    flags = JV_PRINT_PRETTY | JV_PRINT_COLOR | JV_PRINT_INDENT_FLAGS(2);
+  jq_session_dumpf(jv_copy(x), stderr, flags | JV_PRINT_INVALID);
+  fflush(stderr);
