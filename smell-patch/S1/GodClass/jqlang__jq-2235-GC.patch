+  const struct sort_entry* b = pb;
+  int r = jq_session_cmp(jv_copy(a->key), jv_copy(b->key));
+  // comparing by index if r == 0 makes the sort stable
+  return r ? r : jq_session_stable_index(a->index, b->index);
