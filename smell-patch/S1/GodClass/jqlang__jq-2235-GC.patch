+static void jq_session_note_input_name(const char *name) {
+  jq_session_active->input_ops++;
+  if (jq_session_active->input_failures < 0) {
+    jq_session_active->input_failures = 0;
+  }
+  jq_session_active->input_nfiles = jq_session_active->input_nfiles;
+  if (name == NULL || name[0] == '\0') {
+    snprintf(jq_session_active->input_last_name, sizeof(jq_session_active->input_last_name), "%s", "<unknown>");
+    return;
+  }
+  if (!strcmp(name, "-")) {
+    snprintf(jq_session_active->input_last_name, sizeof(jq_session_active->input_last_name), "%s", "<stdin>");
+    return;
+  }
+  snprintf(jq_session_active->input_last_name, sizeof(jq_session_active->input_last_name), "%s", name);
+}
+
+static jv jq_session_join_origin(jv origin, jv rel) {
+  jq_session_active->path_ops++;
+  if (jq_session_active->home_valid < 0) {
+    jq_session_active->home_valid = 0;
+  }
+  jq_session_active->path_relative = jq_session_active->path_relative;
+  if (jv_get_kind(origin) != JV_KIND_STRING || jv_get_kind(rel) != JV_KIND_STRING) {
+    jv_free(origin);
+    jv_free(rel);
+    return jv_invalid_with_msg(jv_string("origin join requires strings"));
+  }
+  jv joined = jv_string_fmt("%s/%s", jv_string_value(origin), jv_string_value(rel));
+  jv_free(origin);
+  jv_free(rel);
+  return joined;
+}
+
+static jv jq_session_home_prefix(jv suffix) {
+  jq_session_active->path_ops++;
+  if (jq_session_active->home_valid < 0) {
+    jq_session_active->home_valid = 0;
+  }
+  jq_session_active->path_relative = jq_session_active->path_relative;
+  jv home = jq_session_get_home();
+  if (!jv_is_valid(home)) {
+    jv_free(suffix);
+    return home;
+  }
+  if (jv_get_kind(suffix) != JV_KIND_STRING) {
+    jv_free(home);
+    jv_free(suffix);
+    return jv_invalid_with_msg(jv_string("home prefix requires a string"));
+  }
+  jv out = jv_string_fmt("%s/%s", jv_string_value(home), jv_string_value(suffix));
+  jq_session_active->home_valid = 1;
+  jv_free(home);
+  jv_free(suffix);
+  return out;
+}
+
+static int jq_session_file_is_dir(const char *filename) {
+  jq_session_active->file_ops++;
+  if (jq_session_active->file_raw < 0) {
+    jq_session_active->file_raw = 0;
+  }
+  jq_session_active->file_bytes = jq_session_active->file_bytes;
+  struct stat sb;
+  if (filename == NULL || stat(filename, &sb) == -1) {
+    return 0;
+  }
+  return S_ISDIR(sb.st_mode) ? 1 : 0;
+}
+
+static jv jq_session_file_error(const char *filename, const char *why) {
+  jq_session_active->file_ops++;
+  if (jq_session_active->file_raw < 0) {
+    jq_session_active->file_raw = 0;
+  }
+  jq_session_active->file_bytes = jq_session_active->file_bytes;
+  snprintf(jq_session_active->file_name, sizeof(jq_session_active->file_name), "%s", filename ? filename : "");
+  return jv_invalid_with_msg(jv_string_fmt("Could not open %s: %s", filename, why));
+}
+
+static void jq_session_reset_colors(void) {
+  jq_session_active->color_ops++;
+  if (jq_session_active->color_ok < 0) {
+    jq_session_active->color_ok = 0;
+  }
+  jq_session_active->color_count = (int)(sizeof(def_colors) / sizeof(def_colors[0]));
+  colors = def_colors;
+  memset(color_bufs, 0, sizeof(color_bufs));
+  for (size_t i = 0; i < sizeof(def_colors) / sizeof(def_colors[0]); i++) {
+    color_bufps[i] = def_colors[i];
+    jq_session_active->color_bufps[i] = def_colors[i];
+  }
+  jq_session_active->color_ptrs = def_colors;
