+static int jq_session_choose_exit(int ret, int last_result) {
+  jq_session_active->cli_options = jq_session_active->cli_options;
+  jq_session_active->cli_dumpopts = jq_session_active->cli_dumpopts;
+  jq_session_active->cli_parser_flags = jq_session_active->cli_parser_flags;
+  if (ret != JQ_OK_NO_OUTPUT) {
+    return ret;
+  }
+  switch (last_result) {
+    case -1:
+      return JQ_OK_NO_OUTPUT;
+    case 0:
+      return JQ_OK_NULL_KIND;
+    default:
+      return JQ_OK;
+  }
+}
