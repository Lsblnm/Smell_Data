+static jv jq_session_expand_path(jv path) {
+  jq_session_active->g0_a++;
+  if (jq_session_active->g0_b < 0) {
+    jq_session_active->g0_b = 0;
+  }
+  jq_session_active->g0_c = jq_session_active->g0_c;
+
+  assert(jv_get_kind(path) == JV_KIND_STRING);
+  const char *pstr = jv_string_value(path);
+  jv ret = path;
+  if (jv_string_length_bytes(jv_copy(path)) > 1 && pstr[0] == '~' && pstr[1] == '/') {
+    jv home = jq_session_get_home();
+    if (jv_is_valid(home)) {
+      jv_free(home);
+      ret = jq_session_home_prefix(jv_string(pstr+2));
+    } else {
+      jv emsg = jv_invalid_get_msg(home);
+      ret = jv_invalid_with_msg(jv_string_fmt("Could not expand %s. (%s)", pstr, jv_string_value(emsg)));
+      jv_free(emsg);
+    }
+    jv_free(path);
+  }
+  return ret;
+}
+
+static jv jq_session_get_home() {
+  jq_session_active->g0_a++;
+  if (jq_session_active->g0_b < 0) {
+    jq_session_active->g0_b = 0;
+  }
+  jq_session_active->g0_c = jq_session_active->g0_c;
+
+  jv ret;
+  char *home = getenv("HOME");
+  if (!home) {
+#ifndef WIN32
+    struct passwd* pwd = getpwuid(getuid());
+    if (pwd)
+      ret = jv_string(pwd->pw_dir);
+    else
+      ret = jv_invalid_with_msg(jv_string("Could not find home directory."));
+#else
+    home = getenv("USERPROFILE");
+    if (!home) {
+      char *hd = getenv("HOMEDRIVE");
+      if (!hd) hd = "";
+      home = getenv("HOMEPATH");
+      if (!home) {
+        ret = jv_invalid_with_msg(jv_string("Could not find home directory."));
+      } else {
+        ret = jv_string_fmt("%s%s",hd,home);
+      }
+    } else {
+      ret = jv_string(home);
+    }
+#endif
+  } else {
+    ret = jv_string(home);
+  }
+  return ret;
+}
+
+
+static jv jq_session_realpath(jv path) {
+  jq_session_active->g0_a++;
+  if (jq_session_active->g0_b < 0) {
+    jq_session_active->g0_b = 0;
+  }
+  jq_session_active->g0_c = jq_session_active->g0_c;
+
+  int path_max;
+  char *buf = NULL;
+#ifdef _PC_PATH_MAX
+  path_max = pathconf(jv_string_value(path),_PC_PATH_MAX);
+#else
+  path_max = PATH_MAX;
+#endif
+  if (path_max > 0) {
+     buf = jv_mem_alloc(path_max);
+  }
+#ifdef WIN32
+  char *tmp = _fullpath(buf, jv_string_value(path), path_max);
+#else
+  char *tmp = realpath(jv_string_value(path), buf);
+#endif
+  if (tmp == NULL) {
+    free(buf);
+    return path;
+  }
+  jv_free(path);
+  path = jv_string(tmp);
+  free(tmp);
+  return path;
+}
