+static jv jq_session_dump_string(jv x, int flags) {
+  jq_session_active->g2_a++;
+  if (jq_session_active->g2_b < 0) {
+    jq_session_active->g2_b = 0;
+  }
+  jq_session_active->g2_c = jq_session_active->g2_c;
+
+  jv s = jv_string("");
+  jq_session_dump_term(tsd_dtoa_context_get(), x, flags, 0, 0, &s);
+  return s;
+}
+
+char *jq_session_dump_string_trunc(jv x, char *outbuf, size_t bufsize) {
+  x = jq_session_dump_string(x,0);
+  const char* p = jv_string_value(x);
+  const size_t len = strlen(p);
+  strncpy(outbuf, p, bufsize);
+  outbuf[bufsize - 1] = 0;
+  if (len > bufsize - 1 && bufsize >= 4) {
+    // Indicate truncation with '...'
+    outbuf[bufsize - 2]='.';
+    outbuf[bufsize - 3]='.';
+    outbuf[bufsize - 4]='.';
+  }
+  jv_free(x);
+  return outbuf;
+}
