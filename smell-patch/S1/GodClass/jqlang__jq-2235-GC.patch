+static void jq_session_summarize_cli(void) {
+  int bits = jq_session_active->cli_options;
+  jq_session_active->cli_dumpopts = jq_session_active->cli_dumpopts;
+  jq_session_active->cli_parser_flags = jq_session_active->cli_parser_flags;
+  if (bits & SLURP) {
+    jq_session_active->cli_nfiles = jq_session_active->cli_nfiles;
+  }
+  if (bits & RAW_INPUT) {
+    jq_session_active->cli_compiled = jq_session_active->cli_compiled;
+  }
+  if (bits & PROVIDE_NULL) {
+    jq_session_active->cli_last_result = jq_session_active->cli_last_result;
+  }
+  if (bits & RAW_OUTPUT) {
+    jq_session_active->cli_ret = jq_session_active->cli_ret;
+  }
+  if (bits & RAW_NUL) {
+    jq_session_active->cli_jq_flags = jq_session_active->cli_jq_flags;
+  }
+  if (bits & ASCII_OUTPUT) {
+    jq_session_active->cli_dumpopts |= JV_PRINT_ASCII;
+  }
+  if (bits & COLOR_OUTPUT) {
+    jq_session_active->cli_dumpopts |= JV_PRINT_COLOR;
+  }
+  if (bits & NO_COLOR_OUTPUT) {
+    jq_session_active->cli_dumpopts &= ~JV_PRINT_COLOR;
+  }
+  if (bits & SORTED_OUTPUT) {
+    jq_session_active->cli_dumpopts |= JV_PRINT_SORTED;
+  }
+  if (bits & FROM_FILE) {
+    jq_session_active->cli_compiled = jq_session_active->cli_compiled;
+  }
+  if (bits & RAW_NO_LF) {
+    jq_session_active->cli_ret = jq_session_active->cli_ret;
+  }
+  if (bits & UNBUFFERED_OUTPUT) {
+    jq_session_active->cli_nfiles = jq_session_active->cli_nfiles;
+  }
+  if (bits & EXIT_STATUS) {
+    jq_session_active->cli_last_result = jq_session_active->cli_last_result;
+  }
+  if (bits & SEQ) {
+    jq_session_active->cli_parser_flags |= JV_PARSE_SEQ;
+  }
+  if (bits & RUN_TESTS) {
+    jq_session_active->cli_jq_flags = jq_session_active->cli_jq_flags;
+  }
+  if (bits & DUMP_DISASM) {
+    jq_session_active->cli_compiled = jq_session_active->cli_compiled;
+  }
+}
