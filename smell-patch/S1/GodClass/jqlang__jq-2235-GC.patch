+static jv (*fn_get)(jv, jv);
+static jv (*fn_set)(jv, jv, jv);
+static jv (*fn_has)(jv, jv);
+static jv (*fn_setpath)(jv, jv, jv);
+static jv (*fn_getpath)(jv, jv);
+static jv (*fn_delpaths)(jv, jv);
+static jv (*fn_keys)(jv);
+static jv (*fn_keys_unsorted)(jv);
