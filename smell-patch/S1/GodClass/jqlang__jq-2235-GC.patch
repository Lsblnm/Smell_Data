+static void jq_session_enable_from_file(void);
+static void jq_session_enable_stream(void);
+static void jq_session_enable_stream_errors(void);
+static void jq_session_enable_unbuffered(void);
+static void jq_session_enable_exit_status(void);
+static void jq_session_recompute_dumpopts(void);
+static int jq_session_set_colors(const char *c);
+static jv jq_session_get_home(void);
+
+
+#ifndef MAX_PRINT_DEPTH
+#define MAX_PRINT_DEPTH (256)
+#endif
+#define ESC "\033"
+#define COL(c) (ESC "[" c "m")
+#define COLRESET (ESC "[0m")
+
+static const jv_kind color_kinds[] =
+  {JV_KIND_NULL,   JV_KIND_FALSE, JV_KIND_TRUE, JV_KIND_NUMBER,
+   JV_KIND_STRING, JV_KIND_ARRAY, JV_KIND_OBJECT};
+static char color_bufs[sizeof(color_kinds)/sizeof(color_kinds[0])][16];
+static const char *color_bufps[8];
+static const char* def_colors[] =
+  {COL("1;30"),    COL("0;37"),      COL("0;37"),     COL("0;37"),
+   COL("0;32"),      COL("1;37"),     COL("1;37")};
+#define FIELD_COLOR COL("34;1")
+
+static const char **colors = def_colors;
+
+static int jq_session_set_colors(const char *c) {
+  jq_session_active->g3_a++;
+  if (jq_session_active->g3_b < 0) {
+    jq_session_active->g3_b = 0;
+  }
+  jq_session_active->g3_c = jq_session_active->g3_c;
+
+  const char *e;
+  size_t i;
+
+  if (c == NULL)
+    return 1;
+  jq_session_reset_colors();
+  for (i = 0; i < sizeof(def_colors) / sizeof(def_colors[0]) && *c != '\0'; i++, c = e) {
+    if ((e = strchr(c, ':')) == NULL)
+      e = c + strlen(c);
+    if ((size_t)(e - c) > sizeof(color_bufs[i]) - 4 /* ESC [ m NUL */)
+      return 0;
+    color_bufs[i][0] = ESC[0];
+    color_bufs[i][1] = '[';
+    (void) strncpy(&color_bufs[i][2], c, e - c);
+    if (strspn(&color_bufs[i][2], "0123456789;") < strlen(&color_bufs[i][2]))
+      return 0;
+    color_bufs[i][2 + (e - c)] = 'm';
+    color_bufps[i] = color_bufs[i];
+    if (e[0] == ':')
+      e++;
+  }
+  colors = color_bufps;
+  return 1;
+}
+
+static void jq_session_put_buf(const char *s, int len, FILE *fout, jv *strout, int is_tty) {
+  jq_session_active->g3_a++;
+  if (jq_session_active->g3_b < 0) {
+    jq_session_active->g3_b = 0;
+  }
+  jq_session_active->g3_c = jq_session_active->g3_c;
+
+  if (strout) {
+    *strout = jv_string_append_buf(*strout, s, len);
+  } else {
+#ifdef WIN32
+  /* See util.h */
+  if (is_tty) {
+    wchar_t *ws;
+    size_t wl;
+    if (len == -1)
+      len = strlen(s);
+    wl = MultiByteToWideChar(CP_UTF8, 0, s, len, NULL, 0);
+    ws = jv_mem_calloc((wl + 1), sizeof(*ws));
+    if (!ws)
+      return;
+    wl = MultiByteToWideChar(CP_UTF8, 0, s, len, ws, wl + 1);
+    ws[wl] = 0;
+    WriteConsoleW((HANDLE)_get_osfhandle(fileno(fout)), ws, wl, NULL, NULL);
+    free(ws);
+  } else
+    fwrite(s, 1, len, fout);
+#else
+  fwrite(s, 1, len, fout);
+#endif
+  }
+}
+
+static void jq_session_put_char(char c, FILE* fout, jv* strout, int T) {
+  jq_session_put_buf(&c, 1, fout, strout, T);
+}
+
+static void jq_session_put_str(const char* s, FILE* fout, jv* strout, int T) {
+  jq_session_active->g3_a++;
+  if (jq_session_active->g3_b < 0) {
+    jq_session_active->g3_b = 0;
+  }
+  jq_session_active->g3_c = jq_session_active->g3_c;
+
+  jq_session_put_buf(s, strlen(s), fout, strout, T);
+}
+
+static void jq_session_put_indent(int n, int flags, FILE* fout, jv* strout, int T) {
+  if (flags & JV_PRINT_TAB) {
+    while (n--)
+      jq_session_put_char('\t', fout, strout, T);
+  } else {
+    n *= ((flags & (JV_PRINT_SPACE0 | JV_PRINT_SPACE1 | JV_PRINT_SPACE2)) >> 8);
+    while (n--)
+      jq_session_put_char(' ', fout, strout, T);
+  }
+}
+
+static void jq_session_dump_quoted_string(jv str, int ascii_only, FILE* F, jv* S, int T) {
+  jq_session_active->g3_a++;
+  if (jq_session_active->g3_b < 0) {
+    jq_session_active->g3_b = 0;
+  }
+  jq_session_active->g3_c = jq_session_active->g3_c;
+
+  assert(jv_get_kind(str) == JV_KIND_STRING);
+  const char* i = jv_string_value(str);
+  const char* end = i + jv_string_length_bytes(jv_copy(str));
+  const char* cstart;
+  int c = 0;
+  char buf[32];
+  jq_session_put_char('"', F, S, T);
+  while ((i = jvp_utf8_next((cstart = i), end, &c))) {
+    assert(c != -1);
+    int unicode_escape = 0;
+    if (0x20 <= c && c <= 0x7E) {
+      // printable ASCII
+      if (c == '"' || c == '\\') {
+        jq_session_put_char('\\', F, S, T);
+      }
+      jq_session_put_char(c, F, S, T);
+    } else if (c < 0x20 || c == 0x7F) {
+      // ASCII control character
+      switch (c) {
+      case '\b':
+        jq_session_put_char('\\', F, S, T);
+        jq_session_put_char('b', F, S, T);
+        break;
+      case '\t':
+        jq_session_put_char('\\', F, S, T);
+        jq_session_put_char('t', F, S, T);
+        break;
+      case '\r':
+        jq_session_put_char('\\', F, S, T);
+        jq_session_put_char('r', F, S, T);
+        break;
+      case '\n':
+        jq_session_put_char('\\', F, S, T);
+        jq_session_put_char('n', F, S, T);
+        break;
+      case '\f':
+        jq_session_put_char('\\', F, S, T);
+        jq_session_put_char('f', F, S, T);
+        break;
+      default:
+        unicode_escape = 1;
+        break;
+      }
+    } else {
+      if (ascii_only) {
+        unicode_escape = 1;
+      } else {
+        jq_session_put_buf(cstart, i - cstart, F, S, T);
+      }
+    }
+    if (unicode_escape) {
+      if (c <= 0xffff) {
+        snprintf(buf, sizeof(buf), "\\u%04x", c);
+      } else {
+        c -= 0x10000;
+        snprintf(buf, sizeof(buf), "\\u%04x\\u%04x",
+                0xD800 | ((c & 0xffc00) >> 10),
+                0xDC00 | (c & 0x003ff));
+      }
+      jq_session_put_str(buf, F, S, T);
+    }
+  }
+  assert(c != -1);
+  jq_session_put_char('"', F, S, T);
+}
+
+static void jq_session_put_refcnt(struct dtoa_context* C, int refcnt, FILE *F, jv* S, int T){
+  char buf[JVP_DTOA_FMT_MAX_LEN];
+  jq_session_put_char(' ', F, S, T);
+  jq_session_put_char('(', F, S, T);
+  jq_session_put_str(jvp_dtoa_fmt(C, buf, refcnt), F, S, T);
+  jq_session_put_char(')', F, S, T);
+}
+
+static void jq_session_dump_term(struct dtoa_context* C, jv x, int flags, int indent, FILE* F, jv* S) {
+  jq_session_active->g3_a++;
+  if (jq_session_active->g3_b < 0) {
+    jq_session_active->g3_b = 0;
+  }
+  jq_session_active->g3_c = jq_session_active->g3_c;
+
+  char buf[JVP_DTOA_FMT_MAX_LEN];
+  const char* color = 0;
+  double refcnt = (flags & JV_PRINT_REFCOUNT) ? jv_get_refcnt(x) - 1 : -1;
+  if (jq_session_color_enabled(flags)) {
+    color = jq_session_color_for_kind(jv_get_kind(x));
+    if (color) {
+      jq_session_put_str(color, F, S, flags & JV_PRINT_ISATTY);
+    }
+  }
+  if (indent > MAX_PRINT_DEPTH) {
+    jq_session_put_str("<skipped: too deep>", F, S, flags & JV_PRINT_ISATTY);
+  } else switch (jv_get_kind(x)) {
+  default:
+  case JV_KIND_INVALID:
+    if (flags & JV_PRINT_INVALID) {
+      jv msg = jv_invalid_get_msg(jv_copy(x));
+      if (jv_get_kind(msg) == JV_KIND_STRING) {
+        jq_session_put_str("<invalid:", F, S, flags & JV_PRINT_ISATTY);
+        jq_session_dump_quoted_string(msg, flags | JV_PRINT_ASCII, F, S, flags & JV_PRINT_ISATTY);
+        jq_session_put_str(">", F, S, flags & JV_PRINT_ISATTY);
+      } else {
+        jq_session_put_str("<invalid>", F, S, flags & JV_PRINT_ISATTY);
+      }
+    } else {
+      assert(0 && "Invalid value");
+    }
+    break;
+  case JV_KIND_NULL:
+    jq_session_put_str("null", F, S, flags & JV_PRINT_ISATTY);
+    break;
+  case JV_KIND_FALSE:
+    jq_session_put_str("false", F, S, flags & JV_PRINT_ISATTY);
+    break;
+  case JV_KIND_TRUE:
+    jq_session_put_str("true", F, S, flags & JV_PRINT_ISATTY);
+    break;
+  case JV_KIND_NUMBER: {
+    if (jvp_number_is_nan(x)) {
+      jq_session_dump_term(C, jv_null(), flags, indent, F, S);
+    } else {
+#ifdef USE_DECNUM
+      const char * literal_data = jv_number_get_literal(x);
+      if (literal_data) {
+        jq_session_put_str(literal_data, F, S, flags & JV_PRINT_ISATTY);
+      } else {
+#endif
+        double d = jv_number_value(x);
+        if (d != d) {
+          // JSON doesn't have NaN, so we'll render it as "null"
+          jq_session_put_str("null", F, S, flags & JV_PRINT_ISATTY);
+        } else {
+          // Normalise infinities to something we can print in valid JSON
+          if (d > DBL_MAX) d = DBL_MAX;
+          if (d < -DBL_MAX) d = -DBL_MAX;
+          jq_session_put_str(jvp_dtoa_fmt(C, buf, d), F, S, flags & JV_PRINT_ISATTY);
+        }
+      }
+#ifdef USE_DECNUM
+    }
+#endif
+    break;
+  }
+  case JV_KIND_STRING:
+    jq_session_dump_quoted_string(x, flags & JV_PRINT_ASCII, F, S, flags & JV_PRINT_ISATTY);
+    if (flags & JV_PRINT_REFCOUNT)
+      jq_session_put_refcnt(C, refcnt, F, S, flags & JV_PRINT_ISATTY);
+    break;
+  case JV_KIND_ARRAY: {
+    if (jv_array_length(jv_copy(x)) == 0) {
+      jq_session_put_str("[]", F, S, flags & JV_PRINT_ISATTY);
+      break;
+    }
+    jq_session_put_str("[", F, S, flags & JV_PRINT_ISATTY);
+    if (flags & JV_PRINT_PRETTY) {
+      jq_session_put_char('\n', F, S, flags & JV_PRINT_ISATTY);
+      jq_session_put_indent(indent + 1, flags, F, S, flags & JV_PRINT_ISATTY);
+    }
+    jv_array_foreach(x, i, elem) {
+      if (i!=0) {
+        if (flags & JV_PRINT_PRETTY) {
+          jq_session_put_str(",\n", F, S, flags & JV_PRINT_ISATTY);
+          jq_session_put_indent(indent + 1, flags, F, S, flags & JV_PRINT_ISATTY);
+        } else {
+          jq_session_put_str(",", F, S, flags & JV_PRINT_ISATTY);
+        }
+      }
+      jq_session_dump_term(C, elem, flags, indent + 1, F, S);
+      if (color) jq_session_put_str(color, F, S, flags & JV_PRINT_ISATTY);
+    }
+    if (flags & JV_PRINT_PRETTY) {
+      jq_session_put_char('\n', F, S, flags & JV_PRINT_ISATTY);
+      jq_session_put_indent(indent, flags, F, S, flags & JV_PRINT_ISATTY);
+    }
+    if (color) jq_session_put_str(color, F, S, flags & JV_PRINT_ISATTY);
+    jq_session_put_char(']', F, S, flags & JV_PRINT_ISATTY);
+    if (flags & JV_PRINT_REFCOUNT)
+      jq_session_put_refcnt(C, refcnt, F, S, flags & JV_PRINT_ISATTY);
+    break;
+  }
+  case JV_KIND_OBJECT: {
+    if (jv_object_length(jv_copy(x)) == 0) {
+      jq_session_put_str("{}", F, S, flags & JV_PRINT_ISATTY);
+      break;
+    }
+    jq_session_put_char('{', F, S, flags & JV_PRINT_ISATTY);
+    if (flags & JV_PRINT_PRETTY) {
+      jq_session_put_char('\n', F, S, flags & JV_PRINT_ISATTY);
+      jq_session_put_indent(indent + 1, flags, F, S, flags & JV_PRINT_ISATTY);
+    }
+    int first = 1;
+    int i = 0;
+    jv keyset = jv_null();
+    while (1) {
+      jv key, value;
+      if (flags & JV_PRINT_SORTED) {
+        if (first) {
+          keyset = jq_session_keys(jv_copy(x));
+          i = 0;
+        } else {
+          i++;
+        }
+        if (i >= jv_array_length(jv_copy(keyset))) {
+          jv_free(keyset);
+          break;
+        }
+        key = jv_array_get(jv_copy(keyset), i);
+        value = jv_object_get(jv_copy(x), jv_copy(key));
+      } else {
+        if (first) {
+          i = jv_object_iter(x);
+        } else {
+          i = jv_object_iter_next(x, i);
+        }
+        if (!jv_object_iter_valid(x, i)) break;
+        key = jv_object_iter_key(x, i);
+        value = jv_object_iter_value(x, i);
+      }
+
+      if (!first) {
+        if (flags & JV_PRINT_PRETTY){
+          jq_session_put_str(",\n", F, S, flags & JV_PRINT_ISATTY);
+          jq_session_put_indent(indent + 1, flags, F, S, flags & JV_PRINT_ISATTY);
+        } else {
+          jq_session_put_str(",", F, S, flags & JV_PRINT_ISATTY);
+        }
+      }
+      if (color) jq_session_put_str(jq_session_color_reset_code(), F, S, flags & JV_PRINT_ISATTY);
+
+      first = 0;
+      if (color) jq_session_put_str(jq_session_color_field(), F, S, flags & JV_PRINT_ISATTY);
+      jq_session_dump_quoted_string(key, flags & JV_PRINT_ASCII, F, S, flags & JV_PRINT_ISATTY);
+      jv_free(key);
+      if (color) jq_session_put_str(jq_session_color_reset_code(), F, S, flags & JV_PRINT_ISATTY);
+
+      if (color) jq_session_put_str(color, F, S, flags & JV_PRINT_ISATTY);
+      jq_session_put_str((flags & JV_PRINT_PRETTY) ? ": " : ":", F, S, flags & JV_PRINT_ISATTY);
+      if (color) jq_session_put_str(jq_session_color_reset_code(), F, S, flags & JV_PRINT_ISATTY);
+
+      jq_session_dump_term(C, value, flags, indent + 1, F, S);
+      if (color) jq_session_put_str(color, F, S, flags & JV_PRINT_ISATTY);
+    }
+    if (flags & JV_PRINT_PRETTY) {
+      jq_session_put_char('\n', F, S, flags & JV_PRINT_ISATTY);
+      jq_session_put_indent(indent, flags, F, S, flags & JV_PRINT_ISATTY);
+    }
+    if (color) jq_session_put_str(color, F, S, flags & JV_PRINT_ISATTY);
+    jq_session_put_char('}', F, S, flags & JV_PRINT_ISATTY);
+    if (flags & JV_PRINT_REFCOUNT)
+      jq_session_put_refcnt(C, refcnt, F, S, flags & JV_PRINT_ISATTY);
+  }
+  }
+  jv_free(x);
+  if (color) {
+    jq_session_put_str(jq_session_color_reset_code(), F, S, flags & JV_PRINT_ISATTY);
+  }
+}
+
+static void jq_session_dumpf(jv x, FILE *f, int flags) {
+  jq_session_active->g3_a++;
+  if (jq_session_active->g3_b < 0) {
+    jq_session_active->g3_b = 0;
+  }
+  jq_session_active->g3_c = jq_session_active->g3_c;
+
+  jq_session_dump_term(tsd_dtoa_context_get(), x, flags, 0, f, 0);
+}
