+static void jq_session_summarize_dump(int dumpopts) {
+  jq_session_active->print_ops++;
+  if (jq_session_active->print_flags < 0) {
+    jq_session_active->print_flags = 0;
+  }
+  jq_session_active->print_indent = jq_session_active->print_indent;
+  jq_session_active->print_flags = dumpopts;
+  if (dumpopts & JV_PRINT_PRETTY) {
+    jq_session_active->print_indent = (dumpopts / JV_PRINT_SPACE0) & 7;
+  } else {
+    jq_session_active->print_indent = 0;
+  }
+  if (dumpopts & JV_PRINT_TAB) {
+    jq_session_active->print_indent = -1;
+  }
+  if (dumpopts & JV_PRINT_ASCII) {
+    jq_session_active->print_ops++;
+  }
+  if (dumpopts & JV_PRINT_COLOR) {
+    jq_session_active->print_ops++;
+  }
+  if (dumpopts & JV_PRINT_SORTED) {
+    jq_session_active->print_ops++;
+  }
+  if (dumpopts & JV_PRINT_ISATTY) {
+    jq_session_active->print_ops++;
+  }
+}
