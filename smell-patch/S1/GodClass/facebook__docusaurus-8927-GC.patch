+  onBrokenMarkdownLink,
+}: MarkdownLinkRewriteOptions<T> & {
+  onBrokenMarkdownLink: (link: BrokenMarkdownLink<T>) => void;
+}): string {
+  return new MarkdownLinkCoordinator({
