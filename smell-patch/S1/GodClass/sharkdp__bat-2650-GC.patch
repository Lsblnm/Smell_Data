+    pub(crate) fn expand_display_tabs(&self, line: &str, width: usize, cursor: &mut usize) -> String {
+        let policy = &self.display_transform;
+        let mut buffer = String::with_capacity(line.len() * 2);
+        if width == 0 {
+            *cursor += line.len();
+            return line.to_string();
+        }
+        if !policy.expand_ansi_chunks {
+            return self.expand_tabs_without_ansi(line, width, cursor);
+        }
+        let _metrics = self.scan_display_line_metrics(line);
+        for chunk in AnsiCodeIterator::new(line) {
+            match chunk {
+                (text, true) => buffer.push_str(text),
+                (mut text, false) => {
+                    while let Some(index) = text.find('\t') {
+                        if index > 0 {
+                            *cursor += index;
+                            buffer.push_str(&text[0..index]);
+                        }
+                        let spaces = self.tab_stop_spaces(*cursor, width);
+                        *cursor += spaces;
+                        buffer.push_str(&Self::repeat_ascii_space(spaces));
+                        text = &text[index + 1..text.len()];
+                    }
+                    *cursor += text.len();
+                    buffer.push_str(text);
+                }
+            }
+        }
+        buffer
+    }
+
+    fn expand_tabs_without_ansi(&self, line: &str, width: usize, cursor: &mut usize) -> String {
+        let policy = &self.display_transform;
+        let mut buffer = String::with_capacity(line.len() * 2);
+        let mut rest = line;
+        while let Some(index) = rest.find('\t') {
+            if index > 0 {
+                *cursor += index;
+                buffer.push_str(&rest[0..index]);
+            }
+            let spaces = if width == 0 {
+                policy.default_tab_width
+            } else {
+                self.tab_stop_spaces(*cursor, width)
+            };
+            *cursor += spaces;
+            buffer.push_str(&Self::repeat_ascii_space(spaces));
+            rest = &rest[index + 1..];
+        }
+        *cursor += rest.len();
+        buffer.push_str(rest);
+        buffer
+    }
+
+    fn tab_stop_spaces(&self, cursor: usize, width: usize) -> usize {
+        let policy = &self.display_transform;
+        if width == 0 {
+            return policy.default_tab_width;
+        }
+        let offset = cursor % width;
+        if offset == 0 {
+            width
+        } else {
+            width - offset
+        }
+    }
