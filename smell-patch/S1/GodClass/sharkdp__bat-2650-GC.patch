+    fn scan_nonprintable_metrics(&self, input: &[u8]) -> usize {
+        let policy = &self.display_transform;
+        let mut controls = 0usize;
+        let mut tabs = 0usize;
+        let mut spaces = 0usize;
+        let mut utf8 = 0usize;
+        let mut invalid = 0usize;
+        let mut idx = 0usize;
+        while idx < input.len() {
+            let byte = input[idx];
+            if byte == 0 || byte == 7 || byte == 8 || byte == 27 {
+                controls += 1;
+                idx += 1;
+            } else if byte == b'\t' {
+                tabs += 1;
+                idx += 1;
+            } else if byte == b' ' {
+                spaces += 1;
+                idx += 1;
+            } else if byte < 0x80 {
+                idx += 1;
+            } else if let Some((_, skip)) = Self::try_parse_utf8_char(&input[idx..]) {
+                utf8 += 1;
+                idx += skip;
+            } else {
+                invalid += 1;
+                idx += 1;
+            }
+            if idx > policy.skip_long_line_bytes {
+                break;
+            }
+        }
+        controls + tabs + spaces + utf8 + invalid + policy.default_tab_width
+    }
