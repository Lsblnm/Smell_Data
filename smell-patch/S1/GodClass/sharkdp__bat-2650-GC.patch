+    pub(crate) fn plan_snip_segments(
+        &self,
+        panel: &str,
+        term_width: usize,
+    ) -> (String, String, String) {
+        let layout = &self.print_layout;
+        let title = layout.snip_title;
+        let panel_count = panel.chars().count();
+        let title_count = title.chars().count();
+        if term_width <= panel_count + title_count {
+            return (panel.to_string(), String::new(), title.to_string());
+        }
+        let snip_left = "─ ".repeat((term_width - panel_count - (title_count / 2)) / 4);
+        let snip_left_count = snip_left.chars().count();
+        let snip_right =
+            " ─".repeat((term_width - panel_count - snip_left_count - title_count) / 2);
+        (
+            panel.to_string(),
+            snip_left,
+            format!("{}{}", title, snip_right),
+        )
+    }
