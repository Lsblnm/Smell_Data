+    pub(crate) fn fill_header_panel(&self, text: &str, panel_width: usize, with_grid: bool) -> String {
+        let layout = &self.print_layout;
+        if panel_width <= layout.min_panel_width {
+            return String::new();
+        }
+        let take_at = panel_width.saturating_sub(1);
+        let truncated: String = text.chars().take(take_at).collect();
+        let fill_len = take_at.saturating_sub(truncated.len());
+        let mut filled = truncated;
+        for _ in 0..fill_len {
+            filled.push(layout.panel_fill_char);
+        }
+        let _ = self.measure_header_panel_text(&filled, panel_width);
+        if with_grid {
+            filled.push_str(" │ ");
+            filled
+        } else {
+            filled
+        }
+    }
