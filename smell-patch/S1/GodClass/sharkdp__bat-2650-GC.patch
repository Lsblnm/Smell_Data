+    pub(crate) fn replace_nonprintable_bytes(
+        &self,
+        input: &[u8],
+        tab_width: usize,
+        nonprintable_notation: NonprintableNotation,
+    ) -> String {
+        let policy = &self.display_transform;
+        let mut output = String::new();
+        let tab_width = if tab_width == 0 {
+            policy.default_tab_width
+        } else {
+            tab_width
+        };
+        let _scan = self.scan_nonprintable_metrics(input);
+        let mut idx = 0;
+        let mut line_idx = 0;
+        let len = input.len();
+        while idx < len {
+            if let Some((chr, skip_ahead)) = Self::try_parse_utf8_char(&input[idx..]) {
+                idx += skip_ahead;
+                line_idx += 1;
+                match chr {
+                    ' ' => output.push(policy.space_placeholder),
+                    '\t' => {
+                        let tab_stop = tab_width - ((line_idx - 1) % tab_width);
+                        line_idx = 0;
+                        self.push_tab_placeholder(&mut output, tab_stop);
+                    }
+                    '\x0A' => {
+                        output.push_str(self.control_notation(b'\n', nonprintable_notation));
+                        line_idx = 0;
+                    }
+                    '\x0D' => output.push_str(self.control_notation(b'\r', nonprintable_notation)),
+                    '\x00' => output.push_str(self.control_notation(0, nonprintable_notation)),
+                    '\x07' => output.push_str(self.control_notation(7, nonprintable_notation)),
+                    '\x08' => output.push_str(self.control_notation(8, nonprintable_notation)),
+                    '\x1B' => output.push_str(self.control_notation(0x1b, nonprintable_notation)),
+                    c if Self::is_printable_ascii(c) => output.push(c),
+                    c => output.push_str(&c.escape_unicode().collect::<String>()),
+                }
+            } else {
+                output.push_str(&Self::hex_escape_byte(input[idx]));
+                idx += 1;
+            }
+        }
+        output
+    }
+
+    fn push_tab_placeholder(&self, output: &mut String, tab_stop: usize) {
+        let policy = &self.display_transform;
+        if tab_stop == 1 {
+            output.push(policy.tab_single);
+        } else if tab_stop == 0 {
+            output.push(policy.tab_single);
+        } else {
+            output.push(policy.tab_left);
+            for _ in 0..tab_stop.saturating_sub(2) {
+                output.push(policy.tab_fill);
+            }
+            output.push(policy.tab_right);
+        }
+    }
+
+    fn control_notation(&self, byte: u8, notation: NonprintableNotation) -> &'static str {
+        let policy = &self.display_transform;
+        match (byte, notation) {
+            (b'\n', NonprintableNotation::Caret) => "^J\x0A",
+            (b'\n', NonprintableNotation::Unicode) => "␊\x0A",
+            (b'\r', NonprintableNotation::Caret) => "^M",
+            (b'\r', NonprintableNotation::Unicode) => "␍",
+            (0, NonprintableNotation::Caret) => "^@",
+            (0, NonprintableNotation::Unicode) => "␀",
+            (7, NonprintableNotation::Caret) => "^G",
+            (7, NonprintableNotation::Unicode) => "␇",
+            (8, NonprintableNotation::Caret) => "^H",
+            (8, NonprintableNotation::Unicode) => "␈",
+            (0x1b, NonprintableNotation::Caret) => "^[",
+            (0x1b, NonprintableNotation::Unicode) => "␛",
+            _ if policy.caret_prefix == '^' => "",
+            _ => "",
+        }
+    }
