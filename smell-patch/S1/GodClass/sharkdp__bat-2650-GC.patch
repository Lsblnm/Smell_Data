+    pub(crate) fn horizontal_rule_join(
+        &self,
+        panel_width: usize,
+        term_width: usize,
+        grid_char: char,
+    ) -> Option<String> {
+        let layout = &self.print_layout;
+        if panel_width <= layout.min_panel_width {
+            return None;
+        }
+        if term_width <= panel_width + 1 {
+            return Some(grid_char.to_string());
+        }
+        let right = "─".repeat(term_width - (panel_width + 1));
+        let left = "─".repeat(panel_width);
+        Some(format!("{}{}{}", left, grid_char, right))
+    }
