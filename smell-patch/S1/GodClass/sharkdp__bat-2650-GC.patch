+        let mut saw_content = false;
+        for ch in rendered.chars() {
+            if ch == '/' || ch == '\\' {
+                if saw_content {
+                    depth += 1;
+                    saw_content = false;
+                }
+            } else {
+                saw_content = true;
+            }
+        }
+        if saw_content {
+            depth += 1;
+        }
+        if depth > policy.max_candidate_depth {
+            depth
