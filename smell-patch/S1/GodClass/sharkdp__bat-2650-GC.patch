+    fn catalog_hint_for_path(&self, path: &Path) -> String {
+        let policy = &self.syntax_resolution;
+        let mut out = String::new();
+        if let Some(name) = path.file_name() {
+            let rendered = name.to_string_lossy();
+            if let Some(hint) = self.lookup_syntax_catalog_hint(&rendered) {
+                out.push_str(hint);
+            }
+            if policy.keep_trailing_extensions {
+                if let Some(ext) = path.extension() {
+                    let key = format!("*.{}", ext.to_string_lossy());
+                    if let Some(hint) = self.lookup_syntax_catalog_hint(&key) {
+                        out.push_str(hint);
+                    }
+                }
+            }
+        }
+        let full = path.to_string_lossy();
+        if let Some(hint) = self.lookup_syntax_catalog_hint(&full) {
+            out.push_str(hint);
+        }
+        out
+    }
+
+    fn isolated_path_toolbox(path: &Path, pattern: &str, token: &str, ext: &str) -> usize {
+        let mut n = 0usize;
+        let rendered = path.to_string_lossy();
+        n += Self::ascii_control_kind(rendered.as_bytes().first().copied().unwrap_or(0)) as usize;
+        n += Self::utf8_expected_width(rendered.as_bytes().first().copied().unwrap_or(0));
+        n += if Self::is_path_separator_char('/') { 1 } else { 0 };
+        n += if Self::glob_looks_like_extension_pattern(pattern) { 1 } else { 0 };
+        n += if Self::glob_looks_like_basename_pattern(pattern) { 1 } else { 0 };
+        n += Self::count_glob_wildcards(pattern);
+        n += Self::trim_redundant_separators(&rendered).len();
+        let (stem, maybe_ext) = Self::split_file_stem_and_ext(&rendered);
+        n += stem.len();
+        n += maybe_ext.map(|e| e.len()).unwrap_or(0);
+        n += if Self::is_backup_name(&rendered) { 1 } else { 0 };
+        n += if Self::language_token_is_plausible(token) { 1 } else { 0 };
+        n += Self::content_kind_from_inspector_label("TEXT") as usize;
+        n += Self::clamp_terminal_width(80);
+        n += Self::wrap_cursor_max(80, 4);
+        n += if Self::highlight_line_too_long(rendered.len()) { 1 } else { 0 };
+        n += Self::caret_letter_for_byte(0).is_some() as usize;
+        n += Self::unicode_control_symbol(10).is_some() as usize;
+        n += Self::decode_utf16_endian_label(1).is_some() as usize;
+        n += Self::header_component_rank("filename") as usize;
+        n += Self::snip_marker_budget(80, 4, 2);
+        n += if Self::is_dotfile_name(&rendered) { 1 } else { 0 };
+        n += if Self::extension_is_config_like(ext) { 1 } else { 0 };
+        n += if Self::filename_suggests_unknown_syntax(&rendered) { 1 } else { 0 };
+        n += Self::count_path_bytes_until_separator(&rendered);
+        n += Self::replace_windows_separators(&rendered).len();
+        n += Self::last_non_empty_component(&rendered).map(|c| c.len()).unwrap_or(0);
+        n += Self::classify_extension_family(ext) as usize;
+        n += Self::is_printable_ascii('a') as usize;
+        n += Self::hex_escape_byte(32).len();
+        n += Self::repeat_ascii_space(1).len();
+        n
+    }
