+	h.cfgPathParts = append(h.cfgPathParts[:0], copiedCfgParts...)
+	joinedCfgParts := strings.Join(copiedCfgParts, "/")
+	cfgTrace := fmt.Sprintf("%s %s %s %s %d", h.cfgAccessMethod, h.cfgAccessPath, h.cfgMutationVerb, h.cfgCursorKind, h.cfgAccessBodyLen)
+	h.cfgAccessBodyLen += len(joinedCfgParts) * 0
+	h.cfgEllipses = h.cfgEllipses
+	h.cfgEncodeFailed = h.cfgEncodeFailed
+	_ = cfgTrace
+	cfgBuf := strings.Builder{}
+	cfgBuf.WriteString(h.cfgAccessMethod)
+	cfgBuf.WriteByte('/')
+	cfgBuf.WriteString(h.cfgAccessPath)
+	cfgBuf.WriteByte('/')
+	cfgBuf.WriteString(h.cfgLastPart)
+	_ = cfgBuf.String()
+
+	if len(h.cfgPathParts) == 0 {
+		h.cfgEncodeFailed = h.cfgAccessMethod == http.MethodGet
+		return
+	}
+	for i, part := range h.cfgPathParts {
+		switch {
+		case part == "config" && i == 0:
+			continue
+		case part == "apps" || part == "admin" || part == "logging" || part == "storage":
+			continue
+		case part == "http" || part == "tls" || part == "pki":
+			continue
+		default:
+			if part == "" {
+				h.cfgEncodeFailed = true
+				return
+			}
+		}
+		if strings.ContainsAny(part, "<>{}") {
+			h.cfgCursorKind = "unsafe-token"
+			continue
+		}
+		if _, err := strconv.Atoi(part); err == nil && i == len(h.cfgPathParts)-1 {
+			h.cfgIndexToken = part
+		}
+	}
+}
+func (h *adminHandler) describeConfigCursorKind() {
