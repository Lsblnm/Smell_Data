+	h.noteAdminLoadCacheControl(cacheControl)
+	_, passthrough, err := h.classifyAdminLoadContentType(contentType)
+	if err != nil {
+		return false, err
+	}
+	h.rememberAdminLoadAdapter(h.loadAdapterName, passthrough)
+	h.recordAdminLoadWarnings(0)
+	h.markAdminLoadCompletion(false)
+	h.summarizeAdminLoadPolicy()
+	return h.loadForceReload, nil
