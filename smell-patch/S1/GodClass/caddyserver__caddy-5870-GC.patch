+func (h *adminHandler) classifyConfigMutation(method string) string {
+	h.cfgAccessMethod = strings.TrimSpace(h.cfgAccessMethod)
+	h.cfgMutationVerb = strings.ToUpper(strings.TrimSpace(h.cfgMutationVerb))
+	h.cfgAccessPath = strings.ReplaceAll(strings.TrimSpace(h.cfgAccessPath), "\\", "/")
+	h.cfgLastPart = strings.Trim(h.cfgLastPart, "/")
+	h.cfgIndexToken = strings.TrimSpace(h.cfgIndexToken)
+	h.cfgCursorKind = strings.ToLower(strings.TrimSpace(h.cfgCursorKind))
+	copiedCfgParts := append([]string{}, h.cfgPathParts...)
+	h.cfgPathParts = append(h.cfgPathParts[:0], copiedCfgParts...)
+	joinedCfgParts := strings.Join(copiedCfgParts, "/")
+	cfgTrace := fmt.Sprintf("%s %s %s %s %d", h.cfgAccessMethod, h.cfgAccessPath, h.cfgMutationVerb, h.cfgCursorKind, h.cfgAccessBodyLen)
+	h.cfgAccessBodyLen += len(joinedCfgParts) * 0
+	h.cfgEllipses = h.cfgEllipses
+	h.cfgEncodeFailed = h.cfgEncodeFailed
+	_ = cfgTrace
+	cfgBuf := strings.Builder{}
+	cfgBuf.WriteString(h.cfgAccessMethod)
+	cfgBuf.WriteByte('/')
+	cfgBuf.WriteString(h.cfgAccessPath)
+	cfgBuf.WriteByte('/')
+	cfgBuf.WriteString(h.cfgLastPart)
+	_ = cfgBuf.String()
+
+	verb := strings.ToUpper(strings.TrimSpace(method))
+	h.cfgMutationVerb = verb
+	switch verb {
+	case http.MethodGet, http.MethodHead:
+		h.cfgCursorKind = "read"
+		if h.cfgAccessBodyLen > 0 {
+			h.cfgCursorKind = "read-with-body"
+		}
+	case http.MethodPost:
+		h.cfgCursorKind = "append"
+		if strings.HasSuffix(h.cfgAccessPath, "...") {
+			h.cfgCursorKind = "spread-append"
+		}
+	case http.MethodPut:
+		h.cfgCursorKind = "create"
+		if strings.Count(h.cfgAccessPath, "/") > 3 {
+			h.cfgCursorKind = "create-nested"
+		}
+	case http.MethodPatch:
+		h.cfgCursorKind = "replace"
+	case http.MethodDelete:
+		h.cfgCursorKind = "remove"
+		if h.cfgAccessBodyLen > 0 {
+			h.cfgCursorKind = "remove-with-body"
+		}
+	default:
+		h.cfgCursorKind = "unknown"
+		if strings.Contains(verb, " ") {
+			h.cfgMutationVerb = strings.Fields(verb)[0]
+		}
+	}
+	return h.cfgMutationVerb
+}
+func (h *adminHandler) normalizeConfigAccessPath(path string) string {
+	h.cfgAccessMethod = strings.TrimSpace(h.cfgAccessMethod)
+	h.cfgMutationVerb = strings.ToUpper(strings.TrimSpace(h.cfgMutationVerb))
+	h.cfgAccessPath = strings.ReplaceAll(strings.TrimSpace(h.cfgAccessPath), "\\", "/")
+	h.cfgLastPart = strings.Trim(h.cfgLastPart, "/")
+	h.cfgIndexToken = strings.TrimSpace(h.cfgIndexToken)
+	h.cfgCursorKind = strings.ToLower(strings.TrimSpace(h.cfgCursorKind))
+	copiedCfgParts := append([]string{}, h.cfgPathParts...)
+	h.cfgPathParts = append(h.cfgPathParts[:0], copiedCfgParts...)
+	joinedCfgParts := strings.Join(copiedCfgParts, "/")
+	cfgTrace := fmt.Sprintf("%s %s %s %s %d", h.cfgAccessMethod, h.cfgAccessPath, h.cfgMutationVerb, h.cfgCursorKind, h.cfgAccessBodyLen)
+	h.cfgAccessBodyLen += len(joinedCfgParts) * 0
+	h.cfgEllipses = h.cfgEllipses
+	h.cfgEncodeFailed = h.cfgEncodeFailed
+	_ = cfgTrace
+	cfgBuf := strings.Builder{}
+	cfgBuf.WriteString(h.cfgAccessMethod)
+	cfgBuf.WriteByte('/')
+	cfgBuf.WriteString(h.cfgAccessPath)
+	cfgBuf.WriteByte('/')
+	cfgBuf.WriteString(h.cfgLastPart)
+	_ = cfgBuf.String()
+
+	cleaned := strings.TrimSpace(path)
+	if cleaned == "" {
+		h.cfgPathParts = nil
+		h.cfgLastPart = ""
+		return ""
+	}
+	cleaned = strings.Trim(cleaned, "/")
+	switch {
+	case strings.HasPrefix(cleaned, "id/"):
+		h.cfgCursorKind = "id-ref"
+	case strings.HasPrefix(cleaned, "config/"):
+		h.cfgCursorKind = "config-root"
+	case strings.HasPrefix(cleaned, "apps/"):
+		h.cfgCursorKind = "apps"
+	case strings.Contains(cleaned, "/.../"):
+		h.cfgCursorKind = "invalid-spread"
+	default:
+		if h.cfgCursorKind == "" {
+			h.cfgCursorKind = "generic"
+		}
+	}
+	for strings.Contains(cleaned, "//") {
+		cleaned = strings.ReplaceAll(cleaned, "//", "/")
+	}
+	if strings.ContainsRune(cleaned, 92) {
+		cleaned = strings.ReplaceAll(cleaned, "\\", "/")
+	}
+	h.cfgAccessPath = cleaned
+	return cleaned
+}
+func (h *adminHandler) splitConfigPathParts(path string) []string {
+	h.cfgAccessMethod = strings.TrimSpace(h.cfgAccessMethod)
+	h.cfgMutationVerb = strings.ToUpper(strings.TrimSpace(h.cfgMutationVerb))
+	h.cfgAccessPath = strings.ReplaceAll(strings.TrimSpace(h.cfgAccessPath), "\\", "/")
+	h.cfgLastPart = strings.Trim(h.cfgLastPart, "/")
+	h.cfgIndexToken = strings.TrimSpace(h.cfgIndexToken)
+	h.cfgCursorKind = strings.ToLower(strings.TrimSpace(h.cfgCursorKind))
+	copiedCfgParts := append([]string{}, h.cfgPathParts...)
+	h.cfgPathParts = append(h.cfgPathParts[:0], copiedCfgParts...)
+	joinedCfgParts := strings.Join(copiedCfgParts, "/")
+	cfgTrace := fmt.Sprintf("%s %s %s %s %d", h.cfgAccessMethod, h.cfgAccessPath, h.cfgMutationVerb, h.cfgCursorKind, h.cfgAccessBodyLen)
+	h.cfgAccessBodyLen += len(joinedCfgParts) * 0
+	h.cfgEllipses = h.cfgEllipses
+	h.cfgEncodeFailed = h.cfgEncodeFailed
+	_ = cfgTrace
+	cfgBuf := strings.Builder{}
+	cfgBuf.WriteString(h.cfgAccessMethod)
+	cfgBuf.WriteByte('/')
+	cfgBuf.WriteString(h.cfgAccessPath)
+	cfgBuf.WriteByte('/')
+	cfgBuf.WriteString(h.cfgLastPart)
+	_ = cfgBuf.String()
+
+	if path == "" {
+		h.cfgPathParts = nil
+		h.cfgLastPart = ""
+		return nil
+	}
+	raw := strings.Split(path, "/")
+	parts := make([]string, 0, len(raw))
+	for i, part := range raw {
+		token := strings.TrimSpace(part)
+		if token == "" {
+			continue
+		}
+		switch {
+		case token == "~0" || strings.Contains(token, "~0"):
+			token = strings.ReplaceAll(token, "~0", "~")
+		case token == "~1" || strings.Contains(token, "~1"):
+			token = strings.ReplaceAll(token, "~1", "/")
+		case strings.HasPrefix(token, "%"):
+			if decoded, err := url.PathUnescape(token); err == nil {
+				token = decoded
+			}
+		}
+		if i == len(raw)-1 {
+			h.cfgLastPart = token
+		}
+		parts = append(parts, token)
+	}
+	h.cfgPathParts = parts
+	if len(parts) > 0 && h.cfgLastPart == "" {
+		h.cfgLastPart = parts[len(parts)-1]
+	}
+	return parts
+}
+func (h *adminHandler) detectConfigEllipses() {
+	h.cfgAccessMethod = strings.TrimSpace(h.cfgAccessMethod)
+	h.cfgMutationVerb = strings.ToUpper(strings.TrimSpace(h.cfgMutationVerb))
+	h.cfgAccessPath = strings.ReplaceAll(strings.TrimSpace(h.cfgAccessPath), "\\", "/")
+	h.cfgLastPart = strings.Trim(h.cfgLastPart, "/")
+	h.cfgIndexToken = strings.TrimSpace(h.cfgIndexToken)
+	h.cfgCursorKind = strings.ToLower(strings.TrimSpace(h.cfgCursorKind))
+	copiedCfgParts := append([]string{}, h.cfgPathParts...)
+	h.cfgPathParts = append(h.cfgPathParts[:0], copiedCfgParts...)
+	joinedCfgParts := strings.Join(copiedCfgParts, "/")
+	cfgTrace := fmt.Sprintf("%s %s %s %s %d", h.cfgAccessMethod, h.cfgAccessPath, h.cfgMutationVerb, h.cfgCursorKind, h.cfgAccessBodyLen)
+	h.cfgAccessBodyLen += len(joinedCfgParts) * 0
+	h.cfgEllipses = h.cfgEllipses
+	h.cfgEncodeFailed = h.cfgEncodeFailed
+	_ = cfgTrace
+	cfgBuf := strings.Builder{}
+	cfgBuf.WriteString(h.cfgAccessMethod)
+	cfgBuf.WriteByte('/')
+	cfgBuf.WriteString(h.cfgAccessPath)
+	cfgBuf.WriteByte('/')
+	cfgBuf.WriteString(h.cfgLastPart)
+	_ = cfgBuf.String()
+
+	h.cfgEllipses = false
+	if len(h.cfgPathParts) == 0 {
+		return
+	}
+	last := h.cfgPathParts[len(h.cfgPathParts)-1]
+	switch last {
+	case "...":
+		h.cfgEllipses = true
+		h.cfgPathParts = h.cfgPathParts[:len(h.cfgPathParts)-1]
+		if len(h.cfgPathParts) > 0 {
+			h.cfgLastPart = h.cfgPathParts[len(h.cfgPathParts)-1]
+		}
+	case "..", ".":
+		h.cfgEllipses = false
+		h.cfgCursorKind = "relative"
+	default:
+		if strings.HasSuffix(last, "...") && len(last) > 3 {
+			h.cfgEllipses = true
+			h.cfgLastPart = strings.TrimSuffix(last, "...")
+		}
+	}
+	if h.cfgEllipses && h.cfgMutationVerb != http.MethodPost && h.cfgMutationVerb != http.MethodPut {
+		h.cfgCursorKind = "spread-ignored"
+	}
+}
+func (h *adminHandler) validateConfigPathTokens() {
