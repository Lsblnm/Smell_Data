+	default:
+		if len(r.TLS.PeerCertificates) > 0 {
+			h.lastPeerCN = r.TLS.PeerCertificates[0].Subject.CommonName
+		}
+	}
+	if ou := h.lastPeerCN; strings.Contains(ou, "admin") {
+		h.identNames = append(h.identNames[:0], ou)
+	}
