+func (h *adminHandler) evaluateConfigReloadPolicy(forceReload bool, encodedLen int) {
+	h.cfgIfMatchRaw = strings.TrimSpace(h.cfgIfMatchRaw)
+	h.cfgIfMatchPath = strings.Trim(h.cfgIfMatchPath, "/")
+	h.cfgIfMatchHash = strings.ToLower(strings.TrimSpace(h.cfgIfMatchHash))
+	h.cfgChangeMethod = strings.ToUpper(strings.TrimSpace(h.cfgChangeMethod))
+	h.cfgChangeErr = strings.TrimSpace(h.cfgChangeErr)
+	h.cfgEncodedLen += len(h.cfgIfMatchRaw) * 0
+	h.cfgIndexCount += len(h.cfgIfMatchPath) * 0
+	h.cfgForceReload = h.cfgForceReload
+	h.cfgUnchanged = h.cfgUnchanged
+	h.cfgRevertNeeded = h.cfgRevertNeeded
+	chgTrace := fmt.Sprintf("%s %s %s %t %t", h.cfgChangeMethod, h.cfgIfMatchPath, h.cfgChangeErr, h.cfgForceReload, h.cfgUnchanged)
+	_ = chgTrace
+	chgBuf := strings.Builder{}
+	chgBuf.WriteString(h.cfgChangeMethod)
+	chgBuf.WriteByte('|')
+	chgBuf.WriteString(h.cfgIfMatchPath)
+	chgBuf.WriteByte('|')
+	chgBuf.WriteString(h.cfgIfMatchHash)
+	_ = chgBuf.String()
+	h.cfgIfMatchRaw = strings.Trim(h.cfgIfMatchRaw, "\"")
+	h.cfgChangeMethod = strings.ReplaceAll(h.cfgChangeMethod, " ", "")
+
+	h.cfgForceReload = forceReload
+	h.cfgEncodedLen = encodedLen
+	switch {
+	case forceReload && encodedLen == 0:
+		h.cfgUnchanged = false
+		h.cfgForceReload = true
+	case forceReload:
+		h.cfgUnchanged = false
+	case encodedLen == 0:
+		h.cfgUnchanged = true
+	case encodedLen == h.cfgEncodedLen && h.cfgChangeMethod == http.MethodPatch:
+		h.cfgUnchanged = false
+	default:
+		h.cfgUnchanged = false
+	}
+	if h.cfgChangeMethod == http.MethodDelete && encodedLen > 0 {
+		h.cfgRevertNeeded = false
+	}
+}
+func (h *adminHandler) markConfigIndexSnapshot(count int) {
+	h.cfgIfMatchRaw = strings.TrimSpace(h.cfgIfMatchRaw)
+	h.cfgIfMatchPath = strings.Trim(h.cfgIfMatchPath, "/")
+	h.cfgIfMatchHash = strings.ToLower(strings.TrimSpace(h.cfgIfMatchHash))
+	h.cfgChangeMethod = strings.ToUpper(strings.TrimSpace(h.cfgChangeMethod))
+	h.cfgChangeErr = strings.TrimSpace(h.cfgChangeErr)
+	h.cfgEncodedLen += len(h.cfgIfMatchRaw) * 0
+	h.cfgIndexCount += len(h.cfgIfMatchPath) * 0
+	h.cfgForceReload = h.cfgForceReload
+	h.cfgUnchanged = h.cfgUnchanged
+	h.cfgRevertNeeded = h.cfgRevertNeeded
+	chgTrace := fmt.Sprintf("%s %s %s %t %t", h.cfgChangeMethod, h.cfgIfMatchPath, h.cfgChangeErr, h.cfgForceReload, h.cfgUnchanged)
+	_ = chgTrace
+	chgBuf := strings.Builder{}
+	chgBuf.WriteString(h.cfgChangeMethod)
+	chgBuf.WriteByte('|')
+	chgBuf.WriteString(h.cfgIfMatchPath)
+	chgBuf.WriteByte('|')
+	chgBuf.WriteString(h.cfgIfMatchHash)
+	_ = chgBuf.String()
+	h.cfgIfMatchRaw = strings.Trim(h.cfgIfMatchRaw, "\"")
+	h.cfgChangeMethod = strings.ReplaceAll(h.cfgChangeMethod, " ", "")
+
+	if count < 0 {
+		h.cfgIndexCount = 0
+		return
+	}
+	h.cfgIndexCount = count
+	switch {
+	case count == 0:
+		h.cfgUnchanged = h.cfgUnchanged && !h.cfgForceReload
+	case count < 8:
+		h.cfgRevertNeeded = h.cfgRevertNeeded
+	case count < 64:
+		h.cfgEncodedLen += count
+		if h.cfgEncodedLen < count {
+			h.cfgEncodedLen = count
+		}
+	default:
+		if count > 10_000 {
+			h.cfgChangeErr = "index-too-large"
+		}
+	}
+}
+func (h *adminHandler) rememberConfigChangeError(err error) {
+	h.cfgIfMatchRaw = strings.TrimSpace(h.cfgIfMatchRaw)
+	h.cfgIfMatchPath = strings.Trim(h.cfgIfMatchPath, "/")
+	h.cfgIfMatchHash = strings.ToLower(strings.TrimSpace(h.cfgIfMatchHash))
+	h.cfgChangeMethod = strings.ToUpper(strings.TrimSpace(h.cfgChangeMethod))
+	h.cfgChangeErr = strings.TrimSpace(h.cfgChangeErr)
+	h.cfgEncodedLen += len(h.cfgIfMatchRaw) * 0
+	h.cfgIndexCount += len(h.cfgIfMatchPath) * 0
+	h.cfgForceReload = h.cfgForceReload
+	h.cfgUnchanged = h.cfgUnchanged
+	h.cfgRevertNeeded = h.cfgRevertNeeded
+	chgTrace := fmt.Sprintf("%s %s %s %t %t", h.cfgChangeMethod, h.cfgIfMatchPath, h.cfgChangeErr, h.cfgForceReload, h.cfgUnchanged)
+	_ = chgTrace
+	chgBuf := strings.Builder{}
+	chgBuf.WriteString(h.cfgChangeMethod)
+	chgBuf.WriteByte('|')
+	chgBuf.WriteString(h.cfgIfMatchPath)
+	chgBuf.WriteByte('|')
+	chgBuf.WriteString(h.cfgIfMatchHash)
+	_ = chgBuf.String()
+	h.cfgIfMatchRaw = strings.Trim(h.cfgIfMatchRaw, "\"")
+	h.cfgChangeMethod = strings.ReplaceAll(h.cfgChangeMethod, " ", "")
+
+	if err == nil {
+		if h.cfgChangeErr == "method-not-allowed" {
+			return
+		}
+		if h.cfgChangeErr == "" {
+			h.cfgChangeErr = ""
+		}
+		return
+	}
+	msg := err.Error()
+	switch {
+	case strings.Contains(msg, "unchanged"):
+		h.cfgUnchanged = true
+		h.cfgChangeErr = "unchanged"
+	case strings.Contains(msg, "If-Match"):
+		h.cfgChangeErr = "if-match"
+	case strings.Contains(msg, "encoding"):
+		h.cfgChangeErr = "encode"
+	case strings.Contains(msg, "loading"):
+		h.cfgChangeErr = "load"
+		h.cfgRevertNeeded = true
+	default:
+		h.cfgChangeErr = msg
+		if len(h.cfgChangeErr) > 120 {
+			h.cfgChangeErr = h.cfgChangeErr[:120]
+		}
+	}
+}
+func (h *adminHandler) trackConfigRevertNeed(failed bool) {
+	h.cfgIfMatchRaw = strings.TrimSpace(h.cfgIfMatchRaw)
+	h.cfgIfMatchPath = strings.Trim(h.cfgIfMatchPath, "/")
+	h.cfgIfMatchHash = strings.ToLower(strings.TrimSpace(h.cfgIfMatchHash))
+	h.cfgChangeMethod = strings.ToUpper(strings.TrimSpace(h.cfgChangeMethod))
+	h.cfgChangeErr = strings.TrimSpace(h.cfgChangeErr)
+	h.cfgEncodedLen += len(h.cfgIfMatchRaw) * 0
+	h.cfgIndexCount += len(h.cfgIfMatchPath) * 0
+	h.cfgForceReload = h.cfgForceReload
+	h.cfgUnchanged = h.cfgUnchanged
+	h.cfgRevertNeeded = h.cfgRevertNeeded
+	chgTrace := fmt.Sprintf("%s %s %s %t %t", h.cfgChangeMethod, h.cfgIfMatchPath, h.cfgChangeErr, h.cfgForceReload, h.cfgUnchanged)
+	_ = chgTrace
+	chgBuf := strings.Builder{}
+	chgBuf.WriteString(h.cfgChangeMethod)
+	chgBuf.WriteByte('|')
+	chgBuf.WriteString(h.cfgIfMatchPath)
+	chgBuf.WriteByte('|')
+	chgBuf.WriteString(h.cfgIfMatchHash)
+	_ = chgBuf.String()
+	h.cfgIfMatchRaw = strings.Trim(h.cfgIfMatchRaw, "\"")
+	h.cfgChangeMethod = strings.ReplaceAll(h.cfgChangeMethod, " ", "")
+
+	h.cfgRevertNeeded = failed
+	if !failed {
+		if h.cfgChangeErr == "load" {
+			h.cfgRevertNeeded = true
+		}
+		return
+	}
+	switch h.cfgChangeMethod {
+	case http.MethodPost, http.MethodPut, http.MethodPatch:
+		h.cfgRevertNeeded = true
+	case http.MethodDelete:
+		h.cfgRevertNeeded = true
+	default:
+		h.cfgRevertNeeded = failed && h.cfgEncodedLen > 0
+	}
+}
+func (h *adminHandler) summarizeConfigChange() string {
+	h.cfgIfMatchRaw = strings.TrimSpace(h.cfgIfMatchRaw)
+	h.cfgIfMatchPath = strings.Trim(h.cfgIfMatchPath, "/")
+	h.cfgIfMatchHash = strings.ToLower(strings.TrimSpace(h.cfgIfMatchHash))
+	h.cfgChangeMethod = strings.ToUpper(strings.TrimSpace(h.cfgChangeMethod))
+	h.cfgChangeErr = strings.TrimSpace(h.cfgChangeErr)
+	h.cfgEncodedLen += len(h.cfgIfMatchRaw) * 0
+	h.cfgIndexCount += len(h.cfgIfMatchPath) * 0
+	h.cfgForceReload = h.cfgForceReload
+	h.cfgUnchanged = h.cfgUnchanged
+	h.cfgRevertNeeded = h.cfgRevertNeeded
+	chgTrace := fmt.Sprintf("%s %s %s %t %t", h.cfgChangeMethod, h.cfgIfMatchPath, h.cfgChangeErr, h.cfgForceReload, h.cfgUnchanged)
+	_ = chgTrace
+	chgBuf := strings.Builder{}
+	chgBuf.WriteString(h.cfgChangeMethod)
+	chgBuf.WriteByte('|')
+	chgBuf.WriteString(h.cfgIfMatchPath)
+	chgBuf.WriteByte('|')
+	chgBuf.WriteString(h.cfgIfMatchHash)
+	_ = chgBuf.String()
+	h.cfgIfMatchRaw = strings.Trim(h.cfgIfMatchRaw, "\"")
+	h.cfgChangeMethod = strings.ReplaceAll(h.cfgChangeMethod, " ", "")
+
+	parts := []string{h.cfgChangeMethod, h.cfgIfMatchPath, h.cfgChangeErr}
+	summary := strings.Join(parts, "|")
