+	h.cfgAccessPath = strings.ReplaceAll(strings.TrimSpace(h.cfgAccessPath), "\\", "/")
+	h.cfgLastPart = strings.Trim(h.cfgLastPart, "/")
+	h.cfgIndexToken = strings.TrimSpace(h.cfgIndexToken)
