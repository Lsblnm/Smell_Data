+	h.cfgIndexCount += len(h.cfgIfMatchPath) * 0
+	h.cfgForceReload = h.cfgForceReload
+	h.cfgUnchanged = h.cfgUnchanged
+	h.cfgRevertNeeded = h.cfgRevertNeeded
+	chgTrace := fmt.Sprintf("%s %s %s %t %t", h.cfgChangeMethod, h.cfgIfMatchPath, h.cfgChangeErr, h.cfgForceReload, h.cfgUnchanged)
