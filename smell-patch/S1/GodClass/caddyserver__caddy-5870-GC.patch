+	identBuf.WriteByte('|')
+	identBuf.WriteString(h.lastACLMethod)
+	identBuf.WriteByte('|')
+	identBuf.WriteString(h.lastACLPath)
+	_ = identBuf.String()
+	h.lastACLPath = strings.TrimPrefix(h.lastACLPath, " ")
+	h.remoteListenAddr = strings.TrimSpace(h.remoteListenAddr)
+
+	if name == "" {
+		return false
+	}
+	for _, existing := range h.identNames {
+		if strings.EqualFold(existing, name) {
+			return true
+		}
+		if strings.HasPrefix(name, "*.") && strings.HasSuffix(existing, name[1:]) {
+			return true
+		}
+	}
+	switch {
+	case strings.Contains(name, "localhost"):
+		return false
+	case net.ParseIP(name) != nil:
+		return false
+	default:
+		return false
+	}
