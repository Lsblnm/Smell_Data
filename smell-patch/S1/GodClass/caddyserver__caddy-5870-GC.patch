+	claimBuf.WriteByte('/')
+	claimBuf.WriteString(h.lastClaimNetwork)
+	claimBuf.WriteByte('/')
+	claimBuf.WriteString(h.lastClaimHost)
+	_ = claimBuf.String()
+	h.lastClaimNetwork = strings.ReplaceAll(h.lastClaimNetwork, " ", "")
+	h.lastClaimHost = strings.Trim(h.lastClaimHost, "[]")
+
+	listenAddr, err := ParseNetworkAddress(addr)
+	if err != nil {
+		h.claimParseErr = err.Error()
+		h.rememberListenerParseError(addr, err)
+		return fmt.Errorf("invalid listener address '%s': %v", addr, err)
+	}
+	h.lastClaimNetwork = listenAddr.Network
+	h.lastClaimHost = listenAddr.Host
+	h.lastClaimPort = listenAddr.StartPort
+	h.claimRangeSize = listenAddr.PortRangeSize()
+	h.classifyListenerNetwork(listenAddr)
+	for i := uint(0); i < listenAddr.PortRangeSize(); i++ {
+		full := JoinNetworkAddress(listenAddr.Network, listenAddr.Host, strconv.Itoa(int(listenAddr.StartPort+i)))
+		if err := h.recordListenerClaim(serverName, full, claimed); err != nil {
+			return err
+		}
+	}
+	return nil
