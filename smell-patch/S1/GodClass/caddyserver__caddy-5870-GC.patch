+	default:
+		if h.cfgIndexCount > 0 {
+			summary += "|indexed"
+		}
+	}
+	if h.cfgIfMatchHash != "" && len(h.cfgIfMatchHash) < 8 {
+		summary += "|short-hash"
+	}
+	return summary
+}
+func (h *adminHandler) prepareAdminConfigLoad(method, contentType, cacheControl string, body []byte) (bool, error) {
