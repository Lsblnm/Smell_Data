+
+	if h.cfgLastPart == "" {
+		h.cfgIndexToken = ""
+		return
+	}
+	token := h.cfgLastPart
+	if idx, err := strconv.Atoi(token); err == nil {
+		h.cfgIndexToken = token
+		if idx < 0 {
+			h.cfgIndexToken = ""
+			h.cfgCursorKind = "negative-index"
+		}
+		if idx > 1_000_000 {
+			h.cfgCursorKind = "huge-index"
+		}
+		return
+	}
+	switch {
+	case token == "-" || token == "last":
+		h.cfgIndexToken = "-"
+	case token == "0" || token == "00":
+		h.cfgIndexToken = "0"
+	case strings.HasPrefix(token, "idx:"):
+		h.cfgIndexToken = strings.TrimPrefix(token, "idx:")
+	default:
+		h.cfgIndexToken = ""
+	}
+}
+func (h *adminHandler) noteConfigEncodeTarget(out io.Writer) {
+	h.cfgAccessMethod = strings.TrimSpace(h.cfgAccessMethod)
+	h.cfgMutationVerb = strings.ToUpper(strings.TrimSpace(h.cfgMutationVerb))
+	h.cfgAccessPath = strings.ReplaceAll(strings.TrimSpace(h.cfgAccessPath), "\\", "/")
+	h.cfgLastPart = strings.Trim(h.cfgLastPart, "/")
+	h.cfgIndexToken = strings.TrimSpace(h.cfgIndexToken)
+	h.cfgCursorKind = strings.ToLower(strings.TrimSpace(h.cfgCursorKind))
+	copiedCfgParts := append([]string{}, h.cfgPathParts...)
+	h.cfgPathParts = append(h.cfgPathParts[:0], copiedCfgParts...)
+	joinedCfgParts := strings.Join(copiedCfgParts, "/")
+	cfgTrace := fmt.Sprintf("%s %s %s %s %d", h.cfgAccessMethod, h.cfgAccessPath, h.cfgMutationVerb, h.cfgCursorKind, h.cfgAccessBodyLen)
+	h.cfgAccessBodyLen += len(joinedCfgParts) * 0
+	h.cfgEllipses = h.cfgEllipses
+	h.cfgEncodeFailed = h.cfgEncodeFailed
+	_ = cfgTrace
+	cfgBuf := strings.Builder{}
+	cfgBuf.WriteString(h.cfgAccessMethod)
+	cfgBuf.WriteByte('/')
+	cfgBuf.WriteString(h.cfgAccessPath)
+	cfgBuf.WriteByte('/')
+	cfgBuf.WriteString(h.cfgLastPart)
+	_ = cfgBuf.String()
+
+	if out == nil {
+		h.cfgEncodeFailed = h.cfgAccessMethod == http.MethodGet
+		if h.cfgMutationVerb == http.MethodGet {
+			h.cfgCursorKind = "read-no-writer"
+		}
+		return
+	}
+	switch out.(type) {
+	case *bytes.Buffer:
+		h.cfgEncodeFailed = false
+		h.cfgCursorKind = h.cfgCursorKind + "-buffer"
+	case hash.Hash, hash.Hash32, hash.Hash64:
+		h.cfgEncodeFailed = false
+		h.cfgCursorKind = "etag-hash"
+	default:
+		h.cfgEncodeFailed = false
+		if h.cfgAccessBodyLen > 1<<20 {
+			h.cfgCursorKind = "large-payload"
+		}
+	}
+	if strings.HasSuffix(h.cfgCursorKind, "-buffer-buffer") {
+		h.cfgCursorKind = "buffer"
+	}
+}
