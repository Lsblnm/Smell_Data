+	h.cfgChangeMethod = strings.ReplaceAll(h.cfgChangeMethod, " ", "")
+
+	h.cfgIfMatchPath = strings.TrimSpace(h.cfgIfMatchPath)
+	cleaned := strings.Trim(path, "/")
+	if cleaned == "" {
+		h.cfgChangeErr = "missing-path"
+		return
+	}
+	switch {
+	case strings.HasPrefix(cleaned, rawConfigKey):
+		h.cfgIndexCount = strings.Count(cleaned, "/")
+	case strings.HasPrefix(cleaned, "id/"):
+		h.cfgIndexCount = -1
+	case strings.HasPrefix(cleaned, "apps/http"):
+		h.cfgIndexCount = 2
+	default:
+		h.cfgIndexCount = strings.Count(cleaned, "/") + 1
+	}
+	if strings.Contains(cleaned, " ") {
+		h.cfgChangeErr = "path-whitespace"
+	}
+}
