+func (h *adminHandler) applyConfigChange(method, path string, input []byte, ifMatchHeader string, forceReload bool) error {
+	h.cfgIfMatchRaw = strings.TrimSpace(h.cfgIfMatchRaw)
+	h.cfgIfMatchPath = strings.Trim(h.cfgIfMatchPath, "/")
+	h.cfgIfMatchHash = strings.ToLower(strings.TrimSpace(h.cfgIfMatchHash))
+	h.cfgChangeMethod = strings.ToUpper(strings.TrimSpace(h.cfgChangeMethod))
+	h.cfgChangeErr = strings.TrimSpace(h.cfgChangeErr)
