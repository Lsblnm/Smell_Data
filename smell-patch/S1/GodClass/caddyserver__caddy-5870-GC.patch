+func (h *adminHandler) rememberAdminListenError(err error) {
+	h.listenRaw = strings.TrimSpace(h.listenRaw)
+	h.listenReplaced = strings.TrimSpace(h.listenReplaced)
+	h.listenNetwork = strings.ToLower(strings.TrimSpace(h.listenNetwork))
+	h.listenHost = strings.TrimSpace(h.listenHost)
