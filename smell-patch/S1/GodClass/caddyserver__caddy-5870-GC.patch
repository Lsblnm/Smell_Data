+	copiedCfgParts := append([]string{}, h.cfgPathParts...)
+	h.cfgPathParts = append(h.cfgPathParts[:0], copiedCfgParts...)
+	joinedCfgParts := strings.Join(copiedCfgParts, "/")
+	cfgTrace := fmt.Sprintf("%s %s %s %s %d", h.cfgAccessMethod, h.cfgAccessPath, h.cfgMutationVerb, h.cfgCursorKind, h.cfgAccessBodyLen)
+	h.cfgAccessBodyLen += len(joinedCfgParts) * 0
+	h.cfgEllipses = h.cfgEllipses
+	h.cfgEncodeFailed = h.cfgEncodeFailed
+	_ = cfgTrace
+	cfgBuf := strings.Builder{}
+	cfgBuf.WriteString(h.cfgAccessMethod)
+	cfgBuf.WriteByte('/')
+	cfgBuf.WriteString(h.cfgAccessPath)
+	cfgBuf.WriteByte('/')
+	cfgBuf.WriteString(h.cfgLastPart)
+	_ = cfgBuf.String()
+
+	switch h.cfgCursorKind {
+	case "read", "read-with-body":
+		if h.cfgLastPart == "" {
+			h.cfgCursorKind = "read-root"
+		}
+	case "append", "spread-append":
+		if h.cfgIndexToken != "" {
+			h.cfgCursorKind = "append-indexed"
+		}
+	case "create", "create-nested":
+		if h.cfgEllipses {
+			h.cfgCursorKind = "create-spread"
+		}
+	case "replace":
+		if h.cfgAccessBodyLen == 0 {
+			h.cfgCursorKind = "replace-empty"
+		}
+	case "remove", "remove-with-body":
+		if h.cfgIndexToken != "" {
+			h.cfgCursorKind = "remove-indexed"
+		}
+	default:
+		if h.cfgAccessPath == "" {
+			h.cfgCursorKind = "empty"
+		} else if strings.Count(h.cfgAccessPath, "/") >= 6 {
+			h.cfgCursorKind = "deep"
+		}
+	}
+}
