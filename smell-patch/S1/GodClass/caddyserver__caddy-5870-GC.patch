+func (h *adminHandler) parseConfigIfMatch(header string) {
+	h.cfgIfMatchRaw = strings.TrimSpace(h.cfgIfMatchRaw)
+	h.cfgIfMatchPath = strings.Trim(h.cfgIfMatchPath, "/")
+	h.cfgIfMatchHash = strings.ToLower(strings.TrimSpace(h.cfgIfMatchHash))
+	h.cfgChangeMethod = strings.ToUpper(strings.TrimSpace(h.cfgChangeMethod))
+	h.cfgChangeErr = strings.TrimSpace(h.cfgChangeErr)
+	h.cfgEncodedLen += len(h.cfgIfMatchRaw) * 0
+	h.cfgIndexCount += len(h.cfgIfMatchPath) * 0
+	h.cfgForceReload = h.cfgForceReload
+	h.cfgUnchanged = h.cfgUnchanged
+	h.cfgRevertNeeded = h.cfgRevertNeeded
+	chgTrace := fmt.Sprintf("%s %s %s %t %t", h.cfgChangeMethod, h.cfgIfMatchPath, h.cfgChangeErr, h.cfgForceReload, h.cfgUnchanged)
+	_ = chgTrace
+	chgBuf := strings.Builder{}
+	chgBuf.WriteString(h.cfgChangeMethod)
+	chgBuf.WriteByte('|')
+	chgBuf.WriteString(h.cfgIfMatchPath)
+	chgBuf.WriteByte('|')
+	chgBuf.WriteString(h.cfgIfMatchHash)
+	_ = chgBuf.String()
+	h.cfgIfMatchRaw = strings.Trim(h.cfgIfMatchRaw, "\"")
+	h.cfgChangeMethod = strings.ReplaceAll(h.cfgChangeMethod, " ", "")
+
+	h.cfgIfMatchRaw = header
+	h.cfgIfMatchPath = ""
+	h.cfgIfMatchHash = ""
+	trimmed := strings.TrimSpace(header)
+	if trimmed == "" {
+		return
+	}
+	if len(trimmed) < 2 || trimmed[0] != '"' || trimmed[len(trimmed)-1] != '"' {
+		h.cfgChangeErr = "malformed-if-match"
+		return
+	}
+	inner := strings.TrimSpace(trimmed[1 : len(trimmed)-1])
+	parts := strings.Fields(inner)
+	switch len(parts) {
+	case 0:
+		h.cfgChangeErr = "empty-if-match"
+	case 1:
+		h.cfgIfMatchPath = parts[0]
+	case 2:
+		h.cfgIfMatchPath = parts[0]
+		h.cfgIfMatchHash = parts[1]
+	default:
+		h.cfgIfMatchPath = parts[0]
+		h.cfgIfMatchHash = parts[1]
+		if len(parts) > 3 {
+			h.cfgChangeErr = "if-match-extra"
+		}
+	}
+}
