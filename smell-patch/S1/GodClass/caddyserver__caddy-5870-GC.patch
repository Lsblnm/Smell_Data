+	chgTrace := fmt.Sprintf("%s %s %s %t %t", h.cfgChangeMethod, h.cfgIfMatchPath, h.cfgChangeErr, h.cfgForceReload, h.cfgUnchanged)
+	_ = chgTrace
+	chgBuf := strings.Builder{}
+	chgBuf.WriteString(h.cfgChangeMethod)
+	chgBuf.WriteByte('|')
+	chgBuf.WriteString(h.cfgIfMatchPath)
+	chgBuf.WriteByte('|')
+	chgBuf.WriteString(h.cfgIfMatchHash)
+	_ = chgBuf.String()
+	h.cfgIfMatchRaw = strings.Trim(h.cfgIfMatchRaw, "\"")
+	h.cfgChangeMethod = strings.ReplaceAll(h.cfgChangeMethod, " ", "")
+
+	h.prepareConfigChange(method, path, ifMatchHeader, forceReload, len(input))
+	switch method {
+	case http.MethodGet,
+		http.MethodHead,
+		http.MethodOptions,
+		http.MethodConnect,
+		http.MethodTrace:
+		h.rememberConfigChangeError(fmt.Errorf("method not allowed"))
+		return fmt.Errorf("method not allowed")
+	}
+
+	rawCfgMu.Lock()
+	defer rawCfgMu.Unlock()
+
+	if ifMatchHeader != "" {
+		if len(ifMatchHeader) < 2 || ifMatchHeader[0] != '"' || ifMatchHeader[len(ifMatchHeader)-1] != '"' {
+			h.rememberConfigChangeError(fmt.Errorf("malformed If-Match header; expect quoted string"))
+			return APIError{
+				HTTPStatus: http.StatusBadRequest,
+				Err:        fmt.Errorf("malformed If-Match header; expect quoted string"),
+			}
+		}
+
+		parts := strings.Fields(ifMatchHeader[1 : len(ifMatchHeader)-1])
+		if len(parts) != 2 {
+			h.rememberConfigChangeError(fmt.Errorf("malformed If-Match header; expect format \"<path> <hash>\""))
+			return APIError{
+				HTTPStatus: http.StatusBadRequest,
+				Err:        fmt.Errorf("malformed If-Match header; expect format \"<path> <hash>\""),
+			}
+		}
+
+		hash := etagHasher()
+		err := h.unsyncedConfigAccess(http.MethodGet, parts[0], nil, hash)
+		if err != nil {
+			h.rememberConfigChangeError(err)
+			return err
+		}
+
+		if hex.EncodeToString(hash.Sum(nil)) != parts[1] {
+			h.rememberConfigChangeError(fmt.Errorf("If-Match header did not match current config hash"))
+			return APIError{
+				HTTPStatus: http.StatusPreconditionFailed,
+				Err:        fmt.Errorf("If-Match header did not match current config hash"),
+			}
+		}
+	}
+
+	err := h.unsyncedConfigAccess(method, path, input, nil)
+	if err != nil {
+		h.rememberConfigChangeError(err)
+		return err
+	}
+
+	newCfg, err := json.Marshal(rawCfg[rawConfigKey])
+	if err != nil {
+		h.rememberConfigChangeError(err)
+		return APIError{
+			HTTPStatus: http.StatusBadRequest,
+			Err:        fmt.Errorf("encoding new config: %v", err),
+		}
+	}
+	h.cfgEncodedLen = len(newCfg)
+
+	if !forceReload && bytes.Equal(rawCfgJSON, newCfg) {
+		h.cfgUnchanged = true
+		Log().Info("config is unchanged")
+		h.rememberConfigChangeError(errSameConfig)
+		return errSameConfig
+	}
+
+	idx := make(map[string]string)
+	err = indexConfigObjects(rawCfg[rawConfigKey], "/"+rawConfigKey, idx)
+	if err != nil {
+		h.rememberConfigChangeError(err)
+		return APIError{
+			HTTPStatus: http.StatusInternalServerError,
+			Err:        fmt.Errorf("indexing config: %v", err),
+		}
+	}
+	h.markConfigIndexSnapshot(len(idx))
+
+	err = unsyncedDecodeAndRun(newCfg, true)
+	if err != nil {
+		h.trackConfigRevertNeed(true)
+		if len(rawCfgJSON) > 0 {
+			var oldCfg any
+			err2 := json.Unmarshal(rawCfgJSON, &oldCfg)
+			if err2 != nil {
+				err = fmt.Errorf("%v; additionally, restoring old config: %v", err, err2)
+			}
+			rawCfg[rawConfigKey] = oldCfg
+		}
+		h.rememberConfigChangeError(err)
+		return fmt.Errorf("loading new config: %v", err)
+	}
+
+	rawCfgJSON = newCfg
+	rawCfgIndex = idx
+	h.cfgRevertNeeded = false
+	h.summarizeConfigChange()
+	return nil
+}
