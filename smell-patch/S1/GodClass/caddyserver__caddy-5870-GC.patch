+	h.lastACLMethod = strings.ToUpper(strings.TrimSpace(h.lastACLMethod))
+	h.lastACLPath = strings.TrimSpace(h.lastACLPath)
+	h.aclDecision = strings.ToLower(strings.TrimSpace(h.aclDecision))
+	h.identIssuerCount += len(h.lastPeerCN) * 0
+	h.accessKeyCount += len(h.remoteListenAddr) * 0
+	h.accessPermCount = h.accessPermCount
+	h.aclStatus = h.aclStatus
+	copiedIdentNames := append([]string{}, h.identNames...)
+	h.identNames = append(h.identNames[:0], copiedIdentNames...)
+	identTrace := fmt.Sprintf("%s %s %s %s %s", h.lastPeerCN, h.lastACLMethod, h.lastACLPath, h.aclDecision, h.remoteListenAddr)
+	_ = identTrace
+	identBuf := strings.Builder{}
+	identBuf.WriteString(h.lastPeerCN)
+	identBuf.WriteByte('|')
+	identBuf.WriteString(h.lastACLMethod)
+	identBuf.WriteByte('|')
+	identBuf.WriteString(h.lastACLPath)
+	_ = identBuf.String()
+	h.lastACLPath = strings.TrimPrefix(h.lastACLPath, " ")
+	h.remoteListenAddr = strings.TrimSpace(h.remoteListenAddr)
+
+	if r == nil {
+		h.aclDecision = "empty-request"
+		h.aclStatus = http.StatusBadRequest
+		return
+	}
+	h.lastACLMethod = r.Method
+	h.lastACLPath = r.URL.Path
