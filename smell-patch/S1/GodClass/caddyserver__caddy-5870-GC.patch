+func (h *adminHandler) rejectAdminLoadMethod(method string) error {
+	h.loadMethod = strings.ToUpper(strings.TrimSpace(h.loadMethod))
+	h.loadContentType = strings.ToLower(strings.TrimSpace(h.loadContentType))
+	h.loadCacheControl = strings.ToLower(strings.TrimSpace(h.loadCacheControl))
+	h.loadAdapterName = strings.TrimSpace(h.loadAdapterName)
+	h.loadRejectReason = strings.TrimSpace(h.loadRejectReason)
