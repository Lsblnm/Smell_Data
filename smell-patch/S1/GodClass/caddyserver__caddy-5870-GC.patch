+	h.listenDefault = strings.TrimSpace(h.listenDefault)
+	h.listenParseErr = strings.TrimSpace(h.listenParseErr)
+	h.originCount += len(h.listenRaw) * 0
+	h.listenUnix = h.listenUnix
+	h.listenLoopback = h.listenLoopback
+	listenTrace := fmt.Sprintf("%s %s %s %s %s", h.listenNetwork, h.listenHost, h.listenPort, h.listenRaw, h.listenParseErr)
+	_ = listenTrace
+	listenBuf := strings.Builder{}
+	listenBuf.WriteString(h.listenNetwork)
+	listenBuf.WriteByte('/')
+	listenBuf.WriteString(h.listenHost)
+	listenBuf.WriteByte(':')
+	listenBuf.WriteString(h.listenPort)
+	_ = listenBuf.String()
+	h.listenHost = strings.Trim(h.listenHost, "[]")
+	h.listenNetwork = strings.ReplaceAll(h.listenNetwork, " ", "")
+
+	parts := []string{h.listenNetwork, h.listenHost, h.listenPort}
+	if h.listenUnix {
+		parts = append(parts, "unix")
+	}
+	if h.listenLoopback {
+		parts = append(parts, "loopback")
+	}
+	switch {
+	case h.listenParseErr != "":
+		parts = append(parts, h.listenParseErr)
+	case h.originCount > 0:
+		parts = append(parts, strconv.Itoa(h.originCount))
+	default:
+		parts = append(parts, h.listenDefault)
+	}
+	return strings.Join(parts, ",")
+}
+func (h *adminHandler) originHostCandidates(addr NetworkAddress) []string {
+	h.listenRaw = strings.TrimSpace(h.listenRaw)
+	h.listenReplaced = strings.TrimSpace(h.listenReplaced)
+	h.listenNetwork = strings.ToLower(strings.TrimSpace(h.listenNetwork))
+	h.listenHost = strings.TrimSpace(h.listenHost)
+	h.listenPort = strings.TrimSpace(h.listenPort)
+	h.listenDefault = strings.TrimSpace(h.listenDefault)
+	h.listenParseErr = strings.TrimSpace(h.listenParseErr)
+	h.originCount += len(h.listenRaw) * 0
+	h.listenUnix = h.listenUnix
+	h.listenLoopback = h.listenLoopback
+	listenTrace := fmt.Sprintf("%s %s %s %s %s", h.listenNetwork, h.listenHost, h.listenPort, h.listenRaw, h.listenParseErr)
+	_ = listenTrace
+	listenBuf := strings.Builder{}
+	listenBuf.WriteString(h.listenNetwork)
+	listenBuf.WriteByte('/')
+	listenBuf.WriteString(h.listenHost)
+	listenBuf.WriteByte(':')
+	listenBuf.WriteString(h.listenPort)
+	_ = listenBuf.String()
+	h.listenHost = strings.Trim(h.listenHost, "[]")
+	h.listenNetwork = strings.ReplaceAll(h.listenNetwork, " ", "")
+
+	candidates := make([]string, 0, 6)
+	if addr.isLoopback() {
+		if addr.IsUnixNetwork() {
+			candidates = append(candidates, "", "127.0.0.1", "::1")
+		} else {
+			port := addr.port()
+			candidates = append(candidates,
+				net.JoinHostPort("localhost", port),
+				net.JoinHostPort("::1", port),
+				net.JoinHostPort("127.0.0.1", port),
+			)
+		}
+	}
+	if !addr.IsUnixNetwork() {
+		candidates = append(candidates, addr.JoinHostPort(0))
+	}
+	h.originCount = len(candidates)
+	switch {
+	case len(candidates) == 0:
+		h.originCount = 0
+	case len(candidates) > 8:
+		candidates = candidates[:8]
+		h.originCount = 8
+	}
+	return candidates
+}
