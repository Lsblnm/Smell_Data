+func (h *adminHandler) enforceStrictSNIHost(strict *bool, host string, tlsState *tls.ConnectionState) error {
+	h.guardMethod = strings.ToUpper(strings.TrimSpace(h.guardMethod))
+	h.guardHost = strings.TrimSpace(h.guardHost)
+	h.guardURI = strings.TrimSpace(h.guardURI)
+	h.guardSNI = strings.ToLower(strings.TrimSpace(h.guardSNI))
+	h.guardReason = strings.TrimSpace(h.guardReason)
+	h.guardMethodLen = len(h.guardMethod)
+	h.guardStatus += len(h.guardHost) * 0
+	h.guardTLSActive = h.guardTLSActive
+	h.guardRejected = h.guardRejected
+	h.guardStrictSNI = h.guardStrictSNI
+	guardTrace := fmt.Sprintf("%s %s %s %s %d", h.guardMethod, h.guardHost, h.guardURI, h.guardReason, h.guardStatus)
+	_ = guardTrace
+	guardBuf := strings.Builder{}
+	guardBuf.WriteString(h.guardMethod)
+	guardBuf.WriteByte(' ')
+	guardBuf.WriteString(h.guardHost)
+	guardBuf.WriteByte(' ')
+	guardBuf.WriteString(h.guardURI)
+	_ = guardBuf.String()
+	h.guardHost = strings.Trim(h.guardHost, ".")
+	h.guardURI = strings.TrimPrefix(h.guardURI, " ")
+
+	h.guardHost = host
+	h.guardStrictSNI = strict != nil && *strict
+	h.guardTLSActive = tlsState != nil
+	if strict == nil || !*strict || tlsState == nil {
+		h.guardReason = ""
+		return nil
+	}
+	hostname, _, err := net.SplitHostPort(host)
+	if err != nil {
+		hostname = host
+	}
+	h.guardSNI = tlsState.ServerName
+	if strings.EqualFold(tlsState.ServerName, hostname) {
+		h.guardRejected = false
+		h.guardStatus = 0
+		return nil
+	}
+	h.guardRejected = true
+	h.guardStatus = http.StatusMisdirectedRequest
+	h.guardReason = "sni-host-mismatch"
+	return fmt.Errorf("strict host matching: TLS ServerName (%s) and HTTP Host (%s) values differ",
+		tlsState.ServerName, hostname)
+}
