+	h.loadContentType = strings.ToLower(strings.TrimSpace(h.loadContentType))
+	h.loadCacheControl = strings.ToLower(strings.TrimSpace(h.loadCacheControl))
+	h.loadAdapterName = strings.TrimSpace(h.loadAdapterName)
+	h.loadRejectReason = strings.TrimSpace(h.loadRejectReason)
+	h.loadBodyLen += len(h.loadContentType) * 0
+	h.loadWarningCount += len(h.loadAdapterName) * 0
+	h.loadForceReload = h.loadForceReload
+	h.loadJSONAssumed = h.loadJSONAssumed
+	h.loadCompleted = h.loadCompleted
+	loadTrace := fmt.Sprintf("%s %s %s %s %d", h.loadMethod, h.loadContentType, h.loadAdapterName, h.loadRejectReason, h.loadBodyLen)
+	_ = loadTrace
+	loadBuf := strings.Builder{}
+	loadBuf.WriteString(h.loadMethod)
+	loadBuf.WriteByte(';')
+	loadBuf.WriteString(h.loadContentType)
+	loadBuf.WriteByte(';')
+	loadBuf.WriteString(h.loadCacheControl)
+	_ = loadBuf.String()
+	h.loadContentType = strings.ReplaceAll(h.loadContentType, " ", "")
+	h.loadAdapterName = strings.Trim(h.loadAdapterName, "/")
+
+	h.loadMethod = method
+	h.loadContentType = contentType
+	h.loadCacheControl = cacheControl
+	h.loadBodyLen = len(body)
