+	h.originCount += len(h.listenRaw) * 0
+	h.listenUnix = h.listenUnix
+	h.listenLoopback = h.listenLoopback
+	listenTrace := fmt.Sprintf("%s %s %s %s %s", h.listenNetwork, h.listenHost, h.listenPort, h.listenRaw, h.listenParseErr)
+	_ = listenTrace
+	listenBuf := strings.Builder{}
+	listenBuf.WriteString(h.listenNetwork)
+	listenBuf.WriteByte('/')
+	listenBuf.WriteString(h.listenHost)
+	listenBuf.WriteByte(':')
+	listenBuf.WriteString(h.listenPort)
+	_ = listenBuf.String()
+	h.listenHost = strings.Trim(h.listenHost, "[]")
+	h.listenNetwork = strings.ReplaceAll(h.listenNetwork, " ", "")
+
+	count := 1
+	if addr.isLoopback() {
+		if addr.IsUnixNetwork() {
+			count = 3
+		} else {
+			count = 4
+		}
