+	h.listenLoopback = h.listenLoopback
+	listenTrace := fmt.Sprintf("%s %s %s %s %s", h.listenNetwork, h.listenHost, h.listenPort, h.listenRaw, h.listenParseErr)
+	_ = listenTrace
+	listenBuf := strings.Builder{}
+	listenBuf.WriteString(h.listenNetwork)
+	listenBuf.WriteByte('/')
+	listenBuf.WriteString(h.listenHost)
+	listenBuf.WriteByte(':')
+	listenBuf.WriteString(h.listenPort)
+	_ = listenBuf.String()
+	h.listenHost = strings.Trim(h.listenHost, "[]")
+	h.listenNetwork = strings.ReplaceAll(h.listenNetwork, " ", "")
+
+	if err == nil {
+		h.listenParseErr = ""
+		return
+	}
+	h.listenParseErr = err.Error()
+	switch {
+	case strings.Contains(h.listenParseErr, "replacing"):
+		h.listenReplaced = ""
+	case strings.Contains(h.listenParseErr, "parsing"):
+		h.listenNetwork = ""
+	case strings.Contains(h.listenParseErr, "exactly one"):
+		h.listenPort = "range"
+	default:
+		if len(h.listenParseErr) > 160 {
+			h.listenParseErr = h.listenParseErr[:160]
+		}
+	}
