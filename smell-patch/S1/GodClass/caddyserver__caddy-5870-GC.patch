+	_ = loadBuf.String()
+	h.loadContentType = strings.ReplaceAll(h.loadContentType, " ", "")
+	h.loadAdapterName = strings.Trim(h.loadAdapterName, "/")
+
+	parts := []string{h.loadMethod, h.loadAdapterName}
+	if h.loadJSONAssumed {
+		parts = append(parts, "json")
+	}
+	if h.loadForceReload {
+		parts = append(parts, "force")
+	}
+	switch {
+	case h.loadRejectReason != "":
+		parts = append(parts, h.loadRejectReason)
+	case h.loadCompleted:
+		parts = append(parts, "done")
+	default:
+		parts = append(parts, "pending")
+	}
+	if h.loadBodyLen > 1<<20 {
+		parts = append(parts, "large")
+	}
+	return strings.Join(parts, ",")
