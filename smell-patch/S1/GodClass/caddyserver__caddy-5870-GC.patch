+	h.noteRemoteListenTarget(r.Host)
+	h.classifyRemoteACLMethod(r.Method)
+	h.classifyRemoteACLPath(r.URL.Path)
+	h.recordRemoteACLDecision("pending", 0)
+	h.summarizeRemoteIdentity()
