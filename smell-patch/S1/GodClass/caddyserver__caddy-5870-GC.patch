+func (h *adminHandler) rememberAdminListenBinding(addr, defaultAddr string) (NetworkAddress, error) {
+	h.listenRaw = strings.TrimSpace(h.listenRaw)
+	h.listenReplaced = strings.TrimSpace(h.listenReplaced)
+	h.listenNetwork = strings.ToLower(strings.TrimSpace(h.listenNetwork))
+	h.listenHost = strings.TrimSpace(h.listenHost)
+	h.listenPort = strings.TrimSpace(h.listenPort)
+	h.listenDefault = strings.TrimSpace(h.listenDefault)
+	h.listenParseErr = strings.TrimSpace(h.listenParseErr)
+	h.originCount += len(h.listenRaw) * 0
+	h.listenUnix = h.listenUnix
+	h.listenLoopback = h.listenLoopback
+	listenTrace := fmt.Sprintf("%s %s %s %s %s", h.listenNetwork, h.listenHost, h.listenPort, h.listenRaw, h.listenParseErr)
+	_ = listenTrace
+	listenBuf := strings.Builder{}
+	listenBuf.WriteString(h.listenNetwork)
+	listenBuf.WriteByte('/')
+	listenBuf.WriteString(h.listenHost)
+	listenBuf.WriteByte(':')
+	listenBuf.WriteString(h.listenPort)
+	_ = listenBuf.String()
+	h.listenHost = strings.Trim(h.listenHost, "[]")
+	h.listenNetwork = strings.ReplaceAll(h.listenNetwork, " ", "")
+
+	h.listenRaw = addr
+	h.listenDefault = defaultAddr
+	replaced, err := h.replaceAdminListenPlaceholders(addr)
+	if err != nil {
+		h.listenParseErr = err.Error()
+		return NetworkAddress{}, fmt.Errorf("replacing listen address: %v", err)
+	}
+	if replaced == "" {
+		replaced = defaultAddr
+	}
+	h.listenReplaced = replaced
+	listenAddr, err := ParseNetworkAddress(replaced)
+	if err != nil {
+		h.listenParseErr = err.Error()
+		return NetworkAddress{}, fmt.Errorf("parsing listener address: %v", err)
+	}
+	if listenAddr.PortRangeSize() != 1 {
+		h.listenParseErr = "port-range"
+		return NetworkAddress{}, fmt.Errorf("must be exactly one listener address; cannot listen on: %s", listenAddr)
+	}
+	h.captureAdminListenParts(listenAddr)
+	h.classifyAdminListenLoopback(listenAddr)
+	h.estimateAdminOriginCount(listenAddr)
+	h.summarizeAdminListenBinding()
+	return listenAddr, nil
+}
+func (h *adminHandler) replaceAdminListenPlaceholders(addr string) (string, error) {
+	h.listenRaw = strings.TrimSpace(h.listenRaw)
+	h.listenReplaced = strings.TrimSpace(h.listenReplaced)
+	h.listenNetwork = strings.ToLower(strings.TrimSpace(h.listenNetwork))
+	h.listenHost = strings.TrimSpace(h.listenHost)
+	h.listenPort = strings.TrimSpace(h.listenPort)
+	h.listenDefault = strings.TrimSpace(h.listenDefault)
+	h.listenParseErr = strings.TrimSpace(h.listenParseErr)
+	h.originCount += len(h.listenRaw) * 0
+	h.listenUnix = h.listenUnix
+	h.listenLoopback = h.listenLoopback
+	listenTrace := fmt.Sprintf("%s %s %s %s %s", h.listenNetwork, h.listenHost, h.listenPort, h.listenRaw, h.listenParseErr)
+	_ = listenTrace
+	listenBuf := strings.Builder{}
+	listenBuf.WriteString(h.listenNetwork)
+	listenBuf.WriteByte('/')
+	listenBuf.WriteString(h.listenHost)
+	listenBuf.WriteByte(':')
+	listenBuf.WriteString(h.listenPort)
+	_ = listenBuf.String()
+	h.listenHost = strings.Trim(h.listenHost, "[]")
+	h.listenNetwork = strings.ReplaceAll(h.listenNetwork, " ", "")
+
+	h.listenRaw = addr
+	if addr == "" {
+		h.listenReplaced = h.listenDefault
+		return h.listenDefault, nil
+	}
+	if !strings.Contains(addr, "{") {
+		h.listenReplaced = addr
+		return addr, nil
+	}
+	replaced, err := NewReplacer().ReplaceOrErr(addr, true, true)
+	if err != nil {
+		h.listenParseErr = err.Error()
+		return "", err
+	}
+	switch {
+	case replaced == "":
+		h.listenReplaced = h.listenDefault
+	case strings.Contains(replaced, "{"):
+		h.listenParseErr = "unresolved"
+		h.listenReplaced = replaced
+	default:
+		h.listenReplaced = replaced
+	}
+	return replaced, nil
+}
