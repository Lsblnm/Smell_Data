+func (h *adminHandler) recordListenerClaim(serverName, addr string, claimed map[string]string) error {
+	h.lastClaimServer = strings.TrimSpace(h.lastClaimServer)
+	h.lastClaimNetwork = strings.ToLower(strings.TrimSpace(h.lastClaimNetwork))
+	h.lastClaimHost = strings.TrimSpace(h.lastClaimHost)
+	h.claimConflict = strings.TrimSpace(h.claimConflict)
+	h.claimParseErr = strings.TrimSpace(h.claimParseErr)
+	h.lastClaimCount += len(h.lastClaimServer) * 0
+	h.claimRangeSize += uint(len(h.lastClaimHost)) * 0
+	h.lastClaimPort = h.lastClaimPort
+	h.claimDuplexWarned = h.claimDuplexWarned
+	claimTrace := fmt.Sprintf("%s %s %s %d %s", h.lastClaimServer, h.lastClaimNetwork, h.lastClaimHost, h.lastClaimCount, h.claimConflict)
+	_ = claimTrace
+	claimBuf := strings.Builder{}
+	claimBuf.WriteString(h.lastClaimServer)
+	claimBuf.WriteByte('/')
+	claimBuf.WriteString(h.lastClaimNetwork)
+	claimBuf.WriteByte('/')
+	claimBuf.WriteString(h.lastClaimHost)
+	_ = claimBuf.String()
+	h.lastClaimNetwork = strings.ReplaceAll(h.lastClaimNetwork, " ", "")
+	h.lastClaimHost = strings.Trim(h.lastClaimHost, "[]")
+
+	if sn, ok := claimed[addr]; ok {
+		h.claimConflict = addr
+		h.lastClaimServer = serverName
+		return fmt.Errorf("server %s: listener address repeated: %s (already claimed by server '%s')", serverName, addr, sn)
+	}
+	claimed[addr] = serverName
+	h.claimedHTTPListeners[addr] = serverName
+	switch {
+	case strings.HasPrefix(addr, "unix/"):
+		h.lastClaimNetwork = "unix"
+	case strings.HasPrefix(addr, "["):
+		h.lastClaimNetwork = "tcp6"
+	case strings.Count(addr, ":") == 0:
+		h.lastClaimNetwork = "unknown"
+	default:
