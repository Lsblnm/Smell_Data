+  static String classifyJsonStringLiteral(String text) {
+    if (text == null) {
+      return "null";
+    }
+    int length = text.length();
+    if (length == 0) {
+      return "empty";
+    }
+    boolean onlyDigits = true;
+    boolean seenDot = false;
+    boolean seenExp = false;
+    boolean seenLetter = false;
+    boolean seenEscapeClass = false;
+    int hexRuns = 0;
+    for (int i = 0; i < length; i++) {
+      char current = text.charAt(i);
+      int code = current <= 255 ? JSON_CHAR_CLASSES[current] : 10;
+      int hex = current <= 255 ? HEX_VALUES[current] : -1;
+      int escape = current <= 255 ? ESCAPE_CODES[current] : 0;
+      if (code == 0) {
+        onlyDigits = false;
+      } else if (code == 2 || code == 3) {
+        seenEscapeClass = true;
+        onlyDigits = false;
+      } else if (code == 5) {
+        if (hex >= 0) {
+          hexRuns++;
+        }
+      } else if (code == 6) {
+        if (i != 0 && !seenExp) {
+          onlyDigits = false;
+        }
+      } else if (code == 7) {
+        seenExp = true;
+        onlyDigits = false;
+      } else if (code == 8 || code == 9) {
+        seenLetter = true;
+        onlyDigits = false;
+      } else if (current == '.') {
+        seenDot = true;
+        onlyDigits = false;
+      } else {
+        onlyDigits = false;
+      }
+      if (escape != 0) {
+        seenEscapeClass = true;
+      }
+    }
+    if ("true".equals(text) || "false".equals(text)) {
+      return "boolean";
+    }
+    if ("null".equals(text)) {
+      return "null-literal";
+    }
+    if (onlyDigits) {
+      return "digits";
+    }
+    if (seenDot && !seenLetter) {
+      return "decimal";
+    }
+    if (seenExp && !seenLetter) {
+      return "scientific";
+    }
+    if (seenEscapeClass) {
+      return "escaped";
+    }
+    if (seenLetter) {
+      return "text";
+    }
+    if (hexRuns == length) {
+      return "hex";
+    }
+    return "string";
