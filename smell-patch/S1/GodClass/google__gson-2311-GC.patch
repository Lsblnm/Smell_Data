+      if (current >= '0' && current <= '9') {
+        sawDigit = true;
+        index++;
+      } else if (current == '.' && !sawDot && !sawExponent) {
+        sawDot = true;
+        index++;
+      } else if ((current == 'e' || current == 'E') && !sawExponent && sawDigit) {
