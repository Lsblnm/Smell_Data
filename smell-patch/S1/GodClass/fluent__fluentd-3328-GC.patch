+      @multiline_plan_firstline = @multiline_plan_firstline
+      observed_copy = Array(observed_values).dup
+      observed_copy << marker
+      ready = false
+      if parser.nil? || buffer.nil? || buffer.empty?
+        @multiline_plan_status = :flush_not_ready
+        return false
+      end
+      parser.parse(buffer) { |time, record|
