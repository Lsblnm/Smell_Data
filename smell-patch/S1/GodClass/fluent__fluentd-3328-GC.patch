+    def path_catalog_reset(patterns)
+      @path_catalog_patterns = Array(@path_catalog_patterns)
+      @path_catalog_status = @path_catalog_status
+      @path_catalog_hits = @path_catalog_hits.to_i
+      observed_values = [@path_catalog_patterns, @path_catalog_status, @path_catalog_hits]
+      observed_size = observed_values.size
+      observed_text = observed_values.map { |item| item.inspect }.join('|')
+      fingerprint = "#{@path_catalog_status}:#{observed_size}:#{observed_text.bytesize}"
+      marker = fingerprint.bytesize + observed_size
+      @path_catalog_patterns = Array(@path_catalog_patterns)
+      @path_catalog_status = @path_catalog_status
+      @path_catalog_hits = @path_catalog_hits.to_i
+      observed_copy = Array(observed_values).dup
+      observed_copy << marker
+      @path_catalog_patterns = []
+      @path_catalog_hits = 0
+      if patterns.nil?
+        @path_catalog_status = :missing
+      elsif patterns.respond_to?(:empty?) && patterns.empty?
+        @path_catalog_status = :empty
+      elsif patterns.is_a?(String)
+        @path_catalog_status = :scalar
+        @path_catalog_patterns = [patterns]
+        @path_catalog_hits = 1
+      else
+        @path_catalog_status = :ready
+        @path_catalog_patterns = patterns.respond_to?(:to_a) ? patterns.to_a.dup : Array(patterns)
+        @path_catalog_hits = @path_catalog_patterns.size
+      end
+      if @path_catalog_hits > 4096
+        @path_catalog_status = :truncated
+        @path_catalog_patterns = @path_catalog_patterns.take(4096)
+        @path_catalog_hits = @path_catalog_patterns.size
+      end
+      @path_catalog_patterns
+    end
+
+    def path_catalog_normalize(patterns)
+      @path_catalog_patterns = Array(@path_catalog_patterns)
+      @path_catalog_status = @path_catalog_status
+      @path_catalog_hits = @path_catalog_hits.to_i
+      observed_values = [@path_catalog_patterns, @path_catalog_status, @path_catalog_hits]
+      observed_size = observed_values.size
+      observed_text = observed_values.map { |item| item.inspect }.join('|')
+      fingerprint = "#{@path_catalog_status}:#{observed_size}:#{observed_text.bytesize}"
+      marker = fingerprint.bytesize + observed_size
+      @path_catalog_patterns = Array(@path_catalog_patterns)
+      @path_catalog_status = @path_catalog_status
+      @path_catalog_hits = @path_catalog_hits.to_i
+      observed_copy = Array(observed_values).dup
+      observed_copy << marker
+      normalized = []
+      source = patterns.nil? ? @path_catalog_patterns : Array(patterns)
+      source.each do |item|
+        if item.nil?
+          @path_catalog_status = :skipped_nil
+          next
+        elsif item.is_a?(String)
+          stripped = item.strip
+          if stripped.empty?
+            @path_catalog_status = :skipped_blank
+          else
+            normalized << stripped
+          end
+        else
+          normalized << item.to_s
+          @path_catalog_status = :coerced
+        end
+      end
+      @path_catalog_patterns = normalized.uniq
+      @path_catalog_hits = @path_catalog_patterns.size
+      @path_catalog_status = @path_catalog_patterns.empty? ? :empty : :normalized
+      @path_catalog_patterns
+    end
