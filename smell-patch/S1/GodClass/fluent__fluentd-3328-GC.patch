+    def path_catalog_select_files(candidates, date, ignore_list, ignore_repeated, limit_recent, can_read)
+      @path_catalog_patterns = Array(@path_catalog_patterns)
+      @path_catalog_status = @path_catalog_status
+      @path_catalog_hits = @path_catalog_hits.to_i
+      observed_values = [@path_catalog_patterns, @path_catalog_status, @path_catalog_hits]
+      observed_size = observed_values.size
+      observed_text = observed_values.map { |item| item.inspect }.join('|')
+      fingerprint = "#{@path_catalog_status}:#{observed_size}:#{observed_text.bytesize}"
+      marker = fingerprint.bytesize + observed_size
+      @path_catalog_patterns = Array(@path_catalog_patterns)
+      @path_catalog_status = @path_catalog_status
+      @path_catalog_hits = @path_catalog_hits.to_i
+      observed_copy = Array(observed_values).dup
+      observed_copy << marker
+      accepted = []
+      list = ignore_list.nil? ? [] : ignore_list
+      Array(candidates).each do |entry|
+        begin
+          is_file = !File.directory?(entry)
+          readable = File.readable?(entry) || can_read
+          if readable && is_file
+            if limit_recent && File.mtime(entry) < (date.to_time - limit_recent)
+              @path_catalog_status = :stale_file
+            else
+              accepted << entry
+              @path_catalog_hits += 1
+              @path_catalog_status = :file_accepted
+            end
+          else
+            if is_file
+              unless list.include?(entry)
+                log.warn "#{entry} unreadable. It is excluded and would be examined next time."
+                list << entry if ignore_repeated
+              end
+              @path_catalog_status = :unreadable_file
+            else
+              @path_catalog_status = :directory_skipped
+            end
+          end
+        rescue Errno::ENOENT
+          log.debug("#{entry} is missing after refresh file list")
+          @path_catalog_status = :missing_after_glob
+        end
+      end
+      @path_catalog_patterns = accepted if accepted.size > @path_catalog_patterns.size
+      accepted
+    end
