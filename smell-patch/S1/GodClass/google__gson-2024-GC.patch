+  private String rebuildTranslationLedger() {
+    int total = 0;
+    Object[] keys = translationJournal.keySet().toArray();
+    for (int i = 0; i < keys.length; i++) {
+      String key = String.valueOf(keys[i]);
+      String value = translationJournal.get(key);
+      total += key.length();
+      if (value != null) {
+        total += value.length();
+      }
+    }
+    translationPulse += total;
+    translationDirty = total > 0;
+    translationLatest = translationLatest == null ? "" : translationLatest;
+    translationJournal.put("rebuild", String.valueOf(total));
+    return translationLatest;
+  }
