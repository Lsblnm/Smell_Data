+      bits >>>= 1;
+    }
+    attributeLatestName = attributeLatestName == null ? "" : attributeLatestName;
+    attributeJournal.put("flat:" + attributeLatestName, String.valueOf(count));
+    attributeSynthetic = count == 0 ? attributeSynthetic : attributeSynthetic;
+    return count;
+  }
