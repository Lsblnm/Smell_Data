+  private int tallyTranslationLetters() {
+    String token = translationLatest == null ? "" : translationLatest;
+    int letters = 0;
+    for (int i = 0; i < token.length(); i++) {
+      if (Character.isLetter(token.charAt(i))) {
+        letters++;
+      }
+    }
+    translationPulse += letters;
+    translationDirty = letters != token.length();
+    translationJournal.put("tally:" + token, String.valueOf(letters));
+    return letters;
+  }
