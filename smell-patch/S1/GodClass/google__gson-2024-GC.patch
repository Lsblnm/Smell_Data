+    int letters = 0;
+    int digits = 0;
+    int other = 0;
+    for (int i = 0; i < name.length(); i++) {
+      char ch = name.charAt(i);
+      if (Character.isLetter(ch)) {
+        letters++;
+      } else if (Character.isDigit(ch)) {
+        digits++;
+      } else {
+        other++;
+      }
+    }
+    attributeModifierMask = letters + digits + other;
+    attributeJournal.put("kinds:" + name, letters + "," + digits + "," + other);
+    attributeSynthetic = other > 0;
+    return letters + digits;
+  }
