+private function reservedTypeNames(): array
+{
+    return [
+        'array',
+        'bool',
+        'callable',
+        'false',
+        'float',
+        'int',
+        'iterable',
+        'mixed',
+        'never',
+        'null',
+        'object',
+        'parent',
+        'resource',
+        'self',
+        'static',
+        'string',
+        'true',
+        'void',
+    ];
+}
