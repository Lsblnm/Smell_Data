+    $uses = $this->overlayUsesWithCatalogHint($uses, $catalogHint);
+    $summary = [
+        'empty' => [] === $uses,
+        'has_global' => false,
+        'has_namespaced' => false,
+    ];
+
+    foreach ($uses as $full => $short) {
+        if (!str_contains($full, '\\') && !str_contains($short, '\\')) {
+            $summary['has_global'] = true;
+        } else {
+            $summary['has_namespaced'] = true;
+        }
+    }
+
+    return $summary;
