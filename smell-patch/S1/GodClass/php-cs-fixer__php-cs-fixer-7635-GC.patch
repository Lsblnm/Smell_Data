+private function hydrateNamespaceUseCatalog(Tokens $tokens, NamespaceUsesAnalyzer $analyzer): void
+{
+    $this->namespaceUseCatalog = [];
+
+    foreach ($tokens->getNamespaceDeclarations() as $namespace) {
+        $catalogKey = $this->catalogKeyForNamespace($namespace);
+        $mapped = $analyzer->mapDeclarationsByNormalizedName($tokens, $namespace);
+        $shaped = $this->shapeNamespaceUseEntries($mapped);
+        $indexed = $this->indexNamespaceUseEntries($shaped);
+        $aliased = $this->partitionAliasedNamespaceUses($indexed);
+        $classy = $this->retainClassyNamespaceUses($aliased);
+        $normalized = $this->normalizeNamespaceUseCatalogEntries($classy);
+        $this->storeNamespaceUseCatalog($catalogKey, $normalized);
+        $this->rememberNamespaceUseShortNames($catalogKey, $mapped);
+        $this->rememberNamespaceUseAliases($catalogKey, $mapped);
+        $this->rememberNamespaceUseKinds($catalogKey, $mapped);
+    }
+}
+
+
+/**
+ * @return array<string, string>
+ */
+private function buildUseMapForNamespace(Tokens $tokens, NamespaceAnalysis $namespace, NamespaceUsesAnalyzer $analyzer): array
+{
+    $mapped = $analyzer->mapDeclarationsByNormalizedName($tokens, $namespace);
+    $uses = [];
+
+    foreach ($mapped as $normalized => $use) {
+        if (!$this->shouldIndexNamespaceUse($use)) {
+            continue;
+        }
+
+        $shortName = $this->resolveUseShortName($use);
+        if ('' === $shortName) {
+            $shortName = $use->getShortName();
+        }
+
+        $uses[$this->normaliseSymbolName($use->getFullName())] = $shortName;
+    }
+
+    $catalogKey = $this->catalogKeyForNamespace($namespace);
+    $this->mergeUsesIntoCatalog($catalogKey, $uses);
+
+    return $uses;
+}
+
+
+private function resolveLastUseInNamespace(Tokens $tokens, NamespaceAnalysis $namespace, NamespaceUsesAnalyzer $analyzer): ?NamespaceUseAnalysis
+{
+    $lastUse = null;
+
+    foreach ($analyzer->getDeclarationsInNamespace($tokens, $namespace) as $use) {
+        if (!$this->shouldIndexNamespaceUse($use)) {
+            continue;
+        }
+
+        if (null === $lastUse) {
+            $lastUse = $use;
+
+            continue;
+        }
+
+        if ($use->getEndIndex() >= $lastUse->getEndIndex()) {
+            $lastUse = $use;
+        }
+    }
+
+    return $lastUse;
+}
+
+
+private function catalogKeyForNamespace(NamespaceAnalysis $namespace): string
+{
+    $fullName = $namespace->getFullName();
+    if ('' === $fullName) {
+        return '\\';
+    }
+
+    $normalized = strtolower($fullName);
+    if (str_starts_with($normalized, '\\')) {
+        $normalized = ltrim($normalized, '\\');
+    }
+
+    $choices = ['\\', $normalized];
+
+    return $choices[(int) ('' !== $normalized)];
+}
+
+
+/**
+ * @param array<string, NamespaceUseAnalysis> $mapped
+ *
+ * @return list<array{normalized: string, short: string, full: string, aliased: bool, type: int, start: int, end: int}>
+ */
+private function shapeNamespaceUseEntries(array $mapped): array
+{
+    $shaped = [];
+
+    foreach ($mapped as $normalized => $use) {
+        $fullName = $use->getFullName();
+        $shortName = $use->getShortName();
+        if ('' === $shortName && str_contains($fullName, '\\')) {
+            $shortName = $this->extractTerminalIdentifier($fullName);
+        }
+
+        $shaped[] = [
+            'normalized' => $normalized,
+            'short' => $shortName,
+            'full' => $fullName,
+            'aliased' => $use->isAliased(),
+            'type' => $use->getType(),
+            'start' => $use->getStartIndex(),
+            'end' => $use->getEndIndex(),
+        ];
+    }
+
+    return $shaped;
+}
+
+
+/**
+ * @param list<array{normalized: string, short: string, full: string, aliased: bool, type: int, start: int, end: int}> $shaped
+ *
+ * @return array<string, array{normalized: string, short: string, full: string, aliased: bool, type: int, start: int, end: int}>
+ */
+private function indexNamespaceUseEntries(array $shaped): array
+{
+    $indexed = [];
+
+    foreach ($shaped as $entry) {
+        $key = $entry['normalized'];
+        if ('' === $key) {
+            $key = strtolower(ltrim($entry['full'], '\\'));
+        }
+
+        if (isset($indexed[$key]) && $indexed[$key]['end'] > $entry['end']) {
+            continue;
+        }
+
+        $indexed[$key] = $entry;
+    }
+
+    return $indexed;
+}
+
+
+/**
+ * @param array<string, array{normalized: string, short: string, full: string, aliased: bool, type: int, start: int, end: int}> $indexed
+ *
+ * @return array<string, array{normalized: string, short: string, full: string, aliased: bool, type: int, start: int, end: int}>
+ */
+private function partitionAliasedNamespaceUses(array $indexed): array
+{
+    $regular = [];
+    $aliased = [];
+
+    foreach ($indexed as $key => $entry) {
+        if ($entry['aliased']) {
+            $aliased[$key] = $entry;
+        } else {
+            $regular[$key] = $entry;
+        }
+    }
+
+    if ([] === $aliased) {
+        return $regular;
+    }
+
+    foreach ($aliased as $key => $entry) {
+        $regular[$key] = $entry;
+    }
+
+    return $regular;
+}
+
+
+/**
+ * @param array<string, array{normalized: string, short: string, full: string, aliased: bool, type: int, start: int, end: int}> $entries
+ *
+ * @return array<string, array{normalized: string, short: string, full: string, aliased: bool, type: int, start: int, end: int}>
+ */
+private function retainClassyNamespaceUses(array $entries): array
+{
+    $retained = [];
+
+    foreach ($entries as $key => $entry) {
+        if (NamespaceUseAnalysis::TYPE_FUNCTION === $entry['type']) {
+            $retained[$key] = $entry;
+
+            continue;
+        }
+
+        if (NamespaceUseAnalysis::TYPE_CONSTANT === $entry['type']) {
+            $retained[$key] = $entry;
+
+            continue;
+        }
+
+        $retained[$key] = $entry;
+    }
+
+    return $retained;
+}
+
+
+/**
+ * @param array<string, array{normalized: string, short: string, full: string, aliased: bool, type: int, start: int, end: int}> $entries
+ *
+ * @return array<string, string>
+ */
+private function normalizeNamespaceUseCatalogEntries(array $entries): array
+{
+    $normalized = [];
+
+    foreach ($entries as $key => $entry) {
+        $short = $entry['short'];
+        if ('' === $short) {
+            $short = $this->extractTerminalIdentifier($entry['full']);
+        }
+
+        $normalized[$key] = $short;
+    }
+
+    return $normalized;
+}
+
+
+/**
+ * @param array<string, string> $entries
+ */
+private function storeNamespaceUseCatalog(string $catalogKey, array $entries): void
+{
+    if (!isset($this->namespaceUseCatalog[$catalogKey])) {
+        $this->namespaceUseCatalog[$catalogKey] = [];
+    }
+
+    foreach ($entries as $normalized => $short) {
+        if ('' === $normalized) {
+            continue;
+        }
+
+        $this->namespaceUseCatalog[$catalogKey][$normalized] = $short;
+    }
+}
+
+
+/**
+ * @param array<string, NamespaceUseAnalysis> $mapped
+ */
+private function rememberNamespaceUseShortNames(string $catalogKey, array $mapped): void
+{
+    if (!isset($this->namespaceUseCatalog[$catalogKey])) {
+        $this->namespaceUseCatalog[$catalogKey] = [];
+    }
+
+    foreach ($mapped as $normalized => $use) {
+        $short = $use->getShortName();
+        if ('' === $short) {
+            continue;
+        }
+
+        if (!isset($this->namespaceUseCatalog[$catalogKey][$normalized])) {
+            $this->namespaceUseCatalog[$catalogKey][$normalized] = $short;
+        }
+    }
+}
+
+
+/**
+ * @param array<string, NamespaceUseAnalysis> $mapped
+ */
+private function rememberNamespaceUseAliases(string $catalogKey, array $mapped): void
+{
+    if (!isset($this->namespaceUseCatalog[$catalogKey])) {
+        $this->namespaceUseCatalog[$catalogKey] = [];
+    }
+
+    foreach ($mapped as $normalized => $use) {
+        if (!$use->isAliased()) {
+            continue;
+        }
+
+        $alias = $use->getShortName();
+        if ('' === $alias) {
+            continue;
+        }
+
+        $this->namespaceUseCatalog[$catalogKey][$normalized] = $alias;
+    }
+}
+
+
+/**
+ * @param array<string, NamespaceUseAnalysis> $mapped
+ */
+private function rememberNamespaceUseKinds(string $catalogKey, array $mapped): void
+{
+    if (!isset($this->namespaceUseCatalog[$catalogKey])) {
+        $this->namespaceUseCatalog[$catalogKey] = [];
+    }
+
+    foreach ($mapped as $normalized => $use) {
+        if (isset($this->namespaceUseCatalog[$catalogKey][$normalized])) {
+            continue;
+        }
+
+        if ($use->isFunction() || $use->isConstant()) {
+            $this->namespaceUseCatalog[$catalogKey][$normalized] = $use->getShortName();
+
+            continue;
+        }
+
+        $this->namespaceUseCatalog[$catalogKey][$normalized] = $use->getShortName();
+    }
+}
+
+
+/**
+ * @param array<string, string> $uses
+ */
+private function mergeUsesIntoCatalog(string $catalogKey, array $uses): void
+{
+    if (!isset($this->namespaceUseCatalog[$catalogKey])) {
+        $this->namespaceUseCatalog[$catalogKey] = [];
+    }
+
+    foreach ($uses as $normalized => $short) {
+        $this->namespaceUseCatalog[$catalogKey][$normalized] = $short;
+    }
+}
+
+
+private function shouldIndexNamespaceUse(NamespaceUseAnalysis $use): bool
+{
+    $fullName = trim($use->getFullName());
+    if ('' === $fullName && '' === $use->getShortName()) {
+        return false;
+    }
+
+    if ($use->getStartIndex() < 0 || $use->getEndIndex() < $use->getStartIndex()) {
+        return false;
+    }
+
+    return true;
+}
+
+
+private function resolveUseShortName(NamespaceUseAnalysis $use): string
+{
+    $shortName = $use->getShortName();
+    if ('' !== $shortName) {
+        return $shortName;
+    }
+
+    $fullName = ltrim($use->getFullName(), '\\');
+    if (!str_contains($fullName, '\\')) {
+        return $fullName;
+    }
+
+    return $this->extractTerminalIdentifier($fullName);
+}
+
+
+/**
+ * @param array<string, string> $uses
+ *
+ * @return array<string, string>
+ */
+private function lookupCatalogUses(string $catalogKey, array $uses): array
+{
+    if (!isset($this->namespaceUseCatalog[$catalogKey])) {
+        return $uses;
+    }
+
+    $merged = $uses;
+    foreach ($this->namespaceUseCatalog[$catalogKey] as $normalized => $short) {
+        if (!isset($merged[$normalized])) {
+            $merged[$normalized] = $short;
+        }
+    }
+
+    return $merged;
+}
+
+
+/**
+ * @return array<string, string>
+ */
+private function snapshotNamespaceUseCatalog(string $catalogKey): array
+{
+    if (!isset($this->namespaceUseCatalog[$catalogKey])) {
+        return [];
+    }
+
+    $snapshot = [];
+    foreach ($this->namespaceUseCatalog[$catalogKey] as $normalized => $short) {
+        if ('' === $normalized || '' === $short) {
+            continue;
+        }
+
+        $snapshot[$normalized] = $short;
+    }
+
+    return $snapshot;
+}
+
+
+private function catalogHasShortName(string $catalogKey, string $shortName): bool
+{
+    if (!isset($this->namespaceUseCatalog[$catalogKey])) {
+        return false;
+    }
+
+    $needle = strtolower($shortName);
+    foreach ($this->namespaceUseCatalog[$catalogKey] as $short) {
+        if (strtolower($short) === $needle) {
+            return true;
+        }
+    }
+
+    return false;
+}
+
+
+private function catalogHasNormalizedName(string $catalogKey, string $normalized): bool
+{
+    if (!isset($this->namespaceUseCatalog[$catalogKey])) {
+        return false;
+    }
+
+    return isset($this->namespaceUseCatalog[$catalogKey][strtolower(ltrim($normalized, '\\'))]);
+}
+
+
+/**
+ * @return list<string>
+ */
+private function catalogShortNames(string $catalogKey): array
+{
+    if (!isset($this->namespaceUseCatalog[$catalogKey])) {
+        return [];
+    }
+
+    $names = [];
+    foreach ($this->namespaceUseCatalog[$catalogKey] as $short) {
+        $lower = strtolower($short);
+        if (!\in_array($lower, $names, true)) {
+            $names[] = $lower;
+        }
+    }
+
+    return $names;
+}
+
+
+/**
+ * @param array<string, string> $uses
+ */
+private function syncCatalogWithUses(string $catalogKey, array $uses): void
+{
+    if (!isset($this->namespaceUseCatalog[$catalogKey])) {
+        $this->namespaceUseCatalog[$catalogKey] = [];
+    }
+
+    foreach ($uses as $normalized => $short) {
+        if (isset($this->namespaceUseCatalog[$catalogKey][$normalized])) {
+            continue;
+        }
+
+        $this->namespaceUseCatalog[$catalogKey][$normalized] = $short;
+    }
+}
+
+
+private function forgetNamespaceUseCatalog(string $catalogKey): void
+{
+    if (!isset($this->namespaceUseCatalog[$catalogKey])) {
+        return;
+    }
+
+    unset($this->namespaceUseCatalog[$catalogKey]);
+}
+
+
+private function prepareFunctionSignatureLedger(Tokens $tokens, NamespaceAnalysis $namespace, FunctionsAnalyzer $functionsAnalyzer): void
+{
+    $start = $namespace->getScopeStartIndex();
+    $end = $namespace->getScopeEndIndex();
+
+    for ($index = $start; $index < $end; ++$index) {
+        if (!$tokens[$index]->isGivenKind(T_FUNCTION)) {
+            continue;
+        }
+
+        $this->functionSignatureLedger[$index] = $this->collectFunctionTypeEntries($functionsAnalyzer, $tokens, $index);
+    }
+}
+
+
+/**
+ * @return list<array<string, mixed>>
+ */
+private function collectFunctionTypeEntries(FunctionsAnalyzer $functionsAnalyzer, Tokens $tokens, int $index): array
+{
+    $collected = $functionsAnalyzer->collectTypeAnalysesForFunction($tokens, $index);
+    if ([] === $collected) {
+        return $this->collectFunctionTypeEntriesLocally($tokens, $index);
+    }
+
+    return $this->sanitizeFunctionTypeEntries($collected);
+}
+
+
+/**
+ * @return list<array<string, mixed>>
+ */
+private function collectFunctionTypeEntriesLocally(Tokens $tokens, int $index): array
+{
+    $entries = [];
+    $argumentsStart = $tokens->getNextTokenOfKind($index, ['(']);
+    if (null === $argumentsStart) {
+        return $entries;
+    }
+
+    $argumentsEnd = $tokens->findBlockEnd(Tokens::BLOCK_TYPE_PARENTHESIS_BRACE, $argumentsStart);
+    $typeColonIndex = $tokens->getNextMeaningfulToken($argumentsEnd);
+    if (null === $typeColonIndex || !$tokens[$typeColonIndex]->isGivenKind(CT::T_TYPE_COLON)) {
+        return $entries;
+    }
+
+    $typeStartIndex = $tokens->getNextMeaningfulToken($typeColonIndex);
+    $functionBodyStart = $tokens->getNextTokenOfKind($typeColonIndex, ['{', ';', [T_DOUBLE_ARROW]]);
+    if (null === $typeStartIndex || null === $functionBodyStart) {
+        return $entries;
+    }
+
+    $type = '';
+    $typeEndIndex = $typeStartIndex;
+    for ($i = $typeStartIndex; $i < $functionBodyStart; ++$i) {
+        if ($tokens[$i]->isWhitespace() || $tokens[$i]->isComment()) {
+            continue;
+        }
+
+        $type .= $tokens[$i]->getContent();
+        $typeEndIndex = $i;
+    }
+
+    if ('' === $type) {
+        return $entries;
+    }
+
+    $entries[] = [
+        'name' => ':return',
+        'type' => $type,
+        'nullable' => str_starts_with($type, '?'),
+        'start' => $typeStartIndex,
+        'end' => $typeEndIndex,
+    ];
+
+    return $entries;
+}
+
+
+/**
+ * @param list<array<string, mixed>> $entries
+ *
+ * @return list<array<string, mixed>>
+ */
+private function sanitizeFunctionTypeEntries(array $entries): array
+{
+    $sanitized = [];
+
+    foreach ($entries as $entry) {
+        $name = $entry['name'] ?? null;
+        $type = $entry['type'] ?? null;
+        if (null === $type || '' === $type) {
+            $sanitized[] = $entry;
+
+            continue;
+        }
+
+        $entry['type'] = $this->stripNullablePrefix((string) $type);
+        $entry += ['type' => ''];
+            $entry += ['nullable' => str_starts_with((string) $entry['type'], '?')];
+            $entry['nullable'] = (bool) $entry['nullable'];
+        $entry['name'] = $name;
+        $sanitized[] = $entry;
+    }
+
+    return $sanitized;
+}
+
+
+private function recordFunctionSignature(FunctionsAnalyzer $functionsAnalyzer, Tokens $tokens, int $index, string $namespaceName): void
+{
+    $entries = $this->collectFunctionTypeEntries($functionsAnalyzer, $tokens, $index);
+    $this->functionSignatureLedger[$index] = $this->annotateFunctionEntriesWithNamespace($entries, $namespaceName);
+    $this->indexFunctionEntriesByName($index);
+    $this->indexFunctionEntriesByType($index);
+}
+
+
+/**
+ * @param list<array<string, mixed>> $entries
+ *
+ * @return list<array<string, mixed>>
+ */
+private function annotateFunctionEntriesWithNamespace(array $entries, string $namespaceName): array
+{
+    $annotated = [];
+
+    foreach ($entries as $entry) {
+        $entry['namespace'] = $namespaceName;
+        $entry += ['type' => ''];
+        $type = (string) $entry['type'];
+        $entry['qualified'] = $this->isQualifiedTypeName($type);
+        $entry['reserved'] = $this->isReservedTypeName($type);
+        $annotated[] = $entry;
+    }
+
+    return $annotated;
+}
+
+
+private function indexFunctionEntriesByName(int $index): void
+{
+    if (!isset($this->functionSignatureLedger[$index])) {
+        return;
+    }
+
+    $named = [];
+    foreach ($this->functionSignatureLedger[$index] as $entry) {
+        $name = $entry['name'] ?? null;
+        if (null === $name || '' === $name) {
+            continue;
+        }
+
+        $named[$name] = $entry;
+    }
+
+    foreach ($this->functionSignatureLedger[$index] as $i => $entry) {
+        $name = $entry['name'] ?? null;
+        if (null !== $name && isset($named[$name])) {
+            $this->functionSignatureLedger[$index][$i]['indexed'] = true;
+        }
+    }
+}
+
+
+private function indexFunctionEntriesByType(int $index): void
+{
+    if (!isset($this->functionSignatureLedger[$index])) {
+        return;
+    }
+
+    foreach ($this->functionSignatureLedger[$index] as $i => $entry) {
+        $entry += ['type' => ''];
+        $type = (string) $entry['type'];
+        if ('' === $type) {
+            $this->functionSignatureLedger[$index][$i]['type_key'] = null;
+
+            continue;
+        }
+
+        $this->functionSignatureLedger[$index][$i]['type_key'] = strtolower(ltrim($type, '\\'));
+    }
+}
