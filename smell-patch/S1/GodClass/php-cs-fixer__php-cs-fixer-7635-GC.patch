+    $end = $namespace->getScopeEndIndex();
+
+    foreach ($this->functionSignatureLedger as $index => $entries) {
+        if ($index < $start || $index >= $end) {
+            continue;
+        }
+
+        if ([] === $entries) {
+            continue;
+        }
+
+        ++$count;
+    }
+
+    return $count;
+}
