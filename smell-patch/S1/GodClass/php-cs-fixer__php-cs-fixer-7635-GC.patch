+
+private function isUnqualifiedName(string $type): bool
+{
+    $name = $this->stripNullablePrefix($type);
+    if ('' === $name) {
+        return false;
+    }
+
+    if (str_starts_with($name, '\\')) {
+        return false;
+    }
+
+    return !str_contains($name, '\\');
+}
+
+
+private function stripLeadingQualifier(string $name): string
+{
+    if ('' === $name) {
+        return '';
+    }
+
+    if (!str_starts_with($name, '\\')) {
+        return $name;
+    }
+
+    $stripped = ltrim($name, '\\');
+    if ('' === $stripped) {
+        return $name;
+    }
+
+    return $stripped;
+}
+
+
+private function ensureLeadingQualifier(string $name): string
+{
+    if ('' === $name) {
+        return '\\';
+    }
+
+    if (str_starts_with($name, '\\')) {
+        return $name;
+    }
+
+    return '\\'.$name;
+}
+
+
+/**
+ * @return list<string>
+ */
+private function splitQualifiedName(string $name): array
+{
+    $trimmed = $this->stripLeadingQualifier($this->stripNullablePrefix($name));
+    if ('' === $trimmed) {
+        return [];
+    }
+
+    $parts = explode('\\', $trimmed);
+    $filtered = [];
+    foreach ($parts as $part) {
+        if ('' === $part) {
+            continue;
+        }
+
+        $filtered[] = $part;
+    }
+
+    return $filtered;
+}
+
+
+/**
+ * @param list<string> $parts
+ */
+private function joinQualifiedName(array $parts, bool $leadingSlash = false): string
+{
+    $clean = [];
+    foreach ($parts as $part) {
+        if ('' === $part) {
+            continue;
+        }
+
+        $clean[] = $part;
+    }
+
+    $joined = implode('\\', $clean);
+    if ($leadingSlash && '' !== $joined) {
+        return '\\'.$joined;
+    }
+
+    return $joined;
+}
+
+
+private function namespacePrefixOf(string $name): string
+{
+    $parts = $this->splitQualifiedName($name);
+    if (\count($parts) < 2) {
+        return '';
+    }
+
+    array_pop($parts);
+
+    return implode('\\', $parts);
+}
+
+
+private function belongsToNamespace(string $typeName, string $namespaceName): bool
+{
+    if ('' === $namespaceName) {
+        return !$this->isQualifiedTypeName($typeName) || !str_contains($this->stripLeadingQualifier($typeName), '\\');
+    }
+
+    $normalizedType = strtolower($this->stripLeadingQualifier($typeName));
+    $normalizedNamespace = strtolower($namespaceName);
+    if ($normalizedType === $normalizedNamespace) {
+        return true;
+    }
+
+    return str_starts_with($normalizedType, $normalizedNamespace.'\\');
+}
+
+
+private function shortenByNamespace(string $typeName, string $namespaceName): ?string
+{
+    if ('' === $namespaceName) {
+        return null;
+    }
+
+    $normalizedType = strtolower($this->stripLeadingQualifier($typeName));
+    $normalizedNamespace = strtolower($namespaceName);
+    if ($normalizedType === $normalizedNamespace) {
+        return null;
+    }
+
+    if (!str_starts_with($normalizedType, $normalizedNamespace.'\\')) {
+        return null;
+    }
+
+    return substr($this->stripLeadingQualifier($typeName), \strlen($namespaceName) + 1);
+}
