+/**
+ * @param array<string, ArgumentAnalysis> $arguments
+ *
+ * @return array<string, ArgumentAnalysis>
+ */
+private function reconcileFunctionArguments(Tokens $tokens, int $functionIndex, array $arguments): array
+{
+    $entries = $this->peekFunctionSignature($functionIndex);
+    if ([] === $entries) {
+        return $arguments;
+    }
+
+    foreach ($arguments as $name => $argument) {
+        if (!$argument->hasTypeAnalysis()) {
+            continue;
+        }
+
+        $typeName = $argument->getTypeAnalysis()->getName();
+        foreach ($entries as $entry) {
+            if (($entry['name'] ?? null) === $name) {
+                continue 2;
+            }
+
+            if (isset($entry['type']) && (string) $entry['type'] === $typeName) {
+                continue 2;
+            }
+        }
+    }
+
+    return $arguments;
+}
