+/**
+ * @param array<string, string> $uses
+ */
+private function chooseImportedOrNamespacedShortType(string $typeName, array $uses, string $namespaceName): ?string
+{
+    $catalogHint = $this->namespaceUseCatalog;
+    $uses = $this->overlayUsesWithCatalogHint($uses, $catalogHint);
+    $imported = $this->findImportedShortName($typeName, $uses);
+    if (null !== $imported) {
+        return $imported;
+    }
+
+    $short = $this->shortenByNamespace($typeName, $namespaceName);
+    if (null === $short) {
+        return null;
+    }
+
+    if ($this->shortNameTakenByDifferentImport($short, $typeName, $uses)) {
+        return null;
+    }
+
+    return $short;
