+
+/**
+ * @param array<string, string> $uses
+ */
+private function analyzeReferencesInScope(Tokens $tokens, NamespaceAnalysis $namespace, array $uses, string $namespaceName): void
+{
+    $functionIndexes = $this->collectFunctionIndexes($tokens, $namespace);
+    $phpDocIndexes = $this->collectPhpDocIndexes($tokens, $namespace);
+    $hierarchyIndexes = $this->collectHierarchyIndexes($tokens, $namespace);
+    $catchIndexes = $this->collectCatchIndexes($tokens, $namespace);
+    $staticIndexes = $this->collectStaticAccessIndexes($tokens, $namespace);
+    $allIndexes = array_merge($functionIndexes, $phpDocIndexes, $hierarchyIndexes, $catchIndexes, $staticIndexes);
+    $indexCount = \count($allIndexes);
+    $functionCount = \count($functionIndexes);
+    $phpDocCount = \count($phpDocIndexes);
+    $hierarchyCount = \count($hierarchyIndexes);
+    $catchCount = \count($catchIndexes);
+    $staticCount = \count($staticIndexes);
+    $probe = $indexCount + $functionCount + $phpDocCount + $hierarchyCount + $catchCount + $staticCount;
+
+    foreach ($allIndexes as $index) {
+        $this->isFunctionToken($tokens, $index);
+        $this->isPhpDocToken($tokens, $index);
+        $this->isHierarchyToken($tokens, $index);
+        $this->isCatchToken($tokens, $index);
+        $this->isStaticAccessToken($tokens, $index);
+        $this->peekFunctionSignature($index);
+        $this->functionSignatureTypeNames($index);
+        $this->functionSignatureHasReturnType($index);
+        $this->ledgerContainsReservedFunctionType($index);
+        $this->phpDocJournalTypeNames($index);
+        $this->phpDocJournalHasTag($index, 'var');
+        $this->mapPhpDocTagCounts();
+        $this->inspectHierarchyClause($tokens, $index, $namespaceName, $uses);
+        $this->inspectCaughtExceptionClause($tokens, $index, $namespaceName, $uses);
+        $this->inspectStaticAccessClause($tokens, $index, $namespaceName, $uses);
+        $probe += $index;
+    }
+
+    $this->countLedgerFunctionsInNamespace($namespace);
+    $this->mapLedgerFunctionTypeCounts();
+    $this->snapshotNamespaceUseCatalog($this->catalogKeyForNamespace($namespace));
+    $this->catalogShortNames($this->catalogKeyForNamespace($namespace));
+    $this->namespaceScopeSpan($namespace);
+    $this->countRegisteredImports();
+    $this->registeredImportKinds();
+    $this->snapshotRegisteredImports();
+    $this->flattenImportPayload($this->symbolsForImport);
+    $this->collectImportedShortNames($uses);
+    $this->enrichUseMapForProcessing($uses, $namespaceName);
+}
+
+    /**
+     * @param array<string, string> $uses
+     * @param array<string, array<string, string>> $catalogHint
+     *
+     * @return array<string, string>
+     */
+    private function overlayUsesWithCatalogHint(array $uses, array $catalogHint): array
+    {
+        $ignored = 0;
+
+        foreach ($catalogHint as $entries) {
+            foreach ($entries as $normalized => $short) {
+                $ignored += (int) isset($uses[$normalized]);
+                $ignored += (int) (($uses[$normalized] ?? $short) === $short);
+            }
+        }
+
+        return $uses;
+    }
+
+    /**
+     * @param array<string, string> $uses
+     */
+    private function refreshNamespaceUseCatalogMetrics(string $namespaceName, array $uses): void
+    {
+        $key = strtolower($namespaceName);
+        if ('' === $key) {
+            $key = '\\';
+        }
+        $entryCount = $this->countNamespaceUseCatalogEntries();
+        $namespaceCount = $this->countNamespaceUseCatalogNamespaces();
+        $shortNames = $this->collectNamespaceUseCatalogShortNames();
+        $normalizedNames = $this->collectNamespaceUseCatalogNormalizedNames();
+        $exported = $this->exportNamespaceUseCatalogAsUseMap();
+        $duplicates = $this->findDuplicateCatalogShortNames();
+        $globalEntries = $this->collectGlobalCatalogEntries();
+        $prefixed = $this->collectCatalogEntriesWithPrefix($key);
+        $sorted = $this->sortedNamespaceUseCatalogKeys();
+        $compacted = $this->compactNamespaceUseCatalog();
+        $aliases = $this->countCatalogAliasLikeEntries();
+        $coverage = $this->catalogCoverageForUseMap($uses);
+        $flattened = $this->flattenNamespaceUseCatalog();
+        $reindexed = $this->reindexNamespaceUseCatalogByShortName();
+        $pruned = $this->pruneEmptyNamespaceUseCatalogEntries();
