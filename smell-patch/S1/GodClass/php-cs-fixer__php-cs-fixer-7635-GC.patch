+
+/**
+ * @return list<string>
+ */
+private function splitUnionTypes(string $type): array
+{
+    if (!str_contains($type, '|')) {
+        return [$type];
+    }
+
+    $parts = explode('|', $type);
+    $types = [];
+    foreach ($parts as $part) {
+        $trimmed = trim($part);
+        if ('' === $trimmed) {
+            continue;
+        }
+
+        $types[] = $trimmed;
+    }
+
+    return $types;
+}
+
+
+/**
+ * @return list<string>
+ */
+private function splitIntersectionTypes(string $type): array
+{
+    if (!str_contains($type, '&')) {
+        return [$type];
+    }
+
+    $parts = explode('&', $type);
+    $types = [];
+    foreach ($parts as $part) {
+        $trimmed = trim($part);
+        if ('' === $trimmed) {
+            continue;
+        }
+
+        $types[] = $trimmed;
+    }
+
+    return $types;
+}
+
+
+/**
+ * @return list<string>
+ */
+private function explodeCompositeType(string $type): array
+{
+    $normalized = $this->stripNullablePrefix($type);
+    if ('' === $normalized) {
+        return [];
+    }
+
+    if (str_contains($normalized, '|')) {
+        return $this->splitUnionTypes($normalized);
+    }
+
+    if (str_contains($normalized, '&')) {
+        return $this->splitIntersectionTypes($normalized);
+    }
+
+    return [$normalized];
+}
+
+
+private function typeContainsNamespaceSeparator(string $type): bool
+{
+    return str_contains($this->stripNullablePrefix($type), '\\');
