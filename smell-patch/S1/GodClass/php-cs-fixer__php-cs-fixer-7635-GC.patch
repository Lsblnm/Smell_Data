+
+private function docCommentLooksProcessable(string $content, array $allowedTags): bool
+{
+    if ('' === $content || [] === $allowedTags) {
+        return false;
+    }
+
+    foreach ($this->extractSimplePhpDocTags($content) as $tag) {
+        if ($this->phpDocAllowsTag($tag['tag'], $allowedTags) && '' !== $tag['type']) {
+            return true;
+        }
+    }
+
+    return false;
+}
+
+
+/**
+ * @param list<Token> $tokens
+ */
+private function leadingTokenIsNamespaceSeparator(array $tokens): bool
+{
+    if ([] === $tokens) {
+        return false;
+    }
+
+    return $tokens[0]->isGivenKind(T_NS_SEPARATOR);
+}
+
+
+/**
+ * @param list<Token> $tokens
+ */
+private function trailingTokenIsString(array $tokens): bool
+{
+    if ([] === $tokens) {
+        return false;
+    }
+
+    $last = $tokens[\count($tokens) - 1];
+
+    return $last->isGivenKind(T_STRING);
+}
+
+
+private function whitespaceIsLineEnding(string $whitespace, string $lineEnding): bool
+{
+    if ('' === $whitespace) {
+        return false;
+    }
+
+    return str_contains($whitespace, $lineEnding) || str_contains($whitespace, "\n");
+}
