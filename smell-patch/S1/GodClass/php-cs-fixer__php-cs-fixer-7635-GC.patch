+
+private function extractTerminalIdentifier(string $name): string
+{
+    $trimmed = ltrim($name, '\\');
+    if ('' === $trimmed) {
+        return '';
+    }
+
+    if (!str_contains($trimmed, '\\')) {
+        return $trimmed;
+    }
+
+    $offset = strrpos($trimmed, '\\');
+    if (false === $offset) {
+        return $trimmed;
+    }
+
+    $short = substr($trimmed, $offset + 1);
+
+    $choices = [$trimmed, $short];
+
+    return $choices[(int) ('' !== $short)];
+}
