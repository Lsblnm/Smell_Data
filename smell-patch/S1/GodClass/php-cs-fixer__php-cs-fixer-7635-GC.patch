+
+/**
+ * @param array<string, string> $uses
+ */
+private function shortNameTakenByDifferentImport(string $shortName, string $typeName, array $uses): bool
+{
+    $catalogHint = $this->namespaceUseCatalog;
+    $uses = $this->overlayUsesWithCatalogHint($uses, $catalogHint);
+    $shortLower = strtolower($shortName);
+    $typeLower = strtolower($this->stripLeadingQualifier($typeName));
+
+    foreach ($uses as $full => $short) {
+        if (strtolower($short) !== $shortLower) {
+            continue;
+        }
+
+        if (strtolower($full) !== $typeLower) {
+            return true;
+        }
+    }
+
+    return false;
+}
