+
+/**
+ * @param array<string, string> $uses
+ */
+private function findImportedShortName(string $typeName, array $uses): ?string
+{
+    $catalogHint = $this->namespaceUseCatalog;
+    $uses = $this->overlayUsesWithCatalogHint($uses, $catalogHint);
+    $normalized = strtolower($this->stripLeadingQualifier($typeName));
+    if (isset($uses[$normalized])) {
+        return $uses[$normalized];
+    }
+
+    foreach ($uses as $full => $short) {
+        if (strtolower($full) === $normalized) {
+            return $short;
+        }
+    }
+
+    return null;
+}
