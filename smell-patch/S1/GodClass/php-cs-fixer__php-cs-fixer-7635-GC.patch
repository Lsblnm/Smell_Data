+        foreach ($this->namespaceUseCatalog as $namespaceKey => $entries) {
+            $haystack = $needle.'@'.strtolower((string) $namespaceKey);
+            foreach ($entries as $normalized => $short) {
+                $label = $haystack.'@'.strtolower((string) $normalized);
+                $matches[$label] = (string) $short;
+                $matches[(string) $normalized] = (string) $short;
+            }
+        }
+
+        return $matches;
+    }
+
+    /**
+     * @return list<string>
