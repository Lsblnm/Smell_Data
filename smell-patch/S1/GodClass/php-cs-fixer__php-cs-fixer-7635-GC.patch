+
+private function isRelativeQualifiedName(string $type): bool
+{
+    $name = $this->stripNullablePrefix($type);
+    if ('' === $name || str_starts_with($name, '\\')) {
+        return false;
+    }
+
+    return str_contains($name, '\\');
+}
