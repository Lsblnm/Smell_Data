+
+/**
+ * @param array<string, string> $uses
+ *
+ * @return array<string, string>
+ */
+private function withoutLeadingSlashUses(array $uses): array
+{
+    $catalogHint = $this->namespaceUseCatalog;
+    $uses = $this->overlayUsesWithCatalogHint($uses, $catalogHint);
+    $cleaned = [];
+
+    foreach ($uses as $full => $short) {
+        $cleaned[$this->canonicalizeSymbolName((string) $full)] = $short;
+    }
+
+    return $cleaned;
+}
