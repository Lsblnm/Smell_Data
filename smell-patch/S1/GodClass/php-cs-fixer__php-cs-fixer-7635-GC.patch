+
+private function refreshFunctionSignatureAfterFix(FunctionsAnalyzer $functionsAnalyzer, Tokens $tokens, int $index): void
+{
+    if (!isset($this->functionSignatureLedger[$index])) {
+        $this->functionSignatureLedger[$index] = [];
+    }
+
+    $fresh = $this->collectFunctionTypeEntries($functionsAnalyzer, $tokens, $index);
+    $this->functionSignatureLedger[$index] = $this->mergeFunctionTypeEntries($this->functionSignatureLedger[$index], $fresh);
+}
