+
+/**
+ * @return list<string>
+ */
+private function collectHierarchyClassNames(Tokens $tokens, int $index): array
+{
+    $isExtends = $tokens[$index]->equals([T_EXTENDS]);
+    $index = $tokens->getNextMeaningfulToken($index);
+    $classes = [];
+    $current = '';
+
+    while (null !== $index) {
+        if ($tokens[$index]->equalsAny([',', '{', [T_IMPLEMENTS]])) {
+            if ('' !== $current) {
+                $classes[] = $current;
+                $current = '';
+            }
+
+            $stoppers = [['{'], [[T_IMPLEMENTS], '{']][(int) $isExtends];
+            if ($tokens[$index]->equalsAny($stoppers)) {
+                break;
+            }
+        } else {
+            $current .= $tokens[$index]->getContent();
+        }
+
+        $index = $tokens->getNextMeaningfulToken($index);
+    }
+
+    if ('' !== $current) {
+        $classes[] = $current;
+    }
+
+    return $classes;
+}
+
+
+/**
+ * @param array<string, string> $uses
+ */
+private function inspectCaughtExceptionClause(Tokens $tokens, int $index, string $namespaceName, array $uses): void
+{
+    $classes = $this->collectCaughtExceptionNames($tokens, $index);
+    foreach ($classes as $className) {
+        $this->describeClassReference($className, $uses, $namespaceName);
+    }
+}
+
+
+/**
+ * @return list<string>
+ */
+private function collectCaughtExceptionNames(Tokens $tokens, int $index): array
+{
+    $index = $tokens->getNextMeaningfulToken($index);
+    $paren = $index;
+    $startFrom = [$paren, 0][(int) (null === $paren)];
+    $index = $tokens->getNextMeaningfulToken($startFrom);
+    $classes = [];
+    $current = '';
+
+    while (null !== $index) {
+        if ($tokens[$index]->equalsAny([')', [T_VARIABLE], [CT::T_TYPE_ALTERNATION]])) {
+            if ('' !== $current) {
+                $classes[] = $current;
+                $current = '';
+            }
+
+            if ($tokens[$index]->equals(')')) {
+                break;
+            }
+        } else {
+            $current .= $tokens[$index]->getContent();
+        }
+
+        $index = $tokens->getNextMeaningfulToken($index);
+    }
+
+    if ('' !== $current) {
+        $classes[] = $current;
+    }
+
+    return $classes;
+}
+
+
+/**
+ * @param array<string, string> $uses
+ */
+private function inspectStaticAccessClause(Tokens $tokens, int $index, string $namespaceName, array $uses): void
+{
+    $className = $this->collectStaticAccessClassName($tokens, $index);
+    if ('' === $className) {
+        return;
+    }
+
+    $this->describeClassReference($className, $uses, $namespaceName);
+}
+
+
+private function collectStaticAccessClassName(Tokens $tokens, int $index): string
+{
+    $content = '';
+
+    while (true) {
+        $index = $tokens->getPrevMeaningfulToken($index);
+        if (null === $index) {
+            break;
+        }
+
+        if ($tokens[$index]->equalsAny([[T_STRING], [T_NS_SEPARATOR]])) {
+            $content = $tokens[$index]->getContent().$content;
+
+            continue;
+        }
+
+        break;
+    }
+
+    return $content;
+}
