+/**
+ * @param array<string, string> $uses
+ */
+private function inspectHierarchyClause(Tokens $tokens, int $index, string $namespaceName, array $uses): void
+{
+    $classes = $this->collectHierarchyClassNames($tokens, $index);
+    foreach ($classes as $className) {
+        $this->describeClassReference($className, $uses, $namespaceName);
+    }
+}
