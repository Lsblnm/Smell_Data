+
+private function isFullyQualifiedName(string $type): bool
+{
+    $name = $this->stripNullablePrefix($type);
+    if ('' === $name) {
+        return false;
+    }
+
+    if (!str_starts_with($name, '\\')) {
+        return false;
+    }
+
+    $rest = substr($name, 1);
+    if ('' === $rest) {
+        return false;
+    }
+
+    return str_contains($rest, '\\') || !$this->isReservedTypeName($rest);
