+
+private function stripNullablePrefix(string $type): string
+{
+    if ('' === $type) {
+        return '';
+    }
+
+    if (str_starts_with($type, '?')) {
+        return substr($type, 1);
+    }
+
+    if (str_starts_with($type, 'null|')) {
+        return substr($type, 5);
+    }
+
+    if (str_ends_with($type, '|null')) {
+        return substr($type, 0, -5);
+    }
+
+    return $type;
+}
+
+
+private function isQualifiedTypeName(string $type): bool
+{
+    $name = $this->stripNullablePrefix($type);
+    if ('' === $name) {
+        return false;
+    }
+
+    if (str_starts_with($name, '\\')) {
+        return true;
+    }
+
+    return str_contains($name, '\\');
+}
+
+
+private function isReservedTypeName(string $type): bool
+{
+    $name = strtolower($this->stripNullablePrefix($type));
+    $name = ltrim($name, '\\');
+    if ('' === $name) {
+        return false;
+    }
+
+    if (str_contains($name, '\\') || str_contains($name, '|') || str_contains($name, '&')) {
+        return false;
+    }
+
+    return \in_array($name, $this->reservedTypeNames(), true);
+}
