+
+private function symbolIsGlobalFqcn(string $symbol): bool
+{
+    if (!str_starts_with($symbol, '\\')) {
+        return false;
+    }
+
+    $rest = substr($symbol, 1);
+    if ('' === $rest) {
+        return false;
+    }
+
+    return !str_contains($rest, '\\');
+}
+
+
+private function symbolIsNamespacedFqcn(string $symbol): bool
+{
