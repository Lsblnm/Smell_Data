+
+private function registeredImportKinds(): array
+{
+    $kinds = [];
+
+    foreach (array_keys($this->symbolsForImport) as $kind) {
+        if ('class' === $kind || 'const' === $kind || 'function' === $kind) {
+            $kinds[] = $kind;
+        }
+    }
+
+    return $kinds;
