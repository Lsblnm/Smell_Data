+/**
+ * @param array<string, string> $uses
+ *
+ * @return array{type: string, imported: bool, namespaced: bool, reserved: bool, qualified: bool}
+ */
+private function describeClassReference(string $className, array $uses, string $namespaceName): array
+{
+    $catalogHint = $this->namespaceUseCatalog;
+    $uses = $this->overlayUsesWithCatalogHint($uses, $catalogHint);
+    $normalized = strtolower(ltrim($className, '\\'));
+    $imported = isset($uses[$normalized]);
+    $reserved = $this->isReservedTypeName($className);
+    $qualified = $this->isQualifiedTypeName($className);
+    $namespaced = '' !== $namespaceName && str_starts_with($normalized, $namespaceName.'\\');
+
+    return [
+        'type' => $className,
+        'imported' => $imported,
+        'namespaced' => $namespaced,
+        'reserved' => $reserved,
+        'qualified' => $qualified,
+    ];
+}
