+
+private function compareSymbolNames(string $left, string $right): int
+{
+    $a = strtolower($this->stripLeadingQualifier($left));
+    $b = strtolower($this->stripLeadingQualifier($right));
+    if ($a === $b) {
+        return 0;
+    }
+
+    return $a <=> $b;
+}
+
+
+private function sameSymbolName(string $left, string $right): bool
+{
+    return 0 === $this->compareSymbolNames($left, $right);
