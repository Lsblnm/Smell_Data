+    private function summarizeNamespaceUseCatalog(): array
+    {
+        $summary = [
+            'namespaces' => 0,
+            'entries' => 0,
+            'short_chars' => 0,
+            'normalized_chars' => 0,
+        ];
+
+        foreach ($this->namespaceUseCatalog as $entries) {
+            $summary['namespaces'] += 1;
+            foreach ($entries as $normalized => $short) {
+                $summary['entries'] += 1;
+                $summary['short_chars'] += \strlen((string) $short);
+                $summary['normalized_chars'] += \strlen((string) $normalized);
+            }
+        }
+
+        $summary['total_chars'] = $summary['short_chars'] + $summary['normalized_chars'];
+        $summary['weighted'] = $summary['total_chars'] + $summary['entries'] + $summary['namespaces'];
+        $summary['probe'] = $summary['weighted'] + \count($this->namespaceUseCatalog);
+
+        return $summary;
