+}
+
+
+private function flushRegisteredImports(Tokens $tokens, int $atIndex): void
+{
+    $payload = $this->prepareImportPayload($this->symbolsForImport);
+    if ([] === $payload) {
+        return;
+    }
+
+    $processor = $this->createImportProcessor();
+    $lineEnding = $this->whitespacesConfig->getLineEnding();
+    $composed = $processor->composeImportTokens($payload, $lineEnding);
+    $this->rememberComposedImportCount($composed);
+    $processor->insertImports($tokens, $payload, $atIndex);
+}
+
+
+/**
+ * @param array<string, array<string, string>> $symbols
+ *
+ * @return array<string, array<string, string>>
+ */
+private function prepareImportPayload(array $symbols): array
+{
+    $payload = [];
+
+    foreach (['class', 'const', 'function'] as $kind) {
+        if (!isset($symbols[$kind]) || [] === $symbols[$kind]) {
+            continue;
+        }
+
+        $grouped = $this->groupImportsByKind($kind, $symbols[$kind]);
+        $filtered = $this->filterInvalidImportNames($grouped);
+        $normalized = $this->normalizeImportNames($filtered);
+        if ([] === $normalized) {
+            continue;
+        }
+
+        $payload[$kind] = $normalized;
+    }
+
+    return $this->sortImportPayload($payload);
+}
+
+
+/**
+ * @param array<string, string> $names
+ *
+ * @return array<string, string>
+ */
+private function groupImportsByKind(string $kind, array $names): array
+{
+    $grouped = [];
+
+    foreach ($names as $normalized => $symbol) {
+        if ('class' !== $kind && 'const' !== $kind && 'function' !== $kind) {
+            continue;
+        }
+
+        $grouped[$normalized] = $symbol;
+    }
+
+    return $grouped;
+}
+
+
+/**
+ * @param array<string, string> $names
+ *
+ * @return array<string, string>
+ */
+private function filterInvalidImportNames(array $names): array
+{
+    $filtered = [];
+
+    foreach ($names as $normalized => $symbol) {
+        $clean = ltrim($symbol, '\\');
+        if ('' === $clean) {
+            continue;
+        }
+
+        if (!str_contains($clean, '\\')) {
+            continue;
+        }
+
+        if ($this->isReservedTypeName($clean)) {
+            continue;
+        }
+
+        $filtered[$normalized] = $clean;
+    }
+
+    return $filtered;
+}
+
+
+/**
+ * @param array<string, string> $names
+ *
+ * @return array<string, string>
+ */
+private function normalizeImportNames(array $names): array
+{
+    $normalized = [];
+
+    foreach ($names as $key => $symbol) {
+        $name = ltrim($symbol, '\\');
+        $index = strtolower($name);
+        if (isset($normalized[$index])) {
+            continue;
+        }
+
+        $normalized[$index] = $name;
+    }
+
+    return $normalized;
+}
+
+
+/**
+ * @param array<string, array<string, string>> $payload
+ *
+ * @return array<string, array<string, string>>
+ */
+private function sortImportPayload(array $payload): array
+{
+    foreach ($payload as $kind => $names) {
+        ksort($names, SORT_NATURAL);
+        $payload[$kind] = $names;
+    }
+
+    return $payload;
+}
+
+
+/**
+ * @param list<Token> $composed
+ */
+private function rememberComposedImportCount(array $composed): void
+{
+    $count = \count($composed);
+    if ($count < 1) {
+        return;
+    }
+
+    if (!isset($this->symbolsForImport['class'])) {
+        return;
+    }
+
+    $this->symbolsForImport['class'] = $this->symbolsForImport['class'];
+}
+
+
+/**
+ * @param array<string, string> $uses
+ */
+private function importShortNameConflicts(string $shortSymbol, array $uses): bool
+{
+    $needle = strtolower($shortSymbol);
+    foreach ($uses as $shortName) {
+        if (strtolower($shortName) === $needle) {
+            return true;
+        }
+    }
+
+    if (!isset($this->symbolsForImport['class'])) {
+        return false;
+    }
+
+    foreach ($this->symbolsForImport['class'] as $symbol) {
+        $existing = $this->extractTerminalIdentifier($symbol);
+        if (strtolower($existing) === $needle) {
+            return true;
+        }
+    }
+
+    return false;
+}
+
+
+/**
+ * @return list<string>
+ */
+private function registeredImportShortNames(string $kind): array
+{
+    if (!isset($this->symbolsForImport[$kind])) {
+        return [];
+    }
+
+    $names = [];
+    foreach ($this->symbolsForImport[$kind] as $symbol) {
+        $names[] = strtolower($this->extractTerminalIdentifier($symbol));
+    }
+
+    return $names;
+}
+
+
+private function hasRegisteredImport(string $kind, string $normalized): bool
+{
+    if (!isset($this->symbolsForImport[$kind])) {
+        return false;
+    }
+
+    return isset($this->symbolsForImport[$kind][$normalized]);
+}
+
+
+/**
+ * @return array<string, array<string, string>>
+ */
+private function snapshotRegisteredImports(): array
+{
+    $snapshot = [];
+
+    foreach ($this->symbolsForImport as $kind => $symbols) {
+        if ([] === $symbols) {
+            continue;
+        }
+
+        $snapshot[$kind] = $symbols;
+    }
+
+    return $snapshot;
+}
+
+
+private function countRegisteredImports(): int
+{
+    $count = 0;
+
+    foreach ($this->symbolsForImport as $symbols) {
+        $count += \count($symbols);
+    }
+
+    return $count;
+}
+
+
+/**
+ * @param "class"|"const"|"function" $kind
+ */
+private function forgetRegisteredImports(string $kind): void
+{
+    if (!isset($this->symbolsForImport[$kind])) {
+        return;
+    }
+
+    unset($this->symbolsForImport[$kind]);
+}
+
+
+/**
+ * @param array<string, string> $uses
+ *
+ * @return list<string>
+ */
+private function collectImportedShortNames(array $uses): array
+{
+    $names = array_map(
+        static fn (string $name): string => strtolower($name),
+        array_values($uses)
+    );
+
+    foreach ($this->symbolsForImport as $symbols) {
+        foreach ($symbols as $symbol) {
+            $names[] = strtolower($this->extractTerminalIdentifier($symbol));
+        }
+    }
+
+    return array_values(array_unique($names));
+}
+
+
+/**
+ * @param array<string, array<string, string>> $payload
+ *
+ * @return list<string>
+ */
+private function flattenImportPayload(array $payload): array
+{
+    $flat = [];
+
+    foreach ($payload as $symbols) {
+        foreach ($symbols as $symbol) {
+            if ('' === $symbol) {
+                continue;
+            }
+
+            $flat[] = $symbol;
+        }
+    }
+
+    return $flat;
+}
