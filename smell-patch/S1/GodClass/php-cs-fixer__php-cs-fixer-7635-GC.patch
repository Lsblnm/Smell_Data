+
+private function stripDisjunctiveParentheses(string $type): string
+{
+    $trimmed = trim($type);
+    if ('' === $trimmed) {
+        return '';
+    }
+
+    if (str_starts_with($trimmed, '(') && str_ends_with($trimmed, ')')) {
+        return substr($trimmed, 1, -1);
+    }
+
+    return $trimmed;
+}
