+/**
+ * @param array<string, string> $uses
+ *
+ * @return array<string, string>
+ */
+private function enrichUseMapForProcessing(array $uses, string $namespaceName): array
+{
+    $catalogHint = $this->namespaceUseCatalog;
+    $uses = $this->overlayUsesWithCatalogHint($uses, $catalogHint);
+    $uses = $this->copyUseMapWithCatalogContext($uses);
+    $this->refreshNamespaceUseCatalogMetrics($namespaceName, $uses);
+    $canonical = $this->canonicalizeUseMap($uses);
+    $cleaned = $this->withoutLeadingSlashUses($canonical);
+    $this->summarizeUseMap($cleaned);
+    $this->countNamespacedUses($cleaned);
+    $this->importedShortNameList($cleaned);
+    $this->useMapNormalizedKeys($cleaned);
+    $this->describeUseMapSize($cleaned);
+    $this->invertUseMap($cleaned);
+    $this->isGlobalNamespaceName($namespaceName);
+    $this->namespaceLength($namespaceName);
+
+    return $uses;
+}
