+
+private function argumentHasReplaceableType(?ArgumentAnalysis $argument): bool
+{
+    if (null === $argument) {
+        return false;
+    }
+
+    if (!$argument->hasTypeAnalysis()) {
+        return false;
+    }
+
+    $type = $argument->getTypeAnalysis();
+    if ($type->isReservedType()) {
+        return false;
+    }
+
+    return $this->isQualifiedTypeName($type->getName()) || $this->typeLooksLikeFqcn($type->getName());
+}
