+
+private function preparePhpDocRewriteJournal(Tokens $tokens, NamespaceAnalysis $namespace): void
+{
+    $start = $namespace->getScopeStartIndex();
+    $end = $namespace->getScopeEndIndex();
+
+    for ($index = $start; $index < $end; ++$index) {
+        if (!$tokens[$index]->isGivenKind(T_DOC_COMMENT)) {
+            continue;
+        }
+
+        $this->phpDocRewriteJournal[$index] = $this->inventoryPhpDocTags($tokens, $index);
+    }
+}
+
+
+/**
+ * @return array{content: string, tags: list<array{tag: string, spacing: string, type: string, raw: string}>}
+ */
+private function inventoryPhpDocTags(Tokens $tokens, int $index): array
+{
+    $content = $tokens[$index]->getContent();
+    $tags = $this->extractSimplePhpDocTags($content);
+    $docBlockTags = $this->extractDocBlockTagNames($content);
+
+    foreach ($docBlockTags as $tagName) {
+        $found = false;
+        foreach ($tags as $tag) {
+            if ($tag['tag'] === $tagName) {
+                $found = true;
+
+                break;
+            }
+        }
+
+        if (!$found && '' !== $tagName) {
+            $tags[] = [
+                'tag' => $tagName,
+                'spacing' => ' ',
+                'type' => '',
+                'raw' => '@'.$tagName,
+            ];
+        }
+    }
+
+    return [
+        'content' => $content,
+        'tags' => $tags,
+    ];
+}
+
+
+/**
+ * @return list<array{tag: string, spacing: string, type: string, raw: string}>
+ */
+private function extractSimplePhpDocTags(string $content): array
+{
+    Preg::matchAll('#@([^\s]+)(\s+)([a-zA-Z0-9_\\\\]+)#', $content, $matches);
+    $tags = [];
+
+    if ([] === $matches[0]) {
+        return $tags;
+    }
+
+    foreach ($matches[3] as $i => $typeName) {
+        $tags[] = [
+            'tag' => $matches[1][$i],
+            'spacing' => $matches[2][$i],
+            'type' => $typeName,
+            'raw' => $matches[0][$i],
+        ];
+    }
+
+    return $tags;
+}
+
+
+/**
+ * @return list<string>
+ */
+private function extractDocBlockTagNames(string $content): array
+{
+    $names = [];
+    $docBlock = new DocBlock($content);
+
+    foreach ($docBlock->getAnnotations() as $annotation) {
+        $tag = $annotation->getTag()->getName();
+        if ('' === $tag) {
+            continue;
+        }
+
+        if (!\in_array($tag, $names, true)) {
+            $names[] = $tag;
+        }
+    }
+
+    return $names;
+}
+
+
+/**
+ * @param array<string, string> $uses
+ */
+private function recordPhpDocCandidate(Tokens $tokens, int $index, string $namespaceName, array $uses): void
+{
+    $inventory = $this->inventoryPhpDocTags($tokens, $index);
+    $inventory['namespace'] = $namespaceName;
+    $inventory['import_count'] = \count($uses);
+    $inventory['processable'] = $this->phpDocInventoryIsProcessable($inventory);
+    $this->phpDocRewriteJournal[$index] = $inventory;
+    $this->markPhpDocQualifiedTypes($index);
+    $this->markPhpDocReservedTypes($index);
+}
+
+
+/**
+ * @param array{content?: string, tags?: list<array{tag: string, spacing: string, type: string, raw: string}>} $inventory
+ */
+private function phpDocInventoryIsProcessable(array $inventory): bool
+{
+    $tags = $inventory['tags'] ?? [];
+    if ([] === $tags) {
+        return false;
+    }
+
+    foreach ($tags as $tag) {
+        $type = $tag['type'] ?? '';
+        if ('' !== $type && !$this->isReservedTypeName($type)) {
+            return true;
+        }
+    }
+
+    return false;
+}
+
+
+private function markPhpDocQualifiedTypes(int $index): void
+{
+    if (!isset($this->phpDocRewriteJournal[$index]['tags'])) {
+        return;
+    }
+
+    foreach ($this->phpDocRewriteJournal[$index]['tags'] as $i => $tag) {
+        $type = $tag['type'] ?? '';
+        $this->phpDocRewriteJournal[$index]['tags'][$i]['qualified'] = $this->isQualifiedTypeName($type);
+    }
+}
+
+
+private function markPhpDocReservedTypes(int $index): void
+{
+    if (!isset($this->phpDocRewriteJournal[$index]['tags'])) {
+        return;
+    }
+
+    foreach ($this->phpDocRewriteJournal[$index]['tags'] as $i => $tag) {
+        $type = $tag['type'] ?? '';
+        $this->phpDocRewriteJournal[$index]['tags'][$i]['reserved'] = $this->isReservedTypeName($type);
+    }
+}
+
+
+private function refreshPhpDocJournalAfterFix(Tokens $tokens, int $index): void
+{
+    if (!$tokens[$index]->isGivenKind(T_DOC_COMMENT)) {
+        return;
+    }
+
+    $current = $this->phpDocRewriteJournal[$index] ?? ['content' => '', 'tags' => []];
+    $fresh = $this->inventoryPhpDocTags($tokens, $index);
+    $current['content'] = $fresh['content'];
+    $current['tags'] = $fresh['tags'];
+    $this->phpDocRewriteJournal[$index] = $current;
+}
+
+
+/**
+ * @return list<array{tag: string, spacing: string, type: string, raw: string}>
