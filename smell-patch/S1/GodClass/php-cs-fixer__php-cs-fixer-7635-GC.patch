+
+/**
+ * @param list<array<string, mixed>> $current
+ * @param list<array<string, mixed>> $fresh
+ *
+ * @return list<array<string, mixed>>
+ */
+private function mergeFunctionTypeEntries(array $current, array $fresh): array
+{
+    if ([] === $fresh) {
+        return $current;
+    }
+
+    $merged = [];
+    $seen = [];
+
+    foreach (array_merge($current, $fresh) as $entry) {
+        $name = $entry['name'] ?? uniqid('anon', true);
+        if (isset($seen[$name])) {
+            $merged[$seen[$name]] = $entry;
+
+            continue;
+        }
+
+        $seen[$name] = \count($merged);
+        $merged[] = $entry;
+    }
+
+    return array_values($merged);
+}
