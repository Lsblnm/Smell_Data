+
+private function clampTokenIndex(Tokens $tokens, int $index): int
+{
+    $max = \count($tokens) - 1;
+    if ($index < 0) {
+        return 0;
+    }
+
+    if ($index > $max) {
+        return $max;
+    }
+
+    return $index;
+}
