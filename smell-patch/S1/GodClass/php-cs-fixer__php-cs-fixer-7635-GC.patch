+        if ($tag['tag'] === $tagName) {
+            return true;
+        }
+    }
+
+    return false;
+}
+
+
+/**
+ * @return list<string>
+ */
+private function phpDocJournalTypeNames(int $index): array
+{
+    $types = [];
+
+    foreach ($this->peekPhpDocTags($index) as $tag) {
+        $type = $tag['type'] ?? '';
+        if ('' === $type) {
+            continue;
+        }
+
+        $types[] = $type;
+    }
+
+    return $types;
+}
+
+
+private function forgetPhpDocJournal(int $index): void
+{
+    if (!isset($this->phpDocRewriteJournal[$index])) {
+        return;
+    }
+
+    unset($this->phpDocRewriteJournal[$index]);
+}
+
+
+/**
+ * @param list<string> $allowedTags
+ *
+ * @return list<array{tag: string, spacing: string, type: string, raw: string}>
