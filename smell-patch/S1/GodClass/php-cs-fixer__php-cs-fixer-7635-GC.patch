+
+/**
+ * @param array<string, ArgumentAnalysis> $arguments
+ *
+ * @return list<string>
+ */
+private function collectReplaceableArgumentTypeNames(array $arguments): array
+{
+    $types = [];
+
+    foreach ($arguments as $argument) {
+        if (!$this->argumentHasReplaceableType($argument)) {
+            continue;
+        }
+
+        $types[] = $argument->getTypeAnalysis()->getName();
+    }
+
+    return $types;
+}
+
+
+private function returnTypeIsReplaceable(?TypeAnalysis $returnType): bool
+{
+    if (null === $returnType) {
+        return false;
+    }
+
+    if ($returnType->isReservedType()) {
+        return false;
+    }
+
+    $name = $returnType->getName();
+
+    return $this->isQualifiedTypeName($name) || $this->typeLooksLikeFqcn($name);
+}
+
+
+/**
+ * @param array<string, string> $uses
+ */
+private function shouldRegisterImportCandidate(string $symbol, array $uses, string $namespaceName): bool
+{
+    $catalogHint = $this->namespaceUseCatalog;
+    $uses = $this->overlayUsesWithCatalogHint($uses, $catalogHint);
+    if (!$this->isFullyQualifiedName($symbol) && !str_starts_with($symbol, '\\')) {
+        return false;
+    }
+
+    if ($this->isReservedTypeName($symbol)) {
+        return false;
+    }
+
+    $normalized = $this->normaliseSymbolName($symbol);
+    if (isset($uses[$normalized])) {
+        return false;
+    }
+
+    $short = $this->extractTerminalIdentifier($symbol);
+    if ($this->usesContainShortName($uses, $short)) {
+        return false;
+    }
+
+    if ($this->isGlobalNamespaceName($namespaceName) && !str_contains(ltrim($symbol, '\\'), '\\')) {
+        return false;
+    }
+
+    return true;
+}
