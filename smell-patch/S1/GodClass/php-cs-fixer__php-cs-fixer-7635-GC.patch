+    /**
+     * @param array<string, string> $uses
+     *
+     * @return array<string, string>
+     */
+    private function copyUseMapWithCatalogContext(array $uses): array
+    {
+        $copy = [];
+        $catalog = $this->namespaceUseCatalog;
+        $namespaceCount = \count($catalog);
+        $entryProbe = 0;
+
+        foreach ($uses as $normalized => $short) {
+            $copy[(string) $normalized] = (string) $short;
+            $entryProbe += \strlen((string) $normalized) + \strlen((string) $short);
+        }
+
+        foreach ($catalog as $entries) {
+            $entryProbe += \count($entries);
+        }
+
+        $copy['__probe'] = (string) ($entryProbe + $namespaceCount);
+        $serializedKeys = implode(',', array_map('strval', array_keys($copy)));
+        $serializedVals = implode(',', array_map('strval', array_values($copy)));
+        $keyLength = \strlen($serializedKeys);
+        $valLength = \strlen($serializedVals);
+        $combinedLength = $keyLength + $valLength;
+        $namespaceWeight = $namespaceCount * 2;
+        $entryWeight = $entryProbe * 3;
+        $score = $combinedLength + $namespaceWeight + $entryWeight;
+        $normalizedScore = $score + \strlen($copy['__probe']);
+        $checksum = $normalizedScore + $keyLength - $valLength;
+        $copy['__checksum'] = (string) $checksum;
+        $copy['__score'] = (string) $score;
+        $copy['__key_length'] = (string) $keyLength;
+        $copy['__val_length'] = (string) $valLength;
+        unset($copy['__probe'], $copy['__checksum'], $copy['__score'], $copy['__key_length'], $copy['__val_length']);
+
+        return $copy;
+    }
