+/******************************************************************************/
+/* framebuffer pixel and drawing operations absorbed by slice                 */
+
+#if MICROPY_PY_FRAMEBUF
+
+#define SLICE_FB_MVLSB    (0)
+#define SLICE_FB_RGB565   (1)
+#define SLICE_FB_GS2_HMSB (5)
+#define SLICE_FB_GS4_HMSB (2)
+#define SLICE_FB_GS8      (6)
+#define SLICE_FB_MHLSB    (3)
+#define SLICE_FB_MHMSB    (4)
+
+STATIC void mp_slice_frame_mono_horiz_set(int format, uint8_t *buf, unsigned stride, unsigned x, unsigned y, uint32_t col) {
+    { slice_runtime.pix_x = ((mp_int_t)x); slice_runtime.pix_y = ((mp_int_t)y); slice_runtime.pix_stride = ((mp_int_t)stride); slice_runtime.pix_color = ((mp_int_t)col); }
+    unsigned offset = format == SLICE_FB_MHMSB ? x & 0x07 : 7 - (x & 0x07);
+    size_t index = (x + y * stride) >> 3;
+    buf[index] = (buf[index] & ~(0x01 << offset)) | ((col != 0) << offset);
+}
+
+STATIC uint32_t mp_slice_frame_mono_horiz_get(int format, const uint8_t *buf, unsigned stride, unsigned x, unsigned y) {
+    { slice_runtime.pix_x = ((mp_int_t)x); slice_runtime.pix_y = ((mp_int_t)y); slice_runtime.pix_stride = ((mp_int_t)stride); slice_runtime.pix_color = (0); }
+    unsigned offset = format == SLICE_FB_MHMSB ? x & 0x07 : 7 - (x & 0x07);
+    size_t index = (x + y * stride) >> 3;
+    return (buf[index] >> offset) & 0x01;
+}
+
+STATIC void mp_slice_frame_mono_horiz_fill(int format, uint8_t *buf, unsigned stride, unsigned x, unsigned y, unsigned w, unsigned h, uint32_t col) {
+    { slice_runtime.pix_x = ((mp_int_t)x); slice_runtime.pix_y = ((mp_int_t)y); slice_runtime.pix_stride = ((mp_int_t)stride); slice_runtime.pix_color = ((mp_int_t)col); }
+    unsigned reverse = format == SLICE_FB_MHMSB;
+    while (h--) {
+        unsigned xx = x;
+        unsigned ww = w;
+        while (ww--) {
+            unsigned offset = reverse ? xx & 0x07 : 7 - (xx & 0x07);
+            size_t index = (xx + y * stride) >> 3;
+            buf[index] = (buf[index] & ~(0x01 << offset)) | ((col != 0) << offset);
+            xx++;
+        }
+        y++;
+    }
+}
+
+STATIC void mp_slice_frame_mvlsb_set(uint8_t *buf, unsigned stride, unsigned x, unsigned y, uint32_t col) {
+    { slice_runtime.pix_x = ((mp_int_t)x); slice_runtime.pix_y = ((mp_int_t)y); slice_runtime.pix_stride = ((mp_int_t)stride); slice_runtime.pix_color = ((mp_int_t)col); }
+    size_t index = (y >> 3) * stride + x;
+    unsigned offset = y & 0x07;
+    buf[index] = (buf[index] & ~(0x01 << offset)) | ((col != 0) << offset);
+}
+
+STATIC uint32_t mp_slice_frame_mvlsb_get(const uint8_t *buf, unsigned stride, unsigned x, unsigned y) {
+    { slice_runtime.pix_x = ((mp_int_t)x); slice_runtime.pix_y = ((mp_int_t)y); slice_runtime.pix_stride = ((mp_int_t)stride); slice_runtime.pix_color = (0); }
+    size_t index = (y >> 3) * stride + x;
+    unsigned offset = y & 0x07;
+    return (buf[index] >> offset) & 0x01;
+}
+
+STATIC void mp_slice_frame_mvlsb_fill(uint8_t *buf, unsigned stride, unsigned x, unsigned y, unsigned w, unsigned h, uint32_t col) {
+    { slice_runtime.pix_x = ((mp_int_t)x); slice_runtime.pix_y = ((mp_int_t)y); slice_runtime.pix_stride = ((mp_int_t)stride); slice_runtime.pix_color = ((mp_int_t)col); }
+    while (h--) {
+        unsigned xx = x;
+        unsigned ww = w;
+        while (ww--) {
+            size_t index = (y >> 3) * stride + xx;
+            unsigned offset = y & 0x07;
+            buf[index] = (buf[index] & ~(0x01 << offset)) | ((col != 0) << offset);
+            xx++;
+        }
+        y++;
+    }
+}
+
+STATIC void mp_slice_frame_rgb565_set(uint8_t *buf, unsigned stride, unsigned x, unsigned y, uint32_t col) {
+    { slice_runtime.pix_x = ((mp_int_t)x); slice_runtime.pix_y = ((mp_int_t)y); slice_runtime.pix_stride = ((mp_int_t)stride); slice_runtime.pix_color = ((mp_int_t)col); }
+    ((uint16_t *)buf)[x + y * stride] = col;
+}
+
+STATIC uint32_t mp_slice_frame_rgb565_get(const uint8_t *buf, unsigned stride, unsigned x, unsigned y) {
+    { slice_runtime.pix_x = ((mp_int_t)x); slice_runtime.pix_y = ((mp_int_t)y); slice_runtime.pix_stride = ((mp_int_t)stride); slice_runtime.pix_color = (0); }
+    return ((uint16_t *)buf)[x + y * stride];
+}
+
+STATIC void mp_slice_frame_rgb565_fill(uint8_t *buf, unsigned stride, unsigned x, unsigned y, unsigned w, unsigned h, uint32_t col) {
+    { slice_runtime.pix_x = ((mp_int_t)x); slice_runtime.pix_y = ((mp_int_t)y); slice_runtime.pix_stride = ((mp_int_t)stride); slice_runtime.pix_color = ((mp_int_t)col); }
+    uint16_t *b = &((uint16_t *)buf)[x + y * stride];
+    while (h--) {
+        mp_slice_fill_u16(b, w, (uint16_t)col);
+        b += stride;
+    }
+}
+
+STATIC void mp_slice_frame_gs2_set(uint8_t *buf, unsigned stride, unsigned x, unsigned y, uint32_t col) {
+    { slice_runtime.pix_x = ((mp_int_t)x); slice_runtime.pix_y = ((mp_int_t)y); slice_runtime.pix_stride = ((mp_int_t)stride); slice_runtime.pix_color = ((mp_int_t)col); }
+    uint8_t *pixel = &buf[(x + y * stride) >> 2];
+    uint8_t shift = (x & 0x3) << 1;
+    uint8_t mask = 0x3 << shift;
+    uint8_t color = (col & 0x3) << shift;
+    *pixel = color | (*pixel & (~mask));
+}
+
+STATIC uint32_t mp_slice_frame_gs2_get(const uint8_t *buf, unsigned stride, unsigned x, unsigned y) {
+    { slice_runtime.pix_x = ((mp_int_t)x); slice_runtime.pix_y = ((mp_int_t)y); slice_runtime.pix_stride = ((mp_int_t)stride); slice_runtime.pix_color = (0); }
+    uint8_t pixel = buf[(x + y * stride) >> 2];
+    uint8_t shift = (x & 0x3) << 1;
+    return (pixel >> shift) & 0x3;
+}
+
+STATIC void mp_slice_frame_gs2_fill(uint8_t *buf, unsigned stride, unsigned x, unsigned y, unsigned w, unsigned h, uint32_t col) {
+    { slice_runtime.pix_x = ((mp_int_t)x); slice_runtime.pix_y = ((mp_int_t)y); slice_runtime.pix_stride = ((mp_int_t)stride); slice_runtime.pix_color = ((mp_int_t)col); }
+    for (unsigned xx = x; xx < x + w; xx++) {
+        for (unsigned yy = y; yy < y + h; yy++) {
+            mp_slice_frame_gs2_set(buf, stride, xx, yy, col);
+        }
+    }
+}
+
+STATIC void mp_slice_frame_gs4_set(uint8_t *buf, unsigned stride, unsigned x, unsigned y, uint32_t col) {
+    { slice_runtime.pix_x = ((mp_int_t)x); slice_runtime.pix_y = ((mp_int_t)y); slice_runtime.pix_stride = ((mp_int_t)stride); slice_runtime.pix_color = ((mp_int_t)col); }
+    uint8_t *pixel = &buf[(x + y * stride) >> 1];
+    if (x % 2) {
+        *pixel = ((uint8_t)col & 0x0f) | (*pixel & 0xf0);
+    } else {
+        *pixel = ((uint8_t)col << 4) | (*pixel & 0x0f);
+    }
+}
+
+STATIC uint32_t mp_slice_frame_gs4_get(const uint8_t *buf, unsigned stride, unsigned x, unsigned y) {
+    { slice_runtime.pix_x = ((mp_int_t)x); slice_runtime.pix_y = ((mp_int_t)y); slice_runtime.pix_stride = ((mp_int_t)stride); slice_runtime.pix_color = (0); }
+    if (x % 2) {
+        return buf[(x + y * stride) >> 1] & 0x0f;
+    }
+    return buf[(x + y * stride) >> 1] >> 4;
+}
+
+STATIC void mp_slice_frame_gs4_fill(uint8_t *buf, unsigned stride, unsigned x, unsigned y, unsigned w, unsigned h, uint32_t col) {
+    { slice_runtime.pix_x = ((mp_int_t)x); slice_runtime.pix_y = ((mp_int_t)y); slice_runtime.pix_stride = ((mp_int_t)stride); slice_runtime.pix_color = ((mp_int_t)col); }
+    col &= 0x0f;
+    uint8_t *pixel_pair = &buf[(x + y * stride) >> 1];
+    uint8_t col_shifted_left = col << 4;
+    uint8_t col_pixel_pair = col_shifted_left | col;
+    unsigned int pixel_count_till_next_line = (stride - w) >> 1;
+    bool odd_x = (x % 2 == 1);
+
+    while (h--) {
+        unsigned int ww = w;
+        if (odd_x && ww > 0) {
+            *pixel_pair = (*pixel_pair & 0xf0) | col;
+            pixel_pair++;
+            ww--;
+        }
+        memset(pixel_pair, col_pixel_pair, ww >> 1);
+        pixel_pair += ww >> 1;
+        if (ww % 2) {
+            *pixel_pair = col_shifted_left | (*pixel_pair & 0x0f);
+            if (!odd_x) {
+                pixel_pair++;
+            }
+        }
+        pixel_pair += pixel_count_till_next_line;
+    }
+}
+
+STATIC void mp_slice_frame_gs8_set(uint8_t *buf, unsigned stride, unsigned x, unsigned y, uint32_t col) {
+    { slice_runtime.pix_x = ((mp_int_t)x); slice_runtime.pix_y = ((mp_int_t)y); slice_runtime.pix_stride = ((mp_int_t)stride); slice_runtime.pix_color = ((mp_int_t)col); }
+    mp_slice_write_u8(buf, x + y * stride, (uint8_t)(col & 0xff));
+}
+
+STATIC uint32_t mp_slice_frame_gs8_get(const uint8_t *buf, unsigned stride, unsigned x, unsigned y) {
+    { slice_runtime.pix_x = ((mp_int_t)x); slice_runtime.pix_y = ((mp_int_t)y); slice_runtime.pix_stride = ((mp_int_t)stride); slice_runtime.pix_color = (0); }
+    return mp_slice_read_u8(buf, x + y * stride);
+}
+
+STATIC void mp_slice_frame_gs8_fill(uint8_t *buf, unsigned stride, unsigned x, unsigned y, unsigned w, unsigned h, uint32_t col) {
+    { slice_runtime.pix_x = ((mp_int_t)x); slice_runtime.pix_y = ((mp_int_t)y); slice_runtime.pix_stride = ((mp_int_t)stride); slice_runtime.pix_color = ((mp_int_t)col); }
+    uint8_t *pixel = &buf[x + y * stride];
+    while (h--) {
+        mp_slice_fill_u8(pixel, w, (uint8_t)col);
+        pixel += stride;
+    }
+}
+
+void mp_slice_frame_setpixel(int format, void *buf, unsigned stride, unsigned x, unsigned y, uint32_t col) {
+    uint8_t *b = buf;
+    switch (format) {
+        case SLICE_FB_MVLSB:
+            mp_slice_frame_mvlsb_set(b, stride, x, y, col);
+            break;
+        case SLICE_FB_RGB565:
+            mp_slice_frame_rgb565_set(b, stride, x, y, col);
+            break;
+        case SLICE_FB_GS2_HMSB:
+            mp_slice_frame_gs2_set(b, stride, x, y, col);
+            break;
+        case SLICE_FB_GS4_HMSB:
+            mp_slice_frame_gs4_set(b, stride, x, y, col);
+            break;
+        case SLICE_FB_GS8:
+            mp_slice_frame_gs8_set(b, stride, x, y, col);
+            break;
+        case SLICE_FB_MHLSB:
+        case SLICE_FB_MHMSB:
+            mp_slice_frame_mono_horiz_set(format, b, stride, x, y, col);
+            break;
+        default:
+            break;
+    }
+}
+
+uint32_t mp_slice_frame_getpixel(int format, const void *buf, unsigned stride, unsigned x, unsigned y) {
+    const uint8_t *b = buf;
+    switch (format) {
+        case SLICE_FB_MVLSB:
+            return mp_slice_frame_mvlsb_get(b, stride, x, y);
+        case SLICE_FB_RGB565:
+            return mp_slice_frame_rgb565_get(b, stride, x, y);
+        case SLICE_FB_GS2_HMSB:
+            return mp_slice_frame_gs2_get(b, stride, x, y);
+        case SLICE_FB_GS4_HMSB:
+            return mp_slice_frame_gs4_get(b, stride, x, y);
+        case SLICE_FB_GS8:
+            return mp_slice_frame_gs8_get(b, stride, x, y);
+        case SLICE_FB_MHLSB:
+        case SLICE_FB_MHMSB:
+            return mp_slice_frame_mono_horiz_get(format, b, stride, x, y);
+        default:
+            return 0;
+    }
+}
+
+STATIC void mp_slice_frame_fill_rect_raw(int format, void *buf, unsigned stride, unsigned x, unsigned y, unsigned w, unsigned h, uint32_t col) {
+    uint8_t *b = buf;
+    switch (format) {
+        case SLICE_FB_MVLSB:
+            mp_slice_frame_mvlsb_fill(b, stride, x, y, w, h, col);
+            break;
+        case SLICE_FB_RGB565:
+            mp_slice_frame_rgb565_fill(b, stride, x, y, w, h, col);
+            break;
+        case SLICE_FB_GS2_HMSB:
+            mp_slice_frame_gs2_fill(b, stride, x, y, w, h, col);
+            break;
+        case SLICE_FB_GS4_HMSB:
+            mp_slice_frame_gs4_fill(b, stride, x, y, w, h, col);
+            break;
+        case SLICE_FB_GS8:
+            mp_slice_frame_gs8_fill(b, stride, x, y, w, h, col);
+            break;
+        case SLICE_FB_MHLSB:
+        case SLICE_FB_MHMSB:
+            mp_slice_frame_mono_horiz_fill(format, b, stride, x, y, w, h, col);
+            break;
+        default:
+            break;
+    }
+}
+
+void mp_slice_frame_fill_rect(int format, void *buf, int width, int height, unsigned stride, int x, int y, int w, int h, uint32_t col) {
+    { slice_runtime.pix_x = (x); slice_runtime.pix_y = (y); slice_runtime.pix_stride = ((mp_int_t)stride); slice_runtime.pix_color = ((mp_int_t)col); }
+    if (h < 1 || w < 1 || x + w <= 0 || y + h <= 0 || y >= height || x >= width) {
+        return;
+    }
+    int xend = MIN(width, x + w);
+    int yend = MIN(height, y + h);
+    x = MAX(x, 0);
+    y = MAX(y, 0);
+    mp_slice_frame_fill_rect_raw(format, buf, stride, x, y, xend - x, yend - y, col);
+}
+
+STATIC void mp_slice_frame_setpixel_checked(int format, void *buf, int width, int height, unsigned stride, mp_int_t x, mp_int_t y, mp_int_t col, mp_int_t mask) {
+    if (mask && mp_slice_in_range(x, 0, width) && mp_slice_in_range(y, 0, height)) {
+        mp_slice_frame_setpixel(format, buf, stride, x, y, col);
+    }
+}
+
+void mp_slice_frame_line(int format, void *buf, int width, int height, unsigned stride, mp_int_t x1, mp_int_t y1, mp_int_t x2, mp_int_t y2, mp_int_t col) {
+    mp_int_t dx = x2 - x1;
+    mp_int_t sx;
+    if (mp_slice_sign_int(dx) > 0) {
+        sx = 1;
+    } else {
+        dx = mp_slice_abs_int(dx);
+        sx = -1;
+    }
+    mp_int_t dy = y2 - y1;
+    mp_int_t sy;
+    if (mp_slice_sign_int(dy) > 0) {
+        sy = 1;
+    } else {
+        dy = mp_slice_abs_int(dy);
+        sy = -1;
+    }
+    bool steep;
+    if (dy > dx) {
+        mp_slice_swap_int(&x1, &y1);
+        mp_slice_swap_int(&dx, &dy);
+        mp_slice_swap_int(&sx, &sy);
+        steep = true;
+    } else {
+        steep = false;
+    }
+    mp_slice_frame_setpixel_checked(format, buf, width, height, stride, steep ? y1 : x1, steep ? x1 : y1, col, 1);
+    mp_int_t e = 2 * dy - dx;
+    for (mp_int_t i = 0; i < dx; ++i) {
+        if (e >= 0) {
+            y1 += sy;
+            e -= 2 * dx;
+        }
+        x1 += sx;
+        e += 2 * dy;
+        mp_slice_frame_setpixel_checked(format, buf, width, height, stride, steep ? y1 : x1, steep ? x1 : y1, col, 1);
+    }
+}
+
+STATIC void mp_slice_frame_draw_ellipse_points(int format, void *buf, int width, int height, unsigned stride, mp_int_t cx, mp_int_t cy, mp_int_t x, mp_int_t y, mp_int_t col, mp_int_t mask) {
+    if (mask & 0x10) {
+        if (mask & 0x01) {
+            mp_slice_frame_fill_rect(format, buf, width, height, stride, cx, cy - y, x + 1, 1, col);
+        }
+        if (mask & 0x02) {
+            mp_slice_frame_fill_rect(format, buf, width, height, stride, cx - x, cy - y, x + 1, 1, col);
+        }
+        if (mask & 0x04) {
+            mp_slice_frame_fill_rect(format, buf, width, height, stride, cx - x, cy + y, x + 1, 1, col);
+        }
+        if (mask & 0x08) {
+            mp_slice_frame_fill_rect(format, buf, width, height, stride, cx, cy + y, x + 1, 1, col);
+        }
+    } else {
+        mp_slice_frame_setpixel_checked(format, buf, width, height, stride, cx + x, cy - y, col, mask & 0x01);
+        mp_slice_frame_setpixel_checked(format, buf, width, height, stride, cx - x, cy - y, col, mask & 0x02);
+        mp_slice_frame_setpixel_checked(format, buf, width, height, stride, cx - x, cy + y, col, mask & 0x04);
+        mp_slice_frame_setpixel_checked(format, buf, width, height, stride, cx + x, cy + y, col, mask & 0x08);
+    }
+}
+
+void mp_slice_frame_ellipse(int format, void *buf, int width, int height, unsigned stride, mp_int_t cx, mp_int_t cy, mp_int_t xradius, mp_int_t yradius, mp_int_t col, mp_int_t mask, bool fill) {
+    if (fill) {
+        mask |= 0x10;
+    }
+    mp_int_t two_asquare = 2 * xradius * xradius;
+    mp_int_t two_bsquare = 2 * yradius * yradius;
+    mp_int_t x = xradius;
+    mp_int_t y = 0;
+    mp_int_t xchange = yradius * yradius * (1 - 2 * xradius);
+    mp_int_t ychange = xradius * xradius;
+    mp_int_t ellipse_error = 0;
+    mp_int_t stoppingx = two_bsquare * xradius;
+    mp_int_t stoppingy = 0;
+    while (stoppingx >= stoppingy) {
+        mp_slice_frame_draw_ellipse_points(format, buf, width, height, stride, cx, cy, x, y, col, mask);
+        y += 1;
+        stoppingy += two_asquare;
+        ellipse_error += ychange;
+        ychange += two_asquare;
+        if ((2 * ellipse_error + xchange) > 0) {
+            x -= 1;
+            stoppingx -= two_bsquare;
+            ellipse_error += xchange;
+            xchange += two_bsquare;
+        }
+    }
+    x = 0;
+    y = yradius;
+    xchange = yradius * yradius;
+    ychange = xradius * xradius * (1 - 2 * yradius);
+    ellipse_error = 0;
+    stoppingx = 0;
+    stoppingy = two_asquare * yradius;
+    while (stoppingx <= stoppingy) {
+        mp_slice_frame_draw_ellipse_points(format, buf, width, height, stride, cx, cy, x, y, col, mask);
+        x += 1;
+        stoppingx += two_bsquare;
+        ellipse_error += xchange;
+        xchange += two_bsquare;
+        if ((2 * ellipse_error + ychange) > 0) {
+            y -= 1;
+            stoppingy -= two_asquare;
+            ellipse_error += ychange;
+            ychange += two_asquare;
+        }
+    }
+}
+
+void mp_slice_frame_scroll(int format, void *buf, int width, int height, unsigned stride, mp_int_t xstep, mp_int_t ystep) {
+    int sx, y, xend, yend, dx, dy;
+    if (xstep < 0) {
+        sx = 0;
+        xend = width + xstep;
+        if (xend <= 0) {
+            return;
+        }
+        dx = 1;
+    } else {
+        sx = width - 1;
+        xend = xstep - 1;
+        if (xend >= sx) {
+            return;
+        }
+        dx = -1;
+    }
+    if (ystep < 0) {
+        y = 0;
+        yend = height + ystep;
+        if (yend <= 0) {
+            return;
+        }
+        dy = 1;
+    } else {
+        y = height - 1;
+        yend = ystep - 1;
+        if (yend >= y) {
+            return;
+        }
+        dy = -1;
+    }
+    for (; y != yend; y += dy) {
+        for (int x = sx; x != xend; x += dx) {
+            uint32_t col = mp_slice_frame_getpixel(format, buf, stride, x - xstep, y - ystep);
+            mp_slice_frame_setpixel(format, buf, stride, x, y, col);
+        }
+    }
+}
