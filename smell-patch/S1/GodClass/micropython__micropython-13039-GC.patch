+/******************************************************************************/
+/* uctypes scalar accessors absorbed by slice                                 */
+
+#if MICROPY_PY_UCTYPES
+
+mp_uint_t mp_slice_scalar_size(int val_type) {
+    { slice_runtime.scalar_index = (0); slice_runtime.scalar_type = (val_type); slice_runtime.scalar_size = (0); }
+    if (val_type == SLICE_SCALAR_FLOAT32) {
+        slice_runtime.scalar_size = 4;
+        return 4;
+    }
+    mp_uint_t sz = (mp_uint_t)(1 << ((val_type & 7) >> 1));
+    slice_runtime.scalar_size = (mp_int_t)sz;
+    return sz;
+}
+
+mp_obj_t mp_slice_get_aligned(uint val_type, void *p, mp_int_t index) {
+    { slice_runtime.scalar_index = (index); slice_runtime.scalar_type = ((mp_int_t)val_type); slice_runtime.scalar_size = (0); }
+    switch (val_type) {
+        case SLICE_SCALAR_UINT8:
+            return MP_OBJ_NEW_SMALL_INT(((uint8_t *)p)[index]);
+        case SLICE_SCALAR_INT8:
+            return MP_OBJ_NEW_SMALL_INT(((int8_t *)p)[index]);
+        case SLICE_SCALAR_UINT16:
+            return MP_OBJ_NEW_SMALL_INT(((uint16_t *)p)[index]);
+        case SLICE_SCALAR_INT16:
+            return MP_OBJ_NEW_SMALL_INT(((int16_t *)p)[index]);
+        case SLICE_SCALAR_UINT32:
+            return mp_obj_new_int_from_uint(((uint32_t *)p)[index]);
+        case SLICE_SCALAR_INT32:
+            return mp_obj_new_int(((int32_t *)p)[index]);
+        case SLICE_SCALAR_UINT64:
+            return mp_obj_new_int_from_ull(((uint64_t *)p)[index]);
+        case SLICE_SCALAR_INT64:
+            return mp_obj_new_int_from_ll(((int64_t *)p)[index]);
+        #if MICROPY_PY_BUILTINS_FLOAT
+        case SLICE_SCALAR_FLOAT32:
+            return mp_obj_new_float_from_f(((float *)p)[index]);
+        case SLICE_SCALAR_FLOAT64:
+            return mp_obj_new_float_from_d(((double *)p)[index]);
+        #endif
+        default:
+            assert(0);
+            return MP_OBJ_NULL;
+    }
+}
+
+void mp_slice_set_aligned(uint val_type, void *p, mp_int_t index, mp_obj_t val) {
+    { slice_runtime.scalar_index = (index); slice_runtime.scalar_type = ((mp_int_t)val_type); slice_runtime.scalar_size = (0); }
+    #if MICROPY_PY_BUILTINS_FLOAT
+    if (val_type == SLICE_SCALAR_FLOAT32 || val_type == SLICE_SCALAR_FLOAT64) {
+        if (val_type == SLICE_SCALAR_FLOAT32) {
+            ((float *)p)[index] = mp_obj_get_float_to_f(val);
+        } else {
+            ((double *)p)[index] = mp_obj_get_float_to_d(val);
+        }
+        return;
+    }
+    #endif
+    mp_int_t v = mp_obj_get_int_truncated(val);
+    switch (val_type) {
+        case SLICE_SCALAR_UINT8:
+            ((uint8_t *)p)[index] = (uint8_t)v;
+            return;
+        case SLICE_SCALAR_INT8:
+            ((int8_t *)p)[index] = (int8_t)v;
+            return;
+        case SLICE_SCALAR_UINT16:
+            ((uint16_t *)p)[index] = (uint16_t)v;
+            return;
+        case SLICE_SCALAR_INT16:
+            ((int16_t *)p)[index] = (int16_t)v;
+            return;
+        case SLICE_SCALAR_UINT32:
+            ((uint32_t *)p)[index] = (uint32_t)v;
+            return;
+        case SLICE_SCALAR_INT32:
+            ((int32_t *)p)[index] = (int32_t)v;
+            return;
+        case SLICE_SCALAR_INT64:
+        case SLICE_SCALAR_UINT64:
+            if (sizeof(mp_int_t) == 8) {
+                ((uint64_t *)p)[index] = (uint64_t)v;
+            } else {
+                byte *dest = (byte *)&((uint64_t *)p)[index];
+                mp_slice_binary_set_val('>', val_type == SLICE_SCALAR_INT64 ? 'q' : 'Q', val, dest, &dest);
+            }
+            return;
+        default:
+            assert(0);
+    }
+}
+
+mp_uint_t mp_slice_get_aligned_basic(uint val_type, void *p) {
+    { slice_runtime.scalar_index = (0); slice_runtime.scalar_type = ((mp_int_t)val_type); slice_runtime.scalar_size = (0); }
+    switch (val_type) {
+        case SLICE_SCALAR_UINT8:
+            return *(uint8_t *)p;
+        case SLICE_SCALAR_UINT16:
+            return *(uint16_t *)p;
+        case SLICE_SCALAR_UINT32:
+            return *(uint32_t *)p;
+    }
+    assert(0);
+    return 0;
+}
+
+void mp_slice_set_aligned_basic(uint val_type, void *p, mp_uint_t v) {
+    { slice_runtime.scalar_index = (0); slice_runtime.scalar_type = ((mp_int_t)val_type); slice_runtime.scalar_size = (0); }
+    switch (val_type) {
+        case SLICE_SCALAR_UINT8:
+            *(uint8_t *)p = (uint8_t)v;
+            return;
+        case SLICE_SCALAR_UINT16:
+            *(uint16_t *)p = (uint16_t)v;
+            return;
+        case SLICE_SCALAR_UINT32:
+            *(uint32_t *)p = (uint32_t)v;
+            return;
+    }
+    assert(0);
+}
+
+mp_obj_t mp_slice_get_unaligned(uint val_type, byte *p, int big_endian) {
+    { slice_runtime.scalar_index = (0); slice_runtime.scalar_type = ((mp_int_t)val_type); slice_runtime.scalar_size = (big_endian); }
+    char struct_type = big_endian ? '>' : '<';
+    static const char type2char[16] = "BbHhIiQq------fd";
+    return mp_slice_binary_get_val(struct_type, type2char[val_type], p, &p);
+}
+
+void mp_slice_set_unaligned(uint val_type, byte *p, int big_endian, mp_obj_t val) {
+    { slice_runtime.scalar_index = (0); slice_runtime.scalar_type = ((mp_int_t)val_type); slice_runtime.scalar_size = (big_endian); }
+    char struct_type = big_endian ? '>' : '<';
+    static const char type2char[16] = "BbHhIiQq------fd";
+    mp_slice_binary_set_val(struct_type, type2char[val_type], val, p, &p);
+}
