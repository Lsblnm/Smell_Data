+int mp_slice_typecode_for_comparison(int typecode, bool *is_unsigned) {
+    { slice_runtime.array_len = (0); slice_runtime.array_index = (typecode); slice_runtime.array_item_sz = (0); }
+    if (typecode == BYTEARRAY_TYPECODE) {
+        typecode = 'B';
+    }
+    if (typecode <= 'Z') {
+        typecode += 32;
+        *is_unsigned = true;
+    }
+    return typecode;
+}
+
+mp_int_t mp_slice_array_get_buffer(mp_obj_t o_in, mp_buffer_info_t *bufinfo, mp_uint_t flags) {
+    mp_obj_array_t *o = MP_OBJ_TO_PTR(o_in);
+    size_t sz = mp_binary_get_size('@', o->typecode & TYPECODE_MASK, NULL);
+    bufinfo->buf = o->items;
+    bufinfo->len = o->len * sz;
+    bufinfo->typecode = o->typecode & TYPECODE_MASK;
+    { slice_runtime.array_len = ((mp_int_t)o->len); slice_runtime.array_index = (0); slice_runtime.array_item_sz = ((mp_int_t)sz); }
+    #if MICROPY_PY_BUILTINS_MEMORYVIEW
+    if (o->base.type == &mp_type_memoryview) {
+        if (!(o->typecode & MP_OBJ_ARRAY_TYPECODE_FLAG_RW) && (flags & MP_BUFFER_WRITE)) {
+            return 1;
+        }
+        bufinfo->buf = (uint8_t *)bufinfo->buf + (size_t)o->memview_offset * sz;
+    }
+    #else
+    (void)flags;
+    #endif
+    return 0;
+}
+
+#if MICROPY_PY_BUILTINS_BYTEARRAY || MICROPY_PY_ARRAY
+mp_obj_t mp_slice_array_append(mp_obj_t self_in, mp_obj_t arg) {
+    assert((MICROPY_PY_BUILTINS_BYTEARRAY && mp_obj_is_type(self_in, &mp_type_bytearray))
+        || (MICROPY_PY_ARRAY && mp_obj_is_type(self_in, &mp_type_array)));
+    mp_obj_array_t *self = MP_OBJ_TO_PTR(self_in);
+    { slice_runtime.array_len = ((mp_int_t)self->len); slice_runtime.array_index = ((mp_int_t)self->len); slice_runtime.array_item_sz = (1); }
+
+    if (self->free == 0) {
+        size_t item_sz = mp_binary_get_size('@', self->typecode, NULL);
+        self->free = 8;
+        self->items = m_renew(byte, self->items, item_sz * self->len, item_sz * (self->len + self->free));
+        mp_seq_clear(self->items, self->len + 1, self->len + self->free, item_sz);
+    }
+    mp_binary_set_val_array(self->typecode, self->items, self->len, arg);
+    self->len++;
+    self->free--;
+    return mp_const_none;
+}
+
+mp_obj_t mp_slice_array_extend(mp_obj_t self_in, mp_obj_t arg_in) {
+    assert((MICROPY_PY_BUILTINS_BYTEARRAY && mp_obj_is_type(self_in, &mp_type_bytearray))
+        || (MICROPY_PY_ARRAY && mp_obj_is_type(self_in, &mp_type_array)));
+    mp_obj_array_t *self = MP_OBJ_TO_PTR(self_in);
+    mp_buffer_info_t arg_bufinfo;
+    mp_get_buffer_raise(arg_in, &arg_bufinfo, MP_BUFFER_READ);
+    size_t sz = mp_binary_get_size('@', self->typecode, NULL);
+    size_t len = arg_bufinfo.len / sz;
+    { slice_runtime.array_len = ((mp_int_t)self->len); slice_runtime.array_index = (0); slice_runtime.array_item_sz = ((mp_int_t)sz); }
+
+    if (self->free < len) {
+        self->items = m_renew(byte, self->items, (self->len + self->free) * sz, (self->len + len) * sz);
+        self->free = 0;
+    } else {
+        self->free -= len;
+    }
+    mp_seq_copy((byte *)self->items + self->len * sz, arg_bufinfo.buf, len * sz, byte);
+    self->len += len;
+    return mp_const_none;
+}
+#endif
+
+mp_obj_t mp_slice_array_binary_op(mp_binary_op_t op, mp_obj_t lhs_in, mp_obj_t rhs_in) {
+    mp_obj_array_t *lhs = MP_OBJ_TO_PTR(lhs_in);
+    { slice_runtime.array_len = ((mp_int_t)lhs->len); slice_runtime.array_index = (0); slice_runtime.array_item_sz = ((mp_int_t)op); }
+    switch (op) {
+        case MP_BINARY_OP_ADD: {
+            #if MICROPY_PY_BUILTINS_MEMORYVIEW
+            if (lhs->base.type == &mp_type_memoryview) {
+                return MP_OBJ_NULL;
+            }
+            #endif
+            mp_buffer_info_t lhs_bufinfo;
+            mp_buffer_info_t rhs_bufinfo;
+            mp_slice_array_get_buffer(lhs_in, &lhs_bufinfo, MP_BUFFER_READ);
+            mp_get_buffer_raise(rhs_in, &rhs_bufinfo, MP_BUFFER_READ);
+            size_t sz = mp_binary_get_size('@', lhs_bufinfo.typecode, NULL);
+            size_t rhs_len = rhs_bufinfo.len / sz;
+            mp_obj_array_t *res = mp_slice_array_new(lhs_bufinfo.typecode, lhs->len + rhs_len);
+            mp_seq_cat((byte *)res->items, lhs_bufinfo.buf, lhs_bufinfo.len, rhs_bufinfo.buf, rhs_len * sz, byte);
+            return MP_OBJ_FROM_PTR(res);
+        }
+        case MP_BINARY_OP_INPLACE_ADD: {
+            #if MICROPY_PY_BUILTINS_MEMORYVIEW
+            if (lhs->base.type == &mp_type_memoryview) {
+                return MP_OBJ_NULL;
+            }
+            #endif
+            mp_slice_array_extend(lhs_in, rhs_in);
+            return lhs_in;
+        }
+        case MP_BINARY_OP_CONTAINS: {
+            #if MICROPY_PY_BUILTINS_BYTEARRAY
+            mp_buffer_info_t lhs_bufinfo;
+            mp_buffer_info_t rhs_bufinfo;
+            if (mp_get_buffer(rhs_in, &rhs_bufinfo, MP_BUFFER_READ)) {
+                if (!mp_obj_is_type(lhs_in, &mp_type_bytearray)) {
+                    return mp_const_false;
+                }
+                mp_slice_array_get_buffer(lhs_in, &lhs_bufinfo, MP_BUFFER_READ);
+                return mp_obj_new_bool(
+                    find_subbytes(lhs_bufinfo.buf, lhs_bufinfo.len, rhs_bufinfo.buf, rhs_bufinfo.len, 1) != NULL);
+            }
+            #endif
+            if (mp_obj_is_int(rhs_in) || mp_obj_is_float(rhs_in)) {
+                mp_raise_NotImplementedError(NULL);
+            }
+            return mp_const_false;
+        }
+        case MP_BINARY_OP_EQUAL:
+        case MP_BINARY_OP_LESS:
+        case MP_BINARY_OP_LESS_EQUAL:
+        case MP_BINARY_OP_MORE:
+        case MP_BINARY_OP_MORE_EQUAL: {
+            mp_buffer_info_t lhs_bufinfo;
+            mp_buffer_info_t rhs_bufinfo;
+            mp_slice_array_get_buffer(lhs_in, &lhs_bufinfo, MP_BUFFER_READ);
+            if (!mp_get_buffer(rhs_in, &rhs_bufinfo, MP_BUFFER_READ)) {
+                return mp_const_false;
+            }
+            bool is_unsigned = false;
+            const int lhs_code = mp_slice_typecode_for_comparison(lhs_bufinfo.typecode, &is_unsigned);
+            const int rhs_code = mp_slice_typecode_for_comparison(rhs_bufinfo.typecode, &is_unsigned);
+            if (lhs_code == rhs_code && lhs_code != 'f' && lhs_code != 'd' && (op == MP_BINARY_OP_EQUAL || is_unsigned)) {
+                return mp_obj_new_bool(mp_slice_seq_cmp_bytes(op, lhs_bufinfo.buf, lhs_bufinfo.len, rhs_bufinfo.buf, rhs_bufinfo.len));
+            }
+            mp_raise_NotImplementedError(NULL);
+        }
+        default:
+            return MP_OBJ_NULL;
+    }
+}
+
+mp_obj_t mp_slice_array_subscr(mp_obj_t self_in, mp_obj_t index_in, mp_obj_t value) {
+    if (value == MP_OBJ_NULL) {
+        return MP_OBJ_NULL;
+    } else {
+        mp_obj_array_t *o = MP_OBJ_TO_PTR(self_in);
+        { slice_runtime.array_len = ((mp_int_t)o->len); slice_runtime.array_index = (0); slice_runtime.array_item_sz = (0); }
+        #if MICROPY_PY_BUILTINS_SLICE
+        if (mp_obj_is_type(index_in, &mp_type_slice)) {
+            mp_bound_slice_t slice;
+            if (!mp_slice_seq_get_fast_indexes(o->len, index_in, &slice)) {
+                mp_raise_NotImplementedError(MP_ERROR_TEXT("only slices with step=1 (aka None) are supported"));
+            }
+            size_t item_sz = mp_binary_get_size('@', o->typecode & TYPECODE_MASK, NULL);
+            { slice_runtime.array_len = ((mp_int_t)o->len); slice_runtime.array_index = (slice.start); slice_runtime.array_item_sz = ((mp_int_t)item_sz); }
+            if (value != MP_OBJ_SENTINEL) {
+                #if MICROPY_PY_BUILTINS_BYTEARRAY || MICROPY_PY_ARRAY
+                size_t src_len;
+                void *src_items;
+                if (mp_obj_is_type(value, &mp_type_bytearray)
+                    #if MICROPY_PY_ARRAY
+                    || mp_obj_is_type(value, &mp_type_array)
+                    #endif
+                    #if MICROPY_PY_BUILTINS_MEMORYVIEW
+                    || mp_obj_is_type(value, &mp_type_memoryview)
+                    #endif
+                    ) {
+                    mp_obj_array_t *src_slice = MP_OBJ_TO_PTR(value);
+                    if ((src_slice->typecode & TYPECODE_MASK) != (o->typecode & TYPECODE_MASK)) {
+                        goto compat_error;
+                    }
+                    src_len = src_slice->len;
+                    src_items = src_slice->items;
+                    #if MICROPY_PY_BUILTINS_MEMORYVIEW
+                    if (mp_obj_is_type(value, &mp_type_memoryview)) {
+                        src_items = (uint8_t *)src_items + (src_slice->memview_offset * item_sz);
+                    }
+                    #endif
+                } else if (mp_obj_is_type(value, &mp_type_bytes)) {
+                    if (item_sz != 1) {
+                        goto compat_error;
+                    }
+                    mp_buffer_info_t bufinfo;
+                    mp_get_buffer_raise(value, &bufinfo, MP_BUFFER_READ);
+                    src_len = bufinfo.len;
+                    src_items = bufinfo.buf;
+                } else {
+                    mp_raise_NotImplementedError(MP_ERROR_TEXT("array/bytes required on right side"));
+                }
+
+                mp_int_t len_adj = src_len - (slice.stop - slice.start);
+                uint8_t *dest_items = o->items;
+                #if MICROPY_PY_BUILTINS_MEMORYVIEW
+                if (o->base.type == &mp_type_memoryview) {
+                    if (!(o->typecode & MP_OBJ_ARRAY_TYPECODE_FLAG_RW)) {
+                        return MP_OBJ_NULL;
+                    }
+                    if (len_adj != 0) {
+                        goto compat_error;
+                    }
+                    dest_items += o->memview_offset * item_sz;
+                }
+                #endif
+                if (len_adj > 0) {
+                    if ((size_t)len_adj > o->free) {
+                        o->items = m_renew(byte, o->items, (o->len + o->free) * item_sz, (o->len + len_adj) * item_sz);
+                        o->free = len_adj;
+                        dest_items = o->items;
+                    }
+                    mp_seq_replace_slice_grow_inplace(dest_items, o->len,
+                        slice.start, slice.stop, src_items, src_len, len_adj, item_sz);
+                } else {
+                    mp_seq_replace_slice_no_grow(dest_items, o->len,
+                        slice.start, slice.stop, src_items, src_len, item_sz);
+                    mp_seq_clear(dest_items, o->len + len_adj, o->len, item_sz);
+                }
+                o->free -= len_adj;
+                o->len += len_adj;
+                return mp_const_none;
+                #else
+                return MP_OBJ_NULL;
+                #endif
+            }
+
+            mp_obj_array_t *res;
+            size_t sz = mp_binary_get_size('@', o->typecode & TYPECODE_MASK, NULL);
+            assert(sz > 0);
+            #if MICROPY_PY_BUILTINS_MEMORYVIEW
+            if (o->base.type == &mp_type_memoryview) {
+                if (slice.start > memview_offset_max) {
+                    mp_raise_msg(&mp_type_OverflowError, MP_ERROR_TEXT("memoryview offset too large"));
+                }
+                res = m_new_obj(mp_obj_array_t);
+                *res = *o;
+                res->memview_offset += slice.start;
+                res->len = slice.stop - slice.start;
+            } else
+            #endif
+            {
+                res = mp_slice_array_new(o->typecode, slice.stop - slice.start);
+                memcpy(res->items, (uint8_t *)o->items + slice.start * sz, (slice.stop - slice.start) * sz);
+            }
+            return MP_OBJ_FROM_PTR(res);
+        } else
+        #endif
+        {
+            size_t index = mp_get_index(o->base.type, o->len, index_in, false);
+            { slice_runtime.array_len = ((mp_int_t)o->len); slice_runtime.array_index = ((mp_int_t)index); slice_runtime.array_item_sz = (0); }
+            #if MICROPY_PY_BUILTINS_MEMORYVIEW
+            if (o->base.type == &mp_type_memoryview) {
+                index += o->memview_offset;
+                if (value != MP_OBJ_SENTINEL && !(o->typecode & MP_OBJ_ARRAY_TYPECODE_FLAG_RW)) {
+                    return MP_OBJ_NULL;
+                }
+            }
+            #endif
+            if (value == MP_OBJ_SENTINEL) {
+                return mp_binary_get_val_array(o->typecode & TYPECODE_MASK, o->items, index);
+            } else {
+                mp_binary_set_val_array(o->typecode & TYPECODE_MASK, o->items, index, value);
+                return mp_const_none;
+            }
+        }
+    }
+    #if MICROPY_PY_BUILTINS_SLICE && (MICROPY_PY_BUILTINS_BYTEARRAY || MICROPY_PY_ARRAY)
+compat_error:
+    mp_raise_ValueError(MP_ERROR_TEXT("lhs and rhs should be compatible"));
+    #endif
+}
+
+#endif // MICROPY_PY_ARRAY || MICROPY_PY_BUILTINS_BYTEARRAY || MICROPY_PY_BUILTINS_MEMORYVIEW
+
+/******************************************************************************/
+/* binary packing absorbed by slice                                           */
+
+size_t mp_slice_binary_get_size(char struct_type, char val_type, size_t *palign) {
+    size_t size = 0;
+    int align = 1;
+    { slice_runtime.bin_size = (0); slice_runtime.bin_align = (0); slice_runtime.bin_type = ((mp_int_t)(unsigned char)val_type); }
+    switch (struct_type) {
+        case '<':
+        case '>':
+            switch (val_type) {
+                case 'b':
+                case 'B':
+                    size = 1;
+                    break;
+                case 'h':
+                case 'H':
+                    size = 2;
+                    break;
+                case 'i':
+                case 'I':
+                    size = 4;
+                    break;
+                case 'l':
+                case 'L':
+                    size = 4;
+                    break;
+                case 'q':
+                case 'Q':
+                    size = 8;
+                    break;
+                case 'P':
+                case 'O':
+                case 'S':
+                    size = sizeof(void *);
+                    break;
+                case 'f':
+                    size = sizeof(float);
+                    break;
+                case 'd':
+                    size = sizeof(double);
+                    break;
+            }
+            break;
+        case '@': {
+            switch (val_type) {
+                case BYTEARRAY_TYPECODE:
+                case 'b':
+                case 'B':
+                    align = size = 1;
+                    break;
+                case 'h':
+                case 'H':
+                    align = alignof(short);
+                    size = sizeof(short);
+                    break;
+                case 'i':
+                case 'I':
+                    align = alignof(int);
+                    size = sizeof(int);
+                    break;
+                case 'l':
+                case 'L':
+                    align = alignof(long);
+                    size = sizeof(long);
+                    break;
+                case 'q':
+                case 'Q':
+                    align = alignof(long long);
+                    size = sizeof(long long);
+                    break;
+                case 'P':
+                case 'O':
+                case 'S':
+                    align = alignof(void *);
+                    size = sizeof(void *);
+                    break;
+                case 'f':
+                    align = alignof(float);
+                    size = sizeof(float);
+                    break;
+                case 'd':
+                    align = alignof(double);
+                    size = sizeof(double);
+                    break;
+            }
+        }
+    }
+
+    if (size == 0) {
+        mp_raise_ValueError(MP_ERROR_TEXT("bad typecode"));
+    }
+    { slice_runtime.bin_size = ((mp_int_t)size); slice_runtime.bin_align = (align); slice_runtime.bin_type = ((mp_int_t)(unsigned char)val_type); }
+    if (palign != NULL) {
+        *palign = align;
+    }
+    return size;
+}
+
+mp_obj_t mp_slice_binary_get_val_array(char typecode, void *p, size_t index) {
+    mp_int_t val = 0;
+    { slice_runtime.bin_size = (0); slice_runtime.bin_align = ((mp_int_t)index); slice_runtime.bin_type = ((mp_int_t)(unsigned char)typecode); }
+    switch (typecode) {
+        case 'b':
+            val = ((signed char *)p)[index];
+            break;
+        case BYTEARRAY_TYPECODE:
+        case 'B':
+            val = ((unsigned char *)p)[index];
+            break;
+        case 'h':
+            val = ((short *)p)[index];
+            break;
+        case 'H':
+            val = ((unsigned short *)p)[index];
+            break;
+        case 'i':
+            val = ((int *)p)[index];
+            break;
+        case 'I':
+            val = ((unsigned int *)p)[index];
+            break;
+        case 'l':
+            val = ((long *)p)[index];
+            break;
+        case 'L':
+            val = ((unsigned long *)p)[index];
+            break;
+        #if MICROPY_LONGINT_IMPL != MICROPY_LONGINT_IMPL_NONE
+        case 'q':
+            return mp_obj_new_int_from_ll(((long long *)p)[index]);
+        case 'Q':
+            return mp_obj_new_int_from_ull(((unsigned long long *)p)[index]);
+        #endif
+        #if MICROPY_PY_BUILTINS_FLOAT
+        case 'f':
+            return mp_obj_new_float_from_f(((float *)p)[index]);
+        case 'd':
+            return mp_obj_new_float_from_d(((double *)p)[index]);
+        #endif
+        case 'O':
+            return ((mp_obj_t *)p)[index];
+        case 'P':
+            return mp_obj_new_int_from_uint((mp_uint_t)(uintptr_t)((void **)p)[index]);
+    }
+    return MP_OBJ_NEW_SMALL_INT(val);
+}
+
+long long mp_slice_binary_get_int(size_t size, bool is_signed, bool big_endian, const byte *src) {
+    int delta;
+    if (big_endian) {
+        delta = -1;
+        src += size - 1;
+    } else {
+        delta = 1;
+    }
+    { slice_runtime.bin_size = ((mp_int_t)size); slice_runtime.bin_align = (big_endian); slice_runtime.bin_type = (is_signed); }
+
+    unsigned long long val = 0;
+    if (is_signed && (*src & 0x80) != 0) {
+        val = -1;
+    }
+    for (uint i = 0; i < size; i++) {
+        val = (val << 8) | *src;
+        src += delta;
+    }
+    return val;
+}
+
+void mp_slice_binary_set_int(size_t val_sz, bool big_endian, byte *dest, mp_uint_t val) {
+    { slice_runtime.bin_size = ((mp_int_t)val_sz); slice_runtime.bin_align = (big_endian); slice_runtime.bin_type = (0); }
+    if (MP_ENDIANNESS_LITTLE && !big_endian) {
+        memcpy(dest, &val, val_sz);
+    } else if (MP_ENDIANNESS_BIG && big_endian) {
+        memcpy(dest, (byte *)&val + sizeof(mp_uint_t) - val_sz, val_sz);
+    } else {
+        const byte *src;
+        if (MP_ENDIANNESS_LITTLE) {
+            src = (const byte *)&val + val_sz;
+        } else {
+            src = (const byte *)&val + sizeof(mp_uint_t);
+        }
+        while (val_sz--) {
+            *dest++ = *--src;
+        }
+    }
+}
+
+mp_obj_t mp_slice_binary_get_val(char struct_type, char val_type, byte *p_base, byte **ptr) {
+    byte *p = *ptr;
+    size_t align;
+    size_t size = mp_slice_binary_get_size(struct_type, val_type, &align);
+    if (struct_type == '@') {
+        p = p_base + (uintptr_t)MP_ALIGN(p - p_base, align);
+        if (MP_ENDIANNESS_LITTLE) {
+            struct_type = '<';
+        } else {
+            struct_type = '>';
+        }
+    }
+    *ptr = p + size;
+    { slice_runtime.bin_size = ((mp_int_t)size); slice_runtime.bin_align = ((mp_int_t)align); slice_runtime.bin_type = ((mp_int_t)(unsigned char)val_type); }
+
+    mp_uint_t val = 0;
+    switch (val_type) {
+        #if MICROPY_PY_BUILTINS_FLOAT
+        case 'f': {
+            union {
+                uint32_t i;
+                float f;
+            } fp_sp;
+            fp_sp.i = mp_slice_binary_get_int(sizeof(float), false, struct_type == '>', p);
+            return mp_obj_new_float_from_f(fp_sp.f);
+        }
+        case 'd': {
+            union {
+                uint64_t i64;
+                uint32_t i32[2];
+                double f;
+            } fp_dp;
+            if (MP_BYTES_PER_OBJ_WORD == 8) {
+                fp_dp.i64 = mp_slice_binary_get_int(sizeof(double), false, struct_type == '>', p);
+            } else {
+                int be = struct_type == '>';
+                fp_dp.i32[MP_ENDIANNESS_BIG ^ be] = mp_slice_binary_get_int(sizeof(uint32_t), false, be, p);
+                fp_dp.i32[MP_ENDIANNESS_LITTLE ^ be] = mp_slice_binary_get_int(sizeof(uint32_t), false, be, p + sizeof(uint32_t));
+            }
+            return mp_obj_new_float_from_d(fp_dp.f);
+        }
+        #endif
+        case 'O':
+            return (mp_obj_t)(uintptr_t)mp_slice_binary_get_int(sizeof(mp_obj_t), false, struct_type == '>', p);
+        default:
+            val = mp_slice_binary_get_int(size, val_type == 'b' || val_type == 'h' || val_type == 'i' || val_type == 'l' || val_type == 'q', struct_type == '>', p);
+            break;
+    }
+    if (val_type == 'P') {
+        return mp_obj_new_int_from_uint(val);
+    } else if (val_type == 'Q' || (sizeof(val) == 8 && (val_type == 'L' || val_type == 'I'))) {
+        return mp_obj_new_int_from_uint(val);
+    } else if ((val_type == 'q') || (sizeof(val) == 8 && (val_type == 'l' || val_type == 'i'))) {
+        return mp_obj_new_int_from_ll(val);
+    }
+    return mp_obj_new_int(val);
+}
+
+void mp_slice_binary_set_val(char struct_type, char val_type, mp_obj_t val_in, byte *p_base, byte **ptr) {
+    byte *p = *ptr;
+    size_t align;
+    size_t size = mp_slice_binary_get_size(struct_type, val_type, &align);
+    if (struct_type == '@') {
+        p = p_base + (uintptr_t)MP_ALIGN(p - p_base, align);
+        if (MP_ENDIANNESS_LITTLE) {
+            struct_type = '<';
+        } else {
+            struct_type = '>';
+        }
+    }
+    *ptr = p + size;
+    { slice_runtime.bin_size = ((mp_int_t)size); slice_runtime.bin_align = ((mp_int_t)align); slice_runtime.bin_type = ((mp_int_t)(unsigned char)val_type); }
+
+    mp_uint_t val;
+    switch (val_type) {
+        case 'O':
+            val = (mp_uint_t)val_in;
+            break;
+        #if MICROPY_PY_BUILTINS_FLOAT
+        case 'f': {
+            union {
+                uint32_t i;
+                float f;
+            } fp_sp;
+            fp_sp.f = mp_obj_get_float_to_f(val_in);
+            val = fp_sp.i;
+            break;
+        }
+        case 'd': {
+            union {
+                uint64_t i64;
+                uint32_t i32[2];
+                double f;
+            } fp_dp;
+            fp_dp.f = mp_obj_get_float_to_d(val_in);
+            if (MP_BYTES_PER_OBJ_WORD == 8) {
+                val = fp_dp.i64;
+            } else {
+                int be = struct_type == '>';
+                mp_slice_binary_set_int(sizeof(uint32_t), be, p, fp_dp.i32[MP_ENDIANNESS_BIG ^ be]);
+                p += sizeof(uint32_t);
+                val = fp_dp.i32[MP_ENDIANNESS_LITTLE ^ be];
+            }
+            break;
+        }
+        #endif
+        default:
+            #if MICROPY_LONGINT_IMPL != MICROPY_LONGINT_IMPL_NONE
+            if (mp_obj_is_exact_type(val_in, &mp_type_int)) {
+                mp_obj_int_to_bytes_impl(val_in, struct_type == '>', size, p);
+                return;
+            }
+            #endif
+            val = mp_obj_get_int(val_in);
+            if (MP_BYTES_PER_OBJ_WORD < 8 && size > sizeof(val)) {
+                int c = (mp_int_t)val < 0 ? 0xff : 0x00;
+                memset(p, c, size);
+                if (struct_type == '>') {
+                    p += size - sizeof(val);
+                }
+            }
+            break;
+    }
+    mp_slice_binary_set_int(MIN((size_t)size, sizeof(val)), struct_type == '>', p, val);
+}
+
+void mp_slice_binary_set_val_array_from_int(char typecode, void *p, size_t index, mp_int_t val) {
+    { slice_runtime.bin_size = (0); slice_runtime.bin_align = ((mp_int_t)index); slice_runtime.bin_type = ((mp_int_t)(unsigned char)typecode); }
+    switch (typecode) {
+        case 'b':
+            ((signed char *)p)[index] = val;
+            break;
+        case BYTEARRAY_TYPECODE:
+        case 'B':
+            ((unsigned char *)p)[index] = val;
+            break;
+        case 'h':
+            ((short *)p)[index] = val;
+            break;
+        case 'H':
+            ((unsigned short *)p)[index] = val;
+            break;
+        case 'i':
+            ((int *)p)[index] = val;
+            break;
+        case 'I':
+            ((unsigned int *)p)[index] = val;
+            break;
+        case 'l':
+            ((long *)p)[index] = val;
+            break;
+        case 'L':
+            ((unsigned long *)p)[index] = val;
+            break;
+        #if MICROPY_LONGINT_IMPL != MICROPY_LONGINT_IMPL_NONE
+        case 'q':
+            ((long long *)p)[index] = val;
+            break;
+        case 'Q':
+            ((unsigned long long *)p)[index] = val;
+            break;
+        #endif
+        #if MICROPY_PY_BUILTINS_FLOAT
+        case 'f':
+            ((float *)p)[index] = (float)val;
+            break;
+        case 'd':
+            ((double *)p)[index] = (double)val;
+            break;
+        #endif
+        case 'P':
+            ((void **)p)[index] = (void *)(uintptr_t)val;
+            break;
+    }
+}
+
+void mp_slice_binary_set_val_array(char typecode, void *p, size_t index, mp_obj_t val_in) {
+    { slice_runtime.bin_size = (0); slice_runtime.bin_align = ((mp_int_t)index); slice_runtime.bin_type = ((mp_int_t)(unsigned char)typecode); }
+    switch (typecode) {
+        #if MICROPY_PY_BUILTINS_FLOAT
+        case 'f':
+            ((float *)p)[index] = mp_obj_get_float_to_f(val_in);
+            break;
+        case 'd':
+            ((double *)p)[index] = mp_obj_get_float_to_d(val_in);
+            break;
+        #endif
+        case 'O':
+            ((mp_obj_t *)p)[index] = val_in;
+            break;
+        default:
+            #if MICROPY_LONGINT_IMPL != MICROPY_LONGINT_IMPL_NONE
+            if (mp_obj_is_exact_type(val_in, &mp_type_int)) {
+                size_t size = mp_slice_binary_get_size('@', typecode, NULL);
+                mp_obj_int_to_bytes_impl(val_in, MP_ENDIANNESS_BIG,
+                    size, (uint8_t *)p + index * size);
+                return;
+            }
+            #endif
+            mp_slice_binary_set_val_array_from_int(typecode, p, index, mp_obj_get_int(val_in));
+    }
+}
