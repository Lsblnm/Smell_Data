+    if (self->len > 1) {
+        mp_slice_quicksort(self->items, self->items + self->len - 1,
+            args.key.u_obj == mp_const_none ? MP_OBJ_NULL : args.key.u_obj,
+            args.reverse.u_bool ? mp_const_false : mp_const_true);
