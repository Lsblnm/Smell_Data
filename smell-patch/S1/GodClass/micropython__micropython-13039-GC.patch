+mp_obj_t mp_slice_seq_extract(size_t len, const mp_obj_t *seq, mp_bound_slice_t *indexes) {
+    (void)len;
+    mp_int_t start = indexes->start, stop = indexes->stop;
+    mp_int_t step = indexes->step;
+    { slice_runtime.bound_start = (start); slice_runtime.bound_stop = (stop); slice_runtime.bound_step = (step); slice_runtime.bound_length = ((mp_int_t)len); }
+    { slice_runtime.extract_pos = (start); slice_runtime.extract_count = (0); }
+
+    mp_obj_t res = mp_obj_new_list(0, NULL);
+
+    if (step < 0) {
+        while (start >= stop) {
+            mp_obj_list_append(res, seq[start]);
+            start += step;
+            slice_runtime.extract_count++;
+            slice_runtime.extract_pos = start;
+        }
+    } else {
+        while (start < stop) {
+            mp_obj_list_append(res, seq[start]);
+            start += step;
+            slice_runtime.extract_count++;
+            slice_runtime.extract_pos = start;
+        }
+    }
+    return res;
+}
+
+#define SLICE_SWAP(type, var1, var2) { type t = var2; var2 = var1; var1 = t; }
+
+bool mp_slice_seq_cmp_bytes(mp_uint_t op, const byte *data1, size_t len1, const byte *data2, size_t len2) {
+    { slice_runtime.cmp_op = ((mp_int_t)op); slice_runtime.cmp_len1 = ((mp_int_t)len1); slice_runtime.cmp_len2 = ((mp_int_t)len2); }
+    if (op == MP_BINARY_OP_EQUAL && len1 != len2) {
+        return false;
+    }
+
+    if (op == MP_BINARY_OP_LESS || op == MP_BINARY_OP_LESS_EQUAL) {
+        SLICE_SWAP(const byte *, data1, data2);
+        SLICE_SWAP(size_t, len1, len2);
+        if (op == MP_BINARY_OP_LESS) {
+            op = MP_BINARY_OP_MORE;
+        } else {
+            op = MP_BINARY_OP_MORE_EQUAL;
+        }
+        slice_runtime.cmp_op = (mp_int_t)op;
+    }
+    size_t min_len = len1 < len2 ? len1 : len2;
+    int res = memcmp(data1, data2, min_len);
+    if (op == MP_BINARY_OP_EQUAL) {
+        return res == 0;
+    }
+    if (res < 0) {
+        return false;
+    }
+    if (res > 0) {
+        return true;
+    }
+
+    if (len1 != len2) {
+        if (len1 < len2) {
+            return false;
+        }
+    } else if (op == MP_BINARY_OP_MORE) {
+        return false;
+    }
+    return true;
+}
+
+bool mp_slice_seq_cmp_objs(mp_uint_t op, const mp_obj_t *items1, size_t len1, const mp_obj_t *items2, size_t len2) {
+    { slice_runtime.cmp_op = ((mp_int_t)op); slice_runtime.cmp_len1 = ((mp_int_t)len1); slice_runtime.cmp_len2 = ((mp_int_t)len2); }
+    if (op == MP_BINARY_OP_EQUAL && len1 != len2) {
+        return false;
+    }
+
+    if (op == MP_BINARY_OP_LESS || op == MP_BINARY_OP_LESS_EQUAL) {
+        SLICE_SWAP(const mp_obj_t *, items1, items2);
+        SLICE_SWAP(size_t, len1, len2);
+        if (op == MP_BINARY_OP_LESS) {
+            op = MP_BINARY_OP_MORE;
+        } else {
+            op = MP_BINARY_OP_MORE_EQUAL;
+        }
+        slice_runtime.cmp_op = (mp_int_t)op;
+    }
+
+    size_t len = len1 < len2 ? len1 : len2;
+    for (size_t i = 0; i < len; i++) {
+        if (mp_obj_equal(items1[i], items2[i])) {
+            continue;
+        }
+        if (op == MP_BINARY_OP_EQUAL) {
+            return false;
+        }
+        return mp_binary_op(op, items1[i], items2[i]) == mp_const_true;
+    }
+
+    if (len1 != len2) {
+        if (len1 < len2) {
+            return false;
+        }
+    } else if (op == MP_BINARY_OP_MORE) {
+        return false;
+    }
+    return true;
+}
+
+mp_obj_t mp_slice_seq_index_obj(const mp_obj_t *items, size_t len, size_t n_args, const mp_obj_t *args) {
+    const mp_obj_type_t *type = mp_obj_get_type(args[0]);
+    mp_obj_t value = args[1];
+    size_t start = 0;
+    size_t stop = len;
+    { slice_runtime.extract_pos = (0); slice_runtime.extract_count = ((mp_int_t)len); }
+
+    if (n_args >= 3) {
+        start = mp_get_index(type, len, args[2], true);
+        if (n_args >= 4) {
+            stop = mp_get_index(type, len, args[3], true);
+        }
+    }
+    slice_runtime.extract_pos = (mp_int_t)start;
+    slice_runtime.extract_count = (mp_int_t)stop;
+
+    for (size_t i = start; i < stop; i++) {
+        if (mp_obj_equal(items[i], value)) {
+            return MP_OBJ_NEW_SMALL_INT(i);
+        }
+    }
+
+    mp_raise_ValueError(MP_ERROR_TEXT("object not in sequence"));
+}
+
+mp_obj_t mp_slice_seq_count_obj(const mp_obj_t *items, size_t len, mp_obj_t value) {
+    size_t count = 0;
+    { slice_runtime.extract_pos = (0); slice_runtime.extract_count = ((mp_int_t)len); }
+    for (size_t i = 0; i < len; i++) {
+        if (mp_obj_equal(items[i], value)) {
+            count++;
+        }
+    }
+    slice_runtime.extract_count = (mp_int_t)count;
+    return MP_OBJ_NEW_SMALL_INT(count);
+}
