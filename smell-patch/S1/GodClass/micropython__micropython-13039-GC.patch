+
+void mp_slice_seq_multiply(const void *items, size_t item_sz, size_t len, size_t times, void *dest) {
+    { slice_runtime.extract_pos = ((mp_int_t)len); slice_runtime.extract_count = ((mp_int_t)times); }
+    for (size_t i = 0; i < times; i++) {
+        size_t copy_sz = item_sz * len;
+        mp_slice_copy_bytes(dest, items, copy_sz);
+        dest = (char *)dest + copy_sz;
+    }
+}
