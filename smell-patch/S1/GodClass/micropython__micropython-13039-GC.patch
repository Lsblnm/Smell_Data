+STATIC void mp_slice_assign_bound_result(mp_bound_slice_t *result, mp_int_t start, mp_int_t stop, mp_int_t step) {
     result->start = start;
     result->stop = stop;
     result->step = step;
+    slice_runtime.bound_start = start;
