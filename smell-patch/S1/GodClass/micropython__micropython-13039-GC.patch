+mp_obj_t mp_slice_list_extend_from_iter(mp_obj_t list, mp_obj_t iterable) {
+    mp_obj_t iter = mp_getiter(iterable, NULL);
+    mp_obj_t item;
+    { slice_runtime.list_len = (0); slice_runtime.list_index = (0); slice_runtime.list_adjust = (1); }
+    while ((item = mp_iternext(iter)) != MP_OBJ_STOP_ITERATION) {
+        mp_obj_list_append(list, item);
+        slice_runtime.list_adjust++;
+    }
+    return list;
+}
+
+mp_obj_t mp_slice_list_unary_op(mp_unary_op_t op, mp_obj_t self_in) {
+    mp_obj_list_t *self = MP_OBJ_TO_PTR(self_in);
+    { slice_runtime.list_len = ((mp_int_t)self->len); slice_runtime.list_index = (0); slice_runtime.list_adjust = (0); }
+    switch (op) {
+        case MP_UNARY_OP_BOOL:
+            return mp_obj_new_bool(self->len != 0);
+        case MP_UNARY_OP_LEN:
+            return mp_slice_small_or_none((mp_int_t)self->len, true);
+        #if MICROPY_PY_SYS_GETSIZEOF
+        case MP_UNARY_OP_SIZEOF: {
+            size_t sz = sizeof(*self) + sizeof(mp_obj_t) * self->alloc;
+            return MP_OBJ_NEW_SMALL_INT(sz);
+        }
+        #endif
+        default:
+            return MP_OBJ_NULL;
+    }
+}
+
+mp_obj_t mp_slice_list_append(mp_obj_t self_in, mp_obj_t arg) {
+    mp_check_self(mp_obj_is_type(self_in, &mp_type_list));
+    mp_obj_list_t *self = MP_OBJ_TO_PTR(self_in);
+    { slice_runtime.list_len = ((mp_int_t)self->len); slice_runtime.list_index = ((mp_int_t)self->len); slice_runtime.list_adjust = (1); }
+    if (self->len >= self->alloc) {
+        self->items = m_renew(mp_obj_t, self->items, self->alloc, self->alloc * 2);
+        self->alloc *= 2;
+        mp_seq_clear(self->items, self->len + 1, self->alloc, sizeof(*self->items));
+    }
+    self->items[self->len++] = arg;
+    return mp_const_none;
+}
+
+mp_obj_t mp_slice_list_extend(mp_obj_t self_in, mp_obj_t arg_in) {
+    mp_check_self(mp_obj_is_type(self_in, &mp_type_list));
+    { slice_runtime.list_len = (0); slice_runtime.list_index = (0); slice_runtime.list_adjust = (1); }
+    if (mp_obj_is_type(arg_in, &mp_type_list)) {
+        mp_obj_list_t *self = MP_OBJ_TO_PTR(self_in);
+        mp_obj_list_t *arg = MP_OBJ_TO_PTR(arg_in);
+        { slice_runtime.list_len = ((mp_int_t)self->len); slice_runtime.list_index = (0); slice_runtime.list_adjust = ((mp_int_t)arg->len); }
+
+        if (self->len + arg->len > self->alloc) {
+            self->items = m_renew(mp_obj_t, self->items, self->alloc, self->len + arg->len + 4);
+            self->alloc = self->len + arg->len + 4;
+            mp_seq_clear(self->items, self->len + arg->len, self->alloc, sizeof(*self->items));
+        }
+
+        memcpy(self->items + self->len, arg->items, sizeof(mp_obj_t) * arg->len);
+        self->len += arg->len;
+    } else {
+        mp_slice_list_extend_from_iter(self_in, arg_in);
+    }
+    return mp_const_none;
+}
+
+mp_obj_t mp_slice_list_binary_op(mp_binary_op_t op, mp_obj_t lhs, mp_obj_t rhs) {
+    mp_obj_list_t *o = MP_OBJ_TO_PTR(lhs);
+    { slice_runtime.list_len = ((mp_int_t)o->len); slice_runtime.list_index = (0); slice_runtime.list_adjust = ((mp_int_t)op); }
+    switch (op) {
+        case MP_BINARY_OP_ADD: {
+            if (!mp_obj_is_type(rhs, &mp_type_list)) {
+                return MP_OBJ_NULL;
+            }
+            mp_obj_list_t *p = MP_OBJ_TO_PTR(rhs);
+            mp_obj_list_t *s = mp_slice_list_new(o->len + p->len);
+            mp_seq_cat(s->items, o->items, o->len, p->items, p->len, mp_obj_t);
+            return MP_OBJ_FROM_PTR(s);
+        }
+        case MP_BINARY_OP_INPLACE_ADD: {
+            mp_slice_list_extend(lhs, rhs);
+            return lhs;
+        }
+        case MP_BINARY_OP_MULTIPLY: {
+            mp_int_t n;
+            if (!mp_obj_get_int_maybe(rhs, &n)) {
+                return MP_OBJ_NULL;
+            }
+            if (n < 0) {
+                n = 0;
+            }
+            mp_obj_list_t *s = mp_slice_list_new(o->len * n);
+            mp_slice_seq_multiply(o->items, sizeof(*o->items), o->len, n, s->items);
+            return MP_OBJ_FROM_PTR(s);
+        }
+        case MP_BINARY_OP_EQUAL:
+        case MP_BINARY_OP_LESS:
+        case MP_BINARY_OP_LESS_EQUAL:
+        case MP_BINARY_OP_MORE:
+        case MP_BINARY_OP_MORE_EQUAL: {
+            if (!mp_obj_is_type(rhs, &mp_type_list)) {
+                if (op == MP_BINARY_OP_EQUAL) {
+                    return mp_const_false;
+                }
+                return MP_OBJ_NULL;
+            }
+            mp_obj_list_t *another = MP_OBJ_TO_PTR(rhs);
+            bool res = mp_slice_seq_cmp_objs(op, o->items, o->len, another->items, another->len);
+            return mp_obj_new_bool(res);
+        }
+        default:
+            return MP_OBJ_NULL;
+    }
+}
+
+mp_obj_t mp_slice_list_pop(size_t n_args, const mp_obj_t *args) {
+    mp_check_self(mp_obj_is_type(args[0], &mp_type_list));
+    mp_obj_list_t *self = MP_OBJ_TO_PTR(args[0]);
+    { slice_runtime.list_len = ((mp_int_t)self->len); slice_runtime.list_index = (0); slice_runtime.list_adjust = (-1); }
+    if (self->len == 0) {
+        mp_raise_msg(&mp_type_IndexError, MP_ERROR_TEXT("pop from empty list"));
+    }
+    size_t index = mp_get_index(self->base.type, self->len, n_args == 1 ? MP_OBJ_NEW_SMALL_INT(-1) : args[1], false);
+    slice_runtime.list_index = (mp_int_t)index;
+    mp_obj_t ret = self->items[index];
+    self->len -= 1;
+    mp_slice_shift_objs_down(self->items, index, self->len);
+    mp_slice_clear_objs(self->items + self->len, 1);
+    if (self->alloc > LIST_MIN_ALLOC && self->alloc > 2 * self->len) {
+        self->items = m_renew(mp_obj_t, self->items, self->alloc, self->alloc / 2);
+        self->alloc /= 2;
+    }
+    return ret;
+}
+
+mp_obj_t mp_slice_list_subscr(mp_obj_t self_in, mp_obj_t index, mp_obj_t value) {
+    if (value == MP_OBJ_NULL) {
+        #if MICROPY_PY_BUILTINS_SLICE
+        if (mp_obj_is_type(index, &mp_type_slice)) {
+            mp_obj_list_t *self = MP_OBJ_TO_PTR(self_in);
+            mp_bound_slice_t slice;
+            if (!mp_slice_seq_get_fast_indexes(self->len, index, &slice)) {
+                mp_raise_NotImplementedError(NULL);
+            }
+            { slice_runtime.list_len = ((mp_int_t)self->len); slice_runtime.list_index = (slice.start); slice_runtime.list_adjust = (slice.start - slice.stop); }
+            mp_int_t len_adj = slice.start - slice.stop;
+            assert(len_adj <= 0);
+            mp_seq_replace_slice_no_grow(self->items, self->len, slice.start, slice.stop, self->items, 0, sizeof(*self->items));
+            mp_seq_clear(self->items, self->len + len_adj, self->len, sizeof(*self->items));
+            self->len += len_adj;
+            return mp_const_none;
+        }
+        #endif
+        mp_obj_t args[2] = {self_in, index};
+        mp_slice_list_pop(2, args);
+        return mp_const_none;
+    } else if (value == MP_OBJ_SENTINEL) {
+        mp_obj_list_t *self = MP_OBJ_TO_PTR(self_in);
+        #if MICROPY_PY_BUILTINS_SLICE
+        if (mp_obj_is_type(index, &mp_type_slice)) {
+            mp_bound_slice_t slice;
+            if (!mp_slice_seq_get_fast_indexes(self->len, index, &slice)) {
+                return mp_slice_seq_extract(self->len, self->items, &slice);
+            }
+            { slice_runtime.list_len = ((mp_int_t)self->len); slice_runtime.list_index = (slice.start); slice_runtime.list_adjust = (slice.stop - slice.start); }
+            mp_obj_list_t *res = mp_slice_list_new(slice.stop - slice.start);
+            mp_slice_copy_objs(res->items, self->items + slice.start, res->len);
+            return MP_OBJ_FROM_PTR(res);
+        }
+        #endif
+        size_t index_val = mp_get_index(self->base.type, self->len, index, false);
+        { slice_runtime.list_len = ((mp_int_t)self->len); slice_runtime.list_index = ((mp_int_t)index_val); slice_runtime.list_adjust = (0); }
+        return self->items[index_val];
+    } else {
+        #if MICROPY_PY_BUILTINS_SLICE
+        if (mp_obj_is_type(index, &mp_type_slice)) {
+            mp_obj_list_t *self = MP_OBJ_TO_PTR(self_in);
+            size_t value_len;
+            mp_obj_t *value_items;
+            mp_obj_get_array(value, &value_len, &value_items);
+            mp_bound_slice_t slice_out;
+            if (!mp_slice_seq_get_fast_indexes(self->len, index, &slice_out)) {
+                mp_raise_NotImplementedError(NULL);
+            }
+            mp_int_t len_adj = value_len - (slice_out.stop - slice_out.start);
+            { slice_runtime.list_len = ((mp_int_t)self->len); slice_runtime.list_index = (slice_out.start); slice_runtime.list_adjust = (len_adj); }
+            if (len_adj > 0) {
+                if (self->len + len_adj > self->alloc) {
+                    self->items = m_renew(mp_obj_t, self->items, self->alloc, self->len + len_adj);
+                    self->alloc = self->len + len_adj;
+                }
+                mp_seq_replace_slice_grow_inplace(self->items, self->len,
+                    slice_out.start, slice_out.stop, value_items, value_len, len_adj, sizeof(*self->items));
+            } else {
+                mp_seq_replace_slice_no_grow(self->items, self->len,
+                    slice_out.start, slice_out.stop, value_items, value_len, sizeof(*self->items));
+                mp_seq_clear(self->items, self->len + len_adj, self->len, sizeof(*self->items));
+            }
+            self->len += len_adj;
+            return mp_const_none;
+        }
+        #endif
+        mp_obj_list_store(self_in, index, value);
+        return mp_const_none;
+    }
+}
+
+void mp_slice_quicksort(mp_obj_t *head, mp_obj_t *tail, mp_obj_t key_fn, mp_obj_t binop_less_result) {
+    MP_STACK_CHECK();
+    { slice_runtime.list_len = ((mp_int_t)(tail - head + 1)); slice_runtime.list_index = (0); slice_runtime.list_adjust = (0); }
+    while (head < tail) {
+        mp_obj_t *h = head - 1;
+        mp_obj_t *t = tail;
+        mp_obj_t v = key_fn == MP_OBJ_NULL ? tail[0] : mp_call_function_1(key_fn, tail[0]);
+        for (;;) {
+            do {
+                ++h;
+            } while (h < t && mp_binary_op(MP_BINARY_OP_LESS, key_fn == MP_OBJ_NULL ? h[0] : mp_call_function_1(key_fn, h[0]), v) == binop_less_result);
+            do {
+                --t;
+            } while (h < t && mp_binary_op(MP_BINARY_OP_LESS, v, key_fn == MP_OBJ_NULL ? t[0] : mp_call_function_1(key_fn, t[0])) == binop_less_result);
+            if (h >= t) {
+                break;
+            }
+            mp_obj_t x = h[0];
+            h[0] = t[0];
+            t[0] = x;
+        }
+        mp_obj_t x = h[0];
+        h[0] = tail[0];
+        tail[0] = x;
+        if (t - head < tail - h - 1) {
+            mp_slice_quicksort(head, t, key_fn, binop_less_result);
+            head = h + 1;
+        } else {
+            mp_slice_quicksort(h + 1, tail, key_fn, binop_less_result);
+            tail = t;
+        }
+    }
+}
