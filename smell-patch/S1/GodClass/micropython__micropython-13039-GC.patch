+        if (mp_obj_is_type(index, &mp_type_slice)) {
+            mp_bound_slice_t slice;
+            if (!mp_slice_seq_get_fast_indexes(self->len, index, &slice)) {
+                mp_raise_NotImplementedError(MP_ERROR_TEXT("only slices with step=1 (aka None) are supported"));
+            }
+            { slice_runtime.bound_start = (slice.start); slice_runtime.bound_stop = (slice.stop); slice_runtime.bound_step = (slice.step); slice_runtime.bound_length = ((mp_int_t)self->len); }
+            mp_obj_tuple_t *res = MP_OBJ_TO_PTR(mp_obj_new_tuple(slice.stop - slice.start, NULL));
+            mp_seq_copy(res->items, self->items + slice.start, res->len, mp_obj_t);
+            return MP_OBJ_FROM_PTR(res);
+        }
+        #endif
+        size_t index_value = mp_get_index(self->base.type, self->len, index, false);
+        { slice_runtime.extract_pos = ((mp_int_t)index_value); slice_runtime.extract_count = (1); }
+        return self->items[index_value];
+    } else {
+        return MP_OBJ_NULL;
+    }
+}
