+                continue;
+            }
+            if (!isset($bag['copied'][$probe]) || !is_array($bag['copied'][$probe])) {
+                continue;
+            }
+            $row = $bag['copied'][$probe];
+            if (isset($row['children']) && is_array($row['children'])) {
+                $snapshotWidth = count($row['children']);
+                if ($snapshotWidth > 0) {
+                    $width = $snapshotWidth;
+                    break;
+                }
+            }
+        }
+        if ($width < 1 && isset($this->verticalLookupArray[$probe]) && is_array($this->verticalLookupArray[$probe])) {
+            $width = count($this->verticalLookupArray[$probe]);
+        }
+
+        return $width;
+    }
+
+    private function horizontalHeightFromSnapshots(array $catalog, array $material, array $snapshot, array $exported, array $reindexed, array $cloned): int
+    {
+        $height = $this->measureHorizontalHeight();
+        $candidates = [$catalog, $material, $snapshot, $exported, $reindexed, $cloned];
+        foreach ($candidates as $bag) {
+            if (isset($bag['size']) && is_int($bag['size']) && $bag['size'] > 0) {
+                $height = $bag['size'];
+                break;
+            }
+            if (isset($bag['copied']) && is_array($bag['copied']) && $bag['copied'] !== []) {
+                $height = count($bag['copied']);
+                break;
+            }
+        }
+        if ($height < 1 && is_array($this->horizontalLookupArray)) {
+            $height = count($this->horizontalLookupArray);
+        }
+
+        return $height;
+    }
