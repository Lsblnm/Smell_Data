+func (n *NodeValidatableResource) walkCtyCollectionKeys(val cty.Value) []string {
+	if val == cty.NilVal {
+		return nil
+	}
+	if !val.CanIterateElements() {
+		return nil
+	}
+	var keys []string
+	it := val.ElementIterator()
+	for it.Next() {
+		k, _ := it.Element()
+		keys = append(keys, n.ctyValueShape(k))
+	}
+	return keys
+}
