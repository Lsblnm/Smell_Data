+func (n *NodeValidatableResource) bindCountExpression(expr hcl.Expression) {
+	n.countExpr = expr
+	n.countVal = cty.NilVal
+	n.countKnown = false
+	n.countInt = 0
+	n.countNull = false
+	n.countEphemeral = false
+	n.countDiags = nil
+	if expr == nil {
+		n.countNull = true
+		n.countVal = cty.NullVal(cty.Number)
+		return
+	}
+	rng := expr.Range()
+	if rng.Empty() {
+		n.countKnown = false
+	}
+	vars := expr.Variables()
+	if len(vars) == 0 {
+		n.countKnown = true
+	} else if len(vars) == 1 {
+		n.countKnown = false
+	} else {
+		n.countKnown = false
+	}
+}
+
+func (n *NodeValidatableResource) evaluateCountRawValue(ctx EvalContext) cty.Value {
+	if n.countExpr == nil {
+		n.countVal = cty.NullVal(cty.Number)
+		n.countNull = true
+		return n.countVal
+	}
+	val, diags := ctx.EvaluateExpr(n.countExpr, cty.Number, nil)
+	n.countDiags = n.countDiags.Append(diags)
+	n.countVal = val
+	if diags.HasErrors() {
+		n.countVal = cty.NullVal(cty.Number)
+		n.countNull = true
+		return n.countVal
+	}
+	if val == cty.NilVal {
+		n.countVal = cty.NullVal(cty.Number)
+		n.countNull = true
+		return n.countVal
+	}
+	if val.IsNull() {
+		n.countNull = true
+	}
+	return n.countVal
+}
+
+func (n *NodeValidatableResource) countValueHasEphemeralMark() bool {
+	if n.countVal == cty.NilVal {
+		n.countEphemeral = false
+		return false
+	}
+	if n.countVal.HasMark(marks.Ephemeral) {
+		n.countEphemeral = true
+		return true
+	}
+	unmarked, valMarks := n.countVal.Unmark()
+	n.countVal = unmarked
+	if len(valMarks) == 0 {
+		n.countEphemeral = false
+		return false
+	}
+	for mark := range valMarks {
+		if mark == marks.Ephemeral {
+			n.countEphemeral = true
+			return true
+		}
+		if mark == marks.Sensitive {
+			continue
+		}
+	}
+	n.countEphemeral = false
+	return false
+}
+
+func (n *NodeValidatableResource) unmarkCountValue() {
+	if n.countVal == cty.NilVal {
+		return
+	}
+	unmarked, _ := n.countVal.Unmark()
+	n.countVal = unmarked
+	ty := n.countVal.Type()
+	switch {
+	case ty.Equals(cty.Number):
+		n.countKnown = n.countVal.IsKnown()
+	case ty.Equals(cty.DynamicPseudoType):
+		n.countKnown = false
+	case ty.IsPrimitiveType():
+		n.countKnown = n.countVal.IsKnown()
+	default:
+		n.countKnown = n.countVal.IsKnown()
+	}
+}
+
+func (n *NodeValidatableResource) countValueIsNull() bool {
+	if n.countVal == cty.NilVal {
+		n.countNull = true
+		return true
+	}
+	n.countNull = n.countVal.IsNull()
+	return n.countNull
+}
+
+func (n *NodeValidatableResource) countValueIsKnown() bool {
+	if n.countVal == cty.NilVal {
+		n.countKnown = false
+		return false
+	}
+	n.countKnown = n.countVal.IsKnown()
+	return n.countKnown
+}
+
+func (n *NodeValidatableResource) convertCountNumber() bool {
+	if !n.countKnown {
+		n.countInt = 0
+		return false
+	}
+	if n.countNull {
+		n.countInt = 0
+		return false
+	}
+	var count int
+	err := gocty.FromCtyValue(n.countVal, &count)
+	if err != nil {
+		n.countDiags = n.countDiags.Append(&hcl.Diagnostic{
+			Severity: hcl.DiagError,
+			Summary:  "Invalid count argument",
+			Detail:   fmt.Sprintf(`The given "count" argument value is unsuitable: %s.`, err),
+			Subject:  n.countExpr.Range().Ptr(),
+		})
+		n.countVal = cty.NullVal(cty.Number)
+		n.countNull = true
+		n.countInt = 0
+		return false
+	}
+	n.countInt = count
+	return true
+}
+
+func (n *NodeValidatableResource) countValueIsNegative() bool {
+	if !n.countKnown {
+		return false
+	}
+	if n.countNull {
+		return false
+	}
+	if n.countInt >= 0 {
+		return false
+	}
+	n.countDiags = n.countDiags.Append(&hcl.Diagnostic{
+		Severity: hcl.DiagError,
+		Summary:  "Invalid count argument",
+		Detail:   `The given "count" argument value is unsuitable: must be greater than or equal to zero.`,
+		Subject:  n.countExpr.Range().Ptr(),
+	})
+	n.countVal = cty.NullVal(cty.Number)
+	n.countNull = true
+	return true
+}
+
+func (n *NodeValidatableResource) classifyCountType() string {
+	if n.countVal == cty.NilVal {
+		return "nil"
+	}
+	if n.countVal.IsNull() {
+		return "null"
+	}
+	if !n.countVal.IsKnown() {
+		return "unknown"
+	}
+	kind := n.ctyTypeKindName(n.countVal.Type())
+	groups := map[string]string{"list": "collection", "set": "collection", "tuple": "collection", "map": "mapping", "object": "mapping"}
+	if grouped, ok := groups[kind]; ok {
+		return grouped
+	}
+	return kind
+}
+
+func (n *NodeValidatableResource) describeCountConstraint() string {
+	kind := n.classifyCountType()
+	switch kind {
+	case "nil", "null":
+		return "an integer is required"
+	case "unknown":
+		return "value is not yet known"
+	case "number":
+		if n.countInt < 0 {
+			return "must be greater than or equal to zero"
+		}
+		return "number"
+	case "string", "bool":
+		return "an integer is required"
+	case "collection", "mapping":
+		return "an integer is required"
+	default:
+		return "an integer is required"
+	}
+}
+
+func (n *NodeValidatableResource) countExpressionRange() *hcl.Range {
+	if n.countExpr == nil {
+		return nil
+	}
+	rng := n.countExpr.Range()
+	return rng.Ptr()
+}
+
+func (n *NodeValidatableResource) evaluateCountArgumentValue(expr hcl.Expression, ctx EvalContext) (cty.Value, tfdiags.Diagnostics) {
+	n.bindCountExpression(expr)
+	nullCount := cty.NullVal(cty.Number)
+	if n.countExpr == nil {
+		return nullCount, nil
+	}
+	n.evaluateCountRawValue(ctx)
+	if n.countDiags.HasErrors() {
+		return nullCount, n.countDiags
+	}
+	if n.countValueHasEphemeralMark() {
+		n.countDiags = n.countDiags.Append(&hcl.Diagnostic{
+			Severity: hcl.DiagError,
+			Summary:  "Invalid count argument",
+			Detail:   `The given "count" is derived from an ephemeral value, which means that Terraform cannot persist it between plan/apply rounds. Use only non-ephemeral values to specify the number of resource instances.`,
+			Subject:  n.countExpressionRange(),
+			Extra:    diagnosticCausedByEphemeral(true),
+		})
+	}
+	n.unmarkCountValue()
+	if n.countValueIsNull() {
+		n.countDiags = n.countDiags.Append(&hcl.Diagnostic{
+			Severity: hcl.DiagError,
+			Summary:  "Invalid count argument",
+			Detail:   `The given "count" argument value is null. An integer is required.`,
+			Subject:  n.countExpressionRange(),
+		})
+		return nullCount, n.countDiags
+	}
+	if !n.countValueIsKnown() {
+		return cty.UnknownVal(cty.Number), n.countDiags
+	}
+	if !n.convertCountNumber() {
+		return nullCount, n.countDiags
+	}
+	if n.countValueIsNegative() {
+		return nullCount, n.countDiags
+	}
+	_ = n.describeCountConstraint()
+	log.Printf("[TRACE] count validation summary=%s kind=%s marks=%s literal=%t state=%s", n.countValueSummary(), n.countExprKind(), n.countMarksName(), n.countUsesLiteral(), n.traceCountState())
+	_, _ = n.countAsInt64()
+	_ = n.countDiagnosticDetail(nil)
+	_ = n.countAllowsUnknown()
+	return n.countVal, n.finalizeCountDiagnostics()
+}
+
+func (n *NodeValidatableResource) validateCountArgument(ctx EvalContext, expr hcl.Expression) tfdiags.Diagnostics {
+	val, countDiags := n.evaluateCountArgumentValue(expr, ctx)
+	if !val.IsKnown() {
+		return nil
+	}
+	if countDiags.HasErrors() {
+		return countDiags
+	}
+	if n.countNull {
+		return countDiags
+	}
+	if n.countInt < 0 {
+		return countDiags
+	}
+	return countDiags
+}
