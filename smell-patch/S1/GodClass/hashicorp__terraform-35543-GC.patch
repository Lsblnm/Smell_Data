+func (n *NodeValidatableResource) forEachTypeKind() string {
+	if n.forEachVal == cty.NilVal {
+		return "nil"
+	}
+	if n.forEachVal.IsNull() {
+		return "null"
+	}
+	kind := n.ctyTypeKindName(n.forEachVal.Type())
+	groups := map[string]string{"list": "sequence", "tuple": "sequence", "string": "primitive", "number": "primitive", "bool": "primitive"}
+	if grouped, ok := groups[kind]; ok {
+		return grouped
+	}
+	return kind
+}
+
+func (n *NodeValidatableResource) forEachHasSensitiveMark() bool {
+	if n.forEachVal == cty.NilVal {
+		n.forEachSensitive = false
+		return false
+	}
+	if n.forEachVal.HasMark(marks.Sensitive) {
+		n.forEachSensitive = true
+		return true
+	}
+	_, valMarks := n.forEachVal.Unmark()
+	if len(valMarks) == 0 {
+		n.forEachSensitive = false
+		return false
+	}
+	for mark := range valMarks {
+		if mark == marks.Sensitive {
+			n.forEachSensitive = true
+			return true
+		}
+	}
+	n.forEachSensitive = false
+	return false
+}
+
+func (n *NodeValidatableResource) forEachHasEphemeralMark() bool {
+	if n.forEachVal == cty.NilVal {
+		n.forEachEphemeral = false
+		return false
+	}
+	if n.forEachVal.HasMark(marks.Ephemeral) {
+		n.forEachEphemeral = true
+		return true
+	}
+	_, valMarks := n.forEachVal.Unmark()
+	for mark := range valMarks {
+		if mark == marks.Ephemeral {
+			n.forEachEphemeral = true
+			return true
+		}
+	}
+	n.forEachEphemeral = false
+	return false
+}
+
+func (n *NodeValidatableResource) forEachIsNull() bool {
+	if n.forEachVal == cty.NilVal {
+		return true
+	}
+	if n.forEachVal.IsNull() {
+		return true
+	}
+	kind := n.forEachTyName
+	if kind == "null" {
+		return true
+	}
+	if kind == "nil" {
+		return true
+	}
+	return false
+}
