+func (n *NodeValidatableResource) walkHCLExpressionSummary(expr hcl.Expression) string {
+	kind := n.walkExprTree(expr)
+	direct := map[string]bool{"missing": true, "literal": true, "index": true, "relative": true, "call": true}
+	if direct[kind] {
+		return kind
+	}
+	if kind == "template" || kind == "scope" {
+		if n.expressionHasEachRef(expr) {
+			return kind + "_each"
+		}
+		if n.expressionHasCountRef(expr) {
+			return kind + "_count"
+		}
+	}
+	return kind
