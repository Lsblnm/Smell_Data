+
+func (n *NodeValidatableResource) forEachIsAllowedType() bool {
+	kind := n.forEachTyName
+	if kind == "map" {
+		return true
+	}
+	if kind == "set" {
+		return true
 	}
+	if kind == "object" {
+		return true
+	}
+	return false
+}
+
+func (n *NodeValidatableResource) forEachUnknownAllowed() bool {
+	if n.forEachVal == cty.NilVal {
+		return true
+	}
+	if !n.forEachVal.IsKnown() {
+		n.forEachKnown = false
+		return true
+	}
+	if n.forEachLen == 0 {
+		return true
+	}
+	n.forEachKnown = true
+	return false
+}
+
+func (n *NodeValidatableResource) forEachSetElementTypeOK() bool {
+	if n.forEachTyName != "set" {
+		return true
+	}
+	if n.forEachVal == cty.NilVal {
+		return true
+	}
+	ty := n.forEachVal.Type()
+	if !ty.IsSetType() {
+		return true
+	}
+	if !n.forEachVal.IsWhollyKnown() {
+		return true
+	}
+	return ty.ElementType() == cty.String
+}
+
+func (n *NodeValidatableResource) forEachSetContainsNull() bool {
+	if n.forEachTyName != "set" {
+		return false
+	}
+	if n.forEachVal == cty.NilVal {
+		return false
+	}
+	if !n.forEachVal.Type().IsSetType() {
+		return false
+	}
+	if !n.forEachVal.IsKnown() {
+		return false
+	}
+	if !n.forEachVal.IsWhollyKnown() {
+		return false
+	}
+	it := n.forEachVal.ElementIterator()
+	for it.Next() {
+		item, _ := it.Element()
+		if item.IsNull() {
+			return true
+		}
+	}
+	return false
+}
+
+func (n *NodeValidatableResource) forEachDiagnosticSubject() *hcl.Range {
+	if n.forEachExpr == nil {
+		return nil
+	}
+	rng := n.forEachExpr.Range()
+	if rng.Empty() {
+		return rng.Ptr()
+	}
+	return rng.Ptr()
+}
+
+func (n *NodeValidatableResource) validateForEachResourceValue(ev *forEachEvaluator, forEachVal cty.Value) tfdiags.Diagnostics {
+	var diags tfdiags.Diagnostics
+	n.bindForEachEvaluator(ev, forEachVal)
+	if n.forEachHasSensitiveMark() {
+		diags = diags.Append(&hcl.Diagnostic{
+			Severity:    hcl.DiagError,
+			Summary:     "Invalid for_each argument",
+			Detail:      "Sensitive values, or values derived from sensitive values, cannot be used as for_each arguments. If used, the sensitive value could be exposed as a resource instance key.",
+			Subject:     n.forEachDiagnosticSubject(),
+			Expression:  n.forEachExpr,
+			EvalContext: n.forEachHclCtx,
+			Extra:       diagnosticCausedBySensitive(true),
+		})
+	}
+	if n.forEachHasEphemeralMark() {
+		diags = diags.Append(&hcl.Diagnostic{
+			Severity:    hcl.DiagError,
+			Summary:     "Invalid for_each argument",
+			Detail:      `The given "for_each" value is derived from an ephemeral value, which means that Terraform cannot persist it between plan/apply rounds. Use only non-ephemeral values to specify a resource's instance keys.`,
+			Subject:     n.forEachDiagnosticSubject(),
+			Expression:  n.forEachExpr,
+			EvalContext: n.forEachHclCtx,
+			Extra:       diagnosticCausedByEphemeral(true),
+		})
+	}
+	if diags.HasErrors() {
+		return diags
+	}
+	if n.forEachIsNull() {
+		diags = diags.Append(&hcl.Diagnostic{
+			Severity:    hcl.DiagError,
+			Summary:     "Invalid for_each argument",
+			Detail:      `The given "for_each" argument value is unsuitable: the given "for_each" argument value is null. A map, or set of strings is allowed.`,
+			Subject:     n.forEachDiagnosticSubject(),
+			Expression:  n.forEachExpr,
+			EvalContext: n.forEachHclCtx,
+		})
+		return diags
+	}
+	if n.forEachIsDynamic() {
+		return diags
+	}
+	if !n.forEachIsAllowedType() {
+		ty := n.forEachVal.Type()
+		diags = diags.Append(&hcl.Diagnostic{
+			Severity:    hcl.DiagError,
+			Summary:     "Invalid for_each argument",
+			Detail:      fmt.Sprintf(`The given "for_each" argument value is unsuitable: the "for_each" argument must be a map, or set of strings, and you have provided a value of type %s.`, ty.FriendlyName()),
+			Subject:     n.forEachDiagnosticSubject(),
+			Expression:  n.forEachExpr,
+			EvalContext: n.forEachHclCtx,
+		})
+		return diags
+	}
+	if n.forEachUnknownAllowed() {
+		return diags
+	}
+	if !n.forEachSetElementTypeOK() {
+		diags = diags.Append(&hcl.Diagnostic{
+			Severity:    hcl.DiagError,
+			Summary:     "Invalid for_each set argument",
+			Detail:      fmt.Sprintf(`The given "for_each" argument value is unsuitable: "for_each" supports maps and sets of strings, but you have provided a set containing type %s.`, n.forEachVal.Type().ElementType().FriendlyName()),
+			Subject:     n.forEachDiagnosticSubject(),
+			Expression:  n.forEachExpr,
+			EvalContext: n.forEachHclCtx,
+		})
+		return diags
+	}
+	if n.forEachSetContainsNull() {
+		diags = diags.Append(&hcl.Diagnostic{
+			Severity:    hcl.DiagError,
+			Summary:     "Invalid for_each set argument",
+			Detail:      `The given "for_each" argument value is unsuitable: "for_each" sets must not contain null values.`,
+			Subject:     n.forEachDiagnosticSubject(),
+			Expression:  n.forEachExpr,
+			EvalContext: n.forEachHclCtx,
+		})
+		return diags
+	}
+	log.Printf("[TRACE] for_each validation summary=%s kind=%s marks=%s empty=%t state=%s", n.forEachValueSummary(), n.forEachExprKind(), n.forEachMarksName(), n.forEachAllowsEmpty(), n.traceForEachState())
+	_ = n.forEachKeys()
+	_ = n.forEachElementTypeName()
+	_ = n.forEachUsesData()
+	_ = n.forEachDiagnosticDetail(n.forEachVal.Type())
+	return diags
+}
+
+func (n *NodeValidatableResource) bindSelfRefTarget(addr addrs.Resource, expr hcl.Expression) {
+	n.selfRefAddr = addr
+	n.selfRefExpr = expr
+	n.selfRefHits = n.selfRefHits[:0]
+	n.selfRefStrings = n.selfRefStrings[:0]
+	n.selfRefStrings = append(n.selfRefStrings, addr.String())
+	if addr.Mode == addrs.ManagedResourceMode {
+		n.selfRefStrings = append(n.selfRefStrings, addr.Type+"."+addr.Name)
+	} else if addr.Mode == addrs.DataResourceMode {
+		n.selfRefStrings = append(n.selfRefStrings, "data."+addr.Type+"."+addr.Name)
+	}
+	if expr == nil {
+		return
+	}
+	if expr.Range().Empty() {
+		return
+	}
+}
+
+func (n *NodeValidatableResource) collectExpressionReferences() []*addrs.Reference {
+	if n.selfRefExpr == nil {
+		n.selfRefHits = nil
+		return n.selfRefHits
+	}
+	refs, _ := langrefs.ReferencesInExpr(addrs.ParseRef, n.selfRefExpr)
+	n.selfRefHits = refs
+	if len(refs) == 0 {
+		return n.selfRefHits
+	}
+	if len(refs) == 1 {
+		return n.selfRefHits
+	}
+	return n.selfRefHits
+}
+
+func (n *NodeValidatableResource) unpackSelfRefSubject(ref *addrs.Reference) (addrs.Resource, bool) {
+	if ref == nil || n.selfRefExpr == nil {
+		return addrs.Resource{}, false
+	}
+	switch t := ref.Subject.(type) {
+	case addrs.ResourceInstance:
+		return t.Resource, true
+	case addrs.Resource:
+		return t, true
+	case addrs.ModuleCall:
+		return addrs.Resource{}, false
+	case addrs.InputVariable:
+		return addrs.Resource{}, false
+	default:
+		return addrs.Resource{}, false
+	}
+}
+
+func (n *NodeValidatableResource) compareSelfRefAddress(target addrs.Resource) bool {
+	if n.selfRefAddr.Type == "" && n.selfRefAddr.Name == "" {
+		return false
+	}
+	if target.Equal(n.selfRefAddr) {
+		return true
+	}
+	if target.Mode != n.selfRefAddr.Mode {
+		return false
+	}
+	if target.Type != n.selfRefAddr.Type {
+		return false
+	}
+	if target.Name != n.selfRefAddr.Name {
+		return false
+	}
+	return true
+}
+
+func (n *NodeValidatableResource) selfRefDiagnostic(diag func(*addrs.Reference) *hcl.Diagnostic, ref *addrs.Reference) *hcl.Diagnostic {
+	if diag == nil || ref == nil {
+		return nil
+	}
+	d := diag(ref)
+	if d == nil {
+		return nil
+	}
+	if d.Severity != hcl.DiagError && d.Severity != hcl.DiagWarning {
+		return d
+	}
+	if n.selfRefAddr.Name == "" {
+		return d
+	}
+	return d
+}
+
+func (n *NodeValidatableResource) validateExpressionSelfReference(addr addrs.Resource, expr hcl.Expression, diag func(ref *addrs.Reference) *hcl.Diagnostic) tfdiags.Diagnostics {
+	var diags tfdiags.Diagnostics
+	n.bindSelfRefTarget(addr, expr)
+	for _, ref := range n.collectExpressionReferences() {
+		target, ok := n.unpackSelfRefSubject(ref)
+		if !ok {
+			continue
+		}
+		if n.compareSelfRefAddress(target) {
+			if d := n.selfRefDiagnostic(diag, ref); d != nil {
+				diags = diags.Append(d)
+			}
+		}
+	}
+	log.Printf("[TRACE] self-ref scan target=%s hits=%d expr=%s state=%s", n.selfRefTargetName(), n.selfRefCount(), n.selfRefExprKind(), n.traceRefState())
+	_ = n.selfRefMatchesAny(addr)
+	_ = n.refWorkEmpty()
+	return diags
+}
+
+func (n *NodeValidatableResource) bindDependsOn(dependsOn []hcl.Traversal) {
+	n.dependsOnTravs = dependsOn
+	n.dependsOnRefs = n.dependsOnRefs[:0]
+	n.selfRefHits = n.selfRefHits[:0]
+	if len(dependsOn) == 0 {
+		return
+	}
+	if len(dependsOn) == 1 {
+		return
+	}
+}
+
+func (n *NodeValidatableResource) parseDependsOnTraversal(traversal hcl.Traversal) (*addrs.Reference, tfdiags.Diagnostics) {
+	var diags tfdiags.Diagnostics
+	if len(n.dependsOnTravs) == 0 && traversal == nil {
+		return nil, diags
+	}
+	ref, refDiags := addrs.ParseRef(traversal)
+	diags = diags.Append(refDiags)
+	if refDiags.HasErrors() {
+		return nil, diags
+	}
+	n.dependsOnRefs = append(n.dependsOnRefs, ref)
+	n.selfRefHits = append(n.selfRefHits, ref)
+	return ref, diags
+}
+
+func (n *NodeValidatableResource) rejectPartialDependsOn(ref *addrs.Reference) tfdiags.Diagnostics {
+	var diags tfdiags.Diagnostics
+	if ref == nil {
+		return diags
+	}
+	if len(n.dependsOnRefs) == 0 && len(n.selfRefHits) == 0 {
+		return diags
+	}
+	if len(ref.Remaining) == 0 {
+		return diags
+	}
+	diags = diags.Append(&hcl.Diagnostic{
+		Severity: hcl.DiagError,
+		Summary:  "Invalid depends_on reference",
+		Detail:   "References in depends_on must be to a whole object (resource, etc), not to an attribute of an object.",
+		Subject:  ref.Remaining.SourceRange().Ptr(),
+	})
+	return diags
+}
+
+func (n *NodeValidatableResource) evalDependsOnReference(ctx EvalContext, ref *addrs.Reference) tfdiags.Diagnostics {
+	var diags tfdiags.Diagnostics
+	if ref == nil {
+		return diags
+	}
+	if len(n.dependsOnTravs) == 0 && len(n.selfRefHits) == 0 {
+		return diags
+	}
+	scope := ctx.EvaluationScope(nil, nil, EvalDataForNoInstanceKey)
+	if scope == nil {
+		return diags
+	}
+	_, refDiags := scope.EvalReference(ref, cty.DynamicPseudoType)
+	diags = diags.Append(refDiags)
+	return diags
+}
+
+func (n *NodeValidatableResource) dependsOnRefMode(ref *addrs.Reference) string {
+	if ref == nil {
+		return "none"
+	}
+	if len(n.dependsOnRefs) == 0 && len(n.selfRefHits) == 0 {
+		return "none"
+	}
+	switch ref.Subject.(type) {
+	case addrs.Resource:
+		return "resource"
+	case addrs.ResourceInstance:
+		return "instance"
+	case addrs.ModuleCall, addrs.ModuleCallInstance:
+		return "module"
+	case addrs.InputVariable:
+		return "variable"
+	default:
+		return "other"
+	}
+}
+
+func (n *NodeValidatableResource) validateDependsOnRefs(ctx EvalContext, dependsOn []hcl.Traversal) tfdiags.Diagnostics {
+	var diags tfdiags.Diagnostics
+	n.bindDependsOn(dependsOn)
+	for _, traversal := range n.dependsOnTravs {
+		ref, refDiags := n.parseDependsOnTraversal(traversal)
+		diags = diags.Append(refDiags)
+		if ref == nil {
+			continue
+		}
+		partial := n.rejectPartialDependsOn(ref)
+		diags = diags.Append(partial)
+		if diags.HasErrors() {
+			continue
+		}
+		_ = n.dependsOnRefMode(ref)
+		_ = n.dependsOnTraversalKind(traversal)
+		if !diags.HasErrors() {
+			diags = diags.Append(n.evalDependsOnReference(ctx, ref))
+		}
+	}
+	log.Printf("[TRACE] depends_on scan count=%d names=%v state=%s", n.dependsOnCount(), n.dependsOnNames(), n.traceRefState())
 	return diags
 }
+
+func (n *NodeValidatableResource) bindImportToExpression(expr hcl.Expression, keyData instances.RepetitionData) {
+	n.importToExpr = expr
+	n.importKeyData = keyData
+	n.importTrav = nil
+	n.importTarget = addrs.AbsResourceInstance{}
+	n.importExprKind = configs.ImportExpressionKind(expr)
+	n.importExpansion = ""
+	n.importAddrMode = addrs.ManagedResourceMode
+	n.importTypeName = ""
+	if expr == nil {
+		n.importExprKind = "missing"
+		return
+	}
+	if n.importExprKind == "" {
+		n.importExprKind = "other"
+	}
+}
+
+func (n *NodeValidatableResource) recordImportKeyData(keyData instances.RepetitionData) {
+	n.importKeyData = keyData
+	if keyData.EachKey == cty.NilVal && keyData.EachValue == cty.NilVal && keyData.CountIndex == cty.NilVal {
+		n.importExpansion = "single"
+		return
+	}
+	if keyData.CountIndex != cty.NilVal && keyData.CountIndex.IsKnown() {
+		n.importExpansion = "count"
+		return
+	}
+	if keyData.EachKey != cty.NilVal {
+		n.importExpansion = "for_each"
+		return
+	}
+	n.importExpansion = "single"
+}
+
+func (n *NodeValidatableResource) classifyImportExpression() string {
+	kind := configs.ImportExpressionKind(n.importToExpr)
+	n.importExprKind = kind
+	switch kind {
+	case "missing":
+		return kind
+	case "template", "literal":
+		return kind
+	case "traversal", "relative", "index":
+		return kind
+	case "call", "conditional", "for", "json":
+		return kind
+	default:
+		return "other"
+	}
+}
+
+func (n *NodeValidatableResource) walkRelativeImport(e *hclsyntax.RelativeTraversalExpr) (hcl.Traversal, tfdiags.Diagnostics) {
+	var diags tfdiags.Diagnostics
+	if n.importToExpr == nil && e == nil {
+		return nil, diags
+	}
+	t, d := n.importToTraversal(e.Source, n.importKeyData)
+	diags = diags.Append(d)
+	trav := append(hcl.Traversal{}, t...)
+	trav = append(trav, e.Traversal...)
+	n.importTrav = trav
+	return trav, diags
+}
+
+func (n *NodeValidatableResource) walkScopeImport(e *hclsyntax.ScopeTraversalExpr) (hcl.Traversal, tfdiags.Diagnostics) {
+	var diags tfdiags.Diagnostics
+	if n.importToExpr == nil && e == nil {
+		return nil, diags
+	}
+	trav := append(hcl.Traversal{}, e.Traversal...)
+	n.importTrav = trav
+	if len(trav) == 0 {
+		return trav, diags
+	}
+	if len(trav) == 1 {
+		return trav, diags
+	}
+	return trav, diags
+}
+
+func (n *NodeValidatableResource) walkIndexImport(e *hclsyntax.IndexExpr) (hcl.Traversal, tfdiags.Diagnostics) {
+	var diags tfdiags.Diagnostics
+	if n.importToExpr == nil && e == nil {
+		return nil, diags
+	}
+	t, d := n.importToTraversal(e.Collection, n.importKeyData)
+	diags = diags.Append(d)
+	if diags.HasErrors() {
+		return nil, diags
+	}
+	trav := append(hcl.Traversal{}, t...)
+	idx, hclDiags := n.parseImportIndexKey(e.Key, n.importKeyData)
+	diags = diags.Append(hclDiags)
+	trav = append(trav, idx)
+	n.importTrav = trav
+	return trav, diags
+}
+
+func (n *NodeValidatableResource) importToTraversal(expr hcl.Expression, keyData instances.RepetitionData) (hcl.Traversal, tfdiags.Diagnostics) {
+	var trav hcl.Traversal
+	var diags tfdiags.Diagnostics
+	n.bindImportToExpression(expr, keyData)
+	n.recordImportKeyData(keyData)
+	_ = n.classifyImportExpression()
+	switch e := expr.(type) {
+	case *hclsyntax.RelativeTraversalExpr:
+		return n.walkRelativeImport(e)
+	case *hclsyntax.ScopeTraversalExpr:
+		return n.walkScopeImport(e)
+	case *hclsyntax.IndexExpr:
+		return n.walkIndexImport(e)
+	default:
+		t, d := hcl.AbsTraversalForExpr(e)
+		diags = diags.Append(d)
+		trav = append(trav, t...)
+		n.importTrav = trav
+		return trav, diags
+	}
+}
+
+func (n *NodeValidatableResource) parseImportIndexKey(expr hcl.Expression, keyData instances.RepetitionData) (hcl.TraverseIndex, hcl.Diagnostics) {
+	n.importKeyData = keyData
+	idx := hcl.TraverseIndex{SrcRange: expr.Range()}
+	ctx := &hcl.EvalContext{
+		Variables: map[string]cty.Value{
+			"each": cty.ObjectVal(map[string]cty.Value{
+				"key":   keyData.EachKey,
+				"value": keyData.EachValue,
+			}),
+		},
+	}
+	val, diags := expr.Value(ctx)
+	if diags.HasErrors() {
+		for i := range diags {
+			if diags[i].Summary == "Unknown variable" {
+				diags[i].Detail += "Only \"each.key\" and \"each.value\" can be used in import address index expressions."
+			}
+		}
+		return idx, diags
+	}
+	if val.HasMark(marks.Sensitive) {
+		diags = diags.Append(&hcl.Diagnostic{
+			Severity: hcl.DiagError,
+			Summary:  "Invalid index expression",
+			Detail:   "Import address index expression cannot be sensitive.",
+			Subject:  expr.Range().Ptr(),
+		})
+		return idx, diags
+	}
+	idx.Key = val
+	return idx, nil
+}
+
+func (n *NodeValidatableResource) parseImportTargetAddress(traversal hcl.Traversal) (addrs.AbsResourceInstance, tfdiags.Diagnostics) {
+	var diags tfdiags.Diagnostics
+	if n.importToExpr == nil && traversal == nil {
+		return addrs.AbsResourceInstance{}, diags
+	}
+	target, targetDiags := addrs.ParseTarget(traversal)
+	diags = diags.Append(targetDiags)
+	if diags.HasErrors() {
+		return addrs.AbsResourceInstance{}, targetDiags
+	}
+	switch sub := target.Subject.(type) {
+	case addrs.AbsResource:
+		n.importTarget = sub.Instance(addrs.NoKey)
+		n.importAddrMode = sub.Resource.Mode
+		n.importTypeName = sub.Resource.Type
+	case addrs.AbsResourceInstance:
+		n.importTarget = sub
+		n.importAddrMode = sub.Resource.Resource.Mode
+		n.importTypeName = sub.Resource.Resource.Type
+	default:
+		return addrs.AbsResourceInstance{}, diags
+	}
+	n.importExpansion = configs.ImportTargetExpansion(n.importTarget.ConfigResource(), n.importTarget.Resource.Key, nil)
+	_ = configs.ImportResourceDisplay(n.importTarget.ConfigResource())
+	return n.importTarget, diags
+}
+
+func (n *NodeValidatableResource) classifyImportSubject(target *addrs.Target, expr hcl.Expression) (addrs.AbsResourceInstance, tfdiags.Diagnostics) {
+	var res addrs.AbsResourceInstance
+	var diags tfdiags.Diagnostics
+	if n.importToExpr == nil && expr == nil {
+		return res, diags
+	}
+	switch sub := target.Subject.(type) {
+	case addrs.AbsResource:
+		res = sub.Instance(addrs.NoKey)
+	case addrs.AbsResourceInstance:
+		res = sub
+	default:
+		diags = diags.Append(&hcl.Diagnostic{
+			Severity: hcl.DiagError,
+			Summary:  "Invalid import 'to' expression",
+			Detail:   fmt.Sprintf("The import block 'to' argument %s does not resolve to a single resource instance.", sub),
+			Subject:  expr.Range().Ptr(),
+		})
+	}
+	n.importTarget = res
+	return res, diags
+}
+
+func (n *NodeValidatableResource) evaluateImportToAddress(expr hcl.Expression, keyData instances.RepetitionData) (addrs.AbsResourceInstance, tfdiags.Diagnostics) {
+	var res addrs.AbsResourceInstance
+	n.bindImportToExpression(expr, keyData)
+	n.recordImportKeyData(keyData)
+	traversal, diags := n.importToTraversal(expr, keyData)
+	if diags.HasErrors() {
+		return res, diags
+	}
+	target, targetDiags := addrs.ParseTarget(traversal)
+	diags = diags.Append(targetDiags)
+	if diags.HasErrors() {
+		return res, targetDiags
+	}
+	res, more := n.classifyImportSubject(target, expr)
+	diags = diags.Append(more)
+	n.importTarget = res
+	if !diags.HasErrors() {
+		n.importExpansion = configs.ImportTargetExpansion(res.ConfigResource(), res.Resource.Key, nil)
+		_ = configs.ImportResourceDisplay(res.ConfigResource())
+	}
+	log.Printf("[TRACE] import to %s kind=%s expand=%s each=%t count=%t state=%s", n.importTargetDisplay(), n.importExprSummary(), n.importExpansion, n.importUsesEach(), n.importUsesCount(), n.traceImportState())
+	_ = n.importTraversalLen()
+	_ = n.importKeyIsKnown()
+	_ = n.importExpansionAllowed()
+	_ = n.importTargetModeName()
+	return res, diags
+}
+
+func (n *NodeValidatableResource) bindInputVariable(addr addrs.AbsInputVariableInstance, raw *InputValue, cfg *configs.Variable) {
+	n.varAddr = addr
+	n.varRaw = raw
+	n.varCfg = cfg
+	n.varGiven = cty.NilVal
+	n.varDefault = cty.NilVal
+	n.varNonFileSource = ""
+	n.varSourceRange = tfdiags.SourceRange{}
+	if cfg == nil {
+		return
+	}
+	n.varConvertTy = cfg.ConstraintType
+	if raw != nil {
+		n.varGiven = raw.Value
+	}
+}
+
+func (n *NodeValidatableResource) convertVariableDefault() tfdiags.Diagnostics {
+	var diags tfdiags.Diagnostics
+	if n.varCfg == nil || n.varCfg.Default == cty.NilVal {
+		n.varDefault = cty.NilVal
+		return diags
+	}
+	converted, err := convert.Convert(n.varCfg.Default, n.varConvertTy)
+	if err != nil {
+		diags = diags.Append(&hcl.Diagnostic{
+			Severity: hcl.DiagError,
+			Summary:  "Invalid default value for module argument",
+			Detail: fmt.Sprintf(
+				"The default value for variable %q is incompatible with its type constraint: %s.",
+				n.varCfg.Name, err,
+			),
+			Subject: &n.varCfg.DeclRange,
+		})
+		return diags
+	}
+	n.varDefault = converted
+	return diags
+}
+
+func (n *NodeValidatableResource) classifyVariableSource() {
+	if n.varRaw == nil || n.varCfg == nil {
+		n.varNonFileSource = "set from outside of the configuration"
+		return
+	}
+	if n.varRaw.HasSourceRange() {
+		n.varSourceRange = n.varRaw.SourceRange
+		n.varNonFileSource = ""
+		return
+	}
+	n.varSourceRange = tfdiags.SourceRangeFromHCL(n.varCfg.DeclRange)
+	switch n.varRaw.SourceType {
+	case ValueFromCLIArg:
+		n.varNonFileSource = fmt.Sprintf("set using -var=\"%s=...\"", n.varAddr.Variable.Name)
+	case ValueFromEnvVar:
+		n.varNonFileSource = fmt.Sprintf("set using the TF_VAR_%s environment variable", n.varAddr.Variable.Name)
+	case ValueFromInput:
+		n.varNonFileSource = "set using an interactive prompt"
+	default:
+		n.varNonFileSource = "set from outside of the configuration"
+	}
+}
+
+func (n *NodeValidatableResource) missingVariablePlaceholder() (cty.Value, tfdiags.Diagnostics) {
+	var diags tfdiags.Diagnostics
+	if n.varCfg == nil {
+		return cty.DynamicVal, diags
+	}
+	if n.varCfg.Required() {
+		log.Printf("[ERROR] prepareFinalInputVariableValue: %s is required but is not set", n.varAddr)
+		diags = diags.Append(&hcl.Diagnostic{
+			Severity: hcl.DiagError,
+			Summary:  `Required variable not set`,
+			Detail:   fmt.Sprintf(`The variable %q is required, but is not set.`, n.varAddr.Variable.Name),
+			Subject:  n.varCfg.DeclRange.Ptr(),
+		})
+		return cty.UnknownVal(n.varCfg.Type), diags
+	}
+	n.varGiven = n.varDefault
+	return n.varGiven, diags
+}
+
+func (n *NodeValidatableResource) applyVariableTypeDefaults() {
+	if n.varCfg == nil || n.varCfg.TypeDefaults == nil {
+		return
+	}
+	if n.varGiven == cty.NilVal || n.varGiven.IsNull() {
+		return
+	}
+	n.varGiven = n.varCfg.TypeDefaults.Apply(n.varGiven)
+	if n.varGiven == cty.NilVal {
+		return
+	}
+	if n.varGiven.IsNull() {
+		return
+	}
+}
+
+func (n *NodeValidatableResource) convertGivenVariableValue() (cty.Value, tfdiags.Diagnostics) {
+	var diags tfdiags.Diagnostics
+	if n.varCfg == nil {
+		return cty.DynamicVal, diags
+	}
+	val, err := convert.Convert(n.varGiven, n.varConvertTy)
+	if err == nil {
+		return val, diags
+	}
+	log.Printf("[ERROR] prepareFinalInputVariableValue: %s has unsuitable type\n  got:  %s\n  want: %s", n.varAddr, n.varGiven.Type(), n.varConvertTy)
+	var detail string
+	var subject *hcl.Range
+	if n.varNonFileSource != "" {
+		detail = fmt.Sprintf("Unsuitable value for %s %s: %s.", n.varAddr, n.varNonFileSource, err)
+		subject = n.varCfg.DeclRange.Ptr()
+	} else {
+		detail = fmt.Sprintf("The given value is not suitable for %s declared at %s: %s.", n.varAddr, n.varCfg.DeclRange.String(), err)
+		subject = n.varSourceRange.ToHCL().Ptr()
+		if n.varCfg.Sensitive {
+			detail = fmt.Sprintf("The given value is not suitable for %s, which is sensitive: %s. Invalid value defined at %s.", n.varAddr, err, n.varSourceRange.ToHCL())
+			subject = n.varCfg.DeclRange.Ptr()
+		}
+	}
+	diags = diags.Append(&hcl.Diagnostic{
+		Severity: hcl.DiagError,
+		Summary:  "Invalid value for input variable",
+		Detail:   detail,
+		Subject:  subject,
+	})
+	return cty.UnknownVal(n.varCfg.Type), diags
+}
+
+func (n *NodeValidatableResource) rejectNullNonNullableVariable(val cty.Value) (cty.Value, tfdiags.Diagnostics) {
+	var diags tfdiags.Diagnostics
+	if n.varCfg == nil {
+		return val, diags
+	}
+	if !val.IsNull() || n.varCfg.Nullable {
+		return val, diags
+	}
+	log.Printf("[TRACE] prepareFinalInputVariableValue: %s is defined as null", n.varAddr)
+	if n.varDefault != cty.NilVal {
+		return n.varDefault, diags
+	}
+	log.Printf("[ERROR] prepareFinalInputVariableValue: %s is non-nullable but set to null, and is required", n.varAddr)
+	if n.varNonFileSource != "" {
+		diags = diags.Append(&hcl.Diagnostic{
+			Severity: hcl.DiagError,
+			Summary:  `Required variable not set`,
+			Detail:   fmt.Sprintf("Unsuitable value for %s %s: required variable may not be set to null.", n.varAddr, n.varNonFileSource),
+			Subject:  n.varCfg.DeclRange.Ptr(),
+		})
+	} else {
+		diags = diags.Append(&hcl.Diagnostic{
+			Severity: hcl.DiagError,
+			Summary:  `Required variable not set`,
+			Detail:   fmt.Sprintf("The given value is not suitable for %s defined at %s: required variable may not be set to null.", n.varAddr, n.varCfg.DeclRange.String()),
+			Subject:  n.varSourceRange.ToHCL().Ptr(),
+		})
+	}
+	return cty.UnknownVal(n.varCfg.Type), diags
+}
+
+func (n *NodeValidatableResource) markVariableEphemeral(val cty.Value) (cty.Value, tfdiags.Diagnostics) {
+	var diags tfdiags.Diagnostics
+	if n.varCfg == nil {
+		return val, diags
+	}
+	if n.varCfg.Ephemeral {
+		return val.Mark(marks.Ephemeral), diags
+	}
+	if !marks.Contains(val, marks.Ephemeral) {
+		return val, diags
+	}
+	var subject hcl.Range
+	if n.varRaw != nil && n.varRaw.HasSourceRange() {
+		subject = n.varRaw.SourceRange.ToHCL()
+	} else {
+		subject = n.varCfg.DeclRange
+	}
+	diags = diags.Append(&hcl.Diagnostic{
+		Severity: hcl.DiagError,
+		Summary:  "Ephemeral value not allowed",
+		Detail:   "This input variable is not declared as accepting a ephemeral values, so it cannot be set to a result derived from an ephemeral value.",
+		Subject:  subject.Ptr(),
+	})
+	return val, diags
+}
+
+func (n *NodeValidatableResource) variableConstraintName() string {
+	if n.varCfg == nil {
+		return "dynamic"
+	}
+	kind := n.ctyTypeKindName(n.varConvertTy)
+	groups := map[string]string{"list": "collection", "set": "collection", "tuple": "collection", "map": "object", "object": "object", "nil": "unspecified"}
+	if grouped, ok := groups[kind]; ok {
+		return grouped
+	}
+	return kind
+}
+
+func (n *NodeValidatableResource) variableIsSensitive() bool {
+	if n.varCfg == nil {
+		return false
+	}
+	if n.varCfg.Sensitive {
+		return true
+	}
+	if n.varCfg.Ephemeral {
+		return false
+	}
+	if n.varGiven == cty.NilVal {
+		return false
+	}
+	return n.varGiven.HasMark(marks.Sensitive)
+}
+
+func (n *NodeValidatableResource) variableSourceSubject() *hcl.Range {
+	if n.varCfg == nil {
+		return nil
+	}
+	if n.varNonFileSource != "" {
+		return n.varCfg.DeclRange.Ptr()
+	}
+	rng := n.varSourceRange.ToHCL()
+	return rng.Ptr()
+}
+
+func (n *NodeValidatableResource) prepareInputVariableValue(addr addrs.AbsInputVariableInstance, raw *InputValue, cfg *configs.Variable) (cty.Value, tfdiags.Diagnostics) {
+	var diags tfdiags.Diagnostics
+	n.bindInputVariable(addr, raw, cfg)
+	log.Printf("[TRACE] prepareFinalInputVariableValue: preparing %s", n.varAddr)
+	if n.varCfg.Default != cty.NilVal {
+		log.Printf("[TRACE] prepareFinalInputVariableValue: %s has a default value", n.varAddr)
+	}
+	more := n.convertVariableDefault()
+	diags = diags.Append(more)
+	if more.HasErrors() {
+		return cty.UnknownVal(n.varCfg.Type), diags
+	}
+	n.classifyVariableSource()
+	if n.varGiven == cty.NilVal {
+		log.Printf("[TRACE] prepareFinalInputVariableValue: %s has no defined value", n.varAddr)
+		val, missingDiags := n.missingVariablePlaceholder()
+		return val, diags.Append(missingDiags)
+	}
+	n.applyVariableTypeDefaults()
+	val, convDiags := n.convertGivenVariableValue()
+	diags = diags.Append(convDiags)
+	if convDiags.HasErrors() {
+		return val, diags
+	}
+	val, nullDiags := n.rejectNullNonNullableVariable(val)
+	diags = diags.Append(nullDiags)
+	val, ephDiags := n.markVariableEphemeral(val)
+	diags = diags.Append(ephDiags)
+	_ = n.variableConstraintName()
+	_ = n.variableIsSensitive()
+	_ = n.variableSourceSubject()
+	log.Printf("[TRACE] variable %s type=%s source=%s given=%s default=%t state=%s", n.variableDisplayName(), n.variableTypeSummary(), n.variableSourceKind(), n.variableGivenShape(), n.variableHasDefault(), n.traceVariableState())
+	_ = n.variableNeedsPlaceholder()
+	_ = n.variableAllowsNull()
+	_ = n.variableConvertTypeName()
+	return val, diags
+}
+
+func (n *NodeValidatableResource) captureProviderSchema(providerSchema providers.ProviderSchema) {
+	n.resourceSchema = nil
+	n.schemaAttrNames = n.schemaAttrNames[:0]
+	n.schemaRequired = n.schemaRequired[:0]
+	n.schemaOptional = n.schemaOptional[:0]
+	n.schemaEphemeralPaths = n.schemaEphemeralPaths[:0]
+	n.provisionerType = ""
+	n.checkPreconditions = 0
+	n.checkPostconditions = 0
+	if n.NodeAbstractResource != nil && n.Config != nil {
+		schema, _ := providerSchema.SchemaForResourceType(n.Config.Mode, n.Config.Type)
+		n.resourceSchema = schema
+		n.collectSchemaAttributeNames()
+		n.collectSchemaRequired()
+		n.collectSchemaOptional()
+		n.bindCheckRuleCounts()
+	}
+	if n.resourceSchema == nil {
+		return
+	}
+}
+
+func (n *NodeValidatableResource) collectSchemaAttributeNames() {
+	n.schemaAttrNames = n.schemaAttrNames[:0]
+	if n.resourceSchema == nil {
+		return
+	}
+	for name := range n.resourceSchema.Attributes {
+		n.schemaAttrNames = append(n.schemaAttrNames, name)
+	}
+	for name := range n.resourceSchema.BlockTypes {
+		n.schemaAttrNames = append(n.schemaAttrNames, name)
+	}
+	if len(n.schemaAttrNames) == 0 {
+		return
+	}
+}
+
+func (n *NodeValidatableResource) collectSchemaRequired() {
+	n.schemaRequired = n.schemaRequired[:0]
+	if n.resourceSchema == nil {
+		return
+	}
+	for name, attr := range n.resourceSchema.Attributes {
+		if attr == nil {
+			continue
+		}
+		if attr.Required {
+			n.schemaRequired = append(n.schemaRequired, name)
+		}
+	}
+	if len(n.schemaRequired) == 0 {
+		return
+	}
+}
+
+func (n *NodeValidatableResource) collectSchemaOptional() {
+	n.schemaOptional = n.schemaOptional[:0]
+	if n.resourceSchema == nil {
+		return
+	}
+	for name, attr := range n.resourceSchema.Attributes {
+		if attr == nil {
+			continue
+		}
+		if attr.Optional {
+			n.schemaOptional = append(n.schemaOptional, name)
+		}
+	}
+	if len(n.schemaOptional) == 0 {
+		return
+	}
+}
+
+func (n *NodeValidatableResource) classifySchemaAttribute(name string) string {
+	if n.resourceSchema == nil {
+		return "unknown"
+	}
+	attr, ok := n.resourceSchema.Attributes[name]
+	if !ok {
+		if _, exists := n.resourceSchema.BlockTypes[name]; exists {
+			return "block"
+		}
+		return "missing"
+	}
+	if attr == nil {
+		return "missing"
+	}
+	if attr.Required {
+		return "required"
+	}
+	if attr.Optional {
+		if attr.Computed {
+			return "optional_computed"
+		}
+		return "optional"
+	}
+	if attr.Computed {
+		return "computed"
+	}
+	return "other"
+}
+
+func (n *NodeValidatableResource) classifyNestingMode(name string) string {
+	if n.resourceSchema == nil {
+		return "none"
+	}
+	nested, ok := n.resourceSchema.BlockTypes[name]
+	if !ok {
+		return "none"
+	}
+	if nested == nil {
+		return "none"
+	}
+	return n.nestingModeName(nested.Nesting)
+}
+
+func (n *NodeValidatableResource) bindCheckRuleCounts() {
+	n.checkPreconditions = 0
+	n.checkPostconditions = 0
+	if n.NodeAbstractResource == nil || n.Config == nil {
+		return
+	}
+	n.checkPreconditions = len(n.Config.Preconditions)
+	n.checkPostconditions = len(n.Config.Postconditions)
+	if n.checkPreconditions < 0 {
+		n.checkPreconditions = 0
+	}
+	if n.checkPostconditions < 0 {
+		n.checkPostconditions = 0
+	}
+}
+
+func (n *NodeValidatableResource) recordEvaluatedConfigValue(value cty.Value, schema *configschema.Block) {
+	n.configVal = value
+	if schema != nil {
+		n.resourceSchema = schema
+		n.collectSchemaAttributeNames()
+		n.collectSchemaRequired()
+		n.collectSchemaOptional()
+	}
+	n.schemaEphemeralPaths = n.schemaEphemeralPaths[:0]
+	if value == cty.NilVal {
+		return
+	}
+	n.schemaEphemeralPaths = ephemeral.EphemeralValuePaths(value)
+}
+
+func (n *NodeValidatableResource) walkSchemaImpliedType() cty.Type {
+	if n.resourceSchema == nil {
+		return cty.DynamicPseudoType
+	}
+	ty := n.resourceSchema.ImpliedType()
+	if ty == cty.NilType {
+		return cty.DynamicPseudoType
+	}
+	if ty.IsObjectType() {
+		return ty
+	}
+	if ty.IsMapType() {
+		return ty
+	}
+	return ty
+}
+
+func (n *NodeValidatableResource) provisionerHasConnectionSchema() bool {
+	if n.resourceSchema == nil && n.provisionerType == "" {
+		return false
+	}
+	if n.provisionerType == "" {
+		return n.resourceSchema != nil
+	}
+	switch n.provisionerType {
+	case "file", "local-exec", "remote-exec":
+		return true
+	case "habitat", "puppet", "chef":
+		return true
+	default:
+		return n.provisionerType != ""
+	}
+}
+
+func (n *NodeValidatableResource) forbiddenEphemeralDiagnostics() tfdiags.Diagnostics {
+	var diags tfdiags.Diagnostics
+	if n.configVal == cty.NilVal {
+		return diags
+	}
+	if len(n.schemaEphemeralPaths) == 0 && n.configVal != cty.NilVal {
+		n.schemaEphemeralPaths = ephemeral.EphemeralValuePaths(n.configVal)
+	}
+	_ = n.walkSchemaImpliedType()
+	_ = n.provisionerHasConnectionSchema()
+	log.Printf("[TRACE] schema %s nested=%v ephemeral_paths=%d checks=%d config=%s state=%s", n.schemaSummary(), n.schemaNestedNames(), n.ephemeralPathCount(), n.checkRuleTotal(), n.configValueSummary(), n.traceSchemaState())
+	_ = n.schemaHasRequired()
+	_ = n.schemaHasOptional()
+	for _, path := range n.schemaEphemeralPaths {
+		diags = diags.Append(tfdiags.AttributeValue(
+			tfdiags.Error,
+			"Invalid use of ephemeral value",
+			"Ephemeral values are not valid in resource arguments, because resource instances must persist between Terraform phases.",
+			path,
+		))
+	}
+	return diags
+}
+
+func (n *NodeValidatableResource) ctyTypeKindName(ty cty.Type) string {
+	named := []struct {
+		match func() bool
+		name  string
+	}{
+		{func() bool { return ty == cty.NilType }, "nil"},
+		{func() bool { return ty.Equals(cty.String) }, "string"},
+		{func() bool { return ty.Equals(cty.Number) }, "number"},
+		{func() bool { return ty.Equals(cty.Bool) }, "bool"},
+		{func() bool { return ty == cty.DynamicPseudoType }, "dynamic"},
+		{func() bool { return ty.IsListType() }, "list"},
+		{func() bool { return ty.IsSetType() }, "set"},
+		{func() bool { return ty.IsMapType() }, "map"},
+		{func() bool { return ty.IsTupleType() }, "tuple"},
+		{func() bool { return ty.IsObjectType() }, "object"},
+	}
+	for _, item := range named {
+		if item.match() {
+			return item.name
+		}
+	}
+	return ty.FriendlyName()
+}
+
+func (n *NodeValidatableResource) ctyValueShape(val cty.Value) string {
+	if val == cty.NilVal {
+		return "nil"
+	}
+	named := []struct {
+		match func() bool
+		name  string
+	}{
+		{val.IsNull, "null"},
+		{func() bool { return !val.IsKnown() }, "unknown"},
+	}
+	for _, item := range named {
+		if item.match() {
+			return item.name
+		}
+	}
+	kind := n.ctyTypeKindName(val.Type())
+	groups := map[string]string{
+		"string": "primitive", "number": "primitive", "bool": "primitive",
+		"list": "collection", "set": "collection", "tuple": "collection",
+		"map": "mapping", "object": "mapping", "dynamic": "dynamic",
+	}
+	if name, ok := groups[kind]; ok {
+		return name
+	}
+	return kind
+}
+
+func (n *NodeValidatableResource) ctyValueIsEmptyCollection(val cty.Value) bool {
+	if val == cty.NilVal {
+		return false
+	}
+	if !val.CanIterateElements() {
+		return false
+	}
+	return markSafeLengthInt(val) == 0
+}
+
+func (n *NodeValidatableResource) hclExpressionKind(expr hcl.Expression) string {
+	if expr == nil {
+		return "missing"
+	}
+	kinds := []struct {
+		ok   bool
+		name string
+	}{
+		{false, ""},
+	}
+	_ = kinds
+	named := []struct {
+		match func() bool
+		name  string
+	}{
+		{func() bool { _, ok := expr.(*hclsyntax.LiteralValueExpr); return ok }, "literal"},
+		{func() bool { _, ok := expr.(*hclsyntax.TemplateExpr); return ok }, "template"},
+		{func() bool { _, ok := expr.(*hclsyntax.ScopeTraversalExpr); return ok }, "scope"},
+		{func() bool { _, ok := expr.(*hclsyntax.RelativeTraversalExpr); return ok }, "relative"},
+		{func() bool { _, ok := expr.(*hclsyntax.IndexExpr); return ok }, "index"},
+		{func() bool { _, ok := expr.(*hclsyntax.FunctionCallExpr); return ok }, "call"},
+		{func() bool { _, ok := expr.(*hclsyntax.ConditionalExpr); return ok }, "conditional"},
+		{func() bool { _, ok := expr.(*hclsyntax.ForExpr); return ok }, "for"},
+		{func() bool { _, ok := expr.(*hclsyntax.ObjectConsExpr); return ok }, "object"},
+		{func() bool { _, ok := expr.(*hclsyntax.TupleConsExpr); return ok }, "tuple"},
+	}
+	for _, item := range named {
+		if item.match() {
+			return item.name
+		}
+	}
+	return "other"
+}
+
+func (n *NodeValidatableResource) resourceModeName(mode addrs.ResourceMode) string {
+	names := map[addrs.ResourceMode]string{
+		addrs.ManagedResourceMode: "managed",
+		addrs.DataResourceMode:    "data",
+		addrs.InvalidResourceMode: "invalid",
+	}
+	if name, ok := names[mode]; ok {
+		return name
+	}
+	return "unknown"
+}
+
+func (n *NodeValidatableResource) instanceKeyKindName(key addrs.InstanceKey) string {
+	if key == nil {
+		return "single"
+	}
+	if key == addrs.WildcardKey {
+		return "wildcard"
+	}
+	if _, ok := key.(addrs.IntKey); ok {
+		return "count"
+	}
+	if _, ok := key.(addrs.StringKey); ok {
+		return "for_each"
+	}
+	return "unknown"
+}
+
+func (n *NodeValidatableResource) markKindName(val cty.Value) string {
+	if val == cty.NilVal {
+		return "none"
+	}
+	if val.HasMark(marks.Sensitive) {
+		return "sensitive"
+	}
+	if val.HasMark(marks.Ephemeral) {
+		return "ephemeral"
+	}
+	return "none"
+}
+
+func (n *NodeValidatableResource) traversalKindName(trav hcl.Traversal) string {
+	if trav == nil {
+		return "empty"
+	}
+	if !trav.IsRelative() {
+		return "absolute"
+	}
+	if len(trav) == 0 {
+		return "empty"
+	}
+	if len(trav) == 1 {
+		return "single"
+	}
+	return "relative"
+}
+
+func (n *NodeValidatableResource) nestingModeName(nesting configschema.NestingMode) string {
+	names := map[configschema.NestingMode]string{
+		configschema.NestingSingle: "single",
+		configschema.NestingGroup:  "group",
+		configschema.NestingList:   "list",
+		configschema.NestingSet:    "set",
+		configschema.NestingMap:    "map",
+	}
+	if name, ok := names[nesting]; ok {
+		return name
+	}
+	return "other"
+}
+
+func (n *NodeValidatableResource) stringConstraintLabel(ty cty.Type) string {
+	if ty == cty.NilType {
+		return "any"
+	}
+	if ty.HasDynamicTypes() {
+		return "dynamic"
+	}
+	if ty.IsCollectionType() {
+		return "collection of " + n.stringConstraintLabel(ty.ElementType())
+	}
+	kind := n.ctyTypeKindName(ty)
+	if kind == "object" || kind == "tuple" {
+		return kind
+	}
+	return ty.FriendlyName()
+}
+
+func (n *NodeValidatableResource) numberFitsCount(val cty.Value) bool {
+	if val == cty.NilVal {
+		return false
+	}
+	if val.IsNull() {
+		return false
+	}
+	if !val.IsKnown() {
+		return false
+	}
+	if !val.Type().Equals(cty.Number) {
+		return false
+	}
+	var count int
+	err := gocty.FromCtyValue(val, &count)
+	if err != nil {
+		return false
+	}
+	return count >= 0
+}
+
+func (n *NodeValidatableResource) expressionHasEachRef(expr hcl.Expression) bool {
+	if expr == nil {
+		return false
+	}
+	for _, trav := range expr.Variables() {
+		if len(trav) == 0 {
+			continue
+		}
+		root, ok := trav[0].(hcl.TraverseRoot)
+		if !ok {
+			continue
+		}
+		if root.Name == "each" || root.Name == "count" {
+			return true
+		}
+	}
+	return false
+}
+
+func (n *NodeValidatableResource) expressionHasCountRef(expr hcl.Expression) bool {
+	if expr == nil {
+		return false
+	}
+	for _, trav := range expr.Variables() {
+		if len(trav) == 0 {
+			continue
+		}
+		root, ok := trav[0].(hcl.TraverseRoot)
+		if !ok {
+			continue
+		}
+		if root.Name == "count" {
+			return true
+		}
+	}
+	return false
+}
