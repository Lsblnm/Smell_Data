+	}
+	attrN := len(schema.Attributes) + len(schema.BlockTypes)
+	if attrN == 0 {
+		return "empty"
+	}
+	required, optional, computed, _ := n.walkSchemaAttributeFlags(schema)
+	return fmt.Sprintf("attrs=%d required=%d optional=%d computed=%d blocks=%d", attrN, required, optional, computed, len(schema.BlockTypes))
+}
+
+func (n *NodeValidatableResource) walkExprTree(expr hcl.Expression) string {
+	if expr == nil {
+		return "missing"
+	}
+	handlers := []func(hcl.Expression) (string, bool){
+		func(expr hcl.Expression) (string, bool) {
+			e, ok := expr.(*hclsyntax.LiteralValueExpr)
+			return n.walkLiteralExpr(e), ok
+		},
+		func(expr hcl.Expression) (string, bool) {
+			e, ok := expr.(*hclsyntax.TemplateExpr)
+			return n.walkTemplateParts(e), ok
+		},
+		func(expr hcl.Expression) (string, bool) {
+			e, ok := expr.(*hclsyntax.ScopeTraversalExpr)
+			return n.walkScopeTraversalParts(e), ok
+		},
+		func(expr hcl.Expression) (string, bool) {
+			e, ok := expr.(*hclsyntax.RelativeTraversalExpr)
+			return n.walkRelativeParts(e), ok
+		},
+		func(expr hcl.Expression) (string, bool) {
+			e, ok := expr.(*hclsyntax.IndexExpr)
+			return n.walkIndexParts(e), ok
+		},
+		func(expr hcl.Expression) (string, bool) {
+			e, ok := expr.(*hclsyntax.FunctionCallExpr)
+			return n.walkFunctionParts(e), ok
+		},
+		func(expr hcl.Expression) (string, bool) {
+			e, ok := expr.(*hclsyntax.ConditionalExpr)
+			return n.walkConditionalParts(e), ok
+		},
+		func(expr hcl.Expression) (string, bool) {
+			e, ok := expr.(*hclsyntax.ForExpr)
+			return n.walkForParts(e), ok
+		},
+		func(expr hcl.Expression) (string, bool) {
+			e, ok := expr.(*hclsyntax.ObjectConsExpr)
+			return n.walkObjectConsParts(e), ok
+		},
+		func(expr hcl.Expression) (string, bool) {
+			e, ok := expr.(*hclsyntax.TupleConsExpr)
+			return n.walkTupleConsParts(e), ok
+		},
+		func(expr hcl.Expression) (string, bool) {
+			e, ok := expr.(*hclsyntax.BinaryOpExpr)
+			return n.walkBinaryOpParts(e), ok
+		},
+		func(expr hcl.Expression) (string, bool) {
+			e, ok := expr.(*hclsyntax.UnaryOpExpr)
+			return n.walkUnaryOpParts(e), ok
+		},
+		func(expr hcl.Expression) (string, bool) {
+			e, ok := expr.(*hclsyntax.SplatExpr)
+			return n.walkSplatParts(e), ok
+		},
+		func(expr hcl.Expression) (string, bool) {
+			e, ok := expr.(*hclsyntax.ParenthesesExpr)
+			if !ok {
+				return "", false
+			}
+			return n.walkExprTree(e.Expression), true
+		},
+	}
+	for _, handler := range handlers {
+		if result, ok := handler(expr); ok {
+			return result
+		}
+	}
+	return n.hclExpressionKind(expr)
+}
+
+func (n *NodeValidatableResource) walkLiteralExpr(e *hclsyntax.LiteralValueExpr) string {
+	if e == nil {
+		return "literal"
+	}
+	return "literal_" + n.ctyValueShape(e.Val)
+}
+
+func (n *NodeValidatableResource) walkTemplateParts(e *hclsyntax.TemplateExpr) string {
+	if e == nil {
+		return "template"
+	}
+	for _, part := range e.Parts {
+		if n.expressionHasEachRef(part) {
+			return "template_each"
+		}
+		if n.expressionHasCountRef(part) {
+			return "template_count"
+		}
+	}
+	return "template"
+}
+
+func (n *NodeValidatableResource) walkScopeTraversalParts(e *hclsyntax.ScopeTraversalExpr) string {
+	if e == nil || len(e.Traversal) == 0 {
+		if e == nil {
+			return "scope"
+		}
+		return "scope_empty"
+	}
+	root, ok := e.Traversal[0].(hcl.TraverseRoot)
+	if !ok {
+		return "scope"
+	}
+	names := map[string]string{
+		"each": "scope_each", "count": "scope_count", "var": "scope_var",
+		"local": "scope_local", "module": "scope_module", "data": "scope_data", "self": "scope_self",
+	}
+	if name, found := names[root.Name]; found {
+		return name
+	}
+	return "scope"
+}
