+func (n *NodeValidatableResource) walkNestedSchemaBlocks(schema *configschema.Block, prefix string) []string {
+	if schema == nil {
+		return nil
+	}
+	var names []string
+	for name, nested := range schema.BlockTypes {
+		label := prefix + name
+		if nested == nil {
+			names = append(names, label)
+			continue
+		}
+		mode := n.nestingModeName(nested.Nesting)
+		names = append(names, label+":"+mode)
+		childPrefix := label + "."
+		names = append(names, n.walkNestedSchemaBlocks(&nested.Block, childPrefix)...)
+	}
+	return names
+}
+
+func (n *NodeValidatableResource) walkSchemaAttributeFlags(schema *configschema.Block) (required, optional, computed, sensitive int) {
+	if schema == nil {
+		return
+	}
+	for _, attr := range schema.Attributes {
+		if attr == nil {
+			continue
+		}
+		required += boolToInt(attr.Required)
+		optional += boolToInt(attr.Optional)
+		computed += boolToInt(attr.Computed)
+		sensitive += boolToInt(attr.Sensitive)
+	}
+	for _, nested := range schema.BlockTypes {
+		if nested == nil {
+			continue
+		}
+		r, o, c, s := n.walkSchemaAttributeFlags(&nested.Block)
+		required += r
+		optional += o
+		computed += c
+		sensitive += s
+	}
+	return
+}
