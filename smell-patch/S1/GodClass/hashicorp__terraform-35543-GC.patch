+func (n *NodeValidatableResource) countAsInt64() (int64, bool) {
+	if !n.countKnown {
+		return 0, false
+	}
+	if n.countNull {
+		return 0, false
+	}
+	if !n.countVal.Type().Equals(cty.Number) {
+		return 0, false
+	}
+	bf := n.countVal.AsBigFloat()
+	if bf == nil {
+		return int64(n.countInt), n.countInt >= 0
+	}
+	i, _ := bf.Int64()
+	return i, i >= 0
+}
