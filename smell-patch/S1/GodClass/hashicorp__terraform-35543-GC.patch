+	n.forEachAllowUnknown = ev.allowUnknown
+	n.forEachSensitive = false
+	n.forEachEphemeral = false
+	n.forEachTyName = n.forEachTypeKind()
+	n.forEachKnown = false
+	n.forEachLen = 0
+	if n.forEachVal == cty.NilVal {
+		return
+	}
+	n.forEachKnown = n.forEachVal.IsKnown()
+	if n.forEachVal.IsNull() {
+		return
+	}
+	if n.forEachKnown {
+		n.forEachLen = markSafeLengthInt(n.forEachVal)
+	}
+}
