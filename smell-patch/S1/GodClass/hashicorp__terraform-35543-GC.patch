+func (n *NodeValidatableResource) countDiagnosticDetail(err error) string {
+	if n.countExpr == nil {
+		return `The given "count" argument value is null. An integer is required.`
+	}
+	if n.countEphemeral {
+		return `The given "count" is derived from an ephemeral value, which means that Terraform cannot persist it between plan/apply rounds. Use only non-ephemeral values to specify the number of resource instances.`
+	}
+	if n.countNull {
+		return `The given "count" argument value is null. An integer is required.`
+	}
+	if n.countInt < 0 {
+		return `The given "count" argument value is unsuitable: must be greater than or equal to zero.`
+	}
+	if err != nil {
+		return fmt.Sprintf(`The given "count" argument value is unsuitable: %s.`, err)
+	}
+	return n.describeCountConstraint()
+}
