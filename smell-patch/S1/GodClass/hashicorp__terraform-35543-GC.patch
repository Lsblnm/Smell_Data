+		"primitive":  n.ctyTypeKindName(val.Type()),
+		"collection": "collection:" + n.ctyTypeKindName(val.Type()),
+		"mapping":    "mapping:" + n.ctyTypeKindName(val.Type()),
+		"dynamic":    "dynamic",
+		"string":     "string",
+		"number":     "number",
+		"bool":       "bool",
+		"list":       "collection:list",
+		"set":        "collection:set",
+		"map":        "mapping:map",
+		"object":     "mapping:object",
+		"tuple":      "collection:tuple",
