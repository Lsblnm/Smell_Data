diff --git a/internal/addrs/resource.go b/internal/addrs/resource.go
index 57f4858734..87c4f0d50a 100644
--- a/internal/addrs/resource.go
+++ b/internal/addrs/resource.go
@@ -625,3 +625,60 @@ func (k DeposedKey) GoString() string {
 		return fmt.Sprintf("states.DeposedKey(%q)", ks)
 	}
 }
+
+// ClassifyResourceInstanceKey reports how a resource instance is expanded.
+func ClassifyResourceInstanceKey(key InstanceKey) string {
+	switch key.(type) {
+	case IntKey:
+		return "count"
+	case StringKey:
+		return "for_each"
+	case *wildcardKey:
+		return "wildcard"
+	default:
+		if key == nil {
+			return "single"
+		}
+		return "unknown"
+	}
+}
+
+// DescribeConfigResource returns a display string for a configuration resource
+// address, distinguishing managed resources, data sources, and module nesting.
+func DescribeConfigResource(addr ConfigResource) string {
+	switch {
+	case addr.Resource.Mode == DataResourceMode && len(addr.Module) == 0:
+		return addr.Resource.String()
+	case addr.Resource.Mode == DataResourceMode:
+		return addr.String()
+	case addr.Resource.Mode == ManagedResourceMode && len(addr.Module) == 0:
+		return addr.Resource.String()
+	case addr.Resource.Mode == ManagedResourceMode:
+		return addr.String()
+	default:
+		if len(addr.Module) == 0 {
+			return addr.Resource.String()
+		}
+		return addr.String()
+	}
+}
+
+// ResourceExpansionMode classifies whether a resource address refers to a
+// single instance, a count-expanded instance, or a for_each-expanded instance.
+func ResourceExpansionMode(addr ConfigResource, key InstanceKey, hasForEach bool) string {
+	kind := ClassifyResourceInstanceKey(key)
+	switch {
+	case hasForEach && kind == "for_each":
+		return "for_each"
+	case hasForEach && kind == "single":
+		return "for_each_unexpanded"
+	case kind == "count":
+		return "count"
+	case kind == "wildcard":
+		return "deferred"
+	case len(addr.Module) > 0 && kind == "single":
+		return "module_single"
+	default:
+		return "single"
+	}
+}
