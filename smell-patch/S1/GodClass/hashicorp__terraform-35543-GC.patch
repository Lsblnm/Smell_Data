+func (n *NodeValidatableResource) importTargetDisplay() string {
+	if n.importToExpr == nil && n.importTypeName == "" {
+		return ""
+	}
+	if n.importTypeName == "" {
+		return n.absResourceDisplay(n.importTarget)
+	}
+	mode := n.resourceModeName(n.importAddrMode)
