@@ -222,3 +222,64 @@ func parseImportToStatic(expr hcl.Expression) (addrs.AbsResourceInstance, bool)
 	toDiags = toDiags.Append(td)
 	return to, !toDiags.HasErrors()
 }
+
+// ImportExpressionKind classifies an import block expression so callers can
+// choose the correct evaluation path without first evaluating it.
+func ImportExpressionKind(expr hcl.Expression) string {
+	if expr == nil {
+		return "missing"
+	}
+	switch expr.(type) {
+	case *hclsyntax.TemplateExpr:
+		return "template"
+	case *hclsyntax.LiteralValueExpr:
+		return "literal"
+	case *hclsyntax.ScopeTraversalExpr:
+		return "traversal"
+	case *hclsyntax.RelativeTraversalExpr:
+		return "relative"
+	case *hclsyntax.IndexExpr:
+		return "index"
+	case *hclsyntax.FunctionCallExpr:
+		return "call"
+	case *hclsyntax.ConditionalExpr:
+		return "conditional"
+	case *hclsyntax.ForExpr:
+		return "for"
+	default:
+		if hcljson.IsJSONExpression(expr) {
+			return "json"
+		}
+		return "other"
+	}
+}
+
+// ImportTargetExpansion classifies how an import target should be expanded
+// based on its static address and optional for_each expression.
+func ImportTargetExpansion(to addrs.ConfigResource, key addrs.InstanceKey, forEach hcl.Expression) string {
+	hasForEach := forEach != nil
+	mode := addrs.ResourceExpansionMode(to, key, hasForEach)
+	switch {
+	case hasForEach && mode == "for_each":
+		return "for_each"
+	case hasForEach:
+		return "for_each"
+	case mode == "count":
+		return "count"
+	case mode == "deferred":
+		return "deferred"
+	case mode == "module_single":
+		return "module_single"
+	default:
+		return "single"
+	}
+}
+
+// ImportResourceDisplay returns a user-facing description of the import target.
+func ImportResourceDisplay(addr addrs.ConfigResource) string {
+	desc := addrs.DescribeConfigResource(addr)
+	if desc == "" {
+		return addr.String()
+	}
+	return desc
+}
