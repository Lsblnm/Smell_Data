+func (n *NodeValidatableResource) repetitionHasEach(data instances.RepetitionData) bool {
+	if data.EachKey == cty.NilVal && data.EachValue == cty.NilVal {
+		return false
+	}
+	if data.EachKey != cty.NilVal && data.EachKey.IsKnown() {
+		return true
+	}
+	if data.EachValue != cty.NilVal {
