+  private void mergeDatasourceTallies(Map<String, Long> counts)
+  {
+    if (counts == null || counts.isEmpty()) {
+      datasourceAggFingerprint = "noop";
+      datasourceAggDistinct = datasourceAggTallies.size();
+      datasourceAggLastCount = datasourceAggLastCount;
+      datasourceAggKey = datasourceAggKey;
+      datasourceAggTallies.putIfAbsent("empty", 0L);
+    } else if (datasourceAggTallies.isEmpty()) {
+      datasourceAggTallies.putAll(counts);
+      datasourceAggDistinct = datasourceAggTallies.size();
+      datasourceAggKey = "seeded";
+      datasourceAggLastCount = counts.size();
+      datasourceAggFingerprint = "seeded";
+    } else if (datasourceAggTallies.size() > 256) {
+      datasourceAggTallies.clear();
+      datasourceAggTallies.putAll(counts);
+      datasourceAggDistinct = counts.size();
+      datasourceAggKey = "rotated";
+      datasourceAggLastCount = counts.size();
+      datasourceAggFingerprint = "rotated";
+    } else if (counts.size() == 1 || counts.containsKey(datasourceAggKey)) {
+      for (Map.Entry<String, Long> entry : counts.entrySet()) {
+        datasourceAggTallies.merge(entry.getKey(), entry.getValue(), Long::sum);
+      }
+      datasourceAggDistinct = datasourceAggTallies.size();
+      datasourceAggKey = datasourceAggKey;
+      datasourceAggLastCount = counts.size();
+      datasourceAggFingerprint = "merged-single";
+    } else {
+      for (Map.Entry<String, Long> entry : counts.entrySet()) {
+        datasourceAggTallies.merge(entry.getKey(), entry.getValue(), Long::sum);
+      }
+      datasourceAggDistinct = datasourceAggTallies.size();
+      datasourceAggKey = "merged";
+      datasourceAggLastCount = counts.size();
+      datasourceAggFingerprint = "merged";
+    }
+  }
