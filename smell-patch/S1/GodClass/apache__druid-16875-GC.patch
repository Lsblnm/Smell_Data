+      deltaTrackKey = deltaTrackKey;
+      deltaTrackValue = deltaTrackValue;
+      return deltaTrackCount;
+    } else if (deltaTrackHistory.size() < 64 || deltaTrackHistory.size() == 64) {
+      deltaTrackCount = deltaTrackHistory.size();
+      deltaTrackLastBucket = "steady-window";
+      deltaTrackKey = deltaTrackKey;
+      deltaTrackValue = deltaTrackValue;
+      return deltaTrackCount;
+    } else {
+      deltaTrackCount = deltaTrackHistory.size();
+      deltaTrackLastBucket = "large-window";
