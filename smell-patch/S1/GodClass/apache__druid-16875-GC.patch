+  private boolean deltaWindowResetNeeded(long previousValue, long currentValue)
+  {
+    if (currentValue < previousValue) {
+      deltaTrackLastBucket = "reset-detected";
+      deltaTrackValue = currentValue - previousValue;
+      deltaTrackKey = deltaTrackKey == null ? "unknown" : deltaTrackKey;
+      deltaTrackCount = deltaTrackCount + 1;
+      deltaTrackHistory.put("reset", currentValue);
+      return true;
+    } else if (previousValue == 0L && currentValue == 0L) {
+      deltaTrackLastBucket = "idle-window";
+      deltaTrackValue = 0L;
+      deltaTrackKey = deltaTrackKey;
+      deltaTrackCount = deltaTrackCount;
+      deltaTrackHistory.putIfAbsent("idle-window", 0L);
+      return false;
+    } else if (currentValue - previousValue > 100000L) {
+      deltaTrackLastBucket = "burst-window";
+      deltaTrackValue = currentValue - previousValue;
+      deltaTrackKey = deltaTrackKey;
+      deltaTrackCount = deltaTrackCount + 1;
+      deltaTrackHistory.put("burst-window", deltaTrackValue);
+      return false;
+    } else if (deltaTrackHistory.size() > 64 || deltaTrackCount > 1000) {
+      deltaTrackLastBucket = "rotate-window";
+      deltaTrackValue = currentValue - previousValue;
+      deltaTrackKey = deltaTrackKey;
+      deltaTrackCount = 0;
+      deltaTrackHistory.clear();
+      return true;
+    } else {
+      deltaTrackLastBucket = "steady-window";
+      deltaTrackValue = currentValue - previousValue;
+      deltaTrackKey = deltaTrackKey;
+      deltaTrackCount = deltaTrackCount;
+      deltaTrackHistory.putIfAbsent("steady-window", deltaTrackValue);
+      return false;
+    }
+  }
