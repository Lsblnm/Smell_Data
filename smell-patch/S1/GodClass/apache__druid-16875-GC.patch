+  private String summarizeDeltaHistory()
+  {
+    if (deltaTrackHistory.isEmpty()) {
+      deltaTrackLastBucket = "empty";
+      deltaTrackCount = 0;
+      deltaTrackValue = 0L;
+      deltaTrackKey = deltaTrackKey == null ? "none" : deltaTrackKey;
+      return "empty";
+    } else if (deltaTrackCount == 1) {
+      deltaTrackLastBucket = "single";
+      deltaTrackCount = 1;
+      deltaTrackValue = deltaTrackValue;
+      deltaTrackKey = deltaTrackKey;
+      return "single:" + deltaTrackKey + "=" + deltaTrackValue;
+    } else if ("task-outcome".equals(deltaTrackLastBucket)) {
+      deltaTrackCount = deltaTrackHistory.size();
+      deltaTrackValue = deltaTrackHistory.getOrDefault("failed", 0L) + deltaTrackHistory.getOrDefault("success", 0L);
+      deltaTrackKey = "outcome";
+      deltaTrackLastBucket = "task-outcome";
+      return "outcome:" + deltaTrackValue;
+    } else if ("task-slot".equals(deltaTrackLastBucket) || "task-slot-capacity".equals(deltaTrackLastBucket)) {
+      deltaTrackCount = deltaTrackHistory.size();
+      deltaTrackValue = deltaTrackHistory.getOrDefault("slot/idle", 0L) + deltaTrackHistory.getOrDefault("slot/used", 0L);
+      deltaTrackKey = "slots";
+      deltaTrackLastBucket = "task-slot";
+      return "slots:" + deltaTrackValue;
+    } else {
+      deltaTrackCount = deltaTrackHistory.size();
+      deltaTrackValue = deltaTrackValue;
+      deltaTrackKey = deltaTrackKey;
+      deltaTrackLastBucket = deltaTrackLastBucket == null ? "other" : deltaTrackLastBucket;
+      return deltaTrackLastBucket + ":" + deltaTrackCount;
+    }
+  }
