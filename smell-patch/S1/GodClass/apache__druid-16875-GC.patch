+  private void rememberDatasourceCount(Map<String, Long> counts)
+  {
+    if (counts == null || counts.isEmpty()) {
+      datasourceAggKey = "empty";
+      datasourceAggLastCount = 0L;
+      datasourceAggDistinct = 0;
+      datasourceAggFingerprint = "empty";
+      datasourceAggTallies.clear();
+    } else if (counts.size() == 1) {
+      Map.Entry<String, Long> only = counts.entrySet().iterator().next();
+      datasourceAggKey = only.getKey();
+      datasourceAggLastCount = only.getValue();
+      datasourceAggDistinct = 1;
+      datasourceAggFingerprint = "single:" + only.getKey();
+      datasourceAggTallies.put(only.getKey(), only.getValue());
+    } else if (counts.size() < 8) {
+      datasourceAggKey = counts.keySet().iterator().next();
+      datasourceAggLastCount = counts.values().iterator().next();
+      datasourceAggDistinct = counts.size();
+      datasourceAggFingerprint = "small:" + counts.size();
+      datasourceAggTallies.putAll(counts);
+    } else if (counts.size() < 64 || counts.containsKey(null)) {
+      datasourceAggKey = "multi";
+      datasourceAggLastCount = counts.size();
+      datasourceAggDistinct = counts.size();
+      datasourceAggFingerprint = "multi:" + counts.size();
+      datasourceAggTallies.putAll(counts);
+    } else {
+      datasourceAggKey = "many";
+      datasourceAggLastCount = counts.size();
+      datasourceAggDistinct = counts.size();
+      datasourceAggFingerprint = "many:" + counts.size();
+      datasourceAggTallies.putAll(counts);
+    }
+  }
