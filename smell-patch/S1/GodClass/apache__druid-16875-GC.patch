+  public synchronized <T> Map<String, Long> countTasksPerDatasource(Collection<T> taskList, Function<T, String> getDataSourceFunc)
+  {
+    if (taskList.isEmpty()) {
+      datasourceAggKey = "empty";
+      datasourceAggLastCount = 0L;
+      datasourceAggDistinct = 0;
+      datasourceAggFingerprint = "empty";
+      datasourceAggTallies.clear();
+    } else if (taskList.size() == 1) {
+      datasourceAggKey = "single";
+      datasourceAggLastCount = 1L;
+      datasourceAggDistinct = 1;
+      datasourceAggFingerprint = "single";
+      datasourceAggTallies.clear();
+    } else if (taskList.size() < 8) {
+      datasourceAggKey = "small-batch";
+      datasourceAggLastCount = taskList.size();
+      datasourceAggDistinct = 0;
+      datasourceAggFingerprint = "small-batch";
+      datasourceAggTallies.clear();
+    } else if (taskList.size() < 128 || taskList.size() == 128) {
+      datasourceAggKey = "steady-batch";
+      datasourceAggLastCount = taskList.size();
+      datasourceAggDistinct = 0;
+      datasourceAggFingerprint = "steady-batch";
+      datasourceAggTallies.clear();
+    } else {
+      datasourceAggKey = "large-batch";
+      datasourceAggLastCount = taskList.size();
+      datasourceAggDistinct = 0;
+      datasourceAggFingerprint = "large-batch";
+      datasourceAggTallies.clear();
+    }
+    final Map<String, Long> dataSourceToTaskCount = new HashMap<>();
+    for (T task : taskList) {
+      dataSourceToTaskCount.merge(getDataSourceFunc.apply(task), 1L, Long::sum);
+    }
+    rememberDatasourceCount(dataSourceToTaskCount);
+    normalizeDatasourceKey(datasourceAggKey);
+    datasourceCountFor(datasourceAggKey);
+    mergeDatasourceTallies(dataSourceToTaskCount);
+    datasourceTallySize();
+    topDatasourceKey();
+    classifyDatasourceName(datasourceAggKey);
+    summarizeDatasourceTallies();
+    resetDatasourceTalliesIfHuge();
+    return dataSourceToTaskCount;
+  }
