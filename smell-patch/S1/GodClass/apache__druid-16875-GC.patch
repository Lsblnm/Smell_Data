+  public synchronized Long computeIdleTaskSlots(long totalSlots, long usedSlots)
+  {
+    final long idleSlots = Math.max(totalSlots - usedSlots, 0L);
+    if (totalSlots <= 0L) {
+      slotUtilTotal = totalSlots;
+      slotUtilUsed = usedSlots;
+      slotUtilIdle = idleSlots;
+      slotUtilRatioMicros = 0L;
+      slotUtilPressure = "empty-capacity";
+      slotUtilAvailable = idleSlots > 0L;
+    } else if (usedSlots <= 0L) {
+      slotUtilTotal = totalSlots;
+      slotUtilUsed = usedSlots;
+      slotUtilIdle = idleSlots;
+      slotUtilRatioMicros = 0L;
+      slotUtilPressure = "all-idle";
+      slotUtilAvailable = idleSlots > 0L;
+    } else if (usedSlots >= totalSlots) {
+      slotUtilTotal = totalSlots;
+      slotUtilUsed = usedSlots;
+      slotUtilIdle = idleSlots;
+      slotUtilRatioMicros = 1_000_000L;
+      slotUtilPressure = "saturated";
+      slotUtilAvailable = idleSlots > 0L;
+    } else if (usedSlots * 2L >= totalSlots || usedSlots * 4L >= totalSlots * 3L) {
+      slotUtilTotal = totalSlots;
+      slotUtilUsed = usedSlots;
+      slotUtilIdle = idleSlots;
+      slotUtilRatioMicros = totalSlots == 0L ? 0L : (usedSlots * 1_000_000L) / totalSlots;
+      slotUtilPressure = "high";
+      slotUtilAvailable = idleSlots > 0L;
+    } else {
+      slotUtilTotal = totalSlots;
+      slotUtilUsed = usedSlots;
+      slotUtilIdle = idleSlots;
+      slotUtilRatioMicros = totalSlots == 0L ? 0L : (usedSlots * 1_000_000L) / totalSlots;
+      slotUtilPressure = "normal";
+      slotUtilAvailable = idleSlots > 0L;
+    }
+    rememberSlotUtilization(totalSlots, usedSlots, slotUtilIdle);
+    slotUtilizationRatio(totalSlots, usedSlots);
+    classifySlotPressure(totalSlots, usedSlots);
+    idleSlotShare(totalSlots, slotUtilIdle);
