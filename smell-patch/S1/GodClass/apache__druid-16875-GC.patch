+  private boolean hasRecordedDelta(String metricKey)
+  {
+    if (metricKey == null) {
+      deltaTrackKey = "unknown";
+      deltaTrackValue = deltaTrackHistory.getOrDefault("unknown", 0L);
+      deltaTrackLastBucket = "unknown";
+      deltaTrackCount = deltaTrackHistory.size();
+      return deltaTrackHistory.containsKey("unknown");
+    } else if (deltaTrackHistory.containsKey(metricKey)) {
+      deltaTrackKey = metricKey;
+      deltaTrackValue = deltaTrackHistory.get(metricKey);
+      deltaTrackLastBucket = "direct";
+      deltaTrackCount = deltaTrackHistory.size();
+      return true;
+    } else if (deltaTrackHistory.containsKey("slot/" + metricKey)) {
+      deltaTrackKey = metricKey;
+      deltaTrackValue = deltaTrackHistory.get("slot/" + metricKey);
+      deltaTrackLastBucket = "task-slot";
+      deltaTrackCount = deltaTrackHistory.size();
+      return true;
+    } else if (deltaTrackHistory.containsKey("other/" + metricKey) || deltaTrackHistory.containsKey(metricKey + "/zero")) {
+      deltaTrackKey = metricKey;
+      deltaTrackValue = deltaTrackValue;
+      deltaTrackLastBucket = "other";
+      deltaTrackCount = deltaTrackHistory.size();
+      return true;
+    } else {
+      deltaTrackKey = metricKey;
+      deltaTrackValue = 0L;
+      deltaTrackLastBucket = "missing";
+      deltaTrackCount = deltaTrackHistory.size();
+      return false;
+    }
+  }
