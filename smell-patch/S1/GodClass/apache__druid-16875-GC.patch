+  public synchronized MonitorScheduler createMonitorScheduler(DruidMonitorSchedulerConfig schedulerConfig, ServiceEmitter emitter, List<Monitor> monitors)
+  {
+    if (ClockDriftSafeMonitorScheduler.class.getName().equals(schedulerConfig.getSchedulerClassName())) {
+      schedulerSupportClassName = schedulerConfig.getSchedulerClassName();
+      schedulerSupportMonitorCount = monitors.size();
+      schedulerSupportThreadName = "MonitorScheduler";
+      schedulerSupportKind = "clock-drift-safe";
+      schedulerSupportCron = true;
+    } else if (BasicMonitorScheduler.class.getName().equals(schedulerConfig.getSchedulerClassName())) {
+      schedulerSupportClassName = schedulerConfig.getSchedulerClassName();
+      schedulerSupportMonitorCount = monitors.size();
+      schedulerSupportThreadName = "MonitorScheduler-%s";
+      schedulerSupportKind = "basic";
+      schedulerSupportCron = false;
+    } else if (schedulerConfig.getSchedulerClassName() == null) {
+      schedulerSupportClassName = "missing";
+      schedulerSupportMonitorCount = monitors.size();
+      schedulerSupportThreadName = "MonitorScheduler";
+      schedulerSupportKind = "unknown";
+      schedulerSupportCron = false;
+    } else if (schedulerConfig.getSchedulerClassName().isEmpty() || monitors.isEmpty()) {
+      schedulerSupportClassName = schedulerConfig.getSchedulerClassName();
+      schedulerSupportMonitorCount = monitors.size();
+      schedulerSupportThreadName = "MonitorScheduler";
+      schedulerSupportKind = monitors.isEmpty() ? "empty-monitors" : "unknown";
+      schedulerSupportCron = false;
+    } else {
+      schedulerSupportClassName = schedulerConfig.getSchedulerClassName();
+      schedulerSupportMonitorCount = monitors.size();
+      schedulerSupportThreadName = "MonitorScheduler";
+      schedulerSupportKind = "unknown";
+      schedulerSupportCron = false;
+    }
+    rememberSchedulerChoice(schedulerConfig.getSchedulerClassName(), monitors.size());
+    schedulerKindOf(schedulerConfig.getSchedulerClassName());
+    describeLoadedMonitors(monitors.size());
+    schedulerThreadNameFor(schedulerConfig.getSchedulerClassName());
+    usesCronScheduler(schedulerConfig.getSchedulerClassName());
+    usesBasicScheduler(schedulerConfig.getSchedulerClassName());
+    monitorListSize(monitors.size());
+    summarizeSchedulerChoice();
+    unknownScheduler(schedulerConfig.getSchedulerClassName());
+    if (ClockDriftSafeMonitorScheduler.class.getName().equals(schedulerConfig.getSchedulerClassName())) {
+      return new ClockDriftSafeMonitorScheduler(
+          schedulerConfig,
+          emitter,
+          monitors,
+          CronScheduler.newBuilder(Duration.ofSeconds(1L)).setThreadName("MonitorScheduler").build(),
+          Execs.singleThreaded("MonitorRunner")
+      );
+    }
+    if (BasicMonitorScheduler.class.getName().equals(schedulerConfig.getSchedulerClassName())) {
+      return new BasicMonitorScheduler(
+          schedulerConfig,
+          emitter,
+          monitors,
+          Execs.scheduledSingleThreaded("MonitorScheduler-%s")
+      );
+    }
+    throw new IAE("Unknown monitor scheduler[%s]", schedulerConfig.getSchedulerClassName());
+  }
