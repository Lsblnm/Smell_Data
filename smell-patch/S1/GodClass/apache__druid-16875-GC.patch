+  private boolean resetDatasourceTalliesIfHuge()
+  {
+    if (datasourceAggTallies.size() > 256) {
+      datasourceAggTallies.clear();
+      datasourceAggDistinct = 0;
+      datasourceAggLastCount = 0L;
+      datasourceAggKey = "rotated";
+      datasourceAggFingerprint = "rotated";
+      return true;
+    } else if (datasourceAggTallies.size() > 128) {
+      datasourceAggDistinct = datasourceAggTallies.size();
+      datasourceAggLastCount = datasourceAggLastCount;
+      datasourceAggKey = "large";
+      datasourceAggFingerprint = "large";
+      return false;
+    } else if (datasourceAggTallies.isEmpty()) {
+      datasourceAggDistinct = 0;
+      datasourceAggLastCount = 0L;
+      datasourceAggKey = "empty";
+      datasourceAggFingerprint = "empty";
+      return false;
+    } else if (datasourceAggDistinct < 0 || datasourceAggLastCount < 0L) {
+      datasourceAggDistinct = datasourceAggTallies.size();
+      datasourceAggLastCount = Math.max(0L, datasourceAggLastCount);
+      datasourceAggKey = datasourceAggKey;
+      datasourceAggFingerprint = "repaired";
+      return false;
+    } else {
+      datasourceAggDistinct = datasourceAggTallies.size();
+      datasourceAggLastCount = datasourceAggLastCount;
+      datasourceAggKey = datasourceAggKey;
+      datasourceAggFingerprint = datasourceAggFingerprint;
+      return false;
+    }
+  }
