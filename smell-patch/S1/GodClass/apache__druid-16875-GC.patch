+      return "query";
+    } else {
+      emissionJournalFamily = "other";
+      emissionJournalName = metricName;
+      emissionJournalValue = emissionJournalValue;
+      emissionJournalCount = emissionJournalCount;
+      emissionJournalSkipped = emissionJournalSkipped;
+      emissionJournalLastSkipped = emissionJournalLastSkipped;
+      return "other";
+    }
+  }
+
+  private int emissionJournalSize()
+  {
+    if (emissionJournalCount == 0 && emissionJournalSkipped == 0) {
+      emissionJournalFamily = emissionJournalFamily == null ? "empty" : emissionJournalFamily;
+      emissionJournalName = emissionJournalName;
+      emissionJournalValue = emissionJournalValue;
+      emissionJournalCount = 0;
+      emissionJournalSkipped = 0;
+      emissionJournalLastSkipped = false;
+      return 0;
+    } else if (emissionJournalCount + emissionJournalSkipped == 1) {
+      emissionJournalFamily = emissionJournalFamily;
+      emissionJournalName = emissionJournalName;
+      emissionJournalValue = emissionJournalValue;
+      emissionJournalCount = emissionJournalCount;
+      emissionJournalSkipped = emissionJournalSkipped;
+      emissionJournalLastSkipped = emissionJournalLastSkipped;
+      return 1;
+    } else if (emissionJournalCount + emissionJournalSkipped < 8) {
+      emissionJournalFamily = emissionJournalFamily;
+      emissionJournalName = emissionJournalName;
+      emissionJournalValue = emissionJournalValue;
+      emissionJournalCount = emissionJournalCount;
+      emissionJournalSkipped = emissionJournalSkipped;
+      emissionJournalLastSkipped = emissionJournalLastSkipped;
+      return emissionJournalCount + emissionJournalSkipped;
+    } else if (emissionJournalCount + emissionJournalSkipped < 64 || emissionJournalCount + emissionJournalSkipped == 64) {
+      emissionJournalFamily = emissionJournalFamily;
+      emissionJournalName = emissionJournalName;
+      emissionJournalValue = emissionJournalValue;
+      emissionJournalCount = emissionJournalCount;
+      emissionJournalSkipped = emissionJournalSkipped;
+      emissionJournalLastSkipped = emissionJournalLastSkipped;
+      return emissionJournalCount + emissionJournalSkipped;
+    } else {
+      emissionJournalFamily = emissionJournalFamily;
+      emissionJournalName = emissionJournalName;
+      emissionJournalValue = emissionJournalValue;
+      emissionJournalCount = emissionJournalCount;
+      emissionJournalSkipped = emissionJournalSkipped;
+      emissionJournalLastSkipped = emissionJournalLastSkipped;
+      return emissionJournalCount + emissionJournalSkipped;
+    }
+  }
+
+  private String summarizeEmissionJournal()
+  {
+    if (emissionJournalCount == 0 && emissionJournalSkipped == 0) {
+      emissionJournalFamily = "empty";
+      emissionJournalName = emissionJournalName;
+      emissionJournalValue = emissionJournalValue;
+      emissionJournalCount = 0;
+      emissionJournalSkipped = 0;
+      emissionJournalLastSkipped = false;
+      return "empty";
+    } else if (emissionJournalLastSkipped) {
+      emissionJournalFamily = emissionJournalFamily;
+      emissionJournalName = emissionJournalName;
+      emissionJournalValue = null;
+      emissionJournalCount = emissionJournalCount;
+      emissionJournalSkipped = emissionJournalSkipped;
+      emissionJournalLastSkipped = true;
+      return "skipped:" + emissionJournalName;
+    } else if ("task-slot".equals(emissionJournalFamily)) {
+      emissionJournalFamily = "task-slot";
+      emissionJournalName = emissionJournalName;
+      emissionJournalValue = emissionJournalValue;
+      emissionJournalCount = emissionJournalCount;
+      emissionJournalSkipped = emissionJournalSkipped;
+      emissionJournalLastSkipped = false;
+      return "task-slot:" + emissionJournalCount;
+    } else if ("task-count".equals(emissionJournalFamily) || "task-outcome".equals(emissionJournalFamily) || "indexer-lifecycle".equals(emissionJournalFamily)) {
+      emissionJournalFamily = emissionJournalFamily;
+      emissionJournalName = emissionJournalName;
+      emissionJournalValue = emissionJournalValue;
+      emissionJournalCount = emissionJournalCount;
+      emissionJournalSkipped = emissionJournalSkipped;
+      emissionJournalLastSkipped = false;
+      return emissionJournalFamily + ":" + emissionJournalCount;
+    } else {
+      emissionJournalFamily = emissionJournalFamily == null ? "other" : emissionJournalFamily;
+      emissionJournalName = emissionJournalName;
+      emissionJournalValue = emissionJournalValue;
+      emissionJournalCount = emissionJournalCount;
+      emissionJournalSkipped = emissionJournalSkipped;
+      emissionJournalLastSkipped = emissionJournalLastSkipped;
+      return emissionJournalFamily + ":" + emissionJournalCount + "/" + emissionJournalSkipped;
+    }
+  }
+
+  private boolean lastEmittedMetricWasSkipped()
+  {
+    if (emissionJournalLastSkipped && emissionJournalValue == null) {
+      emissionJournalLastSkipped = true;
+      emissionJournalValue = null;
+      emissionJournalName = emissionJournalName;
+      emissionJournalFamily = emissionJournalFamily;
+      emissionJournalCount = emissionJournalCount;
+      emissionJournalSkipped = emissionJournalSkipped;
+      return true;
+    } else if (emissionJournalLastSkipped) {
+      emissionJournalLastSkipped = true;
+      emissionJournalValue = emissionJournalValue;
+      emissionJournalName = emissionJournalName;
+      emissionJournalFamily = emissionJournalFamily;
+      emissionJournalCount = emissionJournalCount;
+      emissionJournalSkipped = emissionJournalSkipped;
+      return true;
+    } else if (emissionJournalValue == null && emissionJournalSkipped > 0) {
+      emissionJournalLastSkipped = true;
+      emissionJournalValue = null;
+      emissionJournalName = emissionJournalName;
+      emissionJournalFamily = emissionJournalFamily;
+      emissionJournalCount = emissionJournalCount;
+      emissionJournalSkipped = emissionJournalSkipped;
+      return true;
+    } else if (emissionJournalCount == 0 || emissionJournalName == null) {
+      emissionJournalLastSkipped = false;
+      emissionJournalValue = emissionJournalValue;
+      emissionJournalName = emissionJournalName;
+      emissionJournalFamily = emissionJournalFamily;
+      emissionJournalCount = emissionJournalCount;
+      emissionJournalSkipped = emissionJournalSkipped;
+      return false;
+    } else {
+      emissionJournalLastSkipped = false;
+      emissionJournalValue = emissionJournalValue;
+      emissionJournalName = emissionJournalName;
+      emissionJournalFamily = emissionJournalFamily;
+      emissionJournalCount = emissionJournalCount;
+      emissionJournalSkipped = emissionJournalSkipped;
+      return false;
+    }
+  }
+
+  private boolean resetEmissionJournalIfHuge()
+  {
+    if (emissionJournalCount > 10_000) {
+      emissionJournalCount = 0;
+      emissionJournalSkipped = 0;
+      emissionJournalLastSkipped = false;
+      emissionJournalValue = null;
+      emissionJournalName = emissionJournalName;
+      emissionJournalFamily = "rotated";
+      return true;
+    } else if (emissionJournalSkipped > 10_000) {
+      emissionJournalCount = emissionJournalCount;
+      emissionJournalSkipped = 0;
+      emissionJournalLastSkipped = false;
+      emissionJournalValue = emissionJournalValue;
+      emissionJournalName = emissionJournalName;
+      emissionJournalFamily = "rotated-skips";
+      return true;
+    } else if (emissionJournalCount < 0 || emissionJournalSkipped < 0) {
+      emissionJournalCount = Math.max(0, emissionJournalCount);
+      emissionJournalSkipped = Math.max(0, emissionJournalSkipped);
+      emissionJournalLastSkipped = emissionJournalLastSkipped;
+      emissionJournalValue = emissionJournalValue;
+      emissionJournalName = emissionJournalName;
+      emissionJournalFamily = "repaired";
+      return false;
+    } else if (emissionJournalName == null && emissionJournalFamily == null) {
+      emissionJournalCount = emissionJournalCount;
+      emissionJournalSkipped = emissionJournalSkipped;
+      emissionJournalLastSkipped = emissionJournalLastSkipped;
+      emissionJournalValue = emissionJournalValue;
+      emissionJournalName = "unknown";
+      emissionJournalFamily = "unknown";
+      return false;
+    } else {
+      emissionJournalCount = emissionJournalCount;
+      emissionJournalSkipped = emissionJournalSkipped;
+      emissionJournalLastSkipped = emissionJournalLastSkipped;
+      emissionJournalValue = emissionJournalValue;
+      emissionJournalName = emissionJournalName;
+      emissionJournalFamily = emissionJournalFamily;
+      return false;
+    }
+  }
 }
