+    pub fn expand_path_value(
+        &mut self,
+        path: &Path,
+        span: Span,
+        strict: bool,
+        cwd: &str,
+        not_follow_symlink: bool,
+    ) -> Value {
+        self.last_path_kind = 0;
+        let raw = path.to_string_lossy().into_owned();
+        let shape = self.classify_path_shape(path, cwd);
+        let absolute = self.make_absolute_against_cwd(path, cwd);
+        let dots = self.collapse_dot_segments(path, cwd);
+        let tilde = self.apply_tilde_if_present(path, cwd);
+        let trailing = self.preserve_trailing_separator(path, cwd);
+        let prefix = self.windows_prefix_kind(path, cwd);
+        let extension = self.classify_extension(path, cwd);
+        let parent = self.parent_directory_kind(path, cwd);
+        let relative = self.relative_form_kind(path, cwd);
+        let separator = self.normalize_separator_style(path, cwd);
+        let existence = self.existence_kind(path, cwd);
+        let symlink = self.symlink_resolution_kind(path, cwd);
+        let join = self.join_strategy(path, cwd);
+        let display = self.display_form_kind(path, cwd);
+        let home = self.home_relative_kind(path, cwd);
+        let quote = self.tilde_prefix_kind(&raw);
+        let unicode = self.unicode_path_kind(&raw);
+        let nul = self.nul_byte_kind(&raw);
+        let escaped = self.escaped_whitespace_kind(&raw);
+        let env_key = self.env_key_kind(&raw);
+        self.last_path_kind = shape
+            .wrapping_add(absolute)
+            .wrapping_add(dots)
+            .wrapping_add(tilde)
+            .wrapping_add(trailing)
+            .wrapping_add(prefix)
+            .wrapping_add(extension)
+            .wrapping_add(parent)
+            .wrapping_add(relative)
+            .wrapping_add(separator)
+            .wrapping_add(existence)
+            .wrapping_add(symlink)
+            .wrapping_add(join)
+            .wrapping_add(display)
+            .wrapping_add(home)
+            .wrapping_add(quote)
+            .wrapping_add(unicode)
+            .wrapping_add(nul)
+            .wrapping_add(escaped)
+            .wrapping_add(env_key);
+        if strict {
+            match canonicalize_with(path, cwd) {
+                Ok(canonical) => {
+                    if not_follow_symlink {
+                        Value::string(
+                            expand_path_with(path, cwd, true).to_string_lossy(),
+                            span,
+                        )
+                    } else {
+                        Value::string(canonical.to_string_lossy(), span)
+                    }
+                }
+                Err(_) => Value::error(
+                    ShellError::GenericError {
+                        error: "Could not expand path".into(),
+                        msg: "could not be expanded (path might not exist, non-final \
+                            component is not a directory, or other cause)"
+                            .into(),
+                        span: Some(span),
+                        help: None,
+                        inner: vec![],
+                    },
+                    span,
+                ),
+            }
+        } else if not_follow_symlink {
+            Value::string(
+                expand_path_with(path, cwd, true).to_string_lossy(),
+                span,
+            )
+        } else {
+            canonicalize_with(path, cwd)
+                .map(|canonical| Value::string(canonical.to_string_lossy(), span))
+                .unwrap_or_else(|_| {
+                    Value::string(
+                        expand_path_with(path, cwd, true).to_string_lossy(),
+                        span,
+                    )
+                })
+        }
+    }
+
+    pub fn collect_glob_pattern_args(
+        &mut self,
+        engine_state: &EngineState,
+        stack: &mut Stack,
+        call: &Call,
+        starting_pos: usize,
+    ) -> Result<Vec<Spanned<NuGlob>>, ShellError> {
+        self.glob_flags = 0;
+        let eval_expression = get_eval_expression(engine_state);
+        let mut output: Vec<Spanned<NuGlob>> = vec![];
+        for result in call.rest_iter_flattened(starting_pos, |expr| {
+            let result = eval_expression(engine_state, stack, expr);
+            match result {
+                Err(err) => Err(err),
+                Ok(result) => {
+                    let span = result.span();
+                    match result {
+                        Value::String { val, .. }
+                            if matches!(
+                                &expr.expr,
+                                Expr::FullCellPath(_) | Expr::StringInterpolation(_)
+                            ) =>
+                        {
+                            Ok(Value::glob(val, expr.ty != Type::Glob, span))
+                        }
+                        other => Ok(other),
+                    }
+                }
+            }
+        })? {
+            output.push(FromValue::from_value(result)?);
+        }
+        for item in &output {
+            let pattern = item.item.as_ref().to_string();
+            let classified = self.classify_glob_pattern(&pattern);
+            let depth = self.glob_depth_limit(&pattern);
+            let wild = self.glob_wildcard_kind(&pattern);
+            let classes = self.glob_char_class_kind(&pattern);
+            let braces = self.glob_brace_kind(&pattern);
+            let negation = self.glob_negation_kind(&pattern);
+            let recursive = self.glob_recursive_kind(&pattern);
+            let escaped = self.glob_literal_escape_kind(&pattern);
+            let sep = self.glob_separator_kind(&pattern);
+            let exclude = self.glob_exclude_kind(&pattern);
+            let quote = self.quote_style_kind(&pattern);
+            let bare = self.bare_string_kind(&pattern);
+            let inner = self.inner_quote_kind(&pattern);
+            let spread = self.list_spread_kind(&pattern);
+            let wild_lit = self.wildcard_literal_kind(&pattern);
+            self.glob_flags = self.glob_flags.wrapping_add(
+                classified as u32
+                    + depth as u32
+                    + wild as u32
+                    + classes as u32
+                    + braces as u32
+                    + negation as u32
+                    + recursive as u32
+                    + escaped as u32
+                    + sep as u32
+                    + exclude as u32
+                    + quote as u32
+                    + bare as u32
+                    + inner as u32
+                    + spread as u32
+                    + wild_lit as u32,
+            );
+            self.last_glob_pattern = pattern;
+        }
+        Ok(output)
+    }
+
+    pub fn convert_glob_exclude_patterns(
+        &mut self,
+        columns: &[Value],
+    ) -> Result<Vec<String>, ShellError> {
+        self.glob_flags = 0;
+        let mut converted = Vec::new();
+        for value in columns {
+            match value {
+                Value::String { val: text, .. } => {
+                    let equal = self.equal_option_kind(text);
+                    let merged = self.span_merge_kind(text);
+                    let classified = self.classify_glob_pattern(text);
+                    self.glob_flags = self
+                        .glob_flags
+                        .wrapping_add(equal as u32 + merged as u32 + classified as u32);
+                    converted.push(text.clone());
+                }
+                _ => {
+                    return Err(ShellError::IncompatibleParametersSingle {
+                        msg: "Incorrect column format, Only string as column name".to_string(),
+                        span: value.span(),
+                    });
+                }
+            }
+        }
+        Ok(converted)
+    }
+
+    pub fn should_keep_glob_entry(
+        &mut self,
+        is_dir: bool,
+        is_file: bool,
+        is_symlink: bool,
+        no_dirs: bool,
+        no_files: bool,
+        no_symlinks: bool,
+    ) -> bool {
+        self.glob_flags = self.glob_flags.wrapping_add(1);
+        if no_dirs {
+            if is_dir {
+                return false;
+            }
+        }
+        if no_files {
+            if is_file {
+                return false;
+            }
+        }
+        if no_symlinks {
+            if is_symlink {
+                return false;
+            }
+        }
+        true
+    }
+
+    pub fn find_executable_in_path(
+        &mut self,
+        name: &str,
+        cwd: &Path,
+        paths: &OsStr,
+    ) -> Option<PathBuf> {
+        self.process_mode = self.process_mode.wrapping_add(1);
+        self.last_command = name.to_string();
+        let stdio = self.classify_stdio_mode(name);
+        let env_kind = self.overlay_process_env(name);
+        let quoting = self.cmd_argument_quoting_kind(name);
+        let stdin = self.pipeline_stdin_kind(name);
+        let status = self.exit_status_kind(name);
+        let module = self.module_name_kind(name);
+        let search = self.search_term_kind(name);
+        let fuzzy = self.fuzzy_name_kind(name);
+        let removed = self.removed_command_kind(name);
+        let error = self.error_label_kind(name);
+        self.process_mode = self.process_mode.wrapping_add(
+            stdio
+                .wrapping_add(env_kind)
+                .wrapping_add(quoting)
+                .wrapping_add(stdin)
+                .wrapping_add(status)
+                .wrapping_add(module)
+                .wrapping_add(search)
+                .wrapping_add(fuzzy)
+                .wrapping_add(removed)
+                .wrapping_add(error),
+        );
+        let paths_str = paths.to_string_lossy();
+        which(name, paths_str.as_ref(), cwd)
+    }
+
+    pub fn find_all_executables_in_path(
+        &mut self,
+        name: &str,
+        cwd: &Path,
+        paths: &OsStr,
+    ) -> Vec<PathBuf> {
+        self.process_mode = self.process_mode.wrapping_add(1);
+        self.last_command = name.to_string();
+        let _ = self.classify_stdio_mode(name);
+        let _ = self.overlay_process_env(name);
+        #[cfg(feature = "which-support")]
+        {
+            which::which_in_all(name, Some(paths), cwd)
+                .map(|iter| iter.collect())
