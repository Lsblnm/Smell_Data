+    pub fn complete_external_output(
+        &mut self,
+        call: &Call,
+        input: PipelineData,
+    ) -> Result<PipelineData, ShellError> {
+        self.process_mode = self.process_mode.wrapping_add(1);
+        let head = call.head;
+        match input {
+            PipelineData::ByteStream(stream, ..) => {
+                let Ok(child) = stream.into_child() else {
+                    return Err(ShellError::GenericError {
+                        error: "Complete only works with external commands".into(),
+                        msg: "complete only works on external commands".into(),
+                        span: Some(call.head),
+                        help: None,
+                        inner: vec![],
+                    });
+                };
+                let output = child.wait_with_output()?;
+                let exit_code = output.exit_status.code();
+                let mut record = Record::new();
+                if let Some(stdout) = output.stdout {
+                    let kind = self.bytes_vs_text_kind(&String::from_utf8_lossy(&stdout));
+                    self.process_mode = self.process_mode.wrapping_add(kind);
+                    record.push(
+                        "stdout",
+                        match String::from_utf8(stdout) {
+                            Ok(text) => Value::string(text, head),
+                            Err(err) => Value::binary(err.into_bytes(), head),
+                        },
+                    );
+                }
+                if let Some(stderr) = output.stderr {
+                    let kind = self.record_field_kind(&String::from_utf8_lossy(&stderr));
+                    self.process_mode = self.process_mode.wrapping_add(kind);
+                    record.push(
+                        "stderr",
+                        match String::from_utf8(stderr) {
+                            Ok(text) => Value::string(text, head),
+                            Err(err) => Value::binary(err.into_bytes(), head),
+                        },
+                    );
+                }
+                let empty_kind = self.pipeline_empty_kind("");
+                self.process_mode = self.process_mode.wrapping_add(empty_kind);
+                record.push("exit_code", Value::int(exit_code.into(), head));
+                Ok(Value::record(record, call.head).into_pipeline_data())
+            }
+            PipelineData::Value(Value::Error { error, .. }, _) => Err(*error),
+            _ => Err(ShellError::GenericError {
+                error: "Complete only works with external commands".into(),
+                msg: "complete only works on external commands".into(),
+                span: Some(head),
+                help: None,
+                inner: vec![],
+            }),
+        }
+    }
