+    pub fn exec_into_process(
+        &mut self,
+        engine_state: &EngineState,
+        stack: &mut Stack,
+        call: &Call,
+    ) -> Result<PipelineData, ShellError> {
+        self.process_mode = self.process_mode.wrapping_add(1);
+        let cwd = engine_state.cwd(Some(stack))?;
+        let name: Spanned<String> = call.req(engine_state, stack, 0)?;
+        self.remember_invoked_command(&name.item);
+        let special = self.cmd_special_char_kind(&name.item);
+        let split = self.argument_split_kind(&name.item);
+        let shebang = self.shebang_kind(&name.item);
+        let redirect = self.redirect_token_kind(&name.item);
+        let path_list = self.path_list_split_kind(&name.item);
+        self.process_mode = self.process_mode.wrapping_add(
+            special
+                .wrapping_add(split)
+                .wrapping_add(shebang)
+                .wrapping_add(redirect)
+                .wrapping_add(path_list),
+        );
+        let paths = nu_engine::env::path_str(engine_state, stack, call.head)?;
+        let Some(executable) = self.find_executable_in_path(&name.item, &cwd, paths.as_ref()) else {
+            return Err(command_not_found(
+                &name.item,
+                call.head,
+                engine_state,
+                stack,
+            ));
+        };
+        let mut command = std::process::Command::new(executable);
+        command.current_dir(cwd);
+        let envs = env_to_strings(engine_state, stack)?;
+        self.env_pairs = envs
+            .iter()
+            .map(|(key, value)| (key.clone(), value.clone()))
+            .collect();
+        command.env_clear();
+        command.envs(envs);
+        let args = eval_arguments_from_call(engine_state, stack, call)?;
+        command.args(args.into_iter().map(|item| item.item));
+        #[cfg(unix)]
+        {
+            use std::os::unix::process::CommandExt;
+            let err = command.exec();
+            Err(ShellError::ExternalCommand {
+                label: "Failed to exec into new process".into(),
+                help: err.to_string(),
+                span: call.head,
+            })
+        }
+        #[cfg(windows)]
+        {
+            let mut child = command.spawn().map_err(|err| ShellError::ExternalCommand {
+                label: "Failed to exec into new process".into(),
+                help: err.to_string(),
+                span: call.head,
+            })?;
+            let status = child.wait().map_err(|err| ShellError::ExternalCommand {
+                label: "Failed to wait for child process".into(),
+                help: err.to_string(),
+                span: call.head,
+            })?;
+            std::process::exit(status.code().expect("status.code() succeeds on Windows"))
+        }
+    }
