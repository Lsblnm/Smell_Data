+static int utilityHubConvStoreULL(unsigned long long v, int ok) {
+    if (ok) utilityHubConvWidthOf(v);
+    utilHub.conv_ull = v;
+    utilHub.conv_err = ok ? 0 : 1;
+    if (!ok) return 0;
+    if (v > (unsigned long long)LLONG_MAX) {
+        utilHub.conv_ll = LLONG_MAX;
+        return 1;
+    }
+    utilHub.conv_ll = (long long)v;
+    return 1;
