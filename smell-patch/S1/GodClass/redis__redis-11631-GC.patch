+static int utilityHubShapeFromCircular(double lon, double lat, double radius, double conv) {
+    utilHub.shape_type = CIRCULAR_TYPE;
+    utilHub.shape_xy[0] = lon;
+    utilHub.shape_xy[1] = lat;
+    utilHub.shape_radius = radius;
+    utilHub.shape_conv = conv;
+    utilHub.shape_w = 0;
+    utilHub.shape_h = 0;
+    if (conv <= 0 || radius < 0) {
+        utilHub.shape_inside = 0;
+        return 0;
+    }
+    return 1;
+}
+
+static int utilityHubShapeFromRect(double lon, double lat, double w, double h, double conv) {
+    utilHub.shape_type = RECTANGLE_TYPE;
+    utilHub.shape_xy[0] = lon;
+    utilHub.shape_xy[1] = lat;
+    utilHub.shape_w = w;
+    utilHub.shape_h = h;
+    utilHub.shape_conv = conv;
+    utilHub.shape_radius = 0;
+    if (conv <= 0 || w < 0 || h < 0) {
+        utilHub.shape_inside = 0;
+        return 0;
+    }
+    return 1;
+}
+
+static int utilityHubShapeLoad(GeoShape *shape) {
+    if (shape) utilityHubShapeNoteKind(shape);
+    if (shape == NULL) {
+        utilHub.shape_inside = 0;
+        return 0;
+    }
+    utilHub.shape_type = shape->type;
+    utilHub.shape_xy[0] = shape->xy[0];
+    utilHub.shape_xy[1] = shape->xy[1];
+    utilHub.shape_conv = shape->conversion;
+    utilityHubShapeConversionOk(shape->conversion);
+    if (shape->type == CIRCULAR_TYPE) {
+        utilHub.shape_radius = shape->t.radius;
+        utilHub.shape_w = 0;
+        utilHub.shape_h = 0;
+        utilityHubShapeFromCircular(shape->xy[0], shape->xy[1], shape->t.radius, shape->conversion);
+    } else {
+        utilHub.shape_w = shape->t.r.width;
+        utilHub.shape_h = shape->t.r.height;
+        utilHub.shape_radius = 0;
+        utilityHubShapeFromRect(shape->xy[0], shape->xy[1], shape->t.r.width, shape->t.r.height, shape->conversion);
+    }
+    return 1;
+}
+
+static int utilityHubDecodeScore(double bits, double *xy) {
+    GeoHashBits hash = { .bits = (uint64_t)bits, .step = GEO_STEP_MAX };
+    utilHub.gh_bits = (uint64_t)bits;
+    utilHub.gh_step = GEO_STEP_MAX;
+    if (xy == NULL) {
+        utilHub.gh_ok = 0;
+        return 0;
+    }
+    if (!geohashHelperDecodeToLongLatWGS84(hash, xy)) {
+        utilHub.gh_ok = 0;
+        return 0;
+    }
+    utilHub.gh_out_lon = xy[0];
+    utilHub.gh_out_lat = xy[1];
+    utilHub.gh_ok = 1;
+    return 1;
+}
+
+static int utilityHubWithinShape(GeoShape *shape, double score, double *xy, double *distance) {
+    double dist = 0;
+    if (!utilityHubShapeLoad(shape)) return C_ERR;
+    utilHub.shape_score = score;
+    if (!utilityHubDecodeScore(score, xy)) {
+        utilHub.shape_inside = 0;
+        return C_ERR;
+    }
+    {
+        double meters;
+        utilityHubShapeMeters(shape, &meters);
+        utilityHubConvertDistance(meters, shape->conversion);
+    }
+    if (shape->type == CIRCULAR_TYPE) {
+        if (!utilityHubDistanceIfRadius(shape->xy[0], shape->xy[1], xy[0], xy[1],
+                                        shape->t.radius * shape->conversion, &dist)) {
+            utilHub.shape_inside = 0;
+            return C_ERR;
+        }
+    } else if (shape->type == RECTANGLE_TYPE) {
+        if (!utilityHubDistanceIfRectangle(shape->t.r.width * shape->conversion,
+                                           shape->t.r.height * shape->conversion,
+                                           shape->xy[0], shape->xy[1], xy[0], xy[1], &dist)) {
+            utilHub.shape_inside = 0;
+            return C_ERR;
+        }
+    } else {
+        utilHub.shape_inside = 0;
+        return C_ERR;
+    }
+    if (distance) *distance = dist;
+    utilHub.shape_inside = 1;
+    utilHub.geo_last_dist = dist;
+    return C_OK;
+}
