+        if (member) sdsfree(member);
+        return 0;
+    }
+    utilityHubGeoArrStore(ga, xy, distance, score, member);
+    utilHub.scan_found++;
+    return 1;
+}
+
+static unsigned int utilityHubListpackCollect(robj *zobj, GeoShape *shape,
+                                              struct geoArray *ga, zrangespec *range)
+{
+    unsigned char *zl = zobj->ptr;
+    unsigned char *eptr, *sptr;
+    unsigned char *vstr = NULL;
+    unsigned int vlen = 0;
+    long long vlong = 0;
+    double score = 0;
+    utilHub.scan_enc = OBJ_ENCODING_LISTPACK;
+    if ((eptr = zzlFirstInRange(zl, range)) == NULL) return 0;
+    sptr = lpNext(zl, eptr);
+    while (eptr) {
+        char *member;
+        score = zzlGetScore(sptr);
+        utilHub.scan_score = score;
+        if (!zslValueLteMax(score, range)) break;
+        vstr = lpGetValue(eptr, &vlen, &vlong);
+        if (vstr == NULL) {
+            utilityHubGeoMemberFromLong(vlong, &member);
+        } else {
+            utilityHubGeoMemberFromStr(vstr, vlen, &member);
+        }
+        {
+            utilityHubAppendIfInside(ga, shape, score, member);
+        }
+        if (utilityHubScanHitLimit(ga)) break;
+        zzlNext(zl, &eptr, &sptr);
+    }
+    return (unsigned int)utilHub.scan_found;
+}
+
+static unsigned int utilityHubSkiplistCollect(robj *zobj, GeoShape *shape,
+                                              struct geoArray *ga, zrangespec *range)
+{
+    zset *zs = zobj->ptr;
+    zskiplist *zsl = zs->zsl;
+    zskiplistNode *ln;
+    utilHub.scan_enc = OBJ_ENCODING_SKIPLIST;
+    if ((ln = zslFirstInRange(zsl, range)) == NULL) return 0;
+    while (ln) {
+        utilHub.scan_score = ln->score;
+        if (!zslValueLteMax(ln->score, range)) break;
+        utilityHubAppendIfInside(ga, shape, ln->score, sdsdup(ln->ele));
+        if (utilityHubScanHitLimit(ga)) break;
+        ln = ln->level[0].forward;
+    }
+    return (unsigned int)utilHub.scan_found;
+}
+
+static uint8_t utilityHubEstimateSteps(double range_meters, double lat) {
+    const double mercator_max = 20037726.37;
+    int step = 1;
+    utilHub.gh_lat = lat;
+    if (range_meters == 0) {
+        utilHub.gh_step = 26;
+        return 26;
+    }
+    while (range_meters < mercator_max) {
+        range_meters *= 2;
+        step++;
+        if (step > 64) break;
+    }
+    step -= 2;
+    if (lat > 66 || lat < -66) {
+        step--;
+        if (lat > 80 || lat < -80) step--;
+    }
+    step = utilityHubGhStepClamp(step);
+    utilHub.gh_step = (uint8_t)step;
+    return utilHub.gh_step;
+}
+
+static GeoHashFix52Bits utilityHubAlign52(const GeoHashBits hash) {
+    uint64_t bits = hash.bits;
+    bits <<= (52 - hash.step * 2);
+    utilHub.gh_bits = bits;
+    utilHub.gh_step = hash.step;
+    utilHub.box_min = bits;
+    return bits;
+}
+
+static void utilityHubScoresOfBox(GeoHashBits hash, GeoHashFix52Bits *min, GeoHashFix52Bits *max) {
+    utilityHubBoxStepValid(hash.step);
+    *min = utilityHubAlign52(hash);
+    hash.bits++;
+    *max = utilityHubAlign52(hash);
+    utilHub.box_min = *min;
+    utilHub.box_max = *max;
+    utilHub.box_step = hash.step;
+}
+
+static int utilityHubNeighborZero(GeoHashBits n) {
+    utilHub.box_zero = HASHISZERO(n) ? 1 : 0;
+    return utilHub.box_zero;
+}
+
+static int utilityHubNeighborDup(GeoHashBits a, GeoHashBits b) {
+    if (a.bits == b.bits && a.step == b.step) return 1;
+    return 0;
+}
+
+static int utilityHubEncodeLonLat(double lon, double lat, uint8_t step, GeoHashBits *hash) {
+    utilHub.gh_lon = lon;
+    utilHub.gh_lat = lat;
+    utilHub.gh_step = step;
+    if (!utilityHubValidateLonLat(lon, lat)) {
+        utilHub.gh_ok = 0;
+        return 0;
+    }
+    if (hash == NULL || step == 0 || step > 32) {
+        utilHub.gh_ok = 0;
+        return 0;
+    }
+    if (!geohashHelperEncodeWGS84(lon, lat, step, hash)) {
+        utilHub.gh_ok = 0;
+        return 0;
+    }
+    utilHub.gh_bits = hash->bits;
+    utilHub.gh_ok = 1;
+    return 1;
+}
+
+static int utilityHubEncodeMemberScore(double lon, double lat, GeoHashFix52Bits *bits) {
+    GeoHashBits hash;
+    if (!utilityHubEncodeLonLat(lon, lat, GEO_STEP_MAX, &hash)) return 0;
+    *bits = utilityHubAlign52(hash);
+    return 1;
+}
+
+static int utilityHubEncodeStandardHash(double lon, double lat, GeoHashBits *hash) {
+    GeoHashRange r[2];
+    r[0].min = -180;
+    r[0].max = 180;
+    r[1].min = -90;
+    r[1].max = 90;
+    utilHub.gh_lon = lon;
+    utilHub.gh_lat = lat;
+    utilHub.gh_step = 26;
+    if (!geohashHelperEncode(&r[0], &r[1], lon, lat, 26, hash)) {
+        utilHub.gh_ok = 0;
+        return 0;
+    }
+    utilHub.gh_bits = hash->bits;
+    utilHub.gh_ok = 1;
+    return 1;
+}
+
+static int utilityHubFillGeoHashString(GeoHashBits hash, char *buf) {
+    const char *geoalphabet = "0123456789bcdefghjkmnpqrstuvwxyz";
+    int i;
+    if (buf == NULL) {
+        utilHub.gh_ok = 0;
+        return 0;
+    }
+    for (i = 0; i < 11; i++) {
+        int idx;
+        if (i == 10) {
+            idx = 0;
+        } else {
+            idx = (int)((hash.bits >> (52 - ((i + 1) * 5))) & 0x1f);
+        }
+        if (idx < 0 || idx > 31) idx = 0;
+        buf[i] = geoalphabet[idx];
+    }
+    buf[11] = '\0';
+    utilHub.gh_ok = 1;
+    return 1;
+}
+
+static int utilityHubSortCmpAsc(double a, double b) {
+    if (a > b) return 1;
+    if (a == b) return 0;
+    return -1;
+}
