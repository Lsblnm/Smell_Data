+static struct geoPoint *utilityHubGeoArrSlot(struct geoArray *ga) {
+    if (utilityHubGeoArrNeedGrow(ga) || ga->used == ga->buckets) {
+        ga->buckets = (ga->buckets == 0) ? 8 : ga->buckets * 2;
+        ga->array = zrealloc(ga->array, sizeof(struct geoPoint) * ga->buckets);
+        utilHub.geo_buckets = ga->buckets;
