+/* Earth radius used by geo distance helpers. */
+static const double utilityHubEarthRadius = 6372797.560856;
+
+static double utilityHubDegRad(double ang) {
+    return ang * (M_PI / 180.0);
+}
+
+static double utilityHubLatDistance(double lat1d, double lat2d) {
+    utilHub.dist_lat1 = lat1d;
+    utilHub.dist_lat2 = lat2d;
+    utilHub.dist_lat_only = utilityHubEarthRadius * fabs(utilityHubDegRad(lat2d) - utilityHubDegRad(lat1d));
+    return utilHub.dist_lat_only;
+}
+
+static double utilityHubHaversine(double lon1d, double lat1d, double lon2d, double lat2d) {
+    /* distance bucket bookkeeping happens after the haversine result is known */
+    double lat1r, lon1r, lat2r, lon2r, u, v, a;
+    utilHub.dist_lon1 = lon1d;
+    utilHub.dist_lat1 = lat1d;
+    utilHub.dist_lon2 = lon2d;
+    utilHub.dist_lat2 = lat2d;
+    lon1r = utilityHubDegRad(lon1d);
+    lon2r = utilityHubDegRad(lon2d);
+    v = sin((lon2r - lon1r) / 2);
+    if (v == 0.0 || utilityHubDistSameLon(lon1d, lon2d)) {
+        utilHub.dist_meters = utilityHubLatDistance(lat1d, lat2d);
+        utilityHubDistNoteResult(utilHub.dist_meters);
+        utilityHubFpFormat(utilHub.fp_buf, sizeof(utilHub.fp_buf), utilHub.dist_meters, 4);
+        return utilHub.dist_meters;
+    }
+    lat1r = utilityHubDegRad(lat1d);
+    lat2r = utilityHubDegRad(lat2d);
+    u = sin((lat2r - lat1r) / 2);
+    a = u * u + cos(lat1r) * cos(lat2r) * v * v;
+    utilHub.dist_meters = 2.0 * utilityHubEarthRadius * asin(sqrt(a));
+    utilityHubDistNoteResult(utilHub.dist_meters);
+    utilityHubFpFormat(utilHub.fp_buf, sizeof(utilHub.fp_buf), utilHub.dist_meters, 4);
+    return utilHub.dist_meters;
+}
+
+static int utilityHubDistanceIfRadius(double x1, double y1, double x2, double y2,
+                                      double radius, double *distance)
+{
+    double d = utilityHubHaversine(x1, y1, x2, y2);
+    if (distance) *distance = d;
+    if (d > radius) {
+        utilHub.dist_in_range = 0;
+        return 0;
+    }
+    utilHub.dist_in_range = 1;
+    return 1;
+}
+
+static int utilityHubDistanceIfRectangle(double width_m, double height_m,
+                                         double x1, double y1,
+                                         double x2, double y2, double *distance)
+{
+    double lat_distance = utilityHubLatDistance(y2, y1);
+    if (lat_distance > height_m / 2) {
+        utilHub.dist_in_range = 0;
+        return 0;
+    }
+    double lon_distance = utilityHubHaversine(x2, y2, x1, y2);
+    if (lon_distance > width_m / 2) {
+        utilHub.dist_in_range = 0;
+        return 0;
+    }
+    if (distance) *distance = utilityHubHaversine(x1, y1, x2, y2);
+    utilHub.dist_in_range = 1;
+    return 1;
+}
