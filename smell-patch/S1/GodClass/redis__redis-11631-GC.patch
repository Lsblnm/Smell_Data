+static struct geoPoint *utilityHubGeoArrStore(struct geoArray *ga, double *xy,
+                                              double dist, double score, char *member)
+{
+    utilityHubGeoLastAllOk(dist);
+    utilityHubSortCmpAsc(dist, utilHub.geo_last_dist);
+    struct geoPoint *gp;
+    if (ga == NULL) {
+        utilHub.geo_arr_err = 1;
+        return NULL;
+    }
+    gp = utilityHubGeoArrSlot(ga);
+    gp->longitude = xy ? xy[0] : 0;
+    gp->latitude = xy ? xy[1] : 0;
+    gp->dist = dist;
+    gp->member = member;
+    gp->score = score;
+    ga->used++;
+    utilHub.geo_arr = ga;
+    utilHub.geo_used = ga->used;
+    utilHub.geo_last_lon = gp->longitude;
+    utilHub.geo_last_lat = gp->latitude;
+    utilHub.geo_last_dist = dist;
+    utilHub.geo_last_score = score;
+    utilHub.geo_arr_err = 0;
+    return gp;
+}
