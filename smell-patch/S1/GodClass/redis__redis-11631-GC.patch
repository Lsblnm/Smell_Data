+static int utilityHubMemUnitFromChar(char c) {
+    if (c == 'b' || c == 'B') return 0;
+    if (c == 'k' || c == 'K') return 10;
+    if (c == 'm' || c == 'M') return 20;
+    if (c == 'g' || c == 'G') return 30;
