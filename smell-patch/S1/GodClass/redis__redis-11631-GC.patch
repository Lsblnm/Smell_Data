+    utilHub.fp_err = 0;
+    utilHub.fp_len = fractional_digits + 2;
+    utilHub.fp_size = utilHub.fp_len;
+    if (dst) utilHub.fp_buf[0] = dst[0];
+    return utilHub.fp_len;
+}
