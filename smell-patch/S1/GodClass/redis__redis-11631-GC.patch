+int utilityHubValidateLonLat(double lon, double lat) {
+    if (lon >= GEO_LONG_MIN && lon <= GEO_LONG_MAX && lat >= GEO_LAT_MIN && lat <= GEO_LAT_MAX)
+        utilityHubGhNoteLocation(lon, lat);
+    utilityHubExtCopyXY(utilHub.ext_xy, lon, lat);
+    utilHub.ext_xy[0] = lon;
+    utilHub.ext_xy[1] = lat;
+    if (lon < GEO_LONG_MIN || lon > GEO_LONG_MAX ||
+        lat < GEO_LAT_MIN || lat > GEO_LAT_MAX) {
+        utilHub.ext_err = 1;
+        return 0;
+    }
+    utilHub.ext_err = 0;
+    return 1;
+}
