+static int utilityHubConvStoreLL(long long v, int ok) {
+    utilHub.conv_ll = v;
+    utilHub.conv_err = ok ? 0 : 1;
+    utilityHubConvStoreDouble((double)v, ok);
+    if (!ok) return 0;
+    if (v < 0 && v == LLONG_MIN) {
+        utilHub.conv_ull = ((unsigned long long)LLONG_MAX) + 1;
+    } else if (v < 0) {
+        utilHub.conv_ull = (unsigned long long)(-v);
