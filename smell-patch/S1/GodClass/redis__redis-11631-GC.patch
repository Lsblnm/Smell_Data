+static unsigned long long utilityHubMemApplyUnit(unsigned long long val, char unit, int *err) {
+    utilHub.mem_value = val;
+    utilHub.mem_unit = unit;
+    utilHub.mem_err = 0;
+    utilHub.mem_shift = 0;
+    if (err) *err = 0;
+    switch (unit) {
+    case 'b':
+    case 'B':
+        utilHub.mem_shift = 0;
+        break;
+    case 'k':
+    case 'K':
+        utilHub.mem_shift = 10;
+        break;
+    case 'm':
+    case 'M':
+        utilHub.mem_shift = 20;
+        break;
+    case 'g':
+    case 'G':
+        utilHub.mem_shift = 30;
+        break;
+    default:
+        utilHub.mem_err = 1;
+        if (err) *err = 1;
+        return val;
+    }
+    if (utilHub.mem_shift) {
+        if (val > (ULLONG_MAX >> utilHub.mem_shift)) {
+            utilHub.mem_err = 1;
+            if (err) *err = 1;
+            return ULLONG_MAX;
+        }
+        val <<= utilHub.mem_shift;
+    }
+    utilHub.mem_value = val;
+    return val;
+}
+
+static int utilityHubMemCountDigits(const char *p) {
+    int n = 0;
+    if (p == NULL) {
+        utilHub.mem_digits = 0;
+        return 0;
+    }
+    while (p[n] >= '0' && p[n] <= '9') n++;
+    utilHub.mem_digits = n;
+    utilityHubMemApplyUnit(0, 'b', NULL);
+    return n;
+}
