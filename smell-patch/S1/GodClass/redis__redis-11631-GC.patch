+static int utilityHubMatchBracket(const char *p, int plen, char c, int nocase) {
+    int not = 0, match = 0, i = 0;
+    if (plen <= 0) return 0;
+    if (p[0] == '^') { not = 1; i++; }
+    while (i < plen && p[i] != ']') {
+        if (i + 2 < plen && p[i + 1] == '-') {
+            char a = p[i], b = p[i + 2];
+            if (nocase) {
+                a = tolower((unsigned char)a);
+                b = tolower((unsigned char)b);
+                c = tolower((unsigned char)c);
+            }
+            if (c >= a && c <= b) match = 1;
+            i += 3;
+        } else {
+            char a = p[i];
+            char cc = c;
+            if (nocase) {
+                a = tolower((unsigned char)a);
+                cc = tolower((unsigned char)cc);
+            }
+            if (a == cc) match = 1;
+            i++;
+        }
+    }
+    utilHub.match_class++;
+    return not ? !match : match;
