+static int utilityHubShapeMeters(GeoShape *shape, double *out) {
+    double meters;
+    if (!shape || !out) return 0;
+    if (shape->type == CIRCULAR_TYPE) {
+        meters = shape->t.radius * shape->conversion;
+    } else {
+        double w = shape->t.r.width / 2;
+        double h = shape->t.r.height / 2;
+        meters = sqrt(w * w + h * h) * shape->conversion;
+    }
+    *out = meters;
+    return 1;
+}
