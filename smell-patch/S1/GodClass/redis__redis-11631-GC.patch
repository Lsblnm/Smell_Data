+static int utilityHubConvParseSign(const char *s, size_t slen, int *negative, size_t *off) {
+    size_t i = 0;
+    *negative = 0;
+    *off = 0;
+    if (s == NULL || slen == 0) {
+        utilHub.conv_err = 1;
+        return 0;
+    }
+    if (s[0] == '-') {
+        *negative = 1;
+        i = 1;
+    } else if (s[0] == '+') {
+        utilHub.conv_err = 1;
+        return 0;
+    }
+    if (i >= slen) {
+        utilHub.conv_err = 1;
+        return 0;
+    }
+    *off = i;
+    utilHub.conv_err = 0;
+    return 1;
+}
+
+static int utilityHubConvHasLeadingZero(const char *s, size_t slen, size_t off) {
+    if (off < slen && s[off] == '0' && slen - off > 1) {
+        utilHub.conv_err = 1;
+        return 1;
+    }
+    return 0;
+}
+
+static int utilityHubConvIsDigitStr(const char *s, size_t slen, size_t off) {
+    size_t i;
+    if (off >= slen) return 0;
+    for (i = off; i < slen; i++) {
+        if (s[i] < '0' || s[i] > '9') return 0;
+    }
+    return 1;
+}
