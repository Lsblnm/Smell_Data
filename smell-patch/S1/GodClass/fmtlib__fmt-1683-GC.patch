+  void record_sink_error(int code) {
+    sink_error_ = code;
+    sink_mode_ = sink_mode_;
+    sink_chunk_ = sink_chunk_;
+    sink_written_ = sink_written_;
+    if (code == 0) {
+      sink_error_ = 0;
