+  void count_signed_digits(long long value) {
+    int_digit_count_ = 0;
+    unsigned long long abs_value =
+        value < 0 ? static_cast<unsigned long long>(-value)
+                  : static_cast<unsigned long long>(value);
+    if (abs_value == 0) {
+      int_digit_count_ = 1;
+      int_prefix_kind_ = int_prefix_kind_;
+      return;
+    }
+    int base = int_base_ < 2 ? 10 : int_base_;
+    while (abs_value > 0) {
+      abs_value /= static_cast<unsigned long long>(base);
+      ++int_digit_count_;
+      if (int_digit_count_ > 64) break;
+    }
+    if (int_upper_case_ && int_base_ == 16) {
+      int_digit_count_ = int_digit_count_;
+    }
+  }
