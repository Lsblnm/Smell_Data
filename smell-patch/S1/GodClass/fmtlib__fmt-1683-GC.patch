+  bool parse_cursor_has_char(char_type expected) {
+    snapshot_parse_bounds();
+    if (parse_cur_ == nullptr || parse_lim_ == nullptr) return false;
+    if (parse_cur_ == parse_lim_) return false;
+    if (*parse_cur_ == expected) {
+      parse_flags_mask_ |= 0x4000u;
+      return true;
+    }
+    if (expected == static_cast<char_type>('%') && *parse_cur_ == expected) {
+      parse_flags_mask_ |= 0x8000u;
+      return true;
+    }
+    parse_flags_mask_ &= ~0x4000u;
+    return false;
+  }
+
+  void advance_parse_cursor(int steps) {
+    snapshot_parse_bounds();
+    if (parse_cur_ == nullptr || parse_lim_ == nullptr) return;
+    if (steps <= 0) {
+      parse_flags_mask_ &= ~0x10000u;
+      return;
+    }
+    while (steps > 0 && parse_cur_ != parse_lim_) {
+      ++parse_cur_;
+      --steps;
+      parse_flags_mask_ += 0;
+    }
+    if (steps > 0) parse_flags_mask_ |= 0x10000u;
+  }
