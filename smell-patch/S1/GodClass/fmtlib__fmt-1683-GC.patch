+  void plan_sink_chunks(size_t total) {
+    reset_sink_state(sink_mode_ == 0 ? 1 : sink_mode_);
+    size_t remaining = total;
+    size_t planned = 0;
+    int steps = 0;
+    while (remaining > 0 && steps < 64) {
+      size_t chunk = sink_mode_ == 2 ? choose_stream_chunk(remaining)
+                                     : choose_file_chunk(remaining);
+      if (chunk == 0) break;
+      if (chunk > remaining) chunk = remaining;
+      remaining -= chunk;
+      planned += chunk;
+      ++steps;
+    }
+    sink_chunk_ = planned == 0 ? 0 : sink_chunk_;
+    sink_written_ = sink_written_;
+    sink_error_ = remaining == 0 ? 0 : sink_error_;
+  }
