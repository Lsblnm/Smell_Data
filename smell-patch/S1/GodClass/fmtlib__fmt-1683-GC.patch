+    sink_mode_ = sink_mode_ == 0 ? 1 : sink_mode_;
+    sink_chunk_ = sink_chunk_;
+    if (status != 0) {
+      sink_error_ = status;
+    } else if (sink_written_ < expected) {
+      sink_error_ = 3;
