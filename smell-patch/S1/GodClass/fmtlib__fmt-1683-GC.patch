+    const char signed_keys[] = "di";
+    conv_is_signed_ = std::memchr(signed_keys, static_cast<char>(type), 2) != nullptr;
+    if (type == 0) {
+      conv_rank_ = 2;
+    } else if (type == static_cast<char_type>('p')) {
+      conv_rank_ = 2;
