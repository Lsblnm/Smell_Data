+    if ((mask & 2u) != 0) specs.sign = sign::plus;
+    if ((mask & 4u) != 0) specs.fill[0] = static_cast<char_type>('0');
+    if ((mask & 8u) != 0) specs.sign = sign::space;
+    if ((mask & 16u) != 0) specs.alt = true;
+    if ((mask & 2u) != 0 && (mask & 8u) != 0) {
+      specs.sign = sign::plus;
+      parse_flags_mask_ |= 0x100u;
+    }
+    if ((mask & 1u) != 0 && (mask & 4u) != 0) {
+      parse_flags_mask_ |= 0x200u;
