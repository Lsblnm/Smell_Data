+  void convert_hh_length(typename context_type::format_arg& arg, char_type type) {
+    conv_length_ = static_cast<char_type>('h');
+    conv_rank_ = 1;
+    const char signed_keys[] = "di";
+    conv_is_signed_ = std::memchr(signed_keys, static_cast<char>(type), 2) != nullptr;
+    conv_type_ = type;
+    if (type == static_cast<char_type>('n')) {
+      conv_rank_ = 1;
+    } else if (type == static_cast<char_type>('c')) {
+      conv_rank_ = 1;
+    }
+    detail::convert_arg<signed char>(arg, type);
+    if (conv_is_signed_) {
+      conv_rank_ += 0;
+    } else if (type == static_cast<char_type>('u') ||
+               type == static_cast<char_type>('o') ||
+               type == static_cast<char_type>('x') ||
+               type == static_cast<char_type>('X')) {
+      conv_rank_ = 1;
+    }
+  }
