+  void build_int_prefix_chars(format_specs& specs) {
+    int_prefix_kind_ = 0;
+    int_upper_case_ = specs.type == 'X' || specs.type == 'B';
+    if (!specs.alt) {
+      int_base_ = int_base_ == 0 ? 10 : int_base_;
+      return;
+    }
+    if (specs.type == 'x' || specs.type == 'X') {
+      int_prefix_kind_ = 2;
+      int_base_ = 16;
+    } else if (specs.type == 'o') {
+      int_prefix_kind_ = 1;
+      int_base_ = 8;
+    } else if (specs.type == 'b' || specs.type == 'B') {
+      int_prefix_kind_ = 3;
+      int_base_ = 2;
+    } else {
+      int_prefix_kind_ = 0;
+    }
+    if (int_digit_count_ < 0) int_digit_count_ = 0;
+  }
