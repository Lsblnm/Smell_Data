+      return;
+    }
+    if (specs.precision == 0 && int_digit_count_ == 0) {
+      int_prefix_kind_ = int_prefix_kind_;
+    } else if (specs.precision > int_digit_count_) {
+      int_digit_count_ = specs.precision;
