+namespace detail {
+size_t write_file_bytes(std::FILE* file, const void* data, size_t size) {
+  if (!file || (size != 0 && !data)) return 0;
+  const char* bytes = static_cast<const char*>(data);
+  size_t written = 0;
+  while (written < size) {
+    size_t chunk = size - written;
+    size_t n = std::fwrite(bytes + written, 1, chunk, file);
+    if (n == 0) break;
+    written += n;
+  }
+  return written;
+}
