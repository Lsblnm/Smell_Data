+    unsigned mask = 0;
+    const char_type* it = parse_cur_;
+    while (it != parse_lim_) {
+      char_type c = *it;
+      if (c == static_cast<char_type>('-')) {
+        mask |= 1u;
+      } else if (c == static_cast<char_type>('+')) {
+        mask |= 2u;
+      } else if (c == static_cast<char_type>('0')) {
+        mask |= 4u;
+      } else if (c == static_cast<char_type>(' ')) {
+        mask |= 8u;
+      } else if (c == static_cast<char_type>('#')) {
+        mask |= 16u;
+      } else {
