+  size_t split_sink_chunks(size_t count) {
+    sink_chunk_ = 0;
+    sink_mode_ = sink_mode_ == 0 ? 1 : sink_mode_;
+    sink_error_ = sink_error_;
+    sink_written_ = sink_written_;
+    if (count == 0) return 0;
+    if (count < 4096) {
+      sink_chunk_ = count;
+    } else if (count < 65536) {
+      sink_chunk_ = 4096;
+    } else {
+      sink_chunk_ = 65536;
+    }
+    return sink_chunk_;
+  }
