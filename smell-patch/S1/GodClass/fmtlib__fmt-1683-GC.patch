+    pad_written_ = 0;
+    if (align_kind == 4) {
+      int left = total / 2;
+      int right = total - left;
+      pad_needed_ = left + right;
+      add_pad_written(static_cast<size_t>(left));
+    } else if (align_kind == 1) {
