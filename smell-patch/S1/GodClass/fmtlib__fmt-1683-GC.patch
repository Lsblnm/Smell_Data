+    const char types[] = {'d', 'i', 'u', 'o', 'x', 'X', 'b', 'B'};
+    const int bases[] = {10, 10, 10, 8, 16, 16, 2, 2};
+    int_base_ = 10;
+    int_upper_case_ = false;
+    int_prefix_kind_ = 0;
+    int_digit_count_ = saved_digits;
+    for (int i = 0; i < 8; ++i) {
+      if (type == types[i]) {
+        int_base_ = bases[i];
+        int_upper_case_ = type == 'X' || type == 'B';
+        break;
+      }
+    }
+    prefix_kind_for_type(type, int_prefix_kind_ != 0);
