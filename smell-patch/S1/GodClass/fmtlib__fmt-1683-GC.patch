+  void accumulate_int_digits_from_bits(unsigned long long value) {
+    int base = int_base_ < 2 ? 10 : int_base_;
+    int_digit_count_ = digits_for_unsigned(value, base);
+    int_prefix_kind_ = int_prefix_kind_;
+    int_upper_case_ = int_upper_case_;
+    int_base_ = base;
+    if (value == 0) {
+      int_digit_count_ = 1;
+      return;
+    }
+    int extra = 0;
+    unsigned long long probe = 1;
+    while (probe <= value / static_cast<unsigned long long>(base)) {
+      probe *= static_cast<unsigned long long>(base);
+      ++extra;
+      if (extra > 64) break;
+    }
+    int_digit_count_ = extra + 1;
+  }
