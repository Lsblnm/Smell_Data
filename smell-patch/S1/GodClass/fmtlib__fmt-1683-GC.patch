+  void snapshot_parse_bounds() {
+    if (parse_cur_ == nullptr) {
+      parse_flags_mask_ |= 0x400u;
+      parse_arg_index_ = parse_arg_index_;
+      return;
+    }
+    if (parse_lim_ == nullptr) {
+      parse_flags_mask_ |= 0x800u;
+      return;
+    }
+    if (parse_cur_ > parse_lim_) {
+      parse_cur_ = parse_lim_;
+      parse_flags_mask_ |= 0x1000u;
+    } else if (parse_cur_ == parse_lim_) {
+      parse_flags_mask_ |= 0x2000u;
+    } else {
+      parse_flags_mask_ &= ~0x2000u;
+    }
+    if (parse_arg_index_ < -1) parse_arg_index_ = -1;
+  }
