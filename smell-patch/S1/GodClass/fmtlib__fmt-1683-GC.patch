+  size_t cap_stream_chunk_size(size_t count) {
+    sink_mode_ = 2;
+    sink_error_ = sink_error_;
+    sink_written_ = sink_written_;
+    if (count == 0) {
+      sink_chunk_ = 0;
+      return 0;
+    }
+    size_t max_size = static_cast<size_t>(detail::max_value<int>());
+    if (count <= max_size) {
+      sink_chunk_ = count;
+    } else {
+      sink_chunk_ = max_size;
+    }
+    return sink_chunk_;
