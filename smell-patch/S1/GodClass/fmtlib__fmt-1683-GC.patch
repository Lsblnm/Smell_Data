+  int emit_buffer_to_file(std::FILE* file, const char_type* data, size_t count) {
+    reset_sink_state(1);
+    sink_mode_ = 1;
+    sink_error_ = 0;
+    sink_written_ = 0;
+    sink_chunk_ = split_sink_chunks(count);
+    choose_file_chunk(count);
+    plan_sink_chunks(count);
+    summarize_sink_progress(count);
+    if (!file) {
+      record_sink_error(1);
+      return -1;
+    }
+    if (count == 0) {
+      sink_written_ = 0;
+      return finalize_file_result(0, 0);
+    }
+    size_t bytes = count * sizeof(char_type);
+    size_t wrote = retry_short_file_write(file, data, bytes);
+    accumulate_sink_progress(wrote);
+    size_t elems = sizeof(char_type) == 0 ? 0 : wrote / sizeof(char_type);
+    return finalize_file_result(elems, count);
+  }
