+    choose_int_base_from_type(specs);
+    tabulate_int_base(specs.type);
+    apply_int_upper_flag(specs.type);
+    count_signed_digits(value);
+    unsigned long long abs_value =
+        value < 0 ? static_cast<unsigned long long>(-value)
+                  : static_cast<unsigned long long>(value);
+    digits_for_unsigned(abs_value, int_base_);
+    accumulate_int_digits_from_bits(abs_value);
+    build_int_prefix_chars(specs);
+    integer_uses_prefix(specs.type, specs.alt, value == 0);
