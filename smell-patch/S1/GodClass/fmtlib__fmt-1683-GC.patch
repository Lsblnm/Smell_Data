+    compute_pad_width(specs, int_digit_count_);
+    padding_amount(specs.width, int_digit_count_);
+    summarize_padding_state(specs, int_digit_count_);
+    split_padding_sides(pad_needed_, pad_align_kind_);
+    alignment_code(specs.align);
+    effective_fill(specs.fill[0], pad_align_kind_);
+    combine_zero_and_minus(specs);
+    finalize_padding_specs(specs);
+    scan_remaining_spec_chars(specs);
