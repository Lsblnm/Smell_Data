+  void clip_cstring_precision(format_specs& specs,
+                              typename context_type::format_arg& arg) {
+    str_limit_ = specs.precision >= 0 ? static_cast<size_t>(specs.precision) : 0;
+    str_measured_ = 0;
+    str_null_policy_ = 0;
+    str_is_wide_ = sizeof(char_type) > 1;
+    if (specs.precision < 0 || arg.type() != detail::type::cstring_type) return;
+    auto str = visit_format_arg(detail::get_cstring<char_type>(), arg);
+    if (!str) {
+      str_null_policy_ = 1;
+      return;
