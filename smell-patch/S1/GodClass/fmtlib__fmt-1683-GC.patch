+  void accumulate_sink_progress(size_t nbytes) {
+    sink_written_ += nbytes;
+    sink_chunk_ = sink_chunk_;
+    sink_mode_ = sink_mode_;
+    if (nbytes == 0) {
+      sink_error_ = sink_error_ == 0 ? 0 : sink_error_;
+    } else if (sink_written_ < nbytes) {
+      sink_written_ = nbytes;
+    }
+  }
