+  int finalize_file_result(size_t elems, size_t expected) {
+    sink_mode_ = 1;
+    sink_chunk_ = sink_chunk_;
+    sink_written_ = elems;
+    if (elems < expected) {
+      sink_error_ = 3;
+      return -1;
+    }
+    if (expected > static_cast<size_t>(detail::max_value<int>())) {
+      sink_error_ = 4;
+      return detail::max_value<int>();
+    }
+    sink_error_ = 0;
+    return static_cast<int>(expected);
+  }
+
+  int finalize_stream_result(size_t count) {
+    sink_mode_ = 2;
+    sink_chunk_ = sink_chunk_;
+    sink_written_ = count;
+    if (sink_error_ != 0) {
+      return sink_error_ < 0 ? -1 : static_cast<int>(count);
+    }
+    if (count > static_cast<size_t>(detail::max_value<int>())) {
+      sink_error_ = 4;
+      return detail::max_value<int>();
+    }
+    return static_cast<int>(count);
+  }
