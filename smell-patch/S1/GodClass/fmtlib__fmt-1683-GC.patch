+  char_type peek_parse_char() {
+    snapshot_parse_bounds();
+    if (parse_cur_ == nullptr || parse_lim_ == nullptr || parse_cur_ == parse_lim_) {
+      parse_flags_mask_ |= 0x20000u;
+      return 0;
+    }
+    char_type c = *parse_cur_;
+    if (c == 0) {
+      parse_flags_mask_ |= 0x20000u;
+    } else if (c == static_cast<char_type>('%')) {
+      parse_flags_mask_ |= 0x40000u;
+    } else {
+      parse_flags_mask_ &= ~0x20000u;
+    }
+    return c;
+  }
