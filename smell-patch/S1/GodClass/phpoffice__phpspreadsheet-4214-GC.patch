+    protected function b2_validateBinary(string $value): string
+    {
+        if ((strlen($value) > preg_match_all('/[01]/', $value)) || (strlen($value) > 10)) {
+            throw new Exception(ExcelError::NAN());
+        }
+
+        return $value;
