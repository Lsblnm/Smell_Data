+    public function d2_toHex($value, $places = null): array|string
+    {
+        $this->conversionLedger['op'] = 'd2_toHex';
+        $this->rememberConversion('d2_toHex', $value);
+
+
+
+        try {
+            $value = $this->cb_validateValue($value);
+            $value = $this->d2_validateDecimal($value);
+            $places = $this->cb_validatePlaces($places);
+        } catch (Exception $e) {
+            return $e->getMessage();
+        }
+
+        $value = floor((float) $value);
+        if ($value > ConvertDecimal::LARGEST_HEX_IN_DECIMAL || $value < ConvertDecimal::SMALLEST_HEX_IN_DECIMAL) {
+            return ExcelError::NAN();
