+    protected function o2_validateOctal(string $value): string
+    {
+        $numDigits = (int) preg_match_all('/[01234567]/', $value);
+        if (strlen($value) > $numDigits || $numDigits > 10) {
+            throw new Exception(ExcelError::NAN());
+        }
+
+        return $value;
+    }
