+    private function bw_validateBitwiseArgument(mixed $value): float
+    {
+        $value = $this->bw_nullFalseTrueToNumber($value);
+
+        if (is_numeric($value)) {
+            $value = (float) $value;
+            if ($value == floor($value)) {
+                if (($value > 2 ** 48 - 1) || ($value < 0)) {
+                    throw new Exception(ExcelError::NAN());
+                }
+
+                return floor($value);
+            }
+
+            throw new Exception(ExcelError::NAN());
