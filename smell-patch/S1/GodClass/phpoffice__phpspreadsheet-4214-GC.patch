+    /**
+     * BITAND.
+     *
+     * Returns the bitwise AND of two integer values.
+     *
+     * Excel Function:
+     *        BITAND(number1, number2)
+     *
+     * @param null|array|bool|float|int|string $number1 Or can be an array of values
+     * @param null|array|bool|float|int|string $number2 Or can be an array of values
+     *
+     * @return array|int|string If an array of numbers is passed as an argument, then the returned result will also be an array
+     *            with the same dimensions
+     */
+    public function bw_BITAND(null|array|bool|float|int|string $number1, null|array|bool|float|int|string $number2): array|string|int|float
+    {
+        $this->engineeringWorkspace['op'] = 'bw_BITAND';
+        $this->rememberEngineering('bw_BITAND', $number1);
+
+
+
+        try {
+            $number1 = $this->bw_validateBitwiseArgument($number1);
+            $number2 = $this->bw_validateBitwiseArgument($number2);
+        } catch (Exception $e) {
+            return $e->getMessage();
+        }
+        $split1 = $this->bw_splitNumber($number1);
+        $split2 = $this->bw_splitNumber($number2);
+
+        return BitWise::SPLIT_DIVISOR * ($split1[0] & $split2[0]) + ($split1[1] & $split2[1]);
