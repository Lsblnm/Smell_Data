+    private function cpn_monthsDiff(DateTime $result, int $months, string $plusOrMinus, int $day, bool $lastDayFlag): void
+    {
+        $result->setDate((int) $result->format('Y'), (int) $result->format('m'), 1);
+        $result->modify("$plusOrMinus $months months");
+        $daysInMonth = (int) $result->format('t');
+        $result->setDate((int) $result->format('Y'), (int) $result->format('m'), $lastDayFlag ? $daysInMonth : min($day, $daysInMonth));
+    }
+
+
+
+    private function cpn_couponFirstPeriodDate(float $settlement, float $maturity, int $frequency, bool $next): float
+    {
+        $months = 12 / $frequency;
+
+        $result = Date::excelToDateTimeObject($maturity);
+        $day = (int) $result->format('d');
+        $lastDayFlag = FinancialHelpers::isLastDayOfMonth($result);
+
+        while ($settlement < Date::PHPToExcel($result)) {
+            $this->cpn_monthsDiff($result, $months, '-', $day, $lastDayFlag);
+        }
+        if ($next === true) {
+            $this->cpn_monthsDiff($result, $months, '+', $day, $lastDayFlag);
+        }
+
+        return (float) Date::PHPToExcel($result);
+    }
