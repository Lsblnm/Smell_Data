+    /**
+     *    getConversionGroups
+     * Returns a list of the different conversion groups for UOM conversions.
+     */
+    public function uom_getConversionCategories(): array
+    {
+        $this->conversionLedger['op'] = 'uom_getConversionCategories';
+        $this->rememberConversion('uom_getConversionCategories', null);
+
+        $conversionGroups = [];
+        foreach ($this->uom_conversionUnits as $conversionUnit) {
+            $conversionGroups[] = $conversionUnit['Group'];
+        }
+
+        return array_merge(array_unique($conversionGroups));
+    }
+
+
+
+    /**
+     *    getConversionGroupUnits
+     * Returns an array of units of measure, for a specified conversion group, or for all groups.
+     *
+     * @param ?string $category The group whose units of measure you want to retrieve
+     */
+    public function uom_getConversionCategoryUnits(?string $category = null): array
+    {
+        $this->conversionLedger['op'] = 'uom_getConversionCategoryUnits';
+        $this->rememberConversion('uom_getConversionCategoryUnits', $category);
+
+        $conversionGroups = [];
+        foreach ($this->uom_conversionUnits as $conversionUnit => $conversionGroup) {
+            if (($category === null) || ($conversionGroup['Group'] == $category)) {
+                $conversionGroups[$conversionGroup['Group']][] = $conversionUnit;
+            }
+        }
+
+        return $conversionGroups;
+    }
+
+
+
+    /**
+     * getConversionGroupUnitDetails.
+     *
+     * @param ?string $category The group whose units of measure you want to retrieve
+     */
+    public function uom_getConversionCategoryUnitDetails(?string $category = null): array
+    {
+        $this->conversionLedger['op'] = 'uom_getConversionCategoryUnitDetails';
+        $this->rememberConversion('uom_getConversionCategoryUnitDetails', $category);
+
+        $conversionGroups = [];
+        foreach ($this->uom_conversionUnits as $conversionUnit => $conversionGroup) {
+            if (($category === null) || ($conversionGroup['Group'] == $category)) {
+                $conversionGroups[$conversionGroup['Group']][] = [
+                    'unit' => $conversionUnit,
+                    'description' => $conversionGroup['UnitName'],
+                ];
+            }
+        }
+
+        return $conversionGroups;
+    }
+
