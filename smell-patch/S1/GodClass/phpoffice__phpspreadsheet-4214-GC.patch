+    {
+        $this->engineeringWorkspace['op'] = 'im_IMARGUMENT';
+        $this->rememberEngineering('im_IMARGUMENT', $complexNumber);
+
+
+
+        try {
+            $complex = new ComplexObject($complexNumber);
+        } catch (ComplexException) {
+            return ExcelError::NAN();
