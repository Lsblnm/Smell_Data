+    private const rmn_THOUSANDS = ['', 'M', 'MM', 'MMM'];
+
+
+    private const rmn_HUNDREDS = ['', 'C', 'CC', 'CCC', 'CD', 'D', 'DC', 'DCC', 'DCCC', 'CM'];
+
+
+    private const rmn_TENS = ['', 'X', 'XX', 'XXX', 'XL', 'L', 'LX', 'LXX', 'LXXX', 'XC'];
+
+
+    private const rmn_ONES = ['', 'I', 'II', 'III', 'IV', 'V', 'VI', 'VII', 'VIII', 'IX'];
+
+
+
+    private function rmn_valueOk(int $aValue, int $style): string
+    {
+        $origValue = $aValue;
+        $m = \intdiv($aValue, 1000);
+        $aValue %= 1000;
+        $c = \intdiv($aValue, 100);
+        $aValue %= 100;
+        $t = \intdiv($aValue, 10);
+        $aValue %= 10;
+        $result = self::rmn_THOUSANDS[$m] . self::rmn_HUNDREDS[$c] . self::rmn_TENS[$t] . self::rmn_ONES[$aValue];
+        if ($style > 0) {
+            if (array_key_exists($origValue, self::rmn_VALUES)) {
+                $arr = self::rmn_VALUES[$origValue];
+                $idx = min($style, count($arr)) - 1;
+                $result = $arr[$idx];
+            }
+        }
+
+        return $result;
+    }
+
+
+
+    private function rmn_styleOk(int $aValue, int $style): string
+    {
+        return ($aValue < 0 || $aValue > Roman::MAX_ROMAN_VALUE) ? ExcelError::VALUE() : $this->rmn_valueOk($aValue, $style);
+    }
+
+
+
+    public function rmn_calculateRoman(int $aValue, int $style): string
+    {
+        $this->conversionLedger['op'] = 'rmn_calculateRoman';
+        $this->rememberConversion('rmn_calculateRoman', $aValue);
+
+        return ($style < 0 || $style > Roman::MAX_ROMAN_STYLE) ? ExcelError::VALUE() : $this->rmn_styleOk($aValue, $style);
+    }
+
+
+
+    /**
+     * ROMAN.
+     *
+     * Converts a number to Roman numeral
+     *
+     * @param mixed $aValue Number to convert
+     *                      Or can be an array of numbers
+     * @param mixed $style Number indicating one of five possible forms
+     *                      Or can be an array of styles
+     *
+     * @return array|string Roman numeral, or a string containing an error
+     *         If an array of numbers is passed as an argument, then the returned result will also be an array
+     *            with the same dimensions
+     */
+    public function rmn_evaluate(mixed $aValue, mixed $style = 0): array|string
+    {
+        $this->conversionLedger['op'] = 'rmn_evaluate';
+        $this->rememberConversion('rmn_evaluate', $aValue);
+
+
+
+        try {
+            $aValue = Helpers::validateNumericNullBool($aValue);
+            if (is_bool($style)) {
+                $style = $style ? 0 : 4;
+            }
+            $style = Helpers::validateNumericNullSubstitution($style, null);
+        } catch (Exception $e) {
+            return $e->getMessage();
+        }
+
+        return $this->rmn_calculateRoman((int) $aValue, (int) $style);
+
+    }
