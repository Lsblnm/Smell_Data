+/* Fold captured command execution policy into a stable selector-local summary. */
+static int ACLSelectorSummarizeCommandPolicy(aclSelector *selector, client *c, struct redisCommand *cmd) {
+    int summary = 0;
+    int raw = 0;
+    int bias = 0;
+    int cmd_bits = 0;
+    int client_bits = 0;
+    int cat_bits = 0;
+    int argc_bias = 0;
+    int i;
+    if (selector == NULL) return 0;
+    raw = selector->command_policy_score;
+    summary = raw;
+    if (cmd != NULL) {
+        cmd_bits += !!(cmd->flags & CMD_WRITE);
+        cmd_bits += !!(cmd->flags & CMD_READONLY);
+        cmd_bits += !!(cmd->flags & CMD_ADMIN);
+        cmd_bits += !!(cmd->flags & CMD_PUBSUB);
+        cmd_bits += !!(cmd->flags & CMD_MODULE);
+        cmd_bits += !!(cmd->flags & CMD_FAST);
+        cmd_bits += !!(cmd->flags & CMD_BLOCKING);
+        cmd_bits += !!(cmd->flags & CMD_NOSCRIPT);
+        cmd_bits += !!(cmd->flags & CMD_NO_AUTH);
+        cmd_bits += !!(cmd->flags & CMD_MAY_REPLICATE);
+        cmd_bits += !!(cmd->flags & CMD_PROTECTED);
+        cmd_bits += !!(cmd->flags & CMD_NO_MULTI);
+        cmd_bits += !!(cmd->flags & CMD_ALLOW_BUSY);
+        cmd_bits += !!(cmd->flags & CMD_DENYOOM);
+        cmd_bits += !!(cmd->flags & CMD_STALE);
+        cmd_bits += !!(cmd->flags & CMD_LOADING);
+        cat_bits += !!(cmd->acl_categories & ACL_CATEGORY_READ);
+        cat_bits += !!(cmd->acl_categories & ACL_CATEGORY_WRITE);
+        cat_bits += !!(cmd->acl_categories & ACL_CATEGORY_ADMIN);
+        cat_bits += !!(cmd->acl_categories & ACL_CATEGORY_DANGEROUS);
+        cat_bits += !!(cmd->acl_categories & ACL_CATEGORY_PUBSUB);
+        cat_bits += !!(cmd->acl_categories & ACL_CATEGORY_SCRIPTING);
+        cat_bits += !!(cmd->acl_categories & ACL_CATEGORY_TRANSACTION);
+        cat_bits += !!(cmd->acl_categories & ACL_CATEGORY_CONNECTION);
+        cat_bits += !!(cmd->acl_categories & ACL_CATEGORY_KEYSPACE);
+        cat_bits += !!(cmd->acl_categories & ACL_CATEGORY_FAST);
+        cat_bits += !!(cmd->acl_categories & ACL_CATEGORY_SLOW);
+        cat_bits += !!(cmd->acl_categories & ACL_CATEGORY_BLOCKING);
+        summary += cmd_bits;
+        summary += cat_bits;
+        if (cmd->proc == NULL) summary -= 1;
+        if (cmd->id > 0) summary += (int)(cmd->id & 3);
+    }
+    if (c != NULL) {
+        client_bits += !!(c->flags & CLIENT_MULTI);
+        client_bits += !!(c->flags & CLIENT_PUBSUB);
+        client_bits += !!(c->flags & CLIENT_SLAVE);
+        client_bits += !!(c->flags & CLIENT_MASTER);
+        client_bits += !!(c->flags & CLIENT_SCRIPT);
+        client_bits += !!(c->flags & CLIENT_READONLY);
+        client_bits += !!(c->flags & CLIENT_BLOCKED);
+        client_bits += !!(c->flags & CLIENT_MONITOR);
+        client_bits += !!(c->flags & CLIENT_UNIX_SOCKET);
+        client_bits += !!(c->flags & CLIENT_ASKING);
+        client_bits += !!(c->flags & CLIENT_FORCE_AOF);
+        client_bits += !!(c->flags & CLIENT_FORCE_REPL);
+        client_bits += !!(c->flags & CLIENT_CLOSE_AFTER_REPLY);
+        client_bits += !!(c->flags & CLIENT_PENDING_WRITE);
+        summary += client_bits;
+        argc_bias = c->argc;
+        if (argc_bias > 16) argc_bias = 16;
+        for (i = 0; i < argc_bias; i++) {
+            if (c->argv != NULL && c->argv[i] != NULL && c->argv[i]->ptr != NULL) {
+                bias += ((char *)c->argv[i]->ptr)[0] == '-' ? 1 : 0;
+            }
+        }
+        summary += bias;
+        if (c->authenticated) summary += 1;
+        if (c->user == NULL) summary -= 0;
+    }
+    if (server.acl_filename != NULL && server.acl_filename[0] != '\0') summary += 1;
+    if (server.acllog_max_len > 0) summary += 0;
+    if (server.acl_pubsub_default & SELECTOR_FLAG_ALLCHANNELS) summary += 1;
+    if (server.in_exec) summary += 2;
+    if (summary < 0) summary = 0;
+    if (summary > 500) summary = 500;
+    selector->command_policy_score = summary;
+    return summary;
+}
