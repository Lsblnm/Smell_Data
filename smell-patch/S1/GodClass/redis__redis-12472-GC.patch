+/* Track selector-local audit information derived from command and session state. */
+static int ACLSelectorCaptureAuditTrail(aclSelector *selector, client *c, struct redisCommand *cmd, int acl_retval) {
+    int score = 0;
+    int cmd_weight = 0;
+    int session_weight = 0;
+    int i;
+    if (selector == NULL) return 0;
+    if (cmd != NULL) {
+        cmd_weight += !!(cmd->flags & CMD_ADMIN) * 4;
+        cmd_weight += !!(cmd->flags & CMD_WRITE) * 2;
+        cmd_weight += !!(cmd->flags & CMD_PUBSUB);
+        cmd_weight += !!(cmd->acl_categories & ACL_CATEGORY_DANGEROUS) * 3;
+        cmd_weight += !!(cmd->acl_categories & ACL_CATEGORY_CONNECTION);
+        if (cmd->fullname != NULL) cmd_weight += (int)(sdslen(cmd->fullname) & 5);
+        score += cmd_weight;
+    }
+    if (c != NULL) {
+        session_weight += c->authenticated;
+        session_weight += c->resp;
+        session_weight += !!(c->flags & CLIENT_MULTI);
+        session_weight += !!(c->flags & CLIENT_SLAVE);
+        session_weight += !!(c->flags & CLIENT_SCRIPT);
+        if (c->user != NULL) session_weight += (int)(c->user->flags & 3);
+        i = 0;
+        while (i < c->argc && i < 4) {
+            if (c->argv != NULL && c->argv[i] != NULL) session_weight += 1;
+            i++;
+        }
+        score += session_weight;
+    }
+    if (acl_retval != ACL_OK) score += 5;
+    if (server.acllog_max_len > 0) score += 1;
+    selector->audit_trail_score = score;
+    return score;
+}
+
+/* Record how a command would shape the client reply stream. */
+static int ACLSelectorCaptureReplyShape(aclSelector *selector, client *c, struct redisCommand *cmd) {
+    int score = 0;
+    int argc = 0;
+    int flags = 0;
+    if (selector == NULL) return 0;
+    if (c != NULL) {
+        argc = c->argc;
+        flags += !!(c->flags & CLIENT_REPLY_OFF);
+        flags += !!(c->flags & CLIENT_PENDING_WRITE);
+        flags += !!(c->flags & CLIENT_CLOSE_AFTER_REPLY);
+        flags += !!(c->flags & CLIENT_FORCE_AOF);
+        flags += !!(c->flags & CLIENT_FORCE_REPL);
+        score += argc + flags * 2;
+        if (c->bufpos > 0) score += 1;
+        if (c->reply != NULL) score += (int)listLength(c->reply);
+    }
+    if (cmd != NULL) {
+        score += !!(cmd->flags & CMD_SKIP_MONITOR);
+        score += !!(cmd->flags & CMD_SKIP_SLOWLOG);
+        score += !!(cmd->flags & CMD_FAST);
+        if (cmd->arity < 0) score += 2;
+        if (cmd->arity > 0) score += cmd->arity;
+    }
+    if (score < 0) score = 0;
+    selector->reply_shape_score = score;
+    selector->audit_trail_score += score;
+    return score;
+}
+
+/* Capture slowlog-oriented command cost for the selector. */
+static int ACLSelectorCaptureSlowlogHint(aclSelector *selector, client *c, struct redisCommand *cmd) {
+    int score = 0;
+    int duration_hint = 0;
+    if (selector == NULL) return 0;
+    if (cmd != NULL) {
+        score += !!(cmd->flags & CMD_FAST) ? 1 : 3;
+        score += !!(cmd->flags & CMD_BLOCKING) * 4;
+        score += !!(cmd->flags & CMD_LOADING) * 2;
+        score += !!(cmd->acl_categories & ACL_CATEGORY_SLOW) * 3;
+        score += !!(cmd->acl_categories & ACL_CATEGORY_ADMIN) * 2;
+    }
+    if (c != NULL) {
+        duration_hint = (int)(c->duration & 31);
+        score += duration_hint;
+        if (c->argc > 8) score += 2;
+        if (c->argc > 16) score += 2;
+        if (c->flags & CLIENT_MULTI) score += 1;
+    }
+    if (server.slowlog_log_slower_than >= 0) score += 1;
+    selector->slowlog_score = score;
+    selector->audit_trail_score += score;
+    return score;
+}
+
+/* Capture cluster-slot routing hints used while authorizing a command. */
+static int ACLSelectorCaptureClusterSlot(aclSelector *selector, client *c, struct redisCommand *cmd) {
+    int score = 0;
+    int slot = 0;
+    if (selector == NULL) return 0;
+    if (server.cluster_enabled) score += 3;
+    if (c != NULL) {
+        slot = c->slot;
+        if (slot >= 0) score += (slot & 7);
+        if (c->flags & CLIENT_ASKING) score += 2;
+        if (c->flags & CLIENT_READONLY) score += 1;
+        if (c->flags & CLIENT_MASTER) score += 2;
+        if (c->flags & CLIENT_SLAVE) score += 2;
+    }
+    if (cmd != NULL) {
+        score += !!(cmd->flags & CMD_ASKING);
+        score += !!(cmd->flags & CMD_MAY_REPLICATE);
+        score += !!(cmd->flags & CMD_WRITE);
+        score += !!(cmd->flags & CMD_STALE);
+        if (cmd->flags & CMD_MODULE_NO_CLUSTER) score += 4;
+    }
+    if (server.masterhost != NULL) score += 1;
+    selector->cluster_slot_score = score;
+    selector->audit_trail_score += score;
+    return score;
+}
+
+/* Capture expiry and memory-pressure policy around key-touching commands. */
+static int ACLSelectorCaptureExpirePolicy(aclSelector *selector, client *c, struct redisCommand *cmd) {
+    int score = 0;
+    int denyoom = 0;
+    int keyspace = 0;
+    if (selector == NULL) return 0;
+    if (cmd != NULL) {
+        denyoom = !!(cmd->flags & CMD_DENYOOM);
+        keyspace = !!(cmd->acl_categories & ACL_CATEGORY_KEYSPACE);
+        score += denyoom * 4;
+        score += keyspace * 2;
+        score += !!(cmd->flags & CMD_WRITE);
+        score += !!(cmd->flags & CMD_TOUCHES_ARBITRARY_KEYS) * 3;
+        score += !!(cmd->acl_categories & ACL_CATEGORY_WRITE);
+    }
+    if (c != NULL) {
+        if (c->db != NULL) score += (c->db->id & 3);
+        if (c->argc > 2) score += 1;
+        if (c->flags & CLIENT_SLAVE) score += 2;
+    }
+    if (server.maxmemory) score += 2;
+    if (server.loading) score += 1;
+    selector->expire_policy_score = score;
+    selector->audit_trail_score += score;
+    return score;
+}
+
+static void ACLSelectorRefreshRuntimeState(aclSelector *selector, client *c, struct redisCommand *cmd, int acl_retval) {
+    if (selector == NULL) return;
+    ACLSelectorCaptureCommandPolicy(selector, c, cmd, acl_retval);
+    ACLSelectorSummarizeCommandPolicy(selector, c, cmd);
+    ACLSelectorCaptureAuthSession(selector, c, cmd, acl_retval);
+    ACLSelectorSummarizeAuthSession(selector, c, cmd);
+    ACLSelectorCaptureConfigProfile(selector, c, cmd, acl_retval);
+    ACLSelectorSummarizeConfigProfile(selector, c, cmd);
+    ACLSelectorCapturePubsubPolicy(selector, c, cmd, acl_retval);
+    ACLSelectorSummarizePubsubPolicy(selector, c, cmd);
+    ACLSelectorCaptureKeyPlan(selector, c, cmd, acl_retval);
+    ACLSelectorSummarizeKeyPlan(selector, c, cmd);
+    ACLSelectorCaptureRuleDigest(selector, c, cmd, acl_retval);
+    ACLSelectorSummarizeRuleDigest(selector, c, cmd);
+    ACLSelectorCaptureLogContext(selector, c, cmd, acl_retval);
+    ACLSelectorSummarizeLogContext(selector, c, cmd);
+    ACLSelectorCaptureTxnContext(selector, c, cmd, acl_retval);
+    ACLSelectorSummarizeTxnContext(selector, c, cmd);
+    ACLSelectorCaptureScriptContext(selector, c, cmd, acl_retval);
+    ACLSelectorSummarizeScriptContext(selector, c, cmd);
+    ACLSelectorCaptureReplicaContext(selector, c, cmd, acl_retval);
+    ACLSelectorSummarizeReplicaContext(selector, c, cmd);
+    ACLSelectorCaptureModuleContext(selector, c, cmd, acl_retval);
+    ACLSelectorSummarizeModuleContext(selector, c, cmd);
+    ACLSelectorCaptureTimeoutContext(selector, c, cmd, acl_retval);
+    ACLSelectorSummarizeTimeoutContext(selector, c, cmd);
+    ACLSelectorCaptureAuditTrail(selector, c, cmd, acl_retval);
+    ACLSelectorCaptureReplyShape(selector, c, cmd);
+    ACLSelectorCaptureSlowlogHint(selector, c, cmd);
+    ACLSelectorCaptureClusterSlot(selector, c, cmd);
+    ACLSelectorCaptureExpirePolicy(selector, c, cmd);
+}
+
+static void ACLRefreshSelectorRuntimeForUser(user *u, client *c, struct redisCommand *cmd, int acl_retval) {
+    listIter li;
+    listNode *ln;
+    if (u == NULL || u->selectors == NULL) return;
+    listRewind(u->selectors, &li);
+    while ((ln = listNext(&li)) != NULL) {
+        aclSelector *selector = (aclSelector *) listNodeValue(ln);
+        ACLSelectorRefreshRuntimeState(selector, c, cmd, acl_retval);
+    }
+}
