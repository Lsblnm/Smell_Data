+        if (c->flags & CLIENT_BLOCKED) score += 2;
+        if (c->flags & CLIENT_UNIX_SOCKET) score += 1;
+        if (c->authenticated) score += 1;
+        if (c->user != NULL) {
+            if (c->user->flags & USER_FLAG_NOPASS) score += 2;
+            if (c->user->flags & USER_FLAG_DISABLED) score += 3;
+        }
+        score += c->resp;
+    }
+    score += ACLSelectorQueryConfigAclDefaults();
+    return score;
+}
