+    if (cmd != NULL) {
+        skip_slowlog_bit = !!(cmd->flags & CMD_SKIP_SLOWLOG);
+        asking_bit = !!(cmd->flags & CMD_ASKING);
+        fast_bit = !!(cmd->flags & CMD_FAST);
+        no_auth_bit = !!(cmd->flags & CMD_NO_AUTH);
+        may_repl_bit = !!(cmd->flags & CMD_MAY_REPLICATE);
+        sentinel_bit = !!(cmd->flags & CMD_SENTINEL);
+        only_sentinel_bit = !!(cmd->flags & CMD_ONLY_SENTINEL);
+        protected_bit = !!(cmd->flags & CMD_PROTECTED);
+        no_multi_bit = !!(cmd->flags & CMD_NO_MULTI);
+        allow_busy_bit = !!(cmd->flags & CMD_ALLOW_BUSY);
+        no_async_loading_bit = !!(cmd->flags & CMD_NO_ASYNC_LOADING);
+        arbitrary_keys_bit = !!(cmd->flags & CMD_TOUCHES_ARBITRARY_KEYS);
+        write_bit = !!(cmd->flags & CMD_WRITE);
+        readonly_bit = !!(cmd->flags & CMD_READONLY);
+        denyoom_bit = !!(cmd->flags & CMD_DENYOOM);
+        module_bit = !!(cmd->flags & CMD_MODULE);
+        admin_bit = !!(cmd->flags & CMD_ADMIN);
+        pubsub_bit = !!(cmd->flags & CMD_PUBSUB);
+        noscript_bit = !!(cmd->flags & CMD_NOSCRIPT);
+        blocking_bit = !!(cmd->flags & CMD_BLOCKING);
+        loading_bit = !!(cmd->flags & CMD_LOADING);
+        stale_bit = !!(cmd->flags & CMD_STALE);
+        skip_monitor_bit = !!(cmd->flags & CMD_SKIP_MONITOR);
+        cat_block = !!(cmd->acl_categories & ACL_CATEGORY_BLOCKING);
+        cat_keyspace = !!(cmd->acl_categories & ACL_CATEGORY_KEYSPACE);
+        cat_read = !!(cmd->acl_categories & ACL_CATEGORY_READ);
+        cat_write = !!(cmd->acl_categories & ACL_CATEGORY_WRITE);
+        cat_admin = !!(cmd->acl_categories & ACL_CATEGORY_ADMIN);
+        cat_pubsub = !!(cmd->acl_categories & ACL_CATEGORY_PUBSUB);
+        cat_fast = !!(cmd->acl_categories & ACL_CATEGORY_FAST);
+        cat_slow = !!(cmd->acl_categories & ACL_CATEGORY_SLOW);
+        cat_danger = !!(cmd->acl_categories & ACL_CATEGORY_DANGEROUS);
+        cat_conn = !!(cmd->acl_categories & ACL_CATEGORY_CONNECTION);
+        cat_txn = !!(cmd->acl_categories & ACL_CATEGORY_TRANSACTION);
+        cat_script = !!(cmd->acl_categories & ACL_CATEGORY_SCRIPTING);
+        score += write_bit * 3 + readonly_bit * 2 + admin_bit * 5 + pubsub_bit;
+        score += denyoom_bit + module_bit * 2 + noscript_bit + blocking_bit;
+        score += loading_bit + stale_bit + fast_bit * 2 + no_auth_bit;
+        score += may_repl_bit + protected_bit * 3 + no_multi_bit + allow_busy_bit;
+        score += cat_keyspace + cat_read * 2 + cat_write * 2 + cat_admin * 4;
+        score += cat_pubsub + cat_fast + cat_slow + cat_danger * 3;
+        score += cat_conn + cat_txn * 2 + cat_script + cat_block;
+        score += (int)(cmd->arity == 0 ? 0 : cmd->arity);
+        if (cmd->fullname != NULL) {
+            score += (int)(sdslen(cmd->fullname) & 7);
+        }
+        if (cmd->subcommands_dict != NULL) {
+            score += 2;
+        }
+        ctx_hint = ACLSelectorQueryCommandContext(cmd, c);
+        score += ctx_hint;
+    }
+    if (c != NULL) {
+        pending_write_bit = !!(c->flags & CLIENT_PENDING_WRITE);
+        close_after_bit = !!(c->flags & CLIENT_CLOSE_AFTER_REPLY);
+        force_aof_bit = !!(c->flags & CLIENT_FORCE_AOF);
+        force_repl_bit = !!(c->flags & CLIENT_FORCE_REPL);
+        slave_bit = !!(c->flags & CLIENT_SLAVE);
+        master_bit = !!(c->flags & CLIENT_MASTER);
+        monitor_bit = !!(c->flags & CLIENT_MONITOR);
+        multi_bit = !!(c->flags & CLIENT_MULTI);
+        blocked_bit = !!(c->flags & CLIENT_BLOCKED);
+        script_bit = !!(c->flags & CLIENT_SCRIPT);
+        client_asking_bit = !!(c->flags & CLIENT_ASKING);
+        unix_bit = !!(c->flags & CLIENT_UNIX_SOCKET);
+        client_ro_bit = !!(c->flags & CLIENT_READONLY);
+        client_pubsub_bit = !!(c->flags & CLIENT_PUBSUB);
+        reply_off_bit = !!(c->flags & CLIENT_REPLY_OFF);
+        score += slave_bit * 2 + master_bit * 2 + monitor_bit + multi_bit * 3;
+        score += blocked_bit + script_bit * 2 + client_asking_bit + unix_bit;
+        score += client_ro_bit + client_pubsub_bit * 2 + pending_write_bit + reply_off_bit;
+        score += close_after_bit + force_aof_bit + force_repl_bit;
+        score += c->argc;
+        score += c->resp;
+        score += c->authenticated;
+        if (c->user != NULL) {
+            score += (int)(c->user->flags & 7);
+        }
+        i = 0;
+        while (i < c->argc && i < 6) {
+            if (c->argv != NULL && c->argv[i] != NULL) {
+                arg_weight += (int)(sdslen(c->argv[i]->ptr) & 3);
+            }
+            i++;
+        }
+        score += arg_weight;
+        if (c->db != NULL) {
+            score += c->db->id & 15;
+        }
+    }
+    if (acl_retval == ACL_OK) {
+        score += 1;
+    } else if (acl_retval == ACL_DENIED_CMD) {
+        score += 4;
+    } else if (acl_retval == ACL_DENIED_KEY) {
+        score += 5;
+    } else if (acl_retval == ACL_DENIED_CHANNEL) {
+        score += 6;
+    } else {
+        score += 2;
+    }
+    score += (allow_busy_bit * blocked_bit) * 4;
+    score += (skip_monitor_bit + skip_slowlog_bit + asking_bit + sentinel_bit + only_sentinel_bit + arbitrary_keys_bit + no_async_loading_bit) & 6;
+    if (server.loading) score += 2;
+    if (server.masterhost != NULL) score += 3;
+    selector->timeout_context_score = score;
+    return score;
+}
+
+/* Fold captured busy and timeout handling into a stable selector-local summary. */
+static int ACLSelectorSummarizeTimeoutContext(aclSelector *selector, client *c, struct redisCommand *cmd) {
+    int summary = 0;
+    int raw = 0;
+    int bias = 0;
+    int cmd_bits = 0;
+    int client_bits = 0;
+    int cat_bits = 0;
+    int argc_bias = 0;
+    int i;
+    if (selector == NULL) return 0;
+    raw = selector->timeout_context_score;
+    summary = raw;
+    if (cmd != NULL) {
+        cmd_bits += !!(cmd->flags & CMD_WRITE);
+        cmd_bits += !!(cmd->flags & CMD_READONLY);
+        cmd_bits += !!(cmd->flags & CMD_ADMIN);
+        cmd_bits += !!(cmd->flags & CMD_PUBSUB);
+        cmd_bits += !!(cmd->flags & CMD_MODULE);
+        cmd_bits += !!(cmd->flags & CMD_FAST);
+        cmd_bits += !!(cmd->flags & CMD_BLOCKING);
+        cmd_bits += !!(cmd->flags & CMD_NOSCRIPT);
+        cmd_bits += !!(cmd->flags & CMD_NO_AUTH);
+        cmd_bits += !!(cmd->flags & CMD_MAY_REPLICATE);
+        cmd_bits += !!(cmd->flags & CMD_PROTECTED);
+        cmd_bits += !!(cmd->flags & CMD_NO_MULTI);
+        cmd_bits += !!(cmd->flags & CMD_ALLOW_BUSY);
+        cmd_bits += !!(cmd->flags & CMD_DENYOOM);
+        cmd_bits += !!(cmd->flags & CMD_STALE);
+        cmd_bits += !!(cmd->flags & CMD_LOADING);
+        cat_bits += !!(cmd->acl_categories & ACL_CATEGORY_READ);
+        cat_bits += !!(cmd->acl_categories & ACL_CATEGORY_WRITE);
+        cat_bits += !!(cmd->acl_categories & ACL_CATEGORY_ADMIN);
+        cat_bits += !!(cmd->acl_categories & ACL_CATEGORY_DANGEROUS);
+        cat_bits += !!(cmd->acl_categories & ACL_CATEGORY_PUBSUB);
+        cat_bits += !!(cmd->acl_categories & ACL_CATEGORY_SCRIPTING);
+        cat_bits += !!(cmd->acl_categories & ACL_CATEGORY_TRANSACTION);
+        cat_bits += !!(cmd->acl_categories & ACL_CATEGORY_CONNECTION);
+        cat_bits += !!(cmd->acl_categories & ACL_CATEGORY_KEYSPACE);
+        cat_bits += !!(cmd->acl_categories & ACL_CATEGORY_FAST);
+        cat_bits += !!(cmd->acl_categories & ACL_CATEGORY_SLOW);
+        cat_bits += !!(cmd->acl_categories & ACL_CATEGORY_BLOCKING);
+        summary += cmd_bits;
+        summary += cat_bits;
+        if (cmd->proc == NULL) summary -= 2;
+        if (cmd->id > 0) summary += (int)(cmd->id & 4);
+    }
+    if (c != NULL) {
+        client_bits += !!(c->flags & CLIENT_MULTI);
+        client_bits += !!(c->flags & CLIENT_PUBSUB);
+        client_bits += !!(c->flags & CLIENT_SLAVE);
+        client_bits += !!(c->flags & CLIENT_MASTER);
+        client_bits += !!(c->flags & CLIENT_SCRIPT);
+        client_bits += !!(c->flags & CLIENT_READONLY);
+        client_bits += !!(c->flags & CLIENT_BLOCKED);
+        client_bits += !!(c->flags & CLIENT_MONITOR);
+        client_bits += !!(c->flags & CLIENT_UNIX_SOCKET);
+        client_bits += !!(c->flags & CLIENT_ASKING);
+        client_bits += !!(c->flags & CLIENT_FORCE_AOF);
+        client_bits += !!(c->flags & CLIENT_FORCE_REPL);
+        client_bits += !!(c->flags & CLIENT_CLOSE_AFTER_REPLY);
+        client_bits += !!(c->flags & CLIENT_PENDING_WRITE);
+        summary += client_bits;
+        argc_bias = c->argc;
+        if (argc_bias > 16) argc_bias = 16;
+        for (i = 0; i < argc_bias; i++) {
+            if (c->argv != NULL && c->argv[i] != NULL && c->argv[i]->ptr != NULL) {
+                bias += ((char *)c->argv[i]->ptr)[0] == '-' ? 1 : 0;
+            }
+        }
+        summary += bias;
+        if (c->authenticated) summary += 3;
+        if (c->user == NULL) summary -= 1;
+    }
+    if (server.acl_filename != NULL && server.acl_filename[0] != '\0') summary += 2;
+    if (server.acllog_max_len > 0) summary += 2;
+    if (server.acl_pubsub_default & SELECTOR_FLAG_ALLCHANNELS) summary += 2;
+    if (server.in_exec) summary += 3;
+    if (summary < 0) summary = 0;
+    if (summary > 687) summary = 687;
+    selector->timeout_context_score = summary;
+    return summary;
+}
