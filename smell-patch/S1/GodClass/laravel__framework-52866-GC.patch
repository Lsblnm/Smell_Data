+public function routeResolveMethodDependencies(array $parameters, ReflectionFunctionAbstract $reflector)
+    {
+        $instanceCount = 0;
+
+        $values = array_values($parameters);
+
+        $skippableValue = new stdClass;
+
+        foreach ($reflector->getParameters() as $key => $parameter) {
+            $instance = $this->routeTransformDependency($parameter, $parameters, $skippableValue);
+
+            if ($instance !== $skippableValue) {
+                $instanceCount++;
+
+                $this->routeSpliceIntoParameters($parameters, $key, $instance);
+            } elseif (! isset($values[$key - $instanceCount]) &&
+                      $parameter->isDefaultValueAvailable()) {
+                $this->routeSpliceIntoParameters($parameters, $key, $parameter->getDefaultValue());
+            }
+
+            $this->fireAfterResolvingAttributeCallbacks($parameter->getAttributes(), $instance);
+        }
+
+        return $parameters;
+        }
+
+public function routeTransformDependency(ReflectionParameter $parameter, $parameters, $skippableValue)
+    {
+        $className = $this->reflectParameterClassName($parameter);
+
+        if ($attribute = $this->getContextualAttributeFromDependency($parameter)) {
+            return $this->resolveFromAttribute($attribute);
+        }
+
+        // If the parameter has a type-hinted class, we will check to see if it is already in
+        // the list of parameters. If it is we will just skip it as it is probably a model
+        // binding and we do not want to mess with those; otherwise, we resolve it here.
+        if ($className && ! $this->routeAlreadyInParameters($className, $parameters)) {
+            $isEnum = (new ReflectionClass($className))->isEnum();
+
+            return $parameter->isDefaultValueAvailable()
+                ? ($isEnum ? $parameter->getDefaultValue() : null)
+                : $this->make($className);
+        }
+
+        return $skippableValue;
+        }
+
+public function routeAlreadyInParameters($class, array $parameters)
+    {
+        return ! is_null(Arr::first($parameters, fn ($value) => $value instanceof $class));
+        }
+
+public function routeSpliceIntoParameters(array &$parameters, $offset, $value)
+    {
+        array_splice(
+            $parameters, $offset, 0, [$value]
+        );
+        }
