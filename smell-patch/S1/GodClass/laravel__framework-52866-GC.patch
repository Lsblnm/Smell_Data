+public function routeResolveClassMethodDependencies(array $parameters, $instance, $method)
+    {
+        if (! method_exists($instance, $method)) {
+            return $parameters;
+        }
+
+        return $this->routeResolveMethodDependencies(
+            $parameters, new ReflectionMethod($instance, $method)
+        );
+        }
