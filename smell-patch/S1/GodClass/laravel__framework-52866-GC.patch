+public function executeBoundCallback($callback, array $parameters = [], $defaultMethod = null)
+    {
+        if (is_string($callback) && ! $defaultMethod && method_exists($callback, '__invoke')) {
+            $defaultMethod = '__invoke';
+        }
+
+        if ($this->isBoundCallbackWithAtSign($callback) || $defaultMethod) {
+            return $this->executeBoundClass($callback, $parameters, $defaultMethod);
+        }
+
+        return $this->executeRegisteredBoundMethod($callback, function () use ($callback, $parameters) {
+            return $callback(...array_values($this->getBoundMethodDependencies($callback, $parameters)));
+        });
+    }
+
+    protected function executeBoundClass($target, array $parameters = [], $defaultMethod = null)
+    {
+        $segments = explode('@', $target);
+
+        $method = count($segments) === 2
+                        ? $segments[1] : $defaultMethod;
+
+        if (is_null($method)) {
+            throw new InvalidArgumentException('Method not provided.');
+        }
+
+        return $this->executeBoundCallback(
+            [$this->make($segments[0]), $method],
+            $parameters
+        );
+    }
+
+    protected function executeRegisteredBoundMethod($callback, $default)
+    {
+        if (! is_array($callback)) {
+            return $this->unwrapIfClosure($default);
+        }
+
+        $method = $this->normalizeBoundMethodName($callback);
+
+        if ($this->hasMethodBinding($method)) {
+            return $this->callMethodBinding($method, $callback[0]);
+        }
+
+        return $this->unwrapIfClosure($default);
+    }
+
+    protected function normalizeBoundMethodName($callback)
+    {
+        $class = is_string($callback[0]) ? $callback[0] : get_class($callback[0]);
+
+        return "{$class}@{$callback[1]}";
+    }
+
+    protected function getBoundMethodDependencies($callback, array $parameters = [])
+    {
+        $dependencies = [];
+
+        foreach ($this->getBoundCallReflector($callback)->getParameters() as $parameter) {
+            $this->addBoundCallDependency($parameter, $parameters, $dependencies);
+        }
+
+        return array_merge($dependencies, array_values($parameters));
+    }
+
+    protected function getBoundCallReflector($callback)
+    {
+        if (is_string($callback) && str_contains($callback, '::')) {
+            $callback = explode('::', $callback);
+        } elseif (is_object($callback) && ! $callback instanceof Closure) {
+            $callback = [$callback, '__invoke'];
+        }
+
+        return is_array($callback)
+                        ? new ReflectionMethod($callback[0], $callback[1])
+                        : new ReflectionFunction($callback);
+    }
+
+    protected function addBoundCallDependency($parameter, array &$parameters, &$dependencies)
+    {
+        $pendingDependencies = [];
+
+        if (array_key_exists($paramName = $parameter->getName(), $parameters)) {
+            $pendingDependencies[] = $parameters[$paramName];
+
+            unset($parameters[$paramName]);
+        } elseif ($attribute = $this->getContextualAttributeFromDependency($parameter)) {
+            $pendingDependencies[] = $this->resolveFromAttribute($attribute);
+        } elseif (! is_null($className = $this->getParameterClassName($parameter))) {
+            if (array_key_exists($className, $parameters)) {
+                $pendingDependencies[] = $parameters[$className];
+
+                unset($parameters[$className]);
+            } elseif ($parameter->isVariadic()) {
+                $variadicDependencies = $this->make($className);
+
+                $pendingDependencies = array_merge($pendingDependencies, is_array($variadicDependencies)
+                            ? $variadicDependencies
+                            : [$variadicDependencies]);
+            } else {
+                $pendingDependencies[] = $this->make($className);
+            }
+        } elseif ($parameter->isDefaultValueAvailable()) {
+            $pendingDependencies[] = $parameter->getDefaultValue();
+        } elseif (! $parameter->isOptional() && ! array_key_exists($paramName, $parameters)) {
+            $message = "Unable to resolve dependency [{$parameter}] in class {$parameter->getDeclaringClass()->getName()}";
+
+            throw new BindingResolutionException($message);
+        }
+
+        foreach ($pendingDependencies as $dependency) {
+            $this->fireAfterResolvingAttributeCallbacks($parameter->getAttributes(), $dependency);
+        }
+
+        $dependencies = array_merge($dependencies, $pendingDependencies);
+    }
+
+    protected function isBoundCallbackWithAtSign($callback)
+    {
+        return is_string($callback) && str_contains($callback, '@');
+    }
+
+    public function wrapValueAsArray($value)
+    {
+        if (is_null($value)) {
+            return [];
+        }
+
+        return is_array($value) ? $value : [$value];
+        }
+
+public function unwrapIfClosure($value, ...$args)
+    {
+        return $value instanceof Closure ? $value(...$args) : $value;
+        }
+
+public function getParameterClassName($parameter)
+    {
+        $type = $parameter->getType();
+
+        if (! $type instanceof ReflectionNamedType || $type->isBuiltin()) {
+            return null;
+        }
+
+        $name = $type->getName();
+
+        if (! is_null($class = $parameter->getDeclaringClass())) {
+            if ($name === 'self') {
+                return $class->getName();
+            }
+
+            if ($name === 'parent' && $parent = $class->getParentClass()) {
+                return $parent->getName();
+            }
+        }
+
+        return $name;
+        }
+
+public function getContextualAttributeFromDependency($dependency)
+    {
+        return $dependency->getAttributes(ContextualAttribute::class, ReflectionAttribute::IS_INSTANCEOF)[0] ?? null;
+        }
+
+public function inspectCallable($var, $syntaxOnly = false)
+    {
+        if (! is_array($var)) {
+            return is_callable($var, $syntaxOnly);
+        }
+
+        if (! isset($var[0], $var[1]) || ! is_string($var[1] ?? null)) {
+            return false;
+        }
+
+        if ($syntaxOnly &&
+            (is_string($var[0]) || is_object($var[0])) &&
+            is_string($var[1])) {
+            return true;
+        }
+
+        $class = is_object($var[0]) ? get_class($var[0]) : $var[0];
+
+        $method = $var[1];
+
+        if (! class_exists($class)) {
+            return false;
+        }
+
+        if (method_exists($class, $method)) {
+            return (new ReflectionMethod($class, $method))->isPublic();
+        }
+
+        if (is_object($var[0]) && method_exists($class, '__call')) {
+            return (new ReflectionMethod($class, '__call'))->isPublic();
+        }
+
+        if (! is_object($var[0]) && method_exists($class, '__callStatic')) {
+            return (new ReflectionMethod($class, '__callStatic'))->isPublic();
+        }
+
+        return false;
+        }
+
+public function reflectParameterClassName($parameter)
+    {
+        $type = $parameter->getType();
+
+        if (! $type instanceof ReflectionNamedType || $type->isBuiltin()) {
+            return;
+        }
+
+        return $this->reflectTypeName($parameter, $type);
+        }
+
+public function reflectParameterClassNames($parameter)
+    {
+        $type = $parameter->getType();
+
+        if (! $type instanceof ReflectionUnionType) {
+            return array_filter([$this->reflectParameterClassName($parameter)]);
+        }
+
+        $unionTypes = [];
+
+        foreach ($type->getTypes() as $listedType) {
+            if (! $listedType instanceof ReflectionNamedType || $listedType->isBuiltin()) {
+                continue;
+            }
+
+            $unionTypes[] = $this->reflectTypeName($parameter, $listedType);
+        }
+
+        return array_filter($unionTypes);
+        }
+
+protected function reflectTypeName($parameter, $type)
+    {
+        $name = $type->getName();
+
+        if (! is_null($class = $parameter->getDeclaringClass())) {
+            if ($name === 'self') {
+                return $class->getName();
+            }
+
+            if ($name === 'parent' && $parent = $class->getParentClass()) {
+                return $parent->getName();
+            }
+        }
+
+        return $name;
+        }
+
+public function reflectParameterSubclassOf($parameter, $className)
+    {
+        $paramClassName = $this->reflectParameterClassName($parameter);
+
+        return $paramClassName
+            && (class_exists($paramClassName) || interface_exists($paramClassName))
+            && (new ReflectionClass($paramClassName))->isSubclassOf($className);
+        }
+
+public function reflectParameterBackedEnumWithStringBackingType($parameter)
+    {
+        if (! $parameter->getType() instanceof ReflectionNamedType) {
+            return false;
+        }
+
+        $backedEnumClass = $parameter->getType()?->getName();
+
+        if (is_null($backedEnumClass)) {
+            return false;
+        }
+
+        if (enum_exists($backedEnumClass)) {
+            $reflectionBackedEnum = new ReflectionEnum($backedEnumClass);
+
+            return $reflectionBackedEnum->isBacked()
+                && $reflectionBackedEnum->getBackingType()->getName() == 'string';
+        }
+
+        return false;
+        }
