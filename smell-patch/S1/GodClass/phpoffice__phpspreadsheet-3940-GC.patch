+            $this->builtInFormats[0] = NumberFormat::FORMAT_GENERAL;
+            $this->builtInFormats[1] = '0';
+            $this->builtInFormats[2] = '0.00';
+            $this->builtInFormats[3] = '#,##0';
+            $this->builtInFormats[4] = '#,##0.00';
+
+            $this->builtInFormats[9] = '0%';
+            $this->builtInFormats[10] = '0.00%';
+            $this->builtInFormats[11] = '0.00E+00';
+            $this->builtInFormats[12] = '# ?/?';
+            $this->builtInFormats[13] = '# ??/??';
+            $this->builtInFormats[14] = NumberFormat::FORMAT_DATE_XLSX14_ACTUAL; // Despite ECMA 'mm-dd-yy';
+            $this->builtInFormats[15] = NumberFormat::FORMAT_DATE_XLSX15;
+            $this->builtInFormats[16] = 'd-mmm';
+            $this->builtInFormats[17] = 'mmm-yy';
+            $this->builtInFormats[18] = 'h:mm AM/PM';
+            $this->builtInFormats[19] = 'h:mm:ss AM/PM';
+            $this->builtInFormats[20] = 'h:mm';
+            $this->builtInFormats[21] = 'h:mm:ss';
+            $this->builtInFormats[22] = NumberFormat::FORMAT_DATE_XLSX22_ACTUAL; // Despite ECMA 'm/d/yy h:mm';
