+    public function calculateTopTenValue(string $columnID, int $startRow, int $endRow, ?string $ruleType, mixed $ruleValue, ?Worksheet $workSheet = null): mixed {
+        $this->filterEvaluationDataSet['column'] = $columnID;
+        $this->mutatingWorksheet = $workSheet;
+
+        $range = $columnID . $startRow . ':' . $columnID . $endRow;
+        $retVal = null;
+        if ($workSheet !== null) {
+            $dataValues = Functions::flattenArray($workSheet->rangeToArray($range, null, true, false));
+            $dataValues = array_filter($dataValues);
+
+            if ($ruleType == 'top') {
+                rsort($dataValues);
+            } else {
+                sort($dataValues);
+            }
+
+            $slice = array_slice($dataValues, 0, $ruleValue);
+
+            $retVal = array_pop($slice);
+        }
+
+        return $retVal;
+    }
