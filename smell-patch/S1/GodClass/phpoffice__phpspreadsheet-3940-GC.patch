+    public function dynamicFilterDateRange(string $dynamicRuleType, mixed &$filterColumn): array {
+        $this->filterDateGroupingSet['rule'] = $dynamicRuleType;
+
+        $ruleValues = [];
+        $callBack = [$this, $this->dynamicDateFunctions()[$dynamicRuleType]]; // What if not found?
+        //    Calculate start/end dates for the required date range based on current date
+        //    Val is lowest permitted value.
+        //    Maxval is greater than highest permitted value
+        $val = $maxval = 0;
+        if (is_callable($callBack)) {
+            [$val, $maxval] = $callBack();
+        }
+        $val = $this->dateTimeToExcel($val);
+        $maxval = $this->dateTimeToExcel($maxval);
+
+        //    Set the filter column rule attributes ready for writing
+        $filterColumn->setAttributes(['val' => $val, 'maxVal' => $maxval]);
+
+        //    Set the rules for identifying rows for hide/show
+        $ruleValues[] = ['operator' => 'greaterThanOrEqual', 'value' => $val];
+        $ruleValues[] = ['operator' => 'lessThan', 'value' => $maxval];
+
+        return ['method' => 'filterTestInCustomDataSet', 'arguments' => ['filterRules' => $ruleValues, 'join' => 'and']];
+    }
