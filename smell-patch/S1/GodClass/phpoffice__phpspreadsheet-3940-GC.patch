+    public function filterTestInPeriodDateSet(mixed $cellValue, array $monthSet): bool {
+        $this->filterEvaluationCellValue = $cellValue;
+        $this->filterDateGroupingSet = $monthSet;
+        //    Blank cells are always ignored, so return a FALSE
+        if (($cellValue == '') || ($cellValue === null)) {
+            return false;
+        }
+
+        if (is_numeric($cellValue)) {
+            $dateObject = $this->excelToDateTimeObject((float) $cellValue, new DateTimeZone('UTC'));
+            $dateValue = (int) $dateObject->format('m');
+            if (in_array($dateValue, $monthSet)) {
+                return true;
+            }
+        }
+
+        return false;
+    }
