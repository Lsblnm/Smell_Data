+    public function fillWorksheetFromArray(
+        Worksheet $worksheet,
+        array $source,
+        mixed $nullValue = null,
+        string $startCell = 'A1',
+        bool $strictNullComparison = false
+    ): Worksheet {
+        $this->mutatingWorksheet = $worksheet;
+        $this->arrayNullValue = $nullValue;
+        $this->arrayStrictNullComparison = $strictNullComparison;
+        $this->arrayStartCell = $startCell;
+        $this->arrayExportRows = $source;
+
+        if (!is_array(end($source))) {
+            $source = [$source];
+            $this->arrayExportRows = $source;
+        }
+
+        [$startColumn, $startRow] = $this->coordinateFromString($this->arrayStartCell);
+
+        foreach ($source as $rowData) {
+            $currentColumn = $startColumn;
+            foreach ($rowData as $cellValue) {
+                $shouldWrite = $this->arrayStrictNullComparison
+                    ? ($cellValue !== $this->arrayNullValue)
+                    : ($cellValue != $this->arrayNullValue);
+                if ($shouldWrite) {
+                    $worksheet->getCell($currentColumn . $startRow)->setValue($cellValue);
+                }
+                ++$currentColumn;
+            }
+            ++$startRow;
+        }
+
+        return $worksheet;
+    }
+
+    public function convertWorksheetCellToArray(
+        Worksheet $worksheet,
+        Cell $cell,
+        bool $calculateFormulas,
+        bool $formatData,
+        mixed $nullValue
+    ): mixed {
+        $this->mutatingWorksheet = $worksheet;
+        $this->arrayNullValue = $nullValue;
+        $returnValue = $this->arrayNullValue;
+
+        if ($cell->getValue() !== null) {
+            if ($cell->getValue() instanceof RichText) {
+                $returnValue = $cell->getValue()->getPlainText();
+            } else {
+                $returnValue = ($calculateFormulas) ? $cell->getCalculatedValue() : $cell->getValue();
+            }
+
+            if ($formatData) {
+                $style = $worksheet->getParentOrThrow()->getCellXfByIndex($cell->getXfIndex());
+                $returnValue = NumberFormat::toFormattedString(
+                    $returnValue,
+                    $style->getNumberFormat()->getFormatCode() ?? NumberFormat::FORMAT_GENERAL
+                );
+            }
+        }
+
+        return $returnValue;
+    }
+
+    public function buildWorksheetNullRow(
+        Worksheet $worksheet,
+        mixed $nullValue,
+        string $minCol,
+        string $maxCol,
+        bool $returnCellRef,
+        bool $ignoreHidden,
+        array &$hiddenColumns
+    ): array {
+        $this->mutatingWorksheet = $worksheet;
+        $this->arrayNullValue = $nullValue;
+        $nullRow = [];
+        $c = -1;
+        for ($col = $minCol; $col !== $maxCol; ++$col) {
+            if ($ignoreHidden === true && $worksheet->columnDimensionExists($col) && $worksheet->getColumnDimension($col)->getVisible() === false) {
+                $hiddenColumns[$col] = true;
+            } else {
+                $columnRef = $returnCellRef ? $col : ++$c;
+                $nullRow[$columnRef] = $this->arrayNullValue;
+            }
+        }
+
+        return $nullRow;
+    }
+
+    public function convertWorksheetRangeToArray(
+        Worksheet $worksheet,
+        string $range,
+        mixed $nullValue = null,
+        bool $calculateFormulas = true,
+        bool $formatData = true,
+        bool $returnCellRef = false,
+        bool $ignoreHidden = false
+    ): array {
+        $this->mutatingWorksheet = $worksheet;
+        $this->arrayNullValue = $nullValue;
+        $this->arrayExportRows = [];
+
+        foreach ($this->yieldWorksheetRangeRows($worksheet, $range, $nullValue, $calculateFormulas, $formatData, $returnCellRef, $ignoreHidden) as $rowRef => $rowArray) {
+            $this->arrayExportRows[$rowRef] = $rowArray;
+        }
+
+        return $this->arrayExportRows;
+    }
+
+    public function yieldWorksheetRangeRows(
+        Worksheet $worksheet,
+        string $range,
+        mixed $nullValue = null,
+        bool $calculateFormulas = true,
+        bool $formatData = true,
+        bool $returnCellRef = false,
+        bool $ignoreHidden = false
+    ) {
+        $this->mutatingWorksheet = $worksheet;
+        $this->arrayNullValue = $nullValue;
+        $range = Validations::validateCellOrCellRange($range);
+
+        [$rangeStart, $rangeEnd] = $this->rangeBoundaries($range);
+        $minCol = $this->stringFromColumnIndex($rangeStart[0]);
+        $minRow = $rangeStart[1];
+        $maxCol = $this->stringFromColumnIndex($rangeEnd[0]);
+        $maxRow = $rangeEnd[1];
+        $minColInt = $rangeStart[0];
+        $maxColInt = $rangeEnd[0];
+
+        ++$maxCol;
+        /** @var array<string, bool> */
+        $hiddenColumns = [];
+        $nullRow = $this->buildWorksheetNullRow($worksheet, $nullValue, $minCol, $maxCol, $returnCellRef, $ignoreHidden, $hiddenColumns);
+        $hideColumns = !empty($hiddenColumns);
+
+        $keys = $worksheet->getCellCollection()->getSortedCoordinatesInt();
+        $keyIndex = 0;
+        $keysCount = count($keys);
+        for ($row = $minRow; $row <= $maxRow; ++$row) {
+            if (($ignoreHidden === true) && ($worksheet->isRowVisible($row) === false)) {
+                continue;
+            }
+            $rowRef = $returnCellRef ? $row : ($row - $minRow);
+            $returnValue = $nullRow;
+
+            $index = ($row - 1) * AddressRange::MAX_COLUMN_INT + 1;
+            $indexPlus = $index + AddressRange::MAX_COLUMN_INT - 1;
+            while ($keyIndex < $keysCount && $keys[$keyIndex] < $index) {
+                ++$keyIndex;
+            }
+            while ($keyIndex < $keysCount && $keys[$keyIndex] <= $indexPlus) {
+                $key = $keys[$keyIndex];
+                $thisRow = intdiv($key - 1, AddressRange::MAX_COLUMN_INT) + 1;
+                $thisCol = ($key % AddressRange::MAX_COLUMN_INT) ?: AddressRange::MAX_COLUMN_INT;
+                if ($thisCol >= $minColInt && $thisCol <= $maxColInt) {
+                    $col = $this->stringFromColumnIndex($thisCol);
+                    if ($hideColumns === false || !isset($hiddenColumns[$col])) {
+                        $columnRef = $returnCellRef ? $col : ($thisCol - $minColInt);
+                        $cell = $worksheet->getCellCollection()->get("{$col}{$thisRow}");
+                        if ($cell !== null) {
+                            $value = $this->convertWorksheetCellToArray($worksheet, $cell, $calculateFormulas, $formatData, $nullValue);
+                            if ($value !== $this->arrayNullValue) {
+                                $returnValue[$columnRef] = $value;
+                            }
+                        }
+                    }
+                }
+                ++$keyIndex;
+            }
+
+            yield $rowRef => $returnValue;
+        }
+    }
+
+    public function convertWorksheetToArray(
+        Worksheet $worksheet,
+        mixed $nullValue = null,
+        bool $calculateFormulas = true,
+        bool $formatData = true,
+        bool $returnCellRef = false,
+        bool $ignoreHidden = false
+    ): array {
+        $this->mutatingWorksheet = $worksheet;
+        $this->arrayNullValue = $nullValue;
+        $worksheet->garbageCollect();
+        $maxCol = $worksheet->getHighestColumn();
+        $maxRow = $worksheet->getHighestRow();
+
+        return $this->convertWorksheetRangeToArray(
+            $worksheet,
+            "A1:{$maxCol}{$maxRow}",
+            $nullValue,
+            $calculateFormulas,
+            $formatData,
+            $returnCellRef,
+            $ignoreHidden
+        );
+    }
+
+    public function insertRowsBeforeWorksheet(Worksheet $worksheet, int $before, int $numberOfRows = 1): Worksheet
+    {
+        $this->mutatingWorksheet = $worksheet;
+        $this->retainedRowDimensions = $worksheet->getRowDimensions();
+        if ($before >= 1) {
+            $this->insertNewBefore('A' . $before, 0, $numberOfRows, $worksheet);
+        } else {
+            throw new Exception('Rows can only be inserted before at least row 1.');
+        }
+
+        return $worksheet;
+    }
+
+    public function insertColumnsBeforeWorksheet(Worksheet $worksheet, string $before, int $numberOfColumns = 1): Worksheet
+    {
+        $this->mutatingWorksheet = $worksheet;
+        $this->retainedColumnDimensions = $worksheet->getColumnDimensions();
+        if (!is_numeric($before)) {
+            $this->insertNewBefore($before . '1', $numberOfColumns, 0, $worksheet);
+        } else {
+            throw new Exception('Column references should not be numeric.');
+        }
+
+        return $worksheet;
+    }
+
+    public function insertColumnsBeforeWorksheetByIndex(Worksheet $worksheet, int $beforeColumnIndex, int $numberOfColumns = 1): Worksheet
+    {
+        $this->mutatingWorksheet = $worksheet;
+        if ($beforeColumnIndex >= 1) {
+            return $this->insertColumnsBeforeWorksheet(
+                $worksheet,
+                $this->stringFromColumnIndex($beforeColumnIndex),
+                $numberOfColumns
+            );
+        }
+
+        throw new Exception('Columns can only be inserted before at least column A (1).');
+    }
+
+    public function shiftRowDimensionsAfterRemoval(array $rowDimensions, int $row, int $numberOfRows): array
+    {
+        $this->retainedRowDimensions = [];
+        $highRow = $row + $numberOfRows - 1;
+        foreach ($rowDimensions as $rowDimension) {
+            $num = $rowDimension->getRowIndex();
+            if ($num < $row) {
+                $this->retainedRowDimensions[$num] = $rowDimension;
+            } elseif ($num > $highRow) {
+                $num -= $numberOfRows;
+                $cloneDimension = clone $rowDimension;
+                $cloneDimension->setRowIndex($num);
+                $this->retainedRowDimensions[$num] = $cloneDimension;
+            }
+        }
+
+        return $this->retainedRowDimensions;
+    }
+
+    public function shiftColumnDimensionsAfterRemoval(array $columnDimensions, int $pColumnIndex, int $numberOfColumns): array
+    {
+        $this->retainedColumnDimensions = [];
+        $highCol = $pColumnIndex + $numberOfColumns - 1;
+        foreach ($columnDimensions as $columnDimension) {
+            $num = $columnDimension->getColumnNumeric();
+            if ($num < $pColumnIndex) {
+                $str = $columnDimension->getColumnIndex();
+                $this->retainedColumnDimensions[$str] = $columnDimension;
+            } elseif ($num > $highCol) {
+                $cloneDimension = clone $columnDimension;
+                $cloneDimension->setColumnNumeric($num - $numberOfColumns);
+                $str = $cloneDimension->getColumnIndex();
+                $this->retainedColumnDimensions[$str] = $cloneDimension;
+            }
+        }
+
+        return $this->retainedColumnDimensions;
+    }
+
+    public function removeRowsFromWorksheet(Worksheet $worksheet, int $row, int $numberOfRows, array $rowDimensions): array
+    {
+        $this->mutatingWorksheet = $worksheet;
+        if ($row < 1) {
+            throw new Exception('Rows to be deleted should at least start from row 1.');
+        }
+
+        $this->retainedRowDimensions = $this->shiftRowDimensionsAfterRemoval($rowDimensions, $row, $numberOfRows);
+        $highestRow = $worksheet->getHighestDataRow();
+        $removedRowsCounter = 0;
+        $cellCollection = $worksheet->getCellCollection();
+
+        for ($r = 0; $r < $numberOfRows; ++$r) {
+            if ($row + $r <= $highestRow) {
+                $cellCollection->removeRow($row + $r);
+                ++$removedRowsCounter;
+            }
+        }
+
+        $this->insertNewBefore('A' . ($row + $numberOfRows), 0, -$numberOfRows, $worksheet);
+        for ($r = 0; $r < $removedRowsCounter; ++$r) {
+            $cellCollection->removeRow($highestRow);
+            --$highestRow;
+        }
+
+        return $this->retainedRowDimensions;
+    }
+
+    public function removeColumnsFromWorksheet(
+        Worksheet $worksheet,
+        string $column,
+        int $numberOfColumns,
+        array $columnDimensions
+    ): array {
+        $this->mutatingWorksheet = $worksheet;
+        if (is_numeric($column)) {
+            throw new Exception('Column references should not be numeric.');
+        }
+
+        $highestColumn = $worksheet->getHighestDataColumn();
+        $highestColumnIndex = $this->columnIndexFromString($highestColumn);
+        $pColumnIndex = $this->columnIndexFromString($column);
+
+        $this->retainedColumnDimensions = $this->shiftColumnDimensionsAfterRemoval(
+            $columnDimensions,
+            $pColumnIndex,
+            $numberOfColumns
+        );
+
+        $afterColumn = $this->stringFromColumnIndex($pColumnIndex + $numberOfColumns);
+        $this->insertNewBefore($afterColumn . '1', -$numberOfColumns, 0, $worksheet);
+
+        if ($pColumnIndex > $highestColumnIndex) {
+            return $this->retainedColumnDimensions;
+        }
+
+        $maxPossibleColumnsToBeRemoved = $highestColumnIndex - $pColumnIndex + 1;
+        $cellCollection = $worksheet->getCellCollection();
+
+        for ($c = 0, $n = min($maxPossibleColumnsToBeRemoved, $numberOfColumns); $c < $n; ++$c) {
+            $cellCollection->removeColumn($highestColumn);
+            $highestColumn = $this->stringFromColumnIndex($this->columnIndexFromString($highestColumn) - 1);
+        }
+
+        $worksheet->garbageCollect();
+
+        return $this->retainedColumnDimensions;
+    }
+
+    public function removeColumnsFromWorksheetByIndex(Worksheet $worksheet, int $columnIndex, int $numColumns, array $columnDimensions): array
+    {
+        $this->mutatingWorksheet = $worksheet;
+        if ($columnIndex >= 1) {
+            return $this->removeColumnsFromWorksheet(
+                $worksheet,
+                $this->stringFromColumnIndex($columnIndex),
+                $numColumns,
+                $columnDimensions
+            );
+        }
+
+        throw new Exception('Columns to be deleted should at least start from column A (1)');
+    }
+
+    public function resolveCreatedCellXfIndex(mixed $rowDimension, mixed $columnDimension): ?int
+    {
+
+        $xfIndex = null;
+        if ($rowDimension !== null) {
+            $rowXf = (int) $rowDimension->getXfIndex();
+            if ($rowXf > 0) {
+                $xfIndex = $rowXf;
+            }
+        }
+        if ($xfIndex === null && $columnDimension !== null) {
+            $colXf = (int) $columnDimension->getXfIndex();
+            if ($colXf > 0) {
+                $xfIndex = $colXf;
+            }
+        }
+
+        return $xfIndex;
+    }
