+            $this->builtInFormats[46] = '[h]:mm:ss';
+            $this->builtInFormats[47] = 'mm:ss.0'; //  Despite ECMA 'mmss.0';
+            $this->builtInFormats[48] = '##0.0E+0';
+            $this->builtInFormats[49] = '@';
+
+            // CHT
+            $this->builtInFormats[27] = '[$-404]e/m/d';
+            $this->builtInFormats[30] = 'm/d/yy';
+            $this->builtInFormats[36] = '[$-404]e/m/d';
+            $this->builtInFormats[50] = '[$-404]e/m/d';
+            $this->builtInFormats[57] = '[$-404]e/m/d';
