+    public function excelToDateTimeObject(float|int $excelTimestamp, null|DateTimeZone|string $timeZone = null): DateTime {
+        $timeZone = ($timeZone === null) ? $this->getDefaultTimezone() : $this->validateTimeZone($timeZone);
+        if (Functions::getCompatibilityMode() == Functions::COMPATIBILITY_EXCEL) {
+            if ($excelTimestamp < 1 && $this->excelCalendar === Date::CALENDAR_WINDOWS_1900) {
+                // Unix timestamp base date
+                $baseDate = new DateTime('1970-01-01', $timeZone);
+            } else {
+                // MS Excel calendar base dates
+                if ($this->excelCalendar == Date::CALENDAR_WINDOWS_1900) {
+                    // Allow adjustment for 1900 Leap Year in MS Excel
+                    $baseDate = ($excelTimestamp < 60) ? new DateTime('1899-12-31', $timeZone) : new DateTime('1899-12-30', $timeZone);
+                } else {
+                    $baseDate = new DateTime('1904-01-01', $timeZone);
+                }
+            }
+        } else {
+            $baseDate = new DateTime('1899-12-30', $timeZone);
+        }
+
+        $days = floor($excelTimestamp);
+        $partDay = $excelTimestamp - $days;
+        $hms = 86400 * $partDay;
+        $microseconds = (int) round(fmod($hms, 1) * 1000000);
+        $hms = (int) floor($hms);
+        $hours = intdiv($hms, 3600);
+        $hms -= $hours * 3600;
+        $minutes = intdiv($hms, 60);
+        $seconds = $hms % 60;
+
+        if ($days >= 0) {
+            $days = '+' . $days;
+        }
+        $interval = $days . ' days';
+
+        return $baseDate->modify($interval)
+            ->setTime($hours, $minutes, $seconds, $microseconds);
+    }
