+    public function filterTestInDateGroupSet(mixed $cellValue, array $dataSet): bool {
+        $this->filterEvaluationCellValue = $cellValue;
+        $this->filterEvaluationDataSet = $dataSet;
+        $dateSet = $this->filterEvaluationDataSet['filterValues'];
+        $blanks = $dataSet['blanks'];
+        if (($cellValue == '') || ($cellValue === null)) {
+            return $blanks;
+        }
+        $timeZone = new DateTimeZone('UTC');
+
+        if (is_numeric($cellValue)) {
+            $dateTime = $this->excelToDateTimeObject((float) $cellValue, $timeZone);
+            $cellValue = (float) $cellValue;
+            if ($cellValue < 1) {
+                //    Just the time part
+                $dtVal = $dateTime->format('His');
+                $dateSet = $dateSet['time'];
+            } elseif ($cellValue == floor($cellValue)) {
+                //    Just the date part
+                $dtVal = $dateTime->format('Ymd');
+                $dateSet = $dateSet['date'];
+            } else {
+                //    date and time parts
+                $dtVal = $dateTime->format('YmdHis');
+                $dateSet = $dateSet['dateTime'];
+            }
+            foreach ($dateSet as $dateValue) {
+                //    Use of substr to extract value at the appropriate group level
