+    public function showHideRowsForAutoFilter(AutoFilter $autoFilter): AutoFilter {
+        $workSheet = $autoFilter->getParent();
+        $range = $autoFilter->getRange();
+        $columns = $autoFilter->getColumns();
+        $this->mutatingWorksheet = $workSheet;
+        $this->filterEvaluationDataSet = [];
+        if ($workSheet === null) {
+            return $autoFilter;
+        }
+        [$rangeStart, $rangeEnd] = $this->rangeBoundaries($range);
+
+        //    The heading row should always be visible
+        $workSheet->getRowDimension($rangeStart[1])->setVisible(true);
+
+        $columnFilterTests = [];
+        foreach ($columns as $columnID => $filterColumn) {
+            $rules = $filterColumn->getRules();
+            switch ($filterColumn->getFilterType()) {
+                case 'filters':
+                    $ruleType = null;
+                    $ruleValues = [];
+                    //    Build a list of the filter value selections
+                    foreach ($rules as $rule) {
+                        $ruleType = $rule->getRuleType();
+                        $ruleValues[] = $rule->getValue();
+                    }
+                    //    Test if we want to include blanks in our filter criteria
+                    $blanks = false;
+                    $ruleDataSet = array_filter($ruleValues);
+                    if (count($ruleValues) != count($ruleDataSet)) {
+                        $blanks = true;
+                    }
+                    if ($ruleType == 'filter') {
+                        //    Filter on absolute values
+                        $columnFilterTests[$columnID] = [
+                            'method' => 'filterTestInSimpleDataSet',
+                            'arguments' => ['filterValues' => $ruleDataSet, 'blanks' => $blanks],
+                        ];
+                    } else {
+                        //    Filter on date group values
+                        $arguments = [
+                            'date' => [],
+                            'time' => [],
+                            'dateTime' => [],
+                        ];
+                        foreach ($ruleDataSet as $ruleValue) {
+                            if (!is_array($ruleValue)) {
+                                continue;
+                            }
+                            $date = $time = '';
+                            if (
+                                (isset($ruleValue['year']))
+                                && ($ruleValue['year'] !== '')
+                            ) {
+                                $date .= sprintf('%04d', $ruleValue['year']);
+                            }
+                            if (
+                                (isset($ruleValue['month']))
+                                && ($ruleValue['month'] != '')
+                            ) {
+                                $date .= sprintf('%02d', $ruleValue['month']);
+                            }
+                            if (
+                                (isset($ruleValue['day']))
+                                && ($ruleValue['day'] !== '')
+                            ) {
+                                $date .= sprintf('%02d', $ruleValue['day']);
+                            }
+                            if (
+                                (isset($ruleValue['hour']))
+                                && ($ruleValue['hour'] !== '')
+                            ) {
+                                $time .= sprintf('%02d', $ruleValue['hour']);
+                            }
+                            if (
+                                (isset($ruleValue['minute']))
+                                && ($ruleValue['minute'] !== '')
+                            ) {
+                                $time .= sprintf('%02d', $ruleValue['minute']);
+                            }
+                            if (
+                                (isset($ruleValue['second']))
+                                && ($ruleValue['second'] !== '')
+                            ) {
+                                $time .= sprintf('%02d', $ruleValue['second']);
+                            }
+                            $dateTime = $date . $time;
+                            $arguments['date'][] = $date;
+                            $arguments['time'][] = $time;
+                            $arguments['dateTime'][] = $dateTime;
+                        }
+                        //    Remove empty elements
+                        $arguments['date'] = array_filter($arguments['date']);
+                        $arguments['time'] = array_filter($arguments['time']);
+                        $arguments['dateTime'] = array_filter($arguments['dateTime']);
+                        $columnFilterTests[$columnID] = [
+                            'method' => 'filterTestInDateGroupSet',
+                            'arguments' => ['filterValues' => $arguments, 'blanks' => $blanks],
+                        ];
+                    }
+
+                    break;
+                case 'customFilters':
+                    $customRuleForBlanks = true;
+                    $ruleValues = [];
+                    //    Build a list of the filter value selections
+                    foreach ($rules as $rule) {
+                        $ruleValue = $rule->getValue();
+                        if (!is_array($ruleValue) && !is_numeric($ruleValue)) {
+                            //    Convert to a regexp allowing for regexp reserved characters, wildcards and escaped wildcards
+                            $ruleValue = WildcardMatch::wildcard($ruleValue);
+                            if (trim($ruleValue) == '') {
+                                $customRuleForBlanks = true;
+                                $ruleValue = trim($ruleValue);
+                            }
+                        }
+                        $ruleValues[] = ['operator' => $rule->getOperator(), 'value' => $ruleValue];
+                    }
+                    $join = $filterColumn->getJoin();
+                    $columnFilterTests[$columnID] = [
+                        'method' => 'filterTestInCustomDataSet',
+                        'arguments' => ['filterRules' => $ruleValues, 'join' => $join, 'customRuleForBlanks' => $customRuleForBlanks],
+                    ];
+
+                    break;
+                case 'dynamicFilter':
+                    $ruleValues = [];
+                    foreach ($rules as $rule) {
+                        //    We should only ever have one Dynamic Filter Rule anyway
+                        $dynamicRuleType = $rule->getGrouping();
+                        if (
+                            ($dynamicRuleType == 'aboveAverage')
+                            || ($dynamicRuleType == 'belowAverage')
+                        ) {
+                            //    Number (Average) based
+                            //    Calculate the average
+                            $averageFormula = '=AVERAGE(' . $columnID . ($rangeStart[1] + 1) . ':' . $columnID . $rangeEnd[1] . ')';
+                            $average = Calculation::getInstance($workSheet->getParent())->calculateFormula($averageFormula, null, $workSheet->getCell('A1'));
+                            while (is_array($average)) {
+                                $average = array_pop($average);
+                            }
+                            //    Set above/below rule based on greaterThan or LessTan
+                            $operator = ($dynamicRuleType === 'aboveAverage')
+                                ? 'greaterThan'
+                                : 'lessThan';
+                            $ruleValues[] = [
+                                'operator' => $operator,
+                                'value' => $average,
+                            ];
+                            $columnFilterTests[$columnID] = [
+                                'method' => 'filterTestInCustomDataSet',
+                                'arguments' => ['filterRules' => $ruleValues, 'join' => 'or'],
+                            ];
+                        } else {
+                            //    Date based
+                            if ($dynamicRuleType[0] == 'M' || $dynamicRuleType[0] == 'Q') {
+                                $periodType = '';
+                                $period = 0;
+                                //    Month or Quarter
+                                sscanf($dynamicRuleType, '%[A-Z]%d', $periodType, $period);
+                                if ($periodType == 'M') {
+                                    $ruleValues = [$period];
+                                } else {
+                                    --$period;
+                                    $periodEnd = (1 + $period) * 3;
+                                    $periodStart = 1 + $period * 3;
+                                    $ruleValues = range($periodStart, $periodEnd);
+                                }
+                                $columnFilterTests[$columnID] = [
+                                    'method' => 'filterTestInPeriodDateSet',
+                                    'arguments' => $ruleValues,
+                                ];
+                                $filterColumn->setAttributes([]);
+                            } else {
+                                //    Date Range
+                                $columnFilterTests[$columnID] = $this->dynamicFilterDateRange($dynamicRuleType, $filterColumn);
+
+                                break;
+                            }
+                        }
+                    }
+
+                    break;
+                case 'top10':
+                    $ruleValues = [];
+                    $dataRowCount = $rangeEnd[1] - $rangeStart[1];
+                    $toptenRuleType = null;
+                    $ruleValue = 0;
+                    $ruleOperator = null;
+                    foreach ($rules as $rule) {
+                        //    We should only ever have one Dynamic Filter Rule anyway
+                        $toptenRuleType = $rule->getGrouping();
+                        $ruleValue = $rule->getValue();
+                        $ruleOperator = $rule->getOperator();
+                    }
+                    if (is_numeric($ruleValue) && $ruleOperator === 'byPercent') {
+                        $ruleValue = floor((float) $ruleValue * ($dataRowCount / 100));
+                    }
+                    if (!is_array($ruleValue) && $ruleValue < 1) {
+                        $ruleValue = 1;
+                    }
+                    if (!is_array($ruleValue) && $ruleValue > 500) {
+                        $ruleValue = 500;
+                    }
+
+                    $maxVal = $this->calculateTopTenValue($columnID, $rangeStart[1] + 1, (int) $rangeEnd[1], $toptenRuleType, $ruleValue, $workSheet);
+
+                    $operator = ($toptenRuleType == 'top')
+                        ? 'greaterThanOrEqual'
+                        : 'lessThanOrEqual';
+                    $ruleValues[] = ['operator' => $operator, 'value' => $maxVal];
+                    $columnFilterTests[$columnID] = [
+                        'method' => 'filterTestInCustomDataSet',
+                        'arguments' => ['filterRules' => $ruleValues, 'join' => 'or'],
+                    ];
+                    $filterColumn->setAttributes(['maxVal' => $maxVal]);
+
+                    break;
+            }
+        }
+
+        $rangeEnd[1] = $this->autoExtendRange($rangeStart[1], $rangeEnd[1], $workSheet);
+
+        //    Execute the column tests for each row in the autoFilter range to determine show/hide,
+        for ($row = $rangeStart[1] + 1; $row <= $rangeEnd[1]; ++$row) {
+            $result = true;
+            foreach ($columnFilterTests as $columnID => $columnFilterTest) {
+                $cellValue = $workSheet->getCell($columnID . $row)->getCalculatedValue();
+                //    Execute the filter test
+                /** @var callable */
+                $temp = [$this, $columnFilterTest['method']];
+                $result // $result && // phpstan says $result is always true here
+                    = call_user_func_array($temp, [$cellValue, $columnFilterTest['arguments']]);
+                //    If filter test has resulted in FALSE, exit the loop straightaway rather than running any more tests
+                if (!$result) {
+                    break;
+                }
+            }
+            //    Set show/hide for the row based on the result of the autoFilter result
+            //    If the RowDimension object has not been allocated yet and the row should be visible,
+            //    then we can avoid any operation since the rows are visible by default (saves a lot of memory)
+            if ($result === false || $workSheet->rowDimensionExists((int) $row)) {
+                $workSheet->getRowDimension((int) $row)->setVisible($result);
+            }
+        }
+        $autoFilter->setEvaluated(true);
+
+        return $autoFilter;
+    }
+
+    public function autoExtendRange(int $startRow, int $endRow, ?Worksheet $workSheet = null): int {
+        $this->mutatingWorksheet = $workSheet;
+        $this->filterEvaluationDataSet['startRow'] = $startRow;
+
+        if ($startRow === $endRow && $workSheet !== null) {
+            try {
+                $rowIterator = $workSheet->getRowIterator($startRow + 1);
+            } catch (Exception) {
+                // If there are no rows below $startRow
+                return $startRow;
+            }
+            foreach ($rowIterator as $row) {
+                if ($row->isEmpty(CellIterator::TREAT_NULL_VALUE_AS_EMPTY_CELL | CellIterator::TREAT_EMPTY_STRING_AS_EMPTY_CELL) === true) {
+                    return $row->getRowIndex() - 1;
+                }
+            }
+        }
+
+        return $endRow;
+    }
