+        $cellText = (string) $cellText;
+        $this->columnWidthContext['text'] = $cellText;
+        if (str_contains($cellText, "\n")) {
+            $lineTexts = explode("\n", $cellText);
+            $lineWidths = [];
+            foreach ($lineTexts as $lineText) {
+                $lineWidths[] = $this->calculateColumnWidth($font, $lineText, 0, $defaultFont, $filterAdjustment);
+            }
+            $this->columnWidthContext['width'] = max($lineWidths);
+
+            return $this->columnWidthContext['width'];
+        }
+
+        $approximate = SharedFont::getAutoSizeMethod() === SharedFont::AUTOSIZE_METHOD_APPROX;
+        $columnWidth = 0;
+        if (!$approximate) {
+            try {
+                $columnWidthAdjust = ceil(
+                    $this->getTextWidthPixelsExact(
+                        str_repeat('n', 1 * (($filterAdjustment ? 3 : 1) + ($indentAdjustment * 2))),
+                        $font,
+                        0
+                    ) * 1.07
+                );
+                $columnWidth = $this->getTextWidthPixelsExact($cellText, $font, $rotation) + (SharedFont::getPaddingAmountExact() ?? $columnWidthAdjust);
+            } catch (Exception) {
+                $approximate = true;
+            }
+        }
+
+        if ($approximate) {
+            $columnWidthAdjust = $this->getTextWidthPixelsApprox(
+                str_repeat('n', 1 * (($filterAdjustment ? 3 : 1) + ($indentAdjustment * 2))),
+                $font,
+                0
+            );
+            $columnWidth = $this->getTextWidthPixelsApprox($cellText, $font, $rotation) + $columnWidthAdjust;
+        }
+
+        $columnWidth = \PhpOffice\PhpSpreadsheet\Shared\Drawing::pixelsToCellDimension((int) $columnWidth, $defaultFont ?? new \PhpOffice\PhpSpreadsheet\Style\Font());
+        $this->columnWidthContext['width'] = round($columnWidth, 4);
+
+        return $this->columnWidthContext['width'];
+    }
+
+    public function getTextWidthPixelsExact(string $text, \PhpOffice\PhpSpreadsheet\Style\Font $font, int $rotation = 0): float
+    {
+        $this->columnWidthContext['text'] = $text;
+        $this->columnWidthContext['rotation'] = $rotation;
+        $fontFile = SharedFont::getTrueTypeFontFileFromFont($font);
+        $textBox = imagettfbbox($font->getSize() ?? 10.0, $rotation, $fontFile, $text);
+        if ($textBox === false) {
+            throw new Exception('imagettfbbox failed');
+        }
+
+        $lowerLeftCornerX = $textBox[0];
+        $lowerRightCornerX = $textBox[2];
+        $upperRightCornerX = $textBox[4];
+        $upperLeftCornerX = $textBox[6];
+        $width = round(max($lowerRightCornerX - $upperLeftCornerX, $upperRightCornerX - $lowerLeftCornerX), 4);
+        $this->columnWidthContext['width'] = $width;
+
+        return $width;
+    }
+
+    public function getTextWidthPixelsApprox(string $columnText, \PhpOffice\PhpSpreadsheet\Style\Font $font, int $rotation = 0): int
+    {
+        $this->columnWidthContext['text'] = $columnText;
+        $this->columnWidthContext['rotation'] = $rotation;
+        $fontName = $font->getName();
+        $fontSize = $font->getSize();
+        $this->columnWidthContext['fontName'] = $fontName;
+        $this->columnWidthContext['fontSize'] = $fontSize;
+
+        switch ($fontName) {
+            case 'Arial':
+                $columnWidth = (int) (8 * \PhpOffice\PhpSpreadsheet\Shared\StringHelper::countCharactersDbcs($columnText));
+                $columnWidth = $columnWidth * $fontSize / 10;
+                break;
+            case 'Verdana':
+                $columnWidth = (int) (8 * \PhpOffice\PhpSpreadsheet\Shared\StringHelper::countCharactersDbcs($columnText));
+                $columnWidth = $columnWidth * $fontSize / 10;
+                break;
+            default:
+                $columnWidth = (int) (8.26 * \PhpOffice\PhpSpreadsheet\Shared\StringHelper::countCharactersDbcs($columnText));
+                $columnWidth = $columnWidth * $fontSize / 11;
+                break;
+        }
+
+        if ($rotation !== 0) {
+            if ($rotation == Alignment::TEXTROTATION_STACK_PHPSPREADSHEET) {
+                $columnWidth = 4;
+            } else {
+                $columnWidth = $columnWidth * cos(deg2rad($rotation))
+                                + $fontSize * abs(sin(deg2rad($rotation))) / 5;
+            }
+        }
+
+        $this->columnWidthContext['width'] = (int) $columnWidth;
+
+        return (int) $columnWidth;
+    }
+
+    public function fontSizeToPixels(float|int $fontSizeInPoints): int
+    {
+        $this->columnWidthContext['fontSize'] = $fontSizeInPoints;
+        $this->columnWidthContext['width'] = (int) ((4 / 3) * $fontSizeInPoints);
+
+        return (int) $this->columnWidthContext['width'];
+    }
+
+    public function inchSizeToPixels(int|float $sizeInInch): int|float
+    {
+        $this->columnWidthContext['width'] = $sizeInInch * 96;
+
+        return $this->columnWidthContext['width'];
+    }
+
+    public function centimeterSizeToPixels(int|float $sizeInCm): float
+    {
+        $this->columnWidthContext['width'] = $sizeInCm * 37.795275591;
+
+        return (float) $this->columnWidthContext['width'];
+    }
