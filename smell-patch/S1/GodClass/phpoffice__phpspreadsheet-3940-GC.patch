+            $this->builtInFormats[60] = 't0.00';
+            $this->builtInFormats[61] = 't#,##0';
+            $this->builtInFormats[62] = 't#,##0.00';
+            $this->builtInFormats[67] = 't0%';
+            $this->builtInFormats[68] = 't0.00%';
