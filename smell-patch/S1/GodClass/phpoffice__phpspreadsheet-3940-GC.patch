+    public function calculateColumnWidth(
+        \PhpOffice\PhpSpreadsheet\Style\Font $font,
+        $cellText = '',
+        int $rotation = 0,
+        ?\PhpOffice\PhpSpreadsheet\Style\Font $defaultFont = null,
