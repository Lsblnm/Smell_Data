+        $dataSet = $this->filterEvaluationRuleSet['filterRules'];
+        $join = $ruleSet['join'];
+        $customRuleForBlanks = $ruleSet['customRuleForBlanks'] ?? false;
+
+        if (!$customRuleForBlanks) {
+            //    Blank cells are always ignored, so return a FALSE
+            if (($cellValue == '') || ($cellValue === null)) {
+                return false;
+            }
+        }
+        $returnVal = ($join == 'and');
+        foreach ($dataSet as $rule) {
+            /** @var string $ruleValue */
+            $ruleValue = $rule['value'];
+            /** @var string $ruleOperator */
+            $ruleOperator = $rule['operator'];
+            /** @var string $cellValueString */
+            $cellValueString = $cellValue ?? '';
+            $retVal = false;
+
+            if (is_numeric($ruleValue)) {
+                //    Numeric values are tested using the appropriate operator
+                $numericTest = is_numeric($cellValue);
+                switch ($ruleOperator) {
+                    case 'equal':
+                        $retVal = $numericTest && ($cellValue == $ruleValue);
+
+                        break;
+                    case 'notEqual':
+                        $retVal = !$numericTest || ($cellValue != $ruleValue);
+
+                        break;
+                    case 'greaterThan':
+                        $retVal = $numericTest && ($cellValue > $ruleValue);
+
+                        break;
+                    case 'greaterThanOrEqual':
+                        $retVal = $numericTest && ($cellValue >= $ruleValue);
+
+                        break;
+                    case 'lessThan':
+                        $retVal = $numericTest && ($cellValue < $ruleValue);
+
+                        break;
+                    case 'lessThanOrEqual':
+                        $retVal = $numericTest && ($cellValue <= $ruleValue);
+
+                        break;
+                }
+            } elseif ($ruleValue == '') {
+                $retVal = match ($ruleOperator) {
+                    'equal' => ($cellValue == '') || ($cellValue === null),
+                    'notEqual' => ($cellValue != '') && ($cellValue !== null),
+                    default => true,
+                };
+            } else {
+                //    String values are always tested for equality, factoring in for wildcards (hence a regexp test)
+                switch ($ruleOperator) {
+                    case 'equal':
+                        $retVal = (bool) preg_match('/^' . $ruleValue . '$/i', $cellValueString);
+
+                        break;
+                    case 'notEqual':
+                        $retVal = !((bool) preg_match('/^' . $ruleValue . '$/i', $cellValueString));
+
+                        break;
+                    case 'greaterThan':
+                        $retVal = strcasecmp($cellValueString, $ruleValue) > 0;
+
+                        break;
+                    case 'greaterThanOrEqual':
+                        $retVal = strcasecmp($cellValueString, $ruleValue) >= 0;
+
+                        break;
+                    case 'lessThan':
+                        $retVal = strcasecmp($cellValueString, $ruleValue) < 0;
+
+                        break;
+                    case 'lessThanOrEqual':
+                        $retVal = strcasecmp($cellValueString, $ruleValue) <= 0;
+
+                        break;
+                }
+            }
+            //    If there are multiple conditions, then we need to test both using the appropriate join operator
+            switch ($join) {
+                case 'or':
+                    $returnVal = $returnVal || $retVal;
+                    //    Break as soon as we have a TRUE match for OR joins,
+                    //        to avoid unnecessary additional code execution
+                    if ($returnVal) {
+                        return $returnVal;
+                    }
+
+                    break;
+                case 'and':
+                    $returnVal = $returnVal && $retVal;
+
+                    break;
+            }
+        }
+
+        return $returnVal;
+    }
