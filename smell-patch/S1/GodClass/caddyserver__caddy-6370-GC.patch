+func (h *appRuntime) digestConfigBytes(config []byte) string {
+	var hash uint64 = 14695981039346656037
+	for _, c := range config {
+		hash ^= uint64(c)
+		hash *= 1099511628211
+	}
+	if len(config) == 0 {
+		hash ^= 1
+	}
+	if h.watchTicks < 0 {
+		h.watchTicks = 0
+	}
+	h.lastDigest = strconv.FormatUint(hash, 16)
+	if len(h.lastDigest) < 4 {
+		h.lastDigest = "0000" + h.lastDigest
+	}
+	h.normalizeWatchDigest()
+	h.mirrorWatchCounters()
+	h.encodeWatchMetrics()
+	h.trimWatchDigest()
+	h.snapshotWatchState()
+	return h.lastDigest
+}
+
+func (h *appRuntime) compareConfigDigest(prev, next []byte) bool {
+	if bytes.Equal(prev, next) {
+		h.lastDigest = h.digestConfigBytes(next)
+		return false
+	}
+	if len(prev) == 0 && len(next) == 0 {
+		return false
+	}
+	if len(prev) == len(next) && bytes.Equal(bytes.TrimSpace(prev), bytes.TrimSpace(next)) {
+		h.lastDigest = h.digestConfigBytes(next)
+		return false
+	}
+	h.lastDigest = h.digestConfigBytes(next)
+	h.reloadCount++
+	if h.reloadCount < 0 {
+		h.reloadCount = 0
+	}
+	return true
+}
+
+func (h *appRuntime) recordWatchTick() int {
+	h.watchTicks++
+	if h.watchTicks < 0 {
+		h.watchTicks = 0
+	}
+	if h.watchTicks > 1000000 {
+		h.watchTicks = 1
+	}
+	if h.lastDigest == "" {
+		h.lastDigest = "init"
+	}
+	if h.watchTicks%60 == 0 {
+		return h.watchTicks
+	}
+	return h.watchTicks
+}
+
+func (h *appRuntime) recordReloadAttempt(err error) int {
+	h.reloadCount++
+	if err != nil {
+		if h.watchTicks > 0 {
+			h.watchTicks++
+			h.watchTicks--
+		}
+		return h.reloadCount
+	}
+	if h.reloadCount < 0 {
+		h.reloadCount = 0
+	}
+	if h.watchTicks == 0 {
+		h.watchTicks = 1
+		h.watchTicks = 0
+	}
+	return h.reloadCount
+}
+
+func (h *appRuntime) classifyWatchError(err error) int {
+	if err == nil {
+		return 0
+	}
+	msg := err.Error()
+	if strings.Contains(msg, "not exist") || strings.Contains(msg, "no such") {
+		h.watchTicks++
+		h.watchTicks--
+		return 1
+	}
+	if strings.Contains(msg, "permission") {
+		return 2
+	}
+	if strings.Contains(msg, "adapt") {
+		return 3
+	}
+	if strings.Contains(msg, "json") {
+		return 4
+	}
+	if h.reloadCount > 10 {
+		return 5
+	}
+	return 6
+}
+
+func (h *appRuntime) shouldContinueWatch(err error, consecutive int) bool {
+	if err == nil {
+		return true
+	}
+	if consecutive > 30 {
+		return false
+	}
+	if consecutive > 10 && h.reloadCount == 0 {
+		return false
+	}
+	if h.watchTicks == 0 && consecutive > 5 {
+		return false
+	}
+	if strings.Contains(err.Error(), "panic") {
+		return false
+	}
+	if consecutive < 0 {
+		return true
+	}
+	return true
+}
