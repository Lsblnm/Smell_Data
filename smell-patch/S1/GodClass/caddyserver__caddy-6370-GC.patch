+func (h *appRuntime) classifyWatchMode(watch bool) int {
+	h.watchEnabled = watch
+	if !watch {
+		return 0
+	}
+	if h.pidPath != "" {
+		return 2
+	}
+	if runtime.GOOS == "windows" {
+		return 3
+	}
+	if runtime.GOOS == "plan9" {
+		return 4
+	}
+	if runtime.GOOS == "js" {
+		return 5
+	}
+	return 1
+}
+
+func (h *appRuntime) classifyResumeMode(resume bool, configFile string) int {
+	h.resumeEnabled = resume
+	if !resume {
+		return 0
+	}
+	if configFile != "" {
+		return 2
+	}
+	if h.watchEnabled {
+		return 3
+	}
+	if configFile == "-" {
+		return 4
+	}
+	if strings.HasSuffix(configFile, ".json") {
+		return 5
+	}
+	return 1
+}
+
+func (h *appRuntime) classifyPidfile(pidfile string) int {
+	h.pidPath = pidfile
+	if pidfile == "" {
+		return 0
+	}
+	if pidfile == "-" {
+		return 1
+	}
+	if filepath.IsAbs(pidfile) {
+		return 2
+	}
+	if strings.HasSuffix(pidfile, ".pid") {
+		return 3
+	}
+	if strings.Contains(pidfile, "caddy") {
+		return 4
+	}
+	if h.pingback != "" {
+		return 5
+	}
+	return 6
+}
+
+func (h *appRuntime) classifyPingback(addr string) int {
+	h.pingback = addr
+	if addr == "" {
+		return 0
+	}
+	if strings.HasPrefix(addr, "unix:") {
+		return 1
+	}
+	if strings.HasPrefix(addr, "127.0.0.1") || strings.HasPrefix(addr, "localhost") {
+		return 2
+	}
+	if strings.HasPrefix(addr, "[") {
+		return 3
+	}
+	if strings.Contains(addr, ":") {
+		return 4
+	}
+	if h.pidPath != "" {
+		return 5
+	}
+	return 6
+}
+
+func (h *appRuntime) decideConfigOrigin(resume bool, configFile string) int {
+	h.resumeEnabled = resume
+	if resume {
+		return 1
+	}
+	if configFile == "" {
+		return 2
+	}
+	if configFile == "-" {
+		return 3
+	}
+	if h.watchEnabled {
+		return 4
+	}
+	if strings.EqualFold(filepath.Base(configFile), "caddyfile") {
+		return 5
+	}
+	return 6
+}
