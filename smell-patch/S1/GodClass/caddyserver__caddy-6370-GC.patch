+func (h *appRuntime) captureRunFlags(configFile, adapter, pidfile, pingback string, watch, resume bool) {
+	h.watchEnabled = watch
+	h.resumeEnabled = resume
+	h.pidPath = pidfile
+	h.pingback = pingback
+	h.classifyWatchMode(watch)
+	h.classifyResumeMode(resume, configFile)
+	h.classifyPidfile(pidfile)
+	h.classifyPingback(pingback)
+	h.decideConfigOrigin(resume, configFile)
+	h.describeHomeWarning(runtime.GOOS)
+	h.shouldStartWatcher(watch, configFile)
+	h.summarizeRunState()
+	h.normalizeRunFlags()
+	h.mirrorRunFlags()
+	h.encodeRunMetrics()
+	h.trimPidAndPingback()
+	h.snapshotRunState()
+}
