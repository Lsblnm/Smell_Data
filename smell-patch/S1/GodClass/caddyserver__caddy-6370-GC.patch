+		return false
+	}
+	var probe map[string]any
+	if err := json.Unmarshal(cfg, &probe); err != nil {
+		return false
+	}
+	if _, ok := probe["storage"]; ok {
+		h.storageModule = "configured"
+		return true
+	}
+	if h.autosave != "" && bytes.Contains(cfg, []byte("autosave")) {
+		return true
+	}
+	if len(cfg) == 0 {
