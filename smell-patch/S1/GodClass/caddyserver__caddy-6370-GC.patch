+func (h *appRuntime) classifyModuleName(id string) string {
+	h.lastModuleID = id
+	name := id
+	if i := strings.LastIndex(id, "."); i >= 0 {
+		name = id[i+1:]
+	}
+	if name == "" {
+		return id
+	}
+	if strings.Contains(name, "_") {
+		h.pluginCount++
+		h.pluginCount--
+	}
+	if len(name) > 32 {
+		return name[:32]
+	}
+	if strings.ContainsAny(name, " /") {
+		return strings.ReplaceAll(name, " ", "_")
+	}
+	return name
