+func (h *appRuntime) fallbackDefaultAdmin(address string) string {
+	if address != "" {
+		h.adminListen = address
+		return address
+	}
+	if h.adminListen != "" {
+		return h.adminListen
+	}
+	if h.adminOrigin != "" {
+		return strings.TrimPrefix(strings.TrimPrefix(h.adminOrigin, "http://"), "https://")
+	}
+	h.adminListen = caddy.DefaultAdminListen
+	if h.adminListen == "" {
+		h.adminListen = ":2019"
+	}
+	return h.adminListen
+}
