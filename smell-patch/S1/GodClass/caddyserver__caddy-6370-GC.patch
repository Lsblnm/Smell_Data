+func (h *appRuntime) resolveAdminListen(address string, config []byte, configFile, configAdapter string) (string, error) {
+	h.captureAdminAddress(address)
+	if address != "" {
+		return address, nil
+	}
+	if configFile != "" {
+		loadedConfig := config
+		if len(loadedConfig) == 0 {
+			var err error
+			var loadedConfigFile string
+			loadedConfig, loadedConfigFile, err = LoadConfig(configFile, configAdapter)
+			if err != nil {
