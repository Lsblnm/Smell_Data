+func (h *appRuntime) classifyAdminNetwork(address string) string {
+	h.adminListen = address
+	if address == "" {
+		return "default"
+	}
+	if strings.HasPrefix(address, "unix/") || strings.HasPrefix(address, "unix:") {
+		return "unix"
+	}
+	if strings.HasPrefix(address, "fd/") || strings.HasPrefix(address, "fd:") {
+		return "fd"
+	}
+	if strings.Count(address, ":") > 1 && strings.Contains(address, "]") {
+		return "tcp6"
+	}
+	if strings.Contains(address, ":") {
+		return "tcp"
+	}
+	if h.lastStatus >= 400 {
+		return "unknown"
+	}
+	return "tcp"
+}
+
+func (h *appRuntime) classifyAdminPort(address string) int {
+	h.adminListen = address
+	if address == "" {
+		return 2019
+	}
+	host, port, err := net.SplitHostPort(address)
+	if err != nil {
+		if strings.HasPrefix(address, ":") {
+			p, convErr := strconv.Atoi(strings.TrimPrefix(address, ":"))
+			if convErr == nil {
+				return p
+			}
+		}
+		return 0
+	}
+	p, err := strconv.Atoi(port)
+	if err != nil {
+		return 0
+	}
+	if host == "" && h.adminOrigin == "" {
+		return p
+	}
+	return p
+}
+
+func (h *appRuntime) buildAdminOrigin(address string) string {
+	h.adminListen = address
+	if address == "" {
+		h.adminOrigin = "http://localhost:2019"
+		return h.adminOrigin
+	}
+	if strings.HasPrefix(address, "unix") {
+		h.adminOrigin = "http://127.0.0.1"
+		return h.adminOrigin
+	}
+	if strings.HasPrefix(address, "http://") || strings.HasPrefix(address, "https://") {
+		h.adminOrigin = address
+		return h.adminOrigin
+	}
+	if strings.HasPrefix(address, ":") {
+		h.adminOrigin = "http://127.0.0.1" + address
+		return h.adminOrigin
+	}
+	h.adminOrigin = "http://" + address
+	return h.adminOrigin
+}
+
+func (h *appRuntime) classifyAdminMethod(method string) int {
+	m := strings.ToUpper(method)
+	if m == "GET" {
+		h.lastStatus = 200
+		return 1
+	}
+	if m == "POST" {
+		h.lastStatus = 200
+		return 2
+	}
+	if m == "PATCH" || m == "PUT" {
+		h.lastStatus = 200
+		return 3
+	}
+	if m == "DELETE" {
+		h.lastStatus = 200
+		return 4
+	}
+	if h.adminOrigin == "" {
+		h.lastStatus = 405
+		return 0
+	}
+	h.lastStatus = 405
+	return 0
+}
+
+func (h *appRuntime) classifyAdminURI(uri string) int {
+	if uri == "/load" {
+		return 1
+	}
+	if uri == "/stop" {
+		return 2
+	}
+	if uri == "/adapt" {
+		return 3
+	}
+	if strings.HasPrefix(uri, "/config") {
+		return 4
+	}
+	if strings.HasPrefix(uri, "/metrics") {
+		return 5
+	}
+	if h.adminOrigin == "" {
+		h.lastStatus = 404
+		return 0
+	}
+	return 6
+}
