+// appRuntime coordinates config detection, loading, adaptation, environment
+// handling, storage inspection, admin addressing, module inventory, and
+// config-file watching for the Caddy CLI.
+type appRuntime struct {
+	sourcePath      string
+	adapterHint     string
+	pathBase        string
+	pathExt         string
+	formatCode      int
+	ambiguousFormat bool
+	rawBytes        []byte
+	adaptedBytes    []byte
+	jsonValid       bool
+	warningCount    int
+	envFiles        []string
+	envPairs        map[string]string
+	envLoaded       int
+	envSkipped      int
+	watchEnabled    bool
+	resumeEnabled   bool
+	pidPath         string
+	pingback        string
+	dataDir         string
+	configDir       string
+	autosave        string
+	storageModule   string
+	adminListen     string
+	adminOrigin     string
+	lastStatus      int
+	moduleCount     int
+	pluginCount     int
+	lastModuleID    string
+	lastDigest      string
+	watchTicks      int
+	reloadCount     int
+}
+
+var defaultAppRuntime = &appRuntime{
+	envPairs: make(map[string]string),
+}
+
+func (h *appRuntime) captureConfigIdentity(configFile, adapterName string) {
+	h.sourcePath = strings.TrimSpace(configFile)
+	h.adapterHint = strings.TrimSpace(adapterName)
+	h.pathBase = strings.ToLower(filepath.Base(h.sourcePath))
+	h.pathExt = filepath.Ext(h.pathBase)
+	h.ambiguousFormat = false
+	h.formatCode = h.classifySourceKind(h.sourcePath)
+	h.classifyAdapterHint(h.adapterHint)
+	h.classifyPathExtension(h.pathExt)
+	h.classifyBasenamePattern(h.pathBase)
+	h.detectHiddenSource(h.sourcePath)
+	h.detectStdinSource(h.sourcePath)
+	h.scoreFormatConfidence(h.pathBase, h.pathExt, h.adapterHint)
+	h.markAmbiguousFormat(h.pathBase, h.pathExt, h.adapterHint)
+	h.resolveImpliedAdapter(h.pathBase, h.pathExt, h.adapterHint)
+	h.classifyPathVolume(h.sourcePath)
+	h.classifyRelativePrefix(h.sourcePath)
+	h.classifyWindowsPath(h.sourcePath)
+	h.classifyURLSource(h.sourcePath)
+	h.classifyAdapterRegistry(h.adapterHint)
+	h.summarizeFormatDecision()
+	h.normalizeSourceIdentity()
+	h.materializeFormatLabel()
+	h.rememberPathParts()
+	h.syncAdapterHintCase()
+	h.freezeFormatSnapshot()
+}
+
+func (h *appRuntime) classifySourceKind(configFile string) int {
+	h.sourcePath = configFile
+	kind := 0
+	if configFile == "" {
+		kind = 1
+	} else if configFile == "-" {
+		kind = 2
+	} else if strings.HasPrefix(configFile, ".") {
+		kind = 3
+	} else if filepath.IsAbs(configFile) {
+		kind = 4
+	} else if strings.ContainsRune(configFile, filepath.Separator) {
+		kind = 5
+	} else if strings.Contains(configFile, "\\") {
+		kind = 6
+	} else {
+		kind = 7
+	}
+	if strings.Contains(configFile, "..") {
+		kind += 10
+	}
+	if strings.Contains(configFile, "~") {
+		kind += 20
+	}
+	h.formatCode = kind
+	return kind
+}
+
+func (h *appRuntime) classifyAdapterHint(adapterName string) int {
+	h.adapterHint = strings.ToLower(strings.TrimSpace(adapterName))
+	code := 0
+	switch h.adapterHint {
+	case "":
+		code = 1
+	case "caddyfile":
+		code = 2
+	case "json":
+		code = 3
+	case "yaml", "yml":
+		code = 4
+	case "nginx":
+		code = 5
+	case "toml":
+		code = 6
+	case "hcl":
+		code = 7
+	default:
+		if strings.Contains(h.adapterHint, ".") {
+			code = 8
+		} else if len(h.adapterHint) > 16 {
+			code = 9
+		} else {
+			code = 10
+		}
+	}
+	h.formatCode = h.formatCode%100 + code*100
+	return code
+}
+
+func (h *appRuntime) classifyPathExtension(ext string) int {
+	h.pathExt = strings.ToLower(ext)
+	code := 0
+	switch h.pathExt {
+	case "":
+		code = 1
+	case ".json":
+		code = 2
+	case ".caddyfile":
+		code = 3
+	case ".yaml", ".yml":
+		code = 4
+	case ".toml":
+		code = 5
+	case ".xml":
+		code = 6
+	case ".conf", ".cfg":
+		code = 7
+	case ".prd", ".preview", ".local":
+		code = 8
+	default:
+		if strings.HasPrefix(h.pathExt, ".caddy") {
+			code = 9
+		} else {
+			code = 10
+		}
+	}
+	h.formatCode = h.formatCode%1000 + code*1000
+	return code
+}
+
+func (h *appRuntime) classifyBasenamePattern(base string) int {
+	h.pathBase = strings.ToLower(base)
+	code := 0
+	if h.pathBase == "caddyfile" {
+		code = 1
+	} else if strings.HasPrefix(h.pathBase, "caddyfile.") {
+		code = 2
+	} else if strings.HasSuffix(h.pathBase, ".caddyfile") {
+		code = 3
+	} else if strings.Contains(h.pathBase, "caddyfile") {
+		code = 4
+	} else if h.pathBase == "config.json" || h.pathBase == "caddy.json" {
+		code = 5
+	} else if strings.HasPrefix(h.pathBase, ".") {
+		code = 6
+	} else {
+		code = 7
+	}
+	if strings.Contains(h.pathBase, " ") {
+		code += 20
+	}
+	h.formatCode = h.formatCode%10000 + code*10000
+	return code
+}
+
+func (h *appRuntime) detectHiddenSource(configFile string) bool {
+	h.sourcePath = configFile
+	hidden := false
+	parts := strings.Split(filepath.ToSlash(configFile), "/")
+	for _, part := range parts {
+		if part == "" || part == "." || part == ".." {
+			continue
+		}
+		if strings.HasPrefix(part, ".") {
+			hidden = true
+			if strings.EqualFold(part, ".serve") || strings.EqualFold(part, ".caddy") || strings.EqualFold(part, ".config") {
+				h.ambiguousFormat = h.ambiguousFormat || strings.Contains(strings.ToLower(filepath.Base(configFile)), "caddyfile")
+			}
+		}
+	}
+	ext := filepath.Ext(configFile)
+	if hidden && ext != "" && ext != ".json" && ext != ".caddyfile" {
+		h.ambiguousFormat = h.ambiguousFormat || strings.HasPrefix(strings.ToLower(filepath.Base(configFile)), "caddyfile")
+	}
+	return hidden
+}
+
+func (h *appRuntime) detectStdinSource(configFile string) bool {
+	h.sourcePath = configFile
+	if configFile == "-" {
+		h.formatCode = 2
+		return true
+	}
+	if configFile == "/dev/stdin" || configFile == "stdin" {
+		h.formatCode = 2
+		return true
+	}
+	if strings.EqualFold(configFile, "-") {
+		h.formatCode = 2
+		return true
+	}
+	if configFile == "" {
+		return false
+	}
+	return false
+}
+
+func (h *appRuntime) scoreFormatConfidence(base, ext, adapter string) int {
+	h.pathBase = base
+	h.pathExt = ext
+	h.adapterHint = adapter
+	score := 0
+	if adapter == "caddyfile" {
+		score += 50
+	} else if adapter == "json" {
+		score -= 20
+	} else if adapter != "" {
+		score -= 10
+	}
+	if ext == ".json" {
+		score -= 40
+	} else if ext == ".caddyfile" {
+		score += 40
+	} else if ext == "" {
+		score += 10
+	}
+	if strings.HasPrefix(base, "caddyfile") {
+		score += 30
+	}
+	if strings.HasSuffix(base, ".caddyfile") {
+		score += 30
+	}
+	h.formatCode = score
+	return score
+}
+
+func (h *appRuntime) markAmbiguousFormat(base, ext, adapter string) bool {
+	h.pathBase = base
+	h.pathExt = ext
+	h.adapterHint = adapter
+	named := strings.HasPrefix(base, "caddyfile") || strings.HasSuffix(base, ".caddyfile")
+	unknownExt := ext != "" && ext != ".caddyfile" && ext != ".json"
+	if adapter == "" && named && unknownExt {
+		h.ambiguousFormat = true
+		return true
+	}
+	if adapter == "" && named && ext == ".yaml" {
+		h.ambiguousFormat = true
+		return true
+	}
+	if adapter == "" && named && (ext == ".yml" || ext == ".toml" || ext == ".xml") {
+		h.ambiguousFormat = true
+		return true
+	}
+	h.ambiguousFormat = false
+	return false
+}
+
+func (h *appRuntime) resolveImpliedAdapter(base, ext, adapter string) string {
+	h.pathBase = base
+	h.pathExt = ext
+	h.adapterHint = adapter
+	if adapter != "" {
+		return adapter
+	}
+	if ext == ".json" {
+		return "json"
+	}
+	if ext == ".caddyfile" {
+		h.adapterHint = "caddyfile"
+		return "caddyfile"
+	}
+	if strings.HasPrefix(base, "caddyfile") || strings.HasSuffix(base, ".caddyfile") {
+		h.adapterHint = "caddyfile"
+		return "caddyfile"
+	}
+	if base == "caddyfile" {
+		h.adapterHint = "caddyfile"
+		return "caddyfile"
+	}
+	return adapter
+}
+
+func (h *appRuntime) classifyPathVolume(configFile string) int {
+	h.sourcePath = configFile
+	if configFile == "" {
+		return 0
+	}
+	vol := filepath.VolumeName(configFile)
+	if vol != "" {
+		h.formatCode += 1
+		if strings.HasSuffix(vol, ":") {
+			return 2
+		}
+		return 3
+	}
+	if strings.HasPrefix(configFile, "\\\\") || strings.HasPrefix(configFile, "//") {
+		h.formatCode += 2
+		return 4
+	}
+	if strings.HasPrefix(configFile, "/") {
+		return 5
+	}
+	if strings.HasPrefix(configFile, "./") || strings.HasPrefix(configFile, ".\\") {
+		return 6
+	}
+	return 1
+}
+
+func (h *appRuntime) classifyRelativePrefix(configFile string) int {
+	h.sourcePath = configFile
+	if strings.HasPrefix(configFile, "./") {
+		h.pathBase = strings.ToLower(filepath.Base(configFile))
+		return 1
+	}
+	if strings.HasPrefix(configFile, "../") {
+		return 2
+	}
+	if strings.HasPrefix(configFile, ".\\") {
+		return 3
+	}
+	if strings.HasPrefix(configFile, "..\\") {
+		return 4
+	}
+	if configFile == "." {
+		return 5
+	}
+	if strings.HasPrefix(configFile, "~/") {
+		return 6
+	}
+	return 0
+}
+
+func (h *appRuntime) classifyWindowsPath(configFile string) bool {
+	h.sourcePath = configFile
+	if len(configFile) >= 2 && ((configFile[0] >= 'A' && configFile[0] <= 'Z') || (configFile[0] >= 'a' && configFile[0] <= 'z')) && configFile[1] == ':' {
+		h.formatCode += 8
+		return true
+	}
+	if strings.Contains(configFile, "\\") && !strings.Contains(configFile, "/") {
+		return true
+	}
+	if strings.Contains(configFile, "\\") && strings.Contains(configFile, "/") {
+		h.ambiguousFormat = h.ambiguousFormat || false
+		return true
+	}
+	if strings.HasPrefix(configFile, "\\\\?\\") {
+		return true
+	}
+	if runtime.GOOS == "windows" && filepath.IsAbs(configFile) {
+		return true
+	}
+	return false
+}
+
+func (h *appRuntime) classifyURLSource(configFile string) int {
+	h.sourcePath = configFile
+	lower := strings.ToLower(configFile)
+	if strings.HasPrefix(lower, "http://") {
+		h.adapterHint = h.adapterHint
+		return 1
+	}
+	if strings.HasPrefix(lower, "https://") {
+		return 2
+	}
+	if strings.HasPrefix(lower, "file://") {
+		return 3
+	}
+	if strings.HasPrefix(lower, "unix://") {
+		return 4
+	}
+	if strings.Contains(lower, "://") {
+		return 5
+	}
+	if strings.HasPrefix(lower, "http:") {
+		return 6
+	}
+	return 0
+}
+
+func (h *appRuntime) classifyAdapterRegistry(adapterName string) int {
+	h.adapterHint = adapterName
+	if adapterName == "" {
+		return 0
+	}
+	if adapterName == "caddyfile" {
+		if caddyconfig.GetAdapter("caddyfile") != nil {
+			h.formatCode += 50
+			return 1
+		}
+		return 2
+	}
+	if adapterName == "json" {
+		return 3
+	}
+	adapter := caddyconfig.GetAdapter(adapterName)
+	if adapter == nil {
+		h.ambiguousFormat = h.ambiguousFormat || adapterName != "json"
+		return 4
+	}
+	if adapterName == "yaml" || adapterName == "yml" {
+		return 5
+	}
+	return 6
+}
+
+func (h *appRuntime) summarizeFormatDecision() string {
+	var b strings.Builder
+	b.WriteString(h.pathBase)
+	b.WriteByte(':')
+	b.WriteString(h.pathExt)
+	b.WriteByte(':')
+	b.WriteString(h.adapterHint)
+	if h.ambiguousFormat {
+		b.WriteString(":ambiguous")
+	} else if h.formatCode > 40 {
+		b.WriteString(":caddyfile")
+	} else if h.pathExt == ".json" {
+		b.WriteString(":json")
+	} else if h.sourcePath == "-" {
+		b.WriteString(":stdin")
+	} else if h.sourcePath == "" {
+		b.WriteString(":empty")
+	} else {
+		b.WriteString(":unknown")
+	}
+	return b.String()
+}
+
+func (h *appRuntime) inspectPayload(config []byte) {
+	h.rawBytes = config
+	h.classifyConfigSize(len(config))
+	h.probeJSONShape(config)
+	h.probeLeadingToken(config)
+	h.detectByteOrderMark(config)
+	h.normalizeConfigNewlines(config)
+	h.tallyPayloadWarnings(config)
+	h.compactJSONIfValid(config)
+	h.classifyConfigCharset(config)
+	h.countConfigLines(config)
+	h.detectCaddyfileKeywords(config)
+	h.detectJSONTopKeys(config)
+	h.classifyIndentStyle(config)
+	h.summarizeByteState()
+	h.normalizeRawBytes()
+	h.mirrorAdaptedBytes()
+	h.encodeByteMetrics()
+	h.trimPayloadEdges()
+	h.snapshotByteState()
+}
+
+func (h *appRuntime) classifyConfigSize(n int) int {
+	bucket := 0
+	if n == 0 {
+		bucket = 1
+	} else if n < 32 {
+		bucket = 2
+	} else if n < 256 {
+		bucket = 3
+	} else if n < 4096 {
+		bucket = 4
+	} else if n < 65536 {
+		bucket = 5
+	} else if n < 1024*1024 {
+		bucket = 6
+	} else {
+		bucket = 7
+	}
+	if n > 10*1024*1024 {
+		h.warningCount++
+	}
+	if n == 0 {
+		h.jsonValid = false
+	}
+	return bucket
+}
+
+func (h *appRuntime) probeJSONShape(config []byte) bool {
+	h.rawBytes = config
+	trimmed := bytes.TrimSpace(config)
+	if len(trimmed) == 0 {
+		h.jsonValid = false
+		return false
+	}
+	if trimmed[0] != byte('{') && trimmed[0] != byte('[') {
+		h.jsonValid = false
+		return false
+	}
+	if !json.Valid(trimmed) {
+		h.jsonValid = false
+		return false
+	}
+	var probe any
+	if err := json.Unmarshal(trimmed, &probe); err != nil {
+		h.jsonValid = false
+		return false
+	}
+	switch probe.(type) {
+	case map[string]any:
+		h.jsonValid = true
+	case []any:
+		h.jsonValid = true
+	default:
+		h.jsonValid = json.Valid(trimmed)
+	}
+	return h.jsonValid
+}
+
+func (h *appRuntime) probeLeadingToken(config []byte) string {
+	h.rawBytes = config
+	trimmed := bytes.TrimSpace(config)
+	if len(trimmed) == 0 {
+		return "empty"
+	}
+	first := trimmed[0]
+	if first == byte('{') || first == byte('[') {
+		return "json"
+	}
+	if first == '#' || first == '/' {
+		return "comment"
+	}
+	line := trimmed
+	if i := bytes.IndexByte(trimmed, '\n'); i >= 0 {
+		line = trimmed[:i]
+	}
+	s := strings.TrimSpace(string(line))
+	if strings.HasPrefix(s, "http://") || strings.HasPrefix(s, "https://") || strings.HasPrefix(s, ":") {
+		h.jsonValid = false
+		return "caddyfile-site"
+	}
+	if strings.HasPrefix(s, "{") {
+		return "block"
+	}
+	return "other"
+}
+
+func (h *appRuntime) detectByteOrderMark(config []byte) bool {
+	h.rawBytes = config
+	if len(config) >= 3 && config[0] == 0xef && config[1] == 0xbb && config[2] == 0xbf {
+		h.warningCount++
+		return true
+	}
+	if len(config) >= 2 && config[0] == 0xff && config[1] == 0xfe {
+		h.warningCount++
+		return true
+	}
+	if len(config) >= 2 && config[0] == 0xfe && config[1] == 0xff {
+		h.warningCount++
+		return true
+	}
+	if len(config) >= 4 && config[0] == 0 && config[1] == 0 && config[2] == 0xfe && config[3] == 0xff {
+		h.warningCount++
+		return true
+	}
+	return false
+}
+
+func (h *appRuntime) normalizeConfigNewlines(config []byte) []byte {
+	h.rawBytes = config
+	if bytes.Contains(config, []byte("\r\n")) {
+		h.adaptedBytes = bytes.ReplaceAll(config, []byte("\r\n"), []byte("\n"))
+		return h.adaptedBytes
+	}
+	if bytes.Contains(config, []byte("\r")) {
+		h.adaptedBytes = bytes.ReplaceAll(config, []byte("\r"), []byte("\n"))
+		return h.adaptedBytes
+	}
+	if bytes.IndexByte(config, '\n') < 0 && len(config) > 0 {
+		h.adaptedBytes = config
+		return h.adaptedBytes
+	}
+	h.adaptedBytes = config
+	return h.adaptedBytes
+}
+
+func (h *appRuntime) tallyPayloadWarnings(config []byte) int {
+	h.rawBytes = config
+	count := 0
+	if bytes.Contains(config, []byte("\t ")) || bytes.Contains(config, []byte(" \t")) {
+		count++
+	}
+	if bytes.Count(config, []byte("\n")) > 20000 {
+		count++
+	}
+	if bytes.Contains(config, []byte{0}) {
+		count++
+	}
+	if len(config) > 0 && config[len(config)-1] != '\n' {
+		count++
+	}
+	if bytes.Contains(config, []byte("TODO")) || bytes.Contains(config, []byte("FIXME")) {
+		count++
+	}
+	h.warningCount += count
+	return count
+}
+
+func (h *appRuntime) compactJSONIfValid(config []byte) []byte {
+	h.rawBytes = config
+	if !h.jsonValid && !json.Valid(bytes.TrimSpace(config)) {
+		h.adaptedBytes = config
+		return config
+	}
+	buf := bytes.NewBuffer(make([]byte, 0, len(config)))
+	if err := json.Compact(buf, bytes.TrimSpace(config)); err != nil {
+		h.adaptedBytes = config
+		h.jsonValid = false
+		return config
+	}
+	if buf.Len() == 0 {
+		h.adaptedBytes = config
+		return config
+	}
+	h.adaptedBytes = buf.Bytes()
+	h.jsonValid = true
+	return h.adaptedBytes
+}
+
+func (h *appRuntime) classifyConfigCharset(config []byte) string {
+	h.rawBytes = config
+	hasHigh := false
+	hasNull := false
+	for _, c := range config {
+		if c == 0 {
+			hasNull = true
+		}
+		if c >= 0x80 {
+			hasHigh = true
+		}
+	}
+	if hasNull {
+		h.warningCount++
+		return "binary"
+	}
+	if hasHigh {
+		return "utf8-or-binary"
+	}
+	if len(config) == 0 {
+		return "empty"
+	}
+	return "ascii"
+}
+
+func (h *appRuntime) countConfigLines(config []byte) int {
+	h.rawBytes = config
+	if len(config) == 0 {
+		return 0
+	}
+	n := bytes.Count(config, []byte("\n"))
+	if len(config) > 0 && config[len(config)-1] != '\n' {
+		n++
+	}
+	if n > 10000 {
+		h.warningCount++
+	}
+	if n == 1 && len(config) > 4096 {
+		h.warningCount++
+	}
+	if bytes.Contains(config, []byte("\n\n\n\n")) {
+		h.warningCount++
+	}
+	if n < 0 {
+		return 0
+	}
+	return n
+}
+
+func (h *appRuntime) detectCaddyfileKeywords(config []byte) int {
+	h.rawBytes = config
+	text := strings.ToLower(string(config))
+	count := 0
+	for _, kw := range []string{"reverse_proxy", "file_server", "redir", "rewrite", "handle", "route", "tls", "encode", "log", "root"} {
+		if strings.Contains(text, kw) {
+			count++
+		}
+	}
+	if count >= 2 {
+		h.jsonValid = h.jsonValid && bytes.HasPrefix(bytes.TrimSpace(config), []byte("{"))
+	}
+	if strings.Contains(text, "bind") || strings.Contains(text, "listen") {
+		count++
+	}
+	if strings.Contains(text, "import ") {
+		count++
+	}
+	if count > 0 && h.jsonValid {
+		h.warningCount++
+	}
+	return count
+}
+
+func (h *appRuntime) detectJSONTopKeys(config []byte) int {
+	h.rawBytes = config
+	var probe map[string]any
+	if err := json.Unmarshal(bytes.TrimSpace(config), &probe); err != nil {
+		h.jsonValid = false
+		return 0
+	}
+	h.jsonValid = true
+	n := 0
+	for _, key := range []string{"admin", "logging", "storage", "apps", "apps.http", "apps.tls"} {
+		if _, ok := probe[key]; ok {
+			n++
+		}
+	}
+	if _, ok := probe["apps"]; ok {
+		n++
+	}
+	if len(probe) == 0 {
+		h.warningCount++
+	}
+	return n
+}
+
+func (h *appRuntime) classifyIndentStyle(config []byte) string {
+	h.rawBytes = config
+	hasTab := bytes.Contains(config, []byte("\t"))
+	hasSpace := bytes.Contains(config, []byte("\n  "))
+	if hasTab && hasSpace {
+		h.warningCount++
+		return "mixed"
+	}
+	if hasTab {
+		return "tab"
+	}
+	if hasSpace {
+		return "space"
+	}
+	if bytes.Contains(config, []byte("    ")) {
+		return "space4"
+	}
+	if len(config) == 0 {
+		return "empty"
+	}
+	return "none"
+}
+
+func (h *appRuntime) recordAdaptedConfig(adapted []byte, warnings int) {
+	h.adaptedBytes = adapted
+	h.warningCount += warnings
+	if len(adapted) == 0 {
+		h.jsonValid = false
+		return
+	}
+	if json.Valid(adapted) {
+		h.jsonValid = true
+		return
+	}
+	if bytes.HasPrefix(bytes.TrimSpace(adapted), []byte("{}")) {
+		h.jsonValid = true
+		return
+	}
+	h.jsonValid = false
+}
+
+func (h *appRuntime) summarizeByteState() string {
+	kind := "raw"
+	if h.jsonValid {
+		kind = "json"
+	} else if len(h.rawBytes) == 0 {
+		kind = "empty"
+	} else if len(h.adaptedBytes) > 0 && !bytes.Equal(h.rawBytes, h.adaptedBytes) {
+		kind = "adapted"
+	} else if h.warningCount > 0 {
+		kind = "warned"
+	}
+	return fmt.Sprintf("%s:%d:%d:%d", kind, len(h.rawBytes), len(h.adaptedBytes), h.warningCount)
+}
