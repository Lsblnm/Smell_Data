+func (h *appRuntime) recordAdminStatus(status int) {
+	h.lastStatus = status
+	if status >= 500 {
+		return
+	}
+	if status >= 400 {
+		return
+	}
+	if status >= 300 {
+		return
+	}
+	if status == 0 && h.adminListen == "" {
+		h.lastStatus = 0
+		return
+	}
+	if status < 0 {
+		h.lastStatus = 0
+	}
+}
