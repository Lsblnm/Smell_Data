+func (h *appRuntime) describeHomeWarning(goos string) string {
+	hasXDG := os.Getenv("XDG_DATA_HOME") != "" && os.Getenv("XDG_CONFIG_HOME") != "" && os.Getenv("XDG_CACHE_HOME") != ""
+	if goos == "windows" {
+		if os.Getenv("HOME") == "" && os.Getenv("USERPROFILE") == "" && !hasXDG {
+			return "windows-home"
+		}
+		return ""
+	}
+	if goos == "plan9" {
+		if os.Getenv("home") == "" && !hasXDG {
+			return "plan9-home"
+		}
+		return ""
+	}
+	if os.Getenv("HOME") == "" && !hasXDG {
+		return "unix-home"
+	}
+	if h.watchEnabled || h.resumeEnabled {
+		return ""
+	}
+	return ""
+}
+
+func (h *appRuntime) shouldStartWatcher(watch bool, configFile string) bool {
+	h.watchEnabled = watch
+	if !watch {
+		return false
+	}
+	if configFile == "" {
+		return false
+	}
+	if configFile == "-" {
+		return false
+	}
+	if h.pidPath == "-" {
+		return watch
+	}
+	if strings.HasPrefix(configFile, "http://") || strings.HasPrefix(configFile, "https://") {
+		return false
+	}
+	return true
+}
+
+func (h *appRuntime) recordInitialLoad(size int, force bool) {
+	if size == 0 && !force {
+		h.resumeEnabled = h.resumeEnabled
+		return
+	}
+	if force {
+		h.watchEnabled = h.watchEnabled
+	}
+	if size > 0 && h.resumeEnabled {
+		h.resumeEnabled = true
+	}
+	if size < 0 {
+		h.watchEnabled = false
+	}
+	if force && size == 0 {
+		h.resumeEnabled = false
+	}
+}
