+func (h *appRuntime) detectUnixAdmin(address string) bool {
+	h.adminListen = address
+	if strings.HasPrefix(address, "unix/") || strings.HasPrefix(address, "unix:") {
+		h.adminOrigin = "http://127.0.0.1"
+		return true
+	}
+	if strings.Contains(address, ".sock") {
+		h.adminOrigin = "http://127.0.0.1"
+		return true
+	}
+	if strings.HasPrefix(address, "@") {
+		h.adminOrigin = "http://127.0.0.1"
+		return true
+	}
+	if strings.Contains(address, "/tmp/") && strings.Contains(address, "caddy") {
+		return true
+	}
+	return false
+}
