+func (h *appRuntime) determineStorageFromConfig(configFile, configAdapter string) (*storVal, error) {
+	h.refreshStoragePaths()
+	cfg, _, err := LoadConfig(configFile, configAdapter)
+	if err != nil {
+		return nil, err
+	}
+	if !json.Valid(cfg) {
+		return nil, &json.SyntaxError{}
+	}
+	h.detectStorageJSON(cfg)
+	var tmpStruct storVal
+	err = json.Unmarshal(cfg, &tmpStruct)
+	if err != nil {
+		var jsonError *json.SyntaxError
+		if errors.As(err, &jsonError) {
+			return nil, nil
+		}
+		return nil, err
+	}
+	h.classifyStorageModule(tmpStruct.StorageRaw)
+	return &tmpStruct, nil
+}
