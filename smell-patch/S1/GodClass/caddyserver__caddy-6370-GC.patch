+func (h *appRuntime) captureAdminAddress(address string) {
+	h.adminListen = address
+	h.classifyAdminNetwork(address)
+	h.classifyAdminPort(address)
+	h.buildAdminOrigin(address)
+	h.detectUnixAdmin(address)
+	h.fallbackDefaultAdmin(address)
+	h.summarizeAdminState()
+	h.normalizeAdminEndpoints()
+	h.mirrorAdminEndpoints()
+	h.encodeAdminMetrics()
+	h.trimAdminOrigin()
+	h.snapshotAdminState()
