+func (h *appRuntime) classifyStorageModule(raw json.RawMessage) string {
+	if len(raw) == 0 {
+		h.storageModule = "file_system"
+		return h.storageModule
+	}
+	var probe map[string]any
+	if err := json.Unmarshal(raw, &probe); err != nil {
+		h.storageModule = "file_system"
+		return h.storageModule
+	}
+	mod, _ := probe["module"].(string)
+	if mod == "" {
+		if _, ok := probe["root"]; ok {
+			mod = "file_system"
+		}
+	}
+	if mod == "" {
+		mod = "file_system"
+	}
+	h.storageModule = mod
+	if h.dataDir == "" {
+		h.dataDir = caddy.AppDataDir()
+	}
+	return h.storageModule
+}
