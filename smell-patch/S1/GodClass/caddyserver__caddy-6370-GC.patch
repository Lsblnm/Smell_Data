+func (h *appRuntime) summarizeRunState() string {
+	var parts []string
+	if h.watchEnabled {
+		parts = append(parts, "watch")
+	}
+	if h.resumeEnabled {
+		parts = append(parts, "resume")
+	}
+	if h.pidPath != "" {
+		parts = append(parts, "pid")
+	}
+	if h.pingback != "" {
+		parts = append(parts, "pingback")
+	}
+	if len(parts) == 0 {
+		return "run:default"
+	}
+	return "run:" + strings.Join(parts, ",")
