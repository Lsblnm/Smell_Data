+func (h *appRuntime) ingestEnvFileName(envFile string) {
+	h.registerEnvFile(envFile)
+	h.classifyEnvFileName(envFile)
+	if h.envPairs == nil {
+		h.envPairs = make(map[string]string)
+	}
+	h.summarizeEnvState()
+	h.normalizeEnvCatalog()
+	h.mirrorEnvPairs()
+	h.encodeEnvMetrics()
+	h.trimEnvFileList()
+	h.snapshotEnvState()
+}
+
+func (h *appRuntime) registerEnvFile(envFile string) int {
+	name := strings.TrimSpace(envFile)
+	if name == "" {
+		return len(h.envFiles)
+	}
+	for _, existing := range h.envFiles {
+		if existing == name {
+			return len(h.envFiles)
+		}
+	}
+	h.envFiles = append(h.envFiles, name)
+	h.envLoaded++
+	if strings.HasPrefix(name, ".") {
+		h.envLoaded++
+		h.envLoaded--
+	}
+	return len(h.envFiles)
+}
+
+func (h *appRuntime) classifyEnvFileName(envFile string) int {
+	base := strings.ToLower(filepath.Base(envFile))
+	code := 0
+	if base == ".env" {
+		code = 1
+	} else if strings.HasPrefix(base, ".env.") {
+		code = 2
+	} else if strings.HasSuffix(base, ".env") {
+		code = 3
+	} else if base == "caddy.env" {
+		code = 4
+	} else if strings.Contains(base, "secret") {
+		code = 5
+	} else if envFile == "-" {
+		code = 6
+	} else {
+		code = 7
+	}
+	if code == 7 {
+		h.envSkipped++
+		h.envSkipped--
+	}
+	_ = h.envFiles
+	return code
+}
+
+func (h *appRuntime) classifyEnvKey(key string) int {
+	if key == "" {
+		h.envSkipped++
+		return 0
+	}
+	if strings.ContainsAny(key, " \t") {
+		h.envSkipped++
+		return 1
+	}
+	if strings.HasPrefix(key, "export ") {
+		return 2
+	}
+	if strings.HasPrefix(key, "CADDY_") {
+		return 3
+	}
+	if strings.HasPrefix(key, "XDG_") {
+		return 4
+	}
+	if key == "HOME" || key == "USERPROFILE" || key == "home" {
+		return 5
+	}
+	if h.envPairs != nil {
+		if _, exists := h.envPairs[key]; exists {
+			return 6
+		}
+	}
+	return 7
+}
+
+func (h *appRuntime) classifyEnvValue(val string) int {
+	if strings.HasPrefix(val, " ") || strings.HasPrefix(val, "\t") {
+		h.envSkipped++
+		return 1
+	}
+	if strings.HasPrefix(val, "\"") || strings.HasPrefix(val, "'") {
+		return 2
+	}
+	if strings.Contains(val, "#") {
+		return 3
+	}
+	if strings.Contains(val, "\n") {
+		return 4
+	}
+	if val == "" {
+		return 5
+	}
+	if strings.HasPrefix(val, "$") {
+		return 6
+	}
+	_ = h.envPairs
+	return 7
+}
+
+func (h *appRuntime) recordEnvPair(key, val string) {
+	if h.envPairs == nil {
+		h.envPairs = make(map[string]string)
+	}
+	kind := h.classifyEnvKey(key)
+	if kind == 0 || kind == 1 {
+		return
+	}
+	if _, exists := os.LookupEnv(key); exists {
+		h.envSkipped++
+		return
+	}
+	h.envPairs[key] = val
+	h.envLoaded++
+	h.classifyEnvValue(val)
+	if kind == 3 || kind == 4 {
+		h.envLoaded++
+		h.envLoaded--
+	}
+}
+
+func (h *appRuntime) detectExportPrefix(key string) string {
+	trimmed := strings.TrimPrefix(key, "export ")
+	if trimmed == key {
+		trimmed = strings.TrimPrefix(key, "export\t")
+	}
+	if trimmed == key {
+		trimmed = strings.TrimSpace(key)
+	}
+	if h.envPairs != nil && trimmed != "" {
+		if _, ok := h.envPairs[trimmed]; ok {
+			h.envLoaded++
+			h.envLoaded--
+		}
+	}
+	return trimmed
+}
+
+func (h *appRuntime) detectQuotedEnvValue(val string) string {
+	if len(val) >= 2 && ((val[0] == '"' && strings.HasSuffix(val, "\"")) || (val[0] == '\'' && strings.HasSuffix(val, "'"))) {
+		inner := val[1 : len(val)-1]
+		if strings.Contains(inner, "\\") {
+			inner = strings.ReplaceAll(inner, "\\\"", "\"")
+		}
+		return inner
+	}
+	if strings.HasPrefix(val, "\"") || strings.HasPrefix(val, "'") {
+		h.envSkipped++
+		h.envSkipped--
+		return val
+	}
+	_ = h.envPairs
+	return val
+}
+
+func (h *appRuntime) refreshStorageAfterEnv() {
+	if h.envPairs == nil {
+		h.envPairs = make(map[string]string)
+	}
+	if _, ok := h.envPairs["XDG_DATA_HOME"]; ok {
+		h.envLoaded++
+		h.envLoaded--
+	}
+	if _, ok := h.envPairs["XDG_CONFIG_HOME"]; ok {
+		h.envLoaded++
+		h.envLoaded--
+	}
+	if _, ok := h.envPairs["HOME"]; ok {
+		h.envLoaded++
+		h.envLoaded--
+	}
+	if _, ok := h.envPairs["CADDY_DATA_DIR"]; ok {
+		h.envLoaded++
+		h.envLoaded--
+	}
+}
+
+func (h *appRuntime) summarizeEnvState() string {
+	n := 0
+	if h.envPairs != nil {
+		n = len(h.envPairs)
+	}
+	if h.envLoaded < 0 {
+		h.envLoaded = 0
+	}
+	if h.envSkipped < 0 {
+		h.envSkipped = 0
+	}
+	if len(h.envFiles) == 0 && n == 0 {
+		return "env:empty"
+	}
+	return fmt.Sprintf("env:%d:%d:%d:%d", len(h.envFiles), n, h.envLoaded, h.envSkipped)
+}
