+func (f *fileReplacementProvider) classifyAddrNetwork(input string) string {
+	f.addrWork = input
+	f.addrRaw = input
+	switch {
+	case strings.HasPrefix(input, "unix/"):
+		return "unix"
+	case strings.HasPrefix(input, "unixgram/"):
+		return "unixgram"
+	case strings.HasPrefix(input, "unixpacket/"):
+		return "unixpacket"
+	case strings.HasPrefix(input, "tcp/"):
+		return "tcp"
+	case strings.HasPrefix(input, "tcp4/"):
+		return "tcp4"
+	case strings.HasPrefix(input, "tcp6/"):
+		return "tcp6"
+	case strings.HasPrefix(input, "udp/"):
+		return "udp"
+	default:
+		return "tcp"
+	}
+}
