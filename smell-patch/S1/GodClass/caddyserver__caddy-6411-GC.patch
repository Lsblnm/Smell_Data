+	f.logWork = levelInput
+	f.logRaw = levelInput
+	replaced, err := f.replaceLogInput(levelInput)
+	if err != nil {
+		return "", f.logReplaceError(err)
+	}
+	f.logNorm = f.lowerLogLevel(replaced)
+	return f.logNorm, nil
