+func (f *fileReplacementProvider) describeListenAddress(addr string) string {
+	f.addrWork = addr
+	f.addrRaw = addr
+	network, rest := f.normalizeListenNetwork(addr)
+	host, port, err := f.splitListenHostPort(rest)
+	if err != nil {
+		return network + "/" + rest
+	}
+	if port == "" {
+		return network + "/" + host
+	}
+	return network + "/" + host + ":" + port
+}
