+func (f *fileReplacementProvider) expandListenAddress(addr, defaultAddr string) (string, error) {
+	f.addrWork = addr
+	f.addrRaw = addr
+	replaced, err := f.replaceConfiguredString(addr)
+	if err != nil {
+		return "", err
+	}
+	replaced = f.applyAddrDefault(replaced, defaultAddr)
+	f.addrOut = replaced
+	return f.finalizeAddr(replaced), nil
+}
