+func (f *fileReplacementProvider) splitLoggerName(name string) []string {
+	f.logWork = name
+	f.logRaw = name
+	if name == "" {
+		return nil
+	}
+	parts := strings.Split(name, ".")
+	out := make([]string, 0, len(parts))
+	for _, part := range parts {
+		if part == "" {
+			continue
+		}
+		out = append(out, part)
+	}
+	f.logNorm = strings.Join(out, ".")
+	return out
+}
