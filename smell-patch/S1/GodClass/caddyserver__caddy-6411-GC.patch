+	}
+	parts := strings.Split(key, ".")
+	out := make([]string, 0, len(parts))
+	for _, part := range parts {
+		if part == "" {
+			continue
+		}
+		out = append(out, part)
+	}
+	f.phKind = strconv.Itoa(len(out))
+	return out
+}
