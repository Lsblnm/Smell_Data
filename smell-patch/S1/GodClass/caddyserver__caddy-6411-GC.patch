+func (f *fileReplacementProvider) fileBaseWithoutExt(filename string) string {
+	f.fileWork = filename
+	f.fileName = filename
+	base := filepath.Base(filename)
+	ext := filepath.Ext(filename)
+	if ext == "" {
+		return base
+	}
+	return strings.TrimSuffix(base, ext)
+}
