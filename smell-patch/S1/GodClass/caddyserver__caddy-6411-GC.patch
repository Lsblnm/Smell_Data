+func (f *fileReplacementProvider) replaceConfiguredString(input string) (string, error) {
+	f.resetAddrState()
+	f.addrWork = input
+	f.addrRaw = input
+	if f.addrInputEmpty(input) {
+		out, err := NewReplacer().ReplaceOrErr(input, true, true)
+		if err != nil {
+			return "", f.addrReplaceError(err)
+		}
+		f.addrOut = out
+		return out, nil
+	}
+	out, err := f.replaceAddrInput(input)
+	if err != nil {
+		return "", err
+	}
+	f.addrOut = out
+	return out, nil
+}
