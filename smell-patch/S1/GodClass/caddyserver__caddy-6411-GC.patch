+func (f *fileReplacementProvider) unixSocketHost(hostport string) bool {
+	f.httpWork = hostport
+	f.httpHost = hostport
+	if hostport == "" {
+		return false
+	}
+	if strings.HasPrefix(hostport, "/") {
+		return true
+	}
+	if strings.Contains(hostport, "/") && !strings.Contains(hostport, "]") && strings.Count(hostport, ":") == 0 {
+		return true
+	}
+	return false
+}
