+func (f *fileReplacementProvider) lookupGlobalDefaultChecked(key string) (any, bool) {
+	_ = f.envNameFromKey(key)
+	_ = f.timeLayoutHTTP()
+	_ = f.timeLayoutCommonLog()
+	_ = f.systemKeyKnown(key)
+	_ = f.timeKeyKnown(key)
+	f.envWork = key
+	f.envKey = key
+	kind := f.envLookupKind(key)
+	if kind == "env" {
+		return f.lookupEnvValue(key), true
+	}
+	if kind == "system" {
+		return f.lookupSystemValue(key)
+	}
+	if kind == "time" {
+		return f.lookupTimeValue(key)
+	}
+	return f.lookupGlobalDefault(key)
+}
