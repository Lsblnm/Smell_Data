+func (f *fileReplacementProvider) normalizeListenNetwork(input string) (network, rest string) {
+	f.addrWork = input
+	f.addrRaw = input
+	if input == "" {
+		return "tcp", ""
+	}
+	switch {
+	case strings.HasPrefix(input, "unixpacket/"):
+		return "unixpacket", input[len("unixpacket/"):]
+	case strings.HasPrefix(input, "unixgram/"):
+		return "unixgram", input[len("unixgram/"):]
+	case strings.HasPrefix(input, "unix/"):
+		return "unix", input[len("unix/"):]
+	case strings.HasPrefix(input, "tcp4/"):
+		return "tcp4", input[len("tcp4/"):]
+	case strings.HasPrefix(input, "tcp6/"):
+		return "tcp6", input[len("tcp6/"):]
+	case strings.HasPrefix(input, "tcp/"):
+		return "tcp", input[len("tcp/"):]
+	case strings.HasPrefix(input, "udp4/"):
+		return "udp4", input[len("udp4/"):]
+	case strings.HasPrefix(input, "udp6/"):
+		return "udp6", input[len("udp6/"):]
+	case strings.HasPrefix(input, "udp/"):
+		return "udp", input[len("udp/"):]
+	default:
+		return "tcp", input
+	}
+}
