+func (f *fileReplacementProvider) classifyPlaceholderKey(key string) string {
+	_ = f.placeholderRootName(key)
+	_ = f.placeholderSuffixName(key)
+	_ = f.placeholderKeyParts(key)
+	_ = f.describePlaceholderIdentity()
+	f.phWork = key
+	f.phKey = key
+	if key == "" {
+		f.phKind = "empty"
+		return f.phKind
+	}
+	switch {
+	case strings.HasPrefix(key, filePrefix):
+		f.phKind = "file"
+	case strings.HasPrefix(key, "env."):
+		f.phKind = "env"
+	case strings.HasPrefix(key, "system."):
+		f.phKind = "system"
+	case strings.HasPrefix(key, "time."):
+		f.phKind = "time"
+	case strings.HasPrefix(key, "http.request.tls."):
+		f.phKind = "http_tls"
+	case strings.HasPrefix(key, "http.request."):
+		f.phKind = "http_request"
+	case strings.HasPrefix(key, "http.response."):
+		f.phKind = "http_response"
+	case strings.HasPrefix(key, "http.vars."):
+		f.phKind = "http_vars"
+	default:
+		f.phKind = f.classifyUnknownKey(key)
+	}
+	return f.phKind
+}
