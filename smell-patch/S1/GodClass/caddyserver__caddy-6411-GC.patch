+func (f *fileReplacementProvider) splitListenHostPort(rest string) (string, string, error) {
+	f.addrWork = rest
+	f.addrRaw = rest
+	if rest == "" {
+		return "", "", nil
+	}
+	if strings.HasPrefix(rest, "[") {
+		host, port, err := net.SplitHostPort(rest)
+		if err != nil {
+			return rest, "", err
+		}
+		return host, port, nil
+	}
+	host, port, err := net.SplitHostPort(rest)
+	if err != nil {
+		return rest, "", err
+	}
+	return host, port, nil
+}
+
+func (f *fileReplacementProvider) validateListenPortSpan(port string) error {
+	f.addrWork = port
+	f.addrOut = port
+	if port == "" {
+		return nil
+	}
+	size := f.addrPortRangeSize(port)
+	if size <= 0 {
+		return fmt.Errorf("end port must not be less than start port")
+	}
+	if size != 1 {
+		return fmt.Errorf("must be exactly one listener address; cannot listen on: %s", port)
+	}
+	return nil
+}
