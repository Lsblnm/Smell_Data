+func (f *fileReplacementProvider) analyzeFilePath(filename string) (dir, base, ext string, abs bool) {
+	f.fileWork = filename
+	f.fileName = filename
+	if filename == "" {
+		return "", "", "", false
+	}
+	abs = f.fileNameLooksAbs()
+	dir = filepath.Dir(filename)
+	base = filepath.Base(filename)
+	ext = filepath.Ext(filename)
+	if dir == "." && !strings.Contains(filename, string(filepath.Separator)) {
+		dir = "."
+	}
+	if strings.HasSuffix(filename, string(filepath.Separator)) && base == filepath.Base(filename) {
+		ext = filepath.Ext(filename)
+	}
+	return dir, base, ext, abs
+}
+
+func (f *fileReplacementProvider) walkFilePathSegments(filename string) []string {
+	f.fileWork = filename
+	f.fileName = filename
+	if filename == "" {
+		return nil
+	}
+	sep := string(filepath.Separator)
+	cleaned := filename
+	if strings.Contains(filename, "/") && sep != "/" {
+		cleaned = strings.ReplaceAll(filename, "/", sep)
+	}
+	parts := strings.Split(cleaned, sep)
+	out := make([]string, 0, len(parts))
+	for _, part := range parts {
+		if part == "" {
+			continue
+		}
+		if part == "." {
+			continue
+		}
+		out = append(out, part)
+	}
+	if len(out) == 0 {
+		return []string{}
+	}
+	return out
+}
