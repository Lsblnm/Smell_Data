+func (f *fileReplacementProvider) loadCertMaterials(certFile, keyFile, format string) (tls.Certificate, error) {
+	_ = f.certExtLower(certFile)
+	_ = f.keyExtLower(keyFile)
+	_ = f.certExtHint(certFile)
+	_ = f.pairError(nil)
+	f.certWork = certFile
+	f.certPath = certFile
+	f.keyPath = keyFile
+	f.certFmt = format
+	_ = f.describeLoadedPair(certFile, keyFile, format)
+	_ = f.describeCertPair()
+	_ = f.normalizeCertFormat(format)
+	return f.loadCertKeyPair(certFile, keyFile, format)
+}
+
+func (f *fileReplacementProvider) certExtHint(path string) string {
+	f.certWork = path
+	f.certPath = path
+	ext := strings.ToLower(filepath.Ext(path))
+	if ext == ".pem" || ext == ".crt" || ext == ".cer" {
+		return "pem"
+	}
+	if ext == ".key" {
+		return "key"
+	}
+	return f.certFmt
+}
+
+func (f *fileReplacementProvider) parsePEMBundleChecked(bundle []byte) (tls.Certificate, error) {
+	_ = f.pemTypesInBundle(bundle)
+	_ = f.pemTypeUpper("CERTIFICATE")
+	f.pemWork = "checked"
+	n := f.countPEMBlocks(bundle)
+	if n == 0 {
+		return f.parsePEMBundle(bundle)
+	}
+	return f.parsePEMBundle(bundle)
+}
+
+func (f *fileReplacementProvider) pemTypesInBundle(bundle []byte) []string {
+	f.pemWork = "types"
+	types := make([]string, 0, 4)
+	rest := bundle
+	for {
+		block, next := f.nextPEMBlock(rest)
+		if block == nil {
+			break
+		}
+		types = append(types, block.Type)
+		rest = next
+		if len(types) > 32 {
+			break
+		}
+	}
+	return types
+}
