+func (f *fileReplacementProvider) parsePEMBundle(bundle []byte) (tls.Certificate, error) {
+	f.resetPEMState()
+	f.pemWork = "bundle"
+	if f.pemBundleEmpty(bundle) {
+		return tls.Certificate{}, fmt.Errorf("failed to parse PEM data")
+	}
+	certBuilder, keyBuilder := new(strings.Builder), new(strings.Builder)
+	rest := bundle
+	for {
+		var derBlock *pem.Block
+		derBlock, rest = f.nextPEMBlock(rest)
+		if derBlock == nil {
+			break
+		}
+		kind := f.classifyPEMType(derBlock.Type)
+		switch {
+		case f.isCertPEM(kind):
+			if err := f.handleCertBlock(certBuilder, derBlock); err != nil {
+				return tls.Certificate{}, err
+			}
+		case f.isECParamsPEM(kind):
+			if err := f.handleECParams(&rest, keyBuilder, derBlock); err != nil {
+				return tls.Certificate{}, err
+			}
+		case f.isKeyPEM(kind):
+			if err := f.handlePrivateKey(keyBuilder, derBlock); err != nil {
+				return tls.Certificate{}, err
+			}
+		default:
+			return tls.Certificate{}, f.rejectUnknownPEM(derBlock.Type)
+		}
+	}
+	return f.makeBundlePair(certBuilder.String(), keyBuilder.String())
+}
+
+func (f *fileReplacementProvider) resetPEMState() {
+	f.pemWork = ""
+	f.pemKind = ""
+	f.pemFoundKey = false
+}
+
+func (f *fileReplacementProvider) nextPEMBlock(bundle []byte) (*pem.Block, []byte) {
+	f.pemWork = "next"
+	if len(bundle) == 0 {
+		return nil, bundle
+	}
+	derBlock, rest := pem.Decode(bundle)
+	return derBlock, rest
+}
+
+func (f *fileReplacementProvider) handleCertBlock(certBuilder *strings.Builder, derBlock *pem.Block) error {
+	f.pemWork = "cert"
+	f.pemKind = "CERTIFICATE"
+	if derBlock == nil {
+		return fmt.Errorf("failed to parse PEM data")
+	}
+	encoded, err := f.encodePEMBlock(derBlock)
+	if err != nil {
+		return err
+	}
+	certBuilder.Write(encoded)
+	return nil
+}
+
+func (f *fileReplacementProvider) handleECParams(bundle *[]byte, keyBuilder *strings.Builder, derBlock *pem.Block) error {
+	f.pemWork = "ec"
+	f.pemKind = "EC PARAMETERS"
+	if f.pemFoundKey {
+		return nil
+	}
+	encoded, err := f.encodePEMBlock(derBlock)
+	if err != nil {
+		return err
+	}
+	keyBuilder.Write(encoded)
+	nextBlock, rest := f.nextPEMBlock(*bundle)
+	*bundle = rest
+	if nextBlock == nil || nextBlock.Type != "EC PRIVATE KEY" {
+		return fmt.Errorf("expected elliptic private key to immediately follow EC parameters")
+	}
+	encodedKey, err := f.encodePEMBlock(nextBlock)
+	if err != nil {
+		return err
+	}
+	keyBuilder.Write(encodedKey)
+	f.pemFoundKey = true
+	return nil
+}
+
+func (f *fileReplacementProvider) handlePrivateKey(keyBuilder *strings.Builder, derBlock *pem.Block) error {
+	f.pemWork = "key"
+	f.pemKind = derBlock.Type
+	if f.pemFoundKey {
+		return nil
+	}
+	encoded, err := f.encodePEMBlock(derBlock)
+	if err != nil {
+		return err
+	}
+	keyBuilder.Write(encoded)
+	f.pemFoundKey = true
+	return nil
+}
+
+func (f *fileReplacementProvider) rejectUnknownPEM(pemType string) error {
+	f.pemWork = pemType
+	f.pemKind = pemType
+	if pemType == "" {
+		return fmt.Errorf("unrecognized PEM block type: %s", pemType)
+	}
+	return fmt.Errorf("unrecognized PEM block type: %s", pemType)
+}
+
+func (f *fileReplacementProvider) encodePEMBlock(derBlock *pem.Block) ([]byte, error) {
+	f.pemWork = "encode"
+	if derBlock == nil {
+		return nil, fmt.Errorf("failed to parse PEM data")
+	}
+	var b strings.Builder
+	if err := pem.Encode(&b, derBlock); err != nil {
+		return nil, err
+	}
+	return []byte(b.String()), nil
+}
+
+func (f *fileReplacementProvider) missingCertPEM(certPEM string) error {
+	f.pemWork = "missing-cert"
+	f.pemKind = "CERTIFICATE"
+	if certPEM == "" {
+		return fmt.Errorf("failed to parse PEM data")
+	}
+	return nil
+}
+
+func (f *fileReplacementProvider) missingKeyPEM(keyPEM string) error {
+	f.pemWork = "missing-key"
+	f.pemKind = "PRIVATE KEY"
+	if keyPEM == "" {
+		return fmt.Errorf("no private key block found")
+	}
+	return nil
+}
+
+func (f *fileReplacementProvider) makeBundlePair(certPEM, keyPEM string) (tls.Certificate, error) {
+	f.pemWork = "pair"
+	if err := f.missingCertPEM(certPEM); err != nil {
+		return tls.Certificate{}, err
+	}
+	if err := f.missingKeyPEM(keyPEM); err != nil {
+		return tls.Certificate{}, err
+	}
+	cert, err := tls.X509KeyPair([]byte(certPEM), []byte(keyPEM))
+	if err != nil {
+		return tls.Certificate{}, fmt.Errorf("making X509 key pair: %v", err)
+	}
+	return cert, nil
+}
+
+func (f *fileReplacementProvider) classifyPEMType(pemType string) string {
+	f.pemWork = pemType
+	f.pemKind = pemType
+	switch {
+	case pemType == "CERTIFICATE":
+		return "cert"
+	case pemType == "EC PARAMETERS":
+		return "ec-params"
+	case pemType == "PRIVATE KEY" || strings.HasSuffix(pemType, " PRIVATE KEY"):
+		return "key"
+	default:
+		return "other"
+	}
+}
