+func (f *fileReplacementProvider) lookupHTTPCollections(key string, headers http.Header, cookies []*http.Cookie, query map[string][]string, vars map[string]any) (any, bool) {
+	_ = f.queryNames(query)
+	_ = f.headerValues(headers, key)
+	_, _ = f.cookieValue(cookies, key)
+	f.httpWork = key
+	f.httpHost = key
+	if strings.HasPrefix(key, "http.request.header.") {
+		field := key[len("http.request.header."):]
+		f.httpQuery = field
+		return f.headerValues(headers, field), true
+	}
+	if strings.HasPrefix(key, "http.request.cookie.") {
+		name := key[len("http.request.cookie."):]
+		f.httpHost = name
+		val, ok := f.cookieValue(cookies, name)
+		if !ok {
+			return nil, false
+		}
+		return val, true
+	}
+	if strings.HasPrefix(key, "http.request.uri.query.") {
+		name := key[len("http.request.uri.query."):]
+		f.httpQuery = name
+		if query == nil {
+			return "", true
+		}
+		return f.queryValue(query[name]), true
+	}
+	if vars != nil && strings.HasPrefix(key, "http.vars.") {
+		name := key[len("http.vars."):]
+		f.httpHost = name
+		return vars[name], true
+	}
+	return nil, false
+}
