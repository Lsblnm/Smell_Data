+func (f *fileReplacementProvider) tlsCipherOrEmpty(cs *tls.ConnectionState) string {
+	f.tlsWork = "cipher"
+	f.tlsField = "cipher_suite"
+	if cs == nil {
+		return ""
+	}
+	return f.connCipher(cs)
+}
