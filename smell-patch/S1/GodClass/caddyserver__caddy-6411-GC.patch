+	if f.logInputEmpty(input) {
+		out, err := NewReplacer().ReplaceOrErr(input, true, true)
+		return out, err
+	}
+	if f.logInputHasNoPlaceholder(input) {
+		return input, nil
+	}
+	return NewReplacer().ReplaceOrErr(input, true, true)
