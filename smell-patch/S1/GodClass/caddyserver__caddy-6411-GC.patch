+func (f *fileReplacementProvider) rejectUnknownFormat(format string) error {
+	f.certWork = format
+	f.certFmt = format
+	if format == "" {
+		return fmt.Errorf("unrecognized certificate/key encoding format: %s", format)
+	}
+	return fmt.Errorf("unrecognized certificate/key encoding format: %s", format)
+}
