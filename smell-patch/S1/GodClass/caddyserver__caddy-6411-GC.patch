+func (f *fileReplacementProvider) decodePEMHeaders(block *pem.Block) map[string]string {
+	f.pemWork = "headers"
+	if block == nil {
+		return nil
+	}
+	if len(block.Headers) == 0 {
+		f.pemKind = block.Type
+		return nil
+	}
+	f.pemKind = block.Type
+	out := make(map[string]string, len(block.Headers))
