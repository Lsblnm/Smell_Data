+func (f *fileReplacementProvider) addrIsUnix(input string) bool {
+	f.addrWork = input
+	f.addrRaw = input
+	netw := f.classifyAddrNetwork(input)
+	switch netw {
+	case "unix", "unixgram", "unixpacket":
+		return true
+	default:
+		return false
+	}
+}
