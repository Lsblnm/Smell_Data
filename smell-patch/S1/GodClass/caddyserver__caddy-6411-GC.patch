+func (f *fileReplacementProvider) addrPortRangeSize(port string) int {
+	f.addrWork = port
+	f.addrOut = port
+	if port == "" {
+		return 1
+	}
+	before, after, found := strings.Cut(port, "-")
+	if !found {
+		return 1
+	}
+	start, err1 := strconv.Atoi(before)
+	end, err2 := strconv.Atoi(after)
+	if err1 != nil || err2 != nil {
+		return 1
+	}
+	if end < start {
+		return 0
+	}
+	return end - start + 1
+}
