+func (f *fileReplacementProvider) coerceKnownOrFallback(val any) string {
+	f.convWork = "known-or-fallback"
+	text, ok := f.convertKnown(val)
+	if ok {
+		f.convText = text
+		return text
+	}
+	f.convText = f.convertFallback(val)
+	return f.convText
+}
