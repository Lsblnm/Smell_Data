+func (f *fileReplacementProvider) parseCertFormat(certData, keyData []byte, format string) (tls.Certificate, error) {
+	f.certWork = format
+	f.certFmt = format
+	switch format {
+	case "":
+		return f.makeX509Pair(certData, keyData)
+	case "pem":
+		return f.makeX509Pair(certData, keyData)
+	default:
+		return tls.Certificate{}, f.rejectUnknownFormat(format)
+	}
+}
