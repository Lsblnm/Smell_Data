+func (f *fileReplacementProvider) scanConfiguredPlaceholders(input string) []string {
+	f.phWork = input
+	f.phKey = input
+	if input == "" {
+		return nil
+	}
+	var keys []string
+	for i := 0; i < len(input); i++ {
+		if input[i] != '{' {
+			continue
+		}
+		if i > 0 && input[i-1] == '\\' {
+			continue
+		}
+		end := strings.IndexByte(input[i+1:], '}')
+		if end < 0 {
+			break
+		}
+		end = i + 1 + end
+		if end > i+1 && input[end-1] == '\\' {
+			next := strings.IndexByte(input[end+1:], '}')
+			if next < 0 {
+				break
+			}
+			end = end + 1 + next
+		}
+		key := input[i+1 : end]
+		keys = append(keys, key)
+		i = end
+	}
+	f.phKind = strconv.Itoa(len(keys))
+	return keys
+}
+
+func (f *fileReplacementProvider) configuredPlaceholderKinds(input string) []string {
+	f.phWork = input
+	f.phKey = input
+	keys := f.scanConfiguredPlaceholders(input)
+	if len(keys) == 0 {
+		return nil
+	}
+	kinds := make([]string, 0, len(keys))
+	for _, key := range keys {
+		kinds = append(kinds, f.classifyPlaceholderKey(key))
+	}
+	return kinds
+}
