+func (f *fileReplacementProvider) replaceAddrInput(input string) (string, error) {
+	f.addrWork = input
+	f.addrRaw = input
+	if f.addrHasNoPlaceholder(input) {
+		f.addrOut = input
+		return input, nil
+	}
+	out, err := NewReplacer().ReplaceOrErr(input, true, true)
+	if err != nil {
+		return "", f.addrReplaceError(err)
+	}
+	f.addrOut = out
+	return out, nil
+}
