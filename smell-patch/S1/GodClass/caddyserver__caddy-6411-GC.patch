+func (f *fileReplacementProvider) remotePrefix(host, spec string) (string, bool) {
+	f.httpWork = host
+	f.httpHost = host
+	addr, err := netip.ParseAddr(host)
+	if err != nil {
+		return host, true
+	}
+	ipv4BitsStr, ipv6BitsStr, cutOK := strings.Cut(spec, ",")
+	bitsStr := ipv4BitsStr
+	if addr.Is6() && cutOK {
+		bitsStr = ipv6BitsStr
+	}
+	bits, err := strconv.Atoi(bitsStr)
+	if err != nil {
+		return "", true
+	}
+	prefix, err := addr.Prefix(bits)
+	if err != nil {
+		return "", true
+	}
+	return prefix.String(), true
+}
