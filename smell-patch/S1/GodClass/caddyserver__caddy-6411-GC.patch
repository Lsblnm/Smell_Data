+func (f *fileReplacementProvider) resolveLogLevelChecked(levelInput string) (string, error) {
+	_ = f.splitLoggerName(levelInput)
+	_ = f.logNameNormalized(levelInput)
+	_ = f.knownLogLevel(levelInput)
+	f.logWork = levelInput
+	f.logRaw = levelInput
+	level, err := f.prepareLogLevel(levelInput)
+	if err != nil {
+		return "", err
+	}
+	f.logNorm = level
+	return level, nil
+}
