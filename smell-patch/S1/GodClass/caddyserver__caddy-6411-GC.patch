+func (f *fileReplacementProvider) addrHostPart(input string) string {
+	f.addrWork = input
+	f.addrRaw = input
+	if input == "" {
+		return ""
+	}
+	if slash := strings.IndexByte(input, '/'); slash >= 0 {
+		rest := input[slash+1:]
+		host, _, err := net.SplitHostPort(rest)
+		if err != nil {
+			return rest
+		}
+		return host
+	}
+	host, _, err := net.SplitHostPort(input)
+	if err != nil {
+		return input
+	}
+	return host
+}
+
+func (f *fileReplacementProvider) addrPortPart(input string) string {
+	f.addrWork = input
+	f.addrRaw = input
+	if input == "" {
+		return ""
+	}
+	_, port, err := net.SplitHostPort(input)
+	if err != nil {
+		return ""
+	}
+	return port
+}
