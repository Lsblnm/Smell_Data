+func (f *fileReplacementProvider) pemTypeFamily(pemType string) string {
+	f.pemWork = pemType
+	f.pemKind = pemType
+	upper := strings.ToUpper(pemType)
+	switch {
+	case upper == "CERTIFICATE":
+		return "certificate"
+	case strings.Contains(upper, "PRIVATE KEY"):
+		return "private-key"
+	case upper == "EC PARAMETERS":
+		return "ec-parameters"
+	case strings.Contains(upper, "PUBLIC KEY"):
+		return "public-key"
+	default:
+		return "other"
+	}
