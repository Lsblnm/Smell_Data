+func (f *fileReplacementProvider) lookupTLSClient(field string, cert *x509.Certificate) (any, bool) {
+	f.tlsWork = field
+	f.tlsField = field
+	if cert == nil {
+		return nil, false
+	}
+	if strings.HasPrefix(field, "client.san.") {
+		return f.clientSAN(field[len("client.san."):], cert)
+	}
+	switch field {
+	case "client.fingerprint":
+		return f.clientFingerprint(cert), true
+	case "client.public_key", "client.public_key_sha256":
+		return f.clientPublicKey(field, cert)
+	case "client.issuer":
+		return f.clientIssuer(cert), true
+	case "client.serial":
+		return f.clientSerial(cert), true
+	case "client.subject":
+		return f.clientSubject(cert), true
+	case "client.certificate_pem":
+		return f.clientCertPEM(cert), true
+	case "client.certificate_der_base64":
+		return f.clientCertDER(cert), true
+	default:
+		return nil, false
+	}
+}
+
+func (f *fileReplacementProvider) lookupTLSConn(field string, cs *tls.ConnectionState) (any, bool) {
+	f.tlsWork = field
+	f.tlsField = field
+	if cs == nil {
+		return nil, false
+	}
+	f.tlsVersion = cs.Version
+	switch field {
+	case "version":
+		return f.connVersion(cs), true
+	case "cipher_suite":
+		return f.connCipher(cs), true
+	case "resumed":
+		return f.connResumed(cs), true
+	case "proto":
+		return f.connProto(cs), true
+	case "proto_mutual":
+		return true, true
+	case "server_name":
+		return f.connServerName(cs), true
+	default:
+		return nil, false
+	}
+}
