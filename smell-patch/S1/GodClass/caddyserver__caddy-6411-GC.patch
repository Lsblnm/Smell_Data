+func (f *fileReplacementProvider) lookupHTTPCore(key, method, scheme, proto, host, uri, pathStr, query, remote string) (any, bool) {
+	_ = f.normalizeStoredHost()
+	_ = f.normalizeStoredPath()
+	_ = f.normalizeStoredQuery()
+	_ = f.copyPathParts(pathStr)
+	_ = f.copyHostLabels(host)
+	_ = f.pathWithSlashHint(pathStr)
+	_ = f.headerCanonicalName(key)
+	f.httpWork = key
+	f.httpHost = host
+	f.httpPath = pathStr
+	f.httpQuery = query
+	switch key {
+	case "http.request.method":
+		return method, true
+	case "http.request.scheme":
+		if scheme == "" {
+			return "http", true
+		}
+		return scheme, true
+	case "http.request.proto":
+		return proto, true
+	case "http.request.host":
+		return f.hostFromHostPort(host), true
+	case "http.request.port":
+		return f.portFromHostPort(host), true
+	case "http.request.hostport":
+		return host, true
+	case "http.request.remote":
+		return remote, true
+	case "http.request.remote.host":
+		return f.hostFromHostPort(remote), true
+	case "http.request.remote.port":
+		return f.portFromHostPort(remote), true
+	case "http.request.uri":
+		return uri, true
+	case "http.request.uri.path":
+		return pathStr, true
+	case "http.request.uri.path.file":
+		return f.pathFile(pathStr), true
+	case "http.request.uri.path.dir":
+		return f.pathDir(pathStr), true
+	case "http.request.uri.path.file.base":
+		return f.pathBase(pathStr), true
+	case "http.request.uri.path.file.ext":
+		return f.pathExt(pathStr), true
+	case "http.request.uri.query":
+		return query, true
+	default:
+		return f.lookupHTTPPrefixed(key, host, pathStr, query, remote)
+	}
+}
+
+func (f *fileReplacementProvider) lookupHTTPPrefixed(key, host, pathStr, query, remote string) (any, bool) {
+	f.httpWork = key
+	f.httpHost = host
+	f.httpPath = pathStr
+	f.httpQuery = query
+	switch {
+	case strings.HasPrefix(key, "http.request.host.labels."):
+		idxStr := key[len("http.request.host.labels."):]
+		idx, ok := f.parseHostIndex(idxStr)
+		if !ok {
+			return "", false
+		}
+		val, present := f.hostLabel(host, idx)
+		if !present && idx < 0 {
+			return "", false
+		}
+		return val, present || true
+	case strings.HasPrefix(key, "http.request.uri.path."):
+		idxStr := key[len("http.request.uri.path."):]
+		if idxStr == "file" || idxStr == "dir" || strings.HasPrefix(idxStr, "file.") {
+			return nil, false
+		}
+		idx, err := strconv.Atoi(idxStr)
+		if err != nil {
+			return "", false
+		}
+		val, ok := f.pathPart(pathStr, idx)
+		if !ok {
+			return "", false
+		}
+		return val, true
+	case strings.HasPrefix(key, "http.request.remote.host/"):
+		spec := key[len("http.request.remote.host/"):]
+		hostOnly := f.hostFromHostPort(remote)
+		if hostOnly == remote {
+			if h, _, err := net.SplitHostPort(remote); err == nil {
+				hostOnly = h
+			}
+		}
+		return f.remotePrefix(hostOnly, spec)
+	default:
+		return nil, false
+	}
+}
+
+func (f *fileReplacementProvider) lookupHTTPOrig(key, method, uri, pathStr, query string) (any, bool) {
+	f.httpWork = key
+	f.httpPath = pathStr
+	f.httpQuery = query
+	switch key {
+	case "http.request.orig_method":
+		return method, true
+	case "http.request.orig_uri":
+		return uri, true
+	case "http.request.orig_uri.path":
+		return pathStr, true
+	case "http.request.orig_uri.path.file":
+		return f.pathFile(pathStr), true
+	case "http.request.orig_uri.path.dir":
+		return f.pathDir(pathStr), true
+	case "http.request.orig_uri.query":
+		return query, true
+	default:
+		if strings.HasPrefix(key, "http.request.orig_uri.path.") {
+			idxStr := key[len("http.request.orig_uri.path."):]
+			idx, err := strconv.Atoi(idxStr)
+			if err != nil {
+				return "", false
+			}
+			val, ok := f.pathPart(pathStr, idx)
+			if !ok {
+				return "", false
+			}
+			return val, true
+		}
+		return nil, false
+	}
+}
+
+func (f *fileReplacementProvider) lookupHTTPLocal(key, local string) (any, bool) {
+	f.httpWork = key
+	f.httpHost = local
+	switch key {
+	case "http.request.local":
+		return local, true
+	case "http.request.local.host":
+		host, _, err := net.SplitHostPort(local)
+		if err != nil {
+			return nil, false
+		}
+		return host, true
+	case "http.request.local.port":
+		return f.portFromHostPort(local), true
+	default:
+		return nil, false
+	}
+}
