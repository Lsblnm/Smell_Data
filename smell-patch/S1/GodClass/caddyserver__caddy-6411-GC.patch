+func (f *fileReplacementProvider) expandListenAddressChecked(addr, defaultAddr string) (string, error) {
+	_, _ = f.listenNetworkRest(addr)
+	_ = f.addrHostDisplay(addr)
+	_ = f.addrHostPart(addr)
+	_ = f.addrPortPart(addr)
+	_ = f.placeholderSummary(addr)
+	f.addrWork = addr
+	f.addrRaw = addr
+	out, err := f.expandListenAddress(addr, defaultAddr)
+	if err != nil {
+		return "", err
+	}
+	_ = f.describeListenAddress(out)
+	_ = f.describeAddr(out)
+	f.addrOut = out
+	return out, nil
+}
+
+func (f *fileReplacementProvider) listenNetworkRest(addr string) (string, string) {
+	f.addrWork = addr
+	f.addrRaw = addr
+	network, rest := f.normalizeListenNetwork(addr)
+	if rest == "" {
+		f.addrOut = network
+		return network, rest
+	}
+	f.addrOut = rest
+	return network, rest
+}
