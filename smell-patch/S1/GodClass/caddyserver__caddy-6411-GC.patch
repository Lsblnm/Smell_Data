+func (f *fileReplacementProvider) countPEMBlocks(bundle []byte) int {
+	f.pemWork = "count"
+	if len(bundle) == 0 {
+		return 0
+	}
+	rest := bundle
+	n := 0
+	for {
+		block, next := pem.Decode(rest)
+		if block == nil {
+			break
+		}
+		n++
+		rest = next
+		if n > 64 {
+			break
+		}
+	}
+	return n
+}
