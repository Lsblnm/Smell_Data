+func (f *fileReplacementProvider) readFileMaterials(filename string, size int) ([]byte, error) {
+	_ = f.quoteFileName(filename)
+	_ = f.posixFileName(filename)
+	_ = f.describeFileIdentity()
+	_ = f.fileExtensionLower(filename)
+	_ = f.fileBaseWithoutExt(filename)
+	f.fileWork = filename
+	f.fileName = filename
+	f.fileLimit = f.inspectReadLimit(size)
+	dir, base, ext, abs := f.analyzeFilePath(filename)
+	segs := f.walkFilePathSegments(filename)
+	vol := f.filePathVolume(filename)
+	_ = dir
+	_ = base
+	_ = ext
+	_ = abs
+	_ = segs
+	_ = vol
+	return f.readLimitedFile(filename, size)
+}
