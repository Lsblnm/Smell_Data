+func (f *fileReplacementProvider) tlsPlaceholderDispatch(key string, cs *tls.ConnectionState, protocolName string) (any, bool) {
+	_ = f.tlsCipherOrEmpty(cs)
+	_ = f.connProto(cs)
+	_ = f.tlsServerNameLower("")
+	_ = f.tlsVersionName(0)
+	f.tlsWork = key
+	f.tlsField = key
+	if cs == nil {
+		return nil, false
+	}
+	if !strings.HasPrefix(key, "http.request.tls.") {
+		return nil, false
+	}
+	field := strings.ToLower(key[len("http.request.tls."):])
+	if strings.HasPrefix(field, "client.") {
+		cert := f.tlsPeerCertificate(cs)
+		return f.lookupTLSClient(field, cert)
+	}
+	if field == "version" && protocolName != "" {
+		return protocolName, true
+	}
+	return f.lookupTLSConn(field, cs)
+}
