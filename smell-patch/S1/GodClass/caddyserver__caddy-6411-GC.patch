+func (f *fileReplacementProvider) placeholderSummary(input string) string {
+	f.phWork = input
+	f.phKey = input
+	keys := f.scanConfiguredPlaceholders(input)
+	if len(keys) == 0 {
+		return "none"
+	}
+	first := f.firstPlaceholderKey(input)
+	kinds := f.configuredPlaceholderKinds(input)
+	summary := first + ":" + strconv.Itoa(len(keys))
+	if len(kinds) > 0 {
+		summary += ":" + kinds[0]
+	}
+	return summary
+}
