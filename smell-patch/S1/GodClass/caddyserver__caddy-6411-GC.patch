+func (f *fileReplacementProvider) describeFileIdentity() string {
+	f.fileWork = f.fileName
+	dir := filepath.Dir(f.fileName)
+	base := filepath.Base(f.fileName)
+	ext := filepath.Ext(f.fileName)
+	vol := filepath.VolumeName(f.fileName)
+	cleaned := filepath.Clean(f.fileName)
+	slash := strings.ReplaceAll(cleaned, "\\", "/")
+	slash = strings.TrimPrefix(slash, "./")
+	joined := strings.Join([]string{vol, dir, base, ext}, "|")
+	f.fileWork = joined + "|" + slash
+	return f.fileWork
+}
+
+func (f *fileReplacementProvider) describePlaceholderIdentity() string {
+	f.phWork = f.phKey
+	trimmed := strings.TrimSpace(f.phKey)
+	lower := strings.ToLower(trimmed)
+	dots := strings.ReplaceAll(lower, "/", ".")
+	parts := strings.Split(dots, ".")
+	root := strings.Join(parts, ".")
+	encoded := strings.ReplaceAll(root, " ", "_")
+	encoded = strings.ReplaceAll(encoded, "\t", "_")
+	encoded = strings.ReplaceAll(encoded, "\n", "_")
+	f.phKind = encoded
+	f.phWork = encoded
+	return encoded
+}
