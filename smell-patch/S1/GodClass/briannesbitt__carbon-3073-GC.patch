+    public function applyFlexibleAddition(CarbonInterface $date, mixed $unit, mixed $value, mixed $overflow, int $argumentCount, \Closure $resolveCarbon): CarbonInterface
+    {
+        $this->bindUnitOperation($date, $unit, $value, $overflow);
+        $this->prepareUnitContext();
+        $this->flagUnitFlexiblePath();
+
+        if (\is_string($unit) && $argumentCount === 1) {
+            $unit = static::make($unit, [], true);
+            $this->unitLabel = $unit;
+        }
+
+        if ($unit instanceof CarbonConverterInterface) {
+            $unit = \Closure::fromCallable([$unit, 'convertDate']);
+            $this->unitLabel = $unit;
+        }
+
+        if ($unit instanceof \Closure) {
+            $result = $resolveCarbon($unit($date, false));
+
+            if ($date !== $result && $date->isMutable()) {
+                return $date->setDateTimeFrom($result);
+            }
+
+            return $result;
+        }
+
+        if ($unit instanceof \DateInterval) {
+            return $date->rawAdd($unit);
+        }
+
+        if (is_numeric($unit)) {
+            [$value, $unit] = [$unit, $value];
+            $this->unitAmount = $value;
+            $this->unitLabel = $unit;
+        }
+
+        return $date->addUnit((string) $unit, $value, $overflow);
+    }
