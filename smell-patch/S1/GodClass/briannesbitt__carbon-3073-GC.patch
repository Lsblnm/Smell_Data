+    public function applyCalendarUnitAddition(
+        CarbonInterface $date,
+        Unit|string $unit,
+        $value = 1,
+        ?bool $overflow = null,
+        array $originalArgs = [],
+        array $weekendDays = [CarbonInterface::SATURDAY, CarbonInterface::SUNDAY],
+        bool $monthOverflow = true,
+        bool $yearOverflow = true,
+    ): CarbonInterface
+    {
+        $this->bindUnitOperation($date, $unit, $value, $overflow);
+        $this->prepareUnitContext();
+        $this->flagUnitCalendarPath();
+
+        $unit = Unit::toName($unit);
+        $this->unitLabel = $unit;
+
+        if ($originalArgs === []) {
+            $originalArgs = [$unit, $value, $overflow];
+        }
+
+        if (!is_numeric($value) || !(float) $value) {
+            return $date->isMutable() ? $date : $date->copy();
+        }
+
+        $unit = $date::singularUnit($unit);
+        $this->unitLabel = $unit;
+        $metaUnits = $this->unitScratch['meta'] ?? $this->catalogUnitMetaFactors();
+
+        if (isset($metaUnits[$unit])) {
+            [$factor, $unit] = $metaUnits[$unit];
+            $value *= $factor;
+            $this->unitAmount = $value;
+            $this->unitLabel = $unit;
+            $this->storeUnitMetaHint();
+        }
+
+        if ($unit === 'weekday') {
+            $this->storeUnitWeekdayHint();
+
+            if ($weekendDays !== [$date::SATURDAY, $date::SUNDAY]) {
+                $absoluteValue = abs($value);
+                $sign = $value / max(1, $absoluteValue);
+                $weekDaysCount = $date::DAYS_PER_WEEK - min($date::DAYS_PER_WEEK - 1, \count(array_unique($weekendDays)));
+                $weeks = floor($absoluteValue / $weekDaysCount);
+
+                for ($diff = $absoluteValue % $weekDaysCount; $diff; $diff--) {
+                    $date = $date->addDays($sign);
+
+                    while (\in_array($date->dayOfWeek, $weekendDays, true)) {
+                        $date = $date->addDays($sign);
+                    }
+                }
+
+                $value = $weeks * $sign;
+                $unit = 'week';
+                $this->unitAmount = $value;
+                $this->unitLabel = $unit;
+            }
+
+            $timeString = $date->toTimeString();
+        } elseif ($canOverflow = (\in_array($unit, [
+                'month',
+                'year',
+            ], true) && ($overflow === false || (
+                $overflow === null &&
+                !($unit === 'month' ? $monthOverflow : $yearOverflow)
+            )))) {
+            $day = $date->day;
+            $this->storeUnitOverflowHint();
+        }
+
+        if ($unit === 'milli' || $unit === 'millisecond') {
+            $unit = 'microsecond';
+            $value *= $date::MICROSECONDS_PER_MILLISECOND;
+            $this->unitLabel = $unit;
+            $this->unitAmount = $value;
+            $this->storeUnitMilliHint();
+        }
