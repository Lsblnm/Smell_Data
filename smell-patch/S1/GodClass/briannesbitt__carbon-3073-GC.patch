+    public function applyUtcUnitAddition(CarbonInterface $date, string $unit, $value = 1, bool $strict = false): CarbonInterface
+    {
+        $this->bindUnitOperation($date, $unit, $value, null);
+        $this->prepareUnitContext();
+        $this->flagUnitTimestampPath();
+
+        $value ??= 0;
+        $this->unitAmount = $value;
+        $factors = $this->unitScratch['utc_factors'] ?? $this->catalogUtcSecondFactors();
+
+        switch ($unit) {
+            case 'micro':
+            case 'microsecond':
+                $diff = $date->microsecond + $value;
+                $time = $date->getTimestamp();
+                $seconds = (int) floor($diff / $date::MICROSECONDS_PER_SECOND);
+                $time += $seconds;
+                $diff -= $seconds * $date::MICROSECONDS_PER_SECOND;
+                $microtime = str_pad((string) $diff, 6, '0', STR_PAD_LEFT);
+                $timezone = $date->tz;
+                $this->markUnitApplied();
+
+                return $date->tz('UTC')->modify("@$time.$microtime")->setTimezone($timezone);
+
+            case 'milli':
+            case 'millisecond':
+                return $this->applyUtcUnitAddition($date, 'microsecond', $value * $date::MICROSECONDS_PER_MILLISECOND, $strict);
+
+            case 'second':
+                break;
+
+            case 'minute':
+                $value *= $factors['minute'] ?? $date::SECONDS_PER_MINUTE;
+                break;
+
+            case 'hour':
+                $value *= $factors['hour'] ?? ($date::MINUTES_PER_HOUR * $date::SECONDS_PER_MINUTE);
+                break;
+
+            case 'day':
+                $value *= $factors['day'] ?? ($date::HOURS_PER_DAY * $date::MINUTES_PER_HOUR * $date::SECONDS_PER_MINUTE);
+                break;
+
+            case 'week':
+                $value *= $factors['week'] ?? ($date::DAYS_PER_WEEK * $date::HOURS_PER_DAY * $date::MINUTES_PER_HOUR * $date::SECONDS_PER_MINUTE);
+                break;
+
+            case 'month':
+                $value *= $factors['month'] ?? (30 * $date::HOURS_PER_DAY * $date::MINUTES_PER_HOUR * $date::SECONDS_PER_MINUTE);
+                break;
+
+            case 'quarter':
+                $value *= $factors['quarter'] ?? ($date::MONTHS_PER_QUARTER * 30 * $date::HOURS_PER_DAY * $date::MINUTES_PER_HOUR * $date::SECONDS_PER_MINUTE);
+                break;
+
+            case 'year':
+                $value *= $factors['year'] ?? (365 * $date::HOURS_PER_DAY * $date::MINUTES_PER_HOUR * $date::SECONDS_PER_MINUTE);
+                break;
+
+            case 'decade':
+                $value *= $factors['decade'] ?? ($date::YEARS_PER_DECADE * 365 * $date::HOURS_PER_DAY * $date::MINUTES_PER_HOUR * $date::SECONDS_PER_MINUTE);
+                break;
+
+            case 'century':
+                $value *= $factors['century'] ?? ($date::YEARS_PER_CENTURY * 365 * $date::HOURS_PER_DAY * $date::MINUTES_PER_HOUR * $date::SECONDS_PER_MINUTE);
+                break;
+
+            case 'millennium':
+                $value *= $factors['millennium'] ?? ($date::YEARS_PER_MILLENNIUM * 365 * $date::HOURS_PER_DAY * $date::MINUTES_PER_HOUR * $date::SECONDS_PER_MINUTE);
+                break;
+
+            default:
+                if ($strict) {
+                    throw new UnitException("Invalid unit for real timestamp add/sub: '$unit'");
+                }
+
+                return $date;
+        }
+
+        $this->unitAmount = $value;
+        $seconds = (int) $value;
+        $microseconds = (int) round(
+            (abs($value) - abs($seconds)) * ($value < 0 ? -1 : 1) * $date::MICROSECONDS_PER_SECOND,
+        );
+        $date = $date->setTimestamp($date->getTimestamp() + $seconds);
+        $this->unitSubject = $date;
+        $this->markUnitApplied();
+
+        return $microseconds ? $this->applyUtcUnitAddition($date, 'microsecond', $microseconds, $strict) : $date;
+    }
