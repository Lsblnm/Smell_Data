+    public function coordinateIntervalTotal($interval, $unit, array $factors)
+    {
+        $this->intervalCoordinationState['operation'] = 'total';
+        $this->intervalCoordinationState['unit'] = $unit;
+        $realUnit = $unit = strtolower($unit);
+
+        if (\in_array($unit, ['days', 'weeks'])) {
+            $realUnit = 'dayz';
+        } elseif (!\in_array($unit, ['microseconds', 'milliseconds', 'seconds', 'minutes', 'hours', 'dayz', 'months', 'years'])) {
+            throw new \Carbon\Exceptions\UnknownUnitException($unit);
+        }
+
+        $result = 0;
+        $cumulativeFactor = 0;
+        $unitFound = false;
+        $daysPerWeek = (int) $interval::getDaysPerWeek();
+
+        $values = [
+            'years' => $interval->years,
+            'months' => $interval->months,
+            'weeks' => (int) ($interval->d / $daysPerWeek),
+            'dayz' => fmod($interval->d, $daysPerWeek),
+            'hours' => $interval->hours,
+            'minutes' => $interval->minutes,
+            'seconds' => $interval->seconds,
+            'milliseconds' => (int) ($interval->microseconds / static::MICROSECONDS_PER_MILLISECOND),
+            'microseconds' => $interval->microseconds % static::MICROSECONDS_PER_MILLISECOND,
+        ];
+
+        if (isset($factors['dayz']) && $factors['dayz'][0] !== 'weeks') {
+            $values['dayz'] += $values['weeks'] * $daysPerWeek;
+            $values['weeks'] = 0;
+        }
+
+        foreach ($factors as $source => [$target, $factor]) {
+            if ($source === $realUnit) {
+                $unitFound = true;
+                $value = $values[$source];
+                $result += $value;
+                $cumulativeFactor = 1;
+            }
+
+            if ($factor === false) {
+                if ($unitFound) {
+                    break;
+                }
+
+                $result = 0;
+                $cumulativeFactor = 0;
+
+                continue;
+            }
+
+            if ($target === $realUnit) {
+                $unitFound = true;
+            }
