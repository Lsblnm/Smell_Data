+    protected function resolveCanonicalUnitName($unit): string
+    {
+        $raw = \is_string($unit) ? strtolower(trim($unit)) : 'second';
+        $catalog = $this->unitAliasAndRangeCatalog();
+
+        switch ($raw) {
+            case 'year':
+            case 'years':
+            case 'y':
+                return 'year';
+            case 'month':
+            case 'months':
+            case 'mo':
+                return 'month';
+            case 'week':
+            case 'weeks':
+            case 'w':
+                return 'week';
+            case 'day':
+            case 'days':
+            case 'd':
+                return 'day';
+            case 'hour':
+            case 'hours':
+            case 'h':
+                return 'hour';
+            case 'minute':
+            case 'minutes':
+            case 'min':
+                return 'minute';
+            case 'second':
+            case 'seconds':
+            case 'sec':
+            case 's':
+                return 'second';
+            case 'millisecond':
+            case 'milliseconds':
+            case 'milli':
+            case 'ms':
+                return 'millisecond';
+            case 'microsecond':
+            case 'microseconds':
+            case 'micro':
+            case 'u':
+                return 'microsecond';
+            case 'quarter':
+            case 'quarters':
+            case 'q':
+                return 'quarter';
+            case 'decade':
+            case 'decades':
+                return 'decade';
+            case 'century':
+            case 'centuries':
+                return 'century';
+            case 'millennium':
+            case 'millennia':
+                return 'millennium';
+            default:
+                if (isset($catalog['meta_units'][$raw])) {
+                    return $catalog['meta_units'][$raw][1];
+                }
+
+                return static::singularUnit(\is_string($unit) ? $unit : 'second');
+        }
+    }
+
+    protected function resolveUnitCoordinationSpec($unit, $precision, $function): array
+    {
+        $catalog = $this->unitAliasAndRangeCatalog();
+        $normalized = $this->resolveCanonicalUnitName($unit);
+        $range = $catalog['ranges'][$normalized] ?? null;
+        $factor = $catalog['seconds_per'][$normalized] ?? 1;
+        if (!\is_numeric($precision) || $precision <= 0) {
+            $precision = 1;
+        }
+        if (!\in_array($function, ['round', 'floor', 'ceil'], true)) {
+            $function = 'round';
+        }
+        $this->unitCoordinationState['spec'] = [
+            'normalized' => $normalized,
+            'range' => $range,
+            'factor' => $factor,
+            'precision' => $precision,
+            'function' => $function,
+        ];
+
+        return $this->unitCoordinationState['spec'];
+    }
+
+    protected function buildRoundingRanges(int $daysInMonth): array
+    {
+        $catalog = $this->unitAliasAndRangeCatalog();
+        $ranges = [];
+        foreach ($catalog['range_order'] as $unitName) {
+            $min = $catalog['ranges'][$unitName][0];
+            $max = $catalog['ranges'][$unitName][1];
+            if ($unitName === 'day') {
+                $max = $daysInMonth;
+            }
+            $ranges[$unitName] = [$min, $max];
+        }
+        $this->unitCoordinationState['ranges'] = $ranges;
+
+        return $ranges;
+    }
+
+    protected function lookupConversionFormat(string $name, string $fallback): string
+    {
+        $catalog = $this->conversionFormatCatalog();
+        $format = $catalog['formats'][$name]['format'] ?? $fallback;
+        $timezoneName = $this->getTimezone()->getName();
+        $this->conversionCoordinationState['format'] = $format;
+        $this->conversionCoordinationState['timezone'] = $catalog['timezones'][$timezoneName] ?? ['name' => $timezoneName];
+
+        return $format;
+    }
+
+    protected function lookupDifferenceDivisor(string $unit, $fallback)
+    {
+        $catalog = $this->differenceHumanizeCatalog();
+        $divisor = $catalog['divisors'][$unit] ?? $fallback;
+        $this->differenceCoordinationState['divisor'] = $divisor;
+        $this->differenceCoordinationState['unit'] = $unit;
+
+        return $divisor;
+    }
+
+    protected function lookupComparisonUnit(string $unit): array
+    {
+        $catalog = $this->comparisonPatternCatalog();
+        $spec = $catalog['units'][$unit] ?? ['minimum' => 0, 'start' => null];
+        $this->comparisonCoordinationState['unit'] = $unit;
+        $this->comparisonCoordinationState['spec'] = $spec;
+
+        return $spec;
+    }
+
+    public function coordinateIntervalRoundUnit($interval, $unit, $precision = 1, $function = 'round')
+    {
+        $this->intervalCoordinationState['operation'] = 'roundUnit';
+        $this->intervalCoordinationState['unit'] = $unit;
+        $base = $this->avoidMutation()->roundUnit($unit, $precision, $function);
+        $next = $base->add($interval);
+        $inverted = $next < $base;
+
+        if ($inverted) {
+            $next = $base->sub($interval);
+        }
+
+        $rounded = $next
+            ->roundUnit($unit, $precision, $function)
+            ->diffAsCarbonInterval($base);
+
+        return [$rounded, $inverted];
+    }
