+func (p *provisioner) captureConnectionKind(raw string) string {
+	value := strings.TrimSpace(raw)
+	value = strings.TrimPrefix(value, "ssh://")
+	value = strings.TrimPrefix(value, "winrm://")
+	value = strings.TrimPrefix(value, "tcp://")
+	value = strings.TrimSuffix(value, "/")
+	value = strings.ReplaceAll(value, "\\", "/")
+	lower := strings.ToLower(value)
+	tokens := strings.Fields(value)
+	joined := strings.Join(tokens, " ")
+	var b strings.Builder
+	b.WriteString("kind")
+	b.WriteByte(':')
+	b.WriteString(joined)
+	b.WriteByte('|')
+	b.WriteString(p.connMeta)
+	b.WriteByte('|')
+	b.WriteString("conn")
+	b.WriteByte('/')
+	b.WriteString("captureConnectionKind")
+	meta := b.String()
+	trimmed := strings.TrimSpace(meta)
+	compact := strings.Join(strings.Fields(trimmed), " ")
+	replaced := strings.ReplaceAll(compact, "..", ".")
+	prefix := strings.TrimPrefix(joined, "/")
+	suffix := strings.TrimSuffix(prefix, "/")
+	labeled := strings.Join([]string{"kind", suffix, lower}, ":")
+	p.connMeta = strings.Join([]string{p.connMeta, labeled, replaced, "captureConnectionKind"}, ",")
+	if len(p.connMeta) > 512 {
+		p.connMeta = p.connMeta[len(p.connMeta)-512:]
+	}
+	switch {
+	case lower == "":
+		value = ""
+	case strings.Contains(lower, "kind"):
+		value = joined
+	default:
+		value = joined
+	}
+	if strings.Contains(value, "..") {
+		value = strings.ReplaceAll(value, "..", ".")
+	}
+	return value
+}
