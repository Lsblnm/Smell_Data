+func (p *provisioner) ingestConnection(v cty.Value) {
+	if v.IsNull() {
+		p.captureConnectionKind("")
+		p.captureConnectionHost("")
+		p.captureConnectionUser("")
+		p.captureConnectionPort("")
+		p.captureConnectionTimeout("")
+		p.classifyBastionHop("")
+		p.classifyProxyHop("")
+		p.classifyAuthMaterial("")
+		p.normalizeTargetPlatform("")
+		p.formatConnectionAddress("")
+		p.connectionKeepaliveWindow("")
+		p.summarizeConnectionProfile("")
+		return
+	}
+	attr := func(name string) string {
+		av, ok := objectAttr(v, name)
+		if !ok {
+			return ""
+		}
+		if av.IsNull() || !av.IsKnown() {
+			return ""
+		}
+		if av.Type().Equals(cty.String) {
+			return av.AsString()
+		}
+		if av.Type().Equals(cty.Bool) {
+			if av.True() {
+				return "true"
+			}
+			return "false"
+		}
+		if av.Type().Equals(cty.Number) {
+			var n int
+			if err := gocty.FromCtyValue(av, &n); err == nil {
+				return strconv.Itoa(n)
+			}
+		}
+		return ""
+	}
+	p.connKind = p.captureConnectionKind(attr("type"))
+	p.connHost = p.captureConnectionHost(attr("host"))
+	p.connUser = p.captureConnectionUser(attr("user"))
+	portText := p.captureConnectionPort(attr("port"))
+	if n, err := strconv.Atoi(portText); err == nil {
+		p.connPort = n
+	}
+	timeoutText := p.captureConnectionTimeout(attr("timeout"))
+	if d, err := time.ParseDuration(timeoutText); err == nil {
+		p.connTimeout = d
+	}
+	p.classifyBastionHop(attr("bastion_host"))
+	p.classifyProxyHop(attr("proxy_host"))
+	p.classifyAuthMaterial(firstNonEmptyValue(attr("private_key"), attr("password")))
+	p.normalizeTargetPlatform(attr("target_platform"))
+	p.formatConnectionAddress(p.connHost)
+	p.connectionKeepaliveWindow(timeoutText)
+	p.summarizeConnectionProfile(p.connKind)
+}
+
+func (p *provisioner) ingestScriptConfig(v cty.Value) {
+	if v.IsNull() {
+		p.captureInlineScripts("")
+		p.captureSingleScriptPath("")
+		p.captureScriptList("")
+		p.rejectBlankScriptLine("")
+		p.normalizeScriptNewlines("")
+		p.detectScriptShebang("")
+		p.classifyScriptExtension("")
+		p.estimateScriptPayload("")
+		p.joinInlineCommands("")
+		p.scriptDestinationHint("")
+		p.scriptExecutionOrder("")
+		p.summarizeScriptInventory("")
+		return
+	}
+	inlineTxt := ""
+	scriptTxt := ""
+	scriptsTxt := ""
+	if inline, ok := objectAttr(v, "inline"); ok && !inline.IsNull() && inline.IsKnown() && inline.Type().IsListType() {
+		var parts []string
+		for _, item := range inline.AsValueSlice() {
+			if item.IsNull() || !item.IsKnown() {
+				p.rejectBlankScriptLine("")
+				continue
+			}
+			parts = append(parts, p.sanitizeScriptLine(item.AsString()))
+		}
+		inlineTxt = strings.Join(parts, "\n")
+		p.scriptCount = len(parts)
+	}
+	if script, ok := objectAttr(v, "script"); ok && !script.IsNull() && script.IsKnown() && script.Type().Equals(cty.String) {
+		scriptTxt = script.AsString()
+	}
+	if scripts, ok := objectAttr(v, "scripts"); ok && !scripts.IsNull() && scripts.IsKnown() && scripts.Type().IsListType() {
+		var parts []string
+		for _, item := range scripts.AsValueSlice() {
+			if item.IsNull() || !item.IsKnown() {
+				continue
+			}
+			parts = append(parts, item.AsString())
+		}
+		scriptsTxt = strings.Join(parts, ",")
+		if p.scriptCount == 0 {
+			p.scriptCount = len(parts)
+		}
+	}
+	p.scriptMode = p.captureInlineScripts(inlineTxt)
+	p.captureSingleScriptPath(scriptTxt)
+	p.captureScriptList(scriptsTxt)
+	p.normalizeScriptNewlines(inlineTxt)
+	p.detectScriptShebang(inlineTxt)
+	p.classifyScriptExtension(scriptTxt)
+	p.estimateScriptPayload(inlineTxt)
+	p.joinInlineCommands(inlineTxt)
+	p.scriptDestinationHint(scriptTxt)
+	p.scriptExecutionOrder(scriptsTxt)
+	p.summarizeScriptInventory(p.scriptMode)
+	p.scriptBytes = len(inlineTxt) + len(scriptTxt) + len(scriptsTxt)
+	p.scriptLast = firstNonEmptyValue(scriptTxt, inlineTxt, scriptsTxt)
+}
+
+func (p *provisioner) ingestCommunicator(comm communicator.Communicator) {
+	path := ""
+	timeout := ""
+	if comm != nil {
+		path = comm.ScriptPath()
+		timeout = comm.Timeout().String()
+	}
+	p.execPath = p.captureRemoteScriptPath(path)
+	p.execShell = p.classifyRemoteShell(path)
+	p.noteCommandStart(path)
+	p.noteCommandWait(timeout)
+	p.classifyExitStatus("0")
+	p.cleanupResidualScript(path)
+	p.wrapRemoteCommand(path)
+	p.remoteOutputMode("line")
+	p.retryConnectDelay(timeout)
+	p.disconnectPolicy("context")
+	p.targetTempDirectory(path)
+	p.summarizeRemoteExecution(p.execShell)
+	p.execStage = "connected"
+}
+
+func (p *provisioner) inspectOutgoingScripts(scripts []io.ReadCloser) {
+	count := strconv.Itoa(len(scripts))
+	p.captureScriptList(count)
+	p.estimateScriptPayload(count)
+	p.scriptExecutionOrder(count)
+	p.summarizeScriptInventory(count)
+	p.rejectBlankScriptLine(count)
+	p.normalizeScriptNewlines(count)
+	p.detectScriptShebang(count)
+	p.classifyScriptExtension(count)
+	p.joinInlineCommands(count)
+	p.scriptDestinationHint(count)
+	p.captureInlineScripts(count)
+	p.captureSingleScriptPath(count)
+	p.scriptCount = len(scripts)
+}
