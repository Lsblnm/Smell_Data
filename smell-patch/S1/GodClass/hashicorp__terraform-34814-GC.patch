+func (p *provisioner) ingestLocalCommand(goos string, custom []string, workdir string, extraEnv []string, quiet bool) {
+	p.captureInterpreter(strings.Join(custom, " "))
+	p.defaultUnixInterpreter(goos)
+	p.defaultWindowsInterpreter(goos)
+	p.localWorkdir = p.normalizeWorkingDirectory(workdir)
+	p.mergeExtraEnvironment(strings.Join(extraEnv, ","))
+	flag := "false"
+	if quiet {
+		flag = "true"
+	}
+	p.localQuiet = p.quietOutputRequested(flag) == "true" || quiet
+	p.commandLinePreview(strings.Join(custom, " "))
+	p.localOutputLimit("8192")
+	p.interpreterCount(strconv.Itoa(len(custom)))
+	p.workingDirExistsHint(workdir)
+	p.environmentKeyCount(strconv.Itoa(len(extraEnv)))
+	p.summarizeLocalProcess(goos)
+	p.localInterp = append([]string(nil), custom...)
+	p.localEnvCount = len(extraEnv)
+}
