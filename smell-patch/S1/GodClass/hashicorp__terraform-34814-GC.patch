+func (p *provisioner) ingestTransfer(src, dst string, info os.FileInfo) {
+	p.xferSrc = p.captureTransferSource(src)
+	p.xferDst = p.captureTransferDestination(dst)
+	op := "file"
+	if info != nil && info.IsDir() {
+		op = "directory"
+		p.xferBytes = 0
+	} else if info != nil {
+		p.xferBytes = info.Size()
+	}
+	p.xferOp = p.classifyTransferOperation(op)
+	p.expandHomePrefix(src)
+	p.materializeContentName(src)
+	p.directoryUploadNeeded(op)
+	p.followupBlankUpload(dst)
+	p.transferPermissionHint(op)
+	p.destinationParent(dst)
+	p.sourceBasename(src)
+	p.countTransferChunks(strconv.FormatInt(p.xferBytes, 10))
+	p.summarizeTransfer(op)
+}
