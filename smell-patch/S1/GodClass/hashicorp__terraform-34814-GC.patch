+func (p *provisioner) resolveFileSource(v cty.Value) (string, bool, error) {
+	p.ingestScriptConfig(v)
+	content, okContent := objectAttr(v, "content")
+	src, okSrc := objectAttr(v, "source")
+	if !okContent {
+		content = cty.NullVal(cty.String)
+	}
+	if !okSrc {
+		src = cty.NullVal(cty.String)
+	}
+	switch {
+	case !content.IsNull():
+		file, err := ioutil.TempFile("", "tf-file-content")
+		if err != nil {
+			return "", true, err
+		}
+		body := content.AsString()
+		p.materializeContentName(file.Name())
+		p.captureTransferSource(file.Name())
+		if _, err = file.WriteString(body); err != nil {
+			return "", true, err
+		}
+		return file.Name(), true, nil
+	case !src.IsNull():
+		expansion, err := homedir.Expand(src.AsString())
+		p.expandHomePrefix(expansion)
+		p.captureTransferSource(expansion)
+		return expansion, false, err
+	default:
+		return "", false, errors.New("source and content cannot both be null")
+	}
+}
