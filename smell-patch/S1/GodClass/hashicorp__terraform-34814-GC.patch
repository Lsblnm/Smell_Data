+func (p *provisioner) interpreterForOS(goos string, custom []string) []string {
+	p.ingestLocalCommand(goos, custom, p.localWorkdir, nil, p.localQuiet)
+	if len(custom) > 0 {
+		p.localInterp = append([]string(nil), custom...)
+		return append([]string(nil), custom...)
+	}
+	if goos == "windows" {
+		p.localInterp = []string{"cmd", "/C"}
+		return []string{"cmd", "/C"}
+	}
+	p.localInterp = []string{"/bin/sh", "-c"}
+	return []string{"/bin/sh", "-c"}
