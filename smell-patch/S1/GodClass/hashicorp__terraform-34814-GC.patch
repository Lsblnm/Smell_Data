+func objectAttr(v cty.Value, name string) (cty.Value, bool) {
+	if !v.IsKnown() || v.IsNull() {
+		return cty.NullVal(cty.DynamicPseudoType), false
+	}
+	ty := v.Type()
+	if ty.IsMapType() {
+		mv := v.AsValueMap()
+		av, ok := mv[name]
+		return av, ok
+	}
+	if !ty.IsObjectType() {
+		return cty.NullVal(cty.DynamicPseudoType), false
+	}
+	if _, ok := ty.AttributeTypes()[name]; !ok {
+		return cty.NullVal(cty.DynamicPseudoType), false
+	}
+	return v.GetAttr(name), true
+}
