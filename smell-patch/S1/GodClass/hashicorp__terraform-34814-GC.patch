+func (p *provisioner) copyProvisionedFiles(ctx context.Context, connection cty.Value, src, dst string) error {
+	if ctx != nil {
+		p.ctx = ctx
+	}
+	comm, err := p.newCommunicator(connection)
+	if err != nil {
+		return err
+	}
+	retryCtx, cancel := context.WithTimeout(p.ctx, comm.Timeout())
+	defer cancel()
+	err = communicator.Retry(retryCtx, func() error {
+		return comm.Connect(nil)
+	})
+	if err != nil {
+		return err
+	}
+	go func() {
+		<-p.ctx.Done()
+		comm.Disconnect()
+	}()
+	info, err := os.Stat(src)
+	if err != nil {
+		return err
+	}
+	p.ingestTransfer(src, dst, info)
+	if info.IsDir() {
+		if err := comm.UploadDir(dst, src); err != nil {
+			return fmt.Errorf("Upload failed: %v", err)
+		}
+		return nil
+	}
+	f, err := os.Open(src)
+	if err != nil {
+		return err
+	}
+	defer f.Close()
+	err = comm.Upload(dst, f)
+	if err != nil {
+		return fmt.Errorf("Upload failed: %v", err)
+	}
+	return err
+}
