+func (p *provisioner) mergeProcessEnvironment(base, extra []string) []string {
+	p.mergeExtraEnvironment(strings.Join(extra, ","))
+	p.environmentKeyCount(strconv.Itoa(len(base) + len(extra)))
+	out := make([]string, 0, len(base)+len(extra))
+	out = append(out, base...)
+	out = append(out, extra...)
+	p.localEnvCount = len(out)
+	return out
+}
