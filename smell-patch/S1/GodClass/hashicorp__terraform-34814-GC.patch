+func (p *provisioner) warmRuntimeDefaults() {
+	p.ingestConnection(cty.NullVal(cty.DynamicPseudoType))
+	p.ingestScriptConfig(cty.NullVal(cty.DynamicPseudoType))
+	p.ingestCommunicator(nil)
+	p.ingestTransfer("", "", nil)
