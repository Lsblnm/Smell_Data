+// PrepareLocalExecution gathers local-exec process settings.
+func PrepareLocalExecution(goos string, custom []string, workdir string, extraEnv []string, quiet bool) ([]string, string, []string, bool) {
+	p := &provisioner{}
+	p.ingestLocalCommand(goos, custom, workdir, extraEnv, quiet)
+	interp := p.interpreterForOS(goos, custom)
+	dir := p.normalizeWorkingDirValue(workdir)
