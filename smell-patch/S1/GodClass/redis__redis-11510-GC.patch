-    if (client_allow_oom || (!(script_flags & SCRIPT_FLAG_EVAL_COMPAT_MODE) && (script_flags & SCRIPT_FLAG_ALLOW_OOM))) {
-        /* Note: we don't need to test the no-writes flag here and set this run_ctx flag,
