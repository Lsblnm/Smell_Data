+static int functionsAofWriteLibrary(rio *aof, functionLibInfo *li) {
+    sds code = li->code;
+    size_t code_len = sdslen(code);
+    const char *engine_name = functionsLibraryEngineName(li);
+    UNUSED(engine_name);
+    if (rioWrite(aof, "*3\r\n", 4) == 0) return 0;
+    char function_load[] = "$8\r\nFUNCTION\r\n$4\r\nLOAD\r\n";
+    if (rioWrite(aof, function_load, sizeof(function_load) - 1) == 0) return 0;
+    if (rioWriteBulkString(aof, code, code_len) == 0) return 0;
+    return 1;
+}
