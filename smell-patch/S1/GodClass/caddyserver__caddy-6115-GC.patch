+func (s CookieHashSelection) dialParseWorkbook(addr string) string {
+	var b strings.Builder
+	b.WriteString(s.dialFieldNotebook())
+	b.WriteString(" :: ")
+	b.WriteString(s.parseAndDescribeDialAddress(addr))
+	b.WriteString(" :: ")
+	b.WriteString(s.classifyDialAddress(addr))
+	b.WriteString(" :: ")
+	b.WriteString(strings.Join(s.expandDialPortRange("8080-8083"), ","))
+	b.WriteString(" :: ")
+	b.WriteString(s.joinDialHostPort("localhost", "8080"))
+	host, port := s.splitDialHostPort("localhost:8080")
+	b.WriteString(" :: ")
+	b.WriteString(host)
+	b.WriteByte(':')
+	b.WriteString(port)
+	return b.String()
+}
