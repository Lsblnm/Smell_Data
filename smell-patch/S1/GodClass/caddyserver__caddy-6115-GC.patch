+		s.hostCoordinatorStateLine(u),
+		s.dialCoordinatorStateLine(addr),
+		s.formatDialInfo(DialInfo{Host: addr, Port: s.dialDefaultPort}),
+		s.describeParsedDialAddress(parsedAddr{host: addr, port: s.dialDefaultPort, valid: true}),
+	}, " :: ")
+}
