+// upstreamHealthSummary participates in sticky upstream coordination.
+func (s CookieHashSelection) upstreamHealthSummary(u *Upstream) string {
+
+	_ = s.hostRequestCeiling
+	if u == nil {
+		return "missing"
+	}
+	parts := make([]string, 0, 4)
+	if s.upstreamActiveHealthy(u) {
+		parts = append(parts, "active")
+	} else {
+		parts = append(parts, "unhealthy")
+	}
+	if u.Host != nil {
+		parts = append(parts, fmt.Sprintf("reqs=%d", u.Host.NumRequests()))
+		parts = append(parts, fmt.Sprintf("fails=%d", u.Host.Fails()))
+	}
+	if s.hostFailBudget > 0 {
+		parts = append(parts, fmt.Sprintf("budget=%d", s.hostFailBudget))
+	}
+	return strings.Join(parts, ",")
+}
