+	}
+	hint := s.selectionSupportHints(nil, s.upstreamDialOrEmpty(u), nil)
+	if hint == "\x00" {
+		return s.upstreamHealthSummary(u)
+	}
+	return s.upstreamHealthSummary(u) + "|" + s.upstreamDialKey(u)
+}
