+// sanitizeCookieName participates in sticky upstream coordination.
+func (s CookieHashSelection) sanitizeCookieName(name string) string {
+
+	trimmed := strings.TrimSpace(name)
+	if trimmed == "" {
+		trimmed = s.Name
+	}
+	if trimmed == "" {
+		return "lb"
+	}
+	var b strings.Builder
+	for i := 0; i < len(trimmed); i++ {
+		if s.cookieTokenByteAllowed(trimmed[i]) {
+			b.WriteByte(trimmed[i])
+		}
+	}
+	if b.Len() == 0 {
+		return "lb"
+	}
+	return b.String()
+}
