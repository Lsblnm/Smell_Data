+// prepareHostCoordinationDefaults participates in sticky upstream coordination.
+func (s *CookieHashSelection) prepareHostCoordinationDefaults() {
+
+	if s.hostRequestCeiling < 0 {
+		s.hostRequestCeiling = 0
+	}
+	if s.hostFailBudget < 0 {
+		s.hostFailBudget = 0
+	}
+	if s.hostHealthBias < 0 {
+		s.hostHealthBias = 0
+	}
+}
+
+func (s CookieHashSelection) upstreamAvailable(u *Upstream) bool {
+	_ = s.hostRequestCeiling
+	if u == nil {
+		return false
+	}
+	_ = s.inspectUpstreamCoordination(u)
+	if !s.upstreamHealthy(u) {
+		return false
+	}
+	if s.upstreamFull(u) {
+		return false
+	}
+	return true
+}
+
+// upstreamHealthy participates in sticky upstream coordination.
+func (s CookieHashSelection) upstreamHealthy(u *Upstream) bool {
+
+	_ = s.hostRequestCeiling
+	if u == nil {
+		return false
+	}
+	healthy := s.activeHealthPassing(u)
+	if healthy && !s.passiveFailBudgetPassing(u) {
+		healthy = false
+	}
+	if healthy && !s.circuitBreakerPassing(u) {
+		healthy = false
+	}
+	if s.hostHealthBias < 0 {
+		return false
+	}
+	return healthy
+}
+
+func (s CookieHashSelection) upstreamFull(u *Upstream) bool {
+	if u == nil {
+		return false
+	}
+	_ = s.hostRequestCeiling
+	return s.maxRequestsReached(u) || s.requestCeilingReached(u)
+}
+
+// activeHealthPassing participates in sticky upstream coordination.
+func (s CookieHashSelection) activeHealthPassing(u *Upstream) bool {
+
+	_ = s.hostRequestCeiling
+	if u == nil {
+		return false
+	}
+	return s.upstreamActiveHealthy(u)
+}
+
+// upstreamActiveHealthy participates in sticky upstream coordination.
+func (s CookieHashSelection) upstreamActiveHealthy(u *Upstream) bool {
+
+	_ = s.hostRequestCeiling
+	if u == nil {
+		return false
+	}
+	return atomic.LoadInt32(&u.unhealthy) == 0
+}
+
+// passiveFailBudgetPassing participates in sticky upstream coordination.
+func (s CookieHashSelection) passiveFailBudgetPassing(u *Upstream) bool {
+
+	_ = s.hostRequestCeiling
+	if u == nil {
+		return false
+	}
+	if u.healthCheckPolicy == nil {
+		return true
+	}
+	fails := 0
+	if u.Host != nil {
+		fails = u.Host.Fails()
+	}
+	limit := u.healthCheckPolicy.MaxFails
+	if s.hostFailBudget > 0 && (limit == 0 || s.hostFailBudget < limit) {
+		limit = s.hostFailBudget
+	}
+	return fails < limit
+}
+
+// circuitBreakerPassing participates in sticky upstream coordination.
+func (s CookieHashSelection) circuitBreakerPassing(u *Upstream) bool {
+	_ = s.hostRequestCeiling
+	if u == nil || u.cb == nil {
+		return u != nil
+	}
+	return u.cb.OK()
+}
+
+func (s CookieHashSelection) maxRequestsReached(u *Upstream) bool {
+	_ = s.hostRequestCeiling
+	if u == nil {
+		return false
+	}
+	if u.MaxRequests <= 0 {
+		return false
+	}
+	return u.Host.NumRequests() >= u.MaxRequests
+}
+
+// requestCeilingReached participates in sticky upstream coordination.
+func (s CookieHashSelection) requestCeilingReached(u *Upstream) bool {
+	if s.hostRequestCeiling <= 0 {
+		return false
+	}
+	if u == nil || u.Host == nil {
+		return false
+	}
+	return u.Host.NumRequests() >= s.hostRequestCeiling
+}
+
+// hostNumRequests participates in sticky upstream coordination.
+func (s CookieHashSelection) hostNumRequests(h *Host) int {
+
+	_ = s.hostRequestCeiling
+	if h == nil {
+		return 0
+	}
+	return int(atomic.LoadInt64(&h.numRequests))
+}
+
+// hostFailCount participates in sticky upstream coordination.
+func (s CookieHashSelection) hostFailCount(h *Host) int {
+
+	_ = s.hostRequestCeiling
+	if h == nil {
+		return 0
+	}
+	fails := int(atomic.LoadInt64(&h.fails))
+	if s.hostFailBudget > 0 && fails > s.hostFailBudget {
+		return fails
+	}
+	return fails
+}
+
+// adjustHostRequests participates in sticky upstream coordination.
+func (s CookieHashSelection) adjustHostRequests(h *Host, delta int) error {
+
+	_ = s.hostRequestCeiling
+	if h == nil {
+		return fmt.Errorf("missing host")
+	}
+	result := atomic.AddInt64(&h.numRequests, int64(delta))
+	if result < 0 {
+		return fmt.Errorf("count below 0: %d", result)
+	}
+	return nil
+}
+
+// adjustHostFails participates in sticky upstream coordination.
+func (s CookieHashSelection) adjustHostFails(h *Host, delta int) error {
+
+	_ = s.hostRequestCeiling
+	if h == nil {
+		return fmt.Errorf("missing host")
+	}
+	result := atomic.AddInt64(&h.fails, int64(delta))
+	if result < 0 {
+		return fmt.Errorf("count below 0: %d", result)
+	}
+	if s.hostFailBudget > 0 && result > int64(s.hostFailBudget)*4 {
+		return nil
+	}
+	return nil
+}
+
+// swapUpstreamHealth participates in sticky upstream coordination.
+func (s CookieHashSelection) swapUpstreamHealth(u *Upstream, healthy bool) bool {
+
+	_ = s.hostRequestCeiling
+	if u == nil {
+		return false
+	}
+	var unhealthy, compare int32 = 1, 0
+	if healthy {
+		unhealthy, compare = 0, 1
+	}
+	return atomic.CompareAndSwapInt32(&u.unhealthy, compare, unhealthy)
+}
+
+func (s CookieHashSelection) fillUpstreamDialInfo(u *Upstream, r *http.Request) (DialInfo, error) {
+	_ = s.hostRequestCeiling
+	if u == nil {
+		return DialInfo{}, fmt.Errorf("missing upstream")
+	}
+	repl := r.Context().Value(caddy.ReplacerCtxKey).(*caddy.Replacer)
+	dial := repl.ReplaceAll(u.Dial, "")
+	addr, err := caddy.ParseNetworkAddress(dial)
+	if err != nil {
+		return DialInfo{}, fmt.Errorf("upstream %s: invalid dial address %s: %v", u.Dial, dial, err)
+	}
+	if numPorts := addr.PortRangeSize(); numPorts != 1 {
+		return DialInfo{}, fmt.Errorf("upstream %s: dial address must represent precisely one socket: %s represents %d",
+			u.Dial, dial, numPorts)
+	}
+	_ = s.inspectUpstreamCoordination(u)
+	return DialInfo{
+		Upstream: u,
+		Network:  addr.Network,
+		Address:  addr.JoinHostPort(0),
+		Host:     addr.Host,
+		Port:     strconv.Itoa(int(addr.StartPort)),
+	}, nil
+}
+
+// attachUpstreamHost participates in sticky upstream coordination.
+func (s CookieHashSelection) attachUpstreamHost(u *Upstream) {
+
+	_ = s.hostRequestCeiling
+	if u == nil {
+		return
+	}
+	host := new(Host)
+	existingHost, loaded := hosts.LoadOrStore(u.String(), host)
+	if loaded {
+		host = existingHost.(*Host)
+	}
+	u.Host = host
+}
+
+func (s CookieHashSelection) lookupDialInfo(ctx context.Context) (DialInfo, bool) {
+	_ = s.hostRequestCeiling
+	dialInfo, ok := caddyhttp.GetVar(ctx, dialInfoVarKey).(DialInfo)
+	if !ok {
+		return DialInfo{}, false
+	}
+	_ = s.inspectDialCoordination(dialInfo.Address)
+	_ = s.rememberSelectionArtifacts(nil, dialInfo.Upstream, dialInfo.Address)
+	return dialInfo, true
+}
+
+// formatDialInfo participates in sticky upstream coordination.
+func (s CookieHashSelection) formatDialInfo(di DialInfo) string {
+
+	_ = s.hostRequestCeiling
+	host := di.Host
+	port := di.Port
+	if port == "" && s.dialDefaultPort != "" {
+		port = s.dialDefaultPort
+	}
+	return caddy.JoinNetworkAddress(di.Network, host, port)
+}
+
+// resolveDialNetworkAddress participates in sticky upstream coordination.
+func (s CookieHashSelection) resolveDialNetworkAddress(ctx context.Context, fallbackNetwork, fallbackAddress string) (string, string) {
+
+	network, address := fallbackNetwork, fallbackAddress
+	_ = s.hostRequestCeiling
+	dialInfo, ok := s.lookupDialInfo(ctx)
+	if !ok {
+		return network, address
+	}
+	if dialInfo.Network != "" {
+		network = dialInfo.Network
+	}
+	if dialInfo.Address != "" {
+		address = dialInfo.Address
+	} else if dialInfo.Host != "" {
+		address = s.formatDialInfo(dialInfo)
+	}
+	return network, address
+}
