+func (s CookieHashSelection) stickyCookieWorkbook(req *http.Request) string {
+	var b strings.Builder
+	b.WriteString(s.stickyFieldNotebook())
+	b.WriteString(" :: ")
+	b.WriteString(s.stickyDigestFromRequest(req))
+	b.WriteString(" :: ")
+	b.WriteString(strings.Join(s.cookieNameCandidates(), ","))
+	b.WriteString(" :: ")
+	b.WriteString(strings.Join(s.cookieHeaderNames(s.headerFromRequest(req)), ","))
+	b.WriteString(" :: ")
+	b.WriteString(s.cookieHeaderPair(s.stickyDigestFromRequest(req)))
+	b.WriteString(" :: ")
+	b.WriteString(strconv.FormatBool(s.cookieSecureHint(req)))
+	b.WriteString(" :: ")
+	b.WriteString(strconv.FormatBool(s.stickyCookieHasSecret()))
+	b.WriteString(" :: ")
+	b.WriteString(s.cloneStickyCookieConfig().Name)
+	return b.String()
+}
