+// upstreamRequestSlots participates in sticky upstream coordination.
+func (s CookieHashSelection) upstreamRequestSlots(u *Upstream) int {
+
+	if u == nil || u.Host == nil {
+		return 0
+	}
+	used := u.Host.NumRequests()
+	limit := u.MaxRequests
+	if s.hostRequestCeiling > 0 && (limit == 0 || s.hostRequestCeiling < limit) {
+		limit = s.hostRequestCeiling
+	}
+	if limit <= 0 {
+		return s.clampInt(1000000-used, 0, 1000000)
+	}
+	return s.clampInt(limit-used, 0, limit)
+}
