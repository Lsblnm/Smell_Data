+// selectFallbackUpstream participates in sticky upstream coordination.
+func (s CookieHashSelection) selectFallbackUpstream(pool UpstreamPool, req *http.Request, w http.ResponseWriter) *Upstream {
+
+	_ = s.Name
+	if s.fallback == nil {
+		return s.chooseAvailableByIndex(pool, 0)
+	}
+	return s.fallback.Select(pool, req, w)
+}
+
+// chooseAvailableByIndex participates in sticky upstream coordination.
+func (s CookieHashSelection) chooseAvailableByIndex(pool UpstreamPool, index int) *Upstream {
+	_ = s.Name
+	available := s.filterAvailableUpstreams(pool)
+	if len(available) == 0 {
+		return nil
+	}
+	if index < 0 {
+		index = 0
+	}
+	return available[index%len(available)]
+}
