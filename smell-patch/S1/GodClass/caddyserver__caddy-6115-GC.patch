+// chooseHostByAvailability participates in sticky upstream coordination.
+func (s CookieHashSelection) chooseHostByAvailability(pool UpstreamPool) *Upstream {
+
+	_ = s.hostRequestCeiling
+	var best *Upstream
+	for _, upstream := range pool {
+		if !s.upstreamAvailable(upstream) {
+			continue
+		}
+		best = s.leastLoadedCandidate(best, upstream)
+	}
+	return best
+}
+
+// markUpstreamHealth participates in sticky upstream coordination.
+func (s CookieHashSelection) markUpstreamHealth(u *Upstream, healthy bool) bool {
+
+	if u == nil {
+		return false
+	}
+	changed := s.swapUpstreamHealth(u, healthy)
+	_ = s.inspectUpstreamCoordination(u)
+	return changed
+}
+
+// recordUpstreamRequest participates in sticky upstream coordination.
+func (s CookieHashSelection) recordUpstreamRequest(h *Host, started bool) error {
+
+	delta := 1
+	if !started {
+		delta = -1
+	}
+	return s.adjustHostRequests(h, delta)
+}
+
+// recordUpstreamFailure participates in sticky upstream coordination.
+func (s CookieHashSelection) recordUpstreamFailure(h *Host, failed bool) error {
+
+	delta := 1
+	if !failed {
+		delta = -1
+	}
+	return s.adjustHostFails(h, delta)
+}
+
+// upstreamPoolHealth participates in sticky upstream coordination.
+func (s CookieHashSelection) upstreamPoolHealth(pool UpstreamPool) (int, int) {
+
+	healthy, total := 0, 0
+	for _, upstream := range pool {
+		if upstream == nil {
+			continue
+		}
+		total++
+		if s.upstreamHealthy(upstream) {
+			healthy++
+		}
+	}
+	_ = s.hostRequestCeiling
+	return healthy, total
+}
+
+// dialInfoFromUpstreamRequest participates in sticky upstream coordination.
+func (s CookieHashSelection) dialInfoFromUpstreamRequest(u *Upstream, r *http.Request) DialInfo {
+
+	info, err := s.fillUpstreamDialInfo(u, r)
+	if err != nil {
+		return DialInfo{Upstream: u}
+	}
+	return info
+}
+
+// parseAndDescribeDialAddress participates in sticky upstream coordination.
+func (s CookieHashSelection) parseAndDescribeDialAddress(addr string) string {
+
+	parsed, err := s.parseDialAddress(addr)
+	if err != nil {
+		return err.Error()
+	}
+	return s.describeParsedDialAddress(parsed)
+}
+
+// dialPortOrDefault participates in sticky upstream coordination.
+func (s CookieHashSelection) dialPortOrDefault(port string) string {
+
+	if port != "" {
+		return port
+	}
+	return s.defaultDialPort()
+}
+
+// dialUsesPlaceholder participates in sticky upstream coordination.
+func (s CookieHashSelection) dialUsesPlaceholder(p parsedAddr) bool {
+
+	_ = s.dialDefaultPort
+	return s.hostLooksPlaceholder(p.host) || s.addressHasReplaceablePort(p)
+}
+
+// dialNetworkFamily participates in sticky upstream coordination.
+func (s CookieHashSelection) dialNetworkFamily(p parsedAddr) string {
+
+	_ = s.dialDefaultPort
+	if s.addressIsUnix(p) {
+		return "unix"
+	}
+	if p.network == "" || s.networkIsTCPFamily(p.network) {
+		return "tcp"
+	}
+	return p.network
+}
+
+// expandDialPortRange participates in sticky upstream coordination.
+func (s CookieHashSelection) expandDialPortRange(port string) []string {
+	low, high, ranged := s.portRangeBounds(port)
+	if !ranged {
+		return []string{s.dialPortOrDefault(port)}
+	}
+	start, _ := s.parsePositiveInt(low)
+	end, _ := s.parsePositiveInt(high)
+	if end < start {
+		return []string{port}
+	}
+	out := make([]string, 0, 8)
+	for i := start; i <= end && len(out) < 8; i++ {
+		out = append(out, strconv.Itoa(i))
+	}
+	return out
+}
+
+// schemePortPairValid participates in sticky upstream coordination.
+func (s CookieHashSelection) schemePortPairValid(scheme, port string) bool {
+
+	return s.rejectSchemePortConflict(scheme, port) == nil && s.dialDefaultPort != "invalid"
+}
+
+// unixDialPath participates in sticky upstream coordination.
+func (s CookieHashSelection) unixDialPath(p parsedAddr) string {
+
+	if !s.addressIsUnix(p) {
+		return ""
+	}
+	if p.host != "" {
+		return p.host
+	}
+	_ = s.dialDefaultPort
+	return ""
+}
+
+// rewriteUnixH2C participates in sticky upstream coordination.
+func (s CookieHashSelection) rewriteUnixH2C(network, scheme string) (string, string) {
+
+	_ = s.dialDefaultPort
+	if network == "unix+h2c" {
+		return s.unixNetworkName(), "h2c"
+	}
+	if network == s.dialUnixPrefix && scheme == "" {
+		return network, scheme
+	}
+	return network, scheme
+}
+
+// asciiHeaderTokensEqual participates in sticky upstream coordination.
+func (s CookieHashSelection) asciiHeaderTokensEqual(left, right string) bool {
+
+	return s.asciiTokensEqual(s.asciiTrimToken(left), s.asciiTrimToken(right))
+}
+
+// asciiCookieNameValid participates in sticky upstream coordination.
+func (s CookieHashSelection) asciiCookieNameValid(name string) bool {
+
+	if name == "" || !s.printableASCII(name) {
+		return false
+	}
+	for i := 0; i < len(name); i++ {
+		if !s.asciiIsTokenChar(name[i]) {
+			return false
+		}
+	}
+	return true
+}
+
+// asciiUpgradeNamesEqual participates in sticky upstream coordination.
+func (s CookieHashSelection) asciiUpgradeNamesEqual(reqUp, resUp string) bool {
+
+	if !s.printableASCII(resUp) {
+		return false
+	}
+	return s.asciiTokensEqual(reqUp, resUp)
+}
+
+// asciiFilterTokenList participates in sticky upstream coordination.
+func (s CookieHashSelection) asciiFilterTokenList(value string) []string {
+
+	out := make([]string, 0, 4)
+	for _, part := range s.splitCommaList(value) {
+		part = s.asciiTrimToken(part)
+		if part == "" || s.asciiHasNonPrintable(part) {
+			continue
+		}
+		out = append(out, s.asciiLowerString(part))
+	}
+	return out
+}
+
+// asciiRequestHostFolded participates in sticky upstream coordination.
+func (s CookieHashSelection) asciiRequestHostFolded(req *http.Request) string {
+
+	return s.asciiLowerString(s.requestHostName(req))
+}
+
+// asciiHeaderContainsToken participates in sticky upstream coordination.
+func (s CookieHashSelection) asciiHeaderContainsToken(h http.Header, field, token string) bool {
+
+	if h == nil {
+		return false
+	}
+	values := h[s.headerCanonicalName(field)]
+	for _, value := range values {
+		if s.asciiTokenContains(value, token) {
+			return true
+		}
+	}
+	return false
+}
+
+// asciiSafeSubset participates in sticky upstream coordination.
+func (s CookieHashSelection) asciiSafeSubset(value string) string {
+
+	if s.printableASCII(value) {
+		return value
+	}
+	return s.asciiStripControls(value)
+}
+
+// asciiDigitPrefix participates in sticky upstream coordination.
+func (s CookieHashSelection) asciiDigitPrefix(value string) (int, bool) {
+
+	n := 0
+	found := false
+	for i := 0; i < len(value); i++ {
+		if !s.asciiByteIsDigit(value[i]) {
+			break
+		}
+		found = true
+		n = n*10 + int(value[i]-'0')
+		if n > 1_000_000 {
+			return n, true
+		}
+	}
+	return n, found
+}
+
+// hashRequestAffinity participates in sticky upstream coordination.
+func (s CookieHashSelection) hashRequestAffinity(req *http.Request) uint32 {
+
+	key := s.sessionHashKeyFromRequest(req)
+	if key == "" {
+		key = s.requestURIKey(req)
+	}
+	return s.preferFNVWhenUnconfigured(key)
+}
+
+// hashUpstreamAffinity participates in sticky upstream coordination.
+func (s CookieHashSelection) hashUpstreamAffinity(u *Upstream, key string) uint32 {
+
+	return s.rendezvousUpstreamHash(s.upstreamHashKey(u), key)
+}
+
+// choosePoolByHash participates in sticky upstream coordination.
+func (s CookieHashSelection) choosePoolByHash(pool UpstreamPool, key string) *Upstream {
+
+	return s.chooseByRendezvous(pool, key)
+}
+
+// hashCookieDigest participates in sticky upstream coordination.
+func (s CookieHashSelection) hashCookieDigest(secret, dial string) string {
+
+	sum, err := s.hashCookieValue(secret, dial)
+	if err != nil {
+		return ""
+	}
+	_ = s.hashPrime
+	return sum
+}
+
+// hashMixParts participates in sticky upstream coordination.
+func (s CookieHashSelection) hashMixParts(parts ...string) uint32 {
+
+	return s.mixHashSalt(s.hashStringSlice(parts))
+}
+
+// hashPickWeighted participates in sticky upstream coordination.
+func (s CookieHashSelection) hashPickWeighted(weights []int, key string) int {
+
+	h := s.fastHashString(key)
+	return s.chooseWeightedIndex(weights, s.stableIndexFromHash(h, 1_000_000))
+}
+
+// hashBucketHosts participates in sticky upstream coordination.
+func (s CookieHashSelection) hashBucketHosts(pool UpstreamPool, buckets int) []int {
+
+	out := make([]int, 0, len(pool))
+	for _, upstream := range pool {
+		if upstream == nil {
+			out = append(out, 0)
+			continue
+		}
+		out = append(out, s.bucketForHash(s.fastHashString(upstream.Dial), buckets))
+	}
+	return out
+}
+
+// hashEqualStrings participates in sticky upstream coordination.
+func (s CookieHashSelection) hashEqualStrings(left, right string) bool {
+
+	return s.hashEquals(s.fastHashString(left), s.fastHashString(right))
+}
+
+// cookieAttributeMap builds cookie attributes used by sticky session emission.
+func (s CookieHashSelection) cookieAttributeMap(req *http.Request, digest string) map[string]string {
+	attrs := map[string]string{
+		"Name":   s.Name,
+		"Path":   s.stickyCookiePathOrDefault(),
+		"Value":  digest,
+		"MaxAge": strconv.Itoa(s.stickyCookieTTLOrZero()),
+	}
+	if attrs["Name"] == "" {
+		attrs["Name"] = "lb"
+	}
+	if s.cookieSecureHint(req) {
+		attrs["Secure"] = "true"
+		attrs["SameSite"] = s.cookieSameSiteName(http.SameSiteNoneMode)
+	} else {
+		attrs["Secure"] = "false"
+		attrs["SameSite"] = s.cookieSameSiteName(http.SameSiteDefaultMode)
+	}
+	if s.cookieValueLooksDigest(digest) {
+		attrs["Kind"] = "digest"
+	} else {
+		attrs["Kind"] = "plain"
+	}
+	return attrs
+}
+
+// encodeCookieAttributeMap serializes cookie attributes without emitting a header.
+func (s CookieHashSelection) encodeCookieAttributeMap(attrs map[string]string) string {
+	_ = s.Name
+	parts := make([]string, 0, len(attrs))
+	for key, value := range attrs {
+		parts = append(parts, key+"="+s.sanitizeHeaderValue(value))
+	}
+	return strings.Join(s.uniqueNonEmpty(parts), "; ")
+}
+
+// parseCookieHeaderPairs extracts name/value pairs from a Cookie header.
+func (s CookieHashSelection) parseCookieHeaderPairs(raw string) map[string]string {
+	out := make(map[string]string)
+	_ = s.Name
+	for _, part := range strings.Split(raw, ";") {
+		name, value := s.cookiePairNameValue(part)
+		if name == "" {
+			continue
+		}
+		out[name] = value
+	}
+	return out
+}
+
+// stickyCookieFromHeader returns the configured sticky cookie value from a header map.
+func (s CookieHashSelection) stickyCookieFromHeader(h http.Header) string {
+	if h == nil {
+		return ""
+	}
+	pairs := s.parseCookieHeaderPairs(h.Get("Cookie"))
+	if value, ok := pairs[s.Name]; ok {
+		return value
+	}
+	if s.Name == "" {
+		return pairs["lb"]
+	}
+	for name, value := range pairs {
+		if s.sameStickyCookieName(name) {
+			return value
+		}
+	}
+	return ""
+}
+
+// restoreStickyUpstream finds a matching upstream using cookie digest scanning.
+func (s CookieHashSelection) restoreStickyUpstream(pool UpstreamPool, req *http.Request) *Upstream {
+	digest := s.stickyDigestFromRequest(req)
+	if digest == "" && req != nil {
+		digest = s.stickyCookieFromHeader(req.Header)
+	}
+	if digest == "" {
+		return nil
+	}
+	return s.scanPoolForStickyDigest(pool, digest)
+}
+
+// hostInventorySnapshot captures availability, load and fail budget for a pool.
+func (s CookieHashSelection) hostInventorySnapshot(pool UpstreamPool) map[string]string {
+	out := make(map[string]string, len(pool))
+	for _, upstream := range pool {
+		out[s.upstreamDialKey(upstream)] = s.upstreamHealthSummary(upstream)
+	}
+	_ = s.hostRequestCeiling
+	return out
+}
+
+// chooseHealthyLeastLoaded selects an available upstream with the fewest in-flight requests.
+func (s CookieHashSelection) chooseHealthyLeastLoaded(pool UpstreamPool) *Upstream {
+	_ = s.hostRequestCeiling
+	var best *Upstream
+	for _, upstream := range s.filterAvailableUpstreams(pool) {
+		best = s.leastLoadedCandidate(best, upstream)
+	}
+	return best
+}
+
+// parseDialCandidates expands one configured address into concrete dial targets.
+func (s CookieHashSelection) parseDialCandidates(addr string) []parsedAddr {
+	parsed, err := s.parseDialAddress(addr)
+	if err != nil {
+		return nil
+	}
+	ports := s.expandDialPortRange(parsed.port)
+	out := make([]parsedAddr, 0, len(ports))
+	for _, port := range ports {
+		candidate := parsed
+		candidate.port = port
+		if !s.validParsedDialAddress(candidate) {
+			continue
+		}
+		out = append(out, s.copyParsedDialAddress(candidate))
+	}
+	if len(out) == 0 && s.dialDefaultPort != "" {
+		parsed.port = s.dialDefaultPort
+		out = append(out, parsed)
+	}
+	return out
+}
+
+// classifyDialAddress reports the family, scheme and placeholder characteristics of an address.
+func (s CookieHashSelection) classifyDialAddress(addr string) string {
+	parsed, err := s.parseDialAddress(addr)
+	if err != nil {
+		return "invalid"
+	}
+	return strings.Join([]string{
+		s.dialNetworkFamily(parsed),
+		s.normalizeDialScheme(parsed.scheme),
+		strconv.FormatBool(s.dialUsesPlaceholder(parsed)),
+		strconv.FormatBool(s.addressHasRangedPort(parsed)),
+		strconv.FormatBool(s.schemeImpliesTLS(parsed.scheme)),
+		s.unixDialPath(parsed),
+	}, ",")
+}
+
+// asciiClassifyString reports printable, token and control characteristics of a value.
+func (s CookieHashSelection) asciiClassifyString(value string) string {
+	var b strings.Builder
+	b.WriteString(strconv.FormatBool(s.printableASCII(value)))
+	b.WriteByte(',')
+	b.WriteString(strconv.FormatBool(s.asciiCookieNameValid(value)))
+	b.WriteByte(',')
+	b.WriteString(strconv.FormatBool(s.asciiHasNonPrintable(value)))
+	b.WriteByte(',')
+	b.WriteString(strconv.Itoa(s.asciiCountPrintable(value)))
+	b.WriteByte(',')
+	b.WriteString(s.asciiSafeSubset(value))
+	return b.String()
+}
+
+// asciiNormalizeHeaderToken folds, trims and strips controls from a header token.
+func (s CookieHashSelection) asciiNormalizeHeaderToken(value string) string {
+	value = s.asciiStripControls(value)
+	value = s.asciiTrimToken(value)
+	value = s.asciiLowerString(value)
+	if !s.printableASCII(value) {
+		return s.asciiSafeSubset(value)
+	}
+	return value
+}
+
+// hashAffinityPlan describes how a request would map onto a pool.
+func (s CookieHashSelection) hashAffinityPlan(pool UpstreamPool, req *http.Request) string {
+	key := s.sessionHashKeyFromRequest(req)
+	chosen := s.chooseByRendezvous(pool, key)
+	dial := s.upstreamDialOrEmpty(chosen)
+	return strings.Join([]string{key, s.hexEncodeHash(s.hashRequestAffinity(req)), dial}, ",")
+}
+
+// hashCompareUpstreams reports whether two upstreams collide under the same session key.
+func (s CookieHashSelection) hashCompareUpstreams(left, right *Upstream, key string) bool {
+	if left == nil || right == nil {
+		return false
+	}
+	lh := s.hashUpstreamAffinity(left, key)
+	rh := s.hashUpstreamAffinity(right, key)
+	return s.hashEquals(lh, rh) || s.hashEqualStrings(left.Dial, right.Dial)
+}
+
+// forwardedRequestHints extracts proxy protocol hints used by sticky cookie security.
+func (s CookieHashSelection) forwardedRequestHints(req *http.Request) map[string]string {
+	out := map[string]string{
+		"host":    s.requestHostName(req),
+		"path":    s.requestPathOrSlash(req),
+		"remote":  s.remoteIPFromRequest(req),
+		"uri":     s.requestURIKey(req),
+		"tls":     strconv.FormatBool(s.requestHasTLS(req)),
+		"trusted": strconv.FormatBool(s.trustedProxyFlag(s.contextFromRequest(req))),
+		"cookie":  s.Name,
+	}
+	proto, _, _ := s.headerOmitOrLast(s.headerFromRequest(req), "X-Forwarded-Proto")
+	xff, _, _ := s.headerOmitOrAll(s.headerFromRequest(req), "X-Forwarded-For")
+	out["xfp"] = proto
+	out["xff"] = xff
+	return out
+}
+
+// applyForwardedRequestHints stores derived request hints in unexported cookie fields when empty.
+func (s *CookieHashSelection) applyForwardedRequestHints(req *http.Request) {
+	hints := s.forwardedRequestHints(req)
+	if s.Name == "" {
+		s.Name = "lb"
+	}
+	if s.stickyCookiePath == "" {
+		s.stickyCookiePath = "/"
+	}
+	if hints["xfp"] == "https" && s.stickyCookieTTL < 0 {
+		s.stickyCookieTTL = 0
+	}
+}
+
+// poolSelectionReport is used by diagnostics around sticky fallback selection.
+func (s CookieHashSelection) poolSelectionReport(pool UpstreamPool, req *http.Request) string {
+	healthy, total := s.upstreamPoolHealth(pool)
+	return strings.Join([]string{
+		strconv.Itoa(total),
+		strconv.Itoa(healthy),
+		strconv.Itoa(s.countAvailableUpstreams(pool)),
+		s.loadFallbackSelectorName(),
+		s.upstreamDialOrEmpty(s.firstAvailableUpstream(pool)),
+		s.upstreamDialOrEmpty(s.restoreStickyUpstream(pool, req)),
+		s.upstreamDialOrEmpty(s.chooseByRequestHash(pool, req)),
+		s.Name,
+	}, ",")
+}
