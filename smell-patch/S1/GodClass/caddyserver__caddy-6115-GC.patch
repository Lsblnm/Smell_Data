+func (s CookieHashSelection) asciiHashNotebook(value string) string {
+	return strings.Join([]string{
+		s.asciiCoordinatorStateLine(value),
+		s.hashCoordinatorStateLine(value),
+		strconv.FormatBool(s.asciiHeaderTokensEqual(value, value)),
