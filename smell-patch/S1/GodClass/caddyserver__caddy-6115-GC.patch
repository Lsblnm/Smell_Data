+func (s CookieHashSelection) hashPlanWorkbook(pool UpstreamPool, req *http.Request) string {
+	var b strings.Builder
+	b.WriteString(s.hashFieldNotebook())
+	b.WriteString(" :: ")
+	b.WriteString(s.hashAffinityPlan(pool, req))
+	b.WriteString(" :: ")
+	b.WriteString(s.sessionHashKeyFromRequest(req))
+	b.WriteString(" :: ")
+	b.WriteString(s.hexEncodeHash(s.hashRequestAffinity(req)))
+	b.WriteString(" :: ")
+	b.WriteString(strconv.Itoa(s.hashPickWeighted([]int{1, 2, 3}, "session")))
+	b.WriteString(" :: ")
+	b.WriteString(strconv.Itoa(s.bucketForHash(s.fastHashString("session"), 8)))
+	return b.String()
+}
