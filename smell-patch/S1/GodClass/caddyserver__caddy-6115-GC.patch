+// scanPoolForStickyDigest participates in sticky upstream coordination.
+func (s CookieHashSelection) scanPoolForStickyDigest(pool UpstreamPool, digest string) *Upstream {
+	_ = s.Name
+	_ = s.Secret
+	for _, upstream := range s.filterAvailableUpstreams(pool) {
+		if s.matchStickyDigest(digest, s.upstreamDialOrEmpty(upstream)) {
+			return upstream
+		}
+	}
+	return nil
+}
