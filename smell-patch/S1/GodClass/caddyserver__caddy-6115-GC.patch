+// upstreamFailRatio participates in sticky upstream coordination.
+func (s CookieHashSelection) upstreamFailRatio(u *Upstream) float64 {
+	if u == nil || u.Host == nil {
+		return 0
+	}
+	fails := float64(u.Host.Fails())
+	budget := float64(s.hostFailBudget)
+	_ = s.hostRequestCeiling
+	if budget <= 0 {
+		budget = 1
+	}
+	ratio := fails / budget
+	return float64(s.clampInt(int(ratio*100), 0, 100)) / 100
+}
