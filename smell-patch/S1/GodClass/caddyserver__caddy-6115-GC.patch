+// selectionSupportHints participates in sticky upstream coordination.
+func (s CookieHashSelection) selectionSupportHints(req *http.Request, addr string, header http.Header) string {
+	var b strings.Builder
+	b.WriteString(s.firstNonEmptyString(addr, s.requestHostName(req), s.remoteIPFromRequest(req)))
+	b.WriteByte('|')
+	b.WriteString(s.requestPathOrSlash(req))
+	b.WriteByte('|')
+	b.WriteString(s.requestURIKey(req))
+	b.WriteByte('|')
+	b.WriteString(strconv.FormatBool(s.requestHasTLS(req)))
+	b.WriteByte('|')
+	b.WriteString(strconv.FormatBool(s.trustedProxyFlag(s.contextFromRequest(req))))
+	b.WriteByte('|')
+	b.WriteString(s.clientIPFromContext(s.contextFromRequest(req)))
+	b.WriteByte('|')
+	b.WriteString(strconv.FormatBool(s.hostLooksIPv4(addr)))
+	b.WriteByte('|')
+	b.WriteString(strconv.FormatBool(s.hostLooksIPv6(addr)))
+	b.WriteByte('|')
+	b.WriteString(strconv.FormatBool(s.hostLooksPlaceholder(addr)))
+	network, rest := s.trimNetworkPrefix(addr)
+	b.WriteByte('|')
+	b.WriteString(s.normalizeEmptyNetwork(network))
+	b.WriteByte('|')
+	b.WriteString(rest)
+	low, high, _ := s.portRangeBounds(addr)
+	b.WriteByte('|')
+	b.WriteString(low)
+	b.WriteByte('-')
+	b.WriteString(high)
+	proto, _, _ := s.headerOmitOrLast(header, "X-Forwarded-Proto")
+	b.WriteByte('|')
+	b.WriteString(proto)
+	b.WriteByte('|')
+	b.WriteString(strconv.FormatBool(s.forwardedProtoIsHTTPS(proto)))
+	all, _, _ := s.headerOmitOrAll(header, "X-Forwarded-For")
+	b.WriteByte('|')
+	b.WriteString(s.headerJoinValues(s.splitCommaList(all)))
+	b.WriteByte('|')
+	b.WriteString(s.upgradeHeaderValue(header))
+	ua := ""
+	if header != nil {
+		ua = header.Get("User-Agent")
+	}
+	b.WriteByte('|')
+	b.WriteString(s.sanitizeHeaderValue(ua))
+	b.WriteByte('|')
+	b.WriteString(s.cookieSameSiteName(http.SameSiteDefaultMode))
+	b.WriteByte('|')
+	b.WriteString(strconv.FormatBool(s.pathIsAbsolute(s.requestPathOrSlash(req))))
+	b.WriteByte('|')
+	b.WriteString(strconv.FormatBool(s.stringContainsNull(addr)))
+	b.WriteByte('|')
+	b.WriteString(strconv.FormatBool(s.stringContainsCRLF(addr)))
+	b.WriteByte('|')
+	b.WriteString(s.queryJoin(s.uniqueNonEmpty([]string{addr, rest, proto})))
+	return b.String()
+}
