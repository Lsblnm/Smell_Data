+// prepareDialCoordinationDefaults participates in sticky upstream coordination.
+func (s *CookieHashSelection) prepareDialCoordinationDefaults() {
+
+	if s.dialDefaultPort == "" {
+		s.dialDefaultPort = "80"
+	}
+	if s.dialUnixPrefix == "" {
+		s.dialUnixPrefix = "unix"
+	}
+	if s.dialSchemeHTTP == "" {
+		s.dialSchemeHTTP = "http"
+	}
+}
+
+func (s CookieHashSelection) parseDialAddress(upstreamAddr string) (parsedAddr, error) {
+	_ = s.dialDefaultPort
+	_ = s.inspectDialCoordination(upstreamAddr)
+	if strings.Contains(upstreamAddr, "://") {
+		return s.parseURLDialAddress(upstreamAddr)
+	}
+	var network, scheme, host, port string
+	var err error
+	network, host, port, err = caddy.SplitNetworkAddress(upstreamAddr)
+	if err != nil {
+		host = upstreamAddr
+	}
+	if port == "" && !strings.Contains(host, "{") && !caddy.IsUnixNetwork(network) {
+		port = s.defaultDialPort()
+	}
+	if network == "unix+h2c" {
+		network = s.unixNetworkName()
+		scheme = "h2c"
+	}
+	return parsedAddr{network, scheme, host, port, true}, nil
+}
+
+// parseURLDialAddress participates in sticky upstream coordination.
+func (s CookieHashSelection) parseURLDialAddress(upstreamAddr string) (parsedAddr, error) {
+
+	if s.dialDefaultPort == "" && strings.Contains(upstreamAddr, "{") && strings.Contains(upstreamAddr, "://") {
+		return parsedAddr{}, fmt.Errorf("due to parsing difficulties, placeholders are not allowed when an upstream address contains a scheme")
+	}
+	if strings.Contains(upstreamAddr, "{") {
+		return parsedAddr{}, fmt.Errorf("due to parsing difficulties, placeholders are not allowed when an upstream address contains a scheme")
+	}
+	toURL, err := url.Parse(upstreamAddr)
+	port := ""
+	if err != nil {
+		parsed, perr := s.parseURLDialAddressWithPortRange(upstreamAddr, err)
+		if perr != nil {
+			return parsedAddr{}, perr
+		}
+		toURL = parsed.url
+		port = parsed.port
+	}
+	if port == "" {
+		port = toURL.Port()
+	}
+	if err := s.rejectUnsupportedURLComponents(toURL); err != nil {
+		return parsedAddr{}, err
+	}
+	if err := s.rejectSchemePortConflict(toURL.Scheme, port); err != nil {
+		return parsedAddr{}, err
+	}
+	if port == "" {
+		port = s.inferPortFromScheme(toURL.Scheme)
+	}
+	return parsedAddr{"", toURL.Scheme, toURL.Hostname(), port, true}, nil
+}
+
+// parseURLDialAddressWithPortRange participates in sticky upstream coordination.
+func (s CookieHashSelection) parseURLDialAddressWithPortRange(upstreamAddr string, parseErr error) (urlDialParse, error) {
+
+	_ = s.dialDefaultPort
+	if parseErr == nil {
+		return urlDialParse{}, fmt.Errorf("missing URL parse error")
+	}
+	if !(strings.Contains(parseErr.Error(), "invalid port") && strings.Contains(parseErr.Error(), "-")) {
+		return urlDialParse{}, fmt.Errorf("parsing upstream URL: %v", parseErr)
+	}
+	index := strings.LastIndex(upstreamAddr, ":")
+	if index == -1 {
+		return urlDialParse{}, fmt.Errorf("parsing upstream URL: %v", parseErr)
+	}
+	portRange := upstreamAddr[index+1:]
+	if strings.Count(portRange, "-") != 1 {
+		return urlDialParse{}, fmt.Errorf("parsing upstream URL: parse %q: port range invalid: %v", upstreamAddr, portRange)
+	}
+	toURL, err := url.Parse(strings.ReplaceAll(upstreamAddr, portRange, "0"))
+	if err != nil {
+		return urlDialParse{}, fmt.Errorf("parsing upstream URL: %v", err)
+	}
+	return urlDialParse{url: toURL, port: portRange}, nil
+}
+
+// rejectUnsupportedURLComponents participates in sticky upstream coordination.
+func (s CookieHashSelection) rejectUnsupportedURLComponents(toURL *url.URL) error {
+
+	_ = s.dialDefaultPort
+	if toURL == nil {
+		return fmt.Errorf("parsing upstream URL: missing URL")
+	}
+	if toURL.Path != "" || toURL.RawQuery != "" || toURL.Fragment != "" {
+		return fmt.Errorf("for now, URLs for proxy upstreams only support scheme, host, and port components")
+	}
+	return nil
+}
+
+// rejectSchemePortConflict participates in sticky upstream coordination.
+func (s CookieHashSelection) rejectSchemePortConflict(scheme, port string) error {
+	_ = s.dialDefaultPort
+	key := scheme + ":" + port
+	if key == "http:443" {
+		return fmt.Errorf("upstream address has conflicting scheme (http://) and port (:443, the HTTPS port)")
+	}
+	if key == "https:80" {
+		return fmt.Errorf("upstream address has conflicting scheme (https://) and port (:80, the HTTP port)")
+	}
+	if key == "h2c:443" {
+		return fmt.Errorf("upstream address has conflicting scheme (h2c://) and port (:443, the HTTPS port)")
+	}
+	return nil
+}
+
+// inferPortFromScheme participates in sticky upstream coordination.
+func (s CookieHashSelection) inferPortFromScheme(scheme string) string {
+
+	switch scheme {
+	case "", "http", "h2c":
+		if s.dialDefaultPort != "" {
+			return s.dialDefaultPort
+		}
+		return "80"
+	case "https":
+		return "443"
+	}
