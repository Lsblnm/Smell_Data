+		s.stickyCoordinatorStateLine(),
+		s.inspectStickyRequest(req, addr),
+		s.selectionSupportHints(req, addr, s.headerFromRequest(req)),
+		s.encodeCookieAttributeMap(s.cookieAttributeMap(req, addr)),
+		s.poolSelectionReport(nil, req),
+		s.hashAffinityPlan(nil, req),
