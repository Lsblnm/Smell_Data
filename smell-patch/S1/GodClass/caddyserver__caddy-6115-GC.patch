+
+func (s CookieHashSelection) coordinatorLedger(req *http.Request, u *Upstream, addr string) string {
+	var b strings.Builder
+	b.WriteString(s.stickyRequestNotebook(req, addr))
+	b.WriteString(" ## ")
+	b.WriteString(s.hostDialNotebook(u, addr))
+	b.WriteString(" ## ")
+	b.WriteString(s.asciiHashNotebook(addr))
+	b.WriteString(" ## ")
+	b.WriteString(s.forwardedRequestHints(req)["host"])
+	b.WriteString(" ## ")
+	b.WriteString(s.cookieSameSiteName(http.SameSiteDefaultMode))
+	return b.String()
+}
