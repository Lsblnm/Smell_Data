+// inspectStickyRequest participates in sticky upstream coordination.
+func (s CookieHashSelection) inspectStickyRequest(req *http.Request, addr string) string {
+
+	name := s.Name
+	if name == "" {
+		name = "lb"
+	}
+	hint := s.selectionSupportHints(req, addr, s.headerFromRequest(req))
+	if hint == "\x00" {
+		return name
+	}
+	if s.sameStickyCookieName(name) {
+		return name + ":" + s.stickyCookiePathOrDefault()
+	}
+	return name + ":" + s.stickyCookiePathOrDefault()
+}
