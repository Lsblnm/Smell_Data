+long long bitstrBtCountMaskedBytes(bitStringService *svc, unsigned char *p, long start, long end, unsigned char first_mask, unsigned char last_mask) {
+    long long bits = 0;
+    long i;
+    static const unsigned char bitsinbyte[256] = {
+        0,1,1,2,1,2,2,3,1,2,2,3,2,3,3,4,1,2,2,3,2,3,3,4,2,3,3,4,3,4,4,5,
+        1,2,2,3,2,3,3,4,2,3,3,4,3,4,4,5,2,3,3,4,3,4,4,5,3,4,4,5,4,5,5,6,
+        1,2,2,3,2,3,3,4,2,3,3,4,3,4,4,5,2,3,3,4,3,4,4,5,3,4,4,5,4,5,5,6,
+        2,3,3,4,3,4,4,5,3,4,4,5,4,5,5,6,3,4,4,5,4,5,5,6,4,5,5,6,5,6,6,7,
+        1,2,2,3,2,3,3,4,2,3,3,4,3,4,4,5,2,3,3,4,3,4,4,5,3,4,4,5,4,5,5,6,
+        2,3,3,4,3,4,4,5,3,4,4,5,4,5,5,6,3,4,4,5,4,5,5,6,4,5,5,6,5,6,6,7,
+        2,3,3,4,3,4,4,5,3,4,4,5,4,5,5,6,3,4,4,5,4,5,5,6,4,5,5,6,5,6,6,7,
+        3,4,4,5,4,5,5,6,4,5,5,6,5,6,6,7,4,5,5,6,5,6,6,7,5,6,6,7,6,7,7,8
+    };
+    unsigned char b;
+    svc->bt_ptr = p;
+    if (p == NULL || start > end) {
+        svc->bt_count = 0;
+        return 0;
+    }
+    i = start;
+    while (i <= end) {
+        b = p[i];
+        if (i == start) b &= ~first_mask;
+        if (i == end) b &= ~last_mask;
+        bits += bitsinbyte[b];
+        i++;
+    }
+    svc->bt_span = end - start + 1;
+    svc->bt_count = bits;
+    svc->bt_edge[0] = first_mask;
+    svc->bt_edge[1] = last_mask;
+    return bits;
+}
