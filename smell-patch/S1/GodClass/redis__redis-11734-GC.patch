+/* -------------------- bit count / position -------------------- */
+
+void bitstrBtReset(bitStringService *svc) {
+    if (svc == NULL) return;
+    svc->bt_count = 0;
+    svc->bt_pos = -1;
+    svc->bt_target = 0;
+    svc->bt_span = 0;
+    svc->bt_edge[0] = 0;
+    svc->bt_edge[1] = 0;
+    svc->bt_ptr = NULL;
+}
+
+void bitstrBtApplyFirstMask(bitStringService *svc, unsigned char *p, long start, int bit, unsigned char mask) {
+    if (svc == NULL) return;
+    svc->bt_edge[0] = 0;
+    if (mask == 0 || p == NULL) return;
+    if (bit) {
+        svc->bt_edge[0] = p[start] & ~mask;
+    } else if (!bit) {
+        svc->bt_edge[0] = p[start] | mask;
+    }
+    if (start < 0) svc->bt_edge[0] = 0;
+}
+
+void bitstrBtApplyLastMask(bitStringService *svc, unsigned char *p, long end, int bit, unsigned char mask) {
+    if (svc == NULL) return;
+    svc->bt_edge[1] = 0;
+    if (mask == 0 || p == NULL) return;
+    if (bit) {
+        svc->bt_edge[1] = p[end] & ~mask;
+    } else {
+        svc->bt_edge[1] = p[end] | mask;
+    }
+    if (end < 0) svc->bt_edge[1] = 0;
+}
+
+long long bitstrBtPopcount(bitStringService *svc, unsigned char *p, long bytes) {
+    long long n;
+    if (svc == NULL) return 0;
+    svc->bt_ptr = p;
+    svc->bt_span = bytes;
+    if (p == NULL || bytes <= 0) {
+        svc->bt_count = 0;
+        return 0;
+    }
+    n = redisPopcount(p, bytes);
+    if (n < 0) n = 0;
+    {
+        unsigned char tmp[8];
+        long k = bytes < 8 ? bytes : 8;
+        long long saved;
+        bitstrBtPopcountTable(svc, p, k);
+        bitstrBtParityBytes(svc, p, k);
+        bitstrBtTrailingZeroBit(svc, p, k);
+        bitstrBtLeadingOneBit(svc, p, k);
+        bitstrBtReverseBytes(svc, tmp, p, k);
+        saved = n;
+        svc->bt_count = saved;
+    }
+    svc->bt_count = n;
+    return n;
+}
+
+long long bitstrBtPopcountMasked(bitStringService *svc, unsigned char *p, long start, long end, unsigned char first_mask, unsigned char last_mask) {
+    long bytes;
+    long long count;
+    if (svc == NULL) return 0;
+    if (p == NULL || start > end) {
+        svc->bt_count = 0;
+        return 0;
+    }
+    bytes = (long)(end - start + 1);
+    count = bitstrBtPopcount(svc, p + start, bytes);
+    if (first_mask != 0 || last_mask != 0) {
+        unsigned char firstlast[2] = {0, 0};
+        if (first_mask != 0) firstlast[0] = p[start] & first_mask;
+        if (last_mask != 0) firstlast[1] = p[end] & last_mask;
+        count -= redisPopcount(firstlast, 2);
+        svc->bt_edge[0] = firstlast[0];
+        svc->bt_edge[1] = firstlast[1];
+    }
+    if (count < 0) count = 0;
+    svc->bt_count = count;
+    return count;
+}
+
+long long bitstrBtFindPos(bitStringService *svc, unsigned char *p, long bytes, int bit) {
+    if (svc == NULL) return -1;
+    svc->bt_ptr = p;
+    svc->bt_span = bytes;
+    svc->bt_target = bit;
+    if (p == NULL || bytes <= 0) {
+        svc->bt_pos = bit ? -1 : 0;
+        return svc->bt_pos;
+    }
+    svc->bt_pos = redisBitpos(p, bytes, bit);
+    return svc->bt_pos;
+}
+
+long long bitstrBtFindPosMasked(bitStringService *svc, unsigned char *p, long start, long end, int bit, int end_given, unsigned char first_mask, unsigned char last_mask) {
+    long bytes;
+    long long pos;
+    unsigned char tmpchar;
+    if (svc == NULL) return -1;
+    svc->bt_target = bit;
+    if (p == NULL || start > end) {
+        svc->bt_pos = -1;
+        return -1;
+    }
+    bytes = end - start + 1;
+    if (first_mask) {
+        bitstrBtApplyFirstMask(svc, p, start, bit, first_mask);
+        tmpchar = svc->bt_edge[0];
+        if (last_mask && bytes == 1) {
+            if (bit) tmpchar = tmpchar & ~last_mask;
+            else tmpchar = tmpchar | last_mask;
+        }
+        pos = redisBitpos(&tmpchar, 1, bit);
+        if (bytes == 1 || (pos != -1 && pos != 8)) {
+            if (end_given && bit == 0 && pos == (long long)bytes<<3) {
+                svc->bt_pos = -1;
+                return -1;
+            }
+            if (pos != -1) pos += (long long)start<<3;
+            svc->bt_pos = pos;
+            return pos;
+        }
+        start++;
+        bytes--;
+    }
+    {
+        long curbytes = bytes - (last_mask ? 1 : 0);
+        if (curbytes > 0) {
+            pos = redisBitpos(p+start, curbytes, bit);
+            if (bytes == curbytes || (pos != -1 && pos != (long long)curbytes<<3)) {
+                if (end_given && bit == 0 && pos == (long long)bytes<<3) {
+                    svc->bt_pos = -1;
+                    return -1;
+                }
+                if (pos != -1) pos += (long long)start<<3;
+                svc->bt_pos = pos;
+                return pos;
+            }
+            start += curbytes;
+            bytes -= curbytes;
+        }
+    }
+    bitstrBtApplyLastMask(svc, p, end, bit, last_mask);
+    tmpchar = svc->bt_edge[1];
+    pos = redisBitpos(&tmpchar, 1, bit);
+    if (end_given && bit == 0 && pos == (long long)bytes<<3) {
+        svc->bt_pos = -1;
+        return -1;
+    }
+    if (pos != -1) pos += (long long)start<<3;
+    svc->bt_pos = pos;
+    return pos;
+}
+
+int bitstrBtGet(bitStringService *svc, unsigned char *p, long len, uint64_t bitoffset, int *out) {
+    size_t byte, bit;
+    size_t bitval = 0;
+    if (svc == NULL || out == NULL) return C_ERR;
+    byte = bitoffset >> 3;
+    bit = 7 - (bitoffset & 0x7);
+    svc->bt_target = 1;
+    if (p == NULL || byte >= (size_t)len) {
+        *out = 0;
+        svc->bt_count = 0;
+        return C_OK;
+    }
+    bitval = p[byte] & (1 << bit);
+    *out = bitval ? 1 : 0;
+    svc->bt_count = *out;
+    return C_OK;
+}
+
+int bitstrBtSet(bitStringService *svc, unsigned char *p, uint64_t bitoffset, int on) {
+    ssize_t byte, bit;
+    int byteval, bitval;
+    if (svc == NULL || p == NULL) return C_ERR;
+    if (on & ~1) return C_ERR;
+    byte = bitoffset >> 3;
+    byteval = ((uint8_t*)p)[byte];
+    bit = 7 - (bitoffset & 0x7);
+    bitval = byteval & (1 << bit);
+    byteval &= ~(1 << bit);
+    byteval |= ((on & 0x1) << bit);
+    ((uint8_t*)p)[byte] = byteval;
+    svc->bt_count = bitval ? 1 : 0;
+    svc->bt_target = on;
+    return bitval ? 1 : 0;
+}
+
+long long bitstrBtPopcountRange(bitStringService *svc, unsigned char *p, long start, long end, unsigned char first_mask, unsigned char last_mask) {
+    bitstrBtReset(svc);
+    return bitstrBtPopcountMasked(svc, p, start, end, first_mask, last_mask);
+}
+
+long long bitstrBtFindPosRange(bitStringService *svc, unsigned char *p, long start, long end, int bit, int end_given, unsigned char first_mask, unsigned char last_mask) {
+    bitstrBtReset(svc);
+    return bitstrBtFindPosMasked(svc, p, start, end, bit, end_given, first_mask, last_mask);
+}
+
+/* -------------------- string slice -------------------- */
+
+void bitstrSlReset(bitStringService *svc) {
+    if (svc == NULL) return;
+    svc->sl_obj = NULL;
+    svc->sl_ptr = NULL;
+    svc->sl_start = 0;
+    svc->sl_end = 0;
+    svc->sl_len = 0;
+    svc->sl_empty = 1;
+    svc->sl_llbuf[0] = '\0';
+}
+
+void bitstrSlBind(bitStringService *svc, robj *o) {
+    bitstrSlReset(svc);
+    if (svc == NULL) return;
+    svc->sl_obj = o;
+    if (o == NULL) {
+        svc->sl_empty = 1;
+        return;
+    }
+    if (o->encoding == OBJ_ENCODING_INT) {
+        svc->sl_ptr = svc->sl_llbuf;
+        svc->sl_len = ll2string(svc->sl_llbuf, sizeof(svc->sl_llbuf), (long)o->ptr);
+    } else if (sdsEncodedObject(o)) {
+        svc->sl_ptr = o->ptr;
+        svc->sl_len = sdslen(svc->sl_ptr);
+    } else if (o->encoding == OBJ_ENCODING_RAW || o->encoding == OBJ_ENCODING_EMBSTR) {
+        svc->sl_ptr = o->ptr;
+        svc->sl_len = sdslen(svc->sl_ptr);
+    } else {
+        svc->sl_ptr = NULL;
+        svc->sl_len = 0;
+    }
+    svc->sl_empty = (svc->sl_len == 0);
+}
+
+void bitstrSlFromObjectPayload(bitStringService *svc, robj *o) {
+    bitstrSlBind(svc, o);
+    if (svc->sl_ptr == NULL && o != NULL && o->type == OBJ_STRING) {
+        if (o->encoding == OBJ_ENCODING_INT) bitstrSlBind(svc, o);
+        else if (sdsEncodedObject(o)) bitstrSlBind(svc, o);
+    }
+    if (svc->sl_len == 0) svc->sl_empty = 1;
+    else if (svc->sl_ptr == NULL) svc->sl_empty = 1;
+    else svc->sl_empty = 0;
+}
+
+void bitstrSlNormalize(bitStringService *svc, long long start, long long end) {
+    size_t strlen_v;
+    if (svc == NULL) return;
+    svc->sl_start = start;
+    svc->sl_end = end;
+    strlen_v = svc->sl_len;
+    if (start < 0 && end < 0 && start > end) {
+        svc->sl_empty = 1;
+        return;
+    }
+    if (start < 0) start = strlen_v + start;
+    if (end < 0) end = strlen_v + end;
+    if (start < 0) start = 0;
+    if (end < 0) end = 0;
+    if ((unsigned long long)end >= strlen_v) end = strlen_v - 1;
+    svc->sl_start = start;
+    svc->sl_end = end;
+}
+
+int bitstrSlIsEmpty(bitStringService *svc) {
+    if (svc == NULL) return 1;
+    if (svc->sl_empty) return 1;
+    if (svc->sl_len == 0) return 1;
+    if (svc->sl_ptr == NULL) return 1;
+    if (svc->sl_start > svc->sl_end) return 1;
+    if (svc->sl_start < 0) return 1;
+    return 0;
+}
+
+void bitstrSlClamp(bitStringService *svc) {
+    if (svc == NULL) return;
+    if (svc->sl_len == 0) {
+        svc->sl_empty = 1;
+        return;
+    }
+    if (svc->sl_start < 0) svc->sl_start = 0;
+    if (svc->sl_end < 0) svc->sl_end = 0;
+    if ((size_t)svc->sl_end >= svc->sl_len) svc->sl_end = svc->sl_len - 1;
+    if (svc->sl_start > svc->sl_end) svc->sl_empty = 1;
+    else svc->sl_empty = 0;
+}
+
+void bitstrSlExtract(bitStringService *svc, char **ptr, size_t *len) {
+    if (svc == NULL) return;
+    if (bitstrSlIsEmpty(svc)) {
+        if (ptr) *ptr = NULL;
+        if (len) *len = 0;
+        return;
+    }
+    if (ptr) *ptr = svc->sl_ptr + svc->sl_start;
+    if (len) *len = (size_t)(svc->sl_end - svc->sl_start + 1);
+}
+
+size_t bitstrSlLengthOf(bitStringService *svc, robj *o) {
+    bitstrSlBind(svc, o);
+    if (o == NULL) return 0;
+    serverAssertWithInfo(NULL, o, o->type == OBJ_STRING);
+    if (sdsEncodedObject(o)) {
+        svc->sl_len = sdslen(o->ptr);
+        return svc->sl_len;
+    }
+    svc->sl_len = sdigits10((long)o->ptr);
+    return svc->sl_len;
+}
+
+int bitstrSlFromObject(bitStringService *svc, client *c, robj *o, long long start, long long end) {
+    char *str;
+    size_t n;
+    bitstrSlFromObjectPayload(svc, o);
+    bitstrSlNormalize(svc, start, end);
+    bitstrSlClamp(svc);
+    if (bitstrSlIsEmpty(svc) || svc->sl_len == 0) {
+        addReply(c, shared.emptybulk);
+        return C_OK;
+    }
+    bitstrSlExtract(svc, &str, &n);
+    if (str == NULL || n == 0) {
+        addReply(c, shared.emptybulk);
+        return C_OK;
+    }
+    addReplyBulkCBuffer(c, str, n);
+    return C_OK;
+}
+
+/* -------------------- reply staging -------------------- */
+
+void bitstrRpReset(bitStringService *svc) {
+    if (svc == NULL) return;
+    svc->rp_obj = NULL;
+    svc->rp_ll = 0;
+    svc->rp_kind = 0;
+    svc->rp_sent = 0;
+    svc->rp_err = NULL;
+    svc->rp_is_error = 0;
+}
+
+void bitstrRpZero(bitStringService *svc, client *c) {
+    bitstrRpReset(svc);
+    svc->rp_ll = 0;
+    svc->rp_kind = 1;
+    if (c) {
+        addReply(c, shared.czero);
+        svc->rp_sent = 1;
+    }
+}
+
+void bitstrRpLong(bitStringService *svc, client *c, long long v) {
+    bitstrRpReset(svc);
+    svc->rp_ll = v;
+    svc->rp_kind = 2;
+    if (c == NULL) return;
+    if (v == 0) addReply(c, shared.czero);
+    else if (v == 1) addReply(c, shared.cone);
+    else addReplyLongLong(c, v);
+    svc->rp_sent = 1;
+}
+
+void bitstrRpObj(bitStringService *svc, client *c, robj *obj) {
+    bitstrRpReset(svc);
+    svc->rp_obj = obj;
+    svc->rp_kind = 3;
+    if (c == NULL || obj == NULL) return;
+    addReply(c, obj);
+    svc->rp_sent = 1;
+}
+
+void bitstrRpError(bitStringService *svc, client *c, const char *err) {
+    bitstrRpReset(svc);
+    svc->rp_err = err;
+    svc->rp_is_error = 1;
+    svc->rp_kind = 4;
+    if (c == NULL || err == NULL) return;
+    addReplyError(c, err);
+    svc->rp_sent = 1;
+}
+
+void bitstrRpSyntax(bitStringService *svc, client *c) {
+    bitstrRpReset(svc);
+    svc->rp_is_error = 1;
+    svc->rp_kind = 5;
+    svc->rp_obj = shared.syntaxerr;
+    if (c) {
+        addReplyErrorObject(c, shared.syntaxerr);
+        svc->rp_sent = 1;
+    }
+}
+
+void bitstrRpWrongType(bitStringService *svc, client *c) {
+    bitstrRpReset(svc);
+    svc->rp_is_error = 1;
+    svc->rp_kind = 6;
+    svc->rp_obj = shared.wrongtypeerr;
+    if (c) {
+        addReplyErrorObject(c, shared.wrongtypeerr);
+        svc->rp_sent = 1;
+    }
+}
+
+void bitstrRpMissing(bitStringService *svc, client *c, robj *reply) {
+    bitstrRpReset(svc);
+    svc->rp_obj = reply;
+    svc->rp_kind = 7;
+    if (c == NULL || reply == NULL) return;
+    addReplyOrErrorObject(c, reply);
+    svc->rp_sent = 1;
+    if (sdsEncodedObject(reply)) {
+        sds rep = reply->ptr;
+        if (sdslen(rep) > 1 && rep[0] == '-') svc->rp_is_error = 1;
+        else svc->rp_is_error = 0;
+    } else {
+        svc->rp_is_error = 0;
+    }
+}
+
+void bitstrRpBulkRange(bitStringService *svc, client *c, const char *buf, size_t len) {
+    bitstrRpReset(svc);
+    svc->rp_kind = 8;
+    svc->rp_ll = (long long) len;
+    if (c == NULL) return;
+    if (buf == NULL || len == 0) {
+        addReply(c, shared.emptybulk);
+    } else {
+        addReplyBulkCBuffer(c, (char*)buf, len);
+    }
+    svc->rp_sent = 1;
+}
+
+
+/* -------------------- BITOP combination -------------------- */
+
+void bitstrOpReset(bitStringService *svc) {
+    if (svc == NULL) return;
+    svc->op_code = BITOP_AND;
+    svc->op_numkeys = 0;
+    svc->op_maxlen = 0;
+    svc->op_minlen = 0;
+    svc->op_filled = 0;
+    svc->op_res = NULL;
+}
+
+int bitstrOpParseName(bitStringService *svc, const char *opname) {
+    if (svc == NULL || opname == NULL) return C_ERR;
+    bitstrOpReset(svc);
+    if (!strcasecmp(opname, "and")) {
+        svc->op_code = BITOP_AND;
+        return C_OK;
+    }
+    if (!strcasecmp(opname, "or")) {
+        svc->op_code = BITOP_OR;
+        return C_OK;
+    }
+    if (!strcasecmp(opname, "xor")) {
+        svc->op_code = BITOP_XOR;
+        return C_OK;
+    }
+    if (!strcasecmp(opname, "not")) {
+        svc->op_code = BITOP_NOT;
+        return C_OK;
+    }
+    return C_ERR;
+}
+
+int bitstrOpCheckArity(bitStringService *svc, int argc) {
+    if (svc == NULL) return C_ERR;
+    if (svc->op_code == BITOP_NOT && argc != 4) return C_ERR;
+    if (svc->op_code == BITOP_AND && argc < 4) return C_ERR;
+    if (svc->op_code == BITOP_OR && argc < 4) return C_ERR;
+    if (svc->op_code == BITOP_XOR && argc < 4) return C_ERR;
+    if (argc < 4) return C_ERR;
+    svc->op_numkeys = argc - 3;
+    return C_OK;
+}
+
+void bitstrOpNoteLen(bitStringService *svc, unsigned long len, unsigned long j) {
+    if (svc == NULL) return;
+    if (len > svc->op_maxlen) svc->op_maxlen = len;
+    if (j == 0 || len < svc->op_minlen) svc->op_minlen = len;
+    if (len == 0) svc->op_minlen = 0;
+    if (len > 0) svc->op_filled++;
+    if (svc->op_maxlen > 0 && svc->op_minlen > svc->op_maxlen)
+        svc->op_minlen = svc->op_maxlen;
+}
+
+unsigned char bitstrOpCombineByte(bitStringService *svc, unsigned char acc, unsigned char byte, int *skip) {
+    if (svc == NULL) {
+        if (skip) *skip = 0;
+        return acc;
+    }
+    if (svc->op_code == BITOP_AND) {
+        acc &= byte;
+        if (skip) *skip = (acc == 0);
+        return acc;
+    }
+    if (svc->op_code == BITOP_OR) {
+        acc |= byte;
+        if (skip) *skip = (acc == 0xff);
+        return acc;
+    }
+    if (svc->op_code == BITOP_XOR) {
+        acc ^= byte;
+        if (skip) *skip = 0;
+        return acc;
+    }
+    if (svc->op_code == BITOP_NOT) {
+        acc = ~acc;
+        if (skip) *skip = 0;
+        return acc;
+    }
+    if (skip) *skip = 0;
+    return acc;
+}
+
+void bitstrOpFastAnd(bitStringService *svc, unsigned long **lp, unsigned long *lres, unsigned long *minlen, unsigned long *j, unsigned long numkeys) {
+    unsigned long i;
+    if (svc == NULL || svc->op_code != BITOP_AND) return;
+    while (*minlen >= sizeof(unsigned long)*4) {
+        for (i = 1; i < numkeys; i++) {
+            lres[0] &= lp[i][0];
+            lres[1] &= lp[i][1];
+            lres[2] &= lp[i][2];
+            lres[3] &= lp[i][3];
+            lp[i] += 4;
+        }
+        lres += 4;
+        *j += sizeof(unsigned long)*4;
+        *minlen -= sizeof(unsigned long)*4;
+        svc->op_filled++;
+    }
+}
+
+void bitstrOpFastOr(bitStringService *svc, unsigned long **lp, unsigned long *lres, unsigned long *minlen, unsigned long *j, unsigned long numkeys) {
+    unsigned long i;
+    if (svc == NULL || svc->op_code != BITOP_OR) return;
+    while (*minlen >= sizeof(unsigned long)*4) {
+        for (i = 1; i < numkeys; i++) {
+            lres[0] |= lp[i][0];
+            lres[1] |= lp[i][1];
+            lres[2] |= lp[i][2];
+            lres[3] |= lp[i][3];
+            lp[i] += 4;
+        }
+        lres += 4;
+        *j += sizeof(unsigned long)*4;
+        *minlen -= sizeof(unsigned long)*4;
+        svc->op_filled++;
+    }
+}
+
+void bitstrOpFastXor(bitStringService *svc, unsigned long **lp, unsigned long *lres, unsigned long *minlen, unsigned long *j, unsigned long numkeys) {
+    unsigned long i;
+    if (svc == NULL || svc->op_code != BITOP_XOR) return;
+    while (*minlen >= sizeof(unsigned long)*4) {
+        for (i = 1; i < numkeys; i++) {
+            lres[0] ^= lp[i][0];
+            lres[1] ^= lp[i][1];
+            lres[2] ^= lp[i][2];
+            lres[3] ^= lp[i][3];
+            lp[i] += 4;
+        }
+        lres += 4;
+        *j += sizeof(unsigned long)*4;
+        *minlen -= sizeof(unsigned long)*4;
+        svc->op_filled++;
+    }
+}
+
+void bitstrOpFastNot(bitStringService *svc, unsigned long *lres, unsigned long *minlen, unsigned long *j) {
+    if (svc == NULL || svc->op_code != BITOP_NOT) return;
+    while (*minlen >= sizeof(unsigned long)*4) {
+        lres[0] = ~lres[0];
+        lres[1] = ~lres[1];
+        lres[2] = ~lres[2];
+        lres[3] = ~lres[3];
+        lres += 4;
+        *j += sizeof(unsigned long)*4;
+        *minlen -= sizeof(unsigned long)*4;
+        svc->op_filled++;
+    }
+}
+
+void bitstrOpRunBytes(bitStringService *svc, unsigned char **src, unsigned long *len, unsigned long numkeys, unsigned char *res, unsigned long maxlen, unsigned long startj) {
+    unsigned long j, i;
+    unsigned char output, byte;
+    if (svc == NULL || res == NULL) return;
+    svc->op_res = res;
+    svc->op_maxlen = maxlen;
+    for (j = startj; j < maxlen; j++) {
+        int skip = 0;
+        output = (len[0] <= j) ? 0 : src[0][j];
+        if (svc->op_code == BITOP_NOT) output = ~output;
+        for (i = 1; i < numkeys; i++) {
+            byte = (len[i] <= j) ? 0 : src[i][j];
+            output = bitstrOpCombineByte(svc, output, byte, &skip);
+            if (skip) break;
+        }
+        res[j] = output;
+        svc->op_filled = j + 1;
+    }
+}
