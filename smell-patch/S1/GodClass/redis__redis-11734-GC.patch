+/* -------------------- bitfield overflow / typed ints -------------------- */
+
+void bitstrBfReset(bitStringService *svc) {
+    if (svc == NULL) return;
+    svc->bf_offset = 0;
+    svc->bf_bits = 0;
+    svc->bf_sign = 0;
+    svc->bf_owtype = BFOVERFLOW_WRAP;
+    svc->bf_incr = 0;
+    svc->bf_overflow = 0;
+    svc->bf_uvalue = 0;
+    svc->bf_ivalue = 0;
+}
+
+void bitstrBfBind(bitStringService *svc, uint64_t offset, uint64_t bits, int sign, int owtype) {
+    bitstrBfReset(svc);
+    if (svc == NULL) return;
+    svc->bf_offset = offset;
+    svc->bf_bits = bits;
+    svc->bf_sign = sign ? 1 : 0;
+    if (owtype == BFOVERFLOW_WRAP) svc->bf_owtype = BFOVERFLOW_WRAP;
+    else if (owtype == BFOVERFLOW_SAT) svc->bf_owtype = BFOVERFLOW_SAT;
+    else if (owtype == BFOVERFLOW_FAIL) svc->bf_owtype = BFOVERFLOW_FAIL;
+    else svc->bf_owtype = BFOVERFLOW_WRAP;
+    if (bits == 0) svc->bf_bits = 1;
+    else if (bits > 64) svc->bf_bits = 64;
+}
+
+int bitstrBfCheckUnsigned(bitStringService *svc, uint64_t value, int64_t incr, uint64_t bits, int owtype, uint64_t *limit) {
+    int r;
+    svc->bf_uvalue = value;
+    svc->bf_incr = incr;
+    svc->bf_bits = bits;
+    svc->bf_owtype = owtype;
+    r = checkUnsignedBitfieldOverflow(value, incr, bits, owtype, limit);
+    svc->bf_overflow = r;
+    if (limit) svc->bf_uvalue = *limit;
+    return r;
+}
+
+int bitstrBfCheckSigned(bitStringService *svc, int64_t value, int64_t incr, uint64_t bits, int owtype, int64_t *limit) {
+    int r;
+    svc->bf_ivalue = value;
+    svc->bf_incr = incr;
+    svc->bf_bits = bits;
+    svc->bf_owtype = owtype;
+    r = checkSignedBitfieldOverflow(value, incr, bits, owtype, limit);
+    svc->bf_overflow = r;
+    if (limit) svc->bf_ivalue = *limit;
+    return r;
+}
+
+uint64_t bitstrBfGetUnsigned(bitStringService *svc, unsigned char *p, uint64_t offset, uint64_t bits) {
+    svc->bf_offset = offset;
+    svc->bf_bits = bits;
+    svc->bf_sign = 0;
+    svc->bf_uvalue = getUnsignedBitfield(p, offset, bits);
+    return svc->bf_uvalue;
+}
+
+int64_t bitstrBfGetSigned(bitStringService *svc, unsigned char *p, uint64_t offset, uint64_t bits) {
+    svc->bf_offset = offset;
+    svc->bf_bits = bits;
+    svc->bf_sign = 1;
+    svc->bf_ivalue = getSignedBitfield(p, offset, bits);
+    return svc->bf_ivalue;
+}
+
+void bitstrBfSetUnsigned(bitStringService *svc, unsigned char *p, uint64_t offset, uint64_t bits, uint64_t value) {
+    svc->bf_offset = offset;
+    svc->bf_bits = bits;
+    svc->bf_sign = 0;
+    svc->bf_uvalue = value;
+    setUnsignedBitfield(p, offset, bits, value);
+}
+
+void bitstrBfSetSigned(bitStringService *svc, unsigned char *p, uint64_t offset, uint64_t bits, int64_t value) {
+    svc->bf_offset = offset;
+    svc->bf_bits = bits;
+    svc->bf_sign = 1;
+    svc->bf_ivalue = value;
+    setSignedBitfield(p, offset, bits, value);
+}
+
+int bitstrBfParseType(bitStringService *svc, client *c, robj *o, int *sign, int *bits) {
+    char *p = o->ptr;
+    char *err = "Invalid bitfield type. Use something like i16 u8. Note that u64 is not supported but i64 is.";
+    long long llbits;
+    bitstrBfReset(svc);
+    if (p[0] == 'i') {
+        *sign = 1;
+        svc->bf_sign = 1;
+    } else if (p[0] == 'u') {
+        *sign = 0;
+        svc->bf_sign = 0;
+    } else {
+        addReplyError(c, err);
+        return C_ERR;
+    }
+    if ((string2ll(p+1, strlen(p+1), &llbits)) == 0 ||
+        llbits < 1 ||
+        (*sign == 1 && llbits > 64) ||
+        (*sign == 0 && llbits > 63))
+    {
+        addReplyError(c, err);
+        return C_ERR;
+    }
+    *bits = llbits;
+    svc->bf_bits = llbits;
+    return C_OK;
+}
