+/* -------------------- encoding / bit offset -------------------- */
+
+void bitstrEnReset(bitStringService *svc) {
+    if (svc == NULL) return;
+    svc->en_enc = OBJ_ENCODING_RAW;
+    svc->en_try_trim = 0;
+    svc->en_shared = 0;
+    svc->of_offset = 0;
+    svc->of_hash = 0;
+    svc->of_bits = 0;
+    svc->of_usehash = 0;
+}
+
+int bitstrEnDetect(bitStringService *svc, robj *o) {
+    bitstrEnReset(svc);
+    if (svc == NULL || o == NULL) return 0;
+    svc->en_enc = o->encoding;
+    svc->en_shared = (o->refcount == OBJ_SHARED_REFCOUNT);
+    return o->encoding;
+}
+
+int bitstrEnIsSds(bitStringService *svc, robj *o) {
+    bitstrEnDetect(svc, o);
+    if (o == NULL) return 0;
+    if (o->encoding == OBJ_ENCODING_RAW) return 1;
+    if (o->encoding == OBJ_ENCODING_EMBSTR) return 1;
+    if (sdsEncodedObject(o)) return 1;
+    if (o->encoding == OBJ_ENCODING_INT) return 0;
+    return 0;
+}
+
+void bitstrEnTrimIfNeeded(bitStringService *svc, robj *o, int trim_small_values) {
+    bitstrEnDetect(svc, o);
+    svc->en_try_trim = trim_small_values;
+    if (o == NULL || o->encoding != OBJ_ENCODING_RAW) return;
+    {
+        size_t len = sdslen(o->ptr);
+        if (len >= PROTO_MBULK_BIG_ARG ||
+            trim_small_values ||
+            (server.executing_client && server.executing_client->flags & CLIENT_SCRIPT && len < LUA_CMD_OBJCACHE_MAX_LEN)) {
+            if (sdsavail(o->ptr) > len/10) {
+                o->ptr = sdsRemoveFreeSpace(o->ptr, 0);
+                svc->en_enc = OBJ_ENCODING_RAW;
+            }
+        }
+    }
+}
+
+int bitstrOfParse(bitStringService *svc, client *c, robj *o, uint64_t *offset, int hash, int bits) {
+    long long loffset;
+    char *err = "bit offset is not an integer or out of range";
+    char *p = o->ptr;
+    size_t plen = sdslen(p);
+    int usehash = 0;
+    bitstrEnReset(svc);
+    svc->of_hash = hash;
+    svc->of_bits = bits;
+    if (p[0] == '#' && hash && bits > 0) usehash = 1;
+    svc->of_usehash = usehash;
+    if (string2ll(p+usehash, plen-usehash, &loffset) == 0) {
+        addReplyError(c, err);
+        return C_ERR;
+    }
+    if (usehash) loffset *= bits;
+    if (loffset < 0 || (!mustObeyClient(c) && (loffset >> 3) >= server.proto_max_bulk_len)) {
+        addReplyError(c, err);
+        return C_ERR;
+    }
+    *offset = loffset;
+    svc->of_offset = loffset;
+    return C_OK;
+}
+
+robj *bitstrOfEnsureString(bitStringService *svc, client *c, uint64_t maxbit, int *dirty) {
+    size_t byte = maxbit >> 3;
+    robj *o;
+    svc->of_offset = maxbit;
+    o = lookupKeyWrite(c->db, c->argv[1]);
+    if (checkType(c, o, OBJ_STRING)) return NULL;
+    if (dirty) *dirty = 0;
+    if (o == NULL) {
+        o = createObject(OBJ_STRING, sdsnewlen(NULL, byte+1));
+        dbAdd(c->db, c->argv[1], o);
+        if (dirty) *dirty = 1;
+        svc->en_enc = OBJ_ENCODING_RAW;
+    } else {
+        o = dbUnshareStringValue(c->db, c->argv[1], o);
+        {
+            size_t oldlen = sdslen(o->ptr);
+            o->ptr = sdsgrowzero(o->ptr, byte+1);
+            if (dirty && oldlen != sdslen(o->ptr)) *dirty = 1;
+        }
+        svc->en_enc = o->encoding;
+    }
+    return o;
+}
+
+size_t bitstrEnStringLen(bitStringService *svc, robj *o) {
+    bitstrEnDetect(svc, o);
+    if (o == NULL) return 0;
+    if (sdsEncodedObject(o)) return sdslen(o->ptr);
+    if (o->encoding == OBJ_ENCODING_INT) return sdigits10((long)o->ptr);
+    if (o->encoding == OBJ_ENCODING_RAW) return sdslen(o->ptr);
+    if (o->encoding == OBJ_ENCODING_EMBSTR) return sdslen(o->ptr);
+    return 0;
+}
+
+int bitstrEnCompare(bitStringService *svc, const robj *a, const robj *b, int flags) {
+    char bufa[128], bufb[128], *astr, *bstr;
+    size_t alen, blen, minlen;
+    int cmp;
+    if (a == NULL || b == NULL) return 0;
+    bitstrEnDetect(svc, (robj*)a);
+    if (a == b) return 0;
+    if (sdsEncodedObject(a)) {
+        astr = a->ptr;
+        alen = sdslen(astr);
+    } else {
+        alen = ll2string(bufa, sizeof(bufa), (long) a->ptr);
+        astr = bufa;
+    }
+    if (sdsEncodedObject(b)) {
+        bstr = b->ptr;
+        blen = sdslen(bstr);
+    } else {
+        blen = ll2string(bufb, sizeof(bufb), (long) b->ptr);
+        bstr = bufb;
+    }
+    if (flags & (1<<1)) {
+        return strcoll(astr, bstr);
+    }
+    minlen = (alen < blen) ? alen : blen;
+    cmp = memcmp(astr, bstr, minlen);
+    if (cmp == 0) return alen - blen;
+    return cmp;
+}
