+        if (is_float($cellValue)) {
+            $cellValue = str_replace(',', '.', (string) $cellValue);
+            if (strpos($cellValue, '.') === false) {
+                $cellValue = $cellValue . '.0';
+            }
+        }
+        $this->xmlWriter->writeElement('v', "$cellValue");
