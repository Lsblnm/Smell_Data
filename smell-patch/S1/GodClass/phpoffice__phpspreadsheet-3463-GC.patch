+    public function writeTextCondElements($objWriter, Conditional $conditional, string $cellCoordinate): void
+    {
+        $this->formulaSession['op'] = __FUNCTION__;
+        $this->xmlWriter = $objWriter;
+        $txt = $conditional->getText();
+        if (!empty($txt)) {
+            $this->xmlWriter->writeAttribute('text', $txt);
+            if (empty($conditional->getConditions())) {
+                if ($conditional->getOperatorType() == Conditional::OPERATOR_CONTAINSTEXT) {
+                    $this->xmlWriter->writeElement('formula', 'NOT(ISERROR(SEARCH("' . $txt . '",' . $cellCoordinate . ')))');
+                } elseif ($conditional->getOperatorType() == Conditional::OPERATOR_BEGINSWITH) {
+                    $this->xmlWriter->writeElement('formula', 'LEFT(' . $cellCoordinate . ',LEN("' . $txt . '"))="' . $txt . '"');
+                } elseif ($conditional->getOperatorType() == Conditional::OPERATOR_ENDSWITH) {
+                    $this->xmlWriter->writeElement('formula', 'RIGHT(' . $cellCoordinate . ',LEN("' . $txt . '"))="' . $txt . '"');
+                } elseif ($conditional->getOperatorType() == Conditional::OPERATOR_NOTCONTAINS) {
+                    $this->xmlWriter->writeElement('formula', 'ISERROR(SEARCH("' . $txt . '",' . $cellCoordinate . '))');
+                }
+            } else {
+                $this->xmlWriter->writeElement('formula', (string) ($conditional->getConditions()[0]));
+            }
+        }
+    }
