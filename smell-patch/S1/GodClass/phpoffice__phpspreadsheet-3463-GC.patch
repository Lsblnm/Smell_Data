+    public function writeCellError($objWriter, string $mappedType, string $cellValue, string $formulaerr = '#NULL!'): void
+    {
+        $this->formulaSession['op'] = __FUNCTION__;
+        $this->xmlWriter = $objWriter;
+        $this->xmlWriter->writeAttribute('t', $mappedType);
+        $cellIsFormula = substr($cellValue, 0, 1) === '=';
+        if ($cellIsFormula) {
+            $this->xmlWriter->writeElement('f', self::addFunctionPrefixStripEquals($cellValue));
+        }
+        $this->xmlWriter->writeElement('v', $cellIsFormula ? $formulaerr : $cellValue);
+    }
+
+    public function writeCellFormula($objWriter, string $cellValue, Cell $cell, $parentWriter): void
+    {
+        $this->formulaSession['op'] = __FUNCTION__;
+        $this->xmlWriter = $objWriter;
+        $this->parentWriter = $parentWriter;
+        $calculatedValue = $this->parentWriter->getPreCalculateFormulas() ? $cell->getCalculatedValue() : $cellValue;
+        if (is_string($calculatedValue)) {
+            if (ErrorValue::isError($calculatedValue)) {
+                $this->writeCellError($this->xmlWriter, 'e', $cellValue, $calculatedValue);
+
+                return;
+            }
+            $this->xmlWriter->writeAttribute('t', 'str');
+            $calculatedValue = StringHelper::controlCharacterPHP2OOXML($calculatedValue);
+        } elseif (is_bool($calculatedValue)) {
+            $this->xmlWriter->writeAttribute('t', 'b');
+            $calculatedValue = (int) $calculatedValue;
+        }
+
+        $attributes = $cell->getFormulaAttributes();
+        $prefixed = self::addFunctionPrefixStripEquals($cellValue);
+        $this->formulaSession['prefixed'] = $prefixed;
+        if (($attributes['t'] ?? null) === 'array') {
+            $this->xmlWriter->startElement('f');
+            $this->xmlWriter->writeAttribute('t', 'array');
+            $this->xmlWriter->writeAttribute('ref', $cell->getCoordinate());
+            $this->xmlWriter->writeAttribute('aca', '1');
+            $this->xmlWriter->writeAttribute('ca', '1');
+            $this->xmlWriter->text($this->formulaSession['prefixed']);
+            $this->xmlWriter->endElement();
+        } else {
+            $this->xmlWriter->writeElement('f', $this->formulaSession['prefixed']);
+            if ($this->parentWriter->getOffice2003Compatibility() === false) {
+                $this->xmlWriter->writeElement(
+                    'v',
+                    ($this->parentWriter->getPreCalculateFormulas() && !is_array($calculatedValue) && substr($calculatedValue ?? '', 0, 1) !== '#')
+                        ? StringHelper::formatNumber($calculatedValue) : '0'
+                );
+            }
+        }
+    }
+
+    public function writeCell($objWriter, $worksheet, string $cellAddress, array $flippedStringTable, $parentWriter): void
+    {
+        $this->formulaSession['op'] = __FUNCTION__;
+        $this->xmlWriter = $objWriter;
+        $this->parentWriter = $parentWriter;
+        $pCell = $worksheet->getCell($cellAddress);
+        $this->xmlWriter->startElement('c');
+        $this->xmlWriter->writeAttribute('r', $cellAddress);
+
+        $xfi = $pCell->getXfIndex();
+        if ($xfi) {
+            $this->xmlWriter->writeAttribute('s', "$xfi");
+        }
+
+        $cellValue = $pCell->getValue();
+        if (is_object($cellValue) || $cellValue !== '') {
+            $mappedType = $pCell->getDataType();
+            switch (strtolower($mappedType)) {
+                case 'inlinestr':
+                    $this->writeCellInlineStr($this->xmlWriter, $mappedType, $cellValue, $this->parentWriter);
+                    break;
+                case 's':
+                    $this->writeCellString($this->xmlWriter, $mappedType, $cellValue, $flippedStringTable);
+                    break;
+                case 'f':
+                    $this->writeCellFormula($this->xmlWriter, $cellValue, $pCell, $this->parentWriter);
+                    break;
+                case 'n':
+                    $this->writeCellNumeric($this->xmlWriter, $cellValue);
+                    break;
+                case 'b':
+                    $this->writeCellBoolean($this->xmlWriter, $mappedType, $cellValue);
+                    break;
+                case 'e':
+                    $this->writeCellError($this->xmlWriter, $mappedType, $cellValue);
+            }
+        }
+
+        $this->xmlWriter->endElement();
+    }
+
+    public function writeDefinedNamesDocument($objWriter, Spreadsheet $spreadsheet): void
+    {
+        $this->formulaSession['op'] = __FUNCTION__;
+        $this->xmlWriter = $objWriter;
+        $this->spreadsheet = $spreadsheet;
+        $this->xmlWriter->startElement('definedNames');
+
+        if (count($this->spreadsheet->getDefinedNames()) > 0) {
+            $this->writeNamedRangesAndFormulae();
+        }
+
+        $sheetCount = $this->spreadsheet->getSheetCount();
+        for ($i = 0; $i < $sheetCount; ++$i) {
+            $this->writeNamedRangeForAutofilter($this->spreadsheet->getSheet($i), $i);
+            $this->writeNamedRangeForPrintTitles($this->spreadsheet->getSheet($i), $i);
+            $this->writeNamedRangeForPrintArea($this->spreadsheet->getSheet($i), $i);
+        }
+
+        $this->xmlWriter->endElement();
+    }
+
+    private function writeNamedRangesAndFormulae(): void
+    {
+        $this->formulaSession['op'] = __FUNCTION__;
+        $definedNames = $this->spreadsheet->getDefinedNames();
+        foreach ($definedNames as $definedName) {
+            $this->writeDefinedName($definedName);
+        }
+    }
+
+    private function writeDefinedName(DefinedName $definedName): void
+    {
+        $this->formulaSession['op'] = __FUNCTION__;
+        $local = -1;
+        if ($definedName->getLocalOnly() && $definedName->getScope() !== null) {
+            try {
+                $local = $definedName->getScope()->getParentOrThrow()->getIndex($definedName->getScope());
+            } catch (Exception $e) {
+                return;
+            }
+        }
+        $this->xmlWriter->startElement('definedName');
+        $this->xmlWriter->writeAttribute('name', $definedName->getName());
+        if ($local >= 0) {
+            $this->xmlWriter->writeAttribute('localSheetId', "$local");
+        }
+
+        $definedRange = $this->getDefinedRange($definedName);
+        $this->formulaSession['definedRange'] = $definedRange;
+        $this->inspectFormulaStructure($definedRange);
+        $this->xmlWriter->writeRawData($this->formulaSession['definedRange']);
+        $this->xmlWriter->endElement();
+    }
+
+    private function writeNamedRangeForAutofilter($worksheet, int $worksheetId = 0): void
+    {
+        $this->formulaSession['op'] = __FUNCTION__;
+        $autoFilterRange = $worksheet->getAutoFilter()->getRange();
+        if (!empty($autoFilterRange)) {
+            $this->xmlWriter->startElement('definedName');
+            $this->xmlWriter->writeAttribute('name', '_xlnm._FilterDatabase');
+            $this->xmlWriter->writeAttribute('localSheetId', "$worksheetId");
+            $this->xmlWriter->writeAttribute('hidden', '1');
+
+            $range = Coordinate::splitRange($autoFilterRange);
+            $range = $range[0];
+            [, $range[0]] = PhpspreadsheetWorksheet::extractSheetTitle($range[0], true);
+
+            $range[0] = Coordinate::absoluteCoordinate($range[0]);
+            if (count($range) > 1) {
+                $range[1] = Coordinate::absoluteCoordinate($range[1]);
+            }
+            $range = implode(':', $range);
+
+            $this->xmlWriter->writeRawData('\'' . str_replace("'", "''", $worksheet->getTitle()) . '\'!' . $range);
+            $this->xmlWriter->endElement();
+        }
+    }
+
+    private function writeNamedRangeForPrintTitles($worksheet, int $worksheetId = 0): void
+    {
+        $this->formulaSession['op'] = __FUNCTION__;
+        if ($worksheet->getPageSetup()->isColumnsToRepeatAtLeftSet() || $worksheet->getPageSetup()->isRowsToRepeatAtTopSet()) {
+            $this->xmlWriter->startElement('definedName');
+            $this->xmlWriter->writeAttribute('name', '_xlnm.Print_Titles');
+            $this->xmlWriter->writeAttribute('localSheetId', "$worksheetId");
+
+            $settingString = '';
+            if ($worksheet->getPageSetup()->isColumnsToRepeatAtLeftSet()) {
+                $repeat = $worksheet->getPageSetup()->getColumnsToRepeatAtLeft();
+                $settingString .= '\'' . str_replace("'", "''", $worksheet->getTitle()) . '\'!$' . $repeat[0] . ':$' . $repeat[1];
+            }
+            if ($worksheet->getPageSetup()->isRowsToRepeatAtTopSet()) {
+                if ($worksheet->getPageSetup()->isColumnsToRepeatAtLeftSet()) {
+                    $settingString .= ',';
+                }
+                $repeat = $worksheet->getPageSetup()->getRowsToRepeatAtTop();
+                $settingString .= '\'' . str_replace("'", "''", $worksheet->getTitle()) . '\'!$' . $repeat[0] . ':$' . $repeat[1];
+            }
+
+            $this->formulaSession['printTitles'] = $settingString;
+            $this->xmlWriter->writeRawData($settingString);
+            $this->xmlWriter->endElement();
+        }
+    }
+
+    private function writeNamedRangeForPrintArea($worksheet, int $worksheetId = 0): void
+    {
+        $this->formulaSession['op'] = __FUNCTION__;
+        if ($worksheet->getPageSetup()->isPrintAreaSet()) {
+            $this->xmlWriter->startElement('definedName');
+            $this->xmlWriter->writeAttribute('name', '_xlnm.Print_Area');
+            $this->xmlWriter->writeAttribute('localSheetId', "$worksheetId");
+
+            $printArea = Coordinate::splitRange($worksheet->getPageSetup()->getPrintArea());
+            $chunks = [];
+            foreach ($printArea as $printAreaRect) {
+                $printAreaRect[0] = Coordinate::absoluteReference($printAreaRect[0]);
+                $printAreaRect[1] = Coordinate::absoluteReference($printAreaRect[1]);
+                $chunks[] = '\'' . str_replace("'", "''", $worksheet->getTitle()) . '\'!' . implode(':', $printAreaRect);
+            }
+
+            $this->formulaSession['printArea'] = implode(',', $chunks);
+            $this->xmlWriter->writeRawData(implode(',', $chunks));
+            $this->xmlWriter->endElement();
+        }
+    }
+
+    private function getDefinedRange(DefinedName $definedName): string
+    {
+        $this->formulaSession['op'] = __FUNCTION__;
+        $definedRange = $definedName->getValue();
+        $splitCount = preg_match_all(
+            '/' . Calculation::CALCULATION_REGEXP_CELLREF_RELATIVE . '/mui',
+            $definedRange,
+            $splitRanges,
+            PREG_OFFSET_CAPTURE
+        );
+
+        $lengths = array_map('strlen', array_column($splitRanges[0], 0));
+        $offsets = array_column($splitRanges[0], 1);
+
+        $worksheets = $splitRanges[2];
+        $columns = $splitRanges[6];
+        $rows = $splitRanges[7];
+
+        while ($splitCount > 0) {
+            --$splitCount;
+            $length = $lengths[$splitCount];
+            $offset = $offsets[$splitCount];
+            $worksheet = $worksheets[$splitCount][0];
+            $column = $columns[$splitCount][0];
+            $row = $rows[$splitCount][0];
+
+            $newRange = '';
+            if (empty($worksheet)) {
+                if (($offset === 0) || ($definedRange[$offset - 1] !== ':')) {
+                    $ws = $definedName->getWorksheet();
+                    $worksheet = ($ws === null) ? null : $ws->getTitle();
+                }
+            } else {
+                $worksheet = str_replace("''", "'", trim($worksheet, "'"));
+            }
+
+            if (!empty($worksheet)) {
+                $newRange = "'" . str_replace("'", "''", $worksheet) . "'!";
+            }
+            $newRange = "{$newRange}{$column}{$row}";
+
+            $definedRange = substr($definedRange, 0, $offset) . $newRange . substr($definedRange, $offset + $length);
+        }
+
+        if (substr($definedRange, 0, 1) === '=') {
+            $definedRange = substr($definedRange, 1);
+        }
+
+        $this->formulaSession['definedRange'] = $definedRange;
+
+        return $definedRange;
+    }
 }
