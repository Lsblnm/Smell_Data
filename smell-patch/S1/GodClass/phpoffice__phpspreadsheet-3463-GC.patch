+    public function writeCellInlineStr($objWriter, string $mappedType, $cellValue, $parentWriter): void
+    {
+        $this->formulaSession['op'] = __FUNCTION__;
+        $this->xmlWriter = $objWriter;
+        $this->parentWriter = $parentWriter;
+        $this->xmlWriter->writeAttribute('t', $mappedType);
+        if (!$cellValue instanceof RichText) {
+            $this->xmlWriter->startElement('is');
+            $this->xmlWriter->writeElement(
+                't',
+                StringHelper::controlCharacterPHP2OOXML(htmlspecialchars($cellValue, Settings::htmlEntityFlags()))
+            );
+            $this->xmlWriter->endElement();
+        } else {
+            $this->xmlWriter->startElement('is');
+            $this->parentWriter->getWriterPartstringtable()->writeRichText($this->xmlWriter, $cellValue);
+            $this->xmlWriter->endElement();
+        }
+    }
