+    public function writeCellString($objWriter, string $mappedType, $cellValue, array $flippedStringTable): void
+    {
+        $this->formulaSession['op'] = __FUNCTION__;
+        $this->xmlWriter = $objWriter;
+        $this->xmlWriter->writeAttribute('t', $mappedType);
+        if (!$cellValue instanceof RichText) {
+            if (isset($flippedStringTable[$cellValue])) {
+                $this->xmlWriter->writeElement('v', $flippedStringTable[$cellValue] ?? '');
+            }
+        } else {
+            $this->xmlWriter->writeElement('v', $flippedStringTable[$cellValue->getHashCode()]);
+        }
+    }
