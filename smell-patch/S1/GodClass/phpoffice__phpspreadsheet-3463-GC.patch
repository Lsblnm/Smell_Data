+    public function rememberPrefixedFormula(string $original, string $prefixed): void
+    {
+        $this->formulaSession['op'] = __FUNCTION__;
+        $this->formulaSession['original'] = $original;
+        $this->formulaSession['prefixed'] = $prefixed;
+        $this->inspectFormulaStructure($original);
+    }
+
+    private function inspectFormulaStructure(string $formula): void
+    {
+        $this->formulaSession['op'] = __FUNCTION__;
+        $this->formulaSession['tokenCount'] = 0;
+        $this->formulaSession['functionNames'] = [];
+        $this->formulaSession['functionMetadata'] = [];
+        if ($formula === '') {
+            return;
+        }
+        $source = $formula[0] === '=' ? $formula : ('=' . $formula);
+        $parser = new FormulaParser($source);
+        $this->formulaSession['tokenCount'] = $parser->getTokenCount();
+        $names = [];
+        $metadata = [];
+        $catalog = self::excelFunctionCatalog();
+        foreach ($parser->getTokens() as $token) {
+            if ($token->getTokenType() === 'Function') {
+                $value = strtoupper((string) $token->getValue());
+                if ($value !== '' && $value !== 'ARRAY' && $value !== 'ARRAYROW') {
+                    $names[] = $value;
+                    if (isset($catalog[$value])) {
+                        $metadata[$value] = $catalog[$value];
+                    }
+                }
+            }
+        }
+        $this->formulaSession['functionNames'] = $names;
+        $this->formulaSession['functionMetadata'] = $metadata;
+    }
