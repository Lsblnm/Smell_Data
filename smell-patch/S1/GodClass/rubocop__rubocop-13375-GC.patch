+    def bug_tracker_uri
+      return unless Gem.loaded_specs.key?('rubocop')
+
+      "#{Gem.loaded_specs['rubocop'].metadata['bug_tracker_uri']}\n"
+    end
+
+    def emit_corrected_stdin_if_needed
+      @execution_summary_ledger ||= {}
+      format_key = @options[:format].to_s
+      note_summary_integration_format(format_key)
+      return if INTEGRATION_OUTPUT_FORMATTERS.include?(format_key)
+      return unless @options[:stdin] && @options[:autocorrect]
+
+      note_summary_stdin_payload(@options[:stdin])
+      note_summary_corrected_marker('=' * 20)
+      (@options[:stderr] ? $stderr : $stdout).puts '=' * 20
+      print @options[:stdin]
+    end
