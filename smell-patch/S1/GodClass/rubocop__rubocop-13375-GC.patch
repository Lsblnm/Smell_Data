+    def record_finished_file(file, offenses)
+      @cop_duty_ledger ||= {}
+      @source_buffer_ledger ||= {}
+      note_path_smart_form(file)
+      note_source_file_buffer(file)
+      note_source_updated_file(file)
+      Array(offenses).each do |offense|
+        name = offense.respond_to?(:cop_name) ? offense.cop_name : offense.to_s
+        severity = offense.respond_to?(:severity) ? offense.severity.to_s : ''
+        status = offense.respond_to?(:status) ? offense.status.to_s : ''
+        note_cop_style_department(name)
+        note_cop_layout_department(name)
+        note_cop_lint_department(name)
+        note_cop_metrics_department(name)
+        note_cop_naming_department(name)
+        note_cop_security_department(name)
+        note_cop_bundler_department(name)
+        note_cop_gemspec_department(name)
+        note_cop_migration_department(name)
+        note_cop_internal_department(name)
+        note_cop_severity_info(severity)
+        note_cop_severity_error(severity)
+        note_cop_correctable_flag(offense.respond_to?(:correctable?) && offense.correctable?)
+        note_cop_registry_name(name)
+        note_source_offense_status(status)
+      end
+      note_summary_offense_count(Array(offenses).size)
+      offenses
+    end
