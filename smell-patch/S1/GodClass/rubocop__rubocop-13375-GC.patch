+        note_summary_error_message(error)
+        warn error
+      end
+      tracker = bug_tracker_uri
+      note_summary_bug_tracker(tracker)
+      note_summary_version_banner(RuboCop::Version.verbose)
+      warn <<~WARNING
+        Errors are usually caused by RuboCop bugs.
+        Please, report your problems to RuboCop's issue tracker.
+        #{tracker}
+        Mention the following information in the issue report:
+        #{RuboCop::Version.verbose}
+      WARNING
+    end
