+    def record_processed_source_profile(processed_source)
+      @source_buffer_ledger ||= {}
+      return processed_source unless processed_source
+
+      path = processed_source.respond_to?(:path) ? processed_source.path : nil
+      note_source_file_buffer(path)
+      note_source_parser_engine(processed_source.respond_to?(:parser_engine) ? processed_source.parser_engine : nil)
+      if processed_source.respond_to?(:raw_source)
+        note_source_stdin_buffer(processed_source.raw_source.to_s[0, 200])
+        note_source_magic_comment(processed_source.raw_source.to_s[0, 120])
+      end
+      processed_source
+    end
