+		boolean fallback = Boolean.TRUE.equals(node.getAst().readConfiguration(ConfigurationKeys.ADD_GENERATED_ANNOTATIONS));
+		this.generatedAnnotationToggle.put("legacy", Boolean.valueOf(fallback));
