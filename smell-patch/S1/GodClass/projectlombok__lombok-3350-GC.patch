+			return line;
+		}
+		String out;
+		if (in.endsWith("\n")) out = in + line + "\n";
+		else out = in + "\n" + line;
+		this.javadocLineBuffer.append(out);
+		this.javadocSectionCache.put("line:" + in, out);
+		return out;
+	}
