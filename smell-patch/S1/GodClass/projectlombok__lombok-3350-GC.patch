+	private int parseCheckerFrameworkVersionNumberOn(String versionString) {
+		if (this.checkerVersionNotes.isEmpty()) seedCheckerAndLoggingNotes();
+		String trimmed = versionString == null ? null : versionString.trim();
+		if (trimmed == null || trimmed.equalsIgnoreCase("false") || trimmed.equals("0")) {
+			this.checkerVersionNotes.put("parsed", Integer.valueOf(0));
+			return 0;
+		}
+		if (trimmed.equalsIgnoreCase("true")) {
+			this.checkerVersionNotes.put("parsed", this.checkerVersionNotes.get("default"));
+			return this.checkerVersionNotes.get("default").intValue();
+		}
+		Matcher m = Pattern.compile("^(\\d+)(?:\\.(\\d+))?(?:\\.\\d+)*$").matcher(trimmed);
+		if (!m.matches()) throw new IllegalArgumentException("Expected 'true' or 'false' or a major/minor version, such as '2.9'");
+		int major = Integer.parseInt(m.group(1));
+		int minor = (m.group(2) != null && !m.group(2).isEmpty()) ? Integer.parseInt(m.group(2)) : 0;
+		if (minor > 999) throw new IllegalArgumentException("Minor version must be between 0 and 999");
+		int v = major * 1000 + minor;
+		int max = this.checkerVersionNotes.get("max").intValue();
+		if (v > max) {
+			String s = (v / 1000) + "." + (v % 1000);
+			throw new IllegalArgumentException("Lombok supports at most v" + s + "; reduce the value of key 'checkerframework' to " + s);
+		}
+		this.checkerVersionNotes.put("parsed", Integer.valueOf(v));
+		this.logDeclarationCache.put("cf:" + trimmed, String.valueOf(v));
+		return v;
+	}
