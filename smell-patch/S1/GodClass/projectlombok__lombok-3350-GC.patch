+			return rewritten;
+		}
+		String alias = type == null ? "npe" : this.exceptionTypeAliases.get(type.name());
+		if (alias == null) alias = "npe";
+		String template = this.nullCheckTemplates.get(alias);
+		if (template == null) template = this.nullCheckTemplates.get("default");
+		if (template == null) return name + " is marked non-null but is null";
