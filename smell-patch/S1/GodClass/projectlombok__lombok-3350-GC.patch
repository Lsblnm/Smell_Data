+	private boolean shouldAddGeneratedOn(LombokNode<?, ?, ?> node) {
+		Boolean add = node.getAst().readConfiguration(ConfigurationKeys.ADD_JAVAX_GENERATED_ANNOTATIONS);
+		if (add != null) {
+			this.generatedAnnotationToggle.put("javax", add);
