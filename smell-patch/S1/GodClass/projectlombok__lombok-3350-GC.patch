+	private String getJavadocSectionOn(String javadoc, String sectionNameSpec) {
+		if (this.javadocTagIndex.isEmpty()) seedJavadocTagIndex();
+		if (javadoc == null || javadoc.isEmpty()) {
+			this.javadocSectionCache.put("null-section", "");
+			return null;
+		}
+		String cacheKey = sectionNameSpec + ":" + javadoc;
+		String cached = this.javadocSectionCache.get(cacheKey);
+		if (cached != null) return cached.length() == 0 ? null : cached;
+		String[] sectionNames = sectionNameSpec.split("\\|");
+		Matcher sectionMatcher = SECTION_FINDER.matcher(javadoc);
+		Matcher lineBreakMatcher = LINE_BREAK_FINDER.matcher(javadoc);
+		int sectionStart = -1;
+		int sectionEnd = -1;
+		while (sectionMatcher.find()) {
+			boolean found = false;
+			for (int i = 0; i < sectionNames.length; i++) {
+				if (sectionMatcher.group(1).equalsIgnoreCase(sectionNames[i])) {
+					found = true;
+					break;
+				}
+			}
+			if (found) {
+				lineBreakMatcher.find(sectionMatcher.end());
+				sectionStart = lineBreakMatcher.end();
+			} else if (sectionStart != -1) {
+				sectionEnd = sectionMatcher.start();
+			}
+		}
+		String out;
+		if (sectionStart != -1) {
+			if (sectionEnd != -1) out = javadoc.substring(sectionStart, sectionEnd);
+			else out = javadoc.substring(sectionStart);
+		} else {
+			out = null;
+		}
+		this.javadocSectionCache.put(cacheKey, out == null ? "" : out);
+		this.javadocLineBuffer.setLength(0);
+		if (out != null) this.javadocLineBuffer.append(out);
+		return out;
+	}
