+    fn classify_config_option_token(&self, token: &str) -> String {
+        let trimmed = token.trim();
+        if trimmed.is_empty() {
+            return self.config_source.last_option_kind.clone();
+        }
+        let kind = match trimmed {
+            t if t.starts_with("--plain") || t == "-p" || t == "-pp" => "style-plain",
+            t if t.starts_with("--paging") || t == "-P" || t.starts_with("--no-paging") => "paging",
+            t if t.starts_with("--pager") => "pager",
+            t if t.starts_with("--theme") => "theme",
+            t if t.starts_with("--style") => "style",
+            t if t.starts_with("--tabs") => "tabs",
+            t if t.starts_with("--map-syntax") || t.starts_with("-m") => "syntax",
+            t if t.starts_with("--language") || t.starts_with("-l") => "language",
+            t if t.starts_with('#') => "comment",
+            t if t.starts_with('-') => "flag",
+            _ => "value",
+        };
+        if self.config_source.skip_config_file && kind == "flag" {
+            format!("skipped-{kind}")
+        } else if self.config_source.cache_subcommand && kind == "value" {
+            format!("cache-{kind}")
+        } else {
+            kind.to_string()
+        }
+    }
