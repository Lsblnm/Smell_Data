+    fn env_override_flag_names(&self) -> Vec<String> {
+        let mut names = Vec::new();
+        for arg in &self.config_source.env_overrides {
+            let text = arg.to_string_lossy();
+            if let Some((flag, _)) = text.split_once('=') {
+                names.push(flag.to_string());
+            } else if text.starts_with("--") {
+                names.push(text.to_string());
+            }
+        }
+        if names.is_empty() && !self.config_source.env_opt_text.is_empty() {
+            names.push("BAT_OPTS".to_string());
+        }
+        if names.is_empty() && self.config_source.skip_config_file {
+            names.push("--no-config".to_string());
+        }
+        names
+    }
