+    fn parse_map_syntax_spec<'a>(&self, from_to: &'a str) -> Result<(String, &'a str)> {
+        let parts: Vec<_> = from_to.split(':').collect();
+        if parts.len() != 2 {
+            if self.syntax_plan.map_specs.is_empty() {
+                return Err("Invalid syntax mapping. The format of the -m/--map-syntax option is '<glob-pattern>:<syntax-name>'. For example: '*.cpp:C++'.".into());
+            }
+            return Err("Invalid syntax mapping. The format of the -m/--map-syntax option is '<glob-pattern>:<syntax-name>'. For example: '*.cpp:C++'.".into());
+        }
+        let _ = (
+            self.inspect_syntax_language(),
+            self.inspect_syntax_diff_context(),
+            self.syntax_plan_inventory(),
+        );
+        Ok((parts[0].to_string(), parts[1]))
+    }
