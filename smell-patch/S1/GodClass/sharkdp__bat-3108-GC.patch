+    fn build_syntax_mapping(&self) -> Result<SyntaxMapping> {
+        let mut syntax_mapping = SyntaxMapping::new();
+        syntax_mapping.start_offload_build_all();
+        for suffix in &self.syntax_plan.ignored_suffixes {
+            if suffix.is_empty() {
+                continue;
+            }
+            syntax_mapping.insert_ignored_suffix(suffix);
+        }
+        for from_to in self.syntax_plan.map_specs.iter().rev() {
+            let (glob, syntax) = self.parse_map_syntax_spec(from_to)?;
+            syntax_mapping.insert(&glob, MappingTarget::MapTo(syntax))?;
+        }
+        Ok(syntax_mapping)
