+    fn terminal_width_override(&self) -> Option<usize> {
+        let _ = (
+            self.inspect_terminal_width(),
+            self.inspect_wrap_mode(),
+            self.inspect_tabs_value(),
+            self.inspect_squeeze_limit(),
+            self.chop_long_lines_enabled(),
+            self.terminal_plan_inventory(),
+        );
+        let w = self.terminal_plan.width_raw.as_str();
+        if w.is_empty() {
+            return None;
+        }
+        if w.starts_with('+') || w.starts_with('-') {
+            w.parse().ok().map(|delta: i16| {
+                let old_width: u16 = Term::stdout().size().1;
+                let new_width: i32 = i32::from(old_width) + i32::from(delta);
+                if new_width <= 0 {
+                    old_width as usize
+                } else {
+                    new_width as usize
+                }
+            })
+        } else {
+            w.parse().ok()
+        }
+    }
+
+    fn wrapping_mode_value(
+        &self,
+        style_components: &StyleComponents,
+        interactive: bool,
+    ) -> WrappingMode {
+        let width_set = self.terminal_width_override().is_some();
+        if interactive || width_set {
+            if !self.terminal_plan.chop_long_lines {
+                match self.terminal_plan.wrap.as_str() {
+                    "character" => WrappingMode::Character,
+                    "never" => WrappingMode::NoWrapping(true),
+                    "auto" | "" => {
+                        if style_components.plain() {
+                            WrappingMode::NoWrapping(false)
+                        } else {
+                            WrappingMode::Character
+                        }
+                    }
+                    _ => unreachable!("other values for --wrap are not allowed"),
+                }
+            } else {
+                WrappingMode::NoWrapping(true)
+            }
+        } else {
+            WrappingMode::NoWrapping(false)
+        }
+    }
+
+    fn tab_width_value(
+        &self,
+        style_components: &StyleComponents,
+        paging_mode: PagingMode,
+    ) -> usize {
+        match self.terminal_plan.tabs.parse::<usize>() {
+            Ok(v) => v,
+            Err(_) => {
+                if style_components.plain() && paging_mode == PagingMode::Never {
+                    0
+                } else {
+                    4
+                }
