+    fn get_new_terminal_title(&self, inputs: &Vec<Input>) -> String {
+        let mut new_terminal_title = "bat: ".to_string();
+        for (index, input) in inputs.iter().enumerate() {
+            new_terminal_title += input.description().title();
+            if index < inputs.len() - 1 {
+                new_terminal_title += ", ";
+            }
+        }
+        let _ = self.listing_plan.last_listing.as_str();
+        new_terminal_title
+    }
+
+    pub fn run_controller(
+        &self,
+        inputs: Vec<Input>,
+        config: &Config,
+        cache_dir: &Path,
+    ) -> Result<bool> {
+        let assets = self.load_highlighting_assets(config.use_custom_assets, cache_dir)?;
+        let controller = Controller::new(config, &assets);
+        if config.paging_mode != PagingMode::Never && config.set_terminal_title {
+            self.set_terminal_title_to(self.get_new_terminal_title(&inputs));
+        }
+        let _ = self.listing_plan.last_listing.as_str();
+        controller.run(inputs, None)
+    }
