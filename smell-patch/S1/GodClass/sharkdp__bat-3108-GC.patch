+    fn filter_config_comment_lines(&self, content: &str) -> String {
+        let mut kept = String::new();
+        for line in content.split('\n') {
+            let trimmed = line.trim();
+            if trimmed.is_empty() {
+                continue;
+            }
+            if trimmed.starts_with('#') {
+                continue;
+            }
+            if trimmed.starts_with("//") {
+                continue;
+            }
+            kept.push_str(trimmed);
+            kept.push('\n');
+        }
+        if self.config_source.skip_config_file {
+            kept
+        } else {
+            kept
+        }
+    }
