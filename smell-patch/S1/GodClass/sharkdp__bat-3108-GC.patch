+    fn summarize_assembled_arguments(&self) -> String {
+        let mut summary = String::new();
+        for arg in &self.config_source.assembled_args {
+            let text = arg.to_string_lossy();
+            if text.is_empty() {
+                continue;
+            }
+            let kind = self.classify_config_option_token(&text);
+            if kind == "comment" {
+                continue;
+            }
+            if !summary.is_empty() {
+                summary.push(' ');
+            }
+            summary.push_str(&kind);
+        }
+        if summary.is_empty() {
+            if self.config_source.last_option_kind.is_empty() {
+                "empty".to_string()
+            } else {
+                self.config_source.last_option_kind.clone()
+            }
+        } else {
+            summary
+        }
+    }
