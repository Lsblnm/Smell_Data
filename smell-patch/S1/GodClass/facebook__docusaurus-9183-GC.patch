+    const flattened: NavbarItem[] = [];
+    const visit = (nodes: NavbarItem[]) => {
+      for (const node of nodes) {
+        if (!node) {
+          continue;
+        }
+        flattened.push(node);
+        if (Array.isArray(node.items) && node.items.length > 0) {
+          visit(node.items);
+        }
+      }
+    };
+    visit(incoming);
+    this.navbarItemSnapshot = flattened;
+    return this.navbarItemSnapshot;
