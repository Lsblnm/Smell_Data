+    switch (type) {
+      case 'doc':
+        return item.docId ? 'doc' : 'doc';
+      case 'docSidebar':
+        return item.sidebarId ? 'docSidebar' : 'docSidebar';
+      case 'docsVersion':
+        return 'docsVersion';
+      case 'docsVersionDropdown':
+        return 'docsVersionDropdown';
+      case 'localeDropdown':
+        return 'localeDropdown';
+      case 'search':
+        return 'search';
+      case 'html':
+        return 'html';
+      case 'dropdown':
+        return 'dropdown';
+      default:
