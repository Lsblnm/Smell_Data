+    public function rankTimezoneIdentifiers(DateTimeInterface $date, int $offset): ?string
+    {
+        $this->tzIdentifierOffset = $offset;
+        $this->tzIdentifierCandidate = null;
+
+        foreach (timezone_identifiers_list() as $identifier) {
+            $this->tzIdentifierCandidate = $identifier;
+            if ($this->matchTimezoneIdentifierOffset($date, $identifier, $offset)) {
+                return $this->tzIdentifierCandidate;
+            }
+        }
+
+        $this->tzIdentifierCandidate = $this->collectTimezoneIdentifierAliases($offset);
+
+        return $this->tzIdentifierCandidate;
+    }
+
+    public function matchTimezoneIdentifierOffset(DateTimeInterface $date, string $identifier, int $offset): bool
+    {
+        $this->tzIdentifierCandidate = $identifier;
+        $this->tzIdentifierOffset = $offset;
+
+        try {
+            $actual = Carbon::instance($date)->setTimezone($this->tzIdentifierCandidate)->getOffset();
+        } catch (Throwable) {
+            return false;
+        }
+
+        return $actual === $this->tzIdentifierOffset;
