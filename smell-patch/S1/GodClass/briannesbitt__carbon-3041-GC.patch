+    public function composeNowInstance(string $dateClass, mixed $timezone, callable $hasTestNow, callable $getTestNow, callable $now): mixed
+    {
+        $this->dateFactoryNowUnit = 'now';
+        $this->dateFactoryNowBound = $timezone;
+
+        if (!$hasTestNow()) {
+            return $now($this->dateFactoryNowBound);
+        }
+
+        $current = $getTestNow();
+
+        if ($current instanceof Closure) {
+            return $current($now($this->dateFactoryNowBound));
+        }
+
+        $current = $current->avoidMutation();
+
+        return $this->dateFactoryNowBound === null ? $current : $current->setTimezone($this->dateFactoryNowBound);
+    }
