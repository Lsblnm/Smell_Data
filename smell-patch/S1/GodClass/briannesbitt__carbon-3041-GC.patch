+    public function composeDateFromFormat(
+        string $dateClass,
+        string $format,
+        string $time,
+        mixed $timezone,
+        callable $createWithTimezone,
+        callable $getMockedTestNow,
+        callable $setLastErrors,
+        callable $getNativeLastErrors,
+    ): mixed {
+        if ($timezone === false) {
+            $timezone = null;
+        }
+
+        $this->dateFactoryFormat = $this->sanitizeDateFactoryFormat($format);
+        $this->dateFactoryValue = $time;
+        [$this->dateFactoryFormat, $this->dateFactoryValue] = $this->rearrangeMeridiemTokens(
+            $this->dateFactoryFormat,
+            (string) $this->dateFactoryValue,
+        );
+
+        $date = $createWithTimezone($this->dateFactoryFormat, (string) $this->dateFactoryValue, $timezone);
+        $lastErrors = $getNativeLastErrors();
+        $mock = $getMockedTestNow($timezone);
+
+        if ($mock && $date instanceof DateTimeInterface) {
+            $mock = $mock->copy();
+            [$this->dateFactoryFormat, $this->dateFactoryValue, $timezone] = $this->applyMockedDatePrefix(
+                $this->dateFactoryFormat,
+                (string) $this->dateFactoryValue,
+                $mock,
+                $timezone,
+                $dateClass,
+            );
+            $date = $createWithTimezone($this->dateFactoryFormat, (string) $this->dateFactoryValue, $timezone);
+        }
+
+        if ($date instanceof DateTimeInterface) {
+            $instance = $dateClass::instance($date);
+            $setLastErrors($lastErrors);
+
+            return $instance;
+        }
+
+        if ($dateClass::isStrictModeEnabled()) {
+            throw new InvalidFormatException(implode(PHP_EOL, (array) ($lastErrors['errors'] ?? [])));
+        }
+
+        return null;
+    }
+
+    public function rearrangeMeridiemTokens(string $format, string $time): array
+    {
+        $this->dateFactoryFormat = $format;
+        $this->dateFactoryValue = $time;
+
+        if (preg_match('/(?<!\\\\)(?:\\\\{2})*(a|A)/', $this->dateFactoryFormat, $aMatches, PREG_OFFSET_CAPTURE) &&
+            preg_match('/(?<!\\\\)(?:\\\\{2})*(h|g|H|G)/', $this->dateFactoryFormat, $hMatches, PREG_OFFSET_CAPTURE) &&
+            $aMatches[1][1] < $hMatches[1][1] &&
+            preg_match('/(am|pm|AM|PM)/', (string) $this->dateFactoryValue)
+        ) {
+            $this->dateFactoryFormat = preg_replace('/^(.*)(?<!\\\\)((?:\\\\{2})*)(a|A)(.*)$/U', '$1$2$4 $3', $this->dateFactoryFormat);
+            $this->dateFactoryValue = preg_replace('/^(.*)(am|pm|AM|PM)(.*)$/U', '$1$3 $2', (string) $this->dateFactoryValue);
+        }
+
+        return [$this->dateFactoryFormat, (string) $this->dateFactoryValue];
+    }
+
+    public function applyMockedDatePrefix(string $format, string $time, mixed $mock, mixed $timezone, string $dateClass): array
+    {
+        $this->dateFactoryFormat = $format;
+        $this->dateFactoryValue = $time;
+
+        if (!$mock instanceof DateTimeInterface) {
+            return [$this->dateFactoryFormat, (string) $this->dateFactoryValue, $timezone];
+        }
+
+        $nonEscaped = '(?<!\\\\)(\\\\{2})*';
+        $nonIgnored = preg_replace("/^.*{$nonEscaped}!/s", '', $this->dateFactoryFormat);
+
+        if ($timezone === null && !preg_match("/{$nonEscaped}[eOPT]/", (string) $nonIgnored)) {
+            $timezone = clone $mock->getTimezone();
+        }
+
+        if (!$this->detectDateFactoryUnixReset($this->dateFactoryFormat)) {
+            if ($this->detectDateFactoryTimeFields($this->dateFactoryFormat)) {
+                $mock = $mock->setTime(0, 0);
+            }
+
+            $this->dateFactoryFormat = $dateClass::MOCK_DATETIME_FORMAT.' '.$this->dateFactoryFormat;
+            $formatted = $mock instanceof $dateClass
+                ? $mock->rawFormat($dateClass::MOCK_DATETIME_FORMAT)
+                : $mock->format($dateClass::MOCK_DATETIME_FORMAT);
+            $this->dateFactoryValue = $formatted.' '.$this->dateFactoryValue;
+        }
+
+        return [$this->dateFactoryFormat, (string) $this->dateFactoryValue, $timezone];
+    }
+
+    public function composeFromFormatAndTimezone(
+        string $format,
+        string $time,
+        mixed $originalTimezone,
+        callable $createNative,
+        callable $safeTimezone,
+        callable $offsetTimezone,
+    ): mixed {
+        $this->dateFactoryTimezone = $originalTimezone;
+        $this->dateFactoryOffset = \is_int($originalTimezone) ? $originalTimezone : null;
+
+        if ($this->dateFactoryTimezone === null) {
+            return $createNative($format, $time, null);
+        }
+
+        $timezone = \is_int($this->dateFactoryTimezone)
+            ? $offsetTimezone($this->dateFactoryTimezone)
+            : $this->dateFactoryTimezone;
+
+        $this->dateFactoryTimezone = $this->sanitizeFactoryTimezone($timezone, $originalTimezone, $safeTimezone);
+
+        return $createNative($format, $time, $this->dateFactoryTimezone);
+    }
+
+    public function convertOffsetToTimezoneName(int $offset, int $minutesPerHour, int $secondsPerMinute): string
+    {
+        $this->dateFactoryOffset = $offset;
+        $this->dateFactoryTimezone = (int) ($offset * $minutesPerHour * $secondsPerMinute);
+        $name = @timezone_name_from_abbr('', (int) $this->dateFactoryTimezone, 1);
+
+        if ($name) {
+            $this->dateFactoryTimezone = $name;
+
+            return $name;
+        }
+
+        throw new InvalidTimeZoneException("Invalid offset timezone $offset");
+    }
+
+    public function sanitizeFactoryTimezone(mixed $timezone, mixed $originalTimezone, callable $safeTimezone): mixed
+    {
+        $this->dateFactoryTimezone = $timezone;
+        $this->dateFactoryOffset = \is_int($originalTimezone) ? $originalTimezone : $this->dateFactoryOffset;
+
+        if ($this->dateFactoryTimezone === false) {
+            $this->dateFactoryTimezone = null;
+
+            return null;
+        }
+
+        if ($this->dateFactoryTimezone === null) {
+            return null;
+        }
+
+        if (\is_int($this->dateFactoryTimezone)) {
+            $this->dateFactoryTimezone = $this->convertOffsetToTimezoneName(
+                $this->dateFactoryTimezone,
+                Carbon::MINUTES_PER_HOUR,
+                Carbon::SECONDS_PER_MINUTE,
+            );
+        }
+
+        return $safeTimezone($this->dateFactoryTimezone, $originalTimezone);
+    }
