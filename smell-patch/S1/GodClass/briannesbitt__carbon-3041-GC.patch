+    public function describeFactoryTestNowError(Factory $factory, mixed $callback, mixed $testNow): void
+    {
+        $this->factoryTestNowValue = $testNow;
+        $this->factoryTestNowTimezone = $this->factoryTestNowTimezone ?? null;
+        $this->bindFactoryContext($factory);
+        $function = $callback->getReflectionFunction();
+        $type = \is_object($this->factoryTestNowValue) ? $this->factoryTestNowValue::class : \gettype($this->factoryTestNowValue);
+
+        throw new RuntimeException(
+            'The test closure defined in '.$function->getFileName().
+            ' at line '.$function->getStartLine().' returned '.$type.
+            '; expected '.CarbonInterface::class.'|null',
+        );
+    }
+
+    public function bindFactoryTestNowContext(Factory $factory, mixed $testNow, mixed $timezone): mixed
+    {
+        $this->factoryTestNowValue = $testNow;
+        $this->factoryTestNowTimezone = $timezone;
+        $this->bindFactoryContext($factory);
+
+        if ($this->factoryTestNowValue instanceof Factory || $this->factoryTestNowValue instanceof Closure) {
+            return $this->factoryTestNowValue;
+        }
