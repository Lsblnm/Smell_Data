+        $pattern = '/(-?\d+(?:\.\d+)?)\h*([^\d\h]*)/i';
+        preg_match_all($pattern, $this->intervalDefinition, $parts, PREG_SET_ORDER);
+
+        while ($parts) {
+            [$part, $value, $unit] = array_shift($parts);
+            $this->intervalUnitName = $unit;
+            $intValue = (int) $value;
+            $fraction = (float) $value - $intValue;
+
+            switch (round($fraction, 6)) {
+                case 1:
+                    $fraction = 0;
+                    $intValue++;
+                    break;
+                case 0:
+                    $fraction = 0;
+                    break;
+            }
+
+            $result = $this->accumulateIntervalUnit(
+                $intervalClass,
+                $part,
+                $intValue,
+                $fraction,
+                $years,
+                $months,
+                $weeks,
+                $days,
+                $hours,
+                $minutes,
+                $seconds,
+                $milliseconds,
+                $microseconds,
+            );
+
+            if ($result !== null) {
+                $parts[] = $result;
+            }
+        }
+
+        return new $intervalClass(
+            $years,
+            $months,
+            $weeks,
+            $days,
+            $hours,
+            $minutes,
+            $seconds,
+            $milliseconds * Carbon::MICROSECONDS_PER_MILLISECOND + $microseconds,
+        );
+    }
+
+    public function accumulateIntervalUnit(
+        string $intervalClass,
+        mixed $part,
+        int $intValue,
+        float $fraction,
+        int|float &$years,
+        int|float &$months,
+        int|float &$weeks,
+        int|float &$days,
+        int|float &$hours,
+        int|float &$minutes,
+        int|float &$seconds,
+        int|float &$milliseconds,
+        int|float &$microseconds,
+    ): ?array {
+        $unit = $this->canonicalizeIntervalUnit($this->intervalUnitName === 'µs' ? 'µs' : (string) $this->intervalUnitName);
+        $this->intervalDefinition = $this->intervalDefinition ?? '';
+
+        switch ($unit) {
+            case 'millennia':
+            case 'millennium':
+                $years += $intValue * CarbonInterface::YEARS_PER_MILLENNIUM;
+                break;
+            case 'century':
+            case 'centuries':
+                $years += $intValue * CarbonInterface::YEARS_PER_CENTURY;
+                break;
+            case 'decade':
+            case 'decades':
+                $years += $intValue * CarbonInterface::YEARS_PER_DECADE;
+                break;
+            case 'year':
+            case 'years':
+            case 'y':
+            case 'yr':
+            case 'yrs':
+                $years += $intValue;
+                break;
+            case 'quarter':
+            case 'quarters':
+                $months += $intValue * CarbonInterface::MONTHS_PER_QUARTER;
+                break;
+            case 'month':
+            case 'months':
+            case 'mo':
+            case 'mos':
+                $months += $intValue;
+                break;
+            case 'week':
+            case 'weeks':
+            case 'w':
+                $weeks += $intValue;
+                if ($fraction) {
+                    return $this->cascadeIntervalFraction('w', $fraction, $intervalClass);
+                }
+                break;
+            case 'day':
+            case 'days':
+            case 'd':
+                $days += $intValue;
+                if ($fraction) {
+                    return $this->cascadeIntervalFraction('d', $fraction, $intervalClass);
+                }
+                break;
+            case 'hour':
+            case 'hours':
+            case 'h':
+                $hours += $intValue;
+                if ($fraction) {
+                    return $this->cascadeIntervalFraction('h', $fraction, $intervalClass);
+                }
+                break;
+            case 'minute':
+            case 'minutes':
+            case 'm':
+                $minutes += $intValue;
+                if ($fraction) {
+                    return $this->cascadeIntervalFraction('m', $fraction, $intervalClass);
+                }
+                break;
+            case 'second':
+            case 'seconds':
+            case 's':
+                $seconds += $intValue;
+                if ($fraction) {
+                    return $this->cascadeIntervalFraction('s', $fraction, $intervalClass);
+                }
+                break;
+            case 'millisecond':
+            case 'milliseconds':
+            case 'milli':
+            case 'ms':
+                $milliseconds += $intValue;
+                if ($fraction) {
+                    $microseconds += round($fraction * $intervalClass::getMicrosecondsPerMillisecond());
+                }
+                break;
+            case 'microsecond':
+            case 'microseconds':
+            case 'micro':
+            case 'µs':
+                $microseconds += $intValue;
+                break;
+            default:
+                $this->describeUnknownIntervalUnit($part);
+                throw new InvalidIntervalException(
+                    sprintf('Invalid part %s in definition %s', $part, $this->intervalDefinition),
+                );
+        }
+
+        return null;
+    }
+
+    public function cascadeIntervalFraction(string $fromUnit, float $fraction, string $intervalClass): array
+    {
+        $this->intervalDefinition = $this->intervalDefinition ?? $fromUnit;
+        $this->intervalUnitName = $fromUnit;
+        $target = null;
+        $factor = 0.0;
+
+        switch ($fromUnit) {
+            case 'w':
+            case 'week':
+            case 'weeks':
+                $target = 'd';
+                $factor = (float) $intervalClass::getDaysPerWeek();
+                break;
+            case 'd':
+            case 'day':
+            case 'days':
+                $target = 'h';
+                $factor = (float) $intervalClass::getHoursPerDay();
+                break;
+            case 'h':
+            case 'hour':
+            case 'hours':
+                $target = 'm';
+                $factor = (float) $intervalClass::getMinutesPerHour();
+                break;
+            case 'm':
+            case 'minute':
+            case 'minutes':
+                $target = 's';
+                $factor = (float) $intervalClass::getSecondsPerMinute();
+                break;
+            case 's':
+            case 'second':
+            case 'seconds':
+                $target = 'ms';
+                $factor = (float) $intervalClass::getMillisecondsPerSecond();
+                break;
+            default:
+                $target = 'µs';
+                $factor = (float) $intervalClass::getMicrosecondsPerMillisecond();
+                break;
+        }
+
+        return [null, $fraction * $factor, $target];
+    }
+
+    public function composeIntervalFromFormat(string $intervalClass, string $format, ?string $interval, array $formats): mixed
+    {
+        $this->intervalFormatMask = $format;
+        $this->intervalFormatValue = $interval;
+        $instance = new $intervalClass(0);
+        $length = mb_strlen($this->intervalFormatMask);
+
+        if (preg_match('/s([,.])([uv])$/', $this->intervalFormatMask, $match)) {
+            $pieces = explode($match[1], (string) $this->intervalFormatValue);
+            $index = \count($pieces) - 1;
+            $pieces[$index] = str_pad($pieces[$index], $match[2] === 'v' ? 3 : 6, '0');
+            $this->intervalFormatValue = implode($match[1], $pieces);
+        }
+
+        $this->intervalFormatValue ??= '';
+
+        for ($index = 0; $index < $length; $index++) {
+            $expected = mb_substr($this->intervalFormatMask, $index, 1);
+            $nextCharacter = mb_substr((string) $this->intervalFormatValue, 0, 1);
+            $unit = $formats[$expected] ?? null;
+
+            if ($unit) {
+                if (!preg_match('/^-?\d+/', (string) $this->intervalFormatValue, $match)) {
+                    throw new ParseErrorException('number', $nextCharacter);
+                }
+
+                $this->intervalFormatValue = mb_substr((string) $this->intervalFormatValue, mb_strlen($match[0]));
+                $instance->$unit += (int) ($match[0]);
+                continue;
+            }
+
+            if (!$this->matchIntervalFormatToken($expected, $nextCharacter)) {
+                throw new ParseErrorException(
+                    "'$expected'",
+                    $nextCharacter,
+                    $this->describeIntervalFormatError($this->intervalFormatMask, $this->intervalFormatValue).
+                    "\nAllowed substitutes for interval formats are ".implode(', ', array_keys($formats))."\n".
+                    'See https://php.net/manual/en/function.date.php for their meaning',
+                );
+            }
+
+            $this->intervalFormatValue = mb_substr((string) $this->intervalFormatValue, 1);
+        }
+
+        if ($this->intervalFormatValue !== '') {
+            throw new ParseErrorException(
+                'end of string',
+                $this->intervalFormatValue,
+            );
+        }
+
+        return $instance;
+    }
+
+    public function matchIntervalFormatToken(string $token, ?string $value): bool
+    {
+        $this->intervalFormatMask = $this->intervalFormatMask ?? $token;
+        $this->intervalFormatValue = $this->intervalFormatValue ?? $value;
+
+        if ($value === null || $token === '') {
+            return false;
+        }
+
+        return $value === $token;
+    }
+
+    public function describeIntervalFormatError(string $format, ?string $interval): string
+    {
+        $this->intervalFormatMask = $format;
+        $this->intervalFormatValue = $interval;
+
+        if ($this->intervalFormatValue === null) {
+            return 'Could not create interval from null value using '.$this->intervalFormatMask;
+        }
+
+        if ($this->intervalFormatValue === '') {
+            return 'Could not create interval from empty string using '.$this->intervalFormatMask;
+        }
+
+        return 'Could not create interval from: '.var_export($this->intervalFormatValue, true);
+    }
