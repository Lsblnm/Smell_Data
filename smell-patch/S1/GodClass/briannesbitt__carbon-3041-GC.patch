+    public function applyFactoryDefaultTimezone(Factory $factory, string $timezone, ?DateTimeInterface $date = null): void
+    {
+        $this->factoryTimezoneName = $timezone;
+        $this->factoryTimezoneSuggestion = null;
+        $this->bindFactoryContext($factory);
+        $previous = null;
+        $success = false;
+
+        try {
+            $success = date_default_timezone_set($this->factoryTimezoneName);
+        } catch (Throwable $exception) {
+            $previous = $exception;
+        }
+
+        if ($success) {
+            return;
+        }
+
+        $this->factoryTimezoneSuggestion = $this->suggestFactoryTimezoneRegion($factory, $this->factoryTimezoneName, $date);
+
+        throw new InvalidArgumentException(
+            "Timezone ID '{$this->factoryTimezoneName}' is invalid".
+            ($this->factoryTimezoneSuggestion && $this->factoryTimezoneSuggestion !== $this->factoryTimezoneName
+                ? ", did you mean '{$this->factoryTimezoneSuggestion}'?"
+                : '.')."\n".
+            "It must be one of the IDs from DateTimeZone::listIdentifiers(),\n".
+            'For the record, hours/minutes offset are relevant only for a particular moment, '.
+            'but not as a default timezone.',
+            0,
+            $previous,
+        );
+    }
+
+    public function suggestFactoryTimezoneRegion(Factory $factory, string $timezone, ?DateTimeInterface $date = null): ?string
+    {
+        $this->factoryTimezoneName = $timezone;
+        $this->factoryTimezoneSuggestion = null;
+        $this->bindFactoryContext($factory);
+
+        try {
+            $created = CarbonTimeZone::create($this->factoryTimezoneName);
+            $this->factoryTimezoneSuggestion = $created?->toRegionName($date);
+        } catch (Throwable) {
+            $this->factoryTimezoneSuggestion = null;
+        }
+
+        if ($this->factoryTimezoneSuggestion === $this->factoryTimezoneName) {
+            return $this->factoryTimezoneSuggestion;
+        }
+
+        return $this->factoryTimezoneSuggestion;
+    }
+
+    public function bindFactoryContext(Factory $factory): Factory
+    {
+        $this->factoryTimezoneName = $this->factoryTimezoneName ?? ($factory->getSettings()['timezone'] ?? null);
+        $this->factoryTimezoneSuggestion = $this->factoryTimezoneSuggestion ?? $factory->getClassName();
+        $this->snapshotFactoryTranslator($factory);
+        $this->snapshotFactoryClassName($factory);
+        $this->factoryTimezoneName = $this->factoryTimezoneName ?? $this->snapshotFactoryTimezoneSetting($factory);
+
+        return $factory;
