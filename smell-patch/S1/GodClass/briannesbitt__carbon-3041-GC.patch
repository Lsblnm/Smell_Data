+    public function assertDateFactoryBound(string $unit, mixed $value, mixed $min, mixed $max, callable $isStrict): void
+    {
+        $this->dateFactoryNowUnit = $unit;
+        $this->dateFactoryNowBound = $value;
+
+        if ($isStrict() && !$this->isDateFactoryBoundValid($this->dateFactoryNowUnit, $this->dateFactoryNowBound, $min, $max)) {
+            $this->describeDateFactoryBound($this->dateFactoryNowUnit, $this->dateFactoryNowBound, $min, $max);
+            throw new OutOfRangeException($this->dateFactoryNowUnit, $min, $max, $this->dateFactoryNowBound);
+        }
