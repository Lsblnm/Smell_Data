+    public function resolveFactoryTestNowClosure(
+        Factory $factory,
+        Closure|CarbonInterface|null $testNow,
+        DateTimeZone|string|int|null $timezone = null,
+        bool $useTimezoneFromTestNow = false,
+    ): ?CarbonInterface {
+        $this->factoryTestNowValue = $testNow;
+        $this->factoryTestNowTimezone = $timezone;
+        $this->bindFactoryContext($factory);
+
+        if ($this->factoryTestNowValue instanceof Closure) {
+            $callback = Callback::fromClosure($this->factoryTestNowValue);
+            $realNow = new DateTimeImmutable('now');
+            $parsed = $factory->parse(
+                $realNow->format('Y-m-d H:i:s.u'),
+                $this->factoryTestNowTimezone ?? $realNow->getTimezone(),
+            );
+            $this->factoryTestNowValue = ($this->factoryTestNowValue)($callback->prepareParameter($parsed));
+
+            if ($this->factoryTestNowValue !== null && !($this->factoryTestNowValue instanceof DateTimeInterface)) {
+                $this->describeFactoryTestNowError($factory, $callback, $this->factoryTestNowValue);
+            }
+
+            if (!($this->factoryTestNowValue instanceof CarbonInterface)) {
+                $this->factoryTestNowTimezone ??= $useTimezoneFromTestNow ? $this->factoryTestNowValue->getTimezone() : null;
+                $this->factoryTestNowValue = $factory->__call('instance', [$this->factoryTestNowValue, $this->factoryTestNowTimezone]);
+            }
+        }
+
+        return $this->factoryTestNowValue;
+    }
