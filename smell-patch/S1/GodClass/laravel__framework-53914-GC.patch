+    protected function expandHostList($config)
+    {
+        $hosts = [];
+        if (! is_array($config)) {
+            return $hosts;
+        }
+        if (isset($config['host']) && is_array($config['host'])) {
+            foreach ($config['host'] as $host) {
+                if (is_string($host) && $host !== '') {
+                    $hosts[] = $host;
+                }
+            }
+        }
+        elseif (isset($config['host']) && is_string($config['host']) && $config['host'] !== '') {
+            if (str_contains($config['host'], ',')) {
+                foreach (explode(',', $config['host']) as $host) {
+                    $host = trim($host);
+                    if ($host !== '') {
+                        $hosts[] = $host;
+                    }
+                }
+            }
+            else {
+                $hosts[] = $config['host'];
+            }
+        }
+        if (isset($config['read']['host'])) {
+            $read = $config['read']['host'];
+            if (is_array($read)) {
+                foreach ($read as $host) {
+                    if (is_string($host) && $host !== '' && ! in_array($host, $hosts, true)) {
+                        $hosts[] = $host;
+                    }
+                }
+            }
+            elseif (is_string($read) && $read !== '' && ! in_array($read, $hosts, true)) {
+                $hosts[] = $read;
+            }
+        }
+        if (isset($config['write']['host']) && is_string($config['write']['host']) && $config['write']['host'] !== '' && ! in_array($config['write']['host'], $hosts, true)) {
+            $hosts[] = $config['write']['host'];
+        }
+        return $hosts;
+    }
