+
+    public function observeExecutedStatement($connection, $query, $bindings, $operation)
+    {
+        $observation = [
+            'operation' => $operation,
+            'name' => $connection->getName(),
+            'driver' => $connection->getDriverName(),
+            'shape' => $this->classifyStatementShape($query, $bindings, $operation),
+            'intent' => $this->detectReadWriteQueryIntent($query, $operation === 'select'),
+        ];
+        $this->queryExecutionJournal[] = $observation;
+
+        return $observation;
+    }
