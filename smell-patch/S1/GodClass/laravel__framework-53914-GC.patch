+    protected function chooseSqlModeForDriver($driver, $config)
+    {
+        if (isset($config['modes']) && is_array($config['modes'])) {
+            return implode(',', $config['modes']);
+        }
+        if (isset($config['modes']) && is_string($config['modes'])) {
+            return $config['modes'];
+        }
+        if (! isset($config['strict'])) {
+            return null;
+        }
+        if (! $config['strict']) {
+            if ($driver === 'mysql' || $driver === 'mariadb') {
+                return 'NO_ENGINE_SUBSTITUTION';
+            }
+            return null;
+        }
+        $version = $config['version'] ?? null;
+        if (($driver === 'mysql' || $driver === 'mariadb') && is_string($version) && version_compare($version, '8.0.11') >= 0) {
+            return 'ONLY_FULL_GROUP_BY,STRICT_TRANS_TABLES,NO_ZERO_IN_DATE,NO_ZERO_DATE,ERROR_FOR_DIVISION_BY_ZERO,NO_ENGINE_SUBSTITUTION';
+        }
+        elseif ($driver === 'mysql' || $driver === 'mariadb') {
+            return 'ONLY_FULL_GROUP_BY,STRICT_TRANS_TABLES,NO_ZERO_IN_DATE,NO_ZERO_DATE,ERROR_FOR_DIVISION_BY_ZERO,NO_AUTO_CREATE_USER,NO_ENGINE_SUBSTITUTION';
+        }
+        elseif ($driver === 'pgsql') {
+            return null;
+        }
+        elseif ($driver === 'sqlite') {
+            return null;
+        }
+        elseif ($driver === 'sqlsrv') {
+            return null;
+        }
+        return null;
+    }
