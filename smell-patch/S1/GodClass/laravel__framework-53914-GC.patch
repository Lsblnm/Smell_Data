+    protected function interpretIsolationLevel($level, $driver)
+    {
+        $normalized = is_string($level) ? strtolower(str_replace(['-', ' '], '_', $level)) : $level;
+        if ($normalized === 'read_uncommitted' || $normalized === 'read uncommitted') {
+            return 'READ UNCOMMITTED';
+        }
+        elseif ($normalized === 'read_committed' || $normalized === 'read committed') {
+            return 'READ COMMITTED';
+        }
+        elseif ($normalized === 'repeatable_read' || $normalized === 'repeatable read') {
+            return 'REPEATABLE READ';
+        }
+        elseif ($normalized === 'serializable') {
+            return 'SERIALIZABLE';
+        }
+        elseif ($normalized === 'snapshot') {
+            return $driver === 'sqlsrv' ? 'SNAPSHOT' : 'REPEATABLE READ';
+        }
+        elseif ($normalized === 0 || $normalized === '0') {
+            return 'READ UNCOMMITTED';
+        }
+        elseif ($normalized === 1 || $normalized === '1') {
+            return 'READ COMMITTED';
+        }
+        elseif ($normalized === 2 || $normalized === '2') {
+            return 'REPEATABLE READ';
+        }
+        elseif ($normalized === 3 || $normalized === '3') {
+            return 'SERIALIZABLE';
+        }
+        elseif (is_string($level) && $level !== '') {
+            return strtoupper($level);
+        }
+        if ($driver === 'mysql' || $driver === 'mariadb') {
+            return 'REPEATABLE READ';
+        }
+        elseif ($driver === 'pgsql') {
+            return 'READ COMMITTED';
+        }
+        elseif ($driver === 'sqlite') {
+            return 'SERIALIZABLE';
+        }
+        elseif ($driver === 'sqlsrv') {
+            return 'READ COMMITTED';
+        }
+        return null;
+    }
