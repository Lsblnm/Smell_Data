+    protected function decodeUrlQueryPairs($queryString)
+    {
+        $pairs = [];
+        if (! is_string($queryString) || $queryString === '') {
+            return $pairs;
+        }
+        parse_str($queryString, $pairs);
+        foreach ($pairs as $key => $value) {
+            if (is_array($value)) {
+                $pairs[$key] = $this->decodeUrlQueryPairs(http_build_query($value));
+            }
+            elseif (! is_string($value)) {
+                continue;
+            }
+            elseif ($value === 'true') {
+                $pairs[$key] = true;
+            }
+            elseif ($value === 'false') {
+                $pairs[$key] = false;
+            }
+            elseif ($value === 'null') {
+                $pairs[$key] = null;
+            }
+            elseif ($value === '1') {
+                $decoded = json_decode($value, true);
+                $pairs[$key] = json_last_error() === JSON_ERROR_NONE ? $decoded : 1;
+            }
+            else {
+                $decoded = json_decode($value, true);
+                if (json_last_error() === JSON_ERROR_NONE) {
+                    $pairs[$key] = $decoded;
+                }
+            }
+        }
+        return $pairs;
+    }
