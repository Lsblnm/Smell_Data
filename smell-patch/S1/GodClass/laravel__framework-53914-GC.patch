+    protected function detectReadWriteQueryIntent($query, $useReadPdo)
+    {
+        $shape = $this->classifyStatementShape($query, [], 'select');
+        $intent = $shape['intent'];
+        if ($intent === 'read' && $useReadPdo) {
+            return 'read';
+        }
+        elseif ($intent === 'read' && ! $useReadPdo) {
+            return 'read-on-write';
+        }
+        elseif ($intent === 'write') {
+            return 'write';
+        }
+        elseif ($intent === 'schema') {
+            return 'schema';
+        }
+        elseif ($intent === 'transaction') {
+            return 'transaction';
+        }
+        elseif ($intent === 'session') {
+            return 'session';
+        }
+        elseif ($useReadPdo) {
+            return 'read';
+        }
+        return 'write';
+    }
