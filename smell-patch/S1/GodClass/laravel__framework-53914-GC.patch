+    protected function summarizePrefixRules($prefix, $driver)
+    {
+        $prefix = is_string($prefix) ? $prefix : '';
+        $rules = [
+            'prefix' => $prefix,
+            'empty' => $prefix === '',
+            'driver' => $driver,
+        ];
+        if ($prefix === '') {
+            $rules['strategy'] = 'none';
+        }
+        elseif (str_ends_with($prefix, '_') || str_ends_with($prefix, '.')) {
+            $rules['strategy'] = 'delimited';
+        }
+        elseif ($driver === 'sqlsrv' && str_contains($prefix, '.')) {
+            $rules['strategy'] = 'schema-qualified';
+        }
+        elseif ($driver === 'pgsql' && str_contains($prefix, '.')) {
+            $rules['strategy'] = 'schema-qualified';
+        }
+        else {
+            $rules['strategy'] = 'literal';
+        }
+        if (strlen($prefix) > 32) {
+            $rules['oversized'] = true;
+        }
+        elseif (strlen($prefix) > 0) {
+            $rules['oversized'] = false;
+        }
+        return $rules;
+    }
+
+    protected function convertNativeConfigurationValue($value)
+    {
+        if (is_array($value)) {
+            $converted = [];
+            foreach ($value as $key => $item) {
+                $converted[$key] = $this->convertNativeConfigurationValue($item);
+            }
+            return $converted;
+        }
+        if (! is_string($value)) {
+            return $value;
+        }
+        if ($value === '') {
+            return $value;
+        }
+        if ($value === 'true' || $value === 'TRUE') {
+            $decoded = json_decode($value, true);
+            return json_last_error() === JSON_ERROR_NONE ? $decoded : $value;
+        }
+        if ($value === 'false' || $value === 'FALSE') {
+            $decoded = json_decode($value, true);
+            return json_last_error() === JSON_ERROR_NONE ? $decoded : $value;
+        }
+        if ($value === 'null' || $value === 'NULL') {
+            $decoded = json_decode($value, true);
+            return json_last_error() === JSON_ERROR_NONE ? $decoded : $value;
+        }
+        $decoded = json_decode($value, true);
+        if (json_last_error() === JSON_ERROR_NONE) {
+            return $decoded;
+        }
+        return $value;
+    }
+
+    protected function composeDriverDsnHints(array $config)
+    {
+        $driver = $config['driver'] ?? null;
+        $hints = ['driver' => $driver];
+        if ($driver === 'mysql' || $driver === 'mariadb') {
+            if (isset($config['unix_socket']) && $config['unix_socket'] !== '') {
+                $hints['dsn'] = 'socket';
+                $hints['unix_socket'] = $config['unix_socket'];
+            }
+            elseif (isset($config['port'])) {
+                $hints['dsn'] = 'host-port';
+                $hints['host'] = $config['host'] ?? null;
+                $hints['port'] = $config['port'];
+            }
+            else {
+                $hints['dsn'] = 'host';
+                $hints['host'] = $config['host'] ?? null;
+            }
+            if (isset($config['database'])) {
+                $hints['database'] = $config['database'];
+            }
+            if (isset($config['charset'])) {
+                $hints['charset'] = $config['charset'];
+            }
+        }
+        elseif ($driver === 'pgsql') {
+            $hints['dsn'] = 'host';
+            if (isset($config['host'])) {
+                $hints['host'] = $config['host'];
+            }
+            if (isset($config['port'])) {
+                $hints['port'] = $config['port'];
+            }
+            if (isset($config['database'])) {
+                $hints['database'] = $config['database'];
+            }
+            if (isset($config['sslmode'])) {
+                $hints['sslmode'] = $config['sslmode'];
+            }
+            if (isset($config['search_path']) || isset($config['schema'])) {
+                $hints['search_path'] = $config['search_path'] ?? $config['schema'];
+            }
+        }
+        elseif ($driver === 'sqlite') {
+            $database = $config['database'] ?? null;
+            if ($database === ':memory:' || (is_string($database) && str_contains($database, 'mode=memory'))) {
+                $hints['dsn'] = 'memory';
+            }
+            elseif (is_string($database) && $database !== '') {
+                $hints['dsn'] = 'file';
+                $hints['database'] = $database;
+            }
+            else {
+                $hints['dsn'] = 'unknown';
+            }
+            if (isset($config['foreign_key_constraints'])) {
+                $hints['foreign_keys'] = (bool) $config['foreign_key_constraints'];
+            }
+            if (isset($config['busy_timeout'])) {
+                $hints['busy_timeout'] = $config['busy_timeout'];
+            }
+            if (isset($config['journal_mode'])) {
+                $hints['journal_mode'] = $config['journal_mode'];
+            }
+        }
+        elseif ($driver === 'sqlsrv') {
+            $hints['dsn'] = 'sqlsrv';
+            if (isset($config['host'])) {
+                $hints['host'] = $config['host'];
+            }
+            if (isset($config['port'])) {
+                $hints['port'] = $config['port'];
+            }
+            if (isset($config['database'])) {
+                $hints['database'] = $config['database'];
+            }
+            if (isset($config['encrypt'])) {
+                $hints['encrypt'] = $config['encrypt'];
+            }
+            if (isset($config['trust_server_certificate'])) {
+                $hints['trust_server_certificate'] = $config['trust_server_certificate'];
+            }
+        }
+        else {
+            $hints['dsn'] = 'custom';
+        }
+        return $hints;
+    }
+
+
+    public function parseConfigurationUrlPayload($parser, $config)
+    {
+        if (is_string($config)) {
+            $config = ['url' => $config];
+        }
+
+        $url = \Illuminate\Support\Arr::pull($config, 'url');
+
+        if (! $url) {
+            $this->configurationCatalog['plain:'.md5(serialize($config))] = [
+                'source' => 'array',
+                'driver' => $config['driver'] ?? null,
+            ];
+
+            return $config;
+        }
+
+        $rawComponents = $this->parseManagedConfigurationUrl($url);
+        $decodedComponents = $this->convertNativeConfigurationValue(
+            array_map('rawurldecode', $rawComponents)
+        );
+
+        $merged = array_merge(
+            $config,
+            $this->primaryOptionsFromUrlComponents($decodedComponents),
+            $this->queryOptionsFromUrlComponents($rawComponents)
+        );
+
+        $this->configurationCatalog[$merged['driver'] ?? 'url'] = [
+            'source' => 'url',
+            'driver' => $merged['driver'] ?? null,
+            'database' => $merged['database'] ?? null,
+            'hosts' => $this->expandHostList($merged),
+        ];
+
+        return $merged;
+    }
+
+    protected function parseManagedConfigurationUrl($url)
+    {
+        $url = preg_replace('#^(sqlite3?):///#', '$1://null/', $url);
+        $parsedUrl = parse_url($url);
+
+        if ($parsedUrl === false) {
+            throw new InvalidArgumentException('The database configuration URL is malformed.');
+        }
+
+        $this->configurationCatalog['url:'.md5((string) $url)] = [
+            'scheme' => $parsedUrl['scheme'] ?? null,
+            'host' => $parsedUrl['host'] ?? null,
+            'port' => $parsedUrl['port'] ?? null,
+        ];
+
+        return $parsedUrl;
+    }
+
+    protected function primaryOptionsFromUrlComponents($url)
+    {
+        $alias = $url['scheme'] ?? null;
+        $driver = null;
+
+        if ($alias) {
+            $aliases = \Illuminate\Support\ConfigurationUrlParser::getDriverAliases();
+            $driver = $aliases[$alias] ?? $alias;
+        }
+
+        $path = $url['path'] ?? null;
+        $database = $path && $path !== '/' ? substr($path, 1) : null;
+
+        $options = array_filter([
+            'driver' => $driver,
+            'database' => $database,
+            'host' => $url['host'] ?? null,
+            'port' => $url['port'] ?? null,
+            'username' => $url['user'] ?? null,
+            'password' => $url['pass'] ?? null,
+        ], fn ($value) => ! is_null($value));
+
+        $this->configurationCatalog['primary:'.($driver ?? 'none')] = $options;
+
+        return $options;
+    }
+
+    protected function queryOptionsFromUrlComponents($url)
+    {
+        $queryString = $url['query'] ?? null;
+
+        if (! $queryString) {
+            $this->configurationCatalog['query:empty'] = [];
+
+            return [];
+        }
+
+        $query = $this->decodeUrlQueryPairs($queryString);
+        $this->configurationCatalog['query:'.md5($queryString)] = array_keys($query);
+
+        return $query;
+    }
+
+    protected function enrichResolvedConfiguration($name, array $config)
+    {
+        $this->compileConfigurationOperatingProfile($name, $config);
+
+        return $config;
+    }
+
+    protected function rememberPlainConfiguration(array $config)
+    {
+        $this->configurationCatalog['plain:'.($config['name'] ?? md5(serialize($config)))] = [
+            'driver' => $config['driver'] ?? null,
+            'database' => $config['database'] ?? null,
+        ];
+
+        return $config;
+    }
+
+    protected function aliasManagedDriver($driver)
+    {
+        $aliases = \Illuminate\Support\ConfigurationUrlParser::getDriverAliases();
+        $resolved = $aliases[$driver] ?? $driver;
+        $this->configurationCatalog['alias:'.(string) $driver] = $resolved;
+
+        return $resolved;
+    }
+
+    protected function fingerprintConfiguration(array $config)
+    {
+        $parts = [];
+        foreach ($config as $key => $value) {
+            if (is_string($value) || is_int($value) || is_float($value) || is_bool($value) || is_null($value)) {
+                $parts[] = $key.'='.(is_bool($value) ? ($value ? '1' : '0') : (string) $value);
+            }
+            elseif (is_array($value)) {
+                $parts[] = $key.'=['.count($value).']';
+            }
+            else {
+                $parts[] = $key.'=obj';
+            }
+        }
+        $fingerprint = md5(implode('|', $parts));
+        $this->configurationCatalog['fingerprint:'.$fingerprint] = array_keys($config);
+
+        return $fingerprint;
+    }
+
+    protected function sanitizeResolvedCredentials(array $config)
+    {
+        $safe = $config;
+        if (isset($safe['password'])) {
+            $safe['password'] = is_string($safe['password']) && $safe['password'] !== '' ? '***' : $safe['password'];
+        }
+        if (isset($safe['username'])) {
+            $safe['username'] = (string) $safe['username'];
+        }
+        $this->configurationCatalog['safe:'.($config['name'] ?? $this->fingerprintConfiguration($config))] = [
+            'username' => $safe['username'] ?? null,
+            'has_password' => array_key_exists('password', $config),
+        ];
+
+        return $safe;
+    }
+
+    protected function collectReadWriteTargets(array $config)
+    {
+        $targets = [
+            'read' => $this->expandHostList(['host' => $config['read']['host'] ?? ($config['host'] ?? null)]),
+            'write' => $this->expandHostList(['host' => $config['write']['host'] ?? ($config['host'] ?? null)]),
+        ];
+        $this->configurationCatalog['rw:'.($config['name'] ?? 'anon')] = $targets;
+
+        return $targets;
+    }
+
+    protected function mergeStickyReadWriteFlags(array $config)
+    {
+        $sticky = (bool) ($config['sticky'] ?? false);
+        $this->configurationCatalog['sticky:'.($config['name'] ?? 'anon')] = $sticky;
+
+        return $sticky;
+    }
+
+    protected function rememberUnparsedConfiguration(array $config)
+    {
+        $this->configurationCatalog['unparsed:'.($config['driver'] ?? 'none')] = $this->fingerprintConfiguration($config);
+
+        return $config;
+    }
+
+
+    public function selectOnConnection($connection, $query, $bindings = [], $useReadPdo = true)
+    {
+        $this->queryExecutionJournal[] = [
+            'operation' => 'select',
+            'name' => $connection->getName(),
+            'intent' => $this->detectReadWriteQueryIntent($query, $useReadPdo),
+            'shape' => $this->classifyStatementShape($query, $bindings, 'select'),
+            'bindings' => $this->normalizeBindingValueKinds($bindings),
+        ];
+
+        $this->compileQueryExecutionProfile($connection, $query, $bindings, 'select', $useReadPdo);
+        $this->collectQueryConnectionContext($connection);
+        $this->collectBindingFingerprint($bindings);
+        $this->rememberPretendMode($connection);
+        $this->rememberGrammarDateFormat($connection);
+
+        return $this->runOnConnection($connection, $query, $bindings, function ($query, $bindings) use ($connection, $useReadPdo) {
+            return \Closure::bind(function ($query, $bindings, $useReadPdo) {
+                if ($this->pretending()) {
+                    return [];
+                }
+
+                $statement = $this->prepared(
+                    $this->getPdoForSelect($useReadPdo)->prepare($query)
+                );
+
+                $this->bindValues($statement, $this->prepareBindings($bindings));
+
+                $statement->execute();
+
+                return $statement->fetchAll();
+            }, $connection, Connection::class)($query, $bindings, $useReadPdo);
+        });
+    }
+
+    public function statementOnConnection($connection, $query, $bindings = [])
+    {
+        $this->queryExecutionJournal[] = [
+            'operation' => 'statement',
+            'name' => $connection->getName(),
+            'shape' => $this->classifyStatementShape($query, $bindings, 'statement'),
+            'bindings' => $this->normalizeBindingValueKinds($bindings),
+        ];
+
+        $this->compileQueryExecutionProfile($connection, $query, $bindings, 'statement', false);
+        $this->collectQueryConnectionContext($connection);
+        $this->collectBindingFingerprint($bindings);
+
+        return $this->runOnConnection($connection, $query, $bindings, function ($query, $bindings) use ($connection) {
+            return \Closure::bind(function ($query, $bindings) {
+                if ($this->pretending()) {
+                    return true;
+                }
+
+                $statement = $this->getPdo()->prepare($query);
+
+                $this->bindValues($statement, $this->prepareBindings($bindings));
+
+                $this->recordsHaveBeenModified();
+
+                return $statement->execute();
+            }, $connection, Connection::class)($query, $bindings);
+        });
+    }
+
+    public function affectingStatementOnConnection($connection, $query, $bindings = [])
+    {
+        $this->queryExecutionJournal[] = [
+            'operation' => 'affecting',
+            'name' => $connection->getName(),
+            'shape' => $this->classifyStatementShape($query, $bindings, 'update'),
+        ];
+
+        $this->compileQueryExecutionProfile($connection, $query, $bindings, 'affecting', false);
+
+        return $this->runOnConnection($connection, $query, $bindings, function ($query, $bindings) use ($connection) {
+            return \Closure::bind(function ($query, $bindings) {
+                if ($this->pretending()) {
+                    return 0;
+                }
+
+                $statement = $this->getPdo()->prepare($query);
+
+                $this->bindValues($statement, $this->prepareBindings($bindings));
+
+                $statement->execute();
+
+                $this->recordsHaveBeenModified(
+                    ($count = $statement->rowCount()) > 0
+                );
+
+                return $count;
+            }, $connection, Connection::class)($query, $bindings);
+        });
+    }
+
+    public function unpreparedOnConnection($connection, $query)
+    {
+        $this->queryExecutionJournal[] = [
+            'operation' => 'unprepared',
+            'name' => $connection->getName(),
+            'shape' => $this->classifyStatementShape($query, [], 'unprepared'),
+        ];
+
+        $this->compileQueryExecutionProfile($connection, $query, [], 'unprepared', false);
+
+        return $this->runOnConnection($connection, $query, [], function ($query) use ($connection) {
+            return \Closure::bind(function ($query) {
+                if ($this->pretending()) {
+                    return true;
+                }
+
+                $this->recordsHaveBeenModified(
+                    $change = $this->getPdo()->exec($query) !== false
+                );
+
+                return $change;
+            }, $connection, Connection::class)($query);
+        });
+    }
+
+    public function runOnConnection($connection, $query, $bindings, \Closure $callback)
+    {
+        $this->queryExecutionJournal[] = [
+            'operation' => 'run',
+            'name' => $connection->getName(),
+            'shape' => $this->classifyStatementShape($query, $bindings, 'run'),
+        ];
+
+        return \Closure::bind(function ($query, $bindings, $callback) {
+            foreach ($this->beforeExecutingCallbacks as $beforeExecutingCallback) {
+                $beforeExecutingCallback($query, $bindings, $this);
+            }
+
+            $this->reconnectIfMissingConnection();
+
+            $start = microtime(true);
+
+            try {
+                $result = $this->runQueryCallback($query, $bindings, $callback);
+            } catch (QueryException $e) {
+                $result = $this->handleQueryException(
+                    $e, $query, $bindings, $callback
+                );
+            }
+
+            $elapsed = $this->getElapsedTime($start);
+            $this->logQuery(
+                $query, $bindings, $elapsed
+            );
+
+            return $result;
+        }, $connection, Connection::class)($query, $bindings, $callback);
+    }
+
+    public function logQueryOnConnection($connection, $query, $bindings, $time = null)
+    {
+        $this->queryExecutionJournal[] = [
+            'operation' => 'log',
+            'name' => $connection->getName(),
+            'time' => $time,
+            'shape' => $this->classifyStatementShape($query, $bindings, 'log'),
+        ];
+
+        \Closure::bind(function ($query, $bindings, $time) {
+            $this->totalQueryDuration += $time ?? 0.0;
+
+            $this->event(new \Illuminate\Database\Events\QueryExecuted($query, $bindings, $time, $this));
+
+            $query = $this->pretending === true
+                ? $this->queryGrammar?->substituteBindingsIntoRawSql($query, $bindings) ?? $query
+                : $query;
+
+            if ($this->loggingQueries) {
+                $this->queryLog[] = compact('query', 'bindings', 'time');
+            }
+        }, $connection, Connection::class)($query, $bindings, $time);
+    }
+
+    public function selectOneOnConnection($connection, $query, $bindings = [], $useReadPdo = true)
+    {
+        $records = $this->selectOnConnection($connection, $query, $bindings, $useReadPdo);
+        $this->queryExecutionJournal[] = [
+            'operation' => 'select-one',
+            'name' => $connection->getName(),
+            'empty' => empty($records),
+        ];
+
+        return array_shift($records);
+    }
+
+    public function scalarOnConnection($connection, $query, $bindings = [], $useReadPdo = true)
+    {
+        $record = $this->selectOneOnConnection($connection, $query, $bindings, $useReadPdo);
+        $this->queryExecutionJournal[] = [
+            'operation' => 'scalar',
+            'name' => $connection->getName(),
+            'missing' => is_null($record),
+        ];
+
+        if (is_null($record)) {
+            return null;
+        }
+
+        $record = (array) $record;
+
+        if (count($record) > 1) {
+            throw new MultipleColumnsSelectedException;
+        }
+
+        return reset($record);
+    }
+
+    public function insertOnConnection($connection, $query, $bindings = [])
+    {
+        $this->queryExecutionJournal[] = [
+            'operation' => 'insert',
+            'name' => $connection->getName(),
+            'shape' => $this->classifyStatementShape($query, $bindings, 'insert'),
+        ];
+
+        return $this->statementOnConnection($connection, $query, $bindings);
+    }
+
+    public function updateOnConnection($connection, $query, $bindings = [])
+    {
+        $this->queryExecutionJournal[] = [
+            'operation' => 'update',
+            'name' => $connection->getName(),
+            'shape' => $this->classifyStatementShape($query, $bindings, 'update'),
+        ];
+
+        return $this->affectingStatementOnConnection($connection, $query, $bindings);
+    }
+
+    public function deleteOnConnection($connection, $query, $bindings = [])
+    {
+        $this->queryExecutionJournal[] = [
+            'operation' => 'delete',
+            'name' => $connection->getName(),
+            'shape' => $this->classifyStatementShape($query, $bindings, 'delete'),
