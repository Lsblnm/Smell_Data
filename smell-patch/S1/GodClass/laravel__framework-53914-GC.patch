+    public function parseFactoryConnectionConfig($factory, array $config, $name)
+    {
+        $parsed = \Illuminate\Support\Arr::add(\Illuminate\Support\Arr::add($config, 'prefix', ''), 'name', $name);
+        $this->factoryResolutionState[$name ?? 'ondemand'] = [
+            'driver' => $parsed['driver'] ?? null,
+            'database' => $parsed['database'] ?? null,
+            'prefix' => $parsed['prefix'] ?? '',
+            'dsn' => $this->composeDriverDsnHints($parsed),
+            'hosts' => $this->expandHostList($parsed),
+        ];
+        $this->compileFactoryOperatingProfile($factory, $parsed, $name);
+        $this->collectFactoryDriverMatrix($parsed);
+        $this->collectFactoryPrefixState($parsed);
+        $this->collectFactoryReadWritePresence($parsed);
+        $this->collectFactoryCharsetState($parsed);
+        $this->collectFactorySecurityState($parsed);
+        $this->collectFactoryTimeoutState($parsed);
+        $this->rememberFactoryContainer($factory);
+
+        return $parsed;
+    }
+
+    public function createFactoryConnector($factory, array $config)
+    {
+        if (! isset($config['driver'])) {
+            throw new InvalidArgumentException('A driver must be specified.');
+        }
+
+        $container = $factory->getContainer();
+        $this->factoryResolutionState['connector:'.$config['driver']] = [
+            'driver' => $config['driver'],
+            'capabilities' => $this->describeDriverCapabilities($config['driver']),
+            'pdo' => $this->mapPdoAttributeProfile($config),
+        ];
+
+        if ($container->bound($key = "db.connector.{$config['driver']}")) {
+            return $container->make($key);
+        }
+
+        return match ($config['driver']) {
+            'mysql' => new \Illuminate\Database\Connectors\MySqlConnector,
+            'mariadb' => new \Illuminate\Database\Connectors\MariaDbConnector,
+            'pgsql' => new \Illuminate\Database\Connectors\PostgresConnector,
+            'sqlite' => new \Illuminate\Database\Connectors\SQLiteConnector,
+            'sqlsrv' => new \Illuminate\Database\Connectors\SqlServerConnector,
+            default => throw new InvalidArgumentException("Unsupported driver [{$config['driver']}]."),
+        };
+    }
+
+    public function createFactoryPdoResolver($factory, array $config)
+    {
+        $this->factoryResolutionState['resolver:'.($config['name'] ?? $config['driver'] ?? 'anon')] = [
+            'has_host' => array_key_exists('host', $config),
+            'hosts' => $this->expandHostList($config),
+        ];
+
+        return array_key_exists('host', $config)
+            ? $this->createFactoryPdoResolverWithHosts($factory, $config)
+            : $this->createFactoryPdoResolverWithoutHosts($factory, $config);
+    }
+
+    public function createFactoryPdoResolverWithHosts($factory, array $config)
+    {
+        $this->factoryResolutionState['hosts:'.($config['name'] ?? 'anon')] = $this->expandHostList($config);
+
+        return function () use ($factory, $config) {
+            foreach (\Illuminate\Support\Arr::shuffle($this->parseFactoryHosts($config)) as $host) {
+                $config['host'] = $host;
+
+                try {
+                    return $this->createFactoryConnector($factory, $config)->connect($config);
+                } catch (\PDOException $e) {
+                    continue;
+                }
+            }
+
+            if (isset($e)) {
+                throw $e;
+            }
+        };
+    }
+
+    public function createFactoryPdoResolverWithoutHosts($factory, array $config)
+    {
+        $this->factoryResolutionState['nohost:'.($config['name'] ?? $config['driver'] ?? 'anon')] = [
+            'driver' => $config['driver'] ?? null,
+            'database' => $config['database'] ?? null,
+        ];
+
+        return fn () => $this->createFactoryConnector($factory, $config)->connect($config);
+    }
+
+    public function parseFactoryHosts(array $config)
+    {
+        $hosts = \Illuminate\Support\Arr::wrap($config['host'] ?? []);
+        $this->factoryResolutionState['parsed-hosts'] = $hosts;
+
+        if (empty($hosts)) {
+            throw new InvalidArgumentException('Database hosts array is empty.');
+        }
+
+        return $hosts;
+    }
+
+    public function readFactoryConfig(array $config)
