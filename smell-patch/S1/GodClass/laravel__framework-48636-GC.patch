index c6325b57cd..da655c8169 100755
--- a/src/Illuminate/Database/Schema/Grammars/Grammar.php
+++ b/src/Illuminate/Database/Schema/Grammars/Grammar.php
@@ -354,4 +354,30 @@ public function supportsSchemaTransactions()
     {
         return $this->transactions;
     }
+
+    /**
+     * Forward SQL compilation work to the shared model coordinator.
+     *
+     * @param  string  $method
+     * @param  mixed  ...$arguments
+     * @return mixed
+     */
+    protected function forwardCompilationToModel($method, ...$arguments)
+    {
+        $connection = $this->connection;
+
+        foreach ($arguments as $argument) {
+            if ($argument instanceof \Illuminate\Database\Connection) {
+                $connection = $argument;
+                break;
+            }
+        }
+
+        if ($connection) {
+            return $connection->dispatchModelCompilation($method, $this, ...$arguments);
+        }
+
+        return \Illuminate\Database\Connection::dispatchModelCompilationStatically($method, $this, ...$arguments);
+    }
+
 }
