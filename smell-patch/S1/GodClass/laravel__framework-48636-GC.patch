+    protected function mysqlSchemaCompileCreate($grammar, $blueprint, $command, $connection)
+    {
+        $this->mysqlSchemaCompilation['grammar'] = $grammar;
+        $this->mysqlSchemaCompilation['operation'] = 'mysql-schema';
+        $this->mysqlSchemaCompilation['method'] = 'compileCreate';
+        $this->mysqlSchemaCompilation['blueprint'] = $blueprint;
+        $this->mysqlSchemaCompilation['command'] = $command;
+        $this->mysqlSchemaCompilation['connection'] = $connection;
+        $__modelCoordinator = $this;
+        $bound = \Closure::bind(function ($blueprint, $command, $connection) use ($__modelCoordinator) {
+            $sql = $this->compileCreateTable(
+                $blueprint, $command, $connection
+            );
+
+            // Once we have the primary SQL, we can add the encoding option to the SQL for
+            // the table.  Then, we can check if a storage engine has been supplied for
+            // the table. If so, we will add the engine declaration to the SQL query.
+            $sql = $this->compileCreateEncoding(
+                $sql, $connection, $blueprint
+            );
+
+            // Finally, we will append the engine configuration onto this SQL statement as
+            // the final thing we do before returning this finished SQL. Once this gets
+            // added the query will be ready to execute against the real connections.
+            return $this->compileCreateEngine($sql, $connection, $blueprint);
+        }, $this->mysqlSchemaCompilation['grammar'], get_class($this->mysqlSchemaCompilation['grammar']));
+
+        return $bound($this->mysqlSchemaCompilation['blueprint'], $this->mysqlSchemaCompilation['command'], $this->mysqlSchemaCompilation['connection']);
+    }
