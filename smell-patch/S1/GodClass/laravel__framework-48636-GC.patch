+                $blueprint->temporary ? 'create temporary' : 'create',
+                $this->wrapTable($blueprint),
+                implode(', ', $this->getColumns($blueprint))
+            );
+        }, $this->mysqlSchemaCompilation['grammar'], get_class($this->mysqlSchemaCompilation['grammar']));
