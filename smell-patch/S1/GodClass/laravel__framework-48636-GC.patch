+            if (! $connection->usingNativeSchemaOperations()) {
+                return $__modelCoordinator->callParentGrammarMethod($this, 'compileChange', $blueprint, $command, $connection);
+            }
+
+            $columns = [];
+
+            foreach ($blueprint->getChangedColumns() as $column) {
