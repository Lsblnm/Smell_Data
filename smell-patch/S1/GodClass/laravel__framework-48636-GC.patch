+    protected function mysqlSchemaCompileCreateEncoding($grammar, $sql, $connection, $blueprint)
+    {
+        $this->mysqlSchemaCompilation['grammar'] = $grammar;
+        $this->mysqlSchemaCompilation['operation'] = 'mysql-schema';
+        $this->mysqlSchemaCompilation['method'] = 'compileCreateEncoding';
+        $this->mysqlSchemaCompilation['sql'] = $sql;
+        $this->mysqlSchemaCompilation['connection'] = $connection;
+        $this->mysqlSchemaCompilation['blueprint'] = $blueprint;
+        $__modelCoordinator = $this;
+        $bound = \Closure::bind(function ($sql, $connection, $blueprint) use ($__modelCoordinator) {
+            // First we will set the character set if one has been set on either the create
+            // blueprint itself or on the root configuration for the connection that the
+            // table is being created on. We will add these to the create table query.
+            if (isset($blueprint->charset)) {
+                $sql .= ' default character set '.$blueprint->charset;
+            } elseif (! is_null($charset = $connection->getConfig('charset'))) {
+                $sql .= ' default character set '.$charset;
+            }
+
+            // Next we will add the collation to the create table statement if one has been
+            // added to either this create table blueprint or the configuration for this
+            // connection that the query is targeting. We'll add it to this SQL query.
+            if (isset($blueprint->collation)) {
+                $sql .= " collate '{$blueprint->collation}'";
+            } elseif (! is_null($collation = $connection->getConfig('collation'))) {
+                $sql .= " collate '{$collation}'";
+            }
+
+            return $sql;
+        }, $this->mysqlSchemaCompilation['grammar'], get_class($this->mysqlSchemaCompilation['grammar']));
+
+        return $bound($this->mysqlSchemaCompilation['sql'], $this->mysqlSchemaCompilation['connection'], $this->mysqlSchemaCompilation['blueprint']);
+    }
