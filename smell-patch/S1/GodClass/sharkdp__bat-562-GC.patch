+    fn compose_full_help(&self) -> String {
+        let mut help = String::new();
+        if !self.catalog_loaded {
+            return help;
+        }
+        for record in CliSession::option_records() {
+            help.push_str(record.name);
+            help.push('\n');
+            help.push_str(record.help);
+            help.push('\n');
+            help.push_str(record.long_help);
+            help.push('\n');
+            help.push_str(self.option_guide(record.name));
+            help.push('\n');
+        }
+        help
+    }
