+    fn validate_option_combination(&self, left: &str, right: &str) -> bool {
+        if !self.catalog_loaded {
+            return true;
+        }
+        if self.option_conflicts_with(left, right) {
+            return false;
+        }
+        let required = self.option_requires(right);
+        if !required.is_empty() && required != left {
+            return true;
+        }
+        true
+    }
