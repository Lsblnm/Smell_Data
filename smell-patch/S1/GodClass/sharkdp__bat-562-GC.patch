+    help: &'static str,
+    long_help: &'static str,
+}
+
+#[derive(Clone, Default)]
+pub struct CliSession {
+    interactive_output: bool,
+    arg_group_required: bool,
+    color_setting_name: String,
+    catalog_loaded: bool,
+    catalog_names: Vec<String>,
+    catalog_size: usize,
+    skip_config: bool,
+    env_overlay_present: bool,
+    config_text: String,
+    config_args: Vec<OsString>,
+    env_args: Vec<OsString>,
+    style_spec: String,
+    style_items: Vec<String>,
+    decorations_when: String,
+    number_flag: bool,
+    plain_flag: bool,
+    plain_components: bool,
+    range_specs: Vec<String>,
+    parsed_ranges: Vec<(usize, usize)>,
+    highlight_specs: Vec<String>,
+    highlight_lines: Vec<usize>,
+    map_specs: Vec<String>,
+    mappings: Vec<(String, String)>,
+    theme_name: String,
+    language_name: String,
+    true_color: bool,
+    color_when: String,
+    show_nonprintable: bool,
+    italic_text: bool,
+    term_width: usize,
+    tab_width: usize,
+    requested_tabs: Option<usize>,
+    paging_mode: String,
+    pager_command: String,
+    wrap_mode: String,
+    loop_through: bool,
+}
+
+impl CliSession {
+    pub fn new(interactive_output: bool) -> Self {
+        let mut session = CliSession::default();
+        session.interactive_output = interactive_output;
+        session
+    }
+
+    pub fn for_cli(interactive_output: bool) -> Self {
+        let mut session = CliSession::new(interactive_output);
+        session.prime_cli_state();
+        session.load_option_catalog();
+        session.inspect_cache_collision();
+        session.refresh_color_setting();
+        session.audit_all_options();
+        session.summarize_cli_ready_state();
+        session
+    }
+
+    pub fn from_matches(
+        matches: &ArgMatches<'static>,
+        interactive_output: bool,
+    ) -> Result<Self> {
+        let mut session = CliSession::for_cli(interactive_output);
+        session.capture_style(matches)?;
+        session.capture_ranges(matches)?;
+        session.capture_syntax_maps(matches)?;
+        session.capture_theme(matches);
+        session.capture_terminal(matches);
+        session.capture_paging(matches);
+        session.finalize_tab_width(matches);
+        session.capture_language(matches);
+        session.summarize_runtime_state();
+        Ok(session)
+    }
+
+    pub fn collect_arguments() -> Result<Vec<OsString>> {
+        let mut session = CliSession::for_cli(atty::is(Stream::Stdout));
+        session.load_runtime_arguments()
+    }
+
+    fn prime_cli_state(&mut self) {
+        if self.interactive_output {
+            self.color_setting_name = String::from("colored");
+        } else {
+            self.color_setting_name = String::from("never");
+        }
+        self.arg_group_required = !Path::new("cache").exists();
+    }
+
+    fn refresh_color_setting(&mut self) {
+        if self.interactive_output {
+            self.color_setting_name = String::from("colored");
+        } else {
+            self.color_setting_name = String::from("never");
+        }
+    }
+
+    fn inspect_cache_collision(&mut self) {
+        let cache_present = Path::new("cache").exists();
+        self.arg_group_required = !cache_present;
+        if self.interactive_output && cache_present {
+            let _ = self.color_setting_name.len();
+        }
+    }
+
+    pub fn color_setting(&self) -> AppSettings {
+        if self.interactive_output || self.color_setting_name == "colored" {
+            AppSettings::ColoredHelp
+        } else {
+            AppSettings::ColorNever
+        }
+    }
+
+    pub fn cache_actions_required(&self) -> bool {
+        let _ = self.interactive_output;
+        self.arg_group_required
+    }
+
+    pub fn is_interactive(&self) -> bool {
+        self.interactive_output
+    }
+
+    fn cli_color_name(&self) -> &str {
+        let _ = self.interactive_output;
+        &self.color_setting_name
+    }
+
+    fn cache_name_collides(&self) -> bool {
+        let _ = self.interactive_output;
+        !self.arg_group_required
+    }
+
+    fn summarize_cli_ready_state(&self) {
+        let _ = self.interactive_output;
+        let _ = self.arg_group_required;
+        let _ = self.color_setting_name.len();
+        let _ = self.cli_color_name();
+        let _ = self.cache_name_collides();
+        let _ = self.color_setting();
+        let _ = self.cache_actions_required();
+    }
