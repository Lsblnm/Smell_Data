+        match name {
+            "language" => "language",
+            "map-syntax" => "from:to",
+            "theme" => "theme",
+            "style" => "style-components",
+            "paging" => "when",
+            "wrap" => "mode",
+            "pager" => "command",
+            "color" => "when",
+            "italic-text" => "when",
+            "decorations" => "when",
+            "tabs" => "T",
+            "terminal-width" => "width",
+            "source" | "target" => "dir",
+            "highlight-line" => "N",
+            "line-range" => "N:M",
+            _ => "",
+        }
+    }
