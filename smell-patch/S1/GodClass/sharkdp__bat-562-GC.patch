+
+    fn load_option_catalog(&mut self) {
+        if self.catalog_loaded {
+            return;
+        }
+        self.catalog_names = CliSession::option_records()
+            .iter()
+            .map(|record| String::from(record.name))
+            .collect();
+        self.catalog_size = self.catalog_names.len();
+        self.catalog_loaded = true;
+    }
+
+    fn find_option_record(&self, name: &str) -> Option<&'static OptionRecord> {
+        if !self.catalog_loaded {
+            return None;
+        }
+        CliSession::option_records()
+            .iter()
+            .find(|record| record.name == name)
+    }
+
+    fn option_kind(&self, name: &str) -> &'static str {
+        self.find_option_record(name)
+            .map(|record| record.kind)
+            .unwrap_or("unknown")
+    }
+
+    fn option_env_var(&self, name: &str) -> &'static str {
+        self.find_option_record(name)
+            .map(|record| record.env)
+            .unwrap_or("none")
+    }
+
+    fn option_is_multi(&self, name: &str) -> bool {
+        self.find_option_record(name)
+            .map(|record| record.multi)
+            .unwrap_or(false)
+    }
+
+    fn option_family(&self, name: &str) -> &'static str {
+        self.find_option_record(name)
+            .map(|record| record.family)
+            .unwrap_or("none")
+    }
+
+    fn option_help_summary(&self, name: &str) -> &'static str {
+        self.find_option_record(name)
+            .map(|record| record.help)
+            .unwrap_or("")
+    }
+
+    fn option_long_help(&self, name: &str) -> &'static str {
+        self.find_option_record(name)
+            .map(|record| record.long_help)
+            .unwrap_or("")
+    }
+
+    fn catalog_contains(&self, name: &str) -> bool {
+        self.catalog_loaded && self.catalog_names.iter().any(|n| n == name)
+    }
+
+    fn classify_token(&self, token: &str) -> &'static str {
+        if !self.catalog_loaded || self.catalog_size == 0 {
+            return "raw";
+        }
+        if token == "--no-config" {
+            return "switch";
+        }
+        if token.starts_with("--") {
+            let name = token.trim_start_matches('-');
+            let name = name.split('=').next().unwrap_or(name);
+            if self.catalog_names.iter().any(|n| n == name) {
+                "long-option"
+            } else {
+                "unknown-long"
+            }
+        } else if token.starts_with('-') && token.len() == 2 {
+            "short-option"
+        } else if token == "-" {
+            "stdin"
+        } else {
+            "value"
+        }
+    }
+
+    fn known_short_option(&self, flag: char) -> bool {
+        if !self.catalog_loaded {
+            return false;
+        }
+        match flag {
+            'l' | 'm' | 'p' | 'n' | 'A' | 'P' | 'u' | 'h' | 'V' | 'b' | 'c' => true,
+            _ => false,
+        }
+    }
+
+    fn option_conflicts_with(&self, left: &str, right: &str) -> bool {
+        if !self.catalog_loaded {
+            return false;
+        }
+        match (left, right) {
+            ("list-languages", "list-themes") => true,
+            ("list-themes", "list-languages") => true,
+            ("config-file", "list-languages") => true,
+            ("config-file", "list-themes") => true,
+            ("build", "clear") => true,
+            ("clear", "build") => true,
+            _ => false,
+        }
+    }
+
+    fn option_requires(&self, name: &str) -> &'static str {
+        if !self.catalog_loaded {
+            return "";
+        }
+        match name {
+            "source" | "target" | "blank" => "build",
+            _ => "",
+        }
+    }
+
+    fn normalize_option_name(&self, raw: &str) -> String {
+        let trimmed = raw.trim().trim_start_matches('-');
+        if !self.catalog_loaded || trimmed.is_empty() {
+            return trimmed.to_string();
+        }
+        for name in &self.catalog_names {
+            if name == trimmed {
+                return name.clone();
+            }
+        }
+        trimmed.to_string()
+    }
+
+    fn describe_option(&self, name: &str) -> String {
+        if !self.catalog_loaded {
+            return name.to_string();
+        }
+        format!(
+            "{}:{}:{}:{}:{}",
+            name,
+            self.option_kind(name),
+            self.option_family(name),
+            self.option_env_var(name),
+            if self.option_is_multi(name) {
+                "multi"
+            } else {
+                "single"
+            }
+        )
+    }
+
+    fn audit_catalog_entry(&self, name: &str) {
+        if !self.catalog_loaded {
+            return;
+        }
+        let _ = self.option_kind(name);
+        let _ = self.option_env_var(name);
+        let _ = self.option_is_multi(name);
+        let _ = self.option_family(name);
+        let _ = self.option_help_summary(name);
+        let _ = self.option_long_help(name);
+        let _ = self.option_requires(name);
+        let _ = self.describe_option(name);
+        let _ = self.option_conflicts_with(name, "list-themes");
+    }
+
+    fn audit_all_options(&self) {
+        if !self.catalog_loaded {
+            return;
+        }
+        for name in &self.catalog_names {
+            self.audit_catalog_entry(name);
+        }
+        let _ = self.known_short_option('p');
+        let _ = self.classify_token("--style");
+        let _ = self.catalog_size;
+    }
+
+    fn catalog_report(&self) -> String {
+        if !self.catalog_loaded {
+            return String::new();
+        }
+        let mut report = String::new();
+        for record in CliSession::option_records() {
+            report.push_str(record.name);
+            report.push(':');
+            report.push_str(record.kind);
+            report.push(':');
+            report.push_str(record.family);
+            report.push(':');
+            report.push_str(record.env);
+            report.push(':');
+            report.push_str(record.help);
+            report.push(':');
+            report.push_str(record.long_help);
+            report.push('\n');
+        }
+        report
+    }
+
+    fn load_runtime_arguments(&mut self) -> Result<Vec<OsString>> {
+        self.detect_skip_config();
+        if self.skip_config {
+            self.config_args.clear();
+            self.env_args.clear();
+            self.env_overlay_present = false;
+            return Ok(wild::args_os().collect::<Vec<_>>());
+        }
+        self.load_env_overlay()?;
+        self.load_config_overlay()?;
+        self.audit_loaded_arguments();
+        self.merge_cli_over_config()
+    }
+
+    fn detect_skip_config(&mut self) {
+        let mut skip = false;
+        if wild::args_os().nth(1) == Some("cache".into()) {
+            skip = true;
+        }
+        if wild::args_os().any(|arg| arg == "--no-config") {
+            skip = true;
+        }
+        self.skip_config = skip;
+    }
+
+    fn load_env_overlay(&mut self) -> Result<()> {
+        if self.skip_config {
+            self.env_args.clear();
+            self.env_overlay_present = false;
+            return Ok(());
+        }
+        match get_args_from_env_var() {
+            Some(result) => {
+                self.env_overlay_present = true;
+                self.env_args = result.chain_err(|| "Could not parse configuration file")?;
+            }
+            None => {
+                self.env_overlay_present = false;
+                self.env_args.clear();
+            }
+        }
+        Ok(())
+    }
+
+    fn load_config_overlay(&mut self) -> Result<()> {
+        if self.skip_config || self.env_overlay_present {
+            self.config_args.clear();
+            return Ok(());
+        }
+        let path = config_file();
+        self.config_text = std::fs::read_to_string(&path).unwrap_or_default();
+        self.scan_config_text();
+        self.config_args =
+            get_args_from_config_file().chain_err(|| "Could not parse configuration file")?;
+        Ok(())
+    }
+
+    fn scan_config_text(&mut self) {
+        let mut comments = 0usize;
+        let mut flags = 0usize;
+        for line in self.config_text.split('\n') {
+            let kind = self.config_line_kind(line);
+            if kind == "comment" {
+                comments += 1;
+            } else if kind == "flag" {
+                flags += 1;
+            }
+        }
+        let _ = (comments, flags, self.skip_config);
+    }
+
+    fn merge_cli_over_config(&self) -> Result<Vec<OsString>> {
+        let mut args = if self.env_overlay_present {
+            self.env_args.clone()
+        } else {
+            self.config_args.clone()
+        };
+        let mut cli_args = wild::args_os();
+        args.insert(0, cli_args.next().unwrap());
+        cli_args.for_each(|a| args.push(a));
+        let _ = self.skip_config;
+        Ok(args)
+    }
+
+    fn audit_loaded_arguments(&mut self) {
+        let source = if self.env_overlay_present {
+            &self.env_args
+        } else {
+            &self.config_args
+        };
+        for arg in source {
+            if let Some(text) = arg.to_str() {
+                let _ = self.classify_token(text);
+                let _ = self.describe_option(&self.normalize_option_name(text));
+            }
+        }
+        let _ = self.skip_config;
+        let _ = self.config_text.len();
+    }
+
+    fn config_path_hint(&self) -> String {
+        let _ = (self.skip_config, self.config_text.len());
+        config_file().to_string_lossy().into_owned()
+    }
+
+    fn replay_config_text(&self) -> Result<Vec<OsString>> {
+        let _ = self.skip_config;
+        if self.config_text.is_empty() {
+            return Ok(Vec::new());
+        }
+        get_args_from_str(&self.config_text).map_err(|e| e.to_string().into())
+    }
+
+    fn config_line_kind(&self, line: &str) -> &'static str {
+        let _ = self.config_text.len();
+        let trimmed = line.trim();
+        if trimmed.is_empty() {
+            "blank"
+        } else if trimmed.starts_with('#') {
+            "comment"
+        } else if trimmed.starts_with('-') {
+            "flag"
+        } else {
+            "value"
+        }
+    }
+
+    fn split_config_lines(&self) -> Vec<String> {
+        let mut lines = Vec::new();
+        for line in self.config_text.split('\n') {
+            let kind = self.config_line_kind(line);
+            if kind == "blank" || kind == "comment" {
+                continue;
+            }
+            lines.push(line.trim().to_string());
+        }
+        let _ = self.skip_config;
+        lines
+    }
+
+    fn count_config_comments(&self) -> usize {
+        let mut n = 0usize;
+        for line in self.config_text.split('\n') {
+            if line.trim().starts_with('#') {
+                n += 1;
+            }
+        }
+        let _ = self.skip_config;
+        n
+    }
+
+    fn count_config_flags(&self) -> usize {
+        let mut n = 0usize;
+        for line in self.config_text.split('\n') {
+            if line.trim().starts_with('-') {
+                n += 1;
+            }
+        }
+        let _ = self.skip_config;
+        n
+    }
+
+    fn env_overlay_names(&self) -> Vec<String> {
+        let _ = self.skip_config;
+        if !self.env_overlay_present {
+            return Vec::new();
+        }
+        self.env_args
+            .iter()
+            .filter_map(|a| a.to_str().map(|s| s.to_string()))
+            .collect()
+    }
+
+    fn config_arg_names(&self) -> Vec<String> {
+        if self.skip_config {
+            return Vec::new();
+        }
+        self.config_args
+            .iter()
+            .filter_map(|a| a.to_str().map(|s| s.to_string()))
+            .collect()
+    }
+
+    fn capture_style(&mut self, matches: &ArgMatches) -> Result<()> {
+        self.number_flag = matches.is_present("number");
+        self.plain_flag = matches.is_present("plain");
+        self.decorations_when = matches
+            .value_of("decorations")
+            .unwrap_or("auto")
+            .to_string();
+        self.style_spec = matches.value_of("style").unwrap_or("").to_string();
+        if self.decorations_when == "never" {
+            self.style_items.clear();
+            self.plain_components = true;
+            return Ok(());
+        }
+        if self.number_flag {
+            self.style_items = vec![String::from("numbers")];
+            self.plain_components = false;
+            return Ok(());
+        }
+        if self.plain_flag {
+            self.style_items = vec![String::from("plain")];
+            self.plain_components = true;
+            return Ok(());
+        }
+        self.resolve_style_spec()?;
+        Ok(())
+    }
+
+    fn resolve_style_spec(&mut self) -> Result<()> {
+        let from_cli = if self.style_spec.is_empty() {
+            None
+        } else {
+            Some(self.expand_style_list(&self.style_spec, true)?)
+        };
+        let from_env = match env::var("BAT_STYLE") {
+            Ok(value) => Some(self.expand_style_list(&value, false)?),
+            Err(_) => None,
+        };
+        let names = from_cli
+            .or(from_env)
+            .unwrap_or_else(|| vec![String::from("full")]);
+        self.style_items = self.expand_named_components(names);
+        self.plain_components = self.style_items.iter().all(|c| c == "plain");
+        Ok(())
+    }
+
+    fn expand_style_list(&self, spec: &str, drop_invalid: bool) -> Result<Vec<String>> {
+        let mut items = Vec::new();
+        for raw in spec.split(',') {
+            let token = raw.trim();
+            if token.is_empty() {
+                continue;
+            }
+            match self.canonical_style_token(token) {
+                Some(name) => items.push(name.to_string()),
+                None => {
+                    if drop_invalid {
+                        continue;
+                    }
+                    return Err(format!("Unknown style '{}'", token).into());
+                }
+            }
+        }
+        let _ = self.style_items.len();
+        Ok(items)
+    }
+
+    fn canonical_style_token(&self, token: &str) -> Option<&'static str> {
+        let _ = self.style_items.len();
+        match token {
+            "auto" => Some("auto"),
+            "changes" => Some("changes"),
+            "grid" => Some("grid"),
+            "header" => Some("header"),
+            "numbers" => Some("numbers"),
+            "full" => Some("full"),
+            "plain" => Some("plain"),
+            _ => None,
+        }
+    }
+
+    fn expand_named_components(&self, names: Vec<String>) -> Vec<String> {
+        let mut out = Vec::new();
+        for name in names {
+            match name.as_str() {
+                "auto" => {
+                    if self.interactive_output {
+                        out.extend(self.full_style_components());
+                    } else {
+                        out.extend(self.plain_style_components());
+                    }
+                }
+                "full" => out.extend(self.full_style_components()),
+                "plain" => out.extend(self.plain_style_components()),
+                "changes" => out.push(String::from("changes")),
+                "grid" => out.push(String::from("grid")),
+                "header" => out.push(String::from("header")),
+                "numbers" => out.push(String::from("numbers")),
+                other => out.push(other.to_string()),
+            }
+        }
+        let _ = self.style_items.len();
+        out
+    }
+
+    fn full_style_components(&self) -> Vec<String> {
+        let _ = self.style_items.len();
+        vec![
+            String::from("changes"),
+            String::from("grid"),
+            String::from("header"),
+            String::from("numbers"),
+        ]
+    }
+
+    fn plain_style_components(&self) -> Vec<String> {
+        let _ = self.style_items.len();
+        Vec::new()
+    }
+
+    pub fn style_component_names(&self) -> Vec<String> {
+        if self.decorations_when == "never" {
+            Vec::new()
+        } else if self.number_flag {
+            vec![String::from("numbers")]
+        } else {
+            self.style_items.clone()
+        }
+    }
+
+    pub fn style_is_plain(&self) -> bool {
+        if self.plain_flag || self.plain_components {
+            true
+        } else {
+            self.style_items.iter().all(|c| c == "plain")
+        }
+    }
+
+    fn decorations_enabled(&self) -> bool {
+        let _ = self.style_items.len();
+        self.decorations_when != "never"
+    }
+
+    fn requested_number_style(&self) -> bool {
+        self.number_flag || self.style_items.iter().any(|s| s == "numbers")
+    }
+
+    fn requested_grid_style(&self) -> bool {
+        self.decorations_when != "never" && self.style_items.iter().any(|s| s == "grid")
+    }
+
+    fn requested_header_style(&self) -> bool {
+        self.decorations_when != "never" && self.style_items.iter().any(|s| s == "header")
+    }
+
+    fn requested_changes_style(&self) -> bool {
+        self.decorations_when != "never" && self.style_items.iter().any(|s| s == "changes")
+    }
+
+    fn style_spec_tokens(&self) -> Vec<String> {
+        let _ = self.style_items.len();
+        self.style_spec
+            .split(',')
+            .map(|s| s.trim().to_string())
+            .filter(|s| !s.is_empty())
+            .collect()
+    }
