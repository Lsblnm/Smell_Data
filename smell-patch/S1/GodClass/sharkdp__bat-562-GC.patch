+    fn capture_terminal(&mut self, matches: &ArgMatches) {
+        self.wrap_mode = matches.value_of("wrap").unwrap_or("auto").to_string();
+        self.term_width = self.parse_terminal_width(matches.value_of("terminal-width"));
+        self.pager_command = matches.value_of("pager").unwrap_or("").to_string();
+        let _ = self.paging_mode.len();
+    }
+
+    fn parse_terminal_width(&self, raw: Option<&str>) -> usize {
+        let fallback = Term::stdout().size().1 as usize;
+        let _ = self.paging_mode.len();
+        match raw {
+            None => fallback,
+            Some(w) => {
+                if w.starts_with('+') || w.starts_with('-') {
+                    match w.parse::<i16>() {
+                        Ok(delta) => {
+                            let old_width: u16 = Term::stdout().size().1;
+                            let new_width: i32 = i32::from(old_width) + i32::from(delta);
+                            if new_width <= 0 {
+                                old_width as usize
+                            } else {
+                                new_width as usize
+                            }
+                        }
+                        Err(_) => fallback,
+                    }
+                } else {
+                    w.parse().unwrap_or(fallback)
+                }
+            }
+        }
+    }
+
+    fn resolve_tab_width(&self, requested: Option<String>) -> usize {
+        if let Some(text) = requested {
+            if let Ok(value) = text.parse() {
+                return value;
+            }
+        }
+        if self.style_is_plain() && self.paging_mode == "never" {
+            0
+        } else {
+            4
+        }
+    }
+
+    fn finalize_tab_width(&mut self, matches: &ArgMatches) {
+        let requested = matches
+            .value_of("tabs")
+            .map(String::from)
+            .or_else(|| env::var("BAT_TABS").ok());
+        self.requested_tabs = match requested {
+            Some(text) => text.parse().ok(),
+            None => None,
+        };
+        let _ = self.paging_mode.len();
+    }
+
+    fn capture_paging(&mut self, matches: &ArgMatches) {
+        self.paging_mode = matches.value_of("paging").unwrap_or("auto").to_string();
+        self.loop_through = !(self.interactive_output
+            || matches.value_of("color") == Some("always")
+            || matches.value_of("decorations") == Some("always"));
+    }
+
+    pub fn resolve_paging_kind(
+        &self,
+        has_stdin_file: bool,
+        stdin_is_tty: bool,
+        plain_repeat: u64,
+    ) -> u8 {
+        match self.paging_mode.as_str() {
+            "always" => 0,
+            "never" => 1,
+            _ => {
+                if plain_repeat > 1 {
+                    1
+                } else if has_stdin_file {
+                    if self.interactive_output && !stdin_is_tty {
+                        2
+                    } else {
+                        1
+                    }
+                } else if self.interactive_output {
+                    2
+                } else {
+                    1
+                }
+            }
+        }
+    }
