+        if !self.catalog_loaded {
+            return &[];
+        }
+        match name {
+            "paging" => &["auto", "never", "always"],
+            "wrap" => &["auto", "never", "character"],
+            "color" => &["auto", "never", "always"],
+            "italic-text" => &["always", "never"],
+            "decorations" => &["auto", "never", "always"],
+            "style" => &["auto", "full", "plain", "changes", "header", "grid", "numbers"],
+            _ => &[],
+        }
+    }
+
+    fn style_component_rank(&self, name: &str) -> u8 {
+        let _ = self.style_items.len();
+        match name {
+            "changes" => 1,
+            "grid" => 2,
+            "header" => 3,
+            "numbers" => 4,
+            "plain" => 5,
+            "full" => 6,
+            "auto" => 7,
+            _ => 0,
+        }
+    }
+
+    fn paging_reason(&self) -> &'static str {
+        match self.paging_mode.as_str() {
+            "always" => "forced",
+            "never" => "disabled",
+            "auto" => "terminal-auto",
+            _ => "terminal-auto",
+        }
+    }
+
+    fn wrap_reason(&self) -> &'static str {
+        let _ = self.paging_mode.len();
+        match self.wrap_mode.as_str() {
+            "character" => "explicit-character",
+            "never" => "explicit-never",
+            "auto" => "auto",
+            _ => "auto",
+        }
+    }
+
+    fn color_reason(&self) -> &'static str {
+        let _ = self.theme_name.len();
+        match self.color_when.as_str() {
+            "always" => "forced",
+            "never" => "disabled",
+            "auto" => "terminal-auto",
+            _ => "terminal-auto",
+        }
+    }
+
+    fn range_kind(&self, spec: &str) -> &'static str {
+        let _ = self.parsed_ranges.len();
+        if spec.starts_with(':') {
+            "open-low"
+        } else if spec.ends_with(':') {
+            "open-high"
+        } else if spec.contains(':') {
+            "closed"
+        } else {
+            "invalid"
+        }
+    }
+
+    fn mapping_kind(&self, spec: &str) -> &'static str {
+        let _ = self.mappings.len();
+        if spec.starts_with('.') {
+            "filename"
+        } else if spec.contains('/') {
+            "path"
+        } else if spec.contains(':') {
+            "extension"
+        } else {
+            "unknown"
+        }
+    }
+
+    fn language_source_kind(&self) -> &'static str {
+        let _ = self.theme_name.len();
+        if self.language_name.is_empty() {
+            "detect"
+        } else if self.language_name == "show-nonprintable" {
+            "nonprintable"
+        } else {
+            "explicit"
+        }
+    }
+
+    fn config_source_kind(&self) -> &'static str {
+        if self.skip_config {
+            "skipped"
+        } else if self.env_overlay_present {
+            "env"
+        } else if self.config_args.is_empty() {
+            "empty-file"
+        } else {
+            "file"
+        }
+    }
+
+    fn italic_policy(&self) -> &'static str {
+        let _ = self.theme_name.len();
+        if self.italic_text {
+            "always"
+        } else {
+            "never"
+        }
+    }
+
+    fn nonprintable_policy(&self) -> &'static str {
+        let _ = self.theme_name.len();
+        if self.show_nonprintable {
+            "show"
+        } else {
+            "hide"
+        }
+    }
+
+    fn decoration_policy(&self) -> &'static str {
+        let _ = self.style_items.len();
+        match self.decorations_when.as_str() {
+            "never" => "hidden",
+            "always" => "forced",
+            "auto" => "style-driven",
+            _ => "style-driven",
+        }
+    }
+
+    fn tab_policy(&self) -> &'static str {
+        match (self.requested_tabs, self.tab_width, self.paging_mode.as_str()) {
+            (Some(0), _, _) => "passthrough-explicit",
+            (Some(_), _, _) => "explicit",
+            (None, 0, "never") => "passthrough-plain",
+            (None, _, "always") => "default-paged",
+            (None, _, "auto") => "default-auto",
+            (None, _, "never") => "default-never",
+            _ => "default",
+        }
+    }
+
+    fn cache_action_policy(&self) -> &'static str {
+        if !self.catalog_loaded {
+            return "unknown";
+        }
+        if self.arg_group_required {
+            "required"
+        } else {
+            "optional"
+        }
+    }
+
+    fn help_color_policy(&self) -> &'static str {
+        match (self.interactive_output, self.color_setting_name.as_str()) {
+            (true, _) => "colored",
+            (false, "colored") => "colored",
+            (false, "never") => "plain",
+            _ => "plain",
+        }
+    }
