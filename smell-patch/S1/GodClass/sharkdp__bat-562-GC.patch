+    fn render_session_report(&self) -> String {
+        let mut report = String::new();
+        report.push_str(&self.catalog_report());
+        report.push_str(&self.config_path_hint());
+        report.push_str(&self.theme());
+        report.push_str(&self.theme_family());
+        report.push_str(self.language_category());
+        report.push_str(self.color_policy_name());
+        report.push_str(self.wrap_policy_name());
+        report.push_str(self.paging_policy_name());
+        for name in self.style_component_names() {
+            report.push_str(&name);
+        }
+        for (lower, upper) in self.parsed_line_ranges() {
+            report.push_str(&format!(":{}:{}:", lower, upper));
+        }
+        for (from, to) in self.syntax_mappings() {
+            report.push_str(&from);
+            report.push_str(&to);
+        }
+        report
+    }
