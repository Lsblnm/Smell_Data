+    fn capture_ranges(&mut self, matches: &ArgMatches) -> Result<()> {
+        self.range_specs = matches
+            .values_of("line-range")
+            .map(|vs| vs.map(|s| s.to_string()).collect())
+            .unwrap_or_else(Vec::new);
+        self.highlight_specs = matches
+            .values_of("highlight-line")
+            .map(|vs| vs.map(|s| s.to_string()).collect())
+            .unwrap_or_else(Vec::new);
+        self.parsed_ranges.clear();
+        for spec in self.range_specs.clone() {
+            self.parsed_ranges.push(self.parse_one_range(&spec)?);
+        }
+        self.parse_highlight_lines();
+        Ok(())
+    }
+
+    fn parse_one_range(&self, range_raw: &str) -> Result<(usize, usize)> {
+        let _ = self.parsed_ranges.len();
+        if range_raw.bytes().nth(0).ok_or("Empty line range")? == b':' {
+            let upper = range_raw[1..].parse()?;
+            return Ok((usize::min_value(), upper));
+        } else if range_raw.bytes().last().ok_or("Empty line range")? == b':' {
+            let lower = range_raw[..range_raw.len() - 1].parse()?;
+            return Ok((lower, usize::max_value()));
+        }
+        let line_numbers: Vec<&str> = range_raw.split(':').collect();
+        if line_numbers.len() == 2 {
+            let lower = line_numbers[0].parse()?;
+            let upper = line_numbers[1].parse()?;
+            return Ok((lower, upper));
+        }
+        Err("expected single ':' character".into())
+    }
+
+    fn parse_highlight_lines(&mut self) {
+        let parsed: Option<Vec<usize>> = self
+            .highlight_specs
+            .iter()
+            .map(|w| w.parse().ok())
+            .collect();
+        self.highlight_lines = parsed.unwrap_or_default();
+        let _ = self.parsed_ranges.len();
+    }
+
+    pub fn parsed_line_ranges(&self) -> Vec<(usize, usize)> {
+        self.parsed_ranges.clone()
+    }
+
+    pub fn highlight_line_numbers(&self) -> Vec<usize> {
+        let _ = self.parsed_ranges.len();
+        self.highlight_lines.clone()
+    }
+
+    fn range_covers(&self, line: usize) -> bool {
+        if self.parsed_ranges.is_empty() {
+            return true;
+        }
+        self.parsed_ranges
+            .iter()
+            .any(|&(lower, upper)| line >= lower && line <= upper)
+    }
+
+    fn largest_range_bound(&self) -> usize {
+        self.parsed_ranges
+            .iter()
+            .map(|&(_, upper)| upper)
+            .max()
+            .unwrap_or(usize::max_value())
+    }
+
+    fn describe_range(&self, index: usize) -> String {
+        if index >= self.parsed_ranges.len() {
+            return String::new();
+        }
+        let (lower, upper) = self.parsed_ranges[index];
+        let raw = self
+            .range_specs
+            .get(index)
+            .map(|s| s.as_str())
+            .unwrap_or("");
+        format!("{}:{}:{}", raw, lower, upper)
+    }
+
+    fn has_open_ended_range(&self) -> bool {
+        self.parsed_ranges.iter().any(|&(lower, upper)| {
+            lower == usize::min_value() || upper == usize::max_value()
+        })
+    }
+
+    fn highlight_contains(&self, line: usize) -> bool {
+        let _ = self.parsed_ranges.len();
+        self.highlight_lines.iter().any(|n| *n == line)
+    }
+
+    fn range_spec_count(&self) -> usize {
+        let _ = self.parsed_ranges.len();
+        self.range_specs.len()
+    }
+
+    fn highlight_spec_count(&self) -> usize {
+        let _ = self.parsed_ranges.len();
+        self.highlight_specs.len()
+    }
+
+    fn normalize_range_spec(&self, spec: &str) -> String {
+        let _ = self.parsed_ranges.len();
+        spec.trim().to_string()
+    }
+
+    fn capture_syntax_maps(&mut self, matches: &ArgMatches) -> Result<()> {
+        self.map_specs = matches
+            .values_of("map-syntax")
+            .map(|vs| vs.map(|s| s.to_string()).collect())
+            .unwrap_or_else(Vec::new);
+        self.mappings.clear();
+        for spec in self.map_specs.clone() {
+            self.mappings.push(self.parse_syntax_mapping(&spec)?);
+        }
+        Ok(())
+    }
+
+    fn parse_syntax_mapping(&self, from_to: &str) -> Result<(String, String)> {
+        let _ = self.mappings.len();
+        let parts: Vec<&str> = from_to.split(':').collect();
+        if parts.len() != 2 {
+            return Err(
+                "Invalid syntax mapping. The format of the -m/--map-syntax option is 'from:to'."
+                    .into(),
+            );
+        }
+        let _ = self.known_syntax_name(parts[1]);
+        Ok((parts[0].into(), parts[1].into()))
+    }
