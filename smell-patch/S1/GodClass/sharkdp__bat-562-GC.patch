+                help: "Create completely new syntax and theme sets",
+                long_help: "Create completely new syntax and theme sets.",
+            },
+            OptionRecord {
+                name: "highlight-line",
+                kind: "option",
+                env: "none",
+                multi: true,
+                family: "range",
+                help: "Highlight the specified line",
+                long_help: "May be used multiple times.",
+            },
+            OptionRecord {
+                name: "line-range",
+                kind: "option",
+                env: "none",
+                multi: true,
+                family: "range",
+                help: "Only print the selected range of lines",
+                long_help: "Syntax N:M, N:, and :M are supported.",
+            },
+        ]
