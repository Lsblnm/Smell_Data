 module Fluent::Plugin
   class ForwardOutput < Output
+    def self.failure_detector_hard_timeout?(detector, now)
+      last = detector.instance_variable_get(:@last)
+      hard_timeout = detector.instance_variable_get(:@hard_timeout)
+      now - last > hard_timeout
+    end
+
+    def self.failure_detector_add(detector, now)
+      window = detector.instance_variable_get(:@window)
+      init_gap = detector.instance_variable_get(:@init_gap)
+      if window.empty?
+        window << init_gap
+        detector.instance_variable_set(:@last, now)
+      else
+        last = detector.instance_variable_get(:@last)
+        gap = now - last
+        window << (gap * 1e6).to_i
+        window.shift if window.length > FailureDetector::SAMPLE_SIZE
+        detector.instance_variable_set(:@last, now)
+      end
+    end
+
+    def self.failure_detector_phi(detector, now)
+      window = detector.instance_variable_get(:@window)
+      heartbeat_interval = detector.instance_variable_get(:@heartbeat_interval)
+      last = detector.instance_variable_get(:@last)
+      size = window.size
+      return 0.0 if size == 0
+      mean_usec = 0
+      fact = 0
+      window.each_with_index {|gap, i|
+        mean_usec += gap * (1 + i)
+        fact += (1 + i)
+      }
+      mean_usec = mean_usec / fact
+      mean = (mean_usec.to_f / 1e6) - heartbeat_interval + 1
+      t = now - last - heartbeat_interval + 1
+      phi = FailureDetector::PHI_FACTOR * t / mean
+      return phi
+    end
+
+    def self.failure_detector_sample_size(detector)
+      detector.instance_variable_get(:@window).size
+    end
+
+    def self.failure_detector_clear(detector)
+      detector.instance_variable_get(:@window).clear
+      detector.instance_variable_set(:@last, 0)
+    end
