 module Fluent::Plugin
   class ForwardOutput < Output
+    def self.select_weighted_forward_node(balancer)
+      error = nil
+      weight_array = balancer.instance_variable_get(:@weight_array)
+      mutex = balancer.instance_variable_get(:@mutex)
+      wlen = weight_array.size
+      wlen.times do
+        node = mutex.synchronize do
+          rr = balancer.instance_variable_get(:@rr)
+          r = rr % weight_array.size
+          balancer.instance_variable_set(:@rr, (r + 1) % weight_array.size)
+          weight_array[r]
+        end
+        next unless node.available?
+        begin
+          ret = yield node
+          return ret, node
+        rescue
+          error = $!
+        end
+      end
+      raise error if error
+      raise NoNodesAvailable, "no nodes are available"
+    end
+
+    def self.rebuild_weighted_forward_nodes(balancer, nodes)
+      log = balancer.instance_variable_get(:@log)
+      mutex = balancer.instance_variable_get(:@mutex)
+      rand_seed = balancer.instance_variable_get(:@rand_seed)
+      standby_nodes, regular_nodes = nodes.select { |e| e.weight > 0 }.partition {|n|
+        n.standby?
+      }
+      lost_weight = 0
+      regular_nodes.each {|n|
+        unless n.available?
+          lost_weight += n.weight
+        end
+      }
+      log.debug("rebuilding weight array", lost_weight: lost_weight) if log
+      if lost_weight > 0
+        standby_nodes.each {|n|
+          if n.available?
+            regular_nodes << n
+            log.warn "using standby node #{n.host}:#{n.port}", weight: n.weight if log
+            lost_weight -= n.weight
+            break if lost_weight <= 0
+          end
+        }
+      end
+      weight_array = []
+      if regular_nodes.empty?
+        log.warn('No nodes are available') if log
+        mutex.synchronize do
+          balancer.instance_variable_set(:@weight_array, weight_array)
+        end
+        return balancer.instance_variable_get(:@weight_array)
+      end
+      gcd = regular_nodes.map {|n| n.weight }.inject(0) {|r, w| r.gcd(w) }
+      regular_nodes.each {|n|
+        (n.weight / gcd).times {
+          weight_array << n
+        }
+      }
+      coe = (regular_nodes.size * 6) / weight_array.size
+      weight_array *= coe if coe > 1
+      r = Random.new(rand_seed)
+      weight_array.sort_by! { r.rand }
+      mutex.synchronize do
+        balancer.instance_variable_set(:@weight_array, weight_array)
+      end
+    end
