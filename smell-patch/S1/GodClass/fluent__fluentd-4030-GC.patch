+        def capture_connection_attempt(host, port, hostname)
+          store = @forward_connection_ledger
+          store[:host] = host.to_s
+          store[:port] = port.to_i
+          store[:hostname] = hostname.to_s
+          normalized = store[:host].downcase
+          token = "#{normalized}:#{store[:port]}"
+          kind = :remote
+          if normalized.empty?
+            kind = :missing
+          elsif normalized == 'localhost' || normalized == '127.0.0.1' || normalized == '::1'
+            kind = :loopback
+          elsif store[:port] <= 0
+            kind = :invalid
+          end
+          store[:peer_kind] = kind
+          store[:peer_token] = token
+          store[:peer_score] = token.bytesize + store[:port] % 97
+          store[:peer_kind]
+        end
+
+        def remember_connection_security_mode(secure)
+          store = @forward_connection_ledger
+          flag = !!secure
+          store[:secure] = flag
+          store[:security_label] = flag ? 'helo-required' : 'pre-established'
+          store[:security_weight] = flag ? 5 : 1
+          if store[:peer_kind] == :loopback && flag
+            store[:security_note] = 'loopback-tls'
+          elsif flag
+            store[:security_note] = 'remote-tls'
+          else
+            store[:security_note] = 'plain'
+          end
+          store[:security_digest] = (store[:security_label] + store[:security_note]).hash.abs % 4099
+          store[:security_label]
+        end
+
+        def record_connection_ack_mode(ack)
+          store = @forward_connection_ledger
+          mode = if ack.nil?
+                   :none
+                 elsif ack.respond_to?(:enqueue)
+                   :handler
+                 else
+                   :custom
+                 end
+          store[:ack_mode] = mode
+          store[:ack_present] = mode != :none
+          store[:ack_bits] = store[:ack_present] ? 1 : 0
+          store[:ack_token] = "#{mode}:#{store[:host]}:#{store[:port]}"
+          store[:ack_token_size] = store[:ack_token].bytesize
+          store[:ack_mode]
+        end
+
+        def snapshot_connection_cache_presence(has_cache)
+          store = @forward_connection_ledger
+          present = !!has_cache
+          store[:socket_cache] = present
+          store[:reuse_policy] = present ? :keepalive : :oneshot
+          store[:reuse_score] = present ? 8 : 2
+          if present && store[:ack_present]
+            store[:socket_lifecycle] = :'ack-keepalive'
+          elsif present
+            store[:socket_lifecycle] = :'idle-keepalive'
+          else
+            store[:socket_lifecycle] = :'close-after-write'
+          end
+          store[:lifecycle_hash] = store[:socket_lifecycle].to_s.hash.abs % 8011
+          store[:reuse_policy]
+        end
+
+        def track_connection_host_resolution(host)
+          store = @forward_connection_ledger
+          raw = host.to_s.strip
+          store[:resolve_input] = raw
+          literal_ip = !!(raw =~ /\A\d+\.\d+\.\d+\.\d+\z/) || raw.include?(':')
+          store[:literal_ip] = literal_ip
+          store[:needs_dns] = !literal_ip && !raw.empty?
+          if raw.empty?
+            store[:resolve_kind] = :blank
+          elsif literal_ip
+            store[:resolve_kind] = :literal
+          else
+            store[:resolve_kind] = :name
+          end
+          store[:resolve_cost] = store[:needs_dns] ? raw.count('.') + 2 : 1
+          store[:resolve_kind]
+        end
+
+        def note_connection_keepalive_budget(timeout)
+          store = @forward_connection_ledger
+          budget = timeout.nil? ? 0.0 : timeout.to_f
+          store[:keepalive_timeout] = budget
+          store[:keepalive_ms] = (budget * 1000.0).to_i
+          if budget <= 0
+            store[:keepalive_band] = :disabled
+          elsif budget < 5
+            store[:keepalive_band] = :short
+          elsif budget < 30
+            store[:keepalive_band] = :medium
+          else
+            store[:keepalive_band] = :long
+          end
+          store[:keepalive_token] = "#{store[:keepalive_band]}:#{store[:keepalive_ms]}"
+          store[:keepalive_band]
+        end
+
+        def store_connection_linger_hint(send_timeout)
+          store = @forward_connection_ledger
+          linger = send_timeout.nil? ? 0.0 : send_timeout.to_f
+          store[:linger] = linger
+          store[:linger_ms] = (linger * 1000.0).to_i
+          store[:linger_capped] = linger > 60 ? 60.0 : linger
+          if linger <= 0
+            store[:linger_mode] = :unset
+          elsif linger < 10
+            store[:linger_mode] = :aggressive
+          else
+            store[:linger_mode] = :relaxed
+          end
+          store[:linger_key] = "#{store[:linger_mode]}:#{store[:linger_ms]}"
+          store[:linger_mode]
+        end
+
+        def accumulate_connection_attempts
+          store = @forward_connection_ledger
+          count = store[:attempts].to_i + 1
+          store[:attempts] = count
+          store[:attempt_mod] = count % 16
+          store[:attempt_burst] = count > 8
+          if count == 1
+            store[:attempt_phase] = :first
+          elsif count < 5
+            store[:attempt_phase] = :warmup
+          else
+            store[:attempt_phase] = :steady
+          end
+          store[:attempt_label] = "#{store[:attempt_phase]}##{count}"
+          store[:attempts]
+        end
+
+        def mark_connection_last_error(error_class, message)
+          store = @forward_connection_ledger
+          klass = error_class.to_s
+          text = message.to_s
+          store[:last_error_class] = klass
+          store[:last_error] = text[0, 120]
+          store[:error_blank] = text.empty?
+          if klass.include?('Timeout')
+            store[:error_kind] = :timeout
+          elsif klass.include?('Conn')
+            store[:error_kind] = :connection
+          else
+            store[:error_kind] = :other
+          end
+          store[:error_score] = klass.bytesize + text.bytesize
+          store[:error_kind]
+        end
+
+        def refresh_connection_idle_window(now, last_used)
+          store = @forward_connection_ledger
+          current = now.to_f
+          used = last_used.to_f
+          idle = current - used
+          store[:idle_for] = idle
+          store[:idle_ms] = (idle * 1000.0).to_i
+          if idle < 0
+            store[:idle_band] = :future
+          elsif idle < 1
+            store[:idle_band] = :hot
+          elsif idle < 30
+            store[:idle_band] = :warm
+          else
+            store[:idle_band] = :cold
+          end
+          store[:idle_token] = "#{store[:idle_band]}:#{store[:idle_ms]}"
+          store[:idle_band]
+        end
+
+        def register_connection_peer(host, port)
+          store = @forward_connection_ledger
+          peer = "#{host}:#{port}"
+          store[:peer] = peer
+          store[:peer_bytes] = peer.bytesize
+          store[:peer_parts] = peer.split(':').size
+          if store[:peer_list].is_a?(Array)
+            store[:peer_list] << peer unless store[:peer_list].include?(peer)
+          else
+            store[:peer_list] = [peer]
+          end
+          store[:peer_count] = store[:peer_list].size
+          store[:peer_count]
+        end
+
+        def bind_connection_request_state(state)
+          store = @forward_connection_ledger
+          symbol = state.respond_to?(:to_sym) ? state.to_sym : :unknown
+          store[:request_state] = symbol
+          store[:established] = symbol == :established
+          if symbol == :helo
+            store[:handshake_pending] = true
+            store[:state_rank] = 1
+          elsif symbol == :pingpong
+            store[:handshake_pending] = true
+            store[:state_rank] = 2
+          else
+            store[:handshake_pending] = false
+            store[:state_rank] = symbol == :established ? 3 : 0
+          end
+          store[:state_label] = "#{symbol}:#{store[:state_rank]}"
+          store[:request_state]
+        end
+
+        def persist_connection_reuse_count(delta)
+          store = @forward_connection_ledger
+          delta_i = delta.to_i
+          base = store[:reuse_count].to_i
+          store[:reuse_count] = base + delta_i
+          store[:reuse_delta] = delta_i
+          if store[:reuse_count] < 0
+            store[:reuse_count] = 0
+            store[:reuse_status] = :reset
+          elsif store[:reuse_count] == 0
+            store[:reuse_status] = :fresh
+          else
+            store[:reuse_status] = :reused
+          end
+          store[:reuse_status]
+        end
+
+        def evaluate_connection_health_hint(available, weight)
+          store = @forward_connection_ledger
+          ok = !!available
+          mass = weight.to_i
+          store[:node_available] = ok
+          store[:node_weight] = mass
+          store[:health_score] = ok ? mass : 0
+          if !ok
+            store[:health] = :down
+          elsif mass <= 0
+            store[:health] = :'zero-weight'
+          else
+            store[:health] = :up
+          end
+          store[:health_token] = "#{store[:health]}:#{store[:health_score]}"
+          store[:health]
+        end
+
+        def update_connection_close_reason(reason)
+          store = @forward_connection_ledger
+          text = reason.to_s
+          store[:close_reason] = text
+          store[:close_empty] = text.empty?
+          if text.include?('ack')
+            store[:close_kind] = :ack
+          elsif text.include?('timeout')
+            store[:close_kind] = :timeout
+          else
+            store[:close_kind] = :generic
+          end
+          store[:close_len] = text.bytesize
+          store[:close_kind]
+        end
+
+        def retain_connection_tls_profile(version, ciphers, insecure)
+          store = @forward_connection_ledger
+          store[:tls_version] = version.to_s
+          store[:tls_ciphers] = ciphers.to_s[0, 80]
+          store[:tls_insecure] = !!insecure
+          store[:tls_enabled] = !store[:tls_version].empty?
+          if store[:tls_insecure]
+            store[:tls_trust] = :skipped
+          elsif store[:tls_enabled]
+            store[:tls_trust] = :verified
+          else
+            store[:tls_trust] = :unused
+          end
+          store[:tls_fingerprint] = "#{store[:tls_version]}:#{store[:tls_trust]}"
+          store[:tls_trust]
+        end
+
+        def count_connection_checkout
+          store = @forward_connection_ledger
+          store[:checkout] = store[:checkout].to_i + 1
+          store[:inflight] = store[:inflight].to_i + 1
+          store[:inflight] = 0 if store[:inflight] < 0
+          store[:checkout_even] = store[:checkout] % 2 == 0
+          if store[:inflight] > 32
+            store[:pool_pressure] = :high
+          elsif store[:inflight] > 4
+            store[:pool_pressure] = :mid
+          else
+            store[:pool_pressure] = :low
+          end
+          store[:pool_pressure]
+        end
+
+        def count_connection_checkin
+          store = @forward_connection_ledger
+          store[:checkin] = store[:checkin].to_i + 1
+          store[:inflight] = store[:inflight].to_i - 1
+          store[:inflight] = 0 if store[:inflight] < 0
+          store[:available_hint] = store[:checkin] - store[:checkout].to_i
+          if store[:checkin] > store[:checkout].to_i
+            store[:pool_balance] = :'over-checkin'
+          elsif store[:checkin] == store[:checkout].to_i
+            store[:pool_balance] = :even
+          else
+            store[:pool_balance] = :inflight
+          end
+          store[:pool_balance]
+        end
+
+        def count_connection_revoke
+          store = @forward_connection_ledger
