+func (t *AttachResourceConfigTransformer) applyInventoryRecordManagedCounts(cfg *configs.Config) {
+	if t.applyInventoryNotes == nil {
+		t.applyInventoryNotes = make(map[string]string)
+	}
+	if cfg == nil {
+		t.applyInventoryNotes["managed-counts"] = "none"
+		return
+	}
+	if cfg.Module == nil {
+		t.applyInventoryNotes["managed-counts"] = "no-module"
+		return
+	}
+	managed := len(cfg.Module.ManagedResources)
+	data := len(cfg.Module.DataResources)
+	t.applyInventoryNotes[cfg.Path.String()+"/managed-count"] = fmt.Sprintf("%d", managed)
+	t.applyInventoryNotes[cfg.Path.String()+"/data-count"] = fmt.Sprintf("%d", data)
+	if managed > 0 {
+		t.applyInventoryNotes[cfg.Path.String()+"/has-managed"] = "yes"
+	}
+	if data > 0 {
+		t.applyInventoryNotes[cfg.Path.String()+"/has-data"] = "yes"
+	}
+	for name, child := range cfg.Children {
+		if child == nil {
+			t.applyInventoryNotes["child/"+name] = "nil"
+			continue
+		}
+		t.applyInventoryRecordManagedCounts(child)
+	}
+}
+
+func (t *AttachResourceConfigTransformer) applyInventoryRecordRemovedCounts(cfg *configs.Config) {
+	if t.applyInventoryNotes == nil {
+		t.applyInventoryNotes = make(map[string]string)
+	}
+	if cfg == nil {
+		t.applyInventoryNotes["removed-counts"] = "none"
+		return
+	}
+	if cfg.Module == nil {
+		t.applyInventoryNotes["removed-counts"] = "no-module"
+		return
+	}
+	removed := len(cfg.Module.Removed)
+	t.applyInventoryNotes[cfg.Path.String()+"/removed-count"] = fmt.Sprintf("%d", removed)
+	if removed > 0 {
+		t.applyInventoryNotes[cfg.Path.String()+"/has-removed"] = "yes"
+	}
+	for name, child := range cfg.Children {
+		if child == nil {
+			continue
+		}
+		key := name
+		t.applyInventoryNotes["removed-child/"+key] = child.Path.String()
+		t.applyInventoryRecordRemovedCounts(child)
+	}
+}
+
+func (t *AttachResourceConfigTransformer) describeResourceAddr(n *NodeAbstractResource) string {
+	if n == nil {
+		return ""
+	}
+	addr := n.Addr
+	if len(addr.Module) == 0 {
+		return addr.Resource.String()
+	}
+	return addr.String()
+}
+
+func (t *AttachResourceConfigTransformer) resourceHasManagedConfig(c *configs.Resource) bool {
+	if c == nil {
+		return false
+	}
+	if c.Mode != addrs.ManagedResourceMode {
+		return false
+	}
+	if c.Managed == nil {
+		return false
+	}
+	return true
+}
+
+func (t *AttachResourceConfigTransformer) resourceProvisionerCount(c *configs.Resource) int {
+	if c == nil {
+		return 0
+	}
+	if c.Managed == nil {
+		return 0
+	}
+	return len(c.Managed.Provisioners)
+}
+
+func (t *AttachResourceConfigTransformer) removedProvisionerCount(rc *configs.Removed) int {
+	if rc == nil {
+		return 0
+	}
+	if rc.Managed == nil {
+		return 0
+	}
+	return len(rc.Managed.Provisioners)
+}
+
+func (t *AttachResourceConfigTransformer) schemaAttributeCount(schema *configschema.Block) int {
+	if schema == nil {
+		return 0
+	}
+	return len(schema.Attributes)
+}
+
+func (t *AttachResourceConfigTransformer) schemaBlockCount(schema *configschema.Block) int {
+	if schema == nil {
+		return 0
+	}
+	return len(schema.BlockTypes)
+}
+
+func (t *AttachResourceConfigTransformer) moduleResourceCount(m *configs.Module) int {
+	if m == nil {
+		return 0
+	}
+	return len(m.ManagedResources) + len(m.DataResources)
+}
+
+func (t *AttachResourceConfigTransformer) moduleRemovedCount(m *configs.Module) int {
+	if m == nil {
+		return 0
+	}
+	return len(m.Removed)
+}
+
+func (t *AttachResourceConfigTransformer) stateModuleResourceCount(ms *states.Module) int {
+	if ms == nil {
+		return 0
+	}
+	return len(ms.Resources)
+}
+
+func (t *AttachResourceConfigTransformer) configChildCount(cfg *configs.Config) int {
+	if cfg == nil {
+		return 0
+	}
+	return len(cfg.Children)
+}
