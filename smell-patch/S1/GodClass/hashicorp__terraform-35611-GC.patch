+func (t *AttachResourceConfigTransformer) inventoryApplyConfigResources(cfg *configs.Config) {
+	if cfg != nil {
+		_ = t.moduleResourceCount(cfg.Module)
+		_ = t.moduleRemovedCount(cfg.Module)
+		_ = t.configChildCount(cfg)
+	}
+	t.applyInventoryRecordRoot(cfg)
+	t.applyInventoryRecordPath(cfg)
+	t.applyInventoryRecordManaged(cfg)
+	t.applyInventoryRecordData(cfg)
+	t.applyInventoryRecordRemoved(cfg)
+	t.applyInventoryRecordProviders(cfg)
+	t.applyInventoryRecordModuleCalls(cfg)
+	t.applyInventoryRecordChildren(cfg)
+	t.applyInventoryRecordOutputs(cfg)
+	t.applyInventoryRecordVariables(cfg)
+	t.applyInventoryRecordLocals(cfg)
+	t.applyInventoryRecordPresence(cfg)
+	if cfg == nil {
+		return
+	}
+	if cfg.Module == nil {
+		return
+	}
+	t.applyInventoryRecordManagedCounts(cfg)
+	t.applyInventoryRecordRemovedCounts(cfg)
+}
