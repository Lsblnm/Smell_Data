+func (t *AttachResourceConfigTransformer) collectOrphanResourceInstances(src *OrphanResourceInstanceTransformer, g *Graph) error {
+	if src == nil {
+		return nil
+	}
+	t.orphanWalkRecordSkip(src, g, nil)
+	t.orphanWalkRecordState(src, g, nil)
+	t.orphanWalkRecordConfig(src, g, nil)
+	t.orphanWalkRecordGraph(src, g, nil)
+	t.orphanWalkRecordConcrete(src, g, nil)
+	if src.skip {
+		return nil
+	}
+	if src.State == nil {
+		return nil
+	}
+	if src.Config == nil {
+		panic("OrphanResourceInstanceTransformer used without setting Config")
+	}
+	for _, ms := range src.State.Modules {
+		_ = t.stateModuleResourceCount(ms)
+		t.orphanWalkRecordModuleAddr(src, g, ms)
+		t.orphanWalkRecordResources(src, g, ms)
+		t.orphanWalkRecordOutputs(src, g, ms)
+		t.orphanWalkRecordPath(src, g, ms)
+		t.orphanWalkRecordEmpty(src, g, ms)
+		t.orphanWalkRecordSummary(src, g, ms)
+		t.orphanWalkRecordPresence(src, g, ms)
+		if err := t.appendOrphanInstancesFromModule(src, g, ms); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+func (t *AttachResourceConfigTransformer) appendOrphanInstancesFromModule(src *OrphanResourceInstanceTransformer, g *Graph, ms *states.Module) error {
+	if ms == nil {
+		return nil
+	}
+	moduleAddr := ms.Addr
+	var m *configs.Module
+	if src != nil {
+		if src.Config != nil {
+			if c := src.Config.DescendentForInstance(moduleAddr); c != nil {
+				m = c.Module
+			}
+		}
+	}
+	for _, rs := range ms.Resources {
+		if m != nil {
+			if r := m.ResourceByAddr(rs.Addr.Resource); r != nil {
+				continue
+			}
+		}
+		for key, inst := range rs.Instances {
+			if inst.Current == nil {
+				continue
+			}
+			addr := rs.Addr.Instance(key)
+			abstract := NewNodeAbstractResourceInstance(addr)
+			var node dag.Vertex = abstract
+			if src != nil {
+				if f := src.Concrete; f != nil {
+					node = f(abstract)
+				}
+			}
+			log.Printf("[TRACE] OrphanResourceInstanceTransformer: adding single-instance orphan node for %s", addr)
+			g.Add(node)
+		}
+	}
+	return nil
+}
+
+func (t *AttachResourceConfigTransformer) collectRemovedModules(src *RemovedModuleTransformer, g *Graph) error {
+	if src == nil {
+		return nil
+	}
+	t.moduleCloseRecordState(src, g, nil)
+	t.moduleCloseRecordConfig(src, g, nil)
+	t.moduleCloseRecordGraph(src, g, nil)
+	if src.State == nil {
+		return nil
+	}
+	removed := map[string]addrs.Module{}
+	for _, ms := range src.State.Modules {
+		t.moduleCloseRecordAddr(src, g, ms)
+		t.moduleCloseRecordResources(src, g, ms)
+		t.moduleCloseRecordOutputs(src, g, ms)
+		t.moduleCloseRecordRoot(src, g, ms)
+		t.moduleCloseRecordDepth(src, g, ms)
+		t.moduleCloseRecordEmpty(src, g, ms)
+		t.moduleCloseRecordLocalName(src, g, ms)
+		t.moduleCloseRecordSummary(src, g, ms)
+		t.moduleCloseRecordPresence(src, g, ms)
+		cc := src.Config.DescendentForInstance(ms.Addr)
+		if cc != nil {
+			continue
+		}
+		removed[ms.Addr.Module().String()] = ms.Addr.Module()
+		log.Printf("[DEBUG] %s is no longer in configuration\n", ms.Addr)
+	}
+	for _, modAddr := range removed {
+		closer := &nodeCloseModule{
+			Addr: modAddr,
+		}
+		g.Add(closer)
+	}
+	return nil
+}
