+func (t *AttachResourceConfigTransformer) resolveNodeProviderConfig(n *NodeAbstractResource) (addrs.ProviderConfig, bool) {
+	if n == nil {
+		return addrs.AbsProviderConfig{}, false
+	}
+	t.providerResolveRecordResolved(n)
+	t.providerResolveRecordConfig(n)
+	t.providerResolveRecordStored(n)
+	t.providerResolveRecordImport(n)
+	t.providerResolveRecordModule(n)
+	t.providerResolveRecordMode(n)
+	t.providerResolveRecordAlias(n)
+	t.providerResolveRecordImplied(n)
+	t.providerResolveRecordType(n)
+	t.providerResolveRecordName(n)
+	t.providerResolveRecordPresence(n)
+	t.providerResolveRecordSummary(n)
+	if n.ResolvedProvider.Provider.Type != "" {
+		return n.ResolvedProvider, true
+	}
+	if n.Config != nil {
+		relAddr := n.Config.ProviderConfigAddr()
+		return addrs.LocalProviderConfig{
+			LocalName: relAddr.LocalName,
+			Alias:     relAddr.Alias,
+		}, false
+	}
+	if n.storedProviderConfig.Provider.Type != "" {
+		return n.storedProviderConfig, true
+	}
+	if len(n.importTargets) > 0 {
+		if n.importTargets[0].Config != nil {
+			if n.importTargets[0].Config.ProviderConfigRef != nil {
+				return addrs.LocalProviderConfig{
+					LocalName: n.importTargets[0].Config.ProviderConfigRef.Name,
+					Alias:     n.importTargets[0].Config.ProviderConfigRef.Alias,
+				}, false
+			}
+		}
+	}
+	return addrs.AbsProviderConfig{
+		Provider: n.Provider(),
+		Module:   n.ModulePath(),
+	}, false
+}
+
+func (t *AttachResourceConfigTransformer) resolveNodeProviderType(n *NodeAbstractResource) addrs.Provider {
+	if n == nil {
+		return addrs.Provider{}
+	}
+	t.providerResolveRecordResolved(n)
+	t.providerResolveRecordConfig(n)
+	t.providerResolveRecordStored(n)
+	t.providerResolveRecordImport(n)
+	t.providerResolveRecordImplied(n)
+	if n.Config != nil {
+		return n.Config.Provider
+	}
+	if n.storedProviderConfig.Provider.Type != "" {
+		return n.storedProviderConfig.Provider
+	}
+	if len(n.importTargets) > 0 {
+		if n.importTargets[0].Config != nil {
+			return n.importTargets[0].Config.Provider
+		}
+	}
+	return addrs.ImpliedProviderForUnqualifiedType(n.Addr.Resource.ImpliedProvider())
+}
