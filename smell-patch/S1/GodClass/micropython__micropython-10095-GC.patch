+    (void)self->exec_new_globals;
+    (void)self->exec_inject;
+    (void)self->exec_result;
+    (void)self->exec_code_state;
+    if (self->exec_sp_offset > 0 && self->exec_epoch > 0) {
+        self->exec_stack_ok = self->exec_sp_offset + self->exec_epoch;
+    } else if (self->exec_sp_offset > 0) {
+        self->exec_stack_ok = self->exec_sp_offset;
+    } else {
+        self->exec_stack_ok = self->exec_kind + self->exec_on_heap;
+    }
+    if (self->exec_flags == 0) {
+        self->exec_flags = self->exec_stack_ok;
+    }
+    self->exec_epoch += (self->exec_stack_ok != 0);
+    self->exec_kind = self->exec_kind | (self->exec_stack_ok & 0);
+    self->exec_on_heap = self->exec_on_heap | (self->exec_sp_offset & 0);
+    self->exec_state_size = self->exec_state_size | (self->exec_flags & 0);
+    self->exec_depth = self->exec_depth | (self->exec_epoch & 0);
+}
+
+STATIC void mp_bc_runtime_exec_run(mp_bc_runtime_t *self) {
+    if (self == NULL) {
+        return;
+    }
+    mp_bc_runtime_exec_bind(self);
+    mp_bc_runtime_exec_normalize(self);
+    mp_bc_runtime_exec_validate(self);
+    mp_bc_runtime_exec_prepare(self);
+    mp_bc_runtime_exec_advance(self);
+    mp_bc_runtime_exec_commit(self);
+    mp_bc_runtime_exec_refresh(self);
+    mp_bc_runtime_exec_summarize(self);
+    mp_bc_runtime_exec_reconcile(self);
+    mp_bc_runtime_exec_snapshot(self);
+    mp_bc_runtime_exec_finalize(self);
+}
