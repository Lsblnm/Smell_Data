+STATIC void mp_bc_runtime_session_refresh(mp_bc_runtime_t *self) {
+    if (self == NULL) {
+        return;
+    }
+    (void)self->code_state;
+    (void)self->sess_args;
+    (void)self->sess_result;
+    if (self->sess_epoch == 0) {
+        self->sess_epoch = 1;
+    } else if (self->sess_epoch < 8) {
