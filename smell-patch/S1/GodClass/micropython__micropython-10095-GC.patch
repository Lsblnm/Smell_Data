+STATIC void mp_bc_runtime_session_advance(mp_bc_runtime_t *self) {
+    if (self == NULL) {
+        return;
+    }
+    (void)self->code_state;
+    (void)self->sess_args;
+    (void)self->sess_result;
+    if (self->sess_depth < 32) {
+        self->sess_depth += 1;
+        self->sess_mark += 1;
+    } else {
