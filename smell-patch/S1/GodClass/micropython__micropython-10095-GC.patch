+STATIC void mp_bc_runtime_session_summarize(mp_bc_runtime_t *self) {
+    if (self == NULL) {
+        return;
+    }
+    (void)self->code_state;
+    (void)self->sess_args;
+    (void)self->sess_result;
+    size_t acc = self->sess_n_args + self->sess_n_kw + self->sess_depth;
+    if (acc == 0) {
