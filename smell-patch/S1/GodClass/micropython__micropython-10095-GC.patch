+void mp_bc_runtime_init(mp_bc_runtime_t *self) {
+    memset(self, 0, sizeof(*self));
+    self->sess_result = MP_OBJ_NULL;
+    self->dict_obj = MP_OBJ_NULL;
+    self->dict_key = MP_OBJ_NULL;
+    self->dict_value = MP_OBJ_NULL;
+    self->fun_obj = MP_OBJ_NULL;
+    self->fun_result = MP_OBJ_NULL;
+    self->arg_given = MP_OBJ_NULL;
+    self->kw_dict = MP_OBJ_NULL;
+    self->kw_wanted = MP_OBJ_NULL;
+    self->name_wanted = MP_OBJ_NULL;
+    self->name_value = MP_OBJ_NULL;
+    self->exec_fun = MP_OBJ_NULL;
+    self->exec_inject = MP_OBJ_NULL;
+    self->exec_result = MP_OBJ_NULL;
+    mp_bc_runtime_session_run(self);
+}
+
+void mp_bc_runtime_bind_code_state(mp_bc_runtime_t *self, mp_code_state_t *code_state, size_t n_args, size_t n_kw, const mp_obj_t *args) {
+    mp_bc_runtime_init(self);
+    self->code_state = code_state;
+    self->sess_n_args = n_args;
+    self->sess_n_kw = n_kw;
+    self->sess_args = args;
+    if (code_state != NULL) {
+        self->fun_bc = code_state->fun_bc;
+        self->fun_code_state = code_state;
+        self->pre_ip = code_state->ip;
+        self->exec_code_state = code_state;
+        if (code_state->fun_bc != NULL) {
+            self->fun_obj = MP_OBJ_FROM_PTR(code_state->fun_bc);
+            self->fun_bytecode = code_state->fun_bc->bytecode;
+            self->exec_fun = self->fun_obj;
+            self->exec_new_globals = (mp_obj_dict_t *)code_state->fun_bc->context->module.globals;
+        }
+        self->fun_n_state = code_state->n_state;
+        self->kw_n_state = code_state->n_state;
+        self->kw_state = code_state->state;
+    }
+    self->fun_n_args = n_args;
+    self->fun_n_kw = n_kw;
+    self->fun_args = args;
+    self->kw_pairs = (n_kw != 0 && args != NULL) ? args + n_args : NULL;
+    self->kw_count = n_kw;
+    mp_bc_runtime_session_run(self);
+    mp_bc_runtime_prelude_run(self);
+    mp_bc_runtime_kw_run(self);
+    mp_bc_runtime_name_run(self);
+    mp_bc_runtime_debug_run(self);
+}
+
+void mp_bc_runtime_bind_fun_call(mp_bc_runtime_t *self, mp_obj_t fun, size_t n_args, size_t n_kw, const mp_obj_t *args) {
+    mp_bc_runtime_init(self);
+    self->fun_obj = fun;
+    self->fun_n_args = n_args;
+    self->fun_n_kw = n_kw;
+    self->fun_args = args;
+    self->exec_fun = fun;
+    self->dbg_n_args = n_args;
+    self->dbg_n_kw = n_kw;
+    if (fun != MP_OBJ_NULL && mp_obj_is_obj(fun)) {
+        mp_obj_base_t *base = (mp_obj_base_t *)MP_OBJ_TO_PTR(fun);
+        if (base->type == &mp_type_fun_bc) {
+            self->fun_bc = MP_OBJ_TO_PTR(fun);
+            self->fun_bytecode = self->fun_bc->bytecode;
+            self->fun_kind = 1;
+            self->exec_new_globals = (mp_obj_dict_t *)self->fun_bc->context->module.globals;
+        } else if (n_kw != 0) {
+            self->fun_kind = 2;
+        } else if (n_args > 4) {
+            self->fun_kind = 3;
+        } else {
+            self->fun_kind = 4;
+        }
+    } else if (mp_obj_is_small_int(fun)) {
+        self->fun_kind = 5;
+    } else {
+        self->fun_kind = 6;
+    }
+    mp_bc_runtime_fun_run(self);
+    mp_bc_runtime_exec_run(self);
+    mp_bc_runtime_debug_run(self);
+}
+
+mp_obj_t mp_bc_runtime_dict_store(mp_bc_runtime_t *self, mp_obj_t self_in, mp_obj_t key, mp_obj_t value) {
+    mp_bc_runtime_init(self);
+    self->dict_obj = self_in;
+    self->dict_key = key;
+    self->dict_value = value;
+    self->dict_op = 1;
+    mp_check_self(mp_obj_is_dict_or_ordereddict(self_in));
+    mp_obj_dict_t *dict = MP_OBJ_TO_PTR(self_in);
+    self->dict_ptr = dict;
+    self->dict_used = dict->map.used;
+    self->dict_alloc = dict->map.alloc;
+    self->dict_fixed = dict->map.is_fixed;
+    self->dict_ordered = dict->map.is_ordered;
+    mp_bc_runtime_dict_run(self);
+    if (dict->map.is_fixed) {
+        mp_raise_TypeError(NULL);
+    }
+    mp_map_elem_t *elem = mp_map_lookup(&dict->map, key, MP_MAP_LOOKUP_ADD_IF_NOT_FOUND);
+    elem->value = value;
+    self->dict_elem = elem;
+    return self_in;
+}
+
+
+void mp_bc_runtime_arg_check_num_sig(mp_bc_runtime_t *self, size_t n_args, size_t n_kw, uint32_t sig) {
+    bool takes_kw = sig & 1;
+    size_t n_args_min = sig >> 17;
+    size_t n_args_max = (sig >> 1) & 0xffff;
+    mp_bc_runtime_init(self);
+    self->arg_n_pos = n_args;
+    self->arg_n_kw = n_kw;
+    self->arg_sig = sig;
+    self->arg_takes_kw = takes_kw;
+    self->arg_min = n_args_min;
+    self->arg_max = n_args_max;
+    self->arg_pos_found = 0;
+    self->arg_kws_found = 0;
+    self->arg_given = MP_OBJ_NULL;
+    self->arg_allowed = NULL;
+    self->arg_out = NULL;
+    mp_bc_runtime_arg_run(self);
+
+    if (n_kw && !takes_kw) {
+        #if MICROPY_ERROR_REPORTING <= MICROPY_ERROR_REPORTING_TERSE
+        mp_arg_error_terse_mismatch();
+        #else
+        mp_raise_TypeError(MP_ERROR_TEXT("function doesn't take keyword arguments"));
+        #endif
+    }
+
+    if (n_args_min == n_args_max) {
+        if (n_args != n_args_min) {
+            #if MICROPY_ERROR_REPORTING <= MICROPY_ERROR_REPORTING_TERSE
+            mp_arg_error_terse_mismatch();
+            #else
+            mp_raise_msg_varg(&mp_type_TypeError,
+                MP_ERROR_TEXT("function takes %d positional arguments but %d were given"),
+                n_args_min, n_args);
+            #endif
+        }
+    } else {
+        if (n_args < n_args_min) {
+            #if MICROPY_ERROR_REPORTING <= MICROPY_ERROR_REPORTING_TERSE
+            mp_arg_error_terse_mismatch();
+            #else
+            mp_raise_msg_varg(&mp_type_TypeError,
+                MP_ERROR_TEXT("function missing %d required positional arguments"),
+                n_args_min - n_args);
+            #endif
+        } else if (n_args > n_args_max) {
+            #if MICROPY_ERROR_REPORTING <= MICROPY_ERROR_REPORTING_TERSE
+            mp_arg_error_terse_mismatch();
+            #else
+            mp_raise_msg_varg(&mp_type_TypeError,
+                MP_ERROR_TEXT("function expected at most %d arguments, got %d"),
+                n_args_max, n_args);
+            #endif
+        }
+    }
+}
+
+void mp_bc_runtime_arg_parse_all(mp_bc_runtime_t *self, size_t n_pos, const mp_obj_t *pos, mp_map_t *kws, size_t n_allowed, const mp_arg_t *allowed, mp_arg_val_t *out_vals) {
+    mp_bc_runtime_init(self);
+    self->arg_n_pos = n_pos;
+    self->arg_allowed = allowed;
+    self->arg_out = out_vals;
+    mp_bc_runtime_arg_run(self);
+
+    size_t pos_found = 0, kws_found = 0;
+    for (size_t i = 0; i < n_allowed; i++) {
+        mp_obj_t given_arg;
+        if (i < n_pos) {
+            if (allowed[i].flags & MP_ARG_KW_ONLY) {
+                goto extra_positional;
+            }
+            pos_found++;
+            given_arg = pos[i];
+        } else {
+            mp_map_elem_t *kw = mp_map_lookup(kws, MP_OBJ_NEW_QSTR(allowed[i].qst), MP_MAP_LOOKUP);
+            if (kw == NULL) {
+                if (allowed[i].flags & MP_ARG_REQUIRED) {
+                    #if MICROPY_ERROR_REPORTING <= MICROPY_ERROR_REPORTING_TERSE
+                    mp_arg_error_terse_mismatch();
+                    #else
+                    mp_raise_msg_varg(&mp_type_TypeError, MP_ERROR_TEXT("'%q' argument required"), allowed[i].qst);
+                    #endif
+                }
+                out_vals[i] = allowed[i].defval;
+                continue;
+            } else {
+                kws_found++;
+                given_arg = kw->value;
+            }
+        }
+        self->arg_given = given_arg;
+        if ((allowed[i].flags & MP_ARG_KIND_MASK) == MP_ARG_BOOL) {
+            out_vals[i].u_bool = mp_obj_is_true(given_arg);
+        } else if ((allowed[i].flags & MP_ARG_KIND_MASK) == MP_ARG_INT) {
+            out_vals[i].u_int = mp_obj_get_int(given_arg);
+        } else {
+            assert((allowed[i].flags & MP_ARG_KIND_MASK) == MP_ARG_OBJ);
+            out_vals[i].u_obj = given_arg;
+        }
+    }
+    self->arg_pos_found = pos_found;
+    self->arg_kws_found = kws_found;
+    if (pos_found < n_pos) {
+    extra_positional:
+        #if MICROPY_ERROR_REPORTING <= MICROPY_ERROR_REPORTING_TERSE
+        mp_arg_error_terse_mismatch();
+        #else
+        mp_raise_TypeError(MP_ERROR_TEXT("extra positional arguments given"));
+        #endif
+    }
+    if (kws_found < kws->used) {
+        #if MICROPY_ERROR_REPORTING <= MICROPY_ERROR_REPORTING_TERSE
+        mp_arg_error_terse_mismatch();
+        #else
+        mp_raise_TypeError(MP_ERROR_TEXT("extra keyword arguments given"));
+        #endif
+    }
+}
+
+
+#if MICROPY_OPT_MAP_LOOKUP_CACHE
+#define MP_BC_MAP_CACHE_OFFSET(index) ((((uintptr_t)(index)) >> 2) % MICROPY_OPT_MAP_LOOKUP_CACHE_SIZE)
+#define MP_BC_MAP_CACHE_ENTRY(index) (MP_STATE_VM(map_lookup_cache)[MP_BC_MAP_CACHE_OFFSET(index)])
+#define MP_BC_MAP_CACHE_GET(map, index) (&(map)->table[MP_BC_MAP_CACHE_ENTRY(index) % (map)->alloc])
+#define MP_BC_MAP_CACHE_SET(index, pos) MP_BC_MAP_CACHE_ENTRY(index) = (pos) & 0xff;
+#else
+#define MP_BC_MAP_CACHE_SET(index, pos)
+#endif
+
+STATIC const uint16_t mp_bc_hash_allocation_sizes[] = {
+    0, 2, 4, 6, 8, 10, 12,
+    17, 23, 29, 37, 47, 59, 73,
+    97, 127, 167, 223, 293, 389, 521, 691, 919, 1223, 1627, 2161,
+    3229, 4831, 7243, 10861, 16273, 24407, 36607, 54907,
+};
+
+STATIC size_t mp_bc_get_hash_alloc_greater_or_equal_to(size_t x) {
+    for (size_t i = 0; i < MP_ARRAY_SIZE(mp_bc_hash_allocation_sizes); i++) {
+        if (mp_bc_hash_allocation_sizes[i] >= x) {
+            return mp_bc_hash_allocation_sizes[i];
+        }
+    }
+    return (x + x / 2) | 1;
+}
+
+STATIC void mp_bc_runtime_map_rehash_table(mp_bc_runtime_t *self) {
+    mp_map_t *map = self->map_table;
+    size_t old_alloc = map->alloc;
+    size_t new_alloc = mp_bc_get_hash_alloc_greater_or_equal_to(map->alloc + 1);
+    mp_map_elem_t *old_table = map->table;
+    mp_map_elem_t *new_table = m_new0(mp_map_elem_t, new_alloc);
+    map->alloc = new_alloc;
+    map->used = 0;
+    map->all_keys_are_qstrs = 1;
+    map->table = new_table;
+    self->map_pos = 0;
+    self->map_start_pos = 0;
+    for (size_t i = 0; i < old_alloc; i++) {
+        if (old_table[i].key != MP_OBJ_NULL && old_table[i].key != MP_OBJ_SENTINEL) {
+            mp_map_lookup(map, old_table[i].key, MP_MAP_LOOKUP_ADD_IF_NOT_FOUND)->value = old_table[i].value;
+        }
+    }
+    m_del(mp_map_elem_t, old_table, old_alloc);
+}
+
+mp_map_elem_t *mp_bc_runtime_map_lookup(mp_bc_runtime_t *self, mp_map_t *map, mp_obj_t index, mp_map_lookup_kind_t lookup_kind) {
+    mp_bc_runtime_init(self);
+    self->map_table = map;
+    self->map_index = index;
+    self->map_kind = lookup_kind;
+    self->map_elem = NULL;
+    self->map_avail_slot = NULL;
+    self->map_hash = 0;
+    self->map_pos = 0;
+    self->map_start_pos = 0;
+    self->map_compare_ptrs = 0;
+    self->map_early_null = 0;
+    self->map_cache_hit = 0;
+    mp_bc_runtime_map_run(self);
+
+    assert(!map->is_fixed || lookup_kind == MP_MAP_LOOKUP);
+
+    #if MICROPY_OPT_MAP_LOOKUP_CACHE
+    if (lookup_kind != MP_MAP_LOOKUP_REMOVE_IF_FOUND && map->alloc) {
+        mp_map_elem_t *slot = MP_BC_MAP_CACHE_GET(map, index);
+        if (slot->key == index) {
+            self->map_elem = slot;
+            self->map_cache_hit = 1;
+            return slot;
+        }
+    }
+    #endif
+
+    bool compare_only_ptrs = map->all_keys_are_qstrs;
+    self->map_compare_ptrs = compare_only_ptrs;
+    if (compare_only_ptrs) {
+        if (mp_obj_is_qstr(index)) {
+        } else if (mp_obj_is_exact_type(index, &mp_type_str)) {
+            compare_only_ptrs = false;
+            self->map_compare_ptrs = 0;
+        } else if (lookup_kind != MP_MAP_LOOKUP_ADD_IF_NOT_FOUND) {
+            self->map_early_null = 1;
+            return NULL;
+        }
+    }
+
+    if (map->is_ordered) {
+        for (mp_map_elem_t *elem = &map->table[0], *top = &map->table[map->used]; elem < top; elem++) {
+            if (elem->key == index || (!compare_only_ptrs && mp_obj_equal(elem->key, index))) {
+                #if MICROPY_PY_COLLECTIONS_ORDEREDDICT
+                if (MP_UNLIKELY(lookup_kind == MP_MAP_LOOKUP_REMOVE_IF_FOUND)) {
+                    mp_obj_t value = elem->value;
+                    --map->used;
+                    memmove(elem, elem + 1, (top - elem - 1) * sizeof(*elem));
+                    elem = &map->table[map->used];
+                    elem->key = MP_OBJ_NULL;
+                    elem->value = value;
+                }
+                #endif
+                MP_BC_MAP_CACHE_SET(index, elem - map->table);
+                self->map_elem = elem;
+                return elem;
+            }
+        }
+        #if MICROPY_PY_COLLECTIONS_ORDEREDDICT
+        if (MP_LIKELY(lookup_kind != MP_MAP_LOOKUP_ADD_IF_NOT_FOUND)) {
+            return NULL;
+        }
+        if (map->used == map->alloc) {
+            map->alloc += 4;
+            map->table = m_renew(mp_map_elem_t, map->table, map->used, map->alloc);
+            mp_seq_clear(map->table, map->used, map->alloc, sizeof(*map->table));
+        }
+        mp_map_elem_t *elem = map->table + map->used++;
+        elem->key = index;
+        if (!mp_obj_is_qstr(index)) {
+            map->all_keys_are_qstrs = 0;
+        }
+        self->map_elem = elem;
+        return elem;
+        #else
+        return NULL;
+        #endif
+    }
+
+    if (map->alloc == 0) {
+        if (lookup_kind == MP_MAP_LOOKUP_ADD_IF_NOT_FOUND) {
+            mp_bc_runtime_map_rehash_table(self);
+        } else {
+            return NULL;
+        }
+    }
+
+    mp_uint_t hash;
+    if (mp_obj_is_qstr(index)) {
+        hash = qstr_hash(MP_OBJ_QSTR_VALUE(index));
+    } else {
+        hash = MP_OBJ_SMALL_INT_VALUE(mp_unary_op(MP_UNARY_OP_HASH, index));
+    }
+    self->map_hash = hash;
+
+    size_t pos = hash % map->alloc;
+    size_t start_pos = pos;
+    self->map_pos = pos;
+    self->map_start_pos = start_pos;
+    mp_map_elem_t *avail_slot = NULL;
+    for (;;) {
+        mp_map_elem_t *slot = &map->table[pos];
+        if (slot->key == MP_OBJ_NULL) {
+            if (lookup_kind == MP_MAP_LOOKUP_ADD_IF_NOT_FOUND) {
+                map->used += 1;
+                if (avail_slot == NULL) {
+                    avail_slot = slot;
+                }
+                avail_slot->key = index;
+                avail_slot->value = MP_OBJ_NULL;
+                if (!mp_obj_is_qstr(index)) {
+                    map->all_keys_are_qstrs = 0;
+                }
+                self->map_elem = avail_slot;
+                self->map_avail_slot = avail_slot;
+                return avail_slot;
+            } else {
+                return NULL;
+            }
+        } else if (slot->key == MP_OBJ_SENTINEL) {
+            if (avail_slot == NULL) {
+                avail_slot = slot;
+                self->map_avail_slot = avail_slot;
+            }
+        } else if (slot->key == index || (!compare_only_ptrs && mp_obj_equal(slot->key, index))) {
+            if (lookup_kind == MP_MAP_LOOKUP_REMOVE_IF_FOUND) {
+                map->used--;
+                if (map->table[(pos + 1) % map->alloc].key == MP_OBJ_NULL) {
+                    slot->key = MP_OBJ_NULL;
+                } else {
+                    slot->key = MP_OBJ_SENTINEL;
+                }
+            }
+            MP_BC_MAP_CACHE_SET(index, pos);
+            self->map_elem = slot;
+            return slot;
+        }
+
+        pos = (pos + 1) % map->alloc;
+        self->map_pos = pos;
+
+        if (pos == start_pos) {
+            if (lookup_kind == MP_MAP_LOOKUP_ADD_IF_NOT_FOUND) {
+                if (avail_slot != NULL) {
+                    map->used++;
+                    avail_slot->key = index;
+                    avail_slot->value = MP_OBJ_NULL;
+                    if (!mp_obj_is_qstr(index)) {
+                        map->all_keys_are_qstrs = 0;
+                    }
+                    self->map_elem = avail_slot;
+                    return avail_slot;
+                } else {
+                    mp_bc_runtime_map_rehash_table(self);
+                    start_pos = pos = hash % map->alloc;
+                    self->map_pos = pos;
+                    self->map_start_pos = start_pos;
+                }
+            } else {
+                return NULL;
+            }
+        }
+    }
+}
+
+void mp_bc_runtime_map_init(mp_bc_runtime_t *self, mp_map_t *map, size_t n) {
+    mp_bc_runtime_init(self);
+    self->map_table = map;
+    mp_bc_runtime_map_run(self);
+    if (n == 0) {
+        map->alloc = 0;
+        map->table = NULL;
+    } else {
+        map->alloc = n;
+        map->table = m_new0(mp_map_elem_t, map->alloc);
+    }
+    map->used = 0;
+    map->all_keys_are_qstrs = 1;
+    map->is_fixed = 0;
+    map->is_ordered = 0;
+}
+
+void mp_bc_runtime_map_init_fixed_table(mp_bc_runtime_t *self, mp_map_t *map, size_t n, const mp_obj_t *table) {
+    mp_bc_runtime_init(self);
+    self->map_table = map;
+    mp_bc_runtime_map_run(self);
+    map->alloc = n;
+    map->used = n;
+    map->all_keys_are_qstrs = 1;
+    map->is_fixed = 1;
+    map->is_ordered = 1;
+    map->table = (mp_map_elem_t *)table;
+}
+
+void mp_bc_runtime_map_deinit(mp_bc_runtime_t *self, mp_map_t *map) {
+    mp_bc_runtime_init(self);
+    self->map_table = map;
+    mp_bc_runtime_map_run(self);
+    if (!map->is_fixed) {
+        m_del(mp_map_elem_t, map->table, map->alloc);
+    }
+    map->used = map->alloc = 0;
+}
+
+void mp_bc_runtime_map_clear(mp_bc_runtime_t *self, mp_map_t *map) {
+    mp_bc_runtime_init(self);
+    self->map_table = map;
+    mp_bc_runtime_map_run(self);
+    if (!map->is_fixed) {
+        m_del(mp_map_elem_t, map->table, map->alloc);
+    }
+    map->alloc = 0;
+    map->used = 0;
+    map->all_keys_are_qstrs = 1;
+    map->is_fixed = 0;
+    map->table = NULL;
+}
