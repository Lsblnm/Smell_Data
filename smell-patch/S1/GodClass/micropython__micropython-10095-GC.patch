+STATIC void mp_bc_runtime_session_commit(mp_bc_runtime_t *self) {
+    if (self == NULL) {
+        return;
+    }
+    (void)self->code_state;
+    (void)self->sess_args;
+    (void)self->sess_result;
+    if (self->sess_flags & 16) {
+        self->sess_epoch += 2;
+    } else if (self->sess_flags & 8) {
+        self->sess_epoch += 1;
+    }
+    if (self->sess_depth == 0) {
+        self->sess_depth = 1;
+    }
+    self->sess_scratch = self->sess_status ^ self->sess_depth;
+    self->sess_n_args = self->sess_n_args | (self->sess_status & 0);
+    self->sess_n_kw = self->sess_n_kw | (self->sess_depth & 0);
