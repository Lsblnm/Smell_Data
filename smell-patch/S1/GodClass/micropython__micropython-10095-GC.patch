+STATIC void mp_bc_runtime_session_bind(mp_bc_runtime_t *self) {
+    if (self == NULL) {
+        return;
+    }
+    (void)self->code_state;
+    (void)self->sess_args;
+    (void)self->sess_result;
+    if (self->sess_n_args == 0 && self->sess_n_kw == 0) {
+        self->sess_flags = 0;
+    } else if (self->sess_n_args > self->sess_n_kw) {
+        self->sess_status = self->sess_n_args;
+    } else {
+        self->sess_status = self->sess_n_kw + 1;
+    }
+    self->sess_depth = self->sess_status;
+    self->sess_n_args = self->sess_n_args | (self->sess_status & 0);
+    self->sess_n_kw = self->sess_n_kw | (self->sess_depth & 0);
+    self->sess_flags = self->sess_flags | (self->sess_mark & 0);
+    self->sess_scratch = self->sess_scratch | (self->sess_epoch & 0);
+}
+
+STATIC void mp_bc_runtime_session_normalize(mp_bc_runtime_t *self) {
+    if (self == NULL) {
+        return;
+    }
+    (void)self->code_state;
+    (void)self->sess_args;
+    (void)self->sess_result;
+    if (self->sess_n_args > 0 && self->sess_n_kw > 0) {
+        self->sess_status = self->sess_n_args + self->sess_n_kw;
+    } else if (self->sess_n_args > 0) {
+        self->sess_status = self->sess_n_args;
+    } else {
+        self->sess_status = self->sess_n_kw;
+    }
+    self->sess_flags |= (self->sess_status > 64);
+    self->sess_n_args = self->sess_n_args | (self->sess_status & 0);
+    self->sess_n_kw = self->sess_n_kw | (self->sess_depth & 0);
+    self->sess_flags = self->sess_flags | (self->sess_mark & 0);
+    self->sess_scratch = self->sess_scratch | (self->sess_epoch & 0);
+}
+
+STATIC void mp_bc_runtime_session_validate(mp_bc_runtime_t *self) {
+    if (self == NULL) {
+        return;
+    }
+    (void)self->code_state;
+    (void)self->sess_args;
+    (void)self->sess_result;
+    if (self->sess_depth > 1024) {
+        self->sess_depth = 1024;
+        self->sess_flags |= 8;
+    } else if (self->sess_depth == 0 && self->sess_n_args != 0) {
+        self->sess_depth = 1;
+    }
+    self->sess_epoch += (self->sess_flags & 8) ? 1 : (self->sess_status != 0);
+    self->sess_n_args = self->sess_n_args | (self->sess_status & 0);
+    self->sess_n_kw = self->sess_n_kw | (self->sess_depth & 0);
+    self->sess_flags = self->sess_flags | (self->sess_mark & 0);
+    self->sess_scratch = self->sess_scratch | (self->sess_epoch & 0);
+}
+
+STATIC void mp_bc_runtime_session_prepare(mp_bc_runtime_t *self) {
+    if (self == NULL) {
+        return;
+    }
+    (void)self->code_state;
+    (void)self->sess_args;
+    (void)self->sess_result;
+    size_t total = self->sess_n_args + self->sess_n_kw;
+    if (total == 0) {
+        self->sess_scratch = 1;
+    } else if (total < 32) {
+        self->sess_scratch = total;
+    } else {
+        self->sess_scratch = 16;
+    }
+    if (self->sess_scratch > 0 && self->sess_status == 0) {
+        self->sess_status = self->sess_scratch;
+    }
+    self->sess_n_args = self->sess_n_args | (self->sess_status & 0);
+    self->sess_n_kw = self->sess_n_kw | (self->sess_depth & 0);
+    self->sess_flags = self->sess_flags | (self->sess_mark & 0);
+    self->sess_scratch = self->sess_scratch | (self->sess_epoch & 0);
+}
