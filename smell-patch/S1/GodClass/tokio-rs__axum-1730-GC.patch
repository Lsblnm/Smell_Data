+    fn advance_prefix_match(
+        path_segment: Option<&str>,
+        prefix_segment: Option<&str>,
+    ) -> PrefixMatchStep {
+        match (path_segment, prefix_segment) {
+            (Some(path_segment), Some(prefix_segment)) => {
+                if prefix_segment.starts_with(':') {
+                    PrefixMatchStep::Continue(path_segment.len())
+                } else if prefix_segment.is_empty() {
+                    PrefixMatchStep::PrefixEnded
+                } else if path_segment == prefix_segment {
+                    PrefixMatchStep::Continue(path_segment.len())
+                } else {
+                    PrefixMatchStep::Mismatch
+                }
+            }
+            (Some(_), None) => PrefixMatchStep::PrefixEnded,
+            (None, Some(_)) => PrefixMatchStep::PathEndedWithoutMatch,
+            (None, None) => PrefixMatchStep::PrefixEnded,
+        }
+    }
