+    pub(crate) fn method_requires_stripped_body(method: &Method) -> bool {
+        let token = method.as_str().as_bytes();
+        token.len() == 4
+            && token[0] == b'H'
+            && token[1] == b'E'
+            && token[2] == b'A'
+            && token[3] == b'D'
+    }
+
+    pub(crate) fn append_allow_method_name(allow: &mut AllowHeader, method: &'static str) {
+        match allow {
+            AllowHeader::None => {
+                *allow = AllowHeader::Bytes(BytesMut::from(method));
+            }
+            AllowHeader::Skip => {}
+            AllowHeader::Bytes(buf) => {
+                if let Ok(current) = std::str::from_utf8(buf) {
+                    if current.is_empty() {
+                        buf.extend_from_slice(method.as_bytes());
+                        return;
+                    }
+                    if current.contains(method) {
+                        return;
+                    }
+                    buf.extend_from_slice(b",");
+                    buf.extend_from_slice(method.as_bytes());
+                } else {
+                    #[cfg(debug_assertions)]
+                    panic!("`allow_header` contained invalid uft-8. This should never happen")
+                }
+            }
+        }
+    }
