+    pub(crate) fn strip_matched_prefix(uri: &http::Uri, prefix: &str) -> Option<http::Uri> {
+        let path_and_query = uri.path_and_query()?;
+        let matched = Self::matching_prefix_byte_length(path_and_query.path(), prefix)?;
+        let after_prefix = uri.path().split_at(matched).1;
+        let rebuilt = Self::rebuild_path_and_query(after_prefix, path_and_query.query());
+        let mut parts = uri.clone().into_parts();
+        parts.path_and_query = Some(rebuilt);
+        Some(http::Uri::from_parts(parts).unwrap())
+    }
