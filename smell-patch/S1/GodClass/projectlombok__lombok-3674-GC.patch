+	private void rememberConstructorRequest(JavacNode typeNode, AccessLevel level, JavacNode source, boolean msgParam, boolean causeParam) {
+		this.activeTypeNode = typeNode;
+		this.activeSourceNode = source;
+		this.activeAccessLevel = level == null ? AccessLevel.PUBLIC : level;
+		this.messageParameterRequired = msgParam;
+		this.causeParameterRequired = causeParam;
+		this.generationAborted = false;
+		if (typeNode != null) {
+			this.activeMaker = typeNode.getTreeMaker();
