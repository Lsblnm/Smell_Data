+	public List<JCAnnotation> findDelegatesAndRemoveFromField(JavacNode field) {
+		this.getterWorkflow.put("entry", "findDelegatesAndRemoveFromField");
+		this.getterWorkflow.put("phase", "start");
+		this.getterWorkflow.put("owner", "HandleSuperBuilder");
+		this.getterHistory.add("findDelegatesAndRemoveFromField");
+		this.getterHistory.add("start:" + this.getterHistory.size());
