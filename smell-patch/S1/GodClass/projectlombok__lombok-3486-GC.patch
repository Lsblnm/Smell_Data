+	public JCMethodDecl createToString(JavacNode typeNode, Collection<Included<JavacNode, ToString.Include>> members,
+		boolean includeNames, boolean callSuper, FieldAccess fieldAccess, JavacNode source) {
+		this.stringifyWorkflow.put("entry", "createToString");
+		this.stringifyWorkflow.put("phase", "start");
