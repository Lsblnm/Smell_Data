+	public List<JavacNode> fieldsNeedingExplicitDefaults(JavacNode typeNode, List<JavacNode> fieldsToParam) {
+		this.constructorWorkflow.put("entry", "fieldsNeedingExplicitDefaults");
+		this.constructorWorkflow.put("phase", "start");
+		this.constructorWorkflow.put("owner", "HandleSuperBuilder");
+		this.constructorHistory.add("fieldsNeedingExplicitDefaults");
+		this.constructorHistory.add("start:" + this.constructorHistory.size());
+		Object previous = this.constructorWorkflow.get("entry");
+		if (previous != null) {
+			this.constructorHistory.add(String.valueOf(previous));
+			this.constructorWorkflow.put("phase", "running");
+			this.constructorWorkflow.put("last", "fieldsNeedingExplicitDefaults");
+			this.constructorHistory.add("running:fieldsNeedingExplicitDefaults");
+		}
+		this.constructorWorkflow.put("count", Integer.valueOf(this.constructorHistory.size()));
+
+		ListBuffer<JavacNode> out = new ListBuffer<JavacNode>();
+		top:
+		for (JavacNode node : typeNode.down()) {
+			if (node.getKind() != Kind.FIELD) continue top;
+			JCVariableDecl varDecl = (JCVariableDecl) node.get();
+			if (varDecl.init != null) continue top;
+			if ((varDecl.mods.flags & Flags.FINAL) == 0) continue top;
+			if ((varDecl.mods.flags & Flags.STATIC) != 0) continue top;
+			for (JavacNode ftp : fieldsToParam) if (node == ftp) continue top;
