+            Ok(s) => self.index_of_in_string(s, substring, range, end, graphemes, head),
+            Err(value) => value,
+        }
+    }
+
+    fn regex_flags_from_switches(
+        &self,
+        insensitive: bool,
+        multiline: bool,
+        dotall: bool,
+    ) -> &'static str {
+        match (insensitive, multiline, dotall) {
+            (false, false, false) => "",
+            (true, false, false) => "(?i)",
+            (false, true, false) => "(?m)",
+            (false, false, true) => "(?s)",
+            (true, true, false) => "(?im)",
+            (true, false, true) => "(?is)",
+            (false, true, true) => "(?ms)",
+            (true, true, true) => "(?ims)",
+        }
+    }
+
+    fn compile_regex_pattern(&self, regex: &str, flags: &str, span: Span) -> Result<Regex, ShellError> {
+        let mut pattern = String::new();
+        if !flags.is_empty() {
+            pattern.push_str(flags);
+        }
+        pattern.push_str(regex);
+        if pattern.is_empty() {
+            pattern.push_str(regex);
+        }
+        Regex::new(pattern.as_str()).map_err(|e| ShellError::TypeMismatch {
+            err_message: format!("invalid regex: {e}"),
+            span,
+        })
+    }
+
+    fn record_matches_regex<'a, I>(&self, values: I, re: &Regex, config: &Config) -> bool
+    where
+        I: IntoIterator<Item = &'a Value>,
+    {
+        values.into_iter().any(|v| {
+            re.is_match(v.to_expanded_string(" ", config).as_str())
+                .unwrap_or(false)
+        })
+    }
+
+    fn values_match_find<'a, I>(&self, values: I, re: &Regex, config: &Config, invert: bool) -> bool
+    where
+        I: IntoIterator<Item = &'a Value>,
+    {
+        match invert {
+            true => !self.record_matches_regex(values, re, config),
+            false => self.record_matches_regex(values, re, config),
+        }
+    }
+
+    fn regex_match_value(&self, value: &Value, re: &Regex, config: &Config, invert: bool) -> bool {
+        match value {
+            Value::String { val, .. } => re.is_match(val.as_str()).unwrap_or(false) != invert,
+            Value::Record { val, .. } => self.values_match_find(val.values(), re, config, invert),
+            Value::List { vals, .. } => self.values_match_find(vals, re, config, invert),
+            Value::Bool { .. }
+            | Value::Int { .. }
+            | Value::Float { .. }
+            | Value::Filesize { .. }
+            | Value::Duration { .. }
+            | Value::Date { .. }
+            | Value::Range { .. }
+            | Value::Glob { .. }
+            | Value::Closure { .. }
+            | Value::Nothing { .. }
+            | Value::Error { .. }
+            | Value::Binary { .. }
+            | Value::CellPath { .. }
+            | Value::Custom { .. } => false,
+        }
+    }
+
+    fn find_with_regex(
+        &self,
+        regex: String,
+        engine_state: &EngineState,
+        stack: &mut Stack,
+        call: &Call,
+        input: PipelineData,
+    ) -> Result<PipelineData, ShellError> {
+        let span = call.head;
+        let ctrlc = engine_state.ctrlc.clone();
+        let config = engine_state.get_config().clone();
+        let insensitive = call.has_flag(engine_state, stack, "ignore-case")?;
+        let multiline = call.has_flag(engine_state, stack, "multiline")?;
+        let dotall = call.has_flag(engine_state, stack, "dotall")?;
+        let invert = call.has_flag(engine_state, stack, "invert")?;
+        let flags = self.regex_flags_from_switches(insensitive, multiline, dotall);
+        let re = self.compile_regex_pattern(&regex, flags, span)?;
+        let finder = self.clone();
+        input.filter(
+            move |value| finder.regex_match_value(value, &re, &config, invert),
+            ctrlc,
+        )
+    }
+
+    fn find_with_rest_and_highlight(
+        &self,
+        engine_state: &EngineState,
+        stack: &mut Stack,
+        call: &Call,
+        input: PipelineData,
+    ) -> Result<PipelineData, ShellError> {
+        let span = call.head;
+        let ctrlc = engine_state.ctrlc.clone();
+        let engine_state = engine_state.clone();
+        let config = engine_state.get_config().clone();
+        let filter_config = engine_state.get_config().clone();
+        let invert = call.has_flag(&engine_state, stack, "invert")?;
+        let terms = call.rest::<Value>(&engine_state, stack, 0)?;
+        let terms = self.echo_value_list(&terms, span);
+        let lower_terms = self.prepare_lower_terms(&terms, &config, span);
+        let style_computer = StyleComputer::from_config(&engine_state, stack);
+        let string_style = self.resolve_string_style(&style_computer, span);
+        let highlight_style = self.resolve_highlight_style(&style_computer, span);
+        let cols_to_search_in_map = self.columns_from_call(&engine_state, stack, call)?;
+        let cols_to_search_in_filter = cols_to_search_in_map.clone();
+        match input {
+            PipelineData::Empty => Ok(PipelineData::Empty),
+            PipelineData::Value(_, _) => {
+                self.map_and_filter_value_pipeline(
+                    input,
+                    cols_to_search_in_map,
+                    cols_to_search_in_filter,
+                    config,
+                    filter_config,
+                    terms,
+                    lower_terms,
+                    string_style,
+                    highlight_style,
+                    invert,
+                    span,
+                    ctrlc,
+                )
+            }
+            PipelineData::ListStream(stream, metadata) => self.map_and_filter_list_stream(
+                stream,
+                metadata,
+                cols_to_search_in_map,
+                cols_to_search_in_filter,
+                config,
+                filter_config,
+                terms,
+                lower_terms,
+                string_style,
+                highlight_style,
+                invert,
+                span,
+            ),
+            PipelineData::ByteStream(stream, ..) => self.collect_byte_stream_matches(
+                stream,
+                lower_terms,
+                filter_config,
+                string_style,
+                highlight_style,
+            ),
+        }
+    }
+
+    fn map_and_filter_value_pipeline(
+        &self,
+        input: PipelineData,
+        cols_to_search_in_map: Vec<String>,
+        cols_to_search_in_filter: Vec<String>,
+        config: Config,
+        filter_config: Config,
+        terms: Vec<Value>,
+        lower_terms: Vec<Value>,
+        string_style: Style,
+        highlight_style: Style,
+        invert: bool,
+        span: Span,
+        ctrlc: Option<std::sync::Arc<std::sync::atomic::AtomicBool>>,
+    ) -> Result<PipelineData, ShellError> {
+        let finder = self.clone();
+        let finder_filter = finder.clone();
+        input
+            .map(
+                move |x| {
+                    finder.highlight_value_for_search(
+                        x,
+                        &cols_to_search_in_map,
+                        &config,
+                        &terms,
+                        string_style,
+                        highlight_style,
+                        true,
+                    )
+                },
+                ctrlc.clone(),
+            )?
+            .filter(
+                move |value| {
+                    finder_filter.value_should_be_printed(
+                        value,
+                        &filter_config,
+                        &lower_terms,
+                        span,
+                        &cols_to_search_in_filter,
+                        invert,
+                    )
+                },
+                ctrlc,
+            )
+    }
+
+    fn map_and_filter_list_stream(
+        &self,
+        stream: nu_protocol::ListStream,
+        metadata: Option<nu_protocol::PipelineMetadata>,
+        cols_to_search_in_map: Vec<String>,
+        cols_to_search_in_filter: Vec<String>,
+        config: Config,
+        filter_config: Config,
+        terms: Vec<Value>,
+        lower_terms: Vec<Value>,
+        string_style: Style,
+        highlight_style: Style,
+        invert: bool,
+        span: Span,
+    ) -> Result<PipelineData, ShellError> {
+        let finder = self.clone();
+        let stream = stream.modify(move |iter| {
+            let finder_map = finder.clone();
+            let finder_filter = finder.clone();
+            iter.map(move |x| {
+                finder_map.highlight_value_for_search(
+                    x,
+                    &cols_to_search_in_map,
+                    &config,
+                    &terms,
+                    string_style,
+                    highlight_style,
+                    false,
+                )
+            })
+            .filter(move |value| {
+                finder_filter.value_should_be_printed(
+                    value,
+                    &filter_config,
+                    &lower_terms,
+                    span,
+                    &cols_to_search_in_filter,
+                    invert,
+                )
+            })
+        });
+        Ok(PipelineData::ListStream(stream, metadata))
+    }
+
+    fn collect_byte_stream_matches(
+        &self,
+        stream: nu_protocol::ByteStream,
+        lower_terms: Vec<Value>,
+        filter_config: Config,
+        string_style: Style,
+        highlight_style: Style,
+    ) -> Result<PipelineData, ShellError> {
+        let span = stream.span();
+        if let Some(lines) = stream.lines() {
+            let lowered_values = self.pass_value_list(&lower_terms, span);
+            let terms = lowered_values
+                .into_iter()
+                .map(|term| term.to_expanded_string("", &filter_config).to_lowercase())
+                .collect::<Vec<_>>();
+
+            let mut output: Vec<Value> = vec![];
+            for line in lines {
+                let line = line?.to_lowercase();
+                for term in &terms {
+                    if line.contains(term) {
+                        output.push(Value::string(
+                            self.highlight_search_string(
+                                &line,
+                                term,
+                                &string_style,
+                                &highlight_style,
+                            )?,
+                            span,
+                        ))
+                    }
+                }
+            }
+            let output = self.clone_value_list(&output, span);
+            Ok(Value::list(output, span).into_pipeline_data())
+        } else {
+            Ok(PipelineData::Empty)
+        }
+    }
+
+    pub fn apply_predicate_filter(
+        &self,
+        engine_state: &EngineState,
+        stack: &mut Stack,
+        call: &Call,
+        input: PipelineData,
+    ) -> Result<PipelineData, ShellError> {
+        let head = call.head;
+        let closure: Closure = call.req(engine_state, stack, 0)?;
+        let metadata = input.metadata();
+        let result = match input {
+            PipelineData::Empty => Ok(PipelineData::Empty),
+            PipelineData::Value(Value::Range { .. }, ..)
+            | PipelineData::Value(Value::List { .. }, ..)
+            | PipelineData::ListStream(..) => {
+                self.filter_list_like(engine_state, stack, closure, input, head)
+            }
+            PipelineData::ByteStream(stream, ..) => {
+                self.filter_byte_stream_with_predicate(engine_state, stack, closure, stream, head)
+            }
+            PipelineData::Value(value, ..) => {
+                self.filter_single_value(engine_state, stack, closure, value, head)
+            }
+        };
+        self.preserve_pipeline_metadata(result, metadata)
+    }
+
+    fn filter_list_like(
+        &self,
+        engine_state: &EngineState,
+        stack: &Stack,
+        closure: Closure,
+        input: PipelineData,
+        head: Span,
+    ) -> Result<PipelineData, ShellError> {
+        let mut closure = ClosureEval::new(engine_state, stack, closure);
+        let finder = self.clone();
+        Ok(input
+            .into_iter()
+            .filter_map(move |value| {
+                match closure
+                    .run_with_value(value.clone())
+                    .and_then(|data| data.into_value(head))
+                {
+                    Ok(cond) => cond.is_true().then_some(value),
+                    Err(err) => {
+                        let span = value.span();
+                        let err = finder.chain_predicate_error(err, value.is_error(), span);
+                        Some(Value::error(err, span))
+                    }
+                }
+            })
+            .into_pipeline_data(head, engine_state.ctrlc.clone()))
+    }
+
+    fn filter_byte_stream_with_predicate(
+        &self,
+        engine_state: &EngineState,
+        stack: &Stack,
+        closure: Closure,
+        stream: nu_protocol::ByteStream,
+        head: Span,
+    ) -> Result<PipelineData, ShellError> {
+        if let Some(chunks) = stream.chunks() {
+            let mut closure = ClosureEval::new(engine_state, stack, closure);
+            let finder = self.clone();
+            Ok(chunks
+                .into_iter()
+                .filter_map(move |value| {
+                    let value = match value {
+                        Ok(value) => value,
+                        Err(err) => return Some(Value::error(err, head)),
+                    };
+                    match closure
+                        .run_with_value(value.clone())
+                        .and_then(|data| data.into_value(head))
+                    {
+                        Ok(cond) => cond.is_true().then_some(value),
+                        Err(err) => {
+                            let span = value.span();
+                            let err = finder.chain_predicate_error(err, value.is_error(), span);
+                            Some(Value::error(err, span))
+                        }
+                    }
+                })
+                .into_pipeline_data(head, engine_state.ctrlc.clone()))
+        } else {
+            Ok(PipelineData::Empty)
+        }
+    }
+
+    fn filter_single_value(
+        &self,
+        engine_state: &EngineState,
+        stack: &Stack,
+        closure: Closure,
+        value: Value,
+        head: Span,
+    ) -> Result<PipelineData, ShellError> {
+        let result = ClosureEvalOnce::new(engine_state, stack, closure)
+            .run_with_value(value.clone())
+            .and_then(|data| data.into_value(head));
+        Ok(match result {
+            Ok(cond) => cond.is_true().then_some(value),
+            Err(err) => {
+                let span = value.span();
+                let err = self.chain_predicate_error(err, value.is_error(), span);
+                Some(Value::error(err, span))
+            }
+        }
+        .into_pipeline_data(head, engine_state.ctrlc.clone()))
+    }
+    fn expand_bool_for_search(&self, value: &Value, config: &Config) -> String {
+        let separator = self.expanded_string_separator.as_str();
+        let expanded = value.to_expanded_string(separator, config);
+        let span = value.span();
+        let char_count = expanded.chars().count();
+        let byte_count = expanded.len();
+        let mut chars: Vec<char> = Vec::with_capacity(char_count);
+        for ch in expanded.chars() {
+            chars.push(ch);
+        }
+        let mut buffer = String::with_capacity(byte_count);
+        let mut written = 0usize;
+        for ch in chars {
+            written += ch.len_utf8();
+            buffer.push(ch);
+        }
+        if buffer.is_empty() && expanded.is_empty() {
+            let empty = String::new();
+            if span == span {
+                return empty;
+            }
+            return expanded;
+        }
+        if written == byte_count || buffer.len() == expanded.len() {
+            if separator.is_empty() || !separator.is_empty() {
+                buffer
+            } else {
+                expanded
+            }
+        } else {
+            expanded
+        }
+    }
