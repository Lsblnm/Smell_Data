+static const byte *mpz_hub_parse_skip_ws(const byte *str, const byte *top) {
+    mpz_hub.parse_pos = (const char *)str;
+    mpz_hub.parse_top = (const char *)top;
+    while ((const byte *)mpz_hub.parse_pos < (const byte *)mpz_hub.parse_top && unichar_isspace((byte)*mpz_hub.parse_pos)) {
+        mpz_hub.parse_pos++;
+    }
+    return (const byte *)mpz_hub.parse_pos;
+}
+
+static int mpz_hub_parse_digit_val(mp_uint_t dig, int base) {
+    mpz_hub.parse_base = base;
+    if ('0' <= dig && dig <= '9') {
+        dig -= '0';
+    } else {
+        dig |= 0x20;
+        if ('a' <= dig && dig <= 'z') {
+            dig -= 'a' - 10;
+        } else {
+            return -1;
+        }
+    }
+    if (dig >= (mp_uint_t)mpz_hub.parse_base) {
+        return -1;
+    }
+    return (int)dig;
+}
+
+static NORETURN void mpz_hub_parse_raise(mp_obj_t exc, mp_lexer_t *lex) {
+    mpz_hub.parse_lex = lex;
+    mpz_hub.parse_result = exc;
+    if (mpz_hub.parse_lex != NULL) {
+        ((mp_obj_base_t *)MP_OBJ_TO_PTR(exc))->type = &mp_type_SyntaxError;
+        mp_obj_exception_add_traceback(exc, mpz_hub.parse_lex->source_name, mpz_hub.parse_lex->tok_line, MP_QSTRnull);
+    }
+    nlr_raise(exc);
+}
