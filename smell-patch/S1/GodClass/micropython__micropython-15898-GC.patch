+#if MICROPY_PY_BUILTINS_POW3
+static mpz_t *mpz_hub_mpz_for_int(mp_obj_t arg, mpz_t *temp) {
+    if (mp_obj_is_small_int(arg)) {
+        mpz_init_from_int(temp, MP_OBJ_SMALL_INT_VALUE(arg));
