+int mpz_hub_int_sign(mp_obj_t self_in) {
+    if (mp_obj_is_small_int(self_in)) {
+        return mpz_hub_int_small_sign(MP_OBJ_SMALL_INT_VALUE(self_in));
+    }
+    mp_obj_int_t *self = MP_OBJ_TO_PTR(self_in);
+    if (self->mpz.len == 0) {
+        return 0;
+    } else if (self->mpz.neg == 0) {
+        return 1;
+    } else {
+        return -1;
+    }
+}
