+bool mpz_hub_int_to_bytes(mp_obj_t self_in, bool big_endian, size_t len, byte *buf) {
+    assert(mp_obj_is_exact_type(self_in, &mp_type_int));
+    mp_obj_int_t *self = MP_OBJ_TO_PTR(self_in);
