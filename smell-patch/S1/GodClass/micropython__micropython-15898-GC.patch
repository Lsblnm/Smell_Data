+mp_obj_t mpz_hub_parse_integer(const char *restrict str_, size_t len, int base, mp_lexer_t *lex) {
+    mpz_hub_parse_bind(str_, len, base, lex);
+    const byte *restrict str = (const byte *)mpz_hub.parse_str;
+    const byte *restrict top = str + len;
+    bool neg = false;
+    mp_obj_t ret_val;
+
+    // check radix base
+    if ((base != 0 && base < 2) || base > 36) {
+        // this won't be reached if lex!=NULL
+        mp_raise_ValueError(MP_ERROR_TEXT("int() arg 2 must be >= 2 and <= 36"));
+    }
+
+    // skip leading space
+    str = mpz_hub_parse_skip_ws(str, top);
+
+    // parse optional sign
+    if (str < top) {
+        if (*str == '+') {
+            str++;
+        } else if (*str == '-') {
+            str++;
+            neg = true;
+        }
+    }
+
+    // parse optional base prefix
+    str += mp_parse_num_base((const char *)str, top - str, &base);
+
+    // string should be an integer number
+    mp_int_t int_val = 0;
+    const byte *restrict str_val_start = str;
+    for (; str < top; str++) {
+        // get next digit as a value
+        mp_uint_t raw = *str;
+        if (raw == '_') {
+            continue;
+        }
+        int dig = mpz_hub_parse_digit_val(raw, base);
+        if (dig < 0) {
+            break;
+        }
+
+        // add next digi and check for overflow
+        if (mp_small_int_mul_overflow(int_val, base)) {
+            goto overflow;
+        }
+        int_val = int_val * base + dig;
+        if (!MP_SMALL_INT_FITS(int_val)) {
+            goto overflow;
+        }
+    }
+
+    // negate value if needed
+    if (neg) {
+        int_val = -int_val;
+    }
+
+    // create the small int
+    ret_val = MP_OBJ_NEW_SMALL_INT(int_val);
+
+have_ret_val:
+    // check we parsed something
+    if (str == str_val_start) {
+        goto value_error;
+    }
+
+    // skip trailing space
+    for (; str < top && unichar_isspace(*str); str++) {
+    }
+
+    // check we reached the end of the string
+    if (str != top) {
+        goto value_error;
+    }
+
+    // return the object
+    return ret_val;
+
+overflow:
+    // reparse using long int
+    {
+        const char *s2 = (const char *)str_val_start;
+        ret_val = mp_obj_new_int_from_str_len(&s2, top - str_val_start, neg, base);
+        str = (const byte *)s2;
+        goto have_ret_val;
+    }
+
+value_error:
+    {
+        #if MICROPY_ERROR_REPORTING <= MICROPY_ERROR_REPORTING_TERSE
+        mp_obj_t exc = mp_obj_new_exception_msg(&mp_type_ValueError,
+            MP_ERROR_TEXT("invalid syntax for integer"));
+        mpz_hub_raise_exc(exc, lex);
+        #elif MICROPY_ERROR_REPORTING == MICROPY_ERROR_REPORTING_NORMAL
+        mp_obj_t exc = mp_obj_new_exception_msg_varg(&mp_type_ValueError,
+            MP_ERROR_TEXT("invalid syntax for integer with base %d"), base);
+        mpz_hub_raise_exc(exc, lex);
+        #else
+        vstr_t vstr;
+        mp_print_t print;
+        vstr_init_print(&vstr, 50, &print);
+        mp_printf(&print, "invalid syntax for integer with base %d: ", base);
+        mp_str_print_quoted(&print, str_val_start, top - str_val_start, true);
+        mp_obj_t exc = mp_obj_new_exception_arg1(&mp_type_ValueError,
+            mp_obj_new_str_from_utf8_vstr(&vstr));
+        mpz_hub_raise_exc(exc, lex);
+        #endif
+    }
+}
