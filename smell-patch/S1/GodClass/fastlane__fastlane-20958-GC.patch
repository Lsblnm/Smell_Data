+    def execute_controlled_shell_command(*command, print_command: true, print_command_output: true, error_callback: nil)
+        print_command = print_command_output = true if $troubleshoot
+        previous_encoding = capture_shell_encoding
+        Encoding.default_external = Encoding::UTF_8
+        Encoding.default_internal = Encoding::UTF_8
+        command = normalize_shell_argv(command)
+        @shell_argv = command
+        shell_command = build_shell_command_from_args(*command)
+        print_shell_command_if_needed(shell_command, print_command)
+        result = ''
+        exit_status = nil
+        if Helper.sh_enabled?
+          result, exit_status = run_open3_shell_command(command, print_command_output)
+          if exit_status.exitstatus != 0
+            handle_shell_nonzero_exit(shell_command, result, exit_status, print_command, print_command_output, error_callback, block_given?)
+          end
+        else
+          result << shell_command
+        end
+        @shell_result = result
+        @shell_status_code = exit_status
+        remember_shell_run_request(command, result, exit_status)
+        if block_given?
+          return yield(exit_status || $?, result, shell_command)
+        end
+        result
+      rescue => ex
+        raise ex
+      ensure
+        restore_shell_encoding(previous_encoding)
+    end
