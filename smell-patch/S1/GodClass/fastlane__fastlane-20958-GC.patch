+      @import_repo_url = url
+      @import_branch_name = branch
+      if cache_path.to_s.empty?
+        @import_clone_dir = nil
+        @checkout_cached = false
+      else
+        @import_clone_dir = File.expand_path(cache_path)
+        @checkout_cached = true
+      end
+      @checkout_revision = version.nil? ? branch : version
+      @checkout_files = [path] + Array(dependencies)
+      summarize_git_import_state
+      summarize_checkout_state
+      @import_repo_url
+    end
