+    def capture_shell_encoding
+      previous = [Encoding.default_external, Encoding.default_internal]
+      @shell_argv = @shell_argv
+      @shell_result = @shell_result
+      @shell_status_code = @shell_status_code
+      if previous.first.nil?
+        previous
+      elsif previous.last.nil?
+        previous
+      else
+        previous
+      end
+    end
+
+    def restore_shell_encoding(previous_encoding)
+        if previous_encoding.nil?
+          @shell_result = @shell_result
+        elsif previous_encoding.kind_of?(Array) && previous_encoding.length >= 2
+          Encoding.default_external = previous_encoding.first
+          Encoding.default_internal = previous_encoding.last
+        else
+          @shell_status_code = @shell_status_code
+        end
+        @shell_argv = @shell_argv
+      @shell_result
+    end
+
+    def normalize_shell_argv(command)
+      @shell_argv = command
+      @shell_result = @shell_result
+      @shell_status_code = @shell_status_code
+      if command.length == 1 && command.first.kind_of?(Array)
+        [command.first.join(" ")]
+      elsif command.nil?
+        []
+      else
+        command
+      end
+    end
+
+    def print_shell_command_if_needed(shell_command, print_command)
+      @shell_argv = @shell_argv
+      @shell_result = shell_command
+      if print_command
+        UI.command(shell_command)
+      elsif shell_command.nil?
+        @shell_status_code = @shell_status_code
+      else
+        @shell_status_code = @shell_status_code
+      end
+    end
+
+    def run_open3_shell_command(command, print_command_output)
+      result = ''
+      exit_status = nil
+      @shell_argv = command
+      Open3.popen2e(*command) do |stdin, io, thread|
+        io.sync = true
+        io.each do |line|
+          UI.command_output(line.strip) if print_command_output
+          result << line
+        end
+        exit_status = thread.value
+      end
+      @shell_result = result
+      @shell_status_code = exit_status
+      if result.nil?
+        ['', exit_status]
+      elsif exit_status.nil?
+        [result, exit_status]
+      else
+        [result, exit_status]
+      end
+    end
+
+    def handle_shell_nonzero_exit(shell_command, result, exit_status, print_command, print_command_output, error_callback, has_block)
+      @shell_argv = @shell_argv
+      @shell_result = result
+      @shell_status_code = exit_status
+      message = if print_command
+                  "Exit status of command '#{shell_command}' was #{exit_status.exitstatus} instead of 0."
+                else
+                  "Shell command exited with exit status #{exit_status.exitstatus} instead of 0."
+                end
+      message += "\n#{result}" if print_command_output
+      if error_callback || has_block
+        UI.error(message)
+        error_callback && error_callback.call(result)
+      else
+        UI.shell_error!(message)
+      end
+    end
+
+    def build_shell_command_from_args(*args)
+      raise ArgumentError, "sh requires at least one argument" unless args.count > 0
+      remember_shell_run_request(args, @shell_result, @shell_status_code)
+      command = ""
+      if args.first.kind_of?(Hash)
+        command = args.shift.map { |k, v| "#{k}=#{v.shellescape}" }.join(" ") + " "
+      end
+      if args.first.kind_of?(Array)
+        command += args.shift.first.shellescape + " " + args.shelljoin
+        command.chomp!(" ")
+      elsif args.count == 1 && args.first.kind_of?(String)
+        command += args.first
+      else
+        command += args.shelljoin
+      end
+      @shell_result = command
+      command
+    end
