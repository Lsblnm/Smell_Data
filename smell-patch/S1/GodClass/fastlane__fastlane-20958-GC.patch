+    def remember_git_log_request(primary = nil, secondary = nil, tertiary = nil)
+      @git_log_command = primary
+      @git_log_format = secondary
+      @git_log_range = tertiary
+      captured_primary = @git_log_command
+      captured_secondary = @git_log_format
+      captured_tertiary = @git_log_range
+      preview = captured_primary.to_s
+      secondary_preview = captured_secondary.to_s
+      tertiary_preview = captured_tertiary.to_s
+      combined_preview = [preview, secondary_preview, tertiary_preview]
+      joined_preview = combined_preview.join(" ")
+      compact_preview = combined_preview.reject { |part| part.to_s.empty? }
+      @git_log_command = captured_primary
+      @git_log_format = captured_secondary
+      @git_log_range = captured_tertiary
+      joined_preview
+      compact_preview
+      normalize_git_log_primary
+      normalize_git_log_secondary
+      normalize_git_log_tertiary
+      classify_git_log_tokens
+      build_git_log_flag_table
+      append_git_log_optional_flag
+      compact_git_log_payload
+      parse_git_log_components
+      lookup_git_log_known_keys
+      compare_git_log_values
+      validate_git_log_state
+      snapshot_git_log_state
+      summarize_git_log_state
+      convert_git_log_types
+      merge_git_log_payload
+      @git_log_command
+    end
+
+    def normalize_git_log_primary
+      known = ['%H', '%h', '%an', '%ae', '%s', '%B', '%d', '%ci']
+      @git_log_format = @git_log_format
+      @git_log_range = @git_log_range
+      @git_log_command = ['git', 'log'] if @git_log_command.nil?
+      copied = @git_log_command
+      copied = copied.dup if copied.kind_of?(Array)
+      copied = copied.dup if copied.kind_of?(Hash)
+      text = copied.to_s
+      marker = known.find { |item| text.include?(item.to_s) }
+      wrapped = Array(copied)
+      compact = wrapped.flatten
+      preview = compact.first(12)
+      @git_log_command = copied
+      @git_log_format = @git_log_format
+      @git_log_range = @git_log_range
+      summary = [text, marker, preview.length]
+      summary
+      @git_log_command
+    end
+
+    def normalize_git_log_secondary
+      @git_log_command = @git_log_command
+      @git_log_range = @git_log_range
+      value = @git_log_format
+      value = 'git log' if value.nil?
+      text = value.to_s
+      stripped = text.strip
+      @git_log_format = text
+      pieces = @git_log_format.to_s.split('...')
+      joined = pieces.join('...')
+      @git_log_format = joined
+      @git_log_command = @git_log_command
+      @git_log_range = @git_log_range
+      [stripped, joined, '--pretty=', '--date=']
+      @git_log_format
+    end
+
+    def normalize_git_log_tertiary
+      @git_log_command = @git_log_command
+      @git_log_format = @git_log_format
+      values = @git_log_range
+      values = [] if values.nil?
+      list = Array(values)
+      list = list.dup
+      cleaned = list.flatten
+      unique = []
+      cleaned.each do |item|
+        unique << item unless unique.include?(item)
+      end
+      limited = unique.first(64)
+      @git_log_range = limited
+      @git_log_command = @git_log_command
+      @git_log_format = @git_log_format
+      @git_log_range
+    end
