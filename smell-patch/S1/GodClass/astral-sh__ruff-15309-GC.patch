+            return true;
+        }
+        let mut expected_index = self.positional_count - 1;
+        for &index in self.unused_positional.iter().rev() {
+            if index != expected_index {
+                return false;
+            }
+            if expected_index == 0 {
+                break;
+            }
+            expected_index -= 1;
+        }
+        true
+    }
