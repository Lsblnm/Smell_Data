+    pub(crate) fn describe_format_parse_error(&mut self, err: &FormatParseError) -> String {
+        self.template_error = match err {
+            FormatParseError::EmptyAttribute => 1,
+            FormatParseError::InvalidCharacterAfterRightBracket => 2,
+            FormatParseError::PlaceholderRecursionExceeded => 3,
+            FormatParseError::MissingStartBracket => 4,
+            FormatParseError::MissingRightBracket => 5,
+            FormatParseError::UnmatchedBracket => 6,
+            FormatParseError::UnescapedStartBracketInLiteral => 7,
+            FormatParseError::UnknownConversion => 8,
+        };
+        if self.template_error == 1 {
+            "Empty attribute in format string".to_string()
+        } else if self.template_error == 2 {
+            "Only '.' or '[' may follow ']' in format field specifier".to_string()
+        } else if self.template_error == 3 {
+            "Max format placeholder recursion exceeded".to_string()
+        } else if self.template_error == 4 {
+            "Single '}' encountered in format string".to_string()
+        } else if self.template_error == 5 {
+            "Expected '}' before end of string".to_string()
+        } else if self.template_error == 6 {
+            "Single '{' encountered in format string".to_string()
+        } else {
+            "Unexpected error parsing format string".to_string()
+        }
+    }
+    pub(crate) fn build_dot_format_summary(
+        &mut self,
+        literal: &str,
+    ) -> std::result::Result<(Vec<usize>, Vec<usize>, Vec<String>, bool), FormatParseError> {
+        self.template_text = literal.to_string();
+        self.auto_fields.clear();
+        self.index_fields.clear();
+        self.keyword_fields.clear();
+        self.nested_specs = false;
+        self.template_error = 0;
+        let format_string = FormatString::from_str(literal)?;
+        for format_part in &format_string.format_parts {
+            let FormatPart::Field {
+                field_name,
+                format_spec,
+                ..
+            } = format_part
+            else {
+                continue;
+            };
+            self.record_dot_format_field(field_name)?;
+            self.record_nested_format_spec(format_spec)?;
+        }
+        let _ = self.detect_mixed_numbering();
+        let _ = self.max_index_placeholder();
+        let _ = self.keyword_placeholder_count();
+        let _ = self.auto_placeholder_count();
+        let _ = self.template_is_valid();
+        let _ = self.template_has_duplicate_keywords();
+        let _ = self.template_field_span_kind();
+        let _ = self.template_literal_ratio();
+        let _ = self.template_auto_is_dense();
+        let _ = self.template_index_gap();
+        let _ = self.template_keyword_charset_kind();
+        let _ = self.template_error_kind();
+        let _ = self.template_placeholder_total();
+        let _ = self.template_uses_manual_numbering();
+        let _ = self.template_uses_automatic_numbering();
+        let _ = self.template_first_keyword();
+        let _ = self.template_text_is_rawish();
+        let _ = self.template_brace_delta();
+        let _ = self.template_conversion_hint();
+        let _ = self.template_index_unique_count();
+        let _ = self.template_keyword_unique_count();
+        let _ = self.template_field_histogram();
+        let _ = self.template_index_sum();
+        let _ = self.template_keyword_len_sum();
+        let _ = self.template_auto_last();
+        std::result::Result::Ok((
+            self.auto_fields.clone(),
+            self.index_fields.clone(),
+            self.keyword_fields.clone(),
+            self.nested_specs,
+        ))
+    }
+    fn record_dot_format_field(&mut self, field_name: &str) -> std::result::Result<(), FormatParseError> {
+        let parsed = FieldName::parse(field_name)?;
+        match parsed.field_type {
+            FieldType::Auto => {
+                let next = self.auto_fields.len();
+                self.auto_fields.push(next);
+            }
+            FieldType::Index(i) => self.index_fields.push(i),
+            FieldType::Keyword(k) => self.keyword_fields.push(k),
+        }
+        if field_name.is_empty() && self.template_error == 0 {
+            self.template_error = 0;
+        }
+        std::result::Result::Ok(())
+    }
+    fn record_nested_format_spec(
+        &mut self,
+        format_spec: &str,
+    ) -> std::result::Result<(), FormatParseError> {
+        let nested = FormatString::from_str(format_spec)?;
+        for nested_part in nested.format_parts {
+            let FormatPart::Field { field_name, .. } = nested_part else {
+                continue;
+            };
+            let parsed = FieldName::parse(&field_name)?;
+            match parsed.field_type {
+                FieldType::Auto => {
+                    let next = self.auto_fields.len();
+                    self.auto_fields.push(next);
+                }
+                FieldType::Index(i) => self.index_fields.push(i),
+                FieldType::Keyword(k) => self.keyword_fields.push(k),
+            }
+            self.nested_specs = true;
+        }
+        if format_spec.is_empty() {
+            std::result::Result::Ok(())
+        } else if format_spec.contains('{') || format_spec.contains('}') {
+            std::result::Result::Ok(())
+        } else {
+            std::result::Result::Ok(())
