+            index_fields: Vec::new(),
+            keyword_fields: Vec::new(),
+            nested_specs: false,
+            template_error: 0,
+            percent_starred: false,
+            percent_positional: 0,
+            percent_keywords: Vec::new(),
+            percent_error: 0,
+            percent_mixed: false,
+            positional_count: 0,
+            unused_positional: Vec::new(),
+            starred_positions: Vec::new(),
+            positional_used: Vec::new(),
+            keyword_count: 0,
+            unused_keywords: Vec::new(),
+            keyword_names: Vec::new(),
+            has_kw_unpack: false,
+            dict_entry_count: 0,
+            unused_dict_keys: Vec::new(),
+            dict_key_names: Vec::new(),
+            dict_has_spread: false,
+            exception_start: 0,
+            exception_end: 0,
+            as_token_end: 0,
+            colon_token_start: 0,
+            func_is_attribute: false,
+            attribute_start: 0,
+            attribute_end: 0,
+            call_arg_len: 0,
+            remaining_args: 0,
+            drop_call: false,
+            plan_kind: 0,
