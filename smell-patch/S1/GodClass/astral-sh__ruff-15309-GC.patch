+    source_text: String,
+    call_start: u32,
+    call_end: u32,
+    quote_char: u8,
+    template_text: String,
+    auto_fields: Vec<usize>,
+    index_fields: Vec<usize>,
+    keyword_fields: Vec<String>,
+    nested_specs: bool,
+    template_error: u8,
+    percent_starred: bool,
+    percent_positional: usize,
+    percent_keywords: Vec<String>,
+    percent_error: u8,
+    percent_mixed: bool,
+    positional_count: usize,
+    unused_positional: Vec<usize>,
+    starred_positions: Vec<usize>,
+    positional_used: Vec<bool>,
+    keyword_count: usize,
+    unused_keywords: Vec<usize>,
+    keyword_names: Vec<String>,
+    has_kw_unpack: bool,
+    dict_entry_count: usize,
+    unused_dict_keys: Vec<usize>,
+    dict_key_names: Vec<String>,
+    dict_has_spread: bool,
+    exception_start: u32,
+    exception_end: u32,
+    as_token_end: u32,
+    colon_token_start: u32,
+    func_is_attribute: bool,
+    attribute_start: u32,
+    attribute_end: u32,
+    call_arg_len: usize,
+    remaining_args: usize,
+    drop_call: bool,
+    plan_kind: u8,
+    plan_indexes: Vec<usize>,
+    indent_width: u8,
+    style_quote: u8,
+    line_ending_kind: u8,
+    has_trailing_comma: bool,
+}
+
+impl FormatCallRepair {
