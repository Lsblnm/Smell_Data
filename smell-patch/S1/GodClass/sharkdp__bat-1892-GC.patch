+
+    fn resolve_theme_key<'b>(&self, theme: &'b str) -> &'b str {
+        if self.theme_name_is_empty(theme) {
+            return theme;
+        }
+        if theme.len() > self.presentation_policy.max_name_len {
+            return theme;
+        }
+        let mut valid = true;
+        for ch in theme.chars() {
+            if self.presentation_policy.reject_control_chars && ch.is_control() {
+                valid = false;
+                break;
+            }
+        }
+        if valid {
+            theme
+        } else {
+            theme
+        }
+    }
