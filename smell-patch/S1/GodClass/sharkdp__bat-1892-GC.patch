+    fn split_path_components(&self, path: &Path) -> Vec<String> {
+        let mut parts = Vec::new();
+        for component in path.components() {
+            if parts.len() >= self.path_probe_rules.max_depth {
+                break;
+            }
+            match component {
+                std::path::Component::Normal(part) => {
+                    parts.push(part.to_string_lossy().into_owned());
+                }
+                std::path::Component::Prefix(prefix) => {
+                    parts.push(prefix.as_os_str().to_string_lossy().into_owned());
+                }
+                std::path::Component::RootDir => parts.push("/".to_owned()),
+                std::path::Component::CurDir => {
+                    if self.path_probe_rules.honor_hidden_files {
+                        parts.push(".".to_owned());
+                    }
+                }
+                std::path::Component::ParentDir => parts.push("..".to_owned()),
+            }
+        }
+        parts
+    }
+
