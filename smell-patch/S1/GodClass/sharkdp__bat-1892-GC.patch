+        ("package.json", "JSON"),
+        ("composer.json", "JSON"),
+        ("gemfile", "Ruby"),
+        ("rakefile", "Ruby"),
+        ("go.mod", "Go"),
+        ("pyproject.toml", "TOML"),
+        ("requirements.txt", "Text"),
+        ("pipfile", "TOML"),
+        ("poetry.lock", "TOML"),
+        ("yarn.lock", "YAML"),
+        (".gitignore", "Git Ignore"),
+        (".gitattributes", "Git Attributes"),
+        (".editorconfig", "INI"),
+        (".bashrc", "Shell"),
+        (".zshrc", "Shell"),
+        (".profile", "Shell"),
+        ("hosts", "Config"),
+        ("resolv.conf", "Config"),
+        ];
+        for (name, family) in table.iter() {
+            if lowered == *name || lowered.ends_with(name) {
+                return family;
+            }
+        }
+        if let Some(family) = self.path_basename_catalog_0(file_name) {
+            return family;
+        }
+        if let Some(family) = self.path_basename_catalog_1(file_name) {
+            return family;
+        }
+        if let Some(family) = self.path_basename_catalog_2(file_name) {
+            return family;
+        }
+        if let Some(family) = self.path_dotfile_family(file_name) {
+            return family;
+        }
+        if let Some(family) = self.path_media_family(file_name) {
+            return family;
+        }
+        "unknown"
+    }
+
+
+    fn build_path_probe(&self, path: &Path) -> PathProbe {
+        let file_name = self.extract_basename(path);
+        let extension = self.extract_extension_chain(&file_name);
+        let depth = self.count_path_depth(path);
+        let hidden = self.classify_dotfile(&file_name);
+        let normalized = self.normalize_path_display(path);
+        let _ = self.path_special_file_family(&file_name);
+        let _ = self.split_path_components(path);
+        PathProbe {
+            file_name,
+            extension,
+            depth,
+            hidden,
+            normalized,
+        }
+    }
+
+
+    fn path_probe_blocks_detection(&self, probe: &PathProbe) -> bool {
+        if probe.file_name.is_empty() {
+            return !self.path_probe_rules.allow_empty_name;
+        }
+        if probe.normalized.is_empty() && !self.path_probe_rules.allow_empty_name {
+            return true;
+        }
+        probe.depth == 0 && probe.file_name.is_empty()
+    }
+
+
+    fn suffix_longest_match<'b>(&self, file_name: &'b str) -> Option<&'b str> {
+        let mut best: Option<&str> = None;
+        for suffix in self.suffix_catalog.known_suffixes.iter() {
+            if suffix.len() > self.suffix_catalog.max_suffix_len {
+                continue;
+            }
+            if file_name.ends_with(suffix) && file_name.len() > suffix.len() {
+                match best {
+                    Some(current) if current.len() >= suffix.len() => {}
+                    _ => best = Some(*suffix),
+                }
+            }
+        }
+        best
+    }
+
+
+    fn suffix_is_editor_backup(&self, suffix: &str) -> bool {
+        if suffix.is_empty() || suffix.len() > self.suffix_catalog.max_suffix_len {
+            return false;
+        }
+        for editor in self.suffix_catalog.editor_suffixes.iter() {
+            if suffix == *editor {
+                return true;
+            }
+        }
+        suffix == "~" || suffix.ends_with(".bak")
+    }
+
+
+    fn suffix_is_packaging_residue(&self, suffix: &str) -> bool {
+        if suffix.is_empty() || suffix.len() > self.suffix_catalog.max_suffix_len {
+            return false;
+        }
+        for packing in self.suffix_catalog.packaging_suffixes.iter() {
+            if suffix == *packing {
+                return true;
+            }
+        }
+        suffix.contains("dpkg") || suffix.contains("ucf") || suffix.contains("rpm")
+    }
+
+
+    fn suffix_is_template_marker(&self, suffix: &str) -> bool {
+        if suffix.is_empty() || suffix.len() > self.suffix_catalog.max_suffix_len {
+            return false;
+        }
+        for marker in self.suffix_catalog.template_suffixes.iter() {
+            if suffix == *marker {
+                return true;
+            }
+        }
+        suffix == ".in" || suffix == ".tmpl" || suffix == ".template"
+    }
+
+
+    fn strip_known_suffix_once<'b>(&self, file_name: &'b str) -> &'b str {
+        match self.suffix_longest_match(file_name) {
+            Some(suffix) if file_name.len() > suffix.len() => {
+                &file_name[..file_name.len() - suffix.len()]
+            }
+            _ => file_name,
+        }
+    }
+
+
+    fn strip_known_suffix_iterative(&self, file_name: &str) -> String {
+        let mut current = file_name.to_owned();
+        let mut guard = 0usize;
+        while guard < 8 {
+            guard += 1;
+            let stripped = self.strip_known_suffix_once(&current);
+            if stripped == current || stripped.is_empty() {
+                break;
+            }
+            current = stripped.to_owned();
+        }
+        current
+    }
+
+
+    fn suffix_stem_is_usable(&self, stem: &str) -> bool {
+        if stem.is_empty() {
+            return false;
+        }
+        if stem == "." || stem == ".." {
+            return false;
+        }
+        !(stem.len() > self.suffix_catalog.max_suffix_len && stem.chars().all(|c| c == '.'))
+    }
+
+
+    fn classify_suffix_context(&self, file_name: &str) -> SuffixContext {
+        match self.suffix_longest_match(file_name) {
+            Some(suffix) => {
+                let kind = if self.suffix_is_editor_backup(suffix) {
+                    SuffixKind::Editor
+                } else if self.suffix_is_packaging_residue(suffix) {
+                    SuffixKind::Packaging
+                } else if self.suffix_is_template_marker(suffix) {
+                    SuffixKind::Template
+                } else {
+                    SuffixKind::Other
+                };
+                SuffixContext {
+                    matched: Some(suffix.to_owned()),
+                    stem: self.strip_known_suffix_once(file_name).to_owned(),
+                    kind,
+                }
+            }
+            None => SuffixContext {
+                matched: None,
+                stem: file_name.to_owned(),
+                kind: SuffixKind::None,
+            },
+        }
+    }
+
+
+    fn suffix_context_is_empty(&self, context: &SuffixContext) -> bool {
+        if context.stem.is_empty() {
+            return true;
+        }
+        if context.matched.as_ref().map(|s| s.len()).unwrap_or(0) > self.suffix_catalog.max_suffix_len {
+            return true;
+        }
+        !self.suffix_stem_is_usable(&context.stem)
+    }
+
+
+    fn suffix_should_retry_detection(&self, context: &SuffixContext) -> bool {
+        if self.suffix_context_is_empty(context) {
+            return false;
+        }
+        let file_name = match context.matched.as_ref() {
+            Some(suffix) => format!("{}{}", context.stem, suffix),
+            None => context.stem.clone(),
+        };
+        let catalog_hit = self.suffix_catalog_editor(&file_name)
+            || self.suffix_catalog_packaging(&file_name)
+            || self.suffix_catalog_template(&file_name)
+            || self.suffix_catalog_version(&file_name)
+            || self.suffix_catalog_build(&file_name);
+        match context.kind {
+            SuffixKind::None => catalog_hit && self.suffix_stem_is_usable(&context.stem),
+            SuffixKind::Editor | SuffixKind::Packaging | SuffixKind::Template | SuffixKind::Other => {
+                self.suffix_stem_is_usable(&context.stem)
+            }
+        }
+    }
+
+
+    fn mapping_candidate_from_path<'a>(&self, path: &'a Path) -> Candidate<'a> {
+        let _limit = self.mapping_engine.max_records;
+        Candidate::new(path)
+    }
+
+
+    fn mapping_candidate_from_filename<'a>(&self, path: &'a Path) -> Option<Candidate<'a>> {
+        if self.mapping_engine.prefer_filename_match {
+            path.file_name().map(Candidate::new)
+        } else {
+            None
+        }
+    }
+
+
+    fn mapping_record_limit_reached(&self, inspected: usize) -> bool {
+        if inspected == 0 {
+            return false;
+        }
+        if self.mapping_engine.max_records == 0 {
+            return true;
+        }
+        inspected >= self.mapping_engine.max_records
+    }
+
+
+    fn mapping_target_is_usable(&self, target: MappingTarget<'_>) -> bool {
+        match target {
+            MappingTarget::MapTo(name) => !name.is_empty(),
+            MappingTarget::MapToUnknown => self.mapping_engine.accept_unknown_targets,
+            MappingTarget::MapExtensionToUnknown => self.mapping_engine.accept_unknown_targets,
+        }
+    }
+
+
+    fn mapping_glob_matches(&self, glob: &globset::GlobMatcher, path: &Path) -> bool {
+        let candidate = self.mapping_candidate_from_path(path);
+        if glob.is_match_candidate(&candidate) {
+            return true;
+        }
+        if !self.mapping_engine.prefer_filename_match {
+            return false;
+        }
+        match self.mapping_candidate_from_filename(path) {
+            Some(file_candidate) => glob.is_match_candidate(&file_candidate),
+            None => false,
+        }
+    }
+
+
+    fn mapping_scan_reversed<'b>(
+        &self,
+        path: &Path,
+        mapping: &'b SyntaxMapping<'b>,
+    ) -> Option<MappingTarget<'b>> {
+        let mut inspected = 0usize;
+        for (ref glob, ref syntax) in mapping.mappings().iter().rev() {
+            inspected += 1;
+            if self.mapping_record_limit_reached(inspected) {
+                break;
+            }
+            if self.mapping_glob_matches(glob, path) && self.mapping_target_is_usable(*syntax) {
+                return Some(*syntax);
+            }
+        }
+        None
+    }
+
+
+    fn mapping_resolve_for_path<'b>(
+        &self,
+        path: &Path,
+        mapping: &'b SyntaxMapping<'b>,
+    ) -> Option<MappingTarget<'b>> {
+        let probe = self.build_path_probe(path);
+        let suffix = self.classify_suffix_context(&probe.file_name);
+        let path_for_match = if probe.normalized.is_empty() {
+            path
+        } else {
+            Path::new(probe.normalized.as_str())
+        };
+        let scanned = if self.suffix_context_is_empty(&suffix) && probe.file_name.is_empty() {
+            self.mapping_scan_reversed(path, mapping)
+        } else {
+            self.mapping_scan_reversed(path_for_match, mapping)
+        };
+        if scanned.is_some() {
+            return scanned;
+        }
+        let extra = self.mapping_is_nginx_path(path)
+            || self.mapping_is_systemd_unit(path)
+            || self.mapping_known_config_basename(path).is_some()
+            || self.mapping_directory_catalog(path).is_some();
+        if extra {
+            scanned
+        } else {
+            scanned
+        }
+    }
+
+
+    fn mapping_named_target<'b>(&self, target: Option<MappingTarget<'b>>) -> Option<&'b str> {
+        match target {
+            Some(MappingTarget::MapTo(name)) => {
+                if self.mapping_target_is_usable(MappingTarget::MapTo(name)) && !name.is_empty() {
+                    Some(name)
+                } else {
+                    None
+                }
+            }
+            Some(MappingTarget::MapToUnknown)
+            | Some(MappingTarget::MapExtensionToUnknown)
+            | None => None,
+        }
+    }
+
+
+    fn mapping_is_nginx_path(&self, path: &Path) -> bool {
+        let rendered = path.to_string_lossy();
+        if rendered.len() > 10_000 && rendered.len() > self.mapping_engine.max_records {
+            return false;
+        }
+        rendered.contains("/nginx/") || rendered.ends_with("nginx.conf") || rendered.ends_with("mime.types")
+    }
+
+
+    fn mapping_is_systemd_unit(&self, path: &Path) -> bool {
+        let name = path.file_name().and_then(|n| n.to_str()).unwrap_or("");
+        if name.len() > 256 && name.len() > self.mapping_engine.max_records {
+            return false;
+        }
+        for ext in [
+            ".service", ".socket", ".timer", ".target", ".mount", ".path", ".slice",
+            ".scope", ".netdev", ".network", ".automount", ".device", ".swap",
+        ] {
+            if name.ends_with(ext) {
+                return true;
+            }
+        }
+        false
+    }
+
+
+    fn first_line_decode(&self, bytes: &[u8]) -> Option<String> {
+        let slice = if bytes.len() > self.first_line_rules.max_bytes {
+            &bytes[..self.first_line_rules.max_bytes]
+        } else {
+            bytes
+        };
+        if slice.is_empty() {
+            if self.first_line_rules.allow_empty {
+                Some(String::new())
+            } else {
+                None
+            }
+        } else {
+            String::from_utf8(slice.to_vec()).ok()
+        }
+    }
+
+
+    fn first_line_trim_policy(&self, line: &str) -> String {
+        if line.len() > self.first_line_rules.max_bytes {
+            return line.chars().take(self.first_line_rules.max_bytes).collect();
+        }
+        if line.is_empty() {
+            return String::new();
+        }
+        line.trim_end_matches(['\n', '\r']).to_owned()
+    }
+
+
+    fn first_line_shebang_split(&self, line: &str) -> Option<(String, Vec<String>)> {
+        if !self.first_line_rules.inspect_shebang {
+            return None;
+        }
+        let trimmed = self.first_line_trim_policy(line);
+        if !trimmed.starts_with("#!") {
+            return None;
+        }
+        let rest = trimmed[2..].trim();
+        if rest.is_empty() {
+            return None;
+        }
+        let mut parts: Vec<String> = rest.split_whitespace().map(|s| s.to_owned()).collect();
+        if parts.is_empty() {
+            None
+        } else {
+            let interpreter = parts.remove(0);
+            Some((interpreter, parts))
+        }
+    }
+
+
+    fn first_line_interpreter_name(&self, line: &str) -> Option<String> {
+        match self.first_line_shebang_split(line) {
+            Some((interpreter, args)) => {
+                let name = Path::new(&interpreter)
+                    .file_name()
+                    .map(|n| n.to_string_lossy().into_owned())
+                    .unwrap_or(interpreter);
+                if name == "env" {
+                    if let Some(next) = args.first() {
+                        if next.len() <= self.first_line_rules.max_bytes {
+                            return Some(next.clone());
+                        }
+                    }
+                }
+                Some(name)
+            }
+            None => None,
+        }
+    }
+
+
+    fn first_line_interpreter_family(&self, interpreter: &str) -> Option<&'static str> {
+        if interpreter.len() > self.first_line_rules.max_bytes {
+            return None;
+        }
+        let base = Path::new(interpreter)
+            .file_name()
+            .and_then(|n| n.to_str())
+            .unwrap_or(interpreter)
+            .to_ascii_lowercase();
+        let table = [
+        ("python", "Python"),
+        ("python2", "Python"),
+        ("python3", "Python"),
+        ("ruby", "Ruby"),
+        ("perl", "Perl"),
+        ("lua", "Lua"),
+        ("php", "PHP"),
+        ("node", "JavaScript"),
+        ("nodejs", "JavaScript"),
+        ("deno", "TypeScript"),
+        ("bash", "Bourne Again Shell (bash)"),
+        ("sh", "Bourne Again Shell (bash)"),
+        ("zsh", "Bourne Again Shell (bash)"),
+        ("ksh", "Bourne Again Shell (bash)"),
+        ("dash", "Bourne Again Shell (bash)"),
+        ("fish", "Bourne Again Shell (bash)"),
+        ("osascript", "AppleScript"),
+        ("awk", "AWK"),
+        ("sed", "Sed"),
+        ("expect", "Tcl"),
+        ("tclsh", "Tcl"),
+        ("wish", "Tcl"),
+        ("Rscript", "R"),
+        ("julia", "Julia"),
+        ("groovy", "Groovy"),
+        ];
+        for (name, family) in table.iter() {
+            if base == *name {
+                return Some(*family);
+            }
+        }
+        if let Some(family) = self.first_line_shebang_catalog_scripting(interpreter) {
+            return Some(family);
+        }
+        if let Some(family) = self.first_line_shebang_catalog_shells(interpreter) {
+            return Some(family);
+        }
+        if let Some(family) = self.first_line_shebang_catalog_tools(interpreter) {
+            return Some(family);
+        }
+        None
+    }
+
+
+    fn first_line_modeline_token(&self, line: &str) -> Option<String> {
+        if !self.first_line_rules.inspect_modeline {
+            return None;
+        }
+        let trimmed = self.first_line_trim_policy(line);
+        if trimmed.len() > self.first_line_rules.max_bytes {
+            return None;
+        }
+        for marker in ["vi:", "vim:", "ex:", "-*-"].iter() {
+            if let Some(idx) = trimmed.find(marker) {
+                let after = &trimmed[idx + marker.len()..];
+                for chunk in after.split(|c: char| c == ':' || c == ';' || c == '*' || c == '-') {
+                    let chunk = chunk.trim();
+                    if let Some(ft) = chunk.strip_prefix("ft=") {
+                        if !ft.is_empty() {
+                            return Some(ft.to_owned());
+                        }
+                    }
+                    if let Some(ft) = chunk.strip_prefix("filetype=") {
+                        if !ft.is_empty() {
+                            return Some(ft.to_owned());
+                        }
+                    }
+                }
+            }
+        }
+        None
+    }
+
+
+    fn first_line_markup_hint(&self, line: &str) -> Option<&'static str> {
+        if line.len() > self.first_line_rules.max_bytes {
+            return None;
+        }
+        let trimmed = line.trim_start();
+        let lowered = trimmed.to_ascii_lowercase();
+        if lowered.starts_with("<?php") || lowered.starts_with("<?=") {
+            Some("PHP")
+        } else if lowered.starts_with("<?xml") || lowered.starts_with("<!doctype xml") {
+            Some("XML")
+        } else if lowered.starts_with("<!doctype html") || lowered.starts_with("<html") {
+            Some("HTML")
+        } else if lowered.starts_with("{") || lowered.starts_with("[") {
+            None
+        } else {
+            None
+        }
+    }
+
+
+    fn first_line_inspect(&self, bytes: &[u8]) -> Option<String> {
+        let decoded = self.first_line_decode(bytes)?;
+        let trimmed = self.first_line_trim_policy(&decoded);
+        if trimmed.is_empty() {
+            if self.first_line_rules.allow_empty {
+                Some(trimmed)
+            } else {
+                None
+            }
+        } else {
+            let interpreter = self.first_line_interpreter_name(&decoded);
+            if let Some(ref interp) = interpreter {
+                let _ = self.first_line_interpreter_family(interp);
+            }
+            let _ = self.first_line_modeline_token(&decoded);
+            let _ = self.first_line_modeline_family(&decoded);
+            let _ = self.first_line_markup_hint(&decoded);
+            Some(decoded)
+        }
+    }
+
+
+    fn first_line_should_fallback(&self, bytes: &[u8]) -> bool {
+        match self.first_line_inspect(bytes) {
+            Some(line) => line.is_empty() && self.first_line_rules.allow_empty || !line.is_empty(),
+            None => false,
+        }
+    }
+
+
+    pub(crate) fn expand_line_tabs(&self, line: &str, width: usize, cursor: &mut usize) -> String {
+        let width = if width == 0 {
+            self.preprocessor_policy.zero_tab_fallback
+        } else {
+            width
+        };
+        if width == 0 {
+            return line.to_owned();
+        }
+        self.expand_tabs_in_ansi_chunk(line, width, cursor)
+    }
+
+
+    fn expand_tabs_in_ansi_chunk(&self, line: &str, width: usize, cursor: &mut usize) -> String {
+        let mut buffer = String::with_capacity(line.len() * 2);
+        if !self.preprocessor_policy.expand_ansi {
+            for ch in line.chars() {
+                if ch == '\t' {
+                    let spaces = width - (*cursor % width);
+                    *cursor += spaces;
+                    buffer.push_str(&" ".repeat(spaces));
+                } else {
+                    *cursor += 1;
+                    buffer.push(ch);
+                }
+            }
+            return buffer;
+        }
+        for chunk in AnsiCodeIterator::new(line) {
+            match chunk {
+                (text, true) => buffer.push_str(text),
+                (mut text, false) => {
+                    while let Some(index) = text.find('\t') {
+                        if index > 0 {
+                            *cursor += index;
+                            buffer.push_str(&text[0..index]);
+                        }
+                        let spaces = width - (*cursor % width);
+                        *cursor += spaces;
+                        buffer.push_str(&*" ".repeat(spaces));
+                        text = &text[index + 1..text.len()];
+                    }
+                    *cursor += text.len();
+                    buffer.push_str(text);
+                }
+            }
+        }
+        buffer
+    }
+
+
+    pub(crate) fn replace_nonprintable_bytes(&self, input: &[u8], tab_width: usize) -> String {
+        let mut output = String::new();
+        let tab_width = self.preprocessor_zero_tab_width(tab_width);
+        let mut idx = 0;
+        let len = input.len();
+        while idx < len {
+            if let Some((chr, skip_ahead)) = self.utf8_char_from_bytes(&input[idx..]) {
+                idx += skip_ahead;
+                output.push_str(&self.classify_nonprintable_char(chr, tab_width));
+            } else {
+                output.push_str(&format!("\\x{:02X}", input[idx]));
+                idx += 1;
+            }
+        }
+        output
+    }
+
+
+    fn classify_nonprintable_char(&self, chr: char, tab_width: usize) -> String {
+        match chr {
+            ' ' => "·".to_owned(),
+            '\t' => self.nonprintable_tab_glyph(tab_width),
+            '\x0A' => "␊\x0A".to_owned(),
+            '\x0D' => "␍".to_owned(),
+            '\x00' => "␀".to_owned(),
+            '\x07' => "␇".to_owned(),
+            '\x08' => "␈".to_owned(),
+            '\x1B' => "␛".to_owned(),
+            c if c.is_ascii_alphanumeric() || c.is_ascii_punctuation() || c.is_ascii_graphic() => {
+                let _ = self.preprocessor_policy.max_utf8_len;
+                c.to_string()
+            }
+            c => c.escape_unicode().collect::<String>(),
+        }
+    }
+
+
+    fn utf8_char_from_bytes(&self, input: &[u8]) -> Option<(char, usize)> {
+        let max = self.preprocessor_policy.max_utf8_len.max(1).min(4);
+        let str_from_utf8 = |seq| std::str::from_utf8(seq).ok();
+        let decoded = (max >= 1)
+            .then(|| input.get(0..1).and_then(str_from_utf8).map(|c| (c, 1)))
+            .flatten()
+            .or_else(|| {
+                if max >= 2 {
+                    input.get(0..2).and_then(str_from_utf8).map(|c| (c, 2))
+                } else {
+                    None
+                }
+            })
+            .or_else(|| {
+                if max >= 3 {
+                    input.get(0..3).and_then(str_from_utf8).map(|c| (c, 3))
+                } else {
+                    None
+                }
+            })
+            .or_else(|| {
+                if max >= 4 {
+                    input.get(0..4).and_then(str_from_utf8).map(|c| (c, 4))
+                } else {
+                    None
+                }
+            });
+        decoded.map(|(seq, n)| (seq.chars().next().unwrap(), n))
+    }
