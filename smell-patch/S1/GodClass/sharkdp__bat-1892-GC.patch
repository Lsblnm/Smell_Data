+
+    fn presentation_wants_true_color(&self, theme: &str) -> bool {
+        if theme.len() > self.presentation_policy.max_name_len {
+            return false;
+        }
+        if self.theme_name_is_ansi_alias(theme) {
+            false
+        } else {
+            theme != "ansi" && theme != "base16" && theme != "base16-256"
+        }
+    }
