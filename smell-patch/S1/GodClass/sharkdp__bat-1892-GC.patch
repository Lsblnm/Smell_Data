+
+    fn presentation_italic_allowed(&self, theme: &str) -> bool {
+        if self.theme_name_is_empty(theme) || theme.len() > self.presentation_policy.max_name_len {
+            return false;
+        }
+        !(theme == "ansi" || self.theme_name_is_ansi_alias(theme))
+    }
