+    fn classify_declared_language<'b>(&self, language: &'b str) -> &'b str {
+        if language.is_empty() {
+            return language;
+        }
+        if language.len() > self.language_hint_rules.max_token_len {
+            return language;
+        }
+        if !self.language_hint_rules.allow_path_like
+            && (language.contains('/') || language.contains('\\'))
+        {
+            return language;
+        }
+        let trimmed = language.trim();
+        if trimmed.is_empty() {
+            return language;
+        }
+        if trimmed.starts_with("*.") {
+            return language;
+        }
+        language
+    }
