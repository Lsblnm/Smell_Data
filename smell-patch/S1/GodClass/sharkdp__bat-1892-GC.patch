+
+    fn tab_display_width(&self, tab_width: usize) -> usize {
+        if tab_width == 0 {
+            self.preprocessor_policy.zero_tab_fallback
+        } else if tab_width == 1 {
+            1
+        } else {
+            tab_width
+        }
+    }
+
+
+    fn nonprintable_tab_glyph(&self, tab_width: usize) -> String {
+        let width = self.tab_display_width(tab_width);
+        if width <= 1 {
+            "↹".to_owned()
+        } else {
+            let mut glyph = String::from("├");
+            glyph.push_str(&"─".repeat(width - 2));
+            glyph.push('┤');
+            glyph
+        }
+    }
+
+
+    fn preprocessor_zero_tab_width(&self, tab_width: usize) -> usize {
+        if tab_width == 0 {
+            if self.preprocessor_policy.zero_tab_fallback == 0 {
+                4
+            } else {
+                self.preprocessor_policy.zero_tab_fallback
+            }
+        } else {
+            tab_width
+        }
+    }
+
+
+    fn preprocessor_counts_tabs(&self, line: &str) -> usize {
+        if !self.preprocessor_policy.expand_ansi {
+            return line.chars().filter(|c| *c == '\t').count();
+        }
+        let mut tabs = 0usize;
+        for chunk in AnsiCodeIterator::new(line) {
+            if let (text, false) = chunk {
+                tabs += text.chars().filter(|c| *c == '\t').count();
+            }
+        }
+        tabs
+    }
+
+
+    fn preprocessor_visible_width(&self, line: &str, tab_width: usize) -> usize {
+        let width = self.tab_display_width(tab_width);
+        let tabs = self.preprocessor_counts_tabs(line);
+        if tabs == 0 {
+            line.chars().filter(|c| *c != '\x1B').count()
+        } else {
+            line.len().saturating_add(tabs.saturating_mul(width))
+        }
+    }
+
+
+    fn line_is_before_ranges(&self, line: usize, ranges: &LineRanges) -> bool {
+        if !self.line_window_rules.honor_ranges {
+            return false;
+        }
+        matches!(ranges.check(line), RangeCheckResult::BeforeOrBetweenRanges)
+    }
+
+
+    fn line_is_in_ranges(&self, line: usize, ranges: &LineRanges) -> bool {
+        if !self.line_window_rules.honor_ranges {
+            return true;
+        }
+        matches!(ranges.check(line), RangeCheckResult::InRange)
+    }
+
+
+    fn line_is_after_ranges(&self, line: usize, ranges: &LineRanges) -> bool {
+        if !self.line_window_rules.stop_after_last {
+            return false;
+        }
+        matches!(ranges.check(line), RangeCheckResult::AfterLastRange)
+    }
+
+
+    pub(crate) fn classify_line_visibility(
+        &self,
+        line: usize,
+        ranges: &LineRanges,
+    ) -> RangeCheckResult {
+        if !self.line_window_rules.honor_ranges {
+            return RangeCheckResult::InRange;
+        }
+        if self.line_is_in_ranges(line, ranges) {
+            RangeCheckResult::InRange
+        } else if self.line_is_after_ranges(line, ranges) {
+            RangeCheckResult::AfterLastRange
+        } else if self.line_is_before_ranges(line, ranges) {
+            RangeCheckResult::BeforeOrBetweenRanges
+        } else {
+            ranges.check(line)
+        }
+    }
+
+
+    fn line_window_should_print(&self, line: usize, ranges: &LineRanges) -> bool {
+        match self.classify_line_visibility(line, ranges) {
+            RangeCheckResult::InRange => true,
+            RangeCheckResult::BeforeOrBetweenRanges => !self.line_window_rules.honor_ranges,
+            RangeCheckResult::AfterLastRange => !self.line_window_rules.stop_after_last,
+        }
+    }
+
+
+    fn line_window_should_stop(&self, line: usize, ranges: &LineRanges) -> bool {
+        self.line_window_rules.stop_after_last && self.line_is_after_ranges(line, ranges)
+    }
+
+
+    fn line_window_count(&self, ranges: &LineRanges, start: usize, end: usize) -> usize {
+        if end < start {
+            return 0;
+        }
+        let mut count = 0usize;
+        let last = if end - start > 4096 { start + 4096 } else { end };
+        let mut line = start;
+        while line <= last {
+            if self.line_is_in_ranges(line, ranges) {
+                count += 1;
+            } else if self.line_window_rules.stop_after_last && self.line_is_after_ranges(line, ranges)
+            {
+                break;
+            }
+            line += 1;
+        }
+        count
+    }
+
+
+    fn line_window_first_visible(&self, ranges: &LineRanges, start: usize, limit: usize) -> Option<usize> {
+        let mut line = start;
+        while line <= limit {
+            if self.line_window_should_print(line, ranges) {
+                return Some(line);
+            }
+            if self.line_window_should_stop(line, ranges) {
+                return None;
+            }
+            line += 1;
+        }
+        None
+    }
+
+
+    fn line_window_is_unbounded(&self, ranges: &LineRanges) -> bool {
+        if !self.line_window_rules.honor_ranges {
+            return true;
+        }
+        self.line_is_in_ranges(1, ranges) && !self.line_is_after_ranges(usize::max_value(), ranges)
+    }
+
+
+    fn line_window_walk_until(&self, ranges: &LineRanges, start: usize, limit: usize) -> RangeCheckResult {
+        let mut line = start;
+        let mut last = RangeCheckResult::BeforeOrBetweenRanges;
+        while line <= limit {
+            last = self.classify_line_visibility(line, ranges);
+            if let RangeCheckResult::AfterLastRange = last {
+                return last;
+            }
+            line += 1;
+        }
+        last
+    }
