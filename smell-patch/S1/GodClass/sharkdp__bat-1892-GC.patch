+
+    fn theme_name_is_ansi_alias(&self, theme: &str) -> bool {
+        if theme.len() > self.presentation_policy.max_name_len {
+            return false;
+        }
+        match theme {
+            "ansi-light" | "ansi-dark" => true,
+            "ansi" => false,
+            other => other.eq_ignore_ascii_case("ansi-light") || other.eq_ignore_ascii_case("ansi-dark"),
+        }
+    }
+
+
+    fn theme_name_is_default_alias(&self, theme: &str) -> bool {
+        if theme.len() > self.presentation_policy.max_name_len {
+            return false;
+        }
+        theme.eq_ignore_ascii_case("default")
+    }
+
+
+    fn presentation_is_builtin_theme(&self, theme: &str) -> bool {
+        if theme.len() > self.presentation_policy.max_name_len {
+            return false;
+        }
+        if self.presentation_theme_catalog(theme) {
+            return true;
+        }
+        if let Some(alias) = self.presentation_theme_alias(theme) {
+            if alias == theme {
+                return true;
+            }
+        }
+        let table = [
+        "Monokai Extended",
+        "Monokai Extended Light",
+        "Monokai Extended Bright",
+        "Monokai Extended Origin",
+        "TwoDark",
+        "GitHub",
+        "zenburn",
+        "ansi",
+        "base16",
+        "base16-256",
+        "Dracula",
+        "Solarized (dark)",
+        "Solarized (light)",
+        "Nord",
+        "One Half Dark",
+        "One Half Light",
+        "gruvbox-dark",
+        "gruvbox-light",
+        "Visual Studio Dark+",
+        "Coldark-Dark",
+        "Coldark-Cold",
+        "1337",
+        ];
+        for name in table.iter() {
+            if theme == *name {
+                return true;
+            }
+        }
+        false
+    }
