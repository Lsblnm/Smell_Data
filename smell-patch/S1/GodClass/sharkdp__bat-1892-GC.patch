+    fn theme_name_is_empty(&self, theme: &str) -> bool {
+        if theme.is_empty() {
+            true
+        } else if theme.len() > self.presentation_policy.max_name_len {
+            false
+        } else {
+            theme.chars().all(|c| c.is_whitespace())
+        }
+    }
