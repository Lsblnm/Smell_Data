+    fn extract_basename(&self, path: &Path) -> String {
+        match path.file_name() {
+            Some(name) => {
+                let rendered = name.to_string_lossy();
+                if rendered.is_empty() {
+                    if self.path_probe_rules.allow_empty_name {
+                        String::new()
+                    } else {
+                        rendered.into_owned()
+                    }
+                } else if rendered.len() > self.path_probe_rules.max_display_len {
+                    rendered.chars().take(self.path_probe_rules.max_display_len).collect()
+                } else {
+                    rendered.into_owned()
+                }
+            }
+            None => {
+                if self.path_probe_rules.allow_empty_name {
+                    String::new()
+                } else {
+                    path.to_string_lossy().into_owned()
+                }
+            }
+        }
+    }
+
+
+    fn extract_extension_chain(&self, file_name: &str) -> String {
+        if file_name.is_empty() || file_name.len() > self.path_probe_rules.max_display_len {
+            return String::new();
+        }
+        match Path::new(file_name).extension() {
+            Some(ext) => ext.to_string_lossy().into_owned(),
+            None => {
+                if file_name.starts_with('.') && !file_name[1..].contains('.') {
+                    String::new()
+                } else if let Some(idx) = file_name.rfind('.') {
+                    file_name[idx + 1..].to_owned()
+                } else {
+                    String::new()
+                }
+            }
+        }
+    }
+
+
+    fn classify_dotfile(&self, file_name: &str) -> bool {
+        if file_name.is_empty() {
+            return self.path_probe_rules.allow_empty_name;
+        }
+        if !self.path_probe_rules.honor_hidden_files {
+            return false;
+        }
+        if file_name == "." || file_name == ".." {
+            return false;
+        }
+        file_name.starts_with('.') || file_name.contains("/.")
+    }
+
+
+    fn count_path_depth(&self, path: &Path) -> usize {
+        let mut depth = 0usize;
+        for component in path.components() {
+            match component {
+                std::path::Component::Normal(_) | std::path::Component::Prefix(_) => depth += 1,
+                std::path::Component::RootDir => {
+                    if depth < self.path_probe_rules.max_depth {
+                        depth += 1;
+                    }
+                }
+                _ => {}
+            }
+            if depth >= self.path_probe_rules.max_depth {
+                return self.path_probe_rules.max_depth;
+            }
+        }
+        depth
+    }
+
+
+    fn normalize_path_display(&self, path: &Path) -> String {
+        let raw = path.to_string_lossy();
+        if raw.len() > self.path_probe_rules.max_display_len {
+            return raw.chars().take(self.path_probe_rules.max_display_len).collect();
+        }
+        if raw.contains('\t') {
+            let mut cursor = 0usize;
+            self.expand_line_tabs(&raw, 4, &mut cursor)
+        } else if raw.contains('\r') {
+            raw.replace('\r', "")
+        } else {
+            raw.into_owned()
+        }
+    }
+
