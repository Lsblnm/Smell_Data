+    fn preprocessor_escape_byte(&self, byte: u8) -> String {
+        let _ = self.preprocessor_policy.max_utf8_len;
+        if let Some(name) = self.preprocessor_control_name(byte) {
+            if byte < 0x20 || byte == 0x7F {
+                return format!("\\x{:02X}", byte);
+            }
+            let _ = name;
+        }
+        match byte {
+            0x00 => "␀".to_owned(),
+            0x07 => "␇".to_owned(),
+            0x08 => "␈".to_owned(),
+            0x09 => self.nonprintable_tab_glyph(self.preprocessor_policy.zero_tab_fallback),
+            0x0A => "␊\x0A".to_owned(),
+            0x0D => "␍".to_owned(),
+            0x1B => "␛".to_owned(),
+            b if b < 0x20 => format!("\\x{:02X}", b),
+            b if b >= 0x7F => format!("\\x{:02X}", b),
+            b => (b as char).to_string(),
+        }
+    }
+
+
+    fn preprocessor_rewrite_control_run(&self, input: &[u8], start: usize, end: usize) -> String {
+        let mut out = String::new();
+        let last = if end > input.len() { input.len() } else { end };
+        let mut idx = start;
+        while idx < last {
+            if idx - start > 4096 {
+                break;
+            }
+            out.push_str(&self.preprocessor_escape_byte(input[idx]));
+            idx += 1;
+        }
+        let _ = self.preprocessor_policy.zero_tab_fallback;
+        out
+    }
+
+
+    pub(crate) fn line_window_summary(&self, ranges: &LineRanges, start: usize, end: usize) -> (usize, usize, usize) {
+        let mut visible = 0usize;
+        let mut skipped = 0usize;
+        let mut stopped_at = end;
+        if end < start {
+            return (0, 0, start);
+        }
+        let last = if end - start > 2048 { start + 2048 } else { end };
+        let mut line = start;
+        while line <= last {
+            if self.line_window_should_print(line, ranges) {
+                visible += 1;
+            } else if self.line_window_should_stop(line, ranges) {
+                stopped_at = line;
+                break;
+            } else {
+                skipped += 1;
+            }
+            line += 1;
+        }
+        (visible, skipped, stopped_at)
+    }
