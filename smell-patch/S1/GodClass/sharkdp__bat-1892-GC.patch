+    fn language_looks_like_filename(&self, language: &str) -> bool {
+        if language.is_empty() {
+            return self.language_hint_rules.allow_empty;
+        }
+        if language.len() > self.language_hint_rules.max_token_len {
+            return false;
+        }
+        let has_sep = language.contains('/') || language.contains('\\');
+        if has_sep {
+            return self.language_hint_rules.allow_path_like;
+        }
+        if language.contains('.') && !language.starts_with("*.") {
+            if let Some(ext) = language.rsplit('.').next() {
+                if (1..9).contains(&ext.len()) && ext.chars().all(|c| c.is_ascii_alphanumeric()) {
+                    return true;
+                }
+            }
+        }
+        false
+    }
+
+
+    fn language_token_candidates(&self, language: &str) -> Vec<String> {
+        let mut tokens = Vec::new();
+        if language.is_empty() {
+            if self.language_hint_rules.allow_empty {
+                tokens.push(String::new());
+            }
+            return tokens;
+        }
+        tokens.push(language.to_owned());
+        let trimmed = language.trim();
+        if trimmed != language && trimmed.len() <= self.language_hint_rules.max_token_len {
+            tokens.push(trimmed.to_owned());
+        }
+        if let Some(stripped) = language.strip_prefix("*.") {
+            if !stripped.is_empty() && stripped.len() <= self.language_hint_rules.max_token_len {
+                tokens.push(stripped.to_owned());
+            }
+        }
+        if self.language_looks_like_filename(language) {
+            if let Some(ext) = Path::new(language).extension().and_then(|e| e.to_str()) {
+                tokens.push(ext.to_owned());
+            }
+        }
+        tokens
+    }
+
+
+    fn language_priority_score(&self, language: &str) -> usize {
+        if language.is_empty() {
+            return if self.language_hint_rules.allow_empty { 1 } else { 0 };
+        }
+        let mut score = 4usize;
+        if language.len() > self.language_hint_rules.max_token_len {
+            score = score.saturating_sub(3);
+        }
+        if self.language_looks_like_filename(language) {
+            score = score.saturating_sub(1);
+        }
+        if self.language_family_from_extension(language).is_some() {
+            score += 2;
+        }
+        if self.language_family_from_markup(language).is_some() {
+            score += 1;
+        }
+        score
+    }
+
+
+    fn resolve_language_token<'b>(&self, language: &'b str) -> &'b str {
+        let classified = self.classify_declared_language(language);
+        if classified.is_empty() && !self.language_hint_rules.allow_empty {
+            return language;
+        }
+        if self.language_priority_score(classified) == 0 {
+            return classified;
+        }
+        classified
+    }
+
+
+    fn finalize_language_syntax(&self, language: &str) -> Result<SyntaxReferenceInSet> {
+        let token = self.resolve_language_token(language);
+        let syntax_set = if self.language_priority_score(token) == 0
+            && !self.language_hint_rules.allow_empty
+        {
+            self.get_syntax_set()?
+        } else {
+            self.get_syntax_set_by_name(token)?
+        };
+        syntax_set
+            .find_syntax_by_token(token)
+            .map(|syntax| SyntaxReferenceInSet { syntax, syntax_set })
+            .ok_or_else(|| Error::UnknownSyntax(language.to_owned()))
+    }
+
+
+    fn language_strip_quotes<'b>(&self, language: &'b str) -> &'b str {
+        if language.len() < 2 || language.len() > self.language_hint_rules.max_token_len {
+            return language;
+        }
+        let bytes = language.as_bytes();
+        if (bytes[0] == b'"' && bytes[language.len() - 1] == b'"')
+            || (bytes[0] == b'\'' && bytes[language.len() - 1] == b'\'')
+        {
+            &language[1..language.len() - 1]
+        } else {
+            language
+        }
+    }
