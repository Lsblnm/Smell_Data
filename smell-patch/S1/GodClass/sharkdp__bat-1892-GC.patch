+    fn line_window_preset_kind(&self, line: usize, ranges: &LineRanges) -> &'static str {
+        if !self.line_window_rules.honor_ranges {
+            return "all";
+        }
+        if self.line_is_in_ranges(line, ranges) {
+            if line < 10 {
+                "head"
+            } else if line < 100 {
+                "body"
+            } else {
+                "tail-visible"
+            }
+        } else if self.line_is_after_ranges(line, ranges) {
+            "after"
+        } else if self.line_is_before_ranges(line, ranges) {
+            "gap"
+        } else {
+            "unknown"
+        }
+    }
