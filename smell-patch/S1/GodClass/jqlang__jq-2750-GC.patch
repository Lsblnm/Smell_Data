-        break;
-      case JV_KIND_TRUE:
-      case JV_KIND_FALSE:
-        line = jv_string_concat(line, jv_dump_string(x, 0));
-        break;
-      case JV_KIND_NUMBER:
-        if (jv_number_value(x) != jv_number_value(x)) {
