+static jq_state *jq_active = 0;
+
+void jq_set_compilation_context(jq_state *jq) {
+  jq_active = jq;
+  if (jq) {
+    jq->compiler_inst_count = 0;
+    jq->compiler_bind_errors = 0;
+    jv_free(jq->compiler_symbols);
+    jq->compiler_symbols = jv_array();
+  }
