-    if (!strcmp(fmt_s, "csv")) {
-      msg = "cannot be csv-formatted, only array";
-      quotes = "\"";
-      sep = ",";
-      escapings = "\"\"\"\0";
-    } else {
-      msg = "cannot be tsv-formatted, only array";
-      assert(!strcmp(fmt_s, "tsv"));
-      quotes = "";
-      sep = "\t";
-      escapings = "\t\\t\0\r\\r\0\n\\n\0\\\\\\\0";
-    }
-    jv_free(fmt);
