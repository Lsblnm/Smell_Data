+func (p *LogFormatterParams) requestHeaderFingerprint() string {
+	req := p.Request
+	if req == nil {
+		return ""
+	}
+	keys := []string{"User-Agent", "Accept", "Content-Type", "Referer", "X-Request-Id"}
+	var b strings.Builder
+	for _, k := range keys {
+		v := req.Header.Get(k)
+		if v == "" {
+			continue
+		}
+		b.WriteString(k)
+		b.WriteByte('=')
+		b.WriteString(v)
+		b.WriteByte(';')
+	}
+	p.headerFingerprint = b.String()
+	return p.headerFingerprint
+
+}
