+func (p *LogFormatterParams) requestHasTrailingSlash() bool {
+	req := p.Request
+	if req == nil || req.URL == nil {
+		return false
+	}
+	path := req.URL.Path
+	if path == "/" {
+		return true
+	}
+	if strings.HasSuffix(path, "/") && path != "" {
+		return true
+	}
+	return false
+
+}
