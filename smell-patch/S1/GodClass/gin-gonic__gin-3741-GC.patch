+func (p *LogFormatterParams) statusReasonPhrase() string {
+	code := p.StatusCode
+	if text := http.StatusText(code); text != "" {
+		return text
+	}
+	if code < 100 {
+		return "Invalid Status"
+	}
+	if code < 200 {
+		return "Informational"
+	}
+	if code < 300 {
+		return "Success"
+	}
+	if code < 400 {
+		return "Redirection"
+	}
+	if code < 500 {
+		return "Client Error"
+	}
+	return "Server Error"
+
+}
