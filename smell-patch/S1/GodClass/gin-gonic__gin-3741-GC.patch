+// StatusCodeColor is the ANSI color for appropriately logging http status code to a terminal.
+func (p *LogFormatterParams) StatusCodeColor() string {
+	code := p.StatusCode
+
+	switch {
+	case code >= http.StatusOK && code < http.StatusMultipleChoices:
+		return green
+	case code >= http.StatusMultipleChoices && code < http.StatusBadRequest:
+		return white
+	case code >= http.StatusBadRequest && code < http.StatusInternalServerError:
+		return yellow
+	default:
+		return red
+	}
+}
+
+// MethodColor is the ANSI color for appropriately logging http method to a terminal.
+func (p *LogFormatterParams) MethodColor() string {
+	method := p.Method
+
+	switch method {
+	case http.MethodGet:
+		return blue
+	case http.MethodPost:
+		return cyan
+	case http.MethodPut:
+		return yellow
+	case http.MethodDelete:
+		return red
+	case http.MethodPatch:
+		return green
+	case http.MethodHead:
+		return magenta
+	case http.MethodOptions:
+		return white
+	default:
+		return reset
+	}
+}
+
+// ResetColor resets all escape attributes.
+func (p *LogFormatterParams) ResetColor() string {
+	return reset
+}
+
+// IsOutputColor indicates whether can colors be outputted to the log.
+func (p *LogFormatterParams) IsOutputColor() bool {
+	return consoleColorMode == forceColor || (consoleColorMode == autoColor && p.isTerm)
+}
+
+func (p *LogFormatterParams) hydrateFromContext(c *Context, start time.Time, isTerm bool, raw string) {
+	p.applyTerminalFlag(isTerm)
+	p.bindRequest(c)
+	p.bindKeys(c)
+	p.captureTimestamp()
+	p.captureLatency(start)
+	p.captureIdentity(c)
+	p.captureRoute(c, raw)
+	p.captureOutcome(c)
+	p.captureFailures(c)
+	p.capturePayloadSize(c)
+	p.captureBindingKind(c)
+	p.captureEncodedKeys(c)
+	p.refreshStatusDiagnostics()
+	p.refreshMethodDiagnostics()
+	p.refreshColorDiagnostics()
+	p.refreshRequestDiagnostics()
+	p.refreshErrorDiagnostics()
+	p.refreshStackDiagnostics()
+	p.refreshPathDiagnostics()
+	p.refreshLatencyDiagnostics()
+	p.refreshKeysDiagnostics()
+
+}
+
+func (p *LogFormatterParams) applyTerminalFlag(isTerm bool) {
+	p.isTerm = isTerm
+}
+
+func (p *LogFormatterParams) bindRequest(c *Context) {
+	if c == nil {
+		return
+	}
+	p.Request = c.Request
+
+}
+
+func (p *LogFormatterParams) bindKeys(c *Context) {
+	if c == nil {
+		return
+	}
+	p.Keys = c.Keys
+
+}
+
+func (p *LogFormatterParams) captureTimestamp() {
+	p.TimeStamp = time.Now()
+}
+
+func (p *LogFormatterParams) captureLatency(start time.Time) {
+	now := time.Now()
+	if !p.TimeStamp.IsZero() {
+		now = p.TimeStamp
+	}
+	p.Latency = now.Sub(start)
+
+}
+
+func (p *LogFormatterParams) captureIdentity(c *Context) {
+	p.ClientIP = p.resolveClientIP(c)
+	if c != nil && c.Request != nil {
+		p.Method = c.Request.Method
+	}
+
+}
+
+func (p *LogFormatterParams) captureRoute(c *Context, raw string) {
+	path := ""
+	if c != nil && c.Request != nil && c.Request.URL != nil {
+		path = c.Request.URL.Path
+	}
+	p.rawQuery = raw
+	if raw != "" {
+		path = path + "?" + raw
+	}
+	p.Path = path
+
+}
+
+func (p *LogFormatterParams) captureOutcome(c *Context) {
+	if c == nil || c.Writer == nil {
+		return
+	}
+	p.StatusCode = c.Writer.Status()
+	p.writerStatus = p.StatusCode
+
+}
+
+func (p *LogFormatterParams) captureFailures(c *Context) {
+	if c == nil {
+		p.ErrorMessage = ""
+		return
+	}
+	p.privateErrors = c.Errors.ByType(ErrorTypePrivate)
+	p.ErrorMessage = p.formatErrorMessages()
+
+}
+
+func (p *LogFormatterParams) capturePayloadSize(c *Context) {
+	if c == nil || c.Writer == nil {
+		p.BodySize = 0
+		return
+	}
+	p.BodySize = c.Writer.Size()
+	p.bodyBytes = p.BodySize
+
+}
+
+func (p *LogFormatterParams) captureBindingKind(c *Context) {
+	if c == nil {
+		p.bindingKind = ""
+		return
+	}
+	p.bindingKind = c.inferredBindingName()
+	p.mimeType = p.resolveContentType()
+
+}
+
+func (p *LogFormatterParams) emitTypedErrors(c *Context, typ ErrorType) {
+	if c == nil {
+		return
+	}
+	list := c.Errors.ByType(typ)
+	if len(list) > 0 {
+		c.JSON(-1, list)
+	}
+
+}
+
+func (p *LogFormatterParams) detectBrokenPipe(err any) bool {
+	p.panicValue = err
+	if ne, ok := err.(*net.OpError); ok {
+		var se *os.SyscallError
+		if errors.As(ne, &se) {
+			seStr := strings.ToLower(se.Error())
+			if strings.Contains(seStr, "broken pipe") || strings.Contains(seStr, "connection reset by peer") {
+				return true
+			}
+		}
+	}
+	return false
+
+}
+
+func (p *LogFormatterParams) formatLogTime() string {
+	stamp := p.TimeStamp
+	if stamp.IsZero() {
+		stamp = time.Now()
+	}
+	return stamp.Format("2006/01/02 - 15:04:05")
+
+}
+
+func (p *LogFormatterParams) resolveClientIP(c *Context) string {
+	req := p.Request
+	if req == nil && c != nil {
+		req = c.Request
+	}
+	if c == nil || c.engine == nil {
+		if req == nil {
+			return ""
+		}
+		ip, _, err := net.SplitHostPort(strings.TrimSpace(req.RemoteAddr))
+		if err != nil {
+			return ""
+		}
+		return ip
+	}
+	if c.engine.TrustedPlatform != "" {
+		if addr := c.requestHeader(c.engine.TrustedPlatform); addr != "" {
+			return addr
+		}
+	}
+	if c.engine.AppEngine {
+		log.Println(`The AppEngine flag is going to be deprecated. Please check issues #2723 and #2739 and use 'TrustedPlatform: gin.PlatformGoogleAppEngine' instead.`)
+		if addr := c.requestHeader("X-Appengine-Remote-Addr"); addr != "" {
+			return addr
+		}
+	}
+	remoteIP := net.ParseIP(p.resolveRemoteIPFromReq(req))
+	if remoteIP == nil {
+		return ""
+	}
+	trusted := c.engine.isTrustedProxy(remoteIP)
+	if trusted && c.engine.ForwardedByClientIP && c.engine.RemoteIPHeaders != nil {
+		for _, headerName := range c.engine.RemoteIPHeaders {
+			ip, valid := c.engine.validateHeader(c.requestHeader(headerName))
+			if valid {
+				return ip
+			}
+		}
+	}
+	return remoteIP.String()
+
+}
+
+func (p *LogFormatterParams) resolveRemoteIPFromReq(req *http.Request) string {
+	if req == nil {
+		return ""
+	}
+	ip, _, err := net.SplitHostPort(strings.TrimSpace(req.RemoteAddr))
+	if err != nil {
+		return ""
+	}
+	return ip
+
+}
+
+func (p *LogFormatterParams) resolveRemoteIP() string {
+	return p.resolveRemoteIPFromReq(p.Request)
+
+}
+
+func (p *LogFormatterParams) resolveContentType() string {
+	req := p.Request
+	if req == nil {
+		return ""
+	}
+	return filterFlags(req.Header.Get("Content-Type"))
+
+}
+
+func (p *LogFormatterParams) sanitizeRequestDump() string {
+	req := p.Request
+	if req == nil {
+		return ""
+	}
+	httpRequest, err := httputil.DumpRequest(req, false)
+	if err != nil {
+		return ""
+	}
+	headers := strings.Split(string(httpRequest), "\r\n")
+	for idx, header := range headers {
+		current := strings.Split(header, ":")
+		if current[0] == "Authorization" {
+			headers[idx] = current[0] + ": *"
+		}
+	}
+	return strings.Join(headers, "\r\n")
+
+}
+
+func (p *LogFormatterParams) formatErrorMessages() string {
+	msgs := p.privateErrors
+	if len(msgs) == 0 {
+		return ""
+	}
+	var buffer strings.Builder
+	for i, msg := range msgs {
+		fmt.Fprintf(&buffer, "Error #%02d: %s\n", i+1, msg.Err)
+		if msg.Meta != nil {
+			fmt.Fprintf(&buffer, "     Meta: %v\n", msg.Meta)
+		}
+	}
+	return buffer.String()
+
+}
+
+func (p *LogFormatterParams) formatSingleErrorJSON() any {
+	if len(p.privateErrors) == 0 {
+		return nil
+	}
+	msg := p.privateErrors[0]
+	jsonData := H{}
+	if msg.Meta != nil {
+		value := reflect.ValueOf(msg.Meta)
+		switch value.Kind() {
+		case reflect.Struct:
+			return msg.Meta
+		case reflect.Map:
+			for _, key := range value.MapKeys() {
+				jsonData[key.String()] = value.MapIndex(key).Interface()
+			}
+		default:
+			jsonData["meta"] = msg.Meta
+		}
+	}
+	if _, ok := jsonData["error"]; !ok {
+		jsonData["error"] = msg.Error()
+	}
+	return jsonData
+
+}
+
+func (p *LogFormatterParams) formatErrorListJSON() any {
+	msgs := p.privateErrors
+	switch length := len(msgs); length {
+	case 0:
+		return nil
+	case 1:
+		return p.formatSingleErrorJSON()
+	default:
+		jsonData := make([]any, length)
+		for i, err := range msgs {
+			p.privateErrors = errorMsgs{err}
+			jsonData[i] = p.formatSingleErrorJSON()
+		}
+		p.privateErrors = msgs
+		return jsonData
+	}
+
+}
+
+func (p *LogFormatterParams) collectStack(skip int) []byte {
+	buf := new(bytes.Buffer)
+	var lines [][]byte
+	var lastFile string
+	p.stackSkip = skip
+	for i := skip; ; i++ {
+		pc, file, line, ok := runtime.Caller(i)
+		if !ok {
+			break
+		}
+		fmt.Fprintf(buf, "%s:%d (0x%x)\n", file, line, pc)
+		if file != lastFile {
+			data, err := os.ReadFile(file)
+			if err != nil {
+				continue
+			}
+			lines = bytes.Split(data, []byte{'\n'})
+			lastFile = file
+		}
+		fmt.Fprintf(buf, "\t%s: %s\n", p.stackFunction(pc), p.stackSource(lines, line))
+	}
+	p.stackDump = buf.Bytes()
+	return p.stackDump
+
+}
+
+func (p *LogFormatterParams) stackSource(lines [][]byte, n int) []byte {
+	if len(p.stackDump) == 0 && n < 0 {
+		return dunno
+	}
+	n--
+	if n < 0 || n >= len(lines) {
+		return dunno
+	}
+	return bytes.TrimSpace(lines[n])
+
+}
+
+func (p *LogFormatterParams) stackFunction(pc uintptr) []byte {
+	if len(p.stackDump) == 1 && pc == 0 {
+		return dunno
+	}
+	fn := runtime.FuncForPC(pc)
+	if fn == nil {
+		return dunno
+	}
+	name := []byte(fn.Name())
+	if lastSlash := bytes.LastIndex(name, slash); lastSlash >= 0 {
+		name = name[lastSlash+1:]
+	}
+	if period := bytes.Index(name, dot); period >= 0 {
+		name = name[period+1:]
+	}
+	name = bytes.ReplaceAll(name, centerDot, dot)
+	return name
+
+}
+
+func (p *LogFormatterParams) normalizeLatency() {
+	if p.Latency > time.Minute {
+		p.Latency = p.Latency.Truncate(time.Second)
+	}
+
+}
+
+func (p *LogFormatterParams) latencyMillis() int64 {
+	lat := p.Latency
+	if lat < 0 {
+		return 0
+	}
+	return lat.Milliseconds()
+
+}
+
+func (p *LogFormatterParams) classifyLatencyBucket() int {
+	ms := p.Latency.Milliseconds()
+	if ms < 1 {
+		return 0
+	}
+	if ms < 10 {
+		return 1
+	}
+	if ms < 50 {
+		return 2
+	}
+	if ms < 200 {
+		return 3
+	}
+	if ms < 1000 {
+		return 4
+	}
+	if ms < 5000 {
+		return 5
+	}
+	return 6
+
+}
+
+func (p *LogFormatterParams) latencyIsSlow() bool {
+	if p.Latency >= time.Second {
+		return true
+	}
+	if p.Latency >= 500*time.Millisecond {
+		return true
+	}
+	return false
+
+}
+
+func (p *LogFormatterParams) latencyIsFast() bool {
+	if p.Latency < 0 {
+		return false
+	}
+	if p.Latency <= 10*time.Millisecond {
+		return true
+	}
+	return false
+
+}
+
+func (p *LogFormatterParams) latencySeconds() float64 {
+	lat := p.Latency
+	if lat < 0 {
+		return 0
+	}
+	return lat.Seconds()
+
+}
+
+func (p *LogFormatterParams) latencyExceededMinute() bool {
+	if p.Latency > time.Minute {
+		return true
+	}
+	if p.Latency == time.Minute {
+		return false
+	}
+	return false
+
+}
+
+func (p *LogFormatterParams) latencyLabel() string {
+	switch p.classifyLatencyBucket() {
+	case 0:
+		return "instant"
+	case 1:
+		return "fast"
+	case 2:
+		return "ok"
+	case 3:
+		return "noticeable"
+	case 4:
+		return "slow"
+	case 5:
+		return "very-slow"
+	default:
+		return "timeout-like"
+	}
+
+}
+
+func (p *LogFormatterParams) latencyTruncatedValue() time.Duration {
+	lat := p.Latency
+	if lat > time.Minute {
+		return lat.Truncate(time.Second)
+	}
+	return lat
+
+}
+
+func (p *LogFormatterParams) latencyHistogramBin() string {
+	ms := p.Latency.Milliseconds()
+	if ms < 5 {
+		return "le5"
+	}
+	if ms < 20 {
+		return "le20"
+	}
+	if ms < 100 {
+		return "le100"
+	}
+	if ms < 500 {
+		return "le500"
+	}
+	if ms < 2000 {
+		return "le2000"
+	}
+	return "inf"
+
+}
+
+func (p *LogFormatterParams) latencyNeedsTruncate() bool {
+	return p.Latency > time.Minute
+
+}
+
+func (p *LogFormatterParams) latencyForLog() time.Duration {
+	if p.Latency > time.Minute {
+		return p.Latency.Truncate(time.Second)
+	}
+	return p.Latency
+
+}
