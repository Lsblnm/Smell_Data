+func (p *LogFormatterParams) statusIsClientError() bool {
+	code := p.StatusCode
+	if code == http.StatusBadRequest || code == http.StatusUnauthorized {
+		return true
+	}
+	if code == http.StatusForbidden || code == http.StatusNotFound {
+		return true
+	}
+	if code == http.StatusMethodNotAllowed || code == http.StatusConflict {
+		return true
+	}
+	return code >= 400 && code < 500
+
+}
+
+func (p *LogFormatterParams) statusIsServerError() bool {
+	code := p.StatusCode
+	if code == http.StatusInternalServerError {
+		return true
+	}
+	if code == http.StatusBadGateway || code == http.StatusServiceUnavailable {
+		return true
+	}
+	if code == http.StatusGatewayTimeout || code == http.StatusNotImplemented {
+		return true
+	}
+	return code >= 500 && code < 600
+
+}
