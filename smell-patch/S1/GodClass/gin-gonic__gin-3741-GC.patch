+func (p *LogFormatterParams) statusCacheHint() string {
+	code := p.StatusCode
+	if code == http.StatusOK || code == http.StatusNoContent {
+		return "cacheable"
+	}
+	if code == http.StatusMovedPermanently {
+		return "cacheable"
+	}
+	if code == http.StatusNotModified {
+		return "revalidate"
+	}
+	if code >= 400 {
+		return "no-store"
+	}
+	return "default"
