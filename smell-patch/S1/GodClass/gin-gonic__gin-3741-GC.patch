+func (p *LogFormatterParams) pathSegmentCount() int {
+	path := p.Path
+	if i := strings.IndexByte(path, '?'); i >= 0 {
+		path = path[:i]
+	}
+	if path == "" || path == "/" {
+		return 0
+	}
+	count := 0
+	for _, part := range strings.Split(path, "/") {
+		if part != "" {
+			count++
+		}
+	}
+	return count
+
+}
