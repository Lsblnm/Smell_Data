+func (p *LogFormatterParams) classifyStatusFamily() int {
+	code := p.StatusCode
+	if code < 100 {
+		return 0
+	}
+	if code < 200 {
+		return 1
+	}
+	if code < 300 {
+		return 2
+	}
+	if code < 400 {
+		return 3
+	}
+	if code < 500 {
+		return 4
+	}
+	if code < 600 {
+		return 5
+	}
+	return 0
+
+}
