+func (p *LogFormatterParams) requestQueryCount() int {
+	req := p.Request
+	if req == nil || req.URL == nil {
+		return 0
+	}
+	values := req.URL.Query()
+	count := 0
+	for _, vs := range values {
+		if len(vs) > 0 {
+			count++
+		}
+	}
+	return count
+
+}
