+func (p *LogFormatterParams) stackCatalog() string {
+	buf := strings.Builder{}
+	buf.WriteString("stack=")
+	buf.WriteString(strconv.Itoa(len(p.stackDump)))
+	if len(p.stackDump) == 0 {
+		return "stack=0"
+	}
+	buf.WriteByte(';')
+	preview := p.stackDump
+	if len(preview) > 120 {
+		preview = preview[:120]
+	}
+	buf.WriteString(string(preview))
+	buf.WriteString("frame0")
+	buf.WriteByte('=')
+	buf.WriteString(strconv.Itoa(len(p.stackDump)))
