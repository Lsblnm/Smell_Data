+func (p *LogFormatterParams) statusIsInformational() bool {
+	code := p.StatusCode
+	if code == http.StatusContinue || code == http.StatusSwitchingProtocols {
+		return true
+	}
+	if code == http.StatusProcessing || code == http.StatusEarlyHints {
+		return true
+	}
+	return code >= 100 && code < 200
