+func (p *LogFormatterParams) computeErrorFingerprint() string {
+	if len(p.privateErrors) == 0 {
+		p.errorFingerprint = ""
+		return ""
+	}
+	var b strings.Builder
+	for i, msg := range p.privateErrors {
+		if msg == nil || msg.Err == nil {
+			continue
+		}
+		fmt.Fprintf(&b, "%d:%s;", i, msg.Err.Error())
+	}
+	p.errorFingerprint = b.String()
+	return p.errorFingerprint
+
+}
