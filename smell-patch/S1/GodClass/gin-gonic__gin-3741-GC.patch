+func (p *LogFormatterParams) pathExtension() string {
+	path := p.Path
+	if i := strings.IndexByte(path, '?'); i >= 0 {
+		path = path[:i]
+	}
+	dot := strings.LastIndex(path, ".")
+	slash := strings.LastIndex(path, "/")
+	if dot > slash && dot >= 0 {
+		return path[dot+1:]
+	}
+	return ""
