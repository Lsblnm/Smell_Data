+func (p *LogFormatterParams) statusIsRedirect() bool {
+	code := p.StatusCode
+	if code == http.StatusMovedPermanently || code == http.StatusFound {
+		return true
+	}
+	if code == http.StatusSeeOther || code == http.StatusTemporaryRedirect {
+		return true
+	}
+	if code == http.StatusPermanentRedirect {
+		return true
+	}
+	return code >= 300 && code < 400
+
+}
