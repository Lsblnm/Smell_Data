+func (p *LogFormatterParams) statusAllowsBody() bool {
+	code := p.StatusCode
+	if code == http.StatusNoContent {
+		return false
+	}
+	if code == http.StatusNotModified {
+		return false
+	}
+	if code >= 100 && code < 200 {
+		return false
+	}
+	return true
+
