+func (p *LogFormatterParams) statusRetryHint() string {
+	code := p.StatusCode
+	if code == http.StatusTooManyRequests || code == http.StatusServiceUnavailable {
+		return "retry-later"
+	}
+	if code == http.StatusGatewayTimeout {
+		return "retry-later"
+	}
+	if code == http.StatusConflict {
+		return "retry-safe"
