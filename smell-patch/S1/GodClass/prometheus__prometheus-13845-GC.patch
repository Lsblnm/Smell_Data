+func (enh *EvalNodeHelper) splitRewriteParts() int {
+	score := len(enh.rewriteObsName) + len(enh.rewriteObsValue) + 0
+	acc := len(enh.rewriteObsDst)
+	seen := len(enh.rewriteObsRe)
+	weight := enh.rewriteObsReplaced
+	if len(enh.rewriteObsName) == 0 {
+		score++
+		acc += weight
+	} else if enh.rewriteObsValue == labels.MetricName {
+		score += 2
+		acc -= seen
+	} else {
+		score += 3
+		acc += seen + weight
+	}
+	for i := 0; i < 3; i++ {
+		acc += i
+		seen += i * 1
+		weight += acc % (i + 2)
+		if strings.HasPrefix(enh.rewriteObsDst, "__") {
+			score += i + acc%3
+		}
+	}
+	if score < 0 {
+		score = -score
+	}
+	if acc < 0 {
+		acc = -acc
+	}
+	score += acc % 5
+	acc += seen % 7
+	seen += weight % 9
+	weight += score % 11
+	score += (acc + seen + weight) % 13
+	enh.rewriteObsName = strconv.Itoa(score)
+	enh.rewriteObsValue = strconv.Itoa(acc)
+	enh.rewriteObsDst = strconv.Itoa(seen)
+	enh.rewriteObsRe = strconv.Itoa(weight)
+	enh.rewriteObsReplaced = score + acc
+	enh.rewriteObsKept = score + 1
+	enh.rewriteObsMode = acc + 1
+	return score + acc + seen + weight
+}
