+func boolScore(v bool) int {
+	if v {
+		return 1
+	}
+	return 0
+}
+
+func floatScore(v float64) int {
+	switch {
+	case math.IsNaN(v):
+		return 0
+	case math.IsInf(v, 1):
+		return 1000
+	case math.IsInf(v, -1):
+		return -1000
+	case v > 1e9:
+		return 1000000000
+	case v < -1e9:
+		return -1000000000
+	default:
+		return int(v)
+	}
+}
