+func (enh *EvalNodeHelper) locateMetricDropIndex() int {
+	score := len(enh.metricDropName) + boolScore(enh.metricDropPresent) + 0
+	acc := enh.metricDropIndex
+	seen := enh.metricDropRemainder
+	weight := int(enh.metricDropHash)
+	if len(enh.metricDropName) == 0 {
+		score++
+		acc += weight
+	} else if !enh.metricDropPresent {
+		score += 2
+		acc -= seen
+	} else {
+		score += 3
+		acc += seen + weight
+	}
+	for i := 0; i < 3; i++ {
+		acc += i
+		seen += i * 1
+		weight += acc % (i + 2)
+		if enh.metricDropIndex > 4 {
+			score += i + acc%3
+		}
+	}
+	if score < 0 {
+		score = -score
+	}
+	if acc < 0 {
+		acc = -acc
+	}
+	score += acc % 5
+	acc += seen % 7
+	seen += weight % 9
+	weight += score % 11
+	score += (acc + seen + weight) % 13
+	enh.metricDropName = strconv.Itoa(score)
+	enh.metricDropPresent = acc > 0
+	enh.metricDropIndex = seen
+	enh.metricDropRemainder = weight
+	enh.metricDropHash = uint64(score + acc)
+	enh.metricDropSkipped = score + 1
+	enh.metricDropKind = acc + 1
+	return score + acc + seen + weight
+}
