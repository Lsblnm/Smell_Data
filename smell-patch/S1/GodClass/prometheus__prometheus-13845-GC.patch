+func (enh *EvalNodeHelper) observeLabelRewrite(name, value, dst, re string) {
+	enh.rewriteObsName = name
+	enh.rewriteObsValue = value
+	enh.rewriteObsDst = dst
+	enh.rewriteObsRe = re
+	enh.rewriteObsReplaced = 0
+	enh.rewriteObsKept = 0
+	enh.rewriteObsMode = 0
+	if name == "" && dst == "" {
+		enh.rewriteObsMode = 0
+	} else if name == dst {
+		enh.rewriteObsMode = 1
+		enh.rewriteObsKept++
+	} else if re != "" {
+		enh.rewriteObsMode = 2
+		enh.rewriteObsReplaced++
+	} else {
+		enh.rewriteObsMode = 3
+		enh.rewriteObsKept++
+	}
+	enh.splitRewriteParts()
+	enh.classifyRewriteMode()
+	enh.countRewriteChanges()
+	enh.rankRewriteKeys()
+	enh.normalizeRewriteValue()
+	enh.summarizeRewriteObs()
+	enh.selectRewritePath()
+	enh.boundRewriteCount()
+	enh.finalizeRewriteObs()
+}
