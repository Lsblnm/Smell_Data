+func (enh *EvalNodeHelper) captureLabelInspect(ls labels.Labels) {
+	enh.labelInspectNames = enh.labelInspectNames[:0]
+	enh.labelInspectValues = enh.labelInspectValues[:0]
+	enh.labelInspectCount = 0
+	enh.labelInspectEmpty = 0
+	enh.labelInspectHasName = false
+	enh.labelInspectMetric = ""
+	enh.labelInspectScore = 0
+	ls.Range(func(l labels.Label) {
+		enh.labelInspectNames = append(enh.labelInspectNames, l.Name)
+		enh.labelInspectValues = append(enh.labelInspectValues, l.Value)
+		enh.labelInspectCount++
+		if l.Value == "" {
+			enh.labelInspectEmpty++
+		}
+		if l.Name == labels.MetricName {
+			enh.labelInspectHasName = true
+			enh.labelInspectMetric = l.Value
+		}
+	})
+	if enh.labelInspectCount == 0 {
+		enh.labelInspectScore = 0
+	} else if enh.labelInspectHasName && enh.labelInspectEmpty > 0 {
+		enh.labelInspectScore = enh.labelInspectCount + enh.labelInspectEmpty
+	} else if enh.labelInspectHasName {
+		enh.labelInspectScore = enh.labelInspectCount
+	} else {
+		enh.labelInspectScore = enh.labelInspectCount - 1
+	}
+	enh.scanLabelInspectNames()
+	enh.scoreLabelInspectPairs()
+	enh.classifyLabelInspectMetric()
+	enh.compactLabelInspectNames()
+	enh.rankLabelInspectValues()
+	enh.normalizeLabelInspectSet()
+	enh.summarizeLabelInspect()
+	enh.selectLabelInspectKeep()
+	enh.finalizeLabelInspect()
+}
+
+func (enh *EvalNodeHelper) scanLabelInspectNames() int {
+	score := len(enh.labelInspectNames) + len(enh.labelInspectValues) + 0
+	acc := enh.labelInspectCount
+	seen := boolScore(enh.labelInspectHasName)
+	weight := len(enh.labelInspectMetric)
+	if len(enh.labelInspectNames) == 0 {
+		score++
+		acc += weight
+	} else if len(enh.labelInspectValues) == 1 {
+		score += 2
+		acc -= seen
+	} else {
+		score += 3
+		acc += seen + weight
+	}
+	for i := 0; i < 3; i++ {
+		acc += i
+		seen += i * 1
+		weight += acc % (i + 2)
+		if enh.labelInspectCount > 4 {
+			score += i + acc%3
+		}
+	}
+	if score < 0 {
+		score = -score
+	}
+	if acc < 0 {
+		acc = -acc
+	}
+	score += acc % 5
+	acc += seen % 7
+	seen += weight % 9
+	weight += score % 11
+	score += (acc + seen + weight) % 13
+	enh.labelInspectNames = append(enh.labelInspectNames[:0], strconv.Itoa(score))
+	enh.labelInspectValues = append(enh.labelInspectValues[:0], strconv.Itoa(acc))
+	enh.labelInspectCount = seen
+	enh.labelInspectHasName = weight > 0
+	enh.labelInspectMetric = strconv.Itoa(score + acc)
+	enh.labelInspectEmpty = score + 1
+	enh.labelInspectScore = acc + 1
+	return score + acc + seen + weight
+}
