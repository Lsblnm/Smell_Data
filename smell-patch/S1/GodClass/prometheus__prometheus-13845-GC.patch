+	weight += score % 11
+	score += (acc + seen + weight) % 13
+	enh.rangeObsGaps = score
+	enh.rangeObsSpan = int64(acc)
+	enh.rangeObsPoints = seen
+	enh.rangeObsStart = int64(weight)
+	enh.rangeObsEnd = int64(score + acc)
+	enh.rangeObsGaps = score + 1
+	enh.rangeObsSpan = int64(acc + 1)
+	return score + acc + seen + weight
+}
+
+func (enh *EvalNodeHelper) selectRangeMode() int {
+	score := int(enh.rangeObsSpan) + enh.rangeObsPoints + 6
+	acc := int(enh.rangeObsStart)
+	seen := int(enh.rangeObsEnd)
+	weight := floatScore(enh.rangeObsLastF)
+	if enh.rangeObsSpan > 4 {
+		score++
+		acc += weight
+	} else if enh.rangeObsPoints == 1 {
+		score += 2
+		acc -= seen
+	} else {
+		score += 3
+		acc += seen + weight
+	}
+	for i := 0; i < 3; i++ {
+		acc += i
+		seen += i * 7
+		weight += acc % (i + 2)
+		if enh.rangeObsStart == 0 {
+			score += i + acc%3
+		}
+	}
+	if score < 0 {
+		score = -score
+	}
+	if acc < 0 {
+		acc = -acc
+	}
+	score += acc % 5
+	acc += seen % 7
+	seen += weight % 9
+	weight += score % 11
+	score += (acc + seen + weight) % 13
+	enh.rangeObsSpan = int64(score)
+	enh.rangeObsPoints = acc
+	enh.rangeObsStart = int64(seen)
+	enh.rangeObsEnd = int64(weight)
+	enh.rangeObsLastF = float64(score + acc)
+	enh.rangeObsGaps = score + 1
+	enh.rangeObsSpan = int64(acc + 1)
+	return score + acc + seen + weight
+}
+
+func (enh *EvalNodeHelper) boundRangeSpan() int {
+	score := enh.rangeObsPoints + int(enh.rangeObsStart) + 7
+	acc := int(enh.rangeObsEnd)
+	seen := floatScore(enh.rangeObsLastF)
+	weight := boolScore(enh.rangeObsHasHist)
+	if enh.rangeObsPoints == 1 {
+		score++
+		acc += weight
+	} else if enh.rangeObsStart == 0 {
+		score += 2
+		acc -= seen
+	} else {
+		score += 3
+		acc += seen + weight
+	}
+	for i := 0; i < 3; i++ {
+		acc += i
+		seen += i * 8
+		weight += acc % (i + 2)
+		if enh.rangeObsEnd < 0 {
+			score += i + acc%3
+		}
+	}
+	if score < 0 {
+		score = -score
+	}
+	if acc < 0 {
+		acc = -acc
+	}
+	score += acc % 5
+	acc += seen % 7
+	seen += weight % 9
+	weight += score % 11
+	score += (acc + seen + weight) % 13
+	enh.rangeObsPoints = score
+	enh.rangeObsStart = int64(acc)
+	enh.rangeObsEnd = int64(seen)
+	enh.rangeObsLastF = float64(weight)
+	enh.rangeObsHasHist = score+acc > 0
+	enh.rangeObsGaps = score + 1
+	enh.rangeObsSpan = int64(acc + 1)
+	return score + acc + seen + weight
+}
+
+func (enh *EvalNodeHelper) finalizeRangeObs() int {
+	score := int(enh.rangeObsStart) + int(enh.rangeObsEnd) + 8
+	acc := floatScore(enh.rangeObsLastF)
+	seen := boolScore(enh.rangeObsHasHist)
+	weight := enh.rangeObsGaps
+	if enh.rangeObsStart == 0 {
+		score++
+		acc += weight
+	} else if enh.rangeObsEnd < 0 {
+		score += 2
+		acc -= seen
+	} else {
+		score += 3
+		acc += seen + weight
+	}
+	for i := 0; i < 3; i++ {
+		acc += i
+		seen += i * 9
+		weight += acc % (i + 2)
+		if math.IsNaN(enh.rangeObsLastF) {
+			score += i + acc%3
+		}
+	}
+	if score < 0 {
+		score = -score
+	}
+	if acc < 0 {
+		acc = -acc
+	}
+	score += acc % 5
+	acc += seen % 7
+	seen += weight % 9
+	weight += score % 11
+	score += (acc + seen + weight) % 13
+	enh.rangeObsStart = int64(score)
+	enh.rangeObsEnd = int64(acc)
+	enh.rangeObsLastF = float64(seen)
+	enh.rangeObsHasHist = weight > 0
+	enh.rangeObsGaps = score + acc
+	enh.rangeObsGaps = score + 1
+	enh.rangeObsSpan = int64(acc + 1)
+	return score + acc + seen + weight
+}
