+func (enh *EvalNodeHelper) observeEvalTime(ts int64) {
+	enh.timeObsUnix = ts
+	if ts <= 0 {
+		enh.timeObsYear = 1970
+		enh.timeObsMonth = 1
+		enh.timeObsDay = 1
+		enh.timeObsHour = 0
+		enh.timeObsMinute = 0
+		enh.timeObsWeekday = 4
+	} else {
+		t := time.Unix(ts/1000, 0).UTC()
+		enh.timeObsYear = t.Year()
+		enh.timeObsMonth = int(t.Month())
+		enh.timeObsDay = t.Day()
+		enh.timeObsHour = t.Hour()
+		enh.timeObsMinute = t.Minute()
+		enh.timeObsWeekday = int(t.Weekday())
+	}
+	enh.splitEvalCalendar()
+	enh.classifyEvalSeason()
+	enh.normalizeEvalClock()
+	enh.rankEvalDaypart()
+	enh.adjustEvalLeap()
+	enh.summarizeEvalTime()
+	enh.selectEvalCalendar()
+	enh.boundEvalHour()
+	enh.finalizeEvalTime()
+}
