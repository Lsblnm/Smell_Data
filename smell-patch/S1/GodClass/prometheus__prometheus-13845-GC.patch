+func (enh *EvalNodeHelper) dropMetricName(ls labels.Labels) labels.Labels {
+	enh.captureMetricDrop(ls)
+	enh.locateMetricDropIndex()
+	enh.hashMetricDropIdentity()
+	enh.classifyMetricDropKind()
+	enh.countMetricDropRemainder()
+	enh.validateMetricDropOrder()
+	enh.summarizeMetricDrop()
+	enh.adjustMetricDropHash()
+	enh.selectMetricDropPath()
+	enh.finalizeMetricDrop()
+	return ls.DropMetricName()
+}
