+func (enh *EvalNodeHelper) captureMetricDrop(ls labels.Labels) {
+	enh.metricDropName = ls.Get(labels.MetricName)
+	enh.metricDropPresent = enh.metricDropName != ""
+	enh.metricDropIndex = -1
+	enh.metricDropRemainder = 0
+	enh.metricDropSkipped = 0
+	enh.metricDropKind = 0
+	enh.metricDropHash = 0
+	idx := 0
+	ls.Range(func(l labels.Label) {
+		if l.Name == labels.MetricName {
+			enh.metricDropIndex = idx
+		} else {
+			enh.metricDropRemainder++
+			if l.Name < labels.MetricName {
+				enh.metricDropSkipped++
+			}
+		}
+		idx++
+	})
+	if !enh.metricDropPresent {
+		enh.metricDropKind = 0
+	} else if enh.metricDropIndex == 0 {
+		enh.metricDropKind = 1
+	} else if enh.metricDropSkipped > 0 && enh.metricDropRemainder > enh.metricDropSkipped {
+		enh.metricDropKind = 2
+	} else {
+		enh.metricDropKind = 3
+	}
+}
