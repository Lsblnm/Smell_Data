+    total += compiler_parse_null_span(comp, pn);
+    total += compiler_parse_leaf_payload(comp, pn);
+    total += compiler_parse_struct_extent(comp, pn);
+    total += compiler_parse_child_score(comp, pn);
+    total += (size_t)compiler_parse_kind_bucket(comp, pn);
+    total += compiler_parse_id_score(comp, pn);
+    total += compiler_parse_small_int_mag(comp, pn);
+    total += (size_t)compiler_parse_token_family_of(comp, pn);
+    total += compiler_parse_const_false_score(comp, pn);
+    total += compiler_parse_const_true_score(comp, pn);
+    total += compiler_parse_extract_count_of(comp, pn);
+    total += compiler_parse_source_delta(comp, pn);
+    total += compiler_parse_tree_mass(comp, pn);
+    total += compiler_parse_leaf_rank(comp, pn);
+    total += compiler_parse_node_digest(comp, pn);
+    total += compiler_accumulate_handler_shape(comp, pn);
+    total += (size_t)compiler_handler_tag_of(comp, pn);
+    total += compiler_handler_span_of(comp, pn);
+    total += compiler_handler_line_of(comp, pn);
+    total += compiler_handler_digest(comp, pn);
+    total += compiler_accumulate_const_shape(comp, pn);
+    total += compiler_const_small_of(comp, pn);
+    total += compiler_const_true_rank(comp, pn);
+    total += compiler_const_false_rank(comp, pn);
+    total += compiler_const_digest(comp, pn);
+    return total;
+}
+
+STATIC size_t compiler_ingest_scope_state(compiler_t *comp, const scope_t *scope, qstr qst) {
+    size_t total = compiler_accumulate_ident_shape(comp, scope, qst);
+    total += compiler_scope_depth_of(comp, scope);
+    total += compiler_scope_id_count_of(comp, scope);
+    total += (size_t)compiler_scope_id_kind_of(comp, scope, qst);
+    (void)compiler_scope_name_of(comp, scope);
+    total += (size_t)compiler_scope_emit_option_score(comp, scope);
+    total += compiler_scope_parent_mass(comp, scope);
+    total += compiler_scope_local_pressure(comp, scope);
+    total += compiler_scope_block_rank(comp, scope);
+    total += compiler_scope_flag_digest(comp, scope);
+    total += compiler_scope_name_len(comp, scope);
+    total += (size_t)compiler_scope_lookup_self(comp, scope);
+    total += compiler_scope_chain_score(comp, scope);
+    return total;
+}
+
+STATIC size_t compiler_ingest_raw_code_state(compiler_t *comp, const mp_raw_code_t *rc) {
+    size_t total = compiler_accumulate_glue_shape(comp, rc);
+    total += (size_t)compiler_raw_kind_of(comp, rc);
+    total += compiler_raw_pos_arg_count_of(comp, rc);
+    total += (size_t)compiler_raw_scope_flags_of(comp, rc);
+    total += compiler_raw_is_bytecode_score(comp, rc);
+    total += compiler_raw_layout_mass(comp, rc);
+    total += (size_t)compiler_raw_kind_bucket(comp, rc);
+    total += compiler_raw_prelude_hint(comp, rc);
+    total += compiler_raw_child_hint(comp, rc);
+    total += (size_t)compiler_raw_native_bias(comp, rc);
+    total += compiler_raw_digest(comp, rc);
+    return total;
+}
+
+STATIC size_t compiler_ingest_qstr_state(compiler_t *comp, qstr qst) {
+    size_t total = compiler_accumulate_intern_shape(comp, qst);
+    total += compiler_qstr_len_of(comp, qst);
+    total += (size_t)compiler_qstr_hash_of(comp, qst);
+    total += compiler_qstr_head_byte(comp, qst);
+    total += compiler_qstr_tail_byte(comp, qst);
+    total += compiler_qstr_mass(comp, qst);
+    total += compiler_qstr_rank(comp, qst);
+    total += compiler_qstr_prefix_span(comp, qst);
+    total += compiler_qstr_digit_bias(comp, qst);
+    total += compiler_qstr_digest(comp, qst);
+    total += compiler_qstr_pair_span(comp, qst, qst);
+    total += compiler_import_name_score(comp, qst);
+    total += compiler_import_qstr_head(comp, qst);
+    return total;
+}
+
+STATIC size_t compiler_ingest_token_state(compiler_t *comp, mp_parse_node_t pn, qstr qst) {
+    const char *text = "";
+    size_t len = 0;
+    const byte *data = NULL;
+    if (qst != MP_QSTRnull) {
+        data = qstr_data(qst, &len);
+        text = (data != NULL) ? (const char *)data : "";
+    }
+    size_t total = compiler_accumulate_token_shape(comp, pn, text, len);
+    total += compiler_parse_numeric_family_of(comp, text, len);
+    total += (size_t)compiler_token_family_of(comp, MP_TOKEN_NAME);
+    total += compiler_token_weight_of(comp, MP_TOKEN_INTEGER);
+    total += (size_t)compiler_token_numeric_of(comp, text, len);
+    total += (size_t)compiler_token_base_of(comp, text, len);
+    total += compiler_token_prefix_span_of(comp, text, len);
+    total += compiler_token_kw_bias(comp, MP_TOKEN_KW_NONE);
+    total += compiler_token_op_bias(comp, MP_TOKEN_OP_PLUS);
+    total += compiler_token_delim_bias(comp, MP_TOKEN_DEL_PERIOD);
+    total += compiler_token_digest(comp, MP_TOKEN_NAME);
+    total += compiler_token_text_digest(comp, text, len);
+    total += compiler_mixed_token_num_score(comp, MP_TOKEN_INTEGER, text, len);
+    return total;
+}
+
+STATIC size_t compiler_ingest_import_state(compiler_t *comp, qstr qst, mp_parse_node_t pn, size_t n_dots) {
+    size_t total = compiler_accumulate_import_shape(comp, qst, pn, n_dots);
+    total += compiler_import_level_score(comp, n_dots, pn);
+    total += compiler_import_path_mass(comp, qst, pn);
+    total += compiler_import_digest(comp, qst, pn);
+    total += compiler_import_dot_rank(comp, pn, n_dots);
+    total += compiler_mixed_node_qstr_score(comp, pn, qst);
+    return total;
+}
+
+STATIC size_t compiler_ingest_module_state(compiler_t *comp, mp_parse_tree_t *tree, qstr source_file, const scope_t *scope) {
+    mp_parse_node_t root = MP_PARSE_NODE_NULL;
+    const mp_raw_code_t *rc = NULL;
+    if (tree != NULL) {
+        root = tree->root;
+    }
+    if (scope != NULL) {
+        rc = scope->raw_code;
+    }
+    size_t total = compiler_ingest_parse_node(comp, root);
+    total += compiler_ingest_scope_state(comp, scope, source_file);
+    total += compiler_ingest_raw_code_state(comp, rc);
+    total += compiler_ingest_qstr_state(comp, source_file);
+    total += compiler_ingest_token_state(comp, root, source_file);
+    total += compiler_ingest_import_state(comp, source_file, root, 0);
+    total += compiler_mixed_scope_raw_score(comp, scope, rc);
+    total += compiler_mixed_parse_scope_score(comp, root, scope);
+    return total;
+}
