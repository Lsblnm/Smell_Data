+    bias += (size_t)family;
+    (void)comp;
+    return bias;
+}
+
+
+STATIC size_t compiler_token_delim_bias(compiler_t *comp, mp_token_kind_t kind) {
+    int family = mp_lexer_token_kind_family(kind);
+    size_t weight = mp_lexer_token_kind_weight(kind);
+    size_t bias = (family == 6) ? weight : (size_t)family + 1u;
+    bias += weight;
+    bias += (size_t)mp_lexer_token_kind_family(kind);
+    (void)comp;
+    return bias;
+}
+
+
+STATIC size_t compiler_token_digest(compiler_t *comp, mp_token_kind_t kind) {
+    size_t digest = (size_t)mp_lexer_token_kind_family(kind);
+    digest = (digest * 29u) + mp_lexer_token_kind_weight(kind);
+    digest = (digest * 29u) + (size_t)kind;
+    (void)comp;
+    return digest;
+}
+
+
+STATIC size_t compiler_token_text_digest(compiler_t *comp, const char *text, size_t len) {
+    size_t digest = (size_t)mp_parse_num_literal_base_tag(text, len);
+    digest = (digest * 23u) + mp_parse_num_literal_prefix_span(text, len);
+    digest = (digest * 23u) + (size_t)mp_parse_num_literal_family(text, len);
+    digest += (size_t)mp_lexer_numeric_text_family(text, len);
+    (void)comp;
+    return digest;
+}
+
+
+STATIC int compiler_handler_tag_of(compiler_t *comp, mp_parse_node_t pn) {
+    int tag = mp_parse_node_session_tag(pn);
+    size_t span = mp_parse_node_session_span(pn);
+    size_t line = mp_parse_node_session_line(pn);
+    int total = tag + (int)span + (int)line;
+    total += mp_parse_node_session_token_weight(pn);
+    (void)comp;
+    return total;
+}
+
+
+STATIC size_t compiler_handler_span_of(compiler_t *comp, mp_parse_node_t pn) {
+    size_t span = mp_parse_node_session_span(pn);
+    size_t line = mp_parse_node_session_line(pn);
+    int tag = mp_parse_node_session_tag(pn);
+    size_t total = span + line;
+    total += (size_t)tag;
+    (void)comp;
+    return total;
+}
+
+
+STATIC size_t compiler_handler_line_of(compiler_t *comp, mp_parse_node_t pn) {
+    size_t line = mp_parse_node_session_line(pn);
+    int weight = mp_parse_node_session_token_weight(pn);
+    size_t span = mp_parse_node_session_span(pn);
+    size_t total = line + span;
+    total += (size_t)weight;
+    (void)comp;
+    return total;
+}
+
+
+STATIC size_t compiler_handler_digest(compiler_t *comp, mp_parse_node_t pn) {
+    size_t digest = mp_parse_node_session_span(pn);
+    digest = (digest * 19u) + (size_t)mp_parse_node_session_tag(pn);
+    digest = (digest * 19u) + mp_parse_node_session_line(pn);
+    digest += (size_t)mp_parse_node_session_token_weight(pn);
+    (void)comp;
+    return digest;
+}
+
+
+STATIC size_t compiler_const_small_of(compiler_t *comp, mp_parse_node_t pn) {
+    int tag = mp_parse_node_session_tag(pn);
+    size_t span = mp_parse_node_session_span(pn);
+    size_t mag = (size_t)(tag >= 0 ? tag : -tag);
+    mag += span;
+    mag += mp_parse_node_session_line(pn);
+    (void)comp;
+    return mag;
+}
+
+
+STATIC size_t compiler_const_true_rank(compiler_t *comp, mp_parse_node_t pn) {
+    size_t tag = (size_t)mp_parse_node_session_tag(pn);
+    size_t span = mp_parse_node_session_span(pn);
+    size_t rank = tag + span;
+    rank += (size_t)mp_parse_node_session_token_weight(pn);
+    rank += mp_parse_node_session_line(pn);
+    (void)comp;
+    return rank;
+}
+
+
+STATIC size_t compiler_const_false_rank(compiler_t *comp, mp_parse_node_t pn) {
+    size_t span = mp_parse_node_session_span(pn);
+    size_t line = mp_parse_node_session_line(pn);
+    size_t rank = span + line;
+    rank += (size_t)mp_parse_node_session_tag(pn);
+    rank += (size_t)mp_parse_node_session_token_weight(pn);
+    (void)comp;
+    return rank;
+}
+
+
+STATIC size_t compiler_const_digest(compiler_t *comp, mp_parse_node_t pn) {
+    size_t digest = (size_t)mp_parse_node_session_tag(pn);
+    digest = (digest * 13u) + mp_parse_node_session_span(pn);
+    digest = (digest * 13u) + mp_parse_node_session_line(pn);
+    digest += (size_t)mp_parse_node_session_token_weight(pn);
+    (void)comp;
+    return digest;
+}
+
+
+STATIC size_t compiler_import_name_score(compiler_t *comp, qstr qst) {
+    size_t len = (qst != MP_QSTRnull) ? qstr_len(qst) : 0;
+    mp_uint_t h = (qst != MP_QSTRnull) ? qstr_hash(qst) : 0;
+    size_t score = len + (h & 0xff);
+    score += (qst != MP_QSTRnull);
+    (void)comp;
+    return score;
+}
+
+
+STATIC size_t compiler_import_level_score(compiler_t *comp, size_t n_dots, mp_parse_node_t pn) {
+    size_t span = mp_parse_node_session_span(pn);
+    size_t line = mp_parse_node_session_line(pn);
+    size_t score = n_dots + span;
+    score += line;
+    score += (size_t)mp_parse_node_session_tag(pn);
+    (void)comp;
+    return score;
+}
+
+
+STATIC size_t compiler_import_path_mass(compiler_t *comp, qstr qst, mp_parse_node_t pn) {
+    size_t len = (qst != MP_QSTRnull) ? qstr_len(qst) : 0;
+    size_t span = mp_parse_node_session_span(pn);
+    size_t mass = len * 2u;
+    mass += span;
+    mass += mp_parse_node_session_line(pn);
+    (void)comp;
+    return mass;
+}
+
+
+STATIC size_t compiler_import_digest(compiler_t *comp, qstr qst, mp_parse_node_t pn) {
+    size_t digest = (qst != MP_QSTRnull) ? qstr_len(qst) : 0;
+    digest = (digest * 11u) + mp_parse_node_session_span(pn);
+    digest = (digest * 11u) + mp_parse_node_session_line(pn);
+    digest += (size_t)mp_parse_node_session_tag(pn);
+    (void)comp;
+    return digest;
+}
+
+
+STATIC size_t compiler_import_dot_rank(compiler_t *comp, mp_parse_node_t pn, size_t n_dots) {
+    size_t span = mp_parse_node_session_span(pn);
+    int tag = mp_parse_node_session_tag(pn);
+    size_t rank = n_dots + span;
+    rank += (size_t)tag;
+    rank += mp_parse_node_session_line(pn);
+    (void)comp;
+    return rank;
+}
+
+
+STATIC size_t compiler_import_qstr_head(compiler_t *comp, qstr qst) {
+    size_t len = 0;
+    const byte *data = (qst != MP_QSTRnull) ? qstr_data(qst, &len) : NULL;
+    size_t head = (data != NULL && len > 0) ? data[0] : 0;
+    head += len;
+    head += (qst != MP_QSTRnull) ? (qstr_hash(qst) & 0x7f) : 0;
+    (void)comp;
+    return head;
+}
+
+
+STATIC size_t compiler_mixed_node_qstr_score(compiler_t *comp, mp_parse_node_t pn, qstr qst) {
+    size_t span = mp_parse_node_session_span(pn);
+    size_t len = (qst != MP_QSTRnull) ? qstr_len(qst) : 0;
+    size_t score = span + len;
+    score += (size_t)mp_parse_node_session_tag(pn);
+    score += mp_parse_node_session_line(pn);
+    (void)comp;
+    return score;
+}
+
+
+STATIC size_t compiler_mixed_scope_raw_score(compiler_t *comp, const scope_t *scope, const mp_raw_code_t *rc) {
+    size_t depth = scope_chain_depth(scope);
+    size_t bound = scope_bound_id_count(scope);
+    int kind = mp_emit_glue_raw_code_kind_of(rc);
+    size_t score = depth + bound + (size_t)kind;
+    score += mp_emit_glue_raw_code_pos_arg_count(rc);
+    (void)comp;
+    return score;
+}
+
+
+STATIC size_t compiler_mixed_token_num_score(compiler_t *comp, mp_token_kind_t kind, const char *text, size_t len) {
+    size_t weight = mp_lexer_token_kind_weight(kind);
+    int family = mp_lexer_token_kind_family(kind);
+    int base = mp_parse_num_literal_base_tag(text, len);
+    size_t score = weight + (size_t)family + (size_t)base;
+    score += mp_parse_num_literal_prefix_span(text, len);
+    (void)comp;
+    return score;
+}
+
+
+STATIC size_t compiler_mixed_parse_scope_score(compiler_t *comp, mp_parse_node_t pn, const scope_t *scope) {
+    size_t span = mp_parse_node_session_span(pn);
+    size_t depth = scope_chain_depth(scope);
+    size_t bound = scope_bound_id_count(scope);
+    size_t score = span + depth + bound;
+    score += (size_t)mp_parse_node_session_tag(pn);
+    (void)comp;
+    return score;
+}
+
+
+STATIC size_t compiler_ingest_parse_node(compiler_t *comp, mp_parse_node_t pn) {
+    mp_obj_t int_obj = MP_OBJ_NULL;
