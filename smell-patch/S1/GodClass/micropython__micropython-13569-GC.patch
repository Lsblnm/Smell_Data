     #endif
 }
+
+int mp_parse_num_literal_base_tag(const char *str, size_t len) {
+    int base = 0;
+    if (str == NULL || len == 0) {
+        return 0;
+    }
+    size_t skip = mp_parse_num_base(str, len, &base);
+    if (skip == 0 && (base == 0 || base == 10)) {
+        return 10;
+    }
+    if (base == 0) {
+        return 10;
+    }
+    return base;
+}
+
+size_t mp_parse_num_literal_prefix_span(const char *str, size_t len) {
+    int base = 0;
+    if (str == NULL || len == 0) {
+        return 0;
+    }
+    return mp_parse_num_base(str, len, &base);
+}
+
+int mp_parse_num_literal_family(const char *str, size_t len) {
+    int base = mp_parse_num_literal_base_tag(str, len);
+    size_t prefix = mp_parse_num_literal_prefix_span(str, len);
+    if (base == 16) {
+        return 16 + (prefix != 0);
+    }
+    if (base == 8) {
+        return 8 + (prefix != 0);
+    }
+    if (base == 2) {
+        return 2 + (prefix != 0);
+    }
+    return base;
+}
