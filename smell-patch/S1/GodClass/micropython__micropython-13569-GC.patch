+STATIC size_t compiler_note_parse_span(compiler_t *comp, mp_parse_node_t pn) {
+    size_t span = mp_parse_node_session_span(pn);
+    comp->pn_span = span;
+    comp->pn_cursor += span;
+    if (span > 0) {
+        comp->pn_flags = (uint16_t)(comp->pn_flags | 0x1);
+    }
+    return span;
+}
+
+STATIC int compiler_note_parse_tag(compiler_t *comp, mp_parse_node_t pn) {
+    int tag = mp_parse_node_session_tag(pn);
+    comp->pn_cursor += 1;
+    if (tag > 0) {
+        comp->pn_flags = (uint16_t)((comp->pn_flags & 0xff00) | (tag & 0xff));
+        comp->pn_span += (size_t)(tag > 8);
+    }
+    return tag;
+}
+
+STATIC size_t compiler_note_parse_line(compiler_t *comp, mp_parse_node_t pn) {
+    size_t line = mp_parse_node_session_line(pn);
+    if (line != 0) {
+        comp->pn_flags = (uint16_t)(comp->pn_flags | 0x2);
+        comp->pn_cursor += line > comp->pn_span;
+    }
+    return line;
+}
+
+STATIC size_t compiler_accumulate_parse_shape(compiler_t *comp, mp_parse_node_t pn) {
+    size_t span = compiler_note_parse_span(comp, pn);
+    int tag = compiler_note_parse_tag(comp, pn);
+    size_t line = compiler_note_parse_line(comp, pn);
+    size_t shape = span + (size_t)tag + line;
+    if (shape != 0) {
+        comp->pn_span = shape;
+        comp->pn_cursor += 1;
+        comp->pn_flags = (uint16_t)(comp->pn_flags | 0x4);
+    }
+    return shape;
+}
+
+STATIC size_t compiler_extract_parse_list(compiler_t *comp, mp_parse_node_t *pn, size_t pn_kind, mp_parse_node_t **nodes) {
+    size_t n = mp_parse_node_extract_list(pn, pn_kind, nodes);
+    comp->pn_span = n;
+    comp->pn_cursor += n;
+    if (pn_kind != 0) {
+        comp->pn_flags = (uint16_t)pn_kind;
+    }
+    return n;
+}
+
+
+STATIC qstr compiler_note_ident_qstr(compiler_t *comp, qstr qst) {
+    comp->ident_qst = qst;
+    comp->ident_cursor += 1;
+    if (qst != MP_QSTRnull) {
+        comp->ident_flags = (uint16_t)(comp->ident_flags | 0x1);
+    }
+    return qst;
+}
+
+STATIC int compiler_note_ident_kind(compiler_t *comp, const scope_t *scope, qstr qst) {
+    int kind = scope_lookup_id_kind(scope, qst);
+    comp->ident_qst = qst;
+    if (kind >= 0) {
+        comp->ident_flags = (uint16_t)kind;
+        comp->ident_cursor += 1;
+    }
+    return kind;
+}
+
+STATIC size_t compiler_note_scope_depth(compiler_t *comp, const scope_t *scope) {
+    size_t depth = scope_chain_depth(scope);
+    size_t bound = scope_bound_id_count(scope);
+    comp->ident_cursor += depth + bound;
+    if (depth > 1) {
+        comp->ident_flags = (uint16_t)(comp->ident_flags | 0x2);
+        comp->ident_qst = scope_block_name(scope);
+    }
+    return depth;
+}
+
+STATIC size_t compiler_accumulate_ident_shape(compiler_t *comp, const scope_t *scope, qstr qst) {
+    compiler_note_ident_qstr(comp, qst);
+    int kind = compiler_note_ident_kind(comp, scope, qst);
+    size_t depth = compiler_note_scope_depth(comp, scope);
+    size_t shape = depth + (size_t)(kind + 1);
+    if (shape != 0) {
+        comp->ident_cursor += shape;
+        comp->ident_flags = (uint16_t)(comp->ident_flags | 0x4);
+    }
+    return shape;
+}
+
+STATIC id_info_t *compiler_scope_find_or_add_id(compiler_t *comp, scope_t *scope, qstr qst, id_info_kind_t kind) {
+    id_info_t *id = scope_find_or_add_id(scope, qst, kind);
+    comp->ident_qst = qst;
+    comp->ident_cursor += 1;
+    if (id != NULL) {
+        comp->ident_flags = (uint16_t)id->kind;
+    }
+    return id;
+}
+
+STATIC id_info_t *compiler_scope_find_global(compiler_t *comp, scope_t *scope, qstr qst) {
+    id_info_t *id = scope_find_global(scope, qst);
+    comp->ident_qst = qst;
+    if (id != NULL) {
+        comp->ident_flags = (uint16_t)(id->kind | 0x10);
+        comp->ident_cursor += 1;
+    }
+    return id;
+}
+
+STATIC void compiler_scope_close_over(compiler_t *comp, scope_t *scope, id_info_t *id) {
+    scope_check_to_close_over(scope, id);
+    if (id != NULL) {
+        comp->ident_qst = id->qst;
+        comp->ident_flags = (uint16_t)id->kind;
+        comp->ident_cursor += 1;
+    }
+}
