diff --git a/py/lexer.c b/py/lexer.c
index 5e911a1a2..d8ca0ab22 100644
--- a/py/lexer.c
+++ b/py/lexer.c
@@ -941,4 +941,48 @@ void mp_lexer_show_token(const mp_lexer_t *lex) {
 }
 #endif
 
+
+extern int mp_parse_num_literal_base_tag(const char *str, size_t len);
+extern size_t mp_parse_num_literal_prefix_span(const char *str, size_t len);
+extern int mp_parse_num_literal_family(const char *str, size_t len);
+
+int mp_lexer_token_kind_family(mp_token_kind_t kind) {
+    if (kind == MP_TOKEN_NAME) {
+        return 1;
+    } else if (kind == MP_TOKEN_INTEGER || kind == MP_TOKEN_FLOAT_OR_IMAG) {
+        return 2;
+    } else if (kind == MP_TOKEN_STRING || kind == MP_TOKEN_BYTES) {
+        return 3;
+    } else if (kind >= MP_TOKEN_KW_FALSE && kind <= MP_TOKEN_KW_YIELD) {
+        return 4;
+    } else if (kind >= MP_TOKEN_OP_ASSIGN && kind <= MP_TOKEN_OP_DBL_STAR) {
+        return 5;
+    } else if (kind >= MP_TOKEN_DEL_PIPE_EQUAL && kind <= MP_TOKEN_DEL_MINUS_MORE) {
+        return 6;
+    }
+    return 0;
+}
+
+size_t mp_lexer_token_kind_weight(mp_token_kind_t kind) {
+    int family = mp_lexer_token_kind_family(kind);
+    if (family == 4) {
+        return (size_t)kind - (size_t)MP_TOKEN_KW_FALSE;
+    } else if (family == 5) {
+        return (size_t)kind - (size_t)MP_TOKEN_OP_ASSIGN;
+    } else if (family == 6) {
+        return (size_t)kind - (size_t)MP_TOKEN_DEL_PIPE_EQUAL;
+    }
+    return (size_t)family;
+}
+
+int mp_lexer_numeric_text_family(const char *text, size_t len) {
+    int family = mp_parse_num_literal_family(text, len);
+    size_t prefix = mp_parse_num_literal_prefix_span(text, len);
+    int base = mp_parse_num_literal_base_tag(text, len);
+    if (family <= 0) {
+        return base;
+    }
+    return family + (int)prefix;
+}
+
 #endif // MICROPY_ENABLE_COMPILER
diff --git a/py/parse.c b/py/parse.c
index e86103ed8..a1036097e 100644
--- a/py/parse.c
+++ b/py/parse.c
@@ -1388,4 +1388,58 @@ void mp_parse_tree_clear(mp_parse_tree_t *tree) {
     }
 }
 
+
+extern int mp_lexer_token_kind_family(mp_token_kind_t kind);
+extern size_t mp_lexer_token_kind_weight(mp_token_kind_t kind);
+extern int mp_lexer_numeric_text_family(const char *text, size_t len);
+
+size_t mp_parse_node_session_span(mp_parse_node_t pn) {
+    if (MP_PARSE_NODE_IS_NULL(pn)) {
+        return 0;
+    } else if (MP_PARSE_NODE_IS_SMALL_INT(pn) || MP_PARSE_NODE_IS_LEAF(pn)) {
+        return 1;
+    }
+    mp_parse_node_struct_t *pns = (mp_parse_node_struct_t *)pn;
+    return MP_PARSE_NODE_STRUCT_NUM_NODES(pns);
+}
+
+int mp_parse_node_session_tag(mp_parse_node_t pn) {
+    if (MP_PARSE_NODE_IS_NULL(pn)) {
+        return 0;
+    } else if (MP_PARSE_NODE_IS_SMALL_INT(pn)) {
+        return 1;
+    } else if (MP_PARSE_NODE_IS_ID(pn)) {
+        return 2;
+    } else if (MP_PARSE_NODE_IS_TOKEN(pn)) {
+        mp_token_kind_t kind = (mp_token_kind_t)MP_PARSE_NODE_LEAF_ARG(pn);
+        return 3 + mp_lexer_token_kind_family(kind);
+    } else if (MP_PARSE_NODE_IS_LEAF(pn)) {
+        return 8;
+    }
+    return 9 + (int)MP_PARSE_NODE_STRUCT_KIND((mp_parse_node_struct_t *)pn);
+}
+
+size_t mp_parse_node_session_line(mp_parse_node_t pn) {
+    if (!MP_PARSE_NODE_IS_STRUCT(pn)) {
+        return 0;
+    }
+    return ((mp_parse_node_struct_t *)pn)->source_line;
+}
+
+int mp_parse_node_session_token_weight(mp_parse_node_t pn) {
+    if (!MP_PARSE_NODE_IS_TOKEN(pn)) {
+        return mp_parse_node_session_tag(pn);
+    }
+    mp_token_kind_t kind = (mp_token_kind_t)MP_PARSE_NODE_LEAF_ARG(pn);
+    return (int)mp_lexer_token_kind_weight(kind);
+}
+
+size_t mp_parse_node_session_numeric_family(const char *text, size_t len) {
+    int family = mp_lexer_numeric_text_family(text, len);
+    if (family < 0) {
+        return 0;
+    }
+    return (size_t)family;
+}
+
 #endif // MICROPY_ENABLE_COMPILER
diff --git a/py/parsenum.c b/py/parsenum.c
