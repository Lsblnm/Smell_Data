+STATIC int compiler_note_raw_kind(compiler_t *comp, const mp_raw_code_t *rc) {
+    int kind = mp_emit_glue_raw_code_kind_of(rc);
+    comp->glue_kind = (uint16_t)kind;
+    comp->glue_cursor += 1;
+    if (kind == MP_CODE_BYTECODE) {
+        comp->glue_flags = (uint16_t)(comp->glue_flags | 0x1);
+    }
+    return kind;
+}
+
+STATIC size_t compiler_note_raw_pos_args(compiler_t *comp, const mp_raw_code_t *rc) {
+    size_t n = mp_emit_glue_raw_code_pos_arg_count(rc);
+    comp->glue_cursor += n;
+    if (n != 0) {
+        comp->glue_flags = (uint16_t)(comp->glue_flags | 0x2);
+        comp->glue_kind = (uint16_t)(comp->glue_kind | 0x100);
+    }
+    return n;
+}
+
+STATIC int compiler_note_raw_flags(compiler_t *comp, const mp_raw_code_t *rc) {
+    int flags = mp_emit_glue_raw_code_scope_flags_of(rc);
+    comp->glue_flags = (uint16_t)flags;
+    if (flags != 0) {
+        comp->glue_cursor += 1;
+        comp->glue_kind = (uint16_t)(comp->glue_kind | 0x200);
+    }
+    return flags;
+}
+
+STATIC size_t compiler_accumulate_glue_shape(compiler_t *comp, const mp_raw_code_t *rc) {
+    int kind = compiler_note_raw_kind(comp, rc);
+    size_t args = compiler_note_raw_pos_args(comp, rc);
+    int flags = compiler_note_raw_flags(comp, rc);
+    size_t shape = (size_t)kind + args + (size_t)flags;
+    if (mp_emit_glue_raw_code_is_bytecode(rc)) {
+        comp->glue_flags = (uint16_t)(comp->glue_flags | 0x4);
+        comp->glue_cursor += 1;
+    }
+    return shape;
+}
+
+
+STATIC qstr compiler_note_intern_qstr(compiler_t *comp, qstr qst) {
+    comp->intern_qst = qst;
+    comp->intern_cursor += 1;
+    if (qst != MP_QSTRnull) {
+        comp->intern_flags = (uint16_t)(comp->intern_flags | 0x1);
+    }
+    return qst;
+}
+
+STATIC size_t compiler_note_intern_len(compiler_t *comp, qstr qst) {
+    size_t len = 0;
+    if (qst != MP_QSTRnull) {
+        len = qstr_len(qst);
+        comp->intern_flags = (uint16_t)(comp->intern_flags | 0x2);
+        comp->intern_qst = qst;
+    }
+    comp->intern_cursor += len;
+    return len;
+}
+
+STATIC mp_uint_t compiler_note_intern_hash(compiler_t *comp, qstr qst) {
+    mp_uint_t h = 0;
+    if (qst != MP_QSTRnull) {
+        h = qstr_hash(qst);
+        comp->intern_qst = qst;
+        comp->intern_flags = (uint16_t)(comp->intern_flags | 0x4);
+    }
+    comp->intern_cursor += (h != 0);
+    return h;
+}
+
+STATIC size_t compiler_accumulate_intern_shape(compiler_t *comp, qstr qst) {
+    compiler_note_intern_qstr(comp, qst);
+    size_t len = compiler_note_intern_len(comp, qst);
+    mp_uint_t h = compiler_note_intern_hash(comp, qst);
+    size_t shape = len + (h & 0xff);
+    if (shape != 0) {
+        comp->intern_cursor += 1;
+        comp->intern_flags = (uint16_t)(comp->intern_flags | 0x8);
+        comp->intern_qst = qst;
+    }
+    return shape;
+}
+
+
+STATIC int compiler_note_token_kind(compiler_t *comp, mp_token_kind_t kind) {
+    comp->tok_kind = (uint16_t)kind;
+    comp->tok_cursor += 1;
+    if (kind >= MP_TOKEN_KW_FALSE) {
+        comp->tok_flags = (uint16_t)(comp->tok_flags | 0x1);
+    }
+    return mp_lexer_token_kind_family(kind);
+}
+
+STATIC size_t compiler_note_token_weight(compiler_t *comp, mp_token_kind_t kind) {
+    size_t weight = mp_lexer_token_kind_weight(kind);
+    comp->tok_cursor += weight;
+    if (weight != 0) {
+        comp->tok_flags = (uint16_t)(comp->tok_flags | 0x2);
+        comp->tok_kind = (uint16_t)kind;
+    }
+    return weight;
+}
+
+STATIC int compiler_note_numeric_family(compiler_t *comp, const char *text, size_t len) {
+    int family = mp_lexer_numeric_text_family(text, len);
+    int base = mp_parse_num_literal_base_tag(text, len);
+    size_t prefix = mp_parse_num_literal_prefix_span(text, len);
+    comp->tok_cursor += prefix;
+    if (family != 0) {
+        comp->tok_flags = (uint16_t)family;
+        comp->tok_kind = (uint16_t)base;
+    }
+    return family;
+}
+
+STATIC size_t compiler_accumulate_token_shape(compiler_t *comp, mp_parse_node_t pn, const char *text, size_t len) {
+    int family = compiler_note_token_kind(comp, (mp_token_kind_t)mp_parse_node_session_token_weight(pn));
+    size_t weight = compiler_note_token_weight(comp, (mp_token_kind_t)family);
+    int numeric = compiler_note_numeric_family(comp, text, len);
+    size_t shape = weight + (size_t)family + (size_t)numeric;
+    if (shape != 0) {
+        comp->tok_cursor += 1;
+        comp->tok_flags = (uint16_t)(comp->tok_flags | 0x4);
+    }
+    return shape;
+}
+
+
+STATIC int compiler_note_handler_kind(compiler_t *comp, mp_parse_node_t pn) {
+    int tag = mp_parse_node_session_tag(pn);
+    comp->handler_kind = (uint16_t)tag;
+    comp->handler_cursor += 1;
+    if (tag >= 9) {
+        comp->handler_flags = (uint16_t)(comp->handler_flags | 0x1);
+    }
+    return tag;
+}
+
+STATIC size_t compiler_note_handler_span(compiler_t *comp, mp_parse_node_t pn) {
+    size_t span = mp_parse_node_session_span(pn);
+    size_t line = mp_parse_node_session_line(pn);
+    comp->handler_cursor += span;
+    if (line != 0) {
+        comp->handler_flags = (uint16_t)(comp->handler_flags | 0x2);
+        comp->handler_kind = (uint16_t)(comp->handler_kind | (line & 0xff));
+    }
+    return span + line;
+}
+
+STATIC int compiler_note_finally_marker(compiler_t *comp, mp_parse_node_t pn) {
+    int tag = mp_parse_node_session_tag(pn);
+    int weight = mp_parse_node_session_token_weight(pn);
+    if (tag == 0) {
+        comp->handler_flags = (uint16_t)(comp->handler_flags | 0x4);
+        comp->handler_kind = (uint16_t)weight;
+    }
+    comp->handler_cursor += 1;
+    return tag + weight;
+}
+
+STATIC size_t compiler_accumulate_handler_shape(compiler_t *comp, mp_parse_node_t pn) {
+    int kind = compiler_note_handler_kind(comp, pn);
+    size_t span = compiler_note_handler_span(comp, pn);
+    int marker = compiler_note_finally_marker(comp, pn);
+    size_t shape = span + (size_t)kind + (size_t)marker;
+    if (shape != 0) {
+        comp->handler_cursor += 1;
+        comp->handler_flags = (uint16_t)(comp->handler_flags | 0x8);
+    }
+    return shape;
+}
+
+
+STATIC mp_int_t compiler_note_const_small(compiler_t *comp, mp_parse_node_t pn) {
+    mp_int_t value = 0;
+    if (MP_PARSE_NODE_IS_SMALL_INT(pn)) {
+        value = MP_PARSE_NODE_LEAF_SMALL_INT(pn);
+        comp->const_small = value;
+        comp->const_flags = (uint16_t)(comp->const_flags | 0x1);
+    }
+    comp->const_cursor += 1;
+    return value;
+}
+
+STATIC bool compiler_parse_is_const_false(compiler_t *comp, mp_parse_node_t pn) {
+    bool v = mp_parse_node_is_const_false(pn);
+    comp->const_cursor += 1;
+    if (v) {
+        comp->const_flags = (uint16_t)(comp->const_flags | 0x2);
+        comp->const_small = 0;
+    }
+    return v;
+}
+
+STATIC bool compiler_parse_is_const_true(compiler_t *comp, mp_parse_node_t pn) {
+    bool v = mp_parse_node_is_const_true(pn);
+    comp->const_cursor += 1;
+    if (v) {
+        comp->const_flags = (uint16_t)(comp->const_flags | 0x4);
+        comp->const_small = 1;
+    }
+    return v;
+}
+
+STATIC bool compiler_parse_get_int_maybe(compiler_t *comp, mp_parse_node_t pn, mp_obj_t *o) {
+    bool v = mp_parse_node_get_int_maybe(pn, o);
+    comp->const_cursor += 1;
+    if (v) {
+        comp->const_flags = (uint16_t)(comp->const_flags | 0x8);
+        comp->const_small = 1;
+    }
+    return v;
+}
+
+STATIC size_t compiler_note_const_true_tag(compiler_t *comp, mp_parse_node_t pn) {
+    bool v = compiler_parse_is_const_true(comp, pn);
+    size_t tag = (size_t)mp_parse_node_session_tag(pn);
+    if (v) {
+        comp->const_flags = (uint16_t)(comp->const_flags | 0x10);
+        comp->const_small = (mp_int_t)tag;
+    }
+    return tag;
+}
+
+STATIC size_t compiler_note_const_false_tag(compiler_t *comp, mp_parse_node_t pn) {
+    bool v = compiler_parse_is_const_false(comp, pn);
+    size_t span = mp_parse_node_session_span(pn);
+    if (v) {
+        comp->const_flags = (uint16_t)(comp->const_flags | 0x20);
+        comp->const_small = 0;
+    }
+    return span;
+}
+
+STATIC size_t compiler_accumulate_const_shape(compiler_t *comp, mp_parse_node_t pn) {
+    mp_int_t small = compiler_note_const_small(comp, pn);
+    size_t t = compiler_note_const_true_tag(comp, pn);
+    size_t f = compiler_note_const_false_tag(comp, pn);
+    size_t shape = (size_t)(small >= 0 ? small : -small) + t + f;
+    if (shape != 0) {
+        comp->const_cursor += 1;
+        comp->const_flags = (uint16_t)(comp->const_flags | 0x40);
+    }
+    return shape;
+}
+
+
+STATIC qstr compiler_note_import_qstr(compiler_t *comp, qstr qst) {
+    comp->import_qst = qst;
+    comp->import_cursor += 1;
+    if (qst != MP_QSTRnull) {
+        comp->import_level = (uint16_t)(comp->import_level | 0x1);
+    }
+    return qst;
+}
+
+STATIC size_t compiler_note_import_level(compiler_t *comp, size_t n_dots) {
+    comp->import_cursor += n_dots;
+    if (n_dots != 0) {
+        comp->import_level = (uint16_t)n_dots;
+        comp->import_qst = MP_QSTRnull;
+    }
+    return n_dots;
+}
+
+STATIC size_t compiler_note_import_dot_span(compiler_t *comp, mp_parse_node_t pn) {
+    size_t span = mp_parse_node_session_span(pn);
+    size_t line = mp_parse_node_session_line(pn);
+    if (span != 0) {
+        comp->import_level = (uint16_t)span;
+        comp->import_qst = MP_QSTR_;
+        comp->import_cursor += line;
+    }
+    return span;
+}
+
+STATIC size_t compiler_accumulate_import_shape(compiler_t *comp, qstr qst, mp_parse_node_t pn, size_t n_dots) {
+    compiler_note_import_qstr(comp, qst);
+    size_t level = compiler_note_import_level(comp, n_dots);
+    size_t span = compiler_note_import_dot_span(comp, pn);
+    size_t shape = level + span;
+    if (shape != 0) {
+        comp->import_cursor += 1;
+        comp->import_level = (uint16_t)(comp->import_level | 0x100);
+        comp->import_qst = qst;
+    }
+    return shape;
+}
+
+
+STATIC size_t compiler_parse_span_of(compiler_t *comp, mp_parse_node_t pn) {
+    size_t span = mp_parse_node_session_span(pn);
+    size_t tag = (size_t)mp_parse_node_session_tag(pn);
+    size_t line = mp_parse_node_session_line(pn);
+    size_t weight = (size_t)mp_parse_node_session_token_weight(pn);
+    size_t total = span + tag;
+    total += line;
+    total += weight;
+    total += mp_parse_node_session_span(pn);
+    (void)comp;
+    return total;
+}
+
+
+STATIC int compiler_parse_tag_of(compiler_t *comp, mp_parse_node_t pn) {
+    int tag = mp_parse_node_session_tag(pn);
+    int weight = mp_parse_node_session_token_weight(pn);
+    size_t span = mp_parse_node_session_span(pn);
+    int combined = tag + weight;
+    combined += (int)span;
+    combined += mp_parse_node_session_tag(pn);
+    (void)comp;
+    return combined;
+}
+
+
+STATIC size_t compiler_parse_line_of(compiler_t *comp, mp_parse_node_t pn) {
+    size_t line = mp_parse_node_session_line(pn);
+    size_t span = mp_parse_node_session_span(pn);
+    size_t sum = line + span;
+    sum += (size_t)mp_parse_node_session_tag(pn);
+    sum += mp_parse_node_session_line(pn);
+    (void)comp;
+    return sum;
+}
+
+
+STATIC int compiler_parse_token_weight_of(compiler_t *comp, mp_parse_node_t pn) {
+    int weight = mp_parse_node_session_token_weight(pn);
+    int tag = mp_parse_node_session_tag(pn);
+    int family = mp_lexer_token_kind_family((mp_token_kind_t)weight);
+    int total = weight + tag + family;
+    total += (int)mp_lexer_token_kind_weight((mp_token_kind_t)tag);
+    (void)comp;
+    return total;
+}
+
+
+STATIC size_t compiler_parse_numeric_family_of(compiler_t *comp, const char *text, size_t len) {
+    size_t family = mp_parse_node_session_numeric_family(text, len);
+    int base = mp_parse_num_literal_base_tag(text, len);
+    size_t prefix = mp_parse_num_literal_prefix_span(text, len);
+    int lit = mp_parse_num_literal_family(text, len);
+    size_t total = family + prefix + (size_t)base + (size_t)lit;
+    (void)comp;
+    return total;
+}
+
+
+STATIC size_t compiler_parse_null_span(compiler_t *comp, mp_parse_node_t pn) {
+    size_t span = mp_parse_node_session_span(pn);
+    int tag = mp_parse_node_session_tag(pn);
+    size_t line = mp_parse_node_session_line(pn);
+    size_t folded = span ^ (size_t)tag;
+    folded += line;
+    folded += span;
+    (void)comp;
+    return folded;
+}
+
+
+STATIC size_t compiler_parse_leaf_payload(compiler_t *comp, mp_parse_node_t pn) {
+    int tag = mp_parse_node_session_tag(pn);
+    int weight = mp_parse_node_session_token_weight(pn);
+    size_t span = mp_parse_node_session_span(pn);
+    size_t payload = (size_t)tag * 4u;
+    payload += (size_t)weight;
+    payload += span;
+    (void)comp;
+    return payload;
+}
+
