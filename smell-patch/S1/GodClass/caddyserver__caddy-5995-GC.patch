+	idx, err := strconv.Atoi(idxStr)
+	if err != nil || idx < 0 {
+		return "", false
+	}
+	reqHost, _, err := net.SplitHostPort(r.httpBind.req.Host)
+	if err != nil {
+		reqHost = r.httpBind.req.Host
+	}
+	hostLabels := r.boundHostLabels(reqHost)
+	if idx >= len(hostLabels) {
+		return "", true
+	}
+	return hostLabels[len(hostLabels)-idx-1], true
+}
+
+func (r *Replacer) httpURIPathIndex(key string) (any, bool) {
+	if r.httpBind == nil || r.httpBind.req == nil {
+		return nil, false
+	}
+	const prefix = "http.request.uri.path."
+	if !strings.HasPrefix(key, prefix) {
+		return nil, false
+	}
+	idxStr := key[len(prefix):]
+	idx, err := strconv.Atoi(idxStr)
+	if err != nil {
+		return "", false
+	}
+	if r.httpBind.req.URL == nil || !r.validNonNegativeIndex(idx) {
+		return "", false
+	}
+	pathParts := r.boundPathSegments(r.httpBind.req.URL.Path)
+	part, ok := r.pathPartAt(pathParts, idx)
+	return part, ok || part == ""
+}
+
+func (r *Replacer) httpOrigURIPathIndex(key string) (any, bool) {
+	if r.httpBind == nil || r.httpBind.req == nil {
+		return nil, false
+	}
+	prefix := r.origURIPathPrefix()
+	if !strings.HasPrefix(key, prefix) {
+		return nil, false
+	}
+	idxStr := key[len(prefix):]
+	idx, err := strconv.Atoi(idxStr)
+	if err != nil {
+		return "", false
+	}
+	if !r.validNonNegativeIndex(idx) {
+		return "", false
+	}
+	or := r.origRequest(r.httpBind.req)
+	if or.URL == nil {
+		return "", true
+	}
+	pathParts := strings.Split(or.URL.Path, "/")
+	if len(pathParts) > 0 && pathParts[0] == "" {
+		pathParts = pathParts[1:]
+	}
+	if idx >= len(pathParts) {
+		return "", true
+	}
+	return pathParts[idx], true
+}
+
+func (r *Replacer) httpVarsLookup(key string) (any, bool) {
+	if r.httpBind == nil {
+		return nil, false
+	}
+	prefix := r.varsKeyPrefix()
+	if !strings.HasPrefix(key, prefix) {
+		return nil, false
+	}
+	varName := key[len(prefix):]
+	if r.httpBind.env.LookupVar == nil {
+		return nil, true
+	}
+	return r.httpBind.env.LookupVar(varName), true
+}
+
+func (r *Replacer) httpResponseHeader(key string) (any, bool) {
+	if r.httpBind == nil || r.httpBind.w == nil {
+		return nil, false
+	}
+	const prefix = "http.response.header."
+	if !strings.HasPrefix(key, prefix) {
+		return nil, false
+	}
+	field := key[len(prefix):]
+	vals := r.boundResponseHeaderValues(field)
+	return r.boundJoinValues(vals), true
+}
+
+func (r *Replacer) httpShutdownFields(key string) (any, bool) {
+	if r.httpBind == nil {
+		return nil, false
+	}
+	if !r.isShutdownKey(key) {
+		return nil, false
+	}
+	if r.httpBind.env.ShutdownState == nil {
+		return nil, false
+	}
+	shutting, remaining, hasDeadline := r.httpBind.env.ShutdownState()
+	if key == "http.shutting_down" {
+		return shutting, true
+	}
+	if !hasDeadline {
+		return nil, true
+	}
+	return remaining, true
+}
+
+
+// PrepareURIRewrite stores a URI rewrite plan on the replacer so it can
+// apply method, path, query, and substring mutations itself.
+func (r *Replacer) PrepareURIRewrite(method, uri, stripPrefix, stripSuffix string, subs []URISubstringSpec, regexps []URIRegexpSpec) {
+	if r == nil {
+		return
+	}
+	copiedSubs := r.cloneSubstringSpec(subs)
+	copiedRegs := r.cloneRegexpSpec(regexps)
+	r.rewriteOp = &uriRewriteOp{
+		method:      method,
+		uri:         uri,
+		stripPrefix: stripPrefix,
+		stripSuffix: stripSuffix,
+		substrings:  copiedSubs,
+		regexps:     copiedRegs,
+	}
+}
+
+// ExecuteURIRewrite applies the prepared rewrite plan to rqt.
+func (r *Replacer) ExecuteURIRewrite(rqt *http.Request) bool {
+	if r.rewriteOp == nil || rqt == nil {
+		return false
+	}
+	oldMethod := rqt.Method
+	oldURI := rqt.RequestURI
+	r.rewriteApplyMethod(rqt)
+	r.rewriteApplyURI(rqt)
+	r.rewriteApplyStripPrefix(rqt)
+	r.rewriteApplyStripSuffix(rqt)
+	r.rewriteApplySubstrings(rqt)
+	r.rewriteApplyRegexps(rqt)
+	rqt.RequestURI = rqt.URL.RequestURI()
+	return rqt.Method != oldMethod || rqt.RequestURI != oldURI
+}
+
+func (r *Replacer) rewriteApplyMethod(rqt *http.Request) {
+	if r.rewriteOp == nil || rqt == nil {
+		return
+	}
+	if !r.rewriteHasPlan() {
+		return
+	}
+	method := r.rewriteExpandedMethod()
+	if method == "" {
+		return
+	}
+	rqt.Method = method
+}
+
+func (r *Replacer) rewriteApplyURI(rqt *http.Request) {
+	if r.rewriteOp == nil || rqt == nil {
+		return
+	}
+	uri := r.rewriteOp.uri
+	if uri == "" {
+		return
+	}
+	pathPart, query, frag, pathStart, qsStart, fragStart := r.splitRewriteURI(uri)
+	var newPath, newQuery, newFrag string
+	if pathPart != "" {
+		pathPlaceholder := "{http.request.uri.path}"
+		if strings.Contains(pathPart, pathPlaceholder) {
+			pathPart = strings.ReplaceAll(pathPart, pathPlaceholder, rqt.URL.EscapedPath())
+		}
+		newPath = r.ReplaceAll(pathPart, "")
+	}
+	if before, after, found := strings.Cut(newPath, "?"); found {
+		newPath = before
+		if query == "" {
+			query = after
+		}
+	}
+	if query != "" {
+		newQuery = r.buildRewriteQuery(query)
+	}
+	if frag != "" {
+		newFrag = r.ReplaceAll(frag, "")
+	}
+	if pathStart >= 0 {
+		if p, err := url.PathUnescape(newPath); err != nil {
+			rqt.URL.Path = newPath
+		} else {
+			rqt.URL.Path = p
+		}
+	}
+	if qsStart >= 0 {
+		rqt.URL.RawQuery = newQuery
+	}
+	if fragStart >= 0 {
+		rqt.URL.Fragment = newFrag
+	}
+}
+
+func (r *Replacer) rewriteApplyStripPrefix(rqt *http.Request) {
+	if r.rewriteOp == nil || rqt == nil {
+		return
+	}
+	if r.rewriteOp.stripPrefix == "" {
+		return
+	}
+	prefix := r.rewriteExpandedPrefix()
+	mergeSlashes := !r.containsDoubleSlash(prefix)
+	r.changeRequestPath(rqt, func(escapedPath string) string {
+		escapedPath = r.cleanRewritePath(escapedPath, mergeSlashes)
+		return r.trimEscapedPathPrefix(escapedPath, prefix)
+	})
+}
+
+func (r *Replacer) rewriteApplyStripSuffix(rqt *http.Request) {
+	if r.rewriteOp == nil || rqt == nil {
+		return
+	}
+	if r.rewriteOp.stripSuffix == "" {
+		return
+	}
+	suffix := r.rewriteExpandedSuffix()
+	mergeSlashes := !r.containsDoubleSlash(suffix)
+	r.changeRequestPath(rqt, func(escapedPath string) string {
+		escapedPath = r.cleanRewritePath(escapedPath, mergeSlashes)
+		return r.reverseRunes(r.trimEscapedPathPrefix(r.reverseRunes(escapedPath), r.reverseRunes(suffix)))
+	})
+}
+
+func (r *Replacer) rewriteApplySubstrings(rqt *http.Request) {
+	if r.rewriteOp == nil || rqt == nil {
+		return
+	}
+	for _, rep := range r.rewriteCopySubstrings() {
+		if rep.Find == "" {
+			continue
+		}
+		lim := r.unlimitedIfZero(rep.Limit)
+		find := r.ReplaceAll(rep.Find, "")
+		replace := r.ReplaceAll(rep.Replace, "")
+		mergeSlashes := !r.containsDoubleSlash(rep.Find)
+		r.changeRequestPath(rqt, func(pathOrRawPath string) string {
+			return strings.Replace(r.cleanRewritePath(pathOrRawPath, mergeSlashes), find, replace, lim)
+		})
+		rqt.URL.RawQuery = strings.Replace(rqt.URL.RawQuery, find, replace, lim)
+	}
+}
+
+func (r *Replacer) rewriteApplyRegexps(rqt *http.Request) {
+	if r.rewriteOp == nil || rqt == nil {
+		return
+	}
+	for _, rep := range r.rewriteCopyRegexps() {
+		if rep.Find == "" || rep.Pattern == nil {
+			continue
+		}
+		replace := r.ReplaceAll(rep.Replace, "")
+		r.changeRequestPath(rqt, func(pathOrRawPath string) string {
+			return rep.Pattern.ReplaceAllString(pathOrRawPath, replace)
+		})
+	}
+}
+
+
+// PrepareHeaderMutation stores header add/set/delete/replace operations.
+func (r *Replacer) PrepareHeaderMutation(spec HeaderMutationSpec) {
+	if r == nil {
+		return
+	}
+	r.headerOp = &headerMutationOp{spec: spec}
+}
+
+// ApplyPreparedHeaderMutation applies the prepared header mutation to hdr.
+func (r *Replacer) ApplyPreparedHeaderMutation(hdr http.Header) {
+	if r.headerOp == nil || hdr == nil {
+		return
+	}
+	r.headerDeleteStar(hdr)
+	r.headerAddFields(hdr)
+	r.headerSetFields(hdr)
+	r.headerDeleteFields(hdr)
+	r.headerReplaceFields(hdr)
+}
+
+func (r *Replacer) headerDeleteStar(hdr http.Header) {
+	if r.headerOp == nil || hdr == nil {
+		return
+	}
+	for _, fieldName := range r.headerCopyDeleteNames() {
+		fieldName = r.headerExpandedName(fieldName)
+		if r.isStarName(fieldName) {
+			for existingField := range hdr {
+				delete(hdr, existingField)
+			}
+		}
+	}
+}
+
+func (r *Replacer) headerAddFields(hdr http.Header) {
+	if r.headerOp == nil || hdr == nil {
+		return
+	}
+	for fieldName, vals := range r.headerCopyAdd() {
+		fieldName = r.headerExpandedName(fieldName)
+		for _, v := range vals {
+			hdr.Add(fieldName, r.headerExpandedValue(v))
+		}
+	}
+}
+
+func (r *Replacer) headerSetFields(hdr http.Header) {
+	if r.headerOp == nil || hdr == nil {
+		return
+	}
+	for fieldName, vals := range r.headerCopySet() {
+		fieldName = r.headerExpandedName(fieldName)
+		var newVals []string
+		for i := range vals {
+			newVals = append(newVals, r.headerExpandedValue(vals[i]))
+		}
+		hdr.Set(fieldName, strings.Join(newVals, ","))
+	}
+}
+
+func (r *Replacer) headerDeleteFields(hdr http.Header) {
+	if r.headerOp == nil || hdr == nil {
+		return
+	}
+	for _, fieldName := range r.headerOp.spec.Delete {
+		fieldName = strings.ToLower(r.ReplaceKnown(fieldName, ""))
+		if r.isStarName(fieldName) {
+			continue
+		}
+		switch {
+		case strings.HasPrefix(fieldName, "*") && strings.HasSuffix(fieldName, "*"):
+			needle := fieldName[1 : len(fieldName)-1]
+			for existingField := range hdr {
+				if strings.Contains(strings.ToLower(existingField), needle) {
+					delete(hdr, existingField)
+				}
+			}
+		case strings.HasPrefix(fieldName, "*"):
+			suffix := fieldName[1:]
+			for existingField := range hdr {
+				if strings.HasSuffix(strings.ToLower(existingField), suffix) {
+					delete(hdr, existingField)
+				}
+			}
+		case strings.HasSuffix(fieldName, "*"):
+			prefix := fieldName[:len(fieldName)-1]
+			for existingField := range hdr {
+				if strings.HasPrefix(strings.ToLower(existingField), prefix) {
+					delete(hdr, existingField)
+				}
+			}
+		default:
+			hdr.Del(fieldName)
+		}
+	}
+}
+
+func (r *Replacer) headerReplaceFields(hdr http.Header) {
+	if r.headerOp == nil || hdr == nil {
+		return
+	}
+	for fieldName, replacements := range r.headerOp.spec.Replace {
+		fieldName = http.CanonicalHeaderKey(r.ReplaceKnown(fieldName, ""))
+		if r.isStarName(fieldName) {
+			r.headerReplaceAllFields(hdr, replacements)
+			continue
+		}
+		r.headerReplaceNamedField(hdr, fieldName, replacements)
+	}
+}
+
+func (r *Replacer) headerReplaceAllFields(hdr http.Header, replacements []HeaderReplacementSpec) {
+	if r.headerOp == nil || hdr == nil {
+		return
+	}
+	for _, repl := range replacements {
+		search := r.ReplaceKnown(repl.Search, "")
+		replace := r.ReplaceKnown(repl.Replace, "")
+		for fieldName, vals := range hdr {
+			for i := range vals {
+				if repl.Pattern != nil {
+					hdr[fieldName][i] = repl.Pattern.ReplaceAllString(hdr[fieldName][i], replace)
+				} else {
+					hdr[fieldName][i] = strings.ReplaceAll(hdr[fieldName][i], search, replace)
+				}
+			}
+		}
+	}
+}
+
+func (r *Replacer) headerReplaceNamedField(hdr http.Header, fieldName string, replacements []HeaderReplacementSpec) {
+	if r.headerOp == nil || hdr == nil {
+		return
+	}
+	for _, repl := range replacements {
+		search := r.ReplaceKnown(repl.Search, "")
+		replace := r.ReplaceKnown(repl.Replace, "")
+		for hdrFieldName, vals := range hdr {
+			if http.CanonicalHeaderKey(hdrFieldName) != fieldName {
+				continue
+			}
+			for i := range vals {
+				if repl.Pattern != nil {
+					hdr[hdrFieldName][i] = repl.Pattern.ReplaceAllString(hdr[hdrFieldName][i], replace)
+				} else {
+					hdr[hdrFieldName][i] = strings.ReplaceAll(hdr[hdrFieldName][i], search, replace)
+				}
+			}
+		}
+	}
+}
+
+// ApplyHeaderMutationToRequest applies header operations including Host.
+func (r *Replacer) ApplyHeaderMutationToRequest(req *http.Request, spec HeaderMutationSpec) {
+	if r == nil || req == nil {
+		return
+	}
+	r.PrepareHeaderMutation(spec)
+	origHost, hadHost := req.Header["Host"]
+	req.Header["Host"] = append(req.Header["Host"], req.Host)
+	r.ApplyPreparedHeaderMutation(req.Header)
+	if len(req.Header["Host"]) > 0 {
+		req.Host = req.Header["Host"][len(req.Header["Host"])-1]
+	} else {
+		req.Host = ""
+	}
+	if hadHost {
+		req.Header["Host"] = origHost
+	} else {
+		delete(req.Header, "Host")
+	}
+}
+
+
+// DecodeURIDirective interprets Caddyfile `uri` arguments.
+func (r *Replacer) DecodeURIDirective(args []string) (URIDirectiveResult, error) {
+	if r == nil {
+		return URIDirectiveResult{}, fmt.Errorf("missing replacer")
+	}
+	r.uriDirOp = &uriDirectiveOp{args: append([]string(nil), args...)}
+	if len(args) < 2 {
+		return URIDirectiveResult{}, fmt.Errorf("wrong argument count")
+	}
+	kind := args[0]
+	r.uriDirSetKind(kind)
+	switch r.uriDirKind() {
+	case "strip_prefix":
+		return r.uriDirStripPrefix(args)
+	case "strip_suffix":
+		return r.uriDirStripSuffix(args)
+	case "replace":
+		return r.uriDirReplace(args)
+	case "path_regexp":
+		return r.uriDirPathRegexp(args)
+	default:
+		return URIDirectiveResult{}, fmt.Errorf("unrecognized URI manipulation '%s'", kind)
+	}
+}
+
+func (r *Replacer) uriDirStripPrefix(args []string) (URIDirectiveResult, error) {
+	if r.uriDirOp == nil {
+		return URIDirectiveResult{}, fmt.Errorf("missing directive state")
+	}
+	if len(args) > 2 {
+		return URIDirectiveResult{}, fmt.Errorf("wrong argument count")
+	}
+	prefix := args[1]
+	prefix = r.ensureSlashPrefix(prefix)
+	return URIDirectiveResult{Kind: "strip_prefix", StripPrefix: prefix}, nil
+}
+
+func (r *Replacer) uriDirStripSuffix(args []string) (URIDirectiveResult, error) {
+	if r.uriDirOp == nil {
+		return URIDirectiveResult{}, fmt.Errorf("missing directive state")
+	}
+	if len(args) > 2 {
+		return URIDirectiveResult{}, fmt.Errorf("wrong argument count")
+	}
+	return URIDirectiveResult{Kind: "strip_suffix", StripSuffix: args[1]}, nil
+}
+
+func (r *Replacer) uriDirReplace(args []string) (URIDirectiveResult, error) {
+	if r.uriDirOp == nil {
+		return URIDirectiveResult{}, fmt.Errorf("missing directive state")
+	}
+	var find, replace, lim string
+	switch len(args) {
+	case 4:
+		lim = args[3]
+		fallthrough
+	case 3:
+		find = args[1]
+		replace = args[2]
+	default:
+		return URIDirectiveResult{}, fmt.Errorf("wrong argument count")
+	}
+	var limInt int
+	if lim != "" {
+		n, err := strconv.Atoi(lim)
+		if err != nil {
+			return URIDirectiveResult{}, fmt.Errorf("limit must be an integer; invalid: %v", err)
+		}
+		limInt = n
+	}
+	return URIDirectiveResult{Kind: "replace", Find: find, Replace: replace, Limit: limInt}, nil
+}
+
+func (r *Replacer) uriDirPathRegexp(args []string) (URIDirectiveResult, error) {
+	if r.uriDirOp == nil {
+		return URIDirectiveResult{}, fmt.Errorf("missing directive state")
+	}
+	if len(args) != 3 {
+		return URIDirectiveResult{}, fmt.Errorf("wrong argument count")
+	}
+	return URIDirectiveResult{Kind: "path_regexp", Find: args[1], Replace: args[2]}, nil
+}
+
+
+// PrepareRequestMatch stores request matching inputs on the replacer.
+func (r *Replacer) PrepareRequestMatch(req *http.Request) {
+	if r == nil || req == nil {
+		return
+	}
+	pathVal := ""
+	raw := ""
+	query := ""
+	if req.URL != nil {
+		pathVal = req.URL.Path
+		raw = req.URL.RawQuery
+		query = req.URL.RawQuery
+	}
+	r.matchOp = &requestMatchOp{
+		host:   req.Host,
+		path:   pathVal,
+		raw:    raw,
+		query:  query,
+		header: req.Header,
+	}
+}
+
+// MatchRequestHost evaluates host matcher patterns against the bound request host.
+func (r *Replacer) MatchRequestHost(patterns []string, large bool) bool {
+	if r.matchOp == nil {
+		return false
+	}
+	reqHost := r.matchHostName()
+	if large {
+		pos := sort.Search(len(patterns), func(i int) bool {
+			if r.containsFuzzyHost(patterns[i]) {
+				return false
+			}
+			return patterns[i] >= reqHost
+		})
+		if pos < len(patterns) && patterns[pos] == reqHost {
+			return true
+		}
+	}
+outer:
+	for _, host := range patterns {
+		if large && !r.containsFuzzyHost(host) {
+			break
+		}
+		host = r.ReplaceAll(host, "")
+		if r.containsStarChar(host) {
+			patternParts := strings.Split(host, ".")
+			incomingParts := strings.Split(reqHost, ".")
+			if len(patternParts) != len(incomingParts) {
+				continue
+			}
+			for i := range patternParts {
+				if patternParts[i] == "*" {
+					continue
+				}
+				if !strings.EqualFold(patternParts[i], incomingParts[i]) {
+					continue outer
+				}
+			}
+			return true
+		} else if strings.EqualFold(reqHost, host) {
+			return true
+		}
+	}
+	return false
+}
+
+
+// MatchRequestPath evaluates path matcher patterns against the bound request.
+func (r *Replacer) MatchRequestPath(patterns []string, escapedPath string, windows bool) bool {
+	if r.matchOp == nil {
+		return false
+	}
+	reqPath := r.lowerASCIIString(r.matchPathValue())
+	if windows {
+		reqPath = strings.TrimRight(reqPath, ". ")
+	}
+	for _, matchPattern := range patterns {
+		matchPattern = r.ReplaceAll(matchPattern, "")
+		if r.isCatchAllPattern(matchPattern) {
+			return true
+		}
+		mergeSlashes := !r.containsDoubleSlash(matchPattern)
+		if r.containsPercentSign(matchPattern) {
+			reqPathForPattern := r.cleanRewritePath(escapedPath, mergeSlashes)
+			if r.matchPathEscapeSequence(reqPathForPattern, matchPattern) {
+				return true
+			}
+			continue
+		}
+		reqPathForPattern := r.cleanRewritePath(reqPath, mergeSlashes)
+		if r.isSubstringGlob(matchPattern) {
+			if strings.Contains(reqPathForPattern, matchPattern[1:len(matchPattern)-1]) {
+				return true
+			}
+			continue
+		}
+		if r.countStarChars(matchPattern) == 1 {
+			if r.isSuffixGlob(matchPattern) {
+				if strings.HasSuffix(reqPathForPattern, matchPattern[1:]) {
+					return true
+				}
+				continue
+			}
+			if r.isPrefixGlob(matchPattern) {
+				if strings.HasPrefix(reqPathForPattern, matchPattern[:len(matchPattern)-1]) {
+					return true
+				}
+				continue
+			}
+		}
+		matches, _ := path.Match(matchPattern, reqPathForPattern)
+		if matches {
+			return true
+		}
+	}
+	return false
+}
+
+func (r *Replacer) matchPathEscapeSequence(escapedPath, matchPath string) bool {
+	var sb strings.Builder
+	var iPattern, iPath int
+	for {
+		if iPattern >= len(matchPath) || iPath >= len(escapedPath) {
+			break
+		}
+		pathCh := string(escapedPath[iPath])
+		var escapedPathCh string
+		if pathCh == "%" && len(escapedPath) >= iPath+3 {
+			escapedPathCh = strings.ToLower(escapedPath[iPath : iPath+3])
+			var err error
+			pathCh, err = url.PathUnescape(escapedPathCh)
+			if err != nil {
+				return false
+			}
+			iPath += 2
+		}
+		normalize := true
+		switch matchPath[iPattern] {
+		case '%':
+			if len(matchPath) >= iPattern+3 && matchPath[iPattern+1] != '*' {
+				sb.WriteString(escapedPathCh)
+				iPath++
+				iPattern += 2
+				break
+			}
+			iPattern++
+			normalize = false
+			fallthrough
+		case '*':
+			remaining := escapedPath[iPath:]
+			until := len(escapedPath) - iPath
+			if iPattern < len(matchPath)-1 {
+				nextCh := matchPath[iPattern+1]
+				until = strings.IndexByte(remaining, nextCh)
+				if until == -1 {
+					return false
+				}
+			}
+			if until == 0 {
+				break
+			}
+			next := remaining[:until]
+			if normalize {
+				var err error
+				next, err = url.PathUnescape(next)
+				if err != nil {
+					return false
+				}
+			}
+			sb.WriteString(next)
+			iPath += until
+		default:
+			sb.WriteString(pathCh)
+			iPath++
+		}
+		iPattern++
+	}
+	matchPath = strings.ReplaceAll(matchPath, "%*", "*")
+	matches, _ := path.Match(matchPath, sb.String())
+	return matches
+}
+
+// MatchRequestQuery evaluates query matcher values against the bound request.
+func (r *Replacer) MatchRequestQuery(against url.Values) bool {
+	if r.matchOp == nil {
+		return false
+	}
+	parsed, err := url.ParseQuery(r.matchQueryRaw())
+	if err != nil {
+		return false
+	}
+	for param, vals := range against {
+		param = r.ReplaceAll(param, "")
+		paramVal, found := parsed[param]
+		if found {
+			for _, v := range vals {
+				v = r.ReplaceAll(v, "")
+				if len(paramVal) > 0 && (paramVal[0] == v || v == "*") {
+					return true
+				}
+			}
+		}
+	}
+	return len(against) == 0 && r.matchOp.query == ""
+}
+
+// MatchRequestHeaders evaluates header matcher values.
+func (r *Replacer) MatchRequestHeaders(input, against http.Header, host string) bool {
+	if r.matchOp == nil && input == nil {
+		return false
+	}
+	if input == nil {
+		input = r.matchHeaderMap()
+	}
+	for field, allowedFieldVals := range against {
+		actualFieldVals := r.headerFieldVals(input, field, host)
+		if allowedFieldVals != nil && len(allowedFieldVals) == 0 && actualFieldVals != nil {
+			continue
+		}
+		if allowedFieldVals == nil && actualFieldVals == nil {
+			continue
+		}
+		var match bool
+	fieldVals:
+		for _, actualFieldVal := range actualFieldVals {
+			for _, allowedFieldVal := range allowedFieldVals {
+				allowedFieldVal = r.ReplaceAll(allowedFieldVal, "")
+				switch {
+				case allowedFieldVal == "*":
+					match = true
+				case strings.HasPrefix(allowedFieldVal, "*") && strings.HasSuffix(allowedFieldVal, "*"):
+					match = strings.Contains(actualFieldVal, allowedFieldVal[1:len(allowedFieldVal)-1])
+				case strings.HasPrefix(allowedFieldVal, "*"):
+					match = strings.HasSuffix(actualFieldVal, allowedFieldVal[1:])
+				case strings.HasSuffix(allowedFieldVal, "*"):
+					match = strings.HasPrefix(actualFieldVal, allowedFieldVal[:len(allowedFieldVal)-1])
+				default:
+					match = actualFieldVal == allowedFieldVal
+				}
+				if match {
+					break fieldVals
+				}
+			}
+		}
+		if !match {
+			return false
+		}
+	}
+	return true
+}
