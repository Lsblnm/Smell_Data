+func (r *Replacer) sha256HexBytes(data []byte) string {
+	sum := sha256.Sum256(data)
+	const hexdigits = "0123456789abcdef"
+	out := make([]byte, 64)
+	for i := 0; i < len(sum); i++ {
+		out[i*2] = hexdigits[sum[i]>>4]
+		out[i*2+1] = hexdigits[sum[i]&0x0f]
+	}
+	return string(out)
+}
