+func (r *Replacer) splitRewriteURI(uri string) (pathPart, query, frag string, pathStart, qsStart, fragStart int) {
+	pathStart, qsStart, fragStart = -1, -1, -1
+	pathEnd, qsEnd := -1, -1
+loop:
+	for i, ch := range uri {
+		switch {
+		case ch == '?' && qsStart < 0:
+			pathEnd, qsStart = i, i+1
+		case ch == '#' && fragStart < 0:
+			if qsStart < 0 {
+				pathEnd = i
+			} else {
+				qsEnd = i
+			}
+			fragStart = i + 1
+			break loop
+		case pathStart < 0 && qsStart < 0:
+			pathStart = i
+		}
+	}
+	if pathStart >= 0 && pathEnd < 0 {
+		pathEnd = len(uri)
+	}
+	if qsStart >= 0 && qsEnd < 0 {
+		qsEnd = len(uri)
+	}
+	if pathStart > -1 {
+		pathPart = uri[pathStart:pathEnd]
+	}
+	if qsStart > -1 {
+		query = uri[qsStart:qsEnd]
+	}
+	if fragStart > -1 {
+		frag = uri[fragStart:]
+	}
+	return pathPart, query, frag, pathStart, qsStart, fragStart
+}
+
+func (r *Replacer) buildRewriteQuery(qs string) string {
+	var sb strings.Builder
+	wroteVal := true
+	for len(qs) > 0 {
+		nextEq, nextAmp := strings.Index(qs, "="), strings.Index(qs, "&")
+		ampIsNext := nextAmp >= 0 && (nextAmp < nextEq || nextEq < 0)
+		end := len(qs)
+		if ampIsNext {
+			end = nextAmp
+		} else if nextEq >= 0 && (nextEq < nextAmp || nextAmp < 0) {
+			end = nextEq
+		}
+		comp := qs[:end]
+		comp, _ = r.ReplaceFunc(comp, func(name string, val any) (any, error) {
+			if name == "http.request.uri.query" && wroteVal {
+				return val, nil
+			}
+			var valStr string
+			switch v := val.(type) {
+			case string:
+				valStr = v
+			case fmt.Stringer:
+				valStr = v.String()
+			case int:
+				valStr = strconv.Itoa(v)
+			default:
+				valStr = fmt.Sprintf("%+v", v)
+			}
+			return r.encodeQueryComponent(valStr), nil
+		})
+		if end < len(qs) {
+			end++
+		}
+		qs = qs[end:]
+		if wroteVal {
+			if sb.Len() > 0 && len(comp) > 0 {
+				sb.WriteRune('&')
+			}
+		} else {
+			sb.WriteRune('=')
+		}
+		sb.WriteString(comp)
+		wroteVal = ampIsNext
+	}
+	return sb.String()
+}
+
+func (r *Replacer) cleanRewritePath(p string, collapseSlashes bool) string {
+	if collapseSlashes {
+		return r.cleanPathKeepSlash(p)
+	}
+	const tmpCh = 0xff
+	var sb strings.Builder
+	for i, ch := range p {
+		if ch == '/' && i > 0 && p[i-1] == '/' {
+			sb.WriteByte(tmpCh)
+		}
+		sb.WriteRune(ch)
+	}
+	halfCleaned := r.cleanPathKeepSlash(sb.String())
+	halfCleaned = strings.ReplaceAll(halfCleaned, string([]byte{tmpCh}), "")
+	return halfCleaned
+}
+
+func (r *Replacer) cleanPathKeepSlash(p string) string {
+	cleaned := path.Clean(p)
+	if cleaned != "/" && strings.HasSuffix(p, "/") {
+		cleaned = cleaned + "/"
+	}
+	return cleaned
+}
+
+func (r *Replacer) trimEscapedPathPrefix(escapedPath, prefix string) string {
+	var iPath, iPrefix int
+	for {
+		if iPath >= len(escapedPath) || iPrefix >= len(prefix) {
+			break
+		}
+		prefixCh := prefix[iPrefix]
+		ch := string(escapedPath[iPath])
+		if ch == "%" && prefixCh != '%' && len(escapedPath) >= iPath+3 {
+			decoded, ok := r.decodePercentTriplet(escapedPath[iPath : iPath+3])
+			if !ok {
+				return escapedPath
+			}
+			ch = string(decoded)
+			iPath += 2
+		}
+		if !strings.EqualFold(ch, string(prefixCh)) {
+			return escapedPath
+		}
+		iPath++
+		iPrefix++
+	}
+	if iPath >= len(prefix) {
+		return escapedPath[iPath:]
+	}
+	return escapedPath
+}
+
+func (r *Replacer) reverseRunes(s string) string {
+	rr := []rune(s)
+	for i, j := 0, len(rr)-1; i < j; i, j = i+1, j-1 {
+		rr[i], rr[j] = rr[j], rr[i]
+	}
+	return string(rr)
+}
