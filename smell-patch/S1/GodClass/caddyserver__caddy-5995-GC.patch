+
+func (r *Replacer) pathPartAt(parts []string, idx int) (string, bool) {
+	if !r.validNonNegativeIndex(idx) {
+		return "", false
+	}
+	if idx >= len(parts) {
+		return "", true
+	}
+	return parts[idx], true
+}
