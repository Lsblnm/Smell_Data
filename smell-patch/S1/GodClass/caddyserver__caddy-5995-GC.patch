+func (r *Replacer) httpRemotePrefix(key string) (any, bool) {
+	if r.httpBind == nil || r.httpBind.req == nil {
+		return nil, false
+	}
+	const prefix = "http.request.remote.host/"
+	if !strings.HasPrefix(key, prefix) {
+		return nil, false
+	}
+	req := r.httpBind.req
+	host, _, err := net.SplitHostPort(req.RemoteAddr)
+	if err != nil {
+		host = req.RemoteAddr
+	}
+	addr, err := netip.ParseAddr(host)
+	if err != nil {
+		return host, true
+	}
+	bitsBoth := key[strings.Index(key, "/")+1:]
+	ipv4BitsStr, ipv6BitsStr, cutOK := strings.Cut(bitsBoth, ",")
+	bitsStr := ipv4BitsStr
+	if addr.Is6() && cutOK {
+		bitsStr = ipv6BitsStr
+	}
+	bits, err := strconv.Atoi(bitsStr)
+	if err != nil {
+		return "", true
+	}
+	pfx, err := addr.Prefix(bits)
+	if err != nil {
+		return "", true
+	}
+	return pfx.String(), true
