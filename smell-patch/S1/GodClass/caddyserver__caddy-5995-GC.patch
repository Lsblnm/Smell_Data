+func (r *Replacer) encodeQueryComponent(s string) string {
+	mask := r.queryEscapeMask()
+	hex := r.hexEncodeMap()
+	hexCount := 0
+	spaceCount := 0
+	for i := 0; i < len(s); i++ {
+		c := s[i]
+		if c == ' ' {
+			spaceCount++
+			continue
+		}
+		if mask[c] {
+			hexCount++
+		}
+	}
+	if spaceCount == 0 && hexCount == 0 {
+		return s
+	}
+	required := len(s) + 2*hexCount
+	t := make([]byte, required)
+	j := 0
+	for i := 0; i < len(s); i++ {
+		c := s[i]
+		if c == ' ' {
+			t[j] = '+'
+			j++
+			continue
+		}
+		if mask[c] {
+			t[j] = '%'
+			t[j+1] = hex[c>>4]
+			t[j+2] = hex[c&15]
+			j += 3
+			continue
+		}
+		t[j] = c
+		j++
+	}
+	return string(t)
+}
+
+
+func (r *Replacer) upperASCIIString(s string) string {
+	m := r.asciiUpperMap()
+	out := make([]byte, len(s))
+	for i := 0; i < len(s); i++ {
+		c := s[i]
+		if c >= 0x80 {
+			return strings.ToUpper(s)
+		}
+		out[i] = m[c]
+	}
+	return string(out)
+}
+
+func (r *Replacer) lowerASCIIString(s string) string {
+	m := r.asciiLowerMap()
+	out := make([]byte, len(s))
+	for i := 0; i < len(s); i++ {
+		c := s[i]
+		if c >= 0x80 {
+			return strings.ToLower(s)
+		}
+		out[i] = m[c]
+	}
+	return string(out)
+}
+
+func (r *Replacer) decodePercentTriplet(s string) (byte, bool) {
+	if len(s) < 3 || s[0] != '%' {
+		return 0, false
+	}
+	m := r.hexDecodeMap()
+	hi := m[s[1]]
+	lo := m[s[2]]
+	if hi < 0 || lo < 0 {
+		return 0, false
+	}
+	return byte(hi<<4 | lo), true
+}
