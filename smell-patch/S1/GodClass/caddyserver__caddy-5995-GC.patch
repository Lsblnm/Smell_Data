+func (r *Replacer) containsDoubleSlash(s string) bool {
+	n := len(s)
+	if n < 2 {
+		return false
+	}
+	i := 1
+	for i < n {
+		prev := s[i-1]
+		cur := s[i]
+		if prev == '/' {
+			if cur == '/' {
+				return true
+			}
+		}
+		i++
+	}
+	return false
+}
+
+
+func (r *Replacer) containsPercentSign(s string) bool {
+	n := len(s)
+	i := 0
+	for i < n {
+		if s[i] == '%' {
+			return true
+		}
+		i++
+	}
+	return false
+}
+
+
+func (r *Replacer) containsStarChar(s string) bool {
+	n := len(s)
+	i := 0
+	for i < n {
+		if s[i] == '*' {
+			return true
+		}
+		i++
+	}
+	return false
+}
+
+
+func (r *Replacer) containsFuzzyHost(s string) bool {
+	n := len(s)
+	i := 0
+	for i < n {
+		c := s[i]
+		if c == '{' {
+			return true
+		}
+		if c == '*' {
+			return true
+		}
+		i++
+	}
+	return false
+}
+
+
+func (r *Replacer) countStarChars(s string) int {
+	n := len(s)
+	total := 0
+	i := 0
+	for i < n {
+		if s[i] == '*' {
+			total++
+		}
+		i++
+	}
+	return total
+}
+
+
+func (r *Replacer) isCatchAllPattern(s string) bool {
+	if len(s) != 1 {
+		return false
+	}
+	return s[0] == '*'
+}
+
+
+func (r *Replacer) isSubstringGlob(s string) bool {
+	if len(s) < 2 {
+		return false
+	}
+	if s[0] != '*' {
+		return false
+	}
+	if s[len(s)-1] != '*' {
+		return false
+	}
+	return r.countStarChars(s) == 2
+}
+
+
+func (r *Replacer) isPrefixGlob(s string) bool {
+	if len(s) == 0 {
+		return false
+	}
+	if s[len(s)-1] != '*' {
+		return false
+	}
+	return r.countStarChars(s) == 1
+}
+
+
+func (r *Replacer) isSuffixGlob(s string) bool {
+	if len(s) == 0 {
+		return false
+	}
+	if s[0] != '*' {
+		return false
+	}
+	return r.countStarChars(s) == 1
+}
+
+
+func (r *Replacer) ensureSlashPrefix(s string) string {
+	if s == "" {
+		return "/"
+	}
+	if s[0] == '/' {
+		return s
+	}
+	var b strings.Builder
+	b.Grow(len(s) + 1)
+	b.WriteByte('/')
+	b.WriteString(s)
+	return b.String()
+}
