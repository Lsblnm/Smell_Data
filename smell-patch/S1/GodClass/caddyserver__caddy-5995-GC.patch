+func (r *Replacer) httpTLSClientFields(req *http.Request, field string) (any, bool) {
+	if r.httpBind == nil {
+		return nil, false
+	}
+	if req == nil || req.TLS == nil {
+		return nil, false
+	}
+	cert := r.tlsPeerCert(req.TLS)
+	if cert == nil {
+		return nil, false
+	}
+	if strings.HasPrefix(field, "client.san.") {
+		return r.httpTLSClientSAN(cert, field[len("client.san."):])
+	}
+	switch field {
+	case "client.fingerprint":
+		return r.boundFingerprint(cert), true
+	case "client.public_key", "client.public_key_sha256":
+		if cert.PublicKey == nil {
+			return nil, true
+		}
+		pubKeyBytes, err := r.marshalTLSPublicKey(cert.PublicKey)
+		if err != nil {
+			return nil, true
+		}
+		if strings.HasSuffix(field, "_sha256") {
+			return fmt.Sprintf("%x", sha256.Sum256(pubKeyBytes)), true
+		}
+		return fmt.Sprintf("%x", pubKeyBytes), true
+	case "client.issuer":
+		return cert.Issuer, true
+	case "client.serial":
+		return cert.SerialNumber, true
+	case "client.subject":
+		return cert.Subject, true
+	case "client.certificate_pem":
+		return r.boundCertPEM(cert), true
+	case "client.certificate_der_base64":
+		return base64.StdEncoding.EncodeToString(cert.Raw), true
+	default:
+		return nil, false
+	}
