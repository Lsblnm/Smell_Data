+
+func (r *Replacer) isStarName(s string) bool {
+	if len(s) != 1 {
+		return false
+	}
+	return s[0] == '*'
+}
+
+
+func (r *Replacer) stripIPv6Brackets(host string) string {
+	n := len(host)
+	if n < 2 {
+		return host
+	}
+	if host[0] != '[' {
+		return host
+	}
+	if host[n-1] != ']' {
+		return host
+	}
+	return host[1 : n-1]
+}
