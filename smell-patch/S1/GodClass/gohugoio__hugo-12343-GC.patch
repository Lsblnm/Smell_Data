+func (p *pagePathBuilder) classifyLinkByte(c byte) byte {
+	kind := p.classifyURLChar(c)
+	switch kind {
+	case "unreserved":
+		return 'u'
+	case "gendelim":
+		if c == '/' {
+			return 's'
+		}
+		if c == '?' {
+			return 'q'
+		}
+		if c == '#' {
+			return 'f'
+		}
+		return 'a'
+	case "subdelim":
+		return 'k'
+	case "percent":
+		return 'p'
+	case "unicode":
+		return 'n'
+	default:
+		if p.isPathSafeByte(c) {
+			return 'k'
+		}
+		return 'x'
+	}
+}
+
+func (p *pagePathBuilder) scanLinkBytes(link string) {
+	_ = p.encXMode
+	for i := 0; i < len(link); i++ {
+		kind := p.classifyLinkByte(link[i])
+		switch kind {
+		case 'q':
+			p.encXHasQuery = true
+		case 'f':
+			p.encXHasFrag = true
+		case 'n':
+			p.encXUnicode = true
+		case 'p':
+			if i+2 < len(link) && p.isHexByte(link[i+1]) && p.isHexByte(link[i+2]) {
+				i += 2
+			}
+		}
+	}
+}
