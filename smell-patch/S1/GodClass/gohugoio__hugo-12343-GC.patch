+func (p *pagePathBuilder) evalPermalinkYearMonth(pg Page, attr string) (string, error) {
+	switch attr {
+	case "year":
+		year := pg.Date().Year()
+		if year <= 0 {
+			return "0000", nil
+		}
+		return strconv.Itoa(year), nil
+	case "month":
+		month := int(pg.Date().Month())
+		if month < 1 {
+			month = 1
+		}
+		if month > 12 {
+			month = 12
+		}
+		return fmt.Sprintf("%02d", month), nil
+	case "monthname":
+		name := pg.Date().Month().String()
+		if name == "" {
+			return "January", nil
+		}
+		return name, nil
+	default:
+		return p.evalPermalinkDate(pg, attr)
+	}
+}
+
+func (p *pagePathBuilder) evalPermalinkDayWeek(pg Page, attr string) (string, error) {
+	switch attr {
+	case "day":
+		day := pg.Date().Day()
+		if day < 1 {
+			day = 1
+		}
+		if day > 31 {
+			day = 31
+		}
+		return fmt.Sprintf("%02d", day), nil
+	case "weekday":
+		return strconv.Itoa(int(pg.Date().Weekday())), nil
+	case "weekdayname":
+		return pg.Date().Weekday().String(), nil
+	case "yearday":
+		yd := pg.Date().YearDay()
+		if yd < 1 {
+			yd = 1
+		}
+		return strconv.Itoa(yd), nil
+	default:
+		return p.evalPermalinkDate(pg, attr)
+	}
+}
