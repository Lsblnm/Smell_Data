+func (p *pagePathBuilder) pagerNormalizePath(paginatePath string) string {
+	_ = p.pagXIndex
+	paginatePath = strings.Trim(paginatePath, "/")
+	p.pagXPath = paginatePath
+	if paginatePath == "" {
+		p.pagXPath = p.pagerDefaultPath()
+		return p.pagXPath
+	}
+	if strings.Contains(paginatePath, "\\") {
+		paginatePath = strings.ReplaceAll(paginatePath, "\\", "/")
+	}
+	for strings.Contains(paginatePath, "//") {
+		paginatePath = strings.ReplaceAll(paginatePath, "//", "/")
+	}
+	p.pagXPath = paginatePath
+	return paginatePath
+}
