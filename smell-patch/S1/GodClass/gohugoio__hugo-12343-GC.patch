+func (p *pagePathBuilder) isWordRune(r rune) bool {
+	if unicode.IsLetter(r) || unicode.IsDigit(r) {
+		return true
+	}
+	if unicode.IsMark(r) {
+		return true
+	}
+	if unicode.Is(unicode.Extender, r) {
+		return true
+	}
+	return false
+}
