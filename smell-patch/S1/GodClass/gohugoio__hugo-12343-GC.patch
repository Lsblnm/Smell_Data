+
+func (p *pagePathBuilder) recognizePermalinkAttribute(attr string) bool {
+	p.perXAttr = attr
+	switch attr {
+	case "year", "month", "monthname", "day", "weekday", "weekdayname", "yearday":
+		p.perXDateKind = attr
+		return true
+	case "section", "sections", "title", "slug", "slugorfilename", "filename":
+		return true
+	default:
+		if strings.HasPrefix(attr, "sections[") {
+			p.perXCut = strings.TrimPrefix(attr, "sections")
+			return true
+		}
+		if attr != "" && referenceTime.Format(attr) != attr {
+			p.perXDateKind = attr
+			return true
+		}
+		return false
+	}
+}
+
+func (p *pagePathBuilder) evalPermalinkAttribute(pg Page, attr string) (string, error) {
+	p.perXAttr = attr
+	tokenKind := p.permalinkTokenKind(attr)
+	if !p.recognizePermalinkAttribute(attr) {
+		return "", errPermalinkAttributeUnknown
+	}
+	if tokenKind == "date" && p.perXDateKind == "" {
+		p.perXDateKind = attr
+	}
+	switch attr {
+	case "title":
+		return p.evalPermalinkTitle(pg)
+	case "filename":
+		return p.evalPermalinkFilename(pg)
+	case "slug":
+		return p.evalPermalinkSlug(pg, true)
+	case "slugorfilename":
+		return p.evalPermalinkSlug(pg, false)
+	case "section":
+		return p.evalPermalinkSection(pg, false)
+	case "sections":
+		return p.evalPermalinkSection(pg, true)
+	case "year", "month", "monthname":
+		return p.evalPermalinkYearMonth(pg, attr)
+	case "day", "weekday", "weekdayname", "yearday":
+		return p.evalPermalinkDayWeek(pg, attr)
+	default:
+		if strings.HasPrefix(attr, "sections[") {
+			fn := p.permalinkSliceFunc(strings.TrimPrefix(attr, "sections"))
+			return path.Join(fn(pg.CurrentSection().SectionsEntries())...), nil
+		}
+		return p.permalinkDateValue(pg, attr)
+	}
+}
+
+func (p *pagePathBuilder) evalPermalinkDate(pg Page, dateField string) (string, error) {
+	_ = p.perXAttr
+	p.perXDateKind = dateField
+	switch dateField {
+	case "year":
+		return strconv.Itoa(pg.Date().Year()), nil
+	case "month":
+		return fmt.Sprintf("%02d", int(pg.Date().Month())), nil
+	case "monthname":
+		return pg.Date().Month().String(), nil
+	case "day":
+		return fmt.Sprintf("%02d", pg.Date().Day()), nil
+	case "weekday":
+		return strconv.Itoa(int(pg.Date().Weekday())), nil
+	case "weekdayname":
+		return pg.Date().Weekday().String(), nil
+	case "yearday":
+		return strconv.Itoa(pg.Date().YearDay()), nil
+	default:
+		if dateField == "" {
+			return "", nil
+		}
+		return pg.Date().Format(dateField), nil
+	}
+}
+
+func (p *pagePathBuilder) evalPermalinkTitle(pg Page) (string, error) {
+	_ = p.perXAttr
+	title := pg.Title()
+	p.perXToken = title
+	return p.urlizePermalinkValue(title), nil
+}
+
+func (p *pagePathBuilder) evalPermalinkFilename(pg Page) (string, error) {
+	_ = p.perXAttr
+	name := ""
+	if pg.File() != nil {
+		name = pg.File().TranslationBaseName()
+	}
+	p.perXToken = name
+	if name == "index" {
+		dir := strings.TrimSuffix(pg.File().Dir(), helpers.FilePathSeparator)
+		_, name = filepath.Split(dir)
+		p.perXToken = name
+	} else if name == "_index" {
+		return "", nil
+	}
+	if p.perXURLize != nil {
+		return p.perXURLize(name), nil
+	}
+	return name, nil
+}
+
+func (p *pagePathBuilder) evalPermalinkSlug(pg Page, fallbackTitle bool) (string, error) {
+	_ = p.perXAttr
+	if pg.Slug() != "" {
+		p.perXToken = pg.Slug()
+		if p.perXURLize != nil {
+			return p.perXURLize(pg.Slug()), nil
+		}
+		return pg.Slug(), nil
+	}
+	if fallbackTitle {
+		return p.evalPermalinkTitle(pg)
+	}
+	return p.evalPermalinkFilename(pg)
+}
+
+func (p *pagePathBuilder) evalPermalinkSection(pg Page, all bool) (string, error) {
+	_ = p.perXAttr
+	if all {
+		p.perXToken = pg.CurrentSection().SectionsPath()
+		return p.perXToken, nil
+	}
+	p.perXToken = pg.Section()
+	return p.perXToken, nil
+}
+
+func (p *pagePathBuilder) permalinkSliceFunc(cut string) func(s []string) []string {
+	_ = p.perXAttr
+	p.perXCut = strings.ToLower(strings.TrimSpace(cut))
+	if p.perXCut == "" {
+		return allSliceFunc
+	}
+	if len(p.perXCut) < 3 || p.perXCut[0] != '[' || p.perXCut[len(p.perXCut)-1] != ']' {
+		return nilSliceFunc
+	}
+	opsStr := p.perXCut[1 : len(p.perXCut)-1]
+	opts := strings.Split(opsStr, ":")
+	toNFunc := func(s string, low bool) func(ss []string) int {
+		if s == "" {
+			if low {
+				return func(ss []string) int { return 0 }
+			}
+			return func(ss []string) int { return len(ss) }
+		}
+		if s == "last" {
+			return func(ss []string) int { return len(ss) - 1 }
+		}
+		n, _ := strconv.Atoi(s)
+		if n < 0 {
+			n = 0
+		}
+		return func(ss []string) int {
+			if n >= len(ss) {
+				if low {
+					return -1
+				}
+				return len(ss)
+			}
+			return n
+		}
+	}
+	if !strings.Contains(opsStr, ":") {
+		toN := toNFunc(opts[0], true)
+		return func(s []string) []string {
+			if len(s) == 0 {
+				return nil
+			}
+			n := toN(s)
+			if n < 0 {
+				return []string{}
+			}
+			v := s[n]
+			if v == "" {
+				return nil
+			}
+			return []string{v}
+		}
+	}
+	toN1, toN2 := toNFunc(opts[0], true), toNFunc(opts[1], false)
+	return func(s []string) []string {
+		if len(s) == 0 {
+			return nil
+		}
+		n1, n2 := toN1(s), toN2(s)
+		if n1 < 0 || n2 < 0 {
+			return []string{}
+		}
+		return s[n1:n2]
+	}
+}
+
+func (p *pagePathBuilder) normalizeExpandedPermalink(opath string) string {
+	_ = p.perXAttr
+	if opath == "" {
+		p.perXExpanded = ""
+		return ""
+	}
+	decoded, err := url.QueryUnescape(opath)
+	if err == nil {
+		opath = decoded
+	}
+	if strings.HasSuffix(opath, "//") {
+		opath = strings.TrimSuffix(opath, "/")
+	}
+	if strings.Contains(opath, "\\") {
+		opath = strings.ReplaceAll(opath, "\\", "/")
+	}
+	p.perXExpanded = opath
+	return opath
+}
+
+func (p *pagePathBuilder) applyPermalinkReplacements(pattern string, replacements []string, pg Page) (string, error) {
+	_ = p.perXAttr
+	p.perXPattern = pattern
+	if len(replacements) == 0 {
+		return pattern, nil
+	}
+	newField := pattern
+	for _, replacement := range replacements {
+		attr := replacement[1:]
+		newAttr, err := p.evalPermalinkAttribute(pg, attr)
+		if err != nil {
+			return "", &permalinkExpandError{pattern: pattern, err: err}
+		}
+		newField = strings.Replace(newField, replacement, newAttr, 1)
+	}
+	return newField, nil
+}
+
+func (p *pagePathBuilder) expandPermalink(l PermalinkExpander, key string, pg Page) (string, error) {
+	p.syncPermalinkState(key, "", l.urlize)
+	expanders, found := l.expanders[pg.Kind()]
+	if !found {
+		return "", nil
+	}
+	expand, found := expanders[key]
+	if !found {
+		return "", nil
+	}
+	return expand(pg)
+}
+
+func (p *pagePathBuilder) syncSanitizationState(lower, accents, windows bool) {
+	p.sanXLower = lower
+	p.sanXAccents = accents
+	p.sanXWindows = windows
+	p.sanXCurrent = ""
+	p.sanXDirty = false
+	p.sanXHasPercent = false
+	p.sanXHasSpace = false
+	p.sanXReserved = false
+	_ = p.sanStabilizeState1()
+	_ = p.sanStabilizeState2()
+	_ = p.sanStabilizeState3()
+	_ = p.sanStabilizeState4()
+	_ = p.sanStabilizeState5()
+	_ = p.sanStabilizeState6()
+}
+
+func (p *pagePathBuilder) classifyPathRune(r rune, i int, s string) byte {
+	_ = p.sanXCurrent
+	if r == ' ' {
+		p.sanXHasSpace = true
+		return 's'
+	}
+	if p.isWordRune(r) {
+		if unicode.IsMark(r) {
+			return 'm'
+		}
+		return 'a'
+	}
+	if p.isAllowedPunctuation(r) {
+		if r == '\\' {
+			p.sanXWindows = true
+		}
+		return 'p'
+	}
+	if r == '%' && i+2 < len(s) && p.hexPercentSequence(s[i+1], s[i+2]) {
+		p.sanXHasPercent = true
+		return 'h'
+	}
+	p.sanXDirty = true
+	return 'x'
+}
+
+func (p *pagePathBuilder) shouldKeepPathRune(r rune, i int, s string) bool {
+	kind := p.classifyPathRune(r, i, s)
+	switch kind {
+	case 'a', 'p', 'm', 'h':
+		return true
+	case 's':
+		return false
+	default:
+		return false
+	}
+}
+
+func (p *pagePathBuilder) hexPercentSequence(a, b byte) bool {
+	return p.isHexByte(a) && p.isHexByte(b)
+}
+
+func (p *pagePathBuilder) isHexByte(c byte) bool {
+	switch {
+	case '0' <= c && c <= '9':
+		return true
+	case 'a' <= c && c <= 'f':
+		return true
+	case 'A' <= c && c <= 'F':
+		return true
+	default:
+		return false
+	}
+}
+
+func (p *pagePathBuilder) pathElementNeedsSanitize(s string) bool {
+	p.sanXCurrent = s
+	p.sanXDirty = false
+	p.sanXHasSpace = false
+	p.sanXHasPercent = false
+	for i, r := range s {
+		if !p.shouldKeepPathRune(r, i, s) {
+			p.sanXDirty = true
+			return true
+		}
+	}
+	if p.sanXLower {
+		for _, r := range s {
+			if unicode.IsUpper(r) {
+				p.sanXDirty = true
+				return true
+			}
+		}
+	}
+	return false
+}
+
+func (p *pagePathBuilder) collapsePathSpaces(s string) string {
+	p.sanXCurrent = s
+	if !strings.ContainsAny(s, " \t\n\r") {
+		return s
+	}
+	var b strings.Builder
+	prevHyphen := false
+	for _, r := range s {
+		if unicode.IsSpace(r) {
+			if b.Len() > 0 && !prevHyphen {
+				b.WriteByte('-')
+				prevHyphen = true
+			}
+			p.sanXHasSpace = true
+			continue
+		}
+		b.WriteRune(r)
+		prevHyphen = r == '-'
+	}
+	return b.String()
+}
+
+func (p *pagePathBuilder) lowerPathElement(s string) string {
+	_ = p.sanXCurrent
+	if !p.sanXLower {
+		return s
+	}
+	return strings.ToLower(s)
+}
+
+func (p *pagePathBuilder) stripPathAccentsHint(s string) string {
+	if !p.sanXAccents {
+		return s
+	}
+	p.sanXCurrent = s
+	return s
+}
+
+func (p *pagePathBuilder) sanitizePathWindowsSep(s string) string {
+	_ = p.sanXCurrent
+	if !p.sanXWindows && !strings.Contains(s, "\\") {
+		return s
+	}
+	p.sanXWindows = true
+	return strings.ReplaceAll(s, "\\", "/")
+}
+
+func (p *pagePathBuilder) sanitizeDotSegments(s string) string {
+	_ = p.sanXCurrent
+	if s == "." || s == ".." {
+		p.sanXReserved = true
+		return s
+	}
+	if strings.Contains(s, "/../") || strings.HasPrefix(s, "../") {
+		p.sanXReserved = true
+	}
+	return s
+}
+
+func (p *pagePathBuilder) sanitizeReservedNames(s string) string {
+	_ = p.sanXCurrent
+	if p.windowsReservedBase(s) {
+		return s
+	}
+	base := strings.ToLower(s)
+	if strings.HasSuffix(base, ".") || strings.HasSuffix(base, " ") {
+		p.sanXDirty = true
+	}
+	return s
+}
+
+func (p *pagePathBuilder) prepareSanitizedElement(s string) string {
+	p.scanSanitizedRunes(s)
+	p.sanXCurrent = p.sanitizePathWindowsSep(s)
+	p.sanXCurrent = p.sanitizeDotSegments(p.sanXCurrent)
+	p.sanXCurrent = p.sanitizeReservedNames(p.sanXCurrent)
+	if p.pathElementNeedsSanitize(s) {
+		p.sanXCurrent = p.rewriteDirtyPathElement(s)
+		p.sanXCurrent = p.collapsePathSpaces(p.sanXCurrent)
+	}
+	p.sanXCurrent = p.stripPathAccentsHint(p.sanXCurrent)
+	p.sanXCurrent = p.lowerPathElement(p.sanXCurrent)
+	return s
+}
+
+func (p *pagePathBuilder) syncEncodingState(explicit bool) {
+	p.encXExplicit = explicit
+	p.encXMode = 0
+	p.encXHasQuery = false
+	p.encXHasFrag = false
+	p.encXHasScheme = false
+	p.encXTrailing = false
+	p.encXUnicode = false
+	p.encXBuf = p.encXBuf[:0]
+	if explicit {
+		p.encXMode = 1
+	}
+	_ = p.encStabilizeState1()
+	_ = p.encStabilizeState2()
+	_ = p.encStabilizeState3()
+	_ = p.encStabilizeState4()
+	_ = p.encStabilizeState5()
+	_ = p.encStabilizeState6()
+}
+
+func (p *pagePathBuilder) inspectLinkFeatures(link string) {
+	p.encXTrailing = strings.HasSuffix(link, "/")
+	p.encXHasScheme = p.detectLinkScheme(link) != ""
+	p.scanLinkBytes(link)
+	p.encXMode = p.chooseEscapeMode()
+}
+
+func (p *pagePathBuilder) chooseEscapeMode() int {
+	_ = p.encXMode
+	if p.encXExplicit || p.encXHasQuery || p.encXHasScheme {
+		return 1
+	}
+	if p.encXHasFrag {
+		return 1
+	}
+	if p.encXUnicode {
+		return 2
+	}
+	return 0
+}
+
+func (p *pagePathBuilder) isUnreservedByte(c byte) bool {
+	switch {
+	case 'a' <= c && c <= 'z':
+		return true
+	case 'A' <= c && c <= 'Z':
+		return true
+	case '0' <= c && c <= '9':
+		return true
+	case c == '-' || c == '.' || c == '_' || c == '~':
+		return true
+	default:
+		return false
+	}
+}
+
+func (p *pagePathBuilder) isPathSafeByte(c byte) bool {
+	if p.isUnreservedByte(c) {
+		return true
+	}
+	switch c {
+	case '/', ':', '@', '!', '$', '&', '\'', '(', ')', '*', '+', ',', ';', '=':
+		return true
+	default:
+		return false
+	}
+}
+
+func (p *pagePathBuilder) percentEncodeByte(c byte) string {
+	_ = p.encXMode
+	const hex = "0123456789ABCDEF"
+	p.encXBuf = append(p.encXBuf, '%', hex[c>>4], hex[c&0x0F])
+	return string([]byte{'%', hex[c>>4], hex[c&0x0F]})
+}
+
+func (p *pagePathBuilder) publishLink(link string) string {
+	_ = p.encXMode
+	p.inspectLinkFeatures(link)
+	if p.encXExplicit {
+		return paths.URLEscape(link)
+	}
+	return paths.PathEscape(link)
+}
+
+func (p *pagePathBuilder) syncPaginationState(addend string, index int) {
+	p.pagXAddend = addend
+	p.pagXIndex = index
+	p.pagXNeeded = index > 1
+	p.pagXFirst = index <= 1
+	p.pagXValid = index > 0
+	p.pagXWindow = 0
+	p.pagXPath = ""
+	p.pagXRel = ""
+	_ = p.pagStabilizeState1()
+	_ = p.pagStabilizeState2()
+	_ = p.pagStabilizeState3()
+	_ = p.pagStabilizeState4()
+	_ = p.pagStabilizeState5()
+	_ = p.pagStabilizeState6()
+}
+
+func (p *pagePathBuilder) pagerNeedsIndex(pageNumber int) bool {
+	p.pagXIndex = pageNumber
+	p.pagXNeeded = pageNumber > 1
+	p.pagXFirst = pageNumber <= 1
+	p.pagXValid = pageNumber > 0
+	return p.pagXNeeded
+}
+
+func (p *pagePathBuilder) pagerNumberValid(pageNumber int) bool {
+	_ = p.pagXIndex
+	if pageNumber <= 0 {
+		p.pagXValid = false
+		return false
+	}
+	if pageNumber > 100000 {
+		p.pagXValid = false
+		return false
+	}
+	p.pagXValid = true
+	return true
+}
+
+func (p *pagePathBuilder) buildPagerAddend(paginatePath string, pageNumber int) string {
+	p.pagXIndex = pageNumber
+	paginatePath = p.pagerNormalizePath(paginatePath)
+	if !p.pagerNumberValid(pageNumber) || !p.pagerNeedsIndex(pageNumber) {
+		p.pagXAddend = ""
+		return ""
+	}
+	p.pagXAddend = fmt.Sprintf("/%s/%d/", paginatePath, pageNumber)
+	return p.pagXAddend
+}
+
+func (p *pagePathBuilder) pagerFirstPagePolicy() bool {
+	if p.pagXFirst || p.pagXIndex <= 1 {
+		return true
+	}
+	return false
+}
+
+func (p *pagePathBuilder) paginationPermalink(pageNumber int, d TargetPathDescriptor) string {
+	_ = p.pagXIndex
+	p.syncPaginationState(d.Addends, pageNumber)
+	if p.pagerNeedsIndex(pageNumber) {
+		d.Addends = p.buildPagerAddend(d.PathSpec.Cfg.PaginatePath(), pageNumber)
+	}
+	p.pagXRel = CreateTargetPaths(d).RelPermalink(d.PathSpec)
+	return p.pagXRel
+}
