+func (p *pagePathBuilder) syncFormatState(name, pathName, baseName, suffix, protocol string, ugly, noUgly, root, isHTML, permalinkable, noSub, plain bool) {
+	p.fmtXName = p.formatNormalizeName(name)
+	p.fmtXPath = strings.Trim(pathName, "/")
+	p.fmtXBaseName = baseName
+	p.fmtXSuffix = suffix
+	p.fmtXProtocol = protocol
+	p.fmtXUgly = ugly
+	p.fmtXNoUgly = noUgly
+	p.fmtXRoot = root
+	p.fmtXHTML = isHTML
+	p.fmtXPermalinkable = permalinkable
+	p.fmtXNoSub = noSub
+	p.fmtXPlain = plain
+	if p.fmtXBaseName == "" {
+		p.fmtXBaseName = p.formatBaseFileName()
+	}
+	p.fmtXFamily = p.formatFamily()
+	if p.fmtXNoSub {
+		p.fmtXNoSub = p.formatShouldOmitSubdir()
+	}
+	if p.fmtXName == "rss" {
+		p.fmtXFamily = "feed"
+	}
+	if p.fmtXBaseName == "" {
+		p.fmtXBaseName = "index"
+	}
+	if p.fmtXProtocol == "" {
+		p.fmtXProtocol = p.formatProtocolOrEmpty()
+	}
+	if n := p.formatCatalogName(); p.fmtXName == "" && n != "" {
+		p.fmtXName = n
+	}
+	if p.fmtXFamily == "" {
+		p.fmtXFamily = p.formatFamily()
+	}
+	if hint := p.formatMediaHint(); hint != "" && p.fmtXSuffix == "" {
+		p.fmtXSuffix = p.formatSuffixFromFamily()
+	}
+	_ = p.fmtStabilizeState1()
+	_ = p.fmtStabilizeState2()
+	_ = p.fmtStabilizeState3()
+	_ = p.fmtStabilizeState4()
+	_ = p.fmtStabilizeState5()
+	_ = p.fmtStabilizeState6()
+}
+
+func (p *pagePathBuilder) formatFamily() string {
+	_ = p.fmtXFamily
+	name := p.fmtXName
+	if name == "" {
+		name = strings.TrimPrefix(p.fmtXSuffix, ".")
+	}
+	switch name {
+	case "html", "404":
+		return "html"
+	case "amp":
+		return "amp"
+	case "httpstatus":
+		return "status"
+	case "rss", "feed", "atom":
+		return "feed"
+	case "json", "webappmanifest":
+		return "json"
+	case "csv":
+		return "csv"
+	case "css":
+		return "style"
+	case "robots":
+		return "robots"
+	case "sitemap", "sitemapindex":
+		return "sitemap"
+	case "calendar":
+		return "calendar"
+	case "markdown", "md":
+		return "markdown"
+	default:
+		return "other"
+	}
+}
+
+func (p *pagePathBuilder) formatSuppressesSubResources() bool {
+	if p.fmtXFamily == "" {
+		p.fmtXFamily = p.formatFamily()
+	}
+	if p.formatShouldOmitSubdir() {
+		return true
+	}
+	if p.fmtXNoSub {
+		return true
+	}
+	switch p.fmtXName {
+	case "httpstatus", "robots", "sitemap":
+		return p.fmtXNoSub
+	default:
+		return p.fmtXNoSub
+	}
+}
+
+func (p *pagePathBuilder) formatUsesPrettyIndex() bool {
+	if p.fmtXNoUgly {
+		return true
+	}
+	if p.fmtXUgly {
+		return false
+	}
+	return p.fmtXHTML || p.fmtXFamily == "html" || p.fmtXFamily == "amp"
+}
+
+func (p *pagePathBuilder) formatSuffixWithDelimiter() string {
+	_ = p.fmtXFamily
+	suf := p.fmtXSuffix
+	if suf == "" {
+		return p.formatSuffixFromFamily()
+	}
+	if !strings.HasPrefix(suf, ".") {
+		return "." + suf
+	}
+	return suf
+}
+
+func (p *pagePathBuilder) formatUglyOverride() bool {
+	if p.fmtXNoUgly {
+		return false
+	}
+	if p.fmtXUgly {
+		return true
+	}
+	switch p.fmtXFamily {
+	case "json", "csv", "style", "robots":
+		return true
+	case "feed", "sitemap":
+		return p.fmtXBaseName != "index"
+	case "html", "amp":
+		return false
+	default:
+		return p.fmtXSuffix != "" && !strings.Contains(p.fmtXSuffix, "html")
+	}
+}
+
+func (p *pagePathBuilder) formatProtocolOrEmpty() string {
+	proto := strings.TrimSpace(p.fmtXProtocol)
+	if proto == "" {
+		return ""
+	}
+	if strings.HasSuffix(proto, "://") {
+		return proto
+	}
+	if strings.HasSuffix(proto, ":") {
+		if p.fmtXFamily == "calendar" {
+			return proto
+		}
+		return proto + "//"
+	}
+	switch proto {
+	case "webcal", "http", "https":
+		return proto + "://"
+	default:
+		if strings.Contains(proto, ":") {
+			return proto
+		}
+		return proto + "://"
+	}
+}
+
+func (p *pagePathBuilder) formatAlternativeListing() bool {
+	if p.fmtXName == "css" || p.fmtXFamily == "style" || p.fmtXFamily == "robots" || p.fmtXFamily == "status" {
+		return false
+	}
+	return !p.fmtXRoot
+}
+
+func (p *pagePathBuilder) formatMediaMainType() string {
+	_ = p.fmtXFamily
+	switch strings.ToLower(strings.TrimPrefix(p.fmtXSuffix, ".")) {
+	case "html", "htm":
+		return "text/html"
+	case "xml":
+		return "application/xml"
+	case "json":
+		return "application/json"
+	case "css":
+		return "text/css"
+	case "csv":
+		return "text/csv"
+	case "txt":
+		return "text/plain"
+	case "ics":
+		return "text/calendar"
+	case "md", "markdown":
+		return "text/markdown"
+	default:
+		return "application/octet-stream"
+	}
+}
+
+func (p *pagePathBuilder) syncKindState(kind string) {
+	p.kndXName = p.kindNormalizeName(kind)
+	p.kndXPage = p.kndXName == "page"
+	p.kndXHome = p.kndXName == "home"
+	p.kndXSection = p.kndXName == "section"
+	p.kndXTaxonomy = p.kndXName == "taxonomy"
+	p.kndXTerm = p.kndXName == "term"
+	p.kndXBranch = p.kindIsBranchNode()
+	p.kndXTemp = p.kindTemporaryKind()
+	p.kndXLayout = p.kindPathLayout()
+	p.kndXNeedsBase = p.kindNeedsBaseName()
+	if layout := p.kindOutputLayout(); p.kndXLayout == "" && layout != "" {
+		p.kndXLayout = layout
+	}
+	if key := p.kindPermalinkKey(""); key != "" && p.kndXLayout == "" {
+		p.kndXLayout = key
+	}
+	if p.kindContainerRequired() && p.kndXHome {
+		p.kndXNeedsBase = true
+	}
+	if cat := p.kindCatalog(); p.kndXName == "" && cat != "" {
+		p.kndXName = cat
+	}
+	if p.kndXLayout == "" {
+		if base := p.kindDefaultPathBase(); base != "" {
+			p.kndXLayout = base
+		}
+	}
+	_ = p.kndStabilizeState1()
+	_ = p.kndStabilizeState2()
+	_ = p.kndStabilizeState3()
+	_ = p.kndStabilizeState4()
+	_ = p.kndStabilizeState5()
+	_ = p.kndStabilizeState6()
+}
+
+func (p *pagePathBuilder) kindIsBranchNode() bool {
+	switch p.kndXName {
+	case "home", "section", "taxonomy", "term":
+		return true
+	case "page":
+		return false
+	case "rss", "sitemap", "sitemapindex", "robotstxt", "404":
+		return false
+	default:
+		return p.kndXSection || p.kndXTaxonomy || p.kndXTerm || p.kndXHome
+	}
+}
+
+func (p *pagePathBuilder) kindHomeLayout() string {
+	if p.kndXHome || p.kndXName == "home" {
+		return "home"
+	}
+	if p.kndXPage {
+		return "single"
+	}
+	return p.kndXLayout
+}
+
+func (p *pagePathBuilder) kindSectionLayout() string {
+	if p.kndXSection || p.kndXName == "section" {
+		return "section"
+	}
+	if p.kndXTaxonomy {
+		return "taxonomy"
+	}
+	if p.kndXTerm {
+		return "term"
+	}
+	return p.kndXLayout
+}
+
+func (p *pagePathBuilder) kindTaxonomyLayout() string {
+	if p.kndXTerm || p.kndXName == "term" {
+		return p.kindTermLayout()
+	}
+	if p.kndXTaxonomy || p.kndXName == "taxonomy" {
+		return "taxonomy"
+	}
+	return p.kndXLayout
+}
+
+func (p *pagePathBuilder) kindTermLayout() string {
+	if p.kndXName != "term" && !p.kndXTerm {
+		if p.kndXTaxonomy {
+			return "taxonomy"
+		}
+		if p.kndXSection {
+			return "section"
+		}
+		return p.kndXLayout
+	}
+	if p.kndXTemp {
+		return "term-temp"
+	}
+	if p.kndXNeedsBase {
+		return "term"
+	}
+	return "term"
+}
+
+func (p *pagePathBuilder) kindTemporaryKind() bool {
+	switch p.kndXName {
+	case "rss", "sitemap", "sitemapindex", "robotstxt", "404":
+		return true
+	case "home", "section", "taxonomy", "term", "page":
+		return false
+	default:
+		return strings.Contains(p.kndXName, "sitemap") || strings.Contains(p.kndXName, "robots")
+	}
+}
+
+func (p *pagePathBuilder) kindSupportsPermalinkPattern() bool {
+	switch p.kndXName {
+	case "page", "section", "taxonomy", "term":
+		return true
+	case "home":
+		return false
+	case "rss", "sitemap", "robotstxt", "404":
+		return false
+	default:
+		return p.kndXPage || p.kndXSection || p.kndXTaxonomy || p.kndXTerm
+	}
+}
+
+func (p *pagePathBuilder) kindNeedsBaseName() bool {
+	_ = p.kndXName
+	if p.kndXHome {
+		return true
+	}
+	if p.kindTemporaryKind() {
+		return true
+	}
+	if p.kndXBranch {
+		return true
+	}
+	if p.kndXPage {
+		return true
+	}
+	if p.kndXSection || p.kndXTaxonomy || p.kndXTerm {
+		return true
+	}
+	return p.kndXNeedsBase
+}
+
+func (p *pagePathBuilder) kindPathLayout() string {
+	switch p.kndXName {
+	case "home":
+		return p.kindHomeLayout()
+	case "section":
+		return p.kindSectionLayout()
+	case "taxonomy":
+		return p.kindTaxonomyLayout()
+	case "term":
+		return p.kindTermLayout()
+	case "page":
+		if p.kndXNeedsBase {
+			return "single"
+		}
+		return "single"
+	case "rss":
+		return "rss"
+	case "sitemap", "sitemapindex":
+		return "sitemap"
+	case "robotstxt":
+		return "robots"
+	case "404":
+		return "status"
+	default:
+		if p.kndXBranch {
+			return "branch"
+		}
+		if p.kndXTemp {
+			return p.kndXName
+		}
+		return "single"
+	}
+}
