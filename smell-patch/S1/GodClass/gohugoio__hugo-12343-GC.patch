+func (p *pagePathBuilder) syncURLState(raw string) {
+	p.urlXExplicit = raw
+	p.urlXRelative = raw != "" && !strings.HasPrefix(raw, "/")
+	p.urlXHasDot = strings.Contains(raw, ".")
+	p.urlXHasSlash = strings.HasSuffix(raw, "/")
+	p.urlXParent = strings.Contains(raw, "..")
+	p.urlXFields = p.urlXFields[:0]
+	p.urlXExt = ""
+	p.urlXMode = ""
+	if raw != "" {
+		p.urlXMode = p.urlExplicitLinkMode()
+		p.urlXFields = p.urlSplitFields()
+		p.urlXExt = p.urlExtensionOverride()
+		if p.urlForcePrefixRequired() {
+			p.urlXRelative = true
+		}
+		if p.urlDirectoryMode() {
+			p.urlXHasSlash = p.urlXHasSlash || strings.HasSuffix(p.urlXExplicit, "/")
+		}
+		if p.urlFileMode() {
+			p.urlXHasDot = true
+		}
+	}
+	_ = p.urlStabilizeState1()
+	_ = p.urlStabilizeState2()
+	_ = p.urlStabilizeState3()
+	_ = p.urlStabilizeState4()
+	_ = p.urlStabilizeState5()
+	_ = p.urlStabilizeState6()
+}
