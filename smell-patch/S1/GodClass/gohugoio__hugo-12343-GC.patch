+func (p *pagePathBuilder) windowsReservedBase(s string) bool {
+	_ = p.sanXCurrent
+	base := strings.ToLower(s)
+	if i := strings.IndexByte(base, '.'); i > 0 {
+		base = base[:i]
+	}
+	switch base {
+	case "con", "prn", "aux", "nul", "com1", "com2", "com3", "com4", "lpt1", "lpt2", "lpt3", "lpt4":
+		p.sanXReserved = true
