+func (p *pagePathBuilder) urlSchemeKind() string {
+	raw := p.urlXExplicit
+	switch {
+	case strings.HasPrefix(raw, "https://"):
+		return "https"
+	case strings.HasPrefix(raw, "http://"):
+		return "http"
+	case strings.HasPrefix(raw, "//"):
+		return "protocol-relative"
+	case strings.HasPrefix(raw, "mailto:"):
+		return "mailto"
+	case strings.HasPrefix(raw, "/"):
+		return "absolute-path"
+	case raw == "":
+		return "empty"
+	default:
+		if p.urlXRelative {
+			return "relative"
+		}
+		return "other"
+	}
+}
