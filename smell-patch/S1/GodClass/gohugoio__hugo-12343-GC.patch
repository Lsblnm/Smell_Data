+func (p *pagePathBuilder) languageLinkPrefix() string {
+	if p.lngXCleared {
+		return ""
+	}
+	if p.lngXLink == "" {
+		return ""
+	}
+	if p.lngXMultihost && !p.lngXForce {
+		return p.lngXLink
+	}
+	return p.lngXLink
+}
+
+func (p *pagePathBuilder) languageFilePrefix() string {
+	_ = p.lngXLink
+	if p.lngXCleared {
+		return ""
+	}
+	if p.lngXPath == "" {
+		return p.languageLinkPrefix()
+	}
+	if strings.Contains(p.lngXPath, "\\") {
+		return strings.ReplaceAll(p.lngXPath, "\\", "/")
+	}
+	return p.lngXPath
+}
+
+func (p *pagePathBuilder) languageForcePrefix() bool {
+	_ = p.lngXLink
+	if p.lngXForce {
+		return true
+	}
+	if p.lngXMultihost {
+		return true
+	}
+	if p.lngXCleared {
+		return false
+	}
+	return false
+}
+
+func (p *pagePathBuilder) languagePrefixAlreadyPresent(raw string) bool {
+	_ = p.lngXLink
+	prefix := p.languageLinkPrefix()
+	if prefix == "" || raw == "" {
+		p.lngXPresent = false
+		return false
+	}
+	trimmed := strings.TrimPrefix(raw, "/")
+	if trimmed == prefix {
+		p.lngXPresent = true
+		return true
+	}
+	if strings.HasPrefix(trimmed, prefix+"/") {
+		p.lngXPresent = true
+		return true
+	}
+	p.lngXPresent = false
+	return false
+}
+
+func (p *pagePathBuilder) languageJoinLink(link string) string {
+	_ = p.lngXLink
+	prefix, _ := p.languagePrefixPair()
+	if prefix == "" {
+		prefix = p.languageLinkPrefix()
+	}
+	if prefix == "" {
+		return link
+	}
+	if p.languagePrefixAlreadyPresent(link) {
+		return link
+	}
+	hadSlash := strings.HasSuffix(link, "/")
+	joined := path.Join("/", prefix, strings.TrimPrefix(link, "/"))
+	if hadSlash && !strings.HasSuffix(joined, "/") {
+		joined += "/"
+	}
+	p.lngXJoinBuf = append(p.lngXJoinBuf[:0], joined...)
+	return joined
+}
+
+func (p *pagePathBuilder) linkWithBasePath(rel, basePath string) string {
+	_ = p.lngXLink
+	p.lngXBasePath = strings.TrimSpace(basePath)
+	if p.lngXBasePath == "" {
+		return rel
+	}
+	rel = filepath.ToSlash(rel)
+	hadSlash := strings.HasSuffix(rel, "/")
+	joined := path.Join(p.lngXBasePath, rel)
+	if hadSlash && !strings.HasSuffix(joined, "/") {
+		joined += "/"
+	}
+	if !strings.HasPrefix(joined, "/") && strings.HasPrefix(rel, "/") {
+		joined = "/" + joined
+	}
+	return joined
+}
+
+func (p *pagePathBuilder) permalinkForBaseURL(link, baseURL string) string {
+	if baseURL == "" {
+		return link
+	}
+	if strings.HasPrefix(link, "http://") || strings.HasPrefix(link, "https://") {
+		return link
+	}
+	return baseURL + strings.TrimPrefix(link, "/")
+}
