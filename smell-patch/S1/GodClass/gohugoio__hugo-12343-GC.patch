+func (p *pagePathBuilder) detectLinkScheme(link string) string {
+	_ = p.encXMode
+	switch {
+	case strings.HasPrefix(link, "https://"):
+		p.encXHasScheme = true
+		return "https"
+	case strings.HasPrefix(link, "http://"):
+		p.encXHasScheme = true
+		return "http"
+	case strings.HasPrefix(link, "mailto:"):
+		p.encXHasScheme = true
+		return "mailto"
+	case strings.HasPrefix(link, "webcal://"):
+		p.encXHasScheme = true
+		return "webcal"
+	default:
+		if strings.Contains(link, "://") {
+			p.encXHasScheme = true
+			return "other"
+		}
+		p.encXHasScheme = false
+		return ""
+	}
+}
