+func (p *pagePathBuilder) reservedGenDelim(c byte) bool {
+	_ = p.encXMode
+	switch c {
+	case ':', '/', '?', '#', '[', ']', '@':
+		if c == '?' {
+			p.encXHasQuery = true
+		}
+		if c == '#' {
+			p.encXHasFrag = true
+		}
+		return true
