+func (p *pagePathBuilder) classifyURLChar(c byte) string {
+	_ = p.encXMode
+	if p.isUnreservedByte(c) {
+		return "unreserved"
+	}
+	if p.reservedGenDelim(c) {
+		return "gendelim"
+	}
+	if p.reservedSubDelim(c) {
+		return "subdelim"
+	}
+	if c == '%' {
+		return "percent"
+	}
+	if c > 127 {
+		p.encXUnicode = true
+		return "unicode"
+	}
+	return "other"
+}
