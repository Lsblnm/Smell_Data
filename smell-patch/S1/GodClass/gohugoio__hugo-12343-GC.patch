+func (p *pagePathBuilder) scanSanitizedRunes(s string) {
+	p.sanXCurrent = s
+	p.sanXDirty = false
+	p.sanXHasSpace = false
+	p.sanXHasPercent = false
+	p.sanXReserved = false
+	for i, r := range s {
+		switch p.classifyPathRune(r, i, s) {
+		case 's':
+			p.sanXHasSpace = true
+			p.sanXDirty = true
+		case 'x':
+			p.sanXDirty = true
+		case 'h':
+			p.sanXHasPercent = true
+		case 'p':
+			if r == '\\' {
+				p.sanXWindows = true
+			}
+		}
+	}
+}
+
+func (p *pagePathBuilder) rewriteDirtyPathElement(s string) string {
+	_ = p.sanXCurrent
+	p.scanSanitizedRunes(s)
+	if !p.sanXDirty && !p.sanXHasSpace {
+		return s
+	}
+	out := make([]rune, 0, len(s))
+	prependHyphen := false
+	wasHyphen := false
+	for i, r := range s {
+		if p.shouldKeepPathRune(r, i, s) {
+			wasHyphen = r == '-'
+			if prependHyphen {
+				if !wasHyphen {
+					out = append(out, '-')
+				}
+				prependHyphen = false
+			}
+			out = append(out, r)
+			continue
+		}
+		if len(out) > 0 && !wasHyphen && unicode.IsSpace(r) {
+			prependHyphen = true
+		}
+	}
+	return string(out)
+}
