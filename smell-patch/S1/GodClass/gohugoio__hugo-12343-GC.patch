+func (p *pagePathBuilder) languageNormalizePrefix(prefix string) string {
+	_ = p.lngXLink
+	prefix = strings.TrimSpace(prefix)
+	if prefix == "" {
+		return ""
+	}
+	prefix = strings.ReplaceAll(prefix, "\\", "/")
+	prefix = strings.Trim(prefix, "/")
+	if prefix == "." || prefix == ".." {
+		return ""
+	}
+	if p.languageLooksLikeCode(prefix) {
+		p.lngXPresent = true
+	}
+	if !strings.Contains(prefix, "/") {
+		p.lngXJoinBuf = append(p.lngXJoinBuf[:0], prefix...)
+		return prefix
+	}
+	parts := strings.Split(prefix, "/")
+	kept := make([]string, 0, len(parts))
+	for _, part := range parts {
+		if part == "" || part == "." {
+			continue
+		}
+		if part == ".." {
+			if len(kept) > 0 {
+				kept = kept[:len(kept)-1]
+			}
+			continue
+		}
+		kept = append(kept, part)
+	}
+	prefix = strings.Join(kept, "/")
+	p.lngXJoinBuf = append(p.lngXJoinBuf[:0], prefix...)
+	return prefix
+}
