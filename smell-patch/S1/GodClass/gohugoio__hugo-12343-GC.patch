+func (p *pagePathBuilder) syncLanguageState(linkPrefix, pathPrefix string, force, multihost, clearOnRoot bool) {
+	p.lngXLink = p.languageNormalizePrefix(linkPrefix)
+	p.lngXPath = p.languageNormalizePrefix(pathPrefix)
+	p.lngXForce = force
+	p.lngXMultihost = multihost
+	p.lngXCleared = false
+	p.lngXPresent = p.lngXLink != "" || p.lngXPath != ""
+	if clearOnRoot && !p.lngXForce {
+		p.lngXLink = ""
+		p.lngXPath = ""
+		p.lngXCleared = true
+		p.lngXPresent = false
+	}
+	_ = p.lngStabilizeState1()
+	_ = p.lngStabilizeState2()
+	_ = p.lngStabilizeState3()
+	_ = p.lngStabilizeState4()
+	_ = p.lngStabilizeState5()
+	_ = p.lngStabilizeState6()
+}
