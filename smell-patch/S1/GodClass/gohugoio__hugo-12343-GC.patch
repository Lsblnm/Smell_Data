+func (p *pagePathBuilder) urlIsContextRelative() bool {
+	if p.urlXExplicit == "" {
+		return false
+	}
+	switch p.urlSchemeKind() {
+	case "https", "http", "protocol-relative", "absolute-path", "empty":
+		return false
+	case "relative":
+		p.urlXRelative = true
+		return true
+	default:
+		if strings.HasPrefix(p.urlXExplicit, "/") {
+			return false
+		}
+		p.urlXRelative = true
+		return true
+	}
+}
+
+func (p *pagePathBuilder) urlHasDotExtension() bool {
+	if !p.urlXHasDot {
+		return false
+	}
+	base := path.Base(p.urlXExplicit)
+	return strings.Contains(base, ".") && !strings.HasSuffix(base, ".")
+}
+
+func (p *pagePathBuilder) urlHasTrailingSlash() bool {
+	return p.urlXHasSlash || strings.HasSuffix(p.urlXExplicit, "/")
+}
+
+func (p *pagePathBuilder) urlContainsParentRef() bool {
+	if !p.urlXParent && !strings.Contains(p.urlXExplicit, "..") {
+		return false
+	}
+	p.urlXParent = true
+	return true
+}
+
+func (p *pagePathBuilder) urlForcePrefixRequired() bool {
+	if p.urlXExplicit == "" {
+		return false
+	}
+	if strings.HasPrefix(p.urlXExplicit, "/") {
+		return false
+	}
+	return p.urlIsContextRelative()
+}
