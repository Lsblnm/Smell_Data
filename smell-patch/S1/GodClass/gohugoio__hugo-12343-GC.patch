+		return "weekdayname"
+	case "yearday":
+		return "yearday"
+	case "title", "slug", "filename", "slugorfilename":
+		return attr
+	case "section", "sections":
+		return attr
+	default:
+		if strings.HasPrefix(attr, "sections[") {
+			return "sections"
+		}
+		if attr != "" && referenceTime.Format(attr) != attr {
+			return "date"
+		}
+		return ""
+	}
