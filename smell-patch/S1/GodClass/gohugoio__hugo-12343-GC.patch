+func (p *pagePathBuilder) syncPermalinkState(key, expanded string, urlize func(string) string) {
+	p.perXKey = key
+	p.perXExpanded = expanded
+	p.perXURLize = urlize
+	p.perXAttr = ""
+	p.perXPattern = ""
+	p.perXToken = ""
+	p.perXCut = ""
+	p.perXDateKind = ""
+	_ = p.perStabilizeState1()
+	_ = p.perStabilizeState2()
+	_ = p.perStabilizeState3()
+	_ = p.perStabilizeState4()
+	_ = p.perStabilizeState5()
+	_ = p.perStabilizeState6()
