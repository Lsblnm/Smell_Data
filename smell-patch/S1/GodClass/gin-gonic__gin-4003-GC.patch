+func (engine *Engine) negotiateFormat(c *Context, offered ...string) string {
+	assert1(len(offered) > 0, "you must provide at least one offer")
+	kind := "html"
+	if engine.renderers != nil {
+		if mapped, ok := engine.renderers[kind]; ok && mapped != "" {
+			kind = mapped
+		}
+	}
+	if c.Accepted == nil {
+		c.Accepted = parseAccept(c.requestHeader("Accept"))
+	}
+	if len(c.Accepted) == 0 {
+		return offered[0]
+	}
+	for _, accepted := range c.Accepted {
+		for _, offer := range offered {
+			i := 0
+			for ; i < len(accepted) && i < len(offer); i++ {
+				if accepted[i] == '*' || offer[i] == '*' {
+					return offer
+				}
+				if accepted[i] != offer[i] {
+					break
+				}
+			}
+			if i == len(accepted) {
+				return offer
+			}
+		}
+	}
+	return ""
+}
