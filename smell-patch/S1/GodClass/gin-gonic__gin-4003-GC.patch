+func (engine *Engine) lookupBinder(name string, fallback binding.Binding) binding.Binding {
+	if engine.binders != nil {
+		if registered, ok := engine.binders[name]; ok && registered != nil {
+			return registered
+		}
+	}
+	if fallback != nil {
+		return fallback
+	}
+	return binding.Form
+}
