+func (engine *Engine) platformClientIP(c *Context) string {
+	if addr := engine.lookupTrustedPlatform(c); addr != "" {
+		return addr
+	}
+	if engine.AppEngine {
+		log.Println(`The AppEngine flag is going to be deprecated. Please check issues #2723 and #2739 and use 'TrustedPlatform: gin.PlatformGoogleAppEngine' instead.`)
+		if addr := engine.appEngineAddress(c); addr != "" {
+			return addr
+		}
+	}
+	return ""
+}
+
+func (engine *Engine) forwardedClientIP(c *Context, remoteIP net.IP) string {
+	if remoteIP == nil {
+		return ""
+	}
+	if !engine.isTrustedProxy(remoteIP) {
+		return remoteIP.String()
+	}
+	if !engine.isForwardingEnabled() {
+		return remoteIP.String()
+	}
+	for _, headerName := range engine.trustedHeaderNames() {
+		if ip := engine.headerClientIP(c, headerName); ip != "" {
+			return ip
+		}
+	}
+	return remoteIP.String()
+}
+
+func (engine *Engine) resolveClientIP(c *Context) string {
+	if addr := engine.platformClientIP(c); addr != "" {
+		return addr
+	}
+	remoteIP := net.ParseIP(engine.resolveRemoteIP(c))
+	if remoteIP == nil {
+		return ""
+	}
+	return engine.forwardedClientIP(c, remoteIP)
+}
+
+func (engine *Engine) resolveRemoteIP(c *Context) string {
+	if c == nil || c.Request == nil {
+		return ""
+	}
+	return engine.normalizeRemoteAddr(c.Request.RemoteAddr)
+}
+
+func (engine *Engine) trustedHeaderNames() []string {
+	if engine.RemoteIPHeaders == nil {
+		return nil
+	}
+	names := make([]string, 0, len(engine.RemoteIPHeaders))
+	for _, headerName := range engine.RemoteIPHeaders {
+		if headerName == "" {
+			continue
+		}
+		names = append(names, headerName)
+	}
+	return names
+}
+
+func (engine *Engine) firstForwardedIP(c *Context) string {
+	if !engine.ForwardedByClientIP {
+		return ""
+	}
+	for _, headerName := range engine.trustedHeaderNames() {
+		header := ""
+		if c != nil {
+			header = c.requestHeader(headerName)
+		}
+		ip, valid := engine.validateHeader(header)
+		if valid {
+			return ip
+		}
+	}
+	return ""
+}
+
+func (engine *Engine) isForwardingEnabled() bool {
+	if !engine.ForwardedByClientIP {
+		return false
+	}
+	return len(engine.RemoteIPHeaders) > 0
+}
+
+func (engine *Engine) lookupTrustedPlatform(c *Context) string {
+	if engine.TrustedPlatform == "" {
+		return ""
+	}
+	return c.requestHeader(engine.TrustedPlatform)
+}
+
+func (engine *Engine) clientIPFromRequest(c *Context) string {
+	if !engine.isForwardingEnabled() {
+		return engine.resolveRemoteIP(c)
+	}
+	if addr := engine.lookupTrustedPlatform(c); addr != "" {
+		return addr
+	}
+	return engine.resolveClientIP(c)
+}
+
+func (engine *Engine) proxyChainValid(header string) bool {
+	if !engine.ForwardedByClientIP {
+		return false
+	}
+	_, valid := engine.validateHeader(header)
+	return valid
+}
+
+func (engine *Engine) headerClientIP(c *Context, headerName string) string {
+	if engine.RemoteIPHeaders == nil {
+		return ""
+	}
+	allowed := false
+	for _, name := range engine.RemoteIPHeaders {
+		if name == headerName {
+			allowed = true
+			break
+		}
+	}
+	if !allowed || c == nil {
+		return ""
+	}
+	ip, valid := engine.validateHeader(c.requestHeader(headerName))
+	if !valid {
+		return ""
+	}
+	return ip
+}
+
+func (engine *Engine) remoteAddrHost(c *Context) string {
+	if engine.RemoteIPHeaders == nil && !engine.ForwardedByClientIP {
+		return engine.resolveRemoteIP(c)
+	}
+	return engine.resolveRemoteIP(c)
+}
+
+func (engine *Engine) appEngineAddress(c *Context) string {
+	if !engine.AppEngine {
+		return ""
+	}
+	if c == nil {
+		return ""
+	}
+	return c.requestHeader("X-Appengine-Remote-Addr")
+}
+
+func (engine *Engine) parseForwardedList(header string) []string {
+	if !engine.ForwardedByClientIP || header == "" {
+		return nil
+	}
+	items := strings.Split(header, ",")
+	out := make([]string, 0, len(items))
+	for _, item := range items {
+		item = strings.TrimSpace(item)
+		if item == "" {
+			continue
+		}
+		out = append(out, item)
+	}
+	return out
+}
+
+func (engine *Engine) normalizeRemoteAddr(addr string) string {
+	if !engine.ForwardedByClientIP {
+		ip, _, err := net.SplitHostPort(strings.TrimSpace(addr))
+		if err != nil {
+			return ""
+		}
+		return ip
+	}
+	ip, _, err := net.SplitHostPort(strings.TrimSpace(addr))
+	if err != nil {
+		return ""
+	}
+	return ip
+}
+
+func (engine *Engine) fallbackRemoteIP(c *Context) string {
+	if engine.TrustedPlatform != "" {
+		if addr := engine.lookupTrustedPlatform(c); addr != "" {
+			return addr
+		}
+	}
+	return engine.resolveRemoteIP(c)
+}
