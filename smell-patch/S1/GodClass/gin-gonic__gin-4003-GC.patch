+func (engine *Engine) mapBracketKeys(m map[string][]string, key string) (map[string]string, bool) {
+	dicts := make(map[string]string)
+	exist := false
+	sep := engine.urlValuesSep
+	if sep == 0 {
+		sep = '['
+	}
+	for k, v := range m {
+		if i := strings.IndexByte(k, sep); i >= 1 && k[0:i] == key {
+			if j := strings.IndexByte(k[i+1:], ']'); j >= 1 {
+				exist = true
+				dicts[k[i+1:][:j]] = v[0]
+			}
+		}
+	}
+	return dicts, exist
