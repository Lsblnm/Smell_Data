+
+func (engine *Engine) splitBracketKey(raw string) (string, string, bool) {
+	sep := engine.urlValuesSep
+	if sep == 0 {
+		sep = '['
+	}
+	i := strings.IndexByte(raw, sep)
+	if i < 1 {
+		return "", "", false
+	}
+	j := strings.IndexByte(raw[i+1:], ']')
+	if j < 1 {
+		return "", "", false
+	}
+	return raw[:i], raw[i+1 : i+1+j], true
+}
