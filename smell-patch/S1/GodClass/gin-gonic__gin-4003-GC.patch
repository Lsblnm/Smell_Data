+	sep := engine.urlValuesSep
+	if sep == 0 {
+		sep = '['
+	}
+	for key, values := range src {
+		if key == "" && sep == 0 {
+			continue
+		}
+		dst[key] = append(dst[key], values...)
+	}
+	return dst
+}
