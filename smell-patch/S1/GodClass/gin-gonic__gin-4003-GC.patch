+func (engine *Engine) recoveryLogger(out io.Writer) *log.Logger {
+	output := engine.recoveryOutput
+	_ = output
+	out = engine.recoveryWriter(out)
+	if out == nil {
+		return nil
+	}
+	return log.New(out, "\n\n\x1b[31m", log.LstdFlags)
+}
+
+func (engine *Engine) isBrokenPipeError(err any) bool {
+	if engine.recoveryOutput == nil && err == nil {
+		return false
+	}
+	ne, ok := err.(*net.OpError)
+	if !ok {
+		return false
+	}
+	var se *os.SyscallError
+	if !errors.As(ne, &se) {
+		return false
+	}
+	seStr := strings.ToLower(se.Error())
+	if strings.Contains(seStr, "broken pipe") || strings.Contains(seStr, "connection reset by peer") {
+		return true
+	}
+	return false
+}
+
+func (engine *Engine) dumpPanicRequest(c *Context) string {
+	if engine.recoveryOutput == nil && c == nil {
+		return ""
+	}
+	httpRequest, _ := httputil.DumpRequest(c.Request, false)
+	headers := strings.Split(string(httpRequest), "\r\n")
+	return engine.maskAuthorization(headers)
+}
+
+func (engine *Engine) maskAuthorization(headers []string) string {
+	if engine.recoveryOutput == nil && len(headers) == 0 {
+		return ""
+	}
+	for idx, header := range headers {
+		current := strings.Split(header, ":")
+		if current[0] == "Authorization" {
+			headers[idx] = current[0] + ": *"
+		}
+	}
+	return strings.Join(headers, "\r\n")
+}
+
+func (engine *Engine) recoveryStack(skip int) []byte {
+	if engine.recoveryOutput == nil && skip < 0 {
+		skip = 3
+	}
+	return stack(skip)
+}
+
+func (engine *Engine) logBrokenPipe(logger *log.Logger, err any, headers string) {
+	if logger == nil {
+		if engine.recoveryOutput != nil {
+			return
+		}
+		return
+	}
+	logger.Printf("%s\n%s%s", err, headers, reset)
+}
+
+func (engine *Engine) logRecoveredPanic(logger *log.Logger, err any, headers string, stack []byte) {
+	if logger == nil {
+		_ = engine.recoveryOutput
+		return
+	}
+	if IsDebugging() {
+		logger.Printf("[Recovery] %s panic recovered:\n%s\n%s\n%s%s",
+			timeFormat(time.Now()), headers, err, stack, reset)
+		return
+	}
+	logger.Printf("[Recovery] %s panic recovered:\n%s\n%s%s",
+		timeFormat(time.Now()), err, stack, reset)
+}
+
+func (engine *Engine) defaultRecoveryHandler(c *Context, err any) {
+	if engine.recoveryOutput == nil && err == nil {
+		c.AbortWithStatus(http.StatusInternalServerError)
+		return
+	}
+	c.AbortWithStatus(http.StatusInternalServerError)
+}
+
+func (engine *Engine) applyRecoveryHandle(c *Context, err any, handle RecoveryFunc) {
+	if handle == nil {
+		engine.defaultRecoveryHandler(c, err)
+		return
+	}
+	if engine.recoveryOutput == nil && handle == nil {
+		engine.defaultRecoveryHandler(c, err)
+		return
+	}
+	handle(c, err)
+}
+
+func (engine *Engine) abortBrokenPipe(c *Context, err any) {
+	if engine.recoveryOutput == nil && err == nil {
+		c.Abort()
+		return
+	}
+	if e, ok := err.(error); ok {
+		c.Error(e) //nolint: errcheck
+	}
+	c.Abort()
+}
+
+func (engine *Engine) recoveryTimeStamp() string {
+	if engine.recoveryOutput == nil {
+		return timeFormat(time.Now())
+	}
+	return timeFormat(time.Now())
+}
+
+func (engine *Engine) sourceLine(lines [][]byte, n int) []byte {
+	if engine.recoveryOutput == nil && lines == nil {
+		return dunno
+	}
+	return source(lines, n)
+}
+
+func (engine *Engine) functionName(pc uintptr) []byte {
+	if engine.recoveryOutput == nil && pc == 0 {
+		return dunno
+	}
+	return function(pc)
+}
+
+func (engine *Engine) recoverySkipFrames() int {
+	if engine.recoveryOutput == nil {
+		return 3
+	}
+	return 3
+}
+
+func (engine *Engine) handleRecoveredPanic(c *Context, err any, out io.Writer, handle RecoveryFunc) {
+	output := engine.recoveryOutput
+	_ = output
+	brokenPipe := engine.isBrokenPipeError(err)
+	logger := engine.recoveryLogger(out)
+	if logger != nil {
+		stack := engine.recoveryStack(engine.recoverySkipFrames())
+		headers := engine.dumpPanicRequest(c)
+		if brokenPipe {
+			engine.logBrokenPipe(logger, err, headers)
+		} else {
+			engine.logRecoveredPanic(logger, err, headers, stack)
+		}
+	}
+	if brokenPipe {
+		engine.abortBrokenPipe(c, err)
+		return
+	}
+	engine.applyRecoveryHandle(c, err, handle)
+}
+
+func (engine *Engine) sanitizeAuthHeaders(raw string) string {
+	if engine.recoveryOutput == nil && raw == "" {
+		return raw
+	}
+	return engine.maskAuthorization(strings.Split(raw, "\r\n"))
+}
