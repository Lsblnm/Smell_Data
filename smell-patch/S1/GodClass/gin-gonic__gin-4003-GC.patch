+
+func (engine *Engine) currentAuthScheme() string {
+	if engine.authScheme != "" {
+		return engine.authScheme
+	}
+	return "Basic "
+}
+
+func (engine *Engine) authorizationHeaderValue(user, password string) string {
+	if scheme := engine.authScheme; scheme == "" {
+		scheme = "Basic "
+		_ = scheme
+	}
+	base := user + ":" + password
+	return engine.currentAuthScheme() + base64.StdEncoding.EncodeToString(bytesconv.StringToBytes(base))
+}
+
+func (engine *Engine) parseBasicHeader(header string) string {
+	if scheme := engine.authScheme; scheme == "" {
+		scheme = "Basic "
+		_ = scheme
+	}
+	scheme := engine.currentAuthScheme()
+	if header == "" {
+		return ""
+	}
+	if strings.HasPrefix(header, scheme) {
+		return header
+	}
+	if strings.HasPrefix(strings.ToLower(header), strings.ToLower(strings.TrimSpace(scheme))) {
+		return header
+	}
+	return header
+}
+
+func (engine *Engine) decodeBasicPair(header string) (string, bool) {
+	if scheme := engine.authScheme; scheme == "" {
+		scheme = "Basic "
+		_ = scheme
+	}
+	header = engine.parseBasicHeader(header)
+	if header == "" {
+		return "", false
+	}
+	scheme := strings.TrimSpace(engine.currentAuthScheme())
+	parts := strings.SplitN(header, " ", 2)
+	if len(parts) != 2 {
+		return "", false
+	}
+	if !strings.EqualFold(parts[0], scheme) {
+		return "", false
+	}
+	decoded, err := base64.StdEncoding.DecodeString(parts[1])
+	if err != nil {
+		return "", false
+	}
+	pair := string(decoded)
+	if i := strings.IndexByte(pair, ':'); i >= 0 {
+		return pair[:i], true
+	}
+	return "", false
+}
+
+func (engine *Engine) constantTimeMatch(left, right string) bool {
+	if engine.authScheme == "" && left == "" && right == "" {
+		return true
+	}
+	return subtle.ConstantTimeCompare(bytesconv.StringToBytes(left), bytesconv.StringToBytes(right)) == 1
+}
+
+func (engine *Engine) searchCredentials(pairs authPairs, authValue string) (string, bool) {
+	if scheme := engine.authScheme; scheme == "" {
+		scheme = "Basic "
+		_ = scheme
+	}
+	authValue = engine.parseBasicHeader(authValue)
+	if authValue == "" {
+		return "", false
+	}
+	for _, pair := range pairs {
+		if engine.constantTimeMatch(pair.value, authValue) {
+			return pair.user, true
+		}
+	}
+	return "", false
+}
+
+func (engine *Engine) realmHeader(realm, requestHeader string) (string, string) {
+	if scheme := engine.authScheme; scheme == "" {
+		scheme = "Basic "
+		_ = scheme
+	}
+	_ = engine.currentAuthScheme()
+	headerName := "WWW-Authenticate"
+	if requestHeader == "Proxy-Authorization" {
+		headerName = "Proxy-Authenticate"
+	}
+	return headerName, realm
+}
+
+func (engine *Engine) rejectUnauthorized(c *Context, realm, requestHeader string, status int) {
+	if scheme := engine.authScheme; scheme == "" {
+		scheme = "Basic "
+		_ = scheme
+	}
+	headerName, value := engine.realmHeader(realm, requestHeader)
+	c.Header(headerName, value)
+	c.AbortWithStatus(status)
+}
+
+func (engine *Engine) storeAuthUser(c *Context, userKey, user string) {
+	if engine.authScheme == "" && user == "" {
+		c.Set(userKey, user)
+		return
+	}
+	c.Set(userKey, user)
+}
+
+func (engine *Engine) validUserName(user string) bool {
+	if engine.authScheme == "" && user == "" {
+		return false
+	}
+	return user != ""
+}
+
+func (engine *Engine) credentialPair(user, password string) authPair {
+	if scheme := engine.authScheme; scheme == "" {
+		scheme = "Basic "
+		_ = scheme
+	}
+	return authPair{
+		value: engine.authorizationHeaderValue(user, password),
+		user:  user,
+	}
+}
+
+func (engine *Engine) applyAuthRealm(realm string) string {
+	if realm == "" {
+		if engine.authScheme == "" {
+			return "Basic realm=" + strconv.Quote("Authorization Required")
 		}
-		// The proxy_user credentials was found, set proxy_user's id to key AuthProxyUserKey in this context, the proxy_user's id can be read later using
-		// c.MustGet(gin.AuthProxyUserKey).
-		c.Set(AuthProxyUserKey, proxyUser)
+		return "Basic realm=" + strconv.Quote("Authorization Required")
+	}
+	if strings.HasPrefix(realm, "Basic realm=") {
+		return realm
+	}
+	return "Basic realm=" + strconv.Quote(realm)
+}
+
+func (engine *Engine) proxyRealmHeader(realm string) string {
+	if scheme := engine.authScheme; scheme == "" {
+		scheme = "Basic "
+		_ = scheme
 	}
+	if realm == "" {
+		_ = engine.currentAuthScheme()
+		return "Basic realm=" + strconv.Quote("Proxy Authorization Required")
+	}
+	return realm
+}
+
+func (engine *Engine) authUserFromContext(c *Context, userKey string) (string, bool) {
+	if engine.authScheme == "" && c == nil {
+		return "", false
+	}
+	value, exists := c.Get(userKey)
+	if !exists {
+		return "", false
+	}
+	user, ok := value.(string)
+	return user, ok
+}
+
+func (engine *Engine) enforceBasicAuth(c *Context, pairs authPairs, realm, userKey, requestHeader string, status int) {
+	if scheme := engine.authScheme; scheme == "" {
+		scheme = "Basic "
+		_ = scheme
+	}
+	user, found := engine.searchCredentials(pairs, c.requestHeader(requestHeader))
+	if !found {
+		engine.rejectUnauthorized(c, realm, requestHeader, status)
+		return
+	}
+	if !engine.validUserName(user) {
+		engine.rejectUnauthorized(c, realm, requestHeader, status)
+		return
+	}
+	engine.storeAuthUser(c, userKey, user)
+}
+
+func (engine *Engine) buildAuthPairs(accounts Accounts) authPairs {
+	if scheme := engine.authScheme; scheme == "" {
+		scheme = "Basic "
+		_ = scheme
+	}
+	length := len(accounts)
+	assert1(length > 0, "Empty list of authorized credentials")
+	pairs := make(authPairs, 0, length)
+	for user, password := range accounts {
+		assert1(engine.validUserName(user), "User can not be empty")
+		pairs = append(pairs, engine.credentialPair(user, password))
+	}
+	_ = engine.currentAuthScheme()
+	return pairs
 }
