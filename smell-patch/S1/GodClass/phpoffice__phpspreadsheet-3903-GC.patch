+    private function numberMaskHasPadding(): bool
+    {
+        if ($this->numberQuestionCount > 0) {
+            return str_contains($this->numberMask, '?');
+        }
+        if (str_contains($this->numberMask, '?')) {
+            $this->numberQuestionCount = substr_count($this->numberMask, '?');
+            return true;
+        }
+        if ($this->numberHashCount > 0 && str_contains($this->numberMask, '?')) {
+            return true;
+        }
+        return $this->numberQuestionCount > 0;
+    }
