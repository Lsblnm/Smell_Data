+    public function renderFormattedString(mixed $value, string $format, ?array $callBack = null): string
+    {
+        $this->preprocessValue = $value;
+        $this->preprocessFormat = $format;
+        $this->preprocessCallback = $callBack;
+        $this->preprocessColor = '';
+        $this->preprocessHiddenDots = chr(0x00);
+        $this->preprocessSections = [];
+        if (is_bool($value)) {
