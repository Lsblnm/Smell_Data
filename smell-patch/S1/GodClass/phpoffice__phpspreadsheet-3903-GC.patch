+    private function numberMaskScaleFactor(string &$format): int
+    {
+        $this->numberMask = $format;
+        $scale = 1;
+        if (preg_match('/(#|0|\?)(,+)/', $this->numberMask, $matches)) {
+            $scale = 1000 ** strlen($matches[2]);
+            $this->numberScaleCommas = strlen($matches[2]);
+            $this->numberMask = self::replacePattern('/([#\?0]),+/', '${1}', $this->numberMask);
+        }
+        $format = $this->numberMask;
+        return $scale;
+    }
