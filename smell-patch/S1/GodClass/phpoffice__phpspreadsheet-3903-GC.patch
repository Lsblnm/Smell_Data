+    private function compareSectionValue(mixed $value, ?string $condition, mixed $comparisonValue, string $defaultCondition, mixed $defaultComparisonValue): bool
+    {
+        if (!$condition) {
+            $condition = $defaultCondition;
+            $comparisonValue = $defaultComparisonValue;
+        }
+        $this->sectionOperations[4] = (string) $condition;
+        $this->sectionComparisons[4] = $comparisonValue;
+        return match ($condition) {
+            '>' => $value > $comparisonValue,
+            '<' => $value < $comparisonValue,
+            '<=' => $value <= $comparisonValue,
+            '<>' => $value != $comparisonValue,
+            '=' => $value == $comparisonValue,
+            default => $value >= $comparisonValue,
+        };
+    }
