+    private function numberMaskLooksFraction(): bool
+    {
+        if ($this->numberMask === '') {
+            return false;
+        }
+        return (bool) preg_match('/[#\?0]?.*[#\?0]\/(\?+|\d+|#)/', $this->numberMask);
+    }
