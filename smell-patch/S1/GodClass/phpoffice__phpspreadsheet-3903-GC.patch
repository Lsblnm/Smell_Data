+    private function extractSectionColors(): void
+    {
+        $color_regex = '/\\[(' . implode('|', Color::NAMED_COLORS) . '|color\\s*(\\d+))\\]/mui';
+        $sectionCount = count($this->sectionList);
+        for ($idx = 0; $idx < $sectionCount; ++$idx) {
+            if (preg_match($color_regex, $this->sectionList[$idx], $matches)) {
+                if (isset($matches[2])) {
+                    $this->sectionColors[$idx] = '#' . BIFF8::lookup((int) $matches[2] + 7)['rgb'];
+                } else {
+                    $this->sectionColors[$idx] = $matches[0];
+                }
+                $this->sectionList[$idx] = (string) preg_replace($color_regex, '', $this->sectionList[$idx]);
+            }
+        }
+        $this->sectionSelectedColor = $this->sectionColors[0] ?? '';
+        $this->sectionSelectedFormat = (string) ($this->sectionList[0] ?? $this->sectionSelectedFormat);
+    }
+
+    private function extractSectionConditions(): void
+    {
+        $cond_regex = '/\\[(>|>=|<|<=|=|<>)([+-]?\\d+([.]\\d+)?)\\]/';
+        $sectionCount = count($this->sectionList);
+        for ($idx = 0; $idx < $sectionCount; ++$idx) {
+            if (preg_match($cond_regex, $this->sectionList[$idx], $matches)) {
+                $this->sectionOperations[$idx] = $matches[1];
+                $this->sectionComparisons[$idx] = $matches[2];
+                $this->sectionList[$idx] = (string) preg_replace($cond_regex, '', $this->sectionList[$idx]);
+            }
+        }
