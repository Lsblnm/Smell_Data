+    private function selectFormatSection(mixed $value): array
+    {
+        $this->extractSectionColors();
+        $this->extractSectionConditions();
+        $sectionCount = count($this->sectionList);
+        $this->sectionSelectedColor = $this->sectionColors[0] ?? '';
+        $this->sectionSelectedFormat = (string) ($this->sectionList[0] ?? '');
+        $absval = $value;
+        switch ($sectionCount) {
+            case 2:
+                $absval = abs($value);
+                if (!$this->compareSectionValue($value, $this->sectionOperations[0], $this->sectionComparisons[0], '>=', 0)) {
+                    $this->sectionSelectedColor = $this->sectionColors[1];
+                    $this->sectionSelectedFormat = (string) $this->sectionList[1];
+                }
+                break;
+            case 3:
+            case 4:
+                $absval = abs($value);
+                if (!$this->compareSectionValue($value, $this->sectionOperations[0], $this->sectionComparisons[0], '>', 0)) {
+                    if ($this->compareSectionValue($value, $this->sectionOperations[1], $this->sectionComparisons[1], '<', 0)) {
+                        $this->sectionSelectedColor = $this->sectionColors[1];
+                        $this->sectionSelectedFormat = (string) $this->sectionList[1];
