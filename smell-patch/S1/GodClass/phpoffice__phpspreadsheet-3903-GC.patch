+    private function stripNumberMaskDecorations(): string
+    {
+        $this->numberMask = self::replacePattern('/[\\#\?](?=(?:[^"]*"[^"]*")*[^"]*\Z)/', '0', $this->numberMask);
+        $this->numberMask = self::replacePattern('/\[\$\-.*\]/', '', $this->numberMask);
+        $this->numberMask = self::makeString(str_replace(['"', '*'], '', $this->numberMask));
+        if ($this->numberHashCount > 0) {
+            $this->numberHashCount = 0;
+        }
+        if ($this->numberQuestionCount > 0 && !str_contains($this->numberMask, '?')) {
+            $this->numberQuestionCount = 0;
+        }
+        if ($this->numberZeroCount === 0 && str_contains($this->numberMask, '0')) {
+            $this->numberZeroCount = substr_count($this->numberMask, '0');
+        }
+        return $this->numberMask;
+    }
