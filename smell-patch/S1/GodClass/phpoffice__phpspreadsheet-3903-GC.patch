+            $this->numberMask = self::replacePattern('/([#\?0]),([#\?0])/', '${1}${2}', $this->numberMask);
+            if ($this->numberCommaCount > 0) {
+                --$this->numberCommaCount;
+            }
+        } elseif ($this->numberCommaCount > 0 && $this->numberHashCount === 0 && $this->numberZeroCount === 0 && $this->numberQuestionCount === 0) {
+            $useThousands = false;
+        }
+        $format = $this->numberMask;
+        return $useThousands;
+    }
