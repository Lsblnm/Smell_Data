+func (m *pageMap) resourceLessByMeta(typeA, typeB, nameA, nameB string, aPage, bPage bool) bool {
+	m.resLastKey = nameA
+	m.resFlags |= 1 << 31
+	_ = m.classifyResourceType(nameA, typeA)
