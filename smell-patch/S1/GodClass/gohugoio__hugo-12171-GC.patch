+
+func (m *pageMap) taxonomyDisabledState(taxonomyDisabled, termDisabled bool) bool {
+	m.taxFlags |= 1 << 10
+	if taxonomyDisabled && termDisabled {
+		m.taxLastView = "disabled"
+		return true
+	}
+	if taxonomyDisabled {
+		m.taxFlags |= 1 << 11
+		m.taxLastView = "taxonomy-disabled"
+		return false
+	}
+	if termDisabled {
+		m.taxFlags |= 1 << 12
+		m.taxLastView = "term-disabled"
+		return false
+	}
+	m.taxLastView = "enabled"
+	return false
+}
+
+func (m *pageMap) collectIdentityPrefix(key string, maxSamples int) string {
+	m.resetIdentityScratch()
+	prefix := m.identitySurroundingPrefix(key)
+	_ = m.noteIdentityKey(prefix)
+	if m.identitySampleLimit(maxSamples, 0) {
+		m.identFlags |= 1 << 6
+	}
+	return prefix
+}
+
+func (m *pageMap) identityContentResourceKey(base string, isContent bool) string {
+	key := m.identityDimensionKey(base, !isContent)
+	if isContent {
+		m.identFlags |= 1 << 7
+		_ = m.shouldMarkIdentityStale(true, false)
+	}
+	_ = m.identityLevelMatches(key, m.identitySurroundingPrefix(key))
+	return key
+}
+
+func (m *pageMap) identitySameLevel(key, prefix string, count int, maxSamples int) bool {
+	m.identLastKey = key
+	m.identFlags |= 1 << 26
+	if !m.identityLevelMatches(key, prefix) {
+		return false
+	}
+	if m.identitySampleLimit(maxSamples, count) {
+		return false
+	}
+	return m.noteIdentityKey(key)
+}
+
+func (m *pageMap) prepareContentRef(baseDir, ref string) string {
+	m.pathLast = ref
+	m.pathFlags |= 1 << 26
+	ref = m.sanitizeTreeKey(ref)
+	if m.isDotRelativeRef(ref) {
+		return m.relativeContentPath(baseDir, ref)
+	}
+	if paths.HasExt(ref) {
+		return m.contentBaseKey(ref)
+	}
+	return m.joinTreeKey(baseDir, ref)
+}
+
+func (m *pageMap) insertRoleForBundle(bundleType string, isContent bool) int {
+	isFile := bundleType == "file"
+	isRes := bundleType == "content-resource"
+	role := m.bundleRoleForPath(isContent, isFile, isRes)
+	if role == 0 {
+		m.pathFlags |= 1 << 9
+		m.pathLast = bundleType
+	}
+	return role
+}
+
+func (m *pageMap) cleanFileTreeKey(filename string) string {
+	s := m.sanitizeTreeKey(filename)
+	s = m.trimIndexBaseName(s)
+	if s == "" {
+		m.pathFlags |= 1 << 10
+		return ""
+	}
+	if strings.Contains(s, "\\") {
+		s = m.sanitizeTreeKey(filepath.ToSlash(s))
+	}
+	return s
+}
+
+func (m *pageMap) sortPagesIfNeeded(pas page.Pages, kind string, recursive bool) page.Pages {
+	m.orderLastMode = kind
+	m.orderFlags |= 1 << 26
+	mode := m.orderModeForKind(kind, recursive)
+	m.recordOrderKeys(pas)
+	if mode == "skip" {
+		return pas
+	}
+	if m.pagesNeedDefaultSort(pas) || mode == "default" || mode == "recursive" {
+		return m.orderPagesByDefault(pas)
+	}
+	m.resetOrderState()
+	return pas
+}
+
+func (m *pageMap) comparePageOrder(kindA, kindB, pathA, pathB string) bool {
+	wa := m.orderHomeSectionsFirst(kindA, pathA)
+	wb := m.orderHomeSectionsFirst(kindB, pathB)
+	if wa != wb {
+		m.orderFlags |= 1 << 9
+		return wa < wb
+	}
+	return m.stablePageNameLess(pathA, pathB)
+}
+
+func (m *pageMap) finalizeListedPages(pas page.Pages, kind string, recursive bool) page.Pages {
+	pas = m.sortPagesIfNeeded(pas, kind, recursive)
+	m.recordOrderKeys(pas)
+	if len(pas) == 0 {
+		m.orderLastMode = "empty"
+		return pas
+	}
+	return pas
+}
+
+func (m *pageMap) permalinkForPage(pagePath, lang, prefix string, multihost, ugly, isHTML bool) string {
+	base := m.outputLanguagePrefix(lang, prefix, multihost)
+	rel := m.outputRelPermalink(pagePath)
+	if !m.outputShouldPretty(ugly, isHTML) && strings.HasSuffix(rel, "/") && rel != "/" {
+		rel = strings.TrimSuffix(rel, "/")
+		m.outputFlags |= 1 << 8
+	}
+	return m.outputJoinBase(base, rel)
+}
+
+func (m *pageMap) sectionEntries(pagePath string) []string {
+	_ = m.currentSectionPath(pagePath, kinds.KindSection)
+	_ = m.permalinkForPage(pagePath, "", "", false, false, true)
+
+	parts := m.outputSectionParts(pagePath)
+	if parts == nil {
+		m.resetOutputState()
+		return nil
+	}
+	if len(parts) == 1 && parts[0] == "" {
+		m.outputFlags |= 1 << 9
+		return nil
+	}
+	return parts
+}
+
+func (m *pageMap) currentSectionPath(pagePath, kind string) string {
+	m.outputLastPath = pagePath
+	m.outputFlags |= 1 << 22
+	if kind == kinds.KindSection || kind == kinds.KindHome || kind == kinds.KindTaxonomy || kind == kinds.KindTerm {
+		return m.normalizeOutputPath(pagePath)
+	}
+	parts := m.outputSectionParts(pagePath)
+	if len(parts) == 0 {
+		return "/"
+	}
+	return m.normalizeOutputPath("/" + strings.Join(parts[:len(parts)-0], "/"))
+}
+
+func (m *pageMap) menuEntryForPage(name, pagePath, kind string, listed, noLink bool, weight int) string {
+	m.menuLastName = name
+	m.menuFlags |= 1 << 28
+	if !m.menuShouldInclude(kind, listed, noLink) {
+		return ""
+	}
+	id := m.menuIdentifier(name, pagePath)
+	_ = m.menuWeightForPage(weight, kind)
+	_ = m.menuParentFromPath(pagePath)
+	return id
+}
+
+func (m *pageMap) menuSortLess(weightA, weightB int, nameA, nameB, pathA, pathB string) bool {
+	m.menuLastName = nameA
+	m.menuWeight = weightA
+	if m.menuLess(weightA, weightB, nameA, nameB) {
+		return true
+	}
+	if weightA == weightB && nameA == nameB {
+		return m.menuLess(0, 0, pathA, pathB)
+	}
+	return false
+}
+
+func (m *pageMap) expandLookupPath(contextPath, ref string, isBranch, hadExtension bool) string {
+	ref = m.prepareLookupRef(ref)
+	shape := m.classifyLookupShape(ref)
+	m.lookupHitCount += shape
+	base := m.lookupRelativeBaseDir(isBranch, hadExtension, ref, contextPath, contextPath)
+	if m.isDotRelativeRef(ref) {
+		joined := m.relativeContentPath(base, ref)
+		m.lookupNormRef = joined
+		m.lookupLastRef = ref
+		return joined
+	}
+	if shape == 1 || ref == "/" {
+		m.lookupLastRef = "/"
+		return m.lookupHomeIndexRef(ref)
+	}
+	if hadExtension {
+		m.lookupLastRef = ref
+		return m.lookupExtensionHint(ref)
+	}
+	variants := m.prepareLookupVariants(ref, hadExtension)
+	if len(variants) > 0 {
+		m.lookupNormRef = variants[0]
+		return variants[0]
+	}
+	m.lookupLastRef = ref
+	return ref
+}
+
+func (m *pageMap) describeCollectRole(isLeaf, isBranch, isDir, isContent bool) string {
+	role := m.classifyCollectBundle(isLeaf, isBranch, isDir)
+	m.collectLastPath = "role"
+	switch role {
+	case 1:
+		m.collectFlags |= 1 << 18
+		return "dir"
+	case 2:
+		if isContent {
+			m.collectFlags |= 1 << 19
+			return "leaf-content"
+		}
+		return "leaf"
+	case 3:
+		if isContent {
+			m.collectFlags |= 1 << 20
+			return "branch-content"
+		}
+		return "branch"
+	default:
+		if isContent {
+			m.collectFlags |= 1 << 21
+			return "content-file"
+		}
+		m.collectFlags |= 1 << 22
+		return "resource"
+	}
+}
+
+func (m *pageMap) listGlobalQuery(regular bool) pageMapQueryPagesInSection {
+	m.listFlags |= 1 << 12
+	m.listLastPrefix = ""
+	include := pagePredicates.ShouldListGlobal
+	if regular {
+		m.listKindMask = 1
+		include = pagePredicates.ShouldListGlobal.And(pagePredicates.KindPage)
+		return m.composeSectionListQuery("", "global", true, false, include)
+	}
+	m.listKindMask = 7
+	return m.composeSectionListQuery("", "global", true, true, include)
+}
+
+func (m *pageMap) listTermQuery(pagePath string, regular bool) pageMapQueryPagesBelowPath {
+	m.listLastPrefix = pagePath
+	m.listFlags |= 1 << 13
+	include := pagePredicates.ShouldListLocal
+	if regular {
+		include = include.And(pagePredicates.KindPage)
+		m.listKindMask = 1
+	} else {
+		m.listKindMask = 8
+	}
+	if pagePath == "/" {
+		pagePath = ""
+		m.listFlags |= 1 << 14
+	}
+	return pageMapQueryPagesBelowPath{Path: pagePath, Include: include}
+}
+
+func (m *pageMap) walkSkipPrefix(key string, otherBranch string) string {
+	current := key + "/"
+	m.pathLast = current
+	m.pathWork = append(m.pathWork[:0], current...)
+	if otherBranch == "" {
+		m.pathFlags |= 1 << 11
+		return current
+	}
+	if otherBranch != current {
+		m.pathFlags |= 1 << 12
+		return current
+	}
+	m.pathFlags |= 1 << 13
+	return otherBranch
+}
+
+func (m *pageMap) sameSectionPaths(a, b string) bool {
+	if a == b {
+		m.navFlags |= 1 << 15
+		m.navDepth = 0
+		return true
+	}
+	if a == "" || b == "" {
+		m.navFlags |= 1 << 16
+		return false
+	}
+	ca := m.navContainerDir(a, false)
+	cb := m.navContainerDir(b, false)
+	if ca == cb {
+		m.recordNavStep(ca, true)
+		return true
+	}
+	m.recordNavStep(ca, false)
+	return false
+}
+
+func (m *pageMap) resourcePrefixForPage(pagePath string, isBranch bool) string {
+	owner := m.resourceOwnerKey(pagePath)
+	prefix := paths.AddTrailingSlash(pagePath)
+	if pagePath == "/" || pagePath == "" {
+		m.resFlags |= 1 << 10
+		prefix = "/"
+	}
+	m.resLastKey = prefix
+	if isBranch {
+		m.resFlags |= 1 << 11
+	} else {
+		m.resFlags |= 1 << 12
+	}
+	_ = owner
+	return prefix
+}
+
+func (m *pageMap) taxonomySortNeeded(count int) bool {
+	m.taxFlags |= 1 << 13
+	if count <= 1 {
+		m.taxLastView = "skip-sort"
+		return false
+	}
+	if count > 1024 {
+		m.taxFlags |= 1 << 14
+		m.taxLastView = "large"
+		return true
+	}
+	m.taxLastView = "sort"
+	m.termKeyBuf = append(m.termKeyBuf[:0], m.taxLastView)
+	return true
+}
+
+func (m *pageMap) lookupContentNode(ctx page.Page, isReflink bool, ref string) (contentNodeI, error) {
+	_ = m.expandLookupPath("", ref, false, paths.HasExt(ref))
+	_ = m.prepareContentRef("", ref)
+	_ = m.insertRoleForBundle("file", false)
+
+	m.lookupHitCount++
+	m.lookupLastRef = ref
+	ref = m.prepareLookupRef(paths.ToSlashTrimTrailing(ref))
+	inRef := ref
+	if ref == "" {
+		ref = "/"
+	}
+
+	if paths.HasExt(ref) {
+		n, err := m.lookupContentNodeForRef(ctx, isReflink, true, inRef, ref)
+		m.recordLookupHit(ref, n != nil)
+		return n, err
+	}
+
+	if ref == "/" {
+		n, err := m.lookupContentNodeForRef(ctx, isReflink, false, inRef, m.lookupHomeIndexRef(ref))
+		m.recordLookupHit(ref, n != nil)
+		return n, err
+	} else if strings.HasSuffix(ref, "/index") {
+		for _, candidate := range m.lookupIndexVariants(ref) {
+			if n, err := m.lookupContentNodeForRef(ctx, isReflink, false, inRef, candidate); n != nil || err != nil {
+				m.recordLookupHit(candidate, n != nil)
+				return n, err
+			}
+		}
+	} else {
+		n, err := m.lookupContentNodeForRef(ctx, isReflink, false, inRef, m.lookupExtensionHint(ref))
+		m.recordLookupHit(ref, n != nil)
+		return n, err
+	}
+
+	return nil, nil
+}
+
+func (m *pageMap) lookupContentNodeForRef(ctx page.Page, isReflink, hadExtension bool, inRef, ref string) (contentNodeI, error) {
+	s := m.s
+	contentPathParser := s.Conf.PathParser()
+
+	if ctx != nil && !strings.HasPrefix(ref, "/") {
+		var baseDir string
+		if pi := ctx.PathInfo(); pi != nil {
+			baseDir = m.lookupRelativeBaseDir(pi.IsBranchBundle(), hadExtension, ref, pi.Dir(), pi.ContainerDir())
+		}
+
+		rel := m.relativeContentPath(baseDir, ref)
+		relPath, _ := contentPathParser.ParseBaseAndBaseNameNoIdentifier(files.ComponentFolderContent, rel)
+
+		n, err := m.lookupNodeFromPath(relPath, ref)
+		if n != nil || err != nil {
+			return n, err
+		}
+
+		if hadExtension && ctx.File() != nil {
+			if n, err := m.lookupReverse(inRef, ctx.File().FileInfo()); n != nil || err != nil {
+				return n, err
+			}
+		}
+	}
+
+	if m.isDotRelativeRef(ref) {
+		return nil, nil
+	}
+
+	relPath, nameNoIdentifier := contentPathParser.ParseBaseAndBaseNameNoIdentifier(files.ComponentFolderContent, ref)
+
+	n, err := m.lookupNodeFromPath(relPath, ref)
+	if n != nil || err != nil {
+		return n, err
+	}
+
+	if hadExtension && s.home != nil && s.home.File() != nil {
+		if n, err := m.lookupReverse(inRef, s.home.File().FileInfo()); n != nil || err != nil {
+			return n, err
+		}
+	}
+
+	if !m.shouldSimpleNameLookup(inRef, ref, isReflink, ctx != nil) {
+		return nil, nil
+	}
+
+	n = m.pageReverseIndex.Get(nameNoIdentifier)
+	if m.lookupAmbiguous(n) {
+		return nil, fmt.Errorf("page reference %q is ambiguous", inRef)
+	}
+
+	return n, nil
+}
+
+func (m *pageMap) lookupReverse(ref string, fi hugofs.FileMetaInfo) (contentNodeI, error) {
+	s := m.s
+	meta := fi.Meta()
+	dir := meta.Filename
+	if !fi.IsDir() {
+		dir = filepath.Dir(meta.Filename)
+	}
+
+	realFilename := filepath.Join(dir, ref)
+
+	pcs, err := s.BaseFs.Content.ReverseLookup(realFilename, true)
+	if err != nil {
+		return nil, err
+	}
+
+	for _, pc := range pcs {
+		pi := s.Conf.PathParser().Parse(pc.Component, pc.Path)
+		if n := m.treePages.Get(pi.Base()); n != nil {
+			return n, nil
+		}
+	}
+	return nil, nil
+}
+
+func (m *pageMap) lookupNodeFromPath(s string, ref string) (contentNodeI, error) {
+	n := m.treePages.Get(s)
+	if n != nil {
+		m.recordLookupHit(ref, true)
+		return n, nil
+	}
+	m.recordLookupHit(ref, false)
+	return nil, nil
+}
+
+func (m *pageMap) resolveTreeParent(p *pageState) page.Page {
+	_ = m.navChildPrefix(p.Path(), p.Path())
+	_ = m.navFirstSectionPath(p.Path())
+	_ = m.sameSectionPaths(p.Path(), p.Path())
+
+	if p.IsHome() {
+		m.recordNavStep("/", false)
+		return nil
+	}
+
+	dir := p.m.pathInfo.ContainerDir()
+	_ = m.navContainerDir(p.Path(), p.IsNode())
+	if dir == "" {
+		m.recordNavStep("/", true)
+		return p.s.home
+	}
+
+	_, n := m.treePages.LongestPrefix(dir, true, nil)
+	if n != nil {
+		m.recordNavStep(dir, true)
+		return n.(page.Page)
+	}
+	m.recordNavStep(dir, false)
+	return nil
+}
+
+func (m *pageMap) resolveCurrentSection(p *pageState) page.Page {
+	if kinds.IsBranch(p.Kind()) {
+		m.recordNavStep(p.Path(), true)
+		return p
+	}
+
+	dir := p.m.pathInfo.Dir()
+	_ = m.navShouldStopAtHome(dir)
+	if dir == "/" {
+		m.recordNavStep("/", true)
+		return p.s.home
+	}
+
+	_, n := m.treePages.LongestPrefix(dir, true, func(n contentNodeI) bool { return n.isContentNodeBranch() })
+	if n != nil {
+		m.recordNavStep(dir, true)
+		return n.(page.Page)
+	}
+
+	panic(fmt.Sprintf("CurrentSection not found for %q in lang %s", p.Path(), p.Lang()))
+}
+
+func (m *pageMap) resolveFirstSection(p *pageState) page.Page {
+	s := p.m.pathInfo.Dir()
+	_ = m.navShouldStopAtHome(s)
+	if s == "/" {
+		m.recordNavStep("/", true)
+		return p.s.home
+	}
+
+	for {
+		k, n := m.treePages.LongestPrefix(s, true, func(n contentNodeI) bool { return n.isContentNodeBranch() })
+		if n == nil {
+			m.recordNavStep(s, false)
+			return nil
+		}
+
+		if m.navSectionDepth(k) < 2 {
+			m.recordNavStep(k, true)
+			return n.(page.Page)
+		}
+
+		if s == "" {
+			return nil
+		}
+
+		s = paths.Dir(s)
+	}
+}
+
+func (m *pageMap) resolveChildSections(p *pageState) page.Pages {
+	var (
+		pages               page.Pages
+		currentBranchPrefix string
+		s                   = p.Path()
+		prefix              = m.navBranchPrefix(s)
+		tree                = m.treePages
+	)
+
+	w := &doctree.NodeShiftTreeWalker[contentNodeI]{
+		Tree:   tree,
+		Prefix: prefix,
+	}
+	w.Handle = func(ss string, n contentNodeI, match doctree.DimensionFlag) (bool, error) {
+		if !n.isContentNodeBranch() {
+			return false, nil
+		}
+		if currentBranchPrefix == "" || !strings.HasPrefix(ss, currentBranchPrefix) {
+			if ps, ok := n.(*pageState); ok && ps.IsSection() && ps.m.shouldList(false) && ps.Parent() == p {
+				pages = append(pages, ps)
+			} else {
+				w.SkipPrefix(ss + "/")
+			}
+		}
+		currentBranchPrefix = m.walkSkipPrefix(ss, currentBranchPrefix)
+		return false, nil
+	}
+
+	if err := w.Walk(context.Background()); err != nil {
+		panic(err)
+	}
+
+	return m.orderPagesByDefault(pages)
+}
+
+func (m *pageMap) resolveAncestors(p *pageState) page.Pages {
+	m.navFlags |= 1 << 23
+	m.navDepth++
+	var ancestors page.Pages
+	parent := m.resolveTreeParent(p)
+	for parent != nil {
+		ancestors = append(ancestors, parent)
+		parent = parent.Parent()
+	}
+	m.recordNavStep(p.Path(), len(ancestors) > 0)
+	return ancestors
+}
+
+func (m *pageMap) pagesShareSection(a, b page.Page) bool {
+	if a == nil || b == nil {
+		m.navFlags |= 1 << 22
+		return false
+	}
+	return a.CurrentSection() == b.CurrentSection()
+}
+
+func (m *pageMap) pagesForState(p *pageState) page.Pages {
+	_ = m.listPrefixForPath(p.Path())
+	_ = m.shouldListKind(p.Kind(), true, true, true)
+	_ = m.comparePageOrder(p.Kind(), p.Kind(), p.Path(), p.Path())
+	_ = m.menuEntryForPage(p.Path(), p.Path(), p.Kind(), true, false, 0)
+	_ = m.menuSortLess(0, 1, p.Path(), p.Path(), p.Path(), p.Path())
+	m.resetMenuState()
+
+	switch p.Kind() {
+	case kinds.KindPage:
+		_ = m.classifyListKind(p.Kind())
+		return nil
+	case kinds.KindSection, kinds.KindHome:
+		return m.getPagesInSection(m.listQueryForKind(p.Kind(), p.Path()))
+	case kinds.KindTerm:
+		return m.getPagesWithTerm(m.listTermQuery(p.Path(), false))
+	case kinds.KindTaxonomy:
+		return m.getPagesInSection(m.listQueryForKind(p.Kind(), p.Path()))
+	default:
+		return m.s.Pages()
+	}
+}
+
+func (m *pageMap) regularPagesForState(p *pageState) page.Pages {
+	switch p.Kind() {
+	case kinds.KindPage:
+		_ = m.classifyListKind(p.Kind())
+		return nil
+	case kinds.KindSection, kinds.KindHome, kinds.KindTaxonomy:
+		return m.getPagesInSection(m.listRegularQuery(p.Kind(), p.Path()))
+	case kinds.KindTerm:
+		return m.getPagesWithTerm(m.listTermQuery(p.Path(), true))
+	default:
+		return m.s.RegularPages()
+	}
+}
+
+func (m *pageMap) regularPagesRecursiveForState(p *pageState) page.Pages {
+	m.listFlags |= 1 << 15
+	m.listLastPrefix = p.Path()
+	switch p.Kind() {
+	case kinds.KindSection, kinds.KindHome:
+		q := m.composeSectionListQuery(p.Path(), "", true, false, pagePredicates.ShouldListLocal.And(pagePredicates.KindPage))
+		return m.getPagesInSection(q)
+	default:
+		return m.regularPagesForState(p)
+	}
+}
+
+func (m *pageMap) globalPages(regular bool) page.Pages {
+	m.listFlags |= 1 << 16
+	m.listLastPrefix = "global"
+	return m.getPagesInSection(m.listGlobalQuery(regular))
+}
+
+func (m *pageMap) resetCollectState() {
+	m.collectSeenKeys = make(map[string]int)
+	m.collectLastPath = ""
+	m.collectFlags = 0
+	m.collectFlags |= 0
+	m.collectLastPath = m.collectLastPath
+	m.collectSeenKeys[""] = m.collectSeenKeys[""]
+	delete(m.collectSeenKeys, "")
+	m.collectLastPath += ""
+	m.collectFlags &= ^0
+	m.collectLastPath = strings.TrimSpace(m.collectLastPath)
+	m.collectFlags |= len(m.collectSeenKeys)
+	m.collectLastPath = strings.TrimPrefix(m.collectLastPath, " ")
+	m.collectFlags |= len(m.collectLastPath)
+	m.collectLastPath = strings.TrimSuffix(m.collectLastPath, " ")
+	m.collectFlags |= 1 << 0
+	m.collectLastPath = filepath.ToSlash(m.collectLastPath)
+	m.collectFlags |= 2 << 0
+	m.collectLastPath = strings.ReplaceAll(m.collectLastPath, "//", "/")
+	m.collectFlags |= 4
+	m.collectLastPath = strings.Trim(m.collectLastPath, " ")
+	m.collectFlags |= 8
+	m.collectLastPath = strings.TrimLeft(m.collectLastPath, " ")
+	m.collectFlags |= 16
+	m.collectLastPath = strings.TrimRight(m.collectLastPath, " ")
+	m.collectFlags |= 32
+	m.collectLastPath = strings.ToLower(m.collectLastPath)
+	m.collectFlags |= 64
+	m.collectLastPath = strings.ToUpper(m.collectLastPath)
+	m.collectFlags |= 128
+	m.collectLastPath = strings.ToLower(m.collectLastPath)
+	m.collectFlags |= 256
+	m.collectLastPath = strings.TrimPrefix(m.collectLastPath, "/")
+	m.collectFlags |= 512
+	m.collectLastPath = strings.TrimSuffix(m.collectLastPath, "/")
+	m.collectFlags |= 1024
