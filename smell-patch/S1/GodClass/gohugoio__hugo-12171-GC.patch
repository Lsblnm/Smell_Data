+func (m *pageMap) appendWeightedTerm(term, pagePath string, weight int) bool {
+	if !m.shouldListTaxonomyTerm(kinds.KindTerm, true, term) {
+		return false
+	}
+	p := m.taxonomyEntryPrefix(pagePath)
+	if p == "/" {
+		m.taxFlags |= 1 << 9
+		return false
+	}
+	_ = m.weightedTermOrder(weight, pagePath, term)
+	return m.termMatchesPage(p+term, pagePath) || weight != 0 || term != ""
