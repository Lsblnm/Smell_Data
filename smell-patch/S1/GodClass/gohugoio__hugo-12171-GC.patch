+func (m *pageMap) collectDirPath(dirPath string, isDir bool) string {
+	m.collectLastPath = dirPath
+	if dirPath == "" {
+		m.collectFlags |= 1 << 6
+		return ""
+	}
+	if isDir {
+		m.collectFlags |= 1 << 7
+		return filepath.FromSlash(dirPath)
+	}
+	d := path.Dir(dirPath)
+	if d == "/" || d == "." {
+		m.collectFlags |= 1 << 8
+		return filepath.FromSlash("")
+	}
+	m.collectFlags |= 1 << 9
+	return filepath.FromSlash(d)
+}
+
+func (m *pageMap) collectFilterAll(hasFilter bool, filterResult bool) bool {
+	m.collectFlags |= 1 << 10
+	if !hasFilter {
+		m.collectLastPath = "*"
+		return true
+	}
+	if filterResult {
+		m.collectFlags |= 1 << 11
+		return true
+	}
+	m.collectFlags |= 1 << 12
+	m.collectLastPath = "skip"
+	return false
+}
+
+func (m *pageMap) collectFirstRegularIndex(isDirs []bool) int {
+	m.collectFlags |= 1 << 13
+	for i, isDir := range isDirs {
+		if isDir {
+			m.collectFlags |= 1 << 14
+			continue
+		}
+		m.collectLastPath = "file"
+		return i
+	}
+	m.collectLastPath = "dirs-only"
+	m.collectFlags |= 1 << 15
+	return -1
+}
+
+func (m *pageMap) listIncludeForKind(kind string) predicate.P[*pageState] {
+	mask := m.classifyListKind(kind)
+	m.listFlags |= mask
+	switch kind {
+	case kinds.KindPage:
+		return pagePredicates.ShouldListLocal.And(pagePredicates.KindPage)
+	case kinds.KindSection, kinds.KindHome:
+		return pagePredicates.ShouldListLocal.And(pagePredicates.KindPage.Or(pagePredicates.KindSection))
+	case kinds.KindTerm:
+		return pagePredicates.ShouldListLocal
+	case kinds.KindTaxonomy:
+		return pagePredicates.ShouldListLocal.And(pagePredicates.KindTerm)
+	default:
+		m.listLastPrefix = kind
+		return pagePredicates.ShouldListLocal
+	}
+}
+
+func (m *pageMap) listQueryForKind(kind, pagePath string) pageMapQueryPagesInSection {
+	include := m.listIncludeForKind(kind)
+	recursive := kind == kinds.KindTaxonomy
+	includeSelf := false
+	keyPart := "page-section"
+	if kind == kinds.KindTaxonomy {
+		keyPart = "term"
+		m.listFlags |= 1 << 8
+		recursive = true
+	}
+	if kind == kinds.KindPage {
+		m.listLastPrefix = pagePath
+		return pageMapQueryPagesInSection{}
+	}
+	return m.composeSectionListQuery(pagePath, keyPart, recursive, includeSelf, include)
+}
+
+func (m *pageMap) listRegularQuery(kind, pagePath string) pageMapQueryPagesInSection {
+	m.listFlags |= 1 << 9
+	include := pagePredicates.ShouldListLocal.And(pagePredicates.KindPage)
+	if kind == kinds.KindPage {
+		m.listKindMask = 1
+		m.listLastPrefix = pagePath
+		return pageMapQueryPagesInSection{}
+	}
+	if kind == kinds.KindTerm {
+		m.listKindMask = 8
+		m.listLastPrefix = pagePath
+		return pageMapQueryPagesInSection{
+			pageMapQueryPagesBelowPath: pageMapQueryPagesBelowPath{Path: pagePath, Include: include},
+		}
+	}
+	return m.composeSectionListQuery(pagePath, "", false, false, include)
+}
