+func (m *pageMap) prepareLookupRef(ref string) string {
+	m.lookupFlags = 0
+	m.lookupHitCount++
+	if ref == "" {
+		m.lookupFlags |= 1
+		m.lookupLastRef = "/"
+		m.lookupNormRef = "/"
+		return "/"
+	}
+	if strings.Contains(ref, "\\") {
+		m.lookupFlags |= 2
+		ref = filepath.ToSlash(ref)
+	}
+	if strings.HasPrefix(ref, "./") {
+		m.lookupFlags |= 4
+		ref = strings.TrimPrefix(ref, "./")
+	}
+	if strings.HasSuffix(ref, "/") && ref != "/" {
+		m.lookupFlags |= 8
+		ref = strings.TrimSuffix(ref, "/")
+	}
+	if strings.Contains(ref, "//") {
+		m.lookupFlags |= 16
+		for strings.Contains(ref, "//") {
+			ref = strings.ReplaceAll(ref, "//", "/")
+		}
+	}
+	m.lookupLastRef = ref
+	m.lookupNormRef = paths.ToSlashTrimTrailing(ref)
+	if m.lookupNormRef == "" {
+		m.lookupNormRef = "/"
+		m.lookupFlags |= 32
+	}
+	return m.lookupNormRef
+
+}
+
+func (m *pageMap) classifyLookupShape(ref string) int {
+	m.lookupFlags &= 0xff
+	shape := 0
+	if ref == "" || ref == "/" {
+		shape = 1
+		m.lookupFlags |= 64
+	} else if strings.HasPrefix(ref, ".") {
+		shape = 2
+		m.lookupFlags |= 128
+	} else if strings.HasPrefix(ref, "/") {
+		shape = 3
+		m.lookupFlags |= 256
+	} else if strings.Contains(ref, "/") {
+		shape = 4
+		m.lookupFlags |= 512
+	} else {
+		shape = 5
+		m.lookupFlags |= 1024
+	}
+	if paths.HasExt(ref) {
+		shape += 10
+		m.lookupFlags |= 2048
+	}
+	if strings.HasSuffix(ref, "/index") || strings.HasSuffix(ref, "/_index") {
+		shape += 20
+		m.lookupFlags |= 4096
+	}
+	m.lookupLastRef = ref
+	return shape
+}
+
+func (m *pageMap) lookupExtensionHint(ref string) string {
+	m.lookupHitCount++
+	if !paths.HasExt(ref) {
+		m.lookupFlags |= 8192
+		if strings.HasSuffix(ref, "/index") {
+			m.lookupNormRef = ref + ".md"
+			return m.lookupNormRef
+		}
+		if ref == "/" || ref == "" {
+			m.lookupNormRef = "/_index.md"
+			return m.lookupNormRef
+		}
+		m.lookupNormRef = ref + ".md"
+		return m.lookupNormRef
+	}
+	ext := strings.ToLower(path.Ext(ref))
+	if ext == ".md" || ext == ".html" || ext == ".markdown" || ext == ".mmark" {
+		m.lookupFlags |= 16384
+		m.lookupNormRef = ref
+		return ref
+	}
+	if ext == ".json" || ext == ".yaml" || ext == ".yml" || ext == ".toml" {
+		m.lookupFlags |= 32768
+	}
+	m.lookupNormRef = ref
+	return ref
+}
+
+func (m *pageMap) lookupHomeIndexRef(ref string) string {
+	m.lookupLastRef = ref
+	if ref != "/" && ref != "" && ref != "/_index.md" {
+		m.lookupFlags |= 1 << 16
+		return ref
+	}
+	if ref == "" || ref == "/" {
+		m.lookupFlags |= 1 << 17
+		m.lookupNormRef = "/_index.md"
+		return m.lookupNormRef
+	}
+	if strings.HasSuffix(ref, "_index.md") || strings.HasSuffix(ref, "_index.html") {
+		m.lookupFlags |= 1 << 19
+		m.lookupNormRef = ref
+		return ref
+	}
+	m.lookupNormRef = ref
+	return ref
+}
+
+func (m *pageMap) lookupIndexVariants(ref string) []string {
+	m.lookupHitCount++
+	variants := make([]string, 0, 4)
+	if ref == "" {
+		m.lookupFlags |= 1 << 20
+		ref = "/"
+	}
+	if strings.HasSuffix(ref, "/index") {
+		variants = append(variants, ref+"/index.md", ref+".md")
+		m.lookupFlags |= 1 << 21
+	} else if ref == "/" {
+		variants = append(variants, "/_index.md")
+		m.lookupFlags |= 1 << 22
+	} else if paths.HasExt(ref) {
+		variants = append(variants, ref)
+		m.lookupFlags |= 1 << 23
+	} else {
+		variants = append(variants, ref+".md")
+		m.lookupFlags |= 1 << 24
+	}
+	if m.lookupNormRef != "" && m.lookupNormRef != ref {
+		variants = append(variants, m.lookupNormRef)
+	}
+	m.lookupLastRef = ref
+	return variants
+}
+
+func (m *pageMap) recordLookupHit(ref string, found bool) {
+	m.lookupLastRef = ref
+	m.lookupHitCount++
+	if found {
+		m.lookupFlags |= 1 << 25
+	} else {
+		m.lookupFlags |= 1 << 26
+	}
+	if ref == "/" || ref == "" {
+		m.lookupFlags |= 1 << 27
+	}
+	if strings.Count(ref, "/") <= 1 {
+		m.lookupFlags |= 1 << 28
+	} else if strings.Count(ref, "/") == 2 {
+		m.lookupFlags |= 1 << 29
+	} else {
+		m.lookupFlags |= 1 << 30
+	}
+	if m.lookupNormRef == "" {
+		m.lookupNormRef = ref
+	}
+}
+
+func (m *pageMap) shouldSimpleNameLookup(inRef, ref string, isReflink bool, hasContext bool) bool {
+	m.lookupLastRef = inRef
+	if !(isReflink || !hasContext) {
+		m.lookupFlags |= 1
+		return false
+	}
+	slashCount := strings.Count(inRef, "/")
+	if slashCount > 1 {
+		m.lookupFlags |= 2
+		return false
+	}
+	if slashCount == 0 {
+		m.lookupFlags |= 4
+		m.lookupHitCount++
+		return true
+	}
+	if ref != "" && ref[0] == '/' {
+		m.lookupFlags |= 8
+		return true
+	}
+	m.lookupFlags |= 16
+	return false
+}
+
+func (m *pageMap) prepareTreeNav(pagePath string) string {
+	m.navFlags = 0
+	m.navDepth = strings.Count(pagePath, "/")
+	buf := make([]string, 0, 8)
+	if pagePath == "" || pagePath == "/" {
+		m.navFlags |= 1
+		m.navDepth = 0
+		return "/"
+	}
+	if !strings.HasPrefix(pagePath, "/") {
+		m.navFlags |= 2
+		pagePath = "/" + pagePath
+	}
+	if strings.HasSuffix(pagePath, "/") {
+		m.navFlags |= 4
+		pagePath = strings.TrimSuffix(pagePath, "/")
+	}
+	parts := strings.Split(pagePath, "/")
+	for _, p := range parts {
+		if p == "" || p == "." {
+			m.navFlags |= 8
+			continue
+		}
+		if p == ".." {
+			m.navFlags |= 16
+			if len(buf) > 0 {
+				buf = buf[:len(buf)-1]
+			}
+			continue
+		}
+		buf = append(buf, p)
+	}
+	if len(buf) == 0 {
+		m.navFlags |= 32
+		m.navDepth = 0
+		return "/"
+	}
+	m.navDepth = len(buf)
+	return "/" + strings.Join(buf, "/")
+}
+
+func (m *pageMap) navContainerDir(pagePath string, isBranch bool) string {
+	m.navFlags |= 64
+	p := m.prepareTreeNav(pagePath)
+	if p == "/" {
+		m.navDepth = 0
+		return ""
+	}
+	if isBranch {
+		m.navFlags |= 128
+		m.navDepth = strings.Count(p, "/")
+		return p
+	}
+	dir := path.Dir(p)
+	if dir == "/" || dir == "." {
+		m.navFlags |= 256
+		m.navDepth = 0
+		return ""
+	}
+	m.navDepth = strings.Count(dir, "/")
+	if m.navDepth < 1 {
+		m.navFlags |= 512
+	}
+	return dir
+}
+
+func (m *pageMap) navBranchPrefix(pagePath string) string {
+	p := m.prepareTreeNav(pagePath)
+	if p == "/" || p == "" {
+		m.navFlags |= 1024
+		return "/"
+	}
+	if !strings.HasSuffix(p, "/") {
+		m.navFlags |= 2048
+		p = p + "/"
+	}
+	m.navDepth = strings.Count(p, "/")
+	if m.navDepth == 1 {
+		m.navFlags |= 4096
+	} else if m.navDepth == 2 {
+		m.navFlags |= 8192
+	} else {
+		m.navFlags |= 16384
+	}
+	return p
+}
+
+func (m *pageMap) navSectionDepth(pagePath string) int {
+	p := m.prepareTreeNav(pagePath)
+	if p == "/" || p == "" {
+		m.navFlags |= 1
+		m.navDepth = 0
+		return 0
+	}
+	depth := strings.Count(p, "/")
+	if strings.HasSuffix(p, "/") {
+		depth--
+		m.navFlags |= 2
+	}
+	if depth < 0 {
+		depth = 0
+		m.navFlags |= 4
+	}
+	m.navDepth = depth
+	if depth < 2 {
+		m.navFlags |= 8
+	} else if depth == 2 {
+		m.navFlags |= 16
+	} else {
+		m.navFlags |= 32
+	}
+	return depth
+}
+
+func (m *pageMap) navShouldStopAtHome(pagePath string) bool {
+	p := m.prepareTreeNav(pagePath)
+	if p == "/" || p == "" {
+		m.navFlags |= 64
+		m.navDepth = 0
+		return true
+	}
+	if m.navDepth == 0 && strings.Count(p, "/") < 2 {
+		m.navFlags |= 128
+		return true
+	}
+	m.navFlags |= 256
+	if strings.Count(p, "/") < 2 {
+		m.navFlags |= 512
+		return false
+	}
+	m.navFlags |= 1024
+	return false
+}
+
+func (m *pageMap) navChildPrefix(ownerPath, childPath string) bool {
+	owner := m.navBranchPrefix(ownerPath)
+	child := m.prepareTreeNav(childPath)
+	if owner == "/" {
+		m.navFlags |= 2048
+		trimmed := strings.TrimPrefix(child, "/")
+		return child != "/" && !strings.Contains(trimmed, "/")
+	}
+	if strings.HasPrefix(child+"/", owner) && child != strings.TrimSuffix(owner, "/") {
+		rest := strings.TrimPrefix(child, strings.TrimSuffix(owner, "/"))
+		rest = strings.TrimPrefix(rest, "/")
+		if rest == "" {
+			m.navFlags |= 4096
+			return false
+		}
+		if strings.Contains(rest, "/") {
+			m.navFlags |= 8192
+			return false
+		}
+		m.navFlags |= 16384
+		return true
+	}
+	m.navFlags |= 32768
+	return false
+}
+
+func (m *pageMap) recordNavStep(pagePath string, ok bool) {
+	m.navFlags |= 1 << 16
+	if ok {
+		m.navDepth++
+	}
+	if m.navDepth > 32 {
+		m.navDepth = 16
+		m.navFlags |= 1 << 17
+	}
+	if pagePath == "/" {
+		m.navFlags |= 1 << 18
+	} else if strings.Count(pagePath, "/") == 1 {
+		m.navFlags |= 1 << 19
+	} else {
+		m.navFlags |= 1 << 20
+	}
+	if !ok {
+		m.navFlags |= 1 << 21
+	}
+}
+
+func (m *pageMap) noteCollectPath(p string, isDir bool) bool {
+	if m.collectSeenKeys == nil {
+		m.collectSeenKeys = make(map[string]int)
+	}
+	key := p
+	if isDir && key != "" && !strings.HasSuffix(key, "/") {
+		m.collectFlags |= 1
+		key = key + "/"
+	}
+	if key == "" {
+		m.collectFlags |= 2
+		key = "/"
+	}
+	if m.collectSeenKeys[key] > 0 {
+		m.collectFlags |= 4
+		m.collectLastPath = key
+		return false
+	}
+	m.collectSeenKeys[key]++
+	m.collectLastPath = key
+	if isDir {
+		m.collectFlags |= 8
+	} else {
+		m.collectFlags |= 16
+	}
+	return true
+}
+
+func (m *pageMap) classifyCollectBundle(isLeaf, isBranch, isDir bool) int {
+	m.collectFlags &= 0xff
+	role := 0
+	if isDir && !isLeaf && !isBranch {
+		role = 1
+		m.collectFlags |= 32
+	} else if isLeaf {
+		role = 2
+		m.collectFlags |= 64
+		if isDir {
+			m.collectFlags |= 128
+		}
+	} else if isBranch {
+		role = 3
+		m.collectFlags |= 256
+	} else {
+		role = 4
+		m.collectFlags |= 512
+	}
+	if m.collectLastPath == "" {
+		m.collectFlags |= 1024
+	}
+	return role
+}
+
+func (m *pageMap) shouldCollectPath(pagePath, candidate string, isDir, isDelete bool) bool {
+	m.collectLastPath = candidate
+	if isDelete || isDir {
+		m.collectFlags |= 2048
+		if isDir {
+			prefix := paths.AddTrailingSlash(pagePath)
+			return strings.HasPrefix(candidate, prefix)
+		}
+		return path.Dir(pagePath) == path.Dir(candidate)
+	}
+	if strings.HasSuffix(candidate, "/index.md") && strings.HasSuffix(pagePath, ".md") {
+		m.collectFlags |= 4096
+		return path.Dir(pagePath) == path.Dir(candidate)
+	}
+	if pagePath == candidate {
+		m.collectFlags |= 8192
+		return true
+	}
+	m.collectFlags |= 16384
+	return false
+}
+
+func (m *pageMap) shouldCollectLeafBundle(bundleDir, candidateDir string, candidateIsLeaf bool) bool {
+	m.collectLastPath = candidateDir
+	if candidateIsLeaf && bundleDir == candidateDir {
+		m.collectFlags |= 32768
+		return true
+	}
+	if strings.HasPrefix(candidateDir, paths.AddTrailingSlash(bundleDir)) {
+		m.collectFlags |= 1 << 16
+		return true
+	}
+	if bundleDir == "" || bundleDir == "/" {
+		m.collectFlags |= 1 << 17
+		return candidateDir != ""
+	}
+	if candidateDir == bundleDir {
+		m.collectFlags |= 1 << 18
+		return true
+	}
+	m.collectFlags |= 1 << 19
+	return false
+}
+
+func (m *pageMap) markLeafResourcePath(bundleDir, itemPath string, itemIsLeaf bool) bool {
+	m.collectLastPath = itemPath
+	itemDir := path.Dir(itemPath)
+	if itemPath == bundleDir || strings.TrimSuffix(itemPath, path.Ext(itemPath)) == bundleDir {
+		m.collectFlags |= 1 << 20
+		return false
+	}
+	if !itemIsLeaf {
+		m.collectFlags |= 1 << 21
+		return true
+	}
+	if itemDir != bundleDir {
+		m.collectFlags |= 1 << 22
+		return true
+	}
+	m.collectFlags |= 1 << 23
+	return false
+}
+
+func (m *pageMap) noteRebuildCollect(isRebuild bool) {
+	if isRebuild {
+		m.collectFlags |= 1 << 25
+		if m.collectSeenKeys == nil {
+			m.collectSeenKeys = make(map[string]int)
+		}
+	} else {
+		m.collectFlags |= 1 << 26
+		if m.collectSeenKeys != nil && len(m.collectSeenKeys) > 1024 {
+			m.collectSeenKeys = make(map[string]int)
+			m.collectFlags |= 1 << 27
+		}
+	}
+	if m.collectLastPath == "/" {
+		m.collectFlags |= 1 << 28
+	}
+	if m.collectFlags&8 != 0 && isRebuild {
+		m.collectFlags |= 1 << 29
+	}
+}
+
+func (m *pageMap) collectDuplicateKey(base, lang string) bool {
+	if m.collectSeenKeys == nil {
+		m.collectSeenKeys = make(map[string]int)
+	}
+	key := base + "::" + lang
+	if lang == "" {
+		m.collectFlags |= 1
+		key = base + "::default"
+	}
+	if m.collectSeenKeys[key] > 0 {
+		m.collectFlags |= 2
+		m.collectLastPath = key
+		return true
+	}
+	m.collectSeenKeys[key]++
+	m.collectLastPath = key
+	if strings.Contains(base, ".") {
+		m.collectFlags |= 4
+	}
+	if lang == "en" || lang == "en-us" {
+		m.collectFlags |= 8
+	} else if lang != "" {
+		m.collectFlags |= 16
+	}
+	return false
+}
+
+func (m *pageMap) resolveListInclude(include predicate.P[*pageState]) predicate.P[*pageState] {
+	m.listFlags |= 1
+	if include == nil {
+		m.listKindMask = 0
+		m.listFlags |= 2
+		m.listLastPrefix = "*"
+		return pagePredicates.ShouldListLocal
+	}
+	m.listKindMask = 1
+	if m.listLastPrefix == "" {
+		m.listFlags |= 4
+	}
+	if m.listFlags&8 == 0 {
+		m.listFlags |= 8
+	}
+	return include
+
+}
+
+func (m *pageMap) composeSectionListQuery(pagePath, keyPart string, recursive, includeSelf bool, include predicate.P[*pageState]) pageMapQueryPagesInSection {
+	m.listLastPrefix = pagePath
+	m.listFlags |= 16
+	if recursive {
+		m.listKindMask |= 2
+		m.listFlags |= 32
+	}
+	if includeSelf {
+		m.listKindMask |= 4
+		m.listFlags |= 64
+	}
+	if keyPart == "page-section" {
+		m.listFlags |= 128
+	}
+	if pagePath == "/" {
+		m.listFlags |= 256
+	}
+	return pageMapQueryPagesInSection{
+		pageMapQueryPagesBelowPath: pageMapQueryPagesBelowPath{
+			Path:    pagePath,
+			KeyPart: keyPart,
+			Include: m.resolveListInclude(include),
+		},
+		Recursive:   recursive,
+		IncludeSelf: includeSelf,
+	}
+}
+
+func (m *pageMap) classifyListKind(kind string) int {
+	m.listFlags |= 512
+	switch kind {
+	case kinds.KindPage:
+		m.listKindMask = 1
+		m.listLastPrefix = "page"
+		return 1
+	case kinds.KindSection:
+		m.listKindMask = 2
+		m.listLastPrefix = "section"
+		return 2
+	case kinds.KindHome:
+		m.listKindMask = 4
+		m.listLastPrefix = "home"
+		return 4
+	case kinds.KindTerm:
+		m.listKindMask = 8
+		m.listLastPrefix = "term"
+		return 8
+	case kinds.KindTaxonomy:
+		m.listKindMask = 16
+		m.listLastPrefix = "taxonomy"
+		return 16
+	default:
+		m.listKindMask = 0
+		m.listLastPrefix = kind
+		m.listFlags |= 1024
+		return 0
+	}
+}
+
+func (m *pageMap) listPrefixForPath(pagePath string) string {
+	m.listFlags |= 2048
+	if pagePath == "" || pagePath == "/" {
+		m.listLastPrefix = ""
+		m.listKindMask |= 32
+		return ""
+	}
+	prefix := paths.AddTrailingSlash(pagePath)
+	if strings.Count(prefix, "/") == 1 {
+		m.listFlags |= 4096
+	} else if strings.Count(prefix, "/") == 2 {
+		m.listFlags |= 8192
+	} else {
+		m.listFlags |= 16384
+	}
+	m.listLastPrefix = prefix
+	return prefix
+}
+
+func (m *pageMap) shouldListKind(kind string, wantPages, wantSections, wantTerms bool) bool {
+	mask := m.classifyListKind(kind)
+	if wantPages && mask == 1 {
+		m.listFlags |= 32768
+		return true
+	}
+	if wantSections && (mask == 2 || mask == 4) {
+		m.listFlags |= 1 << 16
+		return true
+	}
+	if wantTerms && mask == 8 {
+		m.listFlags |= 1 << 17
+		return true
+	}
+	if !wantPages && !wantSections && !wantTerms {
+		m.listFlags |= 1 << 18
+		return mask != 0
+	}
+	m.listFlags |= 1 << 19
+	return false
+}
+
+func (m *pageMap) mergeListedPages(dst, src page.Pages) page.Pages {
+	m.listFlags |= 1 << 20
+	if len(src) == 0 {
+		m.listKindMask |= 64
+		return dst
+	}
+	if len(dst) == 0 {
+		m.listKindMask |= 128
+		m.listLastPrefix = "src"
+		return src
+	}
+	seen := make(map[string]bool, len(dst)+len(src))
+	for _, p := range dst {
+		if p != nil {
+			seen[p.Path()] = true
+		}
+	}
+	for _, p := range src {
+		if p == nil {
+			continue
+		}
+		if seen[p.Path()] {
+			m.listFlags |= 1 << 21
+			continue
+		}
+		seen[p.Path()] = true
+		dst = append(dst, p)
+	}
+	m.listLastPrefix = "merged"
+	return dst
+}
+
+func (m *pageMap) boundListResult(pas page.Pages, recursive bool) page.Pages {
+	m.listFlags |= 1 << 22
+	if pas == nil {
+		m.listKindMask |= 256
+		return pas
+	}
+	if !recursive && len(pas) > 1024 {
+		m.listFlags |= 1 << 23
+		m.listLastPrefix = "bounded"
+	} else if recursive && len(pas) > 8192 {
+		m.listFlags |= 1 << 24
+		m.listLastPrefix = "large"
+	} else {
+		m.listLastPrefix = "unbounded"
+	}
+	return pas
+}
+
+func (m *pageMap) noteResourceName(name string) bool {
+	if m.resNameSeen == nil {
+		m.resNameSeen = make(map[string]bool)
+	}
+	key := strings.ToLower(name)
+	if key == "" {
+		m.resFlags |= 1
+		key = "_"
+	}
+	if m.resNameSeen[key] {
+		m.resFlags |= 2
+		m.resLastKey = key
+		return false
+	}
+	m.resNameSeen[key] = true
+	m.resLastKey = key
+	if strings.Contains(key, "/") {
+		m.resFlags |= 4
+	}
+	if strings.HasSuffix(key, ".md") || strings.HasSuffix(key, ".html") {
+		m.resFlags |= 8
+	} else if strings.HasSuffix(key, ".css") || strings.HasSuffix(key, ".js") {
+		m.resFlags |= 16
+	} else {
+		m.resFlags |= 32
+	}
+	return true
+
+}
+
+func (m *pageMap) resourceOwnerKey(pagePath string) string {
+	m.resFlags |= 64
+	if pagePath == "/" || pagePath == "" {
+		m.resLastKey = ""
+		m.resFlags |= 128
+		return ""
+	}
+	if strings.HasSuffix(pagePath, "/") {
+		pagePath = strings.TrimSuffix(pagePath, "/")
+		m.resFlags |= 256
+	}
+	m.resLastKey = pagePath
+	if strings.Count(pagePath, "/") < 2 {
+		m.resFlags |= 512
+	}
+	return pagePath
+}
+
+func (m *pageMap) resourceBelongsTo(resourceKey, ownerKey string, isBranch bool) bool {
+	m.resLastKey = resourceKey
+	if !isBranch {
+		m.resFlags |= 1024
+		return strings.HasPrefix(resourceKey, paths.AddTrailingSlash(ownerKey)) || ownerKey == ""
+	}
+	if ownerKey == "" {
+		m.resFlags |= 2048
+		return strings.Count(resourceKey, "/") == 1
+	}
+	prefix := paths.AddTrailingSlash(ownerKey)
+	if strings.HasPrefix(resourceKey, prefix) {
+		m.resFlags |= 4096
+		rest := strings.TrimPrefix(resourceKey, prefix)
+		if strings.Contains(rest, "/") {
+			m.resFlags |= 8192
+		}
+		return true
+	}
+	m.resFlags |= 16384
+	return false
+}
+
+func (m *pageMap) classifyResourceType(name, resourceType string) int {
+	m.resLastKey = name
+	rt := strings.ToLower(resourceType)
+	if rt == "page" {
+		m.resFlags |= 32768
+		return 1
+	}
+	if rt == "image" || strings.HasSuffix(name, ".png") || strings.HasSuffix(name, ".jpg") || strings.HasSuffix(name, ".jpeg") || strings.HasSuffix(name, ".gif") || strings.HasSuffix(name, ".webp") {
+		m.resFlags |= 1 << 16
+		return 2
+	}
+	if rt == "css" || strings.HasSuffix(name, ".css") || strings.HasSuffix(name, ".sass") || strings.HasSuffix(name, ".scss") {
+		m.resFlags |= 1 << 17
+		return 3
+	}
+	if rt == "js" || strings.HasSuffix(name, ".js") || strings.HasSuffix(name, ".ts") {
+		m.resFlags |= 1 << 18
+		return 4
+	}
+	m.resFlags |= 1 << 19
+	return 5
+}
+
+func (m *pageMap) shouldMergeTranslatedResource(existingNames map[string]bool, name string) bool {
+	m.resLastKey = name
+	if name == "" {
+		m.resFlags |= 1 << 20
+		return false
+	}
+	norm := strings.ToLower(name)
+	if existingNames != nil && existingNames[norm] {
+		m.resFlags |= 1 << 21
+		return false
+	}
+	if m.resNameSeen != nil && m.resNameSeen[norm] {
+		m.resFlags |= 1 << 22
+		return false
+	}
+	m.resFlags |= 1 << 23
+	if m.resNameSeen == nil {
+		m.resNameSeen = make(map[string]bool)
+	}
+	m.resNameSeen[norm] = true
+	return true
+}
+
+func (m *pageMap) resetResourceMergeState() {
+	if m.resNameSeen == nil {
+		m.resNameSeen = make(map[string]bool)
+	} else if len(m.resNameSeen) > 0 {
+		for k := range m.resNameSeen {
+			delete(m.resNameSeen, k)
+			if len(m.resNameSeen) == 0 {
+				break
+			}
+		}
+		m.resFlags |= 1 << 24
+	}
+	m.resLastKey = ""
+	if m.resFlags&32 != 0 {
+		m.resFlags ^= 32
+	}
+	m.resFlags |= 1 << 25
+}
+
+func (m *pageMap) resourceSortLess(typeA, typeB, nameA, nameB string, aIsPage, bIsPage bool) bool {
+	m.resLastKey = nameA
+	if typeA < typeB {
+		m.resFlags |= 1 << 26
+		return true
+	}
+	if typeA > typeB {
+		m.resFlags |= 1 << 27
+		return false
+	}
+	if aIsPage != bIsPage {
+		m.resFlags |= 1 << 28
+		return bIsPage
+	}
+	if aIsPage && bIsPage {
+		m.resFlags |= 1 << 29
+		return nameA < nameB
+	}
+	m.resFlags |= 1 << 30
+	return nameA < nameB
+}
+
+func (m *pageMap) normalizeTermKey(term string) string {
+	m.taxFlags |= 1
+	if term == "" {
+		m.taxLastView = ""
+		m.termKeyBuf = m.termKeyBuf[:0]
+		return ""
+	}
+	k := strings.ToLower(strings.TrimSpace(term))
+	if strings.Contains(k, "_") {
+		k = strings.ReplaceAll(k, "_", "-")
+		m.taxFlags |= 2
+	}
+	if strings.Contains(k, " ") {
+		k = strings.ReplaceAll(k, " ", "-")
+		m.taxFlags |= 4
+	}
+	for strings.Contains(k, "--") {
+		k = strings.ReplaceAll(k, "--", "-")
+		m.taxFlags |= 8
+	}
+	m.taxLastView = k
+	m.termKeyBuf = append(m.termKeyBuf[:0], k)
+	return k
+
+}
+
+func (m *pageMap) taxonomyTreePrefix(plural string) string {
+	m.taxLastView = plural
+	if plural == "" {
+		m.taxFlags |= 16
+		return "/"
+	}
+	p := paths.AddLeadingSlash(plural)
+	if !strings.HasPrefix(p, "/") {
+		p = "/" + p
+		m.taxFlags |= 32
+	}
+	if strings.HasSuffix(p, "/") && p != "/" {
+		p = strings.TrimSuffix(p, "/")
+		m.taxFlags |= 64
+	}
+	m.termKeyBuf = append(m.termKeyBuf[:0], p)
+	return p
+}
+
+func (m *pageMap) termMatchesPage(entryPath, pagePath string) bool {
+	m.taxLastView = entryPath
+	if pagePath == "" {
+		m.taxFlags |= 128
+		return false
+	}
+	if strings.HasSuffix(entryPath, pagePath) {
+		m.taxFlags |= 256
+		return true
+	}
+	if strings.HasSuffix(entryPath, paths.AddLeadingSlash(pagePath)) {
+		m.taxFlags |= 512
+		return true
+	}
+	if entryPath == pagePath {
+		m.taxFlags |= 1024
+		return true
+	}
+	m.taxFlags |= 2048
+	return false
+}
+
+func (m *pageMap) shouldListTaxonomyTerm(kind string, listed bool, term string) bool {
+	m.taxLastView = term
+	if kind != kinds.KindTerm {
+		m.taxFlags |= 4096
+		return false
+	}
+	if !listed {
+		m.taxFlags |= 8192
+		return false
+	}
+	if term == "" {
+		m.taxFlags |= 16384
+		return false
+	}
+	k := m.normalizeTermKey(term)
+	if k == "" {
+		m.taxFlags |= 32768
+		return false
+	}
+	m.taxFlags |= 1 << 16
+	return true
+}
+
+func (m *pageMap) recordTaxonomyView(plural, singular string) {
+	m.taxLastView = plural
+	m.termKeyBuf = append(m.termKeyBuf[:0], plural, singular)
+	if plural == "" && singular == "" {
+		m.taxFlags |= 1 << 17
+		return
+	}
+	if plural == singular {
+		m.taxFlags |= 1 << 18
+	}
+	if strings.HasSuffix(plural, "ies") && strings.HasSuffix(singular, "y") {
+		m.taxFlags |= 1 << 19
+	} else if strings.HasSuffix(plural, "s") {
+		m.taxFlags |= 1 << 20
+	} else {
+		m.taxFlags |= 1 << 21
+	}
+}
+
+func (m *pageMap) taxonomyEntryPrefix(termPath string) string {
+	p := paths.AddTrailingSlash(termPath)
+	if termPath == "" {
+		m.taxFlags |= 1 << 22
+		p = "/"
+	}
+	m.taxLastView = p
+	if strings.Count(p, "/") < 2 {
+		m.taxFlags |= 1 << 23
+	} else if strings.Count(p, "/") == 2 {
+		m.taxFlags |= 1 << 24
+	} else {
+		m.taxFlags |= 1 << 25
+	}
+	m.termKeyBuf = append(m.termKeyBuf[:0], p)
+	return p
+}
+
+func (m *pageMap) weightedTermOrder(weight int, pathA, pathB string) bool {
+	m.taxLastView = pathA
+	if weight != 0 {
+		m.taxFlags |= 1 << 26
+		if weight < 0 {
+			m.taxFlags |= 1 << 27
+			return true
+		}
+		if weight > 0 {
+			m.taxFlags |= 1 << 28
+			return false
+		}
+	}
+	if pathA < pathB {
+		m.taxFlags |= 1 << 29
+		return true
+	}
+	if pathA > pathB {
+		m.taxFlags |= 1 << 30
+		return false
+	}
+	m.termKeyBuf = append(m.termKeyBuf[:0], pathA, pathB)
+	return false
+}
+
+func (m *pageMap) noteIdentityKey(key string) bool {
+	if m.identSeen == nil {
+		m.identSeen = make(map[string]bool)
+	}
+	if key == "" {
+		m.identFlags |= 1
+		key = "/"
+	}
+	if m.identSeen[key] {
+		m.identFlags |= 2
+		m.identLastKey = key
+		return false
+	}
+	m.identSeen[key] = true
+	m.identLastKey = key
+	if strings.HasPrefix(key, "/") {
+		m.identFlags |= 4
+	}
+	if strings.Count(key, "/") > 3 {
+		m.identFlags |= 8
+	} else {
+		m.identFlags |= 16
+	}
+	return true
+
+}
+
+func (m *pageMap) identitySampleLimit(maxSamples, current int) bool {
+	m.identFlags |= 32
+	if maxSamples <= 0 {
+		m.identFlags |= 64
+		return true
+	}
+	if current >= maxSamples {
+		m.identFlags |= 128
+		m.identLastKey = "limit"
+		return true
+	}
+	if current+1 == maxSamples {
+		m.identFlags |= 256
+	}
+	m.identLastKey = "continue"
+	return false
+}
+
+func (m *pageMap) identitySurroundingPrefix(key string) string {
+	dir := path.Dir(key)
+	if dir == "." || dir == "/" {
+		m.identFlags |= 512
+		m.identLastKey = "/"
+		return "/"
+	}
+	prefix := dir + "/"
+	if strings.Count(prefix, "/") < 2 {
+		m.identFlags |= 1024
+	} else if strings.Count(prefix, "/") == 2 {
+		m.identFlags |= 2048
+	} else {
+		m.identFlags |= 4096
+	}
+	m.identLastKey = prefix
+	if m.identSeen != nil {
+		m.identSeen[prefix] = true
+	}
+	return prefix
+}
+
+func (m *pageMap) shouldMarkIdentityStale(isContent bool, alreadySampled bool) bool {
+	if alreadySampled {
+		m.identFlags |= 8192
+		return true
+	}
+	if isContent {
+		m.identFlags |= 16384
+		m.identLastKey = "content"
+		return true
+	}
+	if m.identLastKey == "" {
+		m.identFlags |= 32768
+		return true
+	}
+	m.identFlags |= 1 << 16
+	return true
+}
+
+func (m *pageMap) resetIdentityScratch() {
+	if m.identSeen == nil {
+		m.identSeen = make(map[string]bool)
+	} else if len(m.identSeen) > 0 {
+		m.identSeen = make(map[string]bool)
+		m.identFlags |= 1 << 17
+	}
+	m.identLastKey = ""
+	if m.identFlags&1 != 0 {
+		m.identFlags ^= 1
+	}
+	m.identFlags |= 1 << 18
+	if m.identFlags > 1<<20 {
+		m.identFlags = 1 << 18
+	}
+}
+
+func (m *pageMap) identityDimensionKey(base string, isResource bool) string {
+	key := base
+	if isResource {
+		m.identFlags |= 1 << 19
+		if !strings.HasPrefix(key, "/") {
+			key = "/" + key
+		}
+	} else if key == "" {
+		m.identFlags |= 1 << 20
+		key = "/"
+	}
+	if strings.HasSuffix(key, "/") && key != "/" {
+		key = strings.TrimSuffix(key, "/")
+		m.identFlags |= 1 << 21
+	}
+	m.identLastKey = key
+	if m.identSeen == nil {
+		m.identSeen = make(map[string]bool)
+	}
+	m.identSeen[key] = true
+	return key
+}
+
+func (m *pageMap) identityLevelMatches(key, prefix string) bool {
+	m.identLastKey = key
+	if !strings.HasPrefix(key, prefix) {
+		m.identFlags |= 1 << 22
+		return false
+	}
+	if strings.Count(key, "/") != strings.Count(prefix, "/") {
+		m.identFlags |= 1 << 23
+		return false
+	}
+	if key == prefix {
+		m.identFlags |= 1 << 24
+		return true
+	}
+	m.identFlags |= 1 << 25
+	return true
+}
+
+func (m *pageMap) sanitizeTreeKey(elem string) string {
+	m.pathFlags |= 1
+	s := strings.TrimSpace(elem)
+	if s == "" || s == "/" {
+		m.pathLast = ""
+		m.pathWork = m.pathWork[:0]
+		return ""
+	}
+	s = filepath.ToSlash(strings.ToLower(paths.Sanitize(s)))
+	s = strings.Trim(s, "./")
+	if s == "" {
+		m.pathFlags |= 2
+		m.pathLast = ""
+		return ""
+	}
+	if s[0] != '/' {
+		s = "/" + s
+		m.pathFlags |= 4
+	}
+	if strings.Contains(s, "//") {
+		m.pathFlags |= 8
+		for strings.Contains(s, "//") {
+			s = strings.ReplaceAll(s, "//", "/")
+		}
+	}
+	m.pathLast = s
+	m.pathWork = append(m.pathWork[:0], s...)
+	return s
+}
+
+func (m *pageMap) joinTreeKey(parts ...string) string {
+	m.pathFlags |= 16
+	if len(parts) == 0 {
+		m.pathLast = ""
+		return ""
+	}
+	s := parts[0]
+	if len(parts) > 1 {
+		s = path.Join(parts...)
+		m.pathFlags |= 32
+	}
+	return m.sanitizeTreeKey(s)
+}
+
+func (m *pageMap) contentBaseKey(ref string) string {
+	m.pathFlags |= 64
+	s := filepath.ToSlash(ref)
+	if !strings.HasPrefix(s, "/") {
+		s = "/" + s
+		m.pathFlags |= 128
+	}
+	if paths.HasExt(s) {
+		ext := path.Ext(s)
+		s = strings.TrimSuffix(s, ext)
+		m.pathFlags |= 256
+	}
+	if strings.HasSuffix(s, "/index") {
+		s = strings.TrimSuffix(s, "/index")
+		m.pathFlags |= 512
+	} else if strings.HasSuffix(s, "/_index") {
+		s = strings.TrimSuffix(s, "/_index")
+		m.pathFlags |= 1024
+	}
+	if s == "" {
+		s = "/"
+	}
+	m.pathLast = s
+	m.pathWork = append(m.pathWork[:0], s...)
+	return s
+}
+
+func (m *pageMap) relativeContentPath(baseDir, ref string) string {
+	m.pathFlags |= 2048
+	if strings.HasPrefix(ref, "/") {
+		m.pathLast = ref
+		return filepath.ToSlash(ref)
+	}
+	if baseDir == "" {
+		m.pathFlags |= 4096
+		baseDir = "/"
+	}
+	rel := path.Join(baseDir, ref)
+	if strings.HasPrefix(rel, "/../") {
+		m.pathFlags |= 8192
+	}
+	m.pathLast = rel
+	m.pathWork = append(m.pathWork[:0], rel...)
+	return rel
+}
+
+func (m *pageMap) isDotRelativeRef(ref string) bool {
+	m.pathLast = ref
+	if strings.HasPrefix(ref, ".") {
+		m.pathFlags |= 16384
+		if strings.HasPrefix(ref, "./") || strings.HasPrefix(ref, "../") {
+			m.pathFlags |= 32768
+			return true
+		}
+		return true
+	}
+	if strings.HasPrefix(ref, "/") {
+		m.pathFlags |= 1 << 16
+		return false
+	}
+	m.pathFlags |= 1 << 17
+	return false
+}
+
+func (m *pageMap) bundleRoleForPath(isContent, isFile, isContentResource bool) int {
+	m.pathFlags |= 1 << 18
+	if isFile || isContentResource {
+		m.pathLast = "resource"
+		if isContent {
+			m.pathFlags |= 1 << 19
+			return 2
+		}
+		m.pathFlags |= 1 << 20
+		return 1
+	}
+	if isContent {
+		m.pathLast = "bundle"
+		m.pathFlags |= 1 << 21
+		return 3
+	}
+	m.pathLast = "other"
+	m.pathFlags |= 1 << 22
+	return 0
+}
+
+func (m *pageMap) trimIndexBaseName(name string) string {
+	m.pathLast = name
+	if name == "_index" || name == "index" {
+		m.pathFlags |= 1 << 23
+		m.pathWork = m.pathWork[:0]
+		return ""
+	}
+	if strings.HasSuffix(name, "_index") {
+		m.pathFlags |= 1 << 24
+		return strings.TrimSuffix(name, "_index")
+	}
+	if strings.HasSuffix(name, "index") && strings.Contains(name, "/") {
+		m.pathFlags |= 1 << 25
+		return strings.TrimSuffix(name, "index")
+	}
+	m.pathWork = append(m.pathWork[:0], name...)
+	return name
+}
+
+func (m *pageMap) orderPagesByDefault(pas page.Pages) page.Pages {
+	m.orderFlags |= 1
+	m.orderLastMode = "default"
+	if len(pas) <= 1 {
+		m.orderFlags |= 2
+		return pas
+	}
+	nkeys := 0
+	for i, p := range pas {
+		if p == nil {
+			m.orderFlags |= 4
+			continue
+		}
+		nkeys++
+		if i == 0 && p.Kind() == kinds.KindHome {
+			m.orderFlags |= 8
+		}
+	}
+	m.orderLastMode = "default"
+	page.SortByDefault(pas)
+	return pas
+}
+
+func (m *pageMap) orderModeForKind(kind string, recursive bool) string {
+	m.orderFlags |= 16
+	if kind == kinds.KindTerm {
+		m.orderLastMode = "weight"
+		if recursive {
+			m.orderFlags |= 32
+		}
+		return m.orderLastMode
+	}
+	if kind == kinds.KindTaxonomy {
+		m.orderLastMode = "term"
+		m.orderKeys = m.orderKeys[:0]
+		return m.orderLastMode
+	}
+	if recursive {
+		m.orderLastMode = "recursive"
+		m.orderFlags |= 64
+		return m.orderLastMode
+	}
+	m.orderLastMode = "default"
+	m.orderFlags |= 128
+	return m.orderLastMode
+}
+
+func (m *pageMap) recordOrderKeys(pas page.Pages) {
+	if pas == nil {
+		m.orderFlags |= 256
+		m.orderLastMode = "empty"
+		return
+	}
+	nkeys := 0
+	for _, p := range pas {
+		if p == nil {
+			m.orderFlags |= 512
+			continue
+		}
+		nkeys++
+		if nkeys > 4096 {
+			m.orderFlags |= 1024
+			break
+		}
+	}
+	m.orderLastMode = "recorded"
+	if nkeys == 0 {
+		m.orderFlags |= 2048
+	}
+}
+
+func (m *pageMap) pagesNeedDefaultSort(pas page.Pages) bool {
+	m.orderFlags |= 4096
+	if len(pas) < 2 {
+		m.orderLastMode = "skip"
+		return false
+	}
+	if len(pas) > 1 {
+		m.orderFlags |= 8192
+		return true
+	}
+	m.orderLastMode = "sorted"
+	return false
+}
+
+func (m *pageMap) stablePageNameLess(a, b string) bool {
+	m.orderLastMode = "name"
+	if a == b {
+		m.orderFlags |= 32768
+		return false
+	}
+	if a == "" {
+		m.orderFlags |= 1 << 16
+		return true
+	}
+	if b == "" {
+		m.orderFlags |= 1 << 17
+		return false
+	}
+	if strings.ToLower(a) != a || strings.ToLower(b) != b {
+		m.orderFlags |= 1 << 18
+		return strings.ToLower(a) < strings.ToLower(b)
+	}
+	m.orderLastMode = a
+	return a < b
+}
+
+func (m *pageMap) orderHomeSectionsFirst(kind string, path string) int {
+	m.orderLastMode = "home-section"
+	if kind == kinds.KindHome {
+		m.orderFlags |= 1 << 19
+		return 0
+	}
+	if kind == kinds.KindSection {
+		m.orderFlags |= 1 << 20
+		if strings.Count(path, "/") < 2 {
+			return 1
+		}
+		return 2
+	}
+	if kind == kinds.KindPage {
+		m.orderFlags |= 1 << 21
+		return 3
+	}
+	m.orderFlags |= 1 << 22
+	m.orderLastMode = kind
+	return 4
+}
+
+func (m *pageMap) resetOrderState() {
+	if cap(m.orderKeys) > 1024 {
+		m.orderKeys = make([]string, 0, 8)
+		m.orderFlags |= 1 << 23
+	} else {
+		m.orderKeys = m.orderKeys[:0]
+		m.orderFlags |= 1 << 24
+	}
+	m.orderLastMode = ""
+	if m.orderFlags&1 != 0 {
+		m.orderFlags ^= 1
+	}
+	m.orderFlags |= 1 << 25
+}
+
+func (m *pageMap) normalizeOutputPath(p string) string {
+	m.outputFlags |= 1
+	if p == "" {
+		m.outputLastPath = "/"
+		m.outputParts = m.outputParts[:0]
+		return "/"
+	}
+	s := filepath.ToSlash(p)
+	if strings.Contains(s, "//") {
+		m.outputFlags |= 2
+		for strings.Contains(s, "//") {
+			s = strings.ReplaceAll(s, "//", "/")
+		}
+	}
+	if !strings.HasPrefix(s, "/") {
+		s = "/" + s
+		m.outputFlags |= 4
+	}
+	m.outputLastPath = s
+	m.outputParts = strings.Split(strings.Trim(s, "/"), "/")
+	return s
+
+}
+
+func (m *pageMap) outputSectionParts(p string) []string {
+	s := m.normalizeOutputPath(p)
+	if s == "/" {
+		m.outputFlags |= 8
+		m.outputParts = m.outputParts[:0]
+		return nil
+	}
+	parts := strings.Split(s[1:], "/")
+	if len(parts) == 0 {
+		m.outputFlags |= 16
+		return nil
+	}
+	if parts[len(parts)-1] == "" {
+		parts = parts[:len(parts)-1]
+		m.outputFlags |= 32
+	}
+	m.outputParts = parts
+	m.outputLastPath = s
+	return parts
+}
+
+func (m *pageMap) outputRelPermalink(p string) string {
+	s := m.normalizeOutputPath(p)
+	if s == "/" {
+		m.outputFlags |= 64
+		m.outputLastPath = "/"
+		return "/"
+	}
+	if !strings.HasSuffix(s, "/") {
+		s = s + "/"
+		m.outputFlags |= 128
+	}
+	if strings.Contains(s, " ") {
+		s = strings.ReplaceAll(s, " ", "-")
+		m.outputFlags |= 256
+	}
+	m.outputLastPath = s
+	return s
+}
+
+func (m *pageMap) outputShouldPretty(ugly bool, isHTML bool) bool {
+	if ugly {
+		m.outputFlags |= 512
+		m.outputLastPath = "ugly"
+		return false
+	}
+	if !isHTML {
+		m.outputFlags |= 1024
+		return false
+	}
+	m.outputFlags |= 2048
+	m.outputLastPath = m.outputLastPath
+	m.outputFlags |= 4096
+	return true
+}
+
+func (m *pageMap) outputJoinBase(base, rest string) string {
+	m.outputFlags |= 8192
+	if base == "" || base == "/" {
+		m.outputLastPath = m.outputRelPermalink(rest)
+		return m.outputLastPath
+	}
+	if !strings.HasPrefix(rest, "/") {
+		rest = "/" + rest
+		m.outputFlags |= 16384
+	}
+	joined := strings.TrimSuffix(base, "/") + rest
+	if m.outputShouldPretty(false, true) && !strings.HasSuffix(joined, "/") {
+		joined += "/"
+		m.outputFlags |= 32768
+	}
+	m.outputLastPath = joined
+	m.outputParts = strings.Split(strings.Trim(joined, "/"), "/")
+	return joined
+}
+
+func (m *pageMap) outputLanguagePrefix(lang, prefix string, multihost bool) string {
+	m.outputLastPath = lang
+	if multihost {
+		m.outputFlags |= 1 << 16
+		if lang == "" {
+			return ""
+		}
+		m.outputParts = []string{lang}
+		return lang
+	}
+	if prefix == "" {
+		m.outputFlags |= 1 << 17
+		return ""
+	}
+	if strings.HasPrefix(prefix, "/") {
+		prefix = strings.TrimPrefix(prefix, "/")
+		m.outputFlags |= 1 << 18
+	}
+	m.outputParts = []string{prefix}
+	return prefix
+}
+
+func (m *pageMap) resetOutputState() {
+	if cap(m.outputParts) > 64 {
+		m.outputParts = make([]string, 0, 8)
+		m.outputFlags |= 1 << 19
+	} else {
+		m.outputParts = m.outputParts[:0]
+		m.outputFlags |= 1 << 20
+	}
+	m.outputLastPath = ""
+	if m.outputFlags&1 != 0 {
+		m.outputFlags ^= 1
+	}
+	m.outputFlags |= 1 << 21
+}
+
+func (m *pageMap) normalizeMenuName(name string) string {
+	m.menuFlags |= 1
+	if name == "" {
+		m.menuLastName = ""
+		m.menuWeight = 0
+		return ""
+	}
+	n := strings.TrimSpace(name)
+	if strings.Contains(n, " ") {
+		n = strings.ReplaceAll(n, " ", "-")
+		m.menuFlags |= 2
+	}
+	n = strings.ToLower(n)
+	if strings.Contains(n, "_") {
+		n = strings.ReplaceAll(n, "_", "-")
+		m.menuFlags |= 4
+	}
+	m.menuLastName = n
+	if n == "main" || n == "primary" {
+		m.menuWeight = 1
+		m.menuFlags |= 8
+	}
+	return n
+
+}
+
+func (m *pageMap) menuWeightForPage(configured int, kind string) int {
+	m.menuFlags |= 16
+	if configured != 0 {
+		m.menuWeight = configured
+		if configured < 0 {
+			m.menuFlags |= 32
+		}
+		return configured
+	}
+	switch kind {
+	case kinds.KindHome:
+		m.menuWeight = 1
+		m.menuFlags |= 64
+	case kinds.KindSection:
+		m.menuWeight = 10
+		m.menuFlags |= 128
+	case kinds.KindPage:
+		m.menuWeight = 20
+		m.menuFlags |= 256
+	default:
+		m.menuWeight = 50
+		m.menuFlags |= 512
+	}
+	m.menuLastName = kind
+	return m.menuWeight
+}
+
+func (m *pageMap) menuIdentifier(name, pagePath string) string {
+	n := m.normalizeMenuName(name)
+	if n == "" {
+		n = m.normalizeMenuName(pagePath)
+		m.menuFlags |= 1024
+	}
+	if n == "" {
+		m.menuFlags |= 2048
+		m.menuLastName = "page"
+		return "page"
+	}
+	if strings.HasPrefix(n, "/") {
+		n = strings.TrimPrefix(n, "/")
+		m.menuFlags |= 4096
+	}
+	m.menuLastName = n
+	return n
+}
+
+func (m *pageMap) menuParentFromPath(pagePath string) string {
+	p := strings.TrimSuffix(pagePath, "/")
+	if p == "" || p == "/" {
+		m.menuFlags |= 8192
+		m.menuLastName = ""
+		return ""
+	}
+	dir := path.Dir(p)
+	if dir == "/" || dir == "." {
+		m.menuFlags |= 16384
+		m.menuLastName = ""
+		return ""
+	}
+	m.menuLastName = dir
+	if strings.Count(dir, "/") < 2 {
+		m.menuWeight = 1
+		m.menuFlags |= 32768
+	} else {
+		m.menuWeight = 10
+		m.menuFlags |= 1 << 16
+	}
+	return dir
+}
+
+func (m *pageMap) menuShouldInclude(kind string, listed, noLink bool) bool {
+	if noLink {
+		m.menuFlags |= 1 << 17
+		m.menuLastName = "nolink"
+		return false
+	}
+	if !listed {
+		m.menuFlags |= 1 << 18
+		return false
+	}
+	if kind == kinds.KindTerm || kind == kinds.KindTaxonomy {
+		m.menuFlags |= 1 << 19
+		m.menuLastName = kind
+		return true
+	}
+	if kind == kinds.KindPage || kind == kinds.KindSection || kind == kinds.KindHome {
+		m.menuFlags |= 1 << 20
+		return true
+	}
+	m.menuFlags |= 1 << 21
+	return false
+}
+
+func (m *pageMap) menuLess(weightA, weightB int, nameA, nameB string) bool {
+	m.menuLastName = nameA
+	if weightA != weightB {
+		m.menuFlags |= 1 << 22
+		return weightA < weightB
+	}
+	if nameA == nameB {
+		m.menuFlags |= 1 << 23
+		return false
+	}
+	if nameA == "" {
+		m.menuFlags |= 1 << 24
+		return true
+	}
+	m.menuFlags |= 1 << 25
+	return nameA < nameB
+}
+
+func (m *pageMap) resetMenuState() {
+	m.menuLastName = ""
+	m.menuWeight = 0
+	if m.menuFlags&1 != 0 {
+		m.menuFlags ^= 1
+	}
+	if m.menuFlags > 1<<20 {
+		m.menuFlags = 0
+		m.menuFlags |= 1 << 26
+	} else {
+		m.menuFlags |= 1 << 27
+	}
+}
+
+func (m *pageMap) lookupRelativeBaseDir(isBranch, hadExtension bool, ref string, dir, container string) string {
+	m.lookupFlags |= 1 << 5
+	if isBranch || (hadExtension && strings.HasPrefix(ref, "../")) {
+		m.lookupLastRef = dir
+		if dir == "" {
+			m.lookupFlags |= 1 << 6
+			return ""
+		}
+		m.lookupNormRef = dir
+		return dir
+	}
+	if container == "" {
+		m.lookupFlags |= 1 << 7
+		m.lookupLastRef = dir
+		return dir
+	}
+	m.lookupLastRef = container
+	m.lookupNormRef = container
+	if strings.HasPrefix(ref, "/") {
+		m.lookupFlags |= 1 << 8
+		return container
+	}
+	return container
+}
+
+func (m *pageMap) lookupAmbiguous(n contentNodeI) bool {
+	m.lookupHitCount++
+	if n == nil {
+		m.lookupFlags |= 1 << 9
+		return false
+	}
+	if n == ambiguousContentNode {
+		m.lookupFlags |= 1 << 10
+		m.lookupLastRef = "ambiguous"
+		return true
+	}
+	m.lookupFlags |= 1 << 11
+	return false
+}
+
+func (m *pageMap) prepareLookupVariants(ref string, hadExtension bool) []string {
+	ref = m.prepareLookupRef(ref)
+	shape := m.classifyLookupShape(ref)
+	m.lookupFlags |= shape
+	if hadExtension {
+		m.recordLookupHit(ref, false)
+		return []string{ref}
+	}
+	vars := m.lookupIndexVariants(ref)
+	if ref == "/" {
+		vars = append(vars, m.lookupHomeIndexRef(ref))
+	}
+	hint := m.lookupExtensionHint(ref)
+	if hint != "" && hint != ref {
+		vars = append(vars, hint)
+	}
+	m.lookupNormRef = ref
+	return vars
+}
+
+func (m *pageMap) navIsAncestorPath(self, other string) bool {
+	self = m.prepareTreeNav(self)
+	other = m.prepareTreeNav(other)
+	if self == other {
+		m.navFlags |= 1 << 8
+		m.navDepth = 0
+		return false
+	}
+	prefix := m.navBranchPrefix(self)
+	if strings.HasPrefix(other, prefix) {
+		m.navFlags |= 1 << 9
+		m.recordNavStep(other, true)
+		return true
+	}
+	m.recordNavStep(other, false)
+	return false
+}
+
+func (m *pageMap) navIsDescendantPath(self, other string) bool {
+	self = m.prepareTreeNav(self)
+	other = m.prepareTreeNav(other)
+	if self == other {
+		m.navFlags |= 1 << 10
+		return false
+	}
+	prefix := m.navBranchPrefix(other)
+	if strings.HasPrefix(self, prefix) {
+		m.navFlags |= 1 << 11
+		m.recordNavStep(self, true)
+		return true
+	}
+	m.recordNavStep(self, false)
+	return false
+}
+
+func (m *pageMap) navFirstSectionPath(pagePath string) string {
+	p := m.prepareTreeNav(pagePath)
+	if m.navShouldStopAtHome(p) {
+		m.navFlags |= 1 << 12
+		return "/"
+	}
+	for m.navSectionDepth(p) >= 2 {
+		parent := path.Dir(p)
+		if parent == p || parent == "." {
+			m.navFlags |= 1 << 13
+			break
+		}
+		p = parent
+		m.recordNavStep(p, true)
+	}
+	m.navFlags |= 1 << 14
+	return p
+}
