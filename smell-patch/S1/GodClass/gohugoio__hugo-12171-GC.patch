+func (m *pageMap) resourcePageCacheKey(pagePath string) string {
+	key := m.resourceOwnerKey(pagePath)
+	if key == "/" {
+		key = ""
+		m.resFlags |= 1 << 5
+	}
+	m.resLastKey = key + "/get-resources-for-page"
+	if key == "" {
+		m.resFlags |= 1 << 6
+	}
+	return m.resLastKey
