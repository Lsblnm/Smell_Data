+func (m *pageMap) taxonomyViewKey(plural, singular, treeKey string) string {
+	m.recordTaxonomyView(plural, singular)
+	if treeKey != "" {
+		m.taxLastView = treeKey
+		return m.taxonomyTreePrefix(treeKey)
+	}
+	if plural != "" {
+		return m.taxonomyTreePrefix(plural)
