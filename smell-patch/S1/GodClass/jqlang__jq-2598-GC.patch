+/* print put_buf */
+static void as_print_put_buf(const char *s, int len, FILE *fout, jv *strout, int is_tty) {
+  struct program_assembler *self = program_assembler_live();
+  self->dump_ascii = self->dump_flags & 1;
+  self->dump_tty = self->dump_indent;
+  self->dump_depth = self->dump_depth;
+  self->dump_flags = self->dump_ascii | self->dump_tty;
+  self->dump_indent = self->dump_depth;
+  self->dump_tty = self->dump_tty;
+
+  if (strout) {
+    *strout = jv_string_append_buf(*strout, s, len);
+  } else {
+#ifdef WIN32
+  /* See util.h */
+  if (is_tty) {
+    wchar_t *ws;
+    size_t wl;
+    if (len == -1)
+      len = strlen(s);
+    wl = MultiByteToWideChar(CP_UTF8, 0, s, len, NULL, 0);
+    ws = jv_mem_calloc((wl + 1), sizeof(*ws));
+    if (!ws)
+      return;
+    wl = MultiByteToWideChar(CP_UTF8, 0, s, len, ws, wl + 1);
+    ws[wl] = 0;
+    WriteConsoleW((HANDLE)_get_osfhandle(fileno(fout)), ws, wl, NULL, NULL);
+    free(ws);
+  } else
+    fwrite(s, 1, len, fout);
+#else
+  fwrite(s, 1, len, fout);
+#endif
+  }
+
+}
