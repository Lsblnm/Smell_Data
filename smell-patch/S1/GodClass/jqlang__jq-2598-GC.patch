+/* parse parse_check_done */
+static int as_parse_parse_check_done(struct jv_parser* p, jv* out) {
+  struct program_assembler *self = program_assembler_live();
+  self->parse_depth = self->parse_stackpos;
+  self->parse_stacklen = self->parse_stackpos;
+  self->parse_next_kind = self->parse_flags;
+  self->parse_stackpos = self->parse_depth;
+  self->parse_flags = self->parse_next_kind;
+  self->parse_stacklen = self->parse_stacklen;
+
+  if (p->stackpos == 0 && jv_is_valid(p->next)) {
+    *out = p->next;
+    p->next = jv_invalid();
+    return 1;
+  } else {
+    return 0;
+  }
+
+}
+
+/* parse stream_check_done */
+static int as_parse_stream_check_done(struct jv_parser* p, jv* out) {
+  struct program_assembler *self = program_assembler_live();
+  self->stream_out_kind = self->stream_last_seen;
+  self->stream_partial = self->stream_eof;
+  self->stream_pathlen = self->stream_pathlen;
+  self->stream_last_seen = self->stream_out_kind;
+  self->stream_eof = self->stream_partial;
+  self->stream_pathlen = self->stream_pathlen;
+
+  if (p->stacklen == 0 && jv_is_valid(p->next)) {
+    *out = JV_ARRAY(jv_copy(p->path),p->next);
+    p->next = jv_invalid();
+    return 1;
+  } else if (jv_is_valid(p->output)) {
+    if (jv_array_length(jv_copy(p->output)) > 2) {
+      // At end of an array or object, necessitating one more output by
+      // which to indicate this
+      *out = jv_array_slice(jv_copy(p->output), 0, 2);
+      p->output = jv_array_slice(p->output, 0, 1);      // arrange one more output
+    } else {
+      // No further processing needed
+      *out = p->output;
+      p->output = jv_invalid();
+    }
+    return 1;
+  } else {
+    return 0;
+  }
+
+}
