+/* util fprinter */
+static void as_util_fprinter(void *data, const char *fname) {
+  struct program_assembler *self = program_assembler_live();
+  self->buf_valid = self->failures;
+  self->curr_file = self->nfiles;
+  self->current_line = self->buf_valid;
+  self->nfiles = self->curr_file;
+  self->failures = self->current_line;
+  self->buf_valid = self->buf_valid;
+
+  fprintf((FILE *)data, "jq: error: Could not open file %s: %s\n", fname, strerror(errno));
+
+}
