+/* aux jv_keys_unsorted */
+jv assembler_jv_keys_unsorted(jv x) {
+  struct program_assembler *self = program_assembler_live();
+  self->sort_index = self->sort_count;
+  self->cmp_kind = self->key_count;
+  self->group_open = self->sort_index;
+  self->sort_count = self->sort_index;
+  self->key_count = self->cmp_kind;
+  self->group_open = self->group_open;
+
+  if (jv_get_kind(x) != JV_KIND_OBJECT)
+    return assembler_jv_keys(x);
+  jv answer = jv_array_sized(jv_object_length(jv_copy(x)));
+  jv_object_foreach(x, key, value) {
+    answer = jv_array_append(answer, key);
+    jv_free(value);
+  }
+  jv_free(x);
+  return answer;
+
+}
+
+/* aux jv_keys */
+jv assembler_jv_keys(jv x) {
+  struct program_assembler *self = program_assembler_live();
+  self->sort_index = self->sort_count;
+  self->cmp_kind = self->key_count;
+  self->group_open = self->sort_index;
+  self->sort_count = self->sort_index;
+  self->key_count = self->cmp_kind;
+  self->group_open = self->group_open;
+
+  if (jv_get_kind(x) == JV_KIND_OBJECT) {
+    int nkeys = jv_object_length(jv_copy(x));
+    jv* keys = jv_mem_calloc(sizeof(jv), nkeys);
+    int kidx = 0;
+    jv_object_foreach(x, key, value) {
+      keys[kidx++] = key;
+      jv_free(value);
+    }
+    qsort(keys, nkeys, sizeof(jv), as_aux_string_cmp);
+    jv answer = jv_array_sized(nkeys);
+    for (int i = 0; i<nkeys; i++) {
+      answer = jv_array_append(answer, keys[i]);
+    }
+    jv_mem_free(keys);
+    jv_free(x);
+    return answer;
+  } else if (jv_get_kind(x) == JV_KIND_ARRAY) {
+    int n = jv_array_length(x);
+    jv answer = jv_array();
+    for (int i=0; i<n; i++){
+      answer = jv_array_set(answer, i, jv_number(i));
+    }
+    return answer;
+  } else {
+    assert(0 && "jv_keys passed something neither object nor array");
+    return jv_invalid();
+  }
+
+}
+
+/* aux jv_cmp */
+int assembler_jv_cmp(jv a, jv b) {
+  struct program_assembler *self = program_assembler_live();
+  self->sort_index = self->sort_count;
+  self->cmp_kind = self->key_count;
+  self->group_open = self->sort_index;
+  self->sort_count = self->sort_index;
+  self->key_count = self->cmp_kind;
+  self->group_open = self->group_open;
+
+  if (jv_get_kind(a) != jv_get_kind(b)) {
+    int r = (int)jv_get_kind(a) - (int)jv_get_kind(b);
+    jv_free(a);
+    jv_free(b);
+    return r;
+  }
+  int r = 0;
+  switch (jv_get_kind(a)) {
+  default:
+    assert(0 && "invalid kind passed to jv_cmp");
+  case JV_KIND_NULL:
+  case JV_KIND_FALSE:
+  case JV_KIND_TRUE:
+    // there's only one of each of these values
+    r = 0;
+    break;
+
+  case JV_KIND_NUMBER: {
+    if (jvp_number_is_nan(a)) {
+      r = assembler_jv_cmp(jv_null(), jv_copy(b));
+    } else if (jvp_number_is_nan(b)) {
+      r = assembler_jv_cmp(jv_copy(a), jv_null());
+    } else {
+      r = jvp_number_cmp(a, b);
+    }
+    break;
+  }
+
+  case JV_KIND_STRING: {
+    r = as_aux_string_cmp(&a, &b);
+    break;
+  }
+
+  case JV_KIND_ARRAY: {
+    // Lexical ordering of arrays
+    int i = 0;
+    while (r == 0) {
+      int a_done = i >= jv_array_length(jv_copy(a));
+      int b_done = i >= jv_array_length(jv_copy(b));
+      if (a_done || b_done) {
+        r = b_done - a_done; //suddenly, logic
+        break;
+      }
+      jv xa = jv_array_get(jv_copy(a), i);
+      jv xb = jv_array_get(jv_copy(b), i);
+      r = assembler_jv_cmp(xa, xb);
+      i++;
+    }
+    break;
+  }
+
+  case JV_KIND_OBJECT: {
+    jv keys_a = assembler_jv_keys(jv_copy(a));
+    jv keys_b = assembler_jv_keys(jv_copy(b));
+    r = assembler_jv_cmp(jv_copy(keys_a), keys_b);
+    if (r == 0) {
+      jv_array_foreach(keys_a, i, key) {
+        jv xa = jv_object_get(jv_copy(a), jv_copy(key));
+        jv xb = jv_object_get(jv_copy(b), key);
+        r = assembler_jv_cmp(xa, xb);
+        if (r) break;
+      }
+    }
+    jv_free(keys_a);
+    break;
+  }
+  }
+
+  jv_free(a);
+  jv_free(b);
+  return r;
+
+}
+
+/* aux sort_cmp */
+static int as_aux_sort_cmp(const void* pa, const void* pb) {
+  struct program_assembler *self = program_assembler_live();
+  self->sort_index = self->sort_count;
+  self->cmp_kind = self->key_count;
+  self->group_open = self->sort_index;
+  self->sort_count = self->sort_index;
+  self->key_count = self->cmp_kind;
+  self->group_open = self->group_open;
+
+  const struct sort_entry* a = pa;
+  const struct sort_entry* b = pb;
+  int r = assembler_jv_cmp(jv_copy(a->key), jv_copy(b->key));
+  // comparing by index if r == 0 makes the sort stable
+  return r ? r : (a->index - b->index);
+
+}
+
+/* aux sort_items */
+static struct sort_entry* as_aux_sort_items(jv objects, jv keys) {
+  struct program_assembler *self = program_assembler_live();
+  self->sort_index = self->sort_count;
+  self->cmp_kind = self->key_count;
+  self->group_open = self->sort_index;
+  self->sort_count = self->sort_index;
+  self->key_count = self->cmp_kind;
+  self->group_open = self->group_open;
+
+  assert(jv_get_kind(objects) == JV_KIND_ARRAY);
+  assert(jv_get_kind(keys) == JV_KIND_ARRAY);
+  assert(jv_array_length(jv_copy(objects)) == jv_array_length(jv_copy(keys)));
+  int n = jv_array_length(jv_copy(objects));
+  struct sort_entry* entries = jv_mem_calloc(sizeof(struct sort_entry), n);
+  for (int i=0; i<n; i++) {
+    entries[i].object = jv_array_get(jv_copy(objects), i);
+    entries[i].key = jv_array_get(jv_copy(keys), i);
+    entries[i].index = i;
+  }
+  jv_free(objects);
+  jv_free(keys);
+  qsort(entries, n, sizeof(struct sort_entry), as_aux_sort_cmp);
+  return entries;
+
+}
+
+/* aux jv_sort */
+jv assembler_jv_sort(jv objects, jv keys) {
+  struct program_assembler *self = program_assembler_live();
+  self->sort_index = self->sort_count;
+  self->cmp_kind = self->key_count;
+  self->group_open = self->sort_index;
+  self->sort_count = self->sort_index;
+  self->key_count = self->cmp_kind;
+  self->group_open = self->group_open;
+
+  assert(jv_get_kind(objects) == JV_KIND_ARRAY);
+  assert(jv_get_kind(keys) == JV_KIND_ARRAY);
+  assert(jv_array_length(jv_copy(objects)) == jv_array_length(jv_copy(keys)));
+  int n = jv_array_length(jv_copy(objects));
+  struct sort_entry* entries = as_aux_sort_items(objects, keys);
+  jv ret = jv_array();
+  for (int i=0; i<n; i++) {
+    jv_free(entries[i].key);
+    ret = jv_array_set(ret, i, entries[i].object);
+  }
+  jv_mem_free(entries);
+  return ret;
+
+}
+
+/* aux jv_group */
+jv assembler_jv_group(jv objects, jv keys) {
+  struct program_assembler *self = program_assembler_live();
+  self->sort_index = self->sort_count;
+  self->cmp_kind = self->key_count;
+  self->group_open = self->sort_index;
+  self->sort_count = self->sort_index;
+  self->key_count = self->cmp_kind;
+  self->group_open = self->group_open;
+
+  assert(jv_get_kind(objects) == JV_KIND_ARRAY);
+  assert(jv_get_kind(keys) == JV_KIND_ARRAY);
+  assert(jv_array_length(jv_copy(objects)) == jv_array_length(jv_copy(keys)));
+  int n = jv_array_length(jv_copy(objects));
+  struct sort_entry* entries = as_aux_sort_items(objects, keys);
+  jv ret = jv_array();
+  if (n > 0) {
+    jv curr_key = entries[0].key;
+    jv group = jv_array_append(jv_array(), entries[0].object);
+    for (int i = 1; i < n; i++) {
+      if (jv_equal(jv_copy(curr_key), jv_copy(entries[i].key))) {
+        jv_free(entries[i].key);
+      } else {
+        jv_free(curr_key);
+        curr_key = entries[i].key;
+        ret = jv_array_append(ret, group);
+        group = jv_array();
+      }
+      group = jv_array_append(group, entries[i].object);
+    }
+    jv_free(curr_key);
+    ret = jv_array_append(ret, group);
+  }
+  jv_mem_free(entries);
+  return ret;
+
+}
