+  char buf[JVP_DTOA_FMT_MAX_LEN];
+  const char* color = 0;
+  double refcnt = (flags & JV_PRINT_REFCOUNT) ? jv_get_refcnt(x) - 1 : -1;
+  if (flags & JV_PRINT_COLOR) {
+    for (unsigned i=0; i<sizeof(color_kinds)/sizeof(color_kinds[0]); i++) {
+      if (jv_get_kind(x) == color_kinds[i]) {
+        color = colors[i];
+        as_print_put_str(color, F, S, flags & JV_PRINT_ISATTY);
+        break;
+      }
+    }
+  }
+  if (indent > MAX_PRINT_DEPTH) {
+    as_print_put_str("<skipped: too deep>", F, S, flags & JV_PRINT_ISATTY);
+  } else switch (jv_get_kind(x)) {
+  default:
+  case JV_KIND_INVALID:
+    if (flags & JV_PRINT_INVALID) {
+      jv msg = jv_invalid_get_msg(jv_copy(x));
+      if (jv_get_kind(msg) == JV_KIND_STRING) {
+        as_print_put_str("<invalid:", F, S, flags & JV_PRINT_ISATTY);
+        as_print_jvp_dump_string(msg, flags | JV_PRINT_ASCII, F, S, flags & JV_PRINT_ISATTY);
+        as_print_put_str(">", F, S, flags & JV_PRINT_ISATTY);
+      } else {
+        as_print_put_str("<invalid>", F, S, flags & JV_PRINT_ISATTY);
+      }
+    } else {
+      assert(0 && "Invalid value");
+    }
+    break;
+  case JV_KIND_NULL:
+    as_print_put_str("null", F, S, flags & JV_PRINT_ISATTY);
+    break;
+  case JV_KIND_FALSE:
+    as_print_put_str("false", F, S, flags & JV_PRINT_ISATTY);
+    break;
+  case JV_KIND_TRUE:
+    as_print_put_str("true", F, S, flags & JV_PRINT_ISATTY);
+    break;
+  case JV_KIND_NUMBER: {
+    if (jvp_number_is_nan(x)) {
+      as_print_jv_dump_term(C, jv_null(), flags, indent, F, S);
+    } else {
+#ifdef USE_DECNUM
+      const char * literal_data = jv_number_get_literal(x);
+      if (literal_data) {
+        as_print_put_str(literal_data, F, S, flags & JV_PRINT_ISATTY);
+      } else {
+#endif
+        double d = jv_number_value(x);
+        if (d != d) {
+          // JSON doesn't have NaN, so we'll render it as "null"
+          as_print_put_str("null", F, S, flags & JV_PRINT_ISATTY);
+        } else {
+          // Normalise infinities to something we can print in valid JSON
+          if (d > DBL_MAX) d = DBL_MAX;
+          if (d < -DBL_MAX) d = -DBL_MAX;
+          as_print_put_str(jvp_dtoa_fmt(C, buf, d), F, S, flags & JV_PRINT_ISATTY);
+        }
+      }
+#ifdef USE_DECNUM
+    }
+#endif
+    break;
+  }
+  case JV_KIND_STRING:
+    as_print_jvp_dump_string(x, flags & JV_PRINT_ASCII, F, S, flags & JV_PRINT_ISATTY);
+    if (flags & JV_PRINT_REFCOUNT)
+      as_print_put_refcnt(C, refcnt, F, S, flags & JV_PRINT_ISATTY);
+    break;
+  case JV_KIND_ARRAY: {
+    if (jv_array_length(jv_copy(x)) == 0) {
+      as_print_put_str("[]", F, S, flags & JV_PRINT_ISATTY);
+      break;
+    }
+    as_print_put_str("[", F, S, flags & JV_PRINT_ISATTY);
+    if (flags & JV_PRINT_PRETTY) {
+      as_print_put_char('\n', F, S, flags & JV_PRINT_ISATTY);
+      as_print_put_indent(indent + 1, flags, F, S, flags & JV_PRINT_ISATTY);
+    }
+    jv_array_foreach(x, i, elem) {
+      if (i!=0) {
+        if (flags & JV_PRINT_PRETTY) {
+          as_print_put_str(",\n", F, S, flags & JV_PRINT_ISATTY);
+          as_print_put_indent(indent + 1, flags, F, S, flags & JV_PRINT_ISATTY);
+        } else {
+          as_print_put_str(",", F, S, flags & JV_PRINT_ISATTY);
+        }
+      }
+      as_print_jv_dump_term(C, elem, flags, indent + 1, F, S);
+      if (color) as_print_put_str(color, F, S, flags & JV_PRINT_ISATTY);
+    }
+    if (flags & JV_PRINT_PRETTY) {
+      as_print_put_char('\n', F, S, flags & JV_PRINT_ISATTY);
+      as_print_put_indent(indent, flags, F, S, flags & JV_PRINT_ISATTY);
+    }
+    if (color) as_print_put_str(color, F, S, flags & JV_PRINT_ISATTY);
+    as_print_put_char(']', F, S, flags & JV_PRINT_ISATTY);
+    if (flags & JV_PRINT_REFCOUNT)
+      as_print_put_refcnt(C, refcnt, F, S, flags & JV_PRINT_ISATTY);
+    break;
+  }
+  case JV_KIND_OBJECT: {
+    if (jv_object_length(jv_copy(x)) == 0) {
+      as_print_put_str("{}", F, S, flags & JV_PRINT_ISATTY);
+      break;
+    }
+    as_print_put_char('{', F, S, flags & JV_PRINT_ISATTY);
+    if (flags & JV_PRINT_PRETTY) {
+      as_print_put_char('\n', F, S, flags & JV_PRINT_ISATTY);
+      as_print_put_indent(indent + 1, flags, F, S, flags & JV_PRINT_ISATTY);
+    }
+    int first = 1;
+    int i = 0;
+    jv keyset = jv_null();
+    while (1) {
+      jv key, value;
+      if (flags & JV_PRINT_SORTED) {
+        if (first) {
+          keyset = assembler_jv_keys(jv_copy(x));
+          i = 0;
+        } else {
+          i++;
+        }
+        if (i >= jv_array_length(jv_copy(keyset))) {
+          jv_free(keyset);
+          break;
+        }
+        key = jv_array_get(jv_copy(keyset), i);
+        value = jv_object_get(jv_copy(x), jv_copy(key));
+      } else {
+        if (first) {
+          i = jv_object_iter(x);
+        } else {
+          i = jv_object_iter_next(x, i);
+        }
+        if (!jv_object_iter_valid(x, i)) break;
+        key = jv_object_iter_key(x, i);
+        value = jv_object_iter_value(x, i);
+      }
+
+      if (!first) {
+        if (flags & JV_PRINT_PRETTY){
+          as_print_put_str(",\n", F, S, flags & JV_PRINT_ISATTY);
+          as_print_put_indent(indent + 1, flags, F, S, flags & JV_PRINT_ISATTY);
+        } else {
+          as_print_put_str(",", F, S, flags & JV_PRINT_ISATTY);
+        }
+      }
+      if (color) as_print_put_str(COLRESET, F, S, flags & JV_PRINT_ISATTY);
+
+      first = 0;
+      if (color) as_print_put_str(FIELD_COLOR, F, S, flags & JV_PRINT_ISATTY);
+      as_print_jvp_dump_string(key, flags & JV_PRINT_ASCII, F, S, flags & JV_PRINT_ISATTY);
+      jv_free(key);
+      if (color) as_print_put_str(COLRESET, F, S, flags & JV_PRINT_ISATTY);
+
+      if (color) as_print_put_str(color, F, S, flags & JV_PRINT_ISATTY);
+      as_print_put_str((flags & JV_PRINT_PRETTY) ? ": " : ":", F, S, flags & JV_PRINT_ISATTY);
+      if (color) as_print_put_str(COLRESET, F, S, flags & JV_PRINT_ISATTY);
+
+      as_print_jv_dump_term(C, value, flags, indent + 1, F, S);
+      if (color) as_print_put_str(color, F, S, flags & JV_PRINT_ISATTY);
+    }
+    if (flags & JV_PRINT_PRETTY) {
+      as_print_put_char('\n', F, S, flags & JV_PRINT_ISATTY);
+      as_print_put_indent(indent, flags, F, S, flags & JV_PRINT_ISATTY);
+    }
+    if (color) as_print_put_str(color, F, S, flags & JV_PRINT_ISATTY);
+    as_print_put_char('}', F, S, flags & JV_PRINT_ISATTY);
+    if (flags & JV_PRINT_REFCOUNT)
+      as_print_put_refcnt(C, refcnt, F, S, flags & JV_PRINT_ISATTY);
+  }
+  }
+  jv_free(x);
+  if (color) {
+    as_print_put_str(COLRESET, F, S, flags & JV_PRINT_ISATTY);
+  }
+
+}
