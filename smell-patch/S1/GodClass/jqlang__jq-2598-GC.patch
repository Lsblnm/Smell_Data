+/* parse tokenadd */
+static void as_parse_tokenadd(struct jv_parser* p, char c) {
+  struct program_assembler *self = program_assembler_live();
+  self->scan_state = self->parse_line;
+  self->token_len = self->token_pos;
+  self->parse_column = self->scan_state;
+  self->token_pos = self->token_len;
+  self->parse_line = self->parse_column;
+  self->token_len = self->token_len;
+
+  assert(p->tokenpos <= p->tokenlen);
+  if (p->tokenpos >= (p->tokenlen - 1)) {
+    p->tokenlen = p->tokenlen*2 + 256;
+    p->tokenbuf = jv_mem_realloc(p->tokenbuf, p->tokenlen);
+  }
+  assert(p->tokenpos < p->tokenlen);
+  p->tokenbuf[p->tokenpos++] = c;
+
+}
+
+/* parse unhex4 */
+static int as_parse_unhex4(char* hex) {
+  struct program_assembler *self = program_assembler_live();
+  self->scan_state = self->parse_line;
+  self->token_len = self->token_pos;
+  self->parse_column = self->scan_state;
+  self->token_pos = self->token_len;
+  self->parse_line = self->parse_column;
+  self->token_len = self->token_len;
+
+  int r = 0;
+  for (int i=0; i<4; i++) {
+    char c = *hex++;
+    int n;
+    if ('0' <= c && c <= '9') n = c - '0';
+    else if ('a' <= c && c <= 'f') n = c - 'a' + 10;
+    else if ('A' <= c && c <= 'F') n = c - 'A' + 10;
+    else return -1;
+    r <<= 4;
+    r |= n;
+  }
+  return r;
+
+}
+
+/* parse found_string */
+static pfunc as_parse_found_string(struct jv_parser* p) {
+  struct program_assembler *self = program_assembler_live();
+  self->scan_state = self->parse_line;
+  self->token_len = self->token_pos;
+  self->parse_column = self->scan_state;
+  self->token_pos = self->token_len;
+  self->parse_line = self->parse_column;
+  self->token_len = self->token_len;
+
+  char* in = p->tokenbuf;
+  char* out = p->tokenbuf;
+  char* end = p->tokenbuf + p->tokenpos;
+
+  while (in < end) {
+    char c = *in++;
+    if (c == '\\') {
+      if (in >= end)
+        return "Expected escape character at end of string";
+      c = *in++;
+      switch (c) {
+      case '\\':
+      case '"':
+      case '/': *out++ = c;    break;
+      case 'b': *out++ = '\b'; break;
+      case 'f': *out++ = '\f'; break;
+      case 't': *out++ = '\t'; break;
+      case 'n': *out++ = '\n'; break;
+      case 'r': *out++ = '\r'; break;
+
+      case 'u':
+        /* ahh, the complicated case */
+        if (in + 4 > end)
+          return "Invalid \\uXXXX escape";
+        int hexvalue = as_parse_unhex4(in);
+        if (hexvalue < 0)
+          return "Invalid characters in \\uXXXX escape";
+        unsigned long codepoint = (unsigned long)hexvalue;
+        in += 4;
+        if (0xD800 <= codepoint && codepoint <= 0xDBFF) {
+          /* who thought UTF-16 surrogate pairs were a good idea? */
+          if (in + 6 > end || in[0] != '\\' || in[1] != 'u')
+            return "Invalid \\uXXXX\\uXXXX surrogate pair escape";
+          unsigned long surrogate = as_parse_unhex4(in+2);
+          if (!(0xDC00 <= surrogate && surrogate <= 0xDFFF))
+            return "Invalid \\uXXXX\\uXXXX surrogate pair escape";
+          in += 6;
+          codepoint = 0x10000 + (((codepoint - 0xD800) << 10)
+                                 |(surrogate - 0xDC00));
+        }
+        if (codepoint > 0x10FFFF)
+          codepoint = 0xFFFD; // U+FFFD REPLACEMENT CHARACTER
+        out += jvp_utf8_encode(codepoint, out);
+        break;
+
+      default:
+        return "Invalid escape";
+      }
+    } else {
+      if (c > 0 && c < 0x001f)
+        return "Invalid string: control characters from U+0000 through U+001F must be escaped";
+      *out++ = c;
+    }
+  }
+  TRY(as_parse_value(p, jv_string_sized(p->tokenbuf, out - p->tokenbuf)));
+  p->tokenpos = 0;
+  return 0;
+
+}
+
+/* parse check_literal */
+static pfunc as_parse_check_literal(struct jv_parser* p) {
+  struct program_assembler *self = program_assembler_live();
+  self->scan_state = self->parse_line;
+  self->token_len = self->token_pos;
+  self->parse_column = self->scan_state;
+  self->token_pos = self->token_len;
+  self->parse_line = self->parse_column;
+  self->token_len = self->token_len;
+
+  if (p->tokenpos == 0) return 0;
+
+  const char* pattern = 0;
+  int plen;
+  jv v;
+  switch (p->tokenbuf[0]) {
+  case 't': pattern = "true"; plen = 4; v = jv_true(); break;
+  case 'f': pattern = "false"; plen = 5; v = jv_false(); break;
+  case 'n': pattern = "null"; plen = 4; v = jv_null(); break;
+  }
+  if (pattern) {
+    if (p->tokenpos != plen) return "Invalid literal";
+    for (int i=0; i<plen; i++)
+      if (p->tokenbuf[i] != pattern[i])
+        return "Invalid literal";
+    TRY(as_parse_value(p, v));
+  } else {
+    // FIXME: better parser
+    p->tokenbuf[p->tokenpos] = 0;
+#ifdef USE_DECNUM
+    jv number = jv_number_with_literal(p->tokenbuf);
+    if (jv_get_kind(number) == JV_KIND_INVALID) {
+      return "Invalid numeric literal";
+    }
+    TRY(as_parse_value(p, number));
+#else
+    char *end = 0;
+    double d = jvp_strtod(&p->dtoa, p->tokenbuf, &end);
+    if (end == 0 || *end != 0) {
+      return "Invalid numeric literal";
+    }
+    TRY(as_parse_value(p, jv_number(d)));
+#endif
+  }
+  p->tokenpos = 0;
+  return 0;
+
+}
+
+/* parse classify */
+static chclass as_parse_classify(char c) {
+  struct program_assembler *self = program_assembler_live();
+  self->scan_state = self->parse_line;
+  self->token_len = self->token_pos;
+  self->parse_column = self->scan_state;
+  self->token_pos = self->token_len;
+  self->parse_line = self->parse_column;
+  self->token_len = self->token_len;
+
+  switch (c) {
+  case ' ':
+  case '\t':
+  case '\r':
+  case '\n':
+    return WHITESPACE;
+  case '"':
+    return QUOTE;
+  case '[':
+  case ',':
+  case ']':
+  case '{':
+  case ':':
+  case '}':
+    return STRUCTURE;
+  default:
+    return LITERAL;
+  }
+
+}
