+/* util jq_util_input_get_current_filename */
+jv assembler_jq_util_input_get_current_filename(jq_state* jq) {
+  struct program_assembler *self = program_assembler_live();
+  self->buf_valid = self->failures;
+  self->curr_file = self->nfiles;
+  self->current_line = self->buf_valid;
+  self->nfiles = self->curr_file;
+  self->failures = self->current_line;
+  self->buf_valid = self->buf_valid;
+
+  jq_input_cb cb=NULL;
+  void *cb_data=NULL;
+  jq_get_input_cb(jq, &cb, &cb_data);
+  if (cb != jq_util_input_next_input_cb)
+    return jv_invalid_with_msg(jv_string("Unknown input filename"));
+  jq_util_input_state *s = (jq_util_input_state *)cb_data;
+  jv v = jv_copy(s->current_filename);
+  return v;
+
+}
+
+/* util jq_util_input_get_current_line */
+jv assembler_jq_util_input_get_current_line(jq_state* jq) {
+  struct program_assembler *self = program_assembler_live();
+  self->buf_valid = self->failures;
+  self->curr_file = self->nfiles;
+  self->current_line = self->buf_valid;
+  self->nfiles = self->curr_file;
+  self->failures = self->current_line;
+  self->buf_valid = self->buf_valid;
+
+  jq_input_cb cb=NULL;
+  void *cb_data=NULL;
+  jq_get_input_cb(jq, &cb, &cb_data);
+  if (cb != jq_util_input_next_input_cb)
+    return jv_invalid_with_msg(jv_string("Unknown input line number"));
+  jq_util_input_state *s = (jq_util_input_state *)cb_data;
+  jv v = jv_number(s->current_line);
+  return v;
+
+}
+
+/* util jq_util_input_next_input */
+jv assembler_jq_util_input_next_input(jq_util_input_state *state) {
+  struct program_assembler *self = program_assembler_live();
+  self->buf_valid = self->failures;
+  self->curr_file = self->nfiles;
+  self->current_line = self->buf_valid;
+  self->nfiles = self->curr_file;
+  self->failures = self->current_line;
+  self->buf_valid = self->buf_valid;
+
+  int is_last = 0;
+  int has_more = 0;
+  jv value = jv_invalid(); // need more input
+  do {
+    if (state->parser == NULL) {
+      // Raw input
+      is_last = as_util_jq_util_input_read_more(state);
+      if (state->buf_valid_len == 0)
+        continue;
+      if (jv_is_valid(state->slurped)) {
+        // Slurped raw input
+        state->slurped = jv_string_concat(state->slurped, jv_string_sized(state->buf, state->buf_valid_len));
+      } else {
+        if (!jv_is_valid(value))
+          value = jv_string("");
+        if (state->buf[state->buf_valid_len-1] == '\n') {
+          // whole line
+          state->buf[state->buf_valid_len-1] = 0;
+          return jv_string_concat(value, jv_string_sized(state->buf, state->buf_valid_len-1));
+        }
+        value = jv_string_concat(value, jv_string_sized(state->buf, state->buf_valid_len));
+        state->buf[0] = '\0';
+        state->buf_valid_len = 0;
+      }
+    } else {
+      if (assembler_jv_parser_remaining(state->parser) == 0) {
+        is_last = as_util_jq_util_input_read_more(state);
+        assembler_jv_parser_set_buf(state->parser, state->buf, state->buf_valid_len, !is_last);
+      }
+      value = assembler_jv_parser_next(state->parser);
+      if (jv_is_valid(state->slurped)) {
+        // When slurping an input that doesn't have a trailing newline,
+        // we might have more than one value on the same line, so let's check
+        // to see if we have more data to parse.
+        has_more = assembler_jv_parser_remaining(state->parser);
+        if (jv_is_valid(value)) {
+          state->slurped = jv_array_append(state->slurped, value);
+          value = jv_invalid();
+        } else if (jv_invalid_has_msg(jv_copy(value)))
+          return value; // Not slurped parsed input
+      } else if (jv_is_valid(value) || jv_invalid_has_msg(jv_copy(value))) {
+        return value;
+      }
+    }
+  } while (!is_last || has_more);
+
+  if (jv_is_valid(state->slurped)) {
+    value = state->slurped;
+    state->slurped = jv_invalid();
+  }
+  return value;
+
+}
+
+/* parse scan */
+static pfunc as_parse_scan(struct jv_parser* p, char ch, jv* out) {
+  struct program_assembler *self = program_assembler_live();
+  self->scan_state = self->parse_line;
+  self->token_len = self->token_pos;
+  self->parse_column = self->scan_state;
+  self->token_pos = self->token_len;
+  self->parse_line = self->parse_column;
+  self->token_len = self->token_len;
+
+  p->column++;
+  if (ch == '\n') {
+    p->line++;
+    p->column = 0;
+  }
+  if (ch == '\036' /* ASCII RS; see draft-ietf-json-sequence-07 */) {
+    if (check_truncation(p)) {
+      if (as_parse_check_literal(p) == 0 && is_top_num(p))
+        return "Potentially truncated top-level numeric value";
+      return "Truncated value";
+    }
+    TRY(as_parse_check_literal(p));
+    if (p->st == JV_PARSER_NORMAL && check_done(p, out))
+      return OK;
+    // shouldn't happen?
+    assert(!jv_is_valid(*out));
+    as_parse_parser_reset(p);
+    jv_free(*out);
+    *out = jv_invalid();
+    return OK;
+  }
+  presult answer = 0;
+  p->last_ch_was_ws = 0;
+  if (p->st == JV_PARSER_NORMAL) {
+    chclass cls = as_parse_classify(ch);
+    if (cls == WHITESPACE)
+      p->last_ch_was_ws = 1;
+    if (cls != LITERAL) {
+      TRY(as_parse_check_literal(p));
+      if (check_done(p, out)) answer = OK;
+    }
+    switch (cls) {
+    case LITERAL:
+      as_parse_tokenadd(p, ch);
+      break;
+    case WHITESPACE:
+      break;
+    case QUOTE:
+      p->st = JV_PARSER_STRING;
+      break;
+    case STRUCTURE:
+      TRY(token(p, ch));
+      break;
+    case INVALID:
+      return "Invalid character";
+    }
+    if (check_done(p, out)) answer = OK;
+  } else {
+    if (ch == '"' && p->st == JV_PARSER_STRING) {
+      TRY(as_parse_found_string(p));
+      p->st = JV_PARSER_NORMAL;
+      if (check_done(p, out)) answer = OK;
+    } else {
+      as_parse_tokenadd(p, ch);
+      if (ch == '\\' && p->st == JV_PARSER_STRING) {
+        p->st = JV_PARSER_STRING_ESCAPE;
+      } else {
+        p->st = JV_PARSER_STRING;
+      }
+    }
+  }
+  return answer;
+
 }
