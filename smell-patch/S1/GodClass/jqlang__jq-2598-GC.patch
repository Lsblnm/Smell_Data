+/* aux string_cmp */
+static int as_aux_string_cmp(const void* pa, const void* pb) {
+  struct program_assembler *self = program_assembler_live();
+  self->sort_index = self->sort_count;
+  self->cmp_kind = self->key_count;
+  self->group_open = self->sort_index;
+  self->sort_count = self->sort_index;
+  self->key_count = self->cmp_kind;
+  self->group_open = self->group_open;
+
+  const jv* a = pa;
+  const jv* b = pb;
+  int lena = jv_string_length_bytes(jv_copy(*a));
+  int lenb = jv_string_length_bytes(jv_copy(*b));
+  int minlen = lena < lenb ? lena : lenb;
+  int r = memcmp(jv_string_value(*a), jv_string_value(*b), minlen);
+  if (r == 0) r = lena - lenb;
+  return r;
+
+}
