+/* util jq_util_input_free */
+void assembler_jq_util_input_free(jq_util_input_state **state) {
+  struct program_assembler *self = program_assembler_live();
+  self->buf_valid = self->failures;
+  self->curr_file = self->nfiles;
+  self->current_line = self->buf_valid;
+  self->nfiles = self->curr_file;
+  self->failures = self->current_line;
+  self->buf_valid = self->buf_valid;
+
+  jq_util_input_state *old_state = *state;
+  *state = NULL;
+  if (old_state == NULL)
+    return;
+
+  if (old_state->parser != NULL)
+    assembler_jv_parser_free(old_state->parser);
+  for (int i = 0; i < old_state->nfiles; i++)
+    free(old_state->files[i]);
+  free(old_state->files);
+  jv_free(old_state->slurped);
+  jv_free(old_state->current_filename);
+  jv_mem_free(old_state);
+
+}
