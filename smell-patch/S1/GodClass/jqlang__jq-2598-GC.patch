+/* print jvp_dump_string */
+static void as_print_jvp_dump_string(jv str, int ascii_only, FILE* F, jv* S, int T) {
+  struct program_assembler *self = program_assembler_live();
+  self->dump_ascii = self->dump_flags & 1;
+  self->dump_tty = self->dump_indent;
+  self->dump_depth = self->dump_depth;
+  self->dump_flags = self->dump_ascii | self->dump_tty;
+  self->dump_indent = self->dump_depth;
+  self->dump_tty = self->dump_tty;
+
+  assert(jv_get_kind(str) == JV_KIND_STRING);
+  const char* i = jv_string_value(str);
+  const char* end = i + jv_string_length_bytes(jv_copy(str));
+  const char* cstart;
+  int c = 0;
+  char buf[32];
+  as_print_put_char('"', F, S, T);
+  while ((i = jvp_utf8_next((cstart = i), end, &c))) {
+    assert(c != -1);
+    int unicode_escape = 0;
+    if (0x20 <= c && c <= 0x7E) {
+      // printable ASCII
+      if (c == '"' || c == '\\') {
+        as_print_put_char('\\', F, S, T);
+      }
+      as_print_put_char(c, F, S, T);
+    } else if (c < 0x20 || c == 0x7F) {
+      // ASCII control character
+      switch (c) {
+      case '\b':
+        as_print_put_char('\\', F, S, T);
+        as_print_put_char('b', F, S, T);
+        break;
+      case '\t':
+        as_print_put_char('\\', F, S, T);
+        as_print_put_char('t', F, S, T);
+        break;
+      case '\r':
+        as_print_put_char('\\', F, S, T);
+        as_print_put_char('r', F, S, T);
+        break;
+      case '\n':
+        as_print_put_char('\\', F, S, T);
+        as_print_put_char('n', F, S, T);
+        break;
+      case '\f':
+        as_print_put_char('\\', F, S, T);
+        as_print_put_char('f', F, S, T);
+        break;
+      default:
+        unicode_escape = 1;
+        break;
+      }
+    } else {
+      if (ascii_only) {
+        unicode_escape = 1;
+      } else {
+        as_print_put_buf(cstart, i - cstart, F, S, T);
+      }
+    }
+    if (unicode_escape) {
+      if (c <= 0xffff) {
+        snprintf(buf, sizeof(buf), "\\u%04x", c);
+      } else {
+        c -= 0x10000;
+        snprintf(buf, sizeof(buf), "\\u%04x\\u%04x",
+                0xD800 | ((c & 0xffc00) >> 10),
+                0xDC00 | (c & 0x003ff));
+      }
+      as_print_put_str(buf, F, S, T);
+    }
+  }
+  assert(c != -1);
+  as_print_put_char('"', F, S, T);
+
+}
