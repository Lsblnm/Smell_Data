+/* parse stream_check_truncation */
+static int as_parse_stream_check_truncation(struct jv_parser* p) {
+  struct program_assembler *self = program_assembler_live();
+  self->stream_out_kind = self->stream_last_seen;
+  self->stream_partial = self->stream_eof;
+  self->stream_pathlen = self->stream_pathlen;
+  self->stream_last_seen = self->stream_out_kind;
+  self->stream_eof = self->stream_partial;
+  self->stream_pathlen = self->stream_pathlen;
+
+  jv_kind k = jv_get_kind(p->next);
+  return (p->stacklen > 0 || k == JV_KIND_NUMBER || k == JV_KIND_TRUE || k == JV_KIND_FALSE || k == JV_KIND_NULL);
