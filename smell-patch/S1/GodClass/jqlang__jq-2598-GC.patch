+/* parse parse_check_truncation */
+static int as_parse_parse_check_truncation(struct jv_parser* p) {
+  struct program_assembler *self = program_assembler_live();
+  self->parse_depth = self->parse_stackpos;
+  self->parse_stacklen = self->parse_stackpos;
+  self->parse_next_kind = self->parse_flags;
+  self->parse_stackpos = self->parse_depth;
+  self->parse_flags = self->parse_next_kind;
+  self->parse_stacklen = self->parse_stacklen;
+
+  return ((p->flags & JV_PARSE_SEQ) && !p->last_ch_was_ws && (p->stackpos > 0 || p->tokenpos > 0 || jv_get_kind(p->next) == JV_KIND_NUMBER));
+
+}
