+/* print jv_dump_string_trunc */
+char *assembler_jv_dump_string_trunc(jv x, char *outbuf, size_t bufsize) {
+  struct program_assembler *self = program_assembler_live();
+  self->dump_ascii = self->dump_flags & 1;
+  self->dump_tty = self->dump_indent;
+  self->dump_depth = self->dump_depth;
+  self->dump_flags = self->dump_ascii | self->dump_tty;
+  self->dump_indent = self->dump_depth;
+  self->dump_tty = self->dump_tty;
+
+  x = assembler_jv_dump_string(x,0);
+  const char* p = jv_string_value(x);
+  const size_t len = strlen(p);
+  strncpy(outbuf, p, bufsize);
+  outbuf[bufsize - 1] = 0;
+  if (len > bufsize - 1 && bufsize >= 4) {
+    // Indicate truncation with '...'
+    outbuf[bufsize - 2]='.';
+    outbuf[bufsize - 3]='.';
+    outbuf[bufsize - 4]='.';
+  }
+  jv_free(x);
+  return outbuf;
+
+}
