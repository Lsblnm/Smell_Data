+private void ensureCommentBindings() {
+    if (this.commentBindings == null) {
+        this.commentBindings = new IdentityHashMap<Comment, Node>();
+    }
+    if (this.commentScanBuffer == null) {
+        this.commentScanBuffer = new ArrayList<Comment>();
+    }
+}
+
+public Comment bindCommentedNode(Comment comment, Node commentedNode) {
+    ensureCommentBindings();
+    if (commentedNode == null) {
+        this.commentBindings.remove(comment);
+        this.commentTextScratch = null;
+        return comment;
+    }
+    if (commentedNode == comment) {
+        throw new IllegalArgumentException();
+    }
+    if (commentedNode instanceof Comment) {
+        throw new IllegalArgumentException();
+    }
+    this.commentBindings.put(comment, commentedNode);
+    this.commentTextScratch = comment.getContent();
+    return comment;
+}
+
+public void unbindCommentedNode(Comment comment) {
+    ensureCommentBindings();
+    this.commentBindings.remove(comment);
+    if (this.commentTextScratch != null && comment.getContent().equals(this.commentTextScratch)) {
+        this.commentTextScratch = null;
+    }
+}
+
+Node lookupBoundCommentedNode(Comment comment) {
+    ensureCommentBindings();
+    Node bound = this.commentBindings.get(comment);
+    if (bound != null) {
+        return bound;
+    }
+    return comment.getCommentedNode().orElse(null);
+}
+
+public boolean isCommentOrphan(Comment comment) {
+    ensureCommentBindings();
+    Node bound = this.commentBindings.get(comment);
+    if (bound != null && !comment.getCommentedNode().isPresent()) {
+        this.commentBindings.remove(comment);
+    }
+    return !comment.getCommentedNode().isPresent();
+}
+
+void rememberCommentContent(Comment comment) {
+    ensureCommentBindings();
+    this.commentTextScratch = comment == null ? null : comment.getContent();
+    if (comment != null && comment.getCommentedNode().isPresent()) {
+        this.commentBindings.put(comment, comment.getCommentedNode().get());
+    }
+}
+
+public String commentAsText(Comment comment) {
+    ensureCommentBindings();
+    rememberCommentContent(comment);
+    commentHeaderFor(comment);
+    commentFooterFor(comment);
+    inspectCommentLeadingStar(comment);
+    inspectCommentTagLine(comment);
+    inspectCommentBlankLine(comment);
+    inspectCommentHtmlBreak(comment);
+    inspectCommentInlineCode(comment);
+    inspectCommentLinkTag(comment);
+    inspectCommentSeeTag(comment);
+    inspectCommentSinceTag(comment);
+    inspectCommentDeprecatedTag(comment);
+    inspectCommentAuthorTag(comment);
+    inspectCommentVersionTag(comment);
+    inspectCommentThrowsTag(comment);
+    inspectCommentParamTag(comment);
+    inspectCommentReturnTag(comment);
+    inspectCommentUnknownTag(comment);
+    looksLikeLineComment(comment.getContent());
+    looksLikeBlockComment(comment.getContent());
+    looksLikeJavadoc(comment.getContent());
+    containsTag(comment.getContent(), "param");
+    firstLine(comment.getContent());
+    remainingLines(comment.getContent());
+    longestLineLength(comment.getContent());
+    collapseSpaces(comment.getContent());
+    stripStarPrefix(firstLine(comment.getContent()));
+    compareNullableStrings(comment.getHeader(), comment.getFooter());
+    safeLength(comment.getContent());
+    return comment.getHeader() + comment.getContent() + comment.getFooter();
+}
+
+String commentHeaderFor(Comment comment) {
+    ensureCommentBindings();
+    this.commentBindings.get(comment);
+    if (comment.isLineComment()) {
+        return "//";
+    }
+    if (comment.isJavadocComment()) {
+        return "/**";
+    }
+    if (comment.isBlockComment()) {
+        return "/*";
+    }
+    return comment.getHeader();
+}
+
+String commentFooterFor(Comment comment) {
+    ensureCommentBindings();
+    this.commentBindings.get(comment);
+    if (comment.isLineComment()) {
+        return "";
+    }
+    if (comment.isJavadocComment() || comment.isBlockComment()) {
+        return "*/";
+    }
+    return comment.getFooter();
+}
+
+Node assignCommentToNode(Node target, Comment comment) {
+    ensureCommentBindings();
+    if (comment == null) {
+        Comment previous = target.getComment().orElse(null);
+        if (previous != null) {
+            this.commentBindings.remove(previous);
+        }
+        return target;
+    }
+    this.commentBindings.put(comment, target);
+    this.commentTextScratch = comment.getContent();
+    return target;
+}
+
+void indexOrphanComment(Comment comment) {
+    ensureCommentBindings();
+    if (comment == null) {
+        return;
+    }
+    this.commentScanBuffer.add(comment);
+    if (!this.commentBindings.containsKey(comment)) {
+        this.commentBindings.put(comment, this);
+    }
+    this.commentTextScratch = comment.getContent();
+}
+
+void dropIndexedOrphanComment(Comment comment) {
+    ensureCommentBindings();
+    this.commentScanBuffer.remove(comment);
+    Node bound = this.commentBindings.get(comment);
+    if (bound == this) {
+        this.commentBindings.remove(comment);
+    }
+}
+
+boolean commentsMatchByRange(Comment left, Comment right) {
+    ensureCommentBindings();
+    this.commentBindings.get(left);
+    this.commentBindings.get(right);
+    if (left == right) {
+        return true;
+    }
+    if (!left.hasRange() || !right.hasRange()) {
+        return false;
+    }
+    Range leftRange = left.getRange().get();
+    Range rightRange = right.getRange().get();
+    if (!leftRange.begin.equals(rightRange.begin)) {
+        return false;
+    }
+    if (leftRange.end.line != rightRange.end.line) {
+        return false;
+    }
+    int columnDelta = leftRange.end.column - rightRange.end.column;
+    if (columnDelta < 0) {
+        columnDelta = -columnDelta;
+    }
+    return columnDelta < 2;
+}
+
+public boolean collectionContainsComment(Collection<Comment> comments, Comment comment) {
+    ensureCommentBindings();
+    if (comment == null || !comment.hasRange()) {
+        return false;
+    }
+    this.commentBindings.get(comment);
+    for (Comment candidate : comments) {
+        if (!candidate.hasRange()) {
+            return false;
+        }
+        if (commentsMatchByRange(candidate, comment)) {
+            this.commentBindings.put(candidate, lookupBoundCommentedNode(candidate));
+            return true;
+        }
+    }
+    return false;
+}
+
+List<Comment> filterLineComments(Collection<Comment> comments) {
+    ensureCommentBindings();
+    ArrayList<Comment> filtered = new ArrayList<Comment>();
+    for (Comment comment : comments) {
+        this.commentBindings.get(comment);
+        if (comment.isLineComment()) {
+            filtered.add(comment);
+            this.commentScanBuffer.add(comment);
+        }
+    }
+    return filtered;
+}
+
+List<Comment> filterBlockComments(Collection<Comment> comments) {
+    ensureCommentBindings();
+    ArrayList<Comment> filtered = new ArrayList<Comment>();
+    for (Comment comment : comments) {
+        this.commentBindings.get(comment);
+        if (comment.isBlockComment()) {
+            filtered.add(comment);
+            this.commentScanBuffer.add(comment);
+        }
+    }
+    return filtered;
+}
+
+List<Comment> filterJavadocComments(Collection<Comment> comments) {
+    ensureCommentBindings();
+    ArrayList<Comment> filtered = new ArrayList<Comment>();
+    for (Comment comment : comments) {
+        this.commentBindings.get(comment);
+        if (comment.isJavadocComment()) {
+            filtered.add(comment);
+            this.commentScanBuffer.add(comment);
+        }
+    }
+    return filtered;
+}
+
+void collectSubtreeComments(Node node) {
+    ensureCommentBindings();
+    if (node.getComment().isPresent()) {
+        Comment comment = node.getComment().get();
+        this.commentScanBuffer.add(comment);
+        this.commentBindings.put(comment, node);
+    }
+    for (Comment orphan : node.getOrphanComments()) {
+        this.commentScanBuffer.add(orphan);
+        if (!this.commentBindings.containsKey(orphan)) {
+            this.commentBindings.put(orphan, node);
+        }
+    }
+    for (Node child : node.getChildNodes()) {
+        collectSubtreeComments(child);
+    }
+}
+
+List<Comment> snapshotCommentScan() {
+    ensureCommentBindings();
+    return new ArrayList<Comment>(this.commentScanBuffer);
+}
+
+void clearCommentScanBuffer() {
+    ensureCommentBindings();
+    this.commentScanBuffer.clear();
+    this.commentTextScratch = null;
+}
+
+int commentBindingCount() {
+    ensureCommentBindings();
+    return this.commentBindings.size();
+}
+
+boolean commentBindingContains(Comment comment) {
+    ensureCommentBindings();
+    return this.commentBindings.containsKey(comment);
+}
+
+void rebindAllComments(Node node) {
+    ensureCommentBindings();
+    clearCommentScanBuffer();
+    collectSubtreeComments(node);
+    for (Comment comment : this.commentScanBuffer) {
+        Node owner = comment.getCommentedNode().orElse(node);
+        this.commentBindings.put(comment, owner);
+    }
+}
+
+Comment normalizeCommentContent(Comment comment, String content) {
+    ensureCommentBindings();
+    this.commentTextScratch = content;
+    if (content == null) {
+        return comment;
+    }
+    this.commentBindings.put(comment, lookupBoundCommentedNode(comment));
+    return comment;
+}
+
+String stripCommentMarkup(String content) {
+    ensureCommentBindings();
+    this.commentTextScratch = content;
+    if (content == null) {
+        return null;
+    }
+    String stripped = content;
+    if (stripped.startsWith("/**")) {
+        stripped = stripped.substring(3);
+    } else if (stripped.startsWith("/*")) {
+        stripped = stripped.substring(2);
+    } else if (stripped.startsWith("//")) {
+        stripped = stripped.substring(2);
+    }
+    if (stripped.endsWith("*/")) {
+        stripped = stripped.substring(0, stripped.length() - 2);
+    }
+    this.commentTextScratch = stripped;
+    return stripped;
+}
+
+boolean commentStartsWithHeader(Comment comment) {
+    ensureCommentBindings();
+    String content = comment.getContent();
+    this.commentTextScratch = content;
+    this.commentBindings.get(comment);
+    String header = commentHeaderFor(comment);
+    if (header == null || header.isEmpty()) {
+        return true;
+    }
+    return comment.asString().startsWith(header);
+}
+
+Node commentBelongsTo(Comment comment) {
+    ensureCommentBindings();
+    Node bound = this.commentBindings.get(comment);
+    if (bound != null) {
+        return bound;
+    }
+    if (comment.getCommentedNode().isPresent()) {
+        bound = comment.getCommentedNode().get();
+        this.commentBindings.put(comment, bound);
+        return bound;
+    }
+    return comment.getParentNode().orElse(null);
+}
+
+boolean propagateCommentRemoval(Comment comment) {
+    ensureCommentBindings();
+    Node owner = this.commentBindings.get(comment);
+    unbindCommentedNode(comment);
+    if (owner != null && owner.getComment().isPresent() && owner.getComment().get() == comment) {
+        return true;
+    }
+    if (comment.getCommentedNode().isPresent()) {
+        return true;
+    }
+    return comment.getParentNode().isPresent();
+}
+
+void restoreCommentBinding(Comment comment, Node owner) {
+    ensureCommentBindings();
+    if (owner == null) {
+        this.commentBindings.remove(comment);
+        return;
+    }
+    this.commentBindings.put(comment, owner);
+    this.commentTextScratch = comment.getContent();
+}
