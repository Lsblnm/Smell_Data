+LineSeparator classifyLineSeparator(String text) {
+    int countCr = countNeedle(text, "\r");
+    int countLf = countNeedle(text, "\n");
+    int countCrLf = countNeedle(text, "\r\n");
+    LineSeparator detected = classifyLineEndingCounts(countCr, countLf, countCrLf);
+    int lines = countLf > 0 ? countLf : (countCr > 0 ? countCr : 1);
+    this.spanProbe = Range.range(1, 1, Math.max(lines, 1), 1);
+    this.separatorProbe = detected;
+    shiftSpanNorth(this.spanProbe);
+    shiftSpanSouth(this.spanProbe);
+    shiftSpanWest(this.spanProbe);
+    shiftSpanEast(this.spanProbe);
+    shiftSpanNorthWest(this.spanProbe);
+    shiftSpanNorthEast(this.spanProbe);
+    shiftSpanSouthWest(this.spanProbe);
+    shiftSpanSouthEast(this.spanProbe);
+    shiftSpanFarNorth(this.spanProbe);
+    shiftSpanFarSouth(this.spanProbe);
+    shiftSpanFarWest(this.spanProbe);
+    shiftSpanFarEast(this.spanProbe);
+    shiftSpanOrigin(this.spanProbe);
+    shiftSpanHome(this.spanProbe);
+    shiftSpanDiagonal(this.spanProbe);
+    countLinesInText(text);
+    replaceNewlines(text, detected.asRawString());
+    return detected;
