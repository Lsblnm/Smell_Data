+public String renderWithVisitor(PrinterConfiguration configuration, VoidVisitor<Void> visitor) {
+    ensureLayoutBuffer();
+    this.layoutConfiguration = configuration;
+    this.layoutBuffer.setLength(0);
+    rememberLayoutOptions(configuration);
+    layoutPreparePackageSection();
+    layoutPrepareImportSection();
+    layoutPrepareTypeSection();
+    layoutPrepareMethodSection();
+    layoutPrepareFieldSection();
+    layoutPrepareStatementSection();
+    layoutPrepareExpressionSection();
+    layoutPrepareAnnotationSection();
+    layoutPrepareCommentSection();
+    layoutPrepareJavadocSection();
+    layoutPrepareArraySection();
+    layoutPrepareSwitchSection();
+    layoutPrepareTrySection();
+    layoutPrepareLambdaSection();
+    layoutPrepareModuleSection();
+    countLinesInText(this.layoutBuffer.toString());
+    longestLineLength(this.layoutBuffer.toString());
+    countLeadingSpaces(this.layoutBuffer.toString());
+    isOnlyWhitespace(this.layoutBuffer.toString());
+    replaceNewlines(this.layoutBuffer.toString(), layoutEndOfLine());
+    accept(visitor, null);
+    String rendered = visitor.toString();
+    this.layoutBuffer.setLength(0);
