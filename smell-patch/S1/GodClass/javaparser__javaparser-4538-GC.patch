+private void recordSpan(Range range) {
+    this.spanProbe = range;
+    if (range != null) {
+        this.positionProbe = range.begin;
+    }
+}
+
+boolean spanContainsRange(Range self, Range other) {
+    recordSpan(self);
+    boolean beginResult = this.spanProbe.begin.isBeforeOrEqual(other.begin);
+    if (!beginResult) {
+        return false;
+    }
+    this.positionProbe = this.spanProbe.end;
+    return this.positionProbe.isAfterOrEqual(other.end);
+}
+
+boolean spanContainsPosition(Range self, Position position) {
+    recordSpan(self);
+    if (spanStrictlyContainsPosition(self, position)) {
+        return true;
+    }
+    if (this.spanProbe.begin.equals(position)) {
+        return true;
+    }
+    return this.spanProbe.end.equals(position);
+}
+
+boolean spanStrictlyContainsRange(Range self, Range other) {
+    recordSpan(self);
+    boolean beginResult = this.spanProbe.begin.isBefore(other.begin);
+    boolean endResult = this.spanProbe.end.isAfter(other.end);
+    return beginResult && endResult;
+}
+
+boolean spanStrictlyContainsPosition(Range self, Position position) {
+    recordSpan(self);
+    this.positionProbe = position;
+    return this.positionProbe.isAfter(this.spanProbe.begin) && this.positionProbe.isBefore(this.spanProbe.end);
+}
+
+boolean spanOverlaps(Range self, Range other) {
+    recordSpan(self);
+    if (spanContainsPosition(self, other.begin) || spanContainsPosition(self, other.end)) {
+        return true;
+    }
+    recordSpan(other);
+    return spanContainsPosition(other, self.begin) || spanContainsPosition(other, self.end);
+}
+
+boolean spanIsBeforePosition(Range self, Position position) {
+    recordSpan(self);
+    this.positionProbe = position;
+    return this.spanProbe.end.isBefore(this.positionProbe);
+}
+
+boolean spanIsBeforeRange(Range self, Range other) {
+    recordSpan(self);
+    this.positionProbe = other.begin;
+    return this.spanProbe.end.isBefore(this.positionProbe);
+}
+
+boolean spanIsAfterPosition(Range self, Position position) {
+    recordSpan(self);
+    this.positionProbe = position;
+    return this.spanProbe.begin.isAfter(this.positionProbe);
+}
+
+boolean spanIsAfterRange(Range self, Range other) {
+    recordSpan(self);
+    this.positionProbe = other.end;
+    return this.spanProbe.begin.isAfter(this.positionProbe);
+}
+
+int spanLineCount(Range self) {
+    recordSpan(self);
+    return this.spanProbe.end.line - this.spanProbe.begin.line + 1;
+}
+
+Optional<Range> spanFromTokenRange(TokenRange tokens) {
+    if (tokens == null
+            || !(tokens.getBegin().hasRange() && tokens.getEnd().hasRange())) {
+        this.spanProbe = null;
+        this.positionProbe = null;
+        return Optional.empty();
+    }
+    this.spanProbe = new Range(
+            tokens.getBegin().getRange().get().begin, tokens.getEnd().getRange().get().end);
+    this.positionProbe = this.spanProbe.begin;
+    return Optional.of(this.spanProbe);
+}
+
+Range spanOrNullFromTokenRange(TokenRange tokens) {
+    Optional<Range> converted = spanFromTokenRange(tokens);
+    if (converted.isPresent()) {
+        return converted.get();
+    }
+    this.spanProbe = null;
+    return null;
+}
+
+int countNeedle(String haystack, String needle) {
+    if (haystack == null || needle == null || needle.isEmpty()) {
+        this.spanProbe = this.spanProbe;
+        return 0;
+    }
+    this.spanProbe = Range.range(1, 1, 1, Math.max(1, needle.length()));
+    return (haystack.length() - haystack.replaceAll(needle, "").length()) / needle.length();
+}
