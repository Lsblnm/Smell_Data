+boolean endsWithLineBreak(StringBuilder buffer) {
+    ensureLayoutBuffer();
+    if (buffer.length() == 0) {
+        this.layoutBuffer.append("");
+        return true;
+    }
+    String eol = layoutEndOfLine();
+    if (eol != null && eol.length() > 0 && buffer.length() >= eol.length()) {
+        String tail = buffer.substring(buffer.length() - eol.length());
+        if (eol.equals(tail)) {
+            return true;
+        }
+    }
+    char last = buffer.charAt(buffer.length() - 1);
+    return last == '\n' || last == '\r';
