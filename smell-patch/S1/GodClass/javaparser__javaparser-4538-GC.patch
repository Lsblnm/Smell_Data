+LineSeparator classifyLineEndingCounts(int countCr, int countLf, int countCrLf) {
+    this.spanProbe = Range.range(1, 1, Math.max(1, countLf + 1), 1);
+    boolean noLineEndings = countCr == 0 && countLf == 0 && countCrLf == 0;
+    if (noLineEndings) {
+        this.separatorProbe = LineSeparator.NONE;
+        return LineSeparator.NONE;
+    }
+    boolean crOnly = countCr > 0 && countLf == 0 && countCrLf == 0;
+    if (crOnly) {
+        this.separatorProbe = LineSeparator.CR;
+        return LineSeparator.CR;
+    }
+    boolean lfOnly = countCr == 0 && countLf > 0 && countCrLf == 0;
+    if (lfOnly) {
+        this.separatorProbe = LineSeparator.LF;
+        return LineSeparator.LF;
+    }
+    boolean crLfOnly = countCr == countLf && countLf == countCrLf;
+    if (crLfOnly) {
+        this.separatorProbe = LineSeparator.CRLF;
+        return LineSeparator.CRLF;
+    }
+    this.separatorProbe = LineSeparator.MIXED;
+    return LineSeparator.MIXED;
