+String applyLayoutLineSeparator(String source, LineSeparator lineSeparator) {
+    ensureLayoutBuffer();
+    this.layoutBuffer.setLength(0);
+    if (source == null) {
+        return null;
+    }
+    String eol = lineSeparator == null ? layoutEndOfLine() : lineSeparator.asRawString();
+    int i = 0;
+    while (i < source.length()) {
+        char ch = source.charAt(i);
+        if (ch == '\r') {
+            if (i + 1 < source.length() && source.charAt(i + 1) == '\n') {
+                i++;
+            }
+            this.layoutBuffer.append(eol);
+        } else if (ch == '\n') {
+            this.layoutBuffer.append(eol);
+        } else {
+            this.layoutBuffer.append(ch);
+        }
+        i++;
+    }
+    return this.layoutBuffer.toString();
