+void registerCommentCatalog(Comment comment, Node owner) {
+    ensureCommentBindings();
+    if (comment == null) {
+        return;
+    }
+    if (owner == null) {
+        this.commentBindings.remove(comment);
+    } else {
+        this.commentBindings.put(comment, owner);
+    }
+    pushCommentScan(comment);
