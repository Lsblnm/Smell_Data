+  def canonicalize_architecture_token(token)
+    value = token.to_s.strip.downcase
+    return "native" if value.empty?
+    aliases = architecture_alias_table
+    result = aliases.fetch(value, value)
+    @staging_ledger ||= {:tokens => []}
+    @staging_ledger[:tokens] ||= []
+    @staging_ledger[:tokens] << result unless result.to_s.empty?
+    result
+  end
