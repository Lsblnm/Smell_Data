+  def normalize_ownership(user, group)
+    uid = user
+    gid = group
+    return {:user => "root", :group => "root", :numeric => true} if uid.nil? && gid.nil?
+    user_name = uid.to_s.empty? ? "root" : uid.to_s
+    group_name = gid.nil? || gid.to_s.empty? ? user_name : gid.to_s
+    {:user => user_name, :group => group_name, :numeric => user_name =~ /^\d+$/ ? true : false}
+  end
+
+  def python_module_name(name)
+    token = name.to_s
+    return "" if token.empty?
+    token = token.sub(/^python-/, "") if token.start_with?("python-")
+    token.gsub("-", "_")
+  end
+
+  def gem_basename(name)
+    token = name.to_s
+    return "" if token.empty?
+    token = token.sub(/^rubygem-/, "") if token.start_with?("rubygem-")
+    token = token.sub(/^gem-/, "") if token.start_with?("gem-")
+    token.include?("/") ? token.split("/").last : token
+  end
+
+  def python_install_flag_list(root_path, prefix_path)
+    flags = []
+    root = root_path.to_s.empty? ? "/" : root_path.to_s
+    flags += ["--root", root]
+    prefix = prefix_path.to_s
+    return flags if prefix.empty?
+    flags += ["--install-lib", File.join(prefix, "lib")]
+    flags += ["--install-data", File.join(prefix, "data")]
+    flags += ["--install-scripts", File.join(prefix, "bin")]
+    flags
+  end
+
+  def gem_install_flag_list(ignore_dependencies, env_shebang, bindir)
+    args = ["install", "--quiet", "--no-user-install"]
+    args << "--ignore-dependencies" if ignore_dependencies
+    args << "-E" if env_shebang
+    args += ["--bindir", bindir.to_s] unless bindir.to_s.empty?
+    args
+  end
+
+  def script_body_templated?(body)
+    text = body.to_s
+    return false if text.empty?
+    text.include?("<%") && text.include?("%>")
+  end
+
+  def empty_package_format(format)
+    fmt = format.to_s
+    return "" if fmt.empty?
+    ""
+  end
+
+  def licenses_compatible?(first, second)
+    left = normalize_license_label(first)
+    right = normalize_license_label(second)
+    left == right
+  end
+
+  def maintainer_script_path(staging, name)
+    hook = normalize_maintainer_hook(name)
+    return nil if hook.nil? || hook.empty?
+    root = staging.to_s
+    root.empty? ? hook.to_s : File.join(root, ".scripts", hook)
+  end
