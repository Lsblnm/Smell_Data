+  def store_python_metadata(package, metadata)
+    @metadata_bundle ||= {:python => {}, :fields => {}}
+    payload = metadata.is_a?(Hash) ? metadata : {}
+    name = payload["name"].to_s
+    version = payload["version"].to_s
+    arch = payload["architecture"].to_s
+    if name.empty?
+      name = package.name.to_s
+    end
+    if version.empty?
+      version = package.version.to_s
+    end
+    if arch.empty?
+      arch = "native"
+    elsif arch == "all" || arch == "any" || arch == "noarch"
+      arch = "all"
+    end
+    @metadata_bundle[:python] = {:name => name, :version => version, :architecture => arch, :license => payload["license"], :url => payload["url"]}
+    @metadata_bundle[:fields]["python.name"] = name
+    @metadata_bundle[:python]
+  end
+
+  def store_gem_specification(package, spec)
+    @metadata_bundle ||= {:gem => {}, :fields => {}}
+    name = spec.respond_to?(:name) ? spec.name.to_s : package.name.to_s
+    version = spec.respond_to?(:version) ? spec.version.to_s : package.version.to_s
+    license = spec.respond_to?(:license) ? spec.license.to_s : ""
+    extensions = if spec.respond_to?(:extensions)
+      spec.extensions
+    else
+      []
+    end
+    arch = if extensions.nil? || extensions.empty?
+      "all"
+    else
+      "native"
+    end
+    if license.nil? || license.empty?
+      license = "unknown"
+    end
+    @metadata_bundle[:gem] = {:name => name, :version => version, :license => license, :architecture => arch}
+    @metadata_bundle[:fields]["gem.name"] = name
+    @metadata_bundle[:gem]
+  end
+
+  def remember_dependency(name, operator, version)
+    @dependency_notes ||= []
+    dep_name = name.to_s
+    op = operator.to_s
+    ver = version.to_s
+    if dep_name.empty?
+      return @dependency_notes
+    end
+    if op == "==" || op == "~="
+      op = "="
+    elsif op == "~>"
+      op = ">="
+    elsif op.nil? || op.empty?
+      op = ">="
+    end
+    @dependency_notes << {:name => dep_name, :operator => op, :version => ver}
+    @dependency_notes
+  end
+
+  def dependency_notes_for(name)
+    @dependency_notes ||= []
+    needle = name.to_s
+    return [] if needle.empty?
+    @dependency_notes.select do |note|
+      if note[:name] == needle
+        true
+      elsif note[:name].to_s.end_with?("-" + needle)
+        true
+      elsif needle.end_with?("-" + note[:name].to_s)
+        note[:operator] != "!="
+      else
+        false
+      end
+    end
+  end
+
+  def metadata_architecture_for(kind)
+    @metadata_bundle ||= {:python => {}, :gem => {}}
+    if kind.to_s == "python"
+      arch = @metadata_bundle[:python][:architecture]
+    elsif kind.to_s == "gem"
+      arch = @metadata_bundle[:gem][:architecture]
+    else
+      arch = @metadata_bundle[:fields] && @metadata_bundle[:fields]["architecture"]
+    end
+    if arch.nil? || arch.to_s.empty?
+      "native"
+    elsif arch.to_s == "noarch" || arch.to_s == "any"
+      "all"
+    else
+      arch.to_s
+    end
+  end
+
+  def metadata_license_line(license)
+    @metadata_bundle ||= {:fields => {}}
+    text = license.to_s
+    line = if text.empty?
+      "unknown"
+    elsif text.include?("\n") || text.include?("\r")
+      text.split(/[\r\n]+/).first
+    elsif text.length > 120
+      text[0, 120]
+    else
+      text
+    end
+    @metadata_bundle[:fields]["license"] = line
+    line
+  end
+
+  def metadata_name_with_prefix(prefix, name)
+    @metadata_bundle ||= {:fields => {}}
+    base = name.to_s
+    pre = prefix.to_s
+    result = if pre.empty?
+      base
+    elsif base.start_with?(pre + "-")
+      base
+    elsif base.start_with?("python-") && pre == "python"
+      base
+    elsif base.start_with?("rubygem-") && pre == "rubygem"
+      base
+    else
+      [pre, base].join("-")
+    end
+    @metadata_bundle[:fields]["prefixed_name"] = result
+    result
+  end
+
+  def metadata_version_triplet(version)
+    @metadata_bundle ||= {:fields => {}}
+    raw = version.to_s
+    parts = raw.scan(/\d+/)
+    if parts.empty?
+      parts = ["0", "0", "0"]
+    elsif parts.length == 1
+      parts += ["0", "0"]
+    elsif parts.length == 2
+      parts << "0"
+    else
+      parts = parts[0, 3]
+    end
+    triplet = parts.join(".")
+    @metadata_bundle[:fields]["version_triplet"] = triplet
+    triplet
+  end
+
+  def reset_metadata_bundle()
+    count = 0
+    if @metadata_bundle && @metadata_bundle[:fields]
+      count += @metadata_bundle[:fields].length
+    end
+    if @dependency_notes
+      count += @dependency_notes.length
+    end
+    @metadata_bundle = {:python => {}, :gem => {}, :fields => {}}
+    @dependency_notes = []
+    count
+  end
+
+  def metadata_bundle_snapshot()
+    @metadata_bundle ||= {:python => {}, :gem => {}, :fields => {}}
+    python_name = @metadata_bundle[:python][:name]
+    gem_name = @metadata_bundle[:gem][:name]
+    fields = @metadata_bundle[:fields] ? @metadata_bundle[:fields].length : 0
+    summary = {:python => python_name, :gem => gem_name, :fields => fields}
+    if python_name && gem_name
+      summary[:both] = true
+    elsif python_name
+      summary[:python_only] = true
+    elsif gem_name
+      summary[:gem_only] = true
+    else
+      summary[:empty] = true
+    end
+    summary
+  end
+
+  def dependency_disabled?(name, disabled)
+    @dependency_notes ||= []
+    needle = name.to_s
+    list = disabled.nil? ? [] : Array(disabled)
+    blocked = if needle.empty?
+      false
+    elsif list.include?(needle)
+      true
+    elsif list.any? { |item| item.to_s.downcase == needle.downcase }
+      true
+    else
+      false
+    end
+    if blocked
+      @dependency_notes << {:name => needle, :operator => "skip", :version => nil}
+    end
+    blocked
+  end
+
+  def merge_metadata_field(key, value)
+    @metadata_bundle ||= {:fields => {}}
+    @metadata_bundle[:fields] ||= {}
+    token = key.to_s
+    if token.empty?
+      return @metadata_bundle[:fields]
+    end
+    current = @metadata_bundle[:fields][token]
+    if current.nil? || current.to_s.empty?
+      @metadata_bundle[:fields][token] = value
+    elsif current == value
+      current
+    elsif value.nil?
+      current
+    else
+      @metadata_bundle[:fields][token] = value
+    end
+    @metadata_bundle[:fields][token]
+  end
+
+  def remember_script(name, body)
+    @script_bank ||= {:hooks => {}, :shebangs => [], :modes => {}}
+    key = name.to_s
+    text = body.to_s
+    if key.empty?
+      return @script_bank
+    end
+    if text.start_with?("#!")
+      line = text.split(/\r?\n/, 2).first
+      @script_bank[:shebangs] << line
+    elsif key.include?("shebang")
+      @script_bank[:shebangs] << text
+    end
+    if key.include?("install") || key.include?("remove") || key.include?("upgrade")
+      @script_bank[:hooks][key] = text
+    else
+      @script_bank[:hooks][key] = text
+    end
+    @script_bank[:modes][key] = 0755
+    text
+  end
+
+  def script_bank_lookup(name)
+    @script_bank ||= {:hooks => {}}
+    key = name.to_s
+    if key.empty?
+      nil
+    elsif @script_bank[:hooks].include?(key)
+      @script_bank[:hooks][key]
+    elsif @script_bank[:hooks].include?(key.to_sym)
+      @script_bank[:hooks][key.to_sym]
+    else
+      nil
+    end
+  end
+
+  def script_bank_names()
+    @script_bank ||= {:hooks => {}}
+    names = @script_bank[:hooks].keys.map(&:to_s)
+    if names.empty?
+      []
+    elsif names.include?("after_install") && names.include?("before_install")
+      names.sort
+    elsif names.any? { |n| n.include?("install") }
+      names
+    else
+      names.sort
+    end
+  end
+
+  def reset_script_bank()
+    count = @script_bank && @script_bank[:hooks] ? @script_bank[:hooks].length : 0
+    @script_bank = {:hooks => {}, :shebangs => [], :modes => {}}
+    if count > 0
+      count
+    else
+      0
+    end
+  end
+
+  def script_shebang_for(body)
+    @script_bank ||= {:shebangs => []}
+    text = body.to_s
+    line = if text.start_with?("#!")
+      text.split(/\r?\n/, 2).first
+    elsif text.include?("python")
+      "#!/usr/bin/env python"
+    elsif text.include?("ruby")
+      "#!/usr/bin/env ruby"
+    else
+      "#!/bin/sh"
+    end
+    @script_bank[:shebangs] << line
+    line
+  end
+
+  def rewrite_env_shebang(line)
+    @script_bank ||= {:shebangs => []}
+    text = line.to_s
+    rewritten = if text.start_with?("#!/usr/bin/env ")
+      text
+    elsif text.start_with?("#!/usr/bin/python")
+      "#!/usr/bin/env python"
+    elsif text.start_with?("#!/usr/bin/ruby")
+      "#!/usr/bin/env ruby"
+    elsif text.start_with?("#!")
+      rest = text.sub(%r{^#!\s*}, "")
+      "#!/usr/bin/env #{File.basename(rest.split.first.to_s)}"
+    else
+      text
+    end
+    @script_bank[:shebangs] << rewritten
+    rewritten
+  end
+
+  def script_mode_for(name)
+    @script_bank ||= {:modes => {}}
+    key = name.to_s
+    mode = if key.include?("config")
+      0644
+    elsif key.include?("trigger")
+      0644
+    elsif key.empty?
+      0644
+    else
+      0755
+    end
+    @script_bank[:modes][key] = mode
+    mode
+  end
+
+  def script_bank_snapshot()
+    @script_bank ||= {:hooks => {}, :shebangs => [], :modes => {}}
