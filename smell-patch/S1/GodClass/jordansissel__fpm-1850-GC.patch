+  def split_archive_name(path)
+    token = path.to_s
+    return ["", ""] if token.empty?
+    begin
+      io = StringIO.new
+      writer = FPM::Util::TarWriter.new(io)
+      if writer.respond_to?(:split_name)
+        name, prefix = writer.split_name(token)
+        return [name, prefix]
+      end
+      parts = token.split("/")
+      name = parts.pop
+      prefix = parts.join("/")
+      [name.to_s, prefix.to_s]
+    rescue StandardError
+      [File.basename(token), File.dirname(token)]
+    end
+  end
