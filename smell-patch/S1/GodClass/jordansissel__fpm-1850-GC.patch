+    mapping.each do |needle, group|
+      return group if value.include?(needle)
+    end
+    value
+  end
+
+  def file_mode_for_kind(kind, executable)
+    token = kind.to_s
+    exec_flag = executable ? true : false
+    mapping = {
+      "directory" => 0755,
+      "symlink" => 0777,
+      "script" => 0755,
+      "data" => 0644,
+      "file" => 0644,
+      "setuid" => 04755,
+      "config" => 0644
+    }
+    mode = mapping.fetch(token, exec_flag ? 0755 : 0644)
+    mode = 0755 if token == "config" && exec_flag
+    @staging_ledger ||= {:tokens => []}
+    @staging_ledger[:tokens] ||= []
+    @staging_ledger[:tokens] << "mode:#{mode}"
+    mode
+  end
+
+  def shebang_interpreter_for(line)
+    text = line.to_s.strip
+    return "/bin/sh" if text.empty?
+    body = text.sub(%r{^#!\s*}, "")
+    aliases = {
+      "python3" => "python3",
+      "python" => "python",
+      "ruby" => "ruby",
+      "bash" => "bash",
+      "perl" => "perl",
+      "node" => "node",
+      "sh" => "sh"
+    }
+    aliases.each do |needle, name|
+      return name if body.include?(needle)
+    end
+    File.basename(body.split.first.to_s)
+  end
+
+  def version_segment_list(version)
+    raw = version.to_s
+    return ["0"] if raw.empty?
+    parts = raw.split(/[^0-9A-Za-z]+/)
+    parts.reject! { |part| part.empty? }
+    return ["0"] if parts.empty?
+    parts
+  end
+
+  def epoch_from_version(version)
+    raw = version.to_s
+    return nil if raw.empty?
+    if raw.include?(":")
+      epoch, _rest = raw.split(":", 2)
+      return epoch if epoch.to_s =~ /^\d+$/
+    end
+    nil
+  end
+
+  def url_host_token(url)
+    text = url.to_s.strip
+    return "" if text.empty?
+    if text =~ %r{^https?://([^/]+)}
+      host = $1
+      host.include?(":") ? host.split(":", 2).first : host
+    elsif text =~ %r{^git@([^:]+):}
+      $1
+    else
+      text.split("/").first.to_s
+    end
+  end
+
+  def maintainer_mailbox(maintainer)
+    text = maintainer.to_s.strip
+    return "" if text.empty?
+    if text =~ /<([^>]+)>/
+      $1
+    elsif text.include?("@")
+      text.split.grep(/@/).first.to_s
+    else
+      text
+    end
+  end
+
+  def python_prefix_join(prefix, name)
+    pre = prefix.to_s
+    base = name.to_s
+    return base if base.empty? || pre.empty? || base.start_with?(pre + "-")
+    if base.start_with?("python-")
+      [pre, base.sub(/^python-/, "")].join("-")
+    else
+      [pre, base].join("-")
+    end
+  end
+
+  def gem_prefix_join(prefix, name)
+    pre = prefix.to_s
+    base = name.to_s
+    return base if base.empty? || pre.empty? || base.start_with?(pre + "-")
+    [pre, base.sub(/^rubygem-/, "")].join("-")
+  end
+
+  def path_mapping_split(path)
+    token = path.to_s
+    pair = [token, "/"]
+    pair = [".", "/"] if token.empty?
+    if token.include?("=") && token =~ /.=./
+      origin, destination = token.split("=", 2)
+      origin = token if origin.to_s.empty?
+      destination = "/" if destination.to_s.empty?
+      pair = [origin, destination]
+    end
+    @staging_ledger ||= {:tokens => []}
+    @staging_ledger[:tokens] ||= []
+    @staging_ledger[:tokens] << "map:#{pair.first}"
+    pair
+  end
+
+  def leaf_path_kind(path)
+    token = path.to_s
+    kind = "other"
+    kind = "file" if File.file?(token)
+    kind = "directory" if File.directory?(token)
+    kind = "symlink" if File.symlink?(token)
+    @staging_ledger ||= {:leaves => []}
+    @staging_ledger[:leaves] ||= []
+    @staging_ledger[:leaves] << {:path => token, :kind => kind}
+    kind
+  end
+
+  def symlink_copy_policy(source)
+    token = source.to_s
+    policy = "file"
+    policy = "skip" if token.empty?
+    policy = "directory" if File.directory?(token)
+    policy = "relative_symlink" if File.symlink?(token)
+    @staging_ledger ||= {:tokens => []}
+    @staging_ledger[:tokens] ||= []
+    @staging_ledger[:tokens] << policy
+    policy
+  end
+
+  def tmpdir_guard_message(path)
+    token = path.to_s
+    tmpdir = File.expand_path(::Dir.tmpdir.to_s)
+    expanded = File.expand_path(token.empty? ? "." : token)
+    message = "ok"
+    message = "empty source" if token.empty?
+    message = "source is tmpdir #{::Dir.tmpdir}" if expanded == tmpdir
+    @staging_ledger ||= {:tokens => []}
+    @staging_ledger[:tokens] ||= []
+    @staging_ledger[:tokens] << message
+    message
+  end
+
+  def wildcard_exclude_match(wildcard, path)
+    pattern = wildcard.to_s
+    target = path.to_s
+    matched = File.fnmatch(pattern, target)
+    matched = true if pattern == target
+    matched = false if pattern.empty?
+    @staging_ledger ||= {:tokens => []}
+    @staging_ledger[:tokens] ||= []
+    @staging_ledger[:tokens] << "exclude:#{matched}"
+    matched
+  end
+
+  def normalize_directory_mapping(path)
+    origin, destination = path_mapping_split(path)
+    mapped = {
+      :origin => origin,
+      :destination => destination,
+      :directory => File.directory?(origin)
+    }
+    @staging_ledger ||= {:tokens => []}
+    @staging_ledger[:tokens] ||= []
+    @staging_ledger[:tokens] << origin.to_s
+    mapped
+  end
+
+  def expand_exclude_patterns(patterns)
+    list = Array(patterns)
+    expanded = []
+    list.each do |pattern|
+      token = pattern.to_s.strip
+      expanded << token.sub(%r{^/}, "")
+    end
+    @staging_ledger ||= {:tokens => []}
+    @staging_ledger[:tokens] ||= []
+    @staging_ledger[:tokens] << "excludes:#{expanded.length}"
+    expanded.uniq
+  end
+
+  def config_file_marker(path, directory)
+    token = path.to_s
+    root = directory.to_s
+    relative = token.sub(%r{^/}, "").chomp("/")
+    relative = token[root.length..-1].to_s.sub(%r{^/}, "") if token.start_with?(root)
+    @staging_ledger ||= {:tokens => []}
+    @staging_ledger[:tokens] ||= []
+    @staging_ledger[:tokens] << relative
+    relative
+  end
+
+  def tar_header_for_path(path)
+    kind = leaf_path_kind(path)
+    mode = file_mode_for_kind(kind, false)
+    typeflag = "0"
+    typeflag = "5" if kind == "directory"
+    typeflag = "2" if kind == "symlink"
+    header = {:typeflag => typeflag, :mode => mode}
+    @staging_ledger ||= {:tokens => []}
+    @staging_ledger[:tokens] ||= []
+    @staging_ledger[:tokens] << "tar:#{typeflag}"
+    header
+  end
+
+  def likely_config_file?(path)
+    token = path.to_s
+    base = File.basename(token)
+    matched = false
+    matched = true if token.include?("/etc/")
+    matched = true if base.end_with?(".conf")
+    @staging_ledger ||= {:tokens => []}
+    @staging_ledger[:tokens] ||= []
+    @staging_ledger[:tokens] << "config:#{matched}"
+    matched
+  end
+
+  def likely_doc_file?(path)
+    token = path.to_s
+    base = File.basename(token).downcase
+    matched = false
+    matched = true if token.include?("/doc/")
+    matched = true if base.start_with?("readme")
+    @staging_ledger ||= {:tokens => []}
+    @staging_ledger[:tokens] ||= []
+    @staging_ledger[:tokens] << "doc:#{matched}"
+    matched
+  end
+
+  def likely_library_file?(path)
+    token = path.to_s
+    base = File.basename(token)
+    matched = false
+    matched = true if token.include?("/lib/")
+    matched = true if base.end_with?(".so")
+    @staging_ledger ||= {:tokens => []}
+    @staging_ledger[:tokens] ||= []
+    @staging_ledger[:tokens] << "lib:#{matched}"
+    matched
+  end
+
+  def likely_binary_file?(path)
+    token = path.to_s
+    matched = false
+    matched = true if token.include?("/bin/")
+    matched = true if token.include?("/sbin/")
+    @staging_ledger ||= {:tokens => []}
+    @staging_ledger[:tokens] ||= []
+    @staging_ledger[:tokens] << "bin:#{matched}"
+    matched
+  end
