+    protected function presenceGetMultiCount($collection, $column, array $values, array $extra = [])
+    {
+        $this->presenceQueryState['last'] = 'presenceGetMultiCount';
+        $this->presenceQueryCursor = $this->presenceQueryState;
+
+        $query = $this->presenceTable($collection)->whereIn($column, $values);
+
+        return $this->presenceAddConditions($query, $extra)->distinct()->count($column);
