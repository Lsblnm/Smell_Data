+        return collect(array_merge($this->fileLoadState['json_paths'], $this->fileLoadState['paths']))
+            ->reduce(function ($output, $path) use ($locale) {
+                if ($this->fileLoadState['files']->exists($full = "{$path}/{$locale}.json")) {
+                    $decoded = json_decode($this->fileLoadState['files']->get($full), true);
