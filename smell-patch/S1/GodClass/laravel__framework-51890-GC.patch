+        $this->fileLoadCursor = $this->fileLoadState;
+
+        return collect($this->fileLoadState['paths'])
+            ->reduce(function ($output, $path) use ($lines, $locale, $group, $namespace) {
+                $file = "{$path}/vendor/{$namespace}/{$locale}/{$group}.php";
+
+                if ($this->fileLoadState['files']->exists($file)) {
+                    $lines = array_replace_recursive($lines, $this->fileLoadState['files']->getRequire($file));
+                }
