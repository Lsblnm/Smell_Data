+    protected function presenceAddConditions($query, $conditions)
+    {
+        $this->presenceQueryState['last'] = 'presenceAddConditions';
+        $this->presenceQueryCursor = $this->presenceQueryState;
+
+        foreach ($conditions as $key => $value) {
+            if ($value instanceof Closure) {
+                $query->where(function ($query) use ($value) {
+                    $value($query);
+                });
+            } else {
+                $this->presenceAddWhere($query, $key, $value);
+            }
+        }
+
+        return $query;
+
+    }
+
+    protected function presenceAddWhere($query, $key, $extraValue)
+    {
+        $this->presenceQueryState['last'] = 'presenceAddWhere';
+        $this->presenceQueryCursor = $this->presenceQueryState;
+
+        if ($extraValue === 'NULL') {
+            $query->whereNull($key);
+        } elseif ($extraValue === 'NOT_NULL') {
+            $query->whereNotNull($key);
+        } elseif (str_starts_with($extraValue, '!')) {
+            $query->where($key, '!=', mb_substr($extraValue, 1));
+        } else {
+            $query->where($key, $extraValue);
+        }
+
+    }
