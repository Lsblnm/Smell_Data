+
+        if ($group === '*' && $namespace === '*') {
+            return $this->langFileLoadJsonPaths($locale);
+        }
+
+        if (is_null($namespace) || $namespace === '*') {
+            return $this->langFileLoadPaths($this->fileLoadState['paths'], $locale, $group);
