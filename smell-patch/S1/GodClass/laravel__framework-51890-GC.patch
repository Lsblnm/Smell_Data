+    protected function presenceGetCount($collection, $column, $value, $excludeId = null, $idColumn = null, array $extra = [])
+    {
+        $this->presenceQueryState['last'] = 'presenceGetCount';
+        $this->presenceQueryCursor = $this->presenceQueryState;
+
+        $query = $this->presenceTable($collection)->where($column, '=', $value);
+
+        if (! is_null($excludeId) && $excludeId !== 'NULL') {
+            $query->where($idColumn ?: 'id', '<>', $excludeId);
+        }
+
+        return $this->presenceAddConditions($query, $extra)->count();
+
+    }
