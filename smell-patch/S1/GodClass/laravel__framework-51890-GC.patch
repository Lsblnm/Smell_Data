+
+        if (isset($this->fileLoadState['hints'][$namespace])) {
+            $lines = $this->langFileLoadPaths([$this->fileLoadState['hints'][$namespace]], $locale, $group);
+
+            return $this->langFileLoadNamespaceOverrides($lines, $locale, $group, $namespace);
