+        $this->fileLoadCursor = $this->fileLoadState;
+
+        return collect($paths)
+            ->reduce(function ($output, $path) use ($locale, $group) {
+                if ($this->fileLoadState['files']->exists($full = "{$path}/{$locale}/{$group}.php")) {
+                    $output = array_replace_recursive($output, $this->fileLoadState['files']->getRequire($full));
+                }
