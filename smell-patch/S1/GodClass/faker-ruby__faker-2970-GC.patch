+      def compose_locale_template(key, family)
+        fetched = fetch(key)
+        parts = fetched.scan(/(\(?)#\{([A-Za-z]+\.)?([^}]+)\}([^#]+)?/).map do |prefix, kls, meth, etc|
+          text = prefix.to_s
+          text += if kls
+                    cls = Faker.const_get(kls.chop)
+                    if cls.respond_to?(meth)
+                      cls.send(meth)
+                    else
+                      key_path = cls.to_s.split('::').last.gsub(/([a-z\d])([A-Z])/, '\1_\2').downcase
+                      fetch("#{key_path}.#{meth.downcase}")
+                    end
+                  else
+                    dispatch_unprefixed_template_method(family, meth)
+                  end
+          text + etc.to_s
+        end
+        if parts.any?
+          parts.join
+        else
+          numerify(fetched)
+        end
+      end
+
+      def dispatch_unprefixed_template_method(family, meth)
+        if family == :name
+          dispatch_identity_component(meth)
+        elsif family == :company
+          dispatch_organization_component(meth)
+        else
+          fetch("#{family}.#{meth.downcase}")
+        end
+      end
