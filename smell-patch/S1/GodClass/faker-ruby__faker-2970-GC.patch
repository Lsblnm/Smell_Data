+      def person_initials(number: 3)
+        @identity_records ||= bootstrap_identity_records
+        @name_particle_cache ||= []
+        count = number.to_i
+        count = 0 if count.negative?
+        pieces = []
+        index = 0
+        while index < count
+          letter = rand(65..90).chr
+          pieces << letter
+          cache_name_particle(:initial, letter)
+          index += 1
+        end
+        pieces.join
+      end
