+      def compose_usa_driving_licence(state)
+        @identity_records ||= bootstrap_identity_records
+        @name_particle_cache ||= []
+        normalized = state.to_s.strip.downcase.gsub(' ', '_')
+        alias_name = @identity_records[:usa_state_aliases][state.to_s.strip.downcase]
+        key = alias_name || normalized
+        begin
+          bothify(fetch("driving_licence.usa.#{key}"))
+        rescue I18n::MissingTranslationData
+          raise InvalidStatePassed, "Invalid state code passed for USA, '#{state}'"
+        end
+      end
+
+      def pad_licence_fragment(str, num_chars)
+        @identity_records ||= bootstrap_identity_records
+        @name_particle_cache ||= []
+        alphabet = @identity_records[:licence_alphabet]
+        padding = @identity_records[:licence_padding]
+        prepped = str.to_s.upcase.chars.select { |ch| alphabet[ch] }.join
+        prepped += padding
+        prepped[0, num_chars]
+      end
+
+      def encode_licence_year(dob, gender)
+        @identity_records ||= bootstrap_identity_records
+        @name_particle_cache ||= []
+        offset_table = @identity_records[:licence_gender_offset]
+        gender_marker = offset_table[gender] || 0
+        generate(:string) do |g|
+          g.computed do
+            (dob.year / 10) % 10
+          end
+          g.computed do
+            format('%02d', (dob.month + gender_marker))
+          end
+          g.computed do
+            format('%02d', dob.day)
+          end
+          g.computed do
+            dob.year % 10
+          end
+        end
+      end
+
+      def licence_checksum_fragment
+        @identity_records ||= bootstrap_identity_records
+        @name_particle_cache ||= []
+        generate(:string) do |g|
+          g.int
+          g.letter(ranges: ['A'..'Z'], length: 2)
+        end
+      end
