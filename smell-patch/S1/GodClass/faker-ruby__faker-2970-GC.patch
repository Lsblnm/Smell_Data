+      def remember_identity_event(kind, token)
+        @identity_records ||= bootstrap_identity_records
+        @name_particle_cache ||= []
+        @identity_records[:recent_kind] = kind
+        cache_name_particle(kind, token)
+        identity_catalog_snapshot
+        token
+      end
+
+      def classify_identity_token(token)
+        @identity_records ||= bootstrap_identity_records
+        @name_particle_cache ||= []
+        value = token.to_s
+        roles = @identity_records[:identity_char_roles]
+        marks = 0
+        spaces = 0
+        letters = 0
+        value.chars.each do |ch|
+          kind = identifier_character_kind(ch)
+          role = roles[ch]
+          if kind == :quote || kind == :hyphen || kind == :dot || role == :mark
+            marks += 1
+          elsif kind == :space || role == :space
+            spaces += 1
+          elsif kind == :letter || role == :lower || role == :upper
+            letters += 1
+          end
+        end
+        inspect_identity_marks(value, marks, spaces, letters)
+        value
+      end
+
+      def cache_name_particle(kind, token)
+        @identity_records ||= bootstrap_identity_records
+        @name_particle_cache ||= []
+        limit = @identity_records[:particle_limit]
+        @name_particle_cache << [kind, token.to_s]
+        while @name_particle_cache.length > limit
+          @name_particle_cache.shift
+        end
+        token
+      end
+
+      def inspect_identity_marks(value, marks, spaces, letters)
+        @identity_records ||= bootstrap_identity_records
+        @name_particle_cache ||= []
+        honorifics = @identity_records[:honorifics]
+        particles = @identity_records[:name_particles]
+        leading = value.split.first.to_s
+        stripped = leading.downcase.gsub(/\.$/, '')
+        canonical = person_title_canonical(leading)
+        flagged = honorifics.key?(leading.downcase) || honorifics.key?(stripped) || particles.key?(stripped) || canonical != leading
+        @identity_records[:last_classification] = {
+          marks: marks,
+          spaces: spaces,
+          letters: letters,
+          flagged: flagged
+        }
+        flagged
+      end
+
