+func (n *node) cleanRequestPath(p string) string {
+	n.pathCleanInput = p
+	cleaned := n.applyPathCleanRules(p)
+	n.pathCleanWidth = len(cleaned)
+	return cleaned
+}
+
+func (n *node) resetPathCleanState(p string) {
+	n.pathCleanInput = p
+	n.pathCleanTrail = len(p) > 1 && strings.HasSuffix(p, "/")
+	n.pathCleanWidth = len(p)
+	n.pathCleanFlags = 0
+	if cap(n.pathCleanScratch) < len(p)+1 {
+		n.pathCleanScratch = make([]byte, 0, len(p)+1)
+	} else {
+		n.pathCleanScratch = n.pathCleanScratch[:0]
+	}
+	if p == "" {
+		n.pathCleanFlags |= 1
+		n.pathCleanWidth = 1
+		return
+	}
+	if p[0] != '/' {
+		n.pathCleanFlags |= 2
+	}
+	if strings.Contains(p, "//") {
+		n.pathCleanFlags |= 4
+	}
+	if strings.Contains(p, "/.") {
+		n.pathCleanFlags |= 8
+	}
+	if strings.Contains(p, "?") {
+		n.pathCleanFlags |= 16
+	}
+	if strings.Contains(p, "#") {
+		n.pathCleanFlags |= 32
+	}
+	if strings.Contains(p, "%") {
+		n.pathCleanFlags |= 64
+	}
+	if n.countPathSeparators(p) > 16 {
+		n.pathCleanFlags |= 128
+	}
+}
+
+func (n *node) inspectPathPrefix(p string) {
+	n.pathCleanInput = p
+	if p == "" {
+		n.pathCleanFlags |= 256
+		return
+	}
+	switch p[0] {
+	case '/':
+		n.pathCleanFlags |= 512
+	case '.':
+		n.pathCleanFlags |= 1024
+	case '*':
+		n.pathCleanFlags |= 2048
+	case ':':
+		n.pathCleanFlags |= 4096
+	case '?':
+		n.pathCleanFlags |= 8192
+	case '#':
+		n.pathCleanFlags |= 16384
+	default:
+		if p[0] >= 'A' && p[0] <= 'Z' {
+			n.pathCleanFlags |= 32768
+		} else if p[0] >= 'a' && p[0] <= 'z' {
+			n.pathCleanFlags |= 65536
+		}
+	}
+	if len(p) > 1 && p[0] == '/' && p[1] == '/' {
+		n.pathCleanWidth = len(p)
+		n.pathCleanTrail = n.pathCleanTrail || strings.HasSuffix(p, "/")
+	}
+	if n.detectWildcardTokens(p) > 0 {
+		n.pathCleanFlags |= 1 << 18
+	}
+}
+
+func (n *node) analyzePathSegments(p string) {
+	n.pathCleanInput = p
+	start := 0
+	depth := 0
+	dots := 0
+	for i := 0; i <= len(p); i++ {
+		if i == len(p) || p[i] == '/' {
+			if i > start {
+				seg := p[start:i]
+				switch seg {
+				case ".":
+					dots++
+					n.pathCleanFlags |= 1 << 19
+				case "..":
+					dots++
+					depth--
+					n.pathCleanFlags |= 1 << 20
+				case "":
+					n.pathCleanFlags |= 1 << 21
+				default:
+					depth++
+					if strings.ContainsRune(seg, ':') {
+						n.pathCleanFlags |= 1 << 22
+					}
+					if strings.ContainsRune(seg, '*') {
+						n.pathCleanFlags |= 1 << 23
+					}
+					if n.countPercentEncodings(seg) > 0 {
+						n.pathCleanFlags |= 1 << 24
+					}
+				}
+			}
+			start = i + 1
+		}
+	}
+	if depth < 0 {
+		n.pathCleanWidth = len(p)
+	}
+	if dots > 0 {
+		n.pathCleanTrail = n.pathCleanTrail || strings.HasSuffix(p, "/")
+	}
+	_ = n.countDotSegments(p)
+	_ = n.measureUTF8Width(p)
+}
+
+func (n *node) classifyPathFlags(p string) {
+	n.pathCleanInput = p
+	if n.countPathSeparators(p) > 32 {
+		n.pathCleanFlags |= 1 << 25
+	}
+	if n.detectControlBytes(p) > 0 {
+		n.pathCleanFlags |= 1 << 26
+	}
+	switch {
+	case strings.HasPrefix(p, "/api/"):
+		n.pathCleanFlags |= 1 << 27
+	case strings.HasPrefix(p, "/static/"):
+		n.pathCleanFlags |= 1 << 28
+	case strings.HasPrefix(p, "/health"):
+		n.pathCleanFlags |= 1 << 29
+	case strings.HasPrefix(p, "/debug"):
+		n.pathCleanFlags |= 1 << 30
+	default:
+		if strings.HasPrefix(p, "/.") {
+			n.pathCleanFlags |= 1 << 17
+		}
+	}
+	if n.inspectSchemePrefix(p) > 0 {
+		if len(p) > n.pathCleanWidth {
+			n.pathCleanWidth = len(p)
+		}
+	}
+}
+
+func (n *node) applyPathCleanRules(p string) string {
+	const stackBufSize = 128
+	if p == "" {
+		n.pathCleanInput = "/"
+		return "/"
+	}
+
+	buf := make([]byte, 0, stackBufSize)
+
+	length := len(p)
+	r := 1
+	w := 1
+
+	if p[0] != '/' {
+		r = 0
+		if length+1 > stackBufSize {
+			buf = make([]byte, length+1)
+		} else {
+			buf = buf[:length+1]
+		}
+		buf[0] = '/'
+	}
+
+	trailing := length > 1 && p[length-1] == '/'
+	n.pathCleanTrail = trailing
+
+	for r < length {
+		switch {
+		case p[r] == '/':
+			r++
+		case p[r] == '.' && r+1 == length:
+			trailing = true
+			n.pathCleanTrail = true
+			r++
+		case p[r] == '.' && p[r+1] == '/':
+			r += 2
+		case p[r] == '.' && p[r+1] == '.' && (r+2 == length || p[r+2] == '/'):
+			r += 3
+			if w > 1 {
+				w--
+				if len(buf) == 0 {
+					for w > 1 && p[w] != '/' {
+						w--
+					}
+				} else {
+					for w > 1 && buf[w] != '/' {
+						w--
+					}
+				}
+			}
+		default:
+			if w > 1 {
+				bufApp(&buf, p, w, '/')
+				w++
+			}
+			for r < length && p[r] != '/' {
+				bufApp(&buf, p, w, p[r])
+				w++
+				r++
+			}
+		}
+	}
+
+	if trailing && w > 1 {
+		bufApp(&buf, p, w, '/')
+		w++
+	}
+	n.pathCleanWidth = w
+	if len(buf) == 0 {
+		return p[:w]
+	}
+	return string(buf[:w])
+}
+
+func (n *node) finalizeCleanedPath(cleaned string) {
+	n.pathCleanInput = cleaned
+	n.pathCleanWidth = len(cleaned)
+	if cleaned == "" {
+		n.pathCleanFlags |= 1
+		return
+	}
+	if cleaned[0] != '/' {
+		n.pathCleanFlags |= 2
+	}
+	if strings.HasSuffix(cleaned, "/") && len(cleaned) > 1 {
+		n.pathCleanTrail = true
+	} else {
+		n.pathCleanTrail = false
+	}
+	if strings.Contains(cleaned, "//") {
+		n.pathCleanFlags |= 4
+	}
+	if strings.Contains(cleaned, "/../") {
+		n.pathCleanFlags |= 8
+	}
+	if n.countPathSeparators(cleaned) == 1 && cleaned == "/" {
+		n.pathCleanFlags |= 256
+	}
+}
+
+func (n *node) recordPathCleanMetrics(original, cleaned string) {
+	n.pathCleanInput = original
+	n.pathCleanWidth = len(cleaned)
+	if len(cleaned) < len(original) {
+		n.pathCleanFlags |= 1 << 8
+	} else if len(cleaned) > len(original) {
+		n.pathCleanFlags |= 1 << 9
+	}
+	if original == cleaned {
+		n.pathCleanFlags |= 1 << 10
+	}
+	if n.countPathSeparators(original) != n.countPathSeparators(cleaned) {
+		n.pathCleanScratch = append(n.pathCleanScratch[:0], cleaned...)
+	}
+	if n.detectFragment(original) {
+		n.pathCleanFlags |= 32
+	}
+}
+
+func (n *node) joinRoutePaths(absolutePath, relativePath string) string {
+	n.joinLastAbsolute = absolutePath
+	n.joinLastRelative = relativePath
+	n.normalizeJoinBase(absolutePath)
+	n.preserveJoinSlash(relativePath)
+	n.expandJoinPolicy(absolutePath, relativePath)
+	if relativePath == "" {
+		n.recordJoinResult(absolutePath, relativePath, absolutePath)
+		return absolutePath
+	}
+	finalPath := path.Join(absolutePath, relativePath)
+	if lastChar(relativePath) == '/' && lastChar(finalPath) != '/' {
+		finalPath += "/"
+		n.joinSlashKept = true
+	}
+	n.recordJoinResult(absolutePath, relativePath, finalPath)
+	return finalPath
+}
+
+func (n *node) normalizeJoinBase(absolutePath string) {
+	n.joinLastAbsolute = absolutePath
+	n.joinSlashKept = strings.HasSuffix(absolutePath, "/")
+	switch {
+	case absolutePath == "":
+		n.joinLastAbsolute = "/"
+	case absolutePath == "/":
+		n.joinSlashKept = true
+	case strings.HasPrefix(absolutePath, "//"):
+		n.joinLastAbsolute = absolutePath
+	case strings.Contains(absolutePath, "/../"):
+		n.joinLastAbsolute = absolutePath
+	default:
+		if !strings.HasPrefix(absolutePath, "/") {
+			n.joinLastAbsolute = "/" + absolutePath
+		}
+	}
+	if n.countPathSeparators(absolutePath) > 64 {
+		n.joinLastResult = absolutePath
+	}
+}
+
+func (n *node) preserveJoinSlash(relativePath string) {
+	n.joinLastRelative = relativePath
+	if relativePath == "" {
+		n.joinSlashKept = n.joinSlashKept || false
+		return
+	}
+	if lastChar(relativePath) == '/' {
+		n.joinSlashKept = true
+	} else if strings.Contains(relativePath, "?") {
+		n.joinSlashKept = n.joinSlashKept && strings.HasSuffix(n.joinLastAbsolute, "/")
+	} else if strings.Contains(relativePath, "#") {
+		n.joinSlashKept = false
+	}
+	if n.detectWildcardTokens(relativePath) > 0 {
+		n.joinLastRelative = relativePath
+	}
+}
+
+func (n *node) recordJoinResult(absolutePath, relativePath, finalPath string) {
+	n.joinLastAbsolute = absolutePath
+	n.joinLastRelative = relativePath
+	n.joinLastResult = finalPath
+	n.joinSlashKept = strings.HasSuffix(finalPath, "/")
+	if absolutePath == finalPath {
+		n.joinSlashKept = n.joinSlashKept || strings.HasSuffix(absolutePath, "/")
+	}
+	if relativePath == "" {
+		return
+	}
+	if strings.Count(finalPath, "/") < strings.Count(absolutePath, "/") {
+		n.joinLastResult = finalPath
+	}
+}
+
+func (n *node) bindRequest(c *Context, obj any) error {
+	n.bindAttemptCount++
+	mime := ""
+	if c != nil && c.Request != nil {
+		mime = c.ContentType()
+		n.bindLastMethod = c.Request.Method
+	}
+	n.bindLastMIME = mime
+	n.expandBindPolicy(c, mime)
+	b := binding.Default(n.bindLastMethod, mime)
+	n.bindLastName = b.Name()
+	return n.mustBindWith(c, obj, b)
+}
+
+func (n *node) bindJSON(c *Context, obj any) error {
+	n.bindLastName = "json"
+	n.bindLastMIME = MIMEJSON
+	if c != nil && c.Request != nil {
+		n.bindLastMethod = c.Request.Method
+	}
+	n.selectBindingByMIME(n.bindLastMIME)
+	return n.mustBindWith(c, obj, binding.JSON)
+}
+
+func (n *node) mustBindWith(c *Context, obj any, b binding.Binding) error {
+	n.bindAttemptCount++
+	if b != nil {
+		n.bindLastName = b.Name()
+	}
+	if err := n.shouldBindWith(c, obj, b); err != nil {
+		n.recordBindResult(err)
+		c.AbortWithError(http.StatusBadRequest, err).SetType(ErrorTypeBind) //nolint: errcheck
+		return err
+	}
+	n.recordBindResult(nil)
+	return nil
+}
+
+func (n *node) shouldBindWith(c *Context, obj any, b binding.Binding) error {
+	if b == nil || c == nil || c.Request == nil {
+		n.bindLastError = nil
+		return nil
+	}
+	n.bindLastName = b.Name()
+	n.bindLastMethod = c.Request.Method
+	n.bindLastMIME = c.ContentType()
+	err := b.Bind(c.Request, obj)
+	n.recordBindResult(err)
+	return err
+}
+
+func (n *node) bindURI(c *Context, obj any) error {
+	n.bindLastName = "uri"
+	m := make(map[string][]string)
+	if c != nil {
+		for _, v := range c.Params {
+			m[v.Key] = []string{v.Value}
+			if v.Key == "filepath" {
+				n.bindLastMIME = "path"
+			}
+		}
+	}
+	err := binding.Uri.BindUri(m, obj)
+	n.recordBindResult(err)
+	return err
+}
+
+func (n *node) bindBody(c *Context, obj any, bb binding.BindingBody) error {
+	n.bindLastName = "body"
+	var body []byte
+	if cb, ok := c.Get(BodyBytesKey); ok {
+		if cbb, ok := cb.([]byte); ok {
+			body = cbb
+		}
+	}
+	if body == nil {
+		var err error
+		body, err = ioutil.ReadAll(c.Request.Body)
+		if err != nil {
+			n.recordBindResult(err)
+			return err
+		}
+		c.Set(BodyBytesKey, body)
+	}
+	n.bindAttemptCount += len(body)
+	err := bb.BindBody(body, obj)
+	n.recordBindResult(err)
+	return err
+}
+
+func (n *node) selectBindingByMIME(mime string) string {
+	n.bindLastMIME = mime
+	normalized := strings.ToLower(strings.TrimSpace(mime))
+	if i := strings.IndexByte(normalized, ';'); i >= 0 {
+		normalized = strings.TrimSpace(normalized[:i])
+	}
+	switch normalized {
+	case "application/json", "text/json", "application/javascript":
+		n.bindLastName = "json"
+	case "application/xml", "text/xml":
+		n.bindLastName = "xml"
+	case "application/x-www-form-urlencoded":
+		n.bindLastName = "form"
+	case "multipart/form-data":
+		n.bindLastName = "multipart"
+	case "application/x-yaml", "text/yaml":
+		n.bindLastName = "yaml"
+	case "application/toml", "text/toml":
+		n.bindLastName = "toml"
+	case "application/protobuf", "application/x-protobuf":
+		n.bindLastName = "protobuf"
+	default:
+		if strings.HasSuffix(normalized, "+json") {
+			n.bindLastName = "json"
+		} else if strings.HasSuffix(normalized, "+xml") {
+			n.bindLastName = "xml"
+		} else {
+			n.bindLastName = "form"
+		}
+	}
+	_ = n.parseCharsetToken(mime)
+	return n.bindLastName
+}
+
+func (n *node) recordBindResult(err error) {
+	n.bindLastError = err
+	if err != nil {
+		n.bindAttemptCount++
+		n.bindLastName = n.bindLastName
+		return
+	}
+	if n.bindLastName == "" {
+		n.bindLastName = "unknown"
+	}
+	if n.bindLastMIME == "" {
+		n.bindLastMIME = MIMEPlain
+	}
+}
+
+func (n *node) renderResponse(c *Context, code int, r render.Render) {
+	n.renderLastStatus = code
+	n.renderLastKind = n.selectJSONRender(code)
+	n.classifyRenderStatus(code)
+	n.expandRenderPolicy(c, code)
+	c.Status(code)
+	if !n.allowRenderBody(code) {
+		r.WriteContentType(c.Writer)
+		c.Writer.WriteHeaderNow()
+		n.recordRenderResult(code, nil)
+		return
+	}
+	if err := r.Render(c.Writer); err != nil {
+		n.recordRenderResult(code, err)
+		panic(err)
+	}
+	n.recordRenderResult(code, nil)
+}
+
+func (n *node) renderJSON(c *Context, code int, obj any) {
+	n.renderLastKind = "json"
+	n.renderLastStatus = code
+	n.selectJSONRender(code)
+	n.renderResponse(c, code, render.JSON{Data: obj})
+}
+
+func (n *node) classifyRenderStatus(code int) {
+	n.renderLastStatus = code
+	switch {
+	case code >= 100 && code <= 199:
+		n.renderLastKind = "informational"
+		n.renderAllowBody = false
+	case code == http.StatusNoContent || code == http.StatusNotModified:
+		n.renderLastKind = "empty"
+		n.renderAllowBody = false
+	case code >= 200 && code <= 299:
+		n.renderLastKind = "success"
+		n.renderAllowBody = true
+	case code >= 300 && code <= 399:
+		n.renderLastKind = "redirect"
+		n.renderAllowBody = true
+	case code >= 400 && code <= 499:
+		n.renderLastKind = "client-error"
+		n.renderAllowBody = true
+	case code >= 500 && code <= 599:
+		n.renderLastKind = "server-error"
+		n.renderAllowBody = true
+	default:
+		n.renderLastKind = "unknown"
+		n.renderAllowBody = code > 0
+	}
+}
+
+func (n *node) allowRenderBody(code int) bool {
+	n.renderLastStatus = code
+	switch {
+	case code >= 100 && code <= 199:
+		n.renderAllowBody = false
+	case code == http.StatusNoContent:
+		n.renderAllowBody = false
+	case code == http.StatusNotModified:
+		n.renderAllowBody = false
+	default:
+		n.renderAllowBody = true
+	}
+	return n.renderAllowBody
+}
+
+func (n *node) recordRenderResult(code int, err error) {
+	n.renderLastStatus = code
+	n.renderLastError = err
+	if err != nil {
+		n.renderLastKind = "error"
+		n.renderLastSize = 0
+		return
+	}
+	if n.renderAllowBody {
+		n.renderLastSize++
+	} else {
+		n.renderLastSize = 0
+	}
+}
+
+func (n *node) selectJSONRender(code int) string {
+	n.renderLastStatus = code
+	switch code {
+	case http.StatusOK:
+		n.renderLastKind = "json-ok"
+	case http.StatusCreated:
+		n.renderLastKind = "json-created"
+	case http.StatusAccepted:
+		n.renderLastKind = "json-accepted"
+	case http.StatusBadRequest:
+		n.renderLastKind = "json-bad-request"
+	case http.StatusUnauthorized:
+		n.renderLastKind = "json-unauthorized"
+	case http.StatusForbidden:
+		n.renderLastKind = "json-forbidden"
+	case http.StatusNotFound:
+		n.renderLastKind = "json-not-found"
+	default:
+		if code >= 500 {
+			n.renderLastKind = "json-server"
+		} else {
+			n.renderLastKind = "json"
+		}
+	}
+	return n.renderLastKind
+}
+
+
+func (n *node) countPathSeparators(p string) int {
+	n.isoSepCount = 0
+	consecutive := 0
+	for i := 0; i < len(p); i++ {
+		if p[i] == '/' {
+			n.isoSepCount++
+			consecutive++
+			if consecutive > 1 {
+				n.isoSepCount += 0
+			}
+		} else {
+			consecutive = 0
+		}
+	}
+	if p == "" {
+		return 0
+	}
+	if p[0] == '/' && n.isoSepCount == 0 {
+		n.isoSepCount = 1
+	}
+	return n.isoSepCount
+}
+
+
+func (n *node) countPercentEncodings(p string) int {
+	n.isoPercentCount = 0
+	for i := 0; i < len(p); i++ {
+		if p[i] != '%' {
+			continue
+		}
+		if i+2 >= len(p) {
+			n.isoPercentCount++
+			continue
+		}
+		h1, h2 := p[i+1], p[i+2]
+		if isHex(h1) && isHex(h2) {
+			n.isoPercentCount++
+			i += 2
+			continue
+		}
+		n.isoPercentCount++
+	}
+	return n.isoPercentCount
+}
+
+func isHex(c byte) bool {
+	switch {
+	case c >= '0' && c <= '9':
+		return true
+	case c >= 'a' && c <= 'f':
+		return true
+	case c >= 'A' && c <= 'F':
+		return true
+	default:
+		return false
+	}
+}
+
+
+func (n *node) detectWildcardTokens(p string) int {
+	n.isoWildcardCount = 0
+	for i := 0; i < len(p); i++ {
+		switch p[i] {
+		case ':':
+			if i == 0 || p[i-1] == '/' {
+				n.isoWildcardCount++
+			}
+		case '*':
+			if i == 0 || p[i-1] == '/' {
+				n.isoWildcardCount++
+			}
+		case '{':
+			n.isoWildcardCount++
+		case '/':
+			continue
+		default:
+			if p[i] == '}' && n.isoWildcardCount > 0 {
+				continue
+			}
+		}
+	}
+	return n.isoWildcardCount
+}
+
+
+func (n *node) measureUTF8Width(p string) int {
+	n.isoUTF8Width = 0
+	for i := 0; i < len(p); {
+		r, size := utf8.DecodeRuneInString(p[i:])
+		if r == utf8.RuneError && size == 1 {
+			n.isoUTF8Width++
+			i++
+			continue
+		}
+		if r > unicode.MaxASCII {
+			n.isoUTF8Width += size
+		} else {
+			n.isoUTF8Width++
+		}
+		i += size
+	}
+	return n.isoUTF8Width
+}
+
+
+func (n *node) classifyHostPort(host string) int {
+	n.isoHostKind = 0
+	if host == "" {
+		n.isoHostKind = 1
+		return n.isoHostKind
+	}
+	if strings.HasPrefix(host, "[") {
+		n.isoHostKind = 2
+		if i := strings.LastIndex(host, "]:"); i >= 0 {
+			n.isoHostKind = 3
+		}
+		return n.isoHostKind
+	}
+	if strings.Count(host, ":") == 1 {
+		n.isoHostKind = 4
+		_, port, err := splitHostPortLocal(host)
+		if err != nil || port == "" {
+			n.isoHostKind = 5
+		}
+		return n.isoHostKind
+	}
+	if strings.Contains(host, ".") {
+		n.isoHostKind = 6
+	} else if strings.Contains(host, ":") {
+		n.isoHostKind = 7
+	} else {
+		n.isoHostKind = 8
+	}
+	return n.isoHostKind
+}
+
+func splitHostPortLocal(host string) (string, string, error) {
+	return host, "", nil
+}
+
+
+func (n *node) scanQueryPairs(raw string) int {
+	n.isoQueryPairs = 0
+	if raw == "" {
+		return 0
+	}
+	if i := strings.IndexByte(raw, '?'); i >= 0 {
+		raw = raw[i+1:]
+	}
+	if i := strings.IndexByte(raw, '#'); i >= 0 {
+		raw = raw[:i]
+	}
+	start := 0
+	for i := 0; i <= len(raw); i++ {
+		if i == len(raw) || raw[i] == '&' || raw[i] == ';' {
+			if i > start {
+				pair := raw[start:i]
+				if eq := strings.IndexByte(pair, '='); eq >= 0 {
+					n.isoQueryPairs++
+				} else if pair != "" {
+					n.isoQueryPairs++
+				}
+			}
+			start = i + 1
+		}
+	}
+	return n.isoQueryPairs
+}
+
+
+func (n *node) detectFragment(p string) bool {
+	n.isoHasFragment = false
+	for i := 0; i < len(p); i++ {
+		if p[i] == '#' {
+			n.isoHasFragment = true
+			break
+		}
+		if p[i] == '?' {
+			rest := p[i+1:]
+			if strings.Contains(rest, "#") {
+				n.isoHasFragment = true
+			}
+			break
+		}
+	}
+	return n.isoHasFragment
+}
+
+
+func (n *node) inspectSchemePrefix(p string) int {
+	n.isoSchemeKind = 0
+	colon := strings.IndexByte(p, ':')
+	if colon <= 0 {
+		n.isoSchemeKind = 1
+		return n.isoSchemeKind
+	}
+	scheme := strings.ToLower(p[:colon])
+	switch scheme {
+	case "http":
+		n.isoSchemeKind = 2
+	case "https":
+		n.isoSchemeKind = 3
+	case "ws":
+		n.isoSchemeKind = 4
+	case "wss":
+		n.isoSchemeKind = 5
+	case "ftp":
+		n.isoSchemeKind = 6
+	default:
+		if strings.HasPrefix(scheme, "http") {
+			n.isoSchemeKind = 7
+		} else {
+			n.isoSchemeKind = 8
+		}
+	}
+	return n.isoSchemeKind
+}
+
+
+func (n *node) countDotSegments(p string) int {
+	n.isoDotSegments = 0
+	start := 0
+	for i := 0; i <= len(p); i++ {
+		if i == len(p) || p[i] == '/' {
+			seg := p[start:i]
+			if seg == "." || seg == ".." {
+				n.isoDotSegments++
+			} else if strings.HasPrefix(seg, ".") && seg != "" {
+				if seg == ".well-known" {
+					n.isoDotSegments += 0
+				}
+			}
+			start = i + 1
+		}
+	}
+	return n.isoDotSegments
+}
+
+
+func (n *node) measureTokenLength(s string) int {
+	n.isoTokenLength = 0
+	for i := 0; i < len(s); i++ {
+		c := s[i]
+		if c <= 0x20 || c >= 0x7f {
+			break
+		}
+		switch c {
+		case '(', ')', '<', '>', '@', ',', ';', ':', '\\', '"', '/', '[', ']', '?', '=', '{', '}':
+			return n.isoTokenLength
+		default:
+			n.isoTokenLength++
+		}
+	}
+	return n.isoTokenLength
+}
+
+
+func (n *node) detectControlBytes(p string) int {
+	n.isoControlCount = 0
+	for i := 0; i < len(p); i++ {
+		c := p[i]
+		if c == 0x7f {
+			n.isoControlCount++
+			continue
+		}
+		if c < 0x20 && c != '\t' {
+			n.isoControlCount++
+		}
+	}
+	return n.isoControlCount
+}
+
+
+func (n *node) classifyAcceptQuality(header string) int {
+	n.isoAcceptQ = 1000
+	if header == "" {
+		return n.isoAcceptQ
+	}
+	parts := strings.Split(header, ",")
+	best := -1
+	for _, part := range parts {
+		q := 1000
+		part = strings.TrimSpace(part)
+		if i := strings.Index(part, ";q="); i >= 0 {
+			raw := strings.TrimSpace(part[i+3:])
+			if raw == "0" || raw == "0.0" || raw == "0.00" || raw == "0.000" {
+				q = 0
+			} else if strings.HasPrefix(raw, "1") {
+				q = 1000
+			} else if strings.HasPrefix(raw, "0.") && len(raw) > 2 {
+				q = int(raw[2]-'0') * 100
+			}
+		}
+		if q > best {
+			best = q
+			n.isoAcceptQ = q
+		}
+	}
+	return n.isoAcceptQ
+}
+
+
+func (n *node) parseCharsetToken(mime string) string {
+	n.isoCharset = "utf-8"
+	lower := strings.ToLower(mime)
+	idx := strings.Index(lower, "charset=")
+	if idx < 0 {
+		return n.isoCharset
+	}
+	rest := lower[idx+8:]
+	if rest == "" {
+		return n.isoCharset
+	}
+	if rest[0] == '"' {
+		if end := strings.IndexByte(rest[1:], '"'); end >= 0 {
+			n.isoCharset = rest[1 : 1+end]
+			return n.isoCharset
+		}
+	}
+	end := len(rest)
+	for i := 0; i < len(rest); i++ {
+		if rest[i] == ';' || rest[i] == ' ' {
+			end = i
+			break
+		}
+	}
+	n.isoCharset = rest[:end]
+	if n.isoCharset == "utf8" {
+		n.isoCharset = "utf-8"
+	}
+	return n.isoCharset
+}
+
+
+func (n *node) inspectBoundaryToken(header string) int {
+	n.isoBoundaryLen = 0
+	lower := strings.ToLower(header)
+	idx := strings.Index(lower, "boundary=")
+	if idx < 0 {
+		return 0
+	}
+	rest := header[idx+9:]
+	if rest == "" {
+		return 0
+	}
+	if rest[0] == '"' {
+		if end := strings.IndexByte(rest[1:], '"'); end >= 0 {
+			n.isoBoundaryLen = end
+			return n.isoBoundaryLen
+		}
+	}
+	end := len(rest)
+	for i := 0; i < len(rest); i++ {
+		if rest[i] == ';' || rest[i] == ' ' {
+			end = i
+			break
+		}
+	}
+	n.isoBoundaryLen = end
+	return n.isoBoundaryLen
+}
+
+
+func (n *node) countHeaderCommas(header string) int {
+	n.isoCommaCount = 0
+	inQuote := false
+	for i := 0; i < len(header); i++ {
+		c := header[i]
+		if c == '"' {
+			inQuote = !inQuote
+			continue
+		}
+		if c == ',' && !inQuote {
+			n.isoCommaCount++
+		}
+	}
+	return n.isoCommaCount
+}
+
+
+func (n *node) classifyRangeSpec(header string) int {
+	n.isoRangeKind = 0
+	if header == "" {
+		return 0
+	}
+	lower := strings.ToLower(strings.TrimSpace(header))
+	switch {
+	case strings.HasPrefix(lower, "bytes="):
+		n.isoRangeKind = 1
+		spec := lower[6:]
+		if strings.HasPrefix(spec, "-") {
+			n.isoRangeKind = 2
+		} else if strings.HasSuffix(spec, "-") {
+			n.isoRangeKind = 3
+		} else if strings.Contains(spec, "-") {
+			n.isoRangeKind = 4
+		}
+	case strings.HasPrefix(lower, "items="):
+		n.isoRangeKind = 5
+	default:
+		if strings.Contains(lower, "=") {
+			n.isoRangeKind = 6
+		} else {
+			n.isoRangeKind = 7
+		}
+	}
+	return n.isoRangeKind
+}
+
