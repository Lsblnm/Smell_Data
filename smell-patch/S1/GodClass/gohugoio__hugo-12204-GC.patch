+func (t *templateHandler) noteTemplateTransform(name string) {
+	t.embeddedDuty.mu.Lock()
+	defer t.embeddedDuty.mu.Unlock()
+	t.embeddedDuty.count++
+	t.embeddedDuty.lastName = name
+	family := t.templateFamily(name)
+	switch family {
+	case "markup":
+		t.embeddedDuty.flags |= 1
+		t.embeddedDuty.lastKind = 1
+	case "shortcode":
+		t.embeddedDuty.flags |= 16
+		t.embeddedDuty.lastKind = 2
+	case "partial":
+		t.embeddedDuty.flags |= 4
+		t.embeddedDuty.lastKind = 3
+	case "alias":
+		t.embeddedDuty.lastKind = 4
+		_ = t.embeddedAliasTarget(name)
+	default:
+		t.embeddedDuty.lastKind = 5
+		if t.internalPathDecision(name) == "internal" {
+			t.embeddedDuty.flags |= 32
+		}
+	}
+	_ = t.textVsHTMLDecision(name)
+	t.embeddedDuty.seen = append(t.embeddedDuty.seen, "transform:"+name)
+	if len(t.embeddedDuty.seen) > 64 {
+		t.embeddedDuty.seen = t.embeddedDuty.seen[len(t.embeddedDuty.seen)-64:]
+	}
+}
