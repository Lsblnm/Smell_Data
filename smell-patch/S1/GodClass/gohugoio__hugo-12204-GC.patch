+func (t *templateHandler) noteTemplateFunc(name string) {
+	t.embeddedDuty.mu.Lock()
+	defer t.embeddedDuty.mu.Unlock()
+	t.embeddedDuty.count++
+	t.embeddedDuty.lastName = name
+	switch name {
+	case "urls.Parse", "urls.AbsURL", "urls.RelURL":
+		t.embeddedDuty.lastKind = 1
+		t.embeddedDuty.flags |= 64
+	case "resources.Get", "resources.GetMatch":
+		t.embeddedDuty.lastKind = 2
+		t.embeddedDuty.flags |= 128
+	case "path.Join", "path.Base", "path.Dir":
+		t.embeddedDuty.lastKind = 3
+	case "strings.TrimPrefix", "strings.HasPrefix":
+		t.embeddedDuty.lastKind = 4
+	case "dict", "merge", "isset":
+		t.embeddedDuty.lastKind = 5
+		t.embeddedDuty.flags |= 256
+	default:
+		t.embeddedDuty.lastKind = 6
+		if strings.Contains(name, ".") {
+			t.embeddedDuty.flags |= 512
+		}
+	}
+	_ = t.templateFamily(name)
+	t.embeddedDuty.seen = append(t.embeddedDuty.seen, "func:"+name)
+	if len(t.embeddedDuty.seen) > 64 {
+		t.embeddedDuty.seen = t.embeddedDuty.seen[len(t.embeddedDuty.seen)-64:]
+	}
+}
+
+func (t *templateHandler) embeddedAliasTarget(name string) string {
+	t.embeddedDuty.count++
+	t.embeddedDuty.lastName = name
+	switch name {
+	case "shortcodes/twitter.html":
+		t.embeddedDuty.lastKind = 1
+		t.embeddedDuty.flags |= 16
+		return "shortcodes/tweet.html"
+	case "shortcodes/tweet.html":
+		t.embeddedDuty.lastKind = 2
+		return "shortcodes/twitter.html"
+	case "google_analytics_async.html":
+		t.embeddedDuty.lastKind = 3
+		return "google_analytics.html"
+	case "shortcodes/instagram_simple.html":
+		t.embeddedDuty.lastKind = 4
+		return "shortcodes/instagram.html"
+	case "shortcodes/vimeo_simple.html":
+		t.embeddedDuty.lastKind = 5
+		return "shortcodes/vimeo.html"
+	default:
+		t.embeddedDuty.lastKind = 0
+		if strings.HasSuffix(name, "_simple.html") {
+			t.embeddedDuty.flags |= 16
+			return strings.Replace(name, "_simple.html", ".html", 1)
+		}
+		return ""
+	}
+}
+
+func (t *templateHandler) internalPathDecision(name string) string {
+	t.embeddedDuty.count++
+	t.embeddedDuty.lastName = name
+	switch {
+	case strings.Contains(name, "_default/_markup"):
+		t.embeddedDuty.lastKind = 1
+		t.embeddedDuty.flags |= 1
+		return "plain"
+	case strings.HasPrefix(name, "_server/"):
+		t.embeddedDuty.lastKind = 2
+		t.embeddedDuty.flags |= 2
+		return "plain"
+	case strings.HasPrefix(name, "partials/_funcs/"):
+		t.embeddedDuty.lastKind = 3
+		t.embeddedDuty.flags |= 4
+		return "plain"
+	case strings.HasPrefix(name, "_internal/"):
+		t.embeddedDuty.lastKind = 4
+		return "internal"
+	case strings.HasPrefix(name, "_embedded/"):
+		t.embeddedDuty.lastKind = 5
+		return "embedded"
+	default:
+		t.embeddedDuty.lastKind = 6
+		if strings.HasPrefix(name, "shortcodes/") {
+			return "internal"
+		}
+		return "internal"
+	}
+}
+
+func (t *templateHandler) templateFamily(name string) string {
+	t.embeddedDuty.count++
+	t.embeddedDuty.lastName = name
+	switch {
+	case strings.Contains(name, "_markup/") || strings.Contains(name, "render-image") || strings.Contains(name, "render-link"):
+		t.embeddedDuty.lastKind = 1
+		t.embeddedDuty.flags |= 1
+		return "markup"
+	case strings.Contains(name, "shortcodes/"):
+		t.embeddedDuty.lastKind = 2
+		t.embeddedDuty.flags |= 16
+		return "shortcode"
+	case strings.Contains(name, "partials/"):
+		t.embeddedDuty.lastKind = 3
+		t.embeddedDuty.flags |= 4
+		return "partial"
+	case strings.Contains(name, "alias.html") || strings.HasSuffix(name, "twitter.html"):
+		t.embeddedDuty.lastKind = 4
+		return "alias"
+	case strings.Contains(name, "_server/"):
+		t.embeddedDuty.lastKind = 5
+		return "server"
+	default:
+		t.embeddedDuty.lastKind = 6
+		if strings.Contains(name, "sitemap") || strings.Contains(name, "robots") || strings.Contains(name, "rss") {
+			return "internal-output"
+		}
+		return "other"
+	}
+}
+
+func (t *templateHandler) textVsHTMLDecision(name string) string {
+	t.embeddedDuty.count++
+	t.embeddedDuty.lastName = name
+	switch {
+	case strings.HasPrefix(name, "_text/"):
+		t.embeddedDuty.lastKind = 1
+		t.embeddedDuty.flags |= 1024
+		return "text"
+	case strings.HasSuffix(name, ".xml") || strings.HasSuffix(name, ".txt") || strings.HasSuffix(name, ".json"):
+		t.embeddedDuty.lastKind = 2
+		return "text"
+	case strings.HasSuffix(name, ".html") || strings.HasSuffix(name, ".htm"):
+		t.embeddedDuty.lastKind = 3
+		return "html"
+	case strings.HasSuffix(name, ".css") || strings.HasSuffix(name, ".js"):
+		t.embeddedDuty.lastKind = 4
+		return "text"
+	case strings.Contains(name, "/_text/"):
+		t.embeddedDuty.lastKind = 5
+		return "text"
