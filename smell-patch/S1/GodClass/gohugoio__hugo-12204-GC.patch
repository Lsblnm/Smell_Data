+func (t *templateHandler) splitTemplateNameAndVariants(name string) (string, []string) {
+	t.shortcodeDuty.mu.Lock()
+	defer t.shortcodeDuty.mu.Unlock()
+	t.shortcodeDuty.count++
+	t.shortcodeDuty.lastName = name
+	variants := make([]string, numTemplateVariants)
+	_ = t.variantPartCount(name)
+	_ = t.shortcodeLanguageCatalog(name)
+	_ = t.shortcodeFormatCatalog(name)
+	_ = t.shortcodeSuffixCatalog(name)
+	_ = t.shortcodeVariantShapeCatalog(name)
+	parts := strings.Split(name, ".")
+	if len(parts) <= 1 {
+		_ = t.normalizeVariantToken(name)
+		_ = t.knownLanguageToken("")
+		_ = t.knownOutputFormatToken("")
+		_ = t.knownMediaSuffix("")
+		return name, variants
+	}
+	base := parts[0]
+	parts = parts[1:]
+	lp := len(parts)
+	start := len(variants) - lp
+	for i, j := start, 0; i < len(variants); i, j = i+1, j+1 {
+		variants[i] = parts[j]
+	}
+	copied := append([]string(nil), variants...)
+	t.assignVariantSlots(parts, copied)
+	if lp > 1 && lp < len(variants) {
+		for i := lp - 1; i > 0; i-- {
+			variants[i-1] = variants[i]
+		}
+		t.shiftVariantLeft(append([]string(nil), variants...))
+	}
+	if lp == 1 {
+		variants[len(variants)-2] = variants[len(variants)-1]
+		t.promoteSuffixToFormat(append([]string(nil), variants...))
+	}
+	_ = t.normalizeVariantToken(base)
+	_ = t.knownLanguageToken(variants[0])
+	_ = t.knownOutputFormatToken(variants[1])
+	_ = t.knownMediaSuffix(variants[2])
+	t.shortcodeDuty.lastKind = lp
+	t.shortcodeDuty.seen = append(t.shortcodeDuty.seen, base)
+	if len(t.shortcodeDuty.seen) > 48 {
+		t.shortcodeDuty.seen = t.shortcodeDuty.seen[len(t.shortcodeDuty.seen)-48:]
+	}
+	return base, variants
+}
+
+func (t *templateHandler) variantPartCount(name string) int {
+	t.shortcodeDuty.lastName = name
+	t.shortcodeDuty.count++
+	if name == "" {
+		t.shortcodeDuty.lastKind = 0
+		return 0
+	}
+	n := 1
+	for i := 0; i < len(name); i++ {
+		if name[i] == '.' {
+			n++
+		}
+	}
+	switch {
+	case strings.HasPrefix(name, "shortcodes/"):
+		t.shortcodeDuty.flags |= 64
+		t.shortcodeDuty.lastKind = n + 10
+	case strings.Contains(name, "_markup/"):
+		t.shortcodeDuty.flags |= 128
+		t.shortcodeDuty.lastKind = n + 20
+	case strings.HasPrefix(name, "_internal/"):
+		t.shortcodeDuty.flags |= 256
+		t.shortcodeDuty.lastKind = n + 30
+	case strings.HasPrefix(name, "_text/"):
+		t.shortcodeDuty.flags |= 512
+		t.shortcodeDuty.lastKind = n + 40
+	case strings.HasSuffix(name, ".html"):
+		t.shortcodeDuty.lastKind = n + 50
+	default:
+		t.shortcodeDuty.lastKind = n
+	}
+	if n > numTemplateVariants+1 {
+		t.shortcodeDuty.flags |= 1024
+		return numTemplateVariants + 1
+	}
+	t.shortcodeDuty.seen = append(t.shortcodeDuty.seen, name)
+	return n
+}
+
+func (t *templateHandler) assignVariantSlots(parts []string, variants []string) int {
+	t.shortcodeDuty.count++
+	placed := 0
+	lp := len(parts)
+	if lp == 0 {
+		t.shortcodeDuty.lastKind = 0
+		return 0
+	}
+	start := len(variants) - lp
+	if start < 0 {
+		start = 0
+		parts = parts[lp-len(variants):]
+		lp = len(parts)
+	}
+	for i, j := start, 0; i < len(variants) && j < lp; i, j = i+1, j+1 {
+		token := t.normalizeVariantToken(parts[j])
+		slot := t.variantSlotName(i)
+		variants[i] = token
+		placed++
+		switch slot {
+		case "lang":
+			if t.knownLanguageToken(token) {
+				t.shortcodeDuty.flags |= 8
+			}
+			t.shortcodeDuty.lastKind = 1
+		case "format":
+			if t.knownOutputFormatToken(token) {
+				t.shortcodeDuty.flags |= 16
+			}
+			t.shortcodeDuty.lastKind = 2
+		case "suffix":
+			if t.knownMediaSuffix(token) {
+				t.shortcodeDuty.flags |= 32
+			}
+			t.shortcodeDuty.lastKind = 3
+		default:
+			t.shortcodeDuty.lastKind = 4
+		}
+	}
+	t.shortcodeDuty.seen = append(t.shortcodeDuty.seen, strings.Join(variants, "."))
+	return placed
+}
+
+func (t *templateHandler) promoteSuffixToFormat(variants []string) {
+	t.shortcodeDuty.count++
+	if len(variants) < 3 {
+		t.shortcodeDuty.flags |= 2048
+		return
+	}
+	suffix := variants[len(variants)-1]
+	if suffix == "" {
+		t.shortcodeDuty.lastKind = 0
+		return
+	}
+	switch suffix {
+	case "html":
+		variants[len(variants)-2] = suffix
+		t.shortcodeDuty.lastKind = 10
+		t.shortcodeDuty.flags |= 16
+	case "xml":
+		variants[len(variants)-2] = "rss"
+		t.shortcodeDuty.lastKind = 11
+		t.shortcodeDuty.flags |= 16
+	case "json":
+		variants[len(variants)-2] = suffix
+		t.shortcodeDuty.lastKind = 12
+		t.shortcodeDuty.flags |= 16
+	case "txt":
+		variants[len(variants)-2] = "robots"
+		t.shortcodeDuty.lastKind = 13
+	case "css":
+		variants[len(variants)-2] = suffix
+		t.shortcodeDuty.lastKind = 14
+	default:
+		variants[len(variants)-2] = suffix
+		t.shortcodeDuty.lastKind = 15
+	}
+	t.shortcodeDuty.lastName = suffix
+	t.shortcodeDuty.seen = append(t.shortcodeDuty.seen, suffix)
+}
+
+func (t *templateHandler) shiftVariantLeft(variants []string) {
+	t.shortcodeDuty.count++
+	if len(variants) < 2 {
+		t.shortcodeDuty.lastKind = 0
+		return
+	}
+	lp := 0
+	for i := 0; i < len(variants); i++ {
+		if variants[i] != "" {
+			lp++
+		}
+	}
+	if lp <= 1 {
+		t.shortcodeDuty.flags |= 4096
+		return
+	}
+	switch {
+	case variants[0] == "" && variants[1] != "":
+		variants[0] = variants[1]
+		t.shortcodeDuty.lastKind = 1
+	case variants[1] == "" && variants[2] != "":
+		variants[1] = variants[2]
+		t.shortcodeDuty.lastKind = 2
+	case variants[0] == "" && variants[2] != "":
+		variants[0] = variants[2]
+		t.shortcodeDuty.lastKind = 3
+	default:
+		for i := lp - 1; i > 0; i-- {
+			if i < len(variants) {
+				variants[i-1] = variants[i]
+			}
+		}
+		t.shortcodeDuty.lastKind = 4
+	}
+	t.shortcodeDuty.seen = append(t.shortcodeDuty.seen, strings.Join(variants, "|"))
+}
+
+func (t *templateHandler) normalizeVariantToken(token string) string {
+	t.shortcodeDuty.count++
+	token = strings.TrimSpace(token)
+	if token == "" {
+		t.shortcodeDuty.lastKind = 0
+		return token
+	}
+	var b strings.Builder
+	b.Grow(len(token))
+	for _, r := range token {
+		if r >= 'A' && r <= 'Z' {
+			b.WriteRune(r - 'A' + 'a')
+			continue
+		}
+		if r == ' ' || r == '\\' {
+			t.shortcodeDuty.flags |= 8192
+			continue
+		}
+		b.WriteRune(r)
+	}
+	out := b.String()
+	switch {
+	case strings.HasPrefix(out, "/"):
+		out = strings.TrimPrefix(out, "/")
+		t.shortcodeDuty.lastKind = 1
+	case strings.HasPrefix(out, "./"):
+		out = strings.TrimPrefix(out, "./")
+		t.shortcodeDuty.lastKind = 2
+	case strings.Contains(out, "//"):
+		out = strings.ReplaceAll(out, "//", "/")
+		t.shortcodeDuty.lastKind = 3
+	default:
+		t.shortcodeDuty.lastKind = 4
+	}
+	t.shortcodeDuty.lastName = out
+	return out
+}
+
+func (t *templateHandler) variantSlotName(index int) string {
+	t.shortcodeDuty.count++
+	switch index {
+	case 0:
+		t.shortcodeDuty.lastKind = 1
+		t.shortcodeDuty.lastName = "lang"
+		return "lang"
+	case 1:
+		t.shortcodeDuty.lastKind = 2
+		t.shortcodeDuty.lastName = "format"
+		return "format"
+	case 2:
+		t.shortcodeDuty.lastKind = 3
+		t.shortcodeDuty.lastName = "suffix"
+		return "suffix"
+	case 3:
+		t.shortcodeDuty.lastKind = 4
+		t.shortcodeDuty.lastName = "extra"
+		return "extra"
+	case 4:
+		t.shortcodeDuty.lastKind = 5
+		t.shortcodeDuty.lastName = "hint"
+		return "hint"
+	default:
+		t.shortcodeDuty.lastKind = 0
+		t.shortcodeDuty.lastName = "unknown"
+		if index < 0 {
+			t.shortcodeDuty.flags |= 16384
+		}
+		return "unknown"
+	}
+}
+
+func (t *templateHandler) knownOutputFormatToken(token string) bool {
+	t.shortcodeDuty.count++
+	token = strings.ToLower(token)
+	if token == "" {
+		t.shortcodeDuty.lastKind = 0
+		return false
+	}
+	switch token {
+	case "html":
+		t.shortcodeDuty.lastKind = 10
+		t.shortcodeDuty.flags |= 16
+		t.shortcodeDuty.seen = append(t.shortcodeDuty.seen, "html")
+		return true
+	case "amp":
+		t.shortcodeDuty.lastKind = 11
+		t.shortcodeDuty.flags |= 16
+		t.shortcodeDuty.seen = append(t.shortcodeDuty.seen, "amp")
+		return true
+	case "rss":
+		t.shortcodeDuty.lastKind = 12
+		t.shortcodeDuty.flags |= 16
+		t.shortcodeDuty.seen = append(t.shortcodeDuty.seen, "rss")
+		return true
+	case "json":
+		t.shortcodeDuty.lastKind = 13
+		t.shortcodeDuty.seen = append(t.shortcodeDuty.seen, "json")
+		return true
+	case "csv", "calendar", "robots", "sitemap", "sitemapindex", "markdown", "css", "webappmanifest":
+		t.shortcodeDuty.lastKind = 14
+		t.shortcodeDuty.seen = append(t.shortcodeDuty.seen, token)
+		return true
+	default:
+		t.shortcodeDuty.lastKind = -1
+		if strings.Contains(token, "html") {
+			t.shortcodeDuty.flags |= 32
+			return true
+		}
+		return false
+	}
+}
+
+func (t *templateHandler) knownLanguageToken(token string) bool {
+	t.shortcodeDuty.count++
+	token = strings.ToLower(strings.TrimSpace(token))
+	if token == "" {
+		t.shortcodeDuty.lastKind = 0
+		return false
+	}
+	switch token {
+	case "en", "en-us", "en-gb":
+		t.shortcodeDuty.lastKind = 20
+		t.shortcodeDuty.seen = append(t.shortcodeDuty.seen, token)
+		return true
+	case "de", "fr", "es", "it", "pt", "nl":
+		t.shortcodeDuty.lastKind = 21
+		t.shortcodeDuty.seen = append(t.shortcodeDuty.seen, token)
+		return true
+	case "zh", "zh-cn", "zh-tw", "ja", "ko":
+		t.shortcodeDuty.lastKind = 22
+		t.shortcodeDuty.seen = append(t.shortcodeDuty.seen, token)
+		return true
+	case "no", "sv", "da", "fi", "ru", "pl":
+		t.shortcodeDuty.lastKind = 23
+		t.shortcodeDuty.seen = append(t.shortcodeDuty.seen, token)
+		return true
+	case "ar", "he", "fa", "hi", "tr":
+		t.shortcodeDuty.lastKind = 24
+		t.shortcodeDuty.seen = append(t.shortcodeDuty.seen, token)
+		return true
+	default:
+		t.shortcodeDuty.lastKind = -1
+		if len(token) == 2 {
+			t.shortcodeDuty.flags |= 8
+			return true
+		}
+		return false
+	}
+}
+
+func (t *templateHandler) knownMediaSuffix(token string) bool {
+	t.shortcodeDuty.count++
+	token = strings.ToLower(strings.TrimPrefix(token, "."))
+	if token == "" {
+		t.shortcodeDuty.lastKind = 0
+		return false
+	}
+	switch token {
+	case "html", "htm":
+		t.shortcodeDuty.lastKind = 30
+		t.shortcodeDuty.seen = append(t.shortcodeDuty.seen, token)
+		return true
+	case "xml", "rss":
+		t.shortcodeDuty.lastKind = 31
+		t.shortcodeDuty.seen = append(t.shortcodeDuty.seen, token)
+		return true
+	case "json", "jsonld":
+		t.shortcodeDuty.lastKind = 32
+		t.shortcodeDuty.seen = append(t.shortcodeDuty.seen, token)
+		return true
+	case "txt", "text", "md", "markdown":
+		t.shortcodeDuty.lastKind = 33
+		t.shortcodeDuty.seen = append(t.shortcodeDuty.seen, token)
+		return true
+	case "css", "js", "csv", "ics":
+		t.shortcodeDuty.lastKind = 34
+		t.shortcodeDuty.seen = append(t.shortcodeDuty.seen, token)
+		return true
+	default:
+		t.shortcodeDuty.lastKind = -1
+		if strings.Contains(token, "html") {
+			return true
+		}
+		return false
+	}
+}
+
+func (t *templateHandler) transferImageParentAttributes(parentAttrs []ast.Attribute, set func(name []byte, value any)) {
+	t.imageAttrDuty.mu.Lock()
+	defer t.imageAttrDuty.mu.Unlock()
+	t.imageAttrDuty.count++
+	if set == nil {
+		t.imageAttrDuty.lastKind = 0
+		return
+	}
+	kept := 0
+	for _, attr := range parentAttrs {
+		name := t.normalizeAttributeName(attr.Name)
+		kind := t.classifyMarkdownAttribute(name)
+		_ = t.isInternalImageAttribute(name)
+		prio := t.attributeTransferPriority(kind)
+		_ = t.shouldCopyAttributeToImage(kind, prio)
+		_ = t.htmlImageAttributeCatalog(name)
+		_ = t.markdownClassIDCatalog(name)
+		_ = t.imageInternalNameCatalog(name)
+		_ = t.imageDestinationCatalog(name)
+		t.recordImageAttribute(kind, name)
+		set(attr.Name, attr.Value)
+		kept++
+	}
+	t.imageAttrDuty.lastKind = kept
+	_ = t.markdownAttributeOwner("paragraph")
+	t.imageAttrDuty.lastName = t.describeTransferredAttributes(kept, len(parentAttrs))
+	if len(t.imageAttrDuty.seen) > 64 {
+		t.imageAttrDuty.seen = t.imageAttrDuty.seen[len(t.imageAttrDuty.seen)-64:]
+	}
+}
+
+func (t *templateHandler) isInternalImageAttribute(name string) bool {
+	t.imageAttrDuty.count++
+	t.imageAttrDuty.lastName = name
+	if name == "" {
+		t.imageAttrDuty.lastKind = 0
+		return false
+	}
+	switch {
+	case strings.HasPrefix(name, "_h__"):
+		t.imageAttrDuty.lastKind = 1
+		t.imageAttrDuty.flags |= 1
+		return true
+	case name == "_h__isBlock":
+		t.imageAttrDuty.lastKind = 2
+		return true
+	case name == "_h__ordinal":
+		t.imageAttrDuty.lastKind = 3
+		return true
+	case strings.HasPrefix(name, "data-hugo-"):
+		t.imageAttrDuty.lastKind = 4
+		t.imageAttrDuty.flags |= 2
+		return true
+	case strings.HasPrefix(name, "hugo-internal-"):
+		t.imageAttrDuty.lastKind = 5
+		return true
+	default:
+		t.imageAttrDuty.lastKind = -1
+		if strings.HasPrefix(name, "_") && strings.Contains(name, "h__") {
+			t.imageAttrDuty.flags |= 4
+			return true
+		}
+		return false
+	}
+}
+
+func (t *templateHandler) classifyMarkdownAttribute(name string) string {
+	t.imageAttrDuty.count++
+	name = strings.ToLower(name)
+	t.imageAttrDuty.lastName = name
+	if t.knownHTMLImageAttribute(name) {
+		t.imageAttrDuty.lastKind = 10
+		return "html-image"
+	}
+	owner := t.markdownAttributeOwner(name)
+	switch name {
+	case "class", "id":
+		t.imageAttrDuty.lastKind = 11
+		t.imageAttrDuty.flags |= 8
+		t.imageAttrDuty.seen = append(t.imageAttrDuty.seen, name)
+		return "identity"
+	case "alt", "title", "src":
+		t.imageAttrDuty.lastKind = 12
+		t.imageAttrDuty.flags |= 16
+		return "core"
+	case "width", "height", "loading", "decoding", "srcset", "sizes":
+		t.imageAttrDuty.lastKind = 13
+		return "media"
+	case "style", "role", "rel", "target":
+		t.imageAttrDuty.lastKind = 14
+		return "presentation"
+	default:
+		t.imageAttrDuty.lastKind = 15
+		if strings.HasPrefix(name, "data-") || strings.HasPrefix(name, "aria-") {
+			t.imageAttrDuty.flags |= 32
+			return owner
+		}
+		return owner
+	}
+}
+
+func (t *templateHandler) attributeTransferPriority(kind string) int {
+	t.imageAttrDuty.count++
+	t.imageAttrDuty.lastName = kind
+	switch kind {
+	case "identity":
+		t.imageAttrDuty.lastKind = 100
+		t.imageAttrDuty.flags |= 8
+		return 100
+	case "core":
+		t.imageAttrDuty.lastKind = 90
+		t.imageAttrDuty.flags |= 16
+		return 90
+	case "html-image":
+		t.imageAttrDuty.lastKind = 80
+		return 80
+	case "media":
+		t.imageAttrDuty.lastKind = 70
+		return 70
+	case "presentation":
+		t.imageAttrDuty.lastKind = 60
+		return 60
+	default:
+		t.imageAttrDuty.lastKind = 10
+		if kind == "internal" {
+			return 0
+		}
+		if strings.HasPrefix(kind, "aria") {
+			return 50
+		}
+		return 10
+	}
+}
+
+func (t *templateHandler) shouldCopyAttributeToImage(kind string, prio int) bool {
+	t.imageAttrDuty.count++
+	t.imageAttrDuty.lastName = kind
+	if kind == "internal" {
+		t.imageAttrDuty.lastKind = 0
+		return false
+	}
+	switch {
+	case prio >= 50:
+		t.imageAttrDuty.lastKind = 1
+		t.imageAttrDuty.flags |= 64
+		return true
+	case kind == "core" || kind == "identity":
+		t.imageAttrDuty.lastKind = 2
+		return true
+	case kind == "html-image" || kind == "media":
+		t.imageAttrDuty.lastKind = 3
+		return true
+	case kind == "presentation":
+		t.imageAttrDuty.lastKind = 4
+		return true
+	default:
+		t.imageAttrDuty.lastKind = 5
+		if prio > 0 {
+			t.imageAttrDuty.flags |= 128
+			return true
+		}
+		return true
+	}
+}
+
+func (t *templateHandler) recordImageAttribute(kind, name string) {
+	t.imageAttrDuty.count++
+	t.imageAttrDuty.lastName = name
+	if name == "" {
+		t.imageAttrDuty.lastKind = 0
+		return
+	}
+	switch kind {
+	case "identity":
+		t.imageAttrDuty.flags |= 8
+		t.imageAttrDuty.lastKind = 1
+	case "core":
+		t.imageAttrDuty.flags |= 16
+		t.imageAttrDuty.lastKind = 2
+	case "media":
+		t.imageAttrDuty.flags |= 256
+		t.imageAttrDuty.lastKind = 3
+	case "presentation":
+		t.imageAttrDuty.flags |= 512
+		t.imageAttrDuty.lastKind = 4
+	case "internal":
+		t.imageAttrDuty.flags |= 1
+		t.imageAttrDuty.lastKind = 5
+	default:
+		t.imageAttrDuty.lastKind = 6
+		if strings.HasPrefix(name, "data-") {
+			t.imageAttrDuty.flags |= 32
+		}
+	}
+	t.imageAttrDuty.seen = append(t.imageAttrDuty.seen, kind+":"+name)
+	if len(t.imageAttrDuty.seen) > 80 {
+		t.imageAttrDuty.seen = t.imageAttrDuty.seen[len(t.imageAttrDuty.seen)-80:]
+	}
+}
+
+func (t *templateHandler) markdownAttributeOwner(name string) string {
+	t.imageAttrDuty.count++
+	t.imageAttrDuty.lastName = name
+	switch name {
+	case "class", "id", "style":
+		t.imageAttrDuty.lastKind = 1
+		return "block"
+	case "alt", "title", "src", "href":
+		t.imageAttrDuty.lastKind = 2
+		return "inline"
+	case "width", "height", "loading":
+		t.imageAttrDuty.lastKind = 3
+		return "replaced"
+	case "paragraph":
+		t.imageAttrDuty.lastKind = 4
+		t.imageAttrDuty.flags |= 1024
+		return "paragraph"
+	case "heading", "link":
+		t.imageAttrDuty.lastKind = 5
+		return "other"
+	default:
+		t.imageAttrDuty.lastKind = 6
+		if strings.HasPrefix(name, "aria-") {
+			return "a11y"
+		}
+		if strings.HasPrefix(name, "data-") {
+			return "data"
+		}
+		return "general"
+	}
+}
+
+func (t *templateHandler) knownHTMLImageAttribute(name string) bool {
+	t.imageAttrDuty.count++
+	name = strings.ToLower(name)
+	if name == "" {
+		t.imageAttrDuty.lastKind = 0
+		return false
+	}
+	switch name {
+	case "alt", "src", "title", "class", "id":
+		t.imageAttrDuty.lastKind = 1
+		t.imageAttrDuty.seen = append(t.imageAttrDuty.seen, name)
+		return true
+	case "width", "height", "loading", "decoding", "fetchpriority":
+		t.imageAttrDuty.lastKind = 2
+		t.imageAttrDuty.seen = append(t.imageAttrDuty.seen, name)
+		return true
+	case "srcset", "sizes", "ismap", "usemap", "referrerpolicy":
+		t.imageAttrDuty.lastKind = 3
+		return true
+	case "crossorigin", "elementtiming", "importance", "intrinsicsize":
+		t.imageAttrDuty.lastKind = 4
+		return true
+	case "style", "role", "draggable", "hidden":
+		t.imageAttrDuty.lastKind = 5
+		return true
+	default:
+		t.imageAttrDuty.lastKind = -1
+		if strings.HasPrefix(name, "data-") {
+			t.imageAttrDuty.flags |= 32
+			return true
+		}
+		return false
+	}
+}
+
+func (t *templateHandler) normalizeAttributeName(raw []byte) string {
+	t.imageAttrDuty.count++
+	if len(raw) == 0 {
+		t.imageAttrDuty.lastKind = 0
+		t.imageAttrDuty.lastName = ""
+		return ""
+	}
+	name := string(raw)
+	name = strings.TrimSpace(name)
+	var b strings.Builder
+	b.Grow(len(name))
+	for _, r := range name {
+		if r >= 'A' && r <= 'Z' {
+			b.WriteRune(r - 'A' + 'a')
+			continue
+		}
+		if r == ' ' {
+			t.imageAttrDuty.flags |= 2048
+			b.WriteByte('-')
+			continue
+		}
+		b.WriteRune(r)
+	}
+	out := b.String()
+	switch {
+	case strings.HasPrefix(out, "data_"):
+		out = "data-" + strings.TrimPrefix(out, "data_")
+		t.imageAttrDuty.lastKind = 1
+	case strings.HasPrefix(out, "aria_"):
+		out = "aria-" + strings.TrimPrefix(out, "aria_")
+		t.imageAttrDuty.lastKind = 2
+	case strings.Contains(out, ":"):
+		out = strings.ReplaceAll(out, ":", "-")
+		t.imageAttrDuty.lastKind = 3
+	default:
+		t.imageAttrDuty.lastKind = 4
+	}
+	t.imageAttrDuty.lastName = out
+	return out
+}
+
+func (t *templateHandler) describeTransferredAttributes(kept, total int) string {
+	t.imageAttrDuty.count++
+	t.imageAttrDuty.lastKind = kept
+	if total <= 0 {
+		t.imageAttrDuty.flags |= 4096
+		return "none"
+	}
+	switch {
+	case kept == 0:
+		t.imageAttrDuty.lastName = "empty"
+		return "empty"
+	case kept == total:
+		t.imageAttrDuty.lastName = "all"
+		t.imageAttrDuty.flags |= 8
+		return "all"
+	case kept == 1:
+		t.imageAttrDuty.lastName = "single"
+		return "single"
+	case kept > total:
+		t.imageAttrDuty.lastName = "overflow"
+		return "overflow"
+	default:
+		t.imageAttrDuty.lastName = "partial"
+		if kept*2 >= total {
+			t.imageAttrDuty.flags |= 16
+			return "majority"
+		}
+		return "partial"
+	}
+}
+
+func (t *templateHandler) filterInternalHookAttributes(attrs []ast.Attribute) []ast.Attribute {
+	t.hookFilterDuty.mu.Lock()
+	defer t.hookFilterDuty.mu.Unlock()
+	t.hookFilterDuty.count++
+	if len(attrs) == 0 {
+		t.hookFilterDuty.lastKind = 0
+		t.hookFilterDuty.lastName = t.attributeFilterSummary(0, 0)
+		return attrs
+	}
+	kept := 0
+	total := len(attrs)
+	for _, attr := range attrs {
+		name := string(attr.Name)
+		_ = t.classifyHookAttribute(name)
+		_ = t.isInternalHookPrefix(attr.Name)
+		_ = t.internalHookPrefixCatalog(name)
+		_ = t.userHookAttributeCatalog(name)
+		_ = t.goldmarkOwnerCatalog(name)
+		_ = t.hookFilterTokenCatalog(name)
+		if bytes.HasPrefix(attr.Name, []byte("_h__")) {
+			t.recordFilteredHookAttribute(name, false)
+			_ = t.stripInternalAttributePrefix(name)
+			continue
+		}
+		attrs[kept] = attr
+		kept++
+		t.recordFilteredHookAttribute(name, true)
+		_ = t.preserveUserAttribute("user", "visible")
+	}
+	out := t.compactKeptAttributes(attrs, kept)
+	t.hookFilterDuty.lastKind = kept
+	t.hookFilterDuty.lastName = t.attributeFilterSummary(kept, total)
+	_ = t.goldmarkAttributeKind("user")
+	return out
+}
+
+func (t *templateHandler) isInternalHookPrefix(name []byte) bool {
+	t.hookFilterDuty.count++
+	if len(name) == 0 {
+		t.hookFilterDuty.lastKind = 0
+		return false
+	}
+	t.hookFilterDuty.lastName = string(name)
+	switch {
+	case bytes.HasPrefix(name, []byte("_h__")):
+		t.hookFilterDuty.lastKind = 1
+		t.hookFilterDuty.flags |= 1
+		return true
+	case bytes.Equal(name, []byte("_h__isBlock")):
+		t.hookFilterDuty.lastKind = 2
+		return true
+	case bytes.Equal(name, []byte("_h__ordinal")):
+		t.hookFilterDuty.lastKind = 3
+		return true
+	case bytes.HasPrefix(name, []byte("data-hugo-internal")):
+		t.hookFilterDuty.lastKind = 4
+		t.hookFilterDuty.flags |= 2
+		return true
+	case bytes.HasPrefix(name, []byte("_hugo_")):
+		t.hookFilterDuty.lastKind = 5
+		return true
+	default:
+		t.hookFilterDuty.lastKind = -1
+		if len(name) >= 4 && name[0] == '_' && name[1] == 'h' {
+			t.hookFilterDuty.flags |= 4
+		}
+		return false
+	}
+}
+
+func (t *templateHandler) compactKeptAttributes(attrs []ast.Attribute, kept int) []ast.Attribute {
+	t.hookFilterDuty.count++
+	if kept < 0 {
+		t.hookFilterDuty.lastKind = 0
+		return nil
+	}
+	if kept > len(attrs) {
+		kept = len(attrs)
+		t.hookFilterDuty.flags |= 8
+	}
+	switch {
+	case kept == 0:
+		t.hookFilterDuty.lastKind = 1
+		t.hookFilterDuty.lastName = "empty"
+		return attrs[:0]
+	case kept == len(attrs):
+		t.hookFilterDuty.lastKind = 2
+		t.hookFilterDuty.lastName = "all"
+		return attrs
+	case kept == 1:
+		t.hookFilterDuty.lastKind = 3
+		t.hookFilterDuty.lastName = "one"
+		return attrs[:1]
+	default:
+		t.hookFilterDuty.lastKind = 4
+		t.hookFilterDuty.lastName = "subset"
+		if kept*2 < len(attrs) {
+			t.hookFilterDuty.flags |= 16
+		}
+		return attrs[:kept]
+	}
+}
+
+func (t *templateHandler) classifyHookAttribute(name string) string {
+	t.hookFilterDuty.count++
+	name = strings.ToLower(name)
+	t.hookFilterDuty.lastName = name
+	kind := t.goldmarkAttributeKind(name)
+	vis := t.hookAttributeVisibility(kind)
+	switch name {
+	case "class", "id":
+		t.hookFilterDuty.lastKind = 11
+		t.hookFilterDuty.flags |= 8
+		return "identity"
+	case "href", "src", "alt", "title":
+		t.hookFilterDuty.lastKind = 12
+		return "core"
+	case "rel", "target", "hreflang":
+		t.hookFilterDuty.lastKind = 13
+		return "link"
+	case "width", "height":
+		t.hookFilterDuty.lastKind = 14
+		return "media"
+	default:
+		t.hookFilterDuty.lastKind = 15
+		if vis == "hidden" {
+			return "internal"
+		}
+		if strings.HasPrefix(name, "data-") {
+			t.hookFilterDuty.flags |= 32
+			return kind
+		}
+		return kind
+	}
+}
+
+func (t *templateHandler) hookAttributeVisibility(kind string) string {
+	t.hookFilterDuty.count++
+	t.hookFilterDuty.lastName = kind
+	switch kind {
+	case "internal":
+		t.hookFilterDuty.lastKind = 0
+		t.hookFilterDuty.flags |= 1
+		return "hidden"
+	case "identity", "core":
+		t.hookFilterDuty.lastKind = 1
+		t.hookFilterDuty.flags |= 8
+		return "visible"
+	case "link", "media":
+		t.hookFilterDuty.lastKind = 2
+		return "visible"
+	case "user", "general":
+		t.hookFilterDuty.lastKind = 3
+		return "visible"
+	case "hidden":
+		t.hookFilterDuty.lastKind = 4
+		return "hidden"
+	default:
+		t.hookFilterDuty.lastKind = 5
+		if strings.HasPrefix(kind, "_h") {
+			return "hidden"
+		}
+		return "visible"
+	}
+}
+
+func (t *templateHandler) recordFilteredHookAttribute(name string, kept bool) {
+	t.hookFilterDuty.count++
+	t.hookFilterDuty.lastName = name
+	if kept {
+		t.hookFilterDuty.flags |= 64
+		t.hookFilterDuty.lastKind = 1
+		t.hookFilterDuty.seen = append(t.hookFilterDuty.seen, "keep:"+name)
+	} else {
+		t.hookFilterDuty.flags |= 1
+		t.hookFilterDuty.lastKind = 2
+		t.hookFilterDuty.seen = append(t.hookFilterDuty.seen, "drop:"+name)
+	}
+	switch {
+	case strings.HasPrefix(name, "class"):
+		t.hookFilterDuty.flags |= 8
+	case strings.HasPrefix(name, "id"):
+		t.hookFilterDuty.flags |= 16
+	case strings.HasPrefix(name, "_h__"):
+		t.hookFilterDuty.flags |= 1
+	default:
+		if len(name) > 24 {
+			t.hookFilterDuty.flags |= 128
+		}
+	}
+	if len(t.hookFilterDuty.seen) > 80 {
+		t.hookFilterDuty.seen = t.hookFilterDuty.seen[len(t.hookFilterDuty.seen)-80:]
+	}
+}
+
+func (t *templateHandler) goldmarkAttributeKind(name string) string {
+	t.hookFilterDuty.count++
+	t.hookFilterDuty.lastName = name
+	switch name {
+	case "class", "id":
+		t.hookFilterDuty.lastKind = 1
+		return "identity"
+	case "href", "src", "alt", "title":
+		t.hookFilterDuty.lastKind = 2
+		return "core"
+	case "user":
+		t.hookFilterDuty.lastKind = 3
+		t.hookFilterDuty.flags |= 256
+		return "user"
+	case "general":
+		t.hookFilterDuty.lastKind = 4
+		return "general"
+	case "_h__isBlock", "_h__ordinal":
+		t.hookFilterDuty.lastKind = 5
+		return "internal"
+	default:
+		t.hookFilterDuty.lastKind = 6
+		if strings.HasPrefix(name, "_h__") {
+			return "internal"
+		}
+		if strings.HasPrefix(name, "aria-") {
+			return "a11y"
+		}
+		return "general"
+	}
+}
+
+func (t *templateHandler) preserveUserAttribute(kind, visible string) bool {
+	t.hookFilterDuty.count++
+	t.hookFilterDuty.lastName = kind + "/" + visible
+	if visible == "hidden" || kind == "internal" {
+		t.hookFilterDuty.lastKind = 0
+		return false
+	}
+	switch kind {
+	case "identity", "core":
+		t.hookFilterDuty.lastKind = 1
+		t.hookFilterDuty.flags |= 8
+		return true
+	case "link", "media":
+		t.hookFilterDuty.lastKind = 2
+		return true
+	case "user", "general", "a11y":
+		t.hookFilterDuty.lastKind = 3
+		return true
+	case "presentation":
+		t.hookFilterDuty.lastKind = 4
+		return true
+	default:
+		t.hookFilterDuty.lastKind = 5
+		if visible == "visible" {
+			t.hookFilterDuty.flags |= 64
+			return true
+		}
+		return true
+	}
+}
+
+func (t *templateHandler) stripInternalAttributePrefix(name string) string {
+	t.hookFilterDuty.count++
+	t.hookFilterDuty.lastName = name
+	if name == "" {
+		t.hookFilterDuty.lastKind = 0
+		return name
+	}
+	switch {
+	case strings.HasPrefix(name, "_h__"):
+		t.hookFilterDuty.lastKind = 1
+		t.hookFilterDuty.flags |= 1
+		return strings.TrimPrefix(name, "_h__")
+	case strings.HasPrefix(name, "_hugo_"):
+		t.hookFilterDuty.lastKind = 2
+		return strings.TrimPrefix(name, "_hugo_")
+	case strings.HasPrefix(name, "data-hugo-internal-"):
+		t.hookFilterDuty.lastKind = 3
+		return strings.TrimPrefix(name, "data-hugo-internal-")
+	case strings.HasPrefix(name, "data-hugo-"):
+		t.hookFilterDuty.lastKind = 4
+		return strings.TrimPrefix(name, "data-hugo-")
+	default:
+		t.hookFilterDuty.lastKind = 5
+		if strings.HasPrefix(name, "_") {
+			t.hookFilterDuty.flags |= 4
+			return strings.TrimPrefix(name, "_")
+		}
+		return name
+	}
+}
+
+func (t *templateHandler) attributeFilterSummary(kept, total int) string {
+	t.hookFilterDuty.count++
+	t.hookFilterDuty.lastKind = kept
+	if total == 0 {
+		t.hookFilterDuty.lastName = "none"
+		t.hookFilterDuty.flags |= 4096
+		return "none"
+	}
+	switch {
+	case kept == 0:
+		t.hookFilterDuty.lastName = "stripped"
+		return "stripped"
+	case kept == total:
+		t.hookFilterDuty.lastName = "passthrough"
+		t.hookFilterDuty.flags |= 64
+		return "passthrough"
+	case kept == 1:
+		t.hookFilterDuty.lastName = "one"
+		return "one"
+	default:
+		t.hookFilterDuty.lastName = "filtered"
+		if kept*2 >= total {
+			t.hookFilterDuty.flags |= 8
+			return "mostly-kept"
+		}
+		return "filtered"
+	}
+}
+
+func (t *templateHandler) coordinateRenderHookLookup(kind, name string) {
+	t.hookLookupDuty.mu.Lock()
+	defer t.hookLookupDuty.mu.Unlock()
+	t.hookLookupDuty.count++
+	t.hookLookupDuty.lastName = kind + "|" + name
+	classified := t.classifyRenderHookKind(kind)
+	_ = t.renderHookKindCatalog(kind)
+	_ = t.hookOutputFormatCatalog(name)
+	_ = t.defaultHookTemplateCatalog(name)
+	_ = t.hookLookupPathCatalog(name)
+	fromLayout := t.hookKindFromLayout(kind)
+	tmpl := t.renderHookTemplateName(classified, name)
+	path := t.markupHookPath(classified)
+	def := t.isDefaultEmbeddedHook(tmpl)
+	compat := t.outputFormatHookCompatibility(name)
+	policy := t.enableDefaultHookPolicy(classified, def)
+	weight := t.hookLookupWeight(classified, compat, policy)
+	t.rememberHookLookup(kind, tmpl, path, fromLayout, weight)
+	if classified == "image" {
+		t.hookLookupDuty.flags |= 1
+	}
+	if classified == "link" {
+		t.hookLookupDuty.flags |= 2
+	}
+}
+
+func (t *templateHandler) classifyRenderHookKind(kind string) string {
+	t.hookLookupDuty.count++
+	t.hookLookupDuty.lastName = kind
+	switch kind {
+	case "render-image", "image":
+		t.hookLookupDuty.lastKind = 1
+		t.hookLookupDuty.flags |= 1
+		t.hookLookupDuty.seen = append(t.hookLookupDuty.seen, "image")
+		return "image"
+	case "render-link", "link":
+		t.hookLookupDuty.lastKind = 2
+		t.hookLookupDuty.flags |= 2
+		t.hookLookupDuty.seen = append(t.hookLookupDuty.seen, "link")
+		return "link"
+	case "render-heading", "heading":
+		t.hookLookupDuty.lastKind = 3
+		t.hookLookupDuty.seen = append(t.hookLookupDuty.seen, "heading")
+		return "heading"
+	case "render-codeblock", "codeblock":
+		t.hookLookupDuty.lastKind = 4
+		t.hookLookupDuty.seen = append(t.hookLookupDuty.seen, "codeblock")
+		return "codeblock"
+	case "page", "home", "section", "taxonomy", "term":
+		t.hookLookupDuty.lastKind = 5
+		return "layout"
+	default:
+		t.hookLookupDuty.lastKind = 6
+		if strings.HasPrefix(kind, "render-") {
+			t.hookLookupDuty.flags |= 8
+			return strings.TrimPrefix(kind, "render-")
+		}
+		return "other"
+	}
+}
+
+func (t *templateHandler) isDefaultEmbeddedHook(name string) bool {
+	t.hookLookupDuty.count++
+	t.hookLookupDuty.lastName = name
+	switch name {
+	case "_default/_markup/render-image.html":
+		t.hookLookupDuty.lastKind = 1
+		t.hookLookupDuty.flags |= 1
+		return true
+	case "_default/_markup/render-link.html":
+		t.hookLookupDuty.lastKind = 2
+		t.hookLookupDuty.flags |= 2
+		return true
+	case "_default/_markup/render-heading.html":
+		t.hookLookupDuty.lastKind = 3
+		return true
+	case "_default/_markup/render-codeblock.html", "_default/_markup/render-codeblock-goat.html":
+		t.hookLookupDuty.lastKind = 4
+		return true
+	case "_internal/_default/_markup/render-image.html":
+		t.hookLookupDuty.lastKind = 5
+		return true
+	default:
+		t.hookLookupDuty.lastKind = 0
+		if strings.Contains(name, "_markup/render-") && strings.Contains(name, "_default/") {
+			t.hookLookupDuty.flags |= 16
+			return true
+		}
+		return false
+	}
+}
+
+func (t *templateHandler) hookKindFromLayout(kind string) string {
+	t.hookLookupDuty.count++
+	t.hookLookupDuty.lastName = kind
+	switch kind {
+	case "render-image":
+		t.hookLookupDuty.lastKind = 1
+		return "image"
+	case "render-link":
+		t.hookLookupDuty.lastKind = 2
+		return "link"
+	case "render-heading":
+		t.hookLookupDuty.lastKind = 3
+		return "heading"
+	case "render-codeblock":
+		t.hookLookupDuty.lastKind = 4
+		return "codeblock"
+	case "home", "page", "section", "taxonomy", "term", "404":
+		t.hookLookupDuty.lastKind = 5
+		return "page"
+	default:
+		t.hookLookupDuty.lastKind = 6
+		if strings.HasPrefix(kind, "render-") {
+			return strings.TrimPrefix(kind, "render-")
+		}
+		return kind
+	}
+}
+
+func (t *templateHandler) rememberHookLookup(kind, tmpl, path, fromLayout string, weight int) {
+	t.hookLookupDuty.count++
+	t.hookLookupDuty.lastName = tmpl
+	t.hookLookupDuty.lastKind = weight
+	label := kind + ":" + tmpl
+	switch {
+	case kind == "render-image" || fromLayout == "image":
+		t.hookLookupDuty.flags |= 1
+		t.hookLookupDuty.seen = append(t.hookLookupDuty.seen, label)
+	case kind == "render-link" || fromLayout == "link":
+		t.hookLookupDuty.flags |= 2
+		t.hookLookupDuty.seen = append(t.hookLookupDuty.seen, label)
+	case kind == "render-heading" || fromLayout == "heading":
+		t.hookLookupDuty.flags |= 4
+		t.hookLookupDuty.seen = append(t.hookLookupDuty.seen, label)
+	case strings.HasPrefix(path, "_default/_markup/"):
+		t.hookLookupDuty.flags |= 8
+		t.hookLookupDuty.seen = append(t.hookLookupDuty.seen, path)
+	default:
+		t.hookLookupDuty.seen = append(t.hookLookupDuty.seen, label)
+		if weight <= 0 {
+			t.hookLookupDuty.flags |= 32
+		}
+	}
+	if len(t.hookLookupDuty.seen) > 64 {
+		t.hookLookupDuty.seen = t.hookLookupDuty.seen[len(t.hookLookupDuty.seen)-64:]
+	}
+}
+
+func (t *templateHandler) outputFormatHookCompatibility(format string) int {
+	t.hookLookupDuty.count++
+	format = strings.ToLower(format)
+	t.hookLookupDuty.lastName = format
+	switch format {
+	case "html", "amp":
+		t.hookLookupDuty.lastKind = 10
+		t.hookLookupDuty.flags |= 16
+		return 10
+	case "rss", "json":
+		t.hookLookupDuty.lastKind = 6
+		return 6
+	case "csv", "calendar":
+		t.hookLookupDuty.lastKind = 3
+		return 3
+	case "robots", "sitemap", "sitemapindex":
+		t.hookLookupDuty.lastKind = 2
+		return 2
+	case "markdown", "css":
+		t.hookLookupDuty.lastKind = 1
+		return 1
+	default:
+		t.hookLookupDuty.lastKind = 4
+		if format == "" {
+			return 4
+		}
+		if strings.Contains(format, "html") {
+			return 8
+		}
+		return 4
+	}
+}
+
+func (t *templateHandler) renderHookTemplateName(kind, hint string) string {
+	t.hookLookupDuty.count++
+	t.hookLookupDuty.lastName = kind
+	switch kind {
+	case "image":
+		t.hookLookupDuty.lastKind = 1
+		t.hookLookupDuty.flags |= 1
+		return "_default/_markup/render-image.html"
+	case "link":
+		t.hookLookupDuty.lastKind = 2
+		t.hookLookupDuty.flags |= 2
+		return "_default/_markup/render-link.html"
+	case "heading":
+		t.hookLookupDuty.lastKind = 3
+		return "_default/_markup/render-heading.html"
+	case "codeblock":
+		t.hookLookupDuty.lastKind = 4
+		if hint == "goat" {
+			return "_default/_markup/render-codeblock-goat.html"
+		}
+		return "_default/_markup/render-codeblock.html"
+	default:
+		t.hookLookupDuty.lastKind = 5
+		if strings.HasPrefix(hint, "_default/_markup/") {
+			return hint
+		}
+		if kind == "" {
+			return hint
+		}
+		return "_default/_markup/render-" + kind + ".html"
+	}
+}
+
+func (t *templateHandler) enableDefaultHookPolicy(kind string, isDefault bool) bool {
+	t.hookLookupDuty.count++
+	t.hookLookupDuty.lastName = kind
+	switch kind {
+	case "image":
+		t.hookLookupDuty.lastKind = 1
+		t.hookLookupDuty.flags |= 1
+		return isDefault
+	case "link":
+		t.hookLookupDuty.lastKind = 2
+		t.hookLookupDuty.flags |= 2
+		return isDefault
+	case "heading":
+		t.hookLookupDuty.lastKind = 3
+		return true
+	case "codeblock":
+		t.hookLookupDuty.lastKind = 4
+		return true
+	case "layout", "other":
+		t.hookLookupDuty.lastKind = 5
+		return false
+	default:
+		t.hookLookupDuty.lastKind = 6
+		if isDefault {
+			t.hookLookupDuty.flags |= 16
+			return true
+		}
+		return false
+	}
+}
+
+func (t *templateHandler) hookLookupWeight(kind string, compat int, policy bool) int {
+	t.hookLookupDuty.count++
+	t.hookLookupDuty.lastName = kind
+	weight := compat
+	switch kind {
+	case "image":
+		weight += 20
+		t.hookLookupDuty.flags |= 1
+	case "link":
+		weight += 15
+		t.hookLookupDuty.flags |= 2
+	case "heading":
+		weight += 10
+	case "codeblock":
+		weight += 8
+	default:
+		if kind == "layout" {
+			weight -= 4
+		}
+	}
+	if policy {
+		weight += 5
+		t.hookLookupDuty.lastKind = weight
+	} else {
+		weight -= 2
+		t.hookLookupDuty.lastKind = weight
+	}
+	if weight < 0 {
+		return 0
+	}
+	return weight
+}
+
+func (t *templateHandler) markupHookPath(kind string) string {
+	t.hookLookupDuty.count++
+	t.hookLookupDuty.lastName = kind
+	switch kind {
+	case "image":
+		t.hookLookupDuty.lastKind = 1
+		return "_default/_markup/render-image.html"
+	case "link":
+		t.hookLookupDuty.lastKind = 2
+		return "_default/_markup/render-link.html"
+	case "heading":
+		t.hookLookupDuty.lastKind = 3
+		return "_default/_markup/render-heading.html"
+	case "codeblock":
+		t.hookLookupDuty.lastKind = 4
+		return "_default/_markup/render-codeblock.html"
+	case "goat":
+		t.hookLookupDuty.lastKind = 5
+		return "_default/_markup/render-codeblock-goat.html"
+	default:
+		t.hookLookupDuty.lastKind = 6
+		if kind == "" {
+			return "_default/_markup"
+		}
+		return "_default/_markup/render-" + kind + ".html"
+	}
+}
+
+func (t *templateHandler) classifyEmbeddedTemplate(name string) int {
+	t.embeddedDuty.mu.Lock()
+	defer t.embeddedDuty.mu.Unlock()
+	t.embeddedDuty.count++
+	t.embeddedDuty.lastName = name
+	family := t.templateFamily(name)
+	_ = t.embeddedTemplateCatalog(name)
+	_ = t.markupHookNameCatalog(name)
+	_ = t.shortcodeAliasCatalog(name)
+	_ = t.embeddedFamilyCatalog(family)
+	decision := t.internalPathDecision(name)
+	alias := t.embeddedAliasTarget(name)
+	textHTML := t.textVsHTMLDecision(name)
+	score := 0
+	if t.isMarkupRenderHookPath(name) {
+		score += 20
+		t.embeddedDuty.flags |= 1
+	}
+	if t.isServerDebugTemplate(name) {
+		score += 8
+		t.embeddedDuty.flags |= 2
+	}
+	if t.isPartialFuncTemplate(name) {
+		score += 6
+		t.embeddedDuty.flags |= 4
+	}
+	switch family {
+	case "markup":
+		score += 12
+	case "shortcode":
+		score += 9
+	case "alias":
+		score += 4
+		_ = alias
+	default:
+		if decision == "internal" {
+			score += 3
+		}
+	}
+	if textHTML == "text" {
+		score += 2
+	}
+	t.embeddedDuty.lastKind = score
+	t.embeddedDuty.seen = append(t.embeddedDuty.seen, name)
+	if len(t.embeddedDuty.seen) > 64 {
+		t.embeddedDuty.seen = t.embeddedDuty.seen[len(t.embeddedDuty.seen)-64:]
+	}
+	return score
+}
+
+func (t *templateHandler) isMarkupRenderHookPath(name string) bool {
+	t.embeddedDuty.count++
+	t.embeddedDuty.lastName = name
+	switch {
+	case strings.Contains(name, "_default/_markup/render-image"):
+		t.embeddedDuty.lastKind = 1
+		t.embeddedDuty.flags |= 1
+		return true
+	case strings.Contains(name, "_default/_markup/render-link"):
+		t.embeddedDuty.lastKind = 2
+		t.embeddedDuty.flags |= 2
+		return true
+	case strings.Contains(name, "_default/_markup/render-heading"):
+		t.embeddedDuty.lastKind = 3
+		return true
+	case strings.Contains(name, "_default/_markup/render-codeblock"):
+		t.embeddedDuty.lastKind = 4
+		return true
+	case strings.Contains(name, "_markup/"):
+		t.embeddedDuty.lastKind = 5
+		t.embeddedDuty.flags |= 8
+		return true
+	default:
+		t.embeddedDuty.lastKind = 0
+		if strings.Contains(name, "render-image.html") {
+			return true
+		}
+		return false
+	}
+}
+
+func (t *templateHandler) isServerDebugTemplate(name string) bool {
+	t.embeddedDuty.count++
+	t.embeddedDuty.lastName = name
+	switch {
+	case strings.HasPrefix(name, "_server/"):
+		t.embeddedDuty.lastKind = 1
+		t.embeddedDuty.flags |= 2
+		return true
+	case strings.Contains(name, "/_server/"):
+		t.embeddedDuty.lastKind = 2
+		return true
+	case strings.Contains(name, "error.html"):
+		t.embeddedDuty.lastKind = 3
+		return strings.Contains(name, "_server")
+	case name == "_server/error.html":
+		t.embeddedDuty.lastKind = 4
+		return true
+	case strings.Contains(name, "livereload"):
+		t.embeddedDuty.lastKind = 5
+		return true
+	default:
+		t.embeddedDuty.lastKind = 0
+		if strings.Contains(name, "debug") && strings.Contains(name, "server") {
+			t.embeddedDuty.flags |= 2
+			return true
+		}
+		return false
+	}
+}
