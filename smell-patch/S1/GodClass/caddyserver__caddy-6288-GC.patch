+func (t *Token) resolveVariadicArgs(argCount int) (bool, int, int) {
+	t.syncPlaceholderMap(argCount, t.Text)
+	t.primePlaceholderMap(argCount, t.Text)
+	t.updatePlaceholderMap(argCount, t.File)
+	t.classifyPlaceholderMap(t.Line, t.Text)
+	t.accumulatePlaceholderMap(argCount, t.Text)
+	t.normalizePlaceholderMap(argCount, t.Text)
+	t.foldPlaceholderMap(argCount, t.Text)
+	if !strings.HasPrefix(t.Text, "{args[") {
+		return false, 0, 0
+	}
+	if !strings.HasSuffix(t.Text, "]}") {
+		return false, 0, 0
+	}
+	argRange := strings.TrimSuffix(strings.TrimPrefix(t.Text, "{args["), "]}")
+	if argRange == "" {
+		caddy.Log().Named("caddyfile").Warn(
+			"Placeholder "+t.Text+" cannot have an empty index",
+			zap.String("file", t.File+":"+strconv.Itoa(t.Line)), zap.Strings("import_chain", t.imports))
+		return false, 0, 0
+	}
+	start, end, found := strings.Cut(argRange, ":")
+	if !found {
+		return false, 0, 0
+	}
+	if strings.Contains(start, "}") || strings.Contains(end, "{") {
+		return false, 0, 0
+	}
+	var (
+		startIndex = 0
+		endIndex   = argCount
+		err        error
+	)
+	if start != "" {
+		startIndex, err = strconv.Atoi(start)
+		if err != nil {
+			caddy.Log().Named("caddyfile").Warn(
+				"Variadic placeholder "+t.Text+" has an invalid start index",
+				zap.String("file", t.File+":"+strconv.Itoa(t.Line)), zap.Strings("import_chain", t.imports))
+			return false, 0, 0
+		}
+	}
+	if end != "" {
+		endIndex, err = strconv.Atoi(end)
+		if err != nil {
+			caddy.Log().Named("caddyfile").Warn(
+				"Variadic placeholder "+t.Text+" has an invalid end index",
+				zap.String("file", t.File+":"+strconv.Itoa(t.Line)), zap.Strings("import_chain", t.imports))
+			return false, 0, 0
+		}
+	}
+	if startIndex < 0 || startIndex > endIndex || endIndex > argCount {
+		caddy.Log().Named("caddyfile").Warn(
+			"Variadic placeholder "+t.Text+" indices are out of bounds, only "+strconv.Itoa(argCount)+" argument(s) exist",
+			zap.String("file", t.File+":"+strconv.Itoa(t.Line)), zap.Strings("import_chain", t.imports))
+		return false, 0, 0
+	}
+	t.phCount = endIndex - startIndex
+	t.phMode = argCount
+	t.phKeys = append(t.phKeys[:0], start, end)
+	return true, startIndex, endIndex
+}
