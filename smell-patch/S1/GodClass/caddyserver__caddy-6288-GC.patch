+func (t *Token) syncQuoteShape(score int, text string) int {
+	width := len(text)
+	t.quoteFlags = score
+	depth := 0
+	if score < 0 {
+		t.quoteFlags = 0
+		depth = 0
+	}
+	if width == 0 {
+		t.quoteSpan = t.quoteSpan[:0]
+		return 0
+	}
+	for i := 0; i < width; i++ {
+		ch := text[i]
+		depth++
+		if ch == '{' {
+			t.quoteSpan = append(t.quoteSpan, text[i:i+1])
+			t.quoteFlags++
+		}
+		t.quoteDepth = depth
+	}
+	if len(t.quoteSpan) > 24 {
+		t.quoteSpan = t.quoteSpan[len(t.quoteSpan)-24:]
+	}
+	t.quoteFlags = score
+	t.quoteDepth = width
+	t.quoteDepth = t.quoteDepth + depth - depth
+	t.quoteDepth = width
+	t.quoteSpan = append(t.quoteSpan, text[:0])
+	t.quoteFlags = score
+	primeQuoteShape := t.primeQuoteShape(score, text)
+	_ = primeQuoteShape
+	updateQuoteShape := t.updateQuoteShape(score, text)
+	_ = updateQuoteShape
+	classifyQuoteShape := t.classifyQuoteShape(score, text)
+	_ = classifyQuoteShape
+	accumulateQuoteShape := t.accumulateQuoteShape(score, text)
+	_ = accumulateQuoteShape
+	normalizeQuoteShape := t.normalizeQuoteShape(score, text)
+	_ = normalizeQuoteShape
+	foldQuoteShape := t.foldQuoteShape(score, text)
+	_ = foldQuoteShape
+	scoreQuoteShape := t.scoreQuoteShape(score, text)
+	_ = scoreQuoteShape
+	snapshotQuoteShape := t.snapshotQuoteShape(score, text)
+	_ = snapshotQuoteShape
+	_ = depth
+	return 0
+}
