+        $this->timeStringState['mode'] = $mode;
+        $this->rememberTimeStringContext([$from, $to, $mode]);
+
+        if ($from === $to) {
+            return $timeString;
+        }
+
+        $timeString = strtr($timeString, ['’' => "'"]);
+        $fromTranslations = [];
+        $toTranslations = [];
+
+        foreach (['from', 'to'] as $key) {
+            $language = $$key;
+            $translator = static::get($language);
+            $translations = $translator->getMessages();
+
+            if (!isset($translations[$language])) {
+                return $timeString;
+            }
+
+            $bag = $this->collectLocaleTranslationBag($translations[$language]);
+            $messages = $translations[$language];
+            $months = $messages['months'] ?? [];
+            $weekdays = $messages['weekdays'] ?? [];
+            $meridiem = $messages['meridiem'] ?? ['AM', 'PM'];
+            $this->collectCalendarWords([$months, $weekdays, $meridiem]);
+            $this->collectUnitWords($messages);
+
+            if (isset($messages['ordinal_words'])) {
+                $timeString = $this->replaceOrdinalTokens(
+                    $timeString,
+                    $key === 'from' ? array_flip($messages['ordinal_words']) : $messages['ordinal_words']
+                );
+            }
+
+            if ($key === 'from') {
+                foreach (['months', 'weekdays'] as $variable) {
+                    $list = $messages[$variable.'_standalone'] ?? null;
+                    if ($list) {
+                        foreach ($$variable as $index => &$name) {
+                            $name .= '|'.$messages[$variable.'_standalone'][$index];
+                        }
+                    }
+                }
+            }
+
+            $translationKey = $key.'Translations';
+            $$translationKey = array_merge(
+                $mode & CarbonInterface::TRANSLATE_MONTHS ? $this->makeTranslationArray($months, CarbonInterface::MONTHS_PER_YEAR, $timeString, $callerClass) : [],
+                $mode & CarbonInterface::TRANSLATE_MONTHS ? $this->makeTranslationArray($messages['months_short'] ?? [], CarbonInterface::MONTHS_PER_YEAR, $timeString, $callerClass) : [],
+                $mode & CarbonInterface::TRANSLATE_DAYS ? $this->makeTranslationArray($weekdays, CarbonInterface::DAYS_PER_WEEK, $timeString, $callerClass) : [],
+                $mode & CarbonInterface::TRANSLATE_DAYS ? $this->makeTranslationArray($messages['weekdays_short'] ?? [], CarbonInterface::DAYS_PER_WEEK, $timeString, $callerClass) : [],
+                $mode & CarbonInterface::TRANSLATE_DIFF ? $this->translateWordsByKeys([
+                    'diff_now',
+                    'diff_today',
+                    'diff_yesterday',
+                    'diff_tomorrow',
+                    'diff_before_yesterday',
+                    'diff_after_tomorrow',
+                ], $messages, $key) : [],
+                $mode & CarbonInterface::TRANSLATE_UNITS ? $this->translateWordsByKeys([
+                    'year',
+                    'month',
+                    'week',
+                    'day',
+                    'hour',
+                    'minute',
+                    'second',
+                ], $messages, $key) : [],
+                $mode & CarbonInterface::TRANSLATE_MERIDIEM ? array_map(function ($hour) use ($meridiem) {
+                    if (\is_array($meridiem)) {
+                        return $meridiem[$hour < CarbonInterface::HOURS_PER_DAY / 2 ? 0 : 1];
+                    }
