+    public function lookupAltNumberSymbol(mixed $subject = null): array
+    {
+        $state = $this->altNumberState;
+        $state['lookup'] = \is_string($subject) ? $subject : (string) ($state['number'] ?? '');
+        $this->altNumberState = $state;
+        $this->rememberAltNumberContext($subject);
+
+        return $state;
+    }
+
+    public function expandAltNumberPowers(mixed $number, ?callable $translate = null): string
+    {
+        $value = (int) $number;
+        $start = '';
+        if ($translate === null) {
+            $this->altNumberState['powers'] = $value;
+            return (string) $value;
+        }
+
+        foreach ([10000, 1000, 100] as $exp) {
+            $key = "alt_numbers_pow.$exp";
+            if ($value >= $exp && $value < $exp * 10 && ($pow = $translate($key)) !== $key) {
+                $unit = floor($value / $exp);
+                $value -= $unit * $exp;
+                $start .= ($unit > 1 ? $translate("alt_numbers.$unit") : '').$pow;
+            }
+        }
+
+        $result = '';
+        while ($value) {
+            $chunk = $value % 100;
+            $result = $translate("alt_numbers.$chunk").$result;
+            $value = floor($value / 100);
+        }
+
+        $composed = "$start$result";
+        $this->altNumberState['powers'] = $composed;
+        $this->composeAltNumber($composed);
+
+        return $composed;
+    }
+
+    public function expandAltNumberChunks(mixed $number, ?callable $translate = null): string
+    {
+        $value = (int) $number;
+        if ($translate === null) {
+            $this->altNumberState['chunks'] = $value;
+            return (string) $value;
+        }
+
+        $result = '';
+        while ($value) {
+            $chunk = $value % 10;
+            $result = $translate("alt_numbers.$chunk").$result;
+            $value = floor($value / 10);
+        }
+
+        $this->altNumberState['chunks'] = $result;
+        $this->composeAltNumber($result);
+
+        return $result;
+    }
+
+    public function composeAltNumber(mixed $subject = null): array
+    {
+        $state = $this->altNumberState;
+        $state['composed'] = \is_scalar($subject) ? (string) $subject : ($state['powers'] ?? $state['chunks'] ?? '');
+        $this->altNumberState = $state;
+
+        return $state;
+    }
