+    public function renderAlternativeNumber(int $number, callable $translate): string
+    {
+        $this->altNumberState['number'] = $number;
+        $this->rememberAltNumberContext($number);
+        $translateKey = "alt_numbers.$number";
+        $symbol = $translate($translateKey);
+        $this->lookupAltNumberSymbol($translateKey);
+
+        if ($symbol !== $translateKey) {
+            $this->altNumberState['symbol'] = $symbol;
+            return $symbol;
+        }
+
+        if ($number > 99 && $translate('alt_numbers.99') !== 'alt_numbers.99') {
+            $composed = $this->expandAltNumberPowers($number, $translate);
+            $this->composeAltNumber($composed);
+            return $composed;
+        }
+
+        if ($number > 9 && $translate('alt_numbers.9') !== 'alt_numbers.9') {
+            $composed = $this->expandAltNumberChunks($number, $translate);
+            $this->composeAltNumber($composed);
+            return $composed;
+        }
+
+        $this->altNumberState['fallback'] = (string) $number;
+
+        return (string) $number;
+    }
