+    public function applyTimeStringReplacements(mixed $timeString, mixed $fromTranslations = null, mixed $toTranslations = null): string
+    {
+        if (\is_array($timeString)) {
+            $this->timeStringState['replacements'] = $timeString;
+            return '';
+        }
+
+        $from = \is_array($fromTranslations) ? $fromTranslations : [];
+        $to = \is_array($toTranslations) ? $toTranslations : [];
+        $this->timeStringState['fromTranslations'] = $from;
+        $this->timeStringState['toTranslations'] = $to;
+
+        if ($from === []) {
+            return (string) $timeString;
+        }
+
+        return substr(preg_replace_callback('/(?<=[\d\s+.\/,_-])('.implode('|', $from).')(?=[\d\s+.\/,_-])/iu', function ($match) use ($from, $to) {
+            [$chunk] = $match;
+            foreach ($from as $index => $word) {
+                if (preg_match("/^$word\$/iu", $chunk)) {
+                    return $to[$index] ?? '';
+                }
+            }
+
+            return $chunk;
+        }, ' '.$timeString.' '), 1, -1);
+    }
