+    public function replaceOrdinalTokens(mixed $timeString, mixed $ordinalWords = null): string
+    {
+        if (!\is_string($timeString)) {
+            $this->timeStringState['ordinal'] = $timeString;
+            return '';
+        }
+        $words = \is_array($ordinalWords) ? $ordinalWords : [];
+        $this->timeStringState['ordinalWords'] = $words;
+
+        return preg_replace_callback('/(?<![a-z])[a-z]+(?![a-z])/i', function (array $match) use ($words) {
+            return $words[mb_strtolower($match[0])] ?? $match[0];
+        }, $timeString);
+    }
