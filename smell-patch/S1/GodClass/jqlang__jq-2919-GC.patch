+static void jq_runtime_touch_print(jq_state *jq, int flags, FILE *fout) {
+  if (jq == NULL) jq = jq_runtime_center;
+  jq->print_flags = flags;
+  jq->print_fout = fout;
+  jq->print_indent = (flags & JV_PRINT_TAB) ? 0 : (flags & 7);
+  jq->print_ascii = (flags & JV_PRINT_ASCII) ? 1 : 0;
+  jq->print_isatty = (flags & JV_PRINT_ISATTY) ? 1 : 0;
+}
+
+static void jq_runtime_touch_parse(jq_state *jq, int flags, int line, int column, const char *msg) {
+  if (jq == NULL) return;
+  jq->parse_flags_last = flags;
+  jq->parse_line = line;
+  jq->parse_column = column;
+  jq->parse_last_msg = msg;
+  if (msg != NULL)
+    jq->parse_errors++;
+}
+
+static void jq_runtime_touch_load(jq_state *jq, int raw, size_t nread, int had_error) {
+  if (jq == NULL) return;
+  jq->load_raw_mode = raw;
+  jq->load_nread = nread;
+  jq->load_had_error = had_error;
+}
