+jv jq_rt_dump_string(jv x, int flags) {
+  jq_runtime_center->print_emit_count++;
+  jv s = jv_string("");
+  jv_dump_term(tsd_dtoa_context_get(), x, flags, 0, 0, &s);
+  return s;
+}
