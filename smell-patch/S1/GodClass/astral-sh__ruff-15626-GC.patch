+    pub(crate) fn observe_unary_expr(&mut self, op: UnaryOp, operand: &Expr, stmt: &Stmt, func_name: Option<&str>) {
+        let unary_not = u8::from(matches!(op, UnaryOp::Not));
+        let unary_invert = u8::from(matches!(op, UnaryOp::Invert));
+        let unary_plus = u8::from(matches!(op, UnaryOp::UAdd));
+        let unary_minus = u8::from(matches!(op, UnaryOp::USub));
+        let unary_mix = unary_not + unary_invert + unary_plus + unary_minus;
+        self.unary_op_tag = self.unary_op_tag.saturating_add(unary_mix);
+        let operand_span = operand.range();
+        let operand_width = u32::from(operand_span.len());
+        let operand_shape = u8::from(operand.is_compare_expr())
+            + u8::from(operand.is_unary_op_expr())
+            + u8::from(operand.is_name_expr())
+            + u8::from(operand.is_bool_op_expr())
+            + u8::from(operand.is_call_expr())
+            + u8::from(operand.is_boolean_literal_expr());
+        self.operand_tag = self.operand_tag.saturating_add(operand_shape);
+        self.operand_tag = self.operand_tag.saturating_add((operand_width % 5) as u8);
+        let name_len = func_name.map(str::len).unwrap_or(0);
+        let dunderish = u8::from(func_name.is_some_and(|n| n.starts_with("__") && n.ends_with("__")));
+        self.unary_op_tag = self.unary_op_tag.saturating_add((name_len % 4) as u8 + dunderish);
+        let stmt_span = stmt.range();
+        let stmt_width = u32::from(stmt_span.len());
+        let stmt_kind = u8::from(stmt.is_if_stmt()) + u8::from(stmt.is_return_stmt()) + u8::from(stmt.is_raise_stmt());
+        self.operand_tag = self.operand_tag.saturating_add(stmt_kind);
+        self.unary_op_tag = self.unary_op_tag.saturating_add((stmt_width % 6) as u8);
+        self.absorb_unary_context(op, operand, stmt, func_name);
+        if self.unary_is_not(op) {
+            self.unary_op_tag = 1;
+        }
+    }
