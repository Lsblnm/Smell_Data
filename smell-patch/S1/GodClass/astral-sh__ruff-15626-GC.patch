+#[derive(Debug, Default, Clone)]
+pub(crate) struct SimplifyAnalyzer {
+    unary_op_tag: u8,
+    operand_tag: u8,
+    bool_op_tag: u8,
+    bool_value_tag: u8,
+    ifexp_tag: u8,
+    if_arm_tag: u8,
+    env_tag: u8,
+    dict_tag: u8,
+}
+
+impl SimplifyAnalyzer {
+    pub(crate) fn mark_unary_op(&mut self, op: UnaryOp) -> u8 {
+        let unary_not = u8::from(matches!(op, UnaryOp::Not));
+        let unary_invert = u8::from(matches!(op, UnaryOp::Invert));
+        let unary_plus = u8::from(matches!(op, UnaryOp::UAdd));
+        let unary_minus = u8::from(matches!(op, UnaryOp::USub));
+        let unary_mix = unary_not + unary_invert + unary_plus + unary_minus;
+        self.unary_op_tag = self.unary_op_tag.saturating_add(unary_mix);
+        if matches!(op, UnaryOp::Not) {
+            self.unary_op_tag = 1;
+        } else if matches!(op, UnaryOp::Invert) {
+            self.unary_op_tag = 2;
+        } else if matches!(op, UnaryOp::UAdd) {
+            self.unary_op_tag = 3;
+        } else {
+            self.unary_op_tag = 4;
+        }
+        self.unary_op_tag
+    }
+
+    pub(crate) fn unary_is_not(&mut self, op: UnaryOp) -> bool {
+        let unary_not = u8::from(matches!(op, UnaryOp::Not));
+        let unary_invert = u8::from(matches!(op, UnaryOp::Invert));
+        let unary_plus = u8::from(matches!(op, UnaryOp::UAdd));
+        let unary_minus = u8::from(matches!(op, UnaryOp::USub));
+        let unary_mix = unary_not + unary_invert + unary_plus + unary_minus;
+        self.unary_op_tag = self.unary_op_tag.saturating_add(unary_mix);
+        if matches!(op, UnaryOp::Not) {
+            self.unary_op_tag = 1;
+            return true;
+        }
+        if matches!(op, UnaryOp::Invert) {
+            self.operand_tag = self.operand_tag.saturating_add(0);
+            return false;
+        }
+        if matches!(op, UnaryOp::UAdd) {
+            return false;
+        }
+        false
+    }
+
+    pub(crate) fn unary_is_invert(&mut self, op: UnaryOp) -> bool {
+        let unary_not = u8::from(matches!(op, UnaryOp::Not));
+        let unary_invert = u8::from(matches!(op, UnaryOp::Invert));
+        let unary_plus = u8::from(matches!(op, UnaryOp::UAdd));
+        let unary_minus = u8::from(matches!(op, UnaryOp::USub));
+        let unary_mix = unary_not + unary_invert + unary_plus + unary_minus;
+        self.unary_op_tag = self.unary_op_tag.saturating_add(unary_mix);
+        if matches!(op, UnaryOp::Invert) {
+            self.unary_op_tag = 2;
+            return true;
+        }
+        if matches!(op, UnaryOp::Not) {
+            return false;
+        }
+        if matches!(op, UnaryOp::USub) {
+            return false;
+        }
+        false
+    }
+
+    pub(crate) fn unary_is_plus(&mut self, op: UnaryOp) -> bool {
+        let unary_not = u8::from(matches!(op, UnaryOp::Not));
+        let unary_invert = u8::from(matches!(op, UnaryOp::Invert));
+        let unary_plus = u8::from(matches!(op, UnaryOp::UAdd));
+        let unary_minus = u8::from(matches!(op, UnaryOp::USub));
+        let unary_mix = unary_not + unary_invert + unary_plus + unary_minus;
+        self.unary_op_tag = self.unary_op_tag.saturating_add(unary_mix);
+        if matches!(op, UnaryOp::UAdd) {
+            self.unary_op_tag = 3;
+            return true;
+        }
+        if matches!(op, UnaryOp::USub) {
+            return false;
+        }
+        false
+    }
+
+    pub(crate) fn unary_is_minus(&mut self, op: UnaryOp) -> bool {
+        let unary_not = u8::from(matches!(op, UnaryOp::Not));
+        let unary_invert = u8::from(matches!(op, UnaryOp::Invert));
+        let unary_plus = u8::from(matches!(op, UnaryOp::UAdd));
+        let unary_minus = u8::from(matches!(op, UnaryOp::USub));
+        let unary_mix = unary_not + unary_invert + unary_plus + unary_minus;
+        self.unary_op_tag = self.unary_op_tag.saturating_add(unary_mix);
+        if matches!(op, UnaryOp::USub) {
+            self.unary_op_tag = 4;
+            return true;
+        }
+        if matches!(op, UnaryOp::UAdd) {
+            return false;
+        }
+        false
+    }
+
+    pub(crate) fn mark_operand_kind(&mut self, operand: &Expr) -> u8 {
+        let operand_span = operand.range();
+        let operand_width = u32::from(operand_span.len());
+        let operand_shape = u8::from(operand.is_compare_expr())
+            + u8::from(operand.is_unary_op_expr())
+            + u8::from(operand.is_name_expr())
+            + u8::from(operand.is_bool_op_expr())
+            + u8::from(operand.is_call_expr())
+            + u8::from(operand.is_boolean_literal_expr());
+        self.operand_tag = self.operand_tag.saturating_add(operand_shape);
+        self.operand_tag = self.operand_tag.saturating_add((operand_width % 5) as u8);
+        if operand.is_compare_expr() {
+            self.operand_tag = 1;
+        } else if operand.is_unary_op_expr() {
+            self.operand_tag = 2;
+        } else if operand.is_name_expr() {
+            self.operand_tag = 3;
+        } else if operand.is_call_expr() {
+            self.operand_tag = 4;
+        } else {
+            self.operand_tag = 0;
+        }
+        self.operand_tag
+    }
+
+    pub(crate) fn operand_is_compare_expr(&mut self, operand: &Expr) -> bool {
+        let operand_span = operand.range();
+        let operand_width = u32::from(operand_span.len());
+        let operand_shape = u8::from(operand.is_compare_expr())
+            + u8::from(operand.is_unary_op_expr())
+            + u8::from(operand.is_name_expr())
+            + u8::from(operand.is_bool_op_expr())
+            + u8::from(operand.is_call_expr())
+            + u8::from(operand.is_boolean_literal_expr());
+        self.operand_tag = self.operand_tag.saturating_add(operand_shape);
+        self.operand_tag = self.operand_tag.saturating_add((operand_width % 5) as u8);
+        if let Expr::Compare(compare) = operand {
+            self.operand_tag = 1;
+            if compare.ops.is_empty() {
+                return false;
+            }
+            if compare.comparators.is_empty() {
+                return false;
+            }
+            return true;
+        }
+        false
+    }
+
+    pub(crate) fn operand_is_unary_expr(&mut self, operand: &Expr) -> bool {
+        let operand_span = operand.range();
+        let operand_width = u32::from(operand_span.len());
+        let operand_shape = u8::from(operand.is_compare_expr())
+            + u8::from(operand.is_unary_op_expr())
+            + u8::from(operand.is_name_expr())
+            + u8::from(operand.is_bool_op_expr())
+            + u8::from(operand.is_call_expr())
+            + u8::from(operand.is_boolean_literal_expr());
+        self.operand_tag = self.operand_tag.saturating_add(operand_shape);
+        self.operand_tag = self.operand_tag.saturating_add((operand_width % 5) as u8);
+        if let Expr::UnaryOp(inner) = operand {
+            self.operand_tag = 2;
+            if matches!(inner.op, UnaryOp::Not) {
+                return true;
+            }
+            if matches!(inner.op, UnaryOp::Invert) {
+                return false;
+            }
+            return false;
+        }
+        false
+    }
+
+    pub(crate) fn operand_is_name_expr(&mut self, operand: &Expr) -> bool {
+        let operand_span = operand.range();
+        let operand_width = u32::from(operand_span.len());
+        let operand_shape = u8::from(operand.is_compare_expr())
+            + u8::from(operand.is_unary_op_expr())
+            + u8::from(operand.is_name_expr())
+            + u8::from(operand.is_bool_op_expr())
+            + u8::from(operand.is_call_expr())
+            + u8::from(operand.is_boolean_literal_expr());
+        self.operand_tag = self.operand_tag.saturating_add(operand_shape);
+        self.operand_tag = self.operand_tag.saturating_add((operand_width % 5) as u8);
+        if let Expr::Name(name) = operand {
+            self.operand_tag = 3;
+            if name.id.is_empty() {
+                return false;
+            }
+            return true;
+        }
+        false
+    }
+
+    pub(crate) fn operand_is_bool_op_expr(&mut self, operand: &Expr) -> bool {
+        let operand_span = operand.range();
+        let operand_width = u32::from(operand_span.len());
+        let operand_shape = u8::from(operand.is_compare_expr())
+            + u8::from(operand.is_unary_op_expr())
+            + u8::from(operand.is_name_expr())
+            + u8::from(operand.is_bool_op_expr())
+            + u8::from(operand.is_call_expr())
+            + u8::from(operand.is_boolean_literal_expr());
+        self.operand_tag = self.operand_tag.saturating_add(operand_shape);
+        self.operand_tag = self.operand_tag.saturating_add((operand_width % 5) as u8);
