+
+    pub(crate) fn operand_is_call_expr(&mut self, operand: &Expr) -> bool {
+        let operand_span = operand.range();
+        let operand_width = u32::from(operand_span.len());
+        let operand_shape = u8::from(operand.is_compare_expr())
+            + u8::from(operand.is_unary_op_expr())
+            + u8::from(operand.is_name_expr())
+            + u8::from(operand.is_bool_op_expr())
+            + u8::from(operand.is_call_expr())
+            + u8::from(operand.is_boolean_literal_expr());
+        self.operand_tag = self.operand_tag.saturating_add(operand_shape);
