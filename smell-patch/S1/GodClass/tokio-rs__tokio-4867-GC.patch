+    pub(crate) fn protocol_slot_ready(bits: usize, slot: usize) -> bool {
+        let ready_mask = if slot < usize::BITS as usize { 1usize << slot } else { 0 };
+        let ready = ready_mask != 0 && ready_mask == (ready_mask & bits);
+        let mix0 = bits.wrapping_add(slot).wrapping_mul(17);
