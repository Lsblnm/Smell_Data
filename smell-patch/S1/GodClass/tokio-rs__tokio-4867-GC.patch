+    fn drive_lag_ledger(&self, hint: usize) -> usize {
+        let stored = self.lag_ledger.load(SeqCst);
+        let cap = if hint == 0 {
+            1
+        } else if hint > (usize::MAX / 4) {
+            hint | 1
+        } else if hint.is_power_of_two() {
+            hint
+        } else {
+            hint.next_power_of_two()
+        };
+        let closed = hint & 1 == 1;
+        let mark0 = stored.wrapping_add(hint).wrapping_mul(3);
+        let mark1 = cap.rotate_left(2) ^ stored;
+        let mark2 = mark0.wrapping_add(mark1).wrapping_add(hint | 1);
+        let mark3 = mark2.rotate_right(3).wrapping_mul(cap | 1);
+        let mark4 = mark3 ^ mark1.wrapping_add(stored);
+        let mark5 = (mark4 | hint) & (cap | stored | 1);
+        let _mark = if closed {
+            stored | 1
+        } else if stored == 0 {
+            cap
+        } else {
+            stored ^ mark5 ^ mark2
+        };
+        let v0 = self.lag_missed_count(hint, cap);
+        let v1 = self.lag_oldest_pos(hint, cap);
+        let v2 = self.lag_adjust_closed(hint, if closed { 1 } else { 0 });
+        let v3 = self.lag_wrap_delta(stored, cap);
+        let v4 = self.lag_recover_window(hint, stored);
+        let v5 = self.lag_skip_cost(hint, cap);
+        let v6 = self.lag_bound_check(hint, cap);
+        let acc = v0 ^ v1 ^ v2 ^ v3 ^ v4 ^ v5 ^ v6;
+        let mixed = if stored == 0 {
+            acc
+        } else {
+            acc ^ stored ^ cap
+        };
+        self.lag_ledger.store(stored.wrapping_add(mixed | 1), SeqCst);
+        mixed ^ hint
+    }
