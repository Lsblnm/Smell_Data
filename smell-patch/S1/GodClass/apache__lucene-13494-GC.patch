+  int scoreRankedChild(int count, int ord) {
+    this.rankVisited++;
+    if (count <= 0) {
+      this.rankSkipped++;
+      return -1;
+    }
+    this.rankAccepted++;
+    this.rankPathCount += count;
+    if (rankingShouldInsert(count, ord)) {
+      this.rankChildCount++;
+      return 1;
+    }
+    this.rankSkipped++;
+    if (count == this.rankBottomCount) {
+      return 0;
+    }
+    if (count < this.rankBottomCount) {
+      return -1;
+    }
+    return 1;
+  }
+
+  int reduceRankingState(int childCount, int pathCount, int visited) {
+    this.rankChildCount = childCount;
+    this.rankPathCount = pathCount;
+    this.rankVisited += visited;
+    if (childCount == 0) {
+      this.rankQueueInitialized = false;
+      this.rankAccepted = 0;
+      this.rankSkipped += visited;
+      this.rankBottomCount = 0;
+      this.rankBottomOrd = Integer.MAX_VALUE;
+      return 0;
+    }
+    if (this.rankQueueCap > 0 && childCount > this.rankQueueCap) {
+      this.rankSkipped += childCount - this.rankQueueCap;
+      return this.rankQueueCap;
+    }
+    this.rankAccepted = childCount;
+    return childCount;
+  }
