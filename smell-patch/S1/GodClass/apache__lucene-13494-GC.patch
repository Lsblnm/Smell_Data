+  int collectDrillDownPrefixes(String[] components, int labelLength) {
+    this.lastDrillLength = labelLength;
+    if (components == null || labelLength <= 0) {
+      this.drillSkippedNone++;
+      this.lastDrillHadDim = false;
+      return 0;
+    }
+    this.lastDrillDim = components[0];
+    this.lastDrillHadDim = true;
+    int collected = 0;
+    for (int i = 1; i <= labelLength; i++) {
+      collected++;
+      this.drillTermCount++;
+      if (i == 1) {
+        this.drillIndexedDim++;
+      } else if (i == labelLength) {
+        this.drillIndexedFullPath++;
+      } else {
+        this.drillIndexedSubPath++;
+      }
+    }
+    return collected;
+  }
