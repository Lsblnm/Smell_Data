+  void analyzeLongCounts(int[] dense, LongIntHashMap hashCounts, boolean initialized) {
+    if (longCountersNeedInit(initialized)) {
+      resetLongCountHelpers();
+    }
+    markLongCountersReady();
+    int unique = 0;
+    if (dense != null) {
+      for (int i = 0; i < dense.length; i++) {
+        if (dense[i] != 0) {
+          unique++;
+          noteLongDenseHit(i);
+          longValueInDenseRange(i, dense.length);
+        }
+      }
+    }
+    if (hashCounts != null && hashCounts.size() != 0) {
+      for (LongIntHashMap.LongIntCursor c : hashCounts) {
+        if (c.value != 0) {
+          unique++;
+          noteLongHashHit(c.key);
+        } else {
+          this.longDuplicateSkips++;
+        }
+      }
+    }
+    longIncrementsTotal();
+    longValueSeenBefore(this.lastLongValue);
+    longHashPreferred(unique, this.longDenseIncrements + this.longHashIncrements);
+    longDenseLimit();
+    if (dense != null) {
+      int[] compactedKeys = new int[Math.max(1, unique)];
+      int filled = 0;
+      for (int i = 0; i < dense.length; i++) {
+        if (dense[i] != 0 && filled < compactedKeys.length) {
+          compactedKeys[filled++] = i;
+          skipDuplicateLong(filled, i, this.lastLongValue);
+          shouldCountLongValue(filled, i, this.lastLongValue);
+        }
+      }
+    }
+    if (hashCounts != null && hashCounts.size() != 0) {
+      long[] keys = new long[hashCounts.size()];
+      int[] values = new int[hashCounts.size()];
+      compactLongHash(hashCounts, keys, values);
+      for (int i = 0; i < keys.length; i++) {
+        if (values[i] != 0) {
+          longValueInDenseRange(keys[i], this.longDenseLimit);
+        }
+      }
+    }
+    this.longInitCount++;
+    this.longCountersReady = initialized;
+    summarizeLongIncrements();
+    classifyLongValue(this.lastLongValue, this.longDenseLimit);
+  }
