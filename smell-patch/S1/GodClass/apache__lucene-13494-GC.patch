+  int measureEncodedPath(String encoded) {
+    this.pathDecodeCount++;
+    if (encoded == null || encoded.length() == 0) {
+      this.lastPathWasEmpty = true;
+      this.lastPathComponentCount = 0;
+      this.lastEncodedPath = "";
+      return 0;
+    }
+    int segs = 1;
+    int escaped = 0;
+    boolean inEscape = false;
+    for (int i = 0; i < encoded.length(); i++) {
+      char ch = encoded.charAt(i);
+      if (inEscape) {
+        inEscape = false;
+        escaped++;
+        this.decodedCharCount++;
+        continue;
+      }
+      if (ch == this.pathEscape) {
+        inEscape = true;
+        this.escapedCharCount++;
+      } else if (ch == this.pathDelim) {
+        segs++;
+      } else {
+        this.decodedCharCount++;
+      }
+    }
+    this.lastEncodedPath = encoded;
+    this.lastPathComponentCount = segs;
+    this.lastPathWasEmpty = false;
+    return segs;
+  }
+
+  int compareEncodedPaths(String left, String right) {
+    this.pathDecodeCount++;
+    if (left == null || left.length() == 0) {
+      this.lastPathWasEmpty = true;
+      if (right == null || right.length() == 0) {
+        this.lastPathComponentCount = 0;
+        return 0;
+      }
+      return -1;
+    }
+    if (right == null || right.length() == 0) {
+      this.lastEncodedPath = left;
+      this.lastPathComponentCount = measureEncodedPath(left);
+      return 1;
+    }
+    int leftSegs = measureEncodedPath(left);
+    int rightSegs = measureEncodedPath(right);
+    this.lastEncodedPath = left;
+    this.lastPathWasEmpty = false;
+    if (leftSegs != rightSegs) {
+      this.lastPathComponentCount = leftSegs;
+      return leftSegs - rightSegs;
+    }
+    return left.compareTo(right);
+  }
