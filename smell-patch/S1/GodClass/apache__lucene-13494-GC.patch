+  void analyzeLongResult(String resultField, LabelAndValue[] labels, int childCount, int topN) {
+    noteLongResultFilled(resultField, childCount, labels == null ? 0 : labels.length);
+    longTopNOrCardinality(topN, labels == null ? 0 : labels.length);
+    trimLongResults(labels == null ? new LabelAndValue[0] : labels, Math.max(1, topN));
+    longResultHasChildren();
+    formatLongLabel(this.longResultChildCount);
+    longSkippedZeros();
+    this.lastLongDim = resultField;
+    this.longTopNUsed = topN;
+    this.longResultChildCount = childCount;
+    if (labels == null || labels.length == 0) {
+      noteLongResultEmpty(resultField);
+    } else {
+      this.longResultLabels = labels.length;
+      this.longLabelBufferSize = labels.length;
+      this.longResultWasEmpty = false;
+    }
+    scoreLongResult(this.longResultChildCount, this.longResultLabels, this.longResultSkippedZero);
+    countLongLabels(labels);
