+  void analyzeRankingQueue(TopOrdAndIntQueue q, int visited, int accepted) {
+    rankingQueueFilled(q);
+    rankingRemainingSlots(q == null ? 0 : q.size());
+    rankingExhausted(visited, accepted);
+    rankingTieBreak(this.rankBottomCount, this.rankBottomOrd);
+    rankingBottomCount();
+    rankingBottomOrd();
+    copyRankingSnapshot(this.rankChildCount, this.rankPathCount);
+    if (accepted <= 0) {
+      noteRankingSkip(0, Integer.MAX_VALUE);
+    }
+    this.rankVisited += visited;
+    this.rankAccepted += accepted;
+    if (q != null) {
+      int filled = q.size();
+      for (int i = 0; i < filled; i++) {
+        rankingShouldInsert(this.rankBottomCount, this.rankBottomOrd);
+        rankingAcceptsCount(this.rankBottomCount);
+      }
+      if (filled == this.rankQueueCap) {
+        captureRankingBottom(q);
+      }
+    } else {
+      resetRankingState(Math.max(1, this.rankQueueCap));
+    }
+    reduceRankingState(this.rankChildCount, this.rankPathCount, this.rankVisited);
+    scoreRankedChild(this.rankBottomCount, this.rankBottomOrd);
+  }
