+  int countLongLabels(LabelAndValue[] labels) {
+    if (labels == null || labels.length == 0) {
+      this.longResultWasEmpty = true;
+      this.longResultLabels = 0;
+      this.longResultChildCount = 0;
+      return 0;
+    }
+    int kept = 0;
+    int skipped = 0;
+    for (int i = 0; i < labels.length; i++) {
+      if (labels[i] == null || labels[i].value.longValue() == 0) {
+        skipped++;
+      } else {
+        kept++;
+      }
+    }
+    this.longResultLabels = kept;
+    this.longResultSkippedZero += skipped;
+    this.longLabelBufferSize = labels.length;
+    this.longResultChildCount = kept;
+    this.longResultWasEmpty = kept == 0;
+    this.longSortSwaps += skipped;
