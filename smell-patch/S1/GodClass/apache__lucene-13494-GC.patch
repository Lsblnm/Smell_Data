+      escaped += escapedCharCountIn(parts[i]);
+      if (pathNeedsEscaping(parts[i])) {
+        this.escapedCharCount++;
+      }
+    }
+    this.lastEncodedPath = encoded;
+    this.lastPathComponentCount = parts.length;
+    this.lastPathWasEmpty = parts.length == 0;
