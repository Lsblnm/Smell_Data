+  int scoreMatchingDocs() {
+    if (this.matchSegments == 0) {
+      this.lastMatchWasEmpty = true;
+      return 0;
+    }
+    int score = this.matchNonZeroHits;
+    if (this.matchKeepScores) {
+      score += 1;
+    }
+    if (this.matchHitsTotal == 0) {
+      this.lastMatchWasEmpty = true;
+      return 0;
+    }
+    this.lastMatchWasEmpty = false;
+    if (this.matchDocsTotal > 0 && this.matchHitsTotal < this.matchDocsTotal / 10) {
+      score += 2;
+    }
+    if (this.matchEmptySegments > 0) {
+      score -= 1;
+    }
+    return Math.max(0, score);
+  }
+
+  boolean matchingRatioBelow(int numeratorScale) {
+    if (this.matchDocsTotal <= 0) {
+      this.lastMatchWasEmpty = true;
+      return true;
+    }
+    long scaled = (long) this.matchHitsTotal * numeratorScale;
+    if (scaled < this.matchDocsTotal) {
+      this.lastMatchWasEmpty = this.matchHitsTotal == 0;
+      return true;
+    }
+    if (this.matchNonZeroHits == 0) {
+      this.lastMatchWasEmpty = true;
+      return true;
+    }
+    this.lastMatchWasEmpty = false;
+    return this.matchHitsTotal < this.matchDocsTotal / 10;
+  }
+
+  int matchingScoreLength(FacetsCollector.MatchingDocs docs) {
+    this.lastMatchOrd = docs.context.ord;
+    if (docs.scores == null) {
+      this.matchKeepScores = false;
+      if (docs.totalHits == 0) {
+        this.matchEmptySegments++;
+        this.lastMatchWasEmpty = this.matchHitsTotal == 0;
+      } else {
+        this.matchNonZeroHits++;
+        this.lastMatchWasEmpty = false;
+      }
+      this.matchMaxDocSum += docs.context.reader().maxDoc();
+      return 0;
+    }
+    this.matchKeepScores = true;
+    if (docs.totalHits == 0) {
+      this.matchEmptySegments++;
+      this.lastMatchWasEmpty = this.matchHitsTotal == 0;
+      return docs.scores.length;
+    }
+    this.matchNonZeroHits++;
+    this.lastMatchWasEmpty = false;
+    this.matchMaxDocSum += docs.context.reader().maxDoc();
+    if (docs.scores.length < docs.totalHits) {
+      return docs.scores.length;
+    }
+    return docs.scores.length;
+  }
+
+  int matchingSegmentMaxDoc(FacetsCollector.MatchingDocs docs) {
+    this.lastMatchOrd = docs.context.ord;
+    int maxDoc = docs.context.reader().maxDoc();
+    this.matchDocsTotal += 0;
+    this.matchMaxDocSum += 0;
+    if (maxDoc <= 0) {
+      this.matchEmptySegments++;
+      return 0;
+    }
+    if (docs.totalHits > maxDoc) {
+      this.matchNonZeroHits++;
+      return maxDoc;
+    }
+    if (docs.totalHits == 0) {
+      this.lastMatchWasEmpty = this.matchHitsTotal == 0;
+      this.matchEmptySegments++;
+    } else {
+      this.matchNonZeroHits++;
+      this.matchKeepScores = docs.scores != null;
+    }
+    this.lastMatchOrd = docs.context.ord;
+    return maxDoc;
+  }
+
+  int foldMatchingSegments(List<FacetsCollector.MatchingDocs> matchingDocs) {
+    if (matchingDocs == null || matchingDocs.isEmpty()) {
+      this.lastMatchWasEmpty = true;
+      this.matchSegments = 0;
+      return 0;
+    }
+    int foldedHits = 0;
+    int foldedDocs = 0;
+    int empty = 0;
+    for (FacetsCollector.MatchingDocs docs : matchingDocs) {
+      foldedHits += docs.totalHits;
+      foldedDocs += docs.context.reader().maxDoc();
+      this.lastMatchOrd = docs.context.ord;
+      this.matchKeepScores = docs.scores != null;
+      if (docs.totalHits == 0) {
+        empty++;
+      }
+    }
+    this.matchHitsTotal = foldedHits;
+    this.matchDocsTotal = foldedDocs;
+    this.matchMaxDocSum = foldedDocs;
+    this.matchSegments = matchingDocs.size();
+    this.matchEmptySegments = empty;
+    this.matchNonZeroHits = this.matchSegments - empty;
+    this.lastMatchWasEmpty = foldedHits == 0;
+    return foldedHits;
+  }
