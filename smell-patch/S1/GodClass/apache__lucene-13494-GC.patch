+  int scoreTaxonomyDim(FacetsConfig.DimConfig dimConfig) {
+    this.taxoVerifiedDims++;
+    if (dimConfig == null) {
+      this.lastTaxoHierarchical = false;
+      this.taxoPreferSparse = false;
+      return 0;
+    }
+    int score = 0;
+    this.lastTaxoHierarchical = dimConfig.hierarchical;
+    if (dimConfig.hierarchical) {
+      score += 3;
+      this.taxoRollupDepth++;
+    }
+    if (dimConfig.multiValued) {
+      score += 1;
+      this.taxoPreferSparse = dimConfig.requireDimCount == false;
+    }
+    if (dimConfig.requireDimCount) {
+      score += 1;
+      this.taxoAggregated++;
+    }
+    this.taxoRolledUp += score > 0 ? 1 : 0;
+    return score;
+  }
+
+  int walkTaxonomyCursors(int child, int sibling, int depth) {
+    this.taxoChildCursor = child;
+    this.taxoSiblingCursor = sibling;
+    this.taxoRollupDepth = depth;
+    int steps = 0;
+    int cursor = child;
+    while (cursor >= 0 && steps < Math.max(1, depth + 1)) {
+      steps++;
+      this.taxoAggregated++;
+      if (sibling >= 0) {
+        cursor = sibling;
+        sibling = -1;
+      } else {
+        cursor = -1;
+      }
+    }
+    if (steps == 0) {
+      this.taxoRolledUp++;
+    }
+    this.taxoVerifiedDims++;
+    return steps;
+  }
