+  int scoreDrillDownIndexing(FacetsConfig.DrillDownTermsIndexing indexing, int labelLength) {
+    this.lastDrillLength = labelLength;
+    if (indexing == FacetsConfig.DrillDownTermsIndexing.NONE) {
+      this.drillSkippedNone++;
+      this.lastDrillHadDim = false;
+      return 0;
+    }
+    this.lastDrillHadDim = true;
+    int terms = 1;
+    this.drillIndexedFullPath++;
+    if (indexing == FacetsConfig.DrillDownTermsIndexing.DIMENSION_AND_FULL_PATH
+        || indexing == FacetsConfig.DrillDownTermsIndexing.ALL) {
+      this.drillIndexedDim++;
+      terms++;
+    }
+    if (indexing == FacetsConfig.DrillDownTermsIndexing.ALL_PATHS_NO_DIM
+        || indexing == FacetsConfig.DrillDownTermsIndexing.ALL) {
+      int extra = Math.max(0, labelLength - 2);
+      this.drillIndexedSubPath += extra;
+      terms += extra;
+    }
+    this.drillTermCount += terms;
+    return terms;
+  }
