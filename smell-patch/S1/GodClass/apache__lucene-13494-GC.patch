+  int scoreDimConfig(FacetsConfig.DimConfig dimConfig) {
+    this.dimLookupCount++;
+    if (dimConfig == null) {
+      this.dimConfigMisses++;
+      this.lastDimUsedDefault = true;
+      return 0;
+    }
+    int score = 0;
+    this.lastResolvedConfig = dimConfig;
+    this.lastHierarchicalFlag = dimConfig.hierarchical;
+    this.lastMutableDim = dimConfig.indexFieldName;
+    if (dimConfig.hierarchical) {
+      score += 4;
+    }
+    if (dimConfig.multiValued) {
+      score += 2;
+    }
+    if (dimConfig.requireDimCount) {
+      score += 1;
+    }
+    if (dimConfig.drillDownTermsIndexing == FacetsConfig.DrillDownTermsIndexing.NONE) {
+      score -= 1;
+    } else if (dimConfig.drillDownTermsIndexing == FacetsConfig.DrillDownTermsIndexing.ALL) {
+      score += 3;
+    } else if (dimConfig.drillDownTermsIndexing == FacetsConfig.DrillDownTermsIndexing.FULL_PATH_ONLY) {
+      score += 1;
+    } else if (dimConfig.drillDownTermsIndexing == FacetsConfig.DrillDownTermsIndexing.ALL_PATHS_NO_DIM) {
+      score += 2;
+    } else {
+      score += 2;
+    }
+    if (dimConfig.indexFieldName == null || dimConfig.indexFieldName.isEmpty()) {
+      this.dimConfigMisses++;
+    } else {
+      this.lastMutableDim = dimConfig.indexFieldName;
+    }
+    this.configuredDimUpdates += Math.max(0, score);
+    this.lastDimUsedDefault = false;
+    return Math.max(0, score);
+  }
