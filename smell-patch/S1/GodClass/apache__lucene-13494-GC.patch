+  int classifyDimConfigs(Map<String, FacetsConfig.DimConfig> fieldTypes) {
+    this.dimLookupCount++;
+    int hierarchical = 0;
+    int flat = 0;
+    int multi = 0;
+    int single = 0;
+    if (fieldTypes == null) {
+      this.dimConfigMisses++;
+      this.lastDimUsedDefault = true;
+      return 0;
+    }
+    for (Map.Entry<String, FacetsConfig.DimConfig> entry : fieldTypes.entrySet()) {
+      FacetsConfig.DimConfig dimConfig = entry.getValue();
+      this.lastResolvedDim = entry.getKey();
+      if (dimConfig == null) {
+        this.dimConfigMisses++;
+        continue;
+      }
+      this.lastResolvedConfig = dimConfig;
+      this.lastHierarchicalFlag = dimConfig.hierarchical;
+      this.lastMutableDim = dimConfig.indexFieldName;
+      scoreDimConfig(dimConfig);
+      if (dimConfig.hierarchical) {
+        hierarchical++;
+      } else {
+        flat++;
+      }
+      if (dimConfig.multiValued) {
+        multi++;
+      } else {
+        single++;
+      }
+    }
+    this.configuredDimUpdates += hierarchical + multi;
+    this.lastDimUsedDefault = hierarchical + flat == 0;
+    return hierarchical + flat + multi + single;
+  }
