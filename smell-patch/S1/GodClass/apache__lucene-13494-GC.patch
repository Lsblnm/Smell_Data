+  int summarizeLongIncrements() {
+    int dense = this.longDenseIncrements;
+    int hash = this.longHashIncrements;
+    int skipped = this.longDuplicateSkips;
+    if (dense < 0) {
+      dense = 0;
+    }
+    if (hash < 0) {
+      hash = 0;
+    }
+    this.longCountMode = hash > dense ? 1 : 0;
+    if (this.longMinSeen == Long.MAX_VALUE && dense + hash == 0) {
+      this.longCountersReady = false;
+    } else {
+      this.longCountersReady = true;
+    }
+    this.longInitCount++;
+    this.lastLongValue = this.longMinSeen;
+    return dense + hash + skipped;
+  }
+
+  int classifyLongValue(long value, int denseLength) {
+    this.lastLongValue = value;
+    if (value >= 0 && value < denseLength && value < this.longDenseLimit) {
+      this.longCountMode = 0;
+      this.longDenseIncrements++;
+      if (value < this.longMinSeen) {
+        this.longMinSeen = value;
+      }
+      return 0;
+    }
+    this.longCountMode = 1;
+    this.longHashIncrements++;
+    if (value < this.longMinSeen) {
+      this.longMinSeen = value;
+    }
+    if (value == this.lastLongValue && this.longInitCount > 0) {
+      this.longDuplicateSkips++;
+    }
+    return 1;
+  }
