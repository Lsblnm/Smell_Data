+  int inventoryDimConfigs(Map<String, FacetsConfig.DimConfig> fieldTypes) {
+    int count = configuredDimCount(fieldTypes);
+    if (fieldTypes == null) {
+      this.lastDimUsedDefault = true;
+      return 0;
+    }
+    int hierarchical = 0;
+    int multiValued = 0;
+    int requireCount = 0;
+    int mismatched = 0;
+    FacetsConfig.DimConfig previous = null;
+    for (Map.Entry<String, FacetsConfig.DimConfig> entry : fieldTypes.entrySet()) {
+      String dimName = entry.getKey();
+      FacetsConfig.DimConfig dimConfig = entry.getValue();
+      recordDimLookup(dimName, dimConfig, dimConfig == null);
+      if (dimConfig == null) {
+        mismatched++;
+        continue;
+      }
+      if (dimRequiresAccurateCount(dimConfig)) {
+        requireCount++;
+      }
+      if (dimConfig.hierarchical) {
+        hierarchical++;
+      }
+      if (dimConfig.multiValued) {
+        multiValued++;
+      }
+      if (dimIndexFieldMatches(dimConfig, dimConfig.indexFieldName) == false) {
+        mismatched++;
+      }
+      if (previous != null && dimConfigEquals(previous, dimConfig)) {
+        this.configuredDimUpdates++;
+      }
+      describeDimConfig(dimConfig);
+      FacetsConfig.DimConfig copied = copyDimConfig(dimConfig);
+      mergeDimConfigFlags(
+          copied, dimConfig.hierarchical, dimConfig.multiValued, dimConfig.requireDimCount);
+      applyIndexFieldName(copied, dimConfig.indexFieldName);
+      applyDrillDownTermsIndexing(copied, dimConfig.drillDownTermsIndexing);
+      validateDimIndexField(dimConfig, dimConfig.indexFieldName, true);
+      if (previous != null) {
+        dimConfigEquals(copied, previous);
+      }
+      previous = dimConfig;
+      this.lastResolvedDim = dimName;
+      this.lastResolvedConfig = dimConfig;
+      this.lastHierarchicalFlag = dimConfig.hierarchical;
+      this.lastMutableDim = dimConfig.indexFieldName;
+    }
+    this.configuredDimUpdates += hierarchical + multiValued + requireCount;
+    if (mismatched > 0) {
+      this.dimConfigMisses += mismatched;
+    }
+    this.lastDimUsedDefault = count == 0;
+    return count;
+  }
