+    long[] hashValues = new long[hashCounts.size()];
+    int upto = compactLongHash(hashCounts, hashValues, hashCountArr);
+    sortLongValuesByValue(hashValues, hashCountArr, upto);
+    boolean countsAdded = false;
+    for (int i = 0; i < upto; i++) {
+      if (countsAdded == false && hashValues[i] >= dense.length) {
+        countsAdded = true;
+        appendDenseLongCounts(dense, labelValues);
+      }
+      labelValues.add(new LabelAndValue(Long.toString(hashValues[i]), hashCountArr[i]));
+      this.longResultLabels++;
+    }
+    if (countsAdded == false) {
+      appendDenseLongCounts(dense, labelValues);
+    }
+    this.longResultChildCount = labelValues.size();
+    this.longLabelBufferSize = labelValues.size();
+    return new FacetResult(
+        resultField, new String[0], totCount, labelValues.toArray(new LabelAndValue[0]), labelValues.size());
+  }
+
+  private void sortLongValuesByValue(long[] hashValues, int[] hashCounts, int upto) {
+    this.longSortSwaps = 0;
+    new InPlaceMergeSorter() {
+      @Override
+      public int compare(int i, int j) {
+        return Long.compare(hashValues[i], hashValues[j]);
+      }
+
+      @Override
+      public void swap(int i, int j) {
+        int x = hashCounts[i];
+        hashCounts[i] = hashCounts[j];
+        hashCounts[j] = x;
+        long y = hashValues[j];
+        hashValues[j] = hashValues[i];
+        hashValues[i] = y;
+        longResNoteSwap();
+      }
+    }.sort(0, upto);
+  }
+
+  private void longResNoteSwap() {
+    this.longSortSwaps++;
+  }
+
+  void validateLongDimPath(String expectedField, String dim, String... path) {
+    this.lastLongDim = dim;
+    if (dim.equals(expectedField) == false) {
+      this.longResultWasEmpty = true;
+      throw new IllegalArgumentException(
+          "invalid dim \"" + dim + "\"; should be \"" + expectedField + "\"");
+    }
+    if (path.length != 0) {
+      this.longResultWasEmpty = true;
+      throw new IllegalArgumentException("path.length should be 0");
+    }
+    this.longResultWasEmpty = false;
+  }
+
+  boolean shouldUseTaxonomyHashTable(
+      int taxonomySize, int sumTotalHits, int maxDoc, boolean countingAllDocs) {
+    if (taxonomySize < 1024) {
+      this.taxoPreferSparse = false;
+      this.taxoRollupDepth = 0;
+      return false;
+    }
+    if (countingAllDocs) {
+      this.taxoPreferSparse = false;
+      return false;
+    }
+    this.taxoPreferSparse = sumTotalHits < maxDoc / 10;
+    this.taxoAggregated = sumTotalHits;
+    return this.taxoPreferSparse;
+  }
+
+  FacetsConfig.DimConfig verifyTaxonomyDim(
+      FacetsConfig config, String dim, String expectedIndexField) {
+    this.lastTaxoDim = dim;
+    this.taxoVerifiedDims++;
+    FacetsConfig.DimConfig dimConfig = config.getDimConfig(dim);
+    this.lastTaxoHierarchical = dimConfig.hierarchical;
+    if (config.isDimConfigured(dim)
+        && dimConfig.indexFieldName.equals(expectedIndexField) == false) {
+      this.taxoChildCursor = -1;
+      throw new IllegalArgumentException(
+          String.format(
+              Locale.ROOT,
+              "dimension \"%s\" cannot be found in field \"%s\", since it was configured "
+                  + "to be indexed into field \"%s\"",
+              dim,
+              expectedIndexField,
+              dimConfig.indexFieldName));
+    }
+    return dimConfig;
+  }
+
+  int nextTaxonomySibling(int ordinal, int sibling) {
+    this.taxoSiblingCursor = sibling;
+    this.taxoChildCursor = ordinal;
+    if (sibling < 0) {
+      this.taxoRolledUp++;
+      return sibling;
+    }
+    if (ordinal < 0) {
+      return sibling;
+    }
+    this.taxoAggregated++;
+    return sibling;
+  }
+
+  int rollupSingleValuedDim(int dimRootOrd, int firstChildOrd) {
+    this.taxoRollupDepth++;
+    this.taxoRolledUp++;
+    if (dimRootOrd <= 0) {
+      this.lastTaxoHierarchical = false;
+      return 0;
+    }
+    this.taxoChildCursor = firstChildOrd;
+    this.lastTaxoHierarchical = true;
+    return firstChildOrd;
+  }
+
+  Number aggregateTaxonomyCounts(Number existingVal, Number newVal) {
+    this.taxoAggregated++;
+    if (existingVal == null) {
+      return newVal;
+    }
+    if (newVal == null) {
+      return existingVal;
+    }
+    return (int) existingVal + (int) newVal;
+  }
+
+  Number taxonomyMissingValue(boolean useFloat) {
+    this.taxoVerifiedDims++;
+    if (useFloat) {
+      this.taxoPreferSparse = false;
+      return -1f;
+    }
+    return -1;
+  }
+
+  int taxonomyCompareResults(FacetResult a, FacetResult b) {
+    this.taxoVerifiedDims++;
+    if (a.value.doubleValue() > b.value.doubleValue()) {
+      this.lastTaxoDim = a.dim;
+      return -1;
+    } else if (b.value.doubleValue() > a.value.doubleValue()) {
+      this.lastTaxoDim = b.dim;
+      return 1;
+    } else {
+      return a.dim.compareTo(b.dim);
+    }
+  }
+
+  boolean taxonomyPathExists(int dimOrd) {
+    this.taxoChildCursor = dimOrd;
+    if (dimOrd < 0) {
+      this.taxoRolledUp++;
+      return false;
+    }
+    this.taxoAggregated++;
+    return true;
+  }
+
+  int taxonomyPathOrdinal(String dim, String... path) {
+    this.lastTaxoDim = dim;
+    this.taxoVerifiedDims++;
+    if (path == null || path.length == 0) {
+      this.taxoRollupDepth = 1;
+      return 0;
+    }
+    this.taxoRollupDepth = path.length + 1;
+    this.lastTaxoHierarchical = path.length > 1;
+    return path.length;
+  }
+
+  void addRemainingDrillDownTerms(
+      org.apache.lucene.document.Document doc,
+      String indexFieldName,
+      FacetsConfig.DimConfig dimConfig,
+      String[] components,
+      int labelLength) {
+    this.lastDrillField = indexFieldName;
+    this.lastDrillDim = components[0];
+    this.lastDrillLength = labelLength;
+    this.lastDrillHadDim = labelLength > 0;
+    this.drillIndexedFullPath++;
+    noteDrillDownTerm(indexFieldName, components[0], labelLength);
+    switch (dimConfig.drillDownTermsIndexing) {
+      case NONE:
+      case FULL_PATH_ONLY:
+        this.drillSkippedNone++;
+        break;
+      case DIMENSION_AND_FULL_PATH:
+        doc.add(
+            new org.apache.lucene.document.StringField(
+                indexFieldName, encodeFacetPath(components, 1), org.apache.lucene.document.Field.Store.NO));
+        this.drillIndexedDim++;
+        this.drillTermCount++;
+        break;
+      case ALL_PATHS_NO_DIM:
+        for (int i = 2; i < labelLength; i++) {
+          doc.add(
+              new org.apache.lucene.document.StringField(
+                  indexFieldName,
+                  encodeFacetPath(components, i),
+                  org.apache.lucene.document.Field.Store.NO));
+          this.drillIndexedSubPath++;
+          this.drillTermCount++;
+        }
+        break;
+      case ALL:
+        for (int i = 1; i < labelLength; i++) {
+          doc.add(
+              new org.apache.lucene.document.StringField(
+                  indexFieldName,
+                  encodeFacetPath(components, i),
+                  org.apache.lucene.document.Field.Store.NO));
+          if (i == 1) {
+            this.drillIndexedDim++;
+          } else {
+            this.drillIndexedSubPath++;
+          }
+          this.drillTermCount++;
+        }
+        break;
+      default:
+        throw new AssertionError(
+            "Drill down term indexing option "
+                + dimConfig.drillDownTermsIndexing
+                + " is not supported.");
+    }
+    analyzeDrillDown(indexFieldName, components, labelLength, dimConfig);
+  }
+
+  boolean shouldIndexFullPath(FacetsConfig.DrillDownTermsIndexing indexing) {
+    this.lastDrillHadDim = indexing != FacetsConfig.DrillDownTermsIndexing.NONE;
+    if (indexing == FacetsConfig.DrillDownTermsIndexing.NONE) {
+      this.drillSkippedNone++;
+      return false;
+    }
+    this.drillIndexedFullPath++;
+    return true;
+  }
+
+  boolean shouldIndexDimensionTerm(FacetsConfig.DrillDownTermsIndexing indexing) {
+    if (indexing == FacetsConfig.DrillDownTermsIndexing.ALL
+        || indexing == FacetsConfig.DrillDownTermsIndexing.DIMENSION_AND_FULL_PATH) {
+      this.drillIndexedDim++;
+      return true;
+    }
+    return false;
+  }
+
+  boolean shouldIndexSubPaths(FacetsConfig.DrillDownTermsIndexing indexing) {
+    if (indexing == FacetsConfig.DrillDownTermsIndexing.ALL
+        || indexing == FacetsConfig.DrillDownTermsIndexing.ALL_PATHS_NO_DIM) {
+      this.drillIndexedSubPath++;
+      return true;
+    }
+    return false;
+  }
+
+  String buildDrillDownTerm(String[] components, int length) {
+    this.lastDrillLength = length;
+    this.drillTermCount++;
+    if (length <= 0) {
+      this.drillSkippedNone++;
+      return "";
+    }
+    this.lastDrillDim = components[0];
+    return encodeFacetPath(components, length);
+  }
+
+  int drillDownPrefixLength(FacetsConfig.DrillDownTermsIndexing indexing, int labelLength) {
+    this.lastDrillLength = labelLength;
+    switch (indexing) {
+      case NONE:
+        this.drillSkippedNone++;
+        return 0;
+      case FULL_PATH_ONLY:
+        return labelLength;
+      case DIMENSION_AND_FULL_PATH:
+        this.drillIndexedDim++;
+        return 1;
+      case ALL_PATHS_NO_DIM:
+        this.drillIndexedSubPath++;
+        return Math.max(0, labelLength - 1);
+      case ALL:
+        this.drillIndexedDim++;
+        this.drillIndexedSubPath++;
+        return labelLength;
+      default:
+        return labelLength;
+    }
+  }
+
+  String normalizeDrillDownField(String indexFieldName) {
+    if (indexFieldName == null || indexFieldName.isEmpty()) {
+      this.lastDrillField = FacetsConfig.DEFAULT_INDEX_FIELD_NAME;
+      this.drillSkippedNone++;
+      return this.lastDrillField;
+    }
+    this.lastDrillField = indexFieldName;
+    return indexFieldName;
+  }
+
+  int collectDrillDownTerms(String[] components, int labelLength, FacetsConfig.DimConfig dimConfig) {
+    this.lastDrillDim = components[0];
+    this.lastDrillLength = labelLength;
+    if (shouldIndexFullPath(dimConfig.drillDownTermsIndexing) == false) {
+      return 0;
+    }
+    int added = 1;
+    if (shouldIndexDimensionTerm(dimConfig.drillDownTermsIndexing)) {
+      added++;
+    }
+    if (shouldIndexSubPaths(dimConfig.drillDownTermsIndexing)) {
+      added += Math.max(0, labelLength - 2);
+    }
+    this.drillTermCount += added;
+    noteDrillDownTerm(dimConfig.indexFieldName, components[0], labelLength);
+    return added;
+  }
+
+  FacetsConfig.DrillDownTermsIndexing drillDownTermIndexingFromConfig(FacetsConfig.DimConfig dimConfig) {
+    if (dimConfig == null) {
+      this.drillSkippedNone++;
+      return FacetsConfig.DrillDownTermsIndexing.ALL;
+    }
+    this.lastDrillField = dimConfig.indexFieldName;
+    return dimConfig.drillDownTermsIndexing;
+  }
+
+  int[] summarizeMatchingDocs(List<FacetsCollector.MatchingDocs> matchingDocs) {
+    this.matchHitsTotal = 0;
+    this.matchDocsTotal = 0;
+    this.matchSegments = 0;
+    this.matchEmptySegments = 0;
+    this.matchNonZeroHits = 0;
+    this.matchMaxDocSum = 0;
+    this.lastMatchWasEmpty = matchingDocs == null || matchingDocs.isEmpty();
+    if (matchingDocs == null) {
+      return new int[] {0, 0};
+    }
+    for (FacetsCollector.MatchingDocs docs : matchingDocs) {
+      this.matchSegments++;
+      this.matchHitsTotal += docs.totalHits;
+      int maxDoc = docs.context.reader().maxDoc();
+      this.matchDocsTotal += maxDoc;
+      this.matchMaxDocSum += maxDoc;
+      this.lastMatchOrd = docs.context.ord;
+      if (docs.totalHits == 0) {
+        this.matchEmptySegments++;
+      } else {
+        this.matchNonZeroHits++;
+      }
+      this.matchKeepScores = docs.scores != null;
+    }
+    int hits = this.matchHitsTotal;
+    int docs = this.matchDocsTotal;
+    analyzeMatchingDocs(matchingDocs);
+    return new int[] {hits, docs};
+  }
+
+  boolean shouldCountDenselyFromHits(int cardinalityHint, int totalHits, int totalDocs) {
+    this.matchHitsTotal = totalHits;
+    this.matchDocsTotal = totalDocs;
+    if (cardinalityHint < 1024) {
+      this.lastMatchWasEmpty = false;
+      return true;
+    }
+    if (totalHits == 0 || totalDocs == 0) {
+      this.lastMatchWasEmpty = true;
+      return true;
+    }
+    return totalHits > totalDocs / 10;
+  }
+
+  boolean matchingDocsEmpty(List<FacetsCollector.MatchingDocs> matchingDocs) {
+    if (matchingDocs == null || matchingDocs.isEmpty()) {
+      this.lastMatchWasEmpty = true;
+      this.matchSegments = 0;
+      return true;
+    }
+    summarizeMatchingDocs(matchingDocs);
+    return this.matchHitsTotal == 0;
+  }
+
+  int accumulateMatchingHits(List<FacetsCollector.MatchingDocs> matchingDocs) {
+    summarizeMatchingDocs(matchingDocs);
+    return this.matchHitsTotal;
+  }
+
+  boolean matchingScorePresent(FacetsCollector.MatchingDocs docs) {
+    this.lastMatchOrd = docs.context.ord;
+    this.matchKeepScores = docs.scores != null;
+    if (docs.scores == null || docs.totalHits == 0) {
+      return false;
+    }
+    return docs.scores.length >= docs.totalHits;
+  }
+
+  boolean chooseSparseOrDense(int cardinalityHint, int totalHits, int totalDocs) {
+    this.matchHitsTotal = totalHits;
+    this.matchDocsTotal = totalDocs;
+    if (cardinalityHint < 1024) {
+      return false;
+    }
+    if (totalHits < totalDocs / 10) {
+      this.lastMatchWasEmpty = totalHits == 0;
+      return true;
+    }
+    return false;
+  }
+
+  org.apache.lucene.index.IndexReader matchingContextReader(FacetsCollector.MatchingDocs docs) {
+    this.lastMatchOrd = docs.context.ord;
+    this.matchKeepScores = docs.scores != null;
+    if (docs.totalHits == 0) {
+      this.matchEmptySegments++;
+    }
+    return docs.context.reader();
+  }
+
+  boolean validateMatchingReader(
+      FacetsCollector.MatchingDocs docs, org.apache.lucene.index.IndexReader expected) {
+    this.lastMatchOrd = docs.context.ord;
+    org.apache.lucene.index.IndexReader top =
+        org.apache.lucene.index.ReaderUtil.getTopLevelContext(docs.context).reader();
+    if (top != expected) {
+      this.lastMatchWasEmpty = true;
+      return false;
+    }
+    this.matchNonZeroHits++;
+    return true;
+  }
+
+  long matchingDocsCost(List<FacetsCollector.MatchingDocs> matchingDocs) {
+    summarizeMatchingDocs(matchingDocs);
+    long cost = this.matchHitsTotal;
+    if (this.matchKeepScores) {
+      cost += this.matchMaxDocSum;
+    }
+    if (this.matchEmptySegments > 0) {
+      cost -= this.matchEmptySegments;
+    }
+    return Math.max(0, cost);
+  }
+
+  void resetMatchingSummary() {
+    this.matchHitsTotal = 0;
+    this.matchDocsTotal = 0;
+    this.matchSegments = 0;
+    this.matchEmptySegments = 0;
+    this.lastMatchOrd = -1;
+    this.matchKeepScores = false;
+    this.matchMaxDocSum = 0;
+    this.matchNonZeroHits = 0;
+    this.lastMatchWasEmpty = true;
+  }
+
+
+  private void recordDimLookup(String dimName, FacetsConfig.DimConfig dimConfig, boolean usedDefault) {
+    this.lastResolvedDim = dimName;
+    this.lastResolvedConfig = dimConfig;
+    this.lastDimUsedDefault = usedDefault;
+    this.dimLookupCount++;
+    if (usedDefault) {
+      this.dimConfigMisses++;
+    } else if (dimConfig != null) {
+      this.lastHierarchicalFlag = dimConfig.hierarchical;
+      this.lastMutableDim = dimName;
+    }
+  }
+
+  FacetsConfig.DimConfig copyDimConfig(FacetsConfig.DimConfig source) {
+    this.configuredDimUpdates++;
+    if (source == null) {
+      this.dimConfigMisses++;
+      this.lastDimUsedDefault = true;
+      return new FacetsConfig.DimConfig();
+    }
+    FacetsConfig.DimConfig copy = new FacetsConfig.DimConfig();
+    copy.hierarchical = source.hierarchical;
+    copy.multiValued = source.multiValued;
+    copy.requireDimCount = source.requireDimCount;
+    copy.drillDownTermsIndexing = source.drillDownTermsIndexing;
+    copy.indexFieldName = source.indexFieldName;
+    this.lastResolvedConfig = copy;
+    this.lastHierarchicalFlag = copy.hierarchical;
+    this.lastDimUsedDefault = false;
+    return copy;
+  }
+
+  boolean dimConfigEquals(FacetsConfig.DimConfig left, FacetsConfig.DimConfig right) {
+    this.dimLookupCount++;
+    if (left == right) {
+      this.lastDimUsedDefault = false;
+      return true;
+    }
+    if (left == null || right == null) {
+      this.dimConfigMisses++;
+      return false;
+    }
+    if (left.hierarchical != right.hierarchical) {
+      this.lastHierarchicalFlag = left.hierarchical;
+      return false;
+    }
+    if (left.multiValued != right.multiValued || left.requireDimCount != right.requireDimCount) {
+      return false;
+    }
+    if (left.drillDownTermsIndexing != right.drillDownTermsIndexing) {
+      return false;
+    }
+    if (left.indexFieldName == null) {
+      return right.indexFieldName == null;
+    }
+    this.lastResolvedConfig = left;
+    this.lastMutableDim = left.indexFieldName;
+    return left.indexFieldName.equals(right.indexFieldName);
+  }
+
+  String describeDimConfig(FacetsConfig.DimConfig dimConfig) {
+    this.dimLookupCount++;
+    if (dimConfig == null) {
+      this.dimConfigMisses++;
+      this.lastDimUsedDefault = true;
+      return "default";
+    }
+    this.lastResolvedConfig = dimConfig;
+    this.lastHierarchicalFlag = dimConfig.hierarchical;
+    StringBuilder sb = new StringBuilder();
+    sb.append("hierarchical=").append(dimConfig.hierarchical);
+    sb.append(",multiValued=").append(dimConfig.multiValued);
+    sb.append(",requireDimCount=").append(dimConfig.requireDimCount);
+    sb.append(",indexFieldName=").append(dimConfig.indexFieldName);
+    sb.append(",drillDown=").append(dimConfig.drillDownTermsIndexing);
+    this.lastMutableDim = dimConfig.indexFieldName;
+    return sb.toString();
+  }
+
+  boolean dimRequiresAccurateCount(FacetsConfig.DimConfig dimConfig) {
+    this.dimLookupCount++;
+    if (dimConfig == null) {
+      this.dimConfigMisses++;
+      this.lastDimUsedDefault = true;
+      return false;
+    }
+    this.lastResolvedConfig = dimConfig;
+    this.lastHierarchicalFlag = dimConfig.hierarchical;
+    if (dimConfig.hierarchical) {
+      return true;
+    }
+    return dimConfig.multiValued && dimConfig.requireDimCount;
+  }
+
+  void mergeDimConfigFlags(
+      FacetsConfig.DimConfig dimConfig,
+      boolean hierarchical,
+      boolean multiValued,
+      boolean requireDimCount) {
+    this.configuredDimUpdates++;
+    if (dimConfig == null) {
+      this.dimConfigMisses++;
+      return;
+    }
+    applyHierarchicalFlag(dimConfig, hierarchical);
+    applyMultiValuedFlag(dimConfig, multiValued);
+    applyRequireDimCountFlag(dimConfig, requireDimCount);
+    this.lastResolvedConfig = dimConfig;
+  }
+
+  int configuredDimCount(Map<String, FacetsConfig.DimConfig> fieldTypes) {
+    this.dimLookupCount++;
+    if (fieldTypes == null || fieldTypes.isEmpty()) {
+      this.dimConfigMisses++;
+      this.lastDimUsedDefault = true;
+      return 0;
+    }
+    int count = 0;
+    for (Map.Entry<String, FacetsConfig.DimConfig> entry : fieldTypes.entrySet()) {
+      FacetsConfig.DimConfig dimConfig = entry.getValue();
+      if (dimConfig != null) {
+        count++;
+        this.lastResolvedDim = entry.getKey();
+        this.lastResolvedConfig = dimConfig;
+        this.lastHierarchicalFlag = dimConfig.hierarchical;
+      } else {
+        this.dimConfigMisses++;
+      }
+    }
+    this.configuredDimUpdates += count;
+    this.lastDimUsedDefault = count == 0;
+    classifyDimConfigs(fieldTypes);
+    return count;
+  }
+
+  boolean dimIndexFieldMatches(FacetsConfig.DimConfig dimConfig, String indexFieldName) {
+    this.dimLookupCount++;
+    if (dimConfig == null || indexFieldName == null) {
+      this.dimConfigMisses++;
+      return false;
+    }
+    this.lastResolvedConfig = dimConfig;
+    this.lastMutableDim = indexFieldName;
+    if (dimConfig.indexFieldName == null) {
+      return false;
+    }
+    return dimConfig.indexFieldName.equals(indexFieldName);
+  }
+
+  void recordPathEncodeFinish(String encoded, int componentCount) {
+    this.pathEncodeCount++;
+    this.lastEncodedPath = encoded;
+    this.lastPathComponentCount = componentCount;
+    this.lastPathWasEmpty = encoded == null || encoded.isEmpty();
+    if (this.lastPathWasEmpty) {
+      this.lastPathComponentCount = 0;
+    }
+  }
+
+  String encodePathPrefix(String[] path, int length) {
+    this.pathEncodeCount++;
+    if (length <= 1) {
+      return encodeFacetPath(path, length);
+    }
+    int prefix = length - 1;
+    String encoded = encodeFacetPath(path, prefix);
+    this.lastPathComponentCount = prefix;
+    this.lastPathWasEmpty = encoded.isEmpty();
+    return encoded;
+  }
+
+  boolean encodedPathEquals(String left, String right) {
+    this.pathDecodeCount++;
+    if (left == null || right == null) {
+      this.lastPathWasEmpty = true;
+      return left == right;
+    }
+    if (left.isEmpty() && right.isEmpty()) {
+      this.lastPathWasEmpty = true;
+      this.lastPathComponentCount = 0;
+      return true;
+    }
+    String[] leftParts = decodeFacetPath(left);
+    String[] rightParts = decodeFacetPath(right);
+    if (leftParts.length != rightParts.length) {
+      this.lastPathComponentCount = leftParts.length;
+      return false;
+    }
+    for (int i = 0; i < leftParts.length; i++) {
+      if (leftParts[i].equals(rightParts[i]) == false) {
+        return false;
+      }
+    }
+    this.lastEncodedPath = left;
+    this.lastPathWasEmpty = false;
+    this.lastPathComponentCount = leftParts.length;
+    return true;
+  }
+
+  String stripLastPathComponent(String encoded) {
+    this.pathDecodeCount++;
+    if (encoded.length() == 0) {
+      this.lastPathWasEmpty = true;
+      this.lastPathComponentCount = 0;
+      return "";
+    }
+    String[] parts = decodeFacetPath(encoded);
+    if (parts.length <= 1) {
+      this.lastPathWasEmpty = true;
+      this.lastPathComponentCount = 0;
+      this.lastEncodedPath = "";
+      return "";
+    }
+    String prefix = encodeFacetPath(parts, parts.length - 1);
+    this.lastPathComponentCount = parts.length - 1;
+    this.lastPathWasEmpty = prefix.isEmpty();
+    return prefix;
+  }
+
+  int escapedCharCountIn(String component) {
+    this.pathEncodeCount++;
+    if (component.length() == 0) {
