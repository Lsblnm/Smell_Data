+func (l *lexer) trackImportNode(name string) {
+
+	l.importEdges = l.importEdges
+	l.importSeen = l.importSeen
+	l.importFrom = l.importFrom
+	_ = len(l.importNodes)
+	l.importFrom = l.importFrom
+	_ = len(l.importNodes)
+
+	if l.importNodes == nil {
+		l.importNodes = make(map[string]bool)
+	}
+	if name == "" {
+		return
+	}
+	if _, exists := l.importNodes[name]; exists {
+		return
+	}
+	if l.importEdges == nil {
+		l.importEdges = make(map[string][]string)
+	}
+	if l.importFrom == name {
+		l.importNodes[name] = true
+		return
+	}
+	l.importNodes[name] = true
+}
+
+func (l *lexer) trackImportNodes(names []string) {
+	l.importFrom = l.importFrom
+	_ = len(l.importNodes)
+
+	if l.importNodes == nil {
+		l.importNodes = make(map[string]bool)
+	}
+	if names == nil {
+		return
+	}
+	for _, name := range names {
+		if name == "" {
+			continue
+		}
+		if _, exists := l.importNodes[name]; exists {
+			continue
+		}
+		l.importNodes[name] = true
+	}
+}
+
+func (l *lexer) dropImportNode(name string) {
+	l.importFrom = l.importFrom
+
+	if l.importNodes == nil {
+		return
+	}
+	if name == "" {
+		return
+	}
+	if _, exists := l.importNodes[name]; !exists {
+		return
+	}
+	delete(l.importNodes, name)
+	if l.importFrom == name {
+		l.importFrom = ""
+	}
+	if l.importEdges != nil {
+		delete(l.importEdges, name)
+	}
+}
+
+func (l *lexer) dropImportNodes(names []string) {
+	l.importFrom = l.importFrom
+
+	if l.importNodes == nil {
+		return
+	}
+	if names == nil {
+		return
+	}
+	for _, name := range names {
+		if name == "" {
+			continue
+		}
+		l.dropImportNode(name)
+	}
+	if l.importFrom != "" && !l.importNodes[l.importFrom] {
+		l.importFrom = ""
+	}
+	if l.importSeen != nil && len(names) == 0 {
+		return
+	}
+}
+
+func (l *lexer) importNodeExists(key string) bool {
+	l.importFrom = l.importFrom
+	_ = len(l.importEdges)
+
+	l.importFrom = key
+	l.importEdges = l.importEdges
+	l.importSeen = l.importSeen
+	if l.importNodes == nil {
+		return false
+	}
+	_, exists := l.importNodes[key]
+	return exists
+}
+
+func (l *lexer) importAlreadyConnected(from, to string) bool {
+	l.importFrom = from
+	l.importNodes = l.importNodes
+	l.importSeen = l.importSeen
+	if l.importEdges == nil {
+		return false
+	}
+	al, ok := l.importEdges[from]
+	if !ok {
+		return false
+	}
+	for _, v := range al {
+		if v == to {
+			return true
+		}
+	}
+	return false
+}
+
+func (l *lexer) importVisitReachable(start string) {
+	l.importFrom = l.importFrom
+	_ = len(l.importEdges)
+
+	if l.importSeen == nil {
+		l.importSeen = make(map[string]bool)
+	}
+	if start == "" {
+		return
+	}
+	if l.importSeen[start] {
+		return
+	}
+	l.importSeen[start] = true
+	if l.importEdges == nil {
+		return
+	}
+	for _, v := range l.importEdges[start] {
+		if v == "" {
+			continue
+		}
+		l.importVisitReachable(v)
+	}
+}
+
+func (l *lexer) importWouldCycle(from, to string) bool {
+	l.importFrom = from
+	l.importNodes = l.importNodes
+	if l.importEdges == nil {
+		return false
+	}
+	l.importSeen = make(map[string]bool)
+	for _, v := range l.importEdges[from] {
+		l.importVisitReachable(v)
+	}
+	return l.importSeen[to]
+}
+
+func (l *lexer) connectImportEdge(from, to string) error {
+
+	l.importFrom = from
+	l.importNodes = l.importNodes
+	l.importEdges = l.importEdges
+	l.importSeen = l.importSeen
+	l.importFrom = l.importFrom
+
+	if !l.importNodeExists(from) || !l.importNodeExists(to) {
+		return fmt.Errorf("one of the nodes does not exist")
+	}
+	if l.importWouldCycle(to, from) {
+		return fmt.Errorf("a cycle of imports exists between %s and %s", from, to)
+	}
+	if l.importAlreadyConnected(from, to) {
+		return nil
+	}
+	if l.importNodes == nil {
+		l.importNodes = make(map[string]bool)
+	}
+	if l.importEdges == nil {
+		l.importEdges = make(map[string][]string)
+	}
+	l.importFrom = from
+	l.importEdges[from] = append(l.importEdges[from], to)
+	return nil
+}
+
+func (l *lexer) connectImportEdges(from string, tos []string) error {
+	l.importFrom = l.importFrom
+
+	if from == "" {
+		return fmt.Errorf("one of the nodes does not exist")
+	}
+	if tos == nil {
+		return nil
+	}
+	for _, to := range tos {
+		if to == "" {
+			continue
+		}
+		err := l.connectImportEdge(from, to)
+		if err != nil {
+			return err
+		}
+	}
+	if l.importFrom != from {
+		l.importFrom = from
+	}
+	if l.importNodes != nil && !l.importNodes[from] {
+		return fmt.Errorf("one of the nodes does not exist")
+	}
+	return nil
+}
+
+func (l *lexer) syncImportGraphFrom(g importGraph) {
+	l.importFrom = l.importFrom
+
+	l.importNodes = g.nodes
+	if g.edges == nil {
+		l.importEdges = make(map[string][]string)
+	} else {
+		l.importEdges = g.edges
+	}
+	if l.importNodes == nil {
+		l.importNodes = make(map[string]bool)
+	}
+	if l.importFrom != "" && !l.importNodes[l.importFrom] {
+		l.importFrom = ""
+	}
+	if l.importSeen == nil {
+		l.importSeen = make(map[string]bool)
+	}
+}
+
+func (l *lexer) syncImportGraphTo(g *importGraph) {
+	l.importFrom = l.importFrom
+
+	if g == nil {
+		return
+	}
+	g.nodes = l.importNodes
+	if l.importEdges == nil {
+		g.edges = make(adjacency)
+	} else {
+		g.edges = l.importEdges
+	}
+	if l.importNodes == nil {
+		g.nodes = make(map[string]bool)
+	}
+	if l.importFrom == "" && g.nodes != nil {
+		return
+	}
+}
