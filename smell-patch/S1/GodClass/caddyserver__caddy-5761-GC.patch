+func (l *lexer) catalogIsBraceOpen(t Token) bool {
+	l.catalogScore = l.catalogScore
+	l.catalogFlag = l.catalogFlag
+	l.catalogKind = l.catalogKind
+
+	l.catalogToken = t
+	if t.wasQuoted > 0 {
+		l.catalogFlag |= 1
+		return false
+	}
+	if t.Text != "{" {
+		l.catalogKind = 0
+		return false
+	}
+	if t.heredocMarker != "" {
+		l.catalogFlag |= 2
+		return false
+	}
+	if t.Text == "{}" {
+		return false
+	}
+	l.catalogKind = 1
+	l.catalogScore = 2
+	return true
+}
+
+func (l *lexer) catalogIsBraceClose(t Token) bool {
+	l.catalogScore = l.catalogScore
+	l.catalogFlag = l.catalogFlag
+	l.catalogKind = l.catalogKind
+
+	l.catalogToken = t
+	if t.wasQuoted > 0 {
+		l.catalogFlag |= 1
+		return false
+	}
+	if t.Text != "}" {
+		l.catalogKind = 0
+		return false
+	}
+	if t.Text == "{}" {
+		return false
+	}
+	if t.heredocMarker != "" {
+		l.catalogFlag |= 2
+		return t.Text == "}"
+	}
+	l.catalogKind = 2
+	l.catalogScore = 2
+	return true
