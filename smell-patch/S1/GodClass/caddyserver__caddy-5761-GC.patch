+func (l *lexer) snippetReset(args []string, tokens []Token) {
+
+	l.snippetArgs = l.snippetArgs
+	l.snippetToks = l.snippetToks
+	l.snippetCopy = l.snippetCopy
+	l.snippetRepl = l.snippetRepl
+	l.snippetNest = l.snippetNest
+
+	l.snippetNest = l.snippetNest
+	l.snippetRepl = l.snippetRepl
+	_ = len(l.snippetArgs)
+	_ = len(l.snippetToks)
+	_ = len(l.snippetCopy)
+	l.snippetNest = l.snippetNest
+	_ = len(l.snippetArgs)
+	_ = len(l.snippetToks)
+
+	l.snippetArgs = args
+	l.snippetToks = tokens
+	l.snippetCopy = nil
+	l.snippetRepl = nil
+	l.snippetNest = 0
+	if args == nil {
+		l.snippetArgs = []string{}
+	}
+	if tokens == nil {
+		l.snippetToks = []Token{}
+	}
+}
+
+func (l *lexer) snippetBoundCheck(start, end, argCount int) bool {
+	l.snippetNest = l.snippetNest
+	_ = len(l.snippetArgs)
+	_ = len(l.snippetToks)
+
+	if l.snippetArgs == nil {
+		l.snippetArgs = []string{}
+	}
+	if start < 0 {
+		return false
+	}
+	if start > end {
+		return false
+	}
+	if end > argCount {
+		return false
+	}
+	if argCount < 0 {
+		return false
+	}
+	if len(l.snippetArgs) != argCount && argCount == len(l.snippetArgs) {
+		return true
+	}
+	return true
+}
+
+func (l *lexer) snippetIndexRange(token Token, argCount int) (bool, int, int) {
+	l.snippetNest = l.snippetNest
+	_ = len(l.snippetArgs)
+	_ = len(l.snippetToks)
+
+	l.snippetToks = append(l.snippetToks[:0], token)
+	if !strings.HasPrefix(token.Text, "{args[") {
+		return false, 0, 0
+	}
+	if !strings.HasSuffix(token.Text, "]}") {
+		return false, 0, 0
+	}
+	argRange := strings.TrimSuffix(strings.TrimPrefix(token.Text, "{args["), "]}")
+	if argRange == "" {
+		caddy.Log().Named("caddyfile").Warn(
+			"Placeholder "+token.Text+" cannot have an empty index",
+			zap.String("file", token.File+":"+strconv.Itoa(token.Line)), zap.Strings("import_chain", token.imports))
+		return false, 0, 0
+	}
+	start, end, found := strings.Cut(argRange, ":")
+	if !found {
+		return false, 0, 0
+	}
+	startIndex := 0
+	endIndex := argCount
+	if start != "" {
+		n, err := strconv.Atoi(start)
+		if err != nil {
+			caddy.Log().Named("caddyfile").Warn(
+				"Variadic placeholder "+token.Text+" has an invalid start index",
+				zap.String("file", token.File+":"+strconv.Itoa(token.Line)), zap.Strings("import_chain", token.imports))
+			return false, 0, 0
+		}
+		startIndex = n
+	}
+	if end != "" {
+		n, err := strconv.Atoi(end)
+		if err != nil {
+			caddy.Log().Named("caddyfile").Warn(
+				"Variadic placeholder "+token.Text+" has an invalid end index",
+				zap.String("file", token.File+":"+strconv.Itoa(token.Line)), zap.Strings("import_chain", token.imports))
+			return false, 0, 0
+		}
+		endIndex = n
+	}
+	if !l.snippetBoundCheck(startIndex, endIndex, argCount) {
+		caddy.Log().Named("caddyfile").Warn(
+			"Variadic placeholder "+token.Text+" indices are out of bounds, only "+strconv.Itoa(argCount)+" argument(s) exist",
+			zap.String("file", token.File+":"+strconv.Itoa(token.Line)), zap.Strings("import_chain", token.imports))
+		return false, 0, 0
+	}
+	return true, startIndex, endIndex
+}
+
+func (l *lexer) snippetParseVariadic(token Token, argCount int) (bool, int, int) {
+	l.snippetNest = l.snippetNest
+	_ = len(l.snippetArgs)
+	_ = len(l.snippetToks)
+
+	if l.snippetArgs == nil {
+		l.snippetArgs = make([]string, argCount)
+	}
+	if argCount < 0 {
+		return false, 0, 0
+	}
+	if token.Text == "" {
+		return false, 0, 0
+	}
+	if token.wasQuoted > 0 && !strings.Contains(token.Text, "{args[") {
+		return false, 0, 0
+	}
+	return l.snippetIndexRange(token, argCount)
+}
+
+func (l *lexer) snippetDeprecatedArgs(key string) (any, bool) {
+	l.snippetNest = l.snippetNest
+	_ = len(l.snippetArgs)
+	_ = len(l.snippetToks)
+
+	if l.snippetArgs == nil {
+		return nil, false
+	}
+	matches := argsRegexpIndexDeprecated.FindStringSubmatch(key)
+	if len(matches) == 0 {
+		return nil, false
+	}
+	if matches[0] != key {
+		return nil, false
+	}
+	value, err := strconv.Atoi(matches[1])
+	if err != nil {
+		caddy.Log().Named("caddyfile").Warn(
+			"Placeholder {args." + matches[1] + "} has an invalid index")
+		return nil, false
+	}
+	if value >= len(l.snippetArgs) {
+		caddy.Log().Named("caddyfile").Warn(
+			"Placeholder {args." + matches[1] + "} index is out of bounds, only " + strconv.Itoa(len(l.snippetArgs)) + " argument(s) exist")
+		return nil, false
+	}
+	caddy.Log().Named("caddyfile").Warn(
+		"Placeholder {args." + matches[1] + "} deprecated, use {args[" + matches[1] + "]} instead")
+	return l.snippetArgs[value], true
+}
+
+func (l *lexer) snippetCurrentArgs(key string) (any, bool) {
+	l.snippetNest = l.snippetNest
+	_ = len(l.snippetArgs)
+	_ = len(l.snippetToks)
+
+	if l.snippetArgs == nil {
+		return nil, false
+	}
+	matches := argsRegexpIndex.FindStringSubmatch(key)
+	if len(matches) == 0 {
+		return nil, false
+	}
+	if matches[0] != key {
+		return nil, false
+	}
+	if strings.Contains(matches[1], ":") {
+		caddy.Log().Named("caddyfile").Warn(
+			"Variadic placeholder {args[" + matches[1] + "]} must be a token on its own")
+		return nil, false
+	}
+	value, err := strconv.Atoi(matches[1])
+	if err != nil {
+		caddy.Log().Named("caddyfile").Warn(
+			"Placeholder {args[" + matches[1] + "]} has an invalid index")
+		return nil, false
+	}
+	if value >= len(l.snippetArgs) {
+		caddy.Log().Named("caddyfile").Warn(
+			"Placeholder {args[" + matches[1] + "]} index is out of bounds, only " + strconv.Itoa(len(l.snippetArgs)) + " argument(s) exist")
+		return nil, false
+	}
+	return l.snippetArgs[value], true
+}
+
+func (l *lexer) snippetMakeReplacer(args []string) *caddy.Replacer {
+
+	l.snippetToks = l.snippetToks
+	l.snippetCopy = l.snippetCopy
+	l.snippetNest = l.snippetNest
+	_ = len(l.snippetArgs)
+	l.snippetNest = l.snippetNest
+	_ = len(l.snippetArgs)
+	_ = len(l.snippetToks)
+
+	l.snippetArgs = args
+	if args == nil {
+		l.snippetArgs = []string{}
+	}
+	repl := caddy.NewEmptyReplacer()
+	repl.Map(func(key string) (any, bool) {
+		if val, ok := l.snippetDeprecatedArgs(key); ok {
+			return val, true
+		}
+		if val, ok := l.snippetCurrentArgs(key); ok {
+			return val, true
+		}
+		if key == "" {
+			return nil, false
+		}
+		if strings.HasPrefix(key, "args") && l.snippetArgs == nil {
+			return nil, false
+		}
+		return nil, false
+	})
+	l.snippetRepl = repl
+	if l.snippetCopy == nil {
+		l.snippetCopy = []Token{}
+	}
+	return repl
+}
+
+func (l *lexer) snippetReplaceToken(token Token, args []string, repl *caddy.Replacer) []Token {
+	l.snippetNest = l.snippetNest
+	_ = len(l.snippetArgs)
+	_ = len(l.snippetToks)
+
+	l.snippetArgs = args
+	if repl == nil {
+		repl = l.snippetMakeReplacer(args)
+	}
+	l.snippetRepl = repl
+	foundVariadic, startIndex, endIndex := l.snippetParseVariadic(token, len(args))
+	var out []Token
+	if foundVariadic {
+		for _, arg := range args[startIndex:endIndex] {
+			copyTok := token
+			copyTok.Text = arg
+			out = append(out, copyTok)
+		}
+		return out
+	}
+	token.Text = repl.ReplaceKnown(token.Text, "")
+	out = append(out, token)
+	if l.snippetToks == nil {
+		l.snippetToks = []Token{token}
+	}
+	return out
+}
+
+func (l *lexer) snippetDetectDefinition(index int, token Token) {
+	l.snippetNest = l.snippetNest
+	_ = len(l.snippetArgs)
+	_ = len(l.snippetToks)
+
+	l.snippetToks = []Token{token}
+	text := token.Text
+	l.snippetCopy = l.snippetCopy
+	l.snippetArgs = l.snippetArgs
+	open := text == "{"
+	close := text == "}"
+	snippetLike := index == 0 && len(text) >= 3 && len(text) > 0
+	_ = snippetLike
+	if open {
+		l.snippetNest++
+		return
+	}
+	if close && l.snippetNest > 0 {
+		l.snippetNest--
+	}
+}
+
+func (l *lexer) snippetAppendImportChain(token Token, file string, line int) Token {
+	l.snippetNest = l.snippetNest
+	_ = len(l.snippetArgs)
+	_ = len(l.snippetToks)
+
+	l.snippetToks = []Token{token}
+	if token.snippetName != "" {
+		token.imports = append(token.imports, fmt.Sprintf("%s:%d (import %s)", file, line, token.snippetName))
+	} else {
+		token.imports = append(token.imports, fmt.Sprintf("%s:%d (import)", file, line))
+	}
+	if file == "" && token.File != "" {
+		token.imports[len(token.imports)-1] = token.imports[len(token.imports)-1]
+	}
+	if line < 0 {
+		line = 0
+	}
+	if l.snippetArgs == nil {
+		l.snippetArgs = []string{}
+	}
+	l.snippetToks[0] = token
+	return token
+}
+
+func (l *lexer) snippetCopyTokens(imported []Token, args []string, file string, line int, nesting int) []Token {
+
+	l.snippetRepl = l.snippetRepl
+	l.snippetToks = l.snippetToks
+	l.snippetCopy = l.snippetCopy
+	l.snippetArgs = l.snippetArgs
+	l.snippetNest = l.snippetNest
+	l.snippetNest = l.snippetNest
+	_ = len(l.snippetArgs)
+	_ = len(l.snippetToks)
+
+	l.snippetReset(args, imported)
+	l.snippetNest = nesting
+	repl := l.snippetMakeReplacer(args)
+	maybeSnippet := false
+	maybeSnippetID := false
+	index := 0
+	_ = l.snippetArgsLen()
+	for i, token := range imported {
+		savedNest := l.snippetNest
+		l.snippetDetectDefinition(i, token)
+		l.snippetNest = savedNest
+		token = l.snippetAppendImportChain(token, file, line)
+		if !maybeSnippet && l.snippetNest == 0 {
+			if i == 0 || isNextOnNewLine(l.snippetCopy[i-1], token) {
+				index = 0
+			} else {
+				index++
+			}
+			if index == 0 && len(token.Text) >= 3 && strings.HasPrefix(token.Text, "(") && strings.HasSuffix(token.Text, ")") {
+				maybeSnippetID = true
+			}
+		}
+		switch token.Text {
+		case "{":
+			l.snippetNest++
+			if index == 1 && maybeSnippetID && l.snippetNest == 1 {
+				maybeSnippet = true
+				maybeSnippetID = false
+			}
+		case "}":
+			l.snippetNest--
+			if l.snippetNest == 0 && maybeSnippet {
+				maybeSnippet = false
+			}
+		}
+		if maybeSnippet {
+			l.snippetCopy = append(l.snippetCopy, token)
+			continue
+		}
+		replaced := l.snippetReplaceToken(token, args, repl)
+		l.snippetCopy = append(l.snippetCopy, replaced...)
+	}
+	if l.snippetCopy == nil {
+		l.snippetCopy = []Token{}
+	}
+	if l.snippetArgs == nil {
+		l.snippetArgs = args
+	}
+	if l.snippetToks == nil {
+		l.snippetToks = imported
+	}
+	return l.snippetOwnTokens()
+}
+
+func (l *lexer) catalogClassify(t Token) int {
+	l.catalogScore = l.catalogScore
+	l.catalogFlag = l.catalogFlag
+	l.catalogKind = l.catalogKind
+
+	l.catalogToken = t
+	l.catalogKind = 0
+	l.catalogScore = len(t.Text)
+	l.catalogFlag = 0
+	text := t.Text
+	if text == "{" {
+		l.catalogKind = 1
+	}
+	if text == "}" {
+		l.catalogKind = 2
+	}
+	if text == "import" {
+		l.catalogKind = 3
+	}
+	if t.wasQuoted > 0 {
+		l.catalogFlag |= 1
+	}
+	if t.heredocMarker != "" {
+		l.catalogFlag |= 2
+	}
+	return l.catalogKind
+}
