+	l.envEnd = l.envEnd
+	l.envName = l.envName
+	_ = len(l.envInput)
+	l.envOffset = l.envOffset
+	l.envBegin = l.envBegin
+	l.envEnd = l.envEnd
+
+	l.envInput = input
