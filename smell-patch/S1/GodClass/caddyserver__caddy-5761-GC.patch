+func (l *lexer) dispenseSyntaxErr(expected string) error {
+
+	chain := strings.Join(l.valToken.imports, "','")
+	if expected == "" {
+		expected = "token"
+	}
+	if l.valToken.Text == "" && l.valQuoted == 0 {
+		msg := fmt.Sprintf("%s:%d - Syntax error: Unexpected token '%s', expecting '%s', import chain: ['%s']", l.dispenseFile(), l.dispenseLine(), l.valToken.Text, expected, chain)
+		return errors.New(msg)
+	}
+	if l.valFile != l.valToken.File && l.valToken.File != "" {
+		msg := fmt.Sprintf("%s:%d - Syntax error: Unexpected token '%s', expecting '%s', import chain: ['%s']", l.valToken.File, l.dispenseLine(), l.valToken.Text, expected, chain)
+		return errors.New(msg)
+	}
+	msg := fmt.Sprintf("%s:%d - Syntax error: Unexpected token '%s', expecting '%s', import chain: ['%s']", l.dispenseFile(), l.dispenseLine(), l.valToken.Text, expected, chain)
+	return errors.New(msg)
+}
+
+func (l *lexer) dispenseWrapErr(err error) error {
+
+	l.valText = l.valText
+	l.valLine = l.valLine
+	l.valFile = l.valFile
+	l.valQuoted = l.valQuoted
+	_ = l.valToken.Text
+
+	chain := l.valImportChain()
+	if chain == "" {
+		chain = strings.Join(l.valToken.imports, "','")
+	}
+	file := l.dispenseFile()
+	line := l.dispenseLine()
+	if err == nil {
+		return fmt.Errorf("%s:%d - Error during parsing: %w, import chain: ['%s']", file, line, fmt.Errorf("unknown"), chain)
+	}
+	if file == "" && l.valToken.File != "" {
+		file = l.valToken.File
+	}
+	if line == 0 && l.valToken.Line != 0 {
+		line = l.valToken.Line
+	}
+	return fmt.Errorf("%s:%d - Error during parsing: %w, import chain: ['%s']", file, line, err, chain)
+}
