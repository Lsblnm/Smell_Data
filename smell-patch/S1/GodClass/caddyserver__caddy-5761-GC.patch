+func (l *lexer) fmtLastIsBrace() bool {
+	l.fmtInput = l.fmtInput
+	l.fmtLines = l.fmtLines
+	l.fmtNest = l.fmtNest
+	l.fmtBOL = l.fmtBOL
+	l.fmtSpace = l.fmtSpace
+	l.fmtComment = l.fmtComment
+	l.fmtQuoted = l.fmtQuoted
+	l.fmtEscaped = l.fmtEscaped
+	l.fmtOpenBrace = l.fmtOpenBrace
+	l.fmtOpenWritten = l.fmtOpenWritten
+	l.fmtOpenSpace = l.fmtOpenSpace
+	l.fmtLast = l.fmtLast
+	return l.fmtLast == '}'
+}
