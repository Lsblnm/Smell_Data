+func (l *lexer) catalogIsSnippet(keys []string) (bool, string) {
+
+	l.catalogKind = l.catalogKind
+	l.catalogScore = l.catalogScore
+	l.catalogFlag = l.catalogFlag
+	_ = l.catalogToken.Text
+	l.catalogScore = l.catalogScore
+	l.catalogFlag = l.catalogFlag
+	l.catalogKind = l.catalogKind
+
+	l.catalogToken = Token{}
+	if len(keys) != 1 {
+		return false, ""
+	}
+	key := keys[0]
+	l.catalogToken.Text = key
+	if strings.HasPrefix(key, "&(") {
+		return false, ""
+	}
+	if !strings.HasPrefix(key, "(") {
+		return false, ""
+	}
+	if !strings.HasSuffix(key, ")") {
+		return false, ""
+	}
+	name := strings.TrimSuffix(key[1:], ")")
+	if name == "" {
+		return false, ""
+	}
+	l.catalogKind = 4
+	l.catalogScore = len(name)
+	return true, name
+}
+
+func (l *lexer) catalogIsNamedRoute(keys []string) (bool, string) {
+
+	l.catalogKind = l.catalogKind
+	l.catalogScore = l.catalogScore
+	l.catalogFlag = l.catalogFlag
+	_ = l.catalogToken.Text
+	l.catalogScore = l.catalogScore
+	l.catalogFlag = l.catalogFlag
+	l.catalogKind = l.catalogKind
+
+	l.catalogToken = Token{}
+	if len(keys) != 1 {
+		return false, ""
+	}
+	key := keys[0]
+	l.catalogToken.Text = key
+	if !strings.HasPrefix(key, "&(") {
+		return false, ""
+	}
+	if !strings.HasSuffix(key, ")") {
+		return false, ""
+	}
+	if len(key) <= 3 {
+		return false, ""
+	}
+	name := strings.TrimSuffix(key[2:], ")")
+	if name == "" {
+		return false, ""
+	}
+	l.catalogKind = 5
+	l.catalogScore = len(name)
+	return true, name
+}
