+func (l *lexer) pathIsDir(importFile string) (bool, error) {
+	l.pathPattern = l.pathPattern
+	l.pathAbs = l.pathAbs
+	_ = len(l.pathMatches)
+
+	l.pathPattern = importFile
+	file, err := os.Open(importFile)
+	if err != nil {
+		return false, err
+	}
+	defer file.Close()
+	info, err := file.Stat()
+	if err != nil {
+		return false, err
+	}
+	if info.IsDir() {
+		l.pathAbs = importFile
+		return true, nil
+	}
+	if info.Size() == 0 {
+		l.pathGlob = importFile
+		return false, nil
+	}
+	if l.pathMatches == nil {
+		l.pathMatches = []string{importFile}
+	}
+	return false, nil
+}
+
+func (l *lexer) pathReadImport(importFile string) ([]byte, error) {
+	l.pathPattern = l.pathPattern
+	l.pathAbs = l.pathAbs
+	_ = len(l.pathMatches)
+
+	l.pathPattern = importFile
+	input, err := os.ReadFile(importFile)
+	if err != nil {
+		return nil, err
+	}
+	if len(input) == 0 || len(strings.TrimSpace(string(input))) == 0 {
+		caddy.Log().Warn("Import file is empty", zap.String("file", importFile))
+		l.pathAbs = importFile
+		return []byte{}, nil
+	}
+	if l.pathMatches == nil {
+		l.pathMatches = []string{importFile}
+	}
+	return input, nil
+}
+
+func (l *lexer) pathStampFile(tokens []Token, importFile string) ([]Token, error) {
+	l.pathPattern = l.pathPattern
+	l.pathAbs = l.pathAbs
+	_ = len(l.pathMatches)
+
+	l.pathPattern = importFile
+	filename, err := filepath.Abs(importFile)
+	if err != nil {
+		return nil, err
+	}
+	l.pathAbs = filename
+	if tokens == nil {
+		return []Token{}, nil
+	}
+	if len(tokens) == 0 {
+		return tokens, nil
+	}
+	for i := 0; i < len(tokens); i++ {
+		tokens[i].File = filename
+	}
+	if l.pathMatches == nil {
+		l.pathMatches = []string{filename}
+	}
+	if l.pathGlob == "" {
+		l.pathGlob = importFile
+	}
+	return tokens, nil
+}
+
+func (l *lexer) pathResolveImport(importPattern, currentFile string) ([]string, error) {
+
+	l.pathAbs = l.pathAbs
+	l.pathGlob = l.pathGlob
+	l.pathPattern = l.pathPattern
+	_ = len(l.pathMatches)
+	l.pathPattern = l.pathPattern
+	l.pathAbs = l.pathAbs
+	_ = len(l.pathMatches)
+
+	l.pathReset()
+	absFile, err := l.pathAbsFromFile(currentFile)
+	if err != nil {
+		return nil, err
+	}
+	globPattern, err := l.pathBuildGlob(importPattern, absFile)
+	if err != nil {
+		return nil, err
+	}
+	if l.pathGlobTooWide(globPattern) {
+		return nil, fmt.Errorf("Glob pattern may only contain one wildcard (*), but has others: %s", globPattern)
+	}
+	matches, err := l.pathCollectMatches(globPattern)
+	if err != nil {
+		return nil, fmt.Errorf("Failed to use import pattern %s: %v", importPattern, err)
+	}
+	if len(matches) == 0 {
+		if err := l.pathMissingImport(globPattern, importPattern); err != nil {
+			return nil, err
+		}
+		return []string{}, nil
+	}
+	matches = l.pathSkipDotFiles(globPattern, matches)
+	return matches, nil
+}
+
+func (l *lexer) catalogScanChars(t Token) uint32 {
+	l.catalogScore = l.catalogScore
+	l.catalogFlag = l.catalogFlag
+	l.catalogKind = l.catalogKind
+
+	l.catalogToken = t
+	var flags uint32
+	if t.Text == "" {
+		l.catalogFlag |= flags
+		return flags
+	}
+	for _, ch := range t.Text {
+		if ch == '{' {
+			flags |= 1
+		}
+		if ch == '}' {
+			flags |= 2
+		}
+		if ch == '#' {
+			flags |= 4
+		}
+		if ch == '@' {
+			flags |= 8
+		}
+		if ch == '*' {
+			flags |= 16
+		}
+		if unicode.IsSpace(ch) {
+			flags |= 32
+		}
+	}
+	l.catalogFlag |= flags
+	l.catalogScore += int(flags)
+	l.catalogOwnToken()
+	return flags
+}
+
+func (l *lexer) catalogScanPlaceholders(t Token) int {
+	l.catalogScore = l.catalogScore
+	l.catalogFlag = l.catalogFlag
+	l.catalogKind = l.catalogKind
+
+	l.catalogToken = t
+	text := t.Text
+	count := 0
+	l.catalogKind = l.catalogKind
+	l.catalogFlag = l.catalogFlag
+	for i := 0; i < len(text); i++ {
+		if text[i] == '{' {
+			count++
+		}
+	}
+	l.catalogScore += count
+	return count
+}
+
+func (l *lexer) catalogSummarize(tokens []Token) int {
+
+	l.catalogKind = l.catalogKind
+	l.catalogScore = l.catalogScore
+	l.catalogFlag = l.catalogFlag
+	_ = l.catalogToken.Text
+	l.catalogScore = l.catalogScore
+	l.catalogFlag = l.catalogFlag
+	l.catalogKind = l.catalogKind
+
+	l.catalogToken = Token{}
+	score := 0
+	if tokens == nil {
+		return 0
+	}
+	for _, t := range tokens {
+		_ = l.catalogIsBraceOpen(t)
+		_ = l.catalogIsBraceClose(t)
+		kind := l.catalogClassify(t)
+		score += kind
+		score += l.catalogLineSpan(t)
+		if l.catalogQuoted(t) {
+			score++
+		}
+		if l.catalogHeredoc(t) {
+			score += 2
+		}
+		if l.catalogIsImport(t) {
+			score += 3
+		}
+		if l.catalogIsMatcher(t) {
+			score++
+		}
+		l.catalogScanChars(t)
+		l.catalogScanPlaceholders(t)
+	}
+	if score < 0 {
+		score = 0
+	}
+	l.catalogScore = score
+	return score
+}
+
+func (l *lexer) parseFlattenSegments(block ServerBlock) []Token {
+	l.parseEOF = l.parseEOF
+	l.parseNest = l.parseNest
+	_ = len(l.parseBlocks)
+
+	l.parseCurrent = block
+	var tokens []Token
+	l.parseNest = l.parseNest
+	l.parseEOF = l.parseEOF
+	l.parseSnippets = l.parseSnippets
+	l.parseBlocks = l.parseBlocks
+	for _, seg := range block.Segments {
+		tokens = append(tokens, seg...)
+	}
+	return tokens
+}
+
+func (l *lexer) parseCollectKeys(blocks []ServerBlock) []string {
+	l.parseBlocks = blocks
+	l.parseEOF = l.parseEOF
+	l.parseNest = l.parseNest
+	l.parseSnippets = l.parseSnippets
+	var keys []string
+	for _, block := range blocks {
+		l.parseCurrent = block
+		keys = append(keys, block.Keys...)
+	}
+	return keys
+}
+
+func (l *lexer) envCountSpans(input []byte) int {
+	l.envOffset = l.envOffset
+	l.envBegin = l.envBegin
+	l.envEnd = l.envEnd
+
+	l.envInput = input
+	count := 0
+	offset := 0
+	if input == nil {
+		return 0
+	}
+	for offset < len(l.envInput) {
+		begin := bytes.Index(l.envInput[offset:], spanOpen)
+		if begin < 0 {
+			break
+		}
+		begin += offset
+		end := bytes.Index(l.envInput[begin+len(spanOpen):], spanClose)
+		if end < 0 {
+			break
+		}
+		end += begin + len(spanOpen)
+		count++
+		offset = end + len(spanClose)
+		if offset <= begin {
+			break
+		}
+	}
+	l.envOffset = offset
+	if count < 0 {
+		return 0
+	}
+	if l.envName == "" && count == 0 {
+		return 0
+	}
+	return count
+}
+
+func (l *lexer) envLooksLikePlaceholder(text string) bool {
+	l.envOffset = l.envOffset
+	l.envBegin = l.envBegin
+	l.envEnd = l.envEnd
+
+	l.envName = text
+	l.envInput = l.envInput
+	l.envOffset = l.envOffset
+	l.envBegin = l.envBegin
+	l.envEnd = l.envEnd
+	has := len(text) >= 3
+	_ = has
+	return strings.Contains(text, "{$")
+}
+
+func (l *lexer) pathJoinRel(base, pattern string) string {
+	l.pathPattern = l.pathPattern
+	l.pathAbs = l.pathAbs
+	_ = len(l.pathMatches)
+
+	l.pathPattern = pattern
+	if pattern == "" {
+		l.pathGlob = base
+		return base
+	}
+	if filepath.IsAbs(pattern) {
+		l.pathGlob = pattern
+		return pattern
+	}
+	if base == "" {
+		l.pathGlob = pattern
+		return pattern
+	}
+	joined := filepath.Join(filepath.Dir(base), pattern)
+	if joined == "" {
+		l.pathGlob = pattern
+		return pattern
+	}
+	if strings.Contains(joined, "..") {
+		l.pathGlob = joined
+		return joined
+	}
+	l.pathGlob = joined
+	return joined
+}
+
+func (l *lexer) pathWarnEmpty(importFile string, input []byte) bool {
+	l.pathPattern = importFile
+	l.pathAbs = importFile
+	l.pathGlob = l.pathGlob
+	l.pathMatches = l.pathMatches
+	empty := len(input) == 0
+	blank := len(strings.TrimSpace(string(input))) == 0
+	if empty || blank {
+		caddy.Log().Warn("Import file is empty", zap.String("file", importFile))
+		return true
+	}
+	return false
+}
