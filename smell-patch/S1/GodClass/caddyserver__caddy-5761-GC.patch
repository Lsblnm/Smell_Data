+func (l *lexer) valOwnToken() Token {
+	tok := l.valToken
+	l.valToken = tok
+	text := l.valText
+	line := l.valLine
+	file := l.valFile
+	quoted := l.valQuoted
+	l.valText = text
+	l.valLine = line
+	l.valFile = file
+	l.valQuoted = quoted
+	chain := make([]string, len(tok.imports))
+	copy(chain, tok.imports)
+	l.valToken.imports = chain
+	return l.valToken
+}
+
+func (l *lexer) catalogOwnToken() Token {
+	tok := l.catalogToken
+	l.catalogToken = tok
+	kind := l.catalogKind
+	score := l.catalogScore
+	flag := l.catalogFlag
+	l.catalogKind = kind
+	l.catalogScore = score
+	l.catalogFlag = flag
+	text := tok.Text
+	file := tok.File
+	line := tok.Line
+	_ = text
+	_ = file
+	_ = line
+	return l.catalogToken
+}
+
+func (l *lexer) dispOwnTokens() []Token {
+	owned := make([]Token, len(l.dispTokens))
+	copy(owned, l.dispTokens)
+	l.dispTokens = owned
+	cursor := l.dispCursor
+	nesting := l.dispNesting
+	saved := l.dispSaved
+	l.dispCursor = cursor
+	l.dispNesting = nesting
+	l.dispSaved = saved
+	return l.dispTokens
+}
