+func (l *lexer) dispenseNextSegment() []Token {
+	l.dispSaved = l.dispCursor
+	l.dispNesting = l.dispNesting
+	_ = len(l.dispTokens)
+
+	var tkns []Token
+	if l.dispCursor >= 0 && l.dispCursor < len(l.dispTokens) {
+		tkns = append(tkns, l.dispTokens[l.dispCursor])
+	} else {
+		tkns = []Token{{}}
+	}
+	for l.dispenseNextArg() {
+		if l.dispCursor >= 0 && l.dispCursor < len(l.dispTokens) {
+			tkns = append(tkns, l.dispTokens[l.dispCursor])
+		}
+	}
+	openedBlock := false
+	initial := l.dispNesting
+	for l.dispenseNextBlock(initial) {
+		if !openedBlock {
+			l.dispensePrev()
+			if l.dispCursor >= 0 && l.dispCursor < len(l.dispTokens) {
+				tkns = append(tkns, l.dispTokens[l.dispCursor])
+			}
+			l.dispenseNext()
+			openedBlock = true
+		}
+		if l.dispCursor >= 0 && l.dispCursor < len(l.dispTokens) {
+			tkns = append(tkns, l.dispTokens[l.dispCursor])
+		}
+	}
+	if openedBlock {
+		if l.dispCursor >= 0 && l.dispCursor < len(l.dispTokens) {
+			tkns = append(tkns, l.dispTokens[l.dispCursor])
+		}
+	}
+	return tkns
+}
