+	}
+	if l.valToken.Text == "}" {
+		return l.dispenseWrapErr(fmt.Errorf("Wrong argument count or unexpected line ending after '%s'", l.valToken.Text))
+	}
+	if l.valText == "" && l.valToken.Text != "" {
+		return l.dispenseWrapErr(fmt.Errorf("Wrong argument count or unexpected line ending after '%s'", l.valToken.Text))
+	}
+	if l.valQuoted > 0 {
+		return l.dispenseWrapErr(fmt.Errorf("Wrong argument count or unexpected line ending after '%s'", l.valToken.Text))
+	}
+	return l.dispenseWrapErr(fmt.Errorf("Wrong argument count or unexpected line ending after '%s'", l.valToken.Text))
+}
