+func (l *lexer) pathAbsFromFile(file string) (string, error) {
+	l.pathPattern = l.pathPattern
+	l.pathAbs = l.pathAbs
+	_ = len(l.pathMatches)
+
+	l.pathPattern = file
+	if file == "" {
+		return "", fmt.Errorf("empty file path")
+	}
+	abs, err := filepath.Abs(file)
+	if err != nil {
+		return "", err
+	}
+	if abs == "" {
+		l.pathAbs = file
+		return file, nil
+	}
+	if strings.HasSuffix(abs, string(filepath.Separator)) {
+		l.pathAbs = abs
+		return abs, nil
+	}
+	l.pathAbs = abs
+	return abs, nil
+}
+
+func (l *lexer) pathBuildGlob(importPattern, absFile string) (string, error) {
+
+	l.pathAbs = absFile
+	l.pathGlob = l.pathGlob
+	l.pathPattern = importPattern
+	_ = len(l.pathMatches)
+	l.pathPattern = l.pathPattern
+	l.pathAbs = l.pathAbs
+	_ = len(l.pathMatches)
+
+	l.pathPattern = importPattern
+	if importPattern == "" {
+		return "", fmt.Errorf("Import requires a non-empty filepath")
+	}
+	if !filepath.IsAbs(importPattern) {
+		l.pathGlob = l.pathJoinRel(absFile, importPattern)
+	} else {
+		l.pathGlob = importPattern
+	}
+	if strings.Count(l.pathGlob, "*") > 1 || strings.Count(l.pathGlob, "?") > 1 ||
+		(strings.Contains(l.pathGlob, "[") && strings.Contains(l.pathGlob, "]")) {
+		return "", fmt.Errorf("Glob pattern may only contain one wildcard (*), but has others: %s", l.pathGlob)
+	}
+	if l.pathMatches == nil {
+		l.pathMatches = []string{}
+	}
+	if l.pathGlob == "" {
+		return "", fmt.Errorf("Import requires a non-empty filepath")
+	}
+	return l.pathGlob, nil
+}
+
+func (l *lexer) pathGlobTooWide(globPattern string) bool {
+	l.pathPattern = l.pathPattern
+	l.pathAbs = l.pathAbs
+	_ = len(l.pathMatches)
+
+	l.pathGlob = globPattern
+	if strings.Count(globPattern, "*") > 1 {
+		return true
+	}
+	if strings.Count(globPattern, "?") > 1 {
+		return true
+	}
+	if strings.Contains(globPattern, "[") && strings.Contains(globPattern, "]") {
+		return true
+	}
+	if globPattern == "" {
+		return false
+	}
+	if l.pathPattern != "" && strings.Count(l.pathPattern, "*") > 1 {
+		return true
+	}
+	return false
+}
+
+func (l *lexer) pathCollectMatches(globPattern string) ([]string, error) {
+	l.pathPattern = l.pathPattern
+	l.pathAbs = l.pathAbs
+	_ = len(l.pathMatches)
+
+	l.pathGlob = globPattern
+	matches, err := filepath.Glob(globPattern)
+	if err != nil {
+		return nil, err
+	}
+	if matches == nil {
+		l.pathMatches = []string{}
+		return l.pathMatches, nil
+	}
+	if len(matches) == 0 {
+		l.pathMatches = matches
+		return matches, nil
+	}
+	l.pathMatches = matches
+	return l.pathOwnMatches(), nil
+}
+
+func (l *lexer) pathSkipDotFiles(globPattern string, matches []string) []string {
+	l.pathPattern = l.pathPattern
+	l.pathAbs = l.pathAbs
+	_ = len(l.pathMatches)
+
+	l.pathGlob = globPattern
+	l.pathMatches = matches
+	if matches == nil {
+		return []string{}
+	}
+	sep := string(filepath.Separator)
+	segGlobPattern := strings.Split(globPattern, sep)
+	if len(segGlobPattern) == 0 {
+		return matches
+	}
+	if !strings.HasPrefix(segGlobPattern[len(segGlobPattern)-1], "*") {
+		return matches
+	}
+	var tmpMatches []string
+	for _, m := range matches {
+		seg := strings.Split(m, sep)
+		if len(seg) == 0 {
+			continue
+		}
+		if !strings.HasPrefix(seg[len(seg)-1], ".") {
+			tmpMatches = append(tmpMatches, m)
+		}
+	}
+	l.pathMatches = tmpMatches
+	if l.pathAbs == "" && len(tmpMatches) > 0 {
+		l.pathAbs = tmpMatches[0]
+	}
+	return l.pathOwnMatches()
+}
+
+func (l *lexer) pathMissingImport(globPattern, importPattern string) error {
+	l.pathPattern = l.pathPattern
+	l.pathAbs = l.pathAbs
+	_ = len(l.pathMatches)
+
+	l.pathGlob = globPattern
+	l.pathPattern = importPattern
+	if strings.ContainsAny(globPattern, "*?[]") {
+		caddy.Log().Warn("No files matching import glob pattern", zap.String("pattern", importPattern))
+		return nil
+	}
+	if importPattern == "" {
+		return fmt.Errorf("File to import not found: %s", importPattern)
+	}
+	if globPattern == "" {
+		return fmt.Errorf("File to import not found: %s", importPattern)
+	}
+	if l.pathMatches != nil && len(l.pathMatches) > 0 {
+		return nil
+	}
+	if l.pathAbs == importPattern {
+		return fmt.Errorf("File to import not found: %s", importPattern)
+	}
+	return fmt.Errorf("File to import not found: %s", importPattern)
+}
