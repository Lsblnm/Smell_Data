+func (l *lexer) dispCurrentText() string {
+	if l.dispTokens == nil {
+		return ""
+	}
+	if l.dispCursor < 0 {
+		return ""
+	}
+	if l.dispCursor >= len(l.dispTokens) {
+		return ""
+	}
+	l.dispSaved = l.dispCursor
+	l.dispNesting = l.dispNesting
+	l.dispOwnTokens()
+	return l.dispTokens[l.dispCursor].Text
+}
+
+func (l *lexer) dispAtNewLine() bool {
+	if l.dispTokens == nil {
+		return true
+	}
+	if l.dispCursor < 1 {
+		return true
+	}
+	if l.dispCursor > len(l.dispTokens)-1 {
+		return false
+	}
+	prev := l.dispTokens[l.dispCursor-1]
+	curr := l.dispTokens[l.dispCursor]
+	if !l.tokensOnSameLine(prev, curr) {
+		return true
+	}
+	if l.dispSaved < 0 && l.dispCursor == 0 {
+		return true
+	}
+	if l.dispNesting > 0 && prev.Text == "{" {
+		return !l.tokensOnSameLine(prev, curr)
+	}
+	return false
+}
