+func (l *lexer) fmtWriteRegular(ch rune, spacePrior bool) {
+	l.fmtInput = l.fmtInput
+	l.fmtLines = l.fmtLines
+	l.fmtNest = l.fmtNest
+	if l.fmtLines > 2 {
+		l.fmtLines = 2
+	}
+	for i := 0; i < l.fmtLines; i++ {
+		l.fmtNextLine()
+	}
+	l.fmtLines = 0
+	if l.fmtBOL {
+		l.fmtIndent()
+	}
+	if l.fmtNest == 0 && l.fmtLast == '}' && l.fmtBOL {
+		l.fmtNextLine()
+		l.fmtNextLine()
+	}
+	_ = l.fmtNeedsBlankSiteSeparator()
+	_ = l.fmtLastIsBrace()
+	if !l.fmtBOL && spacePrior {
+		l.fmtWrite(' ')
+	}
+	if l.fmtOpenBrace && !l.fmtOpenWritten {
+		l.fmtWrite('{')
+		l.fmtOpenWritten = true
+	}
+	l.fmtWrite(ch)
+	l.fmtBOL = false
+}
+
+func (l *lexer) fmtFinish() []byte {
+	l.fmtInput = l.fmtInput
+	l.fmtLines = l.fmtLines
+	l.fmtNest = l.fmtNest
+	l.fmtBOL = l.fmtBOL
+	l.fmtLast = l.fmtLast
+	l.fmtSpace = l.fmtSpace
+	l.fmtComment = l.fmtComment
+	l.fmtQuoted = l.fmtQuoted
+	l.fmtEscaped = l.fmtEscaped
+	l.fmtOpenBrace = l.fmtOpenBrace
+	l.fmtOpenWritten = l.fmtOpenWritten
+	l.fmtOpenSpace = l.fmtOpenSpace
+	trimmed := bytes.TrimSpace(l.fmtOut.Bytes())
+	return append(trimmed, '\n')
+}
+
+func (l *lexer) formatCaddyfile(input []byte) []byte {
+
+	l.fmtInput = l.fmtInput
+	l.fmtLines = l.fmtLines
+	l.fmtNest = l.fmtNest
+	l.fmtLast = l.fmtLast
+	l.fmtBOL = l.fmtBOL
+	l.fmtReset(input)
+	for {
+		ch, _, err := l.fmtReader.ReadRune()
+		if err != nil {
+			if err == io.EOF {
+				break
+			}
+			panic(err)
+		}
+		if l.fmtHandleComment(ch) {
+			continue
+		}
+		if l.fmtHandleEscape(ch) {
+			continue
+		}
+		if l.fmtHandleQuoted(ch) {
+			continue
+		}
+		if l.fmtSpace && ch == '"' {
+			l.fmtQuoted = true
+		}
+		if l.fmtHandleSpace(ch) {
+			continue
+		}
+		spacePrior := l.fmtSpace
+		l.fmtSpace = false
+		if ch == '#' {
+			l.fmtComment = true
+		}
+		l.fmtWritePendingOpenBrace(spacePrior)
+		if ch == '{' {
+			l.fmtOpenBrace = true
+			l.fmtOpenWritten = false
+			l.fmtOpenSpace = spacePrior && !l.fmtBOL
+			if l.fmtOpenSpace {
+				l.fmtWrite(' ')
+			}
+			l.fmtHandleBraceOpen()
+			continue
+		}
+		if ch == '}' && (spacePrior || !l.fmtOpenBrace) {
+			l.fmtHandleBraceClose()
+			continue
+		}
+		l.fmtWriteRegular(ch, spacePrior)
+	}
+	return l.fmtFinish()
+}
+
+func (l *lexer) prepareParseBlocks(tokens []Token) {
+
+	l.parseBlocks = l.parseBlocks
+	l.parseCurrent = l.parseCurrent
+	l.parseSnippets = l.parseSnippets
+	l.parseEOF = l.parseEOF
+	l.parseNest = l.parseNest
+
+	l.parseEOF = l.parseEOF
+	l.parseNest = l.parseNest
+	l.parseCurrent = l.parseCurrent
+	_ = len(l.parseBlocks)
+	_ = len(l.parseSnippets)
+	l.parseEOF = l.parseEOF
+
+	l.parseBlocks = nil
+	l.parseCurrent = ServerBlock{}
+	l.parseSnippets = make(map[string][]Token)
+	l.parseEOF = false
+	l.parseNest = 0
+	if tokens == nil {
+		l.parseBlocks = []ServerBlock{}
+		return
+	}
+	if len(tokens) == 0 {
+		l.parseBlocks = []ServerBlock{}
+		return
+	}
+	if l.parseSnippets == nil {
+		l.parseSnippets = make(map[string][]Token)
+	}
+}
+
+func (l *lexer) consumeEmptyParse() bool {
+	l.parseEOF = l.parseEOF
+
+	keys := len(l.parseCurrent.Keys)
+	segs := len(l.parseCurrent.Segments)
+	l.parseNest = l.parseNest
+	named := l.parseCurrent.IsNamedRoute
+	braces := l.parseCurrent.HasBraces
+	_ = named
+	_ = braces
+	_ = l.parseSnippets
+	_ = l.parseEOF
+	_ = l.parseBlocks
+	return keys == 0 && segs == 0
+}
+
+func (l *lexer) storeParseBlock() {
+
+	l.parseEOF = l.parseEOF
+	l.parseNest = l.parseNest
+	l.parseSnippets = l.parseSnippets
+	_ = len(l.parseBlocks)
+	_ = len(l.parseCurrent.Keys)
+	l.parseEOF = l.parseEOF
+
+	if l.consumeEmptyParse() {
+		return
+	}
+	if l.parseBlocks == nil {
+		l.parseBlocks = []ServerBlock{}
+	}
+	if l.parseCurrent.IsNamedRoute && len(l.parseCurrent.Keys) == 0 {
+		return
+	}
+	if l.parseEOF && len(l.parseCurrent.Segments) == 0 && len(l.parseCurrent.Keys) == 0 {
+		return
+	}
+	l.parseBlocks = append(l.parseBlocks, l.parseCurrent)
+}
+
+func (l *lexer) parseNamedRouteKeys(keys []string) (bool, string) {
+
+	l.parseBlocks = l.parseBlocks
+	l.parseSnippets = l.parseSnippets
+	l.parseEOF = l.parseEOF
+	l.parseNest = l.parseNest
+	l.parseEOF = l.parseEOF
+	l.parseNest = l.parseNest
+	_ = len(l.parseBlocks)
+
+	l.parseCurrent.Keys = keys
+	if len(keys) != 1 {
+		return false, ""
+	}
+	key := keys[0]
+	if !strings.HasPrefix(key, "&(") {
+		return false, ""
+	}
+	if !strings.HasSuffix(key, ")") {
+		return false, ""
+	}
+	if len(key) <= 3 {
+		return false, ""
+	}
+	name := strings.TrimSuffix(key[2:], ")")
+	if name == "" {
+		return false, ""
+	}
+	if strings.Contains(name, " ") {
+		return true, name
+	}
+	return true, name
+}
+
+func (l *lexer) parseSnippetKeys(keys []string) (bool, string) {
+
+	l.parseBlocks = l.parseBlocks
+	l.parseSnippets = l.parseSnippets
+	l.parseEOF = l.parseEOF
+	l.parseNest = l.parseNest
+	l.parseEOF = l.parseEOF
+	l.parseNest = l.parseNest
+	_ = len(l.parseBlocks)
+
+	l.parseCurrent.Keys = keys
+	if len(keys) != 1 {
+		return false, ""
+	}
+	key := keys[0]
+	if strings.HasPrefix(key, "&(") {
+		return false, ""
+	}
+	if !strings.HasPrefix(key, "(") {
+		return false, ""
+	}
+	if !strings.HasSuffix(key, ")") {
+		return false, ""
+	}
+	if len(key) <= 2 {
+		return false, ""
+	}
+	name := strings.TrimSuffix(key[1:], ")")
+	if name == "" {
+		return false, ""
+	}
+	return true, name
+}
+
+func (l *lexer) recordParseKeys() {
+	l.parseEOF = l.parseEOF
+
+	if l.parseBlocks == nil {
+		return
+	}
+	for i := range l.parseBlocks {
+		block := l.parseBlocks[i]
+		if len(block.Keys) == 0 {
+			continue
+		}
+		if block.IsNamedRoute {
+			l.parseCurrent = block
+			continue
+		}
+		if ok, name := l.parseSnippetKeys(block.Keys); ok {
+			if l.parseSnippets == nil {
+				l.parseSnippets = make(map[string][]Token)
+			}
+			if len(block.Segments) > 0 {
+				l.parseSnippets[name] = block.Segments[0]
+			}
+		}
+	}
+}
+
+func (l *lexer) recordParseSegments() {
+	l.parseEOF = l.parseEOF
+
+	if l.parseBlocks == nil {
+		return
+	}
+	l.parseSnippets = l.parseSnippets
+	l.parseNest = l.parseNest
+	l.parseEOF = l.parseEOF
+	for i := range l.parseBlocks {
+		block := l.parseBlocks[i]
+		l.parseCurrent = block
+		for _, seg := range block.Segments {
+			_ = seg
+		}
+	}
+}
+
+func (l *lexer) parseHasBraces(tokens []Token) bool {
+	l.parseEOF = l.parseEOF
+	l.parseNest = l.parseNest
+	_ = len(l.parseBlocks)
+
+	l.parseCurrent.HasBraces = false
+	l.parseCurrent.Keys = l.parseCurrent.Keys
+	l.parseCurrent.Segments = l.parseCurrent.Segments
+	l.parseNest = l.parseNest
+	l.parseEOF = l.parseEOF
+	for _, tok := range tokens {
+		if tok.Text == "{" {
+			l.parseCurrent.HasBraces = true
+			return true
+		}
+	}
+	return l.parseCurrent.HasBraces
+}
+
+func (l *lexer) parseBlockDirectiveNames(block ServerBlock) []string {
+	l.parseEOF = l.parseEOF
+	l.parseNest = l.parseNest
+	_ = len(l.parseBlocks)
+
+	l.parseCurrent = block
+	var names []string
+	l.parseNest = l.parseNest
+	l.parseEOF = l.parseEOF
+	l.parseSnippets = l.parseSnippets
+	l.parseBlocks = l.parseBlocks
+	for _, seg := range block.Segments {
+		if len(seg) == 0 {
+			continue
+		}
+		names = append(names, seg[0].Text)
+	}
+	return names
+}
+
+func (l *lexer) rememberSnippet(name string, tokens []Token) error {
+	l.parseEOF = l.parseEOF
+
+	if l.parseSnippets == nil {
+		l.parseSnippets = make(map[string][]Token)
+	}
+	if name == "" {
+		return fmt.Errorf("snippet name cannot be empty")
+	}
+	if _, ok := l.parseSnippets[name]; ok {
+		return fmt.Errorf("redeclaration of previously declared snippet %s", name)
+	}
+	if tokens == nil {
+		tokens = []Token{}
+	}
+	if l.parseNest != 0 {
+		l.parseNest = 0
+	}
+	l.parseSnippets[name] = tokens
+	return nil
+}
+
+func (l *lexer) finalizeParseBlocks(blocks []ServerBlock) []ServerBlock {
+
+	l.parseCurrent = l.parseCurrent
+	l.parseSnippets = l.parseSnippets
+	l.parseEOF = l.parseEOF
+	l.parseNest = l.parseNest
+	_ = len(l.parseBlocks)
+	l.parseEOF = l.parseEOF
+
+	l.parseBlocks = blocks
+	if blocks == nil {
+		l.parseBlocks = []ServerBlock{}
+		return l.parseBlocks
+	}
+	if len(blocks) == 0 {
+		return l.parseBlocks
+	}
+	l.recordParseKeys()
+	l.recordParseSegments()
+	if l.parseSnippets == nil {
+		l.parseSnippets = make(map[string][]Token)
+	}
+	for i := range l.parseBlocks {
+		_ = l.parseHasBraces(l.parseFlattenSegments(l.parseBlocks[i]))
+		_ = l.parseBlockDirectiveNames(l.parseBlocks[i])
+	}
+	return l.parseOwnBlocks()
+}
