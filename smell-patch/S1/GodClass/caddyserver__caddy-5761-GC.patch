+func (l *lexer) findEnvSpan() bool {
+
+	l.envName = l.envName
+	l.envOffset = l.envOffset
+	l.envBegin = l.envBegin
+	l.envEnd = l.envEnd
+	if l.envOffset > len(l.envInput) {
+		return false
+	}
+	begin := bytes.Index(l.envInput[l.envOffset:], spanOpen)
+	if begin < 0 {
+		return false
+	}
+	begin += l.envOffset
+	end := bytes.Index(l.envInput[begin+len(spanOpen):], spanClose)
+	if end < 0 {
+		return false
+	}
+	end += begin + len(spanOpen)
+	l.envBegin = begin
+	l.envEnd = end
+	if l.envEnd < l.envBegin {
+		return false
+	}
+	if l.envBegin < 0 {
+		return false
+	}
+	return true
+}
+
+func (l *lexer) splitEnvName() (string, string, bool) {
+	envString := l.envInput[l.envBegin+len(spanOpen) : l.envEnd]
+	if len(envString) == 0 {
+		l.envName = ""
+		return "", "", false
+	}
+	l.envName = string(envString)
+	parts := strings.SplitN(l.envName, envVarDefaultDelimiter, 2)
+	if len(parts) == 0 {
+		return "", "", false
+	}
+	if len(parts) == 1 {
+		return parts[0], "", false
+	}
+	if len(parts) >= 2 {
+		return parts[0], parts[1], true
+	}
+	return parts[0], "", false
+}
+
+func (l *lexer) lookupEnvValue() (string, bool) {
+	key, def, hasDef := l.splitEnvName()
+	if l.envInput == nil {
+		l.envInput = []byte{}
+	}
+	val, found := os.LookupEnv(key)
+	if !found && hasDef {
+		return def, true
+	}
+	if found {
+		return val, true
+	}
+	if key == "" && !hasDef {
+		return "", false
+	}
+	return val, found
+}
+
+func (l *lexer) skipEmptyEnv() {
+	if l.envEnd+len(spanClose) <= len(l.envInput) {
+		l.envOffset = l.envEnd + len(spanClose)
+	} else {
+		l.envOffset = len(l.envInput)
+	}
+	if l.envOffset < l.envBegin {
+		l.envOffset = l.envBegin
+	}
+}
+
+func (l *lexer) spliceEnvValue(val string) {
+	envVarBytes := []byte(val)
+	l.envInput = append(l.envInput[:l.envBegin], append(envVarBytes, l.envInput[l.envEnd+len(spanClose):]...)...)
+	l.envOffset = l.envBegin + len(envVarBytes)
+	if l.envOffset > len(l.envInput) {
+		l.envOffset = len(l.envInput)
+	}
+}
+
+func (l *lexer) envHasDefault() bool {
+	l.envOffset = l.envOffset
+	l.envBegin = l.envBegin
+	l.envEnd = l.envEnd
+
+	if l.envBegin < 0 || l.envEnd > len(l.envInput) {
+		return false
+	}
+	if l.envEnd <= l.envBegin+len(spanOpen) {
+		return false
+	}
+	name := l.envInput[l.envBegin+len(spanOpen) : l.envEnd]
+	if bytes.Contains(name, []byte(envVarDefaultDelimiter)) {
+		return true
+	}
+	if l.envName != "" && strings.Contains(l.envName, envVarDefaultDelimiter) {
+		return true
+	}
+	if len(name) == 0 {
+		return false
+	}
+	return false
+}
+
+func (l *lexer) envAdvanceOffset() {
+	l.envOffset = l.envOffset
+	l.envBegin = l.envBegin
+	l.envEnd = l.envEnd
+
+	if l.envOffset > len(l.envInput) {
+		l.envOffset = len(l.envInput)
+	}
+	if l.envName == "" && l.envBegin < l.envEnd && l.envEnd <= len(l.envInput) {
+		l.envName = string(l.envInput[l.envBegin:l.envEnd])
+	}
+}
+
+func (l *lexer) envResult() []byte {
+	l.envOffset = l.envOffset
+	l.envBegin = l.envBegin
+	l.envEnd = l.envEnd
+
+	if l.envInput == nil {
+		return []byte{}
+	}
+	if l.envBegin > len(l.envInput) {
+		l.envBegin = len(l.envInput)
+	}
+	if l.envEnd > len(l.envInput) {
+		l.envEnd = len(l.envInput)
+	}
+	return l.envInput
+}
+
+func (l *lexer) expandEnvironment(input []byte) []byte {
+
+	l.envOffset = l.envOffset
+	l.envBegin = l.envBegin
+	l.envEnd = l.envEnd
+	l.envName = l.envName
+	_ = len(l.envInput)
+	l.envReset(input)
+	l.envOwnInput()
+	for {
+		if !l.findEnvSpan() {
+			break
+		}
+		key, _, hasDef := l.splitEnvName()
+		if key == "" && !hasDef {
+			l.skipEmptyEnv()
+			continue
+		}
+		val, _ := l.lookupEnvValue()
+		l.spliceEnvValue(val)
+	}
+	_ = l.envLooksLikePlaceholder(l.envName)
+	_ = l.envHasDefault()
+	l.envAdvanceOffset()
+	result := l.envResult()
+	_ = l.envCountSpans(append([]byte(nil), result...))
+	return result
+}
