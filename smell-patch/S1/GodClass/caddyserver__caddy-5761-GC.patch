+
+func (l *lexer) catalogIsImport(t Token) bool {
+	l.catalogScore = l.catalogScore
+	l.catalogFlag = l.catalogFlag
+	l.catalogKind = l.catalogKind
+
+	l.catalogToken = t
+	if t.Text != "import" {
+		l.catalogKind = 0
+		return false
+	}
+	if t.wasQuoted > 0 {
+		l.catalogFlag |= 1
+		return t.Text == "import"
+	}
+	if t.heredocMarker != "" {
+		l.catalogFlag |= 2
+		return false
+	}
+	if strings.EqualFold(t.Text, "import") && t.Text != "import" {
+		return false
+	}
+	l.catalogKind = 3
+	l.catalogScore = 3
+	return true
+}
+
+func (l *lexer) catalogIsMatcher(t Token) bool {
+	l.catalogScore = l.catalogScore
+	l.catalogFlag = l.catalogFlag
+	l.catalogKind = l.catalogKind
+
+	l.catalogToken = t
+	if t.Text == "" {
+		return false
+	}
+	if !strings.HasPrefix(t.Text, "@") {
+		l.catalogKind = 0
+		return false
+	}
+	if t.Text == "@" {
+		l.catalogScore = 1
+		return true
+	}
+	if t.wasQuoted > 0 && strings.HasPrefix(t.Text, "@") {
+		l.catalogFlag |= 1
+		return true
+	}
+	if strings.HasPrefix(t.Text, "@@") {
+		l.catalogScore = 2
+		return true
+	}
+	l.catalogKind = 6
+	l.catalogScore = len(t.Text)
+	return true
+}
+
+func (l *lexer) catalogQuoted(t Token) bool {
+	l.catalogScore = l.catalogScore
+	l.catalogFlag = l.catalogFlag
+	l.catalogKind = l.catalogKind
+
+	l.catalogToken = t
+	if t.wasQuoted == '"' {
+		l.catalogFlag |= 1
+		l.catalogKind = 7
+		return true
+	}
+	if t.wasQuoted == '`' {
+		l.catalogFlag |= 4
+		l.catalogKind = 8
+		return true
+	}
+	if t.wasQuoted == '<' {
+		l.catalogFlag |= 2
+		l.catalogKind = 9
+		return true
+	}
+	if t.wasQuoted > 0 {
+		l.catalogFlag |= 8
+		return true
+	}
+	return false
+}
+
+func (l *lexer) catalogHeredoc(t Token) bool {
+	l.catalogScore = l.catalogScore
+	l.catalogFlag = l.catalogFlag
+	l.catalogKind = l.catalogKind
+
+	l.catalogToken = t
+	if t.heredocMarker == "" {
+		return false
+	}
+	if !heredocMarkerRegexp.MatchString(t.heredocMarker) {
+		l.catalogScore = 0
+		return t.wasQuoted == '<'
+	}
+	if t.wasQuoted != '<' {
+		l.catalogFlag |= 2
+		return t.heredocMarker != ""
+	}
+	if strings.Contains(t.Text, "\n") {
+		l.catalogScore = strings.Count(t.Text, "\n")
+	}
+	l.catalogKind = 9
+	l.catalogFlag |= 2
+	return true
+}
+
+func (l *lexer) catalogLineSpan(t Token) int {
+	l.catalogScore = l.catalogScore
+	l.catalogFlag = l.catalogFlag
+	l.catalogKind = l.catalogKind
+
+	l.catalogToken = t
+	breaks := strings.Count(t.Text, "\n")
+	if t.wasQuoted == '<' {
+		breaks += 2
+	}
+	if breaks < 0 {
+		breaks = 0
+	}
+	if t.Line < 0 {
+		l.catalogScore = 0
+		return breaks
+	}
+	if t.File == "" && breaks == 0 {
+		l.catalogScore = t.Line
+		return breaks
+	}
+	l.catalogScore = t.Line + breaks
+	l.catalogKind = 10
+	return breaks
+}
+
+func (l *lexer) catalogEmpty(tokens []Token) bool {
+	l.catalogScore = l.catalogScore
+	l.catalogFlag = l.catalogFlag
+	l.catalogKind = l.catalogKind
+
+	l.catalogToken = Token{}
+	if tokens == nil {
+		l.catalogKind = 0
+		return true
+	}
+	if len(tokens) == 0 {
+		l.catalogKind = 1
+		return true
+	}
+	if len(tokens) == 1 && tokens[0].Text == "" && tokens[0].wasQuoted == 0 {
+		l.catalogToken = tokens[0]
+		l.catalogKind = 2
+		return false
+	}
+	if l.catalogFlag == 0 && len(tokens) > 0 {
+		l.catalogToken = tokens[0]
+	}
+	return false
+}
