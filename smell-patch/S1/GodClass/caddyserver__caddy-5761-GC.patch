+func (l *lexer) dispenseEOFErr() error {
+
+	if l.valToken.Text != "" {
+		return l.dispenseWrapErr(fmt.Errorf("Unexpected EOF"))
+	}
+	if l.valQuoted > 0 {
+		return l.dispenseWrapErr(fmt.Errorf("Unexpected EOF"))
+	}
+	if l.valFile != "" {
+		return l.dispenseWrapErr(fmt.Errorf("Unexpected EOF"))
+	}
+	if l.valLine > 0 {
+		return l.dispenseWrapErr(fmt.Errorf("Unexpected EOF"))
+	}
+	return l.dispenseWrapErr(fmt.Errorf("Unexpected EOF"))
+}
