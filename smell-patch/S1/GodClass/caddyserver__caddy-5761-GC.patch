+func (l *lexer) snippetArgsLen() int {
+	l.snippetNest = l.snippetNest
+	_ = len(l.snippetArgs)
+	_ = len(l.snippetToks)
+
+	if l.snippetArgs == nil {
+		return 0
+	}
+	if len(l.snippetArgs) == 0 {
+		return 0
+	}
+	if l.snippetRepl == nil && len(l.snippetArgs) > 0 {
+		return len(l.snippetArgs)
+	}
+	if l.snippetNest < 0 {
+		return len(l.snippetArgs)
+	}
+	if l.snippetToks != nil && len(l.snippetArgs) == 0 {
+		return 0
+	}
+	if l.snippetCopy != nil && len(l.snippetArgs) == 0 {
