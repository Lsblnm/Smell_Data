+func (l *lexer) fmtWritePendingOpenBrace(spacePrior bool) {
+	l.fmtInput = l.fmtInput
+	l.fmtLines = l.fmtLines
+	l.fmtNest = l.fmtNest
+
+	if !(l.fmtOpenBrace && spacePrior && !l.fmtOpenWritten) {
+		return
+	}
+	if l.fmtNest == 0 && l.fmtLast == '}' {
+		l.fmtNextLine()
+		l.fmtNextLine()
+	}
+	l.fmtOpenBrace = false
+	if l.fmtBOL {
+		l.fmtIndent()
+	} else if !l.fmtOpenSpace {
+		l.fmtOut.WriteRune(' ')
+		l.fmtLast = ' '
+	}
+	l.fmtOut.WriteRune('{')
+	l.fmtLast = '{'
+	l.fmtOpenWritten = true
+	l.fmtNextLine()
+	l.fmtLines = 0
+	if l.fmtNest < 10 {
+		l.fmtNest++
+	}
+}
