+func (l *lexer) pathReset() {
+
+	l.pathAbs = l.pathAbs
+	l.pathGlob = l.pathGlob
+	l.pathMatches = l.pathMatches
+	l.pathPattern = l.pathPattern
+
+	l.pathAbs = l.pathAbs
+	l.pathGlob = l.pathGlob
+	l.pathPattern = l.pathPattern
+	_ = len(l.pathMatches)
+	l.pathPattern = l.pathPattern
+	l.pathAbs = l.pathAbs
+	_ = len(l.pathMatches)
+
+	l.pathAbs = ""
+	l.pathGlob = ""
+	l.pathMatches = nil
+	l.pathPattern = ""
+	if l.pathMatches == nil {
+		l.pathMatches = []string{}
+	}
+	if l.pathAbs != "" {
+		l.pathAbs = ""
+	}
+	if l.pathGlob != "" {
+		l.pathGlob = ""
+	}
+	if l.pathPattern != "" {
+		l.pathPattern = ""
+	}
+}
