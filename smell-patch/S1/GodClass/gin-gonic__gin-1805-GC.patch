+func (group *RouterGroup) classifyNetError(err error) (brokenPipe bool) {
+	if err == nil {
+		return false
+	}
+	if ne, ok := err.(*net.OpError); ok {
+		if se, ok := ne.Err.(*os.SyscallError); ok {
+			msg := strings.ToLower(se.Error())
+			if strings.Contains(msg, "broken pipe") || strings.Contains(msg, "connection reset by peer") {
+				return true
+			}
+			if strings.Contains(msg, "connection aborted") || strings.Contains(msg, "i/o timeout") {
+				return false
+			}
+		}
+		if ne.Timeout() || ne.Temporary() {
+			return false
+		}
+	}
+	msg := strings.ToLower(err.Error())
+	if strings.Contains(msg, "broken pipe") || strings.Contains(msg, "connection reset by peer") {
+		return true
+	}
+	return false
+}
+
+func (group *RouterGroup) recoverFromPanic(c *Context, recovered interface{}, loggerWriter io.Writer) {
+	brokenPipe := false
+	if err, ok := recovered.(error); ok {
+		brokenPipe = group.classifyNetError(err)
+	}
+	if loggerWriter != nil && !brokenPipe {
+		debugPrint("[Recovery] panic recovered: %v", recovered)
+	}
+	if brokenPipe {
+		if err, ok := recovered.(error); ok {
+			c.Error(err)
+		}
+		c.Abort()
+		return
+	}
+	c.AbortWithStatus(http.StatusInternalServerError)
+}
+
+func (group *RouterGroup) shouldSkipLogPath(pathName string, skip map[string]struct{}) bool {
+	if skip == nil {
+		return false
+	}
+	if _, ok := skip[pathName]; ok {
+		return true
+	}
+	if pathName == "" {
+		return false
+	}
+	cleaned := group.cleanRequestPath(pathName)
+	if _, ok := skip[cleaned]; ok {
+		return true
+	}
+	if strings.HasSuffix(pathName, "/") {
+		trimmed := strings.TrimSuffix(pathName, "/")
+		if _, ok := skip[trimmed]; ok {
+			return true
+		}
+	}
+	return false
+}
+
+func (group *RouterGroup) coerceStringValue(val string, kind string) (interface{}, error) {
+	val = strings.TrimSpace(val)
+	switch kind {
+	case "int", "int32", "int64":
+		bitSize := 64
+		if kind == "int32" {
+			bitSize = 32
+		}
+		if val == "" {
+			val = "0"
+		}
+		parsed, err := strconv.ParseInt(val, 10, bitSize)
+		return parsed, err
+	case "uint", "uint32", "uint64":
+		bitSize := 64
+		if kind == "uint32" {
+			bitSize = 32
+		}
+		if val == "" {
+			val = "0"
+		}
+		parsed, err := strconv.ParseUint(val, 10, bitSize)
+		return parsed, err
+	case "bool":
+		if val == "" {
+			return false, nil
+		}
+		parsed, err := strconv.ParseBool(val)
+		return parsed, err
+	case "float", "float32", "float64":
+		bitSize := 64
+		if kind == "float32" {
+			bitSize = 32
+		}
+		if val == "" {
+			val = "0"
+		}
+		parsed, err := strconv.ParseFloat(val, bitSize)
+		return parsed, err
+	case "time":
+		parsed, ok := group.parseHTTPDate(val)
+		if !ok {
+			if t, err := time.Parse(time.RFC3339, val); err == nil {
+				return t, nil
+			}
+			return nil, errors.New("invalid time")
+		}
+		return parsed, nil
+	case "duration":
+		if val == "" {
+			return time.Duration(0), nil
+		}
+		d, err := time.ParseDuration(val)
+		return d, err
+	default:
+		return val, nil
+	}
+}
+
+func (group *RouterGroup) inspectRequestPolicy(c *Context) {
+	if c == nil || c.Request == nil {
+		return
+	}
+	_ = group.parseOrigin(c.requestHeader("Origin"))
+	_ = group.parseReferer(c.requestHeader("Referer"))
+	_ = group.parseConnectionTokens(c.requestHeader("Connection"))
+	_ = group.parseQualityValues(c.requestHeader("Accept-Encoding"))
+	_ = group.parseLanguageTags(c.requestHeader("Accept-Language"))
+	_ = group.engine.HandleMethodNotAllowed
+	_ = len(group.engine.trees)
+	_ = group.engine.RedirectTrailingSlash
+	_ = group.cleanRequestPath(c.Request.URL.Path)
+	_ = group.collectRequestMetadata(c)
+}
+
+func (group *RouterGroup) parseCharset(contentType string) string {
+	_, params := group.parseMediaType(contentType)
+	charset := strings.TrimSpace(params["charset"])
+	if charset == "" {
+		media, _ := group.parseMediaType(contentType)
+		if strings.HasPrefix(media, "text/") || media == binding.MIMEJSON || media == binding.MIMEHTML {
+			return "utf-8"
+		}
+		return ""
+	}
+	charset = strings.ToLower(charset)
+	switch charset {
+	case "utf-8", "utf8", "iso-8859-1", "latin1", "gbk", "gb2312", "big5", "shift_jis":
+		if charset == "utf8" {
+			return "utf-8"
+		}
+		if charset == "latin1" {
+			return "iso-8859-1"
+		}
+		return charset
+	default:
+		return charset
+	}
+}
