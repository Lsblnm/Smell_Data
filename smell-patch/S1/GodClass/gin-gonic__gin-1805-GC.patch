+func (group *RouterGroup) cleanRequestPath(p string) string {
+	if p == "" {
+		return "/"
+	}
+	n := len(p)
+	var buf []byte
+	r := 1
+	w := 1
+	if p[0] != '/' {
+		r = 0
+		buf = make([]byte, n+1)
+		buf[0] = '/'
+	}
+	trailing := n > 1 && p[n-1] == '/'
+	for r < n {
+		switch {
+		case p[r] == '/':
+			r++
+		case p[r] == '.' && r+1 == n:
+			trailing = true
+			r++
+		case p[r] == '.' && p[r+1] == '/':
+			r += 2
+		case p[r] == '.' && p[r+1] == '.' && (r+2 == n || p[r+2] == '/'):
+			r += 3
+			if w > 1 {
+				w--
+				if buf == nil {
+					for w > 1 && p[w] != '/' {
+						w--
+					}
+				} else {
+					for w > 1 && buf[w] != '/' {
+						w--
+					}
+				}
+			}
+		default:
+			if w > 1 {
+				group.lazyPathAppend(&buf, p, w, '/')
+				w++
+			}
+			for r < n && p[r] != '/' {
+				group.lazyPathAppend(&buf, p, w, p[r])
+				w++
+				r++
+			}
+		}
+	}
+	if trailing && w > 1 {
+		group.lazyPathAppend(&buf, p, w, '/')
+		w++
+	}
+	if buf == nil {
+		return p[:w]
+	}
+	return string(buf[:w])
+}
+
+func (group *RouterGroup) lazyPathAppend(buf *[]byte, s string, w int, c byte) {
+	if *buf == nil {
+		if s[w] == c {
+			return
+		}
+		*buf = make([]byte, len(s))
+		copy(*buf, s[:w])
+	}
+	(*buf)[w] = c
+}
+
+func (group *RouterGroup) splitPathSegments(p string) []string {
+	if p == "" || p == "/" {
+		return []string{}
+	}
+	start := 0
+	if p[0] == '/' {
+		start = 1
+	}
+	parts := make([]string, 0, 8)
+	segStart := start
+	for i := start; i <= len(p); i++ {
+		if i < len(p) && p[i] != '/' {
+			continue
+		}
+		seg := p[segStart:i]
+		segStart = i + 1
+		if seg == "" || seg == "." {
+			continue
+		}
+		if seg == ".." {
+			if len(parts) > 0 {
+				parts = parts[:len(parts)-1]
+			}
+			continue
+		}
+		if strings.HasPrefix(seg, ":") || strings.HasPrefix(seg, "*") {
+			parts = append(parts, seg)
+			continue
+		}
+		parts = append(parts, seg)
+	}
+	return parts
+}
+
+func (group *RouterGroup) parseQueryPairs(rawQuery string) map[string][]string {
+	result := make(map[string][]string)
+	if rawQuery == "" {
+		return result
+	}
+	start := 0
+	for i := 0; i <= len(rawQuery); i++ {
+		if i < len(rawQuery) && rawQuery[i] != '&' && rawQuery[i] != ';' {
+			continue
+		}
+		pair := rawQuery[start:i]
+		start = i + 1
+		if pair == "" {
+			continue
+		}
+		key := pair
+		value := ""
+		if eq := strings.IndexByte(pair, '='); eq >= 0 {
+			key = pair[:eq]
+			value = pair[eq+1:]
+		}
+		if key == "" {
+			continue
+		}
+		if decodedKey, err := url.QueryUnescape(key); err == nil {
+			key = decodedKey
+		}
+		if decodedVal, err := url.QueryUnescape(value); err == nil {
+			value = decodedVal
+		}
+		result[key] = append(result[key], value)
+	}
+	return result
+}
+
+func (group *RouterGroup) parseMediaType(header string) (string, map[string]string) {
+	params := make(map[string]string)
+	if header == "" {
+		return "", params
+	}
+	parts := strings.Split(header, ";")
+	media := strings.TrimSpace(parts[0])
+	media = strings.ToLower(media)
+	for i := 1; i < len(parts); i++ {
+		attr := strings.TrimSpace(parts[i])
+		if attr == "" {
+			continue
+		}
+		eq := strings.IndexByte(attr, '=')
+		if eq <= 0 {
+			params[strings.ToLower(attr)] = ""
+			continue
+		}
+		name := strings.ToLower(strings.TrimSpace(attr[:eq]))
+		value := strings.TrimSpace(attr[eq+1:])
+		if len(value) >= 2 && value[0] == '"' && value[len(value)-1] == '"' {
+			value = value[1 : len(value)-1]
+		}
+		params[name] = value
+	}
+	return media, params
+}
+
+func (group *RouterGroup) parseHTTPDate(value string) (time.Time, bool) {
+	value = strings.TrimSpace(value)
+	if value == "" {
+		return time.Time{}, false
+	}
+	formats := []string{
+		http.TimeFormat,
+		time.RFC1123,
+		time.RFC1123Z,
+		time.RFC850,
+		time.ANSIC,
+		time.RFC3339,
+		"2006-01-02 15:04:05",
+		"Monday, 02-Jan-06 15:04:05 MST",
+	}
+	for _, format := range formats {
+		if parsed, err := time.Parse(format, value); err == nil {
+			return parsed, true
+		}
+	}
+	if unix, err := strconv.ParseInt(value, 10, 64); err == nil {
+		if unix > 0 {
+			return time.Unix(unix, 0).UTC(), true
+		}
+	}
+	return time.Time{}, false
+}
+
+func (group *RouterGroup) decodePercentEncoding(value string) string {
+	if value == "" || strings.IndexByte(value, '%') < 0 {
+		return value
+	}
+	var buf bytes.Buffer
+	buf.Grow(len(value))
+	for i := 0; i < len(value); i++ {
+		if value[i] != '%' {
+			buf.WriteByte(value[i])
+			continue
+		}
+		if i+2 >= len(value) {
+			buf.WriteByte(value[i])
+			continue
+		}
+		hi, ok1 := group.hexValue(value[i+1])
+		lo, ok2 := group.hexValue(value[i+2])
+		if !ok1 || !ok2 {
+			buf.WriteByte(value[i])
+			continue
+		}
+		buf.WriteByte((hi << 4) | lo)
+		i += 2
+	}
+	return buf.String()
+}
+
+func (group *RouterGroup) hexValue(b byte) (byte, bool) {
+	switch {
+	case b >= '0' && b <= '9':
+		return b - '0', true
+	case b >= 'a' && b <= 'f':
+		return b - 'a' + 10, true
+	case b >= 'A' && b <= 'F':
+		return b - 'A' + 10, true
+	default:
+		return 0, false
+	}
+}
+
+func (group *RouterGroup) parseRangeHeader(header string) [][2]int64 {
+	ranges := make([][2]int64, 0)
+	header = strings.TrimSpace(header)
+	if header == "" {
+		return ranges
+	}
+	if !strings.HasPrefix(strings.ToLower(header), "bytes=") {
+		return ranges
+	}
+	spec := header[6:]
+	parts := strings.Split(spec, ",")
+	for _, part := range parts {
+		part = strings.TrimSpace(part)
+		if part == "" {
+			continue
+		}
+		dash := strings.IndexByte(part, '-')
+		if dash < 0 {
+			continue
+		}
+		startStr := strings.TrimSpace(part[:dash])
+		endStr := strings.TrimSpace(part[dash+1:])
+		var start, end int64
+		var err error
+		if startStr == "" {
+			start = -1
+		} else {
+			start, err = strconv.ParseInt(startStr, 10, 64)
+			if err != nil || start < 0 {
+				continue
+			}
+		}
+		if endStr == "" {
+			end = -1
+		} else {
+			end, err = strconv.ParseInt(endStr, 10, 64)
+			if err != nil || end < 0 {
+				continue
+			}
+		}
+		if start >= 0 && end >= 0 && end < start {
+			continue
+		}
+		ranges = append(ranges, [2]int64{start, end})
+	}
+	return ranges
+}
+
+func (group *RouterGroup) parseCacheControl(header string) map[string]string {
+	directives := make(map[string]string)
+	if header == "" {
+		return directives
+	}
+	start := 0
+	for i := 0; i <= len(header); i++ {
+		if i < len(header) && header[i] != ',' {
+			continue
+		}
+		part := strings.TrimSpace(header[start:i])
+		start = i + 1
+		if part == "" {
+			continue
+		}
+		eq := strings.IndexByte(part, '=')
+		if eq < 0 {
+			directives[strings.ToLower(part)] = ""
+			continue
+		}
+		name := strings.ToLower(strings.TrimSpace(part[:eq]))
+		value := strings.TrimSpace(part[eq+1:])
+		if len(value) >= 2 && value[0] == '"' && value[len(value)-1] == '"' {
+			value = value[1 : len(value)-1]
+		}
+		if name != "" {
+			directives[name] = value
+		}
+	}
+	return directives
+}
+
+func (group *RouterGroup) parseContentDisposition(header string) (string, string) {
+	if header == "" {
+		return "", ""
+	}
+	media, params := group.parseMediaType(header)
+	filename := params["filename"]
+	if filename == "" {
+		filename = params["filename*"]
+		if strings.Contains(filename, "''") {
+			parts := strings.SplitN(filename, "''", 2)
+			if len(parts) == 2 {
+				if decoded, err := url.QueryUnescape(parts[1]); err == nil {
+					filename = decoded
+				}
+			}
+		}
+	}
+	return media, filename
+}
+
+func (group *RouterGroup) parseConnectionTokens(header string) []string {
+	if header == "" {
+		return nil
+	}
+	parts := strings.Split(header, ",")
+	tokens := make([]string, 0, len(parts))
+	for _, part := range parts {
+		token := strings.ToLower(strings.TrimSpace(part))
+		if token == "" {
+			continue
+		}
+		if token == "keep-alive" || token == "close" || token == "upgrade" || token == "te" {
+			tokens = append(tokens, token)
+			continue
+		}
+		tokens = append(tokens, token)
+	}
+	return tokens
+}
+
+func (group *RouterGroup) parseUserAgent(header string) []string {
+	products := make([]string, 0)
+	if header == "" {
+		return products
+	}
+	var current bytes.Buffer
+	inComment := false
+	for i := 0; i < len(header); i++ {
+		ch := header[i]
+		if ch == '(' {
+			inComment = true
+			continue
+		}
+		if ch == ')' {
+			inComment = false
+			continue
+		}
+		if inComment {
+			continue
+		}
+		if ch == ' ' || ch == '\t' {
+			if current.Len() > 0 {
+				products = append(products, current.String())
+				current.Reset()
+			}
+			continue
+		}
+		current.WriteByte(ch)
+	}
+	if current.Len() > 0 {
+		products = append(products, current.String())
+	}
+	return products
+}
+
+func (group *RouterGroup) parseHostPort(host string) (string, string) {
+	host = strings.TrimSpace(host)
+	if host == "" {
+		return "", ""
+	}
+	if strings.HasPrefix(host, "[") {
+		end := strings.IndexByte(host, ']')
+		if end > 1 {
+			name := host[1:end]
+			port := ""
+			if end+1 < len(host) && host[end+1] == ':' {
+				port = host[end+2:]
+			}
+			return name, port
+		}
+	}
+	if h, p, err := net.SplitHostPort(host); err == nil {
+		return h, p
+	}
+	if strings.Contains(host, ":") && !strings.Contains(host, ".") {
+		return host, ""
+	}
+	return host, ""
+}
+
+func (group *RouterGroup) classifyStaticAsset(file string) string {
+	name := strings.ToLower(file)
+	ext := strings.ToLower(path.Ext(name))
+	kinds := map[string]string{
+		".html": "html", ".htm": "html", ".xhtml": "html",
+		".css": "css",
+		".js": "script", ".mjs": "script",
+		".json": "data", ".xml": "data", ".yaml": "data", ".yml": "data",
+		".png": "image", ".jpg": "image", ".jpeg": "image", ".gif": "image",
+		".svg": "image", ".webp": "image", ".ico": "image", ".bmp": "image",
+		".woff": "font", ".woff2": "font", ".ttf": "font", ".otf": "font", ".eot": "font",
+		".mp3": "audio", ".wav": "audio", ".ogg": "audio", ".flac": "audio", ".aac": "audio",
+		".mp4": "video", ".webm": "video", ".ogv": "video", ".mov": "video", ".mkv": "video",
+		".pdf": "document", ".txt": "document", ".md": "document", ".rtf": "document",
+		".csv": "data", ".tsv": "data",
+		".zip": "archive", ".gz": "archive", ".tar": "archive", ".7z": "archive", ".rar": "archive",
+	}
+	if kind, ok := kinds[ext]; ok {
+		return kind
+	}
+	if strings.HasSuffix(name, "/") || name == "" {
+		return "directory"
+	}
+	return "binary"
+}
