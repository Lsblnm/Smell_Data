+func (group *RouterGroup) splitHostHeaders(values []string) []string {
+	out := make([]string, 0, len(values))
+	for _, value := range values {
+		parts := strings.Split(value, ",")
+		for _, part := range parts {
+			host := strings.TrimSpace(part)
+			if host == "" {
+				continue
+			}
+			name, port := group.parseHostPort(host)
+			if name == "" {
+				continue
+			}
+			if port != "" {
+				out = append(out, name+":"+port)
+				continue
+			}
+			out = append(out, name)
+		}
+	}
+	return out
+}
+
+func (group *RouterGroup) parseTokenList(header string) []string {
+	if header == "" {
+		return nil
+	}
+	out := make([]string, 0)
+	start := 0
+	for i := 0; i <= len(header); i++ {
+		if i < len(header) && header[i] != ',' && header[i] != ' ' && header[i] != '\t' {
+			continue
+		}
+		if i < len(header) && header[i] != ',' {
+			continue
+		}
+		token := strings.TrimSpace(header[start:i])
+		start = i + 1
+		if token == "" {
+			continue
+		}
+		out = append(out, token)
+	}
+	return out
+}
+
+func (group *RouterGroup) defaultStatusBody(code int) []byte {
+	switch code {
+	case http.StatusNotFound:
+		return default404Body
+	case http.StatusMethodNotAllowed:
+		return default405Body
+	case http.StatusBadRequest:
+		return []byte("400 bad request")
+	case http.StatusUnauthorized:
+		return []byte("401 unauthorized")
+	case http.StatusForbidden:
+		return []byte("403 forbidden")
+	case http.StatusInternalServerError:
+		return []byte("500 internal server error")
+	default:
+		text := http.StatusText(code)
+		if text == "" {
+			return nil
+		}
+		return []byte(strconv.Itoa(code) + " " + strings.ToLower(text))
+	}
+}
