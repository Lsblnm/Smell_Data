+func (group *RouterGroup) formTokenClasses() [256]byte {
+	var classes [256]byte
+	for i := 0; i < 256; i++ {
+		classes[i] = 0
+	}
+	for ch := byte('A'); ch <= 'Z'; ch++ {
+		classes[ch] = 1
+	}
+	for ch := byte('a'); ch <= 'z'; ch++ {
+		classes[ch] = 1
+	}
+	for ch := byte('0'); ch <= '9'; ch++ {
+		classes[ch] = 2
+	}
+	classes['-'] = 3
+	classes['_'] = 3
+	classes['.'] = 3
+	classes['~'] = 3
+	classes['!'] = 4
+	classes['$'] = 4
+	classes['&'] = 4
+	classes['\''] = 4
+	classes['('] = 4
+	classes[')'] = 4
+	classes['*'] = 4
+	classes['+'] = 4
+	classes[','] = 4
+	classes[';'] = 4
+	classes['='] = 4
+	classes[':'] = 5
+	classes['/'] = 5
+	classes['?'] = 5
+	classes['#'] = 5
+	classes['['] = 5
+	classes[']'] = 5
+	classes['@'] = 5
+	classes['%'] = 6
+	classes[' '] = 7
+	classes['\t'] = 7
+	classes['\r'] = 8
+	classes['\n'] = 8
+	classes['"'] = 9
+	classes['\\'] = 9
+	return classes
+}
