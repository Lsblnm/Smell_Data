+func (group *RouterGroup) resolveRequestPath(c *Context) (httpMethod string, rPath string, unescape bool) {
+	httpMethod = c.Request.Method
+	rPath = c.Request.URL.Path
+	unescape = false
+	if group.engine.UseRawPath && len(c.Request.URL.RawPath) > 0 {
+		rPath = c.Request.URL.RawPath
+		unescape = group.engine.UnescapePathValues
+	}
+	group.inspectIncomingHeaders(c)
+	return httpMethod, rPath, unescape
+}
+
+func (group *RouterGroup) lookupMethodTree(c *Context, httpMethod, rPath string, unescape bool) bool {
+	t := group.engine.trees
+	for i, tl := 0, len(t); i < tl; i++ {
+		if t[i].method != httpMethod {
+			continue
+		}
+		root := t[i].root
+		handlers, params, tsr := root.getValue(rPath, c.Params, unescape)
+		if handlers != nil {
+			c.handlers = handlers
+			c.Params = params
+			c.Next()
+			c.writermem.WriteHeaderNow()
+			return true
+		}
+		if httpMethod != "CONNECT" && rPath != "/" {
+			if tsr && group.engine.RedirectTrailingSlash {
+				group.redirectWithSlash(c)
+				return true
+			}
+			if group.engine.RedirectFixedPath && group.redirectToFixedPath(c, root, group.engine.RedirectFixedPath) {
+				return true
+			}
+		}
+		break
+	}
+	return false
+}
+
+func (group *RouterGroup) tryMethodNotAllowed(c *Context, httpMethod, rPath string, unescape bool) bool {
+	if !group.engine.HandleMethodNotAllowed {
+		return false
+	}
+	for _, tree := range group.engine.trees {
+		if tree.method == httpMethod {
+			continue
+		}
+		if handlers, _, _ := tree.root.getValue(rPath, nil, unescape); handlers != nil {
+			c.handlers = group.engine.allNoMethod
+			group.writeErrorResponse(c, http.StatusMethodNotAllowed, default405Body)
+			return true
+		}
+	}
+	return false
+}
