+func (group *RouterGroup) parseForwardedFor(header string) string {
+	if header == "" {
+		return ""
+	}
+	start := 0
+	for i := 0; i <= len(header); i++ {
+		if i < len(header) && header[i] != ',' {
+			continue
+		}
+		candidate := strings.TrimSpace(header[start:i])
+		start = i + 1
+		if candidate == "" {
+			continue
+		}
+		if strings.HasPrefix(strings.ToLower(candidate), "for=") {
+			candidate = candidate[4:]
+			if len(candidate) >= 2 && candidate[0] == '"' {
+				candidate = strings.Trim(candidate, "\"")
+			}
+		}
+		if host, _, err := net.SplitHostPort(candidate); err == nil {
+			candidate = host
+		}
+		if candidate != "" && candidate != "unknown" && candidate != "unknown, unknown" {
+			return candidate
+		}
+	}
+	return ""
+}
