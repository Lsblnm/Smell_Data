+func (group *RouterGroup) joinGroupPath(absolutePath, relativePath string) string {
+	if relativePath == "" {
+		return absolutePath
+	}
+	finalPath := path.Join(absolutePath, relativePath)
+	appendSlash := group.lastPathChar(relativePath) == '/' && group.lastPathChar(finalPath) != '/'
+	if appendSlash {
+		return finalPath + "/"
+	}
+	if absolutePath == "/" && relativePath != "" && relativePath[0] != '/' {
+		if finalPath == "" {
+			return "/" + relativePath
+		}
+	}
+	return finalPath
+}
