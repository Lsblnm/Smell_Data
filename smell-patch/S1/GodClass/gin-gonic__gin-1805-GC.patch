+func (group *RouterGroup) bodyAllowedForCode(status int) bool {
+	switch {
+	case status >= 100 && status <= 199:
+		return false
+	case status == http.StatusNoContent:
+		return false
+	case status == http.StatusNotModified:
+		return false
+	default:
+		return true
+	}
+}
