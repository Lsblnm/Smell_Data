+func (group *RouterGroup) buildRequestSummary(c *Context) string {
+	meta := group.collectRequestMetadata(c)
+	keys := make([]string, 0, len(meta))
+	for key := range meta {
+		keys = append(keys, key)
+	}
+	for i := 0; i < len(keys); i++ {
+		best := i
+		for j := i + 1; j < len(keys); j++ {
+			if keys[j] < keys[best] {
+				best = j
+			}
+		}
+		keys[i], keys[best] = keys[best], keys[i]
+	}
+	var buf bytes.Buffer
+	for _, key := range keys {
+		buf.WriteString(key)
+		buf.WriteByte('=')
+		buf.WriteString(meta[key])
+		buf.WriteByte(';')
+	}
+	return buf.String()
+}
