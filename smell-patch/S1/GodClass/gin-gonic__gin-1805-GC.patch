+func (group *RouterGroup) collectRequestMetadata(c *Context) map[string]string {
+	meta := make(map[string]string)
+	if c == nil || c.Request == nil {
+		return meta
+	}
+	req := c.Request
+	meta["method"] = req.Method
+	if req.URL != nil {
+		meta["path"] = req.URL.Path
+		meta["raw_query"] = req.URL.RawQuery
+		meta["fragment"] = req.URL.Fragment
+		meta["raw_path"] = req.URL.RawPath
+		meta["scheme"] = req.URL.Scheme
+		meta["host"] = req.URL.Host
+	}
+	meta["req_host"] = req.Host
+	meta["proto"] = req.Proto
+	meta["remote"] = req.RemoteAddr
+	meta["request_uri"] = req.RequestURI
+	if req.TLS != nil {
+		meta["tls"] = "1"
+	} else {
+		meta["tls"] = "0"
+	}
+	headerNames := []string{
+		"Accept", "Accept-Charset", "Accept-Encoding", "Accept-Language",
+		"Authorization", "Cache-Control", "Connection", "Content-Length",
+		"Content-Type", "Cookie", "Date", "Expect", "Forwarded",
+		"Host", "If-Match", "If-Modified-Since", "If-None-Match",
+		"If-Range", "If-Unmodified-Since", "Origin", "Pragma",
+		"Range", "Referer", "TE", "Trailer", "Transfer-Encoding",
+		"Upgrade", "User-Agent", "Via", "Warning", "X-Forwarded-For",
+		"X-Forwarded-Host", "X-Forwarded-Proto", "X-Real-Ip",
+		"X-Request-Id", "X-Forwarded-Prefix", "Content-Disposition",
+		"If-Unmodified-Since", "Max-Forwards", "Proxy-Authorization",
+		"Accept-Ranges", "Age", "Allow", "ETag", "Expires", "Last-Modified",
+		"Link", "Location", "Retry-After", "Server", "Set-Cookie", "Vary",
+		"WWW-Authenticate", "X-Content-Type-Options", "X-Frame-Options",
+		"X-XSS-Protection", "X-CSRF-Token", "X-Requested-With",
+		"Access-Control-Request-Method", "Access-Control-Request-Headers",
+		"Sec-Fetch-Site", "Sec-Fetch-Mode", "Sec-Fetch-Dest", "Sec-Fetch-User",
+		"DNT", "Save-Data", "Early-Data", "Purpose", "X-Forwarded-Port",
+		"CF-Connecting-IP", "True-Client-IP", "X-Client-IP", "Traceparent",
+		"Tracestate", "X-B3-Traceid", "X-B3-Spanid", "X-Correlation-ID",
+		"Idempotency-Key", "X-HTTP-Method-Override", "Referrer-Policy",
+		"Strict-Transport-Security", "Content-Security-Policy", "NEL",
+		"Permissions-Policy", "Timing-Allow-Origin", "Alt-Svc", "Clear-Site-Data",
+	}
+	classes := group.formTokenClasses()
+	for _, name := range headerNames {
+		value := c.requestHeader(name)
+		if value == "" {
+			continue
+		}
+		filtered := make([]byte, 0, len(value))
+		for i := 0; i < len(value); i++ {
+			kind := classes[value[i]]
+			if kind == 8 {
+				continue
+			}
+			filtered = append(filtered, value[i])
+		}
+		meta["header:"+strings.ToLower(name)] = string(filtered)
+	}
+	host, port := group.parseHostPort(req.Host)
+	if host != "" {
+		meta["host_name"] = host
+	}
+	if port != "" {
+		meta["host_port"] = port
+	}
+	cookies := group.parseCookieHeader(c.requestHeader("Cookie"))
+	meta["cookie_count"] = strconv.Itoa(len(cookies))
+	query := group.parseQueryPairs(req.URL.RawQuery)
+	meta["query_count"] = strconv.Itoa(len(query))
+	media, params := group.parseMediaType(c.requestHeader("Content-Type"))
+	if media != "" {
+		meta["media_type"] = media
+	}
+	if charset, ok := params["charset"]; ok {
+		meta["charset"] = charset
+	}
+	if unescape := group.engine.UnescapePathValues; unescape {
+		meta["unescape"] = "1"
+	}
+	if group.engine.UseRawPath {
+		meta["use_raw_path"] = "1"
+	}
+	return meta
+}
