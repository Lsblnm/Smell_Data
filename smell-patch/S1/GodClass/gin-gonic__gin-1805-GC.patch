+func (group *RouterGroup) pathExtLower(file string) string {
+	ext := strings.ToLower(path.Ext(file))
+	if ext == "." {
+		return ""
+	}
+	return ext
+}
+
+func (group *RouterGroup) isHiddenPath(file string) bool {
+	segs := group.splitPathSegments(file)
+	for _, seg := range segs {
+		if strings.HasPrefix(seg, ".") && seg != "." && seg != ".." {
+			return true
+		}
+	}
+	return false
+}
+
+func (group *RouterGroup) dirname(file string) string {
+	if file == "" {
+		return "/"
+	}
+	idx := strings.LastIndex(file, "/")
+	if idx <= 0 {
+		return "/"
+	}
+	return file[:idx]
+}
+
+func (group *RouterGroup) basename(file string) string {
+	if file == "" {
+		return ""
+	}
+	idx := strings.LastIndex(file, "/")
+	if idx < 0 {
+		return file
+	}
+	return file[idx+1:]
+}
