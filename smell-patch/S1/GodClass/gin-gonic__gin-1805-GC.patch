+func (group *RouterGroup) saveUploadedFile(file *multipart.FileHeader, dst string) error {
+	if file == nil {
+		return errors.New("missing upload")
+	}
+	src, err := file.Open()
+	if err != nil {
+		return err
+	}
+	defer src.Close()
+	out, err := os.Create(dst)
+	if err != nil {
+		return err
+	}
+	defer out.Close()
+	_, err = io.Copy(out, src)
+	return err
+}
