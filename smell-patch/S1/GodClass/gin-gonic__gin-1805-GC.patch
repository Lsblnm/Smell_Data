+func (group *RouterGroup) mediaTypeEquals(a, b string) bool {
+	left, _ := group.parseMediaType(a)
+	right, _ := group.parseMediaType(b)
+	if left == "" || right == "" {
+		return false
+	}
+	if left == "*/*" || right == "*/*" {
+		return true
+	}
+	ls := strings.SplitN(left, "/", 2)
+	rs := strings.SplitN(right, "/", 2)
+	if len(ls) != 2 || len(rs) != 2 {
+		return strings.EqualFold(left, right)
+	}
+	if ls[0] != "*" && rs[0] != "*" && !strings.EqualFold(ls[0], rs[0]) {
+		return false
+	}
+	if ls[1] != "*" && rs[1] != "*" && !strings.EqualFold(ls[1], rs[1]) {
+		return false
+	}
+	return true
+}
