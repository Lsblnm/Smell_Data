+func (group *RouterGroup) cookieAttributeMap(header string) map[string]string {
+	attrs := make(map[string]string)
+	if header == "" {
+		return attrs
+	}
+	parts := strings.Split(header, ";")
+	if len(parts) == 0 {
+		return attrs
+	}
+	first := strings.TrimSpace(parts[0])
+	if eq := strings.IndexByte(first, '='); eq > 0 {
+		attrs["name"] = first[:eq]
+		attrs["value"] = first[eq+1:]
+	}
+	for i := 1; i < len(parts); i++ {
+		part := strings.TrimSpace(parts[i])
+		if part == "" {
+			continue
+		}
+		eq := strings.IndexByte(part, '=')
+		if eq < 0 {
+			attrs[strings.ToLower(part)] = "true"
+			continue
+		}
+		key := strings.ToLower(strings.TrimSpace(part[:eq]))
+		val := strings.TrimSpace(part[eq+1:])
+		switch key {
+		case "path", "domain", "expires", "max-age", "samesite":
+			attrs[key] = val
+		case "secure", "httponly":
+			attrs[key] = "true"
+		default:
+			attrs[key] = val
+		}
+	}
+	return attrs
+}
