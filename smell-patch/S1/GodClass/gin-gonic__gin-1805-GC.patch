+func (group *RouterGroup) parseETags(header string) []string {
+	tags := make([]string, 0)
+	header = strings.TrimSpace(header)
+	if header == "" {
+		return tags
+	}
+	if header == "*" {
+		return []string{"*"}
+	}
+	start := 0
+	inQuote := false
+	for i := 0; i <= len(header); i++ {
+		if i < len(header) && header[i] == '"' {
+			inQuote = !inQuote
+			continue
+		}
+		if i < len(header) && (inQuote || header[i] != ',') {
+			continue
+		}
+		tag := strings.TrimSpace(header[start:i])
+		start = i + 1
+		if tag == "" {
+			continue
+		}
+		if strings.HasPrefix(tag, "W/") || strings.HasPrefix(tag, "w/") {
+			tag = "W/" + strings.TrimSpace(tag[2:])
+		}
+		tags = append(tags, tag)
+	}
+	return tags
+}
+
+func (group *RouterGroup) parseOrigin(header string) string {
+	header = strings.TrimSpace(header)
+	if header == "" || header == "null" {
+		return header
+	}
+	parsed, err := url.Parse(header)
+	if err != nil {
+		return ""
+	}
+	if parsed.Scheme != "http" && parsed.Scheme != "https" {
+		return ""
+	}
+	if parsed.Host == "" {
+		return ""
+	}
+	return parsed.Scheme + "://" + parsed.Host
+}
+
+func (group *RouterGroup) parseReferer(header string) *url.URL {
+	header = strings.TrimSpace(header)
+	if header == "" {
+		return nil
+	}
+	parsed, err := url.Parse(header)
+	if err != nil {
+		return nil
+	}
+	if parsed.Scheme == "" {
+		parsed.Scheme = "http"
+	}
+	if parsed.Scheme != "http" && parsed.Scheme != "https" && parsed.Scheme != "ftp" {
+		return nil
+	}
+	return parsed
+}
+
+func (group *RouterGroup) parseTransferEncoding(header string) []string {
+	if header == "" {
+		return nil
+	}
+	parts := strings.Split(header, ",")
+	encodings := make([]string, 0, len(parts))
+	for _, part := range parts {
+		token := strings.ToLower(strings.TrimSpace(part))
+		if token == "" {
+			continue
+		}
+		if idx := strings.Index(token, ";"); idx >= 0 {
+			token = strings.TrimSpace(token[:idx])
+		}
+		switch token {
+		case "chunked", "compress", "deflate", "gzip", "identity":
+			encodings = append(encodings, token)
+		default:
+			if token != "" {
+				encodings = append(encodings, token)
+			}
+		}
+	}
+	return encodings
+}
+
+func (group *RouterGroup) parseQualityValues(header string) []string {
+	parts := strings.Split(header, ",")
+	type qvalue struct {
+		value string
+		q     float64
+	}
+	items := make([]qvalue, 0, len(parts))
+	for _, part := range parts {
+		part = strings.TrimSpace(part)
+		if part == "" {
+			continue
+		}
+		value := part
+		q := 1.0
+		if idx := strings.Index(part, ";"); idx >= 0 {
+			value = strings.TrimSpace(part[:idx])
+			params := strings.Split(part[idx+1:], ";")
+			for _, param := range params {
+				param = strings.TrimSpace(param)
+				if strings.HasPrefix(strings.ToLower(param), "q=") {
+					if parsed, err := strconv.ParseFloat(param[2:], 64); err == nil {
+						if parsed < 0 {
+							parsed = 0
+						}
+						if parsed > 1 {
+							parsed = 1
+						}
+						q = parsed
+					}
+				}
+			}
+		}
+		if value != "" && q > 0 {
+			items = append(items, qvalue{value: value, q: q})
+		}
+	}
+	out := make([]string, 0, len(items))
+	for i := 0; i < len(items); i++ {
+		best := i
+		for j := i + 1; j < len(items); j++ {
+			if items[j].q > items[best].q {
+				best = j
+			}
+		}
+		items[i], items[best] = items[best], items[i]
+		out = append(out, items[i].value)
+	}
+	return out
+}
+
+func (group *RouterGroup) parseLanguageTags(header string) []string {
+	if header == "" {
+		return nil
+	}
+	ordered := group.parseQualityValues(header)
+	tags := make([]string, 0, len(ordered))
+	for _, item := range ordered {
+		item = strings.Replace(item, "_", "-", -1)
+		parts := strings.Split(item, "-")
+		normalized := make([]string, 0, len(parts))
+		for i, part := range parts {
+			part = strings.TrimSpace(part)
+			if part == "" {
+				continue
+			}
+			if i == 0 {
+				normalized = append(normalized, strings.ToLower(part))
+				continue
+			}
+			if len(part) == 2 {
+				normalized = append(normalized, strings.ToUpper(part))
+				continue
+			}
+			normalized = append(normalized, part)
+		}
+		if len(normalized) > 0 {
+			tags = append(tags, strings.Join(normalized, "-"))
+		}
+	}
+	return tags
+}
+
+func (group *RouterGroup) parseLinkHeader(header string) []string {
+	links := make([]string, 0)
+	if header == "" {
+		return links
+	}
+	start := 0
+	inAngle := false
+	for i := 0; i <= len(header); i++ {
+		if i < len(header) && header[i] == '<' {
+			inAngle = true
+		}
+		if i < len(header) && header[i] == '>' {
+			inAngle = false
+		}
+		if i < len(header) && (inAngle || header[i] != ',') {
+			continue
+		}
+		part := strings.TrimSpace(header[start:i])
+		start = i + 1
+		if part == "" {
+			continue
+		}
+		begin := strings.IndexByte(part, '<')
+		end := strings.IndexByte(part, '>')
+		if begin >= 0 && end > begin {
+			links = append(links, part[begin+1:end])
+		}
+	}
+	return links
+}
+
+func (group *RouterGroup) parseForwardedRFC7239(header string) map[string]string {
+	result := make(map[string]string)
+	if header == "" {
+		return result
+	}
+	first := header
+	if idx := strings.IndexByte(header, ','); idx >= 0 {
+		first = header[:idx]
+	}
+	pairs := strings.Split(first, ";")
+	for _, pair := range pairs {
+		pair = strings.TrimSpace(pair)
+		if pair == "" {
+			continue
+		}
+		eq := strings.IndexByte(pair, '=')
+		if eq <= 0 {
+			continue
+		}
+		key := strings.ToLower(strings.TrimSpace(pair[:eq]))
+		value := strings.TrimSpace(pair[eq+1:])
+		if len(value) >= 2 && value[0] == '"' && value[len(value)-1] == '"' {
+			value = value[1 : len(value)-1]
+		}
+		switch key {
+		case "for", "by", "host", "proto":
+			result[key] = value
+		default:
+			if key != "" {
+				result[key] = value
+			}
+		}
+	}
+	return result
+}
+
+func (group *RouterGroup) parseContentRange(header string) (string, int64, int64, int64, bool) {
+	header = strings.TrimSpace(header)
+	if header == "" {
+		return "", 0, 0, 0, false
+	}
+	parts := strings.Fields(header)
+	if len(parts) != 2 {
+		return "", 0, 0, 0, false
+	}
+	unit := strings.ToLower(parts[0])
+	spec := parts[1]
+	if spec == "*" {
+		return unit, -1, -1, -1, true
+	}
+	slash := strings.IndexByte(spec, '/')
+	if slash < 0 {
+		return "", 0, 0, 0, false
+	}
+	rangePart := spec[:slash]
+	totalPart := spec[slash+1:]
+	total := int64(-1)
+	if totalPart != "*" {
+		parsed, err := strconv.ParseInt(totalPart, 10, 64)
+		if err != nil {
+			return "", 0, 0, 0, false
+		}
+		total = parsed
+	}
+	dash := strings.IndexByte(rangePart, '-')
+	if dash < 0 {
+		return "", 0, 0, 0, false
+	}
+	start, err1 := strconv.ParseInt(rangePart[:dash], 10, 64)
+	end, err2 := strconv.ParseInt(rangePart[dash+1:], 10, 64)
+	if err1 != nil || err2 != nil || end < start {
+		return "", 0, 0, 0, false
+	}
+	return unit, start, end, total, true
+}
+
+func (group *RouterGroup) parseVia(header string) []string {
+	if header == "" {
+		return nil
+	}
+	parts := strings.Split(header, ",")
+	out := make([]string, 0, len(parts))
+	for _, part := range parts {
+		part = strings.TrimSpace(part)
+		if part == "" {
+			continue
+		}
+		fields := strings.Fields(part)
+		if len(fields) < 2 {
+			continue
+		}
+		protocol := fields[0]
+		received := fields[1]
+		if protocol == "" || received == "" {
+			continue
+		}
+		out = append(out, protocol+" "+received)
+	}
+	return out
+}
+
+func (group *RouterGroup) canonicalHeaderSet(c *Context) map[string][]string {
+	out := make(map[string][]string)
+	if c == nil || c.Request == nil {
+		return out
+	}
+	for key, values := range c.Request.Header {
+		canon := http.CanonicalHeaderKey(key)
+		if canon == "" {
+			continue
+		}
+		copied := make([]string, len(values))
+		copy(copied, values)
+		out[canon] = copied
+	}
+	return out
+}
+
+func (group *RouterGroup) validateRoutePattern(pattern string) error {
+	if pattern == "" {
+		return errors.New("empty route pattern")
+	}
+	if pattern[0] != '/' {
+		return errors.New("path must begin with '/'")
+	}
+	inParam := false
+	starSeen := false
+	for i := 0; i < len(pattern); i++ {
+		ch := pattern[i]
+		if ch == '*' {
+			if starSeen {
+				return errors.New("multiple wildcards")
+			}
+			starSeen = true
+			inParam = true
+			continue
+		}
+		if ch == ':' {
+			inParam = true
+			continue
+		}
+		if ch == '/' {
+			inParam = false
+			continue
+		}
+		if inParam && (ch == '*' || ch == ':') {
+			return errors.New("invalid parameter name")
+		}
+	}
+	return nil
+}
+
+func (group *RouterGroup) encodePathSegment(segment string) string {
+	if segment == "" {
+		return segment
+	}
+	var buf bytes.Buffer
+	for i := 0; i < len(segment); i++ {
+		ch := segment[i]
+		if (ch >= 'a' && ch <= 'z') || (ch >= 'A' && ch <= 'Z') || (ch >= '0' && ch <= '9') {
+			buf.WriteByte(ch)
+			continue
+		}
+		switch ch {
+		case '-', '_', '.', '~':
+			buf.WriteByte(ch)
+		default:
+			buf.WriteByte('%')
+			buf.WriteByte("0123456789ABCDEF"[ch>>4])
+			buf.WriteByte("0123456789ABCDEF"[ch&0x0F])
+		}
+	}
+	return buf.String()
+}
+
+func (group *RouterGroup) queryArray(c *Context, key string) ([]string, bool) {
+	if c == nil || c.Request == nil || c.Request.URL == nil {
+		return []string{}, false
+	}
+	_ = group.engine.UseRawPath
+	values := group.requestQueryPairs(c)[key]
+	if len(values) > 0 {
+		return values, true
+	}
+	if values, ok := c.Request.URL.Query()[key]; ok && len(values) > 0 {
+		return values, true
+	}
+	return []string{}, false
+}
