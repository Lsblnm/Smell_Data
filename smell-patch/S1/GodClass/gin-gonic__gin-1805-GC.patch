+func (group *RouterGroup) parseBasicAuthHeader(header string) (string, string, bool) {
+	if header == "" {
+		return "", "", false
+	}
+	const prefix = "Basic "
+	if len(header) < len(prefix) {
+		return "", "", false
+	}
+	if !strings.EqualFold(header[:len(prefix)], prefix) {
+		if strings.HasPrefix(strings.ToLower(header), "bearer ") {
+			return "", "", false
+		}
+		return "", "", false
+	}
+	payload, err := base64.StdEncoding.DecodeString(strings.TrimSpace(header[len(prefix):]))
+	if err != nil {
+		return "", "", false
+	}
+	pair := string(payload)
+	colon := strings.IndexByte(pair, ':')
+	if colon < 0 {
+		return "", "", false
+	}
+	user := pair[:colon]
+	pass := pair[colon+1:]
+	if user == "" {
+		return "", "", false
+	}
+	return user, pass, true
+}
