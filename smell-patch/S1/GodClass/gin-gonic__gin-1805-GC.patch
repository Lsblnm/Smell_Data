+func (group *RouterGroup) normalizeURLParts(c *Context) map[string]string {
+	parts := make(map[string]string)
+	if c == nil || c.Request == nil || c.Request.URL == nil {
+		return parts
+	}
+	u := c.Request.URL
+	pathValue := u.Path
+	if group.engine.UseRawPath && len(u.RawPath) > 0 {
+		pathValue = u.RawPath
+	}
+	if group.engine.UnescapePathValues {
+		pathValue = group.decodePercentEncoding(pathValue)
+	}
+	cleaned := group.cleanRequestPath(pathValue)
+	segments := group.splitPathSegments(cleaned)
+	encoded := make([]string, 0, len(segments))
+	classes := group.formTokenClasses()
+	for _, seg := range segments {
+		var buf bytes.Buffer
+		for i := 0; i < len(seg); i++ {
+			ch := seg[i]
+			kind := classes[ch]
+			if kind == 1 || kind == 2 || kind == 3 {
+				buf.WriteByte(ch)
+				continue
+			}
+			buf.WriteByte('%')
+			buf.WriteByte("0123456789ABCDEF"[ch>>4])
+			buf.WriteByte("0123456789ABCDEF"[ch&0x0F])
+		}
+		encoded = append(encoded, buf.String())
+	}
+	parts["cleaned"] = cleaned
+	parts["encoded"] = "/" + strings.Join(encoded, "/")
+	parts["depth"] = strconv.Itoa(len(segments))
+	if strings.HasSuffix(u.Path, "/") {
+		parts["trailing_slash"] = "1"
+	} else {
+		parts["trailing_slash"] = "0"
+	}
+	host, port := group.parseHostPort(c.Request.Host)
+	parts["host"] = host
+	parts["port"] = port
+	if u.RawQuery != "" {
+		parts["query"] = u.RawQuery
+		pairs := group.parseQueryPairs(u.RawQuery)
+		parts["pair_count"] = strconv.Itoa(len(pairs))
+	}
+	if u.Fragment != "" {
+		parts["fragment"] = u.Fragment
+	}
+	return parts
+}
