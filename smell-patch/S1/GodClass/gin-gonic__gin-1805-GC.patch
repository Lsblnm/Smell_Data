+func (group *RouterGroup) parsePairList(header, sep string) []string {
+	if header == "" {
+		return nil
+	}
+	if sep == "" {
+		sep = ","
+	}
+	raw := strings.Split(header, sep)
+	out := make([]string, 0, len(raw))
+	for _, item := range raw {
+		item = strings.TrimSpace(item)
+		if item == "" {
+			continue
+		}
+		out = append(out, item)
+	}
+	return out
+}
