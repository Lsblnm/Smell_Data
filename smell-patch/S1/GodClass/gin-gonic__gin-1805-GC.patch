+func (group *RouterGroup) matchBasicAuth(header string, pairs authPairs) (string, bool) {
+	user, password, ok := group.parseBasicAuthHeader(header)
+	if !ok {
+		return "", false
+	}
+	encoded := authorizationHeader(user, password)
+	for _, pair := range pairs {
+		if pair.value == encoded || pair.value == header {
+			return pair.user, true
+		}
+		if pair.user == user && secureCompare(pair.value, encoded) {
+			return pair.user, true
+		}
+	}
+	found, exists := authPairs(pairs).searchCredential(header)
+	if exists {
+		return found, true
+	}
+	return "", false
+}
