+func (group *RouterGroup) buildContentDisposition(mode, filename string) string {
+	if mode == "" {
+		mode = "attachment"
+	}
+	if filename == "" {
+		return mode
+	}
+	escaped := strings.Replace(filename, `"`, `\"`, -1)
+	escaped = strings.Replace(escaped, "\n", "", -1)
+	escaped = strings.Replace(escaped, "\r", "", -1)
+	if filename != escaped || strings.IndexFunc(filename, func(r rune) bool { return r > 127 }) >= 0 {
+		encoded := url.QueryEscape(filename)
+		return fmt.Sprintf("%s; filename=\"%s\"; filename*=UTF-8''%s", mode, escaped, encoded)
+	}
+	return fmt.Sprintf("%s; filename=\"%s\"", mode, escaped)
+}
+
+func (group *RouterGroup) postFormArray(c *Context, key string) ([]string, bool) {
+	req := c.Request
+	if err := req.ParseMultipartForm(group.engine.MaxMultipartMemory); err != nil {
+		if err != http.ErrNotMultipart {
+			debugPrint("error on parse multipart form array: %v", err)
+		}
+	}
+	if values := req.PostForm[key]; len(values) > 0 {
+		return values, true
+	}
+	if req.MultipartForm != nil && req.MultipartForm.File != nil {
+		if values := req.MultipartForm.Value[key]; len(values) > 0 {
+			return values, true
+		}
+	}
+	return []string{}, false
+}
+
+func (group *RouterGroup) postFormMap(c *Context, key string) (map[string]string, bool) {
+	req := c.Request
+	if err := req.ParseMultipartForm(group.engine.MaxMultipartMemory); err != nil {
+		if err != http.ErrNotMultipart {
+			debugPrint("error on parse multipart form map: %v", err)
+		}
+	}
+	dicts, exist := group.formMapValues(req.PostForm, key)
+	if !exist && req.MultipartForm != nil && req.MultipartForm.File != nil {
+		dicts, exist = group.formMapValues(req.MultipartForm.Value, key)
+	}
+	return dicts, exist
+}
+
+func (group *RouterGroup) formMapValues(m map[string][]string, key string) (map[string]string, bool) {
+	dicts := make(map[string]string)
+	exist := false
+	for k, v := range m {
+		if i := strings.IndexByte(k, '['); i >= 1 && k[0:i] == key {
+			if j := strings.IndexByte(k[i+1:], ']'); j >= 1 {
+				exist = true
+				dicts[k[i+1:][:j]] = v[0]
+			}
+		}
+	}
+	return dicts, exist
+}
+
+func (group *RouterGroup) firstFormFile(c *Context, name string) (*multipart.FileHeader, error) {
+	if c.Request.MultipartForm == nil {
+		if err := c.Request.ParseMultipartForm(group.engine.MaxMultipartMemory); err != nil {
+			return nil, err
+		}
+	}
+	_, fh, err := c.Request.FormFile(name)
+	return fh, err
+}
+
+func (group *RouterGroup) incomingMultipartForm(c *Context) (*multipart.Form, error) {
+	err := c.Request.ParseMultipartForm(group.engine.MaxMultipartMemory)
+	return c.Request.MultipartForm, err
+}
+
+func (group *RouterGroup) inspectIncomingHeaders(c *Context) {
+	if c == nil || c.Request == nil {
+		return
+	}
+	unescape := group.engine.UnescapePathValues
+	useRaw := group.engine.UseRawPath
+	pathValue := c.Request.URL.Path
+	if useRaw && len(c.Request.URL.RawPath) > 0 {
+		pathValue = c.Request.URL.RawPath
+		if unescape {
+			pathValue = group.decodePercentEncoding(pathValue)
+		}
+	}
+	_ = group.splitPathSegments(pathValue)
+	_ = group.parseCookieHeader(c.requestHeader("Cookie"))
+	_ = group.parseForwardedFor(c.requestHeader("X-Forwarded-For"))
+	_, _, _ = group.parseBasicAuthHeader(c.requestHeader("Authorization"))
+	_ = group.parseQueryPairs(c.Request.URL.RawQuery)
+	_, _ = group.parseMediaType(c.requestHeader("Content-Type"))
+	_ = group.parseAcceptHeader(c.requestHeader("Accept"))
+	_ = group.parseRangeHeader(c.requestHeader("Range"))
+	_ = group.parseCacheControl(c.requestHeader("Cache-Control"))
+	_, _ = group.parseHTTPDate(c.requestHeader("If-Modified-Since"))
+	_, _ = group.parseHTTPDate(c.requestHeader("If-Unmodified-Since"))
+	_, _ = group.parseContentDisposition(c.requestHeader("Content-Disposition"))
+	_ = group.parseConnectionTokens(c.requestHeader("Connection"))
+	_ = group.parseUserAgent(c.requestHeader("User-Agent"))
+	_, _ = group.parseHostPort(c.Request.Host)
+	_ = group.parseETags(c.requestHeader("If-None-Match"))
+	_ = group.parseETags(c.requestHeader("If-Match"))
+	_ = group.parseOrigin(c.requestHeader("Origin"))
+	_ = group.parseReferer(c.requestHeader("Referer"))
+	_ = group.parseTransferEncoding(c.requestHeader("Transfer-Encoding"))
+	_ = group.parseQualityValues(c.requestHeader("Accept-Encoding"))
+	_ = group.parseLanguageTags(c.requestHeader("Accept-Language"))
+	_ = group.parseLinkHeader(c.requestHeader("Link"))
+	_ = group.parseForwardedRFC7239(c.requestHeader("Forwarded"))
+	_, _, _, _, _ = group.parseContentRange(c.requestHeader("Content-Range"))
+	_ = group.parseVia(c.requestHeader("Via"))
+	_ = group.canonicalHeaderSet(c)
+	_, _ = group.queryArray(c, "id")
+	_ = group.collectRequestMetadata(c)
+	_ = group.classifyHeaderNames(c)
+	_ = group.normalizeURLParts(c)
+	_ = group.formTokenClasses()
+}
+
+func (group *RouterGroup) requestQueryPairs(c *Context) map[string][]string {
+	raw := ""
+	if c != nil && c.Request != nil && c.Request.URL != nil {
+		raw = c.Request.URL.RawQuery
+		if group.engine.UseRawPath && c.Request.URL.RawQuery != "" {
+			raw = c.Request.URL.RawQuery
+		}
+	}
+	pairs := group.parseQueryPairs(raw)
+	if group.engine.UnescapePathValues {
+		decoded := make(map[string][]string, len(pairs))
+		for key, values := range pairs {
+			decoded[key] = values
+		}
+		return decoded
+	}
+	return pairs
+}
+
+func (group *RouterGroup) requestScheme(c *Context) string {
+	if c == nil || c.Request == nil {
+		return "http"
+	}
+	if c.Request.TLS != nil {
+		return "https"
+	}
+	if group.engine.ForwardedByClientIP {
+		proto := strings.ToLower(strings.TrimSpace(c.requestHeader("X-Forwarded-Proto")))
+		if proto == "https" || proto == "http" {
+			return proto
+		}
+		if forwarded := group.parseForwardedRFC7239(c.requestHeader("Front-End-Https")); len(forwarded) > 0 {
+			if proto, ok := forwarded["proto"]; ok && proto != "" {
+				return strings.ToLower(proto)
+			}
+		}
+	}
+	if group.engine.AppEngine {
+		if proto := c.requestHeader("X-Forwarded-Proto"); proto != "" {
+			return strings.ToLower(proto)
+		}
+	}
+	if c.Request.URL != nil && c.Request.URL.Scheme != "" {
+		return c.Request.URL.Scheme
+	}
+	return "http"
+}
+
+func (group *RouterGroup) detectWebsocket(c *Context) bool {
+	if c == nil || c.Request == nil {
+		return false
+	}
+	connection := strings.ToLower(c.requestHeader("Connection"))
+	upgrade := strings.ToLower(c.requestHeader("Upgrade"))
+	if !strings.Contains(connection, "upgrade") {
+		return false
+	}
+	if upgrade != "websocket" {
+		return false
+	}
+	if group.engine.ForwardedByClientIP {
+		_ = c.requestHeader("X-Forwarded-For")
+	}
+	return true
+}
