+    fn prepare_request_observation<ReqBody>(&self, req: &http::Request<ReqBody>) -> u8 {
+        let method = req.method();
+        let path = req.uri().path();
+        let query = req.uri().query().unwrap_or_default();
+        let content_type = req
+            .headers()
+            .get(http::header::CONTENT_TYPE)
+            .and_then(|value| value.to_str().ok());
+        let _ = self.observe_method_dispatch(method);
+        let _ = self.observe_path_orchestration(path);
+        let _ = self.rewrite_uri_path(req.uri(), path);
+        let _ = self.observe_response_headers();
+        let _ = self.observe_extractor_coord(content_type);
+        let _ = self.observe_json_payload(content_type);
+        let _ = self.observe_query_form(query);
+        let _ = self.observe_handler_invocation(false);
+        self.observe_recovery(path, false, true, false)
+    }
+    fn prepare_route_observation(&self, path: &str) -> u8 {
+        let _ = self.observe_path_orchestration(path);
+        let dummy_uri = http::Uri::from_static("/");
+        let _ = self.rewrite_uri_path(&dummy_uri, path);
+        let _ = self.observe_response_headers();
+        let _ = self.observe_recovery(path, false, true, false);
+        self.summarize_path_orchestration()
+    }
