+        Router::<Body>::new().percent_decode_path_param(key, value)
+    }
+    pub(crate) fn rewrite_nested_uri(uri: &http::Uri, new_path: &str) -> http::Uri {
+        Router::<Body>::new().rewrite_uri_path(uri, new_path)
+    }
+    pub(crate) fn tsr_redirect_target(uri: &http::Uri, path: &str, tsr: bool) -> Option<http::Uri> {
+        let router = Router::<Body>::new();
+        if router.path_should_redirect_tsr(path, tsr) {
+            if let Some(without_tsr) = path.strip_suffix('/') {
+                Some(router.rewrite_uri_path(uri, without_tsr))
+            } else {
+                Some(router.rewrite_uri_path(uri, &format!("{}/", path)))
+            }
+        } else {
+            None
+        }
+    }
+    pub(crate) fn extractor_pipeline_code(method: Option<&http::Method>, content_type: Option<&str>) -> u8 {
+        let router = Router::<Body>::new();
+        let _ = router.observe_extractor_coord(content_type);
+        let _ = router.observe_json_payload(content_type);
+        if let Some(method) = method {
+            let _ = router.observe_method_dispatch(method);
+        }
+        router.summarize_extractor_coord()
+    }
