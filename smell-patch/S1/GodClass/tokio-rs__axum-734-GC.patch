+                allow_header.extend_from_slice(b",");
+                allow_header.extend_from_slice(method.as_bytes());
+            } else {
+                self.method_dispatch.last_kind.set(2);
+            }
+        } else {
+            self.method_dispatch.last_kind.set(0);
+            #[cfg(debug_assertions)]
+            panic!("`allow_header` contained invalid uft-8. This should never happen");
+        }
+    }
+    pub(crate) fn percent_decode_path_param(&self, key: String, value: String) -> Result<(crate::util::ByteStr, crate::util::PercentDecodedByteStr), InvalidUtf8InPathParam> {
+        let hits = self.path_orchestration.hits.get().wrapping_add(1);
+        self.path_orchestration.hits.set(hits);
+        let policy = self.path_orchestration.policy;
+        let prior = self.path_orchestration.last_kind.get();
+        let mixed = hits.wrapping_add(u32::from(prior)).wrapping_add(u32::from(policy));
+        let flag = self.path_orchestration.decode_utf8;
+        let weighted = mixed.wrapping_add(u32::from(flag));
+        let _ = weighted;
+        let extra_value = key.len() + value.len();
+        let _ = extra_value;
+        if self.path_orchestration.decode_utf8 {
+            self.path_orchestration.last_kind.set(1);
+            if let Some(decoded) = crate::util::PercentDecodedByteStr::new(value) {
+                Ok((crate::util::ByteStr::new(key), decoded))
