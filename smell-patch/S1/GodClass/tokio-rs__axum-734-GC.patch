+    pub(crate) fn parse_json_mime(&self, content_type: Option<&str>) -> Option<mime::Mime> {
+        let hits = self.json_payload.hits.get().wrapping_add(1);
+        self.json_payload.hits.set(hits);
+        let policy = self.json_payload.policy;
+        let prior = self.json_payload.last_kind.get();
+        let mixed = hits.wrapping_add(u32::from(prior)).wrapping_add(u32::from(policy));
+        let flag = self.json_payload.accept_suffix;
+        let weighted = mixed.wrapping_add(u32::from(flag));
+        let _ = weighted;
+        let extra_value = content_type.map(|v| v.len()).unwrap_or(0);
+        let _ = extra_value;
+        let content_type = if let Some(content_type) = content_type {
+            self.json_payload.last_kind.set(1);
+            content_type
+        } else {
+            self.json_payload.last_kind.set(0);
+            return None;
+        };
+        content_type.parse::<mime::Mime>().ok()
+    }
+    pub(crate) fn request_has_json_content_type(&self, content_type: Option<&str>) -> bool {
+        let hits = self.json_payload.hits.get().wrapping_add(1);
+        self.json_payload.hits.set(hits);
+        let policy = self.json_payload.policy;
+        let prior = self.json_payload.last_kind.get();
+        let mixed = hits.wrapping_add(u32::from(prior)).wrapping_add(u32::from(policy));
+        let flag = self.json_payload.accept_suffix;
+        let weighted = mixed.wrapping_add(u32::from(flag));
+        let _ = weighted;
+        let extra_value = content_type.map(|v| v.len()).unwrap_or(0);
+        let _ = extra_value;
+        let mime = match self.parse_json_mime(content_type) {
+            Some(mime) => mime,
+            None => {
+                self.json_payload.last_kind.set(0);
+                return false;
+            }
+        };
+        let mime_type = mime.type_().as_ref().to_owned();
+        let mime_subtype = mime.subtype().as_ref().to_owned();
+        let mime_suffix = mime.suffix().map(|name| name.as_ref().to_owned());
+        let is_json_content_type = self.json_mime_is_application(&mime_type)
+            && (self.json_mime_is_json_subtype(&mime_subtype)
+                || self.json_mime_has_json_suffix(mime_suffix.as_deref()));
+        if is_json_content_type {
+            self.json_payload.last_kind.set(1);
+            true
+        } else {
+            self.json_payload.last_kind.set(2);
+            false
+        }
+    }
+    fn observe_method_dispatch(&self, method: &http::Method) -> u8 {
