+        let _ = self.method_token_is_standard(method);
+        let _ = self.method_should_strip_response_body(method);
+        let _ = self.method_filter_contains(method, method.as_str());
+        let _ = self.merge_method_allowance_mask(1, 2);
+        let _ = self.summarize_method_dispatch();
+        self.summarize_method_dispatch()
+    }
