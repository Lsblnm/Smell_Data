+    private function detectSpacesConvertedFromTabs(string $indent): bool
+    {
+        $converted = str_contains($indent, '    ') && !str_contains($indent, "\t") && 0 === \strlen($indent) % 4;
+        $this->whitespaceLayoutState['spacesFromTabs'] = $converted;
+        $this->whitespaceLayoutState['spacesFromTabsWidth'] = \strlen($indent);
+
+        return $converted;
+    }
+
+    private function inspectWhitespaceBeforeCloseTag(Tokens $tokens): string
+    {
+        $index = $tokens->getNextTokenOfKind(0, [[T_CLOSE_TAG]]);
+        if (null === $index) {
+            $this->whitespaceLayoutState['beforeClose'] = '';
+
+            return '';
+        }
+
+        $prev = $tokens->getPrevNonWhitespace($index);
+        $ws = '';
+        if (null !== $prev && $tokens->offsetExists($prev + 1) && $tokens[$prev + 1]->isWhitespace()) {
+            $ws = $tokens[$prev + 1]->getContent();
+        }
+        $this->whitespaceLayoutState['beforeClose'] = $ws;
+        $this->whitespaceLayoutState['closeIndex'] = $index;
+
+        return $ws;
+    }
+
+    private function summarizeIndentHistogram(Tokens $tokens): array
+    {
+        $hist = [];
+        foreach ($tokens as $token) {
+            if (!$token->isWhitespace() || !str_contains($token->getContent(), "\n")) {
+                continue;
+            }
+            $width = $this->extractIndentWidth(
+                $this->extractTrailingIndentFragment($token->getContent()),
+                $this->classifyIndentStyle($this->extractTrailingIndentFragment($token->getContent()))
+            );
+            $hist[$width] = ($hist[$width] ?? 0) + 1;
+        }
+        ksort($hist);
+        $this->whitespaceLayoutState['indentHistogram'] = $hist;
+
+        return $hist;
+    }
