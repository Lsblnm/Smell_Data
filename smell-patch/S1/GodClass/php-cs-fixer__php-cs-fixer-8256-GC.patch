+        foreach ($tokens as $token) {
+            if ($token->equalsAny(['=', [T_PLUS_EQUAL], [T_MINUS_EQUAL], [T_MUL_EQUAL], [T_DIV_EQUAL], [T_CONCAT_EQUAL]])) {
+                ++$assign;
+            } elseif ($token->equalsAny(['==', '===', '!=', '<>', '!==', '<', '>', '<=', '>=', [T_IS_EQUAL], [T_IS_IDENTICAL], [T_IS_NOT_EQUAL], [T_IS_NOT_IDENTICAL], [T_IS_SMALLER_OR_EQUAL], [T_IS_GREATER_OR_EQUAL]])) {
+                ++$compare;
+            } elseif ($token->equalsAny(['&&', '||', [T_BOOLEAN_AND], [T_BOOLEAN_OR], [T_LOGICAL_AND], [T_LOGICAL_OR], [T_LOGICAL_XOR]])) {
+                ++$logic;
+            } elseif ($token->equals('.')) {
+                ++$concat;
+            }
+        }
+
+        return ['assign' => $assign, 'compare' => $compare, 'logic' => $logic, 'concat' => $concat];
+    }
