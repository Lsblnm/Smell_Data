+    private function collectNamespaceNames(Tokens $tokens): array
+    {
+        $names = [];
+        $index = 0;
+        $limit = \count($tokens);
+        while ($index < $limit) {
+            $ns = $tokens->getNextTokenOfKind($index, [[T_NAMESPACE]]);
+            if (null === $ns) {
+                break;
+            }
+
+            $cursor = $tokens->getNextMeaningfulToken($ns);
+            $parts = [];
+            while (null !== $cursor && $tokens[$cursor]->isGivenKind([T_STRING, T_NS_SEPARATOR, T_NAME_QUALIFIED, T_NAME_FULLY_QUALIFIED, T_NAME_RELATIVE])) {
+                $parts[] = $tokens[$cursor]->getContent();
+                $cursor = $tokens->getNextMeaningfulToken($cursor);
+                if (null === $cursor) {
+                    break;
+                }
+                if ($tokens[$cursor]->equalsAny([';', '{'])) {
+                    break;
+                }
+            }
+            $names[] = '' === implode('', $parts) ? 'global' : implode('', $parts);
+            $index = $ns + 1;
+        }
+
+        return $names;
+    }
+
+    private function collectClassNames(Tokens $tokens): array
+    {
+        $names = [];
+        $limit = \count($tokens);
+        for ($index = 0; $index < $limit; ++$index) {
+            if (!$tokens[$index]->isClassy()) {
+                continue;
+            }
+
+            $nameIndex = $tokens->getNextMeaningfulToken($index);
+            if (null === $nameIndex) {
+                continue;
+            }
+            if ($tokens[$nameIndex]->equals('(')) {
+                $names[] = 'anonymous';
+                continue;
+            }
+            if ($tokens[$nameIndex]->isGivenKind(T_STRING)) {
+                $names[] = $tokens[$nameIndex]->getContent();
+            }
+        }
+
+        return $names;
+    }
