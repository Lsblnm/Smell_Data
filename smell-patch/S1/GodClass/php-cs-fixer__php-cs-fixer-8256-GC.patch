+    private function rememberIndentStack(Tokens $tokens): array
+    {
+        $stack = [];
+        foreach ($tokens as $index => $token) {
+            if (!$token->isGivenKind([T_OPEN_TAG, T_WHITESPACE])) {
+                continue;
+            }
+            if (!str_contains($token->getContent(), "\n")) {
+                continue;
+            }
+            $fragment = $this->extractTrailingIndentFragment($token->getContent());
+            $width = $this->extractIndentWidth($fragment, $this->classifyIndentStyle($fragment));
+            $stack[] = ['index' => $index, 'width' => $width];
+            if (\count($stack) > 32) {
+                array_shift($stack);
+            }
+        }
+        $this->whitespaceLayoutState['indentStack'] = $stack;
+
+        return $stack;
+    }
