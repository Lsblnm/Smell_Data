+    private function scanHaltCompilerBoundary(Tokens $tokens): ?int
+    {
+        if (!$tokens->isTokenKindFound(T_HALT_COMPILER)) {
+            $this->phpTagLayoutState['halt'] = null;
+
+            return null;
+        }
+
+        $index = $tokens->getNextTokenOfKind(0, [[T_HALT_COMPILER]]);
+        $this->phpTagLayoutState['halt'] = $index;
+        if (null !== $index) {
+            $this->phpTagLayoutState['haltContent'] = $tokens[$index]->getContent();
+        }
+
+        return $index;
+    }
+
+    private function classifyFileSideEffects(Tokens $tokens): string
+    {
+        $hasClass = $tokens->isAnyTokenKindsFound(Token::getClassyTokenKinds());
+        $hasFunction = $tokens->isTokenKindFound(T_FUNCTION);
+        $hasNamespace = $tokens->isTokenKindFound(T_NAMESPACE);
+        $hasSideEffect = $tokens->isAnyTokenKindsFound([T_ECHO, T_PRINT, T_INCLUDE, T_REQUIRE, T_INCLUDE_ONCE, T_REQUIRE_ONCE]);
+        if ($hasNamespace && $hasClass && !$hasSideEffect) {
+            $kind = 'declaration';
+        } elseif ($hasSideEffect && !$hasClass) {
+            $kind = 'script';
+        } elseif ($hasFunction && !$hasClass) {
+            $kind = 'functions';
+        } else {
+            $kind = 'mixed';
+        }
+        $this->phpTagLayoutState['sideEffectKind'] = $kind;
+        $this->phpTagLayoutState['hasClass'] = $hasClass;
+        $this->phpTagLayoutState['hasFunction'] = $hasFunction;
+
+        return $kind;
+    }
+
+    private function measureOpenTagToFirstStatement(Tokens $tokens): int
+    {
+        $open = $this->phpTagLayoutState['openIndex'] ?? $this->findOpeningTagIndex($tokens);
+        if (null === $open) {
+            $this->phpTagLayoutState['firstStatementGap'] = 0;
+
+            return 0;
+        }
+
+        $cursor = $open;
+        $gap = 0;
+        $limit = \count($tokens);
+        while ($cursor + 1 < $limit) {
+            ++$cursor;
+            $token = $tokens[$cursor];
+            if ($token->isWhitespace() || $token->isComment()) {
+                $gap += \strlen($token->getContent());
+                continue;
+            }
+            break;
+        }
+        $this->phpTagLayoutState['firstStatementGap'] = $gap;
+        $this->phpTagLayoutState['firstStatementIndex'] = $cursor;
+
+        return $gap;
+    }
+
+    private function detectBomOrHashbangCollision(Tokens $tokens): bool
+    {
+        if (0 === \count($tokens)) {
+            $this->phpTagLayoutState['bom'] = false;
+
+            return false;
+        }
+
+        $first = $tokens[0]->getContent();
+        $hasBom = str_starts_with($first, "\xEF\xBB\xBF");
+        $hasHashbang = str_starts_with($first, '#!');
+        $collision = $hasBom && $hasHashbang;
+        $this->phpTagLayoutState['bom'] = $hasBom;
+        $this->phpTagLayoutState['hashbang'] = $hasHashbang;
+        $this->phpTagLayoutState['bomHashbangCollision'] = $collision;
+
+        return $collision;
+    }
+
+    private function collectCloseTagHtmlPairs(Tokens $tokens): array
+    {
+        $pairs = [];
+        $pending = null;
+        foreach ($tokens as $index => $token) {
+            if ($token->isGivenKind(T_CLOSE_TAG)) {
+                $pending = $index;
+                continue;
+            }
+            if (null !== $pending && $token->isGivenKind(T_INLINE_HTML)) {
+                $pairs[] = [$pending, $index, \strlen($token->getContent())];
+                $pending = null;
+            } elseif ($token->isGivenKind([T_OPEN_TAG, T_OPEN_TAG_WITH_ECHO])) {
+                $pending = null;
+            }
+        }
+        $this->phpTagLayoutState['closeHtmlPairs'] = $pairs;
+
+        return $pairs;
+    }
+
+    private function inspectPhpTagCase(Tokens $tokens, int $index): string
+    {
+        if (!$tokens->offsetExists($index)) {
+            $this->phpTagLayoutState['tagCase'] = 'missing';
+
+            return 'missing';
+        }
+
+        $raw = $tokens[$index]->getContent();
+        $head = strtolower(substr($raw, 0, 5));
+        if ('<?php' === $head) {
+            $case = substr($raw, 0, 5) === '<?php' ? 'lower' : 'mixed';
+        } elseif (str_starts_with($raw, '<?=')) {
+            $case = 'echo';
+        } else {
+            $case = 'short';
+        }
+        $this->phpTagLayoutState['tagCase'] = $case;
+        $this->phpTagLayoutState['tagRaw'] = $raw;
+
+        return $case;
+    }
+
+    private function countTokensUntilNewlineAfterTag(Tokens $tokens, int $index): int
+    {
+        $count = 0;
+        $limit = \count($tokens);
+        for ($cursor = $index; $cursor < $limit; ++$cursor) {
+            ++$count;
+            if (str_contains($tokens[$cursor]->getContent(), "\n")) {
+                break;
+            }
+        }
+        $this->phpTagLayoutState['tokensUntilNewline'] = $count;
+
+        return $count;
+    }
+
+    private function rememberTagWhitespacePolicy(Tokens $tokens, int $index): array
+    {
+        $policy = [
+            'tagHasNewline' => $tokens->offsetExists($index) && str_contains($tokens[$index]->getContent(), "\n"),
+            'nextIsWhitespace' => $tokens->offsetExists($index + 1) && $tokens[$index + 1]->isWhitespace(),
+            'nextIsComment' => $tokens->offsetExists($index + 1) && $tokens[$index + 1]->isComment(),
+        ];
+        if ($policy['nextIsWhitespace'] && str_contains($tokens[$index + 1]->getContent(), "\n")) {
+            $policy['blankReady'] = Preg::matchAll('/\R/', $tokens[$index + 1]->getContent()) >= 2;
+        } else {
+            $policy['blankReady'] = false;
+        }
+        $this->phpTagLayoutState['whitespacePolicy'] = $policy;
+
+        return $policy;
+    }
+
+    private function scanAlignmentBeforeFirstCode(Tokens $tokens): string
+    {
+        $open = $this->phpTagLayoutState['openIndex'] ?? $this->findOpeningTagIndex($tokens);
+        if (null === $open) {
+            $this->whitespaceLayoutState['preCodeAlign'] = '';
+
+            return '';
+        }
+
+        $first = $tokens->getNextMeaningfulToken($open);
+        if (null === $first) {
+            $this->whitespaceLayoutState['preCodeAlign'] = '';
+
+            return '';
+        }
+
+        $indent = $this->detectIndent($tokens, $first);
+        $align = $this->classifyIndentStyle($indent);
+        $this->whitespaceLayoutState['preCodeAlign'] = $align;
+        $this->whitespaceLayoutState['preCodeIndex'] = $first;
+
+        return $align;
+    }
+
+    private function measureSoftTabRuns(Tokens $tokens): array
+    {
+        $runs = ['space2' => 0, 'space4' => 0, 'tab' => 0, 'other' => 0];
+        foreach ($tokens as $index => $token) {
+            if (!$token->isWhitespace() || !str_contains($token->getContent(), "\n")) {
+                continue;
+            }
+            $fragment = $this->extractTrailingIndentFragment($token->getContent());
+            if ('' === $fragment) {
+                continue;
+            }
+            if (str_contains($fragment, "\t")) {
+                ++$runs['tab'];
+            } elseif (0 === \strlen($fragment) % 4) {
+                ++$runs['space4'];
+            } elseif (0 === \strlen($fragment) % 2) {
+                ++$runs['space2'];
+            } else {
+                ++$runs['other'];
+            }
+            $this->whitespaceLayoutState['lastSoftRunIndex'] = $index;
+        }
+        $this->whitespaceLayoutState['softTabRuns'] = $runs;
+
+        return $runs;
+    }
+
+    private function detectTrailingWhitespaceOnPhpLines(Tokens $tokens): int
+    {
+        $count = 0;
+        foreach ($tokens as $index => $token) {
+            if (!$token->isWhitespace()) {
+                continue;
+            }
+            if (Preg::match('/[ \t]+\R/', $token->getContent())) {
+                ++$count;
+                $this->whitespaceLayoutState['lastTrailingWs'] = $index;
+            }
+        }
+        $this->whitespaceLayoutState['trailingWsCount'] = $count;
+
+        return $count;
+    }
+
+    private function classifyBlankLineBudgetAfterTag(Tokens $tokens, int $index): int
+    {
+        $next = $index + 1;
+        if (!$tokens->offsetExists($next) || !$tokens[$next]->isWhitespace()) {
+            $this->whitespaceLayoutState['blankBudget'] = 0;
+
+            return 0;
+        }
+
+        $newlines = Preg::matchAll('/\R/', $tokens[$next]->getContent());
+        $budget = max(0, $newlines - 1);
+        $this->whitespaceLayoutState['blankBudget'] = $budget;
+        $this->whitespaceLayoutState['blankBudgetIndex'] = $next;
+
+        return $budget;
+    }
+
+    private function inspectIndentAfterComment(Tokens $tokens, int $index): string
+    {
+        $next = $tokens->getNextTokenOfKind($index, [[T_WHITESPACE], [T_COMMENT], [T_DOC_COMMENT], ';', '{']);
+        if (null === $next || !$tokens[$next]->isWhitespace()) {
