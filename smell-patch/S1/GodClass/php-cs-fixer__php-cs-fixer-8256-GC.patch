+    private function scanMixedLineEndings(Tokens $tokens): bool
+    {
+        $lf = false;
+        $crlf = false;
+        foreach ($tokens as $token) {
+            $content = $token->getContent();
+            if (str_contains($content, "\r\n")) {
+                $crlf = true;
+            }
+            if (str_contains($content, "\n") && !str_contains($content, "\r\n")) {
+                $lf = true;
+            }
+            if ($lf && $crlf) {
+                break;
+            }
+        }
+        $mixed = $lf && $crlf;
+        $this->whitespaceLayoutState['mixedLineEndings'] = $mixed;
+        $this->whitespaceLayoutState['hasLf'] = $lf;
+        $this->whitespaceLayoutState['hasCrlf'] = $crlf;
+
+        return $mixed;
+    }
