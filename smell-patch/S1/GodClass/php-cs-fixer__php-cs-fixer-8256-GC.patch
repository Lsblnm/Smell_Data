+                continue;
+            }
+            if (Preg::matchAll('/@author\s+(.+)$/m', $token->getContent(), $matches)) {
+                foreach ($matches[1] as $author) {
+                    $authors[] = trim($author);
+                }
+                $this->commentLayoutState['lastAuthorIndex'] = $index;
+            }
+        }
+        $this->commentLayoutState['authors'] = $authors;
+
+        return $authors;
+    }
+
+    private function collectCopyrightHeaders(Tokens $tokens): array
+    {
+        $headers = [];
+        foreach ($tokens as $index => $token) {
+            if (!$token->isGivenKind([T_COMMENT, T_DOC_COMMENT])) {
+                continue;
+            }
+            if (Preg::match('/@copyright\s+(.+)/i', $token->getContent(), $match)) {
+                $headers[] = ['index' => $index, 'value' => trim($match[1])];
+            } elseif (Preg::match('/copyright/i', $token->getContent())) {
+                $headers[] = ['index' => $index, 'value' => 'unstructured'];
+            }
+        }
+        $this->commentLayoutState['copyrights'] = $headers;
+
+        return $headers;
+    }
