+    private function scanStrictTypesAfterOpenTag(Tokens $tokens): bool
+    {
+        $open = $this->phpTagLayoutState['openIndex'] ?? $this->findOpeningTagIndex($tokens);
+        if (null === $open) {
+            $this->phpTagLayoutState['strictTypes'] = false;
+
+            return false;
+        }
+
+        $declare = $tokens->getNextMeaningfulToken($open);
+        if (null === $declare || !$tokens[$declare]->isGivenKind(T_DECLARE)) {
+            $this->phpTagLayoutState['strictTypes'] = false;
+
+            return false;
+        }
+
+        $end = $tokens->getNextTokenOfKind($declare, [';', [T_CLOSE_TAG]]);
+        if (null === $end) {
+            $this->phpTagLayoutState['strictTypes'] = false;
+
+            return false;
+        }
+
+        $fragment = $tokens->generatePartialCode($declare, $end);
+        $enabled = Preg::match('/strict_types\s*=\s*1/', $fragment) > 0;
+        $this->phpTagLayoutState['strictTypes'] = $enabled;
+        $this->phpTagLayoutState['declareFragment'] = $fragment;
+
+        return $enabled;
+    }
