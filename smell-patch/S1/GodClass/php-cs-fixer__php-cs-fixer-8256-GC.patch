+    private function scanHtmlResidueAfterCloseTag(Tokens $tokens): int
+    {
+        $bytes = 0;
+        $seenClose = false;
+        foreach ($tokens as $index => $token) {
+            if ($token->isGivenKind(T_CLOSE_TAG)) {
+                $seenClose = true;
+                $this->phpTagLayoutState['lastClose'] = $index;
+                continue;
+            }
+            if (!$seenClose) {
+                continue;
+            }
+            if ($token->isGivenKind(T_INLINE_HTML)) {
+                $bytes += \strlen($token->getContent());
+            } elseif ($token->isGivenKind([T_OPEN_TAG, T_OPEN_TAG_WITH_ECHO])) {
+                $seenClose = false;
+            }
+        }
+        $this->phpTagLayoutState['htmlResidue'] = $bytes;
+
+        return $bytes;
+    }
