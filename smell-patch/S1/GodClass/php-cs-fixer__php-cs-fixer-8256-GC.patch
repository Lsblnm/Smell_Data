+    private function collectBraceBalance(Tokens $tokens): array
+    {
+        $round = 0;
+        $curly = 0;
+        $square = 0;
+        $minRound = 0;
+        $minCurly = 0;
+        $minSquare = 0;
+        foreach ($tokens as $token) {
+            $content = $token->getContent();
+            if ('(' === $content) {
+                ++$round;
+            } elseif (')' === $content) {
+                --$round;
+                $minRound = min($minRound, $round);
+            } elseif ('{' === $content) {
+                ++$curly;
+            } elseif ('}' === $content) {
+                --$curly;
+                $minCurly = min($minCurly, $curly);
+            } elseif ('[' === $content) {
+                ++$square;
+            } elseif (']' === $content) {
+                --$square;
+                $minSquare = min($minSquare, $square);
+            }
+        }
+
+        return [
+            'round' => $round,
+            'curly' => $curly,
+            'square' => $square,
+            'underflow' => $minRound < 0 || $minCurly < 0 || $minSquare < 0,
+        ];
+    }
