+        $indent = $this->extractTrailingIndentFragment($tokens[$next]->getContent());
+        $this->whitespaceLayoutState['afterCommentIndent'] = $indent;
+        $this->whitespaceLayoutState['afterCommentStyle'] = $this->classifyIndentStyle($indent);
