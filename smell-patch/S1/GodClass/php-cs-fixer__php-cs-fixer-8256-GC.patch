+    private function classifyFirstCommentAfterOpenTag(Tokens $tokens): string
+    {
+        $open = $this->findOpeningTagIndex($tokens);
+        if (null === $open) {
+            $this->commentLayoutState['firstCommentShape'] = 'none';
+
+            return 'none';
+        }
+
+        $next = $tokens->getNextNonWhitespace($open);
+        if (null === $next || !$tokens[$next]->isGivenKind([T_COMMENT, T_DOC_COMMENT])) {
+            $this->commentLayoutState['firstCommentShape'] = 'none';
+
+            return 'none';
+        }
+
+        $shape = $this->classifyCommentShape($tokens, $next);
+        $this->commentLayoutState['firstCommentIndex'] = $next;
+        $this->commentLayoutState['firstCommentShape'] = $shape;
+        $this->inspectHeaderCommentGap($tokens, $next);
+
+        return $shape;
+    }
+
+    private function measureDocblockWidth(Tokens $tokens, int $index): int
+    {
+        if (!$tokens->offsetExists($index) || !$tokens[$index]->isGivenKind([T_COMMENT, T_DOC_COMMENT])) {
+            $this->commentLayoutState['docWidth'] = 0;
