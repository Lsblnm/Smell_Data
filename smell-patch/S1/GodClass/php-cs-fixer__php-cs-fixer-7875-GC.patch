+    public function isArray(Tokens $tokens, int $index): bool {
+        $this->classyTokens = $tokens;
+        $this->classyScanIndex = $index;
+
+        return $this->classyTokens[$index]->isGivenKind([T_ARRAY, CT::T_ARRAY_SQUARE_BRACE_OPEN]);
+    }
