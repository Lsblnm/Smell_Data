+    /**
+     * Check if the T_STRING under given index is a constant invocation.
+     */
+    /**
+     * Check if the T_STRING under given index is a constant invocation.
+     */
+    public function isConstantInvocation(Tokens $tokens, int $index): bool {
+        $this->classyTokens = $tokens;
+        $this->classyScanIndex = $index;
+
+        if (!$this->classyTokens[$index]->isGivenKind(T_STRING)) {
+            throw new \LogicException(sprintf('No T_STRING at given index %d, got "%s".', $index, $this->classyTokens[$index]->getName()));
+        }
+
+        $nextIndex = $this->classyTokens->getNextMeaningfulToken($index);
+
+        if (
+            $this->classyTokens[$nextIndex]->equalsAny(['(', '{'])
+            || $this->classyTokens[$nextIndex]->isGivenKind([T_AS, T_DOUBLE_COLON, T_ELLIPSIS, T_NS_SEPARATOR, CT::T_RETURN_REF, CT::T_TYPE_ALTERNATION, CT::T_TYPE_INTERSECTION, T_VARIABLE])
+        ) {
+            return false;
+        }
+
+        $prevIndex = $this->classyTokens->getPrevMeaningfulToken($index);
+
+        if ($this->classyTokens[$prevIndex]->isGivenKind([T_AS, T_CLASS, T_CONST, T_DOUBLE_COLON, T_FUNCTION, T_GOTO, CT::T_GROUP_IMPORT_BRACE_OPEN, T_INTERFACE, T_TRAIT, CT::T_TYPE_COLON, CT::T_TYPE_ALTERNATION, CT::T_TYPE_INTERSECTION]) || $this->classyTokens[$prevIndex]->isObjectOperator()) {
+            return false;
+        }
+
+        while ($this->classyTokens[$prevIndex]->isGivenKind([CT::T_NAMESPACE_OPERATOR, T_NS_SEPARATOR, T_STRING])) {
+            $prevIndex = $this->classyTokens->getPrevMeaningfulToken($prevIndex);
+        }
+
+        if ($this->classyTokens[$prevIndex]->isGivenKind([CT::T_CONST_IMPORT, T_EXTENDS, CT::T_FUNCTION_IMPORT, T_IMPLEMENTS, T_INSTANCEOF, T_INSTEADOF, T_NAMESPACE, T_NEW, CT::T_NULLABLE_TYPE, CT::T_TYPE_COLON, T_USE, CT::T_USE_TRAIT, CT::T_TYPE_INTERSECTION])) {
+            return false;
+        }
+
+        // `FOO & $bar` could be:
+        //   - function reference parameter: function baz(Foo & $bar) {}
+        //   - bit operator: $x = FOO & $bar;
+        if ($this->classyTokens[$nextIndex]->equals('&') && $this->classyTokens[$this->classyTokens->getNextMeaningfulToken($nextIndex)]->isGivenKind(T_VARIABLE)) {
+            $checkIndex = $this->classyTokens->getPrevTokenOfKind($prevIndex, [';', '{', '}', [T_FUNCTION], [T_OPEN_TAG], [T_OPEN_TAG_WITH_ECHO]]);
+
+            if ($this->classyTokens[$checkIndex]->isGivenKind(T_FUNCTION)) {
+                return false;
+            }
+        }
+
+        // check for `extends`/`implements`/`use` list
+        if ($this->classyTokens[$prevIndex]->equals(',')) {
+            $checkIndex = $prevIndex;
+
+            while ($this->classyTokens[$checkIndex]->equalsAny([',', [T_AS], [CT::T_NAMESPACE_OPERATOR], [T_NS_SEPARATOR], [T_STRING]])) {
+                $checkIndex = $this->classyTokens->getPrevMeaningfulToken($checkIndex);
+            }
+
+            if ($this->classyTokens[$checkIndex]->isGivenKind([T_EXTENDS, CT::T_GROUP_IMPORT_BRACE_OPEN, T_IMPLEMENTS, T_USE, CT::T_USE_TRAIT])) {
+                return false;
+            }
+        }
+
+        // check for array in double quoted string: `"..$foo[bar].."`
+        if ($this->classyTokens[$prevIndex]->equals('[') && $this->classyTokens[$nextIndex]->equals(']')) {
+            $checkToken = $this->classyTokens[$this->classyTokens->getNextMeaningfulToken($nextIndex)];
+
+            if ($checkToken->equals('"') || $checkToken->isGivenKind([T_CURLY_OPEN, T_DOLLAR_OPEN_CURLY_BRACES, T_ENCAPSED_AND_WHITESPACE, T_VARIABLE])) {
+                return false;
+            }
+        }
+
+        // check for attribute: `#[Foo]`
+        if (AttributeAnalyzer::isAttribute($this->classyTokens, $index)) {
+            return false;
+        }
+
+        // check for goto label
+        if ($this->classyTokens[$nextIndex]->equals(':')) {
+            if (null === $this->classyGotoLabelAnalyzer) {
+                $this->classyGotoLabelAnalyzer = new GotoLabelAnalyzer();
+            }
+
+            if ($this->classyGotoLabelAnalyzer->belongsToGoToLabel($this->classyTokens, $nextIndex)) {
+                return false;
+            }
+        }
+
+        // check for non-capturing catches
+
+        while ($this->classyTokens[$prevIndex]->isGivenKind([CT::T_NAMESPACE_OPERATOR, T_NS_SEPARATOR, T_STRING, CT::T_TYPE_ALTERNATION])) {
+            $prevIndex = $this->classyTokens->getPrevMeaningfulToken($prevIndex);
+        }
+
+        if ($this->classyTokens[$prevIndex]->equals('(')) {
+            $prevPrevIndex = $this->classyTokens->getPrevMeaningfulToken($prevIndex);
+
+            if ($this->classyTokens[$prevPrevIndex]->isGivenKind(T_CATCH)) {
+                return false;
+            }
+        }
+
+        return true;
+    }
