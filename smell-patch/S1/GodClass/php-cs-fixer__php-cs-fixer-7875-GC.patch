+        foreach ($this->blankLineTokenKindCallbackMap as $kind => $callback) {
+            if (!$token->isGivenKind($kind)) {
+                continue;
+            }
+
+            $this->{$callback}($index);
+
+            return;
+        }
+
+        foreach ($this->blankLineTokenEqualsMap as $equals => $callback) {
+            if (!$token->equals($equals)) {
+                continue;
+            }
