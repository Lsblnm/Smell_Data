+        for ($i = $index - 1; $i > 0; --$i) {
+            if ($this->blankLineTokens[$i]->isGivenKind(T_FUNCTION) && $this->blankLineTokensAnalyzer->isLambda($i)) {
+                return;
+            }
+
+            if ($this->blankLineTokens[$i]->isGivenKind(T_CLASS) && $this->blankLineTokensAnalyzer->isAnonymousClass($i)) {
+                return;
+            }
+
+            if ($this->blankLineTokens[$i]->isWhitespace() && str_contains($this->blankLineTokens[$i]->getContent(), "\n")) {
+                break;
+            }
+        }
