+        for ($end = $index; $end < $tokenCount; ++$end) {
+            if ($this->blankLineTokens[$end]->equals('(')) {
+                ++$parenthesesDepth;
+
+                continue;
+            }
+
+            if ($this->blankLineTokens[$end]->equals(')')) {
+                --$parenthesesDepth;
+                if ($parenthesesDepth < 0) {
+                    return;
+                }
+
+                continue;
+            }
+
+            if (
+                $this->blankLineTokens[$end]->equals('}')
+                || str_contains($this->blankLineTokens[$end]->getContent(), "\n")
+            ) {
+                break;
+            }
+        }
+
+        if ($end === $tokenCount) {
+            return; // not found, early return
+        }
