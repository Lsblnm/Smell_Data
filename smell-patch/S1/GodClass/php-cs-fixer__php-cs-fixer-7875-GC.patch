+        $bodyEnd = $this->blankLineTokens->findBlockEnd($blockTypeInfo['type'], $index);
+
+        for ($i = $bodyEnd - 1; $i >= $index; --$i) {
+            if (str_contains($this->blankLineTokens[$i]->getContent(), "\n")) {
