+        $ending = $this->whitespacesConfig->getLineEnding();
+
+        for ($i = $end; $i < $tokenCount && $this->blankLineTokens[$i]->isWhitespace(); ++$i) {
+            $content = $this->blankLineTokens[$i]->getContent();
+
+            if (substr_count($content, "\n") < 1) {
