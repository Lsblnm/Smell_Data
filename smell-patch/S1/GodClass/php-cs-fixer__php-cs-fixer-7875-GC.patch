+            if ('expression' !== $scopes[$currentScope]['type']) {
+                $endIndex = $this->findArrayExpressionEndIndex($tokens, $index, $scopes[$currentScope]['end_index']);
+
+                if ($endIndex === $index) {
+                    continue;
+                }
+
+                $scopes[] = [
+                    'type' => 'expression',
+                    'end_index' => $endIndex,
+                    'initial_indent' => $previousLineInitialIndent,
+                    'new_indent' => $previousLineNewIndent,
+                ];
+            }
+        }
+    }
