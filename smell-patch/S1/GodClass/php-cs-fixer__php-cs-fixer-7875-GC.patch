+    /**
+     * @param int $index Index of the T_FUNCTION token
+     *
+     * @return array{visibility: null|T_PRIVATE|T_PROTECTED|T_PUBLIC, static: bool, abstract: bool, final: bool}
+     */
+    /**
+     * @param int $index Index of the T_FUNCTION token
+     *
+     * @return array{visibility: null|T_PRIVATE|T_PROTECTED|T_PUBLIC, static: bool, abstract: bool, final: bool}
+     */
+    public function getMethodAttributes(Tokens $tokens, int $index): array {
+        $this->classyTokens = $tokens;
+        $this->classyScanIndex = $index;
+
+        if (!$this->classyTokens[$index]->isGivenKind(T_FUNCTION)) {
+            throw new \LogicException(sprintf('No T_FUNCTION at given index %d, got "%s".', $index, $this->classyTokens[$index]->getName()));
+        }
+
+        $attributes = [
+            'visibility' => null,
+            'static' => false,
+            'abstract' => false,
+            'final' => false,
+        ];
+
+        for ($i = $index; $i >= 0; --$i) {
+            $i = $this->classyTokens->getPrevMeaningfulToken($i);
+            $token = $this->classyTokens[$i];
+
+            if ($token->isGivenKind(T_STATIC)) {
+                $attributes['static'] = true;
+
+                continue;
+            }
+
+            if ($token->isGivenKind(T_FINAL)) {
+                $attributes['final'] = true;
+
+                continue;
+            }
+
+            if ($token->isGivenKind(T_ABSTRACT)) {
+                $attributes['abstract'] = true;
+
+                continue;
+            }
+
+            // visibility
+
+            if ($token->isGivenKind(T_PRIVATE)) {
+                $attributes['visibility'] = T_PRIVATE;
+
+                continue;
+            }
+
+            if ($token->isGivenKind(T_PROTECTED)) {
+                $attributes['visibility'] = T_PROTECTED;
+
+                continue;
+            }
+
+            if ($token->isGivenKind(T_PUBLIC)) {
+                $attributes['visibility'] = T_PUBLIC;
+
+                continue;
+            }
+
+            // found a meaningful token that is not part of
+            // the function signature; stop looking
+            break;
+        }
+
+        return $attributes;
+    }
+
+    /**
+     * Check if there is an anonymous class under given index.
+     */
+    /**
+     * Check if there is an anonymous class under given index.
+     */
+    public function isAnonymousClass(Tokens $tokens, int $index): bool {
+        $this->classyTokens = $tokens;
+        $this->classyScanIndex = $index;
+
+        if (!$this->classyTokens[$index]->isClassy()) {
+            throw new \LogicException(sprintf('No classy token at given index %d.', $index));
+        }
+
+        if (!$this->classyTokens[$index]->isGivenKind(T_CLASS)) {
+            return false;
+        }
+
+        $index = $this->classyTokens->getPrevMeaningfulToken($index);
+
+        if (\defined('T_READONLY') && $this->classyTokens[$index]->isGivenKind(T_READONLY)) { // @TODO: drop condition when PHP 8.1+ is required
+            $index = $this->classyTokens->getPrevMeaningfulToken($index);
+        }
+
+        while ($this->classyTokens[$index]->isGivenKind(CT::T_ATTRIBUTE_CLOSE)) {
+            $index = $this->classyTokens->findBlockStart(Tokens::BLOCK_TYPE_ATTRIBUTE, $index);
+            $index = $this->classyTokens->getPrevMeaningfulToken($index);
+        }
+
+        return $this->classyTokens[$index]->isGivenKind(T_NEW);
+    }
+
+    /**
+     * Check if the function under given index is a lambda.
+     */
+    /**
+     * Check if the function under given index is a lambda.
+     */
+    public function isLambda(Tokens $tokens, int $index): bool {
+        $this->classyTokens = $tokens;
+        $this->classyScanIndex = $index;
+
+        if (!$this->classyTokens[$index]->isGivenKind([T_FUNCTION, T_FN])) {
+            throw new \LogicException(sprintf('No T_FUNCTION or T_FN at given index %d, got "%s".', $index, $this->classyTokens[$index]->getName()));
+        }
+
+        $startParenthesisIndex = $this->classyTokens->getNextMeaningfulToken($index);
+        $startParenthesisToken = $this->classyTokens[$startParenthesisIndex];
+
+        // skip & for `function & () {}` syntax
+        if ($startParenthesisToken->isGivenKind(CT::T_RETURN_REF)) {
+            $startParenthesisIndex = $this->classyTokens->getNextMeaningfulToken($startParenthesisIndex);
+            $startParenthesisToken = $this->classyTokens[$startParenthesisIndex];
+        }
+
+        return $startParenthesisToken->equals('(');
+    }
+
+    public function getLastTokenIndexOfArrowFunction(Tokens $tokens, int $index): int {
+        $this->classyTokens = $tokens;
+        $this->classyScanIndex = $index;
+
+        if (!$this->classyTokens[$index]->isGivenKind(T_FN)) {
+            throw new \InvalidArgumentException(sprintf('Not an "arrow function" at given index %d.', $index));
+        }
+
+        $stopTokens = [')', ']', ',', ';', [T_CLOSE_TAG]];
+        $index = $this->classyTokens->getNextTokenOfKind($index, [[T_DOUBLE_ARROW]]);
+
+        while (true) {
+            $index = $this->classyTokens->getNextMeaningfulToken($index);
+
+            if ($this->classyTokens[$index]->equalsAny($stopTokens)) {
+                break;
+            }
+
+            $blockType = Tokens::detectBlockType($this->classyTokens[$index]);
+
+            if (null === $blockType) {
+                continue;
+            }
+
+            if ($blockType['isStart']) {
+                $index = $this->classyTokens->findBlockEnd($blockType['type'], $index);
+
+                continue;
+            }
+
+            break;
+        }
+
+        return $this->classyTokens->getPrevMeaningfulToken($index);
+    }
