+        $index = $end - 1;
+
+        for ($last = true; $index > $start; --$index, $last = false) {
+            if (!$tokens[$index]->isGivenKind([T_ENCAPSED_AND_WHITESPACE, T_WHITESPACE])) {
+                continue;
