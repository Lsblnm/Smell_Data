+	public void copyJavadoc(JavacNode from, JCTree to, JavacHandlerUtil.CopyJavadoc copyMode, boolean forceAddReturn) {
+		if (copyMode == null) copyMode = JavacHandlerUtil.CopyJavadoc.VERBATIM;
+		try {
+			JCCompilationUnit cu = ((JCCompilationUnit) from.top().get());
+			String newJavadoc = copyMode.apply(cu, from);
+			if (forceAddReturn) {
+				newJavadoc = addReturnsThisIfNeeded(newJavadoc);
+			}
+			Javac.setDocComment(cu, to, newJavadoc);
+		} catch (Exception ignore) {}
+	}
