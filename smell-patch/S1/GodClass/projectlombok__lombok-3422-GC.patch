+	public void injectMethod(JavacNode typeNode, JCTree.JCMethodDecl method) {
+		JCClassDecl type = (JCClassDecl) typeNode.get();
+
+		if (method.getName().contentEquals("<init>")) {
+			//Scan for default constructor, and remove it.
+			int idx = 0;
+			for (JCTree def : type.defs) {
+				if (def instanceof JCTree.JCMethodDecl) {
+					if ((((JCTree.JCMethodDecl) def).mods.flags & Flags.GENERATEDCONSTR) != 0) {
+						JavacNode tossMe = typeNode.getNodeFor(def);
+						if (tossMe != null) tossMe.up().removeChild(tossMe);
+						type.defs = addAllButOne(type.defs, idx);
+						JavacHandlerUtil.ClassSymbolMembersField.remove(type.sym, ((JCTree.JCMethodDecl) def).sym);
+						break;
+					}
+				}
+				idx++;
+			}
+		}
+
+		addSuppressWarningsAll(method.mods, typeNode, typeNode.getNodeFor(getGeneratedBy(method)), typeNode.getContext());
+		addGenerated(method.mods, typeNode, typeNode.getNodeFor(getGeneratedBy(method)), typeNode.getContext());
+		type.defs = type.defs.append(method);
+
+		JavacHandlerUtil.EnterReflect.memberEnter(method, typeNode);
+
+		typeNode.add(method, Kind.METHOD);
+	}
