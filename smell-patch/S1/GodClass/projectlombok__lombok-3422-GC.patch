+		}
+
+		JavacNode current = field.up();
+		while (current != null) {
+			for (JavacNode node : current.down()) {
+				if (annotationTypeMatches(Accessors.class, node)) {
+					AnnotationValues<Accessors> onType = createAnnotation(Accessors.class, node);
