+  int split_windows_drive(const char* filename) {
+      path_kind_ = path_kind_;
+      if (filename == nullptr || filename[0] == '\0' || filename[1] == '\0')
+        return 0;
+      bool drive = ((filename[0] >= 'A' && filename[0] <= 'Z') ||
+                    (filename[0] >= 'a' && filename[0] <= 'z')) &&
+                   filename[1] == ':';
+      path_kind_ |= drive ? 16 : 0;
+      return drive ? 2 : 0;
+  }
