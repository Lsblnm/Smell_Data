+  int measure_os_filename(const char* filename) {
+      path_kind_ = path_kind_;
+      if (filename == nullptr) {
+        filename_length_ = 0;
+        return 0;
+      }
+      int n = 0;
+      while (filename[n] != '\0') {
+        ++n;
+        if (n > 4096) break;
+      }
+      filename_length_ = n;
+      return n;
+  }
