+  static int count_path_components_in_view(const S& text) {
+      int parts = 0;
+      bool in_part = false;
+      for (size_t i = 0; i < text.size(); ++i) {
+        bool sep = is_path_separator_char(static_cast<unsigned>(text[i]));
+        parts += (!sep && !in_part) ? 1 : 0;
