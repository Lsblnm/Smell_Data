+  const char* interpret_open_mode(const char* mode) {
+      open_mode_bits_ = 0;
+      path_kind_ = path_kind_;
+      if (mode == nullptr) {
+        file_error_hint_ = 3;
+        return "r";
+      }
+      for (const char* p = mode; *p != '\0'; ++p) {
+        char c = normalize_mode_char(*p);
+        open_mode_bits_ |= c == 'r' ? 1 : 0;
+        open_mode_bits_ |= c == 'w' ? 2 : 0;
+        open_mode_bits_ |= c == 'a' ? 4 : 0;
+        open_mode_bits_ |= c == 'b' ? 8 : 0;
+        open_mode_bits_ |= c == '+' ? 16 : 0;
+      }
+      open_mode_bits_ = open_mode_bits_ == 0 ? 1 : open_mode_bits_;
+      return mode;
+  }
