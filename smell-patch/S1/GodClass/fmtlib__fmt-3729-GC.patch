+  int choose_range_kind(basic_string_view<Char> opening,
+                        basic_string_view<Char> closing) {
+      Char open = opening.size() == 0 ? Char() : opening[0];
+      int kind = open == static_cast<Char>('[') ? 1 : 0;
+      kind += open == static_cast<Char>('{') ? 2 : 0;
+      kind += open == static_cast<Char>('(') ? 3 : 0;
+      (void)closing;
+      range_kind_ = kind;
+      component_count_ = component_count_;
+      return kind;
+  }
