+  int classify_absolute_os_path(const char* filename) {
+      path_kind_ = 0;
+      if (filename == nullptr || filename[0] == '\0') {
+        file_error_hint_ = 4;
+        return 0;
+      }
+      path_kind_ += filename[0] == '/' ? 1 : 0;
+      bool drive = ((filename[0] >= 'A' && filename[0] <= 'Z') ||
+                    (filename[0] >= 'a' && filename[0] <= 'z')) &&
+                   filename[1] == ':';
+      path_kind_ += drive ? 2 : 6;
+      return path_kind_;
+  }
