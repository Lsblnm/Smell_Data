+          capture_correction_top_level_replace(node)
+          capture_correction_style_branch(node)
+          @correction_catalog
+        end
+
+        def visibility_name_for(node)
+          @visibility_catalog ||= {}
+          inline_name = visibility_inline_for(node)
+          block_name = visibility_block_for(node)
+          resolved = inline_name || block_name || :public
+          @visibility_catalog[:resolved_visibility] = resolved
+          @visibility_catalog[:inline_visibility] = inline_name
+          @visibility_catalog[:block_visibility] = block_name
+          resolved
+        end
+
+        def visibility_inline_for(node)
+          @visibility_catalog ||= {}
+          unless node && node.respond_to?(:def_type?) && node.def_type?
+            @visibility_catalog[:inline_visibility] = nil
+            return nil
+          end
+
+          parent = node.parent
+          inline_from_def = nil
+          if parent && parent.send_type? && parent.receiver.nil? &&
+              VISIBILITY_TOKENS.include?(parent.method_name) &&
+              parent.arguments.size == 1 && parent.first_argument&.def_type?
+            inline_from_def = parent.method_name
+          end
+
+          inline_from_name = nil
+          siblings = node.respond_to?(:right_siblings) ? node.right_siblings : []
+          sibling = siblings.reverse.find do |item|
+            item && item.send_type? && item.receiver.nil? &&
+              VISIBILITY_TOKENS.include?(item.method_name) &&
+              item.arguments.size == 1 && item.first_argument&.sym_type? &&
+              item.first_argument.value == node.method_name
+          end
+          inline_from_name = sibling&.method_name
+
+          resolved = inline_from_def || inline_from_name
+          @visibility_catalog[:inline_from_def] = inline_from_def
+          @visibility_catalog[:inline_from_name] = inline_from_name
+          @visibility_catalog[:inline_visibility] = resolved
+          resolved
+        end
+
+        def visibility_block_for(node)
+          @visibility_catalog ||= {}
+          start_node = nil
+          if node.respond_to?(:left_siblings)
+            start_node = node.left_siblings.reverse.find do |item|
+              item && item.send_type? && item.receiver.nil? &&
+                VISIBILITY_TOKENS.include?(item.method_name) && item.arguments.empty?
+            end
+          end
+          resolved = start_node&.method_name
+          @visibility_catalog[:block_visibility] = resolved
+          @visibility_catalog[:block_start_type] = start_node&.type
+          resolved
+        end
+
+        def alias_scope_type_for(node)
+          @alias_catalog ||= {}
+          current = node
+          resolved = :lexical
+          while current && (parent = current.parent)
+            if parent.type == :class || parent.type == :module
+              resolved = :lexical
+              break
+            elsif parent.type == :def || parent.type == :defs
+              resolved = :dynamic
+              break
+            elsif parent.type == :block
+              resolved = parent.method?(:instance_eval) ? :instance_eval : :dynamic
+              break
+            end
+            current = parent
+          end
+          @alias_catalog[:scope_type] = resolved
+          resolved
+        end
+
+        def alias_identifier_for(node)
+          @alias_catalog ||= {}
+          text = if node && node.sym_type?
+                   ":#{node.children.first}"
+                 elsif node
+                   node.source
+                 else
+                   ''
+                 end
+          @alias_catalog[:identifier] = text
+          text
+        end
+
+        def alias_lexical_scope_label_for(node)
+          @alias_catalog ||= {}
+          ancestor = node&.each_ancestor(:class, :module)&.first
+          label = if ancestor.nil?
+                    'at the top level'
+                  elsif ancestor.class_type?
+                    'in a class body'
+                  else
+                    'in a module body'
+                  end
+          @alias_catalog[:lexical_label] = label
+          label
+        end
+
+        def attr_replacement_for(node)
+          @attr_catalog ||= {}
+          setter = node&.last_argument
+          replacement = if setter && setter.boolean_type?
+                          setter.true_type? ? 'attr_accessor' : 'attr_reader'
+                        else
+                          'attr_reader'
+                        end
+          @attr_catalog[:replacement] = replacement
+          replacement
+        end
+
+        def grouped_accessor_source_for(node, accessors)
+          @grouping_catalog ||= {}
+          names = Array(accessors).flat_map do |accessor|
+            if accessor.respond_to?(:arguments)
+              accessor.arguments.map(&:source)
+            else
+              []
+            end
+          end.uniq
+          source = "#{node&.method_name} #{names.join(', ')}"
+          @grouping_catalog[:grouped_source] = source
+          @grouping_catalog[:grouped_names] = names
+          source
+        end
+
+        def bare_modifier_nodes_for(body)
+          @indent_catalog ||= {}
+          modifiers = if body && body.respond_to?(:each_child_node)
+                        body.each_child_node(:send).select do |child|
+                          child.respond_to?(:bare_access_modifier?) && child.bare_access_modifier?
+                        end
+                      else
+                        []
+                      end
+          @indent_catalog[:bare_modifiers] = modifiers
+          @indent_catalog[:bare_modifier_count] = modifiers.size
+          modifiers
+        end
+
+        def prepare_access_modifier_catalog(node)
+          return if node.nil?
+
+          @visibility_catalog = {}
+          @alias_catalog = {}
+          @attr_catalog = {}
+          @grouping_catalog = {}
+          @indent_catalog = {}
+          @range_catalog = {}
+          @policy_catalog = {}
+          @correction_catalog = {}
+
+          hydrate_visibility_catalog(node)
+          hydrate_alias_catalog(node)
+          hydrate_attr_catalog(node)
+          hydrate_grouping_catalog(node)
+          hydrate_indent_catalog(node)
+          hydrate_range_catalog(node)
+          hydrate_policy_catalog(node)
+          hydrate_correction_catalog(node)
+
+          visibility_name_for(node)
+          alias_scope_type_for(node)
+          alias_identifier_for(node.first_argument) if node.respond_to?(:first_argument)
+          alias_lexical_scope_label_for(node)
+          attr_replacement_for(node)
+          grouped_accessor_source_for(node, [])
+          bare_modifier_nodes_for(node.parent)
+        end
       end
     end
   end
