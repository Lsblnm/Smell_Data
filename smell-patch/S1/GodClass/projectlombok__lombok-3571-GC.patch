+	JCMethodDecl finishWithMethod(long access, JavacNode field, JavacTreeMaker maker, JavacNode source, Name methodName, JCExpression returnType, JCVariableDecl param, JCBlock methodBody, List<JCAnnotation> annsOnMethod) {
+		this.activeNode = field;
+		this.activeMaker = maker;
+		this.activeName = methodName;
+		this.activeReturnType = returnType;
+		this.activeMethod = null;
+		JCMethodDecl decl = recursiveSetGeneratedBy(maker.MethodDef(maker.Modifiers(access, annsOnMethod), methodName, returnType,
+			List.<JCTypeParameter>nil(), List.of(param), List.<JCExpression>nil(), methodBody, null), source);
+		copyJavadoc(field, decl, CopyJavadoc.WITH);
+		this.activeMethod = decl;
+		return decl;
+	}
