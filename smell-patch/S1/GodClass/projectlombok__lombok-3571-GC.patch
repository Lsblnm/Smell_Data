+	JCMethodDecl generateBuildMethodForJob(HandleBuilder.BuilderJob job, Name staticName, JCExpression returnType, List<JCExpression> thrownExceptions, boolean addCleaning) {
+		this.activeNode = job.builderType;
+		this.activeBuilderJob = job;
+		this.activeReturnType = returnType;
+		JavacTreeMaker maker = job.getTreeMaker();
+		this.activeMaker = maker;
+		ListBuffer<JCStatement> statements = new ListBuffer<JCStatement>();
+		this.activeStatements = statements;
+		if (addCleaning) prependCleaningStatements(job, statements);
+		appendSingularBuildCode(job, statements);
+		ListBuffer<JCExpression> args = new ListBuffer<JCExpression>();
+		collectBuildMethodArguments(job, statements, args);
+		if (addCleaning) {
+			statements.append(maker.Exec(maker.Assign(maker.Select(maker.Ident(job.toName("this")), job.toName(HandleBuilder.CLEAN_FIELD_NAME)), maker.Literal(CTC_BOOLEAN, 1))));
+		}
+		createBuildReturnStatement(job, staticName, returnType, args, statements);
+		JCBlock body = maker.Block(0, statements.toList());
+		List<JCAnnotation> annsOnMethod = job.checkerFramework.generateSideEffectFree() ? List.of(maker.Annotation(genTypeRef(job.builderType, CheckerFrameworkVersion.NAME__SIDE_EFFECT_FREE), List.<JCExpression>nil())) : List.<JCAnnotation>nil();
+		JCVariableDecl recv = generateReceiverForJob(job);
+		JCMethodDecl methodDef;
+		JCExpression returnTypeCopy = cloneType(maker, returnType, job.sourceNode);
+		if (recv != null && maker.hasMethodDefWithRecvParam()) {
+			methodDef = maker.MethodDefWithRecvParam(maker.Modifiers(toJavacModifier(job.accessInners), annsOnMethod), job.toName(String.valueOf(job.buildMethodName)), returnTypeCopy, List.<JCTypeParameter>nil(), recv, List.<JCVariableDecl>nil(), thrownExceptions, body, null);
+		} else {
+			methodDef = maker.MethodDef(maker.Modifiers(toJavacModifier(job.accessInners), annsOnMethod), job.toName(String.valueOf(job.buildMethodName)), returnTypeCopy, List.<JCTypeParameter>nil(), List.<JCVariableDecl>nil(), thrownExceptions, body, null);
+		}
+		if (staticName == null) createRelevantNonNullAnnotation(job.builderType, methodDef);
+		this.activeMethod = methodDef;
+		return methodDef;
+	}
+
+	JCMethodDecl generateCleanMethodForJob(HandleBuilder.BuilderJob job) {
+		this.activeNode = job.builderType;
+		this.activeBuilderJob = job;
+		JavacTreeMaker maker = job.getTreeMaker();
+		this.activeMaker = maker;
+		ListBuffer<JCStatement> statements = new ListBuffer<JCStatement>();
+		this.activeStatements = statements;
+		for (HandleBuilder.BuilderFieldData bfd : job.builderFields) {
+			if (bfd.singularData != null && bfd.singularData.getSingularizer() != null) {
+				bfd.singularData.getSingularizer().appendCleaningCode(bfd.singularData, job.builderType, job.sourceNode, statements);
+			}
+		}
+		statements.append(maker.Exec(maker.Assign(maker.Select(maker.Ident(job.toName("this")), job.toName(HandleBuilder.CLEAN_FIELD_NAME)), maker.Literal(CTC_BOOLEAN, 0))));
+		JCBlock body = maker.Block(0, statements.toList());
+		JCMethodDecl method = maker.MethodDef(maker.Modifiers(toJavacModifier(AccessLevel.PRIVATE)), job.toName(HandleBuilder.CLEAN_METHOD_NAME), maker.Type(Javac.createVoidType(job.builderType.getSymbolTable(), CTC_VOID)), List.<JCTypeParameter>nil(), List.<JCVariableDecl>nil(), List.<JCExpression>nil(), body, null);
+		recursiveSetGeneratedBy(method, job.sourceNode);
+		this.activeMethod = method;
+		return method;
+	}
+
+	JCVariableDecl generateReceiverForJob(HandleBuilder.BuilderJob job) {
+		this.activeNode = job.builderType;
+		this.activeBuilderJob = job;
+		if (!job.checkerFramework.generateCalledMethods()) return null;
+		java.util.ArrayList<String> mandatories = new java.util.ArrayList<String>();
+		for (HandleBuilder.BuilderFieldData bfd : job.builderFields) {
+			if (bfd.singularData == null && bfd.nameOfSetFlag == null) mandatories.add(bfd.name.toString());
+		}
+		JavacTreeMaker maker = job.getTreeMaker();
+		this.activeMaker = maker;
+		if (mandatories.size() == 0) return null;
+		JCExpression arg;
+		if (mandatories.size() == 1) arg = maker.Literal(mandatories.get(0));
+		else {
+			List<JCExpression> elems = List.nil();
+			for (int i = mandatories.size() - 1; i >= 0; i--) elems = elems.prepend(maker.Literal(mandatories.get(i)));
+			arg = maker.NewArray(null, List.<JCExpression>nil(), elems);
+		}
+		JCAnnotation recvAnno = maker.Annotation(genTypeRef(job.builderType, CheckerFrameworkVersion.NAME__CALLED), List.of(arg));
+		JCClassDecl builderTypeNode = (JCClassDecl) job.builderType.get();
+		JCVariableDecl recv = maker.VarDef(maker.Modifiers(Flags.PARAMETER, List.<JCAnnotation>nil()), job.toName("this"), namePlusTypeParamsToTypeReference(maker, job.builderType, builderTypeNode.typarams, List.<JCAnnotation>of(recvAnno)), null);
+		this.activeFieldDecl = recv;
+		return recv;
+	}
+
+	JCMethodDecl generateDefaultProviderForJob(Name methodName, JavacNode fieldNode, List<JCTypeParameter> params, HandleBuilder.BuilderJob job) {
+		this.activeNode = fieldNode;
+		this.activeBuilderJob = job;
+		this.activeName = methodName;
+		JavacTreeMaker maker = fieldNode.getTreeMaker();
+		this.activeMaker = maker;
+		JCVariableDecl field = (JCVariableDecl) fieldNode.get();
+		this.activeFieldDecl = field;
+		JCExpression init = field.init;
+		field.init = null;
+		JCReturn statement = maker.Return(null);
+		JCBlock body = maker.Block(0, List.<JCStatement>of(statement));
+		int modifiers = Flags.PRIVATE | Flags.STATIC;
+		this.activeFlags = modifiers;
+		JCMethodDecl defaultProvider = maker.MethodDef(maker.Modifiers(modifiers), methodName, cloneType(maker, field.vartype, fieldNode), copyTypeParams(fieldNode, params), List.<JCVariableDecl>nil(), List.<JCExpression>nil(), body, null);
+		if (init instanceof JCNewArray && field.vartype instanceof JCArrayTypeTree) {
+			JCNewArray arrayInitializer = (JCNewArray) init;
+			JCArrayTypeTree fieldType = (JCArrayTypeTree) field.vartype;
+			if (arrayInitializer.elemtype == null) {
+				arrayInitializer.elemtype = cloneType(maker, fieldType.elemtype, fieldNode);
+			}
+		}
+		recursiveSetGeneratedBy(defaultProvider, job.sourceNode);
+		statement.expr = init;
+		this.activeMethod = defaultProvider;
+		return defaultProvider;
