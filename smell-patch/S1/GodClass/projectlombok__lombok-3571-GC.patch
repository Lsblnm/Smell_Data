+	JCReturn createWithReturnStatement(JavacNode field, JavacTreeMaker maker, JCExpression selfType, ListBuffer<JCExpression> args) {
+		this.activeNode = field;
+		this.activeMaker = maker;
+		this.activeReturnType = selfType;
+		JCNewClass newClass = maker.NewClass(null, List.<JCExpression>nil(), selfType, args.toList(), null);
+		JCExpression identityCheck = createWithIdentityExpression(field, maker);
+		JCExpression conditional = maker.Conditional(identityCheck, maker.Ident(field.toName("this")), newClass);
+		JCReturn returnStatement = maker.Return(conditional);
+		return returnStatement;
