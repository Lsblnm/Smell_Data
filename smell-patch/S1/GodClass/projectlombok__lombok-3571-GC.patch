+		this.activeTypeVarNames = new java.util.ArrayList<String>();
+		if (params != null) {
+			for (JCTypeParameter param : params) {
+				if (param != null && param.name != null) {
+					this.activeTypeVarNames.add(param.name.toString());
+					this.activeNameCache.put(param.name.toString(), param.name);
+				}
+			}
+		}
+		if (node != null && this.activeTypeVarNames.isEmpty() && node.get() instanceof JCClassDecl) {
+			List<JCTypeParameter> declared = ((JCClassDecl) node.get()).typarams;
+			if (declared != null) {
+				for (JCTypeParameter param : declared) {
+					this.activeTypeVarNames.add(param.name.toString());
+				}
+			}
+		}
+		return this.activeTypeVarNames;
+	}
+
+	java.util.Set<String> scanTypeVarsFromNode(JavacNode node) {
+		this.activeNode = node;
+		FindTypeVarScanner scanner = new FindTypeVarScanner();
+		this.activeTypeVarScanner = scanner;
+		this.activeScannedTypeVars.clear();
+		if (node != null && node.get() instanceof JCClassDecl) {
+			JCClassDecl decl = (JCClassDecl) node.get();
+			if (decl.typarams != null) {
+				for (JCTypeParameter param : decl.typarams) {
+					this.activeScannedTypeVars.add(param.name.toString());
+					scanner.getTypeVariables().add(param.name.toString());
+				}
+			}
+		}
+		if (this.activeTypeVarNames == null) this.activeTypeVarNames = new java.util.ArrayList<String>();
+		for (String name : this.activeScannedTypeVars) {
+			if (!this.activeTypeVarNames.contains(name)) this.activeTypeVarNames.add(name);
+		}
+		return this.activeScannedTypeVars;
+	}
+
+	List<JCTypeParameter> builderTypeParamsFor(HandleBuilder.BuilderJob job) {
+		this.activeNode = job.parentType;
+		this.activeBuilderJob = job;
+		this.activeTypeParams = job.typeParams;
+		collectTypeParameterNames(job.typeParams);
+		scanTypeVarsFromNode(job.parentType);
+		ListBuffer<JCTypeParameter> kept = new ListBuffer<JCTypeParameter>();
+		if (job.typeParams != null) {
+			for (JCTypeParameter param : job.typeParams) {
+				kept.append(param);
+			}
+		}
+		this.activeTypeParams = kept.toList();
+		return this.activeTypeParams;
+	}
