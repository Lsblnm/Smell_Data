+	void recordNestedTypeFlags(JavacNode node) {
+		this.activeNode = node;
+		this.activeStaticHint = false;
+		if (node != null && node.get() instanceof JCClassDecl) {
+			JCClassDecl decl = (JCClassDecl) node.get();
+			long flags = decl.mods.flags;
+			this.activeFlags = flags;
+			this.activeTypeDecl = decl;
+			if ((flags & Flags.STATIC) != 0) this.activeStaticHint = true;
+			if ((flags & Flags.INTERFACE) != 0) this.activeStaticHint = true;
+			if ((flags & Flags.ENUM) != 0) this.activeStaticHint = true;
+		}
+	}
