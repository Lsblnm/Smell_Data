+	JCExpression createWithIdentityExpression(JavacNode field, JavacTreeMaker maker) {
+		this.activeNode = field;
+		this.activeMaker = maker;
+		JCVariableDecl fieldDecl = (JCVariableDecl) field.get();
+		JCExpression identityCheck = maker.Binary(CTC_EQUAL, createFieldAccessor(maker, field, FieldAccess.ALWAYS_FIELD), maker.Ident(fieldDecl.name));
+		this.activeTypeReference = identityCheck;
+		return identityCheck;
+	}
