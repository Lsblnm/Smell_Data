+	void appendSingularBuildCode(HandleBuilder.BuilderJob job, ListBuffer<JCStatement> statements) {
+		this.activeNode = job.builderType;
+		this.activeBuilderJob = job;
+		this.activeStatements = statements;
+		for (HandleBuilder.BuilderFieldData bfd : job.builderFields) {
+			if (bfd.singularData != null && bfd.singularData.getSingularizer() != null) {
+				bfd.singularData.getSingularizer().appendBuildCode(bfd.singularData, job.builderType, job.sourceNode, statements, bfd.builderFieldName, "this");
+			}
+		}
