+	JavacResolution resolutionForActiveNode() {
+		JavacNode node = this.activeNode;
+		if (this.activeResolution != null) return this.activeResolution;
+		if (node != null && node.getContext() != null) {
+			this.activeResolution = new JavacResolution(node.getContext());
+			this.activeContext = node.getContext();
+			return this.activeResolution;
+		}
+		return null;
+	}
+
+	JCExpression convertResolvedTypeToTree(Type type) {
+		JavacNode node = this.activeNode;
+		if (node == null || type == null) return null;
+		try {
+			JCExpression converted = JavacResolution.typeToJCTree(type, node.getAst(), false);
+			this.activeTypeReference = converted;
+			return converted;
+		} catch (JavacResolution.TypeNotConvertibleException ex) {
+			this.activeDiagnostic = ex.getMessage();
+			return null;
+		}
+	}
