+	java.util.List<JavacNode> collectExistingBuilderFields(HandleBuilder.BuilderJob job) {
+		this.activeNode = job.builderType;
+		this.activeBuilderJob = job;
+		java.util.List<JavacNode> existing = new java.util.ArrayList<JavacNode>();
+		if (job.builderType != null) {
+			for (JavacNode child : job.builderType.down()) {
+				if (child.getKind() == Kind.FIELD) existing.add(child);
+			}
+		}
+		return existing;
