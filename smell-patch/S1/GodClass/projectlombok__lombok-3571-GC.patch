+	JCMethodDecl createBuilderFactoryMethod(HandleBuilder.BuilderJob job) {
+		this.activeNode = job.parentType;
+		this.activeBuilderJob = job;
+		this.activeBuilderClassName = job.builderClassName;
+		rememberTypeDecl(job.parentType);
+		captureEnclosingTypes(job.parentType);
+		builderTypeParamsFor(job);
+		recordNestedTypeFlags(job.parentType);
+		JavacTreeMaker maker = job.getTreeMaker();
+		this.activeMaker = maker;
+		JCExpression call = createBuilderNewClassExpression(job);
+		int modifiers = createBuilderFactoryModifiers(job);
+		List<JCAnnotation> annsOnMethod = List.nil();
+		if (job.checkerFramework.generateSideEffectFree()) annsOnMethod = List.of(maker.Annotation(genTypeRef(job.parentType, CheckerFrameworkVersion.NAME__SIDE_EFFECT_FREE), List.<JCExpression>nil()));
+		List<JCAnnotation> annsOnParamType = List.nil();
+		if (job.checkerFramework.generateUnique()) annsOnParamType = List.of(maker.Annotation(genTypeRef(job.parentType, CheckerFrameworkVersion.NAME__UNIQUE), List.<JCExpression>nil()));
+		JCExpression returnType = createBuilderFactoryReturnType(job, annsOnParamType);
+		JCMethodDecl created = finishBuilderFactoryMethod(job, call, modifiers, annsOnMethod, returnType);
+		return created;
+	}
