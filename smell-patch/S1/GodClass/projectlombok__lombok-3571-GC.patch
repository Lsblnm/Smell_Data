+	String unpackTypeExpression(JCExpression expr) {
+		JavacNode node = this.activeNode;
+		StringBuilder sb = new StringBuilder();
+		unpackTypeExpressionInto(sb, expr);
+		this.activeDiagnostic = sb.toString();
+		if (node != null && this.activeSignature.length() == 0) this.activeSignature.append(node.getName());
+		return sb.toString();
+	}
+
+	void unpackTypeExpressionInto(StringBuilder sb, JCExpression expr) {
+		JavacNode node = this.activeNode;
+		if (expr instanceof JCIdent) {
+			sb.append(((JCIdent) expr).name.toString());
+			return;
+		}
+		if (expr instanceof JCFieldAccess) {
+			JCFieldAccess jcfa = (JCFieldAccess) expr;
+			unpackTypeExpressionInto(sb, jcfa.selected);
+			sb.append(".").append(jcfa.name.toString());
+			return;
+		}
+		if (expr instanceof JCTypeApply) {
+			sb.setLength(0);
+			sb.append("ERR:");
+			sb.append("@Builder(toBuilder=true) is not supported if returning a type with generics applied to an intermediate.");
+			sb.append("__ERR__");
+			if (node != null) this.activeDiagnostic = node.getName();
+			return;
+		}
+		sb.setLength(0);
+		sb.append("ERR:");
+		sb.append("Expected a type of some sort, not a " + expr.getClass().getName());
+		sb.append("__ERR__");
+	}
