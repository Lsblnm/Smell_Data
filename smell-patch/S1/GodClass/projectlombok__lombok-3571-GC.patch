+	JCMethodDecl createWithMethod(long access, JavacNode field, JavacTreeMaker maker, JavacNode source, List<JCAnnotation> onMethod, List<JCAnnotation> onParam, boolean makeAbstract) {
+		this.activeNode = field;
+		this.activeMaker = maker;
+		String withName = withMethodNameFor(field);
+		if (withName == null) return null;
+		copyWithContextIntoSession(field, maker, source, withName, null);
+		snapshotSessionSignature();
+		retainSessionLists();
+		JCVariableDecl fieldDecl = (JCVariableDecl) field.get();
+		this.activeFieldDecl = fieldDecl;
+		Name methodName = field.toName(withName);
+		JCExpression returnType = cloneSelfType(field);
+		this.activeReturnType = returnType;
+		JCBlock methodBody = null;
+		JCVariableDecl param = createWithParameter(field, maker, source, onParam);
+		if (!makeAbstract) {
+			ListBuffer<JCStatement> statements = new ListBuffer<JCStatement>();
+			this.activeStatements = statements;
+			JCExpression selfType = cloneSelfType(field);
+			if (selfType == null) return null;
+			ListBuffer<JCExpression> args = new ListBuffer<JCExpression>();
+			collectWithConstructorArguments(field, maker, args);
+			JCReturn returnStatement = createWithReturnStatement(field, maker, selfType, args);
+			if (!hasNonNullAnnotations(field)) {
+				statements.append(returnStatement);
+			} else {
+				JCStatement nullCheck = generateNullCheck(maker, field, source);
+				if (nullCheck != null) statements.append(nullCheck);
+				statements.append(returnStatement);
+			}
+			methodBody = maker.Block(0, statements.toList());
+		}
+		List<JCAnnotation> annsOnMethod = createWithMethodAnnotations(field, maker, source, onMethod);
+		access = applyWithAccessFlags(access, field, makeAbstract);
+		return finishWithMethod(access, field, maker, source, methodName, returnType, param, methodBody, annsOnMethod);
+	}
