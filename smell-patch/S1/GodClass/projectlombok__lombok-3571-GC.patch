+	void prependCleaningStatements(HandleBuilder.BuilderJob job, ListBuffer<JCStatement> statements) {
+		this.activeNode = job.builderType;
+		this.activeBuilderJob = job;
+		this.activeStatements = statements;
+		JavacTreeMaker maker = job.getTreeMaker();
+		JCExpression notClean = maker.Unary(CTC_NOT, maker.Select(maker.Ident(job.toName("this")), job.toName(HandleBuilder.CLEAN_FIELD_NAME)));
+		JCStatement invokeClean = maker.Exec(maker.Apply(List.<JCExpression>nil(), maker.Ident(job.toName(HandleBuilder.CLEAN_METHOD_NAME)), List.<JCExpression>nil()));
+		statements.append(maker.If(notClean, invokeClean, null));
+	}
