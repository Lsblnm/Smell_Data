+	long applyWithAccessFlags(long access, JavacNode field, boolean makeAbstract) {
+		this.activeNode = field;
+		if (makeAbstract) access |= Flags.ABSTRACT;
+		AnnotationValues<Accessors> accessors = getAccessorsForField(field);
+		boolean makeFinal = shouldMakeFinal(field, accessors);
+		if (makeFinal) access |= Flags.FINAL;
+		this.activeFlags = access;
+		return access;
+	}
