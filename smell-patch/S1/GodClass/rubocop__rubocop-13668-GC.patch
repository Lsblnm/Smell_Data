+        end
+
+        def safe_assignment_for_parentheses?(node)
+          node.begin_type? && node.children.size == 1 && node.children.first.assignment?
+        end
+
+        def safe_assignment_allowed_for_parentheses?
+          cop_config.fetch('AllowSafeAssignment', true)
+        end
+
+        def parens_allow_multiline_conditions?
+          cop_config['AllowInMultilineConditions']
+        end
+
+        def run_if_unless_modifier_investigation(node)
+          condition = node.condition
+          analyze_condition_tree(node, default_condition_workspace)
