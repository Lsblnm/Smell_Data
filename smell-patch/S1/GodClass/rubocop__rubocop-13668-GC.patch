+          elsif ium_too_long_due_to_modifier?(node)
+            Style::IfUnlessModifier::MSG_USE_NORMAL
+          end
+        end
+
+        def ium_single_line_as_modifier?(node)
+          return false if ium_non_eligible_node?(node) ||
+                          stmt_non_eligible_body?(node.body) ||
+                          stmt_non_eligible_condition?(node.condition)
