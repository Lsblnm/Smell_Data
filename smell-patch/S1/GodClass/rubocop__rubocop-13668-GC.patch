+          code = end_element.source_line[end_element.last_column..]
+          code unless code.empty?
+        end
+
+        def stmt_parenthesize?(node)
+          parent = node.parent
+          return false if parent.nil?
+          return true if parent.assignment? || parent.operator_keyword?
+          return true if %i[array pair].include?(parent.type)
+
+          node.parent.send_type?
+        end
+
+        def stmt_max_line_length
+          return unless config.cop_enabled?('Layout/LineLength')
+
+          config.for_cop('Layout/LineLength')['Max']
+        end
+
+        def max_line_length
+          stmt_max_line_length
+        end
+
+        def stmt_comment_disables_cop?(comment)
+          regexp_pattern = "# rubocop : (disable|todo) ([^,],)* (all|#{cop_name})"
+          Regexp.new(regexp_pattern.gsub(' ', '\s*')).match?(comment)
+        end
+
+        def nested_modifier_check(node)
+          @range_workspace ||= {}
+          analyze_condition_tree(node, default_condition_workspace) if node
+          return if part_of_ignored_node?(node)
+          return unless nested_modifier_form?(node) && nested_modifier_form?(node.parent)
+
+          add_offense(node.loc.keyword) { |corrector| nested_modifier_autocorrect(corrector, node) }
+          ignore_node(node)
+        end
+
+        def nested_modifier_form?(node)
+          node&.basic_conditional? && node.modifier_form?
+        end
+
+        def nested_modifier_autocorrect(corrector, node)
+          return unless node.if_type? && node.parent.if_type?
+
+          range = support_range_between(node.loc.keyword.begin_pos,
+                                        node.parent.condition.source_range.end_pos)
+          corrector.replace(range, nested_modifier_new_expression(node))
+        end
+
+        def nested_modifier_new_expression(inner_node)
+          outer_node = inner_node.parent
+          operator = nested_modifier_replacement_operator(outer_node.keyword)
+          lh_operand = nested_modifier_left_hand_operand(outer_node, operator)
+          rh_operand = nested_modifier_right_hand_operand(inner_node, outer_node.keyword)
+          "#{outer_node.keyword} #{lh_operand} #{operator} #{rh_operand}"
+        end
+
+        def nested_modifier_replacement_operator(keyword)
+          keyword == 'if' ? '&&' : '||'
+        end
+
+        def nested_modifier_left_hand_operand(node, operator)
+          analyze_condition_tree(node.condition, default_condition_workspace)
+          expr = node.condition.source
+          expr = "(#{expr})" if node.condition.or_type? && operator == '&&'
+          expr
+        end
+
+        def nested_modifier_right_hand_operand(node, left_hand_keyword)
+          condition = node.condition
+          analyze_condition_tree(condition, default_condition_workspace)
+          expr = if condition.send_type? && !condition.arguments.empty? &&
+                    !condition.operator_method?
+                   nested_modifier_add_parentheses_to_method_arguments(condition)
+                 else
+                   condition.source
+                 end
+          expr = "(#{expr})" if nested_modifier_requires_parens?(condition)
+          expr = "!#{expr}" unless left_hand_keyword == node.keyword
+          expr
+        end
+
+        def nested_modifier_add_parentheses_to_method_arguments(send_node)
+          expr = +''
+          expr << "#{send_node.receiver.source}." if send_node.receiver
+          expr << send_node.method_name.to_s
+          expr << "(#{send_node.arguments.map(&:source).join(', ')})"
+          expr
+        end
+
+        def nested_modifier_requires_parens?(node)
+          node.or_type? || !(RuboCop::AST::Node::COMPARISON_OPERATORS & node.children).empty?
+        end
+
+        def run_parentheses_around_condition(node)
+          cond = node.condition
+          analyze_condition_tree(cond, default_condition_workspace) if cond
+          return unless cond && cond.begin_type? && !cond.children.empty?
+
+          first_child = cond.children.first
+          rest_children = cond.children.drop(1)
+          return if parens_condition_require_parentheses?(node, first_child)
+          return if parens_condition_semicolon_separated?(first_child, rest_children)
+          return if parens_condition_modifier_op?(first_child)
+          return if parens_condition_allowed?(cond)
+
+          message = parens_condition_message(cond)
+          add_offense(cond, message: message) do |corrector|
+            ParenthesesCorrector.correct(corrector, cond)
+          end
+        end
+
+        def parens_condition_require_parentheses?(node, condition_body)
+          return false if !node.while_type? && !node.until_type?
+          return false if !condition_body.block_type? && !condition_body.numblock_type?
+
+          condition_body.send_node.block_literal? && condition_body.keywords?
+        end
+
+        def parens_condition_semicolon_separated?(first_exp, rest_exps)
+          return false unless (second_exp = rest_exps.first)
+
+          range = support_range_between(first_exp.source_range.end_pos, second_exp.source_range.begin_pos)
+          range.source.include?(';')
+        end
+
+        def parens_condition_modifier_op?(node)
+          return false if node.if_type? && node.ternary?
+          return true if node.rescue_type?
+
+          node.basic_conditional? && node.modifier_form?
+        end
+
+        def parens_condition_message(node)
