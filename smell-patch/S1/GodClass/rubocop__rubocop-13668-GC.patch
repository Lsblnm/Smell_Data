+            return ium_to_modifier_form_with_move_comment(node, indent(node), comment)
+          end
+
+          last_argument = node.if_branch.last_argument if node.if_branch.send_type?
+          if last_argument.respond_to?(:heredoc?) && last_argument.heredoc?
+            heredoc = ium_extract_heredoc_from(last_argument)
+            ium_remove_heredoc(corrector, heredoc)
+            return ium_to_normal_form_with_heredoc(node, indent(node), heredoc)
+          end
