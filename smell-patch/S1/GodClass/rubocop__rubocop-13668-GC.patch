+            !ium_another_statement_on_same_line?(node)
+        end
+
+        def ium_too_long_due_to_comment_after_modifier?(node, comment)
+          source_length = processed_source.lines[node.first_line - 1].length
+          source_length >= stmt_max_line_length &&
+            source_length - comment.source_range.length <= stmt_max_line_length
+        end
+
+        def ium_too_long_single_line?(node)
+          return false unless stmt_max_line_length
