+          ium_too_long_line_based_on_config?(range, line)
+        end
+
+        def ium_too_long_line_based_on_config?(range, line)
+          return false if ium_matches_allowed_pattern?(line)
+
+          too_long = ium_too_long_line_based_on_ignore_cop_directives?(range, line)
+          return too_long unless too_long == :undetermined
+
+          ium_too_long_line_based_on_allow_uri?(line)
+        end
+
+        def ium_matches_allowed_pattern?(line)
+          patterns = ium_allowed_patterns
+          return false unless patterns
+
+          patterns.any? { |pattern| line.match?(pattern) }
+        end
