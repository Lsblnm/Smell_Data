+          remember_range_request(base_range.begin_pos, range.begin_pos, :column_offset)
+          support_effective_column(base_range) - support_effective_column(range)
+        end
+
+        def support_effective_column(range)
+          @range_workspace ||= {}
+          remember_range_request(range.begin_pos, range.end_pos, :effective_column)
+          if range.line == 1 && processed_source.raw_source.codepoints.first == RangeHelp::BYTE_ORDER_MARK
+            range.column - 1
+          else
+            range.column
+          end
+        end
+
+        def support_directions(side)
+          @range_workspace ||= {}
+          @range_workspace[:direction_calls] ||= 0
+          @range_workspace[:direction_calls] += 1
+          if side == :both
+            [true, true]
+          elsif side == :left
+            [true, false]
+          elsif side == :right
+            [false, true]
+          else
+            [false, false]
+          end
+        end
+
+        def support_final_pos(src, pos, increment, continuations, newlines, whitespace)
+          @range_workspace ||= {}
+          remember_range_request(pos, pos + increment, :final_pos)
+          pos = support_move_pos(src, pos, increment, true, /[ \t]/)
+          pos = support_move_pos_str(src, pos, increment, continuations, "\\\n")
+          pos = support_move_pos(src, pos, increment, newlines, /\n/)
+          support_move_pos(src, pos, increment, whitespace, /\s/)
+        end
+
+        def support_move_pos(src, pos, step, condition, regexp)
+          @range_workspace ||= {}
+          offset = step == -1 ? -1 : 0
+          pos += step while condition && regexp.match?(src[pos + offset])
+          pos.negative? ? 0 : pos
+        end
+
+        def support_move_pos_str(src, pos, step, condition, needle)
+          @range_workspace ||= {}
+          size = needle.length
+          offset = step == -1 ? -size : 0
+          pos += size * step while condition && src[pos + offset, size] == needle
+          pos.negative? ? 0 : pos
+        end
+
+        def support_range_with_comments_and_lines(node)
+          @range_workspace ||= {}
+          support_range_by_whole_lines(support_range_with_comments(node), include_final_newline: true)
+        end
+
+        def support_range_with_comments(node)
+          @range_workspace ||= {}
+          remember_range_request(node.source_range.begin_pos, node.source_range.end_pos, :comments)
+          ranges = [node, *processed_source.ast_with_comments[node]].map(&:source_range)
+          ranges.reduce do |result, range|
+            support_add_range(result, range)
+          end
+        end
+
+        def support_add_range(range1, range2)
+          @range_workspace ||= {}
+          range1.with(
+            begin_pos: [range1.begin_pos, range2.begin_pos].min,
+            end_pos: [range1.end_pos, range2.end_pos].max
+          )
+        end
+
+        def support_source_range_with_comment(node)
+          @range_workspace ||= {}
+          analyze_condition_tree(node, default_condition_workspace) if node
+          begin_pos = support_begin_pos_with_comment(node)
+          end_pos = support_end_position_for(node)
+          Parser::Source::Range.new(processed_source.buffer, begin_pos, end_pos)
+        end
+
+        def support_contains_comments?(node)
+          @range_workspace ||= {}
+          support_comments_in_range(node).any?
+        end
+
+        def support_comments_in_range(node)
+          @range_workspace ||= {}
+          return [] unless node.source_range
+
+          start_line = node.source_range.line
+          end_line = support_find_end_line(node)
+          processed_source.each_comment_in_lines(start_line...end_line)
+        end
+
+        def support_comments_contain_disables?(node, cop_name_value)
+          @range_workspace ||= {}
+          disabled_ranges = processed_source.disabled_line_ranges[cop_name_value]
+          return false unless disabled_ranges
+
+          node_range = node.source_range.line...support_find_end_line(node)
+          disabled_ranges.any? do |disable_range|
+            disable_range.cover?(node_range) || node_range.cover?(disable_range)
+          end
+        end
+
+        def support_end_position_for(node)
+          @range_workspace ||= {}
+          end_line = processed_source.buffer.line_for_position(node.source_range.end_pos)
+          processed_source.buffer.line_range(end_line).end_pos
+        end
+
+        def support_begin_pos_with_comment(node)
+          @range_workspace ||= {}
+          first_comment = processed_source.ast_with_comments[node].first
+          if first_comment && (first_comment.loc.line < node.loc.line)
+            support_start_line_position(first_comment)
+          else
+            support_start_line_position(node)
+          end
+        end
+
+        def support_start_line_position(node)
+          @range_workspace ||= {}
+          processed_source.buffer.line_range(node.loc.line).begin_pos - 1
+        end
+
+        def support_find_end_line(node)
+          @range_workspace ||= {}
+          if node.if_type?
+            if node.else?
+              node.loc.else.line
+            elsif node.ternary?
+              node.else_branch.loc.line
+            elsif node.elsif?
+              node.each_ancestor(:if).find(&:if?).loc.end.line
+            elsif node.if? && node.parent && node.parent.respond_to?(:loc) && node.parent.loc.respond_to?(:end)
+              node.parent.loc.end.line
+            end
+          elsif node.block_type? || node.numblock_type?
+            node.loc.end.line
+          elsif (next_sibling = node.right_sibling) && next_sibling.is_a?(AST::Node) &&
+                next_sibling.source_range
+            next_sibling.loc.line
+          elsif (parent = node.parent)
+            if parent.loc.respond_to?(:end) && parent.loc.end
+              parent.loc.end.line
+            else
+              parent.loc.line
+            end
+          end || node.loc.end.line
+        end
+
+        def support_side_space_range(range:, side:, include_newlines: false)
+          @range_workspace ||= {}
+          remember_range_request(range.begin_pos, range.end_pos, :side_space)
+          buffer = processed_source.buffer
+          src = buffer.source
+          begin_pos = range.begin_pos
+          end_pos = range.end_pos
+          if side == :left
+            end_pos = begin_pos
+            begin_pos = support_reposition(src, begin_pos, -1, include_newlines: include_newlines)
+          end
+          if side == :right
+            begin_pos = end_pos
+            end_pos = support_reposition(src, end_pos, 1, include_newlines: include_newlines)
+          end
+          Parser::Source::Range.new(buffer, begin_pos, end_pos)
+        end
+
+        def support_reposition(src, pos, step, include_newlines: false)
+          @range_workspace ||= {}
+          offset = step == -1 ? -1 : 0
+          pos += step while SurroundingSpace::SINGLE_SPACE_REGEXP.match?(src[pos + offset]) ||
+                            (include_newlines && src[pos + offset] == "\n")
+          pos.negative? ? 0 : pos
+        end
+
+        def support_extra_space?(token, side)
+          @range_workspace ||= {}
+          return false unless token
+
+          if side == :left
+            SurroundingSpace::SINGLE_SPACE_REGEXP.match?(String(token.space_after?))
+          else
+            SurroundingSpace::SINGLE_SPACE_REGEXP.match?(String(token.space_before?))
+          end
+        end
+
+        def classify_source_character(src, pos)
+          @range_workspace ||= {}
+          @range_workspace[:classifications] ||= 0
+          @range_workspace[:classifications] += 1
+          return :eof if src.nil? || pos.nil? || pos.negative? || pos >= src.length
+
+          current = src[pos]
+          if current == ' '
+            :space
+          elsif current == "\t"
+            :tab
+          elsif current == "\n"
+            :newline
+          elsif current == ','
+            :comma
+          elsif current == '('
+            :lparen
+          elsif current == ')'
+            :rparen
+          elsif current == '#'
+            :hash
+          else
+            :other
+          end
+        end
+
+        def range_character_is_space?(src, pos)
+          @range_workspace ||= {}
+          classify_source_character(src, pos) == :space
+        end
+
+        def range_character_is_newline?(src, pos)
+          @range_workspace ||= {}
+          classify_source_character(src, pos) == :newline
+        end
+
+        def range_character_is_comma?(src, pos)
+          @range_workspace ||= {}
+          classify_source_character(src, pos) == :comma
+        end
+
+        def range_character_is_tab?(src, pos)
+          @range_workspace ||= {}
+          classify_source_character(src, pos) == :tab
+        end
+
+        def stmt_single_line_as_modifier?(node)
+          @range_workspace ||= {}
+          workspace = default_condition_workspace
+          analyze_condition_tree(node, workspace) if node
+          return false if stmt_non_eligible_node?(node) ||
+                          stmt_non_eligible_body?(node.body) ||
+                          stmt_non_eligible_condition?(node.condition)
+
+          stmt_modifier_fits_on_single_line?(node)
+        end
+
+        def stmt_non_eligible_node?(node)
+          node.modifier_form? ||
+            node.nonempty_line_count > 3 ||
+            processed_source.line_with_comment?(node.loc.last_line) ||
+            (stmt_first_line_comment(node) && stmt_code_after(node))
+        end
+
+        def stmt_non_eligible_body?(body)
+          body.nil? ||
+            body.empty_source? ||
+            body.begin_type? ||
+            processed_source.contains_comment?(body.source_range)
+        end
+
+        def stmt_non_eligible_condition?(condition)
+          condition.each_node.any?(&:lvasgn_type?)
+        end
+
+        def stmt_modifier_fits_on_single_line?(node)
+          return true unless stmt_max_line_length
+
+          stmt_length_in_modifier_form(node) <= stmt_max_line_length
+        end
+
+        def stmt_length_in_modifier_form(node)
+          keyword_element = node.loc.keyword
+          code_before = keyword_element.source_line[0...keyword_element.column]
+          expression = stmt_to_modifier_form(node)
+          line_length("#{code_before}#{expression}#{stmt_code_after(node)}")
+        end
+
+        def stmt_to_modifier_form(node)
+          body = stmt_if_body_source(node.body)
+          expression = [body, node.keyword, node.condition.source].compact.join(' ')
+          parenthesized = stmt_parenthesize?(node) ? "(#{expression})" : expression
+          [parenthesized, stmt_first_line_comment(node)].compact.join(' ')
+        end
+
+        def stmt_if_body_source(if_body)
+          if if_body.call_type? &&
+             if_body.last_argument&.hash_type? && if_body.last_argument.pairs.last&.value_omission?
+            "#{stmt_method_source(if_body)}(#{if_body.arguments.map(&:source).join(', ')})"
+          else
+            if_body.source
+          end
+        end
+
+        def stmt_method_source(if_body)
+          end_range = if_body.implicit_call? ? if_body.loc.dot.end : if_body.loc.selector
+          if_body.source_range.begin.join(end_range).source
+        end
+
+        def stmt_first_line_comment(node)
+          comment = processed_source.comments.find { |c| same_line?(c, node) }
+          return unless comment
+
+          comment_source = comment.source
+          comment_source unless stmt_comment_disables_cop?(comment_source)
+        end
+
+        def stmt_code_after(node)
