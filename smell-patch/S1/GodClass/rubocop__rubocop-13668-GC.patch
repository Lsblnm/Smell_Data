+        end
+
+        def ium_named_capture_in_condition?(node)
+          node.condition.match_with_lvasgn_type?
+        end
+
+        def ium_autocorrect(corrector, node)
+          replacement = if node.modifier_form?
+                          ium_replacement_for_modifier_form(corrector, node)
+                        else
+                          stmt_to_modifier_form(node)
+                        end
+          corrector.replace(node, replacement)
+        end
+
+        def ium_replacement_for_modifier_form(corrector, node)
