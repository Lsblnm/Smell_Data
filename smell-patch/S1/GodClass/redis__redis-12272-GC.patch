+static void stringRuntimeSyncView(void) {
+
+    size_t snap_len = strt.len;
+    int snap_enc = strt.encoding;
+    char *snap_ptr = strt.ptr;
+    unsigned long snap_flags = strt.flags;
+    long long snap_off = strt.offset;
+    uint64_t snap_bit = strt.bit_offset;
+    int snap_dirty = strt.dirty;
+    int snap_writable = strt.writable;
