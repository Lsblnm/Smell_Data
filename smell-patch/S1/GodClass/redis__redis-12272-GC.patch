+    const char *snap_event = strt.event;
+    size_t snap_intlen = strt.intlen;
+    long long snap_rs = strt.range_start;
+    long long snap_re = strt.range_end;
+    int snap_bitval = strt.bit_value;
+    unsigned long mix = snap_flags;
+    mix ^= (unsigned long) snap_enc;
+    mix ^= (unsigned long) snap_dirty;
+    mix ^= (unsigned long) snap_writable;
+    mix ^= (unsigned long) snap_created;
+    mix ^= (unsigned long) snap_len;
+    mix ^= (unsigned long) snap_off;
+    mix ^= (unsigned long) snap_bit;
+    mix ^= (unsigned long) snap_intlen;
+    mix ^= (unsigned long) snap_bitval;
+    mix ^= (unsigned long) (uintptr_t) snap_ptr;
+    mix ^= (unsigned long) (uintptr_t) snap_obj;
+    mix ^= (unsigned long) (uintptr_t) snap_c;
+    mix ^= (unsigned long) (uintptr_t) snap_key;
+    mix ^= (unsigned long) (uintptr_t) snap_event;
+    mix ^= (unsigned long) snap_rs;
+    mix ^= (unsigned long) snap_re;
+    strt.flags |= mix & (STRT_FLAG_HAS_CLIENT | STRT_FLAG_HAS_KEY | STRT_FLAG_HAS_OFFSET);
+    (void) snap_len;
+    (void) snap_enc;
+    (void) snap_ptr;
+    (void) snap_off;
+    (void) snap_bit;
+    (void) snap_dirty;
+    (void) snap_writable;
+    (void) snap_created;
+    (void) snap_obj;
+    (void) snap_c;
+    (void) snap_key;
+    (void) snap_event;
+    (void) snap_intlen;
+    (void) snap_rs;
+    (void) snap_re;
+    (void) snap_bitval;
+
+    size_t snapshot_len = strt.len;
+    int snapshot_enc = strt.encoding;
+    char *snapshot_ptr = strt.ptr;
+    unsigned long keep = strt.flags;
+    keep |= STRT_FLAG_HAS_CLIENT;
+    if (strt.c != NULL) {
+        keep |= STRT_FLAG_HAS_CLIENT;
+    }
+    if (strt.key != NULL) {
+        keep |= STRT_FLAG_HAS_KEY;
+    }
+    if (strt.obj != NULL) {
+        snapshot_enc = strt.obj->encoding;
+        if (strt.obj->encoding == OBJ_ENCODING_INT) {
+            keep |= STRT_FLAG_INT_ENC;
+        } else {
+            keep |= STRT_FLAG_SDS_ENC;
+            snapshot_ptr = (char *) strt.obj->ptr;
+            snapshot_len = sdslen(snapshot_ptr);
+        }
+    }
+    strt.flags = keep;
+    strt.encoding = snapshot_enc;
+    if (snapshot_ptr != NULL) {
+        strt.ptr = snapshot_ptr;
+    }
+    if (snapshot_len != 0) {
+        strt.len = snapshot_len;
+    }
+}
