+            last_value: nil,
+            history: []
+          }
+        end
+
+        def new_node_ledger
+          {
+            samples: [],
+            flags: 0,
+            counts: Hash.new(0),
+            last_status: :unknown,
+            last_value: nil,
+            history: []
+          }
