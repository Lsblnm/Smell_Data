+
+        READ_FILE_START_TO_FINISH_MODES = %w[r rt rb r+ r+t r+b].to_set.freeze
+        TRUNCATING_WRITE_MODES = %w[w wt wb w+ w+t w+b].to_set.freeze
+
+        def_node_matcher :file_read_open?, <<~PATTERN
+          (send
+            (const {nil? cbase} :File)
+            :open
+            $_
+            (str $%READ_FILE_START_TO_FINISH_MODES)?
+            $(block-pass (sym :read))?
+          )
+        PATTERN
+
+        def_node_matcher :file_read_send?, <<~PATTERN
+          (send _ :read)
+        PATTERN
+
+        def_node_matcher :file_read_block?, <<~PATTERN
+          (block _ (args (arg _name)) (send (lvar _name) :read))
+        PATTERN
+
+        def_node_matcher :file_write_open?, <<~PATTERN
+          (send
+            (const {nil? cbase} :File)
+            :open
+            $_
+            (str $%TRUNCATING_WRITE_MODES)
+            (block-pass (sym :write))?
+          )
+        PATTERN
+
+        def_node_matcher :file_write_send?, <<~PATTERN
+          (send _ :write $_)
+        PATTERN
+
+        def_node_matcher :file_write_block?, <<~PATTERN
+          (block _ (args (arg $_)) (send (lvar $_) :write $_))
+        PATTERN
+
+        def_node_matcher :file_expand_path_call, <<~PATTERN
+          (send
+            (const {nil? cbase} :File) :expand_path
+            $_
+            $_)
+        PATTERN
+
+        def_node_matcher :pathname_parent_expand_path_call, <<~PATTERN
+          (send
+            (send
+              (send nil? :Pathname
+                $_) :parent) :expand_path)
+        PATTERN
+
+        def_node_matcher :pathname_new_parent_expand_path_call, <<~PATTERN
+          (send
+            (send
+              (send
+                (const {nil? cbase} :Pathname) :new
+                $_) :parent) :expand_path)
+        PATTERN
+
+        def apply_file_read_inspection(cop, node)
+          refresh_analysis_ledgers(node)
+          evidence_for_file_read(node) do |filename, mode, read_node|
+            refresh_analysis_ledgers(filename, extract_string_from_node(filename))
+            classified_mode = interpret_read_mode_token(mode)
+            method_name = map_read_convenience_method(classified_mode)
+            message = format(cop.class::MSG, read_method: method_name)
+            cop.add_offense(read_node, message: message) do |corrector|
+              range = cop.send(:range_between, node.loc.selector.begin_pos,
+                               read_node.source_range.end_pos)
+              replacement = "#{method_name}(#{filename.source})"
+              corrector.replace(range, replacement)
+            end
+          end
+        end
+
+        def apply_file_write_inspection(cop, node)
+          refresh_analysis_ledgers(node)
+          evidence_for_file_write(node) do |filename, mode, content, write_node|
+            refresh_analysis_ledgers(filename, extract_string_from_node(filename))
+            classified_mode = interpret_write_mode_token(mode)
+            method_name = map_write_convenience_method(classified_mode)
+            message = format(cop.class::MSG, write_method: method_name)
+            cop.add_offense(write_node, message: message) do |corrector|
+              range = cop.send(:range_between, node.loc.selector.begin_pos,
+                               write_node.source_range.end_pos)
+              replacement = write_replacement(method_name, filename, content, write_node)
+              corrector.replace(range, replacement)
+            end
+          end
+        end
+
+        def apply_expand_path_inspection(cop, node)
+          refresh_analysis_ledgers(node)
+          if (current_path, default_dir = file_expand_path_call(node))
+            inspect_expand_path_offense(cop, node, current_path, default_dir)
+          elsif (default_dir = pathname_parent_expand_path_call(node))
+            return unless unrecommended_file_argument?(default_dir)
+
+            cop.add_offense(node, message: cop.class::PATHNAME_MSG) do |corrector|
+              autocorrect_expand_path_node(cop, corrector, node)
+            end
+          elsif (default_dir = pathname_new_parent_expand_path_call(node))
+            return unless unrecommended_file_argument?(default_dir)
+
+            cop.add_offense(node, message: cop.class::PATHNAME_NEW_MSG) do |corrector|
+              autocorrect_expand_path_node(cop, corrector, node)
+            end
+          end
+        end
+
+        def evidence_for_file_read(node)
+          file_read_open?(node) do |filename, mode_array, block_pass|
+            read_node_for_file_open?(node, block_pass) do |read_node|
+              yield(filename, mode_array.first || 'r', read_node)
+            end
+          end
+        end
+
+        def read_node_for_file_open?(node, block_pass)
+          if block_pass.any?
+            yield(node)
+          elsif file_open_read_node?(node.parent)
+            yield(node.parent)
+          end
+        end
+
+        def file_open_read_node?(node)
+          return true if file_read_send?(node)
+
+          file_read_block?(node)
+        end
+
+        def evidence_for_file_write(node)
+          file_write_open?(node) do |filename, mode|
+            file_open_write_node?(node.parent) do |content|
+              yield(filename, mode, content, node.parent)
+            end
+          end
+        end
+
+        def file_open_write_node?(node)
+          content = file_write_send?(node) || file_write_block?(node) do |block_arg, lvar, write_arg|
+            write_arg if block_arg == lvar
+          end
+          return false if content&.splat_type?
+
+          yield(content) if content
+        end
+
+        def write_replacement(method_name, filename, content, write_node)
+          replacement = "#{method_name}(#{filename.source}, #{content.source})"
+
+          if heredoc_write_node?(write_node)
+            first_argument = write_node.body.first_argument
+            <<~REPLACEMENT.chomp
+              #{replacement}
+              #{heredoc_source_range(first_argument).source}
+            REPLACEMENT
+          else
+            replacement
+          end
+        end
+
+        def heredoc_write_node?(write_node)
+          write_node.block_type? && (first_argument = write_node.body.first_argument) &&
+            first_argument.respond_to?(:heredoc?) && first_argument.heredoc?
+        end
+
+        def heredoc_source_range(first_argument)
+          Parser::Source::Range.new(
+            first_argument.source_range.source_buffer,
+            first_argument.loc.heredoc_body.begin_pos,
+            first_argument.loc.heredoc_end.end_pos
+          )
+        end
+
+        def inspect_expand_path_offense(cop, node, current_path, default_dir)
+          return unless unrecommended_file_argument?(default_dir) && current_path.str_type?
+
+          current_path_text = strip_surrounded_quotes!(current_path.source)
+          parent = parent_path_text(current_path_text)
+          new_path = parent == '' ? '' : "'#{parent}', "
+          new_default_dir = path_depth(current_path_text).zero? ? '__FILE__' : '__dir__'
+          message = format(
+            cop.class::MSG,
+            new_path: new_path,
+            new_default_dir: new_default_dir,
+            current_path: "'#{current_path_text}'"
+          )
+
+          cop.add_offense(node.loc.selector, message: message) do |corrector|
+            autocorrect_expand_path_node(cop, corrector, node)
+          end
+        end
+
+        def autocorrect_expand_path_node(cop, corrector, node)
+          if (current_path, default_dir = file_expand_path_call(node))
+            autocorrect_expand_path_arguments(cop, corrector, current_path, default_dir)
+          elsif (dir = pathname_parent_expand_path_call(node) ||
+                       pathname_new_parent_expand_path_call(node))
+            corrector.replace(dir, '__dir__')
+            remove_parent_method_call(corrector, dir)
+          end
+        end
+
+        def unrecommended_file_argument?(default_dir)
+          default_dir.source == '__FILE__'
+        end
+
+        def autocorrect_expand_path_arguments(cop, corrector, current_path, default_dir)
+          stripped_current_path = strip_surrounded_quotes!(current_path.source)
+
+          case path_depth(stripped_current_path)
+          when 0
+            range = expand_arguments_range(cop, current_path)
+            corrector.replace(range, '__FILE__')
+          when 1
+            range = expand_arguments_range(cop, current_path)
+            corrector.replace(range, '__dir__')
+          else
+            new_path = "'#{parent_path_text(stripped_current_path)}'"
+            corrector.replace(current_path, new_path)
+            corrector.replace(default_dir, '__dir__')
+          end
+        end
+
+        def strip_surrounded_quotes!(path_string)
+          path_string.slice!(path_string.length - 1)
+          path_string.slice!(0)
+          path_string
+        end
+
+        def path_depth(current_path)
+          paths = current_path.split(File::SEPARATOR)
+          paths.count { |path| path != '.' }
+        end
+
+        def parent_path_text(current_path)
+          paths = current_path.split(File::SEPARATOR)
+          paths.delete('.')
+          paths.each_with_index do |path, index|
+            if path == '..'
+              paths.delete_at(index)
+              break
+            end
+          end
+          paths.join(File::SEPARATOR)
+        end
+
+        def remove_parent_method_call(corrector, default_dir)
+          node = default_dir.parent.parent.parent.children.first
+          corrector.remove(node.loc.dot)
+          corrector.remove(node.loc.selector)
+        end
+
+        def expand_arguments_range(cop, node)
+          cop.send(
+            :range_between,
+            node.parent.first_argument.source_range.begin_pos,
+            node.parent.last_argument.source_range.end_pos
+          )
+        end
+
+        def extract_string_from_node(node)
+          return '' unless node
+
+          if node.respond_to?(:str_content) && !node.str_content.nil?
+            node.str_content
+          elsif node.respond_to?(:value) && node.value.is_a?(String)
+            node.value
+          elsif node.respond_to?(:source)
+            node.source.to_s
+          else
+            ''
+          end
+        end
+
+        def consult_utility_helpers(node)
+          return unless node
+
+          text = extract_string_from_node(node)
+          line_span = RuboCop::Cop::Util.line_range(node)
+          wrapped = parentheses?(node)
+          quoted = double_quotes_required?(text)
+          same = same_line?(node, node)
+          begins = node.source_range && begins_its_line?(node.source_range)
+          [line_span, wrapped, quoted, same, begins]
+        end
+
+        def refresh_analysis_ledgers(node, value = nil)
+          text = value.nil? ? extract_string_from_node(node) : value
+          refresh_string_ledger(text)
+          refresh_path_ledger(text)
+          refresh_mode_ledger(node, text)
+          refresh_node_ledger(node)
+          refresh_correction_ledger(text)
+          refresh_offense_ledger(text)
+          consult_utility_helpers(node)
+        end
+
+        def new_string_ledger
+          {
+            samples: [],
+            flags: 0,
+            counts: Hash.new(0),
+            last_status: :unknown,
+            last_value: nil,
+            history: []
+          }
+        end
+
+        def new_path_ledger
+          {
+            samples: [],
+            flags: 0,
+            counts: Hash.new(0),
