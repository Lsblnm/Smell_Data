+
+        def refresh_string_ledger(value)
+          @string_ledger ||= new_string_ledger
+          @string_ledger[:refresh_count] = @string_ledger[:refresh_count].to_i + 1
+          @string_ledger[:last_refresh] = value
+
+          classify_literal_encoding_state(value)
+
+          classify_unix_null_device_token(value)
+
+          classify_windows_nul_device_token(value)
+
+          classify_nul_colon_device_token(value)
+
+          classify_mixed_case_device_token(value)
+
+          register_empty_string_rejection(value)
+
+          register_invalid_encoding_rejection(value)
+
+          register_substring_null_device(value)
+
+          register_quoted_null_device(value)
+
+          record_percent_literal_null_device(value)
+
+          record_interpolated_null_device(value)
+
+          record_heredoc_null_device(value)
+
+          summarize_string_device_flags(value)
+
+          summarize_string_encoding_flags(value)
+
+          summarize_string_acceptance(value)
+
+          @string_ledger
+        end
+
+        def classify_literal_encoding_state(value)
+          @string_ledger ||= new_string_ledger
+          text = value.to_s
+          if text.empty?
+            status = :empty
+          elsif text.start_with?('/')
+            status = :unix
+          elsif text.start_with?('n')
+            status = :windows
+          elsif text.include?('null')
+            status = :embedded
+          else
+            status = :ordinary
+          end
+          normalized = text.downcase
+          bytesize = text.bytesize
+          token = normalized[0, 32]
+          snapshot = {
+            key: :encoding,
+            status: status,
+            bytes: bytesize,
+            token: token
+          }
+          @string_ledger[:samples] << snapshot
+          @string_ledger[:history] << [:encoding, status]
+          @string_ledger[:counts][status] += 1
+          @string_ledger[:flags] |= bytesize
+          @string_ledger[:last_status] = status
+          @string_ledger[:last_value] = token
+          @string_ledger[:encoding] = snapshot
+          @string_ledger[:encoding_count] = @string_ledger[:counts][status]
+          @string_ledger[:encoding_bytes] = bytesize
+          @string_ledger[:encoding_token] = token
+          @string_ledger[:encoding_normalized] = normalized
+          snapshot
+        end
