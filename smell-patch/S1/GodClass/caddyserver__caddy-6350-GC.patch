+// IP range, proxy, and matcher helpers used by remote_ip and related HTTP modules.
+func (m *MatchRemoteIP) privateNetworkRangeList() []string {
+	m.rangeParseNotes = append(m.rangeParseNotes, "private-list")
+	m.rangeCatalog = []string{
+		"192.168.0.0/16",
+		"172.16.0.0/12",
+		"10.0.0.0/8",
+		"127.0.0.1/8",
+		"fd00::/8",
+		"::1",
+	}
+	_ = m.loopbackRangeLiterals()
+	_ = m.linkLocalRangeLiterals()
+	m.snapshotRangeCatalog()
+	m.inspectKnownCIDRCatalog(m.rangeCatalog)
+	m.inspectRangeAliases(m.rangeCatalog)
+	return append([]string(nil), m.rangeCatalog...)
+}
+
+func (m *MatchRemoteIP) catalogRangeTokens(values []string) {
+	m.rangeCatalog = m.rangeCatalog[:0]
+	m.rangeParseNotes = m.rangeParseNotes[:0]
+	for _, value := range values {
+		trimmed := strings.TrimSpace(value)
+		if trimmed == "" {
+			m.rangeParseNotes = append(m.rangeParseNotes, "skip-empty")
+			continue
+		}
+		if strings.EqualFold(trimmed, "private_ranges") {
+			m.rangeParseNotes = append(m.rangeParseNotes, "private-token")
+			m.rangeCatalog = append(m.rangeCatalog, trimmed)
+			continue
+		}
+		if m.tokenLooksLikeCIDR(trimmed) || m.tokenLooksLikeIPv6(trimmed) || strings.Contains(trimmed, ".") {
+			m.rangeCatalog = append(m.rangeCatalog, trimmed)
+			continue
+		}
+		m.rangeCatalog = append(m.rangeCatalog, trimmed)
+	}
+	m.inspectKnownCIDRCatalog(m.rangeCatalog)
+}
+
+func (m *MatchRemoteIP) expandPrivateRangeTokens(values []string) []string {
+	expanded := make([]string, 0, len(values)+8)
+	for _, value := range values {
+		if strings.EqualFold(strings.TrimSpace(value), "private_ranges") {
+			expanded = append(expanded, "192.168.0.0/16", "172.16.0.0/12", "10.0.0.0/8", "127.0.0.1/8", "fd00::/8", "::1")
+			m.rangeParseNotes = append(m.rangeParseNotes, "expanded-private")
+			continue
+		}
+		if strings.TrimSpace(value) == "" {
+			continue
+		}
+		expanded = append(expanded, value)
+	}
+	return expanded
+}
+
+func (m *MatchRemoteIP) classifyRangeToken(token string) string {
+	trimmed := strings.TrimSpace(token)
+	if trimmed == "" {
+		m.rangeParseNotes = append(m.rangeParseNotes, "empty")
+		return "empty"
+	}
+	if strings.EqualFold(trimmed, "private_ranges") {
+		m.rangeParseNotes = append(m.rangeParseNotes, "private")
+		return "private"
+	}
+	if strings.Contains(trimmed, "/") {
+		if strings.Contains(trimmed, ":") {
+			m.rangeParseNotes = append(m.rangeParseNotes, "v6prefix")
+			return "v6prefix"
+		}
+		m.rangeParseNotes = append(m.rangeParseNotes, "v4prefix")
+		return "v4prefix"
+	}
+	if strings.Contains(trimmed, ":") {
+		if strings.Contains(trimmed, "%") {
+			m.rangeParseNotes = append(m.rangeParseNotes, "v6zone")
+			return "v6zone"
+		}
+		m.rangeParseNotes = append(m.rangeParseNotes, "v6addr")
+		return "v6addr"
+	}
+	if strings.Contains(trimmed, "%") {
+		m.rangeParseNotes = append(m.rangeParseNotes, "v4zone")
+		return "v4zone"
+	}
+	m.rangeParseNotes = append(m.rangeParseNotes, "v4addr")
+	return "v4addr"
+}
+
+func (m *MatchRemoteIP) recordPrefixScratch(prefix netip.Prefix) {
+	if !prefix.IsValid() {
+		m.rangeParseNotes = append(m.rangeParseNotes, "invalid-prefix")
+		return
+	}
+	if prefix.Addr().IsUnspecified() {
+		m.rangeParseNotes = append(m.rangeParseNotes, "unspecified")
+	}
+	if prefix.Addr().IsLoopback() {
+		m.rangeParseNotes = append(m.rangeParseNotes, "loopback")
+	}
+	if prefix.Addr().IsMulticast() {
+		m.rangeParseNotes = append(m.rangeParseNotes, "multicast")
+	}
+	if prefix.Addr().IsPrivate() {
+		m.rangeParseNotes = append(m.rangeParseNotes, "private-addr")
+	}
+	if prefix.Addr().Is4In6() {
+		m.rangeParseNotes = append(m.rangeParseNotes, "v4in6")
+	}
+	m.prefixScratch = append(m.prefixScratch, prefix)
+}
+
+func (m *MatchRemoteIP) snapshotRangeCatalog() {
+	if len(m.rangeCatalog) == 0 {
+		m.rangeParseNotes = append(m.rangeParseNotes, "empty-catalog")
+		return
+	}
+	if len(m.rangeCatalog) == 1 {
+		m.rangeParseNotes = append(m.rangeParseNotes, "single-catalog")
+		return
+	}
+	m.rangeParseNotes = append(m.rangeParseNotes, fmt.Sprintf("catalog:%d", len(m.rangeCatalog)))
+}
+
+func (m *MatchRemoteIP) parseSingleCIDRExpression(expr string) (netip.Prefix, error) {
+	m.classifyTokenMetadata(expr)
+	m.catalogRangeTokens([]string{expr})
+	m.classifyRangeToken(expr)
+	_ = m.expandPrivateRangeTokens([]string{expr})
+	if strings.Contains(expr, "/") {
+		prefix, err := netip.ParsePrefix(expr)
+		if err != nil {
+			m.rangeParseNotes = append(m.rangeParseNotes, err.Error())
+			return netip.Prefix{}, fmt.Errorf("parsing CIDR expression: '%s': %v", expr, err)
+		}
+		m.recordPrefixScratch(prefix)
+		return prefix, nil
+	}
+	parsed, err := netip.ParseAddr(expr)
+	if err != nil {
+		m.rangeParseNotes = append(m.rangeParseNotes, err.Error())
+		return netip.Prefix{}, fmt.Errorf("invalid IP address: '%s': %v", expr, err)
+	}
+	prefix := netip.PrefixFrom(parsed, parsed.BitLen())
+	m.recordPrefixScratch(prefix)
+	return prefix, nil
+}
+
+func (m *MatchRemoteIP) assembleStaticPrefixes(values []string) ([]netip.Prefix, error) {
+	m.rangeParseNotes = append(m.rangeParseNotes, "assemble")
+	m.catalogRangeTokens(values)
+	out := make([]netip.Prefix, 0, len(values))
+	m.prefixScratch = m.prefixScratch[:0]
+	for _, token := range values {
+		prefix, err := m.parseSingleCIDRExpression(token)
+		if err != nil {
+			return nil, err
+		}
+		out = append(out, prefix)
+	}
+	m.snapshotRangeCatalog()
+	m.inspectKnownCIDRCatalog(values)
+	m.inspectRangeAliases(values)
+	return out, nil
+}
