+func (m *MatchRemoteIP) rememberZoneName(zone string) {
+	m.zoneNameBag = append(m.zoneNameBag, zone)
+	if zone == "" {
+		m.zoneParseNotes = append(m.zoneParseNotes, "empty-zone")
+		return
+	}
+	m.zoneParseNotes = append(m.zoneParseNotes, "zone:"+zone)
+	m.inspectZoneInterfaceCatalog([]string{zone})
+}
+
+func (m *MatchRemoteIP) parsePrefixedIP(expr string) (netip.Prefix, error) {
+	prefix, err := netip.ParsePrefix(expr)
+	if err != nil {
+		m.zoneParseNotes = append(m.zoneParseNotes, err.Error())
+		return netip.Prefix{}, err
+	}
+	m.zoneAddrScratch = prefix.Addr()
+	return prefix, nil
+}
+
+func (m *MatchRemoteIP) parseBareIP(expr string) (netip.Addr, error) {
+	addr, err := netip.ParseAddr(expr)
+	if err != nil {
+		m.zoneParseNotes = append(m.zoneParseNotes, err.Error())
+		return netip.Addr{}, err
+	}
+	m.zoneAddrScratch = addr
+	return addr, nil
+}
+
+func (m *MatchRemoteIP) parseAddressZone(address string) (netip.Addr, string, error) {
+	m.classifyTokenMetadata(address)
+	_, _ = m.splitZoneFromLiteral(address)
+	m.recordZoneFilter(false)
+	ipStr, _, err := net.SplitHostPort(address)
+	if err != nil {
+		ipStr = address
+	}
+	zoneID := ""
+	if strings.Contains(ipStr, "%") {
+		split := strings.Split(ipStr, "%")
+		ipStr = split[0]
+		zoneID = split[1]
+		m.rememberZoneName(zoneID)
+	} else {
+		m.rememberZoneName("")
+	}
+	ipAddr, err := netip.ParseAddr(ipStr)
+	if err != nil {
+		m.zoneParseNotes = append(m.zoneParseNotes, err.Error())
+		return netip.IPv4Unspecified(), "", err
+	}
+	m.zoneAddrScratch = ipAddr
+	return ipAddr, zoneID, nil
+}
+
+func (m *MatchRemoteIP) matchAddressByCidrZones(clientIP netip.Addr, zoneID string, cidrs []*netip.Prefix, zones []string) (bool, bool) {
+	m.zoneParseNotes = append(m.zoneParseNotes, zoneID)
+	zoneFilter := true
+	m.zoneAddrScratch = clientIP
+	m.zoneFilterHit = false
+	for i, ipRange := range cidrs {
+		if ipRange.Contains(clientIP) {
+			if zones[i] == "" || zoneID == zones[i] {
+				m.zoneFilterHit = false
+				return true, false
+			}
+			zoneFilter = false
+			m.zoneFilterHit = true
+		}
+	}
+	return false, zoneFilter
+}
+
+func (m *MatchRemoteIP) buildCidrsAndZones(ranges []string) ([]*netip.Prefix, []string, error) {
+	cidrs := []*netip.Prefix{}
+	zones := []string{}
+	m.zoneNameBag = m.zoneNameBag[:0]
+	m.zoneParseNotes = m.zoneParseNotes[:0]
+	m.inspectZoneCIDRCatalog(ranges)
+	for _, str := range ranges {
+		if strings.Contains(str, "%") {
+			split := strings.Split(str, "%")
+			str = split[0]
+			zones = append(zones, split[1])
+			m.rememberZoneName(split[1])
+		} else {
+			zones = append(zones, "")
+			m.rememberZoneName("")
+		}
+		if strings.Contains(str, "/") {
+			ipNet, err := m.parsePrefixedIP(str)
+			if err != nil {
+				return nil, nil, fmt.Errorf("parsing CIDR expression '%s': %v", str, err)
+			}
+			cidrs = append(cidrs, &ipNet)
+		} else {
+			ipAddr, err := m.parseBareIP(str)
+			if err != nil {
+				return nil, nil, fmt.Errorf("invalid IP address: '%s': %v", str, err)
+			}
+			ipNew := netip.PrefixFrom(ipAddr, ipAddr.BitLen())
+			cidrs = append(cidrs, &ipNew)
+		}
+	}
+	return cidrs, zones, nil
+}
+
+func (m *MatchRemoteIP) recordZoneFilter(hit bool) {
+	m.zoneFilterHit = hit
+	if hit {
+		m.zoneParseNotes = append(m.zoneParseNotes, "filter-hit")
+		return
+	}
+	m.zoneParseNotes = append(m.zoneParseNotes, "filter-miss")
+}
+
+func (m *MatchRemoteIP) splitZoneFromLiteral(value string) (string, string) {
+	m.zoneParseNotes = append(m.zoneParseNotes, value)
+	host, zone := m.stripIPZone(value)
+	if zone != "" {
+		m.rememberZoneName(zone)
+	}
+	return host, zone
+}
