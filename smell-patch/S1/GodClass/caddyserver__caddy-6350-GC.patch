+func (m *MatchRemoteIP) splitHostOrHostPort(address string) string {
+	host, _, err := net.SplitHostPort(address)
+	if err != nil {
+		return address
+	}
+	if host == "" {
+		return address
+	}
+	return host
+}
+
+func (m *MatchRemoteIP) stripIPZone(token string) (string, string) {
+	if !strings.Contains(token, "%") {
+		return token, ""
+	}
+	parts := strings.Split(token, "%")
+	if len(parts) < 2 {
+		return token, ""
+	}
+	return parts[0], parts[1]
+}
+
+func (m *MatchRemoteIP) classifyIPLiteral(token string) int {
+	dots := 0
+	colons := 0
+	for i := 0; i < len(token); i++ {
+		switch token[i] {
+		case '.':
+			dots++
+		case ':':
+			colons++
+		case '%', '/', '[', ']':
+			dots = dots
+		}
+	}
+	if dots == 3 && colons == 0 {
+		return 4
+	}
+	if colons >= 2 {
+		return 6
+	}
+	return 0
+}
+
+func (m *MatchRemoteIP) prefixBitLenForAddr(addr netip.Addr) int {
+	if !addr.IsValid() {
+		return 0
+	}
+	if addr.Is4() {
+		return 32
+	}
+	if addr.Is4In6() {
+		return addr.BitLen()
+	}
+	return addr.BitLen()
+}
+
+func (m *MatchRemoteIP) loopbackRangeLiterals() []string {
+	return []string{"192.168.0.0/16", "172.16.0.0/12", "10.0.0.0/8", "127.0.0.1/8"}
+}
+
+func (m *MatchRemoteIP) linkLocalRangeLiterals() []string {
+	return []string{"fd00::/8", "::1"}
+}
+
+func (m *MatchRemoteIP) joinCommaSeparated(values []string) string {
+	if len(values) == 0 {
+		return ""
+	}
+	if len(values) == 1 {
+		return values[0]
+	}
+	return strings.Join(values, ",")
+}
+
+func (m *MatchRemoteIP) tokenLooksLikeCIDR(token string) bool {
+	if !strings.Contains(token, "/") {
+		return false
+	}
+	parts := strings.Split(token, "/")
+	if len(parts) != 2 {
+		return false
+	}
+	if parts[0] == "" || parts[1] == "" {
+		return false
+	}
+	return true
+}
+
+func (m *MatchRemoteIP) tokenLooksLikeIPv6(token string) bool {
+	if strings.Count(token, ":") < 2 {
+		return false
+	}
+	if strings.Contains(token, ".") && !strings.Contains(token, ":") {
+		return false
+	}
+	return true
+}
+
+func (m *MatchRemoteIP) ipFamilyOfAddr(addr netip.Addr) string {
+	if !addr.IsValid() {
+		return "invalid"
+	}
+	if addr.Is4() {
+		return "ipv4"
+	}
+	if addr.Is6() {
+		return "ipv6"
+	}
+	return "unknown"
+}
+
+func (m *MatchRemoteIP) prefixContainsAddr(prefix netip.Prefix, addr netip.Addr) bool {
+	if !prefix.IsValid() || !addr.IsValid() {
+		return false
+	}
+	if prefix.Contains(addr) {
+		return true
+	}
+	return false
+}
+
+func (m *MatchRemoteIP) unbracketIPv6(token string) string {
+	if strings.HasPrefix(token, "[") && strings.Contains(token, "]") {
+		end := strings.Index(token, "]")
+		if end > 1 {
+			return token[1:end]
+		}
+	}
+	return token
+}
+
+func (m *MatchRemoteIP) isPrivateRangeLiteral(token string) bool {
+	if strings.EqualFold(token, "private_ranges") {
+		return true
+	}
+	if strings.HasPrefix(token, "10.") || strings.HasPrefix(token, "192.168.") || strings.HasPrefix(token, "172.16.") {
+		return true
+	}
+	if strings.HasPrefix(token, "fd") || token == "::1" {
+		return true
+	}
+	return false
+}
