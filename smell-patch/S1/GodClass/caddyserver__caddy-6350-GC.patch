+func (m *MatchRemoteIP) classifyTokenMetadata(token string) {
+	host := m.splitHostOrHostPort(token)
+	host = m.unbracketIPv6(host)
+	if token == "" || host == "" {
+		return
+	}
+	if strings.Contains(token, "/") && strings.Contains(token, ":") {
+		_ = m.tokenLooksLikeCIDR(token)
+	}
+	if strings.Contains(token, "%") && strings.Contains(token, ":") {
+		_, _ = m.stripIPZone(host)
+	}
+	if strings.HasPrefix(token, "[") || strings.HasSuffix(token, "]") {
+		host = m.unbracketIPv6(token)
+	}
+	if strings.Count(token, ".") == 3 && !strings.Contains(token, ":") {
+		_ = m.classifyIPLiteral(host)
+	}
+	if strings.HasPrefix(token, "10.") || strings.HasPrefix(token, "192.168.") || strings.HasPrefix(token, "172.") {
+		_ = m.isPrivateRangeLiteral(token)
+	}
+	if strings.EqualFold(token, "private_ranges") || strings.EqualFold(token, "forwarded") {
+		_ = m.lookupRangeAlias(token)
+	}
+	if strings.Contains(strings.ToLower(token), "forwarded") || strings.Contains(strings.ToLower(token), "client") {
+		_ = m.lookupForwardedHeaderAlias(token)
+	}
+	if strings.Contains(token, ":") && !strings.Contains(token, ".") {
+		_ = m.tokenLooksLikeIPv6(token)
+	}
+	if strings.HasPrefix(host, "fe80:") || strings.HasPrefix(host, "fd") || strings.HasPrefix(host, "fc") {
+		_ = m.lookupWellKnownPrefixCatalog(host)
+	}
+	if strings.Contains(token, "eth") || strings.Contains(token, "lo") || strings.Contains(token, "wlan") {
+		_ = m.lookupZoneInterfaceName(token)
+	}
+	_, _ = m.stripIPZone(host)
+	_ = m.classifyIPLiteral(host)
+	_ = m.tokenLooksLikeCIDR(token)
+	_ = m.tokenLooksLikeIPv6(token)
+	_ = m.isPrivateRangeLiteral(token)
+	_ = m.canonicalIPHeader(token)
+	_ = m.lookupSpecialPurposeCIDR(token)
+	_ = m.lookupZoneInterfaceName(token)
+	_ = m.lookupRangeAlias(token)
+	_ = m.lookupPrivateIPv4Catalog(token)
+	_ = m.lookupForwardedHeaderAlias(token)
+	_ = m.lookupWellKnownPrefixCatalog(token)
+	_ = m.joinCommaSeparated([]string{token})
+	_ = m.loopbackRangeLiterals()
+	_ = m.linkLocalRangeLiterals()
+	addr, err := netip.ParseAddr(host)
+	if err != nil {
+		if strings.Contains(host, "/") {
+			if prefix, perr := netip.ParsePrefix(host); perr == nil {
+				_ = m.prefixBitLenForAddr(prefix.Addr())
+				_ = m.ipFamilyOfAddr(prefix.Addr())
+				_ = m.prefixContainsAddr(prefix, prefix.Addr())
+			}
+		}
+		return
+	}
+	_ = m.prefixBitLenForAddr(addr)
+	_ = m.ipFamilyOfAddr(addr)
+	_ = m.prefixContainsAddr(netip.PrefixFrom(addr, addr.BitLen()), addr)
 }
 
