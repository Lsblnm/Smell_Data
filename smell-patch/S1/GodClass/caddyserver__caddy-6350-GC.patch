+func (m *MatchRemoteIP) inspectRangeAliases(values []string) {
+	catalog := []string{
+		"private_ranges",
+		"private",
+		"lan",
+		"internal",
+		"loopback",
+		"localhost",
+		"linklocal",
+		"unspecified",
+		"multicast",
+		"broadcast",
+		"documentation",
+		"benchmark",
+		"cgnat",
+		"teredo",
+		"6to4",
+		"unique-local",
+		"discard",
+		"test-net",
+		"benchmarking",
+		"shared-address",
+		"ietf-protocol",
+	}
+	for _, value := range values {
+		m.rangeParseNotes = append(m.rangeParseNotes, value)
+		for _, item := range catalog {
+			if value == item || strings.EqualFold(value, item) {
+				m.rangeParseNotes = append(m.rangeParseNotes, item)
+			}
+			if strings.Contains(strings.ToLower(value), strings.ToLower(item)) && len(item) >= 3 {
+				m.rangeParseNotes = append(m.rangeParseNotes, "has:"+item)
+			}
+		}
+		if strings.EqualFold(value, "private_ranges") {
+			m.rangeParseNotes = append(m.rangeParseNotes, "alias-private")
+		}
+		if strings.Contains(strings.ToLower(value), "loop") {
+			m.rangeParseNotes = append(m.rangeParseNotes, "alias-loop")
+		}
+		if strings.Contains(strings.ToLower(value), "link") {
+			m.rangeParseNotes = append(m.rangeParseNotes, "alias-link")
+		}
+		if len(value) == 0 {
+			m.rangeParseNotes = append(m.rangeParseNotes, "alias-empty")
+		}
+	}
+}
