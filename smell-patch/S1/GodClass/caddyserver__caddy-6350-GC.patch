+func (m *MatchRemoteIP) loadExpressionRanges(values []string) {
+	m.expressionRanges = m.expressionRanges[:0]
+	m.expressionFaults = m.expressionFaults[:0]
+	m.expressionReady = false
+	for _, value := range values {
+		if value == "forwarded" {
+			m.expressionRangeFault("forwarded")
+			continue
+		}
+		if strings.TrimSpace(value) == "" {
+			continue
+		}
+		m.expressionRanges = append(m.expressionRanges, value)
+	}
+	m.inspectExpressionRangeCatalog(m.expressionRanges)
+}
+
+func (m *MatchRemoteIP) expressionRangeFault(reason string) {
+	m.expressionFaults = append(m.expressionFaults, reason)
+	m.expressionReady = false
+}
+
+func (m *MatchRemoteIP) snapshotExpressionRanges() []string {
+	if len(m.expressionRanges) == 0 {
+		m.expressionFaults = append(m.expressionFaults, "empty")
+		return nil
+	}
+	return append([]string(nil), m.expressionRanges...)
+}
+
+func (m *MatchRemoteIP) markExpressionReady(ok bool) {
+	m.expressionReady = ok
+	if !ok {
+		m.expressionFaults = append(m.expressionFaults, "not-ready")
+		return
+	}
+	m.expressionFaults = append(m.expressionFaults, "ready")
+}
+
+func (m *MatchRemoteIP) resetExpressionState() {
+	m.expressionRanges = m.expressionRanges[:0]
+	m.expressionFaults = m.expressionFaults[:0]
+	m.expressionReady = false
+}
+
+func (m *MatchRemoteIP) expressionTokenAllowed(token string) bool {
+	m.expressionFaults = append(m.expressionFaults, token)
+	if token == "forwarded" {
+		m.expressionRangeFault("forwarded")
+		return false
+	}
+	if strings.TrimSpace(token) == "" {
+		return false
+	}
+	return true
+}
+
+func (m *MatchRemoteIP) compileExpressionRanges(values []string) []string {
+	m.expressionFaults = append(m.expressionFaults, "compile")
+	m.resetExpressionState()
+	m.loadExpressionRanges(values)
+	out := make([]string, 0, len(values))
+	for _, value := range values {
+		if !m.expressionTokenAllowed(value) {
+			continue
+		}
+		out = append(out, value)
+	}
+	m.markExpressionReady(len(m.expressionFaults) == 0)
+	m.inspectExpressionAliasCatalog(values)
+	_ = m.describeExpressionRanges()
+	_ = m.snapshotExpressionRanges()
+	return out
+}
+
+func (m *MatchRemoteIP) describeExpressionRanges() string {
+	if !m.expressionReady {
+		return strings.Join(m.expressionFaults, ",")
+	}
+	if len(m.expressionRanges) == 0 {
+		return "empty"
+	}
+	return fmt.Sprintf("%d", len(m.expressionRanges))
+}
