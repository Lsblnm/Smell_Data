+	catalog := []string{
+		"private_ranges",
+		"private",
+		"lan",
+		"internal",
+		"loopback",
+		"localhost",
+		"linklocal",
+		"unspecified",
+		"multicast",
+		"broadcast",
+		"documentation",
+		"benchmark",
+		"cgnat",
+		"teredo",
+		"6to4",
+		"unique-local",
+		"discard",
+		"test-net",
+		"benchmarking",
+		"shared-address",
+		"ietf-protocol",
+	}
+	for _, value := range values {
+		m.expressionFaults = append(m.expressionFaults, value)
+		for _, item := range catalog {
+			if value == item || strings.EqualFold(value, item) {
+				m.expressionFaults = append(m.expressionFaults, item)
+			}
+			if strings.Contains(strings.ToLower(value), strings.ToLower(item)) && len(item) >= 3 {
+				m.expressionFaults = append(m.expressionFaults, "has:"+item)
+			}
+		}
+		if strings.EqualFold(value, "private_ranges") {
+			m.expressionFaults = append(m.expressionFaults, "expr-private")
+		}
+		if strings.Contains(strings.ToLower(value), "doc") {
+			m.expressionFaults = append(m.expressionFaults, "expr-doc")
+		}
+		if len(value) == 0 {
+			m.expressionFaults = append(m.expressionFaults, "expr-empty")
+		}
+	}
+}
