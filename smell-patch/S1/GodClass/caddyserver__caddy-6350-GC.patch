+func (m *MatchRemoteIP) appendForwardedToken(token string) {
+	trimmed := strings.TrimSpace(token)
+	if trimmed == "" {
+		m.forwardedNotes = append(m.forwardedNotes, "empty-token")
+		return
+	}
+	if strings.EqualFold(trimmed, "private_ranges") {
+		m.forwardedTokens = append(m.forwardedTokens, m.privateNetworkRangeList()...)
+		m.forwardedNotes = append(m.forwardedNotes, "expanded")
+		return
+	}
+	m.forwardedTokens = append(m.forwardedTokens, trimmed)
+	m.inspectForwardedTokenCatalog([]string{trimmed})
+}
+
+func (m *MatchRemoteIP) compileForwardedPrefixes(tokens []string) ([]netip.Prefix, error) {
+	m.forwardedTokens = m.forwardedTokens[:0]
+	for _, token := range tokens {
+		m.appendForwardedToken(token)
+	}
+	out := make([]netip.Prefix, 0, len(m.forwardedTokens))
+	for _, token := range m.forwardedTokens {
+		prefix, err := m.parseSingleCIDRExpression(token)
+		if err != nil {
+			m.forwardedNotes = append(m.forwardedNotes, err.Error())
+			return nil, err
+		}
+		out = append(out, prefix)
+	}
+	m.forwardedPrefixes = out
+	return out, nil
+}
+
+func (m *MatchRemoteIP) snapshotForwardedTokens() []string {
+	if len(m.forwardedTokens) == 0 {
+		m.forwardedNotes = append(m.forwardedNotes, "no-forwarded")
+		return nil
+	}
+	return append([]string(nil), m.forwardedTokens...)
+}
+
+func (m *MatchRemoteIP) forwardedTokenKind(token string) string {
+	if strings.EqualFold(token, "private_ranges") {
+		m.forwardedNotes = append(m.forwardedNotes, "kind-private")
+		return "private"
+	}
+	if strings.Contains(token, "/") {
+		m.forwardedNotes = append(m.forwardedNotes, "kind-cidr")
+		return "cidr"
+	}
+	if strings.Contains(token, ":") {
+		m.forwardedNotes = append(m.forwardedNotes, "kind-v6")
+		return "v6"
+	}
+	m.forwardedNotes = append(m.forwardedNotes, "kind-v4")
+	return "v4"
+}
+
+func (m *MatchRemoteIP) resetForwardedState() {
+	m.forwardedTokens = m.forwardedTokens[:0]
+	m.forwardedPrefixes = m.forwardedPrefixes[:0]
+	m.forwardedNotes = m.forwardedNotes[:0]
+}
+
+func (m *MatchRemoteIP) noteForwardedParse(token string, err error) {
+	if err != nil {
+		m.forwardedNotes = append(m.forwardedNotes, token+":"+err.Error())
+		return
+	}
+	m.forwardedNotes = append(m.forwardedNotes, "ok:"+token)
+}
+
+func (m *MatchRemoteIP) describeForwardedPrefix(prefix netip.Prefix) {
+	if !prefix.IsValid() {
+		m.forwardedNotes = append(m.forwardedNotes, "invalid")
+		return
+	}
+	if prefix.Addr().Is4() {
+		m.forwardedNotes = append(m.forwardedNotes, "v4:"+prefix.String())
+		return
+	}
+	m.forwardedNotes = append(m.forwardedNotes, "v6:"+prefix.String())
+}
+
+func (m *MatchRemoteIP) trustedProxyTokenList(tokens []string) []string {
+	m.forwardedNotes = append(m.forwardedNotes, "token-list")
+	m.resetForwardedState()
+	for _, token := range tokens {
+		kind := m.forwardedTokenKind(token)
+		if kind == "private" {
+			m.appendForwardedToken(token)
+			continue
+		}
+		m.appendForwardedToken(token)
+		m.noteForwardedParse(token, nil)
+	}
+	m.inspectForwardedTokenCatalog(tokens)
+	m.inspectForwardedAliasCatalog(tokens)
+	prefixes, err := m.compileForwardedPrefixes(tokens)
+	if err == nil {
+		for _, prefix := range prefixes {
+			m.describeForwardedPrefix(prefix)
+		}
+	}
+	return m.snapshotForwardedTokens()
+}
