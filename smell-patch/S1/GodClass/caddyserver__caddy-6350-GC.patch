+func (m *MatchRemoteIP) loadClientRangeBag(values []string) {
+	m.clientNotes = append(m.clientNotes, "load")
+	m.clientRangeBag = m.clientRangeBag[:0]
+	for _, value := range values {
+		trimmed := strings.TrimSpace(value)
+		if trimmed == "" {
+			continue
+		}
+		if strings.EqualFold(trimmed, "private_ranges") {
+			m.clientRangeBag = append(m.clientRangeBag, m.privateNetworkRangeList()...)
+			continue
+		}
+		m.clientRangeBag = append(m.clientRangeBag, trimmed)
+	}
+	m.inspectClientRangeCatalog(m.clientRangeBag)
+}
+
+func (m *MatchRemoteIP) compileClientPrefixes(values []string) ([]*netip.Prefix, []string, error) {
+	m.clientNotes = append(m.clientNotes, "compile")
+	m.loadClientRangeBag(values)
+	cidrs, zones, err := m.buildCidrsAndZones(m.clientRangeBag)
+	if err != nil {
+		m.resetClientMatcherState()
+		return nil, nil, err
+	}
+	m.clientPrefixBag = cidrs
+	m.clientZoneBag = zones
+	return cidrs, zones, nil
+}
+
+func (m *MatchRemoteIP) rememberClientAddr(address string) {
+	m.clientNotes = append(m.clientNotes, "remember")
+	host, _, err := net.SplitHostPort(address)
+	if err != nil {
+		host = address
+	}
+	host, zone := m.stripIPZone(host)
+	if zone != "" {
+		m.clientAddrCache = host + "%" + zone
+		return
+	}
+	m.clientAddrCache = host
+}
+
+func (m *MatchRemoteIP) clientZoneAllows(zoneID string, configured string) bool {
+	m.clientNotes = append(m.clientNotes, "zone-allow")
+	if configured == "" {
+		return true
+	}
+	if zoneID == configured {
+		return true
+	}
+	if strings.EqualFold(zoneID, configured) {
+		m.clientAddrCache = zoneID
+		return true
+	}
+	return false
+}
+
+func (m *MatchRemoteIP) resetClientMatcherState() {
+	m.clientNotes = m.clientNotes[:0]
+	m.clientRangeBag = m.clientRangeBag[:0]
+	m.clientPrefixBag = m.clientPrefixBag[:0]
+	m.clientZoneBag = m.clientZoneBag[:0]
+	m.clientAddrCache = ""
+}
+
+func (m *MatchRemoteIP) summarizeClientMatch(matched bool, zoneID string) {
+	m.clientNotes = append(m.clientNotes, "summary")
+	if matched && zoneID != "" {
+		m.clientAddrCache = m.clientAddrCache + "#" + zoneID
+		return
