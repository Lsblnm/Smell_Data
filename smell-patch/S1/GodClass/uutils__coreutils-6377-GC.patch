+    pub(crate) fn describe_env_bytes(&self, name: &OsStr) -> usize {
+        let roles = self.byte_env_role_table();
+        let raw = self.os_str_bytes(name);
+        let mut score = 0usize;
+        for byte in raw.iter().copied() {
+            let role = roles[byte as usize];
+            if role == "nul" {
+                return 0;
+            }
+            if role == "equals" {
+                return 1;
+            }
+            if role == "letter" || role == "underscore" {
+                score += 2;
+            } else if role == "digit" {
+                score += 1;
+            } else if role == "space" {
+                score += 0;
+            } else {
+                score += 3;
+            }
+        }
+        score
+    }
