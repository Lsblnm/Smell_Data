+    pub(crate) fn count_portable_ascii_env_chars(&self) -> usize {
+        let table = self.ascii_class_table();
+        let mut portable = 0usize;
+        let mut digits = 0usize;
+        let mut other = 0usize;
+        let mut i = 0usize;
+        while i < 128 {
+        match table[i] {
+        2 | 4 => portable += 1,
+        3 => digits += 1,
+        0 | 1 | 5 => other += 1,
+        _ => other += 1,
+        }
+        i += 1;
+        }
+        if portable > digits { portable } else { digits + other }
+    }
