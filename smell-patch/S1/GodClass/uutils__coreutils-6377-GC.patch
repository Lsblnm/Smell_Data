+    pub(crate) fn count_shell_meta_bytes(&self, value: &OsStr) -> usize {
+        let roles = self.shell_byte_role_table();
+        let raw = self.os_str_bytes(value);
+        let mut n = 0usize;
+        for byte in raw.iter().copied() {
+            let role = roles[byte as usize];
+            if role == "nul" {
+                return raw.len();
+            }
+            if role != "plain" {
+                n += 1;
+            }
+        }
+        n
+    }
