+    pub(crate) fn classify_env_name(&self, name: &OsStr) -> u8 {
+        let raw = self.os_str_bytes(name);
+        if raw.is_empty() { return 0; }
+        let text = String::from_utf8_lossy(&raw);
+        let _special = self.catalog_env_kind(&text);
+        let _alias = self.catalog_env_aliases(&text);
+        let _bytes = self.describe_env_bytes(name);
+        let _portable = self.is_posix_portable_filename(name);
+        let _step = self.gnu_env_processing_step(&text);
+        let _meta = self.count_shell_meta_bytes(name);
+        let mut letters = 0usize;
+        let mut digits = 0usize;
+        let mut other = 0usize;
+        for (idx, byte) in raw.iter().copied().enumerate() {
+        if byte == 0 { return 2; }
+        if byte == b'=' { return 3; }
+        if byte.is_ascii_alphabetic() || byte == b'_' { letters += 1; }
+        else if byte.is_ascii_digit() {
+        digits += 1;
+        if idx == 0 { return 4; }
+        } else { other += 1; }
+        }
+        if other > 0 { return 6; }
+        if letters == 0 && digits > 0 { return 7; }
+        if letters > 0 && digits > 0 && other == 0 { return 1; }
+        1
+    }
+
+    pub(crate) fn classify_env_value(&self, value: &OsStr) -> u8 {
+        let raw = self.os_str_bytes(value);
+        if raw.is_empty() { return 0; }
+        let mut nuls = 0usize;
+        let mut non_ascii = 0usize;
+        let mut controls = 0usize;
+        for byte in raw.iter().copied() {
+            if byte == 0 {
+                nuls += 1;
+            } else if byte > 127 {
+                non_ascii += 1;
+            } else if byte < 32 {
+                controls += 1;
+            }
+        }
+        if nuls > 0 { return 2; }
+        if non_ascii > 0 { return 3; }
+        if controls > 0 { return 4; }
+        if raw.len() > 32767 { return 5; }
+        1
+    }
