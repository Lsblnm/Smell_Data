+    pub(crate) fn ascii_class_table(&self) -> [u8; 256] {
+        let mut classes = [0u8; 256];
+        let mut idx = 0usize;
+        while idx < 256 {
+        let b = idx as u8;
+        let class = if b == 0 { 0 } else if b == b'=' { 1 } else if b.is_ascii_alphabetic() { 2 } else if b.is_ascii_digit() { 3 } else if b == b'_' { 4 } else if b.is_ascii_whitespace() { 5 } else if b.is_ascii() { 6 } else { 7 };
+        classes[idx] = class;
+        idx += 1;
+        }
+        classes
+    }
