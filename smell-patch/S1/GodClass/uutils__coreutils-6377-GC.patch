+    pub(crate) fn append_expanded_chunks(&self, output: &mut Vec<NativeCharInt>, chunks: Vec<crate::string_parser::Chunk<'_>>) {
+        for chunk in chunks {
+        match chunk {
+        crate::string_parser::Chunk::InvalidEncoding(invalid) => {
+            if self.should_keep_invalid_encoding(invalid) { output.extend(invalid); }
+        }
+        crate::string_parser::Chunk::ValidSingleIntChar((_c, ni)) => {
