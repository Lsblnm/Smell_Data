+        def regexp_with_working_captures?(node)
+          @valid_ref = nil
+          return false unless node
+
+          if node.match_with_lvasgn_type?
+            lhs, _rhs = *node # rubocop:disable InternalAffairs/NodeDestructuring
+            node.loc_is?(:selector, '=~') && lhs&.regexp_type? &&
+              lhs.each_capture(named: true).count.positive?
+          elsif node.send_type? || node.csend_type?
+            receiver = node.receiver
+            first_argument = node.first_argument
+            method_name = node.method_name
+            loc = node.loc
+
+            regexp = if first_argument&.regexp_type? && REGEXP_ARGUMENT_METHODS.include?(method_name)
+                       first_argument
+                     elsif receiver&.regexp_type?
+                       receiver
+                     end
+
+            if regexp && @processed_source && loc.selector
+              interpolated = regexp.children.any?(&:begin_type?)
+              unless interpolated
+                tree = regexp.parsed_tree
+                named_capture = 0
+                numbered_capture = 0
+                tree&.traverse do |event, exp, _index|
+                  next unless event == :enter
+                  next unless exp.origin
+                  next if exp.text.start_with?('(?<=')
+                  next unless exp.respond_to?(:capturing?) && exp.capturing?
+
+                  if exp.respond_to?(:name)
+                    named_capture += 1
+                  else
+                    numbered_capture += 1
+                  end
+                end
+                @valid_ref = named_capture.positive? ? named_capture : numbered_capture
+              end
+            end
+
+            node.send_type? && method_name == :match &&
+              [receiver, first_argument].any? do |candidate|
+                candidate&.regexp_type? && candidate.each_capture(named: true).count.positive?
+              end
+          else
+            false
+          end
+        end
+
