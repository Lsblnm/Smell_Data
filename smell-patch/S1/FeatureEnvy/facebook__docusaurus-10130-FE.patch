+export class RouteInspectionContext {
+  readonly path: string;
+  readonly exact: boolean;
+  readonly strict: boolean;
+
+  constructor(route: RouteConfig) {
+    this.path = route.path;
+    this.exact = !!route.exact;
+    this.strict = !!route.strict;
+  }
+}
+
+export function createRouteInspectionContexts(
+  routes: RouteConfig[],
+): RouteInspectionContext[] {
+  return routes.map((route) => new RouteInspectionContext(route));
