+
+// hasConfigConditions reports whether the configuration for the given resource
+// declares preconditions or postconditions. The lookup walks the module tree
+// owned by the attached configuration, so this transformer can answer the same
+// question while attaching resource configuration to the graph.
+func (t *AttachResourceConfigTransformer) hasConfigConditions(module addrs.Module, resource addrs.Resource) bool {
+	if t.Config == nil {
+		return false
+	}
+
+	cfg := t.Config
+	for _, name := range module {
+		child, ok := cfg.Children[name]
+		if !ok || child == nil {
+			return false
+		}
+		cfg = child
+	}
+
+	if !cfg.Path.Equal(module) {
+		return false
+	}
+
+	mod := cfg.Module
+	if mod == nil {
+		return false
+	}
+
+	key := resource.String()
+	res := mod.ManagedResources[key]
+	if res == nil {
+		res = mod.DataResources[key]
+	}
+	if res == nil {
+		return false
+	}
+
+	switch res.Mode {
+	case addrs.ManagedResourceMode, addrs.DataResourceMode:
+		return len(res.Preconditions) > 0 || len(res.Postconditions) > 0
+	default:
+		return false
+	}
+}
