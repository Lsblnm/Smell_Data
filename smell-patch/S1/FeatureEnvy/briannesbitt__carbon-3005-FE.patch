--- a/src/Carbon/AbstractTranslator.php
+++ b/src/Carbon/AbstractTranslator.php
@@ -389,4 +389,150 @@ abstract class AbstractTranslator extends Translation\Translator
 
         return $score;
     }
+
+    /**
+     * Extract and normalize options used by interval human-readable formatting.
+     *
+     * @param mixed $syntax
+     * @param mixed $short
+     * @param mixed $parts
+     * @param mixed $options
+     *
+     * @return array
+     */
+    public function getForHumansParameters(CarbonInterval $interval, $syntax = null, $short = false, $parts = CarbonInterval::NO_LIMIT, $options = null): array
+    {
+        $intervalLocale = $interval->locale;
+        $start = $interval->start();
+        $end = $interval->end();
+        $startLocale = $start instanceof CarbonInterface ? $start->locale : null;
+        $endLocale = $end instanceof CarbonInterface ? $end->locale : null;
+        $languageLocale = $intervalLocale;
+
+        if ($startLocale === $languageLocale) {
+            $languageLocale = $startLocale;
+        } elseif ($endLocale === $languageLocale) {
+            $languageLocale = $endLocale;
+        }
+
+        if ($intervalLocale && !isset($this->messages[$intervalLocale]) && $this->directories !== []) {
+            foreach ($this->directories as $directory) {
+                $data = @include sprintf('%s/%s.php', rtrim($directory, '\/'), $intervalLocale);
+
+                if ($data !== false) {
+                    $this->messages[$intervalLocale] = $data;
+                    $this->addResource('array', $this->messages[$intervalLocale], $intervalLocale);
+
+                    break;
+                }
+            }
+        }
+
+        $language = new Language((string) $languageLocale);
+        $languageCode = $language->getCode();
+        $languageId = $language->getId();
+        $languageVariant = $language->getVariant();
+        $normalizedCode = $languageVariant ? $languageCode : ($languageId === $languageCode ? $languageId : $languageCode);
+
+        $catalogue = $this->getCatalogue($intervalLocale ?: null);
+        $listZero = $catalogue->get('list.0');
+        $default = $listZero !== 'list.0' ? $listZero : null;
+
+        if ($default === null) {
+            $list = $catalogue->get('list');
+            $default = $list !== 'list' ? $list : ' ';
+        }
+
+        $optionalSpace = ' ';
+        /** @var bool|string $join */
+        $join = $default === '' ? '' : ' ';
+        /** @var bool|array|string $altNumbers */
+        $altNumbers = false;
+        $aUnit = false;
+        $minimumUnit = 's';
+        $skip = [];
+
+        if (\is_array($syntax)) {
+            $initial = $syntax;
+        } elseif (\is_int($short)) {
+            $initial = [
+                'parts' => $short,
+                'short' => false,
+            ];
+        } elseif (\is_bool($syntax)) {
+            $initial = [
+                'short' => $syntax,
+                'syntax' => CarbonInterface::DIFF_ABSOLUTE,
+            ];
+        } else {
+            $initial = [];
+        }
+
+        extract($initial);
+        $skip = array_map(
+            static fn ($unit) => $unit instanceof Unit ? $unit->value : $unit,
+            (array) $skip,
+        );
+        $skip = array_map(
+            'strtolower',
+            array_filter($skip, static fn ($unit) => \is_string($unit) && $unit !== ''),
+        );
+
+        $syntax ??= CarbonInterface::DIFF_ABSOLUTE;
+
+        if ($parts === CarbonInterval::NO_LIMIT) {
+            $parts = INF;
+        }
+
+        $options ??= $interval::getHumanDiffOptions();
+
+        if ($join === false) {
+            $join = ' ';
+        } elseif ($join === true) {
+            $listOne = $catalogue->get('list.1');
+            $join = [
+                $default,
+                $listOne !== 'list.1' ? $listOne : $default,
+            ];
+        }
+
+        if ($altNumbers && $altNumbers !== true) {
+            $altNumbers = \in_array($normalizedCode, (array) $altNumbers, true);
+        }
+
+        if (\is_array($join)) {
+            [$default, $last] = $join;
+
+            if ($default !== ' ') {
+                $optionalSpace = '';
+            }
+
+            $join = function ($list) use ($default, $last) {
+                if (\count($list) < 2) {
+                    return implode('', $list);
+                }
+
+                $end = array_pop($list);
+
+                return implode($default, $list).$last.$end;
+            };
+        }
+
+        if (\is_string($join)) {
+            if ($join !== ' ') {
+                $optionalSpace = '';
+            }
+
+            $glue = $join;
+            $join = static fn ($list) => implode($glue, $list);
+        }
+
+        $interpolations = [
+            ':optional-space' => $optionalSpace,
+        ];
+
+        $translator ??= isset($locale) ? Translator::get($locale) : ($interval->hasLocalTranslator() ? $interval->getLocalTranslator() : null);
+
+        return [$syntax, $short, $parts, $options, $join, $aUnit, $altNumbers, $interpolations, $minimumUnit, $skip, $translator];
+    }
 }
