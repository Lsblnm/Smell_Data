@@ -4,6 +4,18 @@ module RuboCop
   module Cop
     # Common functionality for handling parentheses.
     module Parentheses
+      # Captures source bounds for a parenthesized call expression.
+      class CallBounds
+        attr_reader :begin_pos, :expression_line, :active
+
+        def initialize(node, processed_source, cop)
+          range = node.source_range
+          @begin_pos = range.begin_pos
+          @expression_line = range.line
+          @active = processed_source.comment_config.cop_enabled_at_line?(cop, range.line)
+        end
+      end
