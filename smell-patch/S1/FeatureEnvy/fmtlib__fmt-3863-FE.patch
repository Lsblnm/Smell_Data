+namespace detail {
+template <typename Char>
+template <typename RangeFormatter, typename R, typename FormatContext>
+auto arg_formatter<Char>::write_range(const RangeFormatter& rf, R&& range,
+                                      FormatContext& ctx) const
+    -> decltype(ctx.out()) {
+  range_mapper<buffered_context<Char>> mapper;
+  auto out = ctx.out();
+  auto write_span = [&](basic_string_view<Char> span) {
+    auto data = span.data();
+    auto size = span.size();
+    if (specs.width != 0 || specs.type == presentation_type::debug || locale)
+      return write<Char>(out, basic_string_view<Char>(data, size), specs,
+                         ctx.locale());
+    return copy<Char>(data, data + size, out);
+  };
+  auto it = range_begin(range);
+  auto end = range_end(range);
+  out = write_span(rf.opening_bracket_);
+  int i = 0;
+  for (; it != end; ++it) {
+    if (i > 0) out = write_span(rf.separator_);
+    ctx.advance_to(out);
+    auto&& item = *it;
+    out = rf.underlying_.format(mapper.map(item), ctx);
+    ++i;
+  }
+  out = write_span(rf.closing_bracket_);
+  return out;
+}
+}  // namespace detail
