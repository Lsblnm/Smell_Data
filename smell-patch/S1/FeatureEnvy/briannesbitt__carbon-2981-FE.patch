diff --git a/src/Carbon/CarbonInterval.php b/src/Carbon/CarbonInterval.php
index bbff99fc..47aad2bf 100644
--- a/src/Carbon/CarbonInterval.php
+++ b/src/Carbon/CarbonInterval.php
@@ -2518,6 +2518,56 @@ class CarbonInterval extends DateInterval implements CarbonConverterInterface
         return false;
     }
 
+    /**
+     * Resolve a signed whole-day PHP interval difference, or a unit total when
+     * the current interval still remembers the two dates that produced it.
+     */
+    public function calculateIntervalDayDiff(DateInterval $interval, ?string $unit = null): int|float
+    {
+        $start = $this->startDate;
+        $end = $this->endDate;
+
+        if ($unit !== null && $start !== null && $end !== null) {
+            $translator = $start->getLocalTranslator();
+            $localeId = $translator->getLocale();
+            $language = new Language($localeId);
+
+            $normalizedStart = $start->copy()
+                ->setTimezone($start->timezoneName)
+                ->setDateTime(
+                    (int) $start->year,
+                    (int) $start->month,
+                    (int) $start->day,
+                    (int) $start->hour,
+                    (int) $start->minute,
+                    (int) $start->second,
+                    (int) $start->micro,
+                );
+            $normalizedEnd = $end->copy()
+                ->setTimezone($end->timezoneName)
+                ->setDateTime(
+                    (int) $end->year,
+                    (int) $end->month,
+                    (int) $end->day,
+                    (int) $end->hour,
+                    (int) $end->minute,
+                    (int) $end->second,
+                    (int) $end->micro,
+                );
+
+            if ($language->getIsoName() !== $localeId) {
+                $normalizedStart = $normalizedStart->locale($localeId);
+            }
+
+            return $normalizedStart->diffInUnit($unit, $normalizedEnd);
+        }
+
+        $daysDiff = (int) $interval->format('%a');
+        $sign = $interval->format('%r') === '-' ? -1 : 1;
+
+        return $daysDiff * $sign;
+    }
+
     /**
      * Get amount of given unit equivalent to the interval.
      *
@@ -2538,7 +2588,7 @@ class CarbonInterval extends DateInterval implements CarbonConverterInterface
         }
 
         if ($this->startDate && $this->endDate) {
-            return $this->startDate->diffInUnit($unit, $this->endDate);
+            return $this->calculateIntervalDayDiff($this, $unit);
         }
 
         $result = 0;
