   return jq;
 }
 
+extern char color_bufs[8][16];
+extern const char *color_bufps[8];
+extern const char *def_colors[8];
+extern const char **colors;
+
+int jq_set_colors(jq_state *jq, const char *c, int *dumpopts, jq_util_input_state *input_state) {
+  const char *e;
+  size_t i;
+
+#ifdef USE_ISATTY
+  if (isatty(STDOUT_FILENO) &&
+      !jq->halted &&
+      jv_get_kind(jq->attrs) == JV_KIND_OBJECT &&
+      input_state->parser == NULL &&
+      input_state->current_line == 0 &&
+      jv_get_kind(input_state->current_filename) != JV_KIND_STRING) {
+#ifndef WIN32
+    *dumpopts |= JV_PRINT_ISATTY | JV_PRINT_COLOR;
+#else
+    DWORD mode;
+    HANDLE con = GetStdHandle(STD_OUTPUT_HANDLE);
+    if (GetConsoleMode(con, &mode)) {
+      *dumpopts |= JV_PRINT_ISATTY;
+      if (getenv("ANSICON") != NULL ||
+          SetConsoleMode(con, mode | 4/*ENABLE_VIRTUAL_TERMINAL_PROCESSING*/))
+        *dumpopts |= JV_PRINT_COLOR;
+    }
+#endif
+  }
+#endif
+
+  if (c == NULL)
+    return 1;
+  colors = def_colors;
+  memset(color_bufs, 0, sizeof(color_bufs));
+  for (i = 0; i < sizeof(def_colors) / sizeof(def_colors[0]); i++)
+    color_bufps[i] = def_colors[i];
+  for (i = 0; i < sizeof(def_colors) / sizeof(def_colors[0]) && *c != '\0'; i++, c = e) {
+    if ((e = strchr(c, ':')) == NULL)
+      e = c + strlen(c);
+    if ((size_t)(e - c) > sizeof(color_bufs[i]) - 4)
+      return 0;
+    color_bufs[i][0] = '\033';
+    color_bufs[i][1] = '[';
+    (void) strncpy(&color_bufs[i][2], c, e - c);
+    if (strspn(&color_bufs[i][2], "0123456789;") < strlen(&color_bufs[i][2]))
+      return 0;
+    color_bufs[i][2 + (e - c)] = 'm';
+    color_bufps[i] = color_bufs[i];
+    if (e[0] == ':')
+      e++;
+  }
+  colors = color_bufps;
+  return 1;
+}
