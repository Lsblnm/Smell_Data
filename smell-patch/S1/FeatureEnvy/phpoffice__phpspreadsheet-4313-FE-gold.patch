+    private function replaceQuotedPeriod(string $value): string
+    {
+        $translator = FormulaTranslator::getInstance();
+        $quote = $translator->getSheetNameQuote();
+        $period = $translator->getOdsAddressSeparator();
+        $value2 = '';
+        $quoted = false;
+        foreach (mb_str_split($value, 1, 'UTF-8') as $char) {
+            if ($char === $quote) {
+                $quoted = !$quoted;
+            } elseif ($char === $period && $quoted) {
+                $char = "\u{fffe}";
+            }
+            $value2 .= $char;
+        }
+
+        return $value2;
+    }
