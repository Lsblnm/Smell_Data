diff --git a/lib/fluent/plugin/parser_json.rb b/lib/fluent/plugin/parser_json.rb
index 840f6a96..aea25ba8 100644
--- a/lib/fluent/plugin/parser_json.rb
+++ b/lib/fluent/plugin/parser_json.rb
@@ -80,6 +80,48 @@ module Fluent
         yield nil, nil
       end
 
+      def parse_params_default(params)
+        http = owner
+        finish = lambda do |record|
+          return nil, record if record.nil? || record.is_a?(Array) || params['time']
+
+          default_parser = http.default_parser
+          time_key = default_parser.time_key
+          t = if default_parser.keep_time_key
+                record[time_key]
+              else
+                record.delete(time_key)
+              end
+          if t
+            time_parser = default_parser.get_time_parser
+            if time_parser
+              return time_parser.parse(t), record
+            else
+              return Fluent::EventTime.from_time(Time.at(t) + Fluent::Timezone.utc_offset(nil)), record
+            end
+          else
+            return Fluent::EventTime.now, record
+          end
+        end
+
+        if msgpack = params['msgpack']
+          mp = http.parser_msgpack
+          mp.unpacker.feed_each(msgpack) do |obj|
+            if key = mp.time_key
+              obj.delete(key) if obj.respond_to?(:has_key?) && obj.has_key?(key)
+            end
+            _time, obj = mp.convert_values(nil, obj)
+            return finish.call(obj)
+          end
+        elsif js = params['json']
+          http.parser_json.parse(js) do |_time, record|
+            return finish.call(record)
+          end
+        else
+          raise "'json' or 'msgpack' parameter is required"
+        end
+      end
+
       def parser_type
         :text
       end
