+    /**
+     * Get the correct Worksheet and coordinate from a coordinate that may
+     * contain a reference to another sheet or a named range.
+     *
+     * @return array{0: Worksheet, 1: string}
+     */
+    public function getWorksheetAndCoordinate(Worksheet $worksheet, string $coordinate): array
+    {
+        $sheet = null;
+        $finalCoordinate = null;
+
+        // Worksheet reference?
+        if (strpos($coordinate, '!') !== false) {
+            $worksheetReference = Worksheet::extractSheetTitle($coordinate, true);
+
+            $sheet = $worksheet->getParentOrThrow()->getSheetByName($worksheetReference[0]);
+            $finalCoordinate = strtoupper($worksheetReference[1]);
+
+            if ($sheet === null) {
+                throw new \PhpOffice\PhpSpreadsheet\Exception('Sheet not found for name: ' . $worksheetReference[0]);
+            }
+        } elseif (
+            !preg_match('/^' . Calculation::CALCULATION_REGEXP_CELLREF . '$/i', $coordinate) &&
+            preg_match('/^' . Calculation::CALCULATION_REGEXP_DEFINEDNAME . '$/iu', $coordinate)
+        ) {
+            // Named range?
+            $namedRange = DefinedName::resolveName($coordinate, $worksheet);
+            if ($namedRange !== null && $namedRange->isFormula()) {
+                $namedRange = null;
+            }
+            if ($namedRange !== null && $namedRange->getLocalOnly()) {
+                $namedWorksheet = $namedRange->getWorksheet();
+                if ($namedWorksheet === null || $worksheet !== $namedWorksheet) {
+                    $namedRange = null;
+                }
+            }
+            if ($namedRange !== null) {
+                $sheet = $namedRange->getWorksheet();
+                if ($sheet === null) {
+                    throw new \PhpOffice\PhpSpreadsheet\Exception('Sheet not found for named range: ' . $namedRange->getName());
+                }
+
+                /** @phpstan-ignore-next-line */
+                $cellCoordinate = ltrim(substr($namedRange->getValue(), strrpos($namedRange->getValue(), '!')), '!');
+                $finalCoordinate = str_replace('$', '', $cellCoordinate);
+            }
+        }
+
+        if ($sheet === null || $finalCoordinate === null) {
+            $sheet = $worksheet;
+            $finalCoordinate = strtoupper($coordinate);
+        }
+
+        if ($this->isSupervisor && $this->parent instanceof Spreadsheet) {
+            $collection = $sheet->getCellCollection();
+            if ($collection->has($finalCoordinate)) {
+                $existingCell = $collection->get($finalCoordinate);
+                if ($existingCell !== null) {
+                    $xfIndex = $existingCell->getXfIndex();
+                    $styles = $this->parent->getCellXfCollection();
+                    if ($sheet->getParent() === $this->parent && isset($styles[$xfIndex]) && $styles[$xfIndex] instanceof self) {
+                        return [$sheet, $finalCoordinate];
+                    }
+                }
+            }
+        }
+
+        if (Coordinate::coordinateIsRange($finalCoordinate)) {
+            throw new \PhpOffice\PhpSpreadsheet\Exception('Cell coordinate string can not be a range of cells.');
+        } elseif (strpos($finalCoordinate, '$') !== false) {
+            throw new \PhpOffice\PhpSpreadsheet\Exception('Cell coordinate must not be absolute.');
+        }
+
+        return [$sheet, $finalCoordinate];
+    }
