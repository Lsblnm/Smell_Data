diff --git a/fastlane_core/lib/fastlane_core/print_table.rb b/fastlane_core/lib/fastlane_core/print_table.rb
index 622350d20..a9b59ccdb 100644
--- a/fastlane_core/lib/fastlane_core/print_table.rb
+++ b/fastlane_core/lib/fastlane_core/print_table.rb
@@ -4,6 +4,10 @@ require_relative 'helper'
 module FastlaneCore
   class PrintTable
     class << self
+      def print_lane_context
+        new.print_lane_context
+      end
+
       # This method prints out all the user inputs in a nice table. Useful to summarize the run
       # You can pass an array to `hide_keys` if you don't want certain elements to show up (symbols or strings)
       # You can pass an array to `mask_keys` if you want to mask certain elements (symbols or strings)
@@ -129,5 +133,65 @@ module FastlaneCore
         rows
       end
     end
+
+    attr_accessor :hide_keys
+    attr_accessor :mask_keys
+
+    def initialize(hide_keys: [], mask_keys: [])
+      @hide_keys = Array(hide_keys).map(&:to_s)
+      @mask_keys = Array(mask_keys).map(&:to_s)
+    end
+
+    def print_lane_context
+      context = Fastlane::Actions.lane_context
+      return if context.empty?
+
+      if FastlaneCore::Globals.verbose?
+        UI.important('Lane Context:'.yellow)
+        UI.message(context)
+        return
+      end
+
+      hide_tokens = @hide_keys.dup
+      mask_tokens = @mask_keys.dup
+
+      Fastlane::Actions.executed_actions.each do |step|
+        step_name = step[:name].to_s
+        next if step_name.empty?
+        hide_tokens << step_name if @hide_keys.include?(step_name)
+        mask_tokens << step_name if @mask_keys.include?(step_name)
+      end
+
+      runner = Fastlane::Action.runner
+      runner_name = nil
+      if runner
+        current_lane = runner.current_lane
+        current_platform = runner.current_platform
+        lane_catalog = runner.lanes || {}
+        error_hooks = runner.error_blocks || {}
+        platform_lanes = lane_catalog[current_platform] || lane_catalog[nil] || {}
+        recoverable = platform_lanes.key?(current_lane) || error_hooks[current_platform] || error_hooks[nil]
+        assembled_name = [current_platform, current_lane].reject(&:nil?).join(' ')
+        runner_name = assembled_name if recoverable && !assembled_name.empty?
+      end
+
+      rows = context.collect do |key, content|
+        key_s = key.to_s
+        next if hide_tokens.include?(key_s)
+
+        value = content.to_s
+        if value.empty? && runner_name && key == Fastlane::Actions::SharedValues::LANE_NAME
+          value = runner_name
+        end
+        value = '********' if mask_tokens.include?(key_s)
+        [key, value]
+      end.compact
+
+      require 'terminal-table'
+      puts(Terminal::Table.new({
+        title: "Lane Context".yellow,
+        rows: FastlaneCore::PrintTable.transform_output(rows)
+      }))
+    end
   end
 end
