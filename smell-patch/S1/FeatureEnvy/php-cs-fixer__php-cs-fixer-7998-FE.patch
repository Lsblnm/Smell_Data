+    public function isNeighbourAccepted(Tokens $tokens, int $index): bool
+    {
+        static $forbiddenTokens = null;
+
+        if (null === $forbiddenTokens) {
+            $forbiddenTokens = [
+                T_AS,
+                T_CLASS,
+                T_CONST,
+                T_EXTENDS,
+                T_IMPLEMENTS,
+                T_INSTANCEOF,
+                T_INSTEADOF,
+                T_INTERFACE,
+                T_NEW,
+                T_NS_SEPARATOR,
+                T_PAAMAYIM_NEKUDOTAYIM,
+                T_TRAIT,
+                T_USE,
+                CT::T_USE_TRAIT,
+                CT::T_USE_LAMBDA,
+                ...Token::getObjectOperatorKinds(),
+            ];
+        }
+
+        $token = $tokens[$index];
+        $content = $token->getContent();
+        $id = $token->getId();
+        $isArray = $token->isArray();
+
+        if ($token->equalsAny(['{', '}'])) {
+            return false;
+        }
+
+        $isForbidden = $isArray && \in_array($id, $forbiddenTokens, true);
+
+        foreach ($this->beforePropertyTypeTokens as $beforeToken) {
+            if (\is_array($beforeToken) && $isArray && $id === $beforeToken[0]) {
+                return !$isForbidden;
+            }
+        }
+
+        if ($isArray && isset($this->functionTypeHints[strtolower($content)])) {
+            return !$isForbidden;
+        }
+
+        if ($tokens->isTokenKindFound(T_STRING) || $tokens->isTokenKindFound(T_CONST)) {
+            foreach ($tokens->getNamespaceDeclarations() as $namespace) {
+                if (
+                    $index >= $namespace->getScopeStartIndex()
+                    && $index <= $namespace->getScopeEndIndex()
+                    && $index >= $namespace->getEndIndex()
+                ) {
+                    $typeAnalysis = new TypeAnalysis($content, $index, $index);
+
+                    if ($typeAnalysis->isReservedType() && 0 === strcasecmp($typeAnalysis->getName(), $content)) {
+                        return !$isForbidden;
+                    }
+
+                    break;
+                }
+            }
+        }
+
+        return !$isForbidden;
+    }
