diff --git a/lib/fluent/plugin/buffer.rb b/lib/fluent/plugin/buffer.rb
index 8315694e..eaf77cd8 100644
--- a/lib/fluent/plugin/buffer.rb
+++ b/lib/fluent/plugin/buffer.rb
@@ -631,6 +631,74 @@ module Fluent
         end
       end
 
+      def update_retry_state(output, chunk_id, using_secondary, error = nil)
+        output.retry_mutex.synchronize do
+          output.num_errors_metrics.inc
+          chunk_id_hex = dump_unique_id_hex(chunk_id)
+          logger = output.log
+          log_level = logger.level
+          logdev = logger.out
+
+          unless output.retry
+            output.retry = output.retry_state
+            if error
+              if log_level <= 3 && logdev
+                logger.warn "failed to flush the buffer.", retry_times: output.retry.steps, next_retry_time: output.retry.next_time.round, chunk: chunk_id_hex, error: error
+                logger.warn_backtrace
+                logdev.flush
+              end
+            end
+            return
+          end
+
+          retry_state = output.retry
+
+          if retry_state.limit?
+            if error
+              records = 0
+              synchronize do
+                @queue.each do |chunk|
+                  records += chunk.size
+                end
+              end
+              msg = "failed to flush the buffer, and hit limit for retries. dropping all chunks in the buffer queue."
+              if log_level <= 4 && logdev
+                logger.error msg, retry_times: retry_state.steps, records: records, error: error
+                logger.error_backtrace
+                logdev.flush
+              end
+            end
+            clear_queue!
+            @queue_size_metrics.set(0)
+            if log_level <= 1 && logdev
+              logger.debug "buffer queue cleared"
+              logdev.flush
+            end
+            output.retry = nil
+          else
+            # Ensure that the current time is greater than or equal to retry_state.next_time to avoid the situation when
+            # retry_state.step is called almost as many times as the number of flush threads in a short time.
+            if Time.now >= retry_state.next_time
+              retry_state.step
+            else
+              retry_state.recalc_next_time # to prevent all flush threads from retrying at the same time
+            end
+            if error
+              if using_secondary
+                msg = "failed to flush the buffer with secondary output."
+              else
+                msg = "failed to flush the buffer."
+              end
+              if log_level <= 3 && logdev
+                logger.warn msg, retry_times: retry_state.steps, next_retry_time: retry_state.next_time.round, chunk: chunk_id_hex, error: error
+                logger.warn_backtrace
+                logdev.flush
+              end
+            end
+          end
+        end
+      end
+
       def chunk_size_over?(chunk)
         chunk.bytesize > @chunk_limit_size || (@chunk_limit_records && chunk.size > @chunk_limit_records)
       end
