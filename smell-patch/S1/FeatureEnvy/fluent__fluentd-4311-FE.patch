     end
 
+    def self.setup_global_logger(supervisor, supervisor_mode: false)
+      extras = {
+        chgroup: supervisor.instance_variable_get(:@chgroup),
+        standalone_worker: supervisor.instance_variable_get(:@standalone_worker),
+      }
+      conf = Fluent::Config.build(
+        config_path: supervisor.instance_variable_get(:@config_path),
+        encoding: supervisor.instance_variable_get(:@conf_encoding),
+        additional_config: supervisor.instance_variable_get(:@inline_config),
+        use_v1_config: supervisor.instance_variable_get(:@use_v1_config),
+        type: supervisor.instance_variable_get(:@config_file_type),
+      )
+      loaded = supervisor.send(:build_system_config, conf)
+      extras[:dir_permission] = loaded.dir_permission
+      extras[:suppress_repeated_stacktrace] = loaded.suppress_repeated_stacktrace
+      extras[:ignore_repeated_log_interval] = loaded.ignore_repeated_log_interval
+      extras[:ignore_same_log_interval] = loaded.ignore_same_log_interval
+      loaded.setup_global_logger(supervisor, extras, supervisor_mode: supervisor_mode)
+    end
+
+    def setup_global_logger(supervisor, extras, supervisor_mode: false)
+      if supervisor_mode
+        worker_id = 0
+        process_type = :supervisor
+      else
+        worker_id = ENV['SERVERENGINE_WORKER_ID'].to_i
+        process_type = case
+                       when extras[:standalone_worker] then :standalone
+                       when worker_id == 0 then :worker0
+                       else :workers
+                       end
+      end
+
+      proxy = configure_proxy_generate
+      log_conf = @log
+      log_level = @log_level
+      rotate_age = supervisor.instance_variable_get(:@log_rotate_age)
+      rotate_size = supervisor.instance_variable_get(:@log_rotate_size)
+      log_path = supervisor.instance_variable_get(:@log_path)
+      chuser = supervisor.instance_variable_get(:@chuser)
+      chgroup = extras[:chgroup]
+
+      if proxy.sections[:log]
+        rotate_age ||= log_conf.rotate_age
+        rotate_size ||= log_conf.rotate_size
+      end
+      supervisor.instance_variable_set(:@log_rotate_age, rotate_age)
+      supervisor.instance_variable_set(:@log_rotate_size, rotate_size)
+
+      rotate = rotate_age || rotate_size
+      actual_log_path = log_path
+
+      if Fluent.windows? && rotate && log_path && log_path != "-"
+        actual_log_path = Fluent::Log.per_process_path(log_path, process_type, worker_id)
+      end
+
+      if actual_log_path && actual_log_path != "-"
+        FileUtils.mkdir_p(File.dirname(actual_log_path)) unless File.exist?(actual_log_path)
+        if rotate
+          logdev = Fluent::LogDeviceIO.new(
+            actual_log_path,
+            shift_age: rotate_age,
+            shift_size: rotate_size,
+          )
+        else
+          logdev = File.open(actual_log_path, "a")
+        end
+
+        if chuser || chgroup
+          chuid = chuser ? ServerEngine::Privilege.get_etc_passwd(chuser).uid : nil
+          chgid = chgroup ? ServerEngine::Privilege.get_etc_group(chgroup).gid : nil
+          File.chown(chuid, chgid, actual_log_path)
+        end
+
+        dir_permission = extras[:dir_permission]
+        if dir_permission
+          File.chmod(dir_permission || Fluent::DEFAULT_DIR_PERMISSION, File.dirname(actual_log_path))
+        end
+      else
+        logdev = STDOUT
+      end
+
+      $log = Fluent::Log.new(
+        ServerEngine::DaemonLogger.new(logdev, log_level: log_level - 1),
+        path: actual_log_path,
+        process_type: process_type,
+        worker_id: worker_id,
+        format: log_conf.format,
+        time_format: log_conf.time_format,
+        suppress_repeated_stacktrace: extras[:suppress_repeated_stacktrace],
+        ignore_repeated_log_interval: extras[:ignore_repeated_log_interval],
+        ignore_same_log_interval: extras[:ignore_same_log_interval],
+      )
+      $log.enable_color(false) if actual_log_path
+      $log.enable_debug if $log.level <= Fluent::Log::LEVEL_DEBUG
+
+      $log.info "init #{process_type} logger",
+                path: actual_log_path,
+                rotate_age: rotate_age,
+                rotate_size: rotate_size
+    end
+
