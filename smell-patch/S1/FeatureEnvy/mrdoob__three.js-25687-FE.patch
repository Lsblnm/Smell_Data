+++ b/src/core/Object3D.js
@@ -669,6 +669,28 @@ class Object3D extends EventDispatcher {
 
 	}
 
+	updateShadowMatrices( shadow ) {
+
+		const camera = shadow.camera;
+		const mapSize = shadow.mapSize;
+
+		const fov = MathUtils.RAD2DEG * 2 * this.angle * shadow.focus;
+		const aspect = mapSize.width / mapSize.height;
+		const far = this.distance || camera.far;
+
+		if ( fov !== camera.fov || aspect !== camera.aspect || far !== camera.far ) {
+
+			camera.fov = fov;
+			camera.aspect = aspect;
+			camera.far = far;
+			camera.updateProjectionMatrix();
+
+		}
+
+		shadow.updateMatrices( this );
+
+	}
+
 	toJSON( meta ) {
 
 		// meta is a string when called from JSON.stringify
