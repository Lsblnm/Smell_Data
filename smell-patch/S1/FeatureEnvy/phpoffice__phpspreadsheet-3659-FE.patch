+    /**
+     * Resolve a structured reference against the table that owns its data.
+     *
+     * @throws Exception
+     * @throws \PhpOffice\PhpSpreadsheet\Exception
+     */
+    public function getTableStructure(Operands\StructuredReference $structuredReference, Cell $cell, string $structuredReferenceValue): void
+    {
+        preg_match(Operands\StructuredReference::TABLE_REFERENCE, $structuredReferenceValue, $matches);
+
+        $tableName = $matches[1];
+        $cellWorksheet = $cell->getWorksheet();
+        $sheetTitle = $cellWorksheet->getTitle();
+
+        if ($tableName === '') {
+            $table = null;
+            foreach ($cellWorksheet->getTableCollection() as $candidate) {
+                if ($cell->isInRange($candidate->getRange()) === true) {
+                    $table = $candidate;
+                    $tableName = $candidate->getName();
+                    break;
+                }
+            }
+            if ($table === null) {
+                throw new Exception('Table for Structured Reference cannot be identified');
+            }
+        } else {
+            $table = $cellWorksheet->getTableByName($tableName);
+            if ($table === null) {
+                throw new Exception("Table {$tableName} for Structured Reference cannot be located");
+            }
+        }
+
+        $styleTheme = $table->getStyle()->getTheme();
+        $this->debugLog->writeDebugLog(
+            'Resolved Structured Reference %s to table %s on worksheet %s (style %s%s)',
+            $structuredReferenceValue,
+            $tableName,
+            $sheetTitle,
+            $styleTheme,
+            ($this->spreadsheet !== null) ? '' : ', unbound engine'
+        );
+
+        $reference = $matches[2];
+        $tableRangeString = $table->getRange();
+        $tableRange = Coordinate::getRangeBoundaries($tableRangeString);
+
+        $headersRow = ($table->getShowHeaderRow()) ? (int) $tableRange[0][1] : null;
+        $firstDataRow = ($table->getShowHeaderRow()) ? (int) $tableRange[0][1] + 1 : $tableRange[0][1];
+        $totalsRow = ($table->getShowTotalsRow()) ? (int) $tableRange[1][1] : null;
+        $lastDataRow = ($table->getShowTotalsRow()) ? (int) $tableRange[1][1] - 1 : $tableRange[1][1];
+
+        $headerWorksheet = $cellWorksheet;
+        $cellReference = $cell->getCoordinate();
+        $columns = [];
+        $lastColumn = ++$tableRange[1][0];
+        for ($column = $tableRange[0][0]; $column !== $lastColumn; ++$column) {
+            $columns[$column] = $headerWorksheet
+                ->getCell($column . ($headersRow ?? ($firstDataRow - 1)))
+                ->getCalculatedValue();
+        }
+        $headerWorksheet->getCell($cellReference);
+
+        $structuredReference->applyResolvedTable(
+            $tableName,
+            $table,
+            $reference,
+            $headersRow,
+            $firstDataRow,
+            $lastDataRow,
+            $totalsRow,
+            $columns
+        );
+    }
+
