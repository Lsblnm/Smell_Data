diff --git a/lib/rubocop/cop/correctors/parentheses_corrector.rb b/lib/rubocop/cop/correctors/parentheses_corrector.rb
index bcb172aeb..c67d2680f 100644
--- a/lib/rubocop/cop/correctors/parentheses_corrector.rb
+++ b/lib/rubocop/cop/correctors/parentheses_corrector.rb
@@ -4,6 +4,36 @@ module RuboCop
   module Cop
     # This autocorrects parentheses
     class ParenthesesCorrector
+      def initialize(cop)
+        @cop = cop
+        @processed_source = cop.processed_source
+      end
+
+      def require_parentheses?(send_node)
+        return false unless @cop.target_ruby_version >= 2.3
+
+        parent = send_node.parent
+        loc = send_node.loc
+        method_name = send_node.method_name
+        receiver = send_node.receiver
+        selector = loc.selector
+        dot = loc.dot
+        range = loc.expression
+        raw_source = @processed_source.raw_source
+
+        return false unless parent && range && method_name
+        return false unless send_node.comparison_method?
+
+        operator = method_name.to_s
+        snippet = raw_source[range.begin_pos...range.end_pos]
+        operator_present = snippet&.include?(operator) && selector
+        left_hand_side = receiver || dot
+        return false unless operator_present && left_hand_side
+
+        (parent.respond_to?(:logical_operator?) && parent.logical_operator?) ||
+          (parent.respond_to?(:comparison_method?) && parent.comparison_method?)
+      end
+
       class << self
         include RangeHelp
 
