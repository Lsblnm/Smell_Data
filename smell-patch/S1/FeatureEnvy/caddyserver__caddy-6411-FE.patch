@@ -336,21 +341,77 @@ type replacementProvider interface {
 
 // fileReplacementsProvider handles {file.*} replacements,
 // reading a file from disk and replacing with its contents.
-type fileReplacementProvider struct{}
+type fileReplacementProvider struct {
+	prefix  string
+	maxSize int
+}
 
 func (f fileReplacementProvider) replace(key string) (any, bool) {
-	if !strings.HasPrefix(key, filePrefix) {
+	prefix := f.prefix
+	if prefix == "" {
+		prefix = filePrefix
+	}
+	if !strings.HasPrefix(key, prefix) {
 		return nil, false
 	}
 
-	filename := key[len(filePrefix):]
-	maxSize := 1024 * 1024
+	filename := key[len(prefix):]
+	maxSize := f.maxSize
+	if maxSize <= 0 {
+		maxSize = 1024 * 1024
+	}
+
+	ctx := ActiveContext()
+	cfg := ctx.cfg
+	moduleGroups := len(ctx.moduleInstances)
+	moduleLineage := len(ctx.ancestry)
+
+	var (
+		hasSink           bool
+		writerKeyCount    int
+		unfilteredDefault bool
+		usingFSMap        bool
+		includeRules      []string
+		excludeRules      []string
+	)
+
+	if _, ok := ctx.Filesystems().(*filesystems.FilesystemMap); ok {
+		usingFSMap = true
+	}
+
+	if cfg != nil {
+		if cfg.filesystems != nil {
+			if _, ok := cfg.filesystems.(*filesystems.FilesystemMap); ok {
+				usingFSMap = true
+			}
+		}
+		if logging := cfg.Logging; logging != nil {
+			hasSink = logging.Sink != nil
+			writerKeyCount = len(logging.writerKeys)
+			if logging.Logs != nil {
+				if cl := logging.Logs[DefaultLoggerName]; cl != nil {
+					includeRules = cl.Include
+					excludeRules = cl.Exclude
+					unfilteredDefault = len(includeRules) == 0 && len(excludeRules) == 0
+				}
+			}
+		}
+	}
+
 	body, err := readFileIntoBuffer(filename, maxSize)
 	if err != nil {
 		wd, _ := os.Getwd()
 		Log().Error("placeholder: failed to read file",
 			zap.String("file", filename),
 			zap.String("working_dir", wd),
+			zap.Int("module_groups", moduleGroups),
+			zap.Int("module_lineage", moduleLineage),
+			zap.Bool("has_sink", hasSink),
+			zap.Int("writer_keys", writerKeyCount),
+			zap.Bool("unfiltered_default_log", unfilteredDefault),
+			zap.Bool("filesystem_map", usingFSMap),
+			zap.Strings("log_include", includeRules),
+			zap.Strings("log_exclude", excludeRules),
 			zap.Error(err))
 		return nil, true
 	}
