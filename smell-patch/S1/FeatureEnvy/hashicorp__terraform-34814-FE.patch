+
+// CommandPlan holds the remote command payload and stream wiring used by
+// provisioners when executing a script.
+type CommandPlan struct {
+	Path    shared.RemoteTempPath
+	Command string
+	Stdin   io.Reader
+	Stdout  io.Writer
+	Stderr  io.Writer
+}
+
+// NewCommand builds a Cmd from the planned command, streams, and remote path.
+func (p CommandPlan) NewCommand() *Cmd {
+	command := p.Command
+	if command == "" {
+		command = p.Path.Value
+	}
+	return &Cmd{
+		Command: command,
+		Stdin:   p.Stdin,
+		Stdout:  p.Stdout,
+		Stderr:  p.Stderr,
+	}
+}
