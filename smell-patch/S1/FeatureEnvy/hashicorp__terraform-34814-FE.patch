+// ScriptRunSettings captures communicator-owned timeout and command plan data
+// used while running remote scripts.
+type ScriptRunSettings struct {
+	Timeout time.Duration
+	Plan    remote.CommandPlan
+}
+
+// SettingsFor collects execution settings from a communicator.
+func SettingsFor(comm Communicator) ScriptRunSettings {
+	return ScriptRunSettings{
+		Timeout: comm.Timeout(),
+	}
+}
+
+// SetRemotePath records the remote script destination for this execution.
+func (s *ScriptRunSettings) SetRemotePath(path string) {
+	s.Plan.Path = shared.NewRemoteTempPath(path)
+}
