diff --git a/src/networking.c b/src/networking.c
index 501476e35..b35ff5ea7 100644
--- a/src/networking.c
+++ b/src/networking.c
@@ -1142,6 +1142,47 @@ void addReplyBulkLongLong(client *c, long long ll) {
     addReplyBulkCBuffer(c, buf, len);
 }
 
+/* Add the shard reply of a single shard based off the given primary node. */
+void addShardReplyForClusterShards(client *c, list *nodes) {
+    serverAssert(nodes->len > 0);
+
+    int prefix = c->resp == 2 ? '*' : '%';
+    long map_len = 2;
+    if (c->resp == 2) map_len *= 2;
+    addReplyAggregateLen(c, map_len, prefix);
+    addReplyBulkCString(c, "slots");
+
+    listIter li;
+    listRewind(nodes, &li);
+    listNode *ln = li.next;
+    serverAssert(ln == nodes->head);
+    clusterNode *n = ln->value;
+
+    /* Use slot_info_pairs from the primary only */
+    n = clusterNodeGetPrimary(n);
+
+    uint16_t *slot_pairs = clusterNodeGetSlotInfoPairs(n);
+    int slot_pair_count = clusterNodeGetSlotInfoPairsCount(n);
+    if (slot_pairs != NULL) {
+        serverAssert((slot_pair_count % 2) == 0);
+        addReplyArrayLen(c, slot_pair_count);
+        for (int i = 0; i < slot_pair_count; i++) addReplyLongLong(c, (unsigned long)slot_pairs[i]);
+    } else {
+        /* If no slot info pair is provided, the node owns no slots */
+        addReplyArrayLen(c, 0);
+    }
+
+    addReplyBulkCString(c, "nodes");
+    addReplyArrayLen(c, nodes->len);
+    ln = nodes->head;
+    while (ln != NULL) {
+        clusterNode *node = ln->value;
+        addNodeDetailsToShardReply(c, node);
+        clusterFreeNodesSlotsInfo(node);
+        ln = ln->next;
+    }
+}
+
