diff --git a/src/jv_dtoa_tsd.c b/src/jv_dtoa_tsd.c
index 4bea31b..e6b3eeb 100644
--- a/src/jv_dtoa_tsd.c
+++ b/src/jv_dtoa_tsd.c
@@ -1,3 +1,4 @@
+#include <assert.h>
 #include <stdlib.h>
 #include <stdio.h>
 
@@ -5,6 +6,8 @@
 #include "jv_dtoa_tsd.h"
 #include "jv_dtoa.h"
 #include "jv_alloc.h"
+#include "jv.h"
+#include "jv_private.h"
 
 static pthread_once_t dtoa_ctx_once = PTHREAD_ONCE_INIT;
 
@@ -49,3 +52,103 @@ inline struct dtoa_context *tsd_dtoa_context_get() {
   }
   return ctx;
 }
+
+int jvp_number_cmp(jv a, jv b) {
+  assert(jv_get_kind(a) == JV_KIND_NUMBER);
+  assert(jv_get_kind(b) == JV_KIND_NUMBER);
+
+#ifdef USE_DECNUM
+  if (jv_number_has_literal(a) && jv_number_has_literal(b)) {
+    jvp_literal_number *la = (jvp_literal_number *)a.u.ptr;
+    jvp_literal_number *lb = (jvp_literal_number *)b.u.ptr;
+    decNumber *dn_a = &la->num_decimal;
+    decNumber *dn_b = &lb->num_decimal;
+    decContext *ctx = jvp_dec_context();
+    decNumber res;
+
+    assert(ctx->digits >= 1);
+    assert(ctx->emax >= 0);
+
+    if (dn_a->digits == 1 && dn_b->digits == 1 &&
+        dn_a->lsu[0] == 0 && dn_b->lsu[0] == 0 &&
+        (dn_a->bits & DECSPECIAL) == 0 &&
+        (dn_b->bits & DECSPECIAL) == 0) {
+      return 0;
+    }
+
+    decNumberCompare(&res, dn_a, dn_b, ctx);
+    if (decNumberIsZero(&res)) {
+      return 0;
+    } else if (decNumberIsNegative(&res)) {
+      return -1;
+    } else {
+      return 1;
+    }
+  }
+
+  {
+    struct dtoa_context *C = tsd_dtoa_context_get();
+    jvp_literal_number *lit;
+    decNumberDoublePrecision dec_double;
+    char literal[DEC_NUBMER_DOUBLE_PRECISION + DEC_NUMBER_STRING_GUARD + 1];
+    char *end;
+    double da;
+    double db;
+    int cache_empty = (C->p5s == NULL);
+    int i;
+    for (i = 0; i <= Kmax; i++) {
+      if (C->freelist[i] != NULL) {
+        cache_empty = 0;
+        break;
+      }
+    }
+    if (cache_empty) {
+      jvp_dtoa_context_init(C);
+    }
+
+    if (jv_number_has_literal(a)) {
+      lit = (jvp_literal_number *)a.u.ptr;
+      if (a.size != JV_NUMBER_SIZE_CONVERTED) {
+        decNumberReduce(&dec_double.number, &lit->num_decimal, jvp_dec_context_to_double());
+        decNumberToString(&dec_double.number, literal);
+        lit->num_double = jvp_strtod(C, literal, &end);
+      }
+      da = lit->num_double;
+    } else {
+      da = a.u.number;
+    }
+
+    if (jv_number_has_literal(b)) {
+      lit = (jvp_literal_number *)b.u.ptr;
+      if (b.size != JV_NUMBER_SIZE_CONVERTED) {
+        decNumberReduce(&dec_double.number, &lit->num_decimal, jvp_dec_context_to_double());
+        decNumberToString(&dec_double.number, literal);
+        lit->num_double = jvp_strtod(C, literal, &end);
+      }
+      db = lit->num_double;
+    } else {
+      db = b.u.number;
+    }
+
+    if (da < db) {
+      return -1;
+    } else if (da == db) {
+      return 0;
+    } else {
+      return 1;
+    }
+  }
+#else
+  {
+    double da = a.u.number;
+    double db = b.u.number;
+    if (da < db) {
+      return -1;
+    } else if (da == db) {
+      return 0;
+    } else {
+      return 1;
+    }
+  }
+#endif
+}
diff --git a/src/jv_private.h b/src/jv_private.h
index 066520f..a89b967 100644
--- a/src/jv_private.h
+++ b/src/jv_private.h
@@ -1,7 +1,47 @@
 #ifndef JV_PRIVATE
 #define JV_PRIVATE
 
+#include "jv.h"
+
+struct jv_refcnt {
+  int count;
+};
+
 int jvp_number_cmp(jv, jv);
 int jvp_number_is_nan(jv);
 
+#ifdef USE_DECNUM
+#ifndef DECNUMDIGITS
+#define DECNUMDIGITS 1
+#endif
+#include "decNumber/decNumber.h"
+
+enum {
+  JVP_NUMBER_NATIVE = 0,
+  JVP_NUMBER_DECIMAL = 1
+};
+
+#define JV_NUMBER_SIZE_INIT      (0)
+#define JV_NUMBER_SIZE_CONVERTED (1)
+
+#define DEC_NUBMER_DOUBLE_PRECISION   (16)
+#define DEC_NUMBER_STRING_GUARD       (14)
+#define DEC_NUBMER_DOUBLE_EXTRA_UNITS ((DEC_NUBMER_DOUBLE_PRECISION - DECNUMDIGITS + DECDPUN - 1)/DECDPUN)
+
+typedef struct {
+  struct jv_refcnt refcnt;
+  double num_double;
+  char *literal_data;
+  decNumber num_decimal; /* must be the last field in the structure for memory management */
+} jvp_literal_number;
+
+typedef struct {
+  decNumber number;
+  decNumberUnit units[DEC_NUBMER_DOUBLE_EXTRA_UNITS];
+} decNumberDoublePrecision;
+
+decContext *jvp_dec_context(void);
+decContext *jvp_dec_context_to_double(void);
+#endif
+
 #endif //JV_PRIVATE
