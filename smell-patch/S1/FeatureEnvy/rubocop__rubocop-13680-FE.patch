diff --git a/lib/rubocop/cop/style/redundant_line_continuation.rb b/lib/rubocop/cop/style/redundant_line_continuation.rb
index 92a42af0f..2b85b97f3 100644
--- a/lib/rubocop/cop/style/redundant_line_continuation.rb
+++ b/lib/rubocop/cop/style/redundant_line_continuation.rb
@@ -93,6 +93,41 @@ module RuboCop
           inspect_end_of_ruby_code_line_continuation
         end
 
+        def ignored_literal_ranges(ast)
+          return @ignored_literal_range_set if @ignored_literal_range_set
+
+          @ignored_literal_range_set = Set.new
+          return @ignored_literal_range_set if ast.nil? || processed_source.nil?
+
+          ast.each_node(:str, :dstr, :array) do |literal|
+            loc = literal.location
+            next unless loc
+
+            expression = loc.expression
+            next unless expression
+            next if expression.single_line? && expression.source.empty?
+
+            if literal.type == :array
+              begin_loc = loc.begin
+              next unless begin_loc && begin_loc.source.start_with?('%')
+
+              @ignored_literal_range_set << expression
+            elsif loc.is_a?(Parser::Source::Map::Heredoc)
+              body = loc.heredoc_body
+              @ignored_literal_range_set << body if body
+            elsif loc.respond_to?(:begin) && loc.begin
+              @ignored_literal_range_set << expression
+            else
+              parent = literal.parent
+              if parent && (parent.type == :regexp || parent.type == :xstr)
+                @ignored_literal_range_set << expression
+              end
+            end
+          end
+
+          @ignored_literal_range_set
+        end
+
         private
 
         def require_line_continuation?(range)
