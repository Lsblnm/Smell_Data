+    /**
+     * Clone the first model in the collection into a new, non-existing instance.
+     *
+     * @param  array|null  $except
+     * @return \Illuminate\Database\Eloquent\Model|null
+     */
+    public function replicateModel(array $except = null)
+    {
+        $model = $this->escapeWhenCastingToString
+            ? $this->first()
+            : ($this->items[array_key_first($this->items)] ?? $this->first());
+
+        if (! $model instanceof Model) {
+            return $model;
+        }
+
+        $defaults = array_values(array_filter([
+            $model->getKeyName(),
+            $model->getCreatedAtColumn(),
+            $model->getUpdatedAtColumn(),
+        ]));
+
+        $excluded = $except ? array_unique(array_merge($except, $defaults)) : $defaults;
+        $attributes = $model->getAttributes();
+
+        foreach ($attributes as $key => $value) {
+            if (! $value instanceof DateTimeInterface) {
+                continue;
+            }
+
+            $moment = Date::instance($value);
+            $timezone = $moment->getTimezone();
+            $normalized = Date::create(
+                $moment->year,
+                $moment->month,
+                $moment->day,
+                (int) $moment->format('G'),
+                (int) $moment->format('i'),
+                (int) $moment->format('s'),
+                $timezone->getName()
+            );
+            $normalized->setTime(
+                (int) $moment->format('G'),
+                (int) $moment->format('i'),
+                (int) $moment->format('s'),
+                (int) $moment->format('u')
+            );
+
+            $attributes[$key] = $normalized->eq($moment) ? $value : $normalized;
+        }
+
+        $attributes = Arr::except($attributes, $excluded);
+
+        $class = get_class($model);
+        $instance = new $class;
+
+        $instance->setRawAttributes($attributes);
+        $instance->setRelations($model->getRelations());
+
+        return $instance;
+    }
