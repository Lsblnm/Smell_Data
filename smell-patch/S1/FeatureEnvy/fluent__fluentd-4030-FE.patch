diff --git a/lib/fluent/plugin/out_forward/ack_handler.rb b/lib/fluent/plugin/out_forward/ack_handler.rb
index 362117b9..1fc76fdb 100644
--- a/lib/fluent/plugin/out_forward/ack_handler.rb
+++ b/lib/fluent/plugin/out_forward/ack_handler.rb
@@ -79,6 +79,36 @@ module Fluent::Plugin
         end
       end
 
+      def ack_check(select_interval, output)
+        connection_manager = output.connection_manager
+        collect_response(select_interval) do |chunk_id, node, sock, result|
+          cache = connection_manager.socket_cache
+          if output.keepalive && cache
+            cache.checkin(sock)
+          else
+            sock.close_write rescue nil
+            sock.close rescue nil
+          end
+
+          case result
+          when Result::SUCCESS
+            output.commit_write(chunk_id)
+          when Result::FAILED
+            @log.trace 'failed to receive ack', host: node.host, port: node.port, name: node.name, hard_timeout: node.failure.hard_timeout, timeout: @timeout
+            node.disable!
+            output.rollback_write(chunk_id, update_retry: false)
+          when Result::CHUNKID_UNMATCHED
+            output.rollback_write(chunk_id, update_retry: false)
+          else
+            @log.warn("BUG: invalid status #{result} #{chunk_id}")
+
+            if chunk_id
+              output.rollback_write(chunk_id, update_retry: false)
+            end
+          end
+        end
+      end
+
       ACKWaitingSockInfo = Struct.new(:sock, :chunk_id, :chunk_id_base64, :node, :expired_time) do
         def expired?(now)
           expired_time < now
