+// ApplyURISubstring performs substring replacement on the request URI using
+// the find/replace/limit values from rep and this replacer's value sources.
+func (r *Replacer) ApplyURISubstring(rep URISubstring, req *http.Request) {
+	if rep.Find == "" {
+		return
+	}
+
+	lim := rep.Limit
+	if lim == 0 {
+		lim = -1
+	}
+
+	expander := Replacer{providers: r.providers, static: r.static}
+	find := expander.ReplaceAll(rep.Find, "")
+	replace := expander.ReplaceAll(rep.Replace, "")
+	mergeSlashes := !strings.Contains(rep.Find, "//")
+
+	origURI := req.RequestURI
+	req.URL.RawPath = strings.Replace(cleanURIPath(req.URL.EscapedPath(), mergeSlashes), find, replace, lim)
+	if unescaped, err := url.PathUnescape(req.URL.RawPath); err == nil && unescaped != "" {
+		req.URL.Path = unescaped
+	} else {
+		req.URL.Path = strings.Replace(cleanURIPath(req.URL.Path, mergeSlashes), find, replace, lim)
+	}
+	if req.URL.RawPath == req.URL.Path {
+		req.URL.RawPath = ""
+	}
+	req.URL.RawQuery = strings.Replace(req.URL.RawQuery, find, replace, lim)
+	if origURI != "" {
+		req.RequestURI = req.URL.RequestURI()
+	}
+}
+
+func cleanURIPath(p string, collapseSlashes bool) string {
+	if collapseSlashes {
+		return cleanURIPathPreserveSlash(p)
+	}
+
+	const tmpCh = 0xff
+	var sb strings.Builder
+	for i, ch := range p {
+		if ch == '/' && i > 0 && p[i-1] == '/' {
+			sb.WriteByte(tmpCh)
+		}
+		sb.WriteRune(ch)
+	}
+	halfCleaned := cleanURIPathPreserveSlash(sb.String())
+	return strings.ReplaceAll(halfCleaned, string([]byte{tmpCh}), "")
+}
+
+func cleanURIPathPreserveSlash(p string) string {
+	cleaned := path.Clean(p)
+	if cleaned != "/" && strings.HasSuffix(p, "/") {
+		cleaned += "/"
+	}
+	return cleaned
+}
