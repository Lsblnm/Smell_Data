-// Common code for date related functions.
-func dateWrapper(vals []parser.Value, enh *EvalNodeHelper, f func(time.Time) float64) Vector {
-	if len(vals) == 0 {
-		return append(enh.Out,
-			Sample{
-				Metric: labels.Labels{},
-				Point:  Point{V: f(time.Unix(enh.Ts/1000, 0).UTC())},
-			})
+// dateEval computes PromQL date function results at an evaluation timestamp.
+type dateEval struct {
+	ts  int64
+	out Vector
+}
+
+func (d *dateEval) apply(vals []parser.Value, fn *parser.Function, enh *EvalNodeHelper, extract func(time.Time) float64) Vector {
+	if fn == nil || parser.Functions[fn.Name] == nil {
+		return d.out
+	}
+
+	if len(vals) == 0 && fn.Variadic != 0 {
+		t := time.Unix(d.ts/1000, 0).UTC()
+		d.out = append(d.out, Sample{
+			Metric: labels.Labels{},
+			Point:  Point{V: extract(t)},
+		})
+		enh.Out = d.out
+		return d.out
+	}
+
+	if len(fn.ArgTypes) == 0 || fn.ArgTypes[0] != parser.ValueTypeVector {
+		enh.Out = d.out
+		return d.out
 	}
 
 	for _, el := range vals[0].(Vector) {
 		t := time.Unix(int64(el.V), 0).UTC()
-		enh.Out = append(enh.Out, Sample{
-			Metric: enh.DropMetricName(el.Metric),
-			Point:  Point{V: f(t)},
+		metric := el.Metric
+		if enh.Dmn == nil {
+			enh.Dmn = make(map[uint64]labels.Labels, len(d.out))
+		}
+		h := metric.Hash()
+		if cached, ok := enh.Dmn[h]; ok {
+			metric = cached
+		} else {
+			dropped := make(labels.Labels, 0, len(metric))
+			for _, l := range metric {
+				if l.Name == labels.MetricName {
+					continue
+				}
+				dropped = append(dropped, labels.Label{Name: l.Name, Value: l.Value})
+			}
+			enh.Dmn[h] = dropped
+			metric = dropped
+		}
+		d.out = append(d.out, Sample{
+			Metric: metric,
+			Point:  Point{V: extract(t)},
 		})
 	}
-	return enh.Out
+	enh.Out = d.out
+	return d.out
+}
+
+func evalDate(vals []parser.Value, fnName string, enh *EvalNodeHelper, extract func(time.Time) float64) Vector {
+	d := dateEval{ts: enh.Ts, out: enh.Out}
+	return d.apply(vals, parser.Functions[fnName], enh, extract)
 }
 
