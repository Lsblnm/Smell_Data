 // ImportPath is the package import path for Caddy core.
 // This identifier may be removed in the future.
 const ImportPath = "github.com/caddyserver/caddy/v2"
+
+// ConfigExtClass classifies a config filename extension.
+type ConfigExtClass struct {
+	JSON  bool
+	Flags ConfigExtFlags
+}
+
+// NewConfigExtClass records whether ext identifies JSON and any
+// other extension flags needed to recognize a Caddyfile.
+func NewConfigExtClass(ext string) ConfigExtClass {
+	return ConfigExtClass{
+		JSON:  ext == ".json",
+		Flags: newConfigExtFlags(ext),
+	}
+}
