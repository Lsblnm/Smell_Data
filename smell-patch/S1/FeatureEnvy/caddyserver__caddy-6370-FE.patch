+// ConfigSourceName identifies a config file by its base name and
+// the naming patterns used to recognize Caddyfile sources.
+type ConfigSourceName struct {
+	Base    string
+	Pattern ConfigNamePattern
+}
+
+// NewConfigSourceName inspects configFile and records the base name
+// plus Caddyfile naming hints derived from it.
+func NewConfigSourceName(configFile string) ConfigSourceName {
+	base := strings.ToLower(filepath.Base(configFile))
+	return ConfigSourceName{
+		Base:    base,
+		Pattern: newConfigNamePattern(base),
+	}
+}
