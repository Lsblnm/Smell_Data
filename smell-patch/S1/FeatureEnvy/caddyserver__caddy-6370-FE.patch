+// ConfigExtFlags captures whether a config filename extension is
+// present but neither JSON nor Caddyfile.
+type ConfigExtFlags struct {
+	Ambiguous bool
+}
+
+func newConfigExtFlags(ext string) ConfigExtFlags {
+	return ConfigExtFlags{
+		Ambiguous: ext != "" && ext != ".caddyfile" && ext != ".json",
+	}
+}
