+
+// ConfigNamePattern records whether a config file name starts or
+// ends like a Caddyfile and classifies its extension.
+type ConfigNamePattern struct {
+	Prefixed bool
+	Suffixed bool
+	Class    caddy.ConfigExtClass
+}
+
+func newConfigNamePattern(base string) ConfigNamePattern {
+	return ConfigNamePattern{
+		Prefixed: strings.HasPrefix(base, "caddyfile"),
+		Suffixed: strings.HasSuffix(base, ".caddyfile"),
+		Class:    caddy.NewConfigExtClass(filepath.Ext(base)),
+	}
+}
