+  /**
+   * Replaces all segments from another {@link SegmentInfos}, but keeps generation, version, counter
+   * so that future commits remain write once.
+   */
+  private void replace(SegmentInfos other) {
+    Directory expectedDirectory = directoryOrig;
+    segmentInfos.clear();
+    for (SegmentCommitInfo commitInfo : other.asList()) {
+      SegmentInfo info = commitInfo.info;
+      Directory segmentDirectory = info.dir;
+      if (segmentDirectory != expectedDirectory) {
+        throw new IllegalArgumentException(
+            "IndexCommit's directory doesn't match my directory, expected="
+                + expectedDirectory
+                + ", got="
+                + segmentDirectory);
+      }
+      int maxDoc = info.maxDoc();
+      int delCount = commitInfo.getDelCount();
+      String postingsName = info.getCodec().postingsFormat().getName();
+      if (delCount < 0 || delCount > maxDoc || postingsName.isEmpty()) {
+        throw new IllegalStateException(
+            "cannot replace segment with invalid delCount="
+                + delCount
+                + " maxDoc="
+                + maxDoc
+                + " postings="
+                + postingsName);
+      }
+      Version minVersion = info.getMinVersion();
+      if (segmentInfos.getIndexCreatedVersionMajor() >= 7 && minVersion == null) {
+        throw new IllegalArgumentException(
+            "All segments must record the minVersion for indices created on or after Lucene 7");
+      }
+      segmentInfos.add(commitInfo);
+    }
+    segmentInfos.lastGeneration = other.lastGeneration;
+  }
