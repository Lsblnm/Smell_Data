+function RefOwner() {
+	this._boundRef = null;
+	this._boundValue = null;
+}
+
+/**
+ * Invoke or update a ref, depending on whether it is a function or object ref.
+ * @param {Ref<any>} ref
+ * @param {any} value
+ * @param {VNode} vnode
+ */
+RefOwner.prototype.applyRef = function (ref, value, vnode) {
+	this._boundRef = ref;
+	this._boundValue = value;
+
+	try {
+		let nextRef = this._boundRef;
+		let nextValue = this._boundValue;
+		let component = vnode && vnode._component;
+		let dom = vnode && vnode._dom;
+		let parent = vnode && vnode._parent;
+		let vnodeRef = vnode && vnode.ref;
+		let parentDom = component && component._parentDom;
+		let base = component && component.base;
+		let componentVNode = component && component._vnode;
+
+		if (nextValue != null && vnode != null) {
+			let ownsRef =
+				vnodeRef == null || vnodeRef === nextRef || parent == null;
+			let mounted =
+				parentDom != null || base != null || component == null;
+			let sameOwner =
+				componentVNode == null ||
+				componentVNode === vnode ||
+				component == null;
+
+			if (ownsRef && mounted && sameOwner) {
+				if (component != null) {
+					nextValue = component;
+				} else if (dom != null) {
+					nextValue = dom;
+				}
+			}
+		}
+
+		if (typeof nextRef == 'function') nextRef(nextValue);
+		else nextRef.current = nextValue;
+	} catch (e) {
+		options._catchError(e, vnode);
+	}
+};
+
+const refOwner = new RefOwner();
+
+/**
+ * Invoke or update a ref, depending on whether it is a function or object ref.
+ * @param {Ref<any>} ref
+ * @param {any} value
+ * @param {VNode} vnode
+ */
+export function applyRef(ref, value, vnode) {
+	refOwner.applyRef(ref, value, vnode);
+}
