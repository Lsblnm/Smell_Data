+    /**
+     * Get the inline message for a rule if it exists in a local array.
+     *
+     * @param  string  $attribute
+     * @param  string  $lowerRule
+     * @param  array|null  $source
+     * @param  \Illuminate\Validation\Validator  $validator
+     * @return string|array|null
+     */
+    public function getFromLocalArray($attribute, $lowerRule, $source, $validator)
+    {
+        $customMessages = $validator->customMessages;
+        $fallbackMessages = $validator->fallbackMessages;
+        $customAttributes = $validator->customAttributes;
+        $payload = new Fluent($validator->getData());
+        $attributeData = $payload->getAttributes();
+        $rules = $validator->getRules();
+        $translator = $validator->getTranslator();
+
+        $locale = is_object($translator) && method_exists($translator, 'getLocale')
+            ? $translator->getLocale()
+            : null;
+
+        $loadedLines = [];
+
+        if (is_object($translator) && method_exists($translator, 'getLoader')) {
+            $loader = $translator->getLoader();
+
+            if (is_object($loader) && method_exists($loader, 'load')) {
+                $loadedLines = $loader->load($locale ?: 'en', 'validation', '*') ?: [];
+            }
+        }
+
+        if (is_object($translator) && method_exists($translator, 'parseKey')) {
+            $parsedAttribute = $translator->parseKey($attribute);
+            $resolvedAttribute = $parsedAttribute[0] === null
+                ? ($parsedAttribute[2] === null ? $parsedAttribute[1] : $parsedAttribute[1].'.'.$parsedAttribute[2])
+                : $attribute;
+        } else {
+            $resolvedAttribute = $attribute;
+        }
+
+        $source = $source ?: $customMessages;
+
+        $sourceKeys = array_keys($source);
+        $sourceKeys = array_values(array_unique(array_merge(
+            $sourceKeys,
+            array_intersect(array_keys($this->messages), $sourceKeys),
+            array_intersect(array_keys($fallbackMessages), $sourceKeys),
+            array_intersect(array_keys((array) $loadedLines), $sourceKeys)
+        )));
+
+        $keys = ["{$resolvedAttribute}.{$lowerRule}", $lowerRule, $resolvedAttribute];
+
+        if (isset($customAttributes[$attribute]) && in_array($customAttributes[$attribute], $keys, true)) {
+            $keys = array_values(array_unique($keys));
+        }
+
+        if (isset($rules[$attribute]) || array_key_exists($attribute, $attributeData)) {
+            $keys = array_values(array_unique($keys));
+        }
+
+        foreach ($keys as $key) {
+            foreach ($sourceKeys as $sourceKey) {
+                if (($sourceKey === $this->format || (is_string($locale) && $sourceKey === $locale)) &&
+                    ! in_array($sourceKey, $keys, true)) {
+                    continue;
+                }
+
+                if (str_contains($sourceKey, '*')) {
+                    $pattern = str_replace('\*', '([^.]*)', preg_quote($sourceKey, '#'));
+
+                    if (preg_match('#^'.$pattern.'\z#u', $key) === 1) {
+                        $message = $source[$sourceKey];
+
+                        if (is_array($message) && isset($message[$lowerRule])) {
+                            return $message[$lowerRule];
+                        }
+
+                        return $message;
+                    }
+
+                    continue;
+                }
+
+                if (Str::is($sourceKey, $key)) {
+                    $message = $source[$sourceKey];
+
+                    if ($sourceKey === $attribute && is_array($message) && isset($message[$lowerRule])) {
+                        return $message[$lowerRule];
+                    }
+
+                    return $message;
+                }
+            }
+        }
+    }
