+pub(crate) struct ExecInvocation {
+    function_name: &'static str,
+    report_range: TextRange,
+}
+
+impl ExecInvocation {
+    pub(crate) fn for_exec(report_range: TextRange) -> Self {
+        Self {
+            function_name: "exec",
+            report_range,
+        }
+    }
+
+    /// S102
+    pub(crate) fn exec_used(&self, checker: &mut Checker, func: &Expr) {
+        let reports_exec = {
+            let semantic = checker.semantic();
+            if let Some(name) = func.as_name_expr() {
+                if let Some(binding_id) = semantic
+                    .resolve_name(name)
+                    .or_else(|| semantic.lookup_symbol(name.id.as_str()))
+                {
+                    let binding = semantic.binding(binding_id);
+                    match &binding.kind {
+                        BindingKind::Builtin => {
+                            !binding.is_external() && name.id.as_str() == self.function_name
+                        }
+                        BindingKind::Import(_)
+                        | BindingKind::FromImport(_)
+                        | BindingKind::SubmoduleImport(_) => {
+                            binding.is_external()
+                                && semantic.resolve_qualified_name(func).is_some_and(
+                                    |qualified_name| {
+                                        matches!(
+                                            qualified_name.segments(),
+                                            [module, member]
+                                                if *module == "builtin"
+                                                    && *member == self.function_name
+                                        )
+                                    },
+                                )
+                        }
+                        _ => semantic
+                            .resolve_qualified_name(func)
+                            .is_some_and(|qualified_name| {
+                                matches!(
+                                    qualified_name.segments(),
+                                    ["" | "builtin", member] if *member == self.function_name
+                                )
+                            }),
+                    }
+                } else {
+                    false
+                }
+            } else {
+                semantic
+                    .resolve_qualified_name(func)
+                    .is_some_and(|qualified_name| {
+                        matches!(
+                            qualified_name.segments(),
+                            ["" | "builtin", member] if *member == self.function_name
+                        )
+                    })
+            }
+        };
+
+        if reports_exec {
+            checker
+                .diagnostics
+                .push(Diagnostic::new(ExecBuiltin, self.report_range));
+        }
     }
 }
