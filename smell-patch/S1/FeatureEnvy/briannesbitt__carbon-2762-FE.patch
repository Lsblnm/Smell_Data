 class FactoryImmutable extends Factory
 {
     protected $className = CarbonImmutable::class;
+
+    /**
+     * Round a date interval using this factory's date class and timezone settings.
+     *
+     * @param string                              $unit
+     * @param float|int|string|\DateInterval|null $precision
+     * @param string                              $function
+     *
+     * @return CarbonInterval
+     */
+    public function roundInterval(CarbonInterval $interval, $unit, $precision = 1, $function = 'round')
+    {
+        $dateClass = $this->className;
+        $timeZone = CarbonTimeZone::instance($this->settings['timezone'] ?? 'UTC');
+        $tzName = $timeZone->getName();
+        $base = $dateClass::parse('2000-01-01 00:00:00', $tzName === 'UTC' ? $tzName : 'UTC')
+            ->roundUnit($unit, $precision, $function);
+        $next = $base->add($interval);
+        $inverted = $next->timestamp < $base->timestamp
+            || ($next->timestamp === $base->timestamp && $next->micro < $base->micro);
+
+        if ($inverted) {
+            $next = $base->sub($interval);
+        }
+
+        $diff = $next
+            ->roundUnit($unit, $precision, $function)
+            ->diffAsCarbonInterval($base);
+
+        $interval->years = $diff->years;
+        $interval->months = $diff->months;
+        $interval->dayz = $diff->dayz;
+        $interval->hours = $diff->hours;
+        $interval->minutes = $diff->minutes;
+        $interval->seconds = $diff->seconds;
+        $interval->microseconds = $diff->microseconds;
+
+        return $interval->invert($inverted);
+    }
 }
