@@ -1448,6 +1448,22 @@ void addAuthErrReply(client *c, robj *err) {
     addReplyError(c, err->ptr);
 }
 
+/* Initialize client authentication state. */
+void clientSetDefaultAuth(client *c) {
+    /* If the default user does not require authentication, the user is
+     * directly authenticated. */
+    c->user = DefaultUser;
+    c->flag.authenticated = (c->user->flags & USER_FLAG_NOPASS) && !(c->user->flags & USER_FLAG_DISABLED);
+}
+
+int authRequired(client *c) {
+    /* Check if the user is authenticated. This check is skipped in case
+     * the default user is flagged as "nopass" and is active. */
+    int auth_required = (!(DefaultUser->flags & USER_FLAG_NOPASS) || (DefaultUser->flags & USER_FLAG_DISABLED)) &&
+                        !c->flag.authenticated;
+    return auth_required;
+}
+
 /* This is like ACLCheckUserCredentials(), however if the user/pass
  * are correct, the connection is put in authenticated state and the
  * connection user reference is populated.
@@ -2203,6 +2219,42 @@ static int ACLLoadConfiguredUsers(void) {
     return C_OK;
 }
 
+/* After a successful ACL file load, attach each connected client to the
+ * matching reloaded user and drop subscribers whose channel permissions shrank. */
+static void applyReloadedAclToClient(client *c, rax *user_channels) {
+    user *original = c->user;
+    user *new_user = NULL;
+    list *channels = NULL;
+
+    if (original == DefaultUser) {
+        new_user = DefaultUser;
+    } else {
+        raxFind(Users, (unsigned char *)original->name, sdslen(original->name), (void **)&new_user);
+    }
+
+    int replication_link = (c == server.primary) || c->flag.primary;
+    int has_pubsub_state = c->pubsub_data && (dictSize(c->pubsub_data->pubsub_channels) ||
+                                             dictSize(c->pubsub_data->pubsub_patterns) ||
+                                             dictSize(c->pubsub_data->pubsubshard_channels));
+
+    if (new_user && user_channels) {
+        if (!raxFind(user_channels, (unsigned char *)new_user->name, sdslen(new_user->name), (void **)&channels)) {
+            if (original->selectors) {
+                channels = getUpcomingChannelList(new_user, original);
+            }
+            raxInsert(user_channels, (unsigned char *)new_user->name, sdslen(new_user->name), channels, NULL);
+        }
+    }
+
+    /* When the new channel list is NULL, it means the new user's channel list is a superset of the old user's
+     * list. Replication links are not pubsub clients, so they keep the rebinding path without subscriber eviction. */
+    if (!new_user || (channels && !replication_link && has_pubsub_state && ACLShouldKillPubsubClient(c, channels))) {
+        freeClient(c);
+        return;
+    }
+    c->user = new_user;
+}
+
