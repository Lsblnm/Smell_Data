--- a/src/syntax_mapping.rs
+++ b/src/syntax_mapping.rs
@@ -1,6 +1,11 @@
 use std::path::Path;
 
-use crate::error::Result;
+use path_abs::PathAbs;
+
+use crate::assets::{HighlightingAssets, SyntaxReferenceInSet};
+use crate::config::Config;
+use crate::error::{Error, Result};
+use crate::input::{OpenedInput, OpenedInputKind};
 use ignored_suffixes::IgnoredSuffixes;
 
 use globset::{Candidate, GlobBuilder, GlobMatcher};
@@ -218,6 +223,111 @@ impl<'a> SyntaxMapping<'a> {
         Ok(())
     }
 
+    pub(crate) fn get_syntax<'b>(
+        &self,
+        assets: &'b HighlightingAssets,
+        config: &Config<'_>,
+        input: &mut OpenedInput<'_>,
+    ) -> Result<SyntaxReferenceInSet<'b>> {
+        if let Some(language) = config.language {
+            let syntax_set = assets
+                .syntax_set_cell
+                .get_or_try_init(|| assets.serialized_syntax_set.deserialize())?;
+            return syntax_set
+                .find_syntax_by_token(language)
+                .map(|syntax| SyntaxReferenceInSet { syntax, syntax_set })
+                .ok_or_else(|| Error::UnknownSyntax(language.to_owned()));
+        }
+
+        let path = input.metadata.user_provided_name.as_ref().or(match &input.kind {
+            OpenedInputKind::OrdinaryFile(path) => Some(path),
+            _ => None,
+        });
+
+        let path_syntax = if let Some(path) = path {
+            let abs_path =
+                PathAbs::new(path).map_or_else(|_| path.to_owned(), |p| p.as_path().to_path_buf());
+            let path = abs_path.as_path();
+            let path_label = path.to_string_lossy();
+            let undetected = if input.description.name == path_label {
+                input.description.name.clone()
+            } else {
+                path_label.into_owned()
+            };
+
+            let candidate = Candidate::new(path);
+            let candidate_filename = path.file_name().map(Candidate::new);
+            let mut syntax_match = None;
+            for (ref glob, ref syntax) in self.mappings.iter().rev() {
+                if glob.is_match_candidate(&candidate)
+                    || candidate_filename
+                        .as_ref()
+                        .map_or(false, |filename| glob.is_match_candidate(filename))
+                {
+                    syntax_match = Some(*syntax);
+                    break;
+                }
+            }
+            if syntax_match.is_none() {
+                if let Some(file_name) = path.file_name() {
+                    syntax_match = self
+                        .ignored_suffixes
+                        .try_with_stripped_suffix(file_name, |stripped_file_name| {
+                            Ok(self.get_syntax_for(stripped_file_name))
+                        })
+                        .ok()
+                        .flatten();
+                }
+            }
+
+            if let Some(MappingTarget::MapToUnknown) = syntax_match {
+                Err(Error::UndetectedSyntax(undetected))
+            } else if let Some(MappingTarget::MapTo(syntax_name)) = syntax_match {
+                assets
+                    .find_syntax_by_name(syntax_name)?
+                    .ok_or_else(|| Error::UnknownSyntax(syntax_name.to_owned()))
+            } else {
+                let file_name = path.file_name().unwrap_or_default();
+                match (
+                    assets.get_syntax_for_file_name(file_name, &self.ignored_suffixes)?,
+                    syntax_match,
+                ) {
+                    (Some(syntax), _) => Ok(syntax),
+                    (_, Some(MappingTarget::MapExtensionToUnknown)) => {
+                        Err(Error::UndetectedSyntax(undetected))
+                    }
+                    _ => assets
+                        .get_syntax_for_file_extension(file_name, &self.ignored_suffixes)?
+                        .ok_or_else(|| Error::UndetectedSyntax(undetected)),
+                }
+            }
+        } else {
+            Err(Error::UndetectedSyntax("[unknown]".into()))
+        };
+
+        match path_syntax {
+            Err(Error::UndetectedSyntax(path)) => {
+                let reader = &input.reader;
+                let consider_first_line = reader.content_type.map_or(true, |content_type| {
+                    !content_type.is_binary() || config.show_nonprintable
+                });
+                let from_first_line = if consider_first_line {
+                    let syntax_set = assets
+                        .syntax_set_cell
+                        .get_or_try_init(|| assets.serialized_syntax_set.deserialize())?;
+                    String::from_utf8(reader.first_line.clone())
+                        .ok()
+                        .and_then(|line| syntax_set.find_syntax_by_first_line(&line))
+                        .map(|syntax| SyntaxReferenceInSet { syntax, syntax_set })
+                } else {
+                    None
+                };
+                from_first_line.ok_or(Error::UndetectedSyntax(path))
+            }
+            other => other,
+        }
+    }
+
     pub fn mappings(&self) -> &[(GlobMatcher, MappingTarget<'a>)] {
         &self.mappings
     }
