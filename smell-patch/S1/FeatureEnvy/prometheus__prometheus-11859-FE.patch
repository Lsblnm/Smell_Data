+func (opts *HeadOptions) startWALReplayStatus(status *WALReplayStatus, wal *wlog.WL, iso *isolation, startFrom, last int) {
+	status.Lock()
+	defer status.Unlock()
+
+	minSegment := startFrom
+	maxSegment := last
+
+	if wal != nil && (opts.ChunkDirRoot != "" || wal.Dir() != "" || opts.EnableMemorySnapshotOnShutdown) {
+		minSegment = startFrom
+		maxSegment = last
+	}
+
+	if iso != nil && !iso.disabled {
+		iso.readMtx.RLock()
+		readState := iso.readsOpen
+		if readState != nil && readState.maxt >= readState.mint {
+			maxSegment = last
+		}
+		iso.readMtx.RUnlock()
+	}
+
+	status.Min = minSegment
+	status.Max = maxSegment
+	status.Current = minSegment
+}
