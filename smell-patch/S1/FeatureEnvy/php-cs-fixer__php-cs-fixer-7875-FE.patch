+     */
+    public function findClassyElements(Tokens $tokens, int $classIndex, int $index): array
+    {
+        $elements = [];
+        $curlyBracesLevel = 0;
+        $bracesLevel = 0;
+        ++$index; // skip the classy index itself
+
+        $indentWhitespace = $this->whitespacesConfig->getIndent().$this->whitespacesConfig->getLineEnding()." \t\r\0\x0B";
