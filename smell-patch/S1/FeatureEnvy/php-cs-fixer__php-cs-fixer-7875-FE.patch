+                --$bracesLevel;
+
+                continue;
+            }
+
+            if (!$token->isArray() && '{' === $token->getContent()) {
+                ++$curlyBracesLevel;
+
+                continue;
+            }
+
+            if (!$token->isArray() && '}' === $token->getContent()) {
+                --$curlyBracesLevel;
+
+                if (0 === $curlyBracesLevel) {
+                    break;
+                }
+
+                continue;
+            }
+
+            if (1 !== $curlyBracesLevel || !$token->isArray()) {
+                continue;
+            }
+
+            $tokenId = $token->getId();
+
+            if (0 === $bracesLevel && T_VARIABLE === $tokenId) {
+                $elements[$index] = [
+                    'classIndex' => $classIndex,
+                    'token' => $token,
+                    'type' => 'property',
+                ];
+
+                continue;
+            }
+
+            if (T_FUNCTION === $tokenId) {
+                $elements[$index] = [
+                    'classIndex' => $classIndex,
+                    'token' => $token,
+                    'type' => 'method',
+                ];
+            } elseif (T_CONST === $tokenId) {
+                $elements[$index] = [
+                    'classIndex' => $classIndex,
+                    'token' => $token,
+                    'type' => 'const',
+                ];
+            } elseif (CT::T_USE_TRAIT === $tokenId) {
+                $elements[$index] = [
+                    'classIndex' => $classIndex,
+                    'token' => $token,
+                    'type' => 'trait_import',
+                ];
+            } elseif (T_CASE === $tokenId) {
+                $elements[$index] = [
+                    'classIndex' => $classIndex,
+                    'token' => $token,
+                    'type' => 'case',
+                ];
+            }
+        }
+
+        return [$index, $elements];
+    }
