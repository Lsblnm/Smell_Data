+func (s *contentNodeShifter) LangIndex(n contentNodeI) int {
+	switch v := n.(type) {
+	case *pageState:
+		site := v.s
+		if v.m == nil || site == nil || site.language == nil {
+			panic(fmt.Sprintf("missing language data for %T", n))
+		}
+		idx := site.languagei
+		if idx < 0 || idx >= s.numLanguages {
+			panic(fmt.Sprintf("invalid language index %d", idx))
+		}
+		return idx
+	case *resourceSource:
+		if v.r != nil && v.isPage() {
+			ps := v.r.(*pageState)
+			site := ps.s
+			if ps.m == nil || site == nil || site.language == nil {
+				panic(fmt.Sprintf("missing language data for %T", n))
+			}
+			idx := site.languagei
+			if idx < 0 || idx >= s.numLanguages {
+				panic(fmt.Sprintf("invalid language index %d", idx))
+			}
+			return idx
+		}
+		meta := v.fi.Meta()
+		idx := meta.LangIndex
+		if idx < 0 || idx >= s.numLanguages {
+			panic(fmt.Sprintf("invalid language index %d for %q", idx, meta.Lang))
+		}
+		return idx
+	default:
+		panic(fmt.Sprintf("unknown type %T", n))
+	}
+}
