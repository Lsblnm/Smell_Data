 // Format spec handler that saves references to arguments representing dynamic
diff --git a/include/fmt/format.h b/include/fmt/format.h
index 534ad3d8..cae01e7b 100644
--- a/include/fmt/format.h
+++ b/include/fmt/format.h
@@ -3527,6 +3527,26 @@ template <typename Char> struct arg_formatter {
   }
 };
 
+template <typename Char>
+template <typename Formatter, typename T>
+auto specs_setter<Char>::write_integral(Formatter& formatter, T value)
+    -> decltype(formatter.out) {
+  if (std::is_same<T, Char>::value) {
+    auto fmt_specs = specs_;
+    if (fmt_specs.type != presentation_type::none &&
+        fmt_specs.type != presentation_type::chr) {
+      return write_integral(formatter, static_cast<int>(value));
+    }
+    fmt_specs.sign = sign::none;
+    fmt_specs.alt = false;
+    fmt_specs.fill[0] = static_cast<Char>(' ');
+    if (fmt_specs.align == align::none || fmt_specs.align == align::numeric)
+      fmt_specs.align = align::right;
+    return write<Char>(formatter.out, static_cast<Char>(value), fmt_specs);
+  }
+  return write(formatter.out, value, specs_, formatter.locale);
+}
+
