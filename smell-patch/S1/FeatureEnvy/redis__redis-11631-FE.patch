+/* Reply with a geo search hit using a 4-digit fixed-point distance.
+ * The default addReplyDouble has too much accuracy: "5.2145 meters away"
+ * is nicer than "5.2144992818115 meters away." Four digits remain accurate
+ * enough even when the unit is kilometers. */
+void addReplyDoubleDistance(client *c, geoArray *ga, size_t idx, GeoShape *shape,
+                            int withdist, int withhash, int withcoords, int option_length)
+{
+    geoPoint *gp;
+    char dbuf[128];
+    int dlen;
+    int skip_reply;
+
+    if (ga->array == NULL || idx >= ga->used)
+        return;
+    gp = ga->array + idx;
+    gp->dist /= shape->conversion;
+
+    skip_reply = !(c->flags & (CLIENT_SCRIPT|CLIENT_MODULE)) &&
+                 ((c->flags & CLIENT_CLOSE_ASAP) || c->conn == NULL);
+    if (skip_reply) {
+        if (gp->member) {
+            sdsfree(gp->member);
+            gp->member = NULL;
+        }
+        return;
+    }
+
+    if (option_length)
+        addReplyArrayLen(c, option_length + 1);
+
+    if (gp->member) {
+        addReplyBulkSds(c, gp->member);
+        gp->member = NULL;
+    }
+
+    if (withdist) {
+        dlen = fixedpoint_d2string(dbuf, sizeof(dbuf), gp->dist, 4);
+        addReplyBulkCBuffer(c, dbuf, dlen);
+    }
+
+    if (withhash)
+        addReplyLongLong(c, gp->score);
+
+    if (withcoords) {
+        addReplyArrayLen(c, 2);
+        addReplyHumanLongDouble(c, gp->longitude);
+        addReplyHumanLongDouble(c, gp->latitude);
+    }
+}
+
 /* Add sds to reply (takes ownership of sds and frees it) */
 void addReplyBulkSds(client *c, sds s)  {
     addReplyLongLongWithPrefix(c,sdslen(s),'$');
