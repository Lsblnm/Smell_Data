+func resolveRequestPath(engine *Engine, req *http.Request) (string, bool) {
+	rPath := req.URL.Path
+	unescape := false
+	if engine.UseRawPath && len(req.URL.RawPath) > 0 {
+		rPath = req.URL.RawPath
+		unescape = engine.UnescapePathValues
+	}
+	if engine.RemoveExtraSlash {
+		rPath = cleanPath(rPath)
+	}
+	return rPath, unescape
+}
+
+func applyRouteMatch(c *Context, value nodeValue) {
+	if value.params != nil {
+		c.Params = *value.params
+	}
+	c.handlers = value.handlers
+	c.fullPath = value.fullPath
+}
+
+func handleNoMatch(engine *Engine, c *Context, root *node, value nodeValue, method, rPath string, unescape bool) bool {
+	if root != nil && method != http.MethodConnect && rPath != "/" {
+		if value.tsr && engine.RedirectTrailingSlash {
+			redirectTrailingSlash(c)
+			return true
+		}
+		if engine.RedirectFixedPath && redirectFixedPath(c, root, engine.RedirectFixedPath) {
+			return true
+		}
+	}
+	if engine.HandleMethodNotAllowed {
+		for _, tree := range engine.trees {
+			if tree.method == method {
+				continue
+			}
+			if match := tree.root.getValue(rPath, nil, c.skippedNodes, unescape); match.handlers != nil {
+				c.handlers = engine.allNoMethod
+				serveError(c, http.StatusMethodNotAllowed, default405Body)
+				return true
+			}
+		}
+	}
+	return false
+}
+
+func applyNoRoute(engine *Engine, c *Context) {
+	c.handlers = engine.allNoRoute
+}
+
+func (p *LogFormatterParams) handleHTTPRequest(c *Context) {
+	engine := c.engine
+	p.Method = c.Request.Method
+	unescape := false
+	p.Path, unescape = resolveRequestPath(engine, c.Request)
+	root := engine.trees.get(p.Method)
+	value := nodeValue{}
+	if root != nil {
+		value = root.getValue(p.Path, c.params, c.skippedNodes, unescape)
+	}
+	if value.handlers != nil {
+		applyRouteMatch(c, value)
+		c.Next()
+		c.writermem.WriteHeaderNow()
+		return
+	}
+	if handleNoMatch(engine, c, root, value, p.Method, p.Path, unescape) {
+		return
+	}
+	applyNoRoute(engine, c)
+	c.writermem.status = http.StatusNotFound
+	c.Next()
+	if c.writermem.Written() {
+		return
+	}
+	if c.writermem.Status() == http.StatusNotFound {
+		c.writermem.Header()["Content-Type"] = []string{binding.MIMEPlain}
+		if _, err := c.Writer.Write(default404Body); err != nil {
+			debugPrint("cannot write message to writer during serve error: %v", err)
+		}
+		return
+	}
+	c.writermem.WriteHeaderNow()
+}
