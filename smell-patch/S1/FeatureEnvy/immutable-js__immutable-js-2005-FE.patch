+
+  hashCollection(collection) {
+    if (collection.size === Infinity) {
+      return 0;
+    }
+
+    const ordered = Boolean(collection[IS_ORDERED_SYMBOL]);
+    const keyed = Boolean(collection[IS_KEYED_SYMBOL]);
+    this._seed = ordered ? 1 : 0;
+
+    const nestedMap = collection._map;
+    const nestedList = collection._list;
+    const mapSize = nestedMap ? nestedMap.size : undefined;
+    const mapRoot = nestedMap ? nestedMap._root : undefined;
+    const listOrigin = nestedList ? nestedList._origin : undefined;
+    const listCapacity = nestedList ? nestedList._capacity : undefined;
+
+    const useListEntries =
+      isOrderedMap(collection) &&
+      nestedList !== undefined &&
+      listOrigin !== undefined &&
+      listCapacity !== undefined;
+    const useMapKeys =
+      nestedMap !== undefined && !keyed && mapSize !== undefined;
+
+    if (useListEntries) {
+      nestedList.__iterate(entry => {
+        if (entry) {
+          this._seed =
+            (31 * this._seed + hashMerge(hash(entry[1]), hash(entry[0]))) | 0;
+        }
+      });
+      this._mixed = listCapacity - listOrigin;
+    } else if (useMapKeys) {
+      if (mapRoot || mapSize !== 0) {
+        this._mixed = nestedMap.__iterate(value => {
+          this._seed = ordered
+            ? (31 * this._seed + hash(value)) | 0
+            : (this._seed + hash(value)) | 0;
+        });
+      } else {
+        this._mixed = mapSize;
+      }
+    } else {
+      this._mixed = collection.__iterate(
+        keyed
+          ? ordered
+            ? (v, k) => {
+                this._seed =
+                  (31 * this._seed + hashMerge(hash(v), hash(k))) | 0;
+              }
+            : (v, k) => {
+                this._seed = (this._seed + hashMerge(hash(v), hash(k))) | 0;
+              }
+          : ordered
+          ? v => {
+              this._seed = (31 * this._seed + hash(v)) | 0;
+            }
+          : v => {
+              this._seed = (this._seed + hash(v)) | 0;
+            }
+      );
+    }
+
+    return murmurHashOfSize(this._mixed, this._seed);
+  }
+}
+
