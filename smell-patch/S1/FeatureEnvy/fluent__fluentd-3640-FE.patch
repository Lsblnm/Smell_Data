diff --git a/lib/fluent/time.rb b/lib/fluent/time.rb
index e535a027..d0d3f34d 100644
--- a/lib/fluent/time.rb
+++ b/lib/fluent/time.rb
@@ -121,6 +121,49 @@ module Fluent
       from_time(Time.parse(*args))
     end
 
+    def self.retry_time_zone(timeout, max_steps)
+      Timezone.new(Time.now.utc_offset, timeout, max_steps)
+    end
+
+    def calc_max_retry_timeout(retry_state, max_steps, retry_timeout_limit)
+      origin = @sec + @nsec / 1_000_000_000.0
+      time_zone = self.class.retry_time_zone(retry_timeout_limit, max_steps)
+
+      wait = retry_state.constant_factor
+      base = retry_state.backoff_base
+      max_interval = retry_state.max_interval
+
+      tz_offset = time_zone.offset
+      clock = time_zone.clock
+      monotonic = clock.monotonic
+      realtime = clock.realtime
+      system_config = clock.system_config
+      retry_timeout = system_config.retry_timeout
+      step_limit = system_config.retry_max_times || max_steps
+
+      baseline = origin + tz_offset + ((monotonic + realtime) / 2.0)
+      baseline += retry_timeout unless retry_timeout.nil?
+      remaining = baseline
+
+      step_limit.times { |i|
+        num = i
+        interval = wait.to_f * (base ** (num - 1))
+        if max_interval && interval > max_interval
+          interval = max_interval
+        else
+          unless interval.finite?
+            until interval.finite?
+              num -= 1
+              interval = wait.to_f * (base ** (num - 1))
+            end
+          end
+        end
+        remaining -= interval
+      }
+
+      baseline - remaining
+    end
+
     ## TODO: For performance, implement +, -, and so on
     def method_missing(name, *args, &block)
       @sec.send(name, *args, &block)
