+pub(crate) struct ExternalProcess {
+    cwd: PathBuf,
+    glob_root: PathBuf,
+}
+
+impl ExternalProcess {
+    pub(crate) fn new(cwd: impl AsRef<Path>) -> Self {
+        let cwd = cwd.as_ref().to_path_buf();
+        Self {
+            glob_root: cwd.clone(),
+            cwd,
+        }
+    }
+
+    /// Spawn a command without shelling out to an external shell
+    pub fn spawn_simple_command(
+        &self,
+        command: &ExternalCommand,
+    ) -> Result<std::process::Command, ShellError> {
+        let name = &command.name;
+        let (head, _, _) = trim_enclosing_quotes(&name.item);
+        let head = nu_path::expand_to_real_path(head)
+            .to_string_lossy()
+            .to_string();
+
+        let mut process = std::process::Command::new(head);
+
+        let glob_cwd = command
+            .env_vars
+            .get("PWD")
+            .map(PathBuf::from)
+            .filter(|pwd| pwd.as_path() == self.cwd.as_path())
+            .unwrap_or_else(|| self.cwd.clone());
+
+        for (arg, arg_keep_raw) in command.args.iter().zip(command.arg_keep_raw.iter()) {
+            let arg = Spanned {
+                item: arg.item.clone(),
+                span: Span::new(arg.span.start, arg.span.end),
+            };
+            trim_expand_and_apply_arg(
+                &mut process,
+                &arg,
+                arg_keep_raw,
+                &glob_cwd,
+                &self.glob_root,
+            );
+        }
+
+        Ok(process)
+    }
+}
