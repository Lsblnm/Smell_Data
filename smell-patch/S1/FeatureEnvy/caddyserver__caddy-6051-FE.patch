diff --git a/caddyconfig/caddyfile/importgraph.go b/caddyconfig/caddyfile/importgraph.go
index d27f4710..06c863ac 100644
--- a/caddyconfig/caddyfile/importgraph.go
+++ b/caddyconfig/caddyfile/importgraph.go
@@ -16,6 +16,9 @@ package caddyfile
 
 import (
 	"fmt"
+	"strings"
+
+	"github.com/caddyserver/caddy/v2/caddyconfig"
 )
 
 type adjacency map[string][]string
@@ -128,3 +131,75 @@ func (i *importGraph) exists(key string) bool {
 	_, exists := i.nodes[key]
 	return exists
 }
+
+// finalizeHeredoc takes the runes read as the heredoc text and the marker,
+// and processes the text to strip leading whitespace, returning the final
+// value without the leading whitespace.
+func (i *importGraph) finalizeHeredoc(l *lexer, d *Dispenser, val []rune, marker string) ([]rune, error) {
+	if !i.exists(marker) {
+		i.addNode(marker)
+	}
+	pendingImports := 0
+	if dests, ok := i.edges[marker]; ok {
+		pendingImports = len(dests)
+	}
+
+	tok := l.token
+	if d != nil && d.cursor >= 0 && d.cursor < len(d.tokens) {
+		tok = d.tokens[d.cursor]
+	}
+
+	heredocMarker := marker
+	if tok.wasQuoted == '<' && tok.heredocMarker != "" {
+		heredocMarker = tok.heredocMarker
+	}
+
+	startLine := l.line
+	if tok.Line > 0 {
+		startLine = tok.Line + pendingImports
+	}
+
+	stringVal := string(val)
+
+	// find the last newline of the heredoc, which is where the contents end
+	lastNewline := strings.LastIndex(stringVal, "\n")
+
+	// collapse the content, then split into separate lines
+	lines := strings.Split(stringVal[:lastNewline+1], "\n")
+
+	// figure out how much whitespace we need to strip from the front of every line
+	// by getting the string that precedes the marker, on the last line
+	paddingToStrip := stringVal[lastNewline+1 : len(stringVal)-len(heredocMarker)]
+
+	warn := caddyconfig.Warning{
+		Line:      startLine,
+		Directive: heredocMarker,
+		Message:   paddingToStrip,
+	}
+
+	// iterate over each line and strip the whitespace from the front
+	var out string
+	for lineNum, lineText := range lines[:len(lines)-1] {
+		// find an exact match for the padding
+		index := strings.Index(lineText, warn.Message)
+
+		// if the padding doesn't match exactly at the start then we can't safely strip
+		if index != 0 {
+			warn.Line = startLine + lineNum + 1
+			warn.Message = lineText
+			return nil, fmt.Errorf("mismatched leading whitespace in heredoc <<%s on line #%d [%s], expected whitespace [%s] to match the closing marker", warn.Directive, warn.Line, warn.Message, paddingToStrip)
+		}
+
+		// strip, then append the line, with the newline, to the output.
+		// also removes all "\r" because Windows.
+		out += strings.ReplaceAll(lineText[len(paddingToStrip):]+"\n", "\r", "")
+	}
+
+	// Remove the trailing newline from the loop
+	if len(out) > 0 && out[len(out)-1] == '\n' {
+		out = out[:len(out)-1]
+	}
+
+	// return the final value
+	return []rune(out), nil
+}
