diff --git a/src/locfile.c b/src/locfile.c
index 7415ab7..a671080 100644
--- a/src/locfile.c
+++ b/src/locfile.c
@@ -7,6 +7,7 @@
 #include "jq.h"
 #include "jv_alloc.h"
 #include "locfile.h"
+#include "compile.h"
 
 
 struct locfile* locfile_init(jq_state *jq, const char *fname, const char* data, int length) {
@@ -90,3 +91,55 @@ void locfile_locate(struct locfile* l, location loc, const char* fmt, ...) {
   jq_report_error(l->jq, m2);
   return;
 }
+
+block gen_cond(block cond, block iftrue, block iffalse) {
+  location cond_source = UNKNOWN_LOCATION;
+  struct locfile *cond_file = 0;
+  int file_lines = 0;
+  int file_length = 0;
+  int cond_is_loadk = 0;
+
+  if (cond.first != 0) {
+    cond_source = cond.first->source;
+    cond_file = cond.first->locfile;
+    if (cond_file != 0) {
+      file_lines = cond_file->nlines;
+      file_length = cond_file->length;
+    }
+    cond_is_loadk = (cond.first == cond.last && cond.first->op == LOADK);
+  }
+
+  block cond_exp;
+  if (cond.first == 0 && cond.last == 0) {
+    cond_exp = gen_op_simple(DUP);
+  } else if (cond_is_loadk) {
+    jv constant = jv_copy(cond.first->imm.constant);
+    block_free(cond);
+    cond_file = 0;
+    cond_exp = gen_op_pushk_under(constant);
+  } else {
+    cond_exp = BLOCK(gen_op_simple(SUBEXP_BEGIN), cond, gen_op_simple(SUBEXP_END));
+  }
+
+  const struct opcode_description *jump_desc = opcode_describe(JUMP);
+  const struct opcode_description *jumpf_desc = opcode_describe(JUMP_F);
+  assert((jump_desc->flags & OP_HAS_BRANCH) != 0);
+  assert((jumpf_desc->flags & OP_HAS_BRANCH) != 0);
+
+  block iffalse_body = BLOCK(gen_op_simple(POP), iffalse);
+  block iftrue_body = BLOCK(gen_op_simple(POP), iftrue);
+  block jump = gen_op_target(JUMP, iffalse_body);
+  if (jump.first != 0) {
+    jump.first->imm.target = iffalse_body.last;
+  }
+  iftrue_body = BLOCK(iftrue_body, jump);
+  block branches = BLOCK(gen_op_target(JUMP_F, iftrue_body), iftrue_body, iffalse_body);
+  block result = BLOCK(gen_op_simple(DUP), BLOCK(cond_exp, gen_op_simple(POP)), branches);
+
+  if (cond_file != 0 && file_lines > 0 && file_length >= 0 &&
+      cond_source.start != UNKNOWN_LOCATION.start &&
+      cond_source.end != UNKNOWN_LOCATION.end) {
+    result = gen_location(cond_source, cond_file, result);
+  }
+  return result;
+}
