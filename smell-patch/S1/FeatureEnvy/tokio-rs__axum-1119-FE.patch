+impl<B> RouteFuture<B, Infallible>
+where
+    B: HttpBody + Send + 'static,
+{
+    pub(super) fn empty() -> Self {
+        Self {
+            kind: RouteFutureKind::Response { response: None },
+            strip_body: false,
+            allow_header: None,
+        }
+    }
+
+    pub(super) fn call_router(self, router: &super::Router<B>, mut req: Request<B>) -> Self {
+        let strip_body = self.strip_body;
+        let allow_header = self.allow_header;
+
+        let path = req.uri().path().to_owned();
+
+        match router.node.at(&path) {
+            Ok(match_) => router.call_route(match_, req),
+            Err(err) => {
+                let uri = req.uri();
+                let query = uri.query();
+                let scheme = uri.scheme().cloned();
+                let authority = uri.authority().cloned();
+
+                let new_path = match err {
+                    MatchError::MissingTrailingSlash => Some(format!("{}/", path)),
+                    MatchError::ExtraTrailingSlash => path.strip_suffix('/').map(str::to_owned),
+                    MatchError::NotFound => None,
+                };
+
+                if let Some(new_path) = new_path {
+                    let mut new_path_and_query = new_path;
+                    if let Some(query) = query {
+                        new_path_and_query.push('?');
+                        new_path_and_query.push_str(query);
+                    }
+
+                    let mut parts = http::uri::Parts::default();
+                    parts.scheme = scheme;
+                    parts.authority = authority;
+                    parts.path_and_query = Some(new_path_and_query.parse().unwrap());
+
+                    if let Some(new_uri) = Uri::from_parts(parts).ok() {
+                        let redirect = Redirect::permanent(&new_uri.to_string());
+                        let mut future = RouteFuture::from_response(Redirect::build_response(
+                            redirect.status_code,
+                            redirect.location,
+                        ));
+                        future.strip_body = strip_body;
+                        future.allow_header = allow_header;
+                        return future;
+                    }
+                }
+
+                match &router.fallback {
+                    super::Fallback::Default(inner) => inner.clone().call(req),
+                    super::Fallback::Custom(inner) => inner.clone().call(req),
+                }
+            }
+        }
+    }
+}
+
