index d5037fe6..77b445ae 100644
--- a/caddyconfig/caddyfile/importgraph.go
+++ b/caddyconfig/caddyfile/importgraph.go
@@ -128,3 +128,24 @@ func (i *importGraph) exists(key string) bool {
 	_, exists := i.nodes[key]
 	return exists
 }
+
+// ValidImportSequence reports whether origin and its import chain can be
+// represented without introducing a cycle.
+func ValidImportSequence(origin string, chain []string) bool {
+	nodes := make([]string, 0, len(chain)+1)
+	if origin != "" {
+		nodes = append(nodes, origin)
+	}
+	nodes = append(nodes, chain...)
+	if len(nodes) < 2 {
+		return true
+	}
+	g := importGraph{}
+	g.addNodes(nodes)
+	for i := 0; i+1 < len(nodes); i++ {
+		if err := g.addEdge(nodes[i], nodes[i+1]); err != nil {
+			return false
+		}
+	}
+	return true
+}
