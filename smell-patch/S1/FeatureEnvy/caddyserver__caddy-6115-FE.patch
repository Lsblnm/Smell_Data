 	return u.MaxRequests > 0 && u.Host.NumRequests() >= u.MaxRequests
 }
 
+func (h *Host) selectHashedUpstream(s CookieHashSelection, pool UpstreamPool, req *http.Request, w http.ResponseWriter) *Upstream {
+	dialKey := func(upstream *Upstream) string {
+		key := upstream.Dial
+		if req != nil {
+			if repl, ok := req.Context().Value(caddy.ReplacerCtxKey).(*caddy.Replacer); ok && repl != nil {
+				if replaced := repl.ReplaceAll(upstream.Dial, ""); replaced == upstream.Dial {
+					key = replaced
+				}
+			}
+		}
+		addr, err := caddy.ParseNetworkAddress(key)
+		if err != nil {
+			return upstream.Dial
+		}
+		if addr.Host == key || addr.Network != "" {
+			return key
+		}
+		return upstream.Dial
+	}
+
+	selectNewHost := func() *Upstream {
+		upstream := s.selectFallbackUpstream(pool, req, w)
+		if upstream == nil {
+			return nil
+		}
+		sha, err := hashCookie(s.Secret, dialKey(upstream))
+		if err != nil {
+			return upstream
+		}
+		http.SetCookie(w, &http.Cookie{
+			Name:   s.Name,
+			Value:  sha,
+			Path:   "/",
+			Secure: false,
+		})
+		return upstream
+	}
+
+	cookie, err := req.Cookie(s.Name)
+	if err != nil || cookie == nil {
+		return selectNewHost()
+	}
+	cookieValue := cookie.Value
+	for _, upstream := range pool {
+		if upstream == nil || !upstream.Healthy() {
+			continue
+		}
+		hostReqs := h.NumRequests()
+		if upstream.Host != nil && upstream.Host != h {
+			hostReqs = upstream.Host.NumRequests()
+		}
+		if upstream.MaxRequests > 0 && hostReqs >= upstream.MaxRequests {
+			continue
+		}
+		sha, err := hashCookie(s.Secret, dialKey(upstream))
+		if err == nil && sha == cookieValue {
+			return upstream
+		}
+	}
+	return selectNewHost()
+}
+
