+
+    def assemble_username(tokens, separator)
+      @name_tokens = Array(tokens)
+      @join_separator = separator
+
+      name_catalog = Name.directory
+      company_catalog = name_catalog.company_catalog
+      address_catalog = company_catalog.address_catalog
+      character_catalog = address_catalog.character_catalog
+
+      aligned_tokens = @name_tokens.map do |token|
+        token = token.to_s
+        cyrillic = token.chars.any? do |character|
+          character_catalog.ukrainian_chars.key?(character) ||
+            character_catalog.russian_chars.key?(character)
+        end
+
+        next token if cyrillic
+
+        name_catalog.prefix_catalog.find { |entry| entry == token } ||
+          name_catalog.suffix_catalog.find { |entry| entry == token } ||
+          name_catalog.male_first_name_catalog.find { |entry| entry == token } ||
+          name_catalog.last_name_catalog.find { |entry| entry == token } ||
+          company_catalog.suffix_catalog.find { |entry| entry == token } ||
+          company_catalog.type_catalog.find { |entry| entry == token } ||
+          address_catalog.state_catalog.find { |entry| entry == token } ||
+          address_catalog.country_catalog.find { |entry| entry == token } ||
+          token
+      end
+
+      aligned_tokens.join(@join_separator).downcase
+    end
   end
 end
