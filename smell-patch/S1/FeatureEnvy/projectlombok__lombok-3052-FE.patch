+import com.sun.tools.javac.tree.JCTree.JCVariableDecl;
+import com.sun.tools.javac.util.List;
+import com.sun.tools.javac.util.Name;
 
 import lombok.Builder;
 import lombok.core.AST.Kind;
 import lombok.core.AnnotationValues;
 import lombok.core.HandlerPriority;
 import lombok.experimental.SuperBuilder;
+import lombok.javac.JavacAST;
 import lombok.javac.JavacAnnotationHandler;
 import lombok.javac.JavacNode;
+import lombok.javac.JavacTreeMaker;
 import lombok.spi.Provides;
 
 @Provides
 @HandlerPriority(-1025) //HandleBuilder's level, minus one.
 public class HandleBuilderDefault extends JavacAnnotationHandler<Builder.Default> {
+	private final int defaultProviderModifiers = Flags.PRIVATE | Flags.STATIC;
+	private final int defaultProviderBodyFlags = 0;
+
 	@Override public void handle(AnnotationValues<Builder.Default> annotation, JCAnnotation ast, JavacNode annotationNode) {
 		JavacNode annotatedField = annotationNode.up();
 		if (annotatedField.getKind() != Kind.FIELD) return;
@@ -59,4 +74,26 @@ public class HandleBuilderDefault extends JavacAnnotationHandler<Builder.Default
 			}
 		}
 	}
+
+	public JCMethodDecl generateDefaultProvider(Name methodName, JavacNode fieldNode, List<JCTypeParameter> params) {
+		if (fieldNode.getKind() != Kind.FIELD) return null;
+
+		JavacAST ast = fieldNode.getAst();
+		JavacTreeMaker maker = ast.getTreeMaker();
+		JCVariableDecl field = (JCVariableDecl) fieldNode.get();
+
+		JavacNode enclosingType = fieldNode.up();
+		JCClassDecl classDecl = (JCClassDecl) enclosingType.get();
+		List<JCTypeParameter> typeParams = classDecl.typarams;
+		if (params != null && params != typeParams) typeParams = params;
+
+		JCExpression init = field.init;
+		JCExpression fieldType = field.vartype;
+		field.init = null;
+
+		JCStatement statement = maker.Return(init);
+		JCBlock body = maker.Block(this.defaultProviderBodyFlags, List.<JCStatement>of(statement));
+		int modifiers = this.defaultProviderModifiers;
+		return maker.MethodDef(maker.Modifiers(modifiers), methodName, cloneType(maker, fieldType, fieldNode), copyTypeParams(fieldNode, typeParams), List.<JCVariableDecl>nil(), List.<JCExpression>nil(), body, null);
+	}
 }
