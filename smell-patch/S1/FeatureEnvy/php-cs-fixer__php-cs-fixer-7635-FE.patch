@@ -154,6 +154,139 @@ public function getFunctionArguments(Tokens $tokens, int $functionIndex): array
         return $arguments;
     }
 
+    /**
+     * @param array<string, string>                                               $uses
+     * @param callable(string, string, array<string, string>, string): void       $registerSymbolForImport
+     * @param callable(string, array<string, string>, string): (null|list<Token>) $determineShortType
+     */
+    public function replaceByShortType(
+        Tokens $tokens,
+        TypeAnalysis $type,
+        array $uses,
+        string $namespaceName,
+        bool $importSymbols,
+        callable $registerSymbolForImport,
+        callable $determineShortType
+    ): void {
+        $cachedFunctionAnalysis = $this->functionsAnalysis;
+        $declaredTypeName = $type->getName();
+        $typeStartIndex = $type->getStartIndex();
+        $typeEndIndex = $type->getEndIndex();
+
+        if ('' === $declaredTypeName) {
+            return;
+        }
+
+        $namespace = null;
+        foreach ($tokens->getNamespaceDeclarations() as $declaration) {
+            if (
+                strtolower($declaration->getFullName()) === $namespaceName
+                && $typeStartIndex >= $declaration->getScopeStartIndex()
+                && $typeEndIndex <= $declaration->getScopeEndIndex()
+            ) {
+                $namespace = $declaration;
+
+                break;
+            }
+        }
+
+        if (null !== $namespace) {
+            $namespaceUsesAnalyzer = new NamespaceUsesAnalyzer();
+            foreach ($namespaceUsesAnalyzer->getDeclarationsInNamespace($tokens, $namespace) as $use) {
+                $normalisedName = strtolower(ltrim($use->getFullName(), '\\'));
+                if (!isset($uses[$normalisedName])) {
+                    $uses[$normalisedName] = $use->getShortName();
+                }
+            }
+        }
+
+        if ($tokens[$typeStartIndex]->isGivenKind(CT::T_NULLABLE_TYPE)) {
+            $typeStartIndex = $tokens->getNextMeaningfulToken($typeStartIndex);
+        }
+
+        $rewroteType = false;
+        $types = $this->getTypes($tokens, $typeStartIndex, $typeEndIndex);
+
+        foreach ($types as $typeName => [$startIndex, $endIndex]) {
+            if ((new TypeAnalysis($typeName))->isReservedType()) {
+                return;
+            }
+
+            if ($importSymbols) {
+                $registerSymbolForImport('class', $typeName, $uses, $namespaceName);
+            }
+
+            $shortType = $determineShortType($typeName, $uses, $namespaceName);
+
+            if (null !== $shortType) {
+                $tokens->overrideRange($startIndex, $endIndex, $shortType);
+                $rewroteType = true;
+            }
+        }
+
+        if ($rewroteType && ['tokens' => '', 'imports' => [], 'declarations' => []] !== $cachedFunctionAnalysis) {
+            $this->functionsAnalysis = ['tokens' => '', 'imports' => [], 'declarations' => []];
+        }
+    }
+
+    /**
+     * @return iterable<string, array{int, int}>
+     */
+    private function getTypes(Tokens $tokens, int $index, int $endIndex): iterable
+    {
+        $skipNextYield = false;
+        $typeStartIndex = $typeEndIndex = null;
+        $type = null;
+        while (true) {
+            if ($tokens[$index]->isGivenKind(CT::T_DISJUNCTIVE_NORMAL_FORM_TYPE_PARENTHESIS_OPEN)) {
+                $index = $tokens->getNextMeaningfulToken($index);
+                $typeStartIndex = $typeEndIndex = null;
+                $type = null;
+
+                continue;
+            }
+
+            if (
+                $tokens[$index]->isGivenKind([CT::T_TYPE_ALTERNATION, CT::T_TYPE_INTERSECTION, CT::T_DISJUNCTIVE_NORMAL_FORM_TYPE_PARENTHESIS_CLOSE])
+                || $index > $endIndex
+            ) {
+                if (!$skipNextYield && null !== $typeStartIndex) {
+                    $origCount = \count($tokens);
+
+                    yield $type => [$typeStartIndex, $typeEndIndex];
+
+                    $endIndex += \count($tokens) - $origCount;
+
+                    // type tokens were possibly updated, restart type match
+                    $skipNextYield = true;
+                    $index = $typeEndIndex = $typeStartIndex;
+                    $type = null;
+                } else {
+                    $skipNextYield = false;
+                    $index = $tokens->getNextMeaningfulToken($index);
+                    $typeStartIndex = $typeEndIndex = null;
+                    $type = null;
+                }
+
+                if ($index > $endIndex) {
+                    break;
+                }
+
+                continue;
+            }
+
+            if (null === $typeStartIndex) {
+                $typeStartIndex = $index;
+                $type = '';
+            }
+
+            $typeEndIndex = $index;
+            $type .= $tokens[$index]->getContent();
+
+            $index = $tokens->getNextMeaningfulToken($index);
+        }
+    }
