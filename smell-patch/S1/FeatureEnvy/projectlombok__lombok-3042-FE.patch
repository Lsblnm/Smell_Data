+	/**
+	 * Removes all type information from the provided tree.
+	 */
+	public void clearTypes(JCTree tree) {
+		JavacAST currentAst = this.ast;
+		JavacNode compilationUnitNode = currentAst.top();
+
+		if (tree instanceof JCAnnotation) {
+			JCAnnotation annotation = (JCAnnotation) tree;
+			JCTree annotationType = annotation.annotationType;
+			com.sun.tools.javac.util.List<JCExpression> args = annotation.args;
+			if (annotationType != null && compilationUnitNode != null) {
+				wipeResolvedType(annotationType);
+			}
+			if (args != null) {
+				for (JCExpression arg : args) {
+					JCExpression arrayExpr = arg;
+					if (arg instanceof JCAssign) {
+						JCAssign assign = (JCAssign) arg;
+						JCExpression lhs = assign.lhs;
+						JCExpression rhs = assign.rhs;
+						wipeResolvedType(lhs);
+						wipeResolvedType(rhs);
+						arrayExpr = rhs;
+					} else {
+						wipeResolvedType(arg);
+					}
+					if (arrayExpr instanceof JCNewArray) {
+						JCNewArray arr = (JCNewArray) arrayExpr;
+						JCExpression elemtype = arr.elemtype;
+						com.sun.tools.javac.util.List<JCExpression> dims = arr.dims;
+						com.sun.tools.javac.util.List<JCExpression> elems = arr.elems;
+						wipeResolvedType(elemtype);
+						if (dims != null) {
+							for (JCExpression dim : dims) wipeResolvedType(dim);
+						}
+						if (elems != null) {
+							for (JCExpression elem : elems) wipeResolvedType(elem);
+						}
+					}
+				}
+			}
+		}
+
+		tree.accept(new TypeClearingScanner());
+	}
+
+	private static void wipeResolvedType(JCTree node) {
+		if (node != null) node.type = null;
+	}
+
+	private static class TypeClearingScanner extends TreeScanner {
+		@Override public void scan(JCTree tree) {
+			tree.type = null;
+			super.scan(tree);
+		}
+		@Override public void visitClassDef(JCClassDecl tree) {
+			tree.sym = null;
+			super.visitClassDef(tree);
+		}
+		@Override public void visitMethodDef(JCMethodDecl tree) {
+			tree.sym = null;
+			super.visitMethodDef(tree);
+		}
+		@Override public void visitVarDef(JCVariableDecl tree) {
+			tree.sym = null;
+			super.visitVarDef(tree);
+		}
+		@Override public void visitSelect(JCFieldAccess tree) {
+			tree.sym = null;
+			super.visitSelect(tree);
+		}
+		@Override public void visitIdent(JCIdent tree) {
+			tree.sym = null;
+			super.visitIdent(tree);
+		}
+		@Override public void visitAnnotation(JCAnnotation tree) {
+			JavacHandlerUtil.JCAnnotationReflect.setAttribute(tree, null);
+			super.visitAnnotation(tree);
+		}
+	}
