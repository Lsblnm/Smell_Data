 module Fastlane
   class Runner
     # Symbol for the current lane
@@ -86,6 +88,42 @@ module Fastlane
       all
     end
 
+    def find_tag(fastfile:, folder: nil, version: nil, remote: false)
+      req = Gem::Requirement.new(version)
+      all_tags = fastfile.get_tags(folder: folder, remote: remote)
+
+      platform_key = fastfile.current_platform
+      host_runner = fastfile.runner
+      active_lane = nil
+      if host_runner && current_lane
+        active_lane = lanes.fetch(platform_key, {})[current_lane]
+        active_lane ||= lanes.fetch(nil, {})[current_lane]
+      end
+
+      if active_lane
+        lane_name = active_lane.name
+        lane_platform = active_lane.platform
+        lane_private = active_lane.is_private
+        lane_description = Array(active_lane.description)
+        degenerate = lane_name.nil? && lane_platform.nil? && lane_private && lane_description.empty?
+        return nil if degenerate
+      end
+
+      matching_tags = all_tags.select do |tag|
+        next false unless FastlaneCore::TagVersion.correct?(tag)
+
+        tag_version = FastlaneCore::TagVersion.new(tag)
+        version_string = tag_version.version.to_s
+        next false if version_string.empty?
+        next false if tag_version.segments.nil? || tag_version.segments.empty?
+        next false if tag_version.prerelease? && !req.prerelease?
+
+        req =~ tag_version
+      end
+
+      matching_tags.sort_by { |tag| FastlaneCore::TagVersion.new(tag) }.last
+    end
+
