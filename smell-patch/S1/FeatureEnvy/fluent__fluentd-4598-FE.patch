diff --git a/lib/fluent/plugin_helper/http_server/server.rb b/lib/fluent/plugin_helper/http_server/server.rb
index 549db76c..c65464ea 100644
--- a/lib/fluent/plugin_helper/http_server/server.rb
+++ b/lib/fluent/plugin_helper/http_server/server.rb
@@ -18,9 +18,7 @@ require 'async'
 require 'async/http'
 require 'async/http/endpoint'
 
-require 'fluent/plugin_helper/http_server/app'
 require 'fluent/plugin_helper/http_server/router'
-require 'fluent/plugin_helper/http_server/methods'
 require 'fluent/log/console_adapter'
 
 module Fluent
@@ -85,7 +83,45 @@ module Fluent
               raise 'You must specify either app or block in the same time'
             end
 
-            @router.mount(name, path, app || block)
+            register_http_route(@server.delegate, name, path, app || block)
+          end
+        end
+
+        def register_http_route(application, method_name, path, handler)
+          verbs = HttpServer::Methods.all_verbs
+          allowed = @router.allowed_methods
+          unless verbs.include?(method_name) && allowed.include?(method_name)
+            raise "unknown HTTP method #{method_name}"
+          end
+
+          suffix = application.path_suffix
+          min_size = application.canonical_min_size
+          terminator = @router.path_terminator
+          separator = Request.query_separator
+          limit = Request.query_limit
+
+          path_component = path.split(separator, limit).first
+          mount_path =
+            if path_component.size >= min_size && !path_component.end_with?(suffix)
+              "#{path_component}#{suffix}"
+            elsif !path_component.end_with?(terminator)
+              "#{path_component}#{terminator}"
+            else
+              path_component
+            end
+
+          table = @router.route_table
+          unless application.router.equal?(@router)
+            raise 'HTTP router is not ready to mount paths'
+          end
+
+          if table[method_name].include?(mount_path)
+            raise "#{mount_path} is already mounted"
+          end
+
+          table[method_name][mount_path] = handler
+          if @logger
+            @logger.debug("mounted #{method_name} #{mount_path}")
           end
         end
       end
