 }
 
+impl FormatSummary {
+    /// Generate a [`Edit`] to remove unused positional arguments from a `format` call.
+    pub(crate) fn remove_unused_positional_arguments_from_format_call(
+        &self,
+        unused_arguments: &[usize],
+        call: &ast::ExprCall,
+        locator: &Locator,
+        stylist: &Stylist,
+    ) -> anyhow::Result<Edit> {
+        let argument_count = call.arguments.args.len() + call.arguments.keywords.len();
+        let unused: Vec<usize> = unused_arguments
+            .iter()
+            .copied()
+            .filter(|index| {
+                *index < argument_count
+                    && !self.autos.contains(index)
+                    && !self.indices.contains(index)
+            })
+            .collect();
+
+        let source_range = TextRange::new(
+            call.range().start().min(call.func.start()),
+            call.range().end().max(call.func.end()),
+        );
+        let source_code = &locator.contents()[source_range];
+        let wrapped = format!("({source_code})");
+        let mut expression = match_expression(&wrapped)?;
+        {
+            let call_expr = match_call_mut(&mut expression)?;
+            let mut index = 0;
+            call_expr.args.retain(|_| {
+                let is_unused = unused.contains(&index);
+                index += 1;
+                !is_unused
+            });
+        }
+
+        let mut state = CodegenState {
+            default_newline: stylist.line_ending().as_str(),
+            default_indent: stylist.indentation().as_str(),
+            ..Default::default()
+        };
+        expression.codegen(&mut state);
+        let mut output = state.to_string();
+        output.drain(0..1);
+        output.drain(output.len() - 1..output.len());
+        Ok(Edit::range_replacement(output, call.range()))
+    }
+}
