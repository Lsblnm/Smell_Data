+	switch value.Kind() {
+	case reflect.Slice:
+		if !ok {
+			vs = []string{defaultValue}
+		}
+		slice := reflect.MakeSlice(value.Type(), len(vs), len(vs))
+		for i, s := range vs {
+			if err := assignOne(s, slice.Index(i)); err != nil {
+				return true, err
+			}
+		}
+		value.Set(slice)
+		return true, nil
+	case reflect.Array:
+		if !ok {
+			vs = []string{defaultValue}
+		}
+		if len(vs) != value.Len() {
+			return false, report(fmt.Errorf("%q is not valid value for %s", vs, value.Type().String()))
+		}
+		for i, s := range vs {
+			if err := assignOne(s, value.Index(i)); err != nil {
+				return true, err
+			}
+		}
+		return true, nil
+	default:
+		var val string
+		if !ok {
+			val = defaultValue
+		}
+		if len(vs) > 0 {
+			val = vs[0]
+		}
+		return true, assignOne(val, value)
+	}
