+func (c *Context) setFormField(value reflect.Value, field reflect.StructField, form map[string][]string, tagValue string, defaultExists bool, defaultValue string) (bool, error) {
+	var req *http.Request
+	var engine *Engine
+	if c != nil {
+		req = c.Request
+		engine = c.engine
+	}
+
+	var method, path, contentType string
+	if req != nil {
+		method = req.Method
+		if req.URL != nil {
+			path = req.URL.Path
+		}
+		contentType = req.Header.Get("Content-Type")
+	}
+
+	report := func(err error) error {
+		if err != nil {
+			debugPrint("set form field %s method=%s path=%s content-type=%s: %v", tagValue, method, path, contentType, err)
+		}
+		return err
+	}
+
+	vs, ok := form[tagValue]
+	if !ok && !defaultExists {
+		return false, nil
+	}
+
+	assignOne := func(raw string, dest reflect.Value) error {
+		switch dest.Kind() {
+		case reflect.Int:
+			return report(setIntField(raw, 0, dest))
+		case reflect.Int8:
+			return report(setIntField(raw, 8, dest))
+		case reflect.Int16:
+			return report(setIntField(raw, 16, dest))
+		case reflect.Int32:
+			return report(setIntField(raw, 32, dest))
+		case reflect.Int64:
+			switch dest.Interface().(type) {
+			case time.Duration:
+				d, err := time.ParseDuration(raw)
+				if err != nil {
+					return report(err)
+				}
+				dest.Set(reflect.ValueOf(d))
+				return nil
+			}
+			return report(setIntField(raw, 64, dest))
+		case reflect.Uint:
+			return report(setUintField(raw, 0, dest))
+		case reflect.Uint8:
+			return report(setUintField(raw, 8, dest))
+		case reflect.Uint16:
+			return report(setUintField(raw, 16, dest))
+		case reflect.Uint32:
+			return report(setUintField(raw, 32, dest))
+		case reflect.Uint64:
+			return report(setUintField(raw, 64, dest))
+		case reflect.Bool:
+			return report(setBoolField(raw, dest))
+		case reflect.Float32:
+			return report(setFloatField(raw, 32, dest))
+		case reflect.Float64:
+			return report(setFloatField(raw, 64, dest))
+		case reflect.String:
+			dest.SetString(raw)
+			return nil
+		case reflect.Struct:
+			switch dest.Interface().(type) {
+			case time.Time:
+				timeFormat := field.Tag.Get("time_format")
+				if timeFormat == "" {
+					timeFormat = time.RFC3339
+				}
+				if raw == "" {
+					dest.Set(reflect.ValueOf(time.Time{}))
+					return nil
+				}
+				l := time.Local
+				if isUTC, _ := strconv.ParseBool(field.Tag.Get("time_utc")); isUTC {
+					l = time.UTC
+				}
+				if locTag := field.Tag.Get("time_location"); locTag != "" {
+					loc, err := time.LoadLocation(locTag)
+					if err != nil {
+						return report(err)
+					}
+					l = loc
+				}
+				t, err := time.ParseInLocation(timeFormat, raw, l)
+				if err != nil {
+					return report(err)
+				}
