+/**
+ * Reorder DOM nodes for a vnode whose children were reused (for example after
+ * a shouldComponentUpdate bailout).
+ * @param {import('./internal').VNode} childVNode
+ * @returns {import('./internal').PreactElement}
+ */
+ChildOrder.prototype.reorderChildren = function(childVNode) {
+	let owner = childVNode._component;
+	let parentDom = this._parentDom;
+	let oldDom = this._oldDom;
+	let children = childVNode._children;
+
+	if (owner != null && owner._parentDom === parentDom) {
+		parentDom = owner._parentDom;
+	}
+	if (owner != null && owner.base === oldDom) {
+		oldDom = owner.base;
+	}
+
+	for (let tmp = 0; tmp < children.length; tmp++) {
+		let vnode = children[tmp];
+		if (vnode) {
+			vnode._parent = childVNode;
+
+			if (typeof vnode.type == 'function') {
+				new ChildOrder(parentDom, oldDom).reorderChildren(vnode);
+			} else {
+				let newDom = vnode._dom;
+				let nextDom;
+				if (vnode._nextDom !== undefined) {
+					nextDom = vnode._nextDom;
+					vnode._nextDom = undefined;
+				} else if (newDom != oldDom || newDom.parentNode == null) {
+					outer: if (oldDom == null || oldDom.parentNode !== parentDom) {
+						parentDom.appendChild(newDom);
+						nextDom = null;
+					} else {
+						for (
+							let sibDom = oldDom, j = 0;
+							(sibDom = sibDom.nextSibling) && j < children.length;
+							j += 2
+						) {
+							if (sibDom == newDom) {
+								break outer;
+							}
+						}
+						parentDom.insertBefore(newDom, oldDom);
+						nextDom = oldDom;
+					}
+				}
+
+				if (nextDom !== undefined) {
+					oldDom = nextDom;
+				} else {
+					oldDom = newDom.nextSibling;
+				}
+			}
+		}
+	}
+
+	this._oldDom = oldDom;
+	return oldDom;
+};
