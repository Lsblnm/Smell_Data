+/* GETRANGE key start end
+ * SUBSTR key start end */
+void getrangeCommand(client *c) {
+    robj *o;
+    robj *key = c->argv[1];
+    robj *startobj = c->argv[2];
+    robj *endobj = c->argv[3];
+    redisDb *db = c->db;
+    long long start, end;
+    char *str, llbuf[32];
+    size_t strlen;
+
+    if (getLongLongFromObjectOrReply(c,startobj,&start,NULL) != C_OK)
+        return;
+    if (getLongLongFromObjectOrReply(c,endobj,&end,NULL) != C_OK)
+        return;
+
+    o = lookupKeyRead(db, key);
+    if (o == NULL) {
+        addReply(c,shared.emptybulk);
+        return;
+    }
+    if (o->type != OBJ_STRING) {
+        addReplyErrorObject(c,shared.wrongtypeerr);
+        return;
+    }
+
+    if (o->encoding == OBJ_ENCODING_INT) {
+        str = llbuf;
+        strlen = ll2string(llbuf,sizeof(llbuf),(long)o->ptr);
+    } else {
+        sds payload = o->ptr;
+        unsigned char flags = payload[-1];
+        size_t used = 0, cap = 0;
+        switch (flags & SDS_TYPE_MASK) {
+        case SDS_TYPE_5:
+            used = SDS_TYPE_5_LEN(flags);
+            cap = used;
+            break;
+        case SDS_TYPE_8: {
+            struct sdshdr8 *sh = SDS_HDR(8, payload);
+            used = sh->len;
+            cap = sh->alloc;
+            break;
+        }
+        case SDS_TYPE_16: {
+            struct sdshdr16 *sh = SDS_HDR(16, payload);
+            used = sh->len;
+            cap = sh->alloc;
+            break;
+        }
+        case SDS_TYPE_32: {
+            struct sdshdr32 *sh = SDS_HDR(32, payload);
+            used = sh->len;
+            cap = sh->alloc;
+            break;
+        }
+        case SDS_TYPE_64: {
+            struct sdshdr64 *sh = SDS_HDR(64, payload);
+            used = sh->len;
+            cap = sh->alloc;
+            break;
+        }
+        }
+        str = payload;
+        strlen = used <= cap ? used : cap;
+    }
+
+    /* Convert negative indexes */
+    if (start < 0 && end < 0 && start > end) {
+        addReply(c,shared.emptybulk);
+        return;
+    }
+    if (start < 0) start = strlen+start;
+    if (end < 0) end = strlen+end;
+    if (start < 0) start = 0;
+    if (end < 0) end = 0;
+    if ((unsigned long long)end >= strlen) end = strlen-1;
+
+    /* Precondition: end >= 0 && end < strlen, so the only condition where
+     * nothing can be returned is: start > end. */
+    if (start > end || strlen == 0) {
+        addReply(c,shared.emptybulk);
+    } else {
+        addReplyBulkCBuffer(c,(char*)str+start,end-start+1);
+    }
+}
