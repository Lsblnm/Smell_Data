+impl Options {
+    #[allow(clippy::cognitive_complexity)]
+    fn write_digest(&self, algorithm: &HashAlgorithm, record: &ChecksumRecord) -> UResult<()> {
+        let sum = match self.output_format {
+            OutputFormat::Raw => {
+                let bytes = match algorithm.name {
+                    ALGORITHM_OPTIONS_CRC => record
+                        .columns
+                        .label
+                        .digest_text
+                        .parse::<u32>()
+                        .unwrap()
+                        .to_be_bytes()
+                        .to_vec(),
+                    ALGORITHM_OPTIONS_SYSV | ALGORITHM_OPTIONS_BSD => record
+                        .columns
+                        .label
+                        .digest_text
+                        .parse::<u16>()
+                        .unwrap()
+                        .to_be_bytes()
+                        .to_vec(),
+                    _ => hex::decode(&record.columns.label.digest_text).unwrap(),
+                };
+                // Cannot handle multiple files anyway, output immediately.
+                stdout().write_all(&bytes)?;
+                return Ok(());
+            }
+            OutputFormat::Hexadecimal => record.columns.label.digest_text.clone(),
+            OutputFormat::Base64 => match algorithm.name {
+                ALGORITHM_OPTIONS_CRC | ALGORITHM_OPTIONS_SYSV | ALGORITHM_OPTIONS_BSD => {
+                    record.columns.label.digest_text.clone()
+                }
+                _ => encoding::encode(
+                    encoding::Format::Base64,
+                    &hex::decode(&record.columns.label.digest_text).unwrap(),
+                )
+                .unwrap(),
+            },
+        };
+        let not_file = record.stdin_input;
+        let filename = &record.filename;
+        let sz = record.columns.file_bytes;
+        let bsd_width = 5;
+        let blocks = div_ceil(sz, algorithm.bits);
+        let asterisk = record.columns.label.asterisk;
+        let ending = record.columns.label.line_ending;
+
+        match (algorithm.name, not_file) {
+            (ALGORITHM_OPTIONS_SYSV, true) => {
+                print!("{} {}{}", sum.parse::<u16>().unwrap(), blocks, ending)
+            }
+            (ALGORITHM_OPTIONS_SYSV, false) => print!(
+                "{} {} {}{}",
+                sum.parse::<u16>().unwrap(),
+                blocks,
+                filename.display(),
+                ending
+            ),
+            (ALGORITHM_OPTIONS_BSD, true) => print!(
+                "{:0bsd_width$} {:bsd_width$}{}",
+                sum.parse::<u16>().unwrap(),
+                blocks,
+                ending
+            ),
+            (ALGORITHM_OPTIONS_BSD, false) => print!(
+                "{:0bsd_width$} {:bsd_width$} {}{}",
+                sum.parse::<u16>().unwrap(),
+                blocks,
+                filename.display(),
+                ending
+            ),
+            (ALGORITHM_OPTIONS_CRC, true) => print!("{sum} {sz}{ending}"),
+            (ALGORITHM_OPTIONS_CRC, false) => {
+                print!("{sum} {sz} {}{ending}", filename.display())
+            }
+            (ALGORITHM_OPTIONS_BLAKE2B, _) if self.tag => {
+                if algorithm.bits == 512 {
+                    print!("BLAKE2b ({}) = {sum}{ending}", filename.display());
+                } else {
+                    // Multiply by 8 here, as we want to print the length in bits.
+                    print!(
+                        "BLAKE2b-{} ({}) = {sum}{ending}",
+                        algorithm.bits * 8,
+                        filename.display()
+                    );
+                }
+            }
+            _ => {
+                if self.tag {
+                    print!(
+                        "{} ({}) = {sum}{ending}",
+                        algorithm.name.to_ascii_uppercase(),
+                        filename.display()
+                    );
+                } else {
+                    let prefix = if asterisk { "*" } else { " " };
+                    print!("{sum} {prefix}{}{ending}", filename.display());
+                }
+            }
+        }
+
+        Ok(())
+    }
+}
