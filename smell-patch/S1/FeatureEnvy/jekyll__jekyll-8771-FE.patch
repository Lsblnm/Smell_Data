diff --git a/lib/jekyll/readers/data_reader.rb b/lib/jekyll/readers/data_reader.rb
index 80b57bd6b..8dc64be28 100644
--- a/lib/jekyll/readers/data_reader.rb
+++ b/lib/jekyll/readers/data_reader.rb
@@ -72,6 +72,53 @@ module Jekyll
         .gsub(%r!\s+!, "_")
     end
 
+    # Recursively render layouts and place document content inside.
+    #
+    # renderer - The Jekyll::Renderer currently rendering the document.
+    # content  - The converted document content to wrap in layouts.
+    # payload  - The Liquid payload for the current render.
+    # info     - The Liquid render options hash.
+    #
+    # Returns String rendered content
+    def place_in_layouts(renderer, content, payload, info)
+      document = renderer.document
+      output = content.dup
+      layout = renderer.layouts[document.data["layout"].to_s]
+      if renderer.invalid_layout?(layout)
+        Jekyll.logger.warn "Build Warning:", "Layout '#{document.data["layout"]}' requested " \
+                                             "in #{document.relative_path} does not exist."
+      end
+
+      used = Set.new([layout])
+
+      # Reset the payload layout data to ensure it starts fresh for each page.
+      payload["layout"] = nil
+
+      while layout
+        payload["content"] = output
+        payload["layout"] = Utils.deep_merge_hashes(layout.data, payload["layout"] || {})
+        output = renderer.render_liquid(
+          layout.content,
+          payload,
+          info,
+          layout.path
+        )
+
+        if document.write?
+          @site.regenerator.add_dependency(
+            @in_source_dir.call(document.path),
+            layout.path
+          )
+        end
+
+        next unless (layout = @site.layouts[layout.data["layout"]])
+        break if used.include?(layout)
+
+        used << layout
+      end
+      output
+    end
+
     private
 
     # @return [Hash]
