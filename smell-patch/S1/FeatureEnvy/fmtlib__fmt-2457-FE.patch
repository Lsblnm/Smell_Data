@@ -620,6 +620,51 @@ template <typename Char, typename... T> struct tuple_join_view : detail::view {
 
   tuple_join_view(const std::tuple<T...>& t, basic_string_view<Char> s)
       : tuple(t), sep{s} {}
+
+  template <typename FormatContext>
+  auto write_joined(FormatContext& ctx) const ->
+      typename FormatContext::iterator {
+    return write_joined(ctx, std::integral_constant<size_t, sizeof...(T)>{});
+  }
+
+  template <typename FormatContext>
+  auto write_joined(FormatContext& ctx, std::integral_constant<size_t, 0>) const
+      -> typename FormatContext::iterator {
+    return ctx.out();
+  }
+
+  template <typename FormatContext, size_t N>
+  auto write_joined(FormatContext& ctx, std::integral_constant<size_t, N>) const
+      -> typename FormatContext::iterator {
+    using std::get;
+    using base = formatter<typename std::decay<decltype(
+        get<sizeof...(T) - N>(tuple))>::type, Char>;
+    auto out = base().format(get<sizeof...(T) - N>(tuple), ctx);
+    if (N > 1) {
+      basic_format_specs<Char> specs;
+      const Char* sep_data = sep.data();
+      size_t sep_size = sep.size();
+      if (specs.precision >= 0 &&
+          detail::to_unsigned(specs.precision) < sep_size)
+        sep_size = detail::to_unsigned(specs.precision);
+      detail::check_string_type_spec(specs.type);
+      unsigned spec_width = detail::to_unsigned(specs.width);
+      size_t padding = spec_width > sep_size ? spec_width - sep_size : 0;
+      size_t left_padding =
+          padding >> detail::data::left_padding_shifts[specs.align];
+      size_t right_padding = padding - left_padding;
+      const Char* fill_data = specs.fill.data();
+      size_t fill_size = specs.fill.size();
+      for (size_t i = 0; i < left_padding; ++i)
+        out = std::copy(fill_data, fill_data + fill_size, out);
+      out = std::copy(sep_data, sep_data + sep_size, out);
+      for (size_t i = 0; i < right_padding; ++i)
+        out = std::copy(fill_data, fill_data + fill_size, out);
+      ctx.advance_to(out);
+      return write_joined(ctx, std::integral_constant<size_t, N - 1>{});
+    }
+    return out;
+  }
 };
 
