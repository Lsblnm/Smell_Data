+    def self.detect_device(path, platform)
+      screenshot = allocate
+      screenshot.path = path
+      screenshot.size = FastImage.size(path)
+      screenshot.detect_device(platform)
+    end
+
+    def detect_device(platform)
+      screenshot_path = path
+      screenshot_size = size
+
+      UI.user_error!("Could not find or parse file at path '#{screenshot_path}'") if screenshot_size.nil? || screenshot_size.count == 0
+
+      deliver_screenshot = Deliver::AppScreenshot.new(screenshot_path, Pathname.new(screenshot_path).parent.basename.to_s)
+      canonical_path = deliver_screenshot.path
+      deliver_slot = deliver_screenshot.screen_size
+      measured_size = screenshot_size || FastImage.size(canonical_path)
+
+      found_device = nil
+      filename_device = nil
+      filename = Pathname.new(canonical_path).basename.to_s
+      Devices.constants.each do |c|
+        device = Devices.const_get(c)
+        next unless device.resolutions.include?(measured_size)
+
+        device_name = device.formatted_name
+        device_id = device.id
+        matches_filename = filename.include?(device_name.gsub("Apple", "").strip) || filename.include?(device_id)
+        device_slot = device.deliver_screen_id
+        if matches_filename && device_slot && deliver_slot && device_slot != deliver_slot
+          matches_filename = false
+        end
+
+        priority_key = device.priority_config_key
+        priority_item = Frameit::Options.available_options.find { |item| item.key == priority_key } if priority_key
+        configured = priority_item && Frameit.config[priority_item.key]
+        device_priority = configured ? Device::REQUIRED_PRIORITY : device.priority
+        device_platform = device.platform
+        matches_platform = device_platform == platform || platform == Platform::ANY
+
+        filename_device = device if matches_filename && (filename_device.nil? || filename_device.priority < device_priority)
+        next unless matches_platform && (found_device.nil? || device_priority > found_device.priority)
+        found_device = device
+      end
+
+      return filename_device if filename_device
+      return found_device if found_device
+
+      UI.user_error!("Unsupported screen size #{measured_size} for path '#{screenshot_path}'")
+      return nil
     end
 
