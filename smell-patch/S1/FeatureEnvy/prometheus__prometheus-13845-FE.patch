+// VectorscalarBinop evaluates a binary operation between a Vector and a Scalar.
+func (rhs Scalar) VectorscalarBinop(e *parser.BinaryExpr, lhs Vector, enh *EvalNodeHelper) Vector {
+	op := e.Op
+	returnBool := e.ReturnBool
+	swap := e.LHS.Type() == parser.ValueTypeScalar && e.RHS.Type() == parser.ValueTypeVector
+	for _, lhsSample := range lhs {
+		lf, rf := lhsSample.F, rhs.V
+		var rh *histogram.FloatHistogram
+		lh := lhsSample.H
+		// lhs always contains the Vector. If the original position was different
+		// swap for calculating the value.
+		if swap {
+			lf, rf = rf, lf
+			lh, rh = rh, lh
+		}
+		float, histogram, keep := vectorElemBinop(op, lf, rf, lh, rh)
+		// Catch cases where the scalar is the LHS in a scalar-vector comparison operation.
+		// We want to always keep the vector element value as the output value, even if it's on the RHS.
+		if op.IsComparisonOperator() && swap {
+			float = rf
+			histogram = rh
+		}
+		if returnBool {
+			if keep {
+				float = 1.0
+			} else {
+				float = 0.0
+			}
+			keep = true
+		}
+		if keep {
+			lhsSample.F = float
+			lhsSample.H = histogram
+			if shouldDropMetricName(op) || returnBool {
+				lhsSample.Metric = lhsSample.Metric.DropMetricName()
+			}
+			lhsSample.T = rhs.T
+			enh.Out = append(enh.Out, lhsSample)
+		}
+	}
+	return enh.Out
+}
