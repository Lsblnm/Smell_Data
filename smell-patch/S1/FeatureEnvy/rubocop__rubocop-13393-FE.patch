         end
 
+        def if_then_replacement(if_then_corrector, node = nil, leading_indent = nil)
+          node = if_then_corrector.if_node if node.nil?
+          indent_width = if_then_corrector.indentation
+          ruby_version = @config.target_ruby_version
+
+          source_range = node.source_range
+          leading_indent = ' ' * source_range.column if leading_indent.nil?
+
+          if_branch = node.if_branch
+          else_branch = node.else_branch
+          condition = node.condition
+          keyword = node.keyword
+
+          body_indent = ' ' * indent_width
+          body_indent = body_indent.freeze if ruby_version && !@options[:debug]
+
+          if_branch_source = if_branch&.source || 'nil'
+          elsif_indentation = leading_indent if node.respond_to?(:elsif?) && node.elsif?
+
+          rewritten_if = <<~RUBY
+            #{elsif_indentation}#{keyword} #{condition.source}
+            #{leading_indent}#{body_indent}#{if_branch_source}
+          RUBY
+
+          if else_branch.nil?
+            rewritten_if + 'end'
+          elsif else_branch.if_type? && else_branch.elsif?
+            rewritten_if + if_then_replacement(if_then_corrector, else_branch, leading_indent)
+          else
+            rewritten_if + <<~RUBY.chomp
+              #{leading_indent}else
+              #{leading_indent}#{body_indent}#{else_branch.source}
+              #{leading_indent}end
+            RUBY
+          end
+        end
+
         private
 
         def check_ending_body(body)
