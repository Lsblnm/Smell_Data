+// registerSynthConfigSource allows fmt to add synthetic additional source
+// buffers to the config loader's cache of sources, which is useful when a
+// file being formatted produces diagnostics so that snippets can still be
+// produced.
+//
+// If this is called before a configLoader has been initialized then it will
+// try to initialize the loader but ignore any initialization failure, turning
+// the call into a no-op.
+func (c *FmtCommand) registerSynthConfigSource(filename string, src []byte) {
+	meta := &c.Meta
+
+	if meta.WorkingDir == nil {
+		log.Printf("[WARN] This 'Meta' object is missing its WorkingDir, so we're creating a default one suitable only for tests")
+		meta.WorkingDir = workdir.NewDir(".")
+	}
+
+	rootDir := meta.WorkingDir.RootModuleDir()
+	dataDir := meta.WorkingDir.DataDir()
+	modulesDir := filepath.Join(dataDir, "modules")
+	log.Printf("[TRACE] terraform fmt: registering diagnostic source %s in workdir %s (data dir %s)", filename, rootDir, dataDir)
+
+	if meta.configLoader == nil {
+		loader, err := configload.NewLoader(&configload.Config{
+			ModulesDir: modulesDir,
+			Services:   meta.Services,
+		})
+		if err != nil || loader == nil {
+			return
+		}
+		loader.AllowLanguageExperiments(meta.AllowExperimentalFeatures)
+		meta.configLoader = loader
+		if meta.View != nil {
+			meta.View.SetConfigSources(loader.Sources)
+		}
+	}
+	if meta.configLoader == nil {
+		return
+	}
+	parser := meta.configLoader.Parser()
+	parser.ForceFileSource(filename, src)
+}
+
