+            $argumentInfo = $argumentAnalyzer->getArgumentInfo($tokens, $argumentStart, $argumentEnd);
+            $argumentName = $argumentInfo->getName();
+            $argumentType = $argumentInfo->getTypeAnalysis();
+
+            if (null !== $argumentName && null !== $argumentType) {
+                $argumentTypeNames[$argumentName] = $argumentType->getName();
+            }
+        }
+
+        $type = '';
+        $typeStartIndex = $tokens->getNextMeaningfulToken($typeColonIndex);
+        $typeEndIndex = $typeStartIndex;
+        $functionBodyStart = $tokens->getNextTokenOfKind($typeColonIndex, ['{', ';', [T_DOUBLE_ARROW]]);
+
+        for ($i = $typeStartIndex; $i < $functionBodyStart; ++$i) {
+            $token = $tokens[$i];
+
+            if ($token->isWhitespace() || $token->isComment()) {
+                continue;
+            }
+
+            $type .= $token->getContent();
+            $typeEndIndex = $i;
+        }
+
+        $returnType = new TypeAnalysis($type, $typeStartIndex, $typeEndIndex);
+        $returnTypeName = $returnType->getName();
+        $returnTypeStartIndex = $returnType->getStartIndex();
+        $isDiscoveryPass = null !== $this->discoveredSymbols;
+        $isReservedReturnType = $returnType->isReservedType();
+
+        if (!$isReservedReturnType) {
+            foreach ($this->reservedIdentifiersByLevel as $reservedIdentifiers) {
+                if (isset($reservedIdentifiers[$returnTypeName])) {
+                    $isReservedReturnType = true;
+
+                    break;
+                }
+            }
+        }
+
+        if (\in_array($returnTypeName, $argumentTypeNames, true)) {
+            return new TypeAnalysis($type, $returnTypeStartIndex, $typeEndIndex);
+        }
+
+        if (!$isDiscoveryPass && !$isReservedReturnType) {
+            $functionNamespace = (new NamespacesAnalyzer())->getNamespaceAt($tokens, $methodIndex);
+
+            if ($typeStartIndex >= $functionNamespace->getScopeStartIndex()) {
+                $namespaceName = $functionNamespace->getFullName();
+                if ('' === $namespaceName || !str_starts_with($returnTypeName, $namespaceName.'\\')) {
+                    return new TypeAnalysis($type, $returnTypeStartIndex, $typeEndIndex);
+                }
+
+                return new TypeAnalysis($type, $returnTypeStartIndex, $typeEndIndex);
+            }
+        }
+
+        return new TypeAnalysis($type, $returnTypeStartIndex, $typeEndIndex);
+    }
