diff --git a/lib/rubocop/cop/mixin/frozen_string_literal.rb b/lib/rubocop/cop/mixin/frozen_string_literal.rb
index 315880708..2e542b3f5 100644
--- a/lib/rubocop/cop/mixin/frozen_string_literal.rb
+++ b/lib/rubocop/cop/mixin/frozen_string_literal.rb
@@ -39,6 +39,46 @@ module RuboCop
       end
       alias frozen_heredoc? uninterpolated_heredoc?
 
+      def immutable_literal?(node)
+        if node.begin_type? && node.children.first
+          node = node.children.first
+        end
+
+        return true if node.immutable_literal?
+
+        if FROZEN_STRING_LITERAL_TYPES_RUBY27.include?(node.type)
+          return true if frozen_string_literal?(node)
+        elsif frozen_string_literal?(node)
+          return true
+        end
+
+        configured_version = target_ruby_version
+        source_version = processed_source.ruby_version
+        return false unless configured_version && configured_version >= 3.0
+
+        loc = node.loc
+        expression = loc.expression if loc
+        source = node.source
+        tokens = processed_source.tokens
+        inspect_tokens = tokens && (source_version || configured_version)
+
+        if node.regexp_type?
+          if expression && source && inspect_tokens
+            regexp_tokens = processed_source.tokens_within(node)
+            return true if regexp_tokens.any? { |token| token.type == :tREGEXP_BEG }
+          end
+          true
+        elsif node.range_type?
+          if expression && source && inspect_tokens
+            range_tokens = processed_source.tokens_within(node)
+            return true if range_tokens.any? { |token| token.type == :tDOT2 || token.type == :tDOT3 }
+          end
+          true
+        else
+          false
+        end
+      end
+
       def frozen_string_literals_enabled?
         ruby_version = processed_source.ruby_version
         return false unless ruby_version
