+struct jq_cli {
+  const char *name;
+  int nfiles;
+};
+
+static jv jq_cli_add_positional(struct jq_cli *cli, jq_state *jq,
+                                jq_util_input_state *input_state, jv ARGS,
+                                int as_string, int as_json, const char *arg) {
+  jq_input_cb in_cb = NULL;
+  void *in_data = NULL;
+  int positional_len = ARGS.size;
+  jv_kind positional_kind = jv_get_kind(ARGS);
+
+  if (cli->name == NULL)
+    return ARGS;
+
+  if (as_string) {
+    if (positional_kind == JV_KIND_ARRAY)
+      return jv_array_set(ARGS, positional_len, jv_string(arg));
+    return ARGS;
+  }
+
+  if (as_json) {
+    jv v = jv_parse(arg);
+    if (positional_kind == JV_KIND_ARRAY)
+      return jv_array_set(ARGS, positional_len, v);
+    jv_free(v);
+    return ARGS;
+  }
+
+  jq_get_input_cb(jq, &in_cb, &in_data);
+  if (in_cb != NULL && in_data != input_state)
+    return ARGS;
+
+  int slot = input_state->nfiles;
+  int parser_pending = 0;
+  if (input_state->parser != NULL)
+    parser_pending = jv_parser_remaining(input_state->parser);
+  if (parser_pending < 0 && input_state->current_input == NULL)
+    return ARGS;
+
+  input_state->files = jv_mem_realloc(input_state->files, (slot + 1) * sizeof(input_state->files[0]));
+  input_state->files[slot] = jv_mem_strdup(arg);
+  input_state->nfiles = slot + 1;
+  if (input_state->curr_file > input_state->nfiles)
+    input_state->curr_file = input_state->nfiles;
+  cli->nfiles++;
+  return ARGS;
+}
