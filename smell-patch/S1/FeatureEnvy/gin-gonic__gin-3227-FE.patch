+func (value nodeValue) redirectTrailingSlash(c *Context) bool {
+	if !value.tsr {
+		return false
+	}
+
+	engine := c.engine
+	if !engine.RedirectTrailingSlash {
+		return false
+	}
+
+	req := c.Request
+	p := req.URL.Path
+	if prefix := path.Clean(req.Header.Get("X-Forwarded-Prefix")); prefix != "." {
+		p = prefix + "/" + req.URL.Path
+	}
+	req.URL.Path = p + "/"
+	if length := len(p); length > 1 && p[length-1] == '/' {
+		req.URL.Path = p[:length-1]
+	}
+
+	rPath := req.URL.Path
+	rURL := req.URL.String()
+	code := http.StatusMovedPermanently
+	if req.Method != http.MethodGet {
+		code = http.StatusTemporaryRedirect
+	}
+
+	redir := render.Redirect{
+		Code:     code,
+		Request:  req,
+		Location: rURL,
+	}
+	debugPrint("redirecting request %d: %s --> %s", redir.Code, rPath, redir.Location)
+	http.Redirect(c.Writer, redir.Request, redir.Location, redir.Code)
+	c.writermem.WriteHeaderNow()
+	return true
+}
