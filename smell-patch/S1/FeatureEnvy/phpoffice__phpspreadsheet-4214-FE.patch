 namespace PhpOffice\PhpSpreadsheet\Calculation\MathTrig;
 
 use PhpOffice\PhpSpreadsheet\Calculation\ArrayEnabled;
+use PhpOffice\PhpSpreadsheet\Calculation\Engine\ArrayArgumentHelper;
 use PhpOffice\PhpSpreadsheet\Calculation\Exception;
 
 class Trunc
 {
     use ArrayEnabled;
 
+    private mixed $operand = 0;
+
+    private mixed $places = 0;
+
+    /**
+     * ROUNDDOWN implementation used by Round::down().
+     *
+     * @param mixed $number Number to round, or can be an array of numbers
+     * @param mixed $digits Number of digits to which you want to round $number, or can be an array of numbers
+     *
+     * @return array|float|string Rounded Number, or a string containing an error
+     */
+    public function applyDown($number, $digits): array|string|float
+    {
+        $this->operand = $number;
+        $this->places = $digits;
+
+        $argumentHelper = new ArrayArgumentHelper();
+        $argumentHelper->initialise([$this->operand, $this->places]);
+        $arguments = $argumentHelper->arguments();
+        $indexStart = $argumentHelper->getIndexStart();
+        $needsArrayProcessing = false;
+        foreach (array_keys($arguments) as $index) {
+            if ($argumentHelper->rowCount($index) > 1 || $argumentHelper->columnCount($index) > 1) {
+                $needsArrayProcessing = true;
+                break;
+            }
+        }
+        if ($needsArrayProcessing || is_array($this->operand) || is_array($this->places)) {
+            return self::evaluateArrayArguments([$this, 'applyDown'], $this->operand, $this->places);
+        }
+
+        $numericHelper = new Helpers();
+        $number = $numericHelper->flattenValue($arguments[$indexStart] ?? $this->operand);
+        $digits = $numericHelper->flattenValue($arguments[$indexStart + 1] ?? $this->places);
+
+        try {
+            if ($number === null) {
+                $number = $numericHelper->getNullNumericValue();
+            } elseif ($number === true) {
+                $number = $numericHelper->getTrueNumericValue();
+            } elseif ($number === false) {
+                $number = $numericHelper->getFalseNumericValue();
+            } elseif (is_numeric($number)) {
+                $number = $numericHelper->getNumericIdentity() + $number;
+            } else {
+                throw new Exception($numericHelper->errorMessageFor($number));
+            }
+
+            if ($digits === null || !is_numeric($digits)) {
+                throw new Exception($numericHelper->errorMessageFor($digits));
+            }
+            $digits = (int) ($numericHelper->getNumericIdentity() + $digits);
+        } catch (Exception $e) {
+            return $e->getMessage();
+        }
+
+        if ($number == 0.0) {
+            return 0.0;
+        }
+
+        $digitsPlus1 = $digits + 1;
+        if ($number < 0.0) {
+            if ($digitsPlus1 < 0) {
+                return round($number + 0.5 * 0.1 ** $digits, $digits, PHP_ROUND_HALF_UP);
+            }
+            $result = sprintf("%.{$digitsPlus1}F", $number + 0.5 * 0.1 ** $digits);
+
+            return round((float) $result, $digits, PHP_ROUND_HALF_UP);
+        }
+
+        if ($digitsPlus1 < 0) {
+            return round($number - 0.5 * 0.1 ** $digits, $digits, PHP_ROUND_HALF_UP);
+        }
+
+        $result = sprintf("%.{$digitsPlus1}F", $number - 0.5 * 0.1 ** $digits);
+
+        return round((float) $result, $digits, PHP_ROUND_HALF_UP);
+    }
