+		boolean qualifiedThis = selected != null && thisConstructorCall.equals(name);
+		boolean hasArguments = args != null && !args.isEmpty();
+		boolean hasTypeArguments = typeArgs != null && !typeArgs.isEmpty();
+		boolean isVarargsCall = varargsElement != null;
+		return qualifiedSuper || qualifiedThis || hasArguments || hasTypeArguments || isVarargsCall
+			|| thisConstructorCall.equals(name) || superConstructorCall.equals(name);
+	}
 }
