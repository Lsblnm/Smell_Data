diff --git a/fastlane_core/lib/fastlane_core/command_executor.rb b/fastlane_core/lib/fastlane_core/command_executor.rb
index e95db7b8e..8a747db1f 100644
--- a/fastlane_core/lib/fastlane_core/command_executor.rb
+++ b/fastlane_core/lib/fastlane_core/command_executor.rb
@@ -5,6 +5,48 @@ require_relative 'fastlane_pty'
 module FastlaneCore
   # Executes commands and takes care of error handling and more
   class CommandExecutor
+    attr_reader :program, :recursive_flag
+
+    def initialize(program: "zip", recursive_flag: "r")
+      @program = program
+      @recursive_flag = recursive_flag
+    end
+
+    def zip_command(zip_runner, params)
+      zip_options = zip_runner.verbose ? recursive_flag : "#{recursive_flag}q"
+      zip_options += "y" if zip_runner.symlinks
+
+      command = [program, "-#{zip_options}"]
+
+      if zip_runner.password
+        command << "-P"
+        command << zip_runner.password
+      end
+
+      # The zip command is executed from the paths **parent** directory, as a result we use just the basename, which is the file or folder within
+      basename = File.basename(zip_runner.path)
+
+      command << zip_runner.output_path
+      command << basename
+
+      include_option = params.available_options.find { |item| item.key == :include }
+      exclude_option = params.available_options.find { |item| item.key == :exclude }
+      selected_include = zip_runner.include.empty? ? Array(include_option.default_value) : zip_runner.include
+      selected_exclude = zip_runner.exclude.empty? ? Array(exclude_option.default_value) : zip_runner.exclude
+
+      unless selected_include.empty?
+        command << "-i"
+        command += selected_include.map { |path| File.join(basename, path) }
+      end
+
+      unless selected_exclude.empty?
+        command << "-x"
+        command += selected_exclude.map { |path| File.join(basename, path) }
+      end
+
+      command
+    end
+
     class << self
       # Cross-platform way of finding an executable in the $PATH. Respects the $PATHEXT, which lists
       # valid file extensions for executables on Windows.
