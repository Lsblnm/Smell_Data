+    /**
+     * Apply the inverse relation from the given relationship to all models in the collection.
+     *
+     * @param  \Illuminate\Database\Eloquent\Relations\Relation  $relation
+     * @param  \Illuminate\Database\Eloquent\Model|null  $parent
+     * @return $this
+     */
+    public function applyInverseRelationToCollection(Relation $relation, ?Model $parent = null)
+    {
+        $parent ??= $relation->getParent();
+        $inverse = $relation->getInverseRelationship();
+        $builderModel = $relation->getQuery()->getModel();
+
+        $parentIdentity = implode("\0", [
+            (string) $parent->getConnectionName(),
+            $parent->getTable(),
+            $parent->getKeyName(),
+            $parent->exists ? '1' : '0',
+            $builderModel->getTable(),
+            (string) $inverse,
+        ]);
+
+        $parentsByIdentity = [$parentIdentity => $parent];
+        $boundParent = $parentsByIdentity[$parentIdentity] ?? $parent;
+
+        foreach ($this->items as $model) {
+            if ($inverse) {
+                $model->setRelation($inverse, $boundParent);
+            }
+        }
+
+        return $this;
+    }
+
