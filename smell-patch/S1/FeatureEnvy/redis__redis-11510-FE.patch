+void fcallCommandGeneric(client *c, int ro) {
+    functionInfo *fi = lookupFunction(c);
+    if (!fi) {
+        addReplyError(c, "Function not found");
+        return;
+    }
+
+    long long numkeys;
+    /* Get the number of arguments that are keys */
+    if (getLongLongFromObject(c->argv[2], &numkeys) != C_OK) {
+        addReplyError(c, "Bad number of keys provided");
+        return;
+    }
+    if (numkeys > (c->argc - 3)) {
+        addReplyError(c, "Number of keys can't be greater than number of args");
+        return;
+    } else if (numkeys < 0) {
+        addReplyError(c, "Number of keys can't be negative");
+        return;
+    }
+
+    functionLibInfo *li = fi->li;
+    engineInfo *ei = li->ei;
+    engine *engine = ei->engine;
+
+    scriptRunCtx run_ctx;
+    if (scriptPrepareForRun(&run_ctx, ei->c, c, fi->name, fi->f_flags, ro) != C_OK)
+        return;
+
+    serverAssert(run_ctx.c == ei->c && run_ctx.original_client == c);
+    engine->call(&run_ctx, engine->engine_ctx, fi->function,
+                 run_ctx.original_client->argv + 3, numkeys,
+                 run_ctx.original_client->argv + 3 + numkeys,
+                 run_ctx.original_client->argc - 3 - numkeys);
+    scriptResetRun(&run_ctx);
+}
