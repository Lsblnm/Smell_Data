--- a/lucene/core/src/java/org/apache/lucene/geo/XYPoint.java
+++ b/lucene/core/src/java/org/apache/lucene/geo/XYPoint.java
@@ -60,6 +60,44 @@ public final class XYPoint extends XYGeometry {
     return Point2D.create(this);
   }
 
+  /**
+   * Compute the cartesian bounding box of a circle centered on this point. Radius {@code 0} is
+   * allowed and produces a box expanded by a single ulp to avoid numerical errors.
+   */
+  XYRectangle boundingBox(float radius) {
+    if (radius < 0) {
+      throw new IllegalArgumentException("radius must be bigger than 0, got " + radius);
+    }
+    if (Float.isFinite(radius) == false) {
+      throw new IllegalArgumentException("radius must be finite, got " + radius);
+    }
+    final float centerX = this.x;
+    final float centerY = this.y;
+    Component2D origin = Point2D.create(this);
+    final float minX;
+    final float maxX;
+    final float minY;
+    final float maxY;
+    if (radius > 0) {
+      XYCircle circle = new XYCircle(centerX, centerY, radius);
+      float distanceBox = Math.nextUp(circle.getRadius());
+      minX = Math.max(-Float.MAX_VALUE, circle.getX() - distanceBox);
+      maxX = Math.min(Float.MAX_VALUE, (float) origin.getMaxX() + distanceBox);
+      minY = Math.max(-Float.MAX_VALUE, circle.getY() - distanceBox);
+      maxY = Math.min(Float.MAX_VALUE, (float) origin.getMaxY() + distanceBox);
+    } else {
+      float distanceBox = Math.nextUp(radius);
+      minX = Math.max(-Float.MAX_VALUE, (float) origin.getMinX() - distanceBox);
+      maxX = Math.min(Float.MAX_VALUE, (float) origin.getMaxX() + distanceBox);
+      minY = Math.max(-Float.MAX_VALUE, (float) origin.getMinY() - distanceBox);
+      maxY = Math.min(Float.MAX_VALUE, (float) origin.getMaxY() + distanceBox);
+    }
+    XYRectangle rectangle = new XYRectangle(minX, maxX, minY, maxY);
+    Component2D box = rectangle.toComponent2D();
+    return new XYRectangle(
+        (float) box.getMinX(), (float) box.getMaxX(), (float) box.getMinY(), (float) box.getMaxY());
+  }
+
   @Override
   public boolean equals(Object o) {
     if (this == o) return true;
