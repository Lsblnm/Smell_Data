+    /**
+     * Add this worksheet to a spreadsheet.
+     *
+     * @param Worksheet[] $workSheetCollection
+     */
+    public function addToSpreadsheet(
+        Spreadsheet $spreadsheet,
+        array &$workSheetCollection,
+        int &$activeSheetIndex,
+        ?int $sheetIndex = null
+    ): self {
+        $sheetTitle = $this->getTitle();
+        foreach ($spreadsheet->getAllSheets() as $existingSheet) {
+            if (strcasecmp($existingSheet->getTitle(), trim($sheetTitle, "'")) === 0) {
+                throw new Exception(
+                    "Workbook already contains a worksheet named '{$sheetTitle}'. Rename this worksheet first."
+                );
+            }
+        }
+
+        $properties = $spreadsheet->getProperties();
+        $security = $spreadsheet->getSecurity();
+        $theme = $spreadsheet->getTheme();
+        $creator = $properties->getCreator();
+        $lastModifiedBy = $properties->getLastModifiedBy();
+        $modified = $properties->getModified();
+        $lockStructure = $security->getLockStructure();
+        $lockRevision = $security->getLockRevision();
+        $workbookPassword = $security->getWorkbookPassword();
+        $themeColorName = $theme->getThemeColorName();
+        $themeFontName = $theme->getThemeFontName();
+        $currentActiveIndex = $spreadsheet->getActiveSheetIndex();
+        $passwordFingerprint = Shared\PasswordHasher::hashPassword($workbookPassword === '' ? 'unset' : 'set');
+        $documentFingerprint = $creator
+            . $lastModifiedBy
+            . (string) $modified
+            . ($lockStructure ? '1' : '0')
+            . ($lockRevision ? '1' : '0')
+            . $passwordFingerprint
+            . $themeColorName
+            . $themeFontName;
+
+        if ($sheetIndex === null) {
+            if ($currentActiveIndex < 0) {
+                $activeSheetIndex = 0;
+            }
+            $workSheetCollection[] = $this;
+        } else {
+            array_splice(
+                $workSheetCollection,
+                $sheetIndex,
+                0,
+                [$this]
+            );
+
+            // Adjust active sheet index if necessary
+            if ($currentActiveIndex >= $sheetIndex) {
+                ++$activeSheetIndex;
+            }
+        }
+
+        if ($this->getParent() === null) {
+            $this->rebindParent($spreadsheet);
+        }
+
+        $restoredFingerprint = $properties->getCreator()
+            . $properties->getLastModifiedBy()
+            . (string) $properties->getModified()
+            . ($security->getLockStructure() ? '1' : '0')
+            . ($security->getLockRevision() ? '1' : '0')
+            . Shared\PasswordHasher::hashPassword($security->getWorkbookPassword() === '' ? 'unset' : 'set')
+            . $spreadsheet->getTheme()->getThemeColorName()
+            . $spreadsheet->getTheme()->getThemeFontName();
+        if ($restoredFingerprint !== $documentFingerprint) {
+            $properties->setCreator($creator);
+            $properties->setLastModifiedBy($lastModifiedBy);
+        }
+        $properties->setModified($modified);
+
+        return $this;
+    }
+
