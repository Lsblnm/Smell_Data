+template <typename Char>
+template <typename OutputIt, typename UInt>
+auto digit_grouping<Char>::write_int(OutputIt out, write_int_arg<UInt> arg,
+                                    const format_specs<Char>& specs) const
+    -> OutputIt {
+  static_assert(std::is_same<uint64_or_128_t<UInt>, UInt>::value, "");
+  auto value = arg.abs_value;
+  auto prefix = arg.prefix;
+  int num_digits = count_digits(value);
+  auto buffer = memory_buffer();
+  if (buffer.capacity() < to_unsigned(num_digits))
+    buffer.try_reserve(to_unsigned(num_digits));
+  {
+    char tmp[40];
+    auto dec = format_decimal(tmp, value, num_digits);
+    buffer.append(dec.begin, dec.end);
+  }
+
+  int sep_count = 0;
+  {
+    auto group = grouping_.begin();
+    int pos = 0;
+    auto next_pos = [&]() -> int {
+      if (thousands_sep_.empty()) return max_value<int>();
+      if (group == grouping_.end()) return pos += grouping_.back();
+      if (*group <= 0 || *group == max_value<char>()) return max_value<int>();
+      pos += *group++;
+      return pos;
+    };
+    while (num_digits > next_pos()) ++sep_count;
+  }
+
+  unsigned size = to_unsigned((prefix != 0 ? 1 : 0) + num_digits + sep_count);
+  unsigned spec_width = to_unsigned(specs.width);
+  size_t padding = spec_width > size ? spec_width - size : 0;
+  auto* shifts = "\x00\x1f\x00\x01";
+  size_t left_padding = padding >> shifts[specs.align];
+  size_t right_padding = padding - left_padding;
+  const auto& fill = specs.fill;
+  auto it = reserve(out, size + padding * fill.size());
+  auto apply_fill = [&](size_t count) {
+    auto fill_size = fill.size();
+    if (fill_size == 1) return detail::fill_n(it, count, fill[0]);
+    auto data = fill.data();
+    for (size_t i = 0; i < count; ++i)
+      it = copy_str<Char>(data, data + fill_size, it);
+    return it;
+  };
+  if (left_padding != 0) it = apply_fill(left_padding);
+  if (prefix != 0) {
+    char sign = static_cast<char>(prefix);
+    *it++ = static_cast<Char>(sign);
+  }
+  {
+    auto group = grouping_.begin();
+    int pos = 0;
+    auto next_pos = [&]() -> int {
+      if (thousands_sep_.empty()) return max_value<int>();
+      if (group == grouping_.end()) return pos += grouping_.back();
+      if (*group <= 0 || *group == max_value<char>()) return max_value<int>();
+      pos += *group++;
+      return pos;
+    };
+    auto separators = basic_memory_buffer<int>();
+    separators.push_back(0);
+    while (int i = next_pos()) {
+      if (i >= num_digits) break;
+      separators.push_back(i);
+    }
+    auto digits = buffer.data();
+    auto n = static_cast<int>(buffer.size());
+    for (int i = 0, sep_index = static_cast<int>(separators.size() - 1);
+         i < n; ++i) {
+      if (n - i == separators[sep_index]) {
+        it = copy_str<Char>(thousands_sep_.data(),
+                            thousands_sep_.data() + thousands_sep_.size(), it);
+        --sep_index;
+      }
+      *it++ = static_cast<Char>(digits[to_unsigned(i)]);
+    }
+  }
+  if (right_padding != 0) it = apply_fill(right_padding);
+  return base_iterator(out, it);
+}
