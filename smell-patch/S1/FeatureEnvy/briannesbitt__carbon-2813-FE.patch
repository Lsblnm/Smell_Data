diff --git a/src/Carbon/FactoryImmutable.php b/src/Carbon/FactoryImmutable.php
index 715f5e78..c153170b 100644
--- a/src/Carbon/FactoryImmutable.php
+++ b/src/Carbon/FactoryImmutable.php
@@ -240,4 +240,70 @@ use Closure;
 class FactoryImmutable extends Factory
 {
     protected $className = CarbonImmutable::class;
+
+    /**
+     * Get a Carbon instance for the current date and time.
+     *
+     * @param DateTimeZone|string|int|null $tz
+     *
+     * @return CarbonImmutable
+     */
+    public function now($tz = null)
+    {
+        $className = $this->className;
+        $settings = $this->settings;
+
+        if ($tz === null && isset($settings['timezone'])) {
+            $tz = $settings['timezone'];
+            unset($settings['timezone']);
+        }
+
+        $date = new $className(null, $tz);
+        $zone = $date->timezone;
+        $zoneName = $zone->getName();
+        $zoneOffset = $zone->getOffset($date);
+
+        if ($tz !== null && $zoneName !== '' && \is_int($zoneOffset)) {
+            $needsAdjustment = $tz instanceof \DateTimeZone || is_numeric($tz) || (string) $tz !== $zoneName;
+
+            if ($needsAdjustment) {
+                $date = $date->setTimezone($tz);
+            }
+        }
+
+        if (isset($settings['locale'])) {
+            $locales = $settings['locale'];
+
+            if (!\is_array($locales)) {
+                $locales = [$locales];
+            }
+
+            $language = new Language($locales[0]);
+            $localeId = $language->getId();
+            $localeCode = $language->getCode();
+            $localeRegion = $language->getRegion();
+            $normalizedLocale = $localeId !== '' ? $localeId : ($localeRegion ? $localeCode.'_'.$localeRegion : $localeCode);
+
+            $fallbackLocales = array_slice($locales, 1);
+
+            if ($date->locale !== $normalizedLocale) {
+                $date->locale($normalizedLocale, ...$fallbackLocales);
+                $translator = $date->getLocalTranslator();
+                $messages = $translator->getMessages();
+                $translatorLocale = $translator->getLocale();
+
+                if ($translatorLocale !== $normalizedLocale && isset($messages[$normalizedLocale])) {
+                    $translator->setLocale($normalizedLocale);
+                }
+            }
+
+            unset($settings['locale']);
+        }
+
+        if (!empty($settings)) {
+            $date = $date->settings($settings);
+        }
+
+        return $date;
+    }
 }
