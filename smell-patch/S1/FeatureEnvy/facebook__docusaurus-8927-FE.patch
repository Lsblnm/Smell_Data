+
+/** Location of a Markdown file inside a Docusaurus site, plus its content roots. */
+export class MarkdownSourceLocation<T extends ContentPaths = ContentPaths> {
+  private readonly siteDir: string;
+  private readonly filePath: string;
+  private readonly contentRoots: ContentDirectoryRoots<T>;
+
+  constructor(
+    siteDir: string,
+    filePath: string,
+    contentRoots: ContentDirectoryRoots<T>,
+  ) {
+    this.siteDir = siteDir;
+    this.filePath = filePath;
+    this.contentRoots = contentRoots;
+  }
+
+  static create<T extends ContentPaths>(
+    siteDir: string,
+    filePath: string,
+    contentPaths: T,
+    sourceToPermalink: {[aliasedPath: string]: string},
+  ): MarkdownSourceLocation<T> {
+    return new MarkdownSourceLocation(
+      siteDir,
+      filePath,
+      ContentDirectoryRoots.fromContentPaths(contentPaths, sourceToPermalink),
+    );
+  }
+
+  getSiteDir(): string {
+    return this.siteDir;
+  }
+
+  getFilePath(): string {
+    return this.filePath;
+  }
+
+  getContentRoots(): ContentDirectoryRoots<T> {
+    return this.contentRoots;
+  }
+}
