+/** Ordered content directories that a Markdown file reference may resolve in. */
+export class ContentDirectoryRoots<T extends ContentPaths = ContentPaths> {
+  private readonly contentPaths: T;
+  private readonly contentPath: string;
+  private readonly contentPathLocalized: string;
+  private readonly permalinkIndex: PermalinkIndex;
+
+  constructor(contentPaths: T, permalinkIndex: PermalinkIndex) {
+    this.contentPaths = contentPaths;
+    this.contentPath = contentPaths.contentPath;
+    this.contentPathLocalized = contentPaths.contentPathLocalized;
+    this.permalinkIndex = permalinkIndex;
+  }
+
+  static fromContentPaths<T extends ContentPaths>(
+    contentPaths: T,
+    sourceToPermalink: {[aliasedPath: string]: string},
+  ): ContentDirectoryRoots<T> {
+    return new ContentDirectoryRoots(
+      contentPaths,
+      PermalinkIndex.fromSourceToPermalink(sourceToPermalink),
+    );
+  }
+
+  getContentPaths(): T {
+    return this.contentPaths;
+  }
+
+  getContentPath(): string {
+    return this.contentPath;
+  }
+
+  getContentPathLocalized(): string {
+    return this.contentPathLocalized;
+  }
+
+  getPermalinkIndex(): PermalinkIndex {
+    return this.permalinkIndex;
+  }
+}
