+/** Lookup table from aliased source paths to their corresponding permalinks. */
+export class PermalinkIndex {
+  private readonly sourceToPermalink: {[aliasedPath: string]: string};
+  private readonly aliasPrefix: SiteAliasPrefix;
+
+  constructor(
+    sourceToPermalink: {[aliasedPath: string]: string},
+    aliasPrefix: SiteAliasPrefix,
+  ) {
+    this.sourceToPermalink = sourceToPermalink;
+    this.aliasPrefix = aliasPrefix;
+  }
+
+  static fromSourceToPermalink(sourceToPermalink: {
+    [aliasedPath: string]: string;
+  }): PermalinkIndex {
+    return new PermalinkIndex(sourceToPermalink, new SiteAliasPrefix());
+  }
+
+  getSourceToPermalink(): {[aliasedPath: string]: string} {
+    return this.sourceToPermalink;
+  }
+
+  getAliasPrefix(): SiteAliasPrefix {
+    return this.aliasPrefix;
+  }
+}
