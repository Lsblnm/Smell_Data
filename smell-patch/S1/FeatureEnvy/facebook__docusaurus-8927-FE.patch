+import type {ContentPaths} from './markdownLinks';
+import {ContentDirectoryRoots} from './dataFileUtils';
 
 // Based on https://github.com/gatsbyjs/gatsby/pull/21518/files
 // macOS (APFS) and Windows (NTFS) filename length limit = 255 chars,
@@ -116,3 +118,45 @@ export function addTrailingPathSeparator(str: string): string {
