diff --git a/lib/rubocop/cop/correctors/condition_corrector.rb b/lib/rubocop/cop/correctors/condition_corrector.rb
index 10f9494be..659aad879 100644
--- a/lib/rubocop/cop/correctors/condition_corrector.rb
+++ b/lib/rubocop/cop/correctors/condition_corrector.rb
@@ -4,6 +4,8 @@ module RuboCop
   module Cop
     # This class does condition autocorrection
     class ConditionCorrector
+      include RangeHelp
+
       class << self
         def correct_negative_condition(corrector, node)
           condition = negated_condition(node)
@@ -20,6 +22,35 @@ module RuboCop
           condition
         end
       end
+
+      attr_reader :processed_source
+
+      def initialize(condition, processed_source)
+        @condition = condition
+        @source_range = condition.source_range
+        @processed_source = processed_source
+      end
+
+      def replace_condition
+        condition = @condition
+        source_range = @source_range
+
+        return condition.source unless condition.operator_keyword? ||
+                                       (condition.call_type? && condition.first_argument &&
+                                        !condition.parenthesized?)
+
+        if condition.call_type?
+          selector = condition.loc.selector
+          first_argument = condition.first_argument
+          method_call = range_between(source_range.begin_pos, selector.end_pos).source
+          arguments = range_between(first_argument.source_range.begin_pos,
+                                    source_range.end_pos).source
+
+          "#{method_call}(#{arguments})"
+        else
+          "(#{condition.source})"
+        end
+      end
     end
   end
 end
