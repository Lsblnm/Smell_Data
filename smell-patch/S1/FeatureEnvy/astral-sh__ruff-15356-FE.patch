+    /// E251, E252
+    fn whitespace_around_named_parameter_equals(
+        &mut self,
+        line: &LogicalLine,
+        context: &mut LogicalLinesContext,
+    ) {
+        if !line.line.flags.contains(TokenFlags::OPERATOR) {
+            return;
+        }
+
+        let mut parens = 0u32;
+        let mut fstrings = 0u32;
+        let mut annotated_func_arg = false;
+        let mut prev_end = TextSize::default();
+
+        let tokens =
+            &line.lines.tokens[line.line.tokens_start as usize..line.line.tokens_end as usize];
+        let locator = line.lines.locator;
+        let mut iter = tokens.iter().peekable();
+
+        while let Some(token) = iter.next() {
+            let kind = token.kind;
+            self.visit_token_kind(kind);
+            match kind {
+                TokenKind::NonLogicalNewline => continue,
+                TokenKind::FStringStart => fstrings += 1,
+                TokenKind::FStringEnd => fstrings = fstrings.saturating_sub(1),
+                TokenKind::Lpar | TokenKind::Lsqb => {
+                    parens = parens.saturating_add(1);
+                }
+                TokenKind::Rpar | TokenKind::Rsqb => {
+                    parens = parens.saturating_sub(1);
+                    if parens == 0 {
+                        annotated_func_arg = false;
+                    }
+                }
+                TokenKind::Colon if parens == 1 && self.in_function_definition() => {
+                    annotated_func_arg = true;
+                }
+                TokenKind::Comma if parens == 1 => {
+                    annotated_func_arg = false;
+                }
+                TokenKind::Equal if self.in_type_params() || (parens > 0 && fstrings == 0) => {
+                    if self.in_type_params() || (annotated_func_arg && parens == 1) {
+                        let start = token.range.start();
+                        if start >= prev_end
+                            && locator.slice(TextRange::new(prev_end, start)).is_empty()
+                            && prev_end != TextSize::new(0)
+                        {
+                            let mut diagnostic = Diagnostic::new(
+                                MissingWhitespaceAroundParameterEquals,
+                                token.range,
+                            );
+                            diagnostic.set_fix(Fix::safe_edit(Edit::insertion(
+                                " ".to_string(),
+                                token.range.start(),
+                            )));
+                            context.push_diagnostic(diagnostic);
+                        }
+
+                        while let Some(next) = iter.peek() {
+                            if next.kind == TokenKind::NonLogicalNewline {
+                                iter.next();
+                            } else {
+                                let next_start = next.range.start();
+                                let token_end = token.range.end();
+                                if next_start >= token_end
+                                    && locator
+                                        .slice(TextRange::new(token_end, next_start))
+                                        .is_empty()
+                                {
+                                    let mut diagnostic = Diagnostic::new(
+                                        MissingWhitespaceAroundParameterEquals,
+                                        token.range,
+                                    );
+                                    diagnostic.set_fix(Fix::safe_edit(Edit::insertion(
+                                        " ".to_string(),
+                                        token.range.end(),
+                                    )));
+                                    context.push_diagnostic(diagnostic);
+                                }
+                                break;
+                            }
+                        }
+                    } else {
+                        let start = token.range.start();
+                        if start >= prev_end
+                            && !locator.slice(TextRange::new(prev_end, start)).is_empty()
+                        {
+                            let mut diagnostic = Diagnostic::new(
+                                UnexpectedSpacesAroundKeywordParameterEquals,
+                                TextRange::new(prev_end, start),
+                            );
+                            diagnostic.set_fix(Fix::safe_edit(Edit::deletion(prev_end, start)));
+                            context.push_diagnostic(diagnostic);
+                        }
+
+                        while let Some(next) = iter.peek() {
+                            if next.kind == TokenKind::NonLogicalNewline {
+                                iter.next();
+                            } else {
+                                let next_start = next.range.start();
+                                let token_end = token.range.end();
+                                if next_start >= token_end
+                                    && !locator
+                                        .slice(TextRange::new(token_end, next_start))
+                                        .is_empty()
+                                {
+                                    let mut diagnostic = Diagnostic::new(
+                                        UnexpectedSpacesAroundKeywordParameterEquals,
+                                        TextRange::new(token_end, next_start),
+                                    );
+                                    diagnostic.set_fix(Fix::safe_edit(Edit::deletion(
+                                        token_end, next_start,
+                                    )));
+                                    context.push_diagnostic(diagnostic);
+                                }
+                                break;
+                            }
+                        }
+                    }
+                }
+                _ => {}
+            }
+
+            prev_end = token.range.end();
+        }
+    }
