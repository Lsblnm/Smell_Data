+impl Arguments {
+    fn split_into_columns(&self, v: &Value, separator: &Regex, call: &Call) -> Vec<Value> {
+        let head = call.head;
+        let full = call.span();
+        let output_start = head.start.max(full.start.min(head.start));
+        let output_end = head.end.min(full.end.max(head.end));
+        let output_span = Span::new(output_start, output_end);
+
+        let coerced = match v {
+            Value::String { val, internal_span } => {
+                Some((Cow::Borrowed(val.as_str()), *internal_span))
+            }
+            Value::Int { val, internal_span } => {
+                Some((Cow::Owned(val.to_string()), *internal_span))
+            }
+            Value::Float { val, internal_span } => {
+                Some((Cow::Owned(val.to_string()), *internal_span))
+            }
+            Value::Binary { val, internal_span } => std::str::from_utf8(val)
+                .ok()
+                .map(|s| (Cow::Borrowed(s), *internal_span)),
+            Value::Date { val, internal_span } => Some((
+                Cow::Owned(val.to_rfc3339_opts(chrono::SecondsFormat::Millis, true)),
+                *internal_span,
+            )),
+            Value::Error { error, internal_span } => {
+                let output_span = Span::new(
+                    output_span
+                        .start
+                        .max(internal_span.start.min(output_span.start)),
+                    output_span.end,
+                );
+                return vec![Value::error(*error.clone(), output_span)];
+            }
+            other => {
+                let src = other.span();
+                let span = Span::new(src.start, src.end);
+                return vec![Value::error(
+                    ShellError::PipelineMismatch {
+                        exp_input_type: "string".into(),
+                        dst_span: output_span,
+                        src_span: span,
+                    },
+                    span,
+                )];
+            }
+        };
+
+        if let Some((s, src_span)) = coerced {
+            let output_span = Span::new(
+                output_span.start.max(src_span.start.min(output_span.start)),
+                output_span.end,
+            );
+            let split_result: Vec<_> = separator
+                .split(s.as_ref())
+                .filter(|x| !(self.collapse_empty && x.is_empty()))
+                .collect();
+            let positional: Vec<_> = self
+                .rest
+                .iter()
+                .map(|f| f.item.clone())
+                .collect();
+
+            let mut record = Record::new();
+            if positional.is_empty() {
+                for (idx, part) in split_result.iter().enumerate() {
+                    record.push(format!("column{}", idx + 1), Value::string(*part, output_span));
+                }
+            } else {
+                for (part, name) in split_result.iter().zip(&positional) {
+                    record.push(name, Value::string(*part, output_span));
+                }
+            }
+            vec![Value::record(record, output_span)]
+        } else {
+            let src = v.span();
+            let span = Span::new(src.start, src.end);
+            vec![Value::error(
+                ShellError::PipelineMismatch {
+                    exp_input_type: "string".into(),
+                    dst_span: output_span,
+                    src_span: span,
+                },
+                span,
+            )]
+        }
+    }
+}
