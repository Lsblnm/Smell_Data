+        identity = workspace.keychain_name
+        readonly_flag = storage.readonly
+
+        UI.verbose("Downloading file from S3 '#{file_path}' on bucket #{bucket_label} (#{region_label}/#{identity}/#{credential_tag}/#{readonly_flag})")
