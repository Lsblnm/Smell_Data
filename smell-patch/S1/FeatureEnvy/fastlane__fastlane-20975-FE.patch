+require_relative '../module'
+require_relative '../utils'
+
 module Match
   module Encryption
     class Interface
+      attr_accessor :keychain_name
+      attr_accessor :working_directory
+      attr_writer :path_helper
+
+      def path_helper
+        @path_helper ||= begin
+          helper = Match::Utils.new
+          helper.root_path = working_directory
+          helper
+        end
+      end
+
+      def ensure_mapped_root
+        mapper = path_helper
+        if mapper.root_path.to_s.empty? && working_directory.to_s.length > 0
+          mapper.root_path = working_directory
+        end
+        return mapper.root_path if working_directory.to_s.empty?
+        working_directory
+      end
+
