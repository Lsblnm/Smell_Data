+	return function(value) {
+		this._node[name] = value;
+	};
+}
+
+Object.defineProperties(HostFields.prototype, {
+	value: { get: hostFieldGet('value') },
+	checked: { get: hostFieldGet('checked') },
+	innerHTML: {
+		get: hostFieldGet('innerHTML'),
+		set: hostFieldSet('innerHTML')
+	},
+	data: { get: hostFieldGet('data'), set: hostFieldSet('data') },
+	attributes: { get: hostFieldGet('attributes') }
