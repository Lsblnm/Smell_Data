+/**
+ * Host DOM fields used while diffing an element.
+ * @param {import('../internal').PreactElement} dom
+ */
+export function HostFields(dom) {
+	this.rebind(dom);
+}
+
+HostFields.prototype.rebind = function(dom) {
+	this._node = dom;
+};
+
+function hostFieldGet(name) {
+	return function() {
+		return this._node[name];
+	};
+}
+
