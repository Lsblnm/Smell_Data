+            if method_router.head.is_some() {
+                match &mut method_router.head {
+                    MethodEndpoint::None => {}
+                    MethodEndpoint::Route(route) => {
+                        return RouteFuture::from_future(route.oneshot_inner(req))
+                            .strip_body(strip_body);
+                    }
+                    MethodEndpoint::BoxedHandler(handler) => {
+                        let mut route = handler.clone().0.into_route(state);
+                        return RouteFuture::from_future(route.oneshot_inner(req))
+                            .strip_body(strip_body);
+                    }
