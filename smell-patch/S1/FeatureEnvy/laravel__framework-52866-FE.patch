@@ -7,9 +7,37 @@
 use InvalidArgumentException;
 use ReflectionFunction;
 use ReflectionMethod;
+use ReflectionParameter;
 
 class BoundMethod
 {
+    /**
+     * The container instance used to resolve primitives.
+     *
+     * @var \Illuminate\Container\Container
+     */
+    protected $container;
+
+    /**
+     * The parameter currently being resolved.
+     *
+     * @var \ReflectionParameter
+     */
+    protected $parameter;
+
+    /**
+     * Create a new bound method helper.
+     *
+     * @param  \Illuminate\Container\Container  $container
+     * @param  \ReflectionParameter  $parameter
+     * @return void
+     */
+    public function __construct($container, ReflectionParameter $parameter)
+    {
+        $this->container = $container;
+        $this->parameter = $parameter;
+    }
+
     /**
      * Call the given Closure / class@method and inject its dependencies.
      *
@@ -214,4 +242,56 @@ protected static function isCallableWithAtSign($callback)
     {
         return is_string($callback) && str_contains($callback, '@');
     }
+
+    /**
+     * Resolve a non-class hinted primitive dependency.
+     *
+     * @return mixed
+     *
+     * @throws \Illuminate\Contracts\Container\BindingResolutionException
+     */
+    public function resolvePrimitiveBinding()
+    {
+        $abstract = '$'.$this->parameter->getName();
+
+        [$buildStack, $abstractAliases] = Closure::bind(function () {
+            return [
+                $this->buildStack,
+                $this->abstractAliases,
+            ];
+        }, $this->container, Container::class)();
+
+        $contextual = $this->container->contextual;
+        $concrete = $contextual[end($buildStack)][$abstract] ?? null;
+
+        if (is_null($concrete) && ! empty($abstractAliases[$abstract])) {
+            foreach ($abstractAliases[$abstract] as $alias) {
+                $aliased = $contextual[end($buildStack)][$alias] ?? null;
+
+                if (! is_null($aliased)) {
+                    $concrete = $aliased;
+
+                    break;
+                }
+            }
+        }
+
+        if (! is_null($concrete)) {
+            return Util::unwrapIfClosure($concrete, $this->container);
+        }
+
+        if ($this->parameter->isDefaultValueAvailable()) {
+            return $this->parameter->getDefaultValue();
+        }
+
+        if ($this->parameter->isVariadic()) {
+            return [];
+        }
+
+        $className = $this->parameter->getDeclaringClass()->getName();
+
+        throw new BindingResolutionException(
+            "Unresolvable dependency resolving [{$this->parameter}] in class {$className}"
+        );
+    }
 }
