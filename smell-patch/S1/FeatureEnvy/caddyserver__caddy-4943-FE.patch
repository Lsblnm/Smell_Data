+	resultHeader := make(http.Header)
+	for _, name := range ops.Delete {
+		resultHeader.Del(name)
+	}
+	for name, vals := range ops.Set {
+		if len(vals) == 0 {
+			continue
+		}
+		resultHeader[name] = vals
+	}
+	for name, vals := range ops.Add {
