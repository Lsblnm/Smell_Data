+    /**
+     * Store the verbatim blocks and replace them with a temporary placeholder.
+     *
+     * @param  string  $value
+     * @return string
+     */
+    public function storeVerbatimBlocks($value)
+    {
+        $compiler = $this->blade;
+
+        $preservedTokens = array_merge(
+            array_keys($compiler->getClassComponentAliases()),
+            array_keys($compiler->getCustomDirectives()),
+            array_keys($compiler->getClassComponentNamespaces()),
+            array_map(
+                fn ($path) => $path['prefix'] ?? '',
+                $compiler->getAnonymousComponentPaths()
+            ),
+            array_filter($compiler->getExtensions(), 'is_string')
+        );
+
+        $preservedTokens = array_values(array_filter(
+            $preservedTokens,
+            fn ($token) => $token !== '' && ! is_null($token)
+        ));
+
+        $slotPrototype = new ComponentSlot;
+        $defaultAttributes = $slotPrototype->attributes->all();
+        $defaultContents = $slotPrototype->toHtml();
+
+        return preg_replace_callback('/(?<!@)@verbatim(.*?)@endverbatim/s', function ($matches) use ($compiler, $preservedTokens, $defaultAttributes, $defaultContents) {
+            $slot = new ComponentSlot($matches[1].$defaultContents);
+            $contents = $slot->toHtml();
+
+            if (! empty($preservedTokens)) {
+                $contents = str_replace($preservedTokens, $preservedTokens, $contents);
+            }
+
+            $attributes = $slot->attributes->all() + $defaultAttributes;
+
+            return $compiler->storeRawBlock(implode('', $attributes).$contents);
+        }, $value);
+    }
+
