@@ -27,10 +27,45 @@ module RuboCop
         KIND = 'method'
 
         def on_def(node)
-          check(node, node.body)
+          processed_lines(node)
         end
         alias on_defs on_def
 
+        def processed_lines(node, adjusted_first_line: nil)
+          return [] unless config && processed_source
+
+          location = node.loc
+          arguments = node.arguments
+          lines = processed_source.lines
+
+          if node.def_type? || node.defs_type?
+            body = node.body
+            keyword_loc = location.respond_to?(:keyword) ? location.keyword : nil
+            end_loc = location.respond_to?(:end) ? location.end : nil
+            name_loc = location.respond_to?(:name) ? location.name : nil
+            return [] unless keyword_loc && name_loc
+
+            first = keyword_loc.line
+            last = end_loc ? end_loc.line : node.last_line
+            relevant_line = [first, last, name_loc.line].compact.max
+            if relevant_line > first || body
+              check(node, body, adjusted_first_line: adjusted_first_line)
+            end
+            []
+          else
+            inner = []
+            line_nums = arguments.each_with_object([]) do |arg_node, collected|
+              collected << [arg_node.first_line - 1, arg_node.last_line + 1]
+              inner << [arg_node.first_line + 1, arg_node.last_line - 1] if arg_node.multiline?
+            end
+            numbers = line_nums.flatten.uniq - inner.flatten -
+                      [node.first_line - 1, node.last_line + 1]
+            numbers.each_with_object([]) do |num, array|
+              array << [lines[num - 1], num]
+            end
+          end
+        end
+
         private
 
         def style
