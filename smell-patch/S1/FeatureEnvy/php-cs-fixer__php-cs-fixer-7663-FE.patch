+++ b/src/Fixer/Whitespace/StatementIndentationFixer.php
@@ -26,6 +26,9 @@
 use PhpCsFixer\FixerDefinition\FixerDefinitionInterface;
 use PhpCsFixer\Preg;
 use PhpCsFixer\Tokenizer\Analyzer\AlternativeSyntaxAnalyzer;
+use PhpCsFixer\Tokenizer\Analyzer\Analysis\SwitchAnalysis;
+use PhpCsFixer\Tokenizer\Analyzer\ControlCaseStructuresAnalyzer;
+use PhpCsFixer\Tokenizer\Analyzer\NamespacesAnalyzer;
 use PhpCsFixer\Tokenizer\CT;
 use PhpCsFixer\Tokenizer\Token;
 use PhpCsFixer\Tokenizer\Tokens;
@@ -556,6 +559,198 @@ private function findStatementEndIndex(Tokens $tokens, int $index, int $parentSc
         return $endIndex ?? $tokens->getPrevMeaningfulToken($parentScopeEndIndex);
     }
 
+    public function findStatementEnd(Tokens $tokens, int $parenthesisEndIndex): int
+    {
+        $indent = $this->whitespacesConfig->getIndent();
+        $lineEnding = $this->whitespacesConfig->getLineEnding();
+        $bracesFixerCompatibility = $this->bracesFixerCompatibility;
+
+        $controlTokens = [
+            T_DECLARE,
+            T_DO,
+            T_ELSE,
+            T_ELSEIF,
+            T_FINALLY,
+            T_FOR,
+            T_FOREACH,
+            T_IF,
+            T_WHILE,
+            T_TRY,
+            T_CATCH,
+            T_SWITCH,
+        ];
+
+        $scopeStartIndex = 0;
+        $scopeEndIndex = \count($tokens) - 1;
+        $namespaceFullName = '';
+
+        if ($tokens->offsetExists($parenthesisEndIndex)) {
+            $namespaceDeclaration = (new NamespacesAnalyzer())->getNamespaceAt($tokens, $parenthesisEndIndex);
+            $namespaceFullName = $namespaceDeclaration->getFullName();
+            $scopeStartIndex = $namespaceDeclaration->getScopeStartIndex();
+            $scopeEndIndex = $namespaceDeclaration->getScopeEndIndex();
+        }
+
+        $resolveCurlyBlockEnd = function (int $openIndex) use (
+            $tokens,
+            $scopeStartIndex,
+            $scopeEndIndex,
+            $namespaceFullName,
+            $indent,
+            $lineEnding,
+            $bracesFixerCompatibility
+        ): int {
+            $blockEnd = $tokens->findBlockEnd(Tokens::BLOCK_TYPE_CURLY_BRACE, $openIndex);
+
+            $whitespaceAgreesWithConfig = true;
+            if ($openIndex > 0) {
+                $previousToken = $tokens[$openIndex - 1];
+                if ($previousToken->isWhitespace()) {
+                    $previousContent = $previousToken->getContent();
+                    $normalizedWhitespace = str_replace(["\r\n", "\r"], $lineEnding, $previousContent);
+                    $hasConfiguredLineEnding = str_contains($normalizedWhitespace, $lineEnding) || str_contains($previousContent, "\n");
+                    $indentAligned = '' === $indent || str_contains($normalizedWhitespace, $indent) || !$hasConfiguredLineEnding;
+                    if ($bracesFixerCompatibility && !$indentAligned) {
+                        $whitespaceAgreesWithConfig = str_contains($normalizedWhitespace, $lineEnding);
+                    }
+                }
+            }
+
+            try {
+                foreach (ControlCaseStructuresAnalyzer::findControlStructures($tokens, [T_SWITCH]) as $switchAnalysis) {
+                    if (!$switchAnalysis instanceof SwitchAnalysis) {
+                        continue;
+                    }
+
+                    $switchOpenIndex = $switchAnalysis->getOpenIndex();
+                    if ($switchOpenIndex !== $openIndex) {
+                        continue;
+                    }
+
+                    $switchCloseIndex = $switchAnalysis->getCloseIndex();
+                    $belongsToCurrentNamespace = ('' === $namespaceFullName && 0 === $scopeStartIndex)
+                        || ($switchOpenIndex >= $scopeStartIndex && $switchCloseIndex <= $scopeEndIndex);
+
+                    if (
+                        $belongsToCurrentNamespace
+                        && $whitespaceAgreesWithConfig
+                        && $switchCloseIndex === $blockEnd
+                    ) {
+                        return $switchCloseIndex;
+                    }
+                }
+            } catch (\RuntimeException $exception) {
+                return $blockEnd;
+            }
+
+            return $blockEnd;
+        };
+
+        $nextIndex = $tokens->getNextMeaningfulToken($parenthesisEndIndex);
+        if (null === $nextIndex) {
+            return $parenthesisEndIndex;
+        }
+
+        $nextToken = $tokens[$nextIndex];
+        $nextTokenIsArray = $nextToken->isArray();
+        $nextTokenId = $nextToken->getId();
+        $nextTokenContent = $nextToken->getContent();
+
+        if (!$nextTokenIsArray && '{' === $nextTokenContent) {
+            return $resolveCurlyBlockEnd($nextIndex);
+        }
+
+        if ($nextTokenIsArray && null !== $nextTokenId && \in_array($nextTokenId, $controlTokens, true)) {
+            $controlParenthesisIndex = $tokens->getNextMeaningfulToken($nextIndex);
+            $controlParenthesisToken = $tokens[$controlParenthesisIndex];
+            $controlParenthesisIsArray = $controlParenthesisToken->isArray();
+            $controlParenthesisContent = $controlParenthesisToken->getContent();
+
+            if (!$controlParenthesisIsArray && '(' === $controlParenthesisContent) {
+                $parenthesisEndIndex = $tokens->findBlockEnd(Tokens::BLOCK_TYPE_PARENTHESIS_BRACE, $controlParenthesisIndex);
+            } else {
+                $parenthesisEndIndex = $nextIndex;
+            }
+
+            $endIndex = $this->findStatementEnd($tokens, $parenthesisEndIndex);
+
+            if (\in_array($nextTokenId, [T_IF, T_TRY, T_DO], true)) {
+                $openingTokenKind = $nextTokenId;
+
+                while (true) {
+                    $nextIndex = $tokens->getNextMeaningfulToken($endIndex);
+                    $continuationTokens = [];
+                    $finalContinuationTokens = [];
+
+                    if (T_IF === $openingTokenKind) {
+                        $continuationTokens = [
+                            T_ELSE,
+                            T_ELSEIF,
+                        ];
+                        $finalContinuationTokens = [T_ELSE];
+                    } elseif (T_DO === $openingTokenKind) {
+                        $continuationTokens = [T_WHILE];
+                    } elseif (T_TRY === $openingTokenKind) {
+                        $continuationTokens = [
+                            T_CATCH,
+                            T_FINALLY,
+                        ];
+                        $finalContinuationTokens = [T_FINALLY];
+                    }
+
+                    if (null !== $nextIndex && $tokens[$nextIndex]->isGivenKind($continuationTokens)) {
+                        $continuationParenthesisIndex = $tokens->getNextMeaningfulToken($nextIndex);
+                        $continuationParenthesisToken = $tokens[$continuationParenthesisIndex];
+                        $continuationParenthesisIsArray = $continuationParenthesisToken->isArray();
+                        $continuationParenthesisId = $continuationParenthesisToken->getId();
+                        $continuationParenthesisContent = $continuationParenthesisToken->getContent();
+
+                        if (!$continuationParenthesisIsArray && null === $continuationParenthesisId && '(' === $continuationParenthesisContent) {
+                            $parenthesisEndIndex = $tokens->findBlockEnd(Tokens::BLOCK_TYPE_PARENTHESIS_BRACE, $continuationParenthesisIndex);
+                        } else {
+                            $parenthesisEndIndex = $nextIndex;
+                        }
+
+                        $endIndex = $this->findStatementEnd($tokens, $parenthesisEndIndex);
+
+                        $continuationToken = $tokens[$nextIndex];
+                        if ($continuationToken->isArray() && \in_array($continuationToken->getId(), $finalContinuationTokens, true)) {
+                            return $endIndex;
+                        }
+                    } else {
+                        break;
+                    }
+                }
+            }
+
+            return $endIndex;
+        }
+
+        $index = $parenthesisEndIndex;
+
+        while (true) {
+            $token = $tokens[++$index];
+            $tokenIsArray = $token->isArray();
+            $tokenId = $token->getId();
+            $tokenContent = $token->getContent();
+
+            // if there is some block in statement (eg lambda function) we need to skip it
+            if (!$tokenIsArray && '{' === $tokenContent) {
+                $index = $resolveCurlyBlockEnd($index);
+
+                continue;
+            }
+
+            if (!$tokenIsArray && ';' === $tokenContent) {
+                return $index;
+            }
+
+            if ($tokenIsArray && T_CLOSE_TAG === $tokenId) {
+                return $tokens->getPrevNonWhitespace($index);
+            }
+        }
+    }
+
     /**
      * @return array{int, bool}
      */
