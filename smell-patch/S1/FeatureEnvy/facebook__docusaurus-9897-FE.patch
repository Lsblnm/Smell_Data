+class MarkdownContent {
+  private readonly sourceContent: string;
+  private readonly fenceLengths: readonly number[];
+
+  constructor(sourceContent: string, fenceLengths: readonly number[]) {
+    this.sourceContent = sourceContent;
+    this.fenceLengths = fenceLengths;
+  }
+
+  unwrapMdxCodeBlocks(): string {
+    let unwrappedContent = this.sourceContent;
+    for (const fenceLength of this.fenceLengths) {
+      const fence = new MdxCodeFence(fenceLength);
+      const lineBoundary = fence.getLineBoundary();
+      const newline = lineBoundary.getNewlineSequence();
+      const beginBoundary = `${lineBoundary.getStartPrefix()}|${newline}`;
+      const endBoundary = `${newline}|${lineBoundary.getEndSuffix()}`;
+      const fencePattern = new RegExp(
+        `(?<begin>${beginBoundary})` +
+          `${fence.getMarker()}` +
+          `(?<spaces>${fence.getIndentPattern()})` +
+          `${fence.getInfoLabel()}` +
+          `${newline}(?<children>.*?)${newline}` +
+          `${fence.getMarker()}(?<end>${endBoundary})`,
+        'gs',
+      );
+      unwrappedContent = unwrappedContent.replaceAll(
+        fencePattern,
+        // eslint-disable-next-line @typescript-eslint/no-explicit-any
+        (_substring: string, ...args: any[]) => {
+          const capture = lineBoundary.createBlockCapture(args.at(-1));
+          return `${capture.getBegin()}${capture.getChildren()}${capture.getEnd()}`;
+        },
+      );
+    }
+    return unwrappedContent;
+  }
+}
