+/**
+ * Named groups captured from an MDX fenced code block.
+ */
+export class MdxBlockCapture {
+  private readonly begin: string;
+  private readonly children: string;
+  private readonly end: string;
+
+  constructor(begin: string, children: string, end: string) {
+    this.begin = begin;
+    this.children = children;
+    this.end = end;
+  }
+
+  getBegin(): string {
+    return this.begin;
+  }
+
+  getChildren(): string {
+    return this.children;
+  }
+
+  getEnd(): string {
+    return this.end;
+  }
+}
