+        boundary = WEBrick::HTTPUtils.dequote($1)
+        params.update WEBrick::HTTPUtils.parse_form_data(body, boundary)
+      elsif /^application\/json/.match?(handler.content_type)
+        params['json'] = body
+      elsif /^application\/csp-report/.match?(handler.content_type)
+        params['json'] = body
+      elsif /^application\/msgpack/.match?(handler.content_type)
+        params['msgpack'] = body
+      elsif /^application\/x-ndjson/.match?(handler.content_type)
+        params['ndjson'] = body
+      end
+
+      if parser
+        time_key = parser.time_key
+        keep_time_key = parser.keep_time_key
+        time_parser = parser.time_parser
+        record_time_supported = time_parser.nil? || time_parser.is_a?(Fluent::TimeParser)
+        if time_key == 'time' && params.key?('time') && !keep_time_key && record_time_supported
+          params['time'] = params[time_key]
+        end
+      end
+
+      path_info = uri.path
+
+      if @add_query_params
+        query_params = WEBrick::HTTPUtils.parse_query(uri.query)
+        query_params.each_pair {|k,v|
+          params["QUERY_#{k.tr('-','_').upcase}"] = v
+        }
+      end
+
+      params.merge!(env)
+      env.clear
+
+      code, header, resp_body = on_request(path_info, params)
+      resp_body = resp_body.to_s
+      header = header.dup if header.frozen?
+
+      handler.apply_cors_headers(header)
+
+      if handler.keep_alive && km.timeout >= 0
+        header['Connection'] = 'Keep-Alive'.freeze
+        handler.send_response(code, header, resp_body)
+      else
+        handler.send_response_and_close(code, header, resp_body)
+      end
+    end
