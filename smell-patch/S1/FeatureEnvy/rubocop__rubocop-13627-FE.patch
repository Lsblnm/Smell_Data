diff --git a/lib/rubocop/cop/correctors/condition_corrector.rb b/lib/rubocop/cop/correctors/condition_corrector.rb
index 10f9494be..0d70f35a4 100644
--- a/lib/rubocop/cop/correctors/condition_corrector.rb
+++ b/lib/rubocop/cop/correctors/condition_corrector.rb
@@ -4,6 +4,8 @@ module RuboCop
   module Cop
     # This class does condition autocorrection
     class ConditionCorrector
+      extend NodePattern::Macros
+
       class << self
         def correct_negative_condition(corrector, node)
           condition = negated_condition(node)
@@ -20,6 +22,114 @@ module RuboCop
           condition
         end
       end
+
+      def initialize(cop, or_node)
+        @cop = cop
+        @or_node = or_node
+      end
+
+      # @!method simple_double_comparison?(node)
+      def_node_matcher :simple_double_comparison?, '(send $lvar :== $lvar)'
+
+      # @!method simple_comparison_lhs?(node)
+      def_node_matcher :simple_comparison_lhs?, <<~PATTERN
+        (send $lvar :== $_)
+      PATTERN
+
+      # @!method simple_comparison_rhs?(node)
+      def_node_matcher :simple_comparison_rhs?, <<~PATTERN
+        (send $_ :== $lvar)
+      PATTERN
+
+      # rubocop:disable Metrics/AbcSize, Metrics/CyclomaticComplexity, Metrics/MethodLength
+      def check_multiple_comparison
+        config = @cop.config
+        processed_source = @cop.processed_source
+        return unless config && processed_source
+        return unless processed_source.buffer
+
+        file_path = processed_source.path
+        return if file_path && !@cop.relevant_file?(file_path)
+
+        origin = config.loaded_path
+        qualified_name = Registry.qualified_cop_name(@cop.cop_name, origin)
+        department_name = qualified_name.split('/')[0..-2].join('/')
+        department_config = config[department_name]
+        cop_config = config.for_cop(qualified_name)
+        cop_config = department_config.merge(cop_config) if department_config
+
+        allow_method_comparison = cop_config.fetch('AllowMethodComparison', true)
+        comparisons_threshold = cop_config.fetch('ComparisonsThreshold', 2)
+
+        node = @or_node
+        root = node
+        parent = root.parent
+        while parent&.or_type?
+          root = parent
+          parent = root.parent
+        end
+        return unless node.equal?(root)
+        return unless nested_comparison?(node)
+
+        variable, values = find_offending_var(node, allow_method_comparison)
+        return unless variable
+        return if values.size < comparisons_threshold
+
+        first_comparison = values.first.parent
+        last_comparison = values.last.parent
+        range = first_comparison.source_range.begin.join(last_comparison.source_range.end)
+
+        @cop.add_offense(range) do |corrector|
+          elements = values.map(&:source).join(', ')
+          variable_id = variable.children[0]
+          prefer_method = "[#{elements}].include?(#{variable_id})"
+          corrector.replace(range, prefer_method)
+        end
+      end
+      # rubocop:enable Metrics/AbcSize, Metrics/CyclomaticComplexity, Metrics/MethodLength
+
+      private
+
+      attr_reader :cop, :or_node
+
+      # rubocop:disable Metrics/CyclomaticComplexity, Metrics/PerceivedComplexity
+      def find_offending_var(node, allow_method_comparison, variables = Set.new, values = [])
+        if node.or_type?
+          find_offending_var(node.lhs, allow_method_comparison, variables, values)
+          find_offending_var(node.rhs, allow_method_comparison, variables, values)
+        elsif simple_double_comparison?(node)
+          return
+        elsif (var, obj = simple_comparison?(node))
+          return if allow_method_comparison && obj.call_type?
+
+          variables << var
+          return if variables.size > 1
+
+          values << obj
+        end
+
+        [variables.first, values] if variables.any?
+      end
+      # rubocop:enable Metrics/CyclomaticComplexity, Metrics/PerceivedComplexity
+
+      def nested_comparison?(node)
+        if node.or_type?
+          node.node_parts.all? { |node_part| comparison? node_part }
+        else
+          false
+        end
+      end
+
+      def comparison?(node)
+        simple_comparison?(node) || nested_comparison?(node)
+      end
+
+      def simple_comparison?(node)
+        if (var, obj = simple_comparison_lhs?(node)) ||
+           (obj, var = simple_comparison_rhs?(node))
+          [var, obj]
+        end
+      end
     end
   end
 end
