+    pub fn clear_assets(&self) {
+        let cache_matches = match self.matches.subcommand() {
+            Some(("cache", matches)) => matches,
+            _ => return,
+        };
+
+        if !cache_matches.get_flag("clear") {
+            return;
+        }
+
+        let cache_dir = PROJECT_DIRS.cache_dir();
+        let config_dir = PROJECT_DIRS.config_dir();
+        let source_dir = cache_matches
+            .get_one::<String>("source")
+            .map(Path::new)
+            .unwrap_or(config_dir);
+
+        let assets = HighlightingAssets::from_binary();
+        let metadata = AssetsMetadata::load_from_folder(cache_dir)
+            .ok()
+            .flatten()
+            .unwrap_or_else(|| AssetsMetadata::current(clap::crate_version!()));
+
+        let mut artifacts = Vec::new();
+
+        let has_themes = assets.has_themes();
+        let has_fallback_theme = assets.fallback_theme().is_some();
+        let custom_theme_dir = source_dir.join("themes");
+        let default_theme_dir = config_dir.join("themes");
+        if has_themes
+            || has_fallback_theme
+            || custom_theme_dir.exists()
+            || default_theme_dir.exists()
+        {
+            artifacts.push((cache_dir.join("themes.bin"), "theme set cache"));
+        }
+
+        let has_serialized_syntaxes = assets.serialized_syntaxes_available();
+        let syntax_set_initialized = assets.syntax_set_initialized();
+        let custom_syntax_dir = source_dir.join("syntaxes");
+        let default_syntax_dir = config_dir.join("syntaxes");
+        if has_serialized_syntaxes
+            || syntax_set_initialized
+            || custom_syntax_dir.exists()
+            || default_syntax_dir.exists()
+        {
+            artifacts.push((cache_dir.join("syntaxes.bin"), "syntax set cache"));
+        }
+
+        let has_version = metadata.bat_version().is_some();
+        let has_creation_time = metadata.creation_time().is_some();
+        let clearing_related_assets = !artifacts.is_empty();
+        if has_version || has_creation_time || clearing_related_assets {
+            artifacts.push((cache_dir.join("metadata.yaml"), "metadata file"));
+        }
+
+        for (path, description) in artifacts {
+            print!("Clearing {} ... ", description);
+            match fs::remove_file(&path) {
+                Err(err) if err.kind() == io::ErrorKind::NotFound => {
+                    println!("skipped (not present)");
+                }
+                Err(err) => {
+                    println!("could not remove the cache file {:?}: {}", &path, err);
+                }
+                Ok(_) => println!("okay"),
+            }
+        }
+    }
 }
