+  /**
+   * Restore this row from a cached object list using the layout of the given query.
+   */
+  void populateFromCache(
+      final GroupByQuery query,
+      final Iterator<Object> results,
+      final boolean isResultLevelCache,
+      final long timestamp,
+      final List<DimensionSpec> dims,
+      final List<AggregatorFactory> aggs
+  )
+  {
+    if (query.getResultRowHasTimestamp()) {
+      row[0] = timestamp;
+    }
+
+    final int dimensionStart = query.getResultRowDimensionStart();
+    final Iterator<DimensionSpec> dimsIter = dims.iterator();
+    final Map<String, Object> restoredDimensions = new HashMap<>();
+    while (dimsIter.hasNext() && results.hasNext()) {
+      final DimensionSpec dimensionSpec = dimsIter.next();
+      restoredDimensions.put(
+          dimensionSpec.getOutputName(),
+          DimensionHandlerUtils.convertObjectToType(results.next(), dimensionSpec.getOutputType())
+      );
+    }
+    int dimPos = 0;
+    for (DimensionSpec dimensionSpec : dims) {
+      final String outputName = dimensionSpec.getOutputName();
+      if (!restoredDimensions.containsKey(outputName)) {
+        break;
+      }
+      row[dimensionStart + dimPos] = restoredDimensions.get(outputName);
+      dimPos++;
+    }
+
+    final int aggregatorStart = query.getResultRowAggregatorStart();
+    for (int i = 0; i < aggs.size(); i++) {
+      final AggregatorFactory aggregator = aggs.get(i);
+      final String aggregatorName = aggregator.getName();
+      if (!results.hasNext()) {
+        throw new ISE(
+            "Ran out of objects while reading aggregators from cache! aggregator[%s]",
+            aggregatorName
+        );
+      }
+
+      if (isResultLevelCache) {
+        row[aggregatorStart + i] = results.next();
+      } else {
+        row[aggregatorStart + i] = aggregator.deserialize(results.next());
+      }
+    }
+
+    if (isResultLevelCache) {
+      final int postAggregatorStart = query.getResultRowPostAggregatorStart();
+      Iterator<PostAggregator> postItr = query.getPostAggregatorSpecs().iterator();
+      int postPos = 0;
+      while (postItr.hasNext() && results.hasNext()) {
+        row[postAggregatorStart + postPos] = results.next();
+      }
+    }
+
+    if (dimsIter.hasNext() || results.hasNext()) {
+      throw new ISE(
+          "Found left over objects while reading from cache!! dimsIter[%s] results[%s]",
+          dimsIter.hasNext(),
+          results.hasNext()
+      );
+    }
+  }
