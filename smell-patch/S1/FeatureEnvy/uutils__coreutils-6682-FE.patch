+/// Permission bits applied to parent directories created by `mkdir -p`.
+pub struct DirectoryPermissionSpec {
+    umask: u32,
+    permission_mask: u32,
+    owner_write_search: u32,
+}
+
+impl DirectoryPermissionSpec {
+    /// Build the GNU-compatible parent-directory mode formula.
+    pub fn for_parents() -> Self {
+        Self {
+            umask: get_umask(),
+            permission_mask: 0o0777,
+            owner_write_search: 0o0300,
+        }
+    }
+
+    pub fn umask(&self) -> u32 {
+        self.umask
+    }
+
+    pub fn permission_mask(&self) -> u32 {
+        self.permission_mask
+    }
+
+    pub fn owner_write_search(&self) -> u32 {
+        self.owner_write_search
+    }
+}
