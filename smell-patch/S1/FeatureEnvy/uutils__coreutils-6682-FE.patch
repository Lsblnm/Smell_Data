+/// Details used when reporting that a directory was created.
+pub struct CreatedPathNotice {
+    program: String,
+    quoted: String,
+}
+
+impl CreatedPathNotice {
+    pub fn for_directory(program: &str, path: &Path) -> Self {
+        Self {
+            program: program.to_owned(),
+            quoted: path.quote().to_string(),
+        }
+    }
+
+    pub fn program(&self) -> &str {
+        &self.program
