+    pub(crate) fn spawn_blocking_task(
+        &self,
+        task: blocking::Task,
+        rt: &crate::runtime::Handle,
+    ) -> Result<(), blocking::SpawnError> {
+        let inner = &self.blocking_spawner.inner;
+        let mut shared = inner.shared.lock();
+
+        if shared.shutdown {
+            // Shutdown the task: it's fine to shutdown this task (even if
+            // mandatory) because it was scheduled after the shutdown of the
+            // runtime began.
+            task.shutdown();
+
+            // no need to even push this task; it would never get picked up
+            return Err(blocking::SpawnError::ShuttingDown);
+        }
+
+        inner.enqueue_task(&mut shared, task);
+
+        if inner.metrics.num_idle_threads() == 0 {
+            // No threads are able to process the task.
+
+            if inner.metrics.num_threads() == inner.thread_cap {
+                // At max number of threads
+            } else {
+                assert!(shared.shutdown_tx.is_some());
+                let shutdown_tx = shared.shutdown_tx.clone();
+
+                if let Some(shutdown_tx) = shutdown_tx {
+                    inner.spawn_additional_thread(&mut shared, shutdown_tx, rt)?;
+                }
+            }
+        } else {
+            inner.wake_idle_thread(&mut shared);
+        }
+
+        Ok(())
+    }
 }
 
