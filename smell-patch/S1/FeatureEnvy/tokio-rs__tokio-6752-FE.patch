+                None => panic!("invalid key"),
+            }
+        } else {
+            slab.inner.remove(self.index)
+        };
+
+        let next_deadline = wheel
+            .poll_at()
+            .map(|poll_at| start + Duration::from_millis(poll_at));
+
+        if prev_deadline != next_deadline {
+            match next_deadline {
+                None => *delay = None,
+                Some(deadline) => {
+                    if let Some(timer) = delay.as_mut() {
+                        timer.as_mut().reset(deadline);
+                    } else {
+                        *delay = Some(Box::pin(sleep_until(deadline)));
+                    }
+                }
+            }
+        }
+
+        Expired {
+            key: Key::new(self.index),
+            data: data.inner,
+            deadline: start + Duration::from_millis(data.when),
+        }
+    }
