+  boolean emitSegmentUsageStats(
+      ServiceEmitter emitter,
+      DruidServerConfig serverConfig,
+      SegmentManager segmentManager,
+      SegmentLoadDropHandler segmentLoadDropHandler
+  )
+  {
+    final String category = workerCategory;
+    final String version = workerVersion;
+
+    final ServiceMetricEvent.Builder maxBuilder = new ServiceMetricEvent.Builder();
+    maxBuilder.setDimensionIfNotNull(DruidMetrics.CATEGORY, category);
+    maxBuilder.setDimensionIfNotNull(DruidMetrics.WORKER_VERSION, version);
+    emitter.emit(maxBuilder.setMetric("segment/max", serverConfig.getMaxSize()));
+
+    final Object2LongOpenHashMap<String> pendingDeleteSizes = new Object2LongOpenHashMap<>();
+
+    for (DataSegment segment : segmentLoadDropHandler.getSegmentsToDelete()) {
+      pendingDeleteSizes.addTo(segment.getDataSource(), segment.getSize());
+    }
+
+    for (String dataSource : pendingDeleteSizes.keySet()) {
+      final long pendingDeleteSize = pendingDeleteSizes.getLong(dataSource);
+      final ServiceMetricEvent.Builder builder = new ServiceMetricEvent.Builder()
+          .setDimension(DruidMetrics.DATASOURCE, dataSource)
+          .setDimension("tier", serverConfig.getTier())
+          .setDimension("priority", String.valueOf(serverConfig.getPriority()));
+      builder.setDimensionIfNotNull(DruidMetrics.CATEGORY, category);
+      builder.setDimensionIfNotNull(DruidMetrics.WORKER_VERSION, version);
+      emitter.emit(builder.setMetric("segment/pendingDelete", pendingDeleteSize));
+    }
+
+    final Map<String, Long> dataSourceSizes = segmentManager.getDataSourceSizes();
+    for (String dataSource : dataSourceSizes.keySet()) {
+      long used = dataSourceSizes.get(dataSource);
+
+      final ServiceMetricEvent.Builder builder =
+          new ServiceMetricEvent.Builder().setDimension(DruidMetrics.DATASOURCE, dataSource)
+                                          .setDimension("tier", serverConfig.getTier())
+                                          .setDimension("priority", String.valueOf(serverConfig.getPriority()));
+      builder.setDimensionIfNotNull(DruidMetrics.CATEGORY, category);
+      builder.setDimensionIfNotNull(DruidMetrics.WORKER_VERSION, version);
+
+      emitter.emit(builder.setMetric("segment/used", used));
+      final double usedPercent = serverConfig.getMaxSize() == 0 ? 0 : used / (double) serverConfig.getMaxSize();
+      emitter.emit(builder.setMetric("segment/usedPercent", usedPercent));
+    }
+
+    final Map<String, Long> dataSourceCounts = segmentManager.getDataSourceCounts();
+    for (String dataSource : dataSourceCounts.keySet()) {
+      long count = dataSourceCounts.get(dataSource);
+      final ServiceMetricEvent.Builder builder =
+          new ServiceMetricEvent.Builder().setDimension(DruidMetrics.DATASOURCE, dataSource)
+                                          .setDimension("tier", serverConfig.getTier())
+                                          .setDimension(
+                                              "priority",
+                                              String.valueOf(serverConfig.getPriority())
+                                          );
+      builder.setDimensionIfNotNull(DruidMetrics.CATEGORY, category);
+      builder.setDimensionIfNotNull(DruidMetrics.WORKER_VERSION, version);
+
+      emitter.emit(builder.setMetric("segment/count", count));
+    }
+
+    return true;
+  }
 }
