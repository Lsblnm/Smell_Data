+    /**
+     * Resolve a period end date from recurrences using this interval as the step.
+     */
+    public function resolvePeriodEndFromRecurrences(CarbonPeriod $period): ?CarbonInterface
+    {
+        $recurrences = $period->getRecurrences();
+
+        if ($recurrences === null) {
+            throw new UnreachableException(
+                "Could not calculate period end without either explicit end or recurrences.\n".
+                "If you're looking for a forever-period, use ->setRecurrences(INF).",
+            );
+        }
+
+        $start = $period->getStartDate();
+        $factory = $this->getFactory();
+        $settings = $factory->getSettings();
+        $translator = $factory->getTranslator();
+        $messages = method_exists($translator, 'getMessages') ? $translator->getMessages() : [];
+        $locale = $settings['locale'] ?? null;
+
+        if (\is_string($locale) && $messages !== []) {
+            $start = $start->avoidMutation()->locale($locale);
+        }
+
+        if ($recurrences === INF) {
+            $probe = $start->avoidMutation()->add($this);
+
+            if ($this->f != 0.0 || $this->invert || ($settings['strictMode'] ?? true) === false) {
+                $movedForward = $start < $probe;
+            } elseif ($start->year !== $probe->year) {
+                $movedForward = $start->year < $probe->year;
+            } elseif ($start->month !== $probe->month) {
+                $movedForward = $start->month < $probe->month;
+            } else {
+                $movedForward = $start->lessThan($probe);
+            }
+
+            return $movedForward
+                ? CarbonImmutable::endOfTime()
+                : CarbonImmutable::startOfTime();
+        }
+
+        if ($period->getFilters() === [[CarbonPeriod::RECURRENCES_FILTER, null]]) {
+            return $start->avoidMutation()->add(
+                $this->times(
+                    $recurrences - ($period->isStartExcluded() ? 0 : 1),
+                ),
+            );
+        }
+
+        return null;
+    }
