+template <typename Char, typename OutputIt>
+class padded_field_writer {
+ private:
+  OutputIt out_;
+  locale_ref loc_;
+
+ public:
+  padded_field_writer(OutputIt out, locale_ref loc) : out_(out), loc_(loc) {}
+
+  template <typename T>
+  OutputIt write(T value, float_write_session<Char>& session) {
+    if (const_check(!is_supported_floating_point(value))) return out_;
+    auto& view = session.view;
+    basic_format_specs<Char>* sp = view.specs;
+    prepare_float_session(session, value);
+
+    if (!std::isfinite(value)) {
+      if (sp->fill.size() == 1 &&
+          *sp->fill.data() == static_cast<Char>('0'))
+        sp->fill[0] = static_cast<Char>(' ');
+      return write_nonfinite(out_, std::isinf(value), *sp, session.parsed);
+    }
+
+    if (sp->align == align::numeric && session_has_sign(session)) {
+      auto it = reserve(out_, 1);
+      *it++ = static_cast<Char>(data::signs[session_sign(session)]);
+      out_ = base_iterator(out_, it);
+      clear_session_sign(session);
+      if (sp->width != 0) --sp->width;
+    }
+
+    if (session_is_hex(session)) {
+      append_hex_float(session, value);
+      return write_bytes(out_, bytes_of(session), *sp);
+    }
+    int precision = sp->precision >= 0 || !sp->type ? sp->precision : 6;
+    return write_decimal_float(out_, value, *sp, session.parsed, loc_,
+                               precision);
+  }
+};
+
+template <typename Char, typename OutputIt, typename T,
+          FMT_ENABLE_IF(std::is_floating_point<T>::value)>
+OutputIt write(OutputIt out, T value, basic_format_specs<Char> specs,
+               locale_ref loc = {}) {
+  float_write_session<Char> session(specs);
+  return padded_field_writer<Char, OutputIt>(out, loc).write(value, session);
+}
