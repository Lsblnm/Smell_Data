+func (p *pagePathBuilder) configureOutputState(isBundle bool, baseName, suffixesCSV, delimiter string) {
+	fullSuffix := ""
+	if suffixesCSV != "" {
+		suffix := suffixesCSV
+		if comma := strings.IndexByte(suffix, ','); comma >= 0 {
+			suffix = suffix[:comma]
+		}
+		fullSuffix = delimiter + suffix
+	}
+	p.fullSuffix = fullSuffix
+
+	d := p.d
+	p.isUgly = (d.UglyURLs || d.Type.Ugly) && !d.Type.NoUgly
+	p.baseNameSameAsType = !isBundle && baseName != "" && baseName == d.Type.BaseName
+
+	if d.ExpandedPermalink == "" && p.baseNameSameAsType {
+		p.isUgly = true
+	}
+}
+
+func (p *pagePathBuilder) addSectionAndFormatPath() bool {
+	d := p.d
+	needsBase := true
+
+	if d.Type == output.HTTPStatusHTMLFormat || d.Type == output.SitemapFormat || d.Type == output.RobotsTxtFormat {
+		p.noSubResources = true
+	} else if d.Kind != kinds.KindPage && d.URL == "" && d.Section.Base() != "/" {
+		if d.ExpandedPermalink != "" {
+			p.Add(d.ExpandedPermalink)
+		} else {
+			p.Add(d.Section.Base())
+		}
+		needsBase = false
+	}
+
+	if d.Type.Path != "" {
+		p.Add(d.Type.Path)
+	}
+
+	return needsBase
+}
+
+func (p *pagePathBuilder) addURLTargetElements() {
+	d := p.d
+	p.Add(paths.FieldsSlash(d.URL)...)
+
+	if d.Addends != "" {
+		p.Add(d.Addends)
+	}
+
+	hasDot := strings.Contains(d.URL, ".")
+	hasSlash := strings.HasSuffix(d.URL, "/")
+
+	if hasSlash || !hasDot {
+		p.Add(d.Type.BaseName + p.fullSuffix)
+	} else if hasDot {
+		p.fullSuffix = paths.Ext(d.URL)
+	}
+
+	if p.IsHtmlIndex() {
+		p.linkUpperOffset = 1
+	}
+
+	if d.ForcePrefix {
+		// Prepend language prefix if not already set in URL
+		if d.PrefixFilePath != "" && !strings.HasPrefix(d.URL, "/"+d.PrefixFilePath) {
+			p.prefixPath = d.PrefixFilePath
+		}
+
+		if d.PrefixLink != "" && !strings.HasPrefix(d.URL, "/"+d.PrefixLink) {
+			p.prefixLink = d.PrefixLink
+		}
+	}
+}
+
+func (p *pagePathBuilder) addRegularPageElements() {
+	d := p.d
+	if d.ExpandedPermalink != "" {
+		p.Add(d.ExpandedPermalink)
+	} else {
+		if dir := d.Path.ContainerDir(); dir != "" {
+			p.Add(dir)
+		}
+		if d.BaseName != "" {
+			p.Add(d.BaseName)
+		} else {
+			p.Add(d.Path.BaseNameNoIdentifier())
+		}
+	}
+
+	if d.Addends != "" {
+		p.Add(d.Addends)
+	}
+
+	if p.isUgly {
+		p.ConcatLast(p.fullSuffix)
+	} else {
+		p.Add(d.Type.BaseName + p.fullSuffix)
+	}
+
+	if p.IsHtmlIndex() {
+		p.linkUpperOffset = 1
+	}
+
+	if d.PrefixFilePath != "" {
+		p.prefixPath = d.PrefixFilePath
+	}
+
+	if d.PrefixLink != "" {
+		p.prefixLink = d.PrefixLink
+	}
+}
+
+func (p *pagePathBuilder) addBranchElements(needsBase bool) {
+	d := p.d
+	if d.Addends != "" {
+		p.Add(d.Addends)
+	}
+
+	needsBase = needsBase && d.Addends == ""
+
+	if needsBase || !p.isUgly {
+		p.Add(d.Type.BaseName + p.fullSuffix)
+	} else {
+		p.ConcatLast(p.fullSuffix)
+	}
+
+	if p.IsHtmlIndex() {
+		p.linkUpperOffset = 1
+	}
+
+	if d.PrefixFilePath != "" {
+		p.prefixPath = d.PrefixFilePath
+	}
+
+	if d.PrefixLink != "" {
+		p.prefixLink = d.PrefixLink
+	}
+}
+
 func getPagePathBuilder(d TargetPathDescriptor) *pagePathBuilder {
 	b := pagePathBuilderPool.Get().(*pagePathBuilder)
 	b.d = d
