+function TimeoutController(timeout) {
+  this.timeout = timeout;
+}
+
+TimeoutController.prototype.handleRequestTimeout = function handleRequestTimeout(req, config, reject, onCanceled) {
+  req.abort();
+
+  var configuredTimeout = config.timeout;
+  var cancelToken = config.cancelToken;
+  var signal = config.signal;
+  var transitional = config.transitional || transitionalDefaults;
+  var isNodePlatform = platform.isNode;
+  var timeoutErrorMessage = configuredTimeout ? 'timeout of ' + this.timeout + 'ms exceeded' : 'timeout exceeded';
+
+  if (cancelToken) {
+    if (!cancelToken.reason && cancelToken._listeners) {
+      var listenerIndex = cancelToken._listeners.indexOf(onCanceled);
+      if (listenerIndex !== -1) {
+        cancelToken._listeners.splice(listenerIndex, 1);
+      }
+    }
+  }
+
+  if (signal) {
+    signal.removeEventListener('abort', onCanceled);
+  }
+
+  reject(new AxiosError(
+    timeoutErrorMessage,
+    isNodePlatform && transitional.clarifyTimeoutError ? AxiosError.ETIMEDOUT : AxiosError.ECONNABORTED,
+    config,
+    req
+  ));
+};
