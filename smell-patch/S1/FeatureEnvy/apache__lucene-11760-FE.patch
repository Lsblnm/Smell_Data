+    NoIntervalsIterator(String field, LeafReaderContext ctx) {
+      this.field = field;
+      this.ctx = ctx;
+    }
+
+    IntervalIterator buildTermIntervals(BytesRef term) throws IOException {
+      String fieldName = this.field;
+      LeafReaderContext leaf = this.ctx;
+      Terms terms = leaf.reader().terms(fieldName);
+      if (terms == null) {
+        return null;
+      }
+      boolean hasPositions = terms.hasPositions();
+      boolean hasFreqs = terms.hasFreqs();
+      if (hasPositions == false || hasFreqs == false) {
+        throw new IllegalArgumentException(
+            "Cannot create an IntervalIterator over field "
+                + fieldName
+                + " because it has no indexed positions");
+      }
+      TermsEnum termsEnum = terms.iterator();
+      byte[] termBytes = term.bytes;
+      int termOffset = term.offset;
+      int termLength = term.length;
+      BytesRef soughtTerm = new BytesRef(termBytes, termOffset, termLength);
+      if (termsEnum.seekExact(soughtTerm) == false) {
+        return null;
+      }
+      int docFreq = termsEnum.docFreq();
+      assert docFreq > 0;
+      long totalTermFreq = termsEnum.totalTermFreq();
+      float matchCost =
+          TermIntervalsSource.TERM_POSNS_SEEK_OPS_PER_DOC
+              + (totalTermFreq / (float) docFreq) * TermIntervalsSource.TERM_OPS_PER_POS;
+      return TermIntervalsSource.intervals(term, termsEnum, matchCost);
+    }
