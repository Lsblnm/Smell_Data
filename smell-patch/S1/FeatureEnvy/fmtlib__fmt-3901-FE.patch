+  template <typename Char, typename Out, typename C>
+  auto apply(const detail::digit_grouping<Char>& grouping, Out out,
+             basic_string_view<C> digits) const -> Out {
+    auto num_digits = static_cast<int>(digits.size());
+    auto separators = basic_memory_buffer<int>();
+    separators.push_back(0);
+    auto state = grouping.initial_state();
+    while (int i = grouping.next(state)) {
+      if (i >= num_digits) break;
+      separators.push_back(i);
+    }
+    for (int i = 0, sep_index = static_cast<int>(separators.size() - 1);
+         i < num_digits; ++i) {
+      if (num_digits - i == separators[sep_index]) {
+        auto sep = grouping.thousands_sep();
+        out = detail::copy<Char>(sep.data(), sep.data() + sep.size(), out);
+        --sep_index;
+      }
+      *out++ = static_cast<Char>(digits[detail::to_unsigned(i)]);
+    }
+    return out;
+  }
+
