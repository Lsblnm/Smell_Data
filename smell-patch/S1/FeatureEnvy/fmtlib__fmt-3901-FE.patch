+        specs.type != presentation_type::dec) {
+      return detail::write_int(ctx.out(), abs_value, prefix, specs, grouping);
+    }
+    int num_digits = detail::count_digits(abs_value);
+    auto buffer = memory_buffer();
+    detail::format_decimal<char>(appender(buffer), abs_value, num_digits);
+    int extra_separators = 0;
+    if (!grouping.thousands_sep().empty() && !grouping.grouping().empty())
+      extra_separators = grouping.count_separators(num_digits);
+    unsigned size = (prefix != 0 ? prefix >> 24 : 0) +
+                    detail::to_unsigned(num_digits) +
+                    detail::to_unsigned(extra_separators);
+    return detail::write_padded<char, align::right>(
+        ctx.out(), specs, size, size,
+        [&](detail::reserve_iterator<decltype(ctx.out())> it) {
