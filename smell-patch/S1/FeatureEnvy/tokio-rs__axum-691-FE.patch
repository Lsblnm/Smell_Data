+    fn wrap_nested_method_router(
+        &mut self,
+        path: &str,
+        method_router: MethodRouter<B>,
+        prefix: &str,
+    ) {
+        let prefix = ByteStr::new(prefix);
+        let prefix = prefix.as_str();
+
+        let wrap_route = |route: Route<B>| Route::new(StripPrefix::new(route, prefix));
+
+        let mut method_router = method_router;
+        method_router.get = method_router.get.map(&wrap_route);
+        method_router.head = method_router.head.map(&wrap_route);
+        method_router.delete = method_router.delete.map(&wrap_route);
+        method_router.options = method_router.options.map(&wrap_route);
+        method_router.patch = method_router.patch.map(&wrap_route);
+        method_router.post = method_router.post.map(&wrap_route);
+        method_router.put = method_router.put.map(&wrap_route);
+        method_router.trace = method_router.trace.map(&wrap_route);
+
+        if let Some((route_id, Endpoint::MethodRouter(prev_method_router))) = self
+            .node
+            .path_to_route_id
+            .get(path)
+            .and_then(|route_id| self.routes.get(route_id).map(|svc| (*route_id, svc)))
+        {
+            let service =
+                Endpoint::MethodRouter(prev_method_router.clone().merge(method_router));
+            self.routes.insert(route_id, service);
+            return;
+        }
+
+        let id = RouteId::next();
+        if let Err(err) = self.node.insert(path, id) {
+            self.panic_on_matchit_error(err);
+        }
+        self.routes.insert(id, Endpoint::MethodRouter(method_router));
+    }
+
