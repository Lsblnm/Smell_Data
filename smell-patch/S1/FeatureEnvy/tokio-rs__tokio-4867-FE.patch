+        pub(crate) closed: bool,
+
+        /// Receivers waiting for a value.
+        pub(crate) waiters: crate::util::linked_list::LinkedList<
+            crate::util::linked_list::Waiter,
+            <crate::util::linked_list::Waiter as crate::util::linked_list::Link>::Target,
+        >,
+    }
+
+    impl Tail {
+        pub(crate) fn notify_rx(&mut self) {
+            while let Some(mut waiter) = self.waiters.pop_back() {
+                // Safety: `waiters` lock is still held.
+                let waiter = unsafe { waiter.as_mut() };
+
+                assert!(waiter.queued);
+                waiter.queued = false;
+
+                let waker = waiter.waker.take().unwrap();
+                waker.wake();
+            }
+        }
+    }
