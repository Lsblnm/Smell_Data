 // Close closes ng.
 func (ng *Engine) Close() error {
-	if ng.activeQueryTracker != nil {
-		return ng.activeQueryTracker.Close()
+	tracker := ng.activeQueryTracker
+	queryStats := ng.queryStats
+
+	peakSamples := 0
+	var totalSamples int64
+	perStepStats := false
+	hasTimers := false
+	if queryStats != nil {
+		hasTimers = queryStats.Timers != nil
+		if samples := queryStats.Samples; samples != nil {
+			peakSamples = samples.PeakSamples
+			totalSamples = samples.TotalSamples
+			perStepStats = samples.EnablePerStepStats
+		}
+	}
+
+	if aqt, ok := tracker.(*ActiveQueryTracker); ok && aqt != nil {
+		activeQueries := aqt.maxConcurrent
+		if aqt.getNextIndex != nil {
+			activeQueries = aqt.maxConcurrent - len(aqt.getNextIndex)
+		}
+		unfinishedEntries := 0
+		if aqt.mmapedFile != nil {
+			unfinishedEntries = bytes.Count(aqt.mmapedFile, []byte(`"query"`))
+		}
+		if aqt.logger != nil {
+			level.Debug(aqt.logger).Log(
+				"msg", "closing query engine",
+				"active_queries", activeQueries,
+				"unfinished_entries", unfinishedEntries,
+				"peak_samples", peakSamples,
+				"total_samples", totalSamples,
+				"per_step_stats", perStepStats,
+				"has_timers", hasTimers,
+			)
+		}
+		if aqt.closer != nil {
+			if err := aqt.closer.Close(); err != nil {
+				return fmt.Errorf("close ActiveQueryTracker.closer: %w", err)
+			}
+		}
+		return nil
+	}
+
+	if tracker != nil {
+		return tracker.Close()
 	}
 	return nil
 }
