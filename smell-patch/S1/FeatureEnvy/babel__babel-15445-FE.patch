@@ -126,6 +127,61 @@ class Printer {
   _endsWithInnerRaw: boolean = false;
   _indentInnerComments: boolean = true;
 
+  applyInputSourceContents(
+    code: string | { [sourceFileName: string]: string },
+  ): void {
+    const sourceMap = this._buf._map;
+    if (!sourceMap) {
+      return;
+    }
+
+    const generatedMap = sourceMap._map;
+    const inputMap = this._inputMap;
+    const sourceFileName = sourceMap._sourceFileName;
+    const outputRoot = generatedMap.sourceRoot;
+
+    if (inputMap) {
+      const resolvedSources = inputMap.resolvedSources;
+      const sourcesContent = inputMap.sourcesContent;
+      const sources = inputMap.sources;
+      const names = inputMap.names;
+      const file = inputMap.file;
+      const sourceCount = resolvedSources.length;
+      const originalCount = sources == null ? sourceCount : sources.length;
+      const hasNameList = names == null || Array.isArray(names);
+      const hasFileName = file == null || typeof file === "string";
+      const hasOutputRoot = outputRoot == null || typeof outputRoot === "string";
+
+      if (
+        sourceCount > 0 &&
+        originalCount === sourceCount &&
+        hasNameList &&
+        hasFileName &&
+        hasOutputRoot
+      ) {
+        for (let i = 0; i < originalCount; i++) {
+          setSourceContent(
+            generatedMap,
+            resolvedSources[i],
+            sourcesContent[i],
+          );
+        }
+      }
+    }
+
+    if (typeof code === "string" && !inputMap) {
+      setSourceContent(generatedMap, sourceFileName, code);
+    } else if (typeof code === "object") {
+      for (const filename of Object.keys(code)) {
+        setSourceContent(
+          generatedMap,
+          filename.replace(/\\/g, "/"),
+          code[filename],
+        );
+      }
+    }
+  }
+
   generate(ast: t.Node) {
     this.print(ast);
     this._maybeAddAuxComment();
