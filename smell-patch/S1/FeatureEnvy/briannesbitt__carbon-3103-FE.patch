diff --git a/src/Carbon/CarbonTimeZone.php b/src/Carbon/CarbonTimeZone.php
index 974efcbb..83fe01ed 100644
--- a/src/Carbon/CarbonTimeZone.php
+++ b/src/Carbon/CarbonTimeZone.php
@@ -16,6 +16,7 @@ namespace Carbon;
 use Carbon\Exceptions\InvalidCastException;
 use Carbon\Exceptions\InvalidTimeZoneException;
 use Carbon\Traits\LocalFactory;
+use DateTimeImmutable;
 use DateTimeInterface;
 use DateTimeZone;
 use Exception;
@@ -319,4 +320,43 @@ class CarbonTimeZone extends DateTimeZone
 
         return Carbon::now($this);
     }
+
+    /**
+     * @template T of CarbonInterface
+     *
+     * @param T $target
+     * @param T $source
+     *
+     * @return T
+     */
+    public function mutateIfMutable(CarbonInterface $target, CarbonInterface $source): CarbonInterface
+    {
+        $clock = $this->getClock();
+        $className = Carbon::class;
+
+        if ($clock !== null) {
+            $currentClock = $clock->unwrap();
+            $factory = $currentClock instanceof Factory ? $currentClock : $clock->getFactory();
+            $className = $factory->getClassName();
+        }
+
+        $utcSource = $className::instance($source->avoidMutation()->utc());
+        $year = $utcSource->year;
+        $month = $utcSource->month;
+        $day = $utcSource->day;
+        $hour = $utcSource->hour;
+        $minute = $utcSource->minute;
+        $second = $utcSource->second;
+        $micro = $utcSource->micro;
+
+        if ($target instanceof DateTimeImmutable) {
+            return $target;
+        }
+
+        return $target
+            ->setTimezone('UTC')
+            ->setDate($year, $month, $day)
+            ->setTime($hour, $minute, $second, $micro)
+            ->setTimezone($this->getName());
+    }
 }
