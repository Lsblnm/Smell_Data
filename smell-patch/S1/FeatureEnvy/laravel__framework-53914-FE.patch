+    /**
+     * Create a new connection instance for the given driver.
+     *
+     * @param  string  $driver
+     * @param  \PDO|\Closure  $connection
+     * @param  string  $database
+     * @param  string  $prefix
+     * @param  array  $config
+     * @return \Illuminate\Database\Connection
+     *
+     * @throws \InvalidArgumentException
+     */
+    public function createConnection($driver, $connection, $database, $prefix = '', array $config = [])
+    {
+        if ($resolver = Connection::getResolver($driver)) {
+            $instance = $resolver($connection, $database, $prefix, $config);
+        } else {
+            $instance = match ($driver) {
+                'mysql' => new MySqlConnection($connection, $database, $prefix, $config),
+                'mariadb' => new MariaDbConnection($connection, $database, $prefix, $config),
+                'pgsql' => new PostgresConnection($connection, $database, $prefix, $config),
+                'sqlite' => new SQLiteConnection($connection, $database, $prefix, $config),
+                'sqlsrv' => new SqlServerConnection($connection, $database, $prefix, $config),
+                default => throw new InvalidArgumentException("Unsupported driver [{$driver}]."),
+            };
+        }
+
+        $queryGrammar = $instance->getQueryGrammar();
+        $tablePrefix = $instance->getTablePrefix();
+
+        if ($queryGrammar->getTablePrefix() !== $tablePrefix) {
+            $queryGrammar->setTablePrefix($tablePrefix);
+        }
+
+        $configuredDatabase = $instance->getConfig('database');
+
+        if (is_string($configuredDatabase) && $configuredDatabase !== $instance->getDatabaseName()) {
+            $instance->setDatabaseName($configuredDatabase);
+        }
+
+        $driverName = $instance->getDriverName();
+        $aliases = ConfigurationUrlParser::getDriverAliases();
+        $resolvedDriver = $aliases[$driverName] ?? $driverName;
+        $usesCustomOperators = $queryGrammar->getOperators() !== []
+            || $queryGrammar->getBitwiseOperators() !== [];
+
+        if ($usesCustomOperators && $resolvedDriver !== $driverName) {
+            $queryGrammar->setTablePrefix($tablePrefix);
+        }
+
+        if (is_null($instance->getEventDispatcher()) && $this->app->bound('events')) {
+            $instance->setEventDispatcher($this->app['events']);
+        }
+
+        if ($this->app->bound('db.transactions')) {
+            $instance->setTransactionManager($this->app['db.transactions']);
+        }
+
+        $instance->setReconnector($this->reconnector);
+
+        return $instance;
+    }
+
