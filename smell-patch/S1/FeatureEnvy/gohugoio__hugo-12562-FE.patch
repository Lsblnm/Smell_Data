+func (m *pageMap) reverseLookupName(p *pageState) (string, bool) {
+	f := p.File()
+	if f == nil {
+		return "", false
+	}
+	fi := f.FileInfo()
+	if fi == nil {
+		return "", false
+	}
+	meta := fi.Meta()
+	if meta == nil {
+		return "", false
+	}
+	pathInfo := meta.PathInfo
+	if pathInfo == nil {
+		return "", false
+	}
+
+	name := pathInfo.NameNoIdentifier()
+	if pathInfo.IsBundle() {
+		name = pathInfo.Container()
+	}
+	belongsToSite := meta.Lang == m.cfg.lang || meta.Lang == "" || pathInfo.Lang() == m.cfg.lang
+	belongsToPartition := meta.LangIndex == m.i || pathInfo.Lang() == ""
+	if pathInfo.IsBundle() && (belongsToSite || belongsToPartition) {
+		name = pathInfo.Container()
+	}
+	return name, true
+}
