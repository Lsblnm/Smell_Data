+  private Request rebuildRequestAtLeader(Request oldRequest) throws IOException
+  {
+    Iterator<DiscoveryDruidNode> iter = druidNodeDiscovery.getAllNodes().iterator();
+    if (!iter.hasNext()) {
+      currentKnownLeader.set(null);
+      throw new IOE("No known server");
+    }
+
+    DiscoveryDruidNode leaderNode = iter.next();
+    final String leaderBase = StringUtils.format(
+        "%s://%s",
+        leaderNode.getDruidNode().getServiceScheme(),
+        leaderNode.getDruidNode().getHostAndPortToUse()
+    );
+    currentKnownLeader.set(leaderBase);
+
+    final URL oldUrl = oldRequest.getUrl();
+    try {
+      final URL newUrl;
+      if (oldUrl.getQuery() == null) {
+        newUrl = new URL(StringUtils.format("%s%s", leaderBase, oldUrl.getPath()));
+      } else {
+        newUrl = new URL(StringUtils.format(
+            "%s%s?%s",
+            leaderBase,
+            oldUrl.getPath(),
+            oldUrl.getQuery()
+        ));
+      }
+      Request req = new Request(oldRequest.getMethod(), newUrl);
+      req.addHeaderValues(oldRequest.getHeaders());
+      if (oldRequest.hasContent()) {
+        req.setContent(oldRequest.getContent());
+      }
+      return req;
+    }
+    catch (MalformedURLException e) {
+      // Not an IOException; this is our own fault.
+      throw new ISE(
+          e,
+          "failed to build url with path[%] and query string [%s].",
+          oldUrl.getPath(),
+          oldUrl.getQuery()
+      );
+    }
+  }
 }
