@@ -145,6 +145,41 @@ public interface Component2D {
       double cY,
       boolean ca);
 
+  /**
+   * Check whether the given encoded point is within this component. NOTE: this operates directly on
+   * the encoded representation of points.
+   */
+  default boolean testEncodedPoint(
+      GeoEncodingUtils.Component2DPredicate predicate, int lat, int lon) {
+    final int lat2 = ((lat - Integer.MIN_VALUE) >>> predicate.latShift);
+    if (lat2 < predicate.latBase || lat2 >= predicate.latBase + predicate.maxLatDelta) {
+      return false;
+    }
+    int lon2 = ((lon - Integer.MIN_VALUE) >>> predicate.lonShift);
+    if (lon2 < predicate.lonBase) { // wrap
+      lon2 += 1 << (GeoEncodingUtils.BITS - predicate.lonShift);
+    }
+    assert Integer.toUnsignedLong(lon2) >= predicate.lonBase;
+    assert lon2 - predicate.lonBase >= 0;
+    if (lon2 - predicate.lonBase >= predicate.maxLonDelta) {
+      return false;
+    }
+
+    final int relation =
+        predicate.relations[
+            (lat2 - predicate.latBase) * predicate.maxLonDelta + (lon2 - predicate.lonBase)];
+    if (relation == PointValues.Relation.CELL_CROSSES_QUERY.ordinal()) {
+      final double y = GeoEncodingUtils.decodeLatitude(lat);
+      final double x = GeoEncodingUtils.decodeLongitude(lon);
+      if (y < getMinY() || y > getMaxY()) {
+        return false;
+      }
+      return contains(x, y);
+    } else {
+      return relation == PointValues.Relation.CELL_INSIDE_QUERY.ordinal();
+    }
+  }
