@@ -596,4 +606,85 @@ public class JavacResolution {
 	public static boolean platformHasTargetTyping() {
 		return Javac.getJavaCompilerVersion() >= 8;
 	}
+
+	public JCMethodDecl changeModifiersAndGenerateConstructor(JavacNode typeNode, JavacNode errorNode) {
+		JCClassDecl classDecl = (JCClassDecl) typeNode.get();
+		boolean makeConstructor = true;
+		JavacTreeMaker maker = new JavacTreeMaker(TreeMaker.instance(this.context));
+		applyFlag(classDecl.mods, Flags.FINAL);
+		if (shouldMarkStatic(typeNode)) applyFlag(classDecl.mods, Flags.STATIC);
+		for (JavacNode element : typeNode.down()) {
+			if (element.getKind() == Kind.FIELD) {
+				markFieldStatic(element);
+			} else if (element.getKind() == Kind.METHOD) {
+				JCMethodDecl methodDecl = (JCMethodDecl) element.get();
+				if (methodDecl.name.contentEquals("<init>")) {
+					if (isUserDeclaredConstructor(methodDecl)) {
+						element.addError("@UtilityClasses cannot have declared constructors.");
+						makeConstructor = false;
+						continue;
+					}
+				}
+				applyFlag(methodDecl.mods, Flags.STATIC);
+			} else if (element.getKind() == Kind.TYPE) {
+				JCClassDecl innerClassDecl = (JCClassDecl) element.get();
+				applyFlag(innerClassDecl.mods, Flags.STATIC);
+				ClassSymbol innerClassSymbol = innerClassDecl.sym;
+				if (innerClassSymbol != null && innerClassSymbol.type instanceof ClassType) {
+					((ClassType) innerClassSymbol.type).setEnclosingType(Type.noType);
+				}
+			}
+		}
+		return makeConstructor ? createPrivateDefaultConstructor(maker) : null;
+	}
+
+	private boolean shouldMarkStatic(JavacNode typeNode) {
+		boolean markStatic = true;
+		if (typeNode.up().getKind() == Kind.COMPILATION_UNIT) markStatic = false;
+		if (markStatic && typeNode.up().getKind() == Kind.TYPE) {
+			JCClassDecl typeDecl = (JCClassDecl) typeNode.up().get();
+			if ((typeDecl.mods.flags & (Flags.INTERFACE | Flags.ANNOTATION)) != 0) markStatic = false;
+		}
+		return markStatic;
+	}
+
+	private void markFieldStatic(JavacNode element) {
+		JCVariableDecl fieldDecl = (JCVariableDecl) element.get();
+		applyFlag(fieldDecl.mods, Flags.STATIC);
+	}
+
+	private boolean isUserDeclaredConstructor(JCMethodDecl methodDecl) {
+		return JavacAugments.JCTree_generatedNode.get(methodDecl) == null && (methodDecl.mods.flags & Flags.GENERATEDCONSTR) == 0;
+	}
+
+	private void applyFlag(JCModifiers modifiers, long flag) {
+		modifiers.flags |= flag;
+	}
+
+	private JCMethodDecl createPrivateDefaultConstructor(JavacTreeMaker maker) {
+		maker.at(-1);
+		JCModifiers mods = maker.Modifiers(Flags.PRIVATE, List.<JCAnnotation>nil());
+		Name name = JavacElements.instance(this.context).getName("<init>");
+		JCBlock block = maker.Block(0L, createThrowStatement(maker));
+		return maker.MethodDef(mods, name, null, List.<JCTypeParameter>nil(), List.<JCVariableDecl>nil(), List.<JCExpression>nil(), block, null);
+	}
+
+	private List<JCStatement> createThrowStatement(JavacTreeMaker maker) {
+		JCExpression exceptionType = utilityClassExceptionType(maker);
+		List<JCExpression> jceBlank = List.nil();
+		JCExpression message = maker.Literal("This is a utility class and cannot be instantiated");
+		JCExpression exceptionInstance = maker.NewClass(null, jceBlank, exceptionType, List.of(message), null);
+		JCStatement throwStatement = maker.Throw(exceptionInstance);
+		return List.of(throwStatement);
+	}
+
+	private JCExpression utilityClassExceptionType(JavacTreeMaker maker) {
+		JavacElements elements = JavacElements.instance(this.context);
+		if (LombokOptionsFactory.getDelombokOptions(this.context).getFormatPreferences().javaLangAsFqn()) {
+			JCExpression javaIdent = maker.Ident(elements.getName("java"));
+			JCExpression langSelect = maker.Select(javaIdent, elements.getName("lang"));
+			return maker.Select(langSelect, elements.getName("UnsupportedOperationException"));
+		}
+		return maker.Ident(elements.getName("UnsupportedOperationException"));
+	}
 }
