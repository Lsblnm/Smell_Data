@@ -4,11 +4,14 @@ namespace PhpOffice\PhpSpreadsheet\Writer\Ods;
 
 use PhpOffice\PhpSpreadsheet\Calculation\Calculation;
 use PhpOffice\PhpSpreadsheet\DefinedName;
+use PhpOffice\PhpSpreadsheet\Reader\Ods\FormulaTranslator;
 
 class Formula
 {
     private array $definedNames = [];
 
+    private string $addressRegexFlags = 'miu';
+
     /**
      * @param DefinedName[] $definedNames
      */
@@ -116,4 +119,128 @@ class Formula
 
         return $formula;
     }
+
+    public function convertToExcelAddressValue(string $openOfficeAddress): string
+    {
+        $translator = FormulaTranslator::getInstance();
+        $odsSeparator = $translator->getOdsAddressSeparator();
+        $excelSeparator = $translator->getExcelAddressSeparator();
+        $rangeSeparator = $translator->getRangeSeparator();
+        $sheetQuote = $translator->getSheetNameQuote();
+        $absoluteMarker = $translator->getAbsoluteMarker();
+
+        $normalizedName = trim($openOfficeAddress, $sheetQuote);
+        if (
+            in_array($openOfficeAddress, $this->definedNames, true)
+            || in_array($normalizedName, $this->definedNames, true)
+        ) {
+            return $openOfficeAddress;
+        }
+
+        $calculation = Calculation::getInstance();
+        $logger = $calculation->getDebugLog();
+        if ($logger->getWriteDebugLog() || $logger->getEchoDebugLog()) {
+            $logger->writeDebugLog('Converting ODS address %s', $openOfficeAddress);
+        }
+
+        $excelAddress = $openOfficeAddress;
+        $regexFlags = $this->addressRegexFlags;
+        $ods = preg_quote($odsSeparator, '/');
+        $range = preg_quote($rangeSeparator, '/');
+        $absolute = preg_quote($absoluteMarker, '/');
+
+        // Cell range 3-d reference
+        // As we don't support 3-d ranges, we're just going to take a quick and dirty approach
+        //  and assume that the second worksheet reference is the same as the first
+        $excelAddress = (string) preg_replace(
+            [
+                '/' . $absolute . '?([^' . $ods . ']+)' . $ods . '([^' . $ods . ']+)' . $range . $absolute . '?([^' . $ods . ']+)' . $ods . '([^' . $ods . ']+)/' . $regexFlags,
+                '/' . $absolute . '?([^' . $ods . ']+)' . $ods . '([^' . $ods . ']+)' . $range . $ods . '([^' . $ods . ']+)/' . $regexFlags, // Cell range reference in another sheet
+                '/' . $absolute . '?([^' . $ods . ']+)' . $ods . '([^' . $ods . ']+)/' . $regexFlags, // Cell reference in another sheet
+                '/' . $ods . '([^' . $ods . ']+)' . $range . $ods . '([^' . $ods . ']+)/' . $regexFlags, // Cell range reference
+                '/' . $ods . '([^' . $ods . ']+)/' . $regexFlags, // Simple cell reference
+            ],
+            [
+                '$1' . $excelSeparator . '$2' . $rangeSeparator . '$4',
+                '$1' . $excelSeparator . '$2' . $rangeSeparator . '$3',
+                '$1' . $excelSeparator . '$2',
+                '$1' . $rangeSeparator . '$2',
+                '$1',
+            ],
+            $excelAddress
+        );
+
+        return $excelAddress;
+    }
+
+    public function convertToExcelFormulaValue(string $openOfficeFormula): string
+    {
+        $translator = FormulaTranslator::getInstance();
+        $odsSeparator = $translator->getOdsAddressSeparator();
+        $excelSeparator = $translator->getExcelAddressSeparator();
+        $rangeSeparator = $translator->getRangeSeparator();
+
+        $absoluteMarker = $translator->getAbsoluteMarker();
+        $temp = explode(Calculation::FORMULA_STRING_QUOTE, $openOfficeFormula);
+        $tKey = false;
+        $inMatrixBracesLevel = 0;
+        $inFunctionBracesLevel = 0;
+        $regexFlags = $this->addressRegexFlags;
+        $ods = preg_quote($odsSeparator, '/');
+        $range = preg_quote($rangeSeparator, '/');
+        $absolute = preg_quote($absoluteMarker, '/');
+        foreach ($temp as &$value) {
+            // @var string $value
+            // Only replace in alternate array entries (i.e. non-quoted blocks)
+            //      so that conversion isn't done in string values
+            $tKey = $tKey === false;
+            if ($tKey) {
+                $value = (string) preg_replace(
+                    [
+                        '/\[' . $absolute . '?([^' . $ods . ']+)' . $ods . '([^' . $ods . ']+)' . $range . $ods . '([^' . $ods . ']+)\]/' . $regexFlags, // Cell range reference in another sheet
+                        '/\[' . $absolute . '?([^' . $ods . ']+)' . $ods . '([^' . $ods . ']+)\]/' . $regexFlags, // Cell reference in another sheet
+                        '/\[' . $ods . '([^' . $ods . ']+)' . $range . $ods . '([^' . $ods . ']+)\]/' . $regexFlags, // Cell range reference
+                        '/\[' . $ods . '([^' . $ods . ']+)\]/' . $regexFlags, // Simple cell reference
+                    ],
+                    [
+                        '$1' . $excelSeparator . '$2' . $rangeSeparator . '$3',
+                        '$1' . $excelSeparator . '$2',
+                        '$1' . $rangeSeparator . '$2',
+                        '$1',
+                    ],
+                    $value
+                );
+                // Convert references to defined names/formulae
+                $value = str_replace('$$', '', $value);
+
+                // Convert ODS function argument separators to Excel function argument separators
+                $value = Calculation::translateSeparator(';', ',', $value, $inFunctionBracesLevel);
+
+                // Convert ODS matrix separators to Excel matrix separators
+                $value = Calculation::translateSeparator(
+                    ';',
+                    ',',
+                    $value,
+                    $inMatrixBracesLevel,
+                    Calculation::FORMULA_OPEN_MATRIX_BRACE,
+                    Calculation::FORMULA_CLOSE_MATRIX_BRACE
+                );
+                $value = Calculation::translateSeparator(
+                    '|',
+                    ';',
+                    $value,
+                    $inMatrixBracesLevel,
+                    Calculation::FORMULA_OPEN_MATRIX_BRACE,
+                    Calculation::FORMULA_CLOSE_MATRIX_BRACE
+                );
+
+                $value = (string) preg_replace('/COM\.MICROSOFT\./ui', '', $value);
+            }
+        }
+
+        // Then rebuild the formula string
+        $excelFormula = implode('"', $temp);
+
+        return $excelFormula;
+    }
 }
