diff --git a/lib/fluent/plugin/in_tail/position_file.rb b/lib/fluent/plugin/in_tail/position_file.rb
index 88614d28..fa75fa7a 100644
--- a/lib/fluent/plugin/in_tail/position_file.rb
+++ b/lib/fluent/plugin/in_tail/position_file.rb
@@ -248,6 +248,58 @@ module Fluent::Plugin
       end
     end
 
-    TargetInfo = Struct.new(:path, :ino)
+    TargetInfo = Struct.new(:path, :ino) do
+      def current_inode
+        Fluent::FileWrapper.stat(path).ino
+      end
+
+      def start_watcher(plugin)
+        pe = nil
+        pf = plugin.pf
+        logger = plugin.log
+        sys = plugin.system_config
+        if pf
+          pe = pf[self]
+          if sys.log_level && sys.log_level <= Fluent::Log::LEVEL_DEBUG
+            logger.debug "loaded position path=#{self.path} inode=#{pe.read_inode} pos=#{pe.read_pos}"
+          end
+          if plugin.read_from_head && pe.read_inode.zero?
+            begin
+              pe.update(current_inode, 0)
+            rescue Errno::ENOENT
+              $log.warn "#{self.path} not found. Continuing without tailing it."
+            end
+          end
+        end
+
+        begin
+          tw = plugin.setup_watcher(self, pe)
+        rescue WatcherSetupError => e
+          logger.warn "Skip #{self.path} because unexpected setup error happens: #{e}"
+          return
+        end
+
+        return unless tw.pe
+
+        if tw.watchers.empty?
+          logger.warn "Skip #{tw.path} because unexpected setup error happens: no watchers"
+          tw.close
+          return
+        end
+
+        if sys.log_level && sys.log_level <= Fluent::Log::LEVEL_DEBUG
+          logger.debug "start watcher path=#{tw.path} watchers=#{tw.watchers.size} pe=#{tw.pe} target_ino=#{self.ino}"
+        end
+
+        begin
+          updated_target = TargetInfo.new(self.path, current_inode)
+          plugin.tails[updated_target] = tw
+        rescue Errno::ENOENT
+          $log.warn "stat() for #{tw.path} failed with ENOENT. Drop tail watcher for now."
+          # explicitly detach and unwatch watcher `tw`.
+          plugin.stop_watchers(self, immediate: true, unwatched: true)
+        end
+      end
+    end
   end
 end
