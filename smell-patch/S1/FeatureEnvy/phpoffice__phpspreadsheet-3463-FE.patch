 namespace PhpOffice\PhpSpreadsheet\Writer\Xlsx;
 
+use PhpOffice\PhpSpreadsheet\Calculation\Information\ErrorValue;
+use PhpOffice\PhpSpreadsheet\Cell\Cell;
+use PhpOffice\PhpSpreadsheet\Shared\StringHelper;
+use PhpOffice\PhpSpreadsheet\Shared\XMLWriter;
+
 class FunctionPrefix
 {
     const XLFNREGEXP = '/(?:_xlfn\.)?((?:_xlws\.)?('
@@ -159,6 +164,22 @@ class FunctionPrefix
         . '|sort'
         . ')\s*\(/mui';
 
+    /**
+     * @var string
+     */
+    private $xlfnPrefixPattern;
+
+    /**
+     * @var string
+     */
+    private $xlwsPrefixPattern;
+
+    public function __construct()
+    {
+        $this->xlfnPrefixPattern = self::XLFNREGEXP;
+        $this->xlwsPrefixPattern = self::XLWSREGEXP;
+    }
+
     /**
      * Prefix function name in string with _xlfn. where required.
      */
@@ -191,4 +212,75 @@ class FunctionPrefix
     {
         return self::addFunctionPrefix(substr($functionString, 1));
     }
+
+    /**
+     * Write a formula cell, prefixing Excel function names where required.
+     *
+     * @param mixed $writer Parent workbook writer
+     * @param mixed $worksheet Worksheet that owns the cell
+     */
+    public function writeCellFormula(XMLWriter $objWriter, string $cellValue, Cell $cell, $writer, $worksheet): void
+    {
+        $xlfnPrefixPattern = $this->xlfnPrefixPattern;
+        $xlwsPrefixPattern = $this->xlwsPrefixPattern;
+
+        if ($writer->getPreCalculateFormulas()) {
+            $selectedCells = $worksheet->getSelectedCells();
+            $spreadsheet = $worksheet->getParentOrThrow();
+            $activeSheetIndex = $spreadsheet->getActiveSheetIndex();
+            $calculatedValue = $cell->getCalculatedValue();
+            $worksheet->setSelectedCells($selectedCells);
+            $spreadsheet->setActiveSheetIndex($activeSheetIndex);
+        } else {
+            $calculatedValue = $cell->getValue();
+        }
+
+        if (is_string($calculatedValue)) {
+            if (ErrorValue::isError($calculatedValue)) {
+                $objWriter->writeAttribute('t', 'e');
+                $cellIsFormula = substr($cellValue, 0, 1) === '=';
+                if ($cellIsFormula) {
+                    $prefixedFormula = (string) preg_replace(
+                        $xlwsPrefixPattern,
+                        '_xlws.$1(',
+                        (string) preg_replace($xlfnPrefixPattern, '_xlfn.$1(', substr($cellValue, 1))
+                    );
+                    $objWriter->writeElement('f', $prefixedFormula);
+                }
+                $objWriter->writeElement('v', $cellIsFormula ? $calculatedValue : $cellValue);
+
+                return;
+            }
+            $objWriter->writeAttribute('t', 'str');
+            $calculatedValue = StringHelper::controlCharacterPHP2OOXML($calculatedValue);
+        } elseif (is_bool($calculatedValue)) {
+            $objWriter->writeAttribute('t', 'b');
+            $calculatedValue = (int) $calculatedValue;
+        }
+
+        $prefixedFormula = (string) preg_replace(
+            $xlwsPrefixPattern,
+            '_xlws.$1(',
+            (string) preg_replace($xlfnPrefixPattern, '_xlfn.$1(', substr($cellValue, 1))
+        );
+        $attributes = $cell->getFormulaAttributes();
+        if (($attributes['t'] ?? null) === 'array') {
+            $objWriter->startElement('f');
+            $objWriter->writeAttribute('t', 'array');
+            $objWriter->writeAttribute('ref', $cell->getCoordinate());
+            $objWriter->writeAttribute('aca', '1');
+            $objWriter->writeAttribute('ca', '1');
+            $objWriter->text($prefixedFormula);
+            $objWriter->endElement();
+        } else {
+            $objWriter->writeElement('f', $prefixedFormula);
+            if ($writer->getOffice2003Compatibility() === false) {
+                $objWriter->writeElement(
+                    'v',
+                    ($writer->getPreCalculateFormulas() && !is_array($calculatedValue) && substr($calculatedValue ?? '', 0, 1) !== '#')
+                        ? StringHelper::formatNumber($calculatedValue) : '0'
+                );
+            }
+        }
+    }
 }
