 /// A description of an Input source.
 /// This tells bat how to refer to the input.
@@ -187,6 +191,123 @@ impl<'a> Input<'a> {
         &mut self.description
     }
 
+    pub fn resolve_layout<'s>(
+        &self,
+        interactive_output: bool,
+        maybe_term_width: Option<usize>,
+        chop_long_lines: bool,
+        wrap: Option<&str>,
+        style_components: &StyleComponents,
+        paging_never: bool,
+        requested_tab_width: Option<usize>,
+        force_colorization: bool,
+        color: Option<&str>,
+        decorations: Option<&str>,
+        line_ranges: Vec<LineRange>,
+        highlight_ranges: Vec<LineRange>,
+        extra_ignored_suffixes: Vec<&'s str>,
+    ) -> Result<(
+        WrappingMode,
+        usize,
+        bool,
+        LineRanges,
+        HighlightedLineRanges,
+        Vec<&'s str>,
+    )> {
+        let description = self.description();
+        let title = description.title();
+        let kind = description.kind();
+        let summary = description.summary();
+        let mut ignored_suffixes = IgnoredSuffixes::default();
+        let mut suffixes_to_apply = Vec::new();
+        for suffix in extra_ignored_suffixes {
+            let already_known = ignored_suffixes
+                .values
+                .iter()
+                .any(|existing| *existing == suffix);
+            let title_has_suffix = title.ends_with(suffix);
+            let summary_has_suffix = summary.ends_with(suffix);
+            let kind_is_file = kind.map(|value| value.as_str() == "File").unwrap_or(true);
+            if title_has_suffix || summary_has_suffix || kind_is_file || !already_known {
+                if !already_known {
+                    ignored_suffixes.add_suffix(suffix);
+                }
+                suffixes_to_apply.push(suffix);
+            }
+        }
+
+        let stripped_title = ignored_suffixes.strip_suffix(title).unwrap_or(title);
+        let stdin_without_name = self.is_stdin()
+            && stripped_title == "STDIN"
+            && summary == "STDIN";
+
+        let wrapping_mode = if self.is_stdin() && !interactive_output && maybe_term_width.is_none()
+        {
+            WrappingMode::NoWrapping(false)
+        } else if interactive_output || maybe_term_width.is_some() {
+            if !chop_long_lines {
+                match wrap {
+                    Some("character") => WrappingMode::Character,
+                    Some("never") => WrappingMode::NoWrapping(true),
+                    Some("auto") | None => {
+                        if style_components.plain()
+                            || (stdin_without_name && style_components.plain())
+                        {
+                            WrappingMode::NoWrapping(false)
+                        } else {
+                            WrappingMode::Character
+                        }
+                    }
+                    _ => unreachable!("other values for --wrap are not allowed"),
+                }
+            } else {
+                WrappingMode::NoWrapping(true)
+            }
+        } else {
+            WrappingMode::NoWrapping(false)
+        };
+
+        let loop_through = !(interactive_output
+            || color == Some("always")
+            || decorations == Some("always")
+            || force_colorization)
+            && !(self.is_stdin() && interactive_output);
+
+        let tab_width = requested_tab_width.unwrap_or(
+            if style_components.plain() && paging_never {
+                0
+            } else {
+                4
+            },
+        );
+
+        let visible_line_ranges = if line_ranges.len() == 1
+            && line_ranges[0].lower == usize::MIN
+            && line_ranges[0].upper == usize::MAX
+        {
+            LineRanges::all()
+        } else if line_ranges.is_empty() {
+            LineRanges::default()
+        } else {
+            LineRanges::from(line_ranges)
+        };
+
+        let highlighted_lines = if highlight_ranges.is_empty() {
+            HighlightedLineRanges::default()
+        } else {
+            HighlightedLineRanges(LineRanges::from(highlight_ranges))
+        };
+
+        Ok((
+            wrapping_mode,
+            tab_width,
+            loop_through,
+            visible_line_ranges,
+            highlighted_lines,
+            suffixes_to_apply,
+        ))
+    }
+
     pub(crate) fn open<R: BufRead + 'a>(
         self,
         stdin: R,
