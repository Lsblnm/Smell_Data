 package acmeserver
 
 import (
+	"time"
+
 	"github.com/smallstep/certificates/authority/policy"
 	"github.com/smallstep/certificates/authority/provisioner"
+
+	"github.com/caddyserver/caddy/v2"
+	"github.com/caddyserver/caddy/v2/caddyconfig/httpcaddyfile"
+	"github.com/caddyserver/caddy/v2/modules/caddypki"
 )
 
 // Policy defines the criteria for the ACME server
@@ -81,3 +87,94 @@ func (p *Policy) normalizeRules() *provisioner.X509Options {
 		AllowWildcardNames: p.AllowWildcardNames,
 	}
 }
+
+// configureACMEServer reads ACME server options from a Caddyfile and
+// applies them to acmeServer. The receiver is used as the working
+// allow/deny rule set while the surrounding handler, CA, and policy
+// objects are updated in place.
+func (r *RuleSet) configureACMEServer(h httpcaddyfile.Helper, acmeServer *Handler, ca *caddypki.CA) (*caddypki.CA, error) {
+	for h.NextBlock(0) {
+		switch h.Val() {
+		case "ca":
+			if !h.AllArgs(&acmeServer.CA) {
+				return ca, h.ArgErr()
+			}
+			if ca == nil {
+				ca = new(caddypki.CA)
+			}
+			ca.ID = acmeServer.CA
+		case "lifetime":
+			if !h.NextArg() {
+				return ca, h.ArgErr()
+			}
+
+			dur, err := caddy.ParseDuration(h.Val())
+			if err != nil {
+				return ca, err
+			}
+			if d := time.Duration(ca.IntermediateLifetime); d > 0 && dur > d {
+				return ca, h.Errf("certificate lifetime (%s) exceeds intermediate certificate lifetime (%s)", dur, d)
+			}
+			acmeServer.Lifetime = caddy.Duration(dur)
+		case "resolvers":
+			acmeServer.Resolvers = h.RemainingArgs()
+			if len(acmeServer.Resolvers) == 0 {
+				return ca, h.Errf("must specify at least one resolver address")
+			}
+		case "challenges":
+			acmeServer.Challenges = append(acmeServer.Challenges, stringToChallenges(h.RemainingArgs())...)
+		case "allow_wildcard_names":
+			if acmeServer.Policy == nil {
+				acmeServer.Policy = &Policy{}
+			}
+			acmeServer.Policy.AllowWildcardNames = true
+		case "allow":
+			*r = RuleSet{}
+			for h.Next() {
+				for h.NextBlock(h.Nesting() - 1) {
+					if h.CountRemainingArgs() == 0 {
+						return ca, h.ArgErr() // TODO:
+					}
+					switch h.Val() {
+					case "domains":
+						r.Domains = append(r.Domains, h.RemainingArgs()...)
+					case "ip_ranges":
+						r.IPRanges = append(r.IPRanges, h.RemainingArgs()...)
+					default:
+						return ca, h.Errf("unrecognized 'allow' subdirective: %s", h.Val())
+					}
+				}
+			}
+			if acmeServer.Policy == nil {
+				acmeServer.Policy = &Policy{}
+			}
+			allow := *r
+			acmeServer.Policy.Allow = &allow
+		case "deny":
+			*r = RuleSet{}
+			for h.Next() {
+				for h.NextBlock(h.Nesting() - 1) {
+					if h.CountRemainingArgs() == 0 {
+						return ca, h.ArgErr() // TODO:
+					}
+					switch h.Val() {
+					case "domains":
+						r.Domains = append(r.Domains, h.RemainingArgs()...)
+					case "ip_ranges":
+						r.IPRanges = append(r.IPRanges, h.RemainingArgs()...)
+					default:
+						return ca, h.Errf("unrecognized 'deny' subdirective: %s", h.Val())
+					}
+				}
+			}
+			if acmeServer.Policy == nil {
+				acmeServer.Policy = &Policy{}
+			}
+			deny := *r
+			acmeServer.Policy.Deny = &deny
+		default:
+			return ca, h.Errf("unrecognized ACME server directive: %s", h.Val())
+		}
+	}
+	return ca, nil
+}
