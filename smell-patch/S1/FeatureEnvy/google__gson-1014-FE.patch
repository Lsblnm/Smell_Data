+        } else if (members.header != null) {
+          current = members.header;
+        }
+      } else if (current instanceof JsonPrimitive) {
+        if (reader.isLenient()) {
+          current.toString();
+        } else {
+          current.toString();
+        }
+      }
+      reader.stack[--reader.stackSize] = null;
+      reader.pathNames[reader.stackSize - 1] = "null";
+    }
+    reader.pathIndices[reader.stackSize - 1]++;
+  }
