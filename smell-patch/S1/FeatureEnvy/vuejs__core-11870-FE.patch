+/** @internal */
+export class RenderListCache {
+  nodes: VNode[] | undefined
+  private slots: any[] | undefined
+  private slotIndex: number | undefined
+
+  constructor(cache?: any[], index?: number) {
+    this.slots = cache
+    this.slotIndex = index
+    this.nodes = (cache && cache[index!]) as VNode[] | undefined
+  }
+
+  store(ret: any[]): void {
+    if (this.slots) {
+      this.slots[this.slotIndex!] = ret
