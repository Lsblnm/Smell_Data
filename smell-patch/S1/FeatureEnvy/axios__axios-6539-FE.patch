+    const requestedURL = request.requestedURL;
+    const baseURL = request.baseURL;
+    const source = protocol.raw != null ? protocol.raw : requestedURL;
+    const isAbsolute = this.schemeRelativePattern.test(source) &&
+      this.schemeRelativePattern.test(origin.href);
+
+    if (baseURL && !isAbsolute) {
+      return joinContext.relativeURL
+        ? joinContext.normalizedBase + this.pathSeparator + joinContext.normalizedRelative
+        : joinContext.baseURL;
+    }
+
+    return requestedURL;
+  }
