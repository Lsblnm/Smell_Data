+/**
+ * Holds the base and requested URL for a path assembly operation.
+ */
+export class URLRequest {
+  constructor(baseURL, requestedURL) {
+    this.baseURL = baseURL;
+    this.requestedURL = requestedURL;
+  }
+}
+
+/**
+ * Holds the fragments used to join a base URL with a relative URL.
+ */
+export class URLJoinContext {
+  constructor(baseURL, relativeURL) {
+    this.baseURL = baseURL;
+    this.relativeURL = relativeURL;
+  }
+
