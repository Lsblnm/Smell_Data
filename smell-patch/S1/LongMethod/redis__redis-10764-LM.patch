+            timeout_ld = (long)timeoutobj->ptr;
+        } else {
+            serverPanic("Unknown string encoding");
+        }
+    }
+    timeout_ms = (long long) (timeout_ld * 1000.0);
+    if (timeout_ms < 0) {
