+                unsigned char *eptr, *sptr;
+                unsigned char *vstr;
+                unsigned int vlen;
+                long long vlong;
+
+                /* Get the first or last element in the sorted set. */
+                eptr = lpSeek(zl,where == ZSET_MAX ? -2 : 0);
+                serverAssertWithInfo(c,o,eptr != NULL);
+                vstr = lpGetValue(eptr,&vlen,&vlong);
