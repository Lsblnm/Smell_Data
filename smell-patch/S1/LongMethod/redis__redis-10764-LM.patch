+        sds ele;
+        double score;
+
         key = keys[j];
-        o = lookupKeyWrite(c->db,key);
+
+        /* Locate the key for writing, expire it if needed, and refresh LRU/LFU. */
+        de = dictFind(c->db->dict, key->ptr);
