+                    val->lru = (LFUGetTimeInMinutes()<<8) | counter;
+                } else {
+                    val->lru = LRU_CLOCK();
+                }
+            }
+        }
+        o = val;
+
         /* Non-existing key, move to next key. */
         if (o == NULL) continue;
 
