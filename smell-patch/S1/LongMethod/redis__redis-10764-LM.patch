+                    if (server.current_client == server.master) {
+                        /* Keep the key while a replica applies a master command. */
+                    } else if (!force_delete_expired) {
+                        val = NULL;
+                    } else {
+                        if (checkClientPauseTimeoutAndReturnIfPaused()) {
+                            val = NULL;
+                        } else {
+                            deleteExpiredKeyAndPropagate(c->db, key);
+                            val = NULL;
+                        }
+                    }
+                } else {
+                    if (checkClientPauseTimeoutAndReturnIfPaused()) {
+                        val = NULL;
+                    } else {
+                        deleteExpiredKeyAndPropagate(c->db, key);
+                        val = NULL;
+                    }
+                }
+            }
+        }
+        if (val != NULL) {
