 block gen_cond(block cond, block iftrue, block iffalse) {
-  return BLOCK(gen_op_simple(DUP), BLOCK(gen_subexp(cond), gen_op_simple(POP)),
-               gen_condbranch(BLOCK(gen_op_simple(POP), iftrue),
-                              BLOCK(gen_op_simple(POP), iffalse)));
+  block dup_blk;
+  block cond_eval;
+  block pop_after_cond;
+  block true_arm;
+  block false_arm;
+  block jump_end;
+  block jump_false;
+  block assembled;
+  inst *curr;
+  inst *next;
+  inst *created;
+  const struct opcode_description *desc;
+  const struct opcode_description *pushk_desc;
+  const struct opcode_description *jump_desc;
+  const struct opcode_description *jumpf_desc;
+  int cond_len;
+  int cond_loadk;
+  int cond_other;
+  jv kept_constant;
+
+  cond_len = 0;
+  cond_loadk = 0;
+  cond_other = 0;
+  created = NULL;
+  cond_eval = gen_noop();
+
+  for (curr = cond.first; curr != NULL; curr = curr->next) {
+    cond_len++;
+    desc = opcode_describe(curr->op);
+    if (curr->op == LOADK && desc != NULL && (desc->flags & OP_HAS_CONSTANT) != 0) {
+      cond_loadk++;
+    } else {
+      cond_other++;
+    }
+  }
+
+  dup_blk = gen_op_simple(DUP);
+
+  if (cond.first == NULL && cond.last == NULL) {
+    cond_eval = gen_op_simple(DUP);
+  } else if (cond_len == 1 && cond.first != NULL && cond.first == cond.last &&
+             cond.first->op == LOADK && cond_loadk == 1 && cond_other == 0) {
+    kept_constant = jv_copy(cond.first->imm.constant);
+    curr = cond.first;
+    while (curr != NULL) {
+      next = curr->next;
+      if (curr->symbol != NULL) {
+        jv_mem_free(curr->symbol);
+      }
+      if (curr->subfn.first != NULL || curr->subfn.last != NULL) {
+        block_free(curr->subfn);
+      }
+      if (curr->arglist.first != NULL || curr->arglist.last != NULL) {
+        block_free(curr->arglist);
+      }
+      if (curr->locfile != NULL) {
+        locfile_free(curr->locfile);
+      }
+      desc = opcode_describe(curr->op);
+      if (desc != NULL && (desc->flags & OP_HAS_CONSTANT) != 0) {
+        jv_free(curr->imm.constant);
+      }
+      jv_mem_free(curr);
+      curr = next;
+    }
+    pushk_desc = opcode_describe(PUSHK_UNDER);
+    if (pushk_desc != NULL) {
+      if ((pushk_desc->flags & OP_HAS_CONSTANT) != 0) {
+        if (pushk_desc->length == 2) {
+          if (pushk_desc->stack_in == 1) {
+            if (pushk_desc->stack_out == 2) {
+              created = jv_mem_alloc(sizeof(inst));
+              created->next = 0;
+              created->prev = 0;
+              created->op = PUSHK_UNDER;
+              created->bytecode_pos = -1;
+              created->bound_by = 0;
+              created->symbol = 0;
+              created->any_unbound = 0;
+              created->referenced = 0;
+              created->nformals = -1;
+              created->nactuals = -1;
+              created->subfn = gen_noop();
+              created->arglist = gen_noop();
+              created->source = UNKNOWN_LOCATION;
+              created->locfile = 0;
+              created->imm.constant = kept_constant;
+            }
+          }
+        }
+      }
+    }
+    if (created == NULL) {
+      created = inst_new(PUSHK_UNDER);
+      created->imm.constant = kept_constant;
+    }
+    cond_eval = inst_block(created);
+  } else {
+    cond_eval = BLOCK(gen_op_simple(SUBEXP_BEGIN), cond, gen_op_simple(SUBEXP_END));
+  }
+
+  pop_after_cond = gen_op_simple(POP);
+  true_arm = BLOCK(gen_op_simple(POP), iftrue);
+  false_arm = BLOCK(gen_op_simple(POP), iffalse);
+
+  jump_desc = opcode_describe(JUMP);
+  created = inst_new(JUMP);
+  created->bytecode_pos = -1;
+  created->bound_by = 0;
+  created->symbol = 0;
+  created->any_unbound = 0;
+  created->referenced = 0;
+  created->nformals = -1;
+  created->nactuals = -1;
+  if (jump_desc != NULL && (jump_desc->flags & OP_HAS_BRANCH) != 0 && false_arm.last != NULL) {
+    created->imm.target = false_arm.last;
+  } else if (false_arm.last != NULL) {
+    created->imm.target = false_arm.last;
+  }
+  jump_end = inst_block(created);
+  true_arm = block_join(true_arm, jump_end);
+
+  jumpf_desc = opcode_describe(JUMP_F);
+  created = inst_new(JUMP_F);
+  created->bytecode_pos = -1;
+  created->bound_by = 0;
+  created->symbol = 0;
+  created->any_unbound = 0;
+  created->referenced = 0;
+  created->nformals = -1;
+  created->nactuals = -1;
+  if (jumpf_desc != NULL && (jumpf_desc->flags & OP_HAS_BRANCH) != 0 && true_arm.last != NULL) {
+    created->imm.target = true_arm.last;
+  } else if (true_arm.last != NULL) {
+    created->imm.target = true_arm.last;
+  }
+  jump_false = inst_block(created);
+
+  assembled = block_join(dup_blk, cond_eval);
+  assembled = block_join(assembled, pop_after_cond);
+  assembled = block_join(assembled, jump_false);
+  assembled = block_join(assembled, true_arm);
+  assembled = block_join(assembled, false_arm);
+  return assembled;
 }
 
