+static jv add_cli_positional_arg(jv ARGS, jq_util_input_state *input_state,
+                                 const char *arg, int as_string, int as_json,
+                                 int *nfiles) {
+  if (as_string) {
+    int length = 0;
+    const char *text = arg ? arg : "";
+    while (text[length] != '\0') {
+      length++;
+    }
+    const char *end = text + length;
+    if (jvp_utf8_is_valid(text, end)) {
+      int pos = jv_array_length(jv_copy(ARGS));
+      ARGS = jv_array_set(ARGS, pos, jv_string_sized(text, length));
+      return ARGS;
+    }
+    jv built = jv_string_empty(length * 3 + 1);
+    const char *cursor = text;
+    while (cursor < end) {
+      const char *cstart = cursor;
+      int codepoint = -1;
+      unsigned char first = (unsigned char)cursor[0];
+      int seq_len = utf8_coding_length[first];
+      if ((first & 0x80) == 0) {
+        codepoint = first;
+        seq_len = 1;
+      } else if (seq_len == 0 || seq_len == UTF8_CONTINUATION_BYTE) {
+        seq_len = 1;
+      } else if (cursor + seq_len > end) {
+        seq_len = (int)(end - cursor);
+      } else {
+        codepoint = ((unsigned)cursor[0]) & utf8_coding_bits[first];
+        int i = 1;
+        while (i < seq_len) {
+          unsigned ch = (unsigned char)cursor[i];
+          if (utf8_coding_length[ch] != UTF8_CONTINUATION_BYTE) {
+            codepoint = -1;
+            seq_len = i;
+            break;
+          } else {
+            codepoint = (codepoint << 6) | (ch & 0x3f);
+            i++;
+          }
+        }
+        if (codepoint >= 0 && seq_len >= 2 && seq_len <= 4) {
+          if (codepoint < utf8_first_codepoint[seq_len]) {
+            codepoint = -1;
+          } else if (0xD800 <= codepoint && codepoint <= 0xDFFF) {
+            codepoint = -1;
+          } else if (codepoint > 0x10FFFF) {
+            codepoint = -1;
+          }
+        } else if (codepoint >= 0) {
+          codepoint = -1;
+        }
+      }
+      if (seq_len <= 0) {
+        break;
+      }
+      cursor = cstart + seq_len;
+      if (codepoint < 0) {
+        codepoint = 0xFFFD;
+      }
+      if (codepoint <= 0x7F) {
+        char latin[1];
+        latin[0] = (char)codepoint;
+        built = jv_string_append_buf(built, latin, 1);
+      } else if (codepoint <= 0x7FF) {
+        char encoded[2];
+        encoded[0] = (char)(0xC0 + ((codepoint & 0x7C0) >> 6));
+        encoded[1] = (char)(0x80 + (codepoint & 0x03F));
+        built = jv_string_append_buf(built, encoded, 2);
+      } else if (codepoint <= 0xFFFF) {
+        char encoded[3];
+        encoded[0] = (char)(0xE0 + ((codepoint & 0xF000) >> 12));
+        encoded[1] = (char)(0x80 + ((codepoint & 0x0FC0) >> 6));
+        encoded[2] = (char)(0x80 + (codepoint & 0x003F));
+        built = jv_string_append_buf(built, encoded, 3);
+      } else {
+        char encoded[4];
+        int encoded_len = jvp_utf8_encode(codepoint, encoded);
+        if (encoded_len == jvp_utf8_encode_length(codepoint)) {
+          built = jv_string_append_buf(built, encoded, encoded_len);
+        } else {
+          built = jv_string_append_codepoint(built, 0xFFFD);
+        }
+      }
+    }
+    {
+      int pos = jv_array_length(jv_copy(ARGS));
+      ARGS = jv_array_set(ARGS, pos, built);
+    }
+    return ARGS;
+  } else if (as_json) {
+    int length = 0;
+    const char *text = arg ? arg : "";
+    while (text[length] != '\0') {
+      length++;
+    }
+    struct jv_parser *parser = jv_parser_new(0);
+    jv_parser_set_buf(parser, text, length, 0);
+    jv value = jv_parser_next(parser);
+    if (jv_is_valid(value)) {
+      jv extra = jv_parser_next(parser);
+      if (jv_is_valid(extra)) {
+        jv_free(value);
+        jv_free(extra);
+        value = jv_invalid_with_msg(jv_string("Unexpected extra JSON values"));
+      } else if (jv_invalid_has_msg(jv_copy(extra))) {
+        jv_free(value);
+        value = extra;
+      } else {
+        jv_free(extra);
+      }
+    } else if (jv_invalid_has_msg(jv_copy(value))) {
+      /* Preserve the parser error for later wrapping. */
+    } else {
+      jv_free(value);
+      value = jv_invalid_with_msg(jv_string("Expected JSON value"));
+    }
+    jv_parser_free(parser);
+    if (!jv_is_valid(value) && jv_invalid_has_msg(jv_copy(value))) {
+      jv msg = jv_invalid_get_msg(value);
+      value = jv_invalid_with_msg(jv_string_fmt("%s (while parsing '%s')",
+                                                jv_string_value(msg),
+                                                text));
+      jv_free(msg);
+    }
+    {
+      int pos = jv_array_length(jv_copy(ARGS));
+      ARGS = jv_array_set(ARGS, pos, value);
+    }
+    return ARGS;
+  }
+
+  jq_util_input_add_input(input_state, arg);
+  *nfiles = *nfiles + 1;
+  return ARGS;
+}
+
