 import escapeStringRegexp from 'escape-string-regexp';
+import {removePrefix} from './jsUtils';
 
 export function escapeRegexp(string: string): string {
   return escapeStringRegexp(string);
 }
+
+export function createMarkdownFencePattern(): RegExp {
+  const backtick = escapeRegexp('`');
+  const tilde = escapeRegexp('~');
+  return new RegExp(`^(?<fence>${backtick}{3,}|${tilde}{3,})(?<rest>.*)`);
+}
+
+export type CodeFence = {
+  type: '`' | '~';
+  definitelyOpen: boolean;
+  count: number;
+};
+
+export function parseCodeFence(line: string): CodeFence | null {
+  const trimmedLine = line.trim();
+  const match = trimmedLine.match(createMarkdownFencePattern());
+  if (!match) {
+    return null;
+  }
+  const fence = match.groups!.fence!;
+  const rest = removePrefix(trimmedLine, fence);
+  return {
+    type: fence[0]! as '`' | '~',
+    definitelyOpen: rest.length > 0,
+    count: fence.length,
+  };
+}
