@@ -482,3 +482,26 @@ func (d *Dispenser) isNextOnNewLine() bool {
 	next := d.tokens[d.cursor+1]
 	return isNextOnNewLine(curr, next)
 }
+
+func completeLexerToken(tok *Token, val []rune, quoted rune, marker string) {
+	applyLexerTokenText(tok, val)
+	tok.wasQuoted = quoted
+	tok.heredocMarker = marker
+}
+
+func lexerIsQuotedMode(quoted, btQuoted bool) bool {
+	if quoted {
+		return true
+	}
+	return btQuoted
+}
+
+func lexerClosesQuoted(ch rune, quoted, btQuoted bool) bool {
+	if quoted {
+		return ch == '"'
+	}
+	if btQuoted {
+		return ch == '`'
+	}
+	return false
+}
