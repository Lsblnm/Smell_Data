index 82581a3d..3d8cb66a 100644
--- a/caddyconfig/caddyfile/formatter.go
+++ b/caddyconfig/caddyfile/formatter.go
@@ -17,7 +17,10 @@ package caddyfile
 import (
 	"bytes"
 	"io"
+	"strings"
 	"unicode"
+
+	"github.com/caddyserver/caddy/v2"
 )
 
 // Format formats the input Caddyfile to a standard, nice-looking
@@ -217,3 +220,24 @@ func Format(input []byte) []byte {
 	// newlines are significant to the syntax of the file
 	return append(trimmedResult, '\n')
 }
+
+func stringifyLexerValue(val []rune) string {
+	return caddy.ToString(val)
+}
+
+func stripLexerCarriageReturns(s string) string {
+	if strings.IndexByte(s, '\r') < 0 {
+		return s
+	}
+	return strings.ReplaceAll(s, "\r", "")
+}
+
+func lexerStartsEscape(ch rune, escaped, btQuoted bool) bool {
+	if escaped {
+		return false
+	}
+	if btQuoted {
+		return false
+	}
+	return ch == '\\'
+}
