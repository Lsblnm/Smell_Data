@@ -94,6 +94,15 @@ func (sa LoggableStringArray) MarshalLogArray(enc zapcore.ArrayEncoder) error {
 	return nil
 }
 
+// HTTPRequest returns a request whose Cookie header is populated from sa so
+// cookie values can be parsed with the standard HTTP request helpers.
+func (sa LoggableStringArray) HTTPRequest() *http.Request {
+	cookieHeader := append([]string(nil), sa...)
+	req := &http.Request{Header: http.Header{"Cookie": cookieHeader}}
+	NewTestReplacer(req)
+	return req
+}
