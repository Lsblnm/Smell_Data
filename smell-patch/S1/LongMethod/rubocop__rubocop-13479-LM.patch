--- a/lib/rubocop/cop/layout/leading_comment_space.rb
+++ b/lib/rubocop/cop/layout/leading_comment_space.rb
@@ -92,19 +92,136 @@ module RuboCop
 
         MSG = 'Missing space after `#`.'
 
-        def on_new_investigation # rubocop:disable Metrics/AbcSize, Metrics/CyclomaticComplexity, Metrics/PerceivedComplexity
-          processed_source.comments.each do |comment|
-            next unless /\A(?!#\+\+|#--)(#+[^#\s=])/.match?(comment.text)
-            next if comment.loc.line == 1 && allowed_on_first_line?(comment)
-            next if doxygen_comment_style?(comment)
-            next if gemfile_ruby_comment?(comment)
-            next if rbs_inline_annotation?(comment)
-            next if steep_annotation?(comment)
-
-            add_offense(comment) do |corrector|
-              expr = comment.source_range
-
-              corrector.insert_after(hash_mark(expr), ' ')
+        def on_new_investigation # rubocop:disable Metrics/AbcSize, Metrics/CyclomaticComplexity, Metrics/PerceivedComplexity, Metrics/MethodLength
+          source = processed_source
+          comments = source.comments
+          source_buffer = source.buffer
+          file_path = source.file_path
+          rackup_file = false
+          gemfile_source = false
+          resolved_path = file_path
+          file_basename = nil
+          relative_path = nil
+
+          if file_path
+            if PathUtil.absolute?(file_path)
+              relative_path = PathUtil.relative_path(file_path)
+              if relative_path
+                if relative_path.empty?
+                  resolved_path = file_path
+                else
+                  resolved_path = relative_path
+                end
+              else
+                resolved_path = file_path
+              end
+            else
+              resolved_path = file_path
+            end
+            file_basename = File.basename(resolved_path)
+            rackup_name = 'config.ru'
+            gemfile_name = 'Gemfile'
+            rackup_file = file_basename.eql?(rackup_name)
+            gemfile_source = file_basename.eql?(gemfile_name)
+          end
+
+          badge = self.class.badge
+          department_name = badge.department_name
+          cop_name = badge.to_s
+          department_config = @config[department_name]
+          cop_settings = @config.for_cop(cop_name)
+          if department_config
+            cop_settings = department_config.merge(cop_settings)
+          end
+
+          doxygen_key = 'AllowDoxygenCommentStyle'
+          gemfile_key = 'AllowGemfileRubyComment'
+          rbs_key = 'AllowRBSInlineAnnotation'
+          steep_key = 'AllowSteepAnnotation'
+          allow_doxygen = cop_settings && cop_settings[doxygen_key]
+          allow_gemfile_ruby = cop_settings && cop_settings[gemfile_key]
+          allow_rbs = cop_settings && cop_settings[rbs_key]
+          allow_steep = cop_settings && cop_settings[steep_key]
+
+          comments.each do |comment|
+            text = comment.text
+            loc = comment.loc
+            line = loc.line
+            if text
+              comment_length = text.length
+              if comment_length.positive? && /\A(?!#\+\+|#--)(#+[^#\s=])/.match?(text)
+                skipped = false
+                if line == 1
+                  if text.start_with?('#!')
+                    skipped = true
+                  elsif rackup_file
+                    if text.start_with?('#\\')
+                      skipped = true
+                    end
+                  end
+                end
+
+                unless skipped
+                  if allow_doxygen
+                    if text.start_with?('#*')
+                      skipped = true
+                    end
+                  end
+                end
+
+                unless skipped
+                  if allow_gemfile_ruby
+                    if gemfile_source
+                      if text.start_with?('#ruby')
+                        skipped = true
+                      end
+                    end
+                  end
+                end
+
+                unless skipped
+                  if allow_rbs
+                    if text.start_with?(/#:|#\[.+\]/)
+                      skipped = true
+                    end
+                  end
+                end
+
+                unless skipped
+                  if allow_steep
+                    if text.start_with?(/#[$:]/)
+                      skipped = true
+                    end
+                  end
+                end
+
+                unless skipped
+                  expr = comment.source_range
+                  if expr
+                    hash_begin = expr.begin_pos
+                    hash_end = hash_begin + 1
+                    if source_buffer
+                      buffer_source = source_buffer.source
+                      hash_char = buffer_source[hash_begin]
+                      if hash_end <= expr.end_pos && hash_char == '#'
+                        hash_range = Parser::Source::Range.new(source_buffer, hash_begin, hash_end)
+                        add_offense(comment) do |corrector|
+                          corrector.insert_after(hash_range, ' ')
+                        end
+                      else
+                        hash_range = range_between(hash_begin, hash_end)
+                        add_offense(comment) do |corrector|
+                          corrector.insert_after(hash_range, ' ')
+                        end
+                      end
+                    else
+                      add_offense(comment) do |corrector|
+                        corrector.insert_after(hash_mark(expr), ' ')
+                      end
+                    end
+                  end
+                end
+              end
             end
           end
         end
