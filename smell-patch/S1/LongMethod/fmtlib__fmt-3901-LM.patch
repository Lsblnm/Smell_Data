diff --git a/include/fmt/format.h b/include/fmt/format.h
index a4a07899..267be618 100644
--- a/include/fmt/format.h
+++ b/include/fmt/format.h
@@ -4126,13 +4126,154 @@ template <typename T> struct formatter<group_digits_view<T>> : formatter<T> {
   auto format(group_digits_view<T> t, FormatContext& ctx) const
       -> decltype(ctx.out()) {
     auto specs = specs_;
-    detail::handle_dynamic_spec<detail::width_checker>(specs.width,
-                                                       specs.width_ref, ctx);
-    detail::handle_dynamic_spec<detail::precision_checker>(
-        specs.precision, specs.precision_ref, ctx);
-    return detail::write_int(ctx.out(),
-                             static_cast<detail::uint64_or_128_t<T>>(t.value),
-                             0, specs, detail::digit_grouping<char>("\3", ","));
+    auto out = ctx.out();
+    if (specs.width_ref.kind != detail::arg_id_kind::none) {
+      auto width_arg = specs.width_ref.kind == detail::arg_id_kind::index
+                           ? ctx.arg(specs.width_ref.val.index)
+                           : ctx.arg(specs.width_ref.val.name);
+      if (!width_arg) {
+        FMT_THROW(format_error("argument not found"));
+      }
+      unsigned long long width_value =
+          width_arg.visit(detail::width_checker());
+      if (width_value > detail::to_unsigned(detail::max_value<int>())) {
+        FMT_THROW(format_error("number is too big"));
+      }
+      specs.width = static_cast<int>(width_value);
+    }
+    if (specs.precision_ref.kind != detail::arg_id_kind::none) {
+      auto precision_arg =
+          specs.precision_ref.kind == detail::arg_id_kind::index
+              ? ctx.arg(specs.precision_ref.val.index)
+              : ctx.arg(specs.precision_ref.val.name);
+      if (!precision_arg) {
+        FMT_THROW(format_error("argument not found"));
+      }
+      unsigned long long precision_value =
+          precision_arg.visit(detail::precision_checker());
+      if (precision_value > detail::to_unsigned(detail::max_value<int>())) {
+        FMT_THROW(format_error("number is too big"));
+      }
+      specs.precision = static_cast<int>(precision_value);
+    }
+    auto abs_value = static_cast<detail::uint64_or_128_t<T>>(t.value);
+    unsigned prefix = 0;
+    if (specs.type != presentation_type::chr) {
+      if (specs.type == presentation_type::none ||
+          specs.type == presentation_type::dec) {
+        auto count_n = abs_value;
+        int num_digits = 1;
+        for (;;) {
+          if (count_n < 10) {
+            break;
+          }
+          if (count_n < 100) {
+            num_digits += 1;
+            break;
+          }
+          if (count_n < 1000) {
+            num_digits += 2;
+            break;
+          }
+          if (count_n < 10000) {
+            num_digits += 3;
+            break;
+          }
+          count_n /= 10000u;
+          num_digits += 4;
+        }
+        char digit_data[detail::digits10<detail::uint64_or_128_t<T>>() + 2] =
+            {};
+        char* ptr = digit_data + num_digits;
+        auto format_n = abs_value;
+        while (format_n >= 100) {
+          ptr -= 2;
+          detail::copy2(
+              ptr, detail::digits2(static_cast<size_t>(format_n % 100)));
+          format_n /= 100;
+        }
+        if (format_n < 10) {
+          *--ptr = static_cast<char>('0' + format_n);
+        } else {
+          ptr -= 2;
+          detail::copy2(ptr, detail::digits2(static_cast<size_t>(format_n)));
+        }
+        int sep_positions[64];
+        int sep_len = 1;
+        sep_positions[0] = 0;
+        int pos = 0;
+        const char grouping_spec[] = "\3";
+        const char thousands_sep[] = ",";
+        const char* group = grouping_spec;
+        const char* group_end = grouping_spec + 1;
+        for (;;) {
+          int next_pos;
+          if (group == group_end) {
+            pos += grouping_spec[0];
+            next_pos = pos;
+          } else if (*group <= 0 || *group == detail::max_value<char>()) {
+            next_pos = detail::max_value<int>();
+          } else {
+            pos += *group++;
+            next_pos = pos;
+          }
+          if (next_pos >= num_digits || next_pos <= 0) {
+            break;
+          }
+          sep_positions[sep_len++] = next_pos;
+        }
+        unsigned prefix_size = prefix != 0 ? prefix >> 24 : 0;
+        unsigned grouped_size = prefix_size + detail::to_unsigned(num_digits) +
+                                detail::to_unsigned(sep_len - 1);
+        unsigned spec_width = detail::to_unsigned(specs.width);
+        size_t padding =
+            spec_width > grouped_size ? spec_width - grouped_size : 0;
+        auto* shifts = "\x00\x1f\x00\x01";
+        size_t left_padding = padding >> shifts[specs.align];
+        size_t right_padding = padding - left_padding;
+        auto it = detail::reserve(
+            out, grouped_size + padding * specs.fill.size());
+        if (left_padding != 0) {
+          auto fill_size = specs.fill.size();
+          for (size_t n = 0; n < left_padding; ++n) {
+            if (fill_size == 1) {
+              *it++ = specs.fill.template get<char>();
+            } else {
+              const char* fill_data = specs.fill.template data<char>();
+              if (fill_data != nullptr) {
+                size_t copied = 0;
+                while (copied < fill_size) {
+                  *it++ = static_cast<char>(fill_data[copied]);
+                  ++copied;
+                }
+              }
+            }
+          }
+        }
+        for (unsigned p = prefix & 0xffffff; p != 0; p >>= 8) {
+          *it++ = static_cast<char>(p & 0xff);
+        }
+        int sep_index = sep_len - 1;
+        for (int i = 0; i < num_digits; ++i) {
+          if (num_digits - i == sep_positions[sep_index]) {
+            const char* sep_begin = thousands_sep;
+            const char* sep_end = thousands_sep + 1;
+            while (sep_begin != sep_end) {
+              *it++ = static_cast<char>(*sep_begin++);
+            }
+            --sep_index;
+          }
+          *it++ = static_cast<char>(digit_data[detail::to_unsigned(i)]);
+        }
+        if (right_padding != 0) {
+          it = detail::fill<char>(it, right_padding, specs.fill);
+        }
+        return detail::base_iterator(out, it);
+      }
+      return detail::write_int(out, abs_value, prefix, specs,
+                               detail::digit_grouping<char>("\3", ","));
+    }
+    return detail::write_char<char>(out, static_cast<char>(abs_value), specs);
   }
 };
 
