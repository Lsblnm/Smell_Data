+        def unwrap_begin(node)
+          return node unless node
+
+          current = node
+          grouped = Parentheses.grouping_range?(current)
+
+          if current.begin_type? && grouped && current.children.size == 1
+            child = current.children.first
+            return unwrap_begin(child) if child
+          end
+
+          current
+        end
