diff --git a/lib/rubocop/cop/mixin/parentheses.rb b/lib/rubocop/cop/mixin/parentheses.rb
index adea8f614..875fc4d61 100644
--- a/lib/rubocop/cop/mixin/parentheses.rb
+++ b/lib/rubocop/cop/mixin/parentheses.rb
@@ -4,6 +4,32 @@ module RuboCop
   module Cop
     # Common functionality for handling parentheses.
     module Parentheses
+      def self.grouping_range?(node)
+        return false unless node
+
+        range = node.source_range
+        return false unless range
+
+        source = range.source
+        return false if source.nil? || source.empty?
+
+        if range.single_line?
+          stripped = source.strip
+          if stripped.start_with?('(')
+            stripped.end_with?(')')
+          else
+            false
+          end
+        else
+          stripped = source.strip
+          if stripped.start_with?('(')
+            stripped.end_with?(')')
+          else
+            false
+          end
+        end
+      end
+
       private
 
       def parens_required?(node)
