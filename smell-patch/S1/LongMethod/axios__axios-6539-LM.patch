  * @returns {boolean} True if the specified URL is absolute, otherwise false
  */
 export default function isAbsoluteURL(url) {
+  const alpha = utils.ALPHABET.ALPHA;
+  const alphaUpper = alpha.toUpperCase();
+  const digits = utils.ALPHABET.DIGIT;
+  const extraSchemeChars = '+-.';
+  const schemeLetters = alpha + alphaUpper;
+  const schemeCharset = schemeLetters + digits + extraSchemeChars;
+  const authorityDelimiter = '://';
+  const delimiterLength = authorityDelimiter.length;
+  const knownProtocols = platform.protocols;
+  const runtimeOrigin = platform.origin;
+  const originProtocol = parseProtocol(runtimeOrigin);
+  let source;
+
+  if (utils.isString(url)) {
+    source = url;
+  } else {
+    if (utils.isUndefined(url)) {
+      source = String(url);
+    } else {
+      source = String(url);
+    }
+  }
+
+  const length = source.length;
+
+  if (length < 2) {
+    return false;
+  }
+
+  let leadingSlashCount = 0;
+  let slashIndex = 0;
+
+  while (slashIndex < length) {
+    const current = source.charAt(slashIndex);
+
+    if (current === '/') {
+      leadingSlashCount += 1;
+      slashIndex += 1;
+
+      if (leadingSlashCount >= 2) {
+        break;
+      }
+    } else {
+      break;
+    }
+  }
+
   // A URL is considered absolute if it begins with "<scheme>://" or "//" (protocol-relative URL).
   // RFC 3986 defines scheme name as a sequence of characters beginning with a letter and followed
   // by any combination of letters, digits, plus, period, or hyphen.
-  return /^([a-z][a-z\d+\-.]*:)?\/\//i.test(url);
+  if (leadingSlashCount >= 2) {
+    return true;
+  }
+
+  if (leadingSlashCount === 1) {
+    return false;
+  }
+
+  const parsedProtocol = parseProtocol(source);
+  const protocolLength = parsedProtocol.length;
+  const firstChar = source.charAt(0);
+  const firstIsLetter = schemeLetters.indexOf(firstChar) !== -1;
+  const protocolCandidates = knownProtocols.slice();
+
+  protocolCandidates.push(originProtocol);
+
+  if (protocolLength > 0) {
+    const protocolFirst = parsedProtocol.charAt(0);
+    let schemeIsValid = schemeLetters.indexOf(protocolFirst) !== -1;
+    let schemeIndex = 1;
+
+    while (schemeIndex < protocolLength) {
+      const schemeChar = parsedProtocol.charAt(schemeIndex);
+      const allowedChar = schemeCharset.indexOf(schemeChar) !== -1;
+
+      if (allowedChar) {
+        schemeIndex += 1;
+      } else {
+        schemeIsValid = false;
+        break;
+      }
+    }
+
+    if (schemeIsValid) {
+      const colonPos = protocolLength;
+      const slash1Pos = colonPos + 1;
+      const slash2Pos = colonPos + 2;
+      const hasRoomForDelimiter = length >= protocolLength + delimiterLength;
+
+      if (hasRoomForDelimiter) {
+        const colonChar = source.charAt(colonPos);
+        const slash1Char = source.charAt(slash1Pos);
+        const slash2Char = source.charAt(slash2Pos);
+
+        if (colonChar === ':' && slash1Char === '/' && slash2Char === '/') {
+          const schemeLower = parsedProtocol.toLowerCase();
+          let knownIndex = 0;
+          let matchedKnownProtocol = false;
+
+          while (knownIndex < protocolCandidates.length) {
+            const candidate = protocolCandidates[knownIndex];
+            const candidateLower = String(candidate).toLowerCase();
+
+            if (candidateLower === schemeLower) {
+              matchedKnownProtocol = true;
+            }
+
+            knownIndex += 1;
+          }
+
+          if (matchedKnownProtocol) {
+            return true;
+          }
+
+          return parsedProtocol.length > 0;
+        }
+      }
+    }
+  }
+
+  if (!firstIsLetter) {
+    return false;
+  }
+
+  let index = 1;
+  let scannedScheme = firstChar;
+  let schemeIsValid = true;
+
+  while (index < length) {
+    const schemeChar = source.charAt(index);
+    const isColon = schemeChar === ':';
+
+    if (isColon) {
+      const slash1Pos = index + 1;
+      const slash2Pos = index + 2;
+      const hasRoomForDelimiter = slash2Pos < length;
+
+      if (hasRoomForDelimiter) {
+        const slash1Char = source.charAt(slash1Pos);
+        const slash2Char = source.charAt(slash2Pos);
+
+        if (slash1Char === '/' && slash2Char === '/') {
+          if (schemeIsValid) {
+            return scannedScheme.length > 0;
+          }
+        }
+      }
+
+      return false;
+    }
+
+    const allowedChar = schemeCharset.indexOf(schemeChar) !== -1;
+
+    if (allowedChar) {
+      scannedScheme += schemeChar;
+      index += 1;
+    } else {
+      schemeIsValid = false;
+      break;
+    }
+  }
+
+  return false;
 }
