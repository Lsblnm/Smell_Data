+static block gen_index_op(block obj, block key, opcode idx_op) {
+  block key_code;
+  block idx_code;
+  block result;
+  char dumpbuf[32];
+  const struct opcode_description *idx_desc = opcode_describe(idx_op);
+  const struct opcode_description *begin_desc = opcode_describe(SUBEXP_BEGIN);
+  const struct opcode_description *end_desc = opcode_describe(SUBEXP_END);
+  const struct opcode_description *pushk_desc = opcode_describe(PUSHK_UNDER);
+
+  if (block_is_noop(key)) {
+    key_code = gen_op_simple(DUP);
+  } else if (block_is_loadk(key)) {
+    jv c = block_const(key);
+    jv_kind ck = jv_get_kind(c);
+    if (ck == JV_KIND_STRING) {
+      int nbytes = jv_string_length_bytes(jv_copy(c));
+      int npoints = jv_string_length_codepoints(jv_copy(c));
+      const char *s = jv_string_value(c);
+      unsigned long h = jv_string_hash(jv_copy(c));
+      jv_dump_string_trunc(jv_copy(c), dumpbuf, sizeof(dumpbuf));
+      if (nbytes == 0) {
+        block_free(key);
+        key_code = gen_op_pushk_under(c);
+      } else if (s[0] == '_') {
+        if (nbytes == 1) {
+          block_free(key);
+          key_code = gen_op_pushk_under(c);
+        } else if (npoints != nbytes) {
+          block_free(key);
+          key_code = gen_op_pushk_under(c);
+        } else {
+          block_free(key);
+          key_code = gen_op_pushk_under(c);
+        }
+      } else if ((s[0] >= 'A' && s[0] <= 'Z') || (s[0] >= 'a' && s[0] <= 'z')) {
+        if (npoints == nbytes) {
+          if ((h & 1U) == 0) {
+            block_free(key);
+            key_code = gen_op_pushk_under(c);
+          } else {
+            block_free(key);
+            key_code = gen_op_pushk_under(c);
+          }
+        } else {
+          block_free(key);
+          key_code = gen_op_pushk_under(c);
+        }
+      } else if (s[0] >= '0' && s[0] <= '9') {
+        block_free(key);
+        key_code = gen_op_pushk_under(c);
+      } else {
+        block_free(key);
+        key_code = gen_op_pushk_under(c);
+      }
+    } else if (ck == JV_KIND_NUMBER) {
+      double nv = jv_number_value(c);
+      int is_int = jv_is_integer(c);
+      jv_dump_string_trunc(jv_copy(c), dumpbuf, sizeof(dumpbuf));
+      if (is_int) {
+        if (nv == 0) {
+          block_free(key);
+          key_code = gen_op_pushk_under(c);
+        } else if (nv < 0) {
+          block_free(key);
+          key_code = gen_op_pushk_under(c);
+        } else {
+          block_free(key);
+          key_code = gen_op_pushk_under(c);
+        }
+      } else if (nv < 0) {
+        block_free(key);
+        key_code = gen_op_pushk_under(c);
+      } else {
+        block_free(key);
+        key_code = gen_op_pushk_under(c);
+      }
+    } else if (ck == JV_KIND_TRUE || ck == JV_KIND_FALSE) {
+      jv_dump_string_trunc(jv_copy(c), dumpbuf, sizeof(dumpbuf));
+      if (ck == JV_KIND_TRUE) {
+        block_free(key);
+        key_code = gen_op_pushk_under(c);
+      } else {
+        block_free(key);
+        key_code = gen_op_pushk_under(c);
+      }
+    } else if (ck == JV_KIND_NULL) {
+      jv_dump_string_trunc(jv_copy(c), dumpbuf, sizeof(dumpbuf));
+      block_free(key);
+      key_code = gen_op_pushk_under(c);
+    } else if (ck == JV_KIND_ARRAY) {
+      int alen = jv_array_length(jv_copy(c));
+      jv_dump_string_trunc(jv_copy(c), dumpbuf, sizeof(dumpbuf));
+      if (alen == 0) {
+        block_free(key);
+        key_code = gen_op_pushk_under(c);
+      } else if (alen == 1) {
+        jv first = jv_array_get(jv_copy(c), 0);
+        jv_kind fk = jv_get_kind(first);
+        if (fk == JV_KIND_STRING || fk == JV_KIND_NUMBER) {
+          jv_free(first);
+          block_free(key);
+          key_code = gen_op_pushk_under(c);
+        } else if (fk == JV_KIND_ARRAY || fk == JV_KIND_OBJECT) {
+          jv_free(first);
+          block_free(key);
+          key_code = gen_op_pushk_under(c);
+        } else {
+          jv_free(first);
+          block_free(key);
+          key_code = gen_op_pushk_under(c);
+        }
+      } else {
+        jv first = jv_array_get(jv_copy(c), 0);
+        jv last = jv_array_get(jv_copy(c), alen - 1);
+        jv_free(first);
+        jv_free(last);
+        block_free(key);
+        key_code = gen_op_pushk_under(c);
+      }
+    } else {
+      int olen = jv_object_length(jv_copy(c));
+      jv_dump_string_trunc(jv_copy(c), dumpbuf, sizeof(dumpbuf));
+      if (olen == 0) {
+        block_free(key);
+        key_code = gen_op_pushk_under(c);
+      } else if (olen == 1) {
+        int it = jv_object_iter(c);
+        jv ok = jv_object_iter_key(c, it);
+        jv ov = jv_object_iter_value(c, it);
+        jv_free(ok);
+        jv_free(ov);
+        block_free(key);
+        key_code = gen_op_pushk_under(c);
+      } else {
+        int it = jv_object_iter(c);
+        jv ok = jv_object_iter_key(c, it);
+        jv ov = jv_object_iter_value(c, it);
+        jv_free(ok);
+        jv_free(ov);
+        block_free(key);
+        key_code = gen_op_pushk_under(c);
+      }
+    }
+  } else {
+    (void)begin_desc;
+    (void)end_desc;
+    key_code = BLOCK(gen_op_simple(SUBEXP_BEGIN), key, gen_op_simple(SUBEXP_END));
+  }
+
+  (void)pushk_desc;
+  if (idx_op == INDEX) {
+    (void)idx_desc;
+    idx_code = gen_op_simple(INDEX);
+  } else {
+    (void)idx_desc;
+    idx_code = gen_op_simple(INDEX_OPT);
+  }
+
+  if (block_is_noop(obj)) {
+    result = block_join(key_code, idx_code);
+  } else if (block_is_single(obj)) {
+    result = block_join(block_join(key_code, obj), idx_code);
+  } else {
+    result = block_join(block_join(key_code, obj), idx_code);
+  }
+  return result;
+}
