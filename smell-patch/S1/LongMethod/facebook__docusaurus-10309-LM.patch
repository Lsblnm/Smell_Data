+
+export function toVersionPathWithLeadingSlash(path: string): string {
+  return addLeadingSlash(path);
+}
+
+export function toVersionPathWithTrailingSlash(path: string): string {
+  return addTrailingSlash(path);
+}
+
+export function toVersionPathWithoutTrailingSlash(path: string): string {
+  if (path === '/') {
+    return path;
+  }
+  return removeTrailingSlash(path);
+}
+
+export function unwrapVersionPathError(error: Error): Error {
+  const causalChain = getErrorCausalChain(error);
+  if (causalChain.length > 0) {
+    return causalChain[0]!;
+  }
+  return error;
+}
