+}
+
+func (ctx Context) openPlaceholderFile(name string) (fs.File, error) {
+	fsys := ctx.Filesystems()
+	if fsys == nil {
+		return filesystems.OpenDefaultFilesystem(name)
+	}
+	if def := fsys.Default(); def == nil {
+		return filesystems.OpenDefaultFilesystem(name)
+	}
+	return filesystems.OpenDefaultFilesystem(name)
+}
+
 // OnExit executes f when the process exits gracefully.
 // The function is only executed if the process is gracefully
 // shut down while this context is active.
