diff --git a/lib/jekyll/filters/grouping_filters.rb b/lib/jekyll/filters/grouping_filters.rb
index c9cdc6544..df3870818 100644
--- a/lib/jekyll/filters/grouping_filters.rb
+++ b/lib/jekyll/filters/grouping_filters.rb
@@ -42,6 +42,31 @@ module Jekyll
 
       private
 
+      CONDITION_COMPARISON_OPERATORS = %w(== != <> < > >= <= contains).freeze
+      CONDITION_BOOLEAN_OPERATORS = %w(and or).freeze
+
+      def condition_operator_kind(token)
+        text = token.to_s
+        if CONDITION_BOOLEAN_OPERATORS.include?(text)
+          :boolean
+        else
+          :comparison
+        end
+      end
+
+      def canonical_condition_operator(token)
+        return token if token.nil?
+
+        text = token.to_s
+        CONDITION_COMPARISON_OPERATORS.each do |operator|
+          return operator if operator == text
+        end
+        CONDITION_BOOLEAN_OPERATORS.each do |operator|
+          return operator if operator == text
+        end
+        text
+      end
+
       def parse_expression(str)
         Liquid::Variable.new(str, Liquid::ParseContext.new)
       end
