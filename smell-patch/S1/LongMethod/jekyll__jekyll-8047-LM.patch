--- a/lib/jekyll/liquid_extensions.rb
+++ b/lib/jekyll/liquid_extensions.rb
@@ -18,5 +18,27 @@ module Jekyll
 
       lookup || variable
     end
+
+    def self.condition_fragment_kind(fragment)
+      Jekyll::Utils.condition_fragment_kind(fragment)
+    end
+
+    def self.canonical_condition_token(token)
+      Jekyll::Utils.canonical_condition_token(token)
+    end
+
+    def self.condition_lookup_markup(identifier)
+      kind = condition_fragment_kind(identifier)
+      if kind == :identifier
+        text = canonical_condition_token(identifier).to_s
+        pieces = []
+        text.split(".").each do |piece|
+          pieces << canonical_condition_token(piece)
+        end
+        pieces.join(".")
+      else
+        identifier
+      end
+    end
   end
 end
