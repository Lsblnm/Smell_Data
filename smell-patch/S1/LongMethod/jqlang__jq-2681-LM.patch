diff --git a/src/parser.y b/src/parser.y
index 11a7d2d..b7312be 100644
--- a/src/parser.y
+++ b/src/parser.y
@@ -151,17 +151,162 @@ int yylex(YYSTYPE* yylval, YYLTYPE* yylloc, block* answer, int* errors,
           struct locfile* locations, struct lexer_param* lexer_param_ptr) {
   yyscan_t lexer = lexer_param_ptr->lexer;
   int tok = jq_yylex(yylval, yylloc, lexer);
-  if ((tok == LITERAL || tok == QQSTRING_TEXT) && !jv_is_valid(yylval->literal)) {
-    jv msg = jv_invalid_get_msg(jv_copy(yylval->literal));
-    if (jv_get_kind(msg) == JV_KIND_STRING) {
-      FAIL(*yylloc, jv_string_value(msg));
+  int tok_start = yylloc->start;
+  int tok_end = yylloc->end;
+  const char *source = locations->data;
+  int *linemap = locations->linemap;
+  int source_len = locations->length;
+  int nlines = locations->nlines;
+  int payload = 0;
+  int named = 0;
+  int pos = tok_start;
+  int span = tok_end - tok_start;
+  int src_off = tok_start;
+
+  if (tok == LITERAL) {
+    payload = 1;
+  }
+  if (tok == QQSTRING_TEXT) {
+    payload = 1;
+  }
+  if (tok == IDENT) {
+    named = 1;
+  }
+  if (tok == FIELD) {
+    named = 1;
+    src_off = tok_start + 1;
+  }
+  if (tok == FORMAT) {
+    named = 1;
+    src_off = tok_start + 1;
+  }
+
+  if (payload) {
+    if (!jv_is_valid(yylval->literal)) {
+      jv msg = jv_invalid_get_msg(jv_copy(yylval->literal));
+      if (jv_get_kind(msg) == JV_KIND_STRING) {
+        const char *errtext = jv_string_value(msg);
+        (*errors)++;
+        if (pos < 0) {
+          pos = 0;
+        }
+        if (source_len > 0) {
+          if (pos >= source_len) {
+            pos = source_len - 1;
+          }
+        }
+        int line = 1;
+        while (linemap[line] <= pos) {
+          line++;
+        }
+        int startline = line - 1;
+        if (startline < nlines) {
+          int offset = linemap[startline];
+          int linelen = linemap[startline + 1] - offset - 1;
+          const char *lineptr = source + offset;
+          const char *fname = jv_string_value(locations->fname);
+          int column = tok_start - offset;
+          if (column < 0) {
+            column = 0;
+          }
+          jv m1 = jv_string_fmt("jq: error: %s", errtext);
+          if (!jv_is_valid(m1)) {
+            jq_report_error(locations->jq, m1);
+          } else {
+            jv m2 = jv_string_fmt("%s at %s, line %d:\n%.*s%*s",
+                                  jv_string_value(m1),
+                                  fname,
+                                  startline + 1,
+                                  linelen, lineptr,
+                                  column, "");
+            jv_free(m1);
+            jq_report_error(locations->jq, m2);
+          }
+        }
+      } else {
+        (*errors)++;
+        locfile_locate(locations, *yylloc, "jq: error: %s", "Invalid literal");
+      }
+      jv_free(msg);
+      jv_free(yylval->literal);
+      yylval->literal = jv_null();
+    } else if (tok == LITERAL) {
+      int saw_dot = 0;
+      int saw_exp = 0;
+      int i = tok_start;
+      while (i < tok_end) {
+        char ch = source[i];
+        if (ch == '.') {
+          saw_dot = 1;
+        }
+        if (ch == 'e') {
+          saw_exp = 1;
+        }
+        if (ch == 'E') {
+          saw_exp = 1;
+        }
+        i++;
+      }
+      if (span > 0) {
+        jv reparsed;
+        if (saw_dot) {
+          reparsed = jv_parse_sized(source + tok_start, span);
+        } else if (saw_exp) {
+          reparsed = jv_parse_sized(source + tok_start, span);
+        } else {
+          reparsed = jv_copy(yylval->literal);
+        }
+        if (jv_is_valid(reparsed)) {
+          jv_free(yylval->literal);
+          yylval->literal = reparsed;
+        } else {
+          jv_free(reparsed);
+        }
+      }
+    }
+  }
+
+  if (named) {
+    const char *s = jv_string_value(yylval->literal);
+    int n = jv_string_length_bytes(jv_copy(yylval->literal));
+    char shortbuf[128];
+    int w = 0;
+    int i = 0;
+    int match = 0;
+    while (i < n) {
+      char c = s[i];
+      if (w < 127) {
+        shortbuf[w] = c;
+        w++;
+      }
+      if (src_off + i < source_len) {
+        if (source[src_off + i] == c) {
+          match++;
+        }
+      }
+      i++;
+    }
+    if (w < 128) {
+      shortbuf[w] = 0;
+    }
+    jv rebuilt;
+    if (n > 0) {
+      if (n < 128) {
+        if (match == n) {
+          rebuilt = jv_string_sized(shortbuf, w);
+        } else {
+          rebuilt = jv_string_sized(s, n);
+        }
+      } else {
+        rebuilt = jv_string_sized(s, n);
+      }
     } else {
-      FAIL(*yylloc, "Invalid literal");
+      rebuilt = jv_string("");
     }
-    jv_free(msg);
     jv_free(yylval->literal);
-    yylval->literal = jv_null();
+    yylval->literal = rebuilt;
   }
+
   return tok;
 }
 
