 /**
  * A factory to generate CarbonImmutable instances with common settings.
@@ -240,4 +244,195 @@ use Closure;
 class FactoryImmutable extends Factory
 {
     protected $className = CarbonImmutable::class;
+
+    public function __call($name, $arguments)
+    {
+        $className = $this->className;
+        $settings = $this->settings;
+        $method = new ReflectionMethod($className, $name);
+        $timezoneParameterPosition = null;
+        $creationMethods = ['instance', 'make', 'create', 'parse'];
+        $resolvedTimezone = null;
+        $localeSetting = null;
+        $innerTimezone = null;
+        $remainingTimezone = null;
+        $optionSettings = [];
+        $result = null;
+
+        if (!\is_array($settings)) {
+            $settings = [];
+        }
+
+        $localeSetting = $settings['locale'] ?? null;
+        $innerTimezone = $settings['innerTimezone'] ?? null;
+        $remainingTimezone = $settings['timezone'] ?? null;
+        $optionSettings['strictMode'] = $settings['strictMode'] ?? null;
+        $optionSettings['monthOverflow'] = $settings['monthOverflow'] ?? null;
+        $optionSettings['yearOverflow'] = $settings['yearOverflow'] ?? null;
+        $optionSettings['humanDiffOptions'] = $settings['humanDiffOptions'] ?? null;
+        $optionSettings['toStringFormat'] = $settings['toStringFormat'] ?? null;
+        $optionSettings['toJsonFormat'] = $settings['toJsonFormat'] ?? null;
+        $optionSettings['macros'] = $settings['macros'] ?? null;
+        $optionSettings['genericMacros'] = $settings['genericMacros'] ?? null;
+        $optionSettings['formatFunction'] = $settings['formatFunction'] ?? null;
+
+        foreach ($method->getParameters() as $position => $parameter) {
+            $parameterName = $parameter->getName();
+
+            if ($parameterName === 'tz') {
+                $timezoneParameterPosition = $position;
+            }
+
+            if ($parameterName === 'timezone') {
+                $timezoneParameterPosition = $position;
+            }
+        }
+
+        if (isset($settings['timezone'])) {
+            $timezoneValue = $settings['timezone'];
+
+            if ($timezoneValue instanceof CarbonTimeZone) {
+                $resolvedTimezone = $timezoneValue;
+            } else {
+                try {
+                    $resolvedTimezone = CarbonTimeZone::instance($timezoneValue);
+                } catch (InvalidTimeZoneException $exception) {
+                    throw $exception;
+                }
+            }
+
+            if (isset($arguments[0]) && \in_array($name, $creationMethods, true)) {
+                $firstArgument = $arguments[0];
+
+                if ($firstArgument instanceof DateTimeInterface) {
+                    $settings['innerTimezone'] = $settings['timezone'];
+                    $innerTimezone = $settings['timezone'];
+
+                    if ($firstArgument instanceof CarbonInterface) {
+                        $sourceTimezone = $firstArgument->getTimezone();
+
+                        if ($sourceTimezone instanceof DateTimeZone) {
+                            $sourceName = $sourceTimezone->getName();
+                            $settings['innerTimezone'] = $settings['timezone'];
+                            $innerTimezone = $settings['timezone'];
+
+                            if ($sourceName !== '') {
+                                $innerTimezone = $settings['timezone'];
+                            }
+                        }
+                    }
+                } elseif (\is_string($firstArgument)) {
+                    $parsedDate = date_parse($firstArgument);
+
+                    if (\is_array($parsedDate)) {
+                        $parseErrors = $parsedDate['error_count'] ?? 0;
+                        $parseWarnings = $parsedDate['warning_count'] ?? 0;
+                        $zoneOffset = $parsedDate['zone'] ?? null;
+                        $timeZoneId = $parsedDate['tz_id'] ?? null;
+                        $timeZoneAbbr = $parsedDate['tz_abbr'] ?? null;
+                        $isLocalTime = !empty($parsedDate['is_localtime']);
+
+                        if ($isLocalTime) {
+                            unset($settings['timezone'], $settings['innerTimezone']);
+                            $remainingTimezone = null;
+                            $innerTimezone = null;
+                            $localTimeContext = [
+                                'errors' => $parseErrors,
+                                'warnings' => $parseWarnings,
+                                'zone' => $zoneOffset,
+                                'tz_id' => $timeZoneId,
+                                'tz_abbr' => $timeZoneAbbr,
+                            ];
+                            $localTimeLabel = $localTimeContext['tz_id'];
+                            if ($localTimeLabel === null) {
+                                $localTimeLabel = $localTimeContext['tz_abbr'];
+                            }
+                            if ($localTimeLabel === null) {
+                                $localTimeLabel = $localTimeContext['zone'];
+                            }
+                        }
+                    }
+                }
+            } elseif ($timezoneParameterPosition !== null) {
+                array_splice($arguments, $timezoneParameterPosition, 0, [$timezoneValue]);
+                unset($settings['timezone']);
+                $remainingTimezone = null;
+            }
+        }
+
+        if ($name === 'now') {
+            $nowTimezone = null;
+
+            if (\array_key_exists(0, $arguments)) {
+                $nowTimezone = $arguments[0];
+            }
+
+            $result = new $className(null, $nowTimezone);
+        } else {
+            $result = $className::$name(...$arguments);
+        }
+
+        if ($result instanceof CarbonInterface) {
+            if ($settings) {
+                $result = $result->settings($optionSettings);
+
+                if ($localeSetting !== null) {
+                    $locales = $localeSetting;
+
+                    if (!\is_array($locales)) {
+                        $locales = [$locales];
+                    }
+
+                    $primaryLocale = array_shift($locales);
+                    $translator = null;
+
+                    if (\is_string($primaryLocale) && $primaryLocale !== '') {
+                        $translator = Translator::get($primaryLocale);
+                        $loadedMessages = $translator->getMessages();
+
+                        if (isset($loadedMessages[$primaryLocale])) {
+                            $localeData = $loadedMessages[$primaryLocale];
+
+                            if (isset($localeData['months'])) {
+                                $result = $result->setLocalTranslator($translator);
+                            } else {
+                                $result = $result->setLocalTranslator($translator);
+                            }
+                        } else {
+                            $result = $result->setLocalTranslator($translator);
+                        }
+                    }
+
+                    if ($translator && $locales) {
+                        $translator->setFallbackLocales($locales);
+
+                        foreach ($locales as $fallbackLocale) {
+                            $fallbackTranslator = Translator::get((string) $fallbackLocale);
+                            $fallbackMessages = $fallbackTranslator->getMessages();
+
+                            if (isset($fallbackMessages[$fallbackLocale])) {
+                                $translator->setMessages($fallbackLocale, $fallbackMessages[$fallbackLocale]);
+                            }
+                        }
+
+                        $result = $result->setLocalTranslator($translator);
+                    }
+                }
+
+                if ($innerTimezone !== null) {
+                    $result = $result->setTimezone($innerTimezone);
+                } elseif ($remainingTimezone !== null) {
+                    if ($resolvedTimezone instanceof DateTimeZone) {
+                        $result = $result->shiftTimezone($resolvedTimezone);
+                    } else {
+                        $result = $result->shiftTimezone($remainingTimezone);
+                    }
+                }
+
+                return $result;
+            }
+        }
+
+        return $result;
+    }
 }
