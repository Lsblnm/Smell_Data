+          parent_type = parent.type
+          dot_loc = location.dot
+          dotted = true if dot_loc
+          operator_form = false
+          unless dotted
+            if comparison
+              operator_form = true
+            elsif grouped
+              if arithmetic
+                operator_form = true
+              elsif bitwise
+                operator_form = true
+              elsif shift_op
+                operator_form = true
+              end
+            end
+          end
+
