+            /
+            %
+            **
+          ]
+          bitwise_methods = %i[
+            &
+            |
+            ^
+          ]
+          shift_methods = %i[
+            <<
+            >>
+          ]
+          bracket_methods = %i[
+            []
+            []=
+          ]
+          unary_methods = %i[
+            +@
+            -@
+            !
+            ~
+          ]
+
+          comparison = false
+          arithmetic = false
+          bitwise = false
+          shift_op = false
+          brackets = false
+          unary = false
