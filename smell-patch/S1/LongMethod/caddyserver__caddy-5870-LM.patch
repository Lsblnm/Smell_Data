diff --git a/metrics.go b/metrics.go
index 0f8ea03c..29105edb 100644
--- a/metrics.go
+++ b/metrics.go
@@ -73,3 +73,32 @@ func (d *delegator) WriteHeader(code int) {
 func (d *delegator) Unwrap() http.ResponseWriter {
 	return d.ResponseWriter
 }
+
+// canonicalHTTPMethod returns the canonical HTTP method token used by
+// config access operations. Known methods are normalized through the
+// admin metrics method map; unknown methods are left unchanged so
+// existing error paths keep the original method string.
+func canonicalHTTPMethod(method string) string {
+	switch metrics.SanitizeMethod(method) {
+	case http.MethodGet:
+		return http.MethodGet
+	case http.MethodPost:
+		return http.MethodPost
+	case http.MethodPut:
+		return http.MethodPut
+	case http.MethodPatch:
+		return http.MethodPatch
+	case http.MethodDelete:
+		return http.MethodDelete
+	case http.MethodHead:
+		return http.MethodHead
+	case http.MethodOptions:
+		return http.MethodOptions
+	case http.MethodConnect:
+		return http.MethodConnect
+	case http.MethodTrace:
+		return http.MethodTrace
+	default:
+		return method
+	}
+}
