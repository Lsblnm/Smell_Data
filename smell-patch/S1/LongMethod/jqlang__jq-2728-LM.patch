+static int configure_runtime(jq_state *jq, int dumpopts, jv lib_search_paths,
+                             char *argv0, const char **program,
+                             jv *ARGS, jv *program_arguments,
+                             int *compiled, int *status) {
+  *status = 0;
+  *compiled = 0;
+
+#ifdef USE_ISATTY
+  if (isatty(STDOUT_FILENO)) {
+#ifndef WIN32
+    dumpopts |= JV_PRINT_ISATTY | JV_PRINT_COLOR;
+#else
+  /* Verify we actually have the console, as the NUL device is also regarded as
+     tty.  Windows can handle color if ANSICON (or ConEmu) is installed, or
+     Windows 10 supports the virtual terminal */
+    DWORD mode;
+    HANDLE con = GetStdHandle(STD_OUTPUT_HANDLE);
+    if (GetConsoleMode(con, &mode)) {
+      dumpopts |= JV_PRINT_ISATTY;
+      if (getenv("ANSICON") != NULL ||
+          SetConsoleMode(con, mode | 4/*ENABLE_VIRTUAL_TERMINAL_PROCESSING*/))
+        dumpopts |= JV_PRINT_COLOR;
+    }
+#endif
+  }
+#endif
+  if (options & SORTED_OUTPUT) dumpopts |= JV_PRINT_SORTED;
+  if (options & ASCII_OUTPUT) dumpopts |= JV_PRINT_ASCII;
+  if (options & COLOR_OUTPUT) dumpopts |= JV_PRINT_COLOR;
+  if (options & NO_COLOR_OUTPUT) dumpopts &= ~JV_PRINT_COLOR;
+
+  {
+    char *color_env = getenv("JQ_COLORS");
+    if (color_env != NULL) {
+      int color_spec_ok = 1;
+      const char *cursor = color_env;
+      size_t slot;
+      for (slot = 0; slot < 8 && color_spec_ok && *cursor != '\0'; slot++) {
+        const char *end = strchr(cursor, ':');
+        if (end == NULL) {
+          end = cursor + strlen(cursor);
+        }
+        char tmp[16];
+        if ((size_t)(end - cursor) > sizeof(tmp) - 4) {
+          color_spec_ok = 0;
+        } else {
+          size_t speclen = (size_t)(end - cursor);
+          memcpy(tmp, cursor, speclen);
+          tmp[speclen] = '\0';
+          if (strspn(tmp, "0123456789;") < strlen(tmp)) {
+            color_spec_ok = 0;
+          } else {
+            if (end[0] == ':') {
+              cursor = end + 1;
+            } else {
+              cursor = end;
+            }
+          }
+        }
+      }
+      if (color_spec_ok) {
+        if (!jq_set_colors(color_env)) {
+          fprintf(stderr, "Failed to set $JQ_COLORS\n");
+        }
+      } else {
+        fprintf(stderr, "Failed to set $JQ_COLORS\n");
+      }
+    }
+  }
+
+  if (jv_get_kind(lib_search_paths) == JV_KIND_NULL) {
+    lib_search_paths = jv_array();
+    lib_search_paths = jv_array_append(lib_search_paths, jv_string("~/.jq"));
+    lib_search_paths = jv_array_append(lib_search_paths, jv_string("$ORIGIN/../lib/jq"));
+    lib_search_paths = jv_array_append(lib_search_paths, jv_string("$ORIGIN/../lib"));
+  }
+  jq_set_attr(jq, jv_string("JQ_LIBRARY_PATH"), lib_search_paths);
+
+  {
+    char *origin = strdup(argv0);
+    if (origin == NULL) {
+      fprintf(stderr, "jq: error: out of memory\n");
+      exit(1);
+    }
+    jq_set_attr(jq, jv_string("JQ_ORIGIN"), jv_string(dirname(origin)));
+    free(origin);
+  }
+
+  {
+    const char *dash = strchr(JQ_VERSION, '-');
+    if (dash == NULL) {
+      jq_set_attr(jq, jv_string("VERSION_DIR"), jv_string(JQ_VERSION));
+    } else {
+      jq_set_attr(jq, jv_string("VERSION_DIR"),
+                  jv_string_fmt("%.*s-master", (int)(dash - JQ_VERSION), JQ_VERSION));
+    }
+  }
+
+#ifdef USE_ISATTY
+  if (!(*program) && (!isatty(STDOUT_FILENO) || !isatty(STDIN_FILENO)))
+    *program = ".";
+#endif
+
+  if (!(*program)) usage(2, 1);
+
+  {
+    jv data = jv_invalid();
+    const char *program_text = *program;
+    jv origin_path;
+    char *program_origin = NULL;
+    if (options & FROM_FILE) {
+      program_origin = strdup(*program);
+      if (program_origin == NULL) {
+        perror("malloc");
+        exit(2);
+      }
+      data = jv_load_file(*program, 1);
+      if (!jv_is_valid(data)) {
+        data = jv_invalid_get_msg(data);
+        fprintf(stderr, "%s: %s\n", progname, jv_string_value(data));
+        jv_free(data);
+        free(program_origin);
+        *status = JQ_ERROR_SYSTEM;
+        return dumpopts;
+      }
+      origin_path = jv_string(dirname(program_origin));
+      program_text = skip_shebang(jv_string_value(data));
+    } else {
+      origin_path = jv_string(".");
+    }
+
+    {
+      int path_max;
+      char *resolved_buf = NULL;
+#ifdef _PC_PATH_MAX
+      path_max = pathconf(jv_string_value(origin_path), _PC_PATH_MAX);
+#else
+      path_max = PATH_MAX;
+#endif
+      if (path_max > 0) {
+        resolved_buf = jv_mem_alloc(path_max);
+      }
+#ifdef WIN32
+      char *resolved = _fullpath(resolved_buf, jv_string_value(origin_path), path_max);
+#else
+      char *resolved = realpath(jv_string_value(origin_path), resolved_buf);
+#endif
+      if (resolved == NULL) {
+        free(resolved_buf);
+      } else {
+        jv_free(origin_path);
+        origin_path = jv_string(resolved);
+        free(resolved);
+      }
+    }
+
+    jq_set_attr(jq, jv_string("PROGRAM_ORIGIN"), origin_path);
+    *ARGS = JV_OBJECT(jv_string("positional"), *ARGS,
+                      jv_string("named"), jv_copy(*program_arguments));
+    *program_arguments = jv_object_set(*program_arguments, jv_string("ARGS"), jv_copy(*ARGS));
+    *compiled = jq_compile_args(jq, program_text, jv_copy(*program_arguments));
+    if (program_origin != NULL) {
+      free(program_origin);
+    }
+    jv_free(data);
+  }
+
+  if (!(*compiled)) {
+    *status = JQ_ERROR_COMPILE;
+    return dumpopts;
+  }
+  return dumpopts;
+}
+
+
 #ifdef WIN32
 int umain(int argc, char* argv[]);
 
