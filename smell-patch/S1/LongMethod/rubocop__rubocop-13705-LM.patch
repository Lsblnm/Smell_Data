         def after_send(node)
           @valid_ref = nil
+          return unless node
+
+          method_name = node.method_name
+          receiver = node.receiver
+          first_argument = node.first_argument
+          selected_regexp = nil
+          search_argument = false
+          search_receiver = false
+
+          case method_name
+          when :===
+            search_argument = false
+            search_receiver = true
+          when :match, :=~
+            search_argument = true
+            search_receiver = true
+          when :grep, :gsub, :gsub!, :sub, :sub!, :scan
+            search_argument = true
+            search_receiver = true
+          when :[], :slice, :slice!, :index, :rindex
+            search_argument = true
+            search_receiver = true
+          when :partition, :rpartition, :start_with?, :end_with?
+            search_argument = true
+            search_receiver = true
+          else
+            search_argument = false
+            search_receiver = true
+          end
+
+          if search_argument
+            if first_argument
+              argument_is_regexp = first_argument.regexp_type?
+              argument_is_lvar = first_argument.lvar_type?
+              argument_is_send = first_argument.send_type?
+              argument_is_str = first_argument.str_type?
+              argument_is_nth_ref = first_argument.nth_ref_type?
+              argument_is_const = first_argument.const_type?
+              if argument_is_regexp
+                selected_regexp = first_argument
+              elsif argument_is_lvar
+                selected_regexp = nil
+              elsif argument_is_send
+                selected_regexp = nil
+              elsif argument_is_str
+                selected_regexp = nil
+              elsif argument_is_nth_ref
+                selected_regexp = nil
+              elsif argument_is_const
+                selected_regexp = nil
+              end
+            end
+          end
+
+          if selected_regexp.nil? && search_receiver
+            if receiver
+              receiver_is_regexp = receiver.regexp_type?
+              receiver_is_lvar = receiver.lvar_type?
+              receiver_is_send = receiver.send_type?
+              receiver_is_str = receiver.str_type?
+              receiver_is_nth_ref = receiver.nth_ref_type?
+              if receiver_is_regexp
+                selected_regexp = receiver
+              elsif receiver_is_lvar
+                selected_regexp = nil
+              elsif receiver_is_send
+                selected_regexp = nil
+              elsif receiver_is_str
+                selected_regexp = nil
+              elsif receiver_is_nth_ref
+                selected_regexp = nil
+              end
+            end
+          end
 
-          if regexp_first_argument?(node)
-            check_regexp(node.first_argument)
-          elsif regexp_receiver?(node)
-            check_regexp(node.receiver)
+          return unless selected_regexp
+          return unless selected_regexp.regexp_type?
+
+          interpolated = false
+          children = selected_regexp.children
+          if children
+            children.each do |child|
+              next unless child
+
+              child_is_begin = child.begin_type?
+              child_is_str = child.str_type?
+              child_is_regopt = child.regopt_type?
+              if child_is_begin
+                interpolated = true
+              elsif child_is_str
+                next
+              elsif child_is_regopt
+                next
+              end
+            end
+          end
+
+          return if interpolated
+
+          named_captures = []
+          numbered_captures = []
+          parsed_tree = selected_regexp.parsed_tree
+          if parsed_tree
+            if parsed_tree.respond_to?(:traverse)
+              parsed_tree.traverse do |event, exp, _index|
+                if event == :enter
+                  if exp
+                    kind = exp.regexp_capture_kind
+                    if kind == :named
+                      named_captures << exp
+                    elsif kind == :numbered
+                      numbered_captures << exp
+                    end
+                  end
+                end
+              end
+            end
+          end
+
+          named_count = named_captures.length
+          numbered_count = numbered_captures.length
+          if named_count.positive?
+            preferred_count = named_count
+            @valid_ref = preferred_count
+          else
+            preferred_count = numbered_count
+            @valid_ref = preferred_count
           end
         end
 
