+      def regexp_group_header(text)
+        decoded = interpret(text.to_s)
+        if decoded.start_with?('(?<=')
+          '(?<='
+        elsif decoded.start_with?('(?<')
+          decoded[/\A\(\?<[^>]*>/] || '(?<'
+        elsif decoded.start_with?('(?:')
+          '(?:'
+        elsif decoded.start_with?('(?')
+          '(?'
+        elsif decoded.start_with?('(')
+          '('
+        else
+          decoded[0, 1].to_s
+        end
+      end
+
       private
 
       def interpret_string_escape(escape)
