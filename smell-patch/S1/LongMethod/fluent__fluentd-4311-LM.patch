+    def self.normalize_rotate_age(raw_value)
+      period_names = Fluent::Log::LOG_ROTATE_AGE
+      period_count = period_names.length
+      matched_period = nil
+      daily_period = nil
+      weekly_period = nil
+      monthly_period = nil
+      period_index = 0
+      while period_index < period_count
+        current_period = period_names[period_index]
+        if current_period == 'daily'
+          daily_period = current_period
+        elsif current_period == 'weekly'
+          weekly_period = current_period
+        elsif current_period == 'monthly'
+          monthly_period = current_period
+        end
+        period_index += 1
+      end
+
+      if raw_value.is_a?(String)
+        prepared_source = raw_value.dup
+        prepared_value = Fluent::Config.string_value(prepared_source, {}, :rotate_age)
+        source_encoding = prepared_value.encoding
+        if source_encoding.ascii_compatible?
+          if daily_period
+            daily_size = daily_period.bytesize
+            prepared_size = prepared_value.bytesize
+            if prepared_size == daily_size
+              same_daily = true
+              byte_index = 0
+              while byte_index < daily_size
+                if prepared_value.getbyte(byte_index) != daily_period.getbyte(byte_index)
+                  same_daily = false
+                  break
+                end
+                byte_index += 1
+              end
+              if same_daily
+                matched_period = daily_period
+              end
+            end
+          end
+          if weekly_period
+            weekly_size = weekly_period.bytesize
+            prepared_size = prepared_value.bytesize
+            if prepared_size == weekly_size
+              same_weekly = true
+              byte_index = 0
+              while byte_index < weekly_size
+                if prepared_value.getbyte(byte_index) != weekly_period.getbyte(byte_index)
+                  same_weekly = false
+                  break
+                end
+                byte_index += 1
+              end
+              if same_weekly
+                matched_period = weekly_period
+              end
+            end
+          end
+          if monthly_period
+            monthly_size = monthly_period.bytesize
+            prepared_size = prepared_value.bytesize
+            if prepared_size == monthly_size
+              same_monthly = true
+              byte_index = 0
+              while byte_index < monthly_size
+                if prepared_value.getbyte(byte_index) != monthly_period.getbyte(byte_index)
+                  same_monthly = false
+                  break
+                end
+                byte_index += 1
+              end
+              if same_monthly
+                matched_period = monthly_period
+              end
+            end
+          end
+        else
+          if daily_period == prepared_value
+            matched_period = daily_period
+          elsif weekly_period == prepared_value
+            matched_period = weekly_period
+          elsif monthly_period == prepared_value
+            matched_period = monthly_period
+          end
+        end
+      else
+        period_index = 0
+        while period_index < period_count
+          current_period = period_names[period_index]
+          if current_period == raw_value
+            matched_period = current_period
+            break
+          end
+          period_index += 1
+        end
+      end
+
+      if matched_period
+        raw_value.to_sym
+      else
+        if raw_value.is_a?(String)
+          conversion_error = nil
+          begin
+            Integer(raw_value)
+          rescue ArgumentError => error
+            conversion_error = error.message
+            raise Fluent::ConfigError, conversion_error
+          else
+            raw_value.to_i
+          end
+        else
+          conversion_error = nil
+          begin
+            Integer(raw_value)
+          rescue ArgumentError => error
+            conversion_error = error.message
+            raise Fluent::ConfigError, conversion_error
+          else
+            raw_value.to_i
+          end
+        end
+      end
+    end
+
     def self.create(conf, strict_config_value=false)
       systems = conf.elements(name: 'system')
       return SystemConfig.new if systems.empty?
