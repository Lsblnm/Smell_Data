+  public String getLeaderBaseUrl()
+  {
+    final String scheme = getServiceScheme();
+    final String hostAndPort = getHostAndPortToUse();
+    final String raw = StringUtils.format("%s://%s", scheme, hostAndPort);
+    if (scheme == null || scheme.isEmpty() || hostAndPort == null || hostAndPort.isEmpty()) {
+      return raw;
+    }
+    try {
+      final URI parsed = URIs.parse(raw, scheme);
+      if (parsed.getScheme() == null || parsed.getAuthority() == null) {
+        return raw;
+      }
+      return StringUtils.format("%s://%s", parsed.getScheme(), parsed.getAuthority());
+    }
+    catch (IllegalArgumentException ignored) {
+      return raw;
+    }
+  }
