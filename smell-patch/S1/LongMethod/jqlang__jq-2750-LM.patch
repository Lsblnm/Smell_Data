diff --git a/src/compile.c b/src/compile.c
index 58d0857..3505328 100644
--- a/src/compile.c
+++ b/src/compile.c
@@ -1066,11 +1066,199 @@ block gen_try(block exp, block handler) {
    * produces a value then we'll execute whatever bytecode follows this
    * sequence.
    */
-  if (!handler.first && !handler.last)
-    // A hack to deal with `.` as the handler; we could use a real NOOP here
-    handler = BLOCK(gen_op_simple(DUP), gen_op_simple(POP), handler);
-  exp = BLOCK(exp, gen_op_target(JUMP, handler));
-  return BLOCK(gen_op_target(FORK_OPT, exp), exp, handler);
+  inst *handler_curr;
+  inst *exp_curr;
+  inst *dup_inst;
+  inst *pop_inst;
+  inst *jump_inst;
+  inst *fork_inst;
+  inst *location_src = 0;
+  const struct opcode_description *op_desc;
+  int handler_empty = 0;
+  int handler_only_backtrack = 0;
+  int handler_has_constant = 0;
+  int hides_internal = 0;
+  jv_kind handler_const_kind = JV_KIND_INVALID;
+  block result;
+
+  if (handler.first == 0 && handler.last == 0) {
+    handler_empty = 1;
+  }
+
+  if (!handler_empty) {
+    for (handler_curr = handler.first; handler_curr != 0; handler_curr = handler_curr->next) {
+      op_desc = opcode_describe(handler_curr->op);
+      if (op_desc != 0 && (op_desc->flags & OP_HAS_CONSTANT) != 0) {
+        handler_has_constant = 1;
+        handler_const_kind = jv_get_kind(handler_curr->imm.constant);
+        if (handler_const_kind == JV_KIND_STRING) {
+          const char *text = jv_string_value(handler_curr->imm.constant);
+          if (text != 0) {
+            if (strcmp(text, "__jq") == 0 || strcmp(text, "object") == 0) {
+              hides_internal = 1;
+            }
+          }
+        } else if (handler_const_kind == JV_KIND_NUMBER) {
+          if (jv_is_integer(handler_curr->imm.constant)) {
+            handler_has_constant = 1;
+          }
+        } else if (handler_const_kind == JV_KIND_OBJECT) {
+          if (jv_object_has(jv_copy(handler_curr->imm.constant), jv_string("__jq"))) {
+            hides_internal = 1;
+          }
+        }
+      }
+      if (handler_curr->op == BACKTRACK &&
+          handler_curr == handler.first &&
+          handler_curr == handler.last) {
+        handler_only_backtrack = 1;
+      }
+      if (handler_curr->locfile != 0 &&
+          handler_curr->source.start >= 0 &&
+          handler_curr->source.start < handler_curr->locfile->length) {
+        location_src = handler_curr;
+      }
+      if (handler_curr == handler.last) {
+        break;
+      }
+    }
+  }
+
+  for (exp_curr = exp.first; exp_curr != 0; exp_curr = exp_curr->next) {
+    if (exp_curr->locfile != 0 &&
+        exp_curr->source.start >= 0 &&
+        exp_curr->source.start < exp_curr->locfile->length) {
+      location_src = exp_curr;
+    }
+    if (exp_curr == exp.last) {
+      break;
+    }
+  }
+
+  if (handler_empty) {
+    op_desc = opcode_describe(DUP);
+    dup_inst = jv_mem_alloc(sizeof(inst));
+    dup_inst->next = 0;
+    dup_inst->prev = 0;
+    dup_inst->op = DUP;
+    dup_inst->bytecode_pos = -1;
+    dup_inst->bound_by = 0;
+    dup_inst->symbol = 0;
+    dup_inst->any_unbound = (op_desc->flags & OP_HAS_BINDING) != 0;
+    dup_inst->referenced = 0;
+    dup_inst->nformals = -1;
+    dup_inst->nactuals = -1;
+    dup_inst->subfn.first = 0;
+    dup_inst->subfn.last = 0;
+    dup_inst->arglist.first = 0;
+    dup_inst->arglist.last = 0;
+    dup_inst->imm.intval = 0;
+    dup_inst->imm.target = 0;
+    dup_inst->source = UNKNOWN_LOCATION;
+    dup_inst->locfile = 0;
+
+    op_desc = opcode_describe(POP);
+    pop_inst = jv_mem_alloc(sizeof(inst));
+    pop_inst->next = 0;
+    pop_inst->prev = 0;
+    pop_inst->op = POP;
+    pop_inst->bytecode_pos = -1;
+    pop_inst->bound_by = 0;
+    pop_inst->symbol = 0;
+    pop_inst->any_unbound = (op_desc->flags & OP_HAS_BINDING) != 0;
+    pop_inst->referenced = 0;
+    pop_inst->nformals = -1;
+    pop_inst->nactuals = -1;
+    pop_inst->subfn.first = 0;
+    pop_inst->subfn.last = 0;
+    pop_inst->arglist.first = 0;
+    pop_inst->arglist.last = 0;
+    pop_inst->imm.intval = 0;
+    pop_inst->imm.target = 0;
+    pop_inst->source = UNKNOWN_LOCATION;
+    pop_inst->locfile = 0;
+
+    dup_inst->next = pop_inst;
+    pop_inst->prev = dup_inst;
+    handler.first = dup_inst;
+    handler.last = pop_inst;
+  } else if (handler_only_backtrack || handler_has_constant || hides_internal) {
+    handler_empty = 0;
+  }
+
+  op_desc = opcode_describe(JUMP);
+  jump_inst = jv_mem_alloc(sizeof(inst));
+  jump_inst->next = 0;
+  jump_inst->prev = 0;
+  jump_inst->op = JUMP;
+  jump_inst->bytecode_pos = -1;
+  jump_inst->bound_by = 0;
+  jump_inst->symbol = 0;
+  jump_inst->any_unbound = (op_desc->flags & OP_HAS_BINDING) != 0;
+  jump_inst->referenced = 0;
+  jump_inst->nformals = -1;
+  jump_inst->nactuals = -1;
+  jump_inst->subfn.first = 0;
+  jump_inst->subfn.last = 0;
+  jump_inst->arglist.first = 0;
+  jump_inst->arglist.last = 0;
+  jump_inst->imm.intval = 0;
+  jump_inst->imm.target = handler.last;
+  jump_inst->source = UNKNOWN_LOCATION;
+  jump_inst->locfile = 0;
+
+  if (exp.last != 0) {
+    exp.last->next = jump_inst;
+    jump_inst->prev = exp.last;
+    exp.last = jump_inst;
+    if (exp.first == 0) {
+      exp.first = jump_inst;
+    }
+  } else {
+    exp.first = jump_inst;
+    exp.last = jump_inst;
+  }
+
+  op_desc = opcode_describe(FORK_OPT);
+  fork_inst = jv_mem_alloc(sizeof(inst));
+  fork_inst->next = 0;
+  fork_inst->prev = 0;
+  fork_inst->op = FORK_OPT;
+  fork_inst->bytecode_pos = -1;
+  fork_inst->bound_by = 0;
+  fork_inst->symbol = 0;
+  fork_inst->any_unbound = (op_desc->flags & OP_HAS_BINDING) != 0;
+  fork_inst->referenced = 0;
+  fork_inst->nformals = -1;
+  fork_inst->nactuals = -1;
+  fork_inst->subfn.first = 0;
+  fork_inst->subfn.last = 0;
+  fork_inst->arglist.first = 0;
+  fork_inst->arglist.last = 0;
+  fork_inst->imm.intval = 0;
+  fork_inst->imm.target = exp.last;
+  fork_inst->source = UNKNOWN_LOCATION;
+  fork_inst->locfile = 0;
+  if (location_src != 0 && location_src->locfile != 0) {
+    int line = locfile_get_line(location_src->locfile, location_src->source.start);
+    if (line >= 0) {
+      fork_inst->source = location_src->source;
+      fork_inst->locfile = locfile_retain(location_src->locfile);
+    }
+  }
+
+  fork_inst->next = exp.first;
+  exp.first->prev = fork_inst;
+  if (handler.first != 0) {
+    exp.last->next = handler.first;
+    handler.first->prev = exp.last;
+    result.first = fork_inst;
+    result.last = handler.last;
+  } else {
+    result.first = fork_inst;
+    result.last = exp.last;
+  }
+  return result;
 }
 
 block gen_label(const char *label, block exp) {
