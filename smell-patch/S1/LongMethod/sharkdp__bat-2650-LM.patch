+#[derive(Debug, Clone)]
+pub(crate) struct GlobPathLayout {
+    pub rebuilt: String,
+    pub components: Vec<String>,
+    pub file_name: String,
+    pub extension: Option<String>,
+    pub is_absolute: bool,
+    pub star_count: usize,
+    pub double_star_count: usize,
+    pub question_count: usize,
+    pub has_char_class: bool,
+    pub has_brace: bool,
+    pub unclosed_class: bool,
+    pub unclosed_brace: bool,
+}
+
+impl GlobPathLayout {
+    pub(crate) fn inspect(pattern: &str) -> Self {
+        let scan = crate::preprocessor::scan_glob_pattern(pattern);
+        let file_name = scan
+            .components
+            .last()
+            .cloned()
+            .unwrap_or_default();
+        let extension = if file_name.is_empty() {
+            None
+        } else if file_name.starts_with('.') {
+            let rest = &file_name[1..];
+            if rest.contains('.') {
+                rest.rsplit('.').next().map(|part| part.to_string())
+            } else {
+                None
+            }
+        } else if let Some((stem, ext)) = file_name.rsplit_once('.') {
+            if stem.is_empty() {
+                None
+            } else {
+                Some(ext.to_string())
+            }
+        } else {
+            None
+        };
+        let is_absolute = pattern.starts_with('/') || pattern.starts_with('\\');
+        GlobPathLayout {
+            rebuilt: scan.rebuilt,
+            components: scan.components,
+            file_name,
+            extension,
+            is_absolute,
+            star_count: scan.star_count,
+            double_star_count: scan.double_star_count,
+            question_count: scan.question_count,
+            has_char_class: scan.class_count > 0,
+            has_brace: scan.brace_count > 0,
+            unclosed_class: scan.unclosed_class,
+            unclosed_brace: scan.unclosed_brace,
+        }
+    }
+}
