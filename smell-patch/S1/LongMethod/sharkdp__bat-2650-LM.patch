     #[default]
     Unicode,
 }
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub(crate) enum GlobPatternAtom {
+    Literal,
+    Star,
+    DoubleStar,
+    Question,
+    Slash,
+    Backslash,
+    Dot,
+    ClassOpen,
+    ClassClose,
+    BraceOpen,
+    BraceClose,
+    Comma,
+    Colon,
+    Dash,
+    Bang,
+    Control,
+}
+
+impl NonprintableNotation {
+    pub(crate) fn classify_glob_atom(self, ch: char, next: Option<char>) -> GlobPatternAtom {
+        match ch {
+            '*' => {
+                if next == Some('*') {
+                    GlobPatternAtom::DoubleStar
+                } else {
+                    GlobPatternAtom::Star
+                }
+            }
+            '?' => GlobPatternAtom::Question,
+            '/' => GlobPatternAtom::Slash,
+            '\\' => GlobPatternAtom::Backslash,
+            '.' => GlobPatternAtom::Dot,
+            '[' => GlobPatternAtom::ClassOpen,
+            ']' => GlobPatternAtom::ClassClose,
+            '{' => GlobPatternAtom::BraceOpen,
+            '}' => GlobPatternAtom::BraceClose,
+            ',' => GlobPatternAtom::Comma,
+            ':' => GlobPatternAtom::Colon,
+            '-' => GlobPatternAtom::Dash,
+            '!' | '^' => GlobPatternAtom::Bang,
+            c if c.is_control() => match self {
+                NonprintableNotation::Caret | NonprintableNotation::Unicode => {
+                    GlobPatternAtom::Control
+                }
+            },
+            _ => GlobPatternAtom::Literal,
+        }
+    }
+}
