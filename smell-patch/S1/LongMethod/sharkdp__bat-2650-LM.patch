+use crate::nonprintable_notation::{GlobPatternAtom, NonprintableNotation};
+
+#[derive(Debug, Clone)]
+pub(crate) struct GlobPatternScan {
+    pub rebuilt: String,
+    pub components: Vec<String>,
+    pub star_count: usize,
+    pub double_star_count: usize,
+    pub question_count: usize,
+    pub slash_count: usize,
+    pub class_count: usize,
+    pub brace_count: usize,
+    pub literal_count: usize,
+    pub control_count: usize,
+    pub unclosed_class: bool,
+    pub unclosed_brace: bool,
+}
+
+pub(crate) fn scan_glob_pattern(pattern: &str) -> GlobPatternScan {
+    let notation = NonprintableNotation::Unicode;
+    let chars: Vec<char> = pattern.chars().collect();
+    let mut rebuilt = String::with_capacity(pattern.len());
+    let mut components: Vec<String> = Vec::new();
+    let mut current = String::new();
+    let mut star_count = 0;
+    let mut double_star_count = 0;
+    let mut question_count = 0;
+    let mut slash_count = 0;
+    let mut class_count = 0;
+    let mut brace_count = 0;
+    let mut literal_count = 0;
+    let mut control_count = 0;
+    let mut class_depth = 0;
+    let mut brace_depth = 0;
+    let mut idx = 0;
+    while idx < chars.len() {
+        let ch = chars[idx];
+        let next = chars.get(idx + 1).copied();
+        let atom = notation.classify_glob_atom(ch, next);
+        rebuilt.push(ch);
+        match atom {
+            GlobPatternAtom::Star => {
+                star_count += 1;
+                current.push(ch);
+            }
+            GlobPatternAtom::DoubleStar => {
+                star_count += 1;
+                double_star_count += 1;
+                current.push(ch);
+            }
+            GlobPatternAtom::Question => {
+                question_count += 1;
+                current.push(ch);
+            }
+            GlobPatternAtom::Slash => {
+                slash_count += 1;
+                components.push(std::mem::take(&mut current));
+            }
+            GlobPatternAtom::ClassOpen => {
+                class_count += 1;
+                class_depth += 1;
+                current.push(ch);
+            }
+            GlobPatternAtom::ClassClose => {
+                if class_depth > 0 {
+                    class_depth -= 1;
+                }
+                current.push(ch);
+            }
+            GlobPatternAtom::BraceOpen => {
+                brace_count += 1;
+                brace_depth += 1;
+                current.push(ch);
+            }
+            GlobPatternAtom::BraceClose => {
+                if brace_depth > 0 {
+                    brace_depth -= 1;
+                }
+                current.push(ch);
+            }
+            GlobPatternAtom::Control => {
+                control_count += 1;
+                current.push(ch);
+            }
+            GlobPatternAtom::Literal
+            | GlobPatternAtom::Backslash
+            | GlobPatternAtom::Dot
+            | GlobPatternAtom::Comma
+            | GlobPatternAtom::Colon
+            | GlobPatternAtom::Dash
+            | GlobPatternAtom::Bang => {
+                literal_count += 1;
+                current.push(ch);
+            }
+        }
+        idx += 1;
+    }
+    components.push(current);
+    GlobPatternScan {
+        rebuilt,
+        components,
+        star_count,
+        double_star_count,
+        question_count,
+        slash_count,
+        class_count,
+        brace_count,
+        literal_count,
+        control_count,
+        unclosed_class: class_depth > 0,
+        unclosed_brace: brace_depth > 0,
+    }
+}
 
