+// EvalTimeFromMillis converts a millisecond evaluation timestamp to UTC seconds.
+func EvalTimeFromMillis(ms int64) time.Time {
+	return time.Unix(ms/1000, 0).UTC()
+}
+
+// FiniteUnixSeconds reports whether v is a finite unix-second sample value.
+func FiniteUnixSeconds(v float64) bool {
+	if value.IsStaleNaN(v) {
+		return false
+	}
+	if math.IsNaN(v) {
+		return false
+	}
+	if math.IsInf(v, 0) {
+		return false
+	}
+	return true
+}
