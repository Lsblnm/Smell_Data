+/// POSIX portable blank characters: horizontal tab and space.
+pub fn portable_blank_bytes() -> &'static [u8] {
+    &[0x09, 0x20]
+}
+
+/// POSIX portable space characters: tab, line feed, vertical tab, form feed, carriage return, space.
+pub fn portable_space_bytes() -> &'static [u8] {
+    const BYTES: [u8; 6] = [
+        0x09,
+        super::line_ending::LineEnding::Newline as u8,
+        0x0B,
+        0x0C,
+        0x0D,
+        0x20,
+    ];
+    &BYTES
+}
