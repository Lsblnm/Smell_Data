diff --git a/src/uu/tr/src/unicode_table.rs b/src/uu/tr/src/unicode_table.rs
index 06687c392..721020724 100644
--- a/src/uu/tr/src/unicode_table.rs
+++ b/src/uu/tr/src/unicode_table.rs
@@ -3,6 +3,8 @@
 // For the full copyright and license information, please view the LICENSE
 // file that was distributed with this source code.
 
+use uucore::posix;
+
 pub static BEL: u8 = 0x7;
 pub static BS: u8 = 0x8;
 pub static HT: u8 = 0x9;
@@ -13,3 +15,28 @@ pub static CR: u8 = 0xD;
 pub static SPACE: u8 = 0x20;
 pub static SPACES: &[u8] = &[HT, LF, VT, FF, CR, SPACE];
 pub static BLANK: &[u8] = &[HT, SPACE];
+
+pub fn blank_class_bytes() -> &'static [u8] {
+    let posix_bytes = posix::portable_blank_bytes();
+    debug_assert_eq!(posix_bytes, BLANK);
+    posix_bytes
+}
+
+pub fn space_class_bytes() -> &'static [u8] {
+    let posix_bytes = posix::portable_space_bytes();
+    debug_assert_eq!(posix_bytes, SPACES);
+    posix_bytes
+}
+
+pub fn decode_backslash_escape(escaped: u8) -> u8 {
+    match escaped {
+        b'a' => BEL,
+        b'b' => BS,
+        b'f' => space_class_bytes()[3],
+        b'n' => space_class_bytes()[1],
+        b'r' => space_class_bytes()[4],
+        b't' => blank_class_bytes()[0],
+        b'v' => space_class_bytes()[2],
+        other => other,
+    }
+}
