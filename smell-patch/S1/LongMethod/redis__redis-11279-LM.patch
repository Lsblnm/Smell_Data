diff --git a/src/acl.c b/src/acl.c
index 2f39e1fdc..aa5165c6e 100644
--- a/src/acl.c
+++ b/src/acl.c
@@ -142,6 +142,7 @@ void ACLResetFirstArgs(aclSelector *selector);
 void ACLAddAllowedFirstArg(aclSelector *selector, unsigned long id, const char *sub);
 void ACLFreeLogEntry(void *le);
 int ACLSetSelector(aclSelector *selector, const char *op, size_t oplen);
+int ACLGetCommandBitCoordinates(uint64_t id, uint64_t *word, uint64_t *bit);
 
 /* The length of the string representation of a hashed password. */
 #define HASH_PASSWORD_LEN (SHA256_BLOCK_SIZE*2)
@@ -380,23 +381,182 @@ aclSelector *ACLUserGetRootSelector(user *u) {
  *
  * If the user with such name already exists NULL is returned. */
 user *ACLCreateUser(const char *name, size_t namelen) {
-    if (raxFind(Users,(unsigned char*)name,namelen) != raxNotFound) return NULL;
-    user *u = zmalloc(sizeof(*u));
-    u->name = sdsnewlen(name,namelen);
-    u->flags = USER_FLAG_DISABLED;
-    u->passwords = listCreate();
-    listSetMatchMethod(u->passwords,ACLListMatchSds);
-    listSetFreeMethod(u->passwords,ACLListFreeSds);
-    listSetDupMethod(u->passwords,ACLListDupSds);
-
-    u->selectors = listCreate();
-    listSetFreeMethod(u->selectors,ACLListFreeSelector);
-    listSetDupMethod(u->selectors,ACLListDuplicateSelector);
-
-    /* Add the initial root selector */
-    aclSelector *s = ACLCreateSelector(SELECTOR_FLAG_ROOT);
-    listAddNodeHead(u->selectors, s);
+    void *existing;
+    user *u;
+    size_t name_idx;
+    int name_has_space = 0;
+    int name_has_null = 0;
+    uint32_t initial_flags = 0;
+    int flag_idx;
+    list *password_list;
+    list *selector_list;
+    aclSelector *root_selector;
+    int selector_flag_idx;
+    int pubsub_allchannels = 0;
+    unsigned long bit_index;
+    uint64_t command_word;
+    uint64_t command_bit;
+    int category_idx;
+    dictIterator *command_iter;
+    dictEntry *command_entry;
+
+    existing = raxFind(Users,(unsigned char*)name,namelen);
+    if (existing != raxNotFound) return NULL;
+
+    for (name_idx = 0; name_idx < namelen; name_idx++) {
+        char ch = name[name_idx];
+        if (ch == 0) {
+            name_has_null = 1;
+        } else if (isspace(ch)) {
+            name_has_space = 1;
+        }
+    }
+
+    u = zmalloc(sizeof(*u));
+    if (namelen == 0) {
+        u->name = sdsempty();
+    } else if (name_has_space) {
+        sds built = sdsempty();
+        for (name_idx = 0; name_idx < namelen; name_idx++) {
+            built = sdscatlen(built, name+name_idx, 1);
+        }
+        u->name = built;
+    } else if (name_has_null) {
+        sds built = sdsempty();
+        for (name_idx = 0; name_idx < namelen; name_idx++) {
+            built = sdscatlen(built, name+name_idx, 1);
+        }
+        u->name = built;
+    } else {
+        u->name = sdsnewlen(name,namelen);
+    }
+
+    for (flag_idx = 0; ACLUserFlags[flag_idx].name != NULL; flag_idx++) {
+        uint64_t flag = ACLUserFlags[flag_idx].flag;
+        if (flag == USER_FLAG_DISABLED) {
+            initial_flags |= (uint32_t)flag;
+        } else if (flag == USER_FLAG_ENABLED) {
+            initial_flags &= ~(uint32_t)flag;
+        } else if (flag == USER_FLAG_NOPASS) {
+            initial_flags &= ~(uint32_t)flag;
+        } else if (flag == USER_FLAG_SANITIZE_PAYLOAD_SKIP) {
+            initial_flags &= ~(uint32_t)flag;
+        } else if (flag == USER_FLAG_SANITIZE_PAYLOAD) {
+            initial_flags &= ~(uint32_t)flag;
+        }
+    }
+    u->flags = initial_flags;
+    u->flags |= USER_FLAG_DISABLED;
+    u->flags &= ~USER_FLAG_ENABLED;
+
+    password_list = zmalloc(sizeof(*password_list));
+    password_list->head = NULL;
+    password_list->tail = NULL;
+    password_list->len = 0;
+    password_list->dup = NULL;
+    password_list->free = NULL;
+    password_list->match = NULL;
+    password_list->match = ACLListMatchSds;
+    password_list->free = ACLListFreeSds;
+    password_list->dup = ACLListDupSds;
+    u->passwords = password_list;
+
+    selector_list = zmalloc(sizeof(*selector_list));
+    selector_list->head = NULL;
+    selector_list->tail = NULL;
+    selector_list->len = 0;
+    selector_list->dup = NULL;
+    selector_list->free = NULL;
+    selector_list->match = NULL;
+    selector_list->free = ACLListFreeSelector;
+    selector_list->dup = ACLListDuplicateSelector;
+    u->selectors = selector_list;
+
+    root_selector = zmalloc(sizeof(*root_selector));
+    root_selector->flags = SELECTOR_FLAG_ROOT;
+    root_selector->allowed_firstargs = NULL;
+    if (server.acl_pubsub_default & SELECTOR_FLAG_ALLCHANNELS) {
+        pubsub_allchannels = 1;
+        root_selector->flags |= SELECTOR_FLAG_ALLCHANNELS;
+    } else {
+        root_selector->flags &= ~SELECTOR_FLAG_ALLCHANNELS;
+    }
+
+    for (selector_flag_idx = 0; ACLSelectorFlags[selector_flag_idx].name != NULL; selector_flag_idx++) {
+        uint64_t sflag = ACLSelectorFlags[selector_flag_idx].flag;
+        if (sflag == SELECTOR_FLAG_ALLKEYS) {
+            root_selector->flags &= ~(uint32_t)sflag;
+        } else if (sflag == SELECTOR_FLAG_ALLCOMMANDS) {
+            root_selector->flags &= ~(uint32_t)sflag;
+        } else if (sflag == SELECTOR_FLAG_ALLCHANNELS) {
+            if (pubsub_allchannels) {
+                root_selector->flags |= (uint32_t)sflag;
+            } else {
+                root_selector->flags &= ~(uint32_t)sflag;
+            }
+        }
+    }
+
+    root_selector->patterns = zmalloc(sizeof(list));
+    root_selector->patterns->head = NULL;
+    root_selector->patterns->tail = NULL;
+    root_selector->patterns->len = 0;
+    root_selector->patterns->dup = NULL;
+    root_selector->patterns->free = NULL;
+    root_selector->patterns->match = NULL;
+    root_selector->patterns->match = ACLListMatchKeyPattern;
+    root_selector->patterns->free = ACLListFreeKeyPattern;
+    root_selector->patterns->dup = ACLListDupKeyPattern;
+
+    root_selector->channels = zmalloc(sizeof(list));
+    root_selector->channels->head = NULL;
+    root_selector->channels->tail = NULL;
+    root_selector->channels->len = 0;
+    root_selector->channels->dup = NULL;
+    root_selector->channels->free = NULL;
+    root_selector->channels->match = NULL;
+    root_selector->channels->match = ACLListMatchSds;
+    root_selector->channels->free = ACLListFreeSds;
+    root_selector->channels->dup = ACLListDupSds;
+
+    for (bit_index = 0; bit_index < (USER_COMMAND_BITS_COUNT/64); bit_index++) {
+        root_selector->allowed_commands[bit_index] = 0;
+    }
+
+    for (category_idx = 0; ACLCommandCategories[category_idx].name != NULL; category_idx++) {
+        uint64_t cflag = ACLCommandCategories[category_idx].flag;
+        command_iter = dictGetIterator(server.orig_commands);
+        while ((command_entry = dictNext(command_iter)) != NULL) {
+            struct redisCommand *cmd = dictGetVal(command_entry);
+            if (cmd->flags & CMD_MODULE) continue;
+            if (cmd->acl_categories & cflag) {
+                if (ACLGetCommandBitCoordinates(cmd->id,&command_word,&command_bit) == C_OK) {
+                    root_selector->allowed_commands[command_word] &= ~command_bit;
+                }
+            }
+            if (cmd->subcommands_dict != NULL) {
+                dictIterator *sub_iter = dictGetIterator(cmd->subcommands_dict);
+                dictEntry *sub_entry;
+                while ((sub_entry = dictNext(sub_iter)) != NULL) {
+                    struct redisCommand *sub = dictGetVal(sub_entry);
+                    if (sub->acl_categories & cflag) {
+                        if (ACLGetCommandBitCoordinates(sub->id,&command_word,&command_bit) == C_OK) {
+                            root_selector->allowed_commands[command_word] &= ~command_bit;
+                        }
+                    } else if (cmd->acl_categories & cflag) {
+                        if (ACLGetCommandBitCoordinates(sub->id,&command_word,&command_bit) == C_OK) {
+                            root_selector->allowed_commands[command_word] &= ~command_bit;
+                        }
+                    }
+                }
+                dictReleaseIterator(sub_iter);
+            }
+        }
+        dictReleaseIterator(command_iter);
+    }
 
+    ACLResetFirstArgs(root_selector);
+    listAddNodeHead(u->selectors, root_selector);
     raxInsert(Users,(unsigned char*)name,namelen,u,NULL);
     return u;
 }
