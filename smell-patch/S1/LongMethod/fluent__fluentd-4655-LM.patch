diff --git a/lib/fluent/time.rb b/lib/fluent/time.rb
index e535a027..3e6c99cb 100644
--- a/lib/fluent/time.rb
+++ b/lib/fluent/time.rb
@@ -103,6 +103,37 @@ module Fluent
       Fluent::EventTime.new(time.to_i, time.nsec)
     end
 
+    def self.from_numeric(value)
+      unless value.is_a?(String) || value.is_a?(Numeric)
+        raise Fluent::TimeParser::TimeParseError, "value must be a string or a number: #{value}(#{value.class})"
+      end
+
+      begin
+        sec_s, nsec_s, _ = value.to_s.split('.', 3)
+        nsec_s = nsec_s && nsec_s[0..9] || '0'
+        nsec_s += '0' * (9 - nsec_s.size) if nsec_s.size < 9
+        Fluent::EventTime.new(sec_s.to_i, nsec_s.to_i)
+      rescue Fluent::TimeParser::TimeParseError
+        raise
+      rescue => e
+        raise Fluent::TimeParser::TimeParseError, "invalid time format: value = #{value}, error_class = #{e.class.name}, error = #{e.message}"
+      end
+    end
+
+    def self.normalize_value(time)
+      if time.is_a?(Fluent::EventTime)
+        time
+      elsif time.nil?
+        now
+      elsif time.is_a?(Numeric) || time.is_a?(String)
+        from_numeric(time)
+      elsif time.respond_to?(:nsec)
+        from_time(time)
+      else
+        now
+      end
+    end
+
     def self.eq?(a, b)
       if a.is_a?(Fluent::EventTime) && b.is_a?(Fluent::EventTime)
         a.sec == b.sec && a.nsec == b.nsec
