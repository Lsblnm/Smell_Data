-	if marks := dedupePathValueMarks(append(priorMarks, schema.ValueMarks(ret.Value, nil)...)); len(marks) > 0 {
+	var schemaMarks []cty.PathValueMarks
+	extendPath := func(path cty.Path, nextSteps ...cty.PathStep) cty.Path {
+		newPath := make(cty.Path, len(path), len(path)+len(nextSteps))
+		copy(newPath, path)
+		newPath = append(newPath, nextSteps...)
+		return newPath
+	}
+	for name, attrS := range schema.Attributes {
+		if attrS.Sensitive {
+			schemaMarks = append(schemaMarks, cty.PathValueMarks{
+				Path:  extendPath(nil, cty.GetAttrStep{Name: name}),
+				Marks: cty.NewValueMarks(marks.Sensitive),
+			})
+		}
+	}
+	if !ret.Value.IsNull() {
+		for name, attrS := range schema.Attributes {
+			if attrS.NestedType == nil || !attrS.NestedType.ContainsSensitive() {
+				continue
+			}
+			attrPath := extendPath(nil, cty.GetAttrStep{Name: name})
+			schemaMarks = append(schemaMarks, attrS.NestedType.ValueMarks(ret.Value.GetAttr(name), attrPath)...)
+		}
+		for name, blockS := range schema.BlockTypes {
+			if blockS.Block.ContainsSensitive() {
+				blockV := ret.Value.GetAttr(name)
+				if !blockV.IsNull() && blockV.IsKnown() {
+					blockPath := extendPath(nil, cty.GetAttrStep{Name: name})
+					switch blockS.Nesting {
+					case configschema.NestingSingle, configschema.NestingGroup:
+						schemaMarks = append(schemaMarks, blockS.Block.ValueMarks(blockV, blockPath)...)
+					case configschema.NestingList, configschema.NestingMap, configschema.NestingSet:
+						for it := blockV.ElementIterator(); it.Next(); {
+							idx, blockEV := it.Element()
+							blockInstancePath := extendPath(blockPath, cty.IndexStep{Key: idx})
+							schemaMarks = append(schemaMarks, blockS.Block.ValueMarks(blockEV, blockInstancePath)...)
+						}
+					default:
+						panic(fmt.Sprintf("unsupported nesting mode %s", blockS.Nesting))
+					}
+				}
+			}
+		}
+	}
+
+	if marks := dedupePathValueMarks(append(priorMarks, schemaMarks...)); len(marks) > 0 {
 		//if marks := priorMarks; len(marks) > 0 {
 		ret.Value = ret.Value.MarkWithPaths(marks)
 	}
