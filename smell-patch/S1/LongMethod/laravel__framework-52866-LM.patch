+     */
+    public static function inspectPrimitiveContext(ReflectionParameter $parameter)
+    {
+        $className = Util::getParameterClassName($parameter);
+        $attribute = Util::getContextualAttributeFromDependency($parameter);
+        $attributeName = null;
+        $configKey = null;
+        $configDefault = null;
+        $hasAttribute = false;
+
+        if ($attribute !== null) {
+            $hasAttribute = true;
+            $attributeName = $attribute->getName();
+            $instance = $attribute->newInstance();
+            $configDetails = Util::configAttributeDetails($instance);
+            $configKey = $configDetails['key'];
+            $configDefault = $configDetails['default'];
+        }
+
+        return [
+            'class_name' => $className,
+            'attribute_name' => $attributeName,
+            'has_attribute' => $hasAttribute,
+            'config_key' => $configKey,
+            'config_default' => $configDefault,
+        ];
+    }
 }
