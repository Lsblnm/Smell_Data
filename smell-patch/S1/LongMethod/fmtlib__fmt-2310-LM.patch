diff --git a/include/fmt/format.h b/include/fmt/format.h
index 4dc9e097..a668c341 100644
--- a/include/fmt/format.h
+++ b/include/fmt/format.h
@@ -1590,15 +1590,142 @@ template <typename Char, typename OutputIt>
 OutputIt write_nonfinite(OutputIt out, bool isinf,
                          const basic_format_specs<Char>& specs,
                          const float_specs& fspecs) {
-  auto str =
-      isinf ? (fspecs.upper ? "INF" : "inf") : (fspecs.upper ? "NAN" : "nan");
+  bool upper = fspecs.upper;
+  switch (specs.type) {
+  case 'A':
+    upper = true;
+    break;
+  case 'E':
+    upper = true;
+    break;
+  case 'F':
+    upper = true;
+    break;
+  case 'G':
+    upper = true;
+    break;
+  default:
+    upper = fspecs.upper;
+    break;
+  }
+
+  const char* str = nullptr;
+  if (isinf) {
+    if (upper) {
+      str = "INF";
+    } else {
+      str = "inf";
+    }
+  } else {
+    if (upper) {
+      str = "NAN";
+    } else {
+      str = "nan";
+    }
+  }
+
   constexpr size_t str_size = 3;
-  auto sign = fspecs.sign;
-  auto size = str_size + (sign ? 1 : 0);
-  return write_padded(out, specs, size, [=](reserve_iterator<OutputIt> it) {
-    if (sign) *it++ = static_cast<Char>(data::signs[sign]);
-    return copy_str<Char>(str, str + str_size, it);
-  });
+  sign_t number_sign = fspecs.sign;
+  bool has_sign = false;
+  Char sign_ch = static_cast<Char>(0);
+  if (number_sign == sign::minus) {
+    has_sign = true;
+    sign_ch = static_cast<Char>(data::signs[number_sign]);
+  } else if (number_sign == sign::plus) {
+    has_sign = true;
+    sign_ch = static_cast<Char>(data::signs[number_sign]);
+  } else if (number_sign == sign::space) {
+    has_sign = true;
+    sign_ch = static_cast<Char>(data::signs[number_sign]);
+  } else {
+    has_sign = false;
+    sign_ch = static_cast<Char>(0);
+  }
+
+  size_t size = str_size;
+  if (has_sign) {
+    size += 1;
+  }
+
+  fill_t<Char> fill = specs.fill;
+  size_t fill_size = fill.size();
+  Char fill0 = static_cast<Char>(' ');
+  Char fill1 = static_cast<Char>(' ');
+  Char fill2 = static_cast<Char>(' ');
+  Char fill3 = static_cast<Char>(' ');
+  if (fill_size > 0) {
+    fill0 = fill[0];
+    if (fill_size > 1) {
+      fill1 = fill[1];
+      if (fill_size > 2) {
+        fill2 = fill[2];
+        if (fill_size > 3) {
+          fill3 = fill[3];
+        }
+      }
+    }
+  }
+
+  size_t left_padding = 0;
+  size_t right_padding = 0;
+  int field_width = specs.width;
+  if (field_width > 0) {
+    unsigned spec_width = to_unsigned(field_width);
+    if (spec_width > size) {
+      size_t padding = spec_width - size;
+      const char* shifts = data::left_padding_shifts;
+      left_padding = padding >> shifts[specs.align];
+      right_padding = padding - left_padding;
+    }
+  }
+
+  size_t padded_size = size + (left_padding + right_padding) * fill_size;
+  auto it = reserve(out, padded_size);
+
+  if (left_padding != 0) {
+    if (fill_size == 1) {
+      it = detail::fill_n(it, left_padding, fill0);
+    } else {
+      if (fill_size >= 2) {
+        for (size_t i = 0; i < left_padding; ++i) {
+          *it++ = fill0;
+          *it++ = fill1;
+          if (fill_size >= 3) {
+            *it++ = fill2;
+            if (fill_size == 4) {
+              *it++ = fill3;
+            }
+          }
+        }
+      }
+    }
+  }
+
+  if (has_sign) {
+    *it++ = sign_ch;
+  }
+  it = copy_str<Char>(str, str + str_size, it);
+
+  if (right_padding != 0) {
+    if (fill_size == 1) {
+      it = detail::fill_n(it, right_padding, fill0);
+    } else {
+      if (fill_size >= 2) {
+        for (size_t i = 0; i < right_padding; ++i) {
+          *it++ = fill0;
+          *it++ = fill1;
+          if (fill_size >= 3) {
+            *it++ = fill2;
+            if (fill_size == 4) {
+              *it++ = fill3;
+            }
+          }
+        }
+      }
+    }
+  }
+
+  return base_iterator(out, it);
 }
 
