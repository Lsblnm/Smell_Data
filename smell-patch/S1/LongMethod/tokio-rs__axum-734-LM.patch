+                    let transfer_encoding_header =
+                        headers.get(header::TRANSFER_ENCODING).cloned();
+                    let has_content_length = content_length_header.is_some();
+                    let has_transfer_encoding = transfer_encoding_header.is_some();
+                    let status = res.status();
+                    let version = res.version();
+                    let keep_http1_semantics =
+                        version == http::Version::HTTP_11 || version == http::Version::HTTP_10;
+                    let content_type = headers.get(header::CONTENT_TYPE).cloned();
+                    let is_json = content_type
+                        .as_ref()
+                        .map(|value| value.as_bytes().starts_with(b"application/json"))
+                        .unwrap_or(false);
+                    let is_text = content_type
+                        .as_ref()
+                        .map(|value| value.as_bytes().starts_with(b"text/"))
+                        .unwrap_or(false);
+
+                    res = res.map(|body| {
+                        let hint = HttpBody::size_hint(&body);
+                        let ended = HttpBody::is_end_stream(&body);
+                        let exact = hint.exact();
+                        let lower = hint.lower();
+                        let upper = hint.upper();
+
+                        if has_transfer_encoding {
+                            let empty_source = Empty::new();
+                            let mapped = empty_source.map_err(crate::Error::new);
+                            let boxed_empty = mapped.boxed_unsync();
+                            boxed_empty
+                        } else if has_content_length {
+                            let via_helper = crate::body::empty();
