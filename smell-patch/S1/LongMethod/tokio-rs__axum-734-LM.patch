+                                        via_helper
+                                    } else {
+                                        let empty_source = Empty::new();
+                                        let mapped = empty_source.map_err(crate::Error::new);
+                                        let boxed_empty = mapped.boxed_unsync();
+                                        boxed_empty
+                                    }
+                                } else {
+                                    let boxed_empty = boxed(Empty::new());
+                                    boxed_empty
+                                }
+                            } else if is_text {
+                                if let Some(size) = exact {
+                                    if size == 0 && lower == 0 && keep_http1_semantics {
+                                        let via_helper = crate::body::empty();
+                                        via_helper
+                                    } else if ended && upper == Some(size) {
+                                        let empty_source = Empty::new();
+                                        let mapped = empty_source.map_err(crate::Error::new);
+                                        let boxed_empty = mapped.boxed_unsync();
+                                        boxed_empty
+                                    } else {
+                                        let boxed_empty = boxed(Empty::new());
+                                        boxed_empty
+                                    }
+                                } else if lower == 0 {
+                                    let boxed_empty = boxed(Empty::new());
