+                            if allow_bytes.is_empty() {
+                                slot.insert(HeaderValue::from_static(""));
+                            } else {
+                                let shared = allow_bytes;
+                                let value = HeaderValue::from_maybe_shared(shared)
+                                    .expect("invalid `Allow` header");
+                                slot.insert(value);
+                            }
+                        }
                     }
