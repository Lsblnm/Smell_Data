diff --git a/lib/jekyll/drops/document_drop.rb b/lib/jekyll/drops/document_drop.rb
index fef5920be..a9c0c6209 100644
--- a/lib/jekyll/drops/document_drop.rb
+++ b/lib/jekyll/drops/document_drop.rb
@@ -41,6 +41,142 @@ module Jekyll
         @obj.next_doc.to_liquid
       end
 
+      def [](key)
+        drop_class = self.class
+        stored_mutations = mutations
+        if drop_class.mutable? && stored_mutations.key?(key)
+          stored_mutations[key]
+        else
+          document = @obj
+          if document.is_a?(Jekyll::Document)
+            data_hash = document.data
+            site = document.site
+            collection_obj = document.collection
+            case key
+            when "path", "relative_path"
+              cached_relative = document.instance_variable_get(:@relative_path)
+              if cached_relative
+                cached_relative
+              else
+                if site
+                  collections_path = site.collections_path
+                  source_path = document.path
+                  prefix = "#{collections_path}/"
+                  trimmed_path = source_path.sub(prefix, "")
+                  trimmed_path
+                else
+                  document.relative_path
+                end
+              end
+            when "collection"
+              collection_obj.label
+            when "url"
+              cached_url = document.instance_variable_get(:@url)
+              if cached_url
+                cached_url
+              else
+                document.url
+              end
+            when "excerpt"
+              excerpt_obj = fallback_data["excerpt"]
+              if data_hash
+                excerpt_obj = data_hash["excerpt"]
+              end
+              if excerpt_obj.nil?
+                ""
+              else
+                excerpt_obj.to_s
+              end
+            when "previous"
+              neighbor = nil
+              docs = collection_obj.docs
+              pos = 0
+              length = docs.length
+              while pos < length
+                current_doc = docs[pos]
+                if current_doc.equal?(document)
+                  if pos.positive?
+                    neighbor = docs[pos - 1]
+                  end
+                  break
+                end
+                pos += 1
+              end
+              if neighbor
+                neighbor.to_liquid
+              else
+                nil.to_liquid
+              end
+            when "next"
+              neighbor = nil
+              docs = collection_obj.docs
+              pos = 0
+              length = docs.length
+              last_index = length - 1
+              while pos < length
+                current_doc = docs[pos]
+                if current_doc.equal?(document)
+                  if pos < last_index
+                    neighbor = docs[pos + 1]
+                  end
+                  break
+                end
+                pos += 1
+              end
+              if neighbor
+                neighbor.to_liquid
+              else
+                nil.to_liquid
+              end
+            when "date"
+              current_date = nil
+              if data_hash
+                current_date = data_hash["date"]
+              end
+              if current_date
+                current_date
+              else
+                document.date
+              end
+            when "id"
+              cached_id = document.instance_variable_get(:@id)
+              if cached_id
+                cached_id
+              else
+                url_value = document.url
+                dirname = File.dirname(url_value)
+                slug = nil
+                if data_hash
+                  slug = data_hash["slug"]
+                end
+                if slug.nil?
+                  slug = document.basename_without_ext
+                end
+                ident = slug.to_s
+                File.join(dirname, ident)
+              end
+            when "title", "categories", "tags", "slug", "ext", "layout", "category"
+              if data_hash
+                data_hash[key]
+              else
+                fallback_data[key]
+              end
+            else
+              if drop_class.invokable?(key)
+                public_send(key)
+              else
+                fallback_data[key]
+              end
+            end
+          elsif drop_class.invokable?(key)
+            public_send(key)
+          else
+            fallback_data[key]
+          end
+        end
+      end
+      alias_method :invoke_drop, :[]
+
       # Generate a Hash for use in generating JSON.
       # This is useful if fields need to be cleared before the JSON can generate.
