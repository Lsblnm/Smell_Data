+    fn print_header_filename(
+        &mut self,
+        handle: &mut OutputHandle,
+        kind: Option<&str>,
+        title: &str,
+        mode: &str,
+    ) -> Result<()> {
+        let prefix = kind.map(|kind| format!("{}: ", kind)).unwrap_or_default();
+        let indent_width = if self.config.style_components.grid() && self.panel_width > 0 {
+            self.panel_width + 2
+        } else {
+            self.panel_width
+        };
+        let max_width = self.config.term_width.saturating_sub(indent_width).max(1);
+        let mut current_width = 0;
+
+        for (text, style) in [
+            (prefix.as_str(), None),
+            (title, Some(self.colors.header_value)),
+            (mode, None),
+        ] {
+            for c in text.chars() {
+                let char_width = c.width().unwrap_or(0);
+                if current_width > 0 && current_width + char_width > max_width {
+                    writeln!(handle)?;
+                    self.print_header_component_indent(handle)?;
+                    current_width = 0;
+                }
+
+                match style {
+                    Some(style) => write!(handle, "{}", style.paint(c.to_string()))?,
+                    None => write!(handle, "{}", c)?,
+                }
+                current_width += char_width;
+            }
+        }
+
+        writeln!(handle)
+    }
