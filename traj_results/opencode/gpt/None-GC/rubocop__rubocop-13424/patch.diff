+        def safe_navigation_chain_length_exceeded?(method_chain, method)
+          return false unless config.key?('Style/SafeNavigationChainLength')
+
+          chain_length_config = config.for_cop('Style/SafeNavigationChainLength')
+
+          chain_length_config['Enabled'] == true &&
+            chain_length(method_chain, method) > chain_length_config.fetch('Max', 2)
+        end
