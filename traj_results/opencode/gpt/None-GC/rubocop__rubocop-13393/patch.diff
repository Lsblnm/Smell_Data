index 85e1d8223..d280bab40 100644
--- a/lib/rubocop/cop/style/guard_clause.rb
+++ b/lib/rubocop/cop/style/guard_clause.rb
@@ -137,7 +137,7 @@ module RuboCop
         alias on_numblock on_block
 
         def on_if(node)
-          return if accepted_form?(node)
+          return if accepted_form?(node) || uses_variable_assigned_in_condition?(node)
 
           if (guard_clause = node.if_branch&.guard_clause?)
             kw = node.loc.keyword.source
@@ -276,6 +276,19 @@ module RuboCop
           accepted_if?(node, ending) || node.condition.multiline? || node.parent&.assignment?
