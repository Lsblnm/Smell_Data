+        def uses_variable_assigned_in_condition?(node)
+          assigned_variables = node.condition.each_node(:lvasgn).map do |assignment|
+            assignment.children.first
+          end
+          return false if assigned_variables.empty?
+
+          node.branches.compact.any? do |branch|
+            branch.each_node(:lvar).any? do |variable|
+              assigned_variables.include?(variable.children.first)
+            end
+          end
+        end
+
         def trivial?(node)
           return false unless node.if_branch
 
