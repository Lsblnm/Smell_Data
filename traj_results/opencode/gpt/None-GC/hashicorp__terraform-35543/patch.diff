+func (n *NodeValidatableResource) validateImportTargets(ctx EvalContext) tfdiags.Diagnostics {
+	var diags tfdiags.Diagnostics
+
+	for _, target := range n.importTargets {
+		if target.Config == nil {
+			continue
+		}
+
+		keyData := []instances.RepetitionData{EvalDataForNoInstanceKey}
+		if target.Config.ForEach != nil {
+			values, known, moreDiags := newForEachEvaluator(target.Config.ForEach, ctx, true).ImportValues()
+			diags = diags.Append(moreDiags)
+			if known {
+				keyData = values
+			} else {
+				keyData = []instances.RepetitionData{instances.UnknownForEachRepetitionData(cty.DynamicPseudoType)}
+			}
+		}
+
+		// Import blocks are evaluated in the root module scope, even when
+		// their target resource is in a child module.
+		importCtx := evalContextForModuleInstance(ctx, addrs.RootModuleInstance)
+		for _, repetitionData := range keyData {
+			scope := importCtx.EvaluationScope(nil, nil, repetitionData)
+			_, moreDiags := scope.EvalExpr(target.Config.ID, cty.String)
+			diags = diags.Append(moreDiags)
+		}
+	}
+
+	return diags
+}
