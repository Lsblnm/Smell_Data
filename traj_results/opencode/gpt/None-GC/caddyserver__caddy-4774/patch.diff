+func TestDefaultBindMultipleAddresses(t *testing.T) {
+	val, err := parseOptMultipleStrings(caddyfile.NewTestDispenser("default_bind [2001:db8:11:ad::80] 198.51.100.184"), nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defaultBind, ok := val.([]string)
+	if !ok {
+		t.Fatalf("expected []string, got %T", val)
+	}
+	if len(defaultBind) != 2 || defaultBind[0] != "[2001:db8:11:ad::80]" || defaultBind[1] != "198.51.100.184" {
+		t.Fatalf("unexpected default bind addresses: %#v", defaultBind)
+	}
+
+	addrs, err := (&ServerType{}).listenerAddrsForServerBlockKey(serverBlock{}, ":33441", map[string]interface{}{"default_bind": defaultBind})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(addrs) != 2 {
+		t.Fatalf("expected 2 listener addresses, got %#v", addrs)
+	}
+	listeners := map[string]bool{}
+	for _, addr := range addrs {
+		listeners[addr] = true
+	}
+	for _, expected := range []string{"[2001:db8:11:ad::80]:33441", "198.51.100.184:33441"} {
+		if !listeners[expected] {
+			t.Errorf("expected listener address %q, got %#v", expected, addrs)
+		}
+	}
+}
