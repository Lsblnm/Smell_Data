+// validateImportTargets evaluates import IDs so that references in import
+// blocks receive the same validation as references in resource configuration.
+func (n *NodeValidatableResource) validateImportTargets(ctx EvalContext) tfdiags.Diagnostics {
+	var diags tfdiags.Diagnostics
+
+	for _, target := range n.importTargets {
+		if target.Config == nil {
+			continue
+		}
+
+		keyData := EvalDataForNoInstanceKey
+		if target.Config.ForEach != nil {
+			keyData = instances.UnknownForEachRepetitionData(cty.DynamicPseudoType)
+		}
+		addr := target.Config.ToResource.Absolute(addrs.RootModuleInstance).Instance(addrs.NoKey)
+		_, moreDiags := evaluateImportIdExpression(target.Config.ID, addr, ctx, keyData, true)
+		diags = diags.Append(moreDiags)
+	}
+
+	return diags
+}
