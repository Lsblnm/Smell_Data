+#[cfg(unix)]
+fn parse_ignored_signals(matches: &clap::ArgMatches) -> UResult<Vec<Signal>> {
+    let mut signals = Vec::new();
+
+    if let Some(values) = matches.get_many::<String>("ignore-signal") {
+        for value in values {
+            for signal_name in value.split(',').filter(|name| !name.is_empty()) {
+                let normalized_name = signal_name.to_ascii_uppercase();
+                let signal_number = uucore::signals::signal_by_name_or_value(&normalized_name)
+                    .and_then(|number| Signal::try_from(number as i32).ok())
+                    .ok_or_else(|| {
+                        USimpleError::new(125, format!("'{}': invalid signal", signal_name))
+                    })?;
+
+                // SIGKILL and SIGSTOP cannot have their disposition changed.
+                if matches!(signal_number, Signal::SIGKILL | Signal::SIGSTOP) {
+                    return Err(USimpleError::new(
+                        125,
+                        format!(
+                            "failed to set signal action for signal {}: Invalid argument",
+                            signal_number as i32
+                        ),
+                    ));
+                }
+                signals.push(signal_number);
+            }
+        }
+    }
+
+    Ok(signals)
+}
+
+#[cfg(unix)]
+fn ignore_signals(signals: &[Signal]) -> UResult<Vec<(Signal, SigAction)>> {
+    let mut previous_actions = Vec::with_capacity(signals.len());
+    let ignored_action = SigAction::new(SigHandler::SigIgn, SaFlags::empty(), SigSet::empty());
+
+    for &signal in signals {
+        let previous_action = unsafe { sigaction(signal, &ignored_action) }.map_err(|error| {
+            USimpleError::new(
+                125,
+                format!(
+                    "failed to set signal action for signal {}: {}",
+                    signal as i32, error
+                ),
+            )
+        })?;
+        previous_actions.push((signal, previous_action));
+    }
+
+    Ok(previous_actions)
+}
+
+#[cfg(unix)]
+fn restore_signal_actions(previous_actions: Vec<(Signal, SigAction)>) -> UResult<()> {
+    for (signal, action) in previous_actions.into_iter().rev() {
+        unsafe { sigaction(signal, &action) }.map_err(|error| {
+            USimpleError::new(
+                125,
+                format!(
+                    "failed to restore signal action for signal {}: {}",
+                    signal as i32, error
+                ),
+            )
+        })?;
+    }
+
+    Ok(())
+}
