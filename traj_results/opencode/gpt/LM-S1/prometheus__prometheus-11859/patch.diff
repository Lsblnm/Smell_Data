+func TestLastChunkSnapshotUsesMostRecentSnapshot(t *testing.T) {
+	dir := t.TempDir()
+
+	oldSnapshot := chunkSnapshotDir(10, 100)
+	recentSnapshot := chunkSnapshotDir(1, 100)
+	require.NoError(t, os.Mkdir(filepath.Join(dir, oldSnapshot), 0o777))
+	require.NoError(t, os.Chtimes(filepath.Join(dir, oldSnapshot), time.Now().Add(-time.Hour), time.Now().Add(-time.Hour)))
+	require.NoError(t, os.Mkdir(filepath.Join(dir, recentSnapshot), 0o777))
+
+	name, idx, offset, err := LastChunkSnapshot(dir)
+	require.NoError(t, err)
+	require.Equal(t, filepath.Join(dir, recentSnapshot), name)
+	require.Equal(t, 1, idx)
+	require.Equal(t, 100, offset)
+
+	require.NoError(t, DeleteChunkSnapshots(dir, recentSnapshot))
+	_, err = os.Stat(filepath.Join(dir, oldSnapshot))
+	require.True(t, os.IsNotExist(err))
+}
