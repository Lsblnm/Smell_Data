     # Sorts posts, pages, and static files.
@@ -158,6 +165,24 @@ module Jekyll
 
     private
 
+    def add_data_dependencies(data_files)
+      return if data_files.empty?
+
+      site.pages.each do |page|
+        add_dependencies(site.in_source_dir(page.relative_path), data_files)
+      end
+      site.collections.each_value do |collection|
+        collection.docs.each do |document|
+          add_dependencies(document.path, data_files)
+        end
+      end
+    end
+
+    def add_dependencies(path, data_files)
+      site.regenerator.add(path) unless site.regenerator.metadata.key?(path)
+      data_files.each { |data_file| site.regenerator.add_dependency(path, data_file) }
+    end
+
     # Internal
     #
     # Determine if the directory is supposed to contain posts and drafts.
