diff --git a/lib/rubocop/cop/style/safe_navigation.rb b/lib/rubocop/cop/style/safe_navigation.rb
index 0617469e7..3c0534adb 100644
--- a/lib/rubocop/cop/style/safe_navigation.rb
+++ b/lib/rubocop/cop/style/safe_navigation.rb
@@ -230,6 +230,7 @@ module RuboCop
           return false if lhs_receiver != rhs_receiver || rhs_receiver.nil?
           return false if use_var_only_in_unless_modifier?(node, lhs_receiver)
           return false if chain_length(rhs, rhs_receiver) > max_chain_length
+          return false if safe_navigation_chain_too_long?(rhs_receiver)
           return false if unsafe_method_used?(rhs, rhs_receiver.parent)
           return false if rhs.send_type? && rhs.method?(:empty?)
 
@@ -572,6 +573,25 @@ module RuboCop
         def max_chain_length
           cop_config.fetch('MaxChainLength', 2)
         end
+
+        def safe_navigation_chain_too_long?(receiver)
+          return false unless processed_source.registry.enabled?(
+            SafeNavigationChainLength, config
+          )
+
+          chain_length_config = config.for_cop('Style/SafeNavigationChainLength')
+          chain_length = 0
+          node = receiver
+
+          while (parent = node.parent)
+            break unless parent.call_type? || parent.block_type?
+
+            chain_length += 1 if parent.call_type?
+            node = parent
+          end
+
+          chain_length > chain_length_config.fetch('Max', 2)
+        end
       end
     end
   end
