+    private function findControlStructureEndIndex(Tokens $tokens, int $index, int $parentScopeEndIndex): int
+    {
+        $token = $tokens[$index];
+        $endIndex = $this->findControlStructureBodyEndIndex($tokens, $index, $parentScopeEndIndex);
+        $nextIndex = $tokens->getNextMeaningfulToken($endIndex);
+
+        if (null !== $nextIndex && $tokens[$nextIndex]->equals(';')) {
+            $nextIndex = $tokens->getNextMeaningfulToken($nextIndex);
+        }
+
+        if ($token->isGivenKind(T_DO)) {
+            if (null !== $nextIndex && $tokens[$nextIndex]->isGivenKind(T_WHILE)) {
+                return $tokens->getNextMeaningfulToken(
+                    $tokens->findBlockEnd(
+                        Tokens::BLOCK_TYPE_PARENTHESIS_BRACE,
+                        $tokens->getNextMeaningfulToken($nextIndex)
+                    )
+                );
+            }
+        }
+
+        if ($token->isGivenKind([T_IF, T_ELSEIF])) {
+            if (null !== $nextIndex && $tokens[$nextIndex]->isGivenKind([T_ELSE, T_ELSEIF])) {
+                return $this->findControlStructureEndIndex($tokens, $nextIndex, $parentScopeEndIndex);
+            }
+        }
+
+        return $endIndex;
+    }
+
+    private function findControlStructureBodyEndIndex(Tokens $tokens, int $index, int $parentScopeEndIndex): int
+    {
+        $token = $tokens[$index];
+        if ($token->isGivenKind(T_DO)) {
+            $bodyStartIndex = $tokens->getNextMeaningfulToken($index);
+        } elseif ($token->isGivenKind(T_ELSE)) {
+            $bodyStartIndex = $tokens->getNextMeaningfulToken($index);
+        } else {
+            $parenthesisStartIndex = $tokens->getNextTokenOfKind($index, ['(']);
+            $bodyStartIndex = $tokens->getNextMeaningfulToken(
+                $tokens->findBlockEnd(Tokens::BLOCK_TYPE_PARENTHESIS_BRACE, $parenthesisStartIndex)
+            );
+        }
+
+        if ($tokens[$bodyStartIndex]->equals('{')) {
+            return $tokens->findBlockEnd(Tokens::BLOCK_TYPE_CURLY_BRACE, $bodyStartIndex);
+        }
+
+        if ($tokens[$bodyStartIndex]->isGivenKind([T_DO, T_ELSE, T_ELSEIF, T_FOR, T_FOREACH, T_IF, T_WHILE])) {
+            $endIndex = $this->findControlStructureEndIndex($tokens, $bodyStartIndex, $parentScopeEndIndex);
+        } else {
+            $endIndex = $this->findStatementEndIndex($tokens, $bodyStartIndex, $parentScopeEndIndex);
+        }
+
+        return $endIndex;
+    }
+
     /**
      * @return array{int, bool}
      */
