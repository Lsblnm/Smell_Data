+
+ private:
+  template <typename R, typename FormatContext>
+  auto format_string(R&& range, FormatContext& ctx, std::true_type) const
+      -> decltype(ctx.out()) {
+    basic_memory_buffer<Char> buffer;
+    for (auto it = detail::range_begin(range), end = detail::range_end(range);
+         it != end; ++it) {
+      buffer.push_back(*it);
+    }
+    auto out = ctx.out();
+    if (debug_string_format_) {
+      return detail::write_escaped_string(
+          out, basic_string_view<Char>(buffer.data(), buffer.size()));
+    }
+#if FMT_CPLUSPLUS < 202100L
+    *out++ = static_cast<Char>('"');
+    out = detail::copy<Char>(buffer.begin(), buffer.end(), out);
+    *out++ = static_cast<Char>('"');
+    return out;
+#else
+    return detail::copy<Char>(buffer.begin(), buffer.end(), out);
+#endif
+  }
+
+  template <typename R, typename FormatContext>
+  auto format_string(R&&, FormatContext& ctx, std::false_type) const
+      -> decltype(ctx.out()) {
+    return ctx.out();
+  }
 };
 
