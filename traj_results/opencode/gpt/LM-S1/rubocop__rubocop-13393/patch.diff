diff --git a/lib/rubocop/cop/style/guard_clause.rb b/lib/rubocop/cop/style/guard_clause.rb
index aa0c7ec2a..65802b923 100644
--- a/lib/rubocop/cop/style/guard_clause.rb
+++ b/lib/rubocop/cop/style/guard_clause.rb
@@ -149,6 +149,8 @@ module RuboCop
             return
           end
 
+          return if assigned_local_used_in_guard_clause?(node.condition, guard_clause)
+
           guard = nil if and_or_guard_clause?(guard_clause)
 
           register_offense(node, guard_clause_source(guard_clause), kw, guard)
@@ -267,6 +269,15 @@ module RuboCop
           parent.and_type? || parent.or_type?
         end
 
+        def assigned_local_used_in_guard_clause?(condition, guard_clause)
+          assigned_locals = condition.each_node.select(&:lvasgn_type?).map(&:children).map(&:first)
+          return false if assigned_locals.empty?
+
+          guard_clause.each_node(:lvar).any? do |variable|
+            assigned_locals.include?(variable.children.first)
+          end
+        end
+
         def too_long_for_single_line?(node, example)
           max = max_line_length
           max && node.source_range.column + example.length > max
