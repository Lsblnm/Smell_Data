+    /**
+     * Serialize the interval without retaining its source dates or translator.
+     * Those objects may contain non-serializable closures.
+     */
+    public function __serialize(): array
+    {
+        return [
+            'y' => $this->y,
+            'm' => $this->m,
+            'd' => $this->d,
+            'h' => $this->h,
+            'i' => $this->i,
+            's' => $this->s,
+            'f' => $this->f,
+            'invert' => $this->invert,
+            'days' => $this->days,
+            'locale' => $this->locale,
+            'originalInput' => $this->originalInput instanceof Closure ? null : $this->originalInput,
+            'startDate' => $this->startDate,
+            'endDate' => $this->endDate,
+            'rawInterval' => $this->rawInterval,
+            'initialValues' => $this->initialValues,
+        ];
+    }
+
+    /**
+     * Restore a serialized interval, including Carbon 2's timezone setting name.
+     */
+    public function __unserialize(array $data): void
+    {
+        $data = array_combine(
+            array_map(static fn (string $key): string => preg_replace('/^\0(?:\*|[^\0]+)\0/', '', $key), array_keys($data)),
+            $data,
+        );
+
+        parent::__construct(sprintf(
+            'P%dY%dM%dDT%dH%dM%dS',
+            $data['y'] ?? 0,
+            $data['m'] ?? 0,
+            $data['d'] ?? 0,
+            $data['h'] ?? 0,
+            $data['i'] ?? 0,
+            $data['s'] ?? 0,
+        ));
+        $this->f = $data['f'] ?? 0;
+        $this->invert = $data['invert'] ?? 0;
+        $this->originalInput = $data['originalInput'] ?? null;
+        $this->startDate = $data['startDate'] ?? null;
+        $this->endDate = $data['endDate'] ?? null;
+        $this->rawInterval = $data['rawInterval'] ?? null;
+        $this->initialValues = $data['initialValues'] ?? null;
+
+        if (isset($data['locale'])) {
+            $this->locale($data['locale']);
+        }
+
+        if (($timezone = $data['timezoneSetting'] ?? $data['tzName'] ?? null) !== null) {
+            $this->setTimezone($timezone);
+        }
