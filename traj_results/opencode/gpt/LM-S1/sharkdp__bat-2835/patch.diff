+    fn print_header_component(
+        &mut self,
+        handle: &mut OutputHandle,
+        prefix: &str,
+        value: &str,
+        suffix: &str,
+    ) -> Result<()> {
+        let indent_width = if self.panel_width > 0 && self.config.style_components.grid() {
+            self.panel_width + 2
+        } else {
+            0
+        };
+        let max_width = self.config.term_width.saturating_sub(indent_width);
+        let text_width = prefix
+            .chars()
+            .chain(value.chars())
+            .chain(suffix.chars())
+            .map(|c| c.width().unwrap_or(0))
+            .sum::<usize>();
+
+        if !matches!(self.config.wrapping_mode, WrappingMode::Character)
+            || max_width == 0
+            || text_width <= max_width
+        {
+            self.print_header_component_indent(handle)?;
+            return writeln!(
+                handle,
+                "{}{}{}",
+                prefix,
+                self.colors.header_value.paint(value),
+                suffix
+            );
+        }
+
+        self.print_header_component_indent(handle)?;
+        let mut width = 0;
+        for (text, styled) in [(prefix, false), (value, true), (suffix, false)] {
+            for c in text.chars() {
+                let char_width = c.width().unwrap_or(0);
+                if width > 0 && width + char_width > max_width {
+                    writeln!(handle)?;
+                    self.print_header_component_indent(handle)?;
+                    width = 0;
+                }
+
+                if styled {
+                    write!(handle, "{}", self.colors.header_value.paint(c.to_string()))?;
+                } else {
+                    write!(handle, "{}", c)?;
+                }
+                width += char_width;
+            }
+        }
+        writeln!(handle)
+    }
+
