+    #[test]
+    fn replacement_multi_line_does_not_capture_past_match() {
+        let matcher = RegexMatcherBuilder::new()
+            .line_terminator(Some(b'\x00'))
+            .build(
+                r"(?m)^(?P<docs>(# .*\n)*)(?P<name>pipc) \(\) \{(  #(?P<usage> .+))?",
+            )
+            .unwrap();
+        let mut printer = StandardBuilder::new()
+            .replacement(Some(b"$usage".to_vec()))
+            .build(NoColor::new(vec![]));
+        SearcherBuilder::new()
+            .multi_line(true)
+            .build()
+            .search_reader(
+                &matcher,
+                "# docs\npipc () {  # usage\n    next\n".as_bytes(),
+                printer.sink(&matcher),
+            )
+            .unwrap();
+
+        let got = printer_contents(&mut printer);
+        assert_eq_printed!(" usage\n", got);
+    }
