+func TestLabels_DropMetricNameDoesNotModifySource(t *testing.T) {
+	original := make(Labels, 3, 4)
+	original[0] = Label{Name: "__address__", Value: "bar"}
+	original[1] = Label{Name: MetricName, Value: "metric"}
+	original[2] = Label{Name: "job", Value: "1"}
+
+	require.True(t, Equal(FromStrings("__address__", "bar", "job", "1"), original.DropMetricName()))
+	require.True(t, Equal(FromStrings("__address__", "bar", MetricName, "metric", "job", "1"), original))
+}
