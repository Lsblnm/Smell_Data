+block gen_location(location loc, struct locfile* l, block b) {
+  inst *i;
+  const struct opcode_description *desc;
+
+  if (b.first == NULL && b.last == NULL)
+    return b;
+
+  for (i = b.first; i != NULL; i = i->next) {
+    desc = opcode_describe(i->op);
+    if (i->source.start == UNKNOWN_LOCATION.start &&
+        i->source.end == UNKNOWN_LOCATION.end &&
+        desc->length >= 0) {
+      i->source.start = loc.start;
+      i->source.end = loc.end;
+      if (l->jq != NULL) {
+        l->refct++;
+        i->locfile = l;
+      }
+    }
+    if (i == b.last)
+      break;
+  }
+  return b;
+}
