+fn write_filename_output<E: Display>(prefix: &str, filename: &Path, ending: E) -> io::Result<()> {
+    let mut output = stdout();
+    output.write_all(prefix.as_bytes())?;
+    #[cfg(unix)]
+    {
+        use std::os::unix::ffi::OsStrExt;
+
+        output.write_all(filename.as_os_str().as_bytes())?;
+    }
+    #[cfg(not(unix))]
+    write!(output, "{}", filename.display())?;
+    write!(output, "{ending}")
+}
