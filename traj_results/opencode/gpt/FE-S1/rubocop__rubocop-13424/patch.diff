diff --git a/lib/rubocop/cop/style/safe_navigation.rb b/lib/rubocop/cop/style/safe_navigation.rb
index 24ef2ef30..86f9dfdc7 100644
--- a/lib/rubocop/cop/style/safe_navigation.rb
+++ b/lib/rubocop/cop/style/safe_navigation.rb
@@ -202,6 +202,7 @@ module RuboCop
             # If the RHS is an `or` we cannot safely autocorrect because in order to remove
             # the non-nil check we need to add safe-navs to all clauses where the receiver is used
             next if and_with_rhs_or?(node)
+            next if safe_navigation_chain_too_long?(rhs_receiver, rhs)
 
             removal_ranges.each { |range| corrector.remove(range) }
             yield corrector if block_given?
@@ -416,6 +417,26 @@ module RuboCop
           end
         end
 
+        def safe_navigation_chain_too_long?(start_method, method_chain)
+          return false unless processed_source.registry.enabled?(SafeNavigationChainLength, config)
+
+          safe_navigation_chain_length = 0
+
+          start_method.each_ancestor do |ancestor|
+            break unless %i[send block].include?(ancestor.type)
+            next unless ancestor.call_type?
+
+            safe_navigation_chain_length += 1
+            break if ancestor == method_chain
+          end
+
+          safe_navigation_chain_length > safe_navigation_chain_max
+        end
+
+        def safe_navigation_chain_max
+          config.for_cop('Style/SafeNavigationChainLength')['Max'] || 2
+        end
+
         def max_chain_length
           cop_config.fetch('MaxChainLength', 2)
         end
