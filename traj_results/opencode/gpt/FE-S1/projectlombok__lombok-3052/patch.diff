 		int modifiers = this.defaultProviderModifiers;
 		return maker.MethodDef(maker.Modifiers(modifiers), methodName, cloneType(maker, fieldType, fieldNode), copyTypeParams(fieldNode, typeParams), List.<JCVariableDecl>nil(), List.<JCExpression>nil(), body, null);
