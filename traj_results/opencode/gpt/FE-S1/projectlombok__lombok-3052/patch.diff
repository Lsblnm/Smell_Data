+
+	public IdentityHashMap<JCTree, Integer> getDefaultProviderInitializerPositions(JCMethodDecl provider) {
+		final IdentityHashMap<JCTree, Integer> positions = new IdentityHashMap<JCTree, Integer>();
+		((JCReturn) provider.body.stats.head).expr.accept(new TreeScanner() {
+			@Override public void scan(JCTree tree) {
+				if (tree == null) return;
+				positions.put(tree, tree.pos);
+				super.scan(tree);
+			}
+		});
+		return positions;
+	}
+
+	public void restoreDefaultProviderInitializerPositions(IdentityHashMap<JCTree, Integer> positions) {
+		for (java.util.Map.Entry<JCTree, Integer> entry : positions.entrySet()) entry.getKey().pos = entry.getValue();
+	}
+
 }
