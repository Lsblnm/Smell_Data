+    fn call(&mut self, mut req: Request<B>) -> Self::Future {
+        let state = match req.extensions_mut().remove::<S>() {
+            Some(state) => state,
+            None if TypeId::of::<S>() == TypeId::of::<()>() => *(Box::new(()) as Box<dyn Any>)
+                .downcast::<S>()
+                .expect("state type should be unit"),
+            None => panic!("state extension missing. This is a bug in axum, please file an issue"),
+        };
+        let mut route = self.fallback_route(state.clone());
+        route.call_with_state(self, req, state)
     }
