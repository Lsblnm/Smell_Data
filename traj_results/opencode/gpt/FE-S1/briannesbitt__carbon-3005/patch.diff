     protected ?array $initialValues = null;
 
+    /**
+     * Serialize the interval without its translator, which may contain closures.
+     */
+    public function __serialize(): array
+    {
+        $data = array_intersect_key(parent::__serialize(), array_flip([
+            'y', 'm', 'd', 'h', 'i', 's', 'f', 'invert', 'days', 'from_string', 'date_string',
+        ]));
+
+        return $data + [
+            'timezoneSetting' => $this->timezoneSetting,
+            'originalInput' => $this->originalInput,
+            'startDate' => $this->startDate,
+            'endDate' => $this->endDate,
+            'rawInterval' => $this->rawInterval,
+            'initialValues' => $this->initialValues,
+            'step' => $this->step,
+            'localMonthsOverflow' => $this->localMonthsOverflow,
+            'localYearsOverflow' => $this->localYearsOverflow,
+            'localStrictModeEnabled' => $this->localStrictModeEnabled,
+            'localHumanDiffOptions' => $this->localHumanDiffOptions,
+            'locale' => $this->getTranslatorLocale(),
+        ];
+    }
+
+    /**
+     * Restore intervals serialized by Carbon 2 and Carbon 3.
+     */
+    public function __unserialize(array $data): void
+    {
+        $locale = $data['locale'] ?? null;
+
+        if (isset($data['tzName']) && !isset($data['timezoneSetting'])) {
+            $data['timezoneSetting'] = $data['tzName'];
+        }
+
+        $properties = [
+            'timezoneSetting',
+            'originalInput',
+            'startDate',
+            'endDate',
+            'rawInterval',
+            'initialValues',
+            'step',
+            'localMonthsOverflow',
+            'localYearsOverflow',
+            'localStrictModeEnabled',
+            'localHumanDiffOptions',
+        ];
+        $values = [];
+
+        foreach ($properties as $property) {
+            if (array_key_exists($property, $data)) {
+                $values[$property] = $data[$property];
+                unset($data[$property]);
+            }
+        }
+        unset($data['locale'], $data['tzName']);
+
+        parent::__unserialize($data);
+
+        foreach ($values as $property => $value) {
+            $this->$property = $value;
+        }
+
+        if ($locale !== null) {
+            $this->locale($locale);
+        }
+    }
