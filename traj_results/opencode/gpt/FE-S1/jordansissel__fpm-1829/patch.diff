diff --git a/lib/fpm/util/tar_writer.rb b/lib/fpm/util/tar_writer.rb
index be11ef5..1c218b6 100644
--- a/lib/fpm/util/tar_writer.rb
+++ b/lib/fpm/util/tar_writer.rb
@@ -123,6 +123,12 @@ class FPM::Util::TarWriter < ::Gem::Package::TarWriter
       logger.warn("Replacing 'provides' entry #{provides} with syntax 'name (= version)'")
       provides = "#{m[1]} (= #{m[2]})"
     end
+
+    unless provides =~ /^[a-z0-9][a-z0-9+.-]*( \(= [^\s()]+\))?$/
+      raise FPM::InvalidPackageConfiguration,
+        "Invalid Debian provides '#{provides}': versioned provides must use '='"
+    end
+
     return provides.rstrip
   end
 end
