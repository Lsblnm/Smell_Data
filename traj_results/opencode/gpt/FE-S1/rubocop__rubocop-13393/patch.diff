diff --git a/lib/rubocop/cop/style/guard_clause.rb b/lib/rubocop/cop/style/guard_clause.rb
index 3b12d5a48..0daa4b135 100644
--- a/lib/rubocop/cop/style/guard_clause.rb
+++ b/lib/rubocop/cop/style/guard_clause.rb
@@ -151,7 +151,7 @@ module RuboCop
 
           guard = nil if and_or_guard_clause?(guard_clause)
 
-          register_offense(node, guard_clause_source(guard_clause), kw, guard)
+          register_offense(node, guard_clause_source(guard_clause), kw, guard, guard_clause)
         end
 
         def if_then_replacement(if_then_corrector, node = nil, leading_indent = nil)
@@ -222,8 +222,11 @@ module RuboCop
           end
         end
 
-        def register_offense(node, scope_exiting_keyword, conditional_keyword, guard = nil)
+        def register_offense(node, scope_exiting_keyword, conditional_keyword, guard = nil,
+                             guard_clause = nil)
           condition, = node.node_parts
+          return if guard_clause && use_variable_assignment_in_condition?(condition, guard_clause)
+
           example = [scope_exiting_keyword, conditional_keyword, condition.source].join(' ')
           if too_long_for_single_line?(node, example)
             return if trivial?(node)
@@ -304,6 +307,15 @@ module RuboCop
           parent.and_type? || parent.or_type?
         end
 
+        def use_variable_assignment_in_condition?(condition, guard_clause)
+          assigned_variables = condition.each_descendant(:lvasgn).map { |node| node.children.first }
+          assigned_variables << condition.children.first if condition.lvasgn_type?
+
+          guard_clause.each_descendant(:lvar).any? do |variable|
+            assigned_variables.include?(variable.children.first)
+          end
+        end
+
         def too_long_for_single_line?(node, example)
           max = max_line_length
           max && node.source_range.column + example.length > max
