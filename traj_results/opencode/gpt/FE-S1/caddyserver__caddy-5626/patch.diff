+func TestNestedSnippetImportInDirectiveBlock(t *testing.T) {
+	p := testParser(`
+		(responderWithStatus) {
+			respond {args[0]} {args[1]}
+		}
+
+		(responder) {
+			import responderWithStatus {args[0]} 202
+		}
+
+		http://127.0.0.1:8080 {
+			handle {
+				import responder "foobar"
+			}
+		}
+	`)
+	blocks, err := p.parseAll()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(blocks) != 1 || len(blocks[0].Segments) != 1 {
+		t.Fatalf("expected one directive segment, got %+v", blocks)
+	}
+	segment := blocks[0].Segments[0]
+	if len(segment) != 6 || segment[2].Text != "respond" || segment[3].Text != "foobar" || segment[4].Text != "202" {
+		t.Fatalf("nested snippet import was not expanded: %+v", segment)
+	}
+}
