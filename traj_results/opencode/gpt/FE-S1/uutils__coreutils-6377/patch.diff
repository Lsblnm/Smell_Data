+#[cfg(unix)]
+fn apply_ignored_signals(opts: &Options<'_>) -> UResult<()> {
+    for value in &opts.ignored_signals {
+        for signal_name in value.split(',').filter(|name| !name.is_empty()) {
+            let normalized_name = signal_name.to_ascii_uppercase();
+            let signal_number = uucore::signals::signal_by_name_or_value(&normalized_name)
+                .ok_or_else(|| {
+                    USimpleError::new(125, format!("{}: invalid signal", signal_name.quote()))
+                })?;
+            let signal = Signal::try_from(signal_number as i32).map_err(|_| {
+                USimpleError::new(125, format!("{}: invalid signal", signal_name.quote()))
+            })?;
+
+            // SAFETY: We install the standard ignore disposition rather than a custom handler.
+            unsafe {
+                sigaction(
+                    signal,
+                    &SigAction::new(SigHandler::SigIgn, SaFlags::empty(), SigSet::empty()),
+                )
+            }
+            .map_err(|error| {
+                USimpleError::new(
+                    125,
+                    format!(
+                        "failed to set signal action for signal {}: {}",
+                        signal as i32,
+                        error.desc()
+                    ),
+                )
+            })?;
+        }
+    }
+    Ok(())
+}
+
+#[cfg(not(unix))]
+fn apply_ignored_signals(_opts: &Options<'_>) -> UResult<()> {
+    Ok(())
+}
