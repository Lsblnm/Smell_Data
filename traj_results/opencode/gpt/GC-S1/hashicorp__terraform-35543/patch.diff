+// validateImportTargets validates the expressions belonging to import blocks
+// associated with this resource. Import blocks are not expanded during
+// validation, but their target and ID expressions must still be valid.
+func (n *NodeValidatableResource) validateImportTargets(ctx EvalContext) tfdiags.Diagnostics {
+	var diags tfdiags.Diagnostics
+
+	for _, imp := range n.importTargets {
+		if imp.Config == nil {
+			continue
+		}
+
+		if imp.Config.ForEach == nil {
+			to, moreDiags := evalImportToExpression(imp.Config.To, EvalDataForNoInstanceKey)
+			diags = diags.Append(moreDiags)
+			if moreDiags.HasErrors() {
+				continue
+			}
+			_, moreDiags = evaluateImportIdExpression(imp.Config.ID, to, ctx, EvalDataForNoInstanceKey, true)
+			diags = diags.Append(moreDiags)
+			continue
+		}
+
+		forEachData, known, moreDiags := newForEachEvaluator(imp.Config.ForEach, ctx, true).ImportValues()
+		diags = diags.Append(moreDiags)
+		if moreDiags.HasErrors() {
+			continue
+		}
+		if !known {
+			forEachData = []instances.RepetitionData{instances.UnknownForEachRepetitionData(cty.DynamicPseudoType)}
+		}
+		for _, keyData := range forEachData {
+			to, moreDiags := evalImportToExpression(imp.Config.To, keyData)
+			diags = diags.Append(moreDiags)
+			if moreDiags.HasErrors() {
+				continue
+			}
+			_, moreDiags = evaluateImportIdExpression(imp.Config.ID, to, ctx, keyData, true)
+			diags = diags.Append(moreDiags)
+		}
+	}
+
+	return diags
+}
