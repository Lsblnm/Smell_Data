+func TestClientIPMatcherUnmarshalCaddyfileMultipleSegments(t *testing.T) {
+	d := caddyfile.NewTestDispenser(`
+		client_ip 192.0.2.1
+		client_ip 198.51.100.1 203.0.113.1
+	`)
+	var matcher MatchClientIP
+	if err := matcher.UnmarshalCaddyfile(d); err != nil {
+		t.Fatal(err)
+	}
+
+	expected := []string{"192.0.2.1", "198.51.100.1", "203.0.113.1"}
+	if !reflect.DeepEqual(expected, matcher.Ranges) {
+		t.Errorf("expected ranges %v, got %v", expected, matcher.Ranges)
+	}
+}
