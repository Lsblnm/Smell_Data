+    fn normalize_paging_aliases(args: Vec<OsString>) -> Vec<OsString> {
+        let mut normalized = Vec::with_capacity(args.len());
+        let mut plain_count = 0;
+
+        for arg in args {
+            match arg.to_str() {
+                Some("-P") | Some("--no-paging") | Some("--no-pager") => {
+                    normalized.push("--paging=never".into());
+                }
+                Some("-p") | Some("--plain") => {
+                    plain_count += 1;
+                    normalized.push(arg);
+                    if plain_count == 2 {
+                        normalized.push("--paging=never".into());
+                    }
+                }
+                Some(short)
+                    if short.len() > 2
+                        && short.starts_with('-')
+                        && short[1..].chars().all(|c| c == 'p') =>
+                {
+                    for _ in 1..short.len() {
+                        plain_count += 1;
+                        normalized.push("-p".into());
+                        if plain_count == 2 {
+                            normalized.push("--paging=never".into());
+                        }
+                    }
+                }
+                _ => normalized.push(arg),
+            }
+        }
+
+        normalized
+    }
