+#[cfg(unix)]
+fn apply_ignore_signals(opts: &Options<'_>) -> UResult<()> {
+    let Some(signals) = opts.ignore_signal else {
+        return Ok(());
+    };
+
+    let signals = signals.to_string_lossy();
+    if signals.is_empty() {
+        return Ok(());
+    }
+
+    let mut parsed_signals = Vec::new();
+    for signal_name in signals.split(',') {
+        let normalized = signal_name.to_ascii_uppercase();
+        let Some(signal_number) = uucore::signals::signal_by_name_or_value(&normalized) else {
+            return Err(USimpleError::new(
+                125,
+                format!("{}: invalid signal", signal_name.quote()),
+            ));
+        };
+        let Ok(signal) = Signal::try_from(signal_number as i32) else {
+            return Err(USimpleError::new(
+                125,
+                format!("{}: invalid signal", signal_name.quote()),
+            ));
+        };
+        parsed_signals.push(signal);
+    }
+
+    for signal in parsed_signals {
+        // SAFETY: This only installs the predefined ignore disposition.
+        unsafe {
+            sigaction(
+                signal,
+                &SigAction::new(SigHandler::SigIgn, SaFlags::empty(), SigSet::empty()),
+            )
+        }
+        .map_err(|error| {
+            USimpleError::new(
+                125,
+                format!(
+                    "failed to set signal action for signal {}: {}",
+                    signal as i32,
+                    error.desc()
+                ),
+            )
+        })?;
+    }
+
+    Ok(())
+}
+
+#[cfg(not(unix))]
+fn apply_ignore_signals(_opts: &Options<'_>) -> UResult<()> {
+    Ok(())
+}
