+
+  template <int BITS, typename OutputIt, typename UInt>
+  auto write_grouped(OutputIt out, UInt value, unsigned prefix,
+                     const format_specs<Char>& specs, bool upper = false) const
+      -> OutputIt {
+    static_assert(std::is_same<uint64_or_128_t<UInt>, UInt>::value, "");
+    int num_digits = count_digits<BITS>(value);
+    char digits[40];
+    format_uint<BITS>(digits, value, num_digits, upper);
+    unsigned size = to_unsigned(prefix_visible_width(prefix) + num_digits +
+                                count_separators(num_digits));
+    return write_padded<align::right>(
+        out, specs, size, size, [&](reserve_iterator<OutputIt> it) {
+          for (unsigned p = prefix & 0xffffff; p != 0; p >>= 8)
+            *it++ = static_cast<Char>(p & 0xff);
           return apply(it, string_view(digits, to_unsigned(num_digits)));
         });
   }
@@ -6374,8 +6391,40 @@ template <typename Char = char> struct loc_writer {
     auto arg = make_write_int_arg(value, specs.sign);
     auto groupinger = digit_grouping<Char>(grouping, sep);
     groupinger.bind_decimal_point(decimal_point);
-    write_int(out, static_cast<uint64_or_128_t<T>>(arg.abs_value), arg.prefix,
-              specs, groupinger);
+    auto abs_value = static_cast<uint64_or_128_t<T>>(arg.abs_value);
+    auto prefix = arg.prefix;
+    switch (specs.type) {
+    case presentation_type::none:
+    case presentation_type::dec:
+      write_int(out, abs_value, prefix, specs, groupinger);
+      break;
+    case presentation_type::hex_lower:
+    case presentation_type::hex_upper: {
+      bool upper = specs.type == presentation_type::hex_upper;
+      if (specs.alt)
+        prefix_append(prefix, unsigned(upper ? 'X' : 'x') << 8 | '0');
+      groupinger.template write_grouped<4>(out, abs_value, prefix, specs,
+                                            upper);
+      break;
+    }
+    case presentation_type::bin_lower:
+    case presentation_type::bin_upper: {
+      bool upper = specs.type == presentation_type::bin_upper;
+      if (specs.alt)
+        prefix_append(prefix, unsigned(upper ? 'B' : 'b') << 8 | '0');
+      groupinger.template write_grouped<1>(out, abs_value, prefix, specs);
+      break;
+    }
+    case presentation_type::oct:
+      if (specs.alt && abs_value != 0) prefix_append(prefix, '0');
+      groupinger.template write_grouped<3>(out, abs_value, prefix, specs);
+      break;
+    case presentation_type::chr:
+      write_char(out, static_cast<Char>(abs_value), specs);
+      break;
+    default:
+      throw_format_error("invalid format specifier");
+    }
     return true;
