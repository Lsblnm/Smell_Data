+void mp_call_check_kwarg_duplicates(const mp_obj_t *args, size_t start, size_t end, mp_obj_t key) {
+    for (size_t i = start; i < end; i += 2) {
+        if (args[i] == key) {
+            mp_raise_TypeError(MP_ERROR_TEXT("multiple values for keyword argument"));
+        }
+    }
+}
