diff --git a/lib/jekyll/reader.rb b/lib/jekyll/reader.rb
index 423a333a4..9536d1d53 100644
--- a/lib/jekyll/reader.rb
+++ b/lib/jekyll/reader.rb
@@ -29,6 +29,7 @@ module Jekyll
     # Returns nothing.
     def read_data
       @site.data = filter_coordinator.read_site_and_theme_data
+      add_data_dependencies
     end
 
     # Sorts posts, pages, and static files.
@@ -214,5 +215,19 @@ module Jekyll
     def filter_coordinator
       @filter_coordinator ||= EntryFilter.new(site)
     end
+
+    def add_data_dependencies
+      data_dir = site.in_source_dir(site.config["data_dir"])
+      dependencies = Dir[File.join(data_dir, "**", "*")].select do |path|
+        File.directory?(path) || %w(.csv .json .tsv .yaml .yml).include?(File.extname(path).downcase)
+      end
+      dependencies << data_dir if File.directory?(data_dir)
+
+      (site.pages + site.documents).each do |document|
+        path = site.in_source_dir(document.path)
+        site.regenerator.add(path) unless site.regenerator.metadata.key?(path)
+        dependencies.each { |dependency| site.regenerator.add_dependency(path, dependency) }
+      end
+    end
   end
 end
