+++ b/lib/helpers/formDataToStream.js
@@ -0,0 +1,83 @@
+'use strict';
+
+import stream from 'stream';
+import utils from '../utils.js';
+
+const CRLF = '\r\n';
+const textEncoder = new TextEncoder();
+const isBlob = (value) => utils.isBlob(value) || utils.isFile(value);
+
+const escapeName = (name) => String(name).replace(/[\r\n"]/g, match => ({
+  '\r': '%0D',
+  '\n': '%0A',
+  '"': '%22'
+}[match]));
+
+const encodeText = (value) => textEncoder.encode(String(value).replace(/\r?\n|\r\n?/g, CRLF));
+
+class FormDataPart {
+  constructor(name, value) {
+    const isBlobValue = isBlob(value);
+    const headers = [
+      `Content-Disposition: form-data; name="${escapeName(name)}"${isBlobValue ? `; filename="${escapeName(value.name || 'blob')}"` : ''}`
+    ];
+
+    if (isBlobValue) {
+      headers.push(`Content-Type: ${value.type || 'application/octet-stream'}`);
+    }
+
+    this.headers = textEncoder.encode(headers.join(CRLF) + CRLF + CRLF);
+    this.value = value;
+    this.size = this.headers.byteLength + (isBlobValue ? value.size : encodeText(value).byteLength) + textEncoder.encode(CRLF).byteLength;
+  }
+
+}
+
+export default function formDataToStream(form, headersHandler) {
+  const boundary = `axios-${Math.random().toString(16).slice(2)}`;
+  const boundaryBytes = textEncoder.encode(`--${boundary}${CRLF}`);
+  const footerBytes = textEncoder.encode(`--${boundary}--${CRLF}${CRLF}`);
+  const parts = Array.from(form.entries(), ([name, value]) => new FormDataPart(name, value));
+  const contentLength = parts.reduce((length, part) => length + boundaryBytes.byteLength + part.size, footerBytes.byteLength);
+
+  headersHandler({
+    'Content-Type': `multipart/form-data; boundary=${boundary}`,
+    'Content-Length': contentLength
+  });
+
+  const readable = new stream.Readable({
+    read() {}
+  });
+
+  const processPart = (index) => {
+    if (index === parts.length) {
+      readable.push(footerBytes);
+      readable.push(null);
+      return;
+    }
+
+    const part = parts[index];
+    readable.push(boundaryBytes);
+    readable.push(part.headers);
+
+    if (!isBlob(part.value)) {
+      readable.push(encodeText(part.value));
+      readable.push(textEncoder.encode(CRLF));
+      processPart(index + 1);
+      return;
+    }
+
+    const valueStream = stream.Readable.fromWeb(part.value.stream());
+
+    valueStream.on('data', chunk => readable.push(chunk));
+    valueStream.on('end', () => {
+      readable.push(textEncoder.encode(CRLF));
+      processPart(index + 1);
+    });
+    valueStream.on('error', err => readable.destroy(err));
+  };
+
+  processPart(0);
+
+  return readable;
+}
