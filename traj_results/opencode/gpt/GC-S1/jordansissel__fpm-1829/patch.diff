diff --git a/lib/fpm/package/deb.rb b/lib/fpm/package/deb.rb
index aa91911..88c8aa4 100644
--- a/lib/fpm/package/deb.rb
+++ b/lib/fpm/package/deb.rb
@@ -791,6 +791,13 @@ class FPM::Package::Deb < FPM::Package
       logger.warn("Replacing 'provides' entry #{provides} with syntax 'name (= version)'")
       provides = "#{m[1]} (= #{m[2]})"
     end
+
+    # Debian permits only exact version relations in Provides fields.
+    unless provides =~ /\A[A-Za-z0-9][A-Za-z0-9+.-]*(?:\s+\(=\s+[^\s()]+\))?\z/
+      raise FPM::InvalidPackageConfiguration,
+        "Invalid Debian Provides entry '#{provides}': versioned provides must use '='"
+    end
+
     return provides.rstrip
   end
 
