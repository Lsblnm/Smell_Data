+    fn print_header_component(
+        &mut self,
+        handle: &mut OutputHandle,
+        label: &str,
+        value: &str,
+        suffix: &str,
+    ) -> Result<()> {
+        let indent_width = self.panel_width
+            + if self.config.style_components.grid() && self.panel_width > 0 {
+                2
+            } else {
+                0
+            };
+        let line_width = self.config.term_width.saturating_sub(indent_width).max(1);
+        let mut parts = [String::new(), String::new(), String::new()];
+        let mut current_width = 0;
+
+        for (part_index, text) in [(0, label), (1, value), (2, suffix)] {
+            for character in text.chars() {
+                let character_width = UnicodeWidthChar::width(character).unwrap_or(0);
+                if current_width > 0 && current_width + character_width > line_width {
+                    self.print_header_component_indent(handle)?;
+                    writeln!(
+                        handle,
+                        "{}{}{}",
+                        parts[0],
+                        self.colors.header_value.paint(&parts[1]),
+                        parts[2]
+                    )?;
+                    parts = [String::new(), String::new(), String::new()];
+                    current_width = 0;
+                }
+
+                parts[part_index].push(character);
+                current_width += character_width;
+            }
+        }
+
+        self.print_header_component_indent(handle)?;
+        writeln!(
+            handle,
+            "{}{}{}",
+            parts[0],
+            self.colors.header_value.paint(&parts[1]),
+            parts[2]
+        )
+    }
+
