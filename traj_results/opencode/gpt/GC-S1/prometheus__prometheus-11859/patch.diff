+func TestLastChunkSnapshotUsesMostRecentSnapshot(t *testing.T) {
+	dir := t.TempDir()
+	oldSnapshot := chunkSnapshotDir(178079, 114884608)
+	newSnapshot := chunkSnapshotDir(13482, 1871216)
+	require.NoError(t, os.Mkdir(filepath.Join(dir, oldSnapshot), 0o777))
+	require.NoError(t, os.Mkdir(filepath.Join(dir, newSnapshot), 0o777))
+
+	oldTime := time.Now().Add(-time.Hour)
+	require.NoError(t, os.Chtimes(filepath.Join(dir, oldSnapshot), oldTime, oldTime))
+
+	name, idx, offset, err := LastChunkSnapshot(dir)
+	require.NoError(t, err)
+	require.Equal(t, filepath.Join(dir, newSnapshot), name)
+	require.Equal(t, 13482, idx)
+	require.Equal(t, 1871216, offset)
+}
