+template <typename Char = char> struct loc_writer {
+  buffer_appender<Char> out;
+  const format_specs<Char>& specs;
+  std::basic_string<Char> sep;
+  std::string grouping;
+  std::basic_string<Char> decimal_point;
+
+  template <typename T, FMT_ENABLE_IF(is_integer<T>::value)>
+  auto operator()(T value) -> bool {
+    auto arg = make_write_int_arg(value, specs.sign);
+    auto digit_groups = digit_grouping<Char>(this->grouping, sep);
+    switch (specs.type) {
+    case presentation_type::none:
+    case presentation_type::dec:
+      write_int(out, static_cast<uint64_or_128_t<T>>(arg.abs_value), arg.prefix,
+                specs, digit_groups);
+      return true;
+    case presentation_type::hex_lower:
+    case presentation_type::hex_upper: {
+      bool upper = specs.type == presentation_type::hex_upper;
+      if (specs.alt)
+        prefix_append(arg.prefix, unsigned(upper ? 'X' : 'x') << 8 | '0');
+      int num_digits = count_digits<4>(arg.abs_value);
+      write_int(out, num_digits + digit_groups.count_separators(num_digits),
+                arg.prefix, specs, [=](reserve_iterator<buffer_appender<Char>> it) {
+                  char digits[40];
+                  format_uint<4, char>(digits, arg.abs_value, num_digits, upper);
+                  return digit_groups.apply(
+                      it, basic_string_view<char>(digits, to_unsigned(num_digits)));
+                });
+      return true;
+    }
+    case presentation_type::bin_lower:
+    case presentation_type::bin_upper: {
+      if (specs.alt)
+        prefix_append(arg.prefix,
+                      unsigned(specs.type == presentation_type::bin_upper ? 'B' : 'b') << 8 | '0');
+      int num_digits = count_digits<1>(arg.abs_value);
+      write_int(out, num_digits + digit_groups.count_separators(num_digits),
+                arg.prefix, specs, [=](reserve_iterator<buffer_appender<Char>> it) {
+                  char digits[128];
+                  format_uint<1, char>(digits, arg.abs_value, num_digits, false);
+                  return digit_groups.apply(
+                      it, basic_string_view<char>(digits, to_unsigned(num_digits)));
+                });
+      return true;
+    }
+    case presentation_type::oct: {
+      int num_digits = count_digits<3>(arg.abs_value);
+      if (specs.alt && specs.precision <= num_digits && arg.abs_value != 0)
+        prefix_append(arg.prefix, '0');
+      write_int(out, num_digits + digit_groups.count_separators(num_digits),
+                arg.prefix, specs, [=](reserve_iterator<buffer_appender<Char>> it) {
+                  char digits[43];
+                  format_uint<3, char>(digits, arg.abs_value, num_digits, false);
+                  return digit_groups.apply(
+                      it, basic_string_view<char>(digits, to_unsigned(num_digits)));
+                });
+      return true;
+    }
+    default:
+      return false;
+    }
+  }
+
+  template <typename T, FMT_ENABLE_IF(!is_integer<T>::value)>
+  auto operator()(T) -> bool {
+    return false;
+  }
+};
