@@ -359,6 +359,29 @@ template <typename R>
 using maybe_const_range =
     conditional_t<has_const_begin_end<R>::value, const R, R>;
 
+template <typename T, typename Char, bool = std::is_same<T, Char>::value>
+struct range_string_formatter {
+  template <typename R, typename FormatContext>
+  static auto format(R&&, FormatContext& ctx, bool) -> decltype(ctx.out()) {
+    return ctx.out();
+  }
+};
+
+template <typename Char> struct range_string_formatter<Char, Char, true> {
+  template <typename R, typename FormatContext>
+  static auto format(R&& range, FormatContext& ctx, bool debug)
+      -> decltype(ctx.out()) {
+    basic_memory_buffer<Char> buffer;
+    for (auto it = detail::range_begin(range), end = detail::range_end(range);
+         it != end; ++it) {
+      buffer.push_back(*it);
+    }
+    auto view = basic_string_view<Char>(buffer.data(), buffer.size());
+    return debug ? detail::write_escaped_string(ctx.out(), view)
+                 : detail::copy<Char>(view.begin(), view.end(), ctx.out());
+  }
+};
+
