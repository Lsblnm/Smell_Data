ltype(detail::range_begin(std::declval<const remove_cvref_t<T>&>())),\n100:         decltype(detail::range_end(std::declval<const remove_cvref_t<T>&>()))>>\n101:     : std::true_type {};\n102: \n103: template <typename T>\n104: struct has_mutable_begin_end<\n105:     T, void_t<decltype(detail::range_begin(std::declval<T&>())),\n106:               decltype(detail::range_end(std::declval<T&>())),\n107:               // the extra int here is because older versions of MSVC don't\n108:               // SFINAE properly unless there are distinct types\n109:               int>> : std::true_type {};\n110: \n111: template <typename T>\n112: struct is_range_<T, void>\n113:     : std::integral_constant<bool, (has_const_begin_end<T>::value ||\n114:                                     has_mutable_begin_end<T>::value)> {};\n115: #  undef FMT_DECLTYPE_RETURN\n116: #endif\n117: \n118: // tuple_size and tuple_element check.\n119: template <typename T> class is_tuple_like_ {\n120:   template <typename U>\n121:   static auto check(U* p) -> decltype(std::tuple_size<U>::value, int());\n122:   template <typename> static void check(...);\n123: \n124:  public:\n125:   static constexpr const bool value =\n126:       !std::is_void<decltype(check<T>(nullptr))>::value;\n127: };\n128: \n129: // Check for integer_sequence\n130: #if defined(__cpp_lib_integer_sequence) || FMT_MSC_VERSION >= 1900\n131: template <typename T, T... N>\n132: using integer_sequence = std::integer_sequence<T, N...>;\n133: template <size_t... N> using index_sequence = std::index_sequence<N...>;\n134: template <size_t N> using make_index_sequence = std::make_index_sequence<N>;\n135: #else\n136: template <typename T, T... N> struct integer_sequence {\n137:   using value_type = T;\n138: \n139:   static FMT_CONSTEXPR auto size() -> size_t { return sizeof...(N); }\n140: };\n141: \n142: template <size_t... N> using index_sequence = integer_sequence<size_t, N...>;\n143: \n144: template <typename T, size_t N, T... Ns>\n145: struct make_integer_sequence : make_integer_sequence<T, N - 1, N - 1, Ns...> {};\n146: template <typename T, T... Ns>\n147: struct make_integer_sequence<T, 0, Ns...> : integer_sequence<T, Ns...> {};\n148: \n149: template <size_t N>\n150: using make_index_sequence = make_integer_sequence<size_t, N>;\n151: #endif\n152: \n153: template <typename T>\n154: using tuple_index_sequence = make_index_sequence<std::tuple_size<T>::value>;\n155: \n156: template <typename T, typename C, bool = is_tuple_like_<T>::value>\n157: class is_tuple_formattable_ {\n158:  public:\n159:   static constexpr const bool value = false;\n160: };\n161: template <typename T, typename C> class is_tuple_formattable_<T, C, true> {\n162:   template <size_t... Is>\n163:   static auto all_true(index_sequence<Is...>,\n164:                        integer_sequence<bool, (Is >= 0)...>) -> std::true_type;\n165:   static auto all_true(...) -> std::false_type;\n166: \n167:   template <size_t... Is>\n168:   static auto check(index_sequence<Is...>) -> decltype(all_true(\n169:       index_sequence<Is...>{},\n170:       integer_sequence<bool,\n171:                        (is_formattable<typename std::tuple_element<Is, T>::type,\n172:                                        C>::value)...>{}));\n173: \n174:  public:\n175:   static constexpr const bool value =\n176:       decltype(check(tuple_index_sequence<T>{}))::value;\n177: };\n178: \n179: template <typename Tuple, typename F, size_t... Is>\n180: FMT_CONSTEXPR void for_each(index_sequence<Is...>, Tuple&& t, F&& f) {\n181:   using std::get;\n182:   // Using a free function get<Is>(Tuple) now.\n183:   const int unused[] = {0, ((void)f(get<Is>(t)), 0)...};\n184:   ignore_unused(unused);\n185: }\n186: \n187: template <typename Tuple, typename F>\n188: FMT_CONSTEXPR void for_each(Tuple&& t, F&& f) {\n189:   for_each(tuple_index_sequence<remove_cvref_t<Tuple>>(),\n190:            std::forward<Tuple>(t), std::forward<F>(f));\n191: }\n192: \n193: template <typename Tuple1, typename Tuple2, typename F, size_t... Is>\n194: void for_each2(index_sequence<Is...>, Tuple1&& t1, Tuple2&& t2, F&& f) {\n195:   using std::get;\n196:   const int unused[] = {0, ((void)f(get<Is>(t1), get<Is>(t2)), 0)...};\n197:   ignore_unused(unused);\n198: }\n199: \n200: template <typename Tuple1, typename Tuple2, typename F>\n201: void for_each2(Tuple1&& t1, Tuple2&& t2, F&& f) {\n202:   for_each2(tuple_index_sequence<remove_cvref_t<Tuple1>>(),\n203:             std::forward<Tuple1>(t1), std::forward<Tuple2>(t2),\n204:             std::forward<F>(f));\n205: }\n206: \n207: namespace tuple {\n208: // Workaround a bug in MSVC 2019 (v140).\n209: template <typename Char, typename... T>\n210: using result_t = std::tuple<formatter<remove_cvref_t<T>, Char>...>;\n211: \n212: using std::get;\n213: template <typename Tuple, typename Char, std::size_t... Is>\n214: auto get_formatters(index_sequence<Is...>)\n215:     -> result_t<Char, decltype(get<Is>(std::declval<Tuple>()))...>;\n216: }  // namespace tuple\n217: \n218: #if FMT_MSC_VERSION && FMT_MSC_VERSION < 1920\n219: // Older MSVC doesn't get the reference type correctly for arrays.\n220: template <typename R> struct range_reference_type_impl {\n221:   using type = decltype(*detail::range_begin(std::declval<R&>()));\n222: };\n223: \n224: template <typename T, std::size_t N> struct range_reference_type_impl<T[N]> {\n225:   using type = T&;\n226: };\n227: \n228: template <typename T>\n229: using range_reference_type = typename range_reference_type_impl<T>::type;\n230: #else\n231: template <typename Range>\n232: using range_reference_type =\n233:     decltype(*detail::range_begin(std::declval<Range&>()));\n234: #endif\n235: \n236: // We don't use the Range's value_type for anything, but we do need the Range's\n237: // reference type, with cv-ref stripped.\n238: template <typename Range>\n239: using uncvref_type = remove_cvref_t<range_reference_type<Range>>;\n240: \n241: template <typename Formatter>\n242: FMT_CONSTEXPR auto maybe_set_debug_format(Formatter& f, bool set)\n243:     -> decltype(f.set_debug_format(set)) {\n244:   f.set_debug_format(set);\n245: }\n246: template <typename Formatter>\n247: FMT_CONSTEXPR void maybe_set_debug_format(Formatter&, ...) {}\n248: \n249: // These are not generic lambdas for compatibility with C++11.\n250: template <typename ParseContext> struct parse_empty_specs {\n251:   template <typename Formatter> FMT_CONSTEXPR void operator()(Formatter& f) {\n252:     f.parse(ctx);\n253:     detail::maybe_set_debug_format(f, true);\n254:   }\n255:   ParseContext& ctx;\n256: };\n257: template <typename FormatContext> struct format_tuple_element {\n258:   using char_type = typename FormatContext::char_type;\n259: \n260:   template <typename T>\n261:   void operator()(const formatter<T, char_type>& f, const T& v) {\n262:     if (i > 0) ctx.advance_to(detail::copy<char_type>(separator, ctx.out()));\n263:     ctx.advance_to(f.format(v, ctx));\n264:     ++i;\n265:   }\n266: \n267:   int i;\n268:   FormatContext& ctx;\n269:   basic_string_view<char_type> separator;\n270: };\n271: \n272: }  // namespace detail\n273: \n274: template <typename T> struct is_tuple_like {\n275:   static constexpr const bool value =\n276:       detail::is_tuple_like_<T>::value && !detail::is_range_<T>::value;\n277: };\n278: \n279: template <typename T, typename C> struct is_tuple_formattable {\n280:   static constexpr const bool value =\n281:       detail::is_tuple_formattable_<T, C>::value;\n282: };\n283: \n284: template <typename Tuple, typename Char>\n285: struct formatter<Tuple, Char,\n286:                  enable_if_t<fmt::is_tuple_like<Tuple>::value &&\n287:                              fmt::is_tuple_formattable<Tuple, Char>::value>> {\n288:  private:\n289:   decltype(detail::tuple::get_formatters<Tuple, Char>(\n290:       detail::tuple_index_sequence<Tuple>())) formatters_;\n291: \n292:   basic_string_view<Char> separator_ = detail::string_literal<Char, ',', ' '>{};\n293:   basic_string_view<Char> opening_bracket_ =\n294:       detail::string_literal<Char, '('>{};\n295:   basic_string_view<Char> closing_bracket_ =\n296:       detail::string_literal<Char, ')'>{};\n297: \n298:  public:\n299:   FMT_CONSTEXPR formatter() {}\n300: \n301:   FMT_CONSTEXPR void set_separator(basic_string_view<Char> sep) {\n302:     separator_ = sep;\n303:   }\n304: \n305:   FMT_CONSTEXPR void set_brackets(basic_string_view<Char> open,\n306:                                   basic_string_view<Char> close) {\n307:     opening_bracket_ = open;\n308:     closing_bracket_ = close;\n309:   }\n310: \n311:   template <typename ParseContext>\n312:   FMT_CONSTEXPR auto parse(ParseContext& ctx) -> decltype(ctx.begin()) {\n313:     auto it = ctx.begin();\n314:     if (it != ctx.end() && *it != '}') report_error(\"invalid format specifier\");\n315:     detail::for_each(formatters_, detail::parse_empty_specs<ParseContext>{ctx});\n316:     return it;\n317:   }\n318: \n319:   template <typename FormatContext>\n320:   auto format(const Tuple& value, FormatContext& ctx) const\n321:       -> decltype(ctx.out()) {\n322:     ctx.advance_to(detail::copy<Char>(opening_bracket_, ctx.out()));\n323:     detail::for_each2(\n324:         formatters_, value,\n325:         detail::format_tuple_element<FormatContext>{0, ctx, separator_});\n326:     return detail::copy<Char>(closing_bracket_, ctx.out());\n327:   }\n328: };\n329: \n330: template <typename T, typename Char> struct is_range {\n331:   static constexpr const bool value =\n332:       detail::is_range_<T>::value && !detail::has_to_string_view<T>::value;\n333: };\n334: \n335: namespace detail {\n336: template <typename Context> struct range_mapper {\n337:   using mapper = arg_mapper<Context>;\n338: \n339:   template <typename T,\n340:             FMT_ENABLE_IF(has_formatter<remove_cvref_t<T>, Context>::value)>\n\n(Showing lines 1-340 of 1005. Use offset=341 to continue.)\n</content>","metadata":{"preview":"// Formatting library for C++ - range and tuple support\n//\n// Copyright (c) 2012 - present, Victor Zverovich and {fmt} contributors\n// All rights reserved.\n//\n// For the license information refer to format.h.\n\n#ifndef FMT_RANGES_H_\n#define FMT_RANGES_H_\n\n#include <initializer_list>\n#include <iterator>\n#include <tuple>\n#include <type_traits>\n\n#include \"format.h\"\n\nFMT_BEGIN_NAMESPACE\n\nnamespace detail {","truncated":true,"loaded":[],"display":{"type":"file","path":"/data1/zhangyixiang/HuaWei/SWE-bench-FeatureEnvy-test/.tmp/opencode-swebench-69ee98f4/testbed/include/fmt/ranges.h","text":"// Formatting library for C++ - range and tuple support\n//\n// Copyright (c) 2012 - present, Victor Zverovich and {fmt} contributors\n// All rights reserved.\n//\n// For the license information refer to format.h.\n\n#ifndef FMT_RANGES_H_\n#define FMT_RANGES_H_\n\n#include <initializer_list>\n#include <iterator>\n#include <tuple>\n#include <type_traits>\n\n#include \"format.h\"\n\nFMT_BEGIN_NAMESPACE\n\nnamespace detail {\n\ntemplate <typename T> class is_map {\n  template <typename U> static auto check(U*) -> typename U::mapped_type;\n  template <typename> static void check(...);\n\n public:\n  static constexpr const bool value =\n      !std::is_void<decltype(check<T>(nullptr))>::value;\n};\n\ntemplate <typename T> class is_set {\n  template <typename U> static auto check(U*) -> typename U::key_type;\n  template <typename> static void check(...);\n\n public:\n  static constexpr const bool value =\n      !std::is_void<decltype(check<T>(nullptr))>::value && !is_map<T>::value;\n};\n\ntemplate <typename... Ts> struct conditional_helper {};\n\ntemplate <typename T, typename _ = void> struct is_range_ : std::false_type {};\n\n#if !FMT_MSC_VERSION || FMT_MSC_VERSION > 1800\n\n#  define FMT_DECLTYPE_RETURN(val)  \\\n    ->decltype(val) { return val; } \\\n    static_assert(                  \\\n        true, \"\")  // This makes it so that a semicolon is required after the\n                   // macro, which helps clang-format handle the formatting.\n\n// C array overload\ntemplate <typename T, std::size_t N>\nauto range_begin(const T (&arr)[N]) -> const T* {\n  return arr;\n}\ntemplate <typename T, std::size_t N>\nauto range_end(const T (&arr)[N]) -> const T* {\n  return arr + N;\n}\n\ntemplate <typename T, typename Enable = void>\nstruct has_member_fn_begin_end_t : std::false_type {};\n\ntemplate <typename T>\nstruct has_member_fn_begin_end_t<T, void_t<decltype(std::declval<T>().begin()),\n                                           decltype(std::declval<T>().end())>>\n    : std::true_type {};\n\n// Member function overload\ntemplate <typename T>\nauto range_begin(T&& rng) FMT_DECLTYPE_RETURN(static_cast<T&&>(rng).begin());\ntemplate <typename T>\nauto range_end(T&& rng) FMT_DECLTYPE_RETURN(static_cast<T&&>(rng).end());\n\n// ADL overload. Only participates in overload resolution if member functions\n// are not found.\ntemplate <typename T>\nauto range_begin(T&& rng)\n    -> enable_if_t<!has_member_fn_begin_end_t<T&&>::value,\n                   decltype(begin(static_cast<T&&>(rng)))> {\n  return begin(static_cast<T&&>(rng));\n}\ntemplate <typename T>\nauto range_end(T&& rng) -> enable_if_t<!has_member_fn_begin_end_t<T&&>::value,\n                                       decltype(end(static_cast<T&&>(rng)))> {\n  return end(static_cast<T&&>(rng));\n}\n\ntemplate <typename T, typename Enable = void>\nstruct has_const_begin_end : std::false_type {};\ntemplate <typename T, typename Enable = void>\nstruct has_mutable_begin_end : std::false_type {};\n\ntemplate <typename T>\nstruct has_const_begin_end<\n    T,\n    void_t<\n        decltype(detail::range_begin(std::declval<const remove_cvref_t<T>&>())),\n        decltype(detail::range_end(std::declval<const remove_cvref_t<T>&>()))>>\n    : std::true_type {};\n\ntemplate <typename T>\nstruct has_mutable_begin_end<\n    T, void_t<decltype(detail::range_begin(std::declval<T&>())),\n              decltype(detail::range_end(std::declval<T&>())),\n              // the extra int here is because older versions of MSVC don't\n              // SFINAE properly unless there are distinct types\n              int>> : std::true_type {};\n\ntemplate <typename T>\nstruct is_range_<T, void>\n    : std::integral_constant<bool, (has_const_begin_end<T>::value ||\n                                    has_mutable_begin_end<T>::value)> {};\n#  undef FMT_DECLTYPE_RETURN\n#endif\n\n// tuple_size and tuple_element check.\ntemplate <typename T> class is_tuple_like_ {\n  template <typename U>\n  static auto check(U* p) -> decltype(std::tuple_size<U>::value, int());\n  template <typename> static void check(...);\n\n public:\n  static constexpr const bool value =\n      !std::is_void<decltype(check<T>(nullptr))>::value;\n};\n\n// Check for integer_sequence\n#if defined(__cpp_lib_integer_sequence) || FMT_MSC_VERSION >= 1900\ntemplate <typename T, T... N>\nusing integer_sequence = std::integer_sequence<T, N...>;\ntemplate <size_t... N> using index_sequence = std::index_sequence<N...>;\ntemplate <size_t N> using make_index_sequence = std::make_index_sequence<N>;\n#else\ntemplate <typename T, T... N> struct integer_sequence {\n  using value_type = T;\n\n  static FMT_CONSTEXPR auto size() -> size_t { return sizeof...(N); }\n};\n\ntemplate <size_t... N> using index_sequence = integer_sequence<size_t, N...>;\n\ntemplate <typename T, size_t N, T... Ns>\nstruct make_integer_sequence : make_integer_sequence<T, N - 1, N - 1, Ns...> {};\ntemplate <typename T, T... Ns>\nstruct make_integer_sequence<T, 0, Ns...> : integer_sequence<T, Ns...> {};\n\ntemplate <size_t N>\nusing make_index_sequence = make_integer_sequence<size_t, N>;\n#endif\n\ntemplate <typename T>\nusing tuple_index_sequence = make_index_sequence<std::tuple_size<T>::value>;\n\ntemplate <typename T, typename C, bool = is_tuple_like_<T>::value>\nclass is_tuple_formattable_ {\n public:\n  static constexpr const bool value = false;\n};\ntemplate <typename T, typename C> class is_tuple_formattable_<T, C, true> {\n  template <size_t... Is>\n  static auto all_true(index_sequence<Is...>,\n                       integer_sequence<bool, (Is >= 0)...>) -> std::true_type;\n  static auto all_true(...) -> std::false_type;\n\n  template <size_t... Is>\n  static auto check(index_sequence<Is...>) -> decltype(all_true(\n      index_sequence<Is...>{},\n      integer_sequence<bool,\n                       (is_formattable<typename std::tuple_element<Is, T>::type,\n                                       C>::value)...>{}));\n\n public:\n  static constexpr const bool value =\n      decltype(check(tuple_index_sequence<T>{}))::value;\n};\n\ntemplate <typename Tuple, typename F, size_t... Is>\nFMT_CONSTEXPR void for_each(index_sequence<Is...>, Tuple&& t, F&& f) {\n  using std::get;\n  // Using a free function get<Is>(Tuple) now.\n  const int unused[] = {0, ((void)f(get<Is>(t)), 0)...};\n  ignore_unused(unused);\n}\n\ntemplate <typename Tuple, typename F>\nFMT_CONSTEXPR void for_each(Tuple&& t, F&& f) {\n  for_each(tuple_index_sequence<remove_cvref_t<Tuple>>(),\n           std::forward<Tuple>(t), std::forward<F>(f));\n}\n\ntemplate <typename Tuple1, typename Tuple2, typename F, size_t... Is>\nvoid for_each2(index_sequence<Is...>, Tuple1&& t1, Tuple2&& t2, F&& f) {\n  using std::get;\n  const int unused[] = {0, ((void)f(get<Is>(t1), get<Is>(t2)), 0)...};\n  ignore_unused(unused);\n}\n\ntemplate <typename Tuple1, typename Tuple2, typename F>\nvoid for_each2(Tuple1&& t1, Tuple2&& t2, F&& f) {\n  for_each2(tuple_index_sequence<remove_cvref_t<Tuple1>>(),\n            std::forward<Tuple1>(t1), std::forward<Tuple2>(t2),\n            std::forward<F>(f));\n}\n\nnamespace tuple {\n// Workaround a bug in MSVC 2019 (v140).\ntemplate <typename Char, typename... T>\nusing result_t = std::tuple<formatter<remove_cvref_t<T>, Char>...>;\n\nusing std::get;\ntemplate <typename Tuple, typename Char, std::size_t... Is>\nauto get_formatters(index_sequence<Is...>)\n    -> result_t<Char, decltype(get<Is>(std::declval<Tuple>()))...>;\n}  // namespace tuple\n\n#if FMT_MSC_VERSION && FMT_MSC_VERSION < 1920\n// Older MSVC doesn't get the reference type correctly for arrays.\ntemplate <typename R> struct range_reference_type_impl {\n  using type = decltype(*detail::range_begin(std::declval<R&>()));\n};\n\ntemplate <typename T, std::size_t N> struct range_reference_type_impl<T[N]> {\n  using type = T&;\n};\n\ntemplate <typename T>\nusing range_reference_type = typename range_reference_type_impl<T>::type;\n#else\ntemplate <typename Range>\nusing range_reference_type =\n    decltype(*detail::range_begin(std::declval<Range&>()));\n#endif\n\n// We don't use the Range's value_type for anything, but we do need the Range's\n// reference type, with cv-ref stripped.\ntemplate <typename Range>\nusing uncvref_type = remove_cvref_t<range_reference_type<Range>>;\n\ntemplate <typename Formatter>\nFMT_CONSTEXPR auto maybe_set_debug_format(Formatter& f, bool set)\n    -> decltype(f.set_debug_format(set)) {\n  f.set_debug_format(set);\n}\ntemplate <typename Formatter>\nFMT_CONSTEXPR void maybe_set_debug_format(Formatter&, ...) {}\n\n// These are not generic lambdas for compatibility with C++11.\ntemplate <typename ParseContext> struct parse_empty_specs {\n  template <typename Formatter> FMT_CONSTEXPR void operator()(Formatter& f) {\n    f.parse(ctx);\n    detail::maybe_set_debug_format(f, true);\n  }\n  ParseContext& ctx;\n};\ntemplate <typename FormatContext> struct format_tuple_element {\n  using char_type = typename FormatContext::char_type;\n\n  template <typename T>\n  void operator()(const formatter<T, char_type>& f, const T& v) {\n    if (i > 0) ctx.advance_to(detail::copy<char_type>(separator, ctx.out()));\n    ctx.advance_to(f.format(v, ctx));\n    ++i;\n  }\n\n  int i;\n  FormatContext& ctx;\n  basic_string_view<char_type> separator;\n};\n\n}  // namespace detail\n\ntemplate <typename T> struct is_tuple_like {\n  static constexpr const bool value =\n      det