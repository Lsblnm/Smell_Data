66:   EXPECT_EQ(fmt::format(\"{:s}\", vec), \"\\\"a\\n\\t\\\"\");\n67:   EXPECT_EQ(fmt::format(\"{::s}\", vvc), \"[\\\"abc\\\", \\\"abc\\\"]\");\n68:   EXPECT_EQ(fmt::format(\"{}\", vvc), \"[['a', 'b', 'c'], ['a', 'b', 'c']]\");\n69:   EXPECT_EQ(fmt::format(\"{:n}\", vvc), \"['a', 'b', 'c'], ['a', 'b', 'c']\");\n70:   EXPECT_EQ(fmt::format(\"{:n:n}\", vvc), \"'a', 'b', 'c', 'a', 'b', 'c'\");\n71:   EXPECT_EQ(fmt::format(\"{:n:n:}\", vvc), \"a, b, c, a, b, c\");\n72: }\n73: \n74: TEST(ranges_test, format_nested_vector) {\n75:   auto v = std::vector<std::vector<int>>{{1, 2}, {3, 5}, {7, 11}};\n76:   EXPECT_EQ(fmt::format(\"{}\", v), \"[[1, 2], [3, 5], [7, 11]]\");\n77:   EXPECT_EQ(fmt::format(\"{:::#x}\", v), \"[[0x1, 0x2], [0x3, 0x5], [0x7, 0xb]]\");\n78:   EXPECT_EQ(fmt::format(\"{:n:n:#x}\", v), \"0x1, 0x2, 0x3, 0x5, 0x7, 0xb\");\n79: }\n80: \n81: TEST(ranges_test, to_string_vector) {\n82:   auto v = std::vector<std::string>{\"a\", \"b\", \"c\"};\n83:   EXPECT_EQ(fmt::to_string(v), \"[\\\"a\\\", \\\"b\\\", \\\"c\\\"]\");\n84: }\n85: \n86: TEST(ranges_test, format_map) {\n87:   auto m = std::map<std::string, int>{{\"one\", 1}, {\"two\", 2}};\n88:   EXPECT_EQ(fmt::format(\"{}\", m), \"{\\\"one\\\": 1, \\\"two\\\": 2}\");\n89:   EXPECT_EQ(fmt::format(\"{:n}\", m), \"\\\"one\\\": 1, \\\"two\\\": 2\");\n90: }\n91: \n92: TEST(ranges_test, format_set) {\n93:   EXPECT_EQ(fmt::format(\"{}\", std::set<std::string>{\"one\", \"two\"}),\n94:             \"{\\\"one\\\", \\\"two\\\"}\");\n95: }\n96: \n97: // Models std::flat_set close enough to test if no ambiguous lookup of a\n98: // formatter happens due to the flat_set type matching is_set and\n99: // is_container_adaptor_like.\n100: template <typename T> class flat_set {\n101:  public:\n102:   using key_type = T;\n103:   using container_type = std::vector<T>;\n104: \n105:   using iterator = typename std::vector<T>::iterator;\n106:   using const_iterator = typename std::vector<T>::const_iterator;\n107: \n108:   template <typen