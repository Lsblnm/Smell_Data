+fn symlink_target_path(filename: &Path, target: PathBuf, full_paths: bool) -> PathBuf {
+    if full_paths && target.is_relative() {
+        filename.parent().unwrap_or_else(|| Path::new(".")).join(target)
+    } else {
+        target
+    }
+}
