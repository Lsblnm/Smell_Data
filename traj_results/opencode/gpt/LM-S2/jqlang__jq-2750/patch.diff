diff --git a/src/compile.c b/src/compile.c
index c73d2a5..2cbc81d 100644
--- a/src/compile.c
+++ b/src/compile.c
@@ -1052,20 +1052,29 @@ block gen_try_handler(block handler) {
 block gen_try(block exp, block handler) {
   /*
    * Produce something like:
-   *  FORK_OPT <address of handler>
+   *  TRY_BEGIN <address of handler>
    *  <exp>
+   *  TRY_END
    *  JUMP <end of handler>
    *  <handler>
    *
    * If this is not an internal try/catch, then catch and re-raise
    * internal errors to prevent them from leaking.
    *
-   * The handler will only execute if we backtrack to the FORK_OPT with
-   * an error (exception).  If <exp> produces no value then FORK_OPT
+   * The handler will only execute if we backtrack to the TRY_BEGIN with
+   * an error (exception).  If <exp> produces no value then TRY_BEGIN
    * will backtrack (propagate the `empty`, as it were.  If <exp>
    * produces a value then we'll execute whatever bytecode follows this
    * sequence.
    */
+  if (!handler.first && !handler.last)
+    // A hack to deal with `.` as the handler; we could use a real NOOP here
+    handler = BLOCK(gen_op_simple(DUP), gen_op_simple(POP), handler);
+
+  block end = gen_op_simple(TRY_END);
+  exp = BLOCK(exp, end, gen_op_target(JUMP, handler));
+  return BLOCK(gen_op_target(TRY_BEGIN, exp), exp, handler);
+
   block sequences[2];
   int constant_count[2];
   int call_count[2];
@@ -1324,7 +1333,7 @@ block gen_try(block exp, block handler) {
     inst* jump_inst = jv_mem_alloc(sizeof(inst));
     inst* fork_inst = jv_mem_alloc(sizeof(inst));
     const struct opcode_description* jump_desc = opcode_describe(JUMP);
-    const struct opcode_description* fork_desc = opcode_describe(FORK_OPT);
+    const struct opcode_description* fork_desc = opcode_describe(TRY_BEGIN);
     memset(jump_inst, 0, sizeof(inst));
     memset(fork_inst, 0, sizeof(inst));
     jump_inst->next = 0;
@@ -1349,7 +1358,7 @@ block gen_try(block exp, block handler) {
     jump_inst->bytecode_pos = -1;
     fork_inst->next = 0;
     fork_inst->prev = 0;
-    fork_inst->op = FORK_OPT;
+    fork_inst->op = TRY_BEGIN;
     fork_inst->imm.intval = 0;
     fork_inst->imm.target = 0;
     fork_inst->imm.cfunc = 0;
diff --git a/src/execute.c b/src/execute.c
index 34bb63d..35972c5 100644
--- a/src/execute.c
+++ b/src/execute.c
@@ -808,7 +808,16 @@ jv jq_next(jq_state *jq) {
       break;
     }
 
-    case FORK_OPT:
+    case TRY_BEGIN: {
+      stack_save(jq, pc - 1, stack_get_pos(jq));
+      pc++; // skip offset this time
+      break;
+    }
+
+    case TRY_END:
+      stack_save(jq, pc - 1, stack_get_pos(jq));
+      break;
+
     case DESTRUCTURE_ALT:
     case FORK: {
       stack_save(jq, pc - 1, stack_get_pos(jq));
@@ -816,13 +825,31 @@ jv jq_next(jq_state *jq) {
       break;
     }
 
-    case ON_BACKTRACK(FORK_OPT):
+    case ON_BACKTRACK(TRY_END):
+      if (raising) {
+        jv error = jq->error;
+        jq->error = jv_invalid_with_msg(error);
+      }
+      goto do_backtrack;
+
+    case ON_BACKTRACK(TRY_BEGIN):
     case ON_BACKTRACK(DESTRUCTURE_ALT): {
       if (jv_is_valid(jq->error)) {
         // `try EXP ...` backtracked here (no value, `empty`), so we backtrack more
         jv_free(stack_pop(jq));
         goto do_backtrack;
       }
+      // An error from past TRY_END belongs to an enclosing try/catch.
+      if (opcode == ON_BACKTRACK(TRY_BEGIN)) {
+        jv message = jv_invalid_get_msg(jv_copy(jq->error));
+        if (jv_get_kind(message) == JV_KIND_INVALID) {
+          jv_free(jq->error);
+          jq->error = message;
+          goto do_backtrack;
+        }
+        jv_free(message);
+      }
+
       // `try EXP ...` exception caught in EXP
       // DESTRUCTURE_ALT doesn't want the error message on the stack,
       // as we would just want to throw it away anyway.
diff --git a/src/opcode_list.h b/src/opcode_list.h
index 886131d..3ecb525 100644
--- a/src/opcode_list.h
+++ b/src/opcode_list.h
@@ -13,7 +13,8 @@ OP(INDEX_OPT, NONE,     2, 1)
 OP(EACH,  NONE,     1, 1)
 OP(EACH_OPT,  NONE,     1, 1)
 OP(FORK,  BRANCH,   0, 0)
-OP(FORK_OPT,  BRANCH,   0, 0)
+OP(TRY_BEGIN, BRANCH,   0, 0)
+OP(TRY_END,   NONE,     0, 0)
 OP(JUMP,  BRANCH,   0, 0)
 OP(JUMP_F,BRANCH,   1, 0)
 OP(BACKTRACK, NONE, 0, 0)
