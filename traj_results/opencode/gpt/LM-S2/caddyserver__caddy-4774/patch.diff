+func parseOptStringSlice(d *caddyfile.Dispenser, _ interface{}) (interface{}, error) {
+	d.Next() // consume parameter name
+	var vals []string
+	for d.NextArg() {
+		vals = append(vals, d.Val())
+	}
+	if len(vals) == 0 {
+		return nil, d.ArgErr()
+	}
+	return vals, nil
+}
