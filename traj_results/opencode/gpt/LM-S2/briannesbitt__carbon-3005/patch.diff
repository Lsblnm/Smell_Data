+    /**
+     * Serialize the interval without its translator, which may contain closures.
+     */
+    public function __serialize(): array
+    {
+        return [
+            'y' => $this->y,
+            'm' => $this->m,
+            'd' => $this->d,
+            'h' => $this->h,
+            'i' => $this->i,
