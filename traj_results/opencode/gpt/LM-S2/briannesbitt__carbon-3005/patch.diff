+        ];
+    }
+
+    /**
+     * Restore interval values and rebuild the local translator from its locale.
+     */
+    public function __unserialize(array $data): void
+    {
+        $get = static function (string $name) use ($data) {
+            return $data[$name] ?? $data["\0*\0$name"] ?? $data["\0".self::class."\0$name"] ?? null;
+        };
+        $this->__construct(
+            $get('y') ?? 0,
+            $get('m') ?? 0,
+            0,
+            $get('d') ?? 0,
+            $get('h') ?? 0,
+            $get('i') ?? 0,
+            $get('s') ?? 0,
+            ($get('f') ?? 0) * Carbon::MICROSECONDS_PER_SECOND,
+        );
+        $this->invert = $get('invert') ?? 0;
+        $this->timezoneSetting = $get('timezoneSetting') ?? $get('tzName');
+        $this->startDate = $get('startDate');
+        $this->endDate = $get('endDate');
+        $this->rawInterval = $get('rawInterval');
+        $this->initialValues = $get('initialValues');
+        $this->originalInput = $get('originalInput');
+
+        if ($locale = $get('locale')) {
+            $this->locale($locale);
+        }
+    }
