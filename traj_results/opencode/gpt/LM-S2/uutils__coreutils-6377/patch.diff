+#[cfg(unix)]
+fn set_ignored_signals(ignore_signals: &[&OsStr]) -> UResult<()> {
+    let mut signals = Vec::new();
+
+    for value in ignore_signals {
+        if value.is_empty() {
+            continue;
+        }
+
+        for signal_name in value.to_string_lossy().split(',') {
+            let signal_name = signal_name.trim();
+            if signal_name.is_empty() {
+                continue;
+            }
+            let normalized_name = signal_name.to_ascii_uppercase();
+            let normalized_name = normalized_name
+                .strip_prefix("SIG")
+                .unwrap_or(&normalized_name);
+            let signal_number = uucore::signals::signal_by_name_or_value(normalized_name)
+                .filter(|&signal| signal != 0)
+                .ok_or_else(|| {
+                    USimpleError::new(125, format!("{}: invalid signal", signal_name.quote()))
+                })?;
+            signals.push(signal_number);
+        }
+    }
+
+    for signal_number in signals {
+        let signal = Signal::try_from(signal_number as i32).map_err(|_| {
+            USimpleError::new(125, format!("{}: invalid signal", signal_number))
+        })?;
+        // SAFETY: SigIgn is one of the signal dispositions supported by sigaction.
+        unsafe {
+            sigaction(
+                signal,
+                &SigAction::new(SigHandler::SigIgn, SaFlags::empty(), SigSet::empty()),
+            )
+        }
+        .map_err(|error| {
+            USimpleError::new(
+                125,
+                format!(
+                    "failed to set signal action for signal {}: {}",
+                    signal_number,
+                    error.desc()
+                ),
+            )
+        })?;
+    }
+
+    Ok(())
+}
