diff --git a/lib/rubocop/cop/style/redundant_parentheses.rb b/lib/rubocop/cop/style/redundant_parentheses.rb
index 9e8e599f8..677f9e9fa 100644
--- a/lib/rubocop/cop/style/redundant_parentheses.rb
+++ b/lib/rubocop/cop/style/redundant_parentheses.rb
@@ -45,11 +45,24 @@ module RuboCop
         def parens_allowed?(node)
           empty_parentheses?(node) ||
             first_arg_begins_with_hash_literal?(node) ||
+            do_end_block_in_unparenthesized_argument?(node) ||
             rescue?(node) ||
             allowed_pin_operator?(node) ||
             allowed_expression?(node)
         end
 
+        def do_end_block_in_unparenthesized_argument?(node)
+          return false unless node.each_descendant.any? { |descendant| do_end_block?(descendant) }
+
+          enclosing_call = node.each_ancestor.find(&:call_type?)
+          enclosing_call && !enclosing_call.parenthesized?
+        end
+
+        def do_end_block?(node)
+          (node.block_type? || node.numblock_type?) && !node.braces? &&
+            !node.send_node.lambda_literal?
+        end
+
         def ignore_syntax?(node)
           return false unless (parent = node.parent)
 
