index 0000000..4fbf714
--- /dev/null
+++ b/lib/helpers/formDataToStream.js
@@ -0,0 +1,71 @@
+'use strict';
+
+import stream from 'stream';
+import utils from '../utils.js';
+
+const CRLF = '\r\n';
+const textEncoder = new TextEncoder();
+const CRLF_BYTES = textEncoder.encode(CRLF);
+
+const escapeName = (name) => String(name).replace(/[\r\n"]/g, (match) => ({
+  '\r': '%0D',
+  '\n': '%0A',
+  '"': '%22'
+}[match]));
+
+class FormDataPart {
+  constructor(name, value) {
+    const isStringValue = utils.isString(value);
+    let headers = `Content-Disposition: form-data; name="${escapeName(name)}"`;
+
+    if (!isStringValue) {
+      headers += `; filename="${escapeName(value.name || 'blob')}"${CRLF}`;
+      headers += `Content-Type: ${value.type || 'application/octet-stream'}`;
+    }
+
+    this.headers = textEncoder.encode(headers + CRLF + CRLF);
+    this.value = value;
+    this.size = this.headers.byteLength + (isStringValue ? textEncoder.encode(value).byteLength : value.size) + CRLF_BYTES.byteLength;
+  }
+
+}
+
+export default function formDataToStream(form, headersHandler) {
+  const boundary = `axios-${Math.random().toString(16).slice(2)}`;
+  const boundaryBytes = textEncoder.encode(`--${boundary}${CRLF}`);
+  const footerBytes = textEncoder.encode(`--${boundary}--${CRLF}`);
+  const parts = Array.from(form.entries(), ([name, value]) => new FormDataPart(name, value));
+  const contentLength = parts.reduce((length, part) => length + boundaryBytes.byteLength + part.size, footerBytes.byteLength);
+
+  headersHandler({
+    'Content-Type': `multipart/form-data; boundary=${boundary}`,
+    'Content-Length': contentLength
+  });
+
+  const formStream = new stream.PassThrough();
+
+  (async function () {
+    for (const part of parts) {
+      formStream.write(boundaryBytes);
+      formStream.write(part.headers);
+
+      if (utils.isString(part.value)) {
+        formStream.write(textEncoder.encode(part.value));
+      } else {
+        await new Promise((resolve, reject) => {
+          const valueStream = stream.Readable.from(part.value.stream());
+
+          valueStream.on('end', resolve);
+          valueStream.on('error', reject);
+          valueStream.pipe(formStream, {end: false});
+        });
+      }
+
+      formStream.write(CRLF_BYTES);
+    }
+
+    formStream.end(footerBytes);
+  })().catch((err) => formStream.destroy(err));
+
+  return formStream;
+}
