diff --git a/include/fmt/format.h b/include/fmt/format.h
index 8003cdab..6f5b092f 100644
--- a/include/fmt/format.h
+++ b/include/fmt/format.h
@@ -2131,6 +2131,24 @@ struct grouped_int_writer {
     int num_digits = count_digits(value);
     char digits[40];
     format_decimal(digits, value, num_digits);
+    return write_int(digits, num_digits, specs, grouping);
+  }
+
+  template <int Bits, typename UInt>
+  auto write_int(UInt value, const format_specs<Char>& specs,
+                 const digit_grouping<Char>& grouping, bool upper = false)
+      -> OutputIt {
+    static_assert(std::is_same<uint64_or_128_t<UInt>, UInt>::value, "");
+    int num_digits = count_digits<Bits>(value);
+    char digits[40];
+    format_uint<Bits>(digits, value, num_digits, upper);
+    return write_int(digits, num_digits, specs, grouping);
+  }
+
+ private:
+  auto write_int(const char* digits, int num_digits,
+                 const format_specs<Char>& specs,
+                 const digit_grouping<Char>& grouping) -> OutputIt {
 
     const auto& grouping_chars = grouping.grouping();
     const auto& thousands_sep = grouping.separator();
@@ -2148,12 +2166,10 @@ struct grouped_int_writer {
       while (num_digits > next_pos()) ++sep_count;
     }
 
-    unsigned size = to_unsigned((prefix != 0 ? 1 : 0) + num_digits + sep_count);
+    unsigned size = to_unsigned((prefix >> 24) + num_digits + sep_count);
     auto write_digits = [&](reserve_iterator<OutputIt> it) {
-      if (prefix != 0) {
-        char sign = static_cast<char>(prefix);
-        *it++ = static_cast<Char>(sign);
-      }
+      for (unsigned p = prefix & 0xffffff; p != 0; p >>= 8)
+        *it++ = static_cast<Char>(p & 0xff);
       return grouping.apply(it, string_view(digits, to_unsigned(num_digits)));
     };
 
@@ -2220,9 +2236,43 @@ template <typename Char = char> struct loc_writer {
   template <typename T, FMT_ENABLE_IF(is_integer<T>::value)>
   auto operator()(T value) -> bool {
     auto arg = make_write_int_arg(value, specs.sign);
-    grouped_int_writer<buffer_appender<Char>, Char>{out, arg.prefix}.write_int(
-        static_cast<uint64_or_128_t<T>>(arg.abs_value), specs,
-        digit_grouping<Char>(grouping, sep));
+    auto abs_value = static_cast<uint64_or_128_t<T>>(arg.abs_value);
+    auto writer = grouped_int_writer<buffer_appender<Char>, Char>{out,
+                                                                    arg.prefix};
+    auto digit_grouping = detail::digit_grouping<Char>(grouping, sep);
+    switch (specs.type) {
+    case presentation_type::none:
+    case presentation_type::dec:
+      writer.write_int(abs_value, specs, digit_grouping);
+      break;
+    case presentation_type::hex_lower:
+    case presentation_type::hex_upper: {
+      bool upper = specs.type == presentation_type::hex_upper;
+      if (specs.alt)
+        prefix_append(arg.prefix, unsigned(upper ? 'X' : 'x') << 8 | '0');
+      writer.prefix = arg.prefix;
+      writer.template write_int<4>(abs_value, specs, digit_grouping, upper);
+      break;
+    }
+    case presentation_type::bin_lower:
+    case presentation_type::bin_upper: {
+      bool upper = specs.type == presentation_type::bin_upper;
+      if (specs.alt)
+        prefix_append(arg.prefix, unsigned(upper ? 'B' : 'b') << 8 | '0');
+      writer.prefix = arg.prefix;
+      writer.template write_int<1>(abs_value, specs, digit_grouping);
+      break;
+    }
+    case presentation_type::oct:
+      if (specs.alt && specs.precision <= count_digits<3>(abs_value) &&
+          abs_value != 0)
+        prefix_append(arg.prefix, '0');
+      writer.prefix = arg.prefix;
+      writer.template write_int<3>(abs_value, specs, digit_grouping);
+      break;
+    default:
+      return false;
+    }
     return true;
   }
 
