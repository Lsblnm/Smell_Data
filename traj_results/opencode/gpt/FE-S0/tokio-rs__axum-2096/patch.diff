diff --git a/axum/src/routing/path_router.rs b/axum/src/routing/path_router.rs
index a7f372a9..e7134bb7 100644
--- a/axum/src/routing/path_router.rs
+++ b/axum/src/routing/path_router.rs
@@ -156,6 +156,38 @@ where
         Ok(())
     }
 
+    pub(super) fn merge(
+        &mut self,
+        other: Self,
+        replace_fallback: bool,
+    ) -> Result<(), Cow<'static, str>> {
+        let PathRouter {
+            routes,
+            node,
+            prev_route_id: _,
+        } = other;
+        let fallback_path = format!("/*{FALLBACK_PARAM}");
+
+        for (id, endpoint) in routes {
+            let path = node
+                .route_id_to_path
+                .get(&id)
+                .expect("no path for route id. This is a bug in axum. Please file an issue");
+
+            if !replace_fallback && (path.as_ref() == "/" || path.as_ref() == fallback_path) {
+                continue;
+            }
+
+            if let Some(id) = self.node.path_to_route_id.get(path) {
+                self.routes.insert(*id, endpoint);
+            } else {
+                self.route_endpoint(path, endpoint)?;
+            }
+        }
+
+        Ok(())
+    }
+
     pub(super) fn nest_service<T>(&mut self, path: &str, svc: T) -> Result<(), Cow<'static, str>>
     where
         T: Service<Request, Error = Infallible> + Clone + Send + 'static,
