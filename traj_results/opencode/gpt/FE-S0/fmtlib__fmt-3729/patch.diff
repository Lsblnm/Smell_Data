 template <typename T, size_t SIZE, typename Allocator>
 template <typename Path, typename PathChar, typename FormatContext>
 auto basic_memory_buffer<T, SIZE, Allocator>::write_path(
-    const Path& p, const std::basic_string<PathChar>& native, bool debug,
-    format_specs<T>& specs, FormatContext& ctx) -> decltype(ctx.out()) {
+    const Path& p, const std::basic_string<PathChar>& path, bool debug,
+    bool generic, format_specs<T>& specs, FormatContext& ctx)
+    -> decltype(ctx.out()) {
   if (!debug) {
     if constexpr (std::is_same<T, char>::value &&
                   std::is_same<PathChar, wchar_t>::value) {
       auto utf8 = detail::to_utf8<wchar_t>(
-          native, detail::to_utf8_error_policy::replace);
+          path, detail::to_utf8_error_policy::replace);
       this->append(utf8.c_str(), utf8.c_str() + utf8.size());
     } else {
-      auto converted = p.template string<T>();
+      auto converted = generic ? p.template generic_string<T>()
+                               : p.template string<T>();
       this->append(converted.data(), converted.data() + converted.size());
     }
   } else if constexpr (std::is_same<T, char>::value &&
                        std::is_same<PathChar, wchar_t>::value) {
     auto quoted = basic_memory_buffer<wchar_t>();
-    detail::write_escaped_string<wchar_t>(std::back_inserter(quoted), native);
+    detail::write_escaped_string<wchar_t>(std::back_inserter(quoted), path);
     bool valid = detail::to_utf8<wchar_t>::convert(
         *this, {quoted.data(), quoted.size()});
     FMT_ASSERT(valid, "invalid utf16");
   } else if constexpr (std::is_same<T, PathChar>::value) {
-    detail::write_escaped_string<PathChar>(std::back_inserter(*this), native);
+    detail::write_escaped_string<PathChar>(std::back_inserter(*this), path);
   } else {
-    auto converted = p.template string<T>();
+    auto converted = generic ? p.template generic_string<T>()
+                             : p.template string<T>();
     detail::write_escaped_string<T>(std::back_inserter(*this), converted);
   }
   format_specs<T> local;
