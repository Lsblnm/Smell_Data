+// removedResourceConfig finds a removed block targeting addr. We must search
+// the whole configuration tree because the block can be in a parent module
+// whose target module no longer has configuration of its own.
+func (t *AttachResourceConfigTransformer) removedResourceConfig(addr addrs.ConfigResource) *configs.Removed {
+	var find func(*configs.Config) *configs.Removed
+	find = func(cfg *configs.Config) *configs.Removed {
+		for _, r := range cfg.Module.Removed {
+			crAddr, ok := r.From.RelSubject.(addrs.ConfigResource)
+			if !ok {
+				continue
+			}
+			if (addrs.ConfigResource{
+				Module:   append(cfg.Path, crAddr.Module...),
+				Resource: crAddr.Resource,
+			}).Equal(addr) {
+				return r
+			}
+		}
+
+		for _, childCfg := range cfg.Children {
+			if r := find(childCfg); r != nil {
+				return r
+			}
+		}
+		return nil
+	}
+
+	return find(t.Config)
+}
