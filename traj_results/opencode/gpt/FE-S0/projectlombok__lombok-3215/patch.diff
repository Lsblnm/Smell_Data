+	private void addTypeNames(JCTree type, java.util.Set<String> usedNames) {
+		if (type instanceof JCIdent) {
+			usedNames.add(((JCIdent) type).getName().toString());
+		} else if (type instanceof JCFieldAccess) {
+			JCFieldAccess fieldAccess = (JCFieldAccess) type;
+			addTypeNames(fieldAccess.selected, usedNames);
+		} else if (type instanceof JCTypeApply) {
+			JCTypeApply typeApply = (JCTypeApply) type;
+			addTypeNames(typeApply.getType(), usedNames);
+			for (JCExpression typeArgument : typeApply.getTypeArguments()) addTypeNames(typeArgument, usedNames);
+		}
+	}
 	
