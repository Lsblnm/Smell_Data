diff --git a/lib/helpers/formDataToStream.js b/lib/helpers/formDataToStream.js
new file mode 100644
index 0000000..3a61803
--- /dev/null
+++ b/lib/helpers/formDataToStream.js
@@ -0,0 +1,88 @@
+'use strict';
+
+import {Readable} from 'stream';
+import utils from '../utils.js';
+
+const CRLF = '\r\n';
+const CRLF_BYTES = new TextEncoder().encode(CRLF);
+
+const escapeName = (name) => String(name).replace(/\r?\n|\r/g, '%0D%0A').replace(/"/g, '%22');
+
+class FormDataPart {
+  constructor(name, value) {
+    const isStringValue = utils.isString(value);
+    let headers = 'Content-Disposition: form-data; name="' + escapeName(name) + '"';
+
+    if (!isStringValue) {
+      headers += '; filename="' + escapeName(value.name || 'blob') + '"' + CRLF;
+      headers += 'Content-Type: ' + (value.type || 'application/octet-stream');
+    }
+
+    this.headers = new TextEncoder().encode(headers + CRLF + CRLF);
+    this.value = value;
+    this.size = this.headers.byteLength + (isStringValue ? Buffer.byteLength(value) : value.size) + CRLF_BYTES.byteLength;
+  }
+
+}
+
+export default function formDataToStream(form, headersHandler, options) {
+  const {
+    tag = 'form-data-boundary',
+    boundary = tag + '-' + Math.random().toString(16).slice(2)
+  } = options || {};
+
+  if (boundary.length < 1 || boundary.length > 70) {
+    throw new Error('boundary must be 1 to 70 characters long');
+  }
+
+  const boundaryBytes = new TextEncoder().encode('--' + boundary + CRLF);
+  const footerBytes = new TextEncoder().encode('--' + boundary + '--' + CRLF + CRLF);
+  const parts = [];
+  let contentLength = footerBytes.byteLength;
+
+  form.forEach((value, name) => {
+    const part = new FormDataPart(name, value);
+    contentLength += boundaryBytes.byteLength + part.size;
+    parts.push(part);
+  });
+
+  headersHandler({
+    'Content-Type': 'multipart/form-data; boundary=' + boundary,
+    'Content-Length': contentLength
+  });
+
+  const stream = new Readable({
+    read: utils.noop
+  });
+
+  (async function() {
+    try {
+      for (const part of parts) {
+        stream.push(boundaryBytes);
+        stream.push(part.headers);
+
+        if (utils.isString(part.value)) {
+          stream.push(part.value);
+        } else if (part.value.stream) {
+          const reader = part.value.stream().getReader();
+          let chunk;
+
+          while (!(chunk = await reader.read()).done) {
+            stream.push(chunk.value);
+          }
+        } else {
+          stream.push(Buffer.from(await part.value.arrayBuffer()));
+        }
+
+        stream.push(CRLF_BYTES);
+      }
+
+      stream.push(footerBytes);
+      stream.push(null);
+    } catch (err) {
+      stream.destroy(err);
+    }
+  })();
+
+  return stream;
+}
