diff --git a/lib/rubocop/cop/style/guard_clause.rb b/lib/rubocop/cop/style/guard_clause.rb
index 8530dfd3f..1d37c895f 100644
--- a/lib/rubocop/cop/style/guard_clause.rb
+++ b/lib/rubocop/cop/style/guard_clause.rb
@@ -149,6 +149,8 @@ module RuboCop
             return
           end
 
+          return if local_variable_assigned_in_condition_used_in?(node.condition, guard_clause)
+
           guard = nil if and_or_guard_clause?(guard_clause)
 
           register_offense(node, guard_clause_source(guard_clause), kw, guard)
@@ -267,6 +269,13 @@ module RuboCop
           parent.and_type? || parent.or_type?
         end
 
+        def local_variable_assigned_in_condition_used_in?(condition, branch)
+          assigned_variables = condition.each_node(:lvasgn).map { |assignment| assignment.children.first }
+          return false if assigned_variables.empty?
+
+          branch.each_node(:lvar).any? { |variable| assigned_variables.include?(variable.children.first) }
+        end
+
         def too_long_for_single_line?(node, example)
           max = max_line_length
           max && node.source_range.column + example.length > max
