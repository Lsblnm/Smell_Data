+                        UUsageError::new(125, format!("{}: invalid signal", signal_name.quote()))
+                    })?;
+                let signal = Signal::try_from(signal_value as i32).map_err(|_| {
+                    UUsageError::new(125, format!("{}: invalid signal", signal_name.quote()))
+                })?;
+                signals.push(signal);
+            }
