diff --git a/include/fmt/core.h b/include/fmt/core.h
index 834b2d57..09c07f2b 100644
--- a/include/fmt/core.h
+++ b/include/fmt/core.h
@@ -1869,6 +1869,7 @@ template <typename Char> struct basic_format_specs {
   int precision;
   char type;
   align_t align : 4;
+  align_t nonnumeric_align : 4;
   sign_t sign : 3;
   bool alt : 1;  // Alternate form ('#').
   bool localized : 1;
@@ -1879,6 +1880,7 @@ template <typename Char> struct basic_format_specs {
         precision(-1),
         type(0),
         align(align::none),
+        nonnumeric_align(align::none),
         sign(sign::none),
         alt(false),
         localized(false) {}
@@ -1938,7 +1940,10 @@ template <typename Char> class specs_setter {
   FMT_CONSTEXPR specs_setter(const specs_setter& other)
       : specs_(other.specs_) {}
 
-  FMT_CONSTEXPR void on_align(align_t align) { specs_.align = align; }
+  FMT_CONSTEXPR void on_align(align_t align) {
+    specs_.align = align;
+    specs_.nonnumeric_align = align;
+  }
   FMT_CONSTEXPR void on_fill(basic_string_view<Char> fill) {
     specs_.fill = fill;
   }
diff --git a/include/fmt/format.h b/include/fmt/format.h
index 54e8a6cc..d1a7409b 100644
--- a/include/fmt/format.h
+++ b/include/fmt/format.h
@@ -1383,14 +1383,22 @@ template <typename Char> struct write_int_data {
     size = str_size + (sign ? 1 : 0);
     unsigned spec_width = to_unsigned(specs.width);
     padding = spec_width > size ? spec_width - size : 0;
+    auto numeric_alignment = specs.align == align::numeric;
+    auto alignment = numeric_alignment
+                         ? (specs.nonnumeric_align != align::none
+                                ? specs.nonnumeric_align
+                                : align::right)
+                         : specs.align;
+    auto fill = specs.fill;
+    if (numeric_alignment) fill[0] = static_cast<Char>(' ');
     auto* shifts = data::left_padding_shifts;
-    size_t left_padding = padding >> shifts[specs.align];
+    size_t left_padding = padding >> shifts[alignment];
     size_t right_padding = padding - left_padding;
-    auto it = reserve(out, size + padding * specs.fill.size());
-    if (left_padding != 0) it = fill(it, left_padding, specs.fill);
+    auto it = reserve(out, size + padding * fill.size());
+    if (left_padding != 0) it = detail::fill(it, left_padding, fill);
     if (sign) *it++ = static_cast<Char>(data::signs[sign]);
     it = copy_str<Char>(str, str + str_size, it);
-    if (right_padding != 0) it = fill(it, right_padding, specs.fill);
+    if (right_padding != 0) it = detail::fill(it, right_padding, fill);
     return base_iterator(out, it);
   }
 };
