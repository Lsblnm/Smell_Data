diff --git a/src/decNumber/decNumber.c b/src/decNumber/decNumber.c
index 5062634..d0aebcd 100644
--- a/src/decNumber/decNumber.c
+++ b/src/decNumber/decNumber.c
@@ -6166,11 +6166,12 @@ decNumber * decCompareOp(decNumber *res, const decNumber *lhs,
 /*  returns -1, 0, or 1 for A<B, A==B, or A>B, or BADINT if failure   */
 /*  (the only possible failure is an allocation error)                */
 /* ------------------------------------------------------------------ */
-static Int decCompare(const decNumber *lhs, const decNumber *rhs,
-                      Flag abs) {
-  Int   result;                    // result value
-  Int   sigr;                      // rhs signum
-  Int   compare;                   // work
+static Int decCompare(const decNumber *lhs, const decNumber *rhs,
+                      Flag abs) {
+  Int   result;                    // result value
+  Int   sigr;                      // rhs signum
+  Int   compare;                   // work
+  int64_t exp;                     // exponent difference
 
   result=1;                                  // assume signum(lhs)
   if (ISZERO(lhs)) result=0;
@@ -6206,9 +6207,11 @@ static Int decCompare(const decNumber *lhs, const decNumber *rhs,
     rhs=temp;
     result=-result;
     }
-  compare=decUnitCompare(lhs->lsu, D2U(lhs->digits),
-                         rhs->lsu, D2U(rhs->digits),
-                         rhs->exponent-lhs->exponent);
+  exp=(int64_t)rhs->exponent-lhs->exponent;
+  // An exponent gap this large makes rhs's coefficient more significant.
+  if (exp>=lhs->digits) return -result;
+  compare=decUnitCompare(lhs->lsu, D2U(lhs->digits),
+                         rhs->lsu, D2U(rhs->digits), (Int)exp);
   if (compare!=BADINT) compare*=result;      // comparison succeeded
   return compare;
   } // decCompare
