diff --git a/lib/helpers/formDataToStream.js b/lib/helpers/formDataToStream.js
new file mode 100644
index 0000000..ba794d3
--- /dev/null
+++ b/lib/helpers/formDataToStream.js
@@ -0,0 +1,55 @@
+'use strict';
+
+import stream from 'stream';
+import utils from '../utils.js';
+
+const CRLF = Buffer.from('\r\n');
+
+const escapeName = (name) => String(name).replace(/\r?\n|\r\n?/g, '\r\n').replace(/"|\\|\r\n/g, match => '\\' + match);
+
+export default function formDataToStream(form, headersHandler) {
+  const boundary = `axios-${Math.random().toString(16).slice(2)}`;
+  const boundaryBytes = Buffer.from(`--${boundary}\r\n`);
+  const footerBytes = Buffer.from(`--${boundary}--\r\n\r\n`);
+  const parts = Array.from(form.entries()).map(([name, value]) => {
+    const isStringValue = utils.isString(value);
+    let headers = `Content-Disposition: form-data; name="${escapeName(name)}"`;
+
+    if (!isStringValue) {
+      headers += `; filename="${escapeName(value.name || 'blob')}"\r\nContent-Type: ${value.type || 'application/octet-stream'}`;
+    }
+
+    headers = Buffer.from(headers + '\r\n\r\n');
+
+    return {
+      value,
+      headers,
+      size: headers.length + (isStringValue ? Buffer.byteLength(value) : value.size) + CRLF.length
+    };
+  });
+  const contentLength = parts.reduce((length, part) => length + boundaryBytes.length + part.size, footerBytes.length);
+  const readable = new stream.Readable({read: utils.noop});
+
+  headersHandler({
+    'Content-Type': `multipart/form-data; boundary=${boundary}`,
+    'Content-Length': contentLength
+  });
+
+  (async () => {
+    try {
+      for (const part of parts) {
+        readable.push(boundaryBytes);
+        readable.push(part.headers);
+        readable.push(utils.isString(part.value) ? Buffer.from(part.value) : Buffer.from(await part.value.arrayBuffer()));
+        readable.push(CRLF);
+      }
+
+      readable.push(footerBytes);
+      readable.push(null);
+    } catch (err) {
+      readable.destroy(err);
+    }
+  })();
+
+  return readable;
+}
