diff --git a/include/fmt/core.h b/include/fmt/core.h
index 834b2d57..f9c7c70e 100644
--- a/include/fmt/core.h
+++ b/include/fmt/core.h
@@ -1869,6 +1869,7 @@ template <typename Char> struct basic_format_specs {
   int precision;
   char type;
   align_t align : 4;
+  align_t nonfinite_align : 4;
   sign_t sign : 3;
   bool alt : 1;  // Alternate form ('#').
   bool localized : 1;
@@ -1876,10 +1877,11 @@ template <typename Char> struct basic_format_specs {
 
   constexpr basic_format_specs()
       : width(0),
-        precision(-1),
-        type(0),
-        align(align::none),
-        sign(sign::none),
+         precision(-1),
+         type(0),
+         align(align::none),
+         nonfinite_align(align::none),
+         sign(sign::none),
         alt(false),
         localized(false) {}
 };
@@ -1938,7 +1940,10 @@ template <typename Char> class specs_setter {
   FMT_CONSTEXPR specs_setter(const specs_setter& other)
       : specs_(other.specs_) {}
 
-  FMT_CONSTEXPR void on_align(align_t align) { specs_.align = align; }
+  FMT_CONSTEXPR void on_align(align_t align) {
+    specs_.align = align;
+    specs_.nonfinite_align = align;
+  }
   FMT_CONSTEXPR void on_fill(basic_string_view<Char> fill) {
     specs_.fill = fill;
   }
diff --git a/include/fmt/format.h b/include/fmt/format.h
index 4dc9e097..5e9423af 100644
--- a/include/fmt/format.h
+++ b/include/fmt/format.h
@@ -1590,12 +1590,20 @@ template <typename Char, typename OutputIt>
 OutputIt write_nonfinite(OutputIt out, bool isinf,
                          const basic_format_specs<Char>& specs,
                          const float_specs& fspecs) {
+  auto nonfinite_specs = specs;
+  if (nonfinite_specs.align == align::numeric) {
+    nonfinite_specs.align = nonfinite_specs.nonfinite_align == align::none
+                                ? align::right
+                                : nonfinite_specs.nonfinite_align;
+    nonfinite_specs.fill[0] = static_cast<Char>(' ');
+  }
   auto str =
       isinf ? (fspecs.upper ? "INF" : "inf") : (fspecs.upper ? "NAN" : "nan");
   constexpr size_t str_size = 3;
   auto sign = fspecs.sign;
   auto size = str_size + (sign ? 1 : 0);
-  return write_padded(out, specs, size, [=](reserve_iterator<OutputIt> it) {
+  return write_padded(out, nonfinite_specs, size,
+                      [=](reserve_iterator<OutputIt> it) {
     if (sign) *it++ = static_cast<Char>(data::signs[sign]);
     return copy_str<Char>(str, str + str_size, it);
   });
