+    fn print_header_component(
+        &mut self,
+        handle: &mut OutputHandle,
+        label: &str,
+        value: &str,
+        suffix: &str,
+    ) -> Result<()> {
+        self.print_header_component_indent(handle)?;
+
+        let indent_width = if self.config.style_components.grid() && self.panel_width > 0 {
+            self.panel_width + 2
+        } else {
+            self.panel_width
+        };
+        let line_width = self.config.term_width.saturating_sub(indent_width);
+        let mut current_width = 0;
+
+        for (text, style) in [
+            (label, None),
+            (value, Some(self.colors.header_value)),
+            (suffix, None),
+        ] {
+            for c in text.chars() {
+                let character_width = c.width().unwrap_or(0);
+                if current_width > 0 && current_width + character_width > line_width {
+                    writeln!(handle)?;
+                    self.print_header_component_indent(handle)?;
+                    current_width = 0;
+                }
+
+                match style {
+                    Some(style) => write!(handle, "{}", style.paint(c.to_string()))?,
+                    None => write!(handle, "{}", c)?,
+                }
+                current_width += character_width;
+            }
+        }
+        writeln!(handle)
+    }
+
