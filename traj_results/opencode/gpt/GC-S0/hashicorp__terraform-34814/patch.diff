+// disconnectOnDone closes the communicator when the operation completes or is cancelled.
+func disconnectOnDone(ctx context.Context, comm communicator.Communicator) func() {
+	done := make(chan struct{})
+	var once sync.Once
+	disconnect := func() {
+		once.Do(func() {
+			comm.Disconnect()
+		})
+	}
+
+	go func() {
+		select {
+		case <-ctx.Done():
+			disconnect()
+		case <-done:
+		}
+	}()
+
+	return func() {
+		close(done)
+		disconnect()
+	}
+}
