+func parseOptStringSlice(d *caddyfile.Dispenser, _ interface{}) (interface{}, error) {
+	var vals []string
+	for d.Next() {
+		vals = append(vals, d.RemainingArgs()...)
+	}
+	if len(vals) == 0 {
+		return nil, d.ArgErr()
+	}
+	return vals, nil
