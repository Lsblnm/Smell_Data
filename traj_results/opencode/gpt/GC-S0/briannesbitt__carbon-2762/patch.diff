     public function roundUnit($unit, $precision = 1, $function = 'round')
     {
+        $normalizedUnit = Carbon::singularUnit($unit);
+        $timeUnits = [
+            'hour' => 'hours',
+            'minute' => 'minutes',
+            'second' => 'seconds',
+            'millisecond' => 'milliseconds',
+            'microsecond' => 'microseconds',
+        ];
+
+        if (static::$cascadeFactors !== null && !isset(self::getFlipCascadeFactors()['hours']) && isset($timeUnits[$normalizedUnit])) {
+            $rounded = $function($this->total($timeUnits[$normalizedUnit]) / $precision) * $precision;
+            $factors = self::getFlipCascadeFactors();
+            $currentUnit = $timeUnits[$normalizedUnit];
+
+            foreach ($timeUnits as $timeUnit) {
+                $this->set($timeUnit, 0);
+            }
+
+            $value = abs($rounded);
+            $this->set($currentUnit, floor($value));
+            $value -= floor($value);
+
+            while ($value && ($lowerUnit = array_key_first(array_filter($factors, function ($factorData) use ($currentUnit) {
+                return $factorData[0] === $currentUnit;
+            }))) !== null) {
+                $value *= $factors[$lowerUnit][1];
+                $this->set($lowerUnit, floor($value));
+                $value -= floor($value);
+                $currentUnit = $lowerUnit;
+            }
+
+            $this->invert = $rounded < 0 ? 1 : 0;
+
+            return $this->cascade();
+        }
+
         $base = CarbonImmutable::parse('2000-01-01 00:00:00', 'UTC')
             ->roundUnit($unit, $precision, $function);
         $next = $base->add($this);
