diff --git a/include/fmt/std.h b/include/fmt/std.h
index 239deff2..2b2713c3 100644
--- a/include/fmt/std.h
+++ b/include/fmt/std.h
@@ -99,6 +99,7 @@ template <typename Char> struct formatter<std::filesystem::path, Char> {
   format_specs<Char> specs_;
   detail::arg_ref<Char> width_ref_;
   bool debug_ = false;
