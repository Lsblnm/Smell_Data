+
+template <range_format K, typename R, typename Char>
+struct range_default_formatter<
+    K, R, Char,
+    enable_if_t<K == range_format::sequence &&
+                std::is_same<detail::uncvref_type<
+                                 detail::maybe_const_range<R>>,
+                             Char>::value>> {
+ private:
+  using range_type = detail::maybe_const_range<R>;
+  formatter<basic_string_view<Char>, Char> string_formatter_;
+  range_formatter<detail::uncvref_type<range_type>, Char> range_formatter_;
+  bool string_mode_ = false;
+
+ public:
+  template <typename ParseContext>
+  FMT_CONSTEXPR auto parse(ParseContext& ctx) -> decltype(ctx.begin()) {
+    auto it = ctx.begin();
+    bool debug = false;
+    if (it != ctx.end() && *it == static_cast<Char>('?')) {
+      debug = true;
+      ++it;
+    }
+    if (it != ctx.end() && *it == static_cast<Char>('s')) {
+      string_mode_ = true;
+      ++it;
+      ctx.advance_to(it);
+      if (debug) string_formatter_.set_debug_format();
+      return string_formatter_.parse(ctx);
+    }
+    return range_formatter_.parse(ctx);
+  }
+
+  template <typename FormatContext>
+  auto format(range_type& range, FormatContext& ctx) const
+      -> decltype(ctx.out()) {
+    if (!string_mode_) return range_formatter_.format(range, ctx);
+    basic_memory_buffer<Char> buffer;
+    auto it = detail::range_begin(range);
+    auto end = detail::range_end(range);
+    for (; it != end; ++it) buffer.push_back(*it);
+    return string_formatter_.format(
+        basic_string_view<Char>(buffer.data(), buffer.size()), ctx);
+  }
+};
 }  // namespace detail
 
 template <typename T, typename Char, typename Enable = void>
