+    fn print_header_filename(
+        &mut self,
+        handle: &mut OutputHandle,
+        title: &str,
+        prefix: &str,
+        mode: &str,
+    ) -> Result<()> {
+        let indent_width = if self.config.style_components.grid() && self.panel_width > 0 {
+            self.panel_width + 2
+        } else {
+            self.panel_width
+        };
+        let available_width = self.config.term_width.saturating_sub(indent_width);
+        let mut line_width = prefix.width();
+        let mut line = String::new();
+
+        self.print_header_component_indent(handle)?;
+        write!(handle, "{}", prefix)?;
+
+        for character in title.chars() {
+            let character_width = character.width().unwrap_or(0);
+            if line_width + character_width > available_width && !line.is_empty() {
+                write!(handle, "{}", self.colors.header_value.paint(&line))?;
+                writeln!(handle)?;
+                self.print_header_component_indent(handle)?;
+                line.clear();
+                line_width = 0;
+            }
+            line.push(character);
+            line_width += character_width;
+        }
+
+        write!(handle, "{}{}", self.colors.header_value.paint(line), mode)?;
+        writeln!(handle)
+    }
