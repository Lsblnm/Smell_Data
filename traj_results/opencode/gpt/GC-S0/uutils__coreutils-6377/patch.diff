+#[cfg(unix)]
+fn parse_ignored_signals(matches: &clap::ArgMatches) -> UResult<Vec<Signal>> {
+    let mut signals = Vec::new();
+    for values in matches.get_many::<String>("ignore-signal").into_iter().flatten() {
+        for value in values.split(',').filter(|value| !value.is_empty()) {
+            let normalized = value.to_ascii_uppercase();
+            let signal = uucore::signals::signal_by_name_or_value(&normalized)
+                .and_then(|value| Signal::try_from(value as i32).ok())
+                .ok_or_else(|| UUsageError::new(125, format!("{}: invalid signal", value.quote())))?;
+            signals.push(signal);
+        }
+    }
+    Ok(signals)
+}
+
+#[cfg(unix)]
+fn apply_ignored_signals(opts: &Options<'_>) -> UResult<()> {
+    for signal in &opts.ignored_signals {
+        // SAFETY: this only installs the standard ignore disposition.
+        unsafe {
+            sigaction(
+                *signal,
+                &SigAction::new(SigHandler::SigIgn, SaFlags::empty(), SigSet::empty()),
+            )
+        }
+        .map_err(|error| {
+            USimpleError::new(
+                125,
+                format!(
+                    "failed to set signal action for signal {}: {}",
+                    *signal as i32,
+                    error.desc()
+                ),
+            )
+        })?;
+    }
+    Ok(())
+}
+
+#[cfg(not(unix))]
+fn apply_ignored_signals(_opts: &Options<'_>) -> UResult<()> {
+    Ok(())
+}
