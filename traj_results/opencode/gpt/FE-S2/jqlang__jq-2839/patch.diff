diff --git a/src/decNumber/decNumber.c b/src/decNumber/decNumber.c
index 5062634..9693e72 100644
--- a/src/decNumber/decNumber.c
+++ b/src/decNumber/decNumber.c
@@ -6171,6 +6171,7 @@ static Int decCompare(const decNumber *lhs, const decNumber *rhs,
   Int   result;                    // result value
   Int   sigr;                      // rhs signum
   Int   compare;                   // work
+  int64_t adjusted;                // difference between adjusted exponents
 
   result=1;                                  // assume signum(lhs)
   if (ISZERO(lhs)) result=0;
@@ -6206,6 +6207,12 @@ static Int decCompare(const decNumber *lhs, const decNumber *rhs,
     rhs=temp;
     result=-result;
     }
+  // Compare adjusted exponents before calculating the exponent difference,
+  // which can overflow Int for valid decNumber operands.
+  adjusted=(int64_t)lhs->exponent+lhs->digits
+           -((int64_t)rhs->exponent+rhs->digits);
+  if (adjusted>0) return result;
+  if (adjusted<0) return -result;
   compare=decUnitCompare(lhs->lsu, D2U(lhs->digits),
                          rhs->lsu, D2U(rhs->digits),
                          rhs->exponent-lhs->exponent);
