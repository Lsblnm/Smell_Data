+func TestLastChunkSnapshotUsesMostRecentSnapshot(t *testing.T) {
+	dir := t.TempDir()
+	older := filepath.Join(dir, chunkSnapshotDir(178079, 114884608))
+	newer := filepath.Join(dir, chunkSnapshotDir(13482, 1871216))
+	require.NoError(t, os.Mkdir(older, 0o777))
+	require.NoError(t, os.Mkdir(newer, 0o777))
+
+	now := time.Now()
+	require.NoError(t, os.Chtimes(older, now.Add(-time.Hour), now.Add(-time.Hour)))
+	require.NoError(t, os.Chtimes(newer, now, now))
+
+	name, idx, offset, err := LastChunkSnapshot(dir)
+	require.NoError(t, err)
+	require.Equal(t, newer, name)
+	require.Equal(t, 13482, idx)
+	require.Equal(t, 1871216, offset)
+}
+
+func TestDeleteChunkSnapshotsRemovesSnapshotsWithHigherWALSegment(t *testing.T) {
+	dir := t.TempDir()
+	oldSnapshot := filepath.Join(dir, chunkSnapshotDir(178079, 114884608))
+	currentSnapshot := filepath.Join(dir, chunkSnapshotDir(13482, 1871216))
+	require.NoError(t, os.Mkdir(oldSnapshot, 0o777))
+	require.NoError(t, os.Mkdir(currentSnapshot, 0o777))
+
+	require.NoError(t, DeleteChunkSnapshots(dir, 13482, 1871216))
+	_, err := os.Stat(oldSnapshot)
+	require.ErrorIs(t, err, os.ErrNotExist)
+	_, err = os.Stat(currentSnapshot)
+	require.NoError(t, err)
+}
