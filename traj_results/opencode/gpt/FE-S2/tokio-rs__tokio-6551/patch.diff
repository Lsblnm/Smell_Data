+            pub(crate) fn num_blocking_pool_workers(&self) -> usize {
+                match self {
+                    Handle::CurrentThread(_) => 0,
+                    #[cfg(feature = "rt-multi-thread")]
+                    Handle::MultiThread(handle) => handle.num_workers(),
+                    #[cfg(all(tokio_unstable, feature = "rt-multi-thread"))]
