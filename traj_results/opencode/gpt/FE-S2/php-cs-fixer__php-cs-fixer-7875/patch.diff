+    private function isMultilineConstantDeclaration(Tokens $tokens, int $index): bool
+    {
+        $constantIndex = null;
+        for ($searchIndex = $index; $searchIndex >= 0; --$searchIndex) {
+            if ($tokens[$searchIndex]->isGivenKind(T_CONST)) {
+                $constantIndex = $searchIndex;
+
+                break;
+            }
+
+            if ($tokens[$searchIndex]->equalsAny([';', '{', '}'])) {
+                return false;
+            }
+        }
+
+        if (null === $constantIndex) {
+            return false;
+        }
+
+        for ($searchIndex = $constantIndex + 1; $searchIndex < $index; ++$searchIndex) {
+            if ($tokens[$searchIndex]->equals('(')) {
+                $searchIndex = $tokens->findBlockEnd(Tokens::BLOCK_TYPE_PARENTHESIS_BRACE, $searchIndex);
+            } elseif ($tokens[$searchIndex]->equals(CT::T_ARRAY_SQUARE_BRACE_OPEN)) {
+                $searchIndex = $tokens->findBlockEnd(Tokens::BLOCK_TYPE_ARRAY_SQUARE_BRACE, $searchIndex);
+            }
+
+            if ($searchIndex >= $index) {
+                return false;
+            }
+        }
+
+        return true;
+    }
