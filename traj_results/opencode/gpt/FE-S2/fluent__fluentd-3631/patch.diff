diff --git a/lib/fluent/event_router.rb b/lib/fluent/event_router.rb
index bcf24ad8..3e5fefff 100644
--- a/lib/fluent/event_router.rb
+++ b/lib/fluent/event_router.rb
@@ -112,12 +112,18 @@ module Fluent
     end
 
     def emit_stream(tag, es)
-      match(tag).emit_events(tag, es)
+      collector = match(tag)
+      emitted_es = es
+      if collector.is_a?(Pipeline)
+        collector.emit_events(tag, es) { |filtered_es| emitted_es = filtered_es }
+      else
+        collector.emit_events(tag, es)
+      end
       if callback = find_callback
         callback.call(es)
       end
     rescue => e
-      @emit_error_handler.handle_emits_error(tag, es, e)
+      @emit_error_handler.handle_emits_error(tag, emitted_es, e)
     end
 
     def emit_error_event(tag, time, record, error)
@@ -178,6 +184,7 @@ module Fluent
 
       def emit_events(tag, es)
         processed = filter_stream(tag, es)
+        yield processed if block_given?
         @output.emit_events(tag, processed)
       end
 
