 func PathEscape(pth string) string {
+	// PathEscape operates on a path, where query and fragment delimiters are
+	// literal characters and must not be interpreted by url.Parse.
+	pth = strings.NewReplacer("#", "%23", "?", "%3F").Replace(pth)
 	u, err := url.Parse(pth)
