diff --git a/lib/helpers/formDataToStream.js b/lib/helpers/formDataToStream.js
new file mode 100644
index 0000000..c74dc8d
--- /dev/null
+++ b/lib/helpers/formDataToStream.js
@@ -0,0 +1,110 @@
+'use strict';
+
+import stream from 'stream';
+import utils from '../utils.js';
+
+const CRLF = '\r\n';
+const CRLF_BYTES = new Uint8Array([13, 10]);
+const textEncoder = new TextEncoder();
+
+const escapeName = (name) => String(name).replace(/\r?\n|\r/g, '%0D%0A').replace(/"/g, '%22');
+
+const generateString = (size) => {
+  const alphabet = 'abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789';
+  let string = '';
+
+  while (size--) {
+    string += alphabet[Math.random() * alphabet.length | 0];
+  }
+
+  return string;
+};
+
+export default function formDataToStream(form, headersHandler, options) {
+  const {
+    tag = 'form-data-boundary',
+    size = 25,
+    boundary = tag + '-' + generateString(size)
+  } = options || {};
+
+  if (!utils.isFormData(form)) {
+    throw new TypeError('FormData instance required');
+  }
+
+  if (boundary.length > 70) {
+    throw new Error('boundary must be 70 characters or less');
+  }
+
+  const boundaryBytes = textEncoder.encode('--' + boundary + CRLF);
+  const footerBytes = textEncoder.encode('--' + boundary + '--' + CRLF + CRLF);
+  let contentLength = footerBytes.byteLength;
+  const parts = [];
+
+  form.forEach((value, name) => {
+    let headers = 'Content-Disposition: form-data; name="' + escapeName(name) + '"';
+
+    if (utils.isString(value)) {
+      value = textEncoder.encode(String(value));
+    } else {
+      headers += '; filename="' + escapeName(value.name) + '"' + CRLF +
+        'Content-Type: ' + (value.type || 'application/octet-stream');
+    }
+
+    const headerBytes = textEncoder.encode(headers + CRLF + CRLF);
+    contentLength += boundaryBytes.byteLength + headerBytes.byteLength +
+      (typeof value.size === 'number' ? value.size : value.byteLength) + CRLF_BYTES.byteLength;
+    parts.push({headerBytes, value});
+  });
+
+  contentLength = utils.toFiniteNumber(contentLength);
+
+  headersHandler && headersHandler({
+    'Content-Type': 'multipart/form-data; boundary=' + boundary,
+    'Content-Length': contentLength
+  });
+
+  let partIndex = 0;
+  let valueStream;
+
+  const data = new stream.Readable({
+    read() {
+      if (valueStream) {
+        valueStream.resume();
+        return;
+      }
+
+      const part = parts[partIndex++];
+
+      if (!part) {
+        this.push(footerBytes);
+        this.push(null);
+        return;
+      }
+
+      this.push(boundaryBytes);
+      this.push(part.headerBytes);
+
+      if (!part.value.stream) {
+        this.push(part.value);
+        this.push(CRLF_BYTES);
+        this.read(0);
+        return;
+      }
+
+      valueStream = stream.Readable.from(part.value.stream());
+      valueStream.on('data', chunk => {
+        if (!this.push(chunk)) {
+          valueStream.pause();
+        }
+      });
+      valueStream.on('end', () => {
+        valueStream = null;
+        this.push(CRLF_BYTES);
+        this.read(0);
+      });
+      valueStream.on('error', error => this.destroy(error));
+    }
+  });
+
+  return data;
+}
