diff --git a/lib/rubocop/cop/style/redundant_parentheses.rb b/lib/rubocop/cop/style/redundant_parentheses.rb
index d13d51fc1..164a65335 100644
--- a/lib/rubocop/cop/style/redundant_parentheses.rb
+++ b/lib/rubocop/cop/style/redundant_parentheses.rb
@@ -72,7 +72,14 @@ module RuboCop
 
         def allowed_method_call?(node)
           # Don't flag `method (arg) { }`
-          arg_in_call_with_block?(node) && !parentheses?(node.parent)
+          (arg_in_call_with_block?(node) || keyword_block_in_keyword_argument?(node)) &&
+            !parentheses?(node.parent)
+        end
+
+        def keyword_block_in_keyword_argument?(node)
+          return false unless node.parent&.pair_type?
+
+          node.each_descendant(:block, :numblock).any?(&:keywords?)
         end
 
         def allowed_multiple_expression?(node)
