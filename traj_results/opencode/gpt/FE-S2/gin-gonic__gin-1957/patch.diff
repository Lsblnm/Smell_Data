+type headerSource map[string][]string
+
+var _ setter = headerSource(nil)
+
+func (h headerSource) TrySet(value reflect.Value, field reflect.StructField, tagValue string, opt setOptions) (isSetted bool, err error) {
+	for key, values := range h {
+		if textproto.CanonicalMIMEHeaderKey(key) == textproto.CanonicalMIMEHeaderKey(tagValue) {
+			return setByForm(value, field, map[string][]string{tagValue: values}, tagValue, opt)
+		}
+	}
+	return false, nil
+}
