+#[cfg(unix)]
+fn parse_ignored_signals(matches: &clap::ArgMatches) -> UResult<Vec<Signal>> {
+    let mut signals = Vec::new();
+    if let Some(values) = matches.get_many::<String>("ignore-signal") {
+        for value in values {
+            for name in value.split(',').filter(|name| !name.is_empty()) {
+                let value = signal_by_name_or_value(&name.to_ascii_uppercase()).ok_or_else(|| {
+                    USimpleError::new(125, format!("{}: invalid signal", name.quote()))
+                })?;
+                let signal = Signal::try_from(value as i32).map_err(|_| {
+                    USimpleError::new(125, format!("{}: invalid signal", name.quote()))
+                })?;
+                signals.push(signal);
+            }
+        }
+    }
+    Ok(signals)
+}
+
+#[cfg(unix)]
+fn apply_ignored_signals(opts: &Options<'_>) -> UResult<()> {
+    for &signal in &opts.ignored_signals {
+        // SAFETY: SigIgn is a predefined signal disposition, not a custom handler.
+        unsafe {
+            sigaction(
+                signal,
+                &SigAction::new(SigHandler::SigIgn, SaFlags::empty(), SigSet::empty()),
+            )
+        }
+        .map_err(|_| {
+            USimpleError::new(
+                125,
+                format!(
+                    "failed to set signal action for signal {}: Invalid argument",
+                    signal as i32
+                ),
+            )
+        })?;
+    }
+    Ok(())
+}
