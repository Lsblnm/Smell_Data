diff --git a/lib/fpm/package/deb.rb b/lib/fpm/package/deb.rb
index 93d9e4d..a355c49 100644
--- a/lib/fpm/package/deb.rb
+++ b/lib/fpm/package/deb.rb
@@ -793,6 +793,12 @@ class FPM::Package::Deb < FPM::Package
       logger.warn("Replacing 'provides' entry #{provides} with syntax 'name (= version)'")
       provides = "#{m[1]} (= #{m[2]})"
     end
+
+    # Debian only permits exact-version relationships in Provides.
+    unless provides =~ /^[A-Za-z0-9][A-Za-z0-9+.-]*( \(= \S+\))?$/
+      raise FPM::InvalidPackageConfiguration, "Invalid Debian provides entry '#{provides}'"
+    end
+
     return provides.rstrip
   end
 
