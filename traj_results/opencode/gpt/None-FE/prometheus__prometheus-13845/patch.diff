diff --git a/model/labels/labels.go b/model/labels/labels.go
index e99824826..bd804ca69 100644
--- a/model/labels/labels.go
+++ b/model/labels/labels.go
@@ -349,7 +349,11 @@ func (ls Labels) DropMetricName() Labels {
 			if i == 0 { // Make common case fast with no allocations.
 				return ls[1:]
 			}
-			return append(ls[:i], ls[i+1:]...)
+			// Do not overwrite the input's backing array: Labels are commonly shared
+			// by samples from successive range-query steps.
+			result := make(Labels, 0, len(ls)-1)
+			result = append(result, ls[:i]...)
+			return append(result, ls[i+1:]...)
 		}
 	}
 	return ls
