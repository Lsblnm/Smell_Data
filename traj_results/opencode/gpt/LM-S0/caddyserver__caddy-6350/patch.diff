diff --git a/modules/caddyhttp/ip_matchers_test.go b/modules/caddyhttp/ip_matchers_test.go
new file mode 100644
index 00000000..3cde51c8
--- /dev/null
+++ b/modules/caddyhttp/ip_matchers_test.go
@@ -0,0 +1,24 @@
+package caddyhttp
+
+import (
+	"reflect"
+	"testing"
+
+	"github.com/caddyserver/caddy/v2/caddyconfig/caddyfile"
+)
+
+func TestMatchClientIPUnmarshalCaddyfileMultipleSegments(t *testing.T) {
+	d := caddyfile.NewTestDispenser(`client_ip 192.0.2.1
+client_ip 198.51.100.0/24
+client_ip 203.0.113.1`)
+
+	var matcher MatchClientIP
+	if err := matcher.UnmarshalCaddyfile(d); err != nil {
+		t.Fatalf("unmarshaling client_ip matcher: %v", err)
+	}
+
+	want := []string{"192.0.2.1", "198.51.100.0/24", "203.0.113.1"}
+	if !reflect.DeepEqual(matcher.Ranges, want) {
+		t.Errorf("unexpected ranges: got %v, want %v", matcher.Ranges, want)
+	}
+}
