+
+    fn print_wrapped_header(
+        &self,
+        handle: &mut OutputHandle,
+        component_indent: &str,
+        component_indent_width: usize,
+        kind_prefix: &str,
+        title: &str,
+        suffix: &str,
+    ) -> Result<()> {
+        let max_width = self.config.term_width.saturating_sub(component_indent_width).max(1);
+        let mut line: Vec<(bool, String)> = Vec::new();
+        let mut line_width = 0;
+
+        for (is_title, text) in [(false, kind_prefix), (true, title), (false, suffix)] {
+            for character in text.chars() {
+                let character_width = character.width().unwrap_or(0);
+                if line_width > 0 && line_width + character_width > max_width {
+                    write_output!(handle, "{}", component_indent);
+                    for (is_title, text) in &line {
+                        if *is_title {
+                            write_output!(handle, "{}", self.colors.header_value.paint(text));
+                        } else {
+                            write_output!(handle, "{}", text);
+                        }
+                    }
+                    write_output!(handle, "\n");
+                    line.clear();
+                    line_width = 0;
+                }
+
+                if let Some((previous_is_title, text)) = line.last_mut() {
+                    if *previous_is_title == is_title {
+                        text.push(character);
+                    } else {
+                        line.push((is_title, character.to_string()));
+                    }
+                } else {
+                    line.push((is_title, character.to_string()));
+                }
+                line_width += character_width;
+            }
+        }
+
+        write_output!(handle, "{}", component_indent);
+        for (is_title, text) in line {
+            if is_title {
+                write_output!(handle, "{}", self.colors.header_value.paint(text));
+            } else {
+                write_output!(handle, "{}", text);
+            }
+        }
+        write_output!(handle, "\n");
+
+        Ok(())
+    }
 }
 
 
