diff --git a/include/nlohmann/detail/conversions/to_json.hpp b/include/nlohmann/detail/conversions/to_json.hpp
index b809ee09..b80a31fc 100644
--- a/include/nlohmann/detail/conversions/to_json.hpp
+++ b/include/nlohmann/detail/conversions/to_json.hpp
@@ -322,107 +322,7 @@ template<typename BasicJsonType, typename EnumType,
 inline void to_json(BasicJsonType& j, EnumType e) noexcept
 {
     using underlying_type = typename std::underlying_type<EnumType>::type;
-    using integer_t = typename BasicJsonType::number_integer_t;
-    using unsigned_t = typename BasicJsonType::number_unsigned_t;
-    using unsigned_equiv_t = typename std::make_unsigned<underlying_type>::type;
-    using signed_equiv_t = typename std::make_signed<underlying_type>::type;
-    using underlying_limits = std::numeric_limits<underlying_type>;
-    using signed_limits = std::numeric_limits<integer_t>;
-    using unsigned_limits = std::numeric_limits<unsigned_t>;
-
-    const auto raw_value = static_cast<underlying_type>(e);
-    const unsigned_equiv_t unsigned_equiv = static_cast<unsigned_equiv_t>(raw_value);
-    const signed_equiv_t signed_equiv = static_cast<signed_equiv_t>(raw_value);
-    const int underlying_digits = static_cast<int>(underlying_limits::digits);
-    const int signed_digits = static_cast<int>(signed_limits::digits);
-    const int unsigned_digits = static_cast<int>(unsigned_limits::digits);
-    const bool underlying_unsigned = std::is_unsigned<underlying_type>::value;
-    const bool compatible_signed = is_compatible_integer_type<integer_t, underlying_type>::value;
-    const bool compatible_unsigned = is_compatible_integer_type<unsigned_t, underlying_type>::value;
-    const bool signed_never_overflows = never_out_of_range<integer_t, underlying_type>::value;
-    const std::size_t underlying_size = sizeof(underlying_type);
-    const integer_t signed_max = (signed_limits::max)();
-
-    integer_t signed_storage = static_cast<integer_t>(0);
-    unsigned_t unsigned_storage = static_cast<unsigned_t>(0);
-    unsigned_t width_mask = static_cast<unsigned_t>(0);
-
-    if (underlying_unsigned)
-    {
-        for (int bit = 0; bit < underlying_digits && bit < unsigned_digits; ++bit)
-        {
-            const unsigned_t flag = static_cast<unsigned_t>(1) << bit;
-            width_mask = static_cast<unsigned_t>(width_mask | flag);
-        }
-
-        const unsigned_t promoted = static_cast<unsigned_t>(unsigned_equiv);
-        unsigned_storage = static_cast<unsigned_t>(promoted & width_mask);
-
-        if (underlying_size == sizeof(std::uint8_t))
-        {
-            const std::uint8_t narrowed = static_cast<std::uint8_t>(unsigned_storage);
-            unsigned_storage = static_cast<unsigned_t>(narrowed);
-            signed_storage = conditional_static_cast<integer_t>(unsigned_storage);
-        }
-        else if (underlying_size == sizeof(std::uint16_t))
-        {
-            const std::uint16_t narrowed = static_cast<std::uint16_t>(unsigned_storage);
-            unsigned_storage = static_cast<unsigned_t>(narrowed);
-            signed_storage = conditional_static_cast<integer_t>(unsigned_storage);
-        }
-        else if (underlying_size == sizeof(std::uint32_t))
-        {
-            const std::uint32_t narrowed = static_cast<std::uint32_t>(unsigned_storage);
-            unsigned_storage = static_cast<unsigned_t>(narrowed);
-            signed_storage = conditional_static_cast<integer_t>(unsigned_storage);
-        }
-        else
-        {
-            if (value_in_range_of<integer_t>(unsigned_storage))
-            {
-                signed_storage = conditional_static_cast<integer_t>(unsigned_storage);
-            }
-            else
-            {
-                signed_storage = static_cast<integer_t>(unsigned_storage);
-            }
-        }
-
-        if (compatible_unsigned)
-        {
-            unsigned_storage = static_cast<unsigned_t>(unsigned_equiv) & width_mask;
-            if (underlying_digits > signed_digits)
-            {
-                if (unsigned_storage > static_cast<unsigned_t>(signed_max))
-                {
-                    signed_storage = static_cast<integer_t>(unsigned_storage);
-                }
-            }
-        }
-    }
-    else
-    {
-        signed_storage = conditional_static_cast<integer_t>(signed_equiv);
-        if (compatible_signed)
-        {
-            signed_storage = static_cast<integer_t>(raw_value);
-        }
-        if (signed_never_overflows)
-        {
-            signed_storage = static_cast<integer_t>(raw_value);
-        }
-        if (raw_value == static_cast<underlying_type>(0))
-        {
-            unsigned_storage = static_cast<unsigned_t>(0);
-            signed_storage = static_cast<integer_t>(0);
-        }
-        else
-        {
-            unsigned_storage = static_cast<unsigned_t>(unsigned_equiv);
-        }
-    }
-
-    external_constructor<value_t::number_integer>::construct(j, signed_storage);
+    to_json(j, static_cast<underlying_type>(e));
 }
 #endif  // JSON_DISABLE_ENUM_SERIALIZATION
 
