+template <typename OutputIt, typename Char>
+auto write_int(OutputIt out, string_view digit_view, unsigned prefix,
+               const format_specs<Char>& specs,
+               const digit_grouping<Char>& grouping) -> OutputIt {
+  auto num_digits = static_cast<int>(digit_view.size());
+  int separator_count = grouping.count_separators(num_digits);
+  unsigned prefix_size = prefix >> 24;
+  unsigned grouped_size =
+      prefix_size + to_unsigned(num_digits) + to_unsigned(separator_count);
+  unsigned spec_width = to_unsigned(specs.width);
+  size_t padding = spec_width > grouped_size ? spec_width - grouped_size : 0;
+  const char* shifts = "\x00\x1f\x00\x01";
+  unsigned align_index = static_cast<unsigned>(specs.align);
+  size_t left_padding = padding >> shifts[align_index];
+  size_t right_padding = padding - left_padding;
+  size_t fill_size = specs.fill.size();
+  const Char* fill_data = specs.fill.data();
+  auto it = reserve(out, grouped_size + padding * fill_size);
+  if (left_padding != 0) {
+    for (size_t n = 0; n < left_padding; ++n) {
+      const Char* fill_begin = fill_data;
+      const Char* fill_end = fill_data + fill_size;
+      while (fill_begin != fill_end) {
+        *it++ = static_cast<Char>(*fill_begin++);
+      }
+    }
+  }
+  if (prefix != 0) {
+    for (unsigned p = prefix & 0xffffff; p != 0; p >>= 8)
+      *it++ = static_cast<Char>(p & 0xff);
   }
