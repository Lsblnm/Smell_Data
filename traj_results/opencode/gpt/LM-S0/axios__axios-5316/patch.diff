diff --git a/lib/helpers/formDataToStream.js b/lib/helpers/formDataToStream.js
new file mode 100644
index 0000000..9b4a8f6
--- /dev/null
+++ b/lib/helpers/formDataToStream.js
@@ -0,0 +1,48 @@
+'use strict';
+
+import stream from 'stream';
+
+const CRLF = '\r\n';
+
+const escapeName = name => String(name).replace(/\r|\n|"/g, match => ({
+  '\r': '%0D',
+  '\n': '%0A',
+  '"': '%22'
+})[match]);
+
+export default function formDataToStream(form) {
+  const boundary = 'axios-' + Math.random().toString(16).slice(2);
+  const formDataStream = new stream.Readable({
+    read() {}
+  });
+
+  (async function () {
+    try {
+      for (const [name, value] of form.entries()) {
+        formDataStream.push(Buffer.from('--' + boundary + CRLF +
+          'Content-Disposition: form-data; name="' + escapeName(name) + '"' +
+          (value && typeof value.arrayBuffer === 'function'
+            ? '; filename="' + escapeName(value.name || 'blob') + '"' + CRLF +
+              'Content-Type: ' + (value.type || 'application/octet-stream')
+            : '') + CRLF + CRLF));
+
+        formDataStream.push(value && typeof value.arrayBuffer === 'function'
+          ? Buffer.from(await value.arrayBuffer())
+          : Buffer.from(String(value)));
+        formDataStream.push(Buffer.from(CRLF));
+      }
+
+      formDataStream.push(Buffer.from('--' + boundary + '--' + CRLF));
+      formDataStream.push(null);
+    } catch (err) {
+      formDataStream.destroy(err);
+    }
+  })();
+
+  return {
+    headers: {
+      'Content-Type': 'multipart/form-data; boundary=' + boundary
+    },
+    stream: formDataStream
+  };
+}
