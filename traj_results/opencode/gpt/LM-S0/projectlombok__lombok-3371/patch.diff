@@ -269,6 +269,19 @@ public class HandleNonNull extends JavacAnnotationHandler<NonNull> {
 		case TYPE_USE:
 			JavacNode typeUseNode = annotationNode.directUp();
 			paramNode = typeUseNode.directUp();
+			if (paramNode.getKind() == Kind.FIELD) {
+				JCVariableDecl fieldDecl = (JCVariableDecl) paramNode.get();
+				if ((fieldDecl.mods.flags & RECORD) != 0) {
+					// Type-use annotations on record components are nested below the field,
+					// unlike declaration annotations which are direct field children.
+					JavacNode recordTypeNode = paramNode.up();
+					List<JCMethodDecl> compactConstructors = addCompactConstructorIfNeeded(recordTypeNode, annotationNode);
+					for (JCMethodDecl ctr : compactConstructors) {
+						addNullCheckIfNeeded(ctr, paramNode, annotationNode);
+					}
+				}
+				return;
+			}
 			break;
 		default:
 			return;
