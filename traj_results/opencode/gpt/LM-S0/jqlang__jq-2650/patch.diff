+static block gen_index_term(block obj, block start, block end, opcode idx_op, int is_slice) {
+  const struct opcode_description *opinfo;
+  block start_exp;
+  block end_exp;
+  block key_exp;
+  block result;
+  block opblk;
+  jv start_val;
+  jv end_val;
+
+  opinfo = opcode_describe(idx_op);
+  opblk = gen_op_simple(idx_op);
+
+  if (opinfo->stack_in == 1) {
+    if (block_is_noop(obj)) {
+      return opblk;
+    }
+    return block_join(obj, opblk);
+  }
+
+  if (is_slice) {
+    key_exp = gen_op_pushk_under(jv_object());
+    key_exp = block_join(key_exp, gen_op_pushk_under(jv_string("start")));
+    if (block_is_noop(start)) {
+      start_exp = gen_op_simple(DUP);
+    } else {
+      if (block_is_const(start)) {
+        start_val = block_const(start);
+        block_free(start);
+        start_exp = gen_op_pushk_under(start_val);
+      } else {
+        start_exp = block_join(gen_op_simple(SUBEXP_BEGIN), start);
+        start_exp = block_join(start_exp, gen_op_simple(SUBEXP_END));
+      }
+    }
+    key_exp = block_join(key_exp, start_exp);
+    key_exp = block_join(key_exp, gen_op_simple(INSERT));
+    key_exp = block_join(key_exp, gen_op_pushk_under(jv_string("end")));
+    if (block_is_noop(end)) {
+      end_exp = gen_op_simple(DUP);
+    } else {
+      if (block_is_const(end)) {
+        end_val = block_const(end);
+        block_free(end);
+        end_exp = gen_op_pushk_under(end_val);
+      } else {
+        end_exp = block_join(gen_op_simple(SUBEXP_BEGIN), end);
+        end_exp = block_join(end_exp, gen_op_simple(SUBEXP_END));
+      }
+    }
+    key_exp = block_join(key_exp, end_exp);
+    key_exp = block_join(key_exp, gen_op_simple(INSERT));
+    if (block_is_noop(obj)) {
+      result = block_join(key_exp, opblk);
+    } else {
+      result = block_join(key_exp, obj);
+      result = block_join(result, opblk);
+    }
+    return result;
+  }
+
+  if (!block_is_noop(end)) {
+    block_free(end);
+  }
+  if (block_is_noop(start)) {
+    key_exp = gen_op_simple(DUP);
+  } else {
+    if (block_is_const(start)) {
+      start_val = block_const(start);
+      block_free(start);
+      key_exp = gen_op_pushk_under(start_val);
+    } else {
+      key_exp = block_join(gen_op_simple(SUBEXP_BEGIN), start);
+      key_exp = block_join(key_exp, gen_op_simple(SUBEXP_END));
+    }
+  }
+  if (block_is_noop(obj)) {
+    result = block_join(key_exp, opblk);
+  } else {
+    result = block_join(key_exp, obj);
+    result = block_join(result, opblk);
+  }
+  return result;
+}
