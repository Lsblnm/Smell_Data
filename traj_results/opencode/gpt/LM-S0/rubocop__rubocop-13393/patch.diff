diff --git a/lib/rubocop/cop/style/guard_clause.rb b/lib/rubocop/cop/style/guard_clause.rb
index 6a43cad19..9bed8abf7 100644
--- a/lib/rubocop/cop/style/guard_clause.rb
+++ b/lib/rubocop/cop/style/guard_clause.rb
@@ -149,6 +149,8 @@ module RuboCop
             return
           end
 
+          return if guard_clause_uses_variable_assigned_in_condition?(guard_clause, node.condition)
+
           guard = nil if and_or_guard_clause?(guard_clause)
 
           register_offense(node, guard_clause_source(guard_clause), kw, guard)
@@ -267,6 +269,17 @@ module RuboCop
           parent.and_type? || parent.or_type?
         end
 
+        def guard_clause_uses_variable_assigned_in_condition?(guard_clause, condition)
+          assigned_variables = [condition, *condition.descendants].filter_map do |node|
+            node.children.first if node.lvasgn_type?
+          end
+          return false if assigned_variables.empty?
+
+          [guard_clause, *guard_clause.descendants].any? do |node|
+            node.lvar_type? && assigned_variables.include?(node.children.first)
+          end
+        end
+
         def too_long_for_single_line?(node, example)
           max = max_line_length
           max && node.source_range.column + example.length > max
