+        def safe_navigation_chain_too_long?(start_method, method_chain)
+          chain_length_config = config.for_cop('Style/SafeNavigationChainLength')
+          return false unless chain_length_config['Enabled']
+
+          max = chain_length_config.fetch('Max', 2)
+          chain_length = 0
+
+          start_method.each_ancestor do |ancestor|
+            break unless %i[send block].include?(ancestor.type)
+            next unless ancestor.send_type?
+
+            chain_length += 1
+            break if ancestor == method_chain
+          end
+
+          chain_length > max
+        end
+
