+function wrapAtRuleDecls(atRule: AtRule) {
+  if (!atRule.nodes) return
+
+  const decls = atRule.nodes.filter(
+    node => node.type === 'decl' || node.type === 'comment',
+  )
+  if (decls.length) {
+    for (const decl of decls) {
+      atRule.removeChild(decl)
+    }
