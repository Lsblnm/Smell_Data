+    /**
+     * @param list<Token> $attributeTokens
+     */
+    private static function getAttributeArguments(array|Tokens $attributeTokens, ?int $start = null, ?int $end = null): string
+    {
+        $arguments = '';
+        $parenthesesLevel = 0;
+        $start ??= 0;
+        $end ??= \count($attributeTokens) - 1;
+        for ($index = $start; $index <= $end; ++$index) {
+            $token = $attributeTokens[$index];
+            if ($token->equals('(')) {
+                ++$parenthesesLevel;
+            }
+            if (0 !== $parenthesesLevel && !$token->isWhitespace()) {
+                $arguments .= $token->getContent();
+            }
+            if ($token->equals(')')) {
+                --$parenthesesLevel;
+            }
+        }
+
+        return $arguments;
+    }
+
