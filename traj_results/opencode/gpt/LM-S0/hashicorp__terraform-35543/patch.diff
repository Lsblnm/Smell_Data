+// validateImportTargets evaluates import expressions during validation so that
+// references in import blocks receive the same static checks as resource config.
+func (n *NodeValidatableResource) validateImportTargets(ctx EvalContext) tfdiags.Diagnostics {
+	var diags tfdiags.Diagnostics
+
+	for _, target := range n.importTargets {
+		if target.Config == nil {
+			continue
+		}
+
+		if target.Config.ForEach == nil {
+			traversal, hclDiags := hcl.AbsTraversalForExpr(target.Config.To)
+			diags = diags.Append(hclDiags)
+			to, moreDiags := addrs.ParseAbsResourceInstance(traversal)
+			diags = diags.Append(moreDiags)
+			if diags.HasErrors() {
+				return diags
+			}
+
+			_, moreDiags = evaluateImportIdExpression(target.Config.ID, to, ctx, EvalDataForNoInstanceKey, true)
+			diags = diags.Append(moreDiags)
+			if diags.HasErrors() {
+				return diags
+			}
+			continue
+		}
+
+		forEachData, known, moreDiags := newForEachEvaluator(target.Config.ForEach, ctx, true).ImportValues()
+		diags = diags.Append(moreDiags)
+		if diags.HasErrors() {
+			return diags
+		}
+
+		if !known {
+			_, moreDiags = evalImportUnknownToExpression(target.Config.To)
+			diags = diags.Append(moreDiags)
+			if diags.HasErrors() {
+				return diags
+			}
+
+			to := target.Config.ToResource.Absolute(addrs.RootModuleInstance).Instance(addrs.NoKey)
+			_, moreDiags = evaluateImportIdExpression(target.Config.ID, to, ctx, instances.UnknownForEachRepetitionData(cty.DynamicPseudoType), true)
+			diags = diags.Append(moreDiags)
+			if diags.HasErrors() {
+				return diags
+			}
+			continue
+		}
+
+		for _, keyData := range forEachData {
+			to, moreDiags := evalImportToExpression(target.Config.To, keyData)
+			diags = diags.Append(moreDiags)
+			if diags.HasErrors() {
+				return diags
+			}
+
+			_, moreDiags = evaluateImportIdExpression(target.Config.ID, to, ctx, keyData, true)
+			diags = diags.Append(moreDiags)
+			if diags.HasErrors() {
+				return diags
+			}
+		}
+	}
+
+	return diags
+}
