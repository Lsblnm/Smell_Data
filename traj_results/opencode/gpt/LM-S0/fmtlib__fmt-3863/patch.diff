diff --git a/include/fmt/ranges.h b/include/fmt/ranges.h
index b6e81fdd..4c669b29 100644
--- a/include/fmt/ranges.h
+++ b/include/fmt/ranges.h
@@ -519,6 +519,8 @@ struct range_default_formatter<
                  K == range_format::set)>> {
   using range_type = detail::maybe_const_range<R>;
   range_formatter<detail::uncvref_type<range_type>, Char> underlying_;
+  formatter<basic_string_view<Char>, Char> string_formatter_;
+  bool format_as_string_ = false;
 
   FMT_CONSTEXPR range_default_formatter() { init(range_format_constant<K>()); }
 
@@ -539,12 +541,63 @@ struct range_default_formatter<
 
   template <typename ParseContext>
   FMT_CONSTEXPR auto parse(ParseContext& ctx) -> decltype(ctx.begin()) {
-    return underlying_.parse(ctx);
+    return parse(ctx, bool_constant<K == range_format::sequence &&
+                                    std::is_same<
+                                        detail::uncvref_type<range_type>,
+                                        Char>::value>{});
   }
 
   template <typename FormatContext>
   auto format(range_type& range, FormatContext& ctx) const
       -> decltype(ctx.out()) {
+    return format(range, ctx,
+                  bool_constant<K == range_format::sequence &&
+                                std::is_same<detail::uncvref_type<range_type>,
+                                             Char>::value>{});
+  }
+
+ private:
+  template <typename ParseContext>
+  FMT_CONSTEXPR auto parse(ParseContext& ctx, std::false_type)
+      -> decltype(ctx.begin()) {
+    return underlying_.parse(ctx);
+  }
+
+  template <typename ParseContext>
+  FMT_CONSTEXPR auto parse(ParseContext& ctx, std::true_type)
+      -> decltype(ctx.begin()) {
+    auto it = ctx.begin();
+    auto end = ctx.end();
+    auto last = it;
+    while (last != end && *last != '}') ++last;
+    if (last != it && *(last - 1) == 's') {
+      format_as_string_ = true;
+      auto result = string_formatter_.parse(ctx);
+      // The range string presentation type follows the debug presentation.
+      if (result != end && *result == 's') ++result;
+      return result;
+    }
+    return underlying_.parse(ctx);
+  }
+
+  template <typename FormatContext>
+  auto format(range_type& range, FormatContext& ctx, std::false_type) const
+      -> decltype(ctx.out()) {
+    return underlying_.format(range, ctx);
+  }
+
+  template <typename FormatContext>
+  auto format(range_type& range, FormatContext& ctx, std::true_type) const
+      -> decltype(ctx.out()) {
+    if (format_as_string_) {
+      auto buffer = basic_memory_buffer<Char>();
+      for (auto it = detail::range_begin(range), end = detail::range_end(range);
+           it != end; ++it) {
+        buffer.push_back(*it);
+      }
+      return string_formatter_.format(
+          basic_string_view<Char>(buffer.data(), buffer.size()), ctx);
+    }
     return underlying_.format(range, ctx);
   }
 };
