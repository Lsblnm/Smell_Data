+func parseOptDefaultBind(d *caddyfile.Dispenser, existing interface{}) (interface{}, error) {
+	var addresses []string
+	if existing != nil {
+		addresses = existing.([]string)
+	}
+
+	d.Next() // consume parameter name
+	if !d.NextArg() {
+		return nil, d.ArgErr()
+	}
+	addresses = append(addresses, d.Val())
+	addresses = append(addresses, d.RemainingArgs()...)
+
+	return addresses, nil
+}
