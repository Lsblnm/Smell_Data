+func TestDefaultBindOption(t *testing.T) {
+	adapter := caddyfile.Adapter{ServerType: ServerType{}}
+	out, _, err := adapter.Adapt([]byte(`{
+		default_bind [2001:db8:11:ad::80] 198.51.100.184
+		default_bind [2001:db8:11:ad::81]
+	}
+	:33441 {
+		respond "site 33441"
+	}`), nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	for _, listen := range []string{
+		"[2001:db8:11:ad::80]:33441",
+		"198.51.100.184:33441",
+		"[2001:db8:11:ad::81]:33441",
+	} {
+		if !strings.Contains(string(out), `"`+listen+`"`) {
+			t.Errorf("adapted config does not contain listener %q: %s", listen, out)
+		}
+	}
+}
