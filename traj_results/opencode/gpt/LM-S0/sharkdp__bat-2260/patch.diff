+#[test]
+fn custom_mappings_use_ignored_suffixes() {
+    let mut map = SyntaxMapping::empty();
+    map.insert("*.demo", MappingTarget::MapTo("YAML")).unwrap();
+    map.insert_ignored_suffix(".example");
+
+    assert_eq!(
+        map.get_syntax_for("/path/to/foo.demo.example"),
+        Some(MappingTarget::MapTo("YAML"))
+    );
+}
+
+#[test]
+fn path_mappings_use_ignored_suffixes() {
+    let mut map = SyntaxMapping::empty();
+    map.insert("/path/to/*.demo", MappingTarget::MapTo("YAML"))
+        .unwrap();
+    map.insert_ignored_suffix(".example");
+
+    assert_eq!(
+        map.get_syntax_for("/path/to/foo.demo.example"),
+        Some(MappingTarget::MapTo("YAML"))
+    );
+}
