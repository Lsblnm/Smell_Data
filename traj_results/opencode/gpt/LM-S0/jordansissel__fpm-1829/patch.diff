--- a/lib/fpm/package/deb.rb
+++ b/lib/fpm/package/deb.rb
@@ -775,6 +775,12 @@ class FPM::Package::Deb < FPM::Package
   end # def fix_dependency
 
   def fix_provides(provides)
+    valid_provides = /\A[A-Za-z0-9_-]+(?:\s+\(\s*[<>=]+\s+[^\s()]+\s*\)|\s*=\s*\d[^\s()]*)?\s*\z/
+    unless valid_provides.match?(provides)
+      raise FPM::InvalidPackageConfiguration,
+        "Invalid Debian Provides entry: #{provides}"
+    end
+
     name_re = /^[^ \(]+/
     name = provides[name_re]
     relation = nil
@@ -810,6 +816,11 @@ class FPM::Package::Deb < FPM::Package
       end
 
       if !relation.nil?
+        if relation != "="
+          raise FPM::InvalidPackageConfiguration,
+            "Debian Provides version relations must use '=': #{provides}"
+        end
+
         mapped_relation = {:< => "<<", :> => ">>"}[relation.to_sym]
         if mapped_relation.nil?
           mapped_relation = debianize_op(relation)
