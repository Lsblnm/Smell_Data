+    q->slice_start_i = 0;
+    q->slice_end_i = 0;
+    return 0;
+  }
+  if (start < 0) {
+    start += len;
+  }
+  if (end < 0) {
+    end += len;
+  }
+  if (start < 0) {
+    start = 0;
+  }
+  if (start > len) {
+    start = len;
+  }
+  if (end > len) {
+    end = len;
+  }
+  if (end < start) {
+    end = start;
+  }
+  q->slice_start_i = start;
+  q->slice_end_i = end;
+  return 1;
+}
