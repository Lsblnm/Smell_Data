+static int jq_query_front_slice_length_of(struct jq_query_front *q, jv j) {
+  jv_kind k = jv_get_kind(j);
+  q->slice_len = 0;
+  if (k == JV_KIND_ARRAY) {
+    q->slice_len = jv_array_length(j);
+    return 1;
+  }
+  if (k == JV_KIND_STRING) {
+    q->slice_len = jv_string_length_codepoints(j);
+    return 1;
+  }
+  jv_free(j);
+  return 0;
+}
