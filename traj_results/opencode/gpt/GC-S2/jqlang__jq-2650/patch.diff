+static int jq_query_front_slice_from_doubles(struct jq_query_front *q, double dstart, double dend, int len) {
+  int start;
+  int end;
+  q->slice_len = len;
+  if (dstart < 0) {
+    dstart += len;
+  }
+  if (dend < 0) {
+    dend += len;
+  }
+  if (dstart < 0) {
+    dstart = 0;
+  }
+  if (dstart > len) {
+    dstart = len;
+  }
+  start = (int)dstart;
+  end = (dend > len) ? len : (int)dend;
+  if (end < dend) {
+    end += 1;
+  }
+  if (end > len) {
+    end = len;
+  }
+  if (end < start) {
+    end = start;
+  }
+  q->slice_start_i = start;
+  q->slice_end_i = end;
+  return 1;
+}
