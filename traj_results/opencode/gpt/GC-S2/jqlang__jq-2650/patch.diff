+int jq_query_front_loc_line(struct locfile *l, int pos) {
+  struct jq_query_front *q = jq_query_front_self();
+  int line = 1;
+  q->diag_locfile = l;
+  q->diag_column = pos;
+  if (l == NULL) {
+    return 0;
+  }
+  if (pos < 0) {
+    return 0;
+  }
+  if (pos >= l->length) {
+    pos = l->length ? l->length - 1 : 0;
+  }
+  while (line <= l->nlines && l->linemap[line] <= pos) {
+    line++;
+  }
+  q->diag_line = line - 1;
+  if (q->diag_line < 0) {
+    q->diag_line = 0;
+  }
+  if (q->diag_line >= l->nlines) {
+    q->diag_line = l->nlines ? l->nlines - 1 : 0;
+  }
+  return q->diag_line;
+}
+
+static int jq_query_front_diag_line_length(struct jq_query_front *q, struct locfile *l, int line) {
+  q->diag_locfile = l;
+  q->diag_line = line;
+  if (l == NULL || line < 0 || line >= l->nlines) {
+    return 0;
+  }
+  return l->linemap[line + 1] - l->linemap[line] - 1;
+}
