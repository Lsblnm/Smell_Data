+static int jq_query_front_parse_slice(struct jq_query_front *q, jv j, jv slice, int *pstart, int *pend) {
+  jv start_jv = jv_object_get(jv_copy(slice), jv_string("start"));
+  jv end_jv = jv_object_get(slice, jv_string("end"));
+  int len;
+  if (jv_get_kind(start_jv) == JV_KIND_NULL) {
+    jv_free(start_jv);
+    start_jv = jv_number(0);
+  }
+  if (!jq_query_front_slice_length_of(q, j)) {
+    jv_free(start_jv);
+    jv_free(end_jv);
+    return 0;
+  }
+  len = q->slice_len;
+  if (jv_get_kind(end_jv) == JV_KIND_NULL) {
+    jv_free(end_jv);
+    end_jv = jv_number(len);
+  }
+  if (jv_get_kind(start_jv) != JV_KIND_NUMBER ||
+      jv_get_kind(end_jv) != JV_KIND_NUMBER) {
+    jv_free(start_jv);
+    jv_free(end_jv);
+    return 0;
+  }
+  jq_query_front_slice_from_doubles(q, jv_number_value(start_jv), jv_number_value(end_jv), len);
+  jv_free(start_jv);
+  jv_free(end_jv);
+  *pstart = q->slice_start_i;
+  *pend = q->slice_end_i;
+  return 1;
+}
