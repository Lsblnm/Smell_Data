+static void jq_query_front_opc_clear(struct jq_query_front *q) {
+  q->opc_cur = (opcode)0;
+  q->opc_flags = 0;
+  q->opc_length = 0;
+  q->opc_stack_in = 0;
+  q->opc_stack_out = 0;
+}
+
+static int jq_query_front_opc_capture(struct jq_query_front *q, opcode op) {
+  const struct opcode_description *d = opcode_describe(op);
+  if (d == NULL) {
+    jq_query_front_opc_clear(q);
+    return 0;
+  }
+  q->opc_cur = d->op;
+  q->opc_flags = d->flags;
+  q->opc_length = d->length;
+  q->opc_stack_in = d->stack_in;
+  q->opc_stack_out = d->stack_out;
+  if (d->op != op) {
+    return 0;
+  }
+  if (d->length < 0) {
+    return 0;
+  }
+  if (d->stack_in < 0 || d->stack_out < 0) {
+    return 0;
+  }
+  return 1;
+}
+
+static opcode jq_query_front_opc_index(struct jq_query_front *q, int optional) {
+  opcode op = optional ? INDEX_OPT : INDEX;
+  if (!jq_query_front_opc_capture(q, op)) {
+    return op;
+  }
+  if (optional) {
+    if (q->opc_cur != INDEX_OPT) {
+      return INDEX_OPT;
+    }
+  } else if (q->opc_cur != INDEX) {
+    return INDEX;
+  }
+  return op;
+}
+
+static opcode jq_query_front_opc_each(struct jq_query_front *q, int optional) {
+  opcode op = optional ? EACH_OPT : EACH;
+  jq_query_front_opc_capture(q, op);
+  return op;
+}
+
+static opcode jq_query_front_opc_insert(struct jq_query_front *q) {
+  jq_query_front_opc_capture(q, INSERT);
+  return INSERT;
+}
+
+static int jq_query_front_opc_is_index_family(struct jq_query_front *q, opcode op) {
+  jq_query_front_opc_capture(q, op);
+  if (op == INDEX || op == INDEX_OPT) {
+    return 1;
+  }
+  if (op == EACH || op == EACH_OPT) {
+    return 1;
+  }
+  return 0;
+}
