+func TestChunkSnapshotUsesMostRecentlyCreatedSnapshot(t *testing.T) {
+	dir := t.TempDir()
+	oldSnapshot := filepath.Join(dir, chunkSnapshotDir(100, 100))
+	newSnapshot := filepath.Join(dir, chunkSnapshotDir(1, 200))
+	referenceTime := time.Now()
+
+	require.NoError(t, os.Mkdir(oldSnapshot, 0o777))
+	require.NoError(t, os.Chtimes(oldSnapshot, referenceTime.Add(-time.Hour), referenceTime.Add(-time.Hour)))
+	require.NoError(t, os.Mkdir(newSnapshot, 0o777))
+
+	name, idx, offset, err := LastChunkSnapshot(dir)
+	require.NoError(t, err)
+	require.Equal(t, newSnapshot, name)
+	require.Equal(t, 1, idx)
+	require.Equal(t, 200, offset)
+
+	require.NoError(t, DeleteChunkSnapshots(dir, idx, offset))
+	require.NoDirExists(t, oldSnapshot)
+	require.DirExists(t, newSnapshot)
+}
