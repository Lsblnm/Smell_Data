+func (n *NodeValidatableResource) validateImportTargets(ctx EvalContext) tfdiags.Diagnostics {
+	var diags tfdiags.Diagnostics
+
+	// Import blocks are always evaluated in the root module, even when their
+	// target resource is in a child module.
+	ctx = evalContextForModuleInstance(ctx, addrs.RootModuleInstance)
+
+	for _, importTarget := range n.importTargets {
+		if importTarget.Config == nil {
+			continue
+		}
+
+		imp := importTarget.Config
+		target := imp.ToResource.Absolute(addrs.RootModuleInstance).Instance(addrs.NoKey)
+
+		if imp.ForEach == nil {
+			to, moreDiags := evalImportToExpression(imp.To, EvalDataForNoInstanceKey)
+			diags = diags.Append(moreDiags)
+			if moreDiags.HasErrors() {
+				continue
+			}
+			target = to
+			_, moreDiags = evaluateImportIdExpression(imp.ID, target, ctx, EvalDataForNoInstanceKey, true)
+			diags = diags.Append(moreDiags)
+			continue
+		}
+
+		forEachData, known, moreDiags := newForEachEvaluator(imp.ForEach, ctx, true).ImportValues()
+		diags = diags.Append(moreDiags)
+		if moreDiags.HasErrors() {
+			continue
+		}
+
+		if !known {
+			_, moreDiags = evalImportUnknownToExpression(imp.To)
+			diags = diags.Append(moreDiags)
+			_, moreDiags = evaluateImportIdExpression(imp.ID, target, ctx, instances.UnknownForEachRepetitionData(cty.DynamicPseudoType), true)
+			diags = diags.Append(moreDiags)
+			continue
+		}
+
+		for _, keyData := range forEachData {
+			to, moreDiags := evalImportToExpression(imp.To, keyData)
+			diags = diags.Append(moreDiags)
+			if moreDiags.HasErrors() {
+				continue
+			}
+			_, moreDiags = evaluateImportIdExpression(imp.ID, to, ctx, keyData, true)
+			diags = diags.Append(moreDiags)
+		}
+	}
+
+	return diags
+}
