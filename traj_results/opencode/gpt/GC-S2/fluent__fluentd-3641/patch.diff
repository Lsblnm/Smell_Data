diff --git a/lib/fluent/rpc.rb b/lib/fluent/rpc.rb
index d050aecb..07cdd322 100644
--- a/lib/fluent/rpc.rb
+++ b/lib/fluent/rpc.rb
@@ -24,7 +24,7 @@ module Fluent
   module RPC
     class Server
       def initialize(endpoint, log)
-        bind, port = endpoint.split(':')
+        bind, port = parse_endpoint(endpoint)
         @bind = bind
         @port = port
         @log = log
@@ -178,6 +178,28 @@ module Fluent
         false
       end
 
+      private
+
+      def parse_endpoint(endpoint)
+        if (match = /\A\[([^\]]+)\]:(\d+)\z/.match(endpoint))
+          bind, port = match.captures
+          address = IPAddr.new(bind)
+          raise Fluent::ConfigError unless address.ipv6?
+        elsif (match = /\A([a-zA-Z0-9][a-zA-Z0-9.-]*):(\d+)\z/.match(endpoint))
+          bind, port = match.captures
+        else
+          raise Fluent::ConfigError
+        end
+
+        raise Fluent::ConfigError unless (1..65_535).cover?(port.to_i)
+
+        [bind, port]
+      rescue Fluent::ConfigError
+        raise Fluent::ConfigError, "Invalid rpc_endpoint: #{endpoint}"
+      rescue IPAddr::InvalidAddressError
+        raise Fluent::ConfigError, "Invalid rpc_endpoint: #{endpoint}"
+      end
+
       def self.align_supervisor_log_path(opts)
         return opts unless opts
         if Fluent.windows?
