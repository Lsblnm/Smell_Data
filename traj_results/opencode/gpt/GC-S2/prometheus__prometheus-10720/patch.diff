+func (enh *EvalNodeHelper) dayOfYearUTC(t time.Time) float64 {
+	t = t.UTC()
+	day := t.YearDay()
+	if day < 1 {
+		return 1
+	}
+	maxDay := 365
+	if enh.isLeapYear(t.Year()) {
+		maxDay = 366
+	}
+	if day > maxDay {
+		return float64(maxDay)
+	}
+	return float64(day)
+}
