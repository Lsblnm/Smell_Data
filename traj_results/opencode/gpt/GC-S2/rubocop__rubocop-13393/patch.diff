diff --git a/lib/rubocop/cop/style/guard_clause.rb b/lib/rubocop/cop/style/guard_clause.rb
index 4da20315d..a76cfe577 100644
--- a/lib/rubocop/cop/style/guard_clause.rb
+++ b/lib/rubocop/cop/style/guard_clause.rb
@@ -138,7 +138,7 @@ module RuboCop
 
         def on_if(node)
           remember_conditional_context(node)
-          return if accepted_form?(node)
+          return if accepted_form?(node) || condition_assignment_used_in_branch?(node)
 
           if (guard_clause = node.if_branch&.guard_clause?)
             kw = node.loc.keyword.source
@@ -278,6 +278,16 @@ module RuboCop
           accepted_if?(node, ending) || node.condition.multiline? || node.parent&.assignment?
         end
 
+        def condition_assignment_used_in_branch?(node)
+          assigned_names = self.class.condition_engine.send(:assignment_facts, node.condition)
+                                    .filter_map { |fact| fact[:name] if fact[:kind] == :lvasgn }
+          return false if assigned_names.empty?
+
+          node.branches.any? do |branch|
+            branch && assigned_names.any? { |name| branch.each_descendant(:lvar).any? { |lvar| lvar.children.first == name } }
+          end
+        end
+
         def trivial?(node)
           return false unless node.if_branch
 
