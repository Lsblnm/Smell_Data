+    private function isConstantName(Tokens $tokens, int $index): bool
+    {
+        $nextIndex = $tokens->getNextMeaningfulToken($index);
+
+        if (null === $nextIndex || !$tokens[$nextIndex]->equals('=')) {
+            return false;
+        }
+
+        for ($index = $tokens->getPrevMeaningfulToken($index); null !== $index; $index = $tokens->getPrevMeaningfulToken($index)) {
+            if ($tokens[$index]->isGivenKind(T_CONST)) {
+                return true;
+            }
+
+            if ($tokens[$index]->equalsAny([';', '{', '}'])) {
+                return false;
+            }
+        }
+
+        return false;
+    }
