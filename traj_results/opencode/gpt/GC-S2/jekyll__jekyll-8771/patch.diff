     #
     # Returns nothing.
     def read_data
-      @site.data = DataReader.new(site).read(site.config["data_dir"])
-      return unless site.theme&.data_path
+      data_reader = DataReader.new(site)
+      @site.data = data_reader.read(site.config["data_dir"])
+      data_modified = data_reader.data_modified
+      unless site.theme&.data_path
+        force_regeneration_for_data_changes if data_modified
