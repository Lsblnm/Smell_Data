-      theme_data = DataReader.new(
+      theme_data_reader = DataReader.new(
         site,
         :in_source_dir => site.method(:in_theme_dir)
-      ).read(site.theme.data_path)
+      )
+      theme_data = theme_data_reader.read(site.theme.data_path)
       @site.data = Jekyll::Utils.deep_merge_hashes(theme_data, @site.data)
+      force_regeneration_for_data_changes if data_modified || theme_data_reader.data_modified
     end
 
     # Sorts posts, pages, and static files.
@@ -158,6 +165,20 @@ module Jekyll
 
     private
 
+    def force_regeneration_for_data_changes
+      site.pages.each do |page|
+        force_regeneration(site.in_source_dir(page.relative_path))
+      end
+      site.collections.each_value do |collection|
+        collection.docs.each { |document| force_regeneration(document.path) }
+      end
+    end
+
+    def force_regeneration(path)
+      site.regenerator.add(path) unless site.regenerator.metadata.key?(path)
+      site.regenerator.force(path)
+    end
+
     # Internal
     #
     # Determine if the directory is supposed to contain posts and drafts.
