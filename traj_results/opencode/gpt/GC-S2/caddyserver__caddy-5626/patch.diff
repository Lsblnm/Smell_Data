+func TestNestedSnippetImportInHandler(t *testing.T) {
+	blocks, err := Parse("Testfile", []byte(`
+(responderWithStatus) {
+	respond {args[0]} {args[1]}
+}
+
+(responder) {
+	import responderWithStatus {args[0]} 202
+}
+
+localhost {
+	handle {
+		import responder "foobar"
+	}
+}
+`))
+	if err != nil {
+		t.Fatalf("parsing nested snippet import: %v", err)
+	}
+	if len(blocks) != 1 || len(blocks[0].Segments) != 1 {
+		t.Fatalf("expected one handler segment, got %#v", blocks)
+	}
+
+	segment := blocks[0].Segments[0]
+	got := make([]string, len(segment))
+	for i, token := range segment {
+		got[i] = token.Text
+	}
+	want := []string{"handle", "{", "respond", "foobar", "202", "}"}
+	if len(got) != len(want) {
+		t.Errorf("expected tokens %q, got %q", want, got)
+		return
+	}
+	for i := range want {
+		if got[i] != want[i] {
+			t.Errorf("expected tokens %q, got %q", want, got)
+			break
+		}
+	}
+}
