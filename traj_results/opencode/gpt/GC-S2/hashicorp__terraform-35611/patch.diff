diff --git a/internal/terraform/node_resource_abstract.go b/internal/terraform/node_resource_abstract.go
index b5f940d877..ec9fc75d4e 100644
--- a/internal/terraform/node_resource_abstract.go
+++ b/internal/terraform/node_resource_abstract.go
@@ -323,15 +323,20 @@ func (n *NodeAbstractResource) Provider() addrs.Provider {
 
 // GraphNodeProvisionerConsumer
 func (n *NodeAbstractResource) ProvisionedBy() []string {
-	// If we have no configuration, then we have no provisioners
-	if n.Config == nil || n.Config.Managed == nil {
+	var provisioners []*configs.Provisioner
+	switch {
+	case n.Config != nil && n.Config.Managed != nil:
+		provisioners = n.Config.Managed.Provisioners
+	case n.RemovedConfig != nil && n.RemovedConfig.Managed != nil:
+		provisioners = n.RemovedConfig.Managed.Provisioners
+	default:
 		return nil
 	}
 
 	// Build the list of provisioners we need based on the configuration.
 	// It is okay to have duplicates here.
-	result := make([]string, len(n.Config.Managed.Provisioners))
-	for i, p := range n.Config.Managed.Provisioners {
+	result := make([]string, len(provisioners))
+	for i, p := range provisioners {
 		result[i] = p.Type
 	}
 
