diff --git a/src/bin/bat/app.rs b/src/bin/bat/app.rs
index 21a61c47..6b5ba772 100644
--- a/src/bin/bat/app.rs
+++ b/src/bin/bat/app.rs
@@ -40,8 +40,15 @@ impl App {
             // Put the zero-th CLI argument (program name) first
             args.insert(0, cli_args.next().unwrap());
 
-            // .. and the rest at the end
-            cli_args.for_each(|a| args.push(a));
+            // .. and the rest at the end. Expand CLI paging aliases so they
+            // participate in the same last-option-wins behavior as --paging.
+            for arg in cli_args {
+                let no_paging_alias = arg == "-P" || arg == "-pp";
+                args.push(arg);
+                if no_paging_alias {
+                    args.push("--paging=never".into());
+                }
+            }
 
             args
         };
