diff --git a/include/fmt/std.h b/include/fmt/std.h
index 63250bfe..eaad03d3 100644
--- a/include/fmt/std.h
+++ b/include/fmt/std.h
@@ -105,6 +105,7 @@ template <typename Char> struct formatter<std::filesystem::path, Char> {
   format_specs<Char> specs_;
   detail::arg_ref<Char> width_ref_;
   bool debug_ = false;
+  bool generic_ = false;
 
  public:
   FMT_CONSTEXPR void set_debug_format(bool set = true) { debug_ = set; }
@@ -121,6 +122,10 @@ template <typename Char> struct formatter<std::filesystem::path, Char> {
       debug_ = true;
       ++it;
     }
+    if (it != end && (*it == 'n' || *it == 'g')) {
+      generic_ = *it == 'g';
+      ++it;
+    }
     return it;
   }
 
@@ -130,11 +135,16 @@ template <typename Char> struct formatter<std::filesystem::path, Char> {
     detail::handle_dynamic_spec<detail::width_checker>(specs.width, width_ref_,
                                                        ctx);
     if (!debug_) {
-      auto s = detail::get_path_string<Char>(p, p.native());
+      auto s = generic_
+                   ? detail::get_path_string<Char>(p, p.generic_string<Char>())
+                   : detail::get_path_string<Char>(p, p.native());
       return detail::write(ctx.out(), basic_string_view<Char>(s), specs);
     }
     auto quoted = basic_memory_buffer<Char>();
-    detail::write_escaped_path(quoted, p, p.native());
+    if (generic_)
+      detail::write_escaped_path(quoted, p, p.generic_string<Char>());
+    else
+      detail::write_escaped_path(quoted, p, p.native());
     return detail::write(ctx.out(),
                          basic_string_view<Char>(quoted.data(), quoted.size()),
                          specs);
