diff --git a/py/runtime.c b/py/runtime.c
index a6a1ffcbe..692568505 100644
--- a/py/runtime.c
+++ b/py/runtime.c
@@ -702,6 +702,15 @@ mp_obj_t mp_call_method_n_kw(size_t n_args, size_t n_kw, const mp_obj_t *args) {
     return mp_call_function_n_kw(args[0], n_args + adjust, n_kw, args + 2 - adjust);
 }
 
+STATIC void mp_call_check_duplicate_kwarg(size_t pos_args_len, size_t args2_len, const mp_obj_t *args2, mp_obj_t key) {
+    for (size_t i = pos_args_len; i < args2_len; i += 2) {
+        if (args2[i] == key) {
+            mp_raise_msg_varg(&mp_type_TypeError,
+                MP_ERROR_TEXT("function got multiple values for keyword argument '%q'"), MP_OBJ_QSTR_VALUE(key));
+        }
+    }
+}
+
 // This function only needs to be exposed externally when in stackless mode.
 #if !MICROPY_STACKLESS
 STATIC
@@ -852,6 +861,7 @@ void mp_call_prepare_args_n_kw_var(bool have_self, size_t n_args_n_kw, const mp_
                         if (!mp_obj_is_qstr(key)) {
                             key = mp_obj_str_intern_checked(key);
                         }
+                        mp_call_check_duplicate_kwarg(pos_args_len, args2_len, args2, key);
                         args2[args2_len++] = key;
                         args2[args2_len++] = map->table[j].value;
                     }
@@ -879,6 +889,7 @@ void mp_call_prepare_args_n_kw_var(bool have_self, size_t n_args_n_kw, const mp_
                     if (!mp_obj_is_qstr(key)) {
                         key = mp_obj_str_intern_checked(key);
                     }
