+#[cfg(unix)]
+fn parse_ignored_signals(matches: &clap::ArgMatches) -> UResult<Vec<Signal>> {
+    let mut signals = Vec::new();
+
+    for value in matches
+        .get_many::<String>("ignore-signal")
+        .into_iter()
+        .flatten()
+    {
+        for signal_name in value.split(',').filter(|name| !name.is_empty()) {
+            let normalized_name = signal_name.to_ascii_uppercase();
+            let signal_number = signal_by_name_or_value(&normalized_name).ok_or_else(|| {
+                UUsageError::new(125, format!("{}: invalid signal", signal_name.quote()))
+            })?;
+            let signal = Signal::try_from(signal_number as i32).map_err(|_| {
+                UUsageError::new(125, format!("{}: invalid signal", signal_name.quote()))
+            })?;
+            signals.push(signal);
+        }
+    }
+
+    Ok(signals)
+}
+
+#[cfg(unix)]
+fn apply_ignored_signals(opts: &Options<'_>) -> UResult<()> {
+    for &signal in &opts.ignore_signals {
+        // SAFETY: SIG_IGN is a predefined signal disposition, not a custom handler.
+        unsafe {
+            sigaction(
+                signal,
+                &SigAction::new(SigHandler::SigIgn, SaFlags::empty(), SigSet::empty()),
+            )
+        }
+        .map_err(|error| {
+            USimpleError::new(
+                125,
+                format!(
+                    "failed to set signal action for signal {}: {}",
+                    signal as i32,
+                    error.desc(),
+                ),
+            )
+        })?;
+    }
+
+    Ok(())
+}
