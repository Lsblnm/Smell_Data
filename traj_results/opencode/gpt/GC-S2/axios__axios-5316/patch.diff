diff --git a/lib/helpers/formDataToStream.js b/lib/helpers/formDataToStream.js
new file mode 100644
index 0000000..22d0c58
--- /dev/null
+++ b/lib/helpers/formDataToStream.js
@@ -0,0 +1,64 @@
+'use strict';
+
+import utils from '../utils.js';
+import stream from 'stream';
+
+const CRLF = '\r\n';
+const CRLF_BYTES = Buffer.from(CRLF);
+
+class FormDataPart {
+  constructor(name, value) {
+    const isStringValue = utils.isString(value);
+    let headers = `Content-Disposition: form-data; name="${String(name).replace(/\r|\n|"/g, encodeURIComponent)}"`;
+
+    if (!isStringValue && value.name) {
+      headers += `; filename="${String(value.name).replace(/\r|\n|"/g, encodeURIComponent)}"`;
+    }
+
+    headers += CRLF;
+
+    if (!isStringValue) {
+      headers += `Content-Type: ${value.type || 'application/octet-stream'}${CRLF}`;
+    }
+
+    this.headers = Buffer.from(headers + CRLF);
+    this.value = value;
+    this.size = this.headers.byteLength + (isStringValue ? Buffer.byteLength(value) : value.size) + CRLF_BYTES.byteLength;
+  }
+
+  async encode() {
+    const value = utils.isString(this.value) ? this.value : Buffer.from(await this.value.arrayBuffer());
+
+    return [this.headers, value, CRLF_BYTES];
+  }
+}
+
+export default function formDataToStream(form, headersHandler, options) {
+  const opts = options || {};
+  const tag = opts.tag || 'form-data-boundary';
+  const boundary = opts.boundary || `${tag}-${Math.random().toString(16).slice(2)}`;
+  const boundaryBytes = Buffer.from(`--${boundary}${CRLF}`);
+  const footerBytes = Buffer.from(`--${boundary}--${CRLF}${CRLF}`);
+  const parts = Array.from(form.entries(), ([name, value]) => new FormDataPart(name, value));
+  const contentLength = parts.reduce((length, part) => length + boundaryBytes.byteLength + part.size, footerBytes.byteLength);
+
+  headersHandler({
+    'Content-Type': `multipart/form-data; boundary=${boundary}`,
+    'Content-Length': contentLength
+  });
+
+  const formDataStream = new stream.Readable({
+    read() {}
+  });
+
+  Promise.all(parts.map(part => part.encode())).then(encodedParts => {
+    encodedParts.forEach(part => {
+      formDataStream.push(boundaryBytes);
+      part.forEach(chunk => formDataStream.push(chunk));
+    });
+    formDataStream.push(footerBytes);
+    formDataStream.push(null);
+  }, reason => formDataStream.destroy(reason));
+
+  return formDataStream;
+}
