diff --git a/lib/rubocop/cop/style/redundant_parentheses.rb b/lib/rubocop/cop/style/redundant_parentheses.rb
index 7ad1feb8f..d730cbc81 100644
--- a/lib/rubocop/cop/style/redundant_parentheses.rb
+++ b/lib/rubocop/cop/style/redundant_parentheses.rb
@@ -72,7 +72,23 @@ module RuboCop
 
         def allowed_method_call?(node)
           # Don't flag `method (arg) { }`
-          arg_in_call_with_block?(node) && !parentheses?(node.parent)
+          (arg_in_call_with_block?(node) || keyword_argument_with_do_end_block?(node)) &&
+            !parentheses?(node.parent)
+        end
+
+        def keyword_argument_with_do_end_block?(node)
+          return false unless node.each_ancestor(:pair).any?
+
+          call = node.children.first
+          while call.call_type? && (receiver = call.receiver)
+            if (receiver.block_type? || receiver.numblock_type?) && !receiver.braces?
+              return true
+            end
+
+            call = receiver
+          end
+
+          false
         end
 
         def allowed_multiple_expression?(node)
