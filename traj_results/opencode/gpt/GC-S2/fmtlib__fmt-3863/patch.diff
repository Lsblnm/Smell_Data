   FMT_CONSTEXPR range_formatter() {}
@@ -415,6 +417,17 @@ struct range_formatter<
     auto it = ctx.begin();
     auto end = ctx.end();
 
+    if (std::is_same<T, Char>::value && it != end && *it == 's') {
+      string_format_ = true;
+      return ++it;
+    }
+    if (std::is_same<T, Char>::value && it != end && *it == '?' &&
