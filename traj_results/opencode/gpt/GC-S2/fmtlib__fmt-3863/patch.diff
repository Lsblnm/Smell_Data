@@ -452,6 +467,27 @@ struct range_formatter<
 
 
  private:
+  template <typename R, typename FormatContext>
+  auto format_string(R&& range, FormatContext& ctx, std::true_type) const
+      -> decltype(ctx.out()) {
+    basic_memory_buffer<Char> buffer;
+    auto it = detail::range_begin(range);
+    auto end = detail::range_end(range);
+    for (; it != end; ++it) buffer.push_back(*it);
+    if (debug_string_format_)
+      return detail::write_escaped_string(
+          ctx.out(), basic_string_view<Char>(buffer.data(), buffer.size()));
+    return detail::copy<Char>(buffer.data(), buffer.data() + buffer.size(),
+                              ctx.out());
+  }
+
+  template <typename R, typename FormatContext>
+  auto format_string(R&&, FormatContext& ctx, std::false_type) const
+      -> decltype(ctx.out()) {
+    report_error("invalid format specifier");
+    return ctx.out();
+  }
+
   mutable int spec_width_cache_ = 0;
   mutable int spec_precision_cache_ = -1;
   mutable int spec_align_code_ = 0;
