+    private function findControlStructureEndIndex(Tokens $tokens, int $index): int
+    {
+        if ($tokens[$index]->isGivenKind(T_DO)) {
+            $bodyEndIndex = $this->findUnbracedStatementEndIndex($tokens, $tokens->getNextMeaningfulToken($index));
+            $whileIndex = $tokens->getNextMeaningfulToken($bodyEndIndex);
+            $parenthesisIndex = $tokens->getNextMeaningfulToken($whileIndex);
+
+            return $tokens->getNextMeaningfulToken(
+                $tokens->findBlockEnd(Tokens::BLOCK_TYPE_PARENTHESIS_BRACE, $parenthesisIndex)
+            );
+        }
+
+        if ($tokens[$index]->isGivenKind(T_ELSE)) {
+            return $this->findUnbracedStatementEndIndex($tokens, $tokens->getNextMeaningfulToken($index));
+        }
+
+        $parenthesisIndex = $tokens->getNextMeaningfulToken($index);
+        $bodyStartIndex = $tokens->getNextMeaningfulToken(
+            $tokens->findBlockEnd(Tokens::BLOCK_TYPE_PARENTHESIS_BRACE, $parenthesisIndex)
+        );
+
+        return $this->findUnbracedStatementEndIndex($tokens, $bodyStartIndex);
+    }
+
+    private function findUnbracedStatementEndIndex(Tokens $tokens, int $index): int
+    {
+        if ($tokens[$index]->equals('{')) {
+            return $tokens->findBlockEnd(Tokens::BLOCK_TYPE_CURLY_BRACE, $index) + 1;
+        }
+
+        if ($tokens[$index]->isGivenKind([T_IF, T_ELSEIF, T_FOR, T_FOREACH, T_WHILE, T_DO, T_ELSE])) {
+            $endIndex = $this->findControlStructureEndIndex($tokens, $index);
+        } else {
+            $endIndex = $this->findStatementEndIndex($tokens, $index, \count($tokens) - 1) + 1;
+        }
+
+        if ($tokens[$index]->isGivenKind([T_IF, T_ELSEIF, T_ELSE])) {
+            $nextIndex = $tokens->getNextMeaningfulToken($endIndex);
+            if (null !== $nextIndex && $tokens[$nextIndex]->isGivenKind([T_ELSE, T_ELSEIF])) {
+                return $this->findUnbracedStatementEndIndex($tokens, $nextIndex);
+            }
+        }
+
+        return $endIndex;
+    }
