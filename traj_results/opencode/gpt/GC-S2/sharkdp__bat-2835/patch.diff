+    fn print_header_filename(
+        &mut self,
+        handle: &mut OutputHandle,
+        kind: Option<&str>,
+        title: &str,
+        mode: &str,
+    ) -> Result<()> {
+        let prefix_width = self.panel_width
+            + if self.panel_width > 0 && self.config.style_components.grid() {
+                2
+            } else {
+                0
+            };
+        let max_width = self.config.term_width.saturating_sub(prefix_width).max(1);
+        let kind = kind.map(|kind| format!("{}: ", kind)).unwrap_or_default();
+        let parts = [(kind, false), (title.to_string(), true), (mode.to_string(), false)];
+        let mut line_width = 0;
+
+        for (part, highlighted) in &parts {
+            let mut fragment = String::new();
+            for character in part.chars() {
+                let character_width = Self::displayed_char_width(character);
+                if line_width > 0 && line_width + character_width > max_width {
+                    if *highlighted {
+                        write!(handle, "{}", self.colors.header_value.paint(&fragment))?;
+                    } else {
+                        write!(handle, "{}", fragment)?;
+                    }
+                    fragment = String::new();
+                    writeln!(handle)?;
+                    self.print_header_component_indent(handle)?;
+                    line_width = 0;
+                }
+
+                fragment.push(character);
+                line_width += character_width;
+            }
+            if *highlighted {
+                write!(handle, "{}", self.colors.header_value.paint(fragment))?;
+            } else {
+                write!(handle, "{}", fragment)?;
+            }
+        }
+        writeln!(handle)?;
+
+        Ok(())
+    }
