@@ -187,10 +187,50 @@ module RuboCop
           return unless method_call_with_redundant_parentheses?(node)
           return if call_chain_starts_with_int?(begin_node, node)
           return if require_parentheses?(begin_node.parent || begin_node, node)
+          return if do_end_block_in_argument?(begin_node, node)
 
           offense(begin_node, 'a method call')
         end
 
+        def do_end_block_in_argument?(begin_node, node)
+          return false unless argument?(begin_node)
+
+          method_chain_includes_do_end_block?(node)
+        end
+
+        def method_chain_includes_do_end_block?(node)
+          while node
+            if node.any_block_type?
+              return true if node.keywords? && !node.send_node.lambda_literal?
+
+              node = node.send_node
+            elsif node.call_type?
+              node = node.receiver
+            else
+              return false
+            end
+          end
+
+          false
+        end
+
+        def argument?(node)
+          parent = node.parent
+          return false unless parent
+          return argument?(parent) if parent.splat_type? || parent.kwsplat_type?
+          return keyword_argument?(parent) if parent.pair_type?
+
+          parent.call_type? && parent.arguments.include?(node)
+        end
+
+        def keyword_argument?(pair)
+          hash = pair.parent
+          return false unless hash&.hash_type? && hash.loc.begin.nil?
+
+          call = hash.parent
+          call&.call_type? && call.arguments.include?(hash)
+        end
+
         def require_parentheses?(node, condition_body)
           config = @config
           return false unless config
