diff --git a/src/Tokenizer/Analyzer/CommentsAnalyzer.php b/src/Tokenizer/Analyzer/CommentsAnalyzer.php
index a7e5382f1..c2822c60b 100644
--- a/src/Tokenizer/Analyzer/CommentsAnalyzer.php
