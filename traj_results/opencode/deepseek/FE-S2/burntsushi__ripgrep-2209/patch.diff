diff --git a/crates/printer/src/standard.rs b/crates/printer/src/standard.rs
index ea5d1fc..a3b9cef 100644
--- a/crates/printer/src/standard.rs
+++ b/crates/printer/src/standard.rs
@@ -636,26 +636,38 @@ impl<W: WriteColor> Standard<W> {
             dst.clear();
             matches.clear();
 
+            // We roll our own replacement loop here instead of using
+            // 'replace_with_captures_at' because the subject may have been
+            // extended to allow look-around to work in multi-line mode. The
+            // standard replacement routine would copy all of those extra
+            // bytes to the end of the output. Instead, we only copy bytes up
+            // to the end of the match range, while still permitting matches
+            // to start before that point.
+            let mut last_match = range.start;
             matcher
-                .replace_with_captures_at(
-                    subject,
-                    range.start,
-                    caps,
-                    dst,
-                    |caps, dst| {
-                        let start = dst.len();
-                        caps.interpolate(
-                            |name| matcher.capture_index(name),
-                            subject,
-                            replacement,
-                            dst,
-                        );
-                        let end = dst.len();
-                        matches.push(Match::new(start, end));
-                        true
-                    },
-                )
+                .captures_iter_at(subject, range.start, caps, |caps| {
+                    let m = caps.get(0).unwrap();
+                    if m.start() >= range.end {
+                        return false;
+                    }
+                    dst.extend(&subject[last_match..m.start()]);
+                    last_match = m.end();
+                    let start = dst.len();
+                    caps.interpolate(
+                        |name| matcher.capture_index(name),
+                        subject,
+                        replacement,
+                        dst,
+                    );
+                    let end = dst.len();
+                    matches.push(Match::new(start, end));
+                    true
+                })
                 .map_err(io::Error::error_message)?;
+            let tail_end = cmp::min(range.end, subject.len());
+            if last_match < tail_end {
+                dst.extend(&subject[last_match..tail_end]);
+            }
         }
         Ok(())
     }
