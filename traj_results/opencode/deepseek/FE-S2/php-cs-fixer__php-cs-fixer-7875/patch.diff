+    private function findClassMemberDeclarationEndIndex(Tokens $tokens, int $index): ?int
+    {
+        $hasMember = false;
+
+        for ($searchIndex = $index, $max = \count($tokens); $searchIndex < $max; ++$searchIndex) {
+            $searchToken = $tokens[$searchIndex];
+
+            if ($searchToken->isGivenKind([T_FUNCTION, T_FN])) {
+                return null;
+            }
+
+            if ($searchToken->equals('(')) {
+                $searchIndex = $tokens->findBlockEnd(Tokens::BLOCK_TYPE_PARENTHESIS_BRACE, $searchIndex);
+
+                continue;
+            }
+
+            if ($searchToken->isGivenKind(CT::T_ARRAY_SQUARE_BRACE_OPEN)) {
+                $searchIndex = $tokens->findBlockEnd(Tokens::BLOCK_TYPE_ARRAY_SQUARE_BRACE, $searchIndex);
+
+                continue;
+            }
+
+            if ($searchToken->equals('[')) {
+                $searchIndex = $tokens->findBlockEnd(Tokens::BLOCK_TYPE_INDEX_SQUARE_BRACE, $searchIndex);
+
+                continue;
+            }
+
+            if ($searchToken->equalsAny(['{', '}'])) {
+                return null;
+            }
+
+            if ($searchToken->isGivenKind([T_CONST, T_VARIABLE])) {
+                $hasMember = true;
+
+                continue;
+            }
+
+            if ($searchToken->equals(';')) {
+                return $hasMember ? $searchIndex : null;
+            }
+        }
+
+        return null;
+    }
