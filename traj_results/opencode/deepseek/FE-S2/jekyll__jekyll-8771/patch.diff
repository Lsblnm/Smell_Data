diff --git a/lib/jekyll/data_entry.rb b/lib/jekyll/data_entry.rb
new file mode 100644
index 000000000..d8c847395
--- /dev/null
+++ b/lib/jekyll/data_entry.rb
@@ -0,0 +1,143 @@
+# frozen_string_literal: true
+
+module Jekyll
+  class DataEntry
+    include Comparable
+
+    attr_reader :site, :path, :data
+
+    def initialize(site, path, data)
+      @site = site
+      @path = path
+      @data = data
+      @paths = [path]
+    end
+
+    def to_liquid
+      @data
+    end
+
+    def [](key)
+      @data[key]
+    end
+
+    def []=(key, value)
+      @data[key] = value
+    end
+
+    def dig(*keys)
+      keys.reduce(@data) { |object, key| object[key] }
+    end
+
+    def each(&block)
+      return enum_for(:each) unless block
+
+      @data.each(&block) if @data.respond_to?(:each)
+    end
+    alias_method :each_pair, :each
+
+    def each_data_entry
+      return enum_for(:each_data_entry) unless block_given?
+
+      yield self
+    end
+
+    def depend_on(document)
+      return unless document
+      return if document.respond_to?(:write?) && !document.write?
+
+      source_path =
+        if document.is_a?(Page)
+          @site.in_source_dir(document.relative_path)
+        else
+          document.path
+        end
+
+      dependency_paths = @paths + @paths.map { |dependency_path| File.dirname(dependency_path) }
+      dependency_paths.uniq.each do |dependency_path|
+        @site.regenerator.add_dependency(source_path, dependency_path)
+      end
+    end
+
+    def <=>(other)
+      @data <=> unwrap(other)
+    end
+
+    def ==(other)
+      @data == unwrap(other)
+    end
+    alias_method :eql?, :==
+
+    def hash
+      @data.hash
+    end
+
+    def merge(other, &block)
+      dup.merge!(other, &block)
+    end
+
+    def merge!(other)
+      other_paths = other.is_a?(DataEntry) ? other.paths : []
+      @paths |= other_paths
+
+      other_data = unwrap(other)
+      unless @data.is_a?(Hash) && other_data.is_a?(Hash)
+        @data = other_data
+        return self
+      end
+
+      @data.merge!(other_data) do |key, old_value, new_value|
+        if block_given?
+          yield(key, old_value, new_value)
+        else
+          new_value
+        end
+      end
+      self
+    end
+
+    def dup
+      self.class.new(@site, @path, @data.dup).tap do |entry|
+        entry.paths = @paths.dup
+      end
+    end
+
+    def inspect
+      @data.inspect
+    end
+
+    def to_s
+      @data.to_s
+    end
+
+    def to_h
+      @data.to_h
+    end
+
+    def to_hash
+      @data.to_hash
+    end
+
+    def method_missing(method, *args, &block)
+      if @data.respond_to?(method)
+        @data.public_send(method, *args, &block)
+      else
+        super
+      end
+    end
+
+    def respond_to_missing?(method, include_private = false)
+      @data.respond_to?(method, include_private) || super
+    end
+
+    protected
+
+    attr_accessor :paths
+
+    private
+
+    def unwrap(value)
+      value.is_a?(DataEntry) ? value.data : value
+    end
+  end
+end
diff --git a/lib/jekyll/data_hash.rb b/lib/jekyll/data_hash.rb
new file mode 100644
index 000000000..1804eae16
--- /dev/null
+++ b/lib/jekyll/data_hash.rb
@@ -0,0 +1,157 @@
+# frozen_string_literal: true
+
+module Jekyll
+  class DataHash
+    include Enumerable
+
+    def initialize
+      @data = {}
+    end
+
+    def [](key)
+      @data[key]
+    end
+
+    def []=(key, value)
+      raise FrozenError, "can't modify frozen #{self.class}" if frozen?
+
+      @data[key] = value
+    end
+
+    def key?(key)
+      @data.key?(key)
+    end
+    alias_method :has_key?, :key?
+    alias_method :include?, :key?
+    alias_method :member?, :key?
+
+    def fetch(*args, &block)
+      @data.fetch(*args, &block)
+    end
+
+    def dig(*keys)
+      keys.reduce(self) { |object, key| object[key] }
+    end
+
+    def each(&block)
+      @data.each(&block)
+    end
+    alias_method :each_pair, :each
+
+    def each_key(&block)
+      @data.each_key(&block)
+    end
+
+    def each_value(&block)
+      @data.each_value(&block)
+    end
+
+    def each_data_entry(&block)
+      return enum_for(:each_data_entry) unless block
+
+      each_value do |value|
+        value.each_data_entry(&block) if value.is_a?(DataEntry) || value.is_a?(DataHash)
+      end
+    end
+
+    def keys
+      @data.keys
+    end
+
+    def values
+      @data.values
+    end
+
+    def size
+      @data.size
+    end
+    alias_method :length, :size
+
+    def empty?
+      @data.empty?
+    end
+
+    def delete(key)
+      @data.delete(key)
+    end
+
+    def clear
+      @data.clear
+    end
+
+    def merge(other, &block)
+      dup.merge!(other, &block)
+    end
+
+    def merge!(other)
+      other.each_pair do |key, value|
+        self[key] = if block_given? && key?(key)
+                      yield(key, self[key], value)
+                    else
+                      value
+                    end
+      end
+      self
+    end
+
+    def to_h
+      @data.dup
+    end
+
+    def to_hash
+      @data.dup
+    end
+
+    def to_liquid
+      @data.transform_values do |value|
+        value.respond_to?(:to_liquid) ? value.to_liquid : value
+      end
+    end
+
+    def inspect
+      @data.inspect
+    end
+
+    def to_s
+      @data.to_s
+    end
+
+    def ==(other)
+      @data == unwrap(other)
+    end
+    alias_method :eql?, :==
+
+    def hash
+      @data.hash
+    end
+
+    def dup
+      self.class.new.tap do |copy|
+        copy.instance_variable_set(:@data, @data.dup)
+      end
+    end
+
+    def freeze
+      @data.freeze
+      super
+    end
+
+    def method_missing(method, *args, &block)
+      if @data.respond_to?(method)
+        @data.public_send(method, *args, &block)
+      else
+        super
+      end
+    end
+
+    def respond_to_missing?(method, include_private = false)
+      @data.respond_to?(method, include_private) || super
+    end
+
+    private
+
+    def unwrap(value)
+      value.is_a?(DataHash) ? value.to_h : value
+    end
+  end
+end
