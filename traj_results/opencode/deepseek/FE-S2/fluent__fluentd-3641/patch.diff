+      private
+
+      def parse_endpoint(endpoint)
+        case endpoint
+        when /\A\[([^\]]+)\]:([0-9]+)\z/
+          bind = $1
+          port = $2
+        when /\A([^:]+):([0-9]+)\z/
+          bind = $1
+          port = $2
+        else
+          raise Fluent::ConfigError, "Invalid rpc_endpoint: #{endpoint}"
+        end
+
+        unless valid_bind_address?(bind) && (1..65535).cover?(port.to_i)
+          raise Fluent::ConfigError, "Invalid rpc_endpoint: #{endpoint}"
+        end
+
+        [bind, port.to_i]
+      end
+
+      def valid_bind_address?(bind)
+        return false if bind.empty?
+
+        begin
+          IPAddr.new(bind)
+          true
+        rescue IPAddr::Error, ArgumentError
+          HOSTNAME_PATTERN.match?(bind)
+        end
+      end
