+#[cfg(unix)]
+fn parse_ignore_signals(matches: &clap::ArgMatches) -> UResult<Vec<Signal>> {
+    let values: Vec<&OsStr> = match matches.get_many::<OsString>("ignore-signal") {
+        Some(values) => {
+            let values: Vec<&OsStr> = values.map(|value| value.as_os_str()).collect();
+            if values.is_empty() {
+                return Ok((1..uucore::signals::ALL_SIGNALS.len())
+                    .filter_map(|value| Signal::try_from(value as i32).ok())
+                    .filter(|signal| {
+                        !matches!(signal, Signal::SIGCHLD | Signal::SIGKILL | Signal::SIGSTOP)
+                    })
+                    .collect());
+            }
+            values
+        }
+        None => return Ok(Vec::new()),
+    };
+
+    let mut signals = Vec::new();
+    for value in values {
+        let value = value.to_string_lossy();
+        if value.is_empty() {
+            continue;
+        }
+        for name in value.split(',') {
+            let upper = name.to_uppercase();
+            let signal = signal_by_name_or_value(&upper)
+                .filter(|&value| value != 0)
+                .and_then(|value| Signal::try_from(value as i32).ok())
+                .ok_or_else(|| {
+                    USimpleError::new(125, format!("{}: invalid signal", name.quote()))
+                })?;
+            signals.push(signal);
+        }
+    }
+    Ok(signals)
+}
+
+#[cfg(unix)]
+fn apply_ignore_signals(opts: &Options<'_>) -> UResult<()> {
+    for &signal in &opts.ignore_signals {
+        let action = SigAction::new(SigHandler::SigIgn, SaFlags::empty(), SigSet::empty());
+        if let Err(error) = unsafe { sigaction(signal, &action) } {
+            return Err(USimpleError::new(
+                125,
+                format!(
+                    "failed to set signal action for signal {}: {}",
+                    signal as i32,
+                    error.desc()
+                ),
+            ));
+        }
+    }
+    Ok(())
+}
