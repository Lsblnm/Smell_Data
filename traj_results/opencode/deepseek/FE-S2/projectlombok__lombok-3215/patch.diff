+
+	private static void addUsedTypeName(JCTree type, java.util.Set<String> usedNames) {
+		while (type instanceof JCTypeApply) type = ((JCTypeApply) type).clazz;
+		while (type instanceof JCFieldAccess) type = ((JCFieldAccess) type).selected;
+		if (type instanceof JCIdent) {
+			Name name = ((JCIdent) type).getName();
+			if (name != null) usedNames.add(name.toString());
+		}
+	}
