+    private function extractWorksheetFromCellRange(string $coordinate): string
+    {
+        if (strpos($coordinate, '!') === false) {
+            return $coordinate;
+        }
+
+        [$worksheetName, $coordinate] = self::extractSheetTitle($coordinate, true);
+        $worksheetName = str_replace("''", "'", trim((string) $worksheetName, "'"));
