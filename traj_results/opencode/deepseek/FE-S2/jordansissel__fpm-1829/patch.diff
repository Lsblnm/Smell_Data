diff --git a/lib/fpm/package/deb.rb b/lib/fpm/package/deb.rb
index e8f7889..0b52933 100644
--- a/lib/fpm/package/deb.rb
+++ b/lib/fpm/package/deb.rb
@@ -827,7 +827,26 @@ class FPM::Package::Deb < FPM::Package
       logger.warn("Replacing 'provides' entry #{provides} with syntax 'name (= version)'")
       provides = "#{m[1]} (= #{m[2]})"
     end
-    return provides.rstrip
+
+    provides = provides.rstrip
+
+    name_re = /[a-z0-9][a-z0-9+.-]*/
+    version_re = /\A(?:
+      [0-9]+:[0-9][A-Za-z0-9.+~:]*(?:-[A-Za-z0-9+.~]+)*
+      |
+      [0-9][A-Za-z0-9.+~]*(?:-[A-Za-z0-9+.~]+)*
+    )\z/x
+    if provides =~ /\A#{name_re}\z/
+      return provides
+    elsif m = provides.match(/\A(#{name_re})\s+\(=\s+([^)]*)\)\z/)
+      if m[2] =~ version_re
+        return provides
+      end
+    end
+
+    raise FPM::InvalidPackageConfiguration,
+      "Invalid provides syntax '#{provides}'. Debian provides must be a package " \
+      "name optionally followed by an exact version, like 'name (= version)'."
   end
 
   def control_path(path=nil)
