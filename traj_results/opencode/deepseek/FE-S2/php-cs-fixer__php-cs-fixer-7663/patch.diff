+    private function areOnSameLine(Tokens $tokens, int $firstIndex, int $secondIndex): bool
+    {
+        for ($index = $firstIndex + 1; $index < $secondIndex; ++$index) {
+            if (Preg::match('/\R/', $tokens[$index]->getContent())) {
+                return false;
+            }
+        }
+
+        return true;
+    }
+
+    private function findControlSignatureEnd(Tokens $tokens, int $index): int
+    {
+        $nextIndex = $tokens->getNextMeaningfulToken($index);
+
+        if (null !== $nextIndex && $tokens[$nextIndex]->equals('(')) {
+            return $tokens->findBlockEnd(Tokens::BLOCK_TYPE_PARENTHESIS_BRACE, $nextIndex);
+        }
+
+        return $index;
+    }
+
+    private function findStatementEnd(Tokens $tokens, int $index): int
+    {
+        $token = $tokens[$index];
+
+        if ($token->equals('{')) {
+            return $tokens->findBlockEnd(Tokens::BLOCK_TYPE_CURLY_BRACE, $index);
+        }
+
+        if ($token->isGivenKind(T_IF)) {
+            return $this->findIfStatementEnd($tokens, $index);
+        }
+
+        if ($token->isGivenKind(T_DO)) {
+            $bodyStartIndex = $tokens->getNextMeaningfulToken($index);
+            if (null === $bodyStartIndex) {
+                return $index;
+            }
+
+            $bodyEndIndex = $this->findStatementEnd($tokens, $bodyStartIndex);
+            $whileIndex = $tokens->getNextMeaningfulToken($bodyEndIndex);
+
+            if (null !== $whileIndex && $tokens[$whileIndex]->isGivenKind(T_WHILE)) {
+                $signatureEndIndex = $this->findControlSignatureEnd($tokens, $whileIndex);
+
+                return $tokens->getNextMeaningfulToken($signatureEndIndex) ?? $signatureEndIndex;
+            }
+
+            return $bodyEndIndex;
+        }
+
+        if ($token->isGivenKind([T_FOR, T_FOREACH, T_WHILE, T_SWITCH])) {
+            return $this->findControlStatementEnd($tokens, $index);
+        }
+
+        if ($token->isGivenKind(T_ELSE)) {
+            $bodyStartIndex = $tokens->getNextMeaningfulToken($index);
+
+            return null !== $bodyStartIndex ? $this->findStatementEnd($tokens, $bodyStartIndex) : $index;
+        }
+
+        $max = \count($tokens);
+
+        for ($searchIndex = $index; $searchIndex < $max; ++$searchIndex) {
+            $searchToken = $tokens[$searchIndex];
+
+            if ($searchToken->equals(';')) {
+                return $searchIndex;
+            }
+
+            $blockType = Tokens::detectBlockType($searchToken);
+            if (null !== $blockType && $blockType['isStart']) {
+                $searchIndex = $tokens->findBlockEnd($blockType['type'], $searchIndex);
+            }
+        }
+
+        return $max - 1;
+    }
+
+    private function findIfStatementEnd(Tokens $tokens, int $index): int
+    {
+        $signatureEndIndex = $this->findControlSignatureEnd($tokens, $index);
+        $bodyStartIndex = $tokens->getNextMeaningfulToken($signatureEndIndex);
+
+        if (
+            null !== $bodyStartIndex
+            && $tokens[$bodyStartIndex]->equals(':')
+            && $this->alternativeSyntaxAnalyzer->belongsToAlternativeSyntax($tokens, $bodyStartIndex)
+        ) {
+            $endIndex = $this->alternativeSyntaxAnalyzer->findAlternativeSyntaxBlockEnd($tokens, $index);
+
+            while ($tokens[$endIndex]->isGivenKind([T_ELSEIF, T_ELSE])) {
+                $endIndex = $this->alternativeSyntaxAnalyzer->findAlternativeSyntaxBlockEnd($tokens, $endIndex);
+            }
+
+            return $endIndex;
+        }
+
+        $endIndex = null !== $bodyStartIndex ? $this->findStatementEnd($tokens, $bodyStartIndex) : $signatureEndIndex;
+        $nextIndex = $tokens->getNextMeaningfulToken($endIndex);
+
+        while (null !== $nextIndex && $tokens[$nextIndex]->isGivenKind(T_ELSEIF)) {
+            $branchEndIndex = $this->findControlStatementEnd($tokens, $nextIndex);
+            $endIndex = $branchEndIndex;
+            $nextIndex = $tokens->getNextMeaningfulToken($endIndex);
+        }
+
+        if (null !== $nextIndex && $tokens[$nextIndex]->isGivenKind(T_ELSE)) {
+            $endIndex = $this->findControlStatementEnd($tokens, $nextIndex);
+        }
+
+        return $endIndex;
+    }
+
+    private function findControlStatementEnd(Tokens $tokens, int $index): int
+    {
+        $signatureEndIndex = $this->findControlSignatureEnd($tokens, $index);
+        $bodyStartIndex = $tokens->getNextMeaningfulToken($signatureEndIndex);
+
+        if (null === $bodyStartIndex) {
+            return $signatureEndIndex;
+        }
+
+        if (
+            $tokens[$bodyStartIndex]->equals(':')
+            && $this->alternativeSyntaxAnalyzer->belongsToAlternativeSyntax($tokens, $bodyStartIndex)
+        ) {
+            return $this->alternativeSyntaxAnalyzer->findAlternativeSyntaxBlockEnd($tokens, $index);
+        }
+
+        return $this->findStatementEnd($tokens, $bodyStartIndex);
+    }
