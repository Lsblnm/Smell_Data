diff --git a/lib/rubocop/cop/style/redundant_parentheses.rb b/lib/rubocop/cop/style/redundant_parentheses.rb
index 14171eba3..79604f7d5 100644
--- a/lib/rubocop/cop/style/redundant_parentheses.rb
+++ b/lib/rubocop/cop/style/redundant_parentheses.rb
@@ -183,6 +183,8 @@ module RuboCop
 
         # rubocop:disable Metrics/AbcSize, Metrics/CyclomaticComplexity, Metrics/MethodLength, Metrics/PerceivedComplexity
         def check_send(begin_node, node)
+          return if do_end_block_in_unparenthesized_argument?(begin_node, node)
+
           if node.unary_operation?
             unary_target = begin_node
             unary_expression = node
@@ -260,6 +262,51 @@ module RuboCop
         end
         # rubocop:enable Metrics/AbcSize, Metrics/CyclomaticComplexity, Metrics/MethodLength, Metrics/PerceivedComplexity
 
+        def do_end_block_in_unparenthesized_argument?(begin_node, node)
+          do_end_block_in_receiver_chain?(node) && argument_of_unparenthesized_call?(begin_node)
+        end
+
+        def do_end_block_in_receiver_chain?(node)
+          receiver = node
+
+          while receiver
+            return true if do_end_block?(receiver)
+            return false unless receiver.call_type?
+
+            receiver = receiver.receiver
+          end
+
+          false
+        end
+
+        def do_end_block?(node)
+          return false unless node.call_type? || node.any_block_type?
+
+          block = node.any_block_type? ? node : node.block_node
+          block && !block.braces?
+        end
+
+        def argument_of_unparenthesized_call?(node)
+          argument = outermost_argument_chain(node)
+          parent = argument.parent
+          parent = parent.parent while parent&.pair_type? || parent&.hash_type?
+
+          unparenthesized_call?(parent)
+        end
+
+        def outermost_argument_chain(node)
+          while (parent = node.parent) && parent.call_type? && parent.receiver.equal?(node)
+            node = parent
+          end
+
+          node
+        end
+
+        def unparenthesized_call?(node)
+          node && (node.call_type? || node.super_type? || node.yield_type?) &&
+            !node.parenthesized?
+        end
+
         def check_unary(begin_node, node)
           return if begin_node.chained?
 
