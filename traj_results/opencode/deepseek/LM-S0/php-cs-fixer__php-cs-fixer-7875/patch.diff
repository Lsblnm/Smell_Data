+    /**
+     * @return array<int, int>
+     */
+    private function getDeclarationStarts(Tokens $tokens): array
+    {
+        $starts = [];
+
+        foreach ((new TokensAnalyzer($tokens))->getClassyElements() as $index => $element) {
+            if (!\in_array($element['type'], ['property', 'const'], true)) {
+                continue;
+            }
+
+            $boundaryIndex = $tokens->getPrevTokenOfKind($index, [';', '{', '}', [CT::T_ATTRIBUTE_CLOSE], [T_OPEN_TAG]]);
+            $startIndex = null === $boundaryIndex ? 0 : $tokens->getNextMeaningfulToken($boundaryIndex);
+
+            if (null === $startIndex || isset($starts[$startIndex])) {
+                continue;
+            }
+
+            $starts[$startIndex] = $this->findDeclarationEndIndex($tokens, $startIndex);
+        }
+
+        return $starts;
+    }
+
+    private function findDeclarationEndIndex(Tokens $tokens, int $index): int
+    {
+        for ($max = \count($tokens); $index < $max; ++$index) {
+            $token = $tokens[$index];
+
+            if ($token->equalsAny(['(', '{', [CT::T_ARRAY_SQUARE_BRACE_OPEN]])) {
+                $blockType = Tokens::BLOCK_TYPE_ARRAY_SQUARE_BRACE;
+                $blockTypesByContent = [
+                    '(' => Tokens::BLOCK_TYPE_PARENTHESIS_BRACE,
+                    '{' => Tokens::BLOCK_TYPE_CURLY_BRACE,
+                ];
+                if (isset($blockTypesByContent[$token->getContent()])) {
+                    $blockType = $blockTypesByContent[$token->getContent()];
+                }
+
+                $index = $tokens->findBlockEnd($blockType, $index);
+
+                continue;
+            }
+
+            if ($token->equals(';')) {
+                return $index;
+            }
+        }
+
+        return \count($tokens) - 1;
+    }
