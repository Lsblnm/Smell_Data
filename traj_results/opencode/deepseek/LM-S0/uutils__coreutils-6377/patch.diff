+#[cfg(unix)]
+fn parse_signal(signal: &str) -> Option<Signal> {
+    let signal = signal.to_ascii_uppercase();
+    let name = signal.strip_prefix("SIG").unwrap_or(&signal);
+    if let Ok(value) = name.parse::<i32>() {
+        return Signal::try_from(value).ok();
+    }
+    format!("SIG{name}").parse::<Signal>().ok()
+}
+
+#[cfg(unix)]
+fn parse_ignore_signals(matches: &clap::ArgMatches) -> UResult<Vec<(Signal, bool)>> {
+    let mut signals = Vec::new();
+    if let Some(occurrences) = matches.get_occurrences::<OsString>("ignore-signal") {
+        for occurrence in occurrences {
+            let values: Vec<_> = occurrence.collect();
+            if values.is_empty() {
+                for value in 1..=64 {
+                    if let Ok(signal) = Signal::try_from(value) {
+                        signals.push((signal, true));
+                    }
+                }
+            } else {
+                for value in values {
+                    let value = value.to_string_lossy();
+                    for signal in value.split(',').filter(|signal| !signal.is_empty()) {
+                        let parsed = parse_signal(signal).ok_or_else(|| {
+                            USimpleError::new(125, format!("{}: invalid signal", signal.quote()))
+                        })?;
+                        signals.push((parsed, false));
+                    }
+                }
+            }
+        }
+    }
+    Ok(signals)
+}
