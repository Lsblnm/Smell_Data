+    /**
+     * @return string[]
+     */
+    private static function splitOutsideQuotes(string $value, string $separator): array
+    {
+        $parts = [];
+        $current = '';
+        $quoted = false;
+        $length = strlen($value);
+        for ($i = 0; $i < $length; ++$i) {
+            $character = $value[$i];
+            if ($character === "'") {
+                $quoted = !$quoted;
+            } elseif ($character === $separator && !$quoted) {
+                $parts[] = $current;
+                $current = '';
+                continue;
+            }
+            $current .= $character;
+        }
+        $parts[] = $current;
+
+        return $parts;
+    }
+
+    private static function convertReference(string $reference): string
+    {
+        $segments = self::splitOutsideQuotes($reference, ':');
+        $sheetName = '';
+        $cells = [];
+        foreach ($segments as $index => $segment) {
+            $segmentParts = self::splitOutsideQuotes($segment, '.');
+            $cell = (string) array_pop($segmentParts);
+            if ($segmentParts !== []) {
+                $sheet = implode('.', $segmentParts);
+                if ($index === 0 && $sheet !== '') {
+                    $sheetName = ltrim($sheet, '$');
+                }
+            }
+            $cells[] = $cell;
+        }
+
+        $cellRange = implode(':', $cells);
+        if ($sheetName !== '') {
+            return $sheetName . '!' . $cellRange;
+        }
+
+        return $cellRange;
+    }
 }
