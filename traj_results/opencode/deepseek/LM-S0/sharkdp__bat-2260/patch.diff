diff --git a/src/syntax_mapping.rs b/src/syntax_mapping.rs
index 6902e1ae..5199ef52 100644
--- a/src/syntax_mapping.rs
+++ b/src/syntax_mapping.rs
@@ -275,6 +275,27 @@ impl<'a> SyntaxMapping<'a> {
         None
     }
 
+    pub(crate) fn get_syntax_for_with_ignored_suffixes(
+        &self,
+        path: impl AsRef<Path>,
+    ) -> Option<MappingTarget<'a>> {
+        let path = path.as_ref();
+
+        if let Some(target) = self.get_syntax_for(path) {
+            return Some(target);
+        }
+
+        let file_name = path.file_name()?;
+        let ignored_suffixes: &IgnoredSuffixes<'_> = &self.ignored_suffixes;
+        ignored_suffixes
+            .try_with_stripped_suffix(file_name, |stripped_file_name| {
+                Ok(self
+                    .get_syntax_for_with_ignored_suffixes(path.with_file_name(stripped_file_name)))
+            })
+            .ok()
+            .flatten()
+    }
+
     pub fn insert_ignored_suffix(&mut self, suffix: &'a str) {
         self.ignored_suffixes.add_suffix(suffix);
     }
