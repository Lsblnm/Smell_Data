+    fn print_header_multiline_component(
+        &mut self,
+        handle: &mut OutputHandle,
+        content: &[(String, Option<Style>)],
+    ) -> Result<()> {
+        let content_width = self
+            .config
+            .term_width
+            .saturating_sub(self.get_header_component_indent_length())
+            .max(1);
+
+        let mut line: Vec<(String, Option<Style>)> = Vec::new();
+        let mut line_width = 0;
+
+        for (text, style) in content {
+            let mut chunk = String::new();
+            for c in text.chars() {
+                let char_width = c.width().unwrap_or(0);
+                if line_width + char_width > content_width && line_width > 0 {
+                    if !chunk.is_empty() {
+                        line.push((std::mem::take(&mut chunk), *style));
+                    }
+
+                    self.print_header_component_indent(handle)?;
+                    for (text, style) in &line {
+                        match style {
+                            Some(style) => write!(handle, "{}", style.paint(text))?,
+                            None => write!(handle, "{}", text)?,
+                        }
+                    }
+                    write!(handle, "\n")?;
+
+                    line.clear();
+                    line_width = 0;
+                }
+
+                chunk.push(c);
+                line_width += char_width;
+            }
+
+            if !chunk.is_empty() {
+                line.push((chunk, *style));
+            }
+        }
+
+        self.print_header_component_indent(handle)?;
+        for (text, style) in &line {
+            match style {
+                Some(style) => write!(handle, "{}", style.paint(text))?,
+                None => write!(handle, "{}", text)?,
+            }
+        }
+        write!(handle, "\n")?;
+
+        Ok(())
+    }
