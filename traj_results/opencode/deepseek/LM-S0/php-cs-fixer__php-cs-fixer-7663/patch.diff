+    private function findControlStructureHeaderEndIndex(Tokens $tokens, int $index): int
+    {
+        if ($tokens[$index]->isGivenKind([T_ELSE, T_DO])) {
+            return $index;
+        }
+
+        $openParenthesisIndex = $tokens->getNextTokenOfKind($index, ['(']);
+
+        if (null === $openParenthesisIndex) {
+            return $index;
+        }
+
+        return $tokens->findBlockEnd(Tokens::BLOCK_TYPE_PARENTHESIS_BRACE, $openParenthesisIndex);
+    }
+
+    private function findStatementEndIndexInclusive(Tokens $tokens, int $index, int $parentScopeEndIndex): int
+    {
+        $token = $tokens[$index];
+
+        if ($token->isGivenKind([T_IF, T_ELSEIF])) {
+            return $this->findIfStructureEndIndex($tokens, $index, $parentScopeEndIndex);
+        }
+
+        if ($token->isGivenKind([T_FOR, T_FOREACH, T_WHILE, T_SWITCH, T_DECLARE])) {
+            return $this->findLoopStructureEndIndex($tokens, $index, $parentScopeEndIndex);
+        }
+
+        if ($token->isGivenKind(T_DO)) {
+            return $this->findDoStructureEndIndex($tokens, $index, $parentScopeEndIndex);
+        }
+
+        if ($token->isGivenKind(T_ELSE)) {
+            return $this->findElseStructureEndIndex($tokens, $index, $parentScopeEndIndex);
+        }
+
+        if ($token->isGivenKind(T_TRY)) {
+            return $this->findTryStructureEndIndex($tokens, $index, $parentScopeEndIndex);
+        }
+
+        return $this->findSimpleStatementEndIndex($tokens, $index, $parentScopeEndIndex);
+    }
+
+    private function findIfStructureEndIndex(Tokens $tokens, int $index, int $parentScopeEndIndex): int
+    {
+        $endIndex = $this->findControlStructureBodyEndIndex($tokens, $index, $parentScopeEndIndex);
+
+        while (null !== $nextIndex = $tokens->getNextMeaningfulToken($endIndex)) {
+            if ($nextIndex > $parentScopeEndIndex || !$tokens[$nextIndex]->isGivenKind([T_ELSEIF, T_ELSE])) {
+                break;
+            }
+
+            $endIndex = $this->findControlStructureBodyEndIndex($tokens, $nextIndex, $parentScopeEndIndex);
+
+            if ($tokens[$nextIndex]->isGivenKind(T_ELSE)) {
+                break;
+            }
+        }
+
+        return $endIndex;
+    }
+
+    private function findLoopStructureEndIndex(Tokens $tokens, int $index, int $parentScopeEndIndex): int
+    {
+        return $this->findControlStructureBodyEndIndex($tokens, $index, $parentScopeEndIndex);
+    }
+
+    private function findControlStructureBodyEndIndex(Tokens $tokens, int $index, int $parentScopeEndIndex): int
+    {
+        $headerEndIndex = $this->findControlStructureHeaderEndIndex($tokens, $index);
+        $bodyStartIndex = $tokens->getNextMeaningfulToken($headerEndIndex);
+
+        if (null === $bodyStartIndex || $bodyStartIndex > $parentScopeEndIndex) {
+            return $headerEndIndex;
+        }
+
+        if ($tokens[$bodyStartIndex]->equals('{')) {
+            return $tokens->findBlockEnd(Tokens::BLOCK_TYPE_CURLY_BRACE, $bodyStartIndex);
+        }
+
+        if ($tokens[$bodyStartIndex]->equals(':')) {
+            return $this->alternativeSyntaxAnalyzer->findAlternativeSyntaxBlockEnd($tokens, $index);
+        }
+
+        if ($tokens[$bodyStartIndex]->equals(';')) {
+            return $bodyStartIndex;
+        }
+
+        return $this->findStatementEndIndexInclusive($tokens, $bodyStartIndex, $parentScopeEndIndex);
+    }
+
+    private function findDoStructureEndIndex(Tokens $tokens, int $index, int $parentScopeEndIndex): int
+    {
+        $bodyStartIndex = $tokens->getNextMeaningfulToken($index);
+
+        if (null === $bodyStartIndex || $bodyStartIndex > $parentScopeEndIndex) {
+            return $index;
+        }
+
+        if ($tokens[$bodyStartIndex]->equals('{')) {
+            $endIndex = $tokens->findBlockEnd(Tokens::BLOCK_TYPE_CURLY_BRACE, $bodyStartIndex);
+        } elseif ($tokens[$bodyStartIndex]->equals(';')) {
+            $endIndex = $bodyStartIndex;
+        } else {
+            $endIndex = $this->findStatementEndIndexInclusive($tokens, $bodyStartIndex, $parentScopeEndIndex);
+        }
+
+        $whileIndex = $tokens->getNextMeaningfulToken($endIndex);
+
+        if (null === $whileIndex || $whileIndex > $parentScopeEndIndex || !$tokens[$whileIndex]->isGivenKind(T_WHILE)) {
+            return $endIndex;
+        }
+
+        $whileHeaderEndIndex = $this->findControlStructureHeaderEndIndex($tokens, $whileIndex);
+        $terminatorIndex = $tokens->getNextMeaningfulToken($whileHeaderEndIndex);
+
+        if (null !== $terminatorIndex && $terminatorIndex <= $parentScopeEndIndex && $tokens[$terminatorIndex]->equals(';')) {
+            return $terminatorIndex;
+        }
+
+        return $whileHeaderEndIndex;
+    }
+
+    private function findElseStructureEndIndex(Tokens $tokens, int $index, int $parentScopeEndIndex): int
+    {
+        $bodyStartIndex = $tokens->getNextMeaningfulToken($index);
+
+        if (null === $bodyStartIndex || $bodyStartIndex > $parentScopeEndIndex) {
+            return $index;
+        }
+
+        if ($tokens[$bodyStartIndex]->equals('{')) {
+            return $tokens->findBlockEnd(Tokens::BLOCK_TYPE_CURLY_BRACE, $bodyStartIndex);
+        }
+
+        if ($tokens[$bodyStartIndex]->equals(':')) {
+            return $this->alternativeSyntaxAnalyzer->findAlternativeSyntaxBlockEnd($tokens, $index);
+        }
+
+        if ($tokens[$bodyStartIndex]->equals(';')) {
+            return $bodyStartIndex;
+        }
+
+        return $this->findStatementEndIndexInclusive($tokens, $bodyStartIndex, $parentScopeEndIndex);
+    }
+
+    private function findTryStructureEndIndex(Tokens $tokens, int $index, int $parentScopeEndIndex): int
+    {
+        $bodyStartIndex = $tokens->getNextMeaningfulToken($index);
+
+        if (null === $bodyStartIndex || $bodyStartIndex > $parentScopeEndIndex) {
+            return $index;
+        }
+
+        $endIndex = $tokens[$bodyStartIndex]->equals('{')
+            ? $tokens->findBlockEnd(Tokens::BLOCK_TYPE_CURLY_BRACE, $bodyStartIndex)
+            : $this->findStatementEndIndexInclusive($tokens, $bodyStartIndex, $parentScopeEndIndex);
+
+        while (null !== $nextIndex = $tokens->getNextMeaningfulToken($endIndex)) {
+            if ($nextIndex > $parentScopeEndIndex || !$tokens[$nextIndex]->isGivenKind([T_CATCH, T_FINALLY])) {
+                break;
+            }
+
+            $headerEndIndex = $tokens[$nextIndex]->isGivenKind(T_CATCH)
+                ? $this->findControlStructureHeaderEndIndex($tokens, $nextIndex)
+                : $nextIndex;
+            $blockStartIndex = $tokens->getNextMeaningfulToken($headerEndIndex);
+
+            if (null === $blockStartIndex || $blockStartIndex > $parentScopeEndIndex || !$tokens[$blockStartIndex]->equals('{')) {
+                return $headerEndIndex;
+            }
+
+            $endIndex = $tokens->findBlockEnd(Tokens::BLOCK_TYPE_CURLY_BRACE, $blockStartIndex);
+        }
+
+        return $endIndex;
+    }
+
+    private function findSimpleStatementEndIndex(Tokens $tokens, int $index, int $parentScopeEndIndex): int
+    {
+        for ($searchIndex = $index; $searchIndex <= $parentScopeEndIndex; ++$searchIndex) {
+            $searchToken = $tokens[$searchIndex];
+
+            if ($searchToken->equals('(')) {
+                $searchIndex = $tokens->findBlockEnd(Tokens::BLOCK_TYPE_PARENTHESIS_BRACE, $searchIndex);
+
+                continue;
+            }
+
+            if ($searchToken->equals('{')) {
+                $searchIndex = $tokens->findBlockEnd(Tokens::BLOCK_TYPE_CURLY_BRACE, $searchIndex);
+
+                continue;
+            }
+
+            if ($searchToken->isGivenKind(CT::T_ARRAY_SQUARE_BRACE_OPEN)) {
+                $searchIndex = $tokens->findBlockEnd(Tokens::BLOCK_TYPE_ARRAY_SQUARE_BRACE, $searchIndex);
+
+                continue;
+            }
+
+            if ($searchToken->isGivenKind(CT::T_DESTRUCTURING_SQUARE_BRACE_OPEN)) {
+                $searchIndex = $tokens->findBlockEnd(Tokens::BLOCK_TYPE_DESTRUCTURING_SQUARE_BRACE, $searchIndex);
+
+                continue;
+            }
+
+            if (\defined('T_ATTRIBUTE') && $searchToken->isGivenKind(T_ATTRIBUTE)) {
+                $searchIndex = $tokens->findBlockEnd(Tokens::BLOCK_TYPE_ATTRIBUTE, $searchIndex);
+
+                continue;
+            }
+
+            if ($searchToken->equalsAny([';', [T_CLOSE_TAG]])) {
+                return $searchIndex;
+            }
+
+            if ($searchToken->equals('}')) {
+                return $tokens->getPrevMeaningfulToken($searchIndex) ?? $searchIndex;
+            }
+        }
+
+        return $parentScopeEndIndex;
+    }
+
     /**
      * @return array{int, bool}
      */
