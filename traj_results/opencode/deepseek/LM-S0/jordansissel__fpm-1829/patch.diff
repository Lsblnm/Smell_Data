diff --git a/lib/fpm/package/deb.rb b/lib/fpm/package/deb.rb
index b6a7737..c7770ce 100644
--- a/lib/fpm/package/deb.rb
+++ b/lib/fpm/package/deb.rb
@@ -777,6 +777,33 @@ class FPM::Package::Deb < FPM::Package
   def fix_provides(provides)
     name_re = /^[^ \(]+/
     name = provides[name_re]
+
+    if name.nil? || name.empty?
+      raise FPM::InvalidPackageConfiguration,
+        "Invalid Provides value #{provides.inspect}: package name is missing"
+    end
+
+    remainder = provides[name.length..-1].to_s
+    trimmed = remainder.strip
+    if !trimmed.empty?
+      version_match = trimmed.match(/\A\(\s*=\s*(.*?)\s*\)\z/) ||
+                      trimmed.match(/\A=\s*(.*)\z/)
+      if version_match.nil?
+        raise FPM::InvalidPackageConfiguration,
+          "Invalid Provides value #{provides.inspect}: Debian only supports " \
+          "exact versions in the Provides field, using the syntax " \
+          "'name (= version)'"
+      end
+
+      provided_version = version_match[1].strip
+      if provided_version.empty? ||
+         provided_version !~ /\A(?:[0-9]+:)?[0-9][A-Za-z0-9.+~:]*(?:-[A-Za-z0-9+~.]+)*\z/
+        raise FPM::InvalidPackageConfiguration,
+          "Invalid Provides value #{provides.inspect}: '#{provided_version}' " \
+          "is not a valid Debian version"
+      end
+    end
+
     relation = nil
     version_text = nil
 
