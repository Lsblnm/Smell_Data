diff --git a/axum/src/routing/path_router.rs b/axum/src/routing/path_router.rs
index b7a8e881..f73bf744 100644
--- a/axum/src/routing/path_router.rs
+++ b/axum/src/routing/path_router.rs
@@ -30,6 +30,37 @@ where
         self.replace_endpoint("/", endpoint.clone());
         self.replace_endpoint(&format!("/*{FALLBACK_PARAM}"), endpoint);
     }
+
+    /// Return this router with the root fallback removed.
+    ///
+    /// Nested fallbacks are kept. This is useful when merging routers since
+    /// only the root fallbacks should conflict, not nested ones.
+    pub(super) fn without_root_fallback(self) -> Self {
+        let PathRouter {
+            routes,
+            node,
+            prev_route_id,
+        } = self;
+
+        let fallback_path = format!("/*{FALLBACK_PARAM}");
+        let routes = routes
+            .into_iter()
+            .filter(|(id, _)| {
+                let path = node
+                    .route_id_to_path
+                    .get(id)
+                    .expect("no path for route id. This is a bug in axum. Please file an issue")
+                    .as_ref();
+                path != "/" && path != fallback_path
+            })
+            .collect();
+
+        PathRouter {
+            routes,
+            node,
+            prev_route_id,
+        }
+    }
 }
 
 impl<S, const IS_FALLBACK: bool> PathRouter<S, IS_FALLBACK>
