+func (n *NodeValidatableResource) validateImportTargets(ctx EvalContext) tfdiags.Diagnostics {
+	var diags tfdiags.Diagnostics
+
+	for _, imp := range n.importTargets {
+		if imp.Config == nil {
+			continue
+		}
+
+		cfg := imp.Config
+		target := cfg.ToResource
+
+		if n.Config == nil {
+			switch {
+			case cfg.ForEach != nil:
+				diags = diags.Append(&hcl.Diagnostic{
+					Severity: hcl.DiagError,
+					Summary:  "Use of import for_each in an invalid context",
+					Detail:   "The import block's for_each argument cannot be used when the target resource does not have a matching resource configuration, because Terraform cannot generate configuration for import blocks using for_each.",
+					Subject:  cfg.ForEach.Range().Ptr(),
+				})
+			case !target.Module.IsRoot():
+				diags = diags.Append(&hcl.Diagnostic{
+					Severity: hcl.DiagError,
+					Summary:  "Configuration for import target does not exist",
+					Detail:   fmt.Sprintf("The configuration for the given import target %s does not exist. All target instances must have an associated configuration to be imported.", target),
+					Subject:  cfg.To.Range().Ptr(),
+				})
+			default:
+				traversal, hd := hcl.AbsTraversalForExpr(cfg.To)
+				toDiags := tfdiags.Diagnostics{}.Append(hd)
+				to, td := addrs.ParseAbsResourceInstance(traversal)
+				toDiags = toDiags.Append(td)
+				if toDiags.HasErrors() || to.Resource.Key != addrs.NoKey {
+					diags = diags.Append(&hcl.Diagnostic{
+						Severity: hcl.DiagError,
+						Summary:  "Configuration for import target does not exist",
+						Detail:   fmt.Sprintf("The configuration for the given import target %s does not exist. All target instances must have an associated configuration to be imported.", target),
+						Subject:  cfg.To.Range().Ptr(),
+					})
+				}
+			}
+		}
+
+		if cfg.ForEach != nil {
+			forEachData, known, forEachDiags := newForEachEvaluator(cfg.ForEach, ctx, true).ImportValues()
+			diags = diags.Append(forEachDiags)
+			if forEachDiags.HasErrors() {
+				continue
+			}
+
+			if !known {
+				keyData := InstanceKeyEvalData{
+					EachKey:   cty.UnknownVal(cty.String),
+					EachValue: cty.DynamicVal,
+				}
+				_, idDiags := evaluateImportIdExpression(cfg.ID, target.Absolute(target.Module.UnkeyedInstanceShim()).Instance(addrs.NoKey), ctx, keyData, true)
+				diags = diags.Append(idDiags)
+				continue
+			}
+
+			for _, keyData := range forEachData {
+				to, evalDiags := evalImportToExpression(cfg.To, keyData)
+				diags = diags.Append(evalDiags)
+				if evalDiags.HasErrors() {
+					continue
+				}
+
+				_, idDiags := evaluateImportIdExpression(cfg.ID, to, ctx, keyData, true)
+				diags = diags.Append(idDiags)
+			}
+			continue
+		}
+
+		traversal, hd := hcl.AbsTraversalForExpr(cfg.To)
+		toDiags := tfdiags.Diagnostics{}.Append(hd)
+		to, td := addrs.ParseAbsResourceInstance(traversal)
+		toDiags = toDiags.Append(td)
+		diags = diags.Append(toDiags)
+		if toDiags.HasErrors() {
+			continue
+		}
+
+		_, idDiags := evaluateImportIdExpression(cfg.ID, to, ctx, EvalDataForNoInstanceKey, true)
+		diags = diags.Append(idDiags)
+	}
+
+	return diags
+}
