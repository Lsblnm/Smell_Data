+  private boolean shouldReturnResponse(
+      HttpResponseStatus responseStatus,
+      @Nullable Set<Integer> responseCodesToHandle
+  )
+  {
+    // 503 and 504 are returned by proxies/sidecars when the requested endpoint is unavailable. Always retry these
+    // after refreshing the leader cache.
+    if (HttpResponseStatus.SERVICE_UNAVAILABLE.equals(responseStatus)
+        || HttpResponseStatus.GATEWAY_TIMEOUT.equals(responseStatus)) {
+      return false;
+    }
+
+    final int responseCode = responseStatus.getCode();
+    if (responseCode >= 200 && responseCode < 300) {
+      return true;
+    }
+
+    // Preserve the old behavior of returning other non-2xx responses unless the caller has explicitly asked for
+    // them to be handled (returned) by passing a set of response codes.
+    return responseCodesToHandle == null || responseCodesToHandle.contains(responseCode);
+  }
+
+  @Nullable
+  private String refreshLeader()
+  {
+    Iterator<DiscoveryDruidNode> nodeIterator = druidNodeDiscovery.getAllNodes().iterator();
+    String leader = null;
+    if (nodeIterator.hasNext()) {
+      DiscoveryDruidNode discoveryNode = nodeIterator.next();
+      DruidNode druidNode = discoveryNode.getDruidNode();
+      String nodeHost = druidNode.getHost();
+      int tlsPort = druidNode.getTlsPort();
+      int plaintextPort = druidNode.getPlaintextPort();
+      boolean tlsEnabled = druidNode.isEnableTlsPort();
+      boolean plaintextEnabled = druidNode.isEnablePlaintextPort();
+      String serviceScheme = tlsPort >= 0 ? "https" : "http";
+      String hostAndPortToUse = null;
+      if (tlsEnabled) {
+        hostAndPortToUse = HostAndPort.fromParts(nodeHost, tlsPort).toString();
+      } else if (plaintextEnabled && plaintextPort < 0) {
+        hostAndPortToUse = HostAndPort.fromString(nodeHost).toString();
+      } else if (plaintextEnabled) {
+        hostAndPortToUse = HostAndPort.fromParts(nodeHost, plaintextPort).toString();
+      }
+      if (hostAndPortToUse != null) {
+        leader = StringUtils.format("%s://%s", serviceScheme, hostAndPortToUse);
+      }
+    }
+    currentKnownLeader.set(leader);
+    return leader;
+  }
+
+  private Request makeRetryRequest(Request request, @Nullable String leader) throws IOException
+  {
+    if (leader == null) {
+      throw new IOE("No known server");
+    }
+
+    try {
+      URL failedUrl = request.getUrl();
+      String query = failedUrl.getQuery();
+      String path = failedUrl.getPath();
+      URL retryUrl;
+      if (query == null) {
+        retryUrl = new URL(StringUtils.format("%s%s", leader, path));
+      } else {
+        retryUrl = new URL(StringUtils.format("%s%s?%s", leader, path, query));
+      }
+      return withUrl(request, retryUrl);
+    }
+    catch (MalformedURLException e) {
+      // Not an IOException; this is our own fault.
+      throw new ISE(
+          e,
+          "failed to build url with path[%] and query string [%s].",
+          request.getUrl().getPath(),
+          request.getUrl().getQuery()
+      );
+    }
+  }
