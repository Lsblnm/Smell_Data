+// findRemovedBlocks records the removed blocks for all resources in the
+// configuration, keyed by their absolute configuration address.
+//
+// A removed block in a parent module overrides a removed block in a child
+// module when both target the same object, so we walk the configuration tree
+// from the root and keep the first block we find for each address.
+func (t *AttachResourceConfigTransformer) findRemovedBlocks(cfg *configs.Config, into map[string]*configs.Removed) {
+	if cfg == nil || cfg.Module == nil {
+		return
+	}
+
+	for _, removedBlock := range cfg.Module.Removed {
+		if removedBlock.From == nil {
+			continue
+		}
+
+		crAddr, ok := removedBlock.From.RelSubject.(addrs.ConfigResource)
+		if !ok {
+			// Not for a resource at all, so can't possibly match.
+			continue
+		}
+
+		module := make(addrs.Module, 0, len(cfg.Path)+len(crAddr.Module))
+		module = append(module, cfg.Path...)
+		module = append(module, crAddr.Module...)
+		absAddr := addrs.ConfigResource{
+			Module:   module,
+			Resource: crAddr.Resource,
+		}
+
+		key := absAddr.String()
+		if _, exists := into[key]; exists {
+			continue
+		}
+		into[key] = removedBlock
+	}
+
+	for _, child := range cfg.Children {
+		t.findRemovedBlocks(child, into)
+	}
+}
