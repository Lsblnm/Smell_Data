diff --git a/lib/fluent/rpc.rb b/lib/fluent/rpc.rb
index 50f4488b..df6f9f40 100644
--- a/lib/fluent/rpc.rb
+++ b/lib/fluent/rpc.rb
@@ -16,6 +16,8 @@
 
 require 'webrick'
 require 'ipaddr'
+require 'socket'
+require 'fluent/config/error'
 require 'fluent/env'
 require 'fluent/log'
 require 'fluent/plugin_helper/socket_option'
@@ -24,9 +26,7 @@ module Fluent
   module RPC
     class Server
       def initialize(endpoint, log)
-        bind, port = endpoint.split(':')
-        @bind = bind
-        @port = port
+        @bind, @port = parse_endpoint(endpoint)
         @log = log
 
         fluent_level = Fluent::Log::LEVEL_INFO
@@ -191,6 +191,47 @@ module Fluent
           @thread = nil
         end
       end
+
+      private
+
+      def parse_endpoint(endpoint)
+        endpoint = endpoint.to_s
+        bind = nil
+        port = nil
+
+        if endpoint.start_with?('[')
+          match = /\A\[([^\]]+)\]:(\d+)\z/.match(endpoint)
+          bind, port = match.captures if match
+        else
+          host, separator, port_string = endpoint.rpartition(':')
+          unless separator.empty? || host.empty?
+            bind = host
+            port = port_string
+          end
+        end
+
+        port = port.to_i if port
+        unless bind && port && port > 0 && port <= 65535 && valid_bind?(bind)
+          raise Fluent::ConfigError, "Invalid rpc_endpoint: #{endpoint}"
+        end
+
+        [bind, port]
+      end
+
+      def valid_bind?(bind)
+        begin
+          IPAddr.new(bind)
+          return true
+        rescue IPAddr::Error
+        end
+
+        begin
+          Addrinfo.getaddrinfo(bind, nil, nil, :STREAM)
+          true
+        rescue SocketError
+          false
+        end
+      end
     end
   end
 end
