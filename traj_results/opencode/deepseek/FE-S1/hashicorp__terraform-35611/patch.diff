+// findRemovedBlock returns the "removed" block, if any, that targets the given
+// resource address. Removed blocks are relative to the module they are declared
+// in, so we search the modules along the path to the target resource, from the
+// root down. This matches the precedence used when collecting remove
+// statements, where a removed block in an ancestor module overrides one in a
+// descendent module.
+func (t *AttachResourceConfigTransformer) findRemovedBlock(addr addrs.ConfigResource) *configs.Removed {
+	if t.Config == nil || t.Config.Module == nil {
+		return nil
+	}
+
+	cfg := t.Config
+	for cfg != nil && cfg.Module != nil && len(cfg.Path) <= len(addr.Module) {
+		for _, r := range cfg.Module.Removed {
+			if r.From == nil {
+				continue
+			}
+			crAddr, ok := r.From.RelSubject.(addrs.ConfigResource)
+			if !ok || crAddr.Resource != addr.Resource {
+				// Not for this resource at all, so can't possibly match.
+				continue
+			}
+
+			// The removed block's target is relative to the module where the
+			// block was declared, so it only matches if the module prefixes
+			// line up.
+			if len(cfg.Path)+len(crAddr.Module) != len(addr.Module) {
+				continue
+			}
+			matches := true
+			for i, name := range crAddr.Module {
+				if addr.Module[len(cfg.Path)+i] != name {
+					matches = false
+					break
+				}
+			}
+			if matches {
+				return r
+			}
+		}
+
+		if len(cfg.Path) == len(addr.Module) {
+			break
+		}
+		cfg = cfg.Children[addr.Module[len(cfg.Path)]]
+	}
+
+	return nil
+}
