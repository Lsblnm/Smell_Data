+    private function findClassMemberStart(Tokens $tokens, int $index): ?int
+    {
+        $startIndex = $index;
+        $previousIndex = $tokens->getPrevMeaningfulToken($index);
+
+        while (null !== $previousIndex) {
+            $previousToken = $tokens[$previousIndex];
+
+            if ($previousToken->equalsAny([';', '{', '}']) || $previousToken->isGivenKind(CT::T_ATTRIBUTE_CLOSE)) {
+                break;
+            }
+
+            if ($previousToken->equals(',')) {
+                return null;
+            }
+
+            $startIndex = $previousIndex;
+            $previousIndex = $tokens->getPrevMeaningfulToken($previousIndex);
+        }
+
+        return $startIndex;
+    }
+
+    private function findClassMemberEnd(Tokens $tokens, int $index): int
+    {
+        $depth = 0;
+
+        for ($max = \count($tokens); $index < $max; ++$index) {
+            $token = $tokens[$index];
+
+            if ($token->equalsAny(['(', '{', '[', [CT::T_ARRAY_SQUARE_BRACE_OPEN], [CT::T_DESTRUCTURING_SQUARE_BRACE_OPEN], [CT::T_GROUP_IMPORT_BRACE_OPEN]])) {
+                ++$depth;
+
+                continue;
+            }
+
+            if ($token->equalsAny([')', '}', ']', [CT::T_ARRAY_SQUARE_BRACE_CLOSE], [CT::T_DESTRUCTURING_SQUARE_BRACE_CLOSE], [CT::T_GROUP_IMPORT_BRACE_CLOSE]])) {
+                --$depth;
+
+                continue;
+            }
+
+            if (0 === $depth && $token->equals(';')) {
+                return $index;
+            }
+        }
+
+        return $max - 1;
+    }
+
+    private function isClassMemberTokenAtTopLevel(Tokens $tokens, int $startIndex, int $targetIndex): bool
+    {
+        $depth = 0;
+
+        for ($index = $startIndex; $index <= $targetIndex; ++$index) {
+            $token = $tokens[$index];
+
+            if ($token->equalsAny(['(', '{', '[', [CT::T_ARRAY_SQUARE_BRACE_OPEN], [CT::T_DESTRUCTURING_SQUARE_BRACE_OPEN], [CT::T_GROUP_IMPORT_BRACE_OPEN]])) {
+                ++$depth;
+            } elseif ($token->equalsAny([')', '}', ']', [CT::T_ARRAY_SQUARE_BRACE_CLOSE], [CT::T_DESTRUCTURING_SQUARE_BRACE_CLOSE], [CT::T_GROUP_IMPORT_BRACE_CLOSE]])) {
+                --$depth;
+            }
+        }
+
+        return 0 === $depth;
+    }
+
+    private function applyIndentShift(string $indent, int $shift): string
+    {
+        if (0 === $shift) {
+            return $indent;
+        }
+
+        if ($shift > 0) {
+            return $indent.str_repeat(' ', $shift);
+        }
+
+        $length = \strlen($indent) + $shift;
+
+        return $length > 0 ? substr($indent, 0, $length) : '';
+    }
