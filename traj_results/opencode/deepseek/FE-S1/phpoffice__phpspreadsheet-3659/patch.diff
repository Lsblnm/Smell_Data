+    private function findTableByName(string $tableName, ?Worksheet $worksheet = null): ?Table
+    {
+        if ($worksheet !== null) {
+            $table = $worksheet->getTableByName($tableName);
+            if ($table !== null) {
+                return $table;
+            }
+        }
+
+        $spreadsheet = ($worksheet === null) ? $this->spreadsheet : $worksheet->getParent();
+        if ($spreadsheet !== null) {
+            foreach ($spreadsheet->getAllSheets() as $candidateWorksheet) {
+                $table = $candidateWorksheet->getTableByName($tableName);
+                if ($table !== null) {
+                    return $table;
+                }
+            }
+        }
+
+        return null;
+    }
