diff --git a/lib/jekyll/data_entry.rb b/lib/jekyll/data_entry.rb
new file mode 100644
index 000000000..bd128f652
--- /dev/null
+++ b/lib/jekyll/data_entry.rb
@@ -0,0 +1,73 @@
+# frozen_string_literal: true
+
+module Jekyll
+  class DataEntry < Array
+    include Comparable
+
+    attr_reader :data, :path
+
+    def initialize(data, path = nil)
+      super()
+      @data = data
+      @path = path
+      concat(data) if data.is_a?(Array)
+    end
+
+    def [](key)
+      @data[key]
+    end
+
+    def to_liquid
+      @data
+    end
+
+    def to_h
+      @data.is_a?(Hash) ? @data.to_h : super
+    end
+
+    def merge(other, &block)
+      dup.merge!(other, &block)
+    end
+
+    def merge!(other)
+      source = other.is_a?(DataEntry) ? other.data : other
+      if block_given?
+        @data.merge!(source) { |key, old_value, new_value| yield(key, old_value, new_value) }
+      else
+        @data.merge!(source)
+      end
+      self
+    end
+
+    def <=>(other)
+      other = other.data if other.is_a?(DataEntry)
+      @data <=> other
+    end
+
+    def ==(other)
+      other = other.data if other.is_a?(DataEntry)
+      @data == other
+    end
+    alias_method :eql?, :==
+
+    def hash
+      @data.hash
+    end
+
+    def inspect
+      @data.inspect
+    end
+
+    def to_s
+      @data.to_s
+    end
+
+    private
+
+    def initialize_copy(other)
+      super
+      @data = other.data.dup if other.data.respond_to?(:dup)
+      @path = other.path
+    end
+  end
+end
diff --git a/lib/jekyll/data_hash.rb b/lib/jekyll/data_hash.rb
new file mode 100644
index 000000000..e4b256b41
--- /dev/null
+++ b/lib/jekyll/data_hash.rb
@@ -0,0 +1,185 @@
+# frozen_string_literal: true
+
+module Jekyll
+  class DataHash
+    attr_accessor :context
+
+    def initialize(data = nil)
+      @data = {}
+      merge!(data) if data
+    end
+
+    def [](key)
+      value = @data[key]
+      track_dependency(value)
+      value
+    end
+
+    def []=(key, value)
+      @data[key] = value
+    end
+
+    def fetch(key, *args, &block)
+      value = @data.fetch(key, *args, &block)
+      track_dependency(value)
+      value
+    end
+
+    def key?(key)
+      @data.key?(key)
+    end
+    alias_method :has_key?, :key?
+    alias_method :include?, :key?
+    alias_method :member?, :key?
+
+    def dig(*keys)
+      keys.reduce(self) do |object, key|
+        return nil if object.nil?
+        return nil unless object.respond_to?(:[])
+
+        object[key]
+      end
+    end
+
+    def each
+      return enum_for(:each) unless block_given?
+
+      @data.each do |key, value|
+        track_dependency(value)
+        yield key, value
+      end
+      self
+    end
+    alias_method :each_pair, :each
+
+    def each_key
+      return enum_for(:each_key) unless block_given?
+
+      @data.each_key { |key| yield key }
+      self
+    end
+
+    def each_value
+      return enum_for(:each_value) unless block_given?
+
+      @data.each_value do |value|
+        track_dependency(value)
+        yield value
+      end
+      self
+    end
+
+    def keys
+      @data.keys
+    end
+
+    def values
+      @data.values
+    end
+
+    def length
+      @data.length
+    end
+    alias_method :size, :length
+
+    def empty?
+      @data.empty?
+    end
+
+    def merge(other, &block)
+      dup.merge!(other, &block)
+    end
+
+    def merge!(other)
+      source = case other
+               when DataHash then other.to_h
+               when DataEntry then other.data
+               else other
+               end
+      source.each do |key, value|
+        @data[key] = if block_given? && @data.key?(key)
+                       yield(key, @data[key], value)
+                     else
+                       value
+                     end
+      end
+      self
+    end
+
+    def delete(key, &block)
+      @data.delete(key, &block)
+    end
+
+    def clear
+      @data.clear
+      self
+    end
+
+    def to_h
+      @data
+    end
+
+    def to_hash
+      @data
+    end
+
+    def to_liquid
+      self
+    end
+
+    def freeze
+      @data.freeze
+      super
+    end
+
+    def ==(other)
+      other = other.to_h if other.is_a?(DataHash)
+      @data == other
+    end
+
+    def inspect
+      @data.inspect
+    end
+
+    def to_s
+      @data.to_s
+    end
+
+    private
+
+    def initialize_copy(other)
+      super
+      @data = other.to_h.dup
+    end
+
+    def track_dependency(value)
+      return unless value.is_a?(DataEntry) && value.path
+
+      document_path = current_document_path
+      return unless document_path
+
+      site.regenerator.add_dependency(document_path, value.path)
+    end
+
+    def registers
+      context.respond_to?(:registers) ? context.registers : nil
+    end
+
+    def site
+      registers && registers[:site]
+    end
+
+    def current_document_path
+      return unless context
+
+      page = registers && registers[:page]
+      return unless site && page && page.respond_to?(:key?) && page.key?("path")
+
+      if page["collection"]
+        site.in_source_dir(site.config["collections_dir"], page["path"])
+      else
+        site.in_source_dir(page["path"])
+      end
+    end
+  end
+end
