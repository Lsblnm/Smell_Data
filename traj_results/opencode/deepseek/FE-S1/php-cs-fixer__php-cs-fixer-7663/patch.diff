+    private function findControlStructureEnd(Tokens $tokens, int $index, int $parentScopeEndIndex): int
+    {
+        $token = $tokens[$index];
+
+        if ($token->isGivenKind([T_IF, T_ELSEIF, T_FOR, T_FOREACH, T_WHILE, T_SWITCH, T_CATCH, T_DECLARE])) {
+            $parenthesisStartIndex = $tokens->getNextMeaningfulToken($index);
+
+            if (null === $parenthesisStartIndex || !$tokens[$parenthesisStartIndex]->equals('(')) {
+                return $index;
+            }
+
+            $headerEndIndex = $tokens->findBlockEnd(Tokens::BLOCK_TYPE_PARENTHESIS_BRACE, $parenthesisStartIndex);
+        } else {
+            $headerEndIndex = $index;
+        }
+
+        $bodyStartIndex = $tokens->getNextMeaningfulToken($headerEndIndex);
+
+        if (null === $bodyStartIndex) {
+            return $headerEndIndex;
+        }
+
+        if ($tokens[$bodyStartIndex]->equals('{')) {
+            $bodyEndIndex = $tokens->findBlockEnd(Tokens::BLOCK_TYPE_CURLY_BRACE, $bodyStartIndex);
+        } elseif ($tokens[$bodyStartIndex]->equals(':')) {
+            $bodyEndIndex = $this->alternativeSyntaxAnalyzer->findAlternativeSyntaxBlockEnd($tokens, $index);
+        } elseif ($tokens[$bodyStartIndex]->equals(';')) {
+            $bodyEndIndex = $bodyStartIndex;
+        } else {
+            $bodyEndIndex = $this->findStatementEndFromIndex($tokens, $bodyStartIndex, $parentScopeEndIndex);
+        }
+
+        if ($token->isGivenKind([T_IF, T_ELSEIF])) {
+            $nextIndex = $tokens->getNextMeaningfulToken($bodyEndIndex);
+
+            if (null !== $nextIndex && $tokens[$nextIndex]->isGivenKind([T_ELSEIF, T_ELSE])) {
+                $bodyEndIndex = $this->findControlStructureEnd($tokens, $nextIndex, $parentScopeEndIndex);
+            }
+        } elseif ($token->isGivenKind(T_DO)) {
+            $nextIndex = $tokens->getNextMeaningfulToken($bodyEndIndex);
+
+            if (null !== $nextIndex && $tokens[$nextIndex]->isGivenKind(T_WHILE)) {
+                $parenthesisStartIndex = $tokens->getNextMeaningfulToken($nextIndex);
+
+                if (null !== $parenthesisStartIndex && $tokens[$parenthesisStartIndex]->equals('(')) {
+                    $parenthesisEndIndex = $tokens->findBlockEnd(Tokens::BLOCK_TYPE_PARENTHESIS_BRACE, $parenthesisStartIndex);
+                    $semicolonIndex = $tokens->getNextMeaningfulToken($parenthesisEndIndex);
+
+                    if (null !== $semicolonIndex && $tokens[$semicolonIndex]->equals(';')) {
+                        $bodyEndIndex = $semicolonIndex;
+                    }
+                }
+            }
+        } elseif ($token->isGivenKind(T_TRY)) {
+            while (true) {
+                $nextIndex = $tokens->getNextMeaningfulToken($bodyEndIndex);
