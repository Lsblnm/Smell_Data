+                if (null === $nextIndex || !$tokens[$nextIndex]->isGivenKind([T_CATCH, T_FINALLY])) {
+                    break;
+                }
+
+                $bodyEndIndex = $this->findControlStructureEnd($tokens, $nextIndex, $parentScopeEndIndex);
+            }
+        }
+
+        return $bodyEndIndex;
+    }
