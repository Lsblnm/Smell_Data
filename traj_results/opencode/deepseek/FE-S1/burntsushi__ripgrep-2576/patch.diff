+/// Returns true if the given position is at the start of a line, according to
+/// the line anchor semantics implied by the given configuration.
+fn is_line_start(config: &Config, haystack: &[u8], at: usize) -> bool {
+    if at == 0 {
+        return true;
+    }
+    let prev = haystack[at - 1];
+    if config.crlf {
+        prev == b'\n'
+            || (prev == b'\r'
+                && (at >= haystack.len() || haystack[at] != b'\n'))
+    } else {
+        prev == b'\n'
+    }
+}
+
+/// Returns true if the given position is at the end of a line, according to
+/// the line anchor semantics implied by the given configuration.
+fn is_line_end(config: &Config, haystack: &[u8], at: usize) -> bool {
+    if at == haystack.len() {
+        return true;
+    }
+    let next = haystack[at];
+    if config.crlf {
+        next == b'\r'
+            || (next == b'\n' && (at == 0 || haystack[at - 1] != b'\r'))
+    } else {
+        next == b'\n'
+    }
+}
