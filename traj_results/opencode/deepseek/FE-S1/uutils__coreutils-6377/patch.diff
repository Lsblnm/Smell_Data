+fn parse_ignore_signals(matches: &clap::ArgMatches) -> UResult<(bool, Vec<usize>)> {
+    let mut ignore_all = false;
+    let mut signals = Vec::new();
+
+    if let Some(values) = matches.get_many::<OsString>("ignore-signal") {
+        for value in values {
+            if value.as_os_str() == OsStr::new(IGNORE_ALL_SIGNALS) {
+                ignore_all = true;
+                continue;
+            }
+
+            let value = value.to_string_lossy();
+            for signal_name in value.split(',') {
+                // An empty SIG argument is a no-op.
+                if signal_name.is_empty() {
+                    continue;
+                }
+
+                let signal_name_upper = signal_name.to_uppercase();
+                match signal_by_name_or_value(&signal_name_upper) {
+                    // Signal 0 (EXIT) cannot be ignored.
+                    Some(0) | None => {
+                        return Err(USimpleError::new(
+                            125,
+                            format!("{}: invalid signal", signal_name.quote()),
+                        ));
+                    }
+                    Some(signal) => signals.push(signal),
+                }
+            }
+        }
+    }
+
+    Ok((ignore_all, signals))
+}
+
+#[cfg(unix)]
+fn apply_ignore_signals(opts: &Options<'_>) -> UResult<()> {
+    let action = SigAction::new(SigHandler::SigIgn, SaFlags::empty(), SigSet::empty());
+
+    if opts.ignore_all_signals {
+        // Without an argument, reset all known signals. Some signals cannot be
+        // ignored, so errors are deliberately ignored in this case.
+        for signal in Signal::iterator() {
+            // The parent must still be able to wait for the command. SIGCHLD is
+            // ignored in the child instead (see run_program).
+            if signal == Signal::SIGCHLD {
+                continue;
+            }
+            let _ = unsafe { sigaction(signal, &action) };
+        }
+    }
+
+    for &signal_value in &opts.ignore_signals {
+        let Ok(signal) = Signal::try_from(signal_value as i32) else {
+            continue;
+        };
+
+        // The parent must still be able to wait for the command. SIGCHLD is
+        // ignored in the child instead (see run_program).
+        if signal == Signal::SIGCHLD {
+            continue;
+        }
+
+        if let Err(error) = unsafe { sigaction(signal, &action) } {
+            return Err(USimpleError::new(
+                125,
+                format!(
+                    "failed to set signal action for signal {}: {}",
+                    signal_value,
+                    error.desc()
+                ),
+            ));
+        }
+    }
+
+    Ok(())
+}
+
+#[cfg(not(unix))]
+fn apply_ignore_signals(_opts: &Options<'_>) -> UResult<()> {
+    Ok(())
+}
