 					}
 				}
+
+				addFirstTypeName(usedNames, Javac.getExtendsClause(td));
+				if (td.implementing != null) {
+					for (JCExpression superInterface : td.implementing) {
+						addFirstTypeName(usedNames, superInterface);
+					}
+				}
 			}
 
 			return usedNames;
 		}
+
+		private void addFirstTypeName(HashSet<String> usedNames, JCTree type) {
+			if (type == null) return;
+			if (type instanceof JCTypeApply) type = ((JCTypeApply) type).clazz;
+			while (type instanceof JCFieldAccess) type = ((JCFieldAccess) type).getExpression();
+			if (type instanceof JCIdent) usedNames.add(((JCIdent) type).getName().toString());
+		}
 	}
 	
