 	return t.wasQuoted > 0
 }
 
+// sameFile returns true if the token comes from the same file
+// as other and was expanded by the same chain of imports. Tokens
+// originating from different imports are treated as coming from
+// different files, even if they share the same source file, so
+// that line boundaries are still detected after an import.
+func (t Token) sameFile(other Token) bool {
+	if t.File != other.File {
+		return false
+	}
+	if len(t.imports) != len(other.imports) {
+		return false
+	}
+	for i := range t.imports {
+		if t.imports[i] != other.imports[i] {
+			return false
+		}
+	}
+	return true
+}
+
