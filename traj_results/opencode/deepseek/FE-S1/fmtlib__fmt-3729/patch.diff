-      debug_ = true;
-      ++it;
+    while (it != end) {
+      if (*it == '?') {
+        debug_ = true;
+        ++it;
+      } else if (*it == 'n' || *it == 'g') {
+        path_type_ = *it++;
+      } else {
+        break;
+      }
     }
     return it;
   }
@@ -108,6 +115,10 @@ template <typename Char> struct formatter<std::filesystem::path, Char> {
   auto format(const std::filesystem::path& p, FormatContext& ctx) const {
     int width = specs_.width;
     detail::handle_dynamic_spec<detail::width_checker>(width, width_ref_, ctx);
+    if (path_type_ == 'g') {
+      using path_char = std::filesystem::path::value_type;
+      return write_path(p, p.generic_string<path_char>(), width, ctx.out());
+    }
     return write_path(p, p.native(), width, ctx.out());
   }
 
