+    /**
+     * Serialize only the locale; loaders, formatters and catalogues may contain
+     * closures and can be rebuilt from the locale on unserialization.
+     *
+     * @return array
+     */
+    public function __serialize(): array
+    {
+        return [
+            'locale' => $this->getLocale(),
+        ];
+    }
+
+    /**
+     * Restore a translator from its serialized locale.
+     */
+    public function __unserialize(array $data): void
+    {
+        $locale = $data['locale'] ?? $data["\0".parent::class."\0locale"] ?? null;
+
+        $this->__construct($locale ?: 'en');
+    }
