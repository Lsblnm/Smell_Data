-        .unwrap_or(iter.range()),
+fn iter_source<'a>(checker: &'a Checker<'_>, iter: &Expr, stmt_for: &ast::StmtFor) -> Cow<'a, str> {
+    let range = parenthesized_range(
+        iter.into(),
+        stmt_for.into(),
+        checker.comment_ranges(),
+        checker.locator().contents(),
     )
+    .unwrap_or(iter.range());
+
+    let source = checker.locator().slice(range);
+    if iter
+        .as_tuple_expr()
+        .is_some_and(|tuple| !tuple.parenthesized)
+    {
+        Cow::Owned(format!("({source})"))
+    } else {
+        Cow::Borrowed(source)
+    }
 }
