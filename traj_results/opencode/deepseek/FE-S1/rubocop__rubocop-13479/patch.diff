diff --git a/lib/rubocop/cop/layout/leading_comment_space.rb b/lib/rubocop/cop/layout/leading_comment_space.rb
index 3550e2290..411194b86 100644
--- a/lib/rubocop/cop/layout/leading_comment_space.rb
+++ b/lib/rubocop/cop/layout/leading_comment_space.rb
@@ -107,7 +107,7 @@ module RuboCop
             next unless /\A(?!#\+\+|#--)(#+[^#\s=])/.match?(text)
 
             range = comment.source_range
-            next if range.line == 1 && allowed_on_first_line?(comment)
+            next if allowed_comment?(comment)
             next if allow_doxygen && text.start_with?('#*')
             next if allow_gemfile_ruby && File.basename(path).eql?('Gemfile') &&
                     text.start_with?('#ruby')
@@ -131,10 +131,24 @@ module RuboCop
 
         private
 
+        def allowed_comment?(comment)
+          return true if comment.loc.line == 1 && allowed_on_first_line?(comment)
+
+          multiline_shebang?(comment)
+        end
+
         def allowed_on_first_line?(comment)
           shebang?(comment) || (rackup_config_file? && rackup_options?(comment))
         end
 
+        def multiline_shebang?(comment)
+          comments = comments_before_code(processed_source)
+          first_comment = comments.first
+
+          first_comment&.loc&.line == 1 && shebang?(first_comment) &&
+            comments.take_while { |c| shebang?(c) }.include?(comment)
+        end
+
         def shebang?(comment)
           comment.text.start_with?('#!')
         end
