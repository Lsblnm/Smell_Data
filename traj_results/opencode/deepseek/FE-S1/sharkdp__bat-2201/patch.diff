+    fn paging_mode(matches: &ArgMatches) -> Option<String> {
+        let mut paging_arg: Option<(usize, &str)> = None;
+
+        if matches.occurrences_of("paging") > 0 {
+            if let (Some(index), Some(value)) = (
+                matches.indices_of("paging").and_then(|indices| indices.max()),
