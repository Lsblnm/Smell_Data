+                paging_arg = Some((index, "never"));
+            }
+        }
+
+        if matches.occurrences_of("plain") > 1 {
+            if let Some(index) = matches.indices_of("plain").and_then(|indices| indices.max()) {
+                if paging_arg.map_or(true, |(last_index, _)| index > last_index) {
+                    paging_arg = Some((index, "never"));
+                }
+            }
+        }
+
+        paging_arg.map(|(_, value)| value.to_owned())
+    }
