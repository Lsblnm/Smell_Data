+    pub(super) fn merge_nested_fallbacks(
+        &mut self,
+        other: Self,
+        overwrite: bool,
+    ) -> Result<(), Cow<'static, str>> {
+        let PathRouter {
+            routes,
+            node,
+            prev_route_id: _,
+        } = other;
+
+        for (id, endpoint) in routes {
+            let path = node
+                .route_id_to_path
+                .get(&id)
+                .expect("no path for route id. This is a bug in axum. Please file an issue");
+
+            // The root fallback is handled separately so only merge fallbacks for nested routers.
+            if &**path == "/" || &**path == FALLBACK_PARAM_CAPTURE {
+                continue;
+            }
+
+            if let Some(existing_id) = self.node.path_to_route_id.get(&**path).copied() {
+                if overwrite {
+                    self.routes.insert(existing_id, endpoint);
+                }
+            } else {
+                self.route_endpoint(path, endpoint)?;
+            }
+        }
+
+        Ok(())
+    }
