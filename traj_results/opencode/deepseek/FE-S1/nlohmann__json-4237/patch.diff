diff --git a/include/nlohmann/detail/conversions/to_json.hpp b/include/nlohmann/detail/conversions/to_json.hpp
index b2f06108..ee5c3e1c 100644
--- a/include/nlohmann/detail/conversions/to_json.hpp
+++ b/include/nlohmann/detail/conversions/to_json.hpp
@@ -380,7 +380,10 @@ template<typename BasicJsonType, typename EnumType,
 inline void to_json(BasicJsonType& j, EnumType e) noexcept
 {
     using underlying_type = typename std::underlying_type<EnumType>::type;
-    integral_constructor<BasicJsonType>{}.construct(j, static_cast<underlying_type>(e));
+    constexpr auto target_type = std::is_signed<underlying_type>::value
+                                 ? value_t::number_integer
+                                 : value_t::number_unsigned;
+    integral_constructor<BasicJsonType>{target_type}.construct(j, static_cast<underlying_type>(e));
 }
 #endif  // JSON_DISABLE_ENUM_SERIALIZATION
 
