+function toNodeStream(source) {
+  if (stream.Readable.fromWeb) {
+    try {
+      return stream.Readable.fromWeb(source);
+    } catch (e) {
+      // Not a native web stream, fall back to iterating the source
+    }
+  }
+
+  return stream.Readable.from(source);
+}
+
+function blobToStream(blob) {
+  if (utils.isFunction(blob.stream)) {
+    return toNodeStream(blob.stream());
+  }
+
+  let started;
+
+  return new stream.Readable({
+    read() {
+      if (started) return;
+
+      started = true;
+
+      blob.arrayBuffer().then(buffer => {
+        this.push(Buffer.from(buffer));
+        this.push(null);
+      }, err => this.destroy(err));
+    }
+  });
+}
+
+function formDataToStream(formData) {
+  const form = new platform.classes.FormData();
+  const entries = utils.isFunction(formData.entries) ? formData.entries() : formData;
+
+  for (const [key, value] of entries) {
+    if (utils.isBlob(value) || utils.isFile(value)) {
+      form.append(key, blobToStream(value), {
+        filename: value.name || 'blob',
+        contentType: value.type || 'application/octet-stream',
+        knownLength: value.size
+      });
+    } else {
+      form.append(key, value);
+    }
+  }
+
+  return form;
+}
