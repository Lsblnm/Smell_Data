diff --git a/lib/rubocop/cop/style/guard_clause.rb b/lib/rubocop/cop/style/guard_clause.rb
index 3b12d5a48..9ed93a7d7 100644
--- a/lib/rubocop/cop/style/guard_clause.rb
+++ b/lib/rubocop/cop/style/guard_clause.rb
@@ -193,6 +193,25 @@ module RuboCop
 
         private
 
+        def assigned_variables_used_in_branches?(node)
+          variables = assigned_variables(node.condition)
+          return false if variables.empty?
+
+          node.branches.any? do |branch|
+            next false unless branch
+
+            branch.each_descendant(:lvar).any? do |lvar|
+              variables.include?(lvar.children.first)
+            end
+          end
+        end
+
+        def assigned_variables(condition)
+          assignments = condition.each_descendant(:lvasgn).to_a
+          assignments << condition if condition.lvasgn_type?
+          assignments.map { |assignment| assignment.children.first }
+        end
+
         def check_ending_body(body)
           return if body.nil?
 
@@ -310,7 +329,10 @@ module RuboCop
         end
 
         def accepted_form?(node, ending: false)
-          accepted_if?(node, ending) || node.condition.multiline? || node.parent&.assignment?
+          accepted_if?(node, ending) ||
+            node.condition.multiline? ||
+            node.parent&.assignment? ||
+            assigned_variables_used_in_branches?(node)
         end
 
         def trivial?(node)
