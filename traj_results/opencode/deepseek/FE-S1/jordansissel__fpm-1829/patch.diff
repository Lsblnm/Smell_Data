diff --git a/lib/fpm/util/tar_writer.rb b/lib/fpm/util/tar_writer.rb
index be11ef5..6b36a87 100644
--- a/lib/fpm/util/tar_writer.rb
+++ b/lib/fpm/util/tar_writer.rb
@@ -123,6 +123,18 @@ class FPM::Util::TarWriter < ::Gem::Package::TarWriter
       logger.warn("Replacing 'provides' entry #{provides} with syntax 'name (= version)'")
       provides = "#{m[1]} (= #{m[2]})"
     end
+
+    valid_provides = /^[a-z0-9][a-z0-9+.-]*$/
+    valid_versioned_provides = /^[a-z0-9][a-z0-9+.-]* \(= [0-9][A-Za-z0-9.+:~_-]*\)$/
+    unless provides =~ valid_provides || provides =~ valid_versioned_provides
+      message = "Invalid 'provides' entry #{provides.inspect}. Debian packages " \
+                "only support versioned provides with an exact '=' version."
+      logger.error(message,
+                   :provides => provides,
+                   :name => package.name,
+                   :error_class => FPM::InvalidPackageConfiguration)
+      raise FPM::InvalidPackageConfiguration, message
+    end
     return provides.rstrip
   end
 end
