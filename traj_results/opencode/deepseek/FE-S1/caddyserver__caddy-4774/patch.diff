+func parseOptMultipleStrings(d *caddyfile.Dispenser, existing interface{}) (interface{}, error) {
+	var vals []string
+	if existing != nil {
+		var ok bool
+		vals, ok = existing.([]string)
+		if !ok {
+			return nil, d.Errf("unexpected existing value of type %T", existing)
+		}
+	}
+	for d.Next() {
+		args := d.RemainingArgs()
+		if len(args) == 0 {
+			return nil, d.ArgErr()
+		}
+		vals = append(vals, args...)
+	}
+	return vals, nil
+}
