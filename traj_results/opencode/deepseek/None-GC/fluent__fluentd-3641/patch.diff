 module Fluent
   module RPC
     class Server
+      HOSTNAME_PATTERN = /\A[a-zA-Z0-9](?:[a-zA-Z0-9.-]*[a-zA-Z0-9])?\z/
+
       def initialize(endpoint, log)
-        bind, port = endpoint.split(':')
