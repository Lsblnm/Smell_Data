         @server = WEBrick::HTTPServer.new(
           BindAddress: @bind,
@@ -89,6 +93,54 @@ module Fluent
           @thread = nil
         end
       end
+
+      private
+
+      def parse_endpoint(endpoint)
+        if /\A\[(.+)\]:(\d+)\z/ =~ endpoint
+          bind = $1
+          port = $2
+          begin
+            address = IPAddr.new(bind)
+            raise ArgumentError unless address.ipv6?
+          rescue ArgumentError, IPAddr::InvalidAddressError
+            raise Fluent::ConfigError, "Invalid rpc_endpoint: #{endpoint}"
+          end
+        elsif /\A([^:\[\]]+):(\d+)\z/ =~ endpoint
+          bind = $1
+          port = $2
+          if /\A[0-9.]+\z/ =~ bind
+            begin
+              address = IPAddr.new(bind)
+              raise ArgumentError unless address.ipv4?
+            rescue ArgumentError, IPAddr::InvalidAddressError
+              raise Fluent::ConfigError, "Invalid rpc_endpoint: #{endpoint}"
+            end
+          elsif HOSTNAME_PATTERN =~ bind
+            bind = resolve_address(bind, port, endpoint)
+          else
+            raise Fluent::ConfigError, "Invalid rpc_endpoint: #{endpoint}"
+          end
+        else
+          raise Fluent::ConfigError, "Invalid rpc_endpoint: #{endpoint}"
+        end
+
+        port = port.to_i
+        unless port.between?(1, 65535)
+          raise Fluent::ConfigError, "Invalid rpc_endpoint: #{endpoint}"
+        end
+
+        [bind, port]
+      end
+
+      def resolve_address(host, port, endpoint)
+        addrinfos = Addrinfo.getaddrinfo(host, port.to_i, nil, :STREAM)
+        address = addrinfos.find(&:ipv4?) || addrinfos.first
+        raise Fluent::ConfigError, "Invalid rpc_endpoint: #{endpoint}" unless address
+        address.ip_address
+      rescue SocketError
+        raise Fluent::ConfigError, "Invalid rpc_endpoint: #{endpoint}"
+      end
     end
   end
 end
