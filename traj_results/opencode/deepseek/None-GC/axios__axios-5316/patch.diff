diff --git a/lib/helpers/formDataToStream.js b/lib/helpers/formDataToStream.js
new file mode 100644
index 0000000..57b6b15
--- /dev/null
+++ b/lib/helpers/formDataToStream.js
@@ -0,0 +1,175 @@
+import {Readable} from 'stream';
+import utils from '../utils.js';
+import readBlob from './readBlob.js';
+
+const CRLF = '\r\n';
+const textEncoder = new TextEncoder();
+const boundaryAlphabet = '0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ-_';
+
+function generateString(size) {
+  let result = '';
+
+  for (let i = 0; i < size; i++) {
+    result += boundaryAlphabet[Math.floor(Math.random() * boundaryAlphabet.length)];
+  }
+
+  return result;
+}
+
+function escapeName(name) {
+  return String(name)
+    .replace(/\r/g, '%0D')
+    .replace(/\n/g, '%0A')
+    .replace(/"/g, '%22');
+}
+
+class FormDataPart {
+  constructor(name, value) {
+    const isStringValue = utils.isString(value);
+
+    let headers = `Content-Disposition: form-data; name="${escapeName(name)}"${
+      !isStringValue && value.name ? `; filename="${escapeName(value.name)}"` : ''
+    }${CRLF}`;
+
+    if (isStringValue) {
+      value = textEncoder.encode(String(value).replace(/\r?\n|\r\n?/g, CRLF));
+    } else {
+      headers += `Content-Type: ${value.type || 'application/octet-stream'}${CRLF}`;
+    }
+
+    this.headers = textEncoder.encode(headers + CRLF);
+    this.contentLength = isStringValue ? value.byteLength : value.size;
+    this.size = this.headers.byteLength + this.contentLength + CRLF.length;
+    this.name = name;
+    this.value = value;
+  }
+
+  encode() {
+    const self = this;
+
+    return {
+      [Symbol.asyncIterator]() {
+        let stage = 0;
+        let iterator;
+
+        return {
+          async next() {
+            for (;;) {
+              if (stage === 0) {
+                stage = 1;
+                return {done: false, value: self.headers};
+              }
+
+              if (stage === 1) {
+                if (utils.isTypedArray(self.value)) {
+                  stage = 2;
+                  return {done: false, value: self.value};
+                }
+
+                if (!iterator) {
+                  iterator = readBlob(self.value)[Symbol.asyncIterator]();
+                }
+
+                const result = await iterator.next();
+
+                if (result.done) {
+                  stage = 2;
+                  continue;
+                }
+
+                return result;
+              }
+
+              if (stage === 2) {
+                stage = 3;
+                return {done: false, value: textEncoder.encode(CRLF)};
+              }
+
+              return {done: true, value: undefined};
+            }
+          }
+        };
+      }
+    };
+  }
+}
+
+function createFormDataIterator(parts, boundaryBytes, footerBytes) {
+  return {
+    [Symbol.asyncIterator]() {
+      let partIndex = 0;
+      let stage = 0;
+      let iterator;
+
+      return {
+        async next() {
+          for (;;) {
+            if (stage === 0) {
+              if (partIndex >= parts.length) {
+                stage = 2;
+                continue;
+              }
+
+              stage = 1;
+              return {done: false, value: boundaryBytes};
+            }
+
+            if (stage === 1) {
+              if (!iterator) {
+                iterator = parts[partIndex].encode()[Symbol.asyncIterator]();
+              }
+
+              const result = await iterator.next();
+
+              if (result.done) {
+                iterator = undefined;
+                partIndex++;
+                stage = 0;
+                continue;
+              }
+
+              return result;
+            }
+
+            if (stage === 2) {
+              stage = 3;
+              return {done: false, value: footerBytes};
+            }
+
+            return {done: true, value: undefined};
+          }
+        }
+      };
+    }
+  };
+}
+
+export default function formDataToStream(formData, headers, options = {}) {
+  if (!utils.isFormData(formData)) {
+    throw new TypeError('FormData instance required');
+  }
+
+  const boundary = options.boundary || ('AxiosFormBoundary-' + generateString(25));
+  const boundaryBytes = textEncoder.encode('--' + boundary + CRLF);
+  const footerBytes = textEncoder.encode('--' + boundary + '--' + CRLF);
+  const parts = [];
+
+  let contentLength = footerBytes.byteLength;
+
+  for (const [name, value] of formData.entries()) {
+    const part = new FormDataPart(name, value);
+
+    parts.push(part);
+    contentLength += part.size;
+  }
+
+  contentLength += boundaryBytes.byteLength * parts.length;
+
+  headers.set('Content-Type', `multipart/form-data; boundary=${boundary}`);
+
+  if (Number.isFinite(contentLength)) {
+    headers.set('Content-Length', contentLength, false);
+  }
+
+  return Readable.from(createFormDataIterator(parts, boundaryBytes, footerBytes));
+}
diff --git a/lib/helpers/readBlob.js b/lib/helpers/readBlob.js
new file mode 100644
index 0000000..0411df4
--- /dev/null
+++ b/lib/helpers/readBlob.js
@@ -0,0 +1,64 @@
+function createBlobIterator(blob) {
+  const blobStream = typeof blob.stream === 'function' ? blob.stream() : null;
+
+  if (blobStream) {
+    if (typeof blobStream.getReader === 'function') {
+      return {
+        [Symbol.asyncIterator]() {
+          const reader = blobStream.getReader();
+          let finished = false;
+
+          return {
+            async next() {
+              if (finished) {
+                return {done: true, value: undefined};
+              }
+
+              const {done, value} = await reader.read();
+
+              if (done) {
+                finished = true;
+                reader.releaseLock();
+                return {done: true, value: undefined};
+              }
+
+              return {done: false, value};
+            },
+            async return() {
+              if (!finished) {
+                finished = true;
+                reader.releaseLock();
+              }
+
+              return {done: true, value: undefined};
+            }
+          };
+        }
+      };
+    }
+
+    if (typeof blobStream[Symbol.asyncIterator] === 'function') {
+      return blobStream;
+    }
+  }
+
+  return {
+    [Symbol.asyncIterator]() {
+      let finished = false;
+
+      return {
+        async next() {
+          if (finished) {
+            return {done: true, value: undefined};
+          }
+
+          finished = true;
+
+          return {done: false, value: Buffer.from(await blob.arrayBuffer())};
+        }
+      };
+    }
+  };
+}
+
+export default createBlobIterator;
