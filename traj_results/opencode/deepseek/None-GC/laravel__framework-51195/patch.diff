+    /**
+     * Get the whitespace that should follow a compiled echo.
+     *
+     * @param  array  $matches
+     * @return string
+     */
+    protected function getEchoWhitespace($matches)
+    {
+        $whitespace = empty($matches[3]) ? '' : $matches[3].$matches[3];
+
+        if (! empty($matches[4]) && isset($matches[5])) {
+            $rawBlock = $this->rawBlocks[(int) $matches[5]] ?? '';
+
+            if (str_starts_with($rawBlock, "\r\n")) {
+                $whitespace = $matches[3] ?: "\r\n";
+            } elseif (str_starts_with($rawBlock, "\n")) {
+                $whitespace = $matches[3] ?: "\n";
+            }
+        }
+
+        return $whitespace;
+    }
