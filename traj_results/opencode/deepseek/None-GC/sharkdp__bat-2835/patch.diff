+
+    fn print_header_component(
+        &mut self,
+        handle: &mut OutputHandle,
+        text: &str,
+        styled_start: usize,
+        styled_end: usize,
+    ) -> Result<()> {
+        let indent_width = self.panel_width
+            + if self.config.style_components.grid() && self.panel_width > 0 {
+                2
+            } else {
+                0
+            };
+        let max_width = self.config.term_width.saturating_sub(indent_width).max(1);
+
+        let mut line_start = 0;
+        let mut line_width = 0;
+
+        for (index, character) in text.char_indices() {
+            let character_width = UnicodeWidthChar::width(character).unwrap_or(0);
+
+            if line_width + character_width > max_width && index > line_start {
+                self.print_header_component_line(
+                    handle,
+                    text,
+                    line_start,
+                    index,
+                    styled_start,
+                    styled_end,
+                )?;
+                line_start = index;
+                line_width = 0;
+            }
+
+            line_width += character_width;
+        }
+
+        self.print_header_component_line(
+            handle,
+            text,
+            line_start,
+            text.len(),
+            styled_start,
+            styled_end,
+        )
+    }
+
+    fn print_header_component_line(
+        &mut self,
+        handle: &mut OutputHandle,
+        text: &str,
+        start: usize,
+        end: usize,
+        styled_start: usize,
+        styled_end: usize,
+    ) -> Result<()> {
+        self.print_header_component_indent(handle)?;
+
+        let style_start = styled_start.max(start);
+        let style_end = styled_end.min(end);
+
+        if style_start >= style_end {
+            write!(handle, "{}", &text[start..end])?;
+        } else {
+            write!(handle, "{}", &text[start..style_start])?;
+            write!(
+                handle,
+                "{}",
+                self.colors
+                    .header_value
+                    .paint(&text[style_start..style_end])
+            )?;
+            write!(handle, "{}", &text[style_end..end])?;
+        }
+
+        writeln!(handle)?;
+        Ok(())
+    }
 }
 
