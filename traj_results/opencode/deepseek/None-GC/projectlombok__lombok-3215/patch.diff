+	private void addUsedTypeName(java.util.Set<String> usedNames, JCTree type) {
+		if (type == null) return;
+		if (JCAnnotatedTypeReflect.is(type)) type = JCAnnotatedTypeReflect.getUnderlyingType(type);
+		if (type instanceof JCTypeApply) {
+			addUsedTypeName(usedNames, ((JCTypeApply) type).clazz);
+		} else if (type instanceof JCFieldAccess) {
+			addUsedTypeName(usedNames, ((JCFieldAccess) type).selected);
+		} else if (type instanceof JCIdent) {
+			usedNames.add(((JCIdent) type).name.toString());
+		}
+	}
