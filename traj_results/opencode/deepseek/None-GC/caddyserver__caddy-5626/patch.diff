-	return curr.Line+curr.NumLineBreaks() < next.Line
+// sameLine returns true if the two tokens are on the same line
+// in the same file and share the same import chain. Tokens that
+// come from different imports (even if their source line numbers
+// happen to match) are never considered to be on the same line.
+func sameLine(a, b Token) bool {
+	if a.File != b.File {
+		return false
+	}
+	if len(a.imports) != len(b.imports) {
+		return false
+	}
+	for i := range a.imports {
+		if a.imports[i] != b.imports[i] {
+			return false
+		}
+	}
+	return a.Line+a.NumLineBreaks() == b.Line
 }
