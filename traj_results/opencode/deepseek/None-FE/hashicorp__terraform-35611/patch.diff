+
+// findRemovedConfig searches the configuration tree for a "removed" block
+// targeting the given resource. The search is performed from the root outwards
+// so that, in the case of more than one removed block targeting the same
+// resource, the one in the ancestor module takes precedence.
+func (t *AttachResourceConfigTransformer) findRemovedConfig(addr addrs.ConfigResource) *configs.Removed {
+	return findRemovedConfig(t.Config, addr)
+}
+
+func findRemovedConfig(config *configs.Config, addr addrs.ConfigResource) *configs.Removed {
+	for _, r := range config.Module.Removed {
+		crAddr, ok := r.From.RelSubject.(addrs.ConfigResource)
+		if !ok {
+			// Not for a resource at all, so can't possibly match
+			continue
+		}
+
+		// The address in a removed block is relative to the module where it
+		// is declared, so we need to combine it with the module path to get
+		// the absolute address of the target.
+		targetAddr := addrs.ConfigResource{
+			Module:   make(addrs.Module, 0, len(config.Path)+len(crAddr.Module)),
+			Resource: crAddr.Resource,
+		}
+		targetAddr.Module = append(targetAddr.Module, config.Path...)
+		targetAddr.Module = append(targetAddr.Module, crAddr.Module...)
+
+		if targetAddr.Equal(addr) {
+			return r
+		}
+	}
+
+	for _, child := range config.Children {
+		if r := findRemovedConfig(child, addr); r != nil {
+			return r
+		}
+	}
+
+	return nil
+}
