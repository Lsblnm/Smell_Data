diff --git a/src/syntax_mapping/ignored_suffixes.rs b/src/syntax_mapping/ignored_suffixes.rs
new file mode 100644
index 00000000..6d5aa017
--- /dev/null
+++ b/src/syntax_mapping/ignored_suffixes.rs
@@ -0,0 +1,122 @@
+use std::ffi::OsStr;
+use std::path::Path;
+
+use crate::error::*;
+
+const IGNORED_SUFFIXES: [&str; 13] = [
+    // Editor etc backups
+    "~",
+    ".bak",
+    ".old",
+    ".orig",
+    // Debian and derivatives apt/dpkg/ucf backups
+    ".dpkg-dist",
+    ".dpkg-old",
+    ".ucf-dist",
+    ".ucf-new",
+    ".ucf-old",
+    // Red Hat and derivatives rpm backups
+    ".rpmnew",
+    ".rpmorig",
+    ".rpmsave",
+    // Build system input/template files
+    ".in",
+];
+
+/// A list of file name suffixes that should be ignored when detecting the
+/// syntax of a file. In addition to the built-in suffixes, custom suffixes can
+/// be added, for example from the command line.
+#[derive(Debug, Clone)]
+pub struct IgnoredSuffixes<'a> {
+    pub values: Vec<&'a str>,
+}
+
+impl<'a> Default for IgnoredSuffixes<'a> {
+    fn default() -> Self {
+        Self {
+            values: Self::builtin_ignored_suffix_list().to_vec(),
+        }
+    }
+}
+
+impl<'a> IgnoredSuffixes<'a> {
+    pub(crate) fn builtin_ignored_suffix_list() -> &'static [&'static str] {
+        &IGNORED_SUFFIXES
+    }
+
+    /// Add a suffix that should be ignored when detecting the syntax of a
+    /// file. The suffix is matched at the end of the file name, so it should
+    /// typically start with a dot (e.g. `.production`).
+    pub fn add_suffix(&mut self, suffix: &'a str) {
+        if !suffix.is_empty() {
+            self.values.push(suffix);
+        }
+    }
+
+    /// If the given file name ends in one of the ignored suffixes, return the
+    /// file name with that suffix removed. If several suffixes match, the
+    /// longest one is removed.
+    pub fn strip_suffix<'b>(&self, file_name: &'b str) -> Option<&'b str> {
+        self.values
+            .iter()
+            .filter(|suffix| !suffix.is_empty())
+            .filter_map(|suffix| {
+                file_name
+                    .strip_suffix(*suffix)
+                    .map(|stripped| (suffix.len(), stripped))
+            })
+            .max_by_key(|(length, _)| *length)
+            .map(|(_, stripped)| stripped)
+    }
+}
+
+/// If we find an ignored suffix on the file name, e.g. '~', we strip it and
+/// then try again without it.
+pub fn try_with_stripped_suffix<T, F>(
+    file_name: &OsStr,
+    ignored_suffixes: &IgnoredSuffixes,
+    func: F,
+) -> Result<Option<T>>
+where
+    F: Fn(&OsStr) -> Result<Option<T>>,
+{
+    let mut from_stripped = None;
+    if let Some(file_str) = Path::new(file_name).to_str() {
+        if let Some(stripped_filename) = ignored_suffixes.strip_suffix(file_str) {
+            from_stripped = func(OsStr::new(stripped_filename))?;
+        }
+    }
+    Ok(from_stripped)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn builtin_suffixes_are_ignored() {
+        let suffixes = IgnoredSuffixes::default();
+        assert_eq!(suffixes.strip_suffix("test.rs~"), Some("test.rs"));
+        assert_eq!(suffixes.strip_suffix("test.rs.bak"), Some("test.rs"));
+        assert_eq!(suffixes.strip_suffix("test.rs"), None);
+    }
+
+    #[test]
+    fn custom_suffixes_are_ignored() {
+        let mut suffixes = IgnoredSuffixes::default();
+        suffixes.add_suffix(".production");
+        assert_eq!(
+            suffixes.strip_suffix("config.json.production"),
+            Some("config.json")
+        );
+        assert_eq!(suffixes.strip_suffix("config.json"), None);
+    }
+
+    #[test]
+    fn longest_matching_suffix_is_stripped() {
+        let mut suffixes = IgnoredSuffixes::default();
+        suffixes.add_suffix(".suffix");
+        suffixes.add_suffix("json.suffix");
+        assert_eq!(suffixes.strip_suffix("test.json.suffix"), Some("test."));
+    }
+}
