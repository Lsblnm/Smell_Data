+#[cfg(unix)]
+fn parse_ignore_signal(arg: &OsStr) -> UResult<Vec<Signal>> {
+    let arg = arg.to_string_lossy();
+    let mut signals = Vec::new();
+
+    for name in arg.split(',') {
+        if name.is_empty() {
+            continue;
+        }
+
+        let signal_value = signal_by_name_or_value(&name.to_uppercase())
+            .filter(|&value| value != 0)
+            .ok_or_else(|| USimpleError::new(125, format!("{}: invalid signal", name.quote())))?;
+
+        let signal = Signal::try_from(signal_value as i32)
+            .map_err(|_| USimpleError::new(125, format!("{}: invalid signal", name.quote())))?;
+
+        signals.push(signal);
+    }
+
+    Ok(signals)
+}
+
+#[cfg(unix)]
+fn parse_ignore_signals(matches: &clap::ArgMatches) -> UResult<Vec<(Signal, bool)>> {
+    let mut signals = Vec::new();
+
+    if let Some(occurrences) = matches.get_occurrences::<OsString>("ignore-signal") {
+        for occurrence in occurrences {
+            let values: Vec<&OsString> = occurrence.collect();
+            if values.is_empty() {
+                for value in 1..uucore::signals::ALL_SIGNALS.len() {
+                    if let Ok(signal) = Signal::try_from(value as i32) {
+                        signals.push((signal, true));
+                    }
+                }
+            } else {
+                for value in values {
+                    for signal in parse_ignore_signal(value)? {
+                        signals.push((signal, false));
+                    }
+                }
+            }
+        }
+    }
+
+    Ok(signals)
+}
+
+#[cfg(unix)]
+fn set_ignore_signal(signal: Signal) -> Result<SigAction, nix::errno::Errno> {
+    let action = SigAction::new(SigHandler::SigIgn, SaFlags::empty(), SigSet::empty());
+    unsafe { sigaction(signal, &action) }
+}
+
+#[cfg(unix)]
+fn apply_ignore_signals(opts: &Options<'_>) -> UResult<()> {
+    for &(signal, ignore_errors) in &opts.ignore_signals {
+        if signal == Signal::SIGCHLD {
+            continue;
+        }
+
+        if let Err(error) = set_ignore_signal(signal) {
+            if !ignore_errors {
+                return Err(USimpleError::new(
+                    125,
+                    format!(
+                        "failed to set signal action for signal {}: {}",
+                        signal as i32,
+                        error.desc()
+                    ),
+                ));
+            }
+        }
+    }
+
+    Ok(())
+}
