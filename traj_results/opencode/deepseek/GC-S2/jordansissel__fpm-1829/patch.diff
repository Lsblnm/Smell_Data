diff --git a/lib/fpm/package/deb.rb b/lib/fpm/package/deb.rb
index 8ce1e13..7b9c41e 100644
--- a/lib/fpm/package/deb.rb
+++ b/lib/fpm/package/deb.rb
@@ -793,7 +793,22 @@ class FPM::Package::Deb < FPM::Package
       logger.warn("Replacing 'provides' entry #{provides} with syntax 'name (= version)'")
       provides = "#{m[1]} (= #{m[2]})"
     end
-    return provides.rstrip
+
+    provides = provides.rstrip
+    # Debian policy only allows exact version relationships in Provides.
+    # See https://www.debian.org/doc/debian-policy/ch-relationships.html
+    if !(m = provides.match(/\A([A-Za-z0-9][A-Za-z0-9+.-]*)(?:\s+\(=\s*([^)]+)\))?\z/))
+      raise FPM::InvalidPackageConfiguration,
+        "Invalid 'provides' entry '#{provides}'. Expected 'name' or 'name (= version)'."
+    end
+
+    if m[2] && m[2] !~ /\A[0-9][A-Za-z0-9.+:~-]*\z/
+      raise FPM::InvalidPackageConfiguration,
+        "Invalid version in 'provides' entry '#{provides}'. " \
+        "Debian version strings must start with a digit."
+    end
+
+    return provides
   end
 
   def control_path(path=nil)
