diff --git a/lib/rubocop/cop/style/redundant_parentheses.rb b/lib/rubocop/cop/style/redundant_parentheses.rb
index 7ad1feb8f..96b9aa3e8 100644
--- a/lib/rubocop/cop/style/redundant_parentheses.rb
+++ b/lib/rubocop/cop/style/redundant_parentheses.rb
@@ -62,9 +62,22 @@ module RuboCop
             allowed_method_call?(node) ||
             allowed_multiple_expression?(node) ||
             allowed_ternary?(node) ||
+            allowed_keyword_block?(node) ||
             node.parent&.range_type?
         end
 
+        def allowed_keyword_block?(node)
+          keyword_block_in_call_chain?(node.children.first)
+        end
+
+        def keyword_block_in_call_chain?(node)
+          return false if node.nil?
+          return node.keywords? && !node.send_node.lambda_literal? if node.any_block_type?
+          return false unless node.call_type?
+
+          keyword_block_in_call_chain?(node.children.first)
+        end
+
         def allowed_ancestor?(node)
           # Don't flag `break(1)`, etc
           keyword_ancestor?(node) && parens_required?(node)
