+func parseOptDefaultBind(d *caddyfile.Dispenser, _ interface{}) (interface{}, error) {
+	var bindAddrs []string
+	for d.Next() {
+		bindAddrs = append(bindAddrs, d.RemainingArgs()...)
+	}
+	if len(bindAddrs) == 0 {
+		return nil, d.ArgErr()
+	}
+	return bindAddrs, nil
+}
