diff --git a/src/main.c b/src/main.c
index 262cbeb..ecc2dc4 100644
--- a/src/main.c
+++ b/src/main.c
@@ -1331,6 +1331,7 @@ void jq_runtime_prepare_cli(jq_runtime *self) {
 static void jq_runtime_configure_output(jq_runtime *self) {
   int dumpopts = self->dumpopts;
   int options = self->cli_options;
+  const char *no_color = getenv("NO_COLOR");
 #ifdef USE_ISATTY
   if (isatty(STDOUT_FILENO)) {
 #ifndef WIN32
@@ -1354,6 +1355,9 @@ static void jq_runtime_configure_output(jq_runtime *self) {
   if (options & ASCII_OUTPUT) dumpopts |= JV_PRINT_ASCII;
   if (options & COLOR_OUTPUT) dumpopts |= JV_PRINT_COLOR;
