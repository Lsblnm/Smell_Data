+// removedResourceConfigs returns all of the resource-targeting removed blocks
+// in the configuration tree, keyed by their absolute configuration addresses.
+func (t *AttachResourceConfigTransformer) removedResourceConfigs() addrs.Map[addrs.ConfigResource, *configs.Removed] {
+	ret := addrs.MakeMap[addrs.ConfigResource, *configs.Removed]()
+	if t.Config != nil {
+		t.collectRemovedResourceConfigs(t.Config, ret)
+	}
+	return ret
+}
+
+func (t *AttachResourceConfigTransformer) collectRemovedResourceConfigs(cfg *configs.Config, into addrs.Map[addrs.ConfigResource, *configs.Removed]) {
+	if cfg == nil {
+		return
+	}
+
+	if cfg.Module != nil {
+		for _, r := range cfg.Module.Removed {
+			crAddr, ok := r.From.RelSubject.(addrs.ConfigResource)
+			if !ok {
+				// Not for a resource at all, so can't possibly match
+				continue
+			}
+
+			module := make(addrs.Module, 0, len(cfg.Path)+len(crAddr.Module))
+			module = append(module, cfg.Path...)
+			module = append(module, crAddr.Module...)
+			addr := addrs.ConfigResource{
+				Module:   module,
+				Resource: crAddr.Resource,
+			}
+
+			// A removed block in a parent module takes precedence over one in
+			// a child module, so we deliberately don't overwrite an entry we
+			// already found while walking from the root down.
+			if _, exists := into.GetOk(addr); exists {
+				continue
+			}
+			into.Put(addr, r)
+		}
+	}
+
+	for _, child := range cfg.Children {
+		t.collectRemovedResourceConfigs(child, into)
+	}
+}
