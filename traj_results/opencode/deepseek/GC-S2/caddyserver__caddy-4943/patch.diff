@@ -584,6 +584,25 @@ func (m *CookieFilter) UnmarshalCaddyfile(d *caddyfile.Dispenser) error {
 
 // Filter filters the input field.
 func (m CookieFilter) Filter(in zapcore.Field) zapcore.Field {
+	// HTTP headers are logged as arrays of strings, so filter the
+	// values in the interface field rather than the string field.
+	if values, ok := m.cookieHeaderValues(in.Interface); ok {
+		originRequest := http.Request{Header: http.Header{"Cookie": values}}
+		cookies := originRequest.Cookies()
+		transformedRequest := http.Request{Header: make(http.Header)}
+
+		for _, c := range cookies {
+			next, keep := m.applyCookieFilterAction(c)
+			if !keep {
+				continue
+			}
+			transformedRequest.AddCookie(next)
+		}
+
+		in.Interface = m.cookieHeaderResult(in.Interface, transformedRequest.Header["Cookie"])
+		return in
+	}
+
 	m.hydrateAccessLogContext(in.String)
 	originRequest := http.Request{Header: http.Header{"Cookie": []string{in.String}}}
 	cookies := originRequest.Cookies()
