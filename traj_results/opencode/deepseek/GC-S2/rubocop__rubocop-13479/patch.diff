diff --git a/lib/rubocop/cop/layout/leading_comment_space.rb b/lib/rubocop/cop/layout/leading_comment_space.rb
index 247c685cb..03b31f239 100644
--- a/lib/rubocop/cop/layout/leading_comment_space.rb
+++ b/lib/rubocop/cop/layout/leading_comment_space.rb
@@ -105,6 +105,7 @@ module RuboCop
           processed_source.comments.each do |comment|
             next unless /\A(?!#\+\+|#--)(#+[^#\s=])/.match?(comment.text)
             next if comment.loc.line == 1 && allowed_on_first_line?(comment)
+            next if multiline_shebang?(comment)
             next if doxygen_comment_style?(comment)
             next if gemfile_ruby_comment?(comment)
             next if rbs_inline_annotation?(comment)
@@ -1303,6 +1304,27 @@ module RuboCop
           comment.text.start_with?('#!')
         end
 
+        def multiline_shebang?(comment)
+          return false unless shebang?(comment)
+
+          comments = processed_source.comments
+          index = comments.index(comment)
+          return false unless index
+
+          preceding_comments = comments[0...index]
+          return false if preceding_comments.empty?
+
+          expected_line = 1
+          preceding_comments.each do |preceding_comment|
+            return false unless preceding_comment.loc.line == expected_line
+            return false unless shebang?(preceding_comment)
+
+            expected_line += 1
+          end
+
+          expected_line == comment.loc.line
+        end
+
         def rackup_options?(comment)
           comment.text.start_with?('#\\')
         end
