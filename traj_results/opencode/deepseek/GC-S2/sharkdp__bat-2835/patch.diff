+    fn print_header_line(
+        &mut self,
+        handle: &mut OutputHandle,
+        parts: &[(&str, bool)],
+    ) -> Result<()> {
+        let grid_prefix_width = if self.config.style_components.grid() {
+            Self::header_grid_prefix(self.panel_width)
+                .chars()
+                .map(Self::displayed_char_width)
+                .sum()
+        } else {
+            0
+        };
+        let max_width = self
+            .config
+            .term_width
+            .saturating_sub(self.panel_width + grid_prefix_width)
+            .max(1);
+
+        let mut line: Vec<(String, bool)> = Vec::new();
+        let mut line_width = 0;
+
+        for &(part, colored) in parts {
+            for c in part.chars() {
+                let cw = Self::displayed_char_width(c);
+                if line_width > 0 && line_width + cw > max_width {
+                    self.print_header_line_parts(handle, &mut line)?;
+                    line_width = 0;
+                }
+
+                match line.last_mut() {
+                    Some((text, last_colored)) if *last_colored == colored => text.push(c),
+                    _ => line.push((c.to_string(), colored)),
+                }
+                line_width += cw;
+            }
+        }
+
+        self.print_header_line_parts(handle, &mut line)
+    }
+
+    fn print_header_line_parts(
+        &mut self,
+        handle: &mut OutputHandle,
+        parts: &mut Vec<(String, bool)>,
+    ) -> Result<()> {
+        self.print_header_component_indent(handle)?;
+
+        for (text, colored) in parts.drain(..) {
+            if colored {
+                write!(handle, "{}", self.colors.header_value.paint(text))?;
+            } else {
+                write!(handle, "{}", text)?;
+            }
+        }
+
+        writeln!(handle)?;
+        Ok(())
+    }
