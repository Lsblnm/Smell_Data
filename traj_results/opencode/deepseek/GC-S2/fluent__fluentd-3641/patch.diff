+      def parse_endpoint(endpoint)
+        bind, port = case endpoint.to_s
+                     when /\A\[([^\]]+)\]:([0-9]+)\z/
+                       [$1, $2.to_i]
+                     when /\A([^:]+):([0-9]+)\z/
+                       [$1, $2.to_i]
+                     else
+                       raise Fluent::ConfigError, "Invalid rpc_endpoint: #{endpoint}"
+                     end
+
+        if bind.strip.empty? || bind == '*' || port > 65535
+          raise Fluent::ConfigError, "Invalid rpc_endpoint: #{endpoint}"
+        end
+
+        begin
+          addrinfo_list = Addrinfo.getaddrinfo(bind, port, nil, :STREAM)
+        rescue SocketError, SystemCallError
+          raise Fluent::ConfigError, "Invalid rpc_endpoint: #{endpoint}"
+        end
+
+        addrinfo = addrinfo_list.find { |ai| ai.afamily == Socket::AF_INET } || addrinfo_list.first
+        unless addrinfo
+          raise Fluent::ConfigError, "Invalid rpc_endpoint: #{endpoint}"
+        end
+
+        [addrinfo.ip_address, port]
+      end
+
       def mount(path, servlet, *args)
