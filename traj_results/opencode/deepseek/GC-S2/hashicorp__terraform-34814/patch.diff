+func disconnectOnDone(ctx context.Context, comm communicator.Communicator) func() {
+	ctx, cancel := context.WithCancel(ctx)
+	done := make(chan struct{})
+	go func() {
+		defer close(done)
+		<-ctx.Done()
+		comm.Disconnect()
+	}()
+	return func() {
+		cancel()
+		<-done
+	}
+}
