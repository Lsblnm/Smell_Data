+	// Wait for the context to end and then disconnect. The returned function
+	// also cancels the wait and disconnects when the scripts finish executing,
+	// so the connection is not left open after the provisioner completes.
+	waitForDisconnect := disconnectOnDone(ctx, comm)
+	defer waitForDisconnect()
 
 	p := &provisioner{ctx: ctx}
