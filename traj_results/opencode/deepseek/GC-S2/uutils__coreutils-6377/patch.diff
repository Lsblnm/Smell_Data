+fn parse_ignore_signals(matches: &clap::ArgMatches) -> UResult<Vec<Option<usize>>> {
+    #[cfg(not(unix))]
+    let _ = matches;
+
+    #[cfg(unix)]
+    {
+        let mut signals = Vec::new();
+        if let Some(values) = matches.get_many::<OsString>("ignore-signal") {
+            for value in values {
+                if value == OsStr::new(IGNORE_ALL_SIGNALS) {
+                    signals.push(None);
+                    continue;
+                }
+                let value = value.to_string_lossy();
+                for signal in value.split(',').filter(|signal| !signal.is_empty()) {
+                    match signal_by_name_or_value(&signal.to_uppercase()) {
+                        Some(0) | None => {
+                            return Err(UUsageError::new(
+                                125,
+                                format!("{}: invalid signal", signal.quote()),
+                            ));
+                        }
+                        Some(signal_number) => signals.push(Some(signal_number)),
+                    }
+                }
+            }
+        }
+        Ok(signals)
+    }
+
+    #[cfg(not(unix))]
+    {
+        Ok(Vec::new())
+    }
+}
+
+#[cfg(unix)]
+fn apply_ignore_signals(opts: &Options<'_>) -> UResult<()> {
+    let action = SigAction::new(SigHandler::SigIgn, SaFlags::empty(), SigSet::empty());
+    for signal in &opts.ignore_signals {
+        match signal {
+            None => {
+                for signal_number in 1..ALL_SIGNALS.len() {
+                    if let Ok(signal) = Signal::try_from(signal_number as i32) {
+                        let _ = unsafe { sigaction(signal, &action) };
+                    }
+                }
+            }
+            Some(signal_number) => {
+                let signal = Signal::try_from(*signal_number as i32).map_err(|_| {
+                    USimpleError::new(
+                        125,
+                        format!(
+                            "failed to set signal action for signal {signal_number}: \
+                             Invalid argument"
+                        ),
+                    )
+                })?;
+                if let Err(error) = unsafe { sigaction(signal, &action) } {
+                    return Err(USimpleError::new(
+                        125,
+                        format!(
+                            "failed to set signal action for signal {}: {}",
+                            signal as i32,
+                            error.desc()
+                        ),
+                    ));
+                }
+            }
+        }
+    }
+    Ok(())
+}
