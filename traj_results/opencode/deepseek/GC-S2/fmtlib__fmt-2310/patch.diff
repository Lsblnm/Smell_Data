-  });
+  auto specs_copy = specs;
+  if (specs_copy.fill.size() == 1 &&
+      specs_copy.fill[0] == static_cast<Char>('0'))
+    specs_copy.fill[0] = static_cast<Char>(' ');
+  if (specs_copy.align == align::numeric) specs_copy.align = align::right;
+  return write_padded(out, specs_copy, size,
+                      [=](reserve_iterator<OutputIt> it) {
+                        if (sign) *it++ = static_cast<Char>(data::signs[sign]);
+                        return copy_str<Char>(str, str + str_size, it);
+                      });
 }
 
