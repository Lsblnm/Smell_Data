+    def self.filename_match_for(device, filename)
+      matches = []
+      [device.formatted_name_without_apple, device.id].each do |token|
+        next if token.nil? || token.empty?
+        matches << token if filename.include?(token)
+      end
+      matches.max_by(&:length)
+    end
+
+    # A device with a name that extends another device's name (e.g. "iPhone 13 Pro"
+    # vs "iPhone 13") is more specific and should win when both share a priority.
+    def self.preferred_device?(device, current_device)
+      return true if device.priority > current_device.priority
+      return false if device.priority < current_device.priority
+
+      name = device.formatted_name_without_apple
+      current_name = current_device.formatted_name_without_apple
+      name.start_with?("#{current_name} ")
+    end
