+// validateImportBlocks validates the expressions within any import blocks
+// associated with this resource. During validation we don't have any state or
+// input variable values, so import IDs which are not known yet are accepted.
+func (n *NodeValidatableResource) validateImportBlocks(ctx EvalContext) tfdiags.Diagnostics {
+	var diags tfdiags.Diagnostics
+
+	if len(n.importTargets) == 0 {
+		return diags
+	}
+
+	// Import blocks only exist in the root module, and must be evaluated in
+	// that context.
+	ctx = evalContextForModuleInstance(ctx, addrs.RootModuleInstance)
+
+	for _, imp := range n.importTargets {
+		// Legacy imports supplied on the command line have no configuration to
+		// validate.
+		if imp.Config == nil {
+			continue
+		}
+
+		// Import blocks cannot refer to the resource they are importing in
+		// either their id or for_each expressions.
+		diags = diags.Append(validateMetaSelfRef(imp.Config.ToResource.Resource, imp.Config.ForEach))
+
+		if imp.Config.ForEach == nil {
+			traversal, hds := hcl.AbsTraversalForExpr(imp.Config.To)
+			diags = diags.Append(hds)
+			if hds.HasErrors() {
+				continue
+			}
+
+			to, tds := addrs.ParseAbsResourceInstance(traversal)
+			diags = diags.Append(tds)
+			if tds.HasErrors() {
+				continue
+			}
+
+			_, evalDiags := evaluateImportIdExpression(imp.Config.ID, to, ctx, EvalDataForNoInstanceKey, true)
+			diags = diags.Append(evalDiags)
+			continue
+		}
+
+		forEachData, known, forEachDiags := newForEachEvaluator(imp.Config.ForEach, ctx, true).ImportValues()
+		diags = diags.Append(forEachDiags)
+		if forEachDiags.HasErrors() {
+			continue
+		}
+
+		if !known {
+			// The for_each value isn't available during validation, so we can
+			// only verify the static structure of the expressions.
+			_, evalDiags := evalImportUnknownToExpression(imp.Config.To)
+			diags = diags.Append(evalDiags)
+
+			keyData := instances.RepetitionData{
+				EachKey:   cty.UnknownVal(cty.String),
+				EachValue: cty.DynamicVal,
+			}
+			target := addrs.AbsResourceInstance{
+				Resource: imp.Config.ToResource.Resource.Instance(addrs.NoKey),
+			}
+			_, idDiags := evaluateImportIdExpression(imp.Config.ID, target, ctx, keyData, true)
+			diags = diags.Append(idDiags)
+			continue
+		}
+
+		for _, keyData := range forEachData {
+			to, toDiags := evalImportToExpression(imp.Config.To, keyData)
+			diags = diags.Append(toDiags)
+			if toDiags.HasErrors() {
+				continue
+			}
+
+			_, evalDiags := evaluateImportIdExpression(imp.Config.ID, to, ctx, keyData, true)
+			diags = diags.Append(evalDiags)
+		}
+	}
+
+	return diags
+}
