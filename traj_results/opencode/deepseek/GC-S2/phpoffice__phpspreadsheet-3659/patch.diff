+    private function isTableName(string $value, ?Cell $cell): bool
+    {
+        if ($cell === null || $value === '') {
+            return false;
+        }
+
+        $worksheet = $cell->getWorksheet();
+        $spreadsheet = $worksheet->getParent();
+        if ($spreadsheet === null) {
+            return false;
+        }
+
+        foreach ($spreadsheet->getWorksheetIterator() as $sheet) {
+            if ($sheet->getTableByName($value) !== null) {
+                return true;
+            }
+        }
+
+        return false;
+    }
