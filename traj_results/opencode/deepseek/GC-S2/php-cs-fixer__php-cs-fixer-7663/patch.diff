+        }
+
+        if ($token->isGivenKind(T_IF)) {
+            return $this->findIfStatementEndIndex($tokens, $index);
+        }
+
+        if ($token->isGivenKind([T_FOR, T_FOREACH, T_WHILE, T_SWITCH])) {
+            return $this->findParenthesizedControlBodyEndIndex($tokens, $index);
+        }
+
+        if ($token->isGivenKind(T_DO)) {
+            return $this->findDoStatementEndIndex($tokens, $index);
+        }
+
+        return $this->findSimpleStatementEndIndex($tokens, $index);
+    }
+
+    private function findIfStatementEndIndex(Tokens $tokens, int $index): int
+    {
+        $endIndex = $this->findParenthesizedControlBodyEndIndex($tokens, $index);
+
+        while (true) {
