+fn plain_overrides_paging(args: &[OsString]) -> bool {
+    let mut paging_index = None;
+    let mut plain_index = None;
+    let mut plain_count = 0usize;
+    let mut skip_next = false;
+
+    for (index, arg) in args.iter().enumerate() {
+        if skip_next {
+            skip_next = false;
+            continue;
+        }
+
+        let text = match arg.to_str() {
+            Some(text) => text,
+            None => continue,
+        };
+
+        if text == "--paging" {
+            paging_index = Some(index + 1);
+            skip_next = true;
+        } else if text.starts_with("--paging=")
+            || text == "--no-paging"
+            || text == "--no-pager"
+        {
+            paging_index = Some(index);
+        } else if text == "--plain" {
+            let previous_count = plain_count;
+            plain_count += 1;
+            if previous_count < 2 && plain_count >= 2 {
+                plain_index = Some(index);
+            }
+        } else if text.starts_with('-') && !text.starts_with("--") && text.len() > 1 {
+            let short_options = &text[1..];
+            let plain_occurrences = short_options.chars().filter(|&c| c == 'p').count();
+
+            if short_options.contains('P') {
+                paging_index = Some(index);
+            }
+
+            if plain_occurrences > 0 {
+                let previous_count = plain_count;
+                plain_count += plain_occurrences;
+                if plain_occurrences >= 2 || (previous_count < 2 && plain_count >= 2) {
+                    plain_index = Some(index);
+                }
+            }
+        }
+    }
+
+    match (plain_index, paging_index) {
+        (Some(plain), Some(paging)) => plain > paging,
+        (Some(_), None) => true,
+        _ => false,
+    }
+}
