index 0000000..fe735c4
--- /dev/null
+++ b/lib/helpers/formDataToStream.js
@@ -0,0 +1,192 @@
+'use strict';
+
+import {Readable} from 'stream';
+import utils from '../utils.js';
+import readBlob from './readBlob.js';
+
+const BOUNDARY_ALPHABET = 'abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789-_';
+
+const textEncoder = new TextEncoder();
+
+const CRLF = '\r\n';
+const CRLF_BYTES = textEncoder.encode(CRLF);
+
+function escapeName(name) {
+  return String(name)
+    .replace(/\r/g, '%0D')
+    .replace(/\n/g, '%0A')
+    .replace(/"/g, '%22');
+}
+
+class FormDataPart {
+  constructor(name, value) {
+    const isStringValue = utils.isString(value);
+
+    let headers = `Content-Disposition: form-data; name="${escapeName(name)}"${
+      !isStringValue && value.name ? `; filename="${escapeName(value.name)}"` : ''
+    }${CRLF}`;
+
+    if (isStringValue) {
+      value = textEncoder.encode(String(value).replace(/\r?\n|\r\n?/g, CRLF));
+    } else {
+      headers += `Content-Type: ${value.type || 'application/octet-stream'}${CRLF}`;
+    }
+
+    this.headers = textEncoder.encode(headers + CRLF);
+    this.contentLength = isStringValue ? value.byteLength : value.size;
+    this.size = this.headers.byteLength + this.contentLength + CRLF_BYTES.byteLength;
+    this.name = name;
+    this.value = value;
+  }
+}
+
+class FormDataToStream extends Readable {
+  constructor(form, {tag, boundary} = {}) {
+    super();
+
+    this._boundary = boundary || FormDataToStream.generateBoundary(32);
+    this._form = form;
+    this._tag = tag;
+    this._parts = null;
+    this._partsLength = 0;
+    this._chunks = null;
+    this._chunkIndex = -1;
+    this._source = null;
+  }
+
+  static generateBoundary(size) {
+    let result = '';
+
+    for (let i = 0; i < size; i++) {
+      result += BOUNDARY_ALPHABET[Math.floor(Math.random() * BOUNDARY_ALPHABET.length)];
+    }
+
+    return result;
+  }
+
+  static getBoundary(form, options) {
+    return form instanceof FormDataToStream ? form.boundary :
+      (options && options.boundary) || FormDataToStream.generateBoundary(32);
+  }
+
+  get boundary() {
+    return this._boundary;
+  }
+
+  get parts() {
+    if (this._parts) {
+      return this._parts;
+    }
+
+    const parts = [];
+    const boundaryLineLength = this._boundaryLine.byteLength;
+    let partsLength = 0;
+
+    for (const [name, value] of this._form) {
+      const part = new FormDataPart(name, value);
+
+      partsLength += boundaryLineLength + part.size;
+
+      parts.push(part);
+    }
+
+    this._partsLength = partsLength + this._footer.byteLength;
+    this._parts = parts;
+
+    return parts;
+  }
+
+  get contentLength() {
+    this.parts;
+
+    return this._partsLength;
+  }
+
+  get _boundaryLine() {
+    return textEncoder.encode(`--${this._boundary}${CRLF}`);
+  }
+
+  get _footer() {
+    return textEncoder.encode(`--${this._boundary}--${CRLF}${CRLF}`);
+  }
+
+  get chunks() {
+    if (this._chunks) {
+      return this._chunks;
+    }
+
+    const chunks = [];
+
+    for (const part of this.parts) {
+      chunks.push(this._boundaryLine);
+      chunks.push(part.headers);
+
+      if (utils.isTypedArray(part.value)) {
+        chunks.push(part.value);
+      } else {
+        chunks.push(readBlob(part.value));
+      }
+
+      chunks.push(CRLF_BYTES);
+    }
+
+    chunks.push(this._footer);
+
+    this._chunks = chunks;
+
+    return chunks;
+  }
+
+  _read() {
+    if (this._source) {
+      this._source.resume();
+      return;
+    }
+
+    const chunks = this.chunks;
+
+    while (++this._chunkIndex < chunks.length) {
+      const chunk = chunks[this._chunkIndex];
+
+      if (utils.isStream(chunk)) {
+        this._source = chunk;
+
+        chunk.on('data', (data) => {
+          if (!this.push(data)) {
+            chunk.pause();
+          }
+        });
+
+        chunk.once('end', () => {
+          this._source = null;
+          this._read();
+        });
+
+        chunk.once('error', err => this.destroy(err));
+
+        return;
+      }
+
+      if (!this.push(chunk)) {
+        return;
+      }
+    }
+
+    this.push(null);
+  }
+}
+
+function formDataToStream(form, headers, options) {
+  const stream = new FormDataToStream(form, options);
+
+  headers && headers({
+    'Content-Type': `multipart/form-data; boundary=${stream.boundary}`,
+    'Content-Length': stream.contentLength
+  });
+
+  return stream;
+}
+
+formDataToStream.getBoundary = FormDataToStream.getBoundary;
+
+export default formDataToStream;
diff --git a/lib/helpers/readBlob.js b/lib/helpers/readBlob.js
new file mode 100644
index 0000000..df46169
--- /dev/null
+++ b/lib/helpers/readBlob.js
@@ -0,0 +1,80 @@
+'use strict';
+
+import {Readable} from 'stream';
+import utils from '../utils.js';
+
+const readBlob = (blob) => {
+  if (utils.isStream(blob)) {
+    return blob;
+  }
+
+  if (blob.stream) {
+    const blobStream = blob.stream();
+
+    if (utils.isStream(blobStream)) {
+      return blobStream;
+    }
+
+    if (utils.isFunction(blobStream.getReader)) {
+      return new Readable({
+        read() {
+          if (!this._reader) {
+            this._reader = blobStream.getReader();
+            this._reading = false;
+          }
+
+          const pull = () => {
+            if (this._reading) {
+              return;
+            }
+
+            this._reading = true;
+
+            this._reader.read().then(({done, value}) => {
+              this._reading = false;
+
+              if (done) {
+                this.push(null);
+              } else if (this.push(Buffer.from(value))) {
+                pull();
+              }
+            }, err => this.destroy(err));
+          };
+
+          pull();
+        }
+      });
+    }
+
+    if (blobStream[Symbol.asyncIterator]) {
+      return Readable.from(blobStream);
+    }
+  }
+
+  if (blob[Symbol.asyncIterator]) {
+    return Readable.from(blob);
+  }
+
+  if (blob.arrayBuffer) {
+    let called = false;
+
+    return new Readable({
+      read() {
+        if (called) {
+          return;
+        }
+
+        called = true;
+
+        blob.arrayBuffer().then(buffer => {
+          this.push(Buffer.from(buffer));
+          this.push(null);
+        }, err => this.destroy(err));
+      }
+    });
+  }
+
+  return Readable.from([blob]);
+};
+
+export default readBlob;
