+    private function isDeclarationStart(Tokens $tokens, int $index, int $parentScopeEndIndex): bool
+    {
+        if ($tokens[$index]->isGivenKind(T_CONST)) {
+            return true;
+        }
+
+        $modifierTokens = [T_PUBLIC, T_PROTECTED, T_PRIVATE, T_STATIC, T_VAR];
+        if (\defined('T_READONLY')) { // @TODO: drop condition when PHP 8.1+ is required
+            $modifierTokens[] = T_READONLY;
+        }
+
+        if (!$tokens[$index]->isGivenKind($modifierTokens)) {
+            return false;
+        }
+
+        for ($i = $index + 1; $i <= $parentScopeEndIndex; ++$i) {
+            $token = $tokens[$i];
+
+            if ($token->isWhitespace() || $token->isComment()) {
+                continue;
+            }
+
+            if ($token->isGivenKind([T_FUNCTION, T_FN, T_CLASS, T_INTERFACE, T_TRAIT])) {
+                return false;
+            }
+
+            if ($token->isGivenKind([T_CONST, T_VARIABLE])) {
+                return true;
+            }
+
+            if ($token->equalsAny(['{', ';', '}', '('])) {
+                return false;
+            }
+        }
+
+        return false;
+    }
+
+    private function isDeclarationItemOnStartLine(Tokens $tokens, int $index, int $endIndex): bool
+    {
+        $firstNewlineIndex = null;
+
+        for ($i = $index; $i <= $endIndex; ++$i) {
+            if ($tokens[$i]->isWhitespace() && Preg::match('/\R/', $tokens[$i]->getContent())) {
+                $firstNewlineIndex = $i;
+
+                break;
+            }
+        }
+
+        if (null === $firstNewlineIndex) {
+            return true;
+        }
+
+        $seenConst = false;
+        for ($i = $index; $i < $firstNewlineIndex; ++$i) {
+            $token = $tokens[$i];
+
+            if ($token->isWhitespace() || $token->isComment()) {
+                continue;
+            }
+
+            if ($token->isGivenKind(T_CONST)) {
+                $seenConst = true;
+
+                continue;
+            }
+
+            if ($token->isGivenKind(T_VARIABLE) || $seenConst) {
+                return true;
+            }
+        }
+
+        return false;
+    }
+
