diff --git a/lib/fpm/package/deb.rb b/lib/fpm/package/deb.rb
index 684caf6..6d8bfba 100644
--- a/lib/fpm/package/deb.rb
+++ b/lib/fpm/package/deb.rb
@@ -977,6 +977,34 @@ class FPM::Package::Deb < FPM::Package
       logger.warn("Replacing 'provides' entry #{provides} with syntax 'name (= version)'")
       provides = "#{m[1]} (= #{m[2]})"
     end
+
+    # Debian only supports versioned Provides with an exact '=' relation.
+    # See https://www.debian.org/doc/debian-policy/ch-relationships.html#id9
+    if m = provides.match(/^([^\s(]+)\s*(.*)$/)
+      package_name = m[1]
+      relation = m[2].strip
+
+      if relation.empty?
+        if package_name !~ /^[a-z0-9][a-z0-9+.-]*$/
+          raise FPM::InvalidPackageConfiguration,
+            "Invalid Debian provides entry '#{provides}': '#{package_name}' is not a valid package name"
+        end
+      elsif (version_match = relation.match(/^\(=\s*([^\s)]+)\)$/))
+        version = version_match[1]
+        if version !~ /^[0-9][A-Za-z0-9.+~:-]*$/
+          raise FPM::InvalidPackageConfiguration,
+            "Invalid Debian provides entry '#{provides}': '#{version}' is not a valid version"
+        end
+      else
+        raise FPM::InvalidPackageConfiguration,
+          "Invalid Debian provides entry '#{provides}': versioned provides must use '=' " \
+          "(for example, 'name (= 1.0)')"
+      end
+    else
+      raise FPM::InvalidPackageConfiguration,
+        "Invalid Debian provides entry '#{provides}'"
+    end
+
     return provides.rstrip
   end
 
