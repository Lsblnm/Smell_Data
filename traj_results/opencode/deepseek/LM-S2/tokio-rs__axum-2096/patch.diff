+    /// Merge the nested fallback routes from `other` into `self`, without
+    /// touching the root fallback routes (`/` and `/*fallback`).
+    pub(super) fn merge_nested_fallbacks(
+        &mut self,
+        other: PathRouter<S, IS_FALLBACK>,
+    ) -> Result<(), Cow<'static, str>> {
+        let PathRouter {
+            routes,
+            node,
+            prev_route_id: _,
+        } = other;
+
+        let fallback_path = format!("/*{FALLBACK_PARAM}");
+
+        for (id, route) in routes {
+            let path = node
+                .route_id_to_path
+                .get(&id)
+                .expect("no path for route id. This is a bug in axum. Please file an issue");
+
+            if path.as_ref() == "/" || path.as_ref() == fallback_path {
+                continue;
+            }
+
+            match route {
+                Endpoint::MethodRouter(method_router) => self.route(path, method_router)?,
+                Endpoint::Route(route) => self.route_service(path, route)?,
+            };
+        }
+
+        Ok(())
+    }
+
