@@ -571,6 +571,15 @@ func (h *Head) Init(minValidTime int64) error {
 	refSeries := make(map[chunks.HeadSeriesRef]*memSeries)
 
 	if h.opts.EnableMemorySnapshotOnShutdown {
+		// Snapshots with an index ahead of the WAL belong to an older WAL (for
+		// example one that has since been reset). They cannot be replayed
+		// correctly and would take precedence over valid, newer snapshots
+		// because LastChunkSnapshot picks the highest index. Remove them first.
+		if h.wal != nil {
+			if err := h.deleteChunkSnapshotsAheadOfWAL(); err != nil {
+				return err
+			}
+		}
 		level.Info(h.logger).Log("msg", "Chunk snapshot is enabled, replaying from the snapshot")
 		var err error
 		snapIdx, snapOffset, refSeries, err = h.loadChunkSnapshot()
@@ -946,6 +955,35 @@ func (h *Head) Init(minValidTime int64) error {
 	return nil
 }
 
+// deleteChunkSnapshotsAheadOfWAL deletes chunk snapshots whose WAL segment index
+// is greater than the last WAL segment currently on disk. Such snapshots belong
+// to an older WAL (for example one that has since been reset) and cannot be
+// replayed correctly.
+func (h *Head) deleteChunkSnapshotsAheadOfWAL() error {
+	_, lastWALSegment, err := wlog.Segments(h.wal.Dir())
+	if err != nil {
+		return errors.Wrap(err, "finding WAL segments")
+	}
+
+	for {
+		snapDir, snapIdx, _, err := LastChunkSnapshot(h.opts.ChunkDirRoot)
+		if err == record.ErrNotFound {
+			return nil
+		}
+		if err != nil {
+			return errors.Wrap(err, "find last chunk snapshot")
+		}
+		if snapIdx <= lastWALSegment {
+			return nil
+		}
+
+		level.Warn(h.logger).Log("msg", "Deleting chunk snapshot that is ahead of the WAL", "dir", snapDir, "snapshot_index", snapIdx, "wal_last_segment", lastWALSegment)
+		if err := os.RemoveAll(snapDir); err != nil {
+			return errors.Wrapf(err, "delete chunk snapshot %s", snapDir)
+		}
+	}
+}
