+    protected function previousUrlIsCurrent($url)
+    {
+        $normalize = function ($value) {
+            return preg_replace('~/+(?=\?|$)~', '', $value);
+        };
+
+        if ($normalize($url) === $normalize($this->request->fullUrl())) {
+            return true;
+        }
+
+        if (! Str::startsWith($url, ['http://', 'https://', '//', '#', 'mailto:', 'tel:', 'sms:'])) {
+            $path = '/'.ltrim($url, '/');
+
+            return $normalize($path) === $normalize($this->request->getRequestUri());
+        }
+
+        return false;
+    }
