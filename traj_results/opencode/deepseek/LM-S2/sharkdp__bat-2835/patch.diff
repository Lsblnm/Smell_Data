+    fn print_header_component(
+        &mut self,
+        handle: &mut OutputHandle,
+        segments: &[(String, Option<Style>)],
+        content_budget: usize,
+        wrap: bool,
+    ) -> Result<()> {
+        self.print_header_component_indent(handle)?;
+
+        let mut line_width = 0usize;
+        for (text, style) in segments {
+            if !wrap {
+                if let Some(style) = style {
+                    write!(handle, "{}", style.paint(text))?;
+                } else {
+                    write!(handle, "{}", text)?;
+                }
+                line_width += text
+                    .chars()
+                    .map(|c| c.width().unwrap_or(0))
+                    .sum::<usize>();
+                continue;
+            }
+
+            let mut chunk = String::new();
+            for c in text.chars() {
+                let cw = c.width().unwrap_or(0);
+                if line_width > 0 && line_width + cw > content_budget {
+                    if let Some(style) = style {
+                        write!(handle, "{}", style.paint(&chunk))?;
+                    } else {
+                        write!(handle, "{}", chunk)?;
+                    }
+                    chunk.clear();
+                    writeln!(handle)?;
+                    self.print_header_component_indent(handle)?;
+                    line_width = 0;
+                }
+                chunk.push(c);
+                line_width += cw;
+            }
+
+            if let Some(style) = style {
+                write!(handle, "{}", style.paint(&chunk))?;
+            } else {
+                write!(handle, "{}", chunk)?;
+            }
+        }
+
+        writeln!(handle)?;
+
+        Ok(())
+    }
