         return;
     }
 
+    /* Parse start/end range if any. Validate all arguments before looking
+     * up the key, so that syntax errors are reported for non existing keys
+     * as well. */
+    int range_given = 0;
+    if (c->argc == 4 || c->argc == 5 || c->argc == 6) {
+        range_given = 1;
+        robj *startobj = c->argv[3];
+        serverAssertWithInfo(NULL, startobj, startobj->type == OBJ_STRING);
+        if (sdsEncodedObject(startobj)) {
+            if (string2ll(startobj->ptr, sdslen(startobj->ptr), &start) == 0) {
+                addReplyProto(c, "-ERR ", 5);
+                addReplyProto(c, "value is not an integer or out of range",
+                              sizeof("value is not an integer or out of range")-1);
+                addReplyProto(c, "\r\n", 2);
+                afterErrorReply(c, "value is not an integer or out of range",
+                                sizeof("value is not an integer or out of range")-1, 0);
+                return;
+            }
+        } else if (startobj->encoding == OBJ_ENCODING_INT) {
+            start = (long) startobj->ptr;
+        } else {
+            serverPanic("Unknown string encoding");
+        }
+        if (c->argc == 6) {
+            if (!strcasecmp(c->argv[5]->ptr,"bit")) isbit = 1;
+            else if (!strcasecmp(c->argv[5]->ptr,"byte")) isbit = 0;
+            else {
+                addReply(c, shared.syntaxerr);
+                afterErrorReply(c, shared.syntaxerr->ptr,
+                                sdslen(shared.syntaxerr->ptr)-2, 0);
+                return;
+            }
+        }
+        if (c->argc >= 5) {
+            long long endval;
+            robj *endobj = c->argv[4];
+            if (getLongLongFromObject(endobj, &endval) != C_OK) {
+                addReplyProto(c, "-ERR ", 5);
+                addReplyProto(c, "value is not an integer or out of range",
+                              sizeof("value is not an integer or out of range")-1);
+                addReplyProto(c, "\r\n", 2);
+                afterErrorReply(c, "value is not an integer or out of range",
+                                sizeof("value is not an integer or out of range")-1, 0);
+                return;
+            }
+            end = endval;
+            end_given = 1;
+        }
+    } else if (c->argc != 3) {
+        /* Syntax error. */
+        addReply(c, shared.syntaxerr);
+        afterErrorReply(c, shared.syntaxerr->ptr,
+                        sdslen(shared.syntaxerr->ptr)-2, 0);
+        return;
+    }
