+#[cfg(unix)]
+fn parse_signal(signal: &str) -> Option<usize> {
+    if let Ok(value) = signal.parse::<usize>() {
+        return (value > 0 && uucore::signals::is_signal(value)).then_some(value);
+    }
+
+    let signal = signal.to_ascii_uppercase();
+    let signal = signal.strip_prefix("SIG").unwrap_or(&signal);
+    uucore::signals::ALL_SIGNALS
+        .iter()
+        .enumerate()
+        .find_map(|(value, &name)| (value > 0 && name == signal).then_some(value))
+}
+
+#[cfg(unix)]
+fn parse_ignore_signals(matches: &clap::ArgMatches) -> UResult<Vec<(usize, SignalMode)>> {
+    let mut signals = Vec::new();
+
+    if let Some(values) = matches.get_many::<OsString>("ignore-signal") {
+        for value in values {
+            if value == OsStr::new(ALL_SIGNALS_ARG) {
+                for signal in 1..uucore::signals::ALL_SIGNALS.len() {
+                    signals.push((signal, SignalMode::IgnoreWithoutErrors));
+                }
+                continue;
+            }
+
+            let value_str = match value.to_str() {
+                Some(value) => value,
+                None => {
+                    return Err(USimpleError::new(
+                        125,
+                        format!("{}: invalid signal", value.quote()),
+                    ));
+                }
+            };
+
+            for signal in value_str.split(',').filter(|s| !s.is_empty()) {
+                match parse_signal(signal) {
+                    Some(signal_number) => signals.push((signal_number, SignalMode::Ignore)),
+                    None => {
+                        return Err(USimpleError::new(
+                            125,
+                            format!("{}: invalid signal", signal.quote()),
+                        ));
+                    }
+                }
+            }
+        }
+    }
+
+    Ok(signals)
+}
+
+#[cfg(unix)]
+fn apply_signal_modes(signals: &[(usize, SignalMode)]) -> UResult<bool> {
+    let mut ignore_sigchld = false;
+
+    for &(signal_number, mode) in signals {
+        let signal = match Signal::try_from(signal_number as i32) {
+            Ok(signal) => signal,
+            Err(_) => {
+                if mode == SignalMode::Ignore {
+                    return Err(USimpleError::new(
+                        125,
+                        format!(
+                            "failed to set signal action for signal {}: Invalid argument",
+                            signal_number
+                        ),
+                    ));
+                }
+                continue;
+            }
+        };
+
+        // Ignoring SIGCHLD in the environment process itself would prevent it from
+        // waiting for the command. Apply it to the command instead.
+        if signal == Signal::SIGCHLD {
+            ignore_sigchld = true;
+            continue;
+        }
+
+        let action = SigAction::new(SigHandler::SigIgn, SaFlags::empty(), SigSet::empty());
+        if let Err(error) = unsafe { sigaction(signal, &action) } {
+            if mode == SignalMode::Ignore {
+                return Err(USimpleError::new(
+                    125,
+                    format!(
+                        "failed to set signal action for signal {}: {}",
+                        signal_number,
+                        error.desc()
+                    ),
+                ));
+            }
+        }
+    }
+
+    Ok(ignore_sigchld)
+}
