+fn is_known_builtin_type_name(name: &str) -> bool {
+    matches!(
+        name,
+        "bool"
+            | "int"
+            | "str"
+            | "float"
+            | "complex"
+            | "bytes"
+            | "bytearray"
+            | "list"
+            | "dict"
+            | "set"
+            | "frozenset"
+            | "tuple"
+            | "range"
+    )
+}
+
+fn is_known_builtin_container_name(name: &str) -> bool {
+    matches!(
+        name,
+        "list" | "dict" | "set" | "frozenset" | "tuple" | "type"
+    )
+}
+
+fn is_known_builtin_qualified_name(qualified_name: &QualifiedName) -> bool {
+    let name = match qualified_name.segments() {
+        [name] => *name,
+        ["builtins", name] => *name,
+        _ => return false,
+    };
+    is_known_builtin_type_name(name)
+}
+
+/// Returns `true` if `expr` is known to be an instance of a built-in type whose
+/// `__eq__` and `__ne__` implementations return a `bool`.
+fn is_known_to_return_bool(expr: &Expr, semantic: &SemanticModel) -> bool {
+    is_known_to_return_bool_inner(expr, semantic, 8)
+}
+
+fn is_known_to_return_bool_inner(expr: &Expr, semantic: &SemanticModel, depth: usize) -> bool {
+    if depth == 0 {
+        return false;
+    }
+
+    match expr {
+        Expr::Name(name) => {
+            let Some(binding_id) = semantic.resolve_name(name) else {
+                return false;
+            };
+            let binding = semantic.binding(binding_id);
+            match &binding.kind {
+                BindingKind::Builtin
+                | BindingKind::ClassDefinition(_)
+                | BindingKind::FunctionDefinition(_)
+                | BindingKind::Import(_)
+                | BindingKind::SubmoduleImport(_) => true,
+                BindingKind::Assignment | BindingKind::NamedExprAssignment => {
+                    match binding.statement(semantic) {
+                        Some(Stmt::Assign(assign)) => is_known_to_return_bool_inner(
+                            assign.value.as_ref(),
+                            semantic,
+                            depth - 1,
+                        ),
+                        Some(Stmt::AnnAssign(ann_assign)) => {
+                            is_known_annotation(ann_assign.annotation.as_ref(), semantic, depth - 1)
+                        }
+                        _ => false,
+                    }
+                }
+                BindingKind::Annotation => match binding.statement(semantic) {
+                    Some(Stmt::AnnAssign(ann_assign)) => {
+                        is_known_annotation(ann_assign.annotation.as_ref(), semantic, depth - 1)
+                    }
+                    _ => false,
+                },
+                BindingKind::Argument => {
+                    let Some(Stmt::FunctionDef(function_def)) = binding.statement(semantic) else {
+                        return false;
+                    };
+                    function_def
+                        .parameters
+                        .iter_non_variadic_params()
+                        .find(|parameter| parameter.parameter.name.range() == binding.range())
+                        .and_then(|parameter| parameter.parameter.annotation.as_deref())
+                        .is_some_and(|annotation| {
+                            is_known_annotation(annotation, semantic, depth - 1)
+                        })
+                }
+                _ => false,
+            }
+        }
+        Expr::Call(call) => semantic
+            .resolve_qualified_name(call.func.as_ref())
+            .is_some_and(|qualified_name| is_known_builtin_qualified_name(&qualified_name)),
+        _ => matches!(
+            ResolvedPythonType::from(expr),
+            ResolvedPythonType::Atom(_) | ResolvedPythonType::Union(_)
+        ),
+    }
+}
+
+fn is_known_annotation(annotation: &Expr, semantic: &SemanticModel, depth: usize) -> bool {
+    if depth == 0 {
+        return false;
+    }
+
+    match annotation {
+        Expr::Name(name) => is_known_builtin_type_name(name.id.as_str()),
+        Expr::NoneLiteral(_) | Expr::EllipsisLiteral(_) => true,
+        Expr::Subscript(subscript) => {
+            if let Expr::Name(name) = subscript.value.as_ref() {
+                if is_known_builtin_container_name(name.id.as_str()) {
+                    return true;
+                }
+            }
+            semantic
+                .resolve_qualified_name(subscript.value.as_ref())
+                .is_some_and(|qualified_name| {
+                    matches!(
+                        qualified_name.segments(),
+                        [
+                            "typing",
+                            "List" | "Dict" | "Set" | "FrozenSet" | "Tuple" | "Type"
+                        ]
+                    )
+                })
+        }
+        Expr::BinOp(binop) if matches!(binop.op, Operator::BitOr) => {
+            is_known_annotation(binop.left.as_ref(), semantic, depth - 1)
+                && is_known_annotation(binop.right.as_ref(), semantic, depth - 1)
+        }
+        Expr::Attribute(_) => semantic
+            .resolve_qualified_name(annotation)
+            .is_some_and(|qualified_name| is_known_builtin_qualified_name(&qualified_name)),
+        _ => false,
+    }
+}
+
+fn fix_for_comparison(semantic: &SemanticModel, left: &Expr, right: &Expr, edit: Edit) -> Fix {
+    let is_safe =
+        is_known_to_return_bool(left, semantic) && is_known_to_return_bool(right, semantic);
+    if is_safe {
+        Fix::safe_edit(edit)
+    } else {
+        Fix::unsafe_edit(edit)
+    }
+}
