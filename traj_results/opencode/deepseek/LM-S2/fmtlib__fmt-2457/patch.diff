-template <typename Char, typename InputIt, typename OutputIt>
-auto consume_join_separator_unit(InputIt& begin, InputIt end, OutputIt out)
-    -> OutputIt {
-  if (begin == end) return out;
-  Char lead = static_cast<Char>(*begin);
-  using unsigned_unit = typename std::make_unsigned<Char>::type;
-  auto encoded = static_cast<unsigned_unit>(lead);
-  if (sizeof(Char) == 1) {
-    if (encoded < 0x80u) {
-      ++begin;
-      return emit_join_code_unit(out, lead);
-    }
-    if (encoded < 0xe0u) {
-      ++begin;
-      out = emit_join_code_unit(out, lead);
-      if (begin != end) {
-        Char next = static_cast<Char>(*begin);
-        ++begin;
-        out = emit_join_code_unit(out, next);
-      }
-      return out;
-    }
-    if (encoded < 0xf0u) {
-      ++begin;
-      out = emit_join_code_unit(out, lead);
-      for (int offset = 0; offset < 2 && begin != end; ++offset) {
-        Char next = static_cast<Char>(*begin);
-        ++begin;
-        out = emit_join_code_unit(out, next);
-      }
-      return out;
-    }
-    ++begin;
-    out = emit_join_code_unit(out, lead);
-    for (int offset = 0; offset < 3 && begin != end; ++offset) {
-      Char next = static_cast<Char>(*begin);
-      ++begin;
-      out = emit_join_code_unit(out, next);
-    }
-    return out;
-  }
-  ++begin;
-  return emit_join_code_unit(out, lead);
-}
