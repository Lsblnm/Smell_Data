-template <typename Char, typename OutputIt>
-auto emit_join_separator(OutputIt out, basic_string_view<Char> sep) -> OutputIt {
-  auto begin = sep.begin();
-  auto end = sep.end();
-  if (begin == end) return out;
-  if (sep.size() == 1) {
-    return consume_join_separator_unit<Char>(begin, end, out);
-  }
-  while (begin != end) {
-    out = consume_join_separator_unit<Char>(begin, end, out);
-  }
-  return out;
-}
