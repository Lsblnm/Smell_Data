 class FormulaTranslator
 {
+    private const QUOTED_PERIOD_SENTINEL = "\x1A";
+
+    /**
+     * Replace periods inside single-quoted worksheet names with a sentinel
+     *     so that they aren't mistaken for ODS address separators.
+     */
+    private static function protectQuotedPeriods(string $value): string
+    {
+        $result = '';
+        $quotedRegion = false;
+        $length = strlen($value);
+        for ($index = 0; $index < $length; ++$index) {
+            $character = $value[$index];
+            if ($character === "'") {
+                $result .= $character;
+                if ($quotedRegion && $index + 1 < $length && $value[$index + 1] === "'") {
+                    $result .= $value[++$index];
+                } else {
+                    $quotedRegion = !$quotedRegion;
+                }
+            } elseif ($character === '.' && $quotedRegion) {
+                $result .= self::QUOTED_PERIOD_SENTINEL;
+            } else {
+                $result .= $character;
+            }
+        }
+
+        return $result;
+    }
+
+    private static function restoreQuotedPeriods(string $value): string
+    {
+        return str_replace(self::QUOTED_PERIOD_SENTINEL, '.', $value);
+    }
