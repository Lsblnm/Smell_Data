diff --git a/caddyconfig/caddyfile/lexer.go b/caddyconfig/caddyfile/lexer.go
index d1fbfbb4..5979375c 100644
--- a/caddyconfig/caddyfile/lexer.go
+++ b/caddyconfig/caddyfile/lexer.go
@@ -337,4 +337,13 @@ func (t Token) NumLineBreaks() int {
 	return lineBreaks
 }
 
+// sameLine returns true if the other token is on the same line as this one.
+// Tokens from different import expansions are never considered to be on the
+// same line, even if their source line numbers happen to match.
+func (t Token) sameLine(other Token) bool {
+	return t.File == other.File &&
+		sameImportChain(t.imports, other.imports) &&
+		t.Line+t.NumLineBreaks() == other.Line
+}
