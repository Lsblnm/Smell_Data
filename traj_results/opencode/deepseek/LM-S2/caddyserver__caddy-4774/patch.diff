+func parseOptDefaultBind(d *caddyfile.Dispenser, existing interface{}) (interface{}, error) {
+	var existingAddrs []string
+	if existing != nil {
+		existingAddrs = existing.([]string)
+	}
+
+	for d.Next() { // consume parameter name
+		for d.NextArg() {
+			existingAddrs = append(existingAddrs, d.Val())
+		}
+	}
+
+	return existingAddrs, nil
+}
