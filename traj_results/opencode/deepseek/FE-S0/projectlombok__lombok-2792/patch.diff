+	private void handleNestedVals(JavacNode node) {
+		for (JavacNode child : node.down()) {
+			if (child.getKind() == Kind.LOCAL) {
+				JCVariableDecl nested = (JCVariableDecl) child.get();
+				if (nested.vartype != null) {
+					String typeTreeToString = nested.vartype.toString();
+					if (eq(typeTreeToString, "val") || eq(typeTreeToString, "var")) {
+						visitLocal(child, nested);
+						continue;
+					}
+				}
+			}
+			handleNestedVals(child);
+		}
+	}
