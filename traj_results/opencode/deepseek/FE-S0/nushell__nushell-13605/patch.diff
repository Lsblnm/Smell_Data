+fn symlink_target(path: &Path, full_paths: bool, span: Span) -> Value {
+    match path.read_link() {
+        Ok(path_to_link) => {
+            let target = if full_paths {
+                path.parent()
+                    .map(|parent| parent.join(&path_to_link))
+                    .unwrap_or(path_to_link)
+            } else {
+                path_to_link
+            };
+            Value::string(target.to_string_lossy(), span)
+        }
+        Err(_) => Value::string("Could not obtain target file's path", span),
+    }
+}
