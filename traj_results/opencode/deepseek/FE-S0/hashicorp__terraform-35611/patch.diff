+// collectRemovedResourceConfigs gathers the resources targeted by removed
+// blocks throughout the configuration tree, keyed by their absolute addresses.
+//
+// A removed block in a parent module takes precedence over one in a child
+// module, so parents are visited before their children and an existing entry is
+// never overwritten.
+func (t *AttachResourceConfigTransformer) collectRemovedResourceConfigs(cfg *configs.Config, into map[string]*configs.Removed) {
+	if cfg == nil {
+		return
+	}
+
+	for _, r := range cfg.Module.Removed {
+		crAddr, ok := r.From.RelSubject.(addrs.ConfigResource)
+		if !ok {
+			// Not for a resource at all, so can't possibly match
+			continue
+		}
+
+		// Stitch together the module path where the removed block is declared
+		// with the relative module path from the block itself to get the
+		// absolute address of the removed resource.
+		module := make(addrs.Module, 0, len(cfg.Path)+len(crAddr.Module))
+		module = append(module, cfg.Path...)
+		module = append(module, crAddr.Module...)
+		absAddr := addrs.ConfigResource{
+			Module:   module,
+			Resource: crAddr.Resource,
+		}
+
+		if _, exists := into[absAddr.String()]; !exists {
+			into[absAddr.String()] = r
+		}
+	}
+
+	for _, child := range cfg.Children {
+		t.collectRemovedResourceConfigs(child, into)
+	}
+}
