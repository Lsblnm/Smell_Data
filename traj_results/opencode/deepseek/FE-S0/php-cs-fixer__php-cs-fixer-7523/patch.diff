+    /**
+     * Checks if the `&` at the given index is a reference marker in a function parameter list.
+     */
+    private function isReferenceInFunctionParameter(Tokens $tokens, int $index): bool
+    {
+        $nextToken = $tokens[$tokens->getNextMeaningfulToken($index)];
+
+        if (!$nextToken->isGivenKind([T_VARIABLE, T_ELLIPSIS])) {
+            return false;
+        }
+
+        for ($i = $index - 1; $i >= 0; --$i) {
+            $blockType = Tokens::detectBlockType($tokens[$i]);
+
+            if (null === $blockType) {
+                continue;
+            }
+
+            if ($blockType['isStart']) {
+                if (!$tokens[$i]->equals('(')) {
+                    return false;
+                }
+
+                $prevIndex = $tokens->getPrevMeaningfulToken($i);
+
+                if ($tokens[$prevIndex]->isGivenKind(T_STRING)) {
+                    $prevIndex = $tokens->getPrevMeaningfulToken($prevIndex);
+                }
+
+                if ($tokens[$prevIndex]->isGivenKind(CT::T_RETURN_REF)) {
+                    $prevIndex = $tokens->getPrevMeaningfulToken($prevIndex);
+                }
+
+                return $tokens[$prevIndex]->isGivenKind([T_FUNCTION, T_FN]);
+            }
+
+            $i = $tokens->findBlockStart($blockType['type'], $i);
+        }
+
+        return false;
+    }
