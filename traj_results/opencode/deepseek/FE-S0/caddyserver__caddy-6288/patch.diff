+// CloneWithText returns a copy of t with its text replaced and any
+// quoting information cleared. This is useful for creating synthetic
+// tokens which should retain the same file, line and import context
+// as the token they are derived from.
+func (t Token) CloneWithText(text string) Token {
+	t.Text = text
+	t.wasQuoted = 0
+	t.heredocMarker = ""
+	return t
+}
