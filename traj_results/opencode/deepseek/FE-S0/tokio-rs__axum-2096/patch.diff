+    pub(super) fn merge(
+        &mut self,
+        router: PathRouter<S, IS_FALLBACK>,
+    ) -> Result<(), Cow<'static, str>> {
+        let PathRouter {
+            routes,
+            node,
+            prev_route_id: _,
+        } = router;
+
+        for (id, route) in routes {
+            let path = node
+                .route_id_to_path
+                .get(&id)
+                .expect("no path for route id. This is a bug in axum. Please file an issue");
+            let path = path.as_ref();
+
+            if path.is_empty() {
+                return Err("Paths must start with a `/`. Use \"/\" for root routes".into());
+            } else if !path.starts_with('/') {
+                return Err("Paths must start with a `/`".into());
+            }
+
+            match route {
+                Endpoint::MethodRouter(method_router) => {
+                    let next_id = self.prev_route_id.0.checked_add(1).expect(
+                        "Over `u32::MAX` routes created. If you need this, please file an issue.",
+                    );
+                    self.prev_route_id = RouteId(next_id);
+                    let route_id = self.prev_route_id;
+
+                    if let Some((existing_id, Endpoint::MethodRouter(prev_method_router))) = self
+                        .node
+                        .path_to_route_id
+                        .get(path)
+                        .and_then(|existing_id| {
+                            self.routes
+                                .get(existing_id)
+                                .map(|svc| (*existing_id, svc))
+                        })
+                    {
+                        let service = Endpoint::MethodRouter(
+                            prev_method_router
+                                .clone()
+                                .merge_for_path(Some(path), method_router),
+                        );
+                        self.routes.insert(existing_id, service);
+                    } else {
+                        let mut dest_node = Arc::try_unwrap(Arc::clone(&self.node))
+                            .unwrap_or_else(|node| (*node).clone());
+                        if let Err(err) = dest_node.inner.insert(path, route_id) {
+                            return Err(format!("Invalid route {path:?}: {err}").into());
+                        }
+                        let shared_path: Arc<str> = path.into();
+                        dest_node
+                            .route_id_to_path
+                            .insert(route_id, shared_path.clone());
+                        dest_node.path_to_route_id.insert(shared_path, route_id);
+                        self.node = Arc::new(dest_node);
+                        self.routes
+                            .insert(route_id, Endpoint::MethodRouter(method_router));
+                    }
+                }
+                Endpoint::Route(route) => {
+                    let next_id = self.prev_route_id.0.checked_add(1).expect(
+                        "Over `u32::MAX` routes created. If you need this, please file an issue.",
+                    );
+                    self.prev_route_id = RouteId(next_id);
+                    let route_id = self.prev_route_id;
+
+                    let mut dest_node = Arc::try_unwrap(Arc::clone(&self.node))
+                        .unwrap_or_else(|node| (*node).clone());
+                    if let Err(err) = dest_node.inner.insert(path, route_id) {
+                        return Err(format!("Invalid route {path:?}: {err}").into());
+                    }
+                    let shared_path: Arc<str> = path.into();
+                    dest_node
+                        .route_id_to_path
+                        .insert(route_id, shared_path.clone());
+                    dest_node.path_to_route_id.insert(shared_path, route_id);
+                    self.node = Arc::new(dest_node);
+                    self.routes
+                        .insert(route_id, Endpoint::Route(Route::new(route)));
+                }
+            }
+        }
+
+        Ok(())
+    }
+
