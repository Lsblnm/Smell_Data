diff --git a/src/Carbon/CarbonInterval.php b/src/Carbon/CarbonInterval.php
index d6373e24..3bedba7a 100644
--- a/src/Carbon/CarbonInterval.php
+++ b/src/Carbon/CarbonInterval.php
@@ -872,6 +872,86 @@ class CarbonInterval extends DateInterval implements CarbonConverterInterface
         return static::instance($dateInterval);
     }
 
+    /**
+     * Returns the values to dump on serialize() called on.
+     *
+     * @return array
+     */
+    public function __serialize(): array
+    {
+        $dateProperties = array_flip([
+            'y',
+            'm',
+            'd',
+            'h',
+            'i',
+            's',
+            'f',
+            'invert',
+            'days',
+            'from_string',
+        ]);
+        $properties = get_object_vars($this);
+
+        if (method_exists(DateInterval::class, '__serialize')) {
+            $properties = array_intersect_key(parent::__serialize(), $dateProperties) + $properties;
+        }
+
+        return $properties;
+    }
+
+    /**
+     * Restore the interval after unserialize() called on.
+     */
+    public function __unserialize(array $data): void
+    {
+        $properties = [];
+
+        foreach ($data as $key => $value) {
+            $properties[preg_replace('/^\0(?:[^\0]*)\0/', '', (string) $key)] = $value;
+        }
+
+        $dateProperties = array_intersect_key($properties, array_flip([
+            'y',
+            'm',
+            'd',
+            'h',
+            'i',
+            's',
+            'f',
+            'invert',
+            'days',
+            'from_string',
+        ]));
+
+        if (method_exists(DateInterval::class, '__unserialize')) {
+            parent::__unserialize($dateProperties);
+        } else {
+            parent::__construct(\sprintf(
+                'P%dY%dM%dDT%dH%dM%dS',
+                $dateProperties['y'] ?? 0,
+                $dateProperties['m'] ?? 0,
+                $dateProperties['d'] ?? 0,
+                $dateProperties['h'] ?? 0,
+                $dateProperties['i'] ?? 0,
+                $dateProperties['s'] ?? 0,
+            ));
+            $this->f = $dateProperties['f'] ?? 0;
+            $this->invert = $dateProperties['invert'] ?? 0;
+        }
+
+        if (\array_key_exists('tzName', $properties)) {
+            $properties['timezoneSetting'] ??= $properties['tzName'];
+            unset($properties['tzName']);
+        }
+
+        foreach ($properties as $key => $value) {
+            if (!\array_key_exists($key, $dateProperties) && property_exists($this, $key)) {
+                $this->$key = $value;
+            }
+        }
+    }
+
