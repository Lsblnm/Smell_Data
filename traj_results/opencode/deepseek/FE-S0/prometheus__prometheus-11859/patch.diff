+// removeChunkSnapshotsAheadOfWAL removes all chunk snapshots whose WAL segment
+// index is higher than the last segment of the current WAL. These snapshots
+// belong to a different WAL (e.g. one that was reset or restored) and cannot be
+// replayed against the current WAL.
+func (h *Head) removeChunkSnapshotsAheadOfWAL() error {
+	if h.wal == nil {
+		return nil
+	}
+
+	_, last, err := wlog.Segments(h.wal.Dir())
+	if err != nil {
+		return errors.Wrap(err, "get WAL segment range")
+	}
+
+	for {
+		dir, idx, _, err := LastChunkSnapshot(h.opts.ChunkDirRoot)
+		if err == record.ErrNotFound {
+			return nil
+		}
+		if err != nil {
+			return errors.Wrap(err, "find last chunk snapshot")
+		}
+		if idx <= last {
+			return nil
+		}
+
+		level.Warn(h.logger).Log(
+			"msg", "removing chunk snapshot ahead of WAL",
+			"dir", dir, "snapshot_index", idx, "wal_index", last,
+		)
+		if err := os.RemoveAll(dir); err != nil {
+			return errors.Wrap(err, "remove chunk snapshot ahead of WAL")
+		}
+	}
+}
