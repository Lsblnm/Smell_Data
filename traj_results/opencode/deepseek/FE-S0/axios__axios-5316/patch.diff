diff --git a/lib/helpers/formDataToStream.js b/lib/helpers/formDataToStream.js
new file mode 100644
index 0000000..3102695
--- /dev/null
+++ b/lib/helpers/formDataToStream.js
@@ -0,0 +1,203 @@
+'use strict';
+
+import {TextEncoder} from 'util';
+import {Readable} from 'stream';
+import utils from '../utils.js';
+import readBlob from './readBlob.js';
+
+const BOUNDARY_ALPHABET = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_';
+
+const textEncoder = new TextEncoder();
+
+const CRLF = '\r\n';
+const CRLF_BYTES = textEncoder.encode(CRLF);
+const CRLF_BYTES_COUNT = CRLF_BYTES.byteLength;
+
+function generateString(size, alphabet) {
+  let result = '';
+
+  for (let i = 0; i < size; i++) {
+    result += alphabet.charAt(Math.floor(Math.random() * alphabet.length));
+  }
+
+  return result;
+}
+
+function escapeName(name) {
+  return String(name).replace(/[\r\n"]/g, (match) => ({
+    '\r': '%0D',
+    '\n': '%0A',
+    '"': '%22'
+  }[match]));
+}
+
+class FormDataPart {
+  constructor(name, value) {
+    const isStringValue = utils.isString(value);
+
+    let headers = `Content-Disposition: form-data; name="${escapeName(name)}"${
+      !isStringValue && value.name ? `; filename="${escapeName(value.name)}"` : ''
+    }${CRLF}`;
+
+    if (isStringValue) {
+      value = textEncoder.encode(String(value).replace(/\r?\n|\r\n?/g, CRLF));
+    } else {
+      headers += `Content-Type: ${value.type || 'application/octet-stream'}${CRLF}`;
+    }
+
+    this.headers = textEncoder.encode(headers + CRLF);
+    this.contentLength = utils.isNumber(value.byteLength) ? value.byteLength : value.size;
+    this.value = value;
+
+    this.size = this.headers.byteLength + this.contentLength + CRLF_BYTES_COUNT;
+  }
+
+  encode() {
+    const self = this;
+    const value = this.value;
+    let stage = 0;
+    let blobIterator;
+
+    return {
+      [Symbol.asyncIterator]() {
+        return this;
+      },
+      async next() {
+        if (stage === 0) {
+          stage = 1;
+          return {done: false, value: self.headers};
+        }
+
+        if (stage === 1) {
+          if (utils.isTypedArray(value) || utils.isArrayBuffer(value) || utils.isBuffer(value)) {
+            stage = 3;
+            return {done: false, value: utils.isBuffer(value) ? value : Buffer.from(value)};
+          }
+
+          blobIterator = readBlob(value)[Symbol.asyncIterator]();
+          stage = 2;
+        }
+
+        if (stage === 2) {
+          const {value: chunk, done} = await blobIterator.next();
+
+          if (!done) {
+            return {done: false, value: chunk};
+          }
+
+          stage = 3;
+        }
+
+        if (stage === 3) {
+          stage = 4;
+          return {done: false, value: CRLF_BYTES};
+        }
+
+        return {done: true};
+      }
+    };
+  }
+}
+
+class FormDataStream {
+  constructor(parts, boundaryBuff, endBuff) {
+    this.parts = parts;
+    this.boundaryBuff = boundaryBuff;
+    this.endBuff = endBuff;
+    this.partIndex = 0;
+    this.partIterator = null;
+    this.endSent = false;
+    this.finished = false;
+  }
+
+  [Symbol.asyncIterator]() {
+    return this;
+  }
+
+  async next() {
+    if (this.finished) {
+      return {done: true};
+    }
+
+    if (!this.partIterator) {
+      if (this.partIndex >= this.parts.length) {
+        if (!this.endSent) {
+          this.endSent = true;
+          return {done: false, value: this.endBuff};
+        }
+
+        this.finished = true;
+        return {done: true};
+      }
+
+      this.partIterator = this.parts[this.partIndex++].encode()[Symbol.asyncIterator]();
+
+      return {done: false, value: this.boundaryBuff};
+    }
+
+    const {value, done} = await this.partIterator.next();
+
+    if (done) {
+      this.partIterator = null;
+      return this.next();
+    }
+
+    return {done: false, value};
+  }
+}
+
+/**
+ * Converts a spec-compliant FormData instance into a Readable stream.
+ *
+ * @param {FormData} form
+ * @param {Function} [headersHandler]
+ * @param {Object} [options]
+ * @param {string} [options.tag]
+ * @param {number} [options.size]
+ * @param {string} [options.boundary]
+ *
+ * @returns {Readable}
+ */
+const formDataToStream = (form, headersHandler, options) => {
+  const {
+    tag = 'form-data-boundary',
+    size = 25,
+    boundary = tag + '-' + generateString(size, BOUNDARY_ALPHABET)
+  } = options || {};
+
+  if (!utils.isSpecCompliantForm(form)) {
+    throw new TypeError('FormData instance expected');
+  }
+
+  if (boundary === undefined || boundary === null) {
+    throw new TypeError('Boundary is required');
+  }
+
+  const parts = [];
+  let totalLength = 0;
+
+  for (const [name, value] of form) {
+    const part = new FormDataPart(name, value);
+
+    parts.push(part);
+    totalLength += part.size;
+  }
+
+  const boundaryBuff = textEncoder.encode('--' + boundary + CRLF);
+  const endBuff = textEncoder.encode('--' + boundary + '--' + CRLF);
+
+  totalLength += (boundaryBuff.byteLength * parts.length) + endBuff.byteLength;
+
+  const stream = Readable.from(new FormDataStream(parts, boundaryBuff, endBuff));
+
+  if (headersHandler) {
+    headersHandler({
+      'Content-Type': 'multipart/form-data; boundary=' + boundary,
+      'Content-Length': totalLength
+    });
+  }
+
+  return stream;
+};
+
+export default formDataToStream;
