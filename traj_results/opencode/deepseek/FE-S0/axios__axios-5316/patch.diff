new file mode 100644
index 0000000..8bfe267
--- /dev/null
+++ b/lib/helpers/readBlob.js
@@ -0,0 +1,28 @@
+'use strict';
+
+import utils from '../utils.js';
+
+function readBlob(blob) {
+  if (utils.isFunction(blob.stream)) {
+    return blob.stream();
+  }
+
+  let read = false;
+
+  return {
+    [Symbol.asyncIterator]() {
+      return this;
+    },
+    async next() {
+      if (read) {
+        return {done: true};
+      }
+
+      read = true;
+
+      return {done: false, value: await blob.arrayBuffer()};
+    }
+  };
+}
+
+export default readBlob;
