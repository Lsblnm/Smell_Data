diff --git a/lib/rubocop/cop/style/redundant_parentheses.rb b/lib/rubocop/cop/style/redundant_parentheses.rb
index 48ece83b0..6eb24136c 100644
--- a/lib/rubocop/cop/style/redundant_parentheses.rb
+++ b/lib/rubocop/cop/style/redundant_parentheses.rb
@@ -47,7 +47,48 @@ module RuboCop
             first_arg_begins_with_hash_literal?(node) ||
             rescue?(node) ||
             allowed_pin_operator?(node) ||
-            allowed_expression?(node)
+            allowed_expression?(node) ||
+            do_block_parentheses_required?(node)
+        end
+
+        def do_block_parentheses_required?(node)
+          node.each_descendant(:block, :numblock, :itblock).any? do |block|
+            !block.braces? && !block.send_node.lambda_literal? && free_do_block?(block, node)
+          end && enclosing_unparenthesized_call(node)
+        end
+
+        def free_do_block?(block, boundary)
+          current = block
+          while (parent = current.parent) && parent != boundary
+            return false unless parent.call_type? && parent.receiver.equal?(current)
+
+            current = parent
+          end
+          true
+        end
+
+        def enclosing_unparenthesized_call(node)
+          current = node
+          loop do
+            parent = current.parent
+            return unless parent
+
+            case parent.type
+            when :send, :csend, :super, :yield
+              return parent if parent.arguments.any? { |argument| argument.equal?(current) }
+              return unless parent.respond_to?(:receiver) && parent.receiver.equal?(current)
+
+              current = parent
+            when :pair
+              current = parent
+            when :hash
+              return if parent.loc.begin
+
+              current = parent
+            else
+              return
+            end
+          end
         end
 
         def ignore_syntax?(node)
