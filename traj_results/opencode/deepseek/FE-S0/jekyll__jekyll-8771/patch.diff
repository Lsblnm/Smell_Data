diff --git a/lib/jekyll/data_entry.rb b/lib/jekyll/data_entry.rb
new file mode 100644
index 000000000..5cce98a60
--- /dev/null
+++ b/lib/jekyll/data_entry.rb
@@ -0,0 +1,77 @@
+# frozen_string_literal: true
+
+module Jekyll
+  class DataEntry
+    attr_reader :data, :path
+
+    def initialize(data, path = nil)
+      @data = data
+      @path = path
+    end
+
+    def [](key)
+      data[key]
+    end
+
+    def []=(key, value)
+      data[key] = value
+    end
+
+    def to_liquid
+      data
+    end
+
+    def ==(other)
+      other = other.data if other.is_a?(DataEntry)
+      data == other
+    end
+    alias_method :eql?, :==
+
+    def <=>(other)
+      other = other.data if other.is_a?(DataEntry)
+      data <=> other
+    end
+
+    def hash
+      data.hash
+    end
+
+    def inspect
+      data.inspect
+    end
+
+    def dup
+      self.class.new(data.dup, path)
+    end
+
+    def each(&block)
+      data.each(&block)
+    end
+
+    def each_key(&block)
+      data.each_key(&block)
+    end
+
+    def merge!(other)
+      other = other.data if other.respond_to?(:data)
+      data.merge!(other) do |key, old_value, new_value|
+        block_given? ? yield(key, old_value, new_value) : new_value
+      end
+      self
+    end
+
+    def merge(other)
+      dup.merge!(other)
+    end
+
+    def method_missing(method, *args, &block)
+      return data.public_send(method, *args, &block) if data.respond_to?(method)
+
+      super
+    end
+
+    def respond_to_missing?(method, include_private = false)
+      data.respond_to?(method, include_private) || super
+    end
+  end
+end
diff --git a/lib/jekyll/data_hash.rb b/lib/jekyll/data_hash.rb
new file mode 100644
index 000000000..b8f7820f1
--- /dev/null
+++ b/lib/jekyll/data_hash.rb
@@ -0,0 +1,184 @@
+# frozen_string_literal: true
+
+module Jekyll
+  class DataHash
+    include Enumerable
+
+    attr_reader :data, :path
+    attr_accessor :current_document
+
+    def initialize(data = {}, site = nil, path = nil)
+      @data = data
+      @site = site
+      @path = path
+    end
+
+    def [](key)
+      value = @data[key]
+      register_dependency(value)
+      value
+    end
+
+    def []=(key, value)
+      raise FrozenError, "can't modify frozen #{self.class}" if frozen?
+
+      @data[key] = value
+    end
+
+    def fetch(key, *args, &block)
+      value = @data.fetch(key, *args, &block)
+      register_dependency(value)
+      value
+    end
+
+    def dig(*keys)
+      raise ArgumentError, "wrong number of arguments (given 0, expected 1+)" if keys.empty?
+
+      value = self[keys.shift]
+      keys.each do |key|
+        value = value[key] if value.respond_to?(:[])
+      end
+      value
+    end
+
+    def key?(key)
+      @data.key?(key)
+    end
+    alias_method :has_key?, :key?
+    alias_method :include?, :key?
+    alias_method :member?, :key?
+
+    def each(&block)
+      @data.each(&block)
+    end
+    alias_method :each_pair, :each
+
+    def each_key(&block)
+      @data.each_key(&block)
+    end
+
+    def each_value(&block)
+      @data.each_value(&block)
+    end
+
+    def keys
+      @data.keys
+    end
+
+    def values
+      @data.values
+    end
+
+    def size
+      @data.size
+    end
+    alias_method :length, :size
+
+    def empty?
+      @data.empty?
+    end
+
+    def to_h
+      @data.to_h
+    end
+    alias_method :to_hash, :to_h
+
+    def to_liquid
+      register_all_dependencies
+      self
+    end
+
+    def to_s
+      @data.to_s
+    end
+
+    def ==(other)
+      other = other.data if other.is_a?(DataHash)
+      data == other
+    end
+    alias_method :eql?, :==
+
+    def inspect
+      @data.inspect
+    end
+
+    def default_proc
+      @data.default_proc
+    end
+
+    def default_proc=(proc)
+      @data.default_proc = proc
+    end
+
+    def dup
+      self.class.new(@data.dup, @site, @path).tap do |copy|
+        copy.current_document = current_document
+      end
+    end
+
+    def merge(other)
+      dup.merge!(other)
+    end
+
+    def merge!(other)
+      other = other.data if other.is_a?(DataHash)
+      if block_given?
+        @data.merge!(other) { |key, old_value, new_value| yield(key, old_value, new_value) }
+      else
+        @data.merge!(other)
+      end
+      self
+    end
+
+    def delete(key)
+      @data.delete(key)
+    end
+
+    def clear
+      @data.clear
+      self
+    end
+
+    def freeze
+      @data.freeze
+      super
+    end
+
+    private
+
+    def register_dependency(value)
+      return unless @site && current_document
+      return unless value.respond_to?(:path) && value.path
+
+      path = document_path
+      return unless path
+
+      @site.regenerator.add_dependency(path, value.path)
+    end
+
+    def register_all_dependencies(data = @data)
+      data.each_value do |value|
+        if value.is_a?(DataHash)
+          register_all_dependencies(value.data)
+        else
+          register_dependency(value)
+        end
+      end
+    end
+
+    def document_path
+      if current_document.is_a?(Jekyll::Page)
+        return @site.in_source_dir(current_document.relative_path)
+      end
+
+      document = current_document.path
+      return unless document
+
+      if Pathname.new(document).absolute?
+        document
+      else
+        @site.in_source_dir(document)
+      end
+    end
+  end
+end
