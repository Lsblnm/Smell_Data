+    private static function maskQuotedSheetSeparators(string $value): string
+    {
+        $masked = '';
+        $inQuotes = false;
+        $length = strlen($value);
+        for ($i = 0; $i < $length; ++$i) {
+            $character = $value[$i];
+            if ($character === "'") {
+                if ($inQuotes && $i + 1 < $length && $value[$i + 1] === "'") {
+                    $masked .= "''";
+                    ++$i;
+                    continue;
+                }
+                $inQuotes = !$inQuotes;
+                $masked .= $character;
+                continue;
+            }
+            if ($inQuotes && $character === '.') {
+                $masked .= "\x1A";
+            } elseif ($inQuotes && $character === ':') {
+                $masked .= "\x1B";
+            } else {
+                $masked .= $character;
+            }
+        }
+
+        return $masked;
+    }
+
+    private static function unmaskQuotedSheetSeparators(string $value): string
+    {
+        return str_replace(["\x1A", "\x1B"], ['.', ':'], $value);
     }
 
