+			// 4. Add used type names from the extends and implements clauses.
+			JCClassDecl td = (JCClassDecl) typeNode.get();
+			JCTree extendsClause = Javac.getExtendsClause(td);
+			if (extendsClause != null) addFirstTypeName(usedNames, extendsClause);
+			for (JCExpression implementsClause : td.implementing) addFirstTypeName(usedNames, implementsClause);
+
 			return usedNames;
 		}
+
+		private void addFirstTypeName(java.util.HashSet<String> usedNames, JCTree type) {
+			while (type instanceof JCTypeApply) type = ((JCTypeApply) type).clazz;
+			while (type instanceof JCFieldAccess) type = ((JCFieldAccess) type).selected;
+			if (type instanceof JCIdent) usedNames.add(((JCIdent) type).name.toString());
+		}
 	}
 	
