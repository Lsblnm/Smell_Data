+const cssVarNameEscapeSymbolsRE =
+  /[ !"#$%&'()*+,./:;<=>?@[\\\]^`{|}~\-]/g
+
 export class CssVarNamePolicy {
   constructor(public readonly prefix: string) {}
 
+  escape(name: string): string {
+    return name.replace(cssVarNameEscapeSymbolsRE, s => `\\${s}`)
+  }
+
   static standard(): CssVarNamePolicy {
     return new CssVarNamePolicy('--')
   }
