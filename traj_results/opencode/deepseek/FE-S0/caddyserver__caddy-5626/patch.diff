+// sameLine returns true if the token is on the same line as the
+// other token. Tokens from different files, snippets, or import
+// expansions are never considered to be on the same line, even if
+// their line numbers happen to match.
+func (t Token) sameLine(other Token) bool {
+	if t.File != other.File || t.snippetName != other.snippetName {
+		return false
+	}
+	if t.Line+t.NumLineBreaks() != other.Line {
+		return false
+	}
+	if len(t.imports) != len(other.imports) {
+		return false
+	}
+	for i := range t.imports {
+		if t.imports[i] != other.imports[i] {
+			return false
+		}
+	}
+	return true
+}
