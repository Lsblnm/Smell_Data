+		if (typeNode == null || typeNode.getKind() != Kind.TYPE_USE) return null;
+		EclipseNode fieldNode = typeNode.directUp();
+		if (fieldNode == null || fieldNode.getKind() != Kind.FIELD) return null;
+		EclipseNode owner = fieldNode.up();
+		if (owner == null || owner.getKind() != Kind.TYPE || !isRecord(owner)) return null;
+		
+		ASTNode astNode = typeNode.get();
+		if (!(astNode instanceof TypeReference)) return null;
+		Annotation[] anns = EclipseAST.getTopLevelTypeReferenceAnnotations((TypeReference) astNode);
+		if (anns == null) return null;
+		for (Annotation ann : anns) if (annotationNode.get() == ann) return fieldNode;
+		return null;
+	}
