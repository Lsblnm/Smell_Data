+    private function isClassBodyOpenBrace(Tokens $tokens, int $index): bool
+    {
+        $classyKinds = [T_CLASS, T_INTERFACE, T_TRAIT];
+        if (\defined('T_ENUM')) { // @TODO: drop condition when PHP 8.1+ is required
+            $classyKinds[] = T_ENUM;
+        }
+
+        $stopKinds = [T_CATCH, T_DECLARE, T_DO, T_ELSE, T_ELSEIF, T_FINALLY, T_FN, T_FOR, T_FOREACH, T_FUNCTION, T_IF, T_NAMESPACE, T_OPEN_TAG, T_SWITCH, T_TRY, T_USE, T_WHILE];
+        if (\defined('T_MATCH')) { // @TODO: drop condition when PHP 8.0+ is required
+            $stopKinds[] = T_MATCH;
+        }
+
+        $searchIndex = $tokens->getPrevMeaningfulToken($index);
+
+        while (null !== $searchIndex) {
+            $token = $tokens[$searchIndex];
+
+            if ($token->isGivenKind($classyKinds)) {
+                return true;
+            }
+
+            if ($token->isGivenKind($stopKinds) || $token->equalsAny([';', '{', '}'])) {
+                return false;
+            }
+
+            if ($token->equals(')')) {
+                $searchIndex = $tokens->findBlockStart(Tokens::BLOCK_TYPE_PARENTHESIS_BRACE, $searchIndex);
+            } elseif ($token->equals(']')) {
+                $searchIndex = $tokens->findBlockStart(Tokens::BLOCK_TYPE_INDEX_SQUARE_BRACE, $searchIndex);
+            }
+
+            $searchIndex = $tokens->getPrevMeaningfulToken($searchIndex);
+        }
+
+        return false;
+    }
+
+    private function findMemberDeclarationEndIndex(Tokens $tokens, int $index, int $parentScopeEndIndex): int
+    {
+        for ($searchEndIndex = $index; $searchEndIndex <= $parentScopeEndIndex; ++$searchEndIndex) {
+            $searchEndToken = $tokens[$searchEndIndex];
+
+            if ($searchEndToken->equalsAny(['(', '{', [CT::T_ARRAY_SQUARE_BRACE_OPEN], [CT::T_DESTRUCTURING_SQUARE_BRACE_OPEN]])) {
+                if ($searchEndToken->equals('(')) {
+                    $blockType = Tokens::BLOCK_TYPE_PARENTHESIS_BRACE;
+                } elseif ($searchEndToken->equals('{')) {
+                    $blockType = Tokens::BLOCK_TYPE_CURLY_BRACE;
+                } elseif ($searchEndToken->isGivenKind(CT::T_ARRAY_SQUARE_BRACE_OPEN)) {
+                    $blockType = Tokens::BLOCK_TYPE_ARRAY_SQUARE_BRACE;
+                } else {
+                    $blockType = Tokens::BLOCK_TYPE_DESTRUCTURING_SQUARE_BRACE;
+                }
+
+                $searchEndIndex = $tokens->findBlockEnd($blockType, $searchEndIndex);
+
+                continue;
+            }
+
+            if ($searchEndToken->equals(';')) {
+                return $searchEndIndex;
+            }
+        }
+
+        return $parentScopeEndIndex;
+    }
+
+    private function isMemberStartOnContinuationLine(Tokens $tokens, int $index): bool
+    {
+        $modifierKinds = [T_ABSTRACT, T_FINAL, T_PRIVATE, T_PROTECTED, T_PUBLIC, T_STATIC];
+        if (\defined('T_READONLY')) { // @TODO: drop condition when PHP 8.1+ is required
+            $modifierKinds[] = T_READONLY;
+        }
+
+        $currentIndex = $index;
+
+        while (null !== $previousIndex = $tokens->getPrevMeaningfulToken($currentIndex)) {
+            if (!$tokens[$previousIndex]->isGivenKind($modifierKinds)) {
+                break;
+            }
+
+            for ($i = $previousIndex + 1; $i < $currentIndex; ++$i) {
+                if ($tokens[$i]->isWhitespace() && Preg::match('/\R/', $tokens[$i]->getContent())) {
+                    return true;
+                }
+            }
+
+            $currentIndex = $previousIndex;
+        }
+
+        return false;
+    }
+
+    private function isNestedInSquareBrace(Tokens $tokens, int $startIndex, int $index): bool
+    {
+        for ($searchIndex = $startIndex; $searchIndex < $index; ++$searchIndex) {
+            $token = $tokens[$searchIndex];
+
+            if ($token->isGivenKind([CT::T_ARRAY_SQUARE_BRACE_OPEN, CT::T_DESTRUCTURING_SQUARE_BRACE_OPEN])) {
+                $blockType = $token->isGivenKind(CT::T_ARRAY_SQUARE_BRACE_OPEN)
+                    ? Tokens::BLOCK_TYPE_ARRAY_SQUARE_BRACE
+                    : Tokens::BLOCK_TYPE_DESTRUCTURING_SQUARE_BRACE;
+
+                $endIndex = $tokens->findBlockEnd($blockType, $searchIndex);
+            } elseif ($token->equals('[')) {
+                $endIndex = $tokens->findBlockEnd(Tokens::BLOCK_TYPE_INDEX_SQUARE_BRACE, $searchIndex);
+            } else {
+                continue;
+            }
+
+            if ($endIndex >= $index) {
+                return true;
             }
+
+            $searchIndex = $endIndex;
         }
+
+        return false;
     }
 
     private function findStatementEndIndex(Tokens $tokens, int $index, int $parentScopeEndIndex): int
