+    /**
+     * @param list<Token> $tokensToInsert
+     */
+    private static function getInsertedAttributeArguments(array $tokensToInsert): string
+    {
+        $arguments = '';
+        $depth = 0;
+
+        foreach ($tokensToInsert as $token) {
+            if ($token->equals('(')) {
+                ++$depth;
+                if (1 === $depth) {
+                    continue;
+                }
+            } elseif ($token->equals(')')) {
+                --$depth;
+                if (0 === $depth) {
+                    break;
+                }
+            }
+
+            if ($depth > 0 && !$token->isWhitespace()) {
+                $arguments .= $token->getContent();
+            }
+        }
+
+        return $arguments;
+    }
+
+    private static function getExistingAttributeArguments(Tokens $tokens, int $startIndex, int $endIndex): string
+    {
+        $openIndex = null;
+
+        for ($index = $startIndex; $index <= $endIndex; ++$index) {
+            if ($tokens[$index]->equals('(')) {
+                $openIndex = $index;
+
+                break;
+            }
+        }
+
+        if (null === $openIndex) {
+            return '';
+        }
+
+        $closeIndex = $tokens->findBlockEnd(Tokens::BLOCK_TYPE_PARENTHESIS_BRACE, $openIndex);
+        $arguments = '';
+
+        for ($argumentIndex = $openIndex + 1; $argumentIndex < $closeIndex; ++$argumentIndex) {
+            if (!$tokens[$argumentIndex]->isWhitespace()) {
+                $arguments .= $tokens[$argumentIndex]->getContent();
+            }
+        }
+
+        return $arguments;
+    }
