+        # @param method [Symbol]
+        # @param path [String]
+        # @param app [Object]
+        def mount(method, path, app)
+          table =
+            case method
+            when :get
+              @get_routes
+            when :head
+              @head_routes
+            when :post
+              @post_routes
+            when :put
+              @put_routes
+            when :patch
+              @patch_routes
+            else
+              @other_routes.fetch(method)
+            end
+          if table.include?(path)
+            raise "#{path} is already mounted"
+          end
+
+          table[path] = app
+        end
+
