+    auto* shifts = align == align::left ? data::left_padding_shifts
+                                        : data::right_padding_shifts;
+    size_t left_padding = padding >> shifts[specs.align];
     size_t right_padding = padding - left_padding;
     const auto& fill = specs.fill;
     auto fill_size = fill.size();
@@ -1833,7 +1836,7 @@ OutputIt write(OutputIt out, T value, basic_format_specs<Char> specs,
   if (fspecs.format == float_format::hex) {
     if (fspecs.sign) buffer.push_back(data::signs[fspecs.sign]);
     snprintf_float(promote_float(value), specs.precision, fspecs, buffer);
-    return write_bytes_data<Char>({buffer.data(), buffer.size()})
+    return write_bytes_data<Char, align::right>({buffer.data(), buffer.size()})
         .write_bytes(out, specs);
   }
   int precision = specs.precision >= 0 || !specs.type ? specs.precision : 6;
