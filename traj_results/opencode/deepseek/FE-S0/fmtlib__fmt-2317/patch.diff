diff --git a/include/fmt/format.h b/include/fmt/format.h
index 2627812d..c7e27789 100644
--- a/include/fmt/format.h
+++ b/include/fmt/format.h
@@ -1310,7 +1310,8 @@ constexpr OutputIt write_padded(OutputIt out,
 
 // Data for writing a byte sequence padded according to format specs. It is used
 // to avoid template code bloat.
-template <typename Char> struct write_bytes_data {
+template <typename Char, align::type align = align::left>
+struct write_bytes_data {
   const char* bytes;
   size_t size;
 
@@ -1322,7 +1323,9 @@ template <typename Char> struct write_bytes_data {
                                      const basic_format_specs<Char>& specs) const {
