+fn split_into_columns<'a>(
+    separator: &Regex,
+    contents: &'a str,
+    max_split: Option<usize>,
+    collapse_empty: bool,
+) -> Vec<&'a str> {
+    let mut split_result: Vec<&str> = match max_split {
+        Some(max_split) => separator.splitn(contents, max_split).collect(),
+        None => separator.split(contents).collect(),
+    };
+    if collapse_empty {
+        split_result.retain(|piece| !piece.is_empty());
+    }
+    split_result
+}
