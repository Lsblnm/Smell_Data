+    private function isClassMemberDeclarationStart(Tokens $tokens, int $index, array $propertyModifierTokens): bool
+    {
+        $token = $tokens[$index];
+
+        if (
+            !$token->isGivenKind(T_CONST)
+            && !$token->isGivenKind(T_VAR)
+            && !$token->isGivenKind($propertyModifierTokens)
+        ) {
+            return false;
+        }
+
+        $isConst = $token->isGivenKind(T_CONST);
+        $hasVariable = $token->isGivenKind(T_VAR);
+        $blockEdgeDefinitions = Tokens::getBlockEdgeDefinitions();
+
+        for ($searchIndex = $index + 1, $max = \count($tokens); $searchIndex < $max; ++$searchIndex) {
+            $searchToken = $tokens[$searchIndex];
+
+            if ($searchToken->isWhitespace() || $searchToken->isComment()) {
+                continue;
+            }
+
+            if ($searchToken->equals(';')) {
+                return $isConst || $hasVariable;
+            }
+
+            if ($searchToken->equalsAny([')', ']', '}'])) {
+                return false;
+            }
+
+            foreach ($blockEdgeDefinitions as $blockType => $definition) {
+                if ($searchToken->equals($definition['start'])) {
+                    $searchIndex = $tokens->findBlockEnd($blockType, $searchIndex);
+
+                    continue 2;
+                }
+            }
+
+            if ($isConst || $hasVariable) {
+                continue;
+            }
+
+            if ($searchToken->isGivenKind([T_FUNCTION, T_FN, T_CLASS, T_INTERFACE, T_TRAIT])) {
+                return false;
+            }
+
+            if (\defined('T_ENUM') && $searchToken->isGivenKind(T_ENUM)) { // @TODO: drop condition when PHP 8.1+ is required
+                return false;
+            }
+
+            if ($searchToken->isGivenKind(T_CONST)) {
+                $isConst = true;
+
+                continue;
+            }
+
+            if ($searchToken->isGivenKind(T_VARIABLE)) {
+                $hasVariable = true;
+            }
+        }
+
+        return false;
+    }
