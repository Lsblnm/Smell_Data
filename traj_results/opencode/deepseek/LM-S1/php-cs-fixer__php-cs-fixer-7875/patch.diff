+            if ($searchToken->isGivenKind($nonClassBlockTokens) || $searchToken->equalsAny([';', '{', '}', [T_OPEN_TAG], [T_CLOSE_TAG]])) {
+                return false;
+            }
+        }
+
+        return false;
+    }
