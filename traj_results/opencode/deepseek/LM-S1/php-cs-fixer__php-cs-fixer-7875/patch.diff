+    private function findClassMemberDeclarationEndIndex(Tokens $tokens, int $index, int $parentScopeEndIndex): int
+    {
+        $blockEdgeDefinitions = Tokens::getBlockEdgeDefinitions();
+
+        for ($searchIndex = $index + 1; $searchIndex <= $parentScopeEndIndex; ++$searchIndex) {
+            $searchToken = $tokens[$searchIndex];
+
+            if ($searchToken->equals(';')) {
+                return $searchIndex;
+            }
+
+            foreach ($blockEdgeDefinitions as $blockType => $definition) {
+                if ($searchToken->equals($definition['start'])) {
+                    $searchIndex = $tokens->findBlockEnd($blockType, $searchIndex);
+
+                    continue 2;
+                }
+            }
+        }
+
+        return $parentScopeEndIndex;
+    }
+
