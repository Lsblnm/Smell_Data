+function processAtRule(node: AtRule) {
+  if (!node.nodes || !node.nodes.some(n => n.type === 'decl')) {
+    return
+  }
+
+  let parent: Document | Container | undefined = node.parent
+  let nested = false
+  while (parent && parent.type !== 'root') {
+    if (parent.type === 'rule') {
+      nested = true
+      if ((parent as any).__deep) {
+        return
+      }
+      break
+    }
+    parent = parent.parent
+  }
+  if (!nested) {
+    return
+  }
+
+  const decls = node.nodes.filter(
+    n => n.type === 'decl' || n.type === 'comment',
+  )
+  if (!decls.length) {
+    return
+  }
+
+  for (const decl of decls) {
+    node.removeChild(decl)
+  }
+  node.prepend(
+    new Rule({
+      nodes: decls,
+      selector: '&',
+    }),
+  )
+}
