diff --git a/lib/fpm/package/deb.rb b/lib/fpm/package/deb.rb
index 09719db..4e66fac 100644
--- a/lib/fpm/package/deb.rb
+++ b/lib/fpm/package/deb.rb
@@ -789,11 +789,28 @@ class FPM::Package::Deb < FPM::Package
       provides = provides.gsub("_", "-")
     end
 
-    if m = provides.match(/^([A-Za-z0-9_-]+)\s*=\s*(\d+.*$)/)
+    if m = provides.match(/^([A-Za-z0-9_.+-]+)\s*=\s*(\d+.*$)/)
       logger.warn("Replacing 'provides' entry #{provides} with syntax 'name (= version)'")
       provides = "#{m[1]} (= #{m[2]})"
     end
-    return provides.rstrip
+    provides = provides.rstrip
+
+    # Debian policy permits a Provides entry to be either a package name or a
+    # package name with an exact version, such as "foo (= 1.0)". Other
+    # relations, including "<<" and ">>", are not allowed here.
+    # See https://www.debian.org/doc/debian-policy/ch-relationships.html
+    name_pattern = /[a-z0-9][a-z0-9+.-]*/
+    version_pattern = /(?:[0-9]+:)?[0-9][A-Za-z0-9.+~:]*(?:-[A-Za-z0-9.+~]+)*/
+
+    if provides =~ /\A#{name_pattern}\z/ or
+        provides =~ /\A#{name_pattern} \(= #{version_pattern}\)\z/
+      return provides
+    else
+      raise FPM::InvalidPackageConfiguration,
+        "Invalid 'provides' entry '#{provides}'. Debian provides must be a " \
+        "package name or a package name with an exact version, like " \
+        "'foo (= 1.0)'."
+    end
   end
 
   def control_path(path=nil)
