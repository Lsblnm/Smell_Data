+
+// findRemovedResourceConfig returns the "removed" block that applies to the
+// resource at the given address, or nil if there is no such block.
+//
+// Removed blocks are declared relative to the module they appear in, and can
+// target resources in child modules, so a matching block may be in any ancestor
+// of the module containing the resource. We visit the configuration tree in
+// pre-order because a removed block in a parent module overrides one targeting
+// the same object in a child module.
+func findRemovedResourceConfig(cfg *configs.Config, addr addrs.ConfigResource) *configs.Removed {
+	if cfg == nil {
+		return nil
+	}
+
+	for _, rem := range cfg.Module.Removed {
+		crAddr, ok := rem.From.RelSubject.(addrs.ConfigResource)
+		if !ok {
+			// Not for a resource at all, so can't possibly match.
+			continue
+		}
+
+		module := make(addrs.Module, 0, len(cfg.Path)+len(crAddr.Module))
+		module = append(module, cfg.Path...)
+		module = append(module, crAddr.Module...)
+		absAddr := addrs.ConfigResource{
+			Module:   module,
+			Resource: crAddr.Resource,
+		}
+		if absAddr.Equal(addr) {
+			return rem
+		}
+	}
+
+	for _, child := range cfg.Children {
+		if rem := findRemovedResourceConfig(child, addr); rem != nil {
+			return rem
+		}
+	}
+
+	return nil
+}
