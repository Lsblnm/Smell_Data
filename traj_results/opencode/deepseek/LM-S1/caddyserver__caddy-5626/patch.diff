diff --git a/caddyconfig/caddyfile/dispenser.go b/caddyconfig/caddyfile/dispenser.go
index 580de4a9..2df0da2f 100644
--- a/caddyconfig/caddyfile/dispenser.go
+++ b/caddyconfig/caddyfile/dispenser.go
@@ -471,6 +471,14 @@ func (d *Dispenser) isNewLine() bool {
 		return true
 	}
 
+	// If the tokens are from different import chains, they
+	// are logically on different lines, even if their source
+	// line numbers suggest otherwise (e.g. snippets defined
+	// before the directive that imports them).
+	if !sameImportChain(prev.imports, curr.imports) {
+		return true
+	}
+
 	// If the previous token (incl line breaks) ends
 	// on a line earlier than the current token,
 	// then the current token is on a new line
@@ -497,8 +505,29 @@ func (d *Dispenser) isNextOnNewLine() bool {
 		return true
 	}
 
+	// If the tokens are from different import chains, they
+	// are logically on different lines, even if their source
+	// line numbers suggest otherwise.
+	if !sameImportChain(curr.imports, next.imports) {
+		return true
+	}
+
 	// If the current token (incl line breaks) ends
 	// on a line earlier than the next token,
 	// then the next token is on a new line
 	return curr.Line+curr.NumLineBreaks() < next.Line
 }
+
+// sameImportChain returns true if both token import chains
+// are identical.
+func sameImportChain(a, b []string) bool {
+	if len(a) != len(b) {
+		return false
+	}
+	for i := range a {
+		if a[i] != b[i] {
+			return false
+		}
+	}
+	return true
+}
