+  private Request getNewRequestUrlInvalidatingCache(Request request) throws IOException
+  {
+    final String refreshedLeader = currentKnownLeader.accumulateAndGet(
+        null,
+        (current, given) -> {
+          Iterator<DiscoveryDruidNode> discoveredNodes = druidNodeDiscovery.getAllNodes().iterator();
+          if (!discoveredNodes.hasNext()) {
+            return null;
+          }
+          DiscoveryDruidNode discoveredNode = discoveredNodes.next();
+          String scheme;
+          if (discoveredNode.getDruidNode().getTlsPort() >= 0) {
+            scheme = "https";
+          } else {
+            scheme = "http";
+          }
+          String hostAndPortToUse;
+          if (discoveredNode.getDruidNode().isEnableTlsPort()) {
+            hostAndPortToUse = HostAndPort.fromParts(
+                discoveredNode.getDruidNode().getHost(),
+                discoveredNode.getDruidNode().getTlsPort()
+            ).toString();
+          } else if (discoveredNode.getDruidNode().isEnablePlaintextPort()) {
+            if (discoveredNode.getDruidNode().getPlaintextPort() < 0) {
+              hostAndPortToUse = HostAndPort.fromString(
+                  discoveredNode.getDruidNode().getHost()
+              ).toString();
+            } else {
+              hostAndPortToUse = HostAndPort.fromParts(
+                  discoveredNode.getDruidNode().getHost(),
+                  discoveredNode.getDruidNode().getPlaintextPort()
+              ).toString();
+            }
+          } else {
+            hostAndPortToUse = null;
+          }
+          String rawLeader = StringUtils.format("%s://%s", scheme, hostAndPortToUse);
+          if (hostAndPortToUse == null || hostAndPortToUse.isEmpty()) {
+            return rawLeader;
+          }
+          try {
+            URI parsedLeader = URI.create(rawLeader);
+            if (parsedLeader.getScheme() == null) {
+              return rawLeader;
+            }
+            if (parsedLeader.getAuthority() == null) {
+              return rawLeader;
+            }
+            return StringUtils.format("%s://%s", parsedLeader.getScheme(), parsedLeader.getAuthority());
+          }
+          catch (IllegalArgumentException ignored) {
+            return rawLeader;
+          }
+        }
+    );
+    if (refreshedLeader == null) {
+      throw new IOE("No known server");
+    }
+    try {
+      final URL currentUrl = request.getUrl();
+      final String path = currentUrl.getPath();
+      final String query = currentUrl.getQuery();
+      final URL rebuiltUrl;
+      if (query == null) {
+        rebuiltUrl = new URL(StringUtils.format("%s%s", refreshedLeader, path));
+      } else {
+        rebuiltUrl = new URL(StringUtils.format("%s%s?%s", refreshedLeader, path, query));
+      }
+      Request rebuiltRequest = new Request(request.getMethod(), rebuiltUrl);
+      for (Map.Entry<String, Collection<String>> headerEntry : request.getHeaders().asMap().entrySet()) {
+        rebuiltRequest.addHeaderValues(headerEntry.getKey(), headerEntry.getValue());
+      }
+      if (request.hasContent()) {
+        rebuiltRequest.setContent(request.getContent());
+      }
+      return rebuiltRequest;
+    }
+    catch (MalformedURLException e) {
+      // Not an IOException; this is our own fault.
+      throw new ISE(
+          e,
+          "failed to build url with path[%] and query string [%s].",
+          request.getUrl().getPath(),
+          request.getUrl().getQuery()
+      );
+    }
+  }
