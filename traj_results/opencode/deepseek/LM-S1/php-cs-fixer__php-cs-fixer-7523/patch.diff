+    private function isFunctionParameterReference(int $index): bool
+    {
+        $tokens = $this->tokens;
+
+        $nameIndex = $tokens->getNextMeaningfulToken($index);
+
+        if (null === $nameIndex) {
+            return false;
+        }
+
+        if ($tokens[$nameIndex]->isGivenKind(T_ELLIPSIS)) {
+            $nameIndex = $tokens->getNextMeaningfulToken($nameIndex);
+        }
+
+        if (null === $nameIndex || !$tokens[$nameIndex]->isGivenKind(T_VARIABLE)) {
+            return false;
+        }
+
+        $argumentsAnalyzer = new ArgumentsAnalyzer();
+        $functionIndex = $index;
+
+        while (null !== $functionIndex = $tokens->getPrevTokenOfKind($functionIndex, [[T_FUNCTION], [T_FN]])) {
+            $argumentsStart = $tokens->getNextTokenOfKind($functionIndex, ['(']);
+
+            if (null === $argumentsStart) {
+                continue;
+            }
+
+            $argumentsEnd = $tokens->findBlockEnd(Tokens::BLOCK_TYPE_PARENTHESIS_BRACE, $argumentsStart);
+
+            if ($index < $argumentsStart || $index > $argumentsEnd) {
+                continue;
+            }
+
+            foreach ($argumentsAnalyzer->getArguments($tokens, $argumentsStart, $argumentsEnd) as $startIndex => $endIndex) {
+                if ($index < $startIndex || $index > $endIndex) {
+                    continue;
+                }
+
+                $argumentNameIndex = null;
+
+                for ($i = $startIndex; $i <= $endIndex; ++$i) {
+                    if (\defined('T_ATTRIBUTE') && $tokens[$i]->isGivenKind(T_ATTRIBUTE)) {
+                        $i = $tokens->findBlockEnd(Tokens::BLOCK_TYPE_ATTRIBUTE, $i);
+
+                        continue;
+                    }
+
+                    if ($tokens[$i]->isGivenKind(T_VARIABLE)) {
+                        $argumentNameIndex = $i;
+
+                        break;
+                    }
+                }
+
+                return null !== $argumentNameIndex && $index < $argumentNameIndex && $argumentNameIndex === $nameIndex;
+            }
+
+            return false;
+        }
+
+        return false;
+    }
