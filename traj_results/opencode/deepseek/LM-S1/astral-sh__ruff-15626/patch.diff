+/// Returns `true` if the type of `expr` is known to implement `__eq__` and `__ne__` such that
+/// they return a `bool`.
+fn is_known_to_return_bool(expr: &Expr) -> bool {
+    matches!(
+        ResolvedPythonType::from(expr),
+        ResolvedPythonType::Atom(_) | ResolvedPythonType::Union(_)
+    )
+}
+
+/// Returns the applicability of replacing `not left == right` with `left != right` (or the
+/// equivalent for `!=`).
+fn comparison_applicability(left: &Expr, right: &Expr) -> Applicability {
+    if is_known_to_return_bool(left) && is_known_to_return_bool(right) {
+        Applicability::Safe
+    } else {
+        Applicability::Unsafe
+    }
+}
