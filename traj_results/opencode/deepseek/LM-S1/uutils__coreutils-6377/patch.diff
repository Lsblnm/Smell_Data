+#[cfg(unix)]
+fn parse_ignore_signals(matches: &clap::ArgMatches) -> UResult<Vec<IgnoreSignal>> {
+    let mut signals: Vec<IgnoreSignal> = Vec::new();
+    let Some(values) = matches.get_many::<OsString>("ignore-signal") else {
+        return Ok(signals);
+    };
+
+    let mut set_signal = |new_signal: IgnoreSignal| {
+        if let Some(existing) = signals
+            .iter_mut()
+            .find(|signal| signal.signal == new_signal.signal)
+        {
+            *existing = new_signal;
+        } else {
+            signals.push(new_signal);
+        }
+    };
+
+    for value in values {
+        let value = value.to_string_lossy();
+        if value == ALL_SIGNALS_ARG {
+            for signal in 1..ALL_SIGNALS.len() {
+                set_signal(IgnoreSignal {
+                    signal,
+                    ignore_errors: true,
+                });
+            }
+        } else if !value.is_empty() {
+            for signal in value.split(',') {
+                if signal.is_empty() {
+                    continue;
+                }
+
+                match signal_by_name_or_value(&signal.to_uppercase()) {
+                    Some(0) | None => {
+                        return Err(USimpleError::new(
+                            125,
+                            format!("{}: invalid signal", OsStr::new(signal).quote()),
+                        ));
+                    }
+                    Some(signal) => set_signal(IgnoreSignal {
+                        signal,
+                        ignore_errors: false,
+                    }),
+                }
+            }
+        }
+    }
+
+    Ok(signals)
+}
+
+#[cfg(unix)]
+fn apply_ignore_signals(signals: &[IgnoreSignal]) -> UResult<()> {
+    for ignore_signal in signals {
+        let signal = Signal::try_from(ignore_signal.signal as i32).map_err(|_| {
+            USimpleError::new(
+                125,
+                format!(
+                    "failed to set signal action for signal {}: Invalid argument",
+                    ignore_signal.signal
+                ),
+            )
+        })?;
+        // Ignoring SIGCHLD makes the child process reap itself, causing `wait` to
+        // fail. It is ignored by default anyway, so leave it unchanged.
+        if signal == Signal::SIGCHLD {
+            continue;
+        }
+        let action = SigAction::new(SigHandler::SigIgn, SaFlags::empty(), SigSet::empty());
+        if let Err(error) = unsafe { sigaction(signal, &action) } {
+            if !ignore_signal.ignore_errors {
+                return Err(USimpleError::new(
+                    125,
+                    format!(
+                        "failed to set signal action for signal {}: {}",
+                        signal as i32,
+                        error.desc()
+                    ),
+                ));
+            }
+        }
+    }
+
+    Ok(())
+}
