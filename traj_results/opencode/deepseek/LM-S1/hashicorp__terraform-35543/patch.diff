+func (n *NodeValidatableResource) validateImport(ctx EvalContext) tfdiags.Diagnostics {
+	var diags tfdiags.Diagnostics
+
+	if len(n.importTargets) == 0 {
+		return diags
+	}
+
+	// Import blocks are only valid within the root module, and must be
+	// evaluated within that context.
+	ctx = evalContextForModuleInstance(ctx, addrs.RootModuleInstance)
+
+	for _, imp := range n.importTargets {
+		if imp.Config == nil {
+			// Legacy imports supplied on the command line have no config to
+			// validate.
+			continue
+		}
+
+		cfg := imp.Config
+
+		if cfg.ForEach == nil {
+			traversal, hclDiags := hcl.AbsTraversalForExpr(cfg.To)
+			diags = diags.Append(hclDiags)
+			to, toDiags := addrs.ParseAbsResourceInstance(traversal)
+			diags = diags.Append(toDiags)
+			if diags.HasErrors() {
+				return diags
+			}
+
+			_, evalDiags := evaluateImportIdExpression(cfg.ID, to, ctx, EvalDataForNoInstanceKey, true)
+			diags = diags.Append(evalDiags)
+			if evalDiags.HasErrors() {
+				return diags
+			}
+			continue
+		}
+
+		// During validation we don't necessarily know the values of all the
+		// objects referenced by for_each, so we allow unknown values here.
+		// The full expansion is validated again during planning.
+		forEachData, known, forEachDiags := newForEachEvaluator(cfg.ForEach, ctx, true).ImportValues()
+		diags = diags.Append(forEachDiags)
+		if forEachDiags.HasErrors() {
+			return diags
+		}
+		if !known {
+			continue
+		}
+
+		for _, keyData := range forEachData {
+			to, toDiags := evalImportToExpression(cfg.To, keyData)
+			diags = diags.Append(toDiags)
+			if toDiags.HasErrors() {
+				return diags
+			}
+
+			_, evalDiags := evaluateImportIdExpression(cfg.ID, to, ctx, keyData, true)
+			diags = diags.Append(evalDiags)
+			if evalDiags.HasErrors() {
+				return diags
+			}
+		}
+	}
+
+	return diags
+}
