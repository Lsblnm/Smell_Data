+    fn print_header_text_chunk(
+        &mut self,
+        handle: &mut OutputHandle,
+        chunk: &str,
+        offset: usize,
+        value_start: usize,
+        value_end: usize,
+    ) -> Result<()> {
+        self.print_header_component_indent(handle)?;
+
+        let chunk_end = offset + chunk.len();
+        let chunk_value_start = value_start.max(offset);
+        let chunk_value_end = value_end.min(chunk_end);
+
+        if offset < chunk_value_start {
+            write!(handle, "{}", &chunk[..chunk_value_start - offset])?;
+        }
+        if chunk_value_start < chunk_value_end {
+            write!(
+                handle,
+                "{}",
+                self.colors.header_value.paint(
+                    &chunk[chunk_value_start - offset..chunk_value_end - offset]
+                )
+            )?;
+        }
+        if chunk_value_end < chunk_end {
+            write!(handle, "{}", &chunk[chunk_value_end - offset..])?;
+        }
+
+        writeln!(handle)?;
+        Ok(())
+    }
+
+    fn print_header_component_text(
+        &mut self,
+        handle: &mut OutputHandle,
+        text: &str,
+        value_start: usize,
+        value_end: usize,
+    ) -> Result<()> {
+        let available_width = if self.panel_width > 0 {
+            self.config.term_width.saturating_sub(
+                self.panel_width + usize::from(self.config.style_components.grid()) * 2,
+            )
+        } else {
+            self.config.term_width
+        };
+
+        let wrap = self.config.wrapping_mode == WrappingMode::Character;
+        let mut line_start = 0usize;
+        let mut line_width = 0usize;
+
+        for (index, character) in text.char_indices() {
+            let character_width = character.width().unwrap_or(0);
+
+            if wrap && line_width > 0 && line_width + character_width > available_width {
+                self.print_header_text_chunk(
+                    handle,
+                    &text[line_start..index],
+                    line_start,
+                    value_start,
+                    value_end,
+                )?;
+                line_start = index;
+                line_width = 0;
+            }
+
+            line_width += character_width;
+        }
+
+        self.print_header_text_chunk(
+            handle,
+            &text[line_start..],
+            line_start,
+            value_start,
+            value_end,
+        )
+    }
+
