+    /**
+     * @param list<Token> $tokensToInsert
+     *
+     * @return array{string, list<Token>}
+     */
+    private static function getInsertedAttributeNameAndArguments(array $tokensToInsert): array
+    {
+        $tokensToInsert = \array_slice($tokensToInsert, 3);
+        $className = '';
+        $arguments = [];
+        $totalTokens = \count($tokensToInsert);
+
+        for ($index = 0; $index < $totalTokens; ++$index) {
+            $token = $tokensToInsert[$index];
+
+            if ($token->isGivenKind(CT::T_ATTRIBUTE_CLOSE)) {
+                break;
+            }
+
+            if (!$token->equals('(')) {
+                $className .= $token->getContent();
+
+                continue;
+            }
+
+            for (; $index < $totalTokens; ++$index) {
+                $arguments[] = $tokensToInsert[$index];
+                if ($tokensToInsert[$index]->equals(')')) {
+                    break;
+                }
+            }
+
+            break;
+        }
+
+        return [$className, $arguments];
+    }
+
+    /**
+     * @return list<Token>
+     */
+    private static function getAttributeArguments(Tokens $tokens, int $startIndex, int $endIndex): array
+    {
+        for ($index = $startIndex; $index <= $endIndex; ++$index) {
+            if (!$tokens[$index]->equals('(')) {
+                continue;
+            }
+
+            $arguments = [];
+            for (; $index <= $endIndex; ++$index) {
+                $arguments[] = $tokens[$index];
+                if ($tokens[$index]->equals(')')) {
+                    break;
+                }
+            }
+
+            return $arguments;
+        }
+
+        return [];
+    }
+
+    /**
+     * @param list<Token> $first
+     * @param list<Token> $second
+     */
+    private static function areAttributeArgumentsEqual(array $first, array $second): bool
+    {
+        $filter = static fn (Token $token): bool => !$token->isWhitespace() && !$token->isComment();
+        $first = array_values(array_filter($first, $filter));
+        $second = array_values(array_filter($second, $filter));
+
+        if (\count($first) !== \count($second)) {
+            return false;
+        }
+
+        foreach ($first as $index => $token) {
+            if (!$token->equals($second[$index])) {
+                return false;
+            }
+        }
+
+        return true;
+    }
