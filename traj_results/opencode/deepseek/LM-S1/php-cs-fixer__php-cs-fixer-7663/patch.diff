+    private function findControlStructureHeaderEnd(Tokens $tokens, int $index): int
+    {
+        if ($tokens[$index]->isGivenKind([T_DO, T_ELSE, T_FINALLY, T_TRY])) {
+            return $index;
+        }
+
+        $openParenthesisIndex = $tokens->getNextMeaningfulToken($index);
+
+        if (null === $openParenthesisIndex || !$tokens[$openParenthesisIndex]->equals('(')) {
+            return $index;
+        }
+
+        return $tokens->findBlockEnd(Tokens::BLOCK_TYPE_PARENTHESIS_BRACE, $openParenthesisIndex);
+    }
+
+    private function findControlStructureBodyEnd(Tokens $tokens, int $index, int $parentScopeEndIndex): int
+    {
+        $headerEndIndex = $this->findControlStructureHeaderEnd($tokens, $index);
+        $bodyStartIndex = $tokens->getNextMeaningfulToken($headerEndIndex);
+
+        if (null === $bodyStartIndex || $bodyStartIndex > $parentScopeEndIndex) {
+            return $headerEndIndex;
+        }
+
+        if ($tokens[$bodyStartIndex]->equals(':')) {
+            return $this->alternativeSyntaxAnalyzer->findAlternativeSyntaxBlockEnd($tokens, $index);
+        }
+
+        if ($tokens[$bodyStartIndex]->equals('{')) {
+            return $tokens->findBlockEnd(Tokens::BLOCK_TYPE_CURLY_BRACE, $bodyStartIndex);
+        }
+
+        if ($tokens[$bodyStartIndex]->equals(';')) {
+            return $bodyStartIndex;
+        }
+
+        return $this->findControlStructureStatementEnd($tokens, $bodyStartIndex, $parentScopeEndIndex);
+    }
+
+    private function findControlStructureStatementEnd(Tokens $tokens, int $index, int $parentScopeEndIndex): int
+    {
+        $token = $tokens[$index];
+
+        if ($token->isGivenKind(T_DO)) {
+            $bodyEndIndex = $this->findControlStructureBodyEnd($tokens, $index, $parentScopeEndIndex);
+            $whileIndex = $tokens->getNextMeaningfulToken($bodyEndIndex);
+
+            if (null !== $whileIndex && $whileIndex <= $parentScopeEndIndex && $tokens[$whileIndex]->isGivenKind(T_WHILE)) {
+                $headerEndIndex = $this->findControlStructureHeaderEnd($tokens, $whileIndex);
+                $semicolonIndex = $tokens->getNextMeaningfulToken($headerEndIndex);
+
+                return null !== $semicolonIndex && $semicolonIndex <= $parentScopeEndIndex ? $semicolonIndex : $headerEndIndex;
+            }
+
+            return $bodyEndIndex;
+        }
+
+        if ($token->isGivenKind(T_ELSE)) {
+            return $this->findControlStructureBodyEnd($tokens, $index, $parentScopeEndIndex);
+        }
+
+        if ($token->isGivenKind([T_IF, T_ELSEIF, T_FOR, T_FOREACH, T_WHILE, T_SWITCH, T_DECLARE, T_TRY, T_CATCH, T_FINALLY])) {
+            $endIndex = $this->findControlStructureBodyEnd($tokens, $index, $parentScopeEndIndex);
+
+            if ($token->isGivenKind([T_IF, T_ELSEIF])) {
+                while (true) {
+                    $nextIndex = $tokens->getNextMeaningfulToken($endIndex);
+
+                    if (null === $nextIndex || $nextIndex > $parentScopeEndIndex) {
+                        break;
+                    }
+
+                    if ($tokens[$nextIndex]->isGivenKind(T_ELSEIF)) {
+                        $endIndex = $this->findControlStructureBodyEnd($tokens, $nextIndex, $parentScopeEndIndex);
+
+                        continue;
+                    }
+
+                    if ($tokens[$nextIndex]->isGivenKind(T_ELSE)) {
+                        $endIndex = $this->findControlStructureBodyEnd($tokens, $nextIndex, $parentScopeEndIndex);
+                    }
+
+                    break;
+                }
+            }
+
+            return $endIndex;
+        }
+
+        $endIndex = $this->findStatementEndIndex($tokens, $index, $parentScopeEndIndex);
+
+        if (null === $endIndex) {
+            return $parentScopeEndIndex;
+        }
+
+        for ($searchIndex = $endIndex + 1; $searchIndex <= $parentScopeEndIndex; ++$searchIndex) {
+            $searchToken = $tokens[$searchIndex];
+
+            if ($searchToken->isWhitespace() || $searchToken->isComment()) {
+                continue;
+            }
+
+            if ($searchToken->equalsAny([';', ',', '}', [T_CLOSE_TAG]])) {
+                return $searchIndex;
+            }
+
+            break;
+        }
+
+        return $endIndex;
+    }
