+func parseOptStringList(d *caddyfile.Dispenser, existing interface{}) (interface{}, error) {
+	vals := []string{}
+	if existing != nil {
+		existingVals, ok := existing.([]string)
+		if !ok {
+			return nil, d.Errf("existing value is not a list of strings")
+		}
+		vals = append(vals, existingVals...)
+	}
+	d.Next() // consume parameter name
+	found := false
+	for d.NextArg() {
+		vals = append(vals, d.Val())
+		found = true
+	}
+	if !found {
+		return nil, d.ArgErr()
+	}
+	return vals, nil
+}
