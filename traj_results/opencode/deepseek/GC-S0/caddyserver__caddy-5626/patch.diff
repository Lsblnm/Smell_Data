diff --git a/caddyconfig/caddyfile/lexer.go b/caddyconfig/caddyfile/lexer.go
index c3e942c2..8b88babb 100644
--- a/caddyconfig/caddyfile/lexer.go
+++ b/caddyconfig/caddyfile/lexer.go
@@ -131,4 +131,16 @@ func (t Token) NumLineBreaks() int {
 	return lineBreaks
 }
 
+func (t Token) sameSource(other Token) bool {
+	if t.File != other.File || len(t.imports) != len(other.imports) {
+		return false
+	}
+	for i := range t.imports {
+		if t.imports[i] != other.imports[i] {
+			return false
+		}
+	}
+	return true
+}
+
 var heredocMarkerRegexp = regexp.MustCompile("^[A-Za-z0-9_-]+$")
