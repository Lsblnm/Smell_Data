+    fn header_component_width(&self) -> usize {
+        self.panel_width
+            + if self.config.style_components.grid() && self.panel_width > 0 {
+                2
+            } else {
+                0
+            }
+    }
+
+    fn print_wrapped_header_component(
+        &mut self,
+        handle: &mut OutputHandle,
+        prefix: &str,
+        value: &str,
+        suffix: &str,
+    ) -> Result<()> {
+        let text = format!("{}{}{}", prefix, value, suffix);
+        let value_start = prefix.len();
+        let value_end = value_start + value.len();
+
+        let width = self
+            .config
+            .term_width
+            .saturating_sub(self.header_component_width())
+            .max(1);
+
+        let mut ranges = Vec::new();
+        let mut start = 0;
+        let mut current_width = 0;
+
+        for (idx, c) in text.char_indices() {
+            let cw = c.width().unwrap_or(0);
+            if current_width > 0 && current_width + cw > width {
+                ranges.push((start, idx));
+                start = idx;
+                current_width = 0;
+            }
+            current_width += cw;
+        }
+        ranges.push((start, text.len()));
+
+        for (start, end) in ranges {
+            self.print_header_component_indent(handle)?;
+
+            let mut cursor = start;
+            while cursor < end {
+                if cursor < value_start {
+                    let stop = end.min(value_start);
+                    write!(handle, "{}", &text[cursor..stop])?;
+                    cursor = stop;
+                } else if cursor < value_end {
+                    let stop = end.min(value_end);
+                    write!(
+                        handle,
+                        "{}",
+                        self.colors.header_value.paint(&text[cursor..stop])
+                    )?;
+                    cursor = stop;
+                } else {
+                    write!(handle, "{}", &text[cursor..end])?;
+                    cursor = end;
+                }
+            }
+
+            writeln!(handle)?;
+        }
+
+        Ok(())
+    }
+
