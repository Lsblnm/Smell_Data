index 000000000..aa80c1efd
--- /dev/null
+++ b/lib/jekyll/data_entry.rb
@@ -0,0 +1,147 @@
+# frozen_string_literal: true
+
+module Jekyll
+  class DataEntry
+    include Enumerable
+    include Comparable
+
+    attr_reader :data, :path
+
+    def initialize(data, path = nil)
+      @data = data
+      @path = path
+    end
+
+    def [](key)
+      @data[key]
+    end
+
+    def []=(key, value)
+      @data[key] = value
+    end
+
+    def dig(*keys)
+      @data.dig(*keys)
+    end
+
+    def fetch(*args, &block)
+      @data.fetch(*args, &block)
+    end
+
+    def key?(key)
+      @data.key?(key)
+    end
+    alias has_key? key?
+
+    def each(&block)
+      @data.each(&block)
+    end
+
+    def each_pair(&block)
+      @data.each_pair(&block)
+    end
+
+    def each_key(&block)
+      @data.each_key(&block)
+    end
+
+    def each_value(&block)
+      @data.each_value(&block)
+    end
+
+    def keys
+      @data.keys
+    end
+
+    def values
+      @data.values
+    end
+
+    def size
+      @data.size
+    end
+    alias length size
+
+    def empty?
+      @data.empty?
+    end
+
+    def to_liquid
+      @data
+    end
+
+    def to_h
+      @data.respond_to?(:to_h) ? @data.to_h : @data
+    end
+
+    def to_hash
+      @data.to_hash if @data.respond_to?(:to_hash)
+    end
+
+    def to_ary
+      @data.to_ary if @data.respond_to?(:to_ary)
+    end
+
+    def merge(other, &block)
+      self.class.new(merged_data(other, &block), @path)
+    end
+
+    def merge!(other, &block)
+      @data.merge!(other_data(other), &block)
+      self
+    end
+
+    def dup
+      self.class.new(@data.dup, @path)
+    end
+
+    def ==(other)
+      @data == comparison_data(other)
+    end
+
+    def <=>(other)
+      @data <=> comparison_data(other)
+    end
+
+    def inspect
+      @data.inspect
+    end
+
+    def to_s
+      @data.to_s
+    end
+
+    def freeze
+      @data.freeze
+      super
+    end
+
+    def each_path(&block)
+      return enum_for(:each_path) unless block_given?
+
+      yield @path if @path
+      @data.each_path(&block) if @data.respond_to?(:each_path)
+    end
+
+    private
+
+    def comparison_data(other)
+      case other
+      when DataEntry
+        other.data
+      when DataHash
+        other.to_h
+      else
+        other
+      end
+    end
+
+    def other_data(other)
+      other.is_a?(DataEntry) || other.is_a?(DataHash) ? other.to_h : other
+    end
+
+    def merged_data(other, &block)
+      @data.merge(other_data(other), &block)
+    end
+  end
+end
diff --git a/lib/jekyll/data_hash.rb b/lib/jekyll/data_hash.rb
new file mode 100644
index 000000000..87782c5ac
--- /dev/null
+++ b/lib/jekyll/data_hash.rb
@@ -0,0 +1,130 @@
+# frozen_string_literal: true
+
+module Jekyll
+  class DataHash
+    include Enumerable
+
+    attr_reader :data
+    attr_accessor :path
+
+    def initialize(data = {}, path = nil)
+      @data = data
+      @path = path
+    end
+
+    def [](key)
+      @data[key]
+    end
+
+    def []=(key, value)
+      @data[key] = value
+    end
+
+    def dig(*keys)
+      return nil if keys.empty?
+
+      key = keys.shift
+      value = @data[key]
+      return value if keys.empty?
+      return nil unless value.respond_to?(:dig)
+
+      value.dig(*keys)
+    end
+
+    def fetch(*args, &block)
+      @data.fetch(*args, &block)
+    end
+
+    def key?(key)
+      @data.key?(key)
+    end
+    alias has_key? key?
+
+    def each(&block)
+      @data.each(&block)
+    end
+    alias each_pair each
+
+    def each_key(&block)
+      @data.each_key(&block)
+    end
+
+    def each_value(&block)
+      @data.each_value(&block)
+    end
+
+    def keys
+      @data.keys
+    end
+
+    def values
+      @data.values
+    end
+
+    def size
+      @data.size
+    end
+    alias length size
+
+    def empty?
+      @data.empty?
+    end
+
+    def inspect
+      @data.inspect
+    end
+
+    def to_s
+      @data.to_s
+    end
+
+    def to_liquid
+      @data
+    end
+
+    def to_h
+      @data.to_h
+    end
+
+    def to_hash
+      @data.to_hash
+    end
+
+    def merge(other, &block)
+      dup.merge!(other, &block)
+    end
+
+    def merge!(other, &block)
+      @data.merge!(other_data(other), &block)
+      self
+    end
+
+    def dup
+      self.class.new(@data.dup, @path)
+    end
+
+    def ==(other)
+      @data == other_data(other)
+    end
+
+    def freeze
+      @data.freeze
+      super
+    end
+
+    def each_path(&block)
+      return enum_for(:each_path) unless block_given?
+
+      yield @path if @path
+      @data.each_value do |value|
+        value.each_path(&block) if value.respond_to?(:each_path)
+      end
+    end
+
+    private
+
+    def other_data(other)
+      other.is_a?(DataHash) || other.is_a?(DataEntry) ? other.to_h : other
+    end
+  end
+end
