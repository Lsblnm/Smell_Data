+STATIC void mp_call_prepare_args_n_kw_var_check_dup(const mp_obj_t *args, size_t start, size_t end, mp_obj_t key) {
+    for (size_t i = start; i < end; i += 2) {
+        if (args[i] == key) {
+            mp_raise_msg_varg(&mp_type_TypeError,
+                MP_ERROR_TEXT("function got multiple values for argument '%q'"), MP_OBJ_QSTR_VALUE(key));
+        }
+    }
+}
