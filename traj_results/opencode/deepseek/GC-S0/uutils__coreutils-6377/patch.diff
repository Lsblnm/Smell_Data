+#[cfg(unix)]
+fn parse_ignored_signals(matches: &clap::ArgMatches) -> UResult<(Vec<usize>, bool)> {
+    let mut signals = Vec::new();
+    let mut ignore_all = false;
+
+    if let Some(occurrences) = matches.get_raw_occurrences("ignore-signal") {
+        for occurrence in occurrences {
+            let mut values = occurrence;
+            match values.next() {
+                Some(value) => {
+                    for name in value.to_string_lossy().split(',') {
+                        if name.is_empty() {
+                            continue;
+                        }
+                        match uucore::signals::signal_by_name_or_value(&name.to_uppercase()) {
+                            Some(signal) if signal != 0 => signals.push(signal),
+                            _ => {
+                                return Err(UUsageError::new(
+                                    125,
+                                    format!("{}: invalid signal", name.quote()),
+                                ))
+                            }
+                        }
+                    }
+                }
+                None => ignore_all = true,
+            }
+        }
+    }
+
+    Ok((signals, ignore_all))
+}
+
+#[cfg(not(unix))]
+fn parse_ignored_signals(matches: &clap::ArgMatches) -> UResult<(Vec<usize>, bool)> {
+    Ok((Vec::new(), matches.contains_id("ignore-signal")))
+}
