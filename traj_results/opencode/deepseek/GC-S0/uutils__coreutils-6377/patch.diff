+#[cfg(unix)]
+fn apply_ignored_signals(opts: &Options<'_>) -> UResult<()> {
+    let signals: Vec<usize> = if opts.ignore_all_signals {
+        (1..uucore::signals::ALL_SIGNALS.len())
+            .filter(|&signal| {
+                signal != Signal::SIGKILL as usize && signal != Signal::SIGSTOP as usize
+            })
+            .collect()
+    } else {
+        opts.ignored_signals.clone()
+    };
+
+    for signal in signals {
+        if signal == Signal::SIGCHLD as usize {
+            continue;
+        }
+        let signal = Signal::try_from(signal as i32)
+            .map_err(|_| UUsageError::new(125, format!("'{}': invalid signal", signal)))?;
+        let action = SigAction::new(SigHandler::SigIgn, SaFlags::empty(), SigSet::empty());
+        if let Err(error) = unsafe { sigaction(signal, &action) } {
+            return Err(USimpleError::new(
+                125,
+                format!(
+                    "failed to set signal action for signal {}: {}",
+                    signal as i32,
+                    error.desc()
+                ),
+            ));
+        }
+    }
+
+    Ok(())
+}
+
+#[cfg(not(unix))]
+fn apply_ignored_signals(opts: &Options<'_>) -> UResult<()> {
+    if opts.ignore_all_signals || !opts.ignored_signals.is_empty() {
+        Err(USimpleError::new(
+            125,
+            "--ignore-signal is not supported on this platform",
+        ))
+    } else {
+        Ok(())
+    }
+}
