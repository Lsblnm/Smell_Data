+    pub(super) fn merge_fallbacks(
+        &mut self,
+        other: PathRouter<S, IS_FALLBACK>,
+        preserve_self: bool,
+    ) -> Result<(), Cow<'static, str>> {
+        let self_root = if preserve_self {
+            let wildcard = format!("/*{FALLBACK_PARAM}");
+            let mut endpoints = Vec::new();
+            for path in ["/", wildcard.as_str()] {
+                if let Some(id) = self.node.path_to_route_id.get(path) {
+                    if let Some(endpoint) = self.routes.get(id) {
+                        endpoints.push((path.to_owned(), endpoint.clone()));
+                    }
+                }
+            }
+            endpoints
+        } else {
+            Vec::new()
+        };
+
+        let PathRouter {
+            routes,
+            node,
+            prev_route_id: _,
+        } = other;
+
+        for (id, endpoint) in routes {
+            let path = node
+                .route_id_to_path
+                .get(&id)
+                .expect("no path for route id. This is a bug in axum. Please file an issue")
+                .clone();
+            self.insert_or_replace_endpoint(&path, endpoint)?;
+        }
+
+        for (path, endpoint) in self_root {
+            self.insert_or_replace_endpoint(&path, endpoint)?;
+        }
+
+        Ok(())
+    }
+
+    fn insert_or_replace_endpoint(
+        &mut self,
+        path: &str,
+        endpoint: Endpoint<S>,
+    ) -> Result<(), Cow<'static, str>> {
+        if let Some(id) = self.node.path_to_route_id.get(path).copied() {
+            self.routes.insert(id, endpoint);
+            Ok(())
+        } else {
+            let id = self.next_route_id();
+            self.set_node(path, id)?;
+            self.routes.insert(id, endpoint);
+            Ok(())
+        }
+    }
