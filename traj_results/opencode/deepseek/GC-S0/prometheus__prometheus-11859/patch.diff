+// deleteChunkSnapshotsAheadOfWAL deletes all chunk snapshots whose WAL position
+// is ahead of the current WAL. Such snapshots belong to a previous WAL and
+// cannot be used to restore the current Head.
+func (h *Head) deleteChunkSnapshotsAheadOfWAL() error {
+	if h.wal == nil {
+		return nil
+	}
+
+	wlast, woffset, err := h.wal.LastSegmentAndOffset()
+	if err != nil {
+		return errors.Wrap(err, "get last WAL segment and offset")
+	}
+
+	for {
+		name, idx, offset, err := LastChunkSnapshot(h.opts.ChunkDirRoot)
+		if err != nil {
+			if err == record.ErrNotFound {
+				return nil
+			}
+			return errors.Wrap(err, "find last chunk snapshot")
+		}
+
+		if idx <= wlast {
+			return nil
+		}
+
+		level.Warn(h.logger).Log("msg", "Deleting chunk snapshot that is ahead of the WAL", "dir", name, "snapshot_index", idx, "snapshot_offset", offset, "wal_index", wlast, "wal_offset", woffset)
+		if err := os.RemoveAll(name); err != nil {
+			return errors.Wrapf(err, "delete chunk snapshot %s", name)
+		}
+	}
+}
