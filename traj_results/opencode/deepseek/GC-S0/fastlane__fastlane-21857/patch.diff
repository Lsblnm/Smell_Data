index 6d58d8765..71c5b8c5d 100644
--- a/fastlane_core/lib/fastlane_core/print_table.rb
+++ b/fastlane_core/lib/fastlane_core/print_table.rb
@@ -162,7 +162,7 @@ module FastlaneCore
       return column if column.nil?
       return column if transform.nil?
 
-      value = column.to_s.dup
+      value = sanitize_encoding(column.to_s.dup)
 
       if transform == :truncate_middle
         return middle_truncate_text(value, max_value_length)
@@ -185,6 +185,11 @@ module FastlaneCore
       @table_rows = rows
       @table_hide_keys ||= []
       @table_mask_keys ||= []
+
+      rows = rows.map do |row|
+        row.map { |column| sanitize_encoding(column) }
+      end
+
       return rows unless self.class.should_transform?
 
       require 'tty-screen'
@@ -206,6 +211,22 @@ module FastlaneCore
       return return_array
     end
 
+    def sanitize_encoding(value)
+      return value unless value.kind_of?(String)
+      return value if value.valid_encoding?
+
+      test_value = value.dup
+      if test_value.force_encoding(Encoding::UTF_16).valid_encoding?
+        begin
+          return value.encode(Encoding::UTF_8, Encoding::UTF_16)
+        rescue Encoding::InvalidByteSequenceError, Encoding::UndefinedConversionError
+          nil
+        end
+      end
+
+      value.encode(Encoding::UTF_8, invalid: :replace, undef: :replace)
+    end
+
     def collect_rows(options: nil, hide_keys: [], mask_keys: [], prefix: '', mask: '********')
       @table_hide_keys = hide_keys
       @table_mask_keys = mask_keys
