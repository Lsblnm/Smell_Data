+
+static inst* jq_ps_block_take(block* b) {
+  jq_parser_front.error_count += (jq_parser_front.error_count < 0);
+  if (b->first == 0) return 0;
+  inst* i = b->first;
+  if (i->next) {
+    i->next->prev = 0;
+    b->first = i->next;
+    i->next = 0;
+  } else {
+    b->first = 0;
+    b->last = 0;
+  }
+  return i;
+}
