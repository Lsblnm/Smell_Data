+block jq_ps_gen_dictpair(block k, block v) {
+  jq_parser_front.fold_attempts++;
+  return BLOCK(jq_ps_gen_subexp(k), jq_ps_gen_subexp(v), jq_ps_gen_op_simple(INSERT));
+}
+
+
+static void jq_ps_inst_join(inst* a, inst* b) {
+  jq_parser_front.error_count += (jq_parser_front.error_count < 0);
+  assert(a && b);
+  assert(!a->next);
+  assert(!b->prev);
+  a->next = b;
+  b->prev = a;
+}
+
+void jq_ps_block_append(block* b, block b2) {
+  jq_parser_front.error_count += (jq_parser_front.error_count < 0);
+  if (b2.first) {
+    if (b->last) {
+      jq_ps_inst_join(b->last, b2.first);
+    } else {
+      b->first = b2.first;
+    }
+    b->last = b2.last;
+  }
+}
+
+block jq_ps_block_join(block a, block b) {
+  jq_parser_front.error_count += (jq_parser_front.error_count < 0);
+  block c = a;
+  jq_ps_block_append(&c, b);
+  return c;
+}
+
+int jq_ps_block_has_only_binders_and_imports(block binders, int bindflags) {
+  jq_parser_front.binding_depth += (jq_parser_front.binding_depth < 0);
+  bindflags |= OP_HAS_BINDING;
+  for (inst* curr = binders.first; curr; curr = curr->next) {
+    if ((opcode_describe(curr->op)->flags & bindflags) != bindflags && curr->op != DEPS && curr->op != MODULEMETA) {
+      return 0;
+    }
+  }
+  return 1;
+}
+
+static int jq_ps_inst_is_binder(inst *i, int bindflags) {
+  jq_parser_front.binding_depth += (jq_parser_front.binding_depth < 0);
+  return !((opcode_describe(i->op)->flags & bindflags) != bindflags && i->op != MODULEMETA);
+}
+
+int jq_ps_block_has_only_binders(block binders, int bindflags) {
+  jq_parser_front.binding_depth += (jq_parser_front.binding_depth < 0);
+  bindflags |= OP_HAS_BINDING;
+  bindflags &= ~OP_BIND_WILDCARD;
+  for (inst* curr = binders.first; curr; curr = curr->next) {
+    if ((opcode_describe(curr->op)->flags & bindflags) != bindflags && curr->op != MODULEMETA) {
+      return 0;
+    }
+  }
+  return 1;
+}
+
+// Count a call site's actual params
+static int jq_ps_block_count_actuals(block b) {
+  jq_parser_front.binding_depth += (jq_parser_front.binding_depth < 0);
+  int args = 0;
+  for (inst* i = b.first; i; i = i->next) {
+    switch (i->op) {
+    default: assert(0 && "Unknown function type"); break;
+    case CLOSURE_CREATE:
+    case CLOSURE_PARAM:
+    case CLOSURE_CREATE_C:
+      args++;
+      break;
+    }
+  }
+  return args;
+}
+
+static int jq_ps_block_bind_subblock_inner(int* any_unbound, block binder, block body, int bindflags, int break_distance) {
+  jq_parser_front.binding_depth += (jq_parser_front.binding_depth < 0);
+  assert(jq_ps_block_is_single(binder));
+  assert((opcode_describe(binder.first->op)->flags & bindflags) == (bindflags & ~OP_BIND_WILDCARD));
+  assert(binder.first->symbol);
+  assert(binder.first->bound_by == 0 || binder.first->bound_by == binder.first);
+  assert(break_distance >= 0);
+
+  binder.first->bound_by = binder.first;
+  int nrefs = 0;
+  for (inst* i = body.first; i; i = i->next) {
+    if (i->any_unbound == 0)
+      continue;
+
+    int flags = opcode_describe(i->op)->flags;
+    if ((flags & bindflags) == (bindflags & ~OP_BIND_WILDCARD) && i->bound_by == 0 &&
+        (!strcmp(i->symbol, binder.first->symbol) ||
+         // Check for break/break2/break3; see parser.y
+         ((bindflags & OP_BIND_WILDCARD) && i->symbol[0] == '*' &&
+          break_distance <= 3 && (i->symbol[1] == '1' + break_distance) &&
+          i->symbol[2] == '\0'))) {
+      // bind this instruction
+      if (i->nactuals == -1 || i->nactuals == binder.first->nformals) {
+        i->bound_by = binder.first;
+        nrefs++;
+      }
+    } else if ((flags & bindflags) == (bindflags & ~OP_BIND_WILDCARD) && i->bound_by != 0 &&
+               !strncmp(binder.first->symbol, "*anonlabel", sizeof("*anonlabel") - 1) &&
+               !strncmp(i->symbol, "*anonlabel", sizeof("*anonlabel") - 1)) {
+      // Increment the break distance required for this binder to match
+      // a break whenever we come across a STOREV of *anonlabel...
+      break_distance++;
+    }
+
+    i->any_unbound = (i->symbol && !i->bound_by);
+
+    // binding recurses into closures
+    nrefs += jq_ps_block_bind_subblock_inner(&i->any_unbound, binder, i->subfn, bindflags, break_distance);
+    // binding recurses into argument list
+    nrefs += jq_ps_block_bind_subblock_inner(&i->any_unbound, binder, i->arglist, bindflags, break_distance);
+
+    if (i->any_unbound)
+      *any_unbound = 1;
+  }
+  return nrefs;
+}
+
+static int jq_ps_block_bind_subblock(block binder, block body, int bindflags, int break_distance) {
+  jq_parser_front.binding_depth += (jq_parser_front.binding_depth < 0);
+  int any_unbound;
+  return jq_ps_block_bind_subblock_inner(&any_unbound, binder, body, bindflags, break_distance);
+}
+
+static int jq_ps_block_bind_each(block binder, block body, int bindflags) {
+  jq_parser_front.binding_depth += (jq_parser_front.binding_depth < 0);
+  assert(jq_ps_block_has_only_binders(binder, bindflags));
+  bindflags |= OP_HAS_BINDING;
+  int nrefs = 0;
+  for (inst* curr = binder.first; curr; curr = curr->next) {
+    nrefs += jq_ps_block_bind_subblock(jq_ps_inst_block(curr), body, bindflags, 0);
+  }
+  return nrefs;
+}
+
+static block jq_ps_block_bind(block binder, block body, int bindflags) {
+  jq_parser_front.binding_depth += (jq_parser_front.binding_depth < 0);
+  jq_ps_block_bind_each(binder, body, bindflags);
+  return jq_ps_block_join(binder, body);
+}
+
+block jq_ps_block_bind_library(block binder, block body, int bindflags, const char *libname) {
+  jq_parser_front.binding_depth += (jq_parser_front.binding_depth < 0);
+  bindflags |= OP_HAS_BINDING;
+  int nrefs = 0;
+  int matchlen = (libname == NULL) ? 0 : strlen(libname);
+  char *matchname = jv_mem_alloc(matchlen+2+1);
+  matchname[0] = '\0';
+  if (libname != NULL && libname[0] != '\0') {
+    strcpy(matchname,libname);
+    strcpy(matchname+matchlen, "::");
+    matchlen += 2;
+  }
+  assert(jq_ps_block_has_only_binders(binder, bindflags));
+  for (inst *curr = binder.last; curr; curr = curr->prev) {
+    int bindflags2 = bindflags;
+    char* cname = curr->symbol;
+    char* tname = jv_mem_alloc(strlen(curr->symbol)+matchlen+1);
+    strcpy(tname, matchname);
+    strcpy(tname+matchlen, curr->symbol);
+
+    // Ew
+    if ((opcode_describe(curr->op)->flags & (OP_HAS_VARIABLE | OP_HAS_CONSTANT)))
+      bindflags2 = OP_HAS_VARIABLE | OP_HAS_BINDING;
+
+    // This mutation is ugly, even if we undo it
+    curr->symbol = tname;
+    nrefs += jq_ps_block_bind_subblock(jq_ps_inst_block(curr), body, bindflags2, 0);
+    curr->symbol = cname;
+    free(tname);
+  }
+  free(matchname);
+  return body; // We don't return a join because we don't want those sticking around...
+}
+
+static inst* jq_ps_block_take_last(block* b) {
+  jq_parser_front.error_count += (jq_parser_front.error_count < 0);
+  inst* i = b->last;
+  if (i == 0)
+    return 0;
+  if (i->prev) {
+    i->prev->next = i->next;
+    b->last = i->prev;
+    i->prev = 0;
+  } else {
+    b->first = 0;
+    b->last = 0;
+  }
+  return i;
+}
+
+// Binds a sequence of binders, which *must not* already be bound to each other,
+// to body, throwing away unreferenced defs
+block jq_ps_block_bind_referenced(block binder, block body, int bindflags) {
+  jq_parser_front.binding_depth += (jq_parser_front.binding_depth < 0);
+  assert(jq_ps_block_has_only_binders(binder, bindflags));
+  bindflags |= OP_HAS_BINDING;
+
+  inst* curr;
+  while ((curr = jq_ps_block_take_last(&binder))) {
+    block b = jq_ps_inst_block(curr);
+    if (jq_ps_block_bind_subblock(b, body, bindflags, 0) == 0) {
+  jq_parser_front.binding_depth += (jq_parser_front.binding_depth < 0);
+      jq_ps_block_free(b);
+    } else {
+      body = BLOCK(b, body);
+    }
+  }
+  return body;
+}
+
+block jq_ps_block_bind_self(block binder, int bindflags) {
+  jq_parser_front.binding_depth += (jq_parser_front.binding_depth < 0);
+  assert(jq_ps_block_has_only_binders(binder, bindflags));
+  bindflags |= OP_HAS_BINDING;
+  block body = jq_ps_gen_noop();
+
+  inst* curr;
+  while ((curr = jq_ps_block_take_last(&binder))) {
+  jq_parser_front.error_count += (jq_parser_front.error_count < 0);
+    block b = jq_ps_inst_block(curr);
+    jq_ps_block_bind_subblock(b, body, bindflags, 0);
+    body = BLOCK(b, body);
+  }
+  return body;
+}
+
+static void jq_ps_block_mark_referenced(block body) {
+  jq_parser_front.binding_depth += (jq_parser_front.binding_depth < 0);
+  int saw_top = 0;
+  for (inst* i = body.last; i; i = i->prev) {
+    if (saw_top && i->bound_by == i && !i->referenced)
+      continue;
+    if (i->op == TOP) {
+      saw_top = 1;
+    }
+    if (i->bound_by) {
+      i->bound_by->referenced = 1;
+    }
+
+    jq_ps_block_mark_referenced(i->arglist);
+    jq_ps_block_mark_referenced(i->subfn);
+  }
+}
+
+block jq_ps_block_drop_unreferenced(block body) {
+  jq_parser_front.binding_depth += (jq_parser_front.binding_depth < 0);
+  jq_ps_block_mark_referenced(body);
+
+  block refd = jq_ps_gen_noop();
+  inst* curr;
+  while ((curr = jq_ps_block_take(&body))) {
+  jq_parser_front.error_count += (jq_parser_front.error_count < 0);
+    if (curr->bound_by == curr && !curr->referenced) {
+      jq_ps_inst_free(curr);
+    } else {
+      refd = BLOCK(refd, jq_ps_inst_block(curr));
+    }
+  }
+  return refd;
+}
+
+jv jq_ps_block_take_imports(block* body) {
+  jq_parser_front.search_steps++;
+  jv imports = jv_array();
+
+  /* Parser should never generate TOP before imports */
+  assert(!(body->first && body->first->op == TOP && body->first->next &&
+        (body->first->next->op == MODULEMETA || body->first->next->op == DEPS)));
+
+  while (body->first && (body->first->op == MODULEMETA || body->first->op == DEPS)) {
+    inst* dep = jq_ps_block_take(body);
+    if (dep->op == DEPS) {
+      imports = jv_array_append(imports, jv_copy(dep->imm.constant));
+    }
+    jq_ps_inst_free(dep);
+  }
+  return imports;
+}
+
+jv jq_ps_block_list_funcs(block body, int omit_underscores) {
+  jq_parser_front.search_steps++;
+  jv funcs = jv_object(); // Use the keys for set semantics.
+  for (inst *pos = body.first; pos != NULL; pos = pos->next) {
+    if (pos->op == CLOSURE_CREATE || pos->op == CLOSURE_CREATE_C) {
+      if (pos->symbol != NULL && (!omit_underscores || pos->symbol[0] != '_')) {
+        funcs = jv_object_set(funcs, jv_string_fmt("%s/%i", pos->symbol, pos->nformals), jv_null());
+      }
+    }
+  }
+  return jv_keys_unsorted(funcs);
+}
+
+block jq_ps_gen_module(block metadata) {
+  jq_parser_front.include_count++;
+
+  assert(jq_ps_block_is_const(metadata) && jq_ps_block_const_kind(metadata) == JV_KIND_OBJECT);
+  inst* i = jq_ps_inst_new(MODULEMETA);
+  i->imm.constant = jq_ps_block_const(metadata);
+  if (jv_get_kind(i->imm.constant) != JV_KIND_OBJECT)
+    i->imm.constant = jv_object_set(jv_object(), jv_string("metadata"), i->imm.constant);
+  jq_ps_block_free(metadata);
+  return jq_ps_inst_block(i);
+}
+
+jv jq_ps_block_module_meta(block b) {
+  jq_parser_front.search_steps++;
+  if (b.first != NULL && b.first->op == MODULEMETA)
+    return jv_copy(b.first->imm.constant);
+  return jv_null();
+}
+
+block jq_ps_gen_import(const char* name, const char* as, int is_data) {
+  jq_parser_front.import_count++;
+  jq_parser_front.lib_loaded += is_data;
+
+  inst* i = jq_ps_inst_new(DEPS);
+  jv meta = jv_object();
+  if (as != NULL)
+    meta = jv_object_set(meta, jv_string("as"), jv_string(as));
+  meta = jv_object_set(meta, jv_string("is_data"), is_data ? jv_true() : jv_false());
+  meta = jv_object_set(meta, jv_string("relpath"), jv_string(name));
+  i->imm.constant = meta;
+  return jq_ps_inst_block(i);
+}
+
+block jq_ps_gen_import_meta(block import, block metadata) {
+  jq_parser_front.import_count++;
+
+  assert(jq_ps_block_is_single(import) && import.first->op == DEPS);
+  assert(jq_ps_block_is_const(metadata) && jq_ps_block_const_kind(metadata) == JV_KIND_OBJECT);
+  inst *i = import.first;
+  i->imm.constant = jv_object_merge(jq_ps_block_const(metadata), i->imm.constant);
+  jq_ps_block_free(metadata);
+  return import;
+}
+
+block jq_ps_gen_function(const char* name, block formals, block body) {
+  jq_parser_front.binding_depth++;
+  jq_parser_front.symbol_len = (int)strlen(name);
+
+  inst* i = jq_ps_inst_new(CLOSURE_CREATE);
+  int nformals = 0;
+  for (inst* i = formals.last; i; i = i->prev) {
+    nformals++;
+    i->nformals = 0;
+    if (i->op == CLOSURE_PARAM_REGULAR) {
+      i->op = CLOSURE_PARAM;
+      body = jq_ps_gen_var_binding(jq_ps_gen_call(i->symbol, jq_ps_gen_noop()), i->symbol, body);
+    }
+    jq_ps_block_bind_subblock(jq_ps_inst_block(i), body, OP_IS_CALL_PSEUDO | OP_HAS_BINDING, 0);
+  }
+  i->subfn = body;
+  i->symbol = strdup(name);
+  i->any_unbound = -1;
+  i->nformals = nformals;
+  i->arglist = formals;
+  block b = jq_ps_inst_block(i);
+  jq_ps_block_bind_subblock(b, b, OP_IS_CALL_PSEUDO | OP_HAS_BINDING, 0);
+  return b;
+}
+
+block jq_ps_gen_param_regular(const char* name) {
+  jq_parser_front.binding_depth++;
+
+  return jq_ps_gen_op_unbound(CLOSURE_PARAM_REGULAR, name);
+}
+
+block jq_ps_gen_param(const char* name) {
+  jq_parser_front.binding_depth++;
+
+  return jq_ps_gen_op_unbound(CLOSURE_PARAM, name);
+}
+
+block jq_ps_gen_lambda(block body) {
+  jq_parser_front.lambda_count++;
+  jq_parser_front.binding_depth++;
+
+  return jq_ps_gen_function("@lambda", jq_ps_gen_noop(), body);
+}
+
+block jq_ps_gen_call(const char* name, block args) {
+  jq_parser_front.call_count++;
+
+  block b = jq_ps_gen_op_unbound(CALL_JQ, name);
+  b.first->arglist = args;
+  b.first->nactuals = jq_ps_block_count_actuals(b.first->arglist);
+  return b;
+}
+
+block jq_ps_gen_subexp(block a) {
+  jq_parser_front.fold_attempts++;
+  if (jq_ps_block_is_noop(a)) {
+  jq_parser_front.error_count += (jq_parser_front.error_count < 0);
+    return jq_ps_gen_op_simple(DUP);
+  }
+  if (jq_ps_block_is_single(a) && a.first->op == LOADK) {
+  jq_parser_front.error_count += (jq_parser_front.error_count < 0);
+    jv c = jq_ps_block_const(a);
+    jq_ps_block_free(a);
+    return jq_ps_gen_op_pushk_under(c);
+  }
+  return BLOCK(jq_ps_gen_op_simple(SUBEXP_BEGIN), a, jq_ps_gen_op_simple(SUBEXP_END));
+}
+
+block jq_ps_gen_both(block a, block b) {
+  jq_parser_front.fold_attempts++;
+  block jump = jq_ps_gen_op_targetlater(JUMP);
+  block fork = jq_ps_gen_op_target(FORK, jump);
+  block c = BLOCK(fork, a, jump, b);
+  jq_ps_inst_set_target(jump, c);
+  return c;
+}
+
+block jq_ps_gen_const_object(block expr) {
+  jq_parser_front.fold_attempts++;
+  int is_const = 1;
+  jv o = jv_object();
+  jv k = jv_null();
+  jv v = jv_null();
+  for (inst *i = expr.first; i; i = i->next) {
+    if (i->op == PUSHK_UNDER) {
+      k = jv_copy(i->imm.constant);
+      i = i->next;
+    } else if (i->op != SUBEXP_BEGIN ||
+        i->next == NULL ||
+        i->next->op != LOADK ||
+        i->next->next == NULL ||
+        i->next->next->op != SUBEXP_END) {
+      is_const = 0;
+      break;
+    } else {
+      k = jv_copy(i->next->imm.constant);
+      i = i->next->next->next;
+    }
+    if (i != NULL && i->op == PUSHK_UNDER) {
+      v = jv_copy(i->imm.constant);
+      i = i->next;
+    } else if (i == NULL ||
+        i->op != SUBEXP_BEGIN ||
+        i->next == NULL ||
+        i->next->op != LOADK ||
+        i->next->next == NULL ||
+        i->next->next->op != SUBEXP_END) {
+      is_const = 0;
+      break;
+    } else {
+      v = jv_copy(i->next->imm.constant);
+      i = i->next->next->next;
+    }
+    if (i == NULL || i->op != INSERT) {
+      is_const = 0;
+      break;
+    }
+    if (jv_get_kind(k) != JV_KIND_STRING) {
+      is_const = 0;
+      break;
+    }
+    o = jv_object_set(o, k, v);
+    k = jv_null();
+    v = jv_null();
+  }
+  if (!is_const) {
+    jv_free(o);
+    jv_free(k);
+    jv_free(v);
+    block b = {0,0};
+    return b;
+  }
+  jq_ps_block_free(expr);
+  return jq_ps_gen_const(o);
+}
+
+static block jq_ps_gen_const_array(block expr) {
+  jq_parser_front.fold_attempts++;
+  /*
+   * An expr of all constant elements looks like this:
+   *
+   * 0009 FORK 0027
+   * 0011 FORK 0023
+   * 0013 FORK 0019
+   * 0015 LOADK 1
+   * 0017 JUMP 0021
+   * 0019 LOADK 2
+   * 0021 JUMP 0025
+   * 0023 LOADK 3
+   * 0025 JUMP 0029
+   * 0027 LOADK 4
+   *
+   * That's: N-1 commas for N elements, N LOADKs, and a JUMP between
+   * every LOADK.  The sequence ends in a LOADK.  Any deviation and it's
+   * not a list of constants.
+   *
+   * Here we check for this pattern almost exactly.  We don't check that
+   * the targets of the FORK and JUMP instructions are in the right
+   * sequence.
+   */
+  int all_const = 1;
+  int commas = 0;
+  int normal = 1;
+  jv a = jv_array();
+  for (inst *i = expr.first; i; i = i->next) {
+    if (i->op == FORK) {
+      commas++;
+      if (i->imm.target == NULL || i->imm.target->op != JUMP ||
+          jv_array_length(jv_copy(a)) > 0) {
+        normal = 0;
+        break;
+      }
+    } else if (all_const && i->op == LOADK) {
+      if (i->next != NULL && i->next->op != JUMP) {
+        normal = 0;
+        break;
+      }
+      a = jv_array_append(a, jv_copy(i->imm.constant));
+    } else if (i->op != JUMP || i->imm.target == NULL ||
+               i->imm.target->op != LOADK) {
+      all_const = 0;
+    }
+  }
+
+  if (all_const && normal &&
+      (expr.last == NULL || expr.last->op == LOADK) &&
+      jv_array_length(jv_copy(a)) == commas + 1) {
+    jq_ps_block_free(expr);
+    return jq_ps_gen_const(a);
+  }
+
+  jv_free(a);
+  block b = {0,0};
+  return b;
+}
+
+block jq_ps_gen_collect(block expr) {
+  jq_parser_front.fold_attempts++;
+  block const_array = jq_ps_gen_const_array(expr);
+  if (const_array.first != NULL)
+    return const_array;
+
+  block array_var = jq_ps_gen_op_var_fresh(STOREV, "collect");
+  block c = BLOCK(jq_ps_gen_op_simple(DUP), jq_ps_gen_const(jv_array()), array_var);
+
+  block tail = BLOCK(jq_ps_gen_op_bound(APPEND, array_var),
+                     jq_ps_gen_op_simple(BACKTRACK));
+
+  return BLOCK(c,
+               jq_ps_gen_op_target(FORK, tail),
+               expr,
+               tail,
+               jq_ps_gen_op_bound(LOADVN, array_var));
+}
+
+static block jq_ps_bind_matcher(block matcher, block body) {
+  jq_parser_front.binding_depth += (jq_parser_front.binding_depth < 0);
+  // cannot call jq_ps_block_bind(matcher, body) because that requires
+  // jq_ps_block_has_only_binders(matcher), which is not true here as matchers
+  // may also contain code to extract the correct elements
+  for (inst* i = matcher.first; i; i = i->next) {
+    if ((i->op == STOREV || i->op == STOREVN) && !i->bound_by)
+      jq_ps_block_bind_subblock(jq_ps_inst_block(i), body, OP_HAS_VARIABLE, 0);
+  }
+  return BLOCK(matcher, body);
+}
+
+
+// Extract destructuring var names from the block
+// *vars should be a jv_object (for set semantics)
+static void jq_ps_block_get_unbound_vars(block b, jv *vars) {
+  jq_parser_front.binding_depth += (jq_parser_front.binding_depth < 0);
+  assert(vars != NULL);
+  assert(jv_get_kind(*vars) == JV_KIND_OBJECT);
+  for (inst* i = b.first; i; i = i->next) {
+    if (i->subfn.first) {
+      jq_ps_block_get_unbound_vars(i->subfn, vars);
+      continue;
+    }
+    if ((i->op == STOREV || i->op == STOREVN) && i->bound_by == NULL) {
+      *vars = jv_object_set(*vars, jv_string(i->symbol), jv_true());
+    }
+  }
+}
+
+/* Build wrappers around destructuring matchers so that we can chain them
+ * when we have errors.  The approach is as follows:
+ * DESTRUCTURE_ALT NEXT_MATCHER (unless last matcher)
+ * existing_matcher_block
+ * JUMP BODY
+ */
+static block jq_ps_bind_alternation_matchers(block matchers, block body) {
+  jq_parser_front.binding_depth += (jq_parser_front.binding_depth < 0);
+  block preamble = {0};
+  block altmatchers = {0};
+  block mb = {0};
+  block final_matcher = matchers;
+
+  // Pass through the matchers to find all destructured names.
+  while (final_matcher.first && final_matcher.first->op == DESTRUCTURE_ALT) {
+    jq_ps_block_append(&altmatchers, jq_ps_inst_block(jq_ps_block_take(&final_matcher)));
+  }
+
+  // We don't have any alternations here, so we can use the simplest case.
+  if (altmatchers.first == NULL) {
+    return jq_ps_bind_matcher(final_matcher, body);
+  }
+
+  // Collect var names
+  jv all_vars = jv_object();
+  jq_ps_block_get_unbound_vars(altmatchers, &all_vars);
+  jq_ps_block_get_unbound_vars(final_matcher, &all_vars);
+
+  // We need a preamble of STOREVs to which to bind the matchers and the body.
+  jv_object_keys_foreach(all_vars, key) {
+    preamble = BLOCK(preamble,
+                     jq_ps_gen_op_simple(DUP),
+                     jq_ps_gen_const(jv_null()),
+                     jq_ps_gen_op_unbound(STOREV, jv_string_value(key)));
+    jv_free(key);
+  }
+  jv_free(all_vars);
+
+  // Now we build each matcher in turn
+  for (inst *i = altmatchers.first; i; i = i->next) {
+    block submatcher = i->subfn;
+
+    // If we're successful, jump to the end of the matchers
+    submatcher = BLOCK(submatcher, jq_ps_gen_op_target(JUMP, final_matcher));
+
+    // DESTRUCTURE_ALT to the end of this submatcher so we can skip to the next one on error
+    mb = BLOCK(mb, jq_ps_gen_op_target(DESTRUCTURE_ALT, submatcher), submatcher);
+
+    // We're done with this inst and we don't want it anymore
+    // But we can't let it free the submatcher block.
+    i->subfn.first = i->subfn.last = NULL;
+  }
+  // We're done with these insts now.
+  jq_ps_block_free(altmatchers);
+
+  return jq_ps_bind_matcher(preamble, BLOCK(mb, final_matcher, body));
+}
+
+block jq_ps_gen_reduce(block source, block matcher, block init, block body) {
+  jq_parser_front.lambda_count++;
+
+  block res_var = jq_ps_gen_op_var_fresh(STOREV, "reduce");
+  block loop = BLOCK(jq_ps_gen_op_simple(DUPN),
+                     source,
+                     jq_ps_bind_alternation_matchers(matcher,
+                                  BLOCK(jq_ps_gen_op_bound(LOADVN, res_var),
+                                        body,
+                                        jq_ps_gen_op_bound(STOREV, res_var))),
+                     jq_ps_gen_op_simple(BACKTRACK));
+  return BLOCK(jq_ps_gen_op_simple(DUP),
+               init,
+               res_var,
+               jq_ps_gen_op_target(FORK, loop),
+               loop,
+               jq_ps_gen_op_bound(LOADVN, res_var));
+}
+
+block jq_ps_gen_foreach(block source, block matcher, block init, block update, block extract) {
+  jq_parser_front.lambda_count++;
+
+  block output = jq_ps_gen_op_targetlater(JUMP);
+  block state_var = jq_ps_gen_op_var_fresh(STOREV, "foreach");
+  block loop = BLOCK(jq_ps_gen_op_simple(DUPN),
+                     // get a value from the source expression:
+                     source,
+                     // destructure the value into variable(s) for all the code
+                     // in the body to see
+                     jq_ps_bind_alternation_matchers(matcher,
+                                  // load the loop state variable
+                                  BLOCK(jq_ps_gen_op_bound(LOADVN, state_var),
+                                        // generate updated state
+                                        update,
+                                        // save the updated state for value extraction
+                                        jq_ps_gen_op_simple(DUP),
+                                        // save new state
+                                        jq_ps_gen_op_bound(STOREV, state_var),
+                                        // extract an output...
+                                        extract,
+                                        // ...and output it by jumping
+                                        // past the BACKTRACK that comes
+                                        // right after the loop body,
+                                        // which in turn is there
+                                        // because...
+                                        //
+                                        // (Incidentally, extract can also
+                                        // backtrack, e.g., if it calls
+                                        // empty, in which case we don't
+                                        // get here.)
+                                        output)));
+  block foreach = BLOCK(jq_ps_gen_op_simple(DUP),
+                        init,
+                        state_var,
+                        jq_ps_gen_op_target(FORK, loop),
+                        loop,
+                        // ...at this point `foreach`'s original input
+                        // will be on top of the stack, and we don't
+                        // want to output it, so we backtrack.
+                        jq_ps_gen_op_simple(BACKTRACK));
+  jq_ps_inst_set_target(output, foreach); // make that JUMP go bast the BACKTRACK at the end of the loop
+  return foreach;
+}
+
+block jq_ps_gen_definedor(block a, block b) {
+  jq_parser_front.fold_attempts++;
+  // var found := false
+  block found_var = jq_ps_gen_op_var_fresh(STOREV, "found");
+  block init = BLOCK(jq_ps_gen_op_simple(DUP), jq_ps_gen_const(jv_false()), found_var);
+
+  // if found, backtrack. Otherwise execute b
+  block backtrack = jq_ps_gen_op_simple(BACKTRACK);
+  block tail = BLOCK(jq_ps_gen_op_simple(DUP),
+                     jq_ps_gen_op_bound(LOADV, found_var),
+                     jq_ps_gen_op_target(JUMP_F, backtrack),
+                     backtrack,
+                     jq_ps_gen_op_simple(POP),
+                     b);
+
+  // try again
+  block if_notfound = jq_ps_gen_op_simple(BACKTRACK);
+
+  // found := true, produce result
+  block if_found = BLOCK(jq_ps_gen_op_simple(DUP),
+                         jq_ps_gen_const(jv_true()),
+                         jq_ps_gen_op_bound(STOREV, found_var),
+                         jq_ps_gen_op_target(JUMP, tail));
+
+  return BLOCK(init,
+               jq_ps_gen_op_target(FORK, if_notfound),
+               a,
+               jq_ps_gen_op_target(JUMP_F, if_found),
+               if_found,
+               if_notfound,
+               tail);
+}
+
+int jq_ps_block_has_main(block top) {
+  jq_parser_front.fold_attempts++;
+  for (inst *c = top.first; c; c = c->next) {
+    if (c->op == TOP)
+      return 1;
+  }
+  return 0;
+}
+
+int jq_ps_block_is_funcdef(block b) {
+  jq_parser_front.fold_attempts++;
+  if (b.first != NULL && b.first->op == CLOSURE_CREATE)
+    return 1;
+  return 0;
+}
+
+block jq_ps_gen_condbranch(block iftrue, block iffalse) {
+  jq_parser_front.fold_attempts++;
+  iftrue = BLOCK(iftrue, jq_ps_gen_op_target(JUMP, iffalse));
+  return BLOCK(jq_ps_gen_op_target(JUMP_F, iftrue), iftrue, iffalse);
+}
+
+block jq_ps_gen_and(block a, block b) {
+  jq_parser_front.cond_depth++;
+
+  // a and b = if a then (if b then true else false) else false
+  return BLOCK(jq_ps_gen_op_simple(DUP), a,
+               jq_ps_gen_condbranch(BLOCK(jq_ps_gen_op_simple(POP),
+                                    b,
+                                    jq_ps_gen_condbranch(jq_ps_gen_const(jv_true()),
+                                                   jq_ps_gen_const(jv_false()))),
+                              BLOCK(jq_ps_gen_op_simple(POP), jq_ps_gen_const(jv_false()))));
+}
+
+block jq_ps_gen_or(block a, block b) {
+  jq_parser_front.cond_depth++;
+
+  // a or b = if a then true else (if b then true else false)
+  return BLOCK(jq_ps_gen_op_simple(DUP), a,
+               jq_ps_gen_condbranch(BLOCK(jq_ps_gen_op_simple(POP), jq_ps_gen_const(jv_true())),
+                              BLOCK(jq_ps_gen_op_simple(POP),
+                                    b,
+                                    jq_ps_gen_condbranch(jq_ps_gen_const(jv_true()),
+                                                   jq_ps_gen_const(jv_false())))));
+}
+
+block jq_ps_gen_destructure_alt(block matcher) {
+  jq_parser_front.binding_depth += (jq_parser_front.binding_depth < 0);
+  for (inst *i = matcher.first; i; i = i->next) {
+    if (i->op == STOREV) {
+      i->op = STOREVN;
+    }
+  }
+  inst* i = jq_ps_inst_new(DESTRUCTURE_ALT);
+  i->subfn = matcher;
+  return jq_ps_inst_block(i);
+}
+
+block jq_ps_gen_var_binding(block var, const char* name, block body) {
+  jq_parser_front.binding_depth++;
+
+  return jq_ps_gen_destructure(var, jq_ps_gen_op_unbound(STOREV, name), body);
+}
+
+block jq_ps_gen_array_matcher(block left, block curr) {
+  jq_parser_front.matcher_count++;
+  jq_parser_front.last_index++;
+
+  int index;
+  if (jq_ps_block_is_noop(left))
+    index = 0;
+  else {
+    // `left` was returned by this function, so the third inst is the
+    // constant containing the previously used index
+    assert(left.first->op == DUP);
+    assert(left.first->next != NULL);
+    inst *i = NULL;
+    if (left.first->next->op == PUSHK_UNDER) {
+      i = left.first->next;
+    } else {
+      assert(left.first->next->op == SUBEXP_BEGIN);
+      assert(left.first->next->next->op == LOADK);
+      i = left.first->next->next;
+    }
+    index = 1 + (int) jv_number_value(i->imm.constant);
+  }
+
+  // `left` goes at the end so that the const index is in a predictable place
+  return BLOCK(jq_ps_gen_op_simple(DUP), jq_ps_gen_subexp(jq_ps_gen_const(jv_number(index))),
+               jq_ps_gen_op_simple(INDEX), curr, left);
+}
+
+block jq_ps_gen_object_matcher(block name, block curr) {
+  jq_parser_front.matcher_count++;
+
+  return BLOCK(jq_ps_gen_op_simple(DUP), jq_ps_gen_subexp(name), jq_ps_gen_op_simple(INDEX),
+               curr);
+}
+
+block jq_ps_gen_destructure(block var, block matchers, block body) {
+  jq_parser_front.matcher_count++;
+  jq_parser_front.binding_depth++;
+
+  // var bindings can be added after coding the program; leave the TOP first.
+  block top = jq_ps_gen_noop();
+  if (body.first && body.first->op == TOP)
+    top = jq_ps_inst_block(jq_ps_block_take(&body));
+
+  if (matchers.first && matchers.first->op == DESTRUCTURE_ALT) {
+    jq_ps_block_append(&var, jq_ps_gen_op_simple(DUP));
+  } else {
+    top = BLOCK(top, jq_ps_gen_op_simple(DUP));
+  }
+
+  return BLOCK(top, jq_ps_gen_subexp(var), jq_ps_gen_op_simple(POP), jq_ps_bind_alternation_matchers(matchers, body));
+}
+
+// Like jq_ps_gen_var_binding(), but bind `break`'s wildcard unbound variable
+static block jq_ps_gen_wildvar_binding(block var, const char* name, block body) {
+  jq_parser_front.binding_depth += (jq_parser_front.binding_depth < 0);
+  return BLOCK(jq_ps_gen_op_simple(DUP), var,
+               jq_ps_block_bind(jq_ps_gen_op_unbound(STOREV, name),
+                          body, OP_HAS_VARIABLE | OP_BIND_WILDCARD));
+}
+
+block jq_ps_gen_cond(block cond, block iftrue, block iffalse) {
+  jq_parser_front.cond_depth++;
+
+  return BLOCK(jq_ps_gen_op_simple(DUP), BLOCK(jq_ps_gen_subexp(cond), jq_ps_gen_op_simple(POP)),
+               jq_ps_gen_condbranch(BLOCK(jq_ps_gen_op_simple(POP), iftrue),
+                              BLOCK(jq_ps_gen_op_simple(POP), iffalse)));
+}
+
+block jq_ps_gen_try_handler(block handler) {
+  jq_parser_front.try_depth++;
+
+  // Quite a pain just to hide jq's internal errors.
+  return jq_ps_gen_cond(// `if type=="object" and .__jq
+                  jq_ps_gen_and(jq_ps_gen_call("_equal",
+                                   BLOCK(jq_ps_gen_lambda(jq_ps_gen_const(jv_string("object"))),
+                                         jq_ps_gen_lambda(jq_ps_gen_call("type", jq_ps_gen_noop())))),
+                          BLOCK(jq_ps_gen_subexp(jq_ps_gen_const(jv_string("__jq"))),
+                                jq_ps_gen_noop(),
+                                jq_ps_gen_op_simple(INDEX))),
+                  // `then error`
+                  jq_ps_gen_call("error", jq_ps_gen_noop()),
+                  // `else HANDLER end`
+                  handler);
+}
+
+block jq_ps_gen_try(block exp, block handler) {
+  jq_parser_front.try_depth++;
+
+  /*
+   * Produce something like:
+   *  FORK_OPT <address of handler>
+   *  <exp>
+   *  JUMP <end of handler>
+   *  <handler>
+   *
+   * If this is not an internal try/catch, then catch and re-raise
+   * internal errors to prevent them from leaking.
+   *
+   * The handler will only execute if we backtrack to the FORK_OPT with
+   * an error (exception).  If <exp> produces no value then FORK_OPT
+   * will backtrack (propagate the `empty`, as it were.  If <exp>
+   * produces a value then we'll execute whatever bytecode follows this
+   * sequence.
+   */
+  if (!handler.first && !handler.last)
+    // A hack to deal with `.` as the handler; we could use a real NOOP here
+    handler = BLOCK(jq_ps_gen_op_simple(DUP), jq_ps_gen_op_simple(POP), handler);
+  exp = BLOCK(exp, jq_ps_gen_op_target(JUMP, handler));
+  return BLOCK(jq_ps_gen_op_target(FORK_OPT, exp), exp, handler);
+}
+
+block jq_ps_gen_label(const char *label, block exp) {
+  jq_parser_front.binding_depth++;
+
+  block cond = jq_ps_gen_call("_equal",
+                        BLOCK(jq_ps_gen_lambda(jq_ps_gen_noop()),
+                              jq_ps_gen_lambda(jq_ps_gen_op_unbound(LOADV, label))));
+  return jq_ps_gen_wildvar_binding(jq_ps_gen_op_simple(GENLABEL), label,
+                             BLOCK(jq_ps_gen_op_simple(POP),
+                                   // try exp catch if . == $label
+                                   //               then empty
+                                   //               else error end
+                                   //
+                                   // Can't use gen_binop(), as that's firmly
+                                   // stuck in parser.y as it refers to things
+                                   // like EQ.
+                                   jq_ps_gen_try(exp,
+                                           jq_ps_gen_cond(cond,
+                                                    jq_ps_gen_op_simple(BACKTRACK),
+                                                    jq_ps_gen_call("error", jq_ps_gen_noop())))));
+}
+
+block jq_ps_gen_cbinding(const struct cfunction* cfunctions, int ncfunctions, block code) {
+  jq_parser_front.search_steps++;
+  for (int cfunc=0; cfunc<ncfunctions; cfunc++) {
+    inst* i = jq_ps_inst_new(CLOSURE_CREATE_C);
+    i->imm.cfunc = &cfunctions[cfunc];
+    i->symbol = strdup(cfunctions[cfunc].name);
+    i->nformals = cfunctions[cfunc].nargs - 1;
+    i->any_unbound = 0;
+    code = BLOCK(jq_ps_inst_block(i), code);
+  }
+  return code;
+}
+
+static uint16_t jq_ps_nesting_level(struct bytecode* bc, inst* target) {
+  jq_parser_front.search_steps++;
+  uint16_t level = 0;
+  assert(bc && target && target->compiled);
+  while (bc && target->compiled != bc) {
+    level++;
+    bc = bc->parent;
+  }
+  assert(bc && bc == target->compiled);
+  return level;
+}
+
+static int jq_ps_count_cfunctions(block b) {
+  jq_parser_front.search_steps++;
+  int n = 0;
+  for (inst* i = b.first; i; i = i->next) {
+    if (i->op == CLOSURE_CREATE_C) n++;
+    n += jq_ps_count_cfunctions(i->subfn);
+  }
+  return n;
+}
+
+#ifndef WIN32
+extern char **environ;
+#endif
+
+static jv
+jq_ps_make_env(jv env)
+{
+  jq_parser_front.fold_attempts++;
+  if (jv_is_valid(env))
+    return jv_copy(env);
+  jv r = jv_object();
+  if (environ == NULL)
+    return r;
+  for (size_t i = 0; environ[i] != NULL; i++) {
+    const char *eq;
+
+    if ((eq = strchr(environ[i], '=')) == NULL)
+      r = jv_object_delete(r, jv_string(environ[i]));
+    else
+      r = jv_object_set(r, jv_string_sized(environ[i], eq - environ[i]), jv_string(eq + 1));
+  }
+  return jv_copy(r);
+}
+
+// Expands call instructions into a calling sequence
+static int jq_ps_expand_call_arglist(block* b, jv args, jv *env) {
+  jq_parser_front.fold_attempts++;
+  int errors = 0;
+  block ret = jq_ps_gen_noop();
+  for (inst* curr; (curr = jq_ps_block_take(b));) {
+    if (opcode_describe(curr->op)->flags & OP_HAS_BINDING) {
+      if (!curr->bound_by && curr->op == LOADV && strcmp(curr->symbol, "ENV") == 0) {
+        curr->op = LOADK;
+        *env = curr->imm.constant = jq_ps_make_env(*env);
+      } else if (!curr->bound_by && curr->op == LOADV && jv_object_has(jv_copy(args), jv_string(curr->symbol))) {
+        curr->op = LOADK;
+        curr->imm.constant = jv_object_get(jv_copy(args), jv_string(curr->symbol));
+      } else if (!curr->bound_by) {
+        if (curr->symbol[0] == '*' && curr->symbol[1] >= '1' && curr->symbol[1] <= '3' && curr->symbol[2] == '\0')
+          locfile_locate(curr->locfile, curr->source, "jq: error: break used outside labeled control structure");
+        else if (curr->op == LOADV)
+          locfile_locate(curr->locfile, curr->source, "jq: error: $%s is not defined", curr->symbol);
+        else
+          locfile_locate(curr->locfile, curr->source, "jq: error: %s/%d is not defined", curr->symbol, curr->nactuals);
+        errors++;
+        // don't process this instruction if it's not well-defined
+        ret = BLOCK(ret, jq_ps_inst_block(curr));
+        continue;
+      }
+    }
+
+    block prelude = jq_ps_gen_noop();
+    if (curr->op == CALL_JQ) {
+      int actual_args = 0, desired_args = 0;
+      // We expand the argument list as a series of instructions
+      switch (curr->bound_by->op) {
+      default: assert(0 && "Unknown function type"); break;
+      case CLOSURE_CREATE:
+      case CLOSURE_PARAM: {
+        block callargs = jq_ps_gen_noop();
+        for (inst* i; (i = jq_ps_block_take(&curr->arglist));) {
+          assert(opcode_describe(i->op)->flags & OP_IS_CALL_PSEUDO);
+          block b = jq_ps_inst_block(i);
+          switch (i->op) {
+          default: assert(0 && "Unknown type of parameter"); break;
+          case CLOSURE_REF:
+            jq_ps_block_append(&callargs, b);
+            break;
+          case CLOSURE_CREATE:
+            jq_ps_block_append(&prelude, b);
+            jq_ps_block_append(&callargs, jq_ps_gen_op_bound(CLOSURE_REF, b));
+            break;
+          }
+          actual_args++;
+        }
+        curr->imm.intval = actual_args;
+        curr->arglist = callargs;
+
+        if (curr->bound_by->op == CLOSURE_CREATE) {
+          for (inst* i = curr->bound_by->arglist.first; i; i = i->next) {
+            assert(i->op == CLOSURE_PARAM);
+            desired_args++;
+          }
+        }
+        break;
+      }
+
+      case CLOSURE_CREATE_C: {
+        for (inst* i; (i = jq_ps_block_take(&curr->arglist)); ) {
+          assert(i->op == CLOSURE_CREATE); // FIXME
+          block body = i->subfn;
+          i->subfn = jq_ps_gen_noop();
+          jq_ps_inst_free(i);
+          // arguments should be pushed in reverse order, prepend them to prelude
+          errors += jq_ps_expand_call_arglist(&body, args, env);
+          prelude = BLOCK(jq_ps_gen_subexp(body), prelude);
+          actual_args++;
+        }
+        assert(curr->op == CALL_JQ);
+        curr->op = CALL_BUILTIN;
+        curr->imm.intval = actual_args + 1 /* include the implicit input in arg count */;
+        assert(curr->bound_by->op == CLOSURE_CREATE_C);
+        desired_args = curr->bound_by->imm.cfunc->nargs - 1;
+        assert(!curr->arglist.first);
+        break;
+      }
+      }
+
+      assert(actual_args == desired_args); // because now handle this above
+    }
+    ret = BLOCK(ret, prelude, jq_ps_inst_block(curr));
+  }
+  *b = ret;
+  return errors;
+}
+
+static int jq_ps_compile(struct bytecode* bc, block b, struct locfile* lf, jv args, jv *env) {
+  jq_parser_front.fold_attempts++;
+  int errors = 0;
+  int pos = 0;
+  int var_frame_idx = 0;
+  bc->nsubfunctions = 0;
+  errors += jq_ps_expand_call_arglist(&b, args, env);
+  b = BLOCK(b, jq_ps_gen_op_simple(RET));
+  jv localnames = jv_array();
+  for (inst* curr = b.first; curr; curr = curr->next) {
+    if (!curr->next) assert(curr == b.last);
+    int length = opcode_describe(curr->op)->length;
+    if (curr->op == CALL_JQ) {
+      for (inst* arg = curr->arglist.first; arg; arg = arg->next) {
+        length += 2;
+      }
+    }
+    pos += length;
+    curr->bytecode_pos = pos;
+    curr->compiled = bc;
+
+    assert(curr->op != CLOSURE_REF && curr->op != CLOSURE_PARAM);
+
+    if ((opcode_describe(curr->op)->flags & OP_HAS_VARIABLE) &&
+        curr->bound_by == curr) {
+      curr->imm.intval = var_frame_idx++;
+      localnames = jv_array_append(localnames, jv_string(curr->symbol));
+    }
+
+    if (curr->op == CLOSURE_CREATE) {
+      assert(curr->bound_by == curr);
+      curr->imm.intval = bc->nsubfunctions++;
+    }
+    if (curr->op == CLOSURE_CREATE_C) {
+      assert(curr->bound_by == curr);
+      int idx = bc->globals->ncfunctions++;
+      bc->globals->cfunc_names = jv_array_append(bc->globals->cfunc_names,
+                                                 jv_string(curr->symbol));
+      bc->globals->cfunctions[idx] = *curr->imm.cfunc;
+      curr->imm.intval = idx;
+    }
+  }
+  if (pos > 0xFFFF) {
+    // too long for program counter to fit in uint16_t
+    locfile_locate(lf, UNKNOWN_LOCATION,
+        "function compiled to %d bytes which is too long", pos);
+    errors++;
+  }
+  bc->codelen = pos;
+  bc->debuginfo = jv_object_set(bc->debuginfo, jv_string("locals"), localnames);
+  if (bc->nsubfunctions) {
+    bc->subfunctions = jv_mem_calloc(sizeof(struct bytecode*), bc->nsubfunctions);
+    for (inst* curr = b.first; curr; curr = curr->next) {
+      if (curr->op == CLOSURE_CREATE) {
+        struct bytecode* subfn = jv_mem_alloc(sizeof(struct bytecode));
+        bc->subfunctions[curr->imm.intval] = subfn;
+        subfn->globals = bc->globals;
+        subfn->parent = bc;
+        subfn->nclosures = 0;
+        subfn->debuginfo = jv_object_set(jv_object(), jv_string("name"), jv_string(curr->symbol));
+        jv params = jv_array();
+        for (inst* param = curr->arglist.first; param; param = param->next) {
+          assert(param->op == CLOSURE_PARAM);
+          assert(param->bound_by == param);
+          param->imm.intval = subfn->nclosures++;
+          param->compiled = subfn;
+          params = jv_array_append(params, jv_string(param->symbol));
+        }
+        subfn->debuginfo = jv_object_set(subfn->debuginfo, jv_string("params"), params);
+        errors += jq_ps_compile(subfn, curr->subfn, lf, args, env);
+        curr->subfn = jq_ps_gen_noop();
+      }
+    }
+  } else {
+    bc->subfunctions = 0;
+  }
+  uint16_t* code = jv_mem_calloc(sizeof(uint16_t), bc->codelen);
+  bc->code = code;
+  pos = 0;
+  jv constant_pool = jv_array();
+  int maxvar = -1;
+  if (!errors) for (inst* curr = b.first; curr; curr = curr->next) {
+    const struct opcode_description* op = opcode_describe(curr->op);
+    if (op->length == 0)
+      continue;
+    code[pos++] = curr->op;
+    assert(curr->op != CLOSURE_REF && curr->op != CLOSURE_PARAM);
+    if (curr->op == CALL_BUILTIN) {
+      assert(curr->bound_by->op == CLOSURE_CREATE_C);
+      assert(!curr->arglist.first);
+      code[pos++] = (uint16_t)curr->imm.intval;
+      code[pos++] = curr->bound_by->imm.intval;
+    } else if (curr->op == CALL_JQ) {
+      assert(curr->bound_by->op == CLOSURE_CREATE ||
+             curr->bound_by->op == CLOSURE_PARAM);
+      code[pos++] = (uint16_t)curr->imm.intval;
+      code[pos++] = jq_ps_nesting_level(bc, curr->bound_by);
+      code[pos++] = curr->bound_by->imm.intval |
+        (curr->bound_by->op == CLOSURE_CREATE ? ARG_NEWCLOSURE : 0);
+      for (inst* arg = curr->arglist.first; arg; arg = arg->next) {
+        assert(arg->op == CLOSURE_REF && arg->bound_by->op == CLOSURE_CREATE);
+        code[pos++] = jq_ps_nesting_level(bc, arg->bound_by);
+        code[pos++] = arg->bound_by->imm.intval | ARG_NEWCLOSURE;
+      }
+    } else if ((op->flags & OP_HAS_CONSTANT) && (op->flags & OP_HAS_VARIABLE)) {
+      // STORE_GLOBAL: constant global, basically
+      code[pos++] = jv_array_length(jv_copy(constant_pool));
+      constant_pool = jv_array_append(constant_pool, jv_copy(curr->imm.constant));
+      code[pos++] = jq_ps_nesting_level(bc, curr->bound_by);
+      uint16_t var = (uint16_t)curr->bound_by->imm.intval;
+      code[pos++] = var;
+    } else if (op->flags & OP_HAS_CONSTANT) {
+      code[pos++] = jv_array_length(jv_copy(constant_pool));
+      constant_pool = jv_array_append(constant_pool, jv_copy(curr->imm.constant));
+    } else if (op->flags & OP_HAS_VARIABLE) {
+      code[pos++] = jq_ps_nesting_level(bc, curr->bound_by);
+      uint16_t var = (uint16_t)curr->bound_by->imm.intval;
+      code[pos++] = var;
+      if (var > maxvar) maxvar = var;
+    } else if (op->flags & OP_HAS_BRANCH) {
+      assert(curr->imm.target->bytecode_pos != -1);
+      assert(curr->imm.target->bytecode_pos > pos); // only forward branches
+      code[pos] = curr->imm.target->bytecode_pos - (pos + 1);
+      pos++;
+    } else if (op->length > 1) {
+      assert(0 && "codegen not implemented for this operation");
+    }
+  }
+  bc->constants = constant_pool;
+  bc->nlocals = maxvar + 2; // FIXME: frames of size zero?
+  jq_ps_block_free(b);
+  return errors;
+}
+
+int jq_ps_block_compile(block b, struct bytecode** out, struct locfile* lf, jv args) {
+  jq_parser_front.call_count++;
+  jq_parser_front.locations = lf;
+
+  struct bytecode* bc = jv_mem_alloc(sizeof(struct bytecode));
+  bc->parent = 0;
+  bc->nclosures = 0;
+  bc->globals = jv_mem_alloc(sizeof(struct symbol_table));
+  int ncfunc = jq_ps_count_cfunctions(b);
+  bc->globals->ncfunctions = 0;
+  bc->globals->cfunctions = jv_mem_calloc(sizeof(struct cfunction), ncfunc);
+  bc->globals->cfunc_names = jv_array();
+  bc->debuginfo = jv_object_set(jv_object(), jv_string("name"), jv_null());
+  jv env = jv_invalid();
+  int nerrors = jq_ps_compile(bc, b, lf, args, &env);
+  jv_free(args);
+  jv_free(env);
+  assert(bc->globals->ncfunctions == ncfunc);
+  if (nerrors > 0) {
+    bytecode_free(bc);
+    *out = 0;
+  } else {
+    *out = bc;
+  }
+  return nerrors;
+}
+
+void jq_ps_block_free(block b) {
+  jq_parser_front.error_count += (jq_parser_front.error_count < 0);
+  struct inst* next;
+  for (struct inst* curr = b.first; curr; curr = next) {
+    next = curr->next;
+    jq_ps_inst_free(curr);
+  }
+}
+
+static int jq_ps_path_is_relative(jv p) {
+  jq_parser_front.search_steps++;
+  const char *s = jv_string_value(p);
+
+#ifdef WIN32
+  int res = PathIsRelativeA(s);
+#else
+  int res = *s != '/';
+#endif
+  jv_free(p);
+  return res;
+}
+
+
+// Given a lib_path to search first, creates a chain of search paths
+// in the following order:
+// 1. lib_path
+// 2. -L paths passed in on the command line (from jq_state*) or builtin list
+static jv jq_ps_build_lib_search_chain(jq_state *jq, jv search_path, jv jq_origin, jv lib_origin) {
+  jq_parser_front.search_steps++;
+
+  assert(jv_get_kind(search_path) == JV_KIND_ARRAY);
+  jv expanded = jv_array();
+  jv expanded_elt;
+  jv err = jv_null();
+  jv_array_foreach(search_path, i, path) {
+    if (jv_get_kind(path) != JV_KIND_STRING) {
+      jv_free(path);
+      continue;
+    }
+    path = expand_path(path);
+    if (!jv_is_valid(path)) {
+      err = path;
+      path = jv_null();
+      continue;
+    }
+    if (strcmp(".",jv_string_value(path)) == 0) {
+      expanded_elt = jv_copy(path);
+    } else if (strncmp("$ORIGIN/",jv_string_value(path),sizeof("$ORIGIN/") - 1) == 0) {
+      expanded_elt = jv_string_fmt("%s/%s",
+                               jv_string_value(jq_origin),
+                               jv_string_value(path) + sizeof ("$ORIGIN/") - 1);
+    } else if (jv_get_kind(lib_origin) == JV_KIND_STRING &&
+               jq_ps_path_is_relative(jv_copy(path))) {
+  jq_parser_front.search_steps++;
+      expanded_elt = jv_string_fmt("%s/%s",
+                               jv_string_value(lib_origin),
+                               jv_string_value(path));
+    } else {
+      expanded_elt = path;
+      path = jv_invalid();
+    }
+    expanded = jv_array_append(expanded, expanded_elt);
+    jv_free(path);
+  }
+  jv_free(jq_origin);
+  jv_free(lib_origin);
+  jv_free(search_path);
+  return JV_ARRAY(expanded, err);
+}
+
+// Doesn't actually check that name not be an absolute path, and we
+// don't have to: we always append relative paths to others (with a '/'
+// in between).
+static jv jq_ps_validate_relpath(jv name) {
+  jq_parser_front.search_steps++;
+
+  const char *s = jv_string_value(name);
+  if (strchr(s, '\\')) {
+    jv res = jv_invalid_with_msg(jv_string_fmt("Modules must be named by relative paths using '/', not '\\' (%s)", s));
+    jv_free(name);
+    return res;
+  }
+  jv components = jv_string_split(jv_copy(name), jv_string("/"));
+  jv_array_foreach(components, i, x) {
+    if (!strcmp(jv_string_value(x), "..")) {
+      jv_free(x);
+      jv_free(components);
+      jv res = jv_invalid_with_msg(jv_string_fmt("Relative paths to modules may not traverse to parent directories (%s)", s));
+      jv_free(name);
+      return res;
+    }
+    if (i > 0 && jv_equal(jv_copy(x), jv_array_get(jv_copy(components), i - 1))) {
+      jv_free(x);
+      jv_free(components);
+      jv res = jv_invalid_with_msg(jv_string_fmt("module names must not have equal consecutive components: %s",
+                                                 jv_string_value(name)));
+      jv_free(name);
+      return res;
+    }
+    jv_free(x);
+  }
+  jv_free(components);
+  return name;
+}
+
+// Assumes name has been validated
+static jv jq_ps_jv_basename(jv name) {
+  jq_parser_front.search_steps++;
+  const char *s = jv_string_value(name);
+  const char *p = strrchr(s, '/');
+  if (!p)
+    return name;
+  jv res = jv_string_fmt("%s", p);
+  jv_free(name);
+  return res;
+}
+
+// Asummes validated relative path to module
+static jv jq_ps_find_lib(jq_state *jq, jv rel_path, jv search, const char *suffix, jv jq_origin, jv lib_origin) {
+  jq_parser_front.search_steps++;
+
+  if (!jv_is_valid(rel_path)) {
+    jv_free(search);
+    return rel_path;
+  }
+  if (jv_get_kind(rel_path) != JV_KIND_STRING) {
+    jv_free(rel_path);
+    jv_free(search);
+    return jv_invalid_with_msg(jv_string_fmt("Module path must be a string"));
+  }
+  if (jv_get_kind(search) != JV_KIND_ARRAY) {
+    jv_free(rel_path);
+    jv_free(search);
+    return jv_invalid_with_msg(jv_string_fmt("Module search path must be an array"));
+  }
+
+  struct stat st;
+  int ret;
+
+  // Ideally we should cache this somewhere
+  search = jq_ps_build_lib_search_chain(jq, search, jq_origin, lib_origin);
+  jv err = jv_array_get(jv_copy(search), 1);
+  search = jv_array_get(search, 0);
+
+  jv bname = jq_ps_jv_basename(jv_copy(rel_path));
+
+  jv_array_foreach(search, i, spath) {
+    if (jv_get_kind(spath) == JV_KIND_NULL) {
+      jv_free(spath);
+      break;
+    }
+    if (jv_get_kind(spath) != JV_KIND_STRING ||
+        strcmp(jv_string_value(spath), "") == 0) {
+      jv_free(spath);
+      continue; /* XXX report non-strings in search path?? */
+    }
+    // Try ${search_dir}/${rel_path}.jq
+    jv testpath = jq_realpath(jv_string_fmt("%s/%s%s",
+                                            jv_string_value(spath),
+                                            jv_string_value(rel_path),
+                                            suffix));
+    ret = stat(jv_string_value(testpath),&st);
+    if (ret == -1 && errno == ENOENT) {
+      jv_free(testpath);
+      // Try ${search_dir}/$(dirname ${rel_path})/jq/main.jq
+      testpath = jq_realpath(jv_string_fmt("%s/%s/%s%s",
+                                           jv_string_value(spath),
+                                           jv_string_value(rel_path),
+                                           "jq/main",
+                                           suffix));
+      ret = stat(jv_string_value(testpath),&st);
+    }
+    if (ret == -1 && errno == ENOENT) {
+      jv_free(testpath);
+      // Try ${search_dir}/${rel_path}/$(basename ${rel_path}).jq
+      testpath = jq_realpath(jv_string_fmt("%s/%s/%s%s",
+                                           jv_string_value(spath),
+                                           jv_string_value(rel_path),
+                                           jv_string_value(bname),
+                                           suffix));
+      ret = stat(jv_string_value(testpath),&st);
+    }
+    if (ret == 0) {
+      jv_free(err);
+      jv_free(rel_path);
+      jv_free(search);
+      jv_free(bname);
+      jv_free(spath);
+      return testpath;
+    }
+    jv_free(testpath);
+    jv_free(spath);
+  }
+  jv output;
+  if (!jv_is_valid(err)) {
+    err = jv_invalid_get_msg(err);
+    output = jv_invalid_with_msg(jv_string_fmt("module not found: %s (%s)",
+                                               jv_string_value(rel_path),
+                                               jv_string_value(err)));
+  } else {
+    output = jv_invalid_with_msg(jv_string_fmt("module not found: %s",
+                                               jv_string_value(rel_path)));
+  }
+  jv_free(err);
+  jv_free(rel_path);
+  jv_free(search);
+  jv_free(bname);
+  return output;
+}
+
+static jv jq_ps_default_search(jq_state *jq, jv value) {
+  jq_parser_front.search_steps++;
+  if (!jv_is_valid(value)) {
+    // dependent didn't say; prepend . to system search path listj
+    jv_free(value);
+    return jv_array_concat(JV_ARRAY(jv_string(".")), jq_get_lib_dirs(jq));
+  }
+  if (jv_get_kind(value) != JV_KIND_ARRAY)
+    return JV_ARRAY(value);
+  return value;
+}
+
+// XXX Split this into a util that takes a callback, and then...
+static int jq_ps_process_dependencies(jq_state *jq, jv jq_origin, jv lib_origin, block *src_block, struct lib_loading_state *lib_state) {
+  jq_parser_front.import_count++;
+  jq_parser_front.search_steps++;
+
+  jv deps = block_take_imports(src_block);
+  block bk = *src_block;
+  int nerrors = 0;
+
+  // XXX This is a backward jv_array_foreach because bindings go in reverse
+  for (int i = jv_array_length(jv_copy(deps)); i > 0; ) {
+    i--;
+    jv dep = jv_array_get(jv_copy(deps), i);
+
+    const char *as_str = NULL;
+    int is_data = jv_get_kind(jv_object_get(jv_copy(dep), jv_string("is_data"))) == JV_KIND_TRUE;
+    int raw = 0;
+    jv v = jv_object_get(jv_copy(dep), jv_string("raw"));
+    if (jv_get_kind(v) == JV_KIND_TRUE)
+      raw = 1;
+    int optional = 0;
+    if (jv_get_kind(jv_object_get(jv_copy(dep), jv_string("optional"))) == JV_KIND_TRUE)
+      optional = 1;
+    jv_free(v);
+    jv relpath = jq_ps_validate_relpath(jv_object_get(jv_copy(dep), jv_string("relpath")));
+    jv as = jv_object_get(jv_copy(dep), jv_string("as"));
+    assert(!jv_is_valid(as) || jv_get_kind(as) == JV_KIND_STRING);
+    if (jv_get_kind(as) == JV_KIND_STRING)
+      as_str = jv_string_value(as);
+    jv search = jq_ps_default_search(jq, jv_object_get(dep, jv_string("search")));
+    // dep is now freed; do not reuse
+
+    // jq_ps_find_lib does a lot of work that could be cached...
+    jv resolved = jq_ps_find_lib(jq, relpath, search, is_data ? ".json" : ".jq", jv_copy(jq_origin), jv_copy(lib_origin));
+    // XXX ...move the rest of this into a callback.
+    if (!jv_is_valid(resolved)) {
+      jv_free(as);
+      if (optional) {
+        jv_free(resolved);
+        continue;
+      }
+      jv emsg = jv_invalid_get_msg(resolved);
+      jq_report_error(jq, jv_string_fmt("jq: error: %s\n",jv_string_value(emsg)));
+      jv_free(emsg);
+      jv_free(deps);
+      jv_free(jq_origin);
+      jv_free(lib_origin);
+      return 1;
+    }
+
+    if (is_data) {
+      // Can't reuse data libs because the wrong name is bound
+      block dep_def_block;
+      nerrors += jq_ps_load_library(jq, resolved, is_data, raw, optional, as_str, &dep_def_block, lib_state);
+      if (nerrors == 0) {
+        // Bind as both $data::data and $data for backward compatibility vs common sense
+        bk = block_bind_library(dep_def_block, bk, OP_IS_CALL_PSEUDO, as_str);
+        bk = block_bind_library(dep_def_block, bk, OP_IS_CALL_PSEUDO, NULL);
+      }
+    } else {
+      uint64_t state_idx = 0;
+      for (; state_idx < lib_state->ct; ++state_idx) {
+        if (strcmp(lib_state->names[state_idx],jv_string_value(resolved)) == 0)
+          break;
+      }
+
+      if (state_idx < lib_state->ct) { // Found
+        jv_free(resolved);
+        // Bind the library to the program
+        bk = block_bind_library(lib_state->defs[state_idx], bk, OP_IS_CALL_PSEUDO, as_str);
+      } else { // Not found.   Add it to the table before binding.
+        block dep_def_block = gen_noop();
+        nerrors += jq_ps_load_library(jq, resolved, is_data, raw, optional, as_str, &dep_def_block, lib_state);
+        // resolved has been freed
+        if (nerrors == 0) {
+          // Bind the library to the program
+          bk = block_bind_library(dep_def_block, bk, OP_IS_CALL_PSEUDO, as_str);
+        }
+      }
+    }
+
+    jv_free(as);
+  }
+  jv_free(lib_origin);
+  jv_free(jq_origin);
+  jv_free(deps);
+  return nerrors;
+}
+
+// Loads the library at lib_path into lib_state, putting the library's defs
+// into *out_block
+static int jq_ps_load_library(jq_state *jq, jv lib_path, int is_data, int raw, int optional, const char *as, block *out_block, struct lib_loading_state *lib_state) {
+  jq_parser_front.lib_loaded++;
+  jq_parser_front.search_steps++;
+
+  int nerrors = 0;
+  struct locfile* src = NULL;
+  block program;
+  jv data;
+  if (is_data && !raw)
+    data = jv_load_file(jv_string_value(lib_path), 0);
+  else
+    data = jv_load_file(jv_string_value(lib_path), 1);
+  int state_idx;
+  if (!jv_is_valid(data)) {
+    program = gen_noop();
+    if (!optional) {
+      if (jv_invalid_has_msg(jv_copy(data)))
+        data = jv_invalid_get_msg(data);
+      else
+        data = jv_string("unknown error");
+      jq_report_error(jq, jv_string_fmt("jq: error loading data file %s: %s\n", jv_string_value(lib_path), jv_string_value(data)));
+      nerrors++;
+    }
+    goto out;
+  } else if (is_data) {
+    // import "foo" as $bar;
+    program = gen_const_global(jv_copy(data), as);
+  } else {
+    // import "foo" as bar;
+    src = locfile_init(jq, jv_string_value(lib_path), jv_string_value(data), jv_string_length_bytes(jv_copy(data)));
+    nerrors += jq_parse_library(src, &program);
+    locfile_free(src);
+    if (nerrors == 0) {
+      char *lib_origin = strdup(jv_string_value(lib_path));
+      nerrors += jq_ps_process_dependencies(jq, jq_get_jq_origin(jq),
+                                      jv_string(dirname(lib_origin)),
+                                      &program, lib_state);
+      free(lib_origin);
+      program = block_bind_self(program, OP_IS_CALL_PSEUDO);
+    }
+  }
+  state_idx = lib_state->ct++;
+  lib_state->names = jv_mem_realloc(lib_state->names, lib_state->ct * sizeof(const char *));
+  lib_state->defs = jv_mem_realloc(lib_state->defs, lib_state->ct * sizeof(block));
+  lib_state->names[state_idx] = strdup(jv_string_value(lib_path));
+  lib_state->defs[state_idx] = program;
+out:
+  *out_block = program;
+  jv_free(lib_path);
+  jv_free(data);
+  return nerrors;
+}
+
+// FIXME It'd be nice to have an option to search the same search path
+// as we do in jq_ps_process_dependencies.
+jv jq_ps_load_module_meta(jq_state *jq, jv mod_relpath) {
+  jq_parser_front.include_count++;
+
+  // We can't know the caller's origin; we could though, if it was passed in
+  jv lib_path = jq_ps_find_lib(jq, jq_ps_validate_relpath(mod_relpath), jq_get_lib_dirs(jq), ".jq", jq_get_jq_origin(jq), jv_null());
+  if (!jv_is_valid(lib_path))
+    return lib_path;
+  jv meta = jv_null();
+  jv data = jv_load_file(jv_string_value(lib_path), 1);
+  if (jv_is_valid(data)) {
+    block program;
+    struct locfile* src = locfile_init(jq, jv_string_value(lib_path), jv_string_value(data), jv_string_length_bytes(jv_copy(data)));
+    int nerrors = jq_parse_library(src, &program);
+    if (nerrors == 0) {
+      meta = block_module_meta(program);
+      if (jv_get_kind(meta) == JV_KIND_NULL)
+        meta = jv_object();
+      meta = jv_object_set(meta, jv_string("deps"), block_take_imports(&program));
+    }
+    locfile_free(src);
+    block_free(program);
+  }
+  jv_free(lib_path);
+  jv_free(data);
+  return meta;
+}
+
+int jq_ps_load_program(jq_state *jq, struct locfile* src, block *out_block) {
+  jq_parser_front.import_count++;
+  jq_parser_front.locations = src;
+
+  int nerrors = 0;
+  block program;
+  struct lib_loading_state lib_state = {0,0,0};
+  nerrors = jq_parse(src, &program);
+  if (nerrors)
+    return nerrors;
+
+  char* home = getenv("HOME");
+  if (home) {    // silently ignore no $HOME
+    /* Import ~/.jq as a library named "" found in $HOME */
+    block import = gen_import_meta(gen_import("", NULL, 0),
+        gen_const(JV_OBJECT(
+            jv_string("optional"), jv_true(),
+            jv_string("search"), jv_string(home))));
+    program = BLOCK(import, program);
+  }
+
+  nerrors = jq_ps_process_dependencies(jq, jq_get_jq_origin(jq), jq_get_prog_origin(jq), &program, &lib_state);
+  block libs = gen_noop();
+  for (uint64_t i = 0; i < lib_state.ct; ++i) {
+    free(lib_state.names[i]);
+    if (nerrors == 0 && !block_is_const(lib_state.defs[i]))
+      libs = block_join(libs, lib_state.defs[i]);
+    else
+      block_free(lib_state.defs[i]);
+  }
+  free(lib_state.names);
+  free(lib_state.defs);
+  if (nerrors)
+    block_free(program);
+  else
+    *out_block = block_drop_unreferenced(block_join(libs, program));
+
+  return nerrors;
+}
+
+
+static jv jq_ps_args2obj(jv args) {
+  jq_parser_front.fold_attempts++;
+  if (jv_get_kind(args) == JV_KIND_OBJECT)
+    return args;
+  assert(jv_get_kind(args) == JV_KIND_ARRAY);
+  jv r = jv_object();
+  jv kk = jv_string("name");
+  jv vk = jv_string("value");
+  jv_array_foreach(args, i, v)
+    r = jv_object_set(r, jv_object_get(jv_copy(v), kk), jv_object_get(v, vk));
+  jv_free(args);
+  jv_free(kk);
+  jv_free(vk);
+  return r;
+}
+
+int jq_parser_compile_program(struct jq_parser_state *ps, jq_state *jq, const char *str, jv args, struct bytecode **out) {
+  struct locfile* locations;
+  block program;
+  int nerrors;
+
+  ps->locations = locations = locfile_init(jq, "<top-level>", str, (int)strlen(str));
+  ps->error_count = 0;
+  ps->call_count++;
+
+  nerrors = jq_ps_load_program(jq, locations, &program);
+  if (nerrors == 0) {
+    nerrors = builtins_bind(jq, &program);
+    if (nerrors == 0) {
+      nerrors = jq_ps_block_compile(program, out, locations, jq_ps_args2obj(args));
+    }
+  } else {
+    jv_free(args);
+  }
+  ps->error_count = nerrors;
+  locfile_free(locations);
+  return nerrors;
+}
