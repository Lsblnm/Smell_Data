+    private function applyMultilineDeclarationIndentation(Tokens $tokens): void
+    {
+        $propertyModifierTokens = [T_PUBLIC, T_PROTECTED, T_PRIVATE, T_STATIC, T_VAR];
+
+        if (\defined('T_READONLY')) {
+            $propertyModifierTokens[] = T_READONLY;
+        }
+
+        $declarationTokens = array_merge($propertyModifierTokens, [T_CONST]);
+        $count = \count($tokens);
+
+        for ($index = 0; $index < $count; ++$index) {
+            if ($tokens[$index]->isGivenKind(T_CONST)) {
+                $itemIndex = $tokens->getNextMeaningfulToken($index);
+
+                if (null !== $itemIndex) {
+                    $this->fixMultilineDeclarationIndentation($tokens, $index, $itemIndex);
+                }
+
+                continue;
+            }
+
+            if (!$tokens[$index]->isGivenKind($propertyModifierTokens)) {
+                continue;
+            }
+
+            $prevIndex = $tokens->getPrevMeaningfulToken($index);
+
+            if (null !== $prevIndex && $tokens[$prevIndex]->isGivenKind($declarationTokens)) {
+                continue;
+            }
+
+            $itemIndex = $this->findPropertyDeclarationVariableIndex($tokens, $index);
+
+            if (null !== $itemIndex) {
+                $this->fixMultilineDeclarationIndentation($tokens, $index, $itemIndex);
+            }
+        }
+    }
+
+    private function findPropertyDeclarationVariableIndex(Tokens $tokens, int $index): ?int
+    {
+        for ($scan = $tokens->getNextMeaningfulToken($index); null !== $scan; $scan = $tokens->getNextMeaningfulToken($scan)) {
+            $token = $tokens[$scan];
+
+            if ($token->isGivenKind(T_VARIABLE)) {
+                return $scan;
+            }
+
+            if ($token->isGivenKind([T_FUNCTION, T_FN, T_CONST, T_USE, T_CASE, T_DEFAULT])) {
+                return null;
+            }
+
+            if ($token->equalsAny([';', '{', '}', '='])) {
+                return null;
+            }
+
+            $blockType = Tokens::detectBlockType($token);
+
+            if (null !== $blockType && $blockType['isStart']) {
+                $scan = $tokens->findBlockEnd($blockType['type'], $scan);
+            }
+        }
+
+        return null;
+    }
+
+    private function fixMultilineDeclarationIndentation(Tokens $tokens, int $startIndex, int $itemIndex): void
+    {
+        $startLineNewline = $this->getPreviousNewlineTokenIndex($tokens, $startIndex);
+        $itemLineNewline = $this->getPreviousNewlineTokenIndex($tokens, $itemIndex);
+
+        if ($itemLineNewline === $startLineNewline || null === $itemLineNewline) {
+            return;
+        }
+
+        $declarationIndent = $this->getLineIndentation($tokens, $startIndex);
+        $desiredItemIndent = $declarationIndent.$this->whitespacesConfig->getIndent();
+
+        $itemStarts = [$itemIndex];
+        $semicolonIndex = null;
+
+        $scan = $itemIndex;
+        while (null !== $scan) {
+            $token = $tokens[$scan];
+
+            if ($token->equals(';')) {
+                $semicolonIndex = $scan;
+
+                break;
+            }
+
+            if ($token->equals(',')) {
+                $scan = $tokens->getNextMeaningfulToken($scan);
+
+                if (null !== $scan) {
+                    $itemStarts[] = $scan;
+                }
+
+                continue;
+            }
+
+            $blockType = Tokens::detectBlockType($token);
+
+            if (null !== $blockType && $blockType['isStart']) {
+                $scan = $tokens->getNextMeaningfulToken($tokens->findBlockEnd($blockType['type'], $scan));
+
+                continue;
+            }
+
+            $scan = $tokens->getNextMeaningfulToken($scan);
+        }
+
+        if (null === $semicolonIndex) {
+            return;
+        }
+
+        $semicolonLineNewline = $this->getPreviousNewlineTokenIndex($tokens, $semicolonIndex);
+        $semicolonOnOwnLine = false;
+
+        if (null !== $semicolonLineNewline && $semicolonLineNewline > $itemLineNewline) {
+            $firstMeaningfulOnLine = $tokens->getNextMeaningfulToken($semicolonLineNewline);
+
+            if ($firstMeaningfulOnLine === $semicolonIndex) {
+                $semicolonOnOwnLine = true;
+            }
+        }
+
+        foreach ($itemStarts as $position => $currentItemIndex) {
+            $currentLineNewline = $this->getPreviousNewlineTokenIndex($tokens, $currentItemIndex);
+
+            if (null === $currentLineNewline) {
+                continue;
+            }
+
+            $originalIndent = $this->getLineIndentation($tokens, $currentItemIndex);
+            $indentShift = '';
+
+            if (str_starts_with($desiredItemIndent, $originalIndent)) {
+                $indentShift = substr($desiredItemIndent, \strlen($originalIndent));
+            } elseif (str_starts_with($originalIndent, $desiredItemIndent)) {
+                $indentShift = '~-'.substr($originalIndent, \strlen($desiredItemIndent));
+            }
+
+            $this->replaceWhitespaceLineIndent($tokens, $currentLineNewline, $desiredItemIndent);
+
+            if (isset($itemStarts[$position + 1])) {
+                $rangeEnd = $this->getPreviousNewlineTokenIndex($tokens, $itemStarts[$position + 1]);
+            } else {
+                $rangeEnd = $semicolonIndex;
+            }
+
+            if (null === $rangeEnd) {
+                $rangeEnd = $semicolonIndex;
+            }
+
+            for ($whitespaceIndex = $currentLineNewline + 1; $whitespaceIndex < $rangeEnd; ++$whitespaceIndex) {
+                if ($tokens[$whitespaceIndex]->isWhitespace()) {
+                    $this->shiftWhitespaceLineIndent($tokens, $whitespaceIndex, $indentShift);
+                }
+            }
+        }
+
+        if ($semicolonOnOwnLine) {
+            $this->replaceWhitespaceLineIndent($tokens, $semicolonLineNewline, $declarationIndent);
+        }
+    }
+
+    private function replaceWhitespaceLineIndent(Tokens $tokens, int $index, string $indent): void
+    {
+        if (!$tokens[$index]->isWhitespace()) {
+            return;
+        }
+
+        $content = $tokens[$index]->getContent();
+
+        if (!Preg::match('/\R/', $content)) {
+            return;
+        }
+
+        $content = Preg::replace('/(\R+)\h*$/', '$1'.$indent, $content);
+
+        if ($content !== $tokens[$index]->getContent()) {
+            $tokens[$index] = new Token([T_WHITESPACE, $content]);
+        }
+    }
+
+    private function shiftWhitespaceLineIndent(Tokens $tokens, int $index, string $shift): void
+    {
+        if ('' === $shift) {
+            return;
+        }
+
+        $content = $tokens[$index]->getContent();
+
+        if (!Preg::match('/(\R+)(\h*)$/D', $content, $matches)) {
+            return;
+        }
+
+        $indent = $matches[2];
+
+        if (str_starts_with($shift, '~-')) {
+            $remove = substr($shift, 2);
+
+            if ('' !== $remove && str_ends_with($indent, $remove)) {
+                $indent = substr($indent, 0, -\strlen($remove));
+            }
+        } else {
+            $indent .= $shift;
+        }
+
+        $content = substr($content, 0, \strlen($content) - \strlen($matches[0])).$matches[1].$indent;
+
+        if ($content !== $tokens[$index]->getContent()) {
+            $tokens[$index] = new Token([T_WHITESPACE, $content]);
+        }
     }
 
     private function findStatementEndIndex(Tokens $tokens, int $index, int $parentScopeEndIndex): int
