+      def parse_endpoint(endpoint)
+        bind, port = parse_rpc_endpoint(endpoint)
+        unless bind && port && port.between?(1, 65535)
+          raise Fluent::ConfigError, "Invalid rpc_endpoint: #{endpoint}"
+        end
+
+        bind = resolve_bind_address(bind)
+        [bind, port]
+      rescue SocketError, ArgumentError
+        raise Fluent::ConfigError, "Invalid rpc_endpoint: #{endpoint}"
+      end
+
+      def parse_rpc_endpoint(endpoint)
+        endpoint = endpoint.to_s
+        if (m = endpoint.match(/\A\[([^\]]+)\]:([0-9]+)\z/))
+          [m[1], m[2].to_i]
+        elsif (m = endpoint.match(/\A([^:]+):([0-9]+)\z/))
+          [m[1], m[2].to_i]
+        elsif endpoint.count(':') > 1 && (m = endpoint.match(/\A(.+):([0-9]+)\z/))
+          [m[1], m[2].to_i]
+        else
+          nil
+        end
+      end
+
+      def resolve_bind_address(bind)
+        raise SocketError, "invalid bind address: #{bind}" if bind.include?('*')
+
+        addrinfos = Addrinfo.getaddrinfo(bind, nil, nil, :STREAM)
+        return bind if bind.include?(':')
+
+        address = addrinfos.find(&:ipv4?) || addrinfos.first
+        raise SocketError, "failed to resolve bind address: #{bind}" unless address
+        address.ip_address
+      end
+
