diff --git a/src/db.c b/src/db.c
index 8d21eaf2b..71c0d7226 100644
--- a/src/db.c
+++ b/src/db.c
@@ -3850,9 +3850,19 @@ robj *lookupKey(serverDb *db, robj *key, int flags) {
         /* Update the access time for the ageing algorithm.
          * Don't do it if we have a saving child, as this will trigger
          * a copy on write madness. */
-        if (server.current_client && server.current_client->flag.no_touch &&
-            server.current_client->cmd->proc != touchCommand)
-            flags |= LOOKUP_NOTOUCH;
+        if (server.current_client && server.current_client->flag.no_touch) {
+            /* TOUCH is allowed to update the access time even in no-touch
+             * mode. When TOUCH is called from a script, server.current_client
+             * is the caller running EVAL while server.executing_client is the
+             * script client running TOUCH, so check both. */
+            int is_touch_command = 0;
+            if (server.executing_client && server.executing_client->cmd != NULL &&
+                server.executing_client->cmd->proc == touchCommand)
+                is_touch_command = 1;
+            if (server.current_client->cmd != NULL && server.current_client->cmd->proc == touchCommand)
+                is_touch_command = 1;
+            if (!is_touch_command) flags |= LOOKUP_NOTOUCH;
+        }
         if (!hasActiveChildProcess() && !(flags & LOOKUP_NOTOUCH)) {
             /* Shared objects can't be stored in the database. */
             serverAssert(val->refcount != OBJ_SHARED_REFCOUNT);
