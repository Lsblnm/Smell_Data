+    fn print_header_component(
+        &mut self,
+        handle: &mut OutputHandle,
+        segments: &[(String, Style)],
+    ) -> Result<()> {
+        let has_grid_border = self.config.style_components.grid() && self.panel_width > 0;
+        let indent_width = self.panel_width + usize::from(has_grid_border) * 2;
+        let max_width = self.config.term_width.saturating_sub(indent_width).max(1);
+
+        self.print_header_component_indent(handle)?;
+
+        let mut line_width = 0;
+        let mut line_segments: Vec<(String, Style)> = Vec::new();
+
+        for (text, style) in segments {
+            let mut current = String::new();
+
+            for c in text.chars() {
+                let char_width = self.measure_display_width(c);
+
+                if line_width > 0 && line_width + char_width > max_width {
+                    if !current.is_empty() {
+                        line_segments.push((std::mem::take(&mut current), *style));
+                    }
+
+                    self.write_header_line(handle, &line_segments)?;
+                    line_segments.clear();
+                    line_width = 0;
+
+                    self.print_header_component_indent(handle)?;
+                }
+
+                current.push(c);
+                line_width += char_width;
+            }
+
+            if !current.is_empty() {
+                line_segments.push((current, *style));
+            }
+        }
+
+        self.write_header_line(handle, &line_segments)
+    }
+
+    fn write_header_line(
+        &self,
+        handle: &mut OutputHandle,
+        segments: &[(String, Style)],
+    ) -> Result<()> {
+        for (text, style) in segments {
+            write!(handle, "{}", style.paint(text))?;
+        }
+        writeln!(handle)?;
+        Ok(())
+    }
+
