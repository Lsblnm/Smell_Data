diff --git a/lib/fluent/rpc.rb b/lib/fluent/rpc.rb
index 1a7a36c2..8ece9340 100644
--- a/lib/fluent/rpc.rb
+++ b/lib/fluent/rpc.rb
@@ -24,7 +24,16 @@ module Fluent
   module RPC
     class Server
       def initialize(endpoint, log)
-        bind, port = endpoint.split(':')
+        endpoint = endpoint.to_s
+        if match = /\A\[([^\]]+)\]:(\d+)\z/.match(endpoint)
+          bind, port = match[1], match[2]
+        else
+          match = /\A([^:\[\]]+):(\d+)\z/.match(endpoint)
+          unless match && match[1].match?(/\A[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9])?\z/)
+            raise Fluent::ConfigError, "Invalid rpc_endpoint: #{endpoint}"
+          end
+          bind, port = match[1], match[2]
+        end
         @bind = bind
         @port = port
         @log = log
