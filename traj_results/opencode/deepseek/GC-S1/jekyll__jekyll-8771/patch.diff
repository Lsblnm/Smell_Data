diff --git a/lib/jekyll/data_entry.rb b/lib/jekyll/data_entry.rb
new file mode 100644
index 000000000..6a4da1495
--- /dev/null
+++ b/lib/jekyll/data_entry.rb
@@ -0,0 +1,40 @@
+# frozen_string_literal: true
+
+require "delegate"
+
+module Jekyll
+  class DataEntry < SimpleDelegator
+    include Comparable
+
+    attr_reader :data, :path
+
+    def initialize(data, path = nil)
+      @data = data
+      @path = path
+      super(data)
+    end
+
+    def <=>(other)
+      other = other.data if other.is_a?(DataEntry)
+      data <=> other
+    end
+
+    def ==(other)
+      other = other.data if other.is_a?(DataEntry)
+      data == other
+    end
+    alias_method :eql?, :==
+
+    def hash
+      data.hash
+    end
+
+    def to_liquid
+      data
+    end
+
+    def dup
+      self.class.new(data.dup, path)
+    end
+  end
+end
diff --git a/lib/jekyll/data_hash.rb b/lib/jekyll/data_hash.rb
new file mode 100644
index 000000000..a2768316d
--- /dev/null
+++ b/lib/jekyll/data_hash.rb
@@ -0,0 +1,54 @@
+# frozen_string_literal: true
+
+require "delegate"
+
+module Jekyll
+  class DataHash < SimpleDelegator
+    def initialize(data = {})
+      @data = data
+      super(data)
+    end
+
+    def data
+      __getobj__
+    end
+
+    def []=(key, value)
+      raise FrozenError, "can't modify frozen #{self.class}: #{inspect}" if frozen?
+
+      __getobj__[key] = value
+    end
+
+    def merge(other, &block)
+      self.class.new(__getobj__.merge(unwrap(other), &block))
+    end
+
+    def merge!(other, &block)
+      raise FrozenError, "can't modify frozen #{self.class}: #{inspect}" if frozen?
+
+      __getobj__.merge!(unwrap(other), &block)
+      self
+    end
+
+    def update(other, &block)
+      merge!(other, &block)
+    end
+
+    def dup
+      self.class.new(__getobj__.dup)
+    end
+
+    def to_hash
+      __getobj__
+    end
+
+    private
+
+    def unwrap(other)
+      return other.data if other.is_a?(DataHash)
+      return other.data if other.is_a?(DataEntry)
+
+      other
+    end
+  end
+end
