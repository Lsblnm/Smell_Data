       delegate_methods :time, :pages, :static_files, :tags, :categories
 
       private delegate_method_as :config, :fallback_data
@@ -20,6 +19,12 @@ module Jekyll
         end
       end
 
+      def data
+        @site_data ||= @obj.site_data
+        add_data_dependencies(@site_data)
+        @site_data
+      end
+
       def key?(key)
         (key != "posts" && @obj.collections.key?(key)) || super
       end
@@ -59,6 +64,33 @@ module Jekyll
 
       # return nil for `{{ site.config }}` even if --config was passed via CLI
       def config; end
+
+      private
+
+      def add_data_dependencies(data)
+        return unless @current_document.respond_to?(:path)
+
+        document_path = @current_document.path
+        return if document_path.nil?
+        return unless data.respond_to?(:each_value)
+
+        source_path = @obj.in_source_dir(document_path)
+        collect_data_paths(data).uniq.each do |path|
+          @obj.regenerator.add_dependency(source_path, path)
+        end
+      end
+
+      def collect_data_paths(value)
+        case value
+        when DataEntry
+          paths = value.path ? [value.path] : []
+          paths + collect_data_paths(value.data)
+        when DataHash, Hash
+          value.each_value.flat_map { |entry| collect_data_paths(entry) }
+        else
+          []
+        end
+      end
     end
   end
 end
