+    private function findMemberDeclarationEndIndex(Tokens $tokens, int $index): ?int
+    {
+        static $memberFirstTokens = null;
+
+        if (null === $memberFirstTokens) {
+            $memberFirstTokens = [T_CONST, T_VAR, T_PUBLIC, T_PROTECTED, T_PRIVATE, T_STATIC, T_ABSTRACT, T_FINAL];
+
+            if (\defined('T_READONLY')) {
+                $memberFirstTokens[] = T_READONLY;
+            }
+        }
+
+        if (!$tokens[$index]->isGivenKind($memberFirstTokens)) {
+            return null;
+        }
+
+        $previousIndex = $tokens->getPrevMeaningfulToken($index);
+
+        if (null !== $previousIndex && !$tokens[$previousIndex]->equalsAny([';', '{', '}', [T_OPEN_TAG], [CT::T_ATTRIBUTE_CLOSE]])) {
+            return null;
+        }
+
+        if ($tokens[$index]->isGivenKind([T_CONST, T_VAR])) {
+            $declarationTokenIndex = $index;
+        } else {
+            $searchIndex = $index;
+
+            while (true) {
+                $searchIndex = $tokens->getNextMeaningfulToken($searchIndex);
+
+                if (null === $searchIndex) {
+                    return null;
+                }
+
+                $searchToken = $tokens[$searchIndex];
+
+                if ($searchToken->isGivenKind(T_FUNCTION)) {
+                    return null;
+                }
+
+                if ($searchToken->isGivenKind([T_CONST, T_VARIABLE])) {
+                    $declarationTokenIndex = $searchIndex;
+
+                    break;
+                }
+
+                if ($searchToken->isGivenKind($memberFirstTokens)) {
+                    continue;
+                }
+
+                if (\defined('T_ATTRIBUTE') && $searchToken->isGivenKind(T_ATTRIBUTE)) {
+                    $searchIndex = $tokens->findBlockEnd(Tokens::BLOCK_TYPE_ATTRIBUTE, $searchIndex);
+
+                    continue;
+                }
+
+                if ($searchToken->equalsAny([';', '{', '}', '(', ')', '=', ','])) {
+                    return null;
+                }
+            }
+        }
+
+        for ($searchIndex = $declarationTokenIndex, $max = \count($tokens); $searchIndex < $max; ++$searchIndex) {
+            $searchToken = $tokens[$searchIndex];
+            $blockDefinitionProbe = Tokens::detectBlockType($searchToken);
+
+            if (null !== $blockDefinitionProbe && $blockDefinitionProbe['isStart']) {
+                $searchIndex = $tokens->findBlockEnd($blockDefinitionProbe['type'], $searchIndex);
+
+                continue;
+            }
+
+            if ($searchToken->equals(';')) {
+                return $searchIndex;
+            }
+
+            if ($searchToken->equalsAny(['}', [T_CLOSE_TAG]])) {
+                return null;
+            }
+        }
+
+        return null;
+    }
+
+    private function shiftIndent(string $indent, string $from, string $to): string
+    {
+        if (str_starts_with($indent, $from)) {
+            return $to.substr($indent, \strlen($from));
+        }
+
+        if (str_starts_with($from, $indent)) {
+            $suffixLength = \strlen($from) - \strlen($indent);
+
+            if (\strlen($to) > $suffixLength) {
+                return substr($to, 0, -$suffixLength);
+            }
+
+            return '';
+        }
+
+        return $to;
+    }
+
