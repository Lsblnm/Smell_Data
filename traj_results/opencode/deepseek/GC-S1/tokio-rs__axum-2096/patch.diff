+    pub(super) fn merge_fallback(
+        &mut self,
+        other: PathRouter<S, IS_FALLBACK>,
+        use_other_fallback: bool,
+    ) -> Result<(), Cow<'static, str>> {
+        let PathRouter {
+            routes,
+            node,
+            prev_route_id: _,
+        } = other;
+
+        for (id, route) in routes {
+            let path = node
+                .route_id_to_path
+                .get(&id)
+                .expect("no path for route id. This is a bug in axum. Please file an issue");
+
+            // The fallback itself is registered at `/` and `/*__private__axum_fallback`.
+            // It is handled separately from nested fallbacks so merging a router doesn't
+            // accidentally remove fallbacks added with `nest`.
+            let is_fallback = path.as_ref() == "/"
+                || path
+                    .as_ref()
+                    .strip_prefix("/*")
+                    .map(|suffix| suffix == FALLBACK_PARAM)
+                    .unwrap_or(false);
+
+            if is_fallback {
+                if use_other_fallback {
+                    self.replace_endpoint(path, route);
+                }
+            } else {
+                match route {
+                    Endpoint::MethodRouter(method_router) => self.route(path, method_router)?,
+                    Endpoint::Route(route) => self.route_service(path, route)?,
+                }
+            }
+        }
+
+        Ok(())
+    }
