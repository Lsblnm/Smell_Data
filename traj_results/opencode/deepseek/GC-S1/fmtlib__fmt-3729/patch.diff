@@ -117,6 +120,10 @@ template <typename Char> struct formatter<std::filesystem::path, Char> {
       debug_ = true;
       ++it;
     }
+    if (it != end && (*it == 'n' || *it == 'g')) {
+      path_type_ = *it;
+      ++it;
+    }
     return it;
   }
 
@@ -126,11 +133,11 @@ template <typename Char> struct formatter<std::filesystem::path, Char> {
     detail::handle_dynamic_spec<detail::width_checker>(specs.width, width_ref_,
