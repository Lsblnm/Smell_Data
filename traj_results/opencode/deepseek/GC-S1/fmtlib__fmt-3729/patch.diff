+  if (path_type == 'g')
+    return coordinator.convert_native_path(p,
+                                           p.generic_string<PathChar>());
   return coordinator.convert_native_path(p, native);
 }
 
 template <typename Char, typename PathChar>
 void write_escaped_path(basic_memory_buffer<Char>& quoted,
                         const std::filesystem::path& p,
-                        const std::basic_string<PathChar>& native) {
+                        const std::basic_string<PathChar>& native,
+                        char path_type) {
   formatter<std::filesystem::path, Char> coordinator;
-  coordinator.write_escaped_native_path(quoted, p, native);
+  if (path_type == 'g')
+    coordinator.write_escaped_native_path(quoted, p,
+                                          p.generic_string<PathChar>());
+  else
+    coordinator.write_escaped_native_path(quoted, p, native);
 }
 
 }  // namespace detail
