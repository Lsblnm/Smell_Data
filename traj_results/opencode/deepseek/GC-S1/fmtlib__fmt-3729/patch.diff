@@ -3492,17 +3499,26 @@ namespace detail {
 
 template <typename Char, typename PathChar>
 auto get_path_string(const std::filesystem::path& p,
-                     const std::basic_string<PathChar>& native) {
+                     const std::basic_string<PathChar>& native,
+                     char path_type) {
