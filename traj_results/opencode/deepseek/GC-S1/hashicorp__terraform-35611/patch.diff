+func (t *AttachResourceConfigTransformer) findRemovedConfig(addr addrs.ConfigResource) *configs.Removed {
+	var result *configs.Removed
+	t.Config.DeepEach(func(cfg *configs.Config) {
+		if result != nil || cfg.Module == nil {
+			return
+		}
+		for _, r := range cfg.Module.Removed {
+			crAddr, ok := r.From.RelSubject.(addrs.ConfigResource)
+			if !ok {
+				// Not for a resource at all, so can't possibly match.
+				continue
+			}
+			targetModule := make(addrs.Module, 0, len(cfg.Path)+len(crAddr.Module))
+			targetModule = append(targetModule, cfg.Path...)
+			targetModule = append(targetModule, crAddr.Module...)
+			if !targetModule.Equal(addr.Module) || crAddr.Resource != addr.Resource {
+				continue
+			}
+			result = r
+			return
+		}
+	})
+	return result
+}
