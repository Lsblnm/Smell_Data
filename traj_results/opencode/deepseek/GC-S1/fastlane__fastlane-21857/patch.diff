@@ -438,6 +438,15 @@ module FastlaneCore
           end
           @table_state[:method] = 'transform_display_output'
         @table_state[:rows] = rows
+        if rows.kind_of?(Array)
+          rows = rows.map do |row|
+            if row.kind_of?(Array)
+              row.map { |column| sanitize_cell_value(column) }
+            else
+              sanitize_cell_value(row)
