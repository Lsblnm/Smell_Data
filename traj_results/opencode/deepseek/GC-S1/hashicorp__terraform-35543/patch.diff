+// validateImportBlocks performs the validation that used to only happen while
+// planning a configuration. Import blocks are detached from the resource they
+// target during validation, so we validate the "to" and "id" expressions here
+// to catch missing references and self-references without doing any provider
+// work.
+func (n *NodeValidatableResource) validateImportBlocks(ctx EvalContext) tfdiags.Diagnostics {
+	var diags tfdiags.Diagnostics
+	if len(n.importTargets) == 0 {
+		return diags
+	}
+
+	// Import blocks are only valid in the root module, and their expressions
+	// must be evaluated in that context regardless of where the target resource
+	// is declared.
+	ctx = evalContextForModuleInstance(ctx, addrs.RootModuleInstance)
+
+	for _, imp := range n.importTargets {
+		if imp.Config == nil {
+			// Legacy CLI imports don't have configuration to validate.
+			continue
+		}
+		config := imp.Config
+
+		if config.ForEach == nil {
+			target, toDiags := evalImportToExpression(config.To, EvalDataForNoInstanceKey)
+			diags = diags.Append(toDiags)
+			if toDiags.HasErrors() {
+				continue
+			}
+			_, idDiags := evaluateImportIdExpression(config.ID, target, ctx, EvalDataForNoInstanceKey, true)
+			diags = diags.Append(idDiags)
+			continue
+		}
+
+		ev := newForEachEvaluator(config.ForEach, ctx, true)
+		forEachVal, forEachDiags := ev.Value()
+		diags = diags.Append(forEachDiags)
+		if forEachDiags.HasErrors() {
+			continue
+		}
+
+		if !forEachVal.IsKnown() {
+			// We can't enumerate the instances yet, but we can still validate
+			// the target address and the ID expression using unknown values
+			// for each.key and each.value.
+			if _, toDiags := evalImportUnknownToExpression(config.To); toDiags.HasErrors() {
+				diags = diags.Append(toDiags)
+				continue
+			}
+			keyData := instances.RepetitionData{
+				EachKey:   cty.UnknownVal(cty.String),
+				EachValue: cty.UnknownVal(cty.DynamicPseudoType),
+			}
+			target := addrs.AbsResourceInstance{
+				Module:   config.ToResource.Module.UnkeyedInstanceShim(),
+				Resource: config.ToResource.Resource.Instance(addrs.NoKey),
+			}
+			_, idDiags := evaluateImportIdExpression(config.ID, target, ctx, keyData, true)
+			diags = diags.Append(idDiags)
+			continue
+		}
+
+		if forEachVal.IsNull() {
+			continue
+		}
+
+		if !forEachVal.CanIterateElements() {
+			diags = diags.Append(&hcl.Diagnostic{
+				Severity: hcl.DiagError,
+				Summary:  "Invalid import for_each argument",
+				Detail:   "The given \"for_each\" argument value is unsuitable: the value must be a map, or set of strings, or a list of objects.",
+				Subject:  config.ForEach.Range().Ptr(),
+			})
+			continue
+		}
+
+		forEachData, _, importDiags := ev.ImportValues()
+		diags = diags.Append(importDiags)
+		if importDiags.HasErrors() {
+			continue
+		}
+		for _, keyData := range forEachData {
+			target, toDiags := evalImportToExpression(config.To, keyData)
+			diags = diags.Append(toDiags)
+			if toDiags.HasErrors() {
+				continue
+			}
+			_, idDiags := evaluateImportIdExpression(config.ID, target, ctx, keyData, true)
+			diags = diags.Append(idDiags)
+		}
+	}
+
+	return diags
+}
