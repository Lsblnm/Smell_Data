diff --git a/lib/fpm/package/deb.rb b/lib/fpm/package/deb.rb
index aa91911..36e01da 100644
--- a/lib/fpm/package/deb.rb
+++ b/lib/fpm/package/deb.rb
@@ -25,6 +25,12 @@ class FPM::Package::Deb < FPM::Package
   # The list of supported compression types. Default is gz (gzip)
   COMPRESSION_TYPES = [ "gz", "bzip2", "xz", "none" ]
 
+  # A Debian version is [epoch:]upstream_version[-debian_revision]
+  DEBIAN_VERSION_RE = /(?:[0-9]+:[0-9][A-Za-z0-9.+~:]*(?:-[A-Za-z0-9.+~]+)*|[0-9][A-Za-z0-9.+~]*(?:-[A-Za-z0-9.+~]+)*)/
+
+  # Provides entries may name a package, optionally with an exact (= version).
+  VALID_PROVIDES_RE = /\A[a-z0-9][a-z0-9+.-]*(?:\s*\(\s*=\s*#{DEBIAN_VERSION_RE}\s*\))?\z/
+
   option "--ignore-iteration-in-dependencies", :flag,
             "For '=' (equal) dependencies, allow iterations on the specified " \
             "version. Default is to be specific. This option allows the same " \
@@ -773,6 +779,7 @@ class FPM::Package::Deb < FPM::Package
   end # def fix_dependency
 
   def fix_provides(provides)
+    provides = provides.strip
     name_re = /^[^ \(]+/
     name = provides[name_re]
     if name =~ /[A-Z]/
@@ -791,7 +798,15 @@ class FPM::Package::Deb < FPM::Package
       logger.warn("Replacing 'provides' entry #{provides} with syntax 'name (= version)'")
       provides = "#{m[1]} (= #{m[2]})"
     end
-    return provides.rstrip
+
+    provides = provides.rstrip
+    if !provides.match(VALID_PROVIDES_RE)
+      raise FPM::InvalidPackageConfiguration,
+        "Invalid 'Provides' entry #{provides.inspect}. Debian provides must be a " \
+        "package name optionally followed by an exact version, like 'foo (= 1.0)'"
+    end
+
+    return provides
   end
 
   def control_path(path=nil)
