diff --git a/lib/rubocop/cop/layout/empty_lines_around_method_body.rb b/lib/rubocop/cop/layout/empty_lines_around_method_body.rb
index dcff5b54b..9a4c145b9 100644
--- a/lib/rubocop/cop/layout/empty_lines_around_method_body.rb
+++ b/lib/rubocop/cop/layout/empty_lines_around_method_body.rb
@@ -26,9 +26,10 @@ module RuboCop
         extend AutoCorrector
 
         KIND = 'method'
+        IGNORED_DEF_HEADER_TOKENS = %i[tNL tIGNORED_NL tCOMMENT].freeze
 
         def on_def(node)
-          check(node, node.body)
+          check(node, node.body, adjusted_first_line: adjusted_def_first_line(node))
         end
         alias on_defs on_def
 
@@ -61,6 +62,22 @@ module RuboCop
         end
         private
 
+        def adjusted_def_first_line(node)
+          body = node.body
+          return unless body
+
+          def_header_tokens(node, body).last&.line
+        end
+
+        def def_header_tokens(node, body)
+          name_end = node.loc.name.end_pos
+          body_begin = body.source_range.begin_pos
+          processed_source.tokens.select do |token|
+            token.begin_pos >= name_end && token.begin_pos < body_begin &&
+              !IGNORED_DEF_HEADER_TOKENS.include?(token.type)
+          end
+        end
+
         def style
           :no_empty_lines
         end
