diff --git a/lib/fluent/plugin/output.rb b/lib/fluent/plugin/output.rb
index 6611ef8f..33b144b6 100644
--- a/lib/fluent/plugin/output.rb
+++ b/lib/fluent/plugin/output.rb
@@ -93,7 +93,8 @@ module Fluent
         # c: constant factor, @retry_wait
         # b: base factor, @retry_exponential_backoff_base
         # k: times
-        # total retry time: c + c * b^1 + (...) + c*b^k = c*b^(k+1) - 1
+        # The first retry is after c, and the k-th retry is after c * b^(k-1), so the
+        # total retry time is c + c * b^1 + (...) + c * b^(k-1) = c * (b^k - 1) / (b - 1)
         config_param :retry_wait, :time, default: 1, desc: 'Seconds to wait before next retry to flush, or constant factor of exponential backoff.'
         config_param :retry_exponential_backoff_base, :float, default: 2, desc: 'The base number of exponential backoff for retries.'
         config_param :retry_max_interval, :time, default: nil, desc: 'The maximum interval seconds for exponential backoff between retries while failing.'
