+#[cfg(unix)]
+fn parse_signal(value: &str) -> UResult<Signal> {
+    let resolved = value.to_ascii_uppercase();
+    if let Some(value) = uucore::signals::signal_by_name_or_value(&resolved) {
+        if let Ok(signal) = Signal::try_from(value as i32) {
+            return Ok(signal);
+        }
+    }
+    Err(USimpleError::new(
+        125,
+        format!("{}: invalid signal", value.quote()),
+    ))
+}
+
+#[cfg(unix)]
+fn parse_ignore_signals(values: &[&OsStr]) -> UResult<(Vec<Signal>, bool)> {
+    let mut signals = Vec::new();
+    let mut all = false;
+    for value in values {
+        let value = value.to_string_lossy();
+        if value == ALL_SIGNALS_MARKER {
+            all = true;
+            for (number, _) in uucore::signals::ALL_SIGNALS.iter().enumerate() {
+                if let Ok(signal) = Signal::try_from(number as i32) {
+                    signals.push(signal);
+                }
+            }
+        } else {
+            for value in value.split(',').filter(|s| !s.is_empty()) {
+                signals.push(parse_signal(value)?);
+            }
+        }
+    }
+    Ok((signals, all))
+}
+
+#[cfg(unix)]
+fn apply_ignore_signals(opts: &Options<'_>) -> UResult<()> {
+    let (signals, ignore_unsupported) = parse_ignore_signals(&opts.ignore_signals)?;
+    for signal in signals {
+        // Ignoring SIGCHLD in the parent makes waiting for the child fail with ECHILD,
+        // since the child would be reaped automatically. Keep the default action when
+        // a command is going to be run.
+        if signal == Signal::SIGCHLD && !opts.program.is_empty() {
+            continue;
+        }
+        let action = SigAction::new(SigHandler::SigIgn, SaFlags::empty(), SigSet::empty());
+        // SAFETY: We only install a signal handler that ignores the signal.
+        if let Err(error) = unsafe { sigaction(signal, &action) } {
+            if !ignore_unsupported {
+                return Err(USimpleError::new(
+                    125,
+                    format!(
+                        "failed to set signal action for signal {}: {}",
+                        signal as i32,
+                        error.desc()
+                    ),
+                ));
+            }
+        }
+    }
+    Ok(())
+}
+
+#[cfg(not(unix))]
+fn apply_ignore_signals(_opts: &Options<'_>) -> UResult<()> {
+    Ok(())
+}
