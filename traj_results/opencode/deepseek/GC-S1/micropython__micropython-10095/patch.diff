diff --git a/py/runtime.c b/py/runtime.c
index 23fae6041..b5f0bc05d 100644
--- a/py/runtime.c
+++ b/py/runtime.c
@@ -907,6 +907,21 @@ void mp_call_prepare_args_n_kw_var(bool have_self, size_t n_args_n_kw, const mp_
         }
     }
 
+    // Check for duplicate keyword arguments.
+    for (size_t i = 0; i < (args2_len - pos_args_len) / 2; i++) {
+        mp_obj_t key = args2[pos_args_len + 2 * i];
+        for (size_t j = 0; j < i; j++) {
+            if (mp_obj_equal(key, args2[pos_args_len + 2 * j])) {
+                #if MICROPY_ERROR_REPORTING <= MICROPY_ERROR_REPORTING_TERSE
+                mp_raise_TypeError(MP_ERROR_TEXT("duplicate keyword argument"));
+                #else
+                mp_raise_msg_varg(&mp_type_TypeError,
+                    MP_ERROR_TEXT("function got multiple values for keyword argument '%q'"), MP_OBJ_QSTR_VALUE(key));
+                #endif
+            }
+        }
+    }
+
     out_args->fun = fun;
     out_args->args = args2;
     out_args->n_args = pos_args_len;
