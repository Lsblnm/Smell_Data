diff --git a/src/Carbon/AbstractTranslator.php b/src/Carbon/AbstractTranslator.php
index 33834593..eb7d3a96 100644
--- a/src/Carbon/AbstractTranslator.php
+++ b/src/Carbon/AbstractTranslator.php
@@ -96,6 +96,34 @@ abstract class AbstractTranslator extends Translation\Translator
         $this->initializing = false;
     }
 
+    /**
+     * Keep only the locale when serializing as messages may contain closures.
+     */
+    public function __serialize(): array
+    {
+        return ['locale' => $this->getLocale()];
+    }
+
+    /**
+     * Restore the translator for the serialized locale.
+     */
+    public function __unserialize(array $data): void
+    {
+        $locale = $data['locale'] ?? null;
+
+        if ($locale === null) {
+            foreach ($data as $key => $value) {
+                if (\is_string($key) && str_ends_with($key, "\0locale")) {
+                    $locale = $value;
+
+                    break;
+                }
+            }
+        }
+
+        $this->__construct($locale ?? 'en');
+    }
+
