+impl<S, B, E> Handler<((),), S, B> for MethodRouter<S, B, E>
+where
+    B: HttpBody + Send + 'static,
+    S: Clone + Send + Sync + 'static,
+    E: IntoResponse + Send + 'static,
+{
+    type Future = futures_util::future::Map<
+        RouteFuture<B, E>,
+        fn(Result<Response, E>) -> Response,
+    >;
+
+    fn call(self, req: Request<B>, state: S) -> Self::Future {
+        fn into_response<E>(res: Result<Response, E>) -> Response
+        where
+            E: IntoResponse,
+        {
+            match res {
+                Ok(res) => res,
+                Err(err) => err.into_response(),
+            }
+        }
+
+        let mut this = self;
+        this.call_with_state(req, state)
+            .map(into_response as fn(_) -> _)
+    }
+}
+
 impl<B, E> Service<Request<B>> for MethodRouter<(), B, E>
 where
