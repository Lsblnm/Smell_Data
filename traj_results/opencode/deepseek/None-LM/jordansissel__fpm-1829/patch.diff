diff --git a/lib/fpm/package/deb.rb b/lib/fpm/package/deb.rb
index 93d9e4d..e0a73e6 100644
--- a/lib/fpm/package/deb.rb
+++ b/lib/fpm/package/deb.rb
@@ -793,7 +793,16 @@ class FPM::Package::Deb < FPM::Package
       logger.warn("Replacing 'provides' entry #{provides} with syntax 'name (= version)'")
       provides = "#{m[1]} (= #{m[2]})"
     end
-    return provides.rstrip
+
+    provides = provides.rstrip
+    if !provides.match(/^[^\s()]+$/) &&
+        !provides.match(/^[^\s()]+\s*\(\s*=\s*[^\s()]+\s*\)$/)
+      raise FPM::InvalidPackageConfiguration,
+        "Invalid Provides field '#{provides}'. Debian Provides entries must be " \
+        "a package name optionally followed by an exact version, for example " \
+        "'foo' or 'foo (= 1.0.0)'."
+    end
+    return provides
   end
 
   def control_path(path=nil)
