+    /**
+     * @param list<Token> $tokensToInsert
+     *
+     * @return list<string>
+     */
+    private static function getInsertedAttributeArguments(array $tokensToInsert): array
+    {
+        $arguments = [];
+        $current = null;
+        $inArguments = false;
+
+        foreach ($tokensToInsert as $token) {
+            if ($token->isGivenKind(T_ATTRIBUTE)) {
+                $current = '';
+                $inArguments = false;
+
+                continue;
+            }
+
+            if (null === $current) {
+                continue;
+            }
+
+            if ($token->isGivenKind(CT::T_ATTRIBUTE_CLOSE)) {
+                $arguments[] = $current;
+                $current = null;
+
+                continue;
+            }
+
+            if (!$inArguments) {
+                if ($token->equals('(')) {
+                    $inArguments = true;
+                    $current .= '(';
+                }
+
+                continue;
+            }
+
+            if (!$token->isWhitespace()) {
+                $current .= $token->getContent();
+            }
+        }
+
+        return $arguments;
+    }
+
+    private static function getAttributeArguments(Tokens $tokens, int $startIndex, int $endIndex): string
+    {
+        $arguments = '';
+        $inArguments = false;
+
+        for ($index = $startIndex; $index <= $endIndex; ++$index) {
+            if (!$inArguments) {
+                if ($tokens[$index]->equals('(')) {
+                    $inArguments = true;
+                    $arguments .= '(';
+                }
+
+                continue;
+            }
+
+            if (!$tokens[$index]->isWhitespace()) {
+                $arguments .= $tokens[$index]->getContent();
+            }
+        }
+
+        return $arguments;
+    }
