+// parseOptStrings parses the string values as a list.
+func parseOptStrings(d *caddyfile.Dispenser, _ interface{}) (interface{}, error) {
+	var allStrings []string
+	for d.Next() {
+		allStrings = append(allStrings, d.RemainingArgs()...)
+	}
+	return allStrings, nil
