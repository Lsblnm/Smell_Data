+#[cfg(unix)]
+fn parse_signal_spec(sigspec: &OsStr) -> Option<Signal> {
+    let name = sigspec.to_str()?;
+    if let Ok(value) = name.parse::<u8>() {
+        return Signal::try_from(i32::from(value)).ok();
+    }
+    let upper = name.to_ascii_uppercase();
+    let signal_name = upper.strip_prefix("SIG").unwrap_or(&upper);
+    ALL_SIGNALS
+        .iter()
+        .position(|&s| s == signal_name)
+        .and_then(|idx| Signal::try_from(idx as i32).ok())
+}
+
+fn ignore_signals(sigspecs: &[&OsStr]) -> UResult<()> {
+    #[cfg(unix)]
+    for sigspec in sigspecs {
+        // An empty signal specification is a no-op, just like in GNU env.
+        if sigspec.is_empty() {
+            continue;
+        }
+        let signal = parse_signal_spec(sigspec).ok_or_else(|| {
+            USimpleError::new(125, format!("{}: invalid signal", sigspec.quote()))
+        })?;
+        let action = SigAction::new(SigHandler::SigIgn, SaFlags::empty(), SigSet::all());
+        if let Err(e) = unsafe { sigaction(signal, &action) } {
+            return Err(USimpleError::new(
+                125,
+                format!("failed to set signal action for signal {}: {}", signal as i32, e.desc()),
+            )
+            .into());
+        }
+    }
+    Ok(())
+}
