+  private Request withUrl(Request old, String leader) throws MalformedURLException
+  {
+    URL failedUrl = old.getUrl();
+    String query = failedUrl.getQuery();
+    String path = failedUrl.getPath();
+    URL retryUrl;
+    if (query == null) {
+      retryUrl = new URL(StringUtils.format("%s%s", leader, path));
+    } else {
+      retryUrl = new URL(StringUtils.format("%s%s?%s", leader, path, query));
+    }
+    Request req = new Request(old.getMethod(), retryUrl);
+    for (Map.Entry<String, Collection<String>> headerEntry : old.getHeaders().asMap().entrySet()) {
+      req.addHeaderValues(headerEntry.getKey(), headerEntry.getValue());
+    }
+    if (old.hasContent()) {
+      req.setContent(old.getContent());
+    }
+    return req;
+  }
