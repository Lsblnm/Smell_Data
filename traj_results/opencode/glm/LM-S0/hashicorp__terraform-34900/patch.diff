diff --git a/internal/configs/configschema/marks.go b/internal/configs/configschema/marks.go
index 4a33fb1c3c..ad4cfd3178 100644
--- a/internal/configs/configschema/marks.go
+++ b/internal/configs/configschema/marks.go
@@ -74,7 +74,7 @@ func (b *Block) ValueMarks(val cty.Value, path cty.Path) []cty.PathValueMarks {
 		switch blockS.Nesting {
 		case NestingSingle, NestingGroup:
 			pvm = append(pvm, blockS.Block.ValueMarks(blockV, blockPath)...)
-		case NestingList, NestingMap, NestingSet:
+		case NestingList, NestingMap:
 			for it := blockV.ElementIterator(); it.Next(); {
 				idx, blockEV := it.Element()
 				// Create a copy of the path, with this block instance's index
@@ -83,6 +83,17 @@ func (b *Block) ValueMarks(val cty.Value, path cty.Path) []cty.PathValueMarks {
 				morePaths := blockS.Block.ValueMarks(blockEV, blockInstancePath)
 				pvm = append(pvm, morePaths...)
 			}
+		case NestingSet:
+			// The elements of a set are identified by their own value, so we
+			// cannot address an individual element via a stable index key.
+			// If the set contains sensitive values, marking an element also
+			// changes the value which serves as that element's index, making
+			// the recorded path unusable. Since this block contains sensitive
+			// values, we must mark the entire set as sensitive.
+			pvm = append(pvm, cty.PathValueMarks{
+				Path:  blockPath,
+				Marks: cty.NewValueMarks(marks.Sensitive),
+			})
 		default:
 			panic(fmt.Sprintf("unsupported nesting mode %s", blockS.Nesting))
 		}
