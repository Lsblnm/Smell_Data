+	private static boolean isValOrVar(JavacNode node) {
+		JCVariableDecl decl = (JCVariableDecl) node.get();
+		if (decl.vartype == null) return false;
+		String typeTreeToString = decl.vartype.toString();
+		if (!(eq(typeTreeToString, "val") || eq(typeTreeToString, "var"))) return false;
+		return typeMatches(val.class, node, decl.vartype) || typeMatches(var.class, node, decl.vartype);
+	}
+	
+	/**
+	 * val/var declarations nested inside the initializer expression (for example inside a lambda body) are not
+	 * resolved yet when the initializer itself is resolved, which breaks resolution of the outer initializer.
+	 * Resolve them first.
+	 */
+	private void resolveNestedValVarDeclarations(JavacNode node) {
+		for (JavacNode child : node.down()) {
+			if (child.getKind() == Kind.LOCAL && isValOrVar(child)) visitLocal(child, (JCVariableDecl) child.get());
+			resolveNestedValVarDeclarations(child);
+		}
+	}
