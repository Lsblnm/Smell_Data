+	/**
+	 * Handles a type-use @NonNull annotation, e.g. the one in 'byte @NonNull[] bytes', which does not
+	 * show up in the field's modifier annotations. If the annotation ends up on a record field, it doubles
+	 * as an annotation on the compact constructor's parameter, so a null check is injected there, provided
+	 * the annotation applies to the field's entire type (and not to an inner dimension).
+	 */
+	private void handleTypeUseOnFieldIfNeeded(JavacNode annotationNode, JavacNode typeUseNode) {
+		JavacNode n = typeUseNode;
+		while (n != null && n.getKind() == Kind.TYPE_USE) {
+			JavacNode upNode = n.directUp();
+			if (upNode != null && upNode.getKind() == Kind.FIELD) {
+				JCVariableDecl fDecl = (JCVariableDecl) upNode.get();
+				if ((fDecl.mods.flags & RECORD) != 0 && typeUseNode.get() == fDecl.vartype) {
+					JavacNode recordTypeNode = upNode.up();
+					List<JCMethodDecl> compactConstructors = addCompactConstructorIfNeeded(recordTypeNode, annotationNode);
+					for (JCMethodDecl ctr : compactConstructors) {
+						addNullCheckIfNeeded(ctr, upNode, annotationNode);
+					}
+				}
+				return;
+			}
+			n = upNode;
+		}
+	}
+
