+/**
+ * Collects the leading run of declarations and comments from a container.
+ * The run stops at the first rule or at-rule node.
+ */
+function collectLeadingDeclsAndComments(container: Container): ChildNode[] {
+  const nodes: ChildNode[] = []
+  for (const node of container.nodes || []) {
+    if (node.type === 'decl' || node.type === 'comment') {
+      nodes.push(node)
+    } else {
+      break
+    }
+  }
+  return nodes
