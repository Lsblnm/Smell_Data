+/// Hard-wrap `text` into lines of at most `first_width` (for the first line)
+/// and `continuation_width` (for all subsequent lines) display columns.
+fn wrap_title(text: &str, first_width: usize, continuation_width: usize) -> Vec<String> {
+    let mut lines = Vec::new();
+    let mut current = String::new();
+    let mut current_width = 0;
+    let mut cap = first_width.max(1);
+
+    for character in text.chars() {
+        let width = character.width().unwrap_or(0);
+        if current_width + width > cap && !current.is_empty() {
+            lines.push(std::mem::take(&mut current));
+            current_width = 0;
+            cap = continuation_width.max(1);
+        }
+        current_width += width;
+        current.push(character);
+    }
+    lines.push(current);
+
+    lines
+}
