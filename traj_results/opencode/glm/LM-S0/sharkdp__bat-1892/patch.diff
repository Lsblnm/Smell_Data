 ];
 
+/// The suffixes that should be ignored during syntax detection. This is the
+/// list of built-in ignored suffixes plus the custom suffixes provided by the
+/// user (e.g. via `--ignored-suffix`).
+pub fn get_ignored_suffixes(custom: &[String]) -> Vec<String> {
+    IGNORED_SUFFIXES
+        .iter()
+        .map(|suffix| (*suffix).to_string())
+        .chain(custom.iter().cloned())
+        .collect()
+}
+
 /// If we find an ignored suffix on the file name, e.g. '~', we strip it and
-/// then try again without it.
-pub fn try_with_stripped_suffix<T, F>(file_name: &OsStr, func: F) -> Result<Option<T>>
+/// then try again without it. Note that `ignored_suffixes` is expected to
+/// contain all suffixes to strip, including any leading '.'.
+pub fn try_with_stripped_suffix<T, F>(
+    file_name: &OsStr,
+    ignored_suffixes: &[String],
+    func: F,
+) -> Result<Option<T>>
 where
     F: Fn(&OsStr) -> Result<Option<T>>,
 {
     let mut from_stripped = None;
     if let Some(file_str) = Path::new(file_name).to_str() {
-        for suffix in &IGNORED_SUFFIXES {
-            if let Some(stripped_filename) = file_str.strip_suffix(suffix) {
+        for suffix in ignored_suffixes {
+            if let Some(stripped_filename) = file_str.strip_suffix(suffix.as_str()) {
                 from_stripped = func(OsStr::new(stripped_filename))?;
                 break;
             }
