+        def on_new_investigation
+          @contain_dev_null_string_in_file = false
+          return unless (ast = processed_source.ast)
+
+          @contain_dev_null_string_in_file = ast.each_descendant(:str).any? do |str|
+            content = string_content(str)
+            next false if content.empty? || !content.valid_encoding?
+
+            content.downcase == '/dev/null'
+          end
+        end
