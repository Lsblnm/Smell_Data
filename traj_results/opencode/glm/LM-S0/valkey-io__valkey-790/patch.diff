index a507e5bfb..4b26806e1 100644
--- a/src/cluster_legacy.c
+++ b/src/cluster_legacy.c
@@ -5610,8 +5610,23 @@ void addShardReplyForClusterShards(client *c, list *nodes) {
     addReplyMapLen(c, 2);
     addReplyBulkCString(c, "slots");
 
-    /* Use slot_info_pairs from the primary only */
-    n = clusterNodeGetPrimary(n);
+    /* Use slot_info_pairs from the node that owns the slots, as indicated by
+     * the local slots table. Normally this is the primary of the shard, but
+     * when the primary has failed and its replica has taken over, the slots
+     * table points to the new primary while the failed node may still be
+     * listed first in the shard and unaware of its demotion. */
+    listNode *slot_owner_ln = listFirst(nodes);
+    while (slot_owner_ln != NULL) {
+        clusterNode *node = listNodeValue(slot_owner_ln);
+        if (node->slot_info_pairs != NULL) break;
+        slot_owner_ln = listNextNode(slot_owner_ln);
+    }
+    if (slot_owner_ln != NULL) {
+        n = listNodeValue(slot_owner_ln);
+    } else {
+        /* No node in the shard owns any slots */
+        n = clusterNodeGetPrimary(n);
+    }
 
     if (n->slot_info_pairs != NULL) {
         serverAssert((n->slot_info_pairs_count % 2) == 0);
