+    /**
+     * DateTime::diff() only handles years, months, days, hours, minutes
+     * and seconds, so when custom cascade factors are set with a biggest
+     * unit below one of those (e.g. hours as biggest unit with no factor
+     * for days), the values obtained from the diff need to be converted
+     * into the units actually configured.
+     *
+     * @param array $properties
+     *
+     * @return array
+     */
+    private static function convertDiffToCascadeUnits(array $properties): array
+    {
+        $chain = [
+            'years' => [CarbonInterface::MONTHS_PER_YEAR, 'months'],
+            'months' => [CarbonInterface::WEEKS_PER_MONTH, 'weeks'],
+            'weeks' => [CarbonInterface::DAYS_PER_WEEK, 'dayz'],
+            'dayz' => [CarbonInterface::HOURS_PER_DAY, 'hours'],
+            'hours' => [CarbonInterface::MINUTES_PER_HOUR, 'minutes'],
+            'minutes' => [CarbonInterface::SECONDS_PER_MINUTE, 'seconds'],
+            'seconds' => [CarbonInterface::MICROSECONDS_PER_SECOND, 'microseconds'],
+        ];
+
+        $configured = [];
+
+        foreach (static::getCascadeFactors() as $unit => $config) {
+            $configured[static::standardizeUnit($unit)] = true;
+        }
+
+        foreach ($chain as $unit => [$factor, $subUnit]) {
+            if (isset($configured[$unit]) || empty($properties[$unit])) {
+                continue;
+            }
+
+            $properties[$subUnit] = ($properties[$subUnit] ?? 0) + $properties[$unit] * $factor;
+            $properties[$unit] = 0;
+        }
+
+        return $properties;
+    }
