diff --git a/tsdb/head_wal.go b/tsdb/head_wal.go
index 291e2447a..20a9a9897 100644
--- a/tsdb/head_wal.go
+++ b/tsdb/head_wal.go
@@ -1408,6 +1408,32 @@ func (h *Head) loadChunkSnapshot() (int, int, map[chunks.HeadSeriesRef]*memSerie
 
 	dir := maxFileName
 	snapIdx, snapOffset := maxIdx, maxOffset
+
+	if h.wal != nil {
+		// The chunk snapshot records the last WAL segment (and the offset in it) that
+		// was cut into the snapshot. If the snapshot refers to a WAL segment that is
+		// beyond the last segment of the current WAL, the WAL was reset in the meantime
+		// (e.g. it was manually deleted or lost). Such a snapshot cannot be replayed
+		// against the current WAL, hence it is deleted and we replay only from the WAL.
+		_, endAt, e := wlog.Segments(h.wal.Dir())
+		if e != nil {
+			return 0, 0, nil, errors.Wrap(e, "finding WAL segments")
+		}
+		if snapIdx > endAt {
+			level.Warn(h.logger).Log(
+				"msg", "The chunk snapshot is ahead of the WAL",
+				"snapshotIdx", snapIdx,
+				"snapshotOffset", snapOffset,
+				"lastWALSegment", endAt,
+			)
+			level.Info(h.logger).Log("msg", "Deleting the chunk snapshot and replaying from the WAL")
+			if err := DeleteChunkSnapshots(h.opts.ChunkDirRoot, snapIdx, snapOffset+1); err != nil {
+				return 0, 0, nil, errors.Wrap(err, "delete chunk snapshots")
+			}
+			return 0, 0, nil, errors.Errorf("chunk snapshot %s with index %d is ahead of the last WAL segment %d", dir, snapIdx, endAt)
+		}
+	}
+
 	start := time.Now()
 
 	type snapshotSegmentRef struct {
