@@ -1,4 +1,5 @@
 use std::borrow::Cow;
+use std::cmp;
 use std::fmt;
 use std::io;
 use std::path::Path;
@@ -129,6 +130,14 @@ impl<M: Matcher> Replacer<M> {
                 search_at = m.end();
             }
             last_match_end = Some(m.end());
+            // In multi-line mode, it's possible for `subject` to have been
+            // extended past `range.end` in order to support look-ahead. Any
+            // match found that starts at or beyond `range.end` should not be
+            // replaced, since it isn't part of the content reported by the
