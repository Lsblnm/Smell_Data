+            if m.start() >= range.end {
+                break;
+            }
             let unmatched_start = last_copy;
             let unmatched_end = m.start();
             dst.extend(&subject[unmatched_start..unmatched_end]);
@@ -144,7 +153,14 @@ impl<M: Matcher> Replacer<M> {
             matches.push(Match::new(repl_start, repl_end));
         }
         let remaining_start = last_copy;
-        let remaining_end = subject.len();
+        // In multi-line mode, `subject` may have been extended past
+        // `range.end` in order to support look-ahead. We must therefore be
+        // careful not to copy anything past `range.end`, since that content
+        // was not part of the match reported by the searcher. (In single-line
+        // mode, `subject` is truncated to exclude the line terminator, so
+        // `subject.len() <= range.end` and the `cmp::min` is a no-op.)
+        let remaining_end =
+            cmp::min(subject.len(), cmp::max(range.end, last_copy));
         dst.extend(&subject[remaining_start..remaining_end]);
         Ok(())
     }
