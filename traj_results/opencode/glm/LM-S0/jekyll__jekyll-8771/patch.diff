+    # Registers the data files accessed while rendering the current document
+    # as dependencies of the document, so that modifying a data file triggers
+    # the regeneration of only the documents that consume its data.
+    #
+    # Returns nothing.
+    def add_data_dependencies
+      access_log = Thread.current[:jekyll_site_data_access]
+      return if access_log.nil? || access_log.empty?
+
+      index = site.data_file_index
+      return if index.nil? || index.empty?
+
+      document_path = site.in_source_dir(document.path)
+      access_log.uniq.each do |key_path|
+        location = index[key_path]
+        next if location.nil?
+
+        data_files = File.directory?(location) ? data_files_under(location) : [location]
+        data_files.each do |data_file|
+          site.regenerator.add_dependency(document_path, data_file)
+        end
+      end
+    end
+
+    def data_files_under(dir)
+      Dir.glob(File.join(dir, "**", "*.{yaml,yml,json,csv,tsv}")).select { |f| File.file?(f) }
+    end
+
