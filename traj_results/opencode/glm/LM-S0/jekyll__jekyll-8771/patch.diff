diff --git a/lib/jekyll/data_proxy.rb b/lib/jekyll/data_proxy.rb
new file mode 100644
index 000000000..009abda2a
--- /dev/null
+++ b/lib/jekyll/data_proxy.rb
@@ -0,0 +1,41 @@
+# frozen_string_literal: true
+
+module Jekyll
+  # A Hash wrapper that records the key-paths accessed while rendering a
+  # document with Liquid, so that the accessed data files can be registered
+  # as dependencies of the rendered document during incremental regeneration.
+  #
+  # The accessed key-paths are appended to a thread-local array, which
+  # `Renderer#run` initializes before rendering and resolves afterwards.
+  class DataProxy < Hash
+    # source - the Hash containing the data to be wrapped
+    # prefix - the Array of key elements leading up to `source`
+    def initialize(source, prefix = [])
+      @prefix = prefix
+      source.each { |key, value| self[key] = value }
+    end
+
+    def [](key)
+      prefix = @prefix + [key.to_s]
+      record_access(prefix)
+      wrap(super, prefix)
+    end
+
+    def key?(key)
+      record_access(@prefix + [key.to_s])
+      super
+    end
+    alias_method :has_key?, :key?
+
+    private
+
+    def record_access(prefix)
+      access_log = Thread.current[:jekyll_site_data_access]
+      access_log << prefix.join("/") if access_log
+    end
+
+    def wrap(value, prefix)
+      value.is_a?(Hash) ? DataProxy.new(value, prefix) : value
+    end
+  end
+end
