diff --git a/lib/helpers/formDataToStream.js b/lib/helpers/formDataToStream.js
new file mode 100644
index 0000000..796d577
--- /dev/null
+++ b/lib/helpers/formDataToStream.js
@@ -0,0 +1,75 @@
+'use strict';
+
+import stream from 'stream';
+import utils from '../utils.js';
+
+const textEncoder = new TextEncoder();
+
+const escapeQuotes = (value) => String(value).replace(/["\\]/g, '\\$&');
+
+/**
+ * Converts a spec-compliant FormData instance (such as the global FormData
+ * available in Node.js >= 18) into a multipart/form-data Node.js stream.
+ *
+ * @param {FormData} form The spec-compliant FormData instance
+ *
+ * @returns {{stream: stream.Readable, headers: Object}} The multipart stream
+ * and the associated headers (Content-Type & Content-Length)
+ */
+export default function formDataToStream(form) {
+  const boundary = '----axiosformdata' + Math.random().toString(16).slice(2, 18);
+
+  const parts = [];
+  let length = 0;
+
+  const push = (chunk) => {
+    const buf = typeof chunk === 'string' || chunk instanceof Uint8Array ?
+      Buffer.from(chunk) :
+      chunk;
+    parts.push(buf);
+    if (typeof buf.length === 'number') {
+      length += buf.length;
+    }
+  };
+
+  for (const [name, value] of form.entries()) {
+    if (typeof value === 'string') {
+      push(`--${boundary}\r\nContent-Disposition: form-data; name="${escapeQuotes(name)}"\r\n\r\n`);
+      push(textEncoder.encode(value));
+    } else {
+      push(`--${boundary}\r\nContent-Disposition: form-data; name="${escapeQuotes(name)}"; filename="${escapeQuotes(value.name || 'blob')}"\r\nContent-Type: ${value.type || 'application/octet-stream'}\r\n\r\n`);
+      push(value);
+      length += utils.toFiniteNumber(value.size);
+    }
+    push('\r\n');
+  }
+
+  push(`--${boundary}--\r\n`);
+
+  const outStream = new stream.Readable({
+    read: utils.noop
+  });
+
+  (async () => {
+    try {
+      for (const part of parts) {
+        if (Buffer.isBuffer(part)) {
+          outStream.push(part);
+        } else {
+          outStream.push(Buffer.from(await part.arrayBuffer()));
+        }
+      }
+      outStream.push(null);
+    } catch (err) {
+      outStream.destroy(err);
+    }
+  })();
+
+  return {
+    stream: outStream,
+    headers: {
+      'Content-Type': `multipart/form-data; boundary=${boundary}`,
+      'Content-Length': length
+    }
+  };
+}
