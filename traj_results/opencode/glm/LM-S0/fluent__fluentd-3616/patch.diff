diff --git a/lib/fluent/plugin/in_http.rb b/lib/fluent/plugin/in_http.rb
index ba87192b..e112997e 100644
--- a/lib/fluent/plugin/in_http.rb
+++ b/lib/fluent/plugin/in_http.rb
@@ -339,6 +339,31 @@ module Fluent::Plugin
         rescue error_class, EncodingError
           record = nil
         end
+      elsif nd = params['ndjson']
+        parser = @parser_json
+        parser_kind = parser.json_parser
+        error_class = parser.instance_variable_get(:@error_class)
+        load_proc = parser.instance_variable_get(:@load_proc)
+        oj_available = Fluent::OjOptions.available?
+        records = []
+        nd.split(/\r?\n/).each do |line|
+          next if line.empty?
+          begin
+            if parser_kind == :oj && oj_available
+              record = Oj.load(line)
+            elsif parser_kind == :json
+              record = JSON.load(line)
+            elsif load_proc
+              record = load_proc.call(line)
+            else
+              record = Yajl.load(line)
+            end
+          rescue error_class, EncodingError
+            record = nil
+          end
+          records << record unless record.nil?
+        end
+        record = records.size == 1 ? records.first : records
       else
         raise "'json' or 'msgpack' parameter is required"
       end
@@ -618,6 +643,8 @@ module Fluent::Plugin
           params.update WEBrick::HTTPUtils.parse_form_data(@body, boundary)
         elsif @content_type =~ /^application\/json/
           params['json'] = @body
+        elsif @content_type =~ /^application\/x-ndjson/
+          params['ndjson'] = @body
         elsif @content_type =~ /^application\/msgpack/
           params['msgpack'] = @body
         end
