+// trimSingleTrailingNewline removes a single trailing newline
+// (either "\n" on Unix-like systems or "\r\n" on Windows) from
+// the given byte slice, if present.
+func trimSingleTrailingNewline(body []byte) []byte {
+	if len(body) == 0 {
+		return body
+	}
+	if bytes.HasSuffix(body, []byte("\r\n")) {
+		return body[:len(body)-2]
+	}
+	if body[len(body)-1] == '\n' {
+		return body[:len(body)-1]
+	}
+	return body
+}
