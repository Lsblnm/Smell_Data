index b017849..fa7c826 100644
--- a/lib/fpm/package/empty.rb
+++ b/lib/fpm/package/empty.rb
@@ -9,6 +9,11 @@ class FPM::Package::Empty < FPM::Package
   def initialize(*args)
     super(*args)
 
+    # Empty packages have no files, so there is nothing truly
+    # architecture-specific about them. Default to "all" to reflect this.
+    # An explicit --architecture flag will still override this value.
+    self.architecture = "all" if @architecture.nil? || @architecture == "native"
+
     workdir = ::Dir.tmpdir
     if @attributes
       configured_workdir = @attributes[:workdir]
