 - If the nested router has a [fallback](Router::fallback). This is because
   `Router` only allows a single fallback.
 
+# Nesting at the root
+
+You can nest routers at the root path by using `path = "/"` or `path = ""`.
+Both will work the same way:
+
+```rust
+use axum::{routing::get, Router};
+
+let app_routes = Router::new().route("/foo", get(|| async {}));
+
+let app = Router::new()
+    .nest("/", app_routes)
+    .route("/", get(|| async {}));
+# async {
+# axum::Server::bind(&"".parse().unwrap()).serve(app.into_make_service()).await.unwrap();
+# };
+```
+
