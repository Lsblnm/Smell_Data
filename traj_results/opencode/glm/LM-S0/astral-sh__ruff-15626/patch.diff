+/// Returns `true` if the given expression is of a type whose `__eq__` and `__ne__`
+/// methods are known to return a `bool`.
+///
+/// The fixes for SIM201 and SIM202 replace `not a == b` with `a != b` (and vice versa),
+/// which is only equivalent if the operands' comparison methods return `bool`, as
+/// `__eq__` and `__ne__` are allowed to return any type (e.g., NumPy arrays return
+/// element-wise arrays). Since the linter does not perform type inference, this is a
+/// conservative, syntax-based heuristic: expressions that are statically known to
+/// evaluate to `bool` (or to types whose comparison methods always return `bool`)
+/// are considered safe; all other expressions are not.
+fn is_known_bool_expr(checker: &Checker, expr: &Expr) -> bool {
+    match expr {
+        // Literal values always compare with a `bool` result.
+        Expr::NoneLiteral(_)
+        | Expr::BooleanLiteral(_)
+        | Expr::NumberLiteral(_)
+        | Expr::StringLiteral(_)
+        | Expr::BytesLiteral(_)
+        | Expr::FString(_) => true,
+
+        // The built-in container types always compare with a `bool` result, even if
+        // their elements override `__eq__` or `__ne__`.
+        Expr::List(_) | Expr::Tuple(_) | Expr::Dict(_) | Expr::Set(_) => true,
+
+        // `not` always returns a `bool`.
+        Expr::UnaryOp(unary_op) => matches!(unary_op.op, UnaryOp::Not),
+
+        // `is`, `is not`, `in`, and `not in` always return a `bool`.
+        Expr::Compare(compare) => compare
+            .ops
+            .iter()
+            .all(|op| matches!(op, CmpOp::Is | CmpOp::IsNot | CmpOp::In | CmpOp::NotIn)),
+
+        // `and` and `or` return one of their operands, so the result is only known
+        // to be a `bool` if all operands are.
+        Expr::BoolOp(bool_op) => bool_op
+            .values
+            .iter()
+            .all(|value| is_known_bool_expr(checker, value)),
+
+        // A conditional expression evaluates to one of its branches, so the result
+        // is only known to be a `bool` if both branches are.
+        Expr::If(if_exp) => {
+            is_known_bool_expr(checker, &if_exp.body) && is_known_bool_expr(checker, &if_exp.orelse)
+        }
+
+        // A named expression evaluates to its value.
+        Expr::Named(named) => is_known_bool_expr(checker, &named.value),
+
+        // Calls to built-ins that always return a `bool`.
+        Expr::Call(call) => checker
+            .semantic()
+            .resolve_builtin_symbol(&call.func)
+            .is_some_and(|symbol| {
+                matches!(
+                    symbol,
+                    "bool" | "isinstance" | "issubclass" | "hasattr" | "callable" | "any" | "all"
+                )
+            }),
+
+        _ => false,
+    }
+}
+
+/// Returns `true` if the fix for a SIM201 or SIM202 diagnostic is safe, i.e., if the
+/// operands of the comparison are of types whose `__eq__` and `__ne__` methods are
+/// known to return a `bool`.
+fn is_safe_comparison_fix(checker: &Checker, left: &Expr, right: &Expr) -> bool {
+    is_known_bool_expr(checker, left) && is_known_bool_expr(checker, right)
+}
