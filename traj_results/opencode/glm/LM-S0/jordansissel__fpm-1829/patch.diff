diff --git a/lib/fpm/package/deb.rb b/lib/fpm/package/deb.rb
index b6a7737..a68a4b0 100644
--- a/lib/fpm/package/deb.rb
+++ b/lib/fpm/package/deb.rb
@@ -427,6 +427,13 @@ class FPM::Package::Deb < FPM::Package
 
   def output(output_path)
     self.provides = self.provides.collect { |p| fix_provides(p) }
+    self.provides.each do |provides|
+      if !valid_provides?(provides)
+        raise FPM::InvalidPackageConfiguration,
+          "Invalid provides value '#{provides}'. Debian versioned provides " \
+          "only support the exact '=' operator, such as 'name (= version)'"
+      end
+    end
     output_check(output_path)
     # Abort if the target path already exists.
 
@@ -894,6 +901,27 @@ class FPM::Package::Deb < FPM::Package
     return provides.rstrip
   end
 
+  # Validate a provides entry according to Debian policy:
+  #   "Provides: package-name [= version]"
+  # A versioned relational clause is only allowed with the '=' operator,
+  # and the version must be a valid Debian version string.
+  # Ref: https://www.debian.org/doc/debian-policy/ch-relationships.html
+  def valid_provides?(provides)
+    m = /^([A-Za-z0-9][A-Za-z0-9+.-]*)\s*(?:\(\s*(<<|<=|=|>=|>>)\s*([^\s()]+)\s*\))?$/.match(provides)
+    return false if m.nil?
+
+    # Versioned provides only allow the '=' operator
+    return false if !m[2].nil? && m[2] != "="
+
+    # If a version is given, it must be a valid Debian version string
+    version = m[3]
+    if !version.nil?
+      return false unless version =~ /^(?:[0-9]+:)?[0-9][A-Za-z0-9.+:~-]*(?:-[A-Za-z0-9.~+]+)?$/
+    end
+
+    return true
+  end # def valid_provides?
+
   def control_path(path=nil)
     @control_path ||= build_path("control")
     FileUtils.mkdir(@control_path) if !File.directory?(@control_path)
