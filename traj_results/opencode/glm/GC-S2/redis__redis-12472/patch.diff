diff --git a/src/acl.c b/src/acl.c
index 37986e092..7d5108a36 100644
--- a/src/acl.c
+++ b/src/acl.c
@@ -637,6 +637,12 @@ void ACLSelectorRemoveCommandRule(aclSelector *selector, sds new_rule) {
                 /* Copy the remaining rules starting at the next rule to replace the rule to be
                  * deleted, including the terminating NULL character. */
                 memmove(copy_position, copy_end, strlen(copy_end) + 1);
+                /* The remaining rules have been shifted back to copy_position,
+                 * so continue scanning from there. Continuing from copy_end
+                 * would skip rules that were just moved (or scan stale bytes),
+                 * leaving rules that should have been engulfed. */
+                existing_rule = copy_position;
+                continue;
             }
         }
         existing_rule = copy_end;
