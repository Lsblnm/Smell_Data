diff --git a/src/assets/ignored_suffixes.rs b/src/assets/ignored_suffixes.rs
index b4c2e32d..3570315f 100644
--- a/src/assets/ignored_suffixes.rs
+++ b/src/assets/ignored_suffixes.rs
@@ -1,4 +1,5 @@
 use std::ffi::OsStr;
+use std::path::Path;
 
 use crate::error::*;
 
@@ -22,12 +23,42 @@ const IGNORED_SUFFIXES: [&str; 13] = [
     ".in",
 ];
 
-/// If we find an ignored suffix on the file name, e.g. '~', we strip it and
-/// then try again without it.
-pub fn try_with_stripped_suffix<T, F>(file_name: &OsStr, func: F) -> Result<Option<T>>
-where
-    F: Fn(&OsStr) -> Result<Option<T>>,
-{
-    let _known = IGNORED_SUFFIXES.len();
-    super::HighlightingAssets::strip_ignored_filename_suffix(file_name, func)
+/// A list of filename suffixes that are ignored when detecting the syntax
+/// of a file. It contains the well known backup/template suffixes, and can
+/// be extended by the user (e.g. via `--ignored-suffix`).
+#[derive(Debug, Clone)]
+pub struct IgnoredSuffixes<'a> {
+    values: Vec<&'a str>,
+}
+
+impl<'a> IgnoredSuffixes<'a> {
+    /// If we find an ignored suffix on the file name, e.g. '~', we strip it
+    /// and then try again without it.
+    pub fn try_with_stripped_suffix<T, F>(&self, file_name: &OsStr, func: F) -> Result<Option<T>>
+    where
+        F: Fn(&OsStr) -> Result<Option<T>>,
+    {
+        let mut from_stripped = None;
+        if let Some(file_str) = Path::new(file_name).to_str() {
+            for suffix in self.values.iter() {
+                if let Some(stripped_filename) = file_str.strip_suffix(suffix) {
+                    from_stripped = func(OsStr::new(stripped_filename))?;
+                    break;
+                }
+            }
+        }
+        Ok(from_stripped)
+    }
+
+    pub fn add_suffix(&mut self, suffix: &'a str) {
+        self.values.push(suffix);
+    }
+}
+
+impl<'a> Default for IgnoredSuffixes<'a> {
+    fn default() -> Self {
+        IgnoredSuffixes {
+            values: IGNORED_SUFFIXES.to_vec(),
+        }
+    }
 }
