+#[cfg(unix)]
+fn parse_ignore_signal(spec: &str) -> Option<i32> {
+    use std::str::FromStr;
+
+    if let Ok(value) = spec.parse::<i32>() {
+        return Signal::try_from(value).ok().map(|sig| sig as i32);
+    }
+    let upper = spec.to_ascii_uppercase();
+    let name = upper.strip_prefix("SIG").unwrap_or(&upper);
+    Signal::from_str(&format!("SIG{}", name))
+        .ok()
+        .map(|sig| sig as i32)
+}
+
+#[cfg(unix)]
+fn make_ignore_signals(matches: &clap::ArgMatches) -> UResult<Vec<i32>> {
+    let mut signals: Vec<i32> = Vec::new();
+    let provided = matches.value_source("ignore-signal")
+        == Some(clap::parser::ValueSource::CommandLine);
+    match matches.get_many::<OsString>("ignore-signal") {
+        Some(values) => {
+            for value in values {
+                for spec in value.to_string_lossy().split(',') {
+                    if spec.is_empty() {
+                        continue;
+                    }
+                    match parse_ignore_signal(spec) {
+                        Some(sig) => {
+                            if !signals.contains(&sig) {
+                                signals.push(sig);
+                            }
+                        }
+                        None => {
+                            return Err(USimpleError::new(
+                                125,
+                                format!("'{}': invalid signal", spec),
+                            ));
+                        }
+                    }
+                }
+            }
+        }
+        None if provided => {
+            // `--ignore-signal` given without a value: ignore all signals
+            // that can actually be ignored.
+            for i in 1..=31 {
+                if let Ok(sig) = Signal::try_from(i) {
+                    if sig == Signal::SIGKILL || sig == Signal::SIGSTOP {
+                        continue;
+                    }
+                    signals.push(i);
+                }
+            }
+        }
+        None => (),
+    }
+    Ok(signals)
+}
+
+#[cfg(unix)]
+fn apply_ignored_signals(opts: &Options<'_>) -> UResult<()> {
+    for &sig in &opts.ignore_signals {
+        let signal = Signal::try_from(sig).map_err(|_| {
+            USimpleError::new(125, format!("'{}': invalid signal", sig))
+        })?;
+        let action = SigAction::new(SigHandler::SigIgn, SaFlags::empty(), SigSet::all());
+        // Ignored signal dispositions are inherited across exec, so setting
+        // SIG_IGN here makes the child process ignore the signal as well.
+        // SAFETY: installing a signal handler is unsafe, but SigIgn just
+        // ignores the signal without invoking any function.
+        unsafe { sigaction(signal, &action) }.map_err(|e| {
+            USimpleError::new(
+                125,
+                format!(
+                    "failed to set signal action for signal {}: {}",
+                    signal as i32,
+                    e.desc()
+                ),
+            )
+        })?;
+    }
+    Ok(())
+}
