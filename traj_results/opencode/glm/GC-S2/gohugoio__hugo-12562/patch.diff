 func (m *pageMap) reverseIndexBaseName(p *pageState) (string, bool) {
+	if p.m.pageConfig.IsFromContentAdapter {
+		// Pages created by content adapters are not backed by a content file,
+		// use the canonical page path to derive the base name.
+		pi := p.m.PathInfo()
+		if pi == nil {
+			return "", false
+		}
+		name := pi.Unnormalized().BaseNameNoIdentifier()
+		return m.finalizeIndexedBaseName(name), true
+	}
 	if p.File() == nil {
 		return "", false
 	}
