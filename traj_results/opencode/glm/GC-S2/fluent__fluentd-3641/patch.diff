diff --git a/lib/fluent/rpc.rb b/lib/fluent/rpc.rb
index d050aecb..68c5c1f5 100644
--- a/lib/fluent/rpc.rb
+++ b/lib/fluent/rpc.rb
@@ -23,21 +23,54 @@ require 'fluent/config/error'
 module Fluent
   module RPC
     class Server
+      ENDPOINT_REGEXP_IPV6 = /\A\[(.+)\]:(\d+)\z/
+      ENDPOINT_REGEXP_HOST = /\A([^:\]]+):(\d+)\z/
+
       def initialize(endpoint, log)
-        bind, port = endpoint.split(':')
+        bind, port = parse_endpoint(endpoint)
         @bind = bind
         @port = port
         @log = log
 
         @server = WEBrick::HTTPServer.new(
-          BindAddress: @bind,
-          Port: @port,
+          BindAddress: bind_address_for_webrick(bind),
+          Port: port,
           Logger: WEBrick::Log.new(STDERR, WEBrick::Log::FATAL),
           AccessLog: [],
         )
         assemble_control_plane(endpoint, log)
       end
 
+      # Extracts bind address and port from an endpoint string like
+      # `127.0.0.1:24444`, `localhost:24444` or `[::]:24444` (IPv6 literal).
+      # Raises Fluent::ConfigError for invalid endpoints.
+      def parse_endpoint(endpoint)
+        m = endpoint.match(ENDPOINT_REGEXP_IPV6) || endpoint.match(ENDPOINT_REGEXP_HOST)
+        raise Fluent::ConfigError, "Invalid rpc_endpoint: #{endpoint}" unless m
+
+        bind, port = m[1], m[2]
+        raise Fluent::ConfigError, "Invalid rpc_endpoint: #{endpoint}" unless valid_bind_address?(bind)
+
+        [bind, Integer(port)]
+      end
+
+      def valid_bind_address?(bind)
+        return true if Server.ip_literal?(bind)
+
+        begin
+          Addrinfo.getaddrinfo(bind, nil)
+          true
+        rescue SocketError
+          false
+        end
+      end
+
+      # WEBrick can't resolve IPv6 literals wrapped by brackets, e.g. `[::]`.
+      # Strip the brackets before passing it to WEBrick.
+      def bind_address_for_webrick(bind)
+        bind.include?(':') ? bind.delete('[]') : bind
+      end
+
       def mount(path, servlet, *args)
         @server.mount(path, servlet, *args)
         remember_servlet_mount(path, servlet)
