diff --git a/lib/fpm/package/deb.rb b/lib/fpm/package/deb.rb
index 8ce1e13..01a86d2 100644
--- a/lib/fpm/package/deb.rb
+++ b/lib/fpm/package/deb.rb
@@ -427,6 +427,7 @@ class FPM::Package::Deb < FPM::Package
 
   def output(output_path)
     self.provides = self.provides.collect { |p| fix_provides(p) }
+    validate_provides(self.provides)
     output_check(output_path)
     # Abort if the target path already exists.
 
@@ -796,6 +797,27 @@ class FPM::Package::Deb < FPM::Package
     return provides.rstrip
   end
 
+  # Debian policy only allows a package name, optionally followed by an exact
+  # version relationship '(= version)' in Provides.
+  # Ref: https://www.debian.org/doc/debian-policy/ch-relationships.html#id9
+  def valid_provides?(provides)
+    name = "[a-zA-Z0-9][a-zA-Z0-9+.-]*"
+    version = "[0-9A-Za-z.+~:-]+"
+    return true if provides =~ /^#{name}$/
+    return true if provides =~ /^#{name}\s*\(\s*=\s*#{version}\s*\)$/
+    return false
+  end # def valid_provides?
+
+  def validate_provides(provides)
+    provides.each do |provide|
+      next if valid_provides?(provide)
+      raise FPM::InvalidPackageConfiguration,
+        "Invalid provides value '#{provide}' in debian package " \
+        "'#{self.name}': Debian Provides must be a package name or " \
+        "'name (= version)' (only '=' is allowed for versioned provides)"
+    end
+  end # def validate_provides
+
   def control_path(path=nil)
     @control_path ||= build_path("control")
     FileUtils.mkdir(@control_path) if !File.directory?(@control_path)
