+/// The maximum number of times to follow a name binding when inferring the type
+/// of an operand.
+const MAX_BINDING_DEPTH: u32 = 5;
+
+/// Returns `true` if the fix for SIM201 or SIM202 can be applied safely, i.e.,
+/// if both operands of the comparison are of types whose `__eq__` and `__ne__`
+/// methods are known to return `bool`.
+fn has_bool_returning_comparison_operands(
+    left: &Expr,
+    right: &Expr,
+    semantic: &SemanticModel,
+) -> bool {
+    is_bool_returning_operand(left, semantic, 0) && is_bool_returning_operand(right, semantic, 0)
+}
+
+/// Returns `true` if `expr` is of a type whose `__eq__` and `__ne__` methods are
+/// known to return `bool`.
+fn is_bool_returning_operand(expr: &Expr, semantic: &SemanticModel, depth: u32) -> bool {
+    match ResolvedPythonType::from(expr) {
+        // Comparisons between any statically-known builtin types return `bool`,
+        // either because the type's `__eq__` and `__ne__` methods return `bool`
+        // or because the comparison falls back to identity.
+        ResolvedPythonType::Atom(_)
+        | ResolvedPythonType::Union(_)
+        | ResolvedPythonType::TypeError => true,
+        ResolvedPythonType::Unknown => match expr {
+            Expr::Call(call) => semantic
+                .resolve_builtin_symbol(&call.func)
+                .is_some_and(|symbol| {
+                    // Builtins that always return a value of a known builtin
+                    // type, all of which return `bool` from `__eq__` and
+                    // `__ne__`. Note that e.g. `abs` or `round` are excluded,
+                    // as they may return arbitrary values for user-defined
+                    // types.
+                    matches!(
+                        symbol,
+                        "bool"
+                            | "int"
+                            | "float"
+                            | "complex"
+                            | "str"
+                            | "bytes"
+                            | "bytearray"
+                            | "list"
+                            | "tuple"
+                            | "dict"
+                            | "set"
+                            | "frozenset"
+                            | "range"
+                            | "len"
+                            | "ord"
+                            | "hash"
+                            | "id"
+                            | "bin"
+                            | "hex"
+                            | "oct"
+                            | "repr"
+                            | "ascii"
+                    )
+                }),
+            Expr::Name(name) => {
+                // Follow the variable's assigned value, if it can be resolved.
+                depth < MAX_BINDING_DEPTH
+                    && analyze::typing::find_assigned_value(name.id.as_str(), semantic)
+                        .is_some_and(|value| is_bool_returning_operand(value, semantic, depth + 1))
+            }
+            _ => false,
+        },
+    }
+}
