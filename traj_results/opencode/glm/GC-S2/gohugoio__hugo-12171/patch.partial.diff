index 000000000..8d60f2bdb
--- /dev/null
+++ b/hugolib/zz_repro_12171_test.go
@@ -0,0 +1,36 @@
+package hugolib
+
+import "testing"
+
+func TestZZRepro12171(t *testing.T) {
+	t.Parallel()
+
+	files := `
+-- config.toml --
+disableKinds = ['rss','sitemap','taxonomy','term']
+-- layouts/_default/list.html --
+__|{{ range .Pages }}{{ .Title }}|{{ end }}__
+-- layouts/_default/single.html --
+{{ .Title }}|
+-- content/s1/_index.md --
+---
+title: s1
+---
+-- content/s1/p1.md --
+---
+title: p1
+---
+-- content/s1-foo/_index.md --
+---
+title: s1-foo
+---
+-- content/s1/p2.md --
+---
+title: p2
+---
+  `
+
+	b := Test(t, files)
+
+	b.AssertFileContent("public/index.html", "__|s1|s1-foo|__")
+}
