+func parseOptDefaultBind(d *caddyfile.Dispenser, _ interface{}) (interface{}, error) {
+	var defaultBind []string
+	for d.Next() {
+		defaultBind = append(defaultBind, d.RemainingArgs()...)
+	}
+	if len(defaultBind) == 0 {
+		return nil, d.ArgErr()
+	}
+	return defaultBind, nil
