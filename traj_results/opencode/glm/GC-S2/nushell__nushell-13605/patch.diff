+/// Convert a symlink target to a string, optionally resolving it to an absolute path
+/// relative to the directory containing the symlink.
+fn symlink_target_to_string(
+    filename: &std::path::Path,
+    path_to_link: std::path::PathBuf,
+    full_paths: bool,
+) -> String {
+    if full_paths && path_to_link.is_relative() {
+        match filename.parent() {
+            Some(parent) => parent.join(path_to_link).to_string_lossy().into_owned(),
+            None => path_to_link.to_string_lossy().into_owned(),
+        }
+    } else {
+        path_to_link.to_string_lossy().into_owned()
+    }
+}
 
