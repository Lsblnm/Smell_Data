+	/**
+	 * Returns true if the given annotation is applied directly to the declared type of the given variable declaration,
+	 * i.e. the declared type is an annotated type that contains the annotation in its list of annotations. Returns false
+	 * if the annotation is only applied to a nested part of the type, such as the element type of an array
+	 * (e.g. for `int @NonNull[] x`, the annotation applies to the field's type itself, whereas for `int[] @NonNull[] x`,
+	 * it applies to the elements).
+	 */
+	private static boolean isDirectlyOnFieldType(JCVariableDecl decl, JCAnnotation ast) {
+		JCExpression vartype = decl.vartype;
+		if (vartype == null || !vartype.getClass().getName().equals("com.sun.tools.javac.tree.JCTree$JCAnnotatedType")) return false;
+		
+		Collection<?> anns = Permit.permissiveReadField(Collection.class, Permit.permissiveGetField(vartype.getClass(), "annotations"), vartype);
+		if (anns == null) return false;
+		for (Object ann : anns) if (ann == ast) return true;
+		return false;
+	}
