diff --git a/src/diff/index.js b/src/diff/index.js
index d8513b16..48cee378 100644
--- a/src/diff/index.js
+++ b/src/diff/index.js
@@ -279,6 +279,16 @@ export function diff(
 				excessDomChildren[excessDomChildren.indexOf(oldDom)] = null;
 				// ^ could possibly be simplified to:
 				// excessDomChildren.length = 0;
+			} else if (oldVNode !== EMPTY_OBJ) {
+				// The component errored mid-diff and the error was (or will be)
+				// handed to an error boundary, which re-renders afterwards. The
+				// previously rendered subtree was already claimed by this vnode
+				// during reconciliation, so without a DOM pointer it would be
+				// orphaned and left in the document next to whatever the error
+				// boundary renders (see #4182). Inherit the old DOM pointer and
+				// children so the stale DOM is reused or removed on that re-render.
+				newVNode._dom = oldVNode._dom;
+				newVNode._children = oldVNode._children;
 			}
 			options._catchError(e, newVNode, oldVNode);
 		}
