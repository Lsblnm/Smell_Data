+// validateImportTargets validates any import blocks targeting this resource.
+// The import expressions are evaluated here to ensure that the referenced
+// values are all valid and defined within the configuration.
+func (n *NodeValidatableResource) validateImportTargets(ctx EvalContext) tfdiags.Diagnostics {
+	var diags tfdiags.Diagnostics
+
+	for _, imp := range n.importTargets {
+		// a legacy import target from the import CLI command will have no
+		// configuration to validate
+		if imp.Config == nil {
+			continue
+		}
+
+		if imp.Config.ForEach != nil {
+			forEachData, _, forEachDiags := newForEachEvaluator(imp.Config.ForEach, ctx, true).ImportValues()
+			diags = diags.Append(forEachDiags)
+			if forEachDiags.HasErrors() {
+				continue
+			}
+
+			for _, keyData := range forEachData {
+				res, evalDiags := evalImportToExpression(imp.Config.To, keyData)
+				diags = diags.Append(evalDiags)
+				if evalDiags.HasErrors() {
+					continue
+				}
+
+				_, idDiags := evaluateImportIdExpression(imp.Config.ID, res, ctx, keyData, true)
+				diags = diags.Append(idDiags)
+			}
+			continue
+		}
+
+		traversal, hds := hcl.AbsTraversalForExpr(imp.Config.To)
+		diags = diags.Append(hds)
+		to, tds := addrs.ParseAbsResourceInstance(traversal)
+		diags = diags.Append(tds)
+		if diags.HasErrors() {
+			continue
+		}
+
+		// The import ID may not be known until apply time, so we allow unknown
+		// values here and only report errors from the evaluation itself.
+		_, idDiags := evaluateImportIdExpression(imp.Config.ID, to, ctx, EvalDataForNoInstanceKey, true)
+		diags = diags.Append(idDiags)
+	}
+
+	return diags
+}
