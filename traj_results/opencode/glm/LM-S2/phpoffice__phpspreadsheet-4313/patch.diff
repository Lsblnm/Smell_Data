+    private static function convertToExcelRange(array $matches): string
+    {
+        $sheet1 = $matches['sheet1'] ?? '';
+        $cell1 = $matches['cell1'] ?? '';
+        $cell2same = $matches['cell2same'] ?? '';
+        $sheet2 = $matches['sheet2'] ?? '';
+        $cell2 = $matches['cell2'] ?? '';
+
+        if ($cell2same !== '' || $cell2 !== '') {
+            $cell2Text = $cell2same !== '' ? $cell2same : $cell2;
+            if ($sheet1 === '') {
+                if ($sheet2 === '') {
+                    return $cell1 . ':' . $cell2Text;
+                }
+
+                return $sheet2 . '!' . $cell1 . ':' . $cell2Text;
+            }
+
+            return $sheet1 . '!' . $cell1 . ':' . $cell2Text;
+        }
+
+        if ($sheet1 !== '') {
+            return $sheet1 . '!' . $cell1;
+        }
+
+        return $cell1;
+    }
