+    /// Wrap a header title so it fits into the terminal. The first line shares
+    /// its space with `prefix` (e.g. "File: "), continuation lines use the full
+    /// `budget`. Returns a single-line vector if wrapping is disabled or the
+    /// title already fits.
+    fn wrap_header_title(
+        title: &str,
+        prefix: &str,
+        mode: &str,
+        budget: usize,
+        wrapping_mode: WrappingMode,
+    ) -> Vec<String> {
+        let mode_width = UnicodeWidthStr::width(mode);
+        let first_width = budget
+            .saturating_sub(UnicodeWidthStr::width(prefix))
+            .saturating_sub(mode_width);
+        let rest_width = budget.saturating_sub(mode_width);
+
+        if matches!(wrapping_mode, WrappingMode::NoWrapping(_))
+            || first_width == 0
+            || UnicodeWidthStr::width(title) <= first_width
+        {
+            return vec![title.to_string()];
+        }
+
+        let mut lines: Vec<String> = Vec::new();
+        let mut line = String::new();
+        let mut line_width = 0usize;
+        let mut max_width = first_width;
+
+        for ch in title.chars() {
+            let char_width = UnicodeWidthChar::width(ch).unwrap_or(0);
+            if line_width > 0 && line_width + char_width > max_width {
+                lines.push(std::mem::take(&mut line));
+                line_width = 0;
+                max_width = rest_width;
+            }
+            line.push(ch);
+            line_width += char_width;
+        }
+        if !line.is_empty() {
+            lines.push(line);
+        }
+
+        lines
+    }
 }
 
