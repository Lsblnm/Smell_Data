diff --git a/src/uu/mkdir/src/mkdir.rs b/src/uu/mkdir/src/mkdir.rs
index 9a29ad538..2c0a7790d 100644
--- a/src/uu/mkdir/src/mkdir.rs
+++ b/src/uu/mkdir/src/mkdir.rs
@@ -168,8 +168,20 @@ pub fn mkdir(path: &Path, recursive: bool, mode: u32, verbose: bool) -> UResult<
     let path_buf = dir_strip_dot_for_creation(path);
     let path = path_buf.as_path();
 
+    // If the directory already exists, we must not try to change its
+    // permissions: GNU mkdir only applies the mode to directories it
+    // actually created. Trying to chmod an existing directory that the
+    // current user cannot access (e.g. `mkdir -p /root` as a non-root
+    // user) would fail with "Permission denied".
+    let already_exists = path.exists();
+
     create_dir(path, recursive, verbose, false)?;
-    chmod(path, mode)
+
+    if !already_exists {
+        chmod(path, mode)?;
+    }
+
+    Ok(())
 }
 
 #[cfg(any(unix, target_os = "redox"))]
