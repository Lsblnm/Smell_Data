diff --git a/src/decNumber/decNumber.c b/src/decNumber/decNumber.c
index 5062634..78f1e4c 100644
--- a/src/decNumber/decNumber.c
+++ b/src/decNumber/decNumber.c
@@ -6206,9 +6206,19 @@ static Int decCompare(const decNumber *lhs, const decNumber *rhs,
     rhs=temp;
     result=-result;
     }
-  compare=decUnitCompare(lhs->lsu, D2U(lhs->digits),
-                         rhs->lsu, D2U(rhs->digits),
-                         rhs->exponent-lhs->exponent);
+  // The exponents can be so far apart that their difference cannot be
+  // represented in an Int.  If the difference is >= the number of
+  // digits of the coefficient of the number with the smaller
+  // exponent, the coefficients cannot possibly make up for the
+  // difference (B*10**E >= 10**E > A), so the result is known.
+  if ((Long)rhs->exponent-lhs->exponent>=(Long)lhs->digits) {
+    compare=-1;                              // A < B*10**E
+    }
+   else {                                    // difference is small enough
+    compare=decUnitCompare(lhs->lsu, D2U(lhs->digits),
+                           rhs->lsu, D2U(rhs->digits),
+                           rhs->exponent-lhs->exponent);
+    }
   if (compare!=BADINT) compare*=result;      // comparison succeeded
   return compare;
   } // decCompare
