diff --git a/src/diff/index.js b/src/diff/index.js
index d3ab7df1..6af567f9 100644
--- a/src/diff/index.js
+++ b/src/diff/index.js
@@ -533,6 +533,20 @@ export function diff(
 				excessDomChildren[excessDomChildren.indexOf(oldDom)] = null;
 				// ^ could possibly be simplified to:
 				// excessDomChildren.length = 0;
+			} else if (errorInfo) {
+				// A boundary was found that will re-render this subtree. Keep the
+				// previous DOM & children pointers around so that the re-render
+				// diffs against the old DOM instead of appending duplicates
+				// (similar to how the Suspense bailout preserves DOM).
+				newVNode._dom = oldVNode._dom;
+				newVNode._children = oldVNode._children;
+				if (newVNode._children) {
+					for (let i = 0; i < newVNode._children.length; i++) {
+						if (newVNode._children[i]) {
+							newVNode._children[i]._parent = newVNode;
+						}
+					}
+				}
 			}
 			options._catchError(e, newVNode, oldVNode, errorInfo);
 		}
