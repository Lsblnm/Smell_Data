+// parseOptDefaultBind parses the default_bind global option. Syntax:
+//
+//	default_bind <addresses...>
+//
+func parseOptDefaultBind(d *caddyfile.Dispenser, existing interface{}) (interface{}, error) {
+	defaultBindAddresses, _ := existing.([]string)
+	d.Next() // consume parameter name
+	for d.NextArg() {
+		defaultBindAddresses = append(defaultBindAddresses, d.Val())
+	}
+	return defaultBindAddresses, nil
+}
