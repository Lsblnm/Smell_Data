+    #
+    # paths - an Array of paths of the data files that have been read.
+    #
+    # Returns nothing.
+    def track_data_files(paths)
+      @data_files = paths.uniq
+      return if disabled?
+
+      @data_files_changed = false
+      @data_files.each do |path|
+        @data_files_changed = true if data_file_modified_since_last_build?(path)
+      end
+
+      # Data files that were present in the previous build but are gone now
+      (@data_file_mtines.keys - @data_files).each do |deleted_path|
+        @data_file_mtines.delete(deleted_path)
+        @data_files_changed = true
+      end
+      nil
+    end
+
+    # Whether any of the site data files has been modified since the previous
+    # build.
+    #
