+/// Resolve a signal specification (e.g. "int", "SIGINT", "usr2", "9") into a
+/// [`Signal`]. The "SIG" prefix is optional and matching is done
+/// case-insensitively, like GNU env does. Signal 0 ("EXIT") is not a valid
+/// signal to act upon and is rejected.
+#[cfg(unix)]
+fn signal_from_spec(spec: &str) -> Option<Signal> {
+    let name = if spec.len() >= 3 && spec.as_bytes()[..3].eq_ignore_ascii_case(b"SIG") {
+        &spec[3..]
+    } else {
+        spec
+    };
+
+    if let Some((index, _)) = uucore::signals::ALL_SIGNALS
+        .iter()
+        .enumerate()
+        .find(|(_, signal)| signal.eq_ignore_ascii_case(name))
+    {
+        // index 0 is "EXIT", which is not a signal that can be acted upon
+        return if index == 0 {
+            None
+        } else {
+            Signal::try_from(index as i32).ok()
+        };
+    }
+
+    name.parse::<u8>()
+        .ok()
+        .filter(|&n| n > 0)
+        .and_then(|n| Signal::try_from(n as i32).ok())
+}
+
+/// Set the handling of the given signals to "do nothing" (SIG_IGN).
+/// Dispositions set to SIG_IGN are inherited by the executed command.
+#[cfg(unix)]
+fn apply_ignore_signals(opts: &Options<'_>) -> UResult<()> {
+    for sig in &opts.ignore_signals {
+        let spec = sig.to_string_lossy();
+        if spec.eq_ignore_ascii_case("all") {
+            // ignore all signals, except those that cannot be caught or ignored
+            for (index, name) in uucore::signals::ALL_SIGNALS.iter().enumerate() {
+                if index == 0 || *name == "KILL" || *name == "STOP" {
+                    continue;
+                }
+                ignore_signal(Signal::try_from(index as i32).unwrap())?;
+            }
+        } else {
+            for token in spec.split(',') {
+                if token.is_empty() {
+                    continue;
+                }
+                match signal_from_spec(token) {
+                    Some(signal) => ignore_signal(signal)?,
+                    None => {
+                        return Err(USimpleError::new(
+                            125,
+                            format!("'{token}': invalid signal"),
+                        ))
+                    }
+                }
+            }
+        }
+    }
+
+    Ok(())
+}
+
+#[cfg(unix)]
+fn ignore_signal(signal: Signal) -> UResult<()> {
+    let action = SigAction::new(SigHandler::SigIgn, SaFlags::empty(), SigSet::all());
+    unsafe { sigaction(signal, &action) }
+        .map(|_| ())
+        .map_err(|e| {
+            USimpleError::new(
+                125,
+                format!(
+                    "failed to set signal action for signal {}: {}",
+                    signal as i32,
+                    e.desc()
+                ),
+            )
+        })
 }
 
