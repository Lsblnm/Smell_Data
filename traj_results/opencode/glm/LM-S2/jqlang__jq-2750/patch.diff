diff --git a/src/execute.c b/src/execute.c
index 34bb63d..7f6e02f 100644
--- a/src/execute.c
+++ b/src/execute.c
@@ -816,22 +816,75 @@ jv jq_next(jq_state *jq) {
       break;
     }
 
-    case ON_BACKTRACK(FORK_OPT):
+    case TRY_END: {
+      // Marks the end of a `try EXP ...`'s EXP.  We stack_save() so that if
+      // an error is raised after the try (downstream of it, or in its
+      // handler) backtracks through here we can wrap it so that the
+      // matching FORK_OPT will not catch it.
+      stack_save(jq, pc - 1, stack_get_pos(jq));
+      break;
+    }
+
+    case ON_BACKTRACK(TRY_END): {
+      if (jv_is_valid(jq->error)) {
+        // Normal backtracking (e.g., `empty` downstream of the try), so we
+        // backtrack more.
+        goto do_backtrack;
+      }
+      // An error was raised after this try's EXP completed.  Wrap it so
+      // that the matching FORK_OPT will not catch it; the FORK_OPT will
+      // unwrap it and keep backtracking.
+      jv msg = jv_null();
+      if (jv_invalid_has_msg(jv_copy(jq->error)))
+        msg = jv_invalid_get_msg(jv_copy(jq->error));
+      set_error(jq, jv_invalid_with_msg(
+                        JV_OBJECT(jv_string("__jq_try_end"), msg)));
+      goto do_backtrack;
+    }
+
     case ON_BACKTRACK(DESTRUCTURE_ALT): {
       if (jv_is_valid(jq->error)) {
         // `try EXP ...` backtracked here (no value, `empty`), so we backtrack more
         jv_free(stack_pop(jq));
         goto do_backtrack;
       }
-      // `try EXP ...` exception caught in EXP
       // DESTRUCTURE_ALT doesn't want the error message on the stack,
       // as we would just want to throw it away anyway.
-      if (opcode != ON_BACKTRACK(DESTRUCTURE_ALT)) {
-        jv_free(stack_pop(jq)); // free the input
-        stack_push(jq, jv_invalid_get_msg(jq->error));  // push the error's message
+      jv_free(jq->error);
+      jq->error = jv_null();
+      uint16_t offset = *pc++;
+      pc += offset;
+      break;
+    }
+
+    case ON_BACKTRACK(FORK_OPT): {
+      if (jv_is_valid(jq->error)) {
+        // `try EXP ...` backtracked here (no value, `empty`), so we backtrack more
+        jv_free(stack_pop(jq));
+        goto do_backtrack;
+      }
+      // An exception was raised in EXP.  If it was wrapped by our TRY_END
+      // then it was raised after EXP completed (downstream of the try, or
+      // in its handler), so it is not ours to catch: unwrap it and keep
+      // backtracking.
+      jv msg = jv_null();
+      if (jv_invalid_has_msg(jv_copy(jq->error)))
+        msg = jv_invalid_get_msg(jv_copy(jq->error));
+      if (jv_get_kind(msg) == JV_KIND_OBJECT) {
+        jv wrapped = jv_object_get(msg, jv_string("__jq_try_end"));
+        if (jv_get_kind(wrapped) == JV_KIND_INVALID) {
+          // Not wrapped; it's our error, so catch it (see below).
+          jv_free(wrapped);
+        } else {
+          set_error(jq, jv_invalid_with_msg(wrapped));
+          goto do_backtrack;
+        }
       } else {
-        jv_free(jq->error);
+        jv_free(msg);
       }
+      // `try EXP ...` exception caught in EXP
+      jv_free(stack_pop(jq)); // free the input
+      stack_push(jq, jv_invalid_get_msg(jq->error));  // push the error's message
       jq->error = jv_null();
       uint16_t offset = *pc++;
       pc += offset;
