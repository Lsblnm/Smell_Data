+/**
+ * Returns the length of the line break starting at the given index.
+ * Handles LF (`\n`), CRLF (`\r\n`) and lone CR (`\r`) line endings.
+ */
+function getLineBreakLength(content: string, index: number): number {
+  const char = content.charAt(index);
+  if (char === '\n') {
+    return 1;
+  }
+  if (char === '\r') {
+    return content.charAt(index + 1) === '\n' ? 2 : 1;
+  }
+  return 0;
+}
