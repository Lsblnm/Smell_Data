             Jekyll.logger.warn ""
           end
           conflicting_urls
@@ -129,11 +132,22 @@ module Jekyll
               next if allow_used_permalink?(thing)
 
               dest_path = thing.destination(site.dest)
-              (result[dest_path] ||= []) << thing.path
+              (result[dest_path] ||= []) << canonical_path(thing, site)
             end
           end
         end
 
+        # Documents read from within the site source have a path relative to
+        # the source directory while documents read from outside of it have an
+        # absolute path. Canonicalize both so that the same file is never
+        # reported as two conflicting files.
+        def canonical_path(thing, site)
+          path = thing.path
+          return path if Pathname.new(path).absolute?
+
+          File.expand_path(path, site.source)
+        end
+
         def allow_used_permalink?(item)
           defined?(JekyllRedirectFrom) && item.is_a?(JekyllRedirectFrom::RedirectPage)
         end
