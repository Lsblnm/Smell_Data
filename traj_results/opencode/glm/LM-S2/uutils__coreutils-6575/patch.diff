+/// Print a line of output, with the filename written as raw bytes
+/// (so that non-UTF-8 filenames are not mangled).
+fn print_line(before: &str, filename: Option<&Path>, after: &str) -> UResult<()> {
+    let stdout = stdout();
+    let mut stdout = stdout.lock();
+    stdout.write_all(before.as_bytes())?;
+    if let Some(filename) = filename {
+        #[cfg(unix)]
+        {
+            use std::os::unix::ffi::OsStrExt;
+            stdout.write_all(filename.as_os_str().as_bytes())?;
+        }
+        #[cfg(not(unix))]
+        stdout.write_all(filename.to_string_lossy().as_bytes())?;
+    }
+    stdout.write_all(after.as_bytes())?;
+    stdout.write_all(b"\n")?;
+    Ok(())
+}
