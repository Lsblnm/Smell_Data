diff --git a/lib/fpm/package/deb.rb b/lib/fpm/package/deb.rb
index aa91911..043a2b3 100644
--- a/lib/fpm/package/deb.rb
+++ b/lib/fpm/package/deb.rb
@@ -428,6 +428,7 @@ class FPM::Package::Deb < FPM::Package
 
   def output(output_path)
     self.provides = self.provides.collect { |p| fix_provides(p) }
+    self.provides.each { |p| validate_provides(p) }
     output_check(output_path)
     # Abort if the target path already exists.
 
@@ -794,6 +795,18 @@ class FPM::Package::Deb < FPM::Package
     return provides.rstrip
   end
 
+  def validate_provides(provides)
+    # Debian policy: a Provides entry is either "name" or "name (= version)".
+    # Only the exact version operator "=" is allowed.
+    # Ref: https://www.debian.org/doc/debian-policy/ch-relationships.html
+    valid = /^[A-Za-z0-9][A-Za-z0-9+.-]*(\s*\(\s*=\s*[0-9][A-Za-z0-9.+:~-]*\s*\))?$/
+    if provides !~ valid
+      raise FPM::InvalidPackageConfiguration,
+        "Invalid provides value '#{provides}'. Debian provides must be 'name' or " \
+        "'name (= version)'; only the '=' operator is valid in Provides."
+    end
+  end # def validate_provides
+
   def control_path(path=nil)
     @control_path ||= build_path("control")
     FileUtils.mkdir(@control_path) if !File.directory?(@control_path)
