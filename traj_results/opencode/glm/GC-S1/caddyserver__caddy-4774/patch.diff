+func parseOptStrings(d *caddyfile.Dispenser, existingVal interface{}) (interface{}, error) {
+	d.Next() // consume parameter name
+	var vals []string
+	for d.Next() {
+		vals = append(vals, d.Val())
+	}
+	if len(vals) == 0 {
+		return nil, d.ArgErr()
+	}
+	existing, ok := existingVal.([]string)
+	if ok {
+		return append(existing, vals...), nil
+	}
+	return vals, nil
+}
