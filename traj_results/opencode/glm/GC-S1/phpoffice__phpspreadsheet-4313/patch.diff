+    /**
+     * Build an Excel address/formula reference from a matched ODS reference.
+     *
+     * @param array<int|string, string> $matches
+     */
+    private static function convertReference(array $matches): string
+    {
+        if (($matches[1] ?? '') !== '') {
+            $result = $matches[1] . '!' . $matches[2];
+            if (($matches[3] ?? '') !== '') {
+                $result .= ':' . $matches[3];
+            } elseif (($matches[4] ?? '') !== '') {
+                $result .= ':' . $matches[4];
+            }
+
+            return $result;
+        }
+        if (($matches[5] ?? '') !== '') {
+            return $matches[5] . ':' . $matches[6];
+        }
+
+        return $matches[7];
+    }
