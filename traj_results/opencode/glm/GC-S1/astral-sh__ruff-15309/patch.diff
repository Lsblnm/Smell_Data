index 0b39dc73e..c6c46fcc4 100644
--- a/crates/ruff_linter/src/rules/pyflakes/fixes.rs
+++ b/crates/ruff_linter/src/rules/pyflakes/fixes.rs
@@ -60,6 +60,25 @@ pub(crate) fn remove_unused_positional_arguments_from_format_call(
     locator: &Locator,
     stylist: &Stylist,
 ) -> Result<Edit> {
+    // If we're removing _all_ arguments, we can remove the entire call.
+    //
+    // For example, `"Hello".format(", world!")` -> `"Hello"`, as opposed to `"Hello".format()`.
+    //
+    // However, if the `format` call has other effects, like escaping `{{` to `{` or would raise a
+    // `KeyError` for a missing field name, we preserve the empty call to avoid changing behavior.
+    if unused_arguments.len() == call.arguments.len() {
+        if let ast::Expr::Attribute(attribute) = &*call.func {
+            if let ast::Expr::StringLiteral(string_expr) = &*attribute.value {
+                if !string_expr.value.to_str().contains(['{', '}']) {
+                    return Ok(Edit::range_replacement(
+                        locator.slice(string_expr).to_string(),
+                        call.range(),
+                    ));
+                }
+            }
+        }
+    }
+
     let mut repair = FormatCallRepair::empty();
     repair.capture_source_window_from_range(call.range(), locator);
     repair.capture_call_shape(call);
