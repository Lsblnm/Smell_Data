diff --git a/src/Fixer/StringNotation/SimpleToComplexStringVariableFixer.php b/src/Fixer/StringNotation/SimpleToComplexStringVariableFixer.php
index efb139ca3..3f10f249a 100644
--- a/src/Fixer/StringNotation/SimpleToComplexStringVariableFixer.php
+++ b/src/Fixer/StringNotation/SimpleToComplexStringVariableFixer.php
@@ -85,9 +85,9 @@ protected function applyFix(\SplFileInfo $file, Tokens $tokens): void
                 continue;
             }
 
-            $dollarCloseToken = $tokens[$index + 2];
+            $dollarCloseIndex = $this->findDollarCloseBraceIndex($tokens, $index);
 
-            if (!$dollarCloseToken->isGivenKind(CT::T_DOLLAR_CLOSE_CURLY_BRACES)) {
+            if (null === $dollarCloseIndex) {
                 continue;
             }
 
@@ -99,12 +99,41 @@ protected function applyFix(\SplFileInfo $file, Tokens $tokens): void
                 $tokenOfStringBeforeToken = new Token([T_ENCAPSED_AND_WHITESPACE, $newContent]);
             }
 
-            $tokens->overrideRange($index - 1, $index + 2, [
+            $overrideTokens = [
                 $tokenOfStringBeforeToken,
                 new Token([T_CURLY_OPEN, '{']),
                 new Token([T_VARIABLE, '$'.$varnameToken->getContent()]),
-                new Token([CT::T_CURLY_CLOSE, '}']),
-            ]);
+            ];
+
+            for ($i = $index + 2; $i < $dollarCloseIndex; ++$i) {
+                $overrideTokens[] = $tokens[$i];
+            }
+
+            $overrideTokens[] = new Token([CT::T_CURLY_CLOSE, '}']);
+
+            $tokens->overrideRange($index - 1, $dollarCloseIndex, $overrideTokens);
+        }
+    }
+
+    private function findDollarCloseBraceIndex(Tokens $tokens, int $dollarOpenBraceIndex): ?int
+    {
+        $nestedDollarOpenBraceCount = 0;
+        $count = \count($tokens);
+
+        for ($index = $dollarOpenBraceIndex + 1; $index < $count; ++$index) {
+            $token = $tokens[$index];
+
+            if ($token->isGivenKind(T_DOLLAR_OPEN_CURLY_BRACES)) {
+                ++$nestedDollarOpenBraceCount;
+            } elseif ($token->isGivenKind(CT::T_DOLLAR_CLOSE_CURLY_BRACES)) {
+                if (0 === $nestedDollarOpenBraceCount) {
+                    return $index;
+                }
+
+                --$nestedDollarOpenBraceCount;
+            }
         }
+
+        return null;
     }
 }
