index 6cfdc8d1..474ac3af 100644
--- a/tokio/src/sync/broadcast.rs
+++ b/tokio/src/sync/broadcast.rs
@@ -3772,7 +3772,17 @@ fn new_receiver<T>(shared: Arc<Shared<T>>) -> Receiver<T> {
 
     tail.rx_cnt = tail.rx_cnt.checked_add(1).expect("overflow");
 
-    let next = tail.pos;
+    let next = if tail.closed {
+        // The channel is closed. `tail.pos` includes the "closed" sentinel
+        // slot, which does not hold a value but is marked with the `closed`
+        // flag (see `send2` & issue #2425 for details). Starting the new
+        // receiver one position earlier makes it read the sentinel slot and
+        // return `Closed` instead of waiting forever for a value that can
