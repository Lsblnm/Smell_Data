diff --git a/src/core/lombok/eclipse/handlers/HandleSuperBuilder.java b/src/core/lombok/eclipse/handlers/HandleSuperBuilder.java
index 0d327d5f..e5348a88 100644
--- a/src/core/lombok/eclipse/handlers/HandleSuperBuilder.java
+++ b/src/core/lombok/eclipse/handlers/HandleSuperBuilder.java
@@ -1106,6 +1106,20 @@ public class HandleSuperBuilder extends EclipseAnnotationHandler<SuperBuilder> {
 			}
 		}
 		
+		// 4. Add the names of the superclass and any implemented interfaces, so our generics do not shadow them.
+		if (td.superclass != null) {
+			char[][] superclassTokens = td.superclass.getTypeName();
+			if (superclassTokens != null && superclassTokens.length > 0) // Add the last token, the superclass' name.
+				usedNames.add(String.valueOf(superclassTokens[superclassTokens.length - 1]));
+		}
+		if (td.superInterfaces != null) {
+			for (TypeReference implementedInterface : td.superInterfaces) {
+				char[][] interfaceTokens = implementedInterface.getTypeName();
+				if (interfaceTokens != null && interfaceTokens.length > 0) // Add the first token, because only that can collide.
+					usedNames.add(String.valueOf(interfaceTokens[0]));
+			}
+		}
+		
 		return usedNames;
 	}
 	
diff --git a/src/core/lombok/javac/handlers/HandleSuperBuilder.java b/src/core/lombok/javac/handlers/HandleSuperBuilder.java
index 3bafab5c..6df05da6 100644
--- a/src/core/lombok/javac/handlers/HandleSuperBuilder.java
+++ b/src/core/lombok/javac/handlers/HandleSuperBuilder.java
@@ -1195,6 +1195,20 @@ public class HandleSuperBuilder extends JavacAnnotationHandler<SuperBuilder> {
 			}
 		}
 		
+		// 4. Add the names of the superclass and any implemented interfaces, so our generics do not shadow them.
+		JCTree superclass = Javac.getExtendsClause(td);
+		if (superclass instanceof JCTypeApply) superclass = ((JCTypeApply) superclass).getType();
+		if (superclass instanceof JCIdent) usedNames.add(((JCIdent) superclass).name.toString());
+		else if (superclass instanceof JCFieldAccess) usedNames.add(((JCFieldAccess) superclass).name.toString());
+		if (td.getImplementsClause() != null) {
+			for (com.sun.source.tree.Tree implementedInterface : td.getImplementsClause()) {
+				JCTree type = (JCTree) implementedInterface;
+				if (type instanceof JCTypeApply) type = ((JCTypeApply) type).getType();
+				while (type instanceof JCFieldAccess) type = ((JCFieldAccess) type).getExpression();
+				if (type instanceof JCIdent) usedNames.add(((JCIdent) type).name.toString());
+			}
+		}
+		
 		return usedNames;
 	}
 	
