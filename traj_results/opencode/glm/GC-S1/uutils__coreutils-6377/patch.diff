+#[cfg(unix)]
+fn apply_ignore_signals(opts: &Options<'_>) -> Result<(), Box<dyn UError>> {
+    use std::str::FromStr;
+
+    let mut signals: Vec<Signal> = Vec::new();
+
+    if opts.ignore_all_signals {
+        // `--ignore-signal` without a value: ignore all signals that can be ignored.
+        // SIGCHLD must be kept since we rely on wait(2) to run the child program.
+        for value in 1i32..=31 {
+            if let Ok(signal) = Signal::try_from(value) {
+                if !matches!(signal, Signal::SIGKILL | Signal::SIGSTOP | Signal::SIGCHLD) {
+                    signals.push(signal);
+                }
+            }
+        }
+    } else {
+        for sig in &opts.ignore_signals {
+            let name = sig.to_string_lossy();
+            if name.trim().is_empty() {
+                // an empty signal name is a no-op (e.g. from an unexpanded shell variable)
+                continue;
+            }
+            let upper = name.trim().to_uppercase();
+            let signal = Signal::from_str(&upper)
+                .or_else(|_| Signal::from_str(&format!("SIG{upper}")))
+                .map_err(|_| USimpleError::new(125, format!("{}: invalid signal", name.quote())))?;
+            signals.push(signal);
+        }
+    }
+
+    let action = SigAction::new(SigHandler::SigIgn, SaFlags::empty(), SigSet::empty());
+    for signal in signals {
+        if let Err(err) = unsafe { sigaction(signal, &action) } {
+            uucore::show_error!(
+                "failed to set signal action for signal {}: {}",
+                signal as i32,
+                err.desc()
+            );
+            return Err(125.into());
+        }
+    }
+
+    Ok(())
+}
+
+#[cfg(not(unix))]
+fn apply_ignore_signals(_opts: &Options<'_>) -> Result<(), Box<dyn UError>> {
+    Ok(())
+}
