+// A range element type is formattable as a character if it is the same as the
+// format char type or is char when formatting wide strings.
+template <typename T, typename Char>
+struct is_formattable_char
+    : bool_constant<std::is_same<T, Char>::value ||
+                    (std::is_same<T, char>::value &&
+                     std::is_same<Char, wchar_t>::value)> {};
