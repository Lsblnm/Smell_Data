+	// If the file ends with a newline, strip it. This is
+	// because files on disk typically end with a newline
+	// due to Unix convention, but the newline is usually
+	// not intended to be part of the value (e.g. secrets).
+	// We only strip one newline, since multiple newlines
+	// are likely intentional.
+	if len(body) > 0 && body[len(body)-1] == '\n' {
+		body = body[:len(body)-1]
