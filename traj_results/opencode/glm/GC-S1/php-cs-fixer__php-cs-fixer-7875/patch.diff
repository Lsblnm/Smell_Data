+    /**
+     * Find the end index (`;`) of a class member declaration (constant or property) that
+     * starts after the modifier under given index, or null when the declaration is not
+     * a constant/property member (e.g. it is a method or a class declaration).
+     *
+     * @param list<int> $typeTokens
+     */
+    private function findClassMemberEndIndex(Tokens $tokens, int $index, array $typeTokens): ?int
+    {
+        $searchIndex = $tokens->getNextMeaningfulToken($index);
+
+        while (null !== $searchIndex) {
+            $token = $tokens[$searchIndex];
+
+            if ($token->isGivenKind([T_VARIABLE, T_CONST])) {
+                return $tokens->getNextTokenOfKind($searchIndex, [';']);
+            }
+
+            if ($token->isGivenKind([T_FUNCTION, T_CLASS, T_INTERFACE, T_TRAIT]) || (\defined('T_ENUM') && $token->isGivenKind(T_ENUM))) {
+                return null;
+            }
+
+            if ($token->equals('(')) {
+                $searchIndex = $tokens->getNextMeaningfulToken($tokens->findBlockEnd(Tokens::BLOCK_TYPE_PARENTHESIS_BRACE, $searchIndex));
+
+                continue;
+            }
+
+            if ($token->isGivenKind($typeTokens) || $token->isGivenKind([T_PUBLIC, T_PROTECTED, T_PRIVATE, T_ABSTRACT, T_FINAL])) {
+                $searchIndex = $tokens->getNextMeaningfulToken($searchIndex);
+
+                continue;
+            }
+
+            return null;
+        }
+
+        return null;
+    }
+
     /**
