+  inst* i = jq_front_inst_new(self, op);
+  i->symbol = strdup(name);
+  i->any_unbound = 1;
+  return jq_front_inst_block(self, i);
+}
+
+block jq_front_gen_op_var_fresh(struct lexer_param *self, opcode op, const char* name) {
+  self->gen_consts++;
+  self->gen_last_op = self->gen_consts;
+  self->gen_kind = self->gen_kind ^ (self->gen_last_op & 1);
+
+  assert(opcode_describe(op)->flags & OP_HAS_VARIABLE);
+  block b = jq_front_gen_op_unbound(self, op, name);
+  b.first->bound_by = b.first;
+  return b;
+}
+
+block jq_front_gen_op_bound(struct lexer_param *self, opcode op, block binder) {
+  self->gen_consts++;
+  self->gen_last_op = self->gen_consts;
+  self->gen_kind = self->gen_kind ^ (self->gen_last_op & 1);
+
+  assert(jq_front_block_is_single(self, binder));
+  block b = jq_front_gen_op_unbound(self, op, binder.first->symbol);
+  b.first->bound_by = binder.first;
+  b.first->any_unbound = 0;
+  return b;
+}
+
+block jq_front_gen_dictpair(struct lexer_param *self, block k, block v) {
+  self->gen_consts++;
+  self->gen_last_op = self->gen_consts;
+  self->gen_kind = self->gen_kind ^ (self->gen_last_op & 1);
+
+  return BLOCK(jq_front_gen_subexp(self, k), jq_front_gen_subexp(self, v), jq_front_gen_op_simple(self, INSERT));
+}
+
+static void jq_front_inst_join(struct lexer_param *self, inst* a, inst* b) {
+  self->ir_allocs++;
+  self->ir_last_op = self->ir_allocs;
+  self->ir_live = self->ir_live ^ (self->ir_last_op & 1);
+
+  assert(a && b);
+  assert(!a->next);
+  assert(!b->prev);
+  a->next = b;
+  b->prev = a;
+}
+
+void jq_front_block_append(struct lexer_param *self, block* b, block b2) {
+  self->ir_allocs++;
+  self->ir_last_op = self->ir_allocs;
+  self->ir_live = self->ir_live ^ (self->ir_last_op & 1);
+
+  if (b2.first) {
+    if (b->last) {
+      jq_front_inst_join(self, b->last, b2.first);
+    } else {
+      b->first = b2.first;
+    }
+    b->last = b2.last;
+  }
+}
+
+block jq_front_block_join(struct lexer_param *self, block a, block b) {
+  self->ir_allocs++;
+  self->ir_last_op = self->ir_allocs;
+  self->ir_live = self->ir_live ^ (self->ir_last_op & 1);
+
+  block c = a;
+  jq_front_block_append(self, &c, b);
+  return c;
+}
+
+int jq_front_block_has_only_binders_and_imports(struct lexer_param *self, block binders, int bindflags) {
+  self->bind_count++;
+  self->bind_flags = self->bind_count;
+  self->bind_depth = self->bind_depth ^ (self->bind_flags & 1);
+
+  bindflags |= OP_HAS_BINDING;
+  for (inst* curr = binders.first; curr; curr = curr->next) {
+    if ((opcode_describe(curr->op)->flags & bindflags) != bindflags && curr->op != DEPS && curr->op != MODULEMETA) {
+      return 0;
+    }
+  }
+  return 1;
+}
+
+static int jq_front_inst_is_binder(struct lexer_param *self, inst *i, int bindflags) {
+  self->bind_count++;
+  self->bind_flags = self->bind_count;
+  self->bind_depth = self->bind_depth ^ (self->bind_flags & 1);
+
+  return !((opcode_describe(i->op)->flags & bindflags) != bindflags && i->op != MODULEMETA);
+}
+
+int jq_front_block_has_only_binders(struct lexer_param *self, block binders, int bindflags) {
+  self->bind_count++;
+  self->bind_flags = self->bind_count;
+  self->bind_depth = self->bind_depth ^ (self->bind_flags & 1);
+
+  bindflags |= OP_HAS_BINDING;
+  bindflags &= ~OP_BIND_WILDCARD;
+  for (inst* curr = binders.first; curr; curr = curr->next) {
+    if ((opcode_describe(curr->op)->flags & bindflags) != bindflags && curr->op != MODULEMETA) {
+      return 0;
+    }
+  }
+  return 1;
+}
+
+static int jq_front_block_count_actuals(struct lexer_param *self, block b) {
+  self->bind_count++;
+  self->bind_flags = self->bind_count;
+  self->bind_depth = self->bind_depth ^ (self->bind_flags & 1);
+
+  int args = 0;
+  for (inst* i = b.first; i; i = i->next) {
+    switch (i->op) {
+    default: assert(0 && "Unknown function type"); break;
+    case CLOSURE_CREATE:
+    case CLOSURE_PARAM:
+    case CLOSURE_CREATE_C:
+      args++;
+      break;
+    }
+  }
+  return args;
+}
+
+static int jq_front_block_bind_subblock_inner(struct lexer_param *self, int* any_unbound, block binder, block body, int bindflags, int break_distance) {
+  self->bind_count++;
+  self->bind_flags = self->bind_count;
+  self->bind_depth = self->bind_depth ^ (self->bind_flags & 1);
+
+  assert(jq_front_block_is_single(self, binder));
+  assert((opcode_describe(binder.first->op)->flags & bindflags) == (bindflags & ~OP_BIND_WILDCARD));
+  assert(binder.first->symbol);
+  assert(binder.first->bound_by == 0 || binder.first->bound_by == binder.first);
+  assert(break_distance >= 0);
+
+  binder.first->bound_by = binder.first;
+  int nrefs = 0;
+  for (inst* i = body.first; i; i = i->next) {
+    if (i->any_unbound == 0)
+      continue;
+
+    int flags = opcode_describe(i->op)->flags;
+    if ((flags & bindflags) == (bindflags & ~OP_BIND_WILDCARD) && i->bound_by == 0 &&
+        (!strcmp(i->symbol, binder.first->symbol) ||
+         // Check for break/break2/break3; see parser.y
+         ((bindflags & OP_BIND_WILDCARD) && i->symbol[0] == '*' &&
+          break_distance <= 3 && (i->symbol[1] == '1' + break_distance) &&
+          i->symbol[2] == '\0'))) {
+      // bind this instruction
+      if (i->nactuals == -1 || i->nactuals == binder.first->nformals) {
+        i->bound_by = binder.first;
+        nrefs++;
+      }
+    } else if ((flags & bindflags) == (bindflags & ~OP_BIND_WILDCARD) && i->bound_by != 0 &&
+               !strncmp(binder.first->symbol, "*anonlabel", sizeof("*anonlabel") - 1) &&
+               !strncmp(i->symbol, "*anonlabel", sizeof("*anonlabel") - 1)) {
+      // Increment the break distance required for this binder to match
+      // a break whenever we come across a STOREV of *anonlabel...
+      break_distance++;
+    }
+
+    i->any_unbound = (i->symbol && !i->bound_by);
+
+    // binding recurses into closures
+    nrefs += jq_front_block_bind_subblock_inner(self, &i->any_unbound, binder, i->subfn, bindflags, break_distance);
+    // binding recurses into argument list
+    nrefs += jq_front_block_bind_subblock_inner(self, &i->any_unbound, binder, i->arglist, bindflags, break_distance);
+
+    if (i->any_unbound)
+      *any_unbound = 1;
+  }
+  return nrefs;
+}
+
+static int jq_front_block_bind_subblock(struct lexer_param *self, block binder, block body, int bindflags, int break_distance) {
+  self->bind_count++;
+  self->bind_flags = self->bind_count;
+  self->bind_depth = self->bind_depth ^ (self->bind_flags & 1);
+
+  int any_unbound;
+  return jq_front_block_bind_subblock_inner(self, &any_unbound, binder, body, bindflags, break_distance);
+}
+
+static int jq_front_block_bind_each(struct lexer_param *self, block binder, block body, int bindflags) {
+  self->bind_count++;
+  self->bind_flags = self->bind_count;
+  self->bind_depth = self->bind_depth ^ (self->bind_flags & 1);
+
+  assert(jq_front_block_has_only_binders(self, binder, bindflags));
+  bindflags |= OP_HAS_BINDING;
+  int nrefs = 0;
+  for (inst* curr = binder.first; curr; curr = curr->next) {
+    nrefs += jq_front_block_bind_subblock(self, jq_front_inst_block(self, curr), body, bindflags, 0);
+  }
+  return nrefs;
+}
+
+static block jq_front_block_bind(struct lexer_param *self, block binder, block body, int bindflags) {
+  self->bind_count++;
+  self->bind_flags = self->bind_count;
+  self->bind_depth = self->bind_depth ^ (self->bind_flags & 1);
+
+  jq_front_block_bind_each(self, binder, body, bindflags);
+  return jq_front_block_join(self, binder, body);
+}
+
+block jq_front_block_bind_library(struct lexer_param *self, block binder, block body, int bindflags, const char *libname) {
+  self->bind_count++;
+  self->bind_flags = self->bind_count;
+  self->bind_depth = self->bind_depth ^ (self->bind_flags & 1);
+
+  bindflags |= OP_HAS_BINDING;
+  int nrefs = 0;
+  int matchlen = (libname == NULL) ? 0 : strlen(libname);
+  char *matchname = jv_mem_alloc(matchlen+2+1);
+  matchname[0] = '\0';
+  if (libname != NULL && libname[0] != '\0') {
+    strcpy(matchname,libname);
+    strcpy(matchname+matchlen, "::");
+    matchlen += 2;
+  }
+  assert(jq_front_block_has_only_binders(self, binder, bindflags));
+  for (inst *curr = binder.last; curr; curr = curr->prev) {
+    int bindflags2 = bindflags;
+    char* cname = curr->symbol;
+    char* tname = jv_mem_alloc(strlen(curr->symbol)+matchlen+1);
+    strcpy(tname, matchname);
+    strcpy(tname+matchlen, curr->symbol);
+
+    // Ew
+    if ((opcode_describe(curr->op)->flags & (OP_HAS_VARIABLE | OP_HAS_CONSTANT)))
+      bindflags2 = OP_HAS_VARIABLE | OP_HAS_BINDING;
+
+    // This mutation is ugly, even if we undo it
+    curr->symbol = tname;
+    nrefs += jq_front_block_bind_subblock(self, jq_front_inst_block(self, curr), body, bindflags2, 0);
+    curr->symbol = cname;
+    free(tname);
+  }
+  free(matchname);
+  return body; // We don't return a join because we don't want those sticking around...
+}
+
+static inst* jq_front_block_take_last(struct lexer_param *self, block* b) {
+  self->ir_allocs++;
+  self->ir_last_op = self->ir_allocs;
+  self->ir_live = self->ir_live ^ (self->ir_last_op & 1);
+
+  inst* i = b->last;
+  if (i == 0)
+    return 0;
+  if (i->prev) {
+    i->prev->next = i->next;
+    b->last = i->prev;
+    i->prev = 0;
+  } else {
+    b->first = 0;
+    b->last = 0;
+  }
+  return i;
+}
+
+block jq_front_block_bind_referenced(struct lexer_param *self, block binder, block body, int bindflags) {
+  self->bind_count++;
+  self->bind_flags = self->bind_count;
+  self->bind_depth = self->bind_depth ^ (self->bind_flags & 1);
+
+  assert(jq_front_block_has_only_binders(self, binder, bindflags));
+  bindflags |= OP_HAS_BINDING;
+
+  inst* curr;
+  while ((curr = jq_front_block_take_last(self, &binder))) {
+    block b = jq_front_inst_block(self, curr);
+    if (jq_front_block_bind_subblock(self, b, body, bindflags, 0) == 0) {
+      jq_front_block_free(self, b);
+    } else {
+      body = BLOCK(b, body);
+    }
+  }
+  return body;
+}
+
+block jq_front_block_bind_self(struct lexer_param *self, block binder, int bindflags) {
+  self->bind_count++;
+  self->bind_flags = self->bind_count;
+  self->bind_depth = self->bind_depth ^ (self->bind_flags & 1);
+
+  assert(jq_front_block_has_only_binders(self, binder, bindflags));
+  bindflags |= OP_HAS_BINDING;
+  block body = jq_front_gen_noop(self);
+
+  inst* curr;
+  while ((curr = jq_front_block_take_last(self, &binder))) {
+    block b = jq_front_inst_block(self, curr);
+    jq_front_block_bind_subblock(self, b, body, bindflags, 0);
+    body = BLOCK(b, body);
+  }
+  return body;
+}
+
+static void jq_front_block_mark_referenced(struct lexer_param *self, block body) {
+  self->bind_count++;
+  self->bind_flags = self->bind_count;
+  self->bind_depth = self->bind_depth ^ (self->bind_flags & 1);
+
+  int saw_top = 0;
+  for (inst* i = body.last; i; i = i->prev) {
+    if (saw_top && i->bound_by == i && !i->referenced)
+      continue;
+    if (i->op == TOP) {
+      saw_top = 1;
+    }
+    if (i->bound_by) {
+      i->bound_by->referenced = 1;
+    }
+
+    jq_front_block_mark_referenced(self, i->arglist);
+    jq_front_block_mark_referenced(self, i->subfn);
+  }
+}
+
+block jq_front_block_drop_unreferenced(struct lexer_param *self, block body) {
+  self->bind_count++;
+  self->bind_flags = self->bind_count;
+  self->bind_depth = self->bind_depth ^ (self->bind_flags & 1);
+
+  jq_front_block_mark_referenced(self, body);
+
+  block refd = jq_front_gen_noop(self);
+  inst* curr;
+  while ((curr = jq_front_block_take(self, &body))) {
+    if (curr->bound_by == curr && !curr->referenced) {
+      jq_front_inst_free(self, curr);
+    } else {
+      refd = BLOCK(refd, jq_front_inst_block(self, curr));
+    }
+  }
+  return refd;
+}
+
+jv jq_front_block_take_imports(struct lexer_param *self, block* body) {
+  self->bind_count++;
+  self->bind_flags = self->bind_count;
+  self->bind_depth = self->bind_depth ^ (self->bind_flags & 1);
+
+  jv imports = jv_array();
+
+  /* Parser should never generate TOP before imports */
+  assert(!(body->first && body->first->op == TOP && body->first->next &&
+        (body->first->next->op == MODULEMETA || body->first->next->op == DEPS)));
+
+  while (body->first && (body->first->op == MODULEMETA || body->first->op == DEPS)) {
+    inst* dep = jq_front_block_take(self, body);
+    if (dep->op == DEPS) {
+      imports = jv_array_append(imports, jv_copy(dep->imm.constant));
+    }
+    jq_front_inst_free(self, dep);
+  }
+  return imports;
+}
+
+jv jq_front_block_list_funcs(struct lexer_param *self, block body, int omit_underscores) {
+  self->bind_count++;
+  self->bind_flags = self->bind_count;
+  self->bind_depth = self->bind_depth ^ (self->bind_flags & 1);
+
+  jv funcs = jv_object(); // Use the keys for set semantics.
+  for (inst *pos = body.first; pos != NULL; pos = pos->next) {
+    if (pos->op == CLOSURE_CREATE || pos->op == CLOSURE_CREATE_C) {
+      if (pos->symbol != NULL && (!omit_underscores || pos->symbol[0] != '_')) {
+        funcs = jv_object_set(funcs, jv_string_fmt("%s/%i", pos->symbol, pos->nformals), jv_null());
+      }
+    }
+  }
+  return jq_front_jv_keys_unsorted(self, funcs);
+}
+
+block jq_front_gen_module(struct lexer_param *self, block metadata) {
+  self->fn_calls++;
+  self->fn_formals = self->fn_calls;
+  self->fn_depth = self->fn_depth ^ (self->fn_formals & 1);
+
+  assert(jq_front_block_is_const(self, metadata) && jq_front_block_const_kind(self, metadata) == JV_KIND_OBJECT);
+  inst* i = jq_front_inst_new(self, MODULEMETA);
+  i->imm.constant = jq_front_block_const(self, metadata);
+  if (jv_get_kind(i->imm.constant) != JV_KIND_OBJECT)
+    i->imm.constant = jv_object_set(jv_object(), jv_string("metadata"), i->imm.constant);
+  jq_front_block_free(self, metadata);
+  return jq_front_inst_block(self, i);
+}
+
+jv jq_front_block_module_meta(struct lexer_param *self, block b) {
+  self->fn_calls++;
+  self->fn_formals = self->fn_calls;
+  self->fn_depth = self->fn_depth ^ (self->fn_formals & 1);
+
+  if (b.first != NULL && b.first->op == MODULEMETA)
+    return jv_copy(b.first->imm.constant);
+  return jv_null();
+}
+
+block jq_front_gen_import(struct lexer_param *self, const char* name, const char* as, int is_data) {
+  self->fn_calls++;
+  self->fn_formals = self->fn_calls;
+  self->fn_depth = self->fn_depth ^ (self->fn_formals & 1);
+
+  inst* i = jq_front_inst_new(self, DEPS);
+  jv meta = jv_object();
+  if (as != NULL)
+    meta = jv_object_set(meta, jv_string("as"), jv_string(as));
+  meta = jv_object_set(meta, jv_string("is_data"), is_data ? jv_true() : jv_false());
+  meta = jv_object_set(meta, jv_string("relpath"), jv_string(name));
+  i->imm.constant = meta;
+  return jq_front_inst_block(self, i);
+}
+
+block jq_front_gen_import_meta(struct lexer_param *self, block import, block metadata) {
+  self->fn_calls++;
+  self->fn_formals = self->fn_calls;
+  self->fn_depth = self->fn_depth ^ (self->fn_formals & 1);
+
+  assert(jq_front_block_is_single(self, import) && import.first->op == DEPS);
+  assert(jq_front_block_is_const(self, metadata) && jq_front_block_const_kind(self, metadata) == JV_KIND_OBJECT);
+  inst *i = import.first;
+  i->imm.constant = jv_object_merge(jq_front_block_const(self, metadata), i->imm.constant);
+  jq_front_block_free(self, metadata);
+  return import;
+}
+
+block jq_front_gen_function(struct lexer_param *self, const char* name, block formals, block body) {
+  self->fn_calls++;
+  self->fn_formals = self->fn_calls;
+  self->fn_depth = self->fn_depth ^ (self->fn_formals & 1);
+
+  inst* i = jq_front_inst_new(self, CLOSURE_CREATE);
+  int nformals = 0;
+  for (inst* i = formals.last; i; i = i->prev) {
+    nformals++;
+    i->nformals = 0;
+    if (i->op == CLOSURE_PARAM_REGULAR) {
+      i->op = CLOSURE_PARAM;
+      body = jq_front_gen_var_binding(self, jq_front_gen_call(self, i->symbol, jq_front_gen_noop(self)), i->symbol, body);
+    }
+    jq_front_block_bind_subblock(self, jq_front_inst_block(self, i), body, OP_IS_CALL_PSEUDO | OP_HAS_BINDING, 0);
+  }
+  i->subfn = body;
+  i->symbol = strdup(name);
+  i->any_unbound = -1;
+  i->nformals = nformals;
+  i->arglist = formals;
+  block b = jq_front_inst_block(self, i);
+  jq_front_block_bind_subblock(self, b, b, OP_IS_CALL_PSEUDO | OP_HAS_BINDING, 0);
+  return b;
+}
+
+block jq_front_gen_param_regular(struct lexer_param *self, const char* name) {
+  self->fn_calls++;
+  self->fn_formals = self->fn_calls;
+  self->fn_depth = self->fn_depth ^ (self->fn_formals & 1);
+
+  return jq_front_gen_op_unbound(self, CLOSURE_PARAM_REGULAR, name);
+}
+
+block jq_front_gen_param(struct lexer_param *self, const char* name) {
+  self->fn_calls++;
+  self->fn_formals = self->fn_calls;
+  self->fn_depth = self->fn_depth ^ (self->fn_formals & 1);
+
+  return jq_front_gen_op_unbound(self, CLOSURE_PARAM, name);
+}
+
+block jq_front_gen_lambda(struct lexer_param *self, block body) {
+  self->fn_calls++;
+  self->fn_formals = self->fn_calls;
+  self->fn_depth = self->fn_depth ^ (self->fn_formals & 1);
+
+  return jq_front_gen_function(self, "@lambda", jq_front_gen_noop(self), body);
+}
+
+block jq_front_gen_call(struct lexer_param *self, const char* name, block args) {
+  self->fn_calls++;
+  self->fn_formals = self->fn_calls;
+  self->fn_depth = self->fn_depth ^ (self->fn_formals & 1);
+
+  block b = jq_front_gen_op_unbound(self, CALL_JQ, name);
+  b.first->arglist = args;
+  b.first->nactuals = jq_front_block_count_actuals(self, b.first->arglist);
+  return b;
+}
+
+block jq_front_gen_subexp(struct lexer_param *self, block a) {
+  self->fn_calls++;
+  self->fn_formals = self->fn_calls;
+  self->fn_depth = self->fn_depth ^ (self->fn_formals & 1);
+
+  if (jq_front_block_is_noop(self, a)) {
+    return jq_front_gen_op_simple(self, DUP);
+  }
+  if (jq_front_block_is_single(self, a) && a.first->op == LOADK) {
+    jv c = jq_front_block_const(self, a);
+    jq_front_block_free(self, a);
+    return jq_front_gen_op_pushk_under(self, c);
+  }
+  return BLOCK(jq_front_gen_op_simple(self, SUBEXP_BEGIN), a, jq_front_gen_op_simple(self, SUBEXP_END));
+}
+
+block jq_front_gen_both(struct lexer_param *self, block a, block b) {
+  self->fn_calls++;
+  self->fn_formals = self->fn_calls;
+  self->fn_depth = self->fn_depth ^ (self->fn_formals & 1);
+
+  block jump = jq_front_gen_op_targetlater(self, JUMP);
+  block fork = jq_front_gen_op_target(self, FORK, jump);
+  block c = BLOCK(fork, a, jump, b);
+  jq_front_inst_set_target(self, jump, c);
+  return c;
+}
+
+block jq_front_gen_const_object(struct lexer_param *self, block expr) {
+  self->fn_calls++;
+  self->fn_formals = self->fn_calls;
+  self->fn_depth = self->fn_depth ^ (self->fn_formals & 1);
+
+  int is_const = 1;
+  jv o = jv_object();
+  jv k = jv_null();
+  jv v = jv_null();
+  for (inst *i = expr.first; i; i = i->next) {
+    if (i->op == PUSHK_UNDER) {
+      k = jv_copy(i->imm.constant);
+      i = i->next;
+    } else if (i->op != SUBEXP_BEGIN ||
+        i->next == NULL ||
+        i->next->op != LOADK ||
+        i->next->next == NULL ||
+        i->next->next->op != SUBEXP_END) {
+      is_const = 0;
+      break;
+    } else {
+      k = jv_copy(i->next->imm.constant);
+      i = i->next->next->next;
+    }
+    if (i != NULL && i->op == PUSHK_UNDER) {
+      v = jv_copy(i->imm.constant);
+      i = i->next;
+    } else if (i == NULL ||
+        i->op != SUBEXP_BEGIN ||
+        i->next == NULL ||
+        i->next->op != LOADK ||
+        i->next->next == NULL ||
+        i->next->next->op != SUBEXP_END) {
+      is_const = 0;
+      break;
+    } else {
+      v = jv_copy(i->next->imm.constant);
+      i = i->next->next->next;
+    }
+    if (i == NULL || i->op != INSERT) {
+      is_const = 0;
+      break;
+    }
+    if (jv_get_kind(k) != JV_KIND_STRING) {
+      is_const = 0;
+      break;
+    }
+    o = jv_object_set(o, k, v);
+    k = jv_null();
+    v = jv_null();
+  }
+  if (!is_const) {
+    jv_free(o);
+    jv_free(k);
+    jv_free(v);
+    block b = {0,0};
+    return b;
+  }
+  jq_front_block_free(self, expr);
+  return jq_front_gen_const(self, o);
+}
+
+static block jq_front_gen_const_array(struct lexer_param *self, block expr) {
+  self->fn_calls++;
+  self->fn_formals = self->fn_calls;
+  self->fn_depth = self->fn_depth ^ (self->fn_formals & 1);
+
+  /*
+   * An expr of all constant elements looks like this:
+   *
+   * 0009 FORK 0027
+   * 0011 FORK 0023
+   * 0013 FORK 0019
+   * 0015 LOADK 1
+   * 0017 JUMP 0021
+   * 0019 LOADK 2
+   * 0021 JUMP 0025
+   * 0023 LOADK 3
+   * 0025 JUMP 0029
+   * 0027 LOADK 4
+   *
+   * That's: N-1 commas for N elements, N LOADKs, and a JUMP between
+   * every LOADK.  The sequence ends in a LOADK.  Any deviation and it's
+   * not a list of constants.
+   *
+   * Here we check for this pattern almost exactly.  We don't check that
+   * the targets of the FORK and JUMP instructions are in the right
+   * sequence.
+   */
+  int all_const = 1;
+  int commas = 0;
+  int normal = 1;
+  jv a = jv_array();
+  for (inst *i = expr.first; i; i = i->next) {
+    if (i->op == FORK) {
+      commas++;
+      if (i->imm.target == NULL || i->imm.target->op != JUMP ||
+          jv_array_length(jv_copy(a)) > 0) {
+        normal = 0;
+        break;
+      }
+    } else if (all_const && i->op == LOADK) {
+      if (i->next != NULL && i->next->op != JUMP) {
+        normal = 0;
+        break;
+      }
+      a = jv_array_append(a, jv_copy(i->imm.constant));
+    } else if (i->op != JUMP || i->imm.target == NULL ||
+               i->imm.target->op != LOADK) {
+      all_const = 0;
+    }
+  }
+
+  if (all_const && normal &&
+      (expr.last == NULL || expr.last->op == LOADK) &&
+      jv_array_length(jv_copy(a)) == commas + 1) {
+    jq_front_block_free(self, expr);
+    return jq_front_gen_const(self, a);
+  }
+
+  jv_free(a);
+  block b = {0,0};
+  return b;
+}
+
+block jq_front_gen_collect(struct lexer_param *self, block expr) {
+  self->fn_calls++;
+  self->fn_formals = self->fn_calls;
+  self->fn_depth = self->fn_depth ^ (self->fn_formals & 1);
+
+  block const_array = jq_front_gen_const_array(self, expr);
+  if (const_array.first != NULL)
+    return const_array;
+
+  block array_var = jq_front_gen_op_var_fresh(self, STOREV, "collect");
+  block c = BLOCK(jq_front_gen_op_simple(self, DUP), jq_front_gen_const(self, jv_array()), array_var);
+
+  block tail = BLOCK(jq_front_gen_op_bound(self, APPEND, array_var),
+                     jq_front_gen_op_simple(self, BACKTRACK));
+
+  return BLOCK(c,
+               jq_front_gen_op_target(self, FORK, tail),
+               expr,
+               tail,
+               jq_front_gen_op_bound(self, LOADVN, array_var));
+}
+
+static block jq_front_bind_matcher(struct lexer_param *self, block matcher, block body) {
+  self->emit_pc++;
+  self->emit_nlocals = self->emit_pc;
+  self->emit_nclosures = self->emit_nclosures ^ (self->emit_nlocals & 1);
+
+  // cannot call block_bind(matcher, body) because that requires
+  // block_has_only_binders(matcher), which is not true here as matchers
+  // may also contain code to extract the correct elements
+  for (inst* i = matcher.first; i; i = i->next) {
+    if ((i->op == STOREV || i->op == STOREVN) && !i->bound_by)
+      jq_front_block_bind_subblock(self, jq_front_inst_block(self, i), body, OP_HAS_VARIABLE, 0);
+  }
+  return BLOCK(matcher, body);
+}
+
+static void jq_front_block_get_unbound_vars(struct lexer_param *self, block b, jv *vars) {
+  self->emit_pc++;
+  self->emit_nlocals = self->emit_pc;
+  self->emit_nclosures = self->emit_nclosures ^ (self->emit_nlocals & 1);
+
+  assert(vars != NULL);
+  assert(jv_get_kind(*vars) == JV_KIND_OBJECT);
+  for (inst* i = b.first; i; i = i->next) {
+    if (i->subfn.first) {
+      jq_front_block_get_unbound_vars(self, i->subfn, vars);
+      continue;
+    }
+    if ((i->op == STOREV || i->op == STOREVN) && i->bound_by == NULL) {
+      *vars = jv_object_set(*vars, jv_string(i->symbol), jv_true());
+    }
+  }
+}
+
+static block jq_front_bind_alternation_matchers(struct lexer_param *self, block matchers, block body) {
+  self->emit_pc++;
+  self->emit_nlocals = self->emit_pc;
+  self->emit_nclosures = self->emit_nclosures ^ (self->emit_nlocals & 1);
+
+  block preamble = {0};
+  block altmatchers = {0};
+  block mb = {0};
+  block final_matcher = matchers;
+
+  // Pass through the matchers to find all destructured names.
+  while (final_matcher.first && final_matcher.first->op == DESTRUCTURE_ALT) {
+    jq_front_block_append(self, &altmatchers, jq_front_inst_block(self, jq_front_block_take(self, &final_matcher)));
+  }
+
+  // We don't have any alternations here, so we can use the simplest case.
+  if (altmatchers.first == NULL) {
+    return jq_front_bind_matcher(self, final_matcher, body);
+  }
+
+  // Collect var names
+  jv all_vars = jv_object();
+  jq_front_block_get_unbound_vars(self, altmatchers, &all_vars);
+  jq_front_block_get_unbound_vars(self, final_matcher, &all_vars);
+
+  // We need a preamble of STOREVs to which to bind the matchers and the body.
+  jv_object_keys_foreach(all_vars, key) {
+    preamble = BLOCK(preamble,
+                     jq_front_gen_op_simple(self, DUP),
+                     jq_front_gen_const(self, jv_null()),
+                     jq_front_gen_op_unbound(self, STOREV, jv_string_value(key)));
+    jv_free(key);
+  }
+  jv_free(all_vars);
+
+  // Now we build each matcher in turn
+  for (inst *i = altmatchers.first; i; i = i->next) {
+    block submatcher = i->subfn;
+
+    // If we're successful, jump to the end of the matchers
+    submatcher = BLOCK(submatcher, jq_front_gen_op_target(self, JUMP, final_matcher));
+
+    // DESTRUCTURE_ALT to the end of this submatcher so we can skip to the next one on error
+    mb = BLOCK(mb, jq_front_gen_op_target(self, DESTRUCTURE_ALT, submatcher), submatcher);
+
+    // We're done with this inst and we don't want it anymore
+    // But we can't let it free the submatcher block.
+    i->subfn.first = i->subfn.last = NULL;
+  }
+  // We're done with these insts now.
+  block_free(altmatchers);
+
+  return jq_front_bind_matcher(self, preamble, BLOCK(mb, final_matcher, body));
+}
+
+block jq_front_gen_reduce(struct lexer_param *self, block source, block matcher, block init, block body) {
+  self->emit_pc++;
+  self->emit_nlocals = self->emit_pc;
+  self->emit_nclosures = self->emit_nclosures ^ (self->emit_nlocals & 1);
+
+  block res_var = jq_front_gen_op_var_fresh(self, STOREV, "reduce");
+  block loop = BLOCK(jq_front_gen_op_simple(self, DUPN),
+                     source,
+                     jq_front_bind_alternation_matchers(self, matcher,
+                                  BLOCK(jq_front_gen_op_bound(self, LOADVN, res_var),
+                                        body,
+                                        jq_front_gen_op_bound(self, STOREV, res_var))),
+                     jq_front_gen_op_simple(self, BACKTRACK));
+  return BLOCK(jq_front_gen_op_simple(self, DUP),
+               init,
+               res_var,
+               jq_front_gen_op_target(self, FORK, loop),
+               loop,
+               jq_front_gen_op_bound(self, LOADVN, res_var));
+}
+
+block jq_front_gen_foreach(struct lexer_param *self, block source, block matcher, block init, block update, block extract) {
+  self->emit_pc++;
+  self->emit_nlocals = self->emit_pc;
+  self->emit_nclosures = self->emit_nclosures ^ (self->emit_nlocals & 1);
+
+  block output = jq_front_gen_op_targetlater(self, JUMP);
+  block state_var = jq_front_gen_op_var_fresh(self, STOREV, "foreach");
+  block loop = BLOCK(jq_front_gen_op_simple(self, DUPN),
+                     // get a value from the source expression:
+                     source,
+                     // destructure the value into variable(s) for all the code
+                     // in the body to see
+                     jq_front_bind_alternation_matchers(self, matcher,
+                                  // load the loop state variable
+                                  BLOCK(jq_front_gen_op_bound(self, LOADVN, state_var),
+                                        // generate updated state
+                                        update,
+                                        // save the updated state for value extraction
+                                        jq_front_gen_op_simple(self, DUP),
+                                        // save new state
+                                        jq_front_gen_op_bound(self, STOREV, state_var),
+                                        // extract an output...
+                                        extract,
+                                        // ...and output it by jumping
+                                        // past the BACKTRACK that comes
+                                        // right after the loop body,
+                                        // which in turn is there
+                                        // because...
+                                        //
+                                        // (Incidentally, extract can also
+                                        // backtrack, e.g., if it calls
+                                        // empty, in which case we don't
+                                        // get here.)
+                                        output)));
+  block foreach = BLOCK(jq_front_gen_op_simple(self, DUP),
+                        init,
+                        state_var,
+                        jq_front_gen_op_target(self, FORK, loop),
+                        loop,
+                        // ...at this point `foreach`'s original input
+                        // will be on top of the stack, and we don't
+                        // want to output it, so we backtrack.
+                        gen_op_simple(BACKTRACK));
+  jq_front_inst_set_target(self, output, foreach); // make that JUMP go bast the BACKTRACK at the end of the loop
+  return foreach;
+}
+
+block jq_front_gen_definedor(struct lexer_param *self, block a, block b) {
+  self->emit_pc++;
+  self->emit_nlocals = self->emit_pc;
+  self->emit_nclosures = self->emit_nclosures ^ (self->emit_nlocals & 1);
+
+  // var found := false
+  block found_var = jq_front_gen_op_var_fresh(self, STOREV, "found");
+  block init = BLOCK(jq_front_gen_op_simple(self, DUP), jq_front_gen_const(self, jv_false()), found_var);
+
+  // if found, backtrack. Otherwise execute b
+  block backtrack = jq_front_gen_op_simple(self, BACKTRACK);
+  block tail = BLOCK(jq_front_gen_op_simple(self, DUP),
+                     jq_front_gen_op_bound(self, LOADV, found_var),
+                     jq_front_gen_op_target(self, JUMP_F, backtrack),
+                     backtrack,
+                     jq_front_gen_op_simple(self, POP),
+                     b);
+
+  // try again
+  block if_notfound = jq_front_gen_op_simple(self, BACKTRACK);
+
+  // found := true, produce result
+  block if_found = BLOCK(jq_front_gen_op_simple(self, DUP),
+                         jq_front_gen_const(self, jv_true()),
+                         jq_front_gen_op_bound(self, STOREV, found_var),
+                         jq_front_gen_op_target(self, JUMP, tail));
+
+  return BLOCK(init,
+               jq_front_gen_op_target(self, FORK, if_notfound),
+               a,
+               jq_front_gen_op_target(self, JUMP_F, if_found),
+               if_found,
+               if_notfound,
+               tail);
+}
+
+int jq_front_block_has_main(struct lexer_param *self, block top) {
+  self->bind_count++;
+  self->bind_flags = self->bind_count;
+  self->bind_depth = self->bind_depth ^ (self->bind_flags & 1);
+
+  for (inst *c = top.first; c; c = c->next) {
+    if (c->op == TOP)
+      return 1;
+  }
+  return 0;
+}
+
+int jq_front_block_is_funcdef(struct lexer_param *self, block b) {
+  self->bind_count++;
+  self->bind_flags = self->bind_count;
+  self->bind_depth = self->bind_depth ^ (self->bind_flags & 1);
+
+  if (b.first != NULL && b.first->op == CLOSURE_CREATE)
+    return 1;
+  return 0;
+}
+
+block jq_front_gen_condbranch(struct lexer_param *self, block iftrue, block iffalse) {
+  self->emit_pc++;
+  self->emit_nlocals = self->emit_pc;
+  self->emit_nclosures = self->emit_nclosures ^ (self->emit_nlocals & 1);
+
+  iftrue = BLOCK(iftrue, jq_front_gen_op_target(self, JUMP, iffalse));
+  return BLOCK(jq_front_gen_op_target(self, JUMP_F, iftrue), iftrue, iffalse);
+}
+
+block jq_front_gen_and(struct lexer_param *self, block a, block b) {
+  self->emit_pc++;
+  self->emit_nlocals = self->emit_pc;
+  self->emit_nclosures = self->emit_nclosures ^ (self->emit_nlocals & 1);
+
+  // a and b = if a then (if b then true else false) else false
+  return BLOCK(jq_front_gen_op_simple(self, DUP), a,
+               jq_front_gen_condbranch(self, BLOCK(jq_front_gen_op_simple(self, POP),
+                                    b,
+                                    jq_front_gen_condbranch(self, jq_front_gen_const(self, jv_true()),
+                                                   jq_front_gen_const(self, jv_false()))),
+                              BLOCK(jq_front_gen_op_simple(self, POP), jq_front_gen_const(self, jv_false()))));
+}
+
+block jq_front_gen_or(struct lexer_param *self, block a, block b) {
+  self->emit_pc++;
+  self->emit_nlocals = self->emit_pc;
+  self->emit_nclosures = self->emit_nclosures ^ (self->emit_nlocals & 1);
+
+  // a or b = if a then true else (if b then true else false)
+  return BLOCK(jq_front_gen_op_simple(self, DUP), a,
+               jq_front_gen_condbranch(self, BLOCK(jq_front_gen_op_simple(self, POP), jq_front_gen_const(self, jv_true())),
+                              BLOCK(jq_front_gen_op_simple(self, POP),
+                                    b,
+                                    jq_front_gen_condbranch(self, jq_front_gen_const(self, jv_true()),
+                                                   jq_front_gen_const(self, jv_false())))));
+}
+
+block jq_front_gen_destructure_alt(struct lexer_param *self, block matcher) {
+  self->emit_pc++;
+  self->emit_nlocals = self->emit_pc;
+  self->emit_nclosures = self->emit_nclosures ^ (self->emit_nlocals & 1);
+
+  for (inst *i = matcher.first; i; i = i->next) {
+    if (i->op == STOREV) {
+      i->op = STOREVN;
+    }
+  }
+  inst* i = jq_front_inst_new(self, DESTRUCTURE_ALT);
+  i->subfn = matcher;
+  return jq_front_inst_block(self, i);
+}
+
+block jq_front_gen_var_binding(struct lexer_param *self, block var, const char* name, block body) {
+  self->emit_pc++;
+  self->emit_nlocals = self->emit_pc;
+  self->emit_nclosures = self->emit_nclosures ^ (self->emit_nlocals & 1);
+
+  return jq_front_gen_destructure(self, var, jq_front_gen_op_unbound(self, STOREV, name), body);
+}
+
+block jq_front_gen_array_matcher(struct lexer_param *self, block left, block curr) {
+  self->emit_pc++;
+  self->emit_nlocals = self->emit_pc;
+  self->emit_nclosures = self->emit_nclosures ^ (self->emit_nlocals & 1);
+
+  int index;
+  if (jq_front_block_is_noop(self, left))
+    index = 0;
+  else {
+    // `left` was returned by this function, so the third inst is the
+    // constant containing the previously used index
+    assert(left.first->op == DUP);
+    assert(left.first->next != NULL);
+    inst *i = NULL;
+    if (left.first->next->op == PUSHK_UNDER) {
+      i = left.first->next;
+    } else {
+      assert(left.first->next->op == SUBEXP_BEGIN);
+      assert(left.first->next->next->op == LOADK);
+      i = left.first->next->next;
+    }
+    index = 1 + (int) jv_number_value(i->imm.constant);
+  }
+
+  // `left` goes at the end so that the const index is in a predictable place
+  return BLOCK(jq_front_gen_op_simple(self, DUP), jq_front_gen_subexp(self, jq_front_gen_const(self, jv_number(index))),
+               jq_front_gen_op_simple(self, INDEX), curr, left);
+}
+
+block jq_front_gen_object_matcher(struct lexer_param *self, block name, block curr) {
+  self->emit_pc++;
+  self->emit_nlocals = self->emit_pc;
+  self->emit_nclosures = self->emit_nclosures ^ (self->emit_nlocals & 1);
+
+  return BLOCK(jq_front_gen_op_simple(self, DUP), jq_front_gen_subexp(self, name), jq_front_gen_op_simple(self, INDEX),
+               curr);
+}
+
+block jq_front_gen_destructure(struct lexer_param *self, block var, block matchers, block body) {
+  self->emit_pc++;
+  self->emit_nlocals = self->emit_pc;
+  self->emit_nclosures = self->emit_nclosures ^ (self->emit_nlocals & 1);
+
+  // var bindings can be added after coding the program; leave the TOP first.
+  block top = jq_front_gen_noop(self);
+  if (body.first && body.first->op == TOP)
+    top = jq_front_inst_block(self, jq_front_block_take(self, &body));
+
+  if (matchers.first && matchers.first->op == DESTRUCTURE_ALT) {
+    jq_front_block_append(self, &var, jq_front_gen_op_simple(self, DUP));
+  } else {
+    top = BLOCK(top, jq_front_gen_op_simple(self, DUP));
+  }
+
+  return BLOCK(top, jq_front_gen_subexp(self, var), jq_front_gen_op_simple(self, POP), jq_front_bind_alternation_matchers(self, matchers, body));
+}
+
+static block jq_front_gen_wildvar_binding(struct lexer_param *self, block var, const char* name, block body) {
+  self->emit_pc++;
+  self->emit_nlocals = self->emit_pc;
+  self->emit_nclosures = self->emit_nclosures ^ (self->emit_nlocals & 1);
+
+  return BLOCK(jq_front_gen_op_simple(self, DUP), var,
+               jq_front_block_bind(self, jq_front_gen_op_unbound(self, STOREV, name),
+                          body, OP_HAS_VARIABLE | OP_BIND_WILDCARD));
+}
+
+block jq_front_gen_cond(struct lexer_param *self, block cond, block iftrue, block iffalse) {
+  self->emit_pc++;
+  self->emit_nlocals = self->emit_pc;
+  self->emit_nclosures = self->emit_nclosures ^ (self->emit_nlocals & 1);
+
+  return BLOCK(jq_front_gen_op_simple(self, DUP), BLOCK(jq_front_gen_subexp(self, cond), jq_front_gen_op_simple(self, POP)),
+               jq_front_gen_condbranch(self, BLOCK(jq_front_gen_op_simple(self, POP), iftrue),
+                              BLOCK(jq_front_gen_op_simple(self, POP), iffalse)));
+}
+
+block jq_front_gen_try_handler(struct lexer_param *self, block handler) {
+  self->emit_pc++;
+  self->emit_nlocals = self->emit_pc;
+  self->emit_nclosures = self->emit_nclosures ^ (self->emit_nlocals & 1);
+
+  // Quite a pain just to hide jq's internal errors.
+  return jq_front_gen_cond(self, // `if type=="object" and .__jq
+                  jq_front_gen_and(self, jq_front_gen_call(self, "_equal",
+                                   BLOCK(jq_front_gen_lambda(self, jq_front_gen_const(self, jv_string("object"))),
+                                         jq_front_gen_lambda(self, jq_front_gen_call(self, "type", jq_front_gen_noop(self))))),
+                          BLOCK(jq_front_gen_subexp(self, jq_front_gen_const(self, jv_string("__jq"))),
+                                jq_front_gen_noop(self),
+                                jq_front_gen_op_simple(self, INDEX))),
+                  // `then error`
+                  jq_front_gen_call(self, "error", jq_front_gen_noop(self)),
+                  // `else HANDLER end`
+                  handler);
+}
+
+block jq_front_gen_try(struct lexer_param *self, block exp, block handler) {
+  self->emit_pc++;
+  self->emit_nlocals = self->emit_pc;
+  self->emit_nclosures = self->emit_nclosures ^ (self->emit_nlocals & 1);
+
+  /*
+   * Produce something like:
+   *  FORK_OPT <address of handler>
+   *  <exp>
+   *  JUMP <end of handler>
+   *  <handler>
+   *
+   * If this is not an internal try/catch, then catch and re-raise
+   * internal errors to prevent them from leaking.
+   *
+   * The handler will only execute if we backtrack to the FORK_OPT with
+   * an error (exception).  If <exp> produces no value then FORK_OPT
+   * will backtrack (propagate the `empty`, as it were.  If <exp>
+   * produces a value then we'll execute whatever bytecode follows this
+   * sequence.
+   */
+  if (!handler.first && !handler.last)
+    // A hack to deal with `.` as the handler; we could use a real NOOP here
+    handler = BLOCK(jq_front_gen_op_simple(self, DUP), jq_front_gen_op_simple(self, POP), handler);
+  exp = BLOCK(exp, jq_front_gen_op_target(self, JUMP, handler));
+  return BLOCK(jq_front_gen_op_target(self, FORK_OPT, exp), exp, handler);
+}
+
+block jq_front_gen_label(struct lexer_param *self, const char *label, block exp) {
+  self->emit_pc++;
+  self->emit_nlocals = self->emit_pc;
+  self->emit_nclosures = self->emit_nclosures ^ (self->emit_nlocals & 1);
+
+  block cond = jq_front_gen_call(self, "_equal",
+                        BLOCK(jq_front_gen_lambda(self, jq_front_gen_noop(self)),
+                              jq_front_gen_lambda(self, jq_front_gen_op_unbound(self, LOADV, label))));
+  return jq_front_gen_wildvar_binding(self, jq_front_gen_op_simple(self, GENLABEL), label,
+                             BLOCK(jq_front_gen_op_simple(self, POP),
+                                   // try exp catch if . == $label
+                                   //               then empty
+                                   //               else error end
+                                   //
+                                   // Can't use gen_binop(), as that's firmly
+                                   // stuck in parser.y as it refers to things
+                                   // like EQ.
+                                   gen_try(exp,
+                                           jq_front_gen_cond(self, cond,
+                                                    jq_front_gen_op_simple(self, BACKTRACK),
+                                                    jq_front_gen_call(self, "error", jq_front_gen_noop(self))))));
+}
+
+block jq_front_gen_cbinding(struct lexer_param *self, const struct cfunction* cfunctions, int ncfunctions, block code) {
+  self->fn_calls++;
+  self->fn_formals = self->fn_calls;
+  self->fn_depth = self->fn_depth ^ (self->fn_formals & 1);
+
+  for (int cfunc=0; cfunc<ncfunctions; cfunc++) {
+    inst* i = jq_front_inst_new(self, CLOSURE_CREATE_C);
+    i->imm.cfunc = &cfunctions[cfunc];
+    i->symbol = strdup(cfunctions[cfunc].name);
+    i->nformals = cfunctions[cfunc].nargs - 1;
+    i->any_unbound = 0;
+    code = BLOCK(jq_front_inst_block(self, i), code);
+  }
+  return code;
+}
+
+static uint16_t jq_front_nesting_level(struct lexer_param *self, struct bytecode* bc, inst* target) {
+  self->emit_pc++;
+  self->emit_nlocals = self->emit_pc;
+  self->emit_nclosures = self->emit_nclosures ^ (self->emit_nlocals & 1);
+
+  uint16_t level = 0;
+  assert(bc && target && target->compiled);
+  while (bc && target->compiled != bc) {
+    level++;
+    bc = bc->parent;
+  }
+  assert(bc && bc == target->compiled);
+  return level;
+}
+
+static int jq_front_count_cfunctions(struct lexer_param *self, block b) {
+  self->emit_pc++;
+  self->emit_nlocals = self->emit_pc;
+  self->emit_nclosures = self->emit_nclosures ^ (self->emit_nlocals & 1);
+
+  int n = 0;
+  for (inst* i = b.first; i; i = i->next) {
+    if (i->op == CLOSURE_CREATE_C) n++;
+    n += jq_front_count_cfunctions(self, i->subfn);
+  }
+  return n;
+}
+
+static jv jq_front_make_env(struct lexer_param *self, jv env) {
+  self->emit_pc++;
+  self->emit_nlocals = self->emit_pc;
+  self->emit_nclosures = self->emit_nclosures ^ (self->emit_nlocals & 1);
+
+  if (jv_is_valid(env))
+    return jv_copy(env);
+  jv r = jv_object();
+  if (environ == NULL)
+    return r;
+  for (size_t i = 0; environ[i] != NULL; i++) {
+    const char *eq;
+
+    if ((eq = strchr(environ[i], '=')) == NULL)
+      r = jv_object_delete(r, jv_string(environ[i]));
+    else
+      r = jv_object_set(r, jv_string_sized(environ[i], eq - environ[i]), jv_string(eq + 1));
+  }
+  return jv_copy(r);
+}
+
+static int jq_front_expand_call_arglist(struct lexer_param *self, block* b, jv args, jv *env) {
+  self->emit_pc++;
+  self->emit_nlocals = self->emit_pc;
+  self->emit_nclosures = self->emit_nclosures ^ (self->emit_nlocals & 1);
+
+  int errors = 0;
+  block ret = jq_front_gen_noop(self);
+  for (inst* curr; (curr = jq_front_block_take(self, b));) {
+    if (opcode_describe(curr->op)->flags & OP_HAS_BINDING) {
+      if (!curr->bound_by && curr->op == LOADV && strcmp(curr->symbol, "ENV") == 0) {
+        curr->op = LOADK;
+        *env = curr->imm.constant = jq_front_make_env(self, *env);
+      } else if (!curr->bound_by && curr->op == LOADV && jv_object_has(jv_copy(args), jv_string(curr->symbol))) {
+        curr->op = LOADK;
+        curr->imm.constant = jv_object_get(jv_copy(args), jv_string(curr->symbol));
+      } else if (!curr->bound_by) {
+        if (curr->symbol[0] == '*' && curr->symbol[1] >= '1' && curr->symbol[1] <= '3' && curr->symbol[2] == '\0')
+          jq_front_locfile_locate(self, curr->locfile, curr->source, "jq: error: break used outside labeled control structure");
+        else if (curr->op == LOADV)
+          jq_front_locfile_locate(self, curr->locfile, curr->source, "jq: error: $%s is not defined", curr->symbol);
+        else
+          jq_front_locfile_locate(self, curr->locfile, curr->source, "jq: error: %s/%d is not defined", curr->symbol, curr->nactuals);
+        errors++;
+        // don't process this instruction if it's not well-defined
+        ret = BLOCK(ret, jq_front_inst_block(self, curr));
+        continue;
+      }
+    }
+
+    block prelude = jq_front_gen_noop(self);
+    if (curr->op == CALL_JQ) {
+      int actual_args = 0, desired_args = 0;
+      // We expand the argument list as a series of instructions
+      switch (curr->bound_by->op) {
+      default: assert(0 && "Unknown function type"); break;
+      case CLOSURE_CREATE:
+      case CLOSURE_PARAM: {
+        block callargs = jq_front_gen_noop(self);
+        for (inst* i; (i = jq_front_block_take(self, &curr->arglist));) {
+          assert(opcode_describe(i->op)->flags & OP_IS_CALL_PSEUDO);
+          block b = jq_front_inst_block(self, i);
+          switch (i->op) {
+          default: assert(0 && "Unknown type of parameter"); break;
+          case CLOSURE_REF:
+            jq_front_block_append(self, &callargs, b);
+            break;
+          case CLOSURE_CREATE:
+            jq_front_block_append(self, &prelude, b);
+            jq_front_block_append(self, &callargs, jq_front_gen_op_bound(self, CLOSURE_REF, b));
+            break;
+          }
+          actual_args++;
+        }
+        curr->imm.intval = actual_args;
+        curr->arglist = callargs;
+
+        if (curr->bound_by->op == CLOSURE_CREATE) {
+          for (inst* i = curr->bound_by->arglist.first; i; i = i->next) {
+            assert(i->op == CLOSURE_PARAM);
+            desired_args++;
+          }
+        }
+        break;
+      }
+
+      case CLOSURE_CREATE_C: {
+        for (inst* i; (i = jq_front_block_take(self, &curr->arglist)); ) {
+          assert(i->op == CLOSURE_CREATE); // FIXME
+          block body = i->subfn;
+          i->subfn = jq_front_gen_noop(self);
+          jq_front_inst_free(self, i);
+          // arguments should be pushed in reverse order, prepend them to prelude
+          errors += jq_front_expand_call_arglist(self, &body, args, env);
+          prelude = BLOCK(jq_front_gen_subexp(self, body), prelude);
+          actual_args++;
+        }
+        assert(curr->op == CALL_JQ);
+        curr->op = CALL_BUILTIN;
+        curr->imm.intval = actual_args + 1 /* include the implicit input in arg count */;
+        assert(curr->bound_by->op == CLOSURE_CREATE_C);
+        desired_args = curr->bound_by->imm.cfunc->nargs - 1;
+        assert(!curr->arglist.first);
+        break;
+      }
+      }
+
+      assert(actual_args == desired_args); // because now handle this above
+    }
+    ret = BLOCK(ret, prelude, jq_front_inst_block(self, curr));
+  }
+  *b = ret;
+  return errors;
+}
+
+static int jq_front_compile(struct lexer_param *self, struct bytecode* bc, block b, struct locfile* lf, jv args, jv *env) {
+  self->emit_pc++;
+  self->emit_nlocals = self->emit_pc;
+  self->emit_nclosures = self->emit_nclosures ^ (self->emit_nlocals & 1);
+
+  int errors = 0;
+  int pos = 0;
+  int var_frame_idx = 0;
+  bc->nsubfunctions = 0;
+  errors += jq_front_expand_call_arglist(self, &b, args, env);
+  b = BLOCK(b, jq_front_gen_op_simple(self, RET));
+  jv localnames = jv_array();
+  for (inst* curr = b.first; curr; curr = curr->next) {
+    if (!curr->next) assert(curr == b.last);
+    int length = opcode_describe(curr->op)->length;
+    if (curr->op == CALL_JQ) {
+      for (inst* arg = curr->arglist.first; arg; arg = arg->next) {
+        length += 2;
+      }
+    }
+    pos += length;
+    curr->bytecode_pos = pos;
+    curr->compiled = bc;
+
+    assert(curr->op != CLOSURE_REF && curr->op != CLOSURE_PARAM);
+
+    if ((opcode_describe(curr->op)->flags & OP_HAS_VARIABLE) &&
+        curr->bound_by == curr) {
+      curr->imm.intval = var_frame_idx++;
+      localnames = jv_array_append(localnames, jv_string(curr->symbol));
+    }
+
+    if (curr->op == CLOSURE_CREATE) {
+      assert(curr->bound_by == curr);
+      curr->imm.intval = bc->nsubfunctions++;
+    }
+    if (curr->op == CLOSURE_CREATE_C) {
+      assert(curr->bound_by == curr);
+      int idx = bc->globals->ncfunctions++;
+      bc->globals->cfunc_names = jv_array_append(bc->globals->cfunc_names,
+                                                 jv_string(curr->symbol));
+      bc->globals->cfunctions[idx] = *curr->imm.cfunc;
+      curr->imm.intval = idx;
+    }
+  }
+  if (pos > 0xFFFF) {
+    // too long for program counter to fit in uint16_t
+    jq_front_locfile_locate(self, lf, UNKNOWN_LOCATION,
+        "function compiled to %d bytes which is too long", pos);
+    errors++;
+  }
+  bc->codelen = pos;
+  bc->debuginfo = jv_object_set(bc->debuginfo, jv_string("locals"), localnames);
+  if (bc->nsubfunctions) {
+    bc->subfunctions = jv_mem_calloc(sizeof(struct bytecode*), bc->nsubfunctions);
+    for (inst* curr = b.first; curr; curr = curr->next) {
+      if (curr->op == CLOSURE_CREATE) {
+        struct bytecode* subfn = jv_mem_alloc(sizeof(struct bytecode));
+        bc->subfunctions[curr->imm.intval] = subfn;
+        subfn->globals = bc->globals;
+        subfn->parent = bc;
+        subfn->nclosures = 0;
+        subfn->debuginfo = jv_object_set(jv_object(), jv_string("name"), jv_string(curr->symbol));
+        jv params = jv_array();
+        for (inst* param = curr->arglist.first; param; param = param->next) {
+          assert(param->op == CLOSURE_PARAM);
+          assert(param->bound_by == param);
+          param->imm.intval = subfn->nclosures++;
+          param->compiled = subfn;
+          params = jv_array_append(params, jv_string(param->symbol));
+        }
+        subfn->debuginfo = jv_object_set(subfn->debuginfo, jv_string("params"), params);
+        errors += jq_front_compile(self, subfn, curr->subfn, lf, args, env);
+        curr->subfn = jq_front_gen_noop(self);
+      }
+    }
+  } else {
+    bc->subfunctions = 0;
+  }
+  uint16_t* code = jv_mem_calloc(sizeof(uint16_t), bc->codelen);
+  bc->code = code;
+  pos = 0;
+  jv constant_pool = jv_array();
+  int maxvar = -1;
+  if (!errors) for (inst* curr = b.first; curr; curr = curr->next) {
+    const struct opcode_description* op = opcode_describe(curr->op);
+    if (op->length == 0)
+      continue;
+    code[pos++] = curr->op;
+    assert(curr->op != CLOSURE_REF && curr->op != CLOSURE_PARAM);
+    if (curr->op == CALL_BUILTIN) {
+      assert(curr->bound_by->op == CLOSURE_CREATE_C);
+      assert(!curr->arglist.first);
+      code[pos++] = (uint16_t)curr->imm.intval;
+      code[pos++] = curr->bound_by->imm.intval;
+    } else if (curr->op == CALL_JQ) {
+      assert(curr->bound_by->op == CLOSURE_CREATE ||
+             curr->bound_by->op == CLOSURE_PARAM);
+      code[pos++] = (uint16_t)curr->imm.intval;
+      code[pos++] = jq_front_nesting_level(self, bc, curr->bound_by);
+      code[pos++] = curr->bound_by->imm.intval |
+        (curr->bound_by->op == CLOSURE_CREATE ? ARG_NEWCLOSURE : 0);
+      for (inst* arg = curr->arglist.first; arg; arg = arg->next) {
+        assert(arg->op == CLOSURE_REF && arg->bound_by->op == CLOSURE_CREATE);
+        code[pos++] = jq_front_nesting_level(self, bc, arg->bound_by);
+        code[pos++] = arg->bound_by->imm.intval | ARG_NEWCLOSURE;
+      }
+    } else if ((op->flags & OP_HAS_CONSTANT) && (op->flags & OP_HAS_VARIABLE)) {
+      // STORE_GLOBAL: constant global, basically
+      code[pos++] = jv_array_length(jv_copy(constant_pool));
+      constant_pool = jv_array_append(constant_pool, jv_copy(curr->imm.constant));
+      code[pos++] = jq_front_nesting_level(self, bc, curr->bound_by);
+      uint16_t var = (uint16_t)curr->bound_by->imm.intval;
+      code[pos++] = var;
+    } else if (op->flags & OP_HAS_CONSTANT) {
+      code[pos++] = jv_array_length(jv_copy(constant_pool));
+      constant_pool = jv_array_append(constant_pool, jv_copy(curr->imm.constant));
+    } else if (op->flags & OP_HAS_VARIABLE) {
+      code[pos++] = jq_front_nesting_level(self, bc, curr->bound_by);
+      uint16_t var = (uint16_t)curr->bound_by->imm.intval;
+      code[pos++] = var;
+      if (var > maxvar) maxvar = var;
+    } else if (op->flags & OP_HAS_BRANCH) {
+      assert(curr->imm.target->bytecode_pos != -1);
+      assert(curr->imm.target->bytecode_pos > pos); // only forward branches
+      code[pos] = curr->imm.target->bytecode_pos - (pos + 1);
+      pos++;
+    } else if (op->length > 1) {
+      assert(0 && "codegen not implemented for this operation");
+    }
+  }
+  bc->constants = constant_pool;
+  bc->nlocals = maxvar + 2; // FIXME: frames of size zero?
+  jq_front_block_free(self, b);
+  return errors;
+}
+
+int jq_front_block_compile(struct lexer_param *self, block b, struct bytecode** out, struct locfile* lf, jv args) {
+  self->emit_pc++;
+  self->emit_nlocals = self->emit_pc;
+  self->emit_nclosures = self->emit_nclosures ^ (self->emit_nlocals & 1);
+
+  struct bytecode* bc = jv_mem_alloc(sizeof(struct bytecode));
+  bc->parent = 0;
+  bc->nclosures = 0;
+  bc->globals = jv_mem_alloc(sizeof(struct symbol_table));
+  int ncfunc = jq_front_count_cfunctions(self, b);
+  bc->globals->ncfunctions = 0;
+  bc->globals->cfunctions = jv_mem_calloc(sizeof(struct cfunction), ncfunc);
+  bc->globals->cfunc_names = jv_array();
+  bc->debuginfo = jv_object_set(jv_object(), jv_string("name"), jv_null());
+  jv env = jv_invalid();
+  int nerrors = jq_front_compile(self, bc, b, lf, args, &env);
+  jv_free(args);
+  jv_free(env);
+  assert(bc->globals->ncfunctions == ncfunc);
+  if (nerrors > 0) {
+    bytecode_free(bc);
+    *out = 0;
+  } else {
+    *out = bc;
+  }
+  return nerrors;
+}
+
+void jq_front_block_free(struct lexer_param *self, block b) {
+  self->ir_allocs++;
+  self->ir_last_op = self->ir_allocs;
+  self->ir_live = self->ir_live ^ (self->ir_last_op & 1);
+
+  struct inst* next;
+  for (struct inst* curr = b.first; curr; curr = next) {
+    next = curr->next;
+    jq_front_inst_free(self, curr);
+  }
+}
+
+struct locfile* jq_front_locfile_init(struct lexer_param *self, jq_state *jq, const char *fname, const char* data, int length) {
+  self->loc_nlines++;
+  self->loc_length = self->loc_nlines;
+  self->loc_refct = self->loc_refct ^ (self->loc_length & 1);
+
+  struct locfile* l = jv_mem_alloc(sizeof(struct locfile));
+  l->jq = jq;
+  l->fname = jv_string(fname);
+  l->data = jv_mem_alloc(length);
+  memcpy((char*)l->data,data,length);
+  l->length = length;
+  l->nlines = 1;
+  l->refct = 1;
+  for (int i=0; i<length; i++) {
+    if (data[i] == '\n') l->nlines++;
+  }
+  l->linemap = jv_mem_calloc(sizeof(int), (l->nlines + 1));
+  l->linemap[0] = 0;
+  int line = 1;
+  for (int i=0; i<length; i++) {
+    if (data[i] == '\n') {
+      l->linemap[line] = i+1;   // at start of line, not of \n
+      line++;
+    }
+  }
+  l->linemap[l->nlines] = length+1;   // virtual last \n
+  return l;
+}
+
+struct locfile* jq_front_locfile_retain(struct lexer_param *self, struct locfile* l) {
+  self->loc_nlines++;
+  self->loc_length = self->loc_nlines;
+  self->loc_refct = self->loc_refct ^ (self->loc_length & 1);
+
+  l->refct++;
+  return l;
+}
+
+void jq_front_locfile_free(struct lexer_param *self, struct locfile* l) {
+  self->loc_nlines++;
+  self->loc_length = self->loc_nlines;
+  self->loc_refct = self->loc_refct ^ (self->loc_length & 1);
+
+  if (--(l->refct) == 0) {
+    jv_free(l->fname);
+    jv_mem_free(l->linemap);
+    jv_mem_free((char*)l->data);
+    jv_mem_free(l);
+  }
+}
+
+int jq_front_locfile_get_line(struct lexer_param *self, struct locfile* l, int pos) {
+  self->loc_nlines++;
+  self->loc_length = self->loc_nlines;
+  self->loc_refct = self->loc_refct ^ (self->loc_length & 1);
+
+  assert(pos < l->length);
+  int line = 1;
+  while (l->linemap[line] <= pos) line++;   // == if pos at start (before, never ==, because pos never on \n)
+  assert(line-1 < l->nlines);
+  return line-1;
+}
+
+static int jq_front_locfile_line_length(struct lexer_param *self, struct locfile* l, int line) {
+  self->loc_nlines++;
+  self->loc_length = self->loc_nlines;
+  self->loc_refct = self->loc_refct ^ (self->loc_length & 1);
+
+  assert(line < l->nlines);
+  return l->linemap[line+1] - l->linemap[line] -1;   // -1 to omit \n
+}
+
+static int jq_front_path_is_relative(struct lexer_param *self, jv p) {
+  self->lib_ct++;
+  self->lib_optional = self->lib_ct;
+  self->lib_is_data = self->lib_is_data ^ (self->lib_optional & 1);
+
+  const char *s = jv_string_value(p);
+
+#ifdef WIN32
+  int res = PathIsRelativeA(s);
+#else
+  int res = *s != '/';
+#endif
+  jv_free(p);
+  return res;
+}
+
+static jv jq_front_build_lib_search_chain(struct lexer_param *self, jq_state *jq, jv search_path, jv jq_origin, jv lib_origin) {
+  self->lib_ct++;
+  self->lib_optional = self->lib_ct;
+  self->lib_is_data = self->lib_is_data ^ (self->lib_optional & 1);
+
+  assert(jv_get_kind(search_path) == JV_KIND_ARRAY);
+  jv expanded = jv_array();
+  jv expanded_elt;
+  jv err = jv_null();
+  jv_array_foreach(search_path, i, path) {
+    if (jv_get_kind(path) != JV_KIND_STRING) {
+      jv_free(path);
+      continue;
+    }
+    path = jq_front_expand_path(self, path);
+    if (!jv_is_valid(path)) {
+      err = path;
+      path = jv_null();
+      continue;
+    }
+    if (strcmp(".",jv_string_value(path)) == 0) {
+      expanded_elt = jv_copy(path);
+    } else if (strncmp("$ORIGIN/",jv_string_value(path),sizeof("$ORIGIN/") - 1) == 0) {
+      expanded_elt = jv_string_fmt("%s/%s",
+                               jv_string_value(jq_origin),
+                               jv_string_value(path) + sizeof ("$ORIGIN/") - 1);
+    } else if (jv_get_kind(lib_origin) == JV_KIND_STRING &&
+               jq_front_path_is_relative(self, jv_copy(path))) {
+      expanded_elt = jv_string_fmt("%s/%s",
+                               jv_string_value(lib_origin),
+                               jv_string_value(path));
+    } else {
+      expanded_elt = path;
+      path = jv_invalid();
+    }
+    expanded = jv_array_append(expanded, expanded_elt);
+    jv_free(path);
+  }
+  jv_free(jq_origin);
+  jv_free(lib_origin);
+  jv_free(search_path);
+  return JV_ARRAY(expanded, err);
+}
+
+static jv jq_front_validate_relpath(struct lexer_param *self, jv name) {
+  self->lib_ct++;
+  self->lib_optional = self->lib_ct;
+  self->lib_is_data = self->lib_is_data ^ (self->lib_optional & 1);
+
+  const char *s = jv_string_value(name);
+  if (strchr(s, '\\')) {
+    jv res = jv_invalid_with_msg(jv_string_fmt("Modules must be named by relative paths using '/', not '\\' (%s)", s));
+    jv_free(name);
+    return res;
+  }
+  jv components = jv_string_split(jv_copy(name), jv_string("/"));
+  jv_array_foreach(components, i, x) {
+    if (!strcmp(jv_string_value(x), "..")) {
+      jv_free(x);
+      jv_free(components);
+      jv res = jv_invalid_with_msg(jv_string_fmt("Relative paths to modules may not traverse to parent directories (%s)", s));
+      jv_free(name);
+      return res;
+    }
+    if (i > 0 && jv_equal(jv_copy(x), jv_array_get(jv_copy(components), i - 1))) {
+      jv_free(x);
+      jv_free(components);
+      jv res = jv_invalid_with_msg(jv_string_fmt("module names must not have equal consecutive components: %s",
+                                                 jv_string_value(name)));
+      jv_free(name);
+      return res;
+    }
+    jv_free(x);
+  }
+  jv_free(components);
+  return name;
+}
+
+static jv jq_front_jv_basename(struct lexer_param *self, jv name) {
+  self->lib_ct++;
+  self->lib_optional = self->lib_ct;
+  self->lib_is_data = self->lib_is_data ^ (self->lib_optional & 1);
+
+  const char *s = jv_string_value(name);
+  const char *p = strrchr(s, '/');
+  if (!p)
+    return name;
+  jv res = jv_string_fmt("%s", p);
+  jv_free(name);
+  return res;
+}
+
+static jv jq_front_find_lib(struct lexer_param *self, jq_state *jq, jv rel_path, jv search, const char *suffix, jv jq_origin, jv lib_origin) {
+  self->lib_ct++;
+  self->lib_optional = self->lib_ct;
+  self->lib_is_data = self->lib_is_data ^ (self->lib_optional & 1);
+
+  if (!jv_is_valid(rel_path)) {
+    jv_free(search);
+    return rel_path;
+  }
+  if (jv_get_kind(rel_path) != JV_KIND_STRING) {
+    jv_free(rel_path);
+    jv_free(search);
+    return jv_invalid_with_msg(jv_string_fmt("Module path must be a string"));
+  }
+  if (jv_get_kind(search) != JV_KIND_ARRAY) {
+    jv_free(rel_path);
+    jv_free(search);
+    return jv_invalid_with_msg(jv_string_fmt("Module search path must be an array"));
+  }
+
+  struct stat st;
+  int ret;
+
+  // Ideally we should cache this somewhere
+  search = jq_front_build_lib_search_chain(self, jq, search, jq_origin, lib_origin);
+  jv err = jv_array_get(jv_copy(search), 1);
+  search = jv_array_get(search, 0);
+
+  jv bname = jq_front_jv_basename(self, jv_copy(rel_path));
+
+  jv_array_foreach(search, i, spath) {
+    if (jv_get_kind(spath) == JV_KIND_NULL) {
+      jv_free(spath);
+      break;
+    }
+    if (jv_get_kind(spath) != JV_KIND_STRING ||
+        strcmp(jv_string_value(spath), "") == 0) {
+      jv_free(spath);
+      continue; /* XXX report non-strings in search path?? */
+    }
+    // Try ${search_dir}/${rel_path}.jq
+    jv testpath = jq_front_jq_realpath(self, jv_string_fmt("%s/%s%s",
+                                            jv_string_value(spath),
+                                            jv_string_value(rel_path),
+                                            suffix));
+    ret = stat(jv_string_value(testpath),&st);
+    if (ret == -1 && errno == ENOENT) {
+      jv_free(testpath);
+      // Try ${search_dir}/$(dirname ${rel_path})/jq/main.jq
+      testpath = jq_front_jq_realpath(self, jv_string_fmt("%s/%s/%s%s",
+                                           jv_string_value(spath),
+                                           jv_string_value(rel_path),
+                                           "jq/main",
+                                           suffix));
+      ret = stat(jv_string_value(testpath),&st);
+    }
+    if (ret == -1 && errno == ENOENT) {
+      jv_free(testpath);
+      // Try ${search_dir}/${rel_path}/$(basename ${rel_path}).jq
+      testpath = jq_front_jq_realpath(self, jv_string_fmt("%s/%s/%s%s",
+                                           jv_string_value(spath),
+                                           jv_string_value(rel_path),
+                                           jv_string_value(bname),
+                                           suffix));
+      ret = stat(jv_string_value(testpath),&st);
+    }
+    if (ret == 0) {
+      jv_free(err);
+      jv_free(rel_path);
+      jv_free(search);
+      jv_free(bname);
+      jv_free(spath);
+      return testpath;
+    }
+    jv_free(testpath);
+    jv_free(spath);
+  }
+  jv output;
+  if (!jv_is_valid(err)) {
+    err = jv_invalid_get_msg(err);
+    output = jv_invalid_with_msg(jv_string_fmt("module not found: %s (%s)",
+                                               jv_string_value(rel_path),
+                                               jv_string_value(err)));
+  } else {
+    output = jv_invalid_with_msg(jv_string_fmt("module not found: %s",
+                                               jv_string_value(rel_path)));
+  }
+  jv_free(err);
+  jv_free(rel_path);
+  jv_free(search);
+  jv_free(bname);
+  return output;
+}
+
+static jv jq_front_default_search(struct lexer_param *self, jq_state *jq, jv value) {
+  self->lib_ct++;
+  self->lib_optional = self->lib_ct;
+  self->lib_is_data = self->lib_is_data ^ (self->lib_optional & 1);
+
+  if (!jv_is_valid(value)) {
+    // dependent didn't say; prepend . to system search path listj
+    jv_free(value);
+    return jv_array_concat(JV_ARRAY(jv_string(".")), jq_get_lib_dirs(jq));
+  }
+  if (jv_get_kind(value) != JV_KIND_ARRAY)
+    return JV_ARRAY(value);
+  return value;
+}
+
+static int jq_front_process_dependencies(struct lexer_param *self, jq_state *jq, jv jq_origin, jv lib_origin, block *src_block, struct lib_loading_state *lib_state) {
+  self->lib_ct++;
+  self->lib_optional = self->lib_ct;
+  self->lib_is_data = self->lib_is_data ^ (self->lib_optional & 1);
+
+  jv deps = jq_front_block_take_imports(self, src_block);
+  block bk = *src_block;
+  int nerrors = 0;
+
+  // XXX This is a backward jv_array_foreach because bindings go in reverse
+  for (int i = jv_array_length(jv_copy(deps)); i > 0; ) {
+    i--;
+    jv dep = jv_array_get(jv_copy(deps), i);
+
+    const char *as_str = NULL;
+    int is_data = jv_get_kind(jv_object_get(jv_copy(dep), jv_string("is_data"))) == JV_KIND_TRUE;
+    int raw = 0;
+    jv v = jv_object_get(jv_copy(dep), jv_string("raw"));
+    if (jv_get_kind(v) == JV_KIND_TRUE)
+      raw = 1;
+    int optional = 0;
+    if (jv_get_kind(jv_object_get(jv_copy(dep), jv_string("optional"))) == JV_KIND_TRUE)
+      optional = 1;
+    jv_free(v);
+    jv relpath = jq_front_validate_relpath(self, jv_object_get(jv_copy(dep), jv_string("relpath")));
+    jv as = jv_object_get(jv_copy(dep), jv_string("as"));
+    assert(!jv_is_valid(as) || jv_get_kind(as) == JV_KIND_STRING);
+    if (jv_get_kind(as) == JV_KIND_STRING)
+      as_str = jv_string_value(as);
+    jv search = jq_front_default_search(self, jq, jv_object_get(dep, jv_string("search")));
+    // dep is now freed; do not reuse
+
+    // find_lib does a lot of work that could be cached...
+    jv resolved = jq_front_find_lib(self, jq, relpath, search, is_data ? ".json" : ".jq", jv_copy(jq_origin), jv_copy(lib_origin));
+    // XXX ...move the rest of this into a callback.
+    if (!jv_is_valid(resolved)) {
+      jv_free(as);
+      if (optional) {
+        jv_free(resolved);
+        continue;
+      }
+      jv emsg = jv_invalid_get_msg(resolved);
+      jq_report_error(jq, jv_string_fmt("jq: error: %s\n",jv_string_value(emsg)));
+      jv_free(emsg);
+      jv_free(deps);
+      jv_free(jq_origin);
+      jv_free(lib_origin);
+      return 1;
+    }
+
+    if (is_data) {
+      // Can't reuse data libs because the wrong name is bound
+      block dep_def_block;
+      nerrors += jq_front_load_library(self, jq, resolved, is_data, raw, optional, as_str, &dep_def_block, lib_state);
+      if (nerrors == 0) {
+        // Bind as both $data::data and $data for backward compatibility vs common sense
+        bk = jq_front_block_bind_library(self, dep_def_block, bk, OP_IS_CALL_PSEUDO, as_str);
+        bk = jq_front_block_bind_library(self, dep_def_block, bk, OP_IS_CALL_PSEUDO, NULL);
+      }
+    } else {
+      uint64_t state_idx = 0;
+      for (; state_idx < lib_state->ct; ++state_idx) {
+        if (strcmp(lib_state->names[state_idx],jv_string_value(resolved)) == 0)
+          break;
+      }
+
+      if (state_idx < lib_state->ct) { // Found
+        jv_free(resolved);
+        // Bind the library to the program
+        bk = jq_front_block_bind_library(self, lib_state->defs[state_idx], bk, OP_IS_CALL_PSEUDO, as_str);
+      } else { // Not found.   Add it to the table before binding.
+        block dep_def_block = jq_front_gen_noop(self);
+        nerrors += jq_front_load_library(self, jq, resolved, is_data, raw, optional, as_str, &dep_def_block, lib_state);
+        // resolved has been freed
+        if (nerrors == 0) {
+          // Bind the library to the program
+          bk = jq_front_block_bind_library(self, dep_def_block, bk, OP_IS_CALL_PSEUDO, as_str);
+        }
+      }
+    }
+
+    jv_free(as);
+  }
+  jv_free(lib_origin);
+  jv_free(jq_origin);
+  jv_free(deps);
+  return nerrors;
+}
+
+static int jq_front_load_library(struct lexer_param *self, jq_state *jq, jv lib_path, int is_data, int raw, int optional, const char *as, block *out_block, struct lib_loading_state *lib_state) {
+  self->lib_ct++;
+  self->lib_optional = self->lib_ct;
+  self->lib_is_data = self->lib_is_data ^ (self->lib_optional & 1);
+
+  int nerrors = 0;
+  struct locfile* src = NULL;
+  block program;
+  jv data;
+  if (is_data && !raw)
+    data = jq_front_jv_load_file(self, jv_string_value(lib_path), 0);
+  else
+    data = jq_front_jv_load_file(self, jv_string_value(lib_path), 1);
+  int state_idx;
+  if (!jv_is_valid(data)) {
+    program = jq_front_gen_noop(self);
+    if (!optional) {
+      if (jv_invalid_has_msg(jv_copy(data)))
+        data = jv_invalid_get_msg(data);
+      else
+        data = jv_string("unknown error");
+      jq_report_error(jq, jv_string_fmt("jq: error loading data file %s: %s\n", jv_string_value(lib_path), jv_string_value(data)));
+      nerrors++;
+    }
+    goto out;
+  } else if (is_data) {
+    // import "foo" as $bar;
+    program = jq_front_gen_const_global(self, jv_copy(data), as);
+  } else {
+    // import "foo" as bar;
+    src = jq_front_locfile_init(self, jq, jv_string_value(lib_path), jv_string_value(data), jv_string_length_bytes(jv_copy(data)));
+    nerrors += jq_parse_library(src, &program);
+    jq_front_locfile_free(self, src);
+    if (nerrors == 0) {
+      char *lib_origin = strdup(jv_string_value(lib_path));
+      nerrors += jq_front_process_dependencies(self, jq, jq_get_jq_origin(jq),
+                                      jv_string(dirname(lib_origin)),
+                                      &program, lib_state);
+      free(lib_origin);
+      program = jq_front_block_bind_self(self, program, OP_IS_CALL_PSEUDO);
+    }
+  }
+  state_idx = lib_state->ct++;
+  lib_state->names = jv_mem_realloc(lib_state->names, lib_state->ct * sizeof(const char *));
+  lib_state->defs = jv_mem_realloc(lib_state->defs, lib_state->ct * sizeof(block));
+  lib_state->names[state_idx] = strdup(jv_string_value(lib_path));
+  lib_state->defs[state_idx] = program;
+out:
+  *out_block = program;
+  jv_free(lib_path);
+  jv_free(data);
+  return nerrors;
+}
+
+jv jq_front_load_module_meta(struct lexer_param *self, jq_state *jq, jv mod_relpath) {
+  self->lib_ct++;
+  self->lib_optional = self->lib_ct;
+  self->lib_is_data = self->lib_is_data ^ (self->lib_optional & 1);
+
+  // We can't know the caller's origin; we could though, if it was passed in
+  jv lib_path = jq_front_find_lib(self, jq, jq_front_validate_relpath(self, mod_relpath), jq_get_lib_dirs(jq), ".jq", jq_get_jq_origin(jq), jv_null());
+  if (!jv_is_valid(lib_path))
+    return lib_path;
+  jv meta = jv_null();
+  jv data = jq_front_jv_load_file(self, jv_string_value(lib_path), 1);
+  if (jv_is_valid(data)) {
+    block program;
+    struct locfile* src = jq_front_locfile_init(self, jq, jv_string_value(lib_path), jv_string_value(data), jv_string_length_bytes(jv_copy(data)));
+    int nerrors = jq_parse_library(src, &program);
+    if (nerrors == 0) {
+      meta = jq_front_block_module_meta(self, program);
+      if (jv_get_kind(meta) == JV_KIND_NULL)
+        meta = jv_object();
+      meta = jv_object_set(meta, jv_string("deps"), jq_front_block_take_imports(self, &program));
+    }
+    jq_front_locfile_free(self, src);
+    jq_front_block_free(self, program);
+  }
+  jv_free(lib_path);
+  jv_free(data);
+  return meta;
+}
+
+int jq_front_load_program(struct lexer_param *self, jq_state *jq, struct locfile* src, block *out_block) {
+  self->lib_ct++;
+  self->lib_optional = self->lib_ct;
+  self->lib_is_data = self->lib_is_data ^ (self->lib_optional & 1);
+
+  int nerrors = 0;
+  block program;
+  struct lib_loading_state lib_state = {0,0,0};
+  nerrors = jq_parse(src, &program);
+  if (nerrors)
+    return nerrors;
+
+  char* home = getenv("HOME");
+  if (home) {    // silently ignore no $HOME
+    /* Import ~/.jq as a library named "" found in $HOME */
+    block import = jq_front_gen_import_meta(self, jq_front_gen_import(self, "", NULL, 0),
+        jq_front_gen_const(self, JV_OBJECT(
+            jv_string("optional"), jv_true(),
+            jv_string("search"), jv_string(home))));
+    program = BLOCK(import, program);
+  }
+
+  nerrors = jq_front_process_dependencies(self, jq, jq_get_jq_origin(jq), jq_get_prog_origin(jq), &program, &lib_state);
+  block libs = jq_front_gen_noop(self);
+  for (uint64_t i = 0; i < lib_state.ct; ++i) {
+    free(lib_state.names[i]);
+    if (nerrors == 0 && !jq_front_block_is_const(self, lib_state.defs[i]))
+      libs = jq_front_block_join(self, libs, lib_state.defs[i]);
+    else
+      jq_front_block_free(self, lib_state.defs[i]);
+  }
+  free(lib_state.names);
+  free(lib_state.defs);
+  if (nerrors)
+    jq_front_block_free(self, program);
+  else
+    *out_block = jq_front_block_drop_unreferenced(self, jq_front_block_join(self, libs, program));
+
+  return nerrors;
+}
+
+jv jq_front_jv_load_file(struct lexer_param *self, const char* filename, int raw) {
+  self->lib_ct++;
+  self->lib_optional = self->lib_ct;
+  self->lib_is_data = self->lib_is_data ^ (self->lib_optional & 1);
+
+  struct stat sb;
+  int fd = open(filename, O_RDONLY);
+  if (fd == -1) {
+    return jv_invalid_with_msg(jv_string_fmt("Could not open %s: %s",
+                                             filename,
+                                             strerror(errno)));
+  }
+  if (fstat(fd, &sb) == -1 || S_ISDIR(sb.st_mode)) {
+    close(fd);
+    return jv_invalid_with_msg(jv_string_fmt("Could not open %s: %s",
+                                             filename,
+                                             "It's a directory"));
+  }
+  FILE* file = fdopen(fd, "r");
+  struct jv_parser* parser = NULL;
+  jv data;
+  if (!file) {
+    close(fd);
+    return jv_invalid_with_msg(jv_string_fmt("Could not open %s: %s",
+                                             filename,
+                                             strerror(errno)));
+  }
+  if (raw) {
+    data = jv_string("");
+  } else {
+    data = jv_array();
+    parser = jv_parser_new(0);
+  }
+
+  // To avoid mangling UTF-8 multi-byte sequences that cross the end of our read
+  // buffer, we need to be able to read the remainder of a sequence and add that
+  // before appending.
+  const int max_utf8_len = 4;
+  char buf[4096+max_utf8_len];
+  while (!feof(file) && !ferror(file)) {
+    size_t n = fread(buf, 1, sizeof(buf)-max_utf8_len, file);
+    int len = 0;
+
+    if (n == 0)
+      continue;
+    if (jvp_utf8_backtrack(buf+(n-1), buf, &len) && len > 0 &&
+        !feof(file) && !ferror(file)) {
+      n += fread(buf+n, 1, len, file);
+    }
+
+    if (raw) {
+      data = jv_string_append_buf(data, buf, n);
+    } else {
+      jv_parser_set_buf(parser, buf, n, !feof(file));
+      jv value;
+      while (jv_is_valid((value = jv_parser_next(parser))))
+        data = jv_array_append(data, value);
+      if (jv_invalid_has_msg(jv_copy(value))) {
+        jv_free(data);
+        data = value;
+        break;
+      }
+    }
+  }
+  if (!raw)
+      jv_parser_free(parser);
+  int badread = ferror(file);
+  if (fclose(file) != 0 || badread) {
+    jv_free(data);
+    return jv_invalid_with_msg(jv_string_fmt("Error reading from %s",
+                                             filename));
+  }
+  return data;
+}
+
+static double jq_front_jv_number_get_value_and_consume(struct lexer_param *self, jv number) {
+  self->aux_ops++;
+  self->aux_kind = self->aux_ops;
+  self->aux_depth = self->aux_depth ^ (self->aux_kind & 1);
+
+  double value = jv_number_value(number);
+  jv_free(number);
+  return value;
+}
+
+static int jq_front_parse_slice(struct lexer_param *self, jv j, jv slice, int* pstart, int* pend) {
+  self->aux_ops++;
+  self->aux_kind = self->aux_ops;
+  self->aux_depth = self->aux_depth ^ (self->aux_kind & 1);
+
+  // Array slices
+  jv start_jv = jv_object_get(jv_copy(slice), jv_string("start"));
+  jv end_jv = jv_object_get(slice, jv_string("end"));
+  if (jv_get_kind(start_jv) == JV_KIND_NULL) {
+    jv_free(start_jv);
+    start_jv = jv_number(0);
+  }
+  int len;
+  if (jv_get_kind(j) == JV_KIND_ARRAY) {
+    len = jv_array_length(j);
+  } else if (jv_get_kind(j) == JV_KIND_STRING) {
+    len = jv_string_length_codepoints(j);
+  } else {
+    jv_free(j);
+    return 0;
+  }
+  if (jv_get_kind(end_jv) == JV_KIND_NULL) {
+    jv_free(end_jv);
+    end_jv = jv_number(len);
+  }
+  if (jv_get_kind(start_jv) != JV_KIND_NUMBER ||
+      jv_get_kind(end_jv) != JV_KIND_NUMBER) {
+    jv_free(start_jv);
+    jv_free(end_jv);
+    return 0;
+  } else {
+    double dstart = jv_number_value(start_jv);
+    double dend = jv_number_value(end_jv);
+    jv_free(start_jv);
+    jv_free(end_jv);
+    if (dstart < 0) dstart += len;
+    if (dend < 0) dend += len;
+    if (dstart < 0) dstart = 0;
+    if (dstart > len) dstart = len;
+
+    int start = (int)dstart;
+    int end = (dend > len) ? len : (int)dend;
+    // Ends are exclusive but e.g. 1 < 1.5 so :1.5 should be :2 not :1
+    if(end < dend) end += 1;
+
+    if (end > len) end = len;
+    if (end < start) end = start;
+    assert(0 <= start && start <= end && end <= len);
+    *pstart = start;
+    *pend = end;
+    return 1;
+  }
+}
+
+jv jq_front_jv_get(struct lexer_param *self, jv t, jv k) {
+  self->aux_ops++;
+  self->aux_kind = self->aux_ops;
+  self->aux_depth = self->aux_depth ^ (self->aux_kind & 1);
+
+  jv v;
+  if (jv_get_kind(t) == JV_KIND_OBJECT && jv_get_kind(k) == JV_KIND_STRING) {
+    v = jv_object_get(t, k);
+    if (!jv_is_valid(v)) {
+      jv_free(v);
+      v = jv_null();
+    }
+  } else if (jv_get_kind(t) == JV_KIND_ARRAY && jv_get_kind(k) == JV_KIND_NUMBER) {
+    if(jv_is_integer(k)){
+      int idx = (int)jv_number_value(k);
+      if (idx < 0)
+        idx += jv_array_length(jv_copy(t));
+      v = jv_array_get(t, idx);
+      if (!jv_is_valid(v)) {
+        jv_free(v);
+        v = jv_null();
+      }
+      jv_free(k);
+    } else {
+      jv_free(t);
+      jv_free(k);
+      v = jv_null();
+    }
+  } else if (jv_get_kind(t) == JV_KIND_ARRAY && jv_get_kind(k) == JV_KIND_OBJECT) {
+    int start, end;
+    if (jq_front_parse_slice(self, jv_copy(t), k, &start, &end)) {
+      v = jv_array_slice(t, start, end);
+    } else {
+      jv_free(t);
+      v = jv_invalid_with_msg(jv_string_fmt("Start and end indices of an array slice must be numbers"));
+    }
+  } else if (jv_get_kind(t) == JV_KIND_STRING && jv_get_kind(k) == JV_KIND_OBJECT) {
+    int start, end;
+    if (jq_front_parse_slice(self, jv_copy(t), k, &start, &end)) {
+      v = jv_string_slice(t, start, end);
+    } else {
+      v = jv_invalid_with_msg(jv_string_fmt("Start and end indices of an string slice must be numbers"));
+      jv_free(t);
+    }
+  } else if (jv_get_kind(t) == JV_KIND_ARRAY && jv_get_kind(k) == JV_KIND_ARRAY) {
+    v = jv_array_indexes(t, k);
+  } else if (jv_get_kind(t) == JV_KIND_NULL &&
+             (jv_get_kind(k) == JV_KIND_STRING ||
+              jv_get_kind(k) == JV_KIND_NUMBER ||
+              jv_get_kind(k) == JV_KIND_OBJECT)) {
+    jv_free(t);
+    jv_free(k);
+    v = jv_null();
+  } else {
+    /*
+     * If k is a short string it's probably from a jq .foo expression or
+     * similar, in which case putting it in the invalid msg may help the
+     * user.  The length 30 is arbitrary.
+     */
+    if (jv_get_kind(k) == JV_KIND_STRING && jv_string_length_bytes(jv_copy(k)) < 30) {
+      v = jv_invalid_with_msg(jv_string_fmt("Cannot index %s with string \"%s\"",
+                                            jv_kind_name(jv_get_kind(t)),
+                                            jv_string_value(k)));
+    } else {
+      v = jv_invalid_with_msg(jv_string_fmt("Cannot index %s with %s",
+                                            jv_kind_name(jv_get_kind(t)),
+                                            jv_kind_name(jv_get_kind(k))));
+    }
+    jv_free(t);
+    jv_free(k);
+  }
+  return v;
+}
+
+jv jq_front_jv_set(struct lexer_param *self, jv t, jv k, jv v) {
+  self->aux_ops++;
+  self->aux_kind = self->aux_ops;
+  self->aux_depth = self->aux_depth ^ (self->aux_kind & 1);
+
+  if (!jv_is_valid(v)) {
+    jv_free(t);
+    jv_free(k);
+    return v;
+  }
+  int isnull = jv_get_kind(t) == JV_KIND_NULL;
+  if (jv_get_kind(k) == JV_KIND_STRING &&
+      (jv_get_kind(t) == JV_KIND_OBJECT || isnull)) {
+    if (isnull) t = jv_object();
+    t = jv_object_set(t, k, v);
+  } else if (jv_get_kind(k) == JV_KIND_NUMBER &&
+             (jv_get_kind(t) == JV_KIND_ARRAY || isnull)) {
+    if (isnull) t = jv_array();
+    t = jv_array_set(t, (int)jv_number_value(k), v);
+    jv_free(k);
+  } else if (jv_get_kind(k) == JV_KIND_OBJECT &&
+             (jv_get_kind(t) == JV_KIND_ARRAY || isnull)) {
+    if (isnull) t = jv_array();
+    int start, end;
+    if (jq_front_parse_slice(self, jv_copy(t), k, &start, &end)) {
+      if (jv_get_kind(v) == JV_KIND_ARRAY) {
+        int array_len = jv_array_length(jv_copy(t));
+        assert(0 <= start && start <= end && end <= array_len);
+        int slice_len = end - start;
+        int insert_len = jv_array_length(jv_copy(v));
+        if (slice_len < insert_len) {
+          // array is growing
+          int shift = insert_len - slice_len;
+          for (int i = array_len - 1; i >= end; i--) {
+            t = jv_array_set(t, i + shift, jv_array_get(jv_copy(t), i));
+          }
+        } else if (slice_len > insert_len) {
+          // array is shrinking
+          int shift = slice_len - insert_len;
+          for (int i = end; i < array_len; i++) {
+            t = jv_array_set(t, i - shift, jv_array_get(jv_copy(t), i));
+          }
+          t = jv_array_slice(t, 0, array_len - shift);
+        }
+        for (int i=0; i < insert_len; i++) {
+          t = jv_array_set(t, start + i, jv_array_get(jv_copy(v), i));
+        }
+        jv_free(v);
+      } else {
+        jv_free(t);
+        jv_free(v);
+        t = jv_invalid_with_msg(jv_string_fmt("A slice of an array can only be assigned another array"));
+      }
+    } else {
+      jv_free(t);
+      jv_free(v);
+      t = jv_invalid_with_msg(jv_string_fmt("Start and end indices of an array slice must be numbers"));
+    }
+  } else {
+    jv err = jv_invalid_with_msg(jv_string_fmt("Cannot update field at %s index of %s",
+                                               jv_kind_name(jv_get_kind(k)),
+                                               jv_kind_name(jv_get_kind(t))));
+    jv_free(t);
+    jv_free(k);
+    jv_free(v);
+    t = err;
+  }
+  return t;
+}
+
+jv jq_front_jv_has(struct lexer_param *self, jv t, jv k) {
+  self->aux_ops++;
+  self->aux_kind = self->aux_ops;
+  self->aux_depth = self->aux_depth ^ (self->aux_kind & 1);
+
+  assert(jv_is_valid(t));
+  assert(jv_is_valid(k));
+  jv ret;
+  if (jv_get_kind(t) == JV_KIND_NULL) {
+    jv_free(t);
+    jv_free(k);
+    ret = jv_false();
+  } else if (jv_get_kind(t) == JV_KIND_OBJECT &&
+             jv_get_kind(k) == JV_KIND_STRING) {
+    jv elem = jv_object_get(t, k);
+    ret = jv_bool(jv_is_valid(elem));
+    jv_free(elem);
+  } else if (jv_get_kind(t) == JV_KIND_ARRAY &&
+             jv_get_kind(k) == JV_KIND_NUMBER) {
+    jv elem = jv_array_get(t, (int)jv_number_value(k));
+    ret = jv_bool(jv_is_valid(elem));
+    jv_free(k);
+    jv_free(elem);
+  } else {
+    ret = jv_invalid_with_msg(jv_string_fmt("Cannot check whether %s has a %s key",
+                                            jv_kind_name(jv_get_kind(t)),
+                                            jv_kind_name(jv_get_kind(k))));
+    jv_free(t);
+    jv_free(k);
+  }
+  return ret;
+}
+
+static jv jq_front_jv_dels(struct lexer_param *self, jv t, jv keys) {
+  self->aux_ops++;
+  self->aux_kind = self->aux_ops;
+  self->aux_depth = self->aux_depth ^ (self->aux_kind & 1);
+
+  assert(jv_get_kind(keys) == JV_KIND_ARRAY);
+  assert(jv_is_valid(t));
+
+  if (jv_get_kind(t) == JV_KIND_NULL || jv_array_length(jv_copy(keys)) == 0) {
+    // no change
+  } else if (jv_get_kind(t) == JV_KIND_ARRAY) {
+    // extract slices, they must be handled differently
+    jv neg_keys = jv_array();
+    jv nonneg_keys = jv_array();
+    jv new_array = jv_array();
+    jv starts = jv_array(), ends = jv_array();
+    jv_array_foreach(keys, i, key) {
+      if (jv_get_kind(key) == JV_KIND_NUMBER) {
+        if (jv_number_value(key) < 0) {
+          neg_keys = jv_array_append(neg_keys, key);
+        } else {
+          nonneg_keys = jv_array_append(nonneg_keys, key);
+        }
+      } else if (jv_get_kind(key) == JV_KIND_OBJECT) {
+        int start, end;
+        if (jq_front_parse_slice(self, jv_copy(t), key, &start, &end)) {
+          starts = jv_array_append(starts, jv_number(start));
+          ends = jv_array_append(ends, jv_number(end));
+        } else {
+          jv_free(new_array);
+          jv_free(key);
+          new_array = jv_invalid_with_msg(jv_string_fmt("Start and end indices of an array slice must be numbers"));
+          goto arr_out;
+        }
+      } else {
+        jv_free(new_array);
+        new_array = jv_invalid_with_msg(jv_string_fmt("Cannot delete %s element of array",
+                                                      jv_kind_name(jv_get_kind(key))));
+        jv_free(key);
+        goto arr_out;
+      }
+    }
+
+    int neg_idx = 0;
+    int nonneg_idx = 0;
+    int len = jv_array_length(jv_copy(t));
+    jv_array_foreach(t, i, elem) {
+      int del = 0;
+      while (neg_idx < jv_array_length(jv_copy(neg_keys))) {
+        int delidx = len + (int)jq_front_jv_number_get_value_and_consume(self, jv_array_get(jv_copy(neg_keys), neg_idx));
+        if (i == delidx) {
+          del = 1;
+        }
+        if (i < delidx) {
+          break;
+        }
+        neg_idx++;
+      }
+      while (nonneg_idx < jv_array_length(jv_copy(nonneg_keys))) {
+        int delidx = (int)jq_front_jv_number_get_value_and_consume(self, jv_array_get(jv_copy(nonneg_keys), nonneg_idx));
+        if (i == delidx) {
+          del = 1;
+        }
+        if (i < delidx) {
+          break;
+        }
+        nonneg_idx++;
+      }
+      for (int sidx=0; !del && sidx<jv_array_length(jv_copy(starts)); sidx++) {
+        if ((int)jq_front_jv_number_get_value_and_consume(self, jv_array_get(jv_copy(starts), sidx)) <= i &&
+            i < (int)jq_front_jv_number_get_value_and_consume(self, jv_array_get(jv_copy(ends), sidx))) {
+          del = 1;
+        }
+      }
+      if (!del)
+        new_array = jv_array_append(new_array, elem);
+      else
+        jv_free(elem);
+    }
+  arr_out:
+    jv_free(neg_keys);
+    jv_free(nonneg_keys);
+    jv_free(starts);
+    jv_free(ends);
+    jv_free(t);
+    t = new_array;
+  } else if (jv_get_kind(t) == JV_KIND_OBJECT) {
+    jv_array_foreach(keys, i, k) {
+      if (jv_get_kind(k) != JV_KIND_STRING) {
+        jv_free(t);
+        t = jv_invalid_with_msg(jv_string_fmt("Cannot delete %s field of object",
+                                              jv_kind_name(jv_get_kind(k))));
+        jv_free(k);
+        break;
+      }
+      t = jv_object_delete(t, k);
+    }
+  } else {
+    jv err = jv_invalid_with_msg(jv_string_fmt("Cannot delete fields from %s",
+                                               jv_kind_name(jv_get_kind(t))));
+    jv_free(t);
+    t = err;
+  }
+  jv_free(keys);
+  return t;
+}
+
+jv jq_front_jv_setpath(struct lexer_param *self, jv root, jv path, jv value) {
+  self->aux_ops++;
+  self->aux_kind = self->aux_ops;
+  self->aux_depth = self->aux_depth ^ (self->aux_kind & 1);
+
+  if (jv_get_kind(path) != JV_KIND_ARRAY) {
+    jv_free(value);
+    jv_free(root);
+    jv_free(path);
+    return jv_invalid_with_msg(jv_string("Path must be specified as an array"));
+  }
+  if (!jv_is_valid(root)){
+    jv_free(value);
+    jv_free(path);
+    return root;
+  }
+  if (jv_array_length(jv_copy(path)) == 0) {
+    jv_free(path);
+    jv_free(root);
+    return value;
+  }
+  jv pathcurr = jv_array_get(jv_copy(path), 0);
+  jv pathrest = jv_array_slice(path, 1, jv_array_length(jv_copy(path)));
+
+  /*
+   * We need to be careful not to make extra copies since that leads to
+   * quadratic behavior (e.g., when growing large data structures in a
+   * reduction with `setpath/2`, i.e., with `|=`.
+   */
+  if (jv_get_kind(pathcurr) == JV_KIND_OBJECT) {
+    // Assignment to slice -- dunno yet how to avoid the extra copy
+    return jq_front_jv_set(self, root, pathcurr,
+                  jq_front_jv_setpath(self, jq_front_jv_get(self, jv_copy(root), jv_copy(pathcurr)), pathrest, value));
+  }
+
+  jv subroot = jq_front_jv_get(self, jv_copy(root), jv_copy(pathcurr));
+  if (!jv_is_valid(subroot)) {
+    jv_free(pathcurr);
+    jv_free(pathrest);
+    jv_free(value);
+    return subroot;
+  }
+
+  // To avoid the extra copy we drop the reference from `root` by setting that
+  // to null first.
+  root = jq_front_jv_set(self, root, jv_copy(pathcurr), jv_null());
+  if (!jv_is_valid(root)) {
+    jv_free(pathcurr);
+    jv_free(pathrest);
+    jv_free(value);
+    return root;
+  }
+  return jq_front_jv_set(self, root, pathcurr, jq_front_jv_setpath(self, subroot, pathrest, value));
+}
+
+jv jq_front_jv_getpath(struct lexer_param *self, jv root, jv path) {
+  self->aux_ops++;
+  self->aux_kind = self->aux_ops;
+  self->aux_depth = self->aux_depth ^ (self->aux_kind & 1);
+
+  if (jv_get_kind(path) != JV_KIND_ARRAY) {
+    jv_free(root);
+    jv_free(path);
+    return jv_invalid_with_msg(jv_string("Path must be specified as an array"));
+  }
+  if (!jv_is_valid(root)) {
+    jv_free(path);
+    return root;
+  }
+  if (jv_array_length(jv_copy(path)) == 0) {
+    jv_free(path);
+    return root;
+  }
+  jv pathcurr = jv_array_get(jv_copy(path), 0);
+  jv pathrest = jv_array_slice(path, 1, jv_array_length(jv_copy(path)));
+  return jq_front_jv_getpath(self, jq_front_jv_get(self, root, pathcurr), pathrest);
+}
+
+static jv jq_front_delpaths_sorted(struct lexer_param *self, jv object, jv paths, int start) {
+  self->aux_ops++;
+  self->aux_kind = self->aux_ops;
+  self->aux_depth = self->aux_depth ^ (self->aux_kind & 1);
+
+  jv delkeys = jv_array();
+  for (int i=0; i<jv_array_length(jv_copy(paths));) {
+    int j = i;
+    assert(jv_array_length(jv_array_get(jv_copy(paths), i)) > start);
+    int delkey = jv_array_length(jv_array_get(jv_copy(paths), i)) == start + 1;
+    jv key = jv_array_get(jv_array_get(jv_copy(paths), i), start);
+    while (j < jv_array_length(jv_copy(paths)) &&
+           jv_equal(jv_copy(key), jv_array_get(jv_array_get(jv_copy(paths), j), start)))
+      j++;
+    // if i <= entry < j, then entry starts with key
+    if (delkey) {
+      // deleting this entire key, we don't care about any more specific deletions
+      delkeys = jv_array_append(delkeys, key);
+    } else {
+      // deleting certain sub-parts of this key
+      jv subobject = jq_front_jv_get(self, jv_copy(object), jv_copy(key));
+      if (!jv_is_valid(subobject)) {
+        jv_free(key);
+        jv_free(object);
+        object = subobject;
+        break;
+      } else if (jv_get_kind(subobject) == JV_KIND_NULL) {
+        jv_free(key);
+        jv_free(subobject);
+      } else {
+        jv newsubobject = jq_front_delpaths_sorted(self, subobject, jv_array_slice(jv_copy(paths), i, j), start+1);
+        if (!jv_is_valid(newsubobject)) {
+          jv_free(key);
+          jv_free(object);
+          object = newsubobject;
+          break;
+        }
+        object = jq_front_jv_set(self, object, key, newsubobject);
+      }
+      if (!jv_is_valid(object)) break;
+    }
+    i = j;
+  }
+  jv_free(paths);
+  if (jv_is_valid(object))
+    object = jq_front_jv_dels(self, object, delkeys);
+  else
+    jv_free(delkeys);
+  return object;
+}
+
+jv jq_front_jv_delpaths(struct lexer_param *self, jv object, jv paths) {
+  self->aux_ops++;
+  self->aux_kind = self->aux_ops;
+  self->aux_depth = self->aux_depth ^ (self->aux_kind & 1);
+
+  if (jv_get_kind(paths) != JV_KIND_ARRAY) {
+    jv_free(object);
+    jv_free(paths);
+    return jv_invalid_with_msg(jv_string("Paths must be specified as an array"));
+  }
+  paths = jq_front_jv_sort(self, paths, jv_copy(paths));
+  jv_array_foreach(paths, i, elem) {
+    if (jv_get_kind(elem) != JV_KIND_ARRAY) {
+      jv_free(object);
+      jv_free(paths);
+      jv err = jv_invalid_with_msg(jv_string_fmt("Path must be specified as array, not %s",
+                                                 jv_kind_name(jv_get_kind(elem))));
+      jv_free(elem);
+      return err;
+    }
+    jv_free(elem);
+  }
+  if (jv_array_length(jv_copy(paths)) == 0) {
+    // nothing is being deleted
+    jv_free(paths);
+    return object;
+  }
+  if (jv_array_length(jv_array_get(jv_copy(paths), 0)) == 0) {
+    // everything is being deleted
+    jv_free(paths);
+    jv_free(object);
+    return jv_null();
+  }
+  return jq_front_delpaths_sorted(self, object, paths, 0);
+}
+
+static int string_cmp(const void* pa, const void* pb) {
+  const jv* a = pa;
+  const jv* b = pb;
+  int lena = jv_string_length_bytes(jv_copy(*a));
+  int lenb = jv_string_length_bytes(jv_copy(*b));
+  int minlen = lena < lenb ? lena : lenb;
+  int r = memcmp(jv_string_value(*a), jv_string_value(*b), minlen);
+  if (r == 0) r = lena - lenb;
+  return r;
+}
+
+jv jq_front_jv_keys_unsorted(struct lexer_param *self, jv x) {
+  self->aux_ops++;
+  self->aux_kind = self->aux_ops;
+  self->aux_depth = self->aux_depth ^ (self->aux_kind & 1);
+
+  if (jv_get_kind(x) != JV_KIND_OBJECT)
+    return jq_front_jv_keys(self, x);
+  jv answer = jv_array_sized(jv_object_length(jv_copy(x)));
+  jv_object_foreach(x, key, value) {
+    answer = jv_array_append(answer, key);
+    jv_free(value);
+  }
+  jv_free(x);
+  return answer;
+}
+
+jv jq_front_jv_keys(struct lexer_param *self, jv x) {
+  self->aux_ops++;
+  self->aux_kind = self->aux_ops;
+  self->aux_depth = self->aux_depth ^ (self->aux_kind & 1);
+
+  if (jv_get_kind(x) == JV_KIND_OBJECT) {
+    int nkeys = jv_object_length(jv_copy(x));
+    jv* keys = jv_mem_calloc(sizeof(jv), nkeys);
+    int kidx = 0;
+    jv_object_foreach(x, key, value) {
+      keys[kidx++] = key;
+      jv_free(value);
+    }
+    qsort(keys, nkeys, sizeof(jv), string_cmp);
+    jv answer = jv_array_sized(nkeys);
+    for (int i = 0; i<nkeys; i++) {
+      answer = jv_array_append(answer, keys[i]);
+    }
+    jv_mem_free(keys);
+    jv_free(x);
+    return answer;
+  } else if (jv_get_kind(x) == JV_KIND_ARRAY) {
+    int n = jv_array_length(x);
+    jv answer = jv_array();
+    for (int i=0; i<n; i++){
+      answer = jv_array_set(answer, i, jv_number(i));
+    }
+    return answer;
+  } else {
+    assert(0 && "jv_keys passed something neither object nor array");
+    return jv_invalid();
+  }
+}
+
+int jq_front_jv_cmp(struct lexer_param *self, jv a, jv b) {
+  self->aux_ops++;
+  self->aux_kind = self->aux_ops;
+  self->aux_depth = self->aux_depth ^ (self->aux_kind & 1);
+
+  if (jv_get_kind(a) != jv_get_kind(b)) {
+    int r = (int)jv_get_kind(a) - (int)jv_get_kind(b);
+    jv_free(a);
+    jv_free(b);
+    return r;
+  }
+  int r = 0;
+  switch (jv_get_kind(a)) {
+  default:
+    assert(0 && "invalid kind passed to jv_cmp");
+  case JV_KIND_NULL:
+  case JV_KIND_FALSE:
+  case JV_KIND_TRUE:
+    // there's only one of each of these values
+    r = 0;
+    break;
+
+  case JV_KIND_NUMBER: {
+    if (jvp_number_is_nan(a)) {
+      r = jq_front_jv_cmp(self, jv_null(), jv_copy(b));
+    } else if (jvp_number_is_nan(b)) {
+      r = jq_front_jv_cmp(self, jv_copy(a), jv_null());
+    } else {
+      r = jvp_number_cmp(a, b);
+    }
+    break;
+  }
+
+  case JV_KIND_STRING: {
+    r = string_cmp(&a, &b);
+    break;
+  }
+
+  case JV_KIND_ARRAY: {
+    // Lexical ordering of arrays
+    int i = 0;
+    while (r == 0) {
+      int a_done = i >= jv_array_length(jv_copy(a));
+      int b_done = i >= jv_array_length(jv_copy(b));
+      if (a_done || b_done) {
+        r = b_done - a_done; //suddenly, logic
+        break;
+      }
+      jv xa = jv_array_get(jv_copy(a), i);
+      jv xb = jv_array_get(jv_copy(b), i);
+      r = jq_front_jv_cmp(self, xa, xb);
+      i++;
+    }
+    break;
+  }
+
+  case JV_KIND_OBJECT: {
+    jv keys_a = jq_front_jv_keys(self, jv_copy(a));
+    jv keys_b = jq_front_jv_keys(self, jv_copy(b));
+    r = jq_front_jv_cmp(self, jv_copy(keys_a), keys_b);
+    if (r == 0) {
+      jv_array_foreach(keys_a, i, key) {
+        jv xa = jv_object_get(jv_copy(a), jv_copy(key));
+        jv xb = jv_object_get(jv_copy(b), key);
+        r = jq_front_jv_cmp(self, xa, xb);
+        if (r) break;
+      }
+    }
+    jv_free(keys_a);
+    break;
+  }
+  }
+
+  jv_free(a);
+  jv_free(b);
+  return r;
+}
+
+static int sort_cmp(const void* pa, const void* pb) {
+  const struct sort_entry* a = pa;
+  const struct sort_entry* b = pb;
+  int r = jv_cmp(jv_copy(a->key), jv_copy(b->key));
+  // comparing by index if r == 0 makes the sort stable
+  return r ? r : (a->index - b->index);
+}
+
+static struct sort_entry* jq_front_sort_items(struct lexer_param *self, jv objects, jv keys) {
+  self->aux_ops++;
+  self->aux_kind = self->aux_ops;
+  self->aux_depth = self->aux_depth ^ (self->aux_kind & 1);
+
+  assert(jv_get_kind(objects) == JV_KIND_ARRAY);
+  assert(jv_get_kind(keys) == JV_KIND_ARRAY);
+  assert(jv_array_length(jv_copy(objects)) == jv_array_length(jv_copy(keys)));
+  int n = jv_array_length(jv_copy(objects));
+  struct sort_entry* entries = jv_mem_calloc(sizeof(struct sort_entry), n);
+  for (int i=0; i<n; i++) {
+    entries[i].object = jv_array_get(jv_copy(objects), i);
+    entries[i].key = jv_array_get(jv_copy(keys), i);
+    entries[i].index = i;
+  }
+  jv_free(objects);
+  jv_free(keys);
+  qsort(entries, n, sizeof(struct sort_entry), sort_cmp);
+  return entries;
+}
+
+jv jq_front_jv_sort(struct lexer_param *self, jv objects, jv keys) {
+  self->aux_ops++;
+  self->aux_kind = self->aux_ops;
+  self->aux_depth = self->aux_depth ^ (self->aux_kind & 1);
+
+  assert(jv_get_kind(objects) == JV_KIND_ARRAY);
+  assert(jv_get_kind(keys) == JV_KIND_ARRAY);
+  assert(jv_array_length(jv_copy(objects)) == jv_array_length(jv_copy(keys)));
+  int n = jv_array_length(jv_copy(objects));
+  struct sort_entry* entries = jq_front_sort_items(self, objects, keys);
+  jv ret = jv_array();
+  for (int i=0; i<n; i++) {
+    jv_free(entries[i].key);
+    ret = jv_array_set(ret, i, entries[i].object);
+  }
+  jv_mem_free(entries);
+  return ret;
+}
+
+jv jq_front_jv_group(struct lexer_param *self, jv objects, jv keys) {
+  self->aux_ops++;
+  self->aux_kind = self->aux_ops;
+  self->aux_depth = self->aux_depth ^ (self->aux_kind & 1);
+
+  assert(jv_get_kind(objects) == JV_KIND_ARRAY);
+  assert(jv_get_kind(keys) == JV_KIND_ARRAY);
+  assert(jv_array_length(jv_copy(objects)) == jv_array_length(jv_copy(keys)));
+  int n = jv_array_length(jv_copy(objects));
+  struct sort_entry* entries = jq_front_sort_items(self, objects, keys);
+  jv ret = jv_array();
+  if (n > 0) {
+    jv curr_key = entries[0].key;
+    jv group = jv_array_append(jv_array(), entries[0].object);
+    for (int i = 1; i < n; i++) {
+      if (jv_equal(jv_copy(curr_key), jv_copy(entries[i].key))) {
+        jv_free(entries[i].key);
+      } else {
+        jv_free(curr_key);
+        curr_key = entries[i].key;
+        ret = jv_array_append(ret, group);
+        group = jv_array();
+      }
+      group = jv_array_append(group, entries[i].object);
+    }
+    jv_free(curr_key);
+    ret = jv_array_append(ret, group);
+  }
+  jv_mem_free(entries);
+  return ret;
+}
+
+int jq_front_jq_set_colors(struct lexer_param *self, const char *c) {
+  self->print_flags++;
+  self->print_depth = self->print_flags;
+  self->print_ascii = self->print_ascii ^ (self->print_depth & 1);
+
+  const char *e;
+  size_t i;
+
+  if (c == NULL)
+    return 1;
+  colors = def_colors;
+  memset(color_bufs, 0, sizeof(color_bufs));
+  for (i = 0; i < sizeof(def_colors) / sizeof(def_colors[0]); i++)
+    color_bufps[i] = def_colors[i];
+  for (i = 0; i < sizeof(def_colors) / sizeof(def_colors[0]) && *c != '\0'; i++, c = e) {
+    if ((e = strchr(c, ':')) == NULL)
+      e = c + strlen(c);
+    if ((size_t)(e - c) > sizeof(color_bufs[i]) - 4 /* ESC [ m NUL */)
+      return 0;
+    color_bufs[i][0] = ESC[0];
+    color_bufs[i][1] = '[';
+    (void) strncpy(&color_bufs[i][2], c, e - c);
+    if (strspn(&color_bufs[i][2], "0123456789;") < strlen(&color_bufs[i][2]))
+      return 0;
+    color_bufs[i][2 + (e - c)] = 'm';
+    color_bufps[i] = color_bufs[i];
+    if (e[0] == ':')
+      e++;
+  }
+  colors = color_bufps;
+  return 1;
+}
+
+static void jq_front_put_buf(struct lexer_param *self, const char *s, int len, FILE *fout, jv *strout, int is_tty) {
+  self->print_flags++;
+  self->print_depth = self->print_flags;
+  self->print_ascii = self->print_ascii ^ (self->print_depth & 1);
+
+  if (strout) {
+    *strout = jv_string_append_buf(*strout, s, len);
+  } else {
+#ifdef WIN32
+  /* See util.h */
+  if (is_tty) {
+    wchar_t *ws;
+    size_t wl;
+    if (len == -1)
+      len = strlen(s);
+    wl = MultiByteToWideChar(CP_UTF8, 0, s, len, NULL, 0);
+    ws = jv_mem_calloc((wl + 1), sizeof(*ws));
+    if (!ws)
+      return;
+    wl = MultiByteToWideChar(CP_UTF8, 0, s, len, ws, wl + 1);
+    ws[wl] = 0;
+    WriteConsoleW((HANDLE)_get_osfhandle(fileno(fout)), ws, wl, NULL, NULL);
+    free(ws);
+  } else
+    fwrite(s, 1, len, fout);
+#else
+  fwrite(s, 1, len, fout);
+#endif
+  }
+}
+
+static void jq_front_put_char(struct lexer_param *self, char c, FILE* fout, jv* strout, int T) {
+  self->print_flags++;
+  self->print_depth = self->print_flags;
+  self->print_ascii = self->print_ascii ^ (self->print_depth & 1);
+
+  jq_front_put_buf(self, &c, 1, fout, strout, T);
+}
+
+static void jq_front_put_str(struct lexer_param *self, const char* s, FILE* fout, jv* strout, int T) {
+  self->print_flags++;
+  self->print_depth = self->print_flags;
+  self->print_ascii = self->print_ascii ^ (self->print_depth & 1);
+
+  jq_front_put_buf(self, s, strlen(s), fout, strout, T);
+}
+
+static void jq_front_put_indent(struct lexer_param *self, int n, int flags, FILE* fout, jv* strout, int T) {
+  self->print_flags++;
+  self->print_depth = self->print_flags;
+  self->print_ascii = self->print_ascii ^ (self->print_depth & 1);
+
+  if (flags & JV_PRINT_TAB) {
+    while (n--)
+      jq_front_put_char(self, '\t', fout, strout, T);
+  } else {
+    n *= ((flags & (JV_PRINT_SPACE0 | JV_PRINT_SPACE1 | JV_PRINT_SPACE2)) >> 8);
+    while (n--)
+      jq_front_put_char(self, ' ', fout, strout, T);
+  }
+}
+
+static void jq_front_jvp_dump_string(struct lexer_param *self, jv str, int ascii_only, FILE* F, jv* S, int T) {
+  self->print_flags++;
+  self->print_depth = self->print_flags;
+  self->print_ascii = self->print_ascii ^ (self->print_depth & 1);
+
+  assert(jv_get_kind(str) == JV_KIND_STRING);
+  const char* i = jv_string_value(str);
+  const char* end = i + jv_string_length_bytes(jv_copy(str));
+  const char* cstart;
+  int c = 0;
+  char buf[32];
+  jq_front_put_char(self, '"', F, S, T);
+  while ((i = jvp_utf8_next((cstart = i), end, &c))) {
+    assert(c != -1);
+    int unicode_escape = 0;
+    if (0x20 <= c && c <= 0x7E) {
+      // printable ASCII
+      if (c == '"' || c == '\\') {
+        jq_front_put_char(self, '\\', F, S, T);
+      }
+      jq_front_put_char(self, c, F, S, T);
+    } else if (c < 0x20 || c == 0x7F) {
+      // ASCII control character
+      switch (c) {
+      case '\b':
+        jq_front_put_char(self, '\\', F, S, T);
+        jq_front_put_char(self, 'b', F, S, T);
+        break;
+      case '\t':
+        jq_front_put_char(self, '\\', F, S, T);
+        jq_front_put_char(self, 't', F, S, T);
+        break;
+      case '\r':
+        jq_front_put_char(self, '\\', F, S, T);
+        jq_front_put_char(self, 'r', F, S, T);
+        break;
+      case '\n':
+        jq_front_put_char(self, '\\', F, S, T);
+        jq_front_put_char(self, 'n', F, S, T);
+        break;
+      case '\f':
+        jq_front_put_char(self, '\\', F, S, T);
+        jq_front_put_char(self, 'f', F, S, T);
+        break;
+      default:
+        unicode_escape = 1;
+        break;
+      }
+    } else {
+      if (ascii_only) {
+        unicode_escape = 1;
+      } else {
+        jq_front_put_buf(self, cstart, i - cstart, F, S, T);
+      }
+    }
+    if (unicode_escape) {
+      if (c <= 0xffff) {
+        snprintf(buf, sizeof(buf), "\\u%04x", c);
+      } else {
+        c -= 0x10000;
+        snprintf(buf, sizeof(buf), "\\u%04x\\u%04x",
+                0xD800 | ((c & 0xffc00) >> 10),
+                0xDC00 | (c & 0x003ff));
+      }
+      jq_front_put_str(self, buf, F, S, T);
+    }
+  }
+  assert(c != -1);
+  jq_front_put_char(self, '"', F, S, T);
+}
+
+static void jq_front_put_refcnt(struct lexer_param *self, struct dtoa_context* C, int refcnt, FILE *F, jv* S, int T) {
+  self->print_flags++;
+  self->print_depth = self->print_flags;
+  self->print_ascii = self->print_ascii ^ (self->print_depth & 1);
+
+  char buf[JVP_DTOA_FMT_MAX_LEN];
+  jq_front_put_char(self, ' ', F, S, T);
+  jq_front_put_char(self, '(', F, S, T);
+  jq_front_put_str(self, jvp_dtoa_fmt(C, buf, refcnt), F, S, T);
+  jq_front_put_char(self, ')', F, S, T);
+}
+
+static void jq_front_jv_dump_term(struct lexer_param *self, struct dtoa_context* C, jv x, int flags, int indent, FILE* F, jv* S) {
+  self->print_flags++;
+  self->print_depth = self->print_flags;
+  self->print_ascii = self->print_ascii ^ (self->print_depth & 1);
+
+  char buf[JVP_DTOA_FMT_MAX_LEN];
+  const char* color = 0;
+  double refcnt = (flags & JV_PRINT_REFCOUNT) ? jv_get_refcnt(x) - 1 : -1;
+  if (flags & JV_PRINT_COLOR) {
+    for (unsigned i=0; i<sizeof(color_kinds)/sizeof(color_kinds[0]); i++) {
+      if (jv_get_kind(x) == color_kinds[i]) {
+        color = colors[i];
+        jq_front_put_str(self, color, F, S, flags & JV_PRINT_ISATTY);
+        break;
+      }
+    }
+  }
+  if (indent > MAX_PRINT_DEPTH) {
+    jq_front_put_str(self, "<skipped: too deep>", F, S, flags & JV_PRINT_ISATTY);
+  } else switch (jv_get_kind(x)) {
+  default:
+  case JV_KIND_INVALID:
+    if (flags & JV_PRINT_INVALID) {
+      jv msg = jv_invalid_get_msg(jv_copy(x));
+      if (jv_get_kind(msg) == JV_KIND_STRING) {
+        jq_front_put_str(self, "<invalid:", F, S, flags & JV_PRINT_ISATTY);
+        jq_front_jvp_dump_string(self, msg, flags | JV_PRINT_ASCII, F, S, flags & JV_PRINT_ISATTY);
+        jq_front_put_str(self, ">", F, S, flags & JV_PRINT_ISATTY);
+      } else {
+        jq_front_put_str(self, "<invalid>", F, S, flags & JV_PRINT_ISATTY);
+      }
+    } else {
+      assert(0 && "Invalid value");
+    }
+    break;
+  case JV_KIND_NULL:
+    jq_front_put_str(self, "null", F, S, flags & JV_PRINT_ISATTY);
+    break;
+  case JV_KIND_FALSE:
+    jq_front_put_str(self, "false", F, S, flags & JV_PRINT_ISATTY);
+    break;
+  case JV_KIND_TRUE:
+    jq_front_put_str(self, "true", F, S, flags & JV_PRINT_ISATTY);
+    break;
+  case JV_KIND_NUMBER: {
+    if (jvp_number_is_nan(x)) {
+      jq_front_jv_dump_term(self, C, jv_null(), flags, indent, F, S);
+    } else {
+#ifdef USE_DECNUM
+      const char * literal_data = jv_number_get_literal(x);
+      if (literal_data) {
+        jq_front_put_str(self, literal_data, F, S, flags & JV_PRINT_ISATTY);
+      } else {
+#endif
+        double d = jv_number_value(x);
+        if (d != d) {
+          // JSON doesn't have NaN, so we'll render it as "null"
+          jq_front_put_str(self, "null", F, S, flags & JV_PRINT_ISATTY);
+        } else {
+          // Normalise infinities to something we can print in valid JSON
+          if (d > DBL_MAX) d = DBL_MAX;
+          if (d < -DBL_MAX) d = -DBL_MAX;
+          jq_front_put_str(self, jvp_dtoa_fmt(C, buf, d), F, S, flags & JV_PRINT_ISATTY);
+        }
+      }
+#ifdef USE_DECNUM
+    }
+#endif
+    break;
+  }
+  case JV_KIND_STRING:
+    jq_front_jvp_dump_string(self, x, flags & JV_PRINT_ASCII, F, S, flags & JV_PRINT_ISATTY);
+    if (flags & JV_PRINT_REFCOUNT)
+      jq_front_put_refcnt(self, C, refcnt, F, S, flags & JV_PRINT_ISATTY);
+    break;
+  case JV_KIND_ARRAY: {
+    if (jv_array_length(jv_copy(x)) == 0) {
+      jq_front_put_str(self, "[]", F, S, flags & JV_PRINT_ISATTY);
+      break;
+    }
+    jq_front_put_str(self, "[", F, S, flags & JV_PRINT_ISATTY);
+    if (flags & JV_PRINT_PRETTY) {
+      jq_front_put_char(self, '\n', F, S, flags & JV_PRINT_ISATTY);
+      jq_front_put_indent(self, indent + 1, flags, F, S, flags & JV_PRINT_ISATTY);
+    }
+    jv_array_foreach(x, i, elem) {
+      if (i!=0) {
+        if (flags & JV_PRINT_PRETTY) {
+          jq_front_put_str(self, ",\n", F, S, flags & JV_PRINT_ISATTY);
+          jq_front_put_indent(self, indent + 1, flags, F, S, flags & JV_PRINT_ISATTY);
+        } else {
+          jq_front_put_str(self, ",", F, S, flags & JV_PRINT_ISATTY);
+        }
+      }
+      jq_front_jv_dump_term(self, C, elem, flags, indent + 1, F, S);
+      if (color) jq_front_put_str(self, color, F, S, flags & JV_PRINT_ISATTY);
+    }
+    if (flags & JV_PRINT_PRETTY) {
+      jq_front_put_char(self, '\n', F, S, flags & JV_PRINT_ISATTY);
+      jq_front_put_indent(self, indent, flags, F, S, flags & JV_PRINT_ISATTY);
+    }
+    if (color) jq_front_put_str(self, color, F, S, flags & JV_PRINT_ISATTY);
+    jq_front_put_char(self, ']', F, S, flags & JV_PRINT_ISATTY);
+    if (flags & JV_PRINT_REFCOUNT)
+      jq_front_put_refcnt(self, C, refcnt, F, S, flags & JV_PRINT_ISATTY);
+    break;
+  }
+  case JV_KIND_OBJECT: {
+    if (jv_object_length(jv_copy(x)) == 0) {
+      jq_front_put_str(self, "{}", F, S, flags & JV_PRINT_ISATTY);
+      break;
+    }
+    jq_front_put_char(self, '{', F, S, flags & JV_PRINT_ISATTY);
+    if (flags & JV_PRINT_PRETTY) {
+      jq_front_put_char(self, '\n', F, S, flags & JV_PRINT_ISATTY);
+      jq_front_put_indent(self, indent + 1, flags, F, S, flags & JV_PRINT_ISATTY);
+    }
+    int first = 1;
+    int i = 0;
+    jv keyset = jv_null();
+    while (1) {
+      jv key, value;
+      if (flags & JV_PRINT_SORTED) {
+        if (first) {
+          keyset = jq_front_jv_keys(self, jv_copy(x));
+          i = 0;
+        } else {
+          i++;
+        }
+        if (i >= jv_array_length(jv_copy(keyset))) {
+          jv_free(keyset);
+          break;
+        }
+        key = jv_array_get(jv_copy(keyset), i);
+        value = jv_object_get(jv_copy(x), jv_copy(key));
+      } else {
+        if (first) {
+          i = jv_object_iter(x);
+        } else {
+          i = jv_object_iter_next(x, i);
+        }
+        if (!jv_object_iter_valid(x, i)) break;
+        key = jv_object_iter_key(x, i);
+        value = jv_object_iter_value(x, i);
+      }
+
+      if (!first) {
+        if (flags & JV_PRINT_PRETTY){
+          jq_front_put_str(self, ",\n", F, S, flags & JV_PRINT_ISATTY);
+          jq_front_put_indent(self, indent + 1, flags, F, S, flags & JV_PRINT_ISATTY);
+        } else {
+          jq_front_put_str(self, ",", F, S, flags & JV_PRINT_ISATTY);
+        }
+      }
+      if (color) jq_front_put_str(self, COLRESET, F, S, flags & JV_PRINT_ISATTY);
+
+      first = 0;
+      if (color) jq_front_put_str(self, FIELD_COLOR, F, S, flags & JV_PRINT_ISATTY);
+      jq_front_jvp_dump_string(self, key, flags & JV_PRINT_ASCII, F, S, flags & JV_PRINT_ISATTY);
+      jv_free(key);
+      if (color) jq_front_put_str(self, COLRESET, F, S, flags & JV_PRINT_ISATTY);
+
+      if (color) jq_front_put_str(self, color, F, S, flags & JV_PRINT_ISATTY);
+      jq_front_put_str(self, (flags & JV_PRINT_PRETTY) ? ": " : ":", F, S, flags & JV_PRINT_ISATTY);
+      if (color) jq_front_put_str(self, COLRESET, F, S, flags & JV_PRINT_ISATTY);
+
+      jq_front_jv_dump_term(self, C, value, flags, indent + 1, F, S);
+      if (color) jq_front_put_str(self, color, F, S, flags & JV_PRINT_ISATTY);
+    }
+    if (flags & JV_PRINT_PRETTY) {
+      jq_front_put_char(self, '\n', F, S, flags & JV_PRINT_ISATTY);
+      jq_front_put_indent(self, indent, flags, F, S, flags & JV_PRINT_ISATTY);
+    }
+    if (color) jq_front_put_str(self, color, F, S, flags & JV_PRINT_ISATTY);
+    jq_front_put_char(self, '}', F, S, flags & JV_PRINT_ISATTY);
+    if (flags & JV_PRINT_REFCOUNT)
+      jq_front_put_refcnt(self, C, refcnt, F, S, flags & JV_PRINT_ISATTY);
+  }
+  }
+  jv_free(x);
+  if (color) {
+    jq_front_put_str(self, COLRESET, F, S, flags & JV_PRINT_ISATTY);
+  }
+}
+
+void jq_front_jv_dumpf(struct lexer_param *self, jv x, FILE *f, int flags) {
