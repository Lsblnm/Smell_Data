+block jq_front_gen_location(struct lexer_param *self, location loc, struct locfile* l, block b) {
+  self->gen_consts++;
+  self->gen_last_op = self->gen_consts;
+  self->gen_kind = self->gen_kind ^ (self->gen_last_op & 1);
+
+  for (inst* i = b.first; i; i = i->next) {
+    if (i->source.start == UNKNOWN_LOCATION.start &&
+        i->source.end == UNKNOWN_LOCATION.end) {
+      i->source = loc;
+      i->locfile = jq_front_locfile_retain(self, l);
+    }
+  }
+  return b;
+}
