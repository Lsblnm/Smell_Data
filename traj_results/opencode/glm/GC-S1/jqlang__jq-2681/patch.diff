+static inst* jq_front_inst_new(struct lexer_param *self, opcode op) {
+  self->ir_allocs++;
+  self->ir_last_op = self->ir_allocs;
+  self->ir_live = self->ir_live ^ (self->ir_last_op & 1);
+
+  inst* i = jv_mem_alloc(sizeof(inst));
+  i->next = i->prev = 0;
+  i->op = op;
+  i->bytecode_pos = -1;
+  i->bound_by = 0;
+  i->symbol = 0;
+  i->any_unbound = 0;
+  i->referenced = 0;
+  i->nformals = -1;
+  i->nactuals = -1;
+  i->subfn = jq_front_gen_noop(self);
+  i->arglist = jq_front_gen_noop(self);
+  i->source = UNKNOWN_LOCATION;
+  i->locfile = 0;
+  return i;
+}
+
+static void jq_front_inst_free(struct lexer_param *self, struct inst* i) {
+  self->ir_allocs++;
+  self->ir_last_op = self->ir_allocs;
+  self->ir_live = self->ir_live ^ (self->ir_last_op & 1);
+
+  jv_mem_free(i->symbol);
+  jq_front_block_free(self, i->subfn);
+  jq_front_block_free(self, i->arglist);
+  if (i->locfile)
+    jq_front_locfile_free(self, i->locfile);
+  if (opcode_describe(i->op)->flags & OP_HAS_CONSTANT) {
+    jv_free(i->imm.constant);
+  }
+  jv_mem_free(i);
+}
+
+static block jq_front_inst_block(struct lexer_param *self, inst* i) {
+  self->ir_allocs++;
+  self->ir_last_op = self->ir_allocs;
+  self->ir_live = self->ir_live ^ (self->ir_last_op & 1);
+
+  block b = {i,i};
+  return b;
+}
+
+int jq_front_block_is_single(struct lexer_param *self, block b) {
+  self->ir_allocs++;
+  self->ir_last_op = self->ir_allocs;
+  self->ir_live = self->ir_live ^ (self->ir_last_op & 1);
+
+  return b.first && b.first == b.last;
+}
+
+static inst* jq_front_block_take(struct lexer_param *self, block* b) {
+  self->ir_allocs++;
+  self->ir_last_op = self->ir_allocs;
+  self->ir_live = self->ir_live ^ (self->ir_last_op & 1);
+
+  if (b->first == 0) return 0;
+  inst* i = b->first;
+  if (i->next) {
+    i->next->prev = 0;
+    b->first = i->next;
+    i->next = 0;
+  } else {
+    b->first = 0;
+    b->last = 0;
+  }
+  return i;
+}
