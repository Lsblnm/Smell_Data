diff --git a/lib/fpm/package/deb.rb b/lib/fpm/package/deb.rb
index 93d9e4d..455bb27 100644
--- a/lib/fpm/package/deb.rb
+++ b/lib/fpm/package/deb.rb
@@ -793,6 +793,31 @@ class FPM::Package::Deb < FPM::Package
       logger.warn("Replacing 'provides' entry #{provides} with syntax 'name (= version)'")
       provides = "#{m[1]} (= #{m[2]})"
     end
+
+    # Debian policy only allows exact version relations in Provides:
+    # "name" or "name (= version)". Reference:
+    # https://www.debian.org/doc/debian-policy/ch-relationships.html
+    if m = provides.match(/^(\S+)\s*\(([^)]+)\)\s*$/)
+      relation, version = m[2].strip.split(/\s+/, 2)
+      if version.nil?
+        raise FPM::InvalidPackageConfiguration,
+          "Invalid provides entry '#{provides}': version relation " \
+          "'(#{m[2].strip})' is missing a version"
+      elsif relation != "="
+        raise FPM::InvalidPackageConfiguration,
+          "Invalid provides entry '#{provides}': Debian only supports exact " \
+          "version relations in Provides, use 'name (= version)' instead"
+      elsif version !~ /^[0-9][A-Za-z0-9.+:~-]*$/
+        raise FPM::InvalidPackageConfiguration,
+          "Invalid provides entry '#{provides}': '#{version}' is not a valid " \
+          "Debian version string"
+      end
+    elsif provides =~ /\s/
+      raise FPM::InvalidPackageConfiguration,
+        "Invalid provides entry '#{provides}': Provides must be either " \
+        "'name' or 'name (= version)'"
+    end
+
     return provides.rstrip
   end
 
