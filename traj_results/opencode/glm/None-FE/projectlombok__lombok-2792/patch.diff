diff --git a/src/core/lombok/javac/handlers/HandleVal.java b/src/core/lombok/javac/handlers/HandleVal.java
index 7a524ca3..81cd414e 100644
--- a/src/core/lombok/javac/handlers/HandleVal.java
+++ b/src/core/lombok/javac/handlers/HandleVal.java
@@ -102,6 +102,12 @@ public class HandleVal extends JavacASTAdapter {
 			return;
 		}
 		
+		// Issue #2792: 'val'/'var' declarations nested inside the initializer expression (e.g. in a lambda
+		// passed as a method argument) have not been resolved yet at this point. Attributing the enclosing
+		// method to deduce the type of this declaration would therefore fail, as the nested declarations
+		// cannot contribute a usable type to the inference. Hence, resolve them first, innermost first.
+		resolveNestedVals(localNode, local.init != null ? local.init : rhsOfEnhancedForLoop);
+		
 		if (localNode.shouldDeleteLombokAnnotations()) {
 			JavacHandlerUtil.deleteImportFromCompilationUnit(localNode, val.class.getName());
 			JavacHandlerUtil.deleteImportFromCompilationUnit(localNode, lombok.experimental.var.class.getName());
@@ -185,4 +191,28 @@ public class HandleVal extends JavacASTAdapter {
 			recursiveSetGeneratedBy(local.vartype, typeNode);
 		}
 	}
+	
+	private void resolveNestedVals(final JavacNode localNode, JCTree tree) {
+		if (tree == null) return;
+		JavacNode initNode = localNode.getNodeFor(tree);
+		if (initNode == null) return;
+		resolveNestedVals(initNode);
+	}
+	
+	private void resolveNestedVals(JavacNode node) {
+		for (JavacNode child : node.down()) {
+			resolveNestedVals(child);
+			if (child.getKind() != lombok.core.AST.Kind.LOCAL) continue;
+			if (!(child.get() instanceof JCVariableDecl)) continue;
+			JCVariableDecl varDecl = (JCVariableDecl) child.get();
+			if (varDecl.vartype == null) continue;
+			String name = varDecl.vartype.toString();
+			if (!eq(name, "val") && !eq(name, "var")) continue;
+			try {
+				visitLocal(child, varDecl);
+			} catch (Exception e) {
+				// intentionally ignored; the regular traversal will process this declaration again and report any issues.
+			}
+		}
+	}
 }
