+// validateImportTargets validates the import blocks which target this
+// resource. The import target addresses were verified to exist in the
+// configuration when the graph was built, so here we can validate the
+// expressions within the import blocks themselves.
+//
+// The expressions are evaluated with unknown values, as is the norm for the
+// validate walk, so references to undefined variables, locals, or resources
+// are reported here, while references to values which are merely computed
+// during plan remain permitted.
+func (n *NodeValidatableResource) validateImportTargets(ctx EvalContext) tfdiags.Diagnostics {
+	var diags tfdiags.Diagnostics
+
+	for _, imp := range n.importTargets {
+		// Import targets with no configuration come from the legacy CLI
+		// import command, and are validated during the plan walk instead.
+		if imp.Config == nil {
+			continue
+		}
+
+		// Import blocks are only valid within the root module, and must be
+		// evaluated within that context.
+		ctx = evalContextForModuleInstance(ctx, addrs.RootModuleInstance)
+
+		if imp.Config.ForEach != nil {
+			// The for_each expression cannot be fully expanded during
+			// validation, so we evaluate the import ID with unknown
+			// repetition data in order to still catch invalid expressions.
+			_, _, forEachDiags := newForEachEvaluator(imp.Config.ForEach, ctx, true).ImportValues()
+			diags = diags.Append(forEachDiags)
+
+			keyData := instances.UnknownForEachRepetitionData(cty.DynamicPseudoType)
+			_, idDiags := evaluateImportIdExpression(imp.Config.ID, addrs.AbsResourceInstance{}, ctx, keyData, true)
+			diags = diags.Append(idDiags)
+			continue
+		}
+
+		traversal, hds := hcl.AbsTraversalForExpr(imp.Config.To)
+		diags = diags.Append(hds)
+		if diags.HasErrors() {
+			return diags
+		}
+		to, tds := addrs.ParseAbsResourceInstance(traversal)
+		diags = diags.Append(tds)
+		if diags.HasErrors() {
+			return diags
+		}
+
+		// The import ID is allowed to contain unknown values during
+		// validation, but invalid expressions, or references to undefined
+		// objects must still be caught here.
+		_, idDiags := evaluateImportIdExpression(imp.Config.ID, to, ctx, EvalDataForNoInstanceKey, true)
+		diags = diags.Append(idDiags)
+	}
+
+	return diags
+}
