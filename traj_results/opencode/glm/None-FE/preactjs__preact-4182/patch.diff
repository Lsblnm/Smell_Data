@@ -271,6 +271,15 @@ export function diff(
 				excessDomChildren[excessDomChildren.indexOf(oldDom)] = null;
 				// ^ could possibly be simplified to:
 				// excessDomChildren.length = 0;
+			} else if (newVNode._dom == null) {
+				// If this error is caught by a parent error boundary, that
+				// boundary will re-render and replace this subtree. Carry over
+				// the old DOM node and children, similar to what we do for
+				// Suspense, so the old DOM stays attached to this VNode and can
+				// be removed once the boundary re-renders. Otherwise the old DOM
+				// would be orphaned, leading to duplicated DOM.
+				newVNode._dom = oldVNode._dom;
+				newVNode._children = oldVNode._children;
 			}
 			options._catchError(e, newVNode, oldVNode);
 		}
