diff --git a/internal/terraform/transform_attach_config_resource.go b/internal/terraform/transform_attach_config_resource.go
index fd0fb5e570..847666d077 100644
--- a/internal/terraform/transform_attach_config_resource.go
+++ b/internal/terraform/transform_attach_config_resource.go
@@ -51,6 +51,41 @@ func (t *AttachResourceConfigTransformer) Transform(g *Graph) error {
 
 		if config == nil {
 			log.Printf("[TRACE] AttachResourceConfigTransformer: %q (%T) has no configuration available", dag.VertexName(v), v)
+
+			// The module containing this resource is no longer in the
+			// configuration, which means that any "removed" block referring
+			// to this resource must be declared in one of the module's
+			// surviving ancestor modules. We check those from the innermost
+			// outward, since that is where a user would typically declare
+			// the "removed" block for a resource in a removed module.
+			for i := len(addr.Module); i >= 0; i-- {
+				ancestorAddr := addr.Module[:i]
+				ancestorConfig := t.Config.Descendent(ancestorAddr)
+				if ancestorConfig == nil {
+					continue
+				}
+
+				for _, r := range ancestorConfig.Module.Removed {
+					crAddr, ok := r.From.RelSubject.(addrs.ConfigResource)
+					if !ok {
+						// Not for a resource at all, so can't possibly match
+						continue
+					}
+					if !crAddr.Module.Equal(addr.Module) || crAddr.Resource != addr.Resource {
+						// Not the same resource
+						continue
+					}
+
+					log.Printf("[TRACE] AttachResourceConfigTransformer: attaching to %q (%T) removed block from %#v", dag.VertexName(v), v, r.DeclRange)
+
+					// Validation ensures that there can't be both a resource
+					// block and a removed block referring to the same
+					// configuration, so we can assume that this isn't
+					// clobbering a non-removed resource configuration we
+					// already attached above.
+					arn.AttachResourceConfig(nil, r)
+				}
+			}
 			continue
 		}
 
