+func parseOptStringList(d *caddyfile.Dispenser, existing interface{}) (interface{}, error) {
+	var vals []string
+	if existing != nil {
+		existingVals, ok := existing.([]string)
+		if !ok {
+			return nil, d.Errf("existing value is not a string list: %T", existing)
+		}
+		vals = existingVals
+	}
+	for d.Next() {
+		vals = append(vals, d.RemainingArgs()...)
+	}
+	if len(vals) == 0 {
+		return nil, d.ArgErr()
+	}
+	return vals, nil
+}
