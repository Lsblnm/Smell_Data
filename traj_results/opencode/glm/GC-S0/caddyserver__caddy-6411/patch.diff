+	// Trim a single trailing newline from the file contents, following
+	// the unix convention that text files end with a newline; this
+	// makes it convenient to store values in files without the
+	// trailing newline interfering with the replacement, e.g. secrets.
+	if bytes.HasSuffix(body, []byte("\r\n")) {
+		body = body[:len(body)-2]
+	} else if bytes.HasSuffix(body, []byte("\n")) {
+		body = body[:len(body)-1]
+	}
 	return string(body), true
