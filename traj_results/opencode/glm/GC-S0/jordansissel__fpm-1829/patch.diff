diff --git a/lib/fpm/package/deb.rb b/lib/fpm/package/deb.rb
index c4b54c6..1372ecb 100644
--- a/lib/fpm/package/deb.rb
+++ b/lib/fpm/package/deb.rb
@@ -797,6 +797,17 @@ class FPM::Package::Deb < FPM::Package
       logger.warn("Replacing 'provides' entry #{provides} with syntax 'name (= version)'")
       provides = "#{m[1]} (= #{m[2]})"
     end
+
+    # Debian policy only allows "name" or "name (= version)" in the Provides
+    # field. Reject anything else, like "name (<< version)", because dpkg
+    # cannot handle relational operators in Provides.
+    # https://www.debian.org/doc/debian-policy/ch-relationships.html
+    unless provides =~ /^([^ \(]+)$/ or provides =~ /^([^ \(]+) \(= ([0-9][A-Za-z0-9+:.~-]*)\)$/
+      raise FPM::InvalidPackageConfiguration,
+        "Invalid provides entry '#{provides}'. Debian packages only support " \
+        "'name' or 'name (= version)' in the Provides field. " \
+        "https://www.debian.org/doc/debian-policy/ch-relationships.html"
+    end
     return provides.rstrip
   end
 
