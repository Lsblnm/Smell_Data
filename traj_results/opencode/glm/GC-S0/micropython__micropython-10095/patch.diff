diff --git a/py/runtime.c b/py/runtime.c
index 23fae6041..273767ede 100644
--- a/py/runtime.c
+++ b/py/runtime.c
@@ -907,6 +907,21 @@ void mp_call_prepare_args_n_kw_var(bool have_self, size_t n_args_n_kw, const mp_
         }
     }
 
+    // Check for duplicate keyword arguments.  This can happen if the same key
+    // is provided by more than one ** unpacking, or by a ** unpacking and an
+    // explicit keyword argument.  All keys are qstrs at this point (they are
+    // interned above, and explicit keyword args are qstrs), so identity
+    // comparison is sufficient.
+    for (size_t i = pos_args_len; i < args2_len; i += 2) {
+        for (size_t j = i + 2; j < args2_len; j += 2) {
+            if (args2[i] == args2[j]) {
+                mp_raise_msg_varg(&mp_type_TypeError,
+                    MP_ERROR_TEXT("function got multiple values for keyword argument '%q'"),
+                    MP_OBJ_QSTR_VALUE(args2[j]));
+            }
+        }
+    }
+
     out_args->fun = fun;
     out_args->args = args2;
     out_args->n_args = pos_args_len;
