+    /// If a path does not have a syntax mapping, try again with the ignored
+    /// suffixes stripped from the file name, e.g. `test.demo.suffix` with
+    /// `--ignored-suffix=.suffix` becomes `test.demo` which can then be
+    /// matched by a `--map-syntax=*.demo:JSON` mapping.
+    fn get_syntax_for_with_stripped_suffix(
+        &self,
+        path: impl AsRef<Path>,
+    ) -> Option<MappingTarget<'a>> {
+        let file_name = path.as_ref().file_name()?.to_str()?;
+        if let Some(stripped_file_name) = self.peek_stripped_suffix(file_name) {
+            let stripped_path = Path::new(stripped_file_name);
+            return self
+                .get_syntax_for(stripped_path)
+                .or_else(|| self.get_syntax_for_with_stripped_suffix(stripped_path));
+        }
+        None
+    }
