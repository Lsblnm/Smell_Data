 template <typename Formatter>
 FMT_CONSTEXPR void maybe_set_debug_format(Formatter&, ...) {}
 
+template <typename T>
+struct is_range_char_type
+    : std::integral_constant<bool, std::is_same<T, char>::value ||
+                                       std::is_same<T, wchar_t>::value ||
+                                       std::is_same<T, char16_t>::value ||
+                                       std::is_same<T, char32_t>::value
+#ifdef __cpp_char8_t
+                                       || std::is_same<T, char8_t>::value
+#endif
+                            > {};
+
+// Writes a char with escaping but no surrounding quotes, for use in the
+// C++23 debug string (``?s``) range format.
+template <typename Char, typename OutputIt>
+auto write_escaped_range_char(OutputIt out, Char value) -> OutputIt {
+  if (needs_escape(static_cast<uint32_t>(value)) ||
+      value == static_cast<Char>('"')) {
+    Char buf[1] = {value};
+    out = write_escaped_cp(
+        out,
+        find_escape_result<Char>{buf, buf + 1, static_cast<uint32_t>(value)});
+  } else {
+    *out++ = value;
+  }
+  return out;
+}
+
+// Writes a single range element when formatting a range of characters as a
+// string (C++23 ``s`` and ``?s`` formats).
+template <typename Char, typename OutputIt, typename T,
+          FMT_ENABLE_IF(is_range_char_type<T>::value)>
+auto write_range_item(OutputIt out, const T& value, bool debug) -> OutputIt {
+  auto c = static_cast<Char>(value);
+  if (debug) return write_escaped_range_char(out, c);
+  *out++ = c;
+  return out;
+}
+
+template <typename Char, typename OutputIt, typename T,
+          FMT_ENABLE_IF(!is_range_char_type<T>::value)>
+auto write_range_item(OutputIt out, const T&, bool) -> OutputIt {
+  // Unreachable: parsing rejects 's' for non-character element types.
+  return out;
+}
