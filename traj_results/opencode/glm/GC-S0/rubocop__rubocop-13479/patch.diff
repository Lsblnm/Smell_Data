       # `#` denoting the start of the comment. The leading space is not
       # required for some RDoc special syntax, like `#++`, `#--`,
       # `#:nodoc`, `=begin`- and `=end` comments, "shebang" directives,
-      # or rackup options.
+      # or rackup options. A multiline shebang, i.e. consecutive lines
+      # starting with `#!` beginning on the first line of the file, is
+      # also allowed.
       #
       # @example
       #
@@ -136,10 +138,14 @@ module RuboCop
         def on_new_investigation # rubocop:disable Metrics/AbcSize, Metrics/CyclomaticComplexity, Metrics/PerceivedComplexity
           @leading_comment_records = []
           @leading_comment_flags = {}
+          @multiline_shebang_last_line = nil
           bind_leading_comment_workspace
           processed_source.comments.each do |comment|
             next unless /\A(?!#\+\+|#--)(#+[^#\s=])/.match?(comment.text)
+
+            track_multiline_shebang_start(comment)
             next if comment.loc.line == 1 && allowed_on_first_line?(comment)
+            next if multiline_shebang_continuation?(comment)
             next if doxygen_comment_style?(comment)
             next if gemfile_ruby_comment?(comment)
             next if rbs_inline_annotation?(comment)
@@ -172,6 +178,25 @@ module RuboCop
           allowed
         end
 
+        def track_multiline_shebang_start(comment)
+          return unless comment.loc.line == 1
+          return unless shebang?(comment)
+
+          @multiline_shebang_last_line = comment.loc.line
+        end
+
+        def multiline_shebang_continuation?(comment)
+          return false unless @multiline_shebang_last_line
+          return false unless shebang?(comment)
+
+          if comment.loc.line == @multiline_shebang_last_line + 1
+            @multiline_shebang_last_line = comment.loc.line
+            true
+          else
+            false
+          end
+        end
+
         def shebang?(comment)
           comment.text.start_with?('#!')
         end
