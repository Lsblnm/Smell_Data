+/* Return 1 if the command currently being executed is TOUCH. When TOUCH is
+ * invoked from a script (EVAL/FCALL) or via the module API, server.current_client
+ * still refers to the client that entered the script, while the actual command
+ * runs on the script/module client tracked by server.executing_client. */
+static int currentCommandIsTouch(void) {
+    if (server.executing_client && server.executing_client->cmd &&
+        server.executing_client->cmd->proc == touchCommand) {
+        return 1;
+    }
+    if (server.current_client && server.current_client->cmd &&
+        server.current_client->cmd->proc == touchCommand) {
+        return 1;
+    }
+    return 0;
+}
