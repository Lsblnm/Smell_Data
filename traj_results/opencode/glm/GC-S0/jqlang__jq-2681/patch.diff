+    if (i->source.start == UNKNOWN_LOCATION.start &&
+        i->source.end == UNKNOWN_LOCATION.end) {
+      i->source = loc;
+      i->locfile = locfile_retain(l);
+    }
+  }
+  return b;
+}
+
+block jq_ps_gen_noop() {
+  jq_parser_front.last_fold_op = 0;
+
+  block b = {0,0};
+  return b;
+}
+
+int jq_ps_block_is_noop(block b) {
+  jq_parser_front.error_count += (jq_parser_front.error_count < 0);
+  return (b.first == 0 && b.last == 0);
+}
+
+block jq_ps_gen_op_simple(opcode op) {
+  jq_parser_front.error_count += (jq_parser_front.error_count < 0);
+  assert(opcode_describe(op)->length == 1);
+  return jq_ps_inst_block(jq_ps_inst_new(op));
+}
