+
+block jq_ps_gen_const(jv constant) {
+  jq_parser_front.fold_attempts++;
+  jq_parser_front.last_const_kind = (int)jv_get_kind(constant);
+
+  assert(opcode_describe(LOADK)->flags & OP_HAS_CONSTANT);
+  inst* i = jq_ps_inst_new(LOADK);
+  i->imm.constant = constant;
+  return jq_ps_inst_block(i);
+}
+
+block jq_ps_gen_const_global(jv constant, const char *name) {
+  jq_parser_front.fold_attempts++;
+  assert((opcode_describe(STORE_GLOBAL)->flags & (OP_HAS_CONSTANT | OP_HAS_VARIABLE | OP_HAS_BINDING)) ==
+         (OP_HAS_CONSTANT | OP_HAS_VARIABLE | OP_HAS_BINDING));
+  inst* i = jq_ps_inst_new(STORE_GLOBAL);
+  i->imm.constant = constant;
+  i->symbol = strdup(name);
+  i->any_unbound = 0;
+  return jq_ps_inst_block(i);
+}
+
+block jq_ps_gen_op_pushk_under(jv constant) {
+  jq_parser_front.fold_attempts++;
+  assert(opcode_describe(PUSHK_UNDER)->flags & OP_HAS_CONSTANT);
+  inst* i = jq_ps_inst_new(PUSHK_UNDER);
+  i->imm.constant = constant;
+  return jq_ps_inst_block(i);
+}
+
+int jq_ps_block_is_const(block b) {
+  jq_parser_front.error_count += (jq_parser_front.error_count < 0);
+  return (jq_ps_block_is_single(b) && (b.first->op == LOADK || b.first->op == PUSHK_UNDER));
+}
+
+int jq_ps_block_is_const_inf(block b) {
+  jq_parser_front.error_count += (jq_parser_front.error_count < 0);
+  return (jq_ps_block_is_single(b) && b.first->op == LOADK &&
+          jv_get_kind(b.first->imm.constant) == JV_KIND_NUMBER &&
+          isinf(jv_number_value(b.first->imm.constant)));
+}
+
+jv_kind jq_ps_block_const_kind(block b) {
+  jq_parser_front.error_count += (jq_parser_front.error_count < 0);
+  assert(jq_ps_block_is_const(b));
+  return jv_get_kind(b.first->imm.constant);
+}
+
+jv jq_ps_block_const(block b) {
+  jq_parser_front.error_count += (jq_parser_front.error_count < 0);
+  assert(jq_ps_block_is_const(b));
+  return jv_copy(b.first->imm.constant);
+}
