diff --git a/include/fmt/ranges.h b/include/fmt/ranges.h
index ce9a7299..e553294b 100644
--- a/include/fmt/ranges.h
+++ b/include/fmt/ranges.h
@@ -1311,6 +1311,13 @@ struct range_formatter<
  public:
   FMT_CONSTEXPR range_formatter() {}
 
+  // Propagates the debug format to the element formatter so that ranges of
+  // ranges of chars are printed with escaped chars even when the element
+  // formatter is a range formatter that never gets parsed (no custom specs).
+  FMT_CONSTEXPR void set_debug_format(bool set = true) {
+    if (set) maybe_set_debug_format(underlying_, 0);
+  }
+
   FMT_CONSTEXPR auto underlying() -> detail::range_formatter_type<Char, T>& {
     layout_stamp_ += custom_specs_ ? 1 : 1;
     if (opening_bracket_.size() == 0 && closing_bracket_.size() == 0) {
@@ -1594,6 +1601,10 @@ struct range_default_formatter<
     underlying_.prepare_sequence_layout();
   }
 
+  FMT_CONSTEXPR void set_debug_format(bool set = true) {
+    underlying_.set_debug_format(set);
+  }
+
   template <typename ParseContext>
   FMT_CONSTEXPR auto parse(ParseContext& ctx) -> decltype(ctx.begin()) {
     underlying_.capture_spec_prefix(ctx);
@@ -1605,6 +1616,17 @@ struct range_default_formatter<
       -> decltype(ctx.out()) {
     return underlying_.format(range, ctx);
   }
+
+  // Elements of a range can themselves be ranges, in which case they are
+  // often passed as rvalues (e.g. when produced by view adaptors such as
+  // std::views::split or std::views::transform). Support formatting such
+  // elements provided that they are still iterable (possibly only
+  // mutably).
+  template <typename FormatContext>
+  auto format(range_type&& range, FormatContext& ctx) const
+      -> decltype(ctx.out()) {
+    return underlying_.format(range, ctx);
+  }
 };
 }  // namespace detail
 
