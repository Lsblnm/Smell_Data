+#[cfg(unix)]
+fn parse_signal(value: &str) -> UResult<Signal> {
+    if let Ok(num) = value.parse::<i32>() {
+        if let Ok(signal) = Signal::try_from(num) {
+            return Ok(signal);
+        }
+    }
+    let upper = value.to_uppercase();
+    let name = match upper.strip_prefix("SIG") {
+        Some(rest) if !rest.is_empty() => rest,
+        _ => &upper,
+    };
+    if let Ok(signal) = format!("SIG{name}").parse::<Signal>() {
+        return Ok(signal);
+    }
+    Err(USimpleError::new(
+        125,
+        format!("{}: invalid signal", value.quote()),
+    ))
+}
+
+#[cfg(unix)]
+fn apply_ignore_signals(opts: &Options<'_>) -> UResult<()> {
+    if opts.ignore_all_signals {
+        // Some signals cannot be ignored (e.g., SIGKILL, SIGSTOP), so ignore errors.
+        for num in 1..=64 {
+            if let Ok(signal) = Signal::try_from(num) {
+                let action = SigAction::new(SigHandler::SigIgn, SaFlags::empty(), SigSet::all());
+                let _ = unsafe { sigaction(signal, &action) };
+            }
+        }
+        return Ok(());
+    }
+    for signal in &opts.ignore_signals {
+        let action = SigAction::new(SigHandler::SigIgn, SaFlags::empty(), SigSet::all());
+        unsafe { sigaction(*signal, &action) }.map_err(|err| {
+            USimpleError::new(
+                125,
+                format!(
+                    "failed to set signal action for signal {}: {}",
+                    *signal as i32,
+                    err.desc()
+                ),
+            )
+        })?;
+    }
+    Ok(())
+}
