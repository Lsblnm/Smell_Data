+        def load_glob(path)
+          entries = []
+          Dir.glob(path.to_s).each do |matched_path|
+            loaded = load(Pathname.new(matched_path))
+            if loaded.is_a?(Array)
+              entries.concat(loaded)
+            else
+              entries << loaded
+            end
+          end
