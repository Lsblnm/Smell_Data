+// equalImportChains returns whether both import chains are
+// equivalent; tokens with different chains come from different
+// import statements, even within the same file.
+func equalImportChains(a, b []string) bool {
+	if len(a) != len(b) {
+		return false
+	}
+	for i := range a {
+		if a[i] != b[i] {
+			return false
+		}
+	}
+	return true
+}
