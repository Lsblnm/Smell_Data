+/// Returns `true` if the operands of a comparison are of types whose `__eq__`
+/// and `__ne__` methods are known to return `bool`, in which case replacing
+/// `not a == b` with `a != b` (and vice versa) cannot change the behavior of
+/// the expression.
+fn has_boolean_equality(left: &Expr, right: &Expr) -> bool {
+    matches!(
+        (
+            ResolvedPythonType::from(left),
+            ResolvedPythonType::from(right)
+        ),
+        (ResolvedPythonType::Atom(_), ResolvedPythonType::Atom(_))
+    )
+}
