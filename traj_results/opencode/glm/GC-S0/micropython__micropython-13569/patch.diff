diff --git a/py/compile.c b/py/compile.c
index f97fee499..8af63c104 100644
--- a/py/compile.c
+++ b/py/compile.c
@@ -1684,7 +1684,15 @@ STATIC void compile_try_finally(compiler_t *comp, mp_parse_node_t pn_body, int n
     }
     EMIT_ARG(load_const_tok, MP_TOKEN_KW_NONE);
     EMIT_ARG(label_assign, l_finally_block);
+    // The finally block can also be entered by a return, break or continue that
+    // unwinds through it, in which case there is an extra value on the stack
+    // (the return value, or the destination ip for a jump) above the sentinel
+    // that marks the unwinding state.  That's one more than the normal-entry
+    // case of just the None value, so adjust the stack size by 1 to ensure the
+    // function is allocated enough Python stack for the finally block.
+    EMIT_ARG(adjust_stack_size, 1);
     compile_node(comp, pn_finally);
+    EMIT_ARG(adjust_stack_size, -1);
 
     compile_decrease_except_level(comp);
 }
