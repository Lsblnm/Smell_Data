diff --git a/jq.1.prebuilt b/jq.1.prebuilt
index 3c63997..a18e10e 100644
--- a/jq.1.prebuilt
+++ b/jq.1.prebuilt
@@ -117,6 +117,9 @@ By default, jq outputs colored JSON if writing to a terminal\. You can force it
 .IP
 Colors can be configured with the \fBJQ_COLORS\fR environment variable (see below)\.
 .
+.IP
+To disable color output via the environment, set the \fBNO_COLOR\fR environment variable to a non\-empty value\. jq will then output monochrome JSON even if writing to a terminal, unless color is forced with \fB\-C\fR\.
+.
 .TP
 \fB\-\-binary\fR / \fB\-b\fR:
 .
diff --git a/src/main.c b/src/main.c
index f308359..a8224bf 100644
--- a/src/main.c
+++ b/src/main.c
@@ -1109,6 +1109,15 @@ int main(int argc, char* argv[]) {
   if (options & COLOR_OUTPUT) dumpopts |= JV_PRINT_COLOR;
   if (options & NO_COLOR_OUTPUT) dumpopts &= ~JV_PRINT_COLOR;
 
+  /* Honor the NO_COLOR environment variable (https://no-color.org/):
+     if it is set to a non-empty value, disable color output, unless
+     color was explicitly forced on with -C / --color-output. */
+  {
+    const char *no_color = getenv("NO_COLOR");
+    if (no_color != NULL && no_color[0] != '\0' && (options & COLOR_OUTPUT) == 0)
+      dumpopts &= ~JV_PRINT_COLOR;
+  }
+
   jq_session_clear_option(&session, 0);
   jq_session_set_dumpopts(&session, dumpopts);
 #ifdef USE_ISATTY
