diff --git a/include/fmt/core.h b/include/fmt/core.h
index 5f66cc8d..f529ed92 100644
--- a/include/fmt/core.h
+++ b/include/fmt/core.h
@@ -2014,7 +2014,7 @@ template <typename Char> class specs_setter {
   FMT_CONSTEXPR void on_localized() { specs_.localized = true; }
 
   FMT_CONSTEXPR void on_zero() {
-    specs_.align = align::numeric;
+    if (specs_.align == align::none) specs_.align = align::numeric;
     specs_.fill[0] = Char('0');
   }
 
diff --git a/include/fmt/format.h b/include/fmt/format.h
index efa1d57c..c03c66c0 100644
--- a/include/fmt/format.h
+++ b/include/fmt/format.h
@@ -1623,10 +1623,20 @@ OutputIt write_nonfinite(OutputIt out, bool isinf,
   constexpr size_t str_size = 3;
   auto sign = fspecs.sign;
   auto size = str_size + (sign ? 1 : 0);
-  return write_padded(out, specs, size, [=](reserve_iterator<OutputIt> it) {
-    if (sign) *it++ = static_cast<Char>(data::signs[sign]);
-    return copy_str<Char>(str, str + str_size, it);
-  });
+  // Replace '0'-padding with space for non-finite values.
+  auto space_specs = specs;
+  auto space = static_cast<Char>(' ');
+  if (space_specs.fill.size() == 1 &&
+      space_specs.fill[0] == static_cast<Char>('0'))
+    space_specs.fill = basic_string_view<Char>(&space, 1);
+  return write_padded<align::right>(out, space_specs, size,
+                                    [=](reserve_iterator<OutputIt> it) {
+                                      if (sign)
+                                        *it++ =
+                                            static_cast<Char>(data::signs[sign]);
+                                      return copy_str<Char>(str, str + str_size,
+                                                            it);
+                                    });
 }
 
