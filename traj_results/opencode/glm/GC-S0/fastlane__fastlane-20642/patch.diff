diff --git a/frameit/lib/frameit/device.rb b/frameit/lib/frameit/device.rb
index 9bb1427dc..1ccd29f91 100644
--- a/frameit/lib/frameit/device.rb
+++ b/frameit/lib/frameit/device.rb
@@ -58,6 +58,20 @@ module Frameit
       comparable_priority_value > other.priority
     end
 
+    def more_specific_filename_match_than?(filename, other)
+      return false if other.nil? || filename.nil? || @id.nil? || @formatted_name.nil?
+      return false if priority != other.priority
+      longest_filename_match(filename) > other.longest_filename_match(filename)
+    end
+
+    def longest_filename_match(filename)
+      return 0 if filename.nil? || @id.nil? || @formatted_name.nil?
+      filename_match_tokens
+        .select { |token| !token.nil? && !token.to_s.empty? && filename.include?(token) }
+        .map(&:length)
+        .max || 0
+    end
+
     def android_device?
       return false if @id.nil? || @formatted_name.nil?
       @platform == Platform::ANDROID
@@ -410,7 +424,9 @@ module Frameit
         device = Devices.const_get(c)
         next unless device.resolutions.include?(size)
         # assign to filename_device if the filename contains the formatted name / id and its priority is higher than the current filename_device
-        filename_device = device if device.referenced_in_filename?(filename) && (filename_device.nil? || device.preferred_over?(filename_device))
+        # or the priority is the same but this device's name is a more specific match for the filename
+        # (e.g. "iPhone 13 Pro" is a more specific match than "iPhone 13" for "Simulator Screen Shot - iPhone 13 Pro")
+        filename_device = device if device.referenced_in_filename?(filename) && (filename_device.nil? || device.preferred_over?(filename_device) || device.more_specific_filename_match_than?(filename, filename_device))
         next unless device.is_chosen_platform?(platform) && (found_device.nil? || device.preferred_over?(found_device))
         found_device = device
       end
