+// validateImportTargets evaluates the expressions within any import blocks
+// associated with this resource, ensuring that the import target and ID
+// expressions are valid before attempting to create a plan.
+func (n *NodeValidatableResource) validateImportTargets(ctx EvalContext) tfdiags.Diagnostics {
+	var diags tfdiags.Diagnostics
+	if len(n.importTargets) == 0 {
+		return diags
+	}
+
+	// Import blocks are only valid within the root module, and must be
+	// evaluated within that context.
+	ctx = evalContextForModuleInstance(ctx, addrs.RootModuleInstance)
+
+	for _, imp := range n.importTargets {
+		if imp.Config == nil {
+			// a legacy import target from the command line has no
+			// configuration to validate
+			continue
+		}
+
+		if imp.Config.ForEach == nil {
+			traversal, hclDiags := hcl.AbsTraversalForExpr(imp.Config.To)
+			diags = diags.Append(hclDiags)
+			if diags.HasErrors() {
+				return diags
+			}
+			to, toDiags := addrs.ParseAbsResourceInstance(traversal)
+			diags = diags.Append(toDiags)
+			if diags.HasErrors() {
+				return diags
+			}
+
+			_, idDiags := evaluateImportIdExpression(imp.Config.ID, to, ctx, EvalDataForNoInstanceKey, true)
+			diags = diags.Append(idDiags)
+			continue
+		}
+
+		forEachData, _, forEachDiags := newForEachEvaluator(imp.Config.ForEach, ctx, true).ImportValues()
+		diags = diags.Append(forEachDiags)
+		if diags.HasErrors() {
+			return diags
+		}
+
+		for _, keyData := range forEachData {
+			to, evalDiags := evalImportToExpression(imp.Config.To, keyData)
+			diags = diags.Append(evalDiags)
+			if diags.HasErrors() {
+				return diags
+			}
+
+			_, idDiags := evaluateImportIdExpression(imp.Config.ID, to, ctx, keyData, true)
+			diags = diags.Append(idDiags)
+		}
+	}
+
+	return diags
+}
