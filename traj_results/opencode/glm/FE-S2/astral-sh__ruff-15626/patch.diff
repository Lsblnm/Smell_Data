+/// Returns `true` if the `__eq__` and `__ne__` methods of the expression's type
+/// are known to return `bool`. The methods of most builtin types return `bool`,
+/// but user-defined types, like `np.array`, may return any type. Expressions of
+/// an unknown type are conservatively assumed to be of such a user-defined type.
+fn expr_returns_bool(expr: &Expr, semantic: &SemanticModel) -> bool {
+    match ResolvedPythonType::from(expr) {
+        ResolvedPythonType::Atom(ty) => type_returns_bool(ty),
+        ResolvedPythonType::Union(types) => types.iter().all(|ty| type_returns_bool(*ty)),
+        // For a reference to a builtin type itself (e.g., `int`), the result of a
+        // comparison is `bool`, as the `__eq__` and `__ne__` methods of `type` fall
+        // back to identity comparisons.
+        ResolvedPythonType::Unknown | ResolvedPythonType::TypeError => semantic
+            .resolve_builtin_symbol(expr)
+            .is_some_and(|name| {
+                matches!(
+                    name,
+                    "bool"
+                        | "int"
+                        | "float"
+                        | "complex"
+                        | "str"
+                        | "bytes"
+                        | "bytearray"
+                        | "list"
+                        | "tuple"
+                        | "dict"
+                        | "set"
+                        | "frozenset"
+                        | "range"
+                )
+            }),
+    }
+}
+
+/// Returns `true` if the `__eq__` and `__ne__` methods of the given builtin type
+/// are known to return `bool`.
+fn type_returns_bool(ty: PythonType) -> bool {
+    matches!(
+        ty,
+        PythonType::None
+            | PythonType::Number(_)
+            | PythonType::String
+            | PythonType::Bytes
+            | PythonType::Dict
+            | PythonType::List
+            | PythonType::Set
+            | PythonType::Tuple
+            // Types without custom `__eq__` methods, whose comparisons fall back
+            // to identity comparisons, which return `bool`.
+            | PythonType::Ellipsis
+            | PythonType::Generator
+    )
+}
