+function extractAndWrapNodes(
+  parentNode: Rule | AtRule,
+  wrap: NestedRuleWrap,
+  nodeTypes: NestedNodeTypes,
+): void {
+  if (!parentNode.nodes) return
+  const nodes = parentNode.nodes.filter(
+    node =>
+      node.type === nodeTypes.declType || node.type === nodeTypes.commentType,
+  )
+  if (nodes.length) {
+    for (const node of nodes) {
+      parentNode.removeChild(node)
+    }
+    const wrappedRule = new Rule({
+      nodes,
+      selector: wrap.hostSelector,
+    })
+    parentNode.prepend(wrappedRule)
+  }
+}
+
 function isSpaceCombinator(node: selectorParser.Node) {
   return node.type === 'combinator' && /^\s+$/.test(node.value)
