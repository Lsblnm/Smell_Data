+    private static function worksheetHasTableNamed(Worksheet $worksheet, string $tableName): bool
+    {
+        if ($worksheet->getTableByName($tableName) !== null) {
+            return true;
+        }
+        $spreadsheet = $worksheet->getParent();
+        if ($spreadsheet !== null) {
+            foreach ($spreadsheet->getAllSheets() as $candidateWorksheet) {
+                if ($candidateWorksheet->getTableByName($tableName) !== null) {
+                    return true;
+                }
+            }
+        }
+
+        return false;
+    }
