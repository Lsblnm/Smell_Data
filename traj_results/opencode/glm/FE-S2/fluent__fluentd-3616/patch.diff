diff --git a/lib/fluent/plugin/in_http.rb b/lib/fluent/plugin/in_http.rb
index e7b77d7a..a3e630d6 100644
--- a/lib/fluent/plugin/in_http.rb
+++ b/lib/fluent/plugin/in_http.rb
@@ -316,6 +316,16 @@ module Fluent::Plugin
         @parser_json.parse(js) do |_time, record|
           return nil, record
         end
+      elsif ndjson = params['ndjson']
+        records = []
+        ndjson.split(/\r?\n/).each do |value|
+          next if value.empty?
+          @parser_json.parse(value) do |_time, record|
+            raise "Received event is not json: #{value}" if record.nil?
+            records.push(record)
+          end
+        end
+        return nil, records
       else
         raise "'json' or 'msgpack' parameter is required"
       end
