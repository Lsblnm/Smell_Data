@@ -636,26 +636,40 @@ impl<W: WriteColor> Standard<W> {
             dst.clear();
             matches.clear();
 
+            // The subject may extend beyond `range` in multi-line mode to
+            // permit look-ahead in the regex. But the replacement itself
+            // should be limited to the range reported by the searcher. So we
+            // implement the replacement ourselves instead of using
+            // `replace_with_captures_at`, which copies all unmatched bytes
+            // within the subject (and would thus copy bytes beyond `range`).
+            //
+            // Note that the end of the range is clamped to the length of the
+            // subject because in single-line mode, the line terminator is
+            // trimmed from the subject.
+            let mut last_match = range.start;
+            let range_end = cmp::min(range.end, subject.len());
             matcher
-                .replace_with_captures_at(
-                    subject,
-                    range.start,
-                    caps,
-                    dst,
-                    |caps, dst| {
-                        let start = dst.len();
-                        caps.interpolate(
-                            |name| matcher.capture_index(name),
-                            subject,
-                            replacement,
-                            dst,
-                        );
-                        let end = dst.len();
-                        matches.push(Match::new(start, end));
-                        true
-                    },
-                )
+                .try_captures_iter_at(subject, range.start, caps, |caps| {
+                    let m = caps.get(0).unwrap();
+                    if m.start() >= range_end {
+                        return Ok::<bool, io::Error>(false);
+                    }
+                    dst.extend(&subject[last_match..m.start()]);
+                    last_match = m.end();
+                    let start = dst.len();
+                    caps.interpolate(
+                        |name| matcher.capture_index(name),
+                        subject,
+                        replacement,
+                        dst,
+                    );
+                    let end = dst.len();
