diff --git a/lib/fpm/package/deb.rb b/lib/fpm/package/deb.rb
index e8f7889..70a171b 100644
--- a/lib/fpm/package/deb.rb
+++ b/lib/fpm/package/deb.rb
@@ -827,6 +827,30 @@ class FPM::Package::Deb < FPM::Package
       logger.warn("Replacing 'provides' entry #{provides} with syntax 'name (= version)'")
       provides = "#{m[1]} (= #{m[2]})"
     end
+
+    # Validate the provides entry.
+    # Debian policy only allows exact versions in Provides fields, using
+    # the '=' relation: https://www.debian.org/doc/debian-policy/ch-relationships.html
+    m = provides.match(/^([A-Za-z0-9][A-Za-z0-9+.-]*)(?:\s*\((.*)\))?\s*$/)
+    if m.nil?
+      raise FPM::InvalidPackageConfiguration,
+        "Invalid provides entry '#{provides}' in deb package output. Provides entries " \
+        "must be in the form 'name' or 'name (= version)'"
+    end
+
+    name, version = m[1..2]
+    if !version.nil?
+      if version !~ /^=\s*(\S+)\s*$/
+        raise FPM::InvalidPackageConfiguration,
+          "Invalid provides entry '#{provides}' in deb package output. Only exact versions " \
+          "are allowed in Provides, and only using the '=' relation (example: '#{name} (= 1.2.3)')"
+      end
+      dep_version = $1
+      if dep_version !~ /^(?:[0-9]+:)?[A-Za-z0-9.+~]+(?:-[A-Za-z0-9.+~]+)?$/
+        raise FPM::InvalidPackageConfiguration,
+          "Invalid version '#{dep_version}' in provides entry '#{provides}' in deb package output."
+      end
+    end
     return provides.rstrip
   end
 
