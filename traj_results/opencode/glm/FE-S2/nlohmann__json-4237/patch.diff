diff --git a/include/nlohmann/detail/conversions/to_json.hpp b/include/nlohmann/detail/conversions/to_json.hpp
index 701261d5..0202a23a 100644
--- a/include/nlohmann/detail/conversions/to_json.hpp
+++ b/include/nlohmann/detail/conversions/to_json.hpp
@@ -332,7 +332,14 @@ inline void to_json(BasicJsonType& j, EnumType e) noexcept
     using cleaner_type = typename std::conditional<sizeof(BasicJsonType) != 0, json_storage_cleaner, json_storage_cleaner>::type;
     cleaner_type cleaner{};
     cleaner.release_storage(j);
-    cleaner.assign_integer(j, static_cast<underlying_type>(e));
+    if (std::is_unsigned<underlying_type>::value)
+    {
+        cleaner.assign_integer(j, static_cast<typename BasicJsonType::number_unsigned_t>(e));
+    }
+    else
+    {
+        cleaner.assign_integer(j, static_cast<underlying_type>(e));
+    }
 }
 #endif  // JSON_DISABLE_ENUM_SERIALIZATION
 
diff --git a/include/nlohmann/json.hpp b/include/nlohmann/json.hpp
index 91c1d0d3..1b5b745d 100644
--- a/include/nlohmann/json.hpp
+++ b/include/nlohmann/json.hpp
@@ -224,8 +224,16 @@ class json_storage_cleaner
     template<typename BasicJsonType, typename NumberType>
     void assign_integer(BasicJsonType& j, NumberType val)
     {
-        j.m_data.m_type = value_t::number_integer;
-        j.m_data.m_value = val;
+        if (std::is_integral<NumberType>::value && std::is_unsigned<NumberType>::value)
+        {
+            j.m_data.m_type = value_t::number_unsigned;
+            j.m_data.m_value = static_cast<typename BasicJsonType::number_unsigned_t>(val);
+        }
+        else
+        {
+            j.m_data.m_type = value_t::number_integer;
+            j.m_data.m_value = static_cast<typename BasicJsonType::number_integer_t>(val);
+        }
         j.assert_invariant();
     }
 };
