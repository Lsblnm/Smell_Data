+	// Trim a single trailing newline from the file contents, if any.
+	// It is common for text files to end with a newline, but having
+	// it in the replacement is usually not expected or desired,
+	// e.g. when reading secrets from a file. (See issue #6410.)
+	// We only trim one newline so that files with multiple trailing
+	// newlines retain their intentional extra newlines.
+	body = bytes.TrimSuffix(body, []byte("\n"))
