diff --git a/lib/jekyll/data_entry.rb b/lib/jekyll/data_entry.rb
new file mode 100644
index 000000000..df512a0bd
--- /dev/null
+++ b/lib/jekyll/data_entry.rb
@@ -0,0 +1,61 @@
+# frozen_string_literal: true
+
+module Jekyll
+  # Wraps individual entries of a {DataHash} to expose the underlying data
+  # object while keeping the entry recognizable as data loaded from a file.
+  class DataEntry
+    attr_reader :data
+
+    def initialize(data)
+      @data = data
+    end
+
+    # Expose the underlying data object as its Liquid representation.
+    #
+    # Returns the underlying data object.
+    def to_liquid
+      data
+    end
+
+    def <=>(other)
+      data <=> unwrap(other)
+    end
+
+    def ==(other)
+      data == unwrap(other)
+    end
+    alias eql? ==
+
+    def hash
+      data.hash
+    end
+
+    def to_s
+      data.to_s
+    end
+
+    def inspect
+      data.inspect
+    end
+
+    # Delegate unrecognized methods to the underlying data object so that an
+    # entry behaves like the data it wraps.
+    def method_missing(method_name, *args, &block)
+      if data.respond_to?(method_name)
+        data.send(method_name, *args, &block)
+      else
+        super
+      end
+    end
+
+    def respond_to_missing?(method_name, include_private = false)
+      data.respond_to?(method_name, include_private) || super
+    end
+
+    private
+
+    def unwrap(other)
+      other.is_a?(DataEntry) ? other.data : other
+    end
+  end
+end
diff --git a/lib/jekyll/data_hash.rb b/lib/jekyll/data_hash.rb
new file mode 100644
index 000000000..2d2cf6c73
--- /dev/null
+++ b/lib/jekyll/data_hash.rb
@@ -0,0 +1,110 @@
+# frozen_string_literal: true
+
+module Jekyll
+  # Mimics a ::Hash for site data while keeping track of the data files that
+  # were read to build it. Entries holding container values (Hash or Array)
+  # are exposed wrapped in a {DataEntry}.
+  class DataHash
+    # Create a new DataHash.
+    #
+    # content - a ::Hash with the data itself.
+    # paths   - an ::Array of paths of the files the data was read from.
+    def initialize(content = {}, paths = [])
+      @content = content
+      @paths = paths
+    end
+
+    # Retrieve the data entry for the given key. Values that act as
+    # containers are wrapped in a Jekyll::DataEntry.
+    #
+    # key - the key whose value is to be retrieved.
+    #
+    # Returns the value, wrapped in a DataEntry when it is a Hash or an Array.
+    def [](key)
+      value = @content[key]
+      case value
+      when Hash, Array, DataEntry
+        DataEntry.new(value)
+      else
+        value
+      end
+    end
+
+    # Store the given value under the given key.
+    def []=(key, value)
+      @content[key] = value
+    end
+
+    # The paths of the files the data was read from.
+    #
+    # Returns an ::Array of String paths.
+    def dependency_paths
+      @paths
+    end
+
+    # Expose the underlying content as its Liquid representation.
+    #
+    # Returns a ::Hash.
+    def to_liquid
+      @content
+    end
+
+    def to_h
+      @content
+    end
+    alias to_hash to_h
+
+    def merge(other)
+      self.class.new(@content.merge(content_of(other)), dependency_paths.dup)
+    end
+
+    def merge!(other)
+      other_content = content_of(other)
+      if block_given?
+        @content.merge!(other_content) { |key, old_val, new_val| yield(key, old_val, new_val) }
+      else
+        @content.merge!(other_content)
+      end
+      self
+    end
+
+    def freeze
+      @content.freeze
+      super
+    end
+
+    def to_s
+      @content.to_s
+    end
+
+    def inspect
+      @content.inspect
+    end
+
+    def initialize_copy(other)
+      super
+      @content = @content.dup
+      @paths = @paths.dup
+    end
+
+    # Delegate unrecognized methods to the underlying content so that a
+    # DataHash mimics a ::Hash without being one.
+    def method_missing(method_name, *args, &block)
+      if @content.respond_to?(method_name)
+        @content.send(method_name, *args, &block)
+      else
+        super
+      end
+    end
+
+    def respond_to_missing?(method_name, include_private = false)
+      @content.respond_to?(method_name, include_private) || super
+    end
+
+    private
+
+    def content_of(other)
+      other.is_a?(DataHash) ? other.to_h : other
+    end
+  end
+end
