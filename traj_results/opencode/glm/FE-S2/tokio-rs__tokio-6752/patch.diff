diff --git a/tokio-util/src/time/delay_queue.rs b/tokio-util/src/time/delay_queue.rs
index 1c8c3d3f..f9ec9e15 100644
--- a/tokio-util/src/time/delay_queue.rs
+++ b/tokio-util/src/time/delay_queue.rs
@@ -810,7 +810,15 @@ impl<T> DelayQueue<T> {
 
         if prev_deadline != next_deadline {
             match (next_deadline, &mut state.delay) {
-                (None, _) => state.delay = None,
+                (None, _) => {
+                    state.delay = None;
+
+                    // The queue is empty, so we need to wake up the task that
+                    // polled `poll_expired` and is waiting for the next item.
+                    if let Some(waker) = state.waker.take() {
+                        waker.wake();
+                    }
+                }
                 (Some(deadline), Some(delay)) => delay.as_mut().reset(deadline),
                 (Some(deadline), None) => state.delay = Some(Box::pin(sleep_until(deadline))),
             }
