diff --git a/lib/rubocop/cop/layout/empty_lines_around_method_body.rb b/lib/rubocop/cop/layout/empty_lines_around_method_body.rb
index e6d3bf48b..e44e56ae3 100644
--- a/lib/rubocop/cop/layout/empty_lines_around_method_body.rb
+++ b/lib/rubocop/cop/layout/empty_lines_around_method_body.rb
@@ -27,7 +27,7 @@ module RuboCop
         KIND = 'method'
 
         def on_def(node)
-          check(node, node.body)
+          check(node, node.body, adjusted_first_line: method_header_last_line(node))
         end
         alias on_defs on_def
 
@@ -72,6 +72,13 @@ module RuboCop
 
         private
 
+        # The last line of the method header, i.e. the line with the closing
+        # parenthesis when the arguments span multiple lines. Empty lines are
+        # only allowed (or required) after the header, not inside it.
+        def method_header_last_line(node)
+          node.arguments.source_range&.last_line || node.source_range.first_line
+        end
+
         def style
           :no_empty_lines
         end
