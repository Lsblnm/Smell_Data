 class FormulaTranslator
 {
+    // ODS quoted sheet names (e.g. 'test.bug') may contain periods, which
+    // would otherwise be split by the '.'-based regex conversions below.
+    // Dots inside single-quoted sheet names are therefore temporarily
+    // replaced by this placeholder, and restored after the conversion.
+    private static string $quotedSheetNameDotPlaceholder = '';
+
+    private static function protectDotsInQuotedSheetNames(string $address): string
+    {
+        $placeholder = "\u{0001}";
+        self::$quotedSheetNameDotPlaceholder = $placeholder;
+
+        return (string) preg_replace_callback(
+            '/\'(?:[^\']|\'\')*\'/',
+            fn (array $matches): string => str_replace('.', $placeholder, $matches[0]),
+            $address
+        );
+    }
+
+    private static function restoreDotsInQuotedSheetNames(string $address): string
+    {
+        return str_replace(self::$quotedSheetNameDotPlaceholder, '.', $address);
+    }
+
