+#[cfg(unix)]
+fn process_ignore_signal_opts(matches: &clap::ArgMatches) -> UResult<()> {
+    if let Some(ignore_signals) = matches.get_many::<OsString>("ignore-signal") {
+        for ignore_signal in ignore_signals {
+            let ignore_signal = ignore_signal.to_str().unwrap();
+            if ignore_signal.is_empty() {
+                continue;
+            }
+            for sig_name in ignore_signal.split(',') {
+                if sig_name.is_empty() {
+                    continue;
+                }
+                match signal_by_name_or_value(&sig_name.to_uppercase()) {
+                    Some(sig_num) if sig_num != 0 => {
+                        // Signal 0 cannot be ignored, and neither can SIGKILL nor SIGSTOP.
+                        // The latter two fail in the signal call below.
+                        let nix_signal = Signal::try_from(sig_num as i32).unwrap();
+                        if let Err(e) = unsafe { sigsignal(nix_signal, SigHandler::SigIgn) } {
+                            return Err(USimpleError::new(
+                                125,
+                                format!(
+                                    "failed to set signal action for signal {}: {}",
+                                    sig_num,
+                                    e.desc()
+                                ),
+                            ));
+                        }
+                    }
+                    _ => {
+                        return Err(USimpleError::new(
+                            125,
+                            format!("'{sig_name}': invalid signal"),
+                        ));
+                    }
+                }
+            }
+        }
+    }
+    Ok(())
+}
