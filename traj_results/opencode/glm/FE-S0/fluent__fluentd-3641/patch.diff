--- a/lib/fluent/rpc.rb
+++ b/lib/fluent/rpc.rb
@@ -15,15 +15,14 @@
 #
 
 require 'webrick'
+require 'ipaddr'
 require 'fluent/log'
 
 module Fluent
   module RPC
     class Server
       def initialize(endpoint, log)
-        bind, port = endpoint.split(':')
-        @bind = bind
-        @port = port
+        @bind, @port = parse_endpoint(endpoint)
         @log = log
 
         @server = WEBrick::HTTPServer.new(
@@ -177,6 +176,41 @@ module Fluent
           @thread = nil
         end
       end
+
+      private
+
+      def parse_endpoint(endpoint)
+        if endpoint.start_with?('[')
+          # IPv6 address: [addr]:port
+          m = endpoint.match(/\A\[(.+)\]:(\d+)\z/)
+          addr, port = m&.captures
+        else
+          addr, port = endpoint.split(':')
+          raise ArgumentError, "too many ':' in endpoint" unless addr && port && endpoint.count(':') == 1
+        end
+
+        raise ArgumentError, "port is missing or invalid" unless port && /\A\d+\z/.match(port)
+        raise ArgumentError, "address is missing or invalid" unless addr && valid_address?(addr)
+
+        [addr, port.to_i]
+      rescue ArgumentError
+        raise Fluent::ConfigError, "Invalid rpc_endpoint: #{endpoint}"
+      end
+
+      def valid_address?(addr)
+        begin
+          IPAddr.new(addr)
+          return true
+        rescue ArgumentError
+          # it may be a hostname such as "localhost"
+        end
+        begin
+          Addrinfo.getaddrinfo(addr, nil)
+          true
+        rescue SocketError
+          false
+        end
+      end
     end
   end
 end
