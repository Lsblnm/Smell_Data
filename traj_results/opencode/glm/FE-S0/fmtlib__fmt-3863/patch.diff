diff --git a/include/fmt/ranges.h b/include/fmt/ranges.h
index 7716c635..272af184 100644
--- a/include/fmt/ranges.h
+++ b/include/fmt/ranges.h
@@ -415,6 +415,8 @@ struct range_formatter<
       detail::string_literal<Char, '['>{};
   basic_string_view<Char> closing_bracket_ =
       detail::string_literal<Char, ']'>{};
+  bool is_string_ = false;
+  bool is_debug_string_ = false;
 
  public:
   FMT_CONSTEXPR range_formatter() {}
@@ -444,6 +446,20 @@ struct range_formatter<
       ++it;
     }
 
+    if constexpr (std::is_same<T, Char>::value) {
+      if (it != end && (*it == 's' || *it == '?')) {
+        is_debug_string_ = (*it == '?');
+        if (is_debug_string_) ++it;
+        if (it == end || *it != 's')
+          report_error("invalid format specifier");
+        ++it;
+        is_string_ = true;
+        if (it != end && *it != '}')
+          report_error("invalid format specifier");
+        return it;
+      }
+    }
+
     if (it != end && *it != '}') {
       if (*it != ':') report_error("invalid format specifier");
       ++it;
@@ -455,8 +471,31 @@ struct range_formatter<
     return underlying_.parse(ctx);
   }
 
+  template <typename R, typename FormatContext>
+  auto format_as_string(R& range, FormatContext& ctx) const
+      -> decltype(ctx.out()) {
+    auto out = ctx.out();
+    if (is_debug_string_) {
+      basic_memory_buffer<Char> buffer;
+      for (auto it = range.begin(); it != range.end(); ++it)
+        buffer.push_back(*it);
+      out = detail::write_escaped_string<Char>(
+          out, basic_string_view<Char>(buffer.data(), buffer.size()));
+    } else {
+      *out++ = static_cast<Char>('"');
+      for (auto it = range.begin(); it != range.end(); ++it)
+        *out++ = static_cast<Char>(*it);
+      *out++ = static_cast<Char>('"');
+    }
+    ctx.advance_to(out);
+    return out;
+  }
+
   template <typename R, typename FormatContext>
   auto format(R&& range, FormatContext& ctx) const -> decltype(ctx.out()) {
+    if constexpr (std::is_same<T, Char>::value) {
+      if (is_string_) return format_as_string(range, ctx);
+    }
     detail::format_tuple_element<FormatContext> writer{0, ctx, {}};
     return writer.format_range(*this, range);
   }
