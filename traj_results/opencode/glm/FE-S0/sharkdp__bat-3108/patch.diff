+
+/// Apply "last occurrence wins" semantics between an explicit `--paging`
+/// option and the double plain style (`-pp`), which acts as an alias for
+/// `--style=plain --paging=never` (see '--help').
+///
+/// clap cannot distinguish between a single and a double occurrence of
+/// `--plain`, so this cannot be expressed with `overrides_with`. Instead,
+/// if the plain style count reaches two *after* an explicit `--paging`
+/// option was given, the `--paging` option is removed here. This makes
+/// `--paging` fall back to its default value (`auto`), which is then
+/// disabled by the double plain style in `App::paging_mode`.
+///
+/// This also fixes https://github.com/sharkdp/bat/issues/3108: a single
+/// `--plain` must never override an explicit `--paging` option, e.g.
+/// `bat --paging=never --plain` should not fall back to automatic paging.
+fn resolve_paging_and_plain(mut args: Vec<OsString>) -> Vec<OsString> {
+    fn count_as_plain(arg: &OsStr) -> usize {
+        match arg.to_str() {
+            Some("-pp") => 2,
+            Some("-p") | Some("--plain") => 1,
+            _ => 0,
+        }
+    }
+
+    let mut plain_count = 0;
+    let mut pp_reached_at = None;
+    let mut paging_args = Vec::new();
+    let mut last_paging_at = None;
 
+    let mut i = 1; // skip the program name
+    while i < args.len() {
+        if args[i] == "--" {
+            // Everything after `--` is treated as a file name
+            break;
+        }
+
+        plain_count += count_as_plain(&args[i]);
+        if plain_count >= 2 && pp_reached_at.is_none() {
+            pp_reached_at = Some(i);
+        }
+
+        let arg_str = args[i].to_str().unwrap_or_default();
+        if arg_str == "--paging" {
+            paging_args.push(i);
+            paging_args.push(i + 1);
+            last_paging_at = Some(i);
+            i += 1; // the next argument is the value of `--paging`
+        } else if arg_str.starts_with("--paging=") {
+            paging_args.push(i);
+            last_paging_at = Some(i);
+        }
+
+        i += 1;
+    }
+
+    if let (Some(pp_at), Some(last_paging_at)) = (pp_reached_at, last_paging_at) {
+        if pp_at > last_paging_at {
+            args = args
+                .into_iter()
+                .enumerate()
+                .filter(|(i, _)| !paging_args.contains(i))
+                .map(|(_, arg)| arg)
+                .collect();
+        }
+    }
+
+    args
+}
+
