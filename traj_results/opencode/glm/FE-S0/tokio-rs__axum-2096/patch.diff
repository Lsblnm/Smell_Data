diff --git a/axum/src/routing/path_router.rs b/axum/src/routing/path_router.rs
index a7f372a9..017cc884 100644
--- a/axum/src/routing/path_router.rs
+++ b/axum/src/routing/path_router.rs
@@ -30,6 +30,54 @@ where
         self.replace_endpoint("/", endpoint.clone());
         self.replace_endpoint(&format!("/*{FALLBACK_PARAM}"), endpoint);
     }
+
+    /// Like [`nest`](PathRouter::nest), but skips the fallback endpoints at the
+    /// root. Used when nesting a router that doesn't have a fallback set on
+    /// itself but might contain nested routers that do.
+    ///
+    /// Skipping the root endpoints makes routes under `path` inherit the
+    /// fallback of the router being nested into instead of the default one.
+    pub(super) fn nest_nested_fallbacks(
+        &mut self,
+        path: &str,
+        router: Self,
+    ) -> Result<(), Cow<'static, str>> {
+        let prefix = validate_nest_path(path);
+
+        let PathRouter {
+            routes,
+            node,
+            prev_route_id: _,
+        } = router;
+
+        for (id, endpoint) in routes {
+            let inner_path = node
+                .route_id_to_path
+                .get(&id)
+                .expect("no path for route id. This is a bug in axum. Please file an issue");
+            let inner_path = inner_path.as_ref();
+
+            if inner_path == "/" || inner_path == format!("/*{FALLBACK_PARAM}") {
+                // the fallback endpoints at the root are the default ones.
+                // Skip them such that routes under `path` inherit the fallback
+                // from the router being nested into
+                continue;
+            }
+
+            let path = path_for_nested_route(prefix, inner_path);
+
+            match endpoint.layer(StripPrefix::layer(prefix)) {
+                Endpoint::MethodRouter(method_router) => {
+                    self.route(&path, method_router)?;
+                }
+                Endpoint::Route(route) => {
+                    self.route_endpoint(&path, Endpoint::Route(route))?;
+                }
+            }
+        }
+
+        Ok(())
+    }
 }
 
 impl<S, const IS_FALLBACK: bool> PathRouter<S, IS_FALLBACK>
