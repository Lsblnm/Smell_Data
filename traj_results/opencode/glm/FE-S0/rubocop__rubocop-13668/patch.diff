diff --git a/lib/rubocop/cop/style/sole_nested_conditional.rb b/lib/rubocop/cop/style/sole_nested_conditional.rb
index 9b9c05e11..32a9a95dc 100644
--- a/lib/rubocop/cop/style/sole_nested_conditional.rb
+++ b/lib/rubocop/cop/style/sole_nested_conditional.rb
@@ -135,7 +135,7 @@ module RuboCop
 
         def correct_for_guard_condition_style(corrector, outer_condition, if_branch, and_operator)
           condition = if_branch.condition
-          merged = ConditionCorrector.new(processed_source).replace_condition(condition)
+          merged = merged_condition(condition, if_branch.unless?)
           corrector.insert_after(outer_condition, "#{and_operator}#{merged}")
 
           range = range_between(if_branch.loc.keyword.begin_pos, condition.source_range.end_pos)
@@ -150,7 +150,23 @@ module RuboCop
           corrector.replace(range, and_operator)
           corrector.remove(range_by_whole_lines(node.loc.end, include_final_newline: true))
 
-          wrap_condition(corrector, if_branch.condition)
+          wrap_merged_condition(corrector, if_branch)
+        end
+
+        def merged_condition(condition, negated)
+          merged = ConditionCorrector.new(processed_source).replace_condition(condition)
+          return parenthesize(condition) if negated && wrap_negated_condition?(condition)
+
+          merged
+        end
+
+        def wrap_merged_condition(corrector, if_branch)
+          condition = if_branch.condition
+          if if_branch.unless? && wrap_negated_condition?(condition)
+            corrector.wrap(condition, '(', ')')
+          else
+            wrap_condition(corrector, condition)
+          end
         end
 
         def wrap_condition(corrector, condition)
@@ -171,7 +187,7 @@ module RuboCop
 
         def correct_for_outer_condition_modify_form_style(corrector, node, if_branch)
           condition = if_branch.condition
-          merged = ConditionCorrector.new(processed_source).replace_condition(node.condition)
+          merged = merged_condition(node.condition, node.unless?)
           corrector.insert_before(condition,
                                   "#{'!' if node.unless?}#{merged} && ")
 
@@ -249,6 +265,14 @@ module RuboCop
           "#{method_call}(#{arguments})"
         end
 
+        def parenthesize(condition)
+          "(#{condition.source})"
+        end
+
+        def wrap_negated_condition?(condition)
+          condition.send_type? && condition.comparison_method? && !condition.parenthesized?
+        end
+
         def allow_modifier?
           cop_config['AllowModifier']
         end
