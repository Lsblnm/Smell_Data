+#[cfg(unix)]
+fn parse_signal_name(signal: &str) -> Option<Signal> {
+    if let Ok(num) = signal.parse::<usize>() {
+        // signal 0 (EXIT) is not a valid signal for --ignore-signal
+        return if num > 0 && num < ALL_SIGNALS.len() {
+            Signal::try_from(num as i32).ok()
+        } else {
+            None
+        };
+    }
+    let upper = signal.to_uppercase();
+    let name = upper.strip_prefix("SIG").unwrap_or(&upper);
+    if name.is_empty() {
+        return None;
+    }
+    let num = ALL_SIGNALS.iter().position(|&s| s == name)?;
+    if num == 0 {
+        // signal 0 (EXIT) is not a valid signal for --ignore-signal
+        return None;
+    }
+    Signal::try_from(num as i32).ok()
+}
+
+#[cfg(unix)]
+fn parse_ignore_signal_value_into(signals: &mut Vec<Signal>, value: &OsStr) -> UResult<()> {
+    match value.to_str() {
+        Some(s) => {
+            for token in s.split(',') {
+                if token.is_empty() {
+                    // an empty signal name is a no-op
+                    continue;
+                }
+                let signal = parse_signal_name(token).ok_or_else(|| {
+                    UUsageError::new(125, format!("'{}': invalid signal", token))
+                })?;
+                signals.push(signal);
+            }
+            Ok(())
+        }
+        None => Err(UUsageError::new(
+            125,
+            format!("'{}': invalid signal", value.to_string_lossy()),
+        )),
+    }
+}
+
+#[cfg(unix)]
+fn set_ignored_signals(opts: &Options<'_>) -> UResult<()> {
+    for &signal in &opts.ignore_signals {
+        let action = SigAction::new(SigHandler::SigIgn, SaFlags::empty(), SigSet::all());
+        // SAFETY: setting a signal handler without a custom function is safe
+        let result = unsafe { sigaction(signal, &action) };
+        if let Err(e) = result {
+            if !opts.ignore_signal_errors {
+                return Err(USimpleError::new(
+                    125,
+                    format!(
+                        "failed to set signal action for signal {}: {}",
+                        signal as i32,
+                        e.desc()
+                    ),
+                ));
+            }
+        }
+    }
+    Ok(())
+}
