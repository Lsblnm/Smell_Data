+    /**
+     * @param list<Token> $tokensToInsert
+     *
+     * @return list<string>
+     */
+    private static function getInsertedAttributeSignatures(array $tokensToInsert): array
+    {
+        $signatures = [];
+        $className = '';
+        $arguments = '';
+        $nestingLevel = 0;
+
+        foreach (\array_slice($tokensToInsert, 2) as $token) {
+            if ($token->isGivenKind(CT::T_ATTRIBUTE_CLOSE)) {
+                $signatures[] = ltrim($className, '\\').'|'.$arguments;
+                $className = '';
+                $arguments = '';
+                $nestingLevel = 0;
+                continue;
+            }
+            if ($token->equals('(')) {
+                ++$nestingLevel;
+                continue;
+            }
+            if ($token->equals(')')) {
+                --$nestingLevel;
+                continue;
+            }
+            if ($token->isWhitespace() || $token->isComment()) {
+                continue;
+            }
+            if (0 === $nestingLevel) {
+                $className .= $token->getContent();
+                continue;
+            }
+            $arguments .= $token->getContent();
+        }
+
+        return $signatures;
+    }
+
+    /**
+     * @param array{start: int, end: int, name: string} $attribute
+     */
+    private static function getAttributeArguments(Tokens $tokens, array $attribute): string
+    {
+        $arguments = '';
+        $nestingLevel = 0;
+        for ($index = $attribute['start']; $index <= $attribute['end']; ++$index) {
+            $token = $tokens[$index];
+
+            if ($token->isWhitespace() || $token->isComment()) {
+                continue;
+            }
+            if ($token->equals('(')) {
+                ++$nestingLevel;
+                continue;
+            }
+            if ($token->equals(')')) {
+                --$nestingLevel;
+                continue;
+            }
+            if ($nestingLevel > 0) {
+                $arguments .= $token->getContent();
+            }
+        }
+
+        return $arguments;
+    }
+
     /**
      * @return list<Token>
      */
