+		if (td.superInterfaces != null) {
+			for (TypeReference superInterface : td.superInterfaces) {
+				if (superInterface == null) continue;
+				char[][] interfaceName = superInterface.getTypeName();
+				if (interfaceName.length >= 1) usedNames.add(String.valueOf(interfaceName[0]));
+			}
+		}
+		
 		return usedNames;
 	}
 	
