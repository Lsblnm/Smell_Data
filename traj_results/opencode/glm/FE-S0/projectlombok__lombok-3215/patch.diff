+	/**
+	 * Returns the first (leftmost) segment of a type reference, e.g. "B" for "B", "B.C" or "B.C&lt;D&gt;".
+	 * Only this segment can be shadowed by the builder's type parameters.
+	 */
+	private String extractLeftmostTypeName(JCTree typeTree) {
+		if (typeTree instanceof JCTypeApply) typeTree = ((JCTypeApply) typeTree).getType();
+		while (typeTree instanceof JCFieldAccess) typeTree = ((JCFieldAccess) typeTree).getExpression();
+		if (typeTree instanceof JCIdent) return typeTree.toString();
+		return null;
+	}
 	
