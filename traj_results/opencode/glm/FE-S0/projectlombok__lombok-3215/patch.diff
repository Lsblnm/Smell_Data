+		// 4. Add the type names of the superclass and the implemented interfaces.
+		// The generated builder class extends the superclass' builder (e.g. "B.BBuilder"), and if
+		// one of the builder's new type parameters ("C" and "B") had the same name as the
+		// superclass (or the root of a qualified type name), that reference would break.
+		if (td.superclass != null) {
