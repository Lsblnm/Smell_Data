+/// Print a line that embeds a filename, writing the raw bytes of the
+/// filename instead of a lossy conversion, so that non-UTF-8 filenames
+/// are handled correctly on platforms where they are allowed.
+fn print_line_with_filename(before: &str, after: &str, filename: &Path) -> io::Result<()> {
+    let stdout = stdout();
+    let mut out = stdout.lock();
+    out.write_all(before.as_bytes())?;
+    #[cfg(unix)]
+    {
+        use std::os::unix::ffi::OsStrExt;
+        out.write_all(filename.as_os_str().as_bytes())?;
+    }
+    #[cfg(not(unix))]
+    {
+        out.write_all(filename.to_string_lossy().as_bytes())?;
+    }
+    out.write_all(after.as_bytes())?;
+    out.write_all(b"\n")
+}
