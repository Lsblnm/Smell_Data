diff --git a/lib/helpers/formDataToStream.js b/lib/helpers/formDataToStream.js
new file mode 100644
index 0000000..94c1184
--- /dev/null
+++ b/lib/helpers/formDataToStream.js
@@ -0,0 +1,46 @@
+import stream from 'stream';
+
+const isBlobLike = (thing) => {
+  return !!thing && typeof thing === 'object' &&
+    typeof thing.stream === 'function' &&
+    typeof thing.arrayBuffer === 'function';
+};
+
+/**
+ * Serializes a spec-compliant FormData instance (such as the global FormData
+ * available in Node.js 18+) into a multipart stream that can be sent as a
+ * request body.
+ *
+ * @param {FormData} form - The FormData instance to serialize
+ * @param {string} boundary - The multipart boundary
+ *
+ * @returns {stream.Readable} The multipart stream
+ */
+const formDataToStream = (form, boundary) => {
+  return stream.Readable.from(async function* () {
+    for (const [name, value] of form) {
+      const isBlob = isBlobLike(value);
+      const filename = isBlob ? (value.name || 'blob') : undefined;
+
+      yield Buffer.from(
+        `--${boundary}\r\n` +
+        `Content-Disposition: form-data; name="${name}"` +
+        (filename ? `; filename="${filename}"` : '') + '\r\n' +
+        (isBlob && value.type ? `Content-Type: ${value.type}\r\n` : '') +
+        '\r\n'
+      );
+
+      if (isBlob) {
+        yield Buffer.from(await value.arrayBuffer());
+      } else {
+        yield Buffer.from(String(value));
+      }
+
+      yield Buffer.from('\r\n');
+    }
+
+    yield Buffer.from(`--${boundary}--\r\n`);
+  }());
+};
+
+export default formDataToStream;
