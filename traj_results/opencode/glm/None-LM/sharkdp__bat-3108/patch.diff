+    /// Returns `true` if a pager-disabling option (`-pp`) was specified on the
+    /// command line after the last occurrence of `--paging=<when>`.
+    ///
+    /// A single `-p`/`--plain` does not affect paging; only `-pp` does.
+    fn disable_pager_specified_last(&self) -> bool {
+        if self.matches.get_count("plain") < 2 {
+            return false;
+        }
+        let plain_index = self.last_index_of("plain");
+        let paging_index = self.last_index_of("paging");
+        let no_paging_index = self.last_index_of("no-paging");
+
+        let disable_index = match (plain_index, no_paging_index) {
+            (Some(plain), Some(no_paging)) => Some(plain.max(no_paging)),
+            (plain, no_paging) => plain.or(no_paging),
+        };
+
+        match (disable_index, paging_index) {
+            (Some(disable), Some(paging)) => disable > paging,
+            (Some(_), None) => true,
+            _ => false,
+        }
+    }
+
+    /// Returns the clap index of the last command-line occurrence of `arg_id`,
+    /// ignoring values that were filled in from a default.
+    fn last_index_of(&self, arg_id: &str) -> Option<usize> {
+        if self.matches.value_source(arg_id) != Some(ValueSource::CommandLine) {
+            return None;
+        }
+        self.matches.indices_of(arg_id).and_then(|idx| idx.max())
+    }
