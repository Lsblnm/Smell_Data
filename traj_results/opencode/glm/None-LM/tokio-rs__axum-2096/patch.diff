@@ -30,6 +30,45 @@ where
         self.replace_endpoint("/", endpoint.clone());
         self.replace_endpoint(&format!("/*{FALLBACK_PARAM}"), endpoint);
     }
+
+    /// Merge the fallback router of another `Router` into `self`.
+    ///
+    /// The top-level endpoints of `other` (at `/` and `/*__private__axum_fallback`)
+    /// are only taken if `take_other_fallback` is true, in which case they replace
+    /// the top-level endpoints of `self`. Otherwise they're skipped, since both
+    /// routers have the same default fallback, and only the nested fallbacks are
+    /// merged.
+    pub(super) fn merge_fallback_router(
+        &mut self,
+        other: PathRouter<S, true>,
+        take_other_fallback: bool,
+    ) -> Result<(), Cow<'static, str>> {
+        let PathRouter {
+            routes,
+            node,
+            prev_route_id: _,
+        } = other;
+
+        for (id, route) in routes {
+            let path: &str = node
+                .route_id_to_path
+                .get(&id)
+                .expect("no path for route id. This is a bug in axum. Please file an issue");
+
+            if path == "/" || path == &*format!("/*{FALLBACK_PARAM}") {
+                if take_other_fallback {
+                    self.replace_endpoint(path, route);
+                }
+            } else {
+                match route {
+                    Endpoint::MethodRouter(method_router) => self.route(path, method_router)?,
+                    Endpoint::Route(route) => self.route_service(path, route)?,
+                };
+            }
+        }
+
+        Ok(())
+    }
 }
 
 impl<S, const IS_FALLBACK: bool> PathRouter<S, IS_FALLBACK>
