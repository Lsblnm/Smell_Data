+    private static function encodeQuotedSheetNames(string $address, array &$quotedSheetNames): string
+    {
+        $quotedSheetNames = [];
+
+        return (string) preg_replace_callback(
+            self::QUOTED_SHEET_NAME_REGEX,
+            static function (array $matches) use (&$quotedSheetNames): string {
+                $index = array_search($matches[0], $quotedSheetNames, true);
+                if ($index === false) {
+                    $quotedSheetNames[] = $matches[0];
+                    $index = count($quotedSheetNames) - 1;
+                }
+
+                return self::PLACEHOLDER_START . $index . self::PLACEHOLDER_END;
+            },
+            $address
+        );
+    }
+
+    private static function decodeQuotedSheetNames(string $address, array $quotedSheetNames): string
+    {
+        return (string) preg_replace_callback(
+            '/\x00(\d+)\x01/',
+            static fn (array $matches): string => $quotedSheetNames[(int) $matches[1]] ?? $matches[0],
+            $address
+        );
+    }
 }
