+    private static function getInsertedAttributeArguments(array $tokensToInsert): ?string
+    {
+        $arguments = null;
+        $depth = 0;
+
+        foreach (\array_slice($tokensToInsert, 3) as $token) {
+            if (null === $arguments) {
+                if ($token->equals('(') && null === $token->getId()) {
+                    $arguments = '';
+                    $depth = 1;
+                } elseif ($token->isGivenKind(CT::T_ATTRIBUTE_CLOSE)) {
+                    break;
+                }
+                continue;
+            }
+
+            if ($token->equals('(') && null === $token->getId()) {
+                ++$depth;
+            } elseif ($token->equals(')') && null === $token->getId()) {
+                --$depth;
+                if (0 === $depth) {
+                    return $arguments;
+                }
+            }
+
+            if (!$token->isWhitespace()) {
+                $arguments .= $token->getContent();
+            }
+        }
+
+        return $arguments;
+    }
