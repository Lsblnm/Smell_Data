diff --git a/src/uu/mkdir/src/mkdir.rs b/src/uu/mkdir/src/mkdir.rs
index c29905ef4..2e5545e71 100644
--- a/src/uu/mkdir/src/mkdir.rs
+++ b/src/uu/mkdir/src/mkdir.rs
@@ -165,6 +165,24 @@ pub fn mkdir(path: &Path, recursive: bool, mode: u32, verbose: bool) -> UResult<
     let path_buf = dir_strip_dot_for_creation(path);
     let path = path_buf.as_path();
 
+    if path.exists() {
+        if !recursive {
+            return Err(USimpleError::new(
+                1,
+                format!("{}: File exists", path.display()),
+            ));
+        }
+        // With -p, an existing directory is left untouched (including its
+        // permissions), matching GNU's behavior. This also avoids spurious
+        // failures like "mkdir -p /root" as a non-root user, where chmod'ing
+        // the existing directory would fail with "Permission denied".
+        // Existing non-directories still fall through to create_dir, which
+        // reports the appropriate error.
+        if path.is_dir() {
+            return Ok(());
+        }
+    }
+
     create_dir(path, recursive, verbose, false)?;
     chmod(path, mode)
 }
