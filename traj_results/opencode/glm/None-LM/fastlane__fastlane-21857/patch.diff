+    def self.convert_to_utf8(object)
+      case object
+      when String
+        return object if object.valid_encoding?
+
+        # genstrings outputs UTF-16, so we should try to use this encoding if it turns out to be valid
+        test_object = object.dup
+        begin
+          return object.encode(Encoding::UTF_8, Encoding::UTF_16) if test_object.force_encoding(Encoding::UTF_16).valid_encoding?
+        rescue Encoding::InvalidByteSequenceError, Encoding::UndefinedConversionError
+          # fall through to replacing invalid characters
+        end
+
+        # replace any invalid characters with empty string
+        object.encode(Encoding::UTF_8, invalid: :replace, undef: :replace)
+      else
+        object
+      end
+    end
+
     def self.print_error_line(ex)
       error_line = ex.backtrace.first
       return if error_line.nil?
