diff --git a/match/lib/match/storage/s3_storage.rb b/match/lib/match/storage/s3_storage.rb
index 3ef0c68ea..41f560ae4 100644
--- a/match/lib/match/storage/s3_storage.rb
+++ b/match/lib/match/storage/s3_storage.rb
@@ -107,6 +107,11 @@ module Match
           # strip s3_prefix from file_path
           download_path = File.join(self.working_directory, file_path)
 
+          # Skip folder-like objects (e.g. zero-byte keys ending with a `/`)
+          # as trying to download them would result in
+          # `Is a directory @ rb_sysopen` errors
+          next if file_path.to_s.empty? || file_path.end_with?("/")
+
           FileUtils.mkdir_p(File.expand_path("..", download_path))
           UI.verbose("Downloading file from S3 '#{file_path}' on bucket #{self.s3_bucket}")
 
