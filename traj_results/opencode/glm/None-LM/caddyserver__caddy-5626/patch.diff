diff --git a/caddyconfig/caddyfile/dispenser.go b/caddyconfig/caddyfile/dispenser.go
index 580de4a9..3d69eca0 100644
--- a/caddyconfig/caddyfile/dispenser.go
+++ b/caddyconfig/caddyfile/dispenser.go
@@ -474,7 +474,14 @@ func (d *Dispenser) isNewLine() bool {
 	// If the previous token (incl line breaks) ends
 	// on a line earlier than the current token,
 	// then the current token is on a new line
-	return prev.Line+prev.NumLineBreaks() < curr.Line
+	if prev.Line+prev.NumLineBreaks() < curr.Line {
+		return true
+	}
+
+	// If the tokens are from the same file but were imported
+	// through different import chains, they cannot be on the
+	// same line, since an import must be on its own line
+	return !sameImports(prev.imports, curr.imports)
 }
 
 // isNextOnNewLine determines whether the current token is on a different
@@ -500,5 +507,27 @@ func (d *Dispenser) isNextOnNewLine() bool {
 	// If the current token (incl line breaks) ends
 	// on a line earlier than the next token,
 	// then the next token is on a new line
-	return curr.Line+curr.NumLineBreaks() < next.Line
+	if curr.Line+curr.NumLineBreaks() < next.Line {
+		return true
+	}
+
+	// If the tokens are from the same file but were imported
+	// through different import chains, they cannot be on the
+	// same line, since an import must be on its own line
+	return !sameImports(curr.imports, next.imports)
+}
+
+// sameImports determines whether two tokens were imported through
+// the same chain of imports, i.e. they come from the same expansion
+// of an import directive or snippet.
+func sameImports(a, b []string) bool {
+	if len(a) != len(b) {
+		return false
+	}
+	for i := range a {
+		if a[i] != b[i] {
+			return false
+		}
+	}
+	return true
 }
