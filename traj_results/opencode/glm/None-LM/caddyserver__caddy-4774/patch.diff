+// parseOptDefaultBind parses the default_bind global option. Syntax:
+//
+//     default_bind <addresses...>
+//
+func parseOptDefaultBind(d *caddyfile.Dispenser, _ interface{}) (interface{}, error) {
+	var lnHosts []string
+	for d.Next() {
+		lnHosts = append(lnHosts, d.RemainingArgs()...)
+	}
+	if len(lnHosts) == 0 {
+		return nil, d.ArgErr()
+	}
+	return lnHosts, nil
+}
