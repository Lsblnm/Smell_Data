diff --git a/include/nlohmann/detail/conversions/to_json.hpp b/include/nlohmann/detail/conversions/to_json.hpp
index e39b7797..412f8c63 100644
--- a/include/nlohmann/detail/conversions/to_json.hpp
+++ b/include/nlohmann/detail/conversions/to_json.hpp
@@ -320,7 +320,11 @@ template<typename BasicJsonType, typename EnumType,
 inline void to_json(BasicJsonType& j, EnumType e) noexcept
 {
     using underlying_type = typename std::underlying_type<EnumType>::type;
-    external_constructor<value_t::number_integer>::construct(j, static_cast<underlying_type>(e));
+
+    constexpr bool is_signed_enum = std::is_signed<underlying_type>::value;
+    constexpr value_t enum_value = is_signed_enum ? value_t::number_integer : value_t::number_unsigned;
+    using enum_json_type = typename std::conditional<is_signed_enum, typename BasicJsonType::number_integer_t, typename BasicJsonType::number_unsigned_t>::type;
+    external_constructor<enum_value>::construct(j, static_cast<enum_json_type>(e));
 }
 #endif  // JSON_DISABLE_ENUM_SERIALIZATION
 
