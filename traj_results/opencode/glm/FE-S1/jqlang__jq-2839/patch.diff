diff --git a/src/decNumber/decNumber.c b/src/decNumber/decNumber.c
index 5062634..4e158f7 100644
--- a/src/decNumber/decNumber.c
+++ b/src/decNumber/decNumber.c
@@ -6206,9 +6206,20 @@ static Int decCompare(const decNumber *lhs, const decNumber *rhs,
     rhs=temp;
     result=-result;
     }
-  compare=decUnitCompare(lhs->lsu, D2U(lhs->digits),
-                         rhs->lsu, D2U(rhs->digits),
-                         rhs->exponent-lhs->exponent);
+  // here, rhs->exponent>=lhs->exponent, so the exponent difference is
+  // non-negative; uInt arithmetic gives the exact difference even
+  // when an Int subtraction would overflow
+  {
+    uInt ediff=(uInt)rhs->exponent-(uInt)lhs->exponent;
+    // If the exponent difference is so large that the LHS coefficient
+    // cannot possibly make up for it, the RHS is strictly larger in
+    // magnitude and no coefficient comparison is needed.  This also
+    // avoids overflow and huge allocations in decUnitCompare.
+    if (ediff>=(uInt)(D2U(lhs->digits))*DECDPUN) return -result;
+    compare=decUnitCompare(lhs->lsu, D2U(lhs->digits),
+                           rhs->lsu, D2U(rhs->digits),
+                           (Int)ediff);
+    }
   if (compare!=BADINT) compare*=result;      // comparison succeeded
   return compare;
   } // decCompare
