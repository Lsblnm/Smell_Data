+pin_project! {
+    /// Response future for [`MethodRouter`] used as a [`Handler`].
+    pub struct InfallibleRouteFuture<B> {
+        #[pin]
+        inner: RouteFuture<B, Infallible>,
+    }
+}
+
+impl<B> InfallibleRouteFuture<B> {
+    pub(crate) fn new(inner: RouteFuture<B, Infallible>) -> Self {
+        Self { inner }
+    }
+}
+
+impl<B: HttpBody> Future for InfallibleRouteFuture<B> {
+    type Output = Response;
+
+    #[inline]
+    fn poll(self: Pin<&mut Self>, cx: &mut Context<'_>) -> Poll<Self::Output> {
+        match ready!(self.project().inner.poll(cx)) {
+            Ok(response) => Poll::Ready(response),
+            Err(err) => match err {},
+        }
+    }
+}
