diff --git a/lib/helpers/formDataToStream.js b/lib/helpers/formDataToStream.js
new file mode 100644
index 0000000..2ea9bf6
--- /dev/null
+++ b/lib/helpers/formDataToStream.js
@@ -0,0 +1,84 @@
+'use strict';
+
+import stream from 'stream';
+import utils from '../utils.js';
+import readBlob from './readBlob.js';
+
+const LINE_BREAK = '\r\n';
+
+const escapeParam = (str) => String(str).replace(/\r?\n|\r/g, (match) => encodeURIComponent(match));
+
+const stringifyHeaders = (headers) =>
+  Object.entries(headers).map(([key, value]) => `${key}: ${value}`).join(LINE_BREAK);
+
+const isBlobLike = (thing) => thing && typeof thing === 'object' &&
+  typeof thing.stream === 'function' &&
+  typeof thing.arrayBuffer === 'function' &&
+  ('size' in thing);
+
+async function* formDataBodyIterator(form, boundary, BlobConstructor) {
+  const startBoundary = `--${boundary}`;
+
+  for (const [name, value] of form.entries()) {
+    const isBlob = BlobConstructor && value instanceof BlobConstructor || isBlobLike(value);
+
+    if (isBlob) {
+      const headers = {
+        'Content-Disposition': `form-data; name="${escapeParam(name)}"` +
+          (value.name ? `; filename="${escapeParam(value.name)}"` : ''),
+        'Content-Type': value.type || 'application/octet-stream'
+      };
+
+      yield Buffer.from(
+        `${startBoundary}${LINE_BREAK}${stringifyHeaders(headers)}${LINE_BREAK}${LINE_BREAK}`
+      );
+
+      yield* readBlob(value);
+
+      yield Buffer.from(LINE_BREAK);
+    } else {
+      const headers = {
+        'Content-Disposition': `form-data; name="${escapeParam(name)}"`
+      };
+
+      yield Buffer.from(
+        `${startBoundary}${LINE_BREAK}${stringifyHeaders(headers)}${LINE_BREAK}${LINE_BREAK}` +
+        `${String(value)}${LINE_BREAK}`
+      );
+    }
+  }
+
+  yield Buffer.from(`${startBoundary}--${LINE_BREAK}`);
+}
+
+/**
+ * Converts a spec-compliant FormData instance (e.g. the global FormData added
+ * in Node.js 18) to a multipart/form-data encoded Node.js Readable stream.
+ *
+ * @param {FormData} form The FormData instance to serialize
+ * @param {Function} [handler] A function that receives the generated headers (with a computed
+ *  `Content-Type` including the boundary) and can propagate them to the request headers
+ * @param {Object} [options]
+ *
+ * @returns {stream.Readable}
+ */
+export default function formDataToStream(form, handler, options) {
+  const {
+    BlobConstructor = typeof Blob !== 'undefined' ? Blob : undefined
+  } = options || {};
+
+  const boundary = 'axiosformdata-' +
+    Date.now().toString(16) + '-' + Math.random().toString(16).slice(2);
+
+  const handlerFn = utils.isFunction(handler) ? handler : utils.noop;
+
+  handlerFn({
+    headers: {
+      'Content-Type': `multipart/form-data; boundary=${boundary}`
+    }
+  });
+
+  return stream.Readable.from(
+    formDataBodyIterator(form, boundary, BlobConstructor)
+  );
+}
diff --git a/lib/helpers/readBlob.js b/lib/helpers/readBlob.js
new file mode 100644
index 0000000..ca5c418
--- /dev/null
+++ b/lib/helpers/readBlob.js
@@ -0,0 +1,28 @@
+'use strict';
+
+/**
+ * Reads a Blob (or Blob-like object) content as an async iterable of Buffers.
+ *
+ * @param {Blob} blob The Blob to read
+ *
+ * @returns {AsyncIterable<Buffer>}
+ */
+async function* readBlob(blob) {
+  const bodyStream = blob && typeof blob.stream === 'function' ?
+    blob.stream() :
+    undefined;
+
+  if (bodyStream && typeof bodyStream[Symbol.asyncIterator] === 'function') {
+    for await (const chunk of bodyStream) {
+      yield Buffer.isBuffer(chunk) ? chunk : Buffer.from(chunk);
+    }
+
+    return;
+  }
+
+  const buffer = Buffer.from(await blob.arrayBuffer());
+
+  yield buffer;
+}
+
+export default readBlob;
