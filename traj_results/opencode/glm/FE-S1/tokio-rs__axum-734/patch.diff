 use std::{
     convert::Infallible,
@@ -168,7 +169,21 @@ impl<B, E> Future for RouteFuture<B, E> {
         match future.poll(cx) {
             Poll::Ready(Ok(res)) => {
                 let mut res = if strip_body {
-                    res.map(|_| boxed(Empty::new()))
+                    // on HEAD requests, hyper will set the content-length
+                    // based on the response body, which we're about to
+                    // remove. therefore set the content-length header
