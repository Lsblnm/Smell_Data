+        # Returns the source path of the given file, expanded to an absolute
+        # path. Relative paths (e.g. Page#path) are resolved against the site
+        # source, so the same file read through different readers (page,
+        # document, static file) is always identified as one and the same file
+        # instead of being reported as a conflict with itself.
+        def canonical_path(thing, site)
+          File.expand_path(thing.path.to_s, site.source)
+        end
+
         def allow_used_permalink?(item)
           defined?(JekyllRedirectFrom) && item.is_a?(JekyllRedirectFrom::RedirectPage)
         end
