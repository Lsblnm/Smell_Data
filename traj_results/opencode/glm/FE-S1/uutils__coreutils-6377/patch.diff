+#[cfg(unix)]
+fn parse_signal(spec: &str) -> Option<Signal> {
+    if spec.is_empty() {
+        return None;
+    }
+    // a signal number like "13"
+    if spec.bytes().all(|b| b.is_ascii_digit()) {
+        // signal 0 ("EXIT") is rejected
+        return spec
+            .parse::<i32>()
+            .ok()
+            .and_then(|num| Signal::try_from(num).ok());
+    }
+    // a signal name like "PIPE", "SIGPIPE", "pipe" or "SigPipe"
+    let upper = spec.to_uppercase();
+    let name = upper.strip_prefix("SIG").unwrap_or(&upper);
+    Signal::from_str(&format!("SIG{name}")).ok()
+}
+
+#[cfg(unix)]
+fn parse_ignore_signals(spec: &OsStr) -> UResult<Vec<Signal>> {
+    let mut signals = Vec::new();
+    for part in spec.to_string_lossy().split(',') {
+        if part.is_empty() {
+            // an empty signal is a no-op
+            continue;
+        }
+        let sig = parse_signal(part)
+            .ok_or_else(|| USimpleError::new(125, format!("{}: invalid signal", part.quote())))?;
+        if !signals.contains(&sig) {
+            signals.push(sig);
+        }
+    }
+    Ok(signals)
+}
+
+#[cfg(unix)]
+fn all_signals() -> Vec<Signal> {
+    // SIGCHLD is excluded: ignoring it makes children be reaped
+    // automatically, which prevents waiting for the child program.
+    (1..=64)
+        .filter(|&i| i != Signal::SIGCHLD as i32)
+        .filter_map(|i| Signal::try_from(i).ok())
+        .collect()
+}
