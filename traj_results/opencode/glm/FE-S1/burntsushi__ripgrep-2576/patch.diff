+/// Returns true if the line start anchor configured in the given
+/// configuration could match at the given position in the haystack.
+///
+/// When this returns true, the word wrapper may have matched with zero width
+/// at the start of the overall match via a line anchor instead of consuming
+/// a \W codepoint. In that case, the fast path in `fast_find` cannot recover
+/// the offsets of the inner match and must defer to the slower captures
+/// based search.
+fn line_start_possible(config: &Config, haystack: &[u8], pos: usize) -> bool {
+    if pos == 0 {
+        return true;
+    }
+    match haystack[pos - 1] {
+        // StartLF matches after any \n. StartCRLF also matches after any \n,
+        // including \n that is part of a \r\n terminator.
+        b'\n' => true,
+        // StartCRLF matches after a \r, but never when a \n follows.
+        b'\r' => config.crlf && haystack.get(pos) != Some(&b'\n'),
+        _ => false,
+    }
+}
+
+/// Returns true if the line end anchor configured in the given configuration
+/// could match at the given position in the haystack.
+///
+/// See `line_start_possible` for why this matters.
+fn line_end_possible(config: &Config, haystack: &[u8], pos: usize) -> bool {
+    if pos == haystack.len() {
+        return true;
+    }
+    match haystack[pos] {
+        // EndLF matches before any \n. EndCRLF also matches before any \n,
+        // unless that \n is part of a \r\n terminator (the EndCRLF match
+        // occurs before the \r in that case).
+        b'\n' => !config.crlf || pos == 0 || haystack[pos - 1] != b'\r',
+        // EndCRLF matches before a \r.
+        b'\r' => config.crlf,
+        _ => false,
+    }
+}
