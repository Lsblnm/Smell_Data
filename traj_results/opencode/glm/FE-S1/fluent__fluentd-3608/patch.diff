diff --git a/lib/fluent/plugin/buffer.rb b/lib/fluent/plugin/buffer.rb
index eaf77cd8..040b7890 100644
--- a/lib/fluent/plugin/buffer.rb
+++ b/lib/fluent/plugin/buffer.rb
@@ -641,12 +641,38 @@ module Fluent
 
           unless output.retry
             output.retry = output.retry_state
-            if error
-              if log_level <= 3 && logdev
-                logger.warn "failed to flush the buffer.", retry_times: output.retry.steps, next_retry_time: output.retry.next_time.round, chunk: chunk_id_hex, error: error
-                logger.warn_backtrace
+            retry_state = output.retry
+
+            if retry_state.limit?
+              if error
+                records = 0
+                synchronize do
+                  @queue.each do |chunk|
+                    records += chunk.size
+                  end
+                end
+                msg = "failed to flush the buffer, and hit limit for retries. dropping all chunks in the buffer queue."
