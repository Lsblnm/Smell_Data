+    /// Merge the routes of `other`'s fallback router into `self`'s.
+    ///
+    /// If `self`'s top-level fallback is the default `NotFound` one (i.e.
+    /// `self_default_fallback` is true) it is replaced by `other`'s endpoint at
+    /// the top-level fallback paths. Fallbacks set by nested routers are added
+    /// unless `self` already has a fallback at that path, such that nested
+    /// fallbacks are never lost or overwritten.
+    fn merge_fallback_router(
+        &mut self,
+        other_fallback_router: PathRouter<S, true>,
+        self_default_fallback: bool,
+    ) {
+        let other_routes = other_fallback_router.routes;
+        let other_node = other_fallback_router.node;
+
+        let top_level_fallback_paths = ["/".to_owned(), format!("/*{FALLBACK_PARAM}")];
+
+        for (id, endpoint) in other_routes {
+            let path = other_node
+                .route_id_to_path
+                .get(&id)
+                .expect("no path for route id. This is a bug in axum. Please file an issue");
+
+            let path = &**path;
+
+            let self_endpoint_is_default = self_default_fallback
+                && top_level_fallback_paths.contains(&path.to_owned());
+
+            match self.fallback_router.node.path_to_route_id.get(path) {
+                Some(route_id) => {
+                    if self_endpoint_is_default {
+                        self.fallback_router.routes.insert(*route_id, endpoint);
+                    }
+                }
+                None => panic_on_err!(self.fallback_router.route_endpoint(path, endpoint)),
+            }
+        }
+    }
+
