+  # Debian only allows exact version provides: 'name (= version)'
+  # https://www.debian.org/doc/debian-policy/ch-relationships.html#id9
+  def validate_provides(provides)
+    name_re = /^[A-Za-z0-9][A-Za-z0-9+.-]*(\s*\(=\s+[A-Za-z0-9][A-Za-z0-9.:~+-]*\))?$/
+    if provides !~ name_re
+      raise FPM::InvalidPackageConfiguration,
+        "Invalid provides entry '#{provides}'. Debian only supports " \
+        "provides without a version, or with an exact version like " \
+        "'name (= version)' (https://www.debian.org/doc/debian-policy/ch-relationships.html#id9)"
+    end
+  end # def validate_provides
