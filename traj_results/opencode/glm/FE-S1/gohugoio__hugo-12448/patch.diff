+package hugolib
+
+import (
+	"testing"
+
+	"github.com/gohugoio/hugo/common/types"
+)
+
+// Issue 12448: Page does not reload after modifying a different page.
+// This simulates what happens in hugo server (fast render mode):
+// 1. Initial build.
+// 2. User visits /about/.
+// 3. User edits content/_index.md (rebuild 1).
+// 4. User edits content/about/index.md (rebuild 2).
+func TestRebuildPageAfterEditingOtherPageIssue12448(t *testing.T) {
+	t.Parallel()
+
+	files := `
+-- hugo.toml --
+disableKinds = ['rss','sitemap','taxonomy','term']
+-- layouts/_default/list.html --
+{{ .Content }}
+-- layouts/_default/single.html --
+{{ .Content }}
+-- content/_index.md --
+---
+title: home
+---
+home-content|
+-- content/about/index.md --
+---
+title: about
+---
+about-content|
+`
+
+	b := Test(t, files, TestOptRunning())
+
+	b.AssertFileContent("public/index.html", "home-content|")
+	b.AssertFileContent("public/about/index.html", "about-content|")
+
+	// User visits /about/ in fast render mode.
+	visitedURLs := types.NewEvictingStringQueue(10).Add("/about/")
+
+	// Edit the home page.
+	b.EditFiles("content/_index.md", "home-content|foo")
+	if err := b.H.Build(BuildCfg{NoBuildLock: true, RecentlyVisited: visitedURLs}, b.changeEvents()...); err != nil {
+		t.Fatal(err)
+	}
+	b.reset()
+	b.AssertFileContent("public/index.html", "home-content|foo")
+
+	// Edit the about page.
+	b.EditFiles("content/about/index.md", "about-content|bar")
+	if err := b.H.Build(BuildCfg{NoBuildLock: true, RecentlyVisited: visitedURLs}, b.changeEvents()...); err != nil {
+		t.Fatal(err)
+	}
+	b.reset()
+	b.AssertFileContent("public/about/index.html", "about-content|bar")
+}
