+		} else if (type instanceof ParameterizedQualifiedTypeReference) {
+			TypeReference[][] typeArgs = ((ParameterizedQualifiedTypeReference) type).typeArguments;
+			if (typeArgs != null)
+				for (TypeReference[] args : typeArgs)
+					if (args != null)
+						for (TypeReference arg : args)
+							addExtendsClauseNames(arg, usedNames);
+		}
+	}
