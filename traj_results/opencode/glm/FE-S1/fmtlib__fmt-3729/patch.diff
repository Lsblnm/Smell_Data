diff --git a/include/fmt/std.h b/include/fmt/std.h
index 9785ba3d..3689ff91 100644
--- a/include/fmt/std.h
+++ b/include/fmt/std.h
@@ -85,6 +85,7 @@ template <typename Char> struct formatter<std::filesystem::path, Char> {
   format_specs<Char> specs_;
   detail::arg_ref<Char> width_ref_;
   bool debug_ = false;
+  char path_type_ = 0;  // 0 - native, 'g' - generic
 
  public:
   FMT_CONSTEXPR void set_debug_format(bool set = true) { debug_ = set; }
@@ -101,6 +102,12 @@ template <typename Char> struct formatter<std::filesystem::path, Char> {
       debug_ = true;
       ++it;
     }
+    if (it != end && *it == 'g') {
+      path_type_ = 'g';
+      ++it;
+    } else if (it != end && *it == 'n') {
+      ++it;
+    }
     return it;
   }
 
@@ -108,6 +115,10 @@ template <typename Char> struct formatter<std::filesystem::path, Char> {
   auto format(const std::filesystem::path& p, FormatContext& ctx) const {
     int width = specs_.width;
     detail::handle_dynamic_spec<detail::width_checker>(width, width_ref_, ctx);
+    if (path_type_ == 'g')
+      return write_path(
+          p, p.generic_string<std::filesystem::path::value_type>(), width,
+          ctx.out());
     return write_path(p, p.native(), width, ctx.out());
   }
 
