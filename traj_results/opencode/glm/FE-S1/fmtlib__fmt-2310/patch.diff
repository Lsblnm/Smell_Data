-      if (fill_size == 1) return detail::fill_n(p, n, specs.fill[0]);
-      auto fill_data = specs.fill.data();
+    auto it = reserve(out, size + padding * fill.size());
+    auto apply_fill = [&fill](reserve_iterator<OutputIt> p, size_t n) {
+      auto fill_size = fill.size();
+      if (fill_size == 1) return detail::fill_n(p, n, fill[0]);
+      auto fill_data = fill.data();
       for (size_t i = 0; i < n; ++i)
         p = copy_str<Char>(fill_data, fill_data + fill_size, p);
       return p;
