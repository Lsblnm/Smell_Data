+/// Returns `true` if the given expression is of a type whose `__eq__` and
+/// `__ne__` methods are known to return a `bool`.
+///
+/// Most types, including third-party types like NumPy arrays, are free to
+/// implement `__eq__` and `__ne__` with any return type, so we conservatively
+/// only consider builtin types and calls to builtins that return such types.
+fn eq_ne_returns_bool(expr: &Expr, semantic: &SemanticModel) -> bool {
+    match expr {
+        Expr::StringLiteral(_)
+        | Expr::BytesLiteral(_)
+        | Expr::NumberLiteral(_)
+        | Expr::BooleanLiteral(_)
+        | Expr::NoneLiteral(_)
+        | Expr::EllipsisLiteral(_)
+        | Expr::FString(_) => true,
+        Expr::Name(_) => semantic.resolve_builtin_symbol(expr).is_some_and(|symbol| {
+            matches!(
+                symbol,
+                "bool" | "int" | "float" | "complex" | "str" | "bytes" | "type" | "object"
+            )
+        }),
+        Expr::Call(ast::ExprCall { func, .. }) => matches!(
+            semantic.resolve_builtin_symbol(func),
+            Some("bool" | "isinstance" | "issubclass" | "callable" | "hasattr" | "len")
+        ),
+        _ => false,
+    }
+}
