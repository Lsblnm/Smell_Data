\n     */\n    private $xlwsPrefixPattern;\n\n    public function __construct()\n    {\n        $this->xlfnPrefixPattern = self::XLFNREGEXP;\n        $this->xlwsPrefixPattern = self::XLWSREGEXP;\n    }\n\n    /**\n     * Prefix function name in string with _xlfn. where required.\n     */\n    protected static function addXlfnPrefix(string $functionString): string\n    {\n        return (string) preg_replace(self::XLFNREGEXP, '_xlfn.$1(', $functionString);\n    }\n\n    /**\n     * Prefix function name in string with _xlws. where required.\n     */\n    protected static function addXlwsPrefix(string $functionString): string\n    {\n        return (string) preg_replace(self::XLWSREGEXP, '_xlws.$1(', $functionString);\n    }\n\n    /**\n     * Prefix function name in string with _xlfn. where required.\n     */\n    public static function addFunctionPrefix(string $functionString): string\n    {\n        return self::addXlwsPrefix(self::addXlfnPrefix($functionString));\n    }\n\n    /**\n     * Prefix function name in string with _xlfn. where required.\n     * Leading character, expected to be equals sign, is stripped.\n     */\n    public static function addFunctionPrefixStripEquals(string $functionString): string\n    {\n        return self::addFunctionPrefix(substr($functionString, 1));\n    }\n\n    /**\n     * Write a formula cell, prefixing Excel function names where required.\n     *\n     * @param mixed $writer Parent workbook writer\n     * @param mixed $worksheet Worksheet that owns the cell\n     */\n    public function writeCellFormula(XMLWriter $objWriter, string $cellValue, Cell $cell, $writer, $worksheet): void\n    {\n        $xlfnPrefixPattern = $this->xlfnPrefixPattern;\n        $xlwsPrefixPattern = $this->xlwsPrefixPattern;\n\n        if ($writer->getPreCalculateFormulas()) {\n            $selectedCells = $worksheet->getSelectedCells();\n            $spreadsheet = $worksheet->getParentOrThrow();\n            $activeSheetIndex = $spreadsheet->getActiveSheetIndex();\n            $calculatedValue = $cell->getCalculatedValue();\n            $worksheet->setSelectedCells($selectedCells);\n            $spreadsheet->setActiveSheetIndex($activeSheetIndex);\n        } else {\n            $calculatedValue = $cell->getValue();\n        }\n\n        if (is_string($calculatedValue)) {\n            if (ErrorValue::isError($calculatedValue)) {\n                $objWriter->writeAttribute('t', 'e');\n                $cellIsFormula = substr($cellValue, 0, 1) === '=';\n                if ($cellIsFormula) {\n                    $prefixedFormula = (string) preg_replace(\n                        $xlwsPrefixPattern,\n                        '_xlws.$1(',\n                        (string) preg_replace($xlfnPrefixPattern, '_xlfn.$1(', substr($cellValue, 1))\n                    );\n                    $objWriter->writeElement('f', $prefixedFormula);\n                }\n                $objWriter->writeElement('v', $cellIsFormula ? $calculatedValue : $cellValue);\n\n                return;\n            }\n            $objWriter->writeAttribute('t', 'str');\n            $calculatedValue = StringHelper::controlCharacterPHP2OOXML($calculatedValue);\n        } elseif (is_bool($calculatedValue)) {\n            $objWriter->writeAttribute('t', 'b');\n            $calculatedValue = (int) $calculatedValue;\n        }\n\n        $prefixedFormula = (string) preg_replace(\n            $xlwsPrefixPattern,\n            '_xlws.$1(',\n            (string) preg_replace($xlfnPrefixPattern, '_xlfn.$1(', substr($cellValue, 1))\n        );\n        $attributes = $cell->getFormulaAttributes();\n        if (($attributes['t'] ?? null) === 'array') {\n            $objWriter->startElement('f');\n            $objWriter->writeAttribute('t', 'array');\n            $objWriter->writeAttribute('ref', $cell->getCoordinate());\n            $objWriter->writeAttribute('aca', '1');\n            $objWriter->writeAttribute('ca', '1');\n            $objWriter->text($prefixedFormula);\n            $objWriter->endElement();\n        } else {\n            $objWriter->writeElement('f', $prefixedFormula);\n            if ($writer->getOffice2003Compatibility() === false) {\n                $objWriter->writeElement(\n                    'v',\n                    ($writer->getPreCalculateFormulas() && !is_array($calculatedValue) && substr($calculatedValue ?? '', 0, 1) !== '#')\n                        ? StringHelper::formatNumber($calculatedValue) : '0'\n                );\n            }\n        }\n    }\n}","lineStart":1,"lineEnd":286,"totalLines":286,"truncated":false}},"title":"src/PhpSpreadsheet/Writer/Xlsx/FunctionPrefix.php","time":{"start":1794551820516,"end":1794551820527}},"id":"prt_1d39fad7a001iIUNEhfYnuv9bP","sessionID":"ses_e2c6099f4ffe701QjbQYXRee9x","messageID":"msg_1d39f926e001H5OagMfGDCZy9y"}}
