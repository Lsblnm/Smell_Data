     fn poll(self: Pin<&mut Self>, cx: &mut Context<'_>) -> Poll<io::Result<()>> {
         let me = self.project();
+
+        let mut writer = Pin::new(&mut *me.writer);
+        let is_write_vectored = writer.is_write_vectored();
+
         while me.buf.has_remaining() {
-            let n = ready!(Pin::new(&mut *me.writer).poll_write(cx, me.buf.chunk())?);
-            me.buf.advance(n);
+            // The vector size is 4 for a start; it could be tuned later
+            const VECTOR_SIZE: usize = 4;
+
+            let n = if is_write_vectored {
+                let mut bufs: [io::IoSlice<'_>; VECTOR_SIZE] =
+                    [io::IoSlice::new(&[]); VECTOR_SIZE];
+                let vec_size = me.buf.chunks_vectored(&mut bufs);
+                debug_assert!(vec_size > 0);
+
+                let n = ready!(writer.as_mut().poll_write_vectored(cx, &bufs[..vec_size]))?;
+                me.buf.advance(n);
+                n
+            } else {
+                let n = ready!(writer.as_mut().poll_write(cx, me.buf.chunk()))?;
+                me.buf.advance(n);
+                n
+            };
+
             if n == 0 {
                 return Poll::Ready(Err(io::ErrorKind::WriteZero.into()));
             }
