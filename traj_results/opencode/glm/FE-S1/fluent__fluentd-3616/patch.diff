diff --git a/lib/fluent/plugin/in_http.rb b/lib/fluent/plugin/in_http.rb
index 0e66f202..71a7facc 100644
--- a/lib/fluent/plugin/in_http.rb
+++ b/lib/fluent/plugin/in_http.rb
@@ -556,6 +556,8 @@ module Fluent::Plugin
           params['json'] = @body
         elsif @content_type =~ /^application\/msgpack/
           params['msgpack'] = @body
+        elsif @content_type =~ /^application\/x-ndjson/
+          params['ndjson'] = @body
         end
         path_info = uri.path
 
diff --git a/lib/fluent/plugin/parser_json.rb b/lib/fluent/plugin/parser_json.rb
index aea25ba8..8751b731 100644
--- a/lib/fluent/plugin/parser_json.rb
+++ b/lib/fluent/plugin/parser_json.rb
@@ -117,8 +117,16 @@ module Fluent
           http.parser_json.parse(js) do |_time, record|
             return finish.call(record)
           end
+        elsif ndjson = params['ndjson']
+          events = []
+          ndjson.split(/\r?\n/).each do |js|
+            http.parser_json.parse(js) do |_time, record|
+              events.push(record) unless record.nil?
+            end
+          end
+          return finish.call(events)
         else
-          raise "'json' or 'msgpack' parameter is required"
+          raise "'json', 'ndjson' or 'msgpack' parameter is required"
         end
       end
 
