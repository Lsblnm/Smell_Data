diff --git a/fastlane/lib/fastlane/helper/s3_client_helper.rb b/fastlane/lib/fastlane/helper/s3_client_helper.rb
index 582e7f74f..34f229e77 100644
--- a/fastlane/lib/fastlane/helper/s3_client_helper.rb
+++ b/fastlane/lib/fastlane/helper/s3_client_helper.rb
@@ -64,6 +64,13 @@ module Fastlane
         destination_root = workspace.working_directory.to_s if destination_root.empty?
 
         file_path = object.key.gsub(/^#{prefix}/, "")
+
+        # Skip folder-like S3 objects (e.g. `path/to/folder/`) as they
+        # cannot be downloaded to a file, otherwise this would raise
+        # `Is a directory @ rb_sysopen` when trying to write to the
+        # working directory itself
+        return if file_path.to_s.empty? || file_path.end_with?("/")
+
         download_path = File.join(destination_root, file_path)
 
         FileUtils.mkdir_p(File.expand_path("..", download_path))
