+/// Returns the raw bytes of the filename.
+///
+/// On unix (and some other platforms), filenames aren't necessarily valid UTF-8,
+/// so they must be printed as raw bytes.
+#[cfg(unix)]
+fn filename_bytes(filename: &Path) -> Vec<u8> {
+    use std::os::unix::ffi::OsStrExt;
+    filename.as_os_str().as_bytes().to_vec()
+}
+
+#[cfg(not(unix))]
+fn filename_bytes(filename: &Path) -> Vec<u8> {
+    filename.display().to_string().into_bytes()
+}
