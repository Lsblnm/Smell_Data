diff --git a/.tmp-repro/repro.php b/.tmp-repro/repro.php
new file mode 100644
index 000000000..aa36ea05d
--- /dev/null
+++ b/.tmp-repro/repro.php
@@ -0,0 +1,22 @@
+<?php
+require '/testbed/vendor/autoload.php';
+
+use PhpCsFixer\Fixer\Whitespace\StatementIndentationFixer;
+use PhpCsFixer\Tokenizer\Tokens;
+use PhpCsFixer\WhitespacesFixerConfig;
+
+$fixer = new StatementIndentationFixer();
+$config = new WhitespacesFixerConfig('    ', "\n");
+
+$cases = [
+    "while (\$str[\$q] != '|')\n    if (++\$q >= \$endptr)\n        break 2;",
+    "if (\$x)\n    echo 'foo';",
+    "for (\$i = 0; \$i < 10; ++\$i)\n    echo \$i;\n",
+];
+
+foreach ($cases as $code) {
+    $tokens = Tokens::fromCode("<?php\n".$code);
+    $fixer->setWhitespacesConfig($config);
+    $fixer->fix(new \SplFileInfo('test.php'), $tokens);
+    echo "----\n".$tokens->generateCode()."\n";
+}
