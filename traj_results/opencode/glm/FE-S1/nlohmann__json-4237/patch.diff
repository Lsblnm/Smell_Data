diff --git a/include/nlohmann/detail/conversions/to_json.hpp b/include/nlohmann/detail/conversions/to_json.hpp
index b2f06108..765ec3b7 100644
--- a/include/nlohmann/detail/conversions/to_json.hpp
+++ b/include/nlohmann/detail/conversions/to_json.hpp
@@ -380,7 +380,14 @@ template<typename BasicJsonType, typename EnumType,
 inline void to_json(BasicJsonType& j, EnumType e) noexcept
 {
     using underlying_type = typename std::underlying_type<EnumType>::type;
-    integral_constructor<BasicJsonType>{}.construct(j, static_cast<underlying_type>(e));
+    // convert the enum to its underlying type, and from there to either the
+    // signed or unsigned JSON integer type, depending on the sign of the
+    // underlying type of the enum
+    using json_number_type = typename std::conditional<std::is_unsigned<underlying_type>::value,
+                                 typename BasicJsonType::number_unsigned_t,
+                                 typename BasicJsonType::number_integer_t>::type;
+    integral_constructor<BasicJsonType>{std::is_unsigned<underlying_type>::value ? value_t::number_unsigned : value_t::number_integer}
+        .construct(j, static_cast<json_number_type>(e));
 }
 #endif  // JSON_DISABLE_ENUM_SERIALIZATION
 
