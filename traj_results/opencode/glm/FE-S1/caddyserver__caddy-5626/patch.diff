+// tokensFromDifferentImports reports whether the two tokens come
+// from different import origins, i.e. their import chain differs.
+// Imported tokens keep the file and line of the snippet or file
+// they originate from, so their line numbers cannot be compared
+// directly with tokens of the importing context; comparing their
+// import chains is the only reliable way to know whether there
+// is a line break between them.
+func tokensFromDifferentImports(prev, curr Token) bool {
+	if len(prev.imports) != len(curr.imports) {
+		return true
+	}
+	for i := range prev.imports {
+		if prev.imports[i] != curr.imports[i] {
+			return true
+		}
+	}
+	return false
+}
+
 // isNewLine determines whether the current token is on a different
 // line (higher line number) than the previous token. It handles imported
 // tokens correctly. If there isn't a previous token, it returns true.
@@ -475,6 +494,14 @@ func (d *Dispenser) isNewLine() bool {
 		return true
 	}
 
+	// If the previous token is from a different import origin
+	// (e.g. one of them was imported from a snippet or file),
+	// we can assume it's from a different line, since imported
+	// tokens retain the line numbers of their origin
+	if tokensFromDifferentImports(prev, curr) {
+		return true
+	}
+
 	// If the previous token (incl line breaks) ends
 	// on a line earlier than the current token,
 	// then the current token is on a new line
@@ -501,6 +528,14 @@ func (d *Dispenser) isNextOnNewLine() bool {
