diff --git a/lib/rubocop/cop/mixin/allowed_receivers.rb b/lib/rubocop/cop/mixin/allowed_receivers.rb
index d40fb7728..aba4c0bcd 100644
--- a/lib/rubocop/cop/mixin/allowed_receivers.rb
+++ b/lib/rubocop/cop/mixin/allowed_receivers.rb
@@ -10,6 +10,22 @@ module RuboCop
         allowed_receivers.include?(receiver_name)
       end
 
+      def receiver_name(receiver)
+        if receiver.receiver && !receiver.receiver.const_type?
+          return receiver_name(receiver.receiver)
+        end
+
+        if receiver.send_type?
+          if receiver.receiver
+            "#{receiver_name(receiver.receiver)}.#{receiver.method_name}"
+          else
+            receiver.method_name.to_s
+          end
+        else
+          receiver.source
+        end
+      end
+
       def allowed_receivers
         cop_config.fetch('AllowedReceivers', [])
       end
