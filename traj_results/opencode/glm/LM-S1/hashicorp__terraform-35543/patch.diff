@@ -69,6 +71,84 @@ func (n *NodeValidatableResource) Execute(ctx EvalContext, op walkOperation) (di
 // validateProvisioner validates the configuration of a provisioner belonging to
 // a resource. The provisioner config is expected to contain the merged
 // connection configurations.
+func (n *NodeValidatableResource) validateImportTargets(ctx EvalContext) tfdiags.Diagnostics {
+	var diags tfdiags.Diagnostics
+
+	for _, imp := range n.importTargets {
+		if imp.Config == nil {
+			// legacy import targets supplied on the command line have no
+			// configuration to validate
+			continue
+		}
+
+		if imp.Config.ForEach == nil {
+			traversal, hds := hcl.AbsTraversalForExpr(imp.Config.To)
+			diags = diags.Append(hds)
+			to, tds := addrs.ParseAbsResourceInstance(traversal)
+			diags = diags.Append(tds)
+			if diags.HasErrors() {
+				return diags
+			}
+
+			// The import ID may be derived from values which are unknown
+			// during validation, so we only check that the expression itself
+			// is valid.
+			_, idDiags := evaluateImportIdExpression(imp.Config.ID, to, ctx, EvalDataForNoInstanceKey, true)
+			diags = diags.Append(idDiags)
+			continue
+		}
+
+		refs, moreDiags := langrefs.ReferencesInExpr(addrs.ParseRef, imp.Config.ForEach)
+		diags = diags.Append(moreDiags)
+		scope := ctx.EvaluationScope(nil, nil, EvalDataForNoInstanceKey)
+		if scope != nil {
+			hclCtx, moreDiags := scope.EvalContext(refs)
+			diags = diags.Append(moreDiags)
+			if diags.HasErrors() {
+				return diags
+			}
+
+			forEachVal, valDiags := imp.Config.ForEach.Value(hclCtx)
+			diags = diags.Append(valDiags)
+			if diags.HasErrors() {
+				return diags
+			}
+
+			if forEachVal.IsWhollyKnown() && !forEachVal.IsNull() {
+				val, valMarks := forEachVal.Unmark()
+				it := val.ElementIterator()
+				for it.Next() {
+					k, v := it.Element()
+					keyData := instances.RepetitionData{
+						EachKey:   k,
+						EachValue: v.WithMarks(valMarks),
+					}
+
+					res, evalDiags := evalImportToExpression(imp.Config.To, keyData)
+					diags = diags.Append(evalDiags)
+					if diags.HasErrors() {
+						return diags
+					}
+
+					_, idDiags := evaluateImportIdExpression(imp.Config.ID, res, ctx, keyData, true)
+					diags = diags.Append(idDiags)
+				}
+				continue
+			}
+		}
+
+		// The for_each value is unknown during validation, so validate the
+		// 'to' and 'id' expressions using unknown repetition data.
+		_, moreDiags = evalImportUnknownToExpression(imp.Config.To)
+		diags = diags.Append(moreDiags)
+		keyData := instances.UnknownForEachRepetitionData(cty.DynamicPseudoType)
+		_, idDiags := evaluateImportIdExpression(imp.Config.ID, addrs.AbsResourceInstance{}, ctx, keyData, true)
+		diags = diags.Append(idDiags)
+	}
+
+	return diags
+}
