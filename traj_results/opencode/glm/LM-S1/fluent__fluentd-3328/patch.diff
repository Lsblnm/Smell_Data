@@ -547,8 +547,15 @@ module Fluent::Plugin
           @tails[target_info] = tw
         rescue Errno::ENOENT
           $log.warn "stat() for #{target_info.path} failed with ENOENT. Drop tail watcher for now."
-          # explicitly detach and unwatch watcher `tw`.
-          stop_watchers(target_info, immediate: true, unwatched: true)
+          # explicitly detach and unwatch watcher `tw`. The watcher is not
+          # registered in @tails in this case, so stop_watchers cannot find
+          # and detach it. Detach it directly to avoid leaving a dangling
+          # watcher (which would later trigger update_watcher/refresh_watchers
+          # for a file that no longer exists).
+          if tw
+            tw.unwatched = true
+            detach_watcher(tw, target_info.ino, false)
+          end
         end
       }
     end
