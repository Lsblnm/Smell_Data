diff --git a/src/compile.c b/src/compile.c
index 3505328..83b2e99 100644
--- a/src/compile.c
+++ b/src/compile.c
@@ -1052,25 +1052,34 @@ block gen_try_handler(block handler) {
 block gen_try(block exp, block handler) {
   /*
    * Produce something like:
-   *  FORK_OPT <address of handler>
+   *  TRY_BEGIN <address of handler>
    *  <exp>
-   *  JUMP <end of handler>
+   *  TRY_END
+   *  JUMP <address past the handler>
    *  <handler>
    *
    * If this is not an internal try/catch, then catch and re-raise
    * internal errors to prevent them from leaking.
    *
-   * The handler will only execute if we backtrack to the FORK_OPT with
-   * an error (exception).  If <exp> produces no value then FORK_OPT
+   * The handler will only execute if we backtrack to the TRY_BEGIN with
+   * an error (exception).  If <exp> produces no value then TRY_BEGIN
    * will backtrack (propagate the `empty`, as it were.  If <exp>
-   * produces a value then we'll execute whatever bytecode follows this
-   * sequence.
+   * produces a value then we'll execute the TRY_END, saving a backtrack
+   * point there, and then whatever bytecode follows this sequence.
+   *
+   * If an error is raised after the TRY_END (i.e., after <exp> produced
+   * a value), then that error will be wrapped as it unwinds through the
+   * TRY_END, and the TRY_BEGIN will unwrap it and re-raise it rather
+   * than catch it.  Thus a `try` never catches errors raised by code
+   * that follows it, while the handler will still execute for any
+   * errors raised by <exp> itself.
    */
   inst *handler_curr;
   inst *exp_curr;
   inst *dup_inst;
   inst *pop_inst;
   inst *jump_inst;
+  inst *try_end_inst;
   inst *fork_inst;
   inst *location_src = 0;
   const struct opcode_description *op_desc;
@@ -1207,23 +1216,49 @@ block gen_try(block exp, block handler) {
   jump_inst->source = UNKNOWN_LOCATION;
   jump_inst->locfile = 0;
 
+  op_desc = opcode_describe(TRY_END);
+  try_end_inst = jv_mem_alloc(sizeof(inst));
+  try_end_inst->next = 0;
+  try_end_inst->prev = 0;
+  try_end_inst->op = TRY_END;
+  try_end_inst->bytecode_pos = -1;
+  try_end_inst->bound_by = 0;
+  try_end_inst->symbol = 0;
+  try_end_inst->any_unbound = (op_desc->flags & OP_HAS_BINDING) != 0;
+  try_end_inst->referenced = 0;
+  try_end_inst->nformals = -1;
+  try_end_inst->nactuals = -1;
+  try_end_inst->subfn.first = 0;
+  try_end_inst->subfn.last = 0;
+  try_end_inst->arglist.first = 0;
+  try_end_inst->arglist.last = 0;
+  try_end_inst->imm.intval = 0;
+  try_end_inst->imm.target = 0;
+  try_end_inst->source = UNKNOWN_LOCATION;
+  try_end_inst->locfile = 0;
+
   if (exp.last != 0) {
-    exp.last->next = jump_inst;
-    jump_inst->prev = exp.last;
+    // Append: <exp> TRY_END JUMP <past the handler>
+    exp.last->next = try_end_inst;
+    try_end_inst->prev = exp.last;
+    try_end_inst->next = jump_inst;
+    jump_inst->prev = try_end_inst;
     exp.last = jump_inst;
     if (exp.first == 0) {
-      exp.first = jump_inst;
+      exp.first = try_end_inst;
     }
   } else {
-    exp.first = jump_inst;
+    try_end_inst->next = jump_inst;
+    jump_inst->prev = try_end_inst;
+    exp.first = try_end_inst;
     exp.last = jump_inst;
   }
 
-  op_desc = opcode_describe(FORK_OPT);
+  op_desc = opcode_describe(TRY_BEGIN);
   fork_inst = jv_mem_alloc(sizeof(inst));
   fork_inst->next = 0;
   fork_inst->prev = 0;
-  fork_inst->op = FORK_OPT;
+  fork_inst->op = TRY_BEGIN;
   fork_inst->bytecode_pos = -1;
   fork_inst->bound_by = 0;
   fork_inst->symbol = 0;
diff --git a/src/execute.c b/src/execute.c
index 34bb63d..3f919b4 100644
--- a/src/execute.c
+++ b/src/execute.c
@@ -808,7 +808,7 @@ jv jq_next(jq_state *jq) {
       break;
     }
 
-    case FORK_OPT:
+    case TRY_BEGIN:
     case DESTRUCTURE_ALT:
     case FORK: {
       stack_save(jq, pc - 1, stack_get_pos(jq));
@@ -816,23 +816,71 @@ jv jq_next(jq_state *jq) {
       break;
     }
 
-    case ON_BACKTRACK(FORK_OPT):
+    case TRY_END: {
+      // The try body produced a value.  Save a backtrack point so that
+      // if an error is raised after this try/catch completes, we can
+      // wrap it here, and the matching TRY_BEGIN will unwrap it and
+      // re-raise it rather than catch it.
+      stack_save(jq, pc - 1, stack_get_pos(jq));
+      break;
+    }
+
+    case ON_BACKTRACK(TRY_END): {
+      if (!raising) {
+        // Natural backtracking (no error): keep looking for more
+        // outputs of the try body.
+        goto do_backtrack;
+      }
+      // An error unwinding through here was raised after the try body
+      // produced a value.  Wrap it so that the matching TRY_BEGIN will
+      // re-raise it rather than catch it.
+      {
+        jv err = jq->error;
+        jq->error = jv_invalid_with_msg(err);
+      }
+      goto do_backtrack;
+    }
+
     case ON_BACKTRACK(DESTRUCTURE_ALT): {
       if (jv_is_valid(jq->error)) {
         // `try EXP ...` backtracked here (no value, `empty`), so we backtrack more
         jv_free(stack_pop(jq));
         goto do_backtrack;
       }
-      // `try EXP ...` exception caught in EXP
-      // DESTRUCTURE_ALT doesn't want the error message on the stack,
-      // as we would just want to throw it away anyway.
-      if (opcode != ON_BACKTRACK(DESTRUCTURE_ALT)) {
+      // Errors raised while destructuring are just thrown away.
+      jv_free(jq->error);
+      jq->error = jv_null();
+      uint16_t offset = *pc++;
+      pc += offset;
+      break;
+    }
+
+    case ON_BACKTRACK(TRY_BEGIN): {
+      if (jv_is_valid(jq->error)) {
+        // `try EXP ...` backtracked here (no value, `empty`), so we backtrack more
+        jv_free(stack_pop(jq));
+        goto do_backtrack;
+      }
+      // `try EXP ...` exception raised in EXP
+      if (jv_invalid_has_msg(jv_copy(jq->error))) {
+        jv msg = jv_invalid_get_msg(jq->error); // consumes jq->error
+        jq->error = jv_null();
+        if (!jv_is_valid(msg)) {
+          // The error was wrapped by the matching TRY_END because it
+          // was raised after the try body produced a value.  Unwrap it
+          // and re-raise it rather than catch it.
+          jq->error = msg;
+          goto do_backtrack;
+        }
         jv_free(stack_pop(jq)); // free the input
-        stack_push(jq, jv_invalid_get_msg(jq->error));  // push the error's message
+        stack_push(jq, msg);  // push the error's message
       } else {
+        // Error with no message: catch it and push null, as before.
         jv_free(jq->error);
+        jq->error = jv_null();
+        jv_free(stack_pop(jq)); // free the input
+        stack_push(jq, jv_null());
       }
-      jq->error = jv_null();
       uint16_t offset = *pc++;
       pc += offset;
       break;
