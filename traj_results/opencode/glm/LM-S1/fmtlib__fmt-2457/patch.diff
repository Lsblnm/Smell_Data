+  template <typename ParseContext, size_t N>
+  FMT_CONSTEXPR auto do_parse(ParseContext& ctx,
+                              std::integral_constant<size_t, N>)
+      -> decltype(ctx.begin()) {
+    auto begin = ctx.begin();
+    auto end = ctx.end();
+    // Find the end of the format spec, taking nested replacement fields
+    // such as "{:{}.{}" into account.
+    auto it = begin;
+    size_t depth = 0;
+    while (it != end) {
+      Char ch = *it;
+      if (ch == '{') {
+        ++depth;
+      } else if (ch == '}') {
+        if (depth == 0) break;
+        --depth;
+      }
+      ++it;
+    }
+    format_str = basic_string_view<Char>(begin, detail::to_unsigned(it - begin));
+    return it;
+  }
+
+ public:
+  template <typename ParseContext>
+  FMT_CONSTEXPR auto parse(ParseContext& ctx) -> decltype(ctx.begin()) {
+    return do_parse(ctx, std::integral_constant<size_t, sizeof...(T)>());
+  }
