+    // See: https://github.com/BurntSushi/ripgrep/issues/2825
+    // This regression tests that a match that begins at the start of a line
+    // (via the `^` in the leading `(^|\W)` alternation) is not incorrectly
+    // stripped of its first character by the fast path. Notably, this only
+    // manifests when searching a haystack containing multiple lines.
+    #[test]
+    fn regression_multi_line_start() {
+        let haystack = "some.domain.com\nsome.domain.com/x\nsome.domain.com";
+        assert_eq!(
+            Some((0, 15)),
+            find_at(r#"([\w]+[.])*domain[.](\w)+"#, haystack, 0)
+        );
+        assert_eq!(
+            Some((16, 31)),
+            find_at(r#"([\w]+[.])*domain[.](\w)+"#, haystack, 16)
+        );
+        assert_eq!(
+            Some((34, 49)),
+            find_at(r#"([\w]+[.])*domain[.](\w)+"#, haystack, 34)
+        );
+
+        assert_eq!(Some((0, 3)), find_at(r"\w+", "foo\nbar", 0));
+        assert_eq!(Some((4, 7)), find_at(r"\w+", "foo\nbar", 4));
+    }
+
