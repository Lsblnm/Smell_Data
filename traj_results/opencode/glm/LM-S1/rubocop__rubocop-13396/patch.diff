diff --git a/lib/rubocop/cop/style/redundant_parentheses.rb b/lib/rubocop/cop/style/redundant_parentheses.rb
index 363ec1339..536bbcbf7 100644
--- a/lib/rubocop/cop/style/redundant_parentheses.rb
+++ b/lib/rubocop/cop/style/redundant_parentheses.rb
@@ -175,6 +175,21 @@ module RuboCop
         # @!method interpolation?(node)
         def_node_matcher :interpolation?, '[^begin ^^dstr]'
 
+        # Removing parentheses around a method chain that contains a `do`...`end`
+        # block would make the block bind to an outer, unparenthesized method call
+        # instead of the call it currently belongs to, changing the meaning of code.
+        def do_block_binding_would_change?(begin_node)
+          return false unless contains_do_block?(begin_node)
+
+          begin_node.each_ancestor(:send, :csend).any? do |ancestor|
+            ancestor.arguments.any? && !ancestor.parenthesized?
+          end
+        end
+
+        def contains_do_block?(node)
+          node.each_descendant(:block, :numblock).any? { |block| !block.braces? }
+        end
+
         def allow_in_multiline_conditions?
           parentheses_around_condition_config = config.for_cop('Style/ParenthesesAroundCondition')
           return false unless parentheses_around_condition_config['Enabled']
@@ -228,7 +243,7 @@ module RuboCop
               end
 
               redundant_method_call = empty_arguments || parenthesized_send || bracket_call
-              if redundant_method_call
+              if redundant_method_call && !do_block_binding_would_change?(begin_node)
                 chain_node = send_node
                 while chain_node
                   chain_type = chain_node.type
