diff --git a/lib/fpm/package/deb.rb b/lib/fpm/package/deb.rb
index 09719db..8c05321 100644
--- a/lib/fpm/package/deb.rb
+++ b/lib/fpm/package/deb.rb
@@ -793,6 +793,26 @@ class FPM::Package::Deb < FPM::Package
       logger.warn("Replacing 'provides' entry #{provides} with syntax 'name (= version)'")
       provides = "#{m[1]} (= #{m[2]})"
     end
+
+    # Validate the provides value. Debian only allows 'name' or 'name (= version)'
+    # in the Provides field. Version relations like '<<', '>=', etc. are not valid.
+    # Ref: https://www.debian.org/doc/debian-policy/ch-relationships.html#id9
+    m = provides.match(/^([A-Za-z0-9][A-Za-z0-9._+-]*)(?:\s*\(\s*=\s*([^)\s]+)\s*\))?$/)
+    if m.nil?
+      raise FPM::InvalidPackageConfiguration,
+        "Invalid provides entry '#{provides}'. For Debian packages, " \
+        "provides must be either 'name' or 'name (= version)'. Version " \
+        "relations such as '<<' are not allowed in Provides."
+    end
+
+    version = m[2]
+    if !version.nil? && version !~ /^(\d+:)?\d[^\s]*(-[^\s]+)?$/
+      raise FPM::InvalidPackageConfiguration,
+        "Invalid version '#{version}' in provides entry '#{provides}'. " \
+        "Debian versions must look like 'epoch:upstream_version-debian_revision' " \
+        "where epoch and debian_revision are optional."
+    end
+
     return provides.rstrip
   end
 
