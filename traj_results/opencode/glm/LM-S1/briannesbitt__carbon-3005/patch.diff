+     *
+     * The local translator is excluded because it may contain closures
+     * (e.g. pluralization rules), only the locale is dumped instead and
+     * the translator is rebuilt on unserialization.
+     *
+     * @return array
+     */
+    public function __serialize(): array
+    {
+        $properties = get_object_vars($this);
+        unset($properties['localTranslator']);
+
+        if ($this->localTranslator ?? null) {
+            $properties['dumpLocale'] = $this->getTranslatorLocale();
+        }
+
+        return $properties;
+    }
+
+    /**
+     * Restore the instance values on unserialize() called, rebuilding
+     * the local translator from the dumped locale if any.
+     *
+     * @param array $data data as dumped by __serialize()
+     */
+    public function __unserialize(array $data): void
+    {
+        $properties = array_combine(
+            array_map(
+                static fn (mixed $key) => \is_string($key)
+                    ? str_replace('tzName', 'timezoneSetting', $key)
+                    : $key,
+                array_keys($data),
+            ),
+            $data,
+        );
+
+        $dumpLocale = $properties['dumpLocale'] ?? null;
+        unset($properties['dumpLocale']);
+
+        if (method_exists(parent::class, '__unserialize')) {
+            // PHP >= 8.2
+            parent::__unserialize($properties);
+        } else {
+            // PHP <= 8.1
+            // @codeCoverageIgnoreStart
+            $properties = array_combine(
+                array_map(
+                    static fn (string $property) => preg_replace('/^\0.+\0/', '', $property),
+                    array_keys($properties),
+                ),
+                $properties,
+            );
+
+            $localStrictMode = $this->localStrictModeEnabled;
+            $this->localStrictModeEnabled = false;
+            $days = $properties['days'] ?? false;
+            $this->days = $days === false ? false : (int) $days;
+            $this->y = (int) ($properties['y'] ?? 0);
+            $this->m = (int) ($properties['m'] ?? 0);
+            $this->d = (int) ($properties['d'] ?? 0);
+            $this->h = (int) ($properties['h'] ?? 0);
+            $this->i = (int) ($properties['i'] ?? 0);
+            $this->s = (int) ($properties['s'] ?? 0);
