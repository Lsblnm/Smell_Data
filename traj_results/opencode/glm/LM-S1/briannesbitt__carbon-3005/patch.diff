+    /**
+     * Returns the values to dump on serialize() called on.
+     *
+     * Catalogues and messages are excluded because they may contain closures
+     * (e.g. pluralization rules), the translator is instead rebuilt from its
+     * locale, fallback locales and directories on unserialization.
+     *
+     * @return array
+     */
+    public function __serialize(): array
+    {
+        return [
+            'locale' => $this->getLocale(),
+            'fallbackLocales' => $this->getFallbackLocales(),
+            'directories' => $this->directories,
+        ];
+    }
+
+    /**
+     * Rebuild the translator from the dumped locale on unserialize() called.
+     *
+     * @param array $data data as dumped by __serialize()
+     */
+    public function __unserialize(array $data): void
+    {
+        $this->__construct($data['locale'] ?? 'en');
+
+        if ($this instanceof TranslatorImmutable) {
+            return;
+        }
+
+        if (!empty($data['fallbackLocales'])) {
+            $this->setFallbackLocales($data['fallbackLocales']);
+        }
+
+        if (!empty($data['directories'])) {
+            $this->setDirectories($data['directories']);
+        }
+    }
+
