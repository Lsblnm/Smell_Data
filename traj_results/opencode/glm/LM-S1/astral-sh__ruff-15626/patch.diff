+/// Returns `true` if the operand's `__eq__` and `__ne__` methods are known to
+/// return `bool`. This is only guaranteed for builtin types; user-defined
+/// types (or types that cannot be inferred) may return any value from their
+/// comparison methods.
+fn comparison_returns_bool(expr: &Expr) -> bool {
+    match ResolvedPythonType::from(expr) {
+        ResolvedPythonType::Atom(_) | ResolvedPythonType::Union(_) => true,
+        ResolvedPythonType::Unknown | ResolvedPythonType::TypeError => false,
+    }
+}
