+#[cfg(unix)]
+fn parse_signal_spec(sig_spec: &str) -> Option<i32> {
+    if let Ok(num) = sig_spec.parse::<usize>() {
+        return if num > 0 && num < ALL_SIGNALS.len() {
+            Some(num as i32)
+        } else {
+            None
+        };
+    }
+    let upper = sig_spec.to_uppercase();
+    let name = upper.strip_prefix("SIG").unwrap_or(&upper);
+    ALL_SIGNALS
+        .iter()
+        .position(|&s| s == name && s != "EXIT")
+        .map(|i| i as i32)
+}
+
+#[cfg(unix)]
+fn parse_ignore_signals(spec: &OsStr) -> UResult<Vec<i32>> {
+    let spec_str = spec.to_string_lossy();
+    if spec_str.is_empty() {
+        return Ok(Vec::new());
+    }
+    let mut signals = Vec::new();
+    for sig_spec in spec_str.split(',') {
+        if sig_spec.is_empty() {
+            continue;
+        }
+        let sig = parse_signal_spec(sig_spec).ok_or_else(|| {
+            USimpleError::new(125, format!("{}: invalid signal", sig_spec.quote()))
+        })?;
+        signals.push(sig);
+    }
+    Ok(signals)
+}
