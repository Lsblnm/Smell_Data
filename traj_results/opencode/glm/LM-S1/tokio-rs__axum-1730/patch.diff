+impl<S, B> Handler<((),), S, B> for MethodRouter<S, B, Infallible>
+where
+    S: Clone + Send + Sync + 'static,
+    B: HttpBody + Send + 'static,
+{
+    type Future = Pin<Box<dyn Future<Output = Response> + Send>>;
+
+    #[inline]
+    fn call(self, req: Request<B>, state: S) -> Self::Future {
+        let mut method_router = self.with_state(state);
+        Box::pin(async move {
+            match method_router.call_with_state(req, ()).await {
+                Ok(res) => res,
+                Err(err) => match err {},
+            }
+        })
+    }
+}
