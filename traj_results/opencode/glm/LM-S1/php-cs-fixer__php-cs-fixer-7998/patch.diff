+    private function isNameOfConstantBeingDeclared(Tokens $tokens, int $previousIndex, int $nextIndex): bool
+    {
+        if (!$tokens[$nextIndex]->equals('=')) {
+            return false;
+        }
+
+        static $typeTokenKinds = null;
+
+        if (null === $typeTokenKinds) {
+            $typeTokenKinds = [
+                T_STRING,
+                T_NS_SEPARATOR,
+                T_ARRAY, // @TODO: drop condition when PHP 8.0+ is required
+                CT::T_ARRAY_TYPEHINT,
+                T_CALLABLE,
+                CT::T_TYPE_ALTERNATION,
+                CT::T_TYPE_INTERSECTION,
+                CT::T_NULLABLE_TYPE,
+                T_WHITESPACE,
+                T_COMMENT,
+                T_DOC_COMMENT,
+            ];
+        }
+
+        for ($i = $previousIndex; $i >= 0; --$i) {
+            if ($tokens->isEmptyAt($i)) {
+                continue;
+            }
+
+            $token = $tokens[$i];
+
+            if ($token->isGivenKind(T_CONST)) {
+                return true;
+            }
+
+            if ($token->isGivenKind($typeTokenKinds)) {
+                continue;
+            }
+
+            $content = $token->getContent();
+
+            if ('(' === $content || ')' === $content || '?' === $content || '&' === $content) {
+                continue;
+            }
+
+            return false;
+        }
+
+        return false;
+    }
