diff --git a/caddyconfig/caddyfile/dispenser.go b/caddyconfig/caddyfile/dispenser.go
index 580de4a9..dcdb3771 100644
--- a/caddyconfig/caddyfile/dispenser.go
+++ b/caddyconfig/caddyfile/dispenser.go
@@ -466,8 +466,9 @@ func (d *Dispenser) isNewLine() bool {
 	curr := d.tokens[d.cursor]
 
 	// If the previous token is from a different file,
-	// we can assume it's from a different line
-	if prev.File != curr.File {
+	// or was imported at a different place, we can
+	// assume it's from a different line
+	if prev.File != curr.File || !sameImportChain(prev.imports, curr.imports) {
 		return true
 	}
 
@@ -492,8 +493,9 @@ func (d *Dispenser) isNextOnNewLine() bool {
 	next := d.tokens[d.cursor+1]
 
 	// If the next token is from a different file,
-	// we can assume it's from a different line
-	if curr.File != next.File {
+	// or was imported at a different place, we can
+	// assume it's from a different line
+	if curr.File != next.File || !sameImportChain(curr.imports, next.imports) {
 		return true
 	}
 
@@ -502,3 +504,22 @@ func (d *Dispenser) isNextOnNewLine() bool {
 	// then the next token is on a new line
 	return curr.Line+curr.NumLineBreaks() < next.Line
 }
+
+// sameImportChain determines whether two tokens were imported
+// in the same place, i.e. belong to the same import operation.
+// Tokens from different import operations are considered to be
+// on different lines, even if they come from the same file,
+// because the line numbers of imported tokens are the ones of
+// the file (or snippet) they were originally defined in, which
+// may not line up with the line numbers of the importing file.
+func sameImportChain(a, b []string) bool {
+	if len(a) != len(b) {
+		return false
+	}
+	for i := range a {
+		if a[i] != b[i] {
+			return false
+		}
+	}
+	return true
+}
