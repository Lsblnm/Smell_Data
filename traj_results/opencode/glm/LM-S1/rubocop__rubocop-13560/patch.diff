diff --git a/lib/rubocop/cop/style/file_null.rb b/lib/rubocop/cop/style/file_null.rb
index 02a7907f8..dac462a6d 100644
--- a/lib/rubocop/cop/style/file_null.rb
+++ b/lib/rubocop/cop/style/file_null.rb
@@ -8,6 +8,12 @@ module RuboCop
       # Only looks for full string matches, substrings within a longer string are not
       # considered.
       #
+      # However, only files that use the string `'/dev/null'` are targeted for detection.
+      # This is because the string `'NUL'` is not limited to the null device.
+      # This behavior results in false negatives when the `'/dev/null'` string is not used,
+      # but it is a trade-off to avoid false positives. Unlike `'NUL'`, `'NUL:'` is
+      # regarded as something like `C:` and is always detected.
+      #
       # NOTE: Uses inside arrays and hashes are ignored.
       #
       # @safety
@@ -42,6 +48,19 @@ module RuboCop
         REGEXP = %r{\A(/dev/null|NUL:?)\z}i.freeze
         MSG = 'Use `File::NULL` instead of `%<source>s`.'
 
+        # rubocop:disable Style/FileNull -- the cop needs the literals it is matching
+        def on_new_investigation
+          return unless (ast = processed_source.ast)
+
+          @contain_dev_null_string_in_file =
+            ast.each_descendant(:str).any? do |str|
+              content = str.str_content
+
+              !invalid_string?(content) && content.downcase == '/dev/null'
+            end
+        end
+        # rubocop:enable Style/FileNull
+
         def on_str(node)
           value = node.value
           return if invalid_string?(value)
@@ -68,6 +87,9 @@ module RuboCop
           candidate = interpret_string_escapes(candidate)
           return if candidate.nil?
           return if candidate.empty? || !candidate.valid_encoding?
+          # rubocop:disable Style/FileNull -- the cop needs the literal it is matching
+          return if candidate.downcase == 'nul' && !@contain_dev_null_string_in_file
+          # rubocop:enable Style/FileNull
 
           matched_unix = false
           matched_windows = false
@@ -76,7 +98,7 @@ module RuboCop
           unix_second_name = 'null'
           unix_separator_count = 2
           unix_total_length = unix_first_name.length + unix_second_name.length + unix_separator_count
-          windows_base = 'nul'
+          windows_base = 'nul' # rubocop:disable Style/FileNull -- needed for detection
           windows_colon = ':'
           windows_base_length = windows_base.length
           windows_colon_length = windows_base_length + windows_colon.length
