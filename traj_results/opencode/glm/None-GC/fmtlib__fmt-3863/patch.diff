+// Writes the escaped representation of a character, e.g. a newline as
+// "\n", used when formatting character ranges as strings with the "s"
+// and "?s" presentation types.
+template <typename Char, typename OutputIt>
+auto write_escaped_char_content(OutputIt out, uint32_t cp) -> OutputIt {
+  switch (static_cast<Char>(cp)) {
+  case '\n':
+    *out++ = static_cast<Char>('\\');
+    *out++ = static_cast<Char>('n');
+    return out;
+  case '\r':
+    *out++ = static_cast<Char>('\\');
+    *out++ = static_cast<Char>('r');
+    return out;
+  case '\t':
+    *out++ = static_cast<Char>('\\');
+    *out++ = static_cast<Char>('t');
+    return out;
+  case '"':
+  case '\\':
+    *out++ = static_cast<Char>('\\');
+    break;
+  default:
+    break;
+  }
+  if (cp < 0x20 || cp == 0x7f) {
+    static const char hex[] = "0123456789abcdef";
+    *out++ = static_cast<Char>('\\');
+    *out++ = static_cast<Char>('x');
+    *out++ = static_cast<Char>(hex[(cp >> 4) & 0xf]);
+    *out++ = static_cast<Char>(hex[cp & 0xf]);
+    return out;
+  }
+  *out++ = static_cast<Char>(cp);
+  return out;
+}
