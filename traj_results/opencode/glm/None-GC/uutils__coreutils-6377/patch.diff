+#[cfg(unix)]
+fn parse_signal_token(token: &str) -> Result<Signal, ()> {
+    // GNU env accepts signal numbers as well as signal names
+    if let Ok(num) = token.parse::<i32>() {
+        return Signal::try_from(num).map_err(|_| ());
+    }
+    let lower = token.to_lowercase();
+    let name = lower.strip_prefix("sig").unwrap_or(&lower);
+    Signal::iterator()
+        .find(|s| s.as_str()[3..].eq_ignore_ascii_case(name))
+        .ok_or(())
+}
+
+#[cfg(unix)]
+fn apply_ignore_signals(value: Option<&OsString>) -> UResult<()> {
+    let signals: Vec<Signal> = match value {
+        // "an empty SIG argument is a no-op"
+        Some(v) if v.is_empty() => Vec::new(),
+        // "without SIG, all known signals are included" - errors are ignored
+        // in that case, as some signals (e.g. SIGKILL, SIGSTOP) cannot be ignored
+        None => {
+            for sig in Signal::iterator() {
+                // SIGCHLD must not be ignored: this implementation spawns the
+                // child process and waits for it, which would fail with ECHILD
+                // if SIGCHLD were ignored (GNU env execs in the same process
+                // and therefore does not have this issue).
+                if sig == Signal::SIGCHLD {
+                    continue;
+                }
+                // SAFETY: installing the SIG_IGN handler is safe as it does not
+                // invoke any user-provided function
+                let _ = unsafe {
+                    sigaction(
+                        sig,
+                        &SigAction::new(SigHandler::SigIgn, SaFlags::empty(), SigSet::all()),
+                    )
+                };
+            }
+            Vec::new()
+        }
+        Some(v) => {
+            let s = v.to_str().ok_or_else(|| {
+                USimpleError::new(125, format!("{}: invalid signal", v.quote()))
+            })?;
+            let mut signals = Vec::new();
+            for token in s.split(',').filter(|t| !t.is_empty()) {
+                let sig = parse_signal_token(token).map_err(|_| {
+                    USimpleError::new(125, format!("{}: invalid signal", token.quote()))
+                })?;
+                signals.push(sig);
+            }
+            signals
+        }
+    };
+
+    for sig in signals {
+        // SAFETY: installing the SIG_IGN handler is safe as it does not
+        // invoke any user-provided function
+        unsafe {
+            sigaction(
+                sig,
+                &SigAction::new(SigHandler::SigIgn, SaFlags::empty(), SigSet::all()),
+            )
+        }
+        .map_err(|e| {
+            USimpleError::new(
+                125,
+                format!(
+                    "failed to set signal action for signal {}: {}",
+                    sig as i32,
+                    e.desc()
+                ),
+            )
+        })?;
+    }
+
+    Ok(())
+}
