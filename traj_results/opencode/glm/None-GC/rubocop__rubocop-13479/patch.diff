diff --git a/lib/rubocop/cop/layout/leading_comment_space.rb b/lib/rubocop/cop/layout/leading_comment_space.rb
index 068fd869f..faabf56ad 100644
--- a/lib/rubocop/cop/layout/leading_comment_space.rb
+++ b/lib/rubocop/cop/layout/leading_comment_space.rb
@@ -6,8 +6,9 @@ module RuboCop
       # Checks whether comments have a leading space after the
       # `#` denoting the start of the comment. The leading space is not
       # required for some RDoc special syntax, like `#++`, `#--`,
-      # `#:nodoc`, `=begin`- and `=end` comments, "shebang" directives,
-      # or rackup options.
+      # `#:nodoc`, `=begin`- and `=end` comments, "shebang" directives
+      # on the first line of the file (as well as multiline shebangs
+      # starting on the first line), or rackup options.
       #
       # @example
       #
@@ -93,8 +94,11 @@ module RuboCop
         MSG = 'Missing space after `#`.'
 
         def on_new_investigation # rubocop:disable Metrics/AbcSize, Metrics/CyclomaticComplexity, Metrics/PerceivedComplexity
+          multiline_shebang_lines = consecutive_shebang_lines
+
           processed_source.comments.each do |comment|
             next unless /\A(?!#\+\+|#--)(#+[^#\s=])/.match?(comment.text)
+            next if multiline_shebang_lines.include?(comment.loc.line)
             next if comment.loc.line == 1 && allowed_on_first_line?(comment)
             next if doxygen_comment_style?(comment)
             next if gemfile_ruby_comment?(comment)
@@ -115,6 +119,25 @@ module RuboCop
           range_between(expr.begin_pos, expr.begin_pos + 1)
         end
 
+        # A multiline shebang is a series of `#!` comments that starts
+        # on the first line of the file and continues on consecutive lines.
+        def consecutive_shebang_lines
+          lines = []
+          preceding_shebang_line = nil
+
+          processed_source.comments.each do |comment|
+            line = comment.loc.line
+            if shebang?(comment) && (line == 1 || preceding_shebang_line == line - 1)
+              lines << line
+              preceding_shebang_line = line
+            else
+              preceding_shebang_line = nil
+            end
+          end
+
+          lines
+        end
+
         def allowed_on_first_line?(comment)
           shebang?(comment) || (rackup_config_file? && rackup_options?(comment))
         end
