+// CloneWithText returns a copy of the token with its text replaced,
+// while retaining all of the token's other metadata (file, line,
+// quoting, heredoc marker, snippet name, and import chain).
+//
+// This is useful when a synthetic token needs to be derived from an
+// existing one, so that token adjacency (same-line) checks remain
+// consistent, e.g. when inserting the implicit "expression" matcher
+// name in front of a quoted token in a named matcher definition.
+func (t Token) CloneWithText(text string) Token {
+	t.Text = text
+	return t
+}
+
 // NumLineBreaks counts how many line breaks are in the token text.
